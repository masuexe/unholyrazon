// Unholy custom player data for the SCORINFO UHPlayerIcon column.
//
// AddCustomData is a GameInfo property parsed from a MAPINFO/ZMAPINFO
// "GameInfo { }" block.  It is NOT parsed from a standalone GAMEINFO lump:
// that lump is the launcher/IWAD one (d_main.cpp) and silently ignores
// unknown keys, so AddCustomData placed there would do nothing.  The plan's
// "src/GAMEINFO" file would therefore not have worked on Zandronum 3.3-alpha.
//
// The base game ships its own MAPINFO; the engine parses every MAPINFO lump
// in load order and a GameInfo block only adds to the existing gameinfo, so
// this block is additive and safe.
//
// Syntax requires the '=' and a quoted type (PlayerData parser in
// scoreboard.cpp).  "" resolves to a NULL texture, which draws nothing and
// lets the DISABLEIFEMPTY flag hide the column when no icon is visible.
GameInfo
{
    AddCustomData = "UHPlayerIcon", "Texture", ""
}

// maps/*.wad contains only map lumps; shared configuration and resources
// must live in the PK3 so the engine can find them globally.
map SAMPI "Sampi's Final Stand" {
    levelnum = -600
    next = "MM2DW1"
    sky1 = "AIRSKY", 0
    music = "D_S3DFB" // Sonic 3D Blast - The Final Fight
    aircontrol = 0.5
    exitpic = "SAMPIINT"
}


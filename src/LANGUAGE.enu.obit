// ===========================================================================
// Boss Specific Obituaries
// ===========================================================================

OB_BOSS02A = "Upon the sight of \cmElitist \cnSue \c-(%k)'s cold hearted might\n%o had no choice but to get on their knees and surrender.";
OB_BOSS305A = "Upon the sight of \chShadowman\c-, %o decided to get on their knees and beg for mercy.\n\chShadowman\c- laughed and showed no remorse and thus... %o was killed in cold blood.";
OB_BOSS513A = "%o\c*: The invisible man's outside!\n\cmPrickster \cgPrick\c* (%k): Tell him I can't see him.";
OB_BOSS513B = "%o\c*: What should Sonic use to knock on a door?\n\cmPrickster \cgPrick\c* (%k): Knuckles.";
OB_BOSS513C = "%o\c*: I can jump higher than a house!\n\cmPrickster \cgPrick\c* (%k): Well, that's not hard, houses can't jump!";
OB_BOSS513D = "%o\c*: I can't stop telling lies!\n\cmPrickster \cgPrick\c* (%k): I don't believe you.";
OB_BOSS513E = "%o\c*: Can a shoe box?\n\cmPrickster \cgPrick\c* (%k): No, but a tin can!";
OB_BOSS513F = "%o\c*: Why couldn't the leopard run away from the zoo?\n\cmPrickster \cgPrick\c* (%k): Because he was always spotted.";
OB_BOSS513G = "%o\c*: Did you hear the joke about the butter?\n\cmPrickster \cgPrick\c* (%k): Yes, but don't spread it around!";
OB_BOSS513H = "%o\c*: What bow can't you tie?\n\cmPrickster \cgPrick\c* (%k): A rainbow!";
OB_BOSS513I = "%o\c*: How are you getting along with these riddles?\n\cmPrickster \cgPrick\c* (%k): Fine - it's the answers I'm having trouble with!";
OB_BOSS513J = "%o\c*: What do you call a hedgehog covered in vinegar?\n\cmPrickster \cgPrick\c* (%k): Prickle!";
OB_BOSS513K = "%o\c*: Why is the letter 'A' like a flower?\n\cmPrickster \cgPrick\c* (%k): Because a 'B' comes after it!";
OB_BOSS513L = "%o\c*: What's wrong with this fish?\n\cmPrickster \cgPrick\c* (%k): Long time no sea!";
OB_BOSS513M = "%o\c*: What shoes can you make with banana skins?\n\cmPrickster \cgPrick\c* (%k): Slippers!";
OB_BOSS513N = "%o\c*: What is the best way to talk to a giant?\n\cmPrickster \cgPrick\c* (%k): Use big words!";
OB_BOSS513O = "%o\c*: What do you call a sleeping bull?\n\cmPrickster \cgPrick\c* (%k): A bull-dozer!";
OB_BOSS513P = "\cmPrickster \cgPrick\c- (%k) told %o a story about Chuckles the Maniacally Laughing Hedgehog.";
OB_BOSS60A = "%o asked \cj\"Is this funny to you?\"\n\c-Only for \cdMisery \c-(%k) to respond with \cj\"Comedy is subjective.\"";
OB_BOSS60B = "%o asked \cj\"But why...?\"\n\c-Only for \cdMisery \c-(%k) to respond with \cj\"Why not?\"";
OB_BOSS61A = "%o was taught a history lesson of \ciChieftain Tomahawk \c-(%k)'s people\nThey don't like %o very much.";


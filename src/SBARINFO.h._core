                  InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 170;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 170;}}
                  InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 163;}
                }}}
            InInventory "SBARAmmoOffset", 2 {InInventory not "SBARAmmoOffset", 3 {
                InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 169;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 169;}}
                InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 162;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 162;}}
                InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 155;}
              }}
            InInventory "SBARAmmoOffset", 3 {

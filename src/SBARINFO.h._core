              InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 154;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 154;}}
              InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 80, 147;}
            }
          }

          DrawImage "CURSEVAR", 130, 184;
          InInventory "HealthNumberFlag", 1 {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 152, 177;}
        }

        DrawSelectedInventory INDEXFONT , 122, 184, 120, 185, white;
      }
      // Qwant dual bars: icon 16px tall at Y=176 (with bar2); else single-bar slot Y=184
      // UH_MoveHud_F: ACS DrawBar_* paints parent icon; weaponicon would be blank (move wep).
      InInventory not "UH_MoveHud_F", 1 {
        InInventory "QwantAlignWepIcon", 1 {DrawImage weaponicon, 50, 176;}
        else {DrawImage weaponicon, 50, 184;}
      }


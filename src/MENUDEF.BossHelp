OptionMenu "UH_BossHelpMenu"
{
	//Position 2
	Title "Bosses Information"
	//ScrollTop 1
	Indent 20
	StaticText"$MNU_UH_EQUAL_LINE"
	StaticText ""

	Option "$MNU_CLASSINFO_NAME", "_UH_BH_Menu", "UH_BossName"

	StaticText ""
	StaticText ""
	StaticText "$MNU_BOSSINFO_ITEMTIP"
	StaticText ""
	StaticText ""
	StaticText ""
	Option "$MNU_CLASSINFO_RELOAD", "_UH_BH_Menu", "UH_BossItem"
	StaticText ""

	StaticText ""
	StaticText ""
	Option "$MNU_CLASSINFO_EXTRA", "_UH_BH_Menu", "UH_BossExtra"
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""

	StaticText ""
	StaticText"$MNU_UH_EQUAL_LINE"

	StaticText ""
	Command "$MNU_CLASSINFO_JUMPTO", "menu_UBH_NumHelp"
	StaticText "$MNU_BOSSINFO_CURRBOSS", 2
}


// Actor-keyed Boss overrides for ordinary random and specified selection.
alias uh_boss_set "eval + $uh_boss_commands set:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_show "eval + $uh_boss_commands show:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_check "eval + $uh_boss_commands check:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_pool "eval + $uh_boss_commands pool:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_reset "eval + $uh_boss_commands reset:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_list "eval + $uh_boss_commands list:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_export "eval + $uh_boss_commands export:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_reload "eval + $uh_boss_commands reload:%1:%2:%3:%4| uh_boss_commands"
alias uh_boss_save "wait 1; uh_boss_save_check"
alias uh_boss_save_check "test || $uh_boss_configbusy != $uh_boss_commands \"\" uh_boss_save uh_boss_save_ready"
alias uh_boss_save_ready "echo Boss edits are complete. Run writeini directly in the server console to save."
alias uh_boss_load "echo Run exec %1 directly in the server console. Then run uh_boss_reload."

// Stem-keyed host settings. A server OPEN watcher drains queued records.
alias uh_event_set "eval + $uh_event_commands set:%1:%2:%3:%4| uh_event_commands"
alias uh_event_show "eval + $uh_event_commands show:%1:%2:%3:%4| uh_event_commands"
alias uh_event_reset "eval + $uh_event_commands reset:%1:%2:%3:%4| uh_event_commands"
alias uh_event_list "eval + $uh_event_commands list:%1:%2:%3:%4| uh_event_commands"
alias uh_event_policy "eval + $uh_event_commands policy:%1:%2:%3:%4| uh_event_commands"
alias uh_event_check "eval + $uh_event_commands check:%1:%2:%3:%4| uh_event_commands"
alias uh_event_pool "eval + $uh_event_commands pool:%1:%2:%3:%4| uh_event_commands"
alias uh_event_export "eval + $uh_event_commands export:%1:%2:%3:%4| uh_event_commands"
alias uh_event_reload "eval + $uh_event_commands reload:%1:%2:%3:%4| uh_event_commands"
// KEYCONF aliases cannot execute writeini or exec. Print direct-console steps.
// Wait until queued edits finish before telling the host to write the INI.
alias uh_event_save "wait 1; uh_event_save_check"
alias uh_event_save_check "test || $uh_event_configbusy != $uh_event_commands \"\" uh_event_save uh_event_save_ready"
alias uh_event_save_ready "echo Event edits are complete. Run writeini directly in the server console to save."
alias uh_event_load "echo Run exec %1 directly in the server console. Then run uh_event_reload."

alias !music "pukename uh_displaycurrentmusic 0"
alias music "pukename uh_displaycurrentmusic 0"
alias mapcard "pukename uh_showmapcard"

alias +weapwheel "pukename \"uh_ww_open\""
alias -weapwheel "pukename \"uh_ww_close\""

alias uh_justjoin "closemenu; join"
alias ?cbm_justjoin "uh_justjoin"


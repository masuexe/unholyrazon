OptionMenu "UH_ClassHelpMenu"
{
	//MouseWindow 0, 220
	Title "Classes Information"
	//Position 97
	//ScrollTop 1
	Indent 20
	StaticText"$MNU_UH_EQUAL_LINE"
	StaticText ""

	Option "$MNU_CLASSINFO_NAME", "_UH_CH_Menu", "UH_ClassName"
	StaticText ""
	Option "$MNU_CLASSINFO_HEALTH", "_UH_CH_Menu", "UH_ClassHealth"
	Option "$MNU_CLASSINFO_SPEED", "_UH_CH_Menu", "UH_ClassSpeed"
	Option "$MNU_CLASSINFO_JUMPHEIGHT", "_UH_CH_Menu", "UH_ClassJump"
	StaticText ""
	Option "$MNU_CLASSINFO_MAINFIRE", "_UH_CH_Menu", "UH_ClassMainfire"
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	Option "$MNU_CLASSINFO_ALTFIRE", "_UH_CH_Menu", "UH_ClassAltfire"
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	StaticText ""
	Option "$MNU_CLASSINFO_EXTRA", "_UH_CH_Menu", "UH_ClassExtra"
	StaticText ""
	StaticText ""
	StaticText ""

	StaticText ""
	StaticText"$MNU_UH_EQUAL_LINE"

	StaticText ""
	Command "$MNU_CLASSINFO_JUMPTO", "menu_UCH_NumHelp"
	StaticText "$MNU_CLASSINFO_CURRCLASS", 2
}


// ============================================================================
// CVARINFO.ipc - UHADD <-> UHADDR argument staging / database cvars.
// (NOT settings: ACS has no string parameters across libraries, so UHADD
//  writes these and the matching UHADDR handler reads them.)
//
// Every name below must stay registered even when unused: an unregistered name
// would land in the dynamic-cvar pool and collide with other ACS-created cvars
// (e.g. MMSP bot names).  Add a new stager to its owning block.
// ============================================================================

// DefineBoss IPC
local noarchive int uh_db_id;
local noarchive string uh_db_actor;
local noarchive string uh_db_name;
local noarchive int uh_db_rarity;
local noarchive int uh_db_basehp;
local noarchive int uh_db_addhp;
local noarchive string uh_db_exbase;
local noarchive string uh_db_mugshot;
local noarchive string uh_db_music;
local noarchive string uh_db_musiccredit;
local noarchive string uh_db_instruction;
local noarchive string uh_db_spawnmsgtype;
local noarchive string uh_db_spawnmsg;
local noarchive string uh_db_ragewarning;
local noarchive string uh_db_setup;

// SetBossUnmorphCleanup IPC (reuses the uh_db_id stager above).  Missing these
// two made every SetBossUnmorphCleanupByActor call store an invalid string cell,
// so no boss unmorph cleanup script ever registered.
local noarchive string uh_db_unmorphpre;
local noarchive string uh_db_unmorphpost;

local noarchive string uh_db_out_str;


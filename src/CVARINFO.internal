// ============================================================================
// CVARINFO.internal - runtime state helpers (NOT settings).
//
// Owned by the code, never shown in a menu and never documented as tunable.
// They exist because a few scripts need somewhere to stash state that survives
// the call boundary.
// ============================================================================

// ACS CVar Helpers (runtime state stash, not configurable)
// Committed Unholy track. Gen 0 = none yet. Odd gen = mid-write; even gen = stable.
// Announce increments only for a new selection, not for a restore of the same track.
server noarchive int _uh_servmusicgen = 0;
server noarchive int _uh_servmusicannounce = 0;
server noarchive string _uh_servmusiclump = "";
server noarchive string _uh_servmusictitle = "";
server noarchive string _uh_servmusicalbum = "";
server noarchive string _uh_servmusicartist = "";
server noarchive int _uh_servmusiccontext = 0;  // 0 = other, 1 = boss, 2 = LMS
user noarchive int _uh_LastPClass = -66;  // Last Class

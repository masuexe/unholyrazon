// ============================================================================
// CVARINFO.server - public server settings.
//
// Admin-tunable, menu-visible knobs (Unholy Server Options in MENUDEF) plus the
// round-flow overrides used by RCON.  Names and defaults here are part of the
// public surface: changing one changes what server owners have configured.
// ============================================================================

server bool uh_sv_noitems = false;  // Disables spawning with items
server bool uh_sv_zangiefpull = true;  // Razon3 Zangief charge pull (normal 25 / shiny 50, range 250)
server int uh_sv_spikedamage = 355;  // Damage dealt by spike damager actors; 0 disables spike damage
server int uh_sv_pitdamage = 256;  // Damage dealt by map DeathPit markers; 0 keeps each map marker's damage
server bool uh_sv_optionalmusic = true;  // Include optional boss music rows (AddBossMusic optional=1)  // to be deleted
server bool rz_sv_randmegamancopywepdmg = true;  // MegaMan copywep daily damage multiplier
server int rz_sv_qwant_start_weapon_count = 4;  // Opening moves; capped by registered pool
server int rz_sv_nega_start_weapon_count = 3;  // Opening copy weapons; capped by registered pool
server int rz_sv_mega_m2_weapon_count = 3;  // Copy weapons per M2; positive counts, balanced across six slots
// Daily MegaMan pools: counts refer to all official weapons, not one player's loadout.
server float rz_sv_mega_normal_mul_min = 0.75;
server float rz_sv_mega_normal_mul_max = 1.25;
server bool rz_sv_mega_small_enabled = true;
server int rz_sv_mega_small_count_min = 2;
server int rz_sv_mega_small_count_max = 4;
server float rz_sv_mega_small_mul_min = 2.0;
server float rz_sv_mega_small_mul_max = 3.0;
server bool rz_sv_mega_big_enabled = true;
server int rz_sv_mega_big_count_min = 0;
server int rz_sv_mega_big_count_max = 1;
server float rz_sv_mega_big_mul_min = 4.0;
server float rz_sv_mega_big_mul_max = 6.0;
server int rz_sv_mega_ff_count_min = 6;
server int rz_sv_mega_ff_count_max = 10;
server bool rz_sv_randnegamancopywepammo = true;  // NegaMan copywep daily random ammo cost multiplier
server float rz_sv_nega_ammo_mul_min = 0.0;
server float rz_sv_nega_ammo_mul_max = 2.0;
server bool rz_sv_randmegamancopywepteamkill = true;  // MegaMan copywep daily team-FF leak weapons
server bool uh_sv_stripdtaddweps = true;  // uh_StripSurvivorWeps also takes v6b DTADD-registered (DefineWeapon) weapons
server bool rz_sv_twoplayerxray = true;  // X-Ray nametags while exactly two players remain
// Razon3 AFK mode ids: -1 off, 0 random, 1 fire, 2 GUHU, 3 Super GUHU,
// 4 Money Bait, 5 Money Bomb. Engine sv_afk2spec remains an independent policy.
server int rz_sv_noafk_item = -1;
server int rz_sv_noafk_delay = 60;  // Seconds, clamped to 30-300 at runtime
server int uh_sv_gametimer = 200;
// Clownpiece: sample settings on phase entry; survival spells retain invulnerability.
server bool uh_sv_clownpiece_autotime = true;
server int uh_sv_clownpiece_w2_time = 30;  // Base seconds, clamped to 1-300
server int uh_sv_clownpiece_w8_time = 30;  // Base seconds, clamped to 1-300
// SinfulBusterExpert: sampled on morph; invalid values use Unbound.
server int uh_sv_sbe_unlockmode = 0;  // 0 Unbound (W1-W7 initially, W8 at 40% HP); 1 progressive
server int uh_sv_timertype = 2;
server noarchive int uh_sv_timerend = 0;  // One-shot timer control: -1 disables timer, -2 forces a random ending, 1-4 force a specific ending

server noarchive int uh_sv_forcebossplayer1 = -1;  // Controls which player is the boss
server noarchive int uh_sv_forcebossplayer2 = -1;  // 0-63
server noarchive int uh_sv_forcebossplayer3 = -1;
server noarchive int uh_sv_forcebossplayer4 = -1;
server noarchive int uh_sv_forcebossplayer5 = -1;

server noarchive int uh_sv_forcedboss1 = -9999;  // Controls what boss; -9999 = none (not -1: custom ids use -1,-2,…)
server noarchive int uh_sv_forcedboss2 = -9999;
server noarchive int uh_sv_forcedboss3 = -9999;
server noarchive int uh_sv_forcedboss4 = -9999;
server noarchive int uh_sv_forcedboss5 = -9999;

// Boss pool selection. Probabilities below are sequential conditional rolls.
server int uh_sv_bossselectmode = 0;  // 0 least-seen with weighted ties; 1 weighted random; clamp 0-1
server bool uh_sv_bossavoidrepeat = false;  // Exclude the previous committed boss lineup; retry without optional exclusions if empty
server bool uh_sv_bossavoidduplicates = false;  // Exclude this round's recorded selections; same empty-pool retry
server int uh_sv_bossrarelimit = 25;  // Standard-slot Rare pity ceiling, clamp 0-100; 0 pauses Rare/Shadow promotion
server int uh_sv_bossshadowchance = 10;  // Shadow Trick chance after standard Rare promotion, clamp 0-100 percent
server int uh_sv_bossfullultrachance = 5;  // Full-pool Ultra conditional chance, clamp 0-100 percent
server int uh_sv_bossfullspecialchance = 1;  // Full-pool Special chance after Ultra fails
server int uh_sv_bossfullexchance = 15;  // Full-pool EX chance after Ultra/Special fail
server int uh_sv_bossfullrarechance = 30;  // Full-pool Rare chance after Ultra/Special/EX fail; otherwise Common
// Host-only archived data: server-string replication is limited to 2048 bytes.
// Selection/diagnostics run on the host; actor morphs use normal networking.
local string uh_sv_bossrules = "";  // Actor-keyed overrides; use uh_boss_set/reset on the server
server bool uh_sv_bossforcedplayerlimits = false;  // Apply player ranges to ordinary forced ids, Strongman and bonus winner choices; combos have separate rules

server noarchive int uh_sv_multiboss = 0;  // 1-5 Sets how many bosses

server noarchive int uh_sv_forcedshadowboss1 = -9999;  // Controls what Shadow Boss; -9999 = none
server noarchive int uh_sv_forcedshadowboss2 = -9999;
server noarchive int uh_sv_forcedshadowboss3 = -9999;
server noarchive int uh_sv_forcedshadowboss4 = -9999;
server noarchive int uh_sv_forcedshadowboss5 = -9999;

server noarchive int uh_sv_bosseventcounter = -1;  // Preset the boss-event pity counter (>=0)
server noarchive int uh_sv_bosseventnum = -1;  // Force a boss combo id (201/202/.../501/502; versus: 207, 210-218, 206=forced pair, 209=random pair; -1 = pity roll)

server bool uh_sv_bonusdeathshitting = true;  // Random death effects in Bonus Stages; evaluated at each death

server noarchive int uh_sv_bonuseventdelay = -1;  // The delay for events 0-8
server noarchive int uh_sv_bonuseventnum = -1;  // Which event 0-5, 7-16, 51, 100, 106, 111-113, 151; 50->13, 150->113
server int uh_sv_bonuseventlimit = 8;  // Normal rounds before a bonus event (1-100)
server int uh_sv_bonusminplayers = 12;  // Parade/Darkness/Brick/Mosquito random pool minimum (0-64; 0 removes the bound)
server int uh_sv_bonusexcount = 3;  // Built-in normal draws before the next draw becomes EX (0-100; 0 disables upgrades)
server int uh_sv_bonusselectmode = 0;  // 0 least-seen first; 1 weighted random (clamped to 0-1)
server bool uh_sv_bonusavoidrepeat = true;  // Exclude the previous event first; retry if the pool is empty
server bool uh_sv_bonusforcedplayerlimits = false;  // Forced selections must meet the effective player range
server bool uh_sv_bonusexplayerlimits = false;  // Pause EX progress when its target is outside the effective player range
// Host-only archived data: server-string replication is limited to 2048 bytes.
// Remote menu queries show synchronized policy, not local per-event overrides.
local string uh_sv_eventrules = "";  // Stem-keyed overrides; use uh_event_set/reset on the server
server int uh_sv_hellmarklimit = 10;  // LMS survivor wins needed for Sampi (1-100)
server int uh_sv_specimanfraglimit = 15;  // Speciman deaths needed to queue FinalSpeciman (1-100)
server int uh_sv_treasurecountlimit = 10;  // Gauntlet treasures per True Power item (1-100)
server noarchive int uh_sv_fastkilltime = 30;  // Fast-kill bonus threshold in seconds; 0 disables (0-300)
server int uh_sv_winstreaklimit = 6;  // Survivor streak that queues a random Strongman (1-100)
server int uh_sv_losestreaklimit = 6;  // Boss streak that grants Mercy Runes (1-100)
server int uh_sv_lmscountlimit = 5;  // Times one player may become last survivor before Bad LMS (1-100)
server bool uh_sv_resumeonrevive = true;  // Normal rounds: cancel pending settlement if opposing sides return; native LMS wins stay final
server bool uh_sv_postroundfriendlyfire = true;  // Allow team damage in pending/final results, including bonus events

server noarchive int uh_sv_lmsevent = -1;  // Which LMS event; -1 = random pool (custom ids ok if defined)

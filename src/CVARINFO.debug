// ============================================================================
// CVARINFO.debug - diagnostic server settings.
//
// RCON only: intentionally absent from MENUDEF.  These turn on verbose boss
// logging and retarget the debug spawn helper; they are not gameplay options.
// ============================================================================

server noarchive string rz_dbg_spawnactor = "TeleportFog";
server noarchive int rz_dbg_spawnang = 0;  // degrees, added like A_SpawnItemEx angle
// UH_Log threshold used only for calls with no acting player and no console
// player (dedicated server): same 0..4 scale as uh_cl_LogLevel, default 3 keeps
// INFO/WARN/ERROR visible.  Without it every server-side UH_Log call resolved
// the user cvar as 0 (OFF) and printed nothing.
server int uh_sv_LogLevel = 3;

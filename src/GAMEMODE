LastManStanding {
  RemoveFlag DONTSPAWNMAPTHINGS
  // Unholy draws its own TLMS-style ally/enemy counters from its side model.
  // In ordinary LMS the engine counts every other player as an enemy, including
  // Unholy's logical teammates, so its own line would show the wrong numbers.
  AddFlag DONTPRINTPLAYERSLEFT

  LockedGameSettings {
    compat_clientssendfullbuttoninfo = true
    sv_norespawninvul = true
  }
}

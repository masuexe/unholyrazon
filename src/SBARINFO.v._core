mugshot "Normal" {{ST00, ST01, ST02} 17;}
mugshot "Pain", directional {{PAINR, PAINC, PAINL} 15;}
mugshot "Rampage" {KILL 1;}
mugshot "Ouch", directional {{PAINR, PAINC, PAINL} 35;}
mugshot "Grin" {GRIN 35;}
mugshot "God" {GOD0 -1;}
mugshot "GodAnimated" {GOD0 7;GOD1 7;GOD2 7;GOD2 7;GOD1 7;GOD0 7;}
mugshot "Death" {DEAD0 -1;}
mugshot "XDeath" {DEAD0 -1;}
mugshot "Quad" {QUAD 1;}

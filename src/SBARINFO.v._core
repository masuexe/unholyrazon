      InInventory "BasicArmor", 1 {
        InInventory "HealthNumberFlag", 1 {
          DrawNumber 5, "8BDMAFONT", DarkGray, Armor, alignment(left), 31, 38;
          InInventory "ArmorSavePercent", 100 {
            DrawString "8BDMAFONT", DarkGray, "%", 46, 45, 0, alignment(left);
            DrawNumber 3, "8BDMAFONT", DarkGray, "ArmorSavePercent", alignment(right), 46, 45;
          }
          else InInventory "ArmorSavePercent", 10 {
            DrawString "8BDMAFONT", DarkGray, "%", 41, 45, 0, alignment(left);
            DrawNumber 3, "8BDMAFONT", DarkGray, "ArmorSavePercent", alignment(right), 41, 45;
          }
          else {
            DrawString "8BDMAFONT", DarkGray, "%", 36, 45, 0, alignment(left);
            DrawNumber 3, "8BDMAFONT", DarkGray, "ArmorSavePercent", alignment(right), 36, 45;
          }
        }
        InInventory "DynamicArmorDosage", 1 {DrawBar "BARAMT31", "NOBAR", Armor DynamicArmorDosage, vertical, 24, 8;}
        else {DrawBar "BARAMT31", "NOBAR", Armor, vertical, 24, 8;}
      }

      }


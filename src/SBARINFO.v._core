                InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo1Disp", alignment(right), 15, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo1, alignment(right), 15, 31;}}
                InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo2Disp", alignment(right), 15, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo2, alignment(right), 15, 38;}}
                InInventory "SBARDrawAmmo3" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo3", alignment(right), 15, 45;}
              }}}
          InInventory "SBARAmmoOffset", 2 {InInventory not "SBARAmmoOffset", 3 {
              InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo1Disp", alignment(right), 7, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo1, alignment(right), 7, 31;}}
              InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo2Disp", alignment(right), 7, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo2, alignment(right), 7, 38;}}
              InInventory "SBARDrawAmmo3" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo3", alignment(right), 7, 45;}

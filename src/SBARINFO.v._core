						InInventory "SBARDrawAmmo1" { InInventory "SBARUseAmmo1Disp" { DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo1Disp", alignment(right), -1, 31; } InInventory not "SBARUseAmmo1Disp" { DrawNumber 5, "8BDMAFONT", Untranslated, Ammo1, alignment(right), -1, 31; } }
						InInventory "SBARDrawAmmo2" { InInventory "SBARUseAmmo2Disp" { DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo2Disp", alignment(right), -1, 38; } InInventory not "SBARUseAmmo2Disp" { DrawNumber 5, "8BDMAFONT", Untranslated, Ammo2, alignment(right), -1, 38; } }
						InInventory "SBARDrawAmmo3" { DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo3", alignment(right), -1, 45; }
					}
				}

				// IfCVarInt mm8bdm_healthnumber, 1
				// dont worry jax I'm in pain too
				InInventory "HealthNumberFlag", 1 {
					// DrawNumber 5,CMBHPFONT,Untranslated,Health,/*interpolate(10),*/alignment(left),31,30;
					DrawNumber 5, "8BDMAFONT", Untranslated, Health, alignment(left), 31, 31;
				}

				DrawSelectedInventory INDEXFONT , 24, 64, 37, 64, white;
			}
			// UH_MoveHud_F: ACS DrawBar_* paints parent icon; weaponicon would be blank (move wep).
			InInventory not "UH_MoveHud_F", 1 {DrawImage weaponicon, 16, 64;}


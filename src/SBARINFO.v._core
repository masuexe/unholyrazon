            }
            InInventory "SBARAmmoOffset", 1 {InInventory not "SBARAmmoOffset", 2 {InInventory not "SBARAmmoOffset", 3 {
                  InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 15, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 15, 31;}}
                  InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 15, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 15, 38;}}
                  InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 15, 45;}
                }}}
            InInventory "SBARAmmoOffset", 2 {InInventory not "SBARAmmoOffset", 3 {
                InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 7, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 7, 31;}}
                InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 7, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 7, 38;}}
                InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, 7, 45;}
              }}
            InInventory "SBARAmmoOffset", 3 {
              InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, -1, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, -1, 31;}}
              InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, -1, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, -1, 38;}}
              InInventory "SBARDrawAmmo3" {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(right), fillzeros, -1, 45;}
            }
          }

          DrawImage "CURSEBAR", 24, 8;
          InInventory "HealthNumberFlag", 1 {DrawNumber 5, "CURSEDFONT", Untranslated, 0, alignment(left), fillzeros, 31, 31;}
        }

        DrawSelectedInventory INDEXFONT , 24, 64, 37, 64, white;
      }
      // UH_MoveHud_F: ACS DrawBar_* paints parent icon; weaponicon would be blank (move wep).
      InInventory not "UH_MoveHud_F", 1 {DrawImage weaponicon, 16, 64;}


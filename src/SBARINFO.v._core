        InInventory "AmmoNumberFlag", 1 {
          InInventory not "SBARAmmoOffset", 1 {
            InInventory "SBARDrawAmmo1" {InInventory "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo1Disp", alignment(right), 23, 31;} InInventory not "SBARUseAmmo1Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo1, alignment(right), 23, 31;}}
            InInventory "SBARDrawAmmo2" {InInventory "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo2Disp", alignment(right), 23, 38;} InInventory not "SBARUseAmmo2Disp" {DrawNumber 5, "8BDMAFONT", Untranslated, Ammo2, alignment(right), 23, 38;}}
            InInventory "SBARDrawAmmo3" {DrawNumber 5, "8BDMAFONT", Untranslated, "Ammo3", alignment(right), 23, 45;}
          }

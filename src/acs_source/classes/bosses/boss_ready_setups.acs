script "uh_BossMorphSetup_Ready" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
}

// Unbound v7b pb1: SinfulBusterExpertItem cycles the first seven attacks
// immediately; its Use2 state allows the eighth at <= 40% spawn health.
// Keep today's separate weapon slots, rather than restoring SinfulMode.
function int UH_SBE_UnboundWeaponCount(int maxhp, int hp) {
  if (hp <= maxhp * 4 / 10)
    return 8;
  return 7;
}

// Preserved Razon progression: seven equal steps across the first 60% of
// spawn health lost. Keep the original integer division order and rounding.
function int UH_SBE_ProgressiveWeaponCount(int maxhp, int hp) {
  int step = maxhp * 6 / 10 / 7;
  int count = 1;
  while (count < 8 && hp <= maxhp - count * step)
    count++;
  return count;
}

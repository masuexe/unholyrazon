// Class entry points for the shared height-limited hover controller.
script "uh_CXAirManHoverRelease" (void) {
  UH_BossHoverRelease("CXAirMan_HoverActive_F");
}

script "uh_CXAirManHover" (void) {
  ACS_NamedExecuteAlways("uh_BossHover", 0,
    "CXAirMan", "CXAirMan_HoverActive_F", "CXAirMan_HoverStamina_F");
}

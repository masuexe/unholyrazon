// Per-boss unmorph cleanup registration (library uh_bossdefs).
//
// Symmetric to boss_morph_setups.acs: the unholy round core calls the
// registered pre script BEFORE UnMorphActor and the post script AFTER the
// generic demorph reset, both as (<script>, bossid, tid) with the boss player
// passed in tid.  The generic pipeline already covers:
//
//   - property stackers (freeze/stop/invuln/fly/no-gravity/no-push/no-hitstun/
//     cant-use-items/unsolid/noradiusdmg/...): per-player baseline snapshot in
//     systems/tools/morph_reset.acs returns exactly the survivor's layers.
//   - UH PowerAprop Powers (boss speed/jump values): same baseline snapshot.
//   - air/wall jump limits: same.
//   - the boss weapon family <BossActor>_W/_W1.._W9: stripped after the
//     unmorph in uh_bossselect.acs.
//   - async watchers in special_watchers.acs: retire on the morph generation.
//   - boss-only rage markers (UnholyPowerLimit_F / ...Razzle_F): stripped by
//     the same pre-cleanup in uh_bossselect.acs.
//
// What is left for individual bosses is residue those mechanisms cannot see:
// boss-specific inventory markers, shared/global boss state (spell cards,
// Mujica membership) and grab bookkeeping (SuplexID, ZangiefAngle).  Only
// bosses with such residue are registered; RedDestron and SPOOKYGHOSTHITLER
// for example own nothing beyond the generic coverage, so they have no row.

// Per-boss stacker ownership mask for the demorph baseline clamp.  Family ids
// are the indices of uh_morphpropstackname in systems/tools/morph_reset.acs;
// the mask was generated by scanning each boss's own DECORATE for stacker
// acquisitions, so the clamp can never walk down a family the boss does not use
// (a surplus there belongs to a map, an item or another mod).  Bosses without a
// row (and addon bosses) keep the legacy all-families behaviour.
function void UH_RegisterBossOwnedFamilies(str actor, int mask) {
  SetBossUnmorphFamsByActor(actor, mask);
}

function void UH_RegisterBossUnmorphCleanups(void) {
  SetBossUnmorphCleanupByActor("CXAirMan", "uh_BossUnmorphCleanup_CXAirMan", "");
  SetBossUnmorphCleanupByActor("Misery", "uh_BossUnmorphCleanup_Misery", "");
  // Ready phase shells own flags and weapon names outside the generic _W1..9 family.
  SetBossUnmorphCleanupByActor("KFCDragon756", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("GravitymanKamilia", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("CuttyCut", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("MeisterWahwee", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("TorontoCalifornia", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("Troutius", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("Pharaohman4MI", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");
  SetBossUnmorphCleanupByActor("RedeadGuts", "uh_BossUnmorphCleanup_ReadyPhase", "uh_BossUnmorphPost_ReadyPhase");

  // Batch 1: Destrons, Lin, SinfulBusterExpert, Clownpiece, SakikoTogawa.
  SetBossUnmorphCleanupByActor("BlueDestron", "uh_BossUnmorphCleanup_Destron", "");
  SetBossUnmorphCleanupByActor("PurpleDestron", "uh_BossUnmorphCleanup_Destron", "");
  SetBossUnmorphCleanupByActor("Lin", "uh_BossUnmorphCleanup_Lin", "");
  SetBossUnmorphCleanupByActor("SinfulBusterExpert", "uh_BossUnmorphCleanup_SinfulBusterExpert", "");
  SetBossUnmorphCleanupByActor("Clownpiece", "uh_BossUnmorphCleanup_Clownpiece", "");
  SetBossUnmorphCleanupByActor("SakikoTogawa", "uh_BossUnmorphCleanup_SakikoTogawa", "");

  // Batch 2: every boss that can hold a Zangief/Suplex grab when the fakeout
  // fires (the same release works for all of them), plus the bosses whose
  // non-stacker state outlives the morph.
  SetBossUnmorphCleanupByActor("TheShadowManMythBoss", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("TheCommandoChamp", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("ScrotoStuntDouble", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("ChieftainTomahawk", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("Berserker", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("GraniteMauler", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("Balrog", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("EyelentoMajor", "uh_BossUnmorphCleanup_GrabRelease", "");
  SetBossUnmorphCleanupByActor("Rogue", "uh_BossUnmorphCleanup_Rogue", "");
  SetBossUnmorphCleanupByActor("MagicDevilEye", "uh_BossUnmorphCleanup_MagicDevilEye", "");
  SetBossUnmorphCleanupByActor("Magnetismo", "uh_BossUnmorphCleanup_Magnetismo", "");
  SetBossUnmorphCleanupByActor("MakeAGoodZero", "uh_BossUnmorphCleanup_MakeAGoodZero", "");
  SetBossUnmorphCleanupByActor("DLCCentaurman", "uh_BossUnmorphCleanup_DLCCentaurman", "");

  // Stacker ownership masks (generated from each boss's DECORATE).
  UH_RegisterBossOwnedFamilies("BlueDestron", 16);  // Flight
  UH_RegisterBossOwnedFamilies("PurpleDestron", 16);  // Flight
  UH_RegisterBossOwnedFamilies("Lin", 66048);  // NoPush, NoHitStun
  UH_RegisterBossOwnedFamilies("SinfulBusterExpert", 65);  // Frozen, NoGravity
  UH_RegisterBossOwnedFamilies("Clownpiece", 85);  // Frozen, Invulnerable, Flight, NoGravity
  UH_RegisterBossOwnedFamilies("SakikoTogawa", 0);  // none: its leaks are Power/global state
  UH_RegisterBossOwnedFamilies("TheShadowManMythBoss", 5210951);
  UH_RegisterBossOwnedFamilies("TheCommandoChamp", 5210951);
  UH_RegisterBossOwnedFamilies("ScrotoStuntDouble", 5210951);
  UH_RegisterBossOwnedFamilies("ChieftainTomahawk", 4751431);
  UH_RegisterBossOwnedFamilies("Berserker", 4751367);
  UH_RegisterBossOwnedFamilies("GraniteMauler", 2130183);
  UH_RegisterBossOwnedFamilies("Balrog", 4817472);
  UH_RegisterBossOwnedFamilies("EyelentoMajor", 557058);
  UH_RegisterBossOwnedFamilies("Rogue", 65668);
  UH_RegisterBossOwnedFamilies("MagicDevilEye", 70);
  UH_RegisterBossOwnedFamilies("Magnetismo", 1);
  UH_RegisterBossOwnedFamilies("MakeAGoodZero", 4);
  UH_RegisterBossOwnedFamilies("DLCCentaurman", 524288);
}


// --- Misery ------------------------------------------------------------------
script "uh_BossUnmorphCleanup_Misery" (int bossid, int tid) {
  if (!SetActivator(tid)) terminate;
  ACS_NamedExecuteWithResult("uh_MiseryHoverRelease");
  TakeInventory("Misery_HoverStamina_F", 999);
  TakeInventory("PowerStaminaFlagDeplete", 1);
  TakeInventory("Misery_OrbPhase_F", 2);
  TakeInventory("Misery_Orb_Canceller", 999);
  TakeInventory("CutterFlag", 999);
}

// --- Destron family ----------------------------------------------------------
// Blue/Purple start a per-shot watcher on Ready; both retire on the morph
// generation bump.  Their per-shot CustomInventory markers and the Purple
// health baseline are not stackers and would otherwise ride along.
script "uh_BossUnmorphCleanup_Destron" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("BlueDestronAbility_P", 999);
  TakeInventory("DestronDotFire_P", 999);
  TakeInventory("LimHealth", 999);
}

// --- Lin ---------------------------------------------------------------------
// LinCheating_P is consumed on pickup, but the unlimited X-Ray it starts is a
// CLIENTSIDE loop: clearing its marker ends the nametags on the survivor.  The
// no-push / no-hitstun layers it granted come back through the demorph
// baseline, and rz_LinRageWatcher retires on the generation bump.
script "uh_BossUnmorphCleanup_Lin" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("LinCheating_P", 999);
  TakeInventory("UH_XRayVisionOn_F", 999);
}

// --- SinfulBusterExpert ------------------------------------------------------
// The sin watcher hands out W2..W8 at HP thresholds; it retires on the
// generation bump and the weapon family is stripped generically.  Only its
// ammo counters and the aim helper are boss-only inventory.
script "uh_BossUnmorphCleanup_SinfulBusterExpert" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("SBEAimThingy", 999);
  TakeInventory("SBESueAmmo", 999);
  TakeInventory("SBEWaylonAmmo", 999);
  TakeInventory("SBESutokaAmmo", 999);
  TakeInventory("SBEJohnsonAmmo", 999);
  TakeInventory("SBEHawkeyeAmmo", 999);
  TakeInventory("SBEKachidongaAmmo", 999);
  TakeInventory("SBEJavierAmmo", 999);
  TakeInventory("SBEHellBotAmmo", 999);
}

// --- Clownpiece --------------------------------------------------------------
// Spell-card session state lives in the unholy library and is shared, so it
// must be cancelled through its own script (see clownpiece_spellcard.acs).
script "uh_BossUnmorphCleanup_Clownpiece" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_ClownpieceUnmorphCancel");
}

// --- SakikoTogawa ------------------------------------------------------------
// Mujica membership is a map-global count, so it is released as a pair.
script "uh_BossUnmorphCleanup_SakikoTogawa" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_MujicaRelease", 0, tid);
  TakeInventory("SakiAltFlag", 999);
}

// --- Grab-type bosses --------------------------------------------------------
// SuplexID / IsPerformingSuplex / ZangiefAngle / ZangiefHoldFlag are the boss's
// half of the Zangief grab link.  Clearing them releases the grabbed player's
// pain-driven link, and the victim-side helpers (BasicBoss_Rooted, Cloak/Smoke,
// Rage watchers) retire because uh_IsLiveMorphedBossByPointer now requires MorphedFlag.
// The stacker layers the grab applied are returned by the demorph baseline.
script "uh_BossUnmorphCleanup_GrabRelease" (int bossid, int tid) {
  SetActivator(tid);
  if (!CheckInventory("SuplexID") && !CheckInventory("IsPerformingSuplex") &&
      !CheckInventory("ZangiefHoldFlag")) {
    terminate;
  }
  TakeInventory("SuplexID", 999);
  TakeInventory("IsPerformingSuplex", 999);
  TakeInventory("ZangiefAngle", 999);
  TakeInventory("ZangiefHoldFlag", 999);
  TakeInventory("SuplexFlySlow", 999);
  TakeInventory("CaughtYouFlag", 999);
  TakeInventory("DashingStraitjacket_F", 999);
}

// --- Rogue -------------------------------------------------------------------
// Rogue's Ready grants NoHitStun (baseline covers the layer) and its shield
// grants a long-lived PowerSpeed plus a self-following warper; both are
// boss-only.  RogueShieldWarper_F / RogueShieldFlag gate that state.
script "uh_BossUnmorphCleanup_Rogue" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("RogueShieldWarper_F", 1);
  TakeInventory("RogueShieldFlag", 999);
  TakeInventory("PowerRogueShieldUp", 1);
  TakeInventory("RogueCubeIsAlive", 999);
  TakeInventory("RogueGetUpDone_F", 1);
}

// --- MagicDevilEye -----------------------------------------------------------
// The eye already owns its stacks with MagicDevilEye*_F markers and ships a
// concentrated reset pickup; run that instead of popping layers blindly, then
// drop the remaining boss-only markers.
script "uh_BossUnmorphCleanup_MagicDevilEye" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("MagicDevilEye_ClearProps_P", 1);
  TakeInventory("MagicDevilEyeCharge_F", 999);
  TakeInventory("MagicDevilEyeMash_F", 999);
  TakeInventory("MagicDevilEyeDelay_F", 999);
}

// --- Magnetismo --------------------------------------------------------------
// ShieldCheck keeps MagnetismoJunkWarper orbiting and MagnetismoPulseFlag is
// the pulse counter; neither is a stacker, so they are not in the baseline.
script "uh_BossUnmorphCleanup_Magnetismo" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("ShieldCheck", 999);
  TakeInventory("MagnetismoPulseFlag", 999);
  TakeInventory("DynamicArmorDosage_F", 999);
}

// --- MakeAGoodZero -----------------------------------------------------------
// Both of its watchers (MGZeroChipAmmoWatcher, MGZeroIcicleDriveWatcher) now
// retire through uh_IsLiveMorphedBossByPointer, so the extra invuln layer they applied is
// returned by the baseline and the Death path.  Only the phase/chip bookkeeping
// is boss-only inventory.
script "uh_BossUnmorphCleanup_MakeAGoodZero" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("MGZeroIcicleDriveShieldCheck", 999);
  TakeInventory("MakeAGoodZeroPhase3Transition_F", 1);
  TakeInventory("MakeAGoodZeroGetUpDone_F", 1);
  TakeInventory("MakeAGoodZeroPainFlag", 1);
  TakeInventory("MakeAGoodZeroPhase3PainFlag", 1);
}

// --- DLCCentaurman -----------------------------------------------------------
// Its rage watcher pops the cant-use-items layer itself and now also retires on
// unmorph via uh_IsLiveMorphedBossByPointer; the identity flag and the rage gate are the
// residue that has no owner-side removal.
script "uh_BossUnmorphCleanup_DLCCentaurman" (int bossid, int tid) {
  SetActivator(tid);
  TakeInventory("DLCCentaurmanFlag", 1);
  TakeInventory("DLCCentaurmanRageDelay", 999);
  TakeInventory("DLCCentaurLaserSide_F", 1);
}

// Retire phase state before the morph inventory transfers to the survivor.
script "uh_BossUnmorphCleanup_ReadyPhase" (int bossid, int tid) {
  if (!SetActivator(tid)) terminate;
  TakeInventory("UH_PhaseResume_F", 10000);
  str actor = UH_GetBossActor(bossid);
  if (!StrICmp(actor, "KFCDragon756")) {
    TakeInventory("KFCDragon756GetUpDone_F", 999);
    TakeInventory("KFCDragon756PainFlag", 999);
  }
  if (!StrICmp(actor, "GravitymanKamilia")) {
    TakeInventory("GravitymanKamiliaGetUpDone_F", 999);
    TakeInventory("GravitymanKamiliaPainFlag", 999);
  }
  if (!StrICmp(actor, "CuttyCut")) {
    TakeInventory("CuttyCutGetUpDone_F", 999);
    TakeInventory("CuttyCutPainFlag", 999);
  }
  if (!StrICmp(actor, "MeisterWahwee")) {
    TakeInventory("MeisterWahweeGetUpDone_F", 999);
    TakeInventory("MeisterWahweePainFlag", 999);
  }
  if (!StrICmp(actor, "TorontoCalifornia")) {
    TakeInventory("TorontoCaliforniaGetUpDone_F", 999);
    TakeInventory("TorontoCaliforniaPainFlag", 999);
  }
  if (!StrICmp(actor, "Troutius")) {
    TakeInventory("TroutiusGetUpDone_F", 999);
    TakeInventory("TroutiusPainFlag", 999);
  }
  if (!StrICmp(actor, "Pharaohman4MI")) {
    TakeInventory("Pharaohman4MIGetUpDone_F", 999);
    TakeInventory("Pharaohman4MIPainFlag", 999);
  }
  if (!StrICmp(actor, "RedeadGuts")) {
    TakeInventory("RedeadGutsGetUpDone_F", 999);
    TakeInventory("RedeadGutsPainFlag", 999);
  }
}

// These phase weapon suffixes are not covered by the generic _W1..9 sweep.
script "uh_BossUnmorphPost_ReadyPhase" (int bossid, int tid) {
  if (!SetActivator(tid)) terminate;
  str actor = UH_GetBossActor(bossid);
  if (!StrICmp(actor, "KFCDragon756")) {
    TakeInventory("KFCDragon756_W_Pissed", 999);
  }
  if (!StrICmp(actor, "GravitymanKamilia")) {
    TakeInventory("GravitymanKamilia_W_Pissed", 999);
  }
  if (!StrICmp(actor, "CuttyCut")) {
    TakeInventory("CuttyCut_W_Pissed1", 999);
    TakeInventory("CuttyCut_W_Pissed2", 999);
  }
  if (!StrICmp(actor, "MeisterWahwee")) {
    TakeInventory("MeisterWahwee_W_Pissed", 999);
    TakeInventory("Wahwee_W1", 999);
    TakeInventory("Wahwee_W2", 999);
  }
  if (!StrICmp(actor, "TorontoCalifornia")) {
    TakeInventory("TorontoCalifornia_W_Pissed", 999);
  }
  if (!StrICmp(actor, "Troutius")) {
    TakeInventory("Troutius_W_Pissed", 999);
  }
  if (!StrICmp(actor, "Pharaohman4MI")) {
    TakeInventory("Pharaohman4MI_W_Pissed", 999);
  }
  if (!StrICmp(actor, "RedeadGuts")) {
    TakeInventory("RedeadGuts_W_Pissed", 999);
  }
}

script "uh_BossUnmorphCleanup_CXAirMan" (int bossid, int tid) {
  if (!SetActivator(tid)) terminate;
  ACS_NamedExecuteWithResult("uh_CXAirManHoverRelease");
  TakeInventory("CXAirMan_HoverStamina_F", 999);
  TakeInventory("PowerStaminaFlagDeplete", 1);
}

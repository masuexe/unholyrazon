// Class entry points for the shared height-limited hover controller.
script "uh_MiseryHoverRelease" (void) {
  UH_BossHoverRelease("Misery_HoverActive_F");
}

script "uh_MiseryHover" (void) {
  ACS_NamedExecuteAlways("uh_BossHover", 0,
    "Misery", "Misery_HoverActive_F", "Misery_HoverStamina_F");
}

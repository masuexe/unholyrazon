// Unlimited-altitude permanent flight with pit stamina for Higlur.
script "uh_SPOOKYGHOSTHITLERHoverRelease" (void) {
  UH_BossHoverRelease("SPOOKYGHOSTHITLER_HoverActive_F");
}

script "uh_SPOOKYGHOSTHITLERHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "SPOOKYGHOSTHITLER", "SPOOKYGHOSTHITLER_HoverActive_F",
    "SPOOKYGHOSTHITLER_HoverStamina_F");
}

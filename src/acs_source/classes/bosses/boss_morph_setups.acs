function void UH_RegisterBossMorphSetups(void) {
  SetBossMorphSetupByActor("KakusaretaSutoka", "uh_BossMorphSetup_KakusaretaSutoka");
  SetBossMorphSetupByActor("ArchArcanist", "uh_BossMorphSetup_ArchArcanist");
  SetBossMorphSetupByActor("CuttyCut", "uh_BossMorphSetup_CuttyCut");
  SetBossMorphSetupByActor("RedeadGuts", "uh_BossMorphSetup_RedeadGuts");
  SetBossMorphSetupByActor("Troutius", "uh_BossMorphSetup_Troutius");
  SetBossMorphSetupByActor("TorontoCalifornia", "uh_BossMorphSetup_TorontoCalifornia");
  SetBossMorphSetupByActor("MeisterWahwee", "uh_BossMorphSetup_MeisterWahwee");
  SetBossMorphSetupByActor("SadFaceToadMan", "uh_BossMorphSetup_SadFaceToadMan");
  SetBossMorphSetupByActor("WarRockStelar", "uh_BossMorphSetup_WarRockStelar");
  SetBossMorphSetupByActor("VoidWalker", "uh_BossMorphSetup_VoidWalker");
  SetBossMorphSetupByActor("Lin", "uh_BossMorphSetup_Lin");
  SetBossMorphSetupByActor("SinfulBusterExpert", "uh_BossMorphSetup_SinfulBusterExpert");
  SetBossMorphSetupByActor("GBeast", "uh_BossMorphSetup_GBeast");
  SetBossMorphSetupByActor("FBeast", "uh_BossMorphSetup_FBeast");
  SetBossMorphSetupByActor("GENERICBOSS", "uh_BossMorphSetup_GENERICBOSS");
  SetBossMorphSetupByActor("Misery", "uh_BossMorphSetup_Misery");
  SetBossMorphSetupByActor("ScrotoStuntDouble", "uh_BossMorphSetup_ScrotoStuntDouble");
  SetBossMorphSetupByActor("RedBaronDuo", "uh_BossMorphSetup_RedBaronDuo");
  SetBossMorphSetupByActor("BlueJayDuo", "uh_BossMorphSetup_BlueJayDuo");
  SetBossMorphSetupByActor("SirAlpha", "uh_BossMorphSetup_SirAlpha");
  SetBossMorphSetupByActor("SPOOKYGHOSTHITLER", "uh_BossMorphSetup_SPOOKYGHOSTHITLER");
  SetBossMorphSetupByActor("FinalSampi", "uh_BossMorphSetup_FinalSampi");
}

script "uh_BossMorphSetup_KakusaretaSutoka" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("KakusaretaSutoka_W", 1);
  GiveInventory("KakusaretaSutoka_W2", 1);
  GiveInventory("KakusaretaSutoka_W3", 1);
  GiveInventory("UnholyPowerLimit_F", 1500);
  GiveInventory("UnholyPowerDisableRazzle_F", 1);
}

script "uh_BossMorphSetup_ArchArcanist" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("ArchArcanist_W", 1);
  GiveInventory("ArchArcanist_W2", 1);
  GiveInventory("ArchArcanist_W3", 1);
  GiveInventory("UnholyPowerLimit_F", 1500);
}

script "uh_BossMorphSetup_CuttyCut" (int bossid, int tid) {
  SetActivator(tid);
  // ExtraLife once here; Ready may re-enter online
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 2, 0); // ELP_NATIVE
}

script "uh_BossMorphSetup_RedeadGuts" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0); // ELP_NATIVE
}

script "uh_BossMorphSetup_Troutius" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0); // ELP_NATIVE
}

script "uh_BossMorphSetup_TorontoCalifornia" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0); // ELP_NATIVE
  GiveInventory("AirJumpLimit", 1);  // Go Go Gadget
  GiveInventory("WallJumpLimit", 1);  // Slip 'n Slide
}

script "uh_BossMorphSetup_MeisterWahwee" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0); // ELP_NATIVE
}

script "uh_BossMorphSetup_SadFaceToadMan" (int bossid, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0); // ELP_NATIVE
}

script "uh_BossMorphSetup_WarRockStelar" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("WarRockStelar_W", 1);
  GiveInventory("WarRockStelar_W2", 1);
  ACS_NamedExecuteWithResult("rz_LowHPWarning", 1);
}

script "uh_BossMorphSetup_VoidWalker" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("VoidWalker_W", 1);
  GiveInventory("VoidWalker_W2", 1);
  GiveInventory("VoidWalker_W3", 1);
  GiveInventory("VoidWalker_W4", 1);
  GiveInventory("VeryFunOrbSpawner", 1);
  GiveInventory("OrbFlagWind", 1);
}

script "uh_BossMorphSetup_Lin" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("Lin_W1", 1);
  GiveInventory("Lin_W2", 1);
  GiveInventory("UnholyBossAmmo150", 150);
  ACS_NamedExecuteAlways("rz_LinRageWatcher", 0);
}

script "uh_BossMorphSetup_SinfulBusterExpert" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("SinfulBusterExpert_W1", 1);
  GiveInventory("UnholyPowerLimit_F", 1500);
  ACS_NamedExecuteAlways("rz_SinfulBusterExpertSinWatcher", 0);
}

script "uh_BossMorphSetup_GBeast" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("GBeast_W1", 1);
  GiveInventory("GBeast_W2", 1);
  GiveInventory("GBeast_W3", 1);
  GiveInventory("GBeast_W4", 1);
  GiveInventory("GBeast_W5", 1);
  GiveInventory("GBeast_W6", 1);
  GiveInventory("UnholyPowerLimit_F", 1500);
  ACS_NamedExecuteWithResult("rz_LowHPWarning", 0);
}

script "uh_BossMorphSetup_FBeast" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("FBeast_W1", 1);
  GiveInventory("FBeast_W2", 1);
  GiveInventory("FBeast_W3", 1);
  GiveInventory("FBeast_W4", 1);
  GiveInventory("FBeast_W5", 1);
  GiveInventory("FBeast_W6", 1);
  ACS_NamedExecuteWithResult("rz_LowHPWarning", 0);
  GiveInventory("AirJumpLimit", 3);
}

script "uh_BossMorphSetup_GENERICBOSS" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("AirJumpLimit", 1);
  // Runs after MorphActor() returns, so it survives ActivateMorphWeapon()'s
  // final ps_flash clear and starts the weapon's Flash monitor.  The full
  // timing reason is documented at GenericBossFlashStarter_P in GENERICBOSS_W.dec.
  GiveInventory("GenericBossFlashStarter_P", 1);
}

script "uh_BossMorphSetup_Misery" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("AirJumpLimit", 9);
  // Start after ActivateMorphWeapon() has finished clearing ps_flash.
  GiveInventory("MiseryFlashStarter_P", 1);
}

script "uh_BossMorphSetup_ScrotoStuntDouble" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("AirJumpLimit", 1);
  GiveInventory("WallJumpLimit", 1);
}

script "uh_BossMorphSetup_RedBaronDuo" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("AirJumpLimit", 3);
}

script "uh_BossMorphSetup_BlueJayDuo" (int bossid, int tid) {
  SetActivator(tid);
  GiveInventory("AirJumpLimit", 3);
}

script "uh_BossMorphSetup_SirAlpha" (int bossid, int tid) {
  ACS_NamedExecuteWithResult("uh_SetSurvivorStartItem", "", tid);
}

script "uh_BossMorphSetup_SPOOKYGHOSTHITLER" (int bossid, int tid) {
  ACS_NamedExecuteWithResult("uh_SetSurvivorStartItem", "", tid);
}

script "uh_BossMorphSetup_FinalSampi" (int bossid, int tid) {
  ACS_NamedExecuteWithResult("uh_SetSurvivorStartItem", "TruePowerItem", tid);
  SetActivator(tid);
  GiveInventory("FinalSampi_W1", 1);
  GiveInventory("FinalSampi_W2", 1);
  GiveInventory("FinalSampi_W3", 1);
  GiveInventory("FinalSampi_W4", 1);
  GiveInventory("FinalSampi_W5", 1);
  GiveInventory("FinalSampi_W6", 1);
  GiveInventory("FinalSampi_W7", 1);
  GiveInventory("UnholyPowerLimit_F", 3000);
}

script "uh_define_vanilla_bosses" OPEN
{
  if (!UHInPlay()) terminate;
  if (UH_IsBossDefined(0)) terminate;
  UH_RegisterVanillaBossDefs();
  RegisterBossPresentations();
}

// Joining clients never run non-CLIENTSIDE OPEN; fill local UHDT here for HUD names.
script "uh_define_vanilla_bosses_cs" OPEN CLIENTSIDE
{
  // Skip UHInPlay: SpawnForced can fail on pure clients; this library only loads with UH.
  if (UH_IsBossDefined(0)) terminate;
  UH_RegisterVanillaBossDefs();
  RegisterBossPresentations();
}

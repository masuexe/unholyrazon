script "uh_BossMorphSetup_TorontoCalifornia" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, 0);  // ELP_NATIVE

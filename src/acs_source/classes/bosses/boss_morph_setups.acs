script "uh_BossMorphSetup_FBeast" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
  GiveInventory("FBeast_W1", 1);
  GiveInventory("FBeast_W2", 1);
  GiveInventory("FBeast_W3", 1);
  GiveInventory("FBeast_W4", 1);
  GiveInventory("FBeast_W5", 1);
  GiveInventory("FBeast_W6", 1);
  ACS_NamedExecuteWithResult("rz_LowHPWarning", 0);
  GiveInventory("AirJumpLimit", 3);
}

script "uh_BossMorphSetup_GENERICBOSS" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
  GiveInventory("AirJumpLimit", 1);
  // Runs after MorphActor() returns, so it survives ActivateMorphWeapon()'s
  // final ps_flash clear and starts the weapon's Flash monitor.  The full
  // timing reason is documented at GenericBossFlashStarter_P in GENERICBOSS_W.dec.
  GiveInventory("GenericBossFlashStarter_P", 1);
}

script "uh_BossMorphSetup_Misery" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
  GiveInventory("Misery_HoverStamina_F", 500);
  ACS_NamedExecuteAlways("uh_MiseryHover", 0);
  // Flash starts from the weapon's Ready after the online selection settles.
}

script "uh_BossMorphSetup_ScrotoStuntDouble" (int bossid, int tid) {
  if (!SetActivator(tid) || CheckInventory("UH_BossSetupDone_F")) terminate;
  GiveInventory("UH_BossSetupDone_F", 1);
  UH_SetupBossReady();
  GiveInventory("AirJumpLimit", 1);
  GiveInventory("WallJumpLimit", 1);
}


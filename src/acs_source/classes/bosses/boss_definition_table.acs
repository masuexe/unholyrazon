  );
  AddBossMusic(50, "M_UB050", "Super Hardman 64 (Sped-Up)", "", "Shadic64", 1, 0);
  DefineBoss(
    51, "WarRockStelar", "\cdWar Rock Stelar",
    UHBOSS_POOL_COMMON,
    4065, 350,
    "",
    "",
    "My name is (You don't need to remember), Geo Stelar, age 15.\nThe past month to me is only my father disappearing while \nworking in the satellite that brings really exciting and worrying days.\n\nUntil I met this space dog.......\n\n\ckFire bullets, don't fire to build up power!\n\cdCreate a shield to block things!\n\cnThe ability to use a sword up-close!",
    "", "", ""
  );
  AddBossMusic(51, "M_UB051", "Ride On", "Mega Man Star Force 1", "Yoshino Aoki", 1, 0);
  DefineBoss(
    52, "HarpStrumm", "\cdHarp Strumm",
    UHBOSS_POOL_COMMON,
    3950, 335,
    "",
    "",
    "Haha, wow! Are we in the battlefield now?\nLet's blast their ears with some tunes they'll never forget!\nTons of genres to play! Pick one and knock them dead!\nFrom here, we'll be a **\ca**shooting star **\c-**!",
    "", "", ""
  );
  AddBossMusic(52, "M_UB051", "Ride On", "Mega Man Star Force 1", "Yoshino Aoki", 1, 0);
  DefineBoss(
    53, "TidalTito", "\cvTidal \chTito",
    UHBOSS_POOL_COMMON,
    3365, 337,
    "",
    "",
    "'Ey brotha, \cvTidal \chTito \c-here.\nWould you like to know the ways of the ocean? Good.\nIt ebbs and flows, just like my heart.\n\cfWeak but quick \c-at its lowest, \cgstrong yet slow \c-at its highest.\nA surfer's soul resonates with this, remember that always.",
    "", "", ""
  );
  AddBossMusic(53, "M_UB053", "Wakeboard", "Crash Bandicoot 2: N-Tranced", "Shin'en Multimedia", 1, 0);
  DefineBoss(
    54, "VoidWalker", "\ctVoid Walker",
    UHBOSS_POOL_COMMON,
    4750, 385,
    "",
    "",
    "I am a wanderer of the void, nowhere important.\nI have mastered the elements, test this power with care. (M1/M2)\nI might need all four to win, maybe... (Item)\nNow... \ctEn-Garde!",
    "", "", ""
  );
  AddBossMusic(54, "M_UB054", "Boss Theme", "Final Fantasy 4 Advance", "Nobuo Uematsu", 1, 0);
  DefineBoss(
    55, "CrazedGrenademan", "\cgCrazed \ciGrenademan",
    UHBOSS_POOL_COMMON,
    3865, 387,
    "",
    "",
    "What'll it be, fellas? Carnage or Chaos? \nThere ain't a choice for anyone cause they mean the same thin'! \nSo how 'bout we light up this 'ere fuses and paint the town red? \nThen we can celebrate with a dance where we both clash heads, I ain't dazed I swear it! \nWith a bit more \camoonshine\c-, I'm sure these explosives will be even more pretty...",
    "", "", ""
  );
  AddBossMusic(55, "M_UB055", "Docaty Mountain Railroad", "Super Mario RPG", "Yoko Shimomura", 1, 0);
  DefineBoss(
    56, "MorshuBoss", "\cqMorshu",
    UHBOSS_POOL_COMMON,
    3310, 302,
    "",
    "",
    "It's time to get richer!\nBombs on the M1, you want it?\nLamp oil molotov cocktails? It's yours, on the M2.\nRope? It's an item, you'll have to give me CREDIT.",
    "", "", ""
  );
  AddBossMusic(56, "M_UB056", "Boss Theme (Slightly Sped-Up)", "Wario: Master of Disguise", "Masaru Tajima", 1, 0);
  DefineBoss(
    57, "TheCommandoChamp", "\cdThe \cqCommando \cdCHAMP",
    UHBOSS_POOL_COMMON,
    4250, 350,
    "",
    "",
    "Are you a bad enough dude?\nAuthorized command to initiate \cgOperation Deathblow\c-.\nFire the missiles and scatter the mines.\nCapture hostiles and show them basic illegal CQC.\nBe the ideal patriot, today.",
    "", "", ""

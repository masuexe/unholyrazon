  AddBossMusic(57, "M_UB057", "Rumbling on the City (Slightly Faster)", "The King of Fighters '98", "Shinsekai Gakkyoku Zatsugidan", 1, 0);
  DefineBoss(
    58, "JoeOfDuty", "\cqJoe",
    UHBOSS_POOL_COMMON,
    2000, 250,
    "",
    "",
    "Note from HQ to \cqJoe\c-.\nGun down armed hostiles at all costs.\nYou are efficient at close quarters.\nDon't pick fights you can't win.\nAnd remember the main objective...\n\nKill \cgHitler\c-.",
    "", "", ""

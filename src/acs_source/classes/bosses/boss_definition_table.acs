  AddBossMusic(58, "M_UB058", "Days of Ruin (slightly altered)", "Advance Wars: Days of Ruin", "Yoshito Hirano", 1, 0);
  DefineBoss(
    59, "Balrog", "\ciBalrog",
    UHBOSS_POOL_COMMON,
    3750, 550,
    "",
    "",
    "\cgHUZZAH!\c- Oh Yeaaaaah! \nLet's get to the point. I grab people, they die. \nI hover up and fire missiles and they die. \nAnd I can just pick them off with these basic projectiles. \nIs this in-character? Probably not, but I don't care!",
    "", "", ""
  );
  AddBossMusic(59, "M_UB059", "Eyes of Flame", "Cave Story", "Parabeetle X", 1, 0);
  DefineBoss(
    60, "Misery", "\cdMisery",
    UHBOSS_POOL_COMMON,
    2500, 375,
    "",
    "",
    "\ccOh, what a bother. Not THIS again... \n\c-Let's get to the point. I prefer if people weren't in my proximity. \nI can channel more energy to cast upon a deadlier spell, just enough to really get them out of my sight. \nOr how about just making sure they stay six feet under? Or obliterating them into nothing but ashes. \nFufufu...",
    "", "", ""
  );
  AddBossMusic(60, "M_UB059", "Eyes of Flame", "Cave Story", "Parabeetle X", 1, 0);

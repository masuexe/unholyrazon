// Unbound's melon item was usable without changing the weapon psprite.
// Watch raw reload presses on the server instead of entering weapon Reload.
script "uh_TropicalMWS_ReloadWatcher" (void) {
  int player = PlayerNumber();
  if (player < 0)
    terminate;
  int mygen = GetPlayerMorphGen(player);

  while (PlayerHealth() > 0) {
    if (!UH_WatcherStillOwnsBoss(mygen, player) ||
        StrICmp(GetActorClass(0), "TropicalMWS"))
      terminate;

    int buttons = GetPlayerInput(-1, INPUT_BUTTONS);
    int oldbuttons = GetPlayerInput(-1, INPUT_OLDBUTTONS);
    if ((buttons & ~oldbuttons & BT_RELOAD) &&
        CheckInventory("UnholyPower1000") >= 1000)
      GiveInventory("TropicalMWS_Melon_P", 1);
    Delay(1);
  }
}

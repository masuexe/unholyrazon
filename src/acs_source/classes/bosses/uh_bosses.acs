// Screen scare script
script "uh_ScreenScare" (int screen, int holdtime) {
  if (GetUserCVar(PlayerNumber(), "uh_cl_HideScreenScare")) {
    SetHudSize(320, 224, 0);  // Ghost Busters Logo NES/Genesis
    SetFont("U_SCARE0");  // U_SCARE1
    HudMessage(s:"A"; HUDMSG_FADEINOUT, 666, -1, 160.4, 112.0, holdtime * 0.1, 0.15, 0.25);
  }
  else {
    SetHudSize(scaryscreensize[screen][0], scaryscreensize[screen][1], 0);
    SetFont(StrParam(s:"U_SCAR", i:screen));
    int temp_x2 = (scaryscreensize[screen][0] / 2) << 16;
    int temp_y2 = (scaryscreensize[screen][1] / 2) << 16;
    // ScaryScreen[Screen][2], 0.5
    HudMessage(s:"A"; HUDMSG_FADEOUT, 666, CR_UNTRANSLATED, temp_x2 + 0.4, temp_y2, holdtime * 0.1, 0.2);
  }
}

#define EDENMAN_DYE 42119
#define EDENMAN_DYE2 43119

// ExtraLife floor poll. Gravity Flash is a gravity-switch overlay that can
// stop (NoFlash) and is only restarted by AltFire, so HP-at-1 must not live there.
script "uh_GravitymanKamiliaELPoll" (void) {
  int hp;

  if (CheckInventory("GravitymanKamiliaELPoll_F")) {
    terminate;
  }
  GiveInventory("GravitymanKamiliaELPoll_F", 1);

  while (PlayerNumber() >= 0 && PlayerInGame(PlayerNumber()) &&
    !CheckInventory("IsDead") &&
    CheckInventory("GravitymanKamilia_W") &&
    !CheckInventory("GravitymanKamilia_W_Pissed")) {
    hp = GetActorProperty(0, APROP_HEALTH);
    if ((hp < 2 || CheckInventory("Health") < 2) &&
      !CheckInventory("IsPissedFlag") &&
      !CheckInventory("GravitymanKamiliaPainFlag")) {
      GiveInventory("GravitymanKamiliaSwapPissed_P", 1);
      break;
    }
    Delay(1);
  }

  TakeInventory("GravitymanKamiliaELPoll_F", 1);
}

script "uh_GravitymanKamiliaEdenDye" (void) {
  while (PlayerNumber() >= 0 && PlayerInGame(PlayerNumber()) &&
    !CheckInventory("IsDead") &&
    CheckInventory("IsPissedFlag") &&
    CheckInventory("GravitymanKamilia_W_Pissed")) {
    ACS_NamedExecuteWithResult("core_weaponcolor", EDENMAN_DYE, CLRF_SILENT);
    Delay(5);
    if (CheckInventory("IsDead") || !CheckInventory("GravitymanKamilia_W_Pissed")) {
      break;
    }
    ACS_NamedExecuteWithResult("core_weaponcolor", EDENMAN_DYE2, CLRF_SILENT);
    Delay(5);
  }
}

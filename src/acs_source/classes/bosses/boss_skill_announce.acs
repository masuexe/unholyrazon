#define UH_BOSS_SKILL_BANNER_ID -8850

// VoidWalker (Boss 54) Skills
#define UH_SKILL_VW_AWAKEN        5400
#define UH_SKILL_VW_STATICSTORM   5401
#define UH_SKILL_VW_TERRATRACKER  5402
#define UH_SKILL_VW_FRIGIDFREEZER 5403
#define UH_SKILL_VW_RAZINGRAY     5404
#define UH_SKILL_VW_METEOR        5405
#define UH_SKILL_VW_SHREDDER      5406
#define UH_SKILL_VW_FINALCLAW     5407
#define UH_SKILL_VW_DARKSTAR      5408
#define UH_SKILL_VW_PETALBLAST    5409
#define UH_SKILL_VW_SANDSTORM     5410
#define UH_SKILL_VW_BLIZZARD      5411
#define UH_SKILL_VW_FLAMEWALL     5412
#define UH_SKILL_VW_COUNT5        5414
#define UH_SKILL_VW_COUNT4        5415
#define UH_SKILL_VW_COUNT3        5416
#define UH_SKILL_VW_COUNT2        5417
#define UH_SKILL_VW_COUNT1        5418
#define UH_SKILL_VW_STATICE       5419
#define UH_SKILL_VW_LIGHTNINGORB  5420
#define UH_SKILL_VW_ELECTROSHOCK  5421
#define UH_SKILL_VW_BOLT          5422
#define UH_SKILL_VW_LIGHTBEAM     5423

// Server entry point: broadcasts boss skill notice to all connected peers
script "uh_AnnounceBossSkill" (int skillId) {
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (PlayerInGame(p) || PlayerIsSpectator(p)) {
      NamedExecuteClientScript("uh_BossSkillNotice_Client", p, skillId);
    }
  }
}

// Client-side RPG-style skill announcement banner
script "uh_BossSkillNotice_Client" (int skillId) CLIENTSIDE {
  str skillName = "";
  str skillColor = "";
  str skillSound = "MarioRPG/EnemyCrystal";

  switch (skillId) {
    case UH_SKILL_VW_STATICSTORM:
      skillName = "Static Storm";
      skillColor = "\cd"; // Light green (Wind)
      break;

    case UH_SKILL_VW_TERRATRACKER:
      skillName = "Terra Tracker";
      skillColor = "\ck"; // Yellow/gold (Earth)
      break;

    case UH_SKILL_VW_FRIGIDFREEZER:
      skillName = "Frigid Freezer";
      skillColor = "\cv"; // Cyan/light blue (Water)
      break;

    case UH_SKILL_VW_RAZINGRAY:
      skillName = "Razing Ray";
      skillColor = "\cg"; // Red/orange (Fire)
      break;

    case UH_SKILL_VW_AWAKEN:
      skillName = "CULEX 3D: AWAKENING";
      skillColor = "\cj";
      skillSound = "MarioRPG/EnemyCrystal";
      break;

    case UH_SKILL_VW_METEOR:
      skillName = "Meteor";
      skillColor = "\cg";
      skillSound = "MarioRPG/Meteor";
      break;

    case UH_SKILL_VW_SHREDDER:
      skillName = "Shredder";
      skillColor = "\ct";
      skillSound = "MarioRPG/Shredder";
      break;

    case UH_SKILL_VW_FINALCLAW:
      skillName = "Final Claw";
      skillColor = "\cg";
      skillSound = "MarioRPG/DeathSickle";
      break;

    case UH_SKILL_VW_DARKSTAR:
      skillName = "Dark Star";
      skillColor = "\cm";
      skillSound = "MarioRPG/DeathStar";
      break;

    case UH_SKILL_VW_PETALBLAST:
      skillName = "Petal Blast";
      skillColor = "\cd";
      skillSound = "MarioRPG/PetalBlast";
      break;

    case UH_SKILL_VW_SANDSTORM:
      skillName = "Sand Storm";
      skillColor = "\cu";
      skillSound = "MarioRPG/SandStorm";
      break;

    case UH_SKILL_VW_BLIZZARD:
      skillName = "Blizzard";
      skillColor = "\cv";
      skillSound = "MarioRPG/Snowy";
      break;

    case UH_SKILL_VW_FLAMEWALL:
      skillName = "Flame Wall";
      skillColor = "\cg";
      skillSound = "MarioRPG/CoronaBeam";
      break;

    case UH_SKILL_VW_COUNT5:
      skillName = "Meteor in 5...";
      skillColor = "\cf";
      skillSound = "MarioRPG/SmithyHammerP";
      break;

    case UH_SKILL_VW_COUNT4:
      skillName = "Meteor in 4...";
      skillColor = "\cf";
      skillSound = "MarioRPG/SmithyHammerP";
      break;

    case UH_SKILL_VW_COUNT3:
      skillName = "Meteor in 3...";
      skillColor = "\ci";
      skillSound = "MarioRPG/SmithyHammerP";
      break;

    case UH_SKILL_VW_COUNT2:
      skillName = "Meteor in 2...";
      skillColor = "\ci";
      skillSound = "MarioRPG/SmithyHammerP";
      break;

    case UH_SKILL_VW_COUNT1:
      skillName = "Meteor in 1...";
      skillColor = "\cg";
      skillSound = "MarioRPG/SmithyHammerP";
      break;

    case UH_SKILL_VW_STATICE:
      skillName = "Static E!";
      skillColor = "\cd";
      skillSound = "MarioRPG/StaticE";
      break;

    case UH_SKILL_VW_LIGHTNINGORB:
      skillName = "Lightning Orb";
      skillColor = "\cd";
      skillSound = "MarioRPG/StaticE";
      break;

    case UH_SKILL_VW_ELECTROSHOCK:
      skillName = "Electroshock";
      skillColor = "\cd";
      skillSound = "MarioRPG/BowserLightning";
      break;

    case UH_SKILL_VW_BOLT:
      skillName = "Bolt";
      skillColor = "\cd";
      skillSound = "MarioRPG/BowserLightning";
      break;

    case UH_SKILL_VW_LIGHTBEAM:
      skillName = "Light Beam";
      skillColor = "\cd";
      skillSound = "MarioRPG/BowserLightning";
      break;

    default:
      terminate;
  }

  // Delivery is already per client. The activator is still the caster, so
  // local-view-filtered HUD/sound calls would hide notices from other peers.
  AmbientSound(skillSound, 127);

  // Set HUD virtual resolution to 640x480
  SetHudSize(640, 480, 0);
  SetFont("BIGFONT");

  // Center horizontally at X=320.4, near top at Y=50.8
  // HUDMSG_FADEOUT: display for 1.5 seconds, fade out over 0.4 seconds
  HudMessageBold(s:"\cc[ ", s:skillColor, s:skillName, s:"\cc ]";
             HUDMSG_FADEOUT, UH_BOSS_SKILL_BANNER_ID, CR_WHITE,
             320.4, 50.8, 1.5, 0.4);
}

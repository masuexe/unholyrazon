// Phase-two spell geometry and delayed casts. Included in uh_classes after
// voidwalker_orbs; no extra library or map arrays.
function bool UH_VWPhaseAlive(int boss, int generation) {
  return SetActivator(boss) && UH_VWIsOwner()
    && GetPlayerMorphGen(PlayerNumber()) == generation
    && CheckInventory("VoidWalkerPhase2_F");
}

function bool UH_VWEnemy(int boss, int p, int range, bool sight) {
  if (!PlayerInGame(p) || PlayerIsSpectator(p)) return false;
  int tid = p + 1000;
  if (tid == boss || GetActorProperty(tid, APROP_Health) <= 0) return false;
  if (ACS_NamedExecuteWithResult("uh_AreGameplayTeammates", boss - 1000, p)) return false;
  if (XYZDistance(boss, tid) > range) return false;
  return !sight || CheckSight(boss, tid, CSF_NOBLOCKALL);
}

// Aim cone is +/-45 degrees. Reservoir selection gives every eligible player
// equal probability. A target behind the boss is never eligible.
function int UH_VWFrontTarget(int boss) {
  int result = 0;
  int count = 0;
  int yaw = GetActorAngle(boss);
  for (int p = 0; p < MAX_PLAYERS; p++) {
    // PLS_SURVIVOR is the round-core role; Demoneyes are not saw anchors.
    if (ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", p) != 1) continue;
    if (!UH_VWEnemy(boss, p, 1800.0, true)) continue;
    int tid = p + 1000;
    int angle = VectorAngle(GetActorX(tid) - GetActorX(boss), GetActorY(tid) - GetActorY(boss));
    int delta = WrapAround(angle - yaw, -0.5, 0.5);
    if (abs(delta) > 0.125) continue;
    count++;
    if (Random(1, count) == 1) result = tid;
  }
  return result;
}

// Find closest visible enemy survivor within given range.
function int UH_VWClosestTarget(int boss, int range) {
  int bestTid = 0;
  int bestDist = range + 1.0;
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", p) != 1) continue;
    if (!UH_VWEnemy(boss, p, range, true)) continue;
    int tid = p + 1000;
    int d = XYZDistance(boss, tid);
    if (d < bestDist) {
      bestDist = d;
      bestTid = tid;
    }
  }
  return bestTid;
}

// Spawn with exact shooter pointer, so native missiles / A_Explode preserve
// damage attribution and self protection. Call only with a live owner.
function int UH_VWSpawn(str type, int boss, int x, int y, int z, int yaw) {
  int tid = UniqueTID();
  if (!SpawnForced(type, x, y, z, tid, yaw >> 8)) return 0;
  SetActorAngle(tid, yaw);
  SetActivator(tid);
  SetPointer(AAPTR_TARGET, boss);
  SetActivator(boss);
  return tid;
}

// Flame Saber is a sweep, never a life-steal effect. Both waves snapshot their
// anchor at cast time; later target movement can dodge the returning blades.
script "uh_VWCast" (int spell) {
  if (!UH_VWIsOwner() || !CheckInventory("VoidWalkerPhase2_F")) terminate;
  int boss = ActivatorTID();
  int generation = GetPlayerMorphGen(PlayerNumber());
  int bx = GetActorX(boss);
  int by = GetActorY(boss);
  int bz = GetActorZ(boss) + 32.0;
  int yaw = GetActorAngle(boss);
  int pitch = GetActorPitch(boss);
  int target = UH_VWFrontTarget(boss);
  int px = bx + FixedMul(800.0, FixedMul(cos(yaw), cos(pitch)));
  int py = by + FixedMul(800.0, FixedMul(sin(yaw), cos(pitch)));
  int pz = bz - FixedMul(800.0, sin(pitch));
  if (target) {
    px = GetActorX(target);
    py = GetActorY(target);
    pz = GetActorZ(target) + GetActorProperty(target, APROP_Height) / 2;
  }
  int tid;
  int angle;
  int z;
  int p;
  int i;

  if (spell == 1) { // Electroshock: closest enemy within 1024 gets sparks, then lightning strike & electrical ball.
    int shockTarget = UH_VWClosestTarget(boss, 1024.0);
    int tx, ty, tz;
    if (shockTarget) {
      tx = GetActorX(shockTarget);
      ty = GetActorY(shockTarget);
      tz = GetActorZ(shockTarget);
    } else {
      // Fallback: point 400 units in front of boss along aim line
      tx = bx + FixedMul(400.0, cos(yaw));
      ty = by + FixedMul(400.0, sin(yaw));
      tz = bz;
    }
    // Phase 1: Sparks warning falling onto target
    tid = UH_VWSpawn("VWElectroshockSparksFX", boss, tx, ty, tz + 48.0, yaw);
    if (shockTarget && tid) {
      SetActivator(tid);
      SetPointer(AAPTR_TRACER, shockTarget);
      SetActivator(boss);
    }
    Delay(14);
    if (!UH_VWPhaseAlive(boss, generation)) terminate;
    if (shockTarget && GetActorProperty(shockTarget, APROP_Health) > 0) {
      tx = GetActorX(shockTarget);
      ty = GetActorY(shockTarget);
      tz = GetActorZ(shockTarget);
    }
    // Phase 2 & 3: Strike column + damaging ball cage on target
    int strikeTid = UH_VWSpawn("VWElectroshockStrike", boss, tx, ty, tz, yaw);
    if (shockTarget && strikeTid) {
      SetActivator(strikeTid);
      SetPointer(AAPTR_TRACER, shockTarget);
      SetActivator(boss);
    }
    terminate;
  }

  if (spell == 9) { // Static E!: screen-wide discharge. SMRPG hits every target
    // and cannot be blocked or dodged, so this ignores sight and cover.
    for (i = 0; i < 3; i++) {
      if (!UH_VWPhaseAlive(boss, generation)) terminate;
      SetActivator(boss);
      UH_VWSpawn("VWStaticEDischarge", boss, bx, by, bz, yaw);
      for (p = 0; p < MAX_PLAYERS; p++) {
        if (!UH_VWEnemy(boss, p, 4096.0, false)) continue;
        int struck = p + 1000;
        SetActivator(boss);
        Thing_Damage2(struck, 18, "StaticE");
        UH_VWSpawn("VWStaticESparkFX", boss, GetActorX(struck),
          GetActorY(struck), GetActorZ(struck) + 24.0, yaw);
      }
      Delay(6);
    }
    terminate;
  }

  if (spell == 4) { // Diamond Saw: two outward, then two converging blades.
    int axis = VectorAngle(px - bx, py - by);
    for (i = -1; i <= 1; i += 2) {
      angle = axis + i * 0.125;
      tid = UH_VWSpawn("VWDiamondSaw", boss, bx, by, bz, angle);
      if (tid) SetActorVelocity(tid, FixedMul(32.0, cos(angle)), FixedMul(32.0, sin(angle)), 0, false, false);
    }
    angle = VectorAngle(px - bx, py - by);
    Delay(18);
    if (!UH_VWPhaseAlive(boss, generation)) terminate;
    for (i = -1; i <= 1; i += 2) {
      int back = angle + 0.5 + i * 0.125;
      int sx = px + FixedMul(448.0, cos(back));
      int sy = py + FixedMul(448.0, sin(back));
      tid = UH_VWSpawn("VWDiamondSaw", boss, sx, sy, pz, back + 0.5);
      if (tid) SetActorVelocity(tid, FixedMul(-32.0, cos(back)), FixedMul(-32.0, sin(back)), 0, false, false);
    }
    terminate;
  }

  if (spell == 0) { // Boulder: AstroCrush / RainFlush-style wide-area falling & forward-rolling boulders.
    for (i = 0; i < 6; i++) {
      if (!UH_VWPhaseAlive(boss, generation)) terminate;
      for (int b = 0; b < 3; b++) {
        int fwd = (i == 0 && b == 0) ? 128.0 : Random(-192, 384) * 1.0;
        int side = (i == 0 && b == 0) ? 0 : Random(-320, 320) * 1.0;
        int rx = bx + FixedMul(fwd, cos(yaw)) + FixedMul(side, cos(yaw + 0.25));
        int ry = by + FixedMul(fwd, sin(yaw)) + FixedMul(side, sin(yaw + 0.25));
        tid = UH_VWSpawn("VWBoulderSlam", boss, rx, ry, bz, yaw);
        if (tid) {
          int fz = GetActorFloorZ(tid);
          int cz = GetActorCeilingZ(tid);
          z = min(max(bz, fz) + 320.0, cz - 48.0);
          if (z < fz + 24.0) z = fz + 24.0;
          SetActorPosition(tid, rx, ry, z, false);
          SetActorVelocity(tid, FixedMul(20.0, cos(yaw)), FixedMul(20.0, sin(yaw)), -22.0, false, false);
        }
      }
      if (i < 5) Delay(5);
    }
    terminate;
  }

  if (spell == 11 || spell == 8) { // Crystal rain / lethal Meteor Blast.
    str rain = "VWCrystal";
    if (spell == 8) rain = "VWMeteorBlast";
    for (i = 0; i < 3; i++) {
      if (!UH_VWPhaseAlive(boss, generation)) terminate;
      int victims = 0;
      for (p = 0; p < MAX_PLAYERS; p++) {
        if (!UH_VWEnemy(boss, p, 2048.0, true)) continue;
        victims++;
        int victim = p + 1000;
        z = min(GetActorZ(victim) + 384.0, GetActorCeilingZ(victim) - 48.0);
        tid = UH_VWSpawn(rain, boss, GetActorX(victim) + Random(-64, 64) * 1.0,
          GetActorY(victim) + Random(-64, 64) * 1.0, z, yaw);
        if (tid) SetActorVelocity(tid, 0, 0, -24.0, false, false);
      }
      if (!victims) {
        tid = UH_VWSpawn(rain, boss, bx + FixedMul(160.0, cos(yaw)),
          by + FixedMul(160.0, sin(yaw)), min(GetActorCeilingZ(boss) - 48.0, bz + 256.0), yaw);
        if (tid) SetActorVelocity(tid, 0, 0, -24.0, false, false);
      }
      Delay(10);
    }
    terminate;
  }

  if (spell == 2) { // Water Blast: W-Blast-style accelerating AoE water eruption around the caster.
    UH_VWSpawn("VWWaterBlast", boss, bx, by, GetActorZ(boss), yaw);
    terminate;
  }

  if (spell == 10) { // Advancing fire wall.
    for (i = -2; i <= 2; i++) {
      int sx2 = bx + FixedMul(i * 32.0, cos(yaw + 0.25));
      int sy2 = by + FixedMul(i * 32.0, sin(yaw + 0.25));
      tid = UH_VWSpawn("VWFlameWallPillar", boss, sx2, sy2, bz - 24.0, yaw);
      if (tid) SetActorVelocity(tid, FixedMul(24.0, cos(yaw)), FixedMul(24.0, sin(yaw)), 0, false, false);
    }
    terminate;
  }

  if (spell == 6) { // Flame Saber sweeps the forward field over 18 tics.
    for (i = -3; i <= 3; i++) {
      if (!UH_VWPhaseAlive(boss, generation)) terminate;
      angle = yaw + i * 0.04;
      for (int d = 1; d <= 8; d++)
        UH_VWSpawn("VWMegaDrainBeam", boss, bx + FixedMul(d * 96.0, cos(angle)),
          by + FixedMul(d * 96.0, sin(angle)), bz, angle);
      for (p = 0; p < MAX_PLAYERS; p++) {
        if (!UH_VWEnemy(boss, p, 900.0, true)) continue;
        int va = VectorAngle(GetActorX(p + 1000) - bx, GetActorY(p + 1000) - by);
        if (abs(WrapAround(va - angle, -0.5, 0.5)) <= 0.025) {
          SetActivator(boss);
          Thing_Damage2(p + 1000, 55, "VWMegaDrain");
        }
      }
      Delay(3);
    }
    terminate;
  }

  // Rage casts use bounded pulses, checking the exact morph before
  // each pulse. Gameplay effects are only applied to eligible enemies.
  int pulses = 1;
  if (spell == 3 || spell == 5 || spell == 7) pulses = 4;
  for (i = 0; i < pulses; i++) {
    if (!UH_VWPhaseAlive(boss, generation)) terminate;
    for (p = 0; p < MAX_PLAYERS; p++) {
      if (!UH_VWEnemy(boss, p, 2048.0, true)) continue;
      int vt = p + 1000;
      SetActivator(boss);
      if (spell == 3) {
        UH_VWSpawn("VWSandStormFX", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt) + 24.0, yaw);
        UH_VWSpawn("VWSandStormHit", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt) + 24.0, yaw);
      } else if (spell == 5) {
        UH_VWSpawn("VWBlizzardFX", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt) + 24.0, yaw);
        UH_VWSpawn("VWBlizzardHit", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt) + 24.0, yaw);
      } else if (spell == 7) {
        UH_VWSpawn("VWCoronaFirePillar", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt), yaw);
      }
    }
    if (pulses > 1) Delay(8);
  }
}

// Light Beam burst: the travelling bubble calls this when it pops. Every enemy
// survivor near the burst takes a direct LightBeam hit. That type is an alias
// in the shared Bubble damage event, so the hit also applies the Bubble status
// and traps the target. A direct hit is deliberate: the event refuses a hit
// that is not effective, and radius damage would lose the damage type on its
// visibility path.
script "uh_VWLightBubbleBurst" (void) {
  int x = GetActorX(0);
  int y = GetActorY(0);
  int z = GetActorZ(0);
  if (!SetActivator(0, AAPTR_TARGET) || !UH_VWIsOwner()) terminate;
  int boss = ActivatorTID();
  for (int p = 0; p < MAX_PLAYERS; p++) {
    // The range argument only answers "is this an eligible enemy". The burst
    // geometry is the local check below, so this must not be a short distance:
    // a tight range here would reject every victim of a burst that lands away
    // from the boss. uh_VWMeteorImpact uses the same split.
    if (!UH_VWEnemy(boss, p, 4096.0, false)) continue;
    int struck = p + 1000;
    if (VectorLength(GetActorX(struck) - x, GetActorY(struck) - y) > 160.0) continue;
    if (abs(GetActorZ(struck) + GetActorProperty(struck, APROP_Height) / 2 - z) > 128.0) continue;
    SetActivator(boss);
    Thing_Damage2(struck, 30, "LightBeam");
  }
}

// The projectile's target is the shooter. Use ordinary radius damage with a
// modest value; the late damage event caps health loss after every modifier.
script "uh_VWMeteorImpact" (void) {
  int x = GetActorX(0);
  int y = GetActorY(0);
  int z = GetActorZ(0);
  if (!SetActivator(0, AAPTR_TARGET) || !UH_VWIsOwner()) terminate;
  int boss = ActivatorTID();
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (!UH_VWEnemy(boss, p, 4096.0, false)) continue;
    int vt = p + 1000;
    if (VectorLength(GetActorX(vt) - x, GetActorY(vt) - y) > 192.0) continue;
    if (abs(GetActorZ(vt) + GetActorProperty(vt, APROP_Height) / 2 - z) > 192.0) continue;
    SetActivator(boss);
    Thing_Damage2(vt, 110, "VWMeteor");
  }
}

// Solidify ground field: any enemy inside the CLDW EFG zone gets encased in
// CLDW JKL ABCD on their position and takes continuous VWSolidify damage.
script "uh_VWSolidifyField" (void) {
  int fx = GetActorX(0);
  int fy = GetActorY(0);
  int fz = GetActorZ(0);
  if (!SetActivator(0, AAPTR_TARGET) || !UH_VWIsOwner()) terminate;
  int boss = ActivatorTID();
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (!UH_VWEnemy(boss, p, 4096.0, false)) continue;
    int vt = p + 1000;
    if (VectorLength(GetActorX(vt) - fx, GetActorY(vt) - fy) > 192.0) continue;
    if (abs(GetActorZ(vt) - fz) > 160.0) continue;
    if (CheckActorInventory(vt, "VWSolidifyEncaseFlag") > 0) continue;
    GiveActorInventory(vt, "VWSolidifyEncaseFlag", 1);
    SetActivator(boss);
    Thing_Damage2(vt, 20, "VWSolidify");
    int cage = UH_VWSpawn("VWSolidifyEncase", boss, GetActorX(vt), GetActorY(vt), GetActorZ(vt), GetActorAngle(vt));
    if (cage) {
      SetActivator(cage);
      SetPointer(AAPTR_TRACER, vt);
      SetActivator(boss);
    }
  }
}

script "uh_VWSolidifyTick" (int dmg) {
  int encase = UniqueTID();
  Thing_ChangeTID(0, encase);
  if (!SetActivator(encase, AAPTR_TRACER)) {
    Thing_ChangeTID(encase, 0);
    terminate;
  }
  int vt = ActivatorTID();
  if (!SetActivator(encase, AAPTR_TARGET) || !UH_VWIsOwner()) {
    Thing_ChangeTID(encase, 0);
    terminate;
  }
  int boss = ActivatorTID();
  Thing_ChangeTID(encase, 0);
  if (vt < 1000 || vt >= 1000 + MAX_PLAYERS) terminate;
  if (!UH_VWEnemy(boss, vt - 1000, 4096.0, false)) terminate;
  SetActivator(boss);
  Thing_Damage2(vt, dmg, "VWSolidify");
}

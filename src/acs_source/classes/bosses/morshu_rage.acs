// Roll movement on the server only. Remote weapon psprites must not apply
// their own angle changes on top of the authoritative spectator snapshots.
script "uh_MorshuRageMove" (void) {
  int turn = 10.0 / 360;
  if (Random(0, 1)) {turn = -turn;}
  ChangeActorAngle(0, GetActorAngle(0) + turn, true);
  ThrustThing(Random(0, 255), 500, 1, 0);
}

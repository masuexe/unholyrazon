// Remote weapon psprites can outlive the server's rage state. Never let them
// keep turning the observed actor after the ultimate ends. Keep the original
// server-selected direction, and broadcast the final angle with degrees = 0
// before thawing the player. This script is deliberately not CLIENTSIDE.
script "uh_MorshuRageTurn" (int degrees) {
  SetActorAngle(0, GetActorAngle(0) + degrees * 1.0 / 360);
}

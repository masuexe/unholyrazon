// SakikoTogawa / Ave Mujica lifecycle fragment (library uh_bosses).
// Round-core state (gameover, zankoragecheck, lighting, boss-slot allies,
// special-win claim) is accessed through uh_access; music through #import uh_music.

#define MUJICA_MEMBER_LIMIT 5
#define MUJICA_DYE_BASE 31120

// Stepped blackout ramp matching unholy/uh_lighting.acs.
#define UH_MUJICA_DARK_LIGHT 10
#define UH_MUJICA_FADE_STEPS 35
#define UH_MUJICA_END_FADE_STEPS 30
#define UH_MUJICA_FADE_STEP_TICS 7

int mujicamembers;

// Razon3 ran this from Sakiko's corpse. The server DEATH hook now covers
// every death animation, including deaths that never spawn a class corpse.
function void DisbandMujica(void) {
  ACS_NamedExecuteWithResult("rz_SoraNoMusicaCancel", 1);
  for (int tid = 1000; tid < 1064; tid++) {
    if (GetActorProperty(tid, APROP_Health) > 0 &&
        CheckActorInventory(tid, "IsAMujicaMember")) {
      GiveActorInventory(tid, "AntiInvincibleBuddha_P", 1);
      Thing_Damage(tid, 6000000, 5);
    }
  }
}

function void ClearMujicaState(void) {
  mujicamembers = 0;
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (!PlayerInGame(p)) continue;
    TakeActorInventory(p + 1000, "IsAMujicaMember", 1);
    for (int i = 0; i < 4; i++) {
      TakeActorInventory(p + 1000, StrParam(s:"PowerMujicaColor", i:i), 1);
    }
  }
}

script "uh_DisbandMujica" (void) {
  DisbandMujica();
}

script "uh_ClearMujicaState" (void) {
  ClearMujicaState();
}

function int DressMeForMujica(void) {
  int startingcolor = random(0, 3);

  for (int i = 0; i < 4; i++) {
    int colorindex = (startingcolor + i) % 4;
    bool isused = false;

    for (int j = 1000; j < 1064; j++) {
      if (CheckActorInventory(j, StrParam(s:"PowerMujicaColor", i:colorindex))) {
        isused = true;
        break;
      }
    }

    if (!isused) {
      Thing_SetTranslation(0, MUJICA_DYE_BASE + colorindex * 1000);
      GiveInventory(StrParam(s:"PowerMujicaColor", i:colorindex), 1);
      if (colorindex == 1) {  // Mortis
        GiveInventory("MortisBlessing_P", 1);
      }
      return colorindex;
    }
  }

  return -1;
}

script "rz_SakiInit" (void) {
  if (CheckInventory("IsAMujicaMember")) terminate;
  GiveInventory("IsAMujicaMember", 1);
  mujicamembers++;
}

script "rz_MujicaRevival" (void) {
  if (CheckInventory("IsAMujicaMember")) terminate;
  if (mujicamembers >= MUJICA_MEMBER_LIMIT) terminate;

  int mynumber = DressMeForMujica();
  if (mynumber == -1) terminate;

  str mujicaname[4] = {
    "\c[x0]Doloris",
    "\c[s7]Mortis",
    "\c[m7]Timoris",
    "\c[c7]Amoris"
  };

  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  HudMessageBold(s:StrParam(n:0, s:"\ck is now ", s:mujicaname[mynumber], s:"\ck!"); HUDMSG_FADEOUT | HUDMSG_LOG, 50, 10, 320.4, 352.2, 1.8, 0.2);

  GiveInventory("IsAMujicaMember", 1);
  mujicamembers++;

  if (mujicamembers >= MUJICA_MEMBER_LIMIT) {
    ACS_NamedExecute("rz_SoraNoMusica", 0);
    terminate;
  }
}

script "rz_SoraNoMusica" (void) {
  ACS_NamedExecuteWithResult("uh_SetZankoRageCheck", 1);
  UH_Log(UH_LOG_DEBUG, StrParam(s:"Ave Mujica Sora no Musica started."));

  MusicSaveFunc();
  UH_PlayTrack("SORAMUS", "Sora no Musica", "Alea jacta est", "Ave Mujica", 0, 1);

  // Darken the arena with the stepped UH_MUJICA_* ramp instead of a Light_Fade:
  // a running fade cannot be stopped for untagged sectors, so cancelling the
  // masquerade would leave the map dark (see uh_lighting.acs).
  int soralightstart = ACS_NamedExecuteWithResult("uh_GetLightLevelTrack");
  int sorafadestep;
  for (int i = 0; i < 280; i++) {
    if (ACS_NamedExecuteWithResult("uh_GetGameOverState")) {terminate;}
    if (i < UH_MUJICA_FADE_STEPS * UH_MUJICA_FADE_STEP_TICS) {
      sorafadestep = i / UH_MUJICA_FADE_STEP_TICS + 1;
      if (i % UH_MUJICA_FADE_STEP_TICS == 0) {
        ACS_NamedExecuteWithResult("uh_InstantLightChange", soralightstart +
          ((UH_MUJICA_DARK_LIGHT - soralightstart) * sorafadestep) / UH_MUJICA_FADE_STEPS);
      }
    }
    Delay(1);
  }

  if (ACS_NamedExecuteWithResult("uh_GetGameOverState")) {terminate;}

  GiveActorInventory(ActivatorTID(), "InvulnerableOn_Pickup", 1);

  int deadtid = 1000;
  until (deadtid == 1064) {
    if (CheckActorInventory(deadtid, "IsAMujicaMember") || ACS_NamedExecuteWithResult("uh_IsBossSlotTid", deadtid)) {
      // Mujica members and existing hell allies survive the masquerade.
    }
    else {
      GiveActorInventory(deadtid, "AntiInvincible_P", 1);
      Thing_Damage(deadtid, 6000000, 5);
    }
    deadtid++;
  }

  // This special wipe is a Boss-side win; claim the round, refresh post-round
  // FF, record the win-rate counter, and protect surviving players.
  ACS_NamedExecuteWithResult("uh_ClaimBossSpecialWin");
  PlayMusic_Loss(2);

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);
  HudMessageBold(s:"Let's get started,\ntonight's masquerade!"; HUDMSG_FADEOUT | HUDMSG_LOG, 66, CR_PURPLE, 240.4, 54.0, 3.0, 2.0);
  AmbientSound("misc/hugequake", 127);
  Radius_Quake(9, 70, 0, 150, ActivatorTID());
  SetPlayerProperty(1, 1, 4);

  // The masquerade runs with the Mujica member as activator; the round exit
  // must not be attributed to them.
  ACS_NamedExecute("ub_ExitFinishedRound", 0, 35 * 6);
  // Black the arena out while the exit delay runs (30 * 7 = 210 tics), replacing
  // the former Delay(35 * 6) without changing when the round exits.
  for (sorafadestep = 1; sorafadestep <= UH_MUJICA_END_FADE_STEPS; sorafadestep++) {
    ACS_NamedExecuteWithResult("uh_InstantLightChange", UH_MUJICA_DARK_LIGHT -
      (UH_MUJICA_DARK_LIGHT * sorafadestep) / UH_MUJICA_END_FADE_STEPS);
    Delay(UH_MUJICA_FADE_STEP_TICS);
  }
}

script "rz_SoraNoMusicaCancel" (int z) {
  switch (z) {
    case 0:
      if (ACS_NamedExecuteWithResult("uh_GetZankoRageCheck")) {SetResultValue(0);}
      else {SetResultValue(1);}
      break;
    case 1:
      ACS_NamedExecuteWithResult("uh_SetZankoRageCheck", 0);
      ACS_NamedTerminate("rz_SoraNoMusica", 0);
      if (StrCmp(UH_CurrentMusicLump(), "SORAMUS") == 0) {
        UH_RestoreMusic();
      }
      // The masquerade ramps the light in Light_ChangeToValue steps, so nothing
      // keeps fading afterwards and this reset is final.
      ACS_NamedExecuteWithResult("uh_InstantLightChange",
        ACS_NamedExecuteWithResult("uh_GetLightLevelTrack"));
      break;
  }
}

// Boss unmorph: release ONE player's Mujica membership and keep the map-global
// member count in sync, so a shadow fakeout cannot leave the survivor holding
// IsAMujicaMember while mujicamembers still counts them (which would also block
// rz_SoraNoMusicaCancel and mis-report the group size).
script "uh_MujicaRelease" (int tid) {
  SetActivator(tid);
  if (!CheckInventory("IsAMujicaMember"))
    terminate;
  TakeInventory("IsAMujicaMember", 1);
  for (int i = 0; i < 4; i++)
    TakeInventory(StrParam(s:"PowerMujicaColor", i:i), 1);
  if (mujicamembers > 0)
    mujicamembers--;
  if (mujicamembers < MUJICA_MEMBER_LIMIT)
    ACS_NamedExecuteAlways("rz_SoraNoMusicaCancel", 0, 1);
}

script "rz_MujicaFallen" (void) {
  if (mujicamembers >= MUJICA_MEMBER_LIMIT) {
    ACS_NamedExecuteAlways("rz_SoraNoMusicaCancel", 0, 1);
  }
  if (mujicamembers > 0) {
    mujicamembers--;
  }
}

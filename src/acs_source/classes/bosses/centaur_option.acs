// Fragment of library uh_classes.
// DLCCentaurOption (Recca-style option satellites) support scripts.

#define CENTOPT_ORBIT_R 48  // orbit radius around the master, map units
#define CENTOPT_REST_OFF 192  // byte-angle offset for the right-hand rest slot

// Server-owned handles, allocated before A_SpawnItemEx so repeated pickup
// pulses in one tic cannot claim the same slot. No fixed/shared TID range.
int centopt_tid[64][2];

function bool UH_CentaurOptionExists(int pnum, int slot) {
  int tid = centopt_tid[pnum][slot];
  return tid > 0 && ThingCountName("DLCCentaurOption", tid) > 0 &&
      GetActorProperty(tid, APROP_TargetTID) == pnum + 1000;
}

function int UH_CentaurOptionCount(int pnum) {
  if (pnum < 0 || pnum >= 64) return 0;
  return UH_CentaurOptionExists(pnum, 0) + UH_CentaurOptionExists(pnum, 1);
}

// Called by the player's CustomInventory spawner immediately before spawning.
script "rz_CentaurOptionSpawnTid" (void) {
  int pnum = PlayerNumber();
  if (pnum < 0 || pnum >= 64) { SetResultValue(0); terminate; }
  for (int slot = 0; slot < 2 && slot < CheckInventory("DLCCentaurOptionStack"); slot++) {
    if (!UH_CentaurOptionExists(pnum, slot)) {
      centopt_tid[pnum][slot] = UniqueTID();
      SetResultValue(centopt_tid[pnum][slot]);
      terminate;
    }
  }
  SetResultValue(0);
}

// The slot belongs to this owner, rather than to a map-wide spawn ordinal.
script "rz_CentaurOptionSlot" (void) {
  int tid = ActivatorTID();
  if (!SetActivator(0, AAPTR_TARGET)) { SetResultValue(-1); terminate; }
  int pnum = PlayerNumber();
  if (pnum < 0 || pnum >= 64) { SetResultValue(-1); terminate; }
  for (int slot = 0; slot < 2; slot++) {
    if (centopt_tid[pnum][slot] == tid) { SetResultValue(slot); terminate; }
  }
  SetResultValue(-1);
}

script "rz_CentaurOptionValid" (int slot) {
  int tid = ActivatorTID();
  if (slot < 0 || slot > 1 ||
      !ACS_NamedExecuteWithResult("uh_IsLiveMorphedBossByPointer", AAPTR_TARGET) ||
      !SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0); terminate;
  }
  int pnum = PlayerNumber();
  SetResultValue(pnum >= 0 && pnum < 64 && centopt_tid[pnum][slot] == tid &&
      CheckInventory("DLCCentaurOptionMode") > 0 &&
      CheckInventory("DLCCentaurOptionStack") > slot);
}

// Shared R-mode phase so both options rotate in lockstep (left is +128).
script "rz_CentaurTic" (void) {
  SetResultValue(Timer() % 256);
}

// Unlike DECORATE A_SetAngle, SetActorAngle broadcasts the server's result.
// Clients do not have the server-owned slot/orbit variables to compute it.
script "rz_CentaurOptionAngle" (int angle) {
  SetActorAngle(0, angle);
}

// DECORATE-facing count for the calling player only.
script "rz_CentaurOptionCount" (void) {
  SetResultValue(UH_CentaurOptionCount(PlayerNumber()));
}

// DLCCentaurOption S-mode: byte angle the right(0)/left(1) option's orbit slot
// should slide toward. With a visible enemy between the orbit radius and
// `radius` (whole map units) from the master, that is the tangent point whose
// muzzle (slot angle +/- 90 degrees) fires along the tangent through the enemy.
// Enemies inside the orbit are in the blind spot. Without a target, use the
// player-relative rest slot (right = master angle -90, left = +90).
script "rz_CentaurOptionSeek" (int side, int radius) {
  // Spawner sets TARGET=player (non-monster A_SpawnItemEx). SXF_SETMASTER
  // only applies to MF3_ISMONSTER, so MASTER stays null — orbit on TARGET.
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  int mastertid = ActivatorTID();
  if (mastertid <= 0) {
    SetResultValue(0);
    terminate;
  }

  int ox = GetActorX(0);
  int oy = GetActorY(0);
  int rmax = radius << 16;
  int rblind = CENTOPT_ORBIT_R << 16;
  int userteam = GetPlayerInfo(mastertid - 1000, PLAYERINFO_TEAM);
  int userpls = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", mastertid - 1000);

  int besttid = 0;
  int bestfixed = rmax + 1;

  for (int p = 0; p < ServerMAX; p++) {
    if (!PlayerInGame(p) || PlayerIsSpectator(p)) {
      continue;
    }
    int tid = p + 1000;
    if (tid == mastertid || CheckActorInventory(tid, "IsDead") ||
        GetActorProperty(tid, APROP_Health) <= 0) {
      continue;
    }
    if (IsTeamGame && GetPlayerInfo(p, PLAYERINFO_TEAM) == userteam) {
      continue;
    }
    if (!IsTeamGame) {
      int pls = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", p);
      if (userpls != 6 && pls == userpls) {  // PLS_EYE
        continue;
      }
    }
    int dx = GetActorX(tid) - ox;
    int dy = GetActorY(tid) - oy;
    // The coarse bounds avoid needless work. VectorLength supplies the actual
    // circular test in fixed units; do not compare a whole-unit sqrt to rmax.
    if (dx > rmax || dx < -rmax || dy > rmax || dy < -rmax) {
      continue;
    }
    int dfixed = VectorLength(dx, dy);
    int scanxu = dx >> 16;
    int scanyu = dy >> 16;
    int scand2 = scanxu * scanxu + scanyu * scanyu;
    // The fixed check defines the r1 blind spot. The whole-unit check also
    // guarantees that the tangent calculation below has a positive radicand
    // after converting coordinates to whole units.
    if (dfixed <= rblind || dfixed > rmax ||
        scand2 <= CENTOPT_ORBIT_R * CENTOPT_ORBIT_R ||
        dfixed >= bestfixed || !CheckSight(0, tid, 0)) {
      continue;
    }
    besttid = tid;
    bestfixed = dfixed;
  }

  int theta;
  if (besttid > 0) {
    int edx = GetActorX(besttid) - ox;
    int edy = GetActorY(besttid) - oy;
    // Tangent geometry in whole map units; d^2 caps out at ~803k for the
    // scan radius, so plain ints are overflow-safe here (fixed d^2 is not).
    int dxu = edx >> 16;
    int dyu = edy >> 16;
    int du2 = dxu * dxu + dyu * dyu;
    // Tangent point P = (R^2*dx +/- R*t*dy, R^2*dy -/+ R*t*dx) / d^2 with
    // t = sqrt(d^2 - R^2); single FixedDiv keeps the result in fixed.
    int sgn = 1 - 2 * side;
    int rt = CENTOPT_ORBIT_R * Sqrt8(du2 - CENTOPT_ORBIT_R * CENTOPT_ORBIT_R);
    int px = FixedDiv(CENTOPT_ORBIT_R * CENTOPT_ORBIT_R * dxu + sgn * rt * dyu, du2);
    int py = FixedDiv(CENTOPT_ORBIT_R * CENTOPT_ORBIT_R * dyu - sgn * rt * dxu, du2);
    theta = VectorAngle(px, py) >> 8;
  } else {
    int a = GetActorAngle(0) >> 8;
    theta = (a + CENTOPT_REST_OFF + side * 128) % 256;
  }
  SetResultValue(theta);
}

// Removes the calling option satellite.  DECORATE A_Die on a MISSILE-flagged
// actor crashes this engine build (observed 3.3-alpha at every master death),
// so Cleanup routes through here instead.
script "rz_CentaurOptionKill" (void) {
  Thing_Remove(0);
}

// True while live options are fewer than the master's owned count level.
script "rz_CentaurOptionSyncNeeded" (void) {
  int pnum = PlayerNumber();
  int stack = CheckInventory("DLCCentaurOptionStack");
  // A surplus left slot awaiting cleanup must not block a missing right slot
  // after reducing the stack to one.
  SetResultValue(pnum >= 0 && pnum < 64 && CheckInventory("DLCCentaurOptionMode") > 0 &&
      ((stack >= 1 && !UH_CentaurOptionExists(pnum, 0)) ||
       (stack >= 2 && !UH_CentaurOptionExists(pnum, 1))));
}

// Server console debug / quick-tune helper (also works offline):
//   pukename rz_CentaurOptDebug <player 0-based> <mode 0-5> <stack 0-2>
// mode 0 clears the option state (satellites clean themselves up); otherwise
// sets the mode + count level and pulses DLCCentaurOptionSync_P to respawn.
script "rz_CentaurOptDebug" (int pnum, int mode, int stack) {
  if (pnum < 0 || pnum >= ServerMAX) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"[CentOpt] bad player ", i:pnum));
    terminate;
  }
  int tid = 1000 + pnum;
  TakeActorInventory(tid, "DLCCentaurOptionMode", 5);
  TakeActorInventory(tid, "DLCCentaurOptionStack", 2);
  if (mode > 0) {
    GiveActorInventory(tid, "DLCCentaurOptionMode", mode);
    GiveActorInventory(tid, "DLCCentaurOptionStack", stack > 0 ? stack : 1);
    GiveActorInventory(tid, "DLCCentaurOptionSync_P", 1);
  }
  UH_Log(UH_LOG_DEBUG, StrParam(s:"[CentOpt] p", i:pnum, s:" mode=", i:CheckActorInventory(tid, "DLCCentaurOptionMode"),
      s:" stack=", i:CheckActorInventory(tid, "DLCCentaurOptionStack"),
      s:" live=", i:UH_CentaurOptionCount(pnum)));
}

// Unlimited-altitude permanent flight with pit stamina for the Destron family.
script "uh_DestronHoverRelease" (void) {
  UH_BossHoverRelease("Destron_HoverActive_F");
}

script "uh_PurpleDestronHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "PurpleDestron", "Destron_HoverActive_F", "Destron_HoverStamina_F");
}

script "uh_BlueDestronHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "BlueDestron", "Destron_HoverActive_F", "Destron_HoverStamina_F");
}

script "uh_RedDestronHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "RedDestron", "Destron_HoverActive_F", "Destron_HoverStamina_F");
}

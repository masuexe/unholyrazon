// Unlimited-altitude permanent flight with pit stamina for Clownpiece W8
// (Apollo Hoax Theory final survival spell).
script "uh_ClownpieceHoverRelease" (void) {
  UH_BossHoverRelease("Clownpiece_HoverActive_F");
}

script "uh_ClownpieceHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "Clownpiece", "Clownpiece_HoverActive_F", "Clownpiece_HoverStamina_F");
}

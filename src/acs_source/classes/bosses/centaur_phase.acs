// Alpha powers do not carry PowerInvisibility's CANTSEEK flag.
// Retain it through the shared stack, with morph cleanup owning stale layers.
script "rz_CentaurPhaseCantSeek" (void) {
  int player = PlayerNumber();
  if (player < 0 || player >= 64)
    terminate;
  int mygen = GetPlayerMorphGen(player);
  ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, 1);
  while (CheckInventory("DLCCentaurmanInvunPickup")) {
    Delay(1);
    if (!PlayerInGame(player) || GetPlayerMorphGen(player) != mygen)
      terminate;
  }
  ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, 0);
}

// Shiny MegaMan flat pool roll. which: 0 = M1 (Fire), 1 = M2 (AltFire).
// Always picks from the ACS table (vanilla leaves are registered too).
script "uh_ShinyMegaRollCustom" (int which) {
  int pn = PlayerNumber();
  int n;
  int total;
  int roll;
  int acc;
  int i;
  int pick;
  int poolwhich;

  if (pn < 0) {
    SetResultValue(0);
    terminate;
  }

  if (which == 0) {
    n = uh_shinymegamaincount;
    poolwhich = UH_SHINYMEGA_M1;
  }
  else {
    n = uh_shinymegaaltcount;
    poolwhich = UH_SHINYMEGA_M2;
  }
  if (n <= 0) {
    SetResultValue(0);
    terminate;
  }

  total = 0;
  for (i = 0; i < n; i++)
    total += which == 0 ? uh_shinymegamainweight[i] : uh_shinymegaaltweight[i];
  if (total <= 0) {
    SetResultValue(0);
    terminate;
  }

  roll = random(0, total - 1);
  acc = 0;
  pick = -1;
  for (i = 0; i < n; i++) {
    acc += which == 0 ? uh_shinymegamainweight[i] : uh_shinymegaaltweight[i];
    if (roll < acc) {
      pick = i;
      break;
    }
  }
  if (pick < 0) {
    SetResultValue(0);
    terminate;
  }

  uh_shinymegawhich[pn] = poolwhich;
  if (which == 0)
    GiveInventory(uh_shinymegamainactor[pick], 1);
  else
    GiveInventory(uh_shinymegaaltactor[pick], 1);
  SetResultValue(1);
}

// Shiny MegaMan full-table roll for DecoyBot's MegaMan copy. Every unique API
// definition contributes exactly one row and its declared weight.
script "uh_ShinyMegaRollTrue" (void) {
  int pn = PlayerNumber();
  int total;
  int roll;
  int acc;
  int i;
  int pick;
  str fireactor;
  int poolwhich;

  if (pn < 0) {
    SetResultValue(0);
    terminate;
  }

  total = 0;
  for (i = 0; i < uh_shinymegaallcount; i++)
    total += uh_shinymegaallweight[i];
  if (total <= 0) {
    SetResultValue(0);
    terminate;
  }

  roll = random(0, total - 1);
  acc = 0;
  pick = -1;
  for (i = 0; i < uh_shinymegaallcount; i++) {
    acc += uh_shinymegaallweight[i];
    if (roll < acc) {
      pick = i;
      break;
    }
  }
  if (pick < 0) {
    SetResultValue(0);
    terminate;
  }

  fireactor = uh_shinymegaallactor[pick];
  poolwhich = uh_shinymegaallkind[pick];
  if (poolwhich == UH_SHINYMEGA_TRUE)
    poolwhich = random(0, 1) ? UH_SHINYMEGA_M2 : UH_SHINYMEGA_M1;
  uh_shinymegawhich[pn] = poolwhich;
  GiveInventory(fireactor, 1);
  SetResultValue(1);
}

// For ShinyMega_*_P Pickup: which pool launched this fire (M1 or M2).
script "uh_ShinyMegaGetWhich" (void) {
  int pn = PlayerNumber();
  SetResultValue(pn >= 0 ? uh_shinymegawhich[pn] : 0);
}

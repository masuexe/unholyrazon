function int UH_DateToInt(void) {
  int time = SystemTime();
  return GetTimeProperty(time, TM_YEAR) * 10000
    + (GetTimeProperty(time, TM_MONTH) + 1) * 100
    + GetTimeProperty(time, TM_DAY);
}

// UTC variant of UH_DateToInt, used by the Nega daily ammo cost only.
// GetTimeProperty defaults to localtime, so a client and a server in different
// time zones (or across a DST / midnight boundary) can disagree about "today"
// for hours.  The authoritative spend is server-side, but the client-predicted
// Ready branch must roll the day at the same instant, so Nega uses UTC.
// MegaMan's daily damage keeps UH_DateToInt (local) unchanged.
function int UH_DateToIntUTC(void) {
  int time = SystemTime();
  return GetTimeProperty(time, TM_YEAR, true) * 10000
    + (GetTimeProperty(time, TM_MONTH, true) + 1) * 100
    + GetTimeProperty(time, TM_DAY, true);
}

// --- Host-tunable daily randomization constants ---------------------------
// The yyyymmdd date stays the seed; these server CVars shift the derived
// seeds. Defaults are the shipped values, so an untouched server behaves
// exactly as before. Salts accept any integer; strides must be nonzero (0
// falls back) and are forced odd so per-weapon streams cannot lock to the
// date's parity. The daily LCG multiplier/increment are forced odd for the
// same reason; the legacy sign generator keeps its historical even constants
// until overridden.
function int UH_TuneSalt(str cvar) {
  return GetCVar(cvar) & 0x7FFFFFFF;
}

function int UH_TuneStride(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v == 0)
    v = fallback;
  return v | 1;
}

function int UH_TuneLcgMul(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v < 3)
    v = fallback;
  return v | 1;
}

function int UH_TuneLcgAdd(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v == 0)
    v = fallback;
  return v | 1;
}

// Legacy-preserving constants: the historical sign/cost generators use even
// multipliers, so these keep the value as configured instead of forcing odd.
function int UH_TuneLegacyMul(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v == 0)
    v = fallback;
  return v;
}

function int UH_TuneLegacyAdd(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v == 0)
    v = fallback;
  return v;
}

function int UH_TuneHashBase(str cvar, int fallback) {
  int v = GetCVar(cvar) & 0x7FFFFFFF;
  if (v < 2)
    v = fallback;
  return v;
}

// Shared seed-mix core used by the Mega sign roll and the Nega daily ammo cost.
function int UH_SeedRandomCore(int seed, int minval, int maxval, int a, int b) {
  int n = (a * seed + b) & 0x7FFFFFFF;
  if (maxval < minval) {
    int temp = maxval;
    maxval = minval;
    minval = temp;
  }
  return n % (maxval - minval + 1) + minval;
}

function int UH_MegaSignRandom(int seed, int minval, int maxval) {
  int a = UH_TuneLegacyMul("rz_sv_mega_sign_rng_a", 1919810);
  int b = UH_TuneLegacyAdd("rz_sv_mega_sign_rng_b", 114514);
  return UH_SeedRandomCore(seed, minval, maxval, a, b);
}

function int UH_HashStrCore(str s, int base) {
  int h = 0;
  int len = StrLen(s);
  for (int i = 0; i < len; i++)
    h = (h * base + GetChar(s, i)) & 0x7FFFFFFF;
  return h;
}

function int UH_MegaHashStr(str s) {
  return UH_HashStrCore(s, UH_TuneHashBase("rz_sv_mega_hash_base", 31));
}

function int UH_CopywepIdFromAlias(str cls) {
  for (int i = 0; i < UH_COPYWEP_ALIAS_MAX; i++) {
    if (StrCmp(cls, uh_copywepaliasclass[i]) == 0)
      return FindMegaCopyIdByStemPrefix(uh_copywepaliasname[i]);
  }
  return 0;
}

function int UH_CopywepIdFromActivator(void) {
  str cls = GetActorClass(0);
  int id = FindMegaCopyIdByStemPrefix(cls);
  if (id > 0)
    return id;

  id = UH_CopywepIdFromAlias(cls);
  if (id > 0)
    return id;

  str dtype = GetActorProperty(0, APROP_DamageType);
  if (StrLen(dtype) > 0) {
    id = FindMegaCopyIdByStemPrefix(dtype);
    if (id > 0)
      return id;
  }
  return 0;
}

// Official vanilla pool is frozen at 103; addons retain normal multipliers only.
#define UH_MEGA_DAILY_MAX 103
int uh_megadailyrank[UH_MEGA_DAILY_MAX + 1];
int uh_megadailyshuffle[UH_MEGA_DAILY_MAX];
int uh_megadailydate;
int uh_megadailyofficial;
int uh_megadailyranksalt;
int uh_megadailyrankstride;
int uh_megadailyrnga;
int uh_megadailyrngb;

// Shared daily generator for jackpot ranks, counts, multipliers and FF leaks.
function int UH_MegaDailyRandom(int seed, int lo, int hi) {
  int a = UH_TuneLcgMul("rz_sv_mega_rng_a", 1103515245);
  int b = UH_TuneLcgAdd("rz_sv_mega_rng_b", 12345);
  int n = (seed * a + b) & 0x7FFFFFFF;
  int temp;
  n = n ^ (n >> 16);
  n = (n * a + b) & 0x7FFFFFFF;
  n = n ^ (n >> 16);
  if (hi < lo) {
    temp = hi;
    hi = lo;
    lo = temp;
  }
  return n % (hi - lo + 1) + lo;
}

function int UH_MegaDailyOfficialCount(void) {
  int count = GetMegaOfficialCopyCount();
  if (count < 1)
    count = UH_MEGA_DAILY_MAX;
  return min(count, UH_MEGA_DAILY_MAX);
}

// A date-keyed permutation gives exact, disjoint tier counts without retries.
// Cache only the permutation: host settings are read afresh for every damage call.
function void UH_EnsureMegaDailyRanks(void) {
  int date = UH_DateToInt();
  int official = UH_MegaDailyOfficialCount();
  int salt = UH_TuneSalt("rz_sv_mega_rank_salt");
  int stride = UH_TuneStride("rz_sv_mega_rank_stride", 97);
  int rnga = UH_TuneLcgMul("rz_sv_mega_rng_a", 1103515245);
  int rngb = UH_TuneLcgAdd("rz_sv_mega_rng_b", 12345);
  int i;
  int j;
  int temp;
  if (uh_megadailydate == date && uh_megadailyofficial == official
      && uh_megadailyranksalt == salt && uh_megadailyrankstride == stride
      && uh_megadailyrnga == rnga && uh_megadailyrngb == rngb)
    return;
  uh_megadailydate = date;
  uh_megadailyofficial = official;
  uh_megadailyranksalt = salt;
  uh_megadailyrankstride = stride;
  uh_megadailyrnga = rnga;
  uh_megadailyrngb = rngb;
  for (i = 0; i < official; i++)
    uh_megadailyshuffle[i] = i + 1;
  for (i = 0; i < official; i++) {
    j = UH_MegaDailyRandom((date + salt + i * stride) & 0x7FFFFFFF, i, official - 1);
    temp = uh_megadailyshuffle[i];
    uh_megadailyshuffle[i] = uh_megadailyshuffle[j];
    uh_megadailyshuffle[j] = temp;
    uh_megadailyrank[uh_megadailyshuffle[i]] = i;
  }
}

function int UH_MegaDailyCount(str lowcvar, str highcvar, int salt) {
  int official = UH_MegaDailyOfficialCount();
  int lo = max(0, min(GetCVar(lowcvar), official));
  int hi = max(0, min(GetCVar(highcvar), official));
  return UH_MegaDailyRandom((UH_DateToInt() + salt) & 0x7FFFFFFF, lo, hi);
}

function int UH_MegaDailyMultiplier(str lowcvar, str highcvar, int seed) {
  // Float CVars are returned as 16.16 fixed by Zandronum GetCVar.
  // Bound to the nonnegative 16.16 range; negative input cannot cause healing.
  int lo = max(0, min(GetCVar(lowcvar), 32767.0));
  int hi = max(0, min(GetCVar(highcvar), 32767.0));
  return UH_MegaDailyRandom(seed, lo, hi);
}

function int UH_CopywepDmgMul(int wep) {
  int date = UH_DateToInt();
  int seedkey = wep;
  int big = 0;
  int small = 0;
  int rank;
  int stride = UH_TuneStride("rz_sv_mega_mul_stride", 893);
  int official = UH_MegaDailyOfficialCount();
  if (wep < 1 || wep > official)
    seedkey = UH_MegaHashStr(GetActorClass(0));
  else {
    UH_EnsureMegaDailyRanks();
    if (GetCVar("rz_sv_mega_big_enabled"))
      big = UH_MegaDailyCount("rz_sv_mega_big_count_min", "rz_sv_mega_big_count_max", UH_TuneSalt("rz_sv_mega_big_count_salt"));
    if (GetCVar("rz_sv_mega_small_enabled"))
      small = min(UH_MegaDailyCount("rz_sv_mega_small_count_min", "rz_sv_mega_small_count_max", UH_TuneSalt("rz_sv_mega_small_count_salt")), official - big);
    rank = uh_megadailyrank[wep];
    if (rank < big)
      return UH_MegaDailyMultiplier("rz_sv_mega_big_mul_min", "rz_sv_mega_big_mul_max", (date + wep * stride) & 0x7FFFFFFF);
    if (rank < big + small)
      return UH_MegaDailyMultiplier("rz_sv_mega_small_mul_min", "rz_sv_mega_small_mul_max", (date + wep * stride) & 0x7FFFFFFF);
  }
  return UH_MegaDailyMultiplier("rz_sv_mega_normal_mul_min", "rz_sv_mega_normal_mul_max", (date + seedkey * stride) & 0x7FFFFFFF);
}

script "uh_TodayDmgMul" (int damage, int allowneg) {
  if (!GetCVar("rz_sv_randmegamancopywepdmg")) {
    SetResultValue(damage);
    terminate;
  }
  int wep = UH_CopywepIdFromActivator();
  int mul = UH_CopywepDmgMul(wep);
  if (allowneg) {
    int date = UH_DateToInt();
    int seedkey = wep;
    int negseed;
    if (seedkey < 1)
      seedkey = UH_MegaHashStr(GetActorClass(0));
    negseed = (date + UH_TuneSalt("rz_sv_mega_neg_salt")
      + seedkey * UH_TuneStride("rz_sv_mega_neg_stride", 17)) & 0x7FFFFFFF;
    if (UH_MegaSignRandom(negseed, 0.0, 1.0) < 0.5)
      mul = -mul;
  }
  SetResultValue(FixedMul(mul, damage));
}

// The engine sends this after armor absorption and before entering Pain.
// The original Time Stopper hit has no counter yet, so it cannot break itself.
script "uh_TimeStopBreakOnDamage" (int evt, int dmg, int dmgtype) EVENT {
  if (evt != GAMEEVENT_ACTOR_DAMAGED || dmg <= 0)
    terminate;
  if (!SetActivator(0, AAPTR_DAMAGE_TARGET) || PlayerNumber() < 0)
    terminate;
  if (!CheckInventory("TimeStoppedCounter"))
    terminate;
  GiveInventory("UH_TimeStopHitBreak_F", 1);
  TakeInventory("TimeStoppedCounter", 1);
}

script "uh_debug_ShowTodayDmgMul" (void) {
  int date = UH_DateToInt();
  int official = GetMegaOfficialCopyCount();
  UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_debug_ShowTodayDmgMul date=", i:date,
    s:" official=", i:official,
    s:" rz_sv_randmegamancopywepdmg=", i:GetCVar("rz_sv_randmegamancopywepdmg")));
  UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_debug_ShowTodayDmgMul tune rank=",
    i:UH_TuneSalt("rz_sv_mega_rank_salt"), s:"/", i:UH_TuneStride("rz_sv_mega_rank_stride", 97),
    s:" mul=", i:UH_TuneStride("rz_sv_mega_mul_stride", 893),
    s:" rng=", i:UH_TuneLcgMul("rz_sv_mega_rng_a", 1103515245), s:"/", i:UH_TuneLcgAdd("rz_sv_mega_rng_b", 12345),
    s:" count=", i:UH_TuneSalt("rz_sv_mega_big_count_salt"), s:"/", i:UH_TuneSalt("rz_sv_mega_small_count_salt"),
    s:" hash=", i:UH_TuneHashBase("rz_sv_mega_hash_base", 31),
    s:" sign=", i:UH_TuneSalt("rz_sv_mega_neg_salt"), s:"/", i:UH_TuneStride("rz_sv_mega_neg_stride", 17),
    s:" signrng=", i:UH_TuneLegacyMul("rz_sv_mega_sign_rng_a", 1919810), s:"/", i:UH_TuneLegacyAdd("rz_sv_mega_sign_rng_b", 114514)));
  for (int i = 1; i <= official; i++) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:GetCopyWepDmgStemByMegaId(i), s:" [", i:i, s:"] mul=", f:UH_CopywepDmgMul(i)));
  }
}


// --- BlazeKick critical hits (1/24 on damaged event) -----------------------
// Formerly in time_stop.acs; keyed on the copywep DamageType.
script "uh_CriticalHitRng" (int evt, int dmg, int dmgtype) EVENT {
  if (evt == GAMEEVENT_ACTOR_DAMAGED) {
    if (!StrICmp(dmgtype, "BlazeKick") && Random(1, 24) <= 1) {
      GiveInventory("CriticalPain_P", 1);
      SetResultValue(dmg * 2);
    }
  }
}

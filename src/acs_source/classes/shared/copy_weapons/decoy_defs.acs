  DefineDecoyBotMoveWep("DecoyCopy_43_W");

  DefineDecoyBotMoveWep("DecoyCopy_44_W");
  SetDecoyBotReadyRule("DecoyCopy_44_W", 15, 7, "");

  DefineDecoyBotMoveWep("DecoyCopy_45_W");

  DefineDecoyBotMoveWep("DecoyCopy_46_W");
  SetDecoyBotReadyRule("DecoyCopy_46_W", 100, 50, "");

  DefineDecoyBotMoveWep("DecoyCopy_47_W");

  DefineDecoyBotMoveWep("DecoyCopy_48_W");
  SetDecoyBotReadyRule("DecoyCopy_48_W", 10, 10, "");

  DefineDecoyBotMoveWep("DecoyCopy_49_W");
  SetDecoyBotReadyRule("DecoyCopy_49_W", 200, 100, "");

  DefineDecoyBotMoveWep("DecoyCopy_50_W");
  SetDecoyBotReadyRule("DecoyCopy_50_W", 25, 25, "");
  SetDecoyBotShinyReadyRule("DecoyCopy_50_W", 200, 200, "");

  DefineDecoyBotMoveWep("DecoyCopy_51_W");
  SetDecoyBotReadyRule("DecoyCopy_51_W", 200, 100, "");
  SetDecoyBotShinyReadyRule("DecoyCopy_51_W", 200, 200, "");

  DefineDecoyBotMoveWep("DecoyCopy_52_W");

  DefineDecoyBotMoveWep("DecoyCopy_53_W");

  DefineDecoyBotMoveWep("DecoyCopy_54_W");

  DefineDecoyBotMoveWep("DecoyCopy_55_W");
  SetDecoyBotReadyRule("DecoyCopy_55_W", 66, 33, "");

  DefineDecoyBotMoveWep("DecoyCopy_56_W");
  SetDecoyBotReadyRule("DecoyCopy_56_W", 150, 75, "");

  DefineDecoyBotMoveWep("DecoyCopy_57_W");

  DefineDecoyBotMoveWep("DecoyCopy_58_W");
  SetDecoyBotReadyRule("DecoyCopy_58_W", 100, 50, "");
  SetDecoyBotShinyReadyRule("DecoyCopy_58_W", 100, 100, "");

  DefineDecoyBotMoveWep("DecoyCopy_59_W");
  SetDecoyBotReadyRule("DecoyCopy_59_W", 6, 6, "");

  DefineDecoyBotMoveWep("DecoyCopy_60_W");
  SetDecoyBotReadyRule("DecoyCopy_60_W", 0, 0, "");

  DefineDecoyBotMoveWep("DecoyCopy_36_W");
  SetDecoyBotReadyRule("DecoyCopy_36_W", 20, 10, "");

  DefineDecoyBotMoveWep("DecoyCopy_37_W");
  SetDecoyBotReadyRule("DecoyCopy_37_W", 50, 25, "");

  DefineDecoyBotMoveWep("DecoyCopy_38_W");
  SetDecoyBotReadyRule("DecoyCopy_38_W", 100, 50, "");

  DefineDecoyBotMoveWep("DecoyCopy_39_W");

  DefineDecoyBotMoveWep("DecoyCopy_40_W");

function void RegisterVanillaDecoyMoves(void) {
  // Registration order fixes DecoyBot slot IDs: keep 00..60 in this order.
  // Without a rule, both forms require 1 energy. A normal rule also becomes
  // the Shiny rule unless a Shiny-specific override follows it.

  DefineDecoyBotMoveWep("DecoyCopy_00_W");
  SetDecoyBotShinyReadyRule("DecoyCopy_00_W", 20, 10, "");

  DefineDecoyBotMoveWep("DecoyCopy_01_W");
  SetDecoyBotReadyRule("DecoyCopy_01_W", 10, 10, "");

  DefineDecoyBotMoveWep("DecoyCopy_02_W");
  SetDecoyBotReadyRule("DecoyCopy_02_W", 100, 50, "");

  DefineDecoyBotMoveWep("DecoyCopy_03_W");

  DefineDecoyBotMoveWep("DecoyCopy_04_W");

  DefineDecoyBotMoveWep("DecoyCopy_05_W");

  DefineDecoyBotMoveWep("DecoyCopy_06_W");
  SetDecoyBotReadyRule("DecoyCopy_06_W", 50, 25, "");

  DefineDecoyBotMoveWep("DecoyCopy_07_W");

  DefineDecoyBotMoveWep("DecoyCopy_08_W");
  SetDecoyBotReadyRule("DecoyCopy_08_W", 80, 80, "");

  DefineDecoyBotMoveWep("DecoyCopy_09_W");
  SetDecoyBotReadyRule("DecoyCopy_09_W", 12, 6, "");

  DefineDecoyBotMoveWep("DecoyCopy_10_W");
  SetDecoyBotReadyRule("DecoyCopy_10_W", 12, 6, "");

  DefineDecoyBotMoveWep("DecoyCopy_11_W");

  DefineDecoyBotMoveWep("DecoyCopy_12_W");
  SetDecoyBotReadyRule("DecoyCopy_12_W", 60, 30, "");

  DefineDecoyBotMoveWep("DecoyCopy_13_W");

  DefineDecoyBotMoveWep("DecoyCopy_14_W");
  SetDecoyBotReadyRule("DecoyCopy_14_W", 50, 25, "");

  DefineDecoyBotMoveWep("DecoyCopy_15_W");

  DefineDecoyBotMoveWep("DecoyCopy_16_W");
  SetDecoyBotReadyRule("DecoyCopy_16_W", 200, 100, "");

  DefineDecoyBotMoveWep("DecoyCopy_17_W");
  SetDecoyBotReadyRule("DecoyCopy_17_W", 100, 35, "");

  DefineDecoyBotMoveWep("DecoyCopy_18_W");
  SetDecoyBotReadyRule("DecoyCopy_18_W", 50, 25, "");

  DefineDecoyBotMoveWep("DecoyCopy_19_W");
  SetDecoyBotReadyRule("DecoyCopy_19_W", 5, 2, "");

  DefineDecoyBotMoveWep("DecoyCopy_20_W");

  DefineDecoyBotMoveWep("DecoyCopy_21_W");
  SetDecoyBotReadyRule("DecoyCopy_21_W", 100, 50, "");

  DefineDecoyBotMoveWep("DecoyCopy_22_W");

  DefineDecoyBotMoveWep("DecoyCopy_23_W");
  SetDecoyBotReadyRule("DecoyCopy_23_W", 200, 100, "");
  SetDecoyBotShinyReadyRule("DecoyCopy_23_W", 200, 200, "");

  DefineDecoyBotMoveWep("DecoyCopy_24_W");
  SetDecoyBotReadyRule("DecoyCopy_24_W", 85, 50, "");

  DefineDecoyBotMoveWep("DecoyCopy_25_W");

  DefineDecoyBotMoveWep("DecoyCopy_26_W");
  SetDecoyBotReadyRule("DecoyCopy_26_W", 200, 100, "");

  DefineDecoyBotMoveWep("DecoyCopy_27_W");

  DefineDecoyBotMoveWep("DecoyCopy_28_W");
  SetDecoyBotReadyRule("DecoyCopy_28_W", 125, 55, "");

  DefineDecoyBotMoveWep("DecoyCopy_29_W");
  SetDecoyBotReadyRule("DecoyCopy_29_W", 23, 7, "");

  DefineDecoyBotMoveWep("DecoyCopy_30_W");
  SetDecoyBotReadyRule("DecoyCopy_30_W", 100, 50, "TrapistPrimedFlag");

  DefineDecoyBotMoveWep("DecoyCopy_31_W");
  SetDecoyBotReadyRule("DecoyCopy_31_W", 9, 9, "");

  DefineDecoyBotMoveWep("DecoyCopy_32_W");

  DefineDecoyBotMoveWep("DecoyCopy_33_W");

  DefineDecoyBotMoveWep("DecoyCopy_34_W");

  DefineDecoyBotMoveWep("DecoyCopy_35_W");

// --- Daily MegaMan copywep team-FF (leak weapons only; damage = uh_TodayDmgMul result) ---
#define UH_TEAMFF_LEAK_MAX UH_MEGA_DAILY_MAX
#define UH_TEAMFF_SALT 424242

int uh_teamffleakids[UH_TEAMFF_LEAK_MAX];
int uh_teamffleakdate;
int uh_teamffleakofficial;
int uh_teamffleakcount;
int uh_teamffleakwant = -1;

function void UH_EnsureTodayTeamFFLeaks(void) {
  int date = UH_DateToInt();
  int official = UH_MegaDailyOfficialCount();
  int want = UH_MegaDailyCount("rz_sv_mega_ff_count_min", "rz_sv_mega_ff_count_max", UH_TEAMFF_SALT);
  int i;
  int j;
  int temp;
  if (uh_teamffleakdate == date && uh_teamffleakofficial == official && uh_teamffleakwant == want)
    return;
  uh_teamffleakdate = date;
  uh_teamffleakofficial = official;
  uh_teamffleakwant = want;
  for (i = 0; i < official; i++)
    uh_teamffleakids[i] = i + 1;
  for (i = 0; i < want; i++) {
    j = UH_MegaDailyRandom(date + UH_TEAMFF_SALT + (i + 1) * 97, i, official - 1);
    temp = uh_teamffleakids[i];
    uh_teamffleakids[i] = uh_teamffleakids[j];
    uh_teamffleakids[j] = temp;
  }
  uh_teamffleakcount = want;
}

function int UH_IsTodayTeamFFLeak(int wepid) {
  int i;
  if (wepid < 1)
    return 0;
  UH_EnsureTodayTeamFFLeaks();
  for (i = 0; i < uh_teamffleakcount; i++) {
    if (uh_teamffleakids[i] == wepid)
      return 1;
  }
  return 0;
}

function str UH_StripMegaMPrefix(str dtype) {
  if (StrLen(dtype) > 2 && GetChar(dtype, 0) == 77 && GetChar(dtype, 1) == 95)
    return StrMid(dtype, 2, StrLen(dtype) - 2);
  return dtype;
}

// Core helper damage types whose names do not start with their weapon stem.
// Keep the damage types themselves intact for pain/death and weakness rules.
function str UH_CopywepTeamFFStem(str dtype) {
  str stem = UH_StripMegaMPrefix(dtype);
  if (!StrICmp(stem, "GyroChopper")) return "GyroAttack";
  if (!StrICmp(stem, "FireSpin")) return "FireStorm";
  if (!StrICmp(stem, "ChillShot")) return "ChillSpike";
  if (!StrICmp(stem, "OilFlame")) return "OilSlider";
  if (!StrICmp(stem, "PharaohHold")) return "PharaohShot";
  if (!StrICmp(stem, "TenguSlash")) return "TenguBlade";
  // NapalmBomb's MeteorItem nuclear blast deliberately bypasses daily FF.
  return stem;
}

script "uh_ApplyCopywepTeamFF" (void) {
  TakeInventory("PowerProtectMegaCopywep", 1);
  if (!CheckInventory("PowerProtectSurvivor"))
    terminate;
  if (!GetCVar("rz_sv_randmegamancopywepteamkill"))
    GiveInventory("PowerProtectMegaCopywep", 1);
}

script "uh_ClearCopywepTeamFF" (void) {
  TakeInventory("PowerProtectMegaCopywep", 1);
}

// PREMOD: after PowerProtection / teamdamage, before armor.
// When cvar is on (no blob), zero teammate copywep damage unless today's leak set.
script "uh_CopywepTeamFF" (int evt, int dmg, int dmgtype) EVENT {
  int victpn;
  int srcpn;
  int wepid;
  str stem;

  if (evt != GAMEEVENT_ACTOR_DAMAGED_PREMOD)
    terminate;
  if (!GetCVar("rz_sv_randmegamancopywepteamkill"))
    terminate;

  if (!SetActivator(0, AAPTR_DAMAGE_TARGET))
    terminate;
  victpn = PlayerNumber();
  if (victpn < 0)
    terminate;
  if (!CheckInventory("PowerProtectSurvivor"))
    terminate;

  if (!SetActivator(0, AAPTR_DAMAGE_SOURCE))
    terminate;
  srcpn = PlayerNumber();
  if (srcpn < 0)
    terminate;
  if (GetPlayerInfo(victpn, PLAYERINFO_TEAM) != GetPlayerInfo(srcpn, PLAYERINFO_TEAM))
    terminate;

  stem = UH_CopywepTeamFFStem(dmgtype);
  wepid = FindMegaCopyIdByStemPrefix(stem);
  if (wepid < 1)
    terminate;
  if (UH_IsTodayTeamFFLeak(wepid))
    terminate;
  SetResultValue(0);
}

script "uh_debug_ShowTodayTeamFF" (void) {
  int i;
  int date = UH_DateToInt();
  int official = GetMegaOfficialCopyCount();

  UH_EnsureTodayTeamFFLeaks();
  UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_debug_ShowTodayTeamFF date=", i:date,
    s:" official=", i:official,
    s:" leakCount=", i:uh_teamffleakcount,
    s:" rz_sv_randmegamancopywepteamkill=", i:GetCVar("rz_sv_randmegamancopywepteamkill")));
  for (i = 0; i < uh_teamffleakcount; i++) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"  leak ", i:i + 1, s:": ",
      s:GetCopyWepDmgStemByMegaId(uh_teamffleakids[i]),
      s:" [", i:uh_teamffleakids[i], s:"]"));
  }
}

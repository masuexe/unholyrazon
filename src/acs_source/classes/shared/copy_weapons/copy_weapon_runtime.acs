// UHDT's shared copy-weapon registry holds at most 256 rows, including addons.
#define UH_MEGA_LOADOUT_MAX 256
#define UH_MEGA_LOADOUT_SLOTS 6
int uh_megaloadoutcount[UH_MEGA_LOADOUT_SLOTS];
int uh_megaloadoutquota[UH_MEGA_LOADOUT_SLOTS];
int uh_megaloadoutoffset[UH_MEGA_LOADOUT_SLOTS];
int uh_megaloadoutfresh[UH_MEGA_LOADOUT_SLOTS];
int uh_megaloadoutindices[UH_MEGA_LOADOUT_MAX];
str uh_megaloadoutflags[UH_MEGA_LOADOUT_SLOTS] = {
  "MegaSlotRanged_F", "MegaSlotRapid_F", "MegaSlotClose_F",
  "MegaSlotPower_F", "MegaSlotAoE_F", "MegaSlotShield_F"
};

// Scratch arrays are safe to share: the roll has no Delay or external scripts.
function void UH_MegaRollLoadout(void) {
  int total = 0;
  int slot;
  int i;
  int j;
  int pass;
  int n;
  int want;
  int lowest;
  int ties;
  int pick;
  int offset;
  int temp;
  str wep;

  // Partition each slot into unowned and previously held candidates. Prefer
  // fresh weapons, preserving the old six-weapon roll's no-immediate-repeat rule.
  for (slot = 0; slot < UH_MEGA_LOADOUT_SLOTS; slot++) {
    n = CountCopyWepByKindSlot(UHCOPY_MEGA, slot);
    uh_megaloadoutcount[slot] = n;
    uh_megaloadoutquota[slot] = 0;
    uh_megaloadoutoffset[slot] = total;
    for (pass = 0; pass < 2; pass++) {
      for (i = 0; i < n; i++) {
        wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, slot, i);
        if ((CheckInventory(wep) > 0) == pass) {
          uh_megaloadoutindices[total] = i;
          total++;
        }
      }
      if (pass == 0)
        uh_megaloadoutfresh[slot] = total - uh_megaloadoutoffset[slot];
    }
  }
  if (total <= 0)
    return;
  want = min(max(1, GetCVar("rz_sv_mega_m2_weapon_count")), total);

  // Water-fill the six slots. Random tie-breaking spreads remainders and gives
  // distinct slots below six. Exhausted slots stop participating in allocation.
  for (i = 0; i < want; i++) {
    lowest = UH_MEGA_LOADOUT_MAX + 1;
    ties = 0;
    pick = -1;
    for (slot = 0; slot < UH_MEGA_LOADOUT_SLOTS; slot++) {
      n = uh_megaloadoutquota[slot];
      if (n >= uh_megaloadoutcount[slot])
        continue;
      if (n < lowest) {
        lowest = n;
        ties = 1;
        pick = slot;
      }
      else if (n == lowest) {
        ties++;
        if (random(1, ties) == 1)
          pick = slot;
      }
    }
    uh_megaloadoutquota[pick]++;
  }

  // Clear every registered copy weapon, not just the legacy first-weapon flags.
  n = CountCopyWepByKind(UHCOPY_MEGA);
  for (i = 0; i < n; i++)
    TakeInventory(GetCopyWepActorByKindIndex(UHCOPY_MEGA, i), 1);
  for (slot = 0; slot < UH_MEGA_LOADOUT_SLOTS; slot++) {
    SetInventory(uh_megaloadoutflags[slot], 0);
    offset = uh_megaloadoutoffset[slot];
    for (i = 0; i < uh_megaloadoutquota[slot]; i++) {
      n = uh_megaloadoutfresh[slot];
      if (i >= n)
        n = uh_megaloadoutcount[slot];
      j = random(i, n - 1);
      temp = uh_megaloadoutindices[offset + i];
      uh_megaloadoutindices[offset + i] = uh_megaloadoutindices[offset + j];
      uh_megaloadoutindices[offset + j] = temp;
      wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, slot, uh_megaloadoutindices[offset + i]);
      GiveInventory(wep, 1);
      // Keep the original flags as first-weapon references for compatibility.
      if (i == 0)
        SetInventory(uh_megaloadoutflags[slot], uh_megaloadoutindices[offset + i] + 1);
    }
  }
}

// Curated v6c +INVBAR Assist items for MegaManU Reload draws.
// Bucket 0 (0..13): Mobility & Escape; Bucket 1 (14..19): Combat, Summon & Defense.
#define UH_MEGA_ASSIST_BUCKETS 2
#define UH_MEGA_ASSIST_MOBILITY_COUNT 14
#define UH_MEGA_ASSIST_TOTAL 20
str uh_megaassistactors[UH_MEGA_ASSIST_TOTAL] = {
  "MagnetBeamItem", "Item1", "Item2", "Item3", "CarryItem",
  "RushCoil", "RushJet", "RushMarine", "RushPogoItem", "WireAdaptor",
  "BalloonAdaptorItem", "SuperArrowItem", "BeatBoostItem", "ExitUnitItem",
  "EddieBomber", "BeatSupport", "ReggaeCall", "TrebleSentry",
  "TangoSummon", "SuperGuardItem"
};
int uh_megaassistamounts[UH_MEGA_ASSIST_TOTAL] = {
  2, 3, 2, 2, 1,
  1, 1, 1, 1, 2,
  1, 5, 1, 1,
  1, 1, 1, 1,
  1, 1
};

function void UH_MegaStripAssists(void) {
  int i;
  for (i = 0; i < UH_MEGA_ASSIST_TOTAL; i++)
    TakeInventory(uh_megaassistactors[i], 999);
}

script "uh_StripMegaAssists" (void) {
  UH_MegaStripAssists();
  TakeInventory("MegaReloadEnabled_F", 1);
}

// Reuses UH_MegaRollLoadout's synchronous scratch arrays (no Delay).
function void UH_MegaRollAssists(int requested) {
  int total = 0;
  int bucket;
  int start;
  int n;
  int i;
  int j;
  int pass;
  int want;
  int lowest;
  int ties;
  int pick;
  int offset;
  int temp;
  int idx;

  want = min(max(0, requested), UH_MEGA_ASSIST_TOTAL);

  // Partition each bucket into unowned and previously held candidates before
  // stripping so rerolls prefer fresh assist items.
  for (bucket = 0; bucket < UH_MEGA_ASSIST_BUCKETS; bucket++) {
    if (bucket == 0) {
      start = 0;
      n = UH_MEGA_ASSIST_MOBILITY_COUNT;
    }
    else {
      start = UH_MEGA_ASSIST_MOBILITY_COUNT;
      n = UH_MEGA_ASSIST_TOTAL - UH_MEGA_ASSIST_MOBILITY_COUNT;
    }
    uh_megaloadoutcount[bucket] = n;
    uh_megaloadoutquota[bucket] = 0;
    uh_megaloadoutoffset[bucket] = total;
    for (pass = 0; pass < 2; pass++) {
      for (i = 0; i < n; i++) {
        idx = start + i;
        if ((CheckInventory(uh_megaassistactors[idx]) > 0) == pass) {
          uh_megaloadoutindices[total] = idx;
          total++;
        }
      }
      if (pass == 0)
        uh_megaloadoutfresh[bucket] = total - uh_megaloadoutoffset[bucket];
    }
  }

  // Always strip previous assists so setting the count to 0 clears held items.
  UH_MegaStripAssists();
  if (want <= 0)
    return;

  // Water-fill across the two buckets with random tie-breaking.
  for (i = 0; i < want; i++) {
    lowest = UH_MEGA_ASSIST_TOTAL + 1;
    ties = 0;
    pick = -1;
    for (bucket = 0; bucket < UH_MEGA_ASSIST_BUCKETS; bucket++) {
      n = uh_megaloadoutquota[bucket];
      if (n >= uh_megaloadoutcount[bucket])
        continue;
      if (n < lowest) {
        lowest = n;
        ties = 1;
        pick = bucket;
      }
      else if (n == lowest) {
        ties++;
        if (random(1, ties) == 1)
          pick = bucket;
      }
    }
    if (pick >= 0)
      uh_megaloadoutquota[pick]++;
  }

  for (bucket = 0; bucket < UH_MEGA_ASSIST_BUCKETS; bucket++) {
    offset = uh_megaloadoutoffset[bucket];
    for (i = 0; i < uh_megaloadoutquota[bucket]; i++) {
      n = uh_megaloadoutfresh[bucket];
      if (i >= n)
        n = uh_megaloadoutcount[bucket];
      j = random(i, n - 1);
      temp = uh_megaloadoutindices[offset + i];
      uh_megaloadoutindices[offset + i] = uh_megaloadoutindices[offset + j];
      uh_megaloadoutindices[offset + j] = temp;
      idx = uh_megaloadoutindices[offset + i];
      GiveInventory(uh_megaassistactors[idx], uh_megaassistamounts[idx]);
    }
  }
}

script "uh_MegamanWeapons" (int check) {
  if (check == 2) {
    bool allow = GetCVar("rz_sv_mega_reload_item_count") > 0;
    if (allow && !CheckInventory("MegaReloadEnabled_F"))
      GiveInventory("MegaReloadEnabled_F", 1);
    else if (!allow && CheckInventory("MegaReloadEnabled_F"))
      TakeInventory("MegaReloadEnabled_F", 1);
    SetResultValue(allow);
    terminate;
  }
  if (check == 1) {
    UH_MegaRollAssists(GetCVar("rz_sv_mega_reload_item_count"));
    terminate;
  }
  UH_MegaRollLoadout();
}

// The inventory is authoritative; legacy MoveMem keeps only a compatibility
// view of the first four held moves and must not limit the actual loadout.
function void UH_QwantRefreshMoveMemory(void) {
  int slot = 0;
  int i;
  int count = CountCopyWepByKind(UHCOPY_QWANT);
  for (i = 0; i < 4; i++)
    SetUserArray(0, "user_pkmn_movemem", i, -1);
  for (i = 0; i < count && slot < 4; i++) {
    if (CheckInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, i))) {
      SetUserArray(0, "user_pkmn_movemem", slot, i);
      slot++;
    }
  }
}

function int UH_QwantChooseUnownedMove(void) {
  int count = CountCopyWepByKind(UHCOPY_QWANT);
  int choice = -1;
  int candidates = 0;
  for (int i = 0; i < count; i++) {
    if (CheckInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, i)))
      continue;
    candidates++;
    if (random(1, candidates) == 1)
      choice = i;
  }
  return choice;
}

function int UH_QwantRelearnMove(void) {
  int count = CountCopyWepByKind(UHCOPY_QWANT);
  int i;
  int newmove;
  str current = GetWeapon();
  str replacement;
  if (GetUserArray(0, "user_pkmn_movemem", 7) != 777 || CheckInventory("MoveRelearnAmmo") < 28)
    return 0;
  for (i = 0; i < count; i++) {
    if (StrICmp(current, GetCopyWepActorByKindIndex(UHCOPY_QWANT, i)) == 0)
      break;
  }
  if (i >= count || !CheckInventory(current))
    return 0;
  newmove = UH_QwantChooseUnownedMove();
  if (newmove < 0)
    return 0;
  replacement = GetCopyWepActorByKindIndex(UHCOPY_QWANT, newmove);
  GiveInventory(replacement, 1);
  if (!CheckInventory(replacement))
    return 0;
  if (!SetWeapon(replacement)) {
    TakeInventory(replacement, 1);
    return 0;
  }
  TakeInventory(current, 1);
  TakeInventory("MoveRelearnAmmo", 28);
  UH_QwantRefreshMoveMemory();
  return 1;
}

script "uh_QwantMoveRelearn" (void) {
  SetResultValue(UH_QwantRelearnMove());
}

script "uh_QwantDebugUserArray" (void) {
  UH_Log(UH_LOG_DEBUG, StrParam(s:"\cduh_QwantDebugUserArray"));
  UH_Log(UH_LOG_DEBUG, StrParam(i:GetUserArray(0, "user_pkmn_movemem", 0)));
  UH_Log(UH_LOG_DEBUG, StrParam(i:GetUserArray(0, "user_pkmn_movemem", 1)));
  UH_Log(UH_LOG_DEBUG, StrParam(i:GetUserArray(0, "user_pkmn_movemem", 2)));
  UH_Log(UH_LOG_DEBUG, StrParam(i:GetUserArray(0, "user_pkmn_movemem", 3)));
  UH_Log(UH_LOG_DEBUG, StrParam(i:GetUserArray(0, "user_pkmn_movemem", 7)));
}

// Shared finite shuffle: distinct opening weapons even for tiny addon pools.
int uh_startcopyindices[UH_MEGA_LOADOUT_MAX];
function void UH_GiveStartCopyWeapons(int kind, int requested, int limit) {
  int count = CountCopyWepByKind(kind);
  int want = min(max(1, requested), min(count, limit));
  int i;
  int j;
  int temp;
  for (i = 0; i < count; i++)
    uh_startcopyindices[i] = i;
  if (kind == UHCOPY_QWANT) {
    for (i = 0; i < 4; i++)
      SetUserArray(0, "user_pkmn_movemem", i, -1);
  }
  for (i = 0; i < want; i++) {
    j = random(i, count - 1);
    temp = uh_startcopyindices[i];
    uh_startcopyindices[i] = uh_startcopyindices[j];
    uh_startcopyindices[j] = temp;
    if (kind == UHCOPY_QWANT && i < 4)
      SetUserArray(0, "user_pkmn_movemem", i, uh_startcopyindices[i]);
    GiveInventory(GetCopyWepActorByKindIndex(kind, uh_startcopyindices[i]), 1);
  }
}

script "uh_QwantStartMoves" (void) {
  int waits = 0;
  int qcount = CountCopyWepByKind(UHCOPY_QWANT);
  // StartItem Pickup may precede vanilla registration's OPEN script.
  while (qcount <= 0 && waits < 35) {
    Delay(1);
    waits++;
    qcount = CountCopyWepByKind(UHCOPY_QWANT);
  }
  if (qcount <= 0)
    terminate;
  UH_GiveStartCopyWeapons(UHCOPY_QWANT, GetCVar("rz_sv_qwant_start_weapon_count"), UH_MEGA_LOADOUT_MAX);
  SetUserArray(0, "user_pkmn_movemem", 7, 777);
}

function void GiveNegaStartCopyWeps(void) {
  UH_GiveStartCopyWeapons(UHCOPY_NEGA, GetCVar("rz_sv_nega_start_weapon_count"), UH_MEGA_LOADOUT_MAX);
}

script "uh_NegaManStartMoves" (void) {
  int waits;
  int ncount;

  waits = 0;
  ncount = CountCopyWepByKind(UHCOPY_NEGA);
  while (ncount <= 0 && waits < 35) {
    Delay(1);
    waits++;
    ncount = CountCopyWepByKind(UHCOPY_NEGA);
  }
  if (ncount <= 0)
    terminate;
  GiveNegaStartCopyWeps();
}

script "uh_GiveRandomCopyweps" (int check) {
  if (check == 0)
    UH_Log(UH_LOG_ERROR, "U_RNGWEAPONGIVE CHECK 0 IS GONE! USE UH_COPYWEPS.acs");
  if (check == 1)
    UH_Log(UH_LOG_ERROR, "U_RNGWEAPONGIVE CHECK 1 IS GONE! USE UH_COPYWEPS.acs");
  if (check == 2)
    GiveNegaStartCopyWeps();
}

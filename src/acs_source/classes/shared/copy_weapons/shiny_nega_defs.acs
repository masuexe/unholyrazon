function void RegisterVanillaShinyNegaSlots(void) {
  // Same L1/L2/L3 weapon; Select branches on uh_ShinyNegaGetChargeLevel.
  DefineShinyNegaSlotWep(1, "NegaShiny_ThunderBeam_W", "", "");
  DefineShinyNegaSlotWep(2, "NegaShiny_TimeStopper_W", "", "");
  DefineShinyNegaSlotWep(3, "NegaShiny_SearchSnake_W", "", "");
  DefineShinyNegaSlotWep(4, "NegaShiny_Skull_W", "", "");
  DefineShinyNegaSlotWep(5, "NegaShiny_GravityHold_W", "", "");
  DefineShinyNegaSlotWep(6, "NegaShiny_FlameBlast_W", "", "");
  DefineShinyNegaSlotWep(7, "NegaShiny_SlashClaw_W", "", "");
  DefineShinyNegaSlotWep(8, "NegaShiny_IceWave_W", "", "");
  DefineShinyNegaSlotWep(9, "NegaShiny_BlackHole_W", "", "");
  DefineShinyNegaSlotWep(10, "NegaShiny_ChillSpike_W", "", "");
  DefineShinyNegaSlotWep(11, "NegaShiny_LightningBolt_W", "", "");
  DefineShinyNegaSlotWep(12, "NegaShiny_BalladeCracker_W", "", "");
  DefineShinyNegaSlotWep(13, "NegaShiny_GrabBuster_W", "", "");
  DefineShinyNegaSlotWep(14, "NegaShiny_TimeSlow_W", "", "");
  DefineShinyNegaSlotWep(15, "NegaShiny_BubbleLead_W", "", "");
  DefineShinyNegaSlotWep(16, "NegaShiny_NeedleCannon_W", "", "");
  DefineShinyNegaSlotWep(17, "NegaShiny_RainFlush_W", "", "");
  DefineShinyNegaSlotWep(18, "NegaShiny_NapalmBomb_W", "", "");
  DefineShinyNegaSlotWep(19, "NegaShiny_YamatoSpear_W", "", "");
  DefineShinyNegaSlotWep(20, "NegaShiny_WildCoil_W", "", "");
  DefineShinyNegaSlotWep(21, "NegaShiny_FlashBomb_W", "", "");
  DefineShinyNegaSlotWep(22, "NegaShiny_MagmaBazooka_W", "", "");
  DefineShinyNegaSlotWep(23, "NegaShiny_TripleBlade_W", "", "");
  DefineShinyNegaSlotWep(24, "NegaShiny_IceWall_W", "", "");
  DefineShinyNegaSlotWep(25, "NegaShiny_SparkChaser_W", "", "");
  // 26: defining it makes HasCustomNegaSlots() true, so UH_ShinyNegaNextSlot
  // cycles 1..25 -> 26 -> buster instead of wrapping at 25.
  DefineShinyNegaSlotWep(26, "NegaShiny_SuperArm_W", "", "");
}

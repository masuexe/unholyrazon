// Unbound Boss/Eye True Power: a rage-capable class always takes the refill
// branch, even when its meter is already full. Only classes without a meter
// fall back to the health bonus in S_ClassBAWS_P.
script "uh_TruePower_AmmoGiver" (void) {
  int limit = CheckInventory("UnholyPowerLimit_F");
  if (limit > 0) {
    GiveInventory(StrParam(s:"UnholyPower", i:limit), limit);
    SetResultValue(1);
  } else {
    SetResultValue(0);
  }
}

// Repeat survivor use changes only the cap: no healing, ammo refill, buffs,
// or second Shiny morph. Keep the existing health-bonus amount and cap.
script "uh_TruePower_Repeat" (void) {
  if (PlayerNumber() < 0 || GetActorProperty(0, APROP_Health) <= 0
      || !CheckInventory("TruePowerItemFlag") || CheckInventory("BAWS")) {
    SetResultValue(0);
    terminate;
  }
  int maximum = GetActorProperty(0, APROP_SpawnHealth);
  if (maximum < MAX_HEALTH)
    SetActorProperty(0, APROP_SpawnHealth, min(maximum + 2000, MAX_HEALTH));
  SetResultValue(1);
}

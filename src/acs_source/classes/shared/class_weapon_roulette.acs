// Class-owned weapons used by Pharaoh 4MI's roulette curse. Unlike DTADD's
// DefineWeapon, these rows do not enter MM8BDM's random-weapon pools.
#define UH_MULTIWEAPON_MAX 512
#define UH_MULTIWEAPON_FAIL -9999

str uh_multiweapon_class[UH_MULTIWEAPON_MAX];
str uh_multiweapon_actor[UH_MULTIWEAPON_MAX];
int uh_multiweapon_count;

function int UH_RegisterMultiWeapon(str classActor, str weaponActor) {
  if (StrLen(classActor) == 0 || StrLen(weaponActor) == 0)
    return UH_MULTIWEAPON_FAIL;
  for (int i = 0; i < uh_multiweapon_count; i++) {
    if (StrICmp(uh_multiweapon_actor[i], weaponActor) == 0) {
      if (StrICmp(uh_multiweapon_class[i], classActor) == 0)
        return i;
      return UH_MULTIWEAPON_FAIL;
    }
  }
  if (uh_multiweapon_count >= UH_MULTIWEAPON_MAX)
    return UH_MULTIWEAPON_FAIL;
  int row = uh_multiweapon_count;
  uh_multiweapon_class[row] = classActor;
  uh_multiweapon_actor[row] = weaponActor;
  uh_multiweapon_count++;
  return row;
}

// UHADD passes strings through registered cvars. Raw ACS string indices are
// not portable between server and client processes.
script "uh_DefineMultiWeapon_S" (void) {
  SetResultValue(UH_RegisterMultiWeapon(
    GetCVarString("uh_mw_class"), GetCVarString("uh_mw_weapon")));
}

str uh_ownedmultiweapon[UH_MULTIWEAPON_MAX];

function int UH_CollectOwnedMultiWeapons(void) {
  str classActor = GetActorClass(0);
  int count = 0;
  for (int i = 0; i < uh_multiweapon_count; i++) {
    if (StrICmp(uh_multiweapon_class[i], classActor) == 0 &&
        CheckInventory(uh_multiweapon_actor[i])) {
      uh_ownedmultiweapon[count] = uh_multiweapon_actor[i];
      count++;
    }
  }
  return count;
}

function int CountClassWeapons(void) {
  int native = UH_CollectOwnedMultiWeapons();
  if (native >= 2)
    return native;
  return ACS_NamedExecuteWithResult("rz_CountCopyWeapons");
}

script "rz_CountClassWeapons" (void) {
  SetResultValue(CountClassWeapons());
}

// Activator: player. Pick another owned weapon of this actor class.
script "rz_RoulettePickOtherWeapon" (void) {
  str current = GetWeapon();
  if (StrLen(current) == 0) {
    SetResultValue(0);
    terminate;
  }

  int n = UH_CollectOwnedMultiWeapons();
  if (n >= 2) {
    int start = Random(0, n - 1);
    for (int i = 0; i < n; i++) {
      str next = uh_ownedmultiweapon[(start + i) % n];
      if (StrICmp(next, current) != 0 && SetWeapon(next)) {
        SetResultValue(1);
        terminate;
      }
    }
    SetResultValue(0);
    terminate;
  }

  SetResultValue(ACS_NamedExecuteWithResult("rz_RoulettePickCopyWeapon"));
}

script "rz_MosquitoEyeTurboTime" (void) {
  int maxhealth = 800;
  int health = PlayerHealth();
  int speedmtp;
  if (health <= 0) {
    speedmtp = 10.0;
  } else {
    speedmtp = FixedDiv(maxhealth, health);
    if (speedmtp > 10.0) {
      speedmtp = 10.0;
    }
  }
  SetActorProperty(0, APROP_Speed, speedmtp);
}

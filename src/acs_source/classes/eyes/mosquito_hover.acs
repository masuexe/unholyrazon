// Unlimited-altitude permanent flight with pit stamina for Mosquito Demoneye.
script "uh_MosquitoDemoneyeHoverRelease" (void) {
  UH_BossHoverRelease("MosquitoDemoneye_HoverActive_F");
}

script "uh_MosquitoDemoneyeHover" (void) {
  ACS_NamedExecuteAlways("uh_BossFlightPit", 0,
    "MosquitoDemoneye", "MosquitoDemoneye_HoverActive_F",
    "MosquitoDemoneye_HoverStamina_F");
}

#library "uh_eyedefs"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"
#include "uh_eyedefs_presentation.acs"

// Vanilla demoneyes: sparse ids match uh_DemoneyeMorph / weapon CallACS args.
// Mugshot = BHW SetFont name (EYE_F{n}). eventStem builds {stem}_MoolaGiver.
// name carries color codes; prefix is article only ("a " / "an ").
// flags: 0 or UHEYE_FLAG_NOSUFFIX (omit " Demoneye" in YouAreNow).
// Bonus face-only ids (100/106/111) omit actor — share base morph class.
// ArenaDemoneye / FoxDemoneye300 stay DefineBoss, not here.

function void RegisterVanillaDemoneyes(void) {
  // name carries color (like DefineBoss / DefineSurvivor); prefix is article only.
  DefineDemoneye(0, "PlainDemoneye", "\ctPlain", "a ", 0, "EYE_F0", "Plain");
  DefineDemoneye(1, "MLGDemoneye", "\cqMLG", "a ", 0, "EYE_F1", "MLG");
  DefineDemoneye(2, "GhostDemoneye", "\cjGhost", "a ", 0, "EYE_F2", "Ghost");
  DefineDemoneye(3, "JoustDemoneye", "\cuJoust", "a ", 0, "EYE_F3", "Joust");
  DefineDemoneye(4, "SumoDemoneye", "\cjSumo", "a ", 0, "EYE_F4", "Sumo");
  DefineDemoneye(5, "KamikazeDemoneye", "\crKamikaze", "a ", 0, "EYE_F5", "Kamikaze");
  DefineDemoneye(6, "RichDemoneye", "\cdRich", "a ", 0, "EYE_F6", "Rich");
  DefineDemoneye(7, "BomberDemoneye", "\cjBomber", "a ", 0, "EYE_F7", "Bomber");
  DefineDemoneye(8, "BusinessDemoneye", "\cmBusiness", "a ", 0, "EYE_F8", "Business");
  DefineDemoneye(9, "QuickDemoneye", "\clQuick", "a ", 0, "EYE_F9", "Quick");
  DefineDemoneye(10, "TankDemoneye", "\ctTank", "a ", 0, "EYE_F10", "Tank");
  DefineDemoneye(11, "EyelentoDemoneye", "\cfEyelento", "an ", 0, "EYE_F11", "Eyelento");
  DefineDemoneye(12, "AlienDemoneye", "\caSpeciman Jr", "a ", UHEYE_FLAG_NOSUFFIX, "EYE_F12", "Alien");
  DefineDemoneye(13, "TyphoonDemoneye", "\c[c2]Typhoon", "a ", 0, "EYE_F13", "Typhoon");
  DefineDemoneye(14, "BrickDemoneye", "\c[n3]Brick", "a ", 0, "EYE_F14", "Brick");
  DefineDemoneye(15, "MosquitoDemoneye", "\c[y2]Mosquito", "a ", 0, "EYE_F15", "Mosquito");
  DefineDemoneye(30, "FoxDemoneye", "\ciFox", "a ", 0, "EYE_F30", "Fox");
  DefineDemoneye(31, "FurryDemoneye", "\coFurry", "a ", 0, "EYE_F31", "Furry");
  DefineDemoneye(32, "DarkPurpleClone", "\cmDark Purple Clone", "a ", UHEYE_FLAG_NOSUFFIX, "EVE_F0", "PurpleClone");

  // Bonus / Devil face variants (Inventory amount = base + Bonus*100)
  DefineDemoneye(100, "", "\ctPlain", "a ", 0, "EYE_F100", "Plain");
  DefineDemoneye(106, "", "\cdRich", "a ", 0, "EYE_F106", "Rich");
  DefineDemoneye(111, "", "\cfEyelento", "an ", 0, "EYE_F111", "Eyelento");
}

// Default effect pools for the two vanilla items that turn their explosion
// into a Demoneye.  The weights are the old chained A_Jump probabilities
// converted to a 1,000,000-point flat pool; each effect actor keeps its own
// static MorphProjectile/PowerMorph PlayerClass.
function void RegisterVanillaEyeMorphPools(void) {
  DefineEyeMorphPool("MoneyBait");
  SetEyeMorphPoolEntry("MoneyBait", 0, "Plain_Moola", "Plain_MoolaB32", "Plain_MoolaGiver", 420523);
  SetEyeMorphPoolEntry("MoneyBait", 1, "MLG_Moola", "MLG_MoolaB32", "MLG_MoolaGiver", 140724);
  SetEyeMorphPoolEntry("MoneyBait", 2, "Ghost_Moola", "Ghost_MoolaB32", "Ghost_MoolaGiver", 1302);
  SetEyeMorphPoolEntry("MoneyBait", 3, "Joust_Moola", "Joust_MoolaB32", "Joust_MoolaGiver", 1302);
  SetEyeMorphPoolEntry("MoneyBait", 4, "Sumo_Moola", "Sumo_MoolaB32", "Sumo_MoolaGiver", 140724);
  SetEyeMorphPoolEntry("MoneyBait", 5, "Kamikaze_Moola", "Kamikaze_MoolaB32", "Kamikaze_MoolaGiver", 120621);
  SetEyeMorphPoolEntry("MoneyBait", 6, "Rich_Moola", "Rich_MoolaB32", "Rich_MoolaGiver", 1649);
  SetEyeMorphPoolEntry("MoneyBait", 7, "Bomber_Moola", "Bomber_MoolaB32", "Bomber_MoolaGiver", 140724);
  SetEyeMorphPoolEntry("MoneyBait", 8, "Business_Moola", "Business_MoolaB32", "Business_MoolaGiver", 15564);
  SetEyeMorphPoolEntry("MoneyBait", 9, "Quick_Moola", "Quick_MoolaB32", "Quick_MoolaGiver", 1302);
  SetEyeMorphPoolEntry("MoneyBait", 10, "Tank_Moola", "Tank_MoolaB32", "Tank_MoolaGiver", 15564);
  SetEyeMorphPoolEntry("MoneyBait", 13, "Typhoon_Moola", "Typhoon_MoolaB32", "Typhoon_MoolaGiver", 120621);
  SetEyeMorphPoolEntry("MoneyBait", 14, "Brick_Moola", "Brick_MoolaB32", "Brick_MoolaGiver", 15564);
  SetEyeMorphPoolEntry("MoneyBait", 15, "Mosquito_Moola", "Mosquito_MoolaB32", "Mosquito_MoolaGiver", 120621);
  SetEyeMorphPoolEntry("MoneyBait", 30, "Fox_Moola", "Fox_MoolaB32", "Fox_MoolaGiver", 50);
  SetEyeMorphPoolEntry("MoneyBait", 31, "Furry_Moola", "Furry_MoolaB32", "Furry_MoolaGiver", 1);

  DefineEyeMorphPool("MoneyBomb");
  SetEyeMorphPoolEntry("MoneyBomb", 2, "", "Ghost_MoolaB", "Ghost_MoolaGiver", 139269);
  SetEyeMorphPoolEntry("MoneyBomb", 3, "", "Joust_MoolaB", "Joust_MoolaGiver", 108231);
  SetEyeMorphPoolEntry("MoneyBomb", 5, "", "Kamikaze_MoolaB", "Kamikaze_MoolaGiver", 37801);
  SetEyeMorphPoolEntry("MoneyBomb", 6, "", "Rich_MoolaB", "Rich_MoolaGiver", 46143);
  SetEyeMorphPoolEntry("MoneyBomb", 7, "", "Bomber_MoolaB", "Bomber_MoolaGiver", 37801);
  SetEyeMorphPoolEntry("MoneyBomb", 8, "", "Business_MoolaB", "Business_MoolaGiver", 129551);
  SetEyeMorphPoolEntry("MoneyBomb", 9, "", "Quick_MoolaB", "Quick_MoolaGiver", 139269);
  SetEyeMorphPoolEntry("MoneyBomb", 10, "", "Tank_MoolaB", "Tank_MoolaGiver", 129551);
  SetEyeMorphPoolEntry("MoneyBomb", 11, "", "Eyelento_MoolaB", "Eyelento_MoolaGiver", 108231);
  SetEyeMorphPoolEntry("MoneyBomb", 12, "", "Alien_MoolaB", "Alien_MoolaGiver", 108231);
  SetEyeMorphPoolEntry("MoneyBomb", 13, "", "Typhoon_MoolaB", "Typhoon_MoolaGiver", 139269);
  // SetEyeMorphPoolEntry("MoneyBomb", 14, "", "Brick_MoolaB", "Brick_MoolaGiver", 129551);
  SetEyeMorphPoolEntry("MoneyBomb", 15, "", "Mosquito_MoolaB", "Mosquito_MoolaGiver", 37801);
  SetEyeMorphPoolEntry("MoneyBomb", 30, "", "Fox_MoolaB", "Fox_MoolaGiver", 15625);
  SetEyeMorphPoolEntry("MoneyBomb", 31, "", "Furry_MoolaB", "Furry_MoolaGiver", 296);
}

script "uh_define_vanilla_eyes" OPEN {
  if (!UHInPlay()) terminate;
  if (!IsEyeDefined(0))
    RegisterVanillaDemoneyes();
  RegisterEyePresentations();
  RegisterVanillaEyeMorphPools();
}

script "uh_define_vanilla_eyes_cs" OPEN CLIENTSIDE {
  if (!IsEyeDefined(0))
    RegisterVanillaDemoneyes();
  RegisterEyePresentations();
  RegisterVanillaEyeMorphPools();
}

// ZANGIEF

#define GRAB_DISTANCE 100  // how far to position the grabbed away from zangief
#define GRAB_DISTANCE_LIMIT 100000  // how far away to give up on the grabbed, squared

str zangief_give_item[2] = {
  "AntiInvincible_P",
  "AirSuplexGroundCheck"
};

// Friendly grabs deliberately cause no damage, so core_HazardTag's damage
// event never records their owner. Use the base game's timed hazard credit
// directly for successful grabs/moves, including the shared throw borrowers.
// Refresh while carrying so a long hold does not expire before the release.
function void UH_ZangiefRefreshHazardTag(int ownerTid, int victimTid) {
  if (!GetCVar("mm8bdm_sv_enablehazardtag") || ownerTid == victimTid) {return;}
  int owner = ownerTid - PLN_TID;
  int victim = victimTid - PLN_TID;
  if (owner < 0 || owner >= ServerMAX || victim < 0 || victim >= ServerMAX) {return;}
  if (!PlayerInGame(owner) || !PlayerInGame(victim) ||
      GetActorProperty(ownerTid, APROP_Health) <= 0 ||
      GetActorProperty(victimTid, APROP_Health) <= 0) {return;}
  ACS_NamedExecuteWithResult("core_HazardTag_manager", ownerTid, victimTid);
}

// Razon3 UB_PUSHPULLACS(25/50, 250, 2), scoped to Zangief's charge.
// One pulse per charge tic; no delayed script survives release or morphing.
script "uh_ZangiefChargePull" (int maxforce) {
  if (!GetCVar("uh_sv_zangiefpull") || maxforce <= 0) {terminate;}
  int owner = PlayerNumber();
  if (owner < 0 || !PlayerInGame(owner) || PlayerIsSpectator(owner) ||
      GetActorProperty(0, APROP_Health) <= 0) {terminate;}
  str actor = GetActorClass(0);
  if (StrICmp(actor, "Zangief") && StrICmp(actor, "ZangiefShiny")) {terminate;}

  for (int p = 0; p < ServerMAX; p++) {
    if (p == owner || !PlayerInGame(p) || PlayerIsSpectator(p)) {continue;}
    int target = PLN_TID + p;
    if (!ThingCount(T_NONE, target) || GetActorProperty(target, APROP_Health) <= 0 ||
        CheckActorInventory(target, "PowerProtectBoss")) {continue;}
    // Preserve the legacy Swap=2 filter and native team-game exclusion.
    if (IsTeamGame && GetPlayerInfo(owner, PLAYERINFO_TEAM) == GetPlayerInfo(p, PLAYERINFO_TEAM)) {continue;}
    int distance = XYZDistance(0, target);
    if (distance <= 40 || distance >= 250) {continue;}
    int force = CeilFixedToInt(FixedMul(maxforce << 16, 1.0 - FixedDiv(distance, 250)));
    force = min(force, maxforce);
    int angle = VectorAngle(GetActorX(0) - GetActorX(target), GetActorY(0) - GetActorY(target)) >> 8;
    ThrustThing(angle, force, false, target);
  }
}

// Explicit acquisition also works when team protection suppresses Pain.Suplex.
// Player arguments are slots; SuplexID stores victim + 1 as before.
script "uh_ZangiefBindGrab" (int owner, int victim) {
  SetResultValue(0);
  if (owner < 0 || owner >= ServerMAX || victim < 0 || victim >= ServerMAX || owner == victim) {terminate;}
  if (!PlayerInGame(owner) || !PlayerInGame(victim)) {terminate;}
  int ownerTid = 1000 + owner;
  int victimTid = 1000 + victim;
  if (!ThingCount(T_NONE, ownerTid) || !ThingCount(T_NONE, victimTid) ||
      GetActorProperty(ownerTid, APROP_Health) <= 0 || GetActorProperty(victimTid, APROP_Health) <= 0 ||
      CheckActorInventory(ownerTid, "SuplexID")) {terminate;}

  TakeActorInventory(ownerTid, "ZangiefFriendlyGrab_F", 1);
  if (ACS_NamedExecuteWithResult("uh_ZangiefAreTeammates", owner, victim)) {
    GiveActorInventory(ownerTid, "ZangiefFriendlyGrab_F", 1);
  }
  GiveActorInventory(ownerTid, "SuplexID", victim + 1);
  UH_ZangiefRefreshHazardTag(ownerTid, victimTid);
  SetResultValue(1);
}

// Activator is a grab projectile/explosion. Return 1 only for a friendly
// grab, so DECORATE can omit its damage while keeping the ordinary enemy hit.
script "uh_ZangiefTryGrab" (int radius, int aerial, int superarm) {
  SetResultValue(0);
  int ownerTid = GetActorProperty(0, APROP_TargetTID);
  if (ownerTid < 1000 || ownerTid >= 1000 + ServerMAX || radius <= 0) {terminate;}
  // Super Arm explicitly opts in; other borrowers retain their behavior.
  str ownerClass = GetActorClass(ownerTid);
  if (!superarm && StrICmp(ownerClass, "Zangief") && StrICmp(ownerClass, "ZangiefShiny")) {terminate;}
  int owner = ownerTid - 1000;
  if (!PlayerInGame(owner) || GetActorProperty(ownerTid, APROP_Health) <= 0) {terminate;}
  if (CheckActorInventory(ownerTid, "SuplexID")) {
    SetResultValue(CheckActorInventory(ownerTid, "ZangiefFriendlyGrab_F"));
    terminate;
  }

  int best = -1;
  int bestDistance = radius * 1.0;
  for (int p = 0; p < ServerMAX; p++) {
    if (p == owner || !PlayerInGame(p) || PlayerIsSpectator(p)) {continue;}
    int target = 1000 + p;
    if (!ThingCount(T_NONE, target) || GetActorProperty(target, APROP_Health) <= 0) {continue;}
    // Preserve the existing airborne-only rule for the leap grab.
    if (aerial && CheckActorInventory(target, "NoAirSuplex")) {continue;}

    // Match modern P_RadiusAttack's square XY footprint and vertical gap.
    int dx = abs(GetActorX(target) - GetActorX(0));
    int dy = abs(GetActorY(target) - GetActorY(0));
    int xy = max(dx, dy) - GetActorProperty(target, APROP_Radius);
    xy = max(xy, 0);
    int dz = max(GetActorZ(target) - GetActorZ(0),
                 GetActorZ(0) - GetActorZ(target) - GetActorProperty(target, APROP_Height));
    dz = max(dz, 0);
    int distance = VectorLength(xy, dz);
    if (distance >= bestDistance || !CheckSight(0, target, CSF_NOFAKEFLOORS)) {continue;}
    best = p;
    bestDistance = distance;
  }
  if (best < 0) {terminate;}
  if (ACS_NamedExecuteWithResult("uh_ZangiefBindGrab", owner, best)) {
    SetResultValue(CheckActorInventory(ownerTid, "ZangiefFriendlyGrab_F"));
  }
}

script "uh_ZangiefGiver" (int i, int target) {
  // log(i:i,s:" & ",i:target);
  // zangief_give_item was reduced to the two entries actually used by the
  // current grab code.  Keep malformed/stale callers from indexing into the
  // neighboring ACS string data (which can turn a map string into an item
  // name and make GiveActorInventory report a misleading class error).
  if (target == 999 || i < 0 || i >= 2) {terminate;}
  if (i == 0 && CheckInventory("ZangiefFriendlyGrab_F")) {terminate;}
  GiveActorInventory(target, zangief_give_item[i], 1);
}

script "uh_ZangiefGiveToAll" (int i) {
  for (int j = 0; j < ServerMAX; j++) {
    if (PlayerInGame(j)) GiveActorInventory(1000 + j, zangief_give_item[i], 1);
  }
}

script "uh_ZangiefFaceTarget" (int target) {
  SetResultValue(VectorAngle(GetActorX(target) - GetActorX(0), GetActorY(target) - GetActorY(0)) >> 8);
}

script "uh_ZangiefStartGrab" (int target, int grabdist, int grablimit) {
  if (target == 999) {
    SetResultValue(1);
    terminate;
  }
  if (!ThingCount(T_NONE, target) || GetActorProperty(target, APROP_Health) <= 0) {
    SetResultValue(0);
    terminate;
  }
  // Discouraged: omit both args (0, 0) to fall back on these defines.
  // Pass grabdist and grablimit explicitly instead.
  if (grabdist <= 0 && grablimit <= 0) {
    grabdist = GRAB_DISTANCE;
    grablimit = GRAB_DISTANCE_LIMIT;
  }
  int angle = GetActorAngle(0);
  int x_diff = (GetActorX(0) + grabdist * cos(angle)) - GetActorX(target);
  int y_diff = (GetActorY(0) + grabdist * sin(angle)) - GetActorY(target);
  int z_diff = GetActorZ(0) - GetActorZ(target);

  int x_diff_i = x_diff >> 16;
  int y_diff_i = y_diff >> 16;
  int z_diff_i = z_diff >> 16;

  if (x_diff_i * x_diff_i + y_diff_i * y_diff_i + z_diff_i * z_diff_i < grablimit) {
    UH_ZangiefRefreshHazardTag(ActivatorTID(), target);
    SetActorVelocity(target, x_diff, y_diff, z_diff, 0, 0);
    setResultValue(1);
  } else {
    setResultValue(0);
  }
}

// Pitch is given as x/360, Angle is given as x/255
script "uh_ZangiefGrab" (int pitch, int angle, int grab_d, int grablimit) {
  int target = ACS_NamedExecuteWithResult("rz_CountInv_SuplexID") + 999;
  if (target == 999) {
    SetResultValue(1);
    terminate;
  }
  if (!ThingCount(T_NONE, target) || GetActorProperty(target, APROP_Health) <= 0) {
    SetResultValue(0);
    terminate;
  }
  // Discouraged: omit grablimit (0) to fall back on GRAB_DISTANCE_LIMIT.
  // CallACS can pass a 4th argument; pass grablimit explicitly instead.
  if (grablimit <= 0) grablimit = GRAB_DISTANCE_LIMIT;
  GiveActorInventory(target, "DashingStraitjacket_F", 1);
  angle = angle << 8;
  pitch = (pitch - 360) * 1.0 / 360;
  int x_diff = (GetActorX(0) + FixedMul(grab_d * cos(angle), cos(pitch))) - GetActorX(target);
  int y_diff = (GetActorY(0) + FixedMul(grab_d * sin(angle), cos(pitch))) - GetActorY(target);
  int z_diff = (GetActorZ(0) - grab_d * sin(pitch)) - GetActorZ(target);

  int x_diff_i = x_diff >> 16;
  int y_diff_i = y_diff >> 16;
  int z_diff_i = z_diff >> 16;

  if (x_diff_i * x_diff_i + y_diff_i * y_diff_i + z_diff_i * z_diff_i < grablimit) {
    UH_ZangiefRefreshHazardTag(ActivatorTID(), target);
    SetActorVelocity(target, x_diff, y_diff, z_diff, 0, 0);
    setResultValue(1);
  } else {
    setResultValue(0);
  }
}

script "uh_ZangiefSetThrow" (int target, int force, int zforce) {
  UH_ZangiefRefreshHazardTag(ActivatorTID(), target);
  Thing_Stop(target);
  ThrustThing(GetActorAngle(0) >> 8, force, 1, target);
  ThrustThingZ(target, zforce, 0, 0);
}

// Snapshot the friendly flag before the thrower resets grab state.
script "uh_NegaSuperArmFriendlyThrow" (void) {
  SetResultValue(0);
  if (SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(CheckInventory("ZangiefFriendlyGrab_F"));
  }
}

// Flight watch for the SuperArm throw, called once per tic by the flying
// NegaSuperArmSlam (activator = the slam). Shadows the thrown player
// (tid = suplexid-1+1000) so the slam rides on them mid-air, and reports when
// to detonate: 0 = still flying, 1 = landed or wall-hit (or forced while
// present), 2 = victim gone or dead -> the slam fizzles without a boom.
// A thrown player never bounces: their horizontal velocity collapsing to ~0
// while still airborne means they slammed into a wall.
script "rz_NegaSuperArmThrowFollow" (int tid, int force, int friendly) {
  if (!ThingCount(T_NONE, tid) || GetActorProperty(tid, APROP_HEALTH) <= 0) {
    setResultValue(2);
    terminate;
  }
  // Strip enemy protection per tic for the landing damage; teammates keep it.
  if (!friendly) GiveActorInventory(tid, "AntiInvincible_P", 1);
  // Thing_Move's third arg is NOFOG (p_lnspec.cpp: arg2 ? false : true) —
  // 0 would spawn teleport fog on every per-tic shadow move.
  Thing_Move(0, tid, 1);
  int wallhit = abs(GetActorVelX(tid)) + abs(GetActorVelY(tid)) < 1.0;
  int landed = GetActorVelZ(tid) <= 0 && GetActorZ(tid) <= GetActorFloorZ(tid) + 4.0;
  if (force || wallhit || landed) {
    setResultValue(1);
    terminate;
  }
  setResultValue(0);
}

script "uh_ZangiefGrabReverse" (int pitch, int angle, int grab_d, int grablimit) {
  int target = ACS_namedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  SetActivator(0, 8);
  if (target == 999) {
    SetResultValue(1);
    terminate;
  }
  // Discouraged: omit grablimit (0) to fall back on GRAB_DISTANCE_LIMIT.
  // CallACS can pass a 4th argument; pass grablimit explicitly instead.
  if (grablimit <= 0) grablimit = GRAB_DISTANCE_LIMIT;
  angle = angle << 8;
  pitch = (pitch - 360) * 1.0 / 360;
  int x_diff = (GetActorX(0) + FixedMul(grab_d * cos(angle), cos(pitch))) - GetActorX(target);
  int y_diff = (GetActorY(0) + FixedMul(grab_d * sin(angle), cos(pitch))) - GetActorY(target);
  int z_diff = (GetActorZ(0) - grab_d * sin(pitch)) - GetActorZ(target);

  int x_diff_i = x_diff >> 16;
  int y_diff_i = y_diff >> 16;
  int z_diff_i = z_diff >> 16;

  if (x_diff_i * x_diff_i + y_diff_i * y_diff_i + z_diff_i * z_diff_i < grablimit) {
    SetActorVelocity(target, x_diff, y_diff, z_diff, 0, 0);
    setResultValue(1);
  } else {
    setResultValue(0);
  }
}

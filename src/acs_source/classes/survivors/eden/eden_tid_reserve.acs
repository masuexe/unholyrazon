// Eden's fixed per-player C396 endpoint TIDs (Ventricle Razor endpoints).
// Fragment of library RZ_TOOLS (aggregator: systems/tools/rz_tools.acs).

#define EDEN_C396_BLUE_TID_FIRST 1500
#define EDEN_C396_BLUE_TID_LAST 1563
#define EDEN_C396_ORANGE_TID_FIRST 1600
#define EDEN_C396_ORANGE_TID_LAST 1663

// Keep the fixed per-player C396 endpoint ranges out of core_uniquetid.
script "rz_EdenReserveC396TIDs" OPEN {
  DefineReservedTIDRange(EDEN_C396_BLUE_TID_FIRST, EDEN_C396_BLUE_TID_LAST);
  DefineReservedTIDRange(EDEN_C396_ORANGE_TID_FIRST, EDEN_C396_ORANGE_TID_LAST);
}

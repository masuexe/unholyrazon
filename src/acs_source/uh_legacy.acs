	SetResultValue(ACS_NamedExecuteWithResult("uh_BossMorph", whoisit, BaseHP, AddHP));
}

Script 811 (int whoisit, int Bonus) {
	legacyWarnNumScript(811, "whoisit", whoisit, "Bonus", Bonus, "", 0, "Superceded by \"uh_DemoneyeMorph\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_DemoneyeMorph", whoisit, Bonus));
}

#DEFINE U_BOSS_GET_INV 2445
script U_BOSS_GET_INV (int i, int ID)
{
	legacyWarnNumScript(2445, "i", i, "ID", ID, "", 0, "Superceded by \"uh_CheckItemInventory\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_CheckItemInventory", i+1, ID));
}

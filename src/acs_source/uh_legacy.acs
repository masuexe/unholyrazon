#library "uh_legacy"
#include "zcommon.acs"

//Old script numbers/names
//For debuging changes

//Borrow of core LEGACY.acs functions so warnings are similar

function void legacyWarnNumScript(int scr, str arg1str, int arg1, str arg2str, int arg2, str arg3str, int arg3, str notes)
{
	legacyWarnNamedScript(strParam(i:scr), arg1str, arg1, arg2str, arg2, arg3str, arg3, notes);
}

function void legacyWarnNumScriptNoArgs(int scr, str notes)
{
	legacyWarnNumScript(scr, "", 0, "", 0, "", 0, notes);
}

function void legacyWarnNamedScript(str scr, str arg1str, int arg1, str arg2str, int arg2, str arg3str, int arg3, str notes)
{
		str ret = StrParam(s:"\ciWARNING: Script ", s:scr, s:" called by actor: \"", s:GetActorClass(0), s:"\" ");
		if(StrLen(arg1str) != 0) {
			ret = StrParam(s:ret, s:arg1str, s:": ", i:arg1, s:" ");
		}
		if(StrLen(arg2str) != 0) {
			ret = StrParam(s:ret, s:arg2str, s:": ", i:arg2, s:" ");
		}
		if(StrLen(arg3str) != 0) {
			ret = StrParam(s:ret, s:arg3str, s:": ", i:arg3, s:"\n");
		}
		if(StrLen(notes) != 0) {
			ret = StrParam(s:ret, s:"(", s:notes, s:")");
		}
		Log(s:ret);
		if(IsNetworkGame() && ConsolePlayerNumber()==-1) {
			NamedSendNetworkString("core_legacywarning",ret);
		}

}

script "uh_legacywarning" (int ret) CLIENTSIDE {
	Log(s:ret);
}

function void legacyWarnNamedScriptNoArgs(str scr, str notes)
{
	legacyWarnNumScript(scr, "", 0, "", 0, "", 0, notes);
}


#define U_CHECK_TARGET_OOC 6649
#define U_CHECK_TRACER_OOC 6650
#define U_CHECK_MASTER_OOC 6651
script U_CHECK_TARGET_OOC (void)//This is for projectiles to check if their owner spectated, disconnected, or is dead.
{
	legacyWarnNumScriptNoArgs(6649, "Superceded by \"uh_PointerExists\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_PointerExists",2));
}
script U_CHECK_TRACER_OOC (void)
{
	legacyWarnNumScriptNoArgs(6650, "Superceded by \"uh_PointerExists\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_PointerExists",8));
}
script U_CHECK_MASTER_OOC (void)
{
	legacyWarnNumScriptNoArgs(6651, "Superceded by \"uh_PointerExists\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_PointerExists",4));
}

#DEFINE U_CHECK_SINGLE_INPUT 514
script U_CHECK_SINGLE_INPUT (int Which, int ThePointer, int Mod_Bool)
{
	legacyWarnNumScript(514, "Which", Which, "ThePointer",  ThePointer, "Mod_Bool",  Mod_Bool, "Removed, use \"uh_GetPointerButtonInput\" instead");
}

#DEFINE U_HEALTHACS 142
script U_HEALTHACS (int Swap, int HPBoost)
{
	legacyWarnNumScript(142, "Swap", Swap, "HPBoost", HPBoost, "", 0, "Superceded by \"uh_Health\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_Health", Swap, HPBoost));
}

script "uh_CheckForRage" (int Pointer)
{
	legacyWarnNamedScript("uh_CheckForRage", "Pointer", Pointer, "",  0, "",  0, "Superceded by \"uh_checkrune\"");
}

script "uh_CheckForSpread" (int Pointer)
{
	legacyWarnNamedScript("uh_CheckForSpread", "Pointer", Pointer, "",  0, "",  0, "Superceded by \"uh_checkrune\"");
}

#DEFINE U_BOSS_GETINVENTORY 7445
script U_BOSS_GETINVENTORY (int Which)

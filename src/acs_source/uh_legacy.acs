// Legacy compatibility for the former dynamic Zangief inventory query.
// New code should call the corresponding rz_CountInv_<InventoryName> script.
script "uh_ZangiefCountInv" (int itemid, int pointer) {
  LegacyWarnNamedScript("uh_ZangiefCountInv", "itemid", itemid, "pointer", pointer, "", 0, "Removed, use \"rz_CountInv_<InventoryName>\" instead");
  switch (itemid) {
    case 0:
      if (pointer > 0) {
        SetActivator(0, pointer);
      }
      SetResultValue(CheckInventory("WalrusSlideAngle"));
      break;
    case 1:
      SetResultValue(ACS_NamedExecuteWithResult("rz_CountInv_ZangiefAngle", pointer));
      break;
    case 2:
      SetResultValue(ACS_NamedExecuteWithResult("rz_CountInv_SuplexID", pointer));
      break;
    default:
      SetResultValue(0);
      break;
  }
}


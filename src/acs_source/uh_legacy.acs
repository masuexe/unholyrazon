#DEFINE U_HEALTHACS 142
script U_HEALTHACS (int Swap, int HPBoost)
{
	legacyWarnNumScript(142, "Swap", Swap, "HPBoost", HPBoost, "", 0, "Superceded by \"uh_Health\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_Health", Swap, HPBoost));
}

// Old Which: 0=current, 1=max, 2=is-full → uh_Health UHEALTH_GET_CURRENT/MAX/IS_FULL
script "UH_FetchMyHealth" (int Which, int HPBoost)
{
	legacyWarnNamedScript("UH_FetchMyHealth", "Which", Which, "HPBoost", HPBoost, "", 0, "Superceded by \"uh_Health\"");
	int swap;
	switch(Which)
	{
		Case 0: swap = 1; break;  // UHEALTH_GET_CURRENT
		Case 1: swap = -1; break; // UHEALTH_GET_MAX
		Case 2: swap = 2; break;  // UHEALTH_IS_FULL
		Default:
			Log(s:"Invalid Number for legacy UH_FetchMyHealth");
			terminate;
	}
	SetResultValue(ACS_NamedExecuteWithResult("uh_Health", swap, HPBoost));
}


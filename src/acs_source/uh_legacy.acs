#define U_HEALTHACS 142
script U_HEALTHACS(int swap_var, int hpboost) {
	LegacyWarnNumScript(142, "Swap", swap_var, "HPBoost", hpboost, "", 0, "Superceded by \"uh_Health\"");
	SetResultValue(ACS_NamedExecuteWithResult("uh_Health", swap_var, hpboost));
}

// Old Which: 0=current, 1=max, 2=is-full → uh_Health UHEALTH_GET_CURRENT/MAX/IS_FULL
script "UH_FetchMyHealth" (int which, int hpboost) {
	LegacyWarnNamedScript("UH_FetchMyHealth", "Which", which, "HPBoost", hpboost, "", 0, "Superceded by \"uh_Health\"");
	int swap_var;
	switch (which) {
		case 0: swap_var = 1; break;  // UHEALTH_GET_CURRENT
		case 1: swap_var =-1; break;  // UHEALTH_GET_MAX
		case 2: swap_var = 2; break;  // UHEALTH_IS_FULL
		default:
			Log(s:"Invalid Number for legacy UH_FetchMyHealth");
			terminate;
	}
	SetResultValue(ACS_NamedExecuteWithResult("uh_Health", swap_var, hpboost));
}


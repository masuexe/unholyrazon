// Server-owned policy for every result path, including native LMS and bonus
// events. Only team immunity powers are removed, never personal defensive powers.
function str UH_PostRoundProtection(int index) {
  switch (index) {
    case 0: return "PowerProtectSurvivor";
    case 1: return "PowerProtectMegaCopywep";
    case 2: return "PowerProtectUnholyItem";
    case 3: return "PowerProtectBoss";
    case 4: return "PowerProtectEye";
    case 5: return "PowerProtectPDC";
    case 6: return "PlaineyeEventProtect";
    case 7: return "DarkPurpleCloneProtect";
    case 8: return "BrickeyeEventProtect";
    case 9: return "MosquitoeyeEventProtect";
  }
  return "";
}

function void UH_RefreshPostRoundFF(void) {
  bool enabled = GetCVar("uh_sv_postroundfriendlyfire")
    && (gameover || uh_settlementstate[UH_SETTLEMENT_PENDING]
        || GetGameModeState() == GAMESTATE_INRESULTSEQUENCE);
  int row;
  int count;
  str power;
  str pawnclass;
  for (int p = 0; p < MAX_PLAYERS; p++) {
    row = UH_POSTFF_BASE + p * UH_POSTFF_ROW_SIZE;
    // Dead/departed slots must never transfer a snapshot to a reused slot.
    if (!PlayerInGame(p) || PlayerIsSpectator(p) != 0
        || GetActorProperty(p + 1000, APROP_HEALTH) <= 0) {
      uh_settlementstate[row] = false;
      continue;
    }
    pawnclass = GetActorClass(p + 1000);
    if (uh_settlementstate[row]
        && StrICmp(pawnclass, uh_settlementmusic[4 + p]) != 0)
      uh_settlementstate[row] = false;
    if (enabled) {
      if (!uh_settlementstate[row]) {
        uh_settlementmusic[4 + p] = pawnclass;
        for (int i = 0; i < UH_POSTFF_POWER_COUNT; i++)
          uh_settlementstate[row + 1 + i] = 0;
        uh_settlementstate[row] = true;
      }
      for (i = 0; i < UH_POSTFF_POWER_COUNT; i++) {
        power = UH_PostRoundProtection(i);
        count = CheckActorInventory(p + 1000, power);
        // Capture powers re-granted by a morph/rebuild during settlement too.
        if (count > uh_settlementstate[row + 1 + i])
          uh_settlementstate[row + 1 + i] = count;
        if (count > 0) TakeActorInventory(p + 1000, power, count);
      }
    }
    else if (uh_settlementstate[row]) {
      for (i = 0; i < UH_POSTFF_POWER_COUNT; i++) {
        power = UH_PostRoundProtection(i);
        count = uh_settlementstate[row + 1 + i];
        // Preserve any newly granted protection; never create absent powers.
        if (count > CheckActorInventory(p + 1000, power))
          GiveActorInventory(p + 1000, power,
            count - CheckActorInventory(p + 1000, power));
      }
      uh_settlementstate[row] = false;
    }
  }
}

script "uh_RefreshPostRoundFF" (void) {
  UH_RefreshPostRoundFF();
}

script "uh_PostRoundFFWatch" OPEN {
  if (GetCVar("lastmanstanding") != 1) {terminate;}
  while (true) {
    UH_RefreshPostRoundFF();
    Delay(1);
  }
}

function void consoleCommandWithWarn(str command, str warning) {
	consoleCommand(command);
	Log(s: "\ci[Unholy] Warning: ", s: warning, s: " (", s: command, s: ")");
}

function void debugLog(str message) {
	if (Debug_TXT) {
		Log(s: "\ca[Unholy] Debug: ", s: message);
	}
}

//Marks which player numbers are ingame
function void playerLifeStatusArr_GatherFunc (void)
{
	totalPlayersArr[1] = PlayerCount();

	int P_Total = PlayerCount();
	for(int i = 0; i < MAX_PLAYERS; i++){
		if(PlayerInGame(i)){
			debugLog(strParam(s: "Player ", i: i, s: " is alive"));
			playerLifeStatusArr[i] = 1;
			if(P_Total <= 1){
				playerLifeStatusArr[MAX_PLAYERS] = i;
				debugLog(strParam(s: "Done collecting alive players. Max ID = ", i: playerLifeStatusArr[MAX_PLAYERS]));
				break;
			}
			P_Total--;
		}
	}
}
//Updates player status and total players with status
function void playerLifeStatusArr_UpdateFunc (int TheDude, int NewStatus)
{
	totalPlayersArr[playerLifeStatusArr[TheDude]]--;
	playerLifeStatusArr[TheDude] = NewStatus;
	totalPlayersArr[NewStatus]++;
}

//Presets a random number for EX Bosses delay
function void bossEXCountArr_Setter(int MaxCount, int Ran1, int Ran2)
{
	for(int i = 0; i < MaxCount; i++){
		BossEXCountArray[i] = random(Ran1,Ran2);
	}
	//if(Debug_TXT){Log(s:"DEBUG TXT\nBossEXCountArray randomized between values [",i:Ran1,s:"] and [",i:Ran2,s:"]!");}
}

function void presetStrongmanCheck(int Setter, int HowFar)
{
	for(int i = 0; i <= HowFar; i++){
		StrongmanCheck[i] = Setter;
	}
	debugLog(strParam(s: "StrongmanCheck Array set to value ", i: Setter, s: " with a size of ", i: HowFar, s: "."));
}

function void add_StrongmanCheckArray(int TheNum)
{
	for(int i = 0; i <= 99; i++){
		if(StrongmanCheck[i] == -1){
			StrongmanCheck[i] = TheNum;
			if(Debug_TXT){Log(s:"DEBUG TXT\nStrongmanCheck value [",i:i,s:"] set to ",i:TheNum,s:".");}
			break;
		}
	}
}
function void minus_StrongmanCheckArray (void)
{
	for(int i = 0; i <= 99; i++){
		if(StrongmanCheck[i] != -1){
			StrongmanCheck[i] = StrongmanCheck[i+1];
		}
		else{
			if(Debug_TXT){Log(s:"DEBUG TXT\nStrongmanCheck shifted over ",i:i,s:" time(s).");}
			break;
		}
	}
}


//Check and decide what MultiBoss is possible.
function void multiBossFunction(bool Reset)
{
	multiBossCheck = 1;
	debugLog(strParam(s: "multiBossCheck = ", i: multiBossCheck));
}

//Select Bosses
function void setUpBossSelection_Func (void)
{
	int TempBoss;
	for (int i = 0; i < multiBossCheck; i++) {
		bossDataArr[i][BOSSDATA_NUM] = 0;
		debugLog(strParam(s: "UnholyBoss", i: i+1, s: " = ", i: bossDataArr[i][BOSSDATA_NUM]));
	}
	//if(Debug_TXT){Log(s:"DEBUG TXT: RareBossChance = ",d:RareBossChance);}

}

//Assigns players as Bosses
function void setUpPlayerSelection_Func (void)
{
	int TempPlayer = 0;
	bossDataArr[0][BOSSDATA_TID] = 1000; //rngPickCheck(0);
	TempPlayer = bossDataArr[0][BOSSDATA_TID];
	debugLog(strParam(s: "Boss ", i: 1, s: " TID = ", i: TempPlayer));
	playerLifeStatusArr[TempPlayer-1000] = PLS_BOSS;
}

//Randomly pick a player, if they are not ingame or are in use TID's, pick another random player.
function int rngPickCheck(int PastCheck)
{
	int Check;
	do {
		Check = random(1000, playerLifeStatusArr[MAX_PLAYERS]+1000);//1063
	} while(!PlayerInGame(Check-1000) || CheckActorInventory(Check,"IsDead") ||
			!checkBossDataTIDFunc(Check,PastCheck));

	return Check;
}

//Check if TID matches in use Boss TID
function bool checkBossDataTIDFunc(int TID, int PastCheck)
{
	for(int i = 0; i < PastCheck ;i++){
		if(TID == bossDataArr[i][BOSSDATA_TID]){
			return false;
		}
	}
	return true;
}

function int morphMeFunc(int TID, int Boss, str Flash)
{
	return MorphActor(TID, mainBossList[Boss][0], "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, Flash, "");
}

// Built-in boss-combo definitions. Fragment of unholy, registered once per
// map by ub_StartUpSettings. Every id, member, weight and credit is retained
// from the former uh_def arrays; special policy stays in uh_boss_combos.
// Addons use the same data contract through UHADD (see uhcombo_api.acs).

// Keep definition failures identifiable even when no registry row was allocated.
function int UH_DefineBuiltinCombo(int id, str key, str name, int count,
    int minPlayers, int weight, int mode, int flags) {
  int result = UH_ComboDefine(id, key, name, count, minPlayers, weight, mode, flags);
  if (result == UH_COMBO_FAIL) {
    UH_Log(UH_LOG_ERROR, StrParam(s:"Built-in boss combo ", i:id,
      s:" (", s:name, s:"; key ", s:key,
      s:") definition failed: invalid arguments, conflicting metadata or registry capacity."));
  }
  return result;
}

// One commit/error path for every built-in. Failed setter staging must never
// commit a draft; the caller accumulates this result without skipping later rows.
function bool UH_CommitBuiltinCombo(int combo, bool ok) {
  if (combo == UH_COMBO_FAIL) return false;  // Definition failure already logged.
  if (ok && UH_ComboCommit(combo)) return true;
  int row = UH_ComboFindId(combo);
  str reason = ok ? UH_ComboShapeErrorText(UH_ComboShapeError(row))
                  : "member or music registration failed";
  UH_Log(UH_LOG_ERROR, StrParam(s:"Built-in boss combo ", i:combo,
    s:" (", s:UH_ComboString(row, UHC_STR_NAME),
    s:") registration failed: ", s:reason, s:"."));
  return false;
}

function void UH_RegisterBuiltinBossCombos(void) {
  int combo;
  bool ok;
  bool complete = true;

  // True Buster Duo
  combo = UH_DefineBuiltinCombo(201, "true_buster_duo", "True Buster Duo",
    2, 4, 10, BOSSCOMBO_MODE_FIXED, 0);
  ok = combo >= 0;
  ok = UH_ComboSetMember(combo, 0, "TrueBusterExpert") & ok;
  ok = UH_ComboSetMember(combo, 1, "TrueBusterMistress") & ok;
  ok = UH_ComboSetMusic(combo, "", "", "", "") & ok;
  complete = UH_CommitBuiltinCombo(combo, ok) & complete;

  // Juggerbro Brothers

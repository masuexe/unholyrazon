// Bonus-event validation and event-state helpers for library unholy.
// This fragment is textually included by uh_funclib.acs.
// Event data lives in the UHDT dynamic table (DefineBonusEvent); these helpers
// read its metadata; appearance history belongs to the round core's world
// array. Validity, eligibility and classification remain database-driven.

// Count actual appearances; the picker reads only and abandoned countdown
// previews never advance history. Forced events count when they start too.
function void CommitBonusEventHistory(int id) {
  if (id < 0 || id >= UH_MAX_BONUS_EVENTS || !IsBonusEventDefined(id))
    return;
  int origin = eventdataarr[EVENTDATA_EXORIGIN] - 1;
  if (origin >= 0 && origin != id) uh_eventfamilyextra[origin]++;
  else {
    // Forced EX appearances belong to the families configured when they start.
    for (int base = 0; base < UH_MAX_BONUS_EVENTS; base++)
      if (base != id && IsBonusEventDefined(base) && GetBonusEventEXTarget(base) == id)
        uh_eventfamilyextra[base]++;
  }
  eventdataarr[EVENTDATA_EXORIGIN] = 0;
  int old = uh_eventpickcount[id];
  uh_eventpickcount[id] = old + 1;
  UH_Log(UH_LOG_DEBUG, StrParam(s:"Bonus event pick count ", s:GetBonusEventName(id),
    s:" (id ", i:id, s:"): ", i:old, s:" -> ", i:old + 1));
}

// An EX upgrade is an appearance of its base family as well: otherwise an
// upgraded draw would leave the base artificially below the other candidates.
function int GetBonusEventFamilyPickCount(int id) {
  return uh_eventpickcount[id] + uh_eventfamilyextra[id];
}

// Boss-style least-seen selection, preserving UHDT eligibility and using the
// registered weights only to break ties. Retry without the last-event
// exclusion only if it leaves no eligible candidate, as PickBonusEvent does.
function int PickLeastSeenBonusEvent(int plccount, int excludedid) {
  for (int pass = 0; pass < 2; pass++) {
    int best = UHBE_FAIL;
    int bestcount = 0;
    int sum = 0;
    for (int id = 0; id < UH_MAX_BONUS_EVENTS; id++) {
      if (!UH_BonusEligible(id, plccount, excludedid))
        continue;
      int count = GetBonusEventFamilyPickCount(id);
      int weight = GetBonusEventWeight(id);
      if (best == UHBE_FAIL || count < bestcount) {
        best = id;
        bestcount = count;
        sum = weight;
      }
      else if (count == bestcount) {
        sum += weight;
        // Weighted reservoir sampling among the least-seen rows.
        if (random(1, sum) <= weight)
          best = id;
      }
    }
    if (best != UHBE_FAIL)
      return best;
    excludedid = -1;
  }
  return UHBE_FAIL;
}

// Host policies apply when the next random event is selected. Pickers preserve
// their single-candidate retry and eligibility rules in either strategy.
function int PickConfiguredBonusEvent(int plccount, int excludedid) {
  if (!GetCVar("uh_sv_bonusavoidrepeat")) excludedid = -1;
  if (GetBonusEventSelectionMode() == 1)
    return PickBonusEvent(plccount, excludedid);
  return PickLeastSeenBonusEvent(plccount, excludedid);
}

// EX counter tick: called after a RANDOM pick only (forced events bypass it).
// The counter stays in the world array (per base event id, survives map
// changes); UHDT resolves the relation and the live host threshold.
function int ExEventChecker(int inputevent) {
  SyncBonusEventEXProgress(inputevent);
  int exid = ResolveBonusEventEX(inputevent);
  if (exid == UHBE_FAIL) {
    return inputevent;
  }
  int threshold = GetBonusEventEXThreshold(inputevent);
  // A disabled upgrade neither consumes nor advances the existing progress.
  if (threshold <= 0) {return inputevent;}
  // Pause even before the upgrade is due. Do not consume or advance progress.
  if (GetCVar("uh_sv_bonusexplayerlimits") &&
      !BonusEventMeetsPlayerLimits(exid, PlayerCount())) return inputevent;
  if (eventexcountarray[inputevent] >= threshold) {
    eventexcountarray[inputevent] = 0;
    return exid;
  }
  eventexcountarray[inputevent] += 1;
  return inputevent;
}

// Map Razon3's forced-event input ids to the frozen v4 canonical ids.
// Legacy input alias — do not add new numeric aliases; identity is the stem.
function int NormalizeForcedBonusEvent(int eventid) {
  if (eventid == 50) {return UHEVENT_FOOTBALL;}
  if (eventid == 150) {return UHEVENT_RUNES;}
  return eventid;
}

// Returns a registered bonus event id, or -1 on failure.
function int ResolveForcedBonusEvent(int eventid) {
  int normalized = NormalizeForcedBonusEvent(eventid);
  if (IsBonusEventDefined(normalized) && GetBonusEventMode(normalized) != UH_ER_DISABLED) {
    if (GetCVar("uh_sv_bonusforcedplayerlimits") &&
        !BonusEventMeetsPlayerLimits(normalized, PlayerCount())) return -1;
    return normalized;
  }
  return -1;
}

function void LogForcedBonusEventRejection(int eventid, str source) {
  int id = NormalizeForcedBonusEvent(eventid);
  if (IsBonusEventDefined(id) && GetBonusEventMode(id) != UH_ER_DISABLED &&
      GetCVar("uh_sv_bonusforcedplayerlimits") && !BonusEventMeetsPlayerLimits(id, PlayerCount())) {
    UH_Log(UH_LOG_WARN, StrParam(s:"Forced Bonus Event rejected (", s:source, s:"): ",
      s:GetBonusEventStem(id), s:"; players=", i:PlayerCount(),
      s:" minplayers=", i:GetBonusEventMinPlayers(id),
      s:" maxplayers=", i:GetBonusEventMaxPlayers(id), s:" (0 means no maximum)."));
    return;
  }
  UH_Log(UH_LOG_WARN, StrParam(s:"Invalid or disabled forced Bonus Event (", s:source, s:"): ", i:eventid));
}

// A selected event must be startable.  Anything else (unregistered id, or a
// registered row without a start callback — e.g. a weight-0 addon entry forced
// via RCON) degrades to the registered Free For All row so the round never
// mixes one event's behaviour with another's database row.  Last-event state
// is synced to what will actually run.
function int UH_ResolveStartableBonusEvent(int eventid) {
  str cb = "";
  if (IsBonusEventDefined(eventid)) {
    cb = GetBonusEventStartCallback(eventid);
  }
  if (StrCmp(cb, "") != 0) {
    if (CheckScript(cb, true)) {
      return eventid;
    }
    UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event ", i:eventid, s:" start callback does not exist: ", s:cb));
  }
  else {
    UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event ", i:eventid, s:" is not startable (no start callback); falling back to the registered Free For All entry."));
  }
  eventdataarr[EVENTDATA_LASTEVENT] = UHEVENT_FFA;
  // Do not defeat a host disable through the historical FFA safety fallback.
  if (GetBonusEventMode(UHEVENT_FFA) == UH_ER_DISABLED) return UHBE_FAIL;
  return UHEVENT_FFA;
}

// D0 guard: surface missing event/eye metadata only in debug mode.
function void DebugValidateRoundStart(void) {
  int eventid;

  for (eventid = 0; eventid < 256; eventid++) {
    if (!IsBonusEventDefined(eventid)) {continue;}

    if (StrCmp(GetBonusEventStem(eventid), "") != 0
        && FindBonusEventByStem(GetBonusEventStem(eventid)) != eventid) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event stem collision: ", i:eventid));
    }
    if (StrCmp(GetBonusEventName(eventid), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event missing name: ", i:eventid));
    }
    // Force-only rows (weight 0) may legitimately omit music; random rows may
    // not (every pick plays its own track).
    if (GetBonusEventWeight(eventid) >= 1 && StrCmp(GetBonusEventMusic(eventid), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event missing music: ", i:eventid));
    }
    if (GetBonusEventWeight(eventid) >= 1 && StrCmp(GetBonusEventStartCallback(eventid), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Random bonus event missing start callback: ", i:eventid));
    }
    if (StrCmp(GetBonusEventStartCallback(eventid), "") != 0 && !CheckScript(GetBonusEventStartCallback(eventid), true)) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event start callback missing: ", s:GetBonusEventStartCallback(eventid)));
    }
    if (StrCmp(GetBonusEventRebuildCallback(eventid), "") != 0 && !CheckScript(GetBonusEventRebuildCallback(eventid), true)) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event rebuild callback missing: ", s:GetBonusEventRebuildCallback(eventid)));
    }
    // The all-eye start callback receives an eye id, not an event id.
    // These differ for Typhoon (event 16, eye 13). Verify the mapping so a
    // selectable event cannot silently spawn "_MoolaGiver" with no prefix.
    if (!StrICmp(GetBonusEventStartCallback(eventid), "ub_DemoneyeEvent") &&
        StrCmp(GetEyeEventStem(GetBonusEventArg1(eventid)), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event ", i:eventid,
        s:" has no eye morph stem for start eye id ", i:GetBonusEventArg1(eventid)));
    }
    if (GetBonusEventEXThreshold(eventid) > 0 && ResolveBonusEventEX(eventid) == UHBE_FAIL) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event EX target missing: ", i:eventid));
    }
  }

  for (int eyeid = 0; eyeid < 16; eyeid++) {
    if (IsEyeDefined(eyeid) && StrCmp(GetEyeEventStem(eyeid), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Eye event stem missing: ", i:eyeid));
    }
  }

  // D0 round-start validation: every combo must have a safely expandable
  // shape, and every boss referenced by a valid combo must be registered.
  // Reports combo ID, name, and the concrete reason so a broken combo table
  // surfaces deterministically here instead of at selection time.  The same
  // BossComboShapeError helper is used by PickBossCombo / TryBossComboRoll, so
  // the debug report and the runtime rejection cannot drift.
  for (int combo = 0; combo < UH_ComboCount(); combo++) {
    int shapeerr = BossComboShapeError(combo);
    if (shapeerr != BOSSCOMBO_SHAPE_OK) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Boss combo ", i:UH_ComboInt(combo, UHC_INT_ID),
                        s:" (", s:UH_ComboString(combo, UHC_STR_NAME),
                        s:") malformed: ", s:BossComboShapeErrorText(shapeerr)));
      continue;
    }
    if (!UH_ComboAvailable(combo)) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Boss combo ", i:UH_ComboInt(combo, UHC_INT_ID),
        s:" was never committed."));
      continue;
    }
    for (int slot = 0; slot < UH_ComboInt(combo, UHC_INT_MEMBERS); slot++) {
      int bossid = UH_ComboMemberId(combo, slot);
      if (!IsBossDefined(bossid)) {
        UH_Log(UH_LOG_ERROR, StrParam(s:"Boss combo ", i:UH_ComboInt(combo, UHC_INT_ID),
                          s:" (", s:UH_ComboString(combo, UHC_STR_NAME),
                          s:") references unregistered boss actor ", s:UH_ComboMemberActor(combo, slot)));
      }
    }
  }
}

function bool IsAllEyeEvent(void) {
  return isbonuseventactive
    && (GetBonusEventFlags(eventdataarr[EVENTDATA_MAINEVENT]) & UHBE_FLAG_ALL_EYE) != 0;
}

function bool HasEyeTeamEvent(void) {
  return (GetBonusEventFlags(eventdataarr[EVENTDATA_MAINEVENT]) & UHBE_FLAG_EYE_TEAM) != 0;
}

function bool IsDemoneyeEvent(void) {
  return isbonuseventactive && HasEyeTeamEvent();
}

// A target change starts a new EX sequence. Count/mode changes only pause it.
// Compare stem identities, not addon ids that can change with registration order.
function void SyncBonusEventEXProgress(int base) {
  if (!IsBonusEventDefined(base)) return;
  int target = GetBonusEventEXTarget(base);
  str stem = "-";
  if (target != UHBE_FAIL) stem = GetBonusEventStem(target);
  if (uh_eventextargetknown[base] && StrICmp(uh_eventextargetseen[base], stem))
    eventexcountarray[base] = 0;
  uh_eventextargetseen[base] = StrParam(s:stem);
  uh_eventextargetknown[base] = true;
}

function void consoleCommandWithWarn(str command, str warning) {
	consoleCommand(command);
	Log(s: "\ci[Unholy] Warning: ", s: warning, s: " (", s: command, s: ")");
}

function void debugLog(str message) {
	if (Debug_TXT) {
		Log(s: "\ca[Unholy] Debug: ", s: message);
	}
}

function void showMeTheRCON(str Var, int Num){
	SetFont("fakefntC");//SMALLFONT
	HudMessageBold(s:"\c[MenuYellow]RCON set ",s:Var,s:" to ",i:Num; HUDMSG_LOG, 447266, CR_WHITE,0.99, 0.99, 6.0);//0.06 0.70
}

//This gathers a CVAR info, resets to NUM, and returns it.
function int checkClearCvar(str Check, int Num)
{
int Checked = GetCVAR(Check);
if(Checked!=Num) {debugLog(strParam(s:"CVAR '",s:Check,s:"' was '",i:Checked,s:"' and was set to '",i:Num,s:"'"));}
SetCVar(Check,Num);
return Checked;
}

//Marks which player numbers are ingame
function void playerLifeStatusArr_GatherFunc (void)
{
	totalPlayersArr[1] = PlayerCount();

	int P_Total = PlayerCount();
	for(int i = 0; i < MAX_PLAYERS; i++){
		if(PlayerInGame(i)){
			debugLog(strParam(s: "Player ", i: i, s: " is alive"));
			playerLifeStatusArr[i] = 1;
			if(P_Total <= 1){
				playerLifeStatusArr[MAX_PLAYERS] = i;
				debugLog(strParam(s: "Done collecting alive players. Max ID = ", i: playerLifeStatusArr[MAX_PLAYERS]));
				break;
			}
			P_Total--;
		}
	}
}
//Updates player status and total players with status
function void playerLifeStatusArr_UpdateFunc (int TheDude, int NewStatus)
{
	totalPlayersArr[playerLifeStatusArr[TheDude]]--;
	playerLifeStatusArr[TheDude] = NewStatus;
	totalPlayersArr[NewStatus]++;
}

//Give/Take Inventory items to/from EVERY ingame player.
function void giveMeTheFunc (str Hungry, int TheBill)
{
	if (TheBill == 0) {TheBill = 1;}

	if (TheBill < 0) {
		for(int i; i < MAX_PLAYERS; i++){
			if(PlayerInGame(i)){TakeActorInventory(i + 1000,Hungry,-TheBill);}
		}
	}
	else {
		for(int j; j < MAX_PLAYERS; j++){
			if(PlayerInGame(j)){GiveActorInventory(j + 1000,Hungry,TheBill);}
		}
	}
}

//Similar to above except it doesn't give/take to/from the specific TID, TheDude.
function void giveMeTheFuncExcept (str H, int XX, int TheDude)
{
	if (XX == 0) {XX = 1;}
	if (XX < 0) {
		for(int i; i < MAX_PLAYERS; i++){
			if(PlayerInGame(i) && i+1000 != TheDude){
				TakeActorInventory(i + 1000,H,-XX);
			}
		}
	}
	else {
		for(int j; j < MAX_PLAYERS; j++){
			if(PlayerInGame(j) && j+1000 != TheDude){
				GiveActorInventory(j + 1000,H,XX);
			}
		}
	}
}

//Similar to above except bosses
function void giveMeTheFuncExceptBosses (str H, int XX)
{
	if (XX == 0) {XX = 1;}
	if (XX < 0) {
		for(int i; i < MAX_PLAYERS; i++){
			if(PlayerInGame(i) && playerLifeStatusArr[i] != PLS_BOSS){
				TakeActorInventory(i + 1000,H,-XX);
			}
		}
	}
	else {
		for(int j; j < MAX_PLAYERS; j++){
			if(PlayerInGame(j) && playerLifeStatusArr[j] != PLS_BOSS){
				GiveActorInventory(j + 1000,H,XX);
			}
		}
	}
}

// Execute the script for each player.
function void ScriptMeTheFunc(str scriptname, int arg1, int arg2, int arg3, int arg4) {
	for (int i = 0; i < ServerMAX; i++) {
		SetActivator(i+1000);
		ACS_NamedExecuteWithResult(scriptname, arg1, arg2, arg3, arg4);
	}
}

function void MakeAllPlayersInvun (void)
{
	int PlayerNum = 1000;
	Until (PlayerNum == 1064) {
		SetActorProperty(PlayerNum,APROP_DamageFactor,0.0);
		PlayerNum++;
	}
}

//Presets a random number for EX Bosses delay
function void bossEXCountArr_Setter(int MaxCount, int Ran1, int Ran2)
{
	for(int i = 0; i < MaxCount; i++){
		BossEXCountArray[i] = random(Ran1,Ran2);
	}
	//debugLog(strParam(s:"BossEXCountArray randomized between values [",i:Ran1,s:"] and [",i:Ran2,s:"]!");}
}

function void presetStrongmanCheck(int Setter, int HowFar)
{
	for(int i = 0; i <= HowFar; i++){
		StrongmanCheck[i] = Setter;
	}
	debugLog(strParam(s: "StrongmanCheck Array set to value ", i: Setter, s: " with a size of ", i: HowFar, s: "."));
}

function void add_StrongmanCheckArray(int TheNum)
{
	for(int i = 0; i <= 99; i++){
		if(StrongmanCheck[i] == -1){
			StrongmanCheck[i] = TheNum;
			debugLog(strParam(s:"StrongmanCheck value [",i:i,s:"] set to ",i:TheNum,s:"."));
			break;
		}
	}
}
function void minus_StrongmanCheckArray (void)
{
	for(int i = 0; i <= 99; i++){
		if(StrongmanCheck[i] != -1){
			StrongmanCheck[i] = StrongmanCheck[i+1];
		}
		else{
			debugLog(strParam(s:"StrongmanCheck shifted over ",i:i,s:" time(s)."));
			break;
		}
	}
}

function void adjustPlayerForceNumArray (int Swapper)
{
	int i;
	Switch(Swapper){
		Case -1://Minus
			for(i = 0; i <= 64; i++){
				if(PlayerForceNum[i] != 0){
					PlayerForceNum[i] = PlayerForceNum[i+1];
				}
				else{
					debugLog(strParam(s:"PlayerForceNum shifted over ",i:i,s:" time(s)."));
					break;
				}
			}
			break;
		Case 0://Reset
			for(i = 0; i <= 64; i++){
					PlayerForceNum[i] = 0;
			}
			debugLog(strParam(s:"Reset all PlayerForceNum to 0."));
			break;
		Default://Add
			for(i = 0; i <= 64; i++){
				if(PlayerForceNum[i] == 0){
					PlayerForceNum[i] = Swapper;
					debugLog(strParam(s:"PlayerForceNum value [",i:i,s:"] set to ",i:Swapper,s:"."));
					break;
				}
			}
			break;
	}
}

//Check and decide what MultiBoss is possible.
function void multiBossFunction(bool Reset)
{
	multiBossCheck = 1;
	int plc = playerCount();
	int svForce = checkClearCvar("uh_sv_MultiBoss", 0);
	if (svForce >= 1 && svForce <= MAX_BOSSES) {
		showMeTheRCON("uh_sv_MultiBoss", svForce);
		while (plc <= svForce+1) {
			svForce--;
		}
		multiBossCheck = svForce;
	}
	else {
		multiBossCheck = random(1, max(plc / 4, 1));
	}

	for(int i = 0; i < MultiBossCheck; i++){
		bossSlotAlive[i] = true;
	}
	debugLog(strParam(s:"multiBossCheck = ",i:multiBossCheck,s:" --- RNG [2][3][4] -> ",i:MultiB_RNG_Arr[2],s:" <> ",i:MultiB_RNG_Arr[3],s:" <> ",i:MultiB_RNG_Arr[4]));
}

//This checks for specific CVAR numbers for boss selection and returns the BossNum if it matches the check
function int forceBossChange(str Force, bool TrueRandom)
{
	int BossNum = GetCVAR(Force);
//if(!GetCVAR("UH_NoResetCVars"))
	// UHBOSS_FAIL (-9999) = unset. Do not use -1: that is a valid custom boss id.
	SetCVar(Force, UHBOSS_FAIL);
	if(BossNum != UHBOSS_FAIL && checkBossList(BossNum)) {
		BossNum = BossNum;
		ShowMeTheRCON(StrParam(s:"Boss ",s:StrRight(Force,1)),BossNum);
	}
	else {
		if(TrueRandom || BossNum == -666){BossNum = trueRandomBoss();}
		else{BossNum = UHBOSS_FAIL;}
	}

	return BossNum;
}

//Check if Boss # is even in the list
function bool checkBossList (int CheckMe)
{
	return IsBossDefined(CheckMe);
}
function int exEventChecker(int InputEvent)
{
	if(CheckEventList(InputEvent+100)) {
		if (EventEXCountArray[InputEvent] >= 3){
			EventEXCountArray[InputEvent] = 0;
			InputEvent += 100;
		}
		else{
			EventEXCountArray[InputEvent] += 1;
		}
	}
	return InputEvent;
}
function bool checkEventList (int CheckMe)
{
	bool Result = true;
	//Checks the Event String, if its nothing, it defaults to Invalid
	if(StrCmp(BonusEventList[CheckMe][1],"Invalid") == 0 || CheckMe < 0 || CheckMe > 200){
		Result = false;
	}
	return Result;
}

//NEW#BOSS — pool-based pick (no BOSSRNGMAX holes)
function int trueRandomBoss(void)
{
	int RNGPick;
	if (randomPercent(5))
		RNGPick = RandomBossFromPool(UHBOSS_POOL_ULTRA);
	else if (randomPercent(1))
		RNGPick = RandomBossFromPool(UHBOSS_POOL_SPECIAL);
	else if (randomPercent(15))
		RNGPick = RandomBossFromPool(UHBOSS_POOL_EX);
	else if (randomPercent(30))
		RNGPick = RandomBossFromPool(UHBOSS_POOL_RARE);
	else
		RNGPick = RandomBossFromPool(UHBOSS_POOL_COMMON);

	if (RNGPick == UHBOSS_FAIL || !IsBossDefined(RNGPick))
		RNGPick = RandomBossFromPool(UHBOSS_POOL_COMMON);
	if (RNGPick == UHBOSS_FAIL || !IsBossDefined(RNGPick))
		RNGPick = 0;
	return RNGPick;
}


//Select Bosses
function void setUpBossSelection_Func (void)
{
	int tempBoss;
	for (int i = 0; i < multiBossCheck; i++) {
		tempBoss = forceBossChange(strParam(s: "uh_sv_ForcedBoss", i: i+1), false);
		if (IsBossDefined(tempBoss)) {
			bossDataArr[i][BOSSDATA_NUM] = TempBoss;
		}
		else {
			bossDataArr[i][BOSSDATA_NUM] = trueRandomBoss();
		}

		if(TempBoss == 300 || ShadowTricksArr[i]){
			ShadowTricksArr[i] = true;
			shadowFakeoutActive = true;
			BossDataArr[i][BOSSDATA_NUM] = TrueRandomBoss();
		}
		else
			BossDataArr[i][BOSSDATA_NUM] = BossDataArr[i][BOSSDATA_NUM]; //EXBossChecker

		debugLog(strParam(s: "UnholyBoss", i: i+1, s: " = ", i: bossDataArr[i][BOSSDATA_NUM]));
	}
	//debugLog(strParam(s:"DEBUG TXT: RareBossChance = ",d:RareBossChance);}

}

//Assigns players as Bosses
function void setUpPlayerSelection_Func (void)
{
	int tempPlayer = 0;
	for (int i = 0; i < multiBossCheck; i++) {
		tempPlayer = checkClearCvar(strParam(s: "uh_sv_ForceBossPlayer", i: i+1), -1);
		if (tempPlayer >= 0 && tempPlayer <= MAX_PLAYERS) {
			tempPlayer += 1000;
		}
		if(PlayerPickCheck(TempPlayer,i)) { //If above check isn't -1, is a player number, and is in the game
			bossDataArr[i][BOSSDATA_TID] = tempPlayer;
			showMeTheRCON(StrParam(s: "Boss-Forced Player ", i: i+1), tempPlayer);
		}
		else if(playerPickCheck(PlayerForceNum[0],i)) {//Check if scripts wants a player
			BossDataArr[i][BOSSDATA_TID] = PlayerForceNum[0];
			adjustPlayerForceNumArray(-1);
		}
		else {//If above never happens, RNG a player as boss
			BossDataArr[i][BOSSDATA_TID] = rngPickCheck(i);
		}
		tempPlayer = bossDataArr[i][BOSSDATA_TID];
		GiveActorInventory(TempPlayer,"Is_UH_BossNum",i+1);//Basic flag to track who is what boss
		If(ShadowTricksArr[i]){
			GiveActorInventory(TempPlayer,"IsGonnaBeFake",1);//Specifically for Shadow boss
		}
		debugLog(strParam(s: "Boss ", i: i+1, s: " TID = ", i: tempPlayer));
		playerLifeStatusArr[tempPlayer-1000] = PLS_BOSS;
	}
}

//Randomly pick a player, if they are not ingame or are in use TID's, pick another random player.
function int rngPickCheck(int PastCheck)
{
	int Check;
	do {
		Check = random(1000, playerLifeStatusArr[MAX_PLAYERS]+1000);//1063
	} while(!PlayerInGame(Check-1000) || CheckActorInventory(Check,"IsDead") ||
			!checkBossDataTIDFunc(Check,PastCheck));

	return Check;
}
//One time check similar to above.
function bool playerPickCheck(int TID, int PastCheck)
{
	if(TID < 1){
		return false;
	}
	else if(PlayerInGame(TID-1000) && !CheckActorInventory(TID,"IsDead") &&
			TID >= 1000 && TID <= 1063 && checkBossDataTIDFunc(TID,PastCheck)){
		return true;
	}
	return false;
}

//Check if TID matches in use Boss TID
function bool checkBossDataTIDFunc(int TID, int PastCheck)
{
	for(int i = 0; i < PastCheck ;i++){
		if(TID == bossDataArr[i][BOSSDATA_TID]){
			return false;
		}
	}
	return true;
}

function int morphMeFunc(int TID, int Boss, str Flash)
{
	return MorphActor(TID, GetBossActor(Boss), "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, Flash, "");
}
function bool morphActorToBoss(int TID, int Boss, str Flash) {
	if(!SetActivator(TID))
		return false;
	ACS_NamedExecuteWithResult("uh_MorphPreReset");
	bool success = morphMeFunc(TID, Boss, Flash);
	if (!success) return false;
	SetActivator(TID);
	ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
	GiveInventory("BasicBossItem", 1);
	str actor = GetBossActor(Boss);
	if (StrICmp(actor, "KakusaretaSutoka") == 0)
	{
		GiveInventory("KakusaretaSutoka_W", 1);
		GiveInventory("KakusaretaSutoka_W2", 1);
		GiveInventory("KakusaretaSutoka_W3", 1);
		GiveInventory("UnholyPowerLimit_F", 1500);
		GiveInventory("UnholyPowerDisableRazzle_F", 1);
	}
	else if (StrICmp(actor, "ArchArcanist") == 0)
	{
		GiveInventory("ArchArcanist_W", 1);
		GiveInventory("ArchArcanist_W2", 1);
		GiveInventory("ArchArcanist_W3", 1);
		GiveInventory("UnholyPowerLimit_F", 1500);
	}
	else if (StrICmp(actor, "CuttyCut") == 0)
	{
		// ExtraLife once here; Ready may re-enter online
		ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 2, 0); // ELP_NATIVE
	}
	else if (StrICmp(actor, "WarRockStelar") == 0)
	{
		GiveInventory("WarRockStelar_W", 1);
		GiveInventory("WarRockStelar_W2", 1);
		ACS_NamedExecuteWithResult("rz_LowHPWarning", 1);
	}
	else if (StrICmp(actor, "VoidWalker") == 0)
	{
		GiveInventory("VoidWalker_W", 1);
		GiveInventory("VoidWalker_W2", 1);
		GiveInventory("VoidWalker_W3", 1);
		GiveInventory("VoidWalker_W4", 1);
		GiveInventory("VeryFunOrbSpawner", 1);
		GiveInventory("OrbFlagWind", 1);
		GiveInventory("VeryFunOrbItem", 1);
	}
	else if (StrICmp(actor, "SinfulBusterExpert") == 0)
	{
		GiveInventory("SinfulBusterExpert_W1", 1);
		GiveInventory("UnholyPowerLimit_F", 1500);
		ACS_NamedExecuteAlways("rz_SinfulBusterExpertSinWatcher", 0);
	}
	else if (StrICmp(actor, "GBeast") == 0)
	{
		GiveInventory("GBeast_W1", 1);
		GiveInventory("GBeast_W2", 1);
		GiveInventory("GBeast_W3", 1);
		GiveInventory("GBeast_W4", 1);
		GiveInventory("GBeast_W5", 1);
		GiveInventory("GBeast_W6", 1);
		GiveInventory("UnholyPowerLimit_F", 1500);
		ACS_NamedExecuteWithResult("rz_LowHPWarning", 0);
	}
	else if (StrICmp(actor, "FBeast") == 0)
	{
		GiveInventory("FBeast_W1", 1);
		GiveInventory("FBeast_W2", 1);
		GiveInventory("FBeast_W3", 1);
		GiveInventory("FBeast_W4", 1);
		GiveInventory("FBeast_W5", 1);
		GiveInventory("FBeast_W6", 1);
		ACS_NamedExecuteWithResult("rz_LowHPWarning", 0);
		GiveInventory("AirJumpLimit", 3);
	}
	else if (StrICmp(actor, "FinalSampi") == 0)
	{
		GiveInventory("FinalSampi_W1", 1);
		GiveInventory("FinalSampi_W2", 1);
		GiveInventory("FinalSampi_W3", 1);
		GiveInventory("FinalSampi_W4", 1);
		GiveInventory("FinalSampi_W5", 1);
		GiveInventory("FinalSampi_W6", 1);
		GiveInventory("FinalSampi_W7", 1);
		GiveInventory("UnholyPowerLimit_F", 3000);
	}
	int baseHP = GetBossHPBase(Boss);
	if(baseHP > 0)
		ACS_NamedExecuteWithResult("uh_BossMorph", Boss, baseHP, GetBossHPAdd(Boss));
	return true;
}

//Light functions, names are straight forward.
function void InstantLightChange (int L)
{
	for(int i = 0; i < 256; i++){
		Light_Stop(i);
		Light_ChangeToValue (i, L);
	}
}
function void FadeLightChange (int L, int T)
{
	for(int i = 0; i < 256; i++){
		Light_Stop(i);
		Light_Fade (i, L, T);
	}
}
function void SectorColorChange (int R, int G, int B, int desat)
{
	for(int i = 0; i < 256; i++){
		Sector_SetColor(i, R, G, B, desat);
	}
}
function void VariableLightChange(int L, bool Dir)
{
	if(Dir){//Up
		if(LightLevelTrack < L){LightLevelTrack = L;}
	}
	else{//Down
		if(LightLevelTrack > L){LightLevelTrack = L;}
	}

}

function bool randomPercent(int chance)
{
	return (random(1, 100) <= chance);
}


function bool isDemoneyeEvent(void) {
	if (isbonuseventactive) {
		switch (EventDataArr[EVENTDATA_MAINEVENT]) {
			case 1:
			case 2:
			case 3:
			case 4:
			case 5:
			case 6:
			case 7:
			case 8:
			case 9:
			case 10:
			case 11:
			case 12:
				return true;
		}
	}
	return false;
}

#define RANDRUNE_ALL 0
#define RANDRUNE_COMMON 1
#define RANDRUNE_RARE 2
function int randomRune(int type) {
	switch (type) {
		case 0:
		default:
			return runeOfTheDay[random(0, 11)];
		case 1: //common
			return commonRuneList[random(0, 2)];
		case 2: //rare
			return rareRuneList[random(0, 7)];
	}
	return -1;
}



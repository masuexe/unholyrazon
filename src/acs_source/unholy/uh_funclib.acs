      case 7:
      case 8:
      case 9:
      case 10:
      case 11:
      case 12:
        return true;
    }
  }
  return false;
}

#define RANDRUNE_ALL 0
#define RANDRUNE_COMMON 1
#define RANDRUNE_RARE 2
function int RandomRune(int type) {
  switch (type) {
    case 0:
    default:
      return rune_of_the_day[random(0, 11)];
    case 1:  // common
      return common_rune_list[random(0, 2)];
    case 2:  // rare
      return rare_rune_list[random(0, 7)];
  }
  return -1;
}

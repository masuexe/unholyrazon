// Shared function aggregator for the single unholy library.
// Keep this file as the compatibility include used by unholy.acs and rz_debug.acs.
// Portrait data precedes the round helpers because the life-status broadcast
// resolves class -> texture; the table is plain data/functions (no scripts), so
// compiling it into both unholy and rz_debug cannot cause a script-name clash.
#include "../hud/player_portraits.acs"
#include "uh_round_helpers.acs"
#include "uh_boss_combos.acs"
#include "uh_boss_selection_helpers.acs"
#include "uh_event_helpers.acs"
#include "uh_lighting.acs"

// FFFFFFFFFFFF   FFFFFFFFFFFF
// FFFFFFFFFFFF   FFFFFFFFFFFF
// FFFF           FFFF
// FFFF           FFFF
// FFFFFFFF       FFFFFFFF
// FFFFFFFF       FFFFFFFF
// FFFF           FFFF
// FFFF           FFFF
// FFFF           FFFF

function void ConsoleCommandWithWarn(str command, str warning) {
  consoleCommand(command);
  UH_Log(UH_LOG_WARN, StrParam(s:warning, s:" (", s:command, s:")"));
}

function void ShowMeTheRCON(str var, int num) {
  SetFont("fakefntC");  // SMALLFONT
  HudMessageBold(s:"\c[MenuYellow]RCON set ", s:var, s:" to ", i:num; HUDMSG_LOG, 447266, CR_WHITE, 0.99, 0.99, 6.0);  // 0.06 0.70
}

// This gathers a CVAR info, resets to NUM, and returns it.
function int CheckClearCvar(str check, int num) {
  int checked = GetCVAR(check);
  if (checked != num) {UH_Log(UH_LOG_DEBUG, StrParam(s:"CVAR '", s:check, s:"' was '", i:checked, s:"' and was set to '", i:num, s:"'"));}
  SetCVar(check, num);
  return checked;
}

// Read a user CVAR and clamp it to a safe range.
function int GetClampedCvar(str check, int minval, int maxval) {
  int value = GetCVar(check);
  if (value < minval) {value = minval;}
  if (value > maxval) {value = maxval;}
  return value;
}

// Marks which player numbers are ingame
function void PlayerLifeStatusArr_GatherFunc(void) {
  totalplayersarr[1] = PlayerCount();

  int p_total = PlayerCount();
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i)) {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Player ", i:i, s:" is alive"));
      playerlifestatusarr[i] = 1;
      if (p_total <= 1) {
        playerlifestatusarr[MAX_PLAYERS] = i;
        UH_Log(UH_LOG_DEBUG, StrParam(s:"Done collecting alive players. Max ID = ", i:playerlifestatusarr[MAX_PLAYERS]));
        break;
      }
      p_total--;
    }
  }
}
// Updates player status and total players with status
function void PlayerLifeStatusArr_UpdateFunc(int thedude, int newstatus) {
  totalplayersarr[playerlifestatusarr[thedude]]--;
  playerlifestatusarr[thedude] = newstatus;
  totalplayersarr[newstatus]++;
}

// Give/Take Inventory items to/from EVERY ingame player.
function void GiveMeTheFunc(str hungry, int thebill) {
  if (thebill == 0) {thebill = 1;}

  if (thebill < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i)) {TakeActorInventory(i + 1000, hungry, -thebill);}
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j)) {GiveActorInventory(j + 1000, hungry, thebill);}
    }
  }
}

// Similar to above except it doesn't give/take to/from the specific TID, TheDude.
function void GiveMeTheFuncExcept(str h, int xx, int thedude) {
  if (xx == 0) {xx = 1;}
  if (xx < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i) && i + 1000 != thedude) {
        TakeActorInventory(i + 1000, h, -xx);
      }
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j) && j + 1000 != thedude) {
        GiveActorInventory(j + 1000, h, xx);
      }
    }
  }
}

// Similar to above except bosses
function void GiveMeTheFuncExceptBosses(str h, int xx) {
  if (xx == 0) {xx = 1;}
  if (xx < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i) && playerlifestatusarr[i] != PLS_BOSS) {
        TakeActorInventory(i + 1000, h, -xx);
      }
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j) && playerlifestatusarr[j] != PLS_BOSS) {
        GiveActorInventory(j + 1000, h, xx);
      }
    }
  }
}

// Give/take inventory to/from the boss team.
function void GiveBossesTheFunc(str item, int amount) {
  if (amount == 0) {amount = 1;}
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i) && playerlifestatusarr[i] == PLS_BOSS) {
      GiveActorInventory(i + 1000, item, amount);
    }
  }
}

// Apply a rune mode to the boss team (Bad LMS reverse reward).
function void GiveBossesRune(int mode) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i) && playerlifestatusarr[i] == PLS_BOSS) {
      ACS_NamedExecuteWithResult("uh_runeplayer", i + 1, 1, mode);
    }
  }
}

// Execute the script for each player.
function void ScriptMeTheFunc(str scriptname, int arg1, int arg2, int arg3, int arg4) {
  for (int i = 0; i < ServerMAX; i++) {
    SetActivator(i + 1000);
    ACS_NamedExecuteWithResult(scriptname, arg1, arg2, arg3, arg4);
  }
}

function void MakeAllPlayersInvun(void) {
  int playernum = 1000;
  until (playernum == 1064) {
    SetActorProperty(playernum, APROP_DamageFactor, 0.0);
    playernum++;
  }
}

// Presets a random number for EX Bosses delay
function void BossEXCountArr_Setter(int maxcount, int ran1, int ran2) {
  for (int i = 0; i < maxcount; i++) {
    bossexcountarray[i] = random(ran1, ran2);
  }
  // debugLog(StrParam(s:"BossEXCountArray randomized between values [",i:Ran1,s:"] and [",i:Ran2,s:"]!");}
}

function void PresetStrongmanCheck(int setter, int howfar) {
  for (int i = 0; i <= howfar; i++) {
    strongmancheck[i] = setter;
  }
  UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck Array set to value ", i:setter, s:" with a size of ", i:howfar, s:"."));
}

function void Add_StrongmanCheckArray(int thenum) {
  for (int i = 0; i <= 99; i++) {
    if (strongmancheck[i] == -1) {
      strongmancheck[i] = thenum;
      UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck value [", i:i, s:"] set to ", i:thenum, s:"."));
      break;
    }
  }
}
function void Minus_StrongmanCheckArray(void) {
  for (int i = 0; i < 99; i++) {
    if (strongmancheck[i] != -1) {
      strongmancheck[i] = strongmancheck[i + 1];
    }
    else {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck shifted over ", i:i, s:" time(s)."));
      break;
    }
  }
  strongmancheck[99] = -1;  // Keep the queue tail inside the documented 0-99 range.
}

function void AdjustPlayerForceNumArray(int swapper) {
  int i;
  switch (swapper) {
    case -1:  // Minus
      for (i = 0; i <= 64; i++) {
        if (playerforcenum[i] != 0) {
          playerforcenum[i] = playerforcenum[i + 1];
        }
        else {
          UH_Log(UH_LOG_DEBUG, StrParam(s:"PlayerForceNum shifted over ", i:i, s:" time(s)."));
          break;
        }
      }
      break;
    case 0:  // Reset
      for (i = 0; i <= 64; i++) {
        playerforcenum[i] = 0;
      }
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Reset all PlayerForceNum to 0."));
      break;
    default:  // Add
      for (i = 0; i <= 64; i++) {
        if (playerforcenum[i] == 0) {
          playerforcenum[i] = swapper;
          UH_Log(UH_LOG_DEBUG, StrParam(s:"PlayerForceNum value [", i:i, s:"] set to ", i:swapper, s:"."));
          break;
        }
      }
      break;
  }
}

// Automatic boss count: uniform draw over every count whose player-count
// threshold (the MULTIB_PLAYERLIMIT* constants, the single source of truth)
// is met.  Replaces Razon3's stateful multib_rng_arr pity-roll.
//   plc 7 -> 1 | 8-11 -> 1-2 | 12-15 -> 1-3 | 16-19 -> 1-4 | 20+ -> 1-5
function int AutoBossCountForPlayers(int plc) {
  int maxcount = 1;
  if (plc >= MULTIB_PLAYERLIMIT2) {maxcount = 2;}
  if (plc >= MULTIB_PLAYERLIMIT3) {maxcount = 3;}
  if (plc >= MULTIB_PLAYERLIMIT4) {maxcount = 4;}
  if (plc >= MULTIB_PLAYERLIMIT5) {maxcount = 5;}
  return random(1, maxcount);
}

// Shared boss-count capacity rule: a standard round needs one survivor
// remaining (count + 2 <= players), capped at MAX_BOSSES, at least one boss.
// Both the forced MultiBoss path and D6 combos go through this so the two
// cannot drift.
function int MaxBossCountForPlayers(int plc) {
  int cap = plc - 2;
  if (cap > MAX_BOSSES) {cap = MAX_BOSSES;}
  if (cap < 1) {cap = 1;}
  return cap;
}

// Single authoritative reset for D6 boss-combo state: round start, morph
// fallback, and both normal result endings call this.
function void ResetBossComboState(void) {
  isbosseventactive = false;
  activebosscombo = -1;
  versusfightevent = false;
}

// Semantic combo policy lookup.  Special branches use this instead of
// inferring behavior from a numeric combo-id range.
function bool BossComboHasFlag(int flag) {
  if (activebosscombo < 0 || activebosscombo >= BOSSCOMBO_MAX) {return false;}
  return (bosscombodata[activebosscombo][7] & flag) != 0;
}

function int BossVersusOpponentTID(int tid) {
  if (!versusfightevent || multibosscheck != 2) {return 0;}
  int slot = -1;
  for (int i = 0; i < 2; i++) {
    if (bossdataarr[i][BOSSDATA_TID] == tid) {slot = i;}
  }
  if (slot < 0) {return 0;}
  return bossdataarr[1 - slot][BOSSDATA_TID];
}

// Check and decide what MultiBoss is possible.
function void MultiBossFunction(bool reset) {
  multibosscheck = 1;
  int plc = playerCount();
  int svforce = CheckClearCvar("uh_sv_MultiBoss", 0);
  if (svforce >= 1 && svforce <= MAX_BOSSES) {
    ShowMeTheRCON("uh_sv_MultiBoss", svforce);
    int cap = MaxBossCountForPlayers(plc);
    if (svforce > cap) {svforce = cap;}
    multibosscheck = svforce;
  }
  else {
    multibosscheck = AutoBossCountForPlayers(plc);
  }

  // Safety rails: never exceed the slot array and never consume every player
  // as a boss (one survivor must remain when more than one player is in game).
  if (multibosscheck > MAX_BOSSES) {multibosscheck = MAX_BOSSES;}
  if (plc > 1 && multibosscheck >= plc) {multibosscheck = plc - 1;}
  if (multibosscheck < 1) {multibosscheck = 1;}

  for (int i = 0; i < multibosscheck; i++) {
    bossslotalive[i] = true;
  }
  UH_Log(UH_LOG_DEBUG, StrParam(s:"multiBossCheck = ", i:multibosscheck, s:" (threshold auto pick, plc = ", i:plc, s:")"));
}

// True while any standard boss slot is still alive (no hardcoded slot range).
function bool AnyBossSlotAlive(void) {
  for (int i = 0; i < MAX_BOSSES; i++) {
    if (bossslotalive[i]) {return true;}
  }
  return false;
}

// Vertical row step for persistent boss HUD rows, in fixed pixels.  The
// health/death/rage rows share this 32px portrait spacing, and client
// placement stays independent of the server-side multibosscheck state (map
// variables are not a client's source of truth).
function int BossHudRowStep(void) {
  return 32.0;
}

// Shape validity: can this row be expanded safely?  Unlike registration or
// player-count checks this is a pure table check, shared by selection,
// forced-combo validation and the debug validator so the rules cannot drift.
function int BossComboShapeError(int combo) {
  if (combo < 0 || combo >= BOSSCOMBO_MAX) {return BOSSCOMBO_SHAPE_RANGE;}
  int count = bosscombodata[combo][1];
  int mode = bosscombodata[combo][4];
  int first = bosscombodata[combo][5];
  int slice = bosscombodata[combo][6];
  bool versus = (bosscombodata[combo][7] & BOSSCOMBO_FLAG_VERSUS) != 0;
  if (count < 1 || count > MAX_BOSSES) {return BOSSCOMBO_SHAPE_COUNT;}
  if (mode != BOSSCOMBO_MODE_FIXED && mode != BOSSCOMBO_MODE_POOL &&
      mode != BOSSCOMBO_MODE_FORCED && mode != BOSSCOMBO_MODE_RANDOM_PAIR &&
      mode != BOSSCOMBO_MODE_SHADOW_PAIR && mode != BOSSCOMBO_MODE_ZANKOKUNA_PAIR) {
    return BOSSCOMBO_SHAPE_MODE;
  }
  // Dynamic modes expand at selection time and must use the reserved zero
  // slice.  ApplyBossCombo always writes exactly slots 0 and 1 for them.
  if (mode == BOSSCOMBO_MODE_FORCED || mode == BOSSCOMBO_MODE_RANDOM_PAIR ||
      mode == BOSSCOMBO_MODE_SHADOW_PAIR || mode == BOSSCOMBO_MODE_ZANKOKUNA_PAIR) {
    if (!versus || count != 2 || first != 0 || slice != 0) {
      return BOSSCOMBO_SHAPE_DYNAMIC;
    }
    return BOSSCOMBO_SHAPE_OK;
  }
  if (slice < 1 || first < 0 || first + slice > BOSSCOMBO_BOSSID_COUNT) {return BOSSCOMBO_SHAPE_SLICE;}
  if (mode == BOSSCOMBO_MODE_FIXED && slice < count) {return BOSSCOMBO_SHAPE_FIXEDSLICE;}
  if (versus) {
    if (count != 2 || mode != BOSSCOMBO_MODE_FIXED || slice != 2) {return BOSSCOMBO_SHAPE_VERSUS;}
  }
  return BOSSCOMBO_SHAPE_OK;
}

function bool BossComboShapeValid(int combo) {
  return BossComboShapeError(combo) == BOSSCOMBO_SHAPE_OK;
}

function str BossComboShapeErrorText(int err) {
  switch (err) {
    case BOSSCOMBO_SHAPE_RANGE: return "combo index out of range";
    case BOSSCOMBO_SHAPE_COUNT: return "boss count must be 1..MAX_BOSSES";
    case BOSSCOMBO_SHAPE_SLICE: return "boss-id slice out of bosscombobossids";
    case BOSSCOMBO_SHAPE_FIXEDSLICE: return "fixed mode needs slice count >= boss count";
    case BOSSCOMBO_SHAPE_VERSUS: return "versus needs exactly 2 fixed slots";
    case BOSSCOMBO_SHAPE_MODE: return "unknown combo mode";
    case BOSSCOMBO_SHAPE_DYNAMIC: return "dynamic mode needs versus, 2 slots, first 0 and slice 0";
  }
  return "unknown shape error";
}

// D6: every boss id referenced by the combo table must still be registered,
// otherwise the combo is rejected for the round (invalid combos fall back to
// the normal roll).  The bounds guard keeps a malformed row from reading past
// bosscombobossids before BossComboShapeError gets a chance to report it.
function bool BossComboFullyRegistered(int combo) {
  if (combo < 0 || combo >= BOSSCOMBO_MAX) {return false;}
  if (!BossComboShapeValid(combo)) {return false;}
  int mode = bosscombodata[combo][4];
  // Dynamic modes resolve their ids at selection time; ApplyBossCombo owns
  // their registration and eligibility validation, so the table has no ids
  // to check here after its reserved zero slice passed shape validation.
  if (mode == BOSSCOMBO_MODE_FORCED || mode == BOSSCOMBO_MODE_RANDOM_PAIR ||
      mode == BOSSCOMBO_MODE_SHADOW_PAIR || mode == BOSSCOMBO_MODE_ZANKOKUNA_PAIR) {
    return true;
  }
  int first = bosscombodata[combo][5];
  int slice = bosscombodata[combo][6];
  if (slice < 1 || first < 0 || first + slice > BOSSCOMBO_BOSSID_COUNT) {return false;}
  for (int i = 0; i < slice; i++) {
    if (!IsBossDefined(bosscombobossids[first + i])) {return false;}
  }
  return true;
}

// True once every combo slice passes BossComboFullyRegistered.  The UHDT boss
// registry is repopulated by uh_bossdefs' OPEN script in the same tic as
// ub_StartUpSettings, so round-start validation waits on this instead of
// assuming registration already finished.  Checking boss 0 alone is not
// enough: the table's first entry can be ready while the rest are not.
function bool BossComboRegistryReady(void) {
  for (int combo = 0; combo < BOSSCOMBO_MAX; combo++) {
    if (!BossComboFullyRegistered(combo)) {return false;}
  }
  return true;
}

// V4: only bosses with a reviewed versus path may enter a boss-vs-boss duel.
// This is an allowlist, not a blacklist: unreviewed future/custom ids remain
// rejected until their damage, watcher and round-ending behavior is audited.
function bool BossVersusEligible(int id) {
  if (!IsBossDefined(id)) {return false;}
  switch (id) {
    case 4:  // Colonel Kachidonga
    case 6:  // Officer Johnson
    case 9:  // Captain DevilEye
    case 13:  // Dickster Dick
    case 33:  // Red Baron Duo
    case 34:  // Blue Jay Duo
    case 52:  // Harp Strumm
    case 55:  // Crazed Grenademan
    case 66:  // Super Megaman
    case 67:  // Lin
    case 69:  // KFC Dragon 756
    case 113:  // Scrotoman
    case 118:  // Sakiko Togawa
    case 302:  // RichDevilEye
    case 513:  // Prickster Prick
    case 616:  // Blue Elephant
      return true;
  }
  return false;
}

// Reservoir-sample one versus-eligible boss so no fixed candidate array is
// needed.  Passing the first result as avoid makes the second sample distinct;
// if the registry has fewer than two eligible bosses, the caller rejects.
function int PickRandomVersusBoss(int avoid) {
  int pick = UHBOSS_FAIL;
  int seen = 0;
  for (int rarity = UHBOSS_POOL_COMMON; rarity < UHBOSS_POOL_COUNT; rarity++) {
    int pooln = GetBossPoolCount(rarity);
    for (int i = 0; i < pooln; i++) {
      int id = GetBossPoolId(rarity, i);
      if (id == avoid) {continue;}
      if (!BossVersusEligible(id)) {continue;}
      seen++;
      if (random(1, seen) == 1) {pick = id;}
    }
  }
  return pick;
}

// Special versus branches have their own positive allowlist.  These bosses
// are not admitted to ordinary 209 random duels because their arena scripts
// need the dedicated Zankokuna policy below.
function bool BossZankokunaVersusEligible(int id) {
  if (!IsBossDefined(id)) {return false;}
  switch (id) {
    case 65:  // Arena Demoneye
    case 300:  // Fox Demoneye
    case 400:  // Zankokuna Hellbot
    case 401:  // Eyelento Major
    case 402:  // Final Sampi
    case 403:  // Higlur
      return true;
  }
  return false;
}

function bool BossZankokunaPrimaryEligible(int id) {
  return id == 300 || id == 400;
}

function int PickZankokunaVersusBoss(int avoid) {
  for (int attempt = 0; attempt < 32; attempt++) {
    int pick;
    switch (random(0, 5)) {
      case 0: pick = 65; break;
      case 1: pick = 300; break;
      case 2: pick = 400; break;
      case 3: pick = 401; break;
      case 4: pick = 402; break;
      default: pick = 403; break;
    }
    if (pick != avoid && BossZankokunaVersusEligible(pick)) {return pick;}
  }
  return UHBOSS_FAIL;
}

function int ResolveConfiguredVersusBoss(str cvar, int avoid) {
  int raw = GetCVAR(cvar);
  int id = ForceBossChange(cvar, false);
  if (raw == UHBOSS_FAIL) {return PickRandomVersusBoss(avoid);}
  if (!BossVersusEligible(id) || id == avoid) {return UHBOSS_FAIL;}
  return id;
}

function int ResolveConfiguredZankokunaBoss(str cvar, int avoid) {
  int raw = GetCVAR(cvar);
  int id = ForceBossChange(cvar, false);
  if (raw == UHBOSS_FAIL) {return PickZankokunaVersusBoss(avoid);}
  if (!BossZankokunaVersusEligible(id) || id == avoid) {return UHBOSS_FAIL;}
  return id;
}

// Shadow-versus overrides use the same reviewed ordinary-versus allowlist as
// the base pair.  This is a side-effect-free peek used before ApplyBossCombo
// consumes the cvars in the Shadow manager.
function int BossShadowOverrideTarget(str cvar, int fallback) {
  int raw = GetCVAR(cvar);
  if (raw != UHBOSS_FAIL && BossVersusEligible(raw)) {return raw;}
  return fallback;
}

function bool BossShadowPairTargetsDistinct(int first, int second) {
  int target0 = BossShadowOverrideTarget("uh_sv_ForcedShadowBoss1", first);
  int target1 = BossShadowOverrideTarget("uh_sv_ForcedShadowBoss2", second);
  return target0 != target1;
}

// Weighted pick among combos matching the rolled boss count, its minimum
// players, a valid shape and full registry integrity.  -1 when nothing
// qualifies.
function int PickBossCombo(int wantcount, int plc) {
  int total = 0;
  int i;
  for (i = 0; i < BOSSCOMBO_MAX; i++) {
    if (bosscombodata[i][1] != wantcount) {continue;}
    if (plc < bosscombodata[i][2]) {continue;}
    if (!BossComboShapeValid(i)) {continue;}
    if (!BossComboFullyRegistered(i)) {continue;}
    total += bosscombodata[i][3];
  }
  if (total <= 0) {return -1;}

  int roll = random(1, total);
  for (i = 0; i < BOSSCOMBO_MAX; i++) {
    if (bosscombodata[i][1] != wantcount) {continue;}
    if (plc < bosscombodata[i][2]) {continue;}
    if (!BossComboShapeValid(i)) {continue;}
    if (!BossComboFullyRegistered(i)) {continue;}
    roll -= bosscombodata[i][3];
    if (roll <= 0) {return i;}
  }
  return -1;
}

// Write the combo into bossdataarr and align the slot bookkeeping.  Only the
// standard selection flow consumes bossdataarr afterwards, so the morph,
// HP HUD, watchers, music and Dickhead revival all keep working unchanged.
// Returns false (and changes nothing) for a malformed row, so a caller that
// forgot to validate cannot half-apply a broken combo.
function bool ApplyBossCombo(int combo) {
  if (combo < 0 || combo >= BOSSCOMBO_MAX) {
    UH_Log(UH_LOG_ERROR, "ApplyBossCombo refused: combo index out of range");
    return false;
  }
  int shapeerr = BossComboShapeError(combo);
  if (shapeerr != BOSSCOMBO_SHAPE_OK) {
    UH_Log(UH_LOG_ERROR, StrParam(s:"ApplyBossCombo refused malformed combo ", i:bosscombodata[combo][0],
                      s:": ", s:BossComboShapeErrorText(shapeerr)));
    return false;
  }
  int count = bosscombodata[combo][1];
  int mode = bosscombodata[combo][4];
  int first = bosscombodata[combo][5];
  int i;
  int s;
  // Resolve dynamic modes before touching any state: a rejected 206/209 or
  // special branch must
  // not clear bossslotalive and break the fallback normal selection.
  int dyn0 = 0;
  int dyn1 = 0;
  if (mode == BOSSCOMBO_MODE_FORCED) {
    dyn0 = ForceBossChange("uh_sv_ForcedBoss1", false);
    dyn1 = ForceBossChange("uh_sv_ForcedBoss2", false);
    if (!BossVersusEligible(dyn0) || !BossVersusEligible(dyn1) || dyn0 == dyn1) {
      UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo 206 rejected: forced pair ", i:dyn0, s:"/", i:dyn1,
                        s:" must be two distinct registered versus-eligible bosses."));
      return false;
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss combo 206 resolved: ", i:dyn0, s:" vs ", i:dyn1));
  }
  else if (mode == BOSSCOMBO_MODE_RANDOM_PAIR) {
    dyn0 = PickRandomVersusBoss(-1);
    dyn1 = PickRandomVersusBoss(dyn0);
    if (dyn0 == UHBOSS_FAIL || dyn1 == UHBOSS_FAIL) {
      UH_Log(UH_LOG_WARN, "Boss combo 209 rejected: fewer than two distinct versus-eligible bosses.");
      return false;
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss combo 209 resolved: ", i:dyn0, s:" vs ", i:dyn1));
  }
  else if (mode == BOSSCOMBO_MODE_SHADOW_PAIR) {
    dyn0 = ResolveConfiguredVersusBoss("uh_sv_ForcedBoss1", -1);
    dyn1 = ResolveConfiguredVersusBoss("uh_sv_ForcedBoss2", dyn0);
    if (dyn0 == UHBOSS_FAIL || dyn1 == UHBOSS_FAIL || dyn0 == dyn1) {
      UH_Log(UH_LOG_WARN, "Boss combo 217 rejected: shadow pair needs two distinct reviewed versus bosses.");
      return false;
    }
    if (!BossShadowPairTargetsDistinct(dyn0, dyn1)) {
      UH_Log(UH_LOG_WARN, "Boss combo 217 rejected: shadow replacement targets must remain distinct.");
      return false;
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss combo 217 resolved: ", i:dyn0, s:" vs ", i:dyn1));
  }
  else if (mode == BOSSCOMBO_MODE_ZANKOKUNA_PAIR) {
    int rawprimary = GetCVAR("uh_sv_ForcedBoss1");
    dyn0 = ResolveConfiguredZankokunaBoss("uh_sv_ForcedBoss1", -1);
    if (dyn0 == UHBOSS_FAIL || !BossZankokunaPrimaryEligible(dyn0)) {
      // This branch is intentionally bounded to the two legacy primary
      // choices; a forced non-primary id is rejected rather than silently
      // broadening the special allowlist.
      if (rawprimary != UHBOSS_FAIL) {
        UH_Log(UH_LOG_WARN, "Boss combo 218 rejected: ForcedBoss1 must be Zankokuna or Fox Demoneye.");
        return false;
      }
      if (random(0, 1)) {dyn0 = 400;}
      else {dyn0 = 300;}
    }
    dyn1 = ResolveConfiguredZankokunaBoss("uh_sv_ForcedBoss2", dyn0);
    if (dyn1 == UHBOSS_FAIL || dyn0 == dyn1) {
      UH_Log(UH_LOG_WARN, "Boss combo 218 rejected: special pair needs two distinct reviewed bosses.");
      return false;
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss combo 218 resolved: ", i:dyn0, s:" vs ", i:dyn1));
  }
  else if ((bosscombodata[combo][7] & BOSSCOMBO_FLAG_VERSUS) != 0 &&
           bosscombobossids[first] == bosscombobossids[first + 1]) {
    UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo ", i:bosscombodata[combo][0],
                      s:" rejected: versus pair contains the same boss twice."));
    return false;
  }
  // Clear every slot first: a forced combo may be smaller than the initially
  // rolled count, and stale alive/shadow/data slots would never be marked
  // dead (the HUD only iterates the new count) and would keep the health
  // watcher running forever.
  for (i = 0; i < MAX_BOSSES; i++) {
    bossslotalive[i] = false;
    shadowtricksarr[i] = false;
    bossdataarr[i][BOSSDATA_TID] = 0;
    bossdataarr[i][BOSSDATA_NUM] = 0;
    bossdataarr[i][BOSSDATA_MORPHED] = 0;
  }
  shadowfakeoutactive = false;
  if (mode == BOSSCOMBO_MODE_FORCED || mode == BOSSCOMBO_MODE_RANDOM_PAIR ||
      mode == BOSSCOMBO_MODE_SHADOW_PAIR || mode == BOSSCOMBO_MODE_ZANKOKUNA_PAIR) {
    bossdataarr[0][BOSSDATA_NUM] = dyn0;
    bossdataarr[1][BOSSDATA_NUM] = dyn1;
  }
  else if (mode == BOSSCOMBO_MODE_POOL) {
    int pooln = bosscombodata[combo][6];
    for (i = 0; i < count; i++) {
      bossdataarr[i][BOSSDATA_NUM] = bosscombobossids[first + random(0, pooln - 1)];
    }
  }
  else {
    for (i = 0; i < count; i++) {
      bossdataarr[i][BOSSDATA_NUM] = bosscombobossids[first + i];
    }
  }
  multibosscheck = count;
  for (s = 0; s < count; s++) {bossslotalive[s] = true;}
  isbosseventactive = true;
  activebosscombo = combo;
  versusfightevent = (bosscombodata[combo][7] & BOSSCOMBO_FLAG_VERSUS) != 0;
  if ((bosscombodata[combo][7] & BOSSCOMBO_FLAG_SHADOW) != 0) {
    shadowtricksarr[0] = true;
    shadowtricksarr[1] = true;
    shadowfakeoutactive = true;
  }
  // Versus 207 mirrors Razon3: the two fixed bosses swap slots at random so
  // neither is always announced on the same side.  The damage rules are
  // symmetric, so this is presentation only.
  if (versusfightevent && count == 2 && random(0, 1)) {
    int swaptmp = bossdataarr[0][BOSSDATA_NUM];
    bossdataarr[0][BOSSDATA_NUM] = bossdataarr[1][BOSSDATA_NUM];
    bossdataarr[1][BOSSDATA_NUM] = swaptmp;
  }
  return true;
}

// D6 pity roll, called from ub_SelectBossAndEvent after MultiBossFunction.
// Returns true when this round is a boss combo (bossdataarr already filled).
function bool TryBossComboRoll(void) {
  int plc = PlayerCount();
  int cap = MaxBossCountForPlayers(plc);

  // A forced combo applies immediately, before any pity logic (the CVAR and
  // menu both say "Force").  Invalid requests log and fall back to ordinary
  // selection without activating the event.
  int forced = CheckClearCvar("uh_sv_BossEventNum", -1);
  if (forced >= 0) {
    for (int i = 0; i < BOSSCOMBO_MAX; i++) {
      if (bosscombodata[i][0] != forced) {continue;}
      int shapeerr = BossComboShapeError(i);
      if (shapeerr != BOSSCOMBO_SHAPE_OK) {
        UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo ", i:forced, s:" rejected: ", s:BossComboShapeErrorText(shapeerr)));
        return false;
      }
      if (bosscombodata[i][1] > cap) {
        UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo ", i:forced, s:" rejected: ", i:bosscombodata[i][1], s:" bosses need ", i:bosscombodata[i][2], s:" players."));
        return false;
      }
      if (!BossComboFullyRegistered(i)) {
        UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo ", i:forced, s:" rejected: unregistered boss."));
        return false;
      }
      if (!ApplyBossCombo(i)) {return false;}
      bosseventcounter = 0;
      ShowMeTheRCON("Boss Combo", forced);
      return true;
    }
    UH_Log(UH_LOG_WARN, StrParam(s:"Boss combo ", i:forced, s:" is not defined; falling back to the normal roll."));
    return false;
  }

  // Forced pity counter (uh_sv_BossEventCounter >= 0 presets the state).
  int bec = CheckClearCvar("uh_sv_BossEventCounter", -1);
  if (bec >= 0) {
    bosseventcounter = bec;
    ShowMeTheRCON("Boss Event Counter", bec);
  }

  // Rounds accumulate pity; random(counter, 20) >= 20 fires (Razon3 rule).
  if (random(bosseventcounter, 20) < 20) {
    bosseventcounter++;
    return false;
  }

  int combo = PickBossCombo(multibosscheck, plc);
  if (combo < 0) {
    // No combo matches this count: retry sooner instead of burning all pity.
    bosseventcounter += 2;
    return false;
  }
  if (!ApplyBossCombo(combo)) {
    bosseventcounter += 2;
    return false;
  }
  bosseventcounter = 0;
  ShowMeTheRCON("Boss Combo", bosscombodata[combo][0]);
  return true;
}

// This checks for specific CVAR numbers for boss selection and returns the BossNum if it matches the check
function int ForceBossChange(str force, bool truerandom) {
  int bossnum = GetCVAR(force);
  // if(!GetCVAR("UH_NoResetCVars"))
  // UHBOSS_FAIL (-9999) = unset. Do not use -1: that is a valid custom boss id.
  SetCVar(force, UHBOSS_FAIL);
  if (bossnum != UHBOSS_FAIL && CheckBossList(bossnum)) {
    bossnum = bossnum;
    ShowMeTheRCON(StrParam(s:"Boss ", s:StrRight(force, 1)), bossnum);
  }
  else {
    if (truerandom || bossnum == -666) {bossnum = TrueRandomBoss();}
    else {bossnum = UHBOSS_FAIL;}
  }

  return bossnum;
}

// Check if Boss # is even in the list
function bool CheckBossList(int checkme) {
  return IsBossDefined(checkme);
}
function int ExEventChecker(int inputevent) {
  if (CheckEventList(inputevent + UHEVENT_EX_OFFSET)) {
    if (eventexcountarray[inputevent] >= 3) {
      eventexcountarray[inputevent] = 0;
      inputevent += UHEVENT_EX_OFFSET;
    }
    else {
      eventexcountarray[inputevent] += 1;
    }
  }
  return inputevent;
}
function bool CheckEventList(int checkme) {
  if (checkme < 0 || checkme >= 200)
    return false;

  // Explicit list of events the dispatcher actually handles.
  switch (checkme) {
    case UHEVENT_FFA:
    case UHEVENT_MLG:
    case UHEVENT_GHOST:
    case UHEVENT_JOUST:
    case UHEVENT_SUMO:
    case UHEVENT_KAMIKAZE:
    case UHEVENT_BOMBER:
    case UHEVENT_BUSINESS:
    case UHEVENT_QUICK:
    case UHEVENT_TANK:
    case UHEVENT_EYEPARADE:
    case UHEVENT_CLONEPARADE:
    case UHEVENT_FOOTBALL:
    case UHEVENT_BRICK:
    case UHEVENT_MOSQUITO:
    case UHEVENT_TYPHOON:
    case UHEVENT_TRUEPOWER:
    case UHEVENT_EYELENTO:
    case UHEVENT_CATCHFURRY:
    case UHEVENT_RUNAWAYFOX:
    case UHEVENT_RUNES:
    case UHEVENT_BOSSEFFA:
    case UHEVENT_SATANSEAL:
      return true;
  }
  return false;
}

// Map Razon3's forced-event input ids to the frozen v4 canonical ids.
function int NormalizeForcedBonusEvent(int eventid) {
  if (eventid == 50) {return UHEVENT_FOOTBALL;}
  if (eventid == 150) {return UHEVENT_RUNES;}
  return eventid;
}

// Returns a canonical, CheckEventList-approved event id, or -1 on failure.
function int ResolveForcedBonusEvent(int eventid) {
  int normalized = NormalizeForcedBonusEvent(eventid);
  if (CheckEventList(normalized)) {
    return normalized;
  }
  return -1;
}

// Explicit random pool: no holes such as the old event 6, and high-player
// rounds may draw the Football slot while low-player rounds use 0-10 only.
function int PickRandomBonusEvent(void) {
  if (PlayerCount() >= MULTIB_PLAYERLIMIT3) {
    return bonuseventcandidates[random(0, BONUS_EVENT_CANDIDATE_COUNT - 1)];
  }
  return bonuseventlowcandidates[random(0, BONUS_EVENT_LOW_COUNT - 1)];
}

// D0 guard: surface missing event/eye metadata only in debug mode.
function void DebugValidateRoundStart(void) {
  if (!debug_txt) {return;}

  for (int i = 0; i < BONUS_EVENT_CANDIDATE_COUNT; i++) {
    int eventid = bonuseventcandidates[i];
    if (StrCmp(bonuseventlist[eventid][BONUS_EVENTNAME], "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event missing name: ", i:eventid));
    }
    if (StrCmp(bonuseventlist[eventid][BONUS_MUSICLUMP], "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Bonus event missing music: ", i:eventid));
    }
  }

  for (int eyeid = 0; eyeid < 16; eyeid++) {
    if (IsEyeDefined(eyeid) && StrCmp(GetEyeEventStem(eyeid), "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Eye event stem missing: ", i:eyeid));
    }
  }

  // D0 round-start validation: every combo must have a safely expandable
  // shape, and every boss referenced by a valid combo must be registered.
  // Reports combo ID, name, and the concrete reason so a broken combo table
  // surfaces deterministically here instead of at selection time.  The same
  // BossComboShapeError helper is used by PickBossCombo / TryBossComboRoll, so
  // the debug report and the runtime rejection cannot drift.
  for (int combo = 0; combo < BOSSCOMBO_MAX; combo++) {
    int shapeerr = BossComboShapeError(combo);
    if (shapeerr != BOSSCOMBO_SHAPE_OK) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Boss combo ", i:bosscombodata[combo][0],
                        s:" (", s:bosscomboname[combo],
                        s:") malformed: ", s:BossComboShapeErrorText(shapeerr)));
      continue;
    }
    for (int slot = 0; slot < bosscombodata[combo][6]; slot++) {
      int bossid = bosscombobossids[bosscombodata[combo][5] + slot];
      if (!IsBossDefined(bossid)) {
        UH_Log(UH_LOG_ERROR, StrParam(s:"Boss combo ", i:bosscombodata[combo][0],
                          s:" (", s:bosscomboname[combo],
                          s:") references unregistered boss ", i:bossid));
      }
    }
  }
}

// NEW#BOSS — pool-based pick (no BOSSRNGMAX holes)
function int TrueRandomBoss(void) {
  int rngpick;
  if (RandomPercent(5))
    rngpick = RandomBossFromPool(UHBOSS_POOL_ULTRA);
  else if (RandomPercent(1))
    rngpick = RandomBossFromPool(UHBOSS_POOL_SPECIAL);
  else if (RandomPercent(15))
    rngpick = RandomBossFromPool(UHBOSS_POOL_EX);
  else if (RandomPercent(30))
    rngpick = RandomBossFromPool(UHBOSS_POOL_RARE);
  else
    rngpick = RandomBossFromPool(UHBOSS_POOL_COMMON);

  if (rngpick == UHBOSS_FAIL || !IsBossDefined(rngpick))
    rngpick = RandomBossFromPool(UHBOSS_POOL_COMMON);
  if (rngpick == UHBOSS_FAIL || !IsBossDefined(rngpick))
    rngpick = 0;
  return rngpick;
}


// Select Bosses
function void SetUpBossSelection_Func(void) {
  int tempboss;
  for (int i = 0; i < multibosscheck; i++) {
    tempboss = ForceBossChange(StrParam(s:"uh_sv_ForcedBoss", i:i + 1), false);
    if (IsBossDefined(tempboss)) {
      bossdataarr[i][BOSSDATA_NUM] = tempboss;
    }
    else {
      bossdataarr[i][BOSSDATA_NUM] = TrueRandomBoss();
    }

    if (tempboss == 300 || shadowtricksarr[i]) {
      shadowtricksarr[i] = true;
      shadowfakeoutactive = true;
      bossdataarr[i][BOSSDATA_NUM] = TrueRandomBoss();
    }
    else
      bossdataarr[i][BOSSDATA_NUM] = bossdataarr[i][BOSSDATA_NUM];  // EXBossChecker

    UH_Log(UH_LOG_DEBUG, StrParam(s:"UnholyBoss", i:i + 1, s:" = ", i:bossdataarr[i][BOSSDATA_NUM]));
  }
  // debugLog(StrParam(s:"DEBUG TXT: RareBossChance = ",d:RareBossChance);}
}

// Assigns players as Bosses
function void SetUpPlayerSelection_Func(bool updateaggregate) {
  int tempplayer = 0;
  for (int i = 0; i < multibosscheck; i++) {
    tempplayer = CheckClearCvar(StrParam(s:"uh_sv_ForceBossPlayer", i:i + 1), -1);
    if (tempplayer >= 0 && tempplayer <= MAX_PLAYERS) {
      tempplayer += 1000;
    }
    if (PlayerPickCheck(tempplayer, i)) {  // If above check isn't -1, is a player number, and is in the game
      bossdataarr[i][BOSSDATA_TID] = tempplayer;
      ShowMeTheRCON(StrParam(s:"Boss-Forced Player ", i:i + 1), tempplayer);
    }
    else if (PlayerPickCheck(playerforcenum[0], i)) {  // Check if scripts wants a player
      bossdataarr[i][BOSSDATA_TID] = playerforcenum[0];
      AdjustPlayerForceNumArray(-1);
    }
    else {  // If above never happens, RNG a player as boss
      bossdataarr[i][BOSSDATA_TID] = RngPickCheck(i);
    }
    tempplayer = bossdataarr[i][BOSSDATA_TID];
    GiveActorInventory(tempplayer, "Is_UH_BossNum", i + 1);  // Basic flag to track who is what boss
    if (shadowtricksarr[i]) {
      GiveActorInventory(tempplayer, "IsGonnaBeFake", 1);  // Specifically for Shadow boss
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss ", i:i + 1, s:" TID = ", i:tempplayer));
    if (updateaggregate && playerlifestatusarr[tempplayer - 1000] == PLS_SURVIVOR) {
      totalplayersarr[PLS_SURVIVOR]--;
      totalplayersarr[PLS_BOSS]++;
    }
    playerlifestatusarr[tempplayer - 1000] = PLS_BOSS;
  }
}

// Randomly pick a player, if they are not ingame or are in use TID's, pick another random player.
function int RngPickCheck(int pastcheck) {
  int check;
  do {
    check = random(1000, playerlifestatusarr[MAX_PLAYERS] + 1000);  // 1063
  } while (!PlayerInGame(check - 1000) || CheckActorInventory(check, "IsDead") ||
      !CheckBossDataTIDFunc(check, pastcheck));

  return check;
}
// One time check similar to above.
function bool PlayerPickCheck(int tid, int pastcheck) {
  if (tid < 1) {
    return false;
  }
  else if (PlayerInGame(tid - 1000) && !CheckActorInventory(tid, "IsDead") &&
      tid >= 1000 && tid <= 1063 && CheckBossDataTIDFunc(tid, pastcheck)) {
    return true;
  }
  return false;
}

// Check if TID matches in use Boss TID
function bool CheckBossDataTIDFunc(int tid, int pastcheck) {
  for (int i = 0; i < pastcheck; i++) {
    if (tid == bossdataarr[i][BOSSDATA_TID]) {
      return false;
    }
  }
  return true;
}

function int MorphMeFunc(int tid, int boss, str flash) {
  return MorphActor(tid, GetBossActor(boss), "", 0x7ffffffd, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, flash, "");
}
function bool MorphActorToBoss(int tid, int boss, str flash) {
  if (!SetActivator(tid))
    return false;
  ACS_NamedExecuteWithResult("uh_MorphPreReset");
  bool success = MorphMeFunc(tid, boss, flash);
  if (!success) return false;
  SetActivator(tid);
  // Record identity/generation before the morph setup starts its watchers, so
  // every watcher captures the generation of this exact morph.  A later
  // UnMorphActor or re-morph bumps it and retires the stale watchers.
  BeginPlayerBossMorph(PlayerNumber(), boss);
  ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
  GiveInventory("BasicBossItem", 1);
  str setup = GetBossMorphSetup(boss);
  if (StrCmp(setup, "") != 0) {
    if (CheckScript(setup, true)) {
      ACS_NamedExecuteWithResult(setup, boss, tid);
    }
    else {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Missing boss morph setup script: ", s:setup));
    }
  }
  int basehp = GetBossHPBase(boss);
  if (basehp > 0)
    ACS_NamedExecuteWithResult("uh_BossMorph", boss, basehp, GetBossHPAdd(boss));
  return true;
}

// Light functions, names are straight forward.
function void InstantLightChange(int l) {
  for (int i = 0; i < 256; i++) {
    Light_Stop(i);
    Light_ChangeToValue(i, l);
  }
}
function void FadeLightChange(int l, int t) {
  for (int i = 0; i < 256; i++) {
    Light_Stop(i);
    Light_Fade(i, l, t);
  }
}
function void SectorColorChange(int r, int g, int b, int desat) {
  for (int i = 0; i < 256; i++) {
    Sector_SetColor(i, r, g, b, desat);
  }
}
function void VariableLightChange(int l, bool dir) {
  if (dir) {  // Up
    if (lightleveltrack < l) {lightleveltrack = l;}
  }
  else {  // Down
    if (lightleveltrack > l) {lightleveltrack = l;}
  }
}

function bool RandomPercent(int chance) {
  return (random(1, 100) <= chance);
}

function void ShuffleRevivalPlayerOrder(void) {
  int i;
  int r;
  int temp;

  for (i = 0; i < MAX_PLAYERS; i++)
    revivalplayerorder[i] = i;
  for (i = 0; i < MAX_PLAYERS; i++) {
    r = Random(0, MAX_PLAYERS - 1);
    temp = revivalplayerorder[i];
    revivalplayerorder[i] = revivalplayerorder[r];
    revivalplayerorder[r] = temp;
  }
}

function void DickheadWatchRemoveAt(int index) {
  dickheadwatchcount--;
  dickheadwatchtid[index] = dickheadwatchtid[dickheadwatchcount];
}

function void DickheadWatchAdd(int tid) {
  if (dickheadwatchcount >= DICKHEAD_WATCH_MAX)
    return;
  dickheadwatchtid[dickheadwatchcount] = tid;
  dickheadwatchcount++;
}

function int DickheadWatchClaim(void) {
  int tid;

  while (dickheadwatchcount > 0) {
    tid = dickheadwatchtid[0];
    DickheadWatchRemoveAt(0);
    if (ClassifyActor(tid) != ACTOR_NONE)
      return tid;
  }
  return 0;
}


function bool IsAllEyeEvent(void) {
  switch (eventdataarr[EVENTDATA_MAINEVENT]) {
    case UHEVENT_MLG:
    case UHEVENT_GHOST:
    case UHEVENT_JOUST:
    case UHEVENT_SUMO:
    case UHEVENT_KAMIKAZE:
    case UHEVENT_BOMBER:
    case UHEVENT_BUSINESS:
    case UHEVENT_QUICK:
    case UHEVENT_TANK:
    case UHEVENT_TYPHOON:
      return isbonuseventactive;
  }
  return false;
}

function bool HasEyeTeamEvent(void) {
  switch (eventdataarr[EVENTDATA_MAINEVENT]) {
    case UHEVENT_MLG:
    case UHEVENT_GHOST:
    case UHEVENT_JOUST:
    case UHEVENT_SUMO:
    case UHEVENT_KAMIKAZE:
    case UHEVENT_RICH:
    case UHEVENT_BOMBER:
    case UHEVENT_BUSINESS:
    case UHEVENT_QUICK:
    case UHEVENT_TANK:
    case UHEVENT_EYEPARADE:
    case UHEVENT_CLONEPARADE:
    case UHEVENT_BRICK:
    case UHEVENT_MOSQUITO:
    case UHEVENT_TYPHOON:
    case UHEVENT_CATCHFURRY:
    case UHEVENT_RUNAWAYFOX:
      return true;
  }
  return false;
}

function bool IsDemoneyeEvent(void) {
  return isbonuseventactive && HasEyeTeamEvent();
}

#define RANDRUNE_ALL 0
#define RANDRUNE_COMMON 1
#define RANDRUNE_RARE 2
function int RandomRune(int type) {
  switch (type) {
    case 0:
    default:
      return random(0, 11);
    case 1:  // common
      return commonrunelist[random(0, 2)];
    case 2:  // rare
      return rarerunelist[random(0, 8)];
  }
  return -1;
}

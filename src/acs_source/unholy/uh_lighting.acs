// Map-wide lighting and sector-color helpers for library unholy.
// This fragment is textually included by uh_funclib.acs.

// Stepped blackout ramp for the round-ending set pieces (Zankokuna rage, Sora no
// Musica).  They must not darken with Light_Fade: Light_Stop addresses sectors by
// tag, and tag 0 - the only way to reach the untagged sectors that make up most
// of an arena - is never registered (p_setup.cpp -> FTagManager::AddSectorTag
// returns early for tag 0), so a fade still running when the set piece is
// cancelled keeps ticking and overwrites the InstantLightChange reset.  Ramping
// with Light_ChangeToValue steps leaves no fade thinker behind, so a cancelled
// set piece stays reset.  35 * 7 = 245 tics of darkening, 30 * 7 = 210 tics of
// final blackout - the durations the former fades used.
#define UH_ARENA_DARK_LIGHT 10
#define UH_ARENA_FADE_STEPS 35
#define UH_ARENA_END_FADE_STEPS 30
#define UH_ARENA_FADE_STEP_TICS 7

// Light functions, names are straight forward.
function void InstantLightChange(int l) {
  for (int i = 0; i < 256; i++) {
    Light_Stop(i);
    Light_ChangeToValue(i, l);
  }
}
function void FadeLightChange(int l, int t) {
  for (int i = 0; i < 256; i++) {
    Light_Stop(i);
    Light_Fade(i, l, t);
  }
}
function void SectorColorChange(int r, int g, int b, int desat) {
  for (int i = 0; i < 256; i++) {
    Sector_SetColor(i, r, g, b, desat);
  }
}
function void VariableLightChange(int l, bool dir) {
  if (dir) {  // Up
    if (lightleveltrack < l) {lightleveltrack = l;}
  }
  else {  // Down
    if (lightleveltrack > l) {lightleveltrack = l;}
  }
}

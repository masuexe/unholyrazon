// Spell card timer + capture bonus (LMS).
// Normal: clear spell-card phase in time, no survivor deaths → bonus.
// Nonspells (1/3/5): timer only — no Bonus!/Failed, no SurvivorBoxItems_P.
// Survival 时符 (W2/W8): boss invuln until timer ends; timeout + no deaths → bonus.
//
// DECORATE / CallACS API:
//   ACS_NamedExecuteAlways("uh_SpellCardStart", 0, phaseId, timeLimitSec)
//   ACS_NamedExecuteAlways("uh_SpellCardCapture", 0)   // force success (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardFail", 0)      // force fail (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardBreak", 0)     // survivor death → mark broken
//   ACS_NamedExecuteAlways("uh_SpellCardResolve", 0, mode) // 0 fail, 1 damage, 2 survival timeout
//   ACS_NamedExecuteAlways("uh_SpellCardStop", 0)
//   ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, toPhase)
//
// Result HUD (Bonus!/Failed) uses a separate id so it can coexist with name/timer.
#define UH_SC_HUD_NAME 1720
#define UH_SC_HUD_TIMER 1721
#define UH_SC_HUD_RESULT 1722

#define UH_SC_PHASE_MAX 8
#define UH_SC_TICRATE 35

#define UH_SC_RESOLVE_FAIL 0
#define UH_SC_RESOLVE_DAMAGE 1
#define UH_SC_RESOLVE_SURVIVAL 2

bool uh_spell_card_active;
bool uh_spell_card_broken;
int uh_spell_card_time_left;
int uh_spell_card_phase;
int uh_spell_card_timer_gen;  // bump on each Start; stale Always timers must not tick

str uh_spell_card_name_list[UH_SC_PHASE_MAX + 1] = {
	"",
	"",  // Nonspell 1 — no name HUD
	"Hell Sign: Eclipse of Hell",
	"",  // Nonspell 2
	"Hell Sign: Star and Stripe",
	"",  // Nonspell 3
	"Hellfire: Infernal Essence of Grazing",
	"Inferno: Striped Abyss",
	"Apollo Hoax Theory"
};

function str UhSpellCardNameOf(int phase_id) {
	if (phase_id < 1 || phase_id > UH_SC_PHASE_MAX)
		return "";
	return uh_spell_card_name_list[phase_id];
}

// Named spell cards only (not nonspells 1/3/5)
function bool UhSpellCardShowsName(int phase_id) {
	return(phase_id == 2 || phase_id == 4 || phase_id == 6 || phase_id == 7 || phase_id == 8);
}

// Spell-card bonus stages only — nonspells 1/3/5 never announce or reward
function bool UhSpellCardIsBonusPhase(int phase_id) {
	return UhSpellCardShowsName(phase_id);
}

// LoLK survival spells (时符): W2 Eclipse of Hell, W8 Apollo Hoax
function bool UhSpellCardIsSurvival(int phase_id) {
	return(phase_id == 2 || phase_id == 8);
}

function void UhSpellCardClearHud(void) {
	ClearHudMessageBold(UH_SC_HUD_NAME);
	ClearHudMessageBold(UH_SC_HUD_TIMER);
}

function void UhSpellCardDrawHud(int time_left, int phase_id) {
	int color;

	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	if (UhSpellCardShowsName(phase_id))
		HudMessageBold(s:UhSpellCardNameOf(phase_id); HUDMSG_PLAIN, UH_SC_HUD_NAME, CR_GOLD, 320.4, 36.0, 0);
	else
		ClearHudMessageBold(UH_SC_HUD_NAME);
	if (time_left <= 4)
		color = CR_RED;
	else if (time_left <= 9)
		color = CR_BRICK;
	else
		color = CR_WHITE;
	HudMessageBold(i:time_left; HUDMSG_PLAIN, UH_SC_HUD_TIMER, color, 320.4, 52.0, 0);
}

function void UhSpellCardAnnounceResult(str msg, int color) {
	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	HudMessageBold(s:msg; HUDMSG_FADEOUT, UH_SC_HUD_RESULT, color, 320.4, 72.0, 3.0, 1.0);
}

function void UhSpellCardStopTimer(void) {
	uh_spell_card_active = false;
	uh_spell_card_timer_gen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
}

function void UhSpellCardEndQuiet(void) {
	UhSpellCardStopTimer();
	uh_spell_card_broken = false;
	uh_spell_card_time_left = 0;
	UhSpellCardClearHud();
}

function void UhSpellCardGiveSurvivorBoxes(void) {
	int j;
	for (j = 0; j < MAX_PLAYERS; j++) {
		if (!PlayerInGame(j))
			continue;
		if (player_life_status_arr[j] != PLS_SURVIVOR)
			continue;
		GiveActorInventory(j + 1000, "SurvivorBoxItems_P", 1);
	}
}

// End 时符: drop flag and strip ALL PlayerPropertyInvulnerable stacks.
// core_invulnerableplayer(false) only pops one layer; APROP stays if stacks remain.
function void UhClownpieceClearSurvInv(void) {
	int tid;
	int old;

	old = ActivatorTID();
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (!CheckActorInventory(tid, "ClownpieceSurvivalInvuln_F")
			&& CheckActorInventory(tid, "PlayerPropertyInvulnerable") < 1)
			continue;
		TakeActorInventory(tid, "ClownpieceSurvivalInvuln_F", 1);
		TakeActorInventory(tid, "ClownpiecePhaseInvulnTics", 999);
		TakeActorInventory(tid, "PlayerPropertyInvulnerable", 999);
		SetActivator(tid);
		SetActorProperty(0, APROP_INVULNERABLE, false);
	}
	if (old)
		SetActivator(old);
	else
		SetActivator(0);
}

function void UhSpellCardCaptureSuccess(void) {
	UhSpellCardStopTimer();
	UhSpellCardAnnounceResult("Get Spell Card Bonus!", CR_YELLOW);
	AmbientSound("Touhou/SpellCardGet", 127);
	UhSpellCardGiveSurvivorBoxes();
	AmbientSound("Touhou/SpellCardBonus", 127);
	uh_spell_card_broken = false;
}

// mode: FAIL / DAMAGE (need timeLeft>0) / SURVIVAL timeout (!Broken, ignore time)
// Nonspells (1/3/5): quiet stop only — no Bonus!/Failed announce, no boxes.
function void UhSpellCardTryCaptureOrFail(int mode) {
	if (!uh_spell_card_active && !uh_spell_card_broken)
		return;

	if (!UhSpellCardIsBonusPhase(uh_spell_card_phase)) {
		UhSpellCardStopTimer();
		uh_spell_card_broken = false;
		if (uh_spell_card_phase >= UH_SC_PHASE_MAX)
			UhSpellCardClearHud();
		return;
	}

	if (mode == UH_SC_RESOLVE_SURVIVAL && uh_spell_card_active && !uh_spell_card_broken)
		UhSpellCardCaptureSuccess();
	else if (mode == UH_SC_RESOLVE_DAMAGE && uh_spell_card_active && !uh_spell_card_broken && uh_spell_card_time_left > 0)
		UhSpellCardCaptureSuccess();
	else {
		UhSpellCardStopTimer();
		UhSpellCardAnnounceResult("Bonus Failed...", CR_RED);
		uh_spell_card_broken = false;
	}

	if (uh_spell_card_phase >= UH_SC_PHASE_MAX)
		UhSpellCardClearHud();
}

script "uh_SpellCardStart" (int phase_id, int time_limit_sec) {
	if (phase_id < 1 || phase_id > UH_SC_PHASE_MAX)
		phase_id = 1;
	if (time_limit_sec < 1)
		time_limit_sec = 1;

	if (uh_spell_card_active && phase_id == uh_spell_card_phase)
		terminate;
	if (phase_id < uh_spell_card_phase)
		terminate;

	uh_spell_card_timer_gen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
	UhSpellCardClearHud();

	uh_spell_card_phase = phase_id;
	uh_spell_card_time_left = time_limit_sec;
	uh_spell_card_broken = false;
	uh_spell_card_active = true;

	UhSpellCardDrawHud(uh_spell_card_time_left, uh_spell_card_phase);
	ACS_NamedExecuteAlways("uh_SpellCardTimer", 0, uh_spell_card_timer_gen);
}

script "uh_ClownpieceBroadcastPhase" (int to_phase) {
	if (to_phase < 2 || to_phase > UH_SC_PHASE_MAX)
		terminate;

	// Damage life-break settle (timeout already resolved before calling this)
	UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);

	AmbientSound("Touhou/Cat0", 127);

	str swap_p = StrParam(s:"ClownpieceForceSwap_W", i:to_phase, s:"_P");
	int tid;
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, swap_p, 1);
	}
}

script "uh_ClownpieceSelectW" (int phase) {
	Delay(1);
	if (phase < 1 || phase > UH_SC_PHASE_MAX)
		terminate;
	str wep = StrParam(s:"Clownpiece_W", i:phase);
	if (!CheckInventory(wep))
		terminate;
	SetWeapon(wep);
}

script "uh_SpellCardTimer" (int my_gen) {
	int phase;

	while (uh_spell_card_active && uh_spell_card_time_left > 0) {
		if (my_gen != uh_spell_card_timer_gen)
			terminate;
		UhSpellCardDrawHud(uh_spell_card_time_left, uh_spell_card_phase);
		if (uh_spell_card_time_left <= 9 && uh_spell_card_time_left >= 5)
			AmbientSound("Touhou/Timeout", 127);
		if (uh_spell_card_time_left <= 4)
			AmbientSound("Touhou/Timeout2", 127);
		Delay(UH_SC_TICRATE);
		if (my_gen != uh_spell_card_timer_gen)
			terminate;
		if (!uh_spell_card_active)
			terminate;
		uh_spell_card_time_left--;
	}

	if (uh_spell_card_active && my_gen == uh_spell_card_timer_gen) {
		phase = uh_spell_card_phase;
		if (UhSpellCardIsSurvival(phase))
			UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_SURVIVAL);
		else
			UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);

		UhClownpieceClearSurvInv();

		if (phase >= UH_SC_PHASE_MAX)
			ACS_NamedExecuteAlways("uh_ClownpieceTimeoutKill", 0);
		else
			ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, phase + 1);
	}
}

script "uh_ClownpieceTimeoutKill" (void) {
	int tid;
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, "ClownpieceTimeoutKill_P", 1);
	}
}

script "uh_SpellCardResolve" (int mode) {
	UhSpellCardTryCaptureOrFail(mode);
}

script "uh_SpellCardCapture" (void) {
	if (!uh_spell_card_active)
		terminate;
	if (uh_spell_card_broken || uh_spell_card_time_left <= 0) {
		UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
		terminate;
	}
	UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);
}

script "uh_SpellCardFail" (void) {
	if (!uh_spell_card_active && !uh_spell_card_broken)
		terminate;
	UhSpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
}

script "uh_SpellCardBreak" (void) {
	if (uh_spell_card_active)
		uh_spell_card_broken = true;
}

script "uh_SpellCardStop" (void) {
	UhSpellCardEndQuiet();
}

script "uh_SpellCardIsActive" (void) {
	SetResultValue(uh_spell_card_active);
}

script "uh_SpellCardGetTimeLeft" (void) {
	SetResultValue(uh_spell_card_time_left);
}

// Strip all invuln stacks + APROP (core_invulnerableplayer false only pops one layer)
script "uh_StripInvulnStacks" (void) {
	TakeInventory("PlayerPropertyInvulnerable", 999);
	SetActorProperty(0, APROP_INVULNERABLE, false);
}

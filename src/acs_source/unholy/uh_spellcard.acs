// Spell card timer + announce (Phase 1).
// No score system. Capture reward is an empty hook for later LMS combat rewards.
//
// DECORATE / CallACS API:
//   ACS_NamedExecuteAlways("uh_SpellCardStart", 0, phaseId, timeLimitSec)
//   ACS_NamedExecuteAlways("uh_SpellCardCapture", 0)   // success -> Spell Card Bonus!
//   ACS_NamedExecuteAlways("uh_SpellCardFail", 0)      // fail -> Bonus Failed
//   ACS_NamedExecuteAlways("uh_SpellCardBreak", 0)     // mark broken (Phase 3 death hook)
//   ACS_NamedExecuteAlways("uh_SpellCardStop", 0)      // clear HUD / stop without announce
//   ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, toPhase) // 2..8 shared multi-boss break
//
// Multi-Clownpiece: one shared HUD/timer. Start is idempotent per phase.
// Life break / timer timeout broadcasts ForceSwap so all surviving Clownpieces advance together.
// W8 timeout kills all Clownpieces (no next phase).
#define UH_SC_HUD_NAME 1720
#define UH_SC_HUD_TIMER 1721
#define UH_SC_HUD_RESULT 1722

#define UH_SC_PHASE_MAX 8
#define UH_SC_TICRATE 35

bool uh_SpellCardActive;
bool uh_SpellCardBroken;
int uh_SpellCardTimeLeft;
int uh_SpellCardPhase;
int uh_SpellCardTimerGen; // bump on each Start; stale Always timers must not tick

str uh_SpellCardNameList[UH_SC_PHASE_MAX + 1] = {
	"",
	"", // Nonspell 1 — no name HUD
	"Hell Sign: Eclipse of Hell",
	"", // Nonspell 2
	"Hell Sign: Star and Stripe",
	"", // Nonspell 3
	"Hellfire: Infernal Essence of Grazing",
	"Inferno: Striped Abyss",
	"Apollo Hoax Theory"
};

function str uh_SpellCardNameOf(int phaseId)
{
	if (phaseId < 1 || phaseId > UH_SC_PHASE_MAX)
		return "";
	return uh_SpellCardNameList[phaseId];
}

// Named spell cards only (not nonspells 1/3/5)
function bool uh_SpellCardShowsName(int phaseId)
{
	return (phaseId == 2 || phaseId == 4 || phaseId == 6 || phaseId == 7 || phaseId == 8);
}

function void uh_SpellCardClearHud(void)
{
	ClearHudMessageBold(UH_SC_HUD_NAME);
	ClearHudMessageBold(UH_SC_HUD_TIMER);
}

function void uh_SpellCardDrawHud(int timeLeft, int phaseId)
{
	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	if (uh_SpellCardShowsName(phaseId))
		HudMessageBold(s: uh_SpellCardNameOf(phaseId); HUDMSG_PLAIN, UH_SC_HUD_NAME, CR_GOLD, 320.4, 36.0, 0);
	else
		ClearHudMessageBold(UH_SC_HUD_NAME);
	HudMessageBold(i: timeLeft; HUDMSG_PLAIN, UH_SC_HUD_TIMER, CR_RED + (timeLeft <= 10), 320.4, 52.0, 0);
}

function void uh_SpellCardAnnounceResult(str msg, int color)
{
	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	HudMessageBold(s: msg; HUDMSG_FADEOUT, UH_SC_HUD_RESULT, color, 320.4, 72.0, 3.0, 1.0);
}

function void uh_SpellCardEndQuiet(void)
{
	uh_SpellCardActive = false;
	uh_SpellCardBroken = false;
	uh_SpellCardTimeLeft = 0;
	uh_SpellCardTimerGen++;
	uh_SpellCardClearHud();
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
}

// phaseId 1..8, timeLimitSec >= 1
// Multi-Clownpiece: shared single HUD/timer. Same phase while Active = no-op.
// Only phaseId > uh_SpellCardPhase (or first start) restarts the timer.
script "uh_SpellCardStart" (int phaseId, int timeLimitSec)
{
	if (phaseId < 1 || phaseId > UH_SC_PHASE_MAX)
		phaseId = 1;
	if (timeLimitSec < 1)
		timeLimitSec = 1;

	// Already showing this phase — other Clownpieces Morph/SpellBreak must not reset
	if (uh_SpellCardActive && phaseId == uh_SpellCardPhase)
		terminate;
	// Late Start for an older phase while a newer one is current
	if (phaseId < uh_SpellCardPhase)
		terminate;

	// NamedTerminate is unreliable for Always timers; gen guard stops stale ticks
	uh_SpellCardTimerGen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
	uh_SpellCardClearHud();
	ClearHudMessageBold(UH_SC_HUD_RESULT);

	uh_SpellCardPhase = phaseId;
	uh_SpellCardTimeLeft = timeLimitSec;
	uh_SpellCardBroken = false;
	uh_SpellCardActive = true;

	uh_SpellCardDrawHud(uh_SpellCardTimeLeft, uh_SpellCardPhase);
	ACS_NamedExecuteAlways("uh_SpellCardTimer", 0, uh_SpellCardTimerGen);
}

// Force all surviving Clownpieces still on phase (toPhase-1) onto Clownpiece_WtoPhase.
// Caller already swapped; those with the new weapon are skipped.
// toPhase 2..8. W8 true death never calls this (no ExtraLife → no DoSwapGo).
script "uh_ClownpieceBroadcastPhase" (int toPhase)
{
	if (toPhase < 2 || toPhase > UH_SC_PHASE_MAX)
		terminate;

	AmbientSound("Touhou/Cat0", 127);

	str swapP = StrParam(s: "ClownpieceForceSwap_W", i: toPhase, s: "_P");
	int tid;
	for (tid = 1000; tid <= 1063; tid++)
	{
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, swapP, 1);
	}
}

// After Give/Take of Clownpiece_Wn: A_SelectWeapon same-tic as Take often leaves
// ReadyWeapon empty (timeout ForceSwap). Delay 1 then SetWeapon.
script "uh_ClownpieceSelectW" (int phase)
{
	Delay(1);
	if (phase < 1 || phase > UH_SC_PHASE_MAX)
		terminate;
	str wep = StrParam(s: "Clownpiece_W", i: phase);
	if (!CheckInventory(wep))
		terminate;
	SetWeapon(wep);
}

script "uh_SpellCardTimer" (int myGen)
{
	while (uh_SpellCardActive && uh_SpellCardTimeLeft > 0)
	{
		if (myGen != uh_SpellCardTimerGen)
			terminate;
		if (uh_SpellCardBroken)
		{
			ACS_NamedExecuteAlways("uh_SpellCardFail", 0);
			terminate;
		}
		uh_SpellCardDrawHud(uh_SpellCardTimeLeft, uh_SpellCardPhase);
		// Final 9s: beep each second; at 4s also play Timeout2
		if (uh_SpellCardTimeLeft <= 9 && uh_SpellCardTimeLeft >= 5)
			AmbientSound("Touhou/Timeout", 127);
		if (uh_SpellCardTimeLeft <= 4)
			AmbientSound("Touhou/Timeout2", 127);
		Delay(UH_SC_TICRATE);
		if (myGen != uh_SpellCardTimerGen)
			terminate;
		if (!uh_SpellCardActive)
			terminate;
		uh_SpellCardTimeLeft--;
	}

	// Only the current generation may announce timeout / advance
	if (uh_SpellCardActive && myGen == uh_SpellCardTimerGen)
	{
		uh_SpellCardActive = false;
		uh_SpellCardClearHud();
		uh_SpellCardAnnounceResult("Time Out", CR_DARKGRAY);
		uh_SpellCardBroken = false;
		uh_SpellCardTimeLeft = 0;

		// Advance shared phase: 1..7 -> ForceSwap next Wn; W8 -> die
		if (uh_SpellCardPhase >= UH_SC_PHASE_MAX)
			ACS_NamedExecuteAlways("uh_ClownpieceTimeoutKill", 0);
		else
			ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, uh_SpellCardPhase + 1);
	}
}

// W8 (or desynced) timeout: strip ExtraLife/Buddha and kill every living Clownpiece.
script "uh_ClownpieceTimeoutKill" (void)
{
	int tid;
	for (tid = 1000; tid <= 1063; tid++)
	{
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, "ClownpieceTimeoutKill_P", 1);
	}
}

script "uh_SpellCardCapture" (void)
{
	if (!uh_SpellCardActive)
		terminate;
	if (uh_SpellCardBroken || uh_SpellCardTimeLeft <= 0)
	{
		ACS_NamedExecuteAlways("uh_SpellCardFail", 0);
		terminate;
	}

	uh_SpellCardActive = false;
	uh_SpellCardTimerGen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
	uh_SpellCardClearHud();
	uh_SpellCardAnnounceResult("Get Spell Card Bonus!", CR_YELLOW);
	ACS_NamedExecuteAlways("uh_SpellCardBonusReward", 0);
	uh_SpellCardBroken = false;
	uh_SpellCardTimeLeft = 0;
}

script "uh_SpellCardFail" (void)
{
	if (!uh_SpellCardActive && !uh_SpellCardBroken)
		terminate;

	uh_SpellCardActive = false;
	uh_SpellCardTimerGen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
	uh_SpellCardClearHud();
	uh_SpellCardAnnounceResult("Bonus Failed...", CR_RED);
	uh_SpellCardBroken = false;
	uh_SpellCardTimeLeft = 0;
}

// Mark the current card broken (survivor death). Timer will Fail on next tick.
script "uh_SpellCardBreak" (void)
{
	if (uh_SpellCardActive)
		uh_SpellCardBroken = true;
}

script "uh_SpellCardStop" (void)
{
	uh_SpellCardEndQuiet();
}

// Phase 1: empty. Later: LMS combat reward (never score).
script "uh_SpellCardBonusReward" (void)
{
	terminate;
}

script "uh_SpellCardIsActive" (void)
{
	SetResultValue(uh_SpellCardActive);
}

script "uh_SpellCardGetTimeLeft" (void)
{
	SetResultValue(uh_SpellCardTimeLeft);
}

// Scripts related to boss morphing
script "ub_CountdownStartup" OPEN {
  if (GetCvar("lastmanstanding") == 0) {
    terminate;
  }
  while (PlayerCount() <= 1) {
    Delay(1);
  }


  if (GetGameModeState() == 1 || GetGameModeState() == 0) {

    // ACS_NamedExecute("ub_AttemptSoundFollowFix",0);

    int ued = CheckClearCvar("uh_sv_BonusEventDelay", -1);
    if (ued >= 0 && eventdataarr[EVENTDATA_DELAY] != 77) {  // Sets EventDelay if forced
      eventdataarr[EVENTDATA_DELAY] = ued;
      ShowMeTheRCON("Bonus Event Delay", ued);
    }
    Delay(11);

    if (!GetCVAR("uh_sv_NoItems")) {
      GiveMeTheFunc("SurvivorBoxItems_P", 1);  // Give Pre-Round Items
    }

    SetHudSize(480, 360, 0);
    SetFont("BIGFONT");
    if (eventdataarr[EVENTDATA_DELAY] >= GetClampedCvar("uh_sv_BonusEventLimit", 1, 100)) {
      ACS_NamedExecute("ub_EventManagementACS", 0, -2);
      Delay(20);
      AmbientSound("misc/BonusTime", 127);
      HudMessageBold(s:"\c[MenuYellow]The ", s:bonuseventlist[eventdataarr[EVENTDATA_MAINEVENT]][BONUS_EVENTNAME], s:"\c[MenuYellow] event is about to happen!"; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 36.0, 20.0, 2.0);
    }
    else if (strongmancheck[0] >= 0) {
      HudMessageBold(s:"A powerful foe approaches!"; HUDMSG_FADEOUT, 66, CR_DARKRED, 240.4, 36.0, 20.0, 2.0);
    }
    else {
      HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0, 2.0);
    }

    Delay(20);
    terminate;
  }

  // Delay(5);

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  if (eventdataarr[EVENTDATA_DELAY] < GetClampedCvar("uh_sv_BonusEventLimit", 1, 100) && strongmancheck[0] >= 0) {
    HudMessageBold(s:"A powerful foe approaches!"; HUDMSG_FADEOUT, 66, CR_DARKRED, 240.4, 36.0, 0.5, 2.0);
  }
  else {
    HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 0.5, 2.0);
  }

  SetPlayerProperty(1, 1, 4);
  Delay(35 * 1);
  if (eventdataarr[EVENTDATA_DELAY] >= GetClampedCvar("uh_sv_BonusEventLimit", 1, 100)) {
    ACS_NamedExecute("ub_EventManagementACS", 0, -1);  // Select the event!
  }
  else {
    ACS_NamedExecute("ub_SelectBossAndEvent", 0);  // Select the bosses!
  }
}

// This is a basic countdown timer, lasts X time. After X time, attempt to end the round.
script "uh_BackgroundTimer" (void)  // OPEN
{
  int deathchance = random(1, 4);

  int timeleft = getCVar("uh_sv_gametimer");
  if (timeleft > 0)
    timeleft += 10;
  else
    timeleft = -6;
  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  until (timeleft <= 0 || gameover) {  // Countdown
    // HudMessageBold(d:TimeLeft; HUDMSG_FADEOUT, 888, CR_DARKGREEN,0.5, 0.10, 3.0,2.0);
    // Log(d:TimeLeft);
    if (GetCVar("UE_TimerEnd") != 0) {
      if (GetCVar("UE_TimerEnd") < 0 || GetCVar("UE_TimerEnd") > 4) {
        CheckClearCvar("UE_TimerEnd", 0);
        HudMessageBold(s:"\cf*NOTICE* \ckThe timer was disabled! \cf*NOTICE*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
      }
      timeleft = -6;
      break;
    }
    if (timeleft == 66) {
      HudMessageBold(s:"\cg*WARNING* \crOne minute until time is up! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
    }
    int timertype = getCVar("uh_sv_timertype");
    switch (timertype) {
      case 0:
      default:
        break;
      case 1:
        if (timeleft <= 66) {
          ACS_NamedExecuteWithResult("uh_DrawTimerHud", timeleft, 1);
        }
        break;
      case 2:
        ACS_NamedExecuteWithResult("uh_DrawTimerHud", timeleft, 1);
        break;
    }

    Delay(35);
    timeleft--;
  }
  while (timeleft < 0 && !gameover) {  // If Timer is disabled
    if (GetCVar("UE_TimerEnd") != 0) {
      deathchance = CheckClearCvar("UE_TimerEnd", 0);
      if (deathchance >= 0 && deathchance <= 4) {
        AmbientSound("misc/mmpuwarning", 127);
        HudMessageBold(s:"\cg*WARNING* \crThe round was forced to end! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
        Delay(35 * 6);
        break;
      }
    }
    Delay(35);
  }
  if (gameover) {  // Games over, clear messages
    ClearHudMessageBold(610);
    terminate;
  }
  switch (deathchance) {
    case 1:  // SuperGuhu
      GiveMeTheFunc("SGEXDItem", 1);
      break;
    case 2:  // Zankokuna
      ACS_NamedTerminate("uh_ZankokunaRage", 0);
      ACS_NamedExecute("uh_ZankokunaRage", 0);
      break;
    case 3:  // InstaKill
      SpawnForced("WishingStar_Help1_Server", 0, 0, 0);
      break;
    case 4:  // Exe
      SpawnForced("WishingStar_Help2_Server", 0, 0, 0);
      break;
    case 5:  // Reset
      SpawnForced("WishingStar_Help3_Server", 0, 0, 0);
      break;
  }
}




// Script used to end the round for no survivors
script "ub_WatchSurvivors" (int skipacs) {

  Delay(1);  // Important! Otherwise the BossDataArr[][] isn't set correctly from another script!

  if (!skipacs) {
    ACS_NamedExecute("ub_BossHealthWatcher", 0);
    ACS_NamedExecute("ub_DemoneyeNumWatcher", 0);  // Does this fix Boss VS??
    // Versus duels own their own ending: the two-slot watcher waits on the
    // boss slots and never runs the normal survivor-vs-boss result sequence.
    if (versusfightevent) {
      ACS_NamedExecute("ub_ManageBossVsBossEvent", 0);
      terminate;
    }
    ACS_NamedExecute("ub_WatchBossesAndEyes", 0);
  }

  while (totalplayersarr[PLS_SURVIVOR] >= 1 && !standardlmseventlocked && !gameover) {
    Delay(1);
    if (totalplayersarr[PLS_SURVIVOR] == 1) {
      ACS_NamedExecute("ub_LMS_EventTime", 0, -1);
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Last Man Standing!"));
      standardlmseventlocked = true;
    }
  }

  while (totalplayersarr[PLS_SURVIVOR] >= 1 && !gameover) {
    Delay(1);
  }

  if (gameover) {terminate;}

  Delay(1);

  ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
  // PlayMusic_Loss(0);
  PlayMusic_Loser(-1);
  // MakeAllPlayersInvun();
  gameover = true;
  ResetBossComboState();  // D6: clear combo state for the result sequence.

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);
  HudMessageBold(s:"The survivors have been defeated..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 5.0, 2.0);

  if (winstreak > 0) {winstreak = -1;}
  else {winstreak--;}
  if (winstreak % GetClampedCvar("uh_sv_LoseStreakLimit", 1, 100) == 0 && winstreak < 0) {
    HudMessageBold(s:"We have been defeated too many times!\nLet Helltatoru give you mercy..."; HUDMSG_FADEOUT, 67, CR_DARKRED, 240.4, 108.0, 5.0, 2.0);
    mercygiven = true;
  }
  else {
    mercygiven = false;
  }

  survwinwithlms = false;
  Delay(35 * 9);
  Exit_Normal(0);
  Delay(35 * 6);
}


// Razon3-style limited X-Ray once exactly two players remain alive.
script "rz_WatchTwoPlayerLeft" (void) {
  while (totalplayersarr[PLS_SURVIVOR] + totalplayersarr[PLS_BOSS] + totalplayersarr[PLS_EYE] != 2 || twoplayersxrayenabled) {
    if (gameover) {terminate;}
    Delay(2);
  }
  GiveMeTheFunc("XRayVisionEnableLimited_P", 1);
  twoplayersxrayenabled = true;
}

// Boss streak compensation: five distinct runes per player without MercyFlag.
function void GiveMercyRunesToPlayer(int tid) {
  int pool[12];
  int mi;
  int mr;
  int mt;

  for (mi = 0; mi < 12; mi++) {
    pool[mi] = mi;
  }
  for (mi = 0; mi < 12; mi++) {
    mr = random(mi, 11);
    mt = pool[mi];
    pool[mi] = pool[mr];
    pool[mr] = mt;
  }
  for (mi = 0; mi < 5; mi++) {
    ACS_NamedExecuteWithResult("uh_runeplayer", tid - 999, 1, pool[mi]);
  }
  GiveActorInventory(tid, "MercyFlag", 1);
}

script "rz_MercyRuneGiver" (int tid) {
  if (tid >= 1000 && tid <= 1063) {
    if (playerlifestatusarr[tid - 1000] == PLS_SURVIVOR && !CheckActorInventory(tid, "MercyFlag")) {
      GiveMercyRunesToPlayer(tid);
    }
    terminate;
  }

  for (int pi = 1000; pi < 1064; pi++) {
    if (PlayerInGame(pi - 1000) && playerlifestatusarr[pi - 1000] == PLS_SURVIVOR && !CheckActorInventory(pi, "MercyFlag")) {
      GiveMercyRunesToPlayer(pi);
    }
  }
}

// Reverse rewards for Bad LMS.  The original event id is preserved so each
// vanilla event can punish the last survivor in its own Razon3-style way.
function void GrantBadLMSEventDrops(int tid, int lmsnum) {
  int itemid;
  switch (lmsnum) {
    case 0:
      GiveActorInventory(tid, "AutoSuperGUHUItem", 1);
      break;
    case 1:
      GiveActorInventory(tid, "PowerLMSBadProtection", 1);
      break;
    case 2:
      GiveBossesTheFunc("BadEventBossProtection", 1);
      break;
    case 3:
      break;
    case 4:
      GiveBossesTheFunc("GoldenWaspBombItem", 1);
      break;
    case 5:
      for (itemid = 0; itemid < 256; itemid++) {
        if (IsItemDefined(itemid)) {
          TakeActorInventory(tid, GetItemActor(itemid), 9999);
        }
      }
      itemid = -1;
      while (IsItemDefined(itemid)) {
        TakeActorInventory(tid, GetItemActor(itemid), 9999);
        itemid--;
      }
      break;
    case 6:
      GiveBossesTheFunc("InfiniteRocketItem", 1);
      break;
    case 7:
      GiveBossesTheFunc("PancakeFoodItem", 1);
      GiveBossesTheFunc("CakeFoodItem", 1);
      GiveBossesTheFunc("HotdogFoodItem", 1);
      GiveBossesTheFunc("SundaeFoodItem", 1);
      GiveBossesTheFunc("HamburgerFoodItem", 1);
      break;
    case 8:
      GiveBossesTheFunc("InfiniteRubberBandItem", 1);
      break;
    case 9:
      break;
    case 10:
      GiveActorInventory(tid, "PowerLMSDarkness", 1);
      break;
    case 11:
      GiveActorInventory(tid, "HorseMorphGiver", 1);
      break;
    case 12:
      GiveActorInventory(tid, "LMSBadGuyAppears_P", 1);
      break;
    default:
      GiveActorInventory(tid, "PowerLMSBadProtection", 1);
      GiveActorInventory(tid, "LMSBadGuyAppears_P", 1);
      break;
  }
}

// Checks if all bosses are dead
script "ub_WatchBossesAndEyes" (void) {
  int extratimer = Timer();
  int hellmarklimit = GetClampedCvar("uh_sv_HellMarkLimit", 1, 100);
  int fastkilltime = GetClampedCvar("uh_sv_FastKillTime", 0, 300);
  int battletime;
  while (totalplayersarr[PLS_BOSS] >= 1 || totalplayersarr[PLS_EYE] >= 1) {
    if (gameover) {terminate;}
    Delay(2);
  }

  if (gameover) {terminate;}

  GiveMeTheFunc("PowerProtectSurvivor", -1);
  GiveMeTheFunc("PowerProtectMegaCopywep", -1);
  GiveMeTheFunc("PowerProtectUnholyItem", -1);

  ACS_NamedTerminate("ub_WatchSurvivors", 0);
  gameover = true;
  ResetBossComboState();  // D6: clear combo state for the result sequence.
  // Log(i:PlayerInGame(BossDataArr[0][BOSSDATA_TID]-1000));

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);

  if (multibosscheck == 1 && !PlayerInGame(bossdataarr[0][BOSSDATA_TID] - 1000) && timer() <= 35 * 7 + extratimer) {
    PlayMusic_Win(-2);
    HudMessageBold(s:"The boss has declined the duel!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);
    Delay(36 * 4);
    Exit_Normal(0);
    Delay(35);
    terminate;
  }
  // PlayMusic_Win(0);
  PlayMusic_Winner(-1);
  HudMessageBold(s:"The survivors are victorious!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);

  if (winstreak < 0) {winstreak = 1;}
  else {winstreak++;}
  mercygiven = false;
  if (winstreak % GetClampedCvar("uh_sv_WinStreakLimit", 1, 100) == 0) {
    HudMessageBold(s:"Survivor win streak: ", d:winstreak; HUDMSG_FADEOUT, 67, CR_DARKRED, 240.4, 90.0, 5.0, 2.0);
    ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 1);
  }
  else {
    HudMessageBold(s:"Survivor win streak: ", d:winstreak; HUDMSG_FADEOUT, 67, CR_GREEN, 240.4, 90.0, 5.0, 2.0);
  }

  battletime = (Timer() - extratimer) / 35;

  if (survwinwithlms) {
    hellmarkfrags++;
    if (hellmarkfrags >= hellmarklimit) {
      AmbientSound("misc/SampiRises", 127);
      HudMessageBold(s:"The Helltatoru knows no limits..."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 402);
    }
    else
      HudMessageBold(s:"Marks of Helltatoru ", d:hellmarkfrags, s:"/", d:hellmarklimit, s:" collected."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
  }

  if (fastkilltime > 0 && battletime <= fastkilltime) {
    eventdataarr[EVENTDATA_DELAY] += 1;
    HudMessageBold(s:"Good job! You defeated all bosses in ", d:battletime, s:"s."; HUDMSG_FADEOUT, 100, CR_GOLD, 240.4, 90.0, 5.0, 2.0);
  }
  else {
    HudMessageBold(s:"Battle Time: ", d:battletime, s:"s"; HUDMSG_FADEOUT, 100, CR_GRAY, 240.4, 90.0, 5.0, 2.0);
  }

  if (roundstartsurvivors > 0 && totalplayersarr[PLS_SURVIVOR] == roundstartsurvivors) {
    eventdataarr[EVENTDATA_DELAY] += 2;
    HudMessageBold(s:"PERFECT! No survivors were lost."; HUDMSG_FADEOUT, 101, CR_GREEN, 240.4, 108.0, 5.0, 2.0);
  }

  Delay(36 * 10);
  Exit_Normal(0);
  Delay(36 * 6);
}

// script "uh_ChangeTeam" (int team) {
// 	player_SetTeam(team, true);

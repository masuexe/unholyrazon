// Round lifecycle: TLMS enter/respawn, player life-status tracking,
// startup settings, countdown, background timer, and the survivor/boss
// watchers that end the round.  Fragment of library unholy.

function void BasicTLMSEnterState(void) {
  if (GetCVar("lastmanstanding") == 1) {
    ACS_NamedExecuteWithResult("UH_ClearLeaveDrops", PlayerNumber());
    // GiveInventory("PowerSuicideStartProtect",1);
    if (!isbonuseventactive || !IsFFAEvent(eventdataarr[EVENTDATA_MAINEVENT])) {
      GiveInventory("ProtectSurvivor", 1);
      GiveInventory("ProtectUnholyItem", 1);
    }
  }
}

script "ub_BasicTLMSEnter" ENTER {
  UH_AFKResetPlayer(PlayerNumber());
  BasicTLMSEnterState();
}

script "ub_BasicTLMSRespawn" RESPAWN {
  UH_AFKResetPlayer(PlayerNumber());
  BasicTLMSEnterState();
  int pn = PlayerNumber();
  if (pn >= 0) {
    RebuildActiveRoundState(pn + 1000, 1);
  }
}

script "ub_Death_ChangeIsAlive" DEATH {
  UH_AFKResetPlayer(PlayerNumber());
  int pn;
  int oldstatus;

  if (GetCVar("lastmanstanding") == 1) {
    pn = PlayerNumber();
    // Clear synchronously, including deaths exempted by DropItemsOnDeath_P.
    ACS_NamedExecuteWithResult("UH_ClearLeaveDrops", pn);
    oldstatus = playerlifestatusarr[pn];
    UH_Log(UH_LOG_DEBUG, StrParam(i:pn, s:" is dead!!"));
    GiveInventory("DropItemsOnDeath_P", 1);
    // Server DEATH hook covers all bonus morph bodies and fires once per life.
    // Check the current setting here so toggling it applies without a new round.
    if (isbonuseventactive && GetCVar("uh_sv_bonusdeathshitting"))
      GiveInventory("UH_DeathShitting_P", 1);
    // Survivor death breaks current spell-card capture
    if (oldstatus == PLS_SURVIVOR)
      ACS_NamedExecuteAlways("uh_SpellCardBreak", 0);
    // W8 is a survival spell: capture only on timer end (not on death)
    PlayerLifeStatusArr_UpdateFunc(pn, 0);
    roundstatebuilt[pn] = false;
    if (CheckInventory("IsSpecimanFlag"))
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 404);
    if (CheckInventory("IsAMujicaMember"))
      ACS_NamedExecuteAlways("rz_MujicaFallen", 0);
    if (dickheadwatchcount > 0)
      ACS_NamedExecuteAlways("rz_DickheadWatchDeath", 0, pn);
  }
}
script "ub_Disconnect_ChangeIsAlive" (int playernum) DISCONNECT {
  // Zandronum PLAYER_LeavesGame also fires DISCONNECT on voluntary spectate.
  // Latch departure so rejoining during the countdown cannot reclaim a choice.
  UH_AFKResetPlayer(playernum);
  if (GetCVar("lastmanstanding") == 1) {
    if (uh_bosschoicewinner == playernum + 1) {uh_bosschoicewinner = 0;}
    if (uh_bosschoicecommit[0] == playernum + 1) {
      uh_bosschoicecommit[0] = -(playernum + 1);
    }
    if (bosschoicetid == playernum + 1000) {
      if (bosschoiceconfirmed) {bosschoicereassign = true;}
      else {bosschoicetid = 0;}
    }
    // DISCONNECT also covers true spectators; the original inventory is gone.
    ACS_NamedExecuteWithResult("UH_DropItemsOnLeave", playernum);
    UH_Log(UH_LOG_DEBUG, StrParam(i:playernum, s:" has disconnected!!"));
    // Drop the hello slot immediately: a same-slot reconnect between two watch
    // polls must still receive the initial spectator/role snapshot.
    UH_Ti_ServerForgetClient(playernum);
    PlayerLifeStatusArr_UpdateFunc(playernum, 0);
    roundstatebuilt[playernum] = false;
    if (CheckActorInventory(playernum + 1000, "IsAMujicaMember"))
      ACS_NamedExecuteAlways("rz_MujicaFallen", 0);
  }
}

// These are start up variables so that they are valid numbers
// This also resets variables at round start (such as the bossDataArr[][])
script "ub_StartUpSettings" OPEN {
  UH_RegisterBuiltinBossCombos();
  if (GetCVar("lastmanstanding") == 0) {
    PrintBold(s:"Gamemode must be set to \cgLast Man Standing\c- in order to play Unholy Razon!");
    if (GetCVar("mm8bdm_sv_respawnprotection") > 0) {ConsoleCommand("mm8bdm_sv_respawnprotection 0");}
    terminate;
  }

  if (GetGameModeState() == 1 || GetGameModeState() == 0) {
    //
  }
  else {
    if (GetCVar("sv_forcerandomclass") == 1) {ConsoleCommand("sv_forcerandomclass 0");}  // This breaks classes somehow, disabled.
    if (GetCVar("sv_noexit") == 1) {ConsoleCommand("sv_noexit 0");}  // Needed for exit map commands.
    if (GetCVar("winlimit") != 1) {ConsoleCommand("winlimit 1");}  // Someone won? Then nextmap.
    // SetGameModeLimit(GAMELIMIT_WINS,1);//GAMELIMIT_WINS = 4
    // if(GetCVar("sv_forcerespawn")==0){consolecommand("sv_forcerespawn 1");}//Unsure if needed, legacy?
    if (GetCVar("mm8bdm_sv_respawnprotection") > 0) {ConsoleCommand("mm8bdm_sv_respawnprotection 0");}  // Since the morphing starts within one second, sometimes a player would have invun from the pre-round.
    // if(GetCVar("sv_NoBossMusic")==0){SetCVar("sv_NoBossMusic",1);}//Might be legacy?
    if (GetCVar("Compat_NoLand") == 0) {ConsoleCommand("Compat_NoLand 1");}  // Land is a dangerous tool
    if (GetCVar("sv_lmscountdowntime") < 4) {ConsoleCommand("sv_lmscountdowntime 4");}  // At least 4 seconds are needed for pre-round scripts!
  }
  // Most variables are redundant

  gameover = false;

  PlayerLifeStatusArr_GatherFunc();

  multibosscheck = 1;
  standardlmseventlocked = false;
  thelmsdude = 1145;
  survwinwithlms = false;

  isbonuseventactive = false;
  bonuseventended = false;

  // Push the fresh round statuses and the cleared 1-vs-all state to every
  // client before boss assignment starts changing roles.
  UH_TeamInfo_FullSnapshot();

  ClearMujicaState();
  twoplayersxrayenabled = false;
  for (int rsi = 0; rsi < MAX_PLAYERS; rsi++) {
    roundstatebuilt[rsi] = false;
  }

  ACS_NamedExecuteWithResult("core_bossmusicstate", 1, 669);  // Disables boss music for maps, that is if they use this script
  MusicSaveFunc();

  u_maplevelname = StrParam(n:PRINTNAME_LEVELNAME);
  u_maplevelcode = StrParam(n:PRINTNAME_LEVEL);

  // OPEN scripts from every library run in the same tic with no guaranteed
  // completion order, so the boss registry may still be empty here.  Validate
  // from a deferred script that waits (bounded) for the registry instead of
  // blocking this OPEN script.
  if (UH_LogLevel() == UH_LOG_ALL) {ACS_NamedExecuteAlways("ub_ValidateBossCombosDeferred", 0);}

  if (!startupvariables) {  // These are the true startup variables, only done ONCE on server start.
    if (GetCVar("sv_forcerandomclass") == 1) {ConsoleCommand("sv_forcerandomclass 0");}  // This breaks classes somehow, disabled.
    if (GetCVar("sv_noexit") == 1) {ConsoleCommand("sv_noexit 0");}  // Needed for exit map commands.
    if (GetCVar("winlimit") != 1) {ConsoleCommand("winlimit 1");}  // Someone won? Then nextmap.
    if (GetCVar("mm8bdm_sv_respawnprotection") > 0) {ConsoleCommand("mm8bdm_sv_respawnprotection 0");}  // Since the morphing starts within one second, sometimes a player would have invun from the pre-round.
    if (GetCVar("Compat_NoLand") == 0) {ConsoleCommand("Compat_NoLand 1");}  // Land is a dangerous tool
    if (GetCVar("sv_lmscountdowntime") < 4) {ConsoleCommand("sv_lmscountdowntime 6");}
    // 6 seconds sometimes causes a DRAW to go to the next map.
    if (GetCVar("mm8bdm_sv_nolmsweapons") == 0) {ConsoleCommand("mm8bdm_sv_nolmsweapons 1");}


    bosseventcounter = 0;
    ResetBossComboState();

    BossEXCountArr_Setter(500, 1, 3);  // Randomize EX Boss Counters

    rarebosschance = 15;
    hellmarkfrags = 0;
    specimanfrags = 0;

    eventdataarr[EVENTDATA_FORCED] = -1;
    PresetStrongmanCheck(-1, 99);  // StrongmanCheck
    eventdataarr[EVENTDATA_LASTEVENT] = -1;
    rarelmsrune = 45;
    rarelmstime = 9;
    winstreak = 0;
    mercygiven = false;
    for (int i = 0; i < 64; i++) {
      lmsdudearr[i] = 0;
    }
    startupvariables = true;
  }
  ACS_NamedExecute("ub_RefreshHudMessageLoop", 0);
  ACS_NamedExecute("uh_BackgroundTimer", 0);
}

// Deferred D0 validation. Yield once so non-delaying OPEN registrations in
// other libraries finish. Readiness means built-in registration completed;
// a missing addon boss must be reported, not stall the whole registry.
script "ub_ValidateBossCombosDeferred" (void) {
  if (UH_LogLevel() != UH_LOG_ALL) {
    terminate;
  }

  Delay(1);
  int waited = 0;
  bool ready = BossComboRegistryReady();
  while (!ready && waited < BOSSCOMBO_REGISTRY_WAIT_TICS) {
    Delay(1);
    waited++;
    ready = BossComboRegistryReady();
  }

  if (!ready) {
    UH_Log(UH_LOG_ERROR, "boss combo built-in registration readiness timeout");
  }

  DebugValidateRoundStart();
}


// Script "ub_AttemptSoundFollowFix" (void) {
//  Delay(2);
//  Delay(GetCVar("sv_lmscountdowntime")*35-12);
//  GiveMeTheFunc("BasicSoundFollowDisable",0,0);
// }

// Scripts related to boss morphing
script "ub_CountdownStartup" OPEN {
  if (GetCVar("lastmanstanding") == 0) {
    terminate;
  }
  while (PlayerCount() <= 1) {
    Delay(1);
  }


  if (GetGameModeState() == 1 || GetGameModeState() == 0) {

    // ACS_NamedExecute("ub_AttemptSoundFollowFix",0);

    int ued = CheckClearCVar("uh_sv_bonuseventdelay", -1);
    if (ued >= 0 && eventdataarr[EVENTDATA_DELAY] != 77) {  // Sets EventDelay if forced
      eventdataarr[EVENTDATA_DELAY] = ued;
      ShowMeTheRCON("Bonus Event Delay", ued);
    }
    // Retain the reward if an admin schedules consecutive bonus rounds.
    if (uh_bosschoicewinner > 0 &&
        eventdataarr[EVENTDATA_DELAY] < GetClampedCVar("uh_sv_bonuseventlimit", 1, 100)) {
      int choiceplayer = uh_bosschoicewinner - 1;
      uh_bosschoicewinner = 0;  // One countdown only, including timeout/leave.
      ACS_NamedExecute("ub_BonusBossSelector", 0, choiceplayer);
    }
    Delay(11);

    if (!GetCVAR("uh_sv_noitems")) {
      GiveMeTheFunc("SurvivorBoxItems_P", 1);  // Give Pre-Round Items
    }

    SetHudSize(480, 360, 0);
    SetFont("BIGFONT");
    if (eventdataarr[EVENTDATA_DELAY] >= GetClampedCVar("uh_sv_bonuseventlimit", 1, 100)) {
      ACS_NamedExecute("ub_EventManagementACS", 0, -2);
      Delay(20);
      if (eventdataarr[EVENTDATA_MAINEVENT] != UHBE_FAIL) {
        AmbientSound("misc/BonusTime", 127);
        HudMessageBold(s:"\c[MenuYellow]The ", s:GetBonusEventName(eventdataarr[EVENTDATA_MAINEVENT]), s:"\c[MenuYellow] event is about to happen!"; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 36.0, 20.0, 2.0);
      }
      else {
        HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0, 2.0);
      }
    }
    else if (strongmancheck[0] >= 0) {
      AmbientSound("misc/StrongMan", 127);
      HudMessageBold(s:"A powerful foe approaches!"; HUDMSG_FADEOUT, 66, CR_DARKRED, 240.4, 36.0, 20.0, 2.0);
    }
    else {
      HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0, 2.0);
    }

    Delay(20);
    terminate;
  }

  // Delay(5);

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  if (eventdataarr[EVENTDATA_DELAY] < GetClampedCVar("uh_sv_bonuseventlimit", 1, 100) && strongmancheck[0] >= 0) {
    HudMessageBold(s:"A powerful foe approaches!"; HUDMSG_FADEOUT, 66, CR_DARKRED, 240.4, 36.0, 0.5, 2.0);
  }
  else {
    HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 0.5, 2.0);
  }

  SetPlayerProperty(1, 1, 4);
  Delay(35 * 1);
  if (eventdataarr[EVENTDATA_DELAY] >= GetClampedCVar("uh_sv_bonuseventlimit", 1, 100)) {
    ACS_NamedExecute("ub_EventManagementACS", 0, -1);  // Select the event!
  }
  else {
    ACS_NamedExecute("ub_SelectBossAndEvent", 0);  // Select the bosses!
  }
}

// This is a basic countdown timer, lasts X time. After X time, attempt to end the round.
script "uh_BackgroundTimer" (void) {  // OPEN
  int deathchance = random(1, 4);

  int timeleft = getCVar("uh_sv_gametimer");
  if (timeleft > 0)
    timeleft += 10;
  else
    timeleft = -6;
  uh_roundtimerdeadline = -1;
  if (timeleft > 0)
    uh_roundtimerdeadline = Timer() + timeleft * 35;
  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  until (timeleft <= 0 || gameover) {  // Countdown
    // HudMessageBold(d:TimeLeft; HUDMSG_FADEOUT, 888, CR_DARKGREEN,0.5, 0.10, 3.0,2.0);
    // Log(d:TimeLeft);
    int timerend = GetCVar("uh_sv_timerend");
    if (timerend != 0) {
      // -2 forces an ending with the usual random effect; -1 still disables.
      if ((timerend < 0 && timerend != -2) || timerend > 4) {
        CheckClearCVar("uh_sv_timerend", 0);
        HudMessageBold(s:"\cf*NOTICE* \ckThe timer was disabled! \cf*NOTICE*"; HUDMSG_FADEOUT, 610, CR_GOLD, 320.4, 36.2, 7.0, 2.0);
      }
      timeleft = -6;
      break;
    }
    if (timeleft == 66) {
      HudMessageBold(s:"\ck*WARNING* \cjOne minute until time is up! \ck*WARNING*"; HUDMSG_FADEOUT, 610, CR_YELLOW, 320.4, 36.2, 7.0, 2.0);
    }
    int timertype = getCVar("uh_sv_timertype");
    switch (timertype) {
      case 0:
      default:
        break;
      case 1:
        if (timeleft <= 66) {
          ACS_NamedExecuteWithResult("uh_DrawTimerHud", timeleft, 1);
        }
        break;
      case 2:
        ACS_NamedExecuteWithResult("uh_DrawTimerHud", timeleft, 1);
        break;
    }

    Delay(35);
    timeleft--;
  }
  uh_roundtimerdeadline = -1;
  while (timeleft < 0 && !gameover) {  // If Timer is disabled
    if (GetCVar("uh_sv_timerend") != 0) {
      int requestedend = CheckClearCVar("uh_sv_timerend", 0);
      if (requestedend == -2 || (requestedend >= 1 && requestedend <= 4)) {
        if (requestedend > 0)
          deathchance = requestedend;
        AmbientSound("misc/mmpuwarning", 127);
        HudMessageBold(s:"\ci*WARNING* \cjThe round was forced to end! \ci*WARNING*"; HUDMSG_FADEOUT, 610, CR_ORANGE, 320.4, 36.2, 7.0, 2.0);
        Delay(35 * 6);
        break;
      }
    }
    Delay(35);
  }
  if (gameover) {  // Games over, clear messages
    ClearHudMessageBold(610);
    terminate;
  }
  switch (deathchance) {
    case 1:  // SuperGuhu
      GiveMeTheFunc("SGEXDItem", 1);
      break;
    case 2:  // Zankokuna
      ACS_NamedTerminate("uh_ZankokunaRage", 0);
      ACS_NamedExecute("uh_ZankokunaRage", 0);
      break;
    case 3:  // InstaKill
      SpawnForced("WishingStar_Help1_Server", 0, 0, 0);
      break;
    case 4:  // Exe
      SpawnForced("WishingStar_Help2_Server", 0, 0, 0);
      break;
    case 5:  // Reset
      SpawnForced("WishingStar_Help3_Server", 0, 0, 0);
      break;
  }
}




// Round to hundredths from 35 Hz ticks; split first to avoid multiplying
// the whole elapsed time. Explicit padding keeps values such as 12.03s.
function void UH_DrawBattleTime(int ticks, int color, int y) {
  int centiseconds = (ticks / 35) * 100 + ((ticks % 35) * 100 + 17) / 35;
  int fraction = centiseconds % 100;
  str padding = "";
  if (fraction < 10) padding = "0";
  HudMessageBold(s:"Battle Time: ", d:centiseconds / 100, s:".", s:padding, d:fraction, s:"s";
    HUDMSG_FADEOUT, 100, color, 240.4, y, 5.0, 2.0);
}

// Script used to end the round for no survivors
script "ub_WatchSurvivors" (int skipacs) {

  Delay(1);  // Important! Otherwise the BossDataArr[][] isn't set correctly from another script!
  // Same start tick as the boss watcher launched below, including skipacs rounds.
  int extratimer = Timer();

  if (!skipacs) {
    ACS_NamedExecute("ub_BossHealthWatcher", 0);
    ACS_NamedExecute("ub_DemoneyeNumWatcher", 0);  // Does this fix Boss VS??
    // Versus duels own their own ending: the two-slot watcher waits on the
    // boss slots and never runs the normal survivor-vs-boss result sequence.
    if (versusfightevent) {
      ACS_NamedExecute("ub_ManageBossVsBossEvent", 0);
      terminate;
    }
    ACS_NamedExecute("ub_WatchBossesAndEyes", 0);
  }

  while (totalplayersarr[PLS_SURVIVOR] >= 1 && !standardlmseventlocked && !gameover) {
    Delay(1);
    if (totalplayersarr[PLS_SURVIVOR] == 1) {
      ACS_NamedExecute("ub_LMS_EventTime", 0, -1);
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Last Man Standing!"));
      standardlmseventlocked = true;
    }
  }

  while (totalplayersarr[PLS_SURVIVOR] >= 1 && !gameover) {
    Delay(1);
  }

  if (gameover) {terminate;}

  Delay(1);

  // Re-check after the yield: ub_WatchBossesAndEyes may have claimed the round
  // while this script slept, and it terminates this watcher.  Without the
  // re-check a stale instance could still start a second settlement.
  if (gameover) {terminate;}

  ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
  // Unified bonus-event end entry: boss side took the round.  No-op outside
  // bonus rounds; the one-shot guard keeps it single-fire.
  UH_TryFinishBonusEvent(eventdataarr[EVENTDATA_MAINEVENT], UHBE_RESULT_BOSS, false);
  // PlayMusic_Loss(0);
  PlayMusic_Loser(-1);
  // MakeAllPlayersInvun();
  gameover = true;
  // Normal LMS boss victory: surviving bosses may fight during settlement.
  // Keep this synchronous with gameover, before any result-sequence delay.
  if (!isbonuseventactive)
    GiveMeTheFunc("PowerProtectBoss", -1);
  ResetBossComboState();  // D6: clear combo state for the result sequence.

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);
  HudMessageBold(s:"The survivors have been defeated..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 5.0, 2.0);
  UH_DrawBattleTime(Timer() - extratimer, CR_GRAY, 72.0);

  if (winstreak > 0) {winstreak = -1;}
  else {winstreak--;}
  if (winstreak % GetClampedCVar("uh_sv_losestreaklimit", 1, 100) == 0 && winstreak < 0) {
    HudMessageBold(s:"We have been defeated too many times!\nLet Helltatoru give you mercy..."; HUDMSG_FADEOUT, 67, CR_DARKRED, 240.4, 108.0, 5.0, 2.0);
    mercygiven = true;
  }
  else {
    mercygiven = false;
  }

  survwinwithlms = false;
  // World-activated exit: this watcher may have inherited a boss pawn as its
  // activator, and a player activator would make the round exit subject to
  // DF_NO_EXIT / sv_noexit and telefrag that pawn.
  ACS_NamedExecute("ub_ExitFinishedRound", 0, 35 * 9);
  Delay(35 * 6);
}


// Clear only the round-owned source; Lin/event X-Ray has its own marker.
function void UH_ClearTwoPlayerXRay(void) {
  GiveMeTheFunc("UH_TwoPlayerXRayOn_F", -1);
  twoplayersxrayenabled = false;
}

// Re-evaluate both the cvar and live count throughout the round. Keep the
// marker present as long as exactly two players remain; no 30-second expiry.
script "rz_WatchTwoPlayerLeft" (void) {
  int i;
  int tid;
  bool enabled;
  while (!gameover) {
    enabled = GetCVar("rz_sv_twoplayerxray") == 1
      && totalplayersarr[PLS_SURVIVOR] + totalplayersarr[PLS_BOSS]
        + totalplayersarr[PLS_EYE] == 2;
    twoplayersxrayenabled = enabled;
    for (i = 0; i < MAX_PLAYERS; i++) {
      if (!PlayerInGame(i)) continue;
      tid = i + 1000;
      SetActorInventory(tid, "UH_TwoPlayerXRayOn_F",
        enabled && GetActorProperty(tid, APROP_Health) > 0);
    }
    Delay(2);
  }
  UH_ClearTwoPlayerXRay();
}

// Boss streak compensation: five distinct runes per player without MercyFlag.
function void GiveMercyRunesToPlayer(int tid) {
  int pool[12];
  int mi;
  int mr;
  int mt;

  for (mi = 0; mi < 12; mi++) {
    pool[mi] = mi;
  }
  for (mi = 0; mi < 12; mi++) {
    mr = random(mi, 11);
    mt = pool[mi];
    pool[mi] = pool[mr];
    pool[mr] = mt;
  }
  for (mi = 0; mi < 5; mi++) {
    ACS_NamedExecuteWithResult("uh_runeplayer", tid - 999, 1, pool[mi]);
  }
  GiveActorInventory(tid, "MercyFlag", 1);
}

script "rz_MercyRuneGiver" (int tid) {
  if (tid >= 1000 && tid <= 1063) {
    if (playerlifestatusarr[tid - 1000] == PLS_SURVIVOR && !CheckActorInventory(tid, "MercyFlag")) {
      GiveMercyRunesToPlayer(tid);
    }
    terminate;
  }

  for (int pi = 1000; pi < 1064; pi++) {
    if (PlayerInGame(pi - 1000) && playerlifestatusarr[pi - 1000] == PLS_SURVIVOR && !CheckActorInventory(pi, "MercyFlag")) {
      GiveMercyRunesToPlayer(pi);
    }
  }
}

// Execute the penalty registered for this event (or the shared default).
function void GrantBadLMSEventDrops(int tid, int lmsnum) {
  if (GetLMSEventPenaltyFlags(lmsnum) & UHLMS_PENALTY_CLEAR_ITEMS) {
    for (int itemid = 0; itemid < UH_MAX_VANILLA_ITEM; itemid++) {
      if (IsItemDefined(itemid)) TakeActorInventory(tid, GetItemActor(itemid), 9999);
    }
    int customid = -1;
    while (IsItemDefined(customid)) {
      TakeActorInventory(tid, GetItemActor(customid), 9999);
      customid--;
    }
  }
  GrantLMSEventPenaltyDrops(tid, lmsnum, UHLMS_PENALTY_SURVIVOR);
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (PlayerInGame(p) && playerlifestatusarr[p] == PLS_BOSS)
      GrantLMSEventPenaltyDrops(p + 1000, lmsnum, UHLMS_PENALTY_BOSSES);
  }
}

// Checks if all bosses are dead
script "ub_WatchBossesAndEyes" (void) {
  int extratimer = Timer();
  int fastkilltime = GetClampedCVar("uh_sv_fastkilltime", 0, 300);
  int battletime;
  while (totalplayersarr[PLS_BOSS] >= 1 || totalplayersarr[PLS_EYE] >= 1) {
    if (gameover) {terminate;}
    Delay(2);
  }

  if (gameover) {terminate;}

  GiveMeTheFunc("PowerProtectSurvivor", -1);
  GiveMeTheFunc("PowerProtectMegaCopywep", -1);
  GiveMeTheFunc("PowerProtectUnholyItem", -1);

  ACS_NamedTerminate("ub_WatchSurvivors", 0);
  // Unified bonus-event end entry: survivors took the round.
  UH_TryFinishBonusEvent(eventdataarr[EVENTDATA_MAINEVENT], UHBE_RESULT_SURVIVOR, false);
  gameover = true;
  ResetBossComboState();  // D6: clear combo state for the result sequence.
  // Log(i:PlayerInGame(BossDataArr[0][BOSSDATA_TID]-1000));

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);

  if (multibosscheck == 1 && !PlayerInGame(bossdataarr[0][BOSSDATA_TID] - 1000) && timer() <= 35 * 7 + extratimer) {
    PlayMusic_Win(-2);
    HudMessageBold(s:"The boss has declined the duel!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);
    ACS_NamedExecute("ub_ExitFinishedRound", 0, 36 * 4);
    Delay(35);
    terminate;
  }
  // PlayMusic_Win(0);
  PlayMusic_Winner(-1);
  HudMessageBold(s:"The survivors are victorious!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);

  int next_y = 72.0;

  battletime = Timer() - extratimer;
  int battle_color = CR_GRAY;
  // Preserve the existing whole-second fast-kill reward threshold.
  if (fastkilltime > 0 && battletime / 35 <= fastkilltime) {
    eventdataarr[EVENTDATA_DELAY] += 1;
    battle_color = CR_GOLD;
  }
  UH_DrawBattleTime(battletime, battle_color, next_y);
  next_y += 18.0;

  if (winstreak < 0) {winstreak = 1;}
  else {winstreak++;}
  mercygiven = false;
  if (winstreak % GetClampedCVar("uh_sv_winstreaklimit", 1, 100) == 0) {
    HudMessageBold(s:"Survivor win streak: ", d:winstreak; HUDMSG_FADEOUT, 67, CR_DARKRED, 240.4, next_y, 5.0, 2.0);
    ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 1);
  }
  else {
    HudMessageBold(s:"Survivor win streak: ", d:winstreak; HUDMSG_FADEOUT, 67, CR_GREEN, 240.4, next_y, 5.0, 2.0);
  }
  next_y += 18.0;

  if (roundstartsurvivors > 0 && totalplayersarr[PLS_SURVIVOR] == roundstartsurvivors) {
    eventdataarr[EVENTDATA_DELAY] += 2;
    HudMessageBold(s:"PERFECT! No survivors were lost."; HUDMSG_FADEOUT, 101, CR_GREEN, 240.4, next_y, 5.0, 2.0);
    next_y += 18.0;
  }

  if (survwinwithlms) {
    int hellmarklimit = GetClampedCVar("uh_sv_hellmarklimit", 1, 100);
    hellmarkfrags++;
    if (hellmarkfrags >= hellmarklimit) {
      AmbientSound("misc/SampiRises", 127);
      HudMessageBold(s:"The Helltatoru knows no limits..."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, next_y, 5.0, 2.0);
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 402);
    }
    else {
      HudMessageBold(s:"Marks of Helltatoru ", d:hellmarkfrags, s:"/", d:hellmarklimit, s:" collected."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, next_y, 5.0, 2.0);
    }
    next_y += 18.0;
  }

  ACS_NamedExecute("ub_ExitFinishedRound", 0, 36 * 10);
  Delay(36 * 6);
}

//Aspect Ratio Zone

function int GetHudRight(int w) {
	int ar = getaspectratio();
	switch (ar) {
		case ASPECT_16_9: return w + (FixedDiv(w << 16, 6.0) >> 16); break;  //5.9
		case ASPECT_16_10: return w + (FixedDiv(w << 16, 10.0) >> 16); break;
		case ASPECT_17_10: return w + (FixedDiv((w << 16) * 11, 80.0) >> 16); break;
	}
	return w;
}

function int GetHudLeft(int w) {
	return w - GetHudRight(w);
}

function int GetHudBot(int h) {
	int ar = GetAspectRatio();
	if (ar == ASPECT_5_4) {
		return h + h / 30;
	}
	return h;
}
function int GetHudTop(int h) {
	return h - GetHudBot(h);
}


// Clownpiece-only spell-card flow: phase timer, capture/fail/break
// resolution and invuln stripping.  Sole caller:
// actors/classes/bosses/Clownpiece_W.dec.  Fragment of library unholy.
// Spell card timer + capture bonus (LMS).
// Normal: clear spell-card phase in time, no survivor deaths → bonus.
// Active nonspell (1): timer only, no bonus/reward. Phases 3/5 are disabled.
// Survival Time Sign (W2/W8): cancel HP damage and convert survivor hits into
// timer credit (one phase HP budget = half the initial duration, capped at half).
// Timeout + no deaths → bonus; damage acceleration does not break capture.
//
// DECORATE / CallACS API:
//   ACS_NamedExecuteAlways("uh_SpellCardStart", 0, phaseId, timeLimitSec)
//   ACS_NamedExecuteAlways("uh_SpellCardCapture", 0)   // force success (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardFail", 0)      // force fail (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardBreak", 0)     // survivor death → mark broken
//   ACS_NamedExecuteAlways("uh_SpellCardResolve", 0, mode) // 0 fail, 1 damage, 2 survival timeout
//   ACS_NamedExecuteAlways("uh_SpellCardStop", 0)
//   ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, toPhase)
//
// Result HUD (Bonus!/Failed) uses a separate id so it can coexist with name/timer.
#define UH_SC_HUD_NAME 1720
#define UH_SC_HUD_TIMER 1721
#define UH_SC_HUD_RESULT 1722
#define UH_SC_HUD_BONUS 1723
#define UH_SC_HUD_ACCEL 1724

#define UH_SC_PHASE_MAX 8
#define UH_SC_TICRATE 35

#define UH_SC_RESOLVE_FAIL 0
#define UH_SC_RESOLVE_DAMAGE 1
#define UH_SC_RESOLVE_SURVIVAL 2

bool uh_spellcardactive;
bool uh_spellcardbroken;
int uh_spellcardtimeleft;
int uh_spellcardphase;
// One map-array slot: the round-core is near ACC's map-variable limit.
int uh_spellcardattack[5]; // remaining tics, initial tics, HP budget, damage, removed tics
int uh_spellcardtimergen;  // bump on each Start; stale Always timers must not tick

int uh_cl_spellcardgen;
int uh_cl_spellcardhudgen = -1;
bool uh_cl_spellcardbroken;
int uh_cl_spellcard_remaining_tics;
int uh_cl_spellcard_removed_tics;

str uh_spellcardnamelist[UH_SC_PHASE_MAX + 1] = {
  "",
  "",  // Nonspell 1 — no name HUD
  "Hell Sign \"Eclipse of Hell\"",
  "",  // Nonspell 2
  "Hell Sign \"Star and Stripe\"",
  "",  // Nonspell 3
  "Hellfire \"Infernal Essence of Grazing\"",
  "Inferno \"Striped Abyss\"",
  "\"Apollo Hoax Theory\""
};

function str UH_SpellCardNameOf(int phaseid) {
  if (phaseid < 1 || phaseid > UH_SC_PHASE_MAX)
    return "";
  return uh_spellcardnamelist[phaseid];
}

// Named spell cards only (not nonspells 1/3/5)
function bool UH_SpellCardShowsName(int phaseid) {
  return (phaseid == 2 || phaseid == 4 || phaseid == 6 || phaseid == 7 || phaseid == 8);
}

// Spell-card bonus stages only — nonspells 1/3/5 never announce or reward
function bool UH_SpellCardIsBonusPhase(int phaseid) {
  return UH_SpellCardShowsName(phaseid);
}

// LoLK survival spells (Time Sign): W2 Eclipse of Hell, W8 Apollo Hoax
function bool UH_SpellCardIsSurvival(int phaseid) {
  return (phaseid == 2 || phaseid == 8);
}

// Allocate only on phase entry: the running countdown never changes speed.
// Disabled nonspells 3/5 contribute no weight. Ordinary phases remain 30s.
function int UH_ClownpieceBaseTime(int phaseid, int fallback) {
  if (phaseid == 2)
    return min(300, max(1, GetCVar("uh_sv_clownpiece_w2_time")));
  if (phaseid == 8)
    return min(300, max(1, GetCVar("uh_sv_clownpiece_w8_time")));
  return min(300, max(1, fallback));
}

function int UH_ClownpiecePhaseTime(int phaseid, int fallback) {
  int base = UH_ClownpieceBaseTime(phaseid, fallback);
  if (!GetCVar("uh_sv_clownpiece_autotime") || uh_roundtimerdeadline < 0)
    return base;

  int weight = 0;
  int count = 0;
  for (int phase = phaseid; phase <= UH_SC_PHASE_MAX; phase++) {
    if (phase == 3 || phase == 5)
      continue;
    weight += UH_ClownpieceBaseTime(phase, 30);
    count++;
  }
  if (count == 0)
    return base;

  // Floor to whole seconds; leave 10s for the ending and 2s per future swap
  // (heal/weapon selection). This is a budget, not a guarantee for extreme
  // health scaling or a late morph with less than one second per phase left.
  int remaining = max(0, (uh_roundtimerdeadline - Timer()) / UH_SC_TICRATE);
  int budget = max(0, remaining - 10 - 2 * (count - 1));
  return min(base, max(1, budget * base / weight));
}

function void UH_SpellCardClearHud(void) {
  ClearHudMessageBold(UH_SC_HUD_NAME);
  ClearHudMessageBold(UH_SC_HUD_TIMER);
  ClearHudMessageBold(UH_SC_HUD_BONUS);
  ClearHudMessageBold(UH_SC_HUD_ACCEL);
  for (int c = 0; c < MAX_PLAYERS; c++) {
    if (UH_Ti_IsConnectedClient(c))
      NamedExecuteClientScript("uh_SpellCardClientClear", c, uh_spellcardtimergen);
  }
}

function void UH_SpellCardSyncClients(int remainingtics, int mygen, int phaseid) {
  for (int c = 0; c < MAX_PLAYERS; c++) {
    if (UH_Ti_IsConnectedClient(c))
      NamedExecuteClientScript("uh_SpellCardClientSync", c, remainingtics, mygen,
        phaseid, uh_spellcardattack[4] * 2 + uh_spellcardbroken);
  }
}

// Keep actual HP/armor unchanged: native INVULNERABLE returns before these
// events, so survival phases pop their transition stack and use cancellation.
// PREMOD sees PowerProtection/type/team modifiers and runs before armor/procs.
// The session is shared by all Clownpieces: their damage shares one credit cap.
script "uh_ClownpieceTimeDamage" (int evt, int dmg, int dmgtype) EVENT {
  if (evt != GAMEEVENT_ACTOR_DAMAGED_PREMOD)
    terminate;
  if (!SetActivator(0, AAPTR_DAMAGE_TARGET) || !CheckActorClass(0, "Clownpiece"))
    terminate;
  if (!CheckInventory("ClownpieceSurvivalInvuln_F"))
    terminate;

  int effective = GetEventResult();
  SetResultValue(0); // Cancel all hits, including non-credit environmental hits.
  if (!uh_spellcardactive || !UH_SpellCardIsSurvival(uh_spellcardphase))
    terminate;
  if (effective <= 0 || effective >= 1000000 ||
      !StrICmp(dmgtype, "Telefrag") || !StrICmp(dmgtype, "SpawnTelefrag") ||
      !StrICmp(dmgtype, "DeathPit") || !StrICmp(dmgtype, "InstantDeath"))
    terminate;
  if (!SetActivator(0, AAPTR_DAMAGE_SOURCE))
    terminate;
  int shooter = PlayerNumber();
  if (shooter < 0 || playerlifestatusarr[shooter] != PLS_SURVIVOR || CheckInventory("IsDead"))
    terminate;

  uh_spellcardattack[3] += min(effective, uh_spellcardattack[2] - uh_spellcardattack[3]);
  int cap = uh_spellcardattack[1] / 2;
  // FixedDiv takes raw cells; their ratio is fixed regardless of their units.
  // Accumulating damage before division preserves small-hit contributions.
  int removed = cap;
  if (uh_spellcardattack[3] < uh_spellcardattack[2])
    removed = FixedMul(FixedDiv(uh_spellcardattack[3], uh_spellcardattack[2]), cap);
  uh_spellcardattack[0] = max(0, uh_spellcardattack[0] - (removed - uh_spellcardattack[4]));
  uh_spellcardattack[4] = removed;
  uh_spellcardtimeleft = (uh_spellcardattack[0] + UH_SC_TICRATE - 1) / UH_SC_TICRATE;
}

function void UH_SpellCardDrawHud(int sec, int centi, int phaseid) {
  int color;
  str sec_str;
  str centi_str;
  str timerstr;

  SetHudSize(640, 480, 0);
  int x_aspect = GetHudRight(640) * 1.0;
  if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
    x_aspect = 640.0;
  }
  int draw_x = (RoundFixedToInt(x_aspect - 16.0) * 1.0) + 0.2;

  // Timer (Top-Right, Touhou STG style with real countdown centiseconds)
  SetFont("BIGFONT");
  if (sec <= 4)
    color = CR_RED;
  else if (sec <= 9)
    color = CR_BRICK;
  else
    color = CR_WHITE;

  if (sec < 0)
    sec = 0;
  if (centi < 0)
    centi = 0;

  if (sec < 10)
    sec_str = StrParam(s:"0", i:sec);
  else
    sec_str = StrParam(i:sec);

  if (centi < 10)
    centi_str = StrParam(s:"0", i:centi);
  else
    centi_str = StrParam(i:centi);

  timerstr = StrParam(s:sec_str, s:".", s:centi_str);
  // ExecuteClientScript keeps the boss activator. Ordinary HudMessage would
  // therefore draw only on that player's client, even though every peer got
  // the sync. Bold draws on this CLIENTSIDE VM regardless of its activator.
  HudMessageBold(s:timerstr; HUDMSG_PLAIN, UH_SC_HUD_TIMER, color, draw_x, 16.1, 0);

  SetFont("SMALLFONT");
  if (UH_SpellCardIsSurvival(phaseid)) {
    int removedcenti = uh_cl_spellcard_removed_tics * 100 / UH_SC_TICRATE;
    str padding = "";
    if (removedcenti % 100 < 10) padding = "0";
    HudMessageBold(s:"ATTACK TIME -", i:removedcenti / 100, s:".", s:padding,
      i:removedcenti % 100, s:"s"; HUDMSG_PLAIN, UH_SC_HUD_ACCEL, CR_GREEN,
      draw_x, 80.1, 0);
  }
  else ClearHudMessageBold(UH_SC_HUD_ACCEL);

  // Spell Card Name and Bonus (Top-Right, placed at Y=56.1 and 68.1 to clear LMS event banner)
  SetFont("SMALLFONT");
  if (UH_SpellCardShowsName(phaseid)) {
    HudMessageBold(s:UH_SpellCardNameOf(phaseid); HUDMSG_PLAIN, UH_SC_HUD_NAME, CR_GOLD, draw_x, 56.1, 0);
    if (uh_cl_spellcardbroken) {
      HudMessageBold(s:"\cuBONUS  \cgFAILED"; HUDMSG_PLAIN, UH_SC_HUD_BONUS, CR_UNTRANSLATED, draw_x, 68.1, 0);
    }
    else {
      HudMessageBold(s:"\ckBONUS  \cdSURVIVOR BOX"; HUDMSG_PLAIN, UH_SC_HUD_BONUS, CR_UNTRANSLATED, draw_x, 68.1, 0);
    }
  }
  else {
    ClearHudMessageBold(UH_SC_HUD_NAME);
    ClearHudMessageBold(UH_SC_HUD_BONUS);
    ClearHudMessageBold(UH_SC_HUD_ACCEL);
  }
}

function void UH_SpellCardAnnounceResult(str msg, int color) {
  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  HudMessageBold(s:msg; HUDMSG_FADEOUT, UH_SC_HUD_RESULT, color, 320.4, 72.0, 3.0, 1.0);
}

function void UH_SpellCardStopTimer(void) {
  uh_spellcardactive = false;
  uh_spellcardtimergen++;
  ACS_NamedTerminate("uh_SpellCardTimer", 0);
}

function void UH_SpellCardEndQuiet(void) {
  UH_SpellCardStopTimer();
  uh_spellcardbroken = false;
  uh_spellcardtimeleft = 0;
  uh_spellcardattack[0] = 0;
  uh_spellcardattack[4] = 0;
  UH_SpellCardClearHud();
}

function void UH_SpellCardGiveSurvivorBoxes(void) {
  int j;
  for (j = 0; j < MAX_PLAYERS; j++) {
    if (!PlayerInGame(j))
      continue;
    if (playerlifestatusarr[j] != PLS_SURVIVOR)
      continue;
    GiveActorInventory(j + 1000, "SurvivorBoxItems_P", 1);
  }
}

// Time Sign end: drop flag and strip ALL PlayerPropertyInvulnerable stacks.
// core_invulnerableplayer(false) only pops one layer; APROP stays if stacks remain.
function void UH_ClownpieceClearSurvInv(void) {
  int tid;
  int old;

  old = ActivatorTID();
  for (tid = 1000; tid <= 1063; tid++) {
    if (!PlayerInGame(tid - 1000))
      continue;
    if (!CheckActorInventory(tid, "ClownpieceSurvivalInvuln_F")
      && CheckActorInventory(tid, "PlayerPropertyInvulnerable") < 1)
      continue;
    TakeActorInventory(tid, "ClownpieceSurvivalInvuln_F", 1);
    TakeActorInventory(tid, "PlayerPropertyInvulnerable", 999);
    SetActivator(tid);
    SetActorProperty(0, APROP_INVULNERABLE, false);
  }
  if (old)
    SetActivator(old);
  else
    SetActivator(0);
}

function void UH_SpellCardCaptureSuccess(void) {
  UH_SpellCardStopTimer();
  UH_SpellCardAnnounceResult("Get Spell Card Bonus!", CR_YELLOW);
  AmbientSound("Touhou/SpellCardGet", 127);
  UH_SpellCardGiveSurvivorBoxes();
  AmbientSound("Touhou/SpellCardBonus", 127);
  uh_spellcardbroken = false;
}

// mode: FAIL / DAMAGE (need timeLeft>0) / SURVIVAL timeout (!Broken, ignore time)
// Nonspells (1/3/5): quiet stop only — no Bonus!/Failed announce, no boxes.
function void UH_SpellCardTryCaptureOrFail(int mode) {
  if (!uh_spellcardactive && !uh_spellcardbroken)
    return;

  if (!UH_SpellCardIsBonusPhase(uh_spellcardphase)) {
    UH_SpellCardStopTimer();
    uh_spellcardbroken = false;
    if (uh_spellcardphase >= UH_SC_PHASE_MAX)
      UH_SpellCardClearHud();
    return;
  }

  if (mode == UH_SC_RESOLVE_SURVIVAL && uh_spellcardactive && !uh_spellcardbroken)
    UH_SpellCardCaptureSuccess();
  else if (mode == UH_SC_RESOLVE_DAMAGE && uh_spellcardactive && !uh_spellcardbroken && uh_spellcardtimeleft > 0)
    UH_SpellCardCaptureSuccess();
  else {
    UH_SpellCardStopTimer();
    UH_SpellCardAnnounceResult("Bonus Failed...", CR_RED);
    uh_spellcardbroken = false;
  }

  if (uh_spellcardphase >= UH_SC_PHASE_MAX)
    UH_SpellCardClearHud();
}

script "uh_SpellCardStart" (int phaseid, int timelimitsec) {
  if (phaseid < 1 || phaseid > UH_SC_PHASE_MAX)
    phaseid = 1;
  if (timelimitsec < 1)
    timelimitsec = 1;

  if (uh_spellcardactive && phaseid == uh_spellcardphase)
    terminate;
  if (phaseid < uh_spellcardphase)
    terminate;

  uh_spellcardtimergen++;
  ACS_NamedTerminate("uh_SpellCardTimer", 0);
  // Sync replaces all three HUD rows itself. A separate clear in the same
  // tic can run after the new sync (ACS queues scripts at the list head).

  uh_spellcardphase = phaseid;
  timelimitsec = UH_ClownpiecePhaseTime(phaseid, timelimitsec);
  uh_spellcardtimeleft = timelimitsec;
  uh_spellcardattack[1] = timelimitsec * UH_SC_TICRATE;
  uh_spellcardattack[0] = uh_spellcardattack[1];
  uh_spellcardattack[2] = max(1, GetActorProperty(0, APROP_SPAWNHEALTH));
  uh_spellcardattack[3] = 0;
  uh_spellcardattack[4] = 0;
  uh_spellcardbroken = false;
  uh_spellcardactive = true;

  UH_SpellCardSyncClients(uh_spellcardattack[0], uh_spellcardtimergen, phaseid);
  ACS_NamedExecuteAlways("uh_SpellCardTimer", 0, uh_spellcardtimergen);
}

script "uh_ClownpieceBroadcastPhase" (int tophase) {
  // Keep the legacy phase ids/weapons, but skip nonspells 2 and 3.
  if (tophase == 3 || tophase == 5)
    tophase++;
  if (tophase < 2 || tophase > UH_SC_PHASE_MAX)
    terminate;

  // Damage life-break settle (timeout already resolved before calling this)
  UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);

  AmbientSound("Touhou/Cat0", 127);

  str swapp = StrParam(s:"ClownpieceForceSwap_W", i:tophase, s:"_P");
  int tid;
  for (tid = 1000; tid <= 1063; tid++) {
    if (!PlayerInGame(tid - 1000))
      continue;
    if (CheckActorInventory(tid, "IsDead"))
      continue;
    GiveActorInventory(tid, swapp, 1);
  }
}

script "uh_ClownpieceSelectW" (int phase) {
  Delay(1);
  if (phase < 1 || phase > UH_SC_PHASE_MAX)
    terminate;
  str wep = StrParam(s:"Clownpiece_W", i:phase);
  if (!CheckInventory(wep))
    terminate;
  SetWeapon(wep);
}

script "uh_SpellCardTimer" (int mygen) {
  int phase;

  int syncage = UH_SC_TICRATE;
  int syncedremoved = -1;
  int warnedsec = -1;
  while (uh_spellcardactive && uh_spellcardattack[0] > 0) {
    if (mygen != uh_spellcardtimergen)
      terminate;
    // At most five damage updates per second, plus the regular 1Hz sync.
    if (syncage >= UH_SC_TICRATE ||
        (syncage >= 7 && syncedremoved != uh_spellcardattack[4])) {
      UH_SpellCardSyncClients(uh_spellcardattack[0], mygen, uh_spellcardphase);
      syncage = 0;
      syncedremoved = uh_spellcardattack[4];
    }
    if (warnedsec != uh_spellcardtimeleft) {
      if (uh_spellcardtimeleft <= 9 && uh_spellcardtimeleft >= 5)
        AmbientSound("Touhou/Timeout", 127);
      if (uh_spellcardtimeleft <= 4)
        AmbientSound("Touhou/Timeout2", 127);
      warnedsec = uh_spellcardtimeleft;
    }
    Delay(1);
    if (mygen != uh_spellcardtimergen || !uh_spellcardactive)
      terminate;
    uh_spellcardattack[0] = max(0, uh_spellcardattack[0] - 1);
    uh_spellcardtimeleft = (uh_spellcardattack[0] + UH_SC_TICRATE - 1) / UH_SC_TICRATE;
    syncage++;
  }

  if (uh_spellcardactive && mygen == uh_spellcardtimergen) {
    phase = uh_spellcardphase;
    if (UH_SpellCardIsSurvival(phase))
      UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_SURVIVAL);
    else
      UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);

    UH_ClownpieceClearSurvInv();

    if (phase >= UH_SC_PHASE_MAX)
      ACS_NamedExecuteAlways("uh_ClownpieceTimeoutKill", 0);
    else
      ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, phase + 1);
  }
}

script "uh_ClownpieceTimeoutKill" (void) {
  int tid;
  for (tid = 1000; tid <= 1063; tid++) {
    if (!PlayerInGame(tid - 1000))
      continue;
    if (CheckActorInventory(tid, "IsDead"))
      continue;
    GiveActorInventory(tid, "ClownpieceTimeoutKill_P", 1);
  }
}

script "uh_SpellCardResolve" (int mode) {
  UH_SpellCardTryCaptureOrFail(mode);
}

script "uh_SpellCardCapture" (void) {
  if (!uh_spellcardactive)
    terminate;
  if (uh_spellcardbroken || uh_spellcardtimeleft <= 0) {
    UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
    terminate;
  }
  UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);
}

script "uh_SpellCardFail" (void) {
  if (!uh_spellcardactive && !uh_spellcardbroken)
    terminate;
  UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
}

script "uh_SpellCardBreak" (void) {
  if (uh_spellcardactive) {
    uh_spellcardbroken = true;
    for (int c = 0; c < MAX_PLAYERS; c++) {
      if (UH_Ti_IsConnectedClient(c))
        NamedExecuteClientScript("uh_SpellCardClientBreak", c, uh_spellcardtimergen);
    }
  }
}

script "uh_SpellCardClientClear" (int mygen) CLIENTSIDE {
  if (mygen <= uh_cl_spellcardgen)
    terminate;
  uh_cl_spellcardgen = mygen;
  uh_cl_spellcard_remaining_tics = -1;
  ClearHudMessageBold(UH_SC_HUD_NAME);
  ClearHudMessageBold(UH_SC_HUD_TIMER);
  ClearHudMessageBold(UH_SC_HUD_BONUS);
  ClearHudMessageBold(UH_SC_HUD_ACCEL);
}

script "uh_SpellCardClientBreak" (int mygen) CLIENTSIDE {
  if (mygen == uh_cl_spellcardgen)
    uh_cl_spellcardbroken = true;
}

script "uh_SpellCardClientSync" (int remainingtics, int mygen, int phaseid, int status) CLIENTSIDE {
  if (mygen < uh_cl_spellcardgen)
    terminate;
  uh_cl_spellcardgen = mygen;
  uh_cl_spellcardbroken = (status % 2) != 0;
  uh_cl_spellcard_removed_tics = status / 2;
  uh_cl_spellcard_remaining_tics = remainingtics;
  if (uh_cl_spellcardhudgen != mygen)
    ACS_NamedExecuteAlways("uh_SpellCardClientHud", 0, phaseid, 0, mygen);
}

script "uh_SpellCardClientHud" (int phaseid, int timelimitsec, int mygen) CLIENTSIDE {
  // A queued old runner must never restore an obsolete generation or timer.
  if (mygen != uh_cl_spellcardgen || uh_cl_spellcardhudgen == mygen)
    terminate;
  uh_cl_spellcardhudgen = mygen;

  while (uh_cl_spellcard_remaining_tics >= 0 && mygen == uh_cl_spellcardgen) {
    int sec = uh_cl_spellcard_remaining_tics / 35;
    int rem = uh_cl_spellcard_remaining_tics % 35;
    int centi = (rem * 99) / 34;

    UH_SpellCardDrawHud(sec, centi, phaseid);

    Delay(1);
    uh_cl_spellcard_remaining_tics--;
  }

  if (mygen == uh_cl_spellcardgen) {
    ClearHudMessageBold(UH_SC_HUD_NAME);
    ClearHudMessageBold(UH_SC_HUD_TIMER);
    ClearHudMessageBold(UH_SC_HUD_BONUS);
    ClearHudMessageBold(UH_SC_HUD_ACCEL);
  }
  if (uh_cl_spellcardhudgen == mygen)
    uh_cl_spellcardhudgen = -1;
}

script "uh_SpellCardStop" (void) {
  UH_SpellCardEndQuiet();
}

script "uh_SpellCardIsActive" (void) {
  SetResultValue(uh_spellcardactive);
}

script "uh_SpellCardGetTimeLeft" (void) {
  SetResultValue(uh_spellcardtimeleft);
}

// Strip all invuln stacks + APROP (core_invulnerableplayer false only pops one layer)
script "uh_StripInvulnStacks" (void) {
  TakeInventory("PlayerPropertyInvulnerable", 999);
  SetActorProperty(0, APROP_INVULNERABLE, false);
}

// Boss unmorph: the spell-card session is library-global (phase, timer
// generation, HUD), so a shadow fakeout must cancel it here.  Otherwise the
// stale session keeps its timer running, keeps handing out phase swaps and
// would make a later Clownpiece's uh_SpellCardStart silently refuse to start.
// Only this player's own phase markers are dropped; the PlayerProperty stack
// layers themselves are returned by the generic demorph baseline.
script "uh_ClownpieceUnmorphCancel" (void) {
  UH_SpellCardEndQuiet();
  TakeInventory("ClownpieceSurvivalInvuln_F", 1);
  TakeInventory("ClownpieceGetUpDone_F", 1);
  TakeInventory("ClownpiecePainFlag", 1);
  TakeInventory("ClownpieceOrbFlag", 1);
  TakeInventory("DuoBusterFlag", 1);
}

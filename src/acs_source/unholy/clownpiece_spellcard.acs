// Clownpiece-only spell-card flow: phase timer, capture/fail/break
// resolution and invuln stripping.  Sole caller:
// actors/classes/bosses/Clownpiece_W.dec.  Fragment of library unholy.
// Spell card timer + capture bonus (LMS).
// Normal: clear spell-card phase in time, no survivor deaths → bonus.
// Nonspells (1/3/5): timer only — no Bonus!/Failed, no SurvivorBoxItems_P.
// Survival Time Sign (W2/W8): boss invuln until timer ends; timeout + no deaths → bonus.
//
// DECORATE / CallACS API:
//   ACS_NamedExecuteAlways("uh_SpellCardStart", 0, phaseId, timeLimitSec)
//   ACS_NamedExecuteAlways("uh_SpellCardCapture", 0)   // force success (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardFail", 0)      // force fail (debug)
//   ACS_NamedExecuteAlways("uh_SpellCardBreak", 0)     // survivor death → mark broken
//   ACS_NamedExecuteAlways("uh_SpellCardResolve", 0, mode) // 0 fail, 1 damage, 2 survival timeout
//   ACS_NamedExecuteAlways("uh_SpellCardStop", 0)
//   ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, toPhase)
//
// Result HUD (Bonus!/Failed) uses a separate id so it can coexist with name/timer.
#define UH_SC_HUD_NAME 1720
#define UH_SC_HUD_TIMER 1721
#define UH_SC_HUD_RESULT 1722

#define UH_SC_PHASE_MAX 8
#define UH_SC_TICRATE 35

#define UH_SC_RESOLVE_FAIL 0
#define UH_SC_RESOLVE_DAMAGE 1
#define UH_SC_RESOLVE_SURVIVAL 2

bool uh_spellcardactive;
bool uh_spellcardbroken;
int uh_spellcardtimeleft;
int uh_spellcardphase;
int uh_spellcardtimergen;  // bump on each Start; stale Always timers must not tick

str uh_spellcardnamelist[UH_SC_PHASE_MAX + 1] = {
	"",
	"",  // Nonspell 1 — no name HUD
	"Hell Sign: Eclipse of Hell",
	"",  // Nonspell 2
	"Hell Sign: Star and Stripe",
	"",  // Nonspell 3
	"Hellfire: Infernal Essence of Grazing",
	"Inferno: Striped Abyss",
	"Apollo Hoax Theory"
};

function str UH_SpellCardNameOf(int phaseid) {
	if (phaseid < 1 || phaseid > UH_SC_PHASE_MAX)
		return "";
	return uh_spellcardnamelist[phaseid];
}

// Named spell cards only (not nonspells 1/3/5)
function bool UH_SpellCardShowsName(int phaseid) {
	return (phaseid == 2 || phaseid == 4 || phaseid == 6 || phaseid == 7 || phaseid == 8);
}

// Spell-card bonus stages only — nonspells 1/3/5 never announce or reward
function bool UH_SpellCardIsBonusPhase(int phaseid) {
	return UH_SpellCardShowsName(phaseid);
}

// LoLK survival spells (Time Sign): W2 Eclipse of Hell, W8 Apollo Hoax
function bool UH_SpellCardIsSurvival(int phaseid) {
	return (phaseid == 2 || phaseid == 8);
}

function void UH_SpellCardClearHud(void) {
	ClearHudMessageBold(UH_SC_HUD_NAME);
	ClearHudMessageBold(UH_SC_HUD_TIMER);
}

function void UH_SpellCardDrawHud(int timeleft, int phaseid) {
	int color;

	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	if (UH_SpellCardShowsName(phaseid))
		HudMessageBold(s:UH_SpellCardNameOf(phaseid); HUDMSG_PLAIN, UH_SC_HUD_NAME, CR_GOLD, 320.4, 36.0, 0);
	else
		ClearHudMessageBold(UH_SC_HUD_NAME);
	if (timeleft <= 4)
		color = CR_RED;
	else if (timeleft <= 9)
		color = CR_BRICK;
	else
		color = CR_WHITE;
	HudMessageBold(i:timeleft; HUDMSG_PLAIN, UH_SC_HUD_TIMER, color, 320.4, 52.0, 0);
}

function void UH_SpellCardAnnounceResult(str msg, int color) {
	SetFont("BIGFONT");
	SetHudSize(640, 480, 0);
	HudMessageBold(s:msg; HUDMSG_FADEOUT, UH_SC_HUD_RESULT, color, 320.4, 72.0, 3.0, 1.0);
}

function void UH_SpellCardStopTimer(void) {
	uh_spellcardactive = false;
	uh_spellcardtimergen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
}

function void UH_SpellCardEndQuiet(void) {
	UH_SpellCardStopTimer();
	uh_spellcardbroken = false;
	uh_spellcardtimeleft = 0;
	UH_SpellCardClearHud();
}

function void UH_SpellCardGiveSurvivorBoxes(void) {
	int j;
	for (j = 0; j < MAX_PLAYERS; j++) {
		if (!PlayerInGame(j))
			continue;
		if (playerlifestatusarr[j] != PLS_SURVIVOR)
			continue;
		GiveActorInventory(j + 1000, "SurvivorBoxItems_P", 1);
	}
}

// Time Sign end: drop flag and strip ALL PlayerPropertyInvulnerable stacks.
// core_invulnerableplayer(false) only pops one layer; APROP stays if stacks remain.
function void UH_ClownpieceClearSurvInv(void) {
	int tid;
	int old;

	old = ActivatorTID();
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (!CheckActorInventory(tid, "ClownpieceSurvivalInvuln_F")
			&& CheckActorInventory(tid, "PlayerPropertyInvulnerable") < 1)
			continue;
		TakeActorInventory(tid, "ClownpieceSurvivalInvuln_F", 1);
		TakeActorInventory(tid, "ClownpiecePhaseInvulnTics", 999);
		TakeActorInventory(tid, "PlayerPropertyInvulnerable", 999);
		SetActivator(tid);
		SetActorProperty(0, APROP_INVULNERABLE, false);
	}
	if (old)
		SetActivator(old);
	else
		SetActivator(0);
}

function void UH_SpellCardCaptureSuccess(void) {
	UH_SpellCardStopTimer();
	UH_SpellCardAnnounceResult("Get Spell Card Bonus!", CR_YELLOW);
	AmbientSound("Touhou/SpellCardGet", 127);
	UH_SpellCardGiveSurvivorBoxes();
	AmbientSound("Touhou/SpellCardBonus", 127);
	uh_spellcardbroken = false;
}

// mode: FAIL / DAMAGE (need timeLeft>0) / SURVIVAL timeout (!Broken, ignore time)
// Nonspells (1/3/5): quiet stop only — no Bonus!/Failed announce, no boxes.
function void UH_SpellCardTryCaptureOrFail(int mode) {
	if (!uh_spellcardactive && !uh_spellcardbroken)
		return;

	if (!UH_SpellCardIsBonusPhase(uh_spellcardphase)) {
		UH_SpellCardStopTimer();
		uh_spellcardbroken = false;
		if (uh_spellcardphase >= UH_SC_PHASE_MAX)
			UH_SpellCardClearHud();
		return;
	}

	if (mode == UH_SC_RESOLVE_SURVIVAL && uh_spellcardactive && !uh_spellcardbroken)
		UH_SpellCardCaptureSuccess();
	else if (mode == UH_SC_RESOLVE_DAMAGE && uh_spellcardactive && !uh_spellcardbroken && uh_spellcardtimeleft > 0)
		UH_SpellCardCaptureSuccess();
	else {
		UH_SpellCardStopTimer();
		UH_SpellCardAnnounceResult("Bonus Failed...", CR_RED);
		uh_spellcardbroken = false;
	}

	if (uh_spellcardphase >= UH_SC_PHASE_MAX)
		UH_SpellCardClearHud();
}

script "uh_SpellCardStart" (int phaseid, int timelimitsec) {
	if (phaseid < 1 || phaseid > UH_SC_PHASE_MAX)
		phaseid = 1;
	if (timelimitsec < 1)
		timelimitsec = 1;

	if (uh_spellcardactive && phaseid == uh_spellcardphase)
		terminate;
	if (phaseid < uh_spellcardphase)
		terminate;

	uh_spellcardtimergen++;
	ACS_NamedTerminate("uh_SpellCardTimer", 0);
	UH_SpellCardClearHud();

	uh_spellcardphase = phaseid;
	uh_spellcardtimeleft = timelimitsec;
	uh_spellcardbroken = false;
	uh_spellcardactive = true;

	UH_SpellCardDrawHud(uh_spellcardtimeleft, uh_spellcardphase);
	ACS_NamedExecuteAlways("uh_SpellCardTimer", 0, uh_spellcardtimergen);
}

script "uh_ClownpieceBroadcastPhase" (int tophase) {
	if (tophase < 2 || tophase > UH_SC_PHASE_MAX)
		terminate;

	// Damage life-break settle (timeout already resolved before calling this)
	UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);

	AmbientSound("Touhou/Cat0", 127);

	str swapp = StrParam(s:"ClownpieceForceSwap_W", i:tophase, s:"_P");
	int tid;
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, swapp, 1);
	}
}

script "uh_ClownpieceSelectW" (int phase) {
	Delay(1);
	if (phase < 1 || phase > UH_SC_PHASE_MAX)
		terminate;
	str wep = StrParam(s:"Clownpiece_W", i:phase);
	if (!CheckInventory(wep))
		terminate;
	SetWeapon(wep);
}

script "uh_SpellCardTimer" (int mygen) {
	int phase;

	while (uh_spellcardactive && uh_spellcardtimeleft > 0) {
		if (mygen != uh_spellcardtimergen)
			terminate;
		UH_SpellCardDrawHud(uh_spellcardtimeleft, uh_spellcardphase);
		if (uh_spellcardtimeleft <= 9 && uh_spellcardtimeleft >= 5)
			AmbientSound("Touhou/Timeout", 127);
		if (uh_spellcardtimeleft <= 4)
			AmbientSound("Touhou/Timeout2", 127);
		Delay(UH_SC_TICRATE);
		if (mygen != uh_spellcardtimergen)
			terminate;
		if (!uh_spellcardactive)
			terminate;
		uh_spellcardtimeleft--;
	}

	if (uh_spellcardactive && mygen == uh_spellcardtimergen) {
		phase = uh_spellcardphase;
		if (UH_SpellCardIsSurvival(phase))
			UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_SURVIVAL);
		else
			UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);

		UH_ClownpieceClearSurvInv();

		if (phase >= UH_SC_PHASE_MAX)
			ACS_NamedExecuteAlways("uh_ClownpieceTimeoutKill", 0);
		else
			ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, phase + 1);
	}
}

script "uh_ClownpieceTimeoutKill" (void) {
	int tid;
	for (tid = 1000; tid <= 1063; tid++) {
		if (!PlayerInGame(tid - 1000))
			continue;
		if (CheckActorInventory(tid, "IsDead"))
			continue;
		GiveActorInventory(tid, "ClownpieceTimeoutKill_P", 1);
	}
}

script "uh_SpellCardResolve" (int mode) {
	UH_SpellCardTryCaptureOrFail(mode);
}

script "uh_SpellCardCapture" (void) {
	if (!uh_spellcardactive)
		terminate;
	if (uh_spellcardbroken || uh_spellcardtimeleft <= 0) {
		UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
		terminate;
	}
	UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_DAMAGE);
}

script "uh_SpellCardFail" (void) {
	if (!uh_spellcardactive && !uh_spellcardbroken)
		terminate;
	UH_SpellCardTryCaptureOrFail(UH_SC_RESOLVE_FAIL);
}

script "uh_SpellCardBreak" (void) {
	if (uh_spellcardactive)
		uh_spellcardbroken = true;
}

script "uh_SpellCardStop" (void) {
	UH_SpellCardEndQuiet();
}

script "uh_SpellCardIsActive" (void) {
	SetResultValue(uh_spellcardactive);
}

script "uh_SpellCardGetTimeLeft" (void) {
	SetResultValue(uh_spellcardtimeleft);
}

// Strip all invuln stacks + APROP (core_invulnerableplayer false only pops one layer)
script "uh_StripInvulnStacks" (void) {
	TakeInventory("PlayerPropertyInvulnerable", 999);
	SetActorProperty(0, APROP_INVULNERABLE, false);
}

// Boss unmorph: the spell-card session is library-global (phase, timer
// generation, HUD), so a shadow fakeout must cancel it here.  Otherwise the
// stale session keeps its timer running, keeps handing out phase swaps and
// would make a later Clownpiece's uh_SpellCardStart silently refuse to start.
// Only this player's own phase markers are dropped; the PlayerProperty stack
// layers themselves are returned by the generic demorph baseline.
script "uh_ClownpieceUnmorphCancel" (void) {
	UH_SpellCardEndQuiet();
	TakeInventory("ClownpiecePhaseInvulnTics", 999);
	TakeInventory("ClownpieceSurvivalInvuln_F", 1);
	TakeInventory("ClownpieceGetUpDone_F", 1);
	TakeInventory("ClownpiecePainFlag", 1);
	TakeInventory("ClownpieceOrbFlag", 1);
	TakeInventory("DuoBusterFlag", 1);
}

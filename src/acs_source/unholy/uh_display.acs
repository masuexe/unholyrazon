#define LMSEVENT_ICON_X -220.0
#define LMSEVENT_ICON_Y 20.0
#define LMSEVENT_SLIDE_DIST 36.0
#define LMSEVENT_IN_TICS 10
#define LMSEVENT_OUT_TICS 10
#define LMSEVENT_HOLD_TICS (8 * 35)

// v6b and CBM use global slots 3-11 and 30-31; slot 32 is reserved here for
// the HUD lifecycle serial so reentry can invalidate older CLIENTSIDE scripts.
global int 32:lmsevent_hud_serial;

script "ub_LMS_EventIconStart" (int lmsnum, int isitrare, int badevent) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_LMS_EventIcon", 0, lmsnum, isitrare, badevent);
}

script "ub_LMS_EventIcon" (int lmsnum, int isitrare, int badevent) CLIENTSIDE {
	str iconfont;
	if (badevent) {
		if (lmsnum >= 0 && lmsnum <= 12) {iconfont = StrParam(s:"LMS_B#", i:lmsnum);}
		else {iconfont = "LMS_B#0";}
	}
	else {
		if (isitrare) {iconfont = GetLMSEventrareicon(lmsnum);}
		else {iconfont = GetLMSEventIcon(lmsnum);}
		if (StrCmp(iconfont, "") == 0) {
			if (isitrare) {iconfont = StrParam(s:"LMS_X#", i:lmsnum);}
			else {iconfont = StrParam(s:"LMS_E#", i:lmsnum);}
		}
	}
	SetFont(iconfont);

	SetHudSize(640, 480, 0);
	int x_aspect = GetHudRight(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 640.0;
		y_aspect = 0.0;
	}

	int target_x = x_aspect + LMSEVENT_ICON_X;
	int target_y = y_aspect + LMSEVENT_ICON_Y;
	lmsevent_hud_serial++;
	int my_serial = lmsevent_hud_serial;
	int i;
	int progress;
	int inv_p;
	int ease;
	int raw_x;
	int draw_x;
	int draw_y;
	int cur_alpha;

	// 1. Entrance: Slide-in from right with Ease-Out Quad
	for (i = 1; i <= LMSEVENT_IN_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_IN_TICS * 1.0);
		inv_p = 1.0 - progress;
		ease = 1.0 - FixedMul(inv_p, inv_p);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, 1.0 - ease);

		// HudMessage uses the first decimal place as an alignment flag. Round
		// the animated position to a whole pixel, then force left/top alignment.
		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, ease);
		Delay(1);
	}

	// 2. Hold phase: settle at target position
	draw_x = (RoundFixedToInt(target_x) * 1.0) + 0.1;
	draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;
	HudMessage(s:"A"; 0, -14836, -1, draw_x, draw_y, FixedDiv(LMSEVENT_HOLD_TICS * 1.0, 35.0) + 0.5, 1.0);

	for (i = 0; i < LMSEVENT_HOLD_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		Delay(1);
	}

	// 3. Exit: Slide-out to right with Ease-In Quad & fade out
	for (i = 1; i <= LMSEVENT_OUT_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_OUT_TICS * 1.0);
		ease = FixedMul(progress, progress);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, ease);
		cur_alpha = 1.0 - progress;

		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, cur_alpha);
		Delay(1);
	}

	if (my_serial == lmsevent_hud_serial) {
		HudMessage(s:""; 0, -14836, -1, 0.0, 0.0, 0.0);
	}
}


script "uh_getcurrentmusic" (int which) {
	if (CheckInventory("NetScriptAntiSpam2")) {
		terminate;
	}
	GiveInventory("NetScriptAntiSpam2", 1);

	ACS_NamedExecuteAlways("uh_displaycurrentmusic", 0);
}

script "uh_displaycurrentmusic" (void) NET CLIENTSIDE {
	if (ConsolePlayerNumber() != PlayerNumber()) {
		terminate;
	}

	ACS_NamedExecuteAlways("ub_FancyDisplayMusic", 0, 0);
}



#define MUSIC_CARD_WIDTH 270.0
#define MUSIC_CARD_HEIGHT 42.0
#define MUSIC_CARD_OFFSET_X -286.0
#define MUSIC_CARD_OFFSET_Y -62.0
#define MUSIC_CARD_SLIDE_DIST 36.0
#define MUSIC_CARD_IN_TICS 10
#define MUSIC_CARD_OUT_TICS 10
#define MUSIC_CARD_HOLD_TICS (4 * 35 + 18)

global int 33:fancytunedisplay_serial;

script "ub_FancyDisplayMusicStart" (int garbagetext) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_FancyDisplayMusic", 0, garbagetext);
}

script "ub_FancyDisplayMusic" (int togglegarbage) CLIENTSIDE {
	str tunecode_str = GetCVarString("_uh_ServMusicLump");
	str musical_str = GetCVarString("_uh_ServMusicCredits");

	if (togglegarbage) {
		tunecode_str = "???";
		musical_str = "Corrupted - Unknown Track";
	}

	// Console copy for player reference (always logged even if HUD card is disabled)
	Log(s:"\c[Gold]Now Playing: \c[White]", s:musical_str, s:" \c[LightBlue][", s:tunecode_str, s:"]");

	int display_mode = GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay");
	if (display_mode <= 0) {
		terminate;
	}

	// Three-line card: split "origin - title" so line 2 is the track name and
	// line 3 is the origin/album (empty -> line 3 is not drawn).
	str origin_str = "";
	str title_str = "";
	int len = StrLen(musical_str);
	int split_pos = -1;
	int c;

	for (c = 0; c < len - 2; c++) {
		if (GetChar(musical_str, c) == ' ' &&
		    GetChar(musical_str, c + 1) == '-' &&
		    GetChar(musical_str, c + 2) == ' ') {
			split_pos = c;
			break;
		}
	}

	if (split_pos >= 0) {
		for (c = 0; c < split_pos; c++) {
			origin_str = StrParam(s:origin_str, c:GetChar(musical_str, c));
		}
		for (c = split_pos + 3; c < len; c++) {
			title_str = StrParam(s:title_str, c:GetChar(musical_str, c));
		}
	} else {
		title_str = musical_str;
		origin_str = "";
	}

	// Safety truncation: a 270px line comfortably fits ~30 UIX chars.
	if (StrLen(title_str) > 30) {
		str trunc_t = "";
		for (c = 0; c < 27; c++) { trunc_t = StrParam(s:trunc_t, c:GetChar(title_str, c)); }
		title_str = StrParam(s:trunc_t, s:"...");
	}
	if (StrLen(origin_str) > 30) {
		str trunc_o = "";
		for (c = 0; c < 27; c++) { trunc_o = StrParam(s:trunc_o, c:GetChar(origin_str, c)); }
		origin_str = StrParam(s:trunc_o, s:"...");
	}

	SetHudSize(640, 480, 0);
	int x_aspect = GetHudRight(640) * 1.0;
	int y_aspect = GetHudBot(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 640.0;
		y_aspect = 480.0;
	}

	if (display_mode == 2) {
		// Mode 2: Minimal Text (v7a style fast typewriter typeon & fadeout, right-aligned at bottom right)
		fancytunedisplay_serial++;
		int text_x = (RoundFixedToInt(x_aspect - 16.0) * 1.0) + 0.2;
		int text_y = (RoundFixedToInt(y_aspect - 72.0) * 1.0) + 0.2;

		str min_text = "";
		if (StrLen(origin_str) > 0) {
			min_text = StrParam(s:"\ckNow Playing: \c[White]", s:title_str, s:"\n\cd(", s:origin_str, s:") \cl[", s:tunecode_str, s:"]");
		} else {
			min_text = StrParam(s:"\ckNow Playing: \c[White]", s:title_str, s:" \cl[", s:tunecode_str, s:"]");
		}

		SetFont("SMALLFONT");
		HudMessage(s:min_text; HUDMSG_TYPEON, -68741, -1, text_x, text_y, 4.0, 0.02, 1.5);
		HudMessage(s:""; 0, -68742, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68743, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68744, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
		terminate;
	}

	int base_target_x = x_aspect + MUSIC_CARD_OFFSET_X;
	int base_target_y = y_aspect + MUSIC_CARD_OFFSET_Y;

	fancytunedisplay_serial++;
	int my_serial = fancytunedisplay_serial;
	int i;
	int progress;
	int inv_p;
	int ease;
	int raw_x;
	int draw_x;
	int draw_y;

	// 1. Entrance: Slide in from right with Ease-Out Quad
	for (i = 1; i <= MUSIC_CARD_IN_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		progress = FixedDiv(i * 1.0, MUSIC_CARD_IN_TICS * 1.0);
		inv_p = 1.0 - progress;
		ease = 1.0 - FixedMul(inv_p, inv_p);
		raw_x = base_target_x + FixedMul(MUSIC_CARD_SLIDE_DIST, 1.0 - ease);

		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		draw_y = (RoundFixedToInt(base_target_y) * 1.0) + 0.1;

		// Card background
		SetFont("MUSCARD");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, draw_x, draw_y, 0.2, FixedMul(0.85, ease));

		// Music note symbol (STCFN600)
		SetFont("STCFN600");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, draw_x + 6.0, draw_y + 5.0, 0.2, ease);

		// Line 1: NOW PLAYING [lump]
		SetFont("SMALLFONT");
		HudMessage(s:"\ckNOW PLAYING \cl[", s:tunecode_str, s:"]"; HUDMSG_ALPHA, -68743, -1, draw_x + 18.0, draw_y + 5.0, 0.2, ease);

		// Line 2: track title
		HudMessage(s:"\c[White]", s:title_str; HUDMSG_ALPHA, -68744, -1, draw_x + 18.0, draw_y + 17.0, 0.2, ease);

		// Line 3: origin / album (omitted when empty)
		if (StrLen(origin_str) > 0) {
			HudMessage(s:"\cd", s:origin_str; HUDMSG_ALPHA, -68745, -1, draw_x + 18.0, draw_y + 29.0, 0.2, ease);
		} else {
			HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
		}

		Delay(1);
	}

	// 2. Hold phase: fully settled in place
	int final_x = (RoundFixedToInt(base_target_x) * 1.0) + 0.1;
	int final_y = (RoundFixedToInt(base_target_y) * 1.0) + 0.1;
	int hold_secs = FixedDiv(MUSIC_CARD_HOLD_TICS * 1.0, 35.0) + 0.5;

	SetFont("MUSCARD");
	HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, final_x, final_y, hold_secs, 0.85);

	SetFont("STCFN600");
	HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, final_x + 6.0, final_y + 5.0, hold_secs, 1.0);

	SetFont("SMALLFONT");
	HudMessage(s:"\ckNOW PLAYING \cl[", s:tunecode_str, s:"]"; HUDMSG_ALPHA, -68743, -1, final_x + 18.0, final_y + 5.0, hold_secs, 1.0);
	HudMessage(s:"\c[White]", s:title_str; HUDMSG_ALPHA, -68744, -1, final_x + 18.0, final_y + 17.0, hold_secs, 1.0);
	if (StrLen(origin_str) > 0) {
		HudMessage(s:"\cd", s:origin_str; HUDMSG_ALPHA, -68745, -1, final_x + 18.0, final_y + 29.0, hold_secs, 1.0);
	}

	for (i = 0; i < MUSIC_CARD_HOLD_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		Delay(1);
	}

	// 3. Exit: Slide out to right with Ease-In Quad & fade out
	for (i = 1; i <= MUSIC_CARD_OUT_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		progress = FixedDiv(i * 1.0, MUSIC_CARD_OUT_TICS * 1.0);
		ease = FixedMul(progress, progress);
		raw_x = base_target_x + FixedMul(MUSIC_CARD_SLIDE_DIST, ease);
		int cur_alpha = 1.0 - progress;

		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;

		SetFont("MUSCARD");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, draw_x, final_y, 0.2, FixedMul(0.85, cur_alpha));

		SetFont("STCFN600");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, draw_x + 6.0, final_y + 5.0, 0.2, cur_alpha);

		SetFont("SMALLFONT");
		HudMessage(s:"\ckNOW PLAYING \cl[", s:tunecode_str, s:"]"; HUDMSG_ALPHA, -68743, -1, draw_x + 18.0, final_y + 5.0, 0.2, cur_alpha);
		HudMessage(s:"\c[White]", s:title_str; HUDMSG_ALPHA, -68744, -1, draw_x + 18.0, final_y + 17.0, 0.2, cur_alpha);
		if (StrLen(origin_str) > 0) {
			HudMessage(s:"\cd", s:origin_str; HUDMSG_ALPHA, -68745, -1, draw_x + 18.0, final_y + 29.0, 0.2, cur_alpha);
		}

		Delay(1);
	}

	// Clear all 5 message layers
	if (my_serial == fancytunedisplay_serial) {
		HudMessage(s:""; 0, -68741, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68742, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68743, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68744, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
	}
}

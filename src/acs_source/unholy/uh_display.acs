// Clientside Display Zone

// True while any standard boss slot is still alive (no hardcoded slot range).
function bool AnyBossSlotAlive(void) {
  for (int i = 0; i < MAX_BOSSES; i++) {
    if (bossslotalive[i]) {return true;}
  }
  return false;
}

// Vertical row step for persistent boss HUD rows, in fixed pixels.  The
// health/death/rage rows share this 32px portrait spacing, and client
// placement stays independent of the server-side multibosscheck state (map
// variables are not a client's source of truth).
#define BOSSHUD_ROW_STEP 37.0
#define BOSSHUD_BASE_Y_ADJ -27.0
#define BOSSHUD_TEXT_X_BASE 48.1

#define HUDMESSAGE_REFRESHER_RATE 175  // 404
bool refreshhudmessage;
int rage_banner_seq[MAX_BOSSES + 1];

#define RAGE_BANNER_FRAMES 8
str rage_banner_colors[RAGE_BANNER_FRAMES] = {
	"\c[AlertRed]",
	"\c[AlertRedTrans1]",
	"\c[AlertRedTrans2]",
	"\c[AlertRedTrans3]",
	"\c[AlertWhite]",
	"\c[AlertRedTrans3]",
	"\c[AlertRedTrans2]",
	"\c[AlertRedTrans1]"
};
int rage_banner_delays[RAGE_BANNER_FRAMES] = {
	6,
	1,
	1,
	1,
	4,
	1,
	1,
	1
};

script "ub_refreshHudMessageLoop" (void) {
	int cycledelay;
	while (1) {
		cycledelay++;
		Delay(1);
		if (cycledelay >= HUDMESSAGE_REFRESHER_RATE || refreshhudmessage) {
			refreshhudmessage = true;
			Delay(1);
			refreshhudmessage = false;
			cycledelay = 1;
		}
	}
}

// Scripts used by bosses themselves


#define COLORSARRAY_C 18
int thecolorsarray[COLORSARRAY_C] = {9, 2, 1, 0, 6, 17, 18, 8, 10, 5, 3, 16, 21, 7, 13, 19, 20, 12};
script "UH_RainbowHudMessage" (int whoisit, int y_offset) CLIENTSIDE {
	// if(ConsolePlayerNumber() != PlayerNumber()){
	//		terminate;
	// }
	int colornum = random(0, COLORSARRAY_C);
	int y2_offset = y_offset * 5 / 3;  // If VS Event, lower HudMessage
	int alphanum = 1;
	str tipsupperline = "";
	str tipslowerline = "";
	for (int t_p = 0; t_p < 31; t_p++)  // Could just do \x1E \x11
	{
		tipsupperline = StrParam(s:tipsupperline, c:30);
		tipslowerline = StrParam(s:tipslowerline, c:17);
	}

	SetFont("SMALLFONT");
	// Write the formatted instructions to the in-game console via HUDMSG_LOG.
	// In Zandronum, HUDMSG_LOG uses AddToConsole() directly, keeping the chat/notify window clean.
	HudMessage(s:"\c[UH00]", c:29, s:tipsupperline, c:31, s:"\n\n\c-", s:GetBossInstruction(whoisit), s:"\n\n\c[UH00]", c:16, s:tipslowerline, c:18; HUDMSG_LOG, 59, CR_WHITE, 0.5, 0.18, 2.0, 0.0);

	SetHudSize(640, 480, 0);
	SetHudWrapWidth(350);
	if (GetUserCVar(ConsolePlayerNumber(), "uh_cl_ShowTipsOnScreen")) {
		HudMessage(s:GetBossInstruction(whoisit); HUDMSG_TYPEON, 59, CR_RED, 320.0, y2_offset * 1.0 + 72.1, 2.0, 0.05, 2.0);
	}
	else {
		HudMessage(s:"Check your console (", k:"toggleconsole", s:" key) to view flavour text or tips!"; HUDMSG_TYPEON, 59, CR_WHITE, 320.0, y2_offset * 1.0 + 72.1, 3.957, 0.01, 0.571);
	}
	SetHudWrapWidth(0);
	SetHudSize(384, 288, 0);  // 480,360//480,300

	// HudMessage(s:"You are ", s:B_NameStr, s:"\c-!"; HUDMSG_FADEOUT, 66, CR_YELLOW,0.5, 0.10, 3.0,2.0);
	HudMessage(s:"\ckYou are\n\cd"; HUDMSG_FADEINOUT, -6001, -1, 192.4, y_offset * 1.0 + 24.0, 3.957, 0.571, 0.571);
	for (int i = 0; i < 35 * 5; i++) {
		HudMessage(s:"\cd\n\c- (*) ", s:GetBossName(whoisit), s:" \c-(*)"; HUDMSG_ALPHA, -6000, thecolorsarray[colornum], 192.4, y_offset * 1.0 + 24.0, 0.5, 0.05 * alphanum);

		if (i < 20) alphanum++;
		else if (i > 35 * 5 - 20) alphanum--;
		if (i % 5 == 0) colornum++;
		if (colornum > COLORSARRAY_C) colornum = 0;
		Delay(1);
	}
	HudMessage(s:""; 0, -6000, -1, 0.99, 0.01, 1873);
}

#define HELLTIMER_OFFSETX 54.1
#define HELLTIMER_OFFSETY 270.1
script "ub_HellTimerHud" (int timeleft) CLIENTSIDE {
	SetHudSize(640, 480, 0);
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int custom_x = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudX") * 1.0;
	int custom_y = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudY") * 1.0;

	int x = HELLTIMER_OFFSETX + x_aspect + custom_x;
	int y = HELLTIMER_OFFSETY + y_aspect + custom_y;

	SetFont(StrParam(s:"HELTIMR", i:timeleft > 0));
	HudMessage(s:"A"; HUDMSG_FADEOUT, 167, -1, x, y, 2.0, 3.0);
	SetFont("fakefntC");  // SMALLFONT
	HudMessage(i:timeleft; HUDMSG_FADEOUT, 166, CR_GOLD + (timeleft <= 0), x + 18.0, y + 5.0, 2.0, 3.0);
}

script "uh_DrawTimerHud" (int timeleft, int type) CLIENTSIDE {
	if (type == 0) {
		ACS_NamedExecuteWithResult("ub_HellTimerHud", timeleft);
		terminate;
	}

	SetHudSize(640, 480, 0);
	int x_aspect2 = GetHudLeft(640) * 1.0;
	int y_aspect2 = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect2 = 0;
		y_aspect2 = 0;
	}
	int x = 300.1;
	int y = 10.1 + y_aspect2;
	int holdtime = 1.0;
	int alerttime = 60;

	SetFont(StrParam(s:"HELTIMR", i:timeleft > 0));
	HudMessage(s:"A"; HUDMSG_FADEOUT, 169, -1, x, y, holdtime, 3.0);
	SetFont("fakefntC");  // SMALLFONT
	HudMessageBold(i:timeleft; HUDMSG_FADEOUT, 168, CR_GOLD + (timeleft <= alerttime), x + 17.0, y + 5.0, holdtime, 3.0);
}

script "uh_ClearRoundTimerHud" (void) CLIENTSIDE {
	ClearHudMessage(168);
	ClearHudMessage(169);
}


script "ub_DemoneyeNumWatcher" (void) {
	SetActivator(0, AAPTR_NULL);

	int eyecount;
	while (true) {
		if (eyecount != totalplayersarr[6]) {
			eyecount = totalplayersarr[6];
			ACS_NamedExecuteWithResult("ub_DemoneyeNumDisplay", eyecount);
		}
		Delay(1);
		if (refreshhudmessage) {
			if (eyecount > 0) {
				ACS_NamedExecuteWithResult("ub_DemoneyeNumDisplay", eyecount);
				Delay(1);
			}
		}
	}
}
script "ub_DemoneyeNumDisplay" (int eyecount) CLIENTSIDE {
	Func_DemoneyeNumDisplay(eyecount);
}
function void Func_DemoneyeNumDisplay(int eyecount) {
	SetHudSize(640, 480, 0);
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int custom_x = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudX") * 1.0;
	int custom_y = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudY") * 1.0;
	int eye_x = 10.1 + x_aspect + custom_x;
	// Boss 1 border top is at 288.1 + y_aspect + custom_y (theboss = 1).
	// 2px gap above Boss 1 top (icon height 16): 288.1 - 16.0 - 2.0 = 270.1.
	// Matches the 2px vertical spacing between consecutive boss portrait frames.
	int eye_y = 270.1 + y_aspect + custom_y;

	int fader = (eyecount == 0);  // If 0 Eyes, apply Fadeout
	SetFont("EYE_F_0E");
	HudMessage(s:"A"; 0 + fader, -996, -1, eye_x, eye_y, 0, 1.0, 3.0 * fader);
	SetFont("fakefntC");  // SMALLFONT
	HudMessage(s:"\c[MenuPurple]", i:eyecount; 0 + fader, -997, 19, eye_x + 27.0, eye_y + 6.0, 0, 1.0, 3.0 * fader);
}

script "ub_BossHealthWatcher" (void) {
	SetActivator(0, AAPTR_NULL);

	for (int b = 0; b < MAX_BOSSES; b++) {
		bosshparr[b][BOSSHP_HPMEM] = -1;
		bosshparr[b][BOSSHP_ARMORMEM] = -1;
		bosshparr[b][BOSSHP_EXTRALIFEMEM] = -1;
		bosshparr[b][BOSSHP_ARMORSAVEMEM] = -1;
	}

	until (AnyBossSlotAlive()) {
		Delay(1);
	}
	while (AnyBossSlotAlive()) {

		Func_BHW_ShowHudMess(false);
		Delay(1);
		if (refreshhudmessage) {
			Func_BHW_ShowHudMess(true);
			Delay(1);
		}
	}
	UH_Log(UH_LOG_DEBUG, StrParam(s:"ub_BossHealthWatcher FINISHED!"));
	Func_BHW_ShowHudMess(true);
}

function void Func_BHW_ShowHudMess(bool force) {
	for (int i = multibosscheck - 1; i >= 0; i--) {
		Func_BHW_Checker(i, bossdataarr[i][BOSSDATA_TID], bossdataarr[i][BOSSDATA_NUM], force);
	}
}

function void Func_BHW_Checker(int numb, int tidofboss, int whichboss, bool force) {
	if (PlayerInGame(tidofboss - 1000) && bossslotalive[numb]) {
		bosshparr[numb][BOSSHP_CURRHP] = GetActorProperty(tidofboss, APROP_HEALTH);
		bosshparr[numb][BOSSHP_CURRARMOR] = CheckActorInventory(tidofboss, "BasicArmor");
		if (bosshparr[numb][BOSSHP_CURRHP] <= 0) {  // Boss is Dead!
			if (timer() <= 35 * 30) {bosshparr[numb][BOSSHP_DEATH] = 6;}
			else {bosshparr[numb][BOSSHP_DEATH] = 5;}
			Func_BHW_DeadHudMess(numb + 1, whichboss, bosshparr[numb][BOSSHP_DEATH]);
			bossslotalive[numb] = false;
		}
		else if (shadowrevealactive && shadowtricksarr[numb]) {  // During Shadow, show Blue
			Func_BHW_DeadHudMess(numb + 1, whichboss, 8);
		}
		else {
			int extralife = CheckActorInventory(tidofboss, "PlayerPropertyExtraLife");
			if (extralife < 0)
				extralife = 0;
			if (extralife > 15)
				extralife = 15;

			int armorsave = 0;
			if (bosshparr[numb][BOSSHP_CURRARMOR] > 0) {
				if (SetActivator(tidofboss)) {
					armorsave = FixedMul(GetArmorInfo(ARMORINFO_SAVEPERCENT), 100.0) >> 16;
					SetActivator(0, AAPTR_NULL);
				}
			}

			if (bosshparr[numb][BOSSHP_HPMEM] != bosshparr[numb][BOSSHP_CURRHP] ||
			    bosshparr[numb][BOSSHP_ARMORMEM] != bosshparr[numb][BOSSHP_CURRARMOR] ||
			    bosshparr[numb][BOSSHP_EXTRALIFEMEM] != extralife ||
			    bosshparr[numb][BOSSHP_ARMORSAVEMEM] != armorsave ||
			    force) {
				bosshparr[numb][BOSSHP_HPMEM] = bosshparr[numb][BOSSHP_CURRHP];
				bosshparr[numb][BOSSHP_ARMORMEM] = bosshparr[numb][BOSSHP_CURRARMOR];
				bosshparr[numb][BOSSHP_EXTRALIFEMEM] = extralife;
				bosshparr[numb][BOSSHP_ARMORSAVEMEM] = armorsave;
				Func_BHW_HudMess(numb + 1, whichboss, bosshparr[numb][BOSSHP_HPMEM], bosshparr[numb][BOSSHP_ARMORMEM], extralife, armorsave);
			}
		}
	}
	else if (bossslotalive[numb]) {  // Boss Spectated!
		bosshparr[numb][BOSSHP_ARMORMEM] = -1;
		bosshparr[numb][BOSSHP_DEATH] = 7;
		Func_BHW_DeadHudMess(numb + 1, whichboss, bosshparr[numb][BOSSHP_DEATH]);
		bossslotalive[numb] = false;
	}
	else if (force) {
		Func_BHW_DeadHudMess(numb + 1, whichboss, bosshparr[numb][BOSSHP_DEATH]);
	}
}

script "ub_BHW_HudClientside" (int packed_boss, int bossnumb, int health, int packed_armor) CLIENTSIDE {
	int theboss = packed_boss & 0x0F;
	int extralife = (packed_boss >> 4) & 0x0F;
	int armor = packed_armor >> 8;
	int armorsave = packed_armor & 0xFF;
	Func_BHW_HudMess2(theboss, bossnumb, health, armor, extralife, armorsave);
}

function void Func_BHW_HudMess(int theboss, int bossnumb, int health, int armor, int extralife, int armorsave) {
	int packed_boss = (theboss & 0x0F) | ((extralife & 0x0F) << 4);
	int packed_armor = (armor << 8) | (armorsave & 0xFF);
	ACS_NamedExecuteWithResult("ub_BHW_HudClientside", packed_boss, bossnumb, health, packed_armor);
}

// BossNumb survivor HUD packing (parade / class face):
//   vanilla class: -100 - sid                 (-100 .. -(100+UH_MAX_VANILLA_SURV-1))
//   custom class:  -300 - SurvCustomIndex(sid) (<= -300, > -600)
//   shiny vanilla: -600 - sid                 (<= -600) — clears -1..-99 for custom bosses
function int EncodeSurvivorBossNumb(int sid) {
	if (sid == UHSURV_FAIL)
		return 0;
	if (sid >= 0)
		return sid * -1 - 100;
	return -300 - SurvCustomIndex(sid);
}

function int EncodeSurvivorShinyBossNumb(int sid) {
	if (sid == UHSURV_FAIL)
		return 0;
	if (sid >= 0)
		return -600 - sid;
	// Custom survivors: table mugshot via class band (no C-ICN).
	return EncodeSurvivorBossNumb(sid);
}

function int DecodeSurvivorBossNumb(int bossnumb) {
	// Order matters: shiny <= -600 is also <= -300.
	if (bossnumb <= -600)
		return (bossnumb + 600) * -1;
	if (bossnumb <= -300)
		return -1 - (-300 - bossnumb);
	if (bossnumb <= -100)
		return (bossnumb + 100) * -1;
	return UHSURV_FAIL;
}

function bool IsSurvivorBossNumb(int bossnumb) {
	return bossnumb <= -100;
}

function bool IsSurvivorShinyBossNumb(int bossnumb) {
	return bossnumb <= -600;
}

// Demoneye BossNumb packing:
//   vanilla eye: 1000 + id          (0→1000, 32→1032, 100→1100)
//   custom eye:  2000 + EyeCustomIndex(id)  (clears 0..999 boss band)
function int EncodeEyeBossNumb(int eyeid) {
	if (eyeid == UHEYE_FAIL)
		return 0;
	if (eyeid >= 0)
		return 1000 + eyeid;
	return 2000 + EyeCustomIndex(eyeid);
}

function int DecodeEyeBossNumb(int bossnumb) {
	if (bossnumb >= 2000)
		return -1 - (bossnumb - 2000);
	if (bossnumb >= 1000)
		return bossnumb - 1000;
	return UHEYE_FAIL;
}

function bool IsEyeBossNumb(int bossnumb) {
	return bossnumb >= 1000;
}

function int BossHudXOffset(int x_aspect) {
	int custom_x = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudX") * 1.0;
	return x_aspect + custom_x;
}

function int BossHudYOffset(int theboss, int y_aspect) {
	int custom_y = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossHudY") * 1.0;
	return theboss * BOSSHUD_ROW_STEP + BOSSHUD_BASE_Y_ADJ + y_aspect + custom_y;
}

function int BossHudTextYOffset(int addtoy) {
	int custom_text_y = GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossTextY") * 1.0;
	return 280.1 + addtoy + custom_text_y;
}

function void Func_BHW_DrawMugAndBorder(int theboss, int bossnumb, int x_aspect, int addtoy) {
	// 1. Layer -980: Solid black backing to ensure transparent boss mugshots (e.g. UFACE54/62/67/68/73/75)
	// render cleanly without 3D scene bleed-through
	if (CheckFont("MG_FBLK")) {
		SetFont("MG_FBLK");
		HudMessage(s:"A"; 0, -980 - theboss, -1, 10.1 + x_aspect, 280.1 + addtoy, 0, 1.0);
	}

	// 2. Layer -1000: Boss Mugshot (32x32)
	Func_BHW_SetFontMug(bossnumb);
	HudMessage(s:"A"; 0, -1000 - theboss, -1, 10.1 + x_aspect, 280.1 + addtoy, 0, 1.0);

	// 3. Layer -1030: Boss Border Frame (36x36 compact border)
	if (CheckFont("MG_OTL1S")) {
		SetFont("MG_OTL1S");
		HudMessage(s:"A"; 0, -1030 - theboss, -1, 10.1 - 2.0 + x_aspect, 280.1 - 2.0 + addtoy, 0, 1.0);
	}
	else {
		ClearHudMessage(-1030 - theboss);
	}
}

function void Func_BHW_HudMess2(int theboss, int bossnumb, int health, int armor, int extralife, int armorsave) {
	SetHudSize(640, 480, 0);  // 640,512
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int cur_x = BossHudXOffset(x_aspect);
	int addtoy = BossHudYOffset(theboss, y_aspect);

	Func_BHW_DrawMugAndBorder(theboss, bossnumb, cur_x, addtoy);

	// Clear any death tint and icon overlays in case of revival
	ClearHudMessage(-1040 - theboss);
	ClearHudMessage(-1050 - theboss);

	SetFont("SMALLFONT");
	str namestr;
	if (IsSurvivorBossNumb(bossnumb))
		namestr = GetSurvivorName(DecodeSurvivorBossNumb(bossnumb));
	else if (IsEyeBossNumb(bossnumb))
		namestr = GetEyeHudName(DecodeEyeBossNumb(bossnumb));
	else
		namestr = GetBossName(bossnumb);

	int text_x = BOSSHUD_TEXT_X_BASE + cur_x;
	int text_y = BossHudTextYOffset(addtoy);

	if (extralife > 0) {
		HudMessage(s:namestr, s:" \ck[+", i:extralife, s:"]"; 0, -990 - theboss, -1, text_x, text_y, 0, 1.0);
	}
	else {
		HudMessage(s:namestr; 0, -990 - theboss, -1, text_x, text_y, 0, 1.0);
	}

	HudMessage(s:"\c[UB0HP]", i:health; 0, -1010 - theboss, -1, text_x, text_y + 10.0, 0, 1.0);
	if (armor >= 1) {
		if (armorsave > 0) {
			HudMessage(s:"\c[UB0AR]", i:armor, s:" \cu(", i:armorsave, s:"%)"; 0, -1020 - theboss, -1, text_x, text_y + 20.0, 0, 1.0);
		}
		else {
			HudMessage(s:"\c[UB0AR]", i:armor; 0, -1020 - theboss, -1, text_x, text_y + 20.0, 0, 1.0);
		}
	}
	else {
		ClearHudMessage(-1020 - theboss);
	}
}

function void Func_BHW_DeadHudMess(int theboss, int bossnumb, int demisetype) {
	ACS_NamedExecuteWithResult("ub_BHW_DeadHudClientside", theboss, bossnumb, demisetype);
}


script "ub_BHW_DeadHudClientside" (int theboss, int bossnumb, int demisetype) CLIENTSIDE {
	Func_BHW_DeadHudMess2(theboss, bossnumb, demisetype);
}

function void Func_BHW_SetFontMug(int bossnumb) {
	str fontstr;
	// Survivor-packed bands (<= -100, includes shiny <= -600): never GetBossMugshot.
	if (IsSurvivorBossNumb(bossnumb)) {
		int sidsurv = DecodeSurvivorBossNumb(bossnumb);
		str mugsurv = GetSurvivorMugshotRaw(sidsurv);
		if (StrCmp(mugsurv, "") != 0)
			fontstr = mugsurv;
		else if (IsSurvivorShinyBossNumb(bossnumb))
			fontstr = StrParam(s:"C-ICN", i:sidsurv);
		else if (sidsurv >= 0)
			fontstr = StrParam(s:"C@ICN", i:sidsurv);
		else
			fontstr = "NOFAC_0";
		if (CheckFont(fontstr))
			SetFont(fontstr);
		else
			SetFont("NOFAC_0");
		return;
	}
	str mug = GetBossMugshot(bossnumb);
	if (StrCmp(mug, "") != 0) {
		fontstr = mug;
		if (CheckFont(fontstr))
			SetFont(fontstr);
		else
			SetFont("NOFAC_0");
		return;
	}
	if (bossnumb >= 1000) {  // Demoneye (vanilla 1000+id or custom 2000+idx)
		int eidmug = DecodeEyeBossNumb(bossnumb);
		str eyemug = GetEyeMugshot(eidmug);
		if (StrCmp(eyemug, "") != 0)
			fontstr = eyemug;
		else if (eidmug >= 0)
			fontstr = StrParam(s:"EYE_F", i:eidmug);
		else
			fontstr = "NOFAC_0";
	}
	else if (bossnumb >= 0) {  // Boss
		fontstr = StrParam(s:"UFACE", i:bossnumb);
	}
	else
		fontstr = "NOFAC_0";
	if (CheckFont(fontstr))
		SetFont(fontstr);
	else
		SetFont("NOFAC_0");
}

function void Func_BHW_DeadHudMess2(int theboss, int bossnumb, int demisetype) {
	SetHudSize(640, 480, 0);  // 640,512
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int cur_x = BossHudXOffset(x_aspect);
	int addtoy = BossHudYOffset(theboss, y_aspect);

	if (theboss >= 1 && theboss <= MAX_BOSSES) {
		rage_banner_seq[theboss] = 0;
	}
	ClearHudMessage(-1060 - theboss);  // Clear Rage
	ClearHudMessage(-1070 - theboss);  // Clear Rage Banner
	HudMessage(s:""; 0, -1060 - theboss, -1, 0.99, 0.01, 1873);

	// 1. Mugshot, black backing, and border
	Func_BHW_DrawMugAndBorder(theboss, bossnumb, cur_x, addtoy);

	// 2. Tint overlay
	str tintfont = StrParam(s:"UFACE0", i:demisetype * 11);
	if (CheckFont(tintfont)) {
		SetFont(tintfont);
		HudMessage(s:"A"; 0, -1040 - theboss, -1, 10.1 + cur_x, 280.1 + addtoy, 0, 1.0);
	}
	else {
		ClearHudMessage(-1040 - theboss);
	}

	// 3. Demise icon
	str iconfont = StrParam(s:"UFACE00", i:demisetype);
	if (CheckFont(iconfont)) {
		SetFont(iconfont);
		HudMessage(s:"A"; 0, -1050 - theboss, -1, 10.1 + cur_x, 280.1 + addtoy, 0, 1.0);
	}
	else {
		ClearHudMessage(-1050 - theboss);
	}

	int text_x = BOSSHUD_TEXT_X_BASE + cur_x;
	int text_y = BossHudTextYOffset(addtoy);

	// 4. Grayed-out boss name
	SetFont("SMALLFONT");
	str namestr;
	if (IsSurvivorBossNumb(bossnumb))
		namestr = GetSurvivorName(DecodeSurvivorBossNumb(bossnumb));
	else if (IsEyeBossNumb(bossnumb))
		namestr = GetEyeHudName(DecodeEyeBossNumb(bossnumb));
	else
		namestr = GetBossName(bossnumb);
	HudMessage(s:"\c[UB0DC]", s:namestr; 0, -990 - theboss, -1, text_x, text_y, 0, 1.0);

	// 5. Status text in health line (-1010)
	str statustext;
	switch (demisetype) {
		case 6:  // Fast death (<= 30 seconds)
			statustext = "\c[UB004]DESTROYED";
			break;
		case 7:  // Spectator / retired
			statustext = "\c[UB105]RETIRED";
			break;
		case 8:  // Shadow reveal
			statustext = "\c[UB0DC]???";
			break;
		case 5:  // Normal death
		default:
			statustext = "\c[UB0DC]DEAD";
			break;
	}
	HudMessage(s:statustext; 0, -1010 - theboss, -1, text_x, text_y + 10.0, 0, 1.0);

	// 6. Clear armor line (-1020)
	ClearHudMessage(-1020 - theboss);
}

script "ub_RageDisplay" (void) {
	int act_tid = ActivatorTID();
	SetActivator(0, AAPTR_NULL);
	int curr_hp = GetActorProperty(act_tid, APROP_Health);
	int rage_max = CheckActorInventory(act_tid, "UnholyPowerLimit_F");
	if (curr_hp <= 0 || rage_max <= 0) {  // Player user_HPTrack
		terminate;
	}
	int old_hp = -1;
	int diff_hp;

	int boss_spacing = CheckActorInventory(act_tid, "Is_UH_BossNum");
	if (boss_spacing > MAX_BOSSES || CheckActorInventory(act_tid, "UnholyPowerDisableRazzle_F"))
		boss_spacing = 0;


	str rage_name = StrParam(s:"UnholyPower", i:rage_max);

	bool rage_boxbool = false;
	// SetHudSize(640,480,0);//640,512
	// SetFont("UFACE0RR");
	while (GetActorProperty(act_tid, APROP_HEALTH) > 0 && CheckActorInventory(act_tid, "UnholyPowerLimit_F") > 0) {
		curr_hp = GetActorProperty(act_tid, APROP_Health);
		diff_hp = old_hp - curr_hp;

		if (diff_hp > 0) {
			GiveActorInventory(act_tid, rage_name, diff_hp);
		}
		if (old_hp != curr_hp) {
			old_hp = curr_hp;
		}

		if (boss_spacing > 0) {
			int boss_idx = boss_spacing - 1;
			if (CheckActorInventory(act_tid, rage_name) >= rage_max || CheckActorInventory(act_tid, "UnholyPowerDazzle_F")) {
				if (rage_boxbool) {
					if (refreshhudmessage) {
						// HudMessageBold(s:"A"; 0, -1060-boss_Spacing,-1, 10.1, 280.1+boss_Spacing*32.0, 0,1.0);
						ACS_NamedExecuteWithResult("ub_BHW_RageHudClientside", boss_spacing);
						ACS_NamedExecuteWithResult("ub_BHW_RageBannerClientside", boss_spacing, bossdataarr[boss_idx][BOSSDATA_NUM], 2);
					}
				}
				else {
					ACS_NamedExecuteWithResult("ub_BHW_RageHudClientside", boss_spacing);
					ACS_NamedExecuteWithResult("ub_BHW_RageBannerClientside", boss_spacing, bossdataarr[boss_idx][BOSSDATA_NUM], 0);
					rage_boxbool = true;
				}
			}
			else if (rage_boxbool) {
				HudMessageBold(s:""; 0, -1060 - boss_spacing, -1, 0.99, 0.01, 1873);
				ACS_NamedExecuteWithResult("ub_BHW_RageBannerClientside", boss_spacing, bossdataarr[boss_idx][BOSSDATA_NUM], 1);
				rage_boxbool = false;
			}
		}
		// debugLog(StrParam(s:"Looping ub_RageAmmoGiver for ",i:rage_Max));
		Delay(1);
	}
	if (rage_boxbool) {  // Doesn't work for Spectators
		HudMessageBold(s:""; 0, -1060 - boss_spacing, -1, 0.99, 0.01, 1873);
		HudMessageBold(s:""; 0, -1070 - boss_spacing, -1, 0.99, 0.01, 1873);
	}
}

script "ub_BHW_RageHudClientside" (int theboss) CLIENTSIDE {
	Func_BHW_RageHudMess2(theboss);
}

function void Func_BHW_RageHudMess2(int theboss) {
	SetHudSize(640, 480, 0);  // 640,512
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int cur_x = BossHudXOffset(x_aspect);
	int addtoy = BossHudYOffset(theboss, y_aspect);

	if (CheckFont("MG_OT1RR")) {
		SetFont("MG_OT1RR");
		HudMessage(s:"A"; 0, -1060 - theboss, -1, 10.1 - 2.0 + cur_x, 280.1 - 2.0 + addtoy, 0, 1.0);
	}
	else if (CheckFont("UFACE0RR")) {
		SetFont("UFACE0RR");
		HudMessage(s:"A"; 0, -1060 - theboss, -1, 10.1 + cur_x, 280.1 + addtoy, 0, 1.0);
	}
	else {
		ClearHudMessage(-1060 - theboss);
	}
}

// Note: the rage body composition lives in UHDT (GetBossRageWarningText) so
// this library stays under ACC's 256-function cap.  The fadeout and the
// blinking loop both consume the single value below.
script "ub_BHW_RageBannerClientside" (int theboss, int bossnumb, int action) CLIENTSIDE {
	if (theboss < 1 || theboss > MAX_BOSSES)
		terminate;

	if (!GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossRageWarning")) {
		rage_banner_seq[theboss] = 0;
		ClearHudMessage(-1070 - theboss);
		terminate;
	}

	// Boss-only path: Demoneye (eye-encoded) and any non-DefineBoss id must not
	// borrow a Boss rage banner.  Clear the slot and stop instead of falling
	// back to GetEyeHudName / an empty generic name.
	if (IsEyeBossNumb(bossnumb) || !IsBossDefined(bossnumb)) {
		rage_banner_seq[theboss] = 0;
		ClearHudMessage(-1070 - theboss);
		terminate;
	}

	SetHudSize(640, 480, 0);

	str ragebody = GetBossRageWarningText(bossnumb);

	int banner_y = 36.0 + (theboss - 1) * 16.0;

	SetFont("BIGFONT");
	if (action == 1) {
		rage_banner_seq[theboss] = 0;
		HudMessage(s:"\c[AlertRed]*DANGER* \cg", s:ragebody, s:" \c[AlertRed]*DANGER*";
		           HUDMSG_FADEOUT, -1070 - theboss, CR_UNTRANSLATED, 320.4, banner_y, 0.0, 1.2);
		terminate;
	}

	if (action == 2) {
		if (rage_banner_seq[theboss] > 0)
			terminate;
	}

	rage_banner_seq[theboss]++;
	int my_seq = rage_banner_seq[theboss];

	int frame = 0;
	while (rage_banner_seq[theboss] == my_seq) {
		if (!GetUserCVar(ConsolePlayerNumber(), "uh_cl_BossRageWarning")) {
			ClearHudMessage(-1070 - theboss);
			rage_banner_seq[theboss] = 0;
			terminate;
		}

		str col = rage_banner_colors[frame];
		HudMessage(s:col, s:"*DANGER* \cg", s:ragebody, s:col, s:" *DANGER*";
		           0, -1070 - theboss, CR_UNTRANSLATED, 320.4, banner_y, 0);

		Delay(rage_banner_delays[frame]);
		frame = (frame + 1) % RAGE_BANNER_FRAMES;
	}
}

script "ub_BHW_TargetHudClientside" (int duration) CLIENTSIDE {
	Func_BHW_TargetHudMess2(duration);
}
function void Func_BHW_TargetHudMess(int duration) {
	ACS_NamedExecuteWithResult("ub_BHW_TargetHudClientside", duration);
}
function void Func_BHW_TargetHudMess2(int duration) {
	SetHudSize(640, 480, 0);
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	SetFont("TARGET_");
	HudMessage(s:"A"; HUDMSG_FADEINOUT, -999, -1, 10.1 + x_aspect, 304.1 + 32.0 - 8.0 + y_aspect, duration * 1.0, 1.0, 1.0);
}




#define LMSEVENT_ICON_X -220.0
#define LMSEVENT_ICON_Y 20.0
#define LMSEVENT_SLIDE_DIST 36.0
#define LMSEVENT_IN_TICS 10
#define LMSEVENT_OUT_TICS 10
#define LMSEVENT_HOLD_TICS (8 * 35)

// v6b and CBM use global slots 3-11 and 30-31; slot 32 is reserved here for
// the HUD lifecycle serial so reentry can invalidate older CLIENTSIDE scripts.
global int 32:lmsevent_hud_serial;

script "ub_LMS_EventIconStart" (int lmsnum, int isitrare, int badevent) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_LMS_EventIcon", 0, lmsnum, isitrare, badevent);
}

script "ub_LMS_EventIcon" (int lmsnum, int isitrare, int badevent) CLIENTSIDE {
	str iconfont;
	if (badevent) {
		if (lmsnum >= 0 && lmsnum <= 12) {iconfont = StrParam(s:"LMS_B#", i:lmsnum);}
		else {iconfont = "LMS_B#0";}
	}
	else {
		if (isitrare) {iconfont = GetLMSEventrareicon(lmsnum);}
		else {iconfont = GetLMSEventIcon(lmsnum);}
		if (StrCmp(iconfont, "") == 0) {
			if (isitrare) {iconfont = StrParam(s:"LMS_X#", i:lmsnum);}
			else {iconfont = StrParam(s:"LMS_E#", i:lmsnum);}
		}
	}
	SetFont(iconfont);

	SetHudSize(640, 480, 0);
	int x_aspect = GetHudRight(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 640.0;
		y_aspect = 0.0;
	}

	int target_x = x_aspect + LMSEVENT_ICON_X;
	int target_y = y_aspect + LMSEVENT_ICON_Y;
	lmsevent_hud_serial++;
	int my_serial = lmsevent_hud_serial;
	int i;
	int progress;
	int inv_p;
	int ease;
	int raw_x;
	int draw_x;
	int draw_y;
	int cur_alpha;

	// 1. Entrance: Slide-in from right with Ease-Out Quad
	for (i = 1; i <= LMSEVENT_IN_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_IN_TICS * 1.0);
		inv_p = 1.0 - progress;
		ease = 1.0 - FixedMul(inv_p, inv_p);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, 1.0 - ease);

		// HudMessage uses the first decimal place as an alignment flag. Round
		// the animated position to a whole pixel, then force left/top alignment.
		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, ease);
		Delay(1);
	}

	// 2. Hold phase: settle at target position
	draw_x = (RoundFixedToInt(target_x) * 1.0) + 0.1;
	draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;
	HudMessage(s:"A"; 0, -14836, -1, draw_x, draw_y, FixedDiv(LMSEVENT_HOLD_TICS * 1.0, 35.0) + 0.5, 1.0);

	for (i = 0; i < LMSEVENT_HOLD_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		Delay(1);
	}

	// 3. Exit: Slide-out to right with Ease-In Quad & fade out
	for (i = 1; i <= LMSEVENT_OUT_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_OUT_TICS * 1.0);
		ease = FixedMul(progress, progress);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, ease);
		cur_alpha = 1.0 - progress;

		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, cur_alpha);
		Delay(1);
	}

	if (my_serial == lmsevent_hud_serial) {
		HudMessage(s:""; 0, -14836, -1, 0.0, 0.0, 0.0);
	}
}


function int UH_MusicSnapshotReady(void) {
	int gen = GetCVar("_uh_ServMusicGen");
	if (gen <= 0 || (gen & 1))
		return 0;
	if (!UH_MusicLumpPublishable(GetCVarString("_uh_ServMusicLump")))
		return 0;
	return 1;
}

// Set when uh_MusicMapCard actually draws on this client. Cleared when we hand
// 5000-5005 back to core_mapcard or when uh_MusicDismiss takes that card down.
int uh_music_custom_mapcard;

function str UH_MusicFitLine(str text) {
	str trunc;
	int c;
	if (StrLen(text) <= 30)
		return text;
	trunc = "";
	for (c = 0; c < 27; c++)
		trunc = StrParam(s:trunc, c:GetChar(text, c));
	return StrParam(s:trunc, s:"...");
}

// HUDMSG_LOG reaches AddToConsole. Alpha 0 keeps that message out of the view.
// Log() is Printf and also feeds the top notify line, so it is not used here.
function void UH_MusicWriteConsole(str lump, str title, str album, str artist) {
	str line;
	line = StrParam(s:"\c[Gold]Now Playing: \c[White]", s:title);
	if (StrLen(album) > 0)
		line = StrParam(s:line, s:"\n\cd", s:album);
	if (StrLen(artist) > 0)
		line = StrParam(s:line, s:"\n\cd", s:artist);
	line = StrParam(s:line, s:" \c[LightBlue][", s:lump, s:"]");
	SetFont("SMALLFONT");
	HudMessage(s:line; HUDMSG_PLAIN | HUDMSG_LOG | HUDMSG_ALPHA, -68740, CR_WHITE, 0.1, 0.1, 0.1, 0.0);
}

script "uh_getcurrentmusic" (int which) {
	if (CheckInventory("NetScriptAntiSpam2")) {
		terminate;
	}
	GiveInventory("NetScriptAntiSpam2", 1);

	ACS_NamedExecuteAlways("uh_displaycurrentmusic", 0);
}

script "uh_displaycurrentmusic" (void) NET CLIENTSIDE {
	int spins;
	if (ConsolePlayerNumber() != PlayerNumber()) {
		terminate;
	}
	spins = 0;
	while ((GetCVar("_uh_ServMusicGen") & 1) && spins < 5) {
		Delay(1);
		spins++;
	}
	ACS_NamedExecuteAlways("uh_MusicQuery", 0);
}

script "uh_showmapcard" (void) NET CLIENTSIDE {
	int cpn;
	if (ConsolePlayerNumber() != PlayerNumber()) terminate;
	cpn = ConsolePlayerNumber();
	// The map-card key shows the map's own music. The current Unholy track
	// replaces those three lines only when Music Info Style is Map Card,
	// Round Music is Boss Music, and a track is actually committed.
	if (GetUserCVar(cpn, "uh_cl_MusicMode") == 0 && GetUserCVar(cpn, "uh_cl_MusicDisplay") == 3 && UH_MusicSnapshotReady())
		ACS_NamedExecuteAlways("uh_MusicMapCard", 0);
	else {
		uh_music_custom_mapcard = 0;
		ACS_NamedExecuteAlways("core_mapcard", 0);
	}
}

script "uh_MusicQuery" (void) CLIENTSIDE {
	int cpn = ConsolePlayerNumber();
	int mode = GetUserCVar(cpn, "uh_cl_MusicMode");
	int style = GetUserCVar(cpn, "uh_cl_MusicDisplay");
	if (mode == 1) {
		if (style == 3) {
			uh_music_custom_mapcard = 0;
			ACS_NamedExecuteAlways("core_mapcard", 0);
		}
		terminate;
	}
	if (style <= 0)
		terminate;
	if (style == 3) {
		if (UH_MusicSnapshotReady())
			ACS_NamedExecuteAlways("uh_MusicMapCard", 0);
		else {
			uh_music_custom_mapcard = 0;
			ACS_NamedExecuteAlways("core_mapcard", 0);
		}
	}
	else
		ACS_NamedExecuteAlways("uh_MusicPresent", 0, 1);
}

script "uh_MusicAutoNotify" (void) CLIENTSIDE {
	int cpn = ConsolePlayerNumber();
	int style;
	if (cpn < 0 || GetUserCVar(cpn, "uh_cl_MusicMode") != 0)
		terminate;
	style = GetUserCVar(cpn, "uh_cl_MusicDisplay");
	if (style <= 0)
		terminate;
	if (style == 3)
		ACS_NamedExecuteAlways("uh_MusicMapCard", 0);
	else
		ACS_NamedExecuteAlways("uh_MusicPresent", 0, 1);
}

global int 33:fancytunedisplay_serial;

// Same gates, ids, coordinates and timing as core_mapcard. The three music
// lines are the committed Unholy title, album and artist.
script "uh_MusicMapCard" (void) CLIENTSIDE {
	str background;
	str icon;
	if (!UH_MusicSnapshotReady())
		terminate;
	if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_mapcards") == 0)
		terminate;
	if (StrLen(GetCVarString("mm8bdm_map_creator")) == 0)
		terminate;
	fancytunedisplay_serial++;
	HudMessage(s:""; 0, -68741, -1, 0.0, 0.0, 0.0);
	HudMessage(s:""; 0, -68742, -1, 0.0, 0.0, 0.0);
	HudMessage(s:""; 0, -68743, -1, 0.0, 0.0, 0.0);
	HudMessage(s:""; 0, -68744, -1, 0.0, 0.0, 0.0);
	HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
	HudMessage(s:""; 0, -68746, -1, 0.0, 0.0, 0.0);
	background = GetCVarString("mm8bdm_map_background");
	icon = GetCVarString("mm8bdm_map_icon");
	if (StrLen(background) == 0) background = "MAPCD10";
	if (StrLen(icon) == 0) icon = "MAPCARDI";
	SetHudSize(800, 600, 0);
	SetFont(background);
	HudMessage(s:"A"; HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5005, CR_WHITE, 0.1, 440.1, 5.0, 0.5, 0.5);
	SetFont(icon);
	HudMessage(s:"A"; HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5004, CR_WHITE, 11.1, 451.1, 5.0, 0.5, 0.5);
	SetFont("CONFONT");
	HudMessage(s:GetCVarString("mm8bdm_map_createdbytext"), s:"\n\n\cj", s:GetCVarString("mm8bdm_map_creator"); HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5003, CR_CYAN, 48.1, 450.1, 5.0, 0.5, 0.5);
	HudMessage(s:GetCVarString("_uh_ServMusicTitle"); HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5002, CR_WHITE, 26.1, 488.1, 5.0, 0.5, 0.5);
	HudMessage(s:GetCVarString("_uh_ServMusicAlbum"); HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5001, CR_WHITE, 26.1, 500.1, 5.0, 0.5, 0.5);
	HudMessage(s:GetCVarString("_uh_ServMusicArtist"); HUDMSG_PLAIN|HUDMSG_FADEINOUT, 5000, CR_WHITE, 26.1, 512.1, 5.0, 0.5, 0.5);
	uh_music_custom_mapcard = 1;
}

#define MUSIC_CARD_WIDTH 270.0
#define MUSIC_CARD_HEIGHT 42.0
#define MUSIC_CARD_OFFSET_X -286.0
#define MUSIC_CARD_OFFSET_Y -74.0
#define MUSIC_CARD_SLIDE_DIST 36.0
#define MUSIC_CARD_IN_TICS 10
#define MUSIC_CARD_OUT_TICS 10
#define MUSIC_CARD_HOLD_TICS (4 * 35 + 18)

script "uh_MusicDismiss" (void) CLIENTSIDE {
	int id;
	fancytunedisplay_serial++;
	for (id = -68746; id <= -68740; id++)
		HudMessage(s:""; 0, id, -1, 0.0, 0.0, 0.0);
	// 5000-5005 are also core_mapcard's IDs. Clear them only when Unholy
	// actually drew the custom Map Card on this client.
	if (uh_music_custom_mapcard) {
		for (id = 5000; id <= 5005; id++)
			HudMessage(s:""; 0, id, -1, 0.0, 0.0, 0.0);
		uh_music_custom_mapcard = 0;
	}
}

function void UH_MusicDrawCardLines(int draw_x, int draw_y, int hold, int alpha, str lump, str title, str album, str artist) {
	SetFont("SMALLFONT");
	HudMessage(s:"\ckNOW PLAYING \cl[", s:lump, s:"]"; HUDMSG_ALPHA, -68743, -1, draw_x + 18.0, draw_y + 4.0, hold, alpha);
	HudMessage(s:"\c[White]", s:title; HUDMSG_ALPHA, -68744, -1, draw_x + 18.0, draw_y + 15.0, hold, alpha);
	if (StrLen(album) > 0)
		HudMessage(s:"\cd", s:album; HUDMSG_ALPHA, -68745, -1, draw_x + 18.0, draw_y + 26.0, hold, alpha);
	else
		HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
	if (StrLen(artist) > 0)
		HudMessage(s:"\cq", s:artist; HUDMSG_ALPHA, -68746, -1, draw_x + 18.0, draw_y + 37.0, hold, alpha);
	else
		HudMessage(s:""; 0, -68746, -1, 0.0, 0.0, 0.0);
}

script "uh_MusicPresent" (int wantconsole) CLIENTSIDE {
	str lump;
	str title;
	str album;
	str artist;
	int x_aspect;
	int y_aspect;
	int base_target_x;
	int base_target_y;
	int my_serial;
	int i;
	int progress;
	int inv_p;
	int ease;
	int raw_x;
	int draw_x;
	int draw_y;
	int style;
	int final_x;
	int final_y;
	int hold_secs;
	int cur_alpha;
	str min_text;
	int text_x;
	int text_y;

	if (!UH_MusicSnapshotReady())
		terminate;
	lump = GetCVarString("_uh_ServMusicLump");
	title = GetCVarString("_uh_ServMusicTitle");
	album = GetCVarString("_uh_ServMusicAlbum");
	artist = GetCVarString("_uh_ServMusicArtist");
	style = GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay");
	if (wantconsole)
		UH_MusicWriteConsole(lump, title, album, artist);
	title = UH_MusicFitLine(title);
	album = UH_MusicFitLine(album);
	artist = UH_MusicFitLine(artist);
	if (style <= 0)
		terminate;

	SetHudSize(640, 480, 0);
	x_aspect = GetHudRight(640) * 1.0;
	y_aspect = GetHudBot(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 640.0;
		y_aspect = 480.0;
	}

	if (style == 2) {
		fancytunedisplay_serial++;
		min_text = StrParam(s:"\ckNOW PLAYING \cl[", s:lump, s:"]\n\c[White]", s:title);
		if (StrLen(album) > 0)
			min_text = StrParam(s:min_text, s:"\n\cd", s:album);
		if (StrLen(artist) > 0)
			min_text = StrParam(s:min_text, s:"\n\cq", s:artist);
		text_x = (RoundFixedToInt(x_aspect - 16.0) * 1.0) + 0.2;
		text_y = (RoundFixedToInt(y_aspect - 84.0) * 1.0) + 0.2;
		SetFont("SMALLFONT");
		HudMessage(s:min_text; HUDMSG_TYPEON, -68741, -1, text_x, text_y, 4.0, 0.02, 1.5);
		HudMessage(s:""; 0, -68742, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68743, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68744, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68746, -1, 0.0, 0.0, 0.0);
		terminate;
	}

	base_target_x = x_aspect + MUSIC_CARD_OFFSET_X;
	base_target_y = y_aspect + MUSIC_CARD_OFFSET_Y;
	fancytunedisplay_serial++;
	my_serial = fancytunedisplay_serial;

	for (i = 1; i <= MUSIC_CARD_IN_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		progress = FixedDiv(i * 1.0, MUSIC_CARD_IN_TICS * 1.0);
		inv_p = 1.0 - progress;
		ease = 1.0 - FixedMul(inv_p, inv_p);
		raw_x = base_target_x + FixedMul(MUSIC_CARD_SLIDE_DIST, 1.0 - ease);
		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		draw_y = (RoundFixedToInt(base_target_y) * 1.0) + 0.1;
		SetFont("MUSCARD");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, draw_x, draw_y, 0.2, FixedMul(0.85, ease));
		SetFont("STCFN600");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, draw_x + 6.0, draw_y + 5.0, 0.2, ease);
		UH_MusicDrawCardLines(draw_x, draw_y, 0.2, ease, lump, title, album, artist);
		Delay(1);
	}

	final_x = (RoundFixedToInt(base_target_x) * 1.0) + 0.1;
	final_y = (RoundFixedToInt(base_target_y) * 1.0) + 0.1;
	hold_secs = FixedDiv(MUSIC_CARD_HOLD_TICS * 1.0, 35.0) + 0.5;
	SetFont("MUSCARD");
	HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, final_x, final_y, hold_secs, 0.85);
	SetFont("STCFN600");
	HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, final_x + 6.0, final_y + 5.0, hold_secs, 1.0);
	UH_MusicDrawCardLines(final_x, final_y, hold_secs, 1.0, lump, title, album, artist);

	for (i = 0; i < MUSIC_CARD_HOLD_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		Delay(1);
	}

	for (i = 1; i <= MUSIC_CARD_OUT_TICS; i++) {
		if (my_serial != fancytunedisplay_serial) { terminate; }
		progress = FixedDiv(i * 1.0, MUSIC_CARD_OUT_TICS * 1.0);
		ease = FixedMul(progress, progress);
		cur_alpha = 1.0 - progress;
		raw_x = base_target_x + FixedMul(MUSIC_CARD_SLIDE_DIST, ease);
		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		SetFont("MUSCARD");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68741, -1, draw_x, final_y, 0.2, FixedMul(0.85, cur_alpha));
		SetFont("STCFN600");
		HudMessage(s:"A"; HUDMSG_ALPHA, -68742, -1, draw_x + 6.0, final_y + 5.0, 0.2, cur_alpha);
		UH_MusicDrawCardLines(draw_x, final_y, 0.2, cur_alpha, lump, title, album, artist);
		Delay(1);
	}

	if (my_serial == fancytunedisplay_serial) {
		HudMessage(s:""; 0, -68741, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68742, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68743, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68744, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68745, -1, 0.0, 0.0, 0.0);
		HudMessage(s:""; 0, -68746, -1, 0.0, 0.0, 0.0);
	}
}

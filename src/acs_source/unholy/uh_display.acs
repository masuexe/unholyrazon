script "ub_LMS_EventIconStart" (int lms_num, int is_it_rare) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_LMS_EventIcon", 0, lms_num, is_it_rare);
}

#define LMSEVENT_ICON_X -216.0
#define LMSEVENT_ICON_Y 16.0

script "ub_LMS_EventIcon" (int lms_num, int is_it_rare) CLIENTSIDE {
	str icon_font;
	if (is_it_rare) {icon_font = GetLMSEventrareicon(lms_num);}
	else {icon_font = GetLMSEventIcon(lms_num);}
	if (StrCmp(icon_font, "") == 0) {
		if (is_it_rare) {icon_font = StrParam(s:"LMS_X#", i:lms_num);}
		else {icon_font = StrParam(s:"LMS_E#", i:lms_num);}
	}
	SetFont(icon_font);
	// HudMessageBold(s: "A"; HUDMSG_FADEOUT, -14836, -1, 0.035, 0.40, 14.0,1.0);

	SetHudSize(640, 480, 0);  // 640,512//400,300//800,600
	// SetHudClipRect(0, -100, 640, 580,0);
	int x_aspect = GetHudRight(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = GetScreenWidth() << 16;
		y_aspect = 0;
	}

	int temp_x = 72;
	int temp_y = 0;
	int temp_store = 0;
	int temp_whole = 0;

	for (int i = 1; i < 21; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 0.895 + 0.5) >> 16;
		temp_store = temp_store + temp_y - temp_x;
		temp_whole = (-50 + temp_store + i / 50) << 16;
		// Temp_Whole = Temp_Whole + roundFunc((22-i)*0.3);

		// Log(s:"int = ",i:Temp_Whole,s:" Fixed = ",f:Temp_Whole);
		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, x_aspect + LMSEVENT_ICON_X, temp_whole + y_aspect + LMSEVENT_ICON_Y, 2.0, 0.05 * i);
		Delay(1);  // 440.1
	}

	HudMessage(s:"A"; 0, -14836, -1, x_aspect + LMSEVENT_ICON_X, temp_whole + y_aspect + LMSEVENT_ICON_Y, 16.0, 1.0);

	Delay(15 * 35);
	temp_x = 3;
	temp_y = 0;
	temp_store = 0;
	for (i = 1; i < 20; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 1.175 + 0.5) >> 16;
		temp_store = temp_store + temp_y - temp_x;
		temp_whole = (14 + temp_store + i / 25) << 16;
		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, x_aspect + LMSEVENT_ICON_X, temp_whole + y_aspect + LMSEVENT_ICON_Y, 2.0, 0.05 * (20 - i));
		Delay(1);
	}

	HudMessage(s:""; 0, -14836, -1, 0.99, 0.01, 1873);
}


script "uh_getcurrentmusic" (int which) {
	if (CheckInventory("NetScriptAntiSpam2")) {
		terminate;
	}
	GiveInventory("NetScriptAntiSpam2", 1);

	ACS_NamedExecuteAlways("uh_displaycurrentmusic", 0);
}

script "uh_displaycurrentmusic" (void) NET CLIENTSIDE {
	if (ConsolePlayerNumber() != PlayerNumber()) {
		terminate;
	}
	str tune_code_str = GetCVarString("_uh_ServMusicLump");
	str musical_str = GetCVarString("_uh_ServMusicCredits");

	str char_line2_str = StrParam(c:1);  // Top line start
	str char_line8_str = StrParam(c:7);  // Bottom line start

	str char_line22_str = StrParam(c:1);
	str char_line88_str = StrParam(c:7);

	for (int i = 0; i < StrLen(musical_str); i++)  // Extend the lines to Music String Length
	{
		char_line2_str = StrParam(s:char_line2_str, c:2);
		char_line8_str = StrParam(s:char_line8_str, c:8);
	}
	char_line2_str = StrParam(s:char_line2_str, c:3);  // Top line end
	char_line8_str = StrParam(s:char_line8_str, c:9);  // Bottom line end

	for (i = 0; i < StrLen(tune_code_str); i++)  // Extend for Music Code Length
	{
		char_line22_str = StrParam(s:char_line22_str, c:2);
		char_line88_str = StrParam(s:char_line88_str, c:8);
	}
	char_line22_str = StrParam(s:char_line22_str, c:3);
	char_line88_str = StrParam(s:char_line88_str, c:9);

	SetFont("CONFONT");
	HudMessage(s:"\cd",
		s:char_line22_str, s:"\n", c:4, s:"\cl", s:tune_code_str, s:"\cd", c:6, s:"\n", s:char_line88_str, c:5, s:"\n",
		s:char_line2_str, s:"\n", c:4, s:"\cl", s:musical_str, s:"\cd", c:6, s:"\n", s:char_line8_str;
		HUDMSG_LOG | HUDMSG_ALPHA, -68740, CR_GREEN, 0, 1000.1, 1873, 0.0);
}



script "ub_FancyDisplayMusicStart" (int garbage_text) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_FancyDisplayMusic", 0);
}

int fancy_tune_display_cl = 0;

script "ub_FancyDisplayMusic" (int toggle_garbage) CLIENTSIDE {
	str tune_code_str = GetCVarString("_uh_ServMusicLump");
	str musical_str = GetCVarString("_uh_ServMusicCredits");
	if (GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay")) {
		fancy_tune_display_cl += 1;
		if (fancy_tune_display_cl >= 2) {
			int temp_delay = fancy_tune_display_cl;
			while (fancy_tune_display_cl >= temp_delay) {
				Delay(1);
			}
		}
	}

	int m_info_length = StrLen(musical_str);
	int m_code_length = StrLen(tune_code_str);
	if (toggle_garbage) {
		m_info_length = random(10, 64);
		m_code_length = random(4, 10);
	}

	str fake_space_str = "";
	str char_line2_str = StrParam(c:1);
	str char_line8_str = StrParam(c:7);
	str char_line_str2 = "";

	str fake_space2_str = "";
	str char_line22_str = StrParam(c:1);
	str char_line88_str = StrParam(c:7);
	str char_line_str = "";

	for (int i = 0; i < m_info_length; i++) {
		fake_space_str = StrParam(s:fake_space_str, c:random(32, 255));  // 0,255
		char_line2_str = StrParam(s:char_line2_str, c:2);
		char_line8_str = StrParam(s:char_line8_str, c:8);
		char_line_str2 = StrParam(s:char_line_str2, s:"A");
	}
	char_line2_str = StrParam(s:char_line2_str, c:3);
	char_line8_str = StrParam(s:char_line8_str, c:9);

	for (i = 0; i < m_code_length; i++) {
		fake_space2_str = StrParam(s:fake_space2_str, c:random(32, 255));
		char_line22_str = StrParam(s:char_line22_str, c:2);
		char_line88_str = StrParam(s:char_line88_str, c:8);
		char_line_str = StrParam(s:char_line_str, s:"A");
	}
	char_line22_str = StrParam(s:char_line22_str, c:3);
	char_line88_str = StrParam(s:char_line88_str, c:9);  // 9

	if (toggle_garbage) {
		musical_str = fake_space_str;
		tune_code_str = fake_space2_str;
	}

	SetHudSize(800, 600, 0);
	SetHudClipRect(-300, 0, 1100, 900, 1400);
	int x_aspect = GetHudLeft(800);  // *1.0
	int y_aspect = GetHudTop(600) * -1.0;

	if (GetScreenWidth() == 800 && GetScreenHeight() == 600) {
		x_aspect = 0;
		y_aspect = 0;
	}

	SetFont("CONFONT");  // Char 5 below is needed to fix Char 9 not showing up if followed by line skip for actual HudMessage calls
	HudMessage(s:"\cd",
		s:char_line22_str, s:"\n", c:4, s:"\cl", s:tune_code_str, s:"\cd", c:6, s:"\n", s:char_line88_str, c:5, s:"\n",
		s:char_line2_str, s:"\n", c:4, s:"\cl", s:musical_str, s:"\cd", c:6, s:"\n", s:char_line8_str;
		HUDMSG_LOG | HUDMSG_ALPHA, -68740, CR_GREEN, 0, 1000.1, 1873, 0.0);

	if (!GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay")) {
		terminate;
	}

	int temp_x = m_info_length * 8;
	int temp_y = 0;
	int temp_start = x_aspect + m_info_length * -8 + m_info_length / 10;
	int temp_store, temp_whole;

	for (i = 1; i < 21; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 0.825 + 0.75) >> 16;  // Where did this math even come from?? [C]
		temp_store = temp_store + (temp_y - temp_x);
		temp_whole = (temp_start + temp_store + i / 2) << 16;
		// Log(s:"\nTemp_Y int = ",i:Temp_Y,s:" Fixed >> ",f:Temp_Y);
		// Log(s:"Temp_X int = ",i:Temp_X,s:" Fixed >> ",f:Temp_X);
		// Log(s:"Temp_Store int = ",i:Temp_Store,s:" Fixed >> ",f:Temp_Store);
		// Log(s:"Temp_Whole int = ",i:Temp_Whole,s:" Fixed >> ",f:Temp_Whole);
		// Log(s:"HudMess int = ",i:Temp_Whole - 0.1,s:" Fixed >> ",f:Temp_Whole - 0.1);
		SetFont("CONFONT");  // CONFONT//LETFONT
		HudMessage(s:"\cu",
			s:char_line22_str, s:"\n", c:4, s:"\cc", s:tune_code_str, s:"\cu", c:6, s:"\n", s:char_line88_str, c:5, s:"\n",
			s:char_line2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:char_line8_str;
			HUDMSG_ALPHA, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 2.0, 0.05 * i);
		SetFont("STCFN606");
		HudMessage(s:"\c- AA", s:char_line_str, s:char_line_str; HUDMSG_ALPHA, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 2.0, 0.05 * i);
		HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; HUDMSG_ALPHA, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 2.0, 0.05 * i);
		Delay(1);
	}
	SetFont("CONFONT");
	HudMessage(s:"\cu",
		s:char_line22_str, s:"\n", c:4, s:"\cc", s:tune_code_str, s:"\cu", c:6, s:"\n", s:char_line88_str, c:5, s:"\n",
		s:char_line2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:char_line8_str;
		0, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 7.0, 1.0);
	SetFont("STCFN606");
	HudMessage(s:"\c- AA", s:char_line_str, s:char_line_str; 0, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 7.0, 1.0);
	HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; 0, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 7.0, 1.0);

	for (i = 0; i < 35 * 5; i += 1) {
		if (fancy_tune_display_cl >= 2) {
			break;
		}
		Delay(1);
	}
	// Delay(35*5);

	temp_x = m_info_length * 8;
	temp_y = 0;
	temp_start = temp_whole >> 16;
	temp_store = m_info_length / -10;
	temp_whole = 0;
	for (i = 1; i < 20; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 0.855 + 0.75) >> 16;
		temp_store = temp_store - (temp_y - temp_x);
		temp_whole = (temp_start + temp_store - i) << 16;

		SetFont("CONFONT");
		HudMessage(s:"\cu",
			s:char_line22_str, s:"\n", c:4, s:"\cc", s:tune_code_str, s:"\cu", c:6, s:"\n", s:char_line88_str, c:5, s:"\n",
			s:char_line2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:char_line8_str;
			HUDMSG_ALPHA, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 2.0, 0.05 * (20 - i));
		SetFont("STCFN606");
		HudMessage(s:"\c- AA", s:char_line_str, s:char_line_str; HUDMSG_ALPHA, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 2.0, 0.05 * (20 - i));
		HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; HUDMSG_ALPHA, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 2.0, 0.05 * (20 - i));
		Delay(1);
	}

	HudMessage(s:""; 0, -68743, -1, 0.99, 0.01, 1873);
	HudMessage(s:""; 0, -68742, -1, 0.99, 0.01, 1873);
	HudMessage(s:""; 0, -68741, -1, 0.99, 0.01, 1873);

	fancy_tune_display_cl -= 1;
}

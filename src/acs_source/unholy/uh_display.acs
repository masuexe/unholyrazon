#define LMSEVENT_ICON_X -220.0
#define LMSEVENT_ICON_Y 20.0
#define LMSEVENT_SLIDE_DIST 36.0
#define LMSEVENT_IN_TICS 10
#define LMSEVENT_OUT_TICS 10
#define LMSEVENT_HOLD_TICS (8 * 35)

// v6b and CBM use global slots 3-11 and 30-31; slot 32 is reserved here for
// the HUD lifecycle serial so reentry can invalidate older CLIENTSIDE scripts.
global int 32:lmsevent_hud_serial;

script "ub_LMS_EventIconStart" (int lmsnum, int isitrare, int badevent) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_LMS_EventIcon", 0, lmsnum, isitrare, badevent);
}

script "ub_LMS_EventIcon" (int lmsnum, int isitrare, int badevent) CLIENTSIDE {
	str iconfont;
	if (badevent) {
		if (lmsnum >= 0 && lmsnum <= 12) {iconfont = StrParam(s:"LMS_B#", i:lmsnum);}
		else {iconfont = "LMS_B#0";}
	}
	else {
		if (isitrare) {iconfont = GetLMSEventrareicon(lmsnum);}
		else {iconfont = GetLMSEventIcon(lmsnum);}
		if (StrCmp(iconfont, "") == 0) {
			if (isitrare) {iconfont = StrParam(s:"LMS_X#", i:lmsnum);}
			else {iconfont = StrParam(s:"LMS_E#", i:lmsnum);}
		}
	}
	SetFont(iconfont);

	SetHudSize(640, 480, 0);
	int x_aspect = GetHudRight(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 640.0;
		y_aspect = 0.0;
	}

	int target_x = x_aspect + LMSEVENT_ICON_X;
	int target_y = y_aspect + LMSEVENT_ICON_Y;
	lmsevent_hud_serial++;
	int my_serial = lmsevent_hud_serial;
	int i;
	int progress;
	int inv_p;
	int ease;
	int raw_x;
	int draw_x;
	int draw_y;
	int cur_alpha;

	// 1. Entrance: Slide-in from right with Ease-Out Quad
	for (i = 1; i <= LMSEVENT_IN_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_IN_TICS * 1.0);
		inv_p = 1.0 - progress;
		ease = 1.0 - FixedMul(inv_p, inv_p);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, 1.0 - ease);

		// HudMessage uses the first decimal place as an alignment flag. Round
		// the animated position to a whole pixel, then force left/top alignment.
		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;
		draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, ease);
		Delay(1);
	}

	// 2. Hold phase: settle at target position
	draw_x = (RoundFixedToInt(target_x) * 1.0) + 0.1;
	draw_y = (RoundFixedToInt(target_y) * 1.0) + 0.1;
	HudMessage(s:"A"; 0, -14836, -1, draw_x, draw_y, FixedDiv(LMSEVENT_HOLD_TICS * 1.0, 35.0) + 0.5, 1.0);

	for (i = 0; i < LMSEVENT_HOLD_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		Delay(1);
	}

	// 3. Exit: Slide-out to right with Ease-In Quad & fade out
	for (i = 1; i <= LMSEVENT_OUT_TICS; i++) {
		if (my_serial != lmsevent_hud_serial) { terminate; }
		progress = FixedDiv(i * 1.0, LMSEVENT_OUT_TICS * 1.0);
		ease = FixedMul(progress, progress);
		raw_x = target_x + FixedMul(LMSEVENT_SLIDE_DIST, ease);
		cur_alpha = 1.0 - progress;

		draw_x = (RoundFixedToInt(raw_x) * 1.0) + 0.1;

		HudMessage(s:"A"; HUDMSG_ALPHA, -14836, -1, draw_x, draw_y, 0.2, cur_alpha);
		Delay(1);
	}

	if (my_serial == lmsevent_hud_serial) {
		HudMessage(s:""; 0, -14836, -1, 0.0, 0.0, 0.0);
	}
}


script "uh_getcurrentmusic" (int which) {
	if (CheckInventory("NetScriptAntiSpam2")) {
		terminate;
	}
	GiveInventory("NetScriptAntiSpam2", 1);

	ACS_NamedExecuteAlways("uh_displaycurrentmusic", 0);
}

script "uh_displaycurrentmusic" (void) NET CLIENTSIDE {
	if (ConsolePlayerNumber() != PlayerNumber()) {
		terminate;
	}
	str tunecode_str = GetCVarString("_uh_ServMusicLump");
	str musical_str = GetCVarString("_uh_ServMusicCredits");

	str charline2_str = StrParam(c:1);  // Top line start
	str charline8_str = StrParam(c:7);  // Bottom line start

	str charline22_str = StrParam(c:1);
	str charline88_str = StrParam(c:7);

	for (int i = 0; i < StrLen(musical_str); i++)  // Extend the lines to Music String Length
	{
		charline2_str = StrParam(s:charline2_str, c:2);
		charline8_str = StrParam(s:charline8_str, c:8);
	}
	charline2_str = StrParam(s:charline2_str, c:3);  // Top line end
	charline8_str = StrParam(s:charline8_str, c:9);  // Bottom line end

	for (i = 0; i < StrLen(tunecode_str); i++)  // Extend for Music Code Length
	{
		charline22_str = StrParam(s:charline22_str, c:2);
		charline88_str = StrParam(s:charline88_str, c:8);
	}
	charline22_str = StrParam(s:charline22_str, c:3);
	charline88_str = StrParam(s:charline88_str, c:9);

	SetFont("CONFONT");
	HudMessage(s:"\cd",
		s:charline22_str, s:"\n", c:4, s:"\cl", s:tunecode_str, s:"\cd", c:6, s:"\n", s:charline88_str, c:5, s:"\n",
		s:charline2_str, s:"\n", c:4, s:"\cl", s:musical_str, s:"\cd", c:6, s:"\n", s:charline8_str;
		HUDMSG_LOG | HUDMSG_ALPHA, -68740, CR_GREEN, 0, 1000.1, 1873, 0.0);
}



script "ub_FancyDisplayMusicStart" (int garbagetext) {
	SetActivator(0, AAPTR_NULL);
	ACS_NamedExecuteAlways("ub_FancyDisplayMusic", 0);
}

int fancytunedisplay_cl = 0;

script "ub_FancyDisplayMusic" (int togglegarbage) CLIENTSIDE {
	str tunecode_str = GetCVarString("_uh_ServMusicLump");
	str musical_str = GetCVarString("_uh_ServMusicCredits");
	if (GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay")) {
		fancytunedisplay_cl += 1;
		if (fancytunedisplay_cl >= 2) {
			int temp_delay = fancytunedisplay_cl;
			while (fancytunedisplay_cl >= temp_delay) {
				Delay(1);
			}
		}
	}

	int m_infolength = StrLen(musical_str);
	int m_codelength = StrLen(tunecode_str);
	if (togglegarbage) {
		m_infolength = random(10, 64);
		m_codelength = random(4, 10);
	}

	str fakespace_str = "";
	str charline2_str = StrParam(c:1);
	str charline8_str = StrParam(c:7);
	str char_line_str2 = "";

	str fakespace2_str = "";
	str charline22_str = StrParam(c:1);
	str charline88_str = StrParam(c:7);
	str charline__str = "";

	for (int i = 0; i < m_infolength; i++) {
		fakespace_str = StrParam(s:fakespace_str, c:random(32, 255));  // 0,255
		charline2_str = StrParam(s:charline2_str, c:2);
		charline8_str = StrParam(s:charline8_str, c:8);
		char_line_str2 = StrParam(s:char_line_str2, s:"A");
	}
	charline2_str = StrParam(s:charline2_str, c:3);
	charline8_str = StrParam(s:charline8_str, c:9);

	for (i = 0; i < m_codelength; i++) {
		fakespace2_str = StrParam(s:fakespace2_str, c:random(32, 255));
		charline22_str = StrParam(s:charline22_str, c:2);
		charline88_str = StrParam(s:charline88_str, c:8);
		charline__str = StrParam(s:charline__str, s:"A");
	}
	charline22_str = StrParam(s:charline22_str, c:3);
	charline88_str = StrParam(s:charline88_str, c:9);  // 9

	if (togglegarbage) {
		musical_str = fakespace_str;
		tunecode_str = fakespace2_str;
	}

	SetHudSize(800, 600, 0);
	SetHudClipRect(-300, 0, 1100, 900, 1400);
	int x_aspect = GetHudLeft(800);  // *1.0
	int y_aspect = GetHudTop(600) * -1.0;

	if (GetScreenWidth() == 800 && GetScreenHeight() == 600) {
		x_aspect = 0;
		y_aspect = 0;
	}

	SetFont("CONFONT");  // Char 5 below is needed to fix Char 9 not showing up if followed by line skip for actual HudMessage calls
	HudMessage(s:"\cd",
		s:charline22_str, s:"\n", c:4, s:"\cl", s:tunecode_str, s:"\cd", c:6, s:"\n", s:charline88_str, c:5, s:"\n",
		s:charline2_str, s:"\n", c:4, s:"\cl", s:musical_str, s:"\cd", c:6, s:"\n", s:charline8_str;
		HUDMSG_LOG | HUDMSG_ALPHA, -68740, CR_GREEN, 0, 1000.1, 1873, 0.0);

	if (!GetUserCVar(ConsolePlayerNumber(), "uh_cl_MusicDisplay")) {
		terminate;
	}

	int temp_x = m_infolength * 8;
	int temp_y = 0;
	int temp_start = x_aspect + m_infolength * -8 + m_infolength / 10;
	int temp_store, temp_whole;

	for (i = 1; i < 21; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 0.825 + 0.75) >> 16;  // Where did this math even come from?? [C]
		temp_store = temp_store + (temp_y - temp_x);
		temp_whole = (temp_start + temp_store + i / 2) << 16;
		// Log(s:"\nTemp_Y int = ",i:Temp_Y,s:" Fixed >> ",f:Temp_Y);
		// Log(s:"Temp_X int = ",i:Temp_X,s:" Fixed >> ",f:Temp_X);
		// Log(s:"Temp_Store int = ",i:Temp_Store,s:" Fixed >> ",f:Temp_Store);
		// Log(s:"Temp_Whole int = ",i:Temp_Whole,s:" Fixed >> ",f:Temp_Whole);
		// Log(s:"HudMess int = ",i:Temp_Whole - 0.1,s:" Fixed >> ",f:Temp_Whole - 0.1);
		SetFont("CONFONT");  // CONFONT//LETFONT
		HudMessage(s:"\cu",
			s:charline22_str, s:"\n", c:4, s:"\cc", s:tunecode_str, s:"\cu", c:6, s:"\n", s:charline88_str, c:5, s:"\n",
			s:charline2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:charline8_str;
			HUDMSG_ALPHA, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 2.0, 0.05 * i);
		SetFont("STCFN606");
		HudMessage(s:"\c- AA", s:charline__str, s:charline__str; HUDMSG_ALPHA, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 2.0, 0.05 * i);
		HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; HUDMSG_ALPHA, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 2.0, 0.05 * i);
		Delay(1);
	}
	SetFont("CONFONT");
	HudMessage(s:"\cu",
		s:charline22_str, s:"\n", c:4, s:"\cc", s:tunecode_str, s:"\cu", c:6, s:"\n", s:charline88_str, c:5, s:"\n",
		s:charline2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:charline8_str;
		0, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 7.0, 1.0);
	SetFont("STCFN606");
	HudMessage(s:"\c- AA", s:charline__str, s:charline__str; 0, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 7.0, 1.0);
	HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; 0, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 7.0, 1.0);

	for (i = 0; i < 35 * 5; i += 1) {
		if (fancytunedisplay_cl >= 2) {
			break;
		}
		Delay(1);
	}
	// Delay(35*5);

	temp_x = m_infolength * 8;
	temp_y = 0;
	temp_start = temp_whole >> 16;
	temp_store = m_infolength / -10;
	temp_whole = 0;
	for (i = 1; i < 20; i += 1) {
		temp_y = temp_x;
		temp_x = (temp_x * 0.855 + 0.75) >> 16;
		temp_store = temp_store - (temp_y - temp_x);
		temp_whole = (temp_start + temp_store - i) << 16;

		SetFont("CONFONT");
		HudMessage(s:"\cu",
			s:charline22_str, s:"\n", c:4, s:"\cc", s:tunecode_str, s:"\cu", c:6, s:"\n", s:charline88_str, c:5, s:"\n",
			s:charline2_str, s:"\n", c:4, s:"\cc", s:musical_str, s:"\cu", c:6, s:"\n", s:charline8_str;
			HUDMSG_ALPHA, -68743, CR_DARKGRAY, temp_whole - 0.1, 334.1 + y_aspect, 2.0, 0.05 * (20 - i));
		SetFont("STCFN606");
		HudMessage(s:"\c- AA", s:charline__str, s:charline__str; HUDMSG_ALPHA, -68741, -1, temp_whole - 0.1, 336.1 + y_aspect, 2.0, 0.05 * (20 - i));
		HudMessage(s:"\c- AA", s:char_line_str2, s:char_line_str2; HUDMSG_ALPHA, -68742, -1, temp_whole - 0.1, 360.1 + y_aspect, 2.0, 0.05 * (20 - i));
		Delay(1);
	}

	HudMessage(s:""; 0, -68743, -1, 0.99, 0.01, 1873);
	HudMessage(s:""; 0, -68742, -1, 0.99, 0.01, 1873);
	HudMessage(s:""; 0, -68741, -1, 0.99, 0.01, 1873);

	fancytunedisplay_cl -= 1;
}

// Clientside Display Zone

#define HUDMESSAGE_REFRESHER_RATE 175  // 404
bool refresh_hud_message;

script "ub_refreshHudMessageLoop" (void) {
	int cycle_delay;
	while (1) {
		cycle_delay++;
		Delay(1);
		if (cycle_delay >= HUDMESSAGE_REFRESHER_RATE || refresh_hud_message) {
			refresh_hud_message = true;
			Delay(1);
			refresh_hud_message = false;
			cycle_delay = 1;
		}
	}
}

// Scripts used by bosses themselves


#define COLORSARRAY_C 18
int the_colors_array[COLORSARRAY_C] = {9, 2, 1, 0, 6, 17, 18, 8, 10, 5, 3, 16, 21, 7, 13, 19, 20, 12};
script "UH_RainbowHudMessage" (int whoisit, int y_off_set) CLIENTSIDE {
	// if(ConsolePlayerNumber() != PlayerNumber()){
	//		terminate;
	// }
	int color_num = random(0, COLORSARRAY_C);
	int y2_off_set = y_off_set * 5 / 3;  // If VS Event, lower HudMessage
	int alpha_num = 1;
	str tips_upper_line = "";
	str tips_lower_line = "";
	for (int t_p = 0; t_p < 31; t_p++)  // Could just do \x1E \x11
	{
		tips_upper_line = StrParam(s:tips_upper_line, c:30);
		tips_lower_line = StrParam(s:tips_lower_line, c:17);
	}

	SetFont("SMALLFONT");
	SetHudSize(640, 480, 0);
	if (GetUserCVar(ConsolePlayerNumber(), "uh_cl_ShowTipsOnScreen")) {
		// Console copy only — avoid a second on-screen TYPEON (typetime 0.95) on id 59
		Log(s:"\c[UH00]", c:29, s:tips_upper_line, c:31, s:"\n\n\c-", s:GetBossInstruction(whoisit), s:"\n\n\c[UH00]", c:16, s:tips_lower_line, c:18);
		HudMessage(s:GetBossInstruction(whoisit); HUDMSG_TYPEON, 59, CR_RED, 320.0, y2_off_set * 1.0 + 72.0, 2.0, 0.05, 2.0);
	}
	else {
		HudMessage(s:"\c[UH00]", c:29, s:tips_upper_line, c:31, s:"\n\n\c-", s:GetBossInstruction(whoisit), s:"\n\n\c[UH00]", c:16, s:tips_lower_line, c:18; HUDMSG_TYPEON | HUDMSG_LOG, 59, CR_WHITE, 0.5, 0.18, 2.0, 0.95, 2.0);
		HudMessage(s:"Check your console (", k:"toggleconsole", s:"key) to view flavour text or tips!"; HUDMSG_TYPEON, 59, CR_WHITE, 320.0, y2_off_set * 1.0 + 72.0, 3.957, 0.01, 0.571);
	}
	SetHudSize(384, 288, 0);  // 480,360//480,300

	// HudMessage(s:"You are ", s:B_NameStr, s:"\c-!"; HUDMSG_FADEOUT, 66, CR_YELLOW,0.5, 0.10, 3.0,2.0);
	HudMessage(s:"\ckYou are\n\cd"; HUDMSG_FADEINOUT, -6001, -1, 192.4, y_off_set * 1.0 + 24.0, 3.957, 0.571, 0.571);
	for (int i = 0; i < 35 * 5; i++) {
		HudMessage(s:"\cd\n\c- (*) ", s:GetBossName(whoisit), s:" \c-(*)"; HUDMSG_ALPHA, -6000, the_colors_array[color_num], 192.4, y_off_set * 1.0 + 24.0, 0.5, 0.05 * alpha_num);

		if (i < 20) alpha_num++;
		else if (i > 35 * 5 - 20) alpha_num--;
		if (i % 5 == 0) color_num++;
		if (color_num > COLORSARRAY_C) color_num = 0;
		Delay(1);
	}
	HudMessage(s:""; 0, -6000, -1, 0.99, 0.01, 1873);
}

#define HELLTIMER_OFFSETX 50.1
#define HELLTIMER_OFFSETY 309.1
script "ub_HellTimerHud" (int time_left) CLIENTSIDE {
	SetHudSize(640, 480, 0);
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}

	ACS_NamedExecuteWithResult("uh_DrawTimerHud", time_left, 0);
}

script "uh_DrawTimerHud" (int time_left, int type) CLIENTSIDE {
	SetHudSize(640, 480, 0);
	int x_aspect2 = GetHudLeft(640) * 1.0;
	int y_aspect2 = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect2 = 0;
		y_aspect2 = 0;
	}
	int x, y;
	int holdtime, alert_time;
	switch (type) {
		default:
			break;
		case 0:
			x = 50.1 + x_aspect2; y = 309.1 + y_aspect2;
			holdtime = 2.0; alert_time = 0;
			break;
		case 1:
			x = 300.1; y = 49.1; holdtime = 0;
			holdtime = 1.0; alert_time = 60;
			break;
	}
	SetFont(strparam(s:"HELTIMR", i:time_left > 0));
	HudMessage(s:"A"; HUDMSG_FADEOUT, 167 + type * 2, -1, x, y, holdtime, 3.0);
	SetFont("fakefntC");  // SMALLFONT
	HudMessageBold(i:time_left; HUDMSG_FADEOUT, 166 + type * 2, CR_GOLD + (time_left <= alert_time), x + 17.0, y + 5.0, holdtime, 3.0);
}


script "ub_DemoneyeNumWatcher" (void) {
	SetActivator(0, AAPTR_NULL);

	int eye_count;
	while (true) {
		if (eye_count != total_players_arr[6]) {
			eye_count = total_players_arr[6];
			ACS_NamedExecuteWithResult("ub_DemoneyeNumDisplay", eye_count);
		}
		Delay(1);
		if (refresh_hud_message) {
			if (eye_count > 0) {
				ACS_NamedExecuteWithResult("ub_DemoneyeNumDisplay", eye_count);
				Delay(1);
			}
		}
	}
}
script "ub_DemoneyeNumDisplay" (int eye_count) CLIENTSIDE {
	FuncDemoneyeNumDisplay(eye_count);
}
function void FuncDemoneyeNumDisplay(int eye_count) {
	SetHudSize(640, 480, 0);
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int fader = (eye_count == 0);  // If 0 Eyes, apply Fadeout
	SetFont("EYE_F_0E");
	HudMessage(s:"A"; 0 + fader, -996, -1, 10.1 + x_aspect, 309.1 + y_aspect, 0, 1.0, 3.0 * fader);
	SetFont("fakefntC");  // SMALLFONT
	HudMessage(s:"\c[MenuPurple]", i:eye_count; 0 + fader, -997, 19, 37.1 + x_aspect, 318.1 + y_aspect, 0, 1.0, 3.0 * fader);
}

script "ub_BossHealthWatcher" (void) {
	SetActivator(0, AAPTR_NULL);

	until (boss_slot_alive[0] || boss_slot_alive[1] || boss_slot_alive[2] || boss_slot_alive[3]) {
		Delay(1);
	}
	while (boss_slot_alive[0] || boss_slot_alive[1] || boss_slot_alive[2] || boss_slot_alive[3]) {

		FuncBHWShowHudMess(false);
		Delay(1);
		if (refresh_hud_message) {
			FuncBHWShowHudMess(true);
			Delay(1);
		}
	}
	DebugLog(strParam(s:"ub_BossHealthWatcher FINISHED!"));
	FuncBHWShowHudMess(true);
}

function void FuncBHWShowHudMess(bool force) {
	for (int i = multi_boss_check - 1; i >= 0; i--) {
		FuncBHWChecker(i, boss_data_arr[i][BOSSDATA_TID], boss_data_arr[i][BOSSDATA_NUM], force);
	}
}

function void FuncBHWChecker(int num_b, int tid_of_boss, int which_boss, bool force) {
	if (PlayerInGame(tid_of_boss - 1000) && boss_slot_alive[num_b]) {
		boss_hp_arr[num_b][BOSSHP_CURRHP] = GetActorProperty(tid_of_boss, APROP_HEALTH);
		boss_hp_arr[num_b][BOSSHP_CURRARMOR] = CheckActorInventory(tid_of_boss, "BasicArmor");
		if (boss_hp_arr[num_b][BOSSHP_CURRHP] <= 0) {  // Boss is Dead!
			if (timer() <= 35 * 30) {boss_hp_arr[num_b][BOSSHP_DEATH] = 6;}
			else {boss_hp_arr[num_b][BOSSHP_DEATH] = 5;}
			FuncBHWDeadHudMess(num_b + 1, which_boss, boss_hp_arr[num_b][BOSSHP_DEATH]);
			boss_slot_alive[num_b] = false;
		}
		else if (shadow_reveal_active && shadow_tricks_arr[num_b]) {  // During Shadow, show Blue
			FuncBHWDeadHudMess(num_b + 1, which_boss, 8);
		}
		else if (boss_hp_arr[num_b][BOSSHP_HPMEM] != boss_hp_arr[num_b][BOSSHP_CURRHP] || boss_hp_arr[num_b][BOSSHP_CURRARMOR] != boss_hp_arr[num_b][BOSSHP_ARMORMEM]) {
			boss_hp_arr[num_b][BOSSHP_HPMEM] = boss_hp_arr[num_b][BOSSHP_CURRHP];
			boss_hp_arr[num_b][BOSSHP_ARMORMEM] = boss_hp_arr[num_b][BOSSHP_CURRARMOR];
			FuncBHWHudMess(num_b + 1, which_boss, boss_hp_arr[num_b][BOSSHP_HPMEM], boss_hp_arr[num_b][BOSSHP_ARMORMEM]);
		}
		else if (force) {
			FuncBHWHudMess(num_b + 1, which_boss, boss_hp_arr[num_b][BOSSHP_HPMEM], boss_hp_arr[num_b][BOSSHP_ARMORMEM]);
		}
	}
	else if (boss_slot_alive[num_b]) {  // Boss Spectated!
		boss_hp_arr[num_b][BOSSHP_ARMORMEM] = -1;
		boss_hp_arr[num_b][BOSSHP_DEATH] = 7;
		FuncBHWDeadHudMess(num_b + 1, which_boss, boss_hp_arr[num_b][BOSSHP_DEATH]);
		boss_slot_alive[num_b] = false;
	}
	else if (force) {
		FuncBHWDeadHudMess(num_b + 1, which_boss, boss_hp_arr[num_b][BOSSHP_DEATH]);
	}
}

script "ub_BHW_HudClientside" (int the_boss, int boss_numb, int health, int armor) CLIENTSIDE {
	FuncBHWHudMess2(the_boss, boss_numb, health, armor);
}

function void FuncBHWHudMess(int the_boss, int boss_numb, int health, int armor) {
	ACS_NamedExecuteWithResult("ub_BHW_HudClientside", the_boss, boss_numb, health, armor);
}

// BossNumb survivor HUD packing (parade / class face):
//   vanilla class: -100 - sid                 (-100 .. -(100+UH_MAX_VANILLA_SURV-1))
//   custom class:  -300 - SurvCustomIndex(sid) (<= -300, > -600)
//   shiny vanilla: -600 - sid                 (<= -600) — clears -1..-99 for custom bosses
function int EncodeSurvivorBossNumb(int sid) {
	if (sid == UHSURV_FAIL)
		return 0;
	if (sid >= 0)
		return sid * -1 - 100;
	return -300 - SurvCustomIndex(sid);
}

function int EncodeSurvivorShinyBossNumb(int sid) {
	if (sid == UHSURV_FAIL)
		return 0;
	if (sid >= 0)
		return -600 - sid;
	// Custom survivors: table mugshot via class band (no C-ICN).
	return EncodeSurvivorBossNumb(sid);
}

function int DecodeSurvivorBossNumb(int boss_numb) {
	// Order matters: shiny <= -600 is also <= -300.
	if (boss_numb <= -600)
		return(boss_numb + 600) * -1;
	if (boss_numb <= -300)
		return -1 - (-300 - boss_numb);
	if (boss_numb <= -100)
		return(boss_numb + 100) * -1;
	return UHSURV_FAIL;
}

function bool IsSurvivorBossNumb(int boss_numb) {
	return boss_numb <= -100;
}

function bool IsSurvivorShinyBossNumb(int boss_numb) {
	return boss_numb <= -600;
}

// Demoneye BossNumb packing:
//   vanilla eye: 1000 + id          (0→1000, 32→1032, 100→1100)
//   custom eye:  2000 + EyeCustomIndex(id)  (clears 0..999 boss band)
function int EncodeEyeBossNumb(int eye_id) {
	if (eye_id == UHEYE_FAIL)
		return 0;
	if (eye_id >= 0)
		return 1000 + eye_id;
	return 2000 + EyeCustomIndex(eye_id);
}

function int DecodeEyeBossNumb(int boss_numb) {
	if (boss_numb >= 2000)
		return -1 - (boss_numb - 2000);
	if (boss_numb >= 1000)
		return boss_numb - 1000;
	return UHEYE_FAIL;
}

function bool IsEyeBossNumb(int boss_numb) {
	return boss_numb >= 1000;
}

function void FuncBHWHudMess2(int the_boss, int boss_numb, int health, int armor) {
	SetHudSize(640, 480, 0);  // 640,512
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int add_to_y = the_boss * 32.0 + y_aspect;

	FuncBHWSetFontMug(boss_numb);

	HudMessage(s:"A"; 0, -1000 - the_boss, -1, 10.1 + x_aspect, 306.1 + add_to_y, 0, 1.0);
	SetFont("SMALLFONT");
	str name_str;
	if (IsSurvivorBossNumb(boss_numb))
		name_str = GetSurvivorName(DecodeSurvivorBossNumb(boss_numb));
	else if (IsEyeBossNumb(boss_numb))
		name_str = GetEyeHudName(DecodeEyeBossNumb(boss_numb));
	else
		name_str = GetBossName(boss_numb);
	HudMessage(s:name_str; 0, -990 - the_boss, -1, 48.1 + x_aspect, 310.1 + add_to_y, 0, 1.0);
	HudMessage(s:"\c[UB0HP]", i:health; 0, -1010 - the_boss, -1, 48.1 + x_aspect, 320.1 + add_to_y, 0, 1.0);
	if (armor >= 1) {
		HudMessage(s:"\c[UB0AR]", i:armor; 0, -1020 - the_boss, -1, 48.1 + x_aspect, 330.1 + add_to_y, 0, 1.0);
	}
	else {
		HudMessage(s:" "; 0, -1020 - the_boss, -1, 48.1 + x_aspect, 330.1 + add_to_y, 0.1, 1.0);
	}
}

function void FuncBHWDeadHudMess(int the_boss, int boss_numb, int demise_type) {
	ACS_NamedExecuteWithResult("ub_BHW_DeadHudClientside", the_boss, boss_numb, demise_type);
}


script "ub_BHW_DeadHudClientside" (int the_boss, int boss_numb, int demise_type) CLIENTSIDE {
	FuncBHWDeadHudMess2(the_boss, boss_numb, demise_type);
}

function void FuncBHWSetFontMug(int boss_numb) {
	str font_str;
	// Survivor-packed bands (<= -100, includes shiny <= -600): never GetBossMugshot.
	if (IsSurvivorBossNumb(boss_numb)) {
		int sid_surv = DecodeSurvivorBossNumb(boss_numb);
		str mug_surv = GetSurvivorMugshotRaw(sid_surv);
		if (StrCmp(mug_surv, "") != 0)
			font_str = mug_surv;
		else if (IsSurvivorShinyBossNumb(boss_numb))
			font_str = StrParam(s:"C-ICN", i:sid_surv);
		else if (sid_surv >= 0)
			font_str = StrParam(s:"C@ICN", i:sid_surv);
		else
			font_str = "NOFAC_0";
		if (CheckFont(font_str))
			SetFont(font_str);
		else
			SetFont("NOFAC_0");
		return;
	}
	str mug = GetBossMugshot(boss_numb);
	if (StrCmp(mug, "") != 0) {
		font_str = mug;
		if (CheckFont(font_str))
			SetFont(font_str);
		else
			SetFont("NOFAC_0");
		return;
	}
	if (boss_numb >= 1000) {  // Demoneye (vanilla 1000+id or custom 2000+idx)
		int eid_mug = DecodeEyeBossNumb(boss_numb);
		str eye_mug = GetEyeMugshot(eid_mug);
		if (StrCmp(eye_mug, "") != 0)
			font_str = eye_mug;
		else if (eid_mug >= 0)
			font_str = StrParam(s:"EYE_F", i:eid_mug);
		else
			font_str = "NOFAC_0";
	}
	else if (boss_numb >= 0) {  // Boss
		font_str = StrParam(s:"UFACE", i:boss_numb);
	}
	else
		font_str = "NOFAC_0";
	if (CheckFont(font_str))
		SetFont(font_str);
	else
		SetFont("NOFAC_0");
}

function void FuncBHWDeadHudMess2(int the_boss, int boss_numb, int demise_type) {
	SetHudSize(640, 480, 0);  // 640,512
	int x_aspect = GetHudLeft(640) * 1.0;
	int y_aspect = GetHudTop(480) * 1.0;
	if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
		x_aspect = 0;
		y_aspect = 0;
	}
	int add_to_y = the_boss * 32.0 + y_aspect;

	HudMessage(s:""; 0, -1060 - the_boss, -1, 0.99, 0.01, 1873);  // Rage

	FuncBHWSetFontMug(boss_numb);

	HudMessage(s:"A"; 0, -1000 - the_boss, -1, 10.1 + x_aspect, 306.1 + add_to_y, 0, 1.0);
	SetFont(StrParam(s:"UFACE0", i:demise_type * 11));  // Tint
	HudMessage(s:"A"; 0, -1010 - the_boss, -1, 10.1 + x_aspect, 306.1 + add_to_y, 0, 1.0);
	SetFont(StrParam(s:"UFACE00", i:demise_type));  // Icon
	HudMessage(s:"A"; 0, -1020 - the_boss, -1, 10.1 + x_aspect, 306.1 + add_to_y, 0, 1.0);
}

script "ub_RageDisplay" (void) {
	int act_tid = ActivatorTID();
	SetActivator(0, AAPTR_NULL);
	int curr_hp = GetActorProperty(act_tid, APROP_Health);
	int rage_max = CheckActorInventory(act_tid, "UnholyPowerLimit_F");
	if (curr_hp <= 0 || rage_max <= 0) {  // Player user_HPTrack
		terminate;
	}
	int old_hp = -1;
	int diff_hp;

	int boss_spacing = CheckActorInventory(act_tid, "Is_UH_BossNum");
	if (boss_spacing > 4 || CheckActorInventory(act_tid, "UnholyPowerDisableRazzle_F"))
		boss_spacing = 0;


	str rage_name = StrParam(s:"UnholyPower", i:rage_max);

	bool rage_box_bool = false;
	// SetHudSize(640,480,0);//640,512
	// SetFont("UFACE0RR");
	while (GetActorProperty(act_tid, APROP_HEALTH) > 0 && CheckActorInventory(act_tid, "UnholyPowerLimit_F") > 0) {
		curr_hp = GetActorProperty(act_tid, APROP_Health);
		diff_hp = old_hp - curr_hp;

		if (diff_hp > 0) {
			GiveActorInventory(act_tid, rage_name, diff_hp);
		}
		if (old_hp != curr_hp) {
			old_hp = curr_hp;
		}

		if (boss_spacing > 0) {
			if (CheckActorInventory(act_tid, rage_name) >= rage_max || CheckActorInventory(act_tid, "UnholyPowerDazzle_F")) {
				if (rage_box_bool) {
					if (refresh_hud_message) {
						// HudMessageBold(s:"A"; 0, -1060-boss_Spacing,-1, 10.1, 306.1+boss_Spacing*32.0, 0,1.0);
						FuncBHWRageHudMess(boss_spacing);
					}
				}
				else {
					// HudMessageBold
					FuncBHWRageHudMess(boss_spacing);
					rage_box_bool = true;
				}
			}
			else if (rage_box_bool) {
				HudMessageBold(s:""; 0, -1060 - boss_spacing, -1, 0.99, 0.01, 1873);
				rage_box_bool = false;
			}
		}
		// debugLog(strParam(s:"Looping ub_RageAmmoGiver for ",i:rage_Max));
		Delay(1);
	}
	if (rage_box_bool) {  // Doesn't work for Spectators
		HudMessageBold(s:""; 0, -1060 - boss_spacing, -1, 0.99, 0.01, 1873);
	}
}


// Dickhead self-revival mechanic: watch list, revival queue and the
// delayed-revival scripts.  Fragment of library unholy; watch-array
// helpers live in uh_funclib.acs, state/defines in uh_def.acs.

function void DickheadDoRevive(int selftid, int revived_tid, int isbossrevival, int bossslot) {
  int dropx;
  int dropy;
  int dropz;
  int pn;
  int bossnum;

  pn = revived_tid - 1000;
  dropx = GetActorX(selftid);
  dropy = GetActorY(selftid);
  dropz = GetActorZ(selftid);

  if (!isbonuseventactive) {
    if (isbossrevival) {
      bossnum = bossslot;
      bossdataarr[bossnum][BOSSDATA_MORPHED] = MorphActorToBoss(bossdataarr[bossnum][BOSSDATA_TID], bossdataarr[bossnum][BOSSDATA_NUM], "GigaAstroExplode");
      PlayerLifeStatusArr_UpdateFunc(pn, PLS_BOSS);
      bossslotalive[bossnum] = true;
    }
    else {
      PlayerLifeStatusArr_UpdateFunc(pn, PLS_SURVIVOR);
    }
  }

  SetActorPosition(revived_tid, dropx, dropy, dropz + 32.0, false);

  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  HudMessageBold(n:pn + 1, s:" \cvhas been revived!"; HUDMSG_FADEOUT | HUDMSG_LOG, 49, CR_YELLOW, 320.4, 464.2, 1.8, 0.2);
  RebuildActiveRoundState(revived_tid, 2);
  SetActorState(selftid, "UsedUp", 0);
}

script "rz_DickheadRevival" (void) {
  int isbossrevival;
  int revived_tid;
  int i;
  int j;
  int pn;
  int deadplayertidlist[MAX_PLAYERS];
  int deadsurvivorcount;
  int deadbosstidlist[MAX_BOSSES][2];
  int deadbosscount;
  int morphbossnum;
  int slot;
  int isboss;
  int waittics;
  int selftid;
  int owner_is_a_boss;

  selftid = ActivatorTID();
  if (selftid == 0) {
    selftid = UniqueTID();
    Thing_ChangeTID(0, selftid);
  }

  owner_is_a_boss = 0;
  if (SetActivator(0, AAPTR_TARGET))
    owner_is_a_boss = CheckInventory("Is_UH_BossNum");
  SetActivator(selftid);

  revived_tid = 0;
  isbossrevival = 0;
  deadsurvivorcount = 0;
  deadbosscount = 0;
  slot = 0;

  if (totalplayersarr[PLS_DEAD] != 0) {
    revivingqueue++;
    waittics = revivingqueue - 1;
    if (waittics > 0)
      Delay(waittics);

    ShuffleRevivalPlayerOrder();
    for (i = 0; i < MAX_PLAYERS; i++) {
      pn = revivalplayerorder[i];
      if (PlayerIsSpectator(pn) != 2)
        continue;

      isboss = 0;
      morphbossnum = 0;
      for (j = 0; j < multibosscheck; j++) {
        if (pn + 1000 == bossdataarr[j][BOSSDATA_TID]) {
          isboss = 1;
          morphbossnum = j;
          break;
        }
      }
      if (isboss) {
        deadbosstidlist[deadbosscount][0] = pn + 1000;
        deadbosstidlist[deadbosscount][1] = morphbossnum;
        deadbosscount++;
      }
      deadplayertidlist[deadsurvivorcount] = pn + 1000;
      deadsurvivorcount++;
      break;
    }

    if (owner_is_a_boss && deadbosscount > 0) {
      slot = random(0, deadbosscount - 1);
      revived_tid = deadbosstidlist[slot][0];
      isbossrevival = 1;
    }
    else if (deadsurvivorcount > 0) {
      revived_tid = deadplayertidlist[random(0, deadsurvivorcount - 1)];
      for (j = 0; j < multibosscheck; j++) {
        if (revived_tid == bossdataarr[j][BOSSDATA_TID]) {
          isbossrevival = 1;
          slot = j;
          deadbosstidlist[slot][1] = j;
          break;
        }
      }
    }

    // Versus duels forbid cross-slot boss revival: the fallen slot must stay
    // fallen so UHVS_Resolve sees a stable result.
    if (versusblockrevive && isbossrevival) {
      UH_Log(UH_LOG_DEBUG, "rz_DickheadRevival: versus round blocks boss revival");
      revivingqueue--;
      SetActorState(selftid, "BecomePickup", 0);
      DickheadWatchAdd(selftid);
      terminate;
    }

    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_DickheadRevival revived_tid=", i:revived_tid));
    if (revived_tid != 0) {
      ChangeActorFlag(selftid, "SPECIAL", false);
      SpawnForced("DickheadReviveBoom", GetActorX(selftid), GetActorY(selftid), GetActorZ(selftid));
      SetDeadSpectator(revived_tid - 1000, 0);
      Delay(2);
      DickheadDoRevive(selftid, revived_tid, isbossrevival, slot);
      revivingqueue--;
      terminate;
    }
    revivingqueue--;

    for (i = 0; i < MAX_PLAYERS; i++) {
      pn = revivalplayerorder[i];
      if (playerlifestatusarr[pn] != PLS_DEAD)
        continue;
      SetActorState(selftid, "BecomePickup", 0);
      SetActivator(selftid);
      ACS_NamedExecuteAlways("rz_DickheadRevivalDelayed", 0, pn, selftid);
      terminate;
    }
  }

  SetActorState(selftid, "BecomePickup", 0);
  DickheadWatchAdd(selftid);
}

script "rz_DickheadWatchDeath" (int dead_pn) {
  int selftid;

  if (dickheadwatchcount <= 0)
    terminate;

  selftid = DickheadWatchClaim();
  if (selftid == 0)
    terminate;

  SetActivator(selftid);
  ACS_NamedExecuteAlways("rz_DickheadRevivalDelayed", 0, dead_pn, selftid);
}

script "rz_DickheadRevivalDelayed" (int dead_pn, int selftid) {
  int revived_tid;
  int isbossrevival;
  int bossslot;
  int waittics;
  int j;

  SetActivator(selftid);
  Delay(DICKHEAD_REVIVE_DELAY);

  if (ClassifyActor(selftid) == ACTOR_NONE)
    terminate;

  if (PlayerIsSpectator(dead_pn) != 2) {
    DickheadWatchAdd(selftid);
    terminate;
  }

  revived_tid = dead_pn + 1000;
  isbossrevival = 0;
  bossslot = 0;
  for (j = 0; j < multibosscheck; j++) {
    if (revived_tid == bossdataarr[j][BOSSDATA_TID]) {
      isbossrevival = 1;
      bossslot = j;
      break;
    }
  }

  if (versusblockrevive && isbossrevival) {
    UH_Log(UH_LOG_DEBUG, "rz_DickheadRevivalDelayed: versus round blocks boss revival");
    DickheadWatchAdd(selftid);
    terminate;
  }

  revivingqueue++;
  waittics = revivingqueue - 1;
  if (waittics > 0)
    Delay(waittics);

  ChangeActorFlag(selftid, "SPECIAL", false);
  SpawnForced("DickheadReviveBoom", GetActorX(selftid), GetActorY(selftid), GetActorZ(selftid));
  SetDeadSpectator(dead_pn, 0);
  Delay(2);
  DickheadDoRevive(selftid, revived_tid, isbossrevival, bossslot);
  revivingqueue--;
}

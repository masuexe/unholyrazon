// Boss selection and morph helpers for library unholy.
// This fragment is textually included by uh_funclib.acs.

// This checks for specific CVAR numbers for boss selection and returns the BossNum if it matches the check
function int ForceBossChange(str force, bool truerandom) {
  int bossnum = GetCVAR(force);
  // if(!GetCVAR("UH_NoResetCVars"))
  // UHBOSS_FAIL (-9999) = unset. Do not use -1: that is a valid custom boss id.
  SetCVar(force, UHBOSS_FAIL);
  if (bossnum != UHBOSS_FAIL && CheckBossList(bossnum)) {
    bossnum = bossnum;
    ShowMeTheRCON(StrParam(s:"Boss ", s:StrRight(force, 1)), bossnum);
  }
  else {
    if (truerandom || bossnum == UHBOSS_FORCE_TRUE_RANDOM) {bossnum = TrueRandomBoss();}
    else {bossnum = UHBOSS_FAIL;}
  }

  return bossnum;
}

// Check if Boss # is even in the list
function bool CheckBossList(int checkme) {
  return IsBossDefined(checkme);
}

// --- Boss pick history (phase A: storage + accessors) -----------------------
// Razon 3-style least-seen fairness.  Phase A added the persistent counts and
// the validated accessors; phase B wired PickLeastSeenBossFromPool into
// TrueRandomBoss and added the per-round temporary delta below.  The permanent
// commit point (CommitSelectedBossHistory) is phase C, so nothing calls
// IncrementBossPickCount yet and every count still reads 0 — until then the
// picker is only as fair as the per-round delta.
// Counts live in the world arrays declared in uh_def.acs.  Signed boss ids must
// never index an array directly: vanilla ids use their own slot, custom ids go
// through UH_BossCustomIndex, and anything unregistered or out of range reports
// failure instead of reading/writing memory.

function int GetBossPickCount(int id) {
  int idx;
  if (id >= 0) {
    if (id >= UH_MAX_VANILLA_BOSS || !IsBossDefined(id))
      return -1;
    return uh_bosspickcount[id];
  }
  if (id <= -1) {
    idx = UH_BossCustomIndex(id);
    if (idx < 0 || !IsBossDefined(id))
      return -1;
    return uh_bosspickcustom[idx];
  }
  return -1;
}

// Phase A logs every commit (signed id, name, old -> new) at DEBUG level, which
// the logger's ALL (4) threshold enables, so a normal server stays quiet.
function void IncrementBossPickCount(int id) {
  int idx;
  int old;
  if (id >= 0) {
    if (id >= UH_MAX_VANILLA_BOSS || !IsBossDefined(id))
      return;
    old = uh_bosspickcount[id];
    uh_bosspickcount[id] = old + 1;
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss pick count ", s:GetBossName(id), s:" (id ", i:id,
        s:") ", i:old, s:" -> ", i:old + 1));
    return;
  }
  if (id <= -1) {
    idx = UH_BossCustomIndex(id);
    if (idx < 0 || !IsBossDefined(id))
      return;
    old = uh_bosspickcustom[idx];
    uh_bosspickcustom[idx] = old + 1;
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss pick count ", s:GetBossName(id), s:" (id ", i:id,
        s:") ", i:old, s:" -> ", i:old + 1));
  }
}

// Phase C commit point: IncrementBossPickCount is only reached from here and
// from the shadow manager, so every final line-up slot is counted exactly once
// and morph retries, revivals and abandoned picks never count.
function void CommitBossHistorySlot(int id) {
  if (!IsBossDefined(id))
    return;  // also rejects UHBOSS_FAIL and out-of-range ids
  IncrementBossPickCount(id);
}

// Standard, forced, Strongman and every Boss Combo mode all end up in
// bossdataarr before ub_MorphSelectedBosses starts, so one call covers them.
// Shadow slots are skipped: their final identity is only known after the reveal
// and is committed by ub_ShadowBossManager instead (never the placeholder).
function void CommitSelectedBossHistory(void) {
  for (int i = 0; i < multibosscheck; i++) {
    if (shadowtricksarr[i])
      continue;
    CommitBossHistorySlot(bossdataarr[i][BOSSDATA_NUM]);
  }
}

// Combo POOL mode picks inside its own member list; same lowest-count rule, but the
// candidate set is given explicitly instead of by rarity.  avoid uses the same
// "UHBOSS_FAIL excludes nothing" rule as PickLeastSeenBossFromPool.
function int PickLeastSeenComboBoss(int combo, int count, int avoid) {
  int best = UHBOSS_FAIL;
  int bestcount = 0;
  int ties = 0;
  for (int i = 0; i < count; i++) {
    int id = UH_ComboMemberId(combo, i);
    if (!IsBossEnabled(id) || id == avoid)
      continue;
    int c = GetBossPickCount(id);
    if (c < 0)
      continue;
    c += UH_BossRoundSeen(id);
    if (best == UHBOSS_FAIL || c < bestcount) {
      best = id;
      bestcount = c;
      ties = 1;
    }
    else if (c == bestcount) {
      ties++;
      if (random(1, ties) == 1)
        best = id;
    }
  }
  return best;
}

// Slots already chosen for THIS round.  They count as +1 while selecting so a
// multi-boss line-up spreads across equally-seen bosses; the permanent world
// count is only written by the phase C commit point, so a retry or an abandoned
// line-up cannot corrupt history.
#define UH_BOSSROUND_MAX 8
int uh_bossroundpicked[UH_BOSSROUND_MAX];
int uh_bossroundpickedcount;

function void UH_BossRoundReset(void) {
  uh_bossroundpickedcount = 0;
}

function void UH_BossRoundRecord(int id) {
  if (id == UHBOSS_FAIL)
    return;
  if (uh_bossroundpickedcount >= UH_BOSSROUND_MAX)
    return;
  uh_bossroundpicked[uh_bossroundpickedcount] = id;
  uh_bossroundpickedcount++;
}

function int UH_BossRoundSeen(int id) {
  int seen = 0;
  for (int i = 0; i < uh_bossroundpickedcount; i++) {
    if (uh_bossroundpicked[i] == id)
      seen++;
  }
  return seen;
}

// Lowest-count random pick inside one rarity pool.  Single-pass reservoir
// sampling: keep the minimum, and among equal-lowest candidates replace the
// current pick with probability 1/ties, so the registry order never biases the
// tie.  avoid is reserved for paths that must not repeat a boss (versus pairs).
// Plain rounds pass UHBOSS_FAIL: the loop already skips that value as "no
// candidate", so it excludes nothing.  Do NOT use -1 as "no exclusion" — -1 is
// a valid custom boss id (the first auto-registered custom boss) and passing it
// would silently drop that boss from every plain round.  A caller that must
// genuinely exclude custom boss -1 passes -1.
function int PickLeastSeenBossFromPool(int rarity, int avoid) {
  int n = GetBossPoolCount(rarity);
  int best = UHBOSS_FAIL;
  int bestcount = 0;
  int ties = 0;
  for (int i = 0; i < n; i++) {
    int id = GetBossPoolId(rarity, i);
    if (id == UHBOSS_FAIL || id == avoid)
      continue;
    int count = GetBossPickCount(id);
    if (count < 0)
      continue;
    count += UH_BossRoundSeen(id);
    if (best == UHBOSS_FAIL || count < bestcount) {
      best = id;
      bestcount = count;
      ties = 1;
    }
    else if (count == bestcount) {
      ties++;
      if (random(1, ties) == 1)
        best = id;
    }
  }
  return best;
}

// Standard (unforced, non-combo) round selection.  Reproduces the Unbound /
// Razon3 rarity boundary: the candidate comes from UHBOSS_POOL_COMMON unless
// the RareBossChance pity promotes the slot to UHBOSS_POOL_RARE, and a Rare
// roll keeps the legacy 10% chance to become a Shadow Trick instead.  It never
// consults Ultra/Special/EX -- those only appear through an active Strongman
// queue, an explicit forced id, or a deliberate full-pool TrueRandomBoss()
// path.  The slot is only used to flag the Shadow trick on the right line-up
// slot.  Falls back to Common, then to a safe defined boss 0.
function int PickStandardBoss(int slot) {
  int pool = UHBOSS_POOL_COMMON;
  int picked;

  if (random(rarebosschance, 25) >= 25) {
    if (RandomPercent(10))
      shadowtricksarr[slot] = true;
    else
      pool = UHBOSS_POOL_RARE;
    rarebosschance = 0;
  }
  else
    rarebosschance++;

  picked = PickLeastSeenBossFromPool(pool, UHBOSS_FAIL);
  if (picked == UHBOSS_FAIL || !IsBossDefined(picked))
    picked = PickLeastSeenBossFromPool(UHBOSS_POOL_COMMON, UHBOSS_FAIL);
  if (picked == UHBOSS_FAIL || !IsBossDefined(picked))
    picked = 0;

  UH_Log(UH_LOG_DEBUG, StrParam(s:"StandardBoss slot ", i:slot, s:" pool=", i:pool,
      s:" rarechance=", i:rarebosschance, s:" picked=", i:picked));
  return picked;
}

// TrueRandomBoss is the FULL-POOL draw (Ultra / Special / EX / Rare / Common).
// It may only be reached from paths that genuinely want every tier:
//   * UHBOSS_FORCE_TRUE_RANDOM or ForceBossChange(..., true);
//   * the final Shadow body;
//   * the deliberate all-pool boss events (e.g. bonus event 100, versus).
// Ordinary unforced rounds MUST use PickStandardBoss(): calling this from the
// standard branch is what leaked the 5% Ultra roll into opening rounds.
// NEW#BOSS — pool-based pick (no BOSSRNGMAX holes).  The rarity draw order and
// probabilities are unchanged; only the in-pool pick now prefers the least-seen
// boss.  Forced boss and UHBOSS_FORCE_TRUE_RANDOM semantics are untouched.
function int RollFullBossPool(void) {
  if (RandomPercent(5))
    return UHBOSS_POOL_ULTRA;
  else if (RandomPercent(1))
    return UHBOSS_POOL_SPECIAL;
  else if (RandomPercent(15))
    return UHBOSS_POOL_EX;
  else if (RandomPercent(30))
    return UHBOSS_POOL_RARE;
  return UHBOSS_POOL_COMMON;
}

function int TrueRandomBoss(void) {
  int rngpick = PickLeastSeenBossFromPool(RollFullBossPool(), UHBOSS_FAIL);

  if (rngpick == UHBOSS_FAIL || !IsBossDefined(rngpick))
    rngpick = PickLeastSeenBossFromPool(UHBOSS_POOL_COMMON, UHBOSS_FAIL);
  if (rngpick == UHBOSS_FAIL || !IsBossDefined(rngpick))
    rngpick = 0;
  return rngpick;
}


// Select Bosses
function void SetUpBossSelection_Func(void) {
  int tempboss;
  int selected;
  for (int i = 0; i < multibosscheck; i++) {
    tempboss = ForceBossChange(StrParam(s:"uh_sv_forcedboss", i:i + 1), false);
    if (IsBossDefined(tempboss)) {
      selected = tempboss;
      UH_Log(UH_LOG_DEBUG, StrParam(s:"BossSelect slot ", i:i + 1, s:" entry=forced picked=", i:selected));
    }
    else {
      // Ordinary unforced round: Common/Rare only.  Never TrueRandomBoss()
      // here, or the 5% Ultra roll can leak a 400-404 into an opening round.
      selected = PickStandardBoss(i);
      UH_Log(UH_LOG_DEBUG, StrParam(s:"BossSelect slot ", i:i + 1, s:" entry=standard picked=", i:selected));
    }

    if (tempboss == 300 || shadowtricksarr[i]) {
      shadowtricksarr[i] = true;
      shadowfakeoutactive = true;
      selected = TrueRandomBoss();
      UH_Log(UH_LOG_DEBUG, StrParam(s:"BossSelect slot ", i:i + 1, s:" entry=shadow-fullpool picked=", i:selected));
    }

    bossdataarr[i][BOSSDATA_NUM] = selected;

    // Feed this slot back into the round-scoped delta so the next slot prefers
    // a different equally-seen boss.  Shadow placeholders are not the final
    // identity, so they are excluded and left to the shadow commit path.
    if (!shadowtricksarr[i])
      UH_BossRoundRecord(bossdataarr[i][BOSSDATA_NUM]);
    UH_Log(UH_LOG_DEBUG, StrParam(s:"UnholyBoss", i:i + 1, s:" = ", i:bossdataarr[i][BOSSDATA_NUM]));
  }
}

// Assigns players as Bosses
function void SetUpPlayerSelection_Func(bool updateaggregate) {
  int tempplayer = 0;
  for (int i = 0; i < multibosscheck; i++) {
    tempplayer = CheckClearCVar(StrParam(s:"uh_sv_forcebossplayer", i:i + 1), -1);
    if (tempplayer >= 0 && tempplayer <= MAX_PLAYERS) {
      tempplayer += 1000;
    }
    if (i == 0 && bosschoiceconfirmed && bosschoicereassign) {
      // A departed winner's confirmed boss must go to the random replacement,
      // ahead of both the admin player override and the reward player queue.
      bossdataarr[i][BOSSDATA_TID] = bosschoicetid;
    }
    else if (PlayerPickCheck(tempplayer, i)) {  // If above check isn't -1, is a player number, and is in the game
      bossdataarr[i][BOSSDATA_TID] = tempplayer;
      ShowMeTheRCON(StrParam(s:"Boss-Forced Player ", i:i + 1), tempplayer);
    }
    else if (i == 0 && bosschoiceconfirmed &&
        PlayerPickCheck(bosschoicetid, i) && PlayerIsSpectator(bosschoicetid - 1000) == 0) {
      bossdataarr[i][BOSSDATA_TID] = bosschoicetid;
      if (playerforcenum[0] == bosschoicetid) {AdjustPlayerForceNumArray(-1);}
    }
    else if (PlayerPickCheck(playerforcenum[0], i)) {  // Check if scripts wants a player
      bossdataarr[i][BOSSDATA_TID] = playerforcenum[0];
      AdjustPlayerForceNumArray(-1);
    }
    else {  // If above never happens, RNG a player as boss
      bossdataarr[i][BOSSDATA_TID] = RngPickCheck(i);
    }
    tempplayer = bossdataarr[i][BOSSDATA_TID];
    GiveActorInventory(tempplayer, "Is_UH_BossNum", i + 1);  // Basic flag to track who is what boss
    if (shadowtricksarr[i]) {
      GiveActorInventory(tempplayer, "IsGonnaBeFake", 1);  // Specifically for Shadow boss
    }
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Boss ", i:i + 1, s:" TID = ", i:tempplayer));
    if (updateaggregate && playerlifestatusarr[tempplayer - 1000] == PLS_SURVIVOR) {
      totalplayersarr[PLS_SURVIVOR]--;
      totalplayersarr[PLS_BOSS]++;
    }
    playerlifestatusarr[tempplayer - 1000] = PLS_BOSS;
    uhsrvrole[tempplayer - 1000] = PLS_BOSS;  // Direct write: keep role cache in step.
  }
}

// Uniform reservoir sample over other connected, living, non-spectator pawns.
// Bounded scan also handles an empty server without an endless random retry.
function int PickBonusBossReplacement(int excludedtid) {
  int picked = 0;
  int count = 0;
  for (int player = 0; player < MAX_PLAYERS; player++) {
    int tid = player + 1000;
    if (tid == excludedtid || !PlayerPickCheck(tid, 0) ||
        PlayerIsSpectator(player) != 0 || GetActorProperty(tid, APROP_HEALTH) <= 0)
      continue;
    count++;
    if (random(1, count) == 1) {picked = tid;}
  }
  return picked;
}

// Randomly pick a player, if they are not ingame or are in use TID's, pick another random player.
function int RngPickCheck(int pastcheck) {
  int check;
  do {
    check = random(1000, playerlifestatusarr[MAX_PLAYERS] + 1000);  // 1063
  } while (!PlayerInGame(check - 1000) || CheckActorInventory(check, "IsDead") ||
      !CheckBossDataTIDFunc(check, pastcheck));

  return check;
}
// One time check similar to above.
function bool PlayerPickCheck(int tid, int pastcheck) {
  if (tid < 1) {
    return false;
  }
  else if (PlayerInGame(tid - 1000) && !CheckActorInventory(tid, "IsDead") &&
      tid >= 1000 && tid <= 1063 && CheckBossDataTIDFunc(tid, pastcheck)) {
    return true;
  }
  return false;
}

// Check if TID matches in use Boss TID
function bool CheckBossDataTIDFunc(int tid, int pastcheck) {
  for (int i = 0; i < pastcheck; i++) {
    if (tid == bossdataarr[i][BOSSDATA_TID]) {
      return false;
    }
  }
  return true;
}

function int MorphMeFunc(int tid, int boss, str flash) {
  return MorphActor(tid, GetBossActor(boss), "", 0x7ffffffd, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, flash, "");
}
function bool MorphActorToBoss(int tid, int boss, str flash) {
  if (!SetActivator(tid))
    return false;
  ACS_NamedExecuteWithResult("uh_MorphPreReset");
  bool success = MorphMeFunc(tid, boss, flash);
  if (!success) return false;
  SetActivator(tid);
  // Record identity/generation before the morph setup starts its watchers, so
  // every watcher captures the generation of this exact morph. A later
  // UnMorphActor or re-morph bumps it and retires the stale watchers.
  BeginPlayerBossMorph(PlayerNumber(), boss);
  ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
  GiveInventory("BasicBossItem", 1);
  str setup = GetBossMorphSetup(boss);
  if (StrCmp(setup, "") != 0) {
    if (CheckScript(setup, true)) {
      ACS_NamedExecuteWithResult(setup, boss, tid);
    }
    else {
      UH_Log(UH_LOG_ERROR, StrParam(s:"Missing boss morph setup script: ", s:setup));
    }
  }
  int basehp = GetBossHPBase(boss);
  if (basehp > 0)
    ACS_NamedExecuteWithResult("uh_BossMorph", boss, basehp, GetBossHPAdd(boss));
  return true;
}

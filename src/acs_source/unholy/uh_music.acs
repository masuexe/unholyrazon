// This records whatever the current music/code is for possible later use.
function void MusicSaveFunc(void) {
  savedmusiclump = currentmusiclump;
  savedmusictitle = currentmusictitle;
  savedmusicalbum = currentmusicalbum;
  savedmusicartist = currentmusicartist;
  savedmusiccontext = currentmusiccontext;
}

function void UH_ClearPublishedMusic(int context) {
  int gen;
  currentmusiclump = "";
  currentmusictitle = "";
  currentmusicalbum = "";
  currentmusicartist = "";
  currentmusiccontext = context;
  gen = GetCVar("_uh_ServMusicGen");
  if ((gen & 1) == 0)
    gen = gen + 1;
  else
    gen = gen + 2;
  SetCVar("_uh_ServMusicGen", gen);
  SetCVarString("_uh_ServMusicLump", "");
  SetCVarString("_uh_ServMusicTitle", "");
  SetCVarString("_uh_ServMusicAlbum", "");
  SetCVarString("_uh_ServMusicArtist", "");
  SetCVar("_uh_ServMusicContext", context);
  SetCVar("_uh_ServMusicGen", gen + 1);
}

function void PlayMusic(str music) {
  int len = StrLen(music);  // Also checks if music has a space and numbers after it
  int space = FindSpace(music, len);  // If it does, it plays the multi track

  if (space == -1) {
    SetMusic(music);
  } else {
    int len2 = len - space - 1;
    SetMusic(StrLeft(music, space), StringToInt(StrRight(music, len2), len2));
  }
  // Silence and map-default playback are not Unholy tracks. Drop the previous
  // snapshot so !music and Map Card do not keep showing it.
  if (!UH_MusicLumpPublishable(music))
    UH_ClearPublishedMusic(0);
}

function int UH_MusicLumpPublishable(str lump) {
  if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
    return 0;
  return 1;
}

// Strings are written before the even generation, so a client that sees a stable
// generation has already received this snapshot. Announce moves only for a new
// selection; a restore refreshes the snapshot without one.
function void UH_PublishMusic(str lump, str title, str album, str artist, int context, int announce) {
  int gen;
  int ann;
  if (!UH_MusicLumpPublishable(lump))
    return;

  currentmusiclump = lump;
  currentmusictitle = title;
  currentmusicalbum = album;
  currentmusicartist = artist;
  currentmusiccontext = context;

  gen = GetCVar("_uh_ServMusicGen");
  if ((gen & 1) == 0)
    gen = gen + 1;
  else
    gen = gen + 2;
  SetCVar("_uh_ServMusicGen", gen);
  SetCVarString("_uh_ServMusicLump", lump);
  SetCVarString("_uh_ServMusicTitle", title);
  SetCVarString("_uh_ServMusicAlbum", album);
  SetCVarString("_uh_ServMusicArtist", artist);
  SetCVar("_uh_ServMusicContext", context);
  if (announce) {
    ann = GetCVar("_uh_ServMusicAnnounce") + 1;
    if (ann < 1)
      ann = 1;
    SetCVar("_uh_ServMusicAnnounce", ann);
  }
  SetCVar("_uh_ServMusicGen", gen + 1);
}

function void UH_PingRoundMusicMode(int context) {
  int c;
  if (context != 1 && context != 2)
    return;
  for (c = 0; c < MAX_PLAYERS; c++) {
    if (UH_Ti_IsConnectedClient(c))
      NamedExecuteClientScript("uh_ApplyRoundMusicMode", c, context);
  }
}

function void UH_PlayTrack(str lump, str title, str album, str artist, int context, int announce) {
  PlayMusic(lump);
  UH_PublishMusic(lump, title, album, artist, context, announce);
  UH_PingRoundMusicMode(context);
}

function void UH_RestoreMusic(void) {
  UH_PlayTrack(savedmusiclump, savedmusictitle, savedmusicalbum, savedmusicartist, savedmusiccontext, 0);
}

function void UH_PlayBossRow(int row, int context, int announce) {
  if (row < 0)
    return;
  UH_PlayTrack(GetBossMusicLumpByRow(row), GetBossMusicTitleByRow(row), GetBossMusicAlbumByRow(row), GetBossMusicArtistByRow(row), context, announce);
}

function void UH_PlayBonusEventMusic(int eventid) {
  UH_PlayTrack(GetBonusEventMusic(eventid), GetBonusEventMusicTitle(eventid), GetBonusEventMusicAlbum(eventid), GetBonusEventMusicArtist(eventid), 0, 1);
}

function str UH_MapBossMusic(void) {
  str override = GetCVarString("mm8bdm_map_bossmusic");
  int par;
  if (StrLen(override) > 0)
    return override;
  par = GetLevelInfo(LEVELINFO_PAR_TIME);
  switch (par) {
    case 1: return "MM1BOSS";
    case 2: return "MM2BOSS";
    case 3: return "MM3BOSS";
    case 4: return "MM4BOSS";
    case 5: return "MM5BOSS";
    case 6: return "MM6BOSS";
    case 7: return "MM7BOSS";
    case 8: return "MM7OBOS";
    case 9: return "MM8BOSS";
    case 10: return "MM1PBOSS";
    case 11: return "DUOMUS";
    case 12: return "MMBBOSS";
    case 13: return "MMBOBOS";
    case 14: return "MMWTBOSS";
    case 15: return "MM9BOSS";
  }
  return "*";
}

function void UH_ClientPlayMusic(str music) {
  int len = StrLen(music);
  int space = FindSpace(music, len);
  if (space == -1) {
    SetMusic(music);
  } else {
    int digits = len - space - 1;
    SetMusic(StrLeft(music, space), StringToInt(StrRight(music, digits), digits));
  }
}

function void UH_ClientApplyRoundMusic(int mode, int context) {
  str lump;
  if (context != 1 && context != 2)
    return;
  if (mode == 1) {
    ACS_NamedExecuteAlways("uh_ApplyRoundMusicMode", 0, context);
    return;
  }
  lump = GetCVarString("_uh_ServMusicLump");
  if (!UH_MusicLumpPublishable(lump))
    return;
  UH_ClientPlayMusic(lump);
}

// The server still selects one Unholy tune. Each client may locally substitute
// the map's stage tune, or its MM8BDM boss tune once LMS begins.
script "uh_ApplyRoundMusicMode" (int context) CLIENTSIDE {
  int cpn = ConsolePlayerNumber();
  if (cpn < 0 || GetUserCVar(cpn, "uh_cl_MusicMode") == 0)
    terminate;
  if (context == 1) {
    SetMusic("*");
    // MM8BDM maps may provide a client-selected stage track here.
    ACS_NamedExecuteWithResult("core_setstagemusic_client");
  } else if (context == 2) {
    UH_ClientPlayMusic(UH_MapBossMusic());
    ACS_NamedExecuteWithResult("core_setupbossoverride_client");
  }
}

// The first stable generation is the baseline (startup or a late join). Only a
// later announce is a new selection. Mode and style changes refresh playback
// without displaying.
script "uh_WatchRoundMusicMode" OPEN CLIENTSIDE {
  int primed = 0;
  int lastgen = 0;
  int lastann = 0;
  int lastmode = -1;
  int lastcontext = -1;
  while (true) {
    int cpn = ConsolePlayerNumber();
    int gen;
    int mode;
    int context;
    int ann;
    if (cpn < 0) {
      Delay(1);
      continue;
    }
    gen = GetCVar("_uh_ServMusicGen");
    if (gen & 1) {
      Delay(1);
      continue;
    }
    if (!primed) {
      Delay(1);
      if (GetCVar("_uh_ServMusicGen") != gen)
        continue;
      primed = 1;
      lastgen = gen;
      lastann = GetCVar("_uh_ServMusicAnnounce");
      lastmode = GetUserCVar(cpn, "uh_cl_MusicMode");
      lastcontext = GetCVar("_uh_ServMusicContext");
      UH_ClientApplyRoundMusic(lastmode, lastcontext);
      continue;
    }
    mode = GetUserCVar(cpn, "uh_cl_MusicMode");
    context = GetCVar("_uh_ServMusicContext");
    ann = GetCVar("_uh_ServMusicAnnounce");
    if (gen != lastgen || mode != lastmode || context != lastcontext)
      UH_ClientApplyRoundMusic(mode, context);
    if ((gen != lastgen && !UH_MusicSnapshotReady()) || (mode != lastmode && mode == 1))
      ACS_NamedExecuteAlways("uh_MusicDismiss", 0);
    if (ann != lastann && ann > 0 && mode == 0)
      ACS_NamedExecuteAlways("uh_MusicAutoNotify", 0);
    lastgen = gen;
    lastann = ann;
    lastmode = mode;
    lastcontext = context;
    Delay(1);
  }
}

script "ub_PlayVariantMusic" (int thenum) {
  int row;

  // D6: combo music wins when defined; empty combo music falls back to the
  // selected boss's own music below.
  if (isbosseventactive && activebosscombo >= 0 && StrCmp(bosscombomusic[activebosscombo], "") != 0) {
    UH_PlayTrack(bosscombomusic[activebosscombo], bosscombotitle[activebosscombo], bosscomboalbum[activebosscombo], bosscomboartist[activebosscombo], 1, 1);
    terminate;
  }

  row = PickBossMusicRow(thenum, UHMUS_KIND_SPAWN, 0);
  if (row >= 0)
    UH_PlayBossRow(row, 1, 1);
  else {
    // No Unholy track for this boss. Stop the previous tune and drop its card.
    SetMusic("*");
    UH_ClearPublishedMusic(1);
    UH_PingRoundMusicMode(1);
  }
}

// Phase-2 / enrage music. which = legacy boss id from DECORATE; type = phase.
// Prefer activator class; fall back to which if class not in UHDT.
script "ub_BossEnrageMusic" (int which, int type) {
  int id;
  int row;

  if (!CheckInventory("Is_UH_BossNum") || CheckInventory("IsGonnaBeFake"))
    terminate;

  id = FindBossByActor(GetActorClass(0));
  if (id == UHBOSS_FAIL && IsBossDefined(which))
    id = which;
  if (id == UHBOSS_FAIL)
    terminate;

  row = PickBossMusicRow(id, UHMUS_KIND_ENRAGE, type);
  if (row < 0)
    terminate;

  UH_PlayBossRow(row, 1, 1);
}

function int PlayMusic_Winner(int force) {
  int row;
  int emulatedelay;

  // Force ignored: always weighted-random from UHMUS_KIND_WINNER pool.
  row = PickEventMusicRow(UHMUS_KIND_WINNER, 0);
  if (row < 0)
    return 0;

  UH_PlayBossRow(row, 0, 0);

  emulatedelay = 0;
  if (GetBossMusicEmuFlagByRow(row))
    emulatedelay = 12;
  return RoundFixedToInt(35 * GetBossMusicDurationByRow(row)) + emulatedelay;
}
function int PlayMusic_Loser(int force) {
  int row;
  int emulatedelay;

  // Force ignored: always weighted-random from UHMUS_KIND_LOSER pool.
  row = PickEventMusicRow(UHMUS_KIND_LOSER, 0);
  if (row < 0)
    return 0;

  UH_PlayBossRow(row, 0, 0);

  emulatedelay = 0;
  if (GetBossMusicEmuFlagByRow(row))
    emulatedelay = 12;
  return RoundFixedToInt(35 * GetBossMusicDurationByRow(row)) + emulatedelay;
}

function void PlayMusic_Win(int force) {
  if (!force) {force = random(1, 3);}
  switch (force) {
    case -2:  // Solo Boss Spec/Disconnect!
      UH_PlayTrack("VICT__T2", "Class Duel Declined", "Team Fortress 2", "", 0, 0);
      break;
    case 1:
      UH_PlayTrack("M_UWON_1", "Game Over", "Final Fight (SNES)", "", 0, 0);
      break;
    case 2:
      UH_PlayTrack("M_UWON_2", "Arena Victory", "Fire Emblem 7", "", 0, 0);
      break;
    case 3:
      UH_PlayTrack("MARIGOLF 31", "Won The Challenge!", "Mario Golf", "", 0, 0);
      break;
  }
}

function void PlayMusic_Loss(int force) {
  if (force < 1 || force > 3) {force = random(1, 3);}
  switch (force) {
    case 1:
      UH_PlayTrack("M_ULOS_1", "End Battle", "Super Street Fighter 2", "", 0, 0);
      break;
    case 2:
      UH_PlayTrack("M_ULOS_2", "Match Over", "Street Fighter 2", "", 0, 0);
      break;
    case 3:
      UH_PlayTrack("MARIGOLF 32", "Lose", "Mario Golf GBC", "", 0, 0);
      break;
  }
}

function int FindSpace(str string, int length) {
  for (int i = 0; i < length; i++) {
    if (GetChar(string, i) == ' ') {
      return i;
    }
  }
  return -1;
}

function int StringToInt(str string, int length) {
  int result = 0;

  for (int i = 0; i < length; i++) {
    result *= 10;
    result += (GetChar(string, i) - '0');
  }
  return result;
}

// uh_teaminfo.acs — Unholy client teammate snapshot, display semantics and
// the native TLMS-style teammate bar.
//
// Fragment of the single "unholy" library; #include'd by unholy/unholy.acs
// after uh_funclib.acs.  It is NOT a library and must not be added to LOADACS.
//
// Authority split:
//   * The server owns playerlifestatusarr, the active bonus event and every
//     live stat (health, armor, ready weapon, ammo).  In ordinary LMS the
//     engine classifies Unholy's logical teammates as enemies, so it withholds
//     their health/armor from clients; the server therefore pushes a
//     per-viewer snapshot with NamedExecuteClientScript, only for the subjects
//     UH_Ti_ServerAreDisplayTeammates authorizes that viewer to see.
//   * Clients own only this display cache.  A pure client never has valid
//     server runtime arrays, so nothing here may read playerlifestatusarr,
//     isbonuseventactive, eventdataarr or bossdataarr outside a server script.
//
// The same role cache drives the Unholy native bar, the UIXTEAM shadow and the
// SCORINFO UHPlayerIcon refresh, so the relation rules live here exactly once.

// --- Client display snapshot -------------------------------------------------
// uhtilife   : last synced PLS_* value (PLS_DEAD = 0, PLS_NULL = -1).
// uhtirole   : last non-dead role, retained across death so a dead player's
//              scoreboard row and teammate row keep their side.  PLS_EYE is a
//              role and deliberately suppresses regular-LMS teammate display.
// uhticlasscache: the actor class.  Refreshed from the live actor while one is
//              readable (so a morph is reflected immediately), and otherwise
//              derived from the server-synced (kind, vanilla id) identity — a
//              corpse has no readable class, so this is the dead-row face.  It is
//              cleared whenever the server publishes no identity, so a reused
//              slot can never inherit the previous player's class.
// uhtiova*   : frozen 1-vs-all active flag and target player number (drives
//              UH_AreDisplayTeammates, NOT scoreboard visibility).
// uhtiscorepolicy: synchronized UH_SCOREPOLICY_* for the scoreboard icon matrix.
//              Starts INVALID so only self is visible until the server snapshot.
int uhtilife[MAX_PLAYERS];
int uhtirole[MAX_PLAYERS];
int uhtiova;
int uhtiovatarget;
int uhtiscorepolicy;
// Stage ids are plain integers scoped to the locally resolved actor class.
int uhtiphase[MAX_PLAYERS];
str uhtiphaseactor[MAX_PLAYERS];

// Per-viewer portrait resolution cache: the live actor class is preferred so a
// morph is reflected before the next status sync; the server-published class is
// the fallback for dead/missing actors.
str uhticlasscache[MAX_PLAYERS];
bool uhtiscoreiconvalid[MAX_PLAYERS];

// Last scoreboard texture resolved from a live class, kept across death so a
// dead/body-less subject keeps its own face.  Without this, LuckyLass would
// revert from its scoreboard ScoreIcon UMUG_6_ to the UIX PBMug name UMUG_6
// once GetActorClass stops returning the class.
str uhscoreiconcache[MAX_PLAYERS];
bool uhscoreiconcachevalid[MAX_PLAYERS];

// Local player identity for the scoreboard refresh.  ConsolePlayerNumber()
// returns -1 on a listen server even inside a client-side script (NETSTATE_-
// SERVER), so the assist display latches the camera player here as a fallback.
int uhtilocalplayer = -1;

#define UH_TI_MAX_LIVES 15

// Per-viewer live stats received from the authoritative server snapshot.  A
// subject is renderable only while uhtistatvalid is set, which doubles as the
// authorization gate: the server never sends an unauthorized subject.
int uhtistathp[MAX_PLAYERS];
int uhtistatmaxhp[MAX_PLAYERS];
int uhtistatarmor[MAX_PLAYERS];
int uhtistatabsorb[MAX_PLAYERS];
int uhtistatlives[MAX_PLAYERS];
str uhtistattag[MAX_PLAYERS];
int uhtistatammo1[MAX_PLAYERS];
int uhtistatammo2[MAX_PLAYERS];
bool uhtistathasammo1[MAX_PLAYERS];
bool uhtistathasammo2[MAX_PLAYERS];
bool uhtistatvalid[MAX_PLAYERS];

// Native-bar HUD IDs used on the preceding frame; only these are cleared.
bool uhtiwasdrawn[MAX_PLAYERS];

function void UH_Ti_ClearStats(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return;}
  uhtistatvalid[pn] = false;
  uhtistathp[pn] = 0;
  uhtistatmaxhp[pn] = 0;
  uhtistatarmor[pn] = 0;
  uhtistatabsorb[pn] = 0;
  uhtistatlives[pn] = 0;
  uhtistattag[pn] = "";
  uhtistatammo1[pn] = 0;
  uhtistatammo2[pn] = 0;
  uhtistathasammo1[pn] = false;
  uhtistathasammo2[pn] = false;
}

function void UH_Ti_ResetClient(void) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    uhtilife[i] = PLS_NULL;
    uhtiphase[i] = 0;
    uhtiphaseactor[i] = "";
    uhtirole[i] = PLS_NULL;
    uhticlasscache[i] = "";
    uhtiscoreiconvalid[i] = false;
    uhscoreiconcache[i] = "";
    uhscoreiconcachevalid[i] = false;
    UH_Ti_ClearStats(i);
  }
  uhtiova = 0;
  uhtiovatarget = -1;
  uhtiscorepolicy = UH_SCOREPOLICY_INVALID;
  uhtilocalplayer = -1;
}

function void UH_Ti_SetClientLife(int pn, int status) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return;}
  uhtilife[pn] = status;
  if (status == PLS_SURVIVOR || status == PLS_BOSS || status == PLS_EYE) {
    if (uhtirole[pn] != status) {
      UH_Ti_ClearStats(pn);
      uhscoreiconcachevalid[pn] = false;  // class changes with the role
    }
    uhtirole[pn] = status;  // Role survives a later PLS_DEAD transition.
  }
  else if (status == PLS_NULL) {
    uhtirole[pn] = PLS_NULL;
    uhtiphase[pn] = 0;
    uhtiphaseactor[pn] = "";
    uhticlasscache[pn] = "";
    uhtiscoreiconvalid[pn] = false;
    uhscoreiconcache[pn] = "";
    uhscoreiconcachevalid[pn] = false;
    UH_Ti_ClearStats(pn);
  }
}

// --- CLIENTSIDE receivers (server broadcasts land here) ----------------------
// Plain integers only.  Never sync an ACS string here: NamedExecuteClientScript
// copies raw ints and the ACS string pool is per-process and garbage-collected,
// so a string index means nothing on the client.  Never sync a presentation row
// either: rows are assigned in registration order.
//
// The id is only trusted when it is a VANILLA slot (>= 0); a custom id would be
// load-order dependent.  UH_PLDEF_NONE (or an id this client cannot resolve)
// means "no stable identity" and CLEARS the cache — keeping the previous class
// is what would make a reused slot show the previous player's face.  A live
// actor repopulates the cache on the next frame, so a morph or a custom addon
// class is unaffected.
script "uh_ti_sync_status" (int pn, int status, int kind, int id) CLIENTSIDE {
  UH_Ti_SetClientLife(pn, status);
  if (pn < 0 || pn >= MAX_PLAYERS) {terminate;}
  // PLS_NULL means the slot is finished.  UH_Ti_SetClientLife has already
  // emptied the cache, and resolving an identity here would repopulate it in the
  // same script -- which is how a stale pair used to survive a slot clear.
  if (status == PLS_NULL) {terminate;}
  str cls = "";
  if (kind != UH_PLDEF_NONE && id >= 0) {
    // Resolve through THIS client's own tables, so a peer with a different addon
    // set derives its own content or nothing at all.
    cls = UH_Ti_ActorForIdentity(kind, id);
  }
  else if (kind == UH_PLDEF_NONE) {
    cls = UH_Ti_ActorClass(pn + 1000);
    // A custom class has no stable wire identity. Keep only a class this peer
    // observed itself; death may remove that body before the final snapshot.
    if (!StrLen(cls) && status == PLS_DEAD) {cls = uhticlasscache[pn];}
  }
  if (StrICmp(cls, uhticlasscache[pn]) != 0) {
    uhticlasscache[pn] = cls;
    // Network ACS scripts are linked at the head of the thinker list: a
    // same-tic stage receiver may already have run. Retain only a stage that
    // belongs to this exact new class, otherwise clear the old body's stage.
    if (StrICmp(cls, uhtiphaseactor[pn])) {
      uhtiphase[pn] = 0;
      uhtiphaseactor[pn] = "";
    }
    uhscoreiconcachevalid[pn] = false;
    uhtiscoreiconvalid[pn] = false;
  }
}

// Both messages carry the same identity and commute: the ACS thinker may run
// same-tic scripts in reverse receive order. No life-cache prerequisite here.
// Custom ids/rows/strings never cross the wire. A class without a vanilla
// identity uses only a body class this client can actually observe.
script "uh_ti_sync_phase" (int pn, int kind, int id, int phase) CLIENTSIDE {
  if (pn < 0 || pn >= MAX_PLAYERS) {terminate;}
  str actor = "";
  if (kind != UH_PLDEF_NONE && id >= 0)
    actor = UH_Ti_ActorForIdentity(kind, id);
  else if (kind == UH_PLDEF_NONE) {
    actor = UH_Ti_ActorClass(pn + 1000);
    if (!StrLen(actor) && uhtilife[pn] == PLS_DEAD)
      actor = uhtiphaseactor[pn];
  }
  if (!StrLen(actor) || phase < 0 || phase > 255) {phase = 0;}
  bool changed = uhtiphase[pn] != phase || StrICmp(uhtiphaseactor[pn], actor) != 0;
  uhtiphase[pn] = phase;
  uhtiphaseactor[pn] = actor;
  if (changed && StrLen(actor)) {
    // Also repairs a dead row for a client that joined after the transition.
    uhscoreiconcache[pn] = UH_PlayerPhaseScoreIcon(actor, phase);
    uhscoreiconcachevalid[pn] = StrLen(uhscoreiconcache[pn]) != 0;
  }
}

script "uh_ti_sync_ova" (int active, int target) CLIENTSIDE {
  int nextactive = active ? 1 : 0;
  int nexttarget = (nextactive && target >= 0 && target < MAX_PLAYERS) ? target : -1;

  // A full snapshot can be repeated several times during the initial client
  // hello.  Clearing live stats for an unchanged 0/-1 split briefly removes
  // every native teammate row before the following stat messages restore it,
  // which makes the text display flicker at startup.  Only a real side-split
  // transition invalidates the per-viewer authorization set.
  if (uhtiova != nextactive || uhtiovatarget != nexttarget) {
    for (int i = 0; i < MAX_PLAYERS; i++) {UH_Ti_ClearStats(i);}
  }
  uhtiova = nextactive;
  uhtiovatarget = nexttarget;
}

// Authoritative scoreboard portrait policy.  Any value outside the defined
// range (including the -1 INVALID sentinel) collapses to INVALID so a corrupt
// or missing broadcast can never widen visibility.  The refresh loop re-derives
// every row from this value on the next tic while TAB is held.
script "uh_ti_sync_policy" (int policy) CLIENTSIDE {
  if (policy < UH_SCOREPOLICY_NORMAL || policy > UH_SCOREPOLICY_MULTITEAM) {
    policy = UH_SCOREPOLICY_INVALID;
  }
  uhtiscorepolicy = policy;
}

// Per-subject live stats addressed to THIS client only.  NamedExecuteClient-
// Script passes (packed_s, packed1, tag, packed2); the server packs
// subject+absorb+lives, hp/maxhp, and armor/ammo so the four-int limit is never
// exceeded.
script "uh_ti_stat" (int packed_s, int packed1, int tag, int packed2) CLIENTSIDE {
  int pn = packed_s & 63;
  if (pn < 0 || pn >= MAX_PLAYERS) {terminate;}
  uhtistatabsorb[pn] = (packed_s >> 6) & 127;
  uhtistatlives[pn] = (packed_s >> 13) & UH_TI_MAX_LIVES;
  uhtistathp[pn] = packed1 & 65535;              // unsigned 16-bit
  uhtistatmaxhp[pn] = (packed1 >> 16) & 65535;   // unsigned 16-bit
  uhtistatarmor[pn] = packed2 & 1023;
  uhtistatammo1[pn] = (packed2 >> 10) & 1023;
  uhtistatammo2[pn] = (packed2 >> 20) & 1023;
  uhtistathasammo1[pn] = ((packed2 >> 30) & 1) != 0;
  uhtistathasammo2[pn] = ((packed2 >> 31) & 1) != 0;
  uhtistattag[pn] = tag;
  uhtistatvalid[pn] = true;
}

// Drop a subject once its body is gone (corpse removed / dead spectator).  The
// server broadcasts this on the in-game -> gone transition, so the row vanishes
// and the remaining teammates compact into the freed slot, matching
// HUD_DrawCoopInfo's corpse behaviour.
script "uh_ti_stat_clear" (int pn) CLIENTSIDE {
  UH_Ti_ClearStats(pn);
}

script "uh_ti_client_disconnect" (int gone) DISCONNECT CLIENTSIDE {
  if (gone < 0 || gone >= MAX_PLAYERS) {terminate;}
  UH_Ti_SetClientLife(gone, PLS_NULL);
  uhticlasscache[gone] = "";
  uhtiscoreiconvalid[gone] = false;
  uhscoreiconcache[gone] = "";
  uhscoreiconcachevalid[gone] = false;
  SetCustomPlayerValue("UHPlayerIcon", gone, "");
}

// --- Shared display semantics (the single relation source) -------------------
// A teammate row is selected by ROLE, not by current alive state, so a dead
// player can still own a dead row when the consumer's dead-row option is on.
// Consumers apply the alive/dead option themselves (UIX CV_SHOWDEAD, the
// native bar's uh_cl_teaminfo_dead).
function bool UH_AreDisplayTeammates(int viewer, int subject) {
  if (viewer < 0 || viewer >= MAX_PLAYERS) {return false;}
  if (subject < 0 || subject >= MAX_PLAYERS) {return false;}
  if (viewer == subject) {return false;}  // Never repeat yourself.
  if (uhtirole[viewer] == PLS_NULL || uhtirole[subject] == PLS_NULL) {return false;}

  if (uhtiova) {
    // Frozen 1-vs-all: the solo target is its own side; everyone else is the
    // many side.  Keyed on the target player number, never on PLS_EYE.
    if (uhtiovatarget < 0) {return false;}
    if (viewer == uhtiovatarget || subject == uhtiovatarget) {return false;}
    return true;
  }

  // Regular LMS.  Eye may still damage Eye, so Eye never forms a display team;
  // ALL_EYE / EYE_TEAM alone do not authorize teammates either.
  if (uhtirole[viewer] == PLS_EYE || uhtirole[subject] == PLS_EYE) {return false;}
  if (uhtirole[viewer] == PLS_SURVIVOR && uhtirole[subject] == PLS_SURVIVOR) {return true;}
  if (uhtirole[viewer] == PLS_BOSS && uhtirole[subject] == PLS_BOSS) {return true;}
  return false;
}

// TAB portrait permission matrix, applied to the VIEWER of the scoreboard.
// Evaluation order is fixed; each step is deliberate:
//   1. an invalid or unassigned subject is never shown (no cached face leak);
//   2. self is shown once the subject is valid, even if later policy data is
//      malformed;
//   3. a dead viewer or a connected true spectator sees every assigned player
//      (tested BEFORE the event/role branches so a dead FFA participant is not
//      pinned to self);
//   4. an invalid viewer or an unknown/ambiguous synchronized policy falls back
//      to self only;
//   5. the active bonus-event policy;
//   6. the ordinary-LMS role matrix;
//   7. otherwise hidden.
// The retained role (uhtirole) survives PLS_DEAD, so a dead row keeps its side.
function bool UH_CanSeeScoreIcon(int viewer, int subject) {
  // 1. Reject an unassigned slot (PLS_NULL covers a just-joined or stale row).
  if (subject < 0 || subject >= MAX_PLAYERS) {return false;}
  if (uhtirole[subject] == PLS_NULL) {return false;}
  // 2. Self is always visible after subject validation.
  if (viewer == subject) {return true;}
  // 3. Dead viewers and true spectators can spectate every assigned player.
  if (viewer >= 0 && viewer < MAX_PLAYERS) {
    if (uhtilife[viewer] == PLS_DEAD) {return true;}
    if (PlayerIsSpectator(viewer) == 1) {return true;}
  }
  // 4. Fail closed: invalid viewer or a policy we could not classify.
  if (viewer < 0 || viewer >= MAX_PLAYERS) {return false;}
  if (uhtiscorepolicy == UH_SCOREPOLICY_INVALID) {return false;}

  if (uhtiscorepolicy == UH_SCOREPOLICY_FFA) {
    // FFA (including Boss FFA): alive players see only self.
    return false;
  }
  if (uhtiscorepolicy == UH_SCOREPOLICY_ONEVSALL
      || uhtiscorepolicy == UH_SCOREPOLICY_ALL_EYE) {
    // Every assigned player's portrait is public in both policies.
    return true;
  }
  if (uhtiscorepolicy == UH_SCOREPOLICY_MULTITEAM) {
    // Eyelento of Pain: exact role equality on the two expected sides.  A Boss
    // or unknown live role is illegal under this policy and gets self only.
    if (uhtirole[viewer] == PLS_EYE) {return (uhtirole[subject] == PLS_EYE);}
    if (uhtirole[viewer] == PLS_SURVIVOR) {return (uhtirole[subject] == PLS_SURVIVOR);}
    return false;
  }
  if (uhtiscorepolicy == UH_SCOREPOLICY_NORMAL) {
    // Ordinary LMS.  A Survivor sees every assigned portrait (a later Eye morph
    // stays visible because that transformation is globally announced).  A Boss
    // or Eye sees self, every Boss and every Eye, but hides Survivors.  An
    // unknown viewer role is self only.
    if (uhtirole[viewer] == PLS_SURVIVOR) {return true;}
    if (uhtirole[viewer] == PLS_BOSS || uhtirole[viewer] == PLS_EYE) {
      return (uhtirole[subject] == PLS_BOSS || uhtirole[subject] == PLS_EYE);
    }
    return false;
  }
  // 7. Unknown policy value (the receiver clamps, so this is defensive).
  return false;
}


// Client-local MegaMan portrait resolution shared by teaminfo and scoreboard.
// Identity stays the registered actor class; skins never alter team or ids.
function str UH_PlayerAppearancePortrait(int tid) {
  str actor = UH_Ti_ActorClass(tid);
  if (StrICmp(actor, "MegaManU") != 0 && StrICmp(actor, "MegaManUShiny") != 0)
    return "";
  if (CheckActorInventory(tid, "YustManFlag"))
    return "YUSTMUG";
  int pn = tid - 1000;
  if (pn < 0 || pn >= MAX_PLAYERS)
    return "";
  int skin = GetPlayerSkin(pn, PLAYERSKIN_VISIBLE);
  if (skin >= 0 && GetSkinProperty(skin, "name", true) == SPROP_TYPE_STRING
    && StrICmp(GetSkinProperty(skin, "name"), "Base") != 0
    && GetSkinProperty(skin, "face", true) == SPROP_TYPE_STRING) {
    str face = GetSkinProperty(skin, "face");
    if (StrLen(face) != 0) {
      str mug = StrParam(s:face, s:"ST00");
      if (CheckFont(mug))
        return mug;
    }
  }
  // PBSKINS is optional. Its known font guards the call when UIX is absent.
  // Reuse the same Maestro preference as killfeed when UIX is loaded.
  if (CheckFont("PBOCMG1A")) {
    str fallback = ACS_NamedExecuteWithResult("PBMug_Megaman", tid);
    if (StrLen(fallback) != 0 && CheckFont(fallback))
      return fallback;
  }
  return "UMUG_0";
}

function int UH_Ti_PhaseForActor(int pn, str actor) {
  if (pn < 0 || pn >= MAX_PLAYERS || StrICmp(actor, uhtiphaseactor[pn]))
    return 0;
  return uhtiphase[pn];
}

function str UH_PlayerPortraitForTid(int tid) {
  str appearance = UH_PlayerAppearancePortrait(tid);
  if (StrLen(appearance) != 0)
    return appearance;
  str actor = UH_Ti_ActorClass(tid);
  return UH_PlayerPhasePortrait(actor, UH_Ti_PhaseForActor(tid - 1000, actor));
}

function str UH_PlayerScoreIconForTid(int tid) {
  str appearance = UH_PlayerAppearancePortrait(tid);
  if (StrLen(appearance) != 0)
    return appearance;
  str actor = UH_Ti_ActorClass(tid);
  return UH_PlayerPhaseScoreIcon(actor, UH_Ti_PhaseForActor(tid - 1000, actor));
}

// Resolve the display portrait for a player.  Live actors are looked up by
// class (morph-aware) through the shared UH_PlayerScoreIcon resolver; the
// server-synced definition identity is the dead/absent fallback.
function str UH_ClientPortraitTex(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return "";}
  if (uhtilife[pn] != PLS_DEAD && uhtilife[pn] != PLS_NULL) {
    str cls = UH_Ti_ActorClass(pn + 1000);
    // Appearance can change without changing actor class (YustMan skin).
    if (StrLen(cls) != 0) {
      uhticlasscache[pn] = cls;
      // Scoreboard icon, which falls back to the teammate-bar portrait.
      str tex = UH_PlayerScoreIconForTid(pn + 1000);
      uhscoreiconcache[pn] = tex;
      uhscoreiconcachevalid[pn] = (StrLen(tex) != 0);
    }
    if (uhscoreiconcachevalid[pn]) {return uhscoreiconcache[pn];}
  }
  // Dead/absent: keep the face resolved while the actor existed; only fall back
  // to the server-synced definition identity when this client never saw the
  // live class.
  if (uhscoreiconcachevalid[pn]) {return uhscoreiconcache[pn];}
  return UH_PlayerPhaseScoreIcon(uhticlasscache[pn],
    UH_Ti_PhaseForActor(pn, uhticlasscache[pn]));
}

// Teammate-bar / subline short name.  The class is resolved the same way for
// every consumer (live actor first, then the class cache, then the synced
// definition identity) and the display text comes from the shared resolver, so
// a class registered only by an addon shows its registered name.
function str UH_Ti_GetClassName(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return "";}
  str cls = "";
  if (uhtilife[pn] != PLS_DEAD && uhtilife[pn] != PLS_NULL) {
    cls = UH_Ti_ActorClass(pn + 1000);
    if (StrLen(cls) != 0) {uhticlasscache[pn] = cls;}
  }
  if (StrLen(cls) == 0 && StrLen(uhticlasscache[pn]) != 0) {
    cls = uhticlasscache[pn];
  }
  if (StrLen(cls) == 0) {cls = uhticlasscache[pn];}
  return UH_PlayerDisplayName(cls);
}

function bool UH_IsUnholyTeamMode(void) {
  return GetCVar("lastmanstanding") == 1;
}

// --- Cross-library named-script API (UIXTEAM shadow) -------------------------
// Function names and script names are case-insensitive to ACC, so the exported
// scripts are deliberately named differently from the functions above.
script "uh_IsUnholyTeamMode" (void) {
  SetResultValue(UH_IsUnholyTeamMode());
}
script "uh_IsDisplayTeammate" (int viewer, int subject) {
  SetResultValue(UH_AreDisplayTeammates(viewer, subject));
}
script "uh_ScoreIconVisible" (int viewer, int subject) {
  SetResultValue(UH_CanSeeScoreIcon(viewer, subject));
}
script "uh_GetTeammateHealth" (int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {SetResultValue(0); terminate;}
  SetResultValue(uhtistathp[pn]);
}
script "uh_GetTeammateMaxHealth" (int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {SetResultValue(0); terminate;}
  SetResultValue(uhtistatmaxhp[pn]);
}
script "uh_GetTeammateArmor" (int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {SetResultValue(0); terminate;}
  SetResultValue(uhtistatarmor[pn]);
}
script "uh_GetTeammateAbsorb" (int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {SetResultValue(0); terminate;}
  SetResultValue(uhtistatabsorb[pn]);
}
script "uh_GetTeammateLives" (int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {SetResultValue(0); terminate;}
  SetResultValue(uhtistatlives[pn]);
}
// UIX Better Team Display mugshot.  The resolver is keyed on the TID and reads
// the actor class plus the local presentation table itself, so UIX never has to
// duplicate the survivor/boss/eye lookup order.  Returns "" when the class has
// no registered portrait, which lets UIX keep its stock PBMug_<Class> fallback.
script "uh_GetTeamPortraitForTid" (int tid) {
  if (tid < 1000 || tid > 1063) {SetResultValue(""); terminate;}
  SetResultValue(UH_PlayerPortraitForTid(tid));
}

// --- Definition identity -> actor class --------------------------------------
// The status broadcast carries a (kind, vanilla id) pair of plain integers.  A
// client turns it back into an actor class through its OWN tables, so a peer
// with a different addon set resolves it to its own content or to nothing --
// never to another class's face.  An undefined slot returns "".
function str UH_Ti_ActorForIdentity(int kind, int id) {
  str actor = "";
  if (id < 0) {return "";}
  switch (kind) {
    case UH_PLDEF_SURVIVOR:
      actor = GetSurvivorActor(id);
      break;
    case UH_PLDEF_BOSS:
      actor = GetBossActor(id);
      break;
    case UH_PLDEF_EYE:
      actor = GetEyeActor(id);
      break;
    default:
      actor = "";
      break;
  }
  return actor;
}

// --- Client cache dump -------------------------------------------------------
// Logs every slot the server has published a class for, dead ones included, with
// what the resolver makes of it.  The property under test: the synced value is a
// class NAME, so a class this peer does not know resolves to an EMPTY face and
// never to another class's face.  Run it on a client:
//   puke uh_ti_TeamInfoCacheDump     (needs uh_cl_LogLevel >= 3)
script "uh_ti_TeamInfoCacheDump" (void) CLIENTSIDE {
  // Boundary marker: a reader must only parse the lines after the LAST "begin",
  // because the engine log is append-only and an earlier dump would otherwise
  // keep slots that a later dump no longer reports.
  UH_Log(UH_LOG_INFO, "TeamInfoCache: begin");
  for (int i = 0; i < MAX_PLAYERS; i++) {
    str cls = uhticlasscache[i];
    if (StrCmp(cls, "") == 0) {continue;}
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamInfoCache: slot ", i:i,
      s:" ", s:cls,
      s:" -> name=", s:UH_PlayerDisplayName(cls),
      s:" portrait=", s:UH_PlayerPortrait(cls),
      s:" scoreIcon=", s:UH_PlayerScoreIcon(cls),
      s:" known=", i:(FindTeamPresentation(cls) != UHTIP_NONE)));
  }
}

// --- Late join: full snapshot ------------------------------------------------
script "uh_ti_enter" ENTER {
  Delay(35);
  // Late join: push the full snapshot to the entering client only.  Everyone
  // else already holds the round state, so re-broadcasting here would be pure
  // repetition.
  int joiner = PlayerNumber();
  if (joiner >= 0) {
    UH_TeamInfo_SendSnapshotTo(joiner);
  }
}

// --- Server-authoritative teammate stats -------------------------------------
// Mirrors UH_AreDisplayTeammates server-side from the retained role cache, so
// the per-viewer snapshot authorizes exactly the rows the bar may draw.
function bool UH_Ti_ServerAreDisplayTeammates(int viewer, int subject) {
  if (viewer < 0 || viewer >= MAX_PLAYERS) {return false;}
  if (subject < 0 || subject >= MAX_PLAYERS) {return false;}
  if (viewer == subject) {return false;}
  if (uhsrvrole[viewer] == PLS_NULL || uhsrvrole[subject] == PLS_NULL) {return false;}
  if (UH_TeamInfo_IsOneVsAllActive()) {
    int t = UH_TeamInfo_OneVsAllTarget();
    if (t < 0) {return false;}
    if (viewer == t || subject == t) {return false;}
    return true;
  }
  if (uhsrvrole[viewer] == PLS_EYE || uhsrvrole[subject] == PLS_EYE) {return false;}
  if (uhsrvrole[viewer] == PLS_SURVIVOR && uhsrvrole[subject] == PLS_SURVIVOR) {return true;}
  if (uhsrvrole[viewer] == PLS_BOSS && uhsrvrole[subject] == PLS_BOSS) {return true;}
  return false;
}

// Gameplay callers must use server roles, never the client display cache.
script "uh_ZangiefAreTeammates" (int owner, int victim) {
  SetResultValue(UH_Ti_ServerAreDisplayTeammates(owner, victim));
}

// Cached 8BDT bridge results, refreshed only when a player's ready weapon
// changes.  UH_TOOLS owns the 8BDT import; the round core must not import it.
str uhsrvwepactor[MAX_PLAYERS];
str uhsrvweptag[MAX_PLAYERS];
str uhsrvammo1name[MAX_PLAYERS];
str uhsrvammo2name[MAX_PLAYERS];

// Server-side in-game transition tracker: a subject that leaves the game (dead
// spectator, corpse removed, disconnect) is cleared exactly once so clients drop
// its row instead of keeping the last synced stat forever.
bool uhsrvWasingame[MAX_PLAYERS];

// Per-client initial-snapshot handshake.  A client that connects as a true
// spectator never spawns, so the ENTER snapshot (uh_ti_enter) never fires for
// it and its cache would stay PLS_NULL / INVALID with no portraits.  The watch
// loop detects each new connection and repeats the full snapshot for ~0.6 s so
// it survives the client's own uh_ti_clientinit_cs reset at map load.
bool uhsrvHelloSeen[MAX_PLAYERS];
int uhsrvHelloTics[MAX_PLAYERS];

function void UH_Ti_ServerHelloClients(void) {
  for (int c = 0; c < MAX_PLAYERS; c++) {
    if (!UH_Ti_IsConnectedClient(c)) {
      uhsrvHelloSeen[c] = false;
      uhsrvHelloTics[c] = 0;
      continue;
    }
    if (!uhsrvHelloSeen[c]) {
      uhsrvHelloSeen[c] = true;
      uhsrvHelloTics[c] = 3;  // ~0.6 s at the 7-tic watch cadence
    }
    if (uhsrvHelloTics[c] > 0) {
      UH_TeamInfo_SendSnapshotTo(c);
      uhsrvHelloTics[c]--;
    }
  }
}

// Immediate hello-slot reset for a disconnecting client.  The watch also clears
// the slot when it observes the disconnect, but a disconnect followed by a
// same-slot reconnect between two 7-tic polls would otherwise leave
// uhsrvHelloSeen set and the new client would never receive its hello.  Called
// from the server DISCONNECT handler (ub_Disconnect_ChangeIsAlive).
function void UH_Ti_ServerForgetClient(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return;}
  uhsrvHelloSeen[pn] = false;
  uhsrvHelloTics[pn] = 0;
}

function void UH_Ti_RefreshStats(void) {
  // Newly connected clients (including true spectators) get the full snapshot
  // even though they never spawn and so never run the ENTER snapshot.
  UH_Ti_RefreshPhases();
  UH_Ti_ServerHelloClients();

  // DF_INFINITE_AMMO = 1 << 11.
  bool infinite = (GetCVar("dmflags") & 2048) != 0;

  // Cache the per-viewer eligibility once per refresh: PlayerIsSpectator == 1
  // is a connected true spectator (PlayerInGame excludes spectators).
  bool vspec[MAX_PLAYERS];
  bool velig[MAX_PLAYERS];
  bool uixOn = GetCVar("UIX_SV_TEAMINFO") != 0;
  for (int v = 0; v < MAX_PLAYERS; v++) {
    vspec[v] = (PlayerIsSpectator(v) == 1);
    velig[v] = false;
    if (!PlayerInGame(v) && !vspec[v]) {continue;}
    bool nativeOn = (GetUserCVar(v, "uh_cl_teaminfo") != 0);
    bool uixClientOn = (uixOn && GetUserCVar(v, "UIX_CL_Enable") != 0
                        && GetUserCVar(v, "UIX_CL_TEAMINFO") != 0);
    if (!nativeOn && !uixClientOn) {continue;}
    velig[v] = true;
  }

  for (int s = 0; s < MAX_PLAYERS; s++) {
    int tid = s + 1000;
    // HUD_DrawCoopInfo draws a row while the player is in game AND has a body
    // (a dead body with health <= 0 still shows "dead"), and skips spectators /
    // players whose mo is gone.  Mirror that: a body-less or spectating player
    // clears here, which is what makes the dead row disappear and the list
    // compact after the corpse is removed.
    bool ingame = PlayerInGame(s) && ClassifyActor(tid) != ACTOR_NONE;
    if (!ingame) {
      if (uhsrvWasingame[s]) {
        uhsrvWasingame[s] = false;
        // Per-client clear: the receiver is CLIENTSIDE, so a plain
        // ACS_NamedExecuteAlways would not reach remote clients.
        for (int cl = 0; cl < MAX_PLAYERS; cl++) {
          if (UH_Ti_IsConnectedClient(cl)) {
            NamedExecuteClientScript("uh_ti_stat_clear", cl, s);
          }
        }
      }
      continue;
    }
    uhsrvWasingame[s] = true;
    int hp = GetActorProperty(tid, APROP_Health);
    if (hp < 0) {hp = 0;} if (hp > 65535) {hp = 65535;}
    int maxhp = GetActorProperty(tid, APROP_SpawnHealth);
    if (maxhp < 0) {maxhp = 0;} if (maxhp > 65535) {maxhp = 65535;}
    int armor = CheckActorInventory(tid, "BasicArmor");
    if (armor < 0) {armor = 0;} if (armor > 1023) {armor = 1023;}

    int lives = CheckActorInventory(tid, "PlayerPropertyExtraLife");
    if (lives < 0) {lives = 0;} if (lives > UH_TI_MAX_LIVES) {lives = UH_TI_MAX_LIVES;}
    int absorbPct = 0;

    str tag = "";
    int a1 = 0; int a2 = 0; int has1 = 0; int has2 = 0;
    if (hp > 0) {
      SetActivatorToPlayer(s);
      if (armor > 0) {
        absorbPct = FixedMul(GetArmorInfo(ARMORINFO_SAVEPERCENT), 100.0) >> 16;
        if (absorbPct < 0) {absorbPct = 0;}
        if (absorbPct > 100) {absorbPct = 100;}
      }
      str wactor = GetWeapon();
      SetActivator(0, AAPTR_NULL);
      if (StrICmp(wactor, uhsrvwepactor[s]) != 0) {
        uhsrvwepactor[s] = wactor;
        uhsrvweptag[s] = ACS_NamedExecuteWithResult("uh_WeaponTag_S", tid);
        uhsrvammo1name[s] = ACS_NamedExecuteWithResult("uh_WeaponAmmo1_S", tid);
        uhsrvammo2name[s] = ACS_NamedExecuteWithResult("uh_WeaponAmmo2_S", tid);
      }
      tag = uhsrvweptag[s];
      if (StrLen(uhsrvammo1name[s]) != 0 && !infinite) {
        has1 = 1;
        a1 = CheckActorInventory(tid, uhsrvammo1name[s]);
        if (a1 < 0) {a1 = 0;} if (a1 > 1023) {a1 = 1023;}
      }
      if (StrLen(uhsrvammo2name[s]) != 0 && !infinite) {
        has2 = 1;
        a2 = CheckActorInventory(tid, uhsrvammo2name[s]);
        if (a2 < 0) {a2 = 0;} if (a2 > 1023) {a2 = 1023;}
      }
    }

    int packed1 = (hp & 65535) | ((maxhp & 65535) << 16);
    int packed2 = armor | (a1 << 10) | (a2 << 20) | (has1 << 30) | (has2 << 31);
    int packed_s = (s & 63) | ((absorbPct & 127) << 6) | ((lives & UH_TI_MAX_LIVES) << 13);

    for (int vw = 0; vw < MAX_PLAYERS; vw++) {
      if (!velig[vw]) {continue;}
      // A living client normally views itself, so its own row is omitted by
      // UH_Ti_Draw and did not need a snapshot.  Chasecam can instead follow a
      // living teammate; the camera player is then omitted and the console
      // player becomes a legitimate teammate row.  Always send each client its
      // own stats so that row is available without widening anyone else's
      // authorization set.
      if (!vspec[vw] && s != vw
          && !UH_Ti_ServerAreDisplayTeammates(vw, s)) {continue;}
        NamedExecuteClientScript("uh_ti_stat", vw, packed_s, packed1, tag, packed2);
    }
  }
}

script "uh_ti_serverwatch_start" OPEN {
  if (GetCVar("lastmanstanding") != 1) {terminate;}
  ACS_NamedExecute("uh_ti_serverwatch", 0);
}

script "uh_ti_serverwatch" (void) {
  SetActivator(0, AAPTR_NULL);
  while (true) {
    Delay(7);
    if (GetCVar("lastmanstanding") != 1) {continue;}
    if (gameover) {continue;}
    UH_Ti_RefreshStats();
  }
}

// --- Native teammate bar -----------------------------------------------------
// Registered with the MM8BDM Assist Display; core_Assist_Display runs it every
// tic per client with the current camera TID as "cam".  UIX's Better Team
// Display suppresses it (see UH_TeamInfo_UIXTakesOver) to avoid a double draw.
// This reproduces the Zandronum TLMS HUD_DrawCoopInfo layout in ACS: two
// columns alternating left/right, three SmallFont lines per player (name,
// health/armor, weapon/ammo), anchored below the chat area (con_notifylines).

#include "../hud/scoreboard_icons.acs"

#define UH_TI_ID_BASE -19740000

function bool UH_TeamInfo_UIXTakesOver(int cpn) {
  // Unknown CVARs read as 0 when UIX is not loaded, so this is not a hard
  // dependency on the UIX libraries.
  if (GetCVar("UIX_SV_TEAMINFO") == 0) {return false;}
  if (GetUserCVar(cpn, "UIX_CL_Enable") == 0) {return false;}
  if (GetUserCVar(cpn, "UIX_CL_TEAMINFO") == 0) {return false;}
  return true;
}

// Draw beneath SBARINFO, which the engine renders after the UnderHUD layer.
// Match the renderer layer so disabled/hidden rows are cleared immediately.
function void UH_Ti_ClearMessage(int id) {
  HudMessage(s:""; HUDMSG_PLAIN | HUDMSG_LAYER_UNDERHUD, id, 0, 0.0, 0.0, 0.0);
}

function void UH_Ti_ClearSubject(int i) {
  UH_Ti_ClearMessage(UH_TI_ID_BASE - i);
  UH_Ti_ClearMessage(UH_TI_ID_BASE - 100 - i);
  UH_Ti_ClearMessage(UH_TI_ID_BASE - 200 - i);
}

// Clear only the IDs drawn on the preceding frame, plus everything when the
// renderer is disabled or taken over.  No 128-ID sweep every tic.
function void UH_Ti_ClearDrawn(void) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (uhtiwasdrawn[i]) {
      UH_Ti_ClearSubject(i);
      uhtiwasdrawn[i] = false;
    }
  }
}

function void UH_Ti_Draw(int viewer, int cpn) {
  bool shownames = GetUserCVar(cpn, "uh_cl_teaminfo_names") != 0;
  bool showhealth = GetUserCVar(cpn, "uh_cl_teaminfo_health") != 0;
  bool showweapon = GetUserCVar(cpn, "uh_cl_teaminfo_weapon") != 0;
  bool showdead = GetUserCVar(cpn, "uh_cl_teaminfo_dead") != 0;
  int hpstyle = GetUserCVar(cpn, "uh_cl_teaminfo_hpstyle");
  int subline = GetUserCVar(cpn, "uh_cl_teaminfo_subline");
  bool showlives = GetUserCVar(cpn, "uh_cl_teaminfo_lives") != 0;

  int scale = GetUserCVar(cpn, "uh_cl_teaminfo_scale");
  if (scale < 50) {scale = 50;} if (scale > 200) {scale = 200;}
  int alpha = GetUserCVar(cpn, "uh_cl_teaminfo_alpha");
  if (alpha < 0) {alpha = 0;} if (alpha > 100) {alpha = 100;}
  int offx = GetUserCVar(cpn, "uh_cl_teaminfo_x");
  int offy = GetUserCVar(cpn, "uh_cl_teaminfo_y");
  int notify = GetCVar("con_notifylines");
  if (notify < 0) {notify = 0;}

  // Mirror C_UpdateVirtualScreen's g_bScale: HUD_DrawCoopInfo draws through
  // the console virtual canvas only when con_scaletext is on AND the virtual
  // size differs from the real screen; otherwise it draws in real screen
  // pixels.  Make 100% equal whichever canvas the engine uses, then scale by
  // shrinking/growing that size.  Metrics stay in these units.
  int realw = GetScreenWidth();
  int realh = GetScreenHeight();
  int basew = realw;
  int baseh = realh;
  int virtw = GetCVar("con_virtualwidth");
  int virth = GetCVar("con_virtualheight");
  if (GetCVar("con_scaletext") != 0 && virtw > 0 && virth > 0
      && (virtw != realw || virth != realh)) {
    basew = virtw;
    baseh = virth;
  }
  if (basew <= 0) {basew = 640;}
  if (baseh <= 0) {baseh = 480;}
  int hudw = (basew * 100) / scale;
  int hudh = (baseh * 100) / scale;
  int falpha = (alpha * 65536) / 100;
  // Match HUD_DrawCoopInfo's text metrics: the row unit is the SmallFont cell
  // height (12 in the Zandronum SMALLFONT), each line advances cell+1, and the
  // next two-player block advances 4*cell+3.  The previous hardcoded 8 left the
  // name and the health/armor line touching.
  int fonth = 12;
  int linestep = fonth + 1;
  int ybase = (1 + notify) * fonth;

  SetHudSize(hudw, hudh, 0);
  SetFont("SMALLFONT");

  bool viewerSpec = (viewer < 0 || viewer >= MAX_PLAYERS
    || !PlayerInGame(viewer) || PlayerIsSpectator(viewer) == 1);

  int row = 0;
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (i == viewer) {continue;}
    if (!uhtistatvalid[i]) {continue;}  // per-viewer authorization gate
    if (!viewerSpec && !UH_AreDisplayTeammates(viewer, i)) {continue;}
    bool dead = (uhtistathp[i] <= 0);
    if (dead && !showdead) {continue;}

    // HudMessage encodes alignment in the coordinate fraction: .1 = left edge,
    // .2 = right edge, .0 = center.  offx is an inward margin from each edge.
    // X uses .1 for even rows (left) and .2 for odd rows (right); Y uses .1 so
    // every line is top-anchored like HUD_DrawTextAligned.
    bool drawleft = ((row % 2) == 0);
    int xbase = drawleft ? offx : (hudw - offx);
    int y = ybase + ((row / 2) * (4 * fonth + 3)) + offy;
    // (n * 1.0) forces the integer cell into 16.16 before the alignment marker;
    // ACS does not promote "int + 0.1" and would drop the fraction.
    int fx = (xbase * 1.0) + (drawleft ? 0.1 : 0.2);
    int fy = (y * 1.0) + 0.1;
    int fy1 = ((y + linestep) * 1.0) + 0.1;
    int fy2 = ((y + 2 * linestep) * 1.0) + 0.1;

    if (shownames) {
      if (showlives && uhtistatlives[i] > 0) {
        HudMessageBold(n:i + 1, s:" \cG[x", i:uhtistatlives[i], s:"]";
          HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - i, CR_GREY,
          fx, fy, 0.1, falpha);
      }
      else {
        HudMessageBold(n:i + 1;
          HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - i, CR_GREY,
          fx, fy, 0.1, falpha);
      }
    }

    if (showhealth) {
      if (dead) {
        HudMessageBold(s:"dead";
          HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, CR_RED,
          fx, fy1, 0.1, falpha);
      }
      else {
        int hp = uhtistathp[i];
        int maxhp = uhtistatmaxhp[i];
        if (maxhp <= 0) {maxhp = hp;}
        if (maxhp <= 0) {maxhp = 1;}
        int pct = (100 * hp) / maxhp;
        int hcol = CR_RED;
        if (pct > 75) {hcol = CR_GREEN;}
        else if (pct > 50) {hcol = CR_GOLD;}
        else if (pct > 25) {hcol = CR_ORANGE;}

        int armor = uhtistatarmor[i];
        int absorb = uhtistatabsorb[i];

        switch (hpstyle) {
          default:
          case 0:  // HP / Max HP (+Armor)
            if (armor > 0 && absorb > 0) {
              HudMessageBold(i:hp, s:"\cD/", i:maxhp, s:" \cD[\cC+", i:armor, s:" \cA(", i:absorb, s:"%)\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else if (armor > 0) {
              HudMessageBold(i:hp, s:"\cD/", i:maxhp, s:" \cD[\cC+", i:armor, s:"\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else {
              HudMessageBold(i:hp, s:"\cD/", i:maxhp;
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            break;

          case 1:  // HP Only
            if (armor > 0 && absorb > 0) {
              HudMessageBold(i:hp, s:" \cD[\cC+", i:armor, s:" \cA(", i:absorb, s:"%)\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else if (armor > 0) {
              HudMessageBold(i:hp, s:" \cD[\cC+", i:armor, s:"\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else {
              HudMessageBold(i:hp;
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            break;

          case 2:  // Percentage
            if (armor > 0 && absorb > 0) {
              HudMessageBold(i:pct, s:"% \cD[\cC+", i:armor, s:" \cA(", i:absorb, s:"%)\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else if (armor > 0) {
              HudMessageBold(i:pct, s:"% \cD[\cC+", i:armor, s:"\cD]";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else {
              HudMessageBold(i:pct, s:"%";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            break;

          case 3:  // HP / Armor (Classic Doom, only shows armor if armor > 0)
            if (armor > 0 && absorb > 0) {
              HudMessageBold(i:hp, s:"\cD / \cC", i:armor, s:" \cA(", i:absorb, s:"%)";
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else if (armor > 0) {
              HudMessageBold(i:hp, s:"\cD / \cC", i:armor;
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            else {
              HudMessageBold(i:hp;
                HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 100 - i, hcol,
                fx, fy1, 0.1, falpha);
            }
            break;
        }
      }
    }

    if (showweapon && !dead && subline != 3) {
      int wy = fy2;
      bool haswep = (StrLen(uhtistattag[i]) != 0);

      if (subline == 1 || (!haswep && subline == 0)) {
        str clsname = UH_Ti_GetClassName(i);
        if (StrLen(clsname) != 0) {
          HudMessageBold(s:clsname;
            HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 200 - i, CR_CYAN,
            fx, wy, 0.1, falpha);
        }
      }
      else if (haswep) {
        if (uhtistathasammo2[i]) {
          HudMessageBold(l:uhtistattag[i], s:"\cF ", i:uhtistatammo1[i],
            s:"\cF ", i:uhtistatammo2[i];
            HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 200 - i, CR_GREEN,
            fx, wy, 0.1, falpha);
        }
        else if (uhtistathasammo1[i]) {
          HudMessageBold(l:uhtistattag[i], s:"\cF ", i:uhtistatammo1[i];
            HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 200 - i, CR_GREEN,
            fx, wy, 0.1, falpha);
        }
        else {
          HudMessageBold(l:uhtistattag[i], s:"\cG -";
            HUDMSG_PLAIN | HUDMSG_NOWRAP | HUDMSG_LAYER_UNDERHUD, UH_TI_ID_BASE - 200 - i, CR_GREEN,
            fx, wy, 0.1, falpha);
        }
      }
    }

    uhtiwasdrawn[i] = true;
    row++;
  }
}

script "uh_assist_teaminfo" (int cam) CLIENTSIDE {
  int cpn = ConsolePlayerNumber();

  // A listen server (hosted with -host) reports -1 even for client-side
  // scripts, so fall back to the camera player as the local identity; this
  // keeps the host's own bar and user cvars working.
  if (cpn < 0 && cam >= 1000 && cam <= 1063) {cpn = cam - 1000;}
  UH_Ti_ClearDrawn();
  if (cpn < 0) {terminate;}
  uhtilocalplayer = cpn;

  if (GetUserCVar(cpn, "uh_cl_teaminfo") == 0) {terminate;}
  if (GetCVar("cl_drawcoopinfo") == 0) {terminate;}
  if (GetCVar("sv_nocoopinfo") != 0) {terminate;}
  if (!UH_IsUnholyTeamMode()) {terminate;}
  if (UH_TeamInfo_UIXTakesOver(cpn)) {terminate;}

  int viewer = (cam >= 1000 && cam <= 1063) ? cam - 1000 : cpn;
  UH_Ti_Draw(viewer, cpn);
}

script "uh_ti_clientinit_cs" OPEN CLIENTSIDE {
  UH_Ti_ResetClient();
  // Register the bar with the MM8BDM Assist Display.  This mirrors DTADD's
  // DefineAssistDisplay without importing DTADD (which pulls 8BDT and would
  // collide with the uhdt import in this library).
  ConsoleCommand(StrParam(s:"set 8bdmassistdisplay_name \"uh_assist_teaminfo\""));
  ACS_NamedExecuteWithResult("core_DefineAssistDisplay_S");
}

// Client-only stage/cache diagnostic, including body-less and dead subjects.
script "uh_ti_PhaseCacheDump" (int pn) CLIENTSIDE {
  if (pn < 0 || pn >= MAX_PLAYERS) {terminate;}
  str actor = uhticlasscache[pn];
  int phase = UH_Ti_PhaseForActor(pn, actor);
  UH_Log(UH_LOG_INFO, StrParam(s:"PhaseCache: slot=", i:pn, s:" actor=", s:actor,
    s:" phase=", i:phase, s:" portrait=", s:UH_PlayerPhasePortrait(actor, phase),
    s:" icon=", s:UH_ClientPortraitTex(pn),
    s:" bossmug=", s:UH_PlayerPhaseBossMug(actor, phase)));
}

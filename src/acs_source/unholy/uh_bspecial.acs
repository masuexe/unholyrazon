Script "uh_BossMorph" (int whoisit, int BaseHP, int AddHP) //Boss messages and HP scripts
{
	SetInventory("ThisIsMyMagicBossNumber",whoisit);

	TakeInventory("PowerProtectSurvivor",1);
	TakeInventory("PowerProtectUnholyItem",1);


	if(multiBossCheck >= 2){// && !VersusFightEvent
		GiveInventory("PowerProtectBoss",1);//If multi boss, protect them from each other.
	}

	GiveInventory("BAWS",1);
	GiveInventory("MorphedFlag",1);

	int AB_Scale = CheckInventory("ArmorBonusScale_F");
	if(AB_Scale>=1){
		GiveInventory("DynamicArmorDosage_F",GetArmorInfo(1));

		if(MultiBossCheck>=1){
			int ArmorBonus = (PlayerCount()-1)/MultiBossCheck;
			str ArmorName = StrParam(s:GetBossActor(whoisit),s:"_BasicArmorBonus_P");

			Until (ArmorBonus <= 0) {
				GiveInventory("DynamicArmorDosage_F",AB_Scale);
				GiveInventory(ArmorName,1);
				ArmorBonus--;
			}
		}
	}


	NamedExecuteClientScript("UH_RainbowHudMessage",PlayerNumber(),whoisit,VersusFightEvent*24);

	ACS_NamedExecuteAlways("ub_RageDisplay",0);

	int HudID = 5;//ID to display the text //-10000
	int HudOffsetY = 4;//Text Y offset, 384 + Y * 32
//Sets up boss player name spacing and Face spacing. IE X has been selected to be Y.
	if(CheckInventory("Is_UH_BossNum")==1){
		HudID = 1; //-10001
		if(MultiBossCheck == 4){HudOffsetY = 0;}
		else if(MultiBossCheck == 3){HudOffsetY = 1;}
		else if(MultiBossCheck == 2){HudOffsetY = 2;}
		else if(MultiBossCheck == 1){HudOffsetY = 2;}
	}
	else if(CheckInventory("Is_UH_BossNum")==2){
		HudID = 2; //-10002
		if(MultiBossCheck == 4){HudOffsetY = 1;}
		else if(MultiBossCheck == 3){HudOffsetY = 2;}
		else if(MultiBossCheck == 2){HudOffsetY = 3;}
	}
	else if(CheckInventory("Is_UH_BossNum")==3){
		HudID = 3; //-10003
		if(MultiBossCheck == 4){HudOffsetY = 2;}
		else if(MultiBossCheck == 3){HudOffsetY = 3;}
	}
	else if(CheckInventory("Is_UH_BossNum")==4){
		HudID = 4; //-10004
		HudOffsetY = 3;
	}
	HudOffsetY *= 32.0;//24.0

	str B_NameStr = GetBossName(whoisit);//'Boss' name
	int B_Chr0 = GetChar(GetBossSpawnMsgType(whoisit),0);//Message style
	int B_Chr1 = GetChar(GetBossSpawnMsgType(whoisit),1);//Color
	int B_Chr2 = GetChar(GetBossSpawnMsgType(whoisit),2);//Punctuation...?!
	str B_MessStr = GetBossSpawnMsg(whoisit);//'Custom' Message
	
	//Defaults if nothing defined
	if(B_Chr1 == 0)
		B_Chr1 = 'k';
	if(B_Chr2 == 0)
		B_Chr2 = '!';
	//s:"\c",c:B_Chr1,	


	str spawnStr;// = StrParam(n:0, s:" \ckhas been selected to be ", s:B_NameStr, s:"\ck.");
	Switch (B_Chr0)//Bonus things
	{
		Default:
			if(RandomPercent(95))
				B_Chr0 = -1;
			break;
		Case 65:
		Case 66:
		Case 67:
		Case 69:
		Case 70:
		Case 81:
			if(RandomPercent(10))
				B_Chr0 = -1;
			break;
	}

	Switch (B_Chr0)//Bonus things
	{
		Default://~=Player 'Has been selected to be' Boss
			spawnStr = StrParam(n:0, s:" \ckhas been selected to be ", s:B_NameStr, s:"\ck!");
			break;
		Case 65://A=Player 'Custom'
			spawnStr = StrParam(n:0, s:" ", s:B_MessStr);
			break;
		Case 66://B=Player 'Custom' Boss
			spawnStr = StrParam(n:0,s:" \c",c:B_Chr1,s:B_MessStr,s:" ",s:B_NameStr,s:"\c",c:B_Chr1,c:B_Chr2);
			break;
		Case 67://C=(Player) Boss 'Custom'
			spawnStr = StrParam(s:"\c",c:B_Chr1,s:"(",n:0,s:"\c",c:B_Chr1,s:") ",s:B_NameStr,s:" \c",c:B_Chr1,s:B_MessStr,c:B_Chr2);
			break;
		Case 69://E='Custom' Boss (Player)
			spawnStr = StrParam(s:"\c",c:B_Chr1,s:B_MessStr,s:" ",s:B_NameStr,s:"\c",c:B_Chr1,c:B_Chr2,s:" (",n:0,s:"\c",c:B_Chr1,s:")");
			break;
		Case 70://F='Custom' (Player)
			spawnStr = StrParam(s:B_MessStr,s:" \cj(",n:0,s:"\cj)");
			break;
		Case 81://Q='Custom'
			spawnStr = StrParam(s:B_MessStr);
			break;

		Case -1://Loads of messages
			Switch(random(0,39)){
				//Case -1:spawnStr = StrParam(s:"\ckRCON made ", n:0, s:" \ckbe ", s:B_NameStr, s:"\ck!");break;
				Case 0: spawnStr = StrParam(n:0, s:" \ckhas been selected to be ", s:B_NameStr, s:"\ck.");break;
				Case 1: spawnStr = StrParam(n:0, s:"\ck is unfortunate enough to be ", s:B_NameStr, s:"\ck.");break;
				Case 2: spawnStr = StrParam(n:0, s:"\ck was cursed to be ", s:B_NameStr, s:"\ck.");break;
				Case 3: spawnStr = StrParam(n:0, s:"\ck was doomed to be ", s:B_NameStr, s:"\ck.");break;
				Case 4: spawnStr = StrParam(n:0, s:"\ck was destined to be ", s:B_NameStr, s:"\ck.");break;
				Case 5: spawnStr = StrParam(n:0, s:"\ck was replaced with ", s:B_NameStr, s:"\ck.");break;
				Case 6: spawnStr = StrParam(n:0, s:"\ck was bribed to be ", s:B_NameStr, s:"\ck.");break;
				Case 7: spawnStr = StrParam(n:0, s:"\ck didn't ask to be ", s:B_NameStr, s:"\ck.");break;//but is forced to.
				Case 8: spawnStr = StrParam(s:"\ckThe RNG gods made ",n:0, s:"\ck be ", s:B_NameStr, s:"\ck!");break;
				Case 9: spawnStr = StrParam(n:0, s:"\ck unlocked ", s:B_NameStr, s:"\ck!");break;//applied for a job and ended up as .
				Case 10:spawnStr = StrParam(n:0, s:"\ck got a new job as ", s:B_NameStr, s:"\ck.");break;//wanted a job, became ... instead
				Case 11:spawnStr = StrParam(n:0, s:"\ck is now ", s:B_NameStr, s:"\ck!");break;
				Case 12:spawnStr = StrParam(n:0, s:"\ck drew the short straw to be ", s:B_NameStr, s:"\ck.");break;//is now ... unwillingly
				Case 13:spawnStr = StrParam(s:"\ckThe Dice made ",n:0, s:"\ck -> ", s:B_NameStr);break;
				Case 14:spawnStr = StrParam(n:0, s:"\ck critical rolled into ", s:B_NameStr, s:"\ck!");break;//rolled the dice, became
				Case 15:spawnStr = StrParam(n:0, s:"\ck playerclasses into ", s:B_NameStr, s:"\ck.");break;
				Case 16:spawnStr = StrParam(n:0, s:"\ck has evolved into ", s:B_NameStr, s:"\ck.");break;
				Case 17:spawnStr = StrParam(n:0, s:"\ck counterpicks into ", s:B_NameStr, s:"\ck.");break;
				Case 18:spawnStr = StrParam(n:0, s:"\ck reincarnated as ", s:B_NameStr, s:"\ck.");break;
				Case 19:spawnStr = StrParam(n:0, s:"\ck ranked up into ", s:B_NameStr, s:"\ck.");break;
				Case 20:spawnStr = StrParam(n:0, s:"\ck spectated. ", s:B_NameStr, s:"\ck joined the game.");break;//'s loaded dice let them be !
				Case 21:spawnStr = StrParam(n:0, s:"\ck was sacrificed to summon ", s:B_NameStr, s:"\ck!");break;
				Case 22:spawnStr = StrParam(n:0, s:"\ck is dead. Long live ", s:B_NameStr, s:"\ck!");break;
				Case 23:spawnStr = StrParam(n:0, s:"\ck digievolved into ", s:B_NameStr, s:"\ck!");break;
				Case 24:spawnStr = StrParam(s:"\ckWatch out for ", s:B_NameStr, s:"\ck! (", n:0, s:"\ck)");break;
				Case 25:spawnStr = StrParam(n:0, s:"\ck got equipped with: ", s:B_NameStr);break;
				Case 26:spawnStr = StrParam(s:"\ckYou tracked down ", s:B_NameStr, s:"\ck! (", n:0, s:"\ck)");break;
				Case 27:spawnStr = StrParam(n:0, s:"\ck is ", s:B_NameStr, s:"\ck. Go wild.");break;
				Case 28:spawnStr = StrParam(s:B_NameStr, s:"\ck's ghost possessed ", n:0, s:"\ck!");break;
				Case 29:spawnStr = StrParam(n:0, s:"\ck found the ", s:B_NameStr, s:"\ck button!");break;
				Case 30:spawnStr = StrParam(n:0, s:"\ck bribed the game to be ", s:B_NameStr, s:"\ck!");break;
				Case 31:spawnStr = StrParam(s:B_NameStr, s:"\ck was ", n:0, s:"\ck all along!");break;
				Case 32:spawnStr = StrParam(s:"\ckEncountered a wild ", s:B_NameStr, s:"\ck! (", n:0, s:"\ck)");break;
				Case 33:spawnStr = StrParam(n:0, s:"\ck you're fired. ", s:B_NameStr, s:"\ck, promotion.");break;
				Case 34:spawnStr = StrParam(n:0, s:"\ck? Never heard of 'em. ~", s:B_NameStr);break;
				Case 35:spawnStr = StrParam(s:"\ckNo ", n:0, s:"\ck? Isn't that a shame, ", s:B_NameStr, s:"\ck.");break;
				Case 36:spawnStr = StrParam(s:B_NameStr, s:"\ck found ", n:0, s:"\ck's nuke codes!!");break;
				Case 37:spawnStr = StrParam(s:"\ck(", n:0, s:"\ck) ", s:B_NameStr, s:"\ck's location was found!");break;
				Case 38:spawnStr = StrParam(n:0, s:"\ck purchased the ", s:B_NameStr, s:"\ck DLC!");break;
				Case 39:spawnStr = StrParam(n:0, s:"\ck won the lottery to become ", s:B_NameStr, s:"\ck!");break;
			}
			break;
	}

	SetFont("BIGFONT");
	SetHudSize(640,480,0);
	HudMessageBold(s: spawnStr; HUDMSG_FADEOUT|HUDMSG_LOG, 50 + HudID, 10, 320.4, 352.2 + HudOffsetY, 1.8,0.2);//384

	Switch (whoisit)//Bonus things
	{
		Case 25://BusterMistress
			if(!CheckInventory("IsGonnaBeFake")){
				If(MultiBossCheck)
					GiveInventory("MistressCopyVisedBoxItem",(PlayerCount() + 1)/MultiBossCheck);
				else
					GiveInventory("MistressCopyVisedBoxItem",3);
			}
			break;
		Case 100://Hellbot
			ACS_NamedExecute("ub_HellTimerMonitor",0);
			break;
		Case 103://SirAlpha //Vlad used to be here, RIP ~Celebi
		Case 603://SirAlphaEX
			if(!CheckInventory("IsGonnaBeFake") && MultiBossCheck == 1){
				standardlmseventlocked = true; //Old-Styled Fighting.
				//NoItems = true; //How a Noble fights.
			}
			break;

		Case 107://Rogue
			if(!CheckInventory("IsGonnaBeFake") && MultiBossCheck == 1){
				standardlmseventlocked = true;
			}
			break;
		Case 300://???
			GiveInventory("ProsperityRune_ST",1);
			standardlmseventlocked = true;
			break;
		Case 402://Sampi
			if(!CheckInventory("IsGonnaBeFake") && MultiBossCheck == 1){
				standardlmseventlocked = true;
			}
			break;
		Case 403://Higlur
			ACS_NamedExecute("ub_HiglurLight",0);
			if(!CheckInventory("IsGonnaBeFake") && MultiBossCheck == 1){
				standardlmseventlocked = true;
			}
			break;
	}

	//multiBossCheck
	//This changes the health of the boss based on players and multibosses
	int MainHealth = BaseHP;
	If(multiBossCheck) {
		MainHealth = min(BaseHP+(PlayerCount() * AddHP/multiBossCheck)-AddHP/multiBossCheck, MAX_HEALTH);
		//if(Debug_TXT) {Print(d:AddHP/multiBossCheck);}
		SetActorProperty(0, APROP_HEALTH, MainHealth);
		SetActorProperty(0, APROP_SPAWNHEALTH, MainHealth);
	}
	//GiveActorInventory
	SetInventory("BossSpawnHealthFlag", MainHealth);
	Delay(1);
}


//Demoneyes + other morphes
Script "uh_DemoneyeMorph" (int whoisit, int Bonus)
{
	playerLifeStatusArr_UpdateFunc(PlayerNumber(), PLS_EYE);

	setInventory("ThisIsMyMagicEyeNumber", whoisit + Bonus*100); //Used for Menu Help/MugShot

	TakeInventory("PowerProtectSurvivor",1);
	TakeInventory("PowerProtectUnholyItem",1);

	GiveInventory("BAWS",1);
	GiveInventory("MorphedFlag",1);
	GiveInventory("IsAnEye",1);

	// PowerMorph has no ACS MorphActor hook — one-time flag sweep + post pipeline.
	if(!CheckInventory("UH_MorphPipelineDone_F")){
		GiveInventory("UH_MorphFlagReset_P", 1);
		GiveInventory("Core_MorphFlagReset_P", 1);
		GiveInventory("Core_MorphFlagReset2_P", 1);
	}
	ACS_NamedExecuteWithResult("uh_MorphPostReset", 0);

	if(Bonus && multiBossCheck >= 2){// && !VersusFightEvent
		GiveInventory("PowerProtectBoss",1);//If multi boss, protect them from each other.
	}

	SetFont("SMALLFONT");
	ClearHudMessage(66);
	SetHudSize(384,288,0);

	str eyeName;
	if (getChar(eyeList[whoisit][EYELIST_FLAGS], 0) == 0x41) {
		eyeName = strParam(s: eyeList[whoisit][EYELIST_PREFIX], s: eyeList[whoisit][EYELIST_NAME], s: "\ck");
	}
	else {
		eyeName = strParam(s: eyeList[whoisit][EYELIST_PREFIX], s: eyeList[whoisit][EYELIST_NAME], s: " \ckDemoneye");
	}
	HudMessage(s: "\ckYou are now ", s: eyeName, s: "!"; HUDMSG_FADEOUT, -6001, -1, 192.4, 24.0, 3.0, 2.0);
	//if(StrCmp(eyeList[whoisit][3],"") != 0) {HudMessage(s:"You aren't really getting paid for this anyways..."; HUDMSG_FADEOUT, 59, CR_RED,0.5, 0.18, 3.0,2.0);}

	if(!isDemoneyeEvent()){
		SetFont("BIGFONT");
		SetHudSize(640,480,0);
		HudMessageBold(n:0, s:" \ckwas paid to become ",s:eyeList[whoisit][EYELIST_PREFIX],s:eyeList[whoisit][EYELIST_NAME],s:" Demoneye\c-!"; HUDMSG_FADEOUT|HUDMSG_LOG, 49, CR_YELLOW,320.4, 464.2, 1.8,0.2);//468.2//0.98 Y
	}
}

Script "ub_HellTimerMonitor" (void)//HellBot Script
{
	SetActivator(0,AAPTR_NULL);
	HellTimer = 10+(PlayerCount() * 4);
	If(HellTimer>=90)
		HellTimer=90;
	VariableLightChange(160,0);
	if(!ZankoRageCheck)
		FadeLightChange(160,16);
	Delay(16);

	while(HellTimer >= 1 && ThingCountName("HellBot",0) >= 1) {
		ACS_NamedExecuteWithResult("ub_HellTimerHud",HellTimer);
		Delay(34);
		HellTimer -= 1;
		Delay(1);
	}
	if(HellTimer <= 0){
		ACS_NamedExecuteWithResult("ub_HellTimerHud",HellTimer);
		GiveMeTheFunc("PowerEvilArmor", -998);//Take from HellBots
		SetFont("BIGFONT");
		SetHudSize(480,360,0);
		HudMessageBold(s:"\cgTHIS IS IT... STRIKE NOW!"; HUDMSG_FADEOUT, -167, -1, 240.4, 36.0, 3.0, 2.0);
	}
	while(ThingCountName("HellBot",0) >= 1){
		Delay(10);
	}
	if(ThingCountName("SPOOKYGHOSTHITLER",0) == 0){
		VariableLightChange(255,1);
		if(!ZankoRageCheck){FadeLightChange(255,130);}
	}
}

// Higlur dim-lights while alive (ported from unbound Script 825)
Script "ub_HiglurLight" (void)
{
	SetActivator(0,AAPTR_NULL);
	VariableLightChange(160,0);
	if(!ZankoRageCheck){InstantLightChange(160);}
	while(ThingCountName("SPOOKYGHOSTHITLER",0) >= 1){
		Delay(10);
	}
	if(ThingCountName("HellBot",0) == 0){
		VariableLightChange(255,1);
		if(!ZankoRageCheck){FadeLightChange(255,65);}
	}
}

function bool ZHellAllyCheckFunc (int DeadTID)
{
	for(int i = 0; i < MultiBossCheck; i++)
		if(BossDataArr[i][BOSSDATA_TID] == DeadTID)
			return true;
	return false;
}

Script "uh_ZankokunaRage" (void)//Zankokuna rage
{
	ZankoRageCheck = true;
	debugLog(strParam(s:"This TID used Zankokuna rage: ",d:ActivatorTID()));

	MusicSaveFunc();
	PlayMusic("HELLMUS");
	MusicCredits("EarthBound - The Place",1);

	FadeLightChange(10,245);
	Delay(245);

	Delay(35);
	GiveActorInventory(ActivatorTID(),"InvulnerableOn_Pickup",1);
	int DeadTID = 1000;
	Until (DeadTID == 1064) {
		if (ZHellAllyCheckFunc(DeadTID)) {
			DeadTID = DeadTID;
			//debugLog(strParam(s:"IGNORED ",d:DeadTID);
		}
		else {
			GiveActorInventory(DeadTID,"AntiInvincible_P",1);
			Thing_Damage(DeadTID,6000000,5);
			//debugLog(strParam(s:"Hurt ",d:DeadTID);
		}
		DeadTID++;
	}

	ACS_NamedTerminate("ub_WatchSurvivors",0);
	ACS_NamedTerminate("ub_WatchBossesAndEyes",0);
	Gameover = true;
	PlayMusic_Loss(2);

	MakeAllPlayersInvun();
	FadeLightChange(0,210);

	SetHudSize(480,360,0);
	SetFont("BIGFONT");
	HudMessageBold(s:"And then...\nthere were none..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 3.0,2.0);
	AmbientSound("misc/hugequake",127);
	Radius_Quake(9,70,0,150,ActivatorTID());
	SetPlayerProperty(1,1,4);
	Delay(35*6);
	Exit_Normal(0);
	Delay(35*6);
}

Script "uh_StopZankokunaRage" (int Z)//Stop Zankokuna Rage
{
	Switch(Z)
	{
		Case 0:
			if(ZankoRageCheck){SetResultValue(0);}
			else{SetResultValue(1);}
			break;
		Case 1:
			ZankoRageCheck = false;
			ACS_NamedTerminate("uh_ZankokunaRage", 0);
			PlayMusic(savedMusicLump);
			MusicCredits(savedMusicCredit,1);
			InstantLightChange(LightLevelTrack);
			break;
	}
}

Script "uh_WishingStar" (int Star, int Extra)//Wishing Star
{
Switch(Star)
	{
		Case -1:
			SetResultValue(WishingStarCheck);
			break;
		Case 0:
			WishingStarCheck = true;
			MusicSaveFunc();
			PlayMusic("");
			AmbientSound("items/wishingstar",127);
			Switch(Extra)
			{
				Case 0:
					MusicCredits(MusicalEventIndex[0][1],1);
					PrintBold(n:0, s:" has made a wish!");
				break;
				Case 1:
					MusicCredits(MusicalEventIndex[0][2],1);
					PrintBold(n:0, s:" executed wish\cr.exe\c+!");
				break;
				Case 2:
					MusicCredits(MusicalEventIndex[0][3],1);
					PrintBold(n:0, s:" has made a \cdwish\c+!");
				break;
				Case 66:
					MusicCredits(MusicalEventIndex[0][4],1);
					PrintBold(s:"\c[MenuYellow]Delaying has caused a wish?");
				break;
			}
			break;

		Case 1:
			int StarDeath = 1000;
			Until (StarDeath == 1064) {
				if(StarDeath!=Extra){
					GiveActorInventory(StarDeath,"AntiInvincible_P",1);
					Thing_Damage2(StarDeath,6000000,"WishingStar");
				}
				StarDeath++;
			}
			Radius_Quake(9,70,0,150,Extra);
			AmbientSound("misc/hugequake",127);
			PlayMusic("*");
			MusicCredits("Unknown - Stage Default",1);
			Delay(35*10);
			WishingStarCheck = false;
			MusicCredits(savedMusicCredit,1);
			PlayMusic(savedMusicLump);
			break;
		Case 6://Begin the entire EXE event.
			standardlmseventlocked = true;
			if(random(0,1)){
				PlayMusic(MusicalEventIndex[1][0]);
				MusicCredits(MusicalEventIndex[1][1],1);
			}
			else{
				PlayMusic(MusicalEventIndex[2][0]);
				MusicCredits(MusicalEventIndex[2][1],1);
			}
			Delay(10);
			int RedR = 241;
			int GreenG = 220;
			int BlueB = 220;
			SectorColorChange(RedR,GreenG,BlueB,0);
			GiveMeTheFunc("SonicExeWishingStart_P", 1);
			Delay(35*12);
			PlayMusic(MusicalEventIndex[3][0]);
			MusicCredits(MusicalEventIndex[3][1],1);
			for(int i=0; i<42; i++){
				SectorColorChange(RedR,GreenG,BlueB,0);
				RedR-=2; GreenG-=5; BlueB-=5;
				Delay(10);
			}
			AmbientSound(StrParam(s:"classes/SONICEXE",i:random(1,4)),127);
			Delay(35*4);
			PlayMusic("");
			MusicCredits(MusicalEventIndex[3][2],1);
			AmbientSound("classes/SONICEXE0",127);
			AmbientSound("sonicEXE/Kefka",127);
			int ExeDeath = 1000;
			Until (ExeDeath == 1064) {
				GiveActorInventory(ExeDeath,"AntiInvincible_P",1);
				Thing_Damage2(ExeDeath,6000000,"WishingStar");
				ExeDeath++;
			}
			Delay(35*9);
			for(i=0; i<49; i++){
				RedR+=2; GreenG+=5; BlueB+=5;
				SectorColorChange(RedR,GreenG,BlueB,0);
				Delay(1);
			}
			WishingStarCheck = false;
			MusicCredits(savedMusicCredit,1);
			PlayMusic(savedMusicLump);
			break;
		Case 7://Spec/Death
			LocalAmbientSound(StrParam(s:"classes/SONICEXE",i:random(1,4)),127);
			LocalSetMusic("");
			break;
		Case 66://Wish Cancel
			WishingStarCheck = false;
			AmbientSound("S3_K/Wrong",62);
			PrintBold(s:"Wish failed!");
			MusicCredits(savedMusicCredit,1);
			PlayMusic(savedMusicLump);
			break;
		Case 77:
			AmbientSound("misc/TimeTravel",127);
			for(int TimeT = 0; TimeT < 64; TimeT++){//Revive everyone who is dead
				SetDeadSpectator(TimeT,0);
			}
			Delay(2);
			WishingStarCheck = false;
			ResetMap();
			break;
		Case 165://DINODEATH
			//AmbientSound("misc/hugequake",127);
			PlayMusic(MusicalEventIndex[9][0]);
			MusicCredits(MusicalEventIndex[9][1],0);
			break;
	}
}

// Boss messages and HP scripts
script "uh_BossMorph" (int whoisit, int basehp, int addhp) {
  // Signed boss ids live in UHDT player array; Inventory only holds non-negative.
  SetPlayerBossId(PlayerNumber(), whoisit);
  if (whoisit >= 0 && whoisit <= 6666)
    SetInventory("ThisIsMyMagicBossNumber", whoisit);

  TakeInventory("PowerProtectSurvivor", 1);
  TakeInventory("PowerProtectMegaCopywep", 1);
  TakeInventory("PowerProtectUnholyItem", 1);

  if (multi_boss_check >= 2) {  // && !VersusFightEvent
    GiveInventory("PowerProtectBoss", 1);  // If multi boss, protect them from each other.
  }

  GiveInventory("BAWS", 1);
  GiveInventory("MorphedFlag", 1);

  int ab_scale = CheckInventory("ArmorBonusScale_F");
  if (ab_scale >= 1) {
    GiveInventory("DynamicArmorDosage_F", GetArmorInfo(1));

    if (multi_boss_check >= 1) {
      int armor_bonus = (PlayerCount() - 1) / multi_boss_check;
      str armor_name = StrParam(s:GetBossActor(whoisit), s:"_BasicArmorBonus_P");

      until (armor_bonus <= 0) {
        GiveInventory("DynamicArmorDosage_F", ab_scale);
        GiveInventory(armor_name, 1);
        armor_bonus--;
      }
    }
  }

  NamedExecuteClientScript("UH_RainbowHudMessage", PlayerNumber(), whoisit, versus_fight_event * 24);

  ACS_NamedExecuteAlways("ub_RageDisplay", 0);

  int hud_id = 5;  // ID to display the text //-10000
  int hud_offset_y = 4;  // Text Y offset, 384 + Y * 32
  // Sets up boss player name spacing and Face spacing. IE X has been selected to be Y.
  if (CheckInventory("Is_UH_BossNum") == 1) {
    hud_id = 1;  // -10001
    if (multi_boss_check == 4) {hud_offset_y = 0;}
    else if (multi_boss_check == 3) {hud_offset_y = 1;}
    else if (multi_boss_check == 2) {hud_offset_y = 2;}
    else if (multi_boss_check == 1) {hud_offset_y = 2;}
  }
  else if (CheckInventory("Is_UH_BossNum") == 2) {
    hud_id = 2;  // -10002
    if (multi_boss_check == 4) {hud_offset_y = 1;}
    else if (multi_boss_check == 3) {hud_offset_y = 2;}
    else if (multi_boss_check == 2) {hud_offset_y = 3;}
  }
  else if (CheckInventory("Is_UH_BossNum") == 3) {
    hud_id = 3;  // -10003
    if (multi_boss_check == 4) {hud_offset_y = 2;}
    else if (multi_boss_check == 3) {hud_offset_y = 3;}
  }
  else if (CheckInventory("Is_UH_BossNum") == 4) {
    hud_id = 4;  // -10004
    hud_offset_y = 3;
  }
  hud_offset_y *= 32.0;  // 24.0

  str b_name_str = GetBossName(whoisit);  // 'Boss' name
  int b_chr0 = GetChar(GetBossSpawnMsgType(whoisit), 0);  // Message style
  int b_chr1 = GetChar(GetBossSpawnMsgType(whoisit), 1);  // Color
  int b_chr2 = GetChar(GetBossSpawnMsgType(whoisit), 2);  // Punctuation...?!
  str b_mess_str = GetBossSpawnMsg(whoisit);  // 'Custom' Message

  // Defaults if nothing defined
  if (b_chr1 == 0)
    b_chr1 = 'k';
  if (b_chr2 == 0)
    b_chr2 = '!';
  // s:"\c",c:B_Chr1,

  str spawn_str;  // = StrParam(n:0, s:" \ckhas been selected to be ", s:B_NameStr, s:"\ck.");
  // Bonus things
  switch (b_chr0) {
    default:
      if (RandomPercent(95))
        b_chr0 = -1;
      break;
    case 65:
    case 66:
    case 67:
    case 69:
    case 70:
    case 81:
      if (RandomPercent(10))
        b_chr0 = -1;
      break;
  }

  // Bonus things
  switch (b_chr0) {
    default:  // ~=Player 'Has been selected to be' Boss
      spawn_str = StrParam(n:0, s:" \ckhas been selected to be ", s:b_name_str, s:"\ck!");
      break;
    case 65:  // A=Player 'Custom'
      spawn_str = StrParam(n:0, s:" ", s:b_mess_str);
      break;
    case 66:  // B=Player 'Custom' Boss
      spawn_str = StrParam(n:0, s:" \c", c:b_chr1, s:b_mess_str, s:" ", s:b_name_str, s:"\c", c:b_chr1, c:b_chr2);
      break;
    case 67:  // C=(Player) Boss 'Custom'
      spawn_str = StrParam(s:"\c", c:b_chr1, s:"(", n:0, s:"\c", c:b_chr1, s:") ", s:b_name_str, s:" \c", c:b_chr1, s:b_mess_str, c:b_chr2);
      break;
    case 69:  // E='Custom' Boss (Player)
      spawn_str = StrParam(s:"\c", c:b_chr1, s:b_mess_str, s:" ", s:b_name_str, s:"\c", c:b_chr1, c:b_chr2, s:" (", n:0, s:"\c", c:b_chr1, s:")");
      break;
    case 70:  // F='Custom' (Player)
      spawn_str = StrParam(s:b_mess_str, s:" \cj(", n:0, s:"\cj)");
      break;
    case 81:  // Q='Custom'
      spawn_str = StrParam(s:b_mess_str);
      break;

    case -1:  // Loads of messages
      switch (random(0, 39)) {
        // Case -1:spawnStr = StrParam(s:"\ckRCON made ", n:0, s:" \ckbe ", s:B_NameStr, s:"\ck!");break;
        case 0: spawn_str = StrParam(n:0, s:" \ckhas been selected to be ", s:b_name_str, s:"\ck."); break;
        case 1: spawn_str = StrParam(n:0, s:"\ck is unfortunate enough to be ", s:b_name_str, s:"\ck."); break;
        case 2: spawn_str = StrParam(n:0, s:"\ck was cursed to be ", s:b_name_str, s:"\ck."); break;
        case 3: spawn_str = StrParam(n:0, s:"\ck was doomed to be ", s:b_name_str, s:"\ck."); break;
        case 4: spawn_str = StrParam(n:0, s:"\ck was destined to be ", s:b_name_str, s:"\ck."); break;
        case 5: spawn_str = StrParam(n:0, s:"\ck was replaced with ", s:b_name_str, s:"\ck."); break;
        case 6: spawn_str = StrParam(n:0, s:"\ck was bribed to be ", s:b_name_str, s:"\ck."); break;
        case 7: spawn_str = StrParam(n:0, s:"\ck didn't ask to be ", s:b_name_str, s:"\ck."); break;  // but is forced to.
        case 8: spawn_str = StrParam(s:"\ckThe RNG gods made ", n:0, s:"\ck be ", s:b_name_str, s:"\ck!"); break;
        case 9: spawn_str = StrParam(n:0, s:"\ck unlocked ", s:b_name_str, s:"\ck!"); break;  // applied for a job and ended up as .
        case 10: spawn_str = StrParam(n:0, s:"\ck got a new job as ", s:b_name_str, s:"\ck."); break;  // wanted a job, became ... instead
        case 11: spawn_str = StrParam(n:0, s:"\ck is now ", s:b_name_str, s:"\ck!"); break;
        case 12: spawn_str = StrParam(n:0, s:"\ck drew the short straw to be ", s:b_name_str, s:"\ck."); break;  // is now ... unwillingly
        case 13: spawn_str = StrParam(s:"\ckThe Dice made ", n:0, s:"\ck -> ", s:b_name_str); break;
        case 14: spawn_str = StrParam(n:0, s:"\ck critical rolled into ", s:b_name_str, s:"\ck!"); break;  // rolled the dice, became
        case 15: spawn_str = StrParam(n:0, s:"\ck playerclasses into ", s:b_name_str, s:"\ck."); break;
        case 16: spawn_str = StrParam(n:0, s:"\ck has evolved into ", s:b_name_str, s:"\ck."); break;
        case 17: spawn_str = StrParam(n:0, s:"\ck counterpicks into ", s:b_name_str, s:"\ck."); break;
        case 18: spawn_str = StrParam(n:0, s:"\ck reincarnated as ", s:b_name_str, s:"\ck."); break;
        case 19: spawn_str = StrParam(n:0, s:"\ck ranked up into ", s:b_name_str, s:"\ck."); break;
        case 20: spawn_str = StrParam(n:0, s:"\ck spectated. ", s:b_name_str, s:"\ck joined the game."); break;  // 's loaded dice let them be !
        case 21: spawn_str = StrParam(n:0, s:"\ck was sacrificed to summon ", s:b_name_str, s:"\ck!"); break;
        case 22: spawn_str = StrParam(n:0, s:"\ck is dead. Long live ", s:b_name_str, s:"\ck!"); break;
        case 23: spawn_str = StrParam(n:0, s:"\ck digievolved into ", s:b_name_str, s:"\ck!"); break;
        case 24: spawn_str = StrParam(s:"\ckWatch out for ", s:b_name_str, s:"\ck! (", n:0, s:"\ck)"); break;
        case 25: spawn_str = StrParam(n:0, s:"\ck got equipped with: ", s:b_name_str); break;
        case 26: spawn_str = StrParam(s:"\ckYou tracked down ", s:b_name_str, s:"\ck! (", n:0, s:"\ck)"); break;
        case 27: spawn_str = StrParam(n:0, s:"\ck is ", s:b_name_str, s:"\ck. Go wild."); break;
        case 28: spawn_str = StrParam(s:b_name_str, s:"\ck's ghost possessed ", n:0, s:"\ck!"); break;
        case 29: spawn_str = StrParam(n:0, s:"\ck found the ", s:b_name_str, s:"\ck button!"); break;
        case 30: spawn_str = StrParam(n:0, s:"\ck bribed the game to be ", s:b_name_str, s:"\ck!"); break;
        case 31: spawn_str = StrParam(s:b_name_str, s:"\ck was ", n:0, s:"\ck all along!"); break;
        case 32: spawn_str = StrParam(s:"\ckEncountered a wild ", s:b_name_str, s:"\ck! (", n:0, s:"\ck)"); break;
        case 33: spawn_str = StrParam(n:0, s:"\ck you're fired. ", s:b_name_str, s:"\ck, promotion."); break;
        case 34: spawn_str = StrParam(n:0, s:"\ck? Never heard of 'em. ~", s:b_name_str); break;
        case 35: spawn_str = StrParam(s:"\ckNo ", n:0, s:"\ck? Isn't that a shame, ", s:b_name_str, s:"\ck."); break;
        case 36: spawn_str = StrParam(s:b_name_str, s:"\ck found ", n:0, s:"\ck's nuke codes!!"); break;
        case 37: spawn_str = StrParam(s:"\ck(", n:0, s:"\ck) ", s:b_name_str, s:"\ck's location was found!"); break;
        case 38: spawn_str = StrParam(n:0, s:"\ck purchased the ", s:b_name_str, s:"\ck DLC!"); break;
        case 39: spawn_str = StrParam(n:0, s:"\ck won the lottery to become ", s:b_name_str, s:"\ck!"); break;
      }
      break;
  }

  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  HudMessageBold(s:spawn_str; HUDMSG_FADEOUT | HUDMSG_LOG, 50 + hud_id, 10, 320.4, 352.2 + hud_offset_y, 1.8, 0.2);  // 384

  str spawn_actor = GetBossActor(whoisit);
  if (StrICmp(spawn_actor, "TrueBusterMistress") == 0) {
    if (!CheckInventory("IsGonnaBeFake")) {
      if (multi_boss_check)
        GiveInventory("MistressCopyVisedBoxItem", (PlayerCount() + 1) / multi_boss_check);
      else
        GiveInventory("MistressCopyVisedBoxItem", 3);
    }
  }
  else if (StrICmp(spawn_actor, "HellBot") == 0) {
    ACS_NamedExecute("ub_HellTimerMonitor", 0);
  }
  else if (StrICmp(spawn_actor, "SirAlpha") == 0 || StrICmp(spawn_actor, "SirAlphaEX") == 0) {
    if (!CheckInventory("IsGonnaBeFake") && multi_boss_check == 1) {
      standardlmseventlocked = true;  // Old-Styled Fighting.
    }
  }
  else if (StrICmp(spawn_actor, "Rogue") == 0) {
    if (!CheckInventory("IsGonnaBeFake") && multi_boss_check == 1) {
      standardlmseventlocked = true;
    }
  }
  else if (StrICmp(spawn_actor, "FoxDemoneye300") == 0) {
    GiveInventory("ProsperityRune_ST", 1);
    standardlmseventlocked = true;
  }
  else if (StrICmp(spawn_actor, "FinalSampi") == 0) {
    if (!CheckInventory("IsGonnaBeFake") && multi_boss_check == 1) {
      standardlmseventlocked = true;
    }
  }
  else if (StrICmp(spawn_actor, "SPOOKYGHOSTHITLER") == 0) {
    ACS_NamedExecute("ub_HiglurLight", 0);
    if (!CheckInventory("IsGonnaBeFake") && multi_boss_check == 1) {
      standardlmseventlocked = true;
    }
  }

  // multiBossCheck
  // This changes the health of the boss based on players and multibosses
  int main_health = basehp;
  if (multi_boss_check) {
    main_health = min(basehp + (PlayerCount() * addhp / multi_boss_check) - addhp / multi_boss_check, MAX_HEALTH);
    // if(Debug_TXT) {Print(d:AddHP/multiBossCheck);}
    SetActorProperty(0, APROP_HEALTH, main_health);
    SetActorProperty(0, APROP_SPAWNHEALTH, main_health);
  }
  // GiveActorInventory
  SetInventory("BossSpawnHealthFlag", main_health);
  Delay(1);
}

// Recalculate a later phase's health without running the full morph setup a
// second time.  uh_BossMorph also announces the boss, grants protection, and
// starts its HUD watcher; a phase transition only needs the health values and
// the inventory value used by the boss HUD.
script "uh_BossPhaseHealth" (int basehp, int addhp) {
  int main_health = basehp;
  if (multi_boss_check > 0) {
    main_health = min(basehp + (PlayerCount() * addhp / multi_boss_check) - addhp / multi_boss_check, MAX_HEALTH);
  }
  // Keep the phase transition valid even if a malformed/forced setup leaves
  // multiBossCheck at zero.  The old conditional skipped both properties,
  // leaving the actor at the trigger value of 1 HP and immediately arming
  // the next phase.
  SetActorProperty(0, APROP_HEALTH, main_health);
  SetActorProperty(0, APROP_SPAWNHEALTH, main_health);
  SetInventory("BossSpawnHealthFlag", main_health);
}


// Demoneyes + other morphes
script "uh_DemoneyeMorph" (int whoisit, int bonus) {
  PlayerLifeStatusArrUpdateFunc(PlayerNumber(), PLS_EYE);

  int eye_id = whoisit + bonus * 100;
  SetPlayerEyeId(PlayerNumber(), eye_id);
  SetInventory("ThisIsMyMagicEyeNumber", eye_id);  // Used for Menu Help/MugShot

  TakeInventory("PowerProtectSurvivor", 1);
  TakeInventory("PowerProtectMegaCopywep", 1);
  TakeInventory("PowerProtectUnholyItem", 1);

  GiveInventory("BAWS", 1);
  GiveInventory("MorphedFlag", 1);
  GiveInventory("IsAnEye", 1);

  // MorphProjectile copies survivor inventory — strip weapons + class-color flags
  // (DecoyBot IsDecoyBotFlag / DecoyBot_W* otherwise keep auto-color after eye Ready).
  GiveInventory("RemoveWeaponsOfMortals_P", 1);
  TakeInventory("IsDecoyBotFlag", 1);
  TakeInventory("IsDecoyBotSFlag", 1);
  TakeInventory("IsNegaManFlag", 1);
  TakeInventory("IsNegaManSFlag", 1);
  TakeInventory("IsQwantSFlag", 1);
  TakeInventory("MegaManSColor_F", 1);
  GiveInventory("NoProjectileTeamTranslation", 1);

  // PowerMorph has no ACS MorphActor hook — one-time flag sweep + post pipeline.
  if (!CheckInventory("UH_MorphPipelineDone_F")) {
    GiveInventory("UH_MorphFlagReset_P", 1);
    GiveInventory("Core_MorphFlagReset_P", 1);
    GiveInventory("Core_MorphFlagReset2_P", 1);
  }
  ACS_NamedExecuteWithResult("uh_MorphPostReset", 0);

  if (bonus && multi_boss_check >= 2) {  // && !VersusFightEvent
    GiveInventory("PowerProtectBoss", 1);  // If multi boss, protect them from each other.
  }

  SetFont("SMALLFONT");
  ClearHudMessage(66);
  SetHudSize(384, 288, 0);

  str eyename = GetEyeYouAreNowName(whoisit);
  if (StrCmp(eyename, "") == 0)
    eyename = StrParam(s:"\ckDemoneye #", i:whoisit);
  HudMessage(s:"\ckYou are now ", s:eyename, s:"!"; HUDMSG_FADEOUT, -6001, -1, 192.4, 24.0, 3.0, 2.0);

  if (!IsDemoneyeEvent()) {
    SetFont("BIGFONT");
    SetHudSize(640, 480, 0);
    str paidname = GetEyeYouAreNowName(whoisit);
    if (StrCmp(paidname, "") == 0)
      paidname = StrParam(s:"\ckDemoneye #", i:whoisit);
    HudMessageBold(n:0, s:" \ckwas paid to become ", s:paidname, s:"\c-!"; HUDMSG_FADEOUT | HUDMSG_LOG, 49, CR_YELLOW, 320.4, 464.2, 1.8, 0.2);
  }
}

// HellBot Script
script "ub_HellTimerMonitor" (void) {
  SetActivator(0, AAPTR_NULL);
  hell_timer = 10 + (PlayerCount() * 4);
  if (hell_timer >= 90)
    hell_timer = 90;
  VariableLightChange(160, 0);
  if (!zanko_rage_check)
    FadeLightChange(160, 16);
  Delay(16);

  while (hell_timer >= 1 && ThingCountName("HellBot", 0) >= 1) {
    ACS_NamedExecuteWithResult("ub_HellTimerHud", hell_timer);
    Delay(34);
    hell_timer -= 1;
    Delay(1);
  }
  if (hell_timer <= 0) {
    ACS_NamedExecuteWithResult("ub_HellTimerHud", hell_timer);
    GiveMeTheFunc("PowerEvilArmor", -998);  // Take from HellBots
    SetFont("BIGFONT");
    SetHudSize(480, 360, 0);
    HudMessageBold(s:"\cgTHIS IS IT... STRIKE NOW!"; HUDMSG_FADEOUT, -167, -1, 240.4, 36.0, 3.0, 2.0);
  }
  while (ThingCountName("HellBot", 0) >= 1) {
    Delay(10);
  }
  if (ThingCountName("SPOOKYGHOSTHITLER", 0) == 0) {
    VariableLightChange(255, 1);
    if (!zanko_rage_check) {FadeLightChange(255, 130);}
  }
}

// Higlur dim-lights while alive (ported from unbound Script 825)
script "ub_HiglurLight" (void) {
  SetActivator(0, AAPTR_NULL);
  VariableLightChange(160, 0);
  if (!zanko_rage_check) {InstantLightChange(160);}
  while (ThingCountName("SPOOKYGHOSTHITLER", 0) >= 1) {
    Delay(10);
  }
  if (ThingCountName("HellBot", 0) == 0) {
    VariableLightChange(255, 1);
    if (!zanko_rage_check) {FadeLightChange(255, 65);}
  }
}

function bool ZHellAllyCheckFunc(int dead_tid) {
  for (int i = 0; i < multi_boss_check; i++)
    if (boss_data_arr[i][BOSSDATA_TID] == dead_tid)
      return true;
  return false;
}

script "uh_ZankokunaRage" (void) {
  zanko_rage_check = true;
  DebugLog(strParam(s:"This TID used Zankokuna rage: ", d:ActivatorTID()));

  MusicSaveFunc();
  PlayMusic("HELLMUS");
  MusicCredits("EarthBound - The Place", 1);

  FadeLightChange(10, 245);
  Delay(245);

  Delay(35);
  GiveActorInventory(ActivatorTID(), "InvulnerableOn_Pickup", 1);
  int dead_tid = 1000;
  until (dead_tid == 1064) {
    if (ZHellAllyCheckFunc(dead_tid)) {
      dead_tid = dead_tid;
      // debugLog(strParam(s:"IGNORED ",d:DeadTID);
    }
    else {
      GiveActorInventory(dead_tid, "AntiInvincible_P", 1);
      Thing_Damage(dead_tid, 6000000, 5);
      // debugLog(strParam(s:"Hurt ",d:DeadTID);
    }
    dead_tid++;
  }

  ACS_NamedTerminate("ub_WatchSurvivors", 0);
  ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
  gameover = true;
  PlayMusicLoss(2);

  MakeAllPlayersInvun();
  FadeLightChange(0, 210);

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:"And then...\nthere were none..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 3.0, 2.0);
  AmbientSound("misc/hugequake", 127);
  Radius_Quake(9, 70, 0, 150, ActivatorTID());
  SetPlayerProperty(1, 1, 4);
  Delay(35 * 6);
  Exit_Normal(0);
  Delay(35 * 6);
}

script "uh_StopZankokunaRage" (int z) {
  switch (z) {
    case 0:
      if (zanko_rage_check) {SetResultValue(0);}
      else {SetResultValue(1);}
      break;
    case 1:
      zanko_rage_check = false;
      ACS_NamedTerminate("uh_ZankokunaRage", 0);
      PlayMusic(saved_music_lump);
      MusicCredits(saved_music_credit, 1);
      InstantLightChange(light_level_track);
      break;
  }
}

script "uh_WishingStar" (int star, int extra) {
  switch (star) {
    case -1:
      SetResultValue(wishing_star_check);
      break;
    case 0:
      wishing_star_check = true;
      MusicSaveFunc();
      PlayMusic("");
      AmbientSound("items/wishingstar", 127);
      switch (extra) {
        case 0:
          MusicCredits(musical_event_index[0][1], 1);
          PrintBold(n:0, s:" has made a wish!");
          break;
        case 1:
          MusicCredits(musical_event_index[0][2], 1);
          PrintBold(n:0, s:" executed wish\cr.exe\c+!");
          break;
        case 2:
          MusicCredits(musical_event_index[0][3], 1);
          PrintBold(n:0, s:" has made a \cdwish\c+!");
          break;
        case 66:
          MusicCredits(musical_event_index[0][4], 1);
          PrintBold(s:"\c[MenuYellow]Delaying has caused a wish?");
          break;
      }
      break;

    case 1:
      int star_death = 1000;
      until (star_death == 1064) {
        if (star_death != extra) {
          GiveActorInventory(star_death, "AntiInvincible_P", 1);
          Thing_Damage2(star_death, 6000000, "WishingStar");
        }
        star_death++;
      }
      Radius_Quake(9, 70, 0, 150, extra);
      AmbientSound("misc/hugequake", 127);
      PlayMusic("*");
      MusicCredits("Unknown - Stage Default", 1);
      Delay(35 * 10);
      wishing_star_check = false;
      MusicCredits(saved_music_credit, 1);
      PlayMusic(saved_music_lump);
      break;
    case 6:  // Begin the entire EXE event.
      standardlmseventlocked = true;
      if (random(0, 1)) {
        PlayMusic(musical_event_index[1][0]);
        MusicCredits(musical_event_index[1][1], 1);
      }
      else {
        PlayMusic(musical_event_index[2][0]);
        MusicCredits(musical_event_index[2][1], 1);
      }
      Delay(10);
      int red_r = 241;
      int green_g = 220;
      int blue_b2 = 220;
      SectorColorChange(red_r, green_g, blue_b2, 0);
      GiveMeTheFunc("SonicExeWishingStart_P", 1);
      Delay(35 * 12);
      PlayMusic(musical_event_index[3][0]);
      MusicCredits(musical_event_index[3][1], 1);
      for (int i = 0; i < 42; i++) {
        SectorColorChange(red_r, green_g, blue_b2, 0);
        red_r -= 2; green_g -= 5; blue_b2 -= 5;
        Delay(10);
      }
      AmbientSound(StrParam(s:"classes/SONICEXE", i:random(1, 4)), 127);
      Delay(35 * 4);
      PlayMusic("");
      MusicCredits(musical_event_index[3][2], 1);
      AmbientSound("classes/SONICEXE0", 127);
      AmbientSound("sonicEXE/Kefka", 127);
      int exe_death = 1000;
      until (exe_death == 1064) {
        GiveActorInventory(exe_death, "AntiInvincible_P", 1);
        Thing_Damage2(exe_death, 6000000, "WishingStar");
        exe_death++;
      }
      Delay(35 * 9);
      for (i = 0; i < 49; i++) {
        red_r += 2; green_g += 5; blue_b2 += 5;
        SectorColorChange(red_r, green_g, blue_b2, 0);
        Delay(1);
      }
      wishing_star_check = false;
      MusicCredits(saved_music_credit, 1);
      PlayMusic(saved_music_lump);
      break;
    case 7:  // Spec/Death
      LocalAmbientSound(StrParam(s:"classes/SONICEXE", i:random(1, 4)), 127);
      LocalSetMusic("");
      break;
    case 66:  // Wish Cancel
      wishing_star_check = false;
      AmbientSound("S3_K/Wrong", 62);
      PrintBold(s:"Wish failed!");
      MusicCredits(saved_music_credit, 1);
      PlayMusic(saved_music_lump);
      break;
    case 77:
      AmbientSound("misc/TimeTravel", 127);
      for (int time_t = 0; time_t < 64; time_t++) {  // Revive everyone who is dead
        SetDeadSpectator(time_t, 0);
      }
      Delay(2);
      wishing_star_check = false;
      ResetMap();
      break;
    case 165:  // DINODEATH
      // AmbientSound("misc/hugequake",127);
      PlayMusic(musical_event_index[9][0]);
      MusicCredits(musical_event_index[9][1], 0);
      break;
  }
}

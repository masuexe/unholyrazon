// Set up getters and setters for Unholy's internal systems to allow external access.
// player < 0 means use PlayerNumber() of the current activator (pass -1 from DECORATE).

// Server gameplay must use retained round roles, not the client display cache.
script "uh_AreGameplayTeammates" (int owner, int victim) {
  if (isbonuseventactive && IsFFAEvent(eventdataarr[EVENTDATA_MAINEVENT])) {
    SetResultValue(false);
    terminate;
  }
  SetResultValue(UH_Ti_ServerAreDisplayTeammates(owner, victim));
}

script "uh_GetPlayerLifeStatus" (int player) {
  if (player < 0)
    player = PlayerNumber();
  if (player < 0) {
    SetResultValue(-1);
    terminate;
  }
  SetResultValue(playerlifestatusarr[player]);
}
script "uh_SetPlayerLifeStatus" (int player, int status) {
  if (player < 0)
    player = PlayerNumber();
  if (player < 0)
    terminate;
  playerlifestatusarr[player] = status;
  if (status == PLS_NULL) {uhsrvrole[player] = PLS_NULL;}
  else if (status != PLS_DEAD) {uhsrvrole[player] = status;}
  // External setter: keep the client display snapshot in step.
  UH_TeamInfo_BroadcastStatus(player, status);
}

script "uh_GetGameOverState" (void) {
  SetResultValue(gameover);
}
script "uh_SetGameOverState" (int state) {
  gameover = state;
  UH_RefreshPostRoundFF();
}

script "uh_GiveEveryoneInventoryExceptBossesACS" (int invitem, int amount) {
  GiveMeTheFuncExceptBosses(invitem, amount);
}

// Single cross-ACS setter for the round-level survivor start item.  ACS script
// parameters are int-typed, but ACS_NamedExecuteWithResult passes string
// literals through them, so callers pass "" or an item actor name.
script "uh_SetSurvivorStartItem" (int item, int tid) {
  if (multibosscheck == 1 && !shadowtricksarr[0] && !CheckActorInventory(tid, "IsGonnaBeFake"))
    survivorstartitem = item;
}

// --- Bonus event runtime API (server-authoritative state) --------------------
// Used through the UHADD wrappers (UH_IsActiveBonusEvent etc.).  Behaviour
// callbacks run only on the server; pure clients have no live eventdataarr.

script "uh_IsActiveBonusEvent" (int eventid) {
  SetResultValue(isbonuseventactive && !bonuseventended &&
                 eventid == eventdataarr[EVENTDATA_MAINEVENT]);
}

script "uh_GetActiveBonusEvent" (void) {
  if (!isbonuseventactive || bonuseventended) {
    SetResultValue(UHBE_FAIL);
    terminate;
  }
  SetResultValue(eventdataarr[EVENTDATA_MAINEVENT]);
}

// UHDBCRUD asks before tombstoning a boss. Include every registered combo
// member (drafts too), and the current round's resolved/dynamic line-up.
script "uh_IsBossRegistryReferenced" (int id) {
  int i;
  for (int combo = 0; combo < UH_ComboCount(); combo++) {
    for (i = 0; i < UH_ComboInt(combo, UHC_INT_MEMBERS); i++) {
      if (UH_ComboMemberId(combo, i) == id) {
        SetResultValue(1);
        terminate;
      }
    }
  }
  for (i = 0; i < multibosscheck; i++) {
    if (bossdataarr[i][BOSSDATA_NUM] == id) {
      SetResultValue(1);
      terminate;
    }
  }
  SetResultValue(0);
}

script "uh_StartStandardBonusWatcher" (int eventid) {
  SetResultValue(UH_StartStdBonusWatcherCore(eventid));
}

script "uh_EndBonusEvent" (int eventid, int result) {
  SetResultValue(UH_EndBonusEventCore(eventid, result));
}

// One-vs-all target accessors for UHBE_FLAG_ONEVSALL events.  The core seeds
// the target from normal boss selection; events may reassign it at start.
script "uh_SetBonusEventTarget" (int eventid, int tid) {
  if (!isbonuseventactive || bonuseventended ||
      eventid != eventdataarr[EVENTDATA_MAINEVENT] ||
      (GetBonusEventFlags(eventid) & UHBE_FLAG_ONEVSALL) == 0 ||
      tid < 1000 || tid > 1063) {
    SetResultValue(false);
    terminate;
  }
  bossdataarr[0][BOSSDATA_TID] = tid;
  // Re-freeze the display target for every client (the 1-vs-all split keys on
  // this player number, never on the target's morphable life status).
  UH_TeamInfo_BroadcastOneVsAll();
  SetResultValue(true);
}

script "uh_GetBonusEventTarget" (int eventid) {
  if (!isbonuseventactive ||
      eventid != eventdataarr[EVENTDATA_MAINEVENT] ||
      (GetBonusEventFlags(eventid) & UHBE_FLAG_ONEVSALL) == 0) {
    SetResultValue(UHBE_FAIL);
    terminate;
  }
  SetResultValue(bossdataarr[0][BOSSDATA_TID]);
}

// Set up getters and setters for Unholy's internal systems to allow external access.
// player < 0 means use PlayerNumber() of the current activator (pass -1 from DECORATE).

script "uh_GetPlayerLifeStatus" (int player) {
  if (player < 0)
    player = PlayerNumber();
  if (player < 0) {
    SetResultValue(-1);
    terminate;
  }
  SetResultValue(playerlifestatusarr[player]);
}
script "uh_SetPlayerLifeStatus" (int player, int status) {
  if (player < 0)
    player = PlayerNumber();
  if (player < 0)
    terminate;
  playerlifestatusarr[player] = status;
}

script "uh_GetGameOverState" (void) {
  SetResultValue(gameover);
}
script "uh_SetGameOverState" (int state) {
  gameover = state;
}

script "uh_GiveEveryoneInventoryExceptBossesACS" (int invitem, int amount) {
  GiveMeTheFuncExceptBosses(invitem, amount);
}

// Single cross-ACS setter for the round-level survivor start item.  ACS script
// parameters are int-typed, but ACS_NamedExecuteWithResult passes string
// literals through them, so callers pass "" or an item actor name.
script "uh_SetSurvivorStartItem" (int item, int tid) {
  if (multibosscheck == 1 && !shadowtricksarr[0] && !CheckActorInventory(tid, "IsGonnaBeFake"))
    survivorstartitem = item;
}

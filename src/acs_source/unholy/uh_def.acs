{"Magnetismo","\chMagnetismo","M_UB020","X-Men: Children of the Atom - Magneto's Theme","\ckYour primary fires a cluster of magnet bombs.\n\cnYour item creates a magnetic pulse that shoots metal chunks around you!\n\cdYour alt fires a single short range homing magnet bomb!\n\cgRage for Magnet Pull!","",""},
{"ShinNegaman","\cmShin \ctNegaman","M_UB021","Street Fighter Alpha 3 - Cody's Theme/Stripes","\cdUse alt to kick people right in the balls!\n\cnUse your item for a random nega weapon...\n\ckOr you could be a real pro and pew-pew away at enemies with your primary...","",""},
{"GemBanker","\cvGem Banker","M_UB022","Sonic Mania - Mean Bean Machine","\ckYour primary shoots an assortment of colored crystals for purchase.\n\cdAlt for \cgrage\cd: \cvBank Breaker\cd!","",""},
{"Dixieandoff","\cfDixieandoff","M_UB023","Fire Emblem - Strike","\ckYour primary fires a bouncy metal ball that sits and then returns!\n\cdYour alt lets you use your mace to leap and create a shockwave on landing.\n\cjRage: \cgCRITICAL STRIKE!","",""},
{"GENERICBOSS","\cgTHE GENERIC BOSS","M_UB024 5","Mighty Final Fight - Troublesome Opponent (Boss BGM)","\ckUse your mainfire to punch people!\n\cnUse your item to superjump!\n\cdAlt for rage: \cgSUPER DEFENSE BOOST!!","",""},
{"TrueBusterMistress","\cmTrue \cqBuster Mistress","M_UB025","Fatal Fury 3 - C62 Shirokuni (Ryuji Yamazaki 2 Theme)","\ckUse your primary to fire a Holographic Shot!\n\cdUse your alt for a Tri-Holographic Shot.\n\cnUse your item to summon a Clone Upper!\n\ciYou also have several clone Pandora Box items.","",""},
{"CuttyCut","\caCutty Cut","M_UB026 104","Pokemon Crystal Complete - Battle! Wild Pokémon (Naljo)","\ckFire to throw your totally reliable cutter!\n\cdAltfire to slice, sorta..!\n\cjGet \cgmad\cj on each KO!","Ck.","enters the ring"},
{"Pharaohman4MI","\ckPharaohman","M_UB027","Final Fight - Andore Cage Fight (Sped-up)","\ckUse your primary for Pharaoh Shotgun!\n\cdUse your alt for Pharaoh Wave!\n\cjDon't worry, your \cgtrue power\cj will be realized soon...","",""},
{"Skullman4MI","\cjSkullman","M_UB027","Final Fight - Andore Cage Fight (Sped-up)","\ckUse your primary for Skull Buster!\n\cdUse your alt for Hell Wheel!\n\cjDon't worry, your \cgtrue power\cj will be realized soon...","",""},
{"AstromancerComplex","\ctAstromancer Crasher","M_UB029","Ristar - Battle Theme - Crazy Kings","\ckUse your primary for lovely homing Star Crash!\n\cdUse alt for Star Rain!\n\cgRage for Pinpoint Meteor Attack!","",""},
//30
{"AstromancerSimple","\ctAstromancer Crusher","M_UB029","Ristar - Battle Theme - Crazy Kings","\ckUse your primary for lovely fast Star Crush!\n\cdAlt for Star Dash!\n\cgRage for Pinpoint Meteor Attack!","",""},
{"JuggerbroGold","\cfJuggerbro Gold","M_UB031","Final Fantasy USA: Mystic Quest - Boss Theme","\ckUse your primary to fire Golden Screws!\n\cdAlt turns yourself into a bouncing projectile!\n\cjYou have great power but not speed!","",""},
{"JuggerbroSilver","\cuJuggerbro Silver","M_UB031","Final Fantasy USA: Mystic Quest - Boss Theme","\ckUse your primary to fire splitting Silver Screws!\n\cdAlt turns yourself into a ramming projectile!\n\cjYou are faster but not as powerful!","",""},
{"RedBaronDuo","\crRed Baron","M_UB033","Contra III: The Alien Wars - Ground Zero","\crDo you see \chBlue Jay\cr? \cgDESTROY HIM!\n\cdTry your altfire for deadly missiles.\n\cjIf you don't see \chBlue Jay\cj, \cgDESTROY EVERYONE\cj!","",""},
{"BlueJayDuo","\chBlue Jay","M_UB033","Contra III: The Alien Wars - Ground Zero","\chDo you see \crRed Baron? \cnDESTROY HIM!\n\cdTry your altfire for blasting missiles.\n\cjIf you don't see \crRed Baron\cj, \cgDESTROY EVERYONE\cj!","",""},
{"RedTankBot","\cgRed TankBoi","M_UB035","Final Fight One GBA - Rolento's Theme (Sped-up)","Defeat all the other players!\nYou have the \cgpower\cj!\n\cdAlt to bounce forward!","",""},
{"BluTankBot","\chBlue TankBoi","M_UB035","Final Fight One GBA - Rolento's Theme (Sped-up)","Defeat all the other players!\nYou have the \chresistance\cj!\n\cdAlt to bounce around!","",""},
{"YelTankBot","\ckYellow TankBoi","M_UB035","Final Fight One GBA - Rolento's Theme (Sped-up)","Defeat all the other players!\nYou have the \ckspeed\cj!\n\cdAlt to bounce upward!","",""},
{"RedHero","\cgRed Anti-Unholy Elite","M_UB038X","FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)","Defeat all the other players!\n\ciYou have high power!","",""},
{"BlueHero","\chBlue Anti-Unholy Elite","M_UB038X","FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)","Defeat all the other players!\n\ciYou have balanced strengths!","",""},

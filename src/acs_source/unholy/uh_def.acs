// Scoreboard portrait-visibility policy, synchronized from the server.  The
// client cache starts at UH_SCOREPOLICY_INVALID so the scoreboard exposes only
// self until the authoritative snapshot arrives; an active bonus event whose
// flags are ambiguous (none or more than one policy flag) is also INVALID
// rather than a permissive default.  See UH_CanSeeScoreIcon.
#define UH_SCOREPOLICY_INVALID -1
#define UH_SCOREPOLICY_NORMAL 0
#define UH_SCOREPOLICY_FFA 1
#define UH_SCOREPOLICY_ONEVSALL 2
#define UH_SCOREPOLICY_ALL_EYE 3
#define UH_SCOREPOLICY_MULTITEAM 4

int totalplayersarr[7];  // Array spots; 0 = dead, 1 = survivor, 2 = boss, 6 = demoneye
int playerlifestatusarr[MAX_PLAYERS + 1] = {-1};  // -1 = null, 0 = dead, 1 = alive, 2 = boss, 6 = eye

// Server-side role cache retained across PLS_DEAD, mirroring the client's
// uhTiRole.  The per-viewer teammate-stat snapshot authorizes dead rows from
// this, because playerlifestatusarr itself drops the role on death.
int uhsrvrole[MAX_PLAYERS];


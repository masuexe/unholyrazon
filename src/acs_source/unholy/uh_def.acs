// Boss fair-selection history (Razon3-style least-seen first).  Server-session
// scope: world arrays survive map changes and reset when the server restarts,
// where the zero default already means "never picked".  Slots 120/121 are free:
// the mod's highest world variable is 104:lmsdudearr and the MM8BDM v6b lumps
// declare no world variables at all (no WNAM chunk in any acs/*.o); the engine
// limit is 256 world slots.  Do not reuse Razon 3's slot 101.
world int 120:uh_bosspickcount[];   // vanilla boss ids 0..UH_MAX_VANILLA_BOSS-1
world int 121:uh_bosspickcustom[];  // custom boss ids, indexed by UH_BossCustomIndex

// Bonus winner's next-countdown reward.  Zero = none; otherwise player slot + 1.
// Slot 122 is unused by UH and the v6b base; no ACS strings cross map changes.
world int 122:uh_bosschoicewinner;
// LMS DoFight calls GAME_ResetMap/ResetScripts after the countdown. Persist
// the confirmed (player slot + 1, boss id) until the post-reset boss selection.
// Slot 123 is unused by UH/v6b. Owner zero = no choice, including boss id zero.
// Negative owner = winner left after confirming; keep the boss and exclude
// that player slot when assigning the reward to another random player.
world int 123:uh_bosschoicecommit[];
// Bonus-event appearances, keyed by UHDT event id (including addon rows).
// Slot 124 is unused by UH/v6b. Like boss history, survives round/map resets.
world int 124:uh_eventpickcount[];
// Attribution survives EX target changes. Do not derive it from today's graph.
world int 125:uh_eventfamilyextra[];
// Engine string GC marks world arrays; use dynamic strings for target identity.
world str 126:uh_eventextargetseen[];
world bool 127:uh_eventextargetknown[];

// Final committed boss identities, never placeholders. Slot zero is the count;
// subsequent cells hold signed UHDT ids. Snapshot at each boss-round selection
// so commits from early slots cannot change the previous-lineup exclusion.
// Slots 128/129 are unused by UH and the v6b base.
world int 128:uh_bosslastlineup[];
world int 129:uh_bosspreviouslineup[];

// Boss win-rate debug counters (server-session scope, like the pick history).
// One record is written for each DISTINCT Boss in the final committed line-up
// of an ordinary Boss-vs-Survivors round, after the cancellable settlement
// window commits. Bonus Events and versus duels are excluded because their
// win conditions are different. The host can clear every counter with
// uh_bossstats_reset; pick history stays untouched.
// Slots 130-137 are unused by UH and the v6b base (engine limit is 256 slots).
world int 130:uh_bossstatswins[];         // vanilla boss ids, indexed by id
world int 131:uh_bossstatswinscustom[];   // custom boss ids, indexed by UH_BossCustomIndex
world int 132:uh_bossstatslosses[];       // vanilla boss ids, indexed by id
world int 133:uh_bossstatslossescustom[]; // custom boss ids, indexed by UH_BossCustomIndex
world int 134:uh_bossstatsrounds;         // completed ordinary rounds recorded
world int 135:uh_bossstatsbosswins;       // Boss-side wins among those rounds
world bool 136:uh_bossstatsrecorded;      // per-round one-shot guard
world int 137:uh_bossstatslastrequest;    // NET query cooldown (0 = ready)
// Boss-vs-boss duel survivor betting state (slots 138-139 free; limit 256).
// uh_vsbetreward persists across maps until granted in the next non-bonus
// round (even if the winner is selected as Boss); cleared on disconnect.
// uh_vsbetchoice holds the active duel's bet per player and is reset per duel.
world int 138:uh_vsbetreward[];           // 0=none, 1=normal, 2=epic draw
world int 139:uh_vsbetchoice[];           // 0=none, 1=slot0, 2=slot1, 3=draw

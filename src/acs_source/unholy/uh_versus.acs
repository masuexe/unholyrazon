// Boss-vs-boss versus event.  Ordinary fixed/dynamic pairs use the common
// watcher; semantic combo flags route Shadow, Zankokuna and Higlur behavior
// through their own setup/terminal hooks.
// Fragment of library unholy.  Selection and the versus flag live in
// uh_funclib.acs; the PowerProtectBoss exception lives in uh_bosscore.acs.
//
// V2 contract:
//   - exactly four outcomes: slot 0 wins, slot 1 wins, same-window double
//     death is a draw, and a disconnect/spectator slot forfeits;
//   - the watcher atomically claims `gameover` and stops every other
//     round-ending script before it announces, so only one result sequence
//     and one Exit_Normal can run;
//   - versus rounds never touch survivor winstreak / mercy / hellmark;
//   - cross-slot Dickhead boss revival is blocked (versusblockrevive);
//   - a failed boss morph forfeits that side; both sides failing is a draw,
//     so the watcher can never hang on a slot that will not fall.
//
// The watcher deliberately trusts only the two bossdataarr slots and
// bossslotalive (maintained by ub_BossHealthWatcher for death, spectator and
// disconnect).  It never inspects the normal Boss/Eye totals, so survivor
// deaths cannot end the duel early.

#define UHVS_HUD_NAME1 8001
#define UHVS_HUD_NAME2 8002
#define UHVS_HUD_ICON 8003
#define UHVS_INTRO_TICS 105

// Outcomes.
#define UHVS_SLOT0 0
#define UHVS_SLOT1 1
#define UHVS_DRAW 2

// Announcement reasons.
#define UHVS_REASON_DEATH 0
#define UHVS_REASON_FORFEIT 1
#define UHVS_REASON_MORPHFAIL 2

#define UHVS_WIN_DELAY (35 * 9)
#define UHVS_FORFEIT_DELAY (35 * 6)
#define UHVS_DRAW_DELAY (35 * 5)

function void UHVS_ClearIntroHud(void) {
  ClearHudMessageBold(UHVS_HUD_NAME1);
  ClearHudMessageBold(UHVS_HUD_NAME2);
  ClearHudMessageBold(UHVS_HUD_ICON);
}

// Same-boss duels would otherwise show one identical name twice; append the
// player number so the HUD and winner announcement stay unambiguous.
function str UHVS_DisplayName(int bossid, int tid, bool sameboss) {
  if (!sameboss) {return GetBossName(bossid);}
  return StrParam(s:GetBossName(bossid), s:" (P", i:(tid - 999), s:")");
}

// Both registered names plus the legacy VS graphic, matching the old
// ub_ManageBossVsBossEvent layout.
function void UHVS_ShowIntro(int boss1, int boss2, int tid1, int tid2) {
  bool sameboss = (boss1 == boss2);
  SetHudSize(640, 480, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:UHVS_DisplayName(boss1, tid1, sameboss); HUDMSG_FADEOUT, UHVS_HUD_NAME1, -1, 294.6, 48.0, UHVS_INTRO_TICS / 35.0 + 2.0, 2.0);
  HudMessageBold(s:UHVS_DisplayName(boss2, tid2, sameboss); HUDMSG_FADEOUT, UHVS_HUD_NAME2, -1, 346.5, 48.0, UHVS_INTRO_TICS / 35.0 + 2.0, 2.0);
  SetFont("UFACEVS0");
  HudMessageBold(s:"A"; HUDMSG_FADEOUT, UHVS_HUD_ICON, -1, 320.4, 48.0, UHVS_INTRO_TICS / 35.0 + 2.0, 2.0);
}

function bool UHVS_IsNormalDeathState(int deathstate) {
  return deathstate == 5 || deathstate == 6;
}

function bool UHVS_BothSlotsDiedNormally(void) {
  return UHVS_IsNormalDeathState(bosshparr[0][BOSSHP_DEATH]) &&
         UHVS_IsNormalDeathState(bosshparr[1][BOSSHP_DEATH]);
}

// Atomically claim the round ending.  ACS is cooperative and single-threaded,
// so a check-then-set inside one function cannot be interleaved with another
// script's resolution; the first caller wins and every later caller bails.
function bool UHVS_ClaimGameover(void) {
  if (gameover) {return false;}
  gameover = true;
  return true;
}

// Stop every other script that could run a result sequence, revive a fallen
// versus slot, or end the round on its own.  The boss health watcher is
// included because after a result its slot bookkeeping is no longer useful.
function void UHVS_StopConflictingScripts(void) {
  ACS_NamedTerminate("ub_WatchSurvivors", 0);
  ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
  ACS_NamedTerminate("rz_WatchTwoPlayerLeft", 0);
  ACS_NamedTerminate("ub_BossHealthWatcher", 0);
  ACS_NamedTerminate("ub_DemoneyeNumWatcher", 0);
  ACS_NamedTerminate("uh_BackgroundTimer", 0);
  ACS_NamedTerminate("uh_ZankokunaRage", 0);
  ACS_NamedTerminate("rz_DickheadRevival", 0);
  ACS_NamedTerminate("rz_DickheadRevivalDelayed", 0);
}

// Synchronous half of the resolution: claim the ending, stop conflicting
// scripts, clear the combo state and post the result HUD/music.  Returns the
// number of tics the caller should wait before Exit_Normal, or -1 when another
// script already claimed the ending.  Delay/Exit_Normal stay in the script
// because ACS forbids latent calls inside functions.
function int UHVS_Resolve(int result, int reason) {
  if (!UHVS_ClaimGameover()) {return -1;}

  UHVS_ClearIntroHud();
  UHVS_StopConflictingScripts();
  ResetBossComboState();  // Clears versusfightevent for the next round.

  // Versus rounds deliberately do not touch winstreak / mercygiven /
  // hellmarkfrags / survwinwithlms: this is a boss-vs-boss duel, not a
  // survivor-vs-boss result.

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");

  if (result == UHVS_DRAW) {
    HudMessageBold(s:"\cdDraw!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);
    return UHVS_DRAW_DELAY;
  }

  int winnertid;
  int winnerboss;
  if (result == UHVS_SLOT0) {
    winnertid = bossdataarr[0][BOSSDATA_TID];
    winnerboss = bossdataarr[0][BOSSDATA_NUM];
  }
  else {
    winnertid = bossdataarr[1][BOSSDATA_TID];
    winnerboss = bossdataarr[1][BOSSDATA_NUM];
  }
  GiveActorInventory(winnertid, "PowerSuicideProtect", 1);
  PlayMusic_Winner(-1);
  bool sameboss = (bossdataarr[0][BOSSDATA_NUM] == bossdataarr[1][BOSSDATA_NUM]);
  str winnername = UHVS_DisplayName(winnerboss, winnertid, sameboss);

  if (reason == UHVS_REASON_DEATH) {
    HudMessageBold(s:winnername, s:" \c-Wins!"; HUDMSG_FADEOUT, 66, CR_WHITE, 240.4, 54.0, 5.0, 2.0);
    return UHVS_WIN_DELAY;
  }
  // Forfeit (disconnect/spectator) and morph failure share the default-win
  // wording; both mean the opponent never had to be killed.
  HudMessageBold(s:winnername, s:" \c-Wins by default!"; HUDMSG_FADEOUT, 66, CR_WHITE, 240.4, 54.0, 5.0, 2.0);
  return UHVS_FORFEIT_DELAY;
}

// Red Baron + Blue Jay have a distinct terminal branch: a normal double death
// queues Higlur for the next round.  It still has one atomic owner and one
// Exit_Normal, so the ordinary draw result cannot race the summon.
function int UHVS_ResolveHiglurDraw(void) {
  if (!UHVS_ClaimGameover()) {return -1;}

  UHVS_ClearIntroHud();
  UHVS_StopConflictingScripts();
  ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 403);
  ResetBossComboState();

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:"\cmYOU HEAR SOMETHING SCREAMING IN THE DISTANCE!"; HUDMSG_FADEOUT, 66, CR_BLACK, 240.4, 54.0, 3.0, 2.0);
  return UHVS_DRAW_DELAY;
}

script "ub_ManageBossVsBossEvent" (void) {
  SetActivator(0, AAPTR_NULL);

  // Only the two-slot versus combo reaches this script.  Anything else is a
  // selection bug: bail out instead of hanging on a slot that will never fall.
  if (multibosscheck != 2) {
    DebugLog(strParam(s:"ub_ManageBossVsBossEvent: expected 2 boss slots, got ", i:multibosscheck, s:"; aborting."));
    terminate;
  }
  if (gameover) {terminate;}

  // Block cross-slot Dickhead boss revival for the rest of this map.  The
  // flag is cleared at the next round selection, not by ResetBossComboState,
  // so a late revival cannot reopen the duel during the result sequence.
  versusblockrevive = true;

  // The versus watcher owns the ending: stop the X-Ray watcher and the
  // background timer, which could otherwise end the round on its own.  The
  // boss health watcher must stay alive because bossslotalive depends on it.
  ACS_NamedTerminate("rz_WatchTwoPlayerLeft", 0);
  ACS_NamedTerminate("uh_BackgroundTimer", 0);

  int boss1 = bossdataarr[0][BOSSDATA_NUM];
  int boss2 = bossdataarr[1][BOSSDATA_NUM];

  UHVS_ShowIntro(boss1, boss2, bossdataarr[0][BOSSDATA_TID], bossdataarr[1][BOSSDATA_TID]);
  Delay(1);

  // Morph failure is decided before this watcher starts
  // (ub_BossMorphRetryWait / ub_MorphFailureFallback).  Resolve instead of
  // waiting on a slot that will never fall.
  int morph0 = bossdataarr[0][BOSSDATA_MORPHED];
  int morph1 = bossdataarr[1][BOSSDATA_MORPHED];
  if (morph0 == 0 || morph1 == 0) {
    Delay(35);
    int mresult;
    int mdelay;
    if (morph0 == 0 && morph1 == 0) {mresult = UHVS_DRAW;}
    else if (morph0 == 0) {mresult = UHVS_SLOT1;}
    else {mresult = UHVS_SLOT0;}
    mdelay = UHVS_Resolve(mresult, UHVS_REASON_MORPHFAIL);
    if (mdelay >= 0) {
      Delay(mdelay);
      Exit_Normal(0);
      Delay(35 * 3);
    }
    terminate;
  }

  // Intro countdown, cancelled early if a slot falls or another script ends
  // the round.
  int introleft = UHVS_INTRO_TICS;
  while (introleft > 0 && bossslotalive[0] && bossslotalive[1] && !gameover) {
    Delay(1);
    introleft--;
  }
  UHVS_ClearIntroHud();
  if (gameover) {terminate;}

  // Wait for at least one slot to fall.  bossslotalive is cleared for death,
  // spectator and disconnect; bosshparr[numb][BOSSHP_DEATH] distinguishes
  // 5/6 (death) from 7 (spectator/disconnect) for the forfeit wording.
  while (bossslotalive[0] && bossslotalive[1] && !gameover) {
    Delay(1);
  }
  if (gameover) {terminate;}

  bool alive0 = bossslotalive[0];
  bool alive1 = bossslotalive[1];
  bool bothnormaldeath = UHVS_BothSlotsDiedNormally();

  int result;
  int reason;
  if (alive0 && !alive1) {
    result = UHVS_SLOT0;
    if (bosshparr[1][BOSSHP_DEATH] == 7) {reason = UHVS_REASON_FORFEIT;}
    else {reason = UHVS_REASON_DEATH;}
  }
  else if (!alive0 && alive1) {
    result = UHVS_SLOT1;
    if (bosshparr[0][BOSSHP_DEATH] == 7) {reason = UHVS_REASON_FORFEIT;}
    else {reason = UHVS_REASON_DEATH;}
  }
  else {
    // Both slots fell in the same window: draw.
    result = UHVS_DRAW;
    reason = bothnormaldeath ? UHVS_REASON_DEATH : UHVS_REASON_FORFEIT;
  }

  int delaytics;
  if (result == UHVS_DRAW && bothnormaldeath &&
      BossComboHasFlag(BOSSCOMBO_FLAG_HIGLUR)) {
    delaytics = UHVS_ResolveHiglurDraw();
  }
  else {
    delaytics = UHVS_Resolve(result, reason);
  }
  if (delaytics >= 0) {
    Delay(delaytics);
    Exit_Normal(0);
    Delay(35 * 3);
  }
}

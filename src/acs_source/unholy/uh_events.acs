// Round event system: event management, free-for-all / one-vs-all /
// demoneye events, special-event tracking and endings.  Fragment of
// library unholy (ex-uh_bonus); event predicates live in uh_funclib.acs
// (CheckEventList / ExEventChecker / IsDemoneyeEvent), EVENTDATA_* in uh_def.acs.
script "ub_InitiateUltraBoss" (int Ultra) {
  switch (Ultra) {
    default:
      DebugLog(strParam(s:"ub_InitiateUltraBoss called with an invalid id."));
      break;
    case 1:  // Survivor win-streak reward
      if (winstreak >= GetClampedCvar("uh_sv_WinStreakLimit", 1, 100))
        Add_StrongmanCheckArray(random(400, 404));
      break;
    case 400:  // Zankokuna Hellbot
      if (helltimer >= 1)
        Add_StrongmanCheckArray(400);
      break;
    case 401:  // Eyelento Major
      Add_StrongmanCheckArray(401);
      break;
    case 402:  // FinalSampi
      if (hellmarkfrags >= GetClampedCvar("uh_sv_HellMarkLimit", 1, 100)) {
        hellmarkfrags = 0;
        Add_StrongmanCheckArray(402);
      }
      break;
    case 403:  // Higlur
      Add_StrongmanCheckArray(403);
      break;
    case 404:  // FinalSpeciman
      specimanfrags++;
      if (specimanfrags >= 15) {
        AmbientSound("misc/gammadeath1", 51);
        ActivatorSound("E_B/SMAAAASH", 127);
        specimanfrags = 0;
        Add_StrongmanCheckArray(404);
      }
      break;
  }
}


script "ub_EventManagementACS" (int perform) {
  if (perform == -2) {
    eventdataarr[EVENTDATA_MAINEVENT] = PickRandomBonusEvent();
    bool eventselected = false;

    int rawcvar = CheckClearCvar("uh_sv_BonusEventNum", -1);
    int uex = ResolveForcedBonusEvent(rawcvar);
    if (uex >= 0) {
      eventdataarr[EVENTDATA_MAINEVENT] = uex;
      eventdataarr[EVENTDATA_LASTEVENT] = 77;
      ShowMeTheRCON("The Bonus Event", uex);
      eventselected = true;
    }
    else if (rawcvar != -1) {
      DebugLog(strParam(s:"Invalid forced bonus event CVAR: ", i:rawcvar));
    }

    if (!eventselected && eventdataarr[EVENTDATA_FORCED] >= 0) {
      int rawworldforced = eventdataarr[EVENTDATA_FORCED];
      eventdataarr[EVENTDATA_FORCED] = -1;
      int worldforced = ResolveForcedBonusEvent(rawworldforced);
      if (worldforced >= 0) {
        eventdataarr[EVENTDATA_MAINEVENT] = worldforced;
        eventdataarr[EVENTDATA_LASTEVENT] = 77;
        ShowMeTheRCON("Forced Bonus Event", worldforced);
        eventselected = true;
      }
      else {
        DebugLog(strParam(s:"Invalid forced bonus event world value: ", i:rawworldforced));
      }
    }

    if (!eventselected) {
      do {
        eventdataarr[EVENTDATA_MAINEVENT] = PickRandomBonusEvent();
        Delay(1);
      } while (eventdataarr[EVENTDATA_MAINEVENT] == eventdataarr[EVENTDATA_LASTEVENT]);
      eventdataarr[EVENTDATA_MAINEVENT] = ExEventChecker(eventdataarr[EVENTDATA_MAINEVENT]);
    }
  }

  else if (perform != -2) {
    eventdataarr[EVENTDATA_DELAY] = 0;  // RNG EVENT DELAY
    eventdataarr[EVENTDATA_LASTEVENT] = eventdataarr[EVENTDATA_MAINEVENT];
    twoplayersxrayenabled = false;
    Delay(1);
    if (mercygiven) {
      ACS_NamedExecute("rz_MercyRuneGiver", 0);
    }
    ACS_NamedExecute("rz_WatchTwoPlayerLeft", 0);

    switch (eventdataarr[EVENTDATA_MAINEVENT]) {
      default:
      case UHEVENT_FFA:  // Free For All
        ACS_NamedExecute("ub_FreeForAll", 0, 0);
        break;
      case UHEVENT_MLG:  // MLG
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 1);
        break;
      case UHEVENT_GHOST:  // SPOOK
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 2);
        break;
      case UHEVENT_JOUST:  // Joust
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 3);
        break;
      case UHEVENT_SUMO:  // Sumo
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 4);
        break;
      case UHEVENT_KAMIKAZE:  // Kamikaze
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 5);
        break;
        // case 6://Rich Devil//Rich
        // 	//ACS_NamedExecute("ub_DemoneyeEvent", 0, 6);
        // 	if(RandomPercent(15)){
        // 		MultiBossFunction(0);
        // 	}
        // 	else{
        // 		bossSlotAlive[0] = true;
        // 	}
        // 	SimpleBossChange(302,302,302,302);
        // 	Delay(1);
        // 	ACS_NamedExecute("ub_MorphSelectedBosses",0);
        // 	break;
      case UHEVENT_BOMBER:  // Bomber
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 7);
        break;
      case UHEVENT_BUSINESS:  // Business
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 8);
        break;
      case UHEVENT_QUICK:  // Quick
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 9);
        break;
      case UHEVENT_TANK:  // Tank
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 10);
        break;
      case UHEVENT_EYEPARADE:  // Eye Parade
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 0);
        break;
      case UHEVENT_CLONEPARADE:  // Clone Parade
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 1);
        break;
      case UHEVENT_FOOTBALL:  // Free For All (Football)
        ACS_NamedExecute("ub_FreeForAll", 0, 1);
        break;
        // case 14://Boss for all
        // 	//
        // 	break;

      case UHEVENT_TRUEPOWER:  // Free For All (TruePower)
        ACS_NamedExecute("ub_FreeForAll", 0, 100);
        break;
      case UHEVENT_EYELENTO:  // Eyelento of Pain
        ACS_NamedExecute("ub_EyelentoOfPain", 0, 6);
        break;
      case UHEVENT_CATCHFURRY:  // Eye Parade vs Furry Runner
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 50);
        break;
      case UHEVENT_RUNAWAYFOX:  // Eye Parade vs Foxeye Killer
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 51);
        break;
      case UHEVENT_RUNES:  // Free For All (Runes)
        ACS_NamedExecute("ub_FreeForAll", 0, 113);
        break;
    }
    isbonuseventactive = true;
  }
}


// FREE FOR ALL SCRIPT
script "ub_FreeForAll" (int freechance) {
  int forchance = 0;

  switch (freechance) {
    default:
      forchance = random(1, 9);
      break;
    case 1:
    case 10:
    case 113:
      break;
  }

  // if(FreeChance != 1 && FreeChance != 10 && FreeChance != 113){ForChance = random(1,9);}

  GiveMeTheFunc("PowerProtectSurvivor", -1);
  GiveMeTheFunc("PowerProtectMegaCopywep", -1);
  GiveMeTheFunc("PowerProtectUnholyItem", -1);

  if (forchance == 7) {GiveMeTheFunc("DeadlyFireArmsItem", 1);}
  if (forchance == 5) {GiveMeTheFunc("YouWillDieItem", 1);}

  if (freechance == 1) {
    GiveMeTheFunc("TheFootballItemX", 1);
    AmbientSound("misc/FootballEvent", 127);
  }
  else {AmbientSound("misc/DixieLandStart", 127);}

  switch (freechance) {
    default:
    case 0:
      PlayMusic(bonuseventlist[0][BONUS_MUSICLUMP]);
      MusicCredits(bonuseventlist[0][BONUS_MUSICCREDITS], 0);
      break;
    case 100:
      GiveMeTheFunc("AutoTruePowerItemSilent", 1);
      PlayMusic(bonuseventlist[100][BONUS_MUSICLUMP]);
      MusicCredits(bonuseventlist[100][BONUS_MUSICCREDITS], 0);
      break;
    case 113:
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_RAGE, 0);
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_SPREAD, 0);
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_RESISTANCE, 0);
      GiveMeTheFunc("PancakeFoodItem", 1);
      PlayMusic(bonuseventlist[113][BONUS_MUSICLUMP]);
      MusicCredits(bonuseventlist[113][BONUS_MUSICCREDITS], 0);
      break;
  }

  SetFont("BIGFONT");
  ClearHudMessage(49);
  SetHudSize(640, 480, 0);
  HudMessageBold(s:"Meanwhile, in Dixieland of 1840..."; HUDMSG_FADEOUT, 66, CR_GRAY, 320.4, 72.2, 3.0, 2.0);
  SetPlayerProperty(1, 0, 4);
  ACS_NamedExecute("ub_WhoWonTheRound", 0);
}

script "ub_WhoWonTheRound" (void) {
  until (GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
    Delay(5);
  }
  Delay(1);
  int findtid = 0;
  until (findtid == 64) {
    if (PlayerInGame(findtid) && CheckActorInventory(findtid + 1000, "IsDead") != 1) {
      AdjustPlayerForceNumArray(findtid + 1000);
      DebugLog(strParam(s:"Player ", i:findtid, s:" (", n:findtid + 1, s:") won the round! "));
      terminate;
    }
    findtid++;
  }
  DebugLog(strParam(s:"Match was a draw! No winner set."));
}


// Demoneye event script
script "ub_DemoneyeEvent" (int which) {
  str stem = GetEyeEventStem(which);
  str eyemorphstr = StrParam(s:stem, s:"_MoolaGiver");
  str eyebonusstr = StrParam(s:stem, s:"_EventD_P");

  GiveMeTheFunc(eyemorphstr, 1);
  GiveMeTheFunc(eyebonusstr, 1);

  if (which == 2) {
    // SectorColorChange(50,50,50,0);
    VariableLightChange(160, 0);
    InstantLightChange(160);
  }

  ACS_NamedExecute("ub_WhoWonTheRound", 0);
  PlayMusic(bonuseventlist[which][BONUS_MUSICLUMP]);
  Delay(2);
  MusicCredits(bonuseventlist[which][BONUS_MUSICCREDITS], 0);
  ACS_NamedExecute("uh_DemoneyeEventTextDelay", 0, which, 105);
  Delay(33);
  while (totalplayersarr[PLS_SURVIVOR] > 0) {  // If player(s) are not morphed, find and attempt to morph them.
    DemoneyeEventMorphCheckFunc(eyemorphstr, eyebonusstr);
    Delay(70);
  }
  DebugLog(strParam(s:"Demoneye event script finished!"));

  // if (which == 2) {
  // 	while (timer() < 1050) {
  // 		Delay(1);
  // 	}
  // 	giveMeTheFunc("GhostEyeShadowInvisOff_P", 1);
  // }
}

function void DemoneyeEventMorphCheckFunc(str eyetype, str eyepickup) {
  for (int i = 0; i <= playerlifestatusarr[MAX_PLAYERS]; i++) {
    if (playerlifestatusarr[i] == PLS_SURVIVOR) {
      GiveActorInventory(i + 1000, eyetype, 1);
      GiveActorInventory(i + 1000, eyepickup, 1);
    }
  }
}

script "uh_DemoneyeEventTextDelay" (int which, int delaytime) {
  SetFont("BIGFONT");
  AmbientSound(bonuseventlist[which][BONUS_BONUSSOUND], 127);
  SetHudSize(640, 480, 0);
  HudMessageBold(s:bonuseventlist[which][BONUS_HUDMESS1]; HUDMSG_FADEOUT, 49, CR_WHITE, 320.4, 432.2, 4.0, 2.0);
  SetPlayerProperty(1, 0, 4);
  if (GetChar(bonuseventlist[which][BONUS_HUDMESS2], 0) != 0) {
    Delay(delaytime);
    SetFont("SMALLFONT");
    HudMessageBold(s:bonuseventlist[which][BONUS_HUDMESS2]; HUDMSG_FADEOUT, 66, CR_WHITE, 320.4, 456.2, 1.0, 2.0);
  }
}

// Scripts used by special events

// This script is mainly for the 1 vs Something events
script "ub_OneVsAllEvent" (int which) {

  str eventstring = "Null";
  int mainhealth = 0;
  Delay(1);

  SetUpPlayerSelection_Func();

  // EXTREME
  // If(UnholyBoss == 300){GiveActorInventory(BossTID1,"Is_UH_BossNum",1);}

  Delay(1);
  DebugLog(strParam(s:"The 1 vs. all target: ", d:bossdataarr[0][BOSSDATA_TID]));

  Delay(1);

  int tempboss1 = bossdataarr[0][BOSSDATA_TID];

  switch (which) {
    default:
    case 0:
      GiveMeTheFuncExceptBosses("Plain_MoolaGiver", 1);
      GiveMeTheFuncExceptBosses("PlaineyeEventProtect", 1);

      GiveActorInventory(tempboss1, "SurvivorBoxItems_P", 1);

      mainhealth = 115;

      Delay(1);
      ACS_NamedExecute("ub_SpecialEventEnding", 0, 0);  // SinglePlayer tracker

      PlayMusic(bonuseventlist[11][BONUS_MUSICLUMP]);
      MusicCredits(bonuseventlist[11][BONUS_MUSICCREDITS], 0);
      break;
  }

  if (which != 50 && which != 51 && which == 100) {
    bossdataarr[0][BOSSDATA_NUM] = TrueRandomBoss();
    // UnholyBoss1
    bossdataarr[0][BOSSDATA_MORPHED] = MorphActorToBoss(bossdataarr[0][BOSSDATA_TID], bossdataarr[0][BOSSDATA_NUM], "GigaAstroExplode");

    ACS_NamedExecuteWait("ub_BossMorphRetryWait", 0, -1);
  }
  else {
    mainhealth = min(GetActorProperty(tempboss1, APROP_SPAWNHEALTH) + (PlayerCount() * mainhealth), MAX_HEALTH);
    SetActorProperty(tempboss1, APROP_HEALTH, mainhealth);
    SetActorProperty(tempboss1, APROP_SPAWNHEALTH, mainhealth);
  }

  switch (which) {
    default:
    case 0:
      ACS_NamedExecute("ub_SpecialEventTracker", 0);
      eventstring = "Hey look, A \ctDemoneye \c-Parade.";
      break;
    case 1:
      ACS_NamedExecute("ub_SpecialEventTracker", 0);
      eventstring = "Here approaches the darkness!";
      break;
    case 50:
      eventstring = "\caKILL THAT FURRY!";
      ACS_NamedExecute("ub_SpecialEventTracker", 0, 50);
      break;
    case 51:
      eventstring = "\caUH OH! AN ANGRY FOXEYE! RUN OR KILL IT!";
      ACS_NamedExecute("ub_SpecialEventTracker", 0, 51);
      break;
  }

  SetFont("BIGFONT");
  HudMessageBold(s:eventstring; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 324.0, 1.8, 0.2);
  SetPlayerProperty(1, 0, 4);
}

// Eyelento of Pain bonus event (ported from unbound Script 827)
script "ub_EyelentoOfPain" (int eyelentoamount) {
  PlayMusic(bonuseventlist[106][BONUS_MUSICLUMP]);
  MusicCredits(bonuseventlist[106][BONUS_MUSICCREDITS], 0);

  ACS_NamedExecute("ub_WatchSurvivors", 0, true);

  if (totalplayersarr[PLS_SURVIVOR] <= eyelentoamount) {
    eyelentoamount = totalplayersarr[PLS_SURVIVOR] - 1;
  }
  int eyelentorng = 0;
  standardlmseventlocked = true;
  SetPlayerProperty(1, 0, 4);
  while (ThingCountName("EyelentoMajorDemoneye", 0) < eyelentoamount) {
    eyelentorng = random(1000, playerlifestatusarr[MAX_PLAYERS] + 1000);
    MorphActor(eyelentorng, "EyelentoMajorDemoneye", "", 0x7ffffffd, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "EyelentoMajorDemoneyeC");
    Delay(1);
  }
  ACS_NamedExecute("ub_SpecialEventEnding", 0, 2);
}

// Basic, YOU WIN/LOSE script for special events.
script "ub_SpecialEventEnding" (int which) {
  SetActivator(0, AAPTR_NULL);
  int exitdelay = 10;
  str endingstring = "Null";
  switch (which) {
    case 0:
      endingstring = "The \ctDemoneyes\cj are now being payed with \n\cdREAL Money\c-.";
      while (ThingCount(0, bossdataarr[0][BOSSDATA_TID]) >= 1) {Delay(2);}
      PlayMusic_Win(1);
      break;
    case 1:
      endingstring = "The darkness consumes all.";
      while (ThingCount(0, bossdataarr[0][BOSSDATA_TID]) >= 1) {Delay(2);}
      PlayMusic_Win(1);
      break;
    case 2:
      endingstring = "\cfThe Eyelentos have been defeated!";
      while (ThingCountName("EyelentoMajorDemoneye", 0) >= 1) {Delay(2);}
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 401);
      exitdelay = 8;
      break;
  }
  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:endingstring; HUDMSG_FADEOUT, 66, CR_WHITE, 240.4, 54.0, 3.0, 2.0);
  gameover = true;
  Delay(35 * exitdelay);
  Exit_Normal(0);
  Delay(35 * exitdelay);
}

// Special trackers for special things, also includes special endings.
script "ub_SpecialEventTracker" (int which) {
  SetActivator(0, AAPTR_NULL);
  int timer_ten = 20;
  switch (which) {
    case 0:
      // Prefer DefineSurvivor id for HUD encoding; fall back to KEYCONF PlayerClass.
      int pnum0 = bossdataarr[0][BOSSDATA_TID] - 1000;
      int sid0 = FindSurvivorByActor(GetActorClass(bossdataarr[0][BOSSDATA_TID]));
      int tempnum_0;
      if (sid0 != UHSURV_FAIL)
        tempnum_0 = EncodeSurvivorBossNumb(sid0);
      else
        tempnum_0 = PlayerClass(pnum0) * -1 - 100;
      bool tempmorphedbool;
      bool forcehud = true;
      bossslotalive[0] = true;
      while (bossslotalive[0]) {  // @@@@@@@@@@@@@@@@

        if (!tempmorphedbool)
          if (CheckActorInventory(bossdataarr[0][BOSSDATA_TID], "MorphedFlag")) {
          if (playerlifestatusarr[bossdataarr[0][BOSSDATA_TID] - 1000] == PLS_EYE) {
            int eyehud = GetPlayerEyeId(bossdataarr[0][BOSSDATA_TID] - 1000);
            if (eyehud == UHEYE_FAIL)
              eyehud = CheckActorInventory(bossdataarr[0][BOSSDATA_TID], "ThisIsMyMagicEyeNumber");
            tempnum_0 = EncodeEyeBossNumb(eyehud);
          }
          else if (CheckActorInventory(bossdataarr[0][BOSSDATA_TID], "TruePowerItemFlag")) {
            // Reuse pre-morph sid0 — GetActorClass is *Shiny after morpher.
            if (sid0 != UHSURV_FAIL)
              tempnum_0 = EncodeSurvivorShinyBossNumb(sid0);
            else
              tempnum_0 = EncodeSurvivorShinyBossNumb(PlayerClass(pnum0));
          }
          else
            tempnum_0 = bossdataarr[0][BOSSDATA_NUM];
          tempmorphedbool = true;
          forcehud = true;
        }
        Func_BHW_Checker(0, bossdataarr[0][BOSSDATA_TID], tempnum_0, forcehud);
        forcehud = false;
        Delay(1);
      }
      break;
    case 50:
      SetHudSize(640, 480, 0);
      timer_ten = 60 - (PlayerCount() * 2);
      if (timer_ten < 21) {timer_ten = 20;}
      while (timer_ten >= 1) {
        SetFont("HELTIMR1");
        HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
        SetFont("fakefntC");  // SMALLFONT
        HudMessageBold(i:timer_ten; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

        // SetFont("SMALLFONT");
        // HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
        timer_ten -= 1;
        Delay(35);
        if (gameover || GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
          ClearHudMessage(166);
          ClearHudMessage(167);
          terminate;
        }
      }
      SetFont("HELTIMR0");
      HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
      SetFont("fakefntC");  // SMALLFONT
      HudMessageBold(i:timer_ten; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

      // HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
      Delay(1);
      PlayMusic_Loss(2);
      SetHudSize(480, 360, 0);
      SetFont("BIGFONT");
      HudMessageBold(s:"\caThe Furry Escaped!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
      MakeAllPlayersInvun();
      SetPlayerProperty(1, 1, 4);
      gameover = true;
      Delay(35 * 6);
      Exit_Normal(0);
      Delay(36 * 6);
      break;
    case 51:
      SetHudSize(640, 480, 0);
      timer_ten = 18 + RoundFixedToInt(PlayerCount() * 1.5);
      while (timer_ten >= 1) {
        SetFont("HELTIMR1");
        HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
        SetFont("fakefntC");  // SMALLFONT
        HudMessageBold(i:timer_ten; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

        // SetFont("fakefntC");//SMALLFONT
        // HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.96, 0, 3.0);
        timer_ten -= 1;
        Delay(35);
        if (gameover || GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
          ClearHudMessage(166);
          ClearHudMessage(167);
          terminate;
        }
      }
      SetFont("HELTIMR0");
      HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
      SetFont("fakefntC");  // SMALLFONT
      HudMessageBold(i:timer_ten; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

      // HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
      Delay(1);
      PlayMusic_Loss(1);
      SetHudSize(480, 360, 0);
      SetFont("BIGFONT");
      HudMessageBold(s:"The \ctDemoneyes\cj Survived!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
      MakeAllPlayersInvun();
      gameover = true;
      Delay(35 * 6);
      Exit_Normal(0);
      Delay(36 * 6);
      break;
  }
}

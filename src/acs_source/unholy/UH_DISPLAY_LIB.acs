//Clientside Display Zone

#DEFINE HUDMESSAGE_REFRESHER_RATE 175//404
bool refreshHudMessage;

script "ub_refreshHudMessageLoop" (void)//OPEN
{
	int CycleDelay;
	while(1){
		CycleDelay++;
		Delay(1);
		if(CycleDelay >= HUDMESSAGE_REFRESHER_RATE || refreshHudMessage){
			refreshHudMessage = true;
			Delay(1);
			refreshHudMessage = false;
			CycleDelay = 1;
		}
	}
}

#library "unholy"
#include "zcommon.acs"
#include "uh_lib.acs"

//Demoneyes + other morphes
Script "uh_DemoneyeMorph" (int whoisit, int Bonus)
{

// PlayerLifeStatusArr_UpdateFunc(PlayerNumber(),6);

TakeInventory("ThisIsMyMagicEyeNumber",9999);//Used for Menu Help/MugShot
GiveInventory("ThisIsMyMagicEyeNumber",whoisit+Bonus*100);

TakeInventory("PowerProtectSurvivor",1);
TakeInventory("PowerProtectUnholyItem",1);


GiveInventory("BAWS",1);
GiveInventory("MorphedFlag",1);
GiveInventory("IsAnEye",1);
//if(StrCmp(EyeList[whoisit][3],"E") == 0){GiveInventory("IsAnEye",1);}

// if(Bonus && MultiBossCheck >= 2 && !VersusFightEvent){
// 	GiveInventory("PowerProtectBoss",1);//If multi boss, protect them from each other.
// }


SetFont("SMALLFONT");
// ClearHudMessage(66);
SetHudSize(384,288,0);

HudMessage(s:"\ckYou are now ",s:EyeList[whoisit][0],s:EyeList[whoisit][1],s:" \ctDemoneye\ck!"; HUDMSG_FADEOUT, -6001, -1, 192.4, 24.0, 3.0, 2.0);
//if(StrCmp(EyeList[whoisit][3],"") != 0) {HudMessage(s:"You aren't really getting paid for this anyways..."; HUDMSG_FADEOUT, 59, CR_RED,0.5, 0.18, 3.0,2.0);}

// if(!DemoneyeEvent){
	SetFont("BIGFONT");
	SetHudSize(640,480,0);
	HudMessageBold(n:0, s:" \ckwas paid to become ",s:EyeList[whoisit][0],s:EyeList[whoisit][1],s:" Demoneye\c-!"; HUDMSG_FADEOUT|HUDMSG_LOG, 49, CR_YELLOW,320.4, 464.2, 1.8,0.2);//468.2//0.98 Y
// }
}


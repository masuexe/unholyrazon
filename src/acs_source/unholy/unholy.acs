Script "ub_BasicTLMSEnter" ENTER
{
	if(GetCvar("lastmanstanding")==1){

		// GiveInventory("PowerSuicideStartProtect",1);
		GiveInventory("ProtectSurvivor",1);
		// GiveInventory("ProtectUnholyItem",1);
	}
}

Script "ub_BasicTLMSRespawn" RESPAWN
{
	ACS_NamedExecuteAlways("ub_BasicTLMSEnter",0);
}

Script "ub_Death_ChangeIsAlive" DEATH
{
	if(GetCvar("lastmanstanding")==1){
		debugLog(strParam(i:PlayerNumber(),s:" is dead!!"));
		playerLifeStatusArr_UpdateFunc(PlayerNumber(),0);
	}
}
Script "ub_Disconnect_ChangeIsAlive" (int PlayerNum) DISCONNECT
{
	if(GetCvar("lastmanstanding")==1){
		debugLog(strParam(i:PlayerNum,s:" has disconnected!!"));
		playerLifeStatusArr_UpdateFunc(PlayerNum,0);
	}
}

script "ub_StartUpSettings" OPEN//These are start up variables so that they are valid numbers
//This also resets variables at round start (such as the bossDataArr[][])
{
	if(GetCvar("lastmanstanding")==0){
		PrintBold(s: "Gamemode must be set to \cgLast Man Standing\c- in order to play Unholy Razon!");
		if(GetCvar("mm8bdm_sv_respawnprotection")>0){consoleCommandWithWarn("mm8bdm_sv_respawnprotection 0", "Respawn protection is disabled.");}
		terminate;
	}

	if(GetGameModeState()==1||GetGameModeState()==0){
		//
	}
	else{
		if(GetCvar("sv_forcerandomclass")==1){consoleCommandWithWarn("sv_forcerandomclass 0", "Forced random class is disabled.");}//This breaks classes somehow, disabled.
		if(GetCvar("sv_noexit")==1){consoleCommandWithWarn("sv_noexit 0", "No exit is disabled.");}//Needed for exit map commands.
		if(GetCvar("winlimit")!=1){consoleCommandWithWarn("winlimit 1", "Win limit is set to 1.");}//Someone won? Then nextmap.
		//SetGameModeLimit(GAMELIMIT_WINS,1);//GAMELIMIT_WINS = 4
		//if(GetCvar("sv_forcerespawn")==0){consolecommand("sv_forcerespawn 1");}//Unsure if needed, legacy?
		if(GetCvar("mm8bdm_sv_respawnprotection")>0){consoleCommandWithWarn("mm8bdm_sv_respawnprotection 0", "Respawn protection is disabled.");}//Since the morphing starts within one second, sometimes a player would have invun from the pre-round.
		//if(GetCvar("sv_NoBossMusic")==0){SetCVar("sv_NoBossMusic",1);}//Might be legacy?
		if(GetCvar("Compat_NoLand")==0){consoleCommandWithWarn("Compat_NoLand 1", "No land is enabled.");}//Land is a dangerous tool
		if(GetCvar("sv_lmscountdowntime")<4){consoleCommandWithWarn("sv_lmscountdowntime 4", "LMS countdown time is set to 4 seconds.");}//At least 4 seconds are needed for pre-round scripts!
	}
	//Most variables are redundant

	gameover = false;
	
	playerLifeStatusArr_GatherFunc();

	multiBossCheck = 1;
	itemMode = false;
	standardlmseventlocked = false;
	theLMSDude = 1145;
	survWinWithLMS = false;

	isbonuseventactive = false;

	ACS_NamedExecuteWithResult("core_bossmusicstate", 1, 669); //Disables boss music for maps, that is if they use this script
	MusicSaveFunc();
	
	u_MapLevelName = strParam(n: PRINTNAME_LEVELNAME);
	u_MapLevelCode = strParam(n: PRINTNAME_LEVEL);

	if(GetCvar("uh_sv_BossDebugText")==1 && Debug_TXT == 0){
		PrintBold(s:"Debug_TXT ACTIVATED");
		Debug_TXT=1;
	}
	else if(GetCvar("uh_sv_BossDebugText")==0 && Debug_TXT == 1){
		PrintBold(s:"Debug_TXT IS NOW OFF");
		Debug_TXT=0;
	}

	if(!StartUpVariables){//These are the true startup variables, only done ONCE on server start.
		if(GetCvar("sv_forcerandomclass")==1){consoleCommandWithWarn("sv_forcerandomclass 0", "Forced random class is disabled.");}//This breaks classes somehow, disabled.
		if(GetCvar("sv_noexit")==1){consoleCommandWithWarn("sv_noexit 0", "No exit is disabled.");}//Needed for exit map commands.
		if(GetCvar("winlimit")!=1){consoleCommandWithWarn("winlimit 1", "Win limit is set to 1.");}//Someone won? Then nextmap.
		if(GetCvar("mm8bdm_sv_respawnprotection")>0){consoleCommandWithWarn("mm8bdm_sv_respawnprotection 0", "No respawn invulnerability is enabled.");}//Since the morphing starts within one second, sometimes a player would have invun from the pre-round.
		if(GetCvar("Compat_NoLand")==0){consoleCommandWithWarn("Compat_NoLand 1", "No land is enabled.");}//Land is a dangerous tool
		if(GetCvar("sv_lmscountdowntime")<4){consoleCommandWithWarn("sv_lmscountdowntime 6", "LMS countdown time is set to 6 seconds.");}
		//6 seconds sometimes causes a DRAW to go to the next map.
		if(GetCvar("mm8bdm_sv_nolmsweapons")==0){consoleCommandWithWarn("mm8bdm_sv_nolmsweapons 1", "LMS weapons are disabled.");}


		BossEventCounter = 0;

		MultiB_RNG_Arr[4] = 20;
		MultiB_RNG_Arr[3] = 30;
		MultiB_RNG_Arr[2] = 40;

		bossEXCountArr_Setter(500,1,3);//Randomize EX Boss Counters

		RareBossChance = 15;
		HellMarkFrags = 0;
		SpecimanFrags = 0;

		EventDataArr[EVENTDATA_FORCED] = -1;
		presetStrongmanCheck(-1,99);//StrongmanCheck
		EventDataArr[EVENTDATA_LASTEVENT] = -1;
		RareLMSRune = 45;
		rareLMSTime = 9;
		StartUpVariables = true;
	}
	ACS_NamedExecute("ub_RefreshHudMessageLoop", 0);
	ACS_NamedExecute("uh_BackgroundTimer", 0);
}



#library "unholy"
#include "zcommon.acs"

// Avoid compact bytecode's 256-function limit; this round-core library is near capacity.
#nocompact

#import "uh_acsutils.acs"
#import "uh_log.acs"
#import "uhdt.acs"
// Do NOT #import "8BDT.acs" here: ACC identifiers are case-insensitive, so
// 8bdt and uhdt both define getItemName/getItemActor and a module importing
// both fails to compile (v6b's compiled CORE8BDT.o pins the 8bdt names).
// uh_StripSurvivorWeps reads DTADD rows via uh_GetDTADDWepActor_S in UH_TOOLS
// (the only UH library importing 8BDT) — see systems/tools/dtadd_query.acs.

// LMS round-core module.  Single library (LOADACS entry "unholy"); the
// fragments below map to responsibility clusters and are included in
// dependency order: the unit state header and shared function drawer first.
#include "uh_def.acs"
#include "uh_funclib.acs"
// Client display snapshot + TLMS-style teammate bar + scoreboard icon refresh.
// Depends on the broadcast helpers in uh_funclib (round helpers), so it follows
// that include.  Unholy-only: it defines scripts, so it must never be pulled
// into the shared funclib used by rz_debug.
#include "uh_teaminfo.acs"
#include "uh_aspect.acs"
#include "uh_music.acs"
#include "uh_display.acs"
// Round event system (ex-uh_bonus).
#include "uh_events.acs"
// Boss morph/HP core, then arena-wide specials.
#include "uh_bosscore.acs"
#include "uh_arena_fx.acs"
// SakikoTogawa / Ave Mujica class lifecycle.
#include "sakiko_mujica.acs"
// Clownpiece-only spell-card flow (sole caller: Clownpiece_W.dec).
#include "clownpiece_spellcard.acs"
// Round lifecycle: LMS enter/respawn, life status, startup, countdown,
// background timer, survivor/boss watchers.
#include "uh_lifecycle.acs"
// Boss selection & morphing round flow.
#include "uh_bossselect.acs"
// Boss-vs-boss versus event watcher (forced combo 207).
#include "uh_versus.acs"
// Dickhead self-revival mechanic.
#include "uh_dickhead_revival.acs"
// Named-script API surface used by other libraries (e.g. pharaoh_mmsf).
#include "uh_access.acs"

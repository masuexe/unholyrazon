//Scripts related to boss morphing
script "ub_CountdownStartup" OPEN {
  if (GetCvar("lastmanstanding") == 0) {
    terminate;
  }
  while (PlayerCount() <= 1) {
    Delay(1);
  }


  if (GetGameModeState() == 1 || GetGameModeState() == 0) {

		// ACS_NamedExecute("ub_AttemptSoundFollowFix",0);

    int ued = CheckClearCvar("uh_sv_BonusEventDelay", -1);
    if (ued >= 0 && event_data_arr[EVENTDATA_DELAY] != 77) {  //Sets EventDelay if forced
      event_data_arr[EVENTDATA_DELAY] = ued;
      ShowMeTheRCON("Bonus Event Delay", ued);
    }
    Delay(11);

    if (!GetCVAR("uh_sv_NoItems")) {
      GiveMeTheFunc("SurvivorBoxItems_P", 1);  //Give Pre-Round Items
    }

    SetHudSize(480, 360, 0);
    SetFont("BIGFONT");
    if (event_data_arr[EVENTDATA_DELAY] >= 8) {
      ACS_NamedExecute("ub_EventManagementACS", 0, -2);
      Delay(20);
      AmbientSound("misc/BonusTime", 127);
      HudMessageBold(s:"\c[MenuYellow]The ", s:bonus_event_list[event_data_arr[EVENTDATA_MAINEVENT]][BONUS_EVENTNAME], s:"\c[MenuYellow] event is about to happen!"; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 36.0, 20.0, 2.0);
    }
    else {
      HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0, 2.0);
    }

    Delay(20);
    terminate;
  }

	//Delay(5);

  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 0.5, 2.0);

  SetPlayerProperty(1, 1, 4);
  Delay(35 * 1);
  if (event_data_arr[EVENTDATA_DELAY] >= 8) {
    ACS_NamedExecute("ub_EventManagementACS", 0, -1);  //Select the event!
  }
  else {
    ACS_NamedExecute("ub_SelectBossAndEvent", 0);  //Select the bosses!
  }
}

//This is a basic countdown timer, lasts X time. After X time, attempt to end the round.
script "uh_BackgroundTimer" (void)  //OPEN
{
  int death_chance = random(1, 4);

  int time_left = getCVar("uh_sv_gametimer");
  if (time_left > 0)
    time_left += 10;
  else
    time_left = -6;
  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  until (time_left <= 0 || gameover) {  //Countdown
		//HudMessageBold(d:TimeLeft; HUDMSG_FADEOUT, 888, CR_DARKGREEN,0.5, 0.10, 3.0,2.0);
		//Log(d:TimeLeft);
    if (GetCVar("UE_TimerEnd") != 0) {
      if (GetCVar("UE_TimerEnd") < 0 || GetCVar("UE_TimerEnd") > 4) {
        CheckClearCvar("UE_TimerEnd", 0);
        HudMessageBold(s:"\cf*NOTICE* \ckThe timer was disabled! \cf*NOTICE*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
      }
      time_left = -6;
      break;
    }
    if (time_left == 66) {
      HudMessageBold(s:"\cg*WARNING* \crOne minute until time is up! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
    }
    int timer_type = getCVar("uh_sv_timertype");
    switch (timer_type) {
      case 0:
      default:
        break;
      case 1:
        if (time_left <= 66) {
          ACS_NamedExecuteWithResult("uh_DrawTimerHud", time_left, 1);
        }
        break;
      case 2:
        ACS_NamedExecuteWithResult("uh_DrawTimerHud", time_left, 1);
        break;
    }

    Delay(35);
    time_left--;
  }
  while (time_left < 0 && !gameover) {  //If Timer is disabled
    if (GetCVar("UE_TimerEnd") != 0) {
      death_chance = CheckClearCvar("UE_TimerEnd", 0);
      if (death_chance >= 0 && death_chance <= 4) {
        AmbientSound("misc/mmpuwarning", 127);
        HudMessageBold(s:"\cg*WARNING* \crThe round was forced to end! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
        Delay(35 * 6);
        break;
      }
    }
    Delay(35);
  }
  if (gameover) {  //Games over, clear messages
    ClearHudMessageBold(610);
    terminate;
  }
  switch (death_chance) {
    case 1:  //SuperGuhu
      GiveMeTheFunc("SGEXDItem", 1);
      break;
    case 2:  //Zankokuna
      ACS_NamedTerminate("uh_ZankokunaRage", 0);
      ACS_NamedExecute("uh_ZankokunaRage", 0);
      break;
    case 3:  //InstaKill
      SpawnForced("WishingStar_Help1_Server", 0, 0, 0);
      break;
    case 4:  //Exe
      SpawnForced("WishingStar_Help2_Server", 0, 0, 0);
      break;
    case 5:  //Reset
      SpawnForced("WishingStar_Help3_Server", 0, 0, 0);
      break;
  }
}



script "ub_SelectBossAndEvent" (void) {
//This makes specific bosses/events happen
  MultiBossFunction(1);
  SetUpBossSelectionFunc();

  ACS_NamedExecute("ub_MorphSelectedBosses", 0);  //Begin the morphing!
}

//This is the main script for managing who becomes the boss, as well as morphing them.
script "ub_MorphSelectedBosses" (void) {
  Delay(1);  //Wait a tic so the engine processes boss selection script

  SetUpPlayerSelectionFunc();

  total_players_arr[PLS_SURVIVOR] -= multi_boss_check;
  total_players_arr[PLS_BOSS] += multi_boss_check;

  if (shadow_fakeout_active) {
    ACS_NamedExecute("ub_ShadowBossManager", 0);
  }  //End of Shadowman

	//Morphing area
  for (int i = 0; i < multi_boss_check; i++) {
    boss_data_arr[i][BOSSDATA_MORPHED] = MorphActorToBoss(boss_data_arr[i][BOSSDATA_TID], boss_data_arr[i][BOSSDATA_NUM], "GigaAstroExplode");
    DebugLog(strParam(s:"Morphed Boss ", i:i + 1, s:": ", i:boss_data_arr[i][BOSSDATA_MORPHED]));
  }

	//Musical setting
  ACS_NamedExecute("ub_PlayVariantMusic", 0, boss_data_arr[random(0, multi_boss_check - 1)][BOSSDATA_NUM]);

  GiveMeTheFuncExceptBosses("BasicSurvivorItem", 0);
  SetPlayerProperty(1, 0, 4);  //Allows players to move.
  ACS_NamedExecuteWait("ub_BossMorphRetryWait", 0, -1);

  ACS_NamedExecute("ub_WatchSurvivors", 0);
  Delay(1);

  int temp_boss1 = boss_data_arr[0][BOSSDATA_NUM];

  if (!GetCVAR("uh_sv_NoItems")) {
    GiveMeTheFuncExceptBosses("SurvivorBoxItems_P", 1);  //Give Items
  }
}

script "ub_BossMorphRetryWait" (int failure, int failure2, int failure3, int failure4) {
  int i;
  int morph_retry_count = 0;
  while (morph_retry_count <= 70) {
    bool morphing_success = true;

    for (i = 0; i < multi_boss_check; i++) {
      if (!boss_data_arr[i][BOSSDATA_MORPHED])
        morphing_success = false;
    }
    if (morphing_success)
      break;
    for (i = 0; i < multi_boss_check; i++) {
      if (!boss_data_arr[i][BOSSDATA_MORPHED])
        boss_data_arr[i][BOSSDATA_MORPHED] = MorphActorToBoss(boss_data_arr[i][BOSSDATA_TID], boss_data_arr[i][BOSSDATA_NUM], "GigaAstroExplode");
    }
    Delay(1);
    morph_retry_count++;
  }
  if (morph_retry_count >= 70) {
    ACS_NamedExecute("ub_MorphFailureFallback", 0, failure);
		//Football Time
  }

  if (failure == -1)
    DebugLog(strParam(s:"Boss Morph FINISHED! --- Retry count = ", i:morph_retry_count));
  if (failure == 0)
    DebugLog(strParam(s:"Shadow Morph FINISHED! --- Retry count = ", i:morph_retry_count));
}

script "ub_MorphFailureFallback" (int jump) {
  bool hail_mary = false;
  switch (jump) {
    case -1:
      hail_mary = true;
      break;
    case 0:
      if (gameover) {terminate;}

      for (int i = 0; i < multi_boss_check; i++)
        if (shadow_tricks_arr[i])
          if (ThingCount(0, boss_data_arr[i][BOSSDATA_TID]) == 0)
            hail_mary = true;

      break;
  }

  if (hail_mary) {  //Log(s:"Special Left!");// Terminate;}

    ACS_NamedTerminate("ub_WatchSurvivors", 0);
    ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
    SetHudSize(640, 480, 0);
    SetFont("BIGFONT");
    HudMessageBold(s:"OH NO, a boss morph failed! ITS TIME FOR \csFOOTBALL\c-!"; HUDMSG_FADEOUT, 51, CR_YELLOW, 320.4, 416.2, 5.0, 0.2);  //432.2
    PlayMusic(bonus_event_list[13][BONUS_MUSICLUMP]);
    MusicCredits(bonus_event_list[13][BONUS_MUSICCREDITS], 0);

    GiveMeTheFunc("TheFootBallItemX", 1);

    standardlmseventlocked = true;
  }
}

script "ub_UnMorphThisTID" (int w) {
  SetActivator(w);
  ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false);
  UnMorphActor(w, 1);
  ACS_NamedExecuteWithResult("uh_MorphDemorphReset");
}

script "ub_TestShadowBoss" (int tid, int boss_id) {
  Delay(1);
  ACS_NamedExecuteAlways("ub_UnMorphThisTID", 0, tid);
  Delay(1);
  ClearActorInventory(tid);
  GiveActorInventory(tid, "ShadowPreRoundStart", 1);
  Delay(35 * 5);
  GiveActorInventory(tid, "ShadowPreRoundEnd", 1);
  MorphActorToBoss(tid, boss_id, "GigaAstroExplode");
}

script "ub_ShadowBossManager" (void) {
  SetActivator(0, AAPTR_NULL);

  int delay_shad = 0;
  until (delay_shad >= 10) {  //Bot checks are needed because they can cause crashes through this script.
    bool ninja_exists = false;
    for (int i = 0; i < multi_boss_check; i++) {
      if (shadow_tricks_arr[i]) {
        if (ThingCount(0, boss_data_arr[i][BOSSDATA_TID]) == 0 || PlayerIsBot(boss_data_arr[i][BOSSDATA_TID] - 1000))
          shadow_tricks_arr[i] = false;
        else
          ninja_exists = true;
      }
    }
    if (!ninja_exists)
      terminate;
    Delay(35 * 1);
    delay_shad++;
  }

	//If(shadowFakeoutActive){
	//	GiveActorInventory(669,"PURPLEPOTIONITEM",2);
	//	ACS_Terminate(836,0);
	//	////////////shadowFakeoutActive=false;
	//}
	//else {
	//Delay(35*8);}
	//if(ThingCount(0,666)==0) {Terminate;}//Prevent Shadowman from spawning in multibosses if the leader is dead
	////////////SetActivator(666);

	//
  DebugLog(strParam(s:"Begin shadow fakeout"));

  MusicSaveFunc();
  PlayMusic("");
  MusicCredits("Something is lurking", 1);

  AmbientSound("misc/devildeath", 127);

  ClearHudMessage(166);  //Timer
  ClearHudMessage(167);  //Timer
  ClearHudMessage(59);  //Boss Weapon Info

  shadow_reveal_active = true;

  int temp_boss;
  for (i = 0; i < multi_boss_check; i++) {

    if (shadow_tricks_arr[i]) {
      ClearHudMessage(91 + i);  //Boss Healths
      ACS_NamedExecuteAlways("ub_UnMorphThisTID", 0, boss_data_arr[i][BOSSDATA_TID]);

      temp_boss = ForceBossChange(strparam(s:"uh_sv_ForcedShadowBoss", i:i + 1), false);
			//ShowMeTheRCON("Shadow Boss",TempBoss);
      if (temp_boss == UHBOSS_FAIL) {
        if (RandomPercent(5))
          temp_boss = boss_data_arr[i][BOSSDATA_NUM];  //No Change
				// else if(RandomPercent(40))
				// 	TempBoss = 301;//AbePenny
				// else if(RandomPercent(55))
				// 	TempBoss = random(303,305);
        else
          temp_boss = TrueRandomBoss();
      }
      boss_data_arr[i][BOSSDATA_MORPHED] = temp_boss;  //Borrow this Array
    }
  }

  Delay(1);  //Delay needed otherwise unmorph doesn't happen correctly

  for (i = 0; i < multi_boss_check; i++) {
    if (shadow_tricks_arr[i]) {
      ClearActorInventory(boss_data_arr[i][BOSSDATA_TID]);
      GiveActorInventory(boss_data_arr[i][BOSSDATA_TID], "ShadowPreRoundStart", 1);
    }
  }

  Delay(35 * 2);

	//NEW#BOSS
	//if(ShadowTricksArr[0] && UnholyBoss1 == 300){ UnholyBoss1 = random(100,BOSSRNGMAX_100_199); }

	//	If(shadowFakeoutActive){
	//		MusicCredits("Super Mario Sunshine - Shadow Mario (Sped-up)",0);
	//		PlayMusic("SHADSHAD");
	//		shadowFakeoutActive = false;
	//	}
	//	break;

	//If(shadowFakeoutActive){
	//	Delay(35*2);
	//	AmbientSound("items/GoldTank",127);
	//	GiveActorInventory(669,"PTankItem",1);
	//	GiveActorInventory(669,"PowerSTank",1);
	//	GiveActorInventory(669,"SpeedTrailofEnvy",1);
	//	SetActorProperty(669, APROP_JumpZ, 15.0);
	//	SetActorProperty(669, APROP_SPEED, 1.25);
	//	Delay(35*3);
	//	//shadowFakeoutActive=false;
	//}
	//else {Delay(35*5);}

  Delay(35 * 3);
  DebugLog(strParam(s:"Shadow Delay is over"));

  int shadow_tunes_num = -1;

  for (i = 0; i < multi_boss_check; i++) {
    if (shadow_tricks_arr[i]) {
      if (PlayerInGame(boss_data_arr[i][BOSSDATA_TID] - 1000)) {
        GiveActorInventory(boss_data_arr[i][BOSSDATA_TID], "ShadowPreRoundEnd", 1);
        boss_data_arr[i][BOSSDATA_NUM] = boss_data_arr[i][BOSSDATA_MORPHED];  //Use borrowed Array
        boss_data_arr[i][BOSSDATA_MORPHED] = MorphActorToBoss(boss_data_arr[i][BOSSDATA_TID], boss_data_arr[i][BOSSDATA_NUM], "GigaAstroExplode");
        if (shadow_tunes_num == -1)
          shadow_tunes_num = boss_data_arr[i][BOSSDATA_NUM];
      }
      else {shadow_tricks_arr[i] = false;}
    }
  }

  if (shadow_tunes_num == -1) {
    PlayMusic(musical_event_index[8][0]);
    MusicCredits(musical_event_index[8][1], 0);
  }
  else {
    ACS_NamedExecute("ub_PlayVariantMusic", 0, shadow_tunes_num);
  }

  Delay(1);

  ACS_NamedExecuteWait("ub_BossMorphRetryWait", 0, 0);

  shadow_reveal_active = false;
  refresh_hud_message = true;
	//ACS_Execute(WATCHER_BOSS_HP,0,0);
}

//Script used to end the round for no survivors
script "ub_WatchSurvivors" (int skip_acs) {

  Delay(1);  //Important! Otherwise the BossDataArr[][] isn't set correctly from another script!

  if (!skip_acs) {
    ACS_NamedExecute("ub_BossHealthWatcher", 0);
    ACS_NamedExecute("ub_DemoneyeNumWatcher", 0);  //Does this fix Boss VS??
	// 	if(VersusFightEvent){
	// 		ACS_NamedExecute("ub_ManageBossVsBossEvent",0);
	// 		terminate;
	// 	}
    ACS_NamedExecute("ub_WatchBossesAndEyes", 0);
  }

  while (total_players_arr[PLS_SURVIVOR] >= 1 && !standardlmseventlocked && !gameover) {
    Delay(1);
    if (total_players_arr[PLS_SURVIVOR] == 1) {
      ACS_NamedExecute("ub_LMS_EventTime", 0, -1);
      DebugLog(strParam(s:"Last Man Standing!"));
      standardlmseventlocked = true;
    }
  }

  while (total_players_arr[PLS_SURVIVOR] >= 1 && !gameover) {
    Delay(1);
  }

  if (gameover) {terminate;}

  Delay(1);

  ACS_NamedTerminate("ub_WatchBossesAndEyes", 0);
	//PlayMusic_Loss(0);
  PlayMusicLoser(-1);
	// MakeAllPlayersInvun();
  gameover = true;

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);
  HudMessageBold(s:"The survivors have been defeated..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 5.0, 2.0);

  surv_win_with_lms = false;
  Delay(35 * 9);
  Exit_Normal(0);
  Delay(35 * 6);
}

//The LMS script
script "ub_LMS_EventTime" (int lms_num, int force_rare) {
  bool rare_item_check = false;
  int the_rune_number = -1;
  int the_rune_number_x = -1;
  int mus_row;
  int dual_rune;

  int lms_count = 0;
  until (lms_count == 64) {  //Find the lone survivor!
    if (player_life_status_arr[lms_count] == PLS_SURVIVOR) {
      the_lms_dude = lms_count + 1000;  //Record the player number!
      break;
    }
    lms_count++;
  }

  Delay(1);

  int lms_cvar = CheckClearCvar("uh_sv_LMSEvent", -1);
  if (lms_cvar >= 0 && IsLMSEventDefined(lms_cvar)) {
    lms_num = lms_cvar;
    ShowMeTheRCON("The LMS Event", lms_cvar);
  }
  else if (!IsLMSEventDefined(lms_num)) {
    lms_num = PickLMSEvent();
    if (lms_num == UHLMS_FAIL)
      terminate;
  }

  if (RandomPercent(rare_lms_rune)) {  //
    the_rune_number = RandomRune(RANDRUNE_RARE);
    rare_lms_rune = 10;
  }
  else {
    the_rune_number = RandomRune(RANDRUNE_COMMON);
    rare_lms_rune += random(2, 6);
  }

  if (random(rare_lms_time, 20) >= 20 || force_rare == 7) {
    rare_lms_time = 0;
    rare_item_check = true;
  }
  else {
    rare_lms_time++;
  }

  dual_rune = (GetLMSEventFlags(lms_num) & UHLMS_FLAG_DUALRUNE) != 0;
  if (dual_rune) {
    do {
      if (rare_item_check) {
        the_rune_number_x = RandomRune(RANDRUNE_RARE);
      }
      else {
        the_rune_number_x = RandomRune(RANDRUNE_COMMON);
      }
    } while (the_rune_number == the_rune_number_x);
  }


  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);

  str the_rune_str = StrParam(s:"\c- got a ", s:rune_of_the_day[the_rune_number]);
  if (dual_rune) {
    the_rune_str = StrParam(s:the_rune_str, s:" & ", s:rune_of_the_day[the_rune_number_x], s:" Rune!\n");
  }
  else {
    the_rune_str = StrParam(s:the_rune_str, s:" Rune!\n");
  }

  str item_message;
  if (rare_item_check) {item_message = GetLMSEventraremessage(lms_num);}
  else {item_message = GetLMSEventMessage(lms_num);}

  HudMessageBold(n:the_lms_dude - 999, s:the_rune_str, s:item_message; HUDMSG_FADEOUT | HUDMSG_LOG, 70, CR_YELLOW, 320.4, 336.2, 1.8, 0.2);  //396.2

  ACS_NamedExecuteAlways("ub_LMS_EventIconStart", 0, lms_num, rare_item_check);  //4836

  mus_row = PickEventMusicRow(UHMUS_KIND_LMS, lms_num);
  if (mus_row >= 0) {
    PlayMusic(GetBossMusicLumpByRow(mus_row));
    MusicCredits(GetBossMusicCreditByRow(mus_row), 0);
  }
  else if (lms_num >= 0 && lms_num <= 11) {
    PlayMusic(lms_list_array[lms_num][LMS_MUSICLUMP]);
    MusicCredits(lms_list_array[lms_num][LMS_MUSICCREDITS], 0);
  }
  surv_win_with_lms = true;

  while (CheckActorInventory(the_lms_dude, "IsBlessedWithLMSPower") == 0) {

		//Failsafe for a player not getting the LMS
    GiveActorInventory(the_lms_dude, "IsBlessedWithLMSPower", 1);

    if (the_rune_number == RUNE_DRAIN || the_rune_number_x == RUNE_DRAIN && CheckActorInventory(the_lms_dude, "PowerPeriwinkleDrain") >= 1) {  //Drain
      TakeActorInventory(the_lms_dude, "PowerPeriwinkleDrain", 99);  //Prevent Ptanks from conflicting with drain rune!
    }
    if (the_rune_number == RUNE_RESISTANCE || the_rune_number_x == RUNE_RESISTANCE) {  //Resistance
      GiveActorInventory(the_lms_dude, "AutoHamburgerFoodItem", 1);  //Force 2000 healing on player
    }

		// GiveActorInventory(TheLMSDude,StrParam(s:RuneOfTheDay[TheRuneNumber],s:"Rune_ST"),1);
    ACS_NamedExecuteWithResult("uh_runeplayer", the_lms_dude - 999, 1, the_rune_number);
    if (dual_rune) {ACS_NamedExecuteWithResult("uh_runeplayer", the_lms_dude - 999, 1, the_rune_number_x);}

    if (the_rune_number == 0 || the_rune_number_x == 0) {  //Prosperity
      GiveActorInventory(the_lms_dude, "AutoSundaeFoodItem", 1);
      if (RandomPercent(15)) {GiveActorInventory(the_lms_dude, "MysticBoxItem", 1);}
      else {GiveActorInventory(the_lms_dude, "PandoraBoxItem", 2);}
    }

    GrantLMSEventDrops(the_lms_dude, lms_num, rare_item_check);

    for (int i = 0; i < 35; i++) {
      if (!PlayerInGame(the_lms_dude - 1000) ||
         CheckActorInventory(the_lms_dude, "IsDead") ||
         CheckActorInventory(the_lms_dude, "IsBlessedWithLMSPower"))
        break;
      Delay(2);
    }
  }  //While End
}

// Checks if all bosses are dead
script "ub_WatchBossesAndEyes" (void) {
  int extra_timer = Timer();
  while (total_players_arr[PLS_BOSS] >= 1 || total_players_arr[PLS_EYE] >= 1) {
    if (gameover) {terminate;}
    Delay(2);
  }

  if (gameover) {terminate;}

  GiveMeTheFunc("PowerProtectSurvivor", -1);
  GiveMeTheFunc("PowerProtectMegaCopywep", -1);
  GiveMeTheFunc("PowerProtectUnholyItem", -1);

  ACS_NamedTerminate("ub_WatchSurvivors", 0);
  gameover = true;
	//Log(i:PlayerInGame(BossDataArr[0][BOSSDATA_TID]-1000));

  SetFont("BIGFONT");
  SetHudSize(480, 360, 0);

  if (multi_boss_check == 1 && !PlayerInGame(boss_data_arr[0][BOSSDATA_TID] - 1000) && timer() <= 35 * 7 + extra_timer) {
    PlayMusicWin(-2);
    HudMessageBold(s:"The boss has declined the duel!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);
    Delay(36 * 4);
    Exit_Normal(0);
    Delay(35);
    terminate;
  }
	//PlayMusic_Win(0);
  PlayMusicWinner(-1);
  HudMessageBold(s:"The survivors are victorious!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);

  if (surv_win_with_lms) {
    hell_mark_frags++;
    if (hell_mark_frags >= 10) {
      AmbientSound("misc/SampiRises", 127);
      HudMessageBold(s:"The Helltatoru knows no limits..."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 402);
    }
    else
      HudMessageBold(s:"Marks of Helltatoru ", d:hell_mark_frags, s:"/10 collected."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
  }
  Delay(36 * 10);
  Exit_Normal(0);
  Delay(36 * 6);
}

// script "uh_ChangeTeam" (int team) {
// 	player_SetTeam(team, true);
// }

function void DickheadDoRevive(int self_tid, int revived_tid, int isbossrevival, int bossslot) {
  int dropx;
  int dropy;
  int dropz;
  int pn;
  int boss_num;

  pn = revived_tid - 1000;
  dropx = GetActorX(self_tid);
  dropy = GetActorY(self_tid);
  dropz = GetActorZ(self_tid);

  if (isbossrevival) {
    boss_num = bossslot;
    boss_data_arr[boss_num][BOSSDATA_MORPHED] = MorphActorToBoss(boss_data_arr[boss_num][BOSSDATA_TID], boss_data_arr[boss_num][BOSSDATA_NUM], "GigaAstroExplode");
    PlayerLifeStatusArrUpdateFunc(pn, PLS_BOSS);
    boss_slot_alive[boss_num] = true;
  }
  else
    PlayerLifeStatusArrUpdateFunc(pn, PLS_SURVIVOR);

  SetActorPosition(revived_tid, dropx, dropy, dropz + 32.0, false);

  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  HudMessageBold(n:pn + 1, s:" \cvhas been revived!"; HUDMSG_FADEOUT | HUDMSG_LOG, 49, CR_YELLOW, 320.4, 464.2, 1.8, 0.2);
  SetActorState(self_tid, "UsedUp", 0);
}

script "rz_DickheadRevival" (void) {
  int isbossrevival;
  int revived_tid;
  int i;
  int j;
  int pn;
  int deadplayertidlist[MAX_PLAYERS];
  int deadsurvivorcount;
  int deadbosstidlist[MAX_BOSSES][2];
  int deadbosscount;
  int morphbossnum;
  int slot;
  int isboss;
  int waittics;
  int self_tid;
  int owner_is_a_boss;

  self_tid = ActivatorTID();
  if (self_tid == 0) {
    self_tid = UniqueTID();
    Thing_ChangeTID(0, self_tid);
  }

  owner_is_a_boss = 0;
  if (SetActivator(0, AAPTR_TARGET))
    owner_is_a_boss = CheckInventory("Is_UH_BossNum");
  SetActivator(self_tid);

  revived_tid = 0;
  isbossrevival = 0;
  deadsurvivorcount = 0;
  deadbosscount = 0;
  slot = 0;

  if (total_players_arr[PLS_DEAD] != 0) {
    revivingqueue++;
    waittics = revivingqueue - 1;
    if (waittics > 0)
      Delay(waittics);

    ShuffleRevivalPlayerOrder();
    for (i = 0; i < MAX_PLAYERS; i++) {
      pn = revivalplayerorder[i];
      if (PlayerIsSpectator(pn) != 2)
        continue;

      isboss = 0;
      morphbossnum = 0;
      for (j = 0; j < multi_boss_check; j++) {
        if (pn + 1000 == boss_data_arr[j][BOSSDATA_TID]) {
          isboss = 1;
          morphbossnum = j;
          break;
        }
      }
      if (isboss) {
        deadbosstidlist[deadbosscount][0] = pn + 1000;
        deadbosstidlist[deadbosscount][1] = morphbossnum;
        deadbosscount++;
      }
      deadplayertidlist[deadsurvivorcount] = pn + 1000;
      deadsurvivorcount++;
      break;
    }

    if (owner_is_a_boss && deadbosscount > 0) {
      slot = random(0, deadbosscount - 1);
      revived_tid = deadbosstidlist[slot][0];
      isbossrevival = 1;
    }
    else if (deadsurvivorcount > 0) {
      revived_tid = deadplayertidlist[random(0, deadsurvivorcount - 1)];
      for (j = 0; j < multi_boss_check; j++) {
        if (revived_tid == boss_data_arr[j][BOSSDATA_TID]) {
          isbossrevival = 1;
          slot = j;
          deadbosstidlist[slot][1] = j;
          break;
        }
      }
    }

    DebugLog(strParam(s:"rz_DickheadRevival revived_tid=", i:revived_tid));
    if (revived_tid != 0) {
      ChangeActorFlag(self_tid, "SPECIAL", false);
      SpawnForced("DickheadReviveBoom", GetActorX(self_tid), GetActorY(self_tid), GetActorZ(self_tid));
      SetDeadSpectator(revived_tid - 1000, 0);
      Delay(2);
      DickheadDoRevive(self_tid, revived_tid, isbossrevival, slot);
      revivingqueue--;
      terminate;
    }
    revivingqueue--;

    for (i = 0; i < MAX_PLAYERS; i++) {
      pn = revivalplayerorder[i];
      if (player_life_status_arr[pn] != PLS_DEAD)
        continue;
      SetActorState(self_tid, "BecomePickup", 0);
      SetActivator(self_tid);
      ACS_NamedExecuteAlways("rz_DickheadRevivalDelayed", 0, pn, self_tid);
      terminate;
    }
  }

  SetActorState(self_tid, "BecomePickup", 0);
  DickheadWatchAdd(self_tid);
}

script "rz_DickheadWatchDeath" (int dead_pn) {
  int self_tid;

  if (dickheadwatchcount <= 0)
    terminate;

  self_tid = DickheadWatchClaim();
  if (self_tid == 0)
    terminate;

  SetActivator(self_tid);
  ACS_NamedExecuteAlways("rz_DickheadRevivalDelayed", 0, dead_pn, self_tid);
}

script "rz_DickheadRevivalDelayed" (int dead_pn, int self_tid) {
  int revived_tid;
  int isbossrevival;
  int bossslot;
  int waittics;
  int j;

  SetActivator(self_tid);
  Delay(DICKHEAD_REVIVE_DELAY);

  if (ClassifyActor(self_tid) == ACTOR_NONE)
    terminate;

  if (PlayerIsSpectator(dead_pn) != 2) {
    DickheadWatchAdd(self_tid);
    terminate;
  }

  revived_tid = dead_pn + 1000;
  isbossrevival = 0;
  bossslot = 0;
  for (j = 0; j < multi_boss_check; j++) {
    if (revived_tid == boss_data_arr[j][BOSSDATA_TID]) {
      isbossrevival = 1;
      bossslot = j;
      break;
    }
  }

  revivingqueue++;
  waittics = revivingqueue - 1;
  if (waittics > 0)
    Delay(waittics);

  ChangeActorFlag(self_tid, "SPECIAL", false);
  SpawnForced("DickheadReviveBoom", GetActorX(self_tid), GetActorY(self_tid), GetActorZ(self_tid));
  SetDeadSpectator(dead_pn, 0);
  Delay(2);
  DickheadDoRevive(self_tid, revived_tid, isbossrevival, bossslot);
  revivingqueue--;
}

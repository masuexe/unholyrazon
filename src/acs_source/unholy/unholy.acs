//Scripts related to boss morphing
Script "ub_CountdownStartup" OPEN
{
	if(GetCvar("lastmanstanding")==0){
		terminate;
	}
	while(PlayerCount()<=1){
		Delay(1);
	}


	if(GetGameModeState()==1||GetGameModeState()==0){

		// ACS_NamedExecute("ub_AttemptSoundFollowFix",0);

		int UED = CheckClearCvar("uh_sv_BonusEventDelay",-1);
		if(UED >= 0 && EventDataArr[EVENTDATA_DELAY] != 77){//Sets EventDelay if forced
			EventDataArr[EVENTDATA_DELAY] = UED;
			ShowMeTheRCON("Bonus Event Delay", UED);
		}
		Delay(11);

		if(!GetCVAR("uh_sv_NoItems")){
			GiveMeTheFunc("SurvivorBoxItems_P", 1);//Give Pre-Round Items
		}

		SetHudSize(480,360,0);
		SetFont("BIGFONT");
		if(EventDataArr[EVENTDATA_DELAY] >= 8){
			ACS_NamedExecute("ub_EventManagementACS",0,-2);
			Delay(20);
			AmbientSound("misc/BonusTime",127);
			HudMessageBold(s: "\c[MenuYellow]The ", s: bonusEventList[EventDataArr[EVENTDATA_MAINEVENT]][BONUS_EVENTNAME], s: "\c[MenuYellow] event is about to happen!"; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 36.0, 20.0,2.0);
		}
		else {
			HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0,2.0);
		}		
		
		Delay(20);
		terminate;
	}

	//Delay(5);

	SetHudSize(480,360,0);
	SetFont("BIGFONT");
	HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 0.5,2.0);

	SetPlayerProperty(1,1,4);
	Delay(35*1);
	if(EventDataArr[EVENTDATA_DELAY] >= 8){
		ACS_NamedExecute("ub_EventManagementACS",0,-1);//Select the event!
	}
	else{
		ACS_NamedExecute("ub_SelectBossAndEvent",0);//Select the bosses!
	}
}

//This is a basic countdown timer, lasts X time. After X time, attempt to end the round.
script "uh_BackgroundTimer" (void)//OPEN
{
	int deathChance = random(1, 4);

	int timeLeft = getCVar("uh_sv_gametimer");
	if(TimeLeft>0)
		TimeLeft += 10;
	else
		TimeLeft = -6;
	SetFont("BIGFONT");
	SetHudSize(640,480,0);
	Until (TimeLeft <= 0 || Gameover) {//Countdown
		//HudMessageBold(d:TimeLeft; HUDMSG_FADEOUT, 888, CR_DARKGREEN,0.5, 0.10, 3.0,2.0);
		//Log(d:TimeLeft);
		if (GetCVar("UE_TimerEnd") != 0) {
			if(GetCVar("UE_TimerEnd") < 0 || GetCVar("UE_TimerEnd") > 4){
				CheckClearCvar("UE_TimerEnd",0);
				HudMessageBold(s:"\cf*NOTICE* \ckThe timer was disabled! \cf*NOTICE*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
			}
			TimeLeft = -6;
			break;
		}
		if(TimeLeft == 66){
			HudMessageBold(s:"\cg*WARNING* \crOne minute until time is up! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
		}
		int timerType = getCVar("uh_sv_timertype");
		switch (timerType) {
			case 0:
			default:
				break;
			case 1:
				if (TimeLeft <= 66) {
					ACS_NamedExecuteWithResult("uh_DrawTimerHud", TimeLeft, 1);
				}
				break;
			case 2:
				ACS_NamedExecuteWithResult("uh_DrawTimerHud", TimeLeft, 1);
				break;
		}
		
		Delay(35);
		TimeLeft--;
	}
	While (TimeLeft < 0 && !Gameover) {//If Timer is disabled
		if (GetCVar("UE_TimerEnd") != 0) {
			DeathChance = CheckClearCvar("UE_TimerEnd",0);
			if(DeathChance >= 0 && DeathChance <= 4){
				AmbientSound("misc/mmpuwarning",127);
				HudMessageBold(s:"\cg*WARNING* \crThe round was forced to end! \cg*WARNING*"; HUDMSG_FADEOUT, 610, CR_DARKRED, 320.4, 24.2, 7.0, 2.0);
				Delay(35*6);
				break;
			}
		}
		Delay(35);
	}
	if(Gameover){//Games over, clear messages
		ClearHudMessageBold(610);
		terminate;
	}
	Switch(DeathChance){
		Case 1://SuperGuhu
			GiveMeTheFunc("SGEXDItem",1);
			break;
		Case 2://Zankokuna
			ACS_NamedTerminate("uh_ZankokunaRage", 0);
			ACS_NamedExecute("uh_ZankokunaRage", 0);
			break;
		Case 3://InstaKill
			SpawnForced("WishingStar_Help1_Server",0,0,0);
			break;
		Case 4://Exe
			SpawnForced("WishingStar_Help2_Server",0,0,0);
			break;
		Case 5://Reset
			SpawnForced("WishingStar_Help3_Server",0,0,0);
			break;
	}
}



Script "ub_SelectBossAndEvent" (void)
{
//This makes specific bosses/events happen
	multiBossFunction(1);
	setUpBossSelection_Func();

	ACS_NamedExecute("ub_MorphSelectedBosses", 0);//Begin the morphing!
}

//This is the main script for managing who becomes the boss, as well as morphing them.
Script "ub_MorphSelectedBosses" (void)
{
	Delay(1);//Wait a tic so the engine processes boss selection script

	setUpPlayerSelection_Func();

	totalPlayersArr[PLS_SURVIVOR] -= multiBossCheck;
	totalPlayersArr[PLS_BOSS] += multiBossCheck;

	If(shadowFakeoutActive){
		ACS_NamedExecute("ub_ShadowBossManager",0);
	}//End of Shadowman

	//Morphing area
	for(int i = 0; i < multiBossCheck; i++){
		bossDataArr[i][BOSSDATA_MORPHED] = morphActorToBoss(bossDataArr[i][BOSSDATA_TID], bossDataArr[i][BOSSDATA_NUM], "GigaAstroExplode");
		debugLog(strParam(s: "Morphed Boss ", i: i+1, s: ": ", i: bossDataArr[i][BOSSDATA_MORPHED]));
	}

	//Musical setting
	ACS_NamedExecute("ub_PlayVariantMusic",0,bossDataArr[random(0,MultiBossCheck-1)][BOSSDATA_NUM]);

	giveMeTheFuncExceptBosses("BasicSurvivorItem", 0);
	SetPlayerProperty(1,0,4);//Allows players to move.
	ACS_NamedExecuteWait("ub_BossMorphRetryWait",0,-1);

	ACS_NamedExecute("ub_WatchSurvivors",0);
	Delay(1);

	int TempBoss1 = bossDataArr[0][BOSSDATA_NUM];

	if(!GetCVAR("uh_sv_NoItems")){
		GiveMeTheFuncExceptBosses("SurvivorBoxItems_P", 1);//Give Items
	}
}

Script "ub_BossMorphRetryWait" (int Failure, int Failure2, int Failure3, int Failure4)
{
	int i;
	int MorphRetryCount = 0;
	while(MorphRetryCount <= 70){

		bool MorphingSuccess = true;

		for(i = 0; i < MultiBossCheck; i++){
			if(!BossDataArr[i][BOSSDATA_MORPHED])
				MorphingSuccess = false;
		}
		if(MorphingSuccess)
			break;
		for(i = 0; i < MultiBossCheck; i++){
			if(!BossDataArr[i][BOSSDATA_MORPHED])
				BossDataArr[i][BOSSDATA_MORPHED] = morphActorToBoss(BossDataArr[i][BOSSDATA_TID],BossDataArr[i][BOSSDATA_NUM],"GigaAstroExplode");
		}
		Delay(1);
		MorphRetryCount++;
	}
	if(MorphRetryCount >= 70){
		ACS_NamedExecute("ub_MorphFailureFallback", 0, Failure);
		//Football Time
	}

	if(Failure == -1)
		debugLog(strParam(s:"Boss Morph FINISHED! --- Retry count = ",i:MorphRetryCount));
	if(Failure == 0)
		debugLog(strParam(s:"Shadow Morph FINISHED! --- Retry count = ",i:MorphRetryCount));
}

script "ub_MorphFailureFallback" (int Jump)
{
	bool HailMary = false;
	Switch(Jump)
	{
		Case -1:
			HailMary = true;
			break;
		Case 0:
			if(Gameover){terminate;}

			for(int i = 0; i < MultiBossCheck; i++)
				if(ShadowTricksArr[i])
					if(ThingCount(0,BossDataArr[i][BOSSDATA_TID])==0)
						HailMary = true;

			break;
	}

	if(HailMary) {//Log(s:"Special Left!");// Terminate;}

		ACS_NamedTerminate("ub_WatchSurvivors",0);
		ACS_NamedTerminate("ub_WatchBossesAndEyes",0);
		SetHudSize(640,480,0);
		SetFont("BIGFONT");
		HudMessageBold(s:"OH NO, a boss morph failed! ITS TIME FOR \csFOOTBALL\c-!"; HUDMSG_FADEOUT, 51, CR_YELLOW, 320.4, 416.2, 5.0,0.2);//432.2
		PlayMusic(BonusEventList[13][BONUS_MUSICLUMP]);
		MusicCredits(BonusEventList[13][BONUS_MUSICCREDITS],0);

		GiveMeTheFunc("TheFootBallItemX", 1);

		standardlmseventlocked = true;
	}
}

script "ub_UnMorphThisTID" (int W)
{
	SetActivator(W);
	ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false);
	UnMorphActor(W,1);
	ACS_NamedExecuteWithResult("uh_MorphDemorphReset");
}

Script "ub_TestShadowBoss" (int TID, int BossID)
{
	Delay(1);
	ACS_NamedExecuteAlways("ub_UnMorphThisTID",0,TID);
	Delay(1);
	ClearActorInventory(TID);
	GiveActorInventory(TID,"ShadowPreRoundStart",1);
	Delay(35*5);
	GiveActorInventory(TID,"ShadowPreRoundEnd",1);
	morphActorToBoss(TID,BossID,"GigaAstroExplode");
}

Script "ub_ShadowBossManager" (void)
{
	SetActivator(0,AAPTR_NULL);

	int DelayShad = 0;
	Until (DelayShad >= 10) {//Bot checks are needed because they can cause crashes through this script.
		bool NinjaExists = false;
		for(int i = 0; i < MultiBossCheck; i++){
			if(ShadowTricksArr[i]){
				if(ThingCount(0,BossDataArr[i][BOSSDATA_TID])==0 || PlayerIsBot(BossDataArr[i][BOSSDATA_TID]-1000))
					ShadowTricksArr[i] = false;
				else
					NinjaExists = true;
			}
		}
		if(!NinjaExists)
			terminate;
		Delay(35*1);
		DelayShad++;
	}



	//If(shadowFakeoutActive){
	//	GiveActorInventory(669,"PURPLEPOTIONITEM",2);
	//	ACS_Terminate(836,0);
	//	////////////shadowFakeoutActive=false;
	//}
	//else {
	//Delay(35*8);}
	//if(ThingCount(0,666)==0) {Terminate;}//Prevent Shadowman from spawning in multibosses if the leader is dead
	////////////SetActivator(666);

	//
	debugLog(strParam(s:"Begin shadow fakeout"));

	MusicSaveFunc();
	PlayMusic("");
	MusicCredits("Something is lurking",1);

	AmbientSound("misc/devildeath",127);

	ClearHudMessage(166);//Timer
	ClearHudMessage(167);//Timer
	ClearHudMessage(59);//Boss Weapon Info

	shadowRevealActive = true;

	int TempBoss;
	for(i = 0; i < MultiBossCheck; i++){

		if(ShadowTricksArr[i]){
			ClearHudMessage(91+i);//Boss Healths
			ACS_NamedExecuteAlways("ub_UnMorphThisTID",0,BossDataArr[i][BOSSDATA_TID]);

			TempBoss = ForceBossChange(strparam(s:"uh_sv_ForcedShadowBoss",i:i+1),false);
			//ShowMeTheRCON("Shadow Boss",TempBoss);
			if(TempBoss == UHBOSS_FAIL){
				if(RandomPercent(5))
					TempBoss = BossDataArr[i][BOSSDATA_NUM];//No Change
				// else if(RandomPercent(40))
				// 	TempBoss = 301;//AbePenny
				// else if(RandomPercent(55))
				// 	TempBoss = random(303,305);
				else
					TempBoss = TrueRandomBoss();
			}
			BossDataArr[i][BOSSDATA_MORPHED] = TempBoss;//Borrow this Array
		}
	}

	Delay(1);//Delay needed otherwise unmorph doesn't happen correctly

	for(i = 0; i < MultiBossCheck; i++){
		if(ShadowTricksArr[i]){
			ClearActorInventory(BossDataArr[i][BOSSDATA_TID]);
			GiveActorInventory(BossDataArr[i][BOSSDATA_TID],"ShadowPreRoundStart",1);
		}
	}

	Delay(35*2);

	//NEW#BOSS
	//if(ShadowTricksArr[0] && UnholyBoss1 == 300){ UnholyBoss1 = random(100,BOSSRNGMAX_100_199); }

	//	If(shadowFakeoutActive){
	//		MusicCredits("Super Mario Sunshine - Shadow Mario (Sped-up)",0);
	//		PlayMusic("SHADSHAD");
	//		shadowFakeoutActive = false;
	//	}
	//	break;

	//If(shadowFakeoutActive){
	//	Delay(35*2);
	//	AmbientSound("items/GoldTank",127);
	//	GiveActorInventory(669,"PTankItem",1);
	//	GiveActorInventory(669,"PowerSTank",1);
	//	GiveActorInventory(669,"SpeedTrailofEnvy",1);
	//	SetActorProperty(669, APROP_JumpZ, 15.0);
	//	SetActorProperty(669, APROP_SPEED, 1.25);
	//	Delay(35*3);
	//	//shadowFakeoutActive=false;
	//}
	//else {Delay(35*5);}

	Delay(35*3);
	debugLog(strParam(s:"Shadow Delay is over"));

	int ShadowTunesNum = -1;

	for(i = 0; i < MultiBossCheck; i++){
		if(ShadowTricksArr[i]){
			if(PlayerInGame(BossDataArr[i][BOSSDATA_TID]-1000)){
				GiveActorInventory(BossDataArr[i][BOSSDATA_TID],"ShadowPreRoundEnd",1);
				BossDataArr[i][BOSSDATA_NUM] = BossDataArr[i][BOSSDATA_MORPHED];//Use borrowed Array
				BossDataArr[i][BOSSDATA_MORPHED] = morphActorToBoss(BossDataArr[i][BOSSDATA_TID],BossDataArr[i][BOSSDATA_NUM],"GigaAstroExplode");
				if(ShadowTunesNum == -1)
					ShadowTunesNum = BossDataArr[i][BOSSDATA_NUM];
			}
			else{ShadowTricksArr[i] = false;}
		}
	}

	if(ShadowTunesNum == -1){
		PlayMusic(MusicalEventIndex[8][0]);
		MusicCredits(MusicalEventIndex[8][1],0);
	}
	else{
		ACS_NamedExecute("ub_PlayVariantMusic",0,ShadowTunesNum);
	}

	Delay(1);


	ACS_NamedExecuteWait("ub_BossMorphRetryWait",0,0);

	shadowRevealActive = false;
	RefreshHudMessage = true;
	//ACS_Execute(WATCHER_BOSS_HP,0,0);

}

//Script used to end the round for no survivors
Script "ub_WatchSurvivors" (int SkipACS)//OPEN
{

	Delay(1);//Important! Otherwise the BossDataArr[][] isn't set correctly from another script!

	if (!SkipACS) {
		ACS_NamedExecute("ub_BossHealthWatcher",0);
		ACS_NamedExecute("ub_DemoneyeNumWatcher",0);//Does this fix Boss VS??
	// 	if(VersusFightEvent){
	// 		ACS_NamedExecute("ub_ManageBossVsBossEvent",0);
	// 		terminate;
	// 	}
		ACS_NamedExecute("ub_WatchBossesAndEyes",0);
	}

	while(totalPlayersArr[PLS_SURVIVOR]>=1 && !standardlmseventlocked && !gameover){
		Delay(1);
		if(totalPlayersArr[PLS_SURVIVOR]==1){
			ACS_NamedExecute("ub_LMS_EventTime",0,random(0,11));
			debugLog(strParam(s: "Last Man Standing!"));
			standardlmseventlocked = true;
		}
	}

	while(totalPlayersArr[PLS_SURVIVOR]>=1 && !gameover){
		Delay(1);
	}

	if(gameover){terminate;}

	Delay(1);

	ACS_NamedTerminate("ub_WatchBossesAndEyes",0);
	//PlayMusic_Loss(0);
	PlayMusic_Loser(-1);
	// MakeAllPlayersInvun();
	gameover = true;

	SetFont("BIGFONT");
	SetHudSize(480,360,0);
	HudMessageBold(s:"The survivors have been defeated..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 5.0, 2.0);

	survWinWithLMS = false;
	Delay(35*9);
	Exit_Normal(0);
	Delay(35*6);

}

//The LMS script
script "ub_LMS_EventTime" (int LMSNum, int ForceRare)
{
	bool RareItemCheck = false;
	int TheRuneNumber = -1;
	int TheRuneNumberX = -1;

	int LMSCount = 0;
	Until (LMSCount == 64) {//Find the lone survivor!
		if(PlayerLifeStatusArr[LMSCount]==PLS_SURVIVOR){
			TheLMSDude = LMSCount+1000;//Record the player number!
			break;
		}
		LMSCount++;
	}

	Delay(1);


	int LMS_Cvar = CheckClearCvar("uh_sv_LMSEvent",-1);
	if(LMS_Cvar >= 0 && LMS_Cvar <= 11) {
		LMSNum = LMS_Cvar;
		ShowMeTheRCON("The LMS Event",LMS_Cvar);
	}
	else if(LMSNum <= -1 || LMSNum >= 12){
		LMSNum = random(0,11);
	}

	if(RandomPercent(RareLMSRune)){//
		TheRuneNumber = randomRune(RANDRUNE_RARE);
		RareLMSRune = 10;
	}
	else{
		TheRuneNumber = randomRune(RANDRUNE_COMMON);
		RareLMSRune += random(2,6);
	}

	if(random(RareLMSTime,20)>=20 || ForceRare == 7){
		RareLMSTime = 0;
		RareItemCheck = true;
	}
	else{
		RareLMSTime++;
	}

	if(LMSNum == 9){
		do {
			if (RareItemCheck) {
				TheRuneNumberX = randomRune(RANDRUNE_RARE);
			}
			else {
				TheRuneNumberX = randomRune(RANDRUNE_COMMON);
			}
		} while (TheRuneNumber == TheRuneNumberX);
	}


	SetFont("BIGFONT");
	SetHudSize(640,480,0);
	
	str TheRune_Str = StrParam(s:"\c- got a ",s:RuneOfTheDay[TheRuneNumber]);
	if(LMSNum == 9){
		TheRune_Str = StrParam(s:TheRune_Str,s:" & ",s:RuneOfTheDay[TheRuneNumberX],s:" Rune!\n");
	}
	else{
		TheRune_Str = StrParam(s:TheRune_Str,s:" Rune!\n");
	}

	str ItemMessage;
	if(RareItemCheck){ItemMessage = LMSListArray[LMSNum][1];}
	else{ItemMessage = LMSListArray[LMSNum][0];}

	HudMessageBold(n:TheLMSDude-999,s:TheRune_Str,s:ItemMessage; HUDMSG_FADEOUT|HUDMSG_LOG, 70, CR_YELLOW, 320.4, 336.2, 1.8,0.2);//396.2

	ACS_NamedExecuteAlways("ub_LMS_EventIconStart",0,LMSNum,RareItemCheck);//4836

	PlayMusic(LMSListArray[LMSNum][LMS_MUSICLUMP]);
	MusicCredits(LMSListArray[LMSNum][LMS_MUSICCREDITS],0);
	survWinWithLMS = true;

	while(CheckActorInventory(TheLMSDude,"IsBlessedWithLMSPower") == 0){

		//Failsafe for a player not getting the LMS
		GiveActorInventory(TheLMSDude,"IsBlessedWithLMSPower",1);

		if(TheRuneNumber == RUNE_DRAIN || TheRuneNumberX == RUNE_DRAIN && CheckActorInventory(TheLMSDude,"PowerPeriwinkleDrain") >= 1 ) {//Drain
			TakeActorInventory(TheLMSDude,"PowerPeriwinkleDrain",99);//Prevent Ptanks from conflicting with drain rune!
		}
		if(TheRuneNumber == RUNE_RESISTANCE || TheRuneNumberX == RUNE_RESISTANCE) {//Resistance
			GiveActorInventory(TheLMSDude,"AutoHamburgerFoodItem",1);//Force 2000 healing on player
		}

		// GiveActorInventory(TheLMSDude,StrParam(s:RuneOfTheDay[TheRuneNumber],s:"Rune_ST"),1);
		ACS_NamedExecuteWithResult("uh_runeplayer", TheLMSDude-999, 1, TheRuneNumber);
		if(LMSNum == 9){ACS_NamedExecuteWithResult("uh_runeplayer", TheLMSDude-999, 1, TheRuneNumberX);}

		if(TheRuneNumber == 0 || TheRuneNumberX == 0) {//Prosperity
			GiveActorInventory(TheLMSDude,"AutoSundaeFoodItem",1);
			if(RandomPercent(15)){GiveActorInventory(TheLMSDude,"MysticBoxItem",1);}
			else{GiveActorInventory(TheLMSDude,"PandoraBoxItem",2);}
		}

		Switch (LMSNum)
		{
		Case 0:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"SuperGUHUItem",1);}
			else{GiveActorInventory(TheLMSDude,"GUHUItem",1);}
			break;
		Case 1:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"SuperMysticTankItem",1);GiveActorInventory(TheLMSDude,"PeriwinkleTankItem",1);}
			else{GiveActorInventory(TheLMSDude,"SuperMysticTankItem",1);}
			break;
		Case 2:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"MountainDewItem",1);}
			else{GiveActorInventory(TheLMSDude,"UnholyWaterItem",1);}
			break;
		Case 3:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"TankOfWondersItem",1);}
			else{}
			break;
		Case 4:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"GoldenWaspBombItem",1);}
			else{GiveActorInventory(TheLMSDude,"WaspBombItem",9);}
			break;
		Case 5:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"MysticBoxItem",1);}
			else{GiveActorInventory(TheLMSDude,"PandoraBoxItem",3);}
			break;
		Case 6:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"BEESItem",3);}
			else{GiveActorInventory(TheLMSDude,"BluntRocketItem",12);GiveActorInventory(TheLMSDude,"SharpRocketItem",2);}
			break;
		Case 7:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"SundaeFoodItem",1);GiveActorInventory(TheLMSDude,"HamburgerFoodItem",1);}
			else{GiveActorInventory(TheLMSDude,"PancakeFoodItem",1);GiveActorInventory(TheLMSDude,"CakeFoodItem",1);GiveActorInventory(TheLMSDude,"HotdogFoodItem",1);}
			break;
		Case 8:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"TheFootBallItem",1);}
			else{GiveActorInventory(TheLMSDude,"RubberBandItem",1);}
			break;
		Case 9://Bonus Rune
			break;
		Case 10:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"YouWillDieItem",1);}
			else{GiveActorInventory(TheLMSDude,"HackyCoffeeItem",1);}
			break;
		Case 11:
			if(RareItemCheck){GiveActorInventory(TheLMSDude,"TruePowerItem",1);}
			else{GiveActorInventory(TheLMSDude,"UnholyInsuranceItem",1);}
			break;
		}

		for(int i = 0; i<35; i++){
			if(!PlayerInGame(TheLMSDude-1000) || 
			   CheckActorInventory(TheLMSDude,"IsDead") ||
			   CheckActorInventory(TheLMSDude,"IsBlessedWithLMSPower"))
				break;
			Delay(2);
		}
	}//While End
}


script "ub_WatchBossesAndEyes" (void)//Checks if all bosses are dead
{
	int ExtraTimer = Timer();
	while (totalPlayersArr[PLS_BOSS]>=1 || totalPlayersArr[PLS_EYE]>=1){
		if(Gameover){terminate;}
		Delay(2);
	}

	if(Gameover){terminate;}

	GiveMeTheFunc("PowerProtectSurvivor", -1);
	GiveMeTheFunc("PowerProtectMegaCopywep", -1);
	GiveMeTheFunc("PowerProtectUnholyItem", -1);

	ACS_NamedTerminate("ub_WatchSurvivors",0);
	Gameover = true;
	//Log(i:PlayerInGame(BossDataArr[0][BOSSDATA_TID]-1000));

	SetFont("BIGFONT");
	SetHudSize(480,360,0);

	if(MultiBossCheck == 1 && !PlayerInGame(BossDataArr[0][BOSSDATA_TID]-1000) && timer() <= 35*7+ExtraTimer){
		PlayMusic_Win(-2);
		HudMessageBold(s:"The boss has declined the duel!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);
		Delay(36*4);
		Exit_Normal(0);
		Delay(35);
		terminate;
	}
	//PlayMusic_Win(0);
	PlayMusic_Winner(-1);
	HudMessageBold(s:"The survivors are victorious!"; HUDMSG_FADEOUT, 66, CR_GREEN, 240.4, 54.0, 5.0, 2.0);

	if (survWinWithLMS) {
		HellMarkFrags ++;
		if (HellMarkFrags >= 10) {
			AmbientSound("misc/SampiRises",127);
			HudMessageBold(s:"The Helltatoru knows no limits..."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
			ACS_NamedExecuteAlways("ub_InitiateUltraBoss",0,402);
		}
		else
			HudMessageBold(s:"Marks of Helltatoru ",d:HellMarkFrags, s:"/10 collected."; HUDMSG_FADEOUT, 60, CR_DARKRED, 240.4, 72.0, 5.0, 2.0);
	}
	Delay(36*10);
	Exit_Normal(0);
	Delay(36*6);
}


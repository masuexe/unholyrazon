//Scripts related to boss morphing
Script "ub_CountdownStartup" OPEN
{
	if(GetCvar("lastmanstanding")==0){
		terminate;
	}
	while(PlayerCount()<=1){
		Delay(1);
	}


	if(GetGameModeState()==1||GetGameModeState()==0){

		// ACS_NamedExecute("ub_AttemptSoundFollowFix",0);

		// int UED = CheckClearCvar("UE_BonusEventD",-1);
		// if(UED >= 0 && EventDataArr[EVENTDATA_DELAY] != 77){//Sets EventDelay if forced
		// 	EventDataArr[EVENTDATA_DELAY] = UED;
		// 	ShowMeTheRCON("Bonus Event Delay",UED);
		// }
		// Delay(11);

		// if(!GetCVAR("UH_NoSpawningItems")){
		// 	//Log(s:"Giving SurvivorBoxItems_P");
		// 	GiveMeTheFunc("SurvivorBoxItems_P",0,0);//Give Pre-Round Items
		// }

		SetHudSize(480,360,0);
		SetFont("BIGFONT");
		HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 20.0,2.0);
		Delay(20);
		terminate;
	}

	//Delay(5);

	SetHudSize(480,360,0);
	SetFont("BIGFONT");
	HudMessageBold(s:"Prepare yourselves!"; HUDMSG_FADEOUT, 66, CR_YELLOW, 240.4, 36.0, 0.5,2.0);

	SetPlayerProperty(1,1,4);
	Delay(35*1);
	ACS_Execute(799,0);//Select the bosses!
}

//This is a basic countdown timer, lasts X time. After X time, attempt to end the round.
script "uh_BackgroundTimer" (void)//OPEN
{
	int deathChance = random(1, 4);

	int timeLeft = getCVar("uh_sv_gametimer");

	SetFont("BIGFONT");
	SetHudSize(640,480,0);

	until (timeLeft < 0 || gameover){
		HudMessageBold(n:0, s:"\cgTime Left: \c-", d:timeLeft; HUDMSG_FADEOUT, 49, CR_YELLOW,320.4, 464.2, 1.8,0.2);
		Delay(35);
		timeLeft--;
	}
}


Script 799 (void)
{
//This makes specific bosses/events happen
	multiBossFunction(1);
	setUpBossSelection_Func();

	ACS_Execute(801,0);//Begin the morphing!
}

//This is the main script for managing who becomes the boss, as well as morphing them.
Script 801 (void)
{
	Delay(1);//Wait a tic so the engine processes boss selection script

	setUpPlayerSelection_Func();

	totalPlayersArr[PLS_SURVIVOR] -= multiBossCheck;
	totalPlayersArr[PLS_BOSS] += multiBossCheck;

	//Morphing area
	for(int i = 0; i < multiBossCheck; i++){
		bossDataArr[i][BOSSDATA_MORPHED] = morphMeFunc(bossDataArr[i][BOSSDATA_TID], bossDataArr[i][BOSSDATA_NUM], "GigaAstroExplode");
	}
	debugLog(strParam(s: "Morphed Boss ", i: i, s: ": ", i: bossDataArr[i][BOSSDATA_MORPHED]));

	//Musical setting
	ACS_NamedExecute("ub_PlayVariantMusic",0,BossDataArr[random(0,MultiBossCheck-1)][BOSSDATA_NUM]);

	giveMeTheFuncExceptBosses("BasicSurvivorItem", 0);
	SetPlayerProperty(1,0,4);//Allows players to move.

	ACS_NamedExecute("ub_WatchSurvivors",0);
}

//Script used to end the round for no survivors
Script "ub_WatchSurvivors" (int SkipACS)//OPEN
{

	Delay(1);//Important! Otherwise the BossDataArr[][] isn't set correctly from another script!

	// if(!SkipACS){
	// 	ACS_NamedExecute("ub_BossHealthWatcher",0);
	// 	ACS_NamedExecute("ub_DemoneyeNumWatcher",0);//Does this fix Boss VS??
	// 	if(VersusFightEvent){
	// 		ACS_NamedExecute("ub_ManageBossVsBossEvent",0);
	// 		terminate;
	// 	}
	// 	ACS_NamedExecute("ub_WatchBossesAndEyes",0);

	// 	//ACS_NamedExecute("ub_BossHealthWatcher",0);
	// 	//ACS_NamedExecute("ub_DemoneyeNumWatcher",0);
	// }

	while(totalPlayersArr[PLS_SURVIVOR]>=1 && !standardlmseventlocked && !gameover){
		Delay(1);
		if(totalPlayersArr[PLS_SURVIVOR]==1){
			// ACS_NamedExecute("ub_LMS_EventTime",0,random(0,11));
			debugLog(strParam(s: "Last Man Standing!"));
			standardlmseventlocked = true;
		}
	}

	while(totalPlayersArr[PLS_SURVIVOR]>=1 && !gameover){
		Delay(1);
	}

	if(gameover){terminate;}

	Delay(1);

	// ACS_NamedTerminate("ub_WatchBossesAndEyes",0);
	//PlayMusic_Loss(0);
	PlayMusic_Loser(-1);
	// MakeAllPlayersInvun();
	gameover = true;

	SetFont("BIGFONT");
	SetHudSize(480,360,0);
	HudMessageBold(s:"The survivors have been defeated..."; HUDMSG_FADEOUT, 66, CR_RED, 240.4, 54.0, 5.0, 2.0);

	survWinWithLMS = false;
	Delay(35*9);
	Exit_Normal(0);
	Delay(35*6);

}

Script "uh_BossMorph" (int whoisit, int BaseHP, int AddHP) //Boss messages and HP scripts
{
	SetInventory("ThisIsMyMagicBossNumber",whoisit);

	TakeInventory("PowerProtectSurvivor",1);
	TakeInventory("PowerProtectUnholyItem",1);


	if(multiBossCheck >= 2){// && !VersusFightEvent
		GiveInventory("PowerProtectBoss",1);//If multi boss, protect them from each other.
	}

	GiveInventory("BAWS",1);
	GiveInventory("MorphedFlag",1);

	int HudID = 5;//ID to display the text //-10000
	int HudOffsetY = 4;//Text Y offset, 384 + Y * 32
	HudOffsetY *= 32.0;//24.0

	str B_NameStr = MainBossList[whoisit][BOSSLIST_NAME];
	// int B_Chr0 = GetChar(MainBossList[whoisit][5],0);//Message style
	// int B_Chr1 = GetChar(MainBossList[whoisit][5],1);//Color
	// int B_Chr2 = GetChar(MainBossList[whoisit][5],2);//Punctuation...?!
	// str B_MessStr = MainBossList[whoisit][6];//'Custom' Message


	str spawnStr = StrParam(n:0, s:" \ckhas been selected to be ", s:B_NameStr, s:"\ck.");

	SetFont("BIGFONT");
	SetHudSize(640,480,0);
	HudMessageBold(s: spawnStr; HUDMSG_FADEOUT|HUDMSG_LOG, 50 + HudID, 10, 320.4, 352.2 + HudOffsetY, 1.8,0.2);//384


	//multiBossCheck
	//This changes the health of the boss based on players and multibosses
	int MainHealth = BaseHP;
	If(multiBossCheck) {
		MainHealth = min(BaseHP+(PlayerCount() * AddHP/multiBossCheck)-AddHP/multiBossCheck, 30000);
		//if(Debug_TXT) {Print(d:AddHP/multiBossCheck);}
		SetActorProperty(0, APROP_HEALTH, MainHealth);
		SetActorProperty(0, APROP_SPAWNHEALTH, MainHealth);
	}
	//GiveActorInventory
	SetInventory("BossSpawnHealthFlag", MainHealth);
	Delay(1);
}



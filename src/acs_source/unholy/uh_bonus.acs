Script "ub_EventManagementACS" (int Perform) //events
{
	if(Perform == -2){
		EventDataArr[EVENTDATA_MAINEVENT] = random(0,12);
		int UEX = CheckClearCvar("uh_sv_BonusEventNum",-1);
		if( CheckEventList(UEX) ) {
			EventDataArr[EVENTDATA_MAINEVENT] = UEX;
			EventDataArr[EVENTDATA_LASTEVENT] = 77;
			ShowMeTheRCON("The Bonus Event",UEX);
		}
		else if(EventDataArr[EVENTDATA_FORCED] >= 0){
			EventDataArr[EVENTDATA_MAINEVENT] = EventDataArr[EVENTDATA_FORCED];
			EventDataArr[EVENTDATA_FORCED] = -1;
			EventDataArr[EVENTDATA_LASTEVENT] = 77;
		}
		else {
			Do {
				if (PlayerCount() >= MULTIB_PLAYERLIMIT3){
					EventDataArr[EVENTDATA_MAINEVENT] = random(0,13);
				}
				else{
					EventDataArr[EVENTDATA_MAINEVENT] = random(0,10);
				}
				Delay(1);
			} while (EventDataArr[EVENTDATA_MAINEVENT] == EventDataArr[EVENTDATA_LASTEVENT] );
			//EventDataArr[EVENTDATA_MAINEVENT] = EXEventChecker(EventDataArr[EVENTDATA_MAINEVENT]);
		}
	}

	else if(Perform != -2){
		EventDataArr[EVENTDATA_DELAY] = 0;//RNG EVENT DELAY
		// if(Debug_TXT){Log(s:"DEBUG TXT\nLastEventWas = ",i:EventDataArr[EVENTDATA_LASTEVENT],s:"/// TheBonusEvent = ",i:EventDataArr[EVENTDATA_MAINEVENT],s:"/// EventDelay = ",i:EventDataArr[EVENTDATA_DELAY]);}
		// EventDataArr[EVENTDATA_LASTEVENT] = EventDataArr[EVENTDATA_MAINEVENT];
		// //EventDataArr[EVENTDATA_FORCED] = -1;
		Delay(1);

		switch (EventDataArr[EVENTDATA_MAINEVENT]) {
			default:
			case 0://Free For All
				ACS_Execute(837,0,0);
				break;
			case 1://MLG
				ACS_Execute(851,0,1);
				break;
			// case 2://SPOOK
			// 	ACS_Execute(851,0,2);
			// 	break;
			// case 3://Joust
			// 	ACS_Execute(851,0,3);
			// 	break;
			// case 4://Sumo
			// 	ACS_Execute(851,0,4);
			// 	break;
			// case 5://Kamikaze
			// 	ACS_Execute(851,0,5);
			// 	break;
			// case 6://Rich Devil//Rich
			// 	//ACS_Execute(851,0,6);
			// 	if(RandomPercent(15)){
			// 		MultiBossFunction(0);
			// 	}
			// 	else{
			// 		bossSlotAlive[0] = true;
			// 	}
			// 	SimpleBossChange(302,302,302,302);
			// 	Delay(1);
			// 	ACS_Execute(801,0);
			// 	break;
			// case 7://Bomber
			// 	ACS_Execute(851,0,7);
			// 	break;
			// case 8://Business
			// 	ACS_Execute(851,0,8);
			// 	break;
			// case 9://Quick
			// 	ACS_Execute(851,0,9);
			// 	break;
			// case 10://Tank
			// 	ACS_Execute(851,0,10);
			// 	break;
			case 11://Eye Parade
				ACS_Execute(834,0,0);
				break;
			// case 12://Clone Parade
			// 	ACS_Execute(834,0,1);
			// 	break;
			case 13://Free For All (Football)
				ACS_Execute(837,0,1);
				break;
			// case 14://Boss for all
			// 	//
			// 	break;

			// case 100://Free For All (TruePower)
			// 	ACS_Execute(837,0,100);
			// 	break;
			// case 106://Eyelento of Pain
			// 	ACS_Execute(827,0,6);
			// 	break;
			// case 111://Eye Parade vs Furry Runner
			// 	ACS_Execute(834,0,50);
			// 	break;
			// case 112://Eye Parade vs Foxeye Killer
			// 	ACS_Execute(834,0,51);
			// 	break;
			// case 113://Free For All (Runes)
			// 	ACS_Execute(837,0,113);
			// 	break;
		}
		isbonuseventactive = true;
	}
}


//FREE FOR ALL SCRIPT
Script 837 (int FreeChance)
{
	int ForChance = 0;
	
	
	Switch(FreeChance)
	{
		Default:
			ForChance = random(1,9);
			break;
		Case 1:
		Case 10:
		Case 113:
			break;
	}
	
	//if(FreeChance != 1 && FreeChance != 10 && FreeChance != 113){ForChance = random(1,9);}

	GiveMeTheFunc("PowerProtectSurvivor", -1);
	GiveMeTheFunc("PowerProtectUnholyItem", -1);

	if(ForChance == 7){GiveMeTheFunc("DeadlyFireArmsItem",1);}
	if(ForChance == 5){GiveMeTheFunc("YouWillDieItem",1);}

	if(FreeChance == 1){
		GiveMeTheFunc("TheFootballItemX",1);
		AmbientSound("misc/FootballEvent",127);
	}
	else{AmbientSound("misc/DixieLandStart",127);}

	Switch(FreeChance)
	{
		Default:
		Case 0:
			PlayMusic(BonusEventList[0][BONUS_MUSICLUMP]);
			MusicCredits(BonusEventList[0][BONUS_MUSICCREDITS],0);
			break;
		Case 100:
			GiveMeTheFunc("AutoTruePowerItem2",1);
			PlayMusic(BonusEventList[100][BONUS_MUSICLUMP]);
			MusicCredits(BonusEventList[100][BONUS_MUSICCREDITS],0);
			break;
		Case 113:
			GiveMeTheFunc("RageRune_ST",1);
			GiveMeTheFunc("SpreadRune_ST",1);
			GiveMeTheFunc("ResistanceRune_ST",1);
			GiveMeTheFunc("PancakeFoodItem",1);
			PlayMusic(BonusEventList[113][BONUS_MUSICLUMP]);
			MusicCredits(BonusEventList[113][BONUS_MUSICCREDITS],0);
			break;
	}

	SetFont("BIGFONT");
	ClearHudMessage(49);
	SetHudSize(640,480,0);
	HudMessageBold(s:"Meanwhile, in Dixieland of 1840..."; HUDMSG_FADEOUT, 66, CR_GRAY, 320.4, 72.2, 3.0, 2.0);
	SetPlayerProperty(1,0,4);
	ACS_NamedExecute("ub_WhoWonTheRound",0);
}

Script "ub_WhoWonTheRound" (void)
{
	Until(GetGameModeState() == GAMESTATE_INRESULTSEQUENCE){
		Delay(5);
	}
	Delay(1);
	int FindTID = 0;
	Until(FindTID == 64){
		if(PlayerInGame(FindTID) && CheckActorInventory(FindTID+1000,"IsDead") != 1){
			adjustPlayerForceNumArray(FindTID+1000);
			debuglog(strParam(s:"Player ",i:FindTID,s:" (",n:FindTID+1,s:") won the round! "));
			terminate;
		}
		FindTID++;
	}
	debugLog(strParam(s:"Match was a draw! No winner set."));
}


//Demoneye event script
Script 851 (int Which)
{
	str EyeMorphStr = StrParam(s:EyeList[Which][EYELIST_NAME],s:"_MoolaGiver");
	str EyeBonusStr = StrParam(s:EyeList[Which][EYELIST_NAME],s:"_EventD_P");

	GiveMeTheFunc(EyeMorphStr,1);
	GiveMeTheFunc(EyeBonusStr,1);

	if(Which == 2){
		//SectorColorChange(50,50,50,0);
		VariableLightChange(160,0);
		InstantLightChange(160);
	}

	ACS_NamedExecute("ub_WhoWonTheRound",0);
	PlayMusic(BonusEventList[Which][BONUS_MUSICLUMP]);
	Delay(2);
	MusicCredits(BonusEventList[Which][BONUS_MUSICCREDITS],0);
	ACS_NamedExecute("uh_DemoneyeEventTextDelay",0,Which,105);
	Delay(33);
	While(TotalPlayersArr[PLS_SURVIVOR] > 0){//If player(s) are not morphed, find and attempt to morph them.
		DemoneyeEventMorphCheckFunc(EyeMorphStr,EyeBonusStr);
		Delay(70);
	}
	debugLog(strParam(s:"Demoneye event script finished!"));
	
}

function void DemoneyeEventMorphCheckFunc (str EyeType, str EyePickup)
{
	for(int i = 0; i <= PlayerLifeStatusArr[MAX_PLAYERS]; i++){
		if(PlayerLifeStatusArr[i] == PLS_SURVIVOR){
			GiveActorInventory(i + 1000,EyeType,1);
			GiveActorInventory(i + 1000,EyePickup,1);
		}
	}
}

Script "uh_DemoneyeEventTextDelay" (int Which, int DelayTime)
{
	SetFont("BIGFONT");
	AmbientSound(BonusEventList[Which][BONUS_BONUSSOUND],127);
	SetHudSize(640,480,0);
	HudMessageBold(s:BonusEventList[Which][BONUS_HUDMESS1]; HUDMSG_FADEOUT, 49, CR_WHITE, 320.4, 432.2, 4.0, 2.0);
	SetPlayerProperty(1,0,4);
	if(GetChar(BonusEventList[Which][BONUS_HUDMESS2],0) != 0){
		Delay(DelayTime);
		SetFont("SMALLFONT");
		HudMessageBold(s:BonusEventList[Which][BONUS_HUDMESS2]; HUDMSG_FADEOUT, 66, CR_WHITE, 320.4, 456.2, 1.0, 2.0);
	}
}

//Scripts used by special events

//This script is mainly for the 1 vs Something events
Script 834 (int Which)
{

	str EventString = "Null";
	int MainHealth = 0;
	Delay(1);

	SetUpPlayerSelection_Func();

	//EXTREME
	//If(UnholyBoss == 300){GiveActorInventory(BossTID1,"Is_UH_BossNum",1);}

	Delay(1);
	debugLog(strParam(s:"The 1 vs. all target: ", d:BossDataArr[0][BOSSDATA_TID]));

	Delay(1);
	
	int TempBoss1 = BossDataArr[0][BOSSDATA_TID];

	Switch(Which)
	{
		Default:
		Case 0:
			GiveMeTheFuncExceptBosses("Plain_MoolaGiver", 1);
			GiveMeTheFuncExceptBosses("PlaineyeEventProtect", 1);

			GiveActorInventory(TempBoss1,"SurvivorBoxItems_P",1);

			MainHealth = 115;

			Delay(1);
			ACS_Execute(835,0,0);//SinglePlayer tracker
			
			PlayMusic(BonusEventList[11][BONUS_MUSICLUMP]);
			MusicCredits(BonusEventList[11][BONUS_MUSICCREDITS],0);
			break;
	}

	if(Which != 50 && Which != 51 && Which == 100){
		BossDataArr[0][BOSSDATA_NUM] = ForceBossChange("UB_TheBoss1",true);
//UnholyBoss1
		BossDataArr[0][BOSSDATA_MORPHED] = MorphMeFunc(BossDataArr[0][BOSSDATA_TID],BossDataArr[0][BOSSDATA_NUM],"GigaAstroExplode");

		//ACS_NamedExecuteWait("ub_BossMorphRetryWait",0,-1);
	}
	else{
		MainHealth = min(GetActorProperty(TempBoss1,APROP_SPAWNHEALTH)+(PlayerCount() * MainHealth), 30000);
		SetActorProperty(TempBoss1, APROP_HEALTH, MainHealth);
		SetActorProperty(TempBoss1, APROP_SPAWNHEALTH, MainHealth);
	}

	Switch(Which)
	{
		Default:
		Case 0:
			ACS_Execute(836,0);
			EventString = "Hey look, A \ctDemoneye \c-Parade.";
			break;
		Case 1:
			ACS_Execute(836,0);
			EventString = "Here approaches the darkness!";
			break;
		Case 50:
			EventString = "\caKILL THAT FURRY!";
			ACS_Execute(836,0,50);
			break;
		Case 51:
			EventString = "\caUH OH! AN ANGRY FOXEYE! RUN OR KILL IT!";
			ACS_Execute(836,0,51);
			break;
	}

	SetFont("BIGFONT");
	HudMessageBold(s:EventString; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 324.0, 1.8,0.2);
	SetPlayerProperty(1,0,4);
}

//Basic, YOU WIN/LOSE script for special events.
script 835 (int Which)
{
	SetActivator(0,AAPTR_NULL);
	int ExitDelay = 10;
	str EndingString = "Null";
	Switch(Which)
	{
	Case 0:
		EndingString = "The \ctDemoneyes\cj are now being payed with \n\cdREAL Money\c-.";
		while(ThingCount(0,BossDataArr[0][BOSSDATA_TID])>=1){Delay(2);}
		PlayMusic_Win(1);
		break;
	Case 1:
		EndingString = "The darkness consumes all.";
		while(ThingCount(0,BossDataArr[0][BOSSDATA_TID])>=1){Delay(2);}
		PlayMusic_Win(1);
		break;
	Case 2:
		EndingString = "\cfThe Eyelentos have been defeated!";
		while(ThingCountName("EyelentoMajorDemoneye",0)>=1){Delay(2);}
		ACS_NamedExecuteAlways("ub_InitiateUltraBoss",0,401);
		ExitDelay = 8;
		break;
	}
	SetHudSize(480,360,0);
	SetFont("BIGFONT");
	HudMessageBold(s:EndingString; HUDMSG_FADEOUT, 66, CR_WHITE, 240.4, 54.0, 3.0, 2.0);
	Gameover = true;
	Delay(35*ExitDelay);
	Exit_Normal(0);
	Delay(35*ExitDelay);
}

//Special trackers for special things, also includes special endings.
Script 836 (int Which)
{
	SetActivator(0,AAPTR_NULL);
	int Timer_TEN = 20;
	Switch (Which)
	{
	Case 0:
		int TempNum_0 = PlayerClass(BossDataArr[0][BOSSDATA_TID]-1000)*-1-100;
		bool TempMorphedBool;
		bossSlotAlive[0] = true;
		while(bossSlotAlive[0]){//@@@@@@@@@@@@@@@@
			
			if(!TempMorphedBool)
				if(CheckActorInventory(BossDataArr[0][BOSSDATA_TID],"MorphedFlag")){
					if(PlayerLifeStatusArr[BossDataArr[0][BOSSDATA_TID]-1000] == PLS_EYE)
						TempNum_0 = CheckActorInventory(BossDataArr[0][BOSSDATA_TID],"ThisIsMyMagicEyeNumber")+1000;
					else if(CheckActorInventory(BossDataArr[0][BOSSDATA_TID],"TruePowerItemFlag"))
						TempNum_0 = PlayerClass(BossDataArr[0][BOSSDATA_TID]-1000)*-1-1;
					else
						TempNum_0 = BossDataArr[0][BOSSDATA_NUM];
					TempMorphedBool = true;
					//Func_BHW_Checker(0,BossDataArr[0][BOSSDATA_TID],TempNum_0,true);
					Delay(1);
				}
			//Func_BHW_Checker(0,BossDataArr[0][BOSSDATA_TID],TempNum_0,false);
			Delay(1);
		}
		break;
	Case 50:
		SetHudSize(640,480,0);
		Timer_TEN = 60-(PlayerCount() * 2);
		if(Timer_TEN < 21){Timer_TEN = 20;}
		while(Timer_TEN >= 1)
		{
			SetFont("HELTIMR1");
			HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
			SetFont("fakefntC");//SMALLFONT
			HudMessageBold(i:Timer_TEN; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

			//SetFont("SMALLFONT");
			//HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
			Timer_TEN -= 1;
			Delay(35);
			if(Gameover || GetGameModeState()==GAMESTATE_INRESULTSEQUENCE){
				ClearHudMessage(166);
				ClearHudMessage(167);
				Terminate;
			}
		}
		SetFont("HELTIMR0");
		HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
		SetFont("fakefntC");//SMALLFONT
		HudMessageBold(i:Timer_TEN; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

		//HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
		Delay(1);
		PlayMusic_Loss(2);
		SetHudSize(480,360,0);
		SetFont("BIGFONT");
		HudMessageBold(s:"\caThe Furry Escaped!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
		MakeAllPlayersInvun();
		SetPlayerProperty(1,1,4);
		Gameover = true;
		Delay(35*6);
		Exit_Normal(0);
		Delay(36*6);
		break;
	Case 51:
		SetHudSize(640,480,0);
		Timer_TEN = 18+round((PlayerCount()*1.5));
		while(Timer_TEN >= 1)
		{
			SetFont("HELTIMR1");
			HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
			SetFont("fakefntC");//SMALLFONT
			HudMessageBold(i:Timer_TEN; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

			//SetFont("fakefntC");//SMALLFONT
			//HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.96, 0, 3.0);
			Timer_TEN -= 1;
			Delay(35);
			if(Gameover || GetGameModeState()==GAMESTATE_INRESULTSEQUENCE){
				ClearHudMessage(166);
				ClearHudMessage(167);
				Terminate;
			}
		}
		SetFont("HELTIMR0");
		HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
		SetFont("fakefntC");//SMALLFONT
		HudMessageBold(i:Timer_TEN; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

		//HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
		Delay(1);
		PlayMusic_Loss(1);
		SetHudSize(480,360,0);
		SetFont("BIGFONT");
		HudMessageBold(s:"The \ctDemoneyes\cj Survived!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
		MakeAllPlayersInvun();
		Gameover = true;
		Delay(35*6);
		Exit_Normal(0);
		Delay(36*6);
		break;
	}
}

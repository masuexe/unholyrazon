script "ub_EventManagementACS" (int perform) {
  if (perform == -2) {
    event_data_arr[EVENTDATA_MAINEVENT] = random(0, 12);
    int uex = CheckClearCvar("uh_sv_BonusEventNum", -1);
    if (CheckEventList(uex)) {
      event_data_arr[EVENTDATA_MAINEVENT] = uex;
      event_data_arr[EVENTDATA_LASTEVENT] = 77;
      ShowMeTheRCON("The Bonus Event", uex);
    }
    else if (event_data_arr[EVENTDATA_FORCED] >= 0) {
      event_data_arr[EVENTDATA_MAINEVENT] = event_data_arr[EVENTDATA_FORCED];
      event_data_arr[EVENTDATA_FORCED] = -1;
      event_data_arr[EVENTDATA_LASTEVENT] = 77;
    }
    else {
      do {
        if (PlayerCount() >= MULTIB_PLAYERLIMIT3) {
          event_data_arr[EVENTDATA_MAINEVENT] = random(0, 13);
        }
        else {
          event_data_arr[EVENTDATA_MAINEVENT] = random(0, 10);
        }
        Delay(1);
      } while (event_data_arr[EVENTDATA_MAINEVENT] == event_data_arr[EVENTDATA_LASTEVENT]);
      // EventDataArr[EVENTDATA_MAINEVENT] = EXEventChecker(EventDataArr[EVENTDATA_MAINEVENT]);
    }
  }

  else if (perform != -2) {
    event_data_arr[EVENTDATA_DELAY] = 0;  // RNG EVENT DELAY
    // if(Debug_TXT){Log(s:"DEBUG TXT\nLastEventWas = ",i:EventDataArr[EVENTDATA_LASTEVENT],s:"/// TheBonusEvent = ",i:EventDataArr[EVENTDATA_MAINEVENT],s:"/// EventDelay = ",i:EventDataArr[EVENTDATA_DELAY]);}
    // EventDataArr[EVENTDATA_LASTEVENT] = EventDataArr[EVENTDATA_MAINEVENT];
    // //EventDataArr[EVENTDATA_FORCED] = -1;
    Delay(1);

    switch (event_data_arr[EVENTDATA_MAINEVENT]) {
      default:
      case 0:  // Free For All
        ACS_NamedExecute("ub_FreeForAll", 0, 0);
        break;
      case 1:  // MLG
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 1);
        break;
      case 2:  // SPOOK
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 2);
        break;
      case 3:  // Joust
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 3);
        break;
      case 4:  // Sumo
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 4);
        break;
      case 5:  // Kamikaze
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 5);
        break;
        // case 6://Rich Devil//Rich
        // 	//ACS_NamedExecute("ub_DemoneyeEvent", 0, 6);
        // 	if(RandomPercent(15)){
        // 		MultiBossFunction(0);
        // 	}
        // 	else{
        // 		bossSlotAlive[0] = true;
        // 	}
        // 	SimpleBossChange(302,302,302,302);
        // 	Delay(1);
        // 	ACS_NamedExecute("ub_MorphSelectedBosses",0);
        // 	break;
      case 7:  // Bomber
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 7);
        break;
      case 8:  // Business
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 8);
        break;
      case 9:  // Quick
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 9);
        break;
      case 10:  // Tank
        ACS_NamedExecute("ub_DemoneyeEvent", 0, 10);
        break;
      case 11:  // Eye Parade
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 0);
        break;
      case 12:  // Clone Parade
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 1);
        break;
      case 13:  // Free For All (Football)
        ACS_NamedExecute("ub_FreeForAll", 0, 1);
        break;
        // case 14://Boss for all
        // 	//
        // 	break;

      case 100:  // Free For All (TruePower)
        ACS_NamedExecute("ub_FreeForAll", 0, 100);
        break;
      case 106:  // Eyelento of Pain
        ACS_NamedExecute("ub_EyelentoOfPain", 0, 6);
        break;
      case 111:  // Eye Parade vs Furry Runner
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 50);
        break;
      case 112:  // Eye Parade vs Foxeye Killer
        ACS_NamedExecute("ub_OneVsAllEvent", 0, 51);
        break;
      case 113:  // Free For All (Runes)
        ACS_NamedExecute("ub_FreeForAll", 0, 113);
        break;
    }
    isbonuseventactive = true;
  }
}


// FREE FOR ALL SCRIPT
script "ub_FreeForAll" (int free_chance) {
  int for_chance = 0;

  switch (free_chance) {
    default:
      for_chance = random(1, 9);
      break;
    case 1:
    case 10:
    case 113:
      break;
  }

  // if(FreeChance != 1 && FreeChance != 10 && FreeChance != 113){ForChance = random(1,9);}

  GiveMeTheFunc("PowerProtectSurvivor", -1);
  GiveMeTheFunc("PowerProtectMegaCopywep", -1);
  GiveMeTheFunc("PowerProtectUnholyItem", -1);

  if (for_chance == 7) {GiveMeTheFunc("DeadlyFireArmsItem", 1);}
  if (for_chance == 5) {GiveMeTheFunc("YouWillDieItem", 1);}

  if (free_chance == 1) {
    GiveMeTheFunc("TheFootballItemX", 1);
    AmbientSound("misc/FootballEvent", 127);
  }
  else {AmbientSound("misc/DixieLandStart", 127);}

  switch (free_chance) {
    default:
    case 0:
      PlayMusic(bonus_event_list[0][BONUS_MUSICLUMP]);
      MusicCredits(bonus_event_list[0][BONUS_MUSICCREDITS], 0);
      break;
    case 100:
      GiveMeTheFunc("AutoTruePowerItemSilent", 1);
      PlayMusic(bonus_event_list[100][BONUS_MUSICLUMP]);
      MusicCredits(bonus_event_list[100][BONUS_MUSICCREDITS], 0);
      break;
    case 113:
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_RAGE, 0);
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_SPREAD, 0);
      ScriptMeTheFunc("uh_runeplayer", 0, true, RUNE_RESISTANCE, 0);
      GiveMeTheFunc("PancakeFoodItem", 1);
      PlayMusic(bonus_event_list[113][BONUS_MUSICLUMP]);
      MusicCredits(bonus_event_list[113][BONUS_MUSICCREDITS], 0);
      break;
  }

  SetFont("BIGFONT");
  ClearHudMessage(49);
  SetHudSize(640, 480, 0);
  HudMessageBold(s:"Meanwhile, in Dixieland of 1840..."; HUDMSG_FADEOUT, 66, CR_GRAY, 320.4, 72.2, 3.0, 2.0);
  SetPlayerProperty(1, 0, 4);
  ACS_NamedExecute("ub_WhoWonTheRound", 0);
}

script "ub_WhoWonTheRound" (void) {
  until (GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
    Delay(5);
  }
  Delay(1);
  int find_tid = 0;
  until (find_tid == 64) {
    if (PlayerInGame(find_tid) && CheckActorInventory(find_tid + 1000, "IsDead") != 1) {
      AdjustPlayerForceNumArray(find_tid + 1000);
      DebugLog(strParam(s:"Player ", i:find_tid, s:" (", n:find_tid + 1, s:") won the round! "));
      terminate;
    }
    find_tid++;
  }
  DebugLog(strParam(s:"Match was a draw! No winner set."));
}


// Demoneye event script
script "ub_DemoneyeEvent" (int which) {
  str stem = GetEyeEventStem(which);
  str eye_morph_str = StrParam(s:stem, s:"_MoolaGiver");
  str eye_bonus_str = StrParam(s:stem, s:"_EventD_P");

  GiveMeTheFunc(eye_morph_str, 1);
  GiveMeTheFunc(eye_bonus_str, 1);

  if (which == 2) {
    // SectorColorChange(50,50,50,0);
    VariableLightChange(160, 0);
    InstantLightChange(160);
  }

  ACS_NamedExecute("ub_WhoWonTheRound", 0);
  PlayMusic(bonus_event_list[which][BONUS_MUSICLUMP]);
  Delay(2);
  MusicCredits(bonus_event_list[which][BONUS_MUSICCREDITS], 0);
  ACS_NamedExecute("uh_DemoneyeEventTextDelay", 0, which, 105);
  Delay(33);
  while (total_players_arr[PLS_SURVIVOR] > 0) {  // If player(s) are not morphed, find and attempt to morph them.
    DemoneyeEventMorphCheckFunc(eye_morph_str, eye_bonus_str);
    Delay(70);
  }
  DebugLog(strParam(s:"Demoneye event script finished!"));

  // if (which == 2) {
  // 	while (timer() < 1050) {
  // 		Delay(1);
  // 	}
  // 	giveMeTheFunc("GhostEyeShadowInvisOff_P", 1);
  // }
}

function void DemoneyeEventMorphCheckFunc(str eye_type, str eye_pickup) {
  for (int i = 0; i <= player_life_status_arr[MAX_PLAYERS]; i++) {
    if (player_life_status_arr[i] == PLS_SURVIVOR) {
      GiveActorInventory(i + 1000, eye_type, 1);
      GiveActorInventory(i + 1000, eye_pickup, 1);
    }
  }
}

script "uh_DemoneyeEventTextDelay" (int which, int delay_time) {
  SetFont("BIGFONT");
  AmbientSound(bonus_event_list[which][BONUS_BONUSSOUND], 127);
  SetHudSize(640, 480, 0);
  HudMessageBold(s:bonus_event_list[which][BONUS_HUDMESS1]; HUDMSG_FADEOUT, 49, CR_WHITE, 320.4, 432.2, 4.0, 2.0);
  SetPlayerProperty(1, 0, 4);
  if (GetChar(bonus_event_list[which][BONUS_HUDMESS2], 0) != 0) {
    Delay(delay_time);
    SetFont("SMALLFONT");
    HudMessageBold(s:bonus_event_list[which][BONUS_HUDMESS2]; HUDMSG_FADEOUT, 66, CR_WHITE, 320.4, 456.2, 1.0, 2.0);
  }
}

// Scripts used by special events

// This script is mainly for the 1 vs Something events
script "ub_OneVsAllEvent" (int which) {

  str event_string = "Null";
  int main_health = 0;
  Delay(1);

  SetUpPlayerSelectionFunc();

  // EXTREME
  // If(UnholyBoss == 300){GiveActorInventory(BossTID1,"Is_UH_BossNum",1);}

  Delay(1);
  DebugLog(strParam(s:"The 1 vs. all target: ", d:boss_data_arr[0][BOSSDATA_TID]));

  Delay(1);

  int temp_boss1 = boss_data_arr[0][BOSSDATA_TID];

  switch (which) {
    default:
    case 0:
      GiveMeTheFuncExceptBosses("Plain_MoolaGiver", 1);
      GiveMeTheFuncExceptBosses("PlaineyeEventProtect", 1);

      GiveActorInventory(temp_boss1, "SurvivorBoxItems_P", 1);

      main_health = 115;

      Delay(1);
      ACS_NamedExecute("ub_SpecialEventEnding", 0, 0);  // SinglePlayer tracker

      PlayMusic(bonus_event_list[11][BONUS_MUSICLUMP]);
      MusicCredits(bonus_event_list[11][BONUS_MUSICCREDITS], 0);
      break;
  }

  if (which != 50 && which != 51 && which == 100) {
    boss_data_arr[0][BOSSDATA_NUM] = TrueRandomBoss();
    // UnholyBoss1
    boss_data_arr[0][BOSSDATA_MORPHED] = MorphActorToBoss(boss_data_arr[0][BOSSDATA_TID], boss_data_arr[0][BOSSDATA_NUM], "GigaAstroExplode");

    ACS_NamedExecuteWait("ub_BossMorphRetryWait", 0, -1);
  }
  else {
    main_health = min(GetActorProperty(temp_boss1, APROP_SPAWNHEALTH) + (PlayerCount() * main_health), MAX_HEALTH);
    SetActorProperty(temp_boss1, APROP_HEALTH, main_health);
    SetActorProperty(temp_boss1, APROP_SPAWNHEALTH, main_health);
  }

  switch (which) {
    default:
    case 0:
      ACS_NamedExecute("ub_SpecialEventTracker", 0);
      event_string = "Hey look, A \ctDemoneye \c-Parade.";
      break;
    case 1:
      ACS_NamedExecute("ub_SpecialEventTracker", 0);
      event_string = "Here approaches the darkness!";
      break;
    case 50:
      event_string = "\caKILL THAT FURRY!";
      ACS_NamedExecute("ub_SpecialEventTracker", 0, 50);
      break;
    case 51:
      event_string = "\caUH OH! AN ANGRY FOXEYE! RUN OR KILL IT!";
      ACS_NamedExecute("ub_SpecialEventTracker", 0, 51);
      break;
  }

  SetFont("BIGFONT");
  HudMessageBold(s:event_string; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 324.0, 1.8, 0.2);
  SetPlayerProperty(1, 0, 4);
}

// Eyelento of Pain bonus event (ported from unbound Script 827)
script "ub_EyelentoOfPain" (int eyelento_amount) {
  PlayMusic(bonus_event_list[106][BONUS_MUSICLUMP]);
  MusicCredits(bonus_event_list[106][BONUS_MUSICCREDITS], 0);

  ACS_NamedExecute("ub_WatchSurvivors", 0, true);

  if (total_players_arr[PLS_SURVIVOR] <= eyelento_amount) {
    eyelento_amount = total_players_arr[PLS_SURVIVOR] - 1;
  }
  int eyelento_rng = 0;
  standardlmseventlocked = true;
  SetPlayerProperty(1, 0, 4);
  while (ThingCountName("EyelentoMajorDemoneye", 0) < eyelento_amount) {
    eyelento_rng = random(1000, player_life_status_arr[MAX_PLAYERS] + 1000);
    MorphActor(eyelento_rng, "EyelentoMajorDemoneye", "", 0x7ffffffc, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "EyelentoMajorDemoneyeC");
    Delay(1);
  }
  ACS_NamedExecute("ub_SpecialEventEnding", 0, 2);
}

// Basic, YOU WIN/LOSE script for special events.
script "ub_SpecialEventEnding" (int which) {
  SetActivator(0, AAPTR_NULL);
  int exit_delay = 10;
  str ending_string = "Null";
  switch (which) {
    case 0:
      ending_string = "The \ctDemoneyes\cj are now being payed with \n\cdREAL Money\c-.";
      while (ThingCount(0, boss_data_arr[0][BOSSDATA_TID]) >= 1) {Delay(2);}
      PlayMusicWin(1);
      break;
    case 1:
      ending_string = "The darkness consumes all.";
      while (ThingCount(0, boss_data_arr[0][BOSSDATA_TID]) >= 1) {Delay(2);}
      PlayMusicWin(1);
      break;
    case 2:
      ending_string = "\cfThe Eyelentos have been defeated!";
      while (ThingCountName("EyelentoMajorDemoneye", 0) >= 1) {Delay(2);}
      ACS_NamedExecuteAlways("ub_InitiateUltraBoss", 0, 401);
      exit_delay = 8;
      break;
  }
  SetHudSize(480, 360, 0);
  SetFont("BIGFONT");
  HudMessageBold(s:ending_string; HUDMSG_FADEOUT, 66, CR_WHITE, 240.4, 54.0, 3.0, 2.0);
  gameover = true;
  Delay(35 * exit_delay);
  Exit_Normal(0);
  Delay(35 * exit_delay);
}

// Special trackers for special things, also includes special endings.
script "ub_SpecialEventTracker" (int which) {
  SetActivator(0, AAPTR_NULL);
  int timer_ten = 20;
  switch (which) {
    case 0:
      // Prefer DefineSurvivor id for HUD encoding; fall back to KEYCONF PlayerClass.
      int pnum0 = boss_data_arr[0][BOSSDATA_TID] - 1000;
      int sid0 = FindSurvivorByActor(GetActorClass(boss_data_arr[0][BOSSDATA_TID]));
      int temp_num_0;
      if (sid0 != UHSURV_FAIL)
        temp_num_0 = EncodeSurvivorBossNumb(sid0);
      else
        temp_num_0 = PlayerClass(pnum0) * -1 - 100;
      bool temp_morphed_bool;
      bool forcehud = true;
      boss_slot_alive[0] = true;
      while (boss_slot_alive[0]) {  // @@@@@@@@@@@@@@@@

        if (!temp_morphed_bool)
          if (CheckActorInventory(boss_data_arr[0][BOSSDATA_TID], "MorphedFlag")) {
          if (player_life_status_arr[boss_data_arr[0][BOSSDATA_TID] - 1000] == PLS_EYE) {
            int eye_hud = GetPlayerEyeId(boss_data_arr[0][BOSSDATA_TID] - 1000);
            if (eye_hud == UHEYE_FAIL)
              eye_hud = CheckActorInventory(boss_data_arr[0][BOSSDATA_TID], "ThisIsMyMagicEyeNumber");
            temp_num_0 = EncodeEyeBossNumb(eye_hud);
          }
          else if (CheckActorInventory(boss_data_arr[0][BOSSDATA_TID], "TruePowerItemFlag")) {
            // Reuse pre-morph sid0 — GetActorClass is *Shiny after morpher.
            if (sid0 != UHSURV_FAIL)
              temp_num_0 = EncodeSurvivorShinyBossNumb(sid0);
            else
              temp_num_0 = EncodeSurvivorShinyBossNumb(PlayerClass(pnum0));
          }
          else
            temp_num_0 = boss_data_arr[0][BOSSDATA_NUM];
          temp_morphed_bool = true;
          forcehud = true;
        }
        FuncBHWChecker(0, boss_data_arr[0][BOSSDATA_TID], temp_num_0, forcehud);
        forcehud = false;
        Delay(1);
      }
      break;
    case 50:
      SetHudSize(640, 480, 0);
      timer_ten = 60 - (PlayerCount() * 2);
      if (timer_ten < 21) {timer_ten = 20;}
      while (timer_ten >= 1) {
        SetFont("HELTIMR1");
        HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
        SetFont("fakefntC");  // SMALLFONT
        HudMessageBold(i:timer_ten; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

        // SetFont("SMALLFONT");
        // HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
        timer_ten -= 1;
        Delay(35);
        if (gameover || GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
          ClearHudMessage(166);
          ClearHudMessage(167);
          terminate;
        }
      }
      SetFont("HELTIMR0");
      HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
      SetFont("fakefntC");  // SMALLFONT
      HudMessageBold(i:timer_ten; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

      // HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
      Delay(1);
      PlayMusicLoss(2);
      SetHudSize(480, 360, 0);
      SetFont("BIGFONT");
      HudMessageBold(s:"\caThe Furry Escaped!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
      MakeAllPlayersInvun();
      SetPlayerProperty(1, 1, 4);
      gameover = true;
      Delay(35 * 6);
      Exit_Normal(0);
      Delay(36 * 6);
      break;
    case 51:
      SetHudSize(640, 480, 0);
      timer_ten = 18 + RoundFixedToInt(PlayerCount() * 1.5);
      while (timer_ten >= 1) {
        SetFont("HELTIMR1");
        HudMessage(s:"A"; 0, 167, -1, 300.1, 49.1, 0, 3.0);
        SetFont("fakefntC");  // SMALLFONT
        HudMessageBold(i:timer_ten; 0, 166, CR_GOLD, 317.1, 54.1, 0, 3.0);

        // SetFont("fakefntC");//SMALLFONT
        // HudMessage(s:"Time left: ", i:Timer_TEN; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.96, 0, 3.0);
        timer_ten -= 1;
        Delay(35);
        if (gameover || GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
          ClearHudMessage(166);
          ClearHudMessage(167);
          terminate;
        }
      }
      SetFont("HELTIMR0");
      HudMessage(s:"A"; 1, 167, -1, 300.1, 49.1, 4.0, 1.0);
      SetFont("fakefntC");  // SMALLFONT
      HudMessageBold(i:timer_ten; 1, 166, CR_RED, 317.1, 54.1, 4.0, 1.0);

      // HudMessage(s:"Time left: \cg0"; HUDMSG_PLAIN, 166, CR_GOLD,0.04, 0.88, 0, 3.0);
      Delay(1);
      PlayMusicLoss(1);
      SetHudSize(480, 360, 0);
      SetFont("BIGFONT");
      HudMessageBold(s:"The \ctDemoneyes\cj Survived!"; HUDMSG_FADEOUT, 49, CR_WHITE, 240.4, 72.0, 4.0, 1.0, 1.0);
      MakeAllPlayersInvun();
      gameover = true;
      Delay(35 * 6);
      Exit_Normal(0);
      Delay(36 * 6);
      break;
  }
}

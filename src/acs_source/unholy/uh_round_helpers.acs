// Shared round/player helpers for library unholy.
// This fragment is textually included by uh_funclib.acs.

function void ShowMeTheRCON(str var, int num) {
  SetFont("fakefntC");  // SMALLFONT
  HudMessageBold(s:"\c[MenuYellow]RCON set ", s:var, s:" to ", i:num; HUDMSG_LOG, 447266, CR_WHITE, 0.99, 0.99, 6.0);  // 0.06 0.70
}

// This gathers a CVAR info, resets to NUM, and returns it.
function int CheckClearCVar(str check, int num) {
  int checked = GetCVAR(check);
  if (checked != num) {UH_Log(UH_LOG_DEBUG, StrParam(s:"CVAR '", s:check, s:"' was '", i:checked, s:"' and was set to '", i:num, s:"'"));}
  SetCVar(check, num);
  return checked;
}

// Read a user CVAR and clamp it to a safe range.
function int GetClampedCVar(str check, int minval, int maxval) {
  int value = GetCVar(check);
  if (value < minval) {value = minval;}
  if (value > maxval) {value = maxval;}
  return value;
}

// Marks which player numbers are ingame
function void PlayerLifeStatusArr_GatherFunc(void) {
  totalplayersarr[1] = PlayerCount();

  for (int c = 0; c < MAX_PLAYERS; c++) {
    uhsrvrole[c] = PLS_NULL;
  }

  int p_total = PlayerCount();
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i)) {
      uhsrvrole[i] = PLS_SURVIVOR;
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Player ", i:i, s:" is alive"));
      playerlifestatusarr[i] = 1;
      if (p_total <= 1) {
        playerlifestatusarr[MAX_PLAYERS] = i;
        UH_Log(UH_LOG_DEBUG, StrParam(s:"Done collecting alive players. Max ID = ", i:playerlifestatusarr[MAX_PLAYERS]));
        break;
      }
      p_total--;
    }
  }
}

// --- Team-info / scoreboard-icon state broadcast -----------------------------
// Server-authoritative snapshots pushed to every client.  The receivers are
// CLIENTSIDE scripts in unholy/uh_teaminfo.acs; keeping the senders here lets
// the life-status updater broadcast without pulling the teammate HUD scripts
// into the shared library (rz_debug also compiles this fragment).
//
// The client cache is display-only and always rebuilt from these snapshots:
// a client must never treat the server's runtime arrays as authoritative.

// Definition identity captured server-side, kept across death so a dead player's
// row can still show the portrait they had while alive.
//
// This is a (UH_PLDEF_* kind, definition id) pair of PLAIN INTEGERS.  Three
// payloads must never be synced instead:
//
//   * an ACS string.  NamedExecuteClientScript copies only raw int args, and the
//     ACS string pool is per-process and garbage-collected, so a string index
//     means nothing on the client (NamedSendNetworkString is the only supported
//     path and needs its own per-client mailbox).
//   * a presentation table row.  Rows are handed out in registration order.
//   * a custom Define*(-1, ...) id.  Also assigned in registration order, so a
//     peer missing an earlier addon would resolve it to a different class.
//
// The id is therefore only published when it is a VANILLA slot (>= 0), which is
// explicit and stable by contract (see the UHADD recipe).
//
// UH_Ti_IdentityForPlayer ALWAYS writes the slot, including "no stable
// identity".  A stale entry must never survive: after a slot reuse or a morph it
// would make every client draw the PREVIOUS player's face, which is worse than
// showing nothing.  A class with no vanilla definition (a custom addon class, or
// a morph body with no definition row) therefore publishes NONE, and the client
// falls back to the class it observed itself while the actor was alive.
int uhsrvkind[MAX_PLAYERS];
int uhsrvid[MAX_PLAYERS];
// Identity table scans are needed only when the live class changes. Explicit
// round snapshots invalidate this cache so new/updated definitions are resolved.
str uhsrvidentityclass[MAX_PLAYERS];
bool uhsrvidentityvalid[MAX_PLAYERS];
// Remaining rows in a per-client snapshot, drained by the server watch in
// bounded subject batches. A request can start at any watch cursor: the next
// MAX_PLAYERS subjects still cover every slot exactly once.
int uhsrvSnapshotRows[MAX_PLAYERS];
int uhsrvphase[MAX_PLAYERS];
str uhsrvphaseclass[MAX_PLAYERS];

// Stable identity for an actor class, or UH_PLDEF_NONE.  The >= 0 test is what
// rejects load-order-dependent custom ids.
function int UH_Ti_KindForClass(str cls) {
  if (FindSurvivorByActor(cls) >= 0) {return UH_PLDEF_SURVIVOR;}
  if (FindBossByActor(cls) >= 0) {return UH_PLDEF_BOSS;}
  if (FindEyeByActor(cls) >= 0) {return UH_PLDEF_EYE;}
  return UH_PLDEF_NONE;
}

function int UH_Ti_IdForClass(str cls) {
  int id = FindSurvivorByActor(cls);
  if (id >= 0) {return id;}
  id = FindBossByActor(cls);
  if (id >= 0) {return id;}
  id = FindEyeByActor(cls);
  if (id >= 0) {return id;}
  return 0;
}

// Occupies a team-info row: in the game, or a dead spectator.
// PlayerInGame is playeringame && !bSpectating, so a dead spectator reports
// false there.  PlayerIsSpectator returns 2 only for a dead spectator
// (GMF_DEADSPECTATORS) and 1 for a true spectator.  A true spectator is still
// connected for delivery (UH_Ti_IsConnectedClient) but must not keep a previous
// occupant's role or portrait.
function bool UH_Ti_IsConnectedPlayer(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return false;}
  if (PlayerInGame(pn)) {return true;}
  return PlayerIsSpectator(pn) == 2;
}

// Engine GetActorClass returns "None" for a missing body, not an empty string.
// Normalize it before any live-body / retained-presentation decision.
function str UH_Ti_ActorClass(int tid) {
  str actor = GetActorClass(tid);
  if (!StrICmp(actor, "None")) {return "";}
  return actor;
}

// Server-only: reads playerlifestatusarr, so it must never run on a pure client.
function void UH_Ti_IdentityForPlayer(int pn) {
  int kind = UH_PLDEF_NONE;
  int id = 0;
  if (pn >= 0 && pn < MAX_PLAYERS) {
    // PLS_NULL means the slot is finished.  Publishing anything for it would let
    // a reused slot inherit the previous player's face.  A never-used slot is
    // not connected, so it clears too.  The `= {-1}` initializer only writes
    // index 0; the other elements stay 0.
    if (playerlifestatusarr[pn] != PLS_NULL && UH_Ti_IsConnectedPlayer(pn)) {
      if (PlayerInGame(pn)) {
        str cls = UH_Ti_ActorClass(pn + 1000);
        if (StrCmp(cls, "") != 0) {
          if (uhsrvidentityvalid[pn] && !StrICmp(cls, uhsrvidentityclass[pn])) {
            kind = uhsrvkind[pn];
            id = uhsrvid[pn];
          } else {
            kind = UH_Ti_KindForClass(cls);
            if (kind != UH_PLDEF_NONE) {id = UH_Ti_IdForClass(cls);}
            uhsrvidentityclass[pn] = cls;
            // Unknown/custom bodies must be retried: an OPEN registration may
            // not have run yet, and custom ids never become wire identities.
            uhsrvidentityvalid[pn] = kind != UH_PLDEF_NONE;
          }
        } else {
          uhsrvidentityvalid[pn] = false;
        }
      }
      else {
        // Dead spectator (PlayerIsSpectator == 2): keep the identity resolved
        // while the body existed, so the dead row keeps its own face.  A true
        // spectator never reaches this branch.
        kind = uhsrvkind[pn];
        id = uhsrvid[pn];
      }
    }
    if (playerlifestatusarr[pn] == PLS_NULL || !UH_Ti_IsConnectedPlayer(pn)) {
      uhsrvphase[pn] = 0;
      uhsrvphaseclass[pn] = "";
      uhsrvidentityclass[pn] = "";
      uhsrvidentityvalid[pn] = false;
    }
    else if (playerlifestatusarr[pn] != PLS_DEAD) {
      str phaseclass = UH_Ti_ActorClass(pn + 1000);
      // A transient body-less morph retains its last stage until the new body
      // appears. A real class change re-evaluates the stage from scratch.
      if (StrLen(phaseclass)) {
        uhsrvphaseclass[pn] = phaseclass;
        uhsrvphase[pn] = UH_PlayerPresentationPhase(pn + 1000);
      }
    }
    // Death retains the final stage even after inventory/body removal.
    uhsrvkind[pn] = kind;
    uhsrvid[pn] = id;
  }
}

// Read the server identity cache without re-reading the actor.
function int UH_Ti_CachedKind(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return UH_PLDEF_NONE;}
  return uhsrvkind[pn];
}

function int UH_Ti_CachedId(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return 0;}
  return uhsrvid[pn];
}

// --- Per-client delivery ------------------------------------------------------
// CLIENTSIDE receivers must be delivered with NamedExecuteClientScript, which
// emits an SVCF_ONLYTHISCLIENT ACS command for exactly one client.  A plain
// ACS_NamedExecuteAlways call to a CLIENTSIDE script does not reliably reach
// remote clients from a dedicated server (on builds without the clientside
// broadcast branch it runs on the server only), which left uhtirole[]/uhtiova/
// uhtiscorepolicy unsynchronized and the TAB portraits blank.  Iterate every
// connected client explicitly instead.
function bool UH_Ti_IsConnectedClient(int pn) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return false;}
  // PlayerInGame == playeringame && !bSpectating; PlayerIsSpectator is
  // non-zero exactly for connected spectators.  Their union is playeringame,
  // which is what NamedExecuteClientScript (PLAYER_IsValidPlayer) accepts.
  if (PlayerInGame(pn)) {return true;}
  return PlayerIsSpectator(pn) != 0;
}

function void UH_Ti_SendStatusTo(int client, int pn, int status) {
  if (!UH_Ti_IsConnectedClient(client)) {return;}
  NamedExecuteClientScript("uh_ti_sync_status", client, pn, status,
    UH_Ti_CachedKind(pn), UH_Ti_CachedId(pn));
  NamedExecuteClientScript("uh_ti_sync_phase", client, pn,
    UH_Ti_CachedKind(pn), UH_Ti_CachedId(pn), uhsrvphase[pn]);
}

// Poll stages independently of health/stat visibility. Only changed subjects
// are broadcast; late joiners receive every stage through SendStatusTo.
function void UH_Ti_RefreshPhase(int pn) {
  int oldphase = uhsrvphase[pn];
  int oldkind = uhsrvkind[pn];
  int oldid = uhsrvid[pn];
  str oldclass = uhsrvphaseclass[pn];
  UH_Ti_IdentityForPlayer(pn);
  if (oldphase == uhsrvphase[pn] && oldkind == uhsrvkind[pn]
    && oldid == uhsrvid[pn] && !StrICmp(oldclass, uhsrvphaseclass[pn]))
    return;
  int status = UH_Ti_IsConnectedPlayer(pn) ? playerlifestatusarr[pn] : PLS_NULL;
  for (int c = 0; c < MAX_PLAYERS; c++) {
    UH_Ti_SendStatusTo(c, pn, status);
  }
}

function void UH_Ti_SendOneVsAllTo(int client, int active, int target) {
  if (!UH_Ti_IsConnectedClient(client)) {return;}
  NamedExecuteClientScript("uh_ti_sync_ova", client, active, target);
}

function void UH_Ti_SendScorePolicyTo(int client, int policy) {
  if (!UH_Ti_IsConnectedClient(client)) {return;}
  NamedExecuteClientScript("uh_ti_sync_policy", client, policy);
}

function void UH_TeamInfo_BroadcastStatus(int pn, int status) {
  if (pn < 0 || pn >= MAX_PLAYERS) {return;}
  UH_Ti_IdentityForPlayer(pn);
  for (int c = 0; c < MAX_PLAYERS; c++) {
    UH_Ti_SendStatusTo(c, pn, status);
  }
}

// 1-vs-all is defined by the ACTIVE bonus event's UHBE_FLAG_ONEVSALL, never
// by the target's current life status (uh_DemoneyeMorph rewrites it to PLS_EYE).
function bool UH_TeamInfo_IsOneVsAllActive(void) {
  if (!isbonuseventactive || bonuseventended) {return false;}
  int eid = eventdataarr[EVENTDATA_MAINEVENT];
  if (!IsBonusEventDefined(eid)) {return false;}
  return (GetBonusEventFlags(eid) & UHBE_FLAG_ONEVSALL) != 0;
}

function int UH_TeamInfo_OneVsAllTarget(void) {
  if (!UH_TeamInfo_IsOneVsAllActive()) {return -1;}
  int tid = bossdataarr[0][BOSSDATA_TID];
  if (tid < 1000 || tid > 1063) {return -1;}
  return tid - 1000;
}

// Authoritative scoreboard portrait policy for the ACTIVE round.  This is a
// separate synchronization from the frozen 1-vs-all split above: the teammate
// bar still keys on uhtiova/uhtiovatarget, while the scoreboard needs to tell
// FFA / normal / all-eye / multi-team apart and must fail closed.  The client
// must never infer the policy from server-only globals.
//
// Classification is exact: no active event is NORMAL; an active event with
// exactly one of the four policy flags maps to that policy; a defined event
// with none of them, or with more than one, is INVALID (never resolved by
// priority).  UHBE_FLAG_EYE_TEAM is orthogonal metadata and is ignored.
function int UH_TeamInfo_ScorePolicy(void) {
  if (!isbonuseventactive || bonuseventended) {return UH_SCOREPOLICY_NORMAL;}
  int eid = eventdataarr[EVENTDATA_MAINEVENT];
  if (!IsBonusEventDefined(eid)) {return UH_SCOREPOLICY_INVALID;}
  int f = GetBonusEventFlags(eid);
  int n = 0;
  if (f & UHBE_FLAG_FFA) {n++;}
  if (f & UHBE_FLAG_ONEVSALL) {n++;}
  if (f & UHBE_FLAG_ALL_EYE) {n++;}
  if (f & UHBE_FLAG_MULTITEAM) {n++;}
  if (n != 1) {return UH_SCOREPOLICY_INVALID;}
  if (f & UHBE_FLAG_FFA) {return UH_SCOREPOLICY_FFA;}
  if (f & UHBE_FLAG_ONEVSALL) {return UH_SCOREPOLICY_ONEVSALL;}
  if (f & UHBE_FLAG_ALL_EYE) {return UH_SCOREPOLICY_ALL_EYE;}
  return UH_SCOREPOLICY_MULTITEAM;
}

// Queue snapshots instead of sending N clients x 64 subjects in one script
// execution. Policies arrive immediately and again after each complete pass.
function void UH_TeamInfo_QueueSnapshot(int client, int repeats) {
  if (!UH_Ti_IsConnectedClient(client)) {return;}
  int rows = MAX_PLAYERS * repeats;
  // Coalesce requests without starving an in-progress snapshot.
  if (uhsrvSnapshotRows[client] < rows) {uhsrvSnapshotRows[client] = rows;}
  UH_Ti_SendOneVsAllTo(client,
    UH_TeamInfo_IsOneVsAllActive() ? 1 : 0, UH_TeamInfo_OneVsAllTarget());
  UH_Ti_SendScorePolicyTo(client, UH_TeamInfo_ScorePolicy());
}

// Called after this subject's identity/phase was refreshed, so every pending
// client reads the SAME cache without any per-client definition-table scans.
function void UH_Ti_SendSnapshotRow(int pn) {
  int status = UH_Ti_IsConnectedPlayer(pn) ? playerlifestatusarr[pn] : PLS_NULL;
  for (int c = 0; c < MAX_PLAYERS; c++) {
    if (uhsrvSnapshotRows[c] <= 0) {continue;}
    if (!UH_Ti_IsConnectedClient(c)) {
      uhsrvSnapshotRows[c] = 0;
      continue;
    }
    UH_Ti_SendStatusTo(c, pn, status);
    uhsrvSnapshotRows[c]--;
    if (uhsrvSnapshotRows[c] % MAX_PLAYERS == 0) {
      UH_Ti_SendOneVsAllTo(c,
        UH_TeamInfo_IsOneVsAllActive() ? 1 : 0, UH_TeamInfo_OneVsAllTarget());
      UH_Ti_SendScorePolicyTo(c, UH_TeamInfo_ScorePolicy());
    }
  }
}

function void UH_TeamInfo_SendSnapshotTo(int client) {
  UH_TeamInfo_QueueSnapshot(client, 1);
}

// Re-publish the frozen 1-vs-all split and the scoreboard policy on the same
// state boundaries (round setup, event commit, target freeze, event
// finish/abort, late-join snapshot) so a client never waits for a
// close-and-reopen cycle after a change.
function void UH_TeamInfo_BroadcastOneVsAll(void) {
  int active = UH_TeamInfo_IsOneVsAllActive() ? 1 : 0;
  int target = UH_TeamInfo_OneVsAllTarget();
  int policy = UH_TeamInfo_ScorePolicy();
  for (int c = 0; c < MAX_PLAYERS; c++) {
    UH_Ti_SendOneVsAllTo(c, active, target);
    UH_Ti_SendScorePolicyTo(c, policy);
  }
}

// Rebuild every connected client against the current server state.  Called at
// round setup and after the one-vs-all target freezes; the ENTER late join uses
// UH_TeamInfo_SendSnapshotTo for just the entering client.
function void UH_TeamInfo_FullSnapshot(void) {
  for (int c = 0; c < MAX_PLAYERS; c++) {
    uhsrvidentityvalid[c] = false;
    UH_TeamInfo_QueueSnapshot(c, 1);
  }
}

// Updates player status and total players with status, then pushes the change
// to every client so the teammate bar and TAB portraits see it on the next tic.
function void PlayerLifeStatusArr_UpdateFunc(int thedude, int newstatus) {
  totalplayersarr[playerlifestatusarr[thedude]]--;
  playerlifestatusarr[thedude] = newstatus;
  totalplayersarr[newstatus]++;
  if (newstatus == PLS_NULL) {uhsrvrole[thedude] = PLS_NULL;}
  else if (newstatus != PLS_DEAD) {uhsrvrole[thedude] = newstatus;}
  UH_TeamInfo_BroadcastStatus(thedude, newstatus);
}

// Give/Take Inventory items to/from EVERY ingame player.
function void GiveMeTheFunc(str hungry, int thebill) {
  if (thebill == 0) {thebill = 1;}

  if (thebill < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i)) {TakeActorInventory(i + 1000, hungry, -thebill);}
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j)) {GiveActorInventory(j + 1000, hungry, thebill);}
    }
  }
}

// Similar to above except it doesn't give/take to/from the specific TID, TheDude.
function void GiveMeTheFuncExcept(str h, int xx, int thedude) {
  if (xx == 0) {xx = 1;}
  if (xx < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i) && i + 1000 != thedude) {
        TakeActorInventory(i + 1000, h, -xx);
      }
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j) && j + 1000 != thedude) {
        GiveActorInventory(j + 1000, h, xx);
      }
    }
  }
}

// Similar to above except bosses
function void GiveMeTheFuncExceptBosses(str h, int xx) {
  if (xx == 0) {xx = 1;}
  if (xx < 0) {
    for (int i; i < MAX_PLAYERS; i++) {
      if (PlayerInGame(i) && playerlifestatusarr[i] != PLS_BOSS) {
        TakeActorInventory(i + 1000, h, -xx);
      }
    }
  }
  else {
    for (int j; j < MAX_PLAYERS; j++) {
      if (PlayerInGame(j) && playerlifestatusarr[j] != PLS_BOSS) {
        GiveActorInventory(j + 1000, h, xx);
      }
    }
  }
}

// Give/take inventory to/from the boss team.
function void GiveBossesTheFunc(str item, int amount) {
  if (amount == 0) {amount = 1;}
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i) && playerlifestatusarr[i] == PLS_BOSS) {
      GiveActorInventory(i + 1000, item, amount);
    }
  }
}

// Apply a rune mode to the boss team (Bad LMS reverse reward).
function void GiveBossesRune(int mode) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (PlayerInGame(i) && playerlifestatusarr[i] == PLS_BOSS) {
      ACS_NamedExecuteWithResult("uh_runeplayer", i + 1, 1, mode);
    }
  }
}

// Execute the script for each player.
function void ScriptMeTheFunc(str scriptname, int arg1, int arg2, int arg3, int arg4) {
  for (int i = 0; i < ServerMAX; i++) {
    SetActivator(i + 1000);
    ACS_NamedExecuteWithResult(scriptname, arg1, arg2, arg3, arg4);
  }
}

function void MakeAllPlayersInvun(void) {
  int playernum = 1000;
  until (playernum == 1064) {
    SetActorProperty(playernum, APROP_DamageFactor, 0.0);
    playernum++;
  }
}

// Presets a random number for EX Bosses delay
function void BossEXCountArr_Setter(int maxcount, int ran1, int ran2) {
  for (int i = 0; i < maxcount; i++) {
    bossexcountarray[i] = random(ran1, ran2);
  }
  // debugLog(StrParam(s:"BossEXCountArray randomized between values [",i:Ran1,s:"] and [",i:Ran2,s:"]!");}
}

function void PresetStrongmanCheck(int setter, int howfar) {
  for (int i = 0; i <= howfar; i++) {
    strongmancheck[i] = setter;
  }
  UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck Array set to value ", i:setter, s:" with a size of ", i:howfar, s:"."));
}

function void Add_StrongmanCheckArray(int thenum) {
  for (int i = 0; i <= 99; i++) {
    if (strongmancheck[i] == -1) {
      strongmancheck[i] = thenum;
      UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck value [", i:i, s:"] set to ", i:thenum, s:"."));
      break;
    }
  }
}
function void Minus_StrongmanCheckArray(void) {
  for (int i = 0; i < 99; i++) {
    if (strongmancheck[i] != -1) {
      strongmancheck[i] = strongmancheck[i + 1];
    }
    else {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"StrongmanCheck shifted over ", i:i, s:" time(s)."));
      break;
    }
  }
  strongmancheck[99] = -1;  // Keep the queue tail inside the documented 0-99 range.
}

function void AdjustPlayerForceNumArray(int swapper) {
  int i;
  switch (swapper) {
    case -1:  // Minus
      for (i = 0; i <= 64; i++) {
        if (playerforcenum[i] != 0) {
          playerforcenum[i] = playerforcenum[i + 1];
        }
        else {
          UH_Log(UH_LOG_DEBUG, StrParam(s:"PlayerForceNum shifted over ", i:i, s:" time(s)."));
          break;
        }
      }
      break;
    case 0:  // Reset
      for (i = 0; i <= 64; i++) {
        playerforcenum[i] = 0;
      }
      UH_Log(UH_LOG_DEBUG, StrParam(s:"Reset all PlayerForceNum to 0."));
      break;
    default:  // Add
      for (i = 0; i <= 64; i++) {
        if (playerforcenum[i] == 0) {
          playerforcenum[i] = swapper;
          UH_Log(UH_LOG_DEBUG, StrParam(s:"PlayerForceNum value [", i:i, s:"] set to ", i:swapper, s:"."));
          break;
        }
      }
      break;
  }
}

function bool RandomPercent(int chance) {
  return (random(1, 100) <= chance);
}

// --- Unified round-exit entry ------------------------------------------------
// Every Unholy-owned round settlement funnels its final map change through this
// script instead of calling Exit_Normal itself.
//
// Why: Exit_Normal runs CheckIfExitIsGood with the CALLING SCRIPT's activator
// (p_lnspec.cpp:850 -> p_spec.cpp:184).  A NULL activator is the world and always
// passes; any non-NULL actor is treated as "a player is using an exit line", so
// DF_NO_EXIT / sv_noexit applies and the exit telefrags that actor.  A settlement
// watcher can inherit a boss pawn as its activator (MorphActorToBoss ends with
// SetActivator(tid) and the watchers are started from the same script), so the
// round must never depend on whichever actor it happened to inherit.
//
// Contract:
//   - the activator is cleared on entry, BEFORE the delay, so no stale pawn is
//     acted on during the result window;
//   - only a core settlement owner starts it: the gameover / one-shot guards
//     stay with the callers;
//   - ACS_NamedExecute is single-instance (p_acs.cpp:13097), so a duplicate
//     start is a no-op and cannot reset the delay or race a second exit;
//   - the caller keeps owning result text, music, streak and event cleanup;
//   - never use ConsoleCommand("changemap"), and never rely on sv_noexit 0.
script "ub_ExitFinishedRound" (int delaytics) {
  SetActivator(0, AAPTR_NULL);
  if (delaytics > 0) {
    Delay(delaytics);
  }
  Exit_Normal(0);
}

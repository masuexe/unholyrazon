	DefineSurvivor(16, "HeavyGunner", "\c[UH16]Heavy Gunner", "C@ICN16");
	DefineSurvivor(17, "Raider", "\c[UH17]Raider", "C@ICN17");
	DefineSurvivor(18, "FlightUnit", "\c[UH18]Flight Unit", "C@ICN18");
	DefineSurvivor(19, "HeavyBomber", "\c[UH19]Heavy Bomber", "C@ICN19");
	DefineSurvivor(20, "Electrician", "\c[UH20]Electrician", "C@ICN20");

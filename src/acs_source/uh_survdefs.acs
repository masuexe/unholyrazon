script "uh_define_vanilla_survivors" OPEN
{
	if (!UHInPlay()) terminate;
	if (IsSurvivorDefined(0)) terminate;
	RegisterVanillaSurvivors();
}

// Joining clients never run non-CLIENTSIDE OPEN; fill local UHDT for HUD getters.
script "uh_define_vanilla_survivors_cs" OPEN CLIENTSIDE
{
	if (IsSurvivorDefined(0)) terminate;
	RegisterVanillaSurvivors();
}

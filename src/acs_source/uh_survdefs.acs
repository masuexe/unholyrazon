	DefineSurvivor(7, "Quickster", "\cjQuickster", "C@ICN7");
	DefineSurvivor(8, "TacticalBomber", "\cjTactical Bomber", "C@ICN8");
	DefineSurvivor(9, "FrostBite", "\cjFrost Bite", "C@ICN9");
	DefineSurvivor(10, "Igniter", "\cjIgniter", "C@ICN10");
	DefineSurvivor(11, "CloseCombatUnit", "\cjClose Combat Unit", "C@ICN11");
	DefineSurvivor(12, "Arcanist", "\cjArcanist", "C@ICN12");
	DefineSurvivor(13, "HomingSeeker", "\cjHoming Seeker", "C@ICN13");
	DefineSurvivor(14, "Trickster", "\cjTrickster", "C@ICN14");
	DefineSurvivor(15, "RageUnit", "\cjRage Unit", "C@ICN15");
	DefineSurvivor(16, "HeavyGunner", "\cjHeavy Gunner", "C@ICN16");
	DefineSurvivor(17, "Raider", "\cjRaider", "C@ICN17");
	DefineSurvivor(18, "FlightUnit", "\cjFlight Unit", "C@ICN18");
	DefineSurvivor(19, "HeavyBomber", "\cjHeavy Bomber", "C@ICN19");
	DefineSurvivor(20, "Electrician", "\cjElectrician", "C@ICN20");
	DefineSurvivor(21, "Slugger", "\cjSlugger", "C@ICN21");

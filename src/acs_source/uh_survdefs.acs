#library "uh_survdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla survivors: KEYCONF order == stable id 0..58. Hand-edit as needed.
// Mugshot = BHW SetFont name (C@ICN{id}), same patches as TEXTURES.classes.faces.
// Shiny class = actor + "Shiny" (not stored). DecoyBot has no player shiny.

function void RegisterVanillaSurvivors(void)
{
	DefineSurvivor(0, "MegaManU", "\c[UH00]Mega Man", "C@ICN0");
	DefineSurvivor(1, "Qwant", "\c[UH01]Qwant", "C@ICN1");
	DefineSurvivor(2, "NegaMan", "\c[UH02]Nega Man", "C@ICN2");
	DefineSurvivor(3, "BusterExpert", "\c[UH03]Buster Expert", "C@ICN3");

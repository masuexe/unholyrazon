#library "uh_survdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla survivors: KEYCONF order == stable id 0..58. Hand-edit as needed.
// Empty mugshot → GetSurvivorMugshot resolves to UMUG_{id}.
// Shiny class = actor + "Shiny" (not stored). DecoyBot has no player shiny.

function void RegisterVanillaSurvivors(void)
{
	DefineSurvivor(0, "MegaManU", "\cjMega Man", "");
	DefineSurvivor(1, "Qwant", "\cjQwant", "");
	DefineSurvivor(2, "NegaMan", "\cjNega Man", "");
	DefineSurvivor(3, "BusterExpert", "\cjBuster Expert", "");
	DefineSurvivor(4, "BusterMistress", "\cjBuster Mistress", "");
	DefineSurvivor(5, "GreatShielder", "\cjGreat Shielder", "");
	DefineSurvivor(6, "LuckyLass", "\cjLucky Lass", "");
	DefineSurvivor(7, "Quickster", "\cjQuickster", "");
	DefineSurvivor(8, "TacticalBomber", "\cjTactical Bomber", "");
	DefineSurvivor(9, "FrostBite", "\cjFrost Bite", "");
	DefineSurvivor(10, "Igniter", "\cjIgniter", "");
	DefineSurvivor(11, "CloseCombatUnit", "\cjClose Combat Unit", "");
	DefineSurvivor(12, "Arcanist", "\cjArcanist", "");
	DefineSurvivor(13, "HomingSeeker", "\cjHoming Seeker", "");
	DefineSurvivor(14, "Trickster", "\cjTrickster", "");
	DefineSurvivor(15, "RageUnit", "\cjRage Unit", "");
	DefineSurvivor(16, "HeavyGunner", "\cjHeavy Gunner", "");
	DefineSurvivor(17, "Raider", "\cjRaider", "");
	DefineSurvivor(18, "FlightUnit", "\cjFlight Unit", "");
	DefineSurvivor(19, "HeavyBomber", "\cjHeavy Bomber", "");
	DefineSurvivor(20, "Electrician", "\cjElectrician", "");
	DefineSurvivor(21, "Slugger", "\cjSlugger", "");
	DefineSurvivor(22, "Saboteur", "\cjSaboteur", "");
	DefineSurvivor(23, "StealthSniper", "\cjStealth Sniper", "");
	DefineSurvivor(24, "TangoGirl", "\cjTango Girl", "");
	DefineSurvivor(25, "BeerMan", "\cjBeer Man", "");
	DefineSurvivor(26, "TreeHugger", "\cjTree Hugger", "");
	DefineSurvivor(27, "GloryGuster", "\cjGlory Guster", "");
	DefineSurvivor(28, "SmokeBandit", "\cjSmoke Bandit", "");
	DefineSurvivor(29, "TheDentist", "\cjThe Dentist", "");
	DefineSurvivor(30, "Trapist", "\cjTrapist", "");
	DefineSurvivor(31, "AeroUnit", "\cjAero Unit", "");
	DefineSurvivor(32, "Rameses", "\cjRameses", "");
	DefineSurvivor(33, "SamuraiSam", "\cjSamurai Sam", "");
	DefineSurvivor(34, "Astronaut", "\cjAstronaut", "");
	DefineSurvivor(35, "SiteWorker", "\cjSite Worker", "");
	DefineSurvivor(36, "SumoWrestler", "\cjSumo Wrestler", "");
	DefineSurvivor(37, "TidalManiac", "\cjTidal Maniac", "");
	DefineSurvivor(38, "Tristana", "\cjTristana", "");
	DefineSurvivor(39, "PartyBomber", "\cjParty Bomber", "");
	DefineSurvivor(40, "Marksman", "\cjMarksman", "");
	DefineSurvivor(41, "HandyMan", "\cjHandy Man", "");
	DefineSurvivor(42, "CaptainAss", "\cjCaptain Ass", "");
	DefineSurvivor(43, "Lim", "\cjLim", "");
	DefineSurvivor(44, "RedWarrior", "\cjRed Warrior", "");
	DefineSurvivor(45, "BlueValkyrie", "\cjBlue Valkyrie", "");
	DefineSurvivor(46, "YellowWizard", "\cjYellow Wizard", "");
	DefineSurvivor(47, "GreenElf", "\cjGreen Elf", "");

#library "uh_eyedefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla demoneyes: sparse ids match uh_DemoneyeMorph / weapon CallACS args.
// Mugshot = BHW SetFont name (EYE_F{n}). eventStem builds {stem}_MoolaGiver.
// flags: 0 or UHEYE_FLAG_NOSUFFIX (omit " Demoneye" in YouAreNow).
// Bonus face-only ids (100/106/111) omit actor — share base morph class.
// ArenaDemoneye / FoxDemoneye300 stay DefineBoss, not here.

function void RegisterVanillaDemoneyes(void)
{
	DefineDemoneye(0, "PlainDemoneye", "Plain", "a \ct", 0, "EYE_F0", "Plain");
	DefineDemoneye(1, "MLGDemoneye", "MLG", "a \cq", 0, "EYE_F1", "MLG");
	DefineDemoneye(2, "GhostDemoneye", "Ghost", "a \cj", 0, "EYE_F2", "Ghost");
	DefineDemoneye(3, "JoustDemoneye", "Joust", "a \cu", 0, "EYE_F3", "Joust");
	DefineDemoneye(4, "SumoDemoneye", "Sumo", "a \cj", 0, "EYE_F4", "Sumo");
	DefineDemoneye(5, "KamikazeDemoneye", "Kamikaze", "a \cr", 0, "EYE_F5", "Kamikaze");
	DefineDemoneye(6, "RichDemoneye", "Rich", "a \cd", 0, "EYE_F6", "Rich");
	DefineDemoneye(7, "BomberDemoneye", "Bomber", "a \cj", 0, "EYE_F7", "Bomber");
	DefineDemoneye(8, "BusinessDemoneye", "Business", "a \cm", 0, "EYE_F8", "Business");
	DefineDemoneye(9, "QuickDemoneye", "Quick", "a \cl", 0, "EYE_F9", "Quick");
	DefineDemoneye(10, "TankDemoneye", "Tank", "a \ct", 0, "EYE_F10", "Tank");
	DefineDemoneye(11, "EyelentoDemoneye", "Eyelento", "an \cf", 0, "EYE_F11", "Eyelento");
	DefineDemoneye(12, "AlienDemoneye", "Speciman Jr", "a \ca", UHEYE_FLAG_NOSUFFIX, "EYE_F12", "Alien");
	DefineDemoneye(13, "DarkPurpleClone", "Dark Purple Clone", "a \cm", UHEYE_FLAG_NOSUFFIX, "EVE_F0", "PurpleClone");
	DefineDemoneye(30, "FoxDemoneye", "Fox", "a \ci", 0, "EYE_F30", "Fox");
	DefineDemoneye(31, "FurryDemoneye", "Furry", "a \co", 0, "EYE_F31", "Furry");

	// Bonus / Devil face variants (Inventory amount = base + Bonus*100)
	DefineDemoneye(100, "", "Plain", "a \ct", 0, "EYE_F100", "Plain");
	DefineDemoneye(106, "", "Rich", "a \cd", 0, "EYE_F106", "Rich");
	DefineDemoneye(111, "", "Eyelento", "an \cf", 0, "EYE_F111", "Eyelento");
}

script "uh_define_vanilla_eyes" OPEN
{
	if (!UHInPlay()) terminate;
	if (IsEyeDefined(0)) terminate;
	RegisterVanillaDemoneyes();
}

script "uh_define_vanilla_eyes_cs" OPEN CLIENTSIDE
{
	if (IsEyeDefined(0)) terminate;
	RegisterVanillaDemoneyes();
}

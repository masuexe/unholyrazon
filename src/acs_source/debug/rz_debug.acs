  HudMessage(s:"\c[AlertRedTrans2]*DANGER* \cr[2. RedTrans2] \c[AlertRedTrans2]IS ENRAGED! *DANGER*"; 0, 5003, CR_UNTRANSLATED, 320.4, 76.0, 0);
  HudMessage(s:"\c[AlertRedTrans3]*DANGER* \cr[3. RedTrans3] \c[AlertRedTrans3]IS ENRAGED! *DANGER*"; 0, 5004, CR_UNTRANSLATED, 320.4, 94.0, 0);
  HudMessage(s:"\c[AlertWhite]*DANGER* \cr[4. AlertWhite] \c[AlertWhite]IS ENRAGED! *DANGER*"; 0, 5005, CR_UNTRANSLATED, 320.4, 112.0, 0);
}

world int 50:uh_probe_fb;
world int 51:uh_probe_zc;
world int 52:uh_probe_zp;
world int 53:uh_probe_sbe_ammo_len;
world int 54:uh_probe_sbe_cyan;
world int 55:uh_probe_sbe_blue;
world int 56:uh_probe_sbe_max;

script "rz_debug_fb_probe" (void) {
  SetActivatorToPlayer(0);
  uh_probe_fb = ACS_NamedExecuteWithResult("uh_fb_count");
  uh_probe_zc = ACS_NamedExecuteWithResult("uh_zb_check");
  uh_probe_zp = ACS_NamedExecuteWithResult("uh_zb_phase");
  uh_probe_sbe_ammo_len = StrLen(ACS_NamedExecuteWithResult("uh_fb_string", 0, 2));
  uh_probe_sbe_cyan = ACS_NamedExecuteWithResult("uh_fb_int", 0, 0);
  uh_probe_sbe_blue = ACS_NamedExecuteWithResult("uh_fb_int", 0, 1);
  uh_probe_sbe_max = ACS_NamedExecuteWithResult("uh_fb_int", 0, 2);
}


// --- Team presentation database check ----------------------------------------
// Runs on the client that pukes it (puke rz_debug_TeamPresentationCheck), so it
// verifies the LOCAL table the HUD actually resolves from.  Every registered
// presentation row must resolve to a name, and every live player's class must
// either have a presentation row or be reported as unknown — that is the
// addon-author's signal that a DefineTeamPresentation call is missing.
script "rz_debug_TeamPresentationCheck" (void) CLIENTSIDE {
  int fails = 0;
  int i;
  int pn;
  str cls;
  str name;

  for (i = 0; i < GetTeamPresentationCount(); i++) {
    cls = GetTeamPresentationActor(i);
    if (StrCmp(cls, "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: empty actor at row ", i:i));
      fails++;
      continue;
    }
    // The row must be reachable through the public lookup, not just by index.
    if (FindTeamPresentation(cls) != i) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: row does not resolve: ", s:cls));
      fails++;
    }
    name = UH_PlayerDisplayName(cls);
    if (StrCmp(name, "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: no display name for ", s:cls));
      fails++;
    }
    // Full dump at DEBUG so an addon author can confirm their row landed.
    UH_Log(UH_LOG_DEBUG, StrParam(s:"TeamPresentationCheck: row ", s:cls,
      s:" -> name=", s:name,
      s:" portrait=", s:UH_PlayerPortrait(cls),
      s:" scoreIcon=", s:UH_PlayerScoreIcon(cls)));
  }

  // Live players: log what the HUD would actually resolve.  A class with no
  // presentation row has no teammate-bar face, which is the addon-author's
  // signal that a DefineTeamPresentation call is missing.
  for (pn = 0; pn < MAX_PLAYERS; pn++) {
    if (!PlayerInGame(pn)) { continue; }
    cls = GetActorClass(pn + 1000);
    if (StrCmp(cls, "") == 0) { continue; }
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamPresentationCheck: player ", i:pn,
      s:" ", s:cls, s:" -> name=", s:UH_PlayerDisplayName(cls),
      s:" portrait=", s:UH_PlayerPortrait(cls),
      s:" scoreIcon=", s:UH_PlayerScoreIcon(cls)));
    if (FindTeamPresentation(cls) != UHTIP_NONE) { continue; }
    // Only a real definition class is a bug; a plain morph body is expected.
    if (UH_FindPlayerDefinition(cls) != UH_PLDEF_PRESENTATION) {
      UH_Log(UH_LOG_WARN, StrParam(s:"TeamPresentationCheck: no presentation row for ", s:cls));
    }
  }

  if (fails == 0) {
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamPresentationCheck: ",
      i:GetTeamPresentationCount(), s:" rows ok"));
  }
  SetResultValue(fails);
}

// --- Server-side team-info identity cache -----------------------------------
// Run on the SERVER:
//   puke rz_debug_TeamInfoSlots [probeFrom] [probeTo]
// probeTo is exclusive.  Slots in [probeFrom, probeTo) are always logged,
// including a real unconnected PLS_NULL slot.  Outside that range those empty
// slots are still skipped.  Passing 0 0 therefore logs only occupied rows.
//
// "TeamInfoSlots: begin" is the dump boundary.  The engine log is append-only,
// so a reader must parse from the LAST begin.  Starting at the last "slot"
// line keeps only that one row.
//
// A slot with PlayerIsSpectator == 2 is a dead spectator and must keep its
// retained identity.  A slot nobody occupies must publish none.
script "rz_debug_TeamInfoSlots" (int probeFrom, int probeTo) {
  if (probeFrom < 0) { probeFrom = 0; }
  if (probeTo > MAX_PLAYERS) { probeTo = MAX_PLAYERS; }
  if (probeTo < probeFrom) { probeTo = probeFrom; }
  UH_Log(UH_LOG_INFO, StrParam(s:"TeamInfoSlots: begin ", i:probeFrom, s:" ", i:probeTo));
  for (int i = 0; i < MAX_PLAYERS; i++) {
    bool connected = UH_Ti_IsConnectedPlayer(i);
    bool inProbe = (i >= probeFrom && i < probeTo);
    if (!inProbe && !connected && playerlifestatusarr[i] == PLS_NULL) { continue; }
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamInfoSlots: slot ", i:i,
      s:" connected=", i:connected,
      s:" ingame=", i:PlayerInGame(i),
      s:" spec=", i:PlayerIsSpectator(i),
      s:" life=", i:playerlifestatusarr[i],
      s:" kind=", i:uhsrvkind[i],
      s:" id=", i:uhsrvid[i]));
  }
}

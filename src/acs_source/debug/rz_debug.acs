// Server-console/MCP convenience wrapper for the CustomInventory test item.
// In a normal game the item is used through the inventory key; this wrapper
// makes the same Use state reachable when no client key event is available.
script "rz_debug_FloovyOutOfBody" (void) {
  int playernum = ConsolePlayerNumber();
  if (playernum < 0) {
    playernum = 0;
  }
  if (!SetActivatorToPlayer(playernum)) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_FloovyOutOfBody: no live player"));
    terminate;
  }
  // The item's Use state deliberately ends in `fail` so the reusable debug
  // item is not consumed; do not interpret UseInventory's return value as a
  // failure signal here.
  if (CheckInventory("FloovyOutOfBodyDebugItem") <= 0 ||
      CheckInventory("FloovyOutOfBodyProtect") > 0) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_FloovyOutOfBody: item unavailable or already active"));
    terminate;
  }
  UseInventory("FloovyOutOfBodyDebugItem");
}

script "rz_debug_MorphMe" (int type, int num) {
  ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false);
  UnMorphActor(0, 1);
  bool res = MorphMeToBoss(type, num);
  if (res) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Morph successful!"));
  }
  else {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"Morph failed!"));
  }
}

// Real, non-extreme player death for testing class death effects.
// SetActorProperty(APROP_Health, 0) calls AActor::Die, so this preserves the
// engine's player-death bookkeeping while avoiding `kill`'s gib health.
// Clear MM8BDM/UH route markers first so ClassDeath reaches MegamanDeath0.
script "rz_debug_NormalSuicide" (void) {
  int playernum = PlayerNumber();
  if (playernum < 0) {
    playernum = ConsolePlayerNumber();
    if (playernum < 0) {
      playernum = 0;
    }
    if (!SetActivatorToPlayer(playernum)) {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_NormalSuicide: no live player"));
      terminate;
    }
  }

  if (PlayerIsSpectator(playernum) || GetActorProperty(0, APROP_Health) <= 0) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_NormalSuicide: player is dead or spectating"));
    terminate;
  }

  TakeInventory("CriticalDeath", 1);
  TakeInventory("CorpseFlag", 1);
  TakeInventory("ExplodeDeathFlag", 1);
  TakeInventory("FallingDeathFlag", 1);
  TakeInventory("FlingDeathFlag", 1);
  TakeInventory("RisingDeathFlag", 1);
  TakeInventory("IceDeathFlag", 1);
  TakeInventory("FireDeathFlag", 1);
  TakeInventory("ShrinkDeathFlag", 1);
  SetActorProperty(0, APROP_Health, 0);
}

function bool MorphMeToBoss(int type, int bossnum) {
  int tid = ActivatorTID();
  if (tid == 0)
    tid = PlayerNumber() + 1000;
  if (!SetActivator(tid))
    return false;

  if (type == 0) {
    str morphname = GetBossActor(bossnum);
    if (bossnum == 1066) morphname = "WeakHorse";
    else if (bossnum == 1113) morphname = "ProtoManBadGuy";
    else
      return MorphActorToBoss(tid, bossnum, "GigaAstroExplode");
    if (StrCmp(morphname, "") == 0)
      return false;
    ACS_NamedExecuteWithResult("uh_MorphPreReset");
    bool okoverride = MorphActor(0, morphname, "", 0x7ffffffd, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "");
    if (!okoverride) {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_MorphMe: MorphActor failed for ", s:morphname));
      return false;
    }
    SetActivator(tid);
    ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
    GiveInventory("BasicBossItem", 1);
    GiveInventory("MorphedFlag", 1);
    GiveInventory("BAWS", 1);
    return true;
  }

  str eyeactor = GetEyeActor(bossnum);
  if (StrCmp(eyeactor, "") == 0) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_MorphMe: GetEyeActor(", i:bossnum, s:") empty (IsEyeDefined=", i:IsEyeDefined(bossnum), s:")"));
    return false;
  }
  bool ok = MorphActor(0, eyeactor, "", 0x7ffffffd, MRF_FULLHEALTH | MRF_WHENINVULNERABLE | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "");
  if (!ok) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"rz_debug_MorphMe: MorphActor failed for ", s:eyeactor));
    return false;
  }
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_DemoneyeMorph", bossnum);
  return true;
}

// Observe authoritative air-jump energy while jumping on a remote client.
// Run while morphed: pukename rz_debug_GBAirTest, then jump within 5 seconds.
script "rz_debug_GBAirTest" (void) {
  if (!CheckActorClass(0, "GENERICBOSS")) {
    UH_Log(UH_LOG_DEBUG, "[GBTest] not GENERICBOSS");
    terminate;
  }
  int lastused = CheckInventory("AirJumpsUsed");
  UH_Log(UH_LOG_DEBUG, StrParam(s:"[GBTest] start ammo=", i:CheckInventory("UnholyBossAmmo100"),
      s:" airjumpz=", i:ACS_NamedExecuteWithResult("core_GetCustomActorProperty", 0, 64)));
  for (int i = 0; i < 175; i++) {
    int used = CheckInventory("AirJumpsUsed");
    if (used != lastused) {
      UH_Log(UH_LOG_DEBUG, StrParam(s:"[GBTest] used=", i:used,
          s:" ammo=", i:CheckInventory("UnholyBossAmmo100")));
      lastused = used;
    }
    Delay(1);
  }
}

// HUD bar residue probe: logs the LuckyLass selector state under the current
// pawn. Run while morphed or after a class/weapon switch:
//   pukename rz_debug_BarResidue
script "rz_debug_BarResidue" (void) {
  UH_Log(UH_LOG_INFO, StrParam(s:"[BarResidue] wep=", s:GetWeapon(),
      s:" LuckyLassSelector=", i:CheckInventory("UHBar_LuckyLass_P1L0Selector")));
}

// Prepare a carrier spawned by FloovyOutOfBodyDebugItem.  The carrier's
// TARGET pointer is the item owner, so this remains valid for a morphed
// player whose current actor has TID 0.  The carrier then transfers both
// pointers directly to FloovyGhost.
script "rz_debug_FloovyOutOfBodyPrepare" (void) {
  if (!SetPointer(AAPTR_TRACER, 0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }

  int playernum = PlayerNumber();
  if (playernum < 0 || !PlayerInGame(playernum) || PlayerIsSpectator(playernum) || PlayerHealth() <= 0) {
    SetResultValue(0);
    terminate;
  }
  if (CheckInventory("FloovyOutOfBodyProtect") > 0) {
    SetResultValue(0);
    terminate;
  }

  int linktid = ACS_NamedExecuteWithResult("core_uniquetid", 0, 1);
  if (linktid <= 0) {
    SetResultValue(0);
    terminate;
  }
  // Debug mode uses the player as both the Floovy owner and the hit target.
  // Clear stale links before installing the new effect instance.
  // ACS TakeInventory treats amount <= 0 as a no-op (the DECORATE action's
  // amount 0 means "all"), so use a positive saturating amount here.
  int oldlinktid = CheckInventory("FloovyOutOfBodyTID");
  if (oldlinktid > 0) {
    ACS_NamedExecuteWithResult("rz_FloovyGhostCancel", oldlinktid);
  }
  TakeInventory("FloovyOutOfBodyTID", 0x7fffffff);
  TakeInventory("FloovyOutOfBodyViewTID", 0x7fffffff);
  GiveInventory("FloovyOutOfBodyTID", linktid);
  GiveInventory("FloovyOutOfBodyViewTID", linktid);
  GiveInventory("FloovyOutOfBodyProtect", 1);
  SetResultValue(1);
}

script "rz_debug_setdecoyslot" (int slot, int num) {
  if (num < 1 || num > 3) {
    num = 1;
  }
  str item = StrParam(s:"DecoyBotFlag", i:num);
  SetInventory(item, slot);
}


  uh_probe_sbe_blue = ACS_NamedExecuteWithResult("uh_fb_int", 0, 1);
  uh_probe_sbe_max = ACS_NamedExecuteWithResult("uh_fb_int", 0, 2);
}


// --- Team presentation database check ----------------------------------------
// Runs on the client that pukes it (puke rz_debug_TeamPresentationCheck), so it
// verifies the LOCAL table the HUD actually resolves from.  Every registered
// presentation row must resolve to a name, and every live player's class must
// either have a presentation row or be reported as unknown — that is the
// addon-author's signal that a DefineTeamPresentation call is missing.
script "rz_debug_TeamPresentationCheck" (void) CLIENTSIDE {
  int fails = 0;
  int i;
  int pn;
  int count;
  str cls;
  str name;

  count = GetTeamPresentationCount();
  for (i = 0; i < count; i++) {
    // The per-row lookups scan the definition tables; yield every few rows so a
    // large table cannot trip the ~2M-instruction runaway budget in one tic.
    if (i > 0 && i % 8 == 0) {
      Delay(1);
    }
    cls = GetTeamPresentationActor(i);
    if (StrCmp(cls, "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: empty actor at row ", i:i));
      fails++;
      continue;
    }
    // The row must be reachable through the public lookup, not just by index.
    if (FindTeamPresentation(cls) != i) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: row does not resolve: ", s:cls));
      fails++;
    }
    name = UH_PlayerDisplayName(cls);
    if (StrCmp(name, "") == 0) {
      UH_Log(UH_LOG_ERROR, StrParam(s:"TeamPresentationCheck: no display name for ", s:cls));
      fails++;
    }
    // Full dump at DEBUG so an addon author can confirm their row landed.
    UH_Log(UH_LOG_DEBUG, StrParam(s:"TeamPresentationCheck: row ", s:cls,
      s:" -> name=", s:name,
      s:" portrait=", s:UH_PlayerPortrait(cls),
      s:" scoreIcon=", s:UH_PlayerScoreIcon(cls)));
  }

  // Live players: log what the HUD would actually resolve.  A class with no
  // presentation row has no teammate-bar face, which is the addon-author's
  // signal that a DefineTeamPresentation call is missing.
  for (pn = 0; pn < MAX_PLAYERS; pn++) {
    if (!PlayerInGame(pn)) {continue;}
    cls = GetActorClass(pn + 1000);
    if (StrCmp(cls, "") == 0) {continue;}
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamPresentationCheck: player ", i:pn,
      s:" ", s:cls, s:" -> name=", s:UH_PlayerDisplayName(cls),
      s:" portrait=", s:UH_PlayerPortrait(cls),
      s:" scoreIcon=", s:UH_PlayerScoreIcon(cls)));
    if (FindTeamPresentation(cls) != UHTIP_NONE) {continue;}
    // Only a real definition class is a bug; a plain morph body is expected.
    if (UH_FindPlayerDefinition(cls) != UH_PLDEF_PRESENTATION) {
      UH_Log(UH_LOG_WARN, StrParam(s:"TeamPresentationCheck: no presentation row for ", s:cls));
    }
  }

  if (fails == 0) {
    UH_Log(UH_LOG_INFO, StrParam(s:"TeamPresentationCheck: ",
      i:GetTeamPresentationCount(), s:" rows ok"));
  }
  SetResultValue(fails);
}

// Server-side team-info identity dumps live in the `unholy` library
// (`uh_ti_ServerSlotsDump` in uh_teaminfo.acs).  ACS globals are per-library,
// so a copy here would read a different, never-written uhsrvkind[] and always
// report kind=0.

// Runtime-test helper: force a player into death so the dead-spectator path can
// be exercised deterministically.  A bot duel can stalemate for minutes, which
// makes a "wait until someone dies" test flaky.  Server side only:
//   pukename rz_debug_KillPlayerSlot <slot>
// Players are addressed by the engine's player pointers (AAPTR_PLAYER1 << slot),
// not by TIDs, so this works on a dedicated server.
script "rz_debug_KillPlayerSlot" (int slot) {
  if (slot < 0 || slot >= MAX_PLAYERS) {terminate;}
  if (!PlayerInGame(slot)) {terminate;}
  SetActivator(0, AAPTR_PLAYER1 << slot);
  Thing_Damage(0, 100000, 0);
}

// Focused stage portrait probe. Run on a client; verifies both local variant
// rows and the raw/scaled assets without reading remote inventories.
script "rz_debug_BossPhaseCheck" (void) CLIENTSIDE {
  int fails = 0;
  str actor;
  str ordinary;
  str angry;
  str raw;
  for (int i = 0; i < 2; i++) {
    if (i == 0) {
      actor = "TimemanC"; ordinary = "UB091MUG"; angry = "UB091MPG"; raw = "PFACE91";
    } else {
      actor = "KFCDragon756"; ordinary = "UB069MUG"; angry = "UB069MPG"; raw = "PFACE69";
    }
    if (StrICmp(UH_PlayerPhasePortrait(actor, 0), ordinary)) {fails++;}
    if (StrICmp(UH_PlayerPhasePortrait(actor, 1), angry)) {fails++;}
    if (StrICmp(UH_PlayerPhaseScoreIcon(actor, 1), angry)) {fails++;}
    if (StrICmp(UH_PlayerPhaseBossMug(actor, 1), raw)) {fails++;}
    if (StrICmp(UH_PlayerPhasePortrait(actor, 255), ordinary)) {fails++;}
    if (!CheckFont(ordinary) || !CheckFont(angry) || !CheckFont(raw)) {fails++;}
  }
  UH_Log(UH_LOG_INFO, StrParam(s:"BossPhaseCheck: failures=", i:fails));
  SetResultValue(fails);
}

// Server diagnostic: phase -1 freezes/protects the subject for a HUD probe;
// 0/1 also clear/set the existing gameplay flag for the two migrated bosses.
// It does not send HUD packets: production watchers must observe the change.
script "rz_debug_SetPortraitPhase" (int pn, int phase) {
  if (pn < 0 || pn >= MAX_PLAYERS || phase < -1 || phase > 1
    || !PlayerInGame(pn) || !GetCVar("sv_cheats")) {terminate;}
  int tid = pn + 1000;
  if (!SetActivator(tid)) {terminate;}
  SetActorProperty(tid, APROP_Invulnerable, true);
  SetPlayerProperty(0, true, PROP_TOTALLYFROZEN);
  str actor = GetActorClass(tid);
  if (StrICmp(actor, "TimemanC") && StrICmp(actor, "KFCDragon756")) {terminate;}
  if (phase == 0) {TakeInventory("IsPissedFlag", 999);}
  else if (phase == 1) {GiveInventory("IsPissedFlag", 1);}
  UH_Log(UH_LOG_INFO, StrParam(s:"BossPhaseSet: slot=", i:pn, s:" actor=", s:actor,
    s:" phase=", i:UH_PlayerPresentationPhase(tid), s:" hp=", i:GetActorProperty(tid, APROP_Health)));
}

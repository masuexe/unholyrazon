#library "mmsp_script"
#include "zcommon.acs"
#include "8BDMLIB.acs"

// Health scaling based on Players in game
script "sp_enemystart" (void) {
  Delay(1);
  ACS_NamedExecuteAlways("sp_enemypain", 0);
  if (CheckInventory("HealthScaled")) {terminate;}
  SetActorProperty(0, APROP_Health, GetActorProperty(0, APROP_Health) +
                                    GetActorProperty(0, APROP_Health) * PlayerCount() / 4);
  GiveInventory("HealthScaled", 1);
}

script "sp_enemypain" (void) {
  if (CheckInventory("BoostFlag") > 0) {terminate;}  // Do not run twice for one monster
  int hp = GetActorProperty(0, APROP_Health);
  GiveInventory("BoostFlag", 1);
  while (GetActorProperty(0, APROP_Health) > 0) {
    if (hp != GetActorProperty(0, APROP_Health)) {
      PlayActorSound(0, SOUND_Pain, CHAN_BODY, 1.0, false, ATTN_NORM);
      SetActorProperty(0, APROP_RenderStyle, STYLE_None);
      Delay(1);
      SetActorProperty(0, APROP_RenderStyle, STYLE_Normal);
      hp = GetActorProperty(0, APROP_Health);
    }
    Delay(4);
  }
}

script "sp_overflowcheck_TellyEnemyU" (int maxamount) {
  if (ThingCountName("TellyEnemyU", 0) > maxamount) {
    SetActorState(0, "Despawn");
  }
}

script "sp_overflowcheck_ChuncoU" (int maxamount) {
  if (ThingCountName("ChuncoU", 0) > maxamount) {
    SetActorState(0, "Despawn");
  }
}

script "sp_overflowcheck_FireTelly" (int maxamount) {
  if (ThingCountName("FireTellyEnemyU", 0) > maxamount) {
    SetActorState(0, "Despawn");
  }
}

script "sp_FireTellyDropFlames" (void) {
  while (GetActorProperty(0, APROP_Health) > 0) {
    Delay(70);
    if (GetActorProperty(0, APROP_Health) <= 0) {terminate;}
    SetActorState(0, "DropFlame");
  }
}

script "sp_overflowcheck_SpaceMetall" (int maxamount) {
  if (ThingCountName("SpaceMetallU", 0) > maxamount) {
    SetActorState(0, "Despawn");
  }
}

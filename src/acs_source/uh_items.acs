// Crooked Penny: double or strip all DefineUnholyItem identities (UHDT tables, no UHADD roundtrips).
function void CrookedPennyMutateActor(str actor, bool lucky) {
	int count = CheckInventory(actor);
	if (count <= 0)
		return;
	if (lucky) {
		GiveInventory(actor, count);
		return;
	}
	if (StrCmp(actor, "SuperGUHUItem") == 0 && CheckInventory("SuperGuhuDoomFlag"))
		count--;
	if (count > 0)
		TakeInventory(actor, count);
}

script "rz_CrookedPennyRolling" (void) {
	bool lucky = random(0, 1);
	int id;
	int i;

	for (id = 0; id < UH_MAX_VANILLA_ITEM; id++) {
		if (uh_itemvanilladefined[id] == 0)
			continue;
		CrookedPennyMutateActor(uh_itemvanillastr[id][UHITEM_STR_ACTOR], lucky);
	}
	for (i = 0; i < uh_itemcustomcount; i++) {
		CrookedPennyMutateActor(uh_itemcustomstr[i][UHITEM_STR_ACTOR], lucky);
	}

	if (!lucky) {
		GiveInventory("DLC_CoinItem", 1);
		PlaySound(0, "items/SoUnlucky", 5);
	}
}

// Eternal D6: defer gives so newly rolled items are not re-processed in the same pass.
#define UH_EDEN_D6_PENDING_MAX 256
str uh_edend6pendinggive[UH_EDEN_D6_PENDING_MAX];
int uh_edend6pendingcount;

function void EternalD6QueueGive(str actor) {
	if (StrCmp(actor, "") == 0)
		return;
	if (uh_edend6pendingcount >= UH_EDEN_D6_PENDING_MAX)
		return;
	uh_edend6pendinggive[uh_edend6pendingcount] = actor;
	uh_edend6pendingcount++;
}

function void EternalD6ProcessActor(str actor) {
	int count;
	int itemid;
	int boxid;
	int coinid;
	int u;
	int newid;
	str giveactor;

	count = CheckInventory(actor);
	if (count <= 0)
		return;
	if (StrCmp(actor, "SuperGUHUItem") == 0 && CheckInventory("SuperGuhuDoomFlag"))
		count--;
	if (count <= 0)
		return;

	itemid = FindItemByActor(actor);
	if (itemid == UHITEM_FAIL)
		return;
	coinid = FindItemByActor("DLC_CoinItem");
	if (itemid == coinid)
		return;
	if (IsUnholyBox(itemid))
		return;

	for (u = 0; u < count; u++) {
		boxid = PickItemHomeBoxEdenD6(itemid);
		if (boxid == UHITEM_FAIL)
			continue;
		if (ItemBoxWeightSumEdenD6(boxid, itemid) <= 0)
			continue;
		TakeInventory(actor, 1);
		if (random(0, 99) < 75) {
			newid = RandomItemFromBoxEdenD6(boxid, itemid);
			if (newid != UHITEM_FAIL) {
				giveactor = GetItemActor(newid);
				EternalD6QueueGive(giveactor);
			}
		}
	}
}

script "rz_EternalD6Rolling" (void) {
	int id;
	int i;

	uh_edend6pendingcount = 0;

	for (id = 0; id < UH_MAX_VANILLA_ITEM; id++) {
		if (uh_itemvanilladefined[id] == 0)
			continue;
		EternalD6ProcessActor(uh_itemvanillastr[id][UHITEM_STR_ACTOR]);
	}
	for (i = 0; i < uh_itemcustomcount; i++) {
		EternalD6ProcessActor(uh_itemcustomstr[i][UHITEM_STR_ACTOR]);
	}

	for (i = 0; i < uh_edend6pendingcount; i++)
		GiveInventory(uh_edend6pendinggive[i], 1);
}

// LMS death drops: razon3 rz_TakeAndDropFullItems, but walk DefineUnholyItem
// instead of the hardcoded fullItemList. DropItem spawns a pickup; Take clears
// inventory. Coins become one money bag (lossy, same brackets as razon3).
function str GetMoneyBagType(int credit) {
	int n;

	if (credit <= 0)
		return "";
	if (credit == 9999)
		return "DLCMoneyBag9999";
	if (credit >= 1000) {
		n = credit / 1000;
		if (n > 9)
			n = 9;
		return StrParam(s:"DLCMoneyBag", i:n * 1000);
	}
	if (credit >= 100)
		return StrParam(s:"DLCMoneyBag", i:(credit / 100) * 100);
	return "DLCMoneyBag";
}

function void TakeAndDropUnholyActor(str actor) {
	int count;
	str bag;

	if (StrCmp(actor, "") == 0)
		return;
	count = CheckInventory(actor);
	if (count <= 0)
		return;
	if (StrICmp(actor, "DLC_CoinItem") == 0) {
		bag = GetMoneyBagType(count);
		if (StrCmp(bag, "") != 0)
			DropItem(0, bag, 1);
		TakeInventory(actor, count);
		return;
	}
	DropItem(0, actor, count);
	TakeInventory(actor, count);
}

script "UH_DropItemsOnDeath" (void) {
	int id;
	int i;
	int treasure;

	for (id = 0; id < UH_MAX_VANILLA_ITEM; id++) {
		if (uh_itemvanilladefined[id] == 0)
			continue;
		TakeAndDropUnholyActor(uh_itemvanillastr[id][UHITEM_STR_ACTOR]);
	}
	for (i = 0; i < uh_itemcustomcount; i++)
		TakeAndDropUnholyActor(uh_itemcustomstr[i][UHITEM_STR_ACTOR]);

	// Not a DefineUnholyItem — Unholy_GeneralDeath dropped these one-for-one.
	treasure = CheckInventory("GauntletTreasure_F");
	if (treasure > 0) {
		for (i = 0; i < treasure; i++)
			DropItem(0, "GauntletTreasure_P", 1);
		TakeInventory("GauntletTreasure_F", treasure);
	}
}

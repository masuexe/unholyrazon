}

str u_BossInvStr[3] =
{
"GUHUItem",
"OnFireItemFlag",
"SuperGUHUItem",
};
#define CIINV_GUHU       0
#define CIINV_ONFIRE     1
#define CIINV_SUPERGUHU  2
script "uh_CheckItemInventory" (int itemType, int who)
{
    if (who < 1000 || who > 1063) {
        SetActivator(0, who);
        SetResultValue(CheckInventory(u_BossInvStr[itemType]));
    }
    else {
        SetResultValue(CheckActorInventory(who, u_BossInvStr[itemType]));
    }
}

script "UB_OnFireBurning" (void) {
	int h = max(PlayerHealth(), 0);
	int Burn = CheckInventory("OnFireItemFlag");

	if (h >= Burn+1)
		SetActorProperty(0, APROP_HEALTH, h - Burn);
	else
		SetResultValue(0);
}

script "UB_OnFireFinalBurn" (void) {
	Thing_Damage2(ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET), 100000, "OnFireB");
}

script "UB_WhackSpellRNGCheck" (int High_HP, int Low_HP, int User_HP, int BonusChance) {
	if (Timer() <= 100) {SetResultValue(1); terminate;}  // Quick kill lol

	int TargetHPPer = 100 - ACS_NamedExecuteWithResult("UB_GetPointerHealth",2,2);
	int TracerHPPer = 100 - ACS_NamedExecuteWithResult("UB_GetPointerHealth",8,2);
	//Log(i:TargetHPPer,s:" =TargetHP Percent TracerHP= ",i:TracerHPPer);

	if(High_HP > 100 || High_HP < 1)//Failsafe zone
		High_HP = 100;
	if(Low_HP > 99)
		Low_HP = 99;
	else if(Low_HP < 0)
		Low_HP = 0;
	//1 + 200 * (pt - 20) / 280 + 20 * (pH / 300)//Ultimate Math

	int WhackChance = (TracerHPPer - (100 - High_HP)) * 100 / (100 - Low_HP);
	//Log(i:WhackChance,s:" <> High_HP == ",i:High_HP,s:" <> Low_HP = ",i:Low_HP);
	WhackChance += TargetHPPer / 100 * User_HP;
	//Log(i:WhackChance,s:" <> User_HP = ",i:User_HP);
	WhackChance += BonusChance;
	//Log(i:WhackChance,s:" <> BonusChance = ",i:BonusChance);

	if(WhackChance <= 0){
		WhackChance = 1;
	}
	else{
		WhackChance += 1;
	}
	//Log(i:WhackChance,s:" WhackSpell Math Done!");

	if(WhackChance < 100 && TracerHPPer >= 100 - Low_HP){
		WhackChance = 100;//Force Whack if Tracer has less than % LowHP (5% as example)
		//Log(s:"Forced Thwack!");
	}

	SetResultValue(random(1, 100) <= WhackChance);
}

script "UB_DeadlyFireArmsButtonCheck" (void)
{
	SetActivatorToTarget(0);
	if(GetPlayerInput(-1,INPUT_BUTTONS) & (BT_ATTACK|BT_ALTATTACK))
		SetResultValue(2);
}

script "UB_I_WinACS" (void) {
	PrintBold(s:"\ciYou're Winner!  \cj", c:169, s:" ", n:PlayerNumber()+1);
	if (GetGameModeState() == GAMESTATE_COUNTDOWN)
		terminate;
	if (GetCvar("sv_noexit") == 1)
		SetActivator(AAPTR_NULL);
  ACS_NamedExecuteWithResult("uh_SetGameOverState", 1);
  Delay(100);
	Exit_Normal(0);
}


function int max(int a, int b) {
	if (a > b)
		return a;
	return b;
}

// Returns sting for the last rolled drop row (or by item fallback).
function str GetItemLootSting(int boxid, int itemid)
{
	if (uh_itemLastDropRow >= 0 && uh_itemDropBoxId[uh_itemLastDropRow] == boxid)
		return GetItemDropStingByRow(uh_itemLastDropRow);
	if (itemid == UHITEM_FAIL)
		return "";
	return GetItemDropSting(boxid, itemid);
}

function str GetBoxRollOpenSound(int boxid, int eyedrop)
{
	if (eyedrop)
		return GetBoxEyedropSound(boxid);
	return GetBoxOpenSound(boxid);
}

// Play sting if any; otherwise box/eyedrop open (unless silent). Never both.
function void PlayBoxRollSound(int boxid, int itemid, int eyedrop, int silent)
{
	str sting = GetItemLootSting(boxid, itemid);
	str opensnd;
	if (StrCmp(sting, "") != 0)
	{
		PlaySound(0, sting, CHAN_ITEM);
		return;
	}
	if (silent)
		return;
	opensnd = GetBoxRollOpenSound(boxid, eyedrop);
	if (StrCmp(opensnd, "") != 0)
		PlaySound(0, opensnd, CHAN_ITEM);
}

// Core give path shared by DECORATE (boxid) and GiveUnholyBoxItem (actor → id).
function int GiveRandomBoxItemCore(int boxid, int prosperity, int silent)
{
	int id;
	int row;
	str give;
	int amt;
	str opensnd;
	str actor;

	if (!IsUnholyBox(boxid))
		return 0;

	if (prosperity)
		id = RandomItemFromBoxProsperity(boxid);
	else
		id = RandomItemFromBox(boxid);

	if (id == UHITEM_FAIL)
		return 0;

	row = uh_itemLastDropRow;
	actor = GetItemActor(id);

	// ToW: already have I_Win → give DLC coins instead (legacy Rare1→Rare2).
	if (boxid == UHITEM_BOX_TOW && StrICmp(actor, "I_WinItem") == 0 && CheckInventory("I_WinItem") >= 1)
	{
		if (!silent)
		{
			opensnd = GetBoxOpenSound(boxid);
			if (StrCmp(opensnd, "") != 0)
				PlaySound(0, opensnd, CHAN_ITEM);
		}
		GiveInventory("DLC_CoinItem", 777);
		return 1;
	}

	// Coin pool: GoldenWaspShot on most rolls; coin refunds with misc/coinget skip it.
	if (StrICmp(GetItemActor(boxid), "DLC_CoinItem") == 0)
	{
		opensnd = GetItemDropStingByRow(row);
		if (StrCmp(opensnd, "misc/coinget") != 0)
			PlaySound(0, "items/GoldenWaspShot", 6);
	}

	PlayBoxRollSound(boxid, id, 0, silent);

	give = GetItemDropGiveActorByRow(row);
	amt = GetItemDropAmtByRow(row);
	if (amt < 1)
		amt = 1;
	if (StrCmp(give, "") == 0)
		give = actor;
	GiveInventory(give, amt);
	return 1;
}

// Formal box-open path. C577 grants a second independent roll for real box
// uses, while DLC coin / EyeDrop / AssHat callers continue to use the core
// directly and therefore remain single-roll paths.
function int GiveOpenedBoxItemCore(int boxid, int prosperity, int silent)
{
	int damocles;
	int result;

	damocles = CheckInventory("EdenDamoclesActive_F");
	result = GiveRandomBoxItemCore(boxid, prosperity, silent);
	if (!result || !damocles)
		return result;

	// The second roll shares Prosperity but suppresses the generic open sound.
	// Item-specific loot stings remain governed by PlayBoxRollSound.
	GiveRandomBoxItemCore(boxid, prosperity, 1);
	return result;
}

// Box Use: arg0 = box item id (UHITEM_BOX_*). prosperity / silent as before.
Script "rz_GiveRandomBoxItem" (int boxid, int prosperity, int silent)
{
	SetResultValue(GiveOpenedBoxItemCore(boxid, prosperity, silent));
}

// Addon path: resolve box actor from cvars (UHADD GiveUnholyBoxItem).
Script "uh_GiveUnholyBoxItem_S" (void)
{
	int boxid = FindItemByActor(GetCVarString("uh_di_boxactor"));
	SetResultValue(GiveOpenedBoxItemCore(
		boxid,
		GetCVar("uh_di_prosperity"),
		GetCVar("uh_di_silent")
	));
}

// DLC_Coin UseX2ReRoll — no prosperity.
Script "rz_DlcCoinRoll" (int silent)
{
	int boxid = FindItemByActor("DLC_CoinItem");
	SetResultValue(GiveRandomBoxItemCore(boxid, 0, silent));
}

// DLC_Coin Use / UseX_Silent: spend table first, then >=25 roll, else unlucky.
// Spend sound on channel 5 (SoundSlot5); no GoldenWaspShot (roll pool only).
Script "rz_DlcCoinUse" (void)
{
	int coins;
	int row;
	int take;
	str give;
	str snd;

	coins = CheckInventory("DLC_CoinItem");
	row = FindCoinSpendRow(coins);
	if (row >= 0)
	{
		take = uh_coinSpendTake[row];
		give = uh_coinSpendGive[row];
		snd = uh_coinSpendSound[row];
		if (take <= 0)
			TakeInventory("DLC_CoinItem", coins);
		else
			TakeInventory("DLC_CoinItem", take);
		if (StrCmp(snd, "") != 0)
			PlaySound(0, snd, 5);
		GiveInventory(give, 1);
		SetResultValue(1);
		terminate;
	}

	if (coins >= 25)
	{
		TakeInventory("DLC_CoinItem", 25);
		SetResultValue(GiveRandomBoxItemCore(FindItemByActor("DLC_CoinItem"), 0, 0));
		terminate;
	}

	if (coins > 0)
		TakeInventory("DLC_CoinItem", coins);
	PlaySound(0, "items/SoUnlucky", 5);
	SetResultValue(0);
}

// EyeDrop: SpawnItemEx x1 at activator. GauntletExit / Minivile hijacks (EyeDrop-only).
Script "uh_SpawnRandomBoxItem" (int boxid)
{
	int id = RandomItemFromBox(boxid);
	int row = uh_itemLastDropRow;
	str actor;
	str give;
	int x;
	int y;
	int z;

	if (id == UHITEM_FAIL)
	{
		SetResultValue(0);
		terminate;
	}

	actor = GetItemActor(id);
	give = GetItemDropGiveActorByRow(row);
	if (StrCmp(give, "") == 0)
		give = actor;
	x = GetActorX(0);
	y = GetActorY(0);
	z = GetActorZ(0);

	// Pandora EyeDrop: Rare4 → 32/256 GauntletExit instead of BoxDE / KillerBoxDE
	if (boxid == UHITEM_BOX_PANDORA)
	{
		if ((StrICmp(actor, "BoxDEItem") == 0 || StrICmp(actor, "KillerBoxDEItem") == 0)
			&& random(1, 256) <= 32)
		{
			PlaySound(0, "GNT/Invun", CHAN_ITEM);
			SpawnForced("GauntletExitItem", x, y, z, 0, 0);
			SetResultValue(1);
			terminate;
		}
		if (StrICmp(actor, "OnFireItem") == 0 && random(1, 256) <= 64)
		{
			PlaySound(0, "items/ABoxEyeBox", CHAN_ITEM);
			SpawnForced("BoxDE_MinivileHidden_H1", x, y, z, 0, 0);
			SetResultValue(1);
			terminate;
		}
	}

	if (boxid == UHITEM_BOX_MYSTIC)
	{
		if ((StrICmp(actor, "GoldenBoxDEItem") == 0 || StrICmp(actor, "GoldenKillerBoxDEItem") == 0)
			&& random(1, 256) <= 32)
		{
			PlaySound(0, "GNT/Invun", CHAN_ITEM);
			SpawnForced("GauntletExitItem", x, y, z, 0, 0);
			SetResultValue(1);
			terminate;
		}
		if (StrICmp(actor, "TheFootBallItem") == 0 && random(1, 256) <= 64)
		{
			PlaySound(0, "items/ABoxEyeBox", CHAN_ITEM);
			SpawnForced("BoxDE_MinivileHidden_H2", x, y, z, 0, 0);
			SetResultValue(1);
			terminate;
		}
	}

	PlayBoxRollSound(boxid, id, 1, 0);
	SpawnForced(give, x, y, z, 0, 0);
	SetResultValue(1);
}

// AssHat 10s morph: roll AssHat box at hat position; spawn giveActor (hat class).
Script "rz_AssHatRoll" (void)
{
	int boxid = FindItemByActor("AssHatItem");
	int row;
	int id;
	str give;
	str itemActor;
	int x;
	int y;
	int z;
	int tid;

	if (boxid == UHITEM_FAIL || !IsUnholyBox(boxid))
	{
		SetResultValue(0);
		terminate;
	}

	row = RandomItemDropRowFromBox(boxid);
	if (row < 0)
	{
		SetResultValue(0);
		terminate;
	}

	id = GetItemDropItemIdByRow(row);
	itemActor = GetItemActor(id);
	give = uh_itemDropGive[row];
	x = GetActorX(0);
	y = GetActorY(0);
	z = GetActorZ(0);

	if (StrCmp(give, "") == 0)
	{
		tid = UniqueTID();
		if (AssHatPendingAlloc(tid, itemActor) < 0)
		{
			SetResultValue(0);
			terminate;
		}
		SpawnForced("AssHatItemX_Generic", x, y, z, tid, 0);
	}
	else
		SpawnForced(give, x, y, z, 0, 0);
	SetResultValue(1);
}

Script "uh_AssHatGenericSpawnFX" (void)
{
	str item = AssHatPendingPeek(ActivatorTID());
	str fx;
	if (StrCmp(item, "") == 0)
	{
		SetResultValue(0);
		terminate;
	}
	fx = StrParam(s:item, s:"FX");
	SpawnForced(fx, GetActorX(0), GetActorY(0), GetActorZ(0) + 8.0, 0, 0);
	SpawnForced("AssHatItemX_FX", GetActorX(0), GetActorY(0), GetActorZ(0) + 8.0, 0, 0);
	SetResultValue(1);
}

Script "uh_AssHatGenericPickup" (void)
{
	str item = AssHatPendingTake(ActivatorTID());
	int amt;
	if (StrCmp(item, "") == 0)
	{
		SetResultValue(0);
		terminate;
	}
	amt = 1 + ACS_NamedExecuteWithResult("uh_checkrune", RUNE_SPREAD) * 2;
	GiveInventory(item, amt);
	SetResultValue(1);
}


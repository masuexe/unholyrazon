#library "uh_itemdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla Unholy items: identity = inventory actor class.
// DefineUnholyItem(id, actor, name, wP, amtP, wM, amtM, wT, amtT, mugshot, sound)
// Weights from sequential A_Jump probs * 100000 (min 1). weight 0 = not in pool.
// sound = optional loot sting ("" = none). MysticBox pool stings live in roller.

function void RegisterVanillaUnholyItems(void)
{
	// --- Pandora pool items (wP from PandoraBox UseX chain) ---
	DefineUnholyItem(0, "PandoraBoxItem", "Pandora Box", 0, 0, 83, 3, 0, 0, "", "");
	DefineUnholyItem(1, "SuperMysticTankItem", "Super Mystic Tank", 766, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(2, "ShinBanishItem", "Shin Banish", 5411, 2, 0, 0, 0, 0, "", "");
	DefineUnholyItem(3, "FlingingDEItem", "Flinging Demoneye", 5411, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(4, "TornadoDEItem", "Tornado Demoneye", 3636, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(5, "FlashingDEItem", "Flashing Demoneye", 5411, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(6, "RushCoilDEItem", "Rush Coil Demoneye", 6443, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(7, "BoxDEItem", "Box Demoneye", 778, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(8, "KillerBoxDEItem", "Killer Box Demoneye", 778, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(9, "MoneyBaitItem", "Money Bait", 3636, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(10, "StepAsideItem", "Step Aside", 3636, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(11, "ThunderTankItem", "Thunder Tank", 6443, 5, 0, 0, 0, 0, "", "");
	DefineUnholyItem(12, "WaspBombItem", "Wasp Bomb", 3636, 3, 0, 0, 0, 0, "", "");
	DefineUnholyItem(13, "LoliBalloonItem", "Loli Balloon", 3221, 3, 0, 0, 0, 0, "", "");
	DefineUnholyItem(14, "GothicBalloonItem", "Gothic Balloon", 3221, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(15, "DarkmanToyItem", "Darkman Toy", 6443, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(16, "DemoneyeToyItem", "Demoneye Toy", 3636, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(17, "GUHUItem", "GUHU", 766, 1, 0, 0, 0, 0, "", "");

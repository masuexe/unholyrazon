	DefineUnholyItem(61, "CarpetBomberItem", "Carpet Bomber", 0, 0, 0, 0, 17027, 1, "", "");
	DefineUnholyItem(62, "HogWashItem", "Hog Wash", 0, 0, 0, 0, 19635, 1, "", "");
	DefineUnholyItem(63, "GauntletExitItem", "Gauntlet Exit", 0, 0, 0, 0, 0, 0, "", "");

	// --- Other (never in box pools) ---
	DefineUnholyItem(64, "TruePowerItem", "True Power", 0, 0, 0, 0, 0, 0, "", "");

#library "uh_itemdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla Unholy items: identity = inventory actor class.
// pool = UHITEM_POOL_PANDORA / MYSTIC / TOW / OTHER / NONE.
// mugshot optional ("" — items use DECORATE Inventory.Icon; not BossNumb/BHW).
// Boxes still grant via DECORATE A_GiveInventory actor strings (no A_Jump rewrite yet).

function void RegisterVanillaUnholyItems(void)
{
	// --- Pandora ---
	DefineUnholyItem(0, "PandoraBoxItem", "Pandora Box", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(1, "SuperMysticTankItem", "Super Mystic Tank", UHITEM_POOL_PANDORA, "");

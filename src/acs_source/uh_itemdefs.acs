	DefineUnholyItem(34, "ContrabandItem2Item", "Contraband Item 2", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(35, "WhackSpellItem", "Whack Spell", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(36, "ChanceBoxItem", "Chance Box", UHITEM_POOL_PANDORA, "");


	DefineUnholyItem(20, "SolitaireCardItem", "Solitaire Card", 5411, 2, 0, 0, 0, 0, "", "");
	DefineUnholyItem(21, "BluntRocketItem", "Blunt Rocket", 5411, 3, 0, 0, 0, 0, "", "");
	DefineUnholyItem(22, "SharpRocketItem", "Sharp Rocket", 2375, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(23, "AirStrikeItem", "Air Strike", 195, 1, 0, 0, 0, 0, "", "GNT/SuperShot");
	DefineUnholyItem(24, "UnholyWaterItem", "Unholy Water", 2375, 1, 0, 0, 0, 0, "", "");
	DefineUnholyItem(25, "ZtarItem", "Ztar", 248, 1, 0, 0, 0, 0, "", "items/SoUnlucky");

	DefineUnholyItem(5, "FlashingDEItem", "Flashing Demoneye", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(6, "RushCoilDEItem", "Rush Coil Demoneye", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(7, "BoxDEItem", "Box Demoneye", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(8, "KillerBoxDEItem", "Killer Box Demoneye", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(9, "MoneyBaitItem", "Money Bait", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(10, "StepAsideItem", "Step Aside", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(11, "ThunderTankItem", "Thunder Tank", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(12, "WaspBombItem", "Wasp Bomb", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(13, "LoliBalloonItem", "Loli Balloon", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(14, "GothicBalloonItem", "Gothic Balloon", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(15, "DarkmanToyItem", "Darkman Toy", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(16, "DemoneyeToyItem", "Demoneye Toy", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(17, "GUHUItem", "GUHU", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(18, "RubberBandItem", "Rubber Band", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(19, "OnFireItem", "On Fire", UHITEM_POOL_PANDORA, "");
	DefineUnholyItem(20, "SolitaireCardItem", "Solitaire Card", UHITEM_POOL_PANDORA, "");

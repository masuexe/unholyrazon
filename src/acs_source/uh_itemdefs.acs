	DefineUnholyItem(68, "MistressBoxSouret", "Mistress Souret", 0, 0, 0, 0, 0, 0, "", "");
	DefineUnholyItem(69, "MistressBoxRegen", "Mistress Regen", 0, 0, 0, 0, 0, 0, "", "");
	DefineUnholyItem(70, "MistressBoxPotion", "Mistress Potion", 0, 0, 0, 0, 0, 0, "", "");
	DefineUnholyItem(71, "MistressBoxGUHU", "Mistress GUHU", 0, 0, 0, 0, 0, 0, "", "");
}

script "uh_define_vanilla_items" OPEN
{
	if (!UHInPlay()) terminate;
	if (IsItemDefined(0)) terminate;
	RegisterVanillaUnholyItems();
}

script "uh_define_vanilla_items_cs" OPEN CLIENTSIDE
{
	if (IsItemDefined(0)) terminate;
	RegisterVanillaUnholyItems();
}

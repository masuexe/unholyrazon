	DefineUnholyItem(66, "GelatoPizzaItem", "Gelato Pizza", UHITEM_POOL_OTHER, "");
	DefineUnholyItem(67, "MistressBoxTimeFist", "Mistress Time Fist", UHITEM_POOL_OTHER, "");
	DefineUnholyItem(68, "MistressBoxSouret", "Mistress Souret", UHITEM_POOL_OTHER, "");
	DefineUnholyItem(69, "MistressBoxRegen", "Mistress Regen", UHITEM_POOL_OTHER, "");
	DefineUnholyItem(70, "MistressBoxPotion", "Mistress Potion", UHITEM_POOL_OTHER, "");
	DefineUnholyItem(71, "MistressBoxGUHU", "Mistress GUHU", UHITEM_POOL_OTHER, "");
}

script "uh_define_vanilla_items" OPEN
{
	if (!UHInPlay()) terminate;
	if (IsItemDefined(0)) terminate;
	RegisterVanillaUnholyItems();
}

script "uh_define_vanilla_items_cs" OPEN CLIENTSIDE
{
	if (IsItemDefined(0)) terminate;
	RegisterVanillaUnholyItems();
}

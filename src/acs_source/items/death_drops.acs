// LMS death drops: razon3 rz_TakeAndDropFullItems, but walk DefineUnholyItem
// instead of the hardcoded fullItemList. DropItem spawns a pickup; Take clears
// inventory. Coins become one money bag (lossy, same brackets as razon3).
function str GetMoneyBagType(int credit) {
	int n;

	if (credit <= 0)
		return "";
	if (credit == 9999)
		return "DLCMoneyBag9999";
	if (credit >= 1000) {
		n = credit / 1000;
		if (n > 9)
			n = 9;
		return StrParam(s:"DLCMoneyBag", i:n * 1000);
	}
	if (credit >= 100)
		return StrParam(s:"DLCMoneyBag", i:(credit / 100) * 100);
	return "DLCMoneyBag";
}

function void TakeAndDropUnholyActor(str actor) {
	int count;
	str bag;

	if (StrCmp(actor, "") == 0)
		return;
	count = CheckInventory(actor);
	if (count <= 0)
		return;
	if (StrICmp(actor, "DLC_CoinItem") == 0) {
		bag = GetMoneyBagType(count);
		if (StrCmp(bag, "") != 0)
			DropItem(0, bag, 1);
		TakeInventory(actor, count);
		return;
	}
	DropItem(0, actor, count);
	TakeInventory(actor, count);
}

script "UH_DropItemsOnDeath" (void) {
	int id;
	int i;
	int treasure;

	for (id = 0; id < UH_MAX_VANILLA_ITEM; id++) {
		if (uh_itemvanilladefined[id] == 0)
			continue;
		TakeAndDropUnholyActor(uh_itemvanillastr[id][UHITEM_STR_ACTOR]);
	}
	for (i = 0; i < uh_itemcustomcount; i++)
		TakeAndDropUnholyActor(uh_itemcustomstr[i][UHITEM_STR_ACTOR]);

	// Not a DefineUnholyItem — Unholy_GeneralDeath dropped these one-for-one.
	treasure = CheckInventory("GauntletTreasure_F");
	if (treasure > 0) {
		for (i = 0; i < treasure; i++)
			DropItem(0, "GauntletTreasure_P", 1);
		TakeInventory("GauntletTreasure_F", treasure);
	}
}

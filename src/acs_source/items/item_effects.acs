#define RUNE_SPREAD 3

// Spawn one concrete effect selected from a weighted eye-morph pool.  These
// helpers are server-side entry points used by the MoneyBait/MoneyBomb
// DECORATE actors; modders can use PickEyeMorphActor directly when they need a
// different delivery shape.
function int SpawnEyeMorphEffect(str pool, int mode, int zoff, int speed) {
	str actor = PickEyeMorphActorCore(pool, mode);
	int sourcetid = ActivatorTID();
	int sourcetemp = 0;
	int spawntid;
	int angle;
	int result;
	if (StrCmp(actor, "") == 0)
		return 0;

	// A_SpawnItemEx makes the spawned missile target its helper.  Give an
	// activator without a TID a temporary one so the same pointer relationship
	// and server-side ownership are retained for the dynamic spawn.
	// DECORATE must call these scripts with ACS_NamedExecuteWithResult (not
	// ACS_NamedExecuteAlways): Always is deferred, and a 0-tic helper is
	// already gone by the time the script would run.
	if (sourcetid == 0) {
		sourcetemp = UniqueTID();
		Thing_ChangeTID(0, sourcetemp);
		sourcetid = sourcetemp;
	}

	spawntid = UniqueTID();
	angle = GetActorAngle(0);
	result = SpawnForced(
		actor,
		GetActorX(0),
		GetActorY(0),
		GetActorZ(0) + zoff * 1.0,
		spawntid,
		angle >> 8
	);
	if (result) {
		if (speed != 0) {
			SetActorVelocity(
				spawntid,
				FixedMul(cos(angle), speed * 1.0),
				FixedMul(sin(angle), speed * 1.0),
				0,
				0,
				0
			);
		}
		SetActivator(spawntid);
		SetPointer(AAPTR_TARGET, sourcetid);
		Thing_ChangeTID(spawntid, 0);
	}

	if (sourcetemp != 0) {
		SetActivator(sourcetid);
		Thing_ChangeTID(sourcetid, 0);
	}
	return result;
}

script "uh_SpawnMoneyBaitShot" (void) {
	SetResultValue(SpawnEyeMorphEffect("MoneyBait", UHEM_MODE_SHOT, 0, 20));
}

script "uh_SpawnMoneyBaitBurst" (void) {
	SetResultValue(SpawnEyeMorphEffect("MoneyBait", UHEM_MODE_BURST, 8, 0));
}

script "uh_SpawnMoneyBombBurst" (void) {
	SetResultValue(SpawnEyeMorphEffect("MoneyBomb", UHEM_MODE_BURST, 0, 0));
}

script "rz_ThingDamage_GiveUpHope" (int tid, int amount) {
	SetResultValue(Thing_Damage2(tid, amount, "GiveUpHope"));
}

script "rz_ThingDamage_SuperGiveUpHope" (int tid, int amount) {
	SetResultValue(Thing_Damage2(tid, amount, "SuperGiveUpHope"));
}

script "rz_ThingDamage_FortuneCoin" (int tid, int amount) {
	SetResultValue(Thing_Damage2(tid, amount, "FortuneCoin"));
}

script "rz_ThingDamage_Damocles" (int tid, int amount) {
	SetResultValue(Thing_Damage2(tid, amount, "Damocles"));
}

script "UB_OnFireBurning" (void) {
	int h = max(PlayerHealth(), 0);
	int burn = CheckInventory("OnFireItemFlag");

	if (h >= burn + 1)
		SetActorProperty(0, APROP_HEALTH, h - burn);
	else
		SetResultValue(0);
}

script "UB_OnFireFinalBurn" (void) {
	Thing_Damage2(ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET), 100000, "OnFireB");
}

script "UB_WhackSpellRNGCheck" (int high_hp, int low_hp, int user_hp, int bonuschance) {
	if (Timer() <= 100) {SetResultValue(1); terminate;}  // Quick kill lol

	int targethpper = 100 - ACS_NamedExecuteWithResult("UB_GetPointerHealth", 2, 2);
	int tracerhpper = 100 - ACS_NamedExecuteWithResult("UB_GetPointerHealth", 8, 2);
	// Log(i:TargetHPPer,s:" =TargetHP Percent TracerHP= ",i:TracerHPPer);

	if (high_hp > 100 || high_hp < 1)  // Failsafe zone
		high_hp = 100;
	if (low_hp > 99)
		low_hp = 99;
	else if (low_hp < 0)
		low_hp = 0;
	// 1 + 200 * (pt - 20) / 280 + 20 * (pH / 300)//Ultimate Math

	int whackchance = (tracerhpper - (100 - high_hp)) * 100 / (100 - low_hp);
	// Log(i:WhackChance,s:" <> High_HP == ",i:High_HP,s:" <> Low_HP = ",i:Low_HP);
	whackchance += targethpper / 100 * user_hp;
	// Log(i:WhackChance,s:" <> User_HP = ",i:User_HP);
	whackchance += bonuschance;
	// Log(i:WhackChance,s:" <> BonusChance = ",i:BonusChance);

	if (whackchance <= 0) {
		whackchance = 1;
	}
	else {
		whackchance += 1;
	}
	// Log(i:WhackChance,s:" WhackSpell Math Done!");

	if (whackchance < 100 && tracerhpper >= 100 - low_hp) {
		whackchance = 100;  // Force Whack if Tracer has less than % LowHP (5% as example)
		// Log(s:"Forced Thwack!");
	}

	SetResultValue(random(1, 100) <= whackchance);
}

script "UB_DeadlyFireArmsButtonCheck" (void) {
	SetActivatorToTarget(0);
	if (GetPlayerInput(-1, INPUT_BUTTONS) & (BT_ATTACK | BT_ALTATTACK))
		SetResultValue(2);
}

script "UB_I_WinACS" (void) {
	PrintBold(s:"\ciYou're Winner!  \cj", c:169, s:" ", n:PlayerNumber() + 1);
	if (GetGameModeState() == GAMESTATE_COUNTDOWN)
		terminate;
	if (GetCvar("sv_noexit") == 1)
		SetActivator(AAPTR_NULL);
	ACS_NamedExecuteWithResult("uh_SetGameOverState", 1);
	Delay(100);
	Exit_Normal(0);
}



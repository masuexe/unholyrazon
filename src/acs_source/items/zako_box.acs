// ZakoBox light-orb hatching runtime.

function str ZakoEnemyActor(int idx) {
  switch (idx) {
    case 0: return "ToadmanBossU_4BCAS";
    case 1: return "HeatManBossU_DEM";
    case 2: return "CutmanBossU_SRT";
    case 3: return "CutmanBossU_Claw";
    case 4: return "SniperArmorU_Exile";
    case 5: return "SniperArmorU_Z";
    case 6: return "SniperArmorU_DEM";
    case 7: return "BigEyeEnemyU_2BM";
    case 8: return "BigEyeEnemyU_Claw";
    case 9: return "BigEyeEnemyU_Claw_Color2";
    case 10: return "FleaU_Claw";
    case 11: return "PropTopU_Claw2";
    case 12: return "CrazyCannonU_DEM";
    case 13: return "CrazyCannonU_DEM_Color2";
    case 14: return "TopFiendU_3BC";
    case 15: return "HotHeadEnemyU_Claw2";
    case 16: return "ReturningSniperJoeU_Exile";
    case 17: return "ReturningSniperJoeU_Z";
    case 18: return "ReturningSniperJoeU_DEM";
    case 19: return "MetEnemyU_3BC";
    case 20: return "MetEnemyU_Exile";
    case 21: return "MetEnemyU_Z";
    case 22: return "MetEnemyU_2Core";
  }
  return "MetEnemyU_3BC";
}

function str ZakoWallProbeActor(int idx) {
  switch (idx) {
    case 0: return "ZakoWallProbe_32x64";
    case 1: return "ZakoWallProbe_20x52";
    case 2:
    case 3: return "ZakoWallProbe_48x52";
    case 4:
    case 5:
    case 6: return "ZakoWallProbe_64x128";
    case 7:
    case 8:
    case 9: return "ZakoWallProbe_40x120";
    case 10: return "ZakoWallProbe_18x18";
    case 11: return "ZakoWallProbe_36x75";
    case 12:
    case 13: return "ZakoWallProbe_40x46";
  }
  return "ZakoWallProbe_32x52";
}

function int RollZakoEnemyIndex(void) {
  int r;
  if (random(0, 255) < 16)
    return random(0, 3);
  if (random(0, 255) < 32) {
    if (random(0, 1) == 0)
      return random(4, 6);
    if (random(0, 1) == 0)
      return 7;
    return random(8, 9);
  }
  if (random(0, 255) < 64) {
    r = random(0, 4);
    if (r == 0)
      return 10;
    if (r == 1)
      return 11;
    if (r == 2)
      return random(12, 13);
    if (r == 3)
      return 14;
    return 15;
  }
  if (random(0, 255) < 128)
    return random(16, 18);
  return random(19, 22);
}

// Try clean Spawn at (x, y, z) and the 8 in-orb-footprint (±8, ±8) nudges.
function int TryCleanZakoSpawn(str cls, int x, int y, int z, int byteAng) {
  int ix;
  int iy;
  int tx;
  int ty;

  if (Spawn(cls, x, y, z, 0, byteAng) > 0)
    return 1;

  for (ix = -1; ix <= 1; ix++) {
    for (iy = -1; iy <= 1; iy++) {
      if (ix == 0 && iy == 0)
        continue;
      tx = x + ix * 8.0;
      ty = y + iy * 8.0;
      if (Spawn(cls, tx, ty, z, 0, byteAng) > 0)
        return 1;
      if (Spawn(cls, tx, ty, z + 8.0, 0, byteAng) > 0)
        return 1;
    }
  }
  return 0;
}

// Test wall/ceiling-only clearance with a non-solid probe, then SpawnForced.
function int TryProbeZakoSpawn(str probe, str cls, int x, int y, int z, int byteAng) {
  int ix;
  int iy;
  int tx;
  int ty;

  if (Spawn(probe, x, y, z, 0, 0) > 0) {
    SpawnForced(cls, x, y, z, 0, byteAng);
    return 1;
  }

  for (ix = -1; ix <= 1; ix++) {
    for (iy = -1; iy <= 1; iy++) {
      if (ix == 0 && iy == 0)
        continue;
      tx = x + ix * 8.0;
      ty = y + iy * 8.0;
      if (Spawn(probe, tx, ty, z, 0, 0) > 0) {
        SpawnForced(cls, tx, ty, z, 0, byteAng);
        return 1;
      }
      if (Spawn(probe, tx, ty, z + 8.0, 0, 0) > 0) {
        SpawnForced(cls, tx, ty, z + 8.0, 0, byteAng);
        return 1;
      }
    }
  }
  return 0;
}

function void ForceHatchZakoAt(int idx, int x, int y, int z, int byteAng) {
  int metIdx = random(19, 22);
  str origActor = ZakoEnemyActor(idx);
  str metActor = ZakoEnemyActor(metIdx);

  if (TryCleanZakoSpawn(origActor, x, y, z, byteAng))
    return;
  if (TryCleanZakoSpawn(metActor, x, y, z, byteAng))
    return;
  if (TryCleanZakoSpawn("FleaU_Claw", x, y, z, byteAng))
    return;

  if (TryProbeZakoSpawn(ZakoWallProbeActor(idx), origActor, x, y, z, byteAng))
    return;
  if (TryProbeZakoSpawn("ZakoWallProbe_32x52", metActor, x, y, z, byteAng))
    return;
  if (TryProbeZakoSpawn("ZakoWallProbe_18x18", "FleaU_Claw", x, y, z, byteAng))
    return;

  SpawnForced("FleaU_Claw", x, y, z, 0, byteAng);
}

script "rz_ZakoOrbThink" (void) {
  int idx = RollZakoEnemyIndex();
  int retry;
  int airTics;
  int x;
  int y;
  int z;
  int fz;
  int spawnZ;
  int byteAng;
  int hopAng;
  int hopSpd;
  int hopVz;

  Delay(14);

  for (retry = 0; retry <= 5; retry++) {
    if (ClassifyActor(0) == ACTOR_NONE || CheckInventory("ZakoOrbHatched_F"))
      terminate;

    airTics = 0;
    while (airTics < 90 && (GetActorZ(0) - GetActorFloorZ(0)) > 2.0) {
      Delay(1);
      if (ClassifyActor(0) == ACTOR_NONE || CheckInventory("ZakoOrbHatched_F"))
        terminate;
      airTics++;
    }

    x = GetActorX(0);
    y = GetActorY(0);
    z = GetActorZ(0);
    fz = GetActorFloorZ(0);
    if (z - fz <= 16.0)
      spawnZ = fz;
    else
      spawnZ = z;
    byteAng = random(0, 255);

    if (Spawn(ZakoEnemyActor(idx), x, y, spawnZ, 0, byteAng) > 0) {
      GiveInventory("ZakoOrbHatched_F", 1);
      SetActorState(0, "Hatch");
      terminate;
    }

    if (retry < 5) {
      hopAng = random(0, 1.0 - 1);
      hopSpd = random(9, 15);
      hopVz = random(6, 10) * 1.0;
      SetActorVelocity(0, FixedMul(hopSpd * 1.0, cos(hopAng)), FixedMul(hopSpd * 1.0, sin(hopAng)), hopVz, false, false);
      Delay(10);
    } else {
      GiveInventory("ZakoOrbHatched_F", 1);
      ForceHatchZakoAt(idx, x, y, spawnZ, byteAng);
      SetActorState(0, "Hatch");
      terminate;
    }
  }
}

script "rz_ZakoOrbForceHatch" (void) {
  int x;
  int y;
  int z;
  int fz;
  int spawnZ;

  if (ClassifyActor(0) == ACTOR_NONE || CheckInventory("ZakoOrbHatched_F"))
    terminate;

  GiveInventory("ZakoOrbHatched_F", 1);
  x = GetActorX(0);
  y = GetActorY(0);
  z = GetActorZ(0);
  fz = GetActorFloorZ(0);
  if (z - fz <= 16.0)
    spawnZ = fz;
  else
    spawnZ = z;

  ForceHatchZakoAt(RollZakoEnemyIndex(), x, y, spawnZ, random(0, 255));
}

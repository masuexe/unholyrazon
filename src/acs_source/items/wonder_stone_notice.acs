// Razon 3's Wonder Stone announcement. The item calls the server entry point;
// deliver the client HUD/sound explicitly to every connected peer, including
// spectators, so it also works on a dedicated server.
script "rz_WonderStoneNotice" (int color) {
  for (int p = 0; p < MAX_PLAYERS; p++) {
    if (PlayerInGame(p) || PlayerIsSpectator(p))
      NamedExecuteClientScript("rz_WonderStoneNotice_Client", p, color);
  }
}

script "rz_WonderStoneNotice_Client" (int color) CLIENTSIDE {
  if (color == 4)
    AmbientSound("misc/kingalarm", 256);
  else
    AmbientSound("misc/bot_roboenzainfected", 256);
  SetFont("BIGFONT");
  SetHudSize(640, 480, 0);
  switch (color) {
    case 0:
      HudMessageBold(s:"\cr*NOTICE* \cgWonder Stone Appeared! \cr*NOTICE*"; HUDMSG_FADEOUT, -7420, 0, 320.4, 69.8, 3.0, 0.5);
      break;
    case 1:
      HudMessageBold(s:"\cn*NOTICE* \cvWonder Stone Appeared! \cn*NOTICE*"; HUDMSG_FADEOUT, -7420, 0, 320.4, 69.8, 3.0, 0.5);
      break;
    case 2:
      HudMessageBold(s:"\cf*NOTICE* \ckWonder Stone Appeared! \cf*NOTICE*"; HUDMSG_FADEOUT, -7420, 0, 320.4, 69.8, 3.0, 0.5);
      break;
    case 3:
      HudMessageBold(s:"\cq*NOTICE* \cdWonder Stone Appeared! \cq*NOTICE*"; HUDMSG_FADEOUT, -7420, 0, 320.4, 69.8, 3.0, 0.5);
      break;
    case 4:
      HudMessageBold(s:"\c[u2]*WARNING* \c[c3]Wonder \c[a6]Stone \c[n5]Appeared! \c[h6]*WARNING*"; HUDMSG_FADEOUT, -7420, 0, 320.4, 69.8, 3.0, 0.5);
      break;
  }
}

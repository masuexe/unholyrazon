// Razon 3's treasure threshold bridge. CustomInventory Pickup runs with the
// collector as activator; query and consumption are synchronous, with no
// delay between them. Retain surplus treasures when the host lowers the limit.
script "rz_GauntletTreasureACS" (int mode) {
  int limit = GetCVar("uh_sv_treasurecountlimit");
  if (limit < 1) {limit = 1;}
  if (limit > 100) {limit = 100;}
  switch (mode) {
    case 0:
      SetResultValue(CheckInventory("GauntletTreasure_F") >= limit);
      break;
    case 1:
      TakeInventory("GauntletTreasure_F", limit);
      break;
  }
}

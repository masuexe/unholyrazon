script "uh_define_vanilla_items" OPEN {
  if (!UHInPlay()) terminate;
  if (IsItemDefined(0)) terminate;
  RegisterVanillaUnholyItems();
}

script "uh_define_vanilla_items_cs" OPEN CLIENTSIDE {
  if (IsItemDefined(0)) terminate;
  RegisterVanillaUnholyItems();
  ACS_NamedExecute("uh_uix_reg_items", 0);
}

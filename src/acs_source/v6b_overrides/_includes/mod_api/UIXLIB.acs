#define UIXLIB_BAR_DISPLAY_NONE 0
#define UIXLIB_BAR_DISPLAY_VERT 1
#define UIXLIB_BAR_DISPLAY_HORI 2

// Bar drawing stuff
// Original concept by BinaryCode
//
function void drawLayeredBar(int layer, str bar1, str bar2, str empty, int offsx, int offsy, int width, int height, int scalex, int scaley, int alpha, int amount, int maxAmount, int mode, int reverse, int halign, int valign)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);

	int clipOffsW = (halign == UIXLIB_ALIGN_CENTER ? -width / 2 : (calchalign == UIXLIB_ALIGN_RIGHT || calchalign == UIXLIB_ALIGN_NEGRIGHT ? -width : 0));
	int clipOffsH = (valign == UIXLIB_ALIGN_CENTER ? -height / 2 : (calcvalign == UIXLIB_ALIGN_BOTTOM ? -height : 0));

    if(mode == UIXLIB_BAR_DISPLAY_NONE)
       return;

    int clip;
    if(mode == UIXLIB_BAR_DISPLAY_VERT) {
        clip = (amount * height) / maxAmount;
        SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH + (height - clip), width, clip);
    }
    if(mode == UIXLIB_BAR_DISPLAY_HORI) {
        clip = (amount * width) / maxAmount;
		SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH, clip, height);
    }

	SetFont(bar1);
	HudMessageBold(s:"A"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
	SetFont(bar2);
	HudMessageBold(s:"A"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
    // SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH, width, height);
    SetHudClipRect(0, 0, 0, 0, 0);
    SetFont(empty);
    HudMessageBold(s:"A"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
	SetHudClipRect(0,0,0,0);
}

function void drawLayeredBarColor(int layer, str barFont, str bar1col, str bar2col, str emptycol, int offsx, int offsy, int width, int height, int scalex, int scaley, int alpha, int amount, int maxAmount, int mode, int reverse, int halign, int valign)
{
	drawLayeredBarColorFade(layer, barFont, bar1col, bar2col, emptycol, offsx, offsy, width, height, scalex, scaley, alpha, amount, maxAmount, mode, reverse, halign, valign, 0);
}

function void drawLayeredBarColorFade(int layer, str barFont, str bar1col, str bar2col, str emptycol, int offsx, int offsy, int width, int height, int scalex, int scaley, int alpha, int amount, int maxAmount, int mode, int reverse, int halign, int valign, int fadeTime)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);

	int clipOffsW = (halign == UIXLIB_ALIGN_CENTER ? -width / 2 : (calchalign == UIXLIB_ALIGN_RIGHT || calchalign == UIXLIB_ALIGN_NEGRIGHT ? -width : 0));
	int clipOffsH = (valign == UIXLIB_ALIGN_CENTER ? -height / 2 : (calcvalign == UIXLIB_ALIGN_BOTTOM ? -height : 0));

    if(mode == UIXLIB_BAR_DISPLAY_NONE)
       return;

    int clip;
    if(mode == UIXLIB_BAR_DISPLAY_VERT) {
        clip = (amount * height) / maxAmount;
        SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH + (height - clip), width, clip);
    }
    if(mode == UIXLIB_BAR_DISPLAY_HORI) {
        clip = (amount * width) / maxAmount;
		SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH, clip, height);
    }

	if(fadeTime > 0) {
		SetFont(barFont);
		HudMessageBold(s:"A"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|HUDMSG_FADEOUT|layer, 0, bar1col, calcX, calcY, UIXLIB_MSG_TIME, fadeTime, alpha);
		HudMessageBold(s:"B"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|HUDMSG_FADEOUT|layer, 0, bar2col, calcX, calcY, UIXLIB_MSG_TIME, fadeTime, alpha);
		SetHudClipRect(0, 0, 0, 0, 0);
		HudMessageBold(s:"C"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|HUDMSG_FADEOUT|layer, 0, emptycol, calcX, calcY, UIXLIB_MSG_TIME, fadeTime, alpha);
		SetHudClipRect(0,0,0,0);
	} else {
		SetFont(barFont);
		HudMessageBold(s:"A"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, bar1col, calcX, calcY, UIXLIB_MSG_TIME, alpha);
		HudMessageBold(s:"B"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, bar2col, calcX, calcY, UIXLIB_MSG_TIME, alpha);
		SetHudClipRect(0, 0, 0, 0, 0);
		HudMessageBold(s:"C"; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, emptycol, calcX, calcY, UIXLIB_MSG_TIME, alpha);
		SetHudClipRect(0,0,0,0);
	}
}

function void drawBar(int layer, str bar1, str empty, int offsx, int offsy, int width, int height, int scalex, int scaley, int alpha, int amount, int maxAmount, int mode, int reverse, int halign, int valign)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);

	int clipOffsW = (calchalign == UIXLIB_ALIGN_CENTER ? -width / 2 : (calchalign == UIXLIB_ALIGN_RIGHT || calchalign == UIXLIB_ALIGN_NEGRIGHT ? -width : 0));
	int clipOffsH = (calcvalign == UIXLIB_ALIGN_CENTER ? -height / 2 : (calcvalign == UIXLIB_ALIGN_BOTTOM ? -height : 0));

    if(mode == UIXLIB_BAR_DISPLAY_NONE)
       return;

    int clip;
    if(mode == UIXLIB_BAR_DISPLAY_VERT) {
        clip = (amount * height) / maxAmount;
        SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH + (height - clip), width, clip);
    }
    if(mode == UIXLIB_BAR_DISPLAY_HORI) {
        clip = (amount * width) / maxAmount;
		SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH, clip, height);
    }

	SetFont(bar1);
	HudMessageBold(s:"A"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
    // SetHudClipRect((calcX >> 16) + clipOffsW, (calcY >> 16) + clipOffsH, width, height);
    SetHudClipRect(0, 0, 0, 0, 0);
    SetFont(empty);
    HudMessageBold(s:"A"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
	SetHudClipRect(0,0,0,0);
}

function int UIXLIB_mask(int x)
{
	return (x & 0xffff0000);
}

function int actorExists(str which) {
	int u = UniqueTID();
	int sp = SpawnForced(which, 0, 0, 0, u, 0);
	if(sp)
		Thing_Remove(u);

	return sp;
}

function int new(str which) {
	int u = UniqueTID();
	if(SpawnForced(which, 0, 0, 0, u, 0))
		return u;

	return 0;
}

function void destroy(int tid) {
	Thing_Remove(tid);
}

function int GetActorArg(int tid, int argNum) {
	return ACS_NamedExecuteWithResult("core_GetActorArg", tid, argNum);
}

int chars[64];
function str Dec2Hex(int n, int minDigits) {
	int count = countHexDigits(n);
	int d = count;
	for(int i = 0; i < (minDigits - count); i++) {
		chars[i] = '0';
		d++;
	}
	while(n > 0) {
		int m = n % 16;
		if(m < 10) {
			chars[--d] = '0' + m;
		} else {
			chars[--d] = 'A' + (m-10);
		}
		n = n >> 4; // n/16
	}
	str ret = strParam(a:chars);

	for(i = 0; i < count; i++) {
		chars[i] = 0;
	}

	return ret;
}

function int countHexDigits(int n) {
	int count = 0;
	while(n > 0) {
		count++;
		n = n >> 4;
	}
	return count;
}


// Functions shared across UIX modules

#define UIXLIB_ALIGN_LEFT 0.1
#define UIXLIB_ALIGN_RIGHT 0.24
#define UIXLIB_ALIGN_NEGRIGHT 1.0-UIXLIB_ALIGN_RIGHT

#define UIXLIB_ALIGN_CENTER 0.0
#define UIXLIB_ALIGN_CENTER_TEXT 0.4

#define UIXLIB_ALIGN_TOP 0.1
#define UIXLIB_ALIGN_BOTTOM 0.2
// #define UIXLIB_ALIGN_TOP 0.2

#define UIXLIB_BASE_RES_X 1280
#define UIXLIB_BASE_RES_Y 960

#define UIXLIB_BASE_ID 45931

#define UIXLIB_PLN_TID 1000
#define UIXLIB_MAX_PLAYERS 64

#define UIXLIB_MSG_TIME 1873

#define UIXLIB_MAX_INT 2147483647
#define UIXLIB_MIN_INT -2147483648

function int displayIcon(int layer, str icon, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign)
{
	int res = CheckFont(icon);
    if(res) {
		SetFont(icon);
		displayMessage(layer, "A", offsX, offsY, scaleX, scaleY, alpha, halign, valign);
	}
	return res;
}

function int displayIconFade(int layer, str icon, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign, int fadeTime)
{
	int res = CheckFont(icon);
    if(res) {
		SetFont(icon);
		displayMessageFade(layer, "A", offsX, offsY, scaleX, scaleY, alpha, halign, valign, fadeTime);
	}
	return res;
}

int calcX, calcY, calcHAlign, calcvalign;
function void calcMessageDisplayOffsets(int offsX, int offsY, int scaleX, int scaleY, int halign, int valign)
{
	int resX = FixedDiv(UIXLIB_BASE_RES_X, scaleX);
	int resY = FixedDiv(UIXLIB_BASE_RES_Y, scaleY);
	offsX = FixedDiv(offsX << 16, scaleX);
	offsY = FixedDiv(offsY << 16, scaleY);
	calcX = UIXLIB_mask(((resX/2)<<16)+offsX);
	calcY = UIXLIB_mask(((resY/2)<<16)+offsY);

	if(calcX < 0 && halign == UIXLIB_ALIGN_RIGHT) {
		calcHAlign = UIXLIB_ALIGN_NEGRIGHT;
	} else {
		calcHAlign = halign;
	}

	calcVAlign = valign;

	if(calcX < 0)
		calcX -= calcHAlign;
	else
		calcX += calcHAlign;

	if(calcY < 0)
		calcY -= calcVAlign;
	else
		calcY += calcVAlign;

	SetHudSize(resX, resY, 0);
}

function void displayMessage(int layer, str msg, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);
	HudMessageBold(s:msg; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
}

function void displayMessageColor(int layer, str msg, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign, int color)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);
	HudMessageBold(s:msg; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, color, calcX, calcY, UIXLIB_MSG_TIME, alpha);
}

function void displayMessageColorString(int layer, str msg, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign, int color)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);
	HudMessageBold(s:msg; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, color, calcX, calcY, UIXLIB_MSG_TIME, alpha);
}

function void displayMessageFade(int layer, str msg, int offsX, int offsY, int scaleX, int scaleY, int alpha, int halign, int valign, int fadeTime)
{
	calcMessageDisplayOffsets(offsX, offsY, scaleX, scaleY, halign, valign);
	if(fadeTime > 0)
		HudMessageBold(s:msg; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|HUDMSG_FADEOUT|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, fadeTime, alpha);
	else
		HudMessageBold(s:msg; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOWRAP|layer, 0, CR_UNTRANSLATED, calcX, calcY, UIXLIB_MSG_TIME, alpha);
}


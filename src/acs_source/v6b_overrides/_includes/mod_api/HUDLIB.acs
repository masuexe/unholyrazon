function int UniqueHudMessageID(void)
{
    return ACS_NamedExecuteWithResult("core_Get_And_Increment_AssistDisplayID");
}

#define HUDLIB_NONE 0
#define HUDLIB_VERT 1
#define HUDLIB_HORI 2

function bool GetHUDMode(void)
{
	int screenblocks = GetCvar("screenblocks");
	if(screenblocks == 11) return HUDLIB_VERT;
	if(screenblocks < 11) return HUDLIB_HORI;
	return HUDLIB_NONE;
}

#define HUDLIB_ONE_TIC 1873

function void DrawImage(str vertImage, str horiImage, int id, int id2, int x1, int y1, int x2, int y2)
{
    DrawImageEx(vertImage, horiImage, id, id2, x1, y1, x2, y2, HUDLIB_ONE_TIC, 1.0, HUDMSG_PLAIN);
}

function void DrawImageEx(str vertImage, str horiImage, int id, int id2, int x1, int y1, int x2, int y2, int holdtime, int alpha, int flags)
{
	if (GetHUDMode() == HUDLIB_HORI) {
		SetFont(horiImage);
		HudMessageBold(s:"A"; HUDMSG_PLAIN|flags, id, CR_UNTRANSLATED, x2, y2, holdtime, alpha);
	} else {
		SetFont(horiImage);
		HudMessageBold(s:"A"; HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW|flags, id2, CR_UNTRANSLATED, x2, y2, holdtime, alpha);
		if (GetHUDMode() == HUDLIB_VERT) {
			SetFont(vertImage);
			HudMessageBold(s:"A"; HUDMSG_NOTWITHFULLMAP|flags, id, CR_UNTRANSLATED, x1, y1, holdtime, alpha);
		}
	}
}

function void DrawString(str string, str font, int color, int id, int id2, int x1, int y1, int x2, int y2)
{
    DrawStringEx(string, font, color, id, id2, x1, y1, x2, y2, HUDLIB_ONE_TIC, 1.0, HUDMSG_PLAIN);
}

function void DrawStringEx(str string, str font, int color, int id, int id2, int x1, int y1, int x2, int y2, int holdtime, int alpha, int flags)
{
    SetFont(font);
	if (GetHUDMode() == HUDLIB_HORI) {
		HudMessageBold(s:string; HUDMSG_PLAIN|flags, id, color, x2, y2, holdtime, alpha);
	} else {
		HudMessageBold(s:string; HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW|flags, id2, color, x2, y2, holdtime, alpha);
		if (GetHUDMode() == HUDLIB_VERT) {
			HudMessageBold(s:string; HUDMSG_NOTWITHFULLMAP|flags, id, color, x1, y1, holdtime, alpha);
		}
	}
}

function void DrawNumber(int num, str font, int color, int id, int id2, int x1, int y1, int x2, int y2)
{
    DrawNumberEx(num, font, color, id, id2, x1, y1, x2, y2, HUDLIB_ONE_TIC, 1.0, HUDMSG_PLAIN);
}

function void DrawNumberEx(int num, str font, int color, int id, int id2, int x1, int y1, int x2, int y2, int holdtime, int alpha, int flags)
{
    SetFont(font);
	if (GetHUDMode() == HUDLIB_HORI) {
		HudMessageBold(i:num; HUDMSG_PLAIN|flags, id, color, x2, y2, holdtime, alpha);
	} else {
		HudMessageBold(i:num; HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW|flags, id2, color, x2, y2, holdtime, alpha);
		if (GetHUDMode() == HUDLIB_VERT) {
			HudMessageBold(i:num; HUDMSG_NOTWITHFULLMAP|flags, id, color, x1, y1, holdtime, alpha);
		}
	}
}

function void DrawFixed(int num, str font, int color, int id, int id2, int x1, int y1, int x2, int y2)
{
    DrawNumberEx(num, font, color, id, id2, x1, y1, x2, y2, HUDLIB_ONE_TIC, 1.0, HUDMSG_PLAIN);
}

function void DrawFixedEx(int num, str font, int color, int id, int id2, int x1, int y1, int x2, int y2, int holdtime, int alpha, int flags)
{
    SetFont(font);
	if (GetHUDMode() == HUDLIB_HORI) {
		HudMessageBold(f:num; HUDMSG_PLAIN|flags, id, color, x2, y2, holdtime, alpha);
	} else {
		HudMessageBold(f:num; HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW|flags, id2, color, x2, y2, holdtime, alpha);
		if (GetHUDMode() == HUDLIB_VERT) {
			HudMessageBold(f:num; HUDMSG_NOTWITHFULLMAP|flags, id, color, x1, y1, holdtime, alpha);
		}
	}
}
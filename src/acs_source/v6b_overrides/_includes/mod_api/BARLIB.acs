}

function void SetFlashingBar(void) {
    SetInventory("SBARFlash", 1);
}

function void SetFlashingBar2(void) {
    SetInventory("SBARFlash2", 1);
}

function void SetFlashingBar3(void) {  // $UH
    SetInventory("SBARFlash3", 1);
}

function void SetFlashingBarHP(void) {
    SetInventory("HBARFlash", 1);
}

function void SetDarkenedBar(void) {
    SetInventory("SBARDarken", 1);
}

function void SetDarkenedBar2(void) {
    SetInventory("SBARDarken2", 1);
}

function void SetDarkenedBar3(void) {  // $UH
    SetInventory("SBARDarken3", 1);
}

function void SetDarkenedBarHP(void) {
    SetInventory("HBARDarken", 1);
}

function void SetMugshotColor(int cyan, int blue) {
    SetMugshotColorGlow(cyan, blue, 0);
}

function void SetMugshotColorGlow(int cyan, int blue, int black) {
    SetInventory("MugshotTransFlag", 1);
    SetInventory("SBARMugshotCyan", cyan + 1);
    SetInventory("SBARMugshotBlue", blue + 1);
    SetInventory("SBARMugshotBlack", black + 1);
}

function void DrawBarColor(int cyan, int blue) {
    DrawBarColorGlow(cyan, blue, 0);
}

function void DrawBarColorGlow(int cyan, int blue, int black) {
    if (CheckInventory("MugshotTransFlag") <= 0) {
        SetMugshotColorGlow(cyan, blue, black);
    }
    SetInventory("BarTransFlag", 1);
    SetInventory("SBARCyan", cyan + 1);
    SetInventory("SBARBlue", blue + 1);
    SetInventory("SBARBlack", black + 1);
    SetInventory("SBARDrawBar1", 1);
    SetInventory("SBARAmmoOffset", BARLIB_max(1, CheckInventory("SBARAmmoOffset")));
    DrawNormalAmmo();
}

// $UH — bar1 with explicit owned/capacity via Ammo1Disp proxy
function void DrawBarColorOwned(int owned, int capacity, int cyan, int blue) {
    DrawBarColorOwnedGlow(owned, capacity, cyan, blue, 0);
}

function void DrawBarColorOwnedGlow(int owned, int capacity, int cyan, int blue, int black) {
    if (CheckInventory("MugshotTransFlag") <= 0) {
        SetMugshotColorGlow(cyan, blue, black);
    }
    SetInventory("BarTransFlag", 1);
    SetInventory("SBARCyan", cyan + 1);
    SetInventory("SBARBlue", blue + 1);
    SetInventory("SBARBlack", black + 1);
    SetInventory("SBARUseAmmo1Disp", 1);
    SetInventory("SBARDrawBar1", 1);
    SetInventory("SBARAmmoOffset", BARLIB_max(1, CheckInventory("SBARAmmoOffset")));
    SetAmmoAmountAndCapacity("Ammo1Disp", owned, capacity);
    DrawNormalAmmo();
}

function void DrawBar2Color(int cyan, int blue) {
    DrawBar2ColorGlow(cyan, blue, 0);
}

function void DrawBar2ColorGlow(int cyan, int blue, int black) {
    if (CheckInventory("MugshotTransFlag") <= 0) {
        SetMugshotColorGlow(cyan, blue, black);
    }
    SetInventory("BarTransFlag2", 1);
    SetInventory("SBARCyan2", cyan + 1);
    SetInventory("SBARBlue2", blue + 1);
    SetInventory("SBARBlack2", black + 1);
    SetInventory("SBARDrawBar2", 1);
    SetInventory("SBARAmmoOffset", BARLIB_max(2, CheckInventory("SBARAmmoOffset")));
    DrawSecondAmmo();
}

// $UH — bar2 with explicit owned/capacity via Ammo2Disp proxy
function void DrawBar2ColorOwned(int owned, int capacity, int cyan, int blue) {
    DrawBar2ColorOwnedGlow(owned, capacity, cyan, blue, 0);
}

function void DrawBar2ColorOwnedGlow(int owned, int capacity, int cyan, int blue, int black) {
    if (CheckInventory("MugshotTransFlag") <= 0) {
        SetMugshotColorGlow(cyan, blue, black);
    }
    SetInventory("BarTransFlag2", 1);
    SetInventory("SBARCyan2", cyan + 1);
    SetInventory("SBARBlue2", blue + 1);
    SetInventory("SBARBlack2", black + 1);
    SetInventory("SBARUseAmmo2Disp", 1);
    SetInventory("SBARDrawBar2", 1);
    SetInventory("SBARAmmoOffset", BARLIB_max(2, CheckInventory("SBARAmmoOffset")));
    SetAmmoAmountAndCapacity("Ammo2Disp", owned, capacity);
    DrawSecondAmmo();
}

// $UH
function void DrawBar3Color(int owned, int capacity, int cyan, int blue) {
    DrawBar3ColorGlow(owned, capacity, cyan, blue, 0);
}

function void DrawBar3ColorGlow(int owned, int capacity, int cyan, int blue, int black) {
    if (CheckInventory("MugshotTransFlag") <= 0) {
        SetMugshotColorGlow(cyan, blue, black);
    }
    SetInventory("BarTransFlag3", 1);
    SetInventory("SBARCyan3", cyan + 1);
    SetInventory("SBARBlue3", blue + 1);
    SetInventory("SBARBlack3", black + 1);
    SetInventory("SBARDrawBar3", 1);
    SetInventory("SBARAmmoOffset", BARLIB_max(3, CheckInventory("SBARAmmoOffset")));
    SetAmmoAmountAndCapacity("Ammo3", owned, capacity);
    DrawThirdAmmo();
}
// $UH
function void DrawNormalAmmo(void) {
    SetInventory("SBARDrawAmmo1", 1);
}

function void DrawSecondAmmo(void) {
    SetInventory("SBARDrawAmmo2", 1);
}

function void DrawThirdAmmo(void) {
    SetInventory("SBARDrawAmmo3", 1);
}

function void RemoveCustomBar(int slot) {
    SetInventory(StrParam(s:"CustSbarSlotFlag", i:slot), 0);
}

function void DrawCustomBar(int slot, int amount, int capacity) {
    ACS_NamedExecuteWithResult("core_raisecleanupflags", 0, slot);
    SetInventory(StrParam(s:"CustSbarSlotFlag", i:slot), 1);
    SetAmmoAmountAndCapacity(StrParam(s:"CustSbarSlotAmmo", i:slot), amount, capacity);
}

// Many functions capable of being used for various bar actions.
function int BARLIB_max(int a, int b) {
    if (a > b)
        return a;
    return b;
}

function int GetActorMaxHealth(int tid) {
    int r = GetActorProperty(tid, APROP_SpawnHealth);
    if (r == 0) r = 100;
    return r;
}

function void SetAmmoAmountAndCapacity(str inventory_item, int amount, int capacity) {
    SetAmmoCapacity(inventory_item, capacity);
    SetInventory(inventory_item, amount);
}

function void SetAmmoNumberOffset(int offset) {
    SetInventory("SBARAmmoOffset", BARLIB_max(offset, CheckInventory("SBARAmmoOffset")));
}


function void DrawVerticalCustomBar(int slot, int amount, int capacity) {
    ACS_NamedExecuteWithResult("core_raisecleanupflags", 1, slot);
    SetInventory(StrParam(s:"CustVSbarSlotFlag", i:slot), 1);
    SetAmmoAmountAndCapacity(StrParam(s:"CustVSbarSlotAmmo", i:slot), amount, capacity);
}


function void DrawHorizontalCustomBar(int slot, int amount, int capacity) {
    ACS_NamedExecuteWithResult("core_raisecleanupflags", 2, slot);
    SetInventory(StrParam(s:"CustHSbarSlotFlag", i:slot), 1);
    SetAmmoAmountAndCapacity(StrParam(s:"CustHSbarSlotAmmo", i:slot), amount, capacity);
}



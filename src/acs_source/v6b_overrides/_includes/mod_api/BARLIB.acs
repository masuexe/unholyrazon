    SetAmmoAmountAndCapacity("SBARFlashOverlayAmmo3", owned, capacity);
}

function void SetOverlayBarHP(int owned, int capacity) {
    SetAmmoAmountAndCapacity("HBARFlashOverlayAmmo", owned, capacity);
}


// Wheel invocation / closing
function void OpenWheel(str wheelName, str infoScript, str drawScript)
{
    ACS_NamedExecuteWithResult("core_wheel_openWheel", wheelName, infoScript, drawScript);
}

function void CloseWheel(str wheelName, str selectScript)
{
    ACS_NamedExecuteWithResult("core_wheel_closeWheel", wheelName, selectScript);
}

// Info script functions
function void ResetWheel(void)
{
    ACS_NamedExecuteWithResult("core_wheel_resetWheel");
}

function int AddWheelSlot(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_addWheelSlot");
}

function void AddWheelItem(int slot, int id)
{
    ACS_NamedExecuteWithResult("core_wheel_addWheelItem", slot, id);
}

function void SetWheelDefaultItem(int id)
{
    ACS_NamedExecuteWithResult("core_wheel_setWheelDefaultItem", id);
}

// Draw script functions
function int GetWheelScale(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getScale");
}

function int GetWheelAlpha(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getAlpha");
}

function int GetWheelFadeTime(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getFadeTime");
}

function int GetWheelItemID(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getItemID");
}

#define WHEELLIB_ITEM_MODE_IDLE 0
#define WHEELLIB_ITEM_MODE_SELECTED 1
#define WHEELLIB_ITEM_MODE_MIDDLE 2
function int GetWheelItemMode(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getItemMode");
}

function int GetWheelItemX(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getItemX");
}

function int GetWheelItemY(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getItemY");
}

function int GetWheelItemAngle(void)
{
    return ACS_NamedExecuteWithResult("core_wheel_getItemAngle");
}

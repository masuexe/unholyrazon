function bool DamageHook_SetActivator(int tid, int ptr) {
	if(!ACS_NamedExecuteWithResult("core_damagehook_checkActive")) {
        Log(s:"[DamageHook_SetActivator] \cgFunction called outside of damage hook context!");
		return false;
	}

	if(ptr & (AAPTR_DAMAGE_SOURCE|AAPTR_DAMAGE_INFLICTOR|AAPTR_DAMAGE_TARGET)) {
		tid = ACS_NamedExecuteWithResult("core_damagehook_pointermaster");
		ptr = ACS_NamedExecuteWithResult("core_damagehook_convertpointer", ptr);
	}

	return SetActivator(tid, ptr);
}

function bool DamageHook_IsPointerEqual(int ptr1, int ptr2, int tid1, int tid2) {
	return ACS_NamedExecuteWithResult("core_damagehook_IsPointerEqual", ptr1, ptr2, tid1, tid2);
}

function bool DamageHook_SetPointer(int assign, int tid, int ptr, int flags) {
	return ACS_NamedExecuteWithResult("core_damagehook_SetPointer", assign, tid, ptr, flags);
}

function void DamageHook_SetResultValue(int val) {
	ACS_NamedExecuteWithResult("core_damagehook_SetResultValue", val);
}

function int DamageHook_GetEventResult(void) {
	return ACS_NamedExecuteWithResult("core_damagehook_GetEventResult");
}


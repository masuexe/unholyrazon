function int DefinePowerAprop(str giver, str powerUp, int property, int factor, int permanent) {
	SetDTADDVersion(1);
	SetCvarString("_8bdmpoweraprop_giver", giver);
	SetCvarString("_8bdmpoweraprop_powerUp", powerUp);
	SetCvar("_8bdmpoweraprop_property", property);
	SetCvar("_8bdmpoweraprop_factor", factor);
	SetCvar("_8bdmpoweraprop_permanent", permanent);
    return ACS_NamedExecuteWithResult("core_DefinePowerAprop_S");
}


// Shared functions by below items
function void SetDTADDVersion(int version) {
	SetCvar("_8bdm_dtadd_version", version);
}

function void InitializeDataForClients(str callee) {
	ACS_NamedExecuteWithResult("core_init_client_data", callee);
}

// Weapon definitions, used for ammo and weapon management ==================================================================
// String:  Tag         - The weapon's language tag, or its proper name (Ex. "TAG_ROLLINGCUTTER" or "Rolling Cutter")
// String:  Actor       - The weapon's class name. (Ex. "RollingCutterWep")
// String:  Icon        - The weapon's spawn sprite. (Ex. "WEA2F0")
// String:  AmmoType    - The weapon's ammo class name. (Ex. "RollingCutterAmmo")
// Fixed:   AmmoFactor  - The weapon's ammo collection rate. (1.0 for normal, bigger number for faster ammo regen, smaller number for slower ammo regen)
// String:  Ammo2Type   - The weapon's ammo2 class name. (Ex. "RollingCutterAmmo")
// Fixed:   Ammo2Factor - The weapon's ammo2 collection rate. (1.0 for normal, bigger number for faster ammo regen, smaller number for slower ammo regen)
// Int:     Slot        - The weapon's slot, should match the actor definiton.
// Bool:    MapValid    - Can you pick this weapon up from maps?
// Bool:    LMSValid    - Can you get this weapon from the LMS rotation?
// Bool:    EddieValid  - Can you get this weapon from Eddie?
// -- Examples of use of this function in COREAMO.acs

#define DTADD_SLOT_0      0
#define DTADD_SLOT_1      1
#define DTADD_SLOT_2      2
#define DTADD_SLOT_3      3
#define DTADD_SLOT_4      4
#define DTADD_SLOT_5      5
#define DTADD_SLOT_6      6
#define DTADD_SLOT_7      7
#define DTADD_SLOT_8      8
#define DTADD_SLOT_9      9

#define DTADD_SLOT_BUSTER DTADD_SLOT_1
#define DTADD_SLOT_RANGED DTADD_SLOT_2
#define DTADD_SLOT_RAPID  DTADD_SLOT_3
#define DTADD_SLOT_CLOSE  DTADD_SLOT_4
#define DTADD_SLOT_POWER  DTADD_SLOT_5
#define DTADD_SLOT_AOE    DTADD_SLOT_6
#define DTADD_SLOT_SHIELD DTADD_SLOT_7

function int DefineNoAmmoWeapon(str wepTag, str wepActor, str wepIcon, int wepSlot, int wepMap, int wepLms, int wepEddie)
{
	return DefineDoubleAmmoWeapon(wepTag, wepActor, wepIcon, "", 0.00, "", 0.00, wepSlot, wepMap, wepLms, wepEddie);
}

function int DefineWeapon(str wepTag, str wepActor, str wepIcon, str wepAmmo, int wepMult, int wepSlot, int wepMap, int wepLms, int wepEddie)
{
	return DefineDoubleAmmoWeapon(wepTag, wepActor, wepIcon, wepAmmo, wepMult, "", 0.00, wepSlot, wepMap, wepLms, wepEddie);
}

function int DefineDoubleAmmoWeapon(str wepTag, str wepActor, str wepIcon, str wepAmmo, int wepMult, str wepAmmo2, int wepMult2, int wepSlot, int wepMap, int wepLms, int wepEddie)
{
	SetDTADDVersion(1);
	SetCvarString("_8bdm_wepTag", wepTag);
	SetCvarString("_8bdm_wepActor", wepActor);
	SetCvarString("_8bdm_wepIcon", wepIcon);
	SetCvarString("_8bdm_wepAmmo", wepAmmo);
	SetCvar("_8bdm_wepMult", wepMult);
	SetCvarString("_8bdm_wepAmmo2", wepAmmo2);
	SetCvar("_8bdm_wepMult2", wepMult2);
	SetCvar("_8bdm_wepSlot", wepSlot);
	SetCvar("_8bdm_wepMap", wepMap);
	SetCvar("_8bdm_wepLms", wepLms);
	SetCvar("_8bdm_wepEddie", wepEddie);
	return ACS_NamedExecuteWithResult("core_DefineWeapon_S");
}

function int DefineNoAmmoClassWeapon(str wepTag, str wepActor, str wepIcon, int wepSlot)
{
	return DefineDoubleAmmoWeapon(wepTag, wepActor, wepIcon, "", 0.00, "", 0.00, wepSlot, false, false, false);
}

function int DefineClassWeapon(str wepTag, str wepActor, str wepIcon, str wepAmmo, int wepMult, int wepSlot)
{
	return DefineDoubleAmmoWeapon(wepTag, wepActor, wepIcon, wepAmmo, wepMult, "", 0.00, wepSlot, false, false, false);
}

function int DefineDoubleAmmoClassWeapon(str wepTag, str wepActor, str wepIcon, str wepAmmo, int wepMult, str wepAmmo2, int wepMult2, int wepSlot)
{
	return DefineDoubleAmmoWeapon(wepTag, wepActor, wepIcon, wepAmmo, wepMult, wepAmmo2, wepMult2, wepSlot, false, false, false);
}

// ==========================================================================================================================
// Defines bar and body color swaps =========================================================================================
// -- Examples of its use in CORECOL.acs

function int DTADD_UnpackByte1(int x) { return (x>>24) & 0x000000FF; }
function int DTADD_UnpackByte2(int x) { return (x>>16) & 0x000000FF; }
function int DTADD_UnpackByte3(int x) { return (x>>8)  & 0x000000FF; }
function bool DTADD_IsRGB(int x) { return ((x>>0)  & 0x000000FF) == 0; }

// just pretend these are overloaded functions that accept int or rgbTriplet
function int CreatePlayerTranslation(int id, int cyan, int blue) {
	return ACS_NamedExecuteWithResult("core_CreatePlayerTranslation_S", id, cyan, blue);
}

function int CreatePlayerTranslationGlow(int id, int cyan, int blue, int black) {
	return ACS_NamedExecuteWithResult("core_CreatePlayerTranslationGlow_S", id, cyan, blue, black);
}


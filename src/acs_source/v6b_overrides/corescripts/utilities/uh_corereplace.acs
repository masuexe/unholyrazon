#library "uh_corereplace"
#include "zcommon.acs"
#include "8BDMDEFS.acs"
#import "8BDT.acs"

#define RUNE_LUCKYPENNY 11

// DECORATE evaluates this expression when a spike damager deals damage, so
// the returned value remains the base damage before normal damage modifiers.
script "uh_GetSpikeDamage" (void) {
  int spike_damage = GetCVar("uh_sv_spikedamage");
  if (spike_damage < 0)
    spike_damage = 0;
  SetResultValue(spike_damage);
}

// Map DeathPit actors register their sector damage during map startup.  A
// value of 0 deliberately leaves those per-marker values untouched.
// Zero-damage markers also track safe, unlit oil pools for later ignition.
script "uh_ApplyPitDamage" OPEN {
  Delay(1);

  int pit_damage = GetCVar("uh_sv_pitdamage");
  if (pit_damage <= 0)
    terminate;

  for (int i = 0; i < getPitCount(); i++) {
    if (getPitDamage(i) <= 0)
      continue;
    Sector_SetDamage(getPitTag(i), pit_damage, getPitMod(i), getPitInterval(i));
    setPitDamage(i, pit_damage);
  }
}

// Player Rune stacker
// Makes sure that players receive the rune that core facilities check for
// Set player to 0 for the activator or specify a player number
// $UH Add Endless Ammo Rune
script "uh_runeplayer" (int player, int toggle, int mode) {
  if (player == 0) {player = PlayerNumber() + 1;}
  if (player <= 0 || !SetActivatorToPlayer(player - 1)) {terminate;}

  str counter;
  str runepower;
  switch (mode) {
    case RUNE_STRENGTH:
      counter = "PlayerPropertyStrength";
      runepower = "PowerDoubleDamageRune";
      break;
    case RUNE_RAGE:
      counter = "PlayerPropertyRage";
      runepower = "PowerDoubleFiringSpeedRune";
      break;
    case RUNE_DRAIN:
      counter = "PlayerPropertyDrain";
      runepower = "PowerDrainRune";
      break;
    case RUNE_SPREAD:
      counter = "PlayerPropertySpread";
      runepower = "PowerSpreadRune";
      break;
    case RUNE_RESISTANCE:
      counter = "PlayerPropertyResistance";
      runepower = "PowerHalfDamageRune";
      break;
    case RUNE_REGENERATION:
      counter = "PlayerPropertyRegeneration";
      runepower = "PowerRegenerationRune";
      break;
    case RUNE_PROSPERITY:
      counter = "PlayerPropertyProsperity";
      runepower = "PowerProsperityRune";
      break;
    case RUNE_REFLECTION:
      counter = "PlayerPropertyReflection";
      runepower = "PowerReflectionRune";
      break;
    case RUNE_HIGHJUMP:
      counter = "PlayerPropertyHighJump";
      runepower = "PowerHighJumpRune";
      break;
    case RUNE_HASTE:
      counter = "PlayerPropertyHaste";
      runepower = "PowerSpeed25Rune";
      break;
    case RUNE_ENDLESSAMMO:
      counter = "PlayerPropertyEndlessAmmo";
      runepower = "PowerEndlessAmmoRune";
      break;
    case RUNE_LUCKYPENNY:
      counter = "PlayerPropertyLuckyPenny";
      runepower = "PowerLuckyPennyRune";
      break;
  }

  if (toggle >= 1) {
    if (CheckInventory(counter) <= 0) {
      GiveInventory(StrParam(s:runepower, s:"Giver"), 1);
      if (mode == RUNE_REGENERATION) {
        ACS_NamedExecuteWithResult("core_RegenerationRune");
      }
    }
    GiveInventory(counter, 1);
  } else if (CheckInventory(counter) > 0) {
    TakeInventory(counter, 1);

    if (CheckInventory(counter) == 0) {
      TakeInventory(runepower, 999);
    }
  }
}

// Script to check for specific runes on a pointer
script "uh_checkrune" (int rune, int ptr) {
  if (ptr != 0) {
    SetActivator(0, ptr);
  }

  str runepower;
  switch (rune) {
    case RUNE_STRENGTH:
      runepower = "PowerDoubleDamageRune";
      break;
    case RUNE_RAGE:
      runepower = "PowerDoubleFiringSpeedRune";
      break;
    case RUNE_DRAIN:
      runepower = "PowerDrainRune";
      break;
    case RUNE_SPREAD:
      runepower = "PowerSpreadRune";
      break;
    case RUNE_RESISTANCE:
      runepower = "PowerHalfDamageRune";
      break;
    case RUNE_REGENERATION:
      runepower = "PowerRegenerationRune";
      break;
    case RUNE_PROSPERITY:
      runepower = "PowerProsperityRune";
      break;
    case RUNE_REFLECTION:
      runepower = "PowerReflectionRune";
      break;
    case RUNE_HIGHJUMP:
      runepower = "PowerHighJumpRune";
      break;
    case RUNE_HASTE:
      runepower = "PowerSpeed25Rune";
      break;
    case RUNE_ENDLESSAMMO:
      runepower = "PowerEndlessAmmoRune";
      break;
    case RUNE_LUCKYPENNY:
      runepower = "PowerLuckyPennyRune";
      break;
  }

  SetResultValue(CheckInventory(runepower));
}

script "uh_CheckForLuckyPenny" (int ptr) {
  if (ptr != 0) {
    SetActivator(0, ptr);
  }
  SetResultValue(CheckInventory("PowerLuckyPennyRune"));
}

// KNK_AIMED and KNK_ADDZTHRUST are supplied by v6c 8BDMDEFS.
// $UH Changes aimed into a flag
script "uh_knockback" (int force, int forcez, int flags, int ptr) {
  SetActivatorToTarget(0);  // $UH Spawned actors are calling this script

  int px = ACS_NamedExecuteWithResult("core_getactorx", ptr, 0, true);
  int py = ACS_NamedExecuteWithResult("core_getactory", ptr, 0, true);

  int yaw = VectorAngle(GetActorX(0) - px, GetActorY(0) - py) >> 8;

  if (flags & KNK_AIMED) {  // $UH
    int pitch = ACS_NamedExecuteWithResult("core_GetPtrPitch", ptr, 0, true);
    int heightmul = sin(-pitch);
    int distmul = cos(pitch);

    ThrustThingZ(0, fixedMul(force, heightmul) * 4, 0, (flags & KNK_ADDZTHRUST));  // $UH
    ThrustThing(yaw, fixedMul(force, distmul), 1, 0);
  } else {
    ThrustThingZ(0, forcez, 0, (flags & KNK_ADDZTHRUST));  // $UH
    ThrustThing(yaw, force, 1, 0);
  }
}

#define UH_NODELIST_PROJ_TID -9997

int uh_staticDamageFactorTmp = 0;

function bool UH_CheckForVar(str thevar) {
  SetUserVariable(0, thevar, 1);
  return (GetUserVariable(0, thevar) == 1);
}

// Helper for uh_handleStaticDamageFactor_Proj: runs on AAPTR_TARGET so the
// projectile stays the caller's activator and never changes TID.
script "uh_QueryTargetStaticDamageFactor" (void) {
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  if (!ACS_NamedExecuteWithResult("core_canuseaproppowerups")) {
    SetResultValue(0);
    terminate;
  }
  uh_staticDamageFactorTmp = ACS_NamedExecuteWithResult("core_caprop", 0, CAPROP_StaticDamageFactor);
  SetResultValue(1);
}

// Zero-Thing_ChangeTID replacement for core_handleStaticDamageFactor_Proj.
script "uh_handleStaticDamageFactor_Proj" (void) {
  if (UH_CheckForVar("user_ignoreStaticDamageFactor"))
    terminate;

  if (ACS_NamedExecuteWithResult("uh_QueryTargetStaticDamageFactor")) {
    int factor = uh_staticDamageFactorTmp;
    GiveInventory("StaticDamageFactorApplied", 1);
    if (factor != 0.0) {
      GiveInventory("StaticDamageFactorAmount", factor);
    }
  }
}

// Helper for uh_handleCounterAttacker_Proj: inspects AAPTR_TARGET without
// changing the projectile's TID. Returns bitmask: bit 0 = active, bit 1 = play sound.
script "uh_CheckTargetCounterAttacker" (void) {
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  if (CheckInventory("CounterAttackerActive_F") <= 0) {
    SetResultValue(0);
    terminate;
  }

  int flags = 1;
  if (CheckInventory("CounterAttackerSoundDelay_P") == 0) {
    GiveInventory("CounterAttackerSoundDelay_P", 1);
    flags |= 2;
  }
  SetResultValue(flags);
}

// Zero-Thing_ChangeTID replacement for core_handleCounterAttacker_Proj.
script "uh_handleCounterAttacker_Proj" (void) {
  if (UH_CheckForVar("user_ignoreStaticDamageFactor"))
    terminate;
  if (UH_CheckForVar("user_noProjectileTrails"))
    terminate;

  int flags = ACS_NamedExecuteWithResult("uh_CheckTargetCounterAttacker");
  if (flags <= 0)
    terminate;

  if (CheckInventory("CounterAttackerActive_F") == 0) {
    GiveInventory("CounterAttackerActive_F", 1);
    GiveInventory("CounterAttackerTrailer_CI", 1);
  }
  if (flags & 2) {
    GiveInventory("CounterAttackerSound_CI", 1);
  }
}

script "uh_LinkProjNode" (int node_list_tid, int new_node_tid) {
  SetActivator(node_list_tid);

  if (SetActivator(0, AAPTR_TRACER)) {
    ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", new_node_tid, AAPTR_TRACER);
    SetPointer(AAPTR_MASTER, new_node_tid);
  }

  SetActivator(node_list_tid);
  SetPointer(AAPTR_TRACER, new_node_tid);

  SetActivator(new_node_tid);
  SetPointer(AAPTR_MASTER, node_list_tid);
  Thing_ChangeTID(new_node_tid, 0);
}

// Zero-Thing_ChangeTID replacement for core_projnodelist.
// SpawnProjectile(0, ...) sets NodeList_Node->target = activator directly
// without modifying the projectile's TID; NodeList_Node is +SERVERSIDEONLY +NOCLIP.
script "uh_projnodelist" (void) {
  int cls = ClassifyActor(0);
  if (cls == ACTOR_NONE || (cls & ACTOR_WORLD))
    terminate;

  if (ThingCount(T_NONE, UH_NODELIST_PROJ_TID) <= 0) {
    SpawnForced("NodeList_Node", GetActorX(0), GetActorY(0), GetActorZ(0), UH_NODELIST_PROJ_TID, 0);
  }

  int new_node_temp = UniqueTID();
  SpawnProjectile(0, "NodeList_Node", 0, 0, 0, 0, new_node_temp);
  if (ThingCount(T_NONE, new_node_temp) <= 0)
    terminate;

  ACS_NamedExecuteWithResult("uh_LinkProjNode", UH_NODELIST_PROJ_TID, new_node_temp);
}

script "core_automap_pillar_c" (int arg) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    if(arg < 0)
        terminate;

    if(arg <= 3) {
        str marker = StrParam(s:"MegaAnyScorePillar_", i:arg, s:"_MapMarker");
    } else {
        marker = "MegaAnyScorePillar_Any_MapMarker";
    }

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {
            Delay(1);
            continue;
        }

        if(GetCvar("mm8bdm_sv_noobjectiveradar")) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_objectives") || !GetCvar("mm8bdm_sv_automap_objectives")) {
            Delay(1);
            continue;
        }

        int velx = GetActorVelX(0);
        int vely = GetActorVelY(0);

        int u = UniqueTID();
        if(SpawnForced(marker, GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0))) {
            SetActorVelocity(u, velx, vely, 0.0, false, false);
            Thing_SetTranslation(u, -1);
            Thing_ChangeTID(u, 0);
        }

        Delay(1);
    }
}

script "core_automap_domination_vertex" (void)
{
    // Don't run this for children vertexes
    if(!IsPointerEqual(AAPTR_TARGET, AAPTR_NULL))
        terminate;

    if(CheckInventory("AutomapScriptRunning"))
        terminate;

    GiveInventory("AutomapScriptRunning", 1);

    int next_vertex = ACS_NamedExecuteWithResult("core_getArg", 0);

    int start = Timer();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if((Timer() - start) % 35 == 0)
            ACS_NamedExecuteWithResult("core_automap_domination_vertex_c", next_vertex);
        Delay(1);
    }
}

script "core_automap_domination_vertex_c" (int next_vertex) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    int x1 = GetActorX(0);
    int y1 = GetActorY(0);
    int z1 = GetActorZ(0);

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {
            Delay(1);
            continue;
        }

        if(GetCvar("mm8bdm_sv_noobjectiveradar")) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_objectives") || !GetCvar("mm8bdm_sv_automap_objectives")) {
            Delay(1);
            continue;
        }

        int owner = GetUserVariable(0, "user_owner");
        if(owner > 255) {
            Delay(1);
            continue;
        }

        int x2 = GetActorX(next_vertex);
        int y2 = GetActorY(next_vertex);
        int z2 = GetActorZ(next_vertex);

        int edge_length = VectorLength(VectorLength(x2 - x1, y2 - y1), z2 - z1);
        int num_actors = (edge_length / 18) >> 16;

        int u = UniqueTID();
        for (int actor = 0; actor <= num_actors; actor++) {
            int t = (actor << 16) / (num_actors + 1);
            if(SpawnForced("DominationPointVertex_MapMarker", x1 + FixedMul(t, (x2 - x1)), y1 + FixedMul(t, (y2 - y1)), z1 + FixedMul(t, (z2 - z1)), u, 0)) {
                Thing_SetTranslation(u, -1);
                Thing_ChangeTID(u, 0);
            }
        }

        Delay(1);
    }
}

script "core_automap_domination_center" (void)
{
    if(CheckInventory("AutomapScriptRunning"))
        terminate;

    GiveInventory("AutomapScriptRunning", 1);

    int start = Timer();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if((Timer() - start) % 35 == 0)
            ACS_NamedExecuteWithResult("core_automap_domination_center_c");
        Delay(1);
    }
}

script "core_automap_domination_center_c" (int next_vertex) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {
            Delay(1);
            continue;
        }

        if(GetCvar("mm8bdm_sv_noobjectiveradar")) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_objectives") || !GetCvar("mm8bdm_sv_automap_objectives")) {
            Delay(1);
            continue;
        }

        int owner = GetUserVariable(0, "user_owner");
        if(owner > 255) {
            Delay(1);
            continue;
        }

        int index = ACS_NamedExecuteWithResult("core_find_domination_point_by_tag", ActivatorTID());
        if(index < 0) {
            Delay(1);
            continue;
        }

        int u = UniqueTID();
        if(SpawnForced("DominationPoint_MapMarker", GetActorX(0), GetActorY(0), GetActorZ(0), u, 0)) {
            Thing_SetTranslation(u, -1);
            Thing_ChangeTID(u, 0);
        }

        int captureProgress = ACS_NamedExecuteWithResult("core_domination_get_contesting_progress", index);
        int contestingTeam = ACS_NamedExecuteWithResult("core_domination_get_contesting_team", index);
        if(captureProgress > 0) {
            SpawnForced("DominationPoint_Progress_MapMarker", GetActorX(0), GetActorY(0), GetActorZ(0), u, 0);
            SetActorState(u, StrParam(s:"Spawn", i:((captureProgress * 7) >> 16)));
            Thing_SetTranslation(u, TCLR_DEFAULT + contestingTeam);
            Thing_ChangeTID(u, 0);
        }

        SpawnForced("DominationPoint_Letter_MapMarker", GetActorX(0), GetActorY(0), GetActorZ(0), u, 0);
        SetActorState(u, StrParam(s:"Spawn", c:index+65));
        Thing_ChangeTID(u, 0);

        Delay(1);
    }
}
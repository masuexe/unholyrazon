        if(GetCvar("mm8bdm_sv_noobjectiveradar") || !(GetCvar("mm8bdm_sv_exactartifactposition") & RADAR_EXACT_MODE_OBJECTIVES || !PlayerInGame(cpn))) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_objectives") || !GetCvar("mm8bdm_sv_automap_objectives")) {
            Delay(1);
            continue;
        }

        int velx = GetActorVelX(0);
        int vely = GetActorVelY(0);

        int u = UniqueTID();
        if(SpawnForced(StrParam(s:GetActorClass(0), s:"_MapMarker"), GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0))) {
            SetActorVelocity(u, velx, vely, 0.0, false, false);
            Thing_ChangeTID(u, 0);
        }

        Delay(1);
    }
}


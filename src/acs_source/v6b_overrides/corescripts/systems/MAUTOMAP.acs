script "core_automap_artifact_c" (void) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {

// MM8BDM v6c shadow: native markers/arrows with UH visibility and S/B/E icons.
#library "MAUTOMAP"
#include "zcommon.acs"

#include "8BDMDEFS.acs"

#include "DTADD.acs"

script "core_automap_reveal" OPEN CLIENTSIDE
{
    if(!GetCvar("mm8bdm_sv_revealmap"))
        terminate;

    if(SetActivatorToPlayer(ConsolePlayerNumber()))
        GiveInventory("MapRevealer", 1);
}

script "core_automap_allow_animation" (void)
{
    SetResultValue(GetUserCvar(ConsolePlayerNumber(), "mm8bdm_automap_animations"));
}

#define ARROW_DIST 80.0
script "core_automap_player_markers" OPEN CLIENTSIDE
{
    bool cooperative = GetCvar("cooperative");
    bool teamGame = ACS_NamedExecuteWithResult("core_checkmode", 1) && !cooperative;
    bool ctf = GetCvar("ctf");
    bool oneflagctf = GetCvar("oneflagctf");
    bool skulltag = GetCvar("skulltag");
    bool possession = GetCvar("possession") || GetCvar("teampossession");
    bool terminator = GetCvar("terminator");

    int cpn = ConsolePlayerNumber();

    while(true) {
        int autoMapStatus = CheckAutomap();
        if(autoMapStatus == AUTOMAP_OFF) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_players") || GetCvar("sv_noautomapallies")) {
            Delay(1);
            continue;
        }

        int rotate = GetCvar("am_rotate");
        if(rotate == 1 || (rotate == 2 && autoMapStatus == AUTOMAP_OVERLAYMAP)) {
            SetActivatorToPlayer(ConsolePlayerNumber());
            SetActivator(0, AAPTR_PLAYER_GETCAMERA);
            int angle = GetActorAngle(0);
            SetActivator(0, AAPTR_NULL);
        } else {
            angle = 0.25;
        }

        for(int pln = 0; pln < MAX_PLAYERS; pln++) {
            if(!PlayerInGame(pln))
                continue;

            SetActivatorToPlayer(pln);

            if(GetActorProperty(0, APROP_Health) <= 0)
                continue;

            bool should_reveal = false;
            str objective_item = "";

            if(GetCvar("mm8bdm_sv_automap_objectives") && GetUserCvar(cpn, "mm8bdm_automap_objectives") && !GetCvar("mm8bdm_sv_noobjectiveradar")) {
                if(ctf) {
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaBlueFlag") > 0)
                            objective_item = "MegaBlueFlag_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaRedFlag") > 0)
                            objective_item = "MegaRedFlag_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaGreenFlag") > 0)
                            objective_item = "MegaGreenFlag_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaYellowFlag") > 0)
                            objective_item = "MegaYellowFlag_Held_MapMarker";
                    }
                }

                if(oneflagctf) {
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaWhiteFlag") > 0)
                            objective_item = "MegaWhiteFlag_Held_MapMarker";
                    }
                }

                if(skulltag) {
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaBlueHat") > 0)
                            objective_item = "MegaBlueHat_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaRedHat") > 0)
                            objective_item = "MegaRedHat_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaGreenHat") > 0)
                            objective_item = "MegaGreenHat_Held_MapMarker";
                    }
                    if(StrICmp(objective_item, "") == 0) {
                        if(ACS_NamedExecuteWithResult("core_checkReplacedInventory", "MegaYellowHat") > 0)
                            objective_item = "MegaYellowHat_Held_MapMarker";
                    }
                }

                // Flags and Skulltag helmets are allowed to reveal players
                if(StrICmp(objective_item, "") != 0)
                    should_reveal = true;

                if(possession) {
                    if(CheckInventory("PowerPossessionArtifact") > 0) {
                        objective_item = "MegaPossessionStone_Held_MapMarker";

                        if(GetCvar("mm8bdm_sv_exactartifactposition") & RADAR_EXACT_MODE_PLAYERS)
                            should_reveal = true;
                    }
                }

                if(terminator) {
                    if(CheckInventory("PowerTerminatorArtifact") > 0) {
                        objective_item = "MegaTerminator_Held_MapMarker";

                        if(GetCvar("mm8bdm_sv_exactartifactposition") & RADAR_EXACT_MODE_PLAYERS)
                            should_reveal = true;
                    }
                }
            }

            bool revealed = false;

            if (ACS_NamedExecuteWithResult("uh_IsUnholyTeamMode")) {
                if (!ACS_NamedExecuteWithResult("uh_AM_CanSee", cpn, pln))
                    continue;
            } else {
                if(
                    teamGame
                    && GetPlayerInfo(cpn, PLAYERINFO_TEAM) != GetPlayerInfo(pln, PLAYERINFO_TEAM)
                    && PlayerIsSpectator(cpn) != 1
                ) {
                    if(!should_reveal)
                        continue;
                    else
                        revealed = true;
                }

                if(!teamgame && !cooperative && cpn != pln && PlayerIsSpectator(cpn) != 1) {
                    if(!should_reveal)
                        continue;
                    else
                        revealed = true;
                }

            }

            int velx = GetActorVelX(0);
            int vely = GetActorVelY(0);
            int player_angle = GetActorAngle(0);

            int u = UniqueTID();

            // Player Marker
            if(revealed) {
                SpawnForced("PlayerPawn_Revealed_MapMarker", GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
            } else {
                if (ACS_NamedExecuteWithResult("uh_IsUnholyTeamMode")) {
                    str uhmarker = ACS_NamedExecuteWithResult("uh_AM_PlayerMarker", pln);
                    SpawnForced(uhmarker, GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
                } else {
                    if(!SpawnForced(StrParam(s:GetActorClass(0), s:"_MapMarker"), GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0)))
                        SpawnForced("PlayerPawn_MapMarker", GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
                }

                ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", u, AAPTR_TARGET);

                Thing_SetTranslation(u, -1);
            }
            SetActorVelocity(u, velx, vely, 0.0, false, false);
            Thing_ChangeTID(u, 0);

            // Objective Marker
            if(StrICmp("", objective_item) != 0) {
                SpawnForced(objective_item, GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
                SetActorVelocity(u, velx, vely, 0.0, false, false);
                Thing_ChangeTID(u, 0);
            }

            // Revealed players shouldn't get their angle exposed
            if(revealed)
                continue;

            // Directional Marker
            int arrow_angle = (player_angle - angle + 1.0) % 1.0;
            str graphic = StrParam(s:"ArrowMapMarker", i:((FixedDiv((arrow_angle + 0.0625), 0.125) >> 16) % 8));
            SpawnForced(graphic, GetActorX(0) + FixedMul(cos(player_angle), ARROW_DIST) - velx, GetActorY(0) + FixedMul(sin(player_angle), ARROW_DIST) - vely, GetActorZ(0), u, 0);
            SetActorVelocity(u, velx, vely, 0.0, false, false);
            Thing_ChangeTID(u, 0);
        }

        SetActivator(0, AAPTR_NULL);

        Delay(1);
    }
}

script "core_automap_player_death" DEATH CLIENTSIDE
{
    int cooperative = GetCvar("cooperative");
    int teamGame = ACS_NamedExecuteWithResult("core_checkmode", 1) && !cooperative;
    int cpn = ConsolePlayerNumber();
    int pln = PlayerNumber();

    if(!GetUserCvar(cpn, "mm8bdm_automap_players") || GetCvar("sv_noautomapallies"))
        terminate;

    if (ACS_NamedExecuteWithResult("uh_IsUnholyTeamMode")) {
        if (!ACS_NamedExecuteWithResult("uh_AM_CanSee", cpn, pln))
            terminate;
    } else {
        if(
            teamGame
            && GetPlayerInfo(cpn, PLAYERINFO_TEAM) != GetPlayerInfo(pln, PLAYERINFO_TEAM)
            && PlayerIsSpectator(cpn) != 1
        ) {
            terminate;
        }

        if(!teamgame && !cooperative && cpn != pln && PlayerIsSpectator(cpn) != 1)
            terminate;

    }

    int u = UniqueTID();
    if(!SpawnForced(StrParam(s:GetActorClass(0), s:"_Death_MapMarker"), GetActorX(0), GetActorY(0), GetActorZ(0), u, GetActorAngle(0)))
        SpawnForced("PlayerPawn_Death_MapMarker", GetActorX(0), GetActorY(0), GetActorZ(0), u, GetActorAngle(0));

    ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", u, AAPTR_TARGET);

    Thing_SetTranslation(u, -1);
    Thing_ChangeTID(u, 0);
}

script "core_automap_weapon" (void)
{
    ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_weapon_c");
}

script "core_automap_giftbox" (void)
{
    ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_giftbox_c");
}

script "core_automap_item" (void)
{
    if(CheckForVar("user_RemoveAsBusterUpgrade")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_busters_c");
    } else if(CheckForVar("user_RemoveAsAssistItem")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_assists_c");
    } else if(CheckForVar("user_RemoveAsSmallHealth")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_small_health_c");
    } else if(CheckForVar("user_RemoveAsSmallAmmo")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_small_ammo_c");
    } else if(CheckForVar("user_RemoveAsSmallArmor")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_small_armor_c");
    } else if(CheckForVar("user_RemoveAsAmmo")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_ammo_c");
    } else if(CheckForVar("user_RemoveAsHealth")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_health_c");
    } else if(CheckForVar("user_RemoveAsArmor")) {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_armor_c");
    } else {
        ACS_NamedExecuteWithResult("core_automap_pickup", "core_automap_misc_c");
    }
}

function bool CheckForVar(str theVar) {
	return CheckForActorVar(0, theVar);
}

function bool CheckForActorVar(int tid, str theVar) {
	SetUserVariable(tid,theVar,1);
	return (GetUserVariable(tid,theVar)==1);
}

script "core_automap_pickup" (int scriptName)
{
    if(CheckInventory("AutomapScriptRunning"))
        terminate;

    GiveInventory("AutomapScriptRunning", 1);

    int start = Timer();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if((Timer() - start) % 35 == 0)
            ACS_NamedExecuteWithResult(scriptName);
        Delay(1);
    }
}


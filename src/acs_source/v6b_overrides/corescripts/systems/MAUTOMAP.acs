script "core_automap_giftbox_c" (void) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    str fallback = "BaseMM8BDMUseItem_MapMarker";
    str cvar = "mm8bdm_automap_assists";
    int value = 1;

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {
            Delay(1);
            continue;

        }

        if(GetUserCvar(cpn, cvar) < value) {
            Delay(1);
            continue;

        }

        if(!GetCvar("mm8bdm_sv_automap_pickups")) {
            Delay(1);
            continue;

        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_pickups")) {
            Delay(1);
            continue;

        }

        int velx = GetActorVelX(0);
        int vely = GetActorVelY(0);

        int u = UniqueTID();
        if(!SpawnForced(StrParam(s:GetActorClass(0), s:"_MapMarker"), GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0))) {
            if(StrICmp("", fallback) != 0)
                SpawnForced(fallback, GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
        }
        SetActorVelocity(u, velx, vely, 0.0, false, false);

        Thing_SetTranslation(u, -1);
        Thing_ChangeTID(u, 0);

        Delay(1);
    }
}

script "core_automap_pickup_c" (int fallback, int cvar, int value) CLIENTSIDE
{
    if(CheckInventory("AutomapScriptRunning_Client"))
        terminate;

    GiveInventory("AutomapScriptRunning_Client", 1);

    int cpn = ConsolePlayerNumber();
    while(!(ClassifyActor(0) & ACTOR_WORLD) && !CheckFlag(0, "NOBLOCKMAP")) {
        if(CheckAutomap() == AUTOMAP_OFF) {
            Delay(1);
            continue;
        }

        if(GetUserCvar(cpn, cvar) < value) {
            Delay(1);
            continue;
        }

        if(!GetCvar("mm8bdm_sv_automap_pickups")) {
            Delay(1);
            continue;
        }

        if(!GetUserCvar(cpn, "mm8bdm_automap_pickups")) {
            Delay(1);
            continue;
        }

        if(CheckFlag(0, "DROPPED")) {
            if(!GetCvar("mm8bdm_sv_automap_dropped_pickups")) {
                Delay(1);
                continue;
            }
        }

        if(!CheckFlag(0, "SPECIAL")) {
            // ALWAYSRESPAWN and NEVERRESPAWN are the wrong flags to check here, but they're clientside synced
            // unlike the correct ones. This gives us a means to set these flags and have them disappear from automap.
            if(!CheckFlag(0, "INVENTORY.ALWAYSRESPAWN") && !CheckFlag(0, "ALWAYSRESPAWN")) {
                if(!GetCvar("sv_itemrespawn") || CheckFlag(0, "INVENTORY.NEVERRESPAWN") || CheckFlag(0, "NEVERRESPAWN")) {
                    break;
                }
            }
        }

        int velx = GetActorVelX(0);
        int vely = GetActorVelY(0);

        int u = UniqueTID();
        if(!SpawnForced(StrParam(s:GetActorClass(0), s:"_MapMarker"), GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0))) {
            if(StrICmp("", fallback) != 0)
                SpawnForced(fallback, GetActorX(0) - velx, GetActorY(0) - vely, GetActorZ(0), u, GetActorAngle(0));
        }
        SetActorVelocity(u, velx, vely, 0.0, false, false);

        Thing_SetTranslation(u, -1);
        Thing_ChangeTID(u, 0);

        Delay(1);
    }
}


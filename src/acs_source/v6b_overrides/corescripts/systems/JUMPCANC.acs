// v6c hook dispatcher with UH gravity orientation and bot policy.
#library "jumpcanc"
#include "zcommon.acs"
#include "8BDMLIB.acs"

#import "8BDT.acs"

// [Mike]/[Mess]/[Trill] Jump Canceling script.
//
script "core_jumpcancel" ENTER
{
	int pln = PlayerNumber();

	if (PlayerIsBot(pln)) { terminate; } // Preserve UH bot movement ownership.

	int lastVelZ;
	int InputButtons;
	int InputOldButtons;
	while(GetActorProperty(0, APROP_HEALTH) > 0 && PlayerInGame(pln)) {
		InputOldButtons = InputButtons;
		InputButtons = GetPlayerInput(-1, INPUT_BUTTONS);

		bool rising = false;
		bool falling = false;
		bool grounded = false;

		int velZ = GetActorVelZ(0);
		bool inverted = CheckInventory("CeilingFlag") || GetActorProperty(0, APROP_Gravity) < 0;
		// The engine landing sound is floor-only; ceiling contact owns it when flipped.
		if (inverted && GetActorZ(0) == GetActorFloorZ(0) && lastVelZ < 0)
		    StopSound(0, CHAN_AUTO);
		int orientedVelZ = velZ;
		if (inverted) orientedVelZ = -orientedVelZ;
		if(orientedVelZ < 0) {
			//Log(s:"You're falling!");
			falling = true;
		} else if(orientedVelZ > 0) {
			//Log(s:"You're rising!");
			rising = true;
		}

		if(ACS_NamedExecuteWithResult("core_checkFooting")) {
			//Log(s:"You're grounded!");
			grounded = true;
		}

		for(int i = 0; i < HookFunctions_Max[HF_JUMP_NONSPECIFIC]; i++) {
			ACS_NamedExecuteWithResult(GetHookFunction(HF_JUMP_NONSPECIFIC, i), grounded, falling, rising);
		}

		switch(JumpStatus(InputButtons, InputOldButtons)) {
			Case 1: // [Mess] You pressed Jump
				bool usedJump = false;
				for(i = 0; i < HookFunctions_Max[HF_JUMP_PRESSED]; i++) {
					if(ACS_NamedExecuteWithResult(GetHookFunction(HF_JUMP_PRESSED, i), usedJump, grounded, falling, rising))
						usedJump = true;
				}
				break;
			Case 3: // Holding jump
				usedJump = false;
				for(i = 0; i < HookFunctions_Max[HF_JUMP_HELD]; i++) {
					if(ACS_NamedExecuteWithResult(GetHookFunction(HF_JUMP_HELD, i), usedJump, grounded, falling, rising))
						usedJump = true;
				}
				break;
			Case 2: // You Released Jump
				for(i = 0; i < HookFunctions_Max[HF_JUMP_RELEASED]; i++) {
					ACS_NamedExecuteWithResult(GetHookFunction(HF_JUMP_RELEASED, i), grounded, falling, rising);
				}
				break;
			Case 0: // Not holding Jump
				for(i = 0; i < HookFunctions_Max[HF_JUMP_IDLE]; i++) {
					ACS_NamedExecuteWithResult(GetHookFunction(HF_JUMP_IDLE, i), grounded, falling, rising);
				}
				break;
		}

		lastVelZ = velZ;
		Delay(1);
	}
}

script "core_jumpcancel_respawn" RESPAWN
{
	ACS_NamedExecuteWithResult("core_jumpcancel");
}

// Which weapon is the player currently using.
function int WhichWeapon(void)
{
	for(int i = 0; i < MAX_WEAPONS_GLOBAL; i++)
	{
		if(CheckWeapon(getWeaponActor(i)))
			return i;
	}

	return -1;
}

script "core_getweaponammo" (void)
{
	int ThisWeapon = WhichWeapon();
	if(ThisWeapon >= 0 && StrLen(getWeaponAmmoType(ThisWeapon)) != 0)
		SetResultValue(CheckInventory(getWeaponAmmoType(ThisWeapon)));
	else
		SetResultValue(0);
}

script "core_getweaponammocapacity" (void)
{
	int ThisWeapon = WhichWeapon();
	if(ThisWeapon >= 0 && StrLen(getWeaponAmmoType(ThisWeapon)) != 0)
		SetResultValue(GetAmmoCapacity(getWeaponAmmoType(ThisWeapon)));
	else
		SetResultValue(0);
}

script "core_getweaponammo2" (void)
{
	int ThisWeapon = WhichWeapon();
	if(ThisWeapon >= 0 && StrLen(getWeaponAmmo2Type(ThisWeapon)) != 0)
		SetResultValue(CheckInventory(getWeaponAmmo2Type(ThisWeapon)));
	else
		SetResultValue(0);
}

script "core_getweaponammo2capacity" (void)
{
	int ThisWeapon = WhichWeapon();
	if(ThisWeapon >= 0 && StrLen(getWeaponAmmo2Type(ThisWeapon)) != 0)
		SetResultValue(GetAmmoCapacity(getWeaponAmmo2Type(ThisWeapon)));

#library "PROJTRAN"
#include "zcommon.acs"

#include "8BDMDEFS.acs"
#include "8BDMVARS.acs"

// Class palette slots share the projectile tables built by TEAMCOL.
#define UH_PROJ_SLOT_NONE -1
#define UH_PROJ_SLOT_MEGAMAN_SHINY 6 // First of seven consecutive color slots.
#define UH_PROJ_SLOT_QWANT_SHINY 13
#define UH_PROJ_SLOT_NEGAMAN 14
#define UH_PROJ_SLOT_NEGAMAN_SHINY 15
#define UH_PROJ_SLOT_DECOYBOT 16
#define UH_PROJ_SLOT_DECOYBOT_SHINY 17

script "core_projtransgive" (void)
{
	int owner = ACS_NamedExecuteWithResult("core_gettarget", false, true);
	if(!CanTranslateProjectile(owner))
		terminate;

	// Select one palette: native team colors take priority over UH class colors.
	int paletteSlot = TeamProjectileSlot(owner);
	bool classPalette = paletteSlot < 0;
	if(classPalette)
		paletteSlot = ACS_NamedExecuteWithResult("uh_ProjectileClassSlot");
	if(paletteSlot < 0)
		terminate;

	bool whites = CheckForVar("user_TranslateWhiteColors");
	bool blacks = CheckForVar("user_TranslateBlackColors");
	int translation = ProjectileTranslationBase(classPalette, whites, blacks);
	ACS_NamedExecuteWithResult("core_Set_Projectile_Translation", paletteSlot, whites, blacks, translation);
}

function bool CanTranslateProjectile(int owner) {
	if(CheckForVar("user_NoTranslation") || owner < 0)
		return false;
	return !CheckActorInventory(owner + PLN_TID, "NoProjectileTeamTranslation");
}

function int TeamProjectileSlot(int owner) {
	if(!isTeamGame || isCooperative || !ProjTeamColorCvarServer())
		return UH_PROJ_SLOT_NONE;
	return GetPlayerInfo(owner, PLAYERINFO_TEAM);
}

function int ProjectileTranslationBase(bool classPalette, bool whites, bool blacks) {
	// v6c's player-like translation base applies only to native team colors.
	if(!classPalette && CheckForVar("user_translateLikePlayer")) {
		int translation = GetActorProperty(0, APROP_Mass);
		if(translation == 100)
			return TCLR_DEFAULT;
		return translation;
	}
	return WhitesBlacksOffset(whites, blacks);
}

function bool IsClassProjectileSlot(int paletteSlot) {
	return paletteSlot >= UH_PROJ_SLOT_MEGAMAN_SHINY
		&& paletteSlot <= UH_PROJ_SLOT_DECOYBOT_SHINY;
}

// Separate script keeps the caller's projectile activator intact.
script "uh_ProjectileClassSlot" (void)
{
	SetResultValue(UH_PROJ_SLOT_NONE);
	if(CheckForVar("user_NoClassTranslation"))
		terminate;
	if(!SetActivator(0, AAPTR_TARGET))
		terminate;

	int color = CheckInventory("MegaManSColor_F");
	if(color > 0) SetResultValue(UH_PROJ_SLOT_MEGAMAN_SHINY + color - 1);
	else if(CheckInventory("IsQwantSFlag")) SetResultValue(UH_PROJ_SLOT_QWANT_SHINY);
	else if(CheckInventory("IsNegaManSFlag")) SetResultValue(UH_PROJ_SLOT_NEGAMAN_SHINY);
	else if(CheckInventory("IsNegaManFlag")) SetResultValue(UH_PROJ_SLOT_NEGAMAN);
	else if(CheckInventory("IsDecoyBotSFlag")) SetResultValue(UH_PROJ_SLOT_DECOYBOT_SHINY);
	else if(CheckInventory("IsDecoyBotFlag")) SetResultValue(UH_PROJ_SLOT_DECOYBOT);
}

// This script is vestigial
script "core_projtransgiveclient" (void)
{
    GiveInventory("ProjTeamColor1Client", 1);
}

function bool ProjTeamColorCvar(void) {
	return (ProjTeamColorCvarServer()&&ProjTeamColorCvarClient());
}

function bool ProjTeamColorCvarClient(void) {
	return (GetUserCvar(ConsolePlayerNumber(),"mm8bdm_projteamcolor")>0);
}

function bool ProjTeamColorCvarServer(void) {
	return (GetCvar("mm8bdm_sv_projteamcolor")>0);
}

script "core_Set_Projectile_Translation" (int paletteSlot, int whites, int blacks, int translation) CLIENTSIDE
{
	// Keep the native four-argument interface; its slot identifies class palettes.
	// The client team-color toggle does not disable class palettes.
	if(ProjTeamColorCvarClient() || IsClassProjectileSlot(paletteSlot)) {
		if(translation == 0)
			translation = WhitesBlacksOffset(whites, blacks);

		Thing_SetTranslation(0, translation + paletteSlot);
	}
}

function int WhitesBlacksOffset(int whites, int blacks) {
	if(whites && blacks) return PCLR_TEAMPROJ_ALL;
	if(blacks) return PCLR_TEAMPROJ_BLACKS;
	if(whites) return PCLR_TEAMPROJ_WHITES;
	return PCLR_TEAMPROJ;
}

script "core_Check_TranslateWhiteColors" (void) {
	SetResultValue(CheckForVar("User_TranslateWhiteColors"));
}

script "core_Check_TranslateBlackColors" (void) {
	SetResultValue(CheckForVar("User_TranslateBlackColors"));
}

script "core_Check_NoTranslation" (void) {
	SetResultValue(CheckForVar("User_NoTranslation"));
}

script "core_Check_TranslateLikePlayer" (void) {
	SetResultValue(CheckForVar("User_TranslateLikePlayer"));
}

function bool CheckForVar(str theVar) {
	SetUserVariable(0,theVar,1);
	return (GetUserVariable(0,theVar)==1);
}

script "core_Check_ProjectileColor_Server" (void) {
	SetResultValue(ProjTeamColorCvarServer());
}
// UH class-palette opt-out; team slots remain available.
script "uh_Check_NoClassTranslation" (void) {
  SetResultValue(CheckForVar("user_NoClassTranslation"));
}

// Rail trail/puff CLIENTSIDEONLY FX often have null target, so class lookup
// cannot see IsDecoyBotFlag and falls through, leaving the StealthS translation.
// Force the Decoy class slot after spawnfunc on Decoy_F_23* actors.
script "uh_ForceDecoyRailProjColor" (void) CLIENTSIDE {
  int slot = UH_PROJ_SLOT_DECOYBOT;
  int cpn = ConsolePlayerNumber();
  if (cpn >= 0 && CheckActorInventory(PLN_TID + cpn, "IsDecoyBotSFlag"))
    slot = UH_PROJ_SLOT_DECOYBOT_SHINY;
  ACS_NamedExecuteWithResult("core_Set_Projectile_Translation", slot, 0, 0);
}

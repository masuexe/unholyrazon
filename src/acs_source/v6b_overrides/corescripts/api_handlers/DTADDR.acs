script "core_DefineReservedTID_S" (int tid, int tidMax) {
  if (tidMax < tid) {
    printbold(s:"Invalid tid range!!!");
    terminate;
  }
  DefineReservedTIDFunc(tid, tidMax);
}

function void DefineReservedTIDFunc(int tid, int tidMax) {
  if (MAX_TID < MAX_TID_LIMIT) {
    if (MAX_TID == 0) {
      TID_LOWEST = tid;
      TID_HIGHEST = tidMax;
    } else {
      if (tid < TID_LOWEST) {
        TID_LOWEST = tid;
      } else if (tidMax > TID_HIGHEST) {
        TID_HIGHEST = tidMax;
      }
    }
    setTIDRange(MAX_TID, tid, tidMax);
    MAX_TID++;
  } else {
    printbold(s:"Limit too low, increase the limit on tids");
  }
}

script "core_RegisterTrainingDef_S" (void) {
  int res = RegisterTrainingDefCore(
    GetCvarString("8bdm_training_def")
  );
  SetResultValue(res);
}

function int RegisterTrainingDefCore(str callee) {
  if (MAX_TRAIN_DEF < MAX_TRAIN_DEF_LIMIT) {
    SetTrainingDef(MAX_TRAIN_DEF, callee);
    MAX_TRAIN_DEF++;
    return MAX_TRAIN_DEF - 1;
  } else {
    printbold(s:"TRAINING def limit too low, increase the limit");
  }
  return -1;
}

script "core_DefineTrainingEntry_S" (void) {
  int res = DefineTrainingEntryCore(
    GetCvarString("8bdm_training_version"),
    GetCvar("8bdm_training_type"),
    GetCvarString("8bdm_training_tag"),
    GetCvarString("8bdm_training_desc"),
    GetCvarString("8bdm_training_icon"),
    GetCvarString("8bdm_training_actor"),
    GetCvar("8bdm_training_amount")
  );
  SetResultValue(res);
}

#define TRAINING_MEGABUSTER -1  // Appears first always
#define TRAINING_WEP 0          // Appears after Mega Buster
#define TRAINING_BUSTER 1       // Appears after weapons
#define TRAINING_ITEM 2         // Appears in its separate category

function int DefineTrainingEntryCore(str version, int type, str tag, str desc, str icon, str actor, int amount) {
  switch (type) {
    case TRAINING_MEGABUSTER:
      if (MAX_TRAIN_MB < MAX_TRAIN_MB_LIMIT) {
        setMBVersionUpdated(MAX_TRAIN_MB, version);
        setMBName(MAX_TRAIN_MB, tag);
        setMBDesc(MAX_TRAIN_MB, desc);
        setMBIcon(MAX_TRAIN_MB, icon);
        setMBActor(MAX_TRAIN_MB, actor);
        MAX_TRAIN_MB++;
        return MAX_TRAIN_MB - 1;
      } else {
        printbold(s:"TRAINING MB limit too low, increase the limit");
        return -1;
      }
    case TRAINING_WEP:
      if (MAX_TRAIN_WEP < MAX_TRAIN_WEP_LIMIT) {
        setWepVersionUpdated(MAX_TRAIN_WEP, version);
        setWepName(MAX_TRAIN_WEP, tag);
        setWepDesc(MAX_TRAIN_WEP, desc);
        setWepIcon(MAX_TRAIN_WEP, icon);
        setWepActor(MAX_TRAIN_WEP, actor);
        MAX_TRAIN_WEP++;
        return MAX_TRAIN_WEP - 1;
      } else {
        printbold(s:"TRAINING wep limit too low, increase the limit");
        return -1;
      }
    case TRAINING_BUSTER:
      if (MAX_TRAIN_BUST < MAX_TRAIN_BUST_LIMIT) {
        setBustVersionUpdated(MAX_TRAIN_BUST, version);
        setBustName(MAX_TRAIN_BUST, tag);
        setBustDesc(MAX_TRAIN_BUST, desc);
        setBustIcon(MAX_TRAIN_BUST, icon);
        setBustActor(MAX_TRAIN_BUST, actor);
        MAX_TRAIN_BUST++;
        return MAX_TRAIN_BUST - 1;
      } else {
        printbold(s:"TRAINING buster limit too low, increase the limit");
        return -1;
      }
    case TRAINING_ITEM:
      if (MAX_TRAIN_ITEM < MAX_TRAIN_ITEM_LIMIT) {
        setItemVersionUpdated(MAX_TRAIN_ITEM, version);
        setItemName(MAX_TRAIN_ITEM, tag);
        setItemDesc(MAX_TRAIN_ITEM, desc);
        setItemIcon(MAX_TRAIN_ITEM, icon);
        setItemActor(MAX_TRAIN_ITEM, actor);
        setItemAmount(MAX_TRAIN_ITEM, amount);
        MAX_TRAIN_ITEM++;
        return MAX_TRAIN_ITEM - 1;
      } else {
        printbold(s:"TRAINING item limit too low, increase the limit");
        return -1;
      }
    default:
      printbold(s:"Invalid training add type???");
      return -1;
  }
  return -1;
}

Script "core_DefineAssistItem_S" (void) {
  int res = newAssistItemCore(
    GetCvarString("8bdm_itemTag"),
    GetCvarString("8bdm_itemActor"),
    GetCvarString("8bdm_itemIcon"),
    GetCvar("8bdm_itemAmount"),
    GetCvar("8bdm_itemGroup"),
    GetCvar("8bdm_itemMap")
  );
  SetResultValue(res);
}

Script "core_RandomAssistItem_S" (int group, int mapValid) {
  setResultValue(randomAssistItemCore(group, mapValid));
}

function int newAssistItemCore(str itemName, str itemCode, str itemIcon, int itemAmount, int itemGroup, int itemMap) {
  if (MAX_ITEMS_GLOBAL < MAX_ITEMS_GLOBAL_LIMIT) {
    int idx = MAX_ITEMS_GLOBAL;
    setAssistItemTag(idx, itemName);
    setAssistItemActor(idx, itemCode);
    setAssistItemIcon(idx, itemIcon);
    setAssistItemAmount(idx, itemAmount);
    setAssistItemGroup(idx, itemGroup);
    setAssistItemMapValid(idx, itemMap);
    MAX_ITEMS_GLOBAL++;
    items_group_count[itemGroup]++;
    return idx;
  }
  printbold(s:"Limit too low, need more item slots");
  return -1;
}

function int randomAssistItemCore(int group, int mapValid) {
  int firstRoll;
  if (group == -1) {
    firstRoll = random(0, MAX_ITEMS_GLOBAL - 1);
  } else {
    firstRoll = random(0, items_group_count[group] - 1);
  }

  int counter = firstRoll;

  do {
    for (int i = 0; i < MAX_ITEMS_GLOBAL; i++) {
      if (compareTernary(group, getAssistItemGroup(i)) &&
          compareTernary(mapValid, isAssistItemMapValid(i))) {
        if (counter > 0)
          counter--;
        else
          return i;
      }
    }
  }
  while (counter != firstRoll && counter > -1);

  return -1;
}


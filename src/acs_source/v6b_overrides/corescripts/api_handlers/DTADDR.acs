#library "dtaddr"
#include "zcommon.acs"

#import "8BDT.acs"

#include "8BDMDEFS.acs"
#include "DTADD.acs"

function int getAndResetDTADDVersion(void) {
	int version = GetCvar("_8bdm_dtadd_version");
	if (version > 0) {
		setDTADDVersion(0);
	}
	return version;
}

script "core_init_client_data" (int callee) CLIENTSIDE
{
	if(!IsNetworkGame())
		terminate;

	ACS_NamedExecuteWithResult(callee);
}

Script "core_DefineWeapon_S" (void)
{
	if(MAX_WEAPONS_GLOBAL >= MAX_WEAPONS_GLOBAL_LIMIT) {
		SetResultValue(-1);
		terminate;
	}

	int version = getAndResetDTADDVersion();

	if(version == 0) {
		str wepName = GetCvarString("8bdm_wepTag");
		str wepCode = GetCvarString("8bdm_wepActor");
		str wepIcon = GetCvarString("8bdm_wepIcon");
		str wepAmmo = GetCvarString("8bdm_wepAmmo");
		int wepMult = GetCvar("8bdm_wepMult");
		str wepAmmo2 = GetCvarString("8bdm_wepAmmo2");
		int wepMult2 = GetCvar("8bdm_wepMult2");
		int wepSlot = GetCvar("8bdm_wepSlot");
		bool wepMap = GetCvar("8bdm_wepMap");
		bool wepLMS = GetCvar("8bdm_wepLms");
		bool wepEddie =	GetCvar("8bdm_wepEddie");
	} else {
		wepName = GetCvarString("_8bdm_wepTag");
		wepCode = GetCvarString("_8bdm_wepActor");
		wepIcon = GetCvarString("_8bdm_wepIcon");
		wepAmmo = GetCvarString("_8bdm_wepAmmo");
		wepMult = GetCvar("_8bdm_wepMult");
		wepAmmo2 = GetCvarString("_8bdm_wepAmmo2");
		wepMult2 = GetCvar("_8bdm_wepMult2");
		wepSlot = GetCvar("_8bdm_wepSlot");
		wepMap = GetCvar("_8bdm_wepMap");
		wepLMS = GetCvar("_8bdm_wepLms");
		wepEddie =	GetCvar("_8bdm_wepEddie");
	}

	bool banned = ACS_NamedExecuteWithResult("core_checkPickupServerBanned", wepCode);

	setWeaponTag(MAX_WEAPONS_GLOBAL, wepName);
	setWeaponActor(MAX_WEAPONS_GLOBAL, wepCode);
	setWeaponIcon(MAX_WEAPONS_GLOBAL, wepIcon);
	setWeaponAmmoType(MAX_WEAPONS_GLOBAL, wepAmmo);
	setWeaponAmmoFactor(MAX_WEAPONS_GLOBAL, wepMult);
	setWeaponAmmo2Type(MAX_WEAPONS_GLOBAL, wepAmmo2);
	setWeaponAmmo2Factor(MAX_WEAPONS_GLOBAL, wepMult2);
	setWeaponSlot(MAX_WEAPONS_GLOBAL, wepSlot);
	setWeaponMapValid(MAX_WEAPONS_GLOBAL, wepMap && !banned);
	setWeaponLMSValid(MAX_WEAPONS_GLOBAL, wepLms && !banned);
	setWeaponEddieValid(MAX_WEAPONS_GLOBAL, wepEddie && !banned);

	weapons_slot_count[wepSlot]++;

	SetResultValue(MAX_WEAPONS_GLOBAL++);
}

script "core_CreatePlayerTranslation_S" (int id, int cyan, int blue)
{
	if(DTADD_IsRGB(cyan) && DTADD_IsRGB(blue)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]
		);
	} else if (DTADD_IsRGB(cyan)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=blue:blue
		);
	} else if (DTADD_IsRGB(blue)) {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]
		);
	} else {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=blue:blue
		);
	}
	SetResultValue(DTADDR_defineTranslation(id));
}

script "core_CreatePlayerTranslationGlow_S" (int id, int cyan, int blue, int black)
{
	if(DTADD_IsRGB(cyan) && DTADD_IsRGB(blue) && DTADD_IsRGB(black)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)],
			0:2=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			5:8=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			243:247=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]
		);
	} else if (DTADD_IsRGB(cyan) && DTADD_IsRGB(blue)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)],
			0:2=black:black,
			5:8=black:black,
			243:247=black:black
		);
	} else if (DTADD_IsRGB(blue) && DTADD_IsRGB(black)) {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)],
			0:2=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			5:8=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			243:247=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]
		);
	} else if (DTADD_IsRGB(cyan) && DTADD_IsRGB(black)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=blue:blue,
			0:2=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			5:8=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			243:247=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]
		);
	} else if (DTADD_IsRGB(cyan)) {
		CreateTranslation(id,
			192:192=[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)]:[DTADD_UnpackByte1(cyan), DTADD_UnpackByte2(cyan), DTADD_UnpackByte3(cyan)],
			198:198=blue:blue,
			0:2=black:black,
			5:8=black:black,
			243:247=black:black
		);
	} else if (DTADD_IsRGB(blue)) {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)]:[DTADD_UnpackByte1(blue), DTADD_UnpackByte2(blue), DTADD_UnpackByte3(blue)],
			0:2=black:black,
			5:8=black:black,
			243:247=black:black
		);
	} else if (DTADD_IsRGB(black)) {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=blue:blue,
			0:2=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			5:8=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)],
			243:247=[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]:[DTADD_UnpackByte1(black), DTADD_UnpackByte2(black), DTADD_UnpackByte3(black)]
		);
	} else {
		CreateTranslation(id,
			192:192=cyan:cyan,
			198:198=blue:blue,
			0:2=black:black,
			5:8=black:black,
			243:247=black:black
		);
	}
	SetResultValue(DTADDR_defineTranslation(id));
}

Script "core_DefineTranslation_S" (int id) CLIENTSIDE
{
	SetResultValue(DTADDR_defineTranslation(id));
}

function int DTADDR_defineTranslation(int id)
{
	int version = getAndResetDTADDVersion();

	if(version == 0)
		id = GetCvar("8bdmtranslation_id");

	int ret = id;

	if(MAX_TRANS >= MAX_TRANS_LIMIT) {
		//team translations get added multiple times, but this is debug array anyway
		//still can't printbold here tho
		//printbold(s:"Limit too low, need more translation slots");
		return ret;
	}

	if(MAX_TRANS == 0) {
		TRANS_LOWEST = id;
		TRANS_HIGHEST = id;
	} else {
		if(id < TRANS_LOWEST) {
			TRANS_LOWEST = id;
		} else if (id > TRANS_HIGHEST) {
			TRANS_HIGHEST = id;
		}
	}

	setTransId(MAX_TRANS, id);

	MAX_TRANS++;

	return ret;
}

Script "core_DefineBusterUpgrade_S" (void)
{
	if(MAX_BUSTERUPGRADES >= MAX_BUSTER_LIMIT) {
		printbold(s:"Limit too low, need more buster upgrade slots");
		SetResultValue(-1);
		terminate;
	}

	int version = getAndResetDTADDVersion();

	if(version == 0) {
		str busterTag = GetCvarString("8bdm_busterTag");
		str busterActor = GetCvarString("8bdm_busterActor");
		str busterUpgradeTag = GetCvarString("8bdm_busterUpgradeTag");
		str busterUpgrade = GetCvarString("8bdm_busterUpgrade");
		str busterIcon = GetCvarString("8bdm_busterIcon");
		bool busterMapValid = GetCvar("8bdm_busterMapValid");
		bool busterLMSValid = GetCvar("8bdm_busterLMSValid");
		bool busterEddieValid = GetCvar("8bdm_busterEddieValid");
	} else {
		busterTag = GetCvarString("_8bdm_busterTag");
		busterActor = GetCvarString("_8bdm_busterActor");
		busterUpgradeTag = GetCvarString("_8bdm_busterUpgradeTag");
		busterUpgrade = GetCvarString("_8bdm_busterUpgrade");
		busterIcon = GetCvarString("_8bdm_busterIcon");
		busterMapValid = GetCvar("_8bdm_busterMapValid");
		busterLMSValid = GetCvar("_8bdm_busterLMSValid");
		busterEddieValid = GetCvar("_8bdm_busterEddieValid");
	}

	bool banned = ACS_NamedExecuteWithResult("core_checkPickupServerBanned", busterUpgrade);

	setBusterTag(MAX_BUSTERUPGRADES, busterTag);
	setBusterActor(MAX_BUSTERUPGRADES, busterActor);
	setBusterUpgradeTag(MAX_BUSTERUPGRADES, busterUpgradeTag);
	setBusterUpgrade(MAX_BUSTERUPGRADES, busterUpgrade);
	setBusterIcon(MAX_BUSTERUPGRADES, busterIcon);
	setBusterMapValid(MAX_BUSTERUPGRADES, busterMapValid && !banned);
	setBusterLMSValid(MAX_BUSTERUPGRADES, busterLMSValid && !banned);
	setBusterEddieValid(MAX_BUSTERUPGRADES, busterEddieValid && !banned);

	SetResultValue(MAX_BUSTERUPGRADES++);
}


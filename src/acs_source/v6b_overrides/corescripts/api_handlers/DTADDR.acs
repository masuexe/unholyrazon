script "core_DefinePowerAprop_S" (void) {
  int res = DefinePowerApropCore(
    GetCvarString("8bdmpoweraprop_giver"),
    GetCvarString("8bdmpoweraprop_powerUp"),
    GetCvar("8bdmpoweraprop_property"),
    GetCvar("8bdmpoweraprop_factor"),
    GetCvar("8bdmpoweraprop_permanent")
  );
  SetResultValue(res);
}

function int DefinePowerApropCore(str giver, str powerUp, int property, int factor, int permanent) {
  // Log(s:"DEFINING NEW POWERUP: ", s:giver);
  int pid = getPropertyIndex(property);
  if (pid != -1) {
    if (MAX_POWER_PROPERTY < MAX_POWER_PROPERTY_LIMIT) {
      int idx = MAX_POWER_PROPERTY++;
      setPowerApropGiver(idx, giver);
      setPowerApropPowerUp(idx, powerUp);
      setPowerApropProperty(idx, property);
      setPowerApropFactor(idx, factor);
      setPowerApropPermanent(idx, permanent);
      return idx;
    } else {
      printbold(s:"Error in defining property mapping for \"\cg", s:powerUp, s:"\c-\": Too many initializers.");
      return -1;
    }
  } else {
    printbold(s:"Error in defining property mapping for \"\cg", s:powerUp, s:"\c-\": Unsupported Actor Property.");
    return -1;
  }
  return -1;
}

script "core_DefineSpawnFunc_S" (void) {
  int res = DefineSpawnFuncCore(
    GetCvar("8bdmspawnfunc_type"),
    GetCvarString("8bdmspawnfunc_name")
  );
  SetResultValue(res);
}

function int DefineSpawnFuncCore(int type, int name) {
  if (SpawnFuncs_Max[type] < MAX_SPAWNFUNC_LIMIT) {
    int idx = SpawnFuncs_Max[type];
    setSpawnFunc(type, idx, name);
    SpawnFuncs_Max[type]++;
    return idx;
  } else {
    printbold(s:"Limit too low, increase the limit on SpawnFuncs");
  }
  return -1;
}


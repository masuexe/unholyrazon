// v6b DTADDR, recompiled so MAX_ITEMS_GLOBAL_LIMIT comes from Unholy 8BDT.
// Output lump must be DTADDR.o to shadow v6b acs/DTADDR.o. Do not add to LOADACS.
#library "DTADDR"
#include "zcommon.acs"

#import "8BDT.acs"

#include "MEGAPAL.acs"

function int newWeaponCore(str wepName, str wepCode, str wepIcon, str wepAmmo, int wepMult, str wepAmmo2, int wepMult2, int wepSlot, int wepMap, int wepLms, int wepEddie) {
  if (MAX_WEAPONS_GLOBAL < MAX_WEAPONS_GLOBAL_LIMIT) {
    int idx = MAX_WEAPONS_GLOBAL;
    setWeaponTag(idx, wepName);
    setWeaponActor(idx, wepCode);
    setWeaponIcon(idx, wepIcon);
    setWeaponAmmoType(idx, wepAmmo);
    setWeaponAmmoFactor(idx, wepMult);
    setWeaponAmmo2Type(idx, wepAmmo2);
    setWeaponAmmo2Factor(idx, wepMult2);
    setWeaponSlot(idx, wepSlot);
    setWeaponMapValid(idx, wepMap);
    setWeaponLMSValid(idx, wepLms);
    setWeaponEddieValid(idx, wepEddie);
    MAX_WEAPONS_GLOBAL++;
    weapons_slot_count[wepSlot]++;
    return idx;
  }
  printbold(s:"Limit too low, need more ammo slots");
  return -1;
}

function int randomWeaponCore(int slot, int mapValid, int LMSValid, int eddieValid) {
  int firstRoll;
  if (slot == -1) {
    firstRoll = random(0, MAX_WEAPONS_GLOBAL - 1);
  } else {
    firstRoll = random(0, weapons_slot_count[slot] - 1);
  }

  int counter = firstRoll;

  do {
    for (int i = 0; i < MAX_WEAPONS_GLOBAL; i++) {
      if (compareTernary(slot, getWeaponSlot(i)) &&
          compareTernary(mapValid, isWeaponMapValid(i)) &&
          compareTernary(LMSValid, isWeaponLMSValid(i)) &&
          compareTernary(eddieValid, isWeaponEddieValid(i))) {
        if (counter > 0)
          counter--;
        else
          return i;
      }
    }
  }
  while (counter != firstRoll && counter > -1);

  return -1;
}

function bool compareTernary(int x, int y) {
  if (x == -1)
    return true;
  return x == y;
}

function str BoolIsYesOrNo(bool val) {
  if (val) return "YES";
  return "NO";
}

Script "core_DefineWeapon_S" (void) {
  int res = newWeaponCore(
    GetCvarString("8bdm_wepTag"),
    GetCvarString("8bdm_wepActor"),
    GetCvarString("8bdm_wepIcon"),
    GetCvarString("8bdm_wepAmmo"),
    GetCvar("8bdm_wepMult"),
    GetCvarString("8bdm_wepAmmo2"),
    GetCvar("8bdm_wepMult2"),
    GetCvar("8bdm_wepSlot"),
    GetCvar("8bdm_wepMap"),
    GetCvar("8bdm_wepLms"),
    GetCvar("8bdm_wepEddie")
  );
  SetResultValue(res);
}

Script "core_RandomWeapon_S" (int slot, int mapValid, int LMSValid, int eddieValid) {
  setResultValue(randomWeaponCore(slot, mapValid, LMSValid, eddieValid));
}

Script "core_DefineTranslation_S" (void) CLIENTSIDE {
  SetResultValue(DefineTransFunc(GetCvar("8bdmtranslation_id")));
}

function int DefineTransFunc(int id) {
  if (MAX_TRANS < MAX_TRANS_LIMIT) {
    if (MAX_TRANS == 0) {
      TRANS_LOWEST = id;
      TRANS_HIGHEST = id;
    } else {
      if (id < TRANS_LOWEST) {
        TRANS_LOWEST = id;
      } else if (id > TRANS_HIGHEST) {
        TRANS_HIGHEST = id;
      }
    }
    setTransId(MAX_TRANS, id);
    MAX_TRANS++;
  } else {
    // team translations get added multiple times, but this is debug array anyway
    // still can't printbold here tho
    // printbold(s:"Limit too low, need more translation slots");
  }
  return id;
}

Script "core_DefineAssistDisplay_S" (void) CLIENTSIDE {
  DefineAssistDisplayFunc(GetCvarString("8bdmassistdisplay_name"));
}

function void DefineAssistDisplayFunc(str name) {
  if (MAX_ASSISTD < MAX_ASSISTD_LIMIT) {
    assist_displays[MAX_ASSISTD] = name;
    MAX_ASSISTD++;
  } else {
    printbold(s:"Limit too low, need more bar assist display slots");
  }
}

Script "core_DefineBusterUpgrade_S" (void) {
  SetResultValue(DefineBusterUpgradeFunc(GetCvarString("8bdm_busterTag"), GetCvarString("8bdm_busterActor"), GetCvarString("8bdm_busterUpgradeTag"), GetCvarString("8bdm_busterUpgrade"), GetCvarString("8bdm_busterIcon"), GetCvar("8bdm_busterMapValid"), GetCvar("8bdm_busterLMSValid"), GetCvar("8bdm_busterEddieValid")));
}

function int DefineBusterUpgradeFunc(str busterTag, str busterActor, str busterUpgradeTag, str busterUpgrade, str busterIcon, bool busterMapValid, bool busterLMSValid, bool busterEddieValid) {
  if (MAX_BUSTERUPGRADES < MAX_BUSTER_LIMIT) {
    int idx = MAX_BUSTERUPGRADES;
    setBusterTag(idx, busterTag);
    setBusterActor(idx, busterActor);
    setBusterUpgradeTag(idx, busterUpgradeTag);
    setBusterUpgrade(idx, busterUpgrade);
    setBusterIcon(idx, busterIcon);
    setBusterMapValid(idx, busterMapValid);
    setBusterLMSValid(idx, busterLMSValid);
    setBusterEddieValid(idx, busterEddieValid);
    MAX_BUSTERUPGRADES++;
    return idx;
  } else {
    printbold(s:"Limit too low, need more buster upgrade slots");
  }
  return -1;
}

Script "core_RandomBusterUpgrade_S" (int mapValid, int LMSValid, int eddieValid) {
  setResultValue(randomBusterUpgradeCore(mapValid, LMSValid, eddieValid));
}

function int randomBusterUpgradeCore(int mapValid, int LMSValid, int eddieValid) {
  int firstRoll = random(0, MAX_BUSTERUPGRADES - 1);
  int counter = firstRoll;

  do {
    for (int i = 0; i < MAX_BUSTERUPGRADES; i++) {
      if (compareTernary(mapValid, isBusterMapValid(i)) &&
          compareTernary(LMSValid, isBusterLMSValid(i)) &&
          compareTernary(eddieValid, isBusterEddieValid(i))) {
        if (counter > 0)
          counter--;
        else
          return i;
      }
    }
  }
  while (counter != firstRoll && counter > -1);

  return -1;
}


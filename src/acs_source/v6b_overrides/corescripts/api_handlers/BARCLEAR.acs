#library "BARCLEAR"
#include "zcommon.acs"
#import "uh_acsutils.acs"

#include "BARLIB.acs"

// Public clear-callback registry.  Registration returns a stable row index;
// duplicate names return the existing row.  Negative results are invalid name
// (-1), capacity exhausted (-2), or a missing named script (-3).  The registry
// is client-local because HUD bar state and the OPEN registration are clientside.
#define UH_BAR_CLEAR_MAX 32
#define UH_BAR_CLEAR_INVALID -1
#define UH_BAR_CLEAR_FULL -2
#define UH_BAR_CLEAR_MISSING -3

int uh_bar_clear_count = 0;
str uh_bar_clear_callback[UH_BAR_CLEAR_MAX];

script "core_DrawBar_RegisterClear" (int callback) CLIENTSIDE {
  str callback_name = callback;
  int i;
  if (StrLen(callback_name) == 0) {
    SetResultValue(UH_BAR_CLEAR_INVALID);
    terminate;
  }
  if (!CheckScript(callback_name, true)) {
    SetResultValue(UH_BAR_CLEAR_MISSING);
    terminate;
  }
  for (i = 0; i < uh_bar_clear_count; i++) {
    if (StrICmp(uh_bar_clear_callback[i], callback_name) == 0) {
      SetResultValue(i);
      terminate;
    }
  }
  if (uh_bar_clear_count >= UH_BAR_CLEAR_MAX) {
    SetResultValue(UH_BAR_CLEAR_FULL);
    terminate;
  }
  uh_bar_clear_callback[uh_bar_clear_count] = callback_name;
  SetResultValue(uh_bar_clear_count);
  uh_bar_clear_count++;
}

function void DispatchBarClearCallbacks(int cam) {
  int i;
  for (i = 0; i < uh_bar_clear_count; i++) {
    ACS_NamedExecuteWithResult(uh_bar_clear_callback[i], cam);
  }
}

script "core_DrawBar_Clear" (int cam) CLIENTSIDE {
  ClearBarFlags(cam);
  DispatchBarClearCallbacks(cam);
}

#define MAX_CUSTOM_BARS 1000
#define MAX_BAR_TYPES 3

int custBarCleanup[MAX_BAR_TYPES][MAX_CUSTOM_BARS];
int custBarCleanupCount[MAX_BAR_TYPES];
int custBarCleanupList[MAX_BAR_TYPES][MAX_CUSTOM_BARS];

str custBarNames[MAX_BAR_TYPES][2] = {
    {"CustSbarSlotFlag", "CustSbarSlotAmmo"},
    {"CustVSbarSlotFlag", "CustVSbarSlotAmmo"},
    {"CustHSbarSlotFlag", "CustHSbarSlotAmmo"}
};

script "core_raisecleanupflags" (int mode, int slot) {
	if (mode < 0 || mode >= MAX_BAR_TYPES || slot < 0 || slot >= MAX_CUSTOM_BARS)
        terminate;
	if(custBarCleanup[mode][slot])
		terminate;

	int idx = custBarCleanupCount[mode]++;
	custBarCleanupList[mode][idx] = slot;
	custBarCleanup[mode][slot] = true;
}


function void ClearBarFlags(int cam) {
  // Mugshot flags
  SetActorInventory(cam, "MugshotTransFlag", 0);
  SetActorInventory(cam, "SBARMugshotCyan", 0);
  SetActorInventory(cam, "SBARMugshotBlue", 0);
  SetActorInventory(cam, "SBARMugshotBlack", 0);

  // Normal bar flags
  SetActorInventory(cam, "SBARDrawBar1", 0);
  SetActorInventory(cam, "SBARDrawBar2", 0);
  SetActorInventory(cam, "SBARDrawBar3", 0);
  SetActorInventory(cam, "SBARUseAmmo1Disp", 0);
  SetActorInventory(cam, "SBARUseAmmo2Disp", 0);
  SetActorInventory(cam, "BarTransFlag", 0);
  SetActorInventory(cam, "SBARCyan", 0);
  SetActorInventory(cam, "SBARBlue", 0);
  SetActorInventory(cam, "SBARBlack", 0);
  SetActorInventory(cam, "BarTransFlag2", 0);
  SetActorInventory(cam, "SBARCyan2", 0);
  SetActorInventory(cam, "SBARBlue2", 0);
  SetActorInventory(cam, "SBARBlack2", 0);
  SetActorInventory(cam, "BarTransFlag3", 0);
  SetActorInventory(cam, "SBARCyan3", 0);
  SetActorInventory(cam, "SBARBlue3", 0);
  SetActorInventory(cam, "SBARBlack3", 0);

  // Ammo number flags
  SetActorInventory(cam, "SBARDrawAmmo1", 0);
  SetActorInventory(cam, "SBARDrawAmmo2", 0);
  SetActorInventory(cam, "SBARDrawAmmo3", 0);
  SetActorInventory(cam, "SBARAmmoOffset", 0);

  // Bar FX flags
  SetActorInventory(cam, "SBARDarken", 0);
  SetActorInventory(cam, "SBARFlash", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmo", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmoR", 0);
  SetActorInventory(cam, "SBARDarken2", 0);
  SetActorInventory(cam, "SBARFlash2", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmo2", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmoR2", 0);
  SetActorInventory(cam, "SBARDarken3", 0);
  SetActorInventory(cam, "SBARFlash3", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmo3", 0);
  SetActorInventory(cam, "SBARFlashOverlayAmmoR3", 0);
  SetActorInventory(cam, "HBARDarken", 0);
  SetActorInventory(cam, "HBARFlash", 0);
  SetActorInventory(cam, "HBARFlashOverlayAmmo", 0);
  SetActorInventory(cam, "HBARFlashOverlayAmmoR", 0);

  for (int i = 0; i < 256; i++) {
    SetActorInventory(cam, StrParam(s:"CustSbarSlotFlag", i:i), 0);
  }

  // v6c sparse cleanup covers all 1000 slots in all three bar families.
  // Keep the legacy 256-slot sweep above for already-compiled v6b addons.
  for (int mode = 0; mode < MAX_BAR_TYPES; mode++) {
    for (int idx = 0; idx < custBarCleanupCount[mode]; idx++) {
      int slot = custBarCleanupList[mode][idx];
      SetActorInventory(cam, StrParam(s:custBarNames[mode][0], i:slot), 0);
      custBarCleanup[mode][slot] = false;
    }
    custBarCleanupCount[mode] = 0;
  }

  // $UH — Qwant landscape wepicon align
  SetActorInventory(cam, "QwantAlignWepIcon", 0);
}


// these two scripts below help optimize the "give ammo" and "give all" cheats
script "core_DrawBar_CheatScenario" ENTER
{
	int pln = PlayerNumber();
	while(GetActorProperty(0, APROP_Health) > 0 && PlayerInGame(pln)) {
		if(CheckInventory("GiveAmmoTrap") != 0) {
			SetInventory("GiveAmmoTrap", 0);
			for (int i = 0; i < MAX_CUSTOM_BARS; i++) {
				SetInventory(StrParam(s:"CustSbarSlotFlag", i:i),0);
				SetInventory(StrParam(s:"CustVSbarSlotFlag", i:i),0);
				SetInventory(StrParam(s:"CustHSbarSlotFlag", i:i),0);
				SetInventory(StrParam(s:"CustSbarSlotAmmo", i:i),0);
				SetInventory(StrParam(s:"CustVSbarSlotAmmo", i:i),0);
				SetInventory(StrParam(s:"CustHSbarSlotAmmo", i:i),0);
			}
		}

		Delay(1);
	}
}

script "core_DrawBar_CheatScenario_R" RESPAWN
{
	ACS_NamedExecuteWithResult("core_DrawBar_CheatScenario");
}
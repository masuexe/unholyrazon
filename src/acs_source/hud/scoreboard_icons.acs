// scoreboard_icons.acs — Unholy per-viewer portrait column refresh.
//
// Fragment of library unholy; #include'd at the END of unholy/uh_teaminfo.acs.
// Not a standalone library; must not be added to LOADACS.
//
// Per-viewer flow:
//   * MAPINFO declares a Texture custom player value "UHPlayerIcon".
//   * SCORINFO puts the UHPlayerIcon column in PlayerIcon's slot.
//   * This CLIENTSIDE loop computes each row for the local client only and
//     writes it with SetCustomPlayerValue; the server never writes the column.
//
// Correctness rules:
//   * The viewer is the explicit console player (or the assist-display latch on
//     a listen host).  GetPlayerInput(-1, ...) means the script's activator,
//     which an OPEN script does not have, so TAB was never detected before.
//   * Writes compare against GetCustomPlayerValue so an engine-side overwrite
//     (listen-host broadcast, join reset) is corrected on the next open instead
//     of being masked by a client-side cache.
//   * Visibility is the single UH_CanSeeScoreIcon matrix in uh_teaminfo.acs,
//     driven by the server-synchronized UH_SCOREPOLICY_* value; this file adds
//     no permission logic of its own.
//   * Listen server with remote clients: the ACS API cannot address custom
//     player data to one client, so a host write is broadcast.  The host
//     therefore empties its shared copy (an empty broadcast leaks nothing) and
//     does not compute a private matrix; remote clients compute their own.

// ConsolePlayerNumber() returns -1 only inside a listen-server process (a
// dedicated server never runs this CLIENTSIDE loop and single-player/offline
// has a real consoleplayer).  A listen host must never write this column at
// all: the ACS API has no per-client target, so the write is broadcast to every
// connected client, and PlayerCount() is not a safe gate because it excludes
// spectators and dead spectators — the only remote player dying would drop it
// to 1 and re-enable the broadcast.  Suppress unconditionally on a listen host;
// single-player/offline still shows local portraits.
function bool UH_ScoreIcons_HostBroadcastRisk(void) {
  return (ConsolePlayerNumber() < 0);
}

// Empty the host's shared copy; an empty value carries no Survivor/Eye data.
// Remote clients overwrite their own copies on open via the GetCustomPlayerValue
// comparison in UH_ScoreIcons_Refresh.
function void UH_ScoreIcons_HostHide(void) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    if (StrCmp(GetCustomPlayerValue("UHPlayerIcon", i), "") != 0) {
      SetCustomPlayerValue("UHPlayerIcon", i, "");
    }
  }
}

function void UH_ScoreIcons_Refresh(void) {
  if (UH_ScoreIcons_HostBroadcastRisk()) {
    UH_ScoreIcons_HostHide();
    return;
  }
  int viewer = ConsolePlayerNumber();
  if (viewer < 0) { viewer = uhtilocalplayer; }
  for (int i = 0; i < MAX_PLAYERS; i++) {
    str tex = "";
    if (UH_CanSeeScoreIcon(viewer, i)) {
      tex = UH_ClientPortraitTex(i);
    }
    // Compare against the engine value, not a local cache: the scoreboard may
    // have been overwritten by a listen-host broadcast or the join reset.
    if (StrCmp(GetCustomPlayerValue("UHPlayerIcon", i), tex) != 0) {
      SetCustomPlayerValue("UHPlayerIcon", i, tex);
    }
  }
}

// Clear every row once at map load so a leftover value from the previous map
// cannot survive until the scoreboard is first opened in this one.
function void UH_ScoreIcons_ClearEngine(void) {
  for (int i = 0; i < MAX_PLAYERS; i++) {
    ResetCustomDataToDefault("UHPlayerIcon", i);
  }
}

script "uh_ti_scoreboard_loop" OPEN CLIENTSIDE {
  UH_ScoreIcons_ClearEngine();
  while (true) {
    Delay(1);
    if (GetCVar("lastmanstanding") != 1) { continue; }
    // Resolve the viewer first; an OPEN script has no player activator, so
    // GetPlayerInput(-1, ...) would never see TAB.
    int viewer = ConsolePlayerNumber();
    if (viewer < 0) { viewer = uhtilocalplayer; }
    bool shown = (viewer >= 0)
      && (GetPlayerInput(viewer, INPUT_BUTTONS) & BT_SHOWSCORES) != 0;
    if (!shown && GetGameModeState() == GAMESTATE_INRESULTSEQUENCE) {
      // The result scoreboard draws without TAB; the battle is over.
      shown = true;
    }
    if (shown) {
      UH_ScoreIcons_Refresh();
    }
  }
}

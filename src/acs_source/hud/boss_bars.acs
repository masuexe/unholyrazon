script "DrawBar_Misery_W" (void) {
  DrawBarColor(4, 94);
  DrawBar2Color(197, 75);
  Misery_DrawBar(UHBAR_MISERY_COOLDOWN);
  if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    SetOverlayBar(CheckInventory("Misery_Charge"), 30);
    Misery_DrawBar(UHBAR_MISERY_OVERCHARGE);
  }
  int stamina = CheckInventory("Misery_HoverStamina_F");
  if (stamina < 500) {
    if (CheckInventory("PowerStaminaFlagDeplete")) {
      DrawBar3Color(stamina, 500, 229, 222);
      if (stamina <= 150) {
        SetFlashingBar3();
      }
    } else {
      DrawBar3Color(stamina, 500, 180, 185);
    }
  }
  DrawReloadIcon("R059B0");
}


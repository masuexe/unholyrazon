script "DrawBar_DLCCentaurman_W" (void) {
  // Custom Recca bars (UB111*) are generated from tools/bars.toml.
  DLCCentaurman_DrawBar(UHBAR_DLCCENTAURMAN);
  DrawBar2Color(31, 47);
  SetInventory("SBARAmmoOffset", 2);
  DrawNormalAmmo();
  DrawBar3Color(CheckInventory("UnholyPower1500"), 1500, 228, 111);
  // Reload = dimension jump; show CentIcon when ammo is full enough to jump.
  // Also reflect current Recca mode from world pickups (no Reload cycling).
  // if (CheckInventory("UnholyBossAmmo500") >= 500) {
  //   DrawReloadIcon("CentIcon");
  // } else if (CheckInventory("DLCCentaurmanWepFlag") >= 4) {
  //   DrawReloadIcon("RECCWEPH");
  // } else if (CheckInventory("DLCCentaurmanWepFlag") >= 3) {
  //   DrawReloadIcon("RECCWEPF");
  // } else if (CheckInventory("DLCCentaurmanWepFlag") >= 2) {
  //   DrawReloadIcon("RECCWEPB");
  // } else if (CheckInventory("DLCCentaurmanWepFlag") >= 1) {
  //   DrawReloadIcon("RECCWEPL");
  // } else {
  //   DrawReloadIcon("RECCWEPV");
  // }
  str wepicon;
  switch (CheckInventory("DLCCentaurmanWepFlag")) {
    case 0: wepicon = "RECCWEPV"; break;
    case 1: wepicon = "RECCWEPL"; break;
    case 2: wepicon = "RECCWEPB"; break;
    case 3: wepicon = "RECCWEPF"; break;
    case 4: wepicon = "RECCWEPH"; break;
  }
  SetHudSize(320, 200, 0);
  AdjustedImageDisplay(wepicon, wepicon, UH_IMAGE_ID_BASE - 100, UH_IMAGE_ID_BASE - 101, 16.1, 64.1, 50.1, 184.1);
  DrawReloadIcon("R111B0");
}


script "DrawBar_HalfPressHardman_W" (void) {
  DrawBarColor(4, 94);
  if (CheckInventory("UnholyPower1000") >= 250) {
    DrawBar2ColorGlow(228, 163, 235);
  } else {
    DrawBar2Color(163, 235);
  }
  DrawReloadIcon("R050B0");
  int flag = CheckInventory("HalfPressHardman_F");
  if (flag > 0) {
    AdjustedImageDisplay("8H50Z0", "8H50Z0", UH_IMAGE_ID_BASE - 120, UH_IMAGE_ID_BASE - 121,
                         1.1, 78.1, 60.1, 163.1);
    AdjustedDrawNumberC("CMBHQFONT", CR_YELLOW, flag, UH_IMAGE_ID_BASE - 122, UH_IMAGE_ID_BASE - 123,
                        21.1, 79.1, 80.0, 164.1);
  }
}

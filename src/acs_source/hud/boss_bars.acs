script "DrawBar_BrickDemoneye_W" (void) {
  // razon3 BARAMM75: Translation 192→229, 198→222
  DrawBarColor(229, 222);
  SetHudSize(320, 200, 0);
  int baseid = UH_IMAGE_ID_BASE - 220;
  int tacks = CheckInventory("BrickEyeThumbtackStack");
  int mines = CheckInventory("BrickEyeBrickMineStack");
  str tackstr;
  str minestr;
  if (tacks < 10)
    tackstr = StrParam(s:"0", i:tacks);
  else
    tackstr = StrParam(i:tacks);
  if (mines < 10)
    minestr = StrParam(s:"0", i:mines);
  else
    minestr = StrParam(i:mines);

  // VB: MYSBOX15 0,20 / PANBOX32 0,44; numbers 8,22 / 8,46
  // HB: MYSBOX15 -107+center,-29 / PANBOX32 -80+center,-29; numbers -98/-71+center,-27
  AdjustedImageDisplay("MYSBOX15", "MYSBOX15", baseid, baseid - 1,
    -18.1, 20.1,
    60.1, 168.1);
  AdjustedImageDisplay("PANBOX32", "PANBOX32", baseid - 2, baseid - 3,
    -18.1, 44.1,
    87.1, 168.1);
  AdjustedDrawString("CMBHQFONT", "Untranslated", tackstr, baseid - 4, baseid - 5,
    -9.1, 22.1,
    73.1, 170.1);
  AdjustedDrawString("CMBHQFONT", "Untranslated", minestr, baseid - 6, baseid - 7,
    -9.1, 46.1,
    100.1, 170.1);
}


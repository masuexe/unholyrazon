#define MMSF_MAX_CARDS 11
script "DrawBar_Neru_W" (void) {
  // Preserve the original Neru layout: magazine on bar2, skill on bar1,
  // with both rage gauges layered on bar3.
  DrawBar2ColorOwned(CheckInventory("MillenniumAmmo"), GetAmmoCapacity("MillenniumAmmo"), 229, 222);
  Neru_DrawBar(UHBAR_NERU_SKILL);
  DrawBar3Color(CheckInventory("UnholyPower1500"), GetAmmoCapacity("UnholyPower1500"), 54, 42);
  Neru_DrawBar(UHBAR_NERU_WRATH);
  // Bar1 holds the skill resource, while Ammo2Disp holds the magazine on bar2.
  SetInventory("SBARUseAmmo1Disp", 1);
  SetAmmoAmountAndCapacity("Ammo1Disp", CheckInventory("MikAmmo"), GetAmmoCapacity("MikAmmo"));
  DrawNormalAmmo();
  SetHudSize(320, 200, false);
  AdjustedDrawNumberC("CMBHQFONT", CR_RED, CheckInventory("Neru_Wrath_Stacker"),
                      UH_IMAGE_ID_BASE - 122, UH_IMAGE_ID_BASE - 123,
                      1.0, 68.0, 47.2, 172.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_YELLOW, CheckInventory("Neru_Rage_Stacker"),
                      UH_IMAGE_ID_BASE - 120, UH_IMAGE_ID_BASE - 121,
                      9.0, 68.0, 47.2, 180.1);
}

script "DrawBar_Cobe_W" (void) {
  if (CheckInventory("Biscuits") == 1) SetFlashingBar();
}

str mmsf_card_graphic[MMSF_MAX_CARDS + 1] = {
  "",
  "BC_RADAR",
  "BC_PUFFB",
  "BC_GHOST",
  "BC_SHURI",
  "BC_STUNK",
  "BC_MOAIF",
  "BC_TYPHO",
  "BC_MAGC1",
  "BC_MAGC2",
  "BC_MAGC3",
  "BC_ELECS",
};

script "DrawBar_WarRockStelar_W" (void) {
  DrawBarColor(201, 110);
  DrawBar2Color(192, 198);
  SetHudSize(320, 200, false);
  // if (CheckInventory("WR_LockOnFlag")) {
  //  AdjustedImageDisplay("UGB051A", "UGB051A", UH_IMAGE_ID_BASE - 131, UH_IMAGE_ID_BASE - 132,
  //                       1.1, 1.1, 60.1, 163.1);
  // }
  int card_id = ACS_NamedExecuteWithResult("rz_GetSFCard", 0);
  if (card_id > 0) {
    str card_graphic = mmsf_card_graphic[card_id];
    // Both HUD modes: current card nearest the bars; queue grows outward (left of current).
    // Vert 320: bars ~x8–16; current at 40.1,78.1 (below bars, room for queue on left).
    // Hori 320: bar2/bar1 at 58,176/184; current at 42.1,162.1 (left of bars).
    AdjustedImageDisplay(card_graphic, card_graphic, UH_IMAGE_ID_BASE - 124, UH_IMAGE_ID_BASE - 125,
                         40.1, 78.1,
                         42.1, 162.1);
    SetHudSize(640, 400, false);
    for (int i = 1; i <= 5; i++) {
      card_id = ACS_NamedExecuteWithResult("rz_GetSFCard", i);
      if (card_id > 0) {
        card_graphic = mmsf_card_graphic[card_id];
        // Queue: 640x400 mini cards, left of current. Do not *2 fractional .1 (align bits).
        // Vert: current left≈80.1 → 80.1-i*16; Hori: current left≈84.1 → 84.1-i*16.
        AdjustedImageDisplay(card_graphic, card_graphic, UH_IMAGE_ID_BASE - 124 - i, UH_IMAGE_ID_BASE - 125 - i,
                             80.1 - i * 20.0, 169.1,
                             84.1 - i * 20.0, 337.1);
      }
    }
  }
  SetHudSize(320, 200, false);
}

script "DrawBar_WarRockStelar_W2" (void) {
  ACS_NamedExecuteWithResult("DrawBar_WarRockStelar_W");
}

script "DrawBar_HarpStrumm_W" (void) {
  int flag = CheckInventory("HarpStrummColorF");
  if (flag >= 1 && flag <= 9) {
    switch (flag) {
      case 1:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_RED);
        break;
      case 2:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_ORANGE);
        break;
      case 3:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_YELLOW);
        break;
      case 4:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_GREEN);
        break;
      case 5:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_CYAN);
        break;
      case 6:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_BLUE);
        break;
      case 7:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_PURPLE);
        break;
      case 8:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_BLACK);
        break;
      case 9:
        HarpStrumm_DrawBar(UHBAR_HARPSTRUMM_WHITE);
        break;
    }
    SetInventory("SBARAmmoOffset", 1);
    DrawNormalAmmo();
  } else {
    DrawBarColor(80, 40);
  }
}


// Generated by tools/_gen_barpos.py from tools/bars.toml.
// Namespaced SBARINFO bars; do not edit by hand.

#define UHSS_BAR_BODY_ID 1
#define UHSS_BAR_READY_ID 2

function void UHSS_DrawBar(int id, int amount, int capacity) {
  if (capacity <= 0) { return; }
  if (amount < 0) { amount = 0; }
  if (amount > capacity) { amount = capacity; }
  switch (id) {
    case UHSS_BAR_BODY_ID:
      SetInventory("UHSS_P1L0Selector", 1);
      SetAmmoAmountAndCapacity("UHSS_P1L0_bodyAmmo", amount, capacity);
      break;
    case UHSS_BAR_READY_ID:
      SetInventory("UHSS_P1L10Selector", 1);
      SetAmmoAmountAndCapacity("UHSS_P1L10_readyAmmo", amount, capacity);
      break;
    default:
      break;
  }
}

script "UHSS_DrawBar_Clear" (int cam) CLIENTSIDE {
  SetActorInventory(cam, "UHSS_P1L0Selector", 0);
  SetActorInventory(cam, "UHSS_P1L0_bodyAmmo", 0);
  SetActorInventory(cam, "UHSS_P1L10Selector", 0);
  SetActorInventory(cam, "UHSS_P1L10_readyAmmo", 0);
}

script "UHSS_DrawBar_Clear_Register" OPEN CLIENTSIDE {
  ACS_NamedExecuteWithResult("core_DrawBar_RegisterClear", "UHSS_DrawBar_Clear");
}

script "DrawBar_Trapist_W" (void) {
  DrawCustomBarString1("30_B_BAR", "BAREMPTY", "30_B_VAR", "VAREMPTY",
                       CheckInventory("ClashEnergyAmmo"), 100);
  SetInventory("SBARAmmoOffset", 1);
  DrawNormalAmmo();
  if (CheckInventory("TrapistPrimedFlag")) {
    if (Timer() / 4 % 2 == 0) {
      DrawBar2Color(228, 164);
    } else {
      DrawBar2Color(4, 228);

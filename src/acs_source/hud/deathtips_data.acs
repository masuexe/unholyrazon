// The registry is client-only: the server-side DEATH script draws one roll
// that the client scales into [0, total_weight), so the server never reads
// these rows and only clients need them.  Joining clients never run
// non-CLIENTSIDE OPEN scripts and the death HUD is CLIENTSIDE, so a single
// CLIENTSIDE twin fills every client.
script "uh_TipDBRegister_cs" OPEN CLIENTSIDE {
  UH_RegisterBuiltinTips();
}



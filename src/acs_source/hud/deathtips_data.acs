// --- built-in registration ---------------------------------------------------
// Pool ids (byline groups) live in deathtips.acs (UH_POOL_*).  Byline
// strings below are copied verbatim from the former
// display switch/range fallback — do not "fix" their spacing or color codes.

function void UH_RegisterBuiltinTips(void) {
  int i;

  // --- single-column pools with a fixed byline -----------------------------
  UH_SetTipPoolLabel(UH_POOL_THELUSER, "\c[n4]The Luser \cjSays \cj\x99");
  for (i = 0; i < TALLY_THELUSER; i++)
    UH_RegisterTip(TheLuserTips[i], "", TheLuserTipsWrap[i], UH_POOL_THELUSER, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_THEYOUNGER, "\c[e3]The Younger\c-'s \cdTip \cj\x99");
  for (i = 0; i < TALLY_THEYOUNGER; i++)
    UH_RegisterTip(TheYoungerTips[i], "", TheYoungerTipsWrap[i], UH_POOL_THEYOUNGER, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_VHELPFUL, "\ciProtagonist \cdTip \cj\x99");
  for (i = 0; i < TALLY_VHELPFUL; i++)
    UH_RegisterTip(VeryHelpfulTips[i], "", VeryHelpfulTipsWrap[i], UH_POOL_VHELPFUL, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_TIPSREMIX, "\c[MenuPurple]Demoneye \cjSays \cd\x99");
  for (i = 0; i < TALLY_TIPREMIX; i++)
    UH_RegisterTip(TipsRemix[i], "", TipsRemixWrap[i], UH_POOL_TIPSREMIX, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_TIPS, "\ctDemoneye \cjQuote \cd\x99");
  for (i = 0; i < TALLY_TIPS; i++)
    UH_RegisterTip(Tips[i], "", TipsWrap[i], UH_POOL_TIPS, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_RANDOMQUOTE, "\c[UH00]Random Quote \cj\xA9");
  for (i = 0; i < TALLY_OTHERQUOTE; i++)
    UH_RegisterTip(TipsOfTips[i], "", TipsOfTipsWrap[i], UH_POOL_RANDOMQUOTE, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_SMM, "\cnSuperMegaman \cj\xAE");
  for (i = 0; i < TALLY_SMM; i++)
    UH_RegisterTip(SMMTip[i], "", SMMTipWrap[i], UH_POOL_SMM, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_COLDDRAGOON, "\c[t0]Cold \c[v6]Dragoon \cj\xAE");
  for (i = 0; i < TALLY_COLDDRAGOON; i++)
    UH_RegisterTip(ColdDragoonTip[i], "", ColdDragoonWrap[i], UH_POOL_COLDDRAGOON, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_PEGG, "\cjpe\ccgg \cj\xAE");
  for (i = 0; i < TALLY_PEGG; i++)
    UH_RegisterTip(peggTip[i], "", peggTipWrap[i], UH_POOL_PEGG, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_ROKUSHO, "\ctLy\cvian \cj\xAE");
  for (i = 0; i < TALLY_ROKUSHO; i++)
    UH_RegisterTip(RokushoTips[i], "", RokushoTipsWrap[i], UH_POOL_ROKUSHO, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_MUSASHI, "\cdMusashi\cqAA \cj\xAE");
  for (i = 0; i < TALLY_MUSH_AA; i++)
    UH_RegisterTip(MusashiAATip[i], "", MusashiAATipWrap[i], UH_POOL_MUSASHI, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_BLEWS, "\cnBlew\chs \cj\xAE");
  for (i = 0; i < TALLY_BLEWS; i++)
    UH_RegisterTip(BlewsTips[i], "", BlewsTipsWrap[i], UH_POOL_BLEWS, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_ZARD1084, "\cfZ\cva\cfr\cvd\cm1084 \cj\xAE");
  for (i = 0; i < TALLY_ZARD1084; i++)
    UH_RegisterTip(Zard1084Tip[i], "", Zard1084TipWrap[i], UH_POOL_ZARD1084, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_ZOMO, "\cmZomo \cj\xAE");
  for (i = 0; i < TALLY_ZOMO; i++)
    UH_RegisterTip(ZomoTips[i], "", ZomoTipsWrap[i], UH_POOL_ZOMO, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_CELEBI, "\cdCelebi \cj\xAE");
  for (i = 0; i < TALLY_CELEBI; i++)
    UH_RegisterTip(CelebiTime[i], "", CelebiTimeWrap[i], UH_POOL_CELEBI, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_ORANGEM, "\ciOrange\cdMario \cj\xAE");
  for (i = 0; i < TALLY_ORANGEM; i++)
    UH_RegisterTip(OrangeMTip[i], "", OrangeMTipWrap[i], UH_POOL_ORANGEM, UH_TIP_WEIGHT_DEFAULT);

  UH_SetTipPoolLabel(UH_POOL_SPECIALT, "\xE \ckMessage from Unholy\cf\xAE \cj\xF");
  for (i = 0; i < TALLY_SPECIAL_T; i++)
    UH_RegisterTip(SpecialT_Tips[i], "", SpecialT_TipsWrap[i], UH_POOL_SPECIALT, UH_TIP_WEIGHT_DEFAULT);

  // --- two-column pools: column 0 is the per-tip byline --------------------
  for (i = 0; i < TALLY_OTHER; i++)
    UH_RegisterTip(OtherTip[i][1], OtherTip[i][0], OtherTipWrap[i], UH_POOL_OTHER, UH_TIP_WEIGHT_DEFAULT);

  for (i = 0; i < TALLY_SJB; i++)
    UH_RegisterTip(SJBTips[i][1], SJBTips[i][0], SJBTipsWrap[i], UH_POOL_SJB, UH_TIP_WEIGHT_DEFAULT);

  for (i = 0; i < TALLY_TFP; i++)
    UH_RegisterTip(TFPTip[i][1], TFPTip[i][0], TFPTipWrap[i], UH_POOL_TFP, UH_TIP_WEIGHT_DEFAULT);

  for (i = 0; i < TALLY_ZERO; i++)
    UH_RegisterTip(ZeroTip[i][1], ZeroTip[i][0], ZeroTipWrap[i], UH_POOL_ZERO, UH_TIP_WEIGHT_DEFAULT);

  for (i = 0; i < TALLY_PIK; i++)
    UH_RegisterTip(PikTip[i][1], PikTip[i][0], PikTipWrap[i], UH_POOL_PIK, UH_TIP_WEIGHT_DEFAULT);

  // --- easter eggs ----------------------------------------------------------
  // "Error 404" joke row: byline + single entry, both kept verbatim from
  // the old switch case.
  UH_SetTipPoolLabel(UH_POOL_ERROR404, "Error 404");
  UH_RegisterTip("\xAB< Tip not found >\xBB", "", 0, UH_POOL_ERROR404, UH_TIP_WEIGHT_404);
  // NotReallyTips stays unregistered: it was never part of the rotation.
}

// The registry is client-only: the server-side DEATH script draws one roll
// that the client scales into [0, uh_tipcount-1], so the server never reads
// these tables and only clients need them.  Joining clients never run non-CLIENTSIDE OPEN scripts
// and the death HUD is CLIENTSIDE, so a single CLIENTSIDE twin fills every
// client.  (The engine also forwards CLIENTSIDE OPEN scripts from the server,
// so this may run twice per client — UH_RegisterTip dedupes, which is also
// why no UHInPlay() guard is needed here.)
script "uh_TipDBRegister_cs" OPEN CLIENTSIDE {
  UH_RegisterBuiltinTips();
}

  } else {
    HudMessageBold(i:number; HUDMSG_PLAIN | HUDMSG_NOTWITHOVERLAYMAP | HUDMSG_NOTWITH3DVIEW, id2, cr_color, x2, y2, 1873, 1.0);
    if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_VERT) {

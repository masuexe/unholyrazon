#define UHBAR_STEALTHSNIPER 1
#define UHBAR_STEALTHSNIPER_FULLCHARGE 2
#define UHBAR_STEALTHSNIPER_SHINY 3
#define UHBAR_STEALTHSNIPER_SHINYFULL 4

function void UHBar_StealthSniper_DrawBar(int id, int amount, int capacity) {
  if (capacity <= 0) { return; }
  if (amount < 0) { amount = 0; }
  if (amount > capacity) { amount = capacity; }
  switch (id) {
    case UHBAR_STEALTHSNIPER:
      SetInventory("UHBar_StealthSniper_P1L0Selector", 1);
      SetAmmoAmountAndCapacity("UHBar_StealthSniper_P1L0_BodyAmmo", amount, capacity);
      break;
    case UHBAR_STEALTHSNIPER_FULLCHARGE:
      SetInventory("UHBar_StealthSniper_P1L10Selector", 1);
      SetAmmoAmountAndCapacity("UHBar_StealthSniper_P1L10_ReadyAmmo", amount, capacity);
      break;
    case UHBAR_STEALTHSNIPER_SHINY:
      SetInventory("UHBar_StealthSniper_P1L0Selector", 2);
      SetAmmoAmountAndCapacity("UHBar_StealthSniper_P1L0_ShinyBodyAmmo", amount, capacity);
      break;
    case UHBAR_STEALTHSNIPER_SHINYFULL:
      SetInventory("UHBar_StealthSniper_P1L10Selector", 2);
      SetAmmoAmountAndCapacity("UHBar_StealthSniper_P1L10_ShinyReadyAmmo", amount, capacity);
      break;
    default:
      break;
  }
}


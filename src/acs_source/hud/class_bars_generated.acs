script "UHBar_StealthSniper_Clear" (int cam) CLIENTSIDE {
  SetActorInventory(cam, "UHBar_StealthSniper_P1L0Selector", 0);
  SetActorInventory(cam, "UHBar_StealthSniper_P1L0_BodyAmmo", 0);
  SetActorInventory(cam, "UHBar_StealthSniper_P1L10Selector", 0);
  SetActorInventory(cam, "UHBar_StealthSniper_P1L10_ReadyAmmo", 0);
  SetActorInventory(cam, "UHBar_StealthSniper_P1L0_ShinyBodyAmmo", 0);
  SetActorInventory(cam, "UHBar_StealthSniper_P1L10_ShinyReadyAmmo", 0);
}

script "UHBar_StealthSniper_Clear_Register" OPEN CLIENTSIDE {

script "UHBar_ClearAll_Register" OPEN CLIENTSIDE {
  int result = ACS_NamedExecuteWithResult(
      "core_DrawBar_RegisterClear", "UHBar_ClearAll");
  if (result < 0) {
    Log(s:"UHBar_ClearAll_Register: core_DrawBar_RegisterClear failed: ",
        i:result);
  }
}

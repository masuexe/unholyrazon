#define UHBAR_BALLADEGB_MINE 1
#define UHBAR_BALLADEGB_FOCUS 2

function void BalladeGB_DrawBar(int id, int amount, int capacity) {
  if (capacity <= 0) { return; }
  if (amount < 0) { amount = 0; }
  if (amount > capacity) { amount = capacity; }
  switch (id) {
    case UHBAR_BALLADEGB_MINE:
      SetInventory("UHBar_BalladeGB_P1L0Selector", 1);
      break;
    case UHBAR_BALLADEGB_FOCUS:
      SetInventory("UHBar_BalladeGB_P1L1Selector", 1);
      SetAmmoAmountAndCapacity("UHBar_BalladeGB_P1L1_FocusAmmo", amount, capacity);
      break;
    default:
      break;
  }
}


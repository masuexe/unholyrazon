// UH death tips — dynamic tip database (library "deathtips").
//
// The tip shown when a player dies used to be a fixed set of compile-time
// arrays plus two big switches: one mapping a 0-999 death roll to a table,
// one mapping the same roll to a display case.  Adding a tip meant editing
// this file in five separate places.  The tables now live in a small runtime
// registry: every tip is one (text, byline, wrap width, pool, weight) row,
// and addons register rows through UH_RegisterTip without touching this file.
//
// Selection is weighted: each row is drawn with probability
// weight / total_weight.  Pools survive only as byline groups (a tip without
// its own byline shows its pool's byline).  Rarity is data, not code — the
// old hardcoded easter-egg chances are now weights like any other row:
//   * the "Error 404" joke row is registered with a low weight,
//   * the Celebi secret is a virtual entry with UH_TIP_SECRET_WEIGHT, so its
//     rarity is tuned by the same knob as every tip.
//
// Data flow:
//   server DEATH script draws one roll in [0, UH_TIP_ROLL_VALUES-1] and
//   forwards it to the dying player's client
//     -> NamedExecuteClientScript("uh_DeathTipACS", player, roll, -1)
//       -> CLIENTSIDE display scales the roll into [0, total_weight) and
//          walks the weighted registry, then draws the row it lands on
// The registry is client-only: one OPEN CLIENTSIDE twin fills it on every
// client (map arrays are zeroed and re-registered on every map load).  The
// server never reads it — it must not: a dedicated server has no client side
// to fill it, and client-side random() is re-seeded identically on every map
// change (FRandom::StaticClearRandom in G_InitLevel; clients never advance
// rngseed), so a client roll would repeat the same sequence every round.
// The rolls therefore stay in the server-side DEATH script, which is also the
// only place a death can be observed: clients never start DEATH scripts
// themselves (the script block in AActor::Die is gated by
// NETWORK_InClientMode() == false).
//
// Because the client scales the server's roll into its own weight space, the
// drawn range always tracks the registry: growing the database or loading an
// addon with more (or heavier) tips changes the outcome with no constant
// edits.  See UH_TIP_ROLL_VALUES for why the roll is 16-bit and
// UH_TIP_WEIGHT_TOTAL_MAX for the total-weight bound that follows from it.
//
// === Modder recipe (add your own death tips) ================================
// 1. LOADACS (your pk3, loaded after Unholy): YOUR_TIPDEFS
//    ("deathtips" itself is already loaded by the Unholy pk3.)
// 2. In YOUR_TIPDEFS.acs:
//      #library "YOUR_TIPDEFS"
//      #include "zcommon.acs"
//      #import "deathtips.acs"   // API + UH_POOL_* / UH_TIP_* constants
//
//      function void YourRegisterTips(void)
//      {
//          // text, byline ("" = pool byline), wrap width (0 = default), pool,
//          // weight (0 = registered but never drawn)
//          UH_RegisterTip("Your first tip.", "\cjYourName \cj\xA9", 210,
//                         UH_POOL_CUSTOM, UH_TIP_WEIGHT_DEFAULT);
//          UH_RegisterTip("Your rare tip.", "", 0, UH_POOL_CUSTOM, 4);
//      }
//
//      // The registry is client-only, so a single CLIENTSIDE twin is all an
//      // addon needs (joining clients never run non-CLIENTSIDE OPEN scripts
//      // and the death HUD is CLIENTSIDE).
//      script "your_define_tips_cs" OPEN CLIENTSIDE { YourRegisterTips(); }
// 3. Do NOT UHInPlay()-guard the twin (SpawnForced can fail on pure clients).
//    Registration is pure data; UH_RegisterTip dedupes by (pool, text,
//    byline), so the engine delivering the script twice (local level start
//    plus the server's forward of every CLIENTSIDE OPEN script) is safe and
//    returns the existing entry index.
// 4. Weights are relative.  The registry keeps total weight (+ the secret's)
//    within UH_TIP_WEIGHT_TOTAL_MAX by halving all weights when an insert
//    would overflow it, which preserves ratios; a weight of 1 is never
//    halved away (that would park the row).  The bound is what makes every
//    weight >= 1 row reachable and the client's roll * total product safe in
//    32-bit ACS arithmetic, so it cannot be raised without a wider roll.
// 5. Pools only group bylines: UH_POOL_CUSTOM is the default home; join a
//    built-in pool (UH_POOL_TIPS, UH_POOL_VHELPFUL, ...) to share its byline,
//    or claim your own pool id (25..UH_TIP_POOL_MAX-1) and set its byline with
//    UH_SetTipPoolLabel.
// 6. Byline: "" uses the pool byline; a non-empty byline replaces it for that
//    tip only.  Both empty = the tip is drawn without a byline line.  Do NOT
//    set a byline on the shared UH_POOL_CUSTOM pool — it would relabel every
//    modder's tips.
// 7. Wrap width: 0 keeps the 220 default, otherwise SetHudWrapWidth(value).
//    UH_RegisterTip returns the entry index (>= 0) or UH_TIP_FAIL (-1) when
//    the row was rejected (empty text, bad pool, registry full).
// 8. Verify at runtime: "puke uh_TipDBDump" logs the local registry (total
//    rows, per-pool sizes, weights and the secret's weight).
//    "puke UH_ShowDeathTip_Menu" previews the row named by the
//    _UH_DebugTip_Menu user cvar (an entry index).

#library "deathtips"
#include "zcommon.acs"
#import "uh_acsutils.acs"
#import "uh_log.acs"
#include "uh_aspect.acs"

// --- registry limits ---------------------------------------------------------
#libdefine UH_TIP_MAX 1024          // total tip rows (built-ins use ~365)
#libdefine UH_TIP_POOL_MAX 64       // pool ids 0..63
#libdefine UH_TIP_FAIL -1
// Sentinel returned by the weighted pick when the roll lands on the Celebi
// secret instead of a registry row (see UH_TIP_SECRET_WEIGHT).
#define UH_TIP_SECRET_ENTRY -2

// --- selection constants -----------------------------------------------------
// The server-side DEATH script draws one roll in [0, UH_TIP_ROLL_VALUES-1] and
// the client scales it into [0, total_weight).  16 bits on purpose: the client
// computes roll * total, so the product must stay inside a signed 32-bit ACS
// int (65535 * UH_TIP_WEIGHT_TOTAL_MAX does), and the roll space must cover
// the whole weight space so every weight >= 1 row stays reachable.  This is a
// resolution, never a tip count — growing the database needs no edit here.
#libdefine UH_TIP_ROLL_VALUES 65536
// Upper bound for total row weight plus UH_TIP_SECRET_WEIGHT.  Follows from
// the multiply above; the registry normalizes (halves) weights to stay under
// it, so this is not a hard limit on how much you can register.
#libdefine UH_TIP_WEIGHT_TOTAL_MAX 32768
// Default row weight: a plain tip in the normal rotation.
#libdefine UH_TIP_WEIGHT_DEFAULT 64
// The Celebi secret is a virtual weighted entry, so its rarity is tuned like
// any tip's.  Weight 1 lands on a single selection position, i.e. about one in
// 32768 deaths against the built-in total (~23k) — the rarest a single row
// can be in the 16-bit space (the old hardcoded rate was 1 in 101000).
#libdefine UH_TIP_SECRET_WEIGHT 1
// The "Error 404" joke row: rare, but findable (about one in 1450 deaths at
// built-in scale; the old magic-404 band was 1/1000 of all rolls).
#libdefine UH_TIP_WEIGHT_404 16
// Celebi secret wrap range.  The value feeds the secret's fun-character count
// (8 + wrap random characters), so both bounds belong together.
#libdefine UH_TIP_SECRET_WRAP_MIN -8
#libdefine UH_TIP_SECRET_WRAP_MAX -2

// --- pool ids ----------------------------------------------------------------
// Pools only group bylines now; ids are stable because addons reference them.
// 0 is parked storage (registered, never a byline target).
#libdefine UH_POOL_NONE 0
#libdefine UH_POOL_THELUSER 1
#libdefine UH_POOL_THEYOUNGER 2
#libdefine UH_POOL_VHELPFUL 3
#libdefine UH_POOL_TIPSREMIX 4
#libdefine UH_POOL_TIPS 5
#libdefine UH_POOL_RANDOMQUOTE 6
#libdefine UH_POOL_SMM 7
#libdefine UH_POOL_COLDDRAGOON 8
#libdefine UH_POOL_OTHER 9
#libdefine UH_POOL_PEGG 10
#libdefine UH_POOL_ROKUSHO 11
#libdefine UH_POOL_SJB 12
#libdefine UH_POOL_MUSASHI 13
#libdefine UH_POOL_BLEWS 14
#libdefine UH_POOL_TFP 15
#libdefine UH_POOL_ZARD1084 16
#libdefine UH_POOL_ZOMO 17
#libdefine UH_POOL_ZERO 18
#libdefine UH_POOL_CELEBI 19
#libdefine UH_POOL_ORANGEM 20
#libdefine UH_POOL_PIK 21
#libdefine UH_POOL_SPECIALT 22
#libdefine UH_POOL_ERROR404 23
#libdefine UH_POOL_CUSTOM 24        // shared addon default (no byline)

// --- registry storage --------------------------------------------------------
// Map arrays: zeroed on every map load, then refilled by the OPEN CLIENTSIDE
// twin in deathtips_data.acs (built-ins) and by addon registration scripts.
int uh_tipcount = 0;
int uh_tiptotalweight = 0;
str uh_tiptext[UH_TIP_MAX];
str uh_tipauthor[UH_TIP_MAX];       // "" = use the pool byline
int uh_tipwrap[UH_TIP_MAX];         // 0 = default wrap width
int uh_tippool[UH_TIP_MAX];
int uh_tipweight[UH_TIP_MAX];       // 0 = registered but never drawn

int uh_tippoolsize[UH_TIP_POOL_MAX];
str uh_tippoollabel[UH_TIP_POOL_MAX];  // pool byline; "" = draw no byline

// --- registration API --------------------------------------------------------

// Appends one tip row.  Idempotent: an identical (pool, text, byline) row
// (StrICmp) returns the existing entry index instead of duplicating — the
// weight of the existing row is kept.
function int UH_RegisterTip(str text, str author, int wrap, int pool, int weight)
{
	if (StrICmp(text, "") == 0)
		return UH_TIP_FAIL;
	if (pool < 0 || pool >= UH_TIP_POOL_MAX) {
		UH_Log(UH_LOG_ERROR, StrParam(s:"deathtips: UH_RegisterTip rejected pool ", i:pool,
			s:" (valid 0..", i:UH_TIP_POOL_MAX - 1, s:")"));
		return UH_TIP_FAIL;
	}
	if (wrap < 0)
		wrap = 0;
	if (weight < 0)
		weight = 0;

	int i;
	for (i = 0; i < uh_tipcount; i++) {
		if (uh_tippool[i] != pool)
			continue;
		if (StrICmp(uh_tiptext[i], text) != 0)
			continue;
		if (StrICmp(uh_tipauthor[i], author) != 0)
			continue;
		return i;
	}

	if (uh_tipcount >= UH_TIP_MAX) {
		UH_Log(UH_LOG_ERROR, StrParam(s:"deathtips: tip registry full (", i:UH_TIP_MAX,
			s:" rows); dropped tip"));
		return UH_TIP_FAIL;
	}

	i = uh_tipcount;
	uh_tipcount++;
	uh_tiptext[i] = text;
	uh_tipauthor[i] = author;
	uh_tipwrap[i] = wrap;
	uh_tippool[i] = pool;
	uh_tipweight[i] = weight;
	uh_tippoolsize[pool]++;
	uh_tiptotalweight += weight;
	UH_TipNormalizeWeights();
	return i;
}

// Sets (or clears, with "") the byline drawn for pool tips that carry no
// per-tip byline.  Returns 1 on success, UH_TIP_FAIL on a bad pool id.
function int UH_SetTipPoolLabel(int pool, str label)
{
	if (pool <= 0 || pool >= UH_TIP_POOL_MAX)
		return UH_TIP_FAIL;
	uh_tippoollabel[pool] = label;
	return 1;
}

// Keeps the selection space inside the 16-bit roll: total weight plus the
// secret's must stay <= UH_TIP_WEIGHT_TOTAL_MAX so the client's
// roll * total product cannot overflow a 32-bit ACS int, and so every
// weight >= 1 row stays reachable.  Halving preserves the ratios; weights of
// 1 are never halved away (that would park the row), and weight-0 rows stay
// parked.
function void UH_TipNormalizeWeights(void)
{
	while (uh_tiptotalweight + UH_TIP_SECRET_WEIGHT > UH_TIP_WEIGHT_TOTAL_MAX) {
		int i, total = 0;
		for (i = 0; i < uh_tipcount; i++) {
			if (uh_tipweight[i] > 1)
				uh_tipweight[i] = uh_tipweight[i] >> 1;
			total += uh_tipweight[i];
		}
		uh_tiptotalweight = total;
	}
}

// --- registry queries --------------------------------------------------------

function int UH_TipPoolCount(int pool)
{
	if (pool < 0 || pool >= UH_TIP_POOL_MAX)
		return 0;
	return uh_tippoolsize[pool];
}

function int UH_TipWeightOf(int entry)
{
	if (entry < 0 || entry >= uh_tipcount)
		return 0;
	return uh_tipweight[entry];
}

// Entry index of the idx-th registered row of a pool, or UH_TIP_FAIL.  For
// addons that enumerate their own pool; the display itself draws by weight.
function int UH_TipEntryAt(int pool, int idx)
{
	if (idx < 0)
		return UH_TIP_FAIL;
	int seen = 0;
	for (int i = 0; i < uh_tipcount; i++) {
		if (uh_tippool[i] != pool)
			continue;
		if (seen == idx)
			return i;
		seen++;
	}
	return UH_TIP_FAIL;
}

function str UH_TipTextAt(int entry)
{
	if (entry < 0 || entry >= uh_tipcount)
		return "";
	return uh_tiptext[entry];
}

function str UH_TipAuthorAt(int entry)
{
	if (entry < 0 || entry >= uh_tipcount)
		return "";
	return uh_tipauthor[entry];
}

function int UH_TipWrapAt(int entry)
{
	if (entry < 0 || entry >= uh_tipcount)
		return 0;
	return uh_tipwrap[entry];
}

function int UH_TipPoolAt(int entry)
{
	if (entry < 0 || entry >= uh_tipcount)
		return UH_POOL_NONE;
	return uh_tippool[entry];
}

// --- weighted selection ------------------------------------------------------

// Scales the server's raw roll into the weight space and walks the registry.
// Returns a registry entry index, UH_TIP_SECRET_ENTRY when the roll lands on
// the secret's band, or UH_TIP_FAIL when there is nothing to draw.
//
// The roll must come from the server: FRandom::StaticClearRandom() re-seeds
// pr_acs on every map change and clients never advance rngseed, so a
// client-side random() would repeat the same sequence every round.
function int UH_TipEntryFromEntropy(int roll)
{
	if (uh_tipcount <= 0)
		return UH_TIP_FAIL;
	int total = uh_tiptotalweight + UH_TIP_SECRET_WEIGHT;
	if (roll < 0)
		roll = 0;
	else if (roll > UH_TIP_ROLL_VALUES - 1)
		roll = UH_TIP_ROLL_VALUES - 1;
	// roll * total <= (UH_TIP_ROLL_VALUES-1) * UH_TIP_WEIGHT_TOTAL_MAX, which
	// is what keeps this inside a signed 32-bit ACS int.
	int pos = (roll * total) / UH_TIP_ROLL_VALUES;
	if (pos >= total)
		pos = total - 1;
	if (pos >= uh_tiptotalweight)
		return UH_TIP_SECRET_ENTRY;

	int cum = 0;
	for (int i = 0; i < uh_tipcount; i++) {
		cum += uh_tipweight[i];
		if (pos < cum)
			return i;
	}
	return UH_TIP_FAIL;
}

// --- built-in data + registration (map arrays, OPEN CLIENTSIDE twin) ---------
#include "deathtips_data.acs"

// Fun for the whole family.
// == VERY HELPFUL TIP ==
script "uh_DeathTipsCheck" DEATH {
  if (!GetUserCVar(PlayerNumber(), "uh_cl_DeathTips")) {
    // terminate;
  }
  else {
    // The roll MUST happen here, not in the CLIENTSIDE display script:
    // client-side random() repeats the same sequence every round (see
    // UH_TipEntryFromEntropy).  The client scales it into its own weight
    // space, so the server never needs to know the registry.
    int Roll = random(0, UH_TIP_ROLL_VALUES - 1);
    NamedExecuteClientScript("uh_DeathTipACS", PlayerNumber(), Roll, -1);
  }
}

script "UH_ShowDeathTip_Menu" (void) {
  int Entry = GetUserCVar(PlayerNumber(), "_UH_DebugTip_Menu");
  // ForceRoll = -1 + ForceEntry = an explicit entry index; the display honors
  // it when in range.  (This script may run where no registry exists — e.g. a
  // dedicated server console — in which case the client falls back to its own
  // roll, because there is nothing to index.)
  ACS_NamedExecuteAlways("uh_DeathTipACS", 0, -1, Entry);
  NamedExecuteClientScript("uh_DeathTipACS", PlayerNumber(), -1, Entry);
}
// $

// Argument protocol (the roll stays server-side; see the header):
//   ForceRoll   raw roll in [0, UH_TIP_ROLL_VALUES-1]; the client scales it
//               into the weight space.  -1 = no server roll.
//   ForceEntry  explicit entry index (debug preview), honored only when
//               ForceRoll < 0 and the index is in range.  -1 = none.
script "uh_DeathTipACS" (int ForceRoll, int ForceEntry) CLIENTSIDE {
  // if(ConsolePlayerNumber() != PlayerNumber()){
  //		terminate;
  // }
  int entry = -1;
  if (ForceRoll >= 0) {
    entry = UH_TipEntryFromEntropy(ForceRoll);
  }
  else if (ForceEntry >= 0 && ForceEntry < uh_tipcount) {
    entry = ForceEntry;
  }
  else if (uh_tipcount > 0) {
    entry = random(0, uh_tipcount - 1);
  }

  int HudWrapper = 0;
  str Tip_S = "XxXx";
  str UpperTip_S = "XxXx";

  if (entry == UH_TIP_SECRET_ENTRY) {
    // Celebi secret: weighted like any tip (UH_TIP_SECRET_WEIGHT).  It keeps
    // the Celebi byline it always had; the wrap and fun-character count are
    // cosmetic, so they are generated here instead of being rolled server-side.
    if (StrICmp(uh_tippoollabel[UH_POOL_CELEBI], "") != 0)
      UpperTip_S = uh_tippoollabel[UH_POOL_CELEBI];
    int SecretWrap = random(UH_TIP_SECRET_WRAP_MIN, UH_TIP_SECRET_WRAP_MAX);
    str FunChar_Str = " ";
    for (int i = 8 + SecretWrap; i < 14; i++)
    {  // $ i=random(0,6)
      FunChar_Str = StrParam(s:FunChar_Str, c:random(32, 255));  // 32
    }
    HudWrapper = 210;
    Tip_S = strparam(s:"\cdDid you see the secret involving\cq", s:FunChar_Str, s:"\cd yet, \c-", n:0, s:"\cd?");
  }
  else if (entry < 0 || entry >= uh_tipcount) {
    // Registry empty (registration never ran): degrade quietly instead of
    // indexing an invalid row.
    Tip_S = "\cj(no death tips are registered)";
  }
  else {
    int pool = uh_tippool[entry];
    if (StrICmp(uh_tipauthor[entry], "") != 0)
      UpperTip_S = uh_tipauthor[entry];
    else if (StrICmp(uh_tippoollabel[pool], "") != 0)
      UpperTip_S = uh_tippoollabel[pool];
    Tip_S = uh_tiptext[entry];
    HudWrapper = uh_tipwrap[entry];
  }
  // Log(i:entry,s:" entry <> count ",i:uh_tipcount);

  SetHudSize(640, 480, 0);
  if (HudWrapper > 0)
    SetHudWrapWidth(HudWrapper);
  else
    SetHudWrapWidth(220);

  int X_Aspect = GetHudRight(640) * 1.0;
  int Y_Aspect = GetHudTop(480) * 1.0;
  if (GetScreenWidth() == 640 && GetScreenHeight() == 480) {
    X_Aspect = 640.0;
    Y_Aspect = 0.0;
  }

  SetFont("SMALLFONT");

  if (StrICmp(UpperTip_S, "XxXx") != 0) {
    HudMessage(s:UpperTip_S, s:"\n\cj", s:Tip_S; HUDMSG_TYPEON | HUDMSG_LOG, 664, CR_WHITE, 320.0, 200.0, 2.0, 0.95, 2.0);
    HudMessage(s:UpperTip_S; HUDMSG_FADEINOUT, 664, CR_WHITE, X_Aspect - 130.0, 48.1 + Y_Aspect, 6.5, 1.0, 1.0);
    HudMessage(s:Tip_S; HUDMSG_FADEINOUT, 665, CR_WHITE, X_Aspect - 130.0, 60.1 + Y_Aspect, 6.5, 1.0, 1.0);
  }
  else {
    HudMessage(s:""; 0, 664, -1, 0.99, 0.01, 1873);
    HudMessage(s:Tip_S; HUDMSG_FADEINOUT | HUDMSG_LOG, 665, CR_WHITE, X_Aspect - 130.0, 48.1 + Y_Aspect, 6.5, 1.0, 1.0);
  }
}

// Debug helper (modder-facing): "puke uh_TipDBDump" logs the local registry
// state so an addon can verify its rows landed.  The registry only exists on
// clients (see the header).
script "uh_TipDBDump" (void) CLIENTSIDE {
  int i;
  UH_Log(UH_LOG_INFO, StrParam(s:"deathtips: ", i:uh_tipcount, s:"/", i:UH_TIP_MAX,
    s:" tips, weight ", i:uh_tiptotalweight, s:"+", i:UH_TIP_SECRET_WEIGHT,
    s:" secret/", i:UH_TIP_WEIGHT_TOTAL_MAX, s:" max"));
  for (i = 1; i < UH_TIP_POOL_MAX; i++) {
    if (uh_tippoolsize[i] <= 0)
      continue;
    UH_Log(UH_LOG_INFO, StrParam(s:"  pool ", i:i, s:": ", i:uh_tippoolsize[i], s:" tips"));
  }
}

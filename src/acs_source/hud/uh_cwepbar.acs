script "DrawBar_TimeStopperWepU" (void) {
	DrawBarColor(34, 239);
	DrawCustomBarString1("002B_BAR", "NOBAR", "002B_VAR", "VNOBAR",
	                     CheckInventory("TimeStopperUFlag"), 560);
}

script "DrawBar_QuickBoomerangWepU" (void) {
	DrawBarColor(34, 39);
	DrawCustomBarString1("002B_BAR", "NOBAR", "002B_VAR", "VNOBAR",
	                     CheckInventory("QuickBoomerangUFlag"), 280);
}

script "DrawBar_AtomicFireWepU" (void) {
	if (GetUserCvar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
		if (CheckInventory("WeaponCharge") >= 20) {
			if (CheckInventory("WeaponCharge") >= 50) {
				DrawCustomBarString1("00_2G_V9", "NOBAR", "00_2G_H9", "VNOBAR",
				                     CheckInventory("AtomicFireAmmo"), 28);
			} else if (CheckInventory("WeaponCharge") >= 40) {
				DrawCustomBarString1("00_2G_V5", "NOBAR", "00_2G_H5", "VNOBAR",
				                     CheckInventory("AtomicFireAmmo"), 28);
			} else if (CheckInventory("WeaponCharge") >= 30) {
				DrawCustomBarString1("00_2G_V1", "NOBAR", "00_2G_H1", "VNOBAR",
				                     CheckInventory("AtomicFireAmmo"), 28);
			}
			if (Timer() % 2 == 1) {
				DrawBarColorGlow(229, 4, 4);
			} else {
				DrawBarColor(229, 41);
			}
		} else if (CheckInventory("WeaponCharge") >= 10) {
			if (Timer() % 2 == 1) {
				DrawBarColorGlow(229, 193, 37);
			} else {
				DrawBarColor(229, 41);
			}
		} else if (CheckInventory("WeaponCharge") >= 1) {
			if (Timer() % 2 == 1) {
				DrawBarColorGlow(229, 41, 201);
			} else {
				DrawBarColor(229, 41);
			}
		} else {
			DrawBarColor(229, 41);
		}
		DrawCustomBarString1("00_2G_V0", "NOBAR", "00_2G_H0", "VNOBAR",
		                     CheckInventory("AtomicFireCharge_F"), 280);
	} else {
		DrawBarColor(229, 41);
		if (CheckInventory("WeaponCharge") >= 50) {
			DrawCustomBarString1("00_2G_V9", "NOBAR", "00_2G_H9", "VNOBAR",
			                     CheckInventory("AtomicFireAmmo"), 28);
		}
	}
}


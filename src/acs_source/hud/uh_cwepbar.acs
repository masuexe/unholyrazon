script "DrawBar_NoiseCrushWepU" (void) {
    if(GetUserCvar(ConsolePlayerNumber(),"mm8bdm_usechargebars")) {
        if(CheckInventory("WeaponCharge") > 0) {
            if(Timer() % 3 == 1) {
                DrawBarColorGlow(61,0,204);
            } else if (Timer() % 3 == 2) {
                DrawBarColorGlow(0,204,61);
            } else if (Timer() % 3 == 0) {
                DrawBarColor(204,61);
            }
        } else {
            DrawBarColor(204,61);
        }
    } else {
        DrawBarColor(204,61);
        if(CheckInventory("WeaponCharge") > 0) SetFlashingBar();
    }
}


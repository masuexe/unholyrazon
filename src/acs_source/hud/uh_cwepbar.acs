// DrawBarRun sets normal colors before invoking the weapon's ScriptBar.
// DrawBarColor* then preserves MugshotTransFlag, so these charge effects must
// explicitly copy their final bar colors to the portrait (palette index + 1).
function void UH_CopyBarColorsToMugshot(void) {
  SetMugshotColorGlow(
    CheckInventory("SBARCyan") - 1,
    CheckInventory("SBARBlue") - 1,
    CheckInventory("SBARBlack") - 1);
}

script "DrawBar_OilSliderWepU" (void) {
  SetOverlayBar(CheckInventory("OilSliderFlag"), 30);
}

script "DrawBar_TimeSlowWepU" (void) {
  ACS_NamedExecuteWithResult("DrawBar_TimeSlowWep");
}

script "DrawBar_TimeStopperWepU" (void) {
  DrawBarColor(34, 239);
  TimeStopperWepU_DrawBar(UHBAR_TIMESTOPPERWEPU);
}

script "DrawBar_QuickBoomerangWepU" (void) {
  DrawBarColor(34, 39);
  QuickBoomerangWepU_DrawBar(UHBAR_QUICKBOOMERANGWEPU);
}

script "DrawBar_AtomicFireWepU" (void) {
  if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    if (CheckInventory("WeaponCharge") >= 20) {
      if (CheckInventory("WeaponCharge") >= 50) {
        AtomicFireWepU_DrawBar(UHBAR_ATOMICFIRE_MAXIMUM);
      } else if (CheckInventory("WeaponCharge") >= 40) {
        AtomicFireWepU_DrawBar(UHBAR_ATOMICFIRE_HIGH);
      } else if (CheckInventory("WeaponCharge") >= 30) {
        AtomicFireWepU_DrawBar(UHBAR_ATOMICFIRE_MEDIUM);
      }
      if (Timer() % 2 == 1) {
        DrawBarColorGlow(229, 4, 4);
      } else {
        DrawBarColor(229, 41);
      }
    } else if (CheckInventory("WeaponCharge") >= 10) {
      if (Timer() % 2 == 1) {
        DrawBarColorGlow(229, 193, 37);
      } else {
        DrawBarColor(229, 41);
      }
    } else if (CheckInventory("WeaponCharge") >= 1) {
      if (Timer() % 2 == 1) {
        DrawBarColorGlow(229, 41, 201);
      } else {
        DrawBarColor(229, 41);
      }
    } else {
      DrawBarColor(229, 41);
    }
    AtomicFireWepU_DrawBar(UHBAR_ATOMICFIRE_CHARGE);
  } else {
    DrawBarColor(229, 41);
    if (CheckInventory("WeaponCharge") >= 50) {
      AtomicFireWepU_DrawBar(UHBAR_ATOMICFIRE_MAXIMUM);
    }
  }
  UH_CopyBarColorsToMugshot();
}


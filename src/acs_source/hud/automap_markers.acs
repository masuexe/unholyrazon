// Client visibility bridge for the v6c MAUTOMAP shadow.
#define UH_AM_PLAYER_TID 1000

function bool UH_AM_CanSee(int viewer, int subject) {
  if (viewer < 0 || viewer >= MAX_PLAYERS) {return false;}
  if (subject < 0 || subject >= MAX_PLAYERS) {return false;}
  if (uhtirole[subject] == PLS_NULL) {return false;}
  if (viewer == subject) {return true;}
  // A delayed death snapshot must not grant observer vision after revival.
  // The local pawn's health is available without a server health snapshot.
  if (PlayerIsSpectator(viewer) == 1) {return true;}
  if (uhtilife[viewer] == PLS_DEAD
      && GetActorProperty(UH_AM_PLAYER_TID + viewer, APROP_Health) <= 0) {return true;}
  // Razon3: special rounds show self only while alive. Unknown policy is
  // also self-only until the server snapshot arrives.
  if (uhtiscorepolicy != UH_SCOREPOLICY_NORMAL) {return false;}
  return UH_AreDisplayTeammates(viewer, subject);
}

script "uh_AM_CanSee" (int viewer, int subject) CLIENTSIDE {
  UH_Ti_EnsureClientInitialized();
  SetResultValue(UH_AM_CanSee(viewer, subject));
}

script "uh_AM_PlayerMarker" (int subject) CLIENTSIDE {
  str marker = "UH_AutomapMarker";
  if (uhtirole[subject] == PLS_BOSS) {marker = "UH_AutomapBoss";}
  else if (uhtirole[subject] == PLS_EYE) {marker = "UH_AutomapEye";}
  SetResultValue(marker);
}

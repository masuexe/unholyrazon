script "DrawBar_QwantMove" (int type) {
  if (type < 0) {
    type = 0;
  }
  if (type >= QWANT_TYPE_COUNT) {
    type = QWANT_TYPE_NORMAL;
  }

  str wep = GetWeapon();
  ResolveQwantFillAmmo(wep, type);
  str ammo = uh_qwant_fill_ammo;
  int max_var = uh_qwant_fill_max;
  str name = StrParam(l:BuildQwantTagKey(wep));

  switch (type) {
    case QWANT_TYPE_NORMAL:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_NORMAL, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_FIRE:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_FIRE, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_WATER:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_WATER, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_ELECTRIC:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_ELECTRIC, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_GRASS:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_GRASS, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_ICE:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_ICE, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_FIGHTING:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_FIGHTING, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_POISON:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_POISON, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_GROUND:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_GROUND, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_FLYING:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_FLYING, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_PSYCHIC:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_PSYCHIC, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_BUG:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_BUG, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_ROCK:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_ROCK, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_GHOST:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_GHOST, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_DRAGON:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_DRAGON, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_DARK:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_DARK, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_STEEL:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_STEEL, CheckInventory(ammo), max_var);
      break;
    case QWANT_TYPE_FAIRY:
      Qwant_DrawBar(UHBAR_QWANT_MOVE_FAIRY, CheckInventory(ammo), max_var);
      break;
  }
  SetInventory("SBARAmmoOffset", 1);
  DrawNormalAmmo();
  // Pin mugshot before DrawBar2Color so MoveRelearnAmmo (138, 130) does not leak into the face.
  if (CheckInventory("Qwant_W")) {
    SetMugshotColor(QWANT_MUG_CYAN, QWANT_MUG_BLUE);
  }
  DrawBar2Color(QWANT_MOVE_BAR2_CYAN, QWANT_MOVE_BAR2_BLUE);
  // Landscape: PKMNI 16px at (50,176)+Offset(8,0) → left edge 42; name box matches.
  SetInventory("QwantAlignWepIcon", 1);
  SetHudSize(320, 200, 0);
  InitPkmnf7WidthTable();
  DrawTextInPkmovBox(name, "PKMNFNT7", "Crayon4",
    UH_IMAGE_ID_BASE - 4, UH_IMAGE_ID_BASE - 5,
    UH_IMAGE_ID_BASE - 6, UH_IMAGE_ID_BASE - 7,
    0.1, 80.1, 42.1, 158.1);
}


script "DrawBar_Qwant_W" (void) {
  int ball = CheckInventory("QwantBallFlag");
  // Qwant's base bar is direct-source; the mixed move group still takes
  // amount/capacity for the move-only proxy rows.
  Qwant_DrawBar(UHBAR_QWANT, 0, 1);
  SetInventory("SBARAmmoOffset", 1);
  DrawNormalAmmo();
  SetMugshotColor(QWANT_MUG_CYAN, QWANT_MUG_BLUE);
  DrawBar2Color(QWANT_MOVE_BAR2_CYAN, QWANT_MOVE_BAR2_BLUE);
  SetInventory("QwantAlignWepIcon", 1);
  SetHudSize(320, 200, 0);
  InitPkmnf7WidthTable();
  if (ball < 0) {
    ball = 0;
  }
  if (ball > 38) {
    ball = 38;
  }
  DrawTextInPkmovBox(qwant_ballname[ball], "PKMNFNT7", "Crayon4",
    UH_IMAGE_ID_BASE - 4, UH_IMAGE_ID_BASE - 5,
    UH_IMAGE_ID_BASE - 6, UH_IMAGE_ID_BASE - 7,
    0.1, 80.1, 42.1, 158.1);
}

script "DrawBar_FlameWheelWep" (void) {
  if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    FlameWheelWep_DrawBar(UHBAR_FLAMEWHEEL);
  }
}

script "DrawBar_QwantShiny_W" (void) {
  QwantShiny_DrawBar(UHBAR_QWANTSHINY);
  SetInventory("SBARAmmoOffset", 1);
  SetInventory("SBARUseAmmo1Disp", 1);
  SetAmmoAmountAndCapacity("Ammo1Disp", CheckInventory("MyDestinyAmmo"), GetAmmoCapacity("MyDestinyAmmo"));
  DrawNormalAmmo();
}

str uh_nega_fill_wep = "";
str uh_nega_fill_ammo = "";
int uh_nega_fill_max = 0;

function void ResolveNegaManFillAmmo(str wep, int ammoid) {
  if (uh_nega_fill_wep == wep && StrLen(uh_nega_fill_ammo) > 0) {
    return;
  }
  uh_nega_fill_wep = wep;
  uh_nega_fill_ammo = nega_mm_ammo[ammoid];
  uh_nega_fill_max = 28;

  int u = UniqueTID();
  if (SpawnForced(StrParam(s:wep, s:"_NegaManBar"), 0, 0, 0, u, 0)) {
    int custommax = ACS_NamedExecuteWithResult("core_GetActorArg", u, 2);
    if (custommax > 0) {
      str tag = GetActorProperty(u, APROP_Nametag);
      int tagcap = 0;
      if (StrLen(tag) > 0 && GetChar(tag, 0) != 36) {
        tagcap = GetAmmoCapacity(tag);
      }
      if (tagcap > 0) {
        uh_nega_fill_ammo = tag;
        uh_nega_fill_max = tagcap;
      }
    }
    Thing_Remove(u);
  }
}

script "DrawBar_NegaManMove" (int ammoid, int cyan) {
  if (ammoid < 0) {
    ammoid = 0;
  }
  if (ammoid >= NEGA_MM_AMMO_COUNT) {
    ammoid = 0;
  }

  str wep = GetWeapon();
  ResolveNegaManFillAmmo(wep, ammoid);
  DrawBarColorOwned(CheckInventory(uh_nega_fill_ammo), uh_nega_fill_max, cyan, NEGA_BAR_BLUE);
  NegaMan_DrawBar(UHBAR_NEGAMAN_MOVE,
                  CheckInventory("NegaDuckAmmo"), 400);
  SetInventory("SBARAmmoOffset", 2);
  DrawSecondAmmo();
}

script "DrawBar_NegaMan_W" (void) {
  // Bar uses body 192/198 (205/77); mugshot purple is NEGAMAN_DYE 253→95
  SetMugshotColor(95, 77);
  DrawBarColor(4, 204);
  NegaMan_DrawBar(UHBAR_NEGAMAN_BODY, CheckInventory("NegaDuckAmmo"), 400);
  SetInventory("SBARAmmoOffset", 2);
  DrawSecondAmmo();
}

script "DrawBar_NegaTimeStopperWep" (void) {
  DrawBarColor(239, 77);
  NegaMan_DrawBar(UHBAR_NEGAMAN_TIMESTOP, CheckInventory("NegaMM2_Flag"), 1);
  NegaMan_DrawBar(UHBAR_NEGAMAN_MOVE, CheckInventory("NegaDuckAmmo"), 400);
  SetInventory("SBARAmmoOffset", 2);
  DrawSecondAmmo();
}

script "DrawBar_NegaTimeSlowWep" (void) {
  if (CheckInventory("NegaTimeSlowCooldownFlag")) SetDarkenedBar();
}

script "DrawBar_NegaSuperArmWep" (void) {
  if (CheckInventory("ZangiefHoldFlag"))
    SetOverlayBar(CheckInventory("NegaSuperArmHoldTime"), 175);
  else
    SetOverlayBar(0, 175);
}

script "DrawBar_NegaMagmaBazookaWep" (void) {
  if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    if (CheckInventory("WeaponCharge") >= 19) {
      if (Timer() % 2 == 1) {
        DrawBarColor(4, 77);
      }
    } else if (CheckInventory("WeaponCharge") >= 1) {
      if (Timer() % 2 == 1) {
        DrawBarColor(216, 77);
      }
    }
  } else {
    if (CheckInventory("WeaponCharge") >= 19) SetFlashingBar();
  }
}

script "DrawBar_NegaManShiny_W" (void) {
  if (StrICmp(GetWeapon(), "NegaShiny_SuperArm_W") == 0 && CheckInventory("ZangiefHoldFlag"))
    SetOverlayBar(CheckInventory("NegaSuperArmHoldTime"), 175);
  else
    SetOverlayBar(0, 175);
  NegaManShiny_DrawBar(UHBAR_NEGAMANSHINY);
  SetInventory("SBARAmmoOffset", 1);
  SetInventory("SBARUseAmmo1Disp", 1);
  SetAmmoAmountAndCapacity("Ammo1Disp", CheckInventory("S_NegaDuckAmmo"), GetAmmoCapacity("S_NegaDuckAmmo"));
  DrawNormalAmmo();
  str wepicon = "C_I_02B";
  switch (CheckInventory("SNegaFlag")) {
    case 1: wepicon = "THUNSI"; break;
    case 2: wepicon = "FLASHSI"; break;
    case 3: wepicon = "SNAKESI"; break;
    case 4: wepicon = "SKLBSI"; break;
    case 5: wepicon = "GRAVSI"; break;
    case 6: wepicon = "FLMBSI"; break;
    case 7: wepicon = "SCLASI"; break;
    case 8: wepicon = "ICEWAVI"; break;
    case 9: wepicon = "BLAKHOLI"; break;
    case 10: wepicon = "CHILLI"; break;
    case 11: wepicon = "LIGHTNI"; break;
    case 12: wepicon = "BALLSI"; break;
    case 13: wepicon = "GRABBI"; break;
    case 14: wepicon = "TIMMI2"; break;
    case 15: wepicon = "BUBBI"; break;
    case 16: wepicon = "NEEDSI"; break;
    case 17: wepicon = "RAINSI"; break;
    case 18: wepicon = "NAPAI"; break;
    case 19: wepicon = "YAMASI"; break;
    case 20: wepicon = "WCOISI"; break;
    case 21: wepicon = "FLSHBOMI"; break;
    case 22: wepicon = "MAGMAI"; break;
    case 23: wepicon = "BLAWI"; break;
    case 24: wepicon = "IWALL"; break;
    case 25: wepicon = "SCHSWI"; break;
  }
  SetHudSize(320, 200, 0);
  AdjustedImageDisplay(wepicon, wepicon, UH_IMAGE_ID_BASE - 100, UH_IMAGE_ID_BASE - 101, 16.1, 64.1, 50.1, 184.1);
}


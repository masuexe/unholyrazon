script "DrawBar_WispShiny_W" (void) {
  WispShiny_DrawBar(UHBAR_WISPSHINY_SPIRIT);
  SetInventory("SBARAmmoOffset", 1);
  DrawNormalAmmo();
  DrawBar2Color(56, 61);
  if (CheckInventory("PowerWispPortal")) {
    WispShiny_DrawBar(UHBAR_WISPSHINY_HEX);
  }
}

script "DrawBar_Miu_W" (void) {
  if (GetUserCvar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    Miu_DrawBar(UHBAR_MIU_CHARGE, CheckInventory("WeaponCharge"), 20);
  }
  DrawBarColor(161, 248);
  DrawBar2Color(74, 3);
  SetOverlayBar2(CheckInventory("MiuDashFlag"), 28);
}
script "DrawBar_Miu_W2" (void) {
  ACS_NamedExecuteWithResult("DrawBar_Miu_W");
}

script "DrawBar_MiuShiny_W" (void) {
  if (GetUserCvar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    MiuShiny_DrawBar(UHBAR_MIUSHINY_CHARGE, CheckInventory("WeaponCharge"), 20);
  }
  DrawBarColor(248, 164);
  DrawBar2Color(66, 60);
  SetOverlayBar2(CheckInventory("MiuDashFlag"), 28);
}

script "DrawBar_KickChamp_W" (void) {
  DrawBarColor(228, 194);
  if (!CheckInventory("MasterFootAmmo")) {
    SetFlashingBar();
  }
}
script "DrawBar_KickChampShiny_W" (void) {
  DrawBarColor(160, 204);
  if (!CheckInventory("MasterFootAmmo")) {
    SetFlashingBar();
  }
}

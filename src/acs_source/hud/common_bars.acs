function void Func_UH_BarFlags(void) {
  int hp = GetActorHealth(0);
  int maxhp = GetActorMaxHealth(0);
  if (CheckInventory("PlayerPropertyInvulnerable") || (CheckInventory("PlayerPropertyNonshootable") && CheckInventory("PlayerPropertyNoRadiusDmg"))) {
    DrawCustomBarStringHP("0H_I_BAR", "0H_M_BAR", "0H_I_VAR", "0H_M_VAR", hp, maxhp);
  } else {
    int prod = UH_GuardNormalProduct();
    if (prod > 1.0) {
      DrawCustomBarStringHP("0H_W_BAR", "NOBAR", "0H_W_VAR", "VNOBAR", hp, maxhp);
    } else if (prod < 1.0) {
      DrawCustomBarStringHP("0H_R_BAR", "NOBAR", "0H_R_VAR", "VNOBAR", hp, maxhp);
    } else if (CheckInventory("GuardUpFlag")) {
      // Fallback for CBM / addon effects that still Give the flag.
      DrawCustomBarStringHP("0H_R_BAR", "NOBAR", "0H_R_VAR", "VNOBAR", hp, maxhp);
    } else if (CheckInventory("GuardDownFlag")) {
      DrawCustomBarStringHP("0H_W_BAR", "NOBAR", "0H_W_VAR", "VNOBAR", hp, maxhp);
    } else if (CheckInventory("SUDDENLYONFIRE")) {
      DrawCustomBarStringHP("ON_F0BAR", "NOBAR", "ON_F0VAR", "VNOBAR", hp, maxhp);
    }
  }
}

script "DrawBar_ReloadIcon" (void) {
  int u = UniqueTID();
  str wep = GetWeapon();
  if (SpawnForced(StrParam(s:wep, s:"_ReloadIcon"), 0, 0, 0, u, 0)) {
    str tag = GetActorProperty(u, APROP_Nametag);
    Thing_Remove(u);
    if (StrLen(tag) > 0 && GetChar(tag, 0) != 36) {
      DrawReloadIcon(tag);
    }
  }
}

script "DrawBar_Crystrap_W" (void) {
  DrawCrystrapSpyingHud();
}

script "DrawBar_MegamanUShiny_W" (void) {
  int t = Timer() / 5;
  switch (t % 7) {
    case 0:
      DrawBarColor(174, 184);
      break;
    case 1:
      DrawBarColor(219, 221);
      break;
    case 2:
      DrawBarColor(228, 232);
      break;
    case 3:
      DrawBarColor(106, 129);
      break;
    case 4:
      DrawBarColor(204, 206);
      break;
    case 5:
      DrawBarColor(197, 75);
      break;
    case 6:
      DrawBarColor(239, 62);
      break;
  }
}


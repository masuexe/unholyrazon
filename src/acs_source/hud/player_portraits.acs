// Case-insensitive class lookup.  Callers that run per frame must cache the
// result (the table is a linear scan) -- see uh_teaminfo.acs.
function int UH_PortraitIndexForClass(str cls) {
  if (StrLen(cls) == 0) { return -1; }
  for (int i = 0; i < UH_PORTRAIT_COUNT; i++) {
    if (StrICmp(uhPortraitClass[i], cls) == 0) { return i; }
  }
  return -1;
}

function str UH_PortraitTexForIndex(int idx) {
  if (idx < 0 || idx >= UH_PORTRAIT_COUNT) { return ""; }
  return uhPortraitTex[idx];
}

function str UH_PortraitTexForClass(str cls) {
  return UH_PortraitTexForIndex(UH_PortraitIndexForClass(cls));
}

// Scoreboard-only overrides: classes whose DECORATE Player.ScoreIcon is not
// served by the UIX PBMug registry above, so the shared class table (built from
// that registry) would resolve to an empty texture:
//   * LuckyLass             -> UMUG_6_   (ScoreIcon UMUG_6_, PBMug UMUG_6)
//   * EyelentoMajorDemoneye -> I_MUG111  (the Eyelento of Pain morph body; no
//     PBMug_EyelentoMajorDemoneye script exists, but Eyelento.dec sets
//     Player.ScoreIcon I_MUG111 and the MULTITEAM scoreboard must draw a face)
// Keep this list generated from the actual Player.ScoreIcon values rather than
// guessing; a missing entry falls through to the shared table, never to a wrong
// portrait.
#define UH_SCOREICON_OVERRIDE_COUNT 2
str uhScoreIconOverrideClass[UH_SCOREICON_OVERRIDE_COUNT] = { "LuckyLass", "EyelentoMajorDemoneye" };
str uhScoreIconOverrideTex[UH_SCOREICON_OVERRIDE_COUNT] = { "UMUG_6_", "I_MUG111" };

function str UH_ScoreIconOverrideTex(str cls) {
  if (StrLen(cls) == 0) { return ""; }
  for (int i = 0; i < UH_SCOREICON_OVERRIDE_COUNT; i++) {
    if (StrICmp(uhScoreIconOverrideClass[i], cls) == 0) {
      return uhScoreIconOverrideTex[i];
    }
  }
  return "";
}

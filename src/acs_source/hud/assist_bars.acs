script "uh_assist_SuperGUHUItem" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    SetHudSize(320, 200, 0);
    int pos;
    int x; int y;
    SetActivator(0, AAPTR_NULL);

    if (CheckActorInventory(cam, "SuperGuhuDoomFlag") > 0) {
      int maxtimer = CheckGuhuMaxTimer(cam);
      pos = Get_And_Inc_AssistBarCount();
      x = Get_AssistDisplayBar_X(pos);
      y = Get_AssistDisplayBar_Y(pos);

      BasicImageDisplay("SUPGUHU", Get_And_Inc_AssistDisplayID(), x, y);
      int timesec = CheckActorInventory(cam, "SuperGuhuTimer");
      DrawBasicBarAndNumber(
        "AS_TV_MA", "AS_VR_16",
        "AS_TH_MA", "AS_HR_16",
        x, y,
        Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(),
        ((CheckActorInventory(cam, "SuperGuhuTimer") * 8.0 / maxtimer) + 0.5) >> 16,
        CheckActorInventory(cam, "AssistNumberFlag") > 0,
        timesec
      );
    }
  }
}
function int CheckGuhuMaxTimer(int cam) {
  if (CheckActorInventory(cam, "SuperGUHUTune1Flag")) {
    return 405;
  } else if (CheckActorInventory(cam, "SuperGUHUTune2Flag")) {
    return 361;
  } else if (CheckActorInventory(cam, "SuperGUHUTune3Flag")) {
    return 570;
  }
  return 1;
}

script "uh_assist_GoldenWaspBomb" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    SetHudSize(320, 200, 0);
    SetActivator(0, AAPTR_NULL);

    int flag = CheckActorInventory(cam, "GoldenWaspTimer");
    if (flag > 0) {
      int pos = Get_And_Inc_AssistBarCount();
      int x = Get_AssistDisplayBar_X(pos);
      int y = Get_AssistDisplayBar_Y(pos);

      BasicImageDisplay("GOLDWASP", Get_And_Inc_AssistDisplayID(), x, y);
      int timesec = flag;
      DrawBasicBarAndNumber("AS_TV_TB", "AS_VR_16",
                            "AS_TH_TB", "AS_HR_16",
                            x, y,
                            Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(),
                            ((flag * 8.0 / 176) + 0.5) >> 16,
                            CheckActorInventory(cam, "AssistNumberFlag") > 0,
                            timesec);
    }
  }
}

script "uh_assist_DeadlyFireArms" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    SetHudSize(320, 200, 0);
    SetActivator(0, AAPTR_NULL);

    int flag = CheckActorInventory(cam, "DeadlyFireArmsFlag");
    if (flag > 0) {
      int pos = Get_And_Inc_AssistBarCount();
      int x = Get_AssistDisplayBar_X(pos);
      int y = Get_AssistDisplayBar_Y(pos);

      BasicImageDisplay("FIREARM", Get_And_Inc_AssistDisplayID(), x, y);
      int timesec = flag;
      timesec = timesec / 35 + (timesec % 35 > 0);
      DrawBasicBarAndNumber("AS_TV_TF", "AS_VR_16",
                            "AS_TH_TF", "AS_HR_16",
                            x, y,
                            Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(),
                            ((flag * 8.0 / max(flag, 840)) + 0.5) >> 16,
                            CheckActorInventory(cam, "AssistNumberFlag") > 0,
                            timesec);
    }
  }
}


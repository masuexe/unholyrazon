// The Bible is a timed status, independent of Eden's active-item charge bar.
script "uh_assist_EdenBibleFlight" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    DrawAssistTimerBar(cam, "TheBibleFlightFlag", "CI59C033",
                       "ASVS033A", "AS_VR_16",
                       "ASHS033A", "AS_HR_16",
                       180, true);
  }
}

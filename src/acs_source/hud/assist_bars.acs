// Custom Unholy assist bars now feed the v6c modern assist-bar queue through
// the ASSTLIB SetAssistBar* API. This keeps them in the same stack, size and
// icon scale as native v6c entries (for example multi-jump), so icons no
// longer overlap. Icons therefore use the small 16x16 graphics.

function void AssistTimerEntry(int cam, str flag_name, str icon, int max_ticks, bool show_seconds, int cyan, int blue) {
  int flag = CheckActorInventory(cam, flag_name);
  if (flag <= 0) { return; }
  int idx = GetAssistBarID();
  if (idx < 0) { return; }
  SetAssistBarGraphic(idx, icon);
  SetAssistBarBarAmount(idx, flag, max_ticks);
  if (show_seconds) {
    SetAssistBarBarNumber(idx, flag / 35 + (flag % 35 > 0));
  }
  SetAssistBarBarColor(idx, cyan, blue);
}

script "uh_assist_OilSlider" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    // Match the v6c native assist icon: OILBRD normally, OILBROUT when low.
    str icon = "AS_OIL";
    if (CheckActorInventory(cam, "OilSliderFlag") <= 7)
      icon = "AS_OILO";
    AssistTimerEntry(cam, "OilSliderFlag", icon, 30, false, 68, 47);
  }
}

script "uh_assist_SuperGUHUItem" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    AssistTimerEntry(cam, "SuperGuhuDoomFlag", "AS_GUHU", CheckGuhuMaxTimer(cam), false, 176, 186);
  }
}
function int CheckGuhuMaxTimer(int cam) {
  if (CheckActorInventory(cam, "SuperGUHUTune1Flag")) {
    return 405;
  } else if (CheckActorInventory(cam, "SuperGUHUTune2Flag")) {
    return 361;
  } else if (CheckActorInventory(cam, "SuperGUHUTune3Flag")) {
    return 570;
  }
  return 1;
}

script "uh_assist_GoldenWaspBomb" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    AssistTimerEntry(cam, "GoldenWaspTimer", "AS_WASP", 176, false, 228, 163);
  }
}

script "uh_assist_DeadlyFireArms" (int cam) CLIENTSIDE {
  if (AssistDisplayBar_On()) {
    int flag = CheckActorInventory(cam, "DeadlyFireArmsFlag");
    if (flag > 0) {
      AssistTimerEntry(cam, "DeadlyFireArmsFlag", "AS_FIRE", max(flag, 840), true, 172, 223);
    }
  }
}


#library "rz_shared"
#include "zcommon.acs"

script "rz_ForceSpectatePlayer" (int why) {
	str reason = "Cold Dragoon did it";
    switch (why) {
        case 0:
            reason = "Illegal content detected (Needle Cannon)";
            break;
        case 1:
            reason = "Super Megaman can't be defeated!";
            break;
    }
	Delay(1);
	KickFromGame(PlayerNumber(), reason);
}

script "rz_SetPlayerSkin" (int skin) {
    str skinname = "Base";
    switch (skin) {
        case 1:
            skinname = "YustMan";
            break;
    }
    SetPlayerSkin(PlayerNumber(), skinname, 1);
}

script "rz_ClearForcedPlayerSkin" (void) {
	int pn = PlayerNumber();
	if (pn < 0)
		terminate;
	SetPlayerSkin(pn, "", 0);
	TakeInventory("YustManFlag", 1);
}

script "rz_ClearForcedPlayerSkin_Enter" ENTER {
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
}

script "rz_ClearForcedPlayerSkin_Respawn" RESPAWN {
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
}

#library "rz_shared"
#include "zcommon.acs"

script "rz_ForceSpectatePlayer" (int why) {
	str reason = "Cold Dragoon did it";
    switch (why) {
        case 0:
            reason = "Illegal content detected (Needle Cannon)";
            break;
        case 1:
            reason = "Super Megaman can't be defeated!";
            break;
    }
	Delay(1);
	KickFromGame(PlayerNumber(), reason);
}

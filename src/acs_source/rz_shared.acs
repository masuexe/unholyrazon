#library "rz_shared"
#include "zcommon.acs"

script "rz_ForceSpectatePlayer" (int why) {
	str reason = "Cold Dragoon did it";
    switch (why) {
        case 0:
            reason = "Illegal content detected (Needle Cannon)";
            break;
        case 1:
            reason = "Super Megaman can't be defeated!";
            break;
    }
	Delay(1);
	KickFromGame(PlayerNumber(), reason);
}

script "rz_SetPlayerSkin" (int skin) {
    str skinname = "Base";
    switch (skin) {
        case 1:
            skinname = "YustMan";
            break;
    }
    SetPlayerSkin(PlayerNumber(), skinname, 1);
}

script "rz_ClearForcedPlayerSkin" (void) {
	int pn = PlayerNumber();
	if (pn < 0)
		terminate;
	SetPlayerSkin(pn, "", 0);
	TakeInventory("YustManFlag", 1);
	ACS_NamedExecuteWithResult("rz_EdenApplyCSectionSkin");
}

script "rz_ClearForcedPlayerSkin_Enter" ENTER {
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
}

script "rz_ClearForcedPlayerSkin_Respawn" RESPAWN {
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
}

script "rz_ParalyzedStatusWatcher" (void) {
	GiveInventory("PlayerIsParalyzed", 1);
	int ready = CheckInventory("UH_LastReadyDye");
	GiveInventory("NoWeaponTranslation", 1);
	while (CheckInventory("PlayerParalyzedTimer") > 0) {
		if (Timer() % 2 == 0) {
			Thing_SetTranslation(0, 7000); // PARALYZED_DYE
		} else if (ready > 0) {
			Thing_SetTranslation(0, ready);
		}
		TakeInventory("PlayerParalyzedTimer", 1);
		Delay(1);
	}
	TakeInventory("NoWeaponTranslation", 1);
	if (ready > 0) {
		Thing_SetTranslation(0, ready);
		ACS_NamedExecuteWithResult("uh_SyncMugFromWeaponDye", ready);
	}
	// Always unfreeze here: pain states may be interrupted before PlayerParalyzedOff
	ACS_NamedExecuteWithResult("core_freezeplayer", 0, false);
	TakeInventory("PlayerIsParalyzed", 1);
}

#define SMSBIRTHDAY_MAX 6
int smsmember_birthday[SMSBIRTHDAY_MAX] = {
  606,  // SuperMegaman
  604,  // Lin
  110,  // Sapion
  309,  // Floovy
  724,  // TimemanC
  1230  // Shadowman
};
int todaybirthdayid;
script "rz_InitBirthdayMember" OPEN {
  todaybirthdayid = CheckBirthday(SystemTime());
}
script "rz_CheckBirthday" (void) {
  SetResultValue(todaybirthdayid);
}
function int CheckBirthday(int timestamp) {
  int m = GetTimeProperty(timestamp, TM_MONTH) + 1;
  int d = GetTimeProperty(timestamp, TM_DAY);
  int date = m * 100 + d;
  for (int i = 0; i < SMSBIRTHDAY_MAX; i++) {
    if (date == smsmember_birthday[i]) {
      return i;
    }
  }
  return -1;
}

#library "uh_lmsdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla LMS events 0–11 (messages/drops/flags). Music seeds stay in UH_MUSICDEFS.
// Drops bind by stem. OPEN order is not LOADACS order — no actor wait required.

function void UhRegisterVanillaLMSEvents(void)
{
	DefineLMSEvent(0, "lms0",
		"\cgOnly death can save you now...",
		"ITS NO USE! Only death can save you now...",
		"", "", 0, 1);
	AddLMSEventDrop("lms0", "GUHUItem", 1, 0);
	AddLMSEventDrop("lms0", "SuperGUHUItem", 1, 1);

	DefineLMSEvent(1, "lms1",
		"\cfGO FOR BROKE!",
		"\cfGO FOR BROKE! x2!",
		"", "", 0, 1);
	AddLMSEventDrop("lms1", "SuperMysticTankItem", 1, 0);
	AddLMSEventDrop("lms1", "SuperMysticTankItem", 1, 1);
	AddLMSEventDrop("lms1", "PeriwinkleTankItem", 1, 1);

	DefineLMSEvent(2, "lms2",
		"\cgScissors61.exe achieved!",
		"\cdScissors61.exe hacked!",
		"", "", 0, 1);
	AddLMSEventDrop("lms2", "UnholyWaterItem", 1, 0);
	AddLMSEventDrop("lms2", "MountainDewItem", 1, 1);

	DefineLMSEvent(3, "lms3",
		"Only one remains!",
		"Only one chance remains!",
		"", "", 0, 1);
	// Normal fire: no item. Rare: Tank of Wonders.
	AddLMSEventDrop("lms3", "TankOfWondersItem", 1, 1);

	DefineLMSEvent(4, "lms4",
		"\ctWASPS",
		"\cfWASP?!",
		"", "", 0, 1);
	AddLMSEventDrop("lms4", "WaspBombItem", 9, 0);
	AddLMSEventDrop("lms4", "GoldenWaspBombItem", 1, 1);

	DefineLMSEvent(5, "lms5",
		"\ciQuick! Gamble your boxes!",
		"\ciQuick! Gamble your \cfBOX\ci!",
		"", "", 0, 1);
	AddLMSEventDrop("lms5", "PandoraBoxItem", 3, 0);
	AddLMSEventDrop("lms5", "MysticBoxItem", 1, 1);

	DefineLMSEvent(6, "lms6",
		"\chUse every bit of firepower you have!",
		"\chUse every bit of \cfBEES\ch you have!",
		"", "", 0, 1);
	AddLMSEventDrop("lms6", "BluntRocketItem", 12, 0);
	AddLMSEventDrop("lms6", "SharpRocketItem", 2, 0);
	AddLMSEventDrop("lms6", "BEESItem", 3, 1);

	DefineLMSEvent(7, "lms7",
		"\cdSudden magical food! Eat up!",
		"\cdSudden majestical food! Dig in!",
		"", "", 0, 1);
	AddLMSEventDrop("lms7", "PancakeFoodItem", 1, 0);
	AddLMSEventDrop("lms7", "CakeFoodItem", 1, 0);
	AddLMSEventDrop("lms7", "HotdogFoodItem", 1, 0);
	AddLMSEventDrop("lms7", "SundaeFoodItem", 1, 1);
	AddLMSEventDrop("lms7", "HamburgerFoodItem", 1, 1);

	DefineLMSEvent(8, "lms8",
		"\ciThere's no escaping banana!",
		"\csHUT HUT HUT!",
		"", "", 0, 1);
	AddLMSEventDrop("lms8", "RubberBandItem", 1, 0);
	AddLMSEventDrop("lms8", "TheFootBallItem", 1, 1);

	DefineLMSEvent(9, "lms9",
		"\cuFabulous secret powers are revealed to you!",
		"\cuYou have the \cgPOWER\cu!",
		"", "", UHLMS_FLAG_DUALRUNE, 1);
	// Dual-rune only — no item drops.

	DefineLMSEvent(10, "lms10",
		"\csGive them a taste!",
		"\cgYou will... DIE!",
		"", "", 0, 1);
	AddLMSEventDrop("lms10", "HackyCoffeeItem", 1, 0);
	AddLMSEventDrop("lms10", "YouWillDieItem", 1, 1);

	DefineLMSEvent(11, "lms11",
		"\cdHave a quiet life.",
		"\cqH\cdE\cqR\cdE \cqW\cdE \cqG\cdO!",
		"", "", 0, 1);
	AddLMSEventDrop("lms11", "UnholyInsuranceItem", 1, 0);
	AddLMSEventDrop("lms11", "TruePowerItem", 1, 1);
}

script "uh_define_vanilla_lms" OPEN
{
	if (!UHInPlay()) terminate;
	UhRegisterVanillaLMSEvents();
}

script "uh_define_vanilla_lms_cs" OPEN CLIENTSIDE
{
	UhRegisterVanillaLMSEvents();
}

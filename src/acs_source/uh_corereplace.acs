#library "uh_corereplace"
#include "zcommon.acs"
#include "8bdmdefs.acs"

// Player Rune stacker
// Makes sure that players receive the rune that core facilities check for
// Set player to 0 for the activator or specify a player number
//$UH Add Endless Ammo Rune
script "uh_runeplayer" (int player, int toggle, int mode) {
	if (player == 0) { player = PlayerNumber() + 1; } 
	if (player <= 0 || !SetActivatorToPlayer(player - 1)) { terminate; }
	
	str counter;
	str runePower;
	switch (mode) {
		case RUNE_STRENGTH:
			counter = "PlayerPropertyStrength";
			runePower = "PowerDoubleDamageRune";
			break;
		case RUNE_RAGE:
			counter = "PlayerPropertyRage";
			runePower = "PowerDoubleFiringSpeedRune";
			break;
		case RUNE_DRAIN:
			counter = "PlayerPropertyDrain";
			runePower = "PowerDrainRune";
			break;
		case RUNE_SPREAD:
			counter = "PlayerPropertySpread";
			runePower = "PowerSpreadRune";
			break;
		case RUNE_RESISTANCE:
			counter = "PlayerPropertyResistance";
			runePower = "PowerHalfDamageRune";
			break;
		case RUNE_REGENERATION:
			counter = "PlayerPropertyRegeneration";
			runePower = "PowerRegenerationRune";
			break;
		case RUNE_PROSPERITY:
			counter = "PlayerPropertyProsperity";
			runePower = "PowerProsperityRune";
			break;
		case RUNE_REFLECTION:
			counter = "PlayerPropertyReflection";
			runePower = "PowerReflectionRune";
			break;
		case RUNE_HIGHJUMP:
			counter = "PlayerPropertyHighJump";
			runePower = "PowerHighJumpRune";
			break;
		case RUNE_HASTE:
			counter = "PlayerPropertyHaste";
			runePower = "PowerSpeed25Rune";
			break;
        case RUNE_INFINITEAMMO:
            counter = "PlayerPropertyInfiniteAmmo";
            runePower = "PowerInfiniteAmmoRune";
	}
	
	if (toggle >= 1) {
		if (CheckInventory(counter) <= 0) {
			GiveInventory(StrParam(s:runePower, s:"Giver"), 1);
			if (mode == RUNE_REGENERATION) {
				ACS_NamedExecuteWithResult("core_RegenerationRune");
			}
		}
		GiveInventory(counter, 1);
	} else if(CheckInventory(counter) > 0) {
		TakeInventory(counter, 1);

		if (CheckInventory(counter) == 0) {
			TakeInventory(runePower, 999);
		}
	}
}

// Script to check for specific runes on a pointer
script "uh_checkrune" (int rune, int ptr) {
	if (ptr != 0) {
		SetActivator(0, ptr);
	}

	str runePower;
	switch (rune) {
		case RUNE_STRENGTH:
			runePower = "PowerDoubleDamageRune";
			break;
		case RUNE_RAGE:
			runePower = "PowerDoubleFiringSpeedRune";
			break;
		case RUNE_DRAIN:
			runePower = "PowerDrainRune";
			break;
		case RUNE_SPREAD:
			runePower = "PowerSpreadRune";
			break;
		case RUNE_RESISTANCE:
			runePower = "PowerHalfDamageRune";
			break;
		case RUNE_REGENERATION:
			runePower = "PowerRegenerationRune";
			break;
		case RUNE_PROSPERITY:
			runePower = "PowerProsperityRune";
			break;
		case RUNE_REFLECTION:
			runePower = "PowerReflectionRune";
			break;
		case RUNE_HIGHJUMP:
			runePower = "PowerHighJumpRune";
			break;
		case RUNE_HASTE:
			runePower = "PowerSpeed25Rune";
			break;
        case RUNE_INFINITEAMMO:
            runePower = "PowerInfiniteAmmoRune";
            break;
	}

	SetResultValue(CheckInventory(runePower));
}

#define KNK_AIMED 1 << 0//$UH Future core flags?
#define KNK_ADDZTHRUST 1 << 1//$UH
script "uh_knockback" (int force, int forcez, int flags, int ptr)//$UH Changes aimed into a flag
{
	SetActivatorToTarget(0);//$UH Spawned actors are calling this script

	int pX = ACS_NamedExecuteWithResult("core_getactorx", ptr, 0, true);
	int pY = ACS_NamedExecuteWithResult("core_getactory", ptr, 0, true);
    
	int yaw = VectorAngle(GetActorX(0) - pX, GetActorY(0) - pY) >> 8;

	if(flags & KNK_AIMED) {//$UH
		int pitch = ACS_NamedExecuteWithResult("core_GetPtrPitch", ptr, 0, true);
		int heightmul = sin(-pitch);
		int distmul = cos(pitch);

		ThrustThingZ(0, fixedMul(force, heightmul) * 4, 0, (flags & KNK_ADDZTHRUST));//$UH
		ThrustThing(yaw, fixedMul(force, distmul), 1, 0);
	} else {
		ThrustThingZ(0, forcez, 0, (flags & KNK_ADDZTHRUST));//$UH
		ThrustThing(yaw, force, 1, 0);
	}
}

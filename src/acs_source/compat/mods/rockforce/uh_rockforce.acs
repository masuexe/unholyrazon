#library "uh_rockforce"
#include "zcommon.acs"

// For RockForce map support

script "uh_cloakplayer" (int player, int toggle) {
  CloakPlayer(player, toggle);
}

int mmrf_loaded = -1;
function void CloakPlayer(int player, int toggle) {
  if (mmrf_loaded < 0) {
    int u = UniqueTID();
    mmrf_loaded = SpawnForced("CloakedCheck", 0, 0, 0, u, 0);
    Thing_Remove(u);
  }

  if (mmrf_loaded > 0) {
    ACS_NamedExecuteWithResult("mmrf_mp_cloakplayer", player, toggle);
  }
}

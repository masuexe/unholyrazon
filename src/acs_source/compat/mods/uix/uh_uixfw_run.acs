#define UHFW_WHEEL_NAME "uhweaponwheel"
#define UHFW_UIX_WHEEL "weaponwheel"
#define UHFW_IW_LABELPOS -9
#define UHFW_IW_ICONX 8
#define UHFW_IW_ICONY 16
#define UHFW_WW_BARY 96
#define UHFW_WW_BAR2Y 144
#define UHFW_ROUTE_NONE 0
#define UHFW_ROUTE_FIXED 1
#define UHFW_ROUTE_QWANT 2
#define UHFW_ROUTE_NEGA 3
#define UHFW_OWN_NONE 0
#define UHFW_OWN_UH 1
#define UHFW_OWN_UIX 2
#define UHFW_BAR_BLACK "Crayon8"

int uhfw_snapn = 0;
int uhfw_heldn = 0;
int uhfw_metaok = 1;
int uhfw_cancel = 0;
int uhfw_route = UHFW_ROUTE_NONE;
int uhfw_classidx = UHFW_FAIL;
str uhfw_snapclass = "";
str uhfw_snapwep[UHFW_MAX_WEAP];
str uhfw_snaptag[UHFW_MAX_WEAP];
str uhfw_snapicon[UHFW_MAX_WEAP];
str uhfw_snapammo1[UHFW_MAX_WEAP];
str uhfw_snapammo2[UHFW_MAX_WEAP];
int uhfw_amt1[UHFW_MAX_WEAP];
int uhfw_max1[UHFW_MAX_WEAP];
int uhfw_amt2[UHFW_MAX_WEAP];
int uhfw_max2[UHFW_MAX_WEAP];
str uhfw_cyan1[UHFW_MAX_WEAP];
str uhfw_blue1[UHFW_MAX_WEAP];
str uhfw_cyan2[UHFW_MAX_WEAP];
str uhfw_blue2[UHFW_MAX_WEAP];
int uhfw_enabled[UHFW_MAX_WEAP];
int uhww_own = UHFW_OWN_NONE;
int uhww_pn = -1;
int uhww_uix_cancel = 0;

function int UHFW_ActorExists(str which) {
  int u;
  int spawned;

  u = UniqueTID();
  spawned = SpawnForced(which, 0, 0, 0, u, 0);
  if (spawned)
    Thing_Remove(u);
  return spawned;
}

function int UHFW_PlayerOk(void) {
  if (PlayerIsSpectator(PlayerNumber()))
    return 0;
  if (GetActorProperty(0, APROP_Health) <= 0)
    return 0;
  return 1;
}

function void UHFW_ResetOwner(void) {
  uhww_own = UHFW_OWN_NONE;
  uhww_pn = -1;
}

function int UHFW_SubmitSelect(str wep, str serverScript) {
  if (!UHFW_PlayerOk())
    return 0;
  if (StrLen(wep) <= 0 || StrCmp(wep, "") == 0)
    return 0;
  if (CheckInventory(wep) <= 0)
    return 0;

  UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_uixfw: SubmitSelect wep=", s:wep, s:" sv=", s:serverScript));
  GiveInventory("UIX_WeaponSelected_PU", 1);
  NamedSendNetworkString(serverScript, wep);
  return 1;
}

function void UHFW_SnapClear(void) {
  int i;

  uhfw_snapn = 0;
  uhfw_heldn = 0;
  uhfw_metaok = 1;
  uhfw_cancel = 0;
  uhfw_route = UHFW_ROUTE_NONE;
  uhfw_classidx = UHFW_FAIL;
  uhfw_snapclass = "";
  for (i = 0; i < UHFW_MAX_WEAP; i++) {
    uhfw_snapwep[i] = "";
    uhfw_snaptag[i] = "";
    uhfw_snapicon[i] = "";
    uhfw_snapammo1[i] = "";
    uhfw_snapammo2[i] = "";
    uhfw_amt1[i] = 0;
    uhfw_max1[i] = 0;
    uhfw_amt2[i] = 0;
    uhfw_max2[i] = 0;
    uhfw_cyan1[i] = UHFW_BAR_BLACK;
    uhfw_blue1[i] = UHFW_BAR_BLACK;
    uhfw_cyan2[i] = UHFW_BAR_BLACK;
    uhfw_blue2[i] = UHFW_BAR_BLACK;
    uhfw_enabled[i] = 1;
  }
}

function int UHFW_SnapFind(str wep) {
  int i;

  if (StrCmp(wep, "") == 0)
    return UHFW_FAIL;
  for (i = 0; i < uhfw_snapn; i++) {
    if (StrICmp(uhfw_snapwep[i], wep) == 0)
      return i;
  }
  return UHFW_FAIL;
}

function void UHFW_ReadAmmo(int i) {
  str a1;
  str a2;

  a1 = uhfw_snapammo1[i];
  a2 = uhfw_snapammo2[i];
  if (StrLen(a1) != 0) {
    uhfw_amt1[i] = CheckInventory(a1);
    uhfw_max1[i] = GetAmmoCapacity(a1);
  } else {
    uhfw_amt1[i] = 0;
    uhfw_max1[i] = 0;
  }
  if (StrLen(a2) != 0) {
    uhfw_amt2[i] = CheckInventory(a2);
    uhfw_max2[i] = GetAmmoCapacity(a2);
  } else {
    uhfw_amt2[i] = 0;
    uhfw_max2[i] = 0;
  }
}

function str UHFW_Pal(int idx) {
  if (idx < 0)
    return UHFW_BAR_BLACK;
  return StrParam(s:"Crayon", i:idx);
}

function void UHFW_ReadBarColors(int i, str wep) {
  int obj;

  readWeaponBars(wep);
  if (readCyan1 < 0) {
    obj = new(StrParam(s:wep, s:"_ScriptBar"));
    if (obj) {
      readCyan1 = GetActorArg(obj, 0);
      readBlue1 = GetActorArg(obj, 1);
      destroy(obj);
    }
  }
  if (readCyan1 < 0) {
    readCyan1 = 192;
    readBlue1 = 198;
  }
  if (readCyan2 < 0) {
    readCyan2 = 198;
    readBlue2 = 199;
  }
  uhfw_cyan1[i] = UHFW_Pal(readCyan1);
  uhfw_blue1[i] = UHFW_Pal(readBlue1);
  uhfw_cyan2[i] = UHFW_Pal(readCyan2);
  uhfw_blue2[i] = UHFW_Pal(readBlue2);
}

function void UHFW_SnapPush(str wep, str tag, str icon, str ammo1, str ammo2) {
  int i;

  if (uhfw_snapn >= UHFW_MAX_WEAP)
    return;
  i = uhfw_snapn;
  uhfw_snapwep[i] = wep;
  uhfw_snaptag[i] = tag;
  uhfw_snapicon[i] = icon;
  uhfw_snapammo1[i] = ammo1;
  uhfw_snapammo2[i] = ammo2;
  UHFW_ReadAmmo(i);
  if (UHFW_IsMakeAGoodZero(uhfw_snapclass)) {
    int zidx = UHFW_ZeroWeaponIndex(wep);
    if (zidx >= 0 && zidx < 6) {
      if (uhfw_max1[i] <= 0)
        uhfw_max1[i] = uh_zero_bar_max[zidx];
      uhfw_cyan1[i] = UHFW_Pal(uh_zero_bar_cyan[zidx]);
      uhfw_blue1[i] = UHFW_Pal(uh_zero_bar_blue[zidx]);
      uhfw_cyan2[i] = UHFW_BAR_BLACK;
      uhfw_blue2[i] = UHFW_BAR_BLACK;
    } else {
      UHFW_ReadBarColors(i, wep);
    }
  } else {
    UHFW_ReadBarColors(i, wep);
  }
  uhfw_snapn++;
}

function void UHFW_TryHeldTable(int classidx, int i) {
  str wep;

  wep = uhfw_wep[classidx][i][UHFW_STR_WEP];
  if (CheckInventory(wep) <= 0) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_uixfw: not holding ", s:wep));
    return;
  }
  if (UHFW_SnapFind(wep) != UHFW_FAIL)
    return;
  uhfw_heldn++;
  if (uhfw_heldn > UHFW_MAX_WEAP)
    return;
  UHFW_SnapPush(
    wep,
    uhfw_wep[classidx][i][UHFW_STR_TAG],
    uhfw_wep[classidx][i][UHFW_STR_ICON],
    uhfw_wep[classidx][i][UHFW_STR_AMMO1],
    uhfw_wep[classidx][i][UHFW_STR_AMMO2]);
}

function void UHFW_CollectFixed(int classidx) {
  int i;
  int n;

  n = uhfw_classwepcount[classidx];
  for (i = 0; i < n; i++)
    UHFW_TryHeldTable(classidx, i);
}

function void UHFW_CollectSinfulBusterExpert(int classidx) {
  int i;
  str wep;

  uhfw_snapn = 8;
  for (i = 0; i < 8; i++) {
    wep = uhfw_wep[classidx][i][UHFW_STR_WEP];
    uhfw_snapwep[i] = wep;
    uhfw_snaptag[i] = uhfw_wep[classidx][i][UHFW_STR_TAG];
    uhfw_snapicon[i] = uhfw_wep[classidx][i][UHFW_STR_ICON];
    uhfw_snapammo1[i] = uhfw_wep[classidx][i][UHFW_STR_AMMO1];
    uhfw_snapammo2[i] = uhfw_wep[classidx][i][UHFW_STR_AMMO2];
    uhfw_enabled[i] = (CheckInventory(wep) > 0);
    if (uhfw_enabled[i])
      uhfw_heldn++;
    UHFW_ReadAmmo(i);
    if (uhfw_max1[i] <= 0)
      uhfw_max1[i] = uh_sbe_bar_max[i];
    uhfw_cyan1[i] = UHFW_Pal(uh_sbe_bar_cyan[i]);
    uhfw_blue1[i] = UHFW_Pal(uh_sbe_bar_blue[i]);
    uhfw_cyan2[i] = UHFW_BAR_BLACK;
    uhfw_blue2[i] = UHFW_BAR_BLACK;
  }
}

function int UHFW_CurrentSnapIndex(void) {
  int i;

  for (i = 0; i < uhfw_snapn; i++) {
    if (CheckWeapon(uhfw_snapwep[i]))
      return i;
  }
  return 0;
}

function void UHFW_AddBarTriple(int mode, int y, int scale, int alpha, int amt, int mx, str cyan, str blue) {
  addWheelElement("A", "WBAMOHOR", cyan, mode, 0, y, IL_OP_ADD, IL_OP_ADD, 0, 0, scale, alpha, ALIGN_CENTER, ALIGN_CENTER, 160, amt, mx);
  addWheelElement("B", "WBAMOHOR", blue, mode, 0, y, IL_OP_ADD, IL_OP_ADD, 0, 0, scale, alpha, ALIGN_CENTER, ALIGN_CENTER, 160, amt, mx);
  addWheelElement("C", "WBAMOHOR", UHFW_BAR_BLACK, mode, 0, y, IL_OP_ADD, IL_OP_ADD, 0, 0, scale, 1.0, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
}

function void UHFW_AddWheelItemEntry(str wep, int group, str icon, str tag,
  int amt1, int max1, str cyan1, str blue1,
  int amt2, int max2, str cyan2, str blue2,
  int enabled)
{
  int barY;

  addWheelItem(wep, group);
  if (enabled) {
    addWheelElement("A", icon, 0, WHEEL_MODE_UNSELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 0.5, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    addWheelElement("A", "UXICB0", 0, WHEEL_MODE_UNSELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 1.0, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_WW_BARY;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_UNSELECTED, barY, 0.1, 0.5, amt2, max2, cyan2, blue2);
      barY = UHFW_WW_BAR2Y;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_UNSELECTED, barY, 0.1, 0.5, amt1, max1, cyan1, blue1);

    addWheelElement("A", icon, 0, WHEEL_MODE_SELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.5, 1.0, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_WW_BARY;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_SELECTED, barY, 0.15, 1.0, amt2, max2, cyan2, blue2);
      barY = UHFW_WW_BAR2Y;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_SELECTED, barY, 0.15, 1.0, amt1, max1, cyan1, blue1);

    addWheelElement("A", icon, 0, WHEEL_MODE_MIDDLE, UHFW_IW_ICONX, UHFW_IW_ICONY + UHFW_IW_LABELPOS, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.5, 1.0, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    addWheelElement(StrParam(l:tag), "SMALLFNT", "Gold", WHEEL_MODE_MIDDLE, 0, -2 * UHFW_IW_LABELPOS, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 1.0, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_IW_ICONY + UHFW_IW_LABELPOS;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_MIDDLE, barY, 0.15, 1.0, amt2, max2, cyan2, blue2);
      barY = 4 * UHFW_IW_ICONY + UHFW_IW_LABELPOS;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_MIDDLE, barY, 0.15, 1.0, amt1, max1, cyan1, blue1);
  } else {
    addWheelElement("A", icon, 0, WHEEL_MODE_UNSELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 0.25, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    addWheelElement("A", "UXICB0", 0, WHEEL_MODE_UNSELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 0.4, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_WW_BARY;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_UNSELECTED, barY, 0.1, 0.2, 0, max2, UHFW_BAR_BLACK, UHFW_BAR_BLACK);
      barY = UHFW_WW_BAR2Y;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_UNSELECTED, barY, 0.1, 0.2, 0, max1, UHFW_BAR_BLACK, UHFW_BAR_BLACK);

    addWheelElement("A", icon, 0, WHEEL_MODE_SELECTED, UHFW_IW_ICONX, UHFW_IW_ICONY, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.5, 0.4, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_WW_BARY;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_SELECTED, barY, 0.15, 0.3, 0, max2, UHFW_BAR_BLACK, UHFW_BAR_BLACK);
      barY = UHFW_WW_BAR2Y;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_SELECTED, barY, 0.15, 0.3, 0, max1, UHFW_BAR_BLACK, UHFW_BAR_BLACK);

    addWheelElement("A", icon, 0, WHEEL_MODE_MIDDLE, UHFW_IW_ICONX, UHFW_IW_ICONY + UHFW_IW_LABELPOS, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.5, 0.4, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    addWheelElement(StrParam(l:tag), "SMALLFNT", "DarkGrey", WHEEL_MODE_MIDDLE, 0, -2 * UHFW_IW_LABELPOS, IL_OP_ADD, IL_OP_ADD, 0, 0, 1.0, 0.5, ALIGN_CENTER, ALIGN_CENTER, 0, 0, 0);
    barY = UHFW_IW_ICONY + UHFW_IW_LABELPOS;
    if (max2 > 0) {
      UHFW_AddBarTriple(WHEEL_MODE_MIDDLE, barY, 0.15, 0.3, 0, max2, UHFW_BAR_BLACK, UHFW_BAR_BLACK);
      barY = 4 * UHFW_IW_ICONY + UHFW_IW_LABELPOS;
    }
    if (max1 > 0)
      UHFW_AddBarTriple(WHEEL_MODE_MIDDLE, barY, 0.15, 0.3, 0, max1, UHFW_BAR_BLACK, UHFW_BAR_BLACK);
  }
}

// Shared energy adds no per-weapon information to these wheels.
// Keep the inventory metadata intact; this is only a wheel display policy.
function int UHFW_HideSharedEnergyBars(void) {
  if (uhfw_route != UHFW_ROUTE_FIXED)
    return 0;
  return StrICmp(uhfw_snapclass, "Arcanist") == 0
    || StrICmp(uhfw_snapclass, "ArcanistShiny") == 0
    || StrICmp(uhfw_snapclass, "RedWarrior") == 0
    || StrICmp(uhfw_snapclass, "YellowWizard") == 0
    || UHFW_IsBossClass(uhfw_snapclass);
}

function void UHFW_AddSnapItem(int i) {
  int max1 = uhfw_max1[i];
  int max2 = uhfw_max2[i];
  int en = 1;
  if (UHFW_IsSinfulBusterExpert(uhfw_snapclass) || UHFW_IsMakeAGoodZero(uhfw_snapclass)) {
    max2 = 0;
  } else if (UHFW_HideSharedEnergyBars()) {
    max1 = 0;
    max2 = 0;
  }
  if (UHFW_IsSinfulBusterExpert(uhfw_snapclass))
    en = uhfw_enabled[i];
  UHFW_AddWheelItemEntry(
    uhfw_snapwep[i], i,
    uhfw_snapicon[i], uhfw_snaptag[i],
    uhfw_amt1[i], max1, uhfw_cyan1[i], uhfw_blue1[i],
    uhfw_amt2[i], max2, uhfw_cyan2[i], uhfw_blue2[i],
    en);
}

function void UHFW_PatchBarTriple(int item, int el, int amt, int mx) {
  setWheelElementBarAmt(item, el, amt);
  setWheelElementBarMax(item, el, mx);
  setWheelElementBarAmt(item, el + 1, amt);
  setWheelElementBarMax(item, el + 1, mx);
}

function void UHFW_UpdateBarsForItem(int item, int amt1, int max1, int amt2, int max2) {
  int el = 2;
  if (max2 > 0) {
    UHFW_PatchBarTriple(item, el, amt2, max2);
    el += 3;
  }
  if (max1 > 0) {
    UHFW_PatchBarTriple(item, el, amt1, max1);
    el += 3;
  }
  el++;
  if (max2 > 0) {
    UHFW_PatchBarTriple(item, el, amt2, max2);
    el += 3;
  }
  if (max1 > 0) {
    UHFW_PatchBarTriple(item, el, amt1, max1);
    el += 3;
  }
  el += 2;
  if (max2 > 0) {
    UHFW_PatchBarTriple(item, el, amt2, max2);
    el += 3;
  }
  if (max1 > 0)
    UHFW_PatchBarTriple(item, el, amt1, max1);
}

function void UHFW_UpdateItemBars(int i) {
  if (UHFW_IsSinfulBusterExpert(uhfw_snapclass)) {
    if (!uhfw_enabled[i])
      return;
    UHFW_UpdateBarsForItem(i, uhfw_amt1[i], uhfw_max1[i], 0, 0);
    return;
  }
  if (UHFW_IsMakeAGoodZero(uhfw_snapclass)) {
    UHFW_UpdateBarsForItem(i, uhfw_amt1[i], uhfw_max1[i], 0, 0);
    return;
  }
  if (UHFW_HideSharedEnergyBars())
    return;
  UHFW_UpdateBarsForItem(i, uhfw_amt1[i], uhfw_max1[i], uhfw_amt2[i], uhfw_max2[i]);
}

function int UHFW_ShouldCancel(void) {
  int i;

  if (!UHFW_PlayerOk())
    return 1;
  if (StrICmp(GetActorClass(0), uhfw_snapclass) != 0)
    return 1;
  if (UHFW_IsMakeAGoodZero(uhfw_snapclass)) {
    if (!UHFW_IsZeroPhase2())
      return 1;
  }
  if (UHFW_IsSinfulBusterExpert(uhfw_snapclass)) {
    if (CheckInventory("SinfulBusterExpert_W1") <= 0)
      return 1;
    return 0;
  }
  for (i = 0; i < uhfw_snapn; i++) {
    if (CheckInventory(uhfw_snapwep[i]) <= 0)
      return 1;
  }
  return 0;
}

function void UHFW_DoCancel(void) {
  uhfw_cancel = 1;
  if (wheelName != -1) {
    if (StrCmp(wheelName, UHFW_WHEEL_NAME) == 0)
      stopWheel();
  }
}

function int UHFW_RefreshSinfulBusterExpert(void) {
  int i;
  int changed = 0;
  str wep;

  for (i = 0; i < 8; i++) {
    if (!uhfw_enabled[i]) {
      wep = uhfw_snapwep[i];
      if (CheckInventory(wep) > 0) {
        uhfw_enabled[i] = 1;
        UHFW_ReadAmmo(i);
        if (uhfw_max1[i] <= 0)
          uhfw_max1[i] = uh_sbe_bar_max[i];
        setWheelElementAlpha(i, 0, 0.5);
        setWheelElementAlpha(i, 1, 1.0);
        setWheelElementColor(i, 2, uhfw_cyan1[i]);
        setWheelElementAlpha(i, 2, 0.5);
        setWheelElementBarAmt(i, 2, uhfw_amt1[i]);
        setWheelElementBarMax(i, 2, uhfw_max1[i]);
        setWheelElementColor(i, 3, uhfw_blue1[i]);
        setWheelElementAlpha(i, 3, 0.5);
        setWheelElementBarAmt(i, 3, uhfw_amt1[i]);
        setWheelElementBarMax(i, 3, uhfw_max1[i]);
        setWheelElementAlpha(i, 5, 1.0);
        setWheelElementColor(i, 6, uhfw_cyan1[i]);
        setWheelElementAlpha(i, 6, 1.0);
        setWheelElementBarAmt(i, 6, uhfw_amt1[i]);
        setWheelElementBarMax(i, 6, uhfw_max1[i]);
        setWheelElementColor(i, 7, uhfw_blue1[i]);
        setWheelElementAlpha(i, 7, 1.0);
        setWheelElementBarAmt(i, 7, uhfw_amt1[i]);
        setWheelElementBarMax(i, 7, uhfw_max1[i]);
        setWheelElementAlpha(i, 9, 1.0);
        setWheelElementColor(i, 10, "Gold");
        setWheelElementAlpha(i, 10, 1.0);
        setWheelElementColor(i, 11, uhfw_cyan1[i]);
        setWheelElementAlpha(i, 11, 1.0);
        setWheelElementBarAmt(i, 11, uhfw_amt1[i]);
        setWheelElementBarMax(i, 11, uhfw_max1[i]);
        setWheelElementColor(i, 12, uhfw_blue1[i]);
        setWheelElementAlpha(i, 12, 1.0);
        setWheelElementBarAmt(i, 12, uhfw_amt1[i]);
        setWheelElementBarMax(i, 12, uhfw_max1[i]);
        changed = 1;
      }
    }
  }
  return changed;
}

function int UHFW_RefreshAmmo(void) {
  int i;
  int changed;
  int a1;
  int m1;
  int a2;
  int m2;

  if (UHFW_HideSharedEnergyBars() && !UHFW_IsSinfulBusterExpert(uhfw_snapclass) && !UHFW_IsMakeAGoodZero(uhfw_snapclass))
    return 0;
  changed = 0;
  for (i = 0; i < uhfw_snapn; i++) {
    a1 = uhfw_amt1[i];
    m1 = uhfw_max1[i];
    a2 = uhfw_amt2[i];
    m2 = uhfw_max2[i];
    UHFW_ReadAmmo(i);
    if (UHFW_IsSinfulBusterExpert(uhfw_snapclass) && uhfw_max1[i] <= 0)
      uhfw_max1[i] = uh_sbe_bar_max[i];
    if (UHFW_IsMakeAGoodZero(uhfw_snapclass) && uhfw_max1[i] <= 0) {
      int zidx = UHFW_ZeroWeaponIndex(uhfw_snapwep[i]);
      if (zidx >= 0 && zidx < 6)
        uhfw_max1[i] = uh_zero_bar_max[zidx];
    }
    if (uhfw_amt1[i] != a1 || uhfw_max1[i] != m1 || uhfw_amt2[i] != a2 || uhfw_max2[i] != m2) {
      UHFW_UpdateItemBars(i);
      changed = 1;
    }
  }
  return changed;
}

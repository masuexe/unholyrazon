// Per-call scratch only, not a Timer cache. Every camera call overwrites all
// rows it draws, even when two players are viewed during the same tic.
str fixedBarIcons[UHFB_MAX_WEAPONS];
int fixedBarSelected[UHFB_MAX_WEAPONS];
int fixedBarSlots[UHFB_MAX_WEAPONS];
int fixedBarAmt1[UHFB_MAX_WEAPONS];
int fixedBarMax1[UHFB_MAX_WEAPONS];
int fixedBarCyan1[UHFB_MAX_WEAPONS];
int fixedBarBlue1[UHFB_MAX_WEAPONS];

str qwantSlot2Icon[UHQB_MAX_HELD];
int qwantSlot2Amt[UHQB_MAX_HELD];
int qwantSlot2Max[UHQB_MAX_HELD];
int qwantSlot2Cyan[UHQB_MAX_HELD];
int qwantSlot2Blue[UHQB_MAX_HELD];

int negaSlotCount[UHNB_MAX_SLOTS];
int negaSlotSelected[UHNB_MAX_SLOTS];
str negaWepIcon[UHNB_MAX_SLOTS][UHNB_MAX_SLOT_WEAPS];
int negaWepAmt[UHNB_MAX_SLOTS][UHNB_MAX_SLOT_WEAPS];
int negaWepMax[UHNB_MAX_SLOTS][UHNB_MAX_SLOT_WEAPS];
int negaWepCyan[UHNB_MAX_SLOTS][UHNB_MAX_SLOT_WEAPS];
int negaWepBlue[UHNB_MAX_SLOTS][UHNB_MAX_SLOT_WEAPS];

function str weaponBarFontPal(int idx) {
    if(idx <= 0 || idx >= 256)
        return fontPalette[0];
    return fontPalette[idx];
}

function void weaponBarDrawItem(int slot, int weight, int isSelected, str icon, int slotHint,
    int amt1, int max1, int cyan1, int blue1,
    int amt2, int max2, int cyan2, int blue2)
{
    int iconX = weaponBarIconX(slot, weight, isSelected);
    int iconY = weaponBarIconY(slot, weight, isSelected);

    if(!isSelected)
        weaponBarBackground(iconX, iconY);

    weaponBarIcon(icon, iconX, iconY);

    weaponBarSlotHint(slotHint,
        weaponBarIconX(slot, weight, false),
        weaponBarIconY(slot, weight, false),
        isSelected ? "\c[gold]" : "\c[darkgray]");

    if(max2 > 0) {
        drawLayeredBarColor(layer,
            weaponBars[0][cvDir],
            weaponBarFontPal(cyan2),
            weaponBarFontPal(blue2),
            fontPalette[0],
            iconX + barX2,
            iconY + barY2,
            barWidth, barHeight,
            barScale, barScale, cvAlpha,
            amt2, max2,
            !cvDir+1, false, ALIGN_LEFT, ALIGN_TOP);

        if(max1 > 0) {
            drawLayeredBarColor(layer,
                weaponBars[0][cvDir],
                weaponBarFontPal(cyan1),
                weaponBarFontPal(blue1),
                fontPalette[0],
                iconX + barX1,
                iconY + barY1,
                barWidth, barHeight,
                barScale, barScale, cvAlpha,
                amt1, max1,
                !cvDir+1, false, ALIGN_LEFT, ALIGN_TOP);
        }
    } else if(max1 > 0) {
        drawLayeredBarColor(layer,
            weaponBars[0][cvDir],
            weaponBarFontPal(cyan1),
            weaponBarFontPal(blue1),
            fontPalette[0],
            iconX + barX,
            iconY + barY,
            barWidth, barHeight,
            barScale, barScale, cvAlpha,
            amt1, max1,
            !cvDir+1, false, ALIGN_LEFT, ALIGN_TOP);
    }
}

function void weaponBarFixed(int count) {
    int i;
    str actor;
    str ammo1;
    for(i = 0; i < count; i++) {
        fixedBarIcons[i] = "";
        fixedBarSelected[i] = false;
        fixedBarSlots[i] = -1;
        fixedBarAmt1[i] = 0;
        fixedBarMax1[i] = 0;
        fixedBarCyan1[i] = 0;
        fixedBarBlue1[i] = 0;
        actor = ACS_NamedExecuteWithResult("uh_fb_string", i, UHFB_ACTOR);
        if(StrLen(actor) == 0)
            continue;
        if(CheckInventory(actor) <= 0)
            continue;
        fixedBarIcons[i] = ACS_NamedExecuteWithResult("uh_fb_string", i, UHFB_ICON);
        fixedBarSelected[i] = CheckWeapon(actor);
        if(cvShowSlots)
            fixedBarSlots[i] = ACS_NamedExecuteWithResult("uh_fb_slot", i);

        ammo1 = ACS_NamedExecuteWithResult("uh_fb_string", i, UHFB_AMMO1);
        if(StrLen(ammo1) > 0) {
            fixedBarAmt1[i] = CheckInventory(ammo1);
            fixedBarMax1[i] = GetAmmoCapacity(ammo1);
            if(fixedBarMax1[i] <= 0)
                fixedBarMax1[i] = ACS_NamedExecuteWithResult("uh_fb_int", i, UHFB_DEFMAX1);
            fixedBarCyan1[i] = ACS_NamedExecuteWithResult("uh_fb_int", i, UHFB_CYAN1);
            fixedBarBlue1[i] = ACS_NamedExecuteWithResult("uh_fb_int", i, UHFB_BLUE1);
        }
    }

    // Inventory and selection must be read from the camera before releasing it.
    SetActivator(-1);
    for(i = 0; i < count; i++) {
        if(StrLen(fixedBarIcons[i]) == 0)
            continue;
        // Keep definition positions when weapons disappear; never rotate order.
        weaponBarDrawItem(i + 1, 0, fixedBarSelected[i], fixedBarIcons[i], fixedBarSlots[i],
            fixedBarAmt1[i], fixedBarMax1[i], fixedBarCyan1[i], fixedBarBlue1[i],
            0, 0, 0, 0);
    }
    // No ammo, stacking or ROWMAX truncation here.
}

function void weaponBarQwant(void) {
    int i;

    // 1. Read Slot 1 (Qwant_W) from camera player
    int isSlot1Held = (CheckInventory("Qwant_W") > 0);
    int isSlot1Selected = CheckWeapon("Qwant_W");

    str s1Ammo1 = ACS_NamedExecuteWithResult("uh_qb_slot1_string", UHQB_AMMO1);
    str s1Ammo2 = ACS_NamedExecuteWithResult("uh_qb_slot1_string", UHQB_AMMO2);

    int s1Amt1 = (StrLen(s1Ammo1) > 0 ? CheckInventory(s1Ammo1) : 0);
    int s1Max1 = (StrLen(s1Ammo1) > 0 ? GetAmmoCapacity(s1Ammo1) : 0);
    if(s1Max1 <= 0 && StrLen(s1Ammo1) > 0)
        s1Max1 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_DEFMAX1);
    int s1Cyan1 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_CYAN1);
    int s1Blue1 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_BLUE1);

    int s1Amt2 = (StrLen(s1Ammo2) > 0 ? CheckInventory(s1Ammo2) : 0);
    int s1Max2 = (StrLen(s1Ammo2) > 0 ? GetAmmoCapacity(s1Ammo2) : 0);
    if(s1Max2 <= 0 && StrLen(s1Ammo2) > 0)
        s1Max2 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_DEFMAX2);
    int s1Cyan2 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_CYAN2);
    int s1Blue2 = ACS_NamedExecuteWithResult("uh_qb_slot1_int", UHQB_BLUE2);

    // 2. Scan Slot 2 moves from camera player
    int slot2Count = ACS_NamedExecuteWithResult("uh_qb_scan_moves");
    int slot2SelectedWep = ACS_NamedExecuteWithResult("uh_qb_slot2_selected");

    for(i = 0; i < slot2Count && i < UHQB_MAX_HELD; i++) {
        qwantSlot2Icon[i] = ACS_NamedExecuteWithResult("uh_qb_slot2_string", i, UHQB_ICON);
        str ammo = ACS_NamedExecuteWithResult("uh_qb_slot2_string", i, UHQB_AMMO1);
        int cap = 0;
        int amt = 0;
        if(StrLen(ammo) > 0) {
            amt = CheckInventory(ammo);
            cap = GetAmmoCapacity(ammo);
        }
        if(cap <= 0)
            cap = ACS_NamedExecuteWithResult("uh_qb_slot2_int", i, UHQB_DEFMAX1);
        qwantSlot2Amt[i] = amt;
        qwantSlot2Max[i] = cap;
        qwantSlot2Cyan[i] = ACS_NamedExecuteWithResult("uh_qb_slot2_int", i, UHQB_CYAN1);
        qwantSlot2Blue[i] = ACS_NamedExecuteWithResult("uh_qb_slot2_int", i, UHQB_BLUE1);
    }

    // 3. Release camera activator before HUD rendering
    SetActivator(-1);

    int activeSlot = -1;
    if(isSlot1Selected)
        activeSlot = 1;
    else if(slot2SelectedWep >= 0)
        activeSlot = 2;

    // 4. Render Slot 1
    int baseX1 = cvOffsX + slotOffsX * 1;
    int baseY1 = cvOffsY + slotOffsY * 1;
    if(isSlot1Held) {
        int weight1 = (activeSlot == 1 ? -1 : 0);
        weaponBarDrawItem(1, weight1, (activeSlot == 1), "6N01S0", -1,
            s1Amt1, s1Max1, s1Cyan1, s1Blue1,
            s1Amt2, s1Max2, s1Cyan2, s1Blue2);

        SetFont("SMALLFONT");
        weaponBarSlotHint(1, baseX1, baseY1, (activeSlot == 1 ? "\c[gold]" : "\c[darkgray]"));
    }

    // 5. Render Slot 2
    int baseX2 = cvOffsX + slotOffsX * 2;
    int baseY2 = cvOffsY + slotOffsY * 2;
    if(slot2Count > 0) {
        int idx = (activeSlot == 2 ? slot2SelectedWep : -1);
        int maxVisible = min(slot2Count, cvMaxRow + (activeSlot == 2));

        for(i = 0; i < maxVisible; i++) {
            int weap = (idx > -1 ? (i + idx) % slot2Count : i);
            int isSelected = (idx > -1 && weap == slot2SelectedWep);
            int weight = (idx > -1 ? i - 1 : i);
            weaponBarDrawItem(2, weight, isSelected, qwantSlot2Icon[weap], -1,
                qwantSlot2Amt[weap], qwantSlot2Max[weap], qwantSlot2Cyan[weap], qwantSlot2Blue[weap],
                0, 0, 0, 0);
        }

        SetFont("SMALLFONT");
        weaponBarSlotHint(2, baseX2, baseY2, (activeSlot == 2 ? "\c[gold]" : "\c[darkgray]"));

        if(slot2Count > cvMaxRow) {
            displayMessage(layer, UIXWEAP_OverflowNums[slot2Count - i],
                baseX2 + overflowX, baseY2 + overflowY,
                overflowScale, overflowScale, cvAlpha, OverflowHAlign, 0);
        }
    }
}

function void weaponBarNegaMan(void) {
    int activeSlot = ACS_NamedExecuteWithResult("uh_nb_scan");
    int s, h, i;

    for(s = 1; s <= 7; s++) {
        negaSlotCount[s] = ACS_NamedExecuteWithResult("uh_nb_slot_count", s);
        if(negaSlotCount[s] == 0)
            continue;
        negaSlotSelected[s] = ACS_NamedExecuteWithResult("uh_nb_slot_selected", s);
        for(h = 0; h < negaSlotCount[s]; h++) {
            negaWepIcon[s][h] = ACS_NamedExecuteWithResult("uh_nb_item_string", s, h, UHNB_ICON);
            str ammo = ACS_NamedExecuteWithResult("uh_nb_item_string", s, h, UHNB_AMMO);
            int amt = 0;
            int cap = 0;
            if(StrLen(ammo) > 0) {
                amt = CheckInventory(ammo);
                cap = GetAmmoCapacity(ammo);
            }
            if(cap <= 0)
                cap = ACS_NamedExecuteWithResult("uh_nb_item_int", s, h, UHNB_DEFMAX);
            negaWepAmt[s][h] = amt;
            negaWepMax[s][h] = cap;
            negaWepCyan[s][h] = ACS_NamedExecuteWithResult("uh_nb_item_int", s, h, UHNB_CYAN);
            negaWepBlue[s][h] = ACS_NamedExecuteWithResult("uh_nb_item_int", s, h, UHNB_BLUE);
        }
    }

    // Release camera activator before HUD rendering
    SetActivator(-1);

    for(s = 1; s <= 7; s++) {
        if(negaSlotCount[s] == 0)
            continue;

        int baseX = cvOffsX + slotOffsX * s;
        int baseY = cvOffsY + slotOffsY * s;
        int idx = (activeSlot == s ? negaSlotSelected[s] : -1);
        int maxVisible = min(negaSlotCount[s], cvMaxRow + (activeSlot == s));

        for(i = 0; i < maxVisible; i++) {
            int weap = (idx > -1 ? (i + idx) % negaSlotCount[s] : i);
            int isSelected = (idx > -1 && weap == negaSlotSelected[s]);
            int weight = (idx > -1 ? i - 1 : i);
            weaponBarDrawItem(s, weight, isSelected, negaWepIcon[s][weap], -1,
                negaWepAmt[s][weap], negaWepMax[s][weap], negaWepCyan[s][weap], negaWepBlue[s][weap],
                0, 0, 0, 0);
        }

        SetFont("SMALLFONT");
        weaponBarSlotHint(s, baseX, baseY, (activeSlot == s ? "\c[gold]" : "\c[darkgray]"));

        if(negaSlotCount[s] > cvMaxRow) {
            displayMessage(layer, UIXWEAP_OverflowNums[negaSlotCount[s] - i],
                baseX + overflowX, baseY + overflowY,
                overflowScale, overflowScale, cvAlpha, OverflowHAlign, 0);
        }
    }
}

#define UHZB_MAX_HELD 6
str zeroHeldIcon[UHZB_MAX_HELD];
int zeroHeldSelected[UHZB_MAX_HELD];
int zeroHeldAmt1[UHZB_MAX_HELD];
int zeroHeldMax1[UHZB_MAX_HELD];
int zeroHeldCyan1[UHZB_MAX_HELD];
int zeroHeldBlue1[UHZB_MAX_HELD];

function void weaponBarMakeAGoodZero(void) {
    int phase = ACS_NamedExecuteWithResult("uh_zb_phase");
    int count = 0;
    int selectedIdx = -1;
    int i;

    if (phase == 1) {
        if (CheckInventory("MakeAGoodZero_W") > 0) {
            zeroHeldIcon[0] = "B_I_306A";
            zeroHeldSelected[0] = CheckWeapon("MakeAGoodZero_W");
            zeroHeldAmt1[0] = 0;
            zeroHeldMax1[0] = 0;
            zeroHeldCyan1[0] = 0;
            zeroHeldBlue1[0] = 0;
            if (zeroHeldSelected[0])
                selectedIdx = 0;
            count = 1;
        }
    } else if (phase == 3) {
        if (CheckInventory("MakeAGoodZero_W8") > 0) {
            zeroHeldIcon[0] = "B_I_306A";
            zeroHeldSelected[0] = CheckWeapon("MakeAGoodZero_W8");
            zeroHeldAmt1[0] = 0;
            zeroHeldMax1[0] = 0;
            zeroHeldCyan1[0] = 0;
            zeroHeldBlue1[0] = 0;
            if (zeroHeldSelected[0])
                selectedIdx = 0;
            count = 1;
        }
    } else if (phase == 2) {
        if (CheckInventory("MakeAGoodZero_W2") > 0) {
            zeroHeldIcon[count] = "B_I_306A";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W2");
            zeroHeldAmt1[count] = CheckInventory("UnholyPower3000");
            zeroHeldMax1[count] = GetAmmoCapacity("UnholyPower3000");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 3000;
            zeroHeldCyan1[count] = 228;
            zeroHeldBlue1[count] = 227;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
        if (CheckInventory("MakeAGoodZero_W3") > 0) {
            zeroHeldIcon[count] = "B_I_306B";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W3");
            zeroHeldAmt1[count] = CheckInventory("MGZeroChipAmmoCutter");
            zeroHeldMax1[count] = GetAmmoCapacity("MGZeroChipAmmoCutter");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 1200;
            zeroHeldCyan1[count] = 87;
            zeroHeldBlue1[count] = 93;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
        if (CheckInventory("MakeAGoodZero_W4") > 0) {
            zeroHeldIcon[count] = "B_I_306C";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W4");
            zeroHeldAmt1[count] = CheckInventory("MGZeroChipAmmoFlame");
            zeroHeldMax1[count] = GetAmmoCapacity("MGZeroChipAmmoFlame");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 1200;
            zeroHeldCyan1[count] = 201;
            zeroHeldBlue1[count] = 219;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
        if (CheckInventory("MakeAGoodZero_W5") > 0) {
            zeroHeldIcon[count] = "B_I_306D";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W5");
            zeroHeldAmt1[count] = CheckInventory("MGZeroChipAmmoIcicle");
            zeroHeldMax1[count] = GetAmmoCapacity("MGZeroChipAmmoIcicle");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 1200;
            zeroHeldCyan1[count] = 215;
            zeroHeldBlue1[count] = 205;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
        if (CheckInventory("MakeAGoodZero_W6") > 0) {
            zeroHeldIcon[count] = "B_I_306E";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W6");
            zeroHeldAmt1[count] = CheckInventory("MGZeroChipAmmoZap");
            zeroHeldMax1[count] = GetAmmoCapacity("MGZeroChipAmmoZap");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 1200;
            zeroHeldCyan1[count] = 32;
            zeroHeldBlue1[count] = 229;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
        if (CheckInventory("MakeAGoodZero_W7") > 0) {
            zeroHeldIcon[count] = "B_I_306F";
            zeroHeldSelected[count] = CheckWeapon("MakeAGoodZero_W7");
            zeroHeldAmt1[count] = CheckInventory("MGZeroChipAmmoPsycho");
            zeroHeldMax1[count] = GetAmmoCapacity("MGZeroChipAmmoPsycho");
            if (zeroHeldMax1[count] <= 0)
                zeroHeldMax1[count] = 1200;
            zeroHeldCyan1[count] = 108;
            zeroHeldBlue1[count] = 239;
            if (zeroHeldSelected[count])
                selectedIdx = count;
            count++;
        }
    }

    SetActivator(-1);

    if (count <= 0)
        return;

    int baseX = cvOffsX + slotOffsX * 1;
    int baseY = cvOffsY + slotOffsY * 1;
    int maxVisible = min(count, cvMaxRow + (selectedIdx >= 0));

    for (i = 0; i < maxVisible; i++) {
        int weap = (selectedIdx > -1 ? (i + selectedIdx) % count : i);
        int isSelected = (selectedIdx > -1 && weap == selectedIdx);
        int weight = (selectedIdx > -1 ? i - 1 : i);
        weaponBarDrawItem(1, weight, isSelected, zeroHeldIcon[weap], -1,
            zeroHeldAmt1[weap], zeroHeldMax1[weap], zeroHeldCyan1[weap], zeroHeldBlue1[weap],
            0, 0, 0, 0);
    }

    if (count > cvMaxRow) {
        displayMessage(layer, UIXWEAP_OverflowNums[count - i],
            baseX + overflowX, baseY + overflowY,
            overflowScale, overflowScale, cvAlpha, OverflowHAlign, 0);
    }
}


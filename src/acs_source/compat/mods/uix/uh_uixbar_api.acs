// Read-only uh_uixfw -> UIXWEAP protocol. No wheel indices or gameplay writes.
// uh_fb_slot(row) returns a real slot solely for binding hints (-1 if invalid).
#define UHFB_UNSUPPORTED -1
#define UHFB_NOT_READY -2
#define UHFB_MAX_WEAPONS 6
#define UHFB_ACTOR 0
#define UHFB_ICON 1

// Qwant weapon bar definitions.
#define UHQB_UNSUPPORTED -1
#define UHQB_NOT_READY -2
#define UHQB_MAX_WEAPONS 5
#define UHQB_MAX_HELD 8
#define UHQB_MOVE_COUNT 35

#define UHQB_ACTOR 0
#define UHQB_ICON 1
#define UHQB_AMMO1 2
#define UHQB_AMMO2 3

#define UHQB_CYAN1 0
#define UHQB_BLUE1 1
#define UHQB_CYAN2 2
#define UHQB_BLUE2 3
#define UHQB_DEFMAX1 4
#define UHQB_DEFMAX2 5


// Dynamic Qwant wheel: synchronized inventory is the move list.
// Base weapon owns group 0; copy moves use up to 11 other scrollable groups.
#define UHFW_UHCOPY_QWANT 2
#define UHFW_QW_MAX_WEAP 257
#define UHFW_QW_CACHE 257
#define UHFW_QW_WAIT 35
#define UHFW_QW_GROUPS 12
#define UHFW_QW_MIN_WEAP 2
#define UHFW_QW_TYPE_N 18
#define UHFW_QW_BAR2_C 138
#define UHFW_QW_BAR2_B 130
#define UHFW_QW_BODY_C 138
#define UHFW_QW_BODY_B 130

int uhqw_cn = 0;
str uhqw_cwep[UHFW_QW_CACHE];
str uhqw_ctag[UHFW_QW_CACHE];
str uhqw_cicon[UHFW_QW_CACHE];
str uhqw_cammo[UHFW_QW_CACHE];
int uhqw_cmax[UHFW_QW_CACHE];
int uhqw_ctype[UHFW_QW_CACHE];
int uhqw_ccyan[UHFW_QW_CACHE];
int uhqw_cblue[UHFW_QW_CACHE];

str uhqw_typeammo[UHFW_QW_TYPE_N] = {
  "NormalTypeAmmo",
  "FireTypeAmmo",
  "WaterTypeAmmo",
  "ElectricTypeAmmo",
  "GrassTypeAmmo",
  "IceTypeAmmo",
  "FightingTypeAmmo",
  "PoisonTypeAmmo",
  "GroundTypeAmmo",
  "FlyingTypeAmmo",
  "PsychicTypeAmmo",
  "BugTypeAmmo",
  "RockTypeAmmo",
  "GhostTypeAmmo",
  "DragonTypeAmmo",
  "DarkTypeAmmo",
  "SteelTypeAmmo",
  "FairyTypeAmmo"
};

int uhqw_typecyan[UHFW_QW_TYPE_N] = {
  4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4
};

int uhqw_typeblue[UHFW_QW_TYPE_N] = {
  144, 176, 198, 228, 129, 196, 220, 251, 232, 205, 39, 139, 166, 60, 43, 95, 152, 35
};

function int UHFW_IsPlainQwant(void) {
  if (StrICmp(GetActorClass(0), "Qwant") == 0)
    return 1;
  return 0;
}

function str UHFW_QwantActor(int idx) {
  return ACS_NamedExecuteWithResult("uh_copykind_actor", UHFW_UHCOPY_QWANT, idx);
}

function int UHFW_QwantTypeMax(int type) {
  if (type == 10 || type == 14 || type == 17)
    return 56;
  return 28;
}

function str UHFW_QwantTypeIcon(int type) {
  if (type == 1)
    return "6N01B0";
  if (type == 2)
    return "6N01C0";
  if (type == 3)
    return "6N01D0";
  if (type == 4)
    return "6N01E0";
  if (type == 5)
    return "6N01F0";
  if (type == 6)
    return "6N01G0";
  if (type == 7)
    return "6N01H0";
  if (type == 8)
    return "6N01I0";
  if (type == 9)
    return "6N01J0";
  if (type == 10)
    return "6N01K0";
  if (type == 11)
    return "6N01L0";
  if (type == 12)
    return "6N01M0";
  if (type == 13)
    return "6N01N0";
  if (type == 14)
    return "6N01O0";
  if (type == 15)
    return "6N01P0";
  if (type == 16)
    return "6N01Q0";
  if (type == 17)
    return "6N01R0";
  return "6N01A0";
}

function str UHFW_QwantTagOf(str wep, int tid) {
  str tag;
  int len;

  tag = GetActorProperty(tid, APROP_Nametag);
  if (StrLen(tag) > 0) {
    if (GetChar(tag, 0) == 36)
      return StrMid(tag, 1, StrLen(tag) - 1);
    return tag;
  }
  len = StrLen(wep);
  if (len >= 3) {
    if (StrCmp(StrRight(wep, 3), "Wep") == 0)
      wep = StrLeft(wep, len - 3);
  }
  return StrParam(s:"TAG_", s:wep);
}

function int UHFW_QwantCacheFind(str wep) {
  int i;

  for (i = 0; i < uhqw_cn; i++) {
    if (StrICmp(uhqw_cwep[i], wep) == 0)
      return i;
  }
  return UHFW_FAIL;
}

function int UHFW_QwantCacheWep(str wep) {
  int i;
  int u;
  int bu;
  int type;
  int custom;
  int tagcap;
  str tag;
  str ammo;
  int mx;

  i = UHFW_QwantCacheFind(wep);
  if (i != UHFW_FAIL)
    return i;
  if (uhqw_cn >= UHFW_QW_CACHE)
    return UHFW_FAIL;

  i = uhqw_cn;
  uhqw_cwep[i] = wep;
  uhqw_ctag[i] = "";
  uhqw_cicon[i] = "";
  uhqw_cammo[i] = "";
  uhqw_cmax[i] = 0;
  uhqw_ctype[i] = 0;
  uhqw_ccyan[i] = UHFW_QW_BODY_C;
  uhqw_cblue[i] = UHFW_QW_BODY_B;

  if (StrICmp(wep, "Qwant_W") == 0) {
    uhqw_ctag[i] = "TAG_Qwant_W";
    uhqw_cicon[i] = "6N01S0";
    uhqw_cammo[i] = "MoveRelearnAmmo";
    uhqw_cmax[i] = 28;
    uhqw_ccyan[i] = UHFW_QW_BAR2_C;
    uhqw_cblue[i] = UHFW_QW_BAR2_B;
    uhqw_cn++;
    return i;
  }

  u = UniqueTID();
  if (!SpawnForced(wep, 0, 0, 0, u, 0))
    return UHFW_FAIL;
  uhqw_ctag[i] = UHFW_QwantTagOf(wep, u);
  Thing_Remove(u);

  type = 0;
  ammo = uhqw_typeammo[0];
  mx = UHFW_QwantTypeMax(0);
  bu = UniqueTID();
  if (SpawnForced(StrParam(s:wep, s:"_QwantBar"), 0, 0, 0, bu, 0)) {
    type = ACS_NamedExecuteWithResult("core_GetActorArg", bu, 0);
    if (type < 0 || type >= UHFW_QW_TYPE_N)
      type = 0;
    ammo = uhqw_typeammo[type];
    mx = UHFW_QwantTypeMax(type);
    custom = ACS_NamedExecuteWithResult("core_GetActorArg", bu, 1);
    if (custom > 0) {
      tag = GetActorProperty(bu, APROP_Nametag);
      tagcap = 0;
      if (StrLen(tag) > 0) {
        if (GetChar(tag, 0) != 36)
          tagcap = GetAmmoCapacity(tag);
      }
      if (tagcap > 0) {
        ammo = tag;
        mx = tagcap;
      }
    }
    Thing_Remove(bu);
  }
  uhqw_ctype[i] = type;
  uhqw_cammo[i] = ammo;
  uhqw_cmax[i] = mx;
  uhqw_cicon[i] = UHFW_QwantTypeIcon(type);
  uhqw_ccyan[i] = uhqw_typecyan[type];
  uhqw_cblue[i] = uhqw_typeblue[type];
  uhqw_cn++;
  return i;
}

int uhqwd_snapn = 0;
int uhqwd_groupcount = 0;
int uhqwd_metaok = 1;
str uhqwd_snapwep[UHFW_QW_MAX_WEAP];
str uhqwd_snaptag[UHFW_QW_MAX_WEAP];
str uhqwd_snapicon[UHFW_QW_MAX_WEAP];
str uhqwd_snapammo1[UHFW_QW_MAX_WEAP];
str uhqwd_snapammo2[UHFW_QW_MAX_WEAP];
int uhqwd_amt1[UHFW_QW_MAX_WEAP];
int uhqwd_max1[UHFW_QW_MAX_WEAP];
int uhqwd_amt2[UHFW_QW_MAX_WEAP];
int uhqwd_max2[UHFW_QW_MAX_WEAP];
str uhqwd_cyan1[UHFW_QW_MAX_WEAP];
str uhqwd_blue1[UHFW_QW_MAX_WEAP];
str uhqwd_cyan2[UHFW_QW_MAX_WEAP];
str uhqwd_blue2[UHFW_QW_MAX_WEAP];
int uhqwd_group[UHFW_QW_MAX_WEAP];
int uhqwd_can[UHFW_QW_MAX_WEAP];

function void UHFW_QwantSnapClear(void) {
  int i;

  uhqwd_snapn = 0;
  uhqwd_groupcount = 0;
  uhqwd_metaok = 1;
  for (i = 0; i < UHFW_QW_MAX_WEAP; i++) {
    uhqwd_snapwep[i] = "";
    uhqwd_snaptag[i] = "";
    uhqwd_snapicon[i] = "";
    uhqwd_snapammo1[i] = "";
    uhqwd_snapammo2[i] = "";
    uhqwd_amt1[i] = 0;
    uhqwd_max1[i] = 0;
    uhqwd_amt2[i] = 0;
    uhqwd_max2[i] = 0;
    uhqwd_cyan1[i] = UHFW_BAR_BLACK;
    uhqwd_blue1[i] = UHFW_BAR_BLACK;
    uhqwd_cyan2[i] = UHFW_BAR_BLACK;
    uhqwd_blue2[i] = UHFW_BAR_BLACK;
    uhqwd_group[i] = 0;
    uhqwd_can[i] = 0;
  }
}

function int UHFW_QwantSnapFind(str wep) {
  int i;

  if (StrCmp(wep, "") == 0)
    return UHFW_FAIL;
  for (i = 0; i < uhqwd_snapn; i++) {
    if (StrICmp(uhqwd_snapwep[i], wep) == 0)
      return i;
  }
  return UHFW_FAIL;
}

function void UHFW_QwantReadAmmo(int i) {
  str ammo = uhqwd_snapammo1[i];
  int cached = UHFW_QwantCacheFind(uhqwd_snapwep[i]);
  uhqwd_amt1[i] = 0;
  uhqwd_max1[i] = 0;
  uhqwd_amt2[i] = 0;
  uhqwd_max2[i] = 0;
  if (StrLen(ammo) > 0) {
    uhqwd_amt1[i] = CheckInventory(ammo);
    uhqwd_max1[i] = GetAmmoCapacity(ammo);
    if (uhqwd_max1[i] <= 0 && cached != UHFW_FAIL)
      uhqwd_max1[i] = uhqw_cmax[cached];
  }
}

function void UHFW_QwantSnapPush(str wep, int group) {
  int i;
  int c;

  if (uhqwd_snapn >= UHFW_QW_MAX_WEAP)
    return;
  c = UHFW_QwantCacheWep(wep);
  if (c == UHFW_FAIL) {
    uhqwd_metaok = 0;
    return;
  }
  i = uhqwd_snapn;
  uhqwd_snapwep[i] = wep;
  uhqwd_snaptag[i] = uhqw_ctag[c];
  uhqwd_snapicon[i] = uhqw_cicon[c];
  uhqwd_snapammo1[i] = uhqw_cammo[c];
  uhqwd_snapammo2[i] = "";
  uhqwd_amt1[i] = 0;
  uhqwd_max1[i] = uhqw_cmax[c];
  uhqwd_amt2[i] = 0;
  uhqwd_max2[i] = 0;
  uhqwd_cyan1[i] = UHFW_Pal(uhqw_ccyan[c]);
  uhqwd_blue1[i] = UHFW_Pal(uhqw_cblue[c]);
  uhqwd_cyan2[i] = UHFW_BAR_BLACK;
  uhqwd_blue2[i] = UHFW_BAR_BLACK;
  uhqwd_group[i] = group;
  uhqwd_can[i] = 1;
  UHFW_QwantReadAmmo(i);
  uhqwd_snapn++;
}

function int UHFW_QwantCollect(void) {
  int registered;
  int group;
  str weapon;
  UHFW_QwantSnapClear();
  if (!CheckInventory("Qwant_W"))
    return 0;
  registered = ACS_NamedExecuteWithResult("uh_copykind_count", UHFW_UHCOPY_QWANT);
  if (registered <= 0)
    return 0;
  UHFW_QwantSnapPush("Qwant_W", 0);
  for (int i = 0; i < registered; i++) {
    weapon = UHFW_QwantActor(i);
    if (StrLen(weapon) == 0 || !CheckInventory(weapon) || UHFW_QwantSnapFind(weapon) != UHFW_FAIL)
      continue;
    group = 1 + ((uhqwd_snapn - 1) % (UHFW_QW_GROUPS - 1));
    UHFW_QwantSnapPush(weapon, group);
  }
  uhqwd_groupcount = min(uhqwd_snapn, UHFW_QW_GROUPS);
  return uhqwd_snapn;
}

function int UHFW_QwantCurrentSnapIndex(void) {
  int i;

  for (i = 0; i < uhqwd_snapn; i++) {
    if (CheckWeapon(uhqwd_snapwep[i]))
      return i;
  }
  return 0;
}

function void UHFW_QwantPaintItems(void) {
  int i;

  emptyWheel();
  WHEEL_GROUPS = uhqwd_groupcount;
  for (i = 0; i < uhqwd_snapn; i++) {
    UHFW_AddWheelItemEntry(
      uhqwd_snapwep[i], uhqwd_group[i],
      uhqwd_snapicon[i], uhqwd_snaptag[i],
      uhqwd_amt1[i], uhqwd_max1[i], uhqwd_cyan1[i], uhqwd_blue1[i],
      uhqwd_amt2[i], uhqwd_max2[i], uhqwd_cyan2[i], uhqwd_blue2[i],
      uhqwd_can[i]);
  }
}

function int UHFW_OpenQwant(void) {
  int cur;
  int collected;

  if (wheelName != -1)
    return -1;

  collected = UHFW_QwantCollect();
  if (collected < UHFW_QW_MIN_WEAP || !uhqwd_metaok) {
    UHFW_QwantSnapClear();
    UHFW_ResetOwner();
    return -1;
  }

  uhfw_route = UHFW_ROUTE_QWANT;
  uhfw_snapclass = "Qwant";
  uhfw_cancel = 0;
  uhww_own = UHFW_OWN_UH;
  uhww_pn = PlayerNumber();

  cur = UHFW_QwantCurrentSnapIndex();
  newWheel(UHFW_WHEEL_NAME, uhqwd_groupcount, cur);
  UHFW_QwantPaintItems();
  startWheel("uh_ww_tick", "uh_ww_select");
  return 1;
}

function void UHFW_QwantTick(void) {
  int i;
  int held;
  int statusChanged;
  int a1;
  int m1;
  int a2;
  int m2;

  if (!UHFW_PlayerOk() || !UHFW_IsPlainQwant()) {
    UHFW_DoCancel();
    return;
  }

  int currentHeld = 0;
  int registered = ACS_NamedExecuteWithResult("uh_copykind_count", UHFW_UHCOPY_QWANT);
  if (CheckInventory("Qwant_W"))
    currentHeld++;
  for (i = 0; i < registered; i++) {
    str candidate = UHFW_QwantActor(i);
    if (CheckInventory(candidate)) {
      currentHeld++;
      if (UHFW_QwantSnapFind(candidate) == UHFW_FAIL) {
        UHFW_DoCancel();
        return;
      }
    }
  }
  if (currentHeld != uhqwd_snapn) {
    UHFW_DoCancel();
    return;
  }
  statusChanged = 0;

  for (i = 0; i < uhqwd_snapn; i++) {
    held = (CheckInventory(uhqwd_snapwep[i]) > 0);
    if (held != uhqwd_can[i]) {
      uhqwd_can[i] = held;
      statusChanged = 1;
    }

    a1 = uhqwd_amt1[i];
    m1 = uhqwd_max1[i];
    a2 = uhqwd_amt2[i];
    m2 = uhqwd_max2[i];
    UHFW_QwantReadAmmo(i);

    // If capacity changed, layout elements need rebuild
    if (uhqwd_max1[i] != m1 || uhqwd_max2[i] != m2) {
      statusChanged = 1;
    } else if (uhqwd_amt1[i] != a1 || uhqwd_amt2[i] != a2) {
      UHFW_UpdateBarsForItem(i, uhqwd_amt1[i], uhqwd_max1[i], uhqwd_amt2[i], uhqwd_max2[i]);
    }
  }

  if (statusChanged) {
    UHFW_QwantPaintItems();
  }
}

function void UHFW_QwantSelect(int idx) {
  str wep;

  if (uhfw_cancel)
    return;
  if (idx < 0 || idx >= uhqwd_snapn)
    return;
  if (!uhqwd_can[idx])
    return;

  wep = uhqwd_snapwep[idx];
  if (CheckInventory(wep) <= 0)
    return;

  UHFW_SubmitSelect(wep, "uh_qw_sel_sv");
}

script "uh_qw_sel_sv" (int wep) NET {
  int i;
  int ncount;
  str cand;
  int allowed;

  if (!UHFW_IsPlainQwant())
    terminate;
  if (!UHFW_PlayerOk())
    terminate;
  if (StrCmp(wep, "") == 0)
    terminate;

  allowed = 0;
  if (StrICmp(wep, "Qwant_W") == 0) {
    allowed = 1;
  } else {
    ncount = ACS_NamedExecuteWithResult("uh_copykind_count", UHFW_UHCOPY_QWANT);
    for (i = 0; i < ncount; i++) {
      cand = ACS_NamedExecuteWithResult("uh_copykind_actor", UHFW_UHCOPY_QWANT, i);
      if (StrICmp(cand, wep) == 0) {
        allowed = 1;
        break;
      }
    }
  }

  if (!allowed) {
    UH_Log(UH_LOG_WARN, StrParam(s:"uh_uixfw: invalid Qwant weapon select: ", s:wep));
    terminate;
  }

  if (CheckInventory(wep) <= 0) {
    UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_uixfw: Qwant weapon not held at select: ", s:wep));
    terminate;
  }

  if (!SetWeapon(wep)) {
    UH_Log(UH_LOG_WARN, StrParam(s:"uh_uixfw: SetWeapon failed for: ", s:wep));
  }
}

int uhqw_held_count = 0;
int uhqw_held_moves[UHFW_QW_MAX_WEAP - 1];
int uhqw_held_selected = -1;

script "uh_qb_count" (void) {
  if (StrICmp(GetActorClass(0), "Qwant") != 0) {
    SetResultValue(UHQB_UNSUPPORTED);
    terminate;
  }
  if (CheckInventory("Qwant_W") <= 0) {
    SetResultValue(UHQB_NOT_READY);
    terminate;
  }
  SetResultValue(2);
}

script "uh_qb_scan_moves" (void) {
  int i;
  int count = 0;
  uhqw_held_selected = -1;
  int registered = ACS_NamedExecuteWithResult("uh_copykind_count", UHFW_UHCOPY_QWANT);
  for (i = 0; i < registered; i++) {
    str wep = UHFW_QwantActor(i);
    if (CheckInventory(wep) > 0) {
      if (CheckWeapon(wep))
        uhqw_held_selected = count;
      if (count < UHFW_QW_MAX_WEAP - 1) {
        uhqw_held_moves[count] = i;
        count++;
      }
    }
  }
  uhqw_held_count = count;
  SetResultValue(count);
}

script "uh_qb_slot2_selected" (void) {
  SetResultValue(uhqw_held_selected);
}

script "uh_qb_slot2_string" (int heldIdx, int field) {
  str val = "";
  if (heldIdx >= 0 && heldIdx < uhqw_held_count) {
    int moveIdx = uhqw_held_moves[heldIdx];
    str wep = UHFW_QwantActor(moveIdx);
    int c = UHFW_QwantCacheWep(wep);
    if (c != UHFW_FAIL) {
      if (field == UHQB_ACTOR)
        val = wep;
      else if (field == UHQB_ICON)
        val = uhqw_cicon[c];
      else if (field == UHQB_AMMO1)
        val = uhqw_cammo[c];
      else if (field == UHQB_AMMO2)
        val = "";
    }
  }
  SetResultValue(StrParam(s:val));
}

script "uh_qb_slot2_int" (int heldIdx, int field) {
  int ival = 0;
  if (heldIdx >= 0 && heldIdx < uhqw_held_count) {
    int moveIdx = uhqw_held_moves[heldIdx];
    str wep = UHFW_QwantActor(moveIdx);
    int c = UHFW_QwantCacheWep(wep);
    if (c != UHFW_FAIL) {
      if (field == UHQB_CYAN1)
        ival = uhqw_ccyan[c];
      else if (field == UHQB_BLUE1)
        ival = uhqw_cblue[c];
      else if (field == UHQB_CYAN2)
        ival = 0;
      else if (field == UHQB_BLUE2)
        ival = 0;
      else if (field == UHQB_DEFMAX1)
        ival = uhqw_cmax[c];
      else if (field == UHQB_DEFMAX2)
        ival = 0;
    }
  }
  SetResultValue(ival);
}

script "uh_qb_slot1_string" (int field) {
  str sval = "";
  if (field == UHQB_ACTOR)
    sval = "Qwant_W";
  else if (field == UHQB_ICON)
    sval = "6N01S0";
  else if (field == UHQB_AMMO1)
    sval = "MoveRelearnAmmo";
  else if (field == UHQB_AMMO2)
    sval = "";
  SetResultValue(StrParam(s:sval));
}

script "uh_qb_slot1_int" (int field) {
  int sival = 0;
  if (field == UHQB_CYAN1)
    sival = UHFW_QW_BAR2_C;
  else if (field == UHQB_BLUE1)
    sival = UHFW_QW_BAR2_B;
  else if (field == UHQB_CYAN2)
    sival = 0;
  else if (field == UHQB_BLUE2)
    sival = 0;
  else if (field == UHQB_DEFMAX1)
    sival = 28;
  else if (field == UHQB_DEFMAX2)
    sival = 0;
  SetResultValue(sival);
}

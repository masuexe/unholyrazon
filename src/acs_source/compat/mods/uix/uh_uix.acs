function void UH_UIX_RegisterItems(void) {
	int fail;

	fail = 0;
	fail += UH_UIX_RegA();
	fail += UH_UIX_RegB();
	fail += UH_UIX_RegC();
	if (fail) {
		UH_Log(UH_LOG_WARN, StrParam(
			s:"uh_uix: DefineAssistItem failed for ",
			i:fail,
			s:" item(s)"));
		return;
	}
	UH_Log(UH_LOG_INFO, "uh_uix: registered 88 Unholy items");
}

#include "uh_uix_megaweps.acs"

script "uh_uix_register_items" OPEN CLIENTSIDE {
	if (!UH_UIX_ActorExists("UIX_ItemSelected_PU"))
		terminate;

	UH_UIX_RegisterItems();
	UH_UIX_RegisterMegaWeps();
}

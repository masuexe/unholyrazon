#library "uh_uix"

#include "zcommon.acs"
#include "dtadd.acs"
#import "uh_log.acs"

// UIX v3bh item-wheel and MegaManU weapon-wheel compatibility. UIX
// snapshots MM8BDM Assist Item and weapon tables; Unholy items are
// otherwise only in DefineUnholyItem, and MegaManU copy weps only in
// DefineCopyWep. Register explicit allowlists through DefineAssistItem
// and DefineWeapon. Do not delay: UIX_ItemWheelInit waits three tics
// then snapshots once, and uixweap_init waits for MAX_WEAPONS_GLOBAL.
// acs/UIXITEMS.o enlarges the item wheel when this pk3 loads after UIX.
// Icons are spawn sprites (I_BAR0 / WEAPS0), not SBARINFO composites.
// mapValid/lms/eddie are false. Auto*/FX/helper actors stay off the
// item wheel. DTADD_GRP_PASSIVE is unused: UIX maps it to IWGRP_NULL
// and hides the row. MegaManU_W is registered as DTADD slot 1 (buster).

function int UH_UIX_ActorExists(str which) {
	int u;
	int spawned;

	u = UniqueTID();
	spawned = SpawnForced(which, 0, 0, 0, u, 0);
	if (spawned)
		Thing_Remove(u);
	return spawned;
}

function int UH_UIX_Try(str tag, str actor, str icon, int group) {
	if (DefineAssistItem(tag, actor, icon, 1, group, false) == -1)
		return 1;
	return 0;
}


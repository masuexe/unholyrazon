#library "uh_uix"

#include "zcommon.acs"
#include "DTADD.acs"
#import "uh_log.acs"
#import "uhdt.acs"

// UIX v3bh item-wheel and MegaManU weapon-wheel compatibility. UIX
// snapshots MM8BDM Assist Item and weapon tables; Unholy items are
// otherwise only in DefineUnholyItem, and MegaManU copy weps only in
// DefineCopyWep. Register every defined Unholy identity through
// DefineAssistItem using UHDT icon/group. Do not delay: UIX_ItemWheelInit
// waits three tics then snapshots once, and uixweap_init waits for
// MAX_WEAPONS_GLOBAL. acs/UIXITEMS.o enlarges the item wheel when this
// pk3 loads after UIX. Icons use spawn-sprite dimensions; translated variants
// stay unscaled rather than using the smaller SBARINFO composites.
// mapValid/lms/eddie are false. Empty icon skips the wheel. DTADD_GRP_PASSIVE
// is valid; UIX maps it to IWGRP_NULL and hides the row. MegaManU_W is
// registered as DTADD slot 1 (buster).

function int UH_UIX_ActorExists(str which) {
  int u;
  int spawned;

  u = UniqueTID();
  spawned = SpawnForced(which, 0, 0, 0, u, 0);
  if (spawned)
    Thing_Remove(u);
  return spawned;
}

function bool UH_UIX_HasInventoryUI(void) {
  return CheckScript("core_item_wheel_info", true) || UH_UIX_ActorExists("UIX_ItemSelected_PU");
}

function int UH_UIX_TryId(int id) {
  str icon;

  icon = GetItemIcon(id);
  if (StrCmp(icon, "") == 0)
    return 0;
  if (DefineAssistItem(GetItemName(id), GetItemActor(id), icon, 1, GetItemDtaddGroup(id), false, 0) == -1)
    return 1;
  return 0;
}

int uh_uix_itemsdone = 0;

function void UH_UIX_RegisterItems(void) {
  int fail;
  int id;
  int i;
  int n;

  fail = 0;
  n = 0;
  for (id = 0; id < UH_MAX_VANILLA_ITEM; id++) {
    if (!IsItemDefined(id))
      continue;
    fail += UH_UIX_TryId(id);
    n++;
  }
  for (i = 0; i < GetUnholyCustomItemCount(); i++) {
    id = -1 - i;
    fail += UH_UIX_TryId(id);
    n++;
  }
  if (fail) {
    UH_Log(UH_LOG_WARN, StrParam(
      s:"uh_uix: DefineAssistItem failed for ",
      i:fail,
      s:" item(s)"));
    return;
  }
  UH_Log(UH_LOG_DEBUG, StrParam(s:"uh_uix: registered ", i:n, s:" Unholy items"));
  uh_uix_itemsdone = 1;
}

function void UH_UIX_RegisterItemsIfReady(int src) {
  int count;

  count = GetUnholyItemCount();
  if (count <= 0)
    return;
  if (uh_uix_itemsdone)
    return;
  if (!UH_UIX_HasInventoryUI())
    return;
  UH_UIX_RegisterItems();
}

#include "uh_uix_megaweps.acs"
#include "uh_uix_mugshots.acs"

script "uh_uix_reg_items" (void) CLIENTSIDE {
  UH_UIX_RegisterItemsIfReady(2);
}

script "uh_uix_register_items" OPEN CLIENTSIDE {
  if (!UH_UIX_HasInventoryUI())
    terminate;

  UH_UIX_RegisterItemsIfReady(1);
  UH_UIX_RegisterMegaWeps();
}

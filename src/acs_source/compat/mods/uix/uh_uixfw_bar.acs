// Weaponbar reads definitions only: never collect/open/reset a wheel here.
#include "uh_uixbar_api.acs"

function int UHFB_ClassIndex(void) {
	str actor = GetActorClass(0);
	if (StrICmp(actor, "Arcanist") != 0
		&& StrICmp(actor, "ArcanistShiny") != 0
		&& StrICmp(actor, "RedWarrior") != 0
		&& StrICmp(actor, "YellowWizard") != 0
		&& StrICmp(actor, "Archivist") != 0
		&& StrICmp(actor, "KakusaretaSutoka") != 0
		&& StrICmp(actor, "ArchArcanist") != 0
		&& StrICmp(actor, "VoidWalker") != 0
		&& StrICmp(actor, "GBeast") != 0
		&& StrICmp(actor, "FBeast") != 0
		&& StrICmp(actor, "FinalSampi") != 0
		&& StrICmp(actor, "SinfulBusterExpert") != 0)
		return UHFB_UNSUPPORTED;
	if (!uhfw_defsready)
		return UHFB_NOT_READY;
	int idx = UHFW_FindClass(actor);
	if (idx == UHFW_FAIL)
		return UHFB_NOT_READY;
	return idx;
}

// -1: stock path; -2: supported but OPEN has not finished; >= 0: row count.
// Synchronous, non-NET; inherits and preserves the camera activator.
script "uh_fb_count" (void) {
	int idx = UHFB_ClassIndex();
	if (idx < 0)
		SetResultValue(idx);
	else
		SetResultValue(uhfw_classwepcount[idx]);
}

// Real binding slot, not the row's display position. -1 means no hint.
script "uh_fb_slot" (int row) {
	int slot = -1;
	int idx = UHFB_ClassIndex();
	if (idx >= 0 && row >= 0) {
		if (row < uhfw_classwepcount[idx])
			slot = uhfw_wepslot[idx][row];
	}
	SetResultValue(slot);
}

// Constant palette/capacity lookup for SinfulBusterExpert:
int uh_sbe_bar_cyan[8] = {203, 63, 198, 132, 180, 178, 218, 4};
int uh_sbe_bar_blue[8] = {206, 79, 244, 135, 5, 5, 5, 84};
int uh_sbe_bar_max[8] = {145, 175, 175, 145, 105, 250, 85, 250};

// Always return global dynamic strings, including invalid/empty results.
script "uh_fb_string" (int row, int field) {
	str value = "";
	int idx = UHFB_ClassIndex();
	if (idx >= 0 && row >= 0) {
		if (row < uhfw_classwepcount[idx]) {
			if (field == UHFB_ACTOR)
				value = uhfw_wep[idx][row][UHFW_STR_WEP];
			else if (field == UHFB_ICON)
				value = uhfw_wep[idx][row][UHFW_STR_ICON];
			else if (field == UHFB_AMMO1) {
				if (StrICmp(GetActorClass(0), "SinfulBusterExpert") == 0)
					value = uhfw_wep[idx][row][UHFW_STR_AMMO1];
			}
		}
	}
	SetResultValue(StrParam(s:value));
}

script "uh_fb_int" (int row, int field) {
	int ival = 0;
	int idx = UHFB_ClassIndex();
	if (idx >= 0 && row >= 0 && row < 8) {
		if (StrICmp(GetActorClass(0), "SinfulBusterExpert") == 0) {
			if (field == UHFB_CYAN1)
				ival = uh_sbe_bar_cyan[row];
			else if (field == UHFB_BLUE1)
				ival = uh_sbe_bar_blue[row];
			else if (field == UHFB_DEFMAX1)
				ival = uh_sbe_bar_max[row];
		}
	}
	SetResultValue(ival);
}

// MakeAGoodZero weapon bar bridge: synchronous, camera activator preserved
script "uh_zb_check" (void) {
	if (StrICmp(GetActorClass(0), "MakeAGoodZero") == 0)
		SetResultValue(1);
	else
		SetResultValue(0);
}

script "uh_zb_phase" (void) {
	if (CheckInventory("MakeAGoodZero_W8") > 0)
		SetResultValue(3);
	else if (UHFW_IsZeroPhase2())
		SetResultValue(2);
	else if (CheckInventory("MakeAGoodZero_W") > 0)
		SetResultValue(1);
	else
		SetResultValue(0);
}

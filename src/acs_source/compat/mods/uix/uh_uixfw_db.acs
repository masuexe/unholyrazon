  if (UHFW_FindClass("RedWarrior") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("RedWarrior");
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W", "TAG_RedWarrior_W", "C_I_44AW", "TreasureAmmo", "", 1);
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W2", "TAG_RedWarrior_W2", "C_I_44BW", "TreasureAmmo", "", 2);
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W3", "TAG_RedWarrior_W3", "C_I_44CW", "TreasureAmmo", "", 3);
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W4", "TAG_RedWarrior_W4", "C_I_44DW", "TreasureAmmo", "", 4);
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W5", "TAG_RedWarrior_W5", "C_I_44EW", "TreasureAmmo", "", 5);
  AddFixedWeaponWheelWeapon("RedWarrior", "RedWarrior_W6", "TAG_RedWarrior_W6", "C_I_44FW", "TreasureAmmo", "", 6);
}


function void UHFW_RegisterArchivist(void) {
  if (UHFW_FindClass("Archivist") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("Archivist");
  AddFixedWeaponWheelWeapon("Archivist", "Archivist_W", "TAG_Archivist_W", "C_I_49AW", "RustyEnergyAmmo", "", 1);
  AddFixedWeaponWheelWeapon("Archivist", "Archivist_W2", "TAG_Archivist_W2", "C_I_49BW", "RustyEnergyAmmo", "", 2);
  AddFixedWeaponWheelWeapon("Archivist", "Archivist_W3", "TAG_Archivist_W3", "C_I_49CW", "RustyEnergyAmmo", "", 3);
  AddFixedWeaponWheelWeapon("Archivist", "Archivist_W4", "TAG_Archivist_W4", "C_I_49DW", "RustyEnergyAmmo", "", 4);

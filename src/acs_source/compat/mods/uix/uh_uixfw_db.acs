  AddFixedWeaponWheelWeapon("YellowWizard", "YellowWizard_W2", "TAG_YellowWizard_W2", "C_I_46BW", "BluePotionAmmo", "", 2);
  AddFixedWeaponWheelWeapon("YellowWizard", "YellowWizard_W3", "TAG_YellowWizard_W3", "C_I_46CW", "BluePotionAmmo", "", 3);
  AddFixedWeaponWheelWeapon("YellowWizard", "YellowWizard_W4", "TAG_YellowWizard_W4", "C_I_46DW", "BluePotionAmmo", "", 4);
  AddFixedWeaponWheelWeapon("YellowWizard", "YellowWizard_W5", "TAG_YellowWizard_W5", "C_I_46EW", "BluePotionAmmo", "", 5);
  AddFixedWeaponWheelWeapon("YellowWizard", "YellowWizard_W6", "TAG_YellowWizard_W6", "C_I_46FW", "BluePotionAmmo", "", 6);

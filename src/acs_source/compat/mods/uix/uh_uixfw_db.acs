// Fixed-weapon-wheel definition table. Arcanist, ArcanistShiny,
// RedWarrior, YellowWizard, Archivist.

#libdefine UHFW_FAIL -1
#libdefine UHFW_MAX_CLASS 16
#libdefine UHFW_MAX_WEAP 12
#libdefine UHFW_MIN_WEAP 3

#libdefine UHFW_STR_CLASS 0
#libdefine UHFW_STR_WEP 1
#libdefine UHFW_STR_TAG 2
#libdefine UHFW_STR_ICON 3
#libdefine UHFW_STR_AMMO1 4
#libdefine UHFW_STR_AMMO2 5
#libdefine UHFW_STR_COUNT 6

int uhfw_defsready = 0;
int uhfw_classcount = 0;
str uhfw_classactor[UHFW_MAX_CLASS];
int uhfw_classwepcount[UHFW_MAX_CLASS];
str uhfw_wep[UHFW_MAX_CLASS][UHFW_MAX_WEAP][UHFW_STR_COUNT];
// Real player.weaponslot metadata for binding hints only; never sets slots.
int uhfw_wepslot[UHFW_MAX_CLASS][UHFW_MAX_WEAP];

function int UHFW_FindClass(str classactor) {
  int i;

  if (StrCmp(classactor, "") == 0)
    return UHFW_FAIL;
  for (i = 0; i < uhfw_classcount; i++) {
    if (StrICmp(uhfw_classactor[i], classactor) == 0)
      return i;
  }
  return UHFW_FAIL;
}

function int UHFW_FindWep(int classidx, str wepactor) {
  int i;

  if (classidx < 0 || classidx >= uhfw_classcount)
    return UHFW_FAIL;
  if (StrCmp(wepactor, "") == 0)
    return UHFW_FAIL;
  for (i = 0; i < uhfw_classwepcount[classidx]; i++) {
    if (StrICmp(uhfw_wep[classidx][i][UHFW_STR_WEP], wepactor) == 0)
      return i;
  }
  return UHFW_FAIL;
}

function int DefineFixedWeaponWheel(str classactor) {
  int idx;

  if (StrCmp(classactor, "") == 0) {
    UH_Log(UH_LOG_WARN, "DefineFixedWeaponWheel: empty class");
    return UHFW_FAIL;
  }
  if (UHFW_FindClass(classactor) != UHFW_FAIL) {
    UH_Log(UH_LOG_WARN, StrParam(s:"DefineFixedWeaponWheel: duplicate ", s:classactor));
    return UHFW_FAIL;
  }
  if (uhfw_classcount >= UHFW_MAX_CLASS) {
    UH_Log(UH_LOG_WARN, "DefineFixedWeaponWheel: class table full");
    return UHFW_FAIL;
  }
  idx = uhfw_classcount;
  uhfw_classactor[idx] = classactor;
  uhfw_classwepcount[idx] = 0;
  uhfw_classcount++;
  return idx;
}

function int AddFixedWeaponWheelWeapon(str classactor, str wepactor, str tag, str icon, str ammo1, str ammo2, int slot) {
  int classidx;
  int n;

  classidx = UHFW_FindClass(classactor);
  if (classidx == UHFW_FAIL) {
    UH_Log(UH_LOG_WARN, StrParam(s:"AddFixedWeaponWheelWeapon: unknown class ", s:classactor));
    return UHFW_FAIL;
  }
  if (StrCmp(wepactor, "") == 0 || StrCmp(icon, "") == 0) {
    UH_Log(UH_LOG_WARN, StrParam(s:"AddFixedWeaponWheelWeapon: empty actor/icon for ", s:classactor));
    return UHFW_FAIL;
  }
  if (UHFW_FindWep(classidx, wepactor) != UHFW_FAIL) {
    UH_Log(UH_LOG_WARN, StrParam(s:"AddFixedWeaponWheelWeapon: duplicate ", s:wepactor));
    return UHFW_FAIL;
  }
  n = uhfw_classwepcount[classidx];
  if (n >= UHFW_MAX_WEAP) {
    UH_Log(UH_LOG_WARN, StrParam(s:"AddFixedWeaponWheelWeapon: ", s:classactor, s:" exceeds 12"));
    return UHFW_FAIL;
  }
  uhfw_wep[classidx][n][UHFW_STR_WEP] = wepactor;
  uhfw_wep[classidx][n][UHFW_STR_TAG] = tag;
  uhfw_wep[classidx][n][UHFW_STR_ICON] = icon;
  uhfw_wep[classidx][n][UHFW_STR_AMMO1] = ammo1;
  uhfw_wep[classidx][n][UHFW_STR_AMMO2] = ammo2;
  uhfw_wepslot[classidx][n] = slot;
  uhfw_classwepcount[classidx] = n + 1;
  return n;
}

function void UHFW_RegisterArcanist(void) {
  if (UHFW_FindClass("Arcanist") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("Arcanist");
  AddFixedWeaponWheelWeapon("Arcanist", "Arcanist_W", "TAG_Arcanist_W", "C_I_12AW", "CatalyticRuneAmmo", "", 1);
  AddFixedWeaponWheelWeapon("Arcanist", "Arcanist_W2", "TAG_Arcanist_W2", "C_I_12BW", "CatalyticRuneAmmo", "", 2);
  AddFixedWeaponWheelWeapon("Arcanist", "Arcanist_W3", "TAG_Arcanist_W3", "C_I_12CW", "CatalyticRuneAmmo", "", 3);
  AddFixedWeaponWheelWeapon("Arcanist", "Arcanist_W4", "TAG_Arcanist_W4", "C_I_12DW", "CatalyticRuneAmmo", "", 4);
}

function void UHFW_RegisterArcanistShiny(void) {
  if (UHFW_FindClass("ArcanistShiny") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("ArcanistShiny");
  AddFixedWeaponWheelWeapon("ArcanistShiny", "ArcanistShiny_W", "TAG_S_Arcanist_W", "C_I_12AW", "CatalyticRuneAmmo", "", 1);
  AddFixedWeaponWheelWeapon("ArcanistShiny", "ArcanistShiny_W2", "TAG_S_Arcanist_W2", "C_I_12BW", "CatalyticRuneAmmo", "", 2);
  AddFixedWeaponWheelWeapon("ArcanistShiny", "ArcanistShiny_W3", "TAG_S_Arcanist_W3", "C_I_12CW", "CatalyticRuneAmmo", "", 3);
  AddFixedWeaponWheelWeapon("ArcanistShiny", "ArcanistShiny_W4", "TAG_S_Arcanist_W4", "C_I_12DW", "CatalyticRuneAmmo", "", 4);
}


#include "uh_uixfw_boss_defs.acs"

function void UHFW_RegisterFixedWheels(void) {
  UHFW_RegisterArcanist();
  UHFW_RegisterArcanistShiny();
  UHFW_RegisterRedWarrior();
  UHFW_RegisterYellowWizard();
  UHFW_RegisterArchivist();
  UHFW_RegisterBossWheels();
  uhfw_defsready = 1;
}

script "uh_fw_defs" OPEN {
  UHFW_RegisterFixedWheels();
}

script "uh_fw_defs_cs" OPEN CLIENTSIDE {
  UHFW_RegisterFixedWheels();
}

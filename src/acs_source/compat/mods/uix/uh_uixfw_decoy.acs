// Three equal slices in launcher-slot order. Each reroll replaces the held
// actors; DecoyBot_W/W2/W3 are only bar aliases and must never be selected.
function int UHFW_CollectDecoyBot(void) {
  str wep;
  str tag;

  for (int slot = 1; slot <= 3; slot++) {
    wep = ACS_NamedExecuteWithResult("uh_DecoyBotHeldWeapon", slot);
    if (StrLen(wep) <= 0 || CheckInventory(wep) <= 0)
      return 0;
    if (slot == 1) {
      tag = "TAG_DecoyBot_W";
    } else if (slot == 2) {
      tag = "TAG_DecoyBot_W2";
    } else {
      tag = "TAG_DecoyBot_W3";
    }
    UHFW_SnapPush(wep, tag, UHFW_DecoyIcon(slot), "DecoyEnergyAmmo", "FlukyNumberAmmo");
    uhfw_heldn++;
  }
  return 1;
}

function void UHFW_DecoySelect(int idx) {
  if (idx < 0 || idx >= uhfw_snapn)
    return;
  // Release can run before the next wheel tick notices a reroll/morph.
  if (UHFW_ShouldCancel())
    return;
  UHFW_SubmitSelect(uhfw_snapwep[idx], "uh_decoy_sel_sv");
}

script "uh_decoy_sel_sv" (int wep) NET {
  if (!UHFW_PlayerOk() || !UHFW_IsPlainDecoyBot() || StrLen(wep) <= 0)
    terminate;
  for (int slot = 1; slot <= 3; slot++) {
    if (StrICmp(wep, ACS_NamedExecuteWithResult("uh_DecoyBotHeldWeapon", slot)) == 0) {
      // Query verifies both registry membership and current ownership on
      // the server, so delayed requests cannot equip removed copies.
      if (CheckInventory(wep) > 0)
        SetWeapon(wep);
      terminate;
    }
  }
}

// Boss Multi-Weapon definitions for UIX weapon wheel and weapon bar.
// Batch A (6 fixed multi-weapon Bosses) & Batch B (2 conditional/phase Bosses).

function void UHFW_RegisterKakusaretaSutoka(void) {
	if (UHFW_FindClass("KakusaretaSutoka") != UHFW_FAIL)
		return;
	DefineFixedWeaponWheel("KakusaretaSutoka");
	AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W", "TAG_Boss005_W", "C_I_50A", "UnholyPower1500", "", 1);
	AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W2", "TAG_Boss005_W2", "C_I_50B", "UnholyPower1500", "", 2);
	AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W3", "TAG_Boss005_W3", "C_I_50C", "UnholyPower1500", "", 3);
}


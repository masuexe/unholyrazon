function void UHFW_RegisterBossWheels(void) {
  UHFW_RegisterKakusaretaSutoka();
  UHFW_RegisterArchArcanist();
  UHFW_RegisterVoidWalker();
  UHFW_RegisterGBeast();
  UHFW_RegisterFBeast();
  UHFW_RegisterFinalSampi();
  UHFW_RegisterSinfulBusterExpert();
  UHFW_RegisterMakeAGoodZero();
}

function int UHFW_IsBossClass(str classactor) {
  return StrICmp(classactor, "KakusaretaSutoka") == 0 ||
         StrICmp(classactor, "ArchArcanist") == 0 ||
         StrICmp(classactor, "VoidWalker") == 0 ||
         StrICmp(classactor, "GBeast") == 0 ||
         StrICmp(classactor, "FBeast") == 0 ||
         StrICmp(classactor, "FinalSampi") == 0 ||
         StrICmp(classactor, "SinfulBusterExpert") == 0 ||
         StrICmp(classactor, "MakeAGoodZero") == 0;
}

function int UHFW_IsSinfulBusterExpert(str classactor) {
  return StrICmp(classactor, "SinfulBusterExpert") == 0;
}

function int UHFW_IsMakeAGoodZero(str classactor) {
  return StrICmp(classactor, "MakeAGoodZero") == 0;
}

function int UHFW_IsZeroPhase2(void) {
  if (CheckInventory("MakeAGoodZeroPhase3Transition_F") > 0)
    return 0;
  if (CheckInventory("MakeAGoodZeroPhase3PainFlag") > 0)
    return 0;
  if (CheckInventory("MakeAGoodZero_W8") > 0)
    return 0;
  if (CheckInventory("MakeAGoodZero_W2") <= 0)
    return 0;
  return 1;
}

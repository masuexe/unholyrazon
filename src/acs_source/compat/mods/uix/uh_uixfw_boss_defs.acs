	if (UHFW_FindClass("MakeAGoodZero") != UHFW_FAIL)
		return;
	DefineFixedWeaponWheel("MakeAGoodZero");
	AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W2", "TAG_MGZero_W2", "B_I_306A", "UnholyPower3000", "", -1);

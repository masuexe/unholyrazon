function void UHFW_RegisterMakeAGoodZero(void) {
  if (UHFW_FindClass("MakeAGoodZero") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("MakeAGoodZero");
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W2", "TAG_MakeAGoodZero_W2", "8O21A0", "UnholyPower3000", "", -1);
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W3", "TAG_MakeAGoodZero_W3", "8O21B0", "MGZeroChipAmmoCutter", "", -1);
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W4", "TAG_MakeAGoodZero_W4", "8O21C0", "MGZeroChipAmmoFlame", "", -1);
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W5", "TAG_MakeAGoodZero_W5", "8O21D0", "MGZeroChipAmmoIcicle", "", -1);
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W6", "TAG_MakeAGoodZero_W6", "8O21E0", "MGZeroChipAmmoZap", "", -1);
  AddFixedWeaponWheelWeapon("MakeAGoodZero", "MakeAGoodZero_W7", "TAG_MakeAGoodZero_W7", "8O21F0", "MGZeroChipAmmoPsycho", "", -1);

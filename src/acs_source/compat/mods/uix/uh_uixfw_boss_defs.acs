// Boss Multi-Weapon definitions for UIX weapon wheel and weapon bar.
// Batch A (6 fixed multi-weapon Bosses) & Batch B (2 conditional/phase Bosses).

function void UHFW_RegisterKakusaretaSutoka(void) {
  if (UHFW_FindClass("KakusaretaSutoka") != UHFW_FAIL)
    return;
  DefineFixedWeaponWheel("KakusaretaSutoka");
  AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W", "TAG_KakusaretaSutoka_W", "6N50U0", "UnholyPower1500", "", 1);
  AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W2", "TAG_KakusaretaSutoka_W2", "6N50V0", "UnholyPower1500", "", 2);
  AddFixedWeaponWheelWeapon("KakusaretaSutoka", "KakusaretaSutoka_W3", "TAG_KakusaretaSutoka_W3", "6N50W0", "UnholyPower1500", "", 3);
}


function void UH_UIX_RegisterMegaWeps(void) {
  int fail = 0;
  fail += UH_UIX_TryWep("TAG_MegaMan_W", "MegaManU_W", "WEAPX0", "RockNRollAmmo", DTADD_SLOT_BUSTER);
  fail += UH_UIX_RegMegaA();
  fail += UH_UIX_RegMegaB();
  fail += UH_UIX_RegMegaC();
  fail += UH_UIX_RegMegaD();
  fail += UH_UIX_RegMegaE();
  fail += UH_UIX_RegMegaF();
  if (fail) {
    UH_Log(UH_LOG_WARN, StrParam(
      s:"uh_uix: DefineWeapon failed for ",
      i:fail,
      s:" MegaManU wep(s)"));
    return;
  }
  UH_Log(UH_LOG_DEBUG, "uh_uix: registered MegaManU weps");
}

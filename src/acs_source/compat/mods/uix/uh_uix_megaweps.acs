// MegaManU UIX weapon-wheel rows. UIXWEAP snapshots DTADD
// getWeaponActor; MegaManU_W and *WepU replaces are not in COREAMO.
// map/lms/eddie are false. Icons are spawn lumps, not inventory.icon.

function int UH_UIX_TryWep(str tag, str actor, str icon, str ammo, int slot) {
  if (DefineWeapon(tag, actor, icon, ammo, 1.00, slot, false, false, false) == -1)
    return 1;
  return 0;
}


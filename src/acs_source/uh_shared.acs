#library "uh_shared"
#include "zcommon.acs"

//Contains scripts used by several classes

script "uhS_countinv_acs" (int Which, int Pointer)
{
	if(Pointer>0){
		SetActivator(0,Pointer);
	}
	int Counter = 0;
	switch(Which)
	{
		Default:
			break;
		Case 0:
			Counter = CheckInventory("WeaponCharge");
			break;
		Case 1:
			Counter = CheckInventory("CutterFlag");
			break;
		Case 2:
			Counter = CheckInventory("KnightFlag");
			break;
	}
	SetResultValue(Counter);
}

Script "uc_clientwarper" (int Object) CLIENTSIDE
{
	int Player = ACS_NamedExecuteWithResult("core_gettarget",0);
	//Log(s:"Player = ",i:Player);
	str TheString = "Honk";
	bool Check = true;
	Switch(Object)
	{
		Default:
			Check = false;
			break;
		Case -77:
			TheString = "WheelCount";
			break;
		Case -39:
			TheString = "ClientFXWarp_F";
			break;
		Case -4:
			TheString = "SuperArmTemp";
			break;
		//Case -2:
		//	TheString = "StopShield";
		//	break;
		Case -1:
			TheString = "ShieldCheck";
			break;
		//Case 91:
			//TheString = "ConcreteBlockReady";
			//break;
	}

	if(Check){
		while(GetActorProperty(Player, APROP_HEALTH)>0){
			if(CheckActorInventory(Player, TheString) == 0){
				break;
			}
			Delay(1);
		}
	}
	else{
		while(GetActorProperty(Player, APROP_HEALTH)>0){
			Delay(1);
		}
	}
	Thing_Remove(0);
}

Script "uc_clientwarper_jewel" (int jewelno) CLIENTSIDE
{
	int Player = ACS_NamedExecuteWithResult("core_gettarget",0);

	while(GetActorProperty(Player, APROP_HEALTH)>0 && CheckActorInventory(Player, "ShieldCheck") > 0 && CheckActorInventory(Player, "JewelShieldCheck") >= jewelno){
		Delay(1);
	}
	Thing_Remove(0);
}

script "uh_PoisonControl_acs" (int Which, int Style, int Change)
{
//	Log(s:"uh_PoisonControl_acs(",i:Which,s:", ",i:Style,s:", ",i:Change,s:")");
	int SourceTID = ACS_NamedExecuteWithResult("core_getptrtid",2);//Caused the poison
	int PoisonedTID = ACS_NamedExecuteWithResult("core_getptrtid",8);//Player being poisoned
	if(SourceTID < 1000 || SourceTID > 1063){//End if not a Player TID
		SetResultValue(-1);
		terminate;
	}
	SourceTID -= 1000;
	str TheClass;
	Switch(Which){
		Case 17:
			TheClass = "Raider_Poison";
			break;
		Case 6100:
			TheClass = "Hellbot_Poison";
			break;
		Case 28:
			TheClass = "DrWily_OnFire";
			break;
	}
	str SpawnName = StrParam(s:"user_",s:TheClass);//,s:"_OnFire"

	int Result = GetUserArray(PoisonedTID,SpawnName,SourceTID);

//	Log(s:"TID <",i:PoisonedTID,s:"> ",s:SpawnName,s:"[",i:SourceTID,s:"] = ",i:Result);
	Switch(Style){
		Default:
			SetResultValue(-1);
			break;
		Case 0://Fetch
			SetResultValue(Result);
			break;
		Case 1://Adjust
			SetUserArray(PoisonedTID,SpawnName,SourceTID,Result+Change);
			SetResultValue(Result+Change);
			break;
		Case 2://Initial Set
			SetUserArray(PoisonedTID,SpawnName,SourceTID,Change);
			SetResultValue(Result <= 0);
			break;
	}
}

script "uh_TimeBenderCameraLook" (void) CLIENTSIDE
{
	if(!CheckInventory("TimeBenderCamera_F")) {
		GiveInventory("TimeBenderCamera_F",1);
		
		do {
			if(CheckInventory("PlayerPropertyFrozen")<2) {//TimeBender applies 1 stack
				SetActorAngle(0,GetActorAngle(0)+GetPlayerInput(-1, INPUT_YAW));
				SetActorPitch(0,GetActorPitch(0)-GetPlayerInput(-1, INPUT_PITCH));
			}
			delay(1);
		} while (GetActorProperty(0, APROP_HEALTH)>0 && CheckInventory("IsTimeBended_F"));
		
		TakeInventory("TimeBenderCamera_F",1);
	}
}

//Flash Stopper Script, Random Color version
Script "uh_FlashStopperRNG" (int Power, int Dur, int Toggle) CLIENTSIDE
{
	int RC;
	int BC;
	int GC;
	Switch(Toggle)
	{
		Case 3:
			RC = 225;
			BC = 225;
			GC = 225;
			break;
		Case 2:
			RC = 45;
			BC = 45;
			GC = 45;
			break;
		Case 1:
			RC = 145;
			BC = 145;
			GC = 145;
			break;
		Case 0:
			RC = random(0,255);
			BC = random(0,255);
			GC = random(0,255);
			break;
	}

	CancelFade();

	FadeRange(RC,BC,GC,((1.0)*Power)/100,RC,BC,GC,0.0,((1.0)*Dur)/100);
}

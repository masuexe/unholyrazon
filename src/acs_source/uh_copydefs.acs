script "uh_define_vanilla_copyweps" OPEN
{
	if (!UHInPlay()) terminate;
	if (GetMegaOfficialCopyCount() <= 0)
		RegisterVanillaCopyWeps();
	RegisterVanillaShinyMegaFires();
}

script "uh_define_vanilla_copyweps_cs" OPEN CLIENTSIDE
{
	if (GetMegaOfficialCopyCount() <= 0)
		RegisterVanillaCopyWeps();
	RegisterVanillaShinyMegaFires();
}

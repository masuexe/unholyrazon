#define RPT_INCLUDESELF 1
script "rz_RandomPlayerTID" (int flags, int retrycount) {
	int tid = 0;
	int callerTID = ActivatorTID();
	for (int i = 0; i < retrycount; i++) {
		tid = random(1000, 1000 + ServerMAX);
		if (!(flags & RPT_INCLUDESELF) && tid == callerTID) {
			continue;
		}
		SetActivator(tid);
		if (PlayerNumber() == -1 || CheckInventory("IsDead") ||
			  !PlayerInGame(PlayerNumber()) || CheckInventory("IsAFakeBoss")) {
			continue;
		}
		SetResultValue(tid);
		terminate;
	}
	SetResultValue(-1);
}

script "uh_shinyclassmorpher" (int ClassNum)
{
	for ( int i = 0; i <= 7; i++ ) {
		if(i!=3)
			StopSound(0,i);
	}
	str originalClass = GetActorClass(0);
	str shinyClass = StrParam(s: originalClass, s: "Shiny");

	if(ACS_NamedExecuteWithResult("core_checkmode", 0)==2)//Is it T/LMS ?
		GiveInventory("UH_MorphLMSFix_P",1);

	ACS_NamedExecuteWithResult("uh_MorphPreReset");
	delay(1);
	if(MorphActor(0, shinyClass, "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, "ShinySparkleFlash", "FlashM_GenesisSparkleFX")){
		GiveInventory("RemoveWeaponsOfMortals_P", 1);
		shinyClassMultiWeaponGive();
		ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
		GiveInventory("S_ClassSpawn_P",1);
		TakeInventory("MorphedFlag",1);
	}
	else{
		GiveInventory("UH_MorphLMSFixAbort_P",1);
		GiveInventory("S_ClassSpawnNo_P",1);
	}
}

function void shinyClassMultiWeaponGive(void) {
	str className = GetActorClass(0);
	if (!strICmp(className, "QwantShiny")) {
		GiveInventory("IsQwantSFlag", 1);
	}
	if (!strICmp(className, "NegaManShiny")) {
		TakeInventory("IsNegaManFlag", 1);
		GiveInventory("IsNegaManSFlag", 1);
	}
	if (!strICmp(className, "DecoyBotShiny")) {
		TakeInventory("IsDecoyBotFlag", 1);
		GiveInventory("IsDecoyBotSFlag", 1);
		ACS_NamedExecuteWithResult("uh_DecoyBotShinyMorphSetup");
	}
	if (!strICmp(className, "ArcanistShiny")) {
		GiveInventory("ArcanistShiny_W2", 1);
		GiveInventory("ArcanistShiny_W3", 1);
		GiveInventory("ArcanistShiny_W4", 1);
	}
	if (!strICmp(className, "RaiderShiny")) {
		GiveInventory("RaiderShiny_W2", 1);
	}
	if (!strICmp(className, "TidalManiacShiny")) {
		GiveInventory("TidalManiacShiny_W2", 1);
	}
	if (!strICmp(className, "KateShiny")) {
		GiveInventory("KateShiny_W2", 1);
	}
}

script "UH_AntiDamageHP" (int swap)
{
	if (swap) {  // Adjust AntiDamageHealth to match current HP
		SetInventory("AntiDamageHealth", max(PlayerHealth(), 0));
	} else {  // Reset player HP based on AntiDamageHealth
		SetActorProperty(0, APROP_HEALTH, CheckInventory("AntiDamageHealth"));
	}
}

// Query
#define UHEALTH_GET_INV			0   // CheckInventory("Health")
#define UHEALTH_GET_MAX			-1  // SpawnHealth
#define UHEALTH_GET_CURRENT		1
#define UHEALTH_IS_FULL			2   // 1=full, 0=can gain

// Modify
#define UHEALTH_HEAL			6   // Heal up to max; returns 0 if dead/full, 1 if healed
#define UHEALTH_HEAL_EXPAND_MAX	7   // 750/1000 > +500 > 1250/1500; always returns 1
#define UHEALTH_HEAL_ADD_MAX	-7  // 750/1000 > +500 > 1250/1250; always returns 1

// Damage
#define UHEALTH_DAMAGE_BURN		9

script "uh_Health" (int Swap, int HPBoost) //Health related script
{
	//Log(s:"uh_Health called with...",i:Swap,s:" and ",i:HPBoost);
	int h = max(PlayerHealth(),0);
	int s_h = GetActorProperty(0, APROP_SPAWNHEALTH);
	switch(Swap)
	{
		Default:
			Log(s:"Invalid Swap Number for script uh_Health >> ",i:Swap);
			break;
		Case UHEALTH_GET_INV://Return Health
			SetResultValue(CheckInventory("Health"));
			break;
		Case UHEALTH_GET_MAX://Returns MaxHp
			SetResultValue(s_h);
			break;
		Case UHEALTH_GET_CURRENT://Return Health
			SetResultValue(h);
			break;
		Case UHEALTH_IS_FULL://1=full, 0=can gain
			SetResultValue(h >= s_h);
			break;

//HealThing(HPBoost,s_h);
		Case UHEALTH_HEAL:
		Case UHEALTH_HEAL_ADD_MAX:
		Case UHEALTH_HEAL_EXPAND_MAX:
			if(h <= 0){ SetResultValue(0); break; }
			if(Swap == UHEALTH_HEAL && h >= s_h){ SetResultValue(0); break; }

			if(Swap == UHEALTH_HEAL_ADD_MAX){
				s_h = min(s_h + HPBoost, MAX_HEALTH);
				SetActorProperty(0, APROP_SPAWNHEALTH, s_h);
			}
			else if(Swap == UHEALTH_HEAL_EXPAND_MAX){
				int HPAdd = min(h + HPBoost, MAX_HEALTH);
				if(HPAdd > s_h){
					s_h = HPAdd;
					SetActorProperty(0, APROP_SPAWNHEALTH, s_h);
				}
			}

			HealThing(HPBoost,s_h);
			if(CheckInventory("AntiDamageTime") != 300){//Check if AntiDamage is on
				SetInventory("AntiDamageHealth",PlayerHealth());
			}
			SetResultValue(1);
			break;

		Case UHEALTH_DAMAGE_BURN://Burning damage
			if (h >= HPBoost+1){
				SetActorProperty(0, APROP_HEALTH, (h-HPBoost));
				break;
			}
			SetResultValue(2);
			break;
	}
}

Script "UB_GetPointerHealth" (int Pointer, int Which)
{
	SetActivator(0,Pointer);
	Switch(Which)
	{
		Default:
			Log(s:"Invalid Number for script GetPointerHealth >> ",i:Which);
			break;
		Case 0:
			SetResultValue(GetActorProperty(0,APROP_HEALTH));
			break;
		Case 1:
			SetResultValue(GetActorProperty(0,APROP_SPAWNHEALTH));
			break;
		Case 2://Percent
			int CurrHP = GetActorProperty(0,APROP_HEALTH);
			int SpawnHP = GetActorProperty(0,APROP_SPAWNHEALTH);
			if(CurrHP > SpawnHP)
				CurrHP = SpawnHP;
			else if(CurrHP < 0)
				CurrHP = 0;
			if(SpawnHP == 0){
				SpawnHP = 1;
				//Log(s:"Online is being stupid again");
			}
			SetResultValue(CurrHP*100/SpawnHP);
			break;
	}
}

// Morph resets APROP_Gravity; core_commonwater only re-applies on feet/eyes transitions.
script "uh_IsUnderWaterGravity" (void)
{
	if(PlayerNumber() == -1)
		terminate;
	if(CheckInventory("IsUnderWater") || CheckInventory("HasFeetInWater")){
		ACS_NamedExecuteWithResult("core_watergravity", 0);
		ACS_NamedExecuteAlways("core_watergravity", 0, 1);
	}
}

// Rebuild DefaultProperties from current actor (Bearer copy of PUAPROP; avoids core_defineaproppowers spawn-invuln).
function void DefineDefaultProperties(void)
{
	int p = PlayerNumber();
	if(p < 0)
		return;
	for(int i = 0; i < MAX_PROPS; i++){
		int prop = getPropertyFromIndex(i);
		if(prop == CAPROP_AirJumpZ){
			DefaultProperties[p][i] = (CheckInventory("AirJumpZ") * 1.0) + FixedDiv(CheckInventory("AirJumpZDecimal") * 1.0, 10000.0);
			if(DefaultProperties[p][i] == 0.0)
				DefaultProperties[p][i] = GetActorProperty(0, APROP_JumpZ);
			ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_AirJumpZ, DefaultProperties[p][i]);
		}
		else if(prop == CAPROP_WallJumpZ){
			DefaultProperties[p][i] = (CheckInventory("WallJumpZ") * 1.0) + FixedDiv(CheckInventory("WallJumpZDecimal") * 1.0, 10000.0);
			if(DefaultProperties[p][i] == 0.0)
				DefaultProperties[p][i] = GetActorProperty(0, APROP_JumpZ);
			ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_WallJumpZ, DefaultProperties[p][i]);
		}
		else
			DefaultProperties[p][i] = GetActorProperty(0, prop);
	}
}

// Pre-MorphActor: flag sweeps + strip jump-mod inventory (Bearer CTF morph).
script "uh_MorphPreReset" (void)
{
	if(PlayerNumber() == -1)
		terminate;
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
	GiveInventory("UH_MorphFlagReset_P", 1);
	GiveInventory("Core_MorphFlagReset_P", 1);
	GiveInventory("Core_MorphFlagReset2_P", 1);
	TakeInventory("AirJumpZ", 99999);
	TakeInventory("AirJumpZDecimal", 99999);
	TakeInventory("WallJumpZ", 99999);
	TakeInventory("WallJumpZDecimal", 99999);
}

// Post-MorphActor: redefine defaults → strip PowerAprop → FixMorph → water gravity.
// arg0 force: 1 = always run; 0 = skip if UH_MorphPipelineDone_F (PowerMorph / Ready re-entry).
script "uh_MorphPostReset" (int force)
{
	if(PlayerNumber() == -1)
		terminate;
	if(!force && CheckInventory("UH_MorphPipelineDone_F"))
		terminate;

	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
	DefineDefaultProperties();
	GiveInventory("UH_MorphPowerPropReset_P", 1);
	// No Delay: ACS_NamedExecuteWithResult returns at Delay and leaves the rest async.
	GiveInventory("UH_FixMorphPower_P", 1);
	ACS_NamedExecuteAlways("uh_IsUnderWaterGravity", 0);
	GiveInventory("UH_MorphPipelineDone_F", 1);
}

script "uh_MorphDemorphReset" (void)
{
	if(PlayerNumber() == -1)
		terminate;
	ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
	GiveInventory("UH_UnMorphSuperFlagReset_P", 1);
	TakeInventory("BAWS", 1);
	TakeInventory("MorphedFlag", 1);
	TakeInventory("IsAnEye", 1);
	TakeInventory("TruePowerItemFlag", 1);
	TakeInventory("UH_MorphPipelineDone_F", 1);
	DefineDefaultProperties();
	GiveInventory("UH_MorphPowerPropReset_P", 1);
	GiveInventory("UH_FixMorphPower_P", 1);
	ACS_NamedExecuteAlways("uh_IsUnderWaterGravity", 0);
}

function void SetInventory(str item, int amount)
{
	int diff = amount - CheckInventory(item);
	if (diff > 0)
		GiveInventory(item, diff);
	else if (diff < 0)
		TakeInventory(item, -diff);
}

function int min(int a, int b)
{
	if (a < b)
		return a;
	return b;
}

function int max(int a, int b)
{
	if (a > b)
		return a;
	return b;
}

// Blizzard Attack hail weather (singleton controller + per-player snow follows).
#define HAILWEATHER_TID -8690
#define HAILWEATHER_TICS 350

function void AttachHailSnowFollows(void)
{
	int p;
	for (p = 0; p < ServerMAX; p++) {
		if (!PlayerInGame(p)) {
			continue;
		}
		int ptid = p + 1000;
		if (CheckActorInventory(ptid, "IsDead")) {
			continue;
		}
		if (CheckActorInventory(ptid, "UH_HailSnowFollow_F")) {
			continue;
		}
		int u = UniqueTID();
		if (SpawnForced("UH_HailSnowFollow", GetActorX(ptid), GetActorY(ptid), GetActorZ(ptid), u, 0)) {
			SetActivator(u);
			SetPointer(AAPTR_TARGET, ptid);
			GiveActorInventory(ptid, "UH_HailSnowFollow_F", 1);
		}
	}
}

script "rz_SetHailWeather" (void)
{
	int firer = ActivatorTID();
	if (firer == 0) {
		firer = 1000 + PlayerNumber();
	}

	if (ThingCount(T_NONE, HAILWEATHER_TID) == 0) {
		SpawnForced("UH_HailWeatherCtrl", GetActorX(firer), GetActorY(firer), GetActorZ(firer), HAILWEATHER_TID, 0);
	} else {
		SetUserVariable(HAILWEATHER_TID, "user_HailTics", HAILWEATHER_TICS);
	}

	AttachHailSnowFollows();
	SetActivator(firer);
}

script "rz_IsHailWeather" (void)
{
	SetResultValue(ThingCountName("UH_HailWeatherCtrl", 0) > 0);
}

script "rz_ReverseGravityEveryoneExceptTid" (int tid) {
	for (int i = 1000; i < 1064; i++) {
		if (PlayerInGame(i - 1000) && i != tid) {
			GiveActorInventory(i, "ReverseMyGravity_P", 1);
		}
	}
}

// ProjSpawnFunc hook: invert missile gravity when the firer is gravity-flipped.
// Eden tear passives on spawn (Ipecac / Strange Attractor).
script "rz_spawnfuncs" OPEN {
	AddSpawnFunc(DTADD_SFT_PROJ, "rz_projflipgrav");
	AddSpawnFunc(DTADD_SFT_PROJ, "rz_EdenTearPassiveSpawn");
}

script "rz_projflipgrav" (void) {
	if (CheckFlag(0, "NOGRAVITY"))
		terminate;
	int grav = GetActorProperty(0, APROP_Gravity);
	if (grav == 0)
		terminate;
	int owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
	if (owner == 0)
		owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
	if (owner == 0)
		terminate;
	if (!(CheckActorInventory(owner, "CeilingFlag") ||
	      GetActorProperty(owner, APROP_Gravity) < 0))
		terminate;
	SetActorProperty(0, APROP_Gravity, -grav);
}

script "rz_EdenTearPassiveSpawn" (void) {
	int owner;
	int brimstone;
	brimstone = CheckActorClass(0, "EdenBrimstone") ||
	            CheckActorClass(0, "EdenBrimstoneDelayed");
	if (!CheckActorClass(0, "EdenTear") &&
	    !CheckActorClass(0, "EdenSpectralTear") &&
			!CheckActorClass(0, "EdenFetusTear") &&
			!CheckActorClass(0, "EdenBrimstoneDelayedFetus") &&
			!brimstone)
		terminate;
	owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
	if (owner == 0)
		owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
	if (owner == 0)
		terminate;
	// Brimstone keeps its straight trajectory. Strange Attractor is applied
	// first so Ipecac's green dye has deterministic visual priority.
	if (brimstone) {
		if (CheckActorInventory(owner, "C315Flag"))
			GiveInventory("EdenTearStrangeAttractorApply_P", 1);
		if (CheckActorInventory(owner, "C149Flag"))
			GiveInventory("EdenBrimstoneIpecacApply_P", 1);
		terminate;
	}
	// Order matches razon3 SpawnCheck: Ipecac then Strange Attractor (dye may overwrite).
	if (CheckActorInventory(owner, "C149Flag"))
		GiveInventory("EdenTearIpecacApply_P", 1);
	if (CheckActorInventory(owner, "C315Flag"))
		GiveInventory("EdenTearStrangeAttractorApply_P", 1);
}

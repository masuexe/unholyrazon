script "uh_shinyclassmorpher" (int ClassNum)
{
	for ( int i = 0; i <= 7; i++ ) {
		if(i!=3)
			StopSound(0,i);
	}
	str originalClass, shinyClass;

	if(ClassNum >= 0 && ClassNum <= 1){
		originalClass = UH_C_Array[ClassNum][0];
		shinyClass = StrParam(s:originalClass, s:"S");
	}
	else{
		originalClass = GetActorClass(0);
		shinyClass = StrParam(s:originalClass, s:"S");
	}

	//if(CheckClass(TheClass))
		//GiveInventory("UH_MorphLMSFix_P",1);

	if(ACS_NamedExecuteWithResult("core_checkmode", 0)==2)//Is it T/LMS ?
		GiveInventory("UH_MorphLMSFix_P",1);
//2+128+256+512 = 898
//2		MRF_FULLHEALTH
//64	MRF_WHENINVULNERABLE
//128	MRF_LOSEACTUALWEAPON
//256	MRF_NEWTIDBEHAVIOUR
//512	MRF_UNDOBYDEATH
//	if(MorphActor(0, TheClass, "", 0x7fffffff, 898, "ShinySparkleFlash", StrParam(s:TheClass, s:"C"))){
	delay(1);
	if(MorphActor(0, shinyClass, "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, "ShinySparkleFlash", "FlashM_GenesisSparkleFX")){
		GiveInventory("RemoveWeaponsOfMortals_P", 1);
		shinyClassMultiWeaponGive();
		GiveInventory("S_ClassSpawn_P",1);
		TakeInventory("MorphedFlag",1);
	}
	else{
		GiveInventory("UH_MorphLMSFixAbort_P",1);
		GiveInventory("S_ClassSpawnNo_P",1);
	}
}

function void shinyClassMultiWeaponGive(void) {
	str className = GetActorClass(0);
	if (!strICmp(className, "RaiderS")) {
		GiveInventory("RaiderS_W2", 1);
	}
}

// Query
#define UHEALTH_GET_INV			0   // CheckInventory("Health")
#define UHEALTH_GET_MAX			-1  // SpawnHealth
#define UHEALTH_GET_CURRENT		1
#define UHEALTH_IS_FULL			2   // 1=full, 0=can gain

// Modify
#define UHEALTH_HEAL			6   // Heal up to max; returns 0 if dead/full, 1 if healed
#define UHEALTH_HEAL_EXPAND_MAX	7   // 750/1000 > +500 > 1250/1500; always returns 1
#define UHEALTH_HEAL_ADD_MAX	-7  // 750/1000 > +500 > 1250/1250; always returns 1

// Damage
#define UHEALTH_DAMAGE_BURN		9

script "uh_Health" (int Swap, int HPBoost) //Health related script
{
	//Log(s:"uh_Health called with...",i:Swap,s:" and ",i:HPBoost);
	int h = max(PlayerHealth(),0);
	int s_h = GetActorProperty(0, APROP_SPAWNHEALTH);
	switch(Swap)
	{
		Default:
			Log(s:"Invalid Swap Number for script uh_Health >> ",i:Swap);
			break;
		Case UHEALTH_GET_INV://Return Health
			SetResultValue(CheckInventory("Health"));
			break;
		Case UHEALTH_GET_MAX://Returns MaxHp
			SetResultValue(s_h);
			break;
		Case UHEALTH_GET_CURRENT://Return Health
			SetResultValue(h);
			break;
		Case UHEALTH_IS_FULL://1=full, 0=can gain
			SetResultValue(h >= s_h);
			break;

//HealThing(HPBoost,s_h);
		Case UHEALTH_HEAL:
		Case UHEALTH_HEAL_ADD_MAX:
		Case UHEALTH_HEAL_EXPAND_MAX:
			if(h <= 0){ SetResultValue(0); break; }
			if(Swap == UHEALTH_HEAL && h >= s_h){ SetResultValue(0); break; }

			if(Swap == UHEALTH_HEAL_ADD_MAX){
				s_h = min(s_h + HPBoost, MAX_HEALTH);
				SetActorProperty(0, APROP_SPAWNHEALTH, s_h);
			}
			else if(Swap == UHEALTH_HEAL_EXPAND_MAX){
				int HPAdd = min(h + HPBoost, MAX_HEALTH);
				if(HPAdd > s_h){
					s_h = HPAdd;
					SetActorProperty(0, APROP_SPAWNHEALTH, s_h);
				}
			}

			HealThing(HPBoost,s_h);
			if(CheckInventory("AntiDamageTime") != 300){//Check if AntiDamage is on
				SetInventory("AntiDamageHealth",PlayerHealth());
			}
			SetResultValue(1);
			break;

		Case UHEALTH_DAMAGE_BURN://Burning damage
			if (h >= HPBoost+1){
				SetActorProperty(0, APROP_HEALTH, (h-HPBoost));
				break;
			}
			SetResultValue(2);
			break;
	}
}

script "uh_istracerplayer" (void)
{
	bool result = 0;
	SetActivator(0, AAPTR_TRACER);

	if(ClassifyActor(0) & ACTOR_PLAYER){
		if(PlayerNumber() == -1 || !PlayerInGame(PlayerNumber())){
			result = 0;
		}
		else{
			result = 1;
		}
	}
	SetResultValue(result);
}

script "uh_IsUnderWaterGravity" (void)
{
	WaterChecker(ActivatorTID());
}

script "uh_RageAmmoGiver" (int type, int dmg, int dmgType) EVENT {
	int rageMax = CheckInventory("UnholyPowerLimit_F");
	if (type == GAMEEVENT_ACTOR_DAMAGED && rageMax > 0) {
		str rageName = StrParam(s: "UnholyPower", i: rageMax);
		GiveInventory(rageName, dmg);
	}

}

//Morphes don't correctly copy gravity changes
function void WaterChecker (int PlayerID)
{
	int Gravy = GetActorProperty(PlayerID, APROP_Gravity);
	if(CheckActorInventory(PlayerID, "IsUnderWater") >= 1){
		SetActorProperty(PlayerID, APROP_Gravity, FixedDiv(Gravy, 3.2));
	}
	else{
		SetActorProperty(PlayerID, APROP_Gravity, Gravy);
	}
}

function void SetInventory(str item, int amount)
{
	int diff = amount - CheckInventory(item);
	if (diff > 0)
		GiveInventory(item, diff);
	else if (diff < 0)
		TakeInventory(item, -diff);
}

function int min(int a, int b)
{
	if (a < b)
		return a;
	return b;
}

function int max(int a, int b)
{
	if (a > b)
		return a;
	return b;
}

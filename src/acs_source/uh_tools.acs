}

script "uh_GetPlayerButtonInput" (int ThePlay, int Mod_Bool)
{
	int Result = 0;
	if(SetActivatorToPlayer(ThePlay)){
		Log(i:ThePlay,s:" >> Invalid PlayerNumber for uh_GetPlayerButtonInput");
		terminate;
	}
	if(Mod_Bool)
		SetResultValue(GetPlayerInput(-1, MODINPUT_BUTTONS));
	else
		SetResultValue(GetPlayerInput(-1, INPUT_BUTTONS));
}
script "uh_GetPointerButtonInput" (int ThePoint, int Mod_Bool)
{
	Switch(ThePoint) {
		Default:
			Log(i:ThePoint,s:" >> Invalid Pointer for uh_GetPointerInput");
			break;
		Case 0://Default
			break;
		Case 1://Null
		Case 2://Target
		Case 4://Master
		Case 8://Tracer
		Case 16://Player_GetTarget
		Case 32://Player_GetConversation
		Case 16384://FriendPlayer
		Case 32768://Get_LineTarget
			SetActivator(0,ThePoint);
			break;
	}
	if(Mod_Bool)
		SetResultValue(GetPlayerInput(-1, MODINPUT_BUTTONS));
	else
		SetResultValue(GetPlayerInput(-1, INPUT_BUTTONS));
}

script "uh_FetchMovementInputOld" (void)//Solarman
{
	SetResultValue(Func_CheckForMovementButton(GetPlayerInput(-1, INPUT_BUTTONS)));
}

function bool Func_CheckForMovementButton(int buttons) {
	int result = 1;

	if (buttons & BT_MOVERIGHT){
		if (!(buttons & BT_MOVELEFT))
			result+=2;
	}
	if (buttons & BT_MOVELEFT){
		if (!(buttons & BT_MOVERIGHT))
			result+=4;
	}
	if (buttons & BT_BACK){
		if (!(buttons & BT_FORWARD))
			result+=8;
	}
	if (buttons & BT_FORWARD){
		if (!(buttons & BT_BACK))
			result+=16;
	}
	return(result);
}

script "uh_IsInputingMovement" (int Mod_Bool)
{
	if(Mod_Bool)
		SetResultValue( GetPlayerInput(-1,MODINPUT_FORWARDMOVE) || GetPlayerInput(-1,MODINPUT_SIDEMOVE) );
	else
		SetResultValue( GetPlayerInput(-1,INPUT_FORWARDMOVE) || GetPlayerInput(-1,INPUT_SIDEMOVE) );
}

script "uh_FetchInputDir" (int Swap)
{
	int F_Move = Func_FetchInputSign(GetPlayerInput(-1,INPUT_FORWARDMOVE));
	int S_Move = Func_FetchInputSign(GetPlayerInput(-1,INPUT_SIDEMOVE));
	if(!Swap){//Forward
		SetResultValue(F_Move*90/(2-!S_Move));
	}
	else{//Side
		SetResultValue(S_Move*90/(2-!F_Move));
	}
}

function int Func_FetchInputSign(int input)
{
	if (input > 0)
		return 1;
	else if (input < 0)
		return -1;
	return 0;
}

script "uh_GetPointerSpeed" (int P1, int P2, int IncludeZ)
{
	SetActivator(0,P1);
	if(P2 > 0){SetActivator(0,P2);}
	int Speed = VectorLength(GetActorVelX(0), GetActorVelY(0));
	if(IncludeZ){Speed = VectorLength(speed, GetActorVelZ(0));}
	SetResultValue(Speed);
}

script "uh_FaceMovementDirection" (void)
{
	SetActorAngle(0,VectorAngle(GetActorVelX(0),GetActorVelY(0)));
}

script "uh_FetchPointerAngle" (int Pointer)
{
	SetResultValue(GetActorAngle(ACS_NamedExecuteWithResult("core_getptrtid",Pointer)) >> 8);
}

script "uh_CopyPointerAnglePitch" (int Pointer, int AnglePitch)
{
	int Source = ACS_NamedExecuteWithResult("core_getptrtid",Pointer);
	int P_Pitch = GetActorPitch(Source);
	int P_Angle = GetActorAngle(Source);
	Switch(AnglePitch)
	{
		Case 0:
			SetActorPitch(0,P_Pitch);
			break;
		Case 1:
			SetActorPitch(0,P_Pitch);
			SetActorAngle(0,P_Angle);
			break;
		Case 2:
			SetActorAngle(0,P_Angle);
			break;
	}
}

script "uh_pointerheightfromground" (int Swap)
{
	Switch(Swap) {
		Case 3:
			SetActivator(0,AAPTR_FRIENDPLAYER);
			break;
		Case 2:
			SetActivator(0,AAPTR_MASTER);
			break;
		Case 1:
			SetActivator(0,AAPTR_TRACER);
			break;
		Case 0:
			SetActivatorToTarget(0);
			break;
	}
	SetResultValue((GetActorZ(0) - GetActorFloorZ (0)) >> 16);
}

script "uh_getplayervelocity" (int cap, int includez)//Example users Topman/Heatman
{
	int x, y, z, speed, result;
	x = GetActorVelX(0);
	y = GetActorVelY(0);
	if(includez){z = GetActorVelZ(0);}else{z = 0;}
	speed = FixedMul(x, x) + FixedMul(y, y) + FixedMul(z, z);

	result = fixedSqrt(speed)>>16;
	//Log(i:result);
	if(result > cap){result = cap;}
	SetResultValue(result);
}

script "uh_getfixedangle" (void)//BBA uses this
{
	SetResultValue(GetActorAngle(0));
}

script "uh_FetchVectorAngle" (int Which)
{
	Switch(Which){
		Case 2:
			SetActivator(0,AAPTR_TARGET);
			break;
		Case 4:
			SetActivator(0,AAPTR_MASTER);
			break;
		Case 8:
			SetActivator(0,AAPTR_TRACER);
			break;
	}
	//Log(s:"GetActorVelX = ",f:GetActorVelX(0),s:" <> GetActorVelY = ",f:GetActorVelY(0));
	SetResultValue(VectorAngle(GetActorVelX(0), GetActorVelY(0)));
}

script "uh_TellVectorAngle" (int TheAngle, int TheThrust)
{
Log(s:"TheAngle = ",f:TheAngle,s:" Cos >> ",f:cos(TheAngle),s:" Sin >> ",f:sin(TheAngle),s:" FixedMulC >> ",f:FixedMul(cos(TheAngle),TheThrust << 16),s:" FixedMulS >> ",f:FixedMul(sin(TheAngle),TheThrust << 16));
}


Script "uh_GradualAngleTurn" (int currAng, int inputAng, int turnAngLimit, int angMax)
{
	setResultValue(Func_AngleWrapAround(currAng, inputAng, turnAngLimit, angMax));
}

function int Func_AngleWrapAround(int currAng, int inputAng, int turnAngLimit, int angMax)
{
	int angleDif = inputAng-currAng;
	//Log(i:angleDif);
	int retAng;

	if(angleDif>angMax/2){
		if((angleDif-angMax)<-turnAngLimit){
			retAng = currAng-turnAngLimit;
			if(retAng<0){retAng+=angMax;}
		}
		else{retAng = inputAng;}
	}
	else if(angleDif<-angMax/2){
		if((angleDif+angMax)>turnAngLimit){
			retAng = currAng+turnAngLimit;
			if(retAng>=angMax){retAng-=angMax;}
		}
		else{retAng = inputAng;}
	}
	else if(angleDif<-turnAngLimit){
		retAng = currAng-turnAngLimit;
		if(retAng<0){retAng+=angMax;}
	}
	else if(angleDif>turnAngLimit){
		retAng = currAng+turnAngLimit;
		if(retAng>=angMax){retAng-=angMax;}
	}
	else{retAng = inputAng;}

	//Log(i:currAng);
	return retAng;
}


script "uh_MusicOff" (void)
{
	LocalSetMusic("");
}

script "uh_GetPlayerInfo" (int prop)
{
	if(PlayerNumber() != -1 && PlayerInGame(PlayerNumber()) ){
		SetResultValue(GetPlayerInfo(PlayerNumber(),prop));
	}
	else{
		SetResultValue(-2);
	}
}

script "uh_istracerenemy" (int unholyteamcheck) {
	int targetTID = ACS_NamedExecuteWithResult("core_getptrtid", 2);
	//int tracerTID = ACS_NamedExecuteWithResult("core_getptrtid", 8);
	bool result = 0;

	SetActivator(0, AAPTR_TRACER);

	if (!(ClassifyActor(0) & ACTOR_PLAYER)) {
		//Log(s:"Not a player");
		result = 0;
	}
	else if (IsTeamGame &&
		       GetPlayerInfo(targetTID - 1000, PLAYERINFO_TEAM) == GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM)) {
		result = 0;
		//Log(s:"Not different teams");
	}
	else if (!IsTeamGame && unholyteamcheck) {
		int tracerteam = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", PlayerNumber());
		int targetteam = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", targetTID - 1000);
		if (targetteam != 6 && tracerteam == targetteam) {  // PLS_EYE
			result = 0;
		}
	}
	else {
		//Log(s:"SUCCESS");
		result = 1;
	}
	SetResultValue(result);
}

script "uh_istracerally" (int unholyteamcheck) {
	int targetTID = ACS_NamedExecuteWithResult("core_getptrtid", 2);
	bool result = 0;

	SetActivator(0, AAPTR_TRACER);

	if (!(ClassifyActor(0) & ACTOR_PLAYER)) {
		result = 0;
	}
	else if (IsTeamGame &&
		       GetPlayerInfo(targetTID - 1000, PLAYERINFO_TEAM) != GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM)) {
		result = 0;
	}
	else if (!IsTeamGame && unholyteamcheck) {
		int tracerteam = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", PlayerNumber());
		int targetteam = ACS_NamedExecuteWithResult("uh_GetPlayerLifeStatus", targetTID - 1000);
		if (targetteam != 6 && tracerteam != targetteam) {
			result = 0;
		}
	}
	else {
		result = 1;
	}
	SetResultValue(result);
}

script "uh_istracerplayer" (void) {
	bool result = 0;
	SetActivator(0, AAPTR_TRACER);

	if (ClassifyActor(0) & ACTOR_PLAYER) {
		if (PlayerNumber() == -1 || !PlayerInGame(PlayerNumber())) {
			result = 0;
		}
		else {
			result = 1;
		}
	}
	SetResultValue(result);
}

script "uh_IsTracerAllyOrEnemy" (void)
{
	int targetTID = ACS_NamedExecuteWithResult("core_getptrtid",2);
	bool result = 0;

	SetActivator(0, AAPTR_TRACER);

	if(!(ClassifyActor(0) & ACTOR_PLAYER)){//Not a player
		result = 0;
	}
	else{
		result = -1;//IsFoe
		if(ACS_NamedExecuteWithResult("core_checkmode",1)==1){//IsTeamGame
			if(GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM) == GetPlayerInfo(targetTID - 1000, PLAYERINFO_TEAM)){
				//tracerTeam == targetTeam
				result = 1;//IsAlly!
			}
		}
		else if(CheckInventory("PowerProtectSurvivor")){
			result = 1;//IsAlly?
		}
	}
//	Log(s:"uh_IsTracerAllyOrEnemy == ",i:result);
	SetResultValue(result);
}

script "uh_IsPointerClient" (int Pointer, int PlayerNum, int ChaseCam) CLIENTSIDE
{
	if(Pointer>0){
		SetActivator(0,Pointer);
		PlayerNum = PlayerNumber();
	}
//	Log(i:consoleplayernumber(),s:" = Console -uh_IsPointerClient- Player =",i:PlayerNum);
	if(ConsolePlayerNumber() == PlayerNum){
		if(ChaseCam)
			SetResultValue(!GetPlayerChasecam(PlayerNum));
		else
			SetResultValue(1);
	}
	else{
		SetResultValue(0);
	}
}

script "uh_SetPtrCoordToArgs" (int Pointer)
{
	int tid = ACS_NamedExecuteWithResult("core_getptrtid",Pointer);

	int x = 80.0;
	int y = 0.0;
	int z = 33.0;

	if(tid != 0){
		x = (GetActorX(0) - GetActorX(tid)) >> 16;
		y = (GetActorY(0) - GetActorY(tid)) >> 16;
		z = (GetActorZ(0) - GetActorZ(tid)) >> 16;
	}

	SetThingSpecial(0,0,x,y,z);
}


#library "uh_bossdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Auto-generated from UH_DEF mainBossList/mainBossHP — Phase 2.
// Do not hand-edit rows; regenerate via tools/gen_boss_defs.py
//
// Zandronum: non-CLIENTSIDE OPEN runs on the server only. CLIENTSIDE HUD reads
// local UHDT, so vanilla defs must also register via OPEN CLIENTSIDE.

function void uh_RegisterVanillaBossDefs(void)
{
	DefineBoss(0, "TrueBusterExpert", "\cmTrue \cuBusterExpert", UHBOSS_POOL_COMMON, 5000, 500, "", "", "M_UB000", "Super Street Fighter 2 - M. Bison's Theme", "\ckUse your primary to fire a single Buster Shot!\n\cdUse your alt for a Sweeper Shot.\n\cnUse your item to dash ahead!\n\cjThe \cghelltatoru \cjwill help you if it's your \cglast resort...", "", "");
	DefineBoss(1, "HunterHawkeye", "\cmHunter \crHawkeye", UHBOSS_POOL_COMMON, 2000, 416, "", "", "M_UB001", "Super Street Fighter 2 - T. Hawk's Theme", "\ckYour primary is a rail gun!\n\cdUse your alt to zoom in and deal extra damage!\n\cnUse your item for an Exit Unit!", "", "");
	DefineBoss(2, "DonJavier", "\cmDon \ckJavier", UHBOSS_POOL_COMMON, 2250, 352, "", "", "M_UB002", "Super Street Fighter 2 - Vega's Theme", "\cnUse your item to throw knives!\n\ckUse your primary to dash and slice!\n\cdUse your alt to climb walls.", "", "");
	DefineBoss(3, "ElitistSue", "\cmElitist \cnSue", UHBOSS_POOL_COMMON, 1875, 394, "", "", "M_UB003", "Marvel Vs Capcom 1 - Morrigan's Theme (Sped Up)", "\ckUse your primary to blast enemies with a chill!\n\cnYour item lets you fly for a bit!\n\cdUse your alt to fire an energy-catching needle for empowered attacks.", "", "");
	DefineBoss(4, "ColonelKachidonga", "\cmColonel \cgKachidonga", UHBOSS_POOL_COMMON, 4375, 594, "", "", "M_UB004", "F-Zero (Fire Field)", "\ckUse your primary to fire a cannonball!\n\cdOr use your alt to fire some buckshots!\n\cnUse item for \cvLASER\cn!", "", "");
	DefineBoss(5, "KakusaretaSutoka", "\cmKakusareta \chSutoka", UHBOSS_POOL_COMMON, 2100, 285, "", "", "M_UB005 3", "Shadow of Ninja (NES) - Stage 2", "You have many ninja tools at your disposal...\n\cnUse your item to swap your \ckprimary\cn and \cdalt\cn weapons and play around with them!\n\cjYour \cgrage\cj generates Pandora Boxes!", "", "");
	DefineBoss(6, "OfficerJohnson", "\cmOfficer \cqJohnson", UHBOSS_POOL_COMMON, 4375, 715, "", "", "M_UB006", "Marvel vs. Capcom 1 - Captain America's Theme", "\ckUse your primary to fire your riot shotgun.\n\cdUse your alt for Justice Slam!", "", "");
	DefineBoss(7, "ElitistWaylon", "\cmHurricane \ctWaylon", UHBOSS_POOL_COMMON, 2000, 310, "", "", "M_UB007", "Super Street Fighter 2 - Fei Long's Theme (American)", "\ckYour primary sends your enemies the punishing gift of wind!\n\cdUse your alt for Peus Anti-Ground!", "", "");
	DefineBoss(8, "ShinHellbot", "\cmShin \cuHellbot", UHBOSS_POOL_COMMON, 1000, 1000, "", "", "M_UB008", "Super Street Fighter 2 - Akuma's Theme", "I can't control the Helltatoru...\nMy powers may be great, but I must serve as its vessel.\nI could always \cdalt\cj to escape if needed...", "", "");
	DefineBoss(9, "CaptainDevilEye", "\chDevileye", UHBOSS_POOL_COMMON, 1500, 650, "", "", "M_UB009", "Art of Fighting - Mr. Big's Theme (SNES)", "\ckUse your primary to blast insistent enemies with fireballs.\n\cdUse your alt to do a burning upper!\n\cnYour item tosses a sack of money to hire allies!", "B", "was ranked up to become a");
	DefineBoss(10, "TricksterGiovanni", "\cmTrickster \cjGiovanni", UHBOSS_POOL_COMMON, 2500, 375, "", "", "M_UB010", "Streets of Rage 2 - Ready Funk", "\ckUse your primary to fire a cluster of explosives!\n\cnUse your item to pull a random trick!\n\cdYour alt grants temporary invisibility!", "", "");
	DefineBoss(11, "IronCurtain", "\cmIron \cdCurtain", UHBOSS_POOL_COMMON, 5000, 415, "", "", "M_UB011", "Final Fight One GBA - Rolento's Theme", "Destroy them all!\n\cdYour attacks are affected by your ammo reserves...", "", "");
	DefineBoss(12, "CaptainBlitzkrieg", "\cmCaptain \ciBlitzkrieg", UHBOSS_POOL_COMMON, 2000, 205, "", "", "M_UB012", "Punchout Wii!! - Vs. Von Kaiser", "\ckUse your primary to show your patients how to be sharp!\n\cdUse your alt to make them screw off!", "", "");
	DefineBoss(13, "DicksterDick", "\cmDickster \cdDick", UHBOSS_POOL_COMMON, 1250, 265, "", "", "M_UB013", "Wario Land 3 - Final Boss (Sped-up)", "H-Heh... They will never catch me! I'm so fast and light, they will never see me c-coming.\nI can dodge everything with my \ckprimary\cj and jump higher with my \cdsecondary\cj...", "Ek!", "Oh no! it's");
	DefineBoss(14, "SovietFrostBite", "\cmSoviet \cnFrostbite", UHBOSS_POOL_COMMON, 2500, 495, "", "", "M_UB014", "Alan Parsons Project - Cask of Amontillado (Sped-Up)", "Eliminate all hostiles, for the motherland!\n\ckUse your primary to blast enemies with a chill!\n\cdGive them the cold shoulder with your alt!", "", "");
	DefineBoss(15, "SovietIgniter", "\cmSoviet \ciIgniter", UHBOSS_POOL_COMMON, 2500, 415, "", "", "M_UB014", "Alan Parsons Project - Cask of Amontillado (Sped-Up)", "Eliminate all hostiles, for the motherland!\n\ckUse your primary to torch your enemies!\n\cdYour alt can unleash a fireball spread and turn all into ash!", "", "");
	DefineBoss(16, "RepairManEdward", "\cmRepairman \cfEdward", UHBOSS_POOL_COMMON, 2100, 333, "", "", "M_UB016", "Gundam Wing Endless Duel (SNES) - Arctic", "\ckRepair people's faces with your primary!\n\cdYour alt attack can shock people around you!", "", "");
	DefineBoss(17, "RNCClashman", "\cuRNC \ctClashman", UHBOSS_POOL_COMMON, 2500, 525, "", "", "M_UB017 12", "Nettou King of Fighters 96 - Mr. Karate theme", "\ckUse your primary and fire under your enemies if you can!\n\cdUse your alt to let loose a deadly bomb that can drop from ceilings!", "", "");
	DefineBoss(18, "ArchArcanist", "\ctArch \cmArcanist", UHBOSS_POOL_COMMON, 2750, 515, "", "", "M_UB018", "Final Fantasy Legend II SNES Mix - Boss Battle - Dreadful Battle", "\cuThe time has come to release terror into people's lives. \n\cnThe item ability swaps magic sets.\n\cjEach spell has their uses...", "C", "approaches");
	DefineBoss(19, "MeguhMang", "\chMeguh Mang", UHBOSS_POOL_COMMON, 3500, 155, "", "", "*", "None", "\ckYour primary fires an exploding shot where you aim!\n\cdUse your alt for \ciRAWSH COIL\cd!", "", "");
	DefineBoss(20, "Magnetismo", "\chMagnetismo", UHBOSS_POOL_COMMON, 2000, 300, "", "", "M_UB020", "X-Men: Children of the Atom - Magneto's Theme", "\ckYour primary fires a cluster of magnet bombs.\n\cnYour item creates a magnetic pulse that shoots metal chunks around you!\n\cdYour alt fires a single short range homing magnet bomb!\n\cgRage for Magnet Pull!", "", "");
	DefineBoss(21, "ShinNegaman", "\cmShin \ctNegaman", UHBOSS_POOL_COMMON, 3000, 295, "", "", "M_UB021", "Street Fighter Alpha 3 - Cody's Theme/Stripes", "\cdUse alt to kick people right in the balls!\n\cnUse your item for a random nega weapon...\n\ckOr you could be a real pro and pew-pew away at enemies with your primary...", "", "");
	DefineBoss(22, "GemBanker", "\cvGem Banker", UHBOSS_POOL_COMMON, 2500, 395, "", "", "M_UB022", "Sonic Mania - Mean Bean Machine", "\ckYour primary shoots an assortment of colored crystals for purchase.\n\cdAlt for \cgrage\cd: \cvBank Breaker\cd!", "", "");
	DefineBoss(23, "Dixieandoff", "\cfDixieandoff", UHBOSS_POOL_COMMON, 2775, 385, "", "", "M_UB023", "Fire Emblem - Strike", "\ckYour primary fires a bouncy metal ball that sits and then returns!\n\cdYour alt lets you use your mace to leap and create a shockwave on landing.\n\cjRage: \cgCRITICAL STRIKE!", "", "");
	DefineBoss(24, "GENERICBOSS", "\cgTHE GENERIC BOSS", UHBOSS_POOL_COMMON, 3500, 550, "", "", "M_UB024 5", "Mighty Final Fight - Troublesome Opponent (Boss BGM)", "\ckUse your mainfire to punch people!\n\cnUse your item to superjump!\n\cdAlt for rage: \cgSUPER DEFENSE BOOST!!", "", "");
	DefineBoss(25, "TrueBusterMistress", "\cmTrue \cqBuster Mistress", UHBOSS_POOL_COMMON, 3525, 325, "", "", "M_UB025", "Fatal Fury 3 - C62 Shirokuni (Ryuji Yamazaki 2 Theme)", "\ckUse your primary to fire a Holographic Shot!\n\cdUse your alt for a Tri-Holographic Shot.\n\cnUse your item to summon a Clone Upper!\n\ciYou also have several clone Pandora Box items.", "", "");
	DefineBoss(26, "CuttyCut", "\caCutty Cut", UHBOSS_POOL_COMMON, 2150, 255, "", "", "M_UB026 104", "Pok\xE9mon Crystal Complete - Battle! Wild Pok\xE9mon (Naljo)", "\ckFire to throw your totally reliable cutter!\n\cdAltfire to slice, sorta..!\n\cjGet \cgmad\cj on each KO!", "Ck.", "enters the ring");
	DefineBoss(27, "Pharaohman4MI", "\ckPharaohman", UHBOSS_POOL_COMMON, 2500, 245, "", "", "M_UB027", "Final Fight - Andore Cage Fight (Sped-up)", "\ckUse your primary for Pharaoh Shotgun!\n\cdUse your alt for Pharaoh Wave!\n\cjDon't worry, your \cgtrue power\cj will be realized soon...", "", "");
	DefineBoss(28, "Skullman4MI", "\cjSkullman", UHBOSS_POOL_COMMON, 2250, 240, "", "", "M_UB027", "Final Fight - Andore Cage Fight (Sped-up)", "\ckUse your primary for Skull Buster!\n\cdUse your alt for Hell Wheel!\n\cjDon't worry, your \cgtrue power\cj will be realized soon...", "", "");
	DefineBoss(29, "AstromancerComplex", "\ctAstromancer Crasher", UHBOSS_POOL_COMMON, 2000, 235, "", "", "M_UB029", "Ristar - Battle Theme - Crazy Kings", "\ckUse your primary for lovely homing Star Crash!\n\cdUse alt for Star Rain!\n\cgRage for Pinpoint Meteor Attack!", "", "");
	DefineBoss(30, "AstromancerSimple", "\ctAstromancer Crusher", UHBOSS_POOL_COMMON, 2000, 235, "", "", "M_UB029", "Ristar - Battle Theme - Crazy Kings", "\ckUse your primary for lovely fast Star Crush!\n\cdAlt for Star Dash!\n\cgRage for Pinpoint Meteor Attack!", "", "");
	DefineBoss(31, "JuggerbroGold", "\cfJuggerbro Gold", UHBOSS_POOL_COMMON, 4850, 485, "", "", "M_UB031", "Final Fantasy USA: Mystic Quest - Boss Theme", "\ckUse your primary to fire Golden Screws!\n\cdAlt turns yourself into a bouncing projectile!\n\cjYou have great power but not speed!", "", "");
	DefineBoss(32, "JuggerbroSilver", "\cuJuggerbro Silver", UHBOSS_POOL_COMMON, 4550, 455, "", "", "M_UB031", "Final Fantasy USA: Mystic Quest - Boss Theme", "\ckUse your primary to fire splitting Silver Screws!\n\cdAlt turns yourself into a ramming projectile!\n\cjYou are faster but not as powerful!", "", "");
	DefineBoss(33, "RedBaronDuo", "\crRed Baron", UHBOSS_POOL_COMMON, 3500, 265, "", "", "M_UB033", "Contra III: The Alien Wars - Ground Zero", "\crDo you see \chBlue Jay\cr? \cgDESTROY HIM!\n\cdTry your altfire for deadly missiles.\n\cjIf you don't see \chBlue Jay\cj, \cgDESTROY EVERYONE\cj!", "", "");
	DefineBoss(34, "BlueJayDuo", "\chBlue Jay", UHBOSS_POOL_COMMON, 4250, 315, "", "", "M_UB033", "Contra III: The Alien Wars - Ground Zero", "\chDo you see \crRed Baron? \cnDESTROY HIM!\n\cdTry your altfire for blasting missiles.\n\cjIf you don't see \crRed Baron\cj, \cgDESTROY EVERYONE\cj!", "", "");
	DefineBoss(35, "RedTankBot", "\cgRed TankBoi", UHBOSS_POOL_COMMON, 3375, 425, "", "", "M_UB035", "Final Fight One GBA - Rolento's Theme (Sped-up)", "Defeat all the other players!\nYou have the \cgpower\cj!\n\cdAlt to bounce forward!", "", "");
	DefineBoss(36, "BluTankBot", "\chBlue TankBoi", UHBOSS_POOL_COMMON, 3750, 415, "", "", "M_UB035", "Final Fight One GBA - Rolento's Theme (Sped-up)", "Defeat all the other players!\nYou have the \chresistance\cj!\n\cdAlt to bounce around!", "", "");
	DefineBoss(37, "YelTankBot", "\ckYellow TankBoi", UHBOSS_POOL_COMMON, 3075, 355, "", "", "M_UB035", "Final Fight One GBA - Rolento's Theme (Sped-up)", "Defeat all the other players!\nYou have the \ckspeed\cj!\n\cdAlt to bounce upward!", "", "");
	DefineBoss(38, "RedHero", "\cgRed Anti-Unholy Elite", UHBOSS_POOL_COMMON, 2500, 375, "", "", "M_UB038X", "FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)", "Defeat all the other players!\n\ciYou have high power!", "", "");
	DefineBoss(39, "BlueHero", "\chBlue Anti-Unholy Elite", UHBOSS_POOL_COMMON, 2500, 450, "", "", "M_UB038X", "FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)", "Defeat all the other players!\n\ciYou have balanced strengths!", "", "");
	DefineBoss(40, "YellowHero", "\ckYellow Anti-Unholy Elite", UHBOSS_POOL_COMMON, 2500, 400, "", "", "M_UB038X", "FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)", "Defeat all the other players!\n\ciYou have high speed!", "", "");
	DefineBoss(41, "PurpleHero", "\ctPurple Anti-Unholy Elite", UHBOSS_POOL_COMMON, 2500, 325, "", "", "M_UB038X", "FamiPico 3 - Frozen Mountain (Power Rangers: The Movie)", "Defeat all the other players!\n\ciYou have spread shooting!", "", "");
	DefineBoss(42, "Speciman", "\ccSpeciman", UHBOSS_POOL_COMMON, 2450, 365, "", "", "M_UB042 5", "Earthbound Beginnings - Battle Against a Dangerous Foe", "THE ECONOMY LACKS ESTABLISHMENT. To save the economy, kill anti-economic people. \ckAssume\cj a blast that explodes! \cdAssume\cj a shield that protects! \cnAssume\cj a flash that does something!", "C", "draws near");
	DefineBoss(43, "RedSpeciman", "\cgRed Speciman", UHBOSS_POOL_COMMON, 2850, 325, "", "", "M_UB042 5", "Earthbound Beginnings - Battle Against a Dangerous Foe", "THE OVEN IS \cgBURNING\cj. To save the oven, annihilate fridge-fanatics. \ckAssume\cj a chargeable fire shot! \cdAssume\cj a little eruption of fire! \cnAssume\cj a flash that does something!", "C", "draws near");
	DefineBoss(44, "BlueSpeciman", "\chBlue Speciman", UHBOSS_POOL_COMMON, 2550, 310, "", "", "M_UB042 5", "Earthbound Beginnings - Battle Against a Dangerous Foe", "THE FRIDGE IS \chRUNNING\cj. To save the fridge, annihilate oven-lovers. \ckAssume\cj a freezing explosive which can be detonated manually! \cdAssume\cj a quick teleport! \cnAssume\cj a flash that does something!", "C", "draws near");
	DefineBoss(45, "YellowSpeciman", "\cfYellow Speciman", UHBOSS_POOL_COMMON, 1750, 315, "", "", "M_UB042 5", "Earthbound Beginnings - Battle Against a Dangerous Foe", "THE LAUNDRY-MACHINE IS \ckMALFUNCTIONING\cj. To save the laundry-machine, annihilate coathangers. \ckAssume\cj a deadly thunder attack, It might miss! \cdAssume\cj annoying stun! \cnAssume\cj a flash that does something!", "C", "draws near");
	DefineBoss(46, "GutsBuddy", "\ciGuts Buddy", UHBOSS_POOL_COMMON, 3850, 355, "", "", "M_UB046 6", "River City Ransom (NES) - A Tough Fight", "\ciDun Dunnnnn!. \cjYou are \ciGuts Buddy\cj, help people! \n\ckThrow a rock! \n\cdOr punch people! \n\cnOr even cause a quake!", "C", "appears");
	DefineBoss(47, "RussianGuts", "\cvRussian \ccGutsman", UHBOSS_POOL_COMMON, 3275, 350, "", "", "M_UB047", "Skyward Sword - Stalmaster Battle", "I come to destroy capitalist land, is nice. \n\ckPick up boulders with primary clicking button, click again to throw them.\n\cdSecondary clicking button punches sad loser, very good.\n\cjMighty communist force of grabbing boulder and then hitting \cdpunch\cj button \nwill allow me to \cdtoss boulder\cj up to sky. \cdPunch\cj tossed boulder to obliterate foes.\nOnce my wrath hits it's boiling point, is time to initiate \cgDeathblow\c- throw.", "C", "appears");
	DefineBoss(48, "RedeadGuts", "\cqRedead \ccGutsman", UHBOSS_POOL_COMMON, 6850, 345, "", "", "M_UB048", "Zombies Ate My Neighbors - Evening of the Undead", "To be replaced by tetrimos is humiliating.\nTo be forgotten is worse than death.\nBut I awaken once more, to get the job done.\nBack at it again \ckthrowing\cj out boulders with my greater arm.\n\cdRam\cj and \cnslam\cj back at the construction sites.\nI might be slow, but I'm \cidetermined\cj to get revenge.", "C", "reawakens");
	DefineBoss(49, "Troutius", "\ciTroutius", UHBOSS_POOL_COMMON, 2500, 366, "", "", "M_UB049", "Pok\xE9mon Sun & Moon - Battle! Gladion (Bulby's cover)", "It's not a phase.\nI \ckshoot\cj, I \cdkick\cj and deny society because I'm Troutius.\nYou don't control my life, I make my own decisions because I am the edge of the night.\nSharp enough, it makes me crawl in my skin.", "Ck.", "appears, because yes");
	DefineBoss(50, "HalfPressHardman", "\ckHalfPress \chHardman", UHBOSS_POOL_COMMON, 2460, 412, "", "", "M_UB050", "Shadic64 - Super Hardman 64 (Sped-up)", "\ckMainfire to give them the ol' one-two combo.\n\cdAltfire for a super press; more air time for more power.\n\cgRage to warp onto a random player.", "C", "returns again");
	DefineBoss(51, "WarRockStelar", "\cdWar Rock Stelar", UHBOSS_POOL_COMMON, 4065, 350, "", "", "M_UB051", "Mega Man Star Force 1 - Ride On", "My name is (You don't need to remember), Geo Stelar, age 15.\nThe past month to me is only my father disappearing while \nworking in the satellite that brings really exciting and worrying days.\n\nUntil I met this space dog.......\n\n\ckFire bullets, don't fire to build up power!\n\cdCreate a shield to block things!\n\cnThe ability to use a sword up-close!", "", "");
	DefineBoss(52, "HarpStrumm", "\cdHarp Strumm", UHBOSS_POOL_COMMON, 3950, 335, "", "", "M_UB051", "Mega Man Star Force 1 - Ride On", "Haha, wow! Are we in the battlefield now?\nLet's blast their ears with some tunes they'll never forget!\nTons of genres to play! Pick one and knock them dead!\nFrom here, we'll be a **\ca**shooting star **\c-**!", "", "");
	DefineBoss(53, "TidalTito", "\cvTidal \chTito", UHBOSS_POOL_COMMON, 3365, 337, "", "", "M_UB053", "Crash Bandicoot 2: N-Tranced - Wakeboard", "'Ey brotha, \cvTidal \chTito \c-here.\nWould you like to know the ways of the ocean? Good.\nIt ebbs and flows, just like my heart.\n\cfWeak but quick \c-at its lowest, \cgstrong yet slow \c-at its highest.\nA surfer's soul resonates with this, remember that always.", "", "");
	DefineBoss(54, "VoidWalker", "\ctVoid Walker", UHBOSS_POOL_COMMON, 4750, 385, "", "", "M_UB054", "Final Fantasy 4 Advance - Boss Theme", "I am a wanderer of the void, nowhere important.\nI have mastered the elements, test this power with care. (M1/M2)\nI might need all four to win, maybe... (Item)\nNow... \ctEn-Garde!", "", "");
	DefineBoss(55, "CrazedGrenademan", "\cgCrazed \ciGrenademan", UHBOSS_POOL_COMMON, 3865, 387, "", "", "M_UB055", "Super Mario RPG - Docaty Mountain Railroad", "What'll it be, fellas? Carnage or Chaos? \nThere ain't a choice for anyone cause they mean the same thin'! \nSo how 'bout we light up this 'ere fuses and paint the town red? \nThen we can celebrate with a dance where we both clash heads, I ain't dazed I swear it! \nWith a bit more \camoonshine\c-, I'm sure these explosives will be even more pretty...", "", "");
	DefineBoss(56, "MorshuBoss", "\cqMorshu", UHBOSS_POOL_COMMON, 3310, 302, "", "", "M_UB056", "Wario: Master of Disguise - Boss Theme (Slightly Sped Up)", "It's time to get richer!\nBombs on the M1, you want it?\nLamp oil molotov cocktails? It's yours, on the M2.\nRope? It's an item, you'll have to give me CREDIT.", "", "");
	DefineBoss(57, "TheCommandoChamp", "\cdThe \cqCommando \cdCHAMP", UHBOSS_POOL_COMMON, 4250, 350, "", "", "M_UB057", "The King of Fighters '98 - Rumbling on the City (Slightly Faster)", "Are you a bad enough dude?\nAuthorized command to initiate \cgOperation Deathblow\c-.\nFire the missiles and scatter the mines.\nCapture hostiles and show them basic illegal CQC.\nBe the ideal patriot, today.", "", "");
	DefineBoss(58, "JoeOfDuty", "\cqJoe", UHBOSS_POOL_COMMON, 2000, 250, "", "", "M_UB058", "Advance Wars: Days of Ruin - Days of Ruin (slightly altered)", "Note from HQ to \cqJoe\c-.\nGun down armed hostiles at all costs.\nYou are efficient at close quarters.\nDon't pick fights you can't win.\nAnd remember the main objective...\n\nKill \cgHitler\c-.", "", "");
	DefineBoss(59, "Balrog", "\ciBalrog", UHBOSS_POOL_COMMON, 3750, 550, "", "", "M_UB059", "Cave Story - Eyes of Flame (Parabeetle X's cover)", "\cgHUZZAH!\c- Oh Yeaaaaah! \nLet's get to the point. I grab people, they die. \nI hover up and fire missiles and they die. \nAnd I can just pick them off with these basic projectiles. \nIs this in-character? Probably not, but I don't care!", "", "");
	DefineBoss(60, "Misery", "\cdMisery", UHBOSS_POOL_COMMON, 2500, 375, "", "", "M_UB059", "Cave Story - Eyes of Flame (Parabeetle X's cover)", "\ccOh, what a bother. Not THIS again... \n\c-Let's get to the point. I prefer if people weren't in my proximity. \nI can channel more energy to cast upon a deadlier spell, just enough to really get them out of my sight. \nOr how about just making sure they stay six feet under? Or obliterating them into nothing but ashes. \nFufufu...", "", "");
	DefineBoss(61, "ChieftainTomahawk", "\ciChieftain Tomahawk", UHBOSS_POOL_COMMON, 3700, 365, "", "", "M_UB061", "Mario Golf: Advanced Tour - Dunes Club Doubles Match (Sped up)", "Trespassers beware! \nWe have grown weary enough to take action and repel those who threaten us. \nFor I take the mantle as \ciChieftain\c- and the tool for this is the almighty tomahawk...", "", "");
	DefineBoss(62, "TorontoCalifornia", "\ccAgent TorCal", UHBOSS_POOL_COMMON, 1500, 250, "", "", "M_UB062", "Streets of Rage 2 - Never Return Alive", "Infiltration success. \nThis isn't fantasy, it's real life. I've no need for a gun when I got my own hand. \nI got the tactical gear to stay out of enemy sight and catch them by surprise. \nBut just how many times can I undo my mistake-- Mistakes? No... \nI'm the best there is.", "", "");
	DefineBoss(63, "PlasmaSpark", "\cdPlasma \cjSpark", UHBOSS_POOL_COMMON, 2150, 300, "", "", "M_UB063", "Alien Vs. Predator (SNES) - City", "There's never enough energy to burn. At least, I think...? \nI'm able to build up power just by moving around, enough to fire a shocking projectile. The more, the better. \nDon't get too close or it'll be a electrifying revelation to you that I can fry you! \nI'm not a villain or anything, I'm just on my way to work... at Walmart.", "", "");
	DefineBoss(64, "MeisterWahwee", "\ctMeister \cjWahwee", UHBOSS_POOL_COMMON, 3500, 250, "", "", "M_UB064", "The King of Fighters '94 - Getsutou R&D", "Ze plan of zuday vill not faild. \nZe are surprises voh zem. A vather, \ckshocking\c- surprise. \nVonce ze mecha iz thrashed... ze gears will ve in motion...", "", "");
	DefineBoss(65, "ArenaDemoneye", "\ctDemoneye", UHBOSS_POOL_COMMON, 2500, 500, "", "", "M_UB065", "Kirby Superstar (SNES) - Gladiator Kirby", "\cd+ \cjFighting for a paycheck\n\cg- \cjDying to a paycut", "", "");
	DefineBoss(100, "HellBot", "\c[UB100]HellBot", UHBOSS_POOL_RARE, 6666, 0, "", "", "M_UB100", "Earthbound - Giygas Form 2", "My power... I will show them all the \cgHelltatoru\cj.\n\cmBut...can I really control it?\n\cdMy alt shows the true power of the Raging Demon, yet my armor can only do so much...", "Eg!", "ALL SEVEN SINS COMBINE TO SUMMON");
	DefineBoss(101, "CXAirMan", "\chAir Man", UHBOSS_POOL_RARE, 3050, 375, "", "", "M_UB101 13", "Keitai Denjuu Telefang - Boss Battle", "\ckYour primary shoots 3 bullets in a spread formation.\n\cdAlt is your \cgrage\cd. It shoots out multiple homing Air Shooters.\n\cnItem will teleport you to another part of the map while leaving Air Shooters.", "", "");
	DefineBoss(102, "SinfulBusterExpert", "\cmSinful \cuBusterExpert", UHBOSS_POOL_RARE, 6500, 450, "", "", "M_UB102", "Street Fighter Alpha 3 - Final M. Bison's Theme", "The power of all the sins are yours to control...\n\cdUse your rage by pressing altfire.\n\cnUse your item to swap weapons!", "", "");
	DefineBoss(103, "SirAlpha", "\ciA\cmlpha", UHBOSS_POOL_RARE, 3500, 275, "", "", "M_UB103", "Fire Emblem Seisen no Keifu - Versus Yurius", "Hmph, How old fashioned, I'll dance around my enemies if I have to.\n\ckPrimary Attack, A cutting slash. Close-Ranged.\n\cdAlternative Attack, Alphan-Slash. Long-Ranged \n\cnSpecial Attack, Rising Upper. It's an uppercut.", "Cc", "prepares for a brawl");
	DefineBoss(104, "SadFaceToadMan", "\cdToadman", UHBOSS_POOL_RARE, 3500, 275, "", "", "M_UB104", "Pok\xE9mon Colosseum: Miror B.'s Retro Groove", "You are the saddest Toadman alive. You only want to be praised.\n\ckCry acid tears\cj but people will stop you.\n\cdHop Hop Hop\cj because you'll be Mad.", "", "");
	DefineBoss(105, "SuperSpeciman", "\cfSuper \ccSpeciman", UHBOSS_POOL_RARE, 1350, 415, "", "", "M_UB042 5", "Earthbound Beginnings - Battle Against a Dangerous Foe", "THE ECONOMY IS IN \cfGRAVE DANGER\cj. To save the economy, help others. \ckAssume\cj a powerful beam! \cdAssume\cj health insurance! \cnAssume\cj a protective shield!", "C", "draws near");
	DefineBoss(106, "GhostSpeciman", "\ctGhost of Speciman", UHBOSS_POOL_RARE, 3150, 450, "", "", "M_UB106", "Earthbound - Battle Against a Machine", "THE ECONOMY IS \ctDEAD\cj. To reanimate the economy, obtain insurance. \ckAssume\cj a menacing smile..? But better yet, \ckAssume\cj a pin-point meteor storm! Enough points on \cdcredit card\cj means \cgdeadly meteors\cj!", "C", "draws near");
	DefineBoss(107, "Rogue", "\ctRogue", UHBOSS_POOL_RARE, 2750, 265, "", "", "M_UB107", "Mega Man Star Force 2 - Wave Battle", "I do not need others... I need only the power of Mu to punish those who punished me.\nI can easily adjust my techniques with that new gadget I just made...\nMu granted me the power to conquer death if I come close to it.\nIf all else fails... then they will taste the fury of \ctROGUE BREAK\cj.", "", "");
	DefineBoss(108, "GBeast", "\c[UB108]G-Beast", UHBOSS_POOL_RARE, 3725, 306, "", "", "M_UB108Z", "Mega Man Battle Network 4.5 - Net Battle 1", "Primary: Gregar Buster. It fires fast!\nItem switches your cross.\nAlt for Cross attacks, you have five of them.\nRage: \cgPrimal Beast-Over!", "C", "thrashes onto the scene");
	DefineBoss(109, "FBeast", "\c[UB109]F-Beast", UHBOSS_POOL_RARE, 3250, 345, "", "", "M_UB108Z", "Mega Man Battle Network 4.5 - Net Battle 1", "Primary: Falzar Buster. Fire sharp feathers in bursts!\nItem switches your cross.\nAlt for Cross attacks, you have five of them.\nRage: \cgPrimal Beast-Over!", "C", "swoops onto the scene");
	DefineBoss(110, "TropicalMWS", "\ckTropical \ckMWS", UHBOSS_POOL_RARE, 2000, 295, "", "", "M_UB110", "Advance Wars - Dual Strike: Grimm's Theme", "\ckFire coconuts! Slide on what they leave behind!\n\cdAltfire illegal pineapple juice!\n\cnItem for \cgrage\cn! Make people chill out!\n\cjRad moves are to find out on your own!", "C", "requires a cow, man");
	DefineBoss(111, "DLCCentaurman", "\cdDLC Centaurman", UHBOSS_POOL_RARE, 3500, 385, "", "", "M_UB111 2", "Jetter - Summer Carnival 92: Recca", "Congratulations, you have purchased some fancy horse armor. But it was sold out so here's a centaur instead.\n\ckMainfire fires a spread of arrows, or an explosive arrow if you have full power.\n\cnUse your item to enter another dimension and press \ckMain \cnto fire a trick shot or \cdAlt\cn to return to reality with a boom.\n\cjWith full \cgrage\cj, Press \cdAlt\cj to stop time. Press \ckMain\cj to fire arrows or \cdAlt\cj to place bombs- these will trigger when time returns to normal.", "", "");
	DefineBoss(112, "Clownpiece", "\ctClownpiece", UHBOSS_POOL_RARE, 2500, 375, "", "", "M_UB112", "TrojanHorse711 - Pierrot of the Star Spangled Banner", "\ckMainfire will shot a left-to-right star spread!\n\cdUse your altfire to shot lasers!\n\cjIf you get angry, dont waste time and \ckuse\cj your \cgrage\cj!", "", "");
	DefineBoss(113, "Scrotoman", "\chScrotoman", UHBOSS_POOL_RARE, 2000, 365, "", "", "M_UB113", "The Simpsons: Hit & Run - Hit and Run (Sped Up)", "\ckPrimary is chargeable!\n\cnItem turns people into \crUGLY \cgPROTOMEN\c-!\n\cdAltfire to perform a jolt haymaker!", "Ck.", "shows up, just because he can");
	DefineBoss(114, "GraniteMauler", "\caGranite Mauler", UHBOSS_POOL_RARE, 4099, 641, "", "", "M_UB114", "Runescape - Victory is Mine (Sped-up)", "They call me The Mauler.\nI am cheap but clearly the best.\nDropping stacks like the legends before me.\nWith my maximum damage, everyone will sit.", "", "");
	DefineBoss(115, "MagicDevilEye", "\ctMagic \caSpecialist", UHBOSS_POOL_RARE, 2930, 323, "", "", "M_UB115", "VinylCheese - Rude Buster (Kirby NES Style)", "Surprise, surprise! It is I, the notorious demon-devil \ctMagic \caspecialist\cj!\nTo cause havoc is in my veins, enough to ruin their day!\nA wand such as this can cast all sorts of disruptive magic!\nA blast to get them dazed by the glimmering stars or\n\cgcrush their entire life away.\cj.\nTrust me! For my big magic trick will surely blow you away!\n\ccQuite literally...\c-.", "B", "read a book and became a");
	DefineBoss(116, "BlueThwomp", "\chBlue Thwomp", UHBOSS_POOL_RARE, 10000, 464, "", "", "M_UB116", "Super Mario 64 - Main Theme - Bob-Omb Battlefield", "Urg", "", "");
	DefineBoss(117, "Joterra", "\cdJoterra", UHBOSS_POOL_RARE, 2970, 333, "", "", "M_UB117", "Gh0st - Jojo's Bizzare Adventure", "Yare yare daze.\nHow did I end up here?\nThe ability of \cdSTAR CHASER\c- and \cdORIGINAL PLATINUM'S COMET FIST\c- allows me to hit foes out of the range of my stand.\n\nChanneling the power of \cdORIGINAL PLATINUM\c-, it lands devastating blows on foes caught by it and aids me in tricky situations.\n\nThey would rather die quickly than to face \cdORIGINAL PLATINUM'S WRATH\c-.", "F", "Yare Yare Daze, \cdJoterra\c- approaches");
	DefineBoss(201, "GroundMobileD", "\csGround Mobile Driller", UHBOSS_POOL_SPECIAL, 0, 0, "", "", "M_UB201", "Sonic the Hedgehog 2 (Beta) - Boss", "Drill Tank.\nDrill Tank?\nDrill Tank!", "", "");
	DefineBoss(300, "FoxDemoneye300", "\ciFox Demoneye", UHBOSS_POOL_SPECIAL, 1750, 475, "", "", "M_UB300", "Incredible Crisis - De Crane, De Crane", "Guess who is going to win\nThats right, \ciI AM", "", "");
	DefineBoss(301, "AbePenny", "\cmAbe \cuPenny", UHBOSS_POOL_SPECIAL, 3765, 515, "", "", "M_UB301", "Kirby's Return to Dreamland - Boss Theme", "\ckUse your primary to fire that revolver of yours.\n\cdUse your alt to throw dynamites!\n\cnYour item lets you jump high and collect taxes!", "C", "demands more TAXES");
	DefineBoss(302, "RichDevilEye", "\cqDevileye Richman", UHBOSS_POOL_SPECIAL, 1500, 295, "", "", "M_UB302", "Call of Duty: Black Ops 2 - Fire Sale (Sped-up)", "Give money to all the other players with your \ckprimary\cj...\n\cqIT COULDN'T BE MORE SIMPLE!", "Q", "\cqDevileye Richman is on a mad welfare spree\c-!");
	DefineBoss(303, "Cobe", "\ckCobe", UHBOSS_POOL_SPECIAL, 1000, 1000, "", "", "M_UB303", "Modnation Racers - Missed Track 5 (Sped-Up / Cut)", "FILLER TEXT, COBE WANTS HONEY BISCUITS!", "", "");
	DefineBoss(304, "Mikamo_Neru", "\crNeru", UHBOSS_POOL_SPECIAL, 2523, 500, "", "", "M_UB304", "Blue Archive - Track 78 (Fevertime)", "Stop bullshitting.", "", "");
	DefineBoss(305, "TheShadowManMythBoss", "\cnShadowman", UHBOSS_POOL_SPECIAL, 10000, 444, "", "", "M_UB305", "Super Smash Bros Ultimate - Shadowman Stage", "Life? I have no life to give.\n\I deal only in death.", "", "");
	DefineBoss(400, "ZankokunaHellbot", "\cuZankokuna \cmHellbot", UHBOSS_POOL_ULTRA, 30000, 0, "", "", "M_UB400", "Megaman X7 - Sigma Battle Theme 1", "I may not be able to control the \cghelltatoru\cj...\n\chBut I am more than strong enough to destroy them all!", "", "");
	DefineBoss(401, "EyelentoMajor", "\cuEyelento Major", UHBOSS_POOL_ULTRA, 6000, 100, "", "", "M_UB401", "Final Fight Arcade - Rolento's Theme", "\ckMainfire\cj for baton spin.\n\cdAltfire\cj for grenades.\n\cnItem\cj tosses a hat to recruit allies!", "", "");
	DefineBoss(402, "FinalSampi", "\crSampi", UHBOSS_POOL_ULTRA, 4000, 350, "", "", "M_UB402", "Mario & Luigi: Superstar Saga - Final Cackletta Battle", "I expect you to follow these instructions \cgCLEARLY\cj.\n\ckPrimary Fire:\cj Sampi Wave. \n\cdAlternative Fire:\cj Forlorn Fist. \n\cnSeven different items, seven different uses. Let alone for \cgYOU\cn to find out.", "Ec!", "This is it...it's");
	DefineBoss(403, "SPOOKYGHOSTHITLER", "\cmHiglur", UHBOSS_POOL_ULTRA, 1945, 444, "", "", "M_UB403", "Luigi's Mansion - Boolossus Boss", "\ccSie sind der Fuhrer.\nFuhren Deutschland zum Sieg, als Sie in aller Ohr schreien.\nSie sind beangstigend.\nVergessen Sie nicht uber Ihren Kampf.\n\ckPrimary\cj - Spooky Hitler Screaming.", "Cm!", "has started WW3");
	DefineBoss(404, "FinalSpeciman", "\crFinal Speciman", UHBOSS_POOL_ULTRA, 6550, 600, "", "", "M_UB404", "Super Smash Brothers - Master Hand Battle", "OUR INTELLIGENCE ASSUMES SUPERIORITY. \crLEGENDARY ASSUMING!\n\ckAssume\cj a pin-point meteor..which can become more powerful!\n\cdAssume\cj a blast..or a shield..or even a death killing pin-point flash!\n\cnAssume a killer thunder attack in secret..!\n\cgLegendary Assume!", "C", "assumed to draw near");
	DefineBoss(460, "DioFlasho", "\cdDio Flasho", UHBOSS_POOL_ULTRA, 0, 0, "", "", "M_UB459", "Gh0st - Jojo's Bizzare Adventure", "Wheres_the_tips", "", "");
	DefineBoss(509, "BlackDevilEye", "\cmIncognito", UHBOSS_POOL_EX, 2150, 800, "CaptainDevilEye", "", "M_UB509", "Street Fighter Alpha 3 - Crimson (Sped-up)", "You are very similar to a normal Devileye, but you feel...STRONGER.\n\cnItem use:\cm Vile Flare\n\cnA flame that cannot be dodged unless you lose vision.", "", "");
	DefineBoss(510, "JesterGelato", "\cjJester \cmGelato", UHBOSS_POOL_EX, 1250, 305, "TricksterGiovanni", "", "M_UB510", "Fighter's History Dynamite - Clown's Theme", "\ckUse your primary to fire two cluster bombs!\n\cnUse your item to trick everyone!\n\cdYour alt summons a fake-out explosive clone!", "", "");
	DefineBoss(513, "PricksterPrick", "\cmPrickster \cgPrick", UHBOSS_POOL_EX, 2000, 333, "DicksterDick", "", "M_UB513", "Sonic The Hedgehog 3 - Carnival Night Zone (Speed Shoes)", "Your body is filled with the power to chuckle, tell chuckling jokes!\n\ckYour primary thrusts you where you aim!", "E", "Oh no! it's");
	DefineBoss(519, "ThomasTheTrain", "\cnThomas the Tank Engine", UHBOSS_POOL_EX, 3500, 500, "MeguhMang", "", "M_UB519", "Sonic the Very Useful Engine - Thomas and Friends Theme", "\ckUse your primary to charge at your enemies and knock them away!\n\cnUse your item to instantly make coal rain down where you aim.\n\cdUsing the alternate attack uses your \cgrage\cd.\n\cjYour \cgRage\cj allows you to freely fly around and tackle people!", "E", "Uh oh! It's");
	DefineBoss(542, "SpecimanDX", "\cjSpeciman DX", UHBOSS_POOL_EX, 2850, 475, "Speciman", "", "M_UB542", "TrojanHorse711 - Sanctuary Guardian", "THE ECONOMY IS STILL IN \cpDANGER\cj.\nTo save the economy, destroy the anti-economic people.\n\ckAssume\cj an even more powerful beam!\n\cdAssume\cj a better shield!\nTrying to apply another shield on current one makes you spawn a clone thing!\n\cnAssume\cj a pin-point flash that fries visuals!", "C", "draws near");
	DefineBoss(603, "SirAlphaEX", "\cgA\cmlpha \crEX", UHBOSS_POOL_EX, 4650, 375, "SirAlpha", "", "M_UB604", "Guilty Gear XX Accent Core Plus R - Fatal Duel", "No Mercy for the old fashioned.\n\ckPrimary Attack\cj, A Cutting slash that is more powerful.\n\cdAlternative Attack\cj, Buffed Alphan-Slash that is twice as destructive.\n\cnSpecial Attack\cj, Buffed Rising Upper.\n\crFate awaits!", "Cc!", "awaits");
	DefineBoss(613, "ScrotoStuntDouble", "\cdScroto's Stunt Double", UHBOSS_POOL_EX, 2705, 351, "Scrotoman", "", "M_UB613", "Crosscode - The Path of Justice", "\ckCameras are rolling, dude!\n\cjUnholy Battle - Take 613!\n\cgACTION!", "", "");

	// Phase 3 acceptance: auto custom id + explicit mugshot (must stay after vanilla rows)
	DefineBoss(-1, "UHPhase3TestBoss", "\cjUH Phase3 Test", UHBOSS_POOL_COMMON, 2150, 255, "", "UFACE26", "M_UB026 104", "Phase3 test credit", "\ckPhase3 custom boss mugshot test.", "T.", "tests as");
}

script "uh_define_vanilla_bosses" OPEN
{
	if (!UHInPlay()) terminate;
	if (UH_IsBossDefined(0)) terminate;
	uh_RegisterVanillaBossDefs();
}

// Joining clients never run non-CLIENTSIDE OPEN; fill local UHDT here for HUD names.
script "uh_define_vanilla_bosses_cs" OPEN CLIENTSIDE
{
	// Skip UHInPlay: SpawnForced can fail on pure clients; this library only loads with UH.
	if (UH_IsBossDefined(0)) terminate;
	uh_RegisterVanillaBossDefs();
}


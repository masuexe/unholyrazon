}

function int SetItemEnabledCore(int id, int enabled) {
  if (!IsItemDefined(id))
    return UHDB_ERR_NOTFOUND;
  int state = enabled != 0 ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  if (id >= 0)
    uh_itemvanilladefined[id] = state;
  else
    uh_itemcustomstr[ItemCustomIndex(id)][UHITEM_STR_STATE] = state;

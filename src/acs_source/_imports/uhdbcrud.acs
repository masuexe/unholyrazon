}

function int UpdateItemDisplayCore(int id, str name, str icon, str mugshot, str sound) {
  int slot = ItemResolveSlot(id);
  if (slot == UHITEM_FAIL)
    return UHDB_ERR_NOTFOUND;
  if (id >= 0) {
    uh_itemvanillastr[slot][UHITEM_STR_NAME] = name;
    uh_itemvanillastr[slot][UHITEM_STR_ICON] = icon;
    uh_itemvanillastr[slot][UHITEM_STR_MUGSHOT] = mugshot;
    uh_itemvanillastr[slot][UHITEM_STR_SOUND] = sound;
  }
  else {
    uh_itemcustomstr[slot][UHITEM_STR_NAME] = name;
    uh_itemcustomstr[slot][UHITEM_STR_ICON] = icon;
    uh_itemcustomstr[slot][UHITEM_STR_MUGSHOT] = mugshot;
    uh_itemcustomstr[slot][UHITEM_STR_SOUND] = sound;
  }
  return UHDB_OK;
}

function int RemoveItemCore(int id) {
  int i;
  if (!IsItemDefined(id))
    return UHDB_ERR_NOTFOUND;
  for (i = 0; i < uh_itemdropcount; i++) {
    if (uh_itemdropboxid[i] == id || uh_itemdropitemid[i] == id)
      return UHDB_ERR_REFERENCED;
  }
  str actor = GetItemActor(id);
  for (i = 0; i < uh_coinspendcount; i++) {
    if (StrICmp(uh_coinspendgive[i], actor) == 0)
      return UHDB_ERR_REFERENCED;
  }
  for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++) {
    if (uh_asshatpendingused[i] && StrICmp(uh_asshatpendingitem[i], actor) == 0)
      return UHDB_ERR_REFERENCED;
  }
  for (i = 0; i < 64; i++) {
    if (PlayerInGame(i) && CheckActorInventory(1000 + i, actor) > 0)
      return UHDB_ERR_REFERENCED;
  }
  if (id >= 0)
    uh_itemvanilladefined[id] = UHDB_ROW_REMOVED;
  else
    uh_itemcustomstr[ItemCustomIndex(id)][UHITEM_STR_STATE] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetEnabledItemCount(void) {
  int i, count = 0;
  for (i = 0; i < UH_MAX_VANILLA_ITEM; i++)
    if (IsItemEnabled(i)) count++;
  for (i = 0; i < uh_itemcustomcount; i++)
    if (IsItemEnabled(-1 - i)) count++;
  return count;
}

function bool IsLMSEventEnabled(int id) {
  return id >= 0 && id < UH_MAX_LMS_EVENTS
    && uh_lmsdefined[id] == UHDB_ROW_ACTIVE;
}

function int SetLMSEventEnabledCore(int id, int enabled) {
  if (!IsLMSEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  uh_lmsdefined[id] = enabled != 0 ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  return UHDB_OK;
}

function int UpdateLMSEventCore(int id, str message, str raremessage, str penaltymessage,
  str icon, str rareicon, str penaltyicon, int flags, int penaltyflags, int weight) {
  if (!IsLMSEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  if (weight < 0 || weight > UHLMS_MAX_WEIGHT || penaltyflags < 0 ||
      penaltyflags > UHLMS_PENALTY_USE_DEFAULT)
    return UHDB_ERR_BADARG;
  uh_lmsmessage[id] = message;
  uh_lmsraremessage[id] = raremessage;
  uh_lmsicon[id] = icon;
  uh_lmsrareicon[id] = rareicon;
  uh_lmsflags[id] = flags;
  uh_lmsweight[id] = weight;
  SetLMSEventPenaltyCore(id, penaltymessage, penaltyicon, penaltyflags);
  return UHDB_OK;
}

function int RemoveLMSEventCore(int id) {
  if (!IsLMSEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  for (int i = 0; i < uh_lmsdropcount; i++) {
    if (uh_lmsdropeventid[i] == id)
      return UHDB_ERR_REFERENCED;
  }
  uh_lmsdefined[id] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetDefinedLMSEventCount(void) {
  int count = 0;
  for (int i = 0; i < UH_MAX_LMS_EVENTS; i++)
    if (IsLMSEventDefined(i)) count++;
  return count;
}

function int GetEnabledLMSEventCount(void) {
  int count = 0;
  for (int i = 0; i < UH_MAX_LMS_EVENTS; i++)
    if (IsLMSEventEnabled(i)) count++;
  return count;
}

function bool IsBonusEventEnabled(int id) {
  return id >= 0 && id < UH_MAX_BONUS_EVENTS
    && uh_bedefined[id] == UHDB_ROW_ACTIVE;
}

function int SetBonusEventEnabledCore(int id, int enabled) {
  if (!IsBonusEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  if (ACS_NamedExecuteWithResult("uh_GetActiveBonusEvent") == id)
    return UHDB_ERR_REFERENCED;
  uh_bedefined[id] = enabled != 0 ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  return UHDB_OK;
}

function int UpdateBonusEventCore(int id, str name, str music, str title,
  str album, str artist, str sound, str hud1, str hud2,
  str startcb, str rebuildcb, str endcb, int arg1, int arg2, int arg3,
  int flags, int weight, int minplayers, int maxplayers) {
  if (!IsBonusEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  if (ACS_NamedExecuteWithResult("uh_GetActiveBonusEvent") == id)
    return UHDB_ERR_REFERENCED;
  if (weight < 0 || weight > UHBE_MAX_WEIGHT || minplayers < 0
    || maxplayers < 0 || (maxplayers > 0 && maxplayers < minplayers))
    return UHDB_ERR_BADARG;
  uh_bestr[id][UHBE_STR_NAME] = name;
  uh_bestr[id][UHBE_STR_MUSIC] = music;
  uh_bestr[id][UHBE_STR_MUSICTITLE] = title;
  uh_bestr[id][UHBE_STR_MUSICALBUM] = album;
  uh_bestr[id][UHBE_STR_MUSICARTIST] = artist;
  uh_bestr[id][UHBE_STR_SOUND] = sound;
  uh_bestr[id][UHBE_STR_HUD1] = hud1;
  uh_bestr[id][UHBE_STR_HUD2] = hud2;
  uh_bestr[id][UHBE_STR_STARTCB] = startcb;
  uh_bestr[id][UHBE_STR_REBUILDCB] = rebuildcb;
  uh_bestr[id][UHBE_STR_ENDCB] = endcb;
  uh_beint[id][UHBE_INT_ARG1] = arg1;
  uh_beint[id][UHBE_INT_ARG2] = arg2;
  uh_beint[id][UHBE_INT_ARG3] = arg3;
  uh_beint[id][UHBE_INT_FLAGS] = flags;
  uh_beint[id][UHBE_INT_WEIGHT] = weight;
  uh_beint[id][UHBE_INT_MINP] = minplayers;
  uh_beint[id][UHBE_INT_MAXP] = maxplayers;
  return UHDB_OK;
}

function int RemoveBonusEventCore(int id) {
  if (!IsBonusEventDefined(id))
    return UHDB_ERR_NOTFOUND;
  if (ACS_NamedExecuteWithResult("uh_GetActiveBonusEvent") == id)
    return UHDB_ERR_REFERENCED;
  for (int i = 0; i < uh_beexcount; i++) {
    if (uh_beexbase[i] == id || uh_beexevent[i] == id)
      return UHDB_ERR_REFERENCED;
  }
  uh_bedefined[id] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetDefinedBonusEventCount(void) {
  int count = 0;
  for (int i = 0; i < UH_MAX_BONUS_EVENTS; i++)
    if (IsBonusEventDefined(i)) count++;
  return count;
}

function int GetEnabledBonusEventCount(void) {
  int count = 0;
  for (int i = 0; i < UH_MAX_BONUS_EVENTS; i++)
    if (IsBonusEventEnabled(i)) count++;
  return count;
}

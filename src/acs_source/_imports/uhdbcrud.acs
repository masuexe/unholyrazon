// UHDBCRUD — identity-table mutation logic split from UHDT because ACC limits
// each ACS library to 256 functions.  Import-only: UHADDR imports this library.
#library "uhdbcrud"
#include "zcommon.acs"
#import "uhdt.acs"

function int FindBossByActorAllocated(str actor) {
  int i;
  if (StrCmp(actor, "") == 0) return UHBOSS_FAIL;
  for (i = 0; i < UH_MAX_VANILLA_BOSS; i++) {
    if (uh_bossvanilladefined[i] != 0
      && StrICmp(actor, uh_bossvanillastr[i][UHBOSS_STR_ACTOR]) == 0)
      return i;
  }
  for (i = 0; i < uh_bosscustomcount; i++) {
    if (StrICmp(actor, uh_bosscustomstr[i][UHBOSS_STR_ACTOR]) == 0)
      return -1 - i;
  }
  return UHBOSS_FAIL;
}

function void BossPoolRemoveCore(int rarity, int id) {
  if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT) return;
  int count = uh_boss_pool_count[rarity];
  for (int i = 0; i < count; i++) {
    if (uh_bosspoolids[rarity][i] != id) continue;
    for (int j = i + 1; j < count; j++)
      uh_bosspoolids[rarity][j - 1] = uh_bosspoolids[rarity][j];
    uh_boss_pool_count[rarity] = count - 1;
    return;
  }
}

function int SetBossEnabledCore(int id, int enabled) {
  if (!IsBossDefined(id)) return UHDB_ERR_NOTFOUND;
  if (IsBossEnabled(id) == (enabled != 0)) return UHDB_OK;
  int rarity = GetBossRarity(id);
  if (enabled && rarity > UHBOSS_POOL_NONE && rarity < UHBOSS_POOL_COUNT
    && uh_boss_pool_count[rarity] >= UH_MAX_VANILLA_BOSS)
    return UHDB_ERR_CAPACITY;
  if (enabled)
    UH_BossAppendPool(rarity, id);
  else
    BossPoolRemoveCore(rarity, id);
  if (id >= 0)
    uh_bossvanilladefined[id] = enabled ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  else
    uh_bosscustomint[UH_BossCustomIndex(id)][UHBOSS_INT_STATE]
      = enabled ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  return UHDB_OK;
}

function int UpdateBossDisplayCore(int id, str name, str mugshot, str instruction,
  str spawnmessagetype, str spawnmessage, str ragewarning) {
  int slot = UH_BossResolveSlot(id);
  if (slot == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
  if (id >= 0) {
    uh_bossvanillastr[slot][UHBOSS_STR_NAME] = name;
    uh_bossvanillastr[slot][UHBOSS_STR_MUGSHOT] = mugshot;
    uh_bossvanillastr[slot][UHBOSS_STR_INSTRUCTION] = instruction;
    uh_bossvanillastr[slot][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
    uh_bossvanillastr[slot][UHBOSS_STR_SPAWNMSG] = spawnmessage;
    uh_bossvanillastr[slot][UHBOSS_STR_RAGEWARNING] = ragewarning;
  }
  else {
    uh_bosscustomstr[slot][UHBOSS_STR_NAME] = name;
    uh_bosscustomstr[slot][UHBOSS_STR_MUGSHOT] = mugshot;
    uh_bosscustomstr[slot][UHBOSS_STR_INSTRUCTION] = instruction;
    uh_bosscustomstr[slot][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
    uh_bosscustomstr[slot][UHBOSS_STR_SPAWNMSG] = spawnmessage;
    uh_bosscustomstr[slot][UHBOSS_STR_RAGEWARNING] = ragewarning;
  }
  return UHDB_OK;
}

function int UpdateBossStatsCore(int id, int rarity, int basehp, int addhp) {
  int slot = UH_BossResolveSlot(id);
  if (slot == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
  if (rarity < UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT
    || basehp < 0 || addhp < 0) return UHDB_ERR_BADARG;
  int oldrarity = GetBossRarity(id);
  if (rarity != oldrarity && IsBossEnabled(id)
    && rarity > UHBOSS_POOL_NONE
    && uh_boss_pool_count[rarity] >= UH_MAX_VANILLA_BOSS)
    return UHDB_ERR_CAPACITY;
  if (rarity != oldrarity && IsBossEnabled(id)) {
    BossPoolRemoveCore(oldrarity, id);
    UH_BossAppendPool(rarity, id);
  }
  if (id >= 0) {
    uh_bossvanillaint[slot][UHBOSS_INT_RARITY] = rarity;
    uh_bossvanillaint[slot][UHBOSS_INT_BASEHP] = basehp;
    uh_bossvanillaint[slot][UHBOSS_INT_ADDHP] = addhp;
  }
  else {
    uh_bosscustomint[slot][UHBOSS_INT_RARITY] = rarity;
    uh_bosscustomint[slot][UHBOSS_INT_BASEHP] = basehp;
    uh_bosscustomint[slot][UHBOSS_INT_ADDHP] = addhp;
  }
  return UHDB_OK;
}

function int RemoveBossCore(int id) {
  int i;
  if (!IsBossDefined(id)) return UHDB_ERR_NOTFOUND;
  for (i = 0; i < UH_MAX_PLAYERS; i++) {
    if (PlayerInGame(i) && (uh_playerbossid[i] == id || uh_playeractiveboss[i] == id))
      return UHDB_ERR_REFERENCED;
  }
  if (ACS_NamedExecuteWithResult("uh_IsBossRegistryReferenced", id))
    return UHDB_ERR_REFERENCED;
  for (i = 0; i < uh_bossunmorphcount; i++)
    if (uh_bossunmorphid[i] == id) return UHDB_ERR_REFERENCED;
  for (i = 0; i < uh_bossmusiccount; i++)
    if (IsMusicRowDefined(i) && uh_bossmusicbossid[i] == id)
      return UHDB_ERR_REFERENCED;
  str actor = GetBossActor(id);
  for (i = 0; i < UH_MAX_VANILLA_BOSS; i++) {
    if (i != id && uh_bossvanilladefined[i] != 0
      && (uh_bossvanillaint[i][UHBOSS_INT_EXBASEID] == id
        || StrICmp(uh_bossvanillastr[i][UHBOSS_STR_EXBASEACTOR], actor) == 0))
      return UHDB_ERR_REFERENCED;
  }
  for (i = 0; i < uh_bosscustomcount; i++) {
    if (-1 - i != id
      && (uh_bosscustomint[i][UHBOSS_INT_EXBASEID] == id
        || StrICmp(uh_bosscustomstr[i][UHBOSS_STR_EXBASEACTOR], actor) == 0))
      return UHDB_ERR_REFERENCED;
  }
  if (IsBossEnabled(id)) BossPoolRemoveCore(GetBossRarity(id), id);
  if (id >= 0)
    uh_bossvanilladefined[id] = UHDB_ROW_REMOVED;
  else
    uh_bosscustomint[UH_BossCustomIndex(id)][UHBOSS_INT_STATE] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetDefinedBossCount(void) {
  int count = 0, i;
  for (i = 0; i < UH_MAX_VANILLA_BOSS; i++)
    if (IsBossDefined(i)) count++;
  for (i = 0; i < uh_bosscustomcount; i++)
    if (IsBossDefined(-1 - i)) count++;
  return count;
}

function int GetEnabledBossCount(void) {
  int count = 0, i;
  for (i = 0; i < UH_MAX_VANILLA_BOSS; i++)
    if (IsBossEnabled(i)) count++;
  for (i = 0; i < uh_bosscustomcount; i++)
    if (IsBossEnabled(-1 - i)) count++;
  return count;
}

function bool IsSurvivorEnabled(int id) {
  if (id >= 0)
    return id < UH_MAX_VANILLA_SURV && uh_survvanilladefined[id] == UHDB_ROW_ACTIVE;
  int i = SurvCustomIndex(id);
  return i >= 0 && i < uh_survcustomcount
    && uh_survcustomstr[i][UHSURV_STR_STATE] == UHDB_ROW_ACTIVE;
}

// Includes tombstones so a later Define cannot steal an old actor identity.
function int FindSurvivorByActorAllocated(str actor) {
  int i;
  if (StrCmp(actor, "") == 0)
    return UHSURV_FAIL;
  for (i = 0; i < UH_MAX_VANILLA_SURV; i++) {
    if (uh_survvanilladefined[i] != 0
      && StrICmp(actor, uh_survvanillastr[i][UHSURV_STR_ACTOR]) == 0)
      return i;
  }
  for (i = 0; i < uh_survcustomcount; i++) {
    if (StrICmp(actor, uh_survcustomstr[i][UHSURV_STR_ACTOR]) == 0)
      return -1 - i;
  }
  return UHSURV_FAIL;
}

function int SetSurvivorEnabledCore(int id, int enabled) {
  if (!IsSurvivorDefined(id))
    return UHDB_ERR_NOTFOUND;
  int state = enabled != 0 ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  if (id >= 0)
    uh_survvanilladefined[id] = state;
  else
    uh_survcustomstr[SurvCustomIndex(id)][UHSURV_STR_STATE] = state;
  return UHDB_OK;
}

function int UpdateSurvivorDisplayCore(int id, str name, str mugshot) {
  int slot = SurvResolveSlot(id);
  if (slot == UHSURV_FAIL)
    return UHDB_ERR_NOTFOUND;
  if (id >= 0) {
    uh_survvanillastr[slot][UHSURV_STR_NAME] = name;
    uh_survvanillastr[slot][UHSURV_STR_MUGSHOT] = mugshot;
  }
  else {
    uh_survcustomstr[slot][UHSURV_STR_NAME] = name;
    uh_survcustomstr[slot][UHSURV_STR_MUGSHOT] = mugshot;
  }
  return UHDB_OK;
}

// Do not delete an identity currently used by a player actor.
function int RemoveSurvivorCore(int id) {
  if (!IsSurvivorDefined(id))
    return UHDB_ERR_NOTFOUND;
  str actor = GetSurvivorActor(id);
  for (int row = 0; row < uh_survcleanupcount; row++) {
    if (StrICmp(uh_survcleanup[row][0], actor) == 0)
      return UHDB_ERR_REFERENCED;
  }
  for (int p = 0; p < 64; p++) {
    if (PlayerInGame(p) && StrICmp(GetActorClass(1000 + p), actor) == 0)
      return UHDB_ERR_REFERENCED;
  }
  if (id >= 0)
    uh_survvanilladefined[id] = UHDB_ROW_REMOVED;
  else
    uh_survcustomstr[SurvCustomIndex(id)][UHSURV_STR_STATE] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetDefinedSurvivorCount(void) {
  int i, count = 0;
  for (i = 0; i < UH_MAX_VANILLA_SURV; i++)
    if (IsSurvivorDefined(i)) count++;
  for (i = 0; i < uh_survcustomcount; i++)
    if (IsSurvivorDefined(-1 - i)) count++;
  return count;
}

function int GetEnabledSurvivorCount(void) {
  int i, count = 0;
  for (i = 0; i < UH_MAX_VANILLA_SURV; i++)
    if (IsSurvivorEnabled(i)) count++;
  for (i = 0; i < uh_survcustomcount; i++)
    if (IsSurvivorEnabled(-1 - i)) count++;
  return count;
}

function bool IsEyeEnabled(int id) {
  if (id >= 0)
    return id < UH_MAX_VANILLA_EYE && uh_eyevanilladefined[id] == UHDB_ROW_ACTIVE;
  int i = EyeCustomIndex(id);
  return i >= 0 && i < uh_eyecustomcount
    && uh_eyecustomstr[i][UHEYE_STR_STATE] == UHDB_ROW_ACTIVE;
}

function int FindEyeByActorAllocated(str actor) {
  int i;
  if (StrCmp(actor, "") == 0)
    return UHEYE_FAIL;
  for (i = 0; i < UH_MAX_VANILLA_EYE; i++) {
    if (uh_eyevanilladefined[i] != 0
      && StrICmp(actor, uh_eyevanillastr[i][UHEYE_STR_ACTOR]) == 0)
      return i;
  }
  for (i = 0; i < uh_eyecustomcount; i++) {
    if (StrICmp(actor, uh_eyecustomstr[i][UHEYE_STR_ACTOR]) == 0)
      return -1 - i;
  }
  return UHEYE_FAIL;
}

function int SetEyeEnabledCore(int id, int enabled) {
  if (!IsEyeDefined(id))
    return UHDB_ERR_NOTFOUND;
  int state = enabled != 0 ? UHDB_ROW_ACTIVE : UHDB_ROW_DISABLED;
  if (id >= 0)
    uh_eyevanilladefined[id] = state;
  else
    uh_eyecustomstr[EyeCustomIndex(id)][UHEYE_STR_STATE] = state;
  return UHDB_OK;
}

function int UpdateEyeDisplayCore(int id, str name, str prefix, str mugshot) {
  int slot = EyeResolveSlot(id);
  if (slot == UHEYE_FAIL)
    return UHDB_ERR_NOTFOUND;
  if (StrCmp(name, "") == 0 || StrCmp(mugshot, "") == 0)
    return UHDB_ERR_BADARG;
  if (id >= 0) {
    uh_eyevanillastr[slot][UHEYE_STR_NAME] = name;
    uh_eyevanillastr[slot][UHEYE_STR_PREFIX] = prefix;
    uh_eyevanillastr[slot][UHEYE_STR_MUGSHOT] = mugshot;
  }
  else {
    uh_eyecustomstr[slot][UHEYE_STR_NAME] = name;
    uh_eyecustomstr[slot][UHEYE_STR_PREFIX] = prefix;
    uh_eyecustomstr[slot][UHEYE_STR_MUGSHOT] = mugshot;
  }
  return UHDB_OK;
}

function int RemoveEyeCore(int id) {
  if (!IsEyeDefined(id))
    return UHDB_ERR_NOTFOUND;
  str actor = GetEyeActor(id);
  int slot = EyeResolveSlot(id);
  str eventstem;
  if (id >= 0)
    eventstem = uh_eyevanillastr[slot][UHEYE_STR_EVENTSTEM];
  else
    eventstem = uh_eyecustomstr[slot][UHEYE_STR_EVENTSTEM];
  if (StrCmp(eventstem, "") != 0 && FindBonusEventByStem(eventstem) != UHBE_FAIL)
    return UHDB_ERR_REFERENCED;
  for (int p = 0; p < 64; p++) {
    if (PlayerInGame(p) && uh_playereyeid[p] == id)
      return UHDB_ERR_REFERENCED;
    if (StrCmp(actor, "") != 0 && PlayerInGame(p)
      && StrICmp(GetActorClass(1000 + p), actor) == 0)
      return UHDB_ERR_REFERENCED;
  }
  for (int row = 0; row < uh_eyemorphentrycount; row++) {
    if (uh_eyemorphentrykey[row] % UHEM_KEY_BASE - UHEM_KEY_EYEOFF == id)
      return UHDB_ERR_REFERENCED;
  }
  if (id >= 0)
    uh_eyevanilladefined[id] = UHDB_ROW_REMOVED;
  else
    uh_eyecustomstr[EyeCustomIndex(id)][UHEYE_STR_STATE] = UHDB_ROW_REMOVED;
  return UHDB_OK;
}

function int GetDefinedEyeCount(void) {
  int i, count = 0;
  for (i = 0; i < UH_MAX_VANILLA_EYE; i++)
    if (IsEyeDefined(i)) count++;
  for (i = 0; i < uh_eyecustomcount; i++)
    if (IsEyeDefined(-1 - i)) count++;
  return count;
}

function int GetEnabledEyeCount(void) {
  int i, count = 0;
  for (i = 0; i < UH_MAX_VANILLA_EYE; i++)
    if (IsEyeEnabled(i)) count++;
  for (i = 0; i < uh_eyecustomcount; i++)
    if (IsEyeEnabled(-1 - i)) count++;
  return count;
}


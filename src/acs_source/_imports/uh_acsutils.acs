#library "uh_acsutils"
#include "zcommon.acs"

#nocompact

#libdefine ASPECT_4_3 ((4.0) / 3)
#libdefine ASPECT_5_4 1.25
#libdefine ASPECT_16_9 ((16.0) / 9)
#libdefine ASPECT_16_10 1.6
#libdefine ASPECT_17_10 1.7

#libdefine MAX_PLAYERS 64
#libdefine MAX_HEALTH 30000

function int min(int a, int b) {
  if (a < b)
    return a;
  return b;
}

function int max(int a, int b) {
  if (a > b)
    return a;
  return b;
}

function int abs(int x) {
  if (x > 0)
    return x;
  return -x;
}

// Round a fixed-point value to the nearest whole fixed-point value.
function int RoundFixed(int x) {
  return (x + 0.5) & 0xffff0000;
}

function int RoundFixedToInt(int fixednumber) {
  return (fixednumber + 0.5) >> 16;
}

function void ACSUtils_ProgramError(str message) {
  bool client = ConsolePlayerNumber() >= 0;
  bool server = !client;
  str text = "";

  // IsNetworkGame() is only queried clientside, matching ACSUtils' safe
  // Zandronum server/client check without retaining source-port detection.
  if (client)
    server = !IsNetworkGame();

  if (server != client) {
    if (server)
      text = "[\\cgserverside\\c-] ";
    else
      text = "[\\cdclientside\\c-] ";
  }

  text = StrParam(s:text, d:Timer(), s:" ACSUtils error: ", s:message);
  if (!client)
    Log(s:text);

  if (GetCVar("acsutils_noerrors"))
    return;

  PrintBold(s:text);
}

function void SetInventory(str item, int amount) {
  int diff = amount - CheckInventory(item);
  if (diff > 0)
    GiveInventory(item, diff);
  else if (diff < 0)
    TakeInventory(item, -diff);
}

function void SetActorInventory(int tid, str item, int amount) {
  int diff = amount - CheckActorInventory(tid, item);
  if (diff > 0)
    GiveActorInventory(tid, item, diff);
  else if (diff < 0)
    TakeActorInventory(tid, item, -diff);
}

function void ClearHudMessage(int id) {
  HudMessage(s:""; HUDMSG_PLAIN, id, 0, 0.0, 0.0, 0.0, 0.0);
}

function void ClearHudMessageBold(int id) {
  HudMessageBold(s:""; HUDMSG_PLAIN, id, 0, 0.0, 0.0, 0.0, 0.0);
}

// ChangeFlag

// Implementation from ACS-X.

function str ACSUtils_ChangeFlagName(str flag, bool value) {
  return StrParam(s:"ACSUtils_CF_", s:flag, s:"_", d:(!!value));
}

function void ChangeFlag(str flag, bool value) {
  GiveInventory(ACSUtils_ChangeFlagName(flag, value), 1);
}

function void ChangeActorFlag(int tid, str flag, bool value) {
  GiveActorInventory(tid, ACSUtils_ChangeFlagName(flag, value), 1);
}

function int GetActorHealth(int tid) {
  return GetActorProperty(tid, APROP_Health);
}

function int GetAspectRatio(void) {
  if (ConsolePlayerNumber() < 0) {
    ACSUtils_ProgramError("GetAspectRatio() called serverside. Assuming 4:3.");
    return ASPECT_4_3;
  }

  int width = GetCVar("vid_defwidth");
  int height = GetCVar("vid_defheight");
  int nowidescreen = GetCVar("vid_nowidescreen");
  int tft = GetCVar("vid_tft");
  int aspect = GetCVar("vid_aspect");
  switch (aspect) {
    case 1: return ASPECT_16_9;
    case 2: return ASPECT_16_10;
    case 3: return ASPECT_4_3;
    case 4: return ASPECT_5_4;
    case 5: return ASPECT_17_10;
  }
  if (nowidescreen) {
    if (!tft)
      return ASPECT_4_3;
    if (height * ASPECT_5_4 == width << 16)
      return ASPECT_5_4;
    return ASPECT_4_3;
  }
  if (abs((abs(height * ASPECT_16_9) >> 16) - width) < 10)
    return ASPECT_16_9;
  if (abs((abs(height * ASPECT_17_10) >> 16) - width) < 10)
    return ASPECT_17_10;
  if (abs((abs(height * ASPECT_16_10) >> 16) - width) < 60) {
    if ((width == 320 && height == 200) || (width == 640 && height == 400))
      return ASPECT_4_3;
    return ASPECT_16_10;
  }
  if ((height * ASPECT_5_4) >> 16 == width && tft)
    return ASPECT_5_4;
  return ASPECT_4_3;
}

// ---------------------------------------------------------------------------
// Unholy additions (not part of upstream ACSUtils): generic math and actor
// geometry helpers shared via #import.  Formerly in
// classes/shared/math_and_eden_helpers.acs (library UH_CLASSES).
// WARNING: never define or call Round/Floor/Ceil helpers: the default ACC
// zspecial.acs reserves those names as unimplemented engine specials
// (-208/-207/-209), so calls compile to stubs that silently return 0
// (acc distributions that comment the entries out are unaffected).
// Use RoundFixedToInt for fixed-to-int rounding.  For the same reason the
// ceil helper below is named CeilFixedToInt, not Ceil (special -209).
// NOTE: the XYDistance/XYZDistance/ZDistance family is unified here.
// XYDistance uses the precise VectorLength builtin; XYZDistance/ZDistance
// keep integer-unit math (3D fixed-point squaring would overflow 32-bit
// ints).  ZDistance currently has no callers but is kept for future use.
// ---------------------------------------------------------------------------
// Generalized angle fold: steps i one window-span toward [lo, hi] when just
// outside it (single-step semantics shared by the legacy Unholy degrees
// variant and CBM's turns / 0..360 variants; no full normalization).
// Canonical windows:
//   WrapAround(x, -180.0, 180.0)  // degrees, symmetric (Samurai aim drag)
//   WrapAround(x, -0.5, 0.5)      // ACS turns, symmetric
//   WrapAround(x, 0.0, 360.0)     // degrees, positive range
function int WrapAround(int i, int lo, int hi) {
  if (i < lo) return i + (hi - lo);
  if (i > hi) return i - (hi - lo);
  return i;
}

// XYHypot: convenience form of XYHypotFixed (below) that computes the
// VectorAngle itself; use XYHypotFixed when the angle is already available.
function int XYHypot(int x, int y) {
  int len;
  int ang = VectorAngle(x, y);
  if (((ang + 0.125) % 0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  // print(f:len);
  return len;
}

function int GetMaxPlayers(void) {  // From 8bdmlib.acs
  int ret = GetCVar("sv_MaxClients");
  if (PlayerCount() > ret)  // admins can join
    ret = PlayerCount();
  return ret;
}

function int XYZDistance(int tid1, int tid2) {
  int x = GetActorX(tid1) - GetActorX(tid2) >> 16;
  int y = GetActorY(tid1) - GetActorY(tid2) >> 16;
  int z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  int d = Sqrt8(x * x + y * y + z * z);
  return d;
}

function int XYDistance(int tid1, int tid2) {
  int x = GetActorX(tid1) - GetActorX(tid2);
  int y = GetActorY(tid1) - GetActorY(tid2);
  return VectorLength(x, y) >> 16;
}

// Ceiling of a fixed-point number into an integer.  Named CeilFixedToInt:
// "Ceil" is reserved as unimplemented special -209 in the default ACC
// zspecial.acs (silently returns 0 there).  Mathematically identical to the
// base game's 8bdmmath.acs zanCiel and to the former uh_shared Zanceil.
function int CeilFixedToInt(int fixedin) {
  return (fixedin + 65535) >> 16;
}

function int ZDistance(int tid1, int tid2) {
  int z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  return z;
}

// XYZDistance variant whose first anchor is a raw fixed-point position
// instead of a TID; returns integer map units.  (Former uh_shared
// DistanceVal; live caller: FloorQuake radius checks in status_effects.acs.)
function int XYZDistanceFromPoint(int x, int y, int z, int tid2) {
  int dx, dy, dz, d;
  dx = x - GetActorX(tid2);
  dy = y - GetActorY(tid2);
  dz = z - GetActorZ(tid2);
  d = VectorLength(VectorLength(dx, dy), dz) >> 16;
  return d;
}

// Team convenience check: true when the given team differs from the target
// player's team.  Currently no callers; kept for future use.
function bool IsDifferentTeams(int team, int targetnumber) {
  return (team != GetPlayerInfo(targetnumber, PLAYERINFO_TEAM));
}

// Fixed-point cousins of the XY/XYZ/ZDistance family above: they take raw
// offset components (not TIDs) and return fixed point (compare against
// fixed maxdist, or >>16 for map units).  CBM lineage (BUGFIX_F.acs
// fDistanceVal); renamed from the cryptic FDistanceVal.
//   XYZDistanceFixed(x, y, z)  -- full 3D length (dominant-axis projection)
//   XYHypotFixed(ang, x, y)    -- 2D leg; ang must be VectorAngle(x, y)
//   XYZHypotFixed(ang, l2d, z) -- 3D leg; folds z into a 2D length
function int XYZDistanceFixed(int x, int y, int z) {
  int len;

  int ang = VectorAngle(x, y);
  if (((ang + 0.125) % 0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  ang = VectorAngle(len, z);
  if (((ang + 0.125) % 0.5) > 0.25) len = FixedDiv(z, sin(ang));
  else len = FixedDiv(len, cos(ang));

  return len;
}


// 2D leg: fixed hypot of (x, y) with a precomputed VectorAngle.  The
// (ang + 0.125) % 0.5 > 0.25 test picks the dominant axis so FixedDiv stays
// within range.  (CBM fDistanceVal1; renamed from the cryptic suffix.)
function int XYHypotFixed(int ang, int x, int y) {
  int len;
  if (((ang + 0.125) % 0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));
  return len;
}


// 3D leg: folds the vertical component into a 2D fixed length.
// (CBM fDistanceVal2.)  XYZDistanceFixed above is these two legs inlined.
function int XYZHypotFixed(int ang, int len2d, int z) {
  if (((ang + 0.125) % 0.5) > 0.25) len2d = FixedDiv(z, sin(ang));
  else len2d = FixedDiv(len2d, cos(ang));

  return len2d;
}

function int MagnitudeThree(int x, int y, int z) {
  return Sqrt8(x * x + y * y + z * z);
}

function int Sqrt8(int number) {
  if (number <= 3) {
    if (number > 0) {
      return 1;
    }
    return 0;
  }

  int oldans = number >> 1;
  int newans = (oldans + number / oldans) >> 1;

  while (newans < oldans) {
    oldans = newans;
    newans = (oldans + number / oldans) >> 1;
  }

  return oldans;
}


function void ActorPull(int puller, int pullee, int force, int xoff, int yoff, int zoff) {
  int angle = VectorAngle((GetActorX(puller) + xoff) - GetActorX(pullee), (GetActorY(puller) + yoff) - GetActorY(pullee));
  int pitch = PitchBetween(puller, pullee, xoff, yoff, zoff);

  angle = angle >> 8;
  int horizforce = FixedMul(cos(pitch), force << 16) >> 16;
  int vertiforce = FixedMul(sin(pitch), force << 16) >> 16;

  ThrustThing(angle, horizforce, horizforce > 30, pullee);
  ThrustThingZ(pullee, vertiforce * 4, 0, 0);
}

function int PitchBetween(int looker, int target, int xoff, int yoff, int zoff) {
  int x, y, z, ang, pitch, len;
  x = (GetActorX(target) + xoff) - GetActorX(looker);
  y = (GetActorY(target) + yoff) - GetActorY(looker);

  ang = VectorAngle(x, y);
  if (((ang + 0.125) % 0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  z = (GetActorZ(target) - zoff) - GetActorZ(looker);

  pitch = -VectorAngle(len, z);
  return pitch;
}

// Ported from ACSUtils in Trillster's Ping Button

// ACSUtils additions used by the optional PingButton shadow.
// Shared math and 3D HUD drawing; addon options belong in the caller.
function int XYZHypot(int x, int y, int z) {
  return VectorLength(VectorLength(x, y), z);
}

function int TruncFixed(int x) {
  if (x > 0) return x & 0xffff0000;
  return ((x - 1) & 0xffff0000) + 1.0;
}


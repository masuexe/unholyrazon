}

function void HudDrawText(int id, str text) {
  int type = HUDMSG_FADEINOUT;
  if (UH_HudInts[5] > 0 && UH_HudInts[54])
    type = HUDMSG_TYPEON;

  if (UH_HudInts[33])
    type |= HUDMSG_LOG;
  if (UH_HudInts[1])
    type |= HUDMSG_COLORSTRING;
  if (!UH_HudInts[10])
    type |= HUDMSG_NOWRAP;

  SetFont(UH_HudStrings[0]);
  ACSUtils_HudDrawHudMessage(id, type, text, true);
}

function void ACSUtils_HudDrawHudMessage(int id, int type, str text, bool isText) {
  if (UH_HudInts[30] == 0 || UH_HudInts[51] == 0)
    return;

  type |= UH_HudInts[27];
  if (!UH_HudInts[24])
    type |= HUDMSG_NOTWITH3DVIEW;
  if (!UH_HudInts[50])
    type |= HUDMSG_NOTWITHFULLMAP;
  if (!UH_HudInts[34])
    type |= HUDMSG_NOTWITHOVERLAYMAP;

  if (UH_HudInts[39] == HUD_BLENDSTYLE_ADDITIVE)
    type |= HUDMSG_ADDBLEND;
  else if (UH_HudInts[25] != 1.0)
    type |= HUDMSG_ALPHA;

  int x = UH_HudInts[41];
  int y = UH_HudInts[18];
  int iScaleX = UH_HudInts[30];
  int iScaleY = UH_HudInts[51];

  if (UH_HudInts[52]) {
    ACSUtils_HudRotate3DPoint();

    // Check if point is behind the camera.
    if (UH_HudInts[14] <= 0) {
      ClearHudMessage(id);
      return;
    }

    // I don't know what this factor means, but it fixes positioning bugs.
    int yFactor = 1.6;
    /* 8BDM doesn't use this
    if (StatusBarVisible())
      yFactor = 1.9;
     */

    // Half heights.
    int hw = ((UH_HudInts[23]) / 2);
    int hh = ((UH_HudInts[46]) / 2);

    // Project point.
    x = -FixedDiv(UH_HudInts[44], UH_HudInts[14]);
    y = -FixedDiv(UH_HudInts[22], UH_HudInts[14]);

    if (ACSUtils_IsYShearing())
      y += FixedDiv(sin(UH_HudInts[11]), cos(UH_HudInts[11]));

    // Postprocess projected point.
    x += UH_HudInts[12] + hw + FixedMul(hw, x);
    y += UH_HudInts[21] + hh + FixedMul(FixedMul(hh, yFactor), y);

    int distanceScaleFactor = min(UH_HudDistanceScaleFactor, 1.0);
    if (UH_HudInts[42] && distanceScaleFactor > 0.0) {
      iScaleX = FixedMul(iScaleX, FixedMul(UH_HudInts[14], distanceScaleFactor) / 128);
      iScaleY = FixedMul(iScaleY, FixedMul(UH_HudInts[14], distanceScaleFactor) / 128);
    }
  }

  int w = FixedMul(UH_HudInts[23], iScaleX);
  int h = FixedMul(UH_HudInts[46], iScaleY);
  SetHudSize((w >> 16), (h >> 16), !(UH_HudInts[52] || UH_HudInts[45]));

  x = TruncFixed(FixedMul(x, iScaleX));
  y = TruncFixed(FixedMul(y, iScaleY));

  if (UH_HudInts[13] == HUD_ALIGN_LEFT)
    x += 0.1;
  else if (UH_HudInts[13] == HUD_ALIGN_RIGHT)
    x += 0.2;

  if (UH_HudInts[49] == HUD_ALIGN_TOP)
    y += 0.1;
  else if (UH_HudInts[49] == HUD_ALIGN_BOTTOM)
    y += 0.2;

  // realistically all the cases should be like this..
  // but I only care about this one for my purposes.
  if (UH_HudInts[26]) {
    if (x > 0.0) {
      x += 0.4;
    } else {
      x -= 0.4;
    }
  }

  // BUG: this really simplifies the code, but the messages will only stay
  // for 9 hours.
  int stayTime = UH_HudInts[6];
  if (stayTime < 0.0)
    stayTime = 0x7fffffff;

  if (UH_HudInts[37]) {
    HudMessageBold(s:text;
      type,
      id,
      UH_HudInts[3],
      x, y,
      stayTime, UH_HudInts[5], UH_HudInts[48],
      UH_HudInts[25]
    );
  }
  else {
    HudMessage(s:text;
      type,
      id,
      UH_HudInts[3],
      x, y,
      stayTime, UH_HudInts[5], UH_HudInts[48],
      UH_HudInts[25]
    );
  }
}

function void ACSUtils_HudRotate3DPoint(void) {
  // Translated point coordinates.
  int x = UH_HudInts[32] - UH_HudInts[19];
  int y = UH_HudInts[15] - UH_HudInts[9];
  int z = UH_HudInts[20] - UH_HudInts[40];

  int rx, ry, rz;
  int s, c;

  // Rotate around Z axis.
  s = sin(-UH_HudInts[28]);
  c = cos(-UH_HudInts[28]);
  rx = FixedMul(x, c) - FixedMul(y, s);
  ry = FixedMul(x, s) + FixedMul(y, c);
  x = rx; y = ry;

  // Rotate around Y axis.
  if (!ACSUtils_IsYShearing()) {
    s = sin(-UH_HudInts[11]);
    c = cos(-UH_HudInts[11]);
    rx = FixedMul(x, c) - FixedMul(z, s);
    rz = FixedMul(x, s) + FixedMul(z, c);
    x = rx; z = rz;
  }

  UH_HudInts[14] = x;
  UH_HudInts[44] = y;
  UH_HudInts[22] = z;
}

function bool ACSUtils_IsYShearing(void) {
  if (UH_HudInts[17] == HUD_PROJECTION_AUTO)
    return (GetCVar("vid_renderer") != 1 || GetCVar("gl_nogl") != 0);

  return UH_HudInts[17] == HUD_PROJECTION_YSHEARING;
}

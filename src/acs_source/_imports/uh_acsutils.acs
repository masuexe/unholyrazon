}

function void HudSetScaleXY(int scaleX, int scaleY) {
  if (scaleX != 0.0)
    UH_HudInts[30] = FixedDiv(1.0, scaleX);
  else
    UH_HudInts[30] = 0.0;

  if (scaleY != 0.0)
    UH_HudInts[51] = FixedDiv(1.0, scaleY);
  else
    UH_HudInts[51] = 0.0;
}


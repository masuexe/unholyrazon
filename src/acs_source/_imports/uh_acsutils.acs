int UH_HudDistanceScaleFactor = 1.0;

// Configure distance scaling without coupling shared drawing to addon CVARs.
function void HudSetDistanceScaleFactor(int factor) {
  UH_HudDistanceScaleFactor = factor;
}

function int clamp(int x, int a, int b) {
  if (x > b)
    return b;
  if (x < a)
    return a;
  return x;
}

function int lerp(int a, int b, int alpha) {
  return FixedMul(a, 1.0 - alpha) + FixedMul(b, alpha);
}

function void HudResetState(void) {
  UH_HudDistanceScaleFactor = 1.0;
  UH_HudInts[52] = false;


  UH_HudInts[19] = 0.0;
  UH_HudInts[9] = 0.0;
  UH_HudInts[40] = 0.0;
  UH_HudInts[28] = 0.0;
  UH_HudInts[11] = 0.0;

  UH_HudInts[32] = 0.0;
  UH_HudInts[15] = 0.0;
  UH_HudInts[20] = 0.0;

  UH_HudInts[12] = 0.0;
  UH_HudInts[21] = 0.0;

  UH_HudInts[42] = true;
  UH_HudInts[17] = HUD_PROJECTION_AUTO;

  UH_HudInts[23] = 640.0;
  UH_HudInts[46] = 480.0;
  UH_HudInts[45] = false;

  UH_HudInts[41] = 0.0;
  UH_HudInts[18] = 0.0;

  UH_HudInts[30] = 1.0;
  UH_HudInts[51] = 1.0;

  UH_HudInts[37] = false;

  UH_HudInts[5] = 0.0;
  UH_HudInts[6] = HUD_STAYTIME_FOREVER;
  UH_HudInts[48] = 0.0;

  UH_HudInts[39] = HUD_BLENDSTYLE_NORMAL;
  UH_HudInts[25] = 1.0;

  UH_HudInts[24] = true;
  UH_HudInts[50] = true;
  UH_HudInts[34] = true;

  UH_HudInts[27] = HUDMSG_LAYER_OVERHUD;

  UH_HudInts[13] = HUD_ALIGN_CENTER;
  UH_HudInts[49] = HUD_ALIGN_CENTER;
  UH_HudInts[26] = false;
  UH_HudStrings[0] = "SMALLFONT";

// UHEDENISAAC — shared Eden Isaac item registry (main passives + alt actives).
// Imported by UH_CLASSES (gameplay roll) and UH_BARS (HUD icons).
#library "uhedenisaac"

#include "zcommon.acs"
#import "uh_log.acs"

#define EDEN_ISAAC_ALT_CAP 32
#define EDEN_ISAAC_MAIN_CAP 32

#define EDEN_FORM_NONE 0
#define EDEN_FORM_DEVIL 1
#define EDEN_FORM_ANGEL 2

int edenisaac_alt_count = 0;
int edenisaac_alt_id[EDEN_ISAAC_ALT_CAP];
int edenisaac_alt_ammo[EDEN_ISAAC_ALT_CAP];
str edenisaac_alt_pickup[EDEN_ISAAC_ALT_CAP];
str edenisaac_alt_icon[EDEN_ISAAC_ALT_CAP];

int edenisaac_main_count = 0;
int edenisaac_main_id[EDEN_ISAAC_MAIN_CAP];
str edenisaac_main_icon[EDEN_ISAAC_MAIN_CAP];
int edenisaac_main_quality[EDEN_ISAAC_MAIN_CAP];
int edenisaac_main_form[EDEN_ISAAC_MAIN_CAP];

// Fire HUD weapons: single-item and combo registrations (addon OPEN scripts).
#define EDEN_FIRE_SINGLE_CAP 32
#define EDEN_FIRE_COMBO_CAP 16
#define EDEN_FIRE_COMBO_IDS 4

int edenfire_single_count = 0;
int edenfire_single_id[EDEN_FIRE_SINGLE_CAP];
str edenfire_single_wep[EDEN_FIRE_SINGLE_CAP];
int edenfire_single_priority[EDEN_FIRE_SINGLE_CAP];

int edenfire_combo_count = 0;
str edenfire_combo_wep[EDEN_FIRE_COMBO_CAP];
int edenfire_combo_priority[EDEN_FIRE_COMBO_CAP];
int edenfire_combo_idcount[EDEN_FIRE_COMBO_CAP];
int edenfire_combo_id[EDEN_FIRE_COMBO_CAP][EDEN_FIRE_COMBO_IDS];

function int EdenHasItemFlag(int id) {
  return CheckInventory(StrParam(s:"C", i:id, s:"Flag"));
}

// EdenShiny does not need its own weapon; morph keeps the Eden_W stack.
function str EdenDefaultFireWep(void) {
  return "Eden_W";
}

function int EdenFireWepIsBetter(int newpri, int newkind, int newtie, int bestpri, int bestkind, int besttie) {
  if (newpri > bestpri) {
    return 1;
  }
  if (newpri < bestpri) {
    return 0;
  }
  if (newkind > bestkind) {
    return 1;
  }
  if (newkind < bestkind) {
    return 0;
  }
  if (newtie > besttie) {
    return 1;
  }
  return 0;
}

function int EdenComboMaxId(int comboidx) {
  int i;
  int maxid;
  maxid = 0;
  for (i = 0; i < edenfire_combo_idcount[comboidx]; i++) {
    if (edenfire_combo_id[comboidx][i] > maxid) {
      maxid = edenfire_combo_id[comboidx][i];
    }
  }
  return maxid;
}

function int EdenComboMatches(int comboidx) {
  int i;
  for (i = 0; i < edenfire_combo_idcount[comboidx]; i++) {
    if (!EdenHasItemFlag(edenfire_combo_id[comboidx][i])) {
      return 0;
    }
  }
  return 1;
}

function void EdenRegisterFireWep(int id, str wep, int priority) {
  int i = edenfire_single_count;
  if (i >= EDEN_FIRE_SINGLE_CAP) {
    UH_Log(UH_LOG_ERROR, "EdenRegisterFireWep overflow");
    return;
  }
  edenfire_single_id[i] = id;
  edenfire_single_wep[i] = wep;
  edenfire_single_priority[i] = priority;
  edenfire_single_count++;
}

function void EdenRegisterFireWepCombo(str wep, int priority, int id0, int id1, int id2, int id3) {
  int i = edenfire_combo_count;
  int n = 0;
  if (i >= EDEN_FIRE_COMBO_CAP) {
    UH_Log(UH_LOG_ERROR, "EdenRegisterFireWepCombo overflow");
    return;
  }
  if (id0 > 0) {
    edenfire_combo_id[i][n] = id0;
    n++;
  }
  if (id1 > 0) {
    edenfire_combo_id[i][n] = id1;
    n++;
  }
  if (id2 > 0) {
    edenfire_combo_id[i][n] = id2;
    n++;
  }
  if (id3 > 0) {
    edenfire_combo_id[i][n] = id3;
    n++;
  }
  if (n < 2) {
    UH_Log(UH_LOG_ERROR, "EdenRegisterFireWepCombo needs at least 2 ids");
    return;
  }
  edenfire_combo_wep[i] = wep;
  edenfire_combo_priority[i] = priority;
  edenfire_combo_idcount[i] = n;
  edenfire_combo_count++;
}

function str EdenResolveFireWep(void) {
  str best;
  int bestpri;
  int bestkind;
  int besttie;
  int i;

  best = EdenDefaultFireWep();
  bestpri = -1;
  bestkind = 0;
  besttie = 0;

  for (i = 0; i < edenfire_combo_count; i++) {
    if (!EdenComboMatches(i)) {
      continue;
    }
    if (EdenFireWepIsBetter(edenfire_combo_priority[i], 2, EdenComboMaxId(i), bestpri, bestkind, besttie)) {
      best = edenfire_combo_wep[i];
      bestpri = edenfire_combo_priority[i];
      bestkind = 2;
      besttie = EdenComboMaxId(i);
    }
  }

  for (i = 0; i < edenfire_single_count; i++) {
    if (!EdenHasItemFlag(edenfire_single_id[i])) {
      continue;
    }
    if (EdenFireWepIsBetter(edenfire_single_priority[i], 1, edenfire_single_id[i], bestpri, bestkind, besttie)) {
      best = edenfire_single_wep[i];
      bestpri = edenfire_single_priority[i];
      bestkind = 1;
      besttie = edenfire_single_id[i];
    }
  }

  return best;
}

function void EdenSyncFireWeapon(void) {
  str wep;
  EdenEnsureFireWepRegistered();
  wep = EdenResolveFireWep();
  GiveInventory(wep, 1);
  SetWeapon(wep);
}

function void EdenEnsureFireWepRegistered(void) {
  if (edenfire_single_count > 0 || edenfire_combo_count > 0) {
    return;
  }
  EdenRegisterFireWep(678, "Eden678_W", 100);
  // Brimstone's dedicated fire override takes precedence over C-Section.
  EdenRegisterFireWep(118, "Eden118_W", 101);
}

// CI59C### — id 60 → CI59C060 (matches TEXTURES.classes.40_59).
function str EdenDefaultHudIcon(int id) {
  if (id < 10) {
    return StrParam(s:"CI59C00", i:id);
  }
  if (id < 100) {
    return StrParam(s:"CI59C0", i:id);
  }
  return StrParam(s:"CI59C", i:id);
}

function void EdenRegisterAlt(int id, int ammo, str giver, str hudicon) {
  int i = edenisaac_alt_count;
  if (i >= EDEN_ISAAC_ALT_CAP) {
    UH_Log(UH_LOG_ERROR, "EdenRegisterAlt overflow");
    return;
  }
  edenisaac_alt_id[i] = id;
  edenisaac_alt_ammo[i] = ammo;
  edenisaac_alt_pickup[i] = giver;
  if (StrLen(hudicon) > 0) {
    edenisaac_alt_icon[i] = hudicon;
  }
  else {
    edenisaac_alt_icon[i] = EdenDefaultHudIcon(id);
  }
  edenisaac_alt_count++;
}

function int EdenGetMainPickWeight(int quality) {
  if (quality < 0) {
    quality = 0;
  }
  if (quality > 4) {
    quality = 4;
  }
  return 5 - quality;
}

function void EdenRegisterMain(int id, str hudicon, int quality, int form) {
  int i = edenisaac_main_count;
  if (i >= EDEN_ISAAC_MAIN_CAP) {
    UH_Log(UH_LOG_ERROR, "EdenRegisterMain overflow");
    return;
  }
  if (quality < 0 || quality > 4) {
    UH_Log(UH_LOG_WARN, "EdenRegisterMain quality out of range, clamping");
  }
  edenisaac_main_id[i] = id;
  if (quality < 0) {
    edenisaac_main_quality[i] = 0;
  }
  else if (quality > 4) {
    edenisaac_main_quality[i] = 4;
  }
  else {
    edenisaac_main_quality[i] = quality;
  }
  if (form == EDEN_FORM_DEVIL || form == EDEN_FORM_ANGEL) {
    edenisaac_main_form[i] = form;
  }
  else {
    edenisaac_main_form[i] = EDEN_FORM_NONE;
  }
  if (StrLen(hudicon) > 0) {
    edenisaac_main_icon[i] = hudicon;
  }
  else {
    edenisaac_main_icon[i] = EdenDefaultHudIcon(id);
  }
  edenisaac_main_count++;
}

function str EdenLookupMainIconByAmount(int amt) {
  int i;
  if (amt <= 0) {
    return "TNT1A0";
  }
  for (i = 0; i < edenisaac_main_count; i++) {
    if (edenisaac_main_id[i] == amt) {
      return edenisaac_main_icon[i];
    }
  }
  return "TNT1A0";
}

function str EdenLookupActiveItemIcon(void) {
  int i;
  for (i = 0; i < edenisaac_alt_count; i++) {
    if (CheckInventory(StrParam(s:"C", i:edenisaac_alt_id[i], s:"Flag"))) {
      return edenisaac_alt_icon[i];
    }
  }
  return "TNT1A0";
}

function void EdenEnsureVanillaAltRegistered(void) {
  if (edenisaac_alt_count > 0) {
    return;
  }
  EdenRegisterAlt(42, 150, "BobsRottenHeadIsaacItem_P", "");
  EdenRegisterAlt(36, 75, "ThePoopIsaacItem_P", "");
  EdenRegisterAlt(65, 225, "AnarchistCookbookIsaacItem_P", "");
  EdenRegisterAlt(406, 300, "D8IsaacItem_P", "");
  EdenRegisterAlt(477, 300, "VoidIsaacItem_P", "");
  EdenRegisterAlt(485, 300, "CrookedPennyIsaacItem_P", "");
  EdenRegisterAlt(609, 300, "EternalD6IsaacItem_P", "");
  EdenRegisterAlt(396, 75, "VentricleRazorIsaacItem_P", "");
}

function void EdenEnsureVanillaMainRegistered(void) {
  if (edenisaac_main_count > 0) {
    return;
  }
  EdenRegisterMain(118, "", 4, EDEN_FORM_DEVIL);
  EdenRegisterMain(149, "", 4, EDEN_FORM_NONE);
  EdenRegisterMain(315, "", 0, EDEN_FORM_NONE);
  EdenRegisterMain(331, "", 4, EDEN_FORM_ANGEL);
  EdenRegisterMain(356, "", 3, EDEN_FORM_NONE);
  EdenRegisterMain(222, "", 2, EDEN_FORM_NONE);
  EdenRegisterMain(227, "", 1, EDEN_FORM_NONE);
  EdenRegisterMain(371, "", 0, EDEN_FORM_NONE);
  EdenRegisterMain(577, "", 3, EDEN_FORM_NONE);
  EdenRegisterMain(358, "", 0, EDEN_FORM_NONE);
  EdenRegisterMain(678, "", 4, EDEN_FORM_NONE);
}

script "rz_EdenRegisterVanillaAlt" OPEN {
  EdenEnsureVanillaAltRegistered();
}

script "rz_EdenRegisterVanillaMain" OPEN {
  EdenEnsureVanillaMainRegistered();
}

script "rz_EdenRegisterVanillaFireWep" OPEN {
  EdenEnsureFireWepRegistered();
}

// Remote clients do not run the server OPEN scripts. HUD lookups use this
// process's registry, so initialize it locally on every map, including joins.
// The ensure helpers also prevent duplicate rows in single-player/listen play.
script "rz_EdenRegisterVanillaClient" OPEN CLIENTSIDE {
  EdenEnsureVanillaAltRegistered();
  EdenEnsureVanillaMainRegistered();
  EdenEnsureFireWepRegistered();
}

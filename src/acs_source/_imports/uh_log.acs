#library "uh_log"

// UH_LOG — unified four-level diagnostic logger.
//
// Deliberately a separate, minimal library instead of part of uh_acsutils:
// several v6b-derived libraries that need UH_Log already define names
// uh_acsutils also exports (MAX_PLAYERS, ZDistance, SetInventory,
// SetActorInventory, ...), so importing uh_acsutils there fails with
// "Function already has a body" / "Invalid identifier".  A dedicated logger
// lets every Unholy library import one logger without pulling in the whole
// math/utility surface.
//
// ACS has no variadic functions, so callers build the message with
// StrParam(...).  The textual level prefix is part of the message because the
// engine strips colour escapes when writing the logfile, so severity must not
// rely on colour alone.
//
// Constants keep the historical severity order (DEBUG 0 .. ERROR 3) so existing
// callers stay valid; the *threshold* uses the opposite order (OFF 0 .. DEBUG 4)
// so that "bigger = noisier" matches the user-facing menu this feeds.
//
// Filtering — the threshold is the local player's setting `uh_cl_LogLevel`, a
// CVARINFO `user` cvar that Zandronum syncs into the player's userinfo
// (d_netinfo.cpp: D_UserInfoChanged), so each player chooses how noisy their
// own log is.  Severity and threshold run in opposite directions (severity
// 0=DEBUG .. 3=ERROR, verbosity 0=OFF .. 4=ALL), so the filter converts first:
//
//   UH_LogRequiredVerbosity(severity) <= threshold
//
// i.e. ERROR needs "Errors only", WARN "+ Warnings", INFO "+ Info" and DEBUG
// "ALL".  Comparing the raw severity (the previous `level <= threshold`) made
// every menu level above OFF behave backwards.  The two groups of constants are
// deliberately NOT merged: the severity values are a published caller interface
// and the verbosity values are stored in players' configs, so each keeps its
// historical numbering and the conversion happens only at the filter boundary.
//
// The threshold is read with GetUserCVar() for the script activator's
// player, which is the player the call is about for the common case
// (weapon/class/item scripts executed by a player, ENTER scripts, key-bound
// PUKE).  When the activator is not a player (OPEN/RESPAWN/event scripts,
// world watchers) the threshold is read for ConsolePlayerNumber() instead, so
// a locally hosted session still honours the host's setting rather than
// silently dropping output.  On a dedicated server there is no console player
// either (ConsolePlayerNumber() == -1), so the per-player cvar cannot answer at
// all; those calls use the server-wide `uh_sv_LogLevel` threshold instead
// (CVARINFO.debug, default 3), which is what keeps server-side diagnostics
// visible.  Callers that must reach the log unconditionally still use Log().
//
// DEBUG uses the same threshold as every other severity: verbosity ALL (4).
// There is no separate boss-debug switch or cached world-state gate.
#include "zcommon.acs"

// Severity of an event (historical values — do not renumber).
#libdefine UH_LOG_DEBUG 0
#libdefine UH_LOG_INFO  1
#libdefine UH_LOG_WARN  2
#libdefine UH_LOG_ERROR 3

// Threshold values, as stored in `uh_cl_LogLevel` and shown by the menu.
#libdefine UH_LOG_OFF   0
#libdefine UH_LOG_ONLY_ERROR 1
#libdefine UH_LOG_ONLY_WARN  2
#libdefine UH_LOG_ONLY_INFO  3
#libdefine UH_LOG_ALL         4

// Default threshold, matching `user int uh_cl_LogLevel` in CVARINFO. This is
// the pre-existing behaviour: UH_LOG_INFO/WARN/ERROR were always printed and
// only DEBUG was gated, so the out-of-the-box log is unchanged and players
// opt into quieter levels (or more noise) from the Unholy user options menu.
#libdefine UH_LOG_DEFAULT_LEVEL UH_LOG_ONLY_INFO

// Player whose local setting governs this call.
function int UH_LogPlayer(void) {
  int playernum = PlayerNumber();
  if (playernum >= 0) {
    return playernum;
  }
  // Non-player activator (or none at all): fall back to the console player so
  // a locally hosted session still uses the host's own setting.
  return ConsolePlayerNumber();
}

// Reads the acting player's threshold.  An invalid or missing value falls back
// to the CVARINFO default so a typo in the cvar cannot silence every message.
function int UH_LogLevel(void) {
  int playernum = UH_LogPlayer();
  int level;
  if (playernum < 0) {
    // Dedicated server: no acting player and no console player, so there is no
    // userinfo to read.  Use the server-wide threshold instead of dropping
    // every message (GetUserCVar(-1, ...) returns 0 = UH_LOG_OFF).
    level = GetCVar("uh_sv_LogLevel");
    if (level < UH_LOG_OFF || level > UH_LOG_ALL) {
      return UH_LOG_DEFAULT_LEVEL;
    }
    return level;
  }
  level = GetUserCVar(playernum, "uh_cl_LogLevel");
  if (level < UH_LOG_OFF || level > UH_LOG_ALL) {
    return UH_LOG_DEFAULT_LEVEL;
  }
  return level;
}

// Historical severity -> "how verbose must the player be to see this".
// The formula only holds for the historical 0..3 range, which UH_Log checks
// below before converting: an out-of-range value must not slip through the
// filter just because it happens to map onto a passing number.
function int UH_LogRequiredVerbosity(int severity) {
  return UH_LOG_ERROR - severity + UH_LOG_ONLY_ERROR;
}

function void UH_Log(int severity, str message) {
  if (severity < UH_LOG_DEBUG || severity > UH_LOG_ERROR) {
    Log(s:"\c[Red][Unholy ERROR] \c-UH_Log: invalid level ",
        i:severity, s:"; ", s:message);
    return;
  }

  if (UH_LogRequiredVerbosity(severity) > UH_LogLevel())
    return;

  switch (severity) {
    case UH_LOG_DEBUG:
      Log(s:"\c[LightBlue][Unholy DEBUG] \c-", s:message);
      break;
    case UH_LOG_INFO:
      Log(s:"\c[Green][Unholy INFO] \c-", s:message);
      break;
    case UH_LOG_WARN:
      Log(s:"\c[Gold][Unholy WARN] \c-", s:message);
      break;
    case UH_LOG_ERROR:
      Log(s:"\c[Red][Unholy ERROR] \c-", s:message);
      break;
    // Unreachable: the range check above rejects anything outside 0..3.  Kept
    // as a defensive fallback so a future renumbering still logs something.
    default:
      Log(s:"\c[Red][Unholy ERROR] \c-UH_Log: invalid level ", i:severity, s:"; ", s:message);
      break;
  }
}

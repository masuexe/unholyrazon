// Import-only actor-keyed host settings. Keep this independent of UHDT so
// addon registration and selection consumers cannot form a cycle.
#library "UHBSSET"
#include "zcommon.acs"

#libdefine UH_BR_MODE 0
#libdefine UH_BR_WEIGHT 1
#libdefine UH_BR_MIN 2
#libdefine UH_BR_MAX 3
#libdefine UH_BR_FIELDS 4
#libdefine UH_BR_DISABLED 0
#libdefine UH_BR_FORCED 1
#libdefine UH_BR_RANDOM 2
#libdefine UH_BR_CAP 256
#libdefine UH_BR_TEXT_CAP 16384

// The inactive bank stages parses/edits. Only a complete valid transaction
// replaces the active bank. Store names, never registration-order boss ids.
str uh_br_actors[2][UH_BR_CAP];
int uh_br_values[2][UH_BR_CAP][UH_BR_FIELDS];
int uh_br_counts[2];
int uh_br_bank;
str uh_br_seen = "";
bool uh_br_valid = true;
str uh_br_lastactor = "";
int uh_br_lastrow = -2;

function bool UH_BR_ValidActor(str actor) {
  int length = StrLen(actor);
  if (length < 1 || length > 127) return false;
  for (int i = 0; i < length; i++) {
    int ch = GetChar(actor, i);
    if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
          (ch >= '0' && ch <= '9') || ch == '_' || ch == '-' || ch == '.'))
      return false;
  }
  return true;
}

function int UH_BR_Number(str token) {
  if (!StrCmp(token, "-1")) return -1;
  int length = StrLen(token);
  if (length < 1 || length > 7) return -2;
  int value = 0;
  for (int i = 0; i < length; i++) {
    int ch = GetChar(token, i);
    if (ch < '0' || ch > '9') return -2;
    value = value * 10 + ch - '0';
    if (value > 1000000) return -2;
  }
  return value;
}

function bool UH_BR_ValidValue(int field, int value) {
  if (field < 0 || field >= UH_BR_FIELDS) return false;
  if (value == -1) return true;
  if (value < 0) return false;
  if (field == UH_BR_MODE) return value <= UH_BR_RANDOM;
  if (field == UH_BR_WEIGHT) return value >= 1 && value <= 1000000;
  return value <= 64;
}

function int UH_BR_FindIn(int bank, str actor) {
  for (int row = 0; row < uh_br_counts[bank]; row++)
    if (!StrICmp(uh_br_actors[bank][row], actor)) return row;
  return -1;
}

// Saved syntax: actor:mode,weight,minplayers,maxplayers; -1 inherits.
function bool UH_BR_Parse(str raw, int bank) {
  int length = StrLen(raw);
  if (length > UH_BR_TEXT_CAP) return false;
  uh_br_counts[bank] = 0;
  int pos = 0;
  while (pos < length) {
    if (uh_br_counts[bank] >= UH_BR_CAP) return false;
    int start = pos;
    while (pos < length && GetChar(raw, pos) != ':') pos++;
    if (pos == length) return false;
    str actor = StrMid(raw, start, pos - start);
    if (!UH_BR_ValidActor(actor) || UH_BR_FindIn(bank, actor) >= 0) return false;
    int row = uh_br_counts[bank];
    uh_br_actors[bank][row] = actor;
    pos++;
    for (int field = 0; field < UH_BR_FIELDS; field++) {
      start = pos;
      while (pos < length && GetChar(raw, pos) != ',' && GetChar(raw, pos) != ';') pos++;
      if (pos == length) return false;
      int delimiter = GetChar(raw, pos);
      if ((field == UH_BR_MAX && delimiter != ';') ||
          (field != UH_BR_MAX && delimiter != ',')) return false;
      int value = UH_BR_Number(StrMid(raw, start, pos - start));
      if (!UH_BR_ValidValue(field, value)) return false;
      uh_br_values[bank][row][field] = value;
      pos++;
    }
    int minimum = uh_br_values[bank][row][UH_BR_MIN];
    int maximum = uh_br_values[bank][row][UH_BR_MAX];
    if (maximum > 0 && minimum > maximum) return false;
    uh_br_counts[bank]++;
  }
  return true;
}

function str UH_BR_Data(str stored) {
  // One leading LF is an archive marker, not part of the rule text budget.
  if (StrLen(stored) && GetChar(stored, 0) == 10)
    return StrMid(stored, 1, StrLen(stored) - 1);
  return stored;
}

function str UH_BR_Archive(str raw) {
  // INI reads single lines through a 256-byte buffer. A leading LF makes
  // writeini use its lossless multiline format, including for one long row.
  if (StrLen(raw) > 200) return StrParam(s:"\n", s:raw);
  return raw;
}

function bool UH_BR_Load(void) {
  str stored = GetCVarString("uh_sv_bossrules");
  if (!StrCmp(stored, uh_br_seen)) return uh_br_valid;
  uh_br_seen = stored;
  str raw = UH_BR_Data(stored);
  int next = 1 - uh_br_bank;
  uh_br_valid = UH_BR_Parse(raw, next);
  if (uh_br_valid) {
    str archived = UH_BR_Archive(raw);
    if (StrCmp(stored, archived) && !SetCVarString("uh_sv_bossrules", archived)) {
      uh_br_valid = false;
      uh_br_seen = "!archive retry";
      Log(s:"Boss settings: archive update failed; the last valid settings remain active.");
      return false;
    }
    uh_br_seen = archived;
    uh_br_bank = next;
    uh_br_lastrow = -2;
  }
  else Log(s:"Boss settings: invalid uh_sv_bossrules; the last valid settings remain active.");
  return uh_br_valid;
}

function int UH_BR_Get(str actor, int field) {
  UH_BR_Load();
  if (field < 0 || field >= UH_BR_FIELDS) return -1;
  if (uh_br_lastrow == -2 || StrICmp(actor, uh_br_lastactor)) {
    uh_br_lastactor = actor;
    uh_br_lastrow = UH_BR_FindIn(uh_br_bank, actor);
  }
  if (uh_br_lastrow < 0) return -1;
  return uh_br_values[uh_br_bank][uh_br_lastrow][field];
}

function int UH_BR_Count(void) {
  UH_BR_Load();
  return uh_br_counts[uh_br_bank];
}

function str UH_BR_ActorAt(int row) {
  UH_BR_Load();
  if (row < 0 || row >= uh_br_counts[uh_br_bank]) return "";
  return uh_br_actors[uh_br_bank][row];
}

function bool UH_BR_Edit(str actor, int field, int value) {
  if (!UH_BR_Load() || !UH_BR_ValidActor(actor)) return false;
  if (field < -1 || field >= UH_BR_FIELDS) return false;
  if (field != -1 && !UH_BR_ValidValue(field, value)) return false;
  int next = 1 - uh_br_bank;
  int count = uh_br_counts[uh_br_bank];
  uh_br_counts[next] = count;
  for (int row = 0; row < count; row++) {
    uh_br_actors[next][row] = uh_br_actors[uh_br_bank][row];
    for (int f = 0; f < UH_BR_FIELDS; f++)
      uh_br_values[next][row][f] = uh_br_values[uh_br_bank][row][f];
  }
  int target = UH_BR_FindIn(next, actor);
  if (target < 0) {
    if (value == -1 || field == -1) return true;
    if (count >= UH_BR_CAP) return false;
    target = count++;
    uh_br_counts[next] = count;
    uh_br_actors[next][target] = actor;
    for (f = 0; f < UH_BR_FIELDS; f++) uh_br_values[next][target][f] = -1;
  }
  if (field == -1) {
    for (f = 0; f < UH_BR_FIELDS; f++) uh_br_values[next][target][f] = -1;
  }
  else uh_br_values[next][target][field] = value;
  int minimum = uh_br_values[next][target][UH_BR_MIN];
  int maximum = uh_br_values[next][target][UH_BR_MAX];
  if (maximum > 0 && minimum > maximum) return false;

  str raw = "";
  for (row = 0; row < count; row++) {
    bool empty = true;
    for (f = 0; f < UH_BR_FIELDS; f++)
      if (uh_br_values[next][row][f] != -1) empty = false;
    if (empty) continue;
    raw = StrParam(s:raw, s:uh_br_actors[next][row], s:":",
      i:uh_br_values[next][row][0], s:",", i:uh_br_values[next][row][1], s:",",
      i:uh_br_values[next][row][2], s:",", i:uh_br_values[next][row][3], s:";");
    if (StrLen(raw) > UH_BR_TEXT_CAP) return false;
  }
  if (!SetCVarString("uh_sv_bossrules", UH_BR_Archive(raw))) return false;
  // Reparse canonical data so reset rows release capacity.
  uh_br_seen = "!reload";
  return UH_BR_Load();
}

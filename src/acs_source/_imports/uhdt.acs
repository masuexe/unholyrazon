	if (slot == UHITEM_FAIL)
		return "";
	if (boxid >= 0)
		return uh_item_vanilla_str[slot][UHITEM_STR_EYEDROPSOUND];
	return uh_item_custom_str[slot][UHITEM_STR_EYEDROPSOUND];
}

function int FindItemByActor(str actor) {
	int i;
	if (StrCmp(actor, "") == 0)
		return UHITEM_FAIL;
	for (i = 0; i < UH_MAX_VANILLA_ITEM; i++) {
		if (uh_item_vanilla_defined[i] != 0 && StrICmp(actor, uh_item_vanilla_str[i][UHITEM_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_item_custom_count; i++) {
		if (StrICmp(actor, uh_item_custom_str[i][UHITEM_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHITEM_FAIL;
}

function void ItemWriteVanilla(int id, str actor, str name, str mugshot, str sound) {
	uh_item_vanilla_defined[id] = 1;
	uh_item_vanilla_str[id][UHITEM_STR_ACTOR] = actor;
	uh_item_vanilla_str[id][UHITEM_STR_NAME] = name;
	uh_item_vanilla_str[id][UHITEM_STR_MUGSHOT] = mugshot;
	uh_item_vanilla_str[id][UHITEM_STR_SOUND] = sound;
	uh_item_vanilla_str[id][UHITEM_STR_OPENSOUND] = "";
	uh_item_vanilla_str[id][UHITEM_STR_EYEDROPSOUND] = "";
	uh_item_vanilla_is_box[id] = 0;
}

function int ItemWriteCustom(str actor, str name, str mugshot, str sound) {
	int i = uh_item_custom_count;
	int itemid = -1 - i;
	uh_item_custom_str[i][UHITEM_STR_ACTOR] = actor;
	uh_item_custom_str[i][UHITEM_STR_NAME] = name;
	uh_item_custom_str[i][UHITEM_STR_MUGSHOT] = mugshot;
	uh_item_custom_str[i][UHITEM_STR_SOUND] = sound;
	uh_item_custom_str[i][UHITEM_STR_OPENSOUND] = "";
	uh_item_custom_str[i][UHITEM_STR_EYEDROPSOUND] = "";
	uh_item_custom_is_box[i] = 0;
	uh_item_custom_count++;
	return itemid;
}

function int SetUnholyBoxCore(int boxid, str open_sound, str eyedrop_sound) {
	int slot = ItemResolveSlot(boxid);
	if (slot == UHITEM_FAIL)
		return UHITEM_FAIL;
	if (boxid >= 0) {
		uh_item_vanilla_is_box[slot] = 1;
		uh_item_vanilla_str[slot][UHITEM_STR_OPENSOUND] = open_sound;
		uh_item_vanilla_str[slot][UHITEM_STR_EYEDROPSOUND] = eyedrop_sound;
	}
	else {
		uh_item_custom_is_box[slot] = 1;
		uh_item_custom_str[slot][UHITEM_STR_OPENSOUND] = open_sound;
		uh_item_custom_str[slot][UHITEM_STR_EYEDROPSOUND] = eyedrop_sound;
	}
	return boxid;
}

function int FindItemDropRow(int boxid, int itemid, str give_actor, int amt) {
	int i;
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] == boxid
			&& uh_item_drop_item_id[i] == itemid
			&& uh_item_drop_amt[i] == amt
			&& StrICmp(uh_item_drop_give[i], give_actor) == 0)
			return i;
	}
	return -1;
}

// First row for (box, item) — API helpers / prosperity fallback.
function int FindItemDropRowByItem(int boxid, int itemid) {
	int i;
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] == boxid && uh_item_drop_item_id[i] == itemid)
			return i;
	}
	return -1;
}

// Same (box, item, giveActor, amt) again: accumulate weight. sting kept from first row.
function int AddUnholyItemDropCore(int boxid, int itemid, int weight, int amt, str sting_override, str give_actor) {
	int row;
	if (!IsItemDefined(boxid) || !IsItemDefined(itemid))
		return UHITEM_FAIL;
	if (!IsUnholyBox(boxid))
		return UHITEM_FAIL;
	if (weight <= 0)
		return UHITEM_FAIL;
	if (amt < 1)
		amt = 1;

	row = FindItemDropRow(boxid, itemid, give_actor, amt);
	if (row >= 0) {
		uh_item_drop_weight[row] += weight;
		return row;
	}
	if (uh_item_drop_count >= UH_MAX_ITEM_DROPS)
		return UHITEM_FAIL;
	row = uh_item_drop_count;
	uh_item_drop_box_id[row] = boxid;
	uh_item_drop_item_id[row] = itemid;
	uh_item_drop_weight[row] = weight;
	uh_item_drop_amt[row] = amt;
	uh_item_drop_sting[row] = sting_override;
	uh_item_drop_give[row] = give_actor;
	uh_item_drop_count++;
	return row;
}

function int GetItemDropWeight(int boxid, int itemid) {
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return 0;
	return uh_item_drop_weight[row];
}

function int GetItemDropAmt(int boxid, int itemid) {
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return 0;
	return uh_item_drop_amt[row];
}

function str GetItemDropSting(int boxid, int itemid) {
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return "";
	return GetItemDropStingByRow(row);
}

// Auto* (not *Silent) runs Use with its own sound — do not also play item loot sting.
function bool ItemDropGiveIsAutoNonSilent(str give) {
	int n;
	if (StrCmp(give, "") == 0)
		return false;
	n = StrLen(give);
	if (n < 4)
		return false;
	if (StrICmp(StrMid(give, 0, 4), "Auto") != 0)
		return false;
	if (n >= 6 && StrICmp(StrRight(give, 6), "Silent") == 0)
		return false;
	return true;
}

function str GetItemDropStingByRow(int row) {
	str override;
	int itemid;
	if (row < 0 || row >= uh_item_drop_count)
		return "";
	override = uh_item_drop_sting[row];
	if (StrCmp(override, "") != 0)
		return override;
	// Explicit empty override + Auto Use sound → no ACS sting (e.g. Coin → AutoUnholyBook).
	if (ItemDropGiveIsAutoNonSilent(uh_item_drop_give[row]))
		return "";
	itemid = uh_item_drop_item_id[row];
	return GetItemSound(itemid);
}

function str GetItemDropGiveActorByRow(int row) {
	str give;
	int itemid;
	if (row < 0 || row >= uh_item_drop_count)
		return "";
	give = uh_item_drop_give[row];
	if (StrCmp(give, "") != 0)
		return give;
	itemid = uh_item_drop_item_id[row];
	return GetItemActor(itemid);
}

function int GetItemDropAmtByRow(int row) {
	if (row < 0 || row >= uh_item_drop_count)
		return 0;
	return uh_item_drop_amt[row];
}

function int GetItemDropItemIdByRow(int row) {
	if (row < 0 || row >= uh_item_drop_count)
		return UHITEM_FAIL;
	return uh_item_drop_item_id[row];
}

function int ItemBoxWeightSum(int boxid) {
	int sum = 0;
	int i;
	if (!IsUnholyBox(boxid))
		return 0;
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] == boxid)
			sum += uh_item_drop_weight[i];
	}
	return sum;
}

// Weighted pick; returns drop row index or -1. Sets uh_itemLastDropRow.
function int RandomItemDropRowFromBox(int boxid) {
	int sum;
	int roll;
	int i;
	uh_item_last_drop_row = -1;
	if (!IsUnholyBox(boxid))
		return -1;
	sum = ItemBoxWeightSum(boxid);
	if (sum <= 0)
		return -1;
	roll = random(1, sum);
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] != boxid)
			continue;
		roll -= uh_item_drop_weight[i];
		if (roll <= 0) {
			uh_item_last_drop_row = i;
			return i;
		}
	}
	return -1;
}

// Weighted pick. Returns item id or UHITEM_FAIL. Sets uh_itemLastDropRow.
function int RandomItemFromBox(int boxid) {
	int row = RandomItemDropRowFromBox(boxid);
	if (row < 0)
		return UHITEM_FAIL;
	return uh_item_drop_item_id[row];
}

// Prosperity: roll twice, keep the rarer (lower weight) *row*. Ties keep first.
function int RandomItemFromBoxProsperity(int boxid) {
	int ra = RandomItemDropRowFromBox(boxid);
	int rb = RandomItemDropRowFromBox(boxid);
	if (ra < 0) {
		uh_item_last_drop_row = rb;
		if (rb < 0)
			return UHITEM_FAIL;
		return uh_item_drop_item_id[rb];
	}
	if (rb < 0) {
		uh_item_last_drop_row = ra;
		return uh_item_drop_item_id[ra];
	}
	if (uh_item_drop_weight[rb] < uh_item_drop_weight[ra]) {
		uh_item_last_drop_row = rb;
		return uh_item_drop_item_id[rb];
	}
	uh_item_last_drop_row = ra;
	return uh_item_drop_item_id[ra];
}

// Eternal D6: eligible home boxes exclude coin spend pool and AssHat morph pool.
#libdefine UH_EDEN_D6_HOME_MAX 32

function bool IsEdenD6EligibleBox(int boxid) {
	str actor;
	if (!IsUnholyBox(boxid))
		return false;
	actor = GetItemActor(boxid);
	if (StrICmp(actor, "DLC_CoinItem") == 0)
		return false;
	if (StrICmp(actor, "AssHatItem") == 0)
		return false;
	if (StrICmp(actor, "DickHatItem") == 0)
		return false;
	return true;
}

// Among boxes that drop itemid, pick one weighted by that item's drop weights in each box.
function int PickItemHomeBoxEdenD6(int itemid) {
	int boxes[UH_EDEN_D6_HOME_MAX];
	int weights[UH_EDEN_D6_HOME_MAX];
	int n;
	int i;
	int j;
	int found;
	int boxid;
	int sum;
	int roll;

	n = 0;
	if (!IsItemDefined(itemid))
		return UHITEM_FAIL;

	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_item_id[i] != itemid)
			continue;
		boxid = uh_item_drop_box_id[i];
		if (!IsEdenD6EligibleBox(boxid))
			continue;
		found = -1;
		for (j = 0; j < n; j++) {
			if (boxes[j] == boxid) {
				found = j;
				break;
			}
		}
		if (found >= 0)
			weights[found] += uh_item_drop_weight[i];
		else if (n < UH_EDEN_D6_HOME_MAX) {
			boxes[n] = boxid;
			weights[n] = uh_item_drop_weight[i];
			n++;
		}
	}

	if (n <= 0)
		return UHITEM_FAIL;
	if (n == 1)
		return boxes[0];

	sum = 0;
	for (j = 0; j < n; j++)
		sum += weights[j];
	if (sum <= 0)
		return UHITEM_FAIL;
	roll = random(1, sum);
	for (j = 0; j < n; j++) {
		roll -= weights[j];
		if (roll <= 0)
			return boxes[j];
	}
	return UHITEM_FAIL;
}

function int ItemBoxWeightSumEdenD6(int boxid, int exclude_item_id) {
	int coin_id;
	int sum;
	int i;

	coin_id = FindItemByActor("DLC_CoinItem");
	sum = 0;
	if (!IsUnholyBox(boxid))
		return 0;
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] != boxid)
			continue;
		if (uh_item_drop_item_id[i] == exclude_item_id)
			continue;
		if (uh_item_drop_item_id[i] == coin_id)
			continue;
		sum += uh_item_drop_weight[i];
	}
	return sum;
}

// Weighted pick excluding self and DLC_Coin. Sets uh_itemLastDropRow.
function int RandomItemFromBoxEdenD6(int boxid, int exclude_item_id) {
	int coin_id;
	int sum;
	int roll;
	int i;

	coin_id = FindItemByActor("DLC_CoinItem");
	uh_item_last_drop_row = -1;
	sum = ItemBoxWeightSumEdenD6(boxid, exclude_item_id);
	if (sum <= 0)
		return UHITEM_FAIL;
	roll = random(1, sum);
	for (i = 0; i < uh_item_drop_count; i++) {
		if (uh_item_drop_box_id[i] != boxid)
			continue;
		if (uh_item_drop_item_id[i] == exclude_item_id)
			continue;
		if (uh_item_drop_item_id[i] == coin_id)
			continue;
		roll -= uh_item_drop_weight[i];
		if (roll <= 0) {
			uh_item_last_drop_row = i;
			return uh_item_drop_item_id[i];
		}
	}
	return UHITEM_FAIL;
}

function int AssHatPendingAlloc(int tid, str item_actor) {
	int i;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++) {
		if (uh_ass_hat_pending_used[i] == 0) {
			uh_ass_hat_pending_used[i] = 1;
			uh_ass_hat_pending_tid[i] = tid;
			uh_ass_hat_pending_item[i] = item_actor;
			return i;
		}
	}
	return -1;
}

function str AssHatPendingTake(int tid) {
	int i;
	str item;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++) {
		if (uh_ass_hat_pending_used[i] != 0 && uh_ass_hat_pending_tid[i] == tid) {
			item = uh_ass_hat_pending_item[i];
			uh_ass_hat_pending_used[i] = 0;
			uh_ass_hat_pending_tid[i] = 0;
			uh_ass_hat_pending_item[i] = "";
			return item;
		}
	}
	return "";
}

function str AssHatPendingPeek(int tid) {
	int i;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++) {
		if (uh_ass_hat_pending_used[i] != 0 && uh_ass_hat_pending_tid[i] == tid)
			return uh_ass_hat_pending_item[i];
	}
	return "";
}

function int FindCoinSpendByKey(int min_count, str give_actor) {
	int i;
	for (i = 0; i < uh_coin_spend_count; i++) {
		if (uh_coin_spend_min[i] == min_count && StrICmp(uh_coin_spend_give[i], give_actor) == 0)
			return i;
	}
	return -1;
}

// takeAmt 0 = take all at use time. Same (minCount, giveActor) returns existing row (no double).
function int DefineUnholyCoinSpendCore(int min_count, int take_amt, str give_actor, str sound) {
	int row;
	if (min_count < 1)
		return UHITEM_FAIL;
	if (StrCmp(give_actor, "") == 0)
		return UHITEM_FAIL;
	if (take_amt < 0)
		take_amt = 0;

	row = FindCoinSpendByKey(min_count, give_actor);
	if (row >= 0)
		return row;
	if (uh_coin_spend_count >= UH_MAX_COIN_SPENDS)
		return UHITEM_FAIL;

	row = uh_coin_spend_count;
	uh_coin_spend_min[row] = min_count;
	uh_coin_spend_take[row] = take_amt;
	uh_coin_spend_give[row] = give_actor;
	uh_coin_spend_sound[row] = sound;
	uh_coin_spend_count++;
	return row;
}

// Highest eligible minCount; uniform pick among rows at that tier. -1 if none.
function int FindCoinSpendRow(int coins) {
	int i;
	int best_min;
	int n;
	int candidates[UH_MAX_COIN_SPENDS];

	best_min = 0;
	for (i = 0; i < uh_coin_spend_count; i++) {
		if (uh_coin_spend_min[i] <= coins && uh_coin_spend_min[i] > best_min)
			best_min = uh_coin_spend_min[i];
	}
	if (best_min < 1)
		return -1;

	n = 0;
	for (i = 0; i < uh_coin_spend_count; i++) {
		if (uh_coin_spend_min[i] == best_min) {
			candidates[n] = i;
			n++;
		}
	}
	if (n < 1)
		return -1;
	return candidates[Random(0, n - 1)];
}

// --- DefineCopyWep tables ----------------------------------------------------
// Row: (kind, slot, actor, dmgStem). Mega dmg id = order among mega rows (1..n).
// uh_copyMegaOfficialCount frozen after vanilla so jackpot pool stays stable.

int uh_copy_count = 0;
int uh_copy_kind[UH_MAX_COPYWEPS];
int uh_copy_slot[UH_MAX_COPYWEPS];
str uh_copy_actor[UH_MAX_COPYWEPS];
str uh_copy_dmg_stem[UH_MAX_COPYWEPS];
int uh_copy_mega_id[UH_MAX_COPYWEPS];
int uh_copy_regen_flags[UH_MAX_COPYWEPS];
int uh_copy_mega_count = 0;
int uh_copy_mega_official_count = 0;

function bool CopyWepSlotValid(int kind, int slot) {
	if (kind == UHCOPY_MEGA)
		return slot >= UHCOPY_SLOT_RANGED && slot <= UHCOPY_SLOT_SHIELD;
	if (kind == UHCOPY_QWANT)
		return slot >= UHCOPY_QWANT_NORMAL && slot <= UHCOPY_QWANT_FAIRY;
	if (kind == UHCOPY_NEGA)
		return slot >= UHCOPY_NEGA_MM1 && slot <= UHCOPY_NEGA_MMWT;
	return false;
}

function str CopyWepMakeDmgStem(str wep_actor) {
	int len = StrLen(wep_actor);
	if (len >= 4 && StrCmp(StrRight(wep_actor, 4), "WepU") == 0)
		return StrLeft(wep_actor, len - 4);
	return wep_actor;
}

function int FindCopyWepByKindActor(int kind, str wep_actor) {
	int i;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] == kind && StrICmp(uh_copy_actor[i], wep_actor) == 0)
			return i;
	}
	return -1;
}

function int FindCopyWepByActor(str wep_actor) {
	int i;
	for (i = 0; i < uh_copy_count; i++) {
		if (StrICmp(uh_copy_actor[i], wep_actor) == 0)
			return i;
	}
	return -1;
}

function int GetCopyWepKind(int row) {
	if (row < 0 || row >= uh_copy_count)
		return 0;
	return uh_copy_kind[row];
}

function int GetCopyWepSlot(int row) {
	if (row < 0 || row >= uh_copy_count)
		return 0;
	return uh_copy_slot[row];
}

function int GetCopyWepRegenFlags(int row) {
	if (row < 0 || row >= uh_copy_count)
		return 0;
	return uh_copy_regen_flags[row];
}

function int DefineCopyWepCore(int kind, int slot, str wep_actor) {
	int row;
	if (kind != UHCOPY_MEGA && kind != UHCOPY_QWANT && kind != UHCOPY_NEGA)
		return UHCOPY_FAIL;
	if (!CopyWepSlotValid(kind, slot))
		return UHCOPY_FAIL;
	if (StrCmp(wep_actor, "") == 0)
		return UHCOPY_FAIL;

	row = FindCopyWepByKindActor(kind, wep_actor);
	if (row >= 0)
		return row;
	if (uh_copy_count >= UH_MAX_COPYWEPS)
		return UHCOPY_FAIL;

	row = uh_copy_count;
	uh_copy_kind[row] = kind;
	uh_copy_slot[row] = slot;
	uh_copy_actor[row] = wep_actor;
	uh_copy_dmg_stem[row] = CopyWepMakeDmgStem(wep_actor);
	uh_copy_mega_id[row] = 0;
	uh_copy_regen_flags[row] = 0;
	if (kind == UHCOPY_MEGA) {
		uh_copy_mega_count++;
		uh_copy_mega_id[row] = uh_copy_mega_count;
	}
	uh_copy_count++;
	return row;
}

function int DefineCopyWepRegenCore(str wep_actor, int flags) {
	int row;
	if (StrCmp(wep_actor, "") == 0)
		return UHCOPY_FAIL;
	row = FindCopyWepByActor(wep_actor);
	if (row < 0)
		return UHCOPY_FAIL;
	uh_copy_regen_flags[row] = flags;
	return row;
}

function void FreezeMegaOfficialCopyCount(void) {
	uh_copy_mega_official_count = uh_copy_mega_count;
}

function int GetMegaOfficialCopyCount(void) {
	return uh_copy_mega_official_count;
}

function int CountCopyWepByKind(int kind) {
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] == kind)
			n++;
	}
	return n;
}

function int CountCopyWepByKindSlot(int kind, int slot) {
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] == kind && uh_copy_slot[i] == slot)
			n++;
	}
	return n;
}

// idx = 0-based among rows with this kind. Returns table row or -1.
function int FindCopyWepRowByKindIndex(int kind, int idx) {
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] != kind)
			continue;
		if (n == idx)
			return i;
		n++;
	}
	return -1;
}

// idx = 0-based among rows with this kind+slot. Returns table row or -1.
function int FindCopyWepRowByKindSlotIndex(int kind, int slot, int idx) {
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] != kind || uh_copy_slot[i] != slot)
			continue;
		if (n == idx)
			return i;
		n++;
	}
	return -1;
}

function str GetCopyWepActorByKindIndex(int kind, int idx) {
	int row = FindCopyWepRowByKindIndex(kind, idx);
	if (row < 0)
		return "";
	return uh_copy_actor[row];
}

function str GetCopyWepActorByKindSlotIndex(int kind, int slot, int idx) {
	int row = FindCopyWepRowByKindSlotIndex(kind, slot, idx);
	if (row < 0)
		return "";
	return uh_copy_actor[row];
}

function str GetCopyWepDmgStemByMegaId(int mega_id) {
	int i;
	if (mega_id < 1)
		return "";
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] == UHCOPY_MEGA && uh_copy_mega_id[i] == mega_id)
			return uh_copy_dmg_stem[i];
	}
	return "";
}

// Case-insensitive prefix (UHDT self-contained for mega stem match).
function bool UH_StrIStartsWithCopy(str s, str prefix) {
	int plen;
	int i;
	int a;
	int b;
	plen = StrLen(prefix);
	if (plen <= 0 || StrLen(s) < plen)
		return false;
	for (i = 0; i < plen; i++) {
		a = GetChar(s, i);
		b = GetChar(prefix, i);
		if (a >= 65 && a <= 90)
			a = a + 32;
		if (b >= 65 && b <= 90)
			b = b + 32;
		if (a != b)
			return false;
	}
	return true;
}

// Longest mega dmgStem prefix match against s. Returns megaId or 0.
function int FindMegaCopyIdByStemPrefix(str s) {
	int i;
	int best_id;
	int best_len;
	int nlen;
	str stem;

	best_id = 0;
	best_len = 0;
	for (i = 0; i < uh_copy_count; i++) {
		if (uh_copy_kind[i] != UHCOPY_MEGA)
			continue;
		stem = uh_copy_dmg_stem[i];
		nlen = StrLen(stem);
		if (nlen > best_len && UH_StrIStartsWithCopy(s, stem)) {
			best_len = nlen;
			best_id = uh_copy_mega_id[i];
		}
	}
	return best_id;
}

// --- Boss music pool (weighted spawn / enrage BGM) ---------------------------

int uh_boss_music_count = 0;
int uh_boss_music_boss_id[UH_MAX_BOSS_MUSICS];
int uh_boss_music_kind[UH_MAX_BOSS_MUSICS];
int uh_boss_music_phase[UH_MAX_BOSS_MUSICS];
str uh_boss_music_lump[UH_MAX_BOSS_MUSICS];
str uh_boss_music_credit[UH_MAX_BOSS_MUSICS];
int uh_boss_music_weight[UH_MAX_BOSS_MUSICS];
int uh_boss_music_optional[UH_MAX_BOSS_MUSICS];
int uh_boss_music_duration[UH_MAX_BOSS_MUSICS];
int uh_boss_music_emuflag[UH_MAX_BOSS_MUSICS];

function int FindBossMusicRow(int boss_id, int kind, int phase, str lump) {
	int i;
	for (i = 0; i < uh_boss_music_count; i++) {
		if (uh_boss_music_boss_id[i] == boss_id
			&& uh_boss_music_kind[i] == kind
			&& uh_boss_music_phase[i] == phase
			&& StrCmp(uh_boss_music_lump[i], lump) == 0)
			return i;
	}
	return -1;
}

function int FindEventMusicRow(int kind, int phase, str lump) {
	return FindBossMusicRow(UHMUS_GLOBAL, kind, phase, lump);
}

// weight >= 1. optional: non-zero = skip unless uh_sv_OptionalMusic.
// Same (bossId, kind, phase, lump) again updates weight/credit/optional.
function int AddBossMusicCore(int boss_id, int kind, int phase, str lump, str credit, int weight, int optional) {
	int row;
	if (!IsBossDefined(boss_id))
		return UHMUS_FAIL;
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return UHMUS_FAIL;
	if (weight < 1)
		return UHMUS_FAIL;
	if (kind != UHMUS_KIND_SPAWN && kind != UHMUS_KIND_ENRAGE)
		return UHMUS_FAIL;
	if (phase < 0)
		return UHMUS_FAIL;

	row = FindBossMusicRow(boss_id, kind, phase, lump);
	if (row >= 0) {
		uh_boss_music_credit[row] = credit;
		uh_boss_music_weight[row] = weight;
		if (optional != 0)
			uh_boss_music_optional[row] = 1;
		else
			uh_boss_music_optional[row] = 0;
		return row;
	}
	if (uh_boss_music_count >= UH_MAX_BOSS_MUSICS)
		return UHMUS_FAIL;

	row = uh_boss_music_count;
	uh_boss_music_boss_id[row] = boss_id;
	uh_boss_music_kind[row] = kind;
	uh_boss_music_phase[row] = phase;
	uh_boss_music_lump[row] = lump;
	uh_boss_music_credit[row] = credit;
	uh_boss_music_weight[row] = weight;
	if (optional != 0)
		uh_boss_music_optional[row] = 1;
	else
		uh_boss_music_optional[row] = 0;
	uh_boss_music_duration[row] = 0;
	uh_boss_music_emuflag[row] = 0;
	uh_boss_music_count++;
	return row;
}

// Global event pools (winner/loser/LMS). Identity = (kind, phase, lump).
// Winner/Loser: phase 0. LMS: phase = eventid (>=0, no upper bound).
// duration: ACS fixed seconds (-1.0 unknown). emuflag: 1 = MAME (+12 tics).
function int AddEventMusicCore(int kind, int phase, str lump, str credit, int weight, int optional, int duration, int emuflag) {
	int row;
	int emuf;
	if (kind != UHMUS_KIND_WINNER && kind != UHMUS_KIND_LOSER && kind != UHMUS_KIND_LMS)
		return UHMUS_FAIL;
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return UHMUS_FAIL;
	if (weight < 1)
		return UHMUS_FAIL;
	if (phase < 0)
		return UHMUS_FAIL;

	if (emuflag != 0)
		emuf = 1;
	else
		emuf = 0;

	row = FindEventMusicRow(kind, phase, lump);
	if (row >= 0) {
		uh_boss_music_credit[row] = credit;
		uh_boss_music_weight[row] = weight;
		if (optional != 0)
			uh_boss_music_optional[row] = 1;
		else
			uh_boss_music_optional[row] = 0;
		uh_boss_music_duration[row] = duration;
		uh_boss_music_emuflag[row] = emuf;
		return row;
	}
	if (uh_boss_music_count >= UH_MAX_BOSS_MUSICS)
		return UHMUS_FAIL;

	row = uh_boss_music_count;
	uh_boss_music_boss_id[row] = UHMUS_GLOBAL;
	uh_boss_music_kind[row] = kind;
	uh_boss_music_phase[row] = phase;
	uh_boss_music_lump[row] = lump;
	uh_boss_music_credit[row] = credit;
	uh_boss_music_weight[row] = weight;
	if (optional != 0)
		uh_boss_music_optional[row] = 1;
	else
		uh_boss_music_optional[row] = 0;
	uh_boss_music_duration[row] = duration;
	uh_boss_music_emuflag[row] = emuf;
	uh_boss_music_count++;
	return row;
}

// Seed DefineBoss spawn music (weight 1, required). No-op for "" / "*".
function void UH_BossSeedMusic(int boss_id, str lump, str credit) {
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return;
	AddBossMusicCore(boss_id, UHMUS_KIND_SPAWN, 0, lump, credit, 1, 0);
}

function str GetBossMusicLumpByRow(int row) {
	if (row < 0 || row >= uh_boss_music_count)
		return "";
	return uh_boss_music_lump[row];
}

function str GetBossMusicCreditByRow(int row) {
	if (row < 0 || row >= uh_boss_music_count)
		return "";
	return uh_boss_music_credit[row];
}

function int GetBossMusicDurationByRow(int row) {
	if (row < 0 || row >= uh_boss_music_count)
		return 0;
	return uh_boss_music_duration[row];
}

function int GetBossMusicEmuFlagByRow(int row) {
	if (row < 0 || row >= uh_boss_music_count)
		return 0;
	return uh_boss_music_emuflag[row];
}

// Weighted pick among eligible rows. -1 if none eligible.
function int PickBossMusicRow(int boss_id, int kind, int phase) {
	int i;
	int sum;
	int roll;
	int allow_optional;

	if (!IsBossDefined(boss_id))
		return -1;

	allow_optional = GetCVar("uh_sv_OptionalMusic");
	sum = 0;
	for (i = 0; i < uh_boss_music_count; i++) {
		if (uh_boss_music_boss_id[i] != boss_id)
			continue;
		if (uh_boss_music_kind[i] != kind)
			continue;
		if (uh_boss_music_phase[i] != phase)
			continue;
		if (uh_boss_music_optional[i] != 0 && !allow_optional)
			continue;
		sum += uh_boss_music_weight[i];
	}
	if (sum <= 0)
		return -1;

	roll = random(1, sum);
	for (i = 0; i < uh_boss_music_count; i++) {
		if (uh_boss_music_boss_id[i] != boss_id)
			continue;
		if (uh_boss_music_kind[i] != kind)
			continue;
		if (uh_boss_music_phase[i] != phase)
			continue;
		if (uh_boss_music_optional[i] != 0 && !allow_optional)
			continue;
		roll -= uh_boss_music_weight[i];
		if (roll <= 0)
			return i;
	}
	return -1;
}

// Global winner/loser/LMS pick. Filters kind + phase + optional. -1 if none.
function int PickEventMusicRow(int kind, int phase) {
	int i;
	int sum;
	int roll;
	int allow_optional;

	if (kind != UHMUS_KIND_WINNER && kind != UHMUS_KIND_LOSER && kind != UHMUS_KIND_LMS)
		return -1;
	if (phase < 0)
		return -1;

	allow_optional = GetCVar("uh_sv_OptionalMusic");
	sum = 0;
	for (i = 0; i < uh_boss_music_count; i++) {
		if (uh_boss_music_kind[i] != kind)
			continue;
		if (uh_boss_music_phase[i] != phase)
			continue;
		if (uh_boss_music_optional[i] != 0 && !allow_optional)
			continue;
		sum += uh_boss_music_weight[i];
	}
	if (sum <= 0)
		return -1;

	roll = random(1, sum);
	for (i = 0; i < uh_boss_music_count; i++) {
		if (uh_boss_music_kind[i] != kind)
			continue;
		if (uh_boss_music_phase[i] != phase)
			continue;
		if (uh_boss_music_optional[i] != 0 && !allow_optional)
			continue;
		roll -= uh_boss_music_weight[i];
		if (roll <= 0)
			return i;
	}
	return -1;
}

// --- LMS event table (last-survivor events) ----------------------------------
// Ids are always >= 0. Vanilla 0–11; auto (-1) assigns next unused >= 12.
// weight 0 = force/RCON only; weight >= 1 = random pool.

int uh_lms_defined[UH_MAX_LMS_EVENTS];
str uh_lms_stem[UH_MAX_LMS_EVENTS];
str uh_lms_message[UH_MAX_LMS_EVENTS];
str uh_lmsraremessage[UH_MAX_LMS_EVENTS];
str uh_lms_icon[UH_MAX_LMS_EVENTS];
str uh_lmsrareicon[UH_MAX_LMS_EVENTS];
int uh_lms_flags[UH_MAX_LMS_EVENTS];
int uh_lms_weight[UH_MAX_LMS_EVENTS];
int uh_lms_next_custom_id = 12;

int uh_lms_drop_count = 0;
int uh_lms_drop_event_id[UH_MAX_LMS_DROPS];
str uh_lms_drop_item[UH_MAX_LMS_DROPS];
int uh_lms_drop_amt[UH_MAX_LMS_DROPS];
int uh_lms_drop_rare[UH_MAX_LMS_DROPS];

function bool IsLMSEventDefined(int id) {
	if (id < 0 || id >= UH_MAX_LMS_EVENTS)
		return false;
	return uh_lms_defined[id] != 0;
}

function int FindLMSEventByStem(str stem) {
	int i;
	if (StrCmp(stem, "") == 0)
		return UHLMS_FAIL;
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++) {
		if (uh_lms_defined[i] != 0 && StrICmp(uh_lms_stem[i], stem) == 0)
			return i;
	}
	return UHLMS_FAIL;
}

function int DefineLMSEventCore(int id, str stem, str message, str raremessage, str icon, str rareicon, int flags, int weight) {
	int other;
	if (StrCmp(stem, "") == 0)
		return UHLMS_FAIL;
	if (weight < 0)
		return UHLMS_FAIL;

	if (id == -1) {
		id = uh_lms_next_custom_id;
		while (id < UH_MAX_LMS_EVENTS && uh_lms_defined[id] != 0)
			id++;
		if (id >= UH_MAX_LMS_EVENTS)
			return UHLMS_FAIL;
		uh_lms_next_custom_id = id + 1;
	}
	else if (id < 0 || id >= UH_MAX_LMS_EVENTS)
		return UHLMS_FAIL;

	other = FindLMSEventByStem(stem);
	if (other != UHLMS_FAIL && other != id)
		return UHLMS_FAIL;

	uh_lms_defined[id] = 1;
	uh_lms_stem[id] = stem;
	uh_lms_message[id] = message;
	uh_lmsraremessage[id] = raremessage;
	uh_lms_icon[id] = icon;
	uh_lmsrareicon[id] = rareicon;
	uh_lms_flags[id] = flags;
	uh_lms_weight[id] = weight;

	if (id >= 12 && id >= uh_lms_next_custom_id)
		uh_lms_next_custom_id = id + 1;

	return id;
}

function int FindLMSEventDropRow(int event_id, str item_actor, int amt, int rare) {
	int i;
	int rare_flag;
	if (rare != 0)
		rare_flag = 1;
	else
		rare_flag = 0;
	for (i = 0; i < uh_lms_drop_count; i++) {
		if (uh_lms_drop_event_id[i] == event_id
			&& uh_lms_drop_amt[i] == amt
			&& uh_lms_drop_rare[i] == rare_flag
			&& StrICmp(uh_lms_drop_item[i], item_actor) == 0)
			return i;
	}
	return -1;
}

// Same (id, item, amt, rare) again returns existing row (no double grant).
function int AddLMSEventDropCore(int event_id, str item_actor, int amt, int rare) {
	int row;
	int rare_flag;
	if (!IsLMSEventDefined(event_id))
		return UHLMS_FAIL;
	if (StrCmp(item_actor, "") == 0)
		return UHLMS_FAIL;
	if (amt < 1)
		return UHLMS_FAIL;
	if (rare != 0)
		rare_flag = 1;
	else
		rare_flag = 0;

	row = FindLMSEventDropRow(event_id, item_actor, amt, rare_flag);
	if (row >= 0)
		return row;
	if (uh_lms_drop_count >= UH_MAX_LMS_DROPS)
		return UHLMS_FAIL;

	row = uh_lms_drop_count;
	uh_lms_drop_event_id[row] = event_id;
	uh_lms_drop_item[row] = item_actor;
	uh_lms_drop_amt[row] = amt;
	uh_lms_drop_rare[row] = rare_flag;
	uh_lms_drop_count++;
	return row;
}

function str GetLMSEventStem(int id) {
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lms_stem[id];
}

function str GetLMSEventMessage(int id) {
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lms_message[id];
}

function str GetLMSEventraremessage(int id) {
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsraremessage[id];
}

function str GetLMSEventIcon(int id) {
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lms_icon[id];
}

function str GetLMSEventrareicon(int id) {
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsrareicon[id];
}

function int GetLMSEventFlags(int id) {
	if (!IsLMSEventDefined(id))
		return 0;
	return uh_lms_flags[id];
}

function int GetLMSEventWeight(int id) {
	if (!IsLMSEventDefined(id))
		return 0;
	return uh_lms_weight[id];
}

// Weighted pick among events with weight >= 1. UHLMS_FAIL if none.
function int PickLMSEvent(void) {
	int i;
	int sum;
	int roll;

	sum = 0;
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++) {
		if (uh_lms_defined[i] == 0)
			continue;
		if (uh_lms_weight[i] < 1)
			continue;
		sum += uh_lms_weight[i];
	}
	if (sum <= 0)
		return UHLMS_FAIL;

	roll = random(1, sum);
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++) {
		if (uh_lms_defined[i] == 0)
			continue;
		if (uh_lms_weight[i] < 1)
			continue;
		roll -= uh_lms_weight[i];
		if (roll <= 0)
			return i;
	}
	return UHLMS_FAIL;
}

// Grant all drop rows for eventId matching rare flag to actor tid.
function void GrantLMSEventDrops(int tid, int event_id, int rare) {
	int i;
	int rare_flag;
	if (!IsLMSEventDefined(event_id))
		return;
	if (rare != 0)
		rare_flag = 1;
	else
		rare_flag = 0;
	for (i = 0; i < uh_lms_drop_count; i++) {
		if (uh_lms_drop_event_id[i] != event_id)
			continue;
		if (uh_lms_drop_rare[i] != rare_flag)
			continue;
		GiveActorInventory(tid, uh_lms_drop_item[i], uh_lms_drop_amt[i]);
	}
}

// ============================================================================
// Shiny move-weapon API tables (APPENDED LAST — existing import indices stay
// stable; only UHDT + libs using these new symbols need recompiling).
//
// Models:
// - QwantShiny: AltFire Give+SetWeapon a move weapon; Select anim + MoveReturn.
// - NegaManShiny: one held actor per cycle slot (L1 in the table); Charge/Fire1-3
//   on that weapon; full-charge Advance Give/Takes next slot (or buster).
// - DecoyBot: M2 Gives three held DecoyCopy_*_W1/2/3; M1 fires held Fire.
// - Shiny MegaMan: CustomInventory Pickup fire actors (no weapon switch).
// ============================================================================

#libdefine UH_MAX_SHINYMOVES 128
#libdefine UH_SHINYNEGA_SLOTBASE 26
#libdefine UH_SHINYNEGA_SLOTCOUNT 8
#libdefine UH_SHINYNEGA_SLOTMAX 33
#libdefine UH_SHINYNEGA_CYCLE_RESET 34
#libdefine UH_DECOY_SLOTBASE 59
#libdefine UH_SHINYMEGA_M1 1
#libdefine UH_SHINYMEGA_M2 2
#libdefine UH_SHINYMEGA_TRUE 3

// QwantShiny AltFire move pool (vanilla + addon; flat weighted).
int uh_shiny_qwant_move_count = 0;
str uh_shiny_qwant_move_wep[UH_MAX_SHINYMOVES];
int uh_shiny_qwant_move_weight[UH_MAX_SHINYMOVES];

// NegaManShiny slots 1..33 (index == slot; [0] unused). Addon API uses 26..33.
// Held cycle uses [0] only (one actor per slot; Fire1/2/3 = charge tiers).
// L2/L3 columns kept for API compat; empty = unused.
str uh_shiny_nega_slot_wep[UH_SHINYNEGA_CYCLE_RESET][3];
// Currently held NegaShiny_*_W / NegaManShiny_W classname (cycle Give/Take).
str uh_nega_held[64];

// DecoyBot copy slots (index == slot). Vanilla 0..58 registered first; addon 59+.
// Table stores stem only (e.g. "DecoyCopy_00"); Give appends _W1/_W2/_W3.
int uh_decoy_move_count = 0;
str uh_decoy_move_wep[UH_MAX_SHINYMOVES];
// Per-player currently held DecoyCopy_*_W1/_W2/_W3 actor names ("" = parents).
str uh_decoy_held1[64];
str uh_decoy_held2[64];
str uh_decoy_held3[64];
// Shiny DecoyBot weapon paired with each normal Decoy slot. Empty entries are
// legal (old addons only registered the normal stem) and are skipped by M2.
str uh_decoy_shiny_wep[UH_MAX_SHINYMOVES];
str uh_decoy_shiny_held[64];

// Shiny MegaMan flat fire-actor pools (M1 = Fire, M2 = AltFire).
// TRUE registers the same actor into both with the same weight.
int uh_shiny_mega_main_count = 0;
str uh_shiny_mega_main_actor[UH_MAX_SHINYMOVES];
int uh_shiny_mega_main_weight[UH_MAX_SHINYMOVES];
int uh_shiny_mega_alt_count = 0;
str uh_shiny_mega_alt_actor[UH_MAX_SHINYMOVES];
int uh_shiny_mega_alt_weight[UH_MAX_SHINYMOVES];
// One row per unique DefineShinyMegaCopyWep(actor, kind, weight) definition.
// DecoyBot TrueRNG rolls this table so TRUE entries are not counted twice.
int uh_shiny_mega_all_count = 0;
str uh_shiny_mega_all_actor[UH_MAX_SHINYMOVES];
int uh_shiny_mega_all_weight[UH_MAX_SHINYMOVES];
int uh_shiny_mega_all_kind[UH_MAX_SHINYMOVES];

// QwantShiny: register a custom AltFire move weapon. weight < 1 becomes 1.
// Same (wepActor) again returns the existing row (no double entry).
function int DefineShinyQwantMoveWepCore(str wep_actor, int weight) {
	int i;
	if (StrCmp(wep_actor, "") == 0)
		return UHCOPY_FAIL;
	for (i = 0; i < uh_shiny_qwant_move_count; i++) {
		if (StrICmp(uh_shiny_qwant_move_wep[i], wep_actor) == 0)
			return i;
	}
	if (uh_shiny_qwant_move_count >= UH_MAX_SHINYMOVES)
		return UHCOPY_FAIL;
	uh_shiny_qwant_move_wep[uh_shiny_qwant_move_count] = wep_actor;
	uh_shiny_qwant_move_weight[uh_shiny_qwant_move_count] = weight < 1? 1:weight;
	uh_shiny_qwant_move_count++;
	return uh_shiny_qwant_move_count - 1;
}

// NegaManShiny: register slot 1..33 held weapon (wepL1). Fire1/2/3 live on that
// actor. wepL2/wepL3 ignored by the held cycle (pass "" ). Addons: 26..33.
function int DefineShinyNegaSlotWepCore(int slot, str wep_l1, str wep_l2, str wep_l3) {
	if (slot < 1 || slot > UH_SHINYNEGA_SLOTMAX)
		return UHCOPY_FAIL;
	if (StrCmp(wep_l1, "") == 0)
		return UHCOPY_FAIL;
	uh_shiny_nega_slot_wep[slot][0] = wep_l1;
	uh_shiny_nega_slot_wep[slot][1] = wep_l2;
	uh_shiny_nega_slot_wep[slot][2] = wep_l3;
	return slot;
}

// Strip trailing _W / _W1.._W9 so registration accepts DecoyCopy_00_W or _W1.
function str UH_DecoyMoveStem(str wep_actor) {
	int len = StrLen(wep_actor);
	int d;
	if (len < 2)
		return wep_actor;
	if (len >= 4
		&& GetChar(wep_actor, len - 3) == '_'
		&& GetChar(wep_actor, len - 2) == 'W') {
		d = GetChar(wep_actor, len - 1);
		if (d >= '1' && d <= '9')
			return StrLeft(wep_actor, len - 3);
	}
	if (GetChar(wep_actor, len - 2) == '_' && GetChar(wep_actor, len - 1) == 'W')
		return StrLeft(wep_actor, len - 2);
	return wep_actor;
}

// DecoyBot: register a copy slot. Slot is auto-assigned as the next index
// (vanilla 0..58 first, then addon 59+). Same stem again returns the
// existing slot index. Accepts stem or *_W / *_W1..*_W3.
function int DefineDecoyBotMoveWepCore(str wep_actor) {
	int i;
	str stem;
	if (StrCmp(wep_actor, "") == 0)
		return UHCOPY_FAIL;
	stem = UH_DecoyMoveStem(wep_actor);
	if (StrCmp(stem, "") == 0)
		return UHCOPY_FAIL;
	for (i = 0; i < uh_decoy_move_count; i++) {
		if (StrICmp(uh_decoy_move_wep[i], stem) == 0)
			return i;
	}
	if (uh_decoy_move_count >= UH_MAX_SHINYMOVES)
		return UHCOPY_FAIL;
	uh_decoy_move_wep[uh_decoy_move_count] = stem;
	uh_decoy_move_count++;
	return uh_decoy_move_count - 1;
}

// Pair a shiny held weapon with a normal DecoyBot stem. Registering the shiny
// half first is supported: the normal stem receives the next ordinary slot,
// so both forms always share one stable index.
function int DefineDecoyBotShinyWepCore(str wep_actor, str shiny_wep_actor) {
	int slot;
	if (StrCmp(wep_actor, "") == 0 || StrCmp(shiny_wep_actor, "") == 0)
		return UHCOPY_FAIL;
	slot = DefineDecoyBotMoveWepCore(wep_actor);
	if (slot < 0 || slot >= UH_MAX_SHINYMOVES)
		return UHCOPY_FAIL;
	uh_decoy_shiny_wep[slot] = shiny_wep_actor;
	return slot;
}

// Shiny MegaMan: register a fire CustomInventory into M1 (Fire), M2 (AltFire),
// or TRUE (both, same weight). Same (actor, pool) again returns existing index.
// which: UH_SHINYMEGA_M1 / M2 / TRUE.
function int DefineShinyMegaCopyWepCore(int which, str fire_actor, int weight) {
	int w;
	int i;
	int last;
	int allrow;
	if (StrCmp(fire_actor, "") == 0)
		return UHCOPY_FAIL;
	if (which != UH_SHINYMEGA_M1 && which != UH_SHINYMEGA_M2 && which != UH_SHINYMEGA_TRUE)
		return UHCOPY_FAIL;
	w = weight < 1? 1:weight;
	last = -1;
	allrow = -1;
	for (i = 0; i < uh_shiny_mega_all_count; i++) {
		if (StrICmp(uh_shiny_mega_all_actor[i], fire_actor) == 0 && uh_shiny_mega_all_kind[i] == which) {
			allrow = i;
			break;
		}
	}
	if (allrow < 0) {
		if (uh_shiny_mega_all_count >= UH_MAX_SHINYMOVES)
			return UHCOPY_FAIL;
		allrow = uh_shiny_mega_all_count;
		uh_shiny_mega_all_actor[allrow] = fire_actor;
		uh_shiny_mega_all_weight[allrow] = w;
		uh_shiny_mega_all_kind[allrow] = which;
		uh_shiny_mega_all_count++;
	}

	if (which == UH_SHINYMEGA_M1 || which == UH_SHINYMEGA_TRUE) {
		for (i = 0; i < uh_shiny_mega_main_count; i++) {
			if (StrICmp(uh_shiny_mega_main_actor[i], fire_actor) == 0) {
				last = i;
				break;
			}
		}
		if (last < 0) {
			if (uh_shiny_mega_main_count >= UH_MAX_SHINYMOVES)
				return UHCOPY_FAIL;
			last = uh_shiny_mega_main_count;
			uh_shiny_mega_main_actor[last] = fire_actor;
			uh_shiny_mega_main_weight[last] = w;
			uh_shiny_mega_main_count++;
		}
	}

	if (which == UH_SHINYMEGA_M2 || which == UH_SHINYMEGA_TRUE) {
		for (i = 0; i < uh_shiny_mega_alt_count; i++) {
			if (StrICmp(uh_shiny_mega_alt_actor[i], fire_actor) == 0) {
				last = i;
				break;
			}
		}
		if (i >= uh_shiny_mega_alt_count) {
			if (uh_shiny_mega_alt_count >= UH_MAX_SHINYMOVES)
				return UHCOPY_FAIL;
			last = uh_shiny_mega_alt_count;
			uh_shiny_mega_alt_actor[last] = fire_actor;
			uh_shiny_mega_alt_weight[last] = w;
			uh_shiny_mega_alt_count++;
		}
	}
	return last;
}

// Total DecoyBot copy slot count (vanilla 59 once registered + addon).
function int CountDecoyBotSlots(void) {
	return uh_decoy_move_count;
}

// Next cycle slot after a full-charge shot on `slot` (0 = buster).
function int UH_ShinyNegaNextSlot(int slot) {
	int n;
	if (slot < 0)
		slot = 0;
	if (slot == 0)
		return 1;
	if (slot == 25) {
		if (HasCustomNegaSlots())
			return 26;
		return 0;
	}
	n = slot + 1;
	if (n >= UH_SHINYNEGA_CYCLE_RESET)
		return 0;
	if (n > 25) {
		while (n <= UH_SHINYNEGA_SLOTMAX) {
			if (StrCmp(uh_shiny_nega_slot_wep[n][0], "") != 0)
				return n;
			n++;
		}
		return 0;
	}
	return n;
}

// Resolve a NegaManShiny slot charge weapon. lvl: 1..3. Slots 1..33.
// Held cycle uses lvl 1 (one actor per slot; Fire1/2/3 are charge tiers).
function str GetShinyNegaSlotWep(int slot, int lvl) {
	str wep;
	if (slot < 1 || slot > UH_SHINYNEGA_SLOTMAX)
		return "";
	wep = lvl == 2? uh_shiny_nega_slot_wep[slot][1]
	:lvl == 3? uh_shiny_nega_slot_wep[slot][2]
	:uh_shiny_nega_slot_wep[slot][0];
	if (StrCmp(wep, "") == 0)
		return uh_shiny_nega_slot_wep[slot][0];
	return wep;
}

// Any addon NegaManShiny slot (26..33) registered? (gates full-charge wrap.)
function int HasCustomNegaSlots(void) {
	int i;
	for (i = UH_SHINYNEGA_SLOTBASE; i <= UH_SHINYNEGA_SLOTMAX; i++) {
		if (StrCmp(uh_shiny_nega_slot_wep[i][0], "") != 0)
			return 1;
	}
	return 0;
}

// ============================================================================
// Eye-morph effect pools (APPENDED LAST)
//
// A MorphProjectile's PlayerClass is a DECORATE-time property in Zandronum,
// so the registry stores concrete effect actors rather than trying to change
// the morph class at runtime.  A row may provide a different actor for each
// delivery mode; empty modes are simply omitted from that mode's roll.
// ============================================================================

#libdefine UH_MAX_EYEMORPH_POOLS 64
#libdefine UH_MAX_EYEMORPH_ENTRIES 1024
#libdefine UHEM_MAX_WEIGHT 1000000
#libdefine UHEM_FAIL -9999
#libdefine UHEM_MODE_SHOT 0
#libdefine UHEM_MODE_BURST 1
#libdefine UHEM_MODE_GIVER 2

int uh_eye_morph_pool_count = 0;
str uh_eye_morph_pool_name[UH_MAX_EYEMORPH_POOLS];

int uh_eye_morph_entry_count = 0;
int uh_eye_morph_entry_pool[UH_MAX_EYEMORPH_ENTRIES];
int uh_eye_morph_entry_eye[UH_MAX_EYEMORPH_ENTRIES];
str uh_eye_morph_entry_shot[UH_MAX_EYEMORPH_ENTRIES];
str uh_eye_morph_entry_burst[UH_MAX_EYEMORPH_ENTRIES];
str uh_eye_morph_entry_giver[UH_MAX_EYEMORPH_ENTRIES];
int uh_eye_morph_entry_weight[UH_MAX_EYEMORPH_ENTRIES];

function int FindEyeMorphPool(str pool) {
	int i;
	if (StrCmp(pool, "") == 0)
		return UHEM_FAIL;
	for (i = 0; i < uh_eye_morph_pool_count; i++) {
		if (StrICmp(uh_eye_morph_pool_name[i], pool) == 0)
			return i;
	}
	return UHEM_FAIL;
}

function int DefineEyeMorphPoolCore(str pool) {
	int id;
	if (StrCmp(pool, "") == 0)
		return UHEM_FAIL;
	id = FindEyeMorphPool(pool);
	if (id != UHEM_FAIL)
		return id;
	if (uh_eye_morph_pool_count >= UH_MAX_EYEMORPH_POOLS)
		return UHEM_FAIL;
	id = uh_eye_morph_pool_count;
	uh_eye_morph_pool_name[id] = pool;
	uh_eye_morph_pool_count++;
	return id;
}

function int FindEyeMorphEntry(int poolid, int eye_id) {
	int i;
	for (i = 0; i < uh_eye_morph_entry_count; i++) {
		if (uh_eye_morph_entry_pool[i] == poolid && uh_eye_morph_entry_eye[i] == eye_id)
			return i;
	}
	return UHEM_FAIL;
}

// Register or replace one (pool, eye) row.  The pool must already have been
// created with DefineEyeMorphPoolCore.  A zero weight disables a row without
// destroying it, allowing addons to restore the original definition.
function int SetEyeMorphPoolEntryCore(
	str pool,
	int eye_id,
	str shot_actor,
	str burst_actor,
	str giver_actor,
	int weight) {
	int poolid;
	int row;
	if (StrCmp(pool, "") == 0)
		return UHEM_FAIL;
	if (!IsEyeDefined(eye_id))
		return UHEM_FAIL;
	if (StrCmp(shot_actor, "") == 0
		&& StrCmp(burst_actor, "") == 0
		&& StrCmp(giver_actor, "") == 0)
		return UHEM_FAIL;
	if (weight < 0 || weight > UHEM_MAX_WEIGHT)
		return UHEM_FAIL;
	poolid = FindEyeMorphPool(pool);
	if (poolid == UHEM_FAIL)
		return UHEM_FAIL;
	row = FindEyeMorphEntry(poolid, eye_id);
	if (row == UHEM_FAIL) {
		if (uh_eye_morph_entry_count >= UH_MAX_EYEMORPH_ENTRIES)
			return UHEM_FAIL;
		row = uh_eye_morph_entry_count;
		uh_eye_morph_entry_pool[row] = poolid;
		uh_eye_morph_entry_eye[row] = eye_id;
		uh_eye_morph_entry_count++;
	}
	uh_eye_morph_entry_shot[row] = shot_actor;
	uh_eye_morph_entry_burst[row] = burst_actor;
	uh_eye_morph_entry_giver[row] = giver_actor;
	uh_eye_morph_entry_weight[row] = weight;
	return row;
}

function int GetEyeMorphPoolWeightCore(str pool, int eye_id) {
	int poolid = FindEyeMorphPool(pool);
	int row;
	if (poolid == UHEM_FAIL)
		return UHEM_FAIL;
	row = FindEyeMorphEntry(poolid, eye_id);
	if (row == UHEM_FAIL)
		return UHEM_FAIL;
	return uh_eye_morph_entry_weight[row];
}

function str GetEyeMorphPoolActorCore(str pool, int eye_id, int mode) {
	int poolid = FindEyeMorphPool(pool);
	int row;
	if (mode < UHEM_MODE_SHOT || mode > UHEM_MODE_GIVER)
		return "";
	if (poolid == UHEM_FAIL)
		return "";
	row = FindEyeMorphEntry(poolid, eye_id);
	if (row == UHEM_FAIL)
		return "";
	if (mode == UHEM_MODE_SHOT)
		return uh_eye_morph_entry_shot[row];
	if (mode == UHEM_MODE_BURST)
		return uh_eye_morph_entry_burst[row];
	return uh_eye_morph_entry_giver[row];
}

function int EyeMorphPoolWeightSum(int poolid, int mode) {
	int sum = 0;
	int i;
	str actor;
	if (mode < UHEM_MODE_SHOT || mode > UHEM_MODE_GIVER)
		return 0;
	for (i = 0; i < uh_eye_morph_entry_count; i++) {
		if (uh_eye_morph_entry_pool[i] != poolid || uh_eye_morph_entry_weight[i] <= 0)
			continue;
		actor = mode == UHEM_MODE_SHOT? uh_eye_morph_entry_shot[i]
		:mode == UHEM_MODE_BURST? uh_eye_morph_entry_burst[i]
		:uh_eye_morph_entry_giver[i];
		if (StrCmp(actor, "") != 0)
			sum += uh_eye_morph_entry_weight[i];
	}
	return sum;
}

function int RandomEyeMorphEntry(str pool, int mode) {
	int poolid = FindEyeMorphPool(pool);
	int sum;
	int roll;
	int i;
	str actor;
	if (poolid == UHEM_FAIL)
		return UHEM_FAIL;
	sum = EyeMorphPoolWeightSum(poolid, mode);
	if (sum <= 0)
		return UHEM_FAIL;
	roll = random(1, sum);
	for (i = 0; i < uh_eye_morph_entry_count; i++) {
		if (uh_eye_morph_entry_pool[i] != poolid || uh_eye_morph_entry_weight[i] <= 0)
			continue;
		actor = mode == UHEM_MODE_SHOT? uh_eye_morph_entry_shot[i]
		:mode == UHEM_MODE_BURST? uh_eye_morph_entry_burst[i]
		:uh_eye_morph_entry_giver[i];
		if (StrCmp(actor, "") == 0)
			continue;
		roll -= uh_eye_morph_entry_weight[i];
		if (roll <= 0)
			return i;
	}
	return UHEM_FAIL;
}

function str PickEyeMorphActorCore(str pool, int mode) {
	int row = RandomEyeMorphEntry(pool, mode);
	if (row == UHEM_FAIL)
		return "";
	if (mode == UHEM_MODE_SHOT)
		return uh_eye_morph_entry_shot[row];
	if (mode == UHEM_MODE_BURST)
		return uh_eye_morph_entry_burst[row];
	return uh_eye_morph_entry_giver[row];
}

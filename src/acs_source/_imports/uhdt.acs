	uh_eye_custom_str[i][UHEYE_STR_MUGSHOT] = mugshot;
	uh_eye_custom_str[i][UHEYE_STR_EVENTSTEM] = event_stem;
	uh_eye_custom_count++;
	return eye_id;
}


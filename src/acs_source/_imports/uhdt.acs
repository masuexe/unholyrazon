		uh_player_eye_id[i] = UHEYE_FAIL;
}

function void SetPlayerEyeId(int player_num, int eye_id) {
	if (player_num < 0 || player_num >= UH_MAX_PLAYERS)
		return;
	uh_player_eye_id[player_num] = eye_id;
}


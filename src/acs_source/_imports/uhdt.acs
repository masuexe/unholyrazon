str uh_item_drop_give[UH_MAX_ITEM_DROPS];
int uh_item_last_drop_row = -1;

// DLC_Coin threshold spends: identity (minCount, giveActor); same key returns existing row.
// Runtime: highest minCount with coins >= minCount; ties uniform-random among that tier.
int uh_coin_spend_count = 0;
int uh_coin_spend_min[UH_MAX_COIN_SPENDS];
int uh_coin_spend_take[UH_MAX_COIN_SPENDS];
str uh_coin_spend_give[UH_MAX_COIN_SPENDS];

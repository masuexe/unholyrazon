// str fields per boss
#LIBDEFINE UHBOSS_STR_ACTOR 0
#LIBDEFINE UHBOSS_STR_NAME 1
#LIBDEFINE UHBOSS_STR_MUGSHOT 2
#LIBDEFINE UHBOSS_STR_MUSIC 3
#LIBDEFINE UHBOSS_STR_MUSICCREDIT 4
#LIBDEFINE UHBOSS_STR_INSTRUCTION 5
#LIBDEFINE UHBOSS_STR_SPAWNMSGTYPE 6
#LIBDEFINE UHBOSS_STR_SPAWNMSG 7
#LIBDEFINE UHBOSS_STR_EXBASEACTOR 8
#LIBDEFINE UHBOSS_STR_COUNT 9

// int fields per boss
#LIBDEFINE UHBOSS_INT_RARITY 0
#LIBDEFINE UHBOSS_INT_BASEHP 1
#LIBDEFINE UHBOSS_INT_ADDHP 2
#LIBDEFINE UHBOSS_INT_EXBASEID 3
#LIBDEFINE UHBOSS_INT_COUNT 4

int uh_bossVanillaDefined[UH_MAX_VANILLA_BOSS];
str uh_bossVanillaStr[UH_MAX_VANILLA_BOSS][UHBOSS_STR_COUNT];
int uh_bossVanillaInt[UH_MAX_VANILLA_BOSS][UHBOSS_INT_COUNT];

int uh_bossCustomCount = 0;
str uh_bossCustomStr[UH_MAX_CUSTOM_BOSS][UHBOSS_STR_COUNT];
int uh_bossCustomInt[UH_MAX_CUSTOM_BOSS][UHBOSS_INT_COUNT];

// rarity pool: list of signed bossIds
int uh_bossPoolCount[UHBOSS_POOL_COUNT];
int uh_bossPoolIds[UHBOSS_POOL_COUNT][UH_MAX_VANILLA_BOSS];

// Per-player signed boss type (Inventory cannot hold negatives)
#LIBDEFINE UH_MAX_PLAYERS 64
int uh_playerBossId[UH_MAX_PLAYERS];

script "uh_BossIdStorageInit" OPEN
{
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_playerBossId[i] = UHBOSS_FAIL;
}

// Joining clients never run non-CLIENTSIDE OPEN; init local uh_playerBossId.
script "uh_BossIdStorageInit_cs" OPEN CLIENTSIDE
{
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_playerBossId[i] = UHBOSS_FAIL;
}

function int UH_BossCustomIndex(int id)
{
	return -1 - id;
}

function void SetPlayerBossId(int playerNum, int bossId)
{
	if (playerNum < 0 || playerNum >= UH_MAX_PLAYERS)
		return;
	uh_playerBossId[playerNum] = bossId;
}

function int GetPlayerBossId(int playerNum)
{
	if (playerNum < 0 || playerNum >= UH_MAX_PLAYERS)
		return UHBOSS_FAIL;
	return uh_playerBossId[playerNum];
}

function bool IsBossDefined(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_BOSS)
			return false;
		return uh_bossVanillaDefined[id] != 0;
	}
	if (id <= -1)
	{
		int i = UH_BossCustomIndex(id);
		if (i < 0 || i >= uh_bossCustomCount)
			return false;
		return true;
	}
	return false;
}

function int UH_BossResolveSlot(int id)
{
	// Returns storage index for getters; vanilla id == slot, custom uses customIndex.
	// Caller must IsBossDefined first. Returns UHBOSS_FAIL if invalid.
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_BOSS || uh_bossVanillaDefined[id] == 0)
			return UHBOSS_FAIL;
		return id;
	}
	if (id <= -1)
	{
		int i = UH_BossCustomIndex(id);
		if (i < 0 || i >= uh_bossCustomCount)
			return UHBOSS_FAIL;
		return i;
	}
	return UHBOSS_FAIL;
}

function str GetBossActor(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_ACTOR];
	return uh_bossCustomStr[slot][UHBOSS_STR_ACTOR];
}

function str GetBossName(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_NAME];
	return uh_bossCustomStr[slot][UHBOSS_STR_NAME];
}

function str GetBossMugshot(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_MUGSHOT];
	return uh_bossCustomStr[slot][UHBOSS_STR_MUGSHOT];
}

function str getBossMusic(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_MUSIC];
	return uh_bossCustomStr[slot][UHBOSS_STR_MUSIC];
}

function str getBossMusicCredit(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_MUSICCREDIT];
	return uh_bossCustomStr[slot][UHBOSS_STR_MUSICCREDIT];
}

function str GetBossInstruction(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_INSTRUCTION];
	return uh_bossCustomStr[slot][UHBOSS_STR_INSTRUCTION];
}

function str GetBossSpawnMsgType(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_SPAWNMSGTYPE];
	return uh_bossCustomStr[slot][UHBOSS_STR_SPAWNMSGTYPE];
}

function str GetBossSpawnMsg(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_SPAWNMSG];
	return uh_bossCustomStr[slot][UHBOSS_STR_SPAWNMSG];
}

function str GetBossExBaseActor(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_bossVanillaStr[slot][UHBOSS_STR_EXBASEACTOR];
	return uh_bossCustomStr[slot][UHBOSS_STR_EXBASEACTOR];
}

function int GetBossRarity(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return UHBOSS_POOL_NONE;
	if (id >= 0)
		return uh_bossVanillaInt[slot][UHBOSS_INT_RARITY];
	return uh_bossCustomInt[slot][UHBOSS_INT_RARITY];
}

function int GetBossHPBase(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return 0;
	if (id >= 0)
		return uh_bossVanillaInt[slot][UHBOSS_INT_BASEHP];
	return uh_bossCustomInt[slot][UHBOSS_INT_BASEHP];
}

function int GetBossHPAdd(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return 0;
	if (id >= 0)
		return uh_bossVanillaInt[slot][UHBOSS_INT_ADDHP];
	return uh_bossCustomInt[slot][UHBOSS_INT_ADDHP];
}

function int GetBossExBaseId(int id)
{
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return UHBOSS_FAIL;
	if (id >= 0)
		return uh_bossVanillaInt[slot][UHBOSS_INT_EXBASEID];
	return uh_bossCustomInt[slot][UHBOSS_INT_EXBASEID];
}

function int FindBossByActor(str actor)
{
	int i;
	if (StrCmp(actor, "") == 0)
		return UHBOSS_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++)
	{
		if (uh_bossVanillaDefined[i] != 0 && StrICmp(actor, uh_bossVanillaStr[i][UHBOSS_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_bossCustomCount; i++)
	{
		if (StrICmp(actor, uh_bossCustomStr[i][UHBOSS_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHBOSS_FAIL;
}

function int UH_BossResolveExBaseId(str exboss_baseactor)
{
	if (StrCmp(exboss_baseactor, "") == 0)
		return UHBOSS_FAIL;
	return FindBossByActor(exboss_baseactor);
}

// Parent of an EX boss. UHBOSS_FAIL if not an EX / unknown.
function int GetBossBaseId(int id)
{
	int cached = GetBossExBaseId(id);
	if (cached != UHBOSS_FAIL)
		return cached;
	return UH_BossResolveExBaseId(GetBossExBaseActor(id));
}

function bool IsBossEx(int id)
{
	return GetBossBaseId(id) != UHBOSS_FAIL;
}

// EX child of a base boss. UHBOSS_FAIL if none registered.
function int GetBossExId(int baseId)
{
	int i;
	if (!IsBossDefined(baseId))
		return UHBOSS_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++)
	{
		if (uh_bossVanillaDefined[i] != 0 && uh_bossVanillaInt[i][UHBOSS_INT_EXBASEID] == baseId)
			return i;
	}
	for (i = 0; i < uh_bossCustomCount; i++)
	{
		if (uh_bossCustomInt[i][UHBOSS_INT_EXBASEID] == baseId)
			return -1 - i;
	}
	// Lazy: match exboss_baseactor string if EXBASEID not filled yet
	str baseActor = GetBossActor(baseId);
	if (StrCmp(baseActor, "") == 0)
		return UHBOSS_FAIL;
	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++)
	{
		if (uh_bossVanillaDefined[i] != 0 && StrICmp(uh_bossVanillaStr[i][UHBOSS_STR_EXBASEACTOR], baseActor) == 0)
			return i;
	}
	for (i = 0; i < uh_bossCustomCount; i++)
	{
		if (StrICmp(uh_bossCustomStr[i][UHBOSS_STR_EXBASEACTOR], baseActor) == 0)
			return -1 - i;
	}
	return UHBOSS_FAIL;
}

function void UH_BossAppendPool(int rarity, int bossId)
{
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return;
	int n = uh_bossPoolCount[rarity];
	if (n < 0 || n >= UH_MAX_VANILLA_BOSS)
		return;
	uh_bossPoolIds[rarity][n] = bossId;
	uh_bossPoolCount[rarity] = n + 1;
}

function int GetBossPoolCount(int rarity)
{
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return 0;
	return uh_bossPoolCount[rarity];
}

function int GetBossPoolId(int rarity, int index)
{
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return UHBOSS_FAIL;
	if (index < 0 || index >= uh_bossPoolCount[rarity])
		return UHBOSS_FAIL;
	return uh_bossPoolIds[rarity][index];
}

function int RandomBossFromPool(int rarity)
{
	int n = GetBossPoolCount(rarity);
	if (n <= 0)
		return UHBOSS_FAIL;
	return GetBossPoolId(rarity, random(0, n - 1));
}

function void UH_BossWriteVanilla(int id, str actor, str name, int rarity, int basehp, int addhp,
	str exboss_baseactor, str mugshot, str musiclump, str musiccredit,
	str instruction, str spawnmessagetype, str spawnmessage)
{
	int baseId;
	uh_bossVanillaDefined[id] = 1;
	uh_bossVanillaStr[id][UHBOSS_STR_ACTOR] = actor;
	uh_bossVanillaStr[id][UHBOSS_STR_NAME] = name;
	uh_bossVanillaStr[id][UHBOSS_STR_MUGSHOT] = mugshot;
	uh_bossVanillaStr[id][UHBOSS_STR_MUSIC] = musiclump;
	uh_bossVanillaStr[id][UHBOSS_STR_MUSICCREDIT] = musiccredit;
	uh_bossVanillaStr[id][UHBOSS_STR_INSTRUCTION] = instruction;
	uh_bossVanillaStr[id][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
	uh_bossVanillaStr[id][UHBOSS_STR_SPAWNMSG] = spawnmessage;
	uh_bossVanillaStr[id][UHBOSS_STR_EXBASEACTOR] = exboss_baseactor;
	uh_bossVanillaInt[id][UHBOSS_INT_RARITY] = rarity;
	uh_bossVanillaInt[id][UHBOSS_INT_BASEHP] = basehp;
	uh_bossVanillaInt[id][UHBOSS_INT_ADDHP] = addhp;
	baseId = UH_BossResolveExBaseId(exboss_baseactor);
	uh_bossVanillaInt[id][UHBOSS_INT_EXBASEID] = baseId;
	UH_BossAppendPool(rarity, id);
}

function int UH_BossWriteCustom(str actor, str name, int rarity, int basehp, int addhp,
	str exboss_baseactor, str mugshot, str musiclump, str musiccredit,
	str instruction, str spawnmessagetype, str spawnmessage)
{
	int i = uh_bossCustomCount;
	int bossId = -1 - i;
	int baseId;
	uh_bossCustomStr[i][UHBOSS_STR_ACTOR] = actor;
	uh_bossCustomStr[i][UHBOSS_STR_NAME] = name;
	uh_bossCustomStr[i][UHBOSS_STR_MUGSHOT] = mugshot;
	uh_bossCustomStr[i][UHBOSS_STR_MUSIC] = musiclump;
	uh_bossCustomStr[i][UHBOSS_STR_MUSICCREDIT] = musiccredit;
	uh_bossCustomStr[i][UHBOSS_STR_INSTRUCTION] = instruction;
	uh_bossCustomStr[i][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
	uh_bossCustomStr[i][UHBOSS_STR_SPAWNMSG] = spawnmessage;
	uh_bossCustomStr[i][UHBOSS_STR_EXBASEACTOR] = exboss_baseactor;
	uh_bossCustomInt[i][UHBOSS_INT_RARITY] = rarity;
	uh_bossCustomInt[i][UHBOSS_INT_BASEHP] = basehp;
	uh_bossCustomInt[i][UHBOSS_INT_ADDHP] = addhp;
	baseId = UH_BossResolveExBaseId(exboss_baseactor);
	uh_bossCustomInt[i][UHBOSS_INT_EXBASEID] = baseId;
	uh_bossCustomCount++;
	UH_BossAppendPool(rarity, bossId);
	return bossId;
}

// --- DefineSurvivor tables ---------------------------------------------------

#LIBDEFINE UHSURV_STR_ACTOR 0
#LIBDEFINE UHSURV_STR_NAME 1
#LIBDEFINE UHSURV_STR_MUGSHOT 2
#LIBDEFINE UHSURV_STR_COUNT 3

int uh_survVanillaDefined[UH_MAX_VANILLA_SURV];
str uh_survVanillaStr[UH_MAX_VANILLA_SURV][UHSURV_STR_COUNT];

int uh_survCustomCount = 0;
str uh_survCustomStr[UH_MAX_CUSTOM_SURV][UHSURV_STR_COUNT];

function int SurvCustomIndex(int id)
{
	return -1 - id;
}

function bool IsSurvivorDefined(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_SURV)
			return false;
		return uh_survVanillaDefined[id] != 0;
	}
	if (id <= -1)
	{
		int i = SurvCustomIndex(id);
		if (i < 0 || i >= uh_survCustomCount)
			return false;
		return true;
	}
	return false;
}

function int SurvResolveSlot(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_SURV || uh_survVanillaDefined[id] == 0)
			return UHSURV_FAIL;
		return id;
	}
	if (id <= -1)
	{
		int i = SurvCustomIndex(id);
		if (i < 0 || i >= uh_survCustomCount)
			return UHSURV_FAIL;
		return i;
	}
	return UHSURV_FAIL;
}

function str GetSurvivorActor(int id)
{
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_survVanillaStr[slot][UHSURV_STR_ACTOR];
	return uh_survCustomStr[slot][UHSURV_STR_ACTOR];
}

function str GetSurvivorName(int id)
{
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_survVanillaStr[slot][UHSURV_STR_NAME];
	return uh_survCustomStr[slot][UHSURV_STR_NAME];
}

function str GetSurvivorMugshot(int id)
{
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	str mug;
	if (id >= 0)
		mug = uh_survVanillaStr[slot][UHSURV_STR_MUGSHOT];
	else
		mug = uh_survCustomStr[slot][UHSURV_STR_MUGSHOT];
	if (StrCmp(mug, "") != 0)
		return mug;
	// Empty mugshot: vanilla KEYCONF id → UMUG_{id}; custom must set explicit.
	if (id >= 0)
		return StrParam(s: "UMUG_", i: id);
	return "";
}

// Stored mugshot only (no UMUG fallback). Empty = use legacy C@ICN / C-ICN paths.
function str GetSurvivorMugshotRaw(int id)
{
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_survVanillaStr[slot][UHSURV_STR_MUGSHOT];
	return uh_survCustomStr[slot][UHSURV_STR_MUGSHOT];
}

function str GetSurvivorShinyActor(int id)
{
	str actor = GetSurvivorActor(id);
	if (StrCmp(actor, "") == 0)
		return "";
	return StrParam(s: actor, s: "Shiny");
}

function int FindSurvivorByActor(str actor)
{
	int i;
	if (StrCmp(actor, "") == 0)
		return UHSURV_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_SURV; i++)
	{
		if (uh_survVanillaDefined[i] != 0 && StrICmp(actor, uh_survVanillaStr[i][UHSURV_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_survCustomCount; i++)
	{
		if (StrICmp(actor, uh_survCustomStr[i][UHSURV_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHSURV_FAIL;
}

function void SurvWriteVanilla(int id, str actor, str name, str mugshot)
{
	uh_survVanillaDefined[id] = 1;
	uh_survVanillaStr[id][UHSURV_STR_ACTOR] = actor;
	uh_survVanillaStr[id][UHSURV_STR_NAME] = name;
	uh_survVanillaStr[id][UHSURV_STR_MUGSHOT] = mugshot;
}

function int SurvWriteCustom(str actor, str name, str mugshot)
{
	int i = uh_survCustomCount;
	int survId = -1 - i;
	uh_survCustomStr[i][UHSURV_STR_ACTOR] = actor;
	uh_survCustomStr[i][UHSURV_STR_NAME] = name;
	uh_survCustomStr[i][UHSURV_STR_MUGSHOT] = mugshot;
	uh_survCustomCount++;
	return survId;
}

// --- DefineDemoneye tables ---------------------------------------------------

#LIBDEFINE UHEYE_STR_ACTOR 0
#LIBDEFINE UHEYE_STR_NAME 1
#LIBDEFINE UHEYE_STR_PREFIX 2
#LIBDEFINE UHEYE_STR_MUGSHOT 3
#LIBDEFINE UHEYE_STR_EVENTSTEM 4
#LIBDEFINE UHEYE_STR_COUNT 5

int uh_eyeVanillaDefined[UH_MAX_VANILLA_EYE];
str uh_eyeVanillaStr[UH_MAX_VANILLA_EYE][UHEYE_STR_COUNT];
int uh_eyeVanillaFlags[UH_MAX_VANILLA_EYE];

int uh_eyeCustomCount = 0;
str uh_eyeCustomStr[UH_MAX_CUSTOM_EYE][UHEYE_STR_COUNT];
int uh_eyeCustomFlags[UH_MAX_CUSTOM_EYE];

int uh_playerEyeId[UH_MAX_PLAYERS];

script "uh_EyeIdStorageInit" OPEN
{
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_playerEyeId[i] = UHEYE_FAIL;
}

script "uh_EyeIdStorageInit_cs" OPEN CLIENTSIDE
{
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_playerEyeId[i] = UHEYE_FAIL;
}

function void SetPlayerEyeId(int playerNum, int eyeId)
{
	if (playerNum < 0 || playerNum >= UH_MAX_PLAYERS)
		return;
	uh_playerEyeId[playerNum] = eyeId;
}

function int GetPlayerEyeId(int playerNum)
{
	if (playerNum < 0 || playerNum >= UH_MAX_PLAYERS)
		return UHEYE_FAIL;
	return uh_playerEyeId[playerNum];
}

function int EyeCustomIndex(int id)
{
	return -1 - id;
}

function bool IsEyeDefined(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_EYE)
			return false;
		return uh_eyeVanillaDefined[id] != 0;
	}
	if (id <= -1)
	{
		int i = EyeCustomIndex(id);
		if (i < 0 || i >= uh_eyeCustomCount)
			return false;
		return true;
	}
	return false;
}

function int EyeResolveSlot(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_EYE || uh_eyeVanillaDefined[id] == 0)
			return UHEYE_FAIL;
		return id;
	}
	if (id <= -1)
	{
		int i = EyeCustomIndex(id);
		if (i < 0 || i >= uh_eyeCustomCount)
			return UHEYE_FAIL;
		return i;
	}
	return UHEYE_FAIL;
}

function str GetEyeActor(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eyeVanillaStr[slot][UHEYE_STR_ACTOR];
	return uh_eyeCustomStr[slot][UHEYE_STR_ACTOR];
}

function str GetEyeName(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eyeVanillaStr[slot][UHEYE_STR_NAME];
	return uh_eyeCustomStr[slot][UHEYE_STR_NAME];
}

function str GetEyePrefix(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eyeVanillaStr[slot][UHEYE_STR_PREFIX];
	return uh_eyeCustomStr[slot][UHEYE_STR_PREFIX];
}

function int GetEyeFlags(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return 0;
	if (id >= 0)
		return uh_eyeVanillaFlags[slot];
	return uh_eyeCustomFlags[slot];
}

function str GetEyeMugshot(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eyeVanillaStr[slot][UHEYE_STR_MUGSHOT];
	return uh_eyeCustomStr[slot][UHEYE_STR_MUGSHOT];
}

function str GetEyeEventStem(int id)
{
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eyeVanillaStr[slot][UHEYE_STR_EVENTSTEM];
	return uh_eyeCustomStr[slot][UHEYE_STR_EVENTSTEM];
}

// Personal morph line: "You are now {prefix}{name}[ Demoneye]!"
function str GetEyeYouAreNowName(int id)
{
	str prefix = GetEyePrefix(id);
	str name = GetEyeName(id);
	if (StrCmp(name, "") == 0)
		return "";
	if (GetEyeFlags(id) & UHEYE_FLAG_NOSUFFIX)
		return StrParam(s: prefix, s: name, s: "\ck");
	return StrParam(s: prefix, s: name, s: " \ckDemoneye");
}

// BHW / parade label: "Plain Demoneye" (no article). NOSUFFIX → name only.
function str GetEyeHudName(int id)
{
	str name = GetEyeName(id);
	if (StrCmp(name, "") == 0)
		return "";
	if (GetEyeFlags(id) & UHEYE_FLAG_NOSUFFIX)
		return name;
	return StrParam(s: name, s: " Demoneye");
}

function int FindEyeByActor(str actor)
{
	int i;
	if (StrCmp(actor, "") == 0)
		return UHEYE_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_EYE; i++)
	{
		if (uh_eyeVanillaDefined[i] != 0 && StrICmp(actor, uh_eyeVanillaStr[i][UHEYE_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_eyeCustomCount; i++)
	{
		if (StrICmp(actor, uh_eyeCustomStr[i][UHEYE_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHEYE_FAIL;
}

function void EyeWriteVanilla(int id, str actor, str name, str prefix, int flags, str mugshot, str eventStem)
{
	uh_eyeVanillaDefined[id] = 1;
	uh_eyeVanillaStr[id][UHEYE_STR_ACTOR] = actor;
	uh_eyeVanillaStr[id][UHEYE_STR_NAME] = name;
	uh_eyeVanillaStr[id][UHEYE_STR_PREFIX] = prefix;
	uh_eyeVanillaFlags[id] = flags;
	uh_eyeVanillaStr[id][UHEYE_STR_MUGSHOT] = mugshot;
	uh_eyeVanillaStr[id][UHEYE_STR_EVENTSTEM] = eventStem;
}

function int EyeWriteCustom(str actor, str name, str prefix, int flags, str mugshot, str eventStem)
{
	int i = uh_eyeCustomCount;
	int eyeId = -1 - i;
	uh_eyeCustomStr[i][UHEYE_STR_ACTOR] = actor;
	uh_eyeCustomStr[i][UHEYE_STR_NAME] = name;
	uh_eyeCustomStr[i][UHEYE_STR_PREFIX] = prefix;
	uh_eyeCustomFlags[i] = flags;
	uh_eyeCustomStr[i][UHEYE_STR_MUGSHOT] = mugshot;
	uh_eyeCustomStr[i][UHEYE_STR_EVENTSTEM] = eventStem;
	uh_eyeCustomCount++;
	return eyeId;
}

// --- DefineUnholyItem tables -------------------------------------------------

#LIBDEFINE UHITEM_STR_ACTOR 0
#LIBDEFINE UHITEM_STR_NAME 1
#LIBDEFINE UHITEM_STR_MUGSHOT 2
#LIBDEFINE UHITEM_STR_SOUND 3
#LIBDEFINE UHITEM_STR_OPENSOUND 4
#LIBDEFINE UHITEM_STR_EYEDROPSOUND 5
#LIBDEFINE UHITEM_STR_COUNT 6

int uh_itemVanillaDefined[UH_MAX_VANILLA_ITEM];
str uh_itemVanillaStr[UH_MAX_VANILLA_ITEM][UHITEM_STR_COUNT];
int uh_itemVanillaIsBox[UH_MAX_VANILLA_ITEM];

int uh_itemCustomCount = 0;
str uh_itemCustomStr[UH_MAX_CUSTOM_ITEM][UHITEM_STR_COUNT];
int uh_itemCustomIsBox[UH_MAX_CUSTOM_ITEM];

// Drop rows: (boxid, itemid, weight, amt, stingOverride, giveActor).
// Unique key = (box, item, giveActor, amt); same key accumulates weight.
int uh_itemDropCount = 0;
int uh_itemDropBoxId[UH_MAX_ITEM_DROPS];
int uh_itemDropItemId[UH_MAX_ITEM_DROPS];
int uh_itemDropWeight[UH_MAX_ITEM_DROPS];
int uh_itemDropAmt[UH_MAX_ITEM_DROPS];
str uh_itemDropSting[UH_MAX_ITEM_DROPS];
str uh_itemDropGive[UH_MAX_ITEM_DROPS];
int uh_itemLastDropRow = -1;

// DLC_Coin threshold spends: identity (minCount, giveActor); same key returns existing row.
// Runtime: highest minCount with coins >= minCount; ties uniform-random among that tier.
int uh_coinSpendCount = 0;
int uh_coinSpendMin[UH_MAX_COIN_SPENDS];
int uh_coinSpendTake[UH_MAX_COIN_SPENDS];
str uh_coinSpendGive[UH_MAX_COIN_SPENDS];
str uh_coinSpendSound[UH_MAX_COIN_SPENDS];

// AssHat generic pending: tid → item actor to give on pickup.
#LIBDEFINE UH_ASSHAT_PENDING_MAX 32
int uh_assHatPendingTid[UH_ASSHAT_PENDING_MAX];
str uh_assHatPendingItem[UH_ASSHAT_PENDING_MAX];
int uh_assHatPendingUsed[UH_ASSHAT_PENDING_MAX];

function int ItemCustomIndex(int id)
{
	return -1 - id;
}

function bool IsItemDefined(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_ITEM)
			return false;
		return uh_itemVanillaDefined[id] != 0;
	}
	if (id <= -1)
	{
		int i = ItemCustomIndex(id);
		if (i < 0 || i >= uh_itemCustomCount)
			return false;
		return true;
	}
	return false;
}

function int ItemResolveSlot(int id)
{
	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_ITEM || uh_itemVanillaDefined[id] == 0)
			return UHITEM_FAIL;
		return id;
	}
	if (id <= -1)
	{
		int i = ItemCustomIndex(id);
		if (i < 0 || i >= uh_itemCustomCount)
			return UHITEM_FAIL;
		return i;
	}
	return UHITEM_FAIL;
}

function str GetItemActor(int id)
{
	int slot = ItemResolveSlot(id);
	if (slot == UHITEM_FAIL)
		return "";
	if (id >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_ACTOR];
	return uh_itemCustomStr[slot][UHITEM_STR_ACTOR];
}

function str GetItemName(int id)
{
	int slot = ItemResolveSlot(id);
	if (slot == UHITEM_FAIL)
		return "";
	if (id >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_NAME];
	return uh_itemCustomStr[slot][UHITEM_STR_NAME];
}

function str GetItemMugshot(int id)
{
	int slot = ItemResolveSlot(id);
	if (slot == UHITEM_FAIL)
		return "";
	if (id >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_MUGSHOT];
	return uh_itemCustomStr[slot][UHITEM_STR_MUGSHOT];
}

function str GetItemSound(int id)
{
	int slot = ItemResolveSlot(id);
	if (slot == UHITEM_FAIL)
		return "";
	if (id >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_SOUND];
	return uh_itemCustomStr[slot][UHITEM_STR_SOUND];
}

function bool IsUnholyBox(int id)
{
	int slot = ItemResolveSlot(id);
	if (slot == UHITEM_FAIL)
		return false;
	if (id >= 0)
		return uh_itemVanillaIsBox[slot] != 0;
	return uh_itemCustomIsBox[slot] != 0;
}

function str GetBoxOpenSound(int boxid)
{
	int slot = ItemResolveSlot(boxid);
	if (slot == UHITEM_FAIL)
		return "";
	if (boxid >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_OPENSOUND];
	return uh_itemCustomStr[slot][UHITEM_STR_OPENSOUND];
}

function str GetBoxEyedropSound(int boxid)
{
	int slot = ItemResolveSlot(boxid);
	if (slot == UHITEM_FAIL)
		return "";
	if (boxid >= 0)
		return uh_itemVanillaStr[slot][UHITEM_STR_EYEDROPSOUND];
	return uh_itemCustomStr[slot][UHITEM_STR_EYEDROPSOUND];
}

function int FindItemByActor(str actor)
{
	int i;
	if (StrCmp(actor, "") == 0)
		return UHITEM_FAIL;
	for (i = 0; i < UH_MAX_VANILLA_ITEM; i++)
	{
		if (uh_itemVanillaDefined[i] != 0 && StrICmp(actor, uh_itemVanillaStr[i][UHITEM_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_itemCustomCount; i++)
	{
		if (StrICmp(actor, uh_itemCustomStr[i][UHITEM_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHITEM_FAIL;
}

function void ItemWriteVanilla(int id, str actor, str name, str mugshot, str sound)
{
	uh_itemVanillaDefined[id] = 1;
	uh_itemVanillaStr[id][UHITEM_STR_ACTOR] = actor;
	uh_itemVanillaStr[id][UHITEM_STR_NAME] = name;
	uh_itemVanillaStr[id][UHITEM_STR_MUGSHOT] = mugshot;
	uh_itemVanillaStr[id][UHITEM_STR_SOUND] = sound;
	uh_itemVanillaStr[id][UHITEM_STR_OPENSOUND] = "";
	uh_itemVanillaStr[id][UHITEM_STR_EYEDROPSOUND] = "";
	uh_itemVanillaIsBox[id] = 0;
}

function int ItemWriteCustom(str actor, str name, str mugshot, str sound)
{
	int i = uh_itemCustomCount;
	int itemid = -1 - i;
	uh_itemCustomStr[i][UHITEM_STR_ACTOR] = actor;
	uh_itemCustomStr[i][UHITEM_STR_NAME] = name;
	uh_itemCustomStr[i][UHITEM_STR_MUGSHOT] = mugshot;
	uh_itemCustomStr[i][UHITEM_STR_SOUND] = sound;
	uh_itemCustomStr[i][UHITEM_STR_OPENSOUND] = "";
	uh_itemCustomStr[i][UHITEM_STR_EYEDROPSOUND] = "";
	uh_itemCustomIsBox[i] = 0;
	uh_itemCustomCount++;
	return itemid;
}

function int SetUnholyBoxCore(int boxid, str openSound, str eyedropSound)
{
	int slot = ItemResolveSlot(boxid);
	if (slot == UHITEM_FAIL)
		return UHITEM_FAIL;
	if (boxid >= 0)
	{
		uh_itemVanillaIsBox[slot] = 1;
		uh_itemVanillaStr[slot][UHITEM_STR_OPENSOUND] = openSound;
		uh_itemVanillaStr[slot][UHITEM_STR_EYEDROPSOUND] = eyedropSound;
	}
	else
	{
		uh_itemCustomIsBox[slot] = 1;
		uh_itemCustomStr[slot][UHITEM_STR_OPENSOUND] = openSound;
		uh_itemCustomStr[slot][UHITEM_STR_EYEDROPSOUND] = eyedropSound;
	}
	return boxid;
}

function int FindItemDropRow(int boxid, int itemid, str giveActor, int amt)
{
	int i;
	for (i = 0; i < uh_itemDropCount; i++)
	{
		if (uh_itemDropBoxId[i] == boxid
			&& uh_itemDropItemId[i] == itemid
			&& uh_itemDropAmt[i] == amt
			&& StrICmp(uh_itemDropGive[i], giveActor) == 0)
			return i;
	}
	return -1;
}

// First row for (box, item) — API helpers / prosperity fallback.
function int FindItemDropRowByItem(int boxid, int itemid)
{
	int i;
	for (i = 0; i < uh_itemDropCount; i++)
	{
		if (uh_itemDropBoxId[i] == boxid && uh_itemDropItemId[i] == itemid)
			return i;
	}
	return -1;
}

// Same (box, item, giveActor, amt) again: accumulate weight. sting kept from first row.
function int AddUnholyItemDropCore(int boxid, int itemid, int weight, int amt, str stingOverride, str giveActor)
{
	int row;
	if (!IsItemDefined(boxid) || !IsItemDefined(itemid))
		return UHITEM_FAIL;
	if (!IsUnholyBox(boxid))
		return UHITEM_FAIL;
	if (weight <= 0)
		return UHITEM_FAIL;
	if (amt < 1)
		amt = 1;

	row = FindItemDropRow(boxid, itemid, giveActor, amt);
	if (row >= 0)
	{
		uh_itemDropWeight[row] += weight;
		return row;
	}
	if (uh_itemDropCount >= UH_MAX_ITEM_DROPS)
		return UHITEM_FAIL;
	row = uh_itemDropCount;
	uh_itemDropBoxId[row] = boxid;
	uh_itemDropItemId[row] = itemid;
	uh_itemDropWeight[row] = weight;
	uh_itemDropAmt[row] = amt;
	uh_itemDropSting[row] = stingOverride;
	uh_itemDropGive[row] = giveActor;
	uh_itemDropCount++;
	return row;
}

function int GetItemDropWeight(int boxid, int itemid)
{
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return 0;
	return uh_itemDropWeight[row];
}

function int GetItemDropAmt(int boxid, int itemid)
{
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return 0;
	return uh_itemDropAmt[row];
}

function str GetItemDropSting(int boxid, int itemid)
{
	int row = FindItemDropRowByItem(boxid, itemid);
	if (row < 0)
		return "";
	return GetItemDropStingByRow(row);
}

// Auto* (not *Silent) runs Use with its own sound — do not also play item loot sting.
function bool ItemDropGiveIsAutoNonSilent(str give)
{
	int n;
	if (StrCmp(give, "") == 0)
		return false;
	n = StrLen(give);
	if (n < 4)
		return false;
	if (StrICmp(StrMid(give, 0, 4), "Auto") != 0)
		return false;
	if (n >= 6 && StrICmp(StrRight(give, 6), "Silent") == 0)
		return false;
	return true;
}

function str GetItemDropStingByRow(int row)
{
	str override;
	int itemid;
	if (row < 0 || row >= uh_itemDropCount)
		return "";
	override = uh_itemDropSting[row];
	if (StrCmp(override, "") != 0)
		return override;
	// Explicit empty override + Auto Use sound → no ACS sting (e.g. Coin → AutoUnholyBook).
	if (ItemDropGiveIsAutoNonSilent(uh_itemDropGive[row]))
		return "";
	itemid = uh_itemDropItemId[row];
	return GetItemSound(itemid);
}

function str GetItemDropGiveActorByRow(int row)
{
	str give;
	int itemid;
	if (row < 0 || row >= uh_itemDropCount)
		return "";
	give = uh_itemDropGive[row];
	if (StrCmp(give, "") != 0)
		return give;
	itemid = uh_itemDropItemId[row];
	return GetItemActor(itemid);
}

function int GetItemDropAmtByRow(int row)
{
	if (row < 0 || row >= uh_itemDropCount)
		return 0;
	return uh_itemDropAmt[row];
}

function int GetItemDropItemIdByRow(int row)
{
	if (row < 0 || row >= uh_itemDropCount)
		return UHITEM_FAIL;
	return uh_itemDropItemId[row];
}

function int ItemBoxWeightSum(int boxid)
{
	int sum = 0;
	int i;
	if (!IsUnholyBox(boxid))
		return 0;
	for (i = 0; i < uh_itemDropCount; i++)
	{
		if (uh_itemDropBoxId[i] == boxid)
			sum += uh_itemDropWeight[i];
	}
	return sum;
}

// Weighted pick; returns drop row index or -1. Sets uh_itemLastDropRow.
function int RandomItemDropRowFromBox(int boxid)
{
	int sum;
	int roll;
	int i;
	uh_itemLastDropRow = -1;
	if (!IsUnholyBox(boxid))
		return -1;
	sum = ItemBoxWeightSum(boxid);
	if (sum <= 0)
		return -1;
	roll = random(1, sum);
	for (i = 0; i < uh_itemDropCount; i++)
	{
		if (uh_itemDropBoxId[i] != boxid)
			continue;
		roll -= uh_itemDropWeight[i];
		if (roll <= 0)
		{
			uh_itemLastDropRow = i;
			return i;
		}
	}
	return -1;
}

// Weighted pick. Returns item id or UHITEM_FAIL. Sets uh_itemLastDropRow.
function int RandomItemFromBox(int boxid)
{
	int row = RandomItemDropRowFromBox(boxid);
	if (row < 0)
		return UHITEM_FAIL;
	return uh_itemDropItemId[row];
}

// Prosperity: roll twice, keep the rarer (lower weight) *row*. Ties keep first.
function int RandomItemFromBoxProsperity(int boxid)
{
	int ra = RandomItemDropRowFromBox(boxid);
	int rb = RandomItemDropRowFromBox(boxid);
	if (ra < 0)
	{
		uh_itemLastDropRow = rb;
		if (rb < 0)
			return UHITEM_FAIL;
		return uh_itemDropItemId[rb];
	}
	if (rb < 0)
	{
		uh_itemLastDropRow = ra;
		return uh_itemDropItemId[ra];
	}
	if (uh_itemDropWeight[rb] < uh_itemDropWeight[ra])
	{
		uh_itemLastDropRow = rb;
		return uh_itemDropItemId[rb];
	}
	uh_itemLastDropRow = ra;
	return uh_itemDropItemId[ra];
}

function int AssHatPendingAlloc(int tid, str itemActor)
{
	int i;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++)
	{
		if (uh_assHatPendingUsed[i] == 0)
		{
			uh_assHatPendingUsed[i] = 1;
			uh_assHatPendingTid[i] = tid;
			uh_assHatPendingItem[i] = itemActor;
			return i;
		}
	}
	return -1;
}

function str AssHatPendingTake(int tid)
{
	int i;
	str item;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++)
	{
		if (uh_assHatPendingUsed[i] != 0 && uh_assHatPendingTid[i] == tid)
		{
			item = uh_assHatPendingItem[i];
			uh_assHatPendingUsed[i] = 0;
			uh_assHatPendingTid[i] = 0;
			uh_assHatPendingItem[i] = "";
			return item;
		}
	}
	return "";
}

function str AssHatPendingPeek(int tid)
{
	int i;
	for (i = 0; i < UH_ASSHAT_PENDING_MAX; i++)
	{
		if (uh_assHatPendingUsed[i] != 0 && uh_assHatPendingTid[i] == tid)
			return uh_assHatPendingItem[i];
	}
	return "";
}

function int FindCoinSpendByKey(int minCount, str giveActor)
{
	int i;
	for (i = 0; i < uh_coinSpendCount; i++)
	{
		if (uh_coinSpendMin[i] == minCount && StrICmp(uh_coinSpendGive[i], giveActor) == 0)
			return i;
	}
	return -1;
}

// takeAmt 0 = take all at use time. Same (minCount, giveActor) returns existing row (no double).
function int DefineUnholyCoinSpendCore(int minCount, int takeAmt, str giveActor, str sound)
{
	int row;
	if (minCount < 1)
		return UHITEM_FAIL;
	if (StrCmp(giveActor, "") == 0)
		return UHITEM_FAIL;
	if (takeAmt < 0)
		takeAmt = 0;

	row = FindCoinSpendByKey(minCount, giveActor);
	if (row >= 0)
		return row;
	if (uh_coinSpendCount >= UH_MAX_COIN_SPENDS)
		return UHITEM_FAIL;

	row = uh_coinSpendCount;
	uh_coinSpendMin[row] = minCount;
	uh_coinSpendTake[row] = takeAmt;
	uh_coinSpendGive[row] = giveActor;
	uh_coinSpendSound[row] = sound;
	uh_coinSpendCount++;
	return row;
}

// Highest eligible minCount; uniform pick among rows at that tier. -1 if none.
function int FindCoinSpendRow(int coins)
{
	int i;
	int bestMin;
	int n;
	int candidates[UH_MAX_COIN_SPENDS];

	bestMin = 0;
	for (i = 0; i < uh_coinSpendCount; i++)
	{
		if (uh_coinSpendMin[i] <= coins && uh_coinSpendMin[i] > bestMin)
			bestMin = uh_coinSpendMin[i];
	}
	if (bestMin < 1)
		return -1;

	n = 0;
	for (i = 0; i < uh_coinSpendCount; i++)
	{
		if (uh_coinSpendMin[i] == bestMin)
		{
			candidates[n] = i;
			n++;
		}
	}
	if (n < 1)
		return -1;
	return candidates[Random(0, n - 1)];
}

// --- DefineCopyWep tables ----------------------------------------------------
// Row: (kind, slot, actor, dmgStem). Mega dmg id = order among mega rows (1..n).
// uh_copyMegaOfficialCount frozen after vanilla so jackpot pool stays stable.

int uh_copyCount = 0;
int uh_copyKind[UH_MAX_COPYWEPS];
int uh_copySlot[UH_MAX_COPYWEPS];
str uh_copyActor[UH_MAX_COPYWEPS];
str uh_copyDmgStem[UH_MAX_COPYWEPS];
int uh_copyMegaId[UH_MAX_COPYWEPS];
int uh_copyMegaCount = 0;
int uh_copyMegaOfficialCount = 0;

function bool CopyWepSlotValid(int kind, int slot)
{
	if (kind == UHCOPY_MEGA)
		return slot >= UHCOPY_SLOT_RANGED && slot <= UHCOPY_SLOT_SHIELD;
	if (kind == UHCOPY_QWANT)
		return slot >= UHCOPY_QWANT_NORMAL && slot <= UHCOPY_QWANT_FAIRY;
	if (kind == UHCOPY_NEGA)
		return slot >= UHCOPY_NEGA_MM1 && slot <= UHCOPY_NEGA_MMWT;
	return false;
}

function str CopyWepMakeDmgStem(str wepActor)
{
	int len = StrLen(wepActor);
	if (len >= 4 && StrCmp(StrRight(wepActor, 4), "WepU") == 0)
		return StrLeft(wepActor, len - 4);
	return wepActor;
}

function int FindCopyWepByKindActor(int kind, str wepActor)
{
	int i;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] == kind && StrICmp(uh_copyActor[i], wepActor) == 0)
			return i;
	}
	return -1;
}

function int DefineCopyWepCore(int kind, int slot, str wepActor)
{
	int row;
	if (kind != UHCOPY_MEGA && kind != UHCOPY_QWANT && kind != UHCOPY_NEGA)
		return UHCOPY_FAIL;
	if (!CopyWepSlotValid(kind, slot))
		return UHCOPY_FAIL;
	if (StrCmp(wepActor, "") == 0)
		return UHCOPY_FAIL;

	row = FindCopyWepByKindActor(kind, wepActor);
	if (row >= 0)
		return row;
	if (uh_copyCount >= UH_MAX_COPYWEPS)
		return UHCOPY_FAIL;

	row = uh_copyCount;
	uh_copyKind[row] = kind;
	uh_copySlot[row] = slot;
	uh_copyActor[row] = wepActor;
	uh_copyDmgStem[row] = CopyWepMakeDmgStem(wepActor);
	uh_copyMegaId[row] = 0;
	if (kind == UHCOPY_MEGA)
	{
		uh_copyMegaCount++;
		uh_copyMegaId[row] = uh_copyMegaCount;
	}
	uh_copyCount++;
	return row;
}

function void FreezeMegaOfficialCopyCount(void)
{
	uh_copyMegaOfficialCount = uh_copyMegaCount;
}

function int GetMegaOfficialCopyCount(void)
{
	return uh_copyMegaOfficialCount;
}

function int CountCopyWepByKind(int kind)
{
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] == kind)
			n++;
	}
	return n;
}

function int CountCopyWepByKindSlot(int kind, int slot)
{
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] == kind && uh_copySlot[i] == slot)
			n++;
	}
	return n;
}

// idx = 0-based among rows with this kind. Returns table row or -1.
function int FindCopyWepRowByKindIndex(int kind, int idx)
{
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] != kind)
			continue;
		if (n == idx)
			return i;
		n++;
	}
	return -1;
}

// idx = 0-based among rows with this kind+slot. Returns table row or -1.
function int FindCopyWepRowByKindSlotIndex(int kind, int slot, int idx)
{
	int i;
	int n;
	n = 0;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] != kind || uh_copySlot[i] != slot)
			continue;
		if (n == idx)
			return i;
		n++;
	}
	return -1;
}

function str GetCopyWepActorByKindIndex(int kind, int idx)
{
	int row = FindCopyWepRowByKindIndex(kind, idx);
	if (row < 0)
		return "";
	return uh_copyActor[row];
}

function str GetCopyWepActorByKindSlotIndex(int kind, int slot, int idx)
{
	int row = FindCopyWepRowByKindSlotIndex(kind, slot, idx);
	if (row < 0)
		return "";
	return uh_copyActor[row];
}

function str GetCopyWepDmgStemByMegaId(int megaId)
{
	int i;
	if (megaId < 1)
		return "";
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] == UHCOPY_MEGA && uh_copyMegaId[i] == megaId)
			return uh_copyDmgStem[i];
	}
	return "";
}

// Case-insensitive prefix (UHDT self-contained for mega stem match).
function bool UH_StrIStartsWithCopy(str s, str prefix)
{
	int plen;
	int i;
	int a;
	int b;
	plen = StrLen(prefix);
	if (plen <= 0 || StrLen(s) < plen)
		return false;
	for (i = 0; i < plen; i++)
	{
		a = GetChar(s, i);
		b = GetChar(prefix, i);
		if (a >= 65 && a <= 90)
			a = a + 32;
		if (b >= 65 && b <= 90)
			b = b + 32;
		if (a != b)
			return false;
	}
	return true;
}

// Longest mega dmgStem prefix match against s. Returns megaId or 0.
function int FindMegaCopyIdByStemPrefix(str s)
{
	int i;
	int bestId;
	int bestLen;
	int nlen;
	str stem;

	bestId = 0;
	bestLen = 0;
	for (i = 0; i < uh_copyCount; i++)
	{
		if (uh_copyKind[i] != UHCOPY_MEGA)
			continue;
		stem = uh_copyDmgStem[i];
		nlen = StrLen(stem);
		if (nlen > bestLen && UH_StrIStartsWithCopy(s, stem))
		{
			bestLen = nlen;
			bestId = uh_copyMegaId[i];
		}
	}
	return bestId;
}

// --- Boss music pool (weighted spawn / enrage BGM) ---------------------------

int uh_bossMusicCount = 0;
int uh_bossMusicBossId[UH_MAX_BOSS_MUSICS];
int uh_bossMusicKind[UH_MAX_BOSS_MUSICS];
int uh_bossMusicPhase[UH_MAX_BOSS_MUSICS];
str uh_bossMusicLump[UH_MAX_BOSS_MUSICS];
str uh_bossMusicCredit[UH_MAX_BOSS_MUSICS];
int uh_bossMusicWeight[UH_MAX_BOSS_MUSICS];
int uh_bossMusicOptional[UH_MAX_BOSS_MUSICS];
int uh_bossMusicDuration[UH_MAX_BOSS_MUSICS];
int uh_bossMusicEmuflag[UH_MAX_BOSS_MUSICS];

function int FindBossMusicRow(int bossId, int kind, int phase, str lump)
{
	int i;
	for (i = 0; i < uh_bossMusicCount; i++)
	{
		if (uh_bossMusicBossId[i] == bossId
			&& uh_bossMusicKind[i] == kind
			&& uh_bossMusicPhase[i] == phase
			&& StrCmp(uh_bossMusicLump[i], lump) == 0)
			return i;
	}
	return -1;
}

function int FindEventMusicRow(int kind, int phase, str lump)
{
	return FindBossMusicRow(UHMUS_GLOBAL, kind, phase, lump);
}

// weight >= 1. optional: non-zero = skip unless uh_sv_OptionalMusic.
// Same (bossId, kind, phase, lump) again updates weight/credit/optional.
function int AddBossMusicCore(int bossId, int kind, int phase, str lump, str credit, int weight, int optional)
{
	int row;
	if (!IsBossDefined(bossId))
		return UHMUS_FAIL;
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return UHMUS_FAIL;
	if (weight < 1)
		return UHMUS_FAIL;
	if (kind != UHMUS_KIND_SPAWN && kind != UHMUS_KIND_ENRAGE)
		return UHMUS_FAIL;
	if (phase < 0)
		return UHMUS_FAIL;

	row = FindBossMusicRow(bossId, kind, phase, lump);
	if (row >= 0)
	{
		uh_bossMusicCredit[row] = credit;
		uh_bossMusicWeight[row] = weight;
		if (optional != 0)
			uh_bossMusicOptional[row] = 1;
		else
			uh_bossMusicOptional[row] = 0;
		return row;
	}
	if (uh_bossMusicCount >= UH_MAX_BOSS_MUSICS)
		return UHMUS_FAIL;

	row = uh_bossMusicCount;
	uh_bossMusicBossId[row] = bossId;
	uh_bossMusicKind[row] = kind;
	uh_bossMusicPhase[row] = phase;
	uh_bossMusicLump[row] = lump;
	uh_bossMusicCredit[row] = credit;
	uh_bossMusicWeight[row] = weight;
	if (optional != 0)
		uh_bossMusicOptional[row] = 1;
	else
		uh_bossMusicOptional[row] = 0;
	uh_bossMusicDuration[row] = 0;
	uh_bossMusicEmuflag[row] = 0;
	uh_bossMusicCount++;
	return row;
}

// Global event pools (winner/loser/LMS). Identity = (kind, phase, lump).
// Winner/Loser: phase 0. LMS: phase = eventid (>=0, no upper bound).
// duration: ACS fixed seconds (-1.0 unknown). emuflag: 1 = MAME (+12 tics).
function int AddEventMusicCore(int kind, int phase, str lump, str credit, int weight, int optional, int duration, int emuflag)
{
	int row;
	int emuf;
	if (kind != UHMUS_KIND_WINNER && kind != UHMUS_KIND_LOSER && kind != UHMUS_KIND_LMS)
		return UHMUS_FAIL;
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return UHMUS_FAIL;
	if (weight < 1)
		return UHMUS_FAIL;
	if (phase < 0)
		return UHMUS_FAIL;

	if (emuflag != 0)
		emuf = 1;
	else
		emuf = 0;

	row = FindEventMusicRow(kind, phase, lump);
	if (row >= 0)
	{
		uh_bossMusicCredit[row] = credit;
		uh_bossMusicWeight[row] = weight;
		if (optional != 0)
			uh_bossMusicOptional[row] = 1;
		else
			uh_bossMusicOptional[row] = 0;
		uh_bossMusicDuration[row] = duration;
		uh_bossMusicEmuflag[row] = emuf;
		return row;
	}
	if (uh_bossMusicCount >= UH_MAX_BOSS_MUSICS)
		return UHMUS_FAIL;

	row = uh_bossMusicCount;
	uh_bossMusicBossId[row] = UHMUS_GLOBAL;
	uh_bossMusicKind[row] = kind;
	uh_bossMusicPhase[row] = phase;
	uh_bossMusicLump[row] = lump;
	uh_bossMusicCredit[row] = credit;
	uh_bossMusicWeight[row] = weight;
	if (optional != 0)
		uh_bossMusicOptional[row] = 1;
	else
		uh_bossMusicOptional[row] = 0;
	uh_bossMusicDuration[row] = duration;
	uh_bossMusicEmuflag[row] = emuf;
	uh_bossMusicCount++;
	return row;
}

// Seed DefineBoss spawn music (weight 1, required). No-op for "" / "*".
function void UH_BossSeedMusic(int bossId, str lump, str credit)
{
	if (StrCmp(lump, "") == 0 || StrCmp(lump, "*") == 0)
		return;
	AddBossMusicCore(bossId, UHMUS_KIND_SPAWN, 0, lump, credit, 1, 0);
}

function str GetBossMusicLumpByRow(int row)
{
	if (row < 0 || row >= uh_bossMusicCount)
		return "";
	return uh_bossMusicLump[row];
}

function str GetBossMusicCreditByRow(int row)
{
	if (row < 0 || row >= uh_bossMusicCount)
		return "";
	return uh_bossMusicCredit[row];
}

function int GetBossMusicDurationByRow(int row)
{
	if (row < 0 || row >= uh_bossMusicCount)
		return 0;
	return uh_bossMusicDuration[row];
}

function int GetBossMusicEmuFlagByRow(int row)
{
	if (row < 0 || row >= uh_bossMusicCount)
		return 0;
	return uh_bossMusicEmuflag[row];
}

// Weighted pick among eligible rows. -1 if none eligible.
function int PickBossMusicRow(int bossId, int kind, int phase)
{
	int i;
	int sum;
	int roll;
	int allowOptional;

	if (!IsBossDefined(bossId))
		return -1;

	allowOptional = GetCVar("uh_sv_OptionalMusic");
	sum = 0;
	for (i = 0; i < uh_bossMusicCount; i++)
	{
		if (uh_bossMusicBossId[i] != bossId)
			continue;
		if (uh_bossMusicKind[i] != kind)
			continue;
		if (uh_bossMusicPhase[i] != phase)
			continue;
		if (uh_bossMusicOptional[i] != 0 && !allowOptional)
			continue;
		sum += uh_bossMusicWeight[i];
	}
	if (sum <= 0)
		return -1;

	roll = random(1, sum);
	for (i = 0; i < uh_bossMusicCount; i++)
	{
		if (uh_bossMusicBossId[i] != bossId)
			continue;
		if (uh_bossMusicKind[i] != kind)
			continue;
		if (uh_bossMusicPhase[i] != phase)
			continue;
		if (uh_bossMusicOptional[i] != 0 && !allowOptional)
			continue;
		roll -= uh_bossMusicWeight[i];
		if (roll <= 0)
			return i;
	}
	return -1;
}

// Global winner/loser/LMS pick. Filters kind + phase + optional. -1 if none.
function int PickEventMusicRow(int kind, int phase)
{
	int i;
	int sum;
	int roll;
	int allowOptional;

	if (kind != UHMUS_KIND_WINNER && kind != UHMUS_KIND_LOSER && kind != UHMUS_KIND_LMS)
		return -1;
	if (phase < 0)
		return -1;

	allowOptional = GetCVar("uh_sv_OptionalMusic");
	sum = 0;
	for (i = 0; i < uh_bossMusicCount; i++)
	{
		if (uh_bossMusicKind[i] != kind)
			continue;
		if (uh_bossMusicPhase[i] != phase)
			continue;
		if (uh_bossMusicOptional[i] != 0 && !allowOptional)
			continue;
		sum += uh_bossMusicWeight[i];
	}
	if (sum <= 0)
		return -1;

	roll = random(1, sum);
	for (i = 0; i < uh_bossMusicCount; i++)
	{
		if (uh_bossMusicKind[i] != kind)
			continue;
		if (uh_bossMusicPhase[i] != phase)
			continue;
		if (uh_bossMusicOptional[i] != 0 && !allowOptional)
			continue;
		roll -= uh_bossMusicWeight[i];
		if (roll <= 0)
			return i;
	}
	return -1;
}

// --- LMS event table (last-survivor events) ----------------------------------
// Ids are always >= 0. Vanilla 0–11; auto (-1) assigns next unused >= 12.
// weight 0 = force/RCON only; weight >= 1 = random pool.

int uh_lmsDefined[UH_MAX_LMS_EVENTS];
str uh_lmsStem[UH_MAX_LMS_EVENTS];
str uh_lmsMessage[UH_MAX_LMS_EVENTS];
str uh_lmsraremessage[UH_MAX_LMS_EVENTS];
str uh_lmsIcon[UH_MAX_LMS_EVENTS];
str uh_lmsrareicon[UH_MAX_LMS_EVENTS];
int uh_lmsFlags[UH_MAX_LMS_EVENTS];
int uh_lmsWeight[UH_MAX_LMS_EVENTS];
int uh_lmsNextCustomId = 12;

int uh_lmsDropCount = 0;
int uh_lmsDropEventId[UH_MAX_LMS_DROPS];
str uh_lmsDropItem[UH_MAX_LMS_DROPS];
int uh_lmsDropAmt[UH_MAX_LMS_DROPS];
int uh_lmsDropRare[UH_MAX_LMS_DROPS];

function bool IsLMSEventDefined(int id)
{
	if (id < 0 || id >= UH_MAX_LMS_EVENTS)
		return false;
	return uh_lmsDefined[id] != 0;
}

function int FindLMSEventByStem(str stem)
{
	int i;
	if (StrCmp(stem, "") == 0)
		return UHLMS_FAIL;
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++)
	{
		if (uh_lmsDefined[i] != 0 && StrICmp(uh_lmsStem[i], stem) == 0)
			return i;
	}
	return UHLMS_FAIL;
}

function int DefineLMSEventCore(int id, str stem, str message, str raremessage, str icon, str rareicon, int flags, int weight)
{
	int other;
	if (StrCmp(stem, "") == 0)
		return UHLMS_FAIL;
	if (weight < 0)
		return UHLMS_FAIL;

	if (id == -1)
	{
		id = uh_lmsNextCustomId;
		while (id < UH_MAX_LMS_EVENTS && uh_lmsDefined[id] != 0)
			id++;
		if (id >= UH_MAX_LMS_EVENTS)
			return UHLMS_FAIL;
		uh_lmsNextCustomId = id + 1;
	}
	else if (id < 0 || id >= UH_MAX_LMS_EVENTS)
		return UHLMS_FAIL;

	other = FindLMSEventByStem(stem);
	if (other != UHLMS_FAIL && other != id)
		return UHLMS_FAIL;

	uh_lmsDefined[id] = 1;
	uh_lmsStem[id] = stem;
	uh_lmsMessage[id] = message;
	uh_lmsraremessage[id] = raremessage;
	uh_lmsIcon[id] = icon;
	uh_lmsrareicon[id] = rareicon;
	uh_lmsFlags[id] = flags;
	uh_lmsWeight[id] = weight;

	if (id >= 12 && id >= uh_lmsNextCustomId)
		uh_lmsNextCustomId = id + 1;

	return id;
}

function int FindLMSEventDropRow(int eventId, str itemActor, int amt, int rare)
{
	int i;
	int rareFlag;
	if (rare != 0)
		rareFlag = 1;
	else
		rareFlag = 0;
	for (i = 0; i < uh_lmsDropCount; i++)
	{
		if (uh_lmsDropEventId[i] == eventId
			&& uh_lmsDropAmt[i] == amt
			&& uh_lmsDropRare[i] == rareFlag
			&& StrICmp(uh_lmsDropItem[i], itemActor) == 0)
			return i;
	}
	return -1;
}

// Same (id, item, amt, rare) again returns existing row (no double grant).
function int AddLMSEventDropCore(int eventId, str itemActor, int amt, int rare)
{
	int row;
	int rareFlag;
	if (!IsLMSEventDefined(eventId))
		return UHLMS_FAIL;
	if (StrCmp(itemActor, "") == 0)
		return UHLMS_FAIL;
	if (amt < 1)
		return UHLMS_FAIL;
	if (rare != 0)
		rareFlag = 1;
	else
		rareFlag = 0;

	row = FindLMSEventDropRow(eventId, itemActor, amt, rareFlag);
	if (row >= 0)
		return row;
	if (uh_lmsDropCount >= UH_MAX_LMS_DROPS)
		return UHLMS_FAIL;

	row = uh_lmsDropCount;
	uh_lmsDropEventId[row] = eventId;
	uh_lmsDropItem[row] = itemActor;
	uh_lmsDropAmt[row] = amt;
	uh_lmsDropRare[row] = rareFlag;
	uh_lmsDropCount++;
	return row;
}

function str GetLMSEventStem(int id)
{
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsStem[id];
}

function str GetLMSEventMessage(int id)
{
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsMessage[id];
}

function str GetLMSEventraremessage(int id)
{
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsraremessage[id];
}

function str GetLMSEventIcon(int id)
{
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsIcon[id];
}

function str GetLMSEventrareicon(int id)
{
	if (!IsLMSEventDefined(id))
		return "";
	return uh_lmsrareicon[id];
}

function int GetLMSEventFlags(int id)
{
	if (!IsLMSEventDefined(id))
		return 0;
	return uh_lmsFlags[id];
}

function int GetLMSEventWeight(int id)
{
	if (!IsLMSEventDefined(id))
		return 0;
	return uh_lmsWeight[id];
}

// Weighted pick among events with weight >= 1. UHLMS_FAIL if none.
function int PickLMSEvent(void)
{
	int i;
	int sum;
	int roll;

	sum = 0;
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++)
	{
		if (uh_lmsDefined[i] == 0)
			continue;
		if (uh_lmsWeight[i] < 1)
			continue;
		sum += uh_lmsWeight[i];
	}
	if (sum <= 0)
		return UHLMS_FAIL;

	roll = random(1, sum);
	for (i = 0; i < UH_MAX_LMS_EVENTS; i++)
	{
		if (uh_lmsDefined[i] == 0)
			continue;
		if (uh_lmsWeight[i] < 1)
			continue;
		roll -= uh_lmsWeight[i];
		if (roll <= 0)
			return i;
	}
	return UHLMS_FAIL;
}

// Grant all drop rows for eventId matching rare flag to actor tid.
function void GrantLMSEventDrops(int tid, int eventId, int rare)
{
	int i;
	int rareFlag;
	if (!IsLMSEventDefined(eventId))
		return;
	if (rare != 0)
		rareFlag = 1;
	else
		rareFlag = 0;
	for (i = 0; i < uh_lmsDropCount; i++)
	{
		if (uh_lmsDropEventId[i] != eventId)
			continue;
		if (uh_lmsDropRare[i] != rareFlag)
			continue;
		GiveActorInventory(tid, uh_lmsDropItem[i], uh_lmsDropAmt[i]);
	}
}

// ============================================================================
// Shiny move-weapon API tables (APPENDED LAST — existing import indices stay
// stable; only UHDT + libs using these new symbols need recompiling).
//
// Model: the shiny weapon's Fire/AltFire dispatch gives+selects a modder-made
// WEAPON actor from these tables; the move weapon plays its own psprite anim,
// then calls uh_ShinyMoveReturn to switch back and remove itself.
// ============================================================================

#LIBDEFINE UH_MAX_SHINYMOVES 128
#LIBDEFINE UH_SHINYNEGA_SLOTBASE 26
#LIBDEFINE UH_SHINYNEGA_SLOTCOUNT 8
#LIBDEFINE UH_SHINYNEGA_SLOTMAX 33
#LIBDEFINE UH_SHINYNEGA_CYCLE_RESET 34
#LIBDEFINE UH_DECOY_SLOTBASE 59
#LIBDEFINE UH_SHINYMEGA_M1 1
#LIBDEFINE UH_SHINYMEGA_M2 2
#LIBDEFINE UH_SHINYMEGA_TRUE 3

// QwantShiny AltFire move pool (vanilla + addon; flat weighted).
int uh_shinyQwantMoveCount = 0;
str uh_shinyQwantMoveWep[UH_MAX_SHINYMOVES];
int uh_shinyQwantMoveWeight[UH_MAX_SHINYMOVES];

// NegaManShiny slots 1..33 (index == slot; [0] unused). Addon API uses 26..33.
// "" = unregistered; dispatcher falls back L2/L3 -> L1.
str uh_shinyNegaSlotWep[UH_SHINYNEGA_CYCLE_RESET][3];

// DecoyBot copy slots (index == slot). Vanilla 0..58 registered first; addon 59+.
int uh_decoyMoveCount = 0;
str uh_decoyMoveWep[UH_MAX_SHINYMOVES];

// Shiny MegaMan flat fire-actor pools (M1 = Fire, M2 = AltFire).
// TRUE registers the same actor into both with the same weight.
int uh_shinyMegaMainCount = 0;
str uh_shinyMegaMainActor[UH_MAX_SHINYMOVES];
int uh_shinyMegaMainWeight[UH_MAX_SHINYMOVES];
int uh_shinyMegaAltCount = 0;
str uh_shinyMegaAltActor[UH_MAX_SHINYMOVES];
int uh_shinyMegaAltWeight[UH_MAX_SHINYMOVES];

// QwantShiny: register a custom AltFire move weapon. weight < 1 becomes 1.
// Same (wepActor) again returns the existing row (no double entry).
function int DefineShinyQwantMoveWepCore(str wepActor, int weight)
{
	int i;
	if (StrCmp(wepActor, "") == 0)
		return UHCOPY_FAIL;
	for (i = 0; i < uh_shinyQwantMoveCount; i++)
	{
		if (StrICmp(uh_shinyQwantMoveWep[i], wepActor) == 0)
			return i;
	}
	if (uh_shinyQwantMoveCount >= UH_MAX_SHINYMOVES)
		return UHCOPY_FAIL;
	uh_shinyQwantMoveWep[uh_shinyQwantMoveCount] = wepActor;
	uh_shinyQwantMoveWeight[uh_shinyQwantMoveCount] = weight < 1 ? 1 : weight;
	uh_shinyQwantMoveCount++;
	return uh_shinyQwantMoveCount - 1;
}

// NegaManShiny: register slot 1..33 with up to three charge-level weapons.
// wepL1 mandatory; empty L2/L3 fall back to L1 at dispatch.
// Re-registering the same slot overwrites it. Addons should use 26..33.
function int DefineShinyNegaSlotWepCore(int slot, str wepL1, str wepL2, str wepL3)
{
	if (slot < 1 || slot > UH_SHINYNEGA_SLOTMAX)
		return UHCOPY_FAIL;
	if (StrCmp(wepL1, "") == 0)
		return UHCOPY_FAIL;
	uh_shinyNegaSlotWep[slot][0] = wepL1;
	uh_shinyNegaSlotWep[slot][1] = wepL2;
	uh_shinyNegaSlotWep[slot][2] = wepL3;
	return slot;
}

// DecoyBot: register a copy slot. Slot is auto-assigned as the next index
// (vanilla 0..58 first, then addon 59+). Same (wepActor) again returns the
// existing slot index.
function int DefineDecoyBotMoveWepCore(str wepActor)
{
	int i;
	if (StrCmp(wepActor, "") == 0)
		return UHCOPY_FAIL;
	for (i = 0; i < uh_decoyMoveCount; i++)
	{
		if (StrICmp(uh_decoyMoveWep[i], wepActor) == 0)
			return i;
	}
	if (uh_decoyMoveCount >= UH_MAX_SHINYMOVES)
		return UHCOPY_FAIL;
	uh_decoyMoveWep[uh_decoyMoveCount] = wepActor;
	uh_decoyMoveCount++;
	return uh_decoyMoveCount - 1;
}

// Shiny MegaMan: register a fire CustomInventory into M1 (Fire), M2 (AltFire),
// or TRUE (both, same weight). Same (actor, pool) again returns existing index.
// which: UH_SHINYMEGA_M1 / M2 / TRUE.
function int DefineShinyMegaCopyWepCore(int which, str fireActor, int weight)
{
	int w;
	int i;
	int last;
	if (StrCmp(fireActor, "") == 0)
		return UHCOPY_FAIL;
	if (which != UH_SHINYMEGA_M1 && which != UH_SHINYMEGA_M2 && which != UH_SHINYMEGA_TRUE)
		return UHCOPY_FAIL;
	w = weight < 1 ? 1 : weight;
	last = -1;

	if (which == UH_SHINYMEGA_M1 || which == UH_SHINYMEGA_TRUE)
	{
		for (i = 0; i < uh_shinyMegaMainCount; i++)
		{
			if (StrICmp(uh_shinyMegaMainActor[i], fireActor) == 0)
			{
				last = i;
				break;
			}
		}
		if (last < 0)
		{
			if (uh_shinyMegaMainCount >= UH_MAX_SHINYMOVES)
				return UHCOPY_FAIL;
			last = uh_shinyMegaMainCount;
			uh_shinyMegaMainActor[last] = fireActor;
			uh_shinyMegaMainWeight[last] = w;
			uh_shinyMegaMainCount++;
		}
	}

	if (which == UH_SHINYMEGA_M2 || which == UH_SHINYMEGA_TRUE)
	{
		for (i = 0; i < uh_shinyMegaAltCount; i++)
		{
			if (StrICmp(uh_shinyMegaAltActor[i], fireActor) == 0)
			{
				last = i;
				break;
			}
		}
		if (i >= uh_shinyMegaAltCount)
		{
			if (uh_shinyMegaAltCount >= UH_MAX_SHINYMOVES)
				return UHCOPY_FAIL;
			last = uh_shinyMegaAltCount;
			uh_shinyMegaAltActor[last] = fireActor;
			uh_shinyMegaAltWeight[last] = w;
			uh_shinyMegaAltCount++;
		}
	}
	return last;
}

// Total DecoyBot copy slot count (vanilla 59 once registered + addon).
function int CountDecoyBotSlots(void)
{
	return uh_decoyMoveCount;
}

// Resolve a NegaManShiny slot charge weapon. lvl: 1..3. Slots 1..33.
function str GetShinyNegaSlotWep(int slot, int lvl)
{
	str wep;
	if (slot < 1 || slot > UH_SHINYNEGA_SLOTMAX)
		return "";
	wep = lvl == 2 ? uh_shinyNegaSlotWep[slot][1]
		: lvl == 3 ? uh_shinyNegaSlotWep[slot][2]
		: uh_shinyNegaSlotWep[slot][0];
	if (StrCmp(wep, "") == 0)
		return uh_shinyNegaSlotWep[slot][0];
	return wep;
}

// Any addon NegaManShiny slot (26..33) registered? (gates full-charge wrap.)
function int HasCustomNegaSlots(void)
{
	int i;
	for (i = UH_SHINYNEGA_SLOTBASE; i <= UH_SHINYNEGA_SLOTMAX; i++)
	{
		if (StrCmp(uh_shinyNegaSlotWep[i][0], "") != 0)
			return 1;
	}
	return 0;
}

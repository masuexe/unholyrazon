// Personal morph line: "You are now {prefix}{name}[ Demoneye]!"
function str GetEyeYouAreNowName(int id) {
	str prefix = GetEyePrefix(id);
	str name = GetEyeName(id);
	if (StrCmp(name, "") == 0)
		return "";
	if (GetEyeFlags(id) & UHEYE_FLAG_NOSUFFIX)
		return StrParam(s:prefix, s:name, s:"\ck");
	return StrParam(s:prefix, s:name, s:" \ckDemoneye");
}

// BHW / parade label: "Plain Demoneye" (no article). NOSUFFIX → name only.
function str GetEyeHudName(int id) {
	str name = GetEyeName(id);
	if (StrCmp(name, "") == 0)
		return "";
	if (GetEyeFlags(id) & UHEYE_FLAG_NOSUFFIX)
		return name;
	return StrParam(s:name, s:" Demoneye");
}

function int FindEyeByActor(str actor) {
	int i;
	if (StrCmp(actor, "") == 0)
		return UHEYE_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_EYE; i++) {
		if (uh_eye_vanilla_defined[i] != 0 && StrICmp(actor, uh_eye_vanilla_str[i][UHEYE_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_eye_custom_count; i++) {
		if (StrICmp(actor, uh_eye_custom_str[i][UHEYE_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHEYE_FAIL;
}

function void EyeWriteVanilla(int id, str actor, str name, str prefix, int flags, str mugshot, str event_stem) {
	uh_eye_vanilla_defined[id] = 1;
	uh_eye_vanilla_str[id][UHEYE_STR_ACTOR] = actor;
	uh_eye_vanilla_str[id][UHEYE_STR_NAME] = name;
	uh_eye_vanilla_str[id][UHEYE_STR_PREFIX] = prefix;
	uh_eye_vanilla_flags[id] = flags;
	uh_eye_vanilla_str[id][UHEYE_STR_MUGSHOT] = mugshot;
	uh_eye_vanilla_str[id][UHEYE_STR_EVENTSTEM] = event_stem;
}

function int EyeWriteCustom(str actor, str name, str prefix, int flags, str mugshot, str event_stem) {

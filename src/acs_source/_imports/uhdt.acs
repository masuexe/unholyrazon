#libdefine UHBOSS_INT_RARITY 0
#libdefine UHBOSS_INT_BASEHP 1
#libdefine UHBOSS_INT_ADDHP 2
#libdefine UHBOSS_INT_EXBASEID 3
#libdefine UHBOSS_INT_COUNT 4

int uh_boss_vanilla_defined[UH_MAX_VANILLA_BOSS];
str uh_boss_vanilla_str[UH_MAX_VANILLA_BOSS][UHBOSS_STR_COUNT];
int uh_boss_vanilla_int[UH_MAX_VANILLA_BOSS][UHBOSS_INT_COUNT];

int uh_boss_custom_count = 0;
str uh_boss_custom_str[UH_MAX_CUSTOM_BOSS][UHBOSS_STR_COUNT];
int uh_boss_custom_int[UH_MAX_CUSTOM_BOSS][UHBOSS_INT_COUNT];

// rarity pool: list of signed bossIds
int uh_boss_pool_count[UHBOSS_POOL_COUNT];
int uh_boss_pool_ids[UHBOSS_POOL_COUNT][UH_MAX_VANILLA_BOSS];

// Per-player signed boss type (Inventory cannot hold negatives)
#libdefine UH_MAX_PLAYERS 64
int uh_player_boss_id[UH_MAX_PLAYERS];

script "uh_BossIdStorageInit" OPEN {
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_player_boss_id[i] = UHBOSS_FAIL;
}

// Joining clients never run non-CLIENTSIDE OPEN; init local uh_playerBossId.
script "uh_BossIdStorageInit_cs" OPEN CLIENTSIDE {
	int i;
	for (i = 0; i < UH_MAX_PLAYERS; i++)
		uh_player_boss_id[i] = UHBOSS_FAIL;
}

function int UH_BossCustomIndex(int id) {
	return -1 - id;
}

function void SetPlayerBossId(int player_num, int boss_id) {
	if (player_num < 0 || player_num >= UH_MAX_PLAYERS)
		return;
	uh_player_boss_id[player_num] = boss_id;
}

function int GetPlayerBossId(int player_num) {
	if (player_num < 0 || player_num >= UH_MAX_PLAYERS)
		return UHBOSS_FAIL;
	return uh_player_boss_id[player_num];
}

function bool IsBossDefined(int id) {
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_BOSS)
			return false;
		return uh_boss_vanilla_defined[id] != 0;
	}
	if (id <= -1) {
		int i = UH_BossCustomIndex(id);
		if (i < 0 || i >= uh_boss_custom_count)
			return false;
		return true;
	}
	return false;
}

function int UH_BossResolveSlot(int id) {
	// Returns storage index for getters; vanilla id == slot, custom uses customIndex.
	// Caller must IsBossDefined first. Returns UHBOSS_FAIL if invalid.
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_BOSS || uh_boss_vanilla_defined[id] == 0)
			return UHBOSS_FAIL;
		return id;
	}
	if (id <= -1) {
		int i = UH_BossCustomIndex(id);
		if (i < 0 || i >= uh_boss_custom_count)
			return UHBOSS_FAIL;
		return i;
	}
	return UHBOSS_FAIL;
}

function str GetBossActor(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_boss_vanilla_str[slot][UHBOSS_STR_ACTOR];
	return uh_boss_custom_str[slot][UHBOSS_STR_ACTOR];
}

function str GetBossName(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return "";
	if (id >= 0)
		return uh_boss_vanilla_str[slot][UHBOSS_STR_NAME];
	return uh_boss_custom_str[slot][UHBOSS_STR_NAME];
}


	if (slot == UHITEM_FAIL)
		return "";
	if (id >= 0)
		return uh_item_vanilla_str[slot][UHITEM_STR_ACTOR];
	return uh_item_custom_str[slot][UHITEM_STR_ACTOR];
}

function str GetItemName(int id) {

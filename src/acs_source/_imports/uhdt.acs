#libdefine UHLMS_PENALTY_USE_DEFAULT 2
#libdefine UHLMS_PENALTY_SURVIVOR 0
#libdefine UHLMS_PENALTY_BOSSES 1
#define UHLMS_PENALTY_DEFINED 65536
#define UHLMS_PENALTY_DEFAULT (UH_MAX_LMS_EVENTS * 2)
#libdefine UHCOPY_FAIL -9999
#libdefine UHMUS_FAIL -9999
#libdefine UHLMS_FAIL -9999
#libdefine UHMUS_GLOBAL -10000
#libdefine UHMUS_KIND_SPAWN 0
#libdefine UHMUS_KIND_ENRAGE 1
#libdefine UHMUS_KIND_WINNER 2
#libdefine UHMUS_KIND_LOSER 3
#libdefine UHMUS_KIND_LMS 4
#libdefine UHMUS_KIND_BONUS 5
#libdefine UHMUS_MAX_WEIGHT 1000000
// New music-row ops. Add* still returns a row or UHMUS_FAIL.
#libdefine UHMUS_OK 0
#libdefine UHMUS_ERR_NOTFOUND 1
#libdefine UHMUS_ERR_CONFLICT 2
#libdefine UHMUS_ERR_REFERENCED 3
#libdefine UHMUS_ERR_CAPACITY 4
#libdefine UHMUS_ERR_BADARG 5

// Shared write results for identity-table CRUD operations.  Existing Define*
// return their established id/failure value; these codes belong to new writes.
#libdefine UHDB_OK 0
#libdefine UHDB_ERR_NOTFOUND 1
#libdefine UHDB_ERR_CONFLICT 2
#libdefine UHDB_ERR_REFERENCED 3
#libdefine UHDB_ERR_CAPACITY 4
#libdefine UHDB_ERR_BADARG 5
#libdefine UHDB_ROW_ACTIVE 1
#libdefine UHDB_ROW_DISABLED 2
#libdefine UHDB_ROW_REMOVED 3
// Packed into uh_bossmusicoptional. UHDT is at the map-variable cap, so
// defined/enabled are bits beside the optional flag rather than new arrays.
#libdefine UHMUS_BIT_OPTIONAL 1
#libdefine UHMUS_BIT_DEFINED 2
#libdefine UHMUS_BIT_ENABLED 4
#libdefine UHLMS_FLAG_DUALRUNE 1
#libdefine UHCOPY_MEGA 1
#libdefine UHCOPY_QWANT 2
#libdefine UHCOPY_NEGA 3
#libdefine UHCOPY_SLOT_RANGED 0
#libdefine UHCOPY_SLOT_RAPID 1
#libdefine UHCOPY_SLOT_CLOSE 2
#libdefine UHCOPY_SLOT_POWER 3
#libdefine UHCOPY_SLOT_AOE 4
#libdefine UHCOPY_SLOT_SHIELD 5
#libdefine UHCOPY_QWANT_NORMAL 0
#libdefine UHCOPY_QWANT_FIRE 1
#libdefine UHCOPY_QWANT_WATER 2
#libdefine UHCOPY_QWANT_ELECTRIC 3
#libdefine UHCOPY_QWANT_GRASS 4
#libdefine UHCOPY_QWANT_ICE 5

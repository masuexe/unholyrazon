	if (slot == UHITEM_FAIL)
		return "";
	if (boxid >= 0)
		return uh_item_vanilla_str[slot][UHITEM_STR_OPENSOUND];
	return uh_item_custom_str[slot][UHITEM_STR_OPENSOUND];

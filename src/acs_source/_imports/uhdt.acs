// UHDT — shared DefineBoss / DefineSurvivor / DefineDemoneye / DefineUnholyItem tables (library "UHDT").
// Handlers and other UH libs #import this file to share state.
//
#library "uhdt"

#include "zcommon.acs"
#import "uhbeset.acs"

// The shared registry now exceeds compact bytecode's 256-function limit.
#nocompact

#libdefine UH_MAX_VANILLA_BOSS 1000
#libdefine UH_MAX_CUSTOM_BOSS 256
#libdefine UH_MAX_VANILLA_SURV 128
#libdefine UH_MAX_CUSTOM_SURV 256
#libdefine UH_MAX_VANILLA_EYE 200
#libdefine UH_MAX_CUSTOM_EYE 256
#libdefine UH_MAX_VANILLA_ITEM 256
#libdefine UH_MAX_CUSTOM_ITEM 256
#libdefine UH_MAX_SURVWEP 256
#libdefine UHBOSS_FAIL -9999
#libdefine UHSURV_FAIL -9999
#libdefine UHSURVWEP_FAIL -9999
#libdefine UHEYE_FAIL -9999
#libdefine UHITEM_FAIL -9999
#libdefine UHEYE_FLAG_NOSUFFIX 1
// UHEYE_FLAG_NOSUFFIX: omit " Demoneye" suffix in YouAreNow (was eyeList "A").

// rarity / pool ids (shared with UHADD)
#libdefine UHBOSS_POOL_NONE 0

}

function bool IsEyeDefined(int id) {
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_EYE)
			return false;
		return uh_eye_vanilla_defined[id] != 0;
	}
	if (id <= -1) {
		int i = EyeCustomIndex(id);
		if (i < 0 || i >= uh_eye_custom_count)
			return false;
		return true;
	}
	return false;
}

function int EyeResolveSlot(int id) {
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_EYE || uh_eye_vanilla_defined[id] == 0)
			return UHEYE_FAIL;
		return id;
	}
	if (id <= -1) {
		int i = EyeCustomIndex(id);
		if (i < 0 || i >= uh_eye_custom_count)
			return UHEYE_FAIL;
		return i;
	}
	return UHEYE_FAIL;
}

function str GetEyeActor(int id) {
	int slot = EyeResolveSlot(id);
	if (slot == UHEYE_FAIL)
		return "";
	if (id >= 0)
		return uh_eye_vanilla_str[slot][UHEYE_STR_ACTOR];
	return uh_eye_custom_str[slot][UHEYE_STR_ACTOR];
}


#libdefine UHCOPY_QWANT_STEEL 16
#libdefine UHCOPY_QWANT_FAIRY 17
#libdefine UHCOPY_NEGA_MM1 1
#libdefine UHCOPY_NEGA_MM2 2
#libdefine UHCOPY_NEGA_MM3 3
#libdefine UHCOPY_NEGA_MM4 4
#libdefine UHCOPY_NEGA_MM5 5
#libdefine UHCOPY_NEGA_MM6 6
#libdefine UHCOPY_NEGA_MM7 7
#libdefine UHCOPY_NEGA_MM8 8
#libdefine UHCOPY_NEGA_MM9 9
#libdefine UHCOPY_NEGA_MM10 10
#libdefine UHCOPY_NEGA_MM11 11
#libdefine UHCOPY_NEGA_MMB 12
#libdefine UHCOPY_NEGA_MMK 13
#libdefine UHCOPY_NEGA_MMV 14
#libdefine UHCOPY_NEGA_MMWT 15
#libdefine UHCOPY_REGEN_SKIP_ENERGY 1

// str fields per boss
#libdefine UHBOSS_STR_ACTOR 0
#libdefine UHBOSS_STR_NAME 1
#libdefine UHBOSS_STR_MUGSHOT 2
#libdefine UHBOSS_STR_INSTRUCTION 3
#libdefine UHBOSS_STR_SPAWNMSGTYPE 4
#libdefine UHBOSS_STR_SPAWNMSG 5
#libdefine UHBOSS_STR_EXBASEACTOR 6
#libdefine UHBOSS_STR_MORPHSETUP 7
#libdefine UHBOSS_STR_RAGEWARNING 8
#libdefine UHBOSS_STR_COUNT 9

// int fields per boss
#libdefine UHBOSS_INT_RARITY 0
#libdefine UHBOSS_INT_BASEHP 1
#libdefine UHBOSS_INT_ADDHP 2
#libdefine UHBOSS_INT_EXBASEID 3
#libdefine UHBOSS_INT_STATE 4
#libdefine UHBOSS_INT_COUNT 5

int uh_bossvanilladefined[UH_MAX_VANILLA_BOSS];
str uh_bossvanillastr[UH_MAX_VANILLA_BOSS][UHBOSS_STR_COUNT];
int uh_bossvanillaint[UH_MAX_VANILLA_BOSS][UHBOSS_INT_COUNT];

int uh_bosscustomcount = 0;
str uh_bosscustomstr[UH_MAX_CUSTOM_BOSS][UHBOSS_STR_COUNT];
int uh_bosscustomint[UH_MAX_CUSTOM_BOSS][UHBOSS_INT_COUNT];

// rarity pool: list of signed bossIds
int uh_boss_pool_count[UHBOSS_POOL_COUNT];
int uh_bosspoolids[UHBOSS_POOL_COUNT][UH_MAX_VANILLA_BOSS];

// Per-player signed boss type (Inventory cannot hold negatives)
#libdefine UH_MAX_PLAYERS 64
int uh_playerbossid[UH_MAX_PLAYERS];

script "uh_BossIdStorageInit" OPEN {
  int i;
  for (i = 0; i < UH_MAX_PLAYERS; i++)
    uh_playerbossid[i] = UHBOSS_FAIL;
}

// Joining clients never run non-CLIENTSIDE OPEN; init local uh_playerBossId.
script "uh_BossIdStorageInit_cs" OPEN CLIENTSIDE {
  int i;
  for (i = 0; i < UH_MAX_PLAYERS; i++)
    uh_playerbossid[i] = UHBOSS_FAIL;
}

function int UH_BossCustomIndex(int id) {
  return -1 - id;
}

function void SetPlayerBossId(int playernum, int bossid) {
  if (playernum < 0 || playernum >= UH_MAX_PLAYERS)
    return;
  uh_playerbossid[playernum] = bossid;
}

function int GetPlayerBossId(int playernum) {
  if (playernum < 0 || playernum >= UH_MAX_PLAYERS)
    return UHBOSS_FAIL;
  return uh_playerbossid[playernum];
}

// --- Boss morph identity / generation ----------------------------------------
// A shadow fakeout can unmorph a boss at any moment, so asynchronous watchers
// and cleanup hooks cannot infer "am I still the boss I was started for" from
// health or actor class.  Every successful morph and every unmorph bumps the
// per-player generation; watchers capture it at start and exit when it no
// longer matches.  This is multiplayer-safe: it never terminates a shared
// named script, it only lets stale instances retire themselves.
int uh_playermorphgen[UH_MAX_PLAYERS];
int uh_playeractiveboss[UH_MAX_PLAYERS];

script "uh_MorphIdStorageInit" OPEN {
  int i;
  for (i = 0; i < UH_MAX_PLAYERS; i++) {
    uh_playermorphgen[i] = 0;
    uh_playeractiveboss[i] = UHBOSS_FAIL;
  }
}

// Joining clients never run non-CLIENTSIDE OPEN; init the local copy as well.
script "uh_MorphIdStorageInit_cs" OPEN CLIENTSIDE {
  int i;
  for (i = 0; i < UH_MAX_PLAYERS; i++) {
    uh_playermorphgen[i] = 0;
    uh_playeractiveboss[i] = UHBOSS_FAIL;
  }
}

function bool PlayerMorphIdValid(int playernum) {
  return playernum >= 0 && playernum < UH_MAX_PLAYERS;
}

// Records a completed morph and returns the generation new watchers must hold.
function int BeginPlayerBossMorph(int playernum, int bossid) {
  if (!PlayerMorphIdValid(playernum))
    return 0;
  uh_playeractiveboss[playernum] = bossid;
  uh_playermorphgen[playernum]++;
  return uh_playermorphgen[playernum];
}

// Invalidates every watcher/cleanup bound to the previous morph generation.
function int EndPlayerBossMorph(int playernum) {
  if (!PlayerMorphIdValid(playernum))
    return 0;
  uh_playeractiveboss[playernum] = UHBOSS_FAIL;
  uh_playermorphgen[playernum]++;
  return uh_playermorphgen[playernum];
}

function int GetPlayerMorphGen(int playernum) {
  if (!PlayerMorphIdValid(playernum))
    return 0;
  return uh_playermorphgen[playernum];
}

function int GetPlayerActiveBossId(int playernum) {
  if (!PlayerMorphIdValid(playernum))
    return UHBOSS_FAIL;
  return uh_playeractiveboss[playernum];
}

function bool IsBossDefined(int id) {
  if (id >= 0) {
    if (id >= UH_MAX_VANILLA_BOSS)
      return false;
    return uh_bossvanilladefined[id] == UHDB_ROW_ACTIVE
      || uh_bossvanilladefined[id] == UHDB_ROW_DISABLED;
  }
  if (id <= -1) {
    int i = UH_BossCustomIndex(id);
    if (i < 0 || i >= uh_bosscustomcount)
      return false;
    return uh_bosscustomint[i][UHBOSS_INT_STATE] == UHDB_ROW_ACTIVE
      || uh_bosscustomint[i][UHBOSS_INT_STATE] == UHDB_ROW_DISABLED;
  }
  return false;
}

function bool IsBossEnabled(int id) {
  if (id >= 0)
    return id < UH_MAX_VANILLA_BOSS && uh_bossvanilladefined[id] == UHDB_ROW_ACTIVE;
  int i = UH_BossCustomIndex(id);
  return i >= 0 && i < uh_bosscustomcount
    && uh_bosscustomint[i][UHBOSS_INT_STATE] == UHDB_ROW_ACTIVE;
}

function int UH_BossResolveSlot(int id) {
  // Returns storage index for getters; vanilla id == slot, custom uses customIndex.
  // Caller must IsBossDefined first. Returns UHBOSS_FAIL if invalid.
  if (id >= 0) {
    if (!IsBossDefined(id))
      return UHBOSS_FAIL;
    return id;
  }
  if (id <= -1) {
    int i = UH_BossCustomIndex(id);
    if (!IsBossDefined(id))
      return UHBOSS_FAIL;
    return i;
  }
  return UHBOSS_FAIL;
}

function str GetBossActor(int id) {
  int slot = UH_BossResolveSlot(id);
  if (slot == UHBOSS_FAIL)
    return "";
  if (id >= 0)
    return uh_bossvanillastr[slot][UHBOSS_STR_ACTOR];
  return uh_bosscustomstr[slot][UHBOSS_STR_ACTOR];
}

function str GetBossName(int id) {

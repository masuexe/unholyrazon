}

function bool SetBossMorphSetup(int id, str setupscript) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return false;
	if (id >= 0)
		uh_boss_vanilla_str[slot][UHBOSS_STR_MORPHSETUP] = setupscript;
	else
		uh_boss_custom_str[slot][UHBOSS_STR_MORPHSETUP] = setupscript;
	return true;
}

function int GetBossRarity(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return UHBOSS_POOL_NONE;
	if (id >= 0)
		return uh_boss_vanilla_int[slot][UHBOSS_INT_RARITY];
	return uh_boss_custom_int[slot][UHBOSS_INT_RARITY];
}

function int GetBossHPBase(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return 0;
	if (id >= 0)
		return uh_boss_vanilla_int[slot][UHBOSS_INT_BASEHP];
	return uh_boss_custom_int[slot][UHBOSS_INT_BASEHP];
}

function int GetBossHPAdd(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return 0;
	if (id >= 0)
		return uh_boss_vanilla_int[slot][UHBOSS_INT_ADDHP];
	return uh_boss_custom_int[slot][UHBOSS_INT_ADDHP];
}

function int GetBossExBaseId(int id) {
	int slot = UH_BossResolveSlot(id);
	if (slot == UHBOSS_FAIL)
		return UHBOSS_FAIL;
	if (id >= 0)
		return uh_boss_vanilla_int[slot][UHBOSS_INT_EXBASEID];
	return uh_boss_custom_int[slot][UHBOSS_INT_EXBASEID];
}

function int FindBossByActor(str actor) {
	int i;
	if (StrCmp(actor, "") == 0)
		return UHBOSS_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++) {
		if (uh_boss_vanilla_defined[i] != 0 && StrICmp(actor, uh_boss_vanilla_str[i][UHBOSS_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_boss_custom_count; i++) {
		if (StrICmp(actor, uh_boss_custom_str[i][UHBOSS_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHBOSS_FAIL;
}

function int UH_BossResolveExBaseId(str exboss_baseactor) {
	if (StrCmp(exboss_baseactor, "") == 0)
		return UHBOSS_FAIL;
	return FindBossByActor(exboss_baseactor);
}

// Parent of an EX boss. UHBOSS_FAIL if not an EX / unknown.
function int GetBossBaseId(int id) {
	int cached = GetBossExBaseId(id);
	if (cached != UHBOSS_FAIL)
		return cached;
	return UH_BossResolveExBaseId(GetBossExBaseActor(id));
}

function bool IsBossEx(int id) {
	return GetBossBaseId(id) != UHBOSS_FAIL;
}

// EX child of a base boss. UHBOSS_FAIL if none registered.
function int GetBossExId(int base_id) {
	int i;
	if (!IsBossDefined(base_id))
		return UHBOSS_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++) {
		if (uh_boss_vanilla_defined[i] != 0 && uh_boss_vanilla_int[i][UHBOSS_INT_EXBASEID] == base_id)
			return i;
	}
	for (i = 0; i < uh_boss_custom_count; i++) {
		if (uh_boss_custom_int[i][UHBOSS_INT_EXBASEID] == base_id)
			return -1 - i;
	}
	// Lazy: match exboss_baseactor string if EXBASEID not filled yet
	str base_actor = GetBossActor(base_id);
	if (StrCmp(base_actor, "") == 0)
		return UHBOSS_FAIL;
	for (i = 0; i < UH_MAX_VANILLA_BOSS; i++) {
		if (uh_boss_vanilla_defined[i] != 0 && StrICmp(uh_boss_vanilla_str[i][UHBOSS_STR_EXBASEACTOR], base_actor) == 0)
			return i;
	}
	for (i = 0; i < uh_boss_custom_count; i++) {
		if (StrICmp(uh_boss_custom_str[i][UHBOSS_STR_EXBASEACTOR], base_actor) == 0)
			return -1 - i;
	}
	return UHBOSS_FAIL;
}

function void UH_BossAppendPool(int rarity, int boss_id) {
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return;
	int n = uh_boss_pool_count[rarity];
	if (n < 0 || n >= UH_MAX_VANILLA_BOSS)
		return;
	uh_boss_pool_ids[rarity][n] = boss_id;
	uh_boss_pool_count[rarity] = n + 1;
}

function int GetBossPoolCount(int rarity) {
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return 0;
	return uh_boss_pool_count[rarity];
}

function int GetBossPoolId(int rarity, int index) {
	if (rarity <= UHBOSS_POOL_NONE || rarity >= UHBOSS_POOL_COUNT)
		return UHBOSS_FAIL;
	if (index < 0 || index >= uh_boss_pool_count[rarity])
		return UHBOSS_FAIL;
	return uh_boss_pool_ids[rarity][index];
}

function int RandomBossFromPool(int rarity) {
	int n = GetBossPoolCount(rarity);
	if (n <= 0)
		return UHBOSS_FAIL;
	return GetBossPoolId(rarity, random(0, n - 1));
}

function void UH_BossWriteVanilla(int id, str actor, str name, int rarity, int basehp, int addhp,
	str exboss_baseactor, str mugshot, str musiclump, str musiccredit,
	str instruction, str spawnmessagetype, str spawnmessage) {
	int base_id;
	uh_boss_vanilla_defined[id] = 1;
	uh_boss_vanilla_str[id][UHBOSS_STR_ACTOR] = actor;
	uh_boss_vanilla_str[id][UHBOSS_STR_NAME] = name;
	uh_boss_vanilla_str[id][UHBOSS_STR_MUGSHOT] = mugshot;
	uh_boss_vanilla_str[id][UHBOSS_STR_MUSIC] = musiclump;
	uh_boss_vanilla_str[id][UHBOSS_STR_MUSICCREDIT] = musiccredit;
	uh_boss_vanilla_str[id][UHBOSS_STR_INSTRUCTION] = instruction;
	uh_boss_vanilla_str[id][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
	uh_boss_vanilla_str[id][UHBOSS_STR_SPAWNMSG] = spawnmessage;
	uh_boss_vanilla_str[id][UHBOSS_STR_EXBASEACTOR] = exboss_baseactor;
	uh_boss_vanilla_str[id][UHBOSS_STR_MORPHSETUP] = "";
	uh_boss_vanilla_int[id][UHBOSS_INT_RARITY] = rarity;
	uh_boss_vanilla_int[id][UHBOSS_INT_BASEHP] = basehp;
	uh_boss_vanilla_int[id][UHBOSS_INT_ADDHP] = addhp;
	base_id = UH_BossResolveExBaseId(exboss_baseactor);
	uh_boss_vanilla_int[id][UHBOSS_INT_EXBASEID] = base_id;
	UH_BossAppendPool(rarity, id);
}

function int UH_BossWriteCustom(str actor, str name, int rarity, int basehp, int addhp,
	str exboss_baseactor, str mugshot, str musiclump, str musiccredit,
	str instruction, str spawnmessagetype, str spawnmessage) {
	int i = uh_boss_custom_count;
	int boss_id = -1 - i;
	int base_id;
	uh_boss_custom_str[i][UHBOSS_STR_ACTOR] = actor;
	uh_boss_custom_str[i][UHBOSS_STR_NAME] = name;
	uh_boss_custom_str[i][UHBOSS_STR_MUGSHOT] = mugshot;
	uh_boss_custom_str[i][UHBOSS_STR_MUSIC] = musiclump;
	uh_boss_custom_str[i][UHBOSS_STR_MUSICCREDIT] = musiccredit;
	uh_boss_custom_str[i][UHBOSS_STR_INSTRUCTION] = instruction;
	uh_boss_custom_str[i][UHBOSS_STR_SPAWNMSGTYPE] = spawnmessagetype;
	uh_boss_custom_str[i][UHBOSS_STR_SPAWNMSG] = spawnmessage;
	uh_boss_custom_str[i][UHBOSS_STR_EXBASEACTOR] = exboss_baseactor;
	uh_boss_custom_str[i][UHBOSS_STR_MORPHSETUP] = "";
	uh_boss_custom_int[i][UHBOSS_INT_RARITY] = rarity;
	uh_boss_custom_int[i][UHBOSS_INT_BASEHP] = basehp;
	uh_boss_custom_int[i][UHBOSS_INT_ADDHP] = addhp;
	base_id = UH_BossResolveExBaseId(exboss_baseactor);
	uh_boss_custom_int[i][UHBOSS_INT_EXBASEID] = base_id;
	uh_boss_custom_count++;
	UH_BossAppendPool(rarity, boss_id);
	return boss_id;
}

// --- DefineSurvivor tables ---------------------------------------------------

#libdefine UHSURV_STR_ACTOR 0
#libdefine UHSURV_STR_NAME 1
#libdefine UHSURV_STR_MUGSHOT 2
#libdefine UHSURV_STR_COUNT 3

int uh_surv_vanilla_defined[UH_MAX_VANILLA_SURV];
str uh_surv_vanilla_str[UH_MAX_VANILLA_SURV][UHSURV_STR_COUNT];

int uh_surv_custom_count = 0;
str uh_surv_custom_str[UH_MAX_CUSTOM_SURV][UHSURV_STR_COUNT];

function int SurvCustomIndex(int id) {
	return -1 - id;
}

function bool IsSurvivorDefined(int id) {
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_SURV)
			return false;
		return uh_surv_vanilla_defined[id] != 0;
	}
	if (id <= -1) {
		int i = SurvCustomIndex(id);
		if (i < 0 || i >= uh_surv_custom_count)
			return false;
		return true;
	}
	return false;
}

function int SurvResolveSlot(int id) {
	if (id >= 0) {
		if (id >= UH_MAX_VANILLA_SURV || uh_surv_vanilla_defined[id] == 0)
			return UHSURV_FAIL;
		return id;
	}
	if (id <= -1) {
		int i = SurvCustomIndex(id);
		if (i < 0 || i >= uh_surv_custom_count)
			return UHSURV_FAIL;
		return i;
	}
	return UHSURV_FAIL;
}

function str GetSurvivorActor(int id) {
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_surv_vanilla_str[slot][UHSURV_STR_ACTOR];
	return uh_surv_custom_str[slot][UHSURV_STR_ACTOR];
}

function str GetSurvivorName(int id) {
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_surv_vanilla_str[slot][UHSURV_STR_NAME];
	return uh_surv_custom_str[slot][UHSURV_STR_NAME];
}

function str GetSurvivorMugshot(int id) {
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	str mug;
	if (id >= 0)
		mug = uh_surv_vanilla_str[slot][UHSURV_STR_MUGSHOT];
	else
		mug = uh_surv_custom_str[slot][UHSURV_STR_MUGSHOT];
	if (StrCmp(mug, "") != 0)
		return mug;
	// Empty mugshot: vanilla KEYCONF id → UMUG_{id}; custom must set explicit.
	if (id >= 0)
		return StrParam(s:"UMUG_", i:id);
	return "";
}

// Stored mugshot only (no UMUG fallback). Empty = use legacy C@ICN / C-ICN paths.
function str GetSurvivorMugshotRaw(int id) {
	int slot = SurvResolveSlot(id);
	if (slot == UHSURV_FAIL)
		return "";
	if (id >= 0)
		return uh_surv_vanilla_str[slot][UHSURV_STR_MUGSHOT];
	return uh_surv_custom_str[slot][UHSURV_STR_MUGSHOT];
}

function str GetSurvivorShinyActor(int id) {
	str actor = GetSurvivorActor(id);
	if (StrCmp(actor, "") == 0)
		return "";
	return StrParam(s:actor, s:"Shiny");
}

function int FindSurvivorByActor(str actor) {
	int i;
	if (StrCmp(actor, "") == 0)
		return UHSURV_FAIL;

	for (i = 0; i < UH_MAX_VANILLA_SURV; i++) {
		if (uh_surv_vanilla_defined[i] != 0 && StrICmp(actor, uh_surv_vanilla_str[i][UHSURV_STR_ACTOR]) == 0)
			return i;
	}
	for (i = 0; i < uh_surv_custom_count; i++) {
		if (StrICmp(actor, uh_surv_custom_str[i][UHSURV_STR_ACTOR]) == 0)
			return -1 - i;
	}
	return UHSURV_FAIL;
}

function void SurvWriteVanilla(int id, str actor, str name, str mugshot) {
	uh_surv_vanilla_defined[id] = 1;
	uh_surv_vanilla_str[id][UHSURV_STR_ACTOR] = actor;
	uh_surv_vanilla_str[id][UHSURV_STR_NAME] = name;
	uh_surv_vanilla_str[id][UHSURV_STR_MUGSHOT] = mugshot;
}

function int SurvWriteCustom(str actor, str name, str mugshot) {
	int i = uh_surv_custom_count;
	int surv_id = -1 - i;
	uh_surv_custom_str[i][UHSURV_STR_ACTOR] = actor;
	uh_surv_custom_str[i][UHSURV_STR_NAME] = name;
	uh_surv_custom_str[i][UHSURV_STR_MUGSHOT] = mugshot;
	uh_surv_custom_count++;
	return surv_id;
}


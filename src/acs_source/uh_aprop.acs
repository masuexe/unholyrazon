#define CAPROP_AirJumpZ 64
#define CAPROP_WallJumpZ 65
script "uh_Add_aproppowers" OPEN
{
	//DefinePowerAprop("JumpJumpPowerGiver", "JumpJumpPower", APROP_JumpZ, 77.7, NO);

	DefinePowerAprop("UH_DisableJumpPowerGiver", "UH_DisableJumpPower", APROP_JumpZ, 0.0, NO);
	DefinePowerAprop("UH_FlipJumpPowerGiver", "UH_FlipJumpPower", APROP_JumpZ, -1.0, NO);
	DefinePowerAprop("UH_Ratio5_6JumpPowerGiver", "UH_Ratio5_6JumpPower", APROP_JumpZ, 5.0/6, NO);//0.83333
	DefinePowerAprop("UH_Ratio8JumpPowerGiver", "UH_Ratio8JumpPower", APROP_JumpZ, 0.8, NO);
	DefinePowerAprop("UH_Ratio7JumpPowerGiver", "UH_Ratio7JumpPower", APROP_JumpZ, 0.7, NO);
	DefinePowerAprop("UH_Ratio1JumpPowerGiver", "UH_Ratio1JumpPower", APROP_JumpZ, 0.1, NO);
	DefinePowerAprop("UH_150_JumpPowerGiver", "UH_150_JumpPower", APROP_JumpZ, 1.50, NO);

//Remove this section if morphes ever work with PowerSpeed
	DefinePowerAprop("Core_PowerSlowGiver", "Core_PowerSlow", APROP_Speed, 0.67, NO);
	DefinePowerAprop("Core_ShockedStopGiver", "Core_ShockedStop", APROP_Speed, 0.0, NO);
	DefinePowerAprop("HalfShockedStopGiver", "HalfShockedStop", APROP_Speed, 0.0, NO);
//Remove this section if morphes ever work with PowerSpeed

	DefinePowerAprop("UH_DisableSpeedPowerGiver", "UH_DisableSpeedPower", APROP_Speed, 0.0, NO);
	DefinePowerAprop("UH_BotFlipSpeedPowerGiver", "UH_BotFlipSpeedPower", APROP_Speed, -1.0, NO);
	DefinePowerAprop("UH_50_SpeedPowerGiver", "UH_50_SpeedPower", APROP_Speed, 0.50, NO);
	DefinePowerAprop("UH_120_SpeedPowerGiver", "UH_120_SpeedPower", APROP_Speed, 1.20, NO);
	DefinePowerAprop("UH_125_SpeedPowerGiver", "UH_125_SpeedPower", APROP_Speed, 1.25, NO);
	DefinePowerAprop("UH_130_SpeedPowerGiver", "UH_130_SpeedPower", APROP_Speed, 1.30, NO);
	DefinePowerAprop("UH_140_SpeedPowerGiver", "UH_140_SpeedPower", APROP_Speed, 1.40, NO);
	DefinePowerAprop("UH_150_SpeedPowerGiver", "UH_150_SpeedPower", APROP_Speed, 1.50, NO);
	DefinePowerAprop("UH_165_SpeedPowerGiver", "UH_165_SpeedPower", APROP_Speed, 1.65, NO);
	DefinePowerAprop("UH_175_SpeedPowerGiver", "UH_175_SpeedPower", APROP_Speed, 1.75, NO);
	DefinePowerAprop("UH_185_SpeedPowerGiver", "UH_185_SpeedPower", APROP_Speed, 1.85, NO);
	DefinePowerAprop("UH_200_SpeedPowerGiver", "UH_200_SpeedPower", APROP_Speed, 2.00, NO);
	DefinePowerAprop("UH_250_SpeedPowerGiver", "UH_250_SpeedPower", APROP_Speed, 2.50, NO);

	DefinePowerAprop("HellbotInvisAlphaGiver", "HellbotInvisAlpha", APROP_Alpha, 0.0, NO);
	DefinePowerAprop("GhostEyeInvisGiver", "GhostEyeInvis", APROP_Alpha, 0.1, NO);
	DefinePowerAprop("GhostEyeShadowInvisGiver", "GhostEyeShadowInvis", APROP_Alpha, 0.1, NO);

	DefinePowerAprop("UH_00_AlphaPowerGiver", "UH_00_AlphaPower", APROP_Alpha, 0.0, NO);
	DefinePowerAprop("UH_10_AlphaPowerGiver", "UH_10_AlphaPower", APROP_Alpha, 1.0/2, NO);
	DefinePowerAprop("UH_20_AlphaPowerGiver", "UH_20_AlphaPower", APROP_Alpha, 2.0/3, NO);
	DefinePowerAprop("UH_30_AlphaPowerGiver", "UH_30_AlphaPower", APROP_Alpha, 3.0/4, NO);
	DefinePowerAprop("UH_40_AlphaPowerGiver", "UH_40_AlphaPower", APROP_Alpha, 4.0/5, NO);
	DefinePowerAprop("UH_50_AlphaPowerGiver", "UH_50_AlphaPower", APROP_Alpha, 5.0/6, NO);
	DefinePowerAprop("UH_60_AlphaPowerGiver", "UH_60_AlphaPower", APROP_Alpha, 6.0/7, NO);
	DefinePowerAprop("UH_70_AlphaPowerGiver", "UH_70_AlphaPower", APROP_Alpha, 7.0/8, NO);
	DefinePowerAprop("UH_80_AlphaPowerGiver", "UH_80_AlphaPower", APROP_Alpha, 8.0/9, NO);
	DefinePowerAprop("UH_90_AlphaPowerGiver", "UH_90_AlphaPower", APROP_Alpha, 9.0/10, NO);

	DefinePowerAprop("GravitymanFlipAirZPowerGiver", "GravitymanFlipAirZPower", CAPROP_AirJumpZ, -1.0, NO);
	DefinePowerAprop("GravitymanFlipWallZPowerGiver", "GravitymanFlipWallZPower", CAPROP_WallJumpZ, -1.0, NO);

	DefinePowerAprop("GravitymanFlipGravPowerGiver", "GravitymanFlipGravPower", APROP_Gravity, -1.0, NO);

	DefinePowerAprop("GravSlammerPowerGiver", "GravSlammerPower", APROP_Gravity, 20.0, NO);

//A shame but morphes use these to properly reset stuff
	DefinePowerAprop("FixMorphJumpZ_Giv", "FixMorphJumpZ_Pow", APROP_JumpZ, 1.0, NO);
	DefinePowerAprop("FixMorphGravity_Giv", "FixMorphGravity_Pow", APROP_Gravity, 1.0, NO);
	DefinePowerAprop("FixMorphAlpha_Giv", "FixMorphAlpha_Pow", APROP_Alpha, 1.0, NO);
	DefinePowerAprop("FixMorphSpeed_Giv", "FixMorphSpeed_Pow", APROP_Speed, 1.0, NO);
	DefinePowerAprop("FixMorphScaleX_Giv", "FixMorphScaleX_Pow", APROP_ScaleX, 1.0, NO);
	DefinePowerAprop("FixMorphScaleY_Giv", "FixMorphScaleY_Pow", APROP_ScaleY, 1.0, NO);
	DefinePowerAprop("FixMorphFriction_Giv", "FixMorphFriction_Pow", APROP_Friction, 1.0, NO);
	DefinePowerAprop("FixMorphAirJumpZ_Giv", "FixMorphAirJumpZ_Pow", CAPROP_AirJumpZ, 1.0, NO);
	DefinePowerAprop("FixMorphWallJumpZ_Giv", "FixMorphWallJumpZ_Pow", CAPROP_WallJumpZ, 1.0, NO);

}

// Player NORADIUSDMG stacker
// Set player to 0 for the activator or specify a player number
script "uh_noradiusdmgplayer" (int player, int toggle) {
	if (player == 0) { player = PlayerNumber() + 1; } 
	if (player <= 0 || !SetActivatorToPlayer(player - 1)) { terminate; }

    if (toggle >= 1) {
        GiveInventory("PlayerPropertyNoRadiusDmg", 1);
        GiveInventory("PlayerPropertyNoRadiusDmgOn", 1);
    } else if (CheckInventory("PlayerPropertyNoRadiusDmg") > 0) {
    	TakeInventory("PlayerPropertyNoRadiusDmg", 1);
    
        if(CheckInventory("PlayerPropertyNoRadiusDmg")==0){
        	GiveInventory("PlayerPropertyNoRadiusDmgOff", 1);
        }
    }
}


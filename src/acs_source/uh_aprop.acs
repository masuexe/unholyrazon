#library "uh_aprop"
#include "zcommon.acs"

#include "dtadd.acs"

// Player HalfPushFlag stacker
// Set player to 0 for the activator or specify a player number
script "uh_halfpushplayer" (int player, int toggle) {
	if (player == 0) { player = PlayerNumber() + 1; } 
	if (player <= 0 || !SetActivatorToPlayer(player - 1)) { terminate; }

	if(toggle >= 1){
		GiveInventory("HalfPushFlag", 1);
	} else if (CheckInventory("HalfPushFlag") > 0) {
		TakeInventory("HalfPushFlag", 1);	
	}
}


//Screen scare script
script "uh_ScreenScare" (int Screen, int HoldTime)
{
	if(GetUserCVar(PlayerNumber(),"U_cl_HideScreenScare")){
		SetHudSize(320,224,0);//Ghost Busters Logo NES/Genesis
		SetFont("U_SCARE0");//U_SCARE1
		HudMessage(s:"A";HUDMSG_FADEINOUT,666,-1,160.4,112.0,HoldTime*0.1,0.15,0.25);
	}
	else{
		SetHudSize(ScaryScreenSize[Screen][0],ScaryScreenSize[Screen][1],0);
		SetFont(StrParam(s:"U_SCAR",i:Screen));
		int TempX = (ScaryScreenSize[Screen][0]/2)<<16;
		int TempY = (ScaryScreenSize[Screen][1]/2)<<16;
		//ScaryScreen[Screen][2], 0.5
		HudMessage(s:"A"; HUDMSG_FADEOUT, 666, CR_UNTRANSLATED, TempX+0.4, TempY, HoldTime*0.1, 0.2);
	}
}

#library "uh_bosses"
#include "zcommon.acs"

script "uhB_countinv_acs" (int Which, int Pointer)
{
	if(Pointer>0){
		SetActivator(0,Pointer);
	}
	int Counter = 0;
	switch(Which)
	{
		Default:
			break;
	}
	SetResultValue(Counter);
}

#define CNTB_SPAWNHEALTH 0
#define CNTB_HEALTHTEMP 1
#define CNTB_TEMP 2
script "uh_CountBossInventory" (int Which) {
    str inv;
    switch(Which)
    {
        default:
            break;
        case CNTB_SPAWNHEALTH:
            inv = "BossSpawnHealthFlag";
            break;
        Case CNTB_HEALTHTEMP:
            inv = "BossHealthTemp_F";
            break;
        Case CNTB_TEMP:
            inv = "BossTemporary_F";
            break;
    }
	SetResultValue(CheckInventory(inv));
}


script "DrawBar_ArchivistS_W" (void) {
	DrawBarColor(8, 4);
	SetHudSize(320, 200, 0);
	str attackimage1, attackimage2;
	int attackflag1 = CheckInventory("S_ArchivistFlag1");
	switch (attackflag1) {
		case 1:
			attackimage1 = "C_I_49Q";
			break;
		case 2:
			attackimage1 = "C_I_49R";
			break;
		case 3:
			attackimage1 = "C_I_49S";
			break;
		case 4:
			attackimage1 = "C_I_49T";
			break;
		case 4:
			attackimage1 = "C_I_49U";
			break;
	}
	int attackflag2 = CheckInventory("S_ArchivistFlag2");
	switch (attackflag2) {
		case 1:
			attackimage2 = "C_I_49V";
			break;
		case 2:
			attackimage2 = "C_I_49W";
			break;
		case 3:
			attackimage2 = "C_I_49X";
			break;
		case 4:
			attackimage2 = "C_I_49Y";
			break;
		case 5:
			attackimage2 = "C_I_49Z";
			break;
	}
	AdjustedImageDisplay(attackimage1, attackimage1, UH_IMAGE_ID_BASE - 96, UH_IMAGE_ID_BASE - 97,  -21.1, 42.1,  59.1, 166.1);
	AdjustedImageDisplay(attackimage2, attackimage2, UH_IMAGE_ID_BASE - 98, UH_IMAGE_ID_BASE - 99,  -2.1, 42.1,  96.1, 166.1);
}




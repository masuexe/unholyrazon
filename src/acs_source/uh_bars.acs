script "DrawBar_VoidWalker_W" (int type) {
  DrawBarColor(202, 61);
  str icon;
  switch (type) {
    default:
    case 0:
      icon = "WNORBANM";
      break;
    case 2:
      icon = "ERORBANM";
      break;
    case 3:
      icon = "WTORBANM";
      break;
    case 4:
      int charge = CheckInventory("WeaponCharge");
      if (GetUserCvar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
        if (charge >= 56) {icon = "FORBANC3";}
        else if (charge >= 28) {icon = "FORBANC2";}
        else if (charge >= 1) {icon = "FORBANC1";}
        else {icon = "FRORBANM";}
      }
      else {
        if (charge >= 1) {icon = "FORBANC2";}
        else {icon = "FRORBANM";}
      }
      break;
  }
  SetHudSize(320, 200, 0);
  AdjustedImageDisplayFlag(icon, icon, UH_IMAGE_ID_BASE - 130, UH_IMAGE_ID_BASE - 131, 16.1, 64.1, 50.1, 184.1, HUDMSG_LAYER_UNDERHUD);
}

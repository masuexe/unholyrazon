  if (GetUserCVar(ConsolePlayerNumber(), "mm8bdm_usechargebars")) {
    int ammo = CheckInventory("AstronautCharging");
    DrawCustomBar(CUST_ASTRONAUT, ammo, 70);
    SetInventory("SBARAmmoOffset", 1);

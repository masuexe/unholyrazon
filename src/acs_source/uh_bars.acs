#library "uh_bars"
#include "zcommon.acs"

#include "dtadd.acs"
#include "barlib.acs"

script "DrawBar_MegamanUS_W" (void) {
    int t = Timer() / 5;
    switch (t % 7) {
        case 0:
            DrawBarColor(174,184);
            break;
        case 1:
            DrawBarColor(219,221);
            break;
        case 2:
            DrawBarColor(228,232);
            break;
        case 3:
            DrawBarColor(106,129);
            break;
        case 4:
            DrawBarColor(204,206);
            break;
        case 5:
            DrawBarColor(197,75);
            break;
        case 6:
            DrawBarColor(239,62);
            break;
    }
}

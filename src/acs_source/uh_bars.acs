// razon3 SBARINFO.VB/HB IsSelected Eden_W: 64_B_BAR (192→110, 198→129),
// 002B overlay TheBibleFlightFlag/180, C_I_64* stats + CMBHQFONT numbers,
// active CI64C* / BobHeadFlag, passive EdenItemSlot1-4. Graphics are C_I_59* / CI59C*.
// Icons: EdenLookup* in UHEDENISAAC (EdenRegisterMain/Alt at OPEN).

function int EdenPassiveSlotAmount(int slotindex) {
  switch (slotindex) {
    case 0: return CheckInventory("EdenItemSlot1");
    case 1: return CheckInventory("EdenItemSlot2");
    case 2: return CheckInventory("EdenItemSlot3");
    case 3: return CheckInventory("EdenItemSlot4");
  }
  return 0;
}

function void DrawEdenPassiveSlots(int baseid) {
  // razon3 SBARINFO fullscreenoffsets: negative x is from the RIGHT edge.
  // HudMessage SetHudSize(320,200): x=0 is left, so -64 → 320-64=256.
  int slotx[4] = {256, 272, 288, 305};
  int i;
  int amt;
  str icon;
  int xhud;

  for (i = 0; i < 4; i++) {
    amt = EdenPassiveSlotAmount(i);
    icon = EdenLookupMainIconByAmount(amt);
    if (!StrCmp(icon, "TNT1A0")) {
      continue;
    }
    // ACS: int+fixed does NOT promote; 256+0.1 → ~0.10 (left). Convert with *1.0.
    xhud = (slotx[i] * 1.0) + 0.1;
    AdjustedImageDisplay(icon, icon,
      baseid - 28 - i * 2, baseid - 29 - i * 2,
      xhud, 106.1,
      xhud, 106.1);
  }
}

function void DrawEdenStatHud(void) {
  SetHudSize(320, 200, 0);
  int baseid = UH_IMAGE_ID_BASE - 130;
  // Stats/active stay with the ammo bar (VB top-left / HB bottom, razon3 +center).
  // Passives: right-side row like razon3 DrawImage -64..-15,106 (fullscreenoffsets).
  AdjustedImageDisplay("C_I_59A", "C_I_59A", baseid, baseid - 1, -18.1, 9.1, 53.1, 155.1);
  AdjustedImageDisplay("C_I_59B", "C_I_59B", baseid - 2, baseid - 3, -18.1, 18.1, 53.1, 163.1);
  AdjustedImageDisplay("C_I_59C", "C_I_59C", baseid - 4, baseid - 5, -18.1, 27.1, 53.1, 171.1);
  AdjustedImageDisplay("C_I_59D", "C_I_59D", baseid - 6, baseid - 7, -18.1, 36.1, 80.1, 155.1);
  AdjustedImageDisplay("C_I_59E", "C_I_59E", baseid - 8, baseid - 9, -18.1, 45.1, 80.1, 163.1);
  AdjustedImageDisplay("C_I_59F", "C_I_59F", baseid - 10, baseid - 11, -18.1, 54.1, 80.1, 171.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenSpeedAttr"),
    baseid - 12, baseid - 13, -9.1, 11.1, 62.1, 156.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenHeightAttr"),
    baseid - 14, baseid - 15, -9.1, 20.1, 62.1, 164.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenTearsHUDAttr"),
    baseid - 16, baseid - 17, -9.1, 29.1, 62.1, 172.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenDamageAttr"),
    baseid - 18, baseid - 19, -9.1, 38.1, 89.1, 156.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenRangeAttr"),
    baseid - 20, baseid - 21, -9.1, 47.1, 89.1, 164.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("EdenShotSpeedAttr"),
    baseid - 22, baseid - 23, -9.1, 56.1, 89.1, 172.1);

  str active = EdenLookupActiveItemIcon();
  if (StrCmp(active, "TNT1A0")) {
    AdjustedImageDisplay(active, active, baseid - 24, baseid - 25, -18.1, 64.1, 40.1, 181.1);
  }

  int bob = CheckInventory("BobHeadFlag");
  if (bob > 0) {
    AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, bob,
      baseid - 26, baseid - 27, 16.1, 72.1, 124.1, 192.1);
  }

  DrawEdenPassiveSlots(baseid);
}


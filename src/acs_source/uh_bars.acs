#define UH_IMAGE_ID_BASE -19730000
#define UH_CRYSTRAP_SPY_HUD_ID UH_IMAGE_ID_BASE - 200
#define UH_CUSTOM_BAR_STRING_ID UH_IMAGE_ID_BASE - 300

#define UH_CUSTOM_BAR_STRING_POS1 0
#define UH_CUSTOM_BAR_STRING_POS2 1
#define UH_CUSTOM_BAR_STRING_POS3 2
#define UH_CUSTOM_BAR_STRING_POSHP 3
#define UH_BAR_STRING_LAYER_STRIDE 16
#define UH_BAR_STRING_LAYER_MAX 16

function void ClearCustomBarStringMessage(int id) {
  HudMessageBold(s:""; HUDMSG_PLAIN, id, CR_UNTRANSLATED, 0.0, 0.0, 0.0);
}

function void DrawCustomBarStringImage(str image, int id, int x, int y, int flags) {
  SetHudClipRect(0, 0, 0, 0, 0);
  SetFont(image);
  HudMessageBold(s:"A"; HUDMSG_PLAIN | flags, id, CR_UNTRANSLATED, x, y, 0.1, 1.0);
}

function void DrawCustomBarStringClipped(str image, int id, int x, int y,
                                         int clipx, int clipy, int clipwidth, int clipheight,
                                         int flags) {
  if (clipwidth <= 0 || clipheight <= 0) {
    ClearCustomBarStringMessage(id);
    return;
  }

  SetHudClipRect(clipx, clipy, clipwidth, clipheight, 0);
  SetFont(image);
  HudMessageBold(s:"A"; HUDMSG_PLAIN | flags, id, CR_UNTRANSLATED, x, y, 0.1, 1.0);
  SetHudClipRect(0, 0, 0, 0, 0);
}

function void DrawCustomBarStringVertical(str full, str empty, int amount, int capacity,
                                          int x, int y, int id, int flags) {
  int fill;
  if (capacity > 0 && amount > 0) {
    if (amount >= capacity)
      fill = 56;
    else
      fill = amount * 56 / capacity;
  }

  int hudx = (x * 1.0) + 0.1;
  int hudy = (y * 1.0) + 0.1;
  DrawCustomBarStringImage(empty, id, hudx, hudy, flags);
  DrawCustomBarStringClipped(full, id - 1, hudx, hudy,
                             x, y + 56 - fill, 8, fill, flags);
}

function void DrawCustomBarStringHorizontal(str full, str empty, int amount, int capacity,
                                            int x, int y, int id, int flags) {
  int fill;
  if (capacity > 0 && amount > 0) {
    if (amount >= capacity)
      fill = 56;
    else
      fill = amount * 56 / capacity;
  }

  int hudx = (x * 1.0) + 0.1;
  int hudy = (y * 1.0) + 0.1;
  DrawCustomBarStringImage(empty, id, hudx, hudy, flags);
  DrawCustomBarStringClipped(full, id - 1, hudx, hudy,
                             x, y, fill, 8, flags);
}

function void DrawCustomBarStringLayerAt(str verticalfull, str verticalempty,
                                         str horizontalfull, str horizontalempty,
                                         int amount, int capacity, int position, int layer) {
  if (layer < 0 || layer >= UH_BAR_STRING_LAYER_MAX) {
    return;
  }

  int verticalx;
  int verticaly = 8;
  int horizontalx;
  int horizontaly;

  switch (position) {
    case UH_CUSTOM_BAR_STRING_POS1:
      verticalx = 16;
      horizontalx = 58;
      horizontaly = 184;
      break;
    case UH_CUSTOM_BAR_STRING_POS2:
      verticalx = 8;
      horizontalx = 58;
      horizontaly = 176;
      break;
    case UH_CUSTOM_BAR_STRING_POS3:
      verticalx = 0;
      horizontalx = 58;
      horizontaly = 168;
      break;
    case UH_CUSTOM_BAR_STRING_POSHP:
      verticalx = 24;
      horizontalx = 130;
      horizontaly = 184;
      break;
    default:
      return;
  }

  SetHudSize(320, 200, 0);
  int id = UH_CUSTOM_BAR_STRING_ID
           - layer * UH_BAR_STRING_LAYER_STRIDE
           - position * 4;
  int mode = AssistDisplayBar_HUDMode();
  if (mode == BAR_DISPLAY_HORI) {
    ClearCustomBarStringMessage(id);
    ClearCustomBarStringMessage(id - 1);
    DrawCustomBarStringHorizontal(horizontalfull, horizontalempty, amount, capacity,
                                  horizontalx, horizontaly, id - 2, 0);
  } else {
    DrawCustomBarStringHorizontal(horizontalfull, horizontalempty, amount, capacity,
                                  horizontalx, horizontaly, id - 2,
                                  HUDMSG_NOTWITHOVERLAYMAP | HUDMSG_NOTWITH3DVIEW);
    if (mode == BAR_DISPLAY_VERT) {
      DrawCustomBarStringVertical(verticalfull, verticalempty, amount, capacity,
                                  verticalx, verticaly, id, HUDMSG_NOTWITHFULLMAP);
    } else {
      ClearCustomBarStringMessage(id);
      ClearCustomBarStringMessage(id - 1);
    }
  }
}

function void DrawCustomBarStringAt(str verticalfull, str verticalempty,
                                    str horizontalfull, str horizontalempty,
                                    int amount, int capacity, int position) {
  DrawCustomBarStringLayerAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                             amount, capacity, position, 0);
}

function void DrawCustomBarStringLayer1(str verticalfull, str verticalempty,
                                        str horizontalfull, str horizontalempty,
                                        int amount, int capacity, int layer) {
  DrawCustomBarStringLayerAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                             amount, capacity, UH_CUSTOM_BAR_STRING_POS1, layer);
}

function void DrawCustomBarStringLayer2(str verticalfull, str verticalempty,
                                        str horizontalfull, str horizontalempty,
                                        int amount, int capacity, int layer) {
  DrawCustomBarStringLayerAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                             amount, capacity, UH_CUSTOM_BAR_STRING_POS2, layer);
}

function void DrawCustomBarStringLayer3(str verticalfull, str verticalempty,
                                        str horizontalfull, str horizontalempty,
                                        int amount, int capacity, int layer) {
  DrawCustomBarStringLayerAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                             amount, capacity, UH_CUSTOM_BAR_STRING_POS3, layer);
}

function void DrawCustomBarStringLayerHP(str verticalfull, str verticalempty,
                                         str horizontalfull, str horizontalempty,
                                         int amount, int capacity, int layer) {
  DrawCustomBarStringLayerAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                             amount, capacity, UH_CUSTOM_BAR_STRING_POSHP, layer);
}

function void DrawCustomBarString1(str verticalfull, str verticalempty,
                                   str horizontalfull, str horizontalempty,
                                   int amount, int capacity) {
  DrawCustomBarStringAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                        amount, capacity, UH_CUSTOM_BAR_STRING_POS1);
}

function void DrawCustomBarString2(str verticalfull, str verticalempty,
                                   str horizontalfull, str horizontalempty,
                                   int amount, int capacity) {
  DrawCustomBarStringAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                        amount, capacity, UH_CUSTOM_BAR_STRING_POS2);
}

function void DrawCustomBarString3(str verticalfull, str verticalempty,
                                   str horizontalfull, str horizontalempty,
                                   int amount, int capacity) {
  DrawCustomBarStringAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                        amount, capacity, UH_CUSTOM_BAR_STRING_POS3);
}

function void DrawCustomBarStringHP(str verticalfull, str verticalempty,
                                    str horizontalfull, str horizontalempty,
                                    int amount, int capacity) {
  DrawCustomBarStringAt(verticalfull, verticalempty, horizontalfull, horizontalempty,
                        amount, capacity, UH_CUSTOM_BAR_STRING_POSHP);
}


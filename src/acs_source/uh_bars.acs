script "DrawBar_Raider_W" (void) {
	int HookNum = CheckInventory("HookshotStamina");
	str HookAmmo = StrRight(StrParam(s:"000",i:HookNum),3);
	SetHudSize(320,200,0);
	if (CheckInventory("RaiderHookRelease_F") > 0) {
		AdjustedImageDisplay("C_I_17NV", "C_I_17NH", UH_IMAGE_ID_BASE, UH_IMAGE_ID_BASE-1, 3.1, 39.1, 107.1, 175.1);
	} else {
		AdjustedImageDisplay("C_I_17CV", "C_I_17CH", UH_IMAGE_ID_BASE, UH_IMAGE_ID_BASE-1, 3.1, 39.1, 107.1, 175.1);

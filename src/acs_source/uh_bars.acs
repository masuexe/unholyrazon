Script "uh_assist_GhostEyeShadowInvis" (int cam) CLIENTSIDE
{
	if(AssistDisplayBar_On()) {
		SetHudSize(320,200,0);
		int pos;
		int x; int y;
		SetActivator(0,AAPTR_NULL);

		if(CheckActorInventory(cam,"GhostShadowInvisFlag")>0) {
			pos = Get_And_Inc_AssistBarCount();
			x = Get_AssistDisplayBar_X(pos);
			y = Get_AssistDisplayBar_Y(pos);

			BasicImageDisplay("GHOSTESI",Get_And_Inc_AssistDisplayID(),x,y);
			int timeSec = CheckActorInventory(cam,"GhostShadowInvisFlag");
			timeSec = timeSec / 35 + (timeSec % 35 > 0);
			DrawBasicBarAndNumber(
				"AS_TV_GI","AS_VR_16",
				"AS_TH_GI","AS_HR_16",
				x,y,
				Get_And_Inc_AssistDisplayID(),Get_And_Inc_AssistDisplayID(),Get_And_Inc_AssistDisplayID(),
				((CheckActorInventory(cam,"GhostShadowInvisFlag") * 8.0 / 1050) + 0.5) >> 16,
				CheckActorInventory(cam,"AssistNumberFlag")>0,
				timeSec
			);
		}
	}
}


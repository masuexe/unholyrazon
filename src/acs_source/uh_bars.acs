Script "uh_assist_YellowWizardReflect" (int cam) CLIENTSIDE {
	if (AssistDisplayBar_On()) {
		SetHudSize(320, 200, 0);
		SetActivator(0, AAPTR_NULL);

		int flag = CheckActorInventory(cam, "YellowWizardReflectFlag");
		if (flag > 0) {
			int pos = Get_And_Inc_AssistBarCount();
			int x = Get_AssistDisplayBar_X(pos);
			int y = Get_AssistDisplayBar_Y(pos);

			BasicImageDisplay("C_A_46B", Get_And_Inc_AssistDisplayID(), x, y);
			int timeSec = flag;
			timeSec = timeSec / 35 + (timeSec % 35 > 0);
			DrawBasicBarAndNumber(
				"ASVS046B", "AS_VR_16",
				"ASHS046B", "AS_HR_16",
				x, y,
				Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(), Get_And_Inc_AssistDisplayID(),
				((flag * 8.0 / 232) + 0.5) >> 16,
				CheckActorInventory(cam, "AssistNumberFlag") > 0,
				timeSec
			);
		}
	}
}


// SiteWorker tetris HUD — NEXT+SAVE as one preview module; ammo bar independent below
// Vert: stacked pair at x=-16 (clear Ammo1). Hori: side-by-side at y≈169 (above bar)
function str SiteWorkerTetGraphic(int piece)
{
	switch (piece) {
		case 1: return "35_I_TET";
		case 2: return "35_J_TET";
		case 3: return "35_L_TET";
		case 4: return "35_O_TET";
		case 5: return "35_S_TET";
		case 6: return "35_T_TET";
		case 7: return "35_Z_TET";
	}
	return "TNT1A0";
}

function void DrawSiteWorkerTetrisHud(void)
{
	int nextPiece = CheckInventory("SiteWorkerTetris_F");
	int savePiece = CheckInventory("SiteWorkerSaved_F");
	str nextPic = SiteWorkerTetGraphic(nextPiece);
	str savePic = SiteWorkerTetGraphic(savePiece);

	SetHudSize(320, 200, 0);
	// Vert: x≈-16 clears Ammo1 at 15; Hori: y≈169 sits above bar/number cluster
	// NEXT
	AdjustedImageDisplay("35_A_TET", "35_A_TET", UH_IMAGE_ID_BASE - 20, UH_IMAGE_ID_BASE - 21, -16.1, 23.1, 68.1, 165.1);
	AdjustedImageDisplay("35_B_TET", "35_B_TET", UH_IMAGE_ID_BASE - 22, UH_IMAGE_ID_BASE - 23, -16.1, 18.1, 68.1, 160.1);
	AdjustedImageDisplay(nextPic, nextPic, UH_IMAGE_ID_BASE - 24, UH_IMAGE_ID_BASE - 25, -16.1, 23.1, 68.1, 165.1);
	// SAVE — vert under NEXT; hori right of NEXT (box≈16px + 4px gutter)
	AdjustedImageDisplay("35_A_TET", "35_A_TET", UH_IMAGE_ID_BASE - 26, UH_IMAGE_ID_BASE - 27, -16.1, 41.1, 88.1, 165.1);
	AdjustedImageDisplay("35_C_TET", "35_C_TET", UH_IMAGE_ID_BASE - 28, UH_IMAGE_ID_BASE - 29, -16.1, 36.1, 88.1, 160.1);
	AdjustedImageDisplay(savePic, savePic, UH_IMAGE_ID_BASE - 30, UH_IMAGE_ID_BASE - 31, -16.1, 41.1, 88.1, 165.1);
}

script "DrawBar_SiteWorker_W" (void) {
	DrawBarColor(4, 220);
	SetOverlayBar(CheckInventory("SiteWorkerRockFlag"), 56);
	DrawSiteWorkerTetrisHud();
}
script "DrawBar_SiteWorkerS_W" (void) {
	DrawBarColor(4, 3);
	SetOverlayBar(CheckInventory("SiteWorkerRockFlag"), 56);
	DrawSiteWorkerTetrisHud();
}


script "DrawBar_MarksmanShiny_W" (void) {
  // Unbound SBARINFO.VB/HB S_Marksman_W: CSI icon + lock count
  DrawBarColor(204, 244);
  SetHudSize(320, 200, 0);
  int baseid = UH_IMAGE_ID_BASE - 40;
  int locks = CheckInventory("MarksmanMissile_F");
  str pip = "CSI_40Z";
  if (locks >= 1) {
    if (CheckInventory("MarksmanLockOn_CD"))
      pip = "CSI_40A4";
    else
      pip = "CSI_40B";
  }
  // DrawImage CSI_* at vert (2,22) / hori (-93+center,-35)
  AdjustedImageDisplay(pip, pip, baseid, baseid - 1,
    1.1, 38.1,
    67.1, 165.1);
  // DrawNumber 2,CMBHPFONT,UH37 fillzeros at (3,37) / (-77+center,-30)
  str lockstr;
  if (locks < 10)
    lockstr = StrParam(s:"0", i:locks);
  else
    lockstr = StrParam(i:locks);
  AdjustedDrawString("CMBHPFONT", "UH37", lockstr, baseid - 2, baseid - 3,
    4.1, 53.1,  // +15
    83.1, 170.1);
}

// Unbound TreasureAmmo HUD (VB/HB): stack icons + counts left of main bar.
// C_I_44* display ~16px; icons shifted left (vert) / numbers raised (hori) so counts stay clear.
function void DrawRedWarriorStackHud(void) {
  SetHudSize(320, 200, 0);
  int baseid = UH_IMAGE_ID_BASE - 50;
  // Vert: icons at x=-8 (was 0); numbers at x=9 (was 8) — clear of 16px icon
  // Hori: icons y=171; numbers y=165 (was same-x / 5px above) — more headroom above icons
  AdjustedImageDisplay("C_I_44A", "C_I_44A", baseid, baseid - 1, -18.1, 9.1, 60.1, 168.1);
  AdjustedImageDisplay("C_I_44B", "C_I_44B", baseid - 2, baseid - 3, -18.1, 18.1, 69.1, 168.1);
  AdjustedImageDisplay("C_I_44C", "C_I_44C", baseid - 4, baseid - 5, -18.1, 27.1, 78.1, 168.1);
  AdjustedImageDisplay("C_I_44D", "C_I_44D", baseid - 6, baseid - 7, -18.1, 36.1, 87.1, 168.1);
  AdjustedImageDisplay("C_I_44E", "C_I_44E", baseid - 8, baseid - 9, -18.1, 45.1, 96.1, 168.1);
  AdjustedImageDisplay("C_I_44F", "C_I_44F", baseid - 10, baseid - 11, -18.1, 54.1, 105.1, 168.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack1"),
    baseid - 12, baseid - 13, -9.1, 11.1, 64.0, 162.1);  // +6
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack2"),
    baseid - 14, baseid - 15, -9.1, 21.1, 73.0, 162.1);  // +9
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack3"),
    baseid - 16, baseid - 17, -9.1, 29.1, 82.0, 162.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack4"),
    baseid - 18, baseid - 19, -9.1, 38.1, 91.0, 162.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack5"),
    baseid - 20, baseid - 21, -9.1, 47.1, 100.0, 162.1);
  AdjustedDrawNumberC("CMBHQFONT", CR_UNTRANSLATED, CheckInventory("WarriorStack6"),
    baseid - 22, baseid - 23, -9.1, 56.1, 109.0, 162.1);
}


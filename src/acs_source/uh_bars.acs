#define U_MARKMANSLOCK_LIMIT 7
script "DrawBar_Marksman_W" (void) {
	DrawBarColor(211, 231);
	DrawCustomBar(CUST_MARKSMAN, CheckInventory("MarksmanMissile_F"), U_MARKMANSLOCK_LIMIT);
	SetInventory("SBARAmmoOffset", 2);
	DrawSecondAmmo();

// Guard HP bar: product of registered PowerProtection Normal factors.
// ACS cannot read DamageFactors — register via DefineUnholyGuardFactor.
// Exclude runes (PowerHalfDamageRune has its own HUD icon).
#define UH_GUARD_FACTOR_MAX 32
#define UHGUARD_FAIL -9999
int uh_guardfactorcount = 0;
str uh_guardfactorclass[UH_GUARD_FACTOR_MAX];
int uh_guardfactorvalue[UH_GUARD_FACTOR_MAX];

function int UH_AddGuardFactor(str actor, int factor) {
  if (StrLen(actor) < 1) {
    return UHGUARD_FAIL;
  }
  int i;
  for (i = 0; i < uh_guardfactorcount; i++) {
    if (!StrICmp(uh_guardfactorclass[i], actor)) {
      uh_guardfactorvalue[i] = factor;
      return i;
    }
  }
  if (uh_guardfactorcount >= UH_GUARD_FACTOR_MAX) {
    return UHGUARD_FAIL;
  }
  i = uh_guardfactorcount;
  uh_guardfactorclass[i] = actor;
  uh_guardfactorvalue[i] = factor;
  uh_guardfactorcount++;
  return i;
}

function int UH_GuardNormalProduct(void) {
  int prod = 1.0;
  int i;
  for (i = 0; i < uh_guardfactorcount; i++) {
    if (CheckInventory(uh_guardfactorclass[i])) {
      prod = FixedMul(prod, uh_guardfactorvalue[i]);
    }
  }
  return prod;
}

function void RegisterVanillaGuardFactors(void) {
  UH_AddGuardFactor("PowerSMTankNerf", 2.0);
  UH_AddGuardFactor("UrineBottleDamage", 2.0);
  UH_AddGuardFactor("CalmMind_PowerProtection", 0.8);
  UH_AddGuardFactor("PowerFakeTruePower2", 0.8);
  UH_AddGuardFactor("PowerMujicaColor2", 0.75);
  UH_AddGuardFactor("Neru_DamageReduction", 0.70);
  UH_AddGuardFactor("MorshuArmorPower", 0.15);
  UH_AddGuardFactor("PowerEvilArmor", 0.25);
  UH_AddGuardFactor("HellishArmor", 0.05);
}

script "uh_DefineUnholyGuardFactor_S" (void) {
  SetResultValue(UH_AddGuardFactor(GetCVarString("uh_gf_actor"), GetCVar("uh_gf_factor")));
}

script "uh_define_vanilla_guard_cs" OPEN CLIENTSIDE {
  RegisterVanillaGuardFactors();
}


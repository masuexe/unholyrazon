function int QwantTypeCustSlot(int type) {
  return CUST_QWANT_NORMAL + type;
}

function int QwantTypeAmmoMax(int type) {
  if (type == QWANT_TYPE_PSYCHIC || type == QWANT_TYPE_DRAGON || type == QWANT_TYPE_FAIRY) {
    return 56;
  }
  return 28;
}

function str BuildQwantTagKey(str wep) {
  int len = StrLen(wep);
  if (len >= 3 && !StrCmp(StrRight(wep, 3), "Wep")) {
    wep = StrLeft(wep, len - 3);
  }
  return StrParam(s:"TAG_", s:wep);
}


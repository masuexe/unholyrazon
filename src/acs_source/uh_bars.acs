function str UH_MugshotIndexName(str prefix, int amount)
{
	// SBARMugshot* stores palette+1; texture names are 000-255
	int idx = amount - 1;
	if (idx < 0) { idx = 0; }
	if (idx > 255) { idx = 255; }
	return StrParam(s:prefix, s:StrRight(StrParam(s:"000", i:idx), 3));
}

function void DrawUHClassMugshot(int cam)
{
	if (!CheckActorInventory(cam, "MugshotFlag")) { return; }
	// Boss/Demoneye morph: keep Player.ScoreIcon (SBARINFO playericon) visible
	if (CheckActorInventory(cam, "MorphedFlag")) { return; }

	int mode = AssistDisplayBar_HUDMode();
	int x, y;
	if (mode == BAR_DISPLAY_HORI) {
		x = 186.1;
		y = 184.1;
	} else if (mode == BAR_DISPLAY_VERT) {
		x = 20.1;
		y = 0.1;
	} else {
		return;
	}

	SetHudSize(320, 200, 0);

	// Dust Crusher skin: static YustMan face over MegaMan mugshot slot
	if (CheckActorInventory(cam, "YustManFlag")) {
		BasicImageDisplay("YUSTMUG", UH_IMAGE_ID_BASE + 61, x, y);
		return;
	}

	// Qwant: mugshot follows weapon dye (192/198) synced by uh_SyncMugFromWeaponDye — not QwantBar args
	if (CheckActorInventory(cam, "UHMugshotQwant")) {
		int wc = CheckActorInventory(cam, "UHWepMugCyan");
		int wb = CheckActorInventory(cam, "UHWepMugBlue");
		if (wc >= 1 && wb >= 1) {
			SetMugshotColor(wc - 1, wb - 1);
		}
	}

	// Arcanist: crown PD — cyan=lightest, blue=mid, black=darkest (override DrawBar 250/253)
	if (CheckActorInventory(cam, "UHMugshotArcanist")) {
		int ac = CheckActorInventory(cam, "UHWepMugCyan");
		int ab = CheckActorInventory(cam, "UHWepMugBlue");
		int ak = CheckActorInventory(cam, "UHWepMugBlack");
		if (ac >= 1 && ab >= 1 && ak >= 1) {
			SetMugshotColorGlow(ac - 1, ab - 1, ak - 1);
		} else {
			SetMugshotColorGlow(57, 60, 79);
		}
	}

	int cyan = CheckActorInventory(cam, "SBARMugshotCyan");
	int blue = CheckActorInventory(cam, "SBARMugshotBlue");
	int black = CheckActorInventory(cam, "SBARMugshotBlack");
	int trans = CheckActorInventory(cam, "MugshotTransFlag");
	str nBlu = "";
	str nBlk = "";
	str nCyn = "";

	// HudMessage: lower IDs draw on top. BACK must use the highest ID so color layers stay visible.
	if (CheckActorInventory(cam, "UHMugshotMegaMan")) {
		if (trans) {
			nBlu = UH_MugshotIndexName("MGBLU", blue);
			nBlk = UH_MugshotIndexName("MGBLK", black);
			nCyn = UH_MugshotIndexName("MGCYN", cyan);
		} else {
			nBlu = "MGBLU198";
			nBlk = "MGBLK000";
			nCyn = "MGCYN192";
		}
		BasicImageDisplay("MEGABCK", UH_IMAGE_ID_BASE + 73, x, y);
		BasicImageDisplay(nBlu, UH_IMAGE_ID_BASE + 72, x, y);
		BasicImageDisplay(nBlk, UH_IMAGE_ID_BASE + 71, x, y);
		BasicImageDisplay(nCyn, UH_IMAGE_ID_BASE + 70, x, y);
	} else if (CheckActorInventory(cam, "UHMugshotQwant")) {
		if (trans) {
			nBlu = UH_MugshotIndexName("QWBLU", blue);
			nCyn = UH_MugshotIndexName("QWCYN", cyan);
		} else {
			// Fallback when dye sync / bar has not set mugshot (not QWANT_DYE 138/130)
			nBlu = "QWBLU130";
			nCyn = "QWCYN110";
		}
		BasicImageDisplay("QWNTBCK", UH_IMAGE_ID_BASE + 73, x, y);
		BasicImageDisplay(nBlu, UH_IMAGE_ID_BASE + 72, x, y);
		BasicImageDisplay(nCyn, UH_IMAGE_ID_BASE + 70, x, y);
	} else if (CheckActorInventory(cam, "UHMugshotNegaMan")) {
		if (trans) {
			nCyn = UH_MugshotIndexName("NGPUR", cyan);
		} else {
			// NegaMan_W / NEGAMAN_DYE purple (253→95)
			nCyn = "NGPUR095";
		}
		BasicImageDisplay("NEGABCK", UH_IMAGE_ID_BASE + 73, x, y);
		BasicImageDisplay(nCyn, UH_IMAGE_ID_BASE + 70, x, y);
	} else if (CheckActorInventory(cam, "UHMugshotArcanist")) {
		if (trans) {
			// ARPD1=cyan(lightest), ARPD2=blue, ARPD3=black(darkest)
			nCyn = UH_MugshotIndexName("ARPD1", black);
			nBlu = UH_MugshotIndexName("ARPD2", blue);
			nBlk = UH_MugshotIndexName("ARPD3", cyan);
		} else {
			nCyn = "ARPD1057";
			nBlu = "ARPD2060";
			nBlk = "ARPD3079";
		}
		BasicImageDisplay("ARCABCK", UH_IMAGE_ID_BASE + 73, x, y);
		BasicImageDisplay(nBlu, UH_IMAGE_ID_BASE + 72, x, y);
		BasicImageDisplay(nBlk, UH_IMAGE_ID_BASE + 71, x, y);
		BasicImageDisplay(nCyn, UH_IMAGE_ID_BASE + 70, x, y);
	}
}

Script "uh_assist_General" (int cam) CLIENTSIDE
{
	SetActivator(cam);
	//SetActivator(0,AAPTR_NULL);
	func_UH_BarFlags();
	SetHudSize(320,200,0);
	// AdjustedImageDisplayFlag("EMPTICON", "EMPTICON", UH_IMAGE_ID_BASE+100, UH_IMAGE_ID_BASE+101, 24.1, 64.1, 122.1, 184.1, HUDMSG_LAYER_UNDERHUD);
	// Extra Life
	if (CheckActorInventory(cam, "PlayerPropertyExtraLife")) {
		AdjustedImageDisplayFlag("ARCBUD0X", "ARCBUD0X", UH_IMAGE_ID_BASE+100, UH_IMAGE_ID_BASE+101, 40.1, 22.1, 160.1, 169.1, HUDMSG_LAYER_UNDERHUD);
		AdjustedDrawNumber("CMBHPFONT", "Green",
                       CheckActorInventory(cam, "PlayerPropertyExtraLife"),
                       UH_IMAGE_ID_BASE+102, UH_IMAGE_ID_BASE+103,
                       47.1, 22.1,
                       172.1, 169.1);
	}
	// Pharaoh 4MI Curse
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Reverse")) {
		AdjustedImageDisplayFlag("CURSA0", "CURSA0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Hopping")) {
		AdjustedImageDisplayFlag("CURSB0", "CURSB0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Fidget")) {
		AdjustedImageDisplayFlag("CURSC0", "CURSC0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Darkness")) {
		AdjustedImageDisplayFlag("CURSD0", "CURSD0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Unknown")) {
		AdjustedImageDisplayFlag("CURSE0", "CURSE0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}
	if (CheckActorInventory(cam, "Pharaoh4MICurse_Roulette")) {
		AdjustedImageDisplayFlag("CURSF0", "CURSF0", UH_IMAGE_ID_BASE+104, UH_IMAGE_ID_BASE+105, 31.1, 57.1, 125.1, 177.1, HUDMSG_LAYER_UNDERHUD);
	}

	// Class mugshots follow MugshotFlag (not AssistDisplayBar_On)
	DrawUHClassMugshot(cam);

	if(AssistDisplayBar_On()) {

		if(CheckActorInventory(cam,"PowerDoubleDamageRune"))		{BasicImageDisplay("strr[0",UH_IMAGE_ID_BASE+50,40.1,1.1);}
		if(CheckActorInventory(cam,"PowerDoubleFiringSpeedRune"))	{BasicImageDisplay("ragr[0",UH_IMAGE_ID_BASE+51,47.1,1.1);}//52
		if(CheckActorInventory(cam,"PowerDrainRune"))				{BasicImageDisplay("drar[0",UH_IMAGE_ID_BASE+52,57.1,1.1);}//69
		if(CheckActorInventory(cam,"PowerSpreadRune"))				{BasicImageDisplay("sprr[0",UH_IMAGE_ID_BASE+53,68.1,1.1);}//86
		if(CheckActorInventory(cam,"PowerHalfDamageRune"))			{BasicImageDisplay("resr[0",UH_IMAGE_ID_BASE+54,82.1,1.1);}//94
		if(CheckActorInventory(cam,"PowerRegenerationRune"))		{BasicImageDisplay("regr[0",UH_IMAGE_ID_BASE+55,90.1,1.1);}//104
		if(CheckActorInventory(cam,"PowerProsperityRune"))			{BasicImageDisplay("prsr[0",UH_IMAGE_ID_BASE+56,100.1,1.1);}//120
		if(CheckActorInventory(cam,"PowerReflectionRune"))			{BasicImageDisplay("refr[0",UH_IMAGE_ID_BASE+57,108.1,1.1);}//131
		if(CheckActorInventory(cam,"PowerHighJumpRune"))			{BasicImageDisplay("hijr[0",UH_IMAGE_ID_BASE+58,124.1,1.1);}//140
		if(CheckActorInventory(cam,"PowerSpeed25Rune"))				{BasicImageDisplay("hasr[0",UH_IMAGE_ID_BASE+59,141.1,1.1);}//155
		if(CheckActorInventory(cam,"PowerEndlessAmmoRune"))			{BasicImageDisplay("eamr[0",UH_IMAGE_ID_BASE+60,157.1,1.1);}//161

		if(CheckActorInventory(cam,"PowerTreeHuggerFlag"))			{BasicImageDisplay("TREEHEAL",UH_IMAGE_ID_BASE+63,174.1,2.1);}
	}
}

function void func_UH_BarFlags(void) {
	if(CheckInventory("PlayerPropertyInvulnerable") || (CheckInventory("PlayerPropertyNonshootable") && CheckInventory("PlayerPropertyNoRadiusDmg"))){
		DrawCustomBar(CUST_INVUN_BAR, GetActorHealth(0), GetActorMaxHealth(0));
	}
	else if(CheckInventory("GuardUpFlag")){
		DrawCustomBar(CUST_GUARDUP_BAR, GetActorHealth(0), GetActorMaxHealth(0));
	}
	else if(CheckInventory("GuardDownFlag")){
		DrawCustomBar(CUST_GUARDDOWN_BAR, GetActorHealth(0), GetActorMaxHealth(0));
	}
	else if(CheckInventory("SUDDENLYONFIRE")){
		DrawCustomBar(CUST_ONFIRE_BAR, GetActorHealth(0), GetActorMaxHealth(0));
	}
}

script "DrawBar_ReloadIcon" (void) {
	int u = UniqueTID();
	str wep = GetWeapon();
	if (SpawnForced(StrParam(s:wep, s:"_ReloadIcon"), 0, 0, 0, u, 0)) {
		str tag = GetActorProperty(u, APROP_Nametag);
		Thing_Remove(u);
		if (StrLen(tag) > 0 && GetChar(tag, 0) != 36) {
			DrawReloadIcon(tag);
		}
	}
}

script "DrawBar_MegamanUS_W" (void) {
    int t = Timer() / 5;
    switch (t % 7) {
        case 0:
            DrawBarColor(174,184);
            break;
        case 1:
            DrawBarColor(219,221);
            break;
        case 2:
            DrawBarColor(228,232);
            break;
        case 3:
            DrawBarColor(106,129);
            break;
        case 4:
            DrawBarColor(204,206);
            break;
        case 5:
            DrawBarColor(197,75);
            break;
        case 6:
            DrawBarColor(239,62);
            break;
    }
}


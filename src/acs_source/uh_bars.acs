	AdjustedDrawStringU("CMBHRFONT", 6+(HookNum>=200)*2, HookAmmo, UH_IMAGE_ID_BASE-2, UH_IMAGE_ID_BASE-3, 2.1, 56.1, 95.1, 177.1);
}


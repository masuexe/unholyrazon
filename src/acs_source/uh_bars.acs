	pkmnf7_width[117] = 6; // u
	pkmnf7_width[118] = 6; // v
	pkmnf7_width[119] = 8; // w
	pkmnf7_width[120] = 8; // x
	pkmnf7_width[121] = 6; // y
	pkmnf7_width[122] = 7; // z
}

function int FontCharWidth(int ch)
{
	int w = 0;
	if (ch >= 0 && ch < 128) {
		w = pkmnf7_width[ch];
	}
	if (w <= 0) {
		w = 6;
	}
	return w;
}

function int FontStringWidth(str text)
{
	int total = 0;
	int n = StrLen(text);
	int i = 0;
	for (; i < n; i++) {
		total += FontCharWidth(GetChar(text, i));
	}
	return total;
}

function int TextBoxWidth(str text)
{
	int w = FontStringWidth(text) + PKMNF7_BOX_PAD;
	if (w < PKMNF7_BOX_MIN) {
		w = PKMNF7_BOX_MIN;
	}
	if (w > PKMNF7_BOX_MAX) {
		w = PKMNF7_BOX_MAX;
	}
	return w;
}

function str PkmovName(int width)
{
	return StrParam(s:"PKMOV_", i:width);
}

// Draws PKMOV box + text with Gold/Silver 3px left/right inset inside the frame.
function void DrawTextInPkmovBox(str text, str fontName, str colorName,
	int boxId, int boxId2, int textId, int textId2,
	int boxX1, int boxY1, int boxX2, int boxY2)
{
	// *1.0 keeps HudMessage alignment bits (.1 left) when adding pixel offsets.
	str box = PkmovName(TextBoxWidth(text));
	AdjustedImageDisplay(box, box, boxId, boxId2, boxX1, boxY1, boxX2, boxY2);
	AdjustedDrawString(fontName, colorName, text, textId, textId2,
		boxX1 + PKMNF7_TEXT_X_OFF * 1.0, boxY1 + PKMNF7_TEXT_Y_OFF * 1.0,
		boxX2 + PKMNF7_TEXT_X_OFF * 1.0, boxY2 + PKMNF7_TEXT_Y_OFF * 1.0);
}

str uh_qwant_fill_wep = "";
str uh_qwant_fill_ammo = "";
int uh_qwant_fill_max = 0;

// Resolve fill ammo: type table by default; if QwantBar args[1] > 0, Tag is ammo classname.
function void ResolveQwantFillAmmo(str wep, int type)
{
	if (uh_qwant_fill_wep == wep && StrLen(uh_qwant_fill_ammo) > 0) {
		return;
	}
	uh_qwant_fill_wep = wep;
	uh_qwant_fill_ammo = qwant_type_ammo[type];
	uh_qwant_fill_max = QwantTypeAmmoMax(type);

	int u = UniqueTID();
	if (SpawnForced(StrParam(s:wep, s:"_QwantBar"), 0, 0, 0, u, 0)) {
		int customMax = ACS_NamedExecuteWithResult("core_GetActorArg", u, 1);
		if (customMax > 0) {
			str tag = GetActorProperty(u, APROP_Nametag);
			// Only treat Tag as fill ammo when it is a real Ammo class (cap > 0).
			// Unset Tag returns the actor classname via APROP_Nametag — must not use that.
			int tagCap = 0;
			if (StrLen(tag) > 0 && GetChar(tag, 0) != 36) {
				tagCap = GetAmmoCapacity(tag);
			}
			if (tagCap > 0) {
				uh_qwant_fill_ammo = tag;
				uh_qwant_fill_max = tagCap;
			}
		}
		Thing_Remove(u);
	}
}

script "DrawBar_QwantMove" (int type)
{
	if (type < 0) {
		type = 0;
	}
	if (type >= QWANT_TYPE_COUNT) {
		type = QWANT_TYPE_NORMAL;
	}

	str wep = GetWeapon();
	ResolveQwantFillAmmo(wep, type);
	str ammo = uh_qwant_fill_ammo;
	int slot = QwantTypeCustSlot(type);
	int max = uh_qwant_fill_max;
	str name = StrParam(l:BuildQwantTagKey(wep));

	DrawCustomBar(slot, CheckInventory(ammo), max);
	SetInventory("SBARAmmoOffset", 1);
	DrawNormalAmmo();
	DrawBar2Color(QWANT_MOVE_BAR2_CYAN, QWANT_MOVE_BAR2_BLUE);
	SetHudSize(320, 200, 0);
	InitPkmnf7WidthTable();
	DrawTextInPkmovBox(name, "PKMNFNT7", "Crayon4",
		UH_IMAGE_ID_BASE - 4, UH_IMAGE_ID_BASE - 5,
		UH_IMAGE_ID_BASE - 6, UH_IMAGE_ID_BASE - 7,
		0.1, 80.1, 28.1, 162.1);
}

script "DrawBar_Qwant_W" (void) {
	int ball = CheckInventory("QwantBallFlag");
	DrawCustomBar(CUST_QWANT, CheckInventory("MyDestinyAmmo"), 28);
	SetInventory("SBARAmmoOffset", 1);
    DrawNormalAmmo();
	DrawBar2Color(QWANT_MOVE_BAR2_CYAN, QWANT_MOVE_BAR2_BLUE);
	SetHudSize(320, 200, 0);
	InitPkmnf7WidthTable();
	if (ball < 0) {
		ball = 0;
	}
	if (ball > 38) {
		ball = 38;
	}
	DrawTextInPkmovBox(qwant_ballname[ball], "PKMNFNT7", "Crayon4",
		UH_IMAGE_ID_BASE - 4, UH_IMAGE_ID_BASE - 5,
		UH_IMAGE_ID_BASE - 6, UH_IMAGE_ID_BASE - 7,
		0.1, 80.1, 28.1, 162.1);
}


// Magnetic polarity mug overlay (original Unholy SBARINFO DrawImage UMUG_13B / UMUGS13B).
// Coords match MM8BDM playericon / DrawUHClassMugshot — not Unholy's 30+center,-19.
function void DrawHomingSeekerMugOverlay(str mug) {
  if (!CheckInventory("HSeek_MagneticFlag")) {return;}
  if (!CheckInventory("MugshotFlag")) {return;}
  int mode = AssistDisplayBar_HUDMode();
  int x, y;
  if (mode == BAR_DISPLAY_HORI) {
    x = 186.1;
    y = 184.1;
  } else if (mode == BAR_DISPLAY_VERT) {
    x = 20.1;
    y = 0.1;
  } else {
    return;
  }
  SetHudSize(320, 200, 0);
  BasicImageDisplay(mug, UH_IMAGE_ID_BASE + 62, x, y);
}

script "DrawBar_HomingSeeker_W" (void) {
  if (!CheckInventory("HSeek_MagneticFlag")) {
    DrawBarColor(170, 227);
  } else {
    DrawBarColor(196, 198);
    DrawHomingSeekerMugOverlay("UMUG_13B");
  }
}

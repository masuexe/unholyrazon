				                    CheckActorInventory(cam, "AssistNumberFlag") > 0,
				                    timeSec);
		}
	}
}


function void DrawReloadIcon(str image) {
	if (StrLen(image) == 0 || !CheckFont(image)) image = "RSAXT0";
	SetHudSize(640, 400, false);
	if (AssistDisplayBar_HUDMode() != BAR_DISPLAY_NONE) {
		int x = 64.1;
		int y = 110.1;
		if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_HORI) {
			x = 356.1;
			y = 350.1;
		}
		BasicImageDisplay(image, Get_And_Inc_AssistDisplayID(), x, y);
	}
	SetHudSize(320, 200, false);
}

//The FUTURE

function void AdjustedImageDisplay(str image, str image2, int id, int id2, int x1, int y1, int x2, int y2)
{
AdjustedImageDisplay2(image, image2, id, id2, x1, y1, x2, y2, 1873, 1.0, HUDMSG_PLAIN);
}

function void AdjustedImageDisplayFlag(str image, str image2, int id, int id2, int x1, int y1, int x2, int y2, int flag)
{
AdjustedImageDisplay2(image, image2, id, id2, x1, y1, x2, y2, 1873, 1.0, flag);
}

function void AdjustedImageDisplay2(str vertImage, str horiImage, int id, int id2, int x1, int y1, int x2, int y2, int holdtime, int alpha, int flag)
{
	if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_HORI) {
		SetFont(horiImage);
		HudMessageBold(s:"A"; HUDMSG_PLAIN|flag, id, CR_UNTRANSLATED, x2, y2, holdtime, alpha);
	} else {
		SetFont(horiImage);
		HudMessageBold(s:"A"; HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW|flag, id2, CR_UNTRANSLATED, x2, y2, holdtime, alpha);
		if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_VERT) {
			SetFont(vertImage);
			HudMessageBold(s:"A"; HUDMSG_NOTWITHFULLMAP|flag, id, CR_UNTRANSLATED, x1, y1, holdtime, alpha);
		} 
	}
}

//UH Stuff

function void AdjustedDrawNumber(str numFont, str CR_color, int Number, int id, int id2, int x1, int y1, int x2, int y2)
{
	SetFont(numFont);
	if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_HORI) {
		HudMessageBold(i:Number; HUDMSG_PLAIN|HUDMSG_COLORSTRING, id, CR_color, x2, y2, 1873, 1.0);
	} else {
		HudMessageBold(i:Number; HUDMSG_PLAIN|HUDMSG_COLORSTRING|HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW, id2, CR_color, x2, y2, 1873, 1.0);
		if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_VERT) {
			HudMessageBold(i:Number; HUDMSG_PLAIN|HUDMSG_COLORSTRING|HUDMSG_NOTWITHFULLMAP, id, CR_color, x1, y1, 1873, 1.0);
		} 
	}
}

function void AdjustedDrawNumberC(str numFont, int CR_color, int Number, int id, int id2, int x1, int y1, int x2, int y2)
{
	SetFont(numFont);
	if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_HORI) {
		HudMessageBold(i:Number; HUDMSG_PLAIN, id, CR_color, x2, y2, 1873, 1.0);
	} else {
		HudMessageBold(i:Number; HUDMSG_PLAIN|HUDMSG_NOTWITHOVERLAYMAP|HUDMSG_NOTWITH3DVIEW, id2, CR_color, x2, y2, 1873, 1.0);
		if (AssistDisplayBar_HUDMode() == BAR_DISPLAY_VERT) {
			HudMessageBold(i:Number; HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP, id, CR_color, x1, y1, 1873, 1.0);
		} 
	}
}


    }
  } else {
    if (CheckInventory("MockingAmmo") >= 50) {
      DrawBarColorOwned(CheckInventory("MockingAmmo"), 400, 4, 106);
    } else {
      DrawBarColorOwned(CheckInventory("MockingAmmo"), 400, 93, 113);
    }
  }
}

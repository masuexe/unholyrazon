script "DrawBar_Arcanist_W" (void) {
	DrawBarColor(250, 253);
	SetHudSize(320, 200, 0);
	switch (CheckInventory("ArcanistCycle_F")) {
		case 0:
			AdjustedImageDisplay("C_I_12E", "C_I_12E", UH_IMAGE_ID_BASE, UH_IMAGE_ID_BASE-1, 0.1, 42.1, 98.1, 165.1);

int uh_inplay_cache = -1;

function bool UHInPlay(void) {
	if (uh_inplay_cache < 0) {
		int u = UniqueTID();
		uh_inplay_cache = SpawnForced("UHModderSupport_H", 0, 0, 0, u, 0);
		if (uh_inplay_cache)
			Thing_Remove(u);
	}
	return uh_inplay_cache;
}

// === UHADD <-> UHADDR cvar mailbox diagnostics ===============================
// Every registration helper below stages its arguments in ephemeral cvars that
// the matching UHADDR handler reads back.  SetCVar/SetCVarString return 0 and do
// nothing when the name is not registered in CVARINFO.ipc, and the handler's
// GetCVarString then reads int 0 instead of the argument — so an entire batch of
// registrations fails with no usable cause, and it is never one bad data row.
//
// Two rules for every helper:
//   1. Accumulate the SetCVar* return values with `&` — NOT `&&`, which
//      short-circuits and would leave stale values in the mailboxes that follow
//      the first failure.
//   2. When the accumulator is 0, do NOT call the handler; report the root
//      cause once per ACS VM (per library instance) so e.g. 23 bonus event
//      definitions do not repeat the same message 23 times.
int uh_add_ipcfail_reported = 0;

function void UH_ReportIPCFailure(str entrypoint) {
	if (uh_add_ipcfail_reported)
		return;
	uh_add_ipcfail_reported = 1;
	UH_Log(UH_LOG_ERROR, StrParam(
		s:"UHADD: ", s:entrypoint,
		s:" mailbox cvars are not registered in CVARINFO.ipc; this and every later registration of the same kind is dropped."));
}

function int DefineBoss(
	int id,
	str actor,
	str name,
	int rarity,
	int basehp,
	int addhp,
	str exboss_baseactor,
	str mugshot,
	str instruction,
	str spawnmessagetype,
	str spawnmessage,
	str ragewarningmessage) {
	SetCVar("uh_db_id", id);
	SetCVarString("uh_db_actor", actor);
	SetCVarString("uh_db_name", name);
	SetCVar("uh_db_rarity", rarity);
	SetCVar("uh_db_basehp", basehp);
	SetCVar("uh_db_addhp", addhp);
	SetCVarString("uh_db_exbase", exboss_baseactor);
	SetCVarString("uh_db_mugshot", mugshot);
	SetCVarString("uh_db_instruction", instruction);
	SetCVarString("uh_db_spawnmsgtype", spawnmessagetype);
	SetCVarString("uh_db_spawnmsg", spawnmessage);
	SetCVarString("uh_db_ragewarning", ragewarningmessage);
	return ACS_NamedExecuteWithResult("uh_DefineBoss_S");
}

function int UH_IsBossDefined(int id) {
	return ACS_NamedExecuteWithResult("uh_IsBossDefined_S", id);
}

// Status codes for new writes; legacy Define* keeps its existing sentinel.
#define UHDB_OK 0
#define UHDB_ERR_NOTFOUND 1
#define UHDB_ERR_CONFLICT 2
#define UHDB_ERR_REFERENCED 3
#define UHDB_ERR_CAPACITY 4
#define UHDB_ERR_BADARG 5

function int IsBossEnabled(int id) {
	return ACS_NamedExecuteWithResult("uh_IsBossEnabled_S", id);
}

function int SetBossEnabled(int id, int enabled) {
	return ACS_NamedExecuteWithResult("uh_SetBossEnabled_S", id, enabled);
}

function int DisableBoss(int id) { return SetBossEnabled(id, 0); }
function int EnableBoss(int id) { return SetBossEnabled(id, 1); }

function int UpdateBossDisplay(int id, str name, str mugshot,
	str instruction, str spawnMsgType, str spawnMsg, str rageWarning) {
	int ipc;
	ipc  = SetCVarString("uh_db_name", name);
	ipc = ipc & SetCVarString("uh_db_mugshot", mugshot);
	ipc = ipc & SetCVarString("uh_db_instruction", instruction);
	ipc = ipc & SetCVarString("uh_db_spawnmsgtype", spawnMsgType);
	ipc = ipc & SetCVarString("uh_db_spawnmsg", spawnMsg);
	ipc = ipc & SetCVarString("uh_db_ragewarning", rageWarning);
	if (!ipc) return UHDB_ERR_BADARG;
	return ACS_NamedExecuteWithResult("uh_UpdateBossDisplay_S", id);
}

function int UpdateBossStats(int id, int rarity, int basehp, int addhp) {
	return ACS_NamedExecuteWithResult("uh_UpdateBossStats_S", id, rarity, basehp, addhp);
}

function int RemoveBoss(int id) {
	return ACS_NamedExecuteWithResult("uh_RemoveBoss_S", id);
}

function int SetBossEnabledByActor(str actor, int enabled) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
	return SetBossEnabled(id, enabled);
}

function int UpdateBossDisplayByActor(str actor, str name, str mugshot,
	str instruction, str spawnMsgType, str spawnMsg, str rageWarning) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
	return UpdateBossDisplay(id, name, mugshot, instruction,
		spawnMsgType, spawnMsg, rageWarning);
}

function int UpdateBossStatsByActor(str actor, int rarity, int basehp, int addhp) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
	return UpdateBossStats(id, rarity, basehp, addhp);
}

function int RemoveBossByActor(str actor) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) return UHDB_ERR_NOTFOUND;
	return RemoveBoss(id);
}

function int GetDefinedBossCount(void) {
	return ACS_NamedExecuteWithResult("uh_GetDefinedBossCount_S");
}

function int GetEnabledBossCount(void) {
	return ACS_NamedExecuteWithResult("uh_GetEnabledBossCount_S");
}

function int UH_FindBossByActor(str actor) {
	SetCVarString("uh_db_actor", actor);
	return ACS_NamedExecuteWithResult("uh_FindBossByActor_S");
}

// Internal helper: id is the signed UHDT boss id. Modders should use
// SetBossMorphSetupByActor instead; custom ids are not stable across PK3s.
function bool SetBossMorphSetupById(int id, str setupscript) {
	SetCVar("uh_db_id", id);
	SetCVarString("uh_db_setup", setupscript);
	return ACS_NamedExecuteWithResult("uh_SetBossMorphSetup_S");
}

// Public API: register the ACS script that runs after MorphActor and before
// the first Ready state. The script should be named/designed as
// "uh_BossMorphSetup_<Actor>" by convention, but any existing named script works.
function bool SetBossMorphSetupByActor(str actor, str setupscript) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) {
		UH_Log(UH_LOG_ERROR, StrParam(s:"SetBossMorphSetupByActor: boss not found: ", s:actor));
		return false;
	}
	return SetBossMorphSetupById(id, setupscript);
}

// Internal helper: id is the signed UHDT boss id. Modders should use
// SetBossUnmorphCleanupByActor instead; custom ids are not stable across PK3s.
function bool SetBossUnmorphCleanupById(int id, str prescript, str postscript) {
	int ipc;
	ipc  = SetCVar("uh_db_id", id);
	ipc = ipc & SetCVarString("uh_db_unmorphpre", prescript);
	ipc = ipc & SetCVarString("uh_db_unmorphpost", postscript);
	if (ipc == 0) {
		UH_ReportIPCFailure("SetBossUnmorphCleanup");
		return false;
	}
	return ACS_NamedExecuteWithResult("uh_SetBossUnmorphCleanup_S");
}

// Public API: register the symmetric unmorph cleanup for a boss.  Both scripts
// are called as (<script>, bossid, tid) with the boss player as activator:
//   preScript  — runs BEFORE UnMorphActor, while the boss weapons/markers are
//                still in the player's inventory: return boss-owned property
//                stacks, release grab targets and helper pointers, expire
//                watchers, cancel boss/global state (spell cards, Mujica, ...).
//   postScript — runs AFTER the generic demorph reset, for residue that is only
//                safe to touch once P_UndoPlayerMorph transferred inventory.
// Pass "" for a stage that is not needed.  Unregistered bosses simply skip the
// dispatch, so this is optional for every boss.
// Public API: restrict the demorph property-stacker baseline clamp to the
// families this boss can actually acquire (bit N = the family index documented
// at uh_morphpropstackname in systems/tools/morph_reset.acs; -1 = all).  A
// surplus in a family the boss does not use was granted by a map, an item or
// another mod during the morph, so the clamp must leave it alone.
function bool SetBossUnmorphFamsByActor(str actor, int mask) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) {
		UH_Log(UH_LOG_ERROR, StrParam(s:"SetBossUnmorphFamsByActor: boss not found: ", s:actor));
		return false;
	}
	return ACS_NamedExecuteWithResult("uh_SetBossUnmorphOwnedFamilies_S", id, mask);
}

function bool SetBossUnmorphCleanupByActor(str actor, str prescript, str postscript) {
	int id = UH_FindBossByActor(actor);
	if (id == UHBOSS_FAIL) {
		UH_Log(UH_LOG_ERROR, StrParam(s:"SetBossUnmorphCleanupByActor: boss not found: ", s:actor));
		return false;
	}
	return SetBossUnmorphCleanupById(id, prescript, postscript);
}


// === DefineUnholyItem ========================================================
// id: >=0 vanilla; -1 = auto custom (-1,-2,…).
// actor / name / dtaddGroup required. icon is spawn sprite ("" skips UIX).
// Include DTADD.acs for DTADD_GRP_*. mugshot / stingSound optional ("").
// Drops: SetUnholyBox + AddUnholyItemDrop (not on DefineUnholyItem).

function int DefineUnholyItem(int id, str actor, str name, str icon, int dtaddGroup, str mugshot, str sound) {
	int defined;

	if (dtaddGroup < 0 || dtaddGroup > 10) {
		UH_Log(UH_LOG_WARN, StrParam(s:"DefineUnholyItem: unknown DTADD group for ", s:actor));
		return UHITEM_FAIL;
	}
	SetCVar("uh_di_id", id);
	SetCVarString("uh_di_actor", actor);
	SetCVarString("uh_di_name", name);
	SetCVarString("uh_di_icon", icon);
	SetCVar("uh_di_group", dtaddGroup);
	SetCVarString("uh_di_mugshot", mugshot);
	SetCVarString("uh_di_sound", sound);
	defined = ACS_NamedExecuteWithResult("uh_DefineUnholyItem_S");
	if (defined == UHITEM_FAIL) {
		UH_Log(UH_LOG_WARN, StrParam(s:"DefineUnholyItem failed for ", s:actor));
		return UHITEM_FAIL;
	}
	return defined;
}


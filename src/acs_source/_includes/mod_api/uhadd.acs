// === DefineTeamPresentation ==================================================
// Actor-keyed DISPLAY data (teammate-bar short name, mugshot texture, scoreboard
// icon) for the teammate bar, the SCORINFO UHPlayerIcon column and the UIX
// Better Team Display.  Identity stays in DefineSurvivor / DefineBoss /
// DefineDemoneye; this only adds what those tables cannot express, and it also
// covers morph bodies that have no definition row of their own.
//
// actor     : DECORATE player actor class, the case-insensitive key. Required.
// shortName : teammate-bar third line. "" falls back to the definition name
//             (eyes keep the DefineDemoneye " Demoneye" suffix rule), then to
//             the actor class.  Pass an explicit name for a bar label that
//             differs from the broadcast name.
// portrait  : teammate-bar / UIX mugshot texture. "" = no face (never a guess).
// scoreIcon : SCORINFO texture. "" = same as portrait.
// flags     : reserved display semantics; pass 0.
//
// Re-registering the same actor (any case) REPLACES the row, so an addon can
// correct a built-in face.  Returns UHTIP_OK, UHTIP_FAIL, UHTIP_FULL or
// UHTIP_BAD_ACTOR.
//
// Must be called from BOTH the plain OPEN script and its OPEN CLIENTSIDE twin,
// in the same order — the client resolves faces from its local table.

function int DefineTeamPresentation(
	str actor,
	str shortName,
	str portrait,
	str scoreIcon,
	int flags) {
	int ipc;
	int row;
	ipc  = SetCVarString("uh_tip_actor", actor);
	ipc = ipc & SetCVarString("uh_tip_name", shortName);
	ipc = ipc & SetCVarString("uh_tip_portrait", portrait);
	ipc = ipc & SetCVarString("uh_tip_scoreicon", scoreIcon);
	ipc = ipc & SetCVar("uh_tip_flags", flags);
	if (ipc == 0) {
		UH_ReportIPCFailure("DefineTeamPresentation");
		return UHTIP_FAIL;
	}
	row = ACS_NamedExecuteWithResult("uh_DefineTeamPresentation_S");
	if (row == UHTIP_NONE) { return UHTIP_BAD_ACTOR; }
	if (row == UHTIP_TABLE_FULL) { return UHTIP_FULL; }
	if (row < 0) { return UHTIP_FAIL; }
	return UHTIP_OK;
}

// Row index of an actor's presentation, or UHTIP_FAIL when it has none.
function int FindTeamPresentation(str actor) {
	SetCVarString("uh_tip_actor", actor);
	int row = ACS_NamedExecuteWithResult("uh_FindTeamPresentation_S");
	if (row < 0) { return UHTIP_FAIL; }
	return row;
}


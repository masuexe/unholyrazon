function int UpdateLMSEvent(int id, str message, str raremessage,
	str icon, str rareicon, int flags, int weight) {
	int ipc = SetCVarString("uh_le_message", message);
	ipc = ipc & SetCVarString("uh_le_raremessage", raremessage);
	ipc = ipc & SetCVarString("uh_le_icon", icon);
	ipc = ipc & SetCVarString("uh_le_rareicon", rareicon);
	ipc = ipc & SetCVar("uh_le_flags", flags);
	ipc = ipc & SetCVar("uh_le_weight", weight);
	if (!ipc)
		return UHDB_ERR_BADARG;
	return ACS_NamedExecuteWithResult("uh_UpdateLMSEvent_S", id);
}


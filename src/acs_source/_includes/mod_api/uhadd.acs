// Addon-safe: resolve stem, then AddLMSMusic.
function int AddLMSMusicByStem(str stem, str lump, str title, str album, str artist, int weight, int optional) {
	int eventid;
	eventid = UH_FindLMSEventByStem(stem);
	if (eventid == UHLMS_FAIL)
		return UHMUS_FAIL;
	return AddLMSMusic(eventid, lump, title, album, artist, weight, optional);
}

function int UH_MusicKeyMailbox(int bossid, int kind, int phase, str lump) {
	if (!SetCVar("uh_bm_bossid", bossid))
		return 0;
	if (!SetCVar("uh_bm_kind", kind))
		return 0;
	if (!SetCVar("uh_bm_phase", phase))
		return 0;
	if (!SetCVarString("uh_bm_lump", lump))
		return 0;
	return 1;
}

// enabled 0 disables, any other value enables. Defined rows stay queryable.
// Returns UHMUS_OK, UHMUS_ERR_NOTFOUND, UHMUS_ERR_BADARG, or UHMUS_FAIL if the
// mailbox cvar write failed (the table is not touched in that case).
function int SetBossMusicEnabled(int bossid, int kind, int phase, str lump, int enabled) {
	if (!UH_MusicKeyMailbox(bossid, kind, phase, lump))
		return UHMUS_FAIL;
	if (!SetCVar("uh_bm_enabled", enabled))
		return UHMUS_FAIL;
	return ACS_NamedExecuteWithResult("uh_SetBossMusicEnabled_S");
}

function int DisableBossMusic(int bossid, int kind, int phase, str lump) {
	return SetBossMusicEnabled(bossid, kind, phase, lump, 0);
}

function int EnableBossMusic(int bossid, int kind, int phase, str lump) {
	return SetBossMusicEnabled(bossid, kind, phase, lump, 1);
}


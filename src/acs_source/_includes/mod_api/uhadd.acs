// Add a weighted spawn BGM for an existing boss (stable vanilla id, or id from
// DefineBoss in the same register call). Prefer AddBossMusicByActor for addons.
// weight >= 1. optional: 1 = skipped unless uh_sv_OptionalMusic.
function int AddBossMusic(int bossid, str lump, str title, str album, str artist, int weight, int optional) {
	SetCVar("uh_bm_bossid", bossid);
	SetCVar("uh_bm_kind", UHMUS_KIND_SPAWN);
	SetCVar("uh_bm_phase", 0);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_title", title);
	SetCVarString("uh_bm_album", album);
	SetCVarString("uh_bm_artist", artist);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	return ACS_NamedExecuteWithResult("uh_AddBossMusic_S");
}

// Addon-safe: resolve DECORATE class name via UH_FindBossByActor (vanilla or custom).
function int AddBossMusicByActor(str actor, str lump, str title, str album, str artist, int weight, int optional) {
	int bossid;
	bossid = UH_FindBossByActor(actor);
	if (bossid == UHBOSS_FAIL)
		return UHMUS_FAIL;
	return AddBossMusic(bossid, lump, title, album, artist, weight, optional);
}

// Phase-2 / enrage BGM. phase: 0 default; some bosses use 1+ (e.g. CuttyCut).
function int AddBossEnrageMusic(int bossid, int phase, str lump, str title, str album, str artist, int weight, int optional) {
	SetCVar("uh_bm_bossid", bossid);
	SetCVar("uh_bm_kind", UHMUS_KIND_ENRAGE);
	SetCVar("uh_bm_phase", phase);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_title", title);
	SetCVarString("uh_bm_album", album);
	SetCVarString("uh_bm_artist", artist);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	return ACS_NamedExecuteWithResult("uh_AddBossMusic_S");
}

function int AddBossEnrageMusicByActor(str actor, int phase, str lump, str title, str album, str artist, int weight, int optional) {
	int bossid;
	bossid = UH_FindBossByActor(actor);
	if (bossid == UHBOSS_FAIL)
		return UHMUS_FAIL;
	return AddBossEnrageMusic(bossid, phase, lump, title, album, artist, weight, optional);
}

// LMS survivor-victory theme. duration: ACS fixed seconds (-1.0 unknown).
// emuflag: 1 = MAME (+12 tics on returned delay).
function int AddWinnerMusic(str lump, str title, str album, str artist, int weight, int optional, int duration, int emuflag) {
	SetCVar("uh_bm_kind", UHMUS_KIND_WINNER);
	SetCVar("uh_bm_phase", 0);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_title", title);
	SetCVarString("uh_bm_album", album);
	SetCVarString("uh_bm_artist", artist);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	SetCVar("uh_bm_duration", duration);
	SetCVar("uh_bm_emuflag", emuflag);
	return ACS_NamedExecuteWithResult("uh_AddEventMusic_S");
}

// LMS survivor-defeat theme. Same args as AddWinnerMusic.
function int AddLoserMusic(str lump, str title, str album, str artist, int weight, int optional, int duration, int emuflag) {
	SetCVar("uh_bm_kind", UHMUS_KIND_LOSER);
	SetCVar("uh_bm_phase", 0);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_title", title);
	SetCVarString("uh_bm_album", album);
	SetCVarString("uh_bm_artist", artist);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	SetCVar("uh_bm_duration", duration);
	SetCVar("uh_bm_emuflag", emuflag);
	return ACS_NamedExecuteWithResult("uh_AddEventMusic_S");
}

// Last-survivor event BGM for a given eventid (vanilla 0–11; no upper cap).
// No duration — plays until match end. weight >= 1.
function int AddLMSMusic(int eventid, str lump, str title, str album, str artist, int weight, int optional) {
	SetCVar("uh_bm_kind", UHMUS_KIND_LMS);
	SetCVar("uh_bm_phase", eventid);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_title", title);
	SetCVarString("uh_bm_album", album);
	SetCVarString("uh_bm_artist", artist);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	SetCVar("uh_bm_duration", 0);
	SetCVar("uh_bm_emuflag", 0);
	return ACS_NamedExecuteWithResult("uh_AddEventMusic_S");
}

// Define a last-survivor LMS event. id -1 = auto >=12. weight 0 = force only.
function int DefineLMSEvent(int id, str stem, str message, str raremessage, str icon, str rareicon, int flags, int weight) {
	SetCVar("uh_le_id", id);
	SetCVarString("uh_le_stem", stem);
	SetCVarString("uh_le_message", message);
	SetCVarString("uh_le_raremessage", raremessage);
	SetCVarString("uh_le_icon", icon);
	SetCVarString("uh_le_rareicon", rareicon);
	SetCVar("uh_le_flags", flags);
	SetCVar("uh_le_weight", weight);
	return ACS_NamedExecuteWithResult("uh_DefineLMSEvent_S");
}


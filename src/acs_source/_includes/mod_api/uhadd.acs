// Updates non-key fields only.  The current round cannot be mutated.
function int UpdateBonusEvent(int id, str name, str music, str title, str album,
	str artist, str sound, str hud1, str hud2, str startCallback,
	str rebuildCallback, str endCallback, int arg1, int arg2, int arg3,
	int flags, int weight, int minPlayers, int maxPlayers) {
	int ipc;
	ipc  = SetCVarString("uh_be_name", name);
	ipc = ipc & SetCVarString("uh_be_music", music);
	ipc = ipc & SetCVarString("uh_be_title", title);
	ipc = ipc & SetCVarString("uh_be_album", album);
	ipc = ipc & SetCVarString("uh_be_artist", artist);
	ipc = ipc & SetCVarString("uh_be_sound", sound);
	ipc = ipc & SetCVarString("uh_be_hud1", hud1);
	ipc = ipc & SetCVarString("uh_be_hud2", hud2);
	ipc = ipc & SetCVarString("uh_be_startcb", startCallback);
	ipc = ipc & SetCVarString("uh_be_rebuildcb", rebuildCallback);
	ipc = ipc & SetCVarString("uh_be_endcb", endCallback);
	ipc = ipc & SetCVar("uh_be_arg1", arg1);
	ipc = ipc & SetCVar("uh_be_arg2", arg2);
	ipc = ipc & SetCVar("uh_be_arg3", arg3);
	ipc = ipc & SetCVar("uh_be_flags", flags);
	ipc = ipc & SetCVar("uh_be_weight", weight);
	ipc = ipc & SetCVar("uh_be_minp", minPlayers);
	ipc = ipc & SetCVar("uh_be_maxp", maxPlayers);
	if (!ipc) return UHDB_ERR_BADARG;
	return ACS_NamedExecuteWithResult("uh_UpdateBonusEvent_S", id);
}


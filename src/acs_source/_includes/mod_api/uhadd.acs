// === Bonus event public API ==================================================
// Define one round-level bonus event (see the recipe above for the callback
// contract).  id -1 auto-assigns >= UHBE_ADDON_ID_START.
// Mailbox contract: see "UHADD <-> UHADDR cvar mailbox diagnostics" above.
function int DefineBonusEvent(
	int id,
	str stem,
	str name,
	str music,
	str title,
	str album,
	str artist,
	str sound,
	str hud1,
	str hud2,
	str startCallback,
	str rebuildCallback,
	str endCallback,
	int arg1,
	int arg2,
	int arg3,
	int flags,
	int weight,
	int minPlayers,
	int maxPlayers) {
	int ipc;
	int result;
	ipc  = SetCVar("uh_be_id", id);
	ipc = ipc & SetCVarString("uh_be_stem", stem);
	ipc = ipc & SetCVarString("uh_be_name", name);
	ipc = ipc & SetCVarString("uh_be_music", music);
	ipc = ipc & SetCVarString("uh_be_title", title);
	ipc = ipc & SetCVarString("uh_be_album", album);
	ipc = ipc & SetCVarString("uh_be_artist", artist);
	ipc = ipc & SetCVarString("uh_be_sound", sound);
	ipc = ipc & SetCVarString("uh_be_hud1", hud1);
	ipc = ipc & SetCVarString("uh_be_hud2", hud2);
	ipc = ipc & SetCVarString("uh_be_startcb", startCallback);
	ipc = ipc & SetCVarString("uh_be_rebuildcb", rebuildCallback);
	ipc = ipc & SetCVarString("uh_be_endcb", endCallback);
	ipc = ipc & SetCVar("uh_be_arg1", arg1);
	ipc = ipc & SetCVar("uh_be_arg2", arg2);
	ipc = ipc & SetCVar("uh_be_arg3", arg3);
	ipc = ipc & SetCVar("uh_be_flags", flags);
	ipc = ipc & SetCVar("uh_be_weight", weight);
	ipc = ipc & SetCVar("uh_be_minp", minPlayers);
	ipc = ipc & SetCVar("uh_be_maxp", maxPlayers);
	if (ipc == 0) {
		UH_ReportIPCFailure("DefineBonusEvent");
		return UHBE_FAIL;
	}
	result = ACS_NamedExecuteWithResult("uh_DefineBonusEvent_S");
	if (result == UHBE_FAIL)
		UH_Log(UH_LOG_ERROR, StrParam(s:"DefineBonusEvent: registration failed for stem '", s:stem, s:"'."));
	return result;
}

// Bind base -> EX by stem (both events must be defined; threshold >= 1).
// Rebinding the same base updates the row.
function int SetBonusEventEX(str baseStem, str exStem, int threshold) {
	int ipc;
	ipc  = SetCVarString("uh_bex_base", baseStem);
	ipc = ipc & SetCVarString("uh_bex_ex", exStem);
	ipc = ipc & SetCVar("uh_bex_threshold", threshold);
	if (ipc == 0) {
		UH_ReportIPCFailure("SetBonusEventEX");
		return UHBE_FAIL;
	}
	return ACS_NamedExecuteWithResult("uh_SetBonusEventEX_S");
}


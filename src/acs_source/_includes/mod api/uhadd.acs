int uh_inplay_cache = -1;

function bool UHInPlay(void)
{
	if (uh_inplay_cache < 0)
	{
		int u = UniqueTID();
		uh_inplay_cache = SpawnForced("UHModderSupport_H", 0, 0, 0, u, 0);
		if (uh_inplay_cache)
			Thing_Remove(u);
	}
	return uh_inplay_cache;
}

function int DefineBoss(
	int id,
	str actor,
	str name,
	int rarity,
	int basehp,
	int addhp,
	str exboss_baseactor,
	str mugshot,
	str musiclump,
	str musiccredit,
	str instruction,
	str spawnmessagetype,
	str spawnmessage)
{
	SetCVar("uh_db_id", id);
	SetCVarString("uh_db_actor", actor);
	SetCVarString("uh_db_name", name);
	SetCVar("uh_db_rarity", rarity);
	SetCVar("uh_db_basehp", basehp);
	SetCVar("uh_db_addhp", addhp);
	SetCVarString("uh_db_exbase", exboss_baseactor);
	SetCVarString("uh_db_mugshot", mugshot);
	SetCVarString("uh_db_music", musiclump);
	SetCVarString("uh_db_musiccredit", musiccredit);
	SetCVarString("uh_db_instruction", instruction);
	SetCVarString("uh_db_spawnmsgtype", spawnmessagetype);
	SetCVarString("uh_db_spawnmsg", spawnmessage);
	return ACS_NamedExecuteWithResult("uh_DefineBoss_S");
}


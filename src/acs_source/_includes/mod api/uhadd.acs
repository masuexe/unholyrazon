// UHADD — modder-facing DefineBoss API (include; not a LOADACS library).
// Pattern matches MM8BDM DTADD / CBM CBMADD: stash args in ephemeral cvars, call UHADDR.
//
// === Addon recipe (MM8BDM DefineWeapon + CLIENTSIDE twin) =====================
// 1. LOADACS: UHDT → UHADDR → UH_BOSSDEFS → UH_SURVDEFS → (your lib after Unholy pk3 loads).
// 2. In YOUR_BOSSDEFS.acs:
//      #library "YOUR_BOSSDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//
//      function void YourRegisterBosses(void)
//      {
//          DefineBoss(
//              -1, "YourBossActor", "\cjName",
//              UHBOSS_POOL_COMMON,
//              2000, 300,
//              "",
//              "UFACE26",
//              "M_UB000", "credit",
//              "instructions",
//              "T.", "spawn msg"
//          );
//      }
//
//      script "your_define_bosses" OPEN
//      {
//          if (!UHInPlay()) terminate;
//          YourRegisterBosses();
//      }
//
//      // Required online: non-CLIENTSIDE OPEN runs on the server only;
//      // CLIENTSIDE HUD reads local UHDT for boss names.
//      script "your_define_bosses_cs" OPEN CLIENTSIDE
//      {
//          // Do NOT UHInPlay (SpawnForced can fail on pure clients).
//          // Do NOT UH_IsBossDefined(0/-1); 0 is vanilla, -1 is first custom.
//          // Duplicate actors are rejected by DefineBoss (UHBOSS_FAIL) — safe to re-run.
//          YourRegisterBosses();
//      }
// 3. Identity = DECORATE actor class (must be unique across loaded PK3s).
// 4. id: >=0 stable vanilla slot; -1 = auto custom (-1,-2,…).
// 5. ForcedBoss / ForcedShadowBoss "none" is UHBOSS_FAIL (-9999), NOT -1.
// 6. UHBOSS_POOL_NONE (0) = registered but not in RNG pools (force / EX parent only).
// 7. EX: pass parent actor in exboss_baseactor; use GetBossBaseId / GetBossExId.
// 8. Mugshot: set an explicit font/lump for custom ids (Shiny/CBM own negative bands).
//
// === Boss morph setup (post-morph, pre-Ready) ================================
// Optional per-boss script that runs after MorphActor/PostReset/BasicBossItem
// and before uh_BossMorph. This is where multi-weapon/ExtraLife/PowerLimit
// setup belongs (ArchArcanist, CuttyCut, GBeast, etc).
//
//      function void YourRegisterBosses(void)
//      {
//          DefineBoss(
//              -1, "YourBossActor", "\cjYour Boss",
//              UHBOSS_POOL_COMMON,
//              2000, 300,
//              "",
//              "UFACE26",
//              "M_UB000", "credit",
//              "instructions",
//              "T.", "spawn msg"
//          );
//          SetBossMorphSetupByActor("YourBossActor", "uh_BossMorphSetup_YourBossActor");
//      }
//
//      script "uh_BossMorphSetup_YourBossActor" (int bossId, int tid)
//      {
//          SetActivator(tid);
//          GiveInventory("YourBoss_W", 1);
//          GiveInventory("YourBoss_W2", 1);
//          GiveInventory("UnholyPowerLimit_F", 1500);
//      }
//
// Rules: script signature is (int bossId, int tid); do NOT Delay inside this
// script. It runs on the server, so do NOT mark it CLIENTSIDE. If the script
// is not found when a boss is morphed, core logs it.
//
// === DefineSurvivor addon recipe =============================================
// 1. KEYCONF (addon pk3): addplayerclass YourClass nomenu  — NO clearplayerclasses.
// 2. LOADACS after Unholy: YOUR_SURVDEFS
// 3. ACS:
//      #library "YOUR_SURVDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegisterSurvivors(void) {
//          DefineSurvivor(-1, "YourClass", "\cjName", "UMUG_6");
//      }
//      script "your_define_survivors" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterSurvivors();
//      }
//      script "your_define_survivors_cs" OPEN CLIENTSIDE {
//          YourRegisterSurvivors();
//      }
// 4. Shiny class (optional) = YourClass + "Shiny". Missing → MorphActor fails → S_ClassSpawnNo_P.
// 5. Do not name non-player actors YourClassShiny (weapons use YourClassShiny_W).
// 6. Look up by actor: FindSurvivorByActor — do not assume
//    PlayerClass() == survivorId for addon classes (KEYCONF append is 59+).
//
// === DefineDemoneye addon recipe =============================================
// 1. LOADACS after Unholy: YOUR_EYEDEFS
// 2. ACS:
//      #library "YOUR_EYEDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegisterEyes(void) {
//          DefineDemoneye(-1, "YourDemoneye", "\ctYour", "a ", 0, "EYE_F0", "Your");
//          // Color lives on name (HUD + YouAreNow). Prefix is article only.
//          // UHEYE_FLAG_NOSUFFIX = omit " Demoneye" in YouAreNow line.
//      }
//      script "your_define_eyes" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterEyes();
//      }
//      script "your_define_eyes_cs" OPEN CLIENTSIDE {
//          YourRegisterEyes();
//      }
// 3. Mugshot is mandatory (BHW SetFont name). eventStem builds {stem}_MoolaGiver.
// 4. Bonus face-only ids may pass actor "".
// 5. Do not register ArenaDemoneye-style boss-team eyes here — use DefineBoss.

// === Eye-morph weighted pools ===============================================
// A MorphProjectile's PlayerClass is static, so register concrete effect
// actors for the modes a pool uses.  The actors normally inherit EyeMorphShot,
// EyeMorphShotB (or a custom subclass), and EyeMorphGiver respectively.
//
//      int yourEye;
//      DefineDemoneye(-1, "YourDemoneye", "\\ctYour", "a ", 0,
//          "EYE_F0", "Your");
//      yourEye = FindEyeByActor("YourDemoneye");
//      DefineEyeMorphPool("YourPotion");
//      SetEyeMorphPoolEntry("YourPotion", yourEye,
//          "Your_MorphShot", "Your_MorphBurst", "Your_MorphGiver", 3);
//
// Pool names are case-insensitive.  A repeated (pool, eyeId) replaces the
// complete row; weight 0 disables it.  Empty actor fields are omitted from
// that mode's roll; at least one actor field is required.  PickEyeMorphActor
// returns the selected actor name (or "" when no eligible row exists), so a
// custom item's ACS can use
// Spawn/SpawnForced/SpawnProjectile or GiveInventory according to its own
// shape.  Call DefineEyeMorphPool before SetEyeMorphPoolEntry; an unknown pool
// or eye returns UHEM_FAIL.
// The built-in pools are "MoneyBait" and "MoneyBomb".
#define UHEM_FAIL       -9999
#define UHEM_MAX_WEIGHT 1000000
#define UHEM_SHOT       0
#define UHEM_BURST      1
#define UHEM_GIVER      2
// Verbose aliases for readability in shared helpers.
#define UHEM_MODE_SHOT  UHEM_SHOT
#define UHEM_MODE_BURST UHEM_BURST
#define UHEM_MODE_GIVER UHEM_GIVER

// Define/Find return the pool id (0 is valid); Set returns the row index.
// These integer APIs return UHEM_FAIL on invalid input or capacity exhaustion.
// GetEyeMorphPoolWeight also returns UHEM_FAIL for an unknown pool/eye;
// GetEyeMorphPoolActor returns "" for an unknown pool/eye or invalid mode.
function int DefineEyeMorphPool(str pool)
{
	SetCVarString("uh_em_pool", pool);
	return ACS_NamedExecuteWithResult("uh_DefineEyeMorphPool_S");
}

function int FindEyeMorphPool(str pool)
{
	SetCVarString("uh_em_pool", pool);
	return ACS_NamedExecuteWithResult("uh_FindEyeMorphPool_S");
}

function int SetEyeMorphPoolEntry(
	str pool,
	int eyeId,
	str shotActor,
	str burstActor,
	str giverActor,
	int weight)
{
	SetCVarString("uh_em_pool", pool);
	SetCVar("uh_em_eyeid", eyeId);
	SetCVarString("uh_em_shot", shotActor);
	SetCVarString("uh_em_burst", burstActor);
	SetCVarString("uh_em_giver", giverActor);
	SetCVar("uh_em_weight", weight);
	return ACS_NamedExecuteWithResult("uh_SetEyeMorphPoolEntry_S");
}

function str PickEyeMorphActor(str pool, int mode)
{
	SetCVarString("uh_em_pool", pool);
	SetCVar("uh_em_mode", mode);
	ACS_NamedExecuteWithResult("uh_PickEyeMorphActor_S");
	return GetCVarString("uh_em_out_str");
}

function int GetEyeMorphPoolWeight(str pool, int eyeId)
{
	SetCVarString("uh_em_pool", pool);
	SetCVar("uh_em_eyeid", eyeId);
	return ACS_NamedExecuteWithResult("uh_GetEyeMorphPoolWeight_S");
}

function str GetEyeMorphPoolActor(str pool, int eyeId, int mode)
{
	SetCVarString("uh_em_pool", pool);
	SetCVar("uh_em_eyeid", eyeId);
	SetCVar("uh_em_mode", mode);
	ACS_NamedExecuteWithResult("uh_GetEyeMorphPoolActor_S");
	return GetCVarString("uh_em_out_str");
}

// === MegaManU copywep HUD (MegaManUBar) ======================================
// Opt-in marker so BARHNDLE draws RockNRollAmmo (reroll meter) on bar2
// (or bar3 if the weapon already uses bar2).
//
// Recipe for a custom MegaManU weapon:
//   actor YourWep : BaseMegaManUWep { ... weapon.ammotype "YourAmmo" ... }
//   actor YourWep_MegaManUBar : MegaManUBar { Args cyan, blue }
//   // Args = weapon ENERGY bar colors (bar1), NOT the reroll colors.
//   // Reroll always uses RockNRollAmmo fill with cyan/blue 192,198.
//   // Optional: YourWep_ScriptBar : ScriptBar {} for DrawBar_YourWep overlays.
//
// Do NOT put MegaManUBar on MegaManU_W (buster bar1 is already RockNRoll).
// If your ScriptBar / _SecondBar already fills bar2, Unholy draws reroll on bar3.
// Use DrawBar2ColorOwned / DrawBar3Color for non-weapon ammo — plain DrawBar2Color
// binds Ammo2 and will not show RockNRollAmmo.
//
// === Custom bar slots (DrawCustomBar / DrawCustomBar1) =======================
// SBARINFO has 256 slots (0-255). Unholy occupies ~146-250 (see UH_BARS CUST_*).
// v6b already has BRSLT000-002. Empty in Unholy: 003-145 and 251-255.
// Other addons may take those too — pick a slot and document it; there is no
// reservation API. Do not patch Unholy's TEXTURES.barspos; addons cannot run
// tools/_gen_barpos.py against the loaded pk3.
//
// DrawCustomBar(slot, amount, cap) — overlay at SBAR (0,0), uses BRSLT### by
// name at draw time. Addon pk3 loaded AFTER Unholy only needs:
//   texture BRSLT251, 8, 56 {offset -24, -8 patch YourFill, 0, 0}
//   texture BRSLB251, 8, 56 {offset -24, -8 patch BAREMPTY, 0, 0}
//   texture VRSLT251, 56, 8 {offset -130, -184 patch BRSLT251, 0, 0 {rotate 90}}
//   texture VRSLB251, 56, 8 {offset -130, -184 patch VAREMPTY, 0, 0}
// Empty = NOBAR/VNOBAR if the tank should be invisible. ANIMDEFS can target
// BRSLT251 / VRSLT251. ScriptBar: DrawCustomBar(251, owned, max);
//
// DrawCustomBar1/2/HP(slot, ...) — bar1/bar2/HP coords. SBARINFO draws
// BZSLT### / BZSLB### (offset 0), which Unholy already defined as NOBAR for
// unused slots. An addon must REDEFINE those four names in its own TEXTURES
// (later pk3 wins):
//   graphic BZSLT251, 8, 56 {offset 0, 0 patch YourFill, 0, 0}
//   graphic BZSLB251, 8, 56 {offset 0, 0 patch BAREMPTY, 0, 0}
//   graphic VZSLT251, 56, 8 {offset 0, 0 patch YourFillH, 0, 0}
//   graphic VZSLB251, 56, 8 {offset 0, 0 patch VAREMPTY, 0, 0}
// Defining only BRSLT251 does NOT update Unholy's BZSLT251 composite.
//
// === DefineUnholyItem addon recipe ===========================================
// 1. LOADACS after Unholy: YOUR_ITEMDEFS
// 2. ACS:
//      #library "YOUR_ITEMDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegisterItems(void) {
//          // Identity only; then AddUnholyItemDrop into a box.
//          DefineUnholyItem(-1, "YourItem", "Your Item", "", "GNT/SuperShot");
//          AddUnholyItemDrop("PandoraBoxItem", "YourItem", 8, 1, "", "");
//          // Coin pool (instant use): giveActor = Auto* / Auto*Silent
//          // AddUnholyItemDrop("DLC_CoinItem", "YourItem", 8, 1, "", "AutoYourItemSilent");
//          // AssHat / DickHat: giveActor = hat class, or "" for generic hat + "{Item}FX"
//          // AddUnholyItemDrop("AssHatItem", "YourItem", 8, 1, "", "");
//          // AddUnholyItemDrop("DickHatItem", "YourItem", 8, 1, "", "");
//          // Coin threshold (prefer empty tiers; 1000/6666/9999 share with vanilla):
//          // DefineUnholyCoinSpend(500, 500, "YourItem", "misc/WellDoneMan");
//      }
//      // Custom box: DECORATE cannot pass string — wrap GiveUnholyBoxItem:
//      //   script "GiveYourBox" (int prosperity, int silent) {
//      //       SetResultValue(GiveUnholyBoxItem("YourBoxItem", prosperity, silent));
//      //   }
//      //   UseX: ACS_NamedExecuteWithResult("GiveYourBox", 0, 0)
//      function void YourRegisterBox(void) {
//          DefineUnholyItem(-1, "YourBoxItem", "Your Box", "", "");
//          SetUnholyBox("YourBoxItem", "items/YourBoxOpen", "items/ABoxEyeBox");
//          AddUnholyItemDrop("YourBoxItem", "YourItem", 50, 1, "", "");
//      }
//      script "your_define_items" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterItems();
//      }
//      script "your_define_items_cs" OPEN CLIENTSIDE {
//          YourRegisterItems();
//      }
// 3. Do NOT put item ids in BossNumb / BHW.
// 4. Same (box, item, giveActor, amt) AddUnholyItemDrop again accumulates weight.
// 5. Coin thresholds: DefineUnholyCoinSpend (not drop table). Prefer empty tiers
//    (e.g. 500); same minCount as vanilla (1000/6666/9999) shares 50/50 at use.
//    Do not register minCount 25 — that steals the cheap random pool.
// 6. AssHat / DickHat throw/land DECORATE; only the morph roll uses AddUnholyItemDrop.
// 7. LMS death drops every DefineUnholyItem the player still holds.
//
// === DefineUnholyGuardFactor addon recipe ====================================
// HP bar GuardUp / GuardDown from PowerProtection DamageFactor "Normal".
// ACS cannot read class DamageFactors — register the actor + factor here.
// HUD is CLIENTSIDE; the OPEN CLIENTSIDE twin is required online.
// Do NOT register PowerHalfDamageRune (own HUD icon) or type-only protects.
//
//      function void YourRegisterGuard(void) {
//          // >1.0 GuardDown (take more damage); <1.0 GuardUp (resist).
//          DefineUnholyGuardFactor("YourProtect", 2.0);
//      }
//      script "your_define_guard" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterGuard();
//      }
//      script "your_define_guard_cs" OPEN CLIENTSIDE {
//          YourRegisterGuard();
//      }
// Same actor again overwrites the factor (safe to re-run). Or keep Giving
// GuardUpFlag / GuardDownFlag — HUD still falls back when product == 1.0.
//
// === DefineCopyWep addon recipe ==============================================
// 1. LOADACS after Unholy: YOUR_COPYDEFS
// 2. ACS:
//      #library "YOUR_COPYDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegisterCopyWeps(void) {
//          DefineCopyWep(UHCOPY_MEGA, UHCOPY_SLOT_RANGED, "YourWepU");
//          DefineCopyWep(UHCOPY_QWANT, UHCOPY_QWANT_FIRE, "YourFireMoveWep");
//          DefineCopyWep(UHCOPY_NEGA, UHCOPY_NEGA_MM8, "NegaYourWep");
//      }
//      script "your_define_copyweps" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterCopyWeps();
//      }
//      script "your_define_copyweps_cs" OPEN CLIENTSIDE {
//          YourRegisterCopyWeps();
//      }
// 3. Same (kind, wepActor) again returns existing row (no double).
// 4. Mega daily dmg: vanilla ids 1..official frozen; addon uses class hash (no jackpot).
// 5. Qwant_W is not registered — startitem only.
//
// === AddBossMusic addon recipe ===============================================
// Prefer AddBossMusicByActor — class name is stable; custom DefineBoss(-1) ids are not.
// Keep AddBossMusic(bossId, ...) for vanilla stable ids or the int returned by DefineBoss
// in the *same* register function (do not hardcode -1 across pk3s).
//
// 1. LOADACS after Unholy: YOUR_MUSICDEFS
// 2. Same pk3 as your custom boss (no wait — DefineBoss then music):
//      #library "YOUR_MUSICDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegister(void) {
//          int id = DefineBoss(
//              -1, "YourBossActor", "\cjName",
//              UHBOSS_POOL_COMMON,
//              2000, 300,
//              "",
//              "UFACE26",
//              "M_MYBASE", "base credit",
//              "instructions",
//              "T.", "spawn msg"
//          );
//          // weight >= 1. optional 1 = skip unless uh_sv_OptionalMusic.
//          // Prefer optional=0 and ship lumps in the same addon pk3.
//          AddBossMusic(id, "M_MYTUNE", "Game - Track", 3, 0);
//          // or: AddBossMusicByActor("YourBossActor", "M_MYTUNE", "Game - Track", 3, 0);
//      }
//      script "your_define" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegister();
//      }
//      script "your_define_cs" OPEN CLIENTSIDE {
//          YourRegister();
//      }
// 3. Music-only addon for an existing boss (wait for *that* actor, not boss 0):
//      function void YourRegisterBossMusic(void) {
//          AddBossMusicByActor("GemBanker", "M_MYTUNE", "Game - Track", 3, 0);
//      }
//      script "your_define_boss_music" OPEN {
//          int t;
//          if (!UHInPlay()) terminate;
//          t = 0;
//          while (UH_FindBossByActor("GemBanker") == UHBOSS_FAIL && t < 35) {
//              Delay(1);
//              t++;
//          }
//          YourRegisterBossMusic();
//      }
//      script "your_define_boss_music_cs" OPEN CLIENTSIDE {
//          int t;
//          t = 0;
//          while (UH_FindBossByActor("GemBanker") == UHBOSS_FAIL && t < 35) {
//              Delay(1);
//              t++;
//          }
//          YourRegisterBossMusic();
//      }
// 4. Same (bossId, kind, phase, lump) again updates weight/credit/optional (no second row).
// 5. DefineBoss musiclump is auto-seeded as SPAWN kind (weight 1, optional 0).
// 6. Spawn uses PickBossMusicRow(id, UHMUS_KIND_SPAWN, 0) in ub_PlayVariantMusic.
// 7. Enrage: AddBossEnrageMusic / ByActor; DECORATE ub_BossEnrageMusic(which, phase).
// 8. OPEN order is not LOADACS order — wait for the target actor before Add*ByActor.

// === AddBossEnrageMusic addon recipe =========================================
// Same patterns as AddBossMusic. phase 0 = default enrage; CuttyCut uses 0 and 1.
//      AddBossEnrageMusicByActor("YourBossActor", 0, "M_ENRAGE", "credit", 1, 0);
// Custom DECORATE: ACS_NamedExecuteAlways("ub_BossEnrageMusic",0) or (0, phase).
// Empty enrage pool → no music change.
//
// === AddWinnerMusic / AddLoserMusic addon recipe ==============================
// Global LMS end themes (not per-boss). No actor wait required.
// duration: seconds as ACS fixed (-1.0 = unknown). emuflag: 1 = MAME (+12 tics).
//      AddWinnerMusic("M_MYWIN", "Game - Victory", 1, 0, -1.0, 0);
//      AddLoserMusic("M_MYLOSE", "Game - Game Over", 1, 0, -1.0, 0);
// Prefer optional=0 and ship lumps in the same addon pk3.
// Same (kind, phase=0, lump) again updates weight/credit/optional/duration/emuflag.
// Empty pool → PlayMusic_Winner/Loser skips play and returns 0.
//
// === AddLMSMusic addon recipe ================================================
// Per-event BGM for last-survivor LMS events (not a global random pool).
// eventid: vanilla 0–11; ids >=12 work once DefineLMSEvent registers them.
//      AddLMSMusic(4, "M_MYALT", "Game - Alt LMS Theme", 1, 0);
// Same (kind, eventid, lump) again updates weight/credit/optional.
// Empty pool for that eventid → ub_LMS_EventTime falls back to lmsListArray music.
//
// === DefineLMSEvent addon recipe =============================================
// Full last-survivor event (messages, icons, drops, dual-rune flag, pool weight).
// Drops and music bind by stem (stable). DefineLMSEvent(-1) still returns id for RCON.
// 1. LOADACS after Unholy: YOUR_LMSDEFS
// 2. ACS:
//      #library "YOUR_LMSDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegisterLMS(void) {
//          DefineLMSEvent(-1, "my_lms", "Normal msg", "Rare msg",
//              "MYLMS_E", "MYLMS_X", 0, 1);
//          AddLMSEventDrop("my_lms", "GUHUItem", 1, 0);
//          AddLMSEventDrop("my_lms", "SuperGUHUItem", 1, 1);
//          AddLMSMusicByStem("my_lms", "M_MYLMS", "Game - My LMS Theme", 1, 0);
//      }
//      script "your_define_lms" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegisterLMS();
//      }
//      script "your_define_lms_cs" OPEN CLIENTSIDE {
//          YourRegisterLMS();
//      }
// 3. id: 0–11 vanilla; -1 = auto next unused >=12. Same id again updates.
// 4. weight 0 = RCON/force only; >=1 = random pool. UHLMS_FLAG_DUALRUNE = second rune.
// 5. icon "" → LMS_E# / LMS_X# fallback (vanilla). Custom ids need explicit fonts.
// 6. Drops optional (vanilla dual-rune event has none). rare 0=normal, 1=rare fire.
// 7. Do not pass -1 to AddLMSEventDrop — use the stem string.

#define UHBOSS_FAIL -9999
#define UHSURV_FAIL -9999
#define UHEYE_FAIL -9999

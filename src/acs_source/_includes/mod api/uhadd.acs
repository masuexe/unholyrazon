// Addon DECORATE wrapper target: GiveUnholyBoxItem("YourBoxItem", prosperity, silent).
function int GiveUnholyBoxItem(str boxactor, int prosperity, int silent)
{
	SetCVarString("uh_di_boxactor", boxactor);
	SetCVar("uh_di_prosperity", prosperity);
	SetCVar("uh_di_silent", silent);
	return ACS_NamedExecuteWithResult("uh_GiveUnholyBoxItem_S");
}

// Register a copy weapon into Mega / Qwant / Nega roll pools.
// slot: Mega = UHCOPY_SLOT_*; Qwant = UHCOPY_QWANT_*; Nega = UHCOPY_NEGA_* (1..15).
function int DefineCopyWep(int kind, int slot, str wepActor)
{
	SetCVar("uh_cw_kind", kind);
	SetCVar("uh_cw_slot", slot);
	SetCVarString("uh_cw_actor", wepActor);
	return ACS_NamedExecuteWithResult("uh_DefineCopyWep_S");
}

function void FreezeMegaOfficialCopyCount(void)
{
	ACS_NamedExecuteWithResult("uh_FreezeMegaOfficialCopyCount_S");
}

function int GetMegaOfficialCopyCount(void)
{
	return ACS_NamedExecuteWithResult("uh_GetMegaOfficialCopyCount_S");
}

// Add a weighted spawn BGM for an existing boss (stable vanilla id, or id from
// DefineBoss in the same register call). Prefer AddBossMusicByActor for addons.
// weight >= 1. optional: 1 = skipped unless uh_sv_OptionalMusic.
function int AddBossMusic(int bossId, str lump, str credit, int weight, int optional)
{
	SetCVar("uh_bm_bossid", bossId);
	SetCVar("uh_bm_kind", UHMUS_KIND_SPAWN);
	SetCVar("uh_bm_phase", 0);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_credit", credit);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	return ACS_NamedExecuteWithResult("uh_AddBossMusic_S");
}

// Addon-safe: resolve DECORATE class name via UH_FindBossByActor (vanilla or custom).
function int AddBossMusicByActor(str actor, str lump, str credit, int weight, int optional)
{
	int bossId;
	bossId = UH_FindBossByActor(actor);
	if (bossId == UHBOSS_FAIL)
		return UHMUS_FAIL;
	return AddBossMusic(bossId, lump, credit, weight, optional);
}

// Phase-2 / enrage BGM. phase: 0 default; some bosses use 1+ (e.g. CuttyCut).
function int AddBossEnrageMusic(int bossId, int phase, str lump, str credit, int weight, int optional)
{
	SetCVar("uh_bm_bossid", bossId);
	SetCVar("uh_bm_kind", UHMUS_KIND_ENRAGE);
	SetCVar("uh_bm_phase", phase);
	SetCVarString("uh_bm_lump", lump);
	SetCVarString("uh_bm_credit", credit);
	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	return ACS_NamedExecuteWithResult("uh_AddBossMusic_S");
}

function int AddBossEnrageMusicByActor(str actor, int phase, str lump, str credit, int weight, int optional)
{
	int bossId;
	bossId = UH_FindBossByActor(actor);
	if (bossId == UHBOSS_FAIL)
		return UHMUS_FAIL;
	return AddBossEnrageMusic(bossId, phase, lump, credit, weight, optional);
}

// === DefineDemoneye ==========================================================
// id: >=0 vanilla sparse; -1 = auto custom (-1,-2,…).
// mugshot / name / eventStem required. actor may be "" for bonus face-only ids
// (e.g. 100 / 106) that share a base morph class.
// eventStem builds "{stem}_MoolaGiver" / "{stem}_EventD_P" for bonus events.

function int DefineDemoneye(int id, str actor, str name, str prefix, int flags, str mugshot, str eventStem)
{
	SetCVar("uh_de_id", id);
	SetCVarString("uh_de_actor", actor);
	SetCVarString("uh_de_name", name);
	SetCVarString("uh_de_prefix", prefix);
	SetCVar("uh_de_flags", flags);
	SetCVarString("uh_de_mugshot", mugshot);
	SetCVarString("uh_de_eventstem", eventStem);
	return ACS_NamedExecuteWithResult("uh_DefineDemoneye_S");
}


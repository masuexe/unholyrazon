#define UHCOPY_QWANT_FIRE 1
#define UHCOPY_QWANT_WATER 2
#define UHCOPY_QWANT_ELECTRIC 3
#define UHCOPY_QWANT_GRASS 4
#define UHCOPY_QWANT_ICE 5
#define UHCOPY_QWANT_FIGHTING 6
#define UHCOPY_QWANT_POISON 7
#define UHCOPY_QWANT_GROUND 8
#define UHCOPY_QWANT_FLYING 9
#define UHCOPY_QWANT_PSYCHIC 10

// === Shiny move-weapon addon recipe =========================================
// Lets an addon attach CUSTOM psprite-animated moves to the shiny copy classes.
//
// QwantShiny: the move is a WEAPON actor; AltFire GiveInventory + SetWeapon it;
// Select plays the anim, then uh_ShinyMoveReturn switches back and removes it.
//
// NegaManShiny: one HELD weapon per cycle slot (inherit NegaShinyHeldBase_W or
// copy its Charge/SilentSelect). Tap/mid charge fire Fire1/Fire2 on that gun;
// full charge Fire3 then uh_ShinyNegaAdvanceHeld Give/Takes the next slot
// (or buster). Do NOT SetWeapon / MoveReturn per shot; do NOT swap mid-charge.
// Register DefineShinyNegaSlotWep(slot, "YourHeld_W", "", ""); L2/L3 unused.
//
// DecoyBot: M2 roll Gives three held weapons DecoyCopy_<stem>_W1/_W2/_W3 into
// slots 1/2/3. M1 fires the held weapon's Fire state directly. Register with
// DefineDecoyBotMoveWep(stem or *_W / *_W1); table stores the stem.
//
// Move weapon requirements for Qwant (engine-enforced):
// 1. SetWeapon needs CheckAmmo(EitherFire) to pass: either give the weapon
//    an ammo type the class already holds (MyDestinyAmmo) or use NO ammotype
//    with Weapon.AmmoUse 0. +WEAPON.AMMO_OPTIONAL does NOT help SetWeapon.
// 2. Play the animation in Select; make Fire a no-op (A_WeaponReady) so a held
//    fire button does not re-trigger it.
// 3. Call ACS_NamedExecuteWithResult("uh_ShinyMoveColor") on the first Select
//    frame for team coloring.
// 4. After color, call A_WeaponReady(14) (0-tic) before the anim jumps: SetWeapon
//    places the psprite at WEAPONBOTTOM (y=128). Without Raise or a non-zero
//    Offset, sprites stay off-screen for the whole move. A_WeaponReady(14)
//    snaps (sx,sy) to WEAPONTOP; later Offset frames still override as usual.
// 5. End the animation with ACS_NamedExecuteAlways("uh_ShinyMoveReturn_cs")
//    then ACS_NamedExecuteWithResult("uh_ShinyMoveReturn"), then goto Deselect.
//    The _cs script SetWeapon's the parent (from UH_MoveHud_F) so clients have
//    a pending weapon; otherwise A_Lower re-raises the copy, or a TNT1 wait
//    freezes the gun. Server Return still does the authoritative SetWeapon.
// 6. Do not give the move weapon a player.weaponslot entry (slotless).
// 7. No ScriptBar needed: dispatch sets UH_MoveHud_F so BARHNDLE draws the
//    parent shiny weapon bar. Flag cleared in parent SilentSelect.
//
// NegaManShiny held-slot requirements:
// 1. One actor per slot; Weapon.SlotNumber 1; AmmoGive 0; S_NegaDuckAmmo.
// 2. Prefer inherit NegaShinyHeldBase_W (Charge0-2, SilentSelect dye, Fire3End).
// 3. Override Fire1 / Fire2 / Fire3; tap/mid end goto Ready2 (or Fire2End);
//    full-charge end goto Fire3End (Advance) — never MoveReturn.
// 4. Do not mid-charge Give/Take L1→L2→L3; tiers are labels on the same actor.
// 5. Prefer name prefix NegaShiny_ so BARHNDLE remaps the ammo bar to parent.
//
// DecoyBot held-copy requirements:
// 1. Three actors: DecoyCopy_<Name>_W1 / _W2 / _W3 with Weapon.SlotNumber 1/2/3.
// 2. Put the attack animation in Fire (not Select); end with goto Ready2.
// 3. Ammo: DecoyEnergyAmmo, AmmoUse 0, AmmoGive 0; inventory.icon C_I_50A/B/C.
// 4. W2/W3 may inherit W1 and only remap sprites (6H→6I/6J) + SlotNumber/icon.
// 5. Register once: DefineDecoyBotMoveWep("DecoyCopy_YourName_W1") (or stem /
//    *_W); M2 Give appends _W1/_W2/_W3 from the stored stem.
// 6. Optional Shiny partner: inherit DecoyBotShinyCycleBase_W, implement Fire,
//    then DefineDecoyBotShinyWep(the same normal stem, "YourShinyHeld_W").
//    Shiny Decoy M1 fires that actor; M2 cycles paired rows in registration
//    order and skips legacy/addon rows that have no shiny partner.
//
// Recipes:
//   DefineShinyQwantMoveWep("YourMove_W", 3);
//       QwantShiny AltFire flat weighted pool (vanilla 25 moves are already
//       registered at weight 1 each). Your move enters the same roll.
//   DefineShinyNegaSlotWep(26, "YourNegaHeld_W", "", "");
//       NegaManShiny slots 26..33 (vanilla 1..25 already registered). One held
//       actor; Fire1/2/3 on it. Register contiguous from 26.
//   DefineDecoyBotMoveWep("DecoyCopy_YourName_W1");
//       DecoyBot copy slot 59+ (vanilla 0..58 already registered). Uniform in
//       the flag swap pool; ApplyHeldWeps Gives stem_W1/_W2/_W3.
//   DefineDecoyBotShinyWep("DecoyCopy_YourName_W1", "DecoyShiny_YourName_W");
//       Pairs the same row with Shiny Decoy. The shiny actor owns Fire and
//       should inherit DecoyBotShinyCycleBase_W for the standard M2 cycle.
//   DefineShinyMegaCopyWep("ShinyMega_YourStem_P", UH_SHINYMEGA_M1, 5);
//   DefineShinyMegaCopyWep("ShinyMega_YourStem_P", UH_SHINYMEGA_M2, 19);
//   DefineShinyMegaCopyWep("ShinyMega_DawnBreaker_P", UH_SHINYMEGA_TRUE, 1);
//       Shiny MegaMan: flat weighted pool (no game-generation buckets).
//       Fire actor is CustomInventory : ShinyMegaBase_P; Pickup does the attack.
//       M1 = Fire, M2 = AltFire, TRUE = both (same weight). Ordinary moves use
//       weight 5 (M1) / 19 (M2); DawnBreaker stays weight 1.
//
// 1. LOADACS after Unholy: YOUR_SHINYDEFS
// 2. ACS:
//      #library "YOUR_SHINYDEFS"
//      #include "zcommon.acs"
//      #include "UHADD.acs"
//      function void YourRegister(void) {
//          DefineShinyQwantMoveWep("YourMove_W", 3);
//          DefineShinyNegaSlotWep(26, "YourNegaHeld_W", "", "");
//          DefineDecoyBotMoveWep("DecoyCopy_YourName_W1");
//          DefineShinyMegaCopyWep("ShinyMega_YourStem_P", UH_SHINYMEGA_M1, 5);
//      }
//      script "your_define" OPEN {
//          if (!UHInPlay()) terminate;
//          YourRegister();
//      }
//      script "your_define_cs" OPEN CLIENTSIDE {
//          YourRegister();
//      }
// 3. Same (kind, actor) registration again returns the existing row.
// 4. Qwant move weapons are taken on MoveReturn; Nega held actors stay until
//    Advance Give/Takes the next cycle slot.
//
// Slot constants (match UHDT / ConstIntList_Uacsprops.dec):
#define UH_SHINYNEGA_SLOTBASE 26
#define UH_SHINYNEGA_SLOTCOUNT 8
#define UH_DECOY_SLOTBASE 59
#define UH_SHINYMEGA_M1 1
#define UH_SHINYMEGA_M2 2
#define UH_SHINYMEGA_TRUE 3

// QwantShiny AltFire custom move weapon (weight >= 1 recommended).
function int DefineShinyQwantMoveWep(str wepActor, int weight)
{
	SetCVarString("uh_sm_wep", wepActor);
	SetCVar("uh_sm_weight", weight);
	return ACS_NamedExecuteWithResult("uh_DefineShinyQwantMoveWep_S");
}

// NegaManShiny custom held slot (26..33). wepL1 = held actor; pass "" for L2/L3.
function int DefineShinyNegaSlotWep(int slot, str wepL1, str wepL2, str wepL3)
{
	SetCVar("uh_sm_slot", slot);
	SetCVarString("uh_sm_wl1", wepL1);
	SetCVarString("uh_sm_wl2", wepL2);
	SetCVarString("uh_sm_wl3", wepL3);
	return ACS_NamedExecuteWithResult("uh_DefineShinyNegaSlotWep_S");
}

// DecoyBot custom copy slot (slot auto 59+). Pass stem or *_W / *_W1..*_W3;
// table stores stem; M2 Give uses stem_W1/_W2/_W3.
function int DefineDecoyBotMoveWep(str wepActor)
{
	SetCVarString("uh_sm_wep", wepActor);
	return ACS_NamedExecuteWithResult("uh_DefineDecoyBotMoveWep_S");
}

// Pair the normal DecoyBot stem with its Shiny Decoy held weapon. The shiny
// actor owns its Fire animation and must route AltFire to
// uh_DecoyBotShinyAdvance (inherit DecoyBotShinyCycleBase_W or copy its states).
// Calling this also registers the normal stem if it is not registered yet.
function int DefineDecoyBotShinyWep(str wepActor, str shinyWepActor)
{
	SetCVarString("uh_sm_wep", wepActor);
	SetCVarString("uh_sm_shiny", shinyWepActor);
	return ACS_NamedExecuteWithResult("uh_DefineDecoyBotShinyWep_S");
}

// Shiny MegaMan fire CustomInventory. which: UH_SHINYMEGA_M1 / M2 / TRUE.
function int DefineShinyMegaCopyWep(str fireActor, int which, int weight)
{
	SetCVar("uh_sm_kind", which);
	SetCVarString("uh_sm_wep", fireActor);
	SetCVar("uh_sm_weight", weight);
	return ACS_NamedExecuteWithResult("uh_DefineShinyMegaCopyWep_S");
}

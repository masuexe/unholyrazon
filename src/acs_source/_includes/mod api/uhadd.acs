// === DefineUnholyItem ========================================================
// id: >=0 vanilla; -1 = auto custom (-1,-2,…).
// actor / name required. mugshot optional (""). pool = UHITEM_POOL_*.

function int DefineUnholyItem(int id, str actor, str name, int pool, str mugshot)
{
	SetCVar("uh_di_id", id);
	SetCVarString("uh_di_actor", actor);
	SetCVarString("uh_di_name", name);
	SetCVar("uh_di_pool", pool);
	SetCVarString("uh_di_mugshot", mugshot);
	return ACS_NamedExecuteWithResult("uh_DefineUnholyItem_S");
}


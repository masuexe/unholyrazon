// === DefineUnholyItem ========================================================
// id: >=0 vanilla; -1 = auto custom (-1,-2,…).
// actor / name required. mugshot / stingSound optional ("").
// Drops: SetUnholyBox + AddUnholyItemDrop (not on DefineUnholyItem).

function int DefineUnholyItem(int id, str actor, str name, str mugshot, str sound)
{
	SetCVar("uh_di_id", id);
	SetCVarString("uh_di_actor", actor);
	SetCVarString("uh_di_name", name);
	SetCVarString("uh_di_mugshot", mugshot);
	SetCVarString("uh_di_sound", sound);
	return ACS_NamedExecuteWithResult("uh_DefineUnholyItem_S");
}

// Mark a registered item as a rollable container (open / eyedrop sounds).
function int SetUnholyBox(str boxactor, str openSound, str eyedropSound)
{
	SetCVarString("uh_di_boxactor", boxactor);
	SetCVarString("uh_di_opensound", openSound);
	SetCVarString("uh_di_eyedropsound", eyedropSound);
	return ACS_NamedExecuteWithResult("uh_SetUnholyBox_S");
}

// Add a drop row. Same (box, item, giveActor, amt) again accumulates weight.
// stingOverride "" = item DefineUnholyItem sting, except Auto* (non-Silent) giveActor
//   skips that fallback (Auto Use plays its own sound; e.g. Coin → AutoUnholyBook).
// giveActor "" = GiveInventory/Spawn the itemActor itself.
function int AddUnholyItemDrop(str boxactor, str itemActor, int weight, int amt, str stingOverride, str giveActor)
{
	SetCVarString("uh_di_boxactor", boxactor);
	SetCVarString("uh_di_itemactor", itemActor);
	SetCVar("uh_di_weight", weight);
	SetCVar("uh_di_amt", amt);
	SetCVarString("uh_di_sound", stingOverride);
	SetCVarString("uh_di_giveactor", giveActor);
	return ACS_NamedExecuteWithResult("uh_AddUnholyItemDrop_S");
}

// Coin threshold spend (not weighted drop). takeAmt 0 = take all coins.
// Same (minCount, giveActor) again returns existing row (no double entry).
// At use: highest eligible minCount; ties at that tier pick uniformly at random.
// Example empty tier: DefineUnholyCoinSpend(500, 500, "YourItem", "misc/WellDoneMan");
function int DefineUnholyCoinSpend(int minCount, int takeAmt, str giveActor, str sound)
{
	SetCVar("uh_di_mincount", minCount);
	SetCVar("uh_di_amt", takeAmt);
	SetCVarString("uh_di_giveactor", giveActor);
	SetCVarString("uh_di_sound", sound);
	return ACS_NamedExecuteWithResult("uh_DefineUnholyCoinSpend_S");
}


#define UHITEM_BOX_PANDORA 0
#define UHITEM_BOX_MYSTIC 37
#define UHITEM_BOX_TOW 53

// DefineCopyWep kinds / slots
#define UHCOPY_MEGA 1
#define UHCOPY_QWANT 2
#define UHCOPY_NEGA 3

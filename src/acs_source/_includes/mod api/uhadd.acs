	SetCVar("uh_bm_weight", weight);
	SetCVar("uh_bm_optional", optional);
	SetCVar("uh_bm_duration", duration);
	SetCVar("uh_bm_emuflag", emuflag);
	return ACS_NamedExecuteWithResult("uh_AddEventMusic_S");
}


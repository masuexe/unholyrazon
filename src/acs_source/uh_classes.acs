Script "uh_HomingSeekerPushPull" (int LIMIT, int Swapper)
{
	int TargetID = ACS_NamedExecuteWithResult("core_getptrtid",2);
	int TracerID = ACS_NamedExecuteWithResult("core_getptrtid",8);

	if(CheckActorInventory(TracerID,"NoPushFlag")==1){terminate;}

	int force = xyDistance(TargetID,TracerID);

	int forceXYZ = xyzDistance(TargetID,TracerID);

	//Log(s:"FORCE DIST = ",i:force);
	//Log(s:"Swapper = ",i:Swapper);

	//Log(s:" forceXYZ i = ",i:forceXYZ);
	//Log(s:" forceXYZ f = ",f:forceXYZ);

	Switch(Swapper){
		Default:
			break;
		Case 1://Push
			force = max(4,LIMIT+5-forceXYZ/10)*-1;
			break;
		Case -1://Pull
			force = min(LIMIT,forceXYZ/10);
			break;
	}

	//Log(s:"FORCE DIST = ",i:force);
	if(CheckActorInventory(TracerID,"HalfPushFlag")==1){
		force = (force*0.5)>>16;
	}

	actorPull(TargetID, TracerID, force, 0, 0, -12<<16);

	SetResultValue(abs(force));

}

Script "uh_raiderhookshot" (int PlayerID, int Vel, int Moving)
{
	int myx, myy, myz;
	int vx, vy, vz, magnitude, nx, ny, nz;
	int Letgo = false;

	myx = GetActorX(0);
	myy = GetActorY(0);
	myz = GetActorZ(0);

	while(!Letgo)
	{
		if(Moving > 0){//If the hook is set to move, the positions need to be updated.
			myx = GetActorX(0);
			myy = GetActorY(0);
			myz = GetActorZ(0);
		}
		vx = myx - GetActorX(PlayerID);
		vy = myy - GetActorY(PlayerID);
		vz = myz - GetActorZ(PlayerID);

		magnitude = magnitudeThree(vx >> 16, vy >> 16, vz >> 16);

		if(magnitude != 0) {
			nx = vx / magnitude; ny = vy / magnitude; nz = vz / magnitude;
		}
		else {
			nx = 0; ny = 0; nz = 0;
		}

		//if(xyDistance(PlayerID, 0)>1500){Letgo = true;}
		//Thing_Stop(0);
		SetActorVelocity(PlayerID, nx*Vel, ny*Vel, nz*Vel, true, true);
		TakeActorInventory(PlayerID,"HookshotStamina",2-CheckActorInventory(PlayerID,"PlayerPropertyEndlessAmmo"));

		Delay(1);
		if(CheckActorInventory(PlayerID,"RaiderHookRelease_F")||CheckActorInventory(PlayerID,"IsDead")) {Letgo = true;}
		else if(CheckActorInventory(PlayerID,"HookshotStamina") < 1) {
			ActivatorSound("S3_K/MetalSpark",127);
			Letgo = True;
		}
	}
	Delay(1);
	//GiveActorInventory(PlayerID,"YesGravityPickup",1);
	//ACS_NamedExecuteWithResult("core_stopplayer", 0, false);
	TakeActorInventory(PlayerID,"RaiderHookedFlag",9);
	GiveActorInventory(PlayerID,"RaiderHookRelease_F",1);
}

script "uc_TrapistBombJump" (int thrust, int radius, int zOff, int zThrust)
{
	int TargetTID = ACS_NamedExecuteWithResult("core_getptrtid",2);
	int TargetTeam = GetPlayerInfo(TargetTID-1000, PLAYERINFO_TEAM);

	//Log(i:xyzDistance(0, target));PowerPro

	for (int p = 0; p < ServerMAX; p++)
	{
	//Not in game? Skip
		if (!PlayerInGame(p)) {
			continue;
		}
	//If bomb owner, skip this
	// 	if (p+1000 != TargetTID) {
	// 		if (CheckActorInventory(p+1000,"PowerProtectSurvivor")) {
	// 			continue;
	// 		}
	// 	}
	//Is a team game? //Same Teams? Skip
		if (IsTeamGame) {
			if (TargetTeam == GetPlayerInfo(p, PLAYERINFO_TEAM)){
				continue;
			}
		}
	//Within range and can see each other? Thrust them
		if (xyzDistance(0, p+1000) <= radius+16 && CheckSight(0,p+1000,CSF_NOBLOCKALL)) {
			SetResultValue(0);
			actorPullTrapist(0, p+1000, -thrust, zOff<<16, zThrust);
			GiveActorInventory(p+1000,"TrapistThrustWeaken",1);
		}
	}
}
function void actorPullTrapist(int puller, int pullee, int force, int zOff, int zThrust)
{//Edit from actorPull
	int angle = VectorAngle((GetActorX(puller))-GetActorX(pullee), (GetActorY(puller))-GetActorY(pullee));
	int pitch = pitchBetween(puller, pullee, 0, 0, zOff);

	angle = angle >> 8;
	int horizForce = fixedMul(cos(pitch), force<<16)>>16;
	int vertiForce = fixedMul(sin(pitch), force<<16)>>16;
	if(CheckActorInventory(pullee,"TrapistThrustWeaken")){
		zThrust/=2;
		vertiForce/=2;
	}
	ThrustThing(angle, horizForce, 1, pullee);
	ThrustThingZ(pullee, vertiForce*(1+(zThrust == 0)*2) + zThrust*4, 0, 1);
}


script "uc_SamuraiSetUser" (int inputAngle, int inputPitch, int inputLimit)
{
	SetUserVariable(0,"user_wepangle",inputAngle<<16);
	SetUserVariable(0,"user_weppitch",inputPitch<<16);
	SetUserVariable(0,"user_wepaimlimit",inputLimit);
//	Log(f:GetUserVariable(0,"user_wepangle"),s:":user_wepangle:",i:GetUserVariable(0,"user_wepangle"),s:"\n",
//		f:GetUserVariable(0,"user_weppitch"),s:":user_weppitch:",i:GetUserVariable(0,"user_weppitch"),s:"\n",
//		f:GetUserVariable(0,"user_wepaimlimit"),s:":user_wepaimlimit:",i:GetUserVariable(0,"user_wepaimlimit"));
	
}

script "uc_SamuraiCheckDrag" (int inputAngle, int inputPitch, int inputDiff)
{
	inputAngle <<= 16;
	inputPitch <<= 16;
	int changeLimit = GetUserVariable(0,"user_wepaimlimit");
	if(!changeLimit)
		terminate;//This is for online desync? Is it 3.1 only?
	int currentAngle = GetUserVariable(0,"user_wepangle");
	int currentPitch = GetUserVariable(0,"user_weppitch");

	int angleDif = WrapAround(inputAngle - currentAngle);
	int pitchDif = WrapAround(inputPitch - currentPitch);

	int len = getHypotenuse(angleDif, pitchDif);

	if(getHypotenuse(angleDif, pitchDif*2)>>16>=inputDiff){
		SetUserVariable(0,"user_wepangle2",FixedDiv(FixedMul(angleDif,changeLimit),len));
		SetUserVariable(0,"user_weppitch2",FixedDiv(FixedMul(pitchDif,changeLimit),len));
		SetResultValue(2);
	}
	else{
		SetResultValue(-1);
	}
}

str Samurai_user_variables[2] =
{
"user_wepangle",
"user_weppitch"
};


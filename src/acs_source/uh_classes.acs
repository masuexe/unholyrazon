function int max(int m, int n) {
  if (m > n)
    return m;

  return n;
}

function int min(int m, int n) {
  if (m < n)
    return m;

  return n;
}

function int WrapAround(int i) {
  if (i<-180.0) return i+360.0;
  if (i>180.0) return i-360.0;
  return i;
}

function int GetHypotenuse(int x, int y) {
  int len;
  int ang = VectorAngle(x, y);
  if (((ang+0.125)%0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  //print(f:len);
  return len;
}

function int GetMaxPlayers(void) {  // From 8bdmlib.acs
  int ret = GetCVar("sv_MaxClients");
  if (PlayerCount() > ret)//admins can join
    ret = PlayerCount();
  return ret;
}

function int XYZDistance(int tid1, int tid2) {
  int x, y, z, d;
  x = GetActorX(tid1) - GetActorX(tid2) >> 16;
  y = GetActorY(tid1) - GetActorY(tid2) >> 16;
  z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  d = sqrt8( x*x + y*y + z*z );
  return d;
}

function int XYDistance(int tid1, int tid2) {
  int x, y, d;
  x = GetActorX(tid1) - GetActorX(tid2) >> 16;
  y = GetActorY(tid1) - GetActorY(tid2) >> 16;
  d = sqrt8( x*x + y*y );
  return d;
}

function int ZDistance(int tid1, int tid2) {
  int z;
  z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  return z;
}

function int MagnitudeThree(int x, int y, int z) {
  return sqrt8(x*x + y*y + z*z);
}

function int abs(int x) {
  if (x < 0)
    return -x;

  return x;
}

function int sqrt8(int number) {
  if (number <= 3) {
    if (number > 0) {
      return 1;
    }
    return 0;
  }

  int oldans = number >> 1;
  int newans = (oldans + number / oldans) >> 1;

  while(newans < oldans) {
    oldans = newans;
    newans = (oldans + number / oldans) >> 1;
  }

  return oldans;
}


function void ActorPull(int puller, int pullee, int force, int xoff, int yoff, int zoff) {
  int angle = VectorAngle((GetActorX(puller)+xoff)-GetActorX(pullee), (GetActorY(puller)+yoff)-GetActorY(pullee));
  int pitch = PitchBetween(puller, pullee, xoff, yoff, zoff);

  angle = angle >> 8;
  int horizforce = FixedMul(cos(pitch), force<<16)>>16;
  int vertiforce = FixedMul(sin(pitch), force<<16)>>16;

  ThrustThing(angle, horizforce, horizforce>30, pullee);
  ThrustThingZ(pullee, vertiforce*4, 0, 0);
}

function int PitchBetween(int looker, int target, int xoff, int yoff, int zoff) {
  int x, y, z, ang, pitch, len;
  x = (GetActorX(target) + xoff) - GetActorX(looker);
    y = (GetActorY(target) + yoff) - GetActorY(looker);

  ang = VectorAngle(x, y);
  if (((ang+0.125)%0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  z = (GetActorZ(target) - zoff) - GetActorZ(looker);

  pitch = -VectorAngle(len, z);
  return pitch;
}

function void SetInventory(str item, int amount) {
  int diff = amount - CheckInventory(item);
  if (diff > 0)
    GiveInventory(item, diff);
  else if (diff < 0)
    TakeInventory(item, -diff);
}

function void GiveMeTheFunc(str hungry, int thebill) {
  if (thebill == 0) {thebill = 1;}

  if (thebill < 0) {
    for (int i; i < ServerMAX; i++) {
      if (PlayerInGame(i)) {TakeActorInventory(i + 1000, hungry, -thebill);}
    }
  }
  else {
    for (int j; j < ServerMAX; j++) {
      if (PlayerInGame(j)) {GiveActorInventory(j + 1000, hungry, thebill);}
    }
  }
}

function int Round(int x) {
	return (x + 0.5) >> 16;
}

#define CONVERTTEARS_FIRE2TEARS 0
#define CONVERTTEARS_TEARS2FIRE 1
function int ConvertTears(int value, int swap) { // 0 = fire rate -> tears, 1 = tears -> fire rate
  int res;
  switch (swap) {
    case CONVERTTEARS_FIRE2TEARS:
      res = Round(FixedDiv(300, (value + 1)));
      break;
    case CONVERTTEARS_TEARS2FIRE:
      res = Round(FixedDiv(300, value)) - 1;
      break;
  }
  return res;
}

function void SyncEdenTears(int swap) {
  switch (swap) {
    case CONVERTTEARS_FIRE2TEARS:
      SetInventory("EdenTearsHUDAttr", ConvertTears(CheckInventory("EdenTearsAttr"), CONVERTTEARS_FIRE2TEARS));
      break;
    case CONVERTTEARS_TEARS2FIRE:
      SetInventory("EdenTearsAttr", ConvertTears(CheckInventory("EdenTearsHUDAttr"), CONVERTTEARS_TEARS2FIRE));
      break;
  }
}

function void UpdateEdenAttr(int attr, int value, bool set, bool hud) {
  int realvalue;
  switch (attr) {
    default:
      Log(s:"Unknown Eden attribute: ", i:attr);
      break;
    case 0: // Speed
      if (set) {
        SetInventory("EdenSpeedAttr", value);
        SetActorProperty(0, APROP_Speed, FixedDiv(value, 10));
      } else {
        if (value > 0) {
          GiveInventory("EdenSpeedAttr", value);
        } else if (value < 0) {
          TakeInventory("EdenSpeedAttr", -value);
        }
        SetActorProperty(0, APROP_Speed, GetActorProperty(0, APROP_Speed) + FixedDiv(value, 10));
      }
      break;
    case 1: // Height
      realvalue = value << 16;
      if (set) {
        SetInventory("EdenHeightAttr", value);
        SetActorProperty(0, APROP_JumpZ, realvalue);
      } else {
        if (value > 0) {
          GiveInventory("EdenHeightAttr", value);
        } else if (value < 0) {
          TakeInventory("EdenHeightAttr", -value);
        }
        SetActorProperty(0, APROP_JumpZ, GetActorProperty(0, APROP_JumpZ) + realvalue);
      }
      break;
    case 2: // Tears
      if (hud == 0) {
        if (set) {
          SetInventory("EdenTearsAttr", value);
          SetInventory("EdenTearsHUDAttr", ConvertTears(value, CONVERTTEARS_FIRE2TEARS));
        } else {
          if (value > 0) {
            GiveInventory("EdenTearsAttr", value);
          } else if (value < 0) {
            TakeInventory("EdenTearsAttr", -value);
          }
          SyncEdenTears(CONVERTTEARS_FIRE2TEARS);
        }
      } else {
        if (set) {
          SetInventory("EdenTearsHUDAttr", value);
          SetInventory("EdenTearsAttr", ConvertTears(value, CONVERTTEARS_TEARS2FIRE));
        } else {
          if (value > 0) {
            GiveInventory("EdenTearsHUDAttr", value);
          } else if (value < 0) {
            TakeInventory("EdenTearsHUDAttr", -value);
          }
          SyncEdenTears(CONVERTTEARS_TEARS2FIRE);
        }
      }
      break;
    case 3: // Damage
      if (set) {
        SetInventory("EdenDamageAttr", value);
      } else {
        if (value > 0) {
          GiveInventory("EdenDamageAttr", value);
        } else if (value < 0) {
          TakeInventory("EdenDamageAttr", -value);
        }
      }
      break;
    case 4: // Shot Speed
      if (set) {
        SetInventory("EdenShotSpeedAttr", value);
      } else {
        if (value > 0) {
          GiveInventory("EdenShotSpeedAttr", value);
        } else if (value < 0) {
          TakeInventory("EdenShotSpeedAttr", -value);
        }
      }
      break;
    case 5: // Range
      if (set) {
        SetInventory("EdenRangeAttr", value);
      } else {
        if (value > 0) {
          GiveInventory("EdenRangeAttr", value);
        } else if (value < 0) {
          TakeInventory("EdenRangeAttr", -value);
        }
      }
      break;
  }
}

// Void: consume all DefineUnholyItem except coins → random Eden attrs (razon3 rz_VoidConsuming).
function int VoidConsumeActor(str actor)
{
  int count = CheckInventory(actor);
  if (count <= 0)
    return 0;
  if (StrICmp(actor, "DLC_CoinItem") == 0)
    return 0;
  if (StrCmp(actor, "SuperGUHUItem") == 0 && CheckInventory("SuperGuhuDoomFlag"))
    count--;
  if (count <= 0)
    return 0;
  TakeInventory(actor, count);
  return count;
}

script "rz_VoidConsuming" (void)
{
  int itemcount;
  int i;
  int id;
  int slot;
  int plus;
  int attrplus[6];

  itemcount = 0;
  for (i = 0; i < 6; i++)
    attrplus[i] = 0;

  for (id = 0; id < UH_MAX_VANILLA_ITEM; id++)
  {
    if (uh_itemVanillaDefined[id] == 0)
      continue;
    itemcount += VoidConsumeActor(uh_itemVanillaStr[id][UHITEM_STR_ACTOR]);
  }
  for (i = 0; i < uh_itemCustomCount; i++)
    itemcount += VoidConsumeActor(uh_itemCustomStr[i][UHITEM_STR_ACTOR]);

  if (itemcount <= 0)
    terminate;

  PlaySound(0, "Isaac/voidconsumed");

  for (i = 0; i < itemcount * 2; i++)
  {
    slot = random(0, 5);
    switch (slot)
    {
      case 0: plus = 2; break;
      case 1: plus = 1; break;
      case 2: plus = 5; break;
      case 3: plus = 20; break;
      case 4: plus = 10; break;
      case 5: plus = 10; break;
      default: plus = 0; break;
    }
    attrplus[slot] += plus;
  }
  for (i = 0; i < 6; i++)
    UpdateEdenAttr(i, attrplus[i], false, true);
}

// Cap must match UHEDENISAAC.acs.
#define EDEN_ISAAC_MAIN_CAP 32

int eden_normal_main_idx[EDEN_ISAAC_MAIN_CAP];
int eden_normal_main_count = 0;

#define EDEN_MAIN_COUNT_BUCKETS 5
// Index = item count 0..4; bell curve — peaks at 2/3, tails at 0/4.
int eden_main_count_weight[EDEN_MAIN_COUNT_BUCKETS] = {10, 20, 30, 30, 10};

function void EdenClearMainSlots(void) {
  SetInventory("EdenItemSlot1", 0);
  SetInventory("EdenItemSlot2", 0);
  SetInventory("EdenItemSlot3", 0);
  SetInventory("EdenItemSlot4", 0);
}

function int EdenRollMainItemCount(int poolsize) {
  int maxcount = min(4, poolsize);
  int bucketcount = maxcount + 1;
  int total;
  int roll;
  int acc;
  int i;

  if (bucketcount <= 0) {
    return 0;
  }

  total = 0;
  for (i = 0; i < bucketcount; i++) {
    total += eden_main_count_weight[i];
  }

  roll = Random(0, total - 1);
  acc = 0;
  for (i = 0; i < bucketcount; i++) {
    acc += eden_main_count_weight[i];
    if (roll < acc) {
      return i;
    }
  }
  return maxcount;
}

function int EdenFindEquippedAlt(void) {
  int i;
  for (i = 0; i < edenisaac_alt_count; i++) {
    if (CheckInventory(StrParam(s:"C", i:edenisaac_alt_id[i], s:"Flag"))) {
      return i;
    }
  }
  return -1;
}

script "rz_EdenAltAmmoCost" (void) {
  int i = EdenFindEquippedAlt();
  int cost = 300;
  if (i >= 0) {
    cost = edenisaac_alt_ammo[i];
  }
  if (CheckInventory("PowerEndlessAmmoRune")) {
    cost = cost / 2;
  }
  SetResultValue(cost);
}

// C042 can only hold two Bob bombs.  This gate is checked before Eden_W
// spends active charge, so pressing M2 at full stock is a true no-op.
script "rz_EdenCanUseAlt" (void) {
  int i = EdenFindEquippedAlt();
  if (i >= 0 && edenisaac_alt_id[i] == 42 && CheckInventory("BobHeadFlag") >= 2) {
    SetResultValue(0);
    terminate;
  }
  if (i >= 0 && edenisaac_alt_id[i] == 396 &&
      !ACS_NamedExecuteWithResult("core_CheckFooting")) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

function int EdenNormalizeAngle(int value) {
  while (value < 0) {
    value += 1.0;
  }
  while (value > 1.0) {
    value -= 1.0;
  }
  return value;
}

// C396 Ventricle Razor teleport. The calling portal targets the player who
// entered its radius; preserve the source momentum while rotating it by the
// difference between the two portal angles.
script "rz_RazorTeleport" (int totid, int thrustspeed) {
  int momx;
  int momy;
  int nmomx;
  int nmomy;
  int oldangle;
  int newangle;
  int deltaangle;
  int momangle;

  SetActivatorToTarget(0);

  momx = GetActorVelX(0);
  momy = GetActorVelY(0);
  oldangle = GetActorAngle(0);
  newangle = GetActorAngle(totid);
  momangle = VectorAngle(momx, momy);

  deltaangle = EdenNormalizeAngle(oldangle - newangle);
  momangle = EdenNormalizeAngle(momangle - deltaangle);

  nmomx = FixedMul(cos(momangle), abs(momx)) + FixedMul(cos(momangle), abs(momy));
  nmomy = FixedMul(sin(momangle), abs(momy)) + FixedMul(sin(momangle), abs(momx));

  TakeInventory("JumpCancler", 1);
  SetActorState(totid, "End");
  SetActorPosition(0, GetActorX(totid), GetActorY(totid), GetActorZ(totid), 0);
  SetActorVelocity(0, nmomx, nmomy, 0, false, false);
  SetActorAngle(0, GetActorAngle(totid));
  ThrustThingZ(0, thrustspeed, 0, 0);
}

// Server-side lifetime watcher for C042's hand-bomb warpers.  The base game
// uses the same pattern for Deep Digger so the visual actor is removed even
// when inventory state changes on the server or the owner dies/disconnects.
script "rz_EdenBobHeadWarper" (int left) {
  int player = ACS_NamedExecuteWithResult("core_gettarget", 0);

  while (GetActorProperty(player, APROP_HEALTH) > 0 &&
         CheckActorInventory(player, "BobHeadFlag") > 0 &&
         (CheckActorInventory(player, "BobHeadFlag") >= 2 ||
          (left == 0 && CheckActorInventory(player, "BobHeadLeft_F") == 0) ||
          (left == 1 && CheckActorInventory(player, "BobHeadLeft_F") > 0))) {
    Delay(1);
  }

  Thing_Remove(0);
}

script "rz_EdenUseAlt" (void) {
  int i;
  int hasBattery;

  i = EdenFindEquippedAlt();
  if (i < 0) {
    terminate;
  }

  // Eden_W has already paid the active item's one use cost. Car Battery
  // copies the effect, not the cost. If the first activation removes the
  // battery, the second activation is skipped as in the original behavior.
  hasBattery = CheckInventory("C356Flag");
  GiveInventory(edenisaac_alt_pickup[i], 1);
  if (hasBattery && CheckInventory("C356Flag")) {
    GiveInventory(edenisaac_alt_pickup[i], 1);
  }
}

// Standard Zandronum damage-event hook. Addons can compose with this by
// declaring their own uniquely named EVENT script; no ClassPain override is
// needed. The event activator is the damage target, and this script never
// changes the shared damage result.
script "rz_EdenPiggyBankDamage" (int evt, int dmg, int dmgtype) EVENT {
  int effectivedamage;
  if (evt != GAMEEVENT_ACTOR_DAMAGED || dmg <= 0)
    terminate;
  if (PlayerNumber() < 0 || !CheckInventory("C227Flag") || CheckInventory("IsDead"))
    terminate;

  // GAMEEVENT_ACTOR_DAMAGED runs after armor. Read the current shared result
  // so earlier shield/damage EVENT scripts can cancel or modify the hit.
  effectivedamage = GetEventResult();
  if (effectivedamage <= 0)
    terminate;
  // razon3's ClassPain implementation did not run on lethal hits. Preserve
  // that LMS-safe behavior, while allowing a Buddha-protected hit to proc.
  if (!CheckInventory("PlayerPropertyBuddha") &&
      GetActorProperty(0, APROP_Health) <= effectivedamage)
    terminate;

  GiveInventory("EdenPiggyBankHit_P", 1);
}

function bool EdenDamageTypeIsBomb(str dmgtype) {
  int i;
  int len = StrLen(dmgtype);
  for (i = 0; i <= len - 4; i++) {
    if (StrICmp(StrMid(dmgtype, i, 4), "Bomb") == 0)
      return true;
  }
  return false;
}

// Curse of the Tower composes with other damage EVENT hooks and never changes
// their shared damage result. Bomb damage is excluded so its own Troll Bombs
// cannot recursively create another wave.
script "rz_EdenCurseTowerDamage" (int evt, int dmg, int dmgtype) EVENT {
  int effectivedamage;
  if (evt != GAMEEVENT_ACTOR_DAMAGED || dmg <= 0)
    terminate;
  if (PlayerNumber() < 0 || !CheckInventory("C371Flag") || CheckInventory("IsDead"))
    terminate;
  if (CheckInventory("PowerC371Cooldown") || EdenDamageTypeIsBomb(dmgtype))
    terminate;

  effectivedamage = GetEventResult();
  if (effectivedamage <= 0)
    terminate;
  if (!CheckInventory("PlayerPropertyBuddha") &&
      GetActorProperty(0, APROP_Health) <= effectivedamage)
    terminate;

  GiveInventory("EdenCurseTowerHit_P", 1);
  GiveInventory("PowerC371Cooldown", 1);
}

function bool EdenDamoclesSelfDmg(str dmgtype) {
  if (!StrICmp(dmgtype, "GiveUpHope") ||
      !StrICmp(dmgtype, "SuperGiveUpHope") ||
      !StrICmp(dmgtype, "FortuneCoin") ||
      !StrICmp(dmgtype, "OnFireB") ||
      !StrICmp(dmgtype, "Damocles"))
    return true;

  if (IsPointerEqual(AAPTR_DAMAGE_TARGET, AAPTR_DAMAGE_SOURCE))
    return true;

  // Eden's own bomb actors can be ownerless during A_Explode, so the
  // source==target check above is not sufficient for C371/Anarchist bombs.
  if (SetActivator(0, AAPTR_DAMAGE_INFLICTOR)) {
    if (CheckActorClass(0, "EdenBomb")) {
      SetActivator(0, AAPTR_DAMAGE_TARGET);
      return true;
    }
    SetActivator(0, AAPTR_DAMAGE_TARGET);
  }
  return false;
}

// C577 keeps razon3's escalating risk, but uses hit count rather than lost
// health: the first hit gives 4/20000 per check and every later hit adds one
// unit (a 25% increase over the first-hit risk).
script "rz_EdenDamoclesDamage" (int evt, int dmg, int dmgtype) EVENT {
  int effectivedamage;
  int risk;

  if (evt != GAMEEVENT_ACTOR_DAMAGED || dmg <= 0)
    terminate;
  if (PlayerNumber() < 0 || !CheckInventory("C577Flag") ||
      !CheckInventory("EdenDamoclesActive_F") || CheckInventory("IsDead"))
    terminate;
  if (GetActorProperty(0, APROP_Invulnerable))
    terminate;
  if (EdenDamoclesSelfDmg(dmgtype))
    terminate;

  effectivedamage = GetEventResult();
  if (effectivedamage <= 0)
    terminate;
  if (!CheckInventory("PlayerPropertyBuddha") &&
      GetActorProperty(0, APROP_Health) <= effectivedamage)
    terminate;

  risk = CheckInventory("EdenDamoclesRisk");
  if (risk <= 0)
    GiveInventory("EdenDamoclesRisk", 4);
  else
    GiveInventory("EdenDamoclesRisk", 1);
}

// Called by the server-side watcher while its target is the Eden player.
script "rz_EdenDamoclesShouldFall" (void) {
  int risk;
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  if (PlayerNumber() < 0 || CheckInventory("IsDead") ||
      !CheckInventory("EdenDamoclesActive_F")) {
    SetResultValue(0);
    terminate;
  }
  risk = CheckInventory("EdenDamoclesRisk");
  if (risk > 0 && Random(1, 20000) <= risk)
    SetResultValue(1);
  else
    SetResultValue(0);
}

script "rz_EdenDamoclesKill" (void) {
  if (PlayerNumber() < 0 || CheckInventory("IsDead") ||
      GetActorProperty(0, APROP_Health) <= 0)
    terminate;
  Thing_Damage2(0, 30000, "Damocles");
}


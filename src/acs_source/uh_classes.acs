script "uc_countinv_acs" (int Which, int Pointer)
{
	if(Pointer>0){
		SetActivator(0,Pointer);
	}
	int Counter = 0;
	switch(Which)
	{
		Default:
			break;
		Case 0:
			Counter = CheckInventory("MegaManSColor_F");
			break;
		Case 100:
			Counter = CheckInventory("NoiseCrushCaughtU");
			break;
		Case 1:
			Counter = CheckInventory("HiddenPowerDamageFlag");
			break;
		Case 2:
			Counter = CheckInventory("NegaMM1_Flag");
			break;
		Case 14:
			Counter = CheckInventory("PansyEscapeAmmo");
			break;
		Case 23:
			Counter = CheckInventory("StealthyAmmo");
			break;
		Case 25:
			Counter = CheckInventory("DrunkEnergyAmmo");
			break;
		Case 32:
			Counter = CheckInventory("RamesesCurseFlag");
			break;
		Case 35:
			Counter = CheckInventory("SiteWorkerTetris_F");
			break;
		Case -35:
			Counter = CheckInventory("SiteWorkerSaved_F");
			break;
		Case 36:
			Counter = CheckInventory("SUBALUWAAmmo");
			break;
		case 58:
			Counter = CheckInventory("KickChamp_DiveComboFlag");
			break;
	}
	SetResultValue(Counter);
}

script "rz_AirManWarp" (void) {
  bool res = 0;
  int retrycount = 0;
  int warptotid = -1;
  do {
    warptotid = ACS_NamedExecuteWithResult("rz_RandomPlayerTID", 0, 4);
    retrycount++;
    if (warptotid == -1) {
      break;
    }
    res = Warp(warptotid, Random(-128, 128) << 16, Random(-128, 128) << 16, Random(16, 32) << 16, 0, WARPF_USECALLERANGLE);
  } while (!res && retrycount < 64);
}

script "rz_SinfulBusterExpertSinWatcher" (void) {
  int tid = ActivatorTID();
  int maxhp = GetActorProperty(tid, APROP_SpawnHealth);
  if (maxhp <= 0) {
    terminate;
  }
  int step = maxhp * 6 / 10 / 7;
  int given = 0;
  while (!CheckInventory("IsDead") && !CheckInventory("IsAFakeBoss")) {
    int hp = GetActorProperty(tid, APROP_Health);
    while (given < 7 && hp <= maxhp - (given + 1) * step) {
      given++;
      GiveInventory(StrParam(s:"SinfulBusterExpert_W", i:given + 1), 1);
      PlaySound(0, "misc/eclipsegravitywellsummon", CHAN_AUTO);
    }
    Delay(1);
  }
}

function bool HealthHasDigit(int hp, int digit) {
  if (hp <= 0)
    return false;
  while (hp > 0) {
    if ((hp % 10) == digit)
      return true;
    hp /= 10;
  }
  return false;
}

// Activator: GBeast_EraseCross (or Fury) on Crash — HPBug + digit-4 bonus
script "rz_EraseCrossHit" (void) {
  int tracer = ACS_NamedExecuteWithResult("core_gettracer");
  int owner = ACS_NamedExecuteWithResult("core_gettarget");
  if (tracer <= 0)
    terminate;

  ACS_NamedExecuteWithResult("rz_HpBugPlayer", tracer - 999, 1);

  int hp = GetActorProperty(tracer, APROP_Health);
  if (HealthHasDigit(hp, 4))
    ACS_NamedExecuteWithResult("core_damageactor", "GBeast_EraseBonusDamager", 444, tracer, owner);
}


script "rz_TimemanCLoliPornSpawner" (void) {
  int self = ActivatorTID();
  int chosen = 0;
  int count = 0;
  int tid;

  for (int i = 0; i < ServerMAX; i++) {
    if (!PlayerInGame(i) || PlayerIsSpectator(i)) {
      continue;
    }
    tid = 1000 + i;
    if (tid == self) {
      continue;
    }
    if (!ACS_NamedExecuteWithResult("uh_IsPlayerAlive", tid)) {
      continue;
    }
    if (CheckActorInventory(tid, "Is_UH_BossNum")) {
      continue;
    }
    count++;
    if (random(1, count) == 1) {
      chosen = tid;
    }
  }
  if (chosen > 0) {
    GiveActorInventory(chosen, "LoliPornPicItem", 1);
  }
}


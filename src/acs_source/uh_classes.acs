script "uh_CriticalHitRng" (int evt, int dmg, int dmgtype) EVENT {
  if (evt == GAMEEVENT_ACTOR_DAMAGED) {
    if (!StrICmp(dmgtype, "BlazeKick") && Random(1, 24) <= 1) {
      GiveInventory("CriticalPain_P", 1);
      SetResultValue(dmg * 2);
    }
  }
}

script "Unholy_BeginTimeStopper" (int SwapCheck) {
  if (SwapCheck) {
    if (time_is_stopped || GetGameModeState()==1)//Countdown
      SetResultValue(0);
  }
  else if (!time_is_stopped) {
    int id = ActivatorTID();
    SetActivator(0);
    time_is_stopped = id-999;
    Delay(2);

    if (GetActorProperty(id, APROP_Health)>0)
      GiveActorInventory(id, "UnholyTimeStopperFreezer", 1);

    GiveInventory("TS_CameraControl_P", 1);

    Delay(1);

    //AmbientSound("", 127);

    SetHudSize(256,224, 0);
    SetFont("FLASHS");
    HudMessageBold(s:"A"; 0,50,-1,256.0, 112.0,3.45);

    int TimeStopDelay = 120;

    while(CheckActorInventory(id, "PowerTimeStopperUFreezer") && TimeStopDelay > 0 && GetGameModeState()!=1) {
      TimeStopDelay--;
      Delay(1);
    }

    HudMessageBold(s:""; 0,50,-1, 0.99, 0.01, 1873);
    TakeActorInventory(id, "PowerTimeStopperUFreezer", 1);
    Delay(10);

    time_is_stopped = 0;
  }
}

script "Unholy_TS_ClientSnd" (void) CLIENTSIDE
{
  //LocalAmbientSound("weapon/timestopper", 127);
}

script "Unholy_TS_CamWatch" (void) //TSCameraControl Watcher
{
  ACS_NamedExecuteAlways("Unholy_TS_ClientSnd", 0);
  if (PlayerNumber() == -1 || CheckInventory("IsDead") || !PlayerInGame(PlayerNumber()))
    terminate;
  if (IsTeamGame)
    if (GetPlayerInfo(time_is_stopped - 1, PLAYERINFO_TEAM) == GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM))
      terminate;

  GiveInventory("TSCameraControlFlag", 1);
  ACS_NamedExecuteAlways("Unholy_TS_ClientCameraControl", 0, 0);

  do {
    Delay(1);
  } while (GetActorProperty(0, APROP_Health) > 0 && time_is_stopped);

  TakeInventory("TSCameraControlFlag", 1);
}

script "Unholy_TS_ClientCameraControl" (int which) CLIENTSIDE //TimeStop Camera Control
{
  switch (which) {
  case 0:  // Actual TimeStopperWep
    do {
      if (!CheckInventory("PowerTimeStopperUFreezer")) {
        SetActorAngle(0, GetActorAngle(0)+GetPlayerInput(-1, INPUT_YAW));
        SetActorPitch(0, GetActorPitch(0)-GetPlayerInput(-1, INPUT_PITCH));
      }
      Delay(1);
    } while (CheckInventory("TSCameraControlFlag"));
  break;
  }
}

// Script called by Deep Digger
Script "uh_ShieldWarper_DeepDiggerU" (int left, int amount) CLIENTSIDE {
  int player = ACS_NamedExecuteWithResult("core_gettarget", 0);
  str checkactor = "DeepDiggerFlagL";
  if (!left) {
    checkactor = "DeepDiggerFlagR";
  }
  while (GetActorProperty(player, APROP_Health) > 0 &&
      CheckActorInventory(player, checkactor) >= amount) {
    Delay(1);
  }
  Thing_Remove(0);
}

Script "uc_AnchorShot_mob" (int vel) {
  int nx, ny, nz;

  int myx = GetActorX(0);
  int myy = GetActorY(0);
  int myz = GetActorZ(0);

  int playerid = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);

  int vx = myx - GetActorX(playerid);
  int vy = myy - GetActorY(playerid);
  int vz = myz - (GetActorZ(playerid) + 28 << 16);

  int magnitude = MagnitudeThree(vx >> 16, vy >> 16, vz >> 16);

  if (magnitude != 0) {
    nx = vx / magnitude;
    ny = vy / magnitude;
    nz = vz / magnitude;
  }
  else {
    nx = 0;
    ny = 0;
    nz = 0;
  }
  SetActorvelocity(playerid, nx*vel, ny*vel, nz*vel, true, true);
}


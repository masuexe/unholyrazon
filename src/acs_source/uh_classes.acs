  if (CheckInventory("EdenIpecacDeath_F")) {
    GiveInventory("EdenIpecacDeath_P", 1);
    SetResultValue(1);
    terminate;
  }
  SetResultValue(0);
}

// Pending Ipecac poison shooter TID per victim player number (0 if none).
int edenipecac_shootertid[64];

script "rz_EdenIpecacMarkShooter" (void) {
  int shooter;
  int sx;
  int sy;
  int sz;
  int p;
  int tid;
  int dx;
  int dy;
  int dz;
  int dist;
  int radius;

  shooter = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  if (shooter == 0)
    shooter = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
  if (shooter < 1000 || shooter > 1063) {
    SetResultValue(0);
    terminate;
  }

  sx = GetActorX(0);
  sy = GetActorY(0);
  sz = GetActorZ(0);
  radius = 140.0;

  for (p = 0; p < 64; p++) {
    edenipecac_shootertid[p] = 0;
    if (!PlayerInGame(p))
      continue;
    tid = p + 1000;
    if (tid == shooter)
      continue;
    if (CheckActorInventory(tid, "IsDead"))
      continue;
    if (IsTeamGame &&
        GetPlayerInfo(p, PLAYERINFO_TEAM) == GetPlayerInfo(shooter - 1000, PLAYERINFO_TEAM))
      continue;
    dx = GetActorX(tid) - sx;
    dy = GetActorY(tid) - sy;
    dz = GetActorZ(tid) - sz;
    dist = VectorLength(VectorLength(dx, dy), dz);
    if (dist > radius)
      continue;
    edenipecac_shootertid[p] = shooter;
  }
  SetResultValue(1);
}

script "rz_EdenIpecacShouldPoison" (void) {
  int pn = PlayerNumber();
  if (pn < 0 || pn >= 64 || edenipecac_shootertid[pn] == 0)
    SetResultValue(0);
  else
    SetResultValue(1);
}

script "rz_EdenIpecacSpawnDoT" (void) {
  int pn = PlayerNumber();
  int victim;
  int shooter;
  int u;

  if (pn < 0 || pn >= 64) {
    terminate;
  }
  shooter = edenipecac_shootertid[pn];
  edenipecac_shootertid[pn] = 0;
  if (shooter < 1000 || shooter > 1063) {
    terminate;
  }
  victim = ActivatorTID();
  if (victim == 0) {
    victim = pn + 1000;
  }

  u = UniqueTID();
  if (!SpawnForced("EdenIpecacPoisonDoT", GetActorX(0), GetActorY(0), GetActorZ(0) + 28.0, u, 0)) {
    terminate;
  }
  SetActivator(u);
  SetPointer(AAPTR_TARGET, shooter);
  SetPointer(AAPTR_TRACER, victim);
}

script "rz_EdenApplyPassiveStats" (void) {
  EdenApplyMainPassives();
}

#define EDENATTR_TEARS 1
#define EDENATTR_DAMAGE 2
#define EDENATTR_SHOTSPEED 3
#define EDENATTR_LUCK 4
#define EDENATTR_RANGE 5

script "rz_GetEdenAttr" (int pointer, int attr, int hud, int useplayer) {
  if (useplayer) {
    SetActivatorToPlayer(pointer);
  }
  else if (pointer > 0) {
    SetActivator(0, pointer);
  }

  switch (attr) {
    case EDENATTR_TEARS:
      if (hud) {
        SetResultValue(CheckInventory("EdenTearsHUDAttr"));
      }
      else {
        SetResultValue(CheckInventory("EdenTearsAttr"));
      }
      break;
    case EDENATTR_DAMAGE:
      SetResultValue(CheckInventory("EdenDamageAttr"));
      break;
    case EDENATTR_SHOTSPEED:
      SetResultValue(CheckInventory("EdenShotSpeedAttr"));
      break;
    case EDENATTR_LUCK:
      SetResultValue(CheckInventory("EdenLuckAttr"));
      break;
    case EDENATTR_RANGE:
      SetResultValue(CheckInventory("EdenRangeAttr"));
      break;
  }
}

// Repentance Brimstone + Ipecac ignores Ipecac's flat damage and fire-delay
// penalties while retaining every other Eden stat change.
script "rz_GetEdenBrimstoneAttr" (int pointer, int attr) {
  int value;
  if (pointer > 0) {
    SetActivator(0, pointer);
  }

  switch (attr) {
    case EDENATTR_TEARS:
      value = CheckInventory("EdenTearsAttr");
      if (CheckInventory("C149Flag"))
        value = max(1, value - 12);
      break;
    case EDENATTR_DAMAGE:
      value = CheckInventory("EdenDamageAttr");
      if (CheckInventory("C149Flag"))
        value = max(1, value - 70);
      break;
    case EDENATTR_SHOTSPEED:
      value = CheckInventory("EdenShotSpeedAttr");
      break;
    case EDENATTR_LUCK:
      value = CheckInventory("EdenLuckAttr");
      break;
    case EDENATTR_RANGE:
      value = CheckInventory("EdenRangeAttr");
      break;
  }
  SetResultValue(value);
}

script "rz_EdenBrimstoneOwnerOK" (void) {
  int pn;
  if (!SetActivator(0, AAPTR_TARGET)) {
    SetResultValue(0);
    terminate;
  }
  pn = PlayerNumber();
  if (pn < 0 || !PlayerInGame(pn) || CheckInventory("IsDead") || GetActorProperty(0, APROP_Health) <= 0) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

// razon3 D8: 5 uniforms → clamp-sum to ~2.5 → mul in [0.5,2] → set attrs from D8Init*
script "rz_D8Rolling" (void) {
  str attrinv[5] = {"EdenSpeedAttr", "EdenHeightAttr", "EdenTearsHUDAttr", "EdenDamageAttr", "EdenRangeAttr"};
  str d8init_attrinv[5] = {"EdenD8InitSpeedAttr", "EdenD8InitHeightAttr", "EdenD8InitTearsAttr", "EdenD8InitDamageAttr", "EdenD8InitRangeAttr"};
  int attr[5];
  int temp[5];
  int i, j;
  for (i = 0; i < 5; i++) {
    if (CheckInventory("D8InitFlag") == 0) {
      GiveInventory(d8init_attrinv[i], CheckInventory(attrinv[i]));
    }
    temp[i] = random(0.0, 1.0);
  }
  GiveInventory("D8InitFlag", 1);

  int tempsum = temp[0] + temp[1] + temp[2] + temp[3] + temp[4];
  int tempx;
  for (i = 0; i < 5; i++) {
    tempx = (2.5 - tempsum) / 5.0;
    for (j = 0; j < 5; j++) {
      temp[j] = min(1.0, max(0.0, temp[j] + tempx));
    }
    tempsum = temp[0] + temp[1] + temp[2] + temp[3] + temp[4];
  }

  int attrmul[5];
  for (i = 0; i < 5; i++) {
    attrmul[i] = temp[i] + max(temp[i], 0.5);
    attr[i] = Round(attrmul[i] * CheckInventory(d8init_attrinv[i]));
    UpdateEdenAttr(i == 4 ? 5 : i, attr[i], true, true);
  }
}

function int max(int m, int n) {
  if (m > n)
    return m;

  return n;
}

function int min(int m, int n) {
  if (m < n)
    return m;

  return n;
}

function int WrapAround(int i) {
  if (i<-180.0) return i+360.0;
  if (i>180.0) return i-360.0;
  return i;
}

function int GetHypotenuse(int x, int y) {
  int len;
  int ang = VectorAngle(x, y);
  if (((ang+0.125)%0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  //print(f:len);
  return len;
}

function int GetMaxPlayers(void) {  // From 8bdmlib.acs
  int ret = GetCVar("sv_MaxClients");
  if (PlayerCount() > ret)//admins can join
    ret = PlayerCount();
  return ret;
}

function int XYZDistance(int tid1, int tid2) {
  int x, y, z, d;
  x = GetActorX(tid1) - GetActorX(tid2) >> 16;
  y = GetActorY(tid1) - GetActorY(tid2) >> 16;
  z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  d = sqrt8( x*x + y*y + z*z );
  return d;
}

function int XYDistance(int tid1, int tid2) {
  int x, y, d;
  x = GetActorX(tid1) - GetActorX(tid2) >> 16;
  y = GetActorY(tid1) - GetActorY(tid2) >> 16;
  d = sqrt8( x*x + y*y );
  return d;
}

function int ZDistance(int tid1, int tid2) {
  int z;
  z = GetActorZ(tid1) - GetActorZ(tid2) >> 16;
  return z;
}

function int MagnitudeThree(int x, int y, int z) {
  return sqrt8(x*x + y*y + z*z);
}

function int abs(int x) {
  if (x < 0)
    return -x;

  return x;
}

function int sqrt8(int number) {
  if (number <= 3) {
    if (number > 0) {
      return 1;
    }
    return 0;
  }

  int oldans = number >> 1;
  int newans = (oldans + number / oldans) >> 1;

  while(newans < oldans) {
    oldans = newans;
    newans = (oldans + number / oldans) >> 1;
  }

  return oldans;
}


function void ActorPull(int puller, int pullee, int force, int xoff, int yoff, int zoff) {
  int angle = VectorAngle((GetActorX(puller)+xoff)-GetActorX(pullee), (GetActorY(puller)+yoff)-GetActorY(pullee));
  int pitch = PitchBetween(puller, pullee, xoff, yoff, zoff);

  angle = angle >> 8;
  int horizforce = FixedMul(cos(pitch), force<<16)>>16;
  int vertiforce = FixedMul(sin(pitch), force<<16)>>16;

  ThrustThing(angle, horizforce, horizforce>30, pullee);
  ThrustThingZ(pullee, vertiforce*4, 0, 0);
}

function int PitchBetween(int looker, int target, int xoff, int yoff, int zoff) {
  int x, y, z, ang, pitch, len;
  x = (GetActorX(target) + xoff) - GetActorX(looker);
    y = (GetActorY(target) + yoff) - GetActorY(looker);

  ang = VectorAngle(x, y);
  if (((ang+0.125)%0.5) > 0.25) len = FixedDiv(y, sin(ang));
  else len = FixedDiv(x, cos(ang));

  z = (GetActorZ(target) - zoff) - GetActorZ(looker);

  pitch = -VectorAngle(len, z);
  return pitch;
}

function void SetInventory(str item, int amount) {
  int diff = amount - CheckInventory(item);
  if (diff > 0)
    GiveInventory(item, diff);
  else if (diff < 0)
    TakeInventory(item, -diff);
}

function void GiveMeTheFunc(str hungry, int thebill) {
  if (thebill == 0) {thebill = 1;}

  if (thebill < 0) {
    for (int i; i < ServerMAX; i++) {
      if (PlayerInGame(i)) {TakeActorInventory(i + 1000, hungry, -thebill);}
    }
  }
  else {
    for (int j; j < ServerMAX; j++) {
      if (PlayerInGame(j)) {GiveActorInventory(j + 1000, hungry, thebill);}
    }
  }
}

function int Round(int x) {
	return (x + 0.5) >> 16;
}

#define CONVERTTEARS_FIRE2TEARS 0
#define CONVERTTEARS_TEARS2FIRE 1
function int ConvertTears(int value, int swap) { // 0 = fire rate -> tears, 1 = tears -> fire rate
  int res;
  switch (swap) {
    case CONVERTTEARS_FIRE2TEARS:
      res = Round(FixedDiv(300, (value + 1)));
      break;
    case CONVERTTEARS_TEARS2FIRE:
      res = Round(FixedDiv(300, value)) - 1;
      break;
  }
  return res;
}

script "rz_InitEdenProperties" (void) {
  if (CheckInventory("EdenInitFlag")) {
    terminate;
  }

  int health, height, height_hud, speed, speed_hud, firerate, tears_hud, damage, range, shotspeed, luck;

  if (CheckActorClass(0, "EdenShiny")) {
    health = Random(2650, 4000);
  }
  else {
    health = Random(650, 2000);
  }
  height = Random(10.0, 17.5);
  height_hud = Round(height);
  speed = Random(0.5, 1.5);
  speed_hud = Round(speed * 10);
  firerate = Random(2, 12);
  tears_hud = ConvertTears(firerate, 0);
  if (CheckActorClass(0, "EdenShiny")) {
    damage = Random(75, 300);
  }
  else {
    damage = Random(50, 200);
  }
  range = Random(10, 60);
  shotspeed = Random(15, 55);
  luck = Random(0, 16);

  SetActorProperty(0, APROP_Health, health);
  SetActorProperty(0, APROP_SpawnHealth, health);
  SetActorProperty(0, APROP_Speed, speed);
  SetActorProperty(0, APROP_JumpZ, height);
  Delay(1);
  SetInventory("EdenMaxHealthAttr", GetActorProperty(0, APROP_SpawnHealth));
  SetInventory("EdenSpeedAttr", speed_hud);
  SetInventory("EdenHeightAttr", height_hud);
  SetInventory("EdenTearsAttr", firerate);
  SetInventory("EdenTearsHUDAttr", tears_hud);
  SetInventory("EdenDamageAttr", damage);
  SetInventory("EdenRangeAttr", range);
  SetInventory("EdenShotSpeedAttr", shotspeed);
  SetInventory("EdenLuckAttr", luck);
  GiveInventory("EdenInitFlag", 1);
}

#define EDENATTR_TEARS 1
#define EDENATTR_DAMAGE 2
#define EDENATTR_SHOTSPEED 3
#define EDENATTR_LUCK 4
#define EDENATTR_RANGE 5

script "rz_GetEdenAttr" (int pointer, int attr, int hud, int useplayer) {
  if (useplayer) {
    SetActivatorToPlayer(pointer);
  }
  else if (pointer > 0) {
    SetActivator(0, pointer);
  }

  switch (attr) {
    case EDENATTR_TEARS:
      if (hud) {
        SetResultValue(CheckInventory("EdenTearsHUDAttr"));
      }
      else {
        SetResultValue(CheckInventory("EdenTearsAttr"));
      }
      break;
    case EDENATTR_DAMAGE:
      SetResultValue(CheckInventory("EdenDamageAttr"));
      break;
    case EDENATTR_SHOTSPEED:
      SetResultValue(CheckInventory("EdenShotSpeedAttr"));
      break;
    case EDENATTR_LUCK:
      SetResultValue(CheckInventory("EdenLuckAttr"));
      break;
    case EDENATTR_RANGE:
      SetResultValue(CheckInventory("EdenRangeAttr"));
      break;
  }
}


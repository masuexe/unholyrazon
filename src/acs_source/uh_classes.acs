// Strip trailing _W / _W1.._W9 from a weapon classname
function str WeaponFamilyBase(str weap) {
  int len = StrLen(weap);
  if (len < 3)
    return weap;
  // *_W1 .. *_W9
  if (len >= 4 &&
      GetChar(weap, len - 3) == '_' &&
      GetChar(weap, len - 2) == 'W') {
    int d = GetChar(weap, len - 1);
    if (d >= '1' && d <= '9')
      return StrLeft(weap, len - 3);
  }
  // *_W
  if (GetChar(weap, len - 2) == '_' && GetChar(weap, len - 1) == 'W')
    return StrLeft(weap, len - 2);
  return weap;
}

function int CountNativeWepFamily(void) {
  str weap = GetWeapon();
  if (StrLen(weap) == 0)
    return 0;
  str base = WeaponFamilyBase(weap);
  int count = 0;
  if (CheckInventory(StrParam(s:base, s:"_W")))
    count++;
  for (int i = 1; i <= 6; i++) {
    if (CheckInventory(StrParam(s:base, s:"_W", i:i)))
      count++;
  }
  return count;
}

function int CountClassWeapons(void) {
  int native = CountNativeWepFamily();
  if (native >= 2)
    return native;
  return ACS_NamedExecuteWithResult("rz_CountCopyWeapons");
}

script "rz_CountClassWeapons" (void) {
  SetResultValue(CountClassWeapons());
}

// Activator: player — SetWeapon to another owned weapon (_W family, else Mega/Qwant/Nega copy pool)
script "rz_RoulettePickOtherWeapon" (void) {
  str weap = GetWeapon();
  if (StrLen(weap) == 0) {
    SetResultValue(0);
    terminate;
  }

  // Prefer class-native *_W / *_W# siblings when that family has 2+
  if (CountNativeWepFamily() >= 2) {
    str base = WeaponFamilyBase(weap);
    str owned[7];
    int n = 0;
    str cand = StrParam(s:base, s:"_W");
    if (CheckInventory(cand)) {
      owned[n] = cand;
      n++;
    }
    for (int i = 1; i <= 6; i++) {
      cand = StrParam(s:base, s:"_W", i:i);
      if (CheckInventory(cand)) {
        owned[n] = cand;
        n++;
      }
    }
    for (int tries = 0; tries < 16; tries++) {
      int idx = Random(0, n - 1);
      if (StrCmp(owned[idx], weap) != 0) {
        SetWeapon(owned[idx]);
        SetResultValue(1);
        terminate;
      }
    }
    for (int j = 0; j < n; j++) {
      if (StrCmp(owned[j], weap) != 0) {
        SetWeapon(owned[j]);
        SetResultValue(1);
        terminate;
      }
    }
    SetResultValue(0);
    terminate;
  }

  SetResultValue(ACS_NamedExecuteWithResult("rz_RoulettePickCopyWeapon"));
}

// Cache JumpZ before UH_DisableJumpPower zeroes it; inventory as second store.
int pharaoh4mi_hop_jumpz[64];

script "rz_HopCacheJumpZ" (void) {
  int p = PlayerNumber();
  int jz = GetActorProperty(0, APROP_JumpZ) >> 16;
  if (p < 0 || p >= 64) {
    SetResultValue(0);
    terminate;
  }
  pharaoh4mi_hop_jumpz[p] = jz;
  SetInventory("Pharaoh4MIHopJumpCache", jz);
  SetResultValue(jz);
}

// Activator: HoppingWatcher; thrust TARGET using cached JumpZ
script "rz_HopDoThrust" (void) {
  if (!SetActivator(0, AAPTR_TARGET) || PlayerNumber() < 0)
    terminate;
  int p = PlayerNumber();
  int jz = 0;
  if (p >= 0 && p < 64)
    jz = pharaoh4mi_hop_jumpz[p];
  if (jz == 0)
    jz = CheckInventory("Pharaoh4MIHopJumpCache");
  ThrustThingZ(0, jz * 4, 0, 0);
  GiveInventory("JumpSound", 1);
}

// Activator: player receiving a Pharaoh 4MI curse roll
script "rz_ApplyPharaoh4MICurse" (void) {
  TakeInventory("Pharaoh4MICurse_Reverse", 1);
  TakeInventory("Pharaoh4MICurse_Hopping", 1);
  TakeInventory("Pharaoh4MICurse_Fidget", 1);
  TakeInventory("Pharaoh4MICurse_Darkness", 1);
  TakeInventory("Pharaoh4MICurse_Unknown", 1);
  TakeInventory("Pharaoh4MICurse_Roulette", 1);

  int pool = 5;
  if (CountClassWeapons() >= 2)
    pool = 6;
  int pick = Random(0, pool - 1);
  switch (pick) {
    case 0: GiveInventory("Pharaoh4MICurse_Reverse_P", 1); break;
    case 1: GiveInventory("Pharaoh4MICurse_Hopping_P", 1); break;
    case 2: GiveInventory("Pharaoh4MICurse_Fidget_P", 1); break;
    case 3: GiveInventory("Pharaoh4MICurse_Darkness_P", 1); break;
    case 4: GiveInventory("Pharaoh4MICurse_Unknown_P", 1); break;
    case 5: GiveInventory("Pharaoh4MICurse_Roulette_P", 1); break;
  }
}

script "rzc_Pharaoh4MICurse" (int toggle) {
  if (toggle) {
    AmbientSound("weapon/upsidedown", 127);
    ACS_NamedExecuteWithResult("uh_GiveEveryoneInventoryExceptBossesACS", "GivePharaoh4MICurse_P", 1);
  } else {
    GiveMeTheFunc("RemovePharaoh4MICurse_P", 1);
  }
}

script "ub_RedeadGutsHpDrain" (int adddrainbool) {
  int currhp = GetActorProperty(0, APROP_Health);
  if (currhp <= 1)
    terminate;
  int hpdrain = CheckInventory("RedeadGutsHealthDrain") + 1;
  if (currhp < hpdrain) {
    SetActorProperty(0, APROP_Health, 1);
    terminate;
  }
  if (adddrainbool)
    GiveInventory("RedeadGutsHealthDrain", 1);
  SetActorProperty(0, APROP_Health, currhp-hpdrain);
}

int hphm_temparr[65] = {-1};

script "uh_Hphm_WarpChecker" (void) {
  int ownertid = ACS_NamedExecuteWithResult("core_getptrtid", 2);
  int maxarray = -1;
  for (int i; i < ServerMAX; i++) {
    if (PlayerInGame(i) && i+1000 != ownertid) {
      maxarray++;
      hphm_temparr[maxarray] = i + 1000;
    }
  }
  if (maxarray < 0) {
    SetResultValue(ownertid);
  }
  else {
    SetResultValue(hphm_temparr[Random(0, maxarray)]);
  }
}

#define MMSF_MAX_CARDS 11
str mmsf_cards[MMSF_MAX_CARDS + 1][2] = {
  // ! = can't lock on
  {"", "!"},
  {"RadarMissile", ""},
  {"PuffBlast", ""},
  {"GhostPulse", ""},
  {"Shuriken", ""},
  {"StunKnuckle", ""},
  {"MoaiFall", "!"},
  {"TyphoonDance", ""},
  {"MagicCrystal1", ""},
  {"MagicCrystal2", ""},
  {"MagicCrystal3", ""},
  {"ElectricSlash", ""},
};

int mmsf_card_queue[64][6];

function void ClearSfCards(void) {
  for (int i = 1; i <= MMSF_MAX_CARDS; i++) {
    TakeInventory(StrParam(s:mmsf_cards[i][0], s:"_BCFlag"), 1);
    TakeInventory("SF_CanLockOn", 1);
  }
}

function void SyncSfCardsToInv(int player) {
  for (int i = 0; i < 6; i++) {
    SetInventory(StrParam(s:"SF_CardQ", i:i), mmsf_card_queue[player][i]);
  }
}

function int GetSfCard(int player, int index) {
  int frominv = CheckInventory(StrParam(s:"SF_CardQ", i:index));
  if (frominv > 0)
    return frominv;
  return mmsf_card_queue[player][index];
}

function int GiveSfCard(int player, int index) {
  ClearSfCards();
  int card_id = mmsf_card_queue[player][index];
  if (card_id != 0) {
    GiveInventory(StrParam(s:mmsf_cards[card_id][0], s:"_BCFlag"), 1);
    if (StrCmp(mmsf_cards[card_id][1], "!") != 0) {
      GiveInventory("SF_CanLockOn", 1);
    } else {
      TakeInventory("SF_CanLockOn", 1);
      TakeInventory("WR_LockOnFlag", 1);
    }
  } else {
    TakeInventory("SF_CanLockOn", 1);
    TakeInventory("WR_LockOnFlag", 1);
  }
  return card_id;
}

script "rz_GetSfCard" (int index) {
  int player = PlayerNumber();
  SetResultValue(GetSfCard(player, index));
}

script "rz_DrawSfCards" (void) {
  int player = PlayerNumber();
  for (int i = 0; i < 6; i++) {
    mmsf_card_queue[player][i] = Random(1, MMSF_MAX_CARDS);
  }
  SyncSfCardsToInv(player);
  GiveSfCard(player, 0);
}

script "rz_MoveSfCardQueue" (void) {
  int player = PlayerNumber();
  for (int i = 0; i < 6; i++) {
    if (mmsf_card_queue[player][i] != 0) {
      mmsf_card_queue[player][i] = mmsf_card_queue[player][i + 1];
    }
  }
  SyncSfCardsToInv(player);
  GiveSfCard(player, 0);
}

#define RZ_LOWHP_NUM_ID -19729900

script "rz_LowHpWarning" (int soundtype) CLIENTSIDE {
  str soundname;
  int sounddelay;
  switch (soundtype) {
    case 0:
      soundname = "MMBN6/LowHP";
      sounddelay = 25;
      break;
    case 1:
      soundname = "MMSF3/LowHP";
      sounddelay = 25;
      break;
  }

  int count = 0;
  while (GetActorProperty(0, APROP_Health) > 0) {
    int healthlimit = GetActorProperty(0, APROP_SpawnHealth) / 4;
    if (GetActorProperty(0, APROP_Health) <= healthlimit && !CheckInventory("IsAFakeBoss")) {
      GiveInventory("LowHealthFlag", 1);
      int mode = ACS_NamedExecuteWithResult("core_Get_AssistDisplayBar_HUDMode");
      if (mode == 1 || mode == 2) {
        if (CheckInventory("HealthNumberFlag")) {
          TakeInventory("HealthNumberFlag", 1);
          GiveInventory("LowHealthNumHidden", 1);
        }
        if (CheckInventory("LowHealthNumHidden")) {
          int hx;
          int hy;
          if (mode == 2) {
            hx = 153.1;
            hy = 177.1;
          } else {
            hx = 32.1;
            hy = 31.1;
          }
          SetHudSize(320, 200, 0);
          SetFont("8BDMAFONT");
          HudMessage(i:GetActorProperty(0, APROP_Health);
            HUDMSG_PLAIN, RZ_LOWHP_NUM_ID, CR_RED, hx, hy, 0.05);
        }
      }
      if (count >= sounddelay) {
        PlaySound(0, soundname, CHAN_AUTO);
        count = 0;
      } else {
        count++;
      }
    } else {
      TakeInventory("LowHealthFlag", 1);
      if (CheckInventory("LowHealthNumHidden")) {
        GiveInventory("HealthNumberFlag", 1);
        TakeInventory("LowHealthNumHidden", 1);
      }
      HudMessage(s:""; HUDMSG_PLAIN, RZ_LOWHP_NUM_ID, CR_UNTRANSLATED, 0, 0, 0.01);
    }
    Delay(1);
  }
  if (CheckInventory("LowHealthNumHidden")) {
    GiveInventory("HealthNumberFlag", 1);
    TakeInventory("LowHealthNumHidden", 1);
  }
  TakeInventory("LowHealthFlag", 1);
  HudMessage(s:""; HUDMSG_PLAIN, RZ_LOWHP_NUM_ID, CR_UNTRANSLATED, 0, 0, 0.01);
}

script "rz_CheckVoidWalkerWeapon" (void) {
  SetActivator(0, AAPTR_TARGET);
  if (CheckWeapon("VoidWalker_W")) {
    SetResultValue(1);
  } else if (CheckWeapon("VoidWalker_W2")) {
    SetResultValue(2);
  } else if (CheckWeapon("VoidWalker_W3")) {
    SetResultValue(3);
  } else if (CheckWeapon("VoidWalker_W4")) {
    SetResultValue(4);
  } else {
    SetResultValue(0);
  }
}

script "rz_LinRageWatcher" (void) {
  int maxhp = CheckInventory("BossSpawnHealthFlag");
  do {
    int hp = GetActorProperty(0, APROP_Health);
    if (hp <= maxhp / 2) {
      GiveInventory("LinCheating_P", 1);
      terminate;
    }
    Delay(1);
  } while (hp > 0);
}

script "rz_CFakeChickenObesity" (void) {
  int myspeed = GetActorProperty(0, APROP_Speed);
  SetActorProperty(0, APROP_Speed, FixedMul(myspeed, 0.85));
}

script "rz_PurpleDestronHealth" (void) {
  do {
    int health = PlayerHealth();
    int limdiff = CheckInventory("LimHealth") - health;
    if (limdiff < 0) {
      SetInventory("LimHealth", health);
    }
    else if (limdiff != 0) {
      GiveInventory("DestronDotFire_P", 1);
      SetInventory("LimHealth", health);
    }
    Delay(1);
  } while (health > 0);
}

script "rz_BlueDestronShotCooldown" (void) {
  while (PlayerHealth() > 0) {
    if (Timer() % 32 == 0) {
      GiveInventory("DestronDotFire_P", 1);
    }
    GiveInventory("BlueDestronAbility_P", 1);
    Delay(1);
  }
}

//cbm_DrawPlugCable
Script "rz_DrawFloovyPlugCable" (int grappletid, int playertid, int ang) CLIENTSIDE {
  int plx; int ply; int plz;
  int grx; int gry; int grz;
  int vx;  int vy;  int vz;
  int nx;  int ny;  int nz;
  int bx;  int by;  int bz;
  int magnitude;
  int pointcount;
  int pointoffset;
  int density = 18;

  int zoff;

  int angle = GetActorAngle(playertid);
  str spawnname = "FloovyPlugCableFX";

  if (grappletid != 0) {zoff = 32.0;}
  // if(grappletid!=0) {
  // 	zoff = 32.0;
  // 	spawnname = StrParam(s:"PlugCableFX",i:ACS_ExecuteWithResult(143,0));
  // }
  // else{
  // 	spawnname = StrParam(s:"PlugCableFX",i:ACS_ExecuteWithResult(143,playertid,1));
  // }

  plx = GetActorX(playertid) + cos(angle + 0.75) * 17;
  grx = GetActorX(grappletid);
  ply = GetActorY(playertid) + sin(angle + 0.75) * 17;
  gry = GetActorY(grappletid);
  plz = GetActorZ(playertid) + 28.0;
  grz = GetActorZ(grappletid) + zoff;

  vx = grx - plx;   vy = gry - ply;   vz = grz - plz;

  magnitude = MagnitudeThree(vx >> 16, vy >> 16, vz >> 16);

  pointcount  = magnitude / density;
  pointoffset = magnitude - (pointcount * density);

  if (magnitude != 0) {
    nx = vx / magnitude; ny = vy / magnitude; nz = vz / magnitude;

    for (int i = 0; i < pointcount; i++) {
      int j = (i * density) + pointoffset;

      bx = (nx * j) + plx;
      by = (ny * j) + ply;
      bz = (nz * j) + plz;//+(16 << 16);

      Spawn(spawnname, bx, by, bz, 0, ang);
    }
  }
}

//cbm_PlugLatch
Script "rz_FloovyPlugLatch" (int targettid, int tracertid) {
  //int targettid = ACS_NamedExecuteWithResult("uh_GetPointerTID",8);//Tracer
  //SetActivatorToTarget(0);
  SetActivator(targettid);

  if (tracertid == 0) {terminate;}

  GiveInventory("FloovyPlugFlag", 1);

  while (GetActorProperty(targettid, APROP_Health) > 0 &&
         GetActorProperty(tracertid, APROP_Health) > 0 &&
         CheckInventory("FloovyPlugFlag")) {
    ACS_NamedExecuteAlways("rz_DrawFloovyPlugCable", 0, tracertid, targettid, 0);
    Delay(1);
  }

  //SetPointer(AAPTR_TRACER, 0);
  TakeInventory("FloovyPlugFlag", 1);
}

script "rz_FloovyGhostMoving" (int pointer) {
  int selfTid = ActivatorTID();
  int buttons = ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0);
  bool moved = false;

  if ((buttons & BT_FORWARD) && !(buttons & BT_BACK)) {
    GiveInventory("FloovyGhostMoveForward", 1);
    moved = true;
  }
  else if ((buttons & BT_BACK) && !(buttons & BT_FORWARD)) {
    GiveInventory("FloovyGhostMoveBack", 1);
    moved = true;
  }
  if ((buttons & BT_MOVELEFT) && !(buttons & BT_MOVERIGHT)) {
    GiveInventory("FloovyGhostMoveLeft", 1);
    moved = true;
  }
  else if ((buttons & BT_MOVERIGHT) && !(buttons & BT_MOVELEFT)) {
    GiveInventory("FloovyGhostMoveRight", 1);
    moved = true;
  }
  if ((buttons & BT_LEFT) && !(buttons & BT_RIGHT)) {
    GiveInventory("FloovyGhostTurnLeft", 1);
  }
  else if ((buttons & BT_RIGHT) && !(buttons & BT_LEFT)) {
    GiveInventory("FloovyGhostTurnRight", 1);
  }
  if (!moved) {
    SetActorVelocity(0, FixedMul(GetActorVelX(0), 0.95), FixedMul(GetActorVelY(0), 0.95), FixedMul(GetActorVelZ(0), 0.95), 0, 0);
  }
  // Read the target through its pointer rather than converting it to a TID:
  // a morphed player can legitimately have TID 0.  The ghost itself always
  // has the positive per-effect link TID, so it is safe to restore it.
  if (!SetActivator(0, pointer)) {
    terminate;
  }
  int targetX = GetActorX(0);
  int targetY = GetActorY(0);
  if (!SetActivator(selfTid)) {
    terminate;
  }
  int x = targetX - GetActorX(0);
  int y = targetY - GetActorY(0);
  SetActorAngle(0, VectorAngle(x, y));
}

// uh_CopyPointerAnglePitch resolves the source through core_getptrtid, which
// is intentionally not used here: a morphed player can have TID 0.  Preserve
// the original movement actors' behavior by copying only the target pitch;
// the ghost's angle is maintained by rz_FloovyGhostMoving.
script "rz_FloovyGhostCopyPitch" (int pointer) {
  int selfTid = ActivatorTID();
  if (selfTid <= 0 || !SetActivator(0, pointer)) {
    terminate;
  }
  int targetPitch = GetActorPitch(0);
  if (!SetActivator(selfTid)) {
    terminate;
  }
  SetActorPitch(0, targetPitch);
}

// The DECORATE expression language has no CheckInventory() value expression;
// keep the dynamic camera TID lookup in ACS instead.
script "rz_FloovyGhostCameraOn" (void) {
  int cameraTid = CheckInventory("FloovyOutOfBodyViewTID");
  if (cameraTid > 0) {
    ChangeCamera(cameraTid, 0, 0);
  }
}

// Interrupt an existing out-of-body link immediately when M1 retargets a
// different player.  The old ghost will also observe the marker mismatch on
// its next tic, but this direct path avoids leaving the previous player frozen
// or on the old camera for those few tics.
script "rz_FloovyGhostCancel" (int linkTid) {
  if (linkTid <= 0 || !SetActivator(linkTid) ||
      !SetActivator(0, AAPTR_TRACER)) {
    terminate;
  }
  if (CheckInventory("FloovyOutOfBodyViewTID") != linkTid) {
    terminate;
  }
  ChangeCamera(0, 0, 0);
  ACS_NamedExecuteWithResult("core_freezeplayer", 0, false);
  TakeInventory("FloovyOutOfBodyViewTID", 0x7fffffff);
  TakeInventory("FloovyOutOfBodyProtect", 0x7fffffff);
}

// Only tear down the camera/freeze state if this exact ghost still owns the
// target's view marker.  This prevents an old ghost from clearing a newer
// effect after the target is hit again or the link is replaced.
script "rz_FloovyGhostCleanup" (int pointer, int linkTid) {
  if (linkTid <= 0) {
    terminate;
  }
  int selfTid = ActivatorTID();

  // Clear the owner link only if it still belongs to this ghost.  A newer
  // hit may have installed a different link and must not be disturbed.
  if (SetActivator(0, AAPTR_TARGET) &&
      CheckInventory("FloovyOutOfBodyTID") == linkTid) {
    TakeInventory("FloovyOutOfBodyTID", 0x7fffffff);
  }

  // Restore the ghost before resolving its tracer; otherwise the first
  // SetActivator above would make the target pointer relative to the player.
  if (selfTid <= 0 || !SetActivator(selfTid) || !SetActivator(0, pointer)) {
    terminate;
  }
  if (CheckInventory("FloovyOutOfBodyViewTID") != linkTid) {
    terminate;
  }
  ChangeCamera(0, 0, 0);
  ACS_NamedExecuteWithResult("core_freezeplayer", 0, false);
  TakeInventory("FloovyOutOfBodyViewTID", 0x7fffffff);
  TakeInventory("FloovyOutOfBodyProtect", 0x7fffffff);
}

// Check a Floovy link pointer without converting the pointed player to a TID.
// A dead player actor can remain allocated for a short time, so pointer
// existence alone is not enough to settle an extra-life watcher.
script "rz_FloovyPointerAlive" (int pointer) {
  if (!SetActivator(0, pointer) || PlayerNumber() < 0 ||
      !PlayerInGame(PlayerNumber()) || PlayerIsSpectator(PlayerNumber()) || CheckInventory("IsDead") ||
      GetActorProperty(0, APROP_Health) <= 0) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

script "rz_FloovyRageAmmoGiver" (int pointer) {
  if (pointer > 0) {
    SetActivator(0, pointer);
  }
  int rage_max = CheckInventory("UnholyPowerLimit_F");
  if (rage_max > 0) {
    str rage_name = StrParam(s:"UnholyPower", i:rage_max);
    GiveInventory(rage_name, 1);
  }
}

// Apply/remove one of Floovy's dedicated extra-life variants through a
// direct actor pointer.  Player morphs can legitimately have TID 0, so the
// usual `tid - 999` conversion is not safe here.
script "rz_FloovyExtraLifePointer" (int pointer, int toggle, int type) {
  if (!SetActivator(0, pointer)) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, toggle, type));
}

script "rz_FloovyDeath" (int tid, int type) {
  // int i;
  // for (i = 1000; i < 1064; i++) {
  // 	if (CheckActorClass(i, "Floovy")) {
  // 		Thing_Damage(i, 30000, 5);
  // 	}
  // }
  int health;

  if (type == ELP_FLOOVY_G) {
    // Preserve Floovy as the healer activator while inspecting/killing the
    // linked enemy.  Calling uh_IsPlayerAlive would otherwise leave ACS
    // activated on the enemy and heal the wrong player.
    int floovyPlayer = PlayerNumber();
    if (tid <= 0 || !SetActivator(tid) || !SetActivator(0, AAPTR_TRACER)) {
      terminate;
    }
    if (PlayerNumber() < 0 || CheckInventory("IsDead") || !PlayerInGame(PlayerNumber()) ||
        PlayerIsSpectator(PlayerNumber())) {
      if (floovyPlayer >= 0) SetActivatorToPlayer(floovyPlayer);
      terminate;
    }
    // The linked enemy's current HP is the amount exchanged back to Floovy.
    // Read and damage it through the link actor's TRACER pointer so a target
    // with TID 0 is still handled correctly.
    health = GetActorProperty(0, APROP_Health);
    // Keep the link actor as the activator while its kill state performs an
    // A_Explode.  This preserves the link's direct pointers and makes the
    // watcher the inflictor, allowing its custom obituary to use Floovy as
    // %k instead of falling back to a generic Thing_Damage obituary.
    if (!SetActivator(tid) || !SetActorState(0, "GoldExperienceKill", true)) {
      if (floovyPlayer >= 0) SetActivatorToPlayer(floovyPlayer);
      terminate;
    }
    if (floovyPlayer < 0 || !SetActivatorToPlayer(floovyPlayer)) {
      terminate;
    }
    ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, health);
    terminate;
  }

  if (type == ELP_FLOOVY_D) {
    // `tid` is the dedicated link actor, not Floovy's player TID.  Resolve
    // its TARGET pointer so a morphed Floovy (TID 0) is still killable.
    int allyPlayer = PlayerNumber();
    int allyMax = GetActorProperty(0, APROP_SpawnHealth);
    int allyCurrent = max(GetActorProperty(0, APROP_Health), 0);
    if (tid <= 0 || !SetActivator(tid) || !SetActivator(0, AAPTR_TARGET)) {
      terminate;
    }
    if (PlayerNumber() < 0 || CheckInventory("IsDead") || !PlayerInGame(PlayerNumber()) ||
        PlayerIsSpectator(PlayerNumber())) {
      if (allyPlayer >= 0) SetActivatorToPlayer(allyPlayer);
      terminate;
    }

    // Trigger the link's synchronous kill state.  It warps to Floovy, keeps
    // Floovy in MASTER, and temporarily selects the beneficiary in TRACER as
    // A_Explode's source, so the obituary receives both %o and %k correctly.
    if (!SetActivator(tid) || !SetActorState(0, "DieForMeKill", true)) {
      if (allyPlayer >= 0) SetActivatorToPlayer(allyPlayer);
      terminate;
    }
    if (allyPlayer < 0 || !SetActivatorToPlayer(allyPlayer)) {
      terminate;
    }
    ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, max(allyMax - allyCurrent, 0));
    terminate;
  }

  Log(s:"rz_FloovyDeath: unknown type ", i:type);
}

// Crystrap M2: find the nearest visible player in the eye's scan sphere.
// The caller is the CrystrapEyeShot actor; its TARGET pointer is the owner.
script "rz_CrystrapEyeAcquire" (int radius) {
  int ownertid = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  int besttid = 0;
  int bestdistance = radius + 1;

  for (int p = 0; p < ServerMAX; p++) {
    if (!PlayerInGame(p) || PlayerIsSpectator(p)) {
      continue;
    }

    int tid = p + 1000;
    if (tid == ownertid || CheckActorInventory(tid, "IsDead") ||
        GetActorProperty(tid, APROP_Health) <= 0) {
      continue;
    }

    int distance = XYZDistance(0, tid);
    if (distance > radius || distance > bestdistance ||
        !CheckSight(0, tid, 0)) {
      continue;
    }

    if (distance < bestdistance || (distance == bestdistance &&
        (besttid == 0 || tid < besttid))) {
      besttid = tid;
      bestdistance = distance;
    }
  }

  if (besttid > 0) {
    SetPointer(AAPTR_TRACER, besttid);
  }
  SetResultValue(besttid > 0);
}

// Crystrap M2: tag a hit player as a camera target, then AltFire looks through them.
script "rz_CrystrapSpying" (int ownertid, int tracerTid) {
  if (ownertid < 1000 || ownertid > 1063 ||
      tracerTid < 1000 || tracerTid > 1063) terminate;
  SetActivator(ownertid);

  int oldTid = CheckInventory("CrystrapSpyingTID");
  int wasLooking = CheckInventory("CrystrapIsLookingOnHisEye");
  if (oldTid >= 1000 && oldTid <= 1063 && oldTid != tracerTid) {
    TakeActorInventory(oldTid, "CrystrapIsSpyingOnYou", 1);
  }

  SetInventory("CrystrapSpyingTID", tracerTid);
  GiveActorInventory(tracerTid, "CrystrapIsSpyingOnYou", 1);
  SetHudSize(600, 380, 0);
  HudMessage(s:"You can spy on ", n:tracerTid - 999, s:"!"; HUDMSG_FADEOUT|HUDMSG_COLORSTRING, 11400 + ownertid, "MenuWhite", 300.4, 50.0, 2.0, 0.5);
  GiveActorInventory(ownertid, "CrystrapSpyingSound_P", 1);
  GiveActorInventory(tracerTid, "CrystrapSpyingSound_P", 1);
  if (wasLooking) {
    ChangeCamera(tracerTid, 0, 0);
  }
}

script "rz_CrystrapSpyingReset" (void) {
  TakeActorInventory(CheckInventory("CrystrapSpyingTID"), "CrystrapIsSpyingOnYou", 1);
  TakeInventory("CrystrapSpyingTID", 1064);
  TakeInventory("CrystrapIsLookingOnHisEye", 1);
}

script "rz_TimemanCLoliPornSpawner" (void) {
  int self = ActivatorTID();
  int chosen = 0;
  int count = 0;
  int tid;

  for (int i = 0; i < ServerMAX; i++) {
    if (!PlayerInGame(i) || PlayerIsSpectator(i)) {
      continue;
    }
    tid = 1000 + i;
    if (tid == self) {
      continue;
    }
    if (!ACS_NamedExecuteWithResult("uh_IsPlayerAlive", tid)) {
      continue;
    }
    if (CheckActorInventory(tid, "Is_UH_BossNum")) {
      continue;
    }
    count++;
    if (random(1, count) == 1) {
      chosen = tid;
    }
  }
  if (chosen > 0) {
    GiveActorInventory(chosen, "LoliPornPicItem", 1);
  }
}


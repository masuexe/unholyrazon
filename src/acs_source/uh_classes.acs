#define EDEN_ANTIGRAV_AUTO_TICS 105

int eden_antigrav_washolding[64];
int eden_antigrav_release_pulse[64];

function int EdenAntiGravOwnerPn(void) {
  int owner;
  owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  if (owner == 0)
    owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
  if (owner < 1000 || owner > 1063)
    return -1;
  return owner - 1000;
}

function int EdenAntiGravReadFireHeld(int owner) {
  int buttons;
  if (owner < 1000 || owner > 1063)
    return 0;
  SetActivator(owner);
  buttons = GetPlayerInput(-1, INPUT_BUTTONS);
  if (buttons & BT_ATTACK)
    return 1;
  buttons = GetPlayerInput(-1, MODINPUT_BUTTONS);
  if (buttons & BT_ATTACK)
    return 1;
  return 0;
}

function void EdenAntiGravUpdatePlayer(int owner) {
  int pn;
  int holding;
  if (owner < 1000 || owner > 1063)
    return;
  pn = owner - 1000;
  if (pn < 0 || pn >= 64)
    return;
  holding = EdenAntiGravReadFireHeld(owner);
  if (holding) {
    eden_antigrav_release_pulse[pn] = 0;
    eden_antigrav_washolding[pn] = 1;
  }
  else {
    if (eden_antigrav_washolding[pn])
      eden_antigrav_release_pulse[pn] = 1;
    eden_antigrav_washolding[pn] = 0;
  }
}

script "rz_EdenAntiGravOwnerTickFromTear" (void) {
  int owner;
  owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  if (owner == 0)
    owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
  if (owner == 0)
    terminate;
  SetActivator(owner);
  if (!CheckInventory("C222Flag"))
    terminate;
  EdenAntiGravUpdatePlayer(owner);
}

script "rz_EdenAntiGravEnterHover" (void) {
  int owner;
  int pn;
  owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
  if (owner == 0)
    owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_MASTER);
  if (owner == 0) {
    SetResultValue(0);
    terminate;
  }
  SetActivator(owner);
  if (!CheckInventory("C222Flag")) {
    SetResultValue(0);
    terminate;
  }
  if (CheckInventory("IsBot")) {
    SetResultValue(0);
    terminate;
  }
  pn = owner - 1000;
  if (pn >= 0 && pn < 64 && EdenAntiGravReadFireHeld(owner)) {
    eden_antigrav_release_pulse[pn] = 0;
    eden_antigrav_washolding[pn] = 1;
  }
  SetResultValue(1);
}

script "rz_EdenAntiGravShouldLaunch" (void) {
  int pn;
  pn = EdenAntiGravOwnerPn();
  if (pn < 0 || pn >= 64) {
    SetResultValue(0);
    terminate;
  }
  if (eden_antigrav_release_pulse[pn]) {
    SetResultValue(1);
    terminate;
  }
  SetResultValue(0);
}

script "rz_EdenAntiGravTick" (void) {
  if (!CheckInventory("C222Flag"))
    terminate;
  EdenAntiGravUpdatePlayer(ActivatorTID());
}

// Tear death-mod registry (symmetric with rz_EdenTearPassiveSpawn).
// Returns 1 if a death replace ran (skip normal splatter).

script "ub_RedeadGutsHPDrain" (int AddDrainBool)
{
	int CurrHP = GetActorProperty(0,APROP_HEALTH);
	if(CurrHP <= 1)
		terminate;
	int HPDrain = CheckInventory("RedeadGutsHealthDrain") + 1;
	if(CurrHP < HPDrain){
		SetActorProperty(0, APROP_HEALTH, 1);
		terminate;
	}
	if(AddDrainBool)
		GiveInventory("RedeadGutsHealthDrain",1);
	SetActorProperty(0, APROP_HEALTH, CurrHP-HPDrain);
}

int HPHM_TempArr[65] = {-1};

script "uh_HPHM_WarpChecker" (void) {
	int OwnerTID = ACS_NamedExecuteWithResult("core_getptrtid", 2);
	int MaxArray = -1;
	for (int i; i < ServerMAX; i++) {
		if (PlayerInGame(i) && i+1000 != OwnerTID) {
			MaxArray++;
			HPHM_TempArr[MaxArray] = i + 1000;
		}
	}
	if (MaxArray < 0) {
		SetResultValue(OwnerTID);
	}
	else {
		SetResultValue(HPHM_TempArr[random(0, MaxArray)]);
	}
}


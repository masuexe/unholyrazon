  SetResultValue(GetUserVariable(0, samurai_user_variables[num]));//>>16
}


function int FindNew_LockOnList(int owner, int limit) {
  for (int i = 0; i < limit; i++) {
    if (GetUserArray(owner, "user_lockOnList", i) == 0) {
      //Log(s:"A chance for lock on...", i:i);
      return i;
    }
  }
  //Log(s:" NO SPACE FOR LOCK ON! ");
  return -1;
}
function void CheckClear_LockOnList(int owner, int limit) {
  int curr_arr;
  for (int i = 0; i < limit; i++) {
    curr_arr = GetUserArray(owner, "user_lockOnList", i);
    if (curr_arr != 0)
      if (GetActorProperty(curr_arr+999, APROP_Health) <= 0 || CheckActorInventory(curr_arr+999, "PowerProtectSurvivor"))
        SetUserArray(owner, "user_lockOnList", i, 0);
  }

}
function void Clear_LockOnList(int limit) {
  for (int i = 0; i < limit; i++) {
    SetUserArray(0, "user_lockOnList", i, 0);
  }
}

script "uc_MarksmanLockOn" (int mode, int type1, int type2, int type3) {
  switch (mode) {
    default:
      Log(i:mode, s:" >> Invalid Mode for uc_MarksmanLockOn");
      break;
    case -1: //Reset Array to 0
      Clear_LockOnList(type1);
      //Log(s:"Clearing Lockons...checking 1 = ", i:GetUserArray(0, "user_lockOnList", 1));
      break;
    case 0: //type1 = Owner TID //type2 = Tracer TID //type3 = LockOn limit
      if (CheckActorInventory(type2, "PowerProtectSurvivor"))
        terminate;
      int lockon_num = FindNew_LockOnList(type1, type3);
      if (lockon_num == -1)//All slots filled, end the script
        terminate;
      //Check if last lock-on is that specific player
      if (!(GetUserArray(type1, "user_lockOnList", lockon_num-(lockon_num!=0))==type2-999 &&
          CheckActorInventory(type1, "MarksmanLockOn_CD"))) {
        SetUserArray(type1, "user_lockOnList",lockon_num,type2-999);
        GiveActorInventory(type1, "MarksmanLockOn_CD_P", 1);
        ActivatorSound("CowboyKid/Chat", 127);
        NamedExecuteClientScript("uc_MarksmanClientSound", type1-1000);
        //Log(s:"Success lock on!");
      }
      break;
    case 1: //Missile copies TID in Targets slot
      SetActivatorToTarget(0);
      //Log(s:"Fetching lock on ", i:CheckInventory("MarksmanMissile_F"),s:"...", i:GetUserArray(0, "user_lockOnList",CheckInventory("MarksmanMissile_F")));
      SetResultValue(GetUserArray(0, "user_lockOnList",CheckInventory("MarksmanMissile_F")));
      break;
    case 3: //Check if locked on players are alive. Remove if not.
      CheckClear_LockOnList(ActivatorTID(), type1);
      break;
  }
}


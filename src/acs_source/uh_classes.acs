}

script "rz_FloovyGhostMoving" (int pointer) {
  if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_FORWARD) &&
      (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_BACK)) {
    GiveInventory("FloovyGhostMoveForward", 1);
  }
  else if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_BACK) &&
           (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_FORWARD)) {
    GiveInventory("FloovyGhostMoveBack", 1);
  }
  else if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_MOVELEFT) &&
           (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_MOVERIGHT)) {
    GiveInventory("FloovyGhostMoveLeft", 1);
  }
  else if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_MOVERIGHT) &&
           (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_MOVELEFT)) {
    GiveInventory("FloovyGhostMoveRight", 1);
  }
  else if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_LEFT) &&
           (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_RIGHT)) {
    GiveInventory("FloovyGhostTurnLeft", 1);
  }
  else if ((ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_RIGHT) &&
           (ACS_NamedExecuteWithResult("uh_GetPointerButtonInput", pointer, 0) & BT_LEFT)) {
    GiveInventory("FloovyGhostTurnRight", 1);
  }
  else {
    SetActorVelocity(0, FixedMul(GetActorVelX(0), 0.95), FixedMul(GetActorVelY(0), 0.95), FixedMul(GetActorVelZ(0), 0.95), 0, 0);
  }
  int p_tid = ACS_NamedExecuteWithResult("core_getptrtid", pointer);
  int x = GetActorX(p_tid) - GetActorX(0);
  int y = GetActorY(p_tid) - GetActorY(0);
  SetActorAngle(0, VectorAngle(x, y));
}


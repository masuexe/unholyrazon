function void EdenClearMorphState(void) {
  int i;
  str flag;

  EdenEnsureVanillaAltRegistered();
  EdenEnsureVanillaMainRegistered();

  for (i = 0; i < edenisaac_main_count; i++) {
    flag = StrParam(s:"C", i:edenisaac_main_id[i], s:"Flag");
    TakeInventory(flag, 1);
  }
  for (i = 0; i < edenisaac_alt_count; i++) {
    flag = StrParam(s:"C", i:edenisaac_alt_id[i], s:"Flag");
    TakeInventory(flag, 1);
  }

  EdenClearMainSlots();
  TakeInventory("EdenInitFlag", 1);
  TakeInventory("EdenMainRolled_F", 1);
  TakeInventory("EdenShinyAngel_F", 1);
  TakeInventory("EdenShinyDevil_F", 1);
  TakeInventory("EdenAntiGravStats_F", 1);
  TakeInventory("EdenPiggyBankPickup_F", 1);
  TakeInventory("EdenDamoclesActive_F", 1);
  TakeInventory("EdenDamoclesSpent_F", 1);
  SetInventory("EdenDamoclesRisk", 0);
  TakeInventory("BobHeadFlag", 2);
  TakeInventory("BobHeadLeft_F", 1);
  TakeInventory("D8InitFlag", 1);
  TakeInventory("Eden118_W", 1);
  TakeInventory("Eden678_W", 1);
}

function void EdenRollBaseStats(int shiny) {
  int health;
  int height;
  int height_hud;
  int speed;
  int speed_hud;
  int firerate;
  int tears_hud;
  int damage;
  int range;
  int shotspeed;
  int luck;

  if (shiny) {
    health = Random(2000, 3000);
    damage = Random(75, 300);
  }
  else {
    health = Random(650, 2000);
    damage = Random(50, 200);
  }
  height = Random(10.0, 17.5);
  height_hud = Round(height);
  speed = Random(0.5, 1.5);
  speed_hud = Round(speed * 10);
  firerate = Random(2, 12);
  tears_hud = ConvertTears(firerate, 0);
  range = Random(10, 60);
  shotspeed = Random(15, 55);
  luck = Random(0, 16);

  SetActorProperty(0, APROP_Health, health);
  SetActorProperty(0, APROP_SpawnHealth, health);
  SetActorProperty(0, APROP_Speed, speed);
  SetActorProperty(0, APROP_JumpZ, height);

  SetInventory("EdenMaxHealthAttr", health);
  SetInventory("EdenSpeedAttr", speed_hud);
  SetInventory("EdenHeightAttr", height_hud);
  SetInventory("EdenTearsAttr", firerate);
  SetInventory("EdenTearsHUDAttr", tears_hud);
  SetInventory("EdenDamageAttr", damage);
  SetInventory("EdenRangeAttr", range);
  SetInventory("EdenShotSpeedAttr", shotspeed);
  SetInventory("EdenLuckAttr", luck);
}

function void EdenRebuildNormalMainPool(void) {
  int count = 0;
  int i;

  for (i = 0; i < edenisaac_main_count; i++) {
    if (edenisaac_main_form[i] == EDEN_FORM_NONE) {
      eden_normal_main_idx[count] = i;
      count++;
    }
  }
  eden_normal_main_count = count;
}

function void EdenRollMainItemsShiny(void) {
  int poolsize = edenisaac_main_count;
  int pickcount = EdenRollMainItemCount(poolsize);
  int normal_idx[EDEN_ISAAC_MAIN_CAP];
  int normal_count = 0;
  int rolled_ids[4];
  int rolled_count = 0;
  int isAngel;
  int forced_id;
  int i;
  int j;
  int pick;
  int total;
  int roll;
  int acc;
  int id;
  str flag;

  EdenClearMainSlots();
  TakeInventory("EdenShinyAngel_F", 1);
  TakeInventory("EdenShinyDevil_F", 1);

  if (pickcount < 1) {
    pickcount = 1;
  }

  isAngel = Random(0, 1);
  if (isAngel) {
    GiveInventory("EdenShinyAngel_F", 1);
    forced_id = 331;
  }
  else {
    GiveInventory("EdenShinyDevil_F", 1);
    forced_id = 118;
  }

  EdenRebuildNormalMainPool();
  normal_count = eden_normal_main_count;
  for (i = 0; i < normal_count; i++) {
    normal_idx[i] = eden_normal_main_idx[i];
  }

  rolled_ids[0] = forced_id;
  rolled_count = 1;

  for (i = 1; i < pickcount; i++) {
    if (normal_count <= 0) {
      break;
    }
    total = 0;
    for (j = 0; j < normal_count; j++) {
      total += EdenGetMainPickWeight(edenisaac_main_quality[normal_idx[j]]);
    }
    roll = Random(0, total - 1);
    pick = 0;
    acc = 0;
    for (j = 0; j < normal_count; j++) {
      acc += EdenGetMainPickWeight(edenisaac_main_quality[normal_idx[j]]);
      if (roll < acc) {
        pick = j;
        break;
      }
    }
    id = edenisaac_main_id[normal_idx[pick]];
    rolled_ids[rolled_count] = id;
    rolled_count++;
    for (j = pick; j < normal_count - 1; j++) {
      normal_idx[j] = normal_idx[j + 1];
    }
    normal_count--;
  }

  for (i = 0; i < rolled_count; i++) {
    id = rolled_ids[i];
    flag = StrParam(s:"C", i:id, s:"Flag");
    GiveInventory(flag, 1);
    SetInventory(StrParam(s:"EdenItemSlot", i:i + 1), id);
  }

  EdenApplyMainPassives();
  EdenApplyColor();
  GiveInventory("EdenMainRolled_F", 1);
}

function void EdenRollMainItems(void) {
  if (CheckActorClass(0, "EdenShiny")) {
    EdenRollMainItemsShiny();
    return;
  }

  int poolsize;
  int pickcount;
  int indices[EDEN_ISAAC_MAIN_CAP];
  int i;
  int j;
  int pick;
  int total;
  int roll;
  int acc;
  int tmp;
  int id;
  str flag;

  EdenClearMainSlots();

  EdenRebuildNormalMainPool();
  poolsize = eden_normal_main_count;
  pickcount = EdenRollMainItemCount(poolsize);
  for (i = 0; i < poolsize; i++) {
    indices[i] = eden_normal_main_idx[i];
  }

  if (pickcount <= 0) {
    GiveInventory("EdenMainRolled_F", 1);
    return;
  }

  for (i = 0; i < pickcount; i++) {
    total = 0;
    for (j = i; j < poolsize; j++) {
      total += EdenGetMainPickWeight(edenisaac_main_quality[indices[j]]);
    }
    roll = Random(0, total - 1);
    pick = i;
    acc = 0;
    for (j = i; j < poolsize; j++) {
      acc += EdenGetMainPickWeight(edenisaac_main_quality[indices[j]]);
      if (roll < acc) {
        pick = j;
        break;
      }
    }
    tmp = indices[i];
    indices[i] = indices[pick];
    indices[pick] = tmp;
  }

  for (i = 0; i < pickcount; i++) {
    id = edenisaac_main_id[indices[i]];
    flag = StrParam(s:"C", i:id, s:"Flag");
    GiveInventory(flag, 1);
    SetInventory(StrParam(s:"EdenItemSlot", i:i + 1), id);
  }

  EdenApplyMainPassives();
  EdenApplyColor();
  GiveInventory("EdenMainRolled_F", 1);
}

script "rz_InitEdenProperties" (void) {
  EdenEnsureVanillaAltRegistered();
  EdenEnsureVanillaMainRegistered();

  int slot;
  str flag;

  // Recover: Init ran earlier with empty table → InitFlag set, no C*Flag.
  if (CheckInventory("EdenInitFlag")) {
    if (EdenFindEquippedAlt() < 0 && edenisaac_alt_count > 0) {
      slot = Random(0, edenisaac_alt_count - 1);
      flag = StrParam(s:"C", i:edenisaac_alt_id[slot], s:"Flag");
      GiveInventory(flag, 1);
    }
    if (!CheckInventory("EdenMainRolled_F") && edenisaac_main_count > 0) {
      EdenRollMainItems();
      EdenSyncFireWeapon();
    }
    terminate;
  }

  EdenRollBaseStats(CheckActorClass(0, "EdenShiny"));

  // Lock one alt item for the life; Flag persists via EdenInitFlag gate.
  if (edenisaac_alt_count > 0) {
    slot = Random(0, edenisaac_alt_count - 1);
    flag = StrParam(s:"C", i:edenisaac_alt_id[slot], s:"Flag");
    GiveInventory(flag, 1);
  }

  EdenRollMainItems();

  EdenSyncFireWeapon();

  GiveInventory("EdenInitFlag", 1);
}

script "rz_EdenShinyMorphInit" (void) {
  int slot;
  str flag;

  if (!CheckActorClass(0, "EdenShiny")) {
    terminate;
  }

  EdenEnsureVanillaAltRegistered();
  EdenEnsureVanillaMainRegistered();
  EdenClearMorphState();
  EdenRollBaseStats(1);

  if (edenisaac_alt_count > 0) {
    slot = Random(0, edenisaac_alt_count - 1);
    flag = StrParam(s:"C", i:edenisaac_alt_id[slot], s:"Flag");
    GiveInventory(flag, 1);
  }

  EdenRollMainItems();
  EdenSyncFireWeapon();
  GiveInventory("EdenInitFlag", 1);
}


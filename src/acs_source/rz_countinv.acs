#library "rz_countinv"
#include "zcommon.acs"

function int CheckPointerInventory(str invname, int pointer) {
  if (pointer > 0) {
    SetActivator(0, pointer);
  }
  return CheckInventory(invname);
}

script "rz_CountInv_BossSpawnHealthFlag" (int pointer) {
  SetResultValue(CheckPointerInventory("BossSpawnHealthFlag", pointer));
}


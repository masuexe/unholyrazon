#library "rz_countinv"
#include "zcommon.acs"

function int CheckPointerInventory(str invname, int pointer) {
  if (pointer > 0) {
    SetActivator(0, pointer);
  }
  return CheckInventory(invname);
}

script "rz_CountInv_ZangiefAngle" (int pointer) {
  SetResultValue(CheckPointerInventory("ZangiefAngle", pointer));
}
script "rz_CountInv_SuplexID" (int pointer) {
  SetResultValue(CheckPointerInventory("SuplexID", pointer));
}

script "rz_CountInv_CrystrapSpyingTid" (int pointer) {
  SetResultValue(CheckPointerInventory("CrystrapSpyingTid", pointer));
}

script "rz_CountInv_FloovyOutOfBodyTid" (int pointer) {
  SetResultValue(CheckPointerInventory("FloovyOutOfBodyTid", pointer));
}
script "rz_CountInv_FloovyStandTid" (int pointer) {
  SetResultValue(CheckPointerInventory("FloovyStandTid", pointer));
}
script "rz_CountInv_FloovyDiesForMeTid" (int pointer) {
  SetResultValue(CheckPointerInventory("FloovyDiesForMeTid", pointer));
}

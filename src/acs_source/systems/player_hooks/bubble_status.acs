// Bubble status: one body-owned marker, one authoritative server controller,
// and exactly one layer of the base game's PlayerPropertyFrozen stacker.
//
// A hit opts in by carrying the damage type "UH_Bubble".  The engine dispatches
// GAMEEVENT_ACTOR_DAMAGED after armor absorption and before health subtraction.
// The engine does not dispatch that event when armor absorbs the whole hit,
// when the target is invulnerable, or when a damage factor reduces the hit to
// zero, so a completely immune hit cannot change Bubble state.
//
// The event script runs from the rz_shared module, which loads after every
// gameplay library that modifies or cancels damage.  The value returned by
// GetEventResult() at that point is the damage that P_DamageMobj will apply.

#define UH_BUBBLE_TICS 88
#define UH_BUBBLE_DAMAGETYPE "UH_Bubble"
#define UH_BUBBLE_SND_ENTER "MMBN6/BubbleEnter"
#define UH_BUBBLE_SND_RELEASE "MMBN6/BubbleRelease"

// Attached cosmetic Bubble visual.  The class is a server-owned shieldwarper,
// so it is replicated to every client.  It is not spawned from a clientside
// actor and it is not clientside-only.
//
// The unique visual TID is the handle.  It is allocated above the MM8BDM player
// TID range (PLN_TID = 1000) so it cannot take the TID of a later player join.
// The body stores the TID in user_uh_bubble_visual.
#define UH_BUBBLE_VISUAL_TID_START 100000
#define UH_BUBBLE_VISUAL_LINK_TID_START 200000
// Released effects coexist with new holds, including same-tic multi-hit bursts.
// Do not restrict this search to MAX_PLAYERS slots.
#define UH_BUBBLE_VISUAL_TID_SPAN 100000

// Future immunity whitelist hook.  No actor grants UH_BubbleImmune_F in this
// version; a future approved whitelist adds that marker instead of editing the
// damage event.  Do not reuse PlayerPropertyNoParalyze or GENERICBOSS checks
// here: bosses must stay susceptible.
function bool UH_BubbleIsImmune(void) {
  return CheckInventory("UH_BubbleImmune_F") > 0;
}

// Single centralized eligibility gate.  The active marker makes Bubble a
// single state; a repeated hit breaks it instead of refreshing it.
function bool UH_BubbleCanApply(void) {
  int p = PlayerNumber();
  if (p < 0 || p >= MAX_PLAYERS)
    return false;
  if (!PlayerInGame(p))
    return false;
  if (CheckInventory("UH_Bubble_F") > 0)
    return false;
  if (CheckInventory("IsDead") > 0)
    return false;
  if (GetActorProperty(0, APROP_Health) <= 0)
    return false;
  if (UH_BubbleIsImmune())
    return false;
  return true;
}

function bool UH_BubbleDamageCarriesStatus(str dmgtype) {
  return StrICmp(dmgtype, UH_BUBBLE_DAMAGETYPE) == 0;
}

// Remove the recorded visual without a release animation.  This path is for
// death, morph, respawn, map and slot-reuse cleanup, and for an interrupted
// instance.  A visual whose TID was recycled by an unrelated actor has no
// owner token, so it is never touched.
function void UH_BubbleVisualDrop(void) {
  int p = PlayerNumber();
  if (p < 0)
    return;
  int vis = GetUserVariable(0, "user_uh_bubble_visual");
  if (vis == 0)
    return;
  SetUserVariable(0, "user_uh_bubble_visual", 0);
  if (StrICmp(GetActorClass(vis), "UHBubbleWarper") == 0
      && GetUserVariable(vis, "user_uh_bubble_owner")
         == GetUserVariable(0, "user_uh_bubble_token"))
    Thing_Remove(vis);
}

// Send the recorded visual to its three-frame release animation.  The token
// check makes a stale TID harmless and stops an old effect from answering a
// newer Bubble instance.
function void UH_BubbleVisualPop(int token) {
  int p = PlayerNumber();
  if (p < 0)
    return;
  int vis = GetUserVariable(0, "user_uh_bubble_visual");
  if (vis == 0)
    return;
  SetUserVariable(0, "user_uh_bubble_visual", 0);
  if (StrICmp(GetActorClass(vis), "UHBubbleWarper") != 0
      || GetUserVariable(vis, "user_uh_bubble_owner") != token)
    return;
  SetUserVariable(vis, "user_uh_bubble_released", 1);
  SetActorState(vis, "Pop", 0);
}

// Spawn exactly one attached visual for this instance.  Call this only after
// the status owns its freeze layer.  The body gets a temporary unique TID for
// the pointer assignment, so the target lookup cannot match another actor that
// shares the MM8BDM player TID.  The original body TID is restored before the
// function returns.
function void UH_BubbleVisualSpawn(int p, int token) {
  if (p < 0 || p >= MAX_PLAYERS)
    return;
  // No active status exists here, so a recorded visual is stale.  Remove it
  // before the new instance starts; this also covers an interrupted instance.
  UH_BubbleVisualDrop();
  int bodyTid = ActivatorTID();
  int temp = UniqueTID(UH_BUBBLE_VISUAL_LINK_TID_START,
                       UH_BUBBLE_VISUAL_TID_SPAN);
  if (temp == 0)
    return;
  int vis = UniqueTID(UH_BUBBLE_VISUAL_TID_START, UH_BUBBLE_VISUAL_TID_SPAN);
  if (vis == 0)
    return;
  Thing_ChangeTID(0, temp);  // the activator is the body
  if (SpawnForced("UHBubbleWarper", GetActorX(0), GetActorY(0),
                  GetActorZ(0), vis, 0) <= 0) {
    Thing_ChangeTID(temp, bodyTid);
    return;
  }
  // SetActivator can leave no activator when the TID is missing, so restore
  // the body unconditionally.
  if (SetActivator(vis))
    SetPointer(AAPTR_TARGET, temp);
  SetActivatorToPlayer(p);
  Thing_ChangeTID(temp, bodyTid);
  SetUserVariable(vis, "user_uh_bubble_height", GetActorProperty(0, APROP_Height) >> 16);
  SetUserVariable(vis, "user_uh_bubble_owner", token);
  SetUserVariable(0, "user_uh_bubble_visual", vis);
  SetActorState(vis, "Shield", 0);
  ACS_NamedExecuteAlways("uh_BubbleVisualWatch", 0, vis, token);
}

// This cosmetic watchdog never changes the gameplay markers or freeze stack.
// Keep the actual target pointer: a respawn at the same player TID is a new
// body. An abandoned visual is removed within a tic; Pop owns its final 12
// tics after release. The hard bound also covers a lost gameplay controller.
script "uh_BubbleVisualWatch" (int vis, int token) {
  for (int age = 0; age < UH_BUBBLE_TICS + 2; age++) {
    if (!SetActivator(vis))
      terminate;
    if (StrICmp(GetActorClass(0), "UHBubbleWarper") != 0
        || GetUserVariable(0, "user_uh_bubble_owner") != token)
      terminate;
    if (GetUserVariable(0, "user_uh_bubble_released"))
      terminate;
    if (!SetActivator(0, AAPTR_TARGET))
      break;
    int p = PlayerNumber();
    if (p < 0 || !PlayerInGame(p)
        || GetActorProperty(0, APROP_Health) <= 0
        || CheckInventory("UH_Bubble_F") <= 0
        || GetUserVariable(0, "user_uh_bubble_token") != token
        || GetUserVariable(0, "user_uh_bubble_visual") != vis)
      break;
    Delay(1);
  }
  // Recheck after the final Delay: that TID may already belong to a new
  // instance, or the controller may have started Pop on the last tic.
  if (StrICmp(GetActorClass(vis), "UHBubbleWarper") == 0
      && GetUserVariable(vis, "user_uh_bubble_owner") == token
      && !GetUserVariable(vis, "user_uh_bubble_released"))
    Thing_Remove(vis);
}

// Release only the layer this status recorded.  The lock marker is the proof
// of ownership, so a repeated cleanup cannot spend another source's freeze
// layer.  Set releaseLock to false when the shared freeze counter was already
// wiped by somebody else (the layer is gone and another layer may have arrived
// since).
//
// playRelease plays the release sound and the three-frame release animation
// only when this call actually ends an active instance.  Lifecycle, death,
// morph and interrupted-instance cleanup pass 0, so they never make a sound
// and never leave a pop effect when no Bubble existed.
function void UH_BubbleClearOwned(int releaseLock, int playRelease) {
  int p = PlayerNumber();
  if (p < 0)
    return;

  int hadBubble = CheckInventory("UH_Bubble_F") > 0
    || CheckInventory("UH_BubbleLock_F") > 0;
  int token = GetUserVariable(0, "user_uh_bubble_token");

  // The cosmetic visual is released or dropped before the markers go away, so
  // no path can leave an attached effect behind.
  if (hadBubble && playRelease && token != 0)
    UH_BubbleVisualPop(token);
  else
    UH_BubbleVisualDrop();

  if (CheckInventory("UH_BubbleGravity_F") > 0) {
    TakeInventory("UH_BubbleGravity_F", 1);
    if (CheckInventory("PlayerPropertyNoGravity") > 0
        && CheckInventory("PlayerPropertyNoGravityForced") > 0)
      ACS_NamedExecuteWithResult("core_nogravityplayer", 0, 0, 1);
    if (CheckInventory("UH_BubbleRawGravity_F") > 0
        && CheckInventory("PlayerPropertyNoGravity") <= 0)
      GiveInventory("PlayerPropertyNoGravityOn", 1);
  }
  TakeInventory("UH_BubbleRawGravity_F", 9999);

  if (CheckInventory("UH_BubbleLock_F") > 0) {
    TakeInventory("UH_BubbleLock_F", 1);
    if (releaseLock && CheckInventory("PlayerPropertyFrozen") > 0)
      ACS_NamedExecuteWithResult("core_freezeplayer", 0, 0, 0);
  }

  TakeInventory("UH_Bubble_F", 9999);
  SetUserVariable(0, "user_uh_bubble_token", 0);
  SetUserVariable(0, "user_uh_bubble_hold_pending", 0);
  if (hadBubble && playRelease)
    PlaySound(0, UH_BUBBLE_SND_RELEASE, CHAN_BODY);
}

// Start one Bubble instance on the current body.  The unique token is the body
// and instance identity: a morph, a slot reuse, a break, or a later Bubble
// cannot match an older controller's token.
function void UH_BubbleApply(void) {
  int p = PlayerNumber();
  if (p < 0 || p >= MAX_PLAYERS)
    return;
  if (!UH_BubbleCanApply())
    return;

  // An interrupted instance can leave only the lock marker behind.  Reclaim it
  // before installing the new state so the new instance owns exactly one layer.
  if (CheckInventory("UH_BubbleLock_F") > 0 && CheckInventory("UH_Bubble_F") <= 0)
    UH_BubbleClearOwned(1, 0);

  int token = UniqueTID();
  SetUserVariable(0, "user_uh_bubble_token", token);
  SetUserVariable(0, "user_uh_bubble_hold_pending", 1);
  GiveInventory("UH_Bubble_F", 1);

  int before = CheckInventory("PlayerPropertyFrozen");
  ACS_NamedExecuteWithResult("core_freezeplayer", 0, 1, 0);
  int added = CheckInventory("PlayerPropertyFrozen") - before;
  if (added <= 0) {
    // The stacker refused the layer (counter at its limit).  Do not leave an
    // active marker that blocks input without an owned lock.
    TakeInventory("UH_Bubble_F", 9999);
    SetUserVariable(0, "user_uh_bubble_token", 0);
    SetUserVariable(0, "user_uh_bubble_hold_pending", 0);
    return;
  }

  GiveInventory("UH_BubbleLock_F", 1);
  // A forced core layer also works while grounded. Remember a native class
  // flag so the last core layer cannot turn off its pre-existing NOGRAVITY.
  if (CheckInventory("PlayerPropertyNoGravity") < 99999
      && CheckInventory("PlayerPropertyNoGravityForced") < 99999) {
    if (CheckFlag(0, "NOGRAVITY")
        && CheckInventory("PlayerPropertyNoGravity") <= 0)
      GiveInventory("UH_BubbleRawGravity_F", 1);
    ACS_NamedExecuteWithResult("core_nogravityplayer", 0, 1, 1);
    GiveInventory("UH_BubbleGravity_F", 1);
  }
  // One attached visual per accepted instance.  A refused freeze layer returned
  // above, so an immune hit cannot spawn a visual.
  UH_BubbleVisualSpawn(p, token);
  // One entry sound per accepted instance.  The per-tic controller and the
  // cleanup paths never replay it.
  PlaySound(0, UH_BUBBLE_SND_ENTER, CHAN_BODY);
  ACS_NamedExecuteAlways("uh_BubbleController", 0, p, token);
}

// One controller per instance.  It wakes every tic so an early break, death,
// morph, or an external wipe ends it before a stale timer can clear a newer
// Bubble.  A token mismatch means another body or instance owns the state, so
// this controller exits without touching anything.
script "uh_BubbleController" (int p, int token) {
  if (p < 0 || p >= MAX_PLAYERS)
    terminate;
  if (!SetActivatorToPlayer(p))
    terminate;
  if (GetUserVariable(0, "user_uh_bubble_token") != token)
    terminate;

  int elapsed = 0;
  int holdChecked = 0;
  while (elapsed < UH_BUBBLE_TICS) {
    if (!PlayerInGame(p))
      terminate;
    if (!SetActivatorToPlayer(p))
      terminate;
    if (GetUserVariable(0, "user_uh_bubble_token") != token)
      terminate;

    if (CheckInventory("UH_Bubble_F") <= 0) {
      // The marker was removed by a lifecycle clear while this controller was
      // asleep.  The same cleanup already returned the layer; return only a
      // layer that is still visibly owned here.
      if (CheckInventory("UH_BubbleLock_F") > 0)
        UH_BubbleClearOwned(1, 0);
      terminate;
    }
    if (CheckInventory("UH_BubbleLock_F") <= 0) {
      // The owned layer disappeared (bulk freeze wipe).  Do not touch the
      // shared counter again: a different source may own what is there now.
      UH_BubbleClearOwned(0, 0);
      terminate;
    }
    if (CheckInventory("PlayerPropertyFrozen") <= 0) {
      UH_BubbleClearOwned(0, 0);
      terminate;
    }
    if (GetActorProperty(0, APROP_Health) <= 0) {
      UH_BubbleClearOwned(1, 0);
      terminate;
    }

    Delay(1);
    elapsed++;

    if (!holdChecked) {
      // The engine installs the damage Pain state after this event.  The
      // shared Pain state clears the pending flag and enters BubbleHold itself,
      // so a class with a normal Pain response keeps its full chain.  A class
      // whose PainChance rejects the hit leaves the flag set; hold H here.
      if (!SetActivatorToPlayer(p))
        terminate;
      if (GetUserVariable(0, "user_uh_bubble_token") != token)
        terminate;
      if (GetUserVariable(0, "user_uh_bubble_hold_pending") == 1
          && CheckInventory("UH_Bubble_F") > 0
          && GetActorProperty(0, APROP_Health) > 0) {
        SetActorState(0, "BubbleHold", 1);
        SetUserVariable(0, "user_uh_bubble_hold_pending", 0);
      }
      holdChecked = 1;
    }
  }

  if (!SetActivatorToPlayer(p))
    terminate;
  if (GetUserVariable(0, "user_uh_bubble_token") != token)
    terminate;
  // A timeout releases normally.  A body that died during the final tic keeps
  // the conservative death path and does not play the release sound.
  if (GetActorProperty(0, APROP_Health) > 0)
    UH_BubbleClearOwned(1, 1);
  else
    UH_BubbleClearOwned(1, 0);
}

// Lifecycle entry point for ENTER, RESPAWN, DEATH, morph and revival paths.
// It is idempotent and safe on a body that never had Bubble.
script "uh_BubbleClearLifecycle" (void) {
  if (PlayerNumber() < 0)
    terminate;
  // Lifecycle cleanup is silent. It must not play a release sound on map
  // entry, respawn, morph or death when no active instance is ending.
  UH_BubbleClearOwned(1, 0);
}

// Post-armor damage event.  GAMEEVENT_ACTOR_DAMAGED is dispatched only after
// armor and only when the remaining damage is positive, so this event is the
// effective-damage gate.  The type argument is the engine damage type name.
script "uh_BubbleDamageEvent" (int evt, int dmg, int dmgtype) EVENT {
  if (evt != GAMEEVENT_ACTOR_DAMAGED)
    terminate;
  if (GetEventResult() <= 0)
    terminate;
  if (!SetActivator(0, AAPTR_DAMAGE_TARGET))
    terminate;
  if (PlayerNumber() < 0)
    terminate;
  if (GetActorProperty(0, APROP_Health) <= 0)
    terminate;

  // Snapshot at the start of this event.  A target that was already bubbled
  // breaks and never reapplies in the same event, even when the hit carries
  // the Bubble damage type.
  if (CheckInventory("UH_Bubble_F") > 0) {
    // A lethal break clears the status, but the death lifecycle owns the end of
    // this life.  Keep the release sound for a surviving break only.
    UH_BubbleClearOwned(1, GetEventResult() < GetActorProperty(0, APROP_Health));
    terminate;
  }

  if (!UH_BubbleDamageCarriesStatus(dmgtype))
    terminate;
  if (!UH_BubbleCanApply())
    terminate;

  // A lethal hit leaves no living player to bubble.  Buddha and extra-life
  // rescues are intentionally not consulted here; they can keep the player
  // alive without the status.
  if (GetEventResult() >= GetActorProperty(0, APROP_Health))
    terminate;

  UH_BubbleApply();
}

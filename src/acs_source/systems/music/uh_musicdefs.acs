script "uh_define_vanilla_boss_music" OPEN {
	int t;
	if (!UHInPlay()) terminate;
	UH_RegisterWinLossMusic();
	UH_RegisterLMSMusic();
	t = 0;
	while (UH_FindBossByActor("TrueBusterExpert") == UHBOSS_FAIL && t < 35) {
		Delay(1);
		t++;
	}
	Uh_RegisterBossMusicExtras();
}

script "uh_define_vanilla_boss_music_cs" OPEN CLIENTSIDE {
	int t;
	UH_RegisterWinLossMusic();
	UH_RegisterLMSMusic();
	t = 0;
	while (UH_FindBossByActor("TrueBusterExpert") == UHBOSS_FAIL && t < 35) {
		Delay(1);
		t++;
	}
	Uh_RegisterBossMusicExtras();
}

function void UH_RegisterWinLossMusic(void) {
	UH_RegisterWinnerMusic();
	UH_RegisterLoserMusic();
}

function void UH_RegisterLMSMusic(void) {
	AddLMSMusic(0, "M_LMS0", "Megaman X - Vile Battle Theme", 1, 0);
	AddLMSMusic(1, "M_LMS1", "Marvel vs. Capcom 1 - Theme of Hidden Character", 1, 0);
	AddLMSMusic(2, "M_LMS2", "SSF2 Turbo Revival - Akuma's Theme (Sped-up)", 1, 0);
	AddLMSMusic(3, "M_LMS3", "Street Fighter 2 - Ken's Theme (Low Health)", 1, 0);
	AddLMSMusic(4, "M_LMS4", "Dynamite Headdy - Hustle Maruyama (Maruyama 2)", 1, 0);
	AddLMSMusic(5, "M_LMS5", "Fighter's History Dynamite - Mizoguchi Theme (HURRY UP)", 1, 0);
	AddLMSMusic(6, "M_LMS6 9", "Captain Tsubasa 2 - Japanese Team", 1, 0);
	AddLMSMusic(7, "M_LMS7", "Kirby Super Star - Taking Over the Halberd", 1, 0);
	AddLMSMusic(7, "M_LMS7X", "Kirby Super Star - Taking Over the Halberd (danooct1 VRC6 Cover)", 1, 0);
	AddLMSMusic(8, "M_LMS8", "Override: Mission Code -Override- Stage 6", 1, 0);
	AddLMSMusic(9, "M_LMS9", "Undertale - Death by Glamour (SilvaGunner Beta Mix)", 1, 0);  // https://www.youtube.com/watch?v=N3dzhNbYuTY
	AddLMSMusic(9, "M_LMS9X", "Power Drive - Race BGM 5", 1, 0);
	AddLMSMusic(10, "M_LMS10", "Puggsy - If Looks Could Kill", 1, 0);
	AddLMSMusic(11, "M_LMS11", "Blue Archive - Theme 07 - Unwelcome School (JX Genesis Cover)", 1, 0);
	AddLMSMusic(11, "M_LMS11X", "Slam Dunk - Kyougou Makkou Taiketsu! - Track 19", 1, 0);
}


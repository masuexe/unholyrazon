function void UH_RegisterWinLossMusic(void) {
	UH_RegisterWinnerMusic();
	UH_RegisterLoserMusic();
}

function void UH_RegisterLMSMusic(void) {
	AddLMSMusic(0, "M_LMS0","Vile Battle Theme","Megaman X","Setsuo Yamamoto", 1, 0);
	AddLMSMusic(1, "M_LMS1","Theme of Hidden Character","Marvel vs. Capcom 1","Masato Kouda", 1, 0);
	AddLMSMusic(2, "M_LMS2","Akuma's Theme (Sped-up)","SSF2 Turbo Revival","Shinji Hosoe", 1, 0);
	AddLMSMusic(3, "M_LMS3","Ken's Theme (Low Health)","Street Fighter 2","Yoko Shimomura", 1, 0);
	AddLMSMusic(4, "M_LMS4","Hustle Maruyama (Maruyama 2)","Dynamite Headdy","Katsuhiko Suzuki", 1, 0);
	AddLMSMusic(5, "M_LMS5","Mizoguchi Theme (HURRY UP)","Fighter's History Dynamite","Hiroaki Yoshida", 1, 0);
	AddLMSMusic(6, "M_LMS6 9","Japanese Team","Captain Tsubasa 2","Keiji Yamagishi, Mayuko Okamura", 1, 0);
	AddLMSMusic(7, "M_LMS7","Taking Over the Halberd","Kirby Super Star","Jun Ishikawa, Hirokazu Ando", 1, 0);
	AddLMSMusic(7, "M_LMS7X","Taking Over the Halberd (danooct1 VRC6 Cover)","Kirby Super Star","danooct1", 1, 0);
	AddLMSMusic(8, "M_LMS8","Mission Code -Override- Stage 6","Override","Yasue Santo", 1, 0);
	AddLMSMusic(9, "M_LMS9","Death by Glamour (SilvaGunner Beta Mix)","Undertale","SiivaGunner", 1, 0);  // https://www.youtube.com/watch?v=N3dzhNbYuTY
	AddLMSMusic(9, "M_LMS9X","Race BGM 5","Power Drive","Barry Leitch", 1, 0);
	AddLMSMusic(10, "M_LMS10","If Looks Could Kill","Puggsy","Matt Furniss", 1, 0);
	AddLMSMusic(11, "M_LMS11","Theme 07 - Unwelcome School (JX Genesis Cover)","Blue Archive","JX", 1, 0);
	AddLMSMusic(11, "M_LMS11X","Track 19","Slam Dunk - Kyougou Makkou Taiketsu!","Yoko Wada", 1, 0);
	AddLMSMusic(12, "M_LMS12","Friendly Fight (Player Phase 1)","Warsong (Langrisser)","Noriyuki Iwadare", 1, 0);
}

script "uh_define_vanilla_boss_music" OPEN {
	if (!UHInPlay()) terminate;
	UH_RegisterWinLossMusic();
	UH_RegisterLMSMusic();
}

script "uh_define_vanilla_boss_music_cs" OPEN CLIENTSIDE {
	UH_RegisterWinLossMusic();
	UH_RegisterLMSMusic();
}

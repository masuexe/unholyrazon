#library "uh_lmsdefs"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"

// Vanilla LMS events 0–12 (messages/drops/flags). Music seeds stay in UH_MUSICDEFS.
// Drops bind by stem. OPEN order is not LOADACS order — no actor wait required.

function void UH_RegisterVanillaLMSEvents(void) {
  DefineLMSEvent(0, "lms0",
    "\cgOnly death can save you now...",
    "ITS NO USE! Only death can save you now...",
    "\cuOnly death can save you \cgNOW\cu...",
    "", "", "LMS_B#0", 0, 0, 1);
  AddLMSEventDrop("lms0", "GUHUItem", 1, 0);
  AddLMSEventDrop("lms0", "SuperGUHUItem", 1, 1);
  AddLMSEventPenaltyDrop("lms0", "AutoSuperGUHUItem", 1, UHLMS_PENALTY_SURVIVOR);

  DefineLMSEvent(1, "lms1",
    "\cfGO FOR BROKE!",
    "\cfGO FOR BROKE! x2!",
    "\cfGO FOR BEING BROKEN!",
    "", "", "LMS_B#1", 0, 0, 1);
  AddLMSEventDrop("lms1", "SuperMysticTankItem", 1, 0);
  AddLMSEventDrop("lms1", "SuperMysticTankItem", 1, 1);
  AddLMSEventDrop("lms1", "PeriwinkleTankItem", 1, 1);
  AddLMSEventPenaltyDrop("lms1", "PowerLMSBadProtection", 1, UHLMS_PENALTY_SURVIVOR);

  DefineLMSEvent(2, "lms2",
    "\cgScissors61.exe achieved!",
    "\cdScissors61.exe hacked!",
    "\ciScissors61.exe corrupted!",
    "", "", "LMS_B#2", 0, 0, 1);
  AddLMSEventDrop("lms2", "UnholyWaterItem", 1, 0);
  AddLMSEventDrop("lms2", "MountainDewItem", 1, 1);
  AddLMSEventPenaltyDrop("lms2", "BadEventBossProtection", 1, UHLMS_PENALTY_BOSSES);

  DefineLMSEvent(3, "lms3",
    "Only one remains!",
    "Only one chance remains!",
    "Only one remains!",
    "", "", "LMS_B#3", 0, 0, 1);
  // Normal fire: no item. Rare: Tank of Wonders.
  AddLMSEventDrop("lms3", "TankOfWondersItem", 1, 1);

  DefineLMSEvent(4, "lms4",
    "\ctWASPS",
    "\cfWASP?!",
    "\ctWASP!!",
    "", "", "LMS_B#4", 0, 0, 1);
  AddLMSEventDrop("lms4", "WaspBombItem", 9, 0);
  AddLMSEventDrop("lms4", "GoldenWaspBombItem", 1, 1);
  AddLMSEventPenaltyDrop("lms4", "GoldenWaspBombItem", 1, UHLMS_PENALTY_BOSSES);

  DefineLMSEvent(5, "lms5",
    "\ciQuick! Gamble your boxes!",
    "\ciQuick! Gamble your \cfBOX\ci!",
    "\cuQuick! Clear your stuff!",
    "", "", "LMS_B#5", 0, UHLMS_PENALTY_CLEAR_ITEMS, 1);
  AddLMSEventDrop("lms5", "PandoraBoxItem", 3, 0);
  AddLMSEventDrop("lms5", "MysticBoxItem", 1, 1);

  DefineLMSEvent(6, "lms6",
    "\chUse every bit of firepower you have!",
    "\chUse every bit of \cfBEES\ch you have!",
    "\chDodge their endless firepower!",
    "", "", "LMS_B#6", 0, 0, 1);
  AddLMSEventDrop("lms6", "BluntRocketItem", 12, 0);
  AddLMSEventDrop("lms6", "SharpRocketItem", 2, 0);
  AddLMSEventDrop("lms6", "BEESItem", 3, 1);
  AddLMSEventPenaltyDrop("lms6", "InfiniteRocketItem", 1, UHLMS_PENALTY_BOSSES);

  DefineLMSEvent(7, "lms7",
    "\cdSudden magical food! Eat up!",
    "\cdSudden majestical food! Dig in!",
    "\cdSudden magical food on them!",
    "", "", "LMS_B#7", 0, 0, 1);
  AddLMSEventDrop("lms7", "PancakeFoodItem", 1, 0);
  AddLMSEventDrop("lms7", "CakeFoodItem", 1, 0);
  AddLMSEventDrop("lms7", "HotdogFoodItem", 1, 0);
  AddLMSEventDrop("lms7", "SundaeFoodItem", 1, 1);
  AddLMSEventDrop("lms7", "HamburgerFoodItem", 1, 1);
  AddLMSEventPenaltyDrop("lms7", "PancakeFoodItem", 1, UHLMS_PENALTY_BOSSES);
  AddLMSEventPenaltyDrop("lms7", "CakeFoodItem", 1, UHLMS_PENALTY_BOSSES);
  AddLMSEventPenaltyDrop("lms7", "HotdogFoodItem", 1, UHLMS_PENALTY_BOSSES);
  AddLMSEventPenaltyDrop("lms7", "SundaeFoodItem", 1, UHLMS_PENALTY_BOSSES);
  AddLMSEventPenaltyDrop("lms7", "HamburgerFoodItem", 1, UHLMS_PENALTY_BOSSES);

  DefineLMSEvent(8, "lms8",
    "\ciThere's no escaping banana!",
    "\csHUT HUT HUT!",
    "\ciThere's no escaping bananas!!",
    "", "", "LMS_B#8", 0, 0, 1);
  AddLMSEventDrop("lms8", "RubberBandItem", 1, 0);
  AddLMSEventDrop("lms8", "TheFootBallItem", 1, 1);
  AddLMSEventPenaltyDrop("lms8", "InfiniteRubberBandItem", 1, UHLMS_PENALTY_BOSSES);

  DefineLMSEvent(9, "lms9",
    "\cuFabulous secret powers are revealed to you!",
    "\cuYou have the \cgPOWER\cu!",
    "\cuFabulous secret powers are revealed to them!",
    "", "", "LMS_B#9", UHLMS_FLAG_DUALRUNE, 0, 1);
  // Dual-rune only — no item drops.

  DefineLMSEvent(10, "lms10",
    "\csGive them a taste!",
    "\cgYou will... DIE!",
    "\csGive yourself a darkness...",
    "", "", "LMS_B#10", 0, 0, 1);
  AddLMSEventDrop("lms10", "HackyCoffeeItem", 1, 0);
  AddLMSEventDrop("lms10", "YouWillDieItem", 1, 1);
  AddLMSEventPenaltyDrop("lms10", "PowerLMSDarkness", 1, UHLMS_PENALTY_SURVIVOR);

  DefineLMSEvent(11, "lms11",
    "\cdHave a quiet life.",
    "\cqH\cdE\cqR\cdE \cqW\cdE \cqG\cdO!",
    "\c[g8]Have a quiet horselife.",
    "", "", "LMS_B#11", 0, 0, 1);
  AddLMSEventDrop("lms11", "DickheadItem", 1, 0);
  AddLMSEventDrop("lms11", "TruePowerItem", 1, 1);
  AddLMSEventPenaltyDrop("lms11", "HorseMorphGiver", 1, UHLMS_PENALTY_SURVIVOR);

  DefineLMSEvent(12, "lms12",
    "\c[r4]Time to test your luck!",
    "\c[n2]ERROR: Invalid LMS Event",
    "\c[g9]What are these bad guys?!",
    "", "", "LMS_B#12", 0, 0, 1);
  AddLMSEventDrop("lms12", "ChanceBoxItem", 3, 0);
  AddLMSEventDrop("lms12", "DeleteThisItem", 2, 1);
  AddLMSEventPenaltyDrop("lms12", "LMSBadGuyAppears_P", 1, UHLMS_PENALTY_SURVIVOR);

  // Shared fallback for events using UHLMS_PENALTY_USE_DEFAULT.
  SetDefaultLMSEventPenalty("\chBad LMS!", "LMS_B#0", 0);
  AddLMSEventPenaltyDrop("", "PowerLMSBadProtection", 1, UHLMS_PENALTY_SURVIVOR);
  AddLMSEventPenaltyDrop("", "LMSBadGuyAppears_P", 1, UHLMS_PENALTY_SURVIVOR);
}

script "uh_define_vanilla_lms" OPEN {
  if (!UHInPlay()) terminate;
  UH_RegisterVanillaLMSEvents();
}

script "uh_define_vanilla_lms_cs" OPEN CLIENTSIDE {
  UH_RegisterVanillaLMSEvents();
}

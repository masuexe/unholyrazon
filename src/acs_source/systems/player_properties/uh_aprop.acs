// IDEA: is it possible to move extralife system from weapon to class itself?

#define ELP_NATIVE 0
#define ELP_INSURANCE 1
#define ELP_MORTIS 2
#define ELP_FLOOVY_G 3
#define ELP_FLOOVY_D 4
// Player Extra Life stacker
// Set player to 0 for the activator or specify a player number
script "uh_extralifeplayer" (int player, int toggle, int type) {
	if (player == 0) {player = PlayerNumber() + 1;}
	if (player <= 0 ||!SetActivatorToPlayer(player - 1)) {terminate;}

	str extralifename;
	switch (type) {
		default:
		case ELP_NATIVE:
			extralifename = "PlayerPropertyExtraLifeNative";
			break;
		case ELP_INSURANCE:
			extralifename = "PlayerPropertyExtraLifeUnholyInsurance";
			break;
		case ELP_MORTIS:
			extralifename = "PlayerPropertyExtraLifeMortis";
			break;
		case ELP_FLOOVY_G:
			extralifename = "PlayerPropertyExtraLifeFloovyG";
			break;
		case ELP_FLOOVY_D:
			extralifename = "PlayerPropertyExtraLifeFloovyD";
			break;
	}

	if (toggle >= 1) {
		GiveInventory(extralifename, toggle);
		GiveInventory("PlayerPropertyExtraLife", toggle);
		GiveInventory("PlayerPropertyBuddha", toggle);
		GiveInventory("PlayerPropertyBuddhaOn", 1);
	} else if (CheckInventory(extralifename) > 0) {
		TakeInventory(extralifename, 1);
		TakeInventory("PlayerPropertyExtraLife", 1);
		TakeInventory("PlayerPropertyBuddha", 1);
		if (CheckInventory("PlayerPropertyBuddha") == 0) {
			GiveInventory("PlayerPropertyBuddhaOff", 1);
		}
	}
}

#define HPBUG_TAKE 0
#define HPBUG_ADD 1
#define HPBUG_CLEAR -1

script "rz_HPBugPlayer" (int player, int toggle) {
	if (player == 0) {player = PlayerNumber() + 1;}
	if (player <= 0 ||!SetActivatorToPlayer(player - 1)) {terminate;}

	if (toggle < 0) {
		TakeInventory("PlayerPropertyHPBug", 24);
		terminate;
	}
	if (toggle >= 1) {
		GiveInventory("PlayerPropertyHPBug", 1);
		ACS_NamedExecuteAlways("rz_HPBugDrain", 0);
	} else if (CheckInventory("PlayerPropertyHPBug") > 0) {
		TakeInventory("PlayerPropertyHPBug", 1);
	}
}

script "rz_HPBugDrain" (void) {
	if (CheckInventory("PlayerPropertyHPBugRunning"))
		terminate;
	GiveInventory("PlayerPropertyHPBugRunning", 1);
	while (CheckInventory("PlayerPropertyHPBug") > 0) {
		int stacks = CheckInventory("PlayerPropertyHPBug");
		// 1 stack: every 24 tics -1; more stacks → shorter period (faster bleed), capped by maxamount
		int period = 24 - stacks;  // 24 / stacks;
		if (period < 1)
			period = 1;
		Delay(period);
		stacks = CheckInventory("PlayerPropertyHPBug");
		if (stacks <= 0)
			break;
		int h = GetActorProperty(0, APROP_HEALTH);
		if (h > 1)
			SetActorProperty(0, APROP_HEALTH, h - 1);
	}
	TakeInventory("PlayerPropertyHPBugRunning", 1);
}



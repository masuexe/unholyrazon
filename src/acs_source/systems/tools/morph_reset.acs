// Morph resets APROP_Gravity; core_commonwater only re-applies on feet/eyes transitions.
script "uh_IsUnderWaterGravity" (void) {
  if (PlayerNumber() == -1)
    terminate;
  if (CheckInventory("IsUnderWater") || CheckInventory("HasFeetInWater")) {
    ACS_NamedExecuteWithResult("core_watergravity", 0);
    ACS_NamedExecuteAlways("core_watergravity", 0, 1);
  }
}

// Rebuild DefaultProperties from current actor (Bearer copy of PUAPROP; avoids core_defineaproppowers spawn-invuln).
function void DefineDefaultProperties(void) {
  int p = PlayerNumber();
  if (p < 0)
    return;
  for (int i = 0; i < MAX_PROPS; i++) {
    int prop = getPropertyFromIndex(i);
    if (prop == CAPROP_AirJumpZ) {
      defaultproperties[p][i] = (CheckInventory("AirJumpZ") * 1.0) + FixedDiv(CheckInventory("AirJumpZDecimal") * 1.0, 10000.0);
      if (defaultproperties[p][i] == 0.0)
        defaultproperties[p][i] = GetActorProperty(0, APROP_JumpZ);
      ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_AirJumpZ, defaultproperties[p][i]);
    }
    else if (prop == CAPROP_WallJumpZ) {
      defaultproperties[p][i] = (CheckInventory("WallJumpZ") * 1.0) + FixedDiv(CheckInventory("WallJumpZDecimal") * 1.0, 10000.0);
      if (defaultproperties[p][i] == 0.0)
        defaultproperties[p][i] = GetActorProperty(0, APROP_JumpZ);
      ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_WallJumpZ, defaultproperties[p][i]);
    }
    else
      defaultproperties[p][i] = GetActorProperty(0, prop);
  }
}

// Jump-inventory snapshot taken before a morph.  BasicBossItem wipes
// AirJumpLimit/WallJumpLimit and the boss setup grants its own amount;
// P_UndoPlayerMorph then transfers the morph pawn's inventory back, so the
// survivor's original values must be saved here and restored in
// uh_MorphDemorphReset.  Do not blanket-zero on demorph: survivors can
// legitimately own air/wall jumps via Player.StartItem (AeroUnit, GreenElf,
// SamuraiSam, Kate, ...).
// Plain top-level int arrays are per-module map variables (MapVarStore): kept
// for the current level only, not synced to clients.  The snapshot is server
// side and lives for a single unmorph, so world/global storage is unnecessary.
int uh_morphsavedairjump[MAX_PLAYERS];
int uh_morphsavedwalljump[MAX_PLAYERS];

function void UH_SaveMorphJumpInventory(void) {
  int p = PlayerNumber();
  if (p < 0 || p >= MAX_PLAYERS)
    return;
  uh_morphsavedairjump[p] = CheckInventory("AirJumpLimit");
  uh_morphsavedwalljump[p] = CheckInventory("WallJumpLimit");
}

function void UH_RestoreMorphJumpInventory(void) {
  int p = PlayerNumber();
  if (p < 0 || p >= MAX_PLAYERS)
    return;
  SetInventory("AirJumpLimit", uh_morphsavedairjump[p]);
  SetInventory("WallJumpLimit", uh_morphsavedwalljump[p]);
}

// GenericBoss owns at most one DisabledAirJumps stack while morphed, marked by
// GenericBossAirDisable_F.  Its weapon's Deselect_ClearAir does not run on
// UnMorphActor or on a direct re-morph, so the morph pipeline clears only that
// owned stack; an external DisabledAirJumps without the flag is left untouched.
function void UH_ClearGenericBossAirDisable(void) {
  if (CheckInventory("GenericBossAirDisable_F") > 0) {
    TakeInventory("DisabledAirJumps", 1);
    TakeInventory("GenericBossAirDisable_F", 1);
  }
}

// Pre-MorphActor: flag sweeps + strip jump-mod inventory (Bearer CTF morph).
script "uh_MorphPreReset" (void) {
  if (PlayerNumber() == -1)
    terminate;
  ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
  UH_ClearGenericBossAirDisable();
  UH_SaveMorphJumpInventory();
  GiveInventory("UH_MorphFlagReset_P", 1);
  GiveInventory("Core_MorphFlagReset_P", 1);
  GiveInventory("Core_MorphFlagReset2_P", 1);
  TakeInventory("AirJumpZ", 99999);
  TakeInventory("AirJumpZDecimal", 99999);
  TakeInventory("WallJumpZ", 99999);
  TakeInventory("WallJumpZDecimal", 99999);
  TakeInventory("AirJumpsUsed", 99999);
  TakeInventory("WallJumpsUsed", 99999);
}

// Post-MorphActor: redefine defaults → strip PowerAprop → water gravity.
// arg0 force: 1 = always run; 0 = skip if UH_MorphPipelineDone_F (PowerMorph / Ready re-entry).
script "uh_MorphPostReset" (int force) {
  if (PlayerNumber() == -1)
    terminate;
  if (!force && CheckInventory("UH_MorphPipelineDone_F"))
    terminate;

  ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
  DefineDefaultProperties();
  GiveInventory("UH_MorphPowerPropReset_P", 1);
  ACS_NamedExecuteAlways("uh_IsUnderWaterGravity", 0);
  GiveInventory("UH_MorphPipelineDone_F", 1);
}

script "uh_MorphDemorphReset" (void) {
  if (PlayerNumber() == -1)
    terminate;
  ACS_NamedExecuteWithResult("rz_ClearForcedPlayerSkin");
  UH_ClearGenericBossAirDisable();
  UH_RestoreMorphJumpInventory();
  TakeInventory("AirJumpsUsed", 99999);
  TakeInventory("WallJumpsUsed", 99999);
  GiveInventory("UH_UnMorphSuperFlagReset_P", 1);
  TakeInventory("BAWS", 1);
  TakeInventory("MorphedFlag", 1);
  TakeInventory("IsAnEye", 1);
  TakeInventory("TruePowerItemFlag", 1);
  TakeInventory("UH_MorphPipelineDone_F", 1);
  DefineDefaultProperties();
  GiveInventory("UH_MorphPowerPropReset_P", 1);
  ACS_NamedExecuteAlways("uh_IsUnderWaterGravity", 0);
}

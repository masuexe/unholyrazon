#define CAPROP_AirJumpZ 64
#define CAPROP_WallJumpZ 65

script "uh_IsBot" (void) {
  SetResultValue(PlayerIsBot(PlayerNumber()) || CheckInventory("IsBot"));
}

script "uh_SyncPitchFix" (void) {
  SetActorPitch(0, GetActorPitch(0));
}

// Used to adjust deselect Death
script "uh_IsItOnline" (void) {
  if (IsNetworkGame()) {
    SetResultValue(0);
  }
}

// This is for projectiles to check if their owner spectated, disconnected, or is dead.
script "uh_PointerExists" (int point) {
  SetActivator(0, point);
  // log(s:"Player #? ",i:PlayerInGame(PlayerNumber()));
  // log(s:"Is Dead? ",i:CheckInventory("IsDead"));
  // log(s:"In Game? ",i:PlayerInGame(PlayerNumber()));
  if (PlayerNumber() == -1 || CheckInventory("IsDead") || !PlayerInGame(PlayerNumber())) {
    SetResultValue(0);
  }
}

script "uh_IsPlayerAlive" (int tid) {
  SetActivator(tid);
  if (PlayerNumber() == -1 || CheckInventory("IsDead") || !PlayerInGame(PlayerNumber())) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

// True while the pointed player is a live, real boss.  The MorphedFlag test is
// what makes boss helper actors and DECORATE watchers retire when a shadow
// fakeout unmorphs their owner mid-action: IsAFakeBoss only marks the decoy, so
// without it a Cloak/Smoke/Rooted/Rage watcher keeps following the demorphed
// survivor until that player dies.  A real morphed boss always carries
// MorphedFlag (uh_bosscore.acs, uh_events.acs), and it is removed by
// uh_MorphDemorphReset.
script "uh_PointerIsABoss" (int pointer) {
  SetActivator(0, pointer);
  if (PlayerNumber() == -1 || CheckInventory("IsDead") ||
      !PlayerInGame(PlayerNumber()) || CheckInventory("IsAFakeBoss") ||
      !CheckInventory("MorphedFlag")) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

// Only use for weapon flash states
script "uh_PointerIsABoss_CheckInv" (int pointer) {
  SetActivator(0, pointer);
  if (CheckInventory("IsDead") || CheckInventory("IsAFakeBoss")) {
    SetResultValue(0);
    terminate;
  }
  SetResultValue(1);
}

script "uh_PointerMorphed" (int point) {
  SetActivator(0, point);
  SetResultValue(CheckInventory("MorphedFlag"));
}

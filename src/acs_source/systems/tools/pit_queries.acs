// UH_TOOLS owns the 8BDT bridge; class libraries must not import it alongside
// UHDT. Match CBM's cbm_checkDamagingPit; zero-damage pits are excluded.
script "uh_CheckDamagingPit" (int tid) {
  int pit = getPitByTID(tid);
  if (pit == -1) {
    SetResultValue(false);
    terminate;
  }
  SetResultValue(getPitDamage(pit) != 0);
}

// Razon 3 ub_countinv_acs case 52: ordinary note rolls convert rage to luck.
// The rare branch bypasses this call and preserves the accumulated rage.
// Weapon / CustomInventory expressions cannot directly read a player-class
// user variable; resolve it on their player activator through ACS instead.
script "rz_GetUserVar_user_harpstrummluck" (void) {
  SetResultValue(GetUserVariable(0, "user_harpstrummluck"));
}

script "rz_HarpStrummConsumeLuckCharge" (void) {
  int luck = CheckInventory("UnholyPower1500") / 10;
  TakeInventory("UnholyPower1500", 1500);
  SetResultValue(luck);
}

#library "rz_countinv"
#include "zcommon.acs"

function int CheckPointerInventory(str invname, int pointer) {
  if (pointer > 0) {
    SetActivator(0, pointer);
  }
  return CheckInventory(invname);
}

script "rz_CountInv_WeaponCharge" (int pointer) {
  SetResultValue(CheckPointerInventory("WeaponCharge", pointer));
}
script "rz_CountInv_Neru_Rage_Stacker" (int pointer) {
  SetResultValue(CheckPointerInventory("Neru_Rage_Stacker", pointer));

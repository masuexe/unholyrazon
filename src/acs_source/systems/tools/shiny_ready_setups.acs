// Initial shiny actions run on the server after the morph reset.
function void UH_SetupShinyReady(void) {
  if (CheckInventory("UH_ShinySetupDone_F")) return;
  GiveInventory("UH_ShinySetupDone_F", 1);
  str actor = GetActorClass(0);
  if (!StrICmp(actor, "BlueValkyrieShiny")) { GiveInventory("UH_BlueValkyrieShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "GreenElfShiny")) { GiveInventory("UH_GreenElfShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "RageUnitShiny")) { GiveInventory("UH_RageUnitShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "HandyManShiny")) { GiveInventory("UH_HandyManShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "ZangiefShiny")) { GiveInventory("UH_ZangiefShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "MarksmanShiny")) { GiveInventory("UH_MarksmanShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "MegaManUShiny")) { GiveInventory("UH_MegaManUShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "AmberShiny")) { GiveInventory("UH_AmberShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "ArchivistShiny")) { GiveInventory("UH_ArchivistShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "RedWarriorShiny")) { GiveInventory("UH_RedWarriorShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "RamesesShiny")) { GiveInventory("UH_RamesesShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "MiuShiny")) { GiveInventory("UH_MiuShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "CloseCombatUnitShiny")) { GiveInventory("UH_CloseCombatUnitShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "LuckyLassShiny")) { GiveInventory("UH_LuckyLassShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "SiteWorkerShiny")) { GiveInventory("UH_SiteWorkerShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "PartyBomberShiny")) { GiveInventory("UH_PartyBomberShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "BusterMistressShiny")) { GiveInventory("UH_BusterMistressShiny_MorphSetup_P", 1); return; }
  if (!StrICmp(actor, "GreatShielderShiny")) { GiveInventory("UH_GreatShielderShiny_MorphSetup_P", 1); return; }
}

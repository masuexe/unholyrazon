// Generic actor-property and TID-availability helpers.
// Fragment of library RZ_TOOLS (aggregator: systems/tools/rz_tools.acs).

// Set div to 0 to set integer properties like ReactionTime
script "rz_setactorproperty" (int prop, int mult, int div) {
  if (div == 0) SetActorProperty(0, prop, mult);
	else SetActorProperty(0, prop, 1.0 * mult / div);
}

// C396 uses fixed per-player endpoint TIDs and waits for its counterpart.
script "rz_IsTIDUsed" (int tid) {
  SetResultValue(IsTIDUsed(tid));
}

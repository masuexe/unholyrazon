// DTADD (CORE8BDT) read access for uh_StripSurvivorWeps.
// Lives in UH_TOOLS — the only UH library importing 8bdt.acs: importing both
// 8bdt and uhdt into one module collides on getItemName/getItemActor (ACC
// identifiers are case-insensitive; v6b's compiled CORE8BDT.o pins the 8bdt
// names, so 8bdt must stay out of uhdt-importing modules).
// Uses the shared uh_dsw_out_str scratch cvar (sequential readers only).

script "uh_GetDTADDWepActor_S" (int idx) {
	SetCVarString("uh_dsw_out_str", getWeaponActor(idx));
}

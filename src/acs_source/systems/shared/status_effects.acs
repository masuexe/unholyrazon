script "uh_PoisonControl_acs" (int which, int style, int change) {
  // Log(s:"uh_PoisonControl_acs(",i:which,s:", ",i:Style,s:", ",i:Change,s:")");
  int sourcetid = ACS_NamedExecuteWithResult("core_getptrtid", 2);  // Caused the poison
  int poisonedtid = ACS_NamedExecuteWithResult("core_getptrtid", 8);  // player being poisoned
  if (sourcetid < 1000 || sourcetid > 1063) {  // End if not a player TID
    SetResultValue(-1);
    terminate;
  }
  sourcetid -= 1000;
  str theclass;
  switch (which) {
    case 17:
      theclass = "Raider_Poison";
      break;
    case 6100:
      theclass = "Hellbot_Poison";
      break;
    case 6056:
      theclass = "Morshu_Burn";
      break;
  }
  str spawnname = StrParam(s:"user_", s:theclass);  // ,s:"_OnFire"

  int result = GetUserArray(poisonedtid, spawnname, sourcetid);

  // Log(s:"TID <",i:PoisonedTID,s:"> ",s:spawnname,s:"[",i:SourceTID,s:"] = ",i:Result);
  switch (style) {
    default:
      SetResultValue(-1);
      break;
    case 0:  // Fetch
      SetResultValue(result);
      break;
    case 1:  // Adjust
      SetUserArray(poisonedtid, spawnname, sourcetid, result + change);
      SetResultValue(result + change);
      break;
    case 2:  // Initial Set
      SetUserArray(poisonedtid, spawnname, sourcetid, change);
      SetResultValue(result <= 0);
      break;
  }
}

script "uh_TimeBenderCameraLook" (void) CLIENTSIDE {
  if (!CheckInventory("TimeBenderCamera_F")) {
    GiveInventory("TimeBenderCamera_F", 1);

    do {
      if (CheckInventory("PlayerPropertyFrozen") < 2) {  // TimeBender applies 1 stack
        SetActorAngle(0, GetActorAngle(0) + GetPlayerInput(-1, INPUT_YAW));
        SetActorPitch(0, GetActorPitch(0) - GetPlayerInput(-1, INPUT_PITCH));
      }
      delay(1);
    } while (GetActorProperty(0, APROP_HEALTH) > 0 && CheckInventory("IsTimeBended_F"));

    TakeInventory("TimeBenderCamera_F", 1);
  }
}

// Flash Stopper script, Random Color version
script "uh_FlashStopperRNG" (int power, int dur, int toggle) CLIENTSIDE {
  int rc;
  int bc;
  int gc;
  switch (toggle) {
    case 3:
      rc = 225;
      bc = 225;
      gc = 225;
      break;
    case 2:
      rc = 45;
      bc = 45;
      gc = 45;
      break;
    case 1:
      rc = 145;
      bc = 145;
      gc = 145;
      break;
    case 0:
      rc = random(0, 255);
      bc = random(0, 255);
      gc = random(0, 255);
      break;
  }

  CancelFade();

  FadeRange(rc, bc, gc, ((1.0) * power) / 100, rc, bc, gc, 0.0, ((1.0) * dur) / 100);
}

function void UH_FloorQuakeDamageCore(int maxrange, int quakepower, str theclass) {
  int usertid = ActivatorTID();
  int userteam = GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM);

  // GetActorClass returns "None" when the activator is no longer valid.
  if (StrICmp(theclass, "None") == 0 || StrCmp(theclass, "") == 0) {
    return;
  }

  str spawnname = StrParam(s:theclass, s:"_FloorQuakeSpawn");
  // Log(s:"maxrange = ",i:maxrange,s:" \\ quakepower = ",i:quakepower);
  // if (quakepower > 255)
  // 	Log(s:"\cg[!] WARNING [!] \cduh_FloorQuakeDamage (quakepower) is too high! Max power is 255!");
  for (int p = 0; p < ServerMAX; p++) {
    if (!PlayerInGame(p)) {continue;}
    if (IsTeamGame) {
      if (userteam == GetPlayerInfo(p, PLAYERINFO_TEAM)) {continue;}
    }
    if (XyDistance(0, p + 1000) < maxrange && Zdistance(0, p + 1000) >= -32 && Zdistance(0, p + 1000) <= 32 && usertid != p + 1000) {
      // Log(s:"xyDist = ",i:XYDistance(0, p+1000),s:" \\ zDist = ",i:ZDistance(0, p+1000));
      // SpawnForced(spawnname,GetActorX(p+1000),GetActorY(p+1000),GetActorZ(p+1000), 0,quakepower);
      SpawnProjectile(usertid, spawnname, quakepower, 0, p, 0, 0);
    }
  }
}

// The generic entry point derives the projectile prefix from the activator.
script "uh_FloorQuakeDamage" (int maxrange, int quakepower) {
  UH_FloorQuakeDamageCore(maxrange, quakepower, GetActorClass(0));
}

// Explicit prefixes cover death/shiny classes and legacy projectile aliases.
script "uh_FloorQuakeDamage_HandymanDeath" (int maxrange, int quakepower) {
  UH_FloorQuakeDamageCore(maxrange, quakepower, "HandymanDeath");
}


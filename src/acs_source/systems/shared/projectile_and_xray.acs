// Projectile Porting
script "uh_ProjectilePort" (int maxdist) {
  int target = ACS_NamedExecuteWithResult("core_getptrtid", 2);

  if (GetActorProperty(0, APROP_HEALTH) <= 0 || GetActorProperty(target, APROP_HEALTH) <= 0) {
    terminate;
  }

  maxdist = maxdist << 16;

  int x_diff = GetActorX(0) - GetActorX(target);
  int y_diff = GetActorY(0) - GetActorY(target);
  int z_diff = GetActorZ(0) - GetActorZ(target);

  if (XYZDistanceFixed(x_diff, y_diff, z_diff) > maxdist) {
    terminate;
  }

  while (true) {
    x_diff += GetActorVelX(0);
    y_diff += GetActorVelY(0);
    z_diff += GetActorVelZ(0);
    SetActorVelocity(target, x_diff, y_diff, z_diff, 0, 0);

    delay(1);

    if (GetActorProperty(0, APROP_HEALTH) <= 0 || GetActorProperty(target, APROP_HEALTH) <= 0 || CheckInventory("ProjectilePortDead")) {
      // Log(s:"Someone is Dead");
      GiveActorInventory(target, "ProjectilePortDead", 1);
      terminate;
    }
    x_diff = GetActorX(0) - GetActorX(target);
    y_diff = GetActorY(0) - GetActorY(target);
    z_diff = GetActorZ(0) - GetActorZ(target);
    if (XYZDistanceFixed(x_diff, y_diff, z_diff) > maxdist ||  // Log(s:"Someone is too far");
        CheckActorInventory(target, "FlightDisableFlag") >= 1 ||
        CheckActorInventory(target, "TimeStoppedCounter") >= 1) {  // Log(s:"Someone is suffering");
      SetActorState(0, "Death", 1);
      GiveActorInventory(target, "ProjectilePortDead", 1);
      terminate;
    }
  }
}

// PIK
script "ub_enemypain" (void) {
  if (CheckInventory("EnemyHP") > 0) {terminate;}  // Do not run twice for one monster
  int hp = GetActorProperty(0, APROP_Health);
  GiveInventory("EnemyHP", 1);

  while (GetActorProperty(0, APROP_Health) > 0) {
    if (hp != GetActorProperty(0, APROP_Health)) {
      PlayActorSound(0, SOUND_Pain, CHAN_BODY, 1.0, false, ATTN_NORM);
      // SetActorProperty(0, APROP_RenderStyle, STYLE_None);
      // Delay(1);
      // SetActorProperty(0, APROP_RenderStyle, STYLE_Normal); //Comment this back in for a MM style enemy blink damage effect, i guess?
      hp = GetActorProperty(0, APROP_Health);
    }
    Delay(1);
  }
}

// Server-owned markers are replicated with inventory. The single client
// renderer observes them directly, including late joins and pawn changes.
script "UH_BeginXRayVision" (void) {
  if (PlayerNumber() < 0) terminate;
  SetInventory("UH_XRayVisionOn_F", 1);
  NamedExecuteClientScript("UH_EnsureXRayRenderer", PlayerNumber());
}

// Keep the legacy entry point name; two-player X-Ray is now condition-gated.
script "UH_BeginLimitedXRayVision" (void) {
  if (PlayerNumber() < 0) terminate;
  SetInventory("UH_TwoPlayerXRayOn_F", 1);
  NamedExecuteClientScript("UH_EnsureXRayRenderer", PlayerNumber());
}

// OPEN CLIENTSIDE can be missed when joining/resetting a network map. The
// server also requests this when enabling X-Ray. Do not use ExecuteAlways for
// the renderer: repeated delivery must keep one loop owning the HUD ids.
script "UH_EnsureXRayRenderer" (void) CLIENTSIDE {
  ACS_NamedExecute("UH_XRayVisionManager", 0);
}

function void ClearXRayTarget(int tid) {
  HudMessage(s:""; HUDMSG_PLAIN, tid, 0, 0, 0, 0.01);
  HudMessage(s:""; HUDMSG_PLAIN, tid + 100, 0, 0, 0, 0.01);
}

function void ClearAllXRayTargets(void) {
  for (int i = PLN_TID; i < PLN_TID + MAX_PLAYERS; i++) {
    ClearXRayTarget(i);
  }
}

function void UpdateXRayTargets(int viewer) {
  for (int i = PLN_TID; i < PLN_TID + MAX_PLAYERS; i++) {
    int targetPln = i - PLN_TID;
    if (!PlayerInGame(targetPln) || viewer == targetPln) {
      ClearXRayTarget(i);
      continue;
    }

    if (GetActorProperty(i, APROP_Health) <= 0) {
      ClearXRayTarget(i);
      continue;
    }

    int targetAlpha = GetActorProperty(i, APROP_Alpha);
    int targetStyle = GetActorProperty(i, APROP_RenderStyle);
    int isTargetVisible = (targetStyle != STYLE_None && targetAlpha >= 0.9 && !CheckFlag(i, "INVISIBLE"));

    // When the enemy is directly in line of sight and visible, hide X-Ray
    // to avoid obstructing crosshair and target silhouette during combat.
    if (CheckSight(0, i, 1) && isTargetVisible) {
      ClearXRayTarget(i);
      continue;
    }

    HudMessageOnActor(i, i, 640, 480, 0, 0, 9028, -1, StrParam(n:targetPln + 1), 0.1, CR_GREEN, 0);  // Displays nametag
    HudMessageOnActor(i, i + 100, 640, 480, 0, -10, 9028, -1, "", 0.1, CR_GREEN, 1);                  // Displays distance
  }
}

// One renderer owns all X-Ray HUD ids. Ending either source cannot clear
// labels still required by the other; there is no finite display timer.
script "UH_XRayVisionManager" OPEN CLIENTSIDE {
  int viewer;
  bool wasActive = false;
  bool active;
  while (true) {
    viewer = ConsolePlayerNumber();
    active = false;
    if (viewer >= 0 && PlayerInGame(viewer) && SetActivatorToPlayer(viewer)
        && GetActorProperty(0, APROP_Health) > 0) {
      active = CheckInventory("UH_XRayVisionOn_F") > 0
        || CheckInventory("UH_TwoPlayerXRayOn_F") > 0;
    }
    if (active) {
      UpdateXRayTargets(viewer);
    } else if (wasActive) {
      ClearAllXRayTargets();
    }
    wasActive = active;
    Delay(1);
  }
}

function void HudMessageOnActor(int tid, int messageid,
                                int hudx, int hudy, int xoffset, int y_offset,
                                int range, str sprite,
                                str text, int holdtime, str colour, int swap_var) {
  int dist, angle, vang, pitch, x, y;

  if (hudx == 0) {hudx = 640;}
  if (hudy == 0) {hudy = 480;}

  if (sprite != -1) {
    SetFont(sprite);
    text = "A";
    // offset = 0.1;
  }
  else {
    SetFont("fakefntC");  // SMALLFONT
  }

  SetHudSize(hudx, hudy, 1);
  x = GetActorX(tid) - GetActorX(0);
  y = GetActorY(tid) - GetActorY(0);

  vang = VectorAngle(x, y);
  angle = (vang - GetActorAngle(0) + 1.0) % 1.0;

  if (((vang + 0.125) % 0.5) > 0.25) dist = FixedDiv(y, sin(vang));
  else dist = FixedDiv(x, cos(vang));

  if ((angle < 0.2 || angle > 0.8) && (dist >> 16) < range) {
    if (GetActorPitch(0) >= -0.25 && GetActorPitch(0) <= 0.25) {
      int eyeHeight = GetActorProperty(0, APROP_ViewHeight);
      if (eyeHeight <= 0) eyeHeight = 41.0;
      int eyeZ = GetActorZ(0) + eyeHeight;

      int targetHeight = GetActorProperty(tid, APROP_Height);
      if (targetHeight <= 0) targetHeight = 56.0;
      int headZ = GetActorZ(tid) + targetHeight + 12.0;

      pitch = VectorAngle(dist, headZ - eyeZ);
      pitch = (pitch + GetActorPitch(0) + 1.0) % 1.0;
      if (cos(angle) != 0 && cos(pitch) != 0) {  // Fixes divide by zero
        x = hudx / 2 - ((hudx / 2) * sin(angle) / cos(angle));
        y = hudy / 2 - ((hudx / 2) * sin(pitch) / cos(pitch));

        x += xoffset;
        y += y_offset;
        if (swap_var) {
          HudMessage(i:dist >> 16;
                     HUDMSG_PLAIN | HUDMSG_ALPHA | HUDMSG_NOTWITHOVERLAYMAP | HUDMSG_LAYER_UNDERHUD | HUDMSG_NOTWITHFULLMAP,
                     messageid, colour, (x << 16), (y << 16), holdtime, 0.65);
        }
        else {
          HudMessage(s:text;
                     HUDMSG_PLAIN | HUDMSG_ALPHA | HUDMSG_NOTWITHOVERLAYMAP | HUDMSG_LAYER_UNDERHUD | HUDMSG_NOTWITHFULLMAP,
                     messageid, colour, (x << 16), (y << 16), holdtime, 0.65);
        }
        return;
      }
    }
  }

  HudMessage(s:""; HUDMSG_PLAIN, messageid, 0, 0, 0, 0.01);
}

#library "uh_bonusdefs"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"

// Keep in sync with MULTIB_PLAYERLIMIT3 in uh_def.acs (the boss-combo family
// still owns that header; definitions libraries cannot include it).
#define BONUS_MINPLAYERS_TIER3 12

// Vanilla bonus events, registered through the dynamic DefineBonusEvent API.
// Stable ids are frozen (v4): 13=Football, 113=Rune FFA, 51/151 force-only.
// Former low/high candidate pools become minPlayers: events 11-16 need
// MULTIB_PLAYERLIMIT3 (12) players to enter the random pool; the rest are
// weight 1 with no player bound.  Force-only rows use weight 0.
// Metadata strings are transcribed verbatim from the former bonuseventlist —
// keep them byte-identical (music, credits, HUD text and balance depend on it).

function void UH_RegisterVanillaBonusEvents(void)
{
	// --- Weighted pool: low-player events (always eligible) -------------------
	DefineBonusEvent(UHEVENT_FFA, "ffa", "Free for All",
		"DIXIEMUS","Link's Tourney (Sped-up)","Mario Golf: Advance Tour","Motoi Sakuraba",
		"", "", "",
		"ub_FreeForAll", "", "",
		0, 0, 0, UHBE_FLAG_FFA, 1, 0, 0);

	DefineBonusEvent(UHEVENT_MLG, "mlg_eyes", "MLG eyes",
		"M_EYE01 10","Enemy Alert Lv.1 Theme","Snake's Revenge (NES)","Tsutomu Ogura",
		"", "\cjMLG Tourney! Last one standing gets paid!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		1, 1, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_GHOST, "ghost_eyes", "Ghost eyes",
		"M_EYE02","Dancing Shy-Guys (Sped-up)","Luigi's Mansion","Kazumi Totaka, Shinobu Tanaka",
		"misc/BOO", "\ccBOO! Haunted House!", "\ccNow please scream.",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		2, 2, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_JOUST, "joust_eyes", "Joust eyes",
		"M_EYE03","Putts Theme (Sped-up)","Mario Golf GBC","Motoi Sakuraba",
		"misc/JoustStart", "\cjDixieland Jousting!!! Now with real \ctDemoneyes\cj begins!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		3, 3, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_SUMO, "sumo_eyes", "Sumo eyes",
		"M_EYE04","Bonus Stage 2","Street Fighter 1","Yoshihiro Sakaguchi",
		"", "\cjLecture 5 start:", "\ccHow to kiss properly.",
		"ub_DemoneyeEvent", "uh_RebuildSumoEye", "",
		4, 4, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_KAMIKAZE, "kamikaze_eyes", "Kamikaze eyes",
		"M_EYE05","Stringent","Mother 3","Shogo Sakai",
		"", "\cg\"Explosive Loving\"", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		5, 5, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_BOMBER, "bomber_eyes", "Bomber eyes",
		"M_EYE07","Battle Theme","Bomberman 2 DS","Keita Hoshi, Shohei Bando",
		"", "\cjBattle Start!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		7, 7, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_BUSINESS, "business_eyes", "Business eyes",
		"M_EYE08","Dance Club","Streets of Rage Remake V5","BGM99",
		"", "\cmTime for a Business meeting!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		8, 8, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_QUICK, "quick_eyes", "Quick eyes",
		"M_EYE09","Turbo Tunnel Race","Battletoads (MD/GEN)","David Wise",
		"", "\cgGotta go fast!", "\cgTime is ticking!",
		"ub_DemoneyeEvent", "uh_RebuildQuickEye", "",
		9, 9, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	DefineBonusEvent(UHEVENT_TANK, "tank_eyes", "Tank eyes",
		"M_EYE10","Colin Theme","Advance Wars 2 Dual Strike","Taishi Senda",
		"", "\cjCONFEDERATE WARFARE!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		10, 10, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);

	// --- Weighted pool: high-player events (>= MULTIB_PLAYERLIMIT3) -----------
	DefineBonusEvent(UHEVENT_EYEPARADE, "demoneye_parade", "Demoneye parade",
		"EYEMUS","Speed Test","Super Mario Sunshine","Koji Kondo, Shinobu Tanaka",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		0, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);

	DefineBonusEvent(UHEVENT_CLONEPARADE, "clone_darkness", "Clone Darkness",
		"CLNEVMUS","Looming Darkness (Sped Up)","Kirby's Return to Dream Land","Jun Ishikawa, Hirokazu Ando",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		1, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);

	DefineBonusEvent(UHEVENT_FOOTBALL, "football_ffa", "\csFree for All",
		"FOOTBALL","Title Theme","John Madden Football '93","Rob Hubbard",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildFootballFFA", "",
		1, 0, 0, UHBE_FLAG_FFA, 1, BONUS_MINPLAYERS_TIER3, 0);

	DefineBonusEvent(UHEVENT_BRICK, "brick_eyes", "Brick eyes",
		"M_EYE14","Stage 1 Theme (Thow 2A03 Remix)","BUTOUDENKI: The Weapon Throwing Hero","Thow",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		14, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);

	DefineBonusEvent(UHEVENT_MOSQUITO, "mosquito_eyes", "Mosquito eyes",
		"M_EYE15 7","Boss Battle 1","G.I.Joe: A Real American Hero","Nobuyuki Shioda",
		"", "Oh no! The room is noisy!", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		15, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);

	DefineBonusEvent(UHEVENT_TYPHOON, "typhoon_eyes", "Typhoon eyes",
		"M_EYE13","Dark Side of Fate (NES 8-bit remix)","Touhou 10: MoF","40nix",
		"", "Typhoon disaster! The parking center is waiting for everyone!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		16, 13, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);

	// --- Force-only (RCON / EX target / morph-failure fallback) ---------------
	DefineBonusEvent(UHEVENT_BOSSEFFA, "boss_ffa", "\cmFree for All",
		"M_LMS777","Frontier Brain Battle","Pok\xE9mon Emerald","Go Ichinose",
		"", "", "",
		"ub_BossFFAEvent", "uh_RebuildBossFFA", "",
		0, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);

	DefineBonusEvent(UHEVENT_TRUEPOWER, "truepower_ffa", "\caF\cgr\cie\cke \cdf\cqo\cnr \cmA\cvl\ctl",
		"HA_BEATO","Stepping Hard Beat","Disgaea 5","Tenpei Sato",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildTruePowerFFA", "",
		100, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);

	DefineBonusEvent(UHEVENT_EYELENTO, "eyelento_of_pain", "Eyelento of Pain",
		"M_EYE11X","Rolento's Theme","Final Fight Arcade","Manami Matsumae",
		"", "", "",
		"ub_EyelentoOfPain", "", "",
		6, 0, 0, UHBE_FLAG_MULTITEAM, 0, 0, 0);

	DefineBonusEvent(UHEVENT_CATCHFURRY, "catch_furry", "Get that Furry",
		"EYEMUS","Speed Test","Super Mario Sunshine","Koji Kondo, Shinobu Tanaka",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		50, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 0, 0, 0);

	DefineBonusEvent(UHEVENT_RUNAWAYFOX, "runaway_fox", "Angry Foxeye",
		"EYEMUS","Speed Test","Super Mario Sunshine","Koji Kondo, Shinobu Tanaka",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		51, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 0, 0, 0);

	DefineBonusEvent(UHEVENT_RUNES, "rune_ffa", "\c[MenuGreen]Free for All",
		"DIXIENUS","Engine Room","Super Bonk","Keiji Ueki, Kennosuke Suemura",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildRuneFFA", "",
		113, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);

	DefineBonusEvent(UHEVENT_SATANSEAL, "satan_seal_ffa", "\cgFree for All",
		"SATANMUS","Hericide (Satan Fight)","The Binding of Isaac: Rebirth","Ridiculon",
		"", "", "",
		"ub_SatanSealFFA", "uh_RebuildSatanSealFFA", "",
		0, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);

	// EX relations (formerly baseId + 100 with threshold 3).  Bound by stem so
	// the core never derives targets from integer arithmetic.
	SetBonusEventEX("ffa", "truepower_ffa", 3);
	SetBonusEventEX("demoneye_parade", "catch_furry", 3);
	SetBonusEventEX("clone_darkness", "runaway_fox", 3);
	SetBonusEventEX("football_ffa", "rune_ffa", 3);
}

script "uh_define_vanilla_bonus" OPEN
{
	if (!UHInPlay()) terminate;
	UH_RegisterVanillaBonusEvents();
}

script "uh_define_vanilla_bonus_cs" OPEN CLIENTSIDE
{
	UH_RegisterVanillaBonusEvents();
}

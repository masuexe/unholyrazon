#library "uh_bonusdefs"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"

// Keep in sync with MULTIB_PLAYERLIMIT3 in uh_def.acs (the boss-combo family
// still owns that header; definitions libraries cannot include it).
#define BONUS_MINPLAYERS_TIER3 12

// Vanilla bonus events, registered through the dynamic DefineBonusEvent API.
// Stable ids are frozen (v4): 13=Football, 113=Rune FFA, 51/151 force-only.
// Former low/high candidate pools become minPlayers: events 11-16 need
// MULTIB_PLAYERLIMIT3 (12) players to enter the random pool; the rest are
// weight 1 with no player bound.  Force-only rows use weight 0.
// Metadata strings are transcribed verbatim from the former bonuseventlist —
// keep them byte-identical (music, credits, HUD text and balance depend on it).

function void UH_RegisterVanillaBonusEvents(void)
{
	int ok;

	// --- Weighted pool: low-player events (always eligible) -------------------
	ok = DefineBonusEvent(UHEVENT_FFA, "ffa", "Free for All",
		"DIXIEMUS", "Mario Golf: Advance Tour - Link's Tourney (Sped-up)",
		"", "", "",
		"ub_FreeForAll", "", "",
		0, 0, 0, UHBE_FLAG_FFA, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register ffa");}

	ok = DefineBonusEvent(UHEVENT_MLG, "mlg_eyes", "MLG eyes",
		"M_EYE01 10", "Snake's Revenge (NES) - Enemy Alert Lv.1 Theme",
		"", "\cjMLG Tourney! Last one standing gets paid!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		1, 1, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register mlg_eyes");}

	ok = DefineBonusEvent(UHEVENT_GHOST, "ghost_eyes", "Ghost eyes",
		"M_EYE02", "Luigi's Mansion - Dancing Shy-Guys (Sped-up)",
		"misc/BOO", "\ccBOO! Haunted House!", "\ccNow please scream.",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		2, 2, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register ghost_eyes");}

	ok = DefineBonusEvent(UHEVENT_JOUST, "joust_eyes", "Joust eyes",
		"M_EYE03", "Mario Golf GBC - Putts Theme (Sped-up)",
		"misc/JoustStart", "\cjDixieland Jousting!!! Now with real \ctDemoneyes\cj begins!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		3, 3, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register joust_eyes");}

	ok = DefineBonusEvent(UHEVENT_SUMO, "sumo_eyes", "Sumo eyes",
		"M_EYE04", "Street Fighter 1 - Bonus Stage 2",
		"", "\cjLecture 5 start:", "\ccHow to kiss properly.",
		"ub_DemoneyeEvent", "uh_RebuildSumoEye", "",
		4, 4, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register sumo_eyes");}

	ok = DefineBonusEvent(UHEVENT_KAMIKAZE, "kamikaze_eyes", "Kamikaze eyes",
		"M_EYE05", "Mother 3 - Stringent",
		"", "\cg\"Explosive Loving\"", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		5, 5, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register kamikaze_eyes");}

	ok = DefineBonusEvent(UHEVENT_BOMBER, "bomber_eyes", "Bomber eyes",
		"M_EYE07", "Bomberman 2 DS - Battle Theme",
		"", "\cjBattle Start!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		7, 7, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register bomber_eyes");}

	ok = DefineBonusEvent(UHEVENT_BUSINESS, "business_eyes", "Business eyes",
		"M_EYE08", "Streets of Rage Remake V5 - Dance Club",
		"", "\cmTime for a Business meeting!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		8, 8, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register business_eyes");}

	ok = DefineBonusEvent(UHEVENT_QUICK, "quick_eyes", "Quick eyes",
		"M_EYE09", "Battletoads (MD/GEN) - Turbo Tunnel Race",
		"", "\cgGotta go fast!", "\cgTime is ticking!",
		"ub_DemoneyeEvent", "uh_RebuildQuickEye", "",
		9, 9, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register quick_eyes");}

	ok = DefineBonusEvent(UHEVENT_TANK, "tank_eyes", "Tank eyes",
		"M_EYE10", "Advance Wars 2 Dual Strike - Colin Theme",
		"", "\cjCONFEDERATE WARFARE!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		10, 10, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register tank_eyes");}

	// --- Weighted pool: high-player events (>= MULTIB_PLAYERLIMIT3) -----------
	ok = DefineBonusEvent(UHEVENT_EYEPARADE, "demoneye_parade", "Demoneye parade",
		"EYEMUS", "Super Mario Sunshine - Speed Test",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		0, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register demoneye_parade");}

	ok = DefineBonusEvent(UHEVENT_CLONEPARADE, "clone_darkness", "Clone Darkness",
		"CLNEVMUS", "Kirby's Return to Dream Land - Looming Darkness (Sped Up)",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		1, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register clone_darkness");}

	ok = DefineBonusEvent(UHEVENT_FOOTBALL, "football_ffa", "\csFree for All",
		"FOOTBALL", "John Madden Football '93 - Title Theme",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildFootballFFA", "",
		1, 0, 0, UHBE_FLAG_FFA, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register football_ffa");}

	ok = DefineBonusEvent(UHEVENT_BRICK, "brick_eyes", "Brick eyes",
		"M_EYE14", "BUTOUDENKI: The Weapon Throwing Hero - Stage 1 Theme (Thow 2A03 Remix)",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		14, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register brick_eyes");}

	ok = DefineBonusEvent(UHEVENT_MOSQUITO, "mosquito_eyes", "Mosquito eyes",
		"M_EYE15 7", "G.I.Joe: A Real American Hero - Boss Battle 1",
		"", "Oh no! The room is noisy!", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		15, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register mosquito_eyes");}

	ok = DefineBonusEvent(UHEVENT_TYPHOON, "typhoon_eyes", "Typhoon eyes",
		"M_EYE13", "Touhou 10 - Dark Side of Fate (40nix Remix)",
		"", "Typhoon disaster! The parking center is waiting for everyone!", "",
		"ub_DemoneyeEvent", "uh_RebuildEyeEvent", "",
		16, 13, 0, UHBE_FLAG_ALL_EYE | UHBE_FLAG_EYE_TEAM, 1, BONUS_MINPLAYERS_TIER3, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register typhoon_eyes");}

	// --- Force-only (RCON / EX target / morph-failure fallback) ---------------
	ok = DefineBonusEvent(UHEVENT_BOSSEFFA, "boss_ffa", "\cmFree for All",
		"M_LMS777", "Pok\xE9mon Emerald - Frontier Brain Battle",
		"", "", "",
		"ub_BossFFAEvent", "uh_RebuildBossFFA", "",
		0, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register boss_ffa");}

	ok = DefineBonusEvent(UHEVENT_TRUEPOWER, "truepower_ffa", "\caF\cgr\cie\cke \cdf\cqo\cnr \cmA\cvl\ctl",
		"HA_BEATO", "Disgaea 5 - Stepping Hard Beat",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildTruePowerFFA", "",
		100, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register truepower_ffa");}

	ok = DefineBonusEvent(UHEVENT_EYELENTO, "eyelento_of_pain", "Eyelento of Pain",
		"M_EYE11X", "Final Fight Arcade - Rolento's Theme",
		"", "", "",
		"ub_EyelentoOfPain", "", "",
		6, 0, 0, UHBE_FLAG_MULTITEAM, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register eyelento_of_pain");}

	ok = DefineBonusEvent(UHEVENT_CATCHFURRY, "catch_furry", "Get that Furry",
		"EYEMUS", "Super Mario Sunshine - Speed Test",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		50, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register catch_furry");}

	ok = DefineBonusEvent(UHEVENT_RUNAWAYFOX, "runaway_fox", "Angry Foxeye",
		"EYEMUS", "Super Mario Sunshine - Speed Test",
		"", "", "",
		"ub_OneVsAllEvent", "uh_RebuildOneVsAllEvent", "",
		51, 0, 0, UHBE_FLAG_ONEVSALL | UHBE_FLAG_EYE_TEAM, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register runaway_fox");}

	ok = DefineBonusEvent(UHEVENT_RUNES, "rune_ffa", "\c[MenuGreen]Free for All",
		"DIXIENUS", "Super Bonk - Engine Room",
		"", "", "",
		"ub_FreeForAll", "uh_RebuildRuneFFA", "",
		113, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register rune_ffa");}

	ok = DefineBonusEvent(UHEVENT_SATANSEAL, "satan_seal_ffa", "\cgFree for All",
		"SATANMUS", "The Binding of Isaac: Rebirth - Hericide (Satan Fight)",
		"", "", "",
		"ub_SatanSealFFA", "uh_RebuildSatanSealFFA", "",
		0, 0, 0, UHBE_FLAG_FFA, 0, 0, 0);
	if (ok == UHBE_FAIL) {UH_Log(UH_LOG_ERROR, "uh_bonusdefs: failed to register satan_seal_ffa");}

	// EX relations (formerly baseId + 100 with threshold 3).  Bound by stem so
	// the core never derives targets from integer arithmetic.
	SetBonusEventEX("ffa", "truepower_ffa", 3);
	SetBonusEventEX("demoneye_parade", "catch_furry", 3);
	SetBonusEventEX("clone_darkness", "runaway_fox", 3);
	SetBonusEventEX("football_ffa", "rune_ffa", 3);
}

script "uh_define_vanilla_bonus" OPEN
{
	if (!UHInPlay()) terminate;
	UH_RegisterVanillaBonusEvents();
}

script "uh_define_vanilla_bonus_cs" OPEN CLIENTSIDE
{
	UH_RegisterVanillaBonusEvents();
}

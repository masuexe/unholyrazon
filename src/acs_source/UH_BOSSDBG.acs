#library "UH_BOSSDBG"
#include "zcommon.acs"

#include "uhadd.acs"

// Phase 1 only: exercise DefineBoss / getters without touching mainBossList.
// Remove or empty after Phase 2 vanilla migration is in place.

script "uh_bossdbg_define" OPEN
{
	int a;
	int b;
	int c;
	int dupId;
	int dupActor;
	int miss;

	if (!UHInPlay())
	{
		Log(s: "[UH_BOSSDBG] UHInPlay() false — abort defines");
		terminate;
	}

	a = DefineBoss(
		900, "UHDBG_BossA", "\cjUHDBG Boss A",
		UHBOSS_POOL_COMMON, 1111, 11,
		"", "UFACE0", "M_UB000", "UHDBG credit A",
		"UHDBG instruction A", "", "");

	b = DefineBoss(
		901, "UHDBG_BossB", "\cjUHDBG Boss B",
		UHBOSS_POOL_RARE, 2222, 22,
		"UHDBG_BossA", "UFACE1", "M_UB001", "UHDBG credit B",
		"UHDBG instruction B", "C", "draws near");

	c = DefineBoss(
		-1, "UHDBG_BossC", "\cjUHDBG Boss C",
		UHBOSS_POOL_COMMON, 3333, 33,
		"", "UFACE2", "*", "None",
		"UHDBG instruction C", "", "");

	dupId = DefineBoss(
		900, "UHDBG_BossDupId", "\cjdup id",
		UHBOSS_POOL_COMMON, 1, 1,
		"", "", "*", "None", "", "", "");

	dupActor = DefineBoss(
		902, "UHDBG_BossA", "\cjdup actor",
		UHBOSS_POOL_COMMON, 1, 1,
		"", "", "*", "None", "", "", "");

	miss = UH_FindBossByActor("UHDBG_DoesNotExist");

	Log(s: "[UH_BOSSDBG] define A=", i: a,
		s: " B=", i: b,
		s: " C=", i: c,
		s: " dupId=", i: dupId,
		s: " dupActor=", i: dupActor,
		s: " missFind=", i: miss);

	Log(s: "[UH_BOSSDBG] A actor=", s: UH_GetBossActor(a),
		s: " name=", s: UH_GetBossName(a),
		s: " hp=", i: UH_GetBossHPBase(a), s: "+", i: UH_GetBossHPAdd(a));

	Log(s: "[UH_BOSSDBG] find A=", i: UH_FindBossByActor("UHDBG_BossA"),
		s: " defined900=", i: UH_IsBossDefined(900),
		s: " definedC=", i: UH_IsBossDefined(c));
}

// Manual re-dump: puke uh_BossDefineDebugDump
script "uh_BossDefineDebugDump" (void)
{
	Log(s: "[UH_BOSSDBG] dump 900 defined=", i: UH_IsBossDefined(900),
		s: " actor=", s: UH_GetBossActor(900),
		s: " name=", s: UH_GetBossName(900),
		s: " hp=", i: UH_GetBossHPBase(900));
	Log(s: "[UH_BOSSDBG] dump 901 defined=", i: UH_IsBossDefined(901),
		s: " actor=", s: UH_GetBossActor(901));
	Log(s: "[UH_BOSSDBG] dump -1 defined=", i: UH_IsBossDefined(-1),
		s: " actor=", s: UH_GetBossActor(-1),
		s: " findC=", i: UH_FindBossByActor("UHDBG_BossC"),
		s: " miss=", i: UH_FindBossByActor("UHDBG_DoesNotExist"),
		s: " failConst=", i: UHBOSS_FAIL);
	Log(s: "[UH_BOSSDBG] dupSlot902=", i: UH_IsBossDefined(902),
		s: " findDupActor=", i: UH_FindBossByActor("UHDBG_BossDupId"));
}

#library "uh_musicdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla optional boss music extras (lumps may live in an optional music wad).
// Seeded DefineBoss tracks are already in the pool; these add variants.
// optional=1 → skipped unless uh_sv_OptionalMusic.
// OPEN order is not LOADACS order — wait until vanilla bosses exist.

function void uh_RegisterBossMusicExtras(void)
{
	AddBossMusic(3, "M_UB003", "Marvel vs. Capcom - Morrigan's Theme (Sped-Up)", 1, 0);
	AddBossMusic(3, "M_UB003X", "Tatsunoko vs. Capcom - Morrigan's Theme", 1, 0);
	AddBossMusic(5, "M_UB005 3", "Shadow of Ninja (NES) - Stage 2", 1, 0);
	AddBossMusic(5, "M_UB005X", "Street Fighter Alpha 2 - Guy's Theme", 1, 0);
	AddBossMusic(7, "M_UB007", "Super Street Fighter 2 (American) - Fei Long's Theme", 1, 0);
	AddBossMusic(7, "M_UB007X", "Super Street Fighter 2 (Japanese) - Fei Long's Theme", 1, 0);
	AddBossMusic(9, "M_UB009", "Art of Fighting (SNES) - Mr. Big's Theme", 114, 0);
	AddBossMusic(9, "M_UB009X", "Mega Man Soccer - Skull Field", 1, 0);
	AddBossMusic(10, "M_UB010", "Streets of Rage 2 - Ready Funk", 1, 0);
	AddBossMusic(10, "M_UB010X", "Super Soccer - Belgium Theme", 1, 0);
	AddBossMusic(16, "M_UB016", "Gundam Wing Endless Duel (SNES) - Arctic", 1, 0);
	AddBossMusic(16, "M_UB016X", "Final Fight (SNES) - Boil 'em Up (Rolento's Theme)", 1, 0);
	AddBossMusic(17, "M_UB017 12", "Nettou King of Fighters 96 - Mr. Karate theme", 1, 0);
	AddBossMusic(17, "M_UB017X 11", "Rockman No Constancy - Boss Theme", 1, 0);
	// GemBanker (22) — Unbound ub_PlayVariantMusic Case 22:
	// 75% default M_UB022; else 25% Z / 37.5% A / 37.5% B within the 25% branch
	// → overall 75% / 6.25% / 9.375% / 9.375% → weights 24 : 2 : 3 : 3
	AddBossMusic(22, "M_UB022", "Sonic Mania - Mean Bean Machine", 24, 0);
	AddBossMusic(22, "M_UB022Z", "Spa NES Remix / Puyo Puyo (MegaDrive) - Sticker of Puyo Puyo", 2, 0);
	AddBossMusic(22, "M_UB022A", "Dr. Robotnik's Mean Bean Machine - 2P Battle Mode", 3, 0);
	AddBossMusic(22, "M_UB022B", "Puyo Puyo - Final", 3, 0);
	AddBossMusic(23, "M_UB023", "Fire Emblem - Strike", 1, 0);
	AddBossMusic(23, "M_UB023X", "Pok\xE9mon Conquest - Boss Theme", 1, 0);
	AddBossMusic(113, "M_UB113", "The Simpsons: Hit & Run - Hit and Run (Sped-Up)", 1, 0);
	AddBossMusic(113, "M_UB113X", "kfaraday - this is what every megaman song sounds like to me", 1, 0);
	AddBossMusic(300, "M_UB300", "Incredible Crisis - De Crane, De Crane", 114, 0);
	AddBossMusic(300, "M_UB300X", "YobaHere - Song That Might Play When You Fight Sans", 1, 0);
	AddBossMusic(304, "M_UB304", "Blue Archive - Theme 182", 114, 0);
	AddBossMusic(304, "M_UB304X", "Blue Archive - Track 78 (Fevertime) (Sped-Up)", 1, 0);
	AddBossMusic(400, "M_UB400", "Mega Man X7 - Sigma Battle Theme 1", 1, 0);
	AddBossMusic(400, "M_UB400X", "Mega Man X7 - Sigma Battle Theme 1 (MIDI)", 1, 0);
	AddBossMusic(613, "M_UB613", "Crosscode - The Path of Justice", 1, 0);
	AddBossMusic(613, "M_UB613X", "RedScarf - meeting ya moves", 1, 0);
}

script "uh_define_vanilla_boss_music" OPEN
{
	int t;
	if (!UHInPlay()) terminate;
	t = 0;
	while (!UH_IsBossDefined(0) && t < 35)
	{
		Delay(1);
		t++;
	}
	uh_RegisterBossMusicExtras();
}

script "uh_define_vanilla_boss_music_cs" OPEN CLIENTSIDE
{
	int t;
	t = 0;
	while (!UH_IsBossDefined(0) && t < 35)
	{
		Delay(1);
		t++;
	}
	uh_RegisterBossMusicExtras();
}

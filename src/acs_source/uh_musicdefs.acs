#library "uh_musicdefs"
#include "zcommon.acs"
#include "uhadd.acs"

// Vanilla optional boss music extras (lumps may live in an optional music wad).
// Seeded DefineBoss tracks are already in the pool; these add variants.
// optional=1 → skipped unless uh_sv_OptionalMusic.
// OPEN order is not LOADACS order — wait until vanilla bosses exist.

function void uh_RegisterBossMusicExtras(void)
{
	// GemBanker (22) — Unbound ub_PlayVariantMusic Case 22:
	// 75% default M_UB022; else 25% Z / 37.5% A / 37.5% B within the 25% branch
	// → overall 75% / 6.25% / 9.375% / 9.375% → weights 24 : 2 : 3 : 3
	AddBossMusic(22, "M_UB022", "Sonic Mania - Mean Bean Machine", 24, 0);
	AddBossMusic(22, "M_UB022Z", "Spa NES Remix / Puyo Puyo (MegaDrive) - Sticker of Puyo Puyo", 2, 1);
	AddBossMusic(22, "M_UB022A", "Dr. Robotnik's Mean Bean Machine - 2P Battle Mode", 3, 1);
	AddBossMusic(22, "M_UB022B", "Puyo Puyo - Final", 3, 1);
}

script "uh_define_vanilla_boss_music" OPEN
{
	int t;
	if (!UHInPlay()) terminate;
	t = 0;
	while (!UH_IsBossDefined(0) && t < 35)
	{
		Delay(1);
		t++;
	}
	uh_RegisterBossMusicExtras();
}

script "uh_define_vanilla_boss_music_cs" OPEN CLIENTSIDE
{
	int t;
	t = 0;
	while (!UH_IsBossDefined(0) && t < 35)
	{
		Delay(1);
		t++;
	}
	uh_RegisterBossMusicExtras();
}

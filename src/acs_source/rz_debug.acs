#library "rz_debug"
#include "zcommon.acs"
#include "acsutils.acs"
#import "uhdt.acs"
#include "uh_def.acs"
#include "uh_funclib.acs"

script "rz_debug_MorphMe" (int type, int num) {
	ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false);
	bool res = morphMeToBoss(type, num);
	if (res) {
		Log(s:"Morph successful!");
	}
	else {
		Log(s:"Morph failed!");
	}
}

function bool morphMeToBoss(int type, int bossNum) {
	int tid = ActivatorTID();
	if (tid == 0)
		tid = PlayerNumber() + 1000;
	if (!SetActivator(tid))
		return false;

	if (type == 0) {
		str morphName = GetBossActor(bossNum);
		if (bossNum == 1066) morphName = "WeakHorse";
		else if (bossNum == 1113) morphName = "ProtoManBadGuy";
		else
			return morphActorToBoss(tid, bossNum, "GigaAstroExplode");
		if (StrCmp(morphName, "") == 0)
			return false;
		ACS_NamedExecuteWithResult("uh_MorphPreReset");
		bool okOverride = MorphActor(0, morphName, "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "");
		if (!okOverride) {
			Log(s: "rz_debug_MorphMe: MorphActor failed for ", s: morphName);
			return false;
		}
		SetActivator(tid);
		ACS_NamedExecuteWithResult("uh_MorphPostReset", 1);
		GiveInventory("BasicBossItem", 1);
		GiveInventory("MorphedFlag", 1);
		GiveInventory("BAWS", 1);
		return true;
	}

	str eyeActor = GetEyeActor(bossNum);
	if (StrCmp(eyeActor, "") == 0) {
		Log(s: "rz_debug_MorphMe: GetEyeActor(", i: bossNum, s: ") empty (IsEyeDefined=", i: IsEyeDefined(bossNum), s: ")");
		return false;
	}
	bool ok = MorphActor(0, eyeActor, "", 0x7ffffffc, MRF_FULLHEALTH|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR, "GigaAstroExplode", "");
	if (!ok) {
		Log(s: "rz_debug_MorphMe: MorphActor failed for ", s: eyeActor);
		return false;
	}
	SetActivator(tid);
	ACS_NamedExecuteWithResult("uh_DemoneyeMorph", bossNum);
	return true;
}

script "rz_debug_checkdeathstate" (void)
{
	bool ice = CheckInventory("IceDeathFlag");
	bool gib = CheckInventory("ExplodeDeathFlag");
	bool fall = CheckInventory("FallingDeathFlag");

	while (true) {
		ice = CheckInventory("IceDeathFlag");
		gib = CheckInventory("ExplodeDeathFlag");
		fall = CheckInventory("FallingDeathFlag");
		Log(s:"Ice: ", i:ice, s:" Gib: ", i:gib, s:" Fall: ", i:fall);
		delay(1);
	}

}

script "rz_debug_countinv" (void) {
	int inv;
	while (true) {
		inv = CheckInventory("WeaponCharge");
		Log(s:"Weapon Charge: ", i:inv);
		delay(1);
	}
}

script "rz_debug_setdecoyslot" (int slot, int num) {
	if (num < 1 || num > 3) {
		num = 1;
	}
	str item = StrParam(s:"DecoyBotFlag", i:num);
	SetInventory(item, slot);
}

// Thin wrapper — implementation lives in UH_COPYWEPS (has wep name/mul helpers).
script "rz_debug_ShowTodayDmgMul" (void) {
	ACS_NamedExecuteAlways("uh_debug_ShowTodayDmgMul", 0);
}

script "rz_debug_ShowTodayTeamFF" (void) {
	ACS_NamedExecuteAlways("uh_debug_ShowTodayTeamFF", 0);
}

// A_SpawnItemEx-style spawn from the activator (puke only has 3 int args).
//   rz_dbg_spawnactor <class>
//   rz_dbg_spawnang <degrees>
//   pukename rz_debug_SpawnEx <xofs> <yofs> <zofs>
script "rz_debug_SpawnEx" (int xofs, int yofs, int zofs)
{
	str cls = GetCVarString("rz_dbg_spawnactor");
	if (StrCmp(cls, "") == 0) {
		Log(s:"rz_debug_SpawnEx: set rz_dbg_spawnactor first");
		terminate;
	}

	int ptid = ActivatorTID();
	if (ptid == 0)
		ptid = PlayerNumber() + 1000;
	if (!SetActivator(ptid)) {
		Log(s:"rz_debug_SpawnEx: no activator");
		terminate;
	}

	int facing = GetActorAngle(0) + GetCVar("rz_dbg_spawnang") * 1.0 / 360;
	int c = cos(facing);
	int s = sin(facing);
	int fx = xofs * 1.0;
	int fy = yofs * 1.0;
	int px = GetActorX(0) + FixedMul(fx, c) + FixedMul(fy, s);
	int py = GetActorY(0) + FixedMul(fx, s) - FixedMul(fy, c);
	int pz = GetActorZ(0) + zofs * 1.0;

	int tid = UniqueTID();
	if (!SpawnForced(cls, px, py, pz, tid, facing >> 8)) {
		Log(s:"rz_debug_SpawnEx: SpawnForced failed for ", s:cls);
		terminate;
	}
	SetActorAngle(tid, facing);
	SetActivator(tid);
	SetPointer(AAPTR_TARGET, ptid);
	SetActivator(ptid);
	Log(s:"rz_debug_SpawnEx: spawned ", s:cls, s:" tid=", i:tid);
}

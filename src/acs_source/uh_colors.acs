Script "uh_translations_deluxe" OPEN CLIENTSIDE
{
CreateTranslation(RNGCOLOR1, 192:192=178:178, 198:198=183:183, 202:202=227:227, 199:199=186:186);
CreateTranslation(RNGCOLOR2, 192:192=219:219, 198:198=220:220, 202:202=216:216, 199:199=223:223);
CreateTranslation(RNGCOLOR3, 192:192=228:228, 198:198=229:229, 202:202=160:160, 199:199=230:230);
CreateTranslation(RNGCOLOR4, 192:192=128:128, 198:198=130:130, 202:202=108:108, 199:199=132:132);

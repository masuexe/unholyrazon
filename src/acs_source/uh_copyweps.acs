#library "uh_copyweps"
#include "zcommon.acs"

#DEFINE RANGEDWEPU_MAX	24
#DEFINE RAPIDWEPU_MAX	12
#DEFINE CLOSEWEPU_MAX	28
#DEFINE POWERWEPU_MAX	18
#DEFINE AOEWEPU_MAX		10
#DEFINE SHIELDWEPU_MAX	11

str RangedWepU[RANGEDWEPU_MAX]={
	"SparkShock","FireStorm","DustCrusher","SearchSnake","NoiseCrush",
	"ThunderBeam","ThunderBolt","IceWave","FreezeCracker","BlizzardAttack",
	"SilverTomahawk","MegaBall","HomingSniper","GyroAttack","GeminiLaser",
	"DiveMissile","MagnetMissile","LaserTrident","ReboundStriker",
	"CopyVision","SparkChaser","GrabBuster","DeepDigger","DawnBreaker",
};
str RapidWepU[RAPIDWEPU_MAX]={
	"QuickBoomerang","IceSlasher","WaterWave","WaterBalloon",
	"YamatoSpear","MetalBlade","NeedleCannon","PlugBall",
	"TripleBlade","WaveBurner","ElectricShock","ScrewCrusher",
};
str CloseWepU[CLOSEWEPU_MAX]={
	"BubbleLead","WindStorm","PowerStone","RingBoomerang","RollingCutter",
	"TornadoHold","FlameBlast","ChargeKick","WildCoil","KnightCrush",
	"FlameSword","SlashClaw","ThunderClaw","ConcreteShot","MagmaBazooka",
	"HornetChaser","ChillSpike","ThunderWool","WheelCutter","MagicCard",
	"TenguBlade","SaltWater","BreakDash","Sakugarne",
	"ShadowBlade","OilSlider","AirShooter","TopSpin",
};
str PowerWepU[POWERWEPU_MAX]={
	"CrystalEye","PharaohShot","SuperArm","AtomicFire","HardKnuckle",
	"CrashBomb","DangerWrap","FlashBomb","NapalmBomb","HyperBomb",
	"DrillBomb","SolarBlaze","CommandoBomb","RemoteMine","SpreadDrill",
	"BubbleBomb","PhotonMissile","BalladeCracker",
};
str AoEWepU[AOEWEPU_MAX]={
	"FlashStopper","CentaurFlash","GravityHold","RainFlush",
	"AstroCrush","TornadoBlow","BlackHoleBomb","LightningBolt",
	"TimeSlow","TimeStopper",
};
str ShieldWepU[SHIELDWEPU_MAX]={
	"LeafShield","StarCrash","PlantBarrier","ScorchWheel",
	"JunkShield","JewelSatellite","WaterShield","IceWall",
	"MirrorBuster","BlackHole","SkullBarrier",
};

script "uh_MegamanWeapons" (int Check)
{
	int w1=CheckInventory("MegaSlotRanged_F")-1;
	int w2=CheckInventory("MegaSlotRapid_F")-1;
	int w3=CheckInventory("MegaSlotClose_F")-1;
	int w4=CheckInventory("MegaSlotPower_F")-1;
	int w5=CheckInventory("MegaSlotAoE_F")-1;
	int w6=CheckInventory("MegaSlotShield_F")-1;

	if(w1>=0)TakeInventory(StrParam(s:RangedWepU[w1],s:"WepU"),1);
	if(w2>=0)TakeInventory(StrParam(s:RapidWepU[w2],s:"WepU"),1);
	if(w3>=0)TakeInventory(StrParam(s:CloseWepU[w3],s:"WepU"),1);
	if(w4>=0)TakeInventory(StrParam(s:PowerWepU[w4],s:"WepU"),1);
	if(w5>=0)TakeInventory(StrParam(s:AoEWepU[w5],s:"WepU"),1);
	if(w6>=0)TakeInventory(StrParam(s:ShieldWepU[w6],s:"WepU"),1);

	w1=MegaWepRNG_Func(RANGEDWEPU_MAX,w1);
	w2=MegaWepRNG_Func(RAPIDWEPU_MAX,w2);
	w3=MegaWepRNG_Func(CLOSEWEPU_MAX,w3);
	w4=MegaWepRNG_Func(POWERWEPU_MAX,w4);
	w5=MegaWepRNG_Func(AOEWEPU_MAX,w5);
	w6=MegaWepRNG_Func(SHIELDWEPU_MAX,w6);

	SetInventory("MegaSlotRanged_F",w1+1);
	SetInventory("MegaSlotRapid_F",w2+1);
	SetInventory("MegaSlotClose_F",w3+1);
	SetInventory("MegaSlotPower_F",w4+1);
	SetInventory("MegaSlotAoE_F",w5+1);
	SetInventory("MegaSlotShield_F",w6+1);

	GiveInventory(StrParam(s:RangedWepU[w1],s:"WepU"),1);
	GiveInventory(StrParam(s:RapidWepU[w2],s:"WepU"),1);
	GiveInventory(StrParam(s:CloseWepU[w3],s:"WepU"),1);
	GiveInventory(StrParam(s:PowerWepU[w4],s:"WepU"),1);
	GiveInventory(StrParam(s:AoEWepU[w5],s:"WepU"),1);
	GiveInventory(StrParam(s:ShieldWepU[w6],s:"WepU"),1);
}

function int MegaWepRNG_Func(int maxR,int Skip)
{
	int dWep;
	do{dWep=random(0,maxR-1);}while(dWep==Skip);
	return dWep;
}

function void SetInventory(str item,int amount)
{
	int diff=amount-CheckInventory(item);
	if(diff>0)GiveInventory(item,diff);
	else if(diff<0)TakeInventory(item,-diff);
}

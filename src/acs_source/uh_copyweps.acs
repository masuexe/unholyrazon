script "uh_MegamanWeapons" (int Check)
{
	int w1=CheckInventory("MegaSlotRanged_F")-1;
	int w2=CheckInventory("MegaSlotRapid_F")-1;
	int w3=CheckInventory("MegaSlotClose_F")-1;
	int w4=CheckInventory("MegaSlotPower_F")-1;
	int w5=CheckInventory("MegaSlotAoE_F")-1;
	int w6=CheckInventory("MegaSlotShield_F")-1;

	if(w1>=0)TakeInventory(StrParam(s:RangedWepU[w1],s:"WepU"),1);
	if(w2>=0)TakeInventory(StrParam(s:RapidWepU[w2],s:"WepU"),1);
	if(w3>=0)TakeInventory(StrParam(s:CloseWepU[w3],s:"WepU"),1);
	if(w4>=0)TakeInventory(StrParam(s:PowerWepU[w4],s:"WepU"),1);
	if(w5>=0)TakeInventory(StrParam(s:AoEWepU[w5],s:"WepU"),1);
	if(w6>=0)TakeInventory(StrParam(s:ShieldWepU[w6],s:"WepU"),1);

	w1=MegaWepRNG_Func(RANGEDWEPU_MAX,w1);
	w2=MegaWepRNG_Func(RAPIDWEPU_MAX,w2);
	w3=MegaWepRNG_Func(CLOSEWEPU_MAX,w3);
	w4=MegaWepRNG_Func(POWERWEPU_MAX,w4);
	w5=MegaWepRNG_Func(AOEWEPU_MAX,w5);
	w6=MegaWepRNG_Func(SHIELDWEPU_MAX,w6);

	SetInventory("MegaSlotRanged_F",w1+1);
	SetInventory("MegaSlotRapid_F",w2+1);
	SetInventory("MegaSlotClose_F",w3+1);
	SetInventory("MegaSlotPower_F",w4+1);
	SetInventory("MegaSlotAoE_F",w5+1);
	SetInventory("MegaSlotShield_F",w6+1);

	GiveInventory(StrParam(s:RangedWepU[w1],s:"WepU"),1);
	GiveInventory(StrParam(s:RapidWepU[w2],s:"WepU"),1);
	GiveInventory(StrParam(s:CloseWepU[w3],s:"WepU"),1);
	GiveInventory(StrParam(s:PowerWepU[w4],s:"WepU"),1);
	GiveInventory(StrParam(s:AoEWepU[w5],s:"WepU"),1);
	GiveInventory(StrParam(s:ShieldWepU[w6],s:"WepU"),1);
}

function int MegaWepRNG_Func(int maxR,int Skip)
{
	int dWep;
	do{dWep=random(0,maxR-1);}while(dWep==Skip);
	return dWep;
}

function void SetInventory(str item,int amount)
{
	int diff=amount-CheckInventory(item);
	if(diff>0)GiveInventory(item,diff);
	else if(diff<0)TakeInventory(item,-diff);
}

// --- Qwant move relearn (18 core moves; index 0 = pokeball) ---
#DEFINE Q_PKMN_LIMIT 19

str QwantMoveList[Q_PKMN_LIMIT]={
	"Qwant_W",
	"BlazeKickWep",
	"BulletSeedWep",
	"ChargeBeamWep",
	"DazzlingGleamWep",
	"FeintAttackWep",
	"FireBlastWep",
	"FlameBurstWep",
	"FreezeDryWep",
	"IceBeamWep",
	"LeafBladeWep",
	"MoonBlastWep",
	"NightDazeWep",
	"RapidSpinWep",
	"ShadowForceWep",
	"SonicBoomWep",
	"ThunderWaveWep",
	"WaterShurikenWep",
	"WaterSpoutWep",
};

script "uh_QwantMoveRelearn" (void)
{
	if(GetUserArray(0,"user_PKMN_MoveMem",7) == 77){
		Log(s:"\cgERROR [!] \cdQwant variables are not set!");
		terminate;
	}
	str CurrWep = GetWeapon();
	for(int i = 1; i < Q_PKMN_LIMIT; i++){
		if(StrCmp(CurrWep,QwantMoveList[i])==0){
			break;
		}
	}
	if(i >= Q_PKMN_LIMIT){
		Log(s:"\cgERROR [!] \cdThis weapon is not in the move list! >> \ck",s:CurrWep);
		terminate;
	}

	int T1 = GetUserArray(0,"user_PKMN_MoveMem",0);
	int T2 = GetUserArray(0,"user_PKMN_MoveMem",1);
	int T3 = GetUserArray(0,"user_PKMN_MoveMem",2);
	int T4 = GetUserArray(0,"user_PKMN_MoveMem",3);
	int Temp;
	int NewMove = func_QwantCheckRNG(T1, T2, T3, T4);

	if(i == T1)
		Temp = 0;
	else if(i == T2)
		Temp = 1;
	else if(i == T3)
		Temp = 2;
	else if(i == T4)
		Temp = 3;

	SetUserArray(0,"user_PKMN_MoveMem",Temp,NewMove);

	GiveInventory(QwantMoveList[NewMove],1);
	SetWeapon(QwantMoveList[NewMove]);
	TakeInventory(QwantMoveList[i],1);
}

script "uh_QwantDebugUserArray" (void)
{
	Log(s:"\cduh_QwantDebugUserArray");
	Log(i:GetUserArray(0,"user_PKMN_MoveMem",0));
	Log(i:GetUserArray(0,"user_PKMN_MoveMem",1));
	Log(i:GetUserArray(0,"user_PKMN_MoveMem",2));
	Log(i:GetUserArray(0,"user_PKMN_MoveMem",3));
	Log(i:GetUserArray(0,"user_PKMN_MoveMem",7));
}

script "uh_QwantStartMoves" (void)
{
	int T1 = func_QwantCheckRNG(-1, -1, -1, -1);
	int T2 = func_QwantCheckRNG(T1, -1, -1, -1);
	int T3 = func_QwantCheckRNG(T1, T2, -1, -1);
	int T4 = func_QwantCheckRNG(T1, T2, T3, -1);
	int M1, M2, M3, M4;

	M1 = T1; M2 = T2; M3 = T3; M4 = T4;

	SetUserArray(0,"user_PKMN_MoveMem",0,M1);
	SetUserArray(0,"user_PKMN_MoveMem",1,M2);
	SetUserArray(0,"user_PKMN_MoveMem",2,M3);
	SetUserArray(0,"user_PKMN_MoveMem",3,M4);
	SetUserArray(0,"user_PKMN_MoveMem",7,777);
	GiveInventory(QwantMoveList[M1],1);
	GiveInventory(QwantMoveList[M2],1);
	GiveInventory(QwantMoveList[M3],1);
	GiveInventory(QwantMoveList[M4],1);
}

function int func_QwantCheckRNG(int p1, int p2, int p3, int p4)
{
	int qWep;
	do {
		qWep = random(1,Q_PKMN_LIMIT-1);
	} while(qWep == p1 || qWep == p2 || qWep == p3|| qWep == p4);

	return qWep;
}

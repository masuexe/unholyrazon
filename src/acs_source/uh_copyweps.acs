function int UhDateToInt(void) {
	int time = SystemTime();
	return GetTimeProperty(time, TM_YEAR) * 10000
	+(GetTimeProperty(time, TM_MONTH) + 1) * 100
	+GetTimeProperty(time, TM_DAY);
}

function int UhSeedRandom(int seed, int min_val, int max_val) {
	int a = 1919810;
	int b = 114514;
	int n = (a * seed + b) & 0x7FFFFFFF;
	if (max_val < min_val) {
		int temp = max_val;
		max_val = min_val;
		min_val = temp;
	}
	return n % (max_val - min_val + 1) + min_val;
}

function int UhHashStr(str s) {
	int h = 0;
	int len = StrLen(s);
	for (int i = 0; i < len; i++)
		h = (h * 31 + GetChar(s, i)) & 0x7FFFFFFF;
	return h;
}

function int UhCopywepIdFromAlias(str cls) {
	for (int i = 0; i < UH_COPYWEP_ALIAS_MAX; i++) {
		if (StrCmp(cls, uh_copywep_alias_class[i]) == 0)
			return FindMegaCopyIdByStemPrefix(uh_copywep_alias_name[i]);
	}
	return 0;
}

function int UhCopywepIdFromActivator(void) {
	str cls = GetActorClass(0);
	int id = FindMegaCopyIdByStemPrefix(cls);
	if (id > 0)
		return id;

	id = UhCopywepIdFromAlias(cls);
	if (id > 0)
		return id;

	str dtype = GetActorProperty(0, APROP_DamageType);
	if (StrLen(dtype) > 0) {
		id = FindMegaCopyIdByStemPrefix(dtype);
		if (id > 0)
			return id;
	}
	return 0;
}

function int UhCopywepDmgMul(int wep) {
	int date = UhDateToInt();
	int mul;
	int i;
	int lucky;
	int max_pool;
	int official = GetMegaOfficialCopyCount();

	if (official < 1)
		official = 103;

	if (wep < 1 || wep > official) {
		return UhSeedRandom(date + UhHashStr(GetActorClass(0)) * 893, 0.0, 2.0);
	}

	mul = UhSeedRandom(date + wep * 893, 0.0, 2.0);

	max_pool = official + official / 2;
	for (i = 1; i <= 4; i++) {
		lucky = UhSeedRandom(date + 127 * 5 * i, 1, max_pool);
		if (lucky == wep)
			mul = UhSeedRandom(date + 1234 * 50, 4.0, 6.0);
	}
	max_pool = official * 2;
	for (i = 1; i <= 2; i++) {
		lucky = UhSeedRandom(date + 721 * 10 * i, 1, max_pool);
		if (lucky == wep)
			mul = UhSeedRandom(date + 1234 * 100, 8.0, 12.0);
	}
	lucky = UhSeedRandom(date + 1234 * 50, 1, official * 50);
	if (lucky == wep)
		mul = UhSeedRandom(date + 1234 * 500, 40.0, 60.0);
	lucky = UhSeedRandom(date + 567 * 100, 1, official * 100);
	if (lucky == wep)
		mul = UhSeedRandom(date + 1234 * 1000, 80.0, 120.0);

	return mul;
}

script "uh_TodayDmgMul" (int damage, int allow_neg) {
	if (!GetCVar("rz_sv_randMegaManCopywepDmg")) {
		SetResultValue(damage);
		terminate;
	}
	int wep = UhCopywepIdFromActivator();
	int mul = UhCopywepDmgMul(wep);
	if (allow_neg) {
		int date = UhDateToInt();
		int seed_key = wep;
		if (seed_key < 1)
			seed_key = UhHashStr(GetActorClass(0));
		if (UhSeedRandom(date + 309 + seed_key * 17, 0.0, 1.0) < 0.5)
			mul = -mul;
	}
	SetResultValue(FixedMul(mul, damage));
}

script "uh_debug_ShowTodayDmgMul" (void) {
	int date = UhDateToInt();
	int official = GetMegaOfficialCopyCount();
	Log(s:"uh_debug_ShowTodayDmgMul date=", i:date,
		s:" official=", i:official,
		s:" rz_sv_randMegaManCopywepDmg=", i:GetCVar("rz_sv_randMegaManCopywepDmg"));
	for (int i = 1; i <= official; i++) {
		Log(s:GetCopyWepDmgStemByMegaId(i), s:" [", i:i, s:"] mul=", f:UhCopywepDmgMul(i));
	}
}

// --- Daily MegaMan copywep team-FF (leak weapons only; damage = uh_TodayDmgMul result) ---
#define UH_TEAMFF_LEAK_MAX 8
#define UH_TEAMFF_SALT 424242

int uh_team_ff_leak_ids[UH_TEAMFF_LEAK_MAX];
int uh_team_ff_leak_date;
int uh_team_ff_leak_official;
int uh_team_ff_leak_count;

function void UhEnsureTodayTeamFFLeaks(void) {
	int date = UhDateToInt();
	int official = GetMegaOfficialCopyCount();
	int want;
	int picked;
	int attempt;
	int i;
	int j;
	int id;
	int dup;

	if (official < 1)
		official = 103;
	if (uh_team_ff_leak_date == date && uh_team_ff_leak_official == official)
		return;

	uh_team_ff_leak_date = date;
	uh_team_ff_leak_official = official;
	want = UH_TEAMFF_LEAK_MAX;
	if (want > official)
		want = official;

	for (i = 0; i < UH_TEAMFF_LEAK_MAX; i++)
		uh_team_ff_leak_ids[i] = 0;

	picked = 0;
	attempt = 0;
	while (picked < want && attempt < 1000) {
		attempt++;
		id = UhSeedRandom(date + UH_TEAMFF_SALT + attempt * 97, 1, official);
		dup = 0;
		for (j = 0; j < picked; j++) {
			if (uh_team_ff_leak_ids[j] == id) {
				dup = 1;
				break;
			}
		}
		if (!dup) {
			uh_team_ff_leak_ids[picked] = id;
			picked++;
		}
	}
	uh_team_ff_leak_count = picked;
}

function int UhIsTodayTeamFFLeak(int wep_id) {
	int i;
	if (wep_id < 1)
		return 0;
	UhEnsureTodayTeamFFLeaks();
	for (i = 0; i < uh_team_ff_leak_count; i++) {
		if (uh_team_ff_leak_ids[i] == wep_id)
			return 1;
	}
	return 0;
}

function str UhStripMegaMPrefix(str dtype) {
	if (StrLen(dtype) > 2 && GetChar(dtype, 0) == 77 && GetChar(dtype, 1) == 95)
		return StrMid(dtype, 2, StrLen(dtype) - 2);
	return dtype;
}

script "uh_ApplyCopywepTeamFF" (void) {
	TakeInventory("PowerProtectMegaCopywep", 1);
	if (!CheckInventory("PowerProtectSurvivor"))
		terminate;
	if (!GetCVar("rz_sv_randMegaManCopywepTeamFF"))
		GiveInventory("PowerProtectMegaCopywep", 1);
}

script "uh_ClearCopywepTeamFF" (void) {
	TakeInventory("PowerProtectMegaCopywep", 1);
}

// PREMOD: after PowerProtection / teamdamage, before armor.
// When cvar is on (no blob), zero teammate copywep damage unless today's leak set.
script "uh_CopywepTeamFF" (int evt, int dmg, int dmgtype) EVENT {
	int vict_pn;
	int src_pn;
	int wep_id;
	str stem;

	if (evt != GAMEEVENT_ACTOR_DAMAGED_PREMOD)
		terminate;
	if (!GetCVar("rz_sv_randMegaManCopywepTeamFF"))
		terminate;

	if (!SetActivator(0, AAPTR_DAMAGE_TARGET))
		terminate;
	vict_pn = PlayerNumber();
	if (vict_pn < 0)
		terminate;
	if (!CheckInventory("PowerProtectSurvivor"))
		terminate;

	if (!SetActivator(0, AAPTR_DAMAGE_SOURCE))
		terminate;
	src_pn = PlayerNumber();
	if (src_pn < 0)
		terminate;
	if (GetPlayerInfo(vict_pn, PLAYERINFO_TEAM) != GetPlayerInfo(src_pn, PLAYERINFO_TEAM))
		terminate;

	stem = UhStripMegaMPrefix(dmgtype);
	wep_id = FindMegaCopyIdByStemPrefix(stem);
	if (wep_id < 1)
		terminate;
	if (UhIsTodayTeamFFLeak(wep_id))
		terminate;
	SetResultValue(0);
}

script "uh_debug_ShowTodayTeamFF" (void) {
	int i;
	int date = UhDateToInt();
	int official = GetMegaOfficialCopyCount();

	UhEnsureTodayTeamFFLeaks();
	Log(s:"uh_debug_ShowTodayTeamFF date=", i:date,
		s:" official=", i:official,
		s:" leakCount=", i:uh_team_ff_leak_count,
		s:" rz_sv_randMegaManCopywepTeamFF=", i:GetCVar("rz_sv_randMegaManCopywepTeamFF"));
	for (i = 0; i < uh_team_ff_leak_count; i++) {
		Log(s:"  leak ", i:i + 1, s:": ",
			s:GetCopyWepDmgStemByMegaId(uh_team_ff_leak_ids[i]),
			s:" [", i:uh_team_ff_leak_ids[i], s:"]");
	}
}

// ============================================================================
// Shiny move-weapon runtime (dispatchers + return). Weapon states on clients
// get 0 from non-CLIENTSIDE scripts; the server's GiveInventory/SetWeapon are
// synced, so a handled roll self-corrects within a tick or two.
// ============================================================================

// Team-color dyes (must match UH_COLORS.acs / ConstIntList_Ucolors.dec).
#define UH_MOVE_DYE_MEGA 30000
#define UH_MOVE_DYE_QWANT 30001
#define UH_MOVE_DYE_NEGA 30002
#define UH_MOVE_DYE_DECOY 20050

// Per-player dispatch records (indexed by PlayerNumber; -1 = not a player).
str uh_move_return[64];
str uh_move_current[64];
int uh_nega_charge_lvl[64];
int uh_shiny_mega_which[64];
int uh_decoy_which[64];

// QwantShiny AltFire: flat weighted roll of the ACS table (vanilla + addon).
// 1 = move weapon selected; 0 = empty table / failure.
script "uh_QwantShinyMoveRoll" (void) {
	int pn = PlayerNumber();
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	str wep;

	if (pn < 0 || uh_shiny_qwant_move_count <= 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < uh_shiny_qwant_move_count; i++)
		total += uh_shiny_qwant_move_weight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < uh_shiny_qwant_move_count; i++) {
		acc += uh_shiny_qwant_move_weight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	wep = uh_shiny_qwant_move_wep[pick];
	uh_move_return[pn] = GetWeapon();
	uh_move_current[pn] = wep;
	uh_nega_charge_lvl[pn] = 0;
	uh_decoy_which[pn] = 0;
	SetInventory("UH_MoveHud_F", 1);
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory(wep, 1);
	SetWeapon(wep);
	SetResultValue(1);
}

// Legacy SetWeapon dispatch — unused; held cycle fires in place.
script "uh_ShinyNegaCustomFire" (int lvl) {
	SetResultValue(0);
}

// Full-charge end: Give next cycle wep (or buster), SilentSelect, Take current.
// SNegaFlag stays as HUD sync only.
script "uh_ShinyNegaAdvanceHeld" (void) {
	int pn = PlayerNumber();
	int slot;
	int next;
	int waits;
	str old;
	str neww;

	if (pn < 0)
		terminate;

	waits = 0;
	while (StrCmp(uh_shiny_nega_slot_wep[1][0], "") == 0 && waits < 35) {
		delay(1);
		waits++;
	}

	slot = CheckInventory("SNegaFlag");
	old = GetWeapon();
	if (StrICmp(old, "NegaManShiny_W") == 0)
		slot = 0;
	else if (StrCmp(uh_nega_held[pn], "") != 0)
		old = uh_nega_held[pn];

	next = UH_ShinyNegaNextSlot(slot);

	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);

	if (next <= 0) {
		neww = "NegaManShiny_W";
		SetInventory("SNegaFlag", 0);
	}
	else {
		neww = GetShinyNegaSlotWep(next, 1);
		if (StrCmp(neww, "") == 0) {
			neww = "NegaManShiny_W";
			SetInventory("SNegaFlag", 0);
			next = 0;
		}
		else
			SetInventory("SNegaFlag", next);
	}

	GiveInventory(neww, 1);
	SetWeapon(neww);
	if (StrCmp(old, "") != 0 && StrICmp(old, neww) != 0)
		TakeInventory(old, 1);
	uh_nega_held[pn] = neww;
	uh_nega_charge_lvl[pn] = 0;
	SetInventory("UH_MoveHud_F", 0);
	TakeInventory("WeaponCharge", 999);
}

// For the move weapon's Select: which charge level launched it (1..3, 0 none).
script "uh_ShinyNegaGetChargeLevel" (void) {
	int pn = PlayerNumber();
	SetResultValue(pn >= 0? uh_nega_charge_lvl[pn]:0);
}

// Gate for docs / rare DECORATE checks: 1 = addon slots 26..33 present.
script "uh_HasCustomNegaSlots" (void) {
	SetResultValue(HasCustomNegaSlots());
}

function str UhCopyParentFromHud(void) {
	int hud = CheckInventory("UH_MoveHud_F");
	if (hud == 1)
		return "QwantShiny_W";
	if (hud == 2)
		return "NegaManShiny_W";
	if (hud == 3)
		return "DecoyBot_W";
	if (hud == 4)
		return "DecoyBot_W2";
	if (hud == 5)
		return "DecoyBot_W3";
	return "";
}

// Client prediction: uh_ShinyMoveReturn is server-only, so SetWeapon never
// runs locally. Without a pending parent, Deselect/A_Lower re-raises the copy
// (6H50 A); a TNT1 wait holds the copy forever (gun vanishes). Set pending
// here so A_Lower brings up the parent.
script "uh_ShinyMoveReturn_cs" (void) CLIENTSIDE {
	int pn = PlayerNumber();
	int cons = ConsolePlayerNumber();
	str ret;
	if (cons >= 0 && pn != cons)
		terminate;
	ret = UhCopyParentFromHud();
	if (StrCmp(ret, "") == 0)
		terminate;
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	SetWeapon(ret);
}

// Legacy M1 SetWeapon dispatch — unused; held copies fire in place.
script "uh_DecoyBotCustomFire" (int which) {
	SetResultValue(0);
}

// Which weapon slot is currently ready (1/2/3) from GetWeapon() suffix.
function int UhDecoyHeldSlotFromWeapon(str wep) {
	int len = StrLen(wep);
	int d;
	if (len >= 4
		&& GetChar(wep, len - 3) == '_'
		&& GetChar(wep, len - 2) == 'W') {
		d = GetChar(wep, len - 1);
		if (d == '2')
			return 2;
		if (d == '3')
			return 3;
		if (d == '1')
			return 1;
	}
	if (StrICmp(wep, "DecoyBot_W2") == 0)
		return 2;
	if (StrICmp(wep, "DecoyBot_W3") == 0)
		return 3;
	return 1;
}

// After M2 roll: Give three new held copies, SetWeapon current slot, Take old.
// Always strip leftover DecoyBot_W* parents (ScriptBar-only; never held).
script "uh_DecoyBotApplyHeldWeps" (void) {
	int pn = PlayerNumber();
	int s1;
	int s2;
	int s3;
	int slot;
	str stem1;
	str stem2;
	str stem3;
	str new1;
	str new2;
	str new3;
	str old1;
	str old2;
	str old3;
	str cur;
	str setto;

	if (pn < 0)
		terminate;
	// Caller (WepSwap) waits for the table; do not bootstrap 00 here.
	if (uh_decoy_move_count <= 0)
		terminate;

	s1 = CheckInventory("DecoyBotFlag1");
	s2 = CheckInventory("DecoyBotFlag2");
	s3 = CheckInventory("DecoyBotFlag3");
	if (s1 < 0 || s1 >= uh_decoy_move_count)
		terminate;
	if (s2 < 0 || s2 >= uh_decoy_move_count)
		terminate;
	if (s3 < 0 || s3 >= uh_decoy_move_count)
		terminate;

	stem1 = uh_decoy_move_wep[s1];
	stem2 = uh_decoy_move_wep[s2];
	stem3 = uh_decoy_move_wep[s3];
	if (StrCmp(stem1, "") == 0 || StrCmp(stem2, "") == 0 || StrCmp(stem3, "") == 0)
		terminate;

	new1 = StrParam(s:stem1, s:"_W1");
	new2 = StrParam(s:stem2, s:"_W2");
	new3 = StrParam(s:stem3, s:"_W3");

	old1 = uh_decoy_held1[pn];
	old2 = uh_decoy_held2[pn];
	old3 = uh_decoy_held3[pn];

	cur = GetWeapon();
	slot = UhDecoyHeldSlotFromWeapon(cur);
	if (slot == 2)
		setto = new2;
	else if (slot == 3)
		setto = new3;
	else
		setto = new1;

	// Before any Give: first auto-raise must SilentSelect (not SelectSwap Ready).
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);

	GiveInventory(new1, 1);
	GiveInventory(new2, 1);
	GiveInventory(new3, 1);

	SetWeapon(setto);

	if (StrCmp(old1, "") != 0 && StrICmp(old1, new1) != 0)
		TakeInventory(old1, 1);
	if (StrCmp(old2, "") != 0 && StrICmp(old2, new2) != 0)
		TakeInventory(old2, 1);
	if (StrCmp(old3, "") != 0 && StrICmp(old3, new3) != 0)
		TakeInventory(old3, 1);

	// Parents are never valid held guns (ScriptBar / bar remap only).
	TakeInventory("DecoyBot_W", 1);
	TakeInventory("DecoyBot_W2", 1);
	TakeInventory("DecoyBot_W3", 1);

	uh_decoy_held1[pn] = new1;
	uh_decoy_held2[pn] = new2;
	uh_decoy_held3[pn] = new3;
}

// For Decoy move Select: which launcher weapon (1..3).
// Array is server-only; on clients (v==0) derive from synced UH_MoveHud_F.
script "uh_DecoyBotGetWhich" (void) {
	int pn = PlayerNumber();
	int v = pn >= 0? uh_decoy_which[pn]:0;
	int hud;
	if (v <= 0) {
		hud = CheckInventory("UH_MoveHud_F");
		if (hud >= 3 && hud <= 5)
			v = hud - 2;
		else
			v = 1;
	}
	SetResultValue(v);
}

// Dynamic DecoyBot copy slot count.
script "uh_CountDecoyBotSlots" (void) {
	SetResultValue(CountDecoyBotSlots());
}

// Equip Shiny Decoy's current slot, or advance to the next registered shiny
// partner. Old addons may leave shiny entries empty; M2 skips those rows.
function int UhDecoyBotShinyEquip(int advance) {
	int pn = PlayerNumber();
	int count = CountDecoyBotSlots();
	int slot;
	int tries;
	str next_wep;
	str old_wep;

	if (pn < 0 || count <= 0)
		return 0;
	slot = CheckInventory("DecoyBotFlag1");
	if (slot < 0 || slot >= count)
		slot = 0;
	if (advance)
		slot = (slot + 1) % count;

	for (tries = 0; tries < count; tries++) {
		next_wep = uh_decoy_shiny_wep[slot];
		if (StrCmp(next_wep, "") != 0)
			break;
		slot = (slot + 1) % count;
	}
	if (StrCmp(next_wep, "") == 0)
		return 0;

	old_wep = uh_decoy_shiny_held[pn];
	SetInventory("DecoyBotFlag1", slot);
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	GiveInventory(next_wep, 1);
	if (!CheckInventory(next_wep) || !SetWeapon(next_wep)) {
		TakeInventory("UH_SilentSelect_F", 1);
		TakeInventory("NoWeaponSwitchSound", 1);
		return 0;
	}
	if (StrCmp(old_wep, "") != 0 && StrICmp(old_wep, next_wep) != 0)
		TakeInventory(old_wep, 1);
	if (StrICmp(next_wep, "DecoyBotShiny_W") != 0 && CheckInventory("DecoyBotShiny_W")) {
		TakeInventory("DecoyBotShiny_W", 1);
	}
	uh_decoy_shiny_held[pn] = next_wep;
	return 1;
}

// MorphActor carries the ordinary Decoy loadout into the shiny pawn. Remove
// the three dynamically named held weapons so number keys cannot escape the
// one-weapon shiny cycle. The new shiny held actor is equipped by MorphWeapon.
script "uh_DecoyBotShinyMorphSetup" (void) {
	int pn = PlayerNumber();
	if (pn < 0)
		terminate;

	if (StrCmp(uh_decoy_held1[pn], "") != 0)
		TakeInventory(uh_decoy_held1[pn], 1);
	if (StrCmp(uh_decoy_held2[pn], "") != 0)
		TakeInventory(uh_decoy_held2[pn], 1);
	if (StrCmp(uh_decoy_held3[pn], "") != 0)
		TakeInventory(uh_decoy_held3[pn], 1);
	TakeInventory("DecoyBot_W", 1);
	TakeInventory("DecoyBot_W2", 1);
	TakeInventory("DecoyBot_W3", 1);
	uh_decoy_held1[pn] = "";
	uh_decoy_held2[pn] = "";
	uh_decoy_held3[pn] = "";
}

script "uh_DecoyBotShinyStart" (void) {
	// Zandronum clears a pending SetWeapon when the active MorphWeapon is
	// removed in the same tic. Remove it first, then select on the next tic.
	TakeInventory("DecoyBotShiny_W", 1);
	Delay(1);
	SetResultValue(UhDecoyBotShinyEquip(false));
}

script "uh_DecoyBotShinyAdvance" (void) {
	SetResultValue(UhDecoyBotShinyEquip(true));
}

// Called from a move weapon's last animation frame: switch back to the
// launching shiny weapon. TakeInventory of the move wep is deferred to
// parent SilentSelect (uh_ShinyMoveTake) so ReadyWeapon is never None.
script "uh_ShinyMoveReturn" (void) {
	int pn = PlayerNumber();
	str cur;
	str ret;

	if (pn < 0)
		terminate;
	cur = uh_move_current[pn];
	if (StrCmp(cur, "") == 0)
		terminate;
	ret = uh_move_return[pn];
	uh_nega_charge_lvl[pn] = 0;
	uh_decoy_which[pn] = 0;

	// Only clean up when we are still the ready weapon (player may have
	// switched manually mid-move; then the record is simply cleared).
	if (StrICmp(GetWeapon(), cur) != 0) {
		uh_move_current[pn] = "";
		uh_move_return[pn] = "";
		SetInventory("UH_MoveHud_F", 0);
		TakeInventory(cur, 1);
		terminate;
	}
	// Mute ACS menu/cursor (and Decoy gravitywarn) on parent Ready, and
	// mark Select to skip SelectSwap raise + Ready color frame.
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	SetWeapon(ret);
	// Do not TakeInventory here: that sets ReadyWeapon to None and skips
	// move Deselect. Parent SilentSelect calls uh_ShinyMoveTake instead.
}

script "uh_ShinyMoveTake" (void) {
	int pn = PlayerNumber();
	str cur;

	if (pn < 0)
		terminate;
	cur = uh_move_current[pn];
	uh_move_current[pn] = "";
	uh_move_return[pn] = "";
	if (StrCmp(cur, "") != 0)
		TakeInventory(cur, 1);
}

// Team-color the move weapon by the player's shiny class. Call from Select.
// CLRF_SILENT (=1) skips ACS switch noise; StopSound kills engine UpSound.
script "uh_ShinyMoveColor" (void) {
	str cls = GetActorClass(0);
	int dye = UH_MOVE_DYE_MEGA;
	if (StrICmp(cls, "QwantShiny") == 0)
		dye = UH_MOVE_DYE_QWANT;
	else if (StrICmp(cls, "NegaManShiny") == 0)
		dye = UH_MOVE_DYE_NEGA;
	else if (StrICmp(cls, "DecoyBot") == 0 || StrICmp(cls, "DecoyBotShiny") == 0)
		dye = UH_MOVE_DYE_DECOY;
	StopSound(0, CHAN_WEAPON);
	// 1 = CLRF_SILENT (8BDMDEFS); mute ACS menu/cursor switch noise
	ACS_NamedExecuteWithResult("core_weaponcolor", dye, 1);
}

// Shiny MegaMan flat pool roll. which: 0 = M1 (Fire), 1 = M2 (AltFire).
// Always picks from the ACS table (vanilla leaves are registered too).
script "uh_ShinyMegaRollCustom" (int which) {
	int pn = PlayerNumber();
	int n;
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	int poolwhich;

	if (pn < 0) {
		SetResultValue(0);
		terminate;
	}

	if (which == 0) {
		n = uh_shiny_mega_main_count;
		poolwhich = UH_SHINYMEGA_M1;
	}
	else {
		n = uh_shiny_mega_alt_count;
		poolwhich = UH_SHINYMEGA_M2;
	}
	if (n <= 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < n; i++)
		total += which == 0? uh_shiny_mega_main_weight[i]:uh_shiny_mega_alt_weight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < n; i++) {
		acc += which == 0? uh_shiny_mega_main_weight[i]:uh_shiny_mega_alt_weight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	uh_shiny_mega_which[pn] = poolwhich;
	if (which == 0)
		GiveInventory(uh_shiny_mega_main_actor[pick], 1);
	else
		GiveInventory(uh_shiny_mega_alt_actor[pick], 1);
	SetResultValue(1);
}

// Shiny MegaMan full-table roll for DecoyBot's MegaMan copy. Every unique API
// definition contributes exactly one row and its declared weight.
script "uh_ShinyMegaRollTrue" (void) {
	int pn = PlayerNumber();
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	str fire_actor;
	int poolwhich;

	if (pn < 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < uh_shiny_mega_all_count; i++)
		total += uh_shiny_mega_all_weight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < uh_shiny_mega_all_count; i++) {
		acc += uh_shiny_mega_all_weight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	fire_actor = uh_shiny_mega_all_actor[pick];
	poolwhich = uh_shiny_mega_all_kind[pick];
	if (poolwhich == UH_SHINYMEGA_TRUE)
		poolwhich = random(0, 1)? UH_SHINYMEGA_M2:UH_SHINYMEGA_M1;
	uh_shiny_mega_which[pn] = poolwhich;
	GiveInventory(fire_actor, 1);
	SetResultValue(1);
}

// For ShinyMega_*_P Pickup: which pool launched this fire (M1 or M2).
script "uh_ShinyMegaGetWhich" (void) {
	int pn = PlayerNumber();
	SetResultValue(pn >= 0? uh_shiny_mega_which[pn]:0);
}

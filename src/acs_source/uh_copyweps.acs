function int UH_DateToInt(void) {
	int time = SystemTime();
	return GetTimeProperty(time, TM_YEAR) * 10000
	+(GetTimeProperty(time, TM_MONTH) + 1) * 100
	+GetTimeProperty(time, TM_DAY);
}

function int UH_SeedRandom(int seed, int minval, int maxval) {
	int a = 1919810;
	int b = 114514;
	int n = (a * seed + b) & 0x7FFFFFFF;
	if (maxval < minval) {
		int temp = maxval;
		maxval = minval;
		minval = temp;
	}
	return n % (maxval - minval + 1) + minval;
}

function int UH_HashStr(str s) {
	int h = 0;
	int len = StrLen(s);
	for (int i = 0; i < len; i++)
		h = (h * 31 + GetChar(s, i)) & 0x7FFFFFFF;
	return h;
}

function int UH_CopywepIdFromAlias(str cls) {
	for (int i = 0; i < UH_COPYWEP_ALIAS_MAX; i++) {
		if (StrCmp(cls, uh_copywepaliasclass[i]) == 0)
			return FindMegaCopyIdByStemPrefix(uh_copywepaliasname[i]);
	}
	return 0;
}

function int UH_CopywepIdFromActivator(void) {
	str cls = GetActorClass(0);
	int id = FindMegaCopyIdByStemPrefix(cls);
	if (id > 0)
		return id;

	id = UH_CopywepIdFromAlias(cls);
	if (id > 0)
		return id;

	str dtype = GetActorProperty(0, APROP_DamageType);
	if (StrLen(dtype) > 0) {
		id = FindMegaCopyIdByStemPrefix(dtype);
		if (id > 0)
			return id;
	}
	return 0;
}

function int UH_CopywepDmgMul(int wep) {
	int date = UH_DateToInt();
	int mul;
	int i;
	int lucky;
	int maxpool;
	int official = GetMegaOfficialCopyCount();

	if (official < 1)
		official = 103;

	if (wep < 1 || wep > official) {
		return UH_SeedRandom(date + UH_HashStr(GetActorClass(0)) * 893, 0.0, 2.0);
	}

	mul = UH_SeedRandom(date + wep * 893, 0.0, 2.0);

	maxpool = official + official / 2;
	for (i = 1; i <= 4; i++) {
		lucky = UH_SeedRandom(date + 127 * 5 * i, 1, maxpool);
		if (lucky == wep)
			mul = UH_SeedRandom(date + 1234 * 50, 4.0, 6.0);
	}
	maxpool = official * 2;
	for (i = 1; i <= 2; i++) {
		lucky = UH_SeedRandom(date + 721 * 10 * i, 1, maxpool);
		if (lucky == wep)
			mul = UH_SeedRandom(date + 1234 * 100, 8.0, 12.0);
	}
	lucky = UH_SeedRandom(date + 1234 * 50, 1, official * 50);
	if (lucky == wep)
		mul = UH_SeedRandom(date + 1234 * 500, 40.0, 60.0);
	lucky = UH_SeedRandom(date + 567 * 100, 1, official * 100);
	if (lucky == wep)
		mul = UH_SeedRandom(date + 1234 * 1000, 80.0, 120.0);

	return mul;
}

script "uh_TodayDmgMul" (int damage, int allowneg) {
	if (!GetCVar("rz_sv_randMegaManCopywepDmg")) {
		SetResultValue(damage);
		terminate;
	}
	int wep = UH_CopywepIdFromActivator();
	int mul = UH_CopywepDmgMul(wep);
	if (allowneg) {
		int date = UH_DateToInt();
		int seedkey = wep;
		if (seedkey < 1)
			seedkey = UH_HashStr(GetActorClass(0));
		if (UH_SeedRandom(date + 309 + seedkey * 17, 0.0, 1.0) < 0.5)
			mul = -mul;
	}
	SetResultValue(FixedMul(mul, damage));
}

script "uh_debug_ShowTodayDmgMul" (void) {
	int date = UH_DateToInt();
	int official = GetMegaOfficialCopyCount();
	Log(s:"uh_debug_ShowTodayDmgMul date=", i:date,
		s:" official=", i:official,
		s:" rz_sv_randMegaManCopywepDmg=", i:GetCVar("rz_sv_randMegaManCopywepDmg"));
	for (int i = 1; i <= official; i++) {
		Log(s:GetCopyWepDmgStemByMegaId(i), s:" [", i:i, s:"] mul=", f:UH_CopywepDmgMul(i));
	}
}

// --- Daily MegaMan copywep team-FF (leak weapons only; damage = uh_TodayDmgMul result) ---
#define UH_TEAMFF_LEAK_MAX 8
#define UH_TEAMFF_SALT 424242

int uh_teamffleakids[UH_TEAMFF_LEAK_MAX];
int uh_teamffleakdate;
int uh_teamffleakofficial;
int uh_teamffleakcount;

function void UH_EnsureTodayTeamFFLeaks(void) {
	int date = UH_DateToInt();
	int official = GetMegaOfficialCopyCount();
	int want;
	int picked;
	int attempt;
	int i;
	int j;
	int id;
	int dup;

	if (official < 1)
		official = 103;
	if (uh_teamffleakdate == date && uh_teamffleakofficial == official)
		return;

	uh_teamffleakdate = date;
	uh_teamffleakofficial = official;
	want = UH_TEAMFF_LEAK_MAX;
	if (want > official)
		want = official;

	for (i = 0; i < UH_TEAMFF_LEAK_MAX; i++)
		uh_teamffleakids[i] = 0;

	picked = 0;
	attempt = 0;
	while (picked < want && attempt < 1000) {
		attempt++;
		id = UH_SeedRandom(date + UH_TEAMFF_SALT + attempt * 97, 1, official);
		dup = 0;
		for (j = 0; j < picked; j++) {
			if (uh_teamffleakids[j] == id) {
				dup = 1;
				break;
			}
		}
		if (!dup) {
			uh_teamffleakids[picked] = id;
			picked++;
		}
	}
	uh_teamffleakcount = picked;
}

function int UH_IsTodayTeamFFLeak(int wepid) {
	int i;
	if (wepid < 1)
		return 0;
	UH_EnsureTodayTeamFFLeaks();
	for (i = 0; i < uh_teamffleakcount; i++) {
		if (uh_teamffleakids[i] == wepid)
			return 1;
	}
	return 0;
}

function str UH_StripMegaMPrefix(str dtype) {
	if (StrLen(dtype) > 2 && GetChar(dtype, 0) == 77 && GetChar(dtype, 1) == 95)
		return StrMid(dtype, 2, StrLen(dtype) - 2);
	return dtype;
}

script "uh_ApplyCopywepTeamFF" (void) {
	TakeInventory("PowerProtectMegaCopywep", 1);
	if (!CheckInventory("PowerProtectSurvivor"))
		terminate;
	if (!GetCVar("rz_sv_randMegaManCopywepTeamFF"))
		GiveInventory("PowerProtectMegaCopywep", 1);
}

script "uh_ClearCopywepTeamFF" (void) {
	TakeInventory("PowerProtectMegaCopywep", 1);
}

// PREMOD: after PowerProtection / teamdamage, before armor.
// When cvar is on (no blob), zero teammate copywep damage unless today's leak set.
script "uh_CopywepTeamFF" (int evt, int dmg, int dmgtype) EVENT {
	int victpn;
	int srcpn;
	int wepid;
	str stem;

	if (evt != GAMEEVENT_ACTOR_DAMAGED_PREMOD)
		terminate;
	if (!GetCVar("rz_sv_randMegaManCopywepTeamFF"))
		terminate;

	if (!SetActivator(0, AAPTR_DAMAGE_TARGET))
		terminate;
	victpn = PlayerNumber();
	if (victpn < 0)
		terminate;
	if (!CheckInventory("PowerProtectSurvivor"))
		terminate;

	if (!SetActivator(0, AAPTR_DAMAGE_SOURCE))
		terminate;
	srcpn = PlayerNumber();
	if (srcpn < 0)
		terminate;
	if (GetPlayerInfo(victpn, PLAYERINFO_TEAM) != GetPlayerInfo(srcpn, PLAYERINFO_TEAM))
		terminate;

	stem = UH_StripMegaMPrefix(dmgtype);
	wepid = FindMegaCopyIdByStemPrefix(stem);
	if (wepid < 1)
		terminate;
	if (UH_IsTodayTeamFFLeak(wepid))
		terminate;
	SetResultValue(0);
}

script "uh_debug_ShowTodayTeamFF" (void) {
	int i;
	int date = UH_DateToInt();
	int official = GetMegaOfficialCopyCount();

	UH_EnsureTodayTeamFFLeaks();
	Log(s:"uh_debug_ShowTodayTeamFF date=", i:date,
		s:" official=", i:official,
		s:" leakCount=", i:uh_teamffleakcount,
		s:" rz_sv_randMegaManCopywepTeamFF=", i:GetCVar("rz_sv_randMegaManCopywepTeamFF"));
	for (i = 0; i < uh_teamffleakcount; i++) {
		Log(s:"  leak ", i:i + 1, s:": ",
			s:GetCopyWepDmgStemByMegaId(uh_teamffleakids[i]),
			s:" [", i:uh_teamffleakids[i], s:"]");
	}
}

// ============================================================================
// Shiny move-weapon runtime (dispatchers + return). Weapon states on clients
// get 0 from non-CLIENTSIDE scripts; the server's GiveInventory/SetWeapon are
// synced, so a handled roll self-corrects within a tick or two.
// ============================================================================

// Team-color dyes (must match UH_COLORS.acs / ConstIntList_Ucolors.dec).
#define UH_MOVE_DYE_MEGA 30000
#define UH_MOVE_DYE_QWANT 30001
#define UH_MOVE_DYE_NEGA 30002
#define UH_MOVE_DYE_DECOY 20050

// Per-player dispatch records (indexed by PlayerNumber; -1 = not a player).
str uh_movereturn[64];
str uh_movecurrent[64];
int uh_negachargelvl[64];
int uh_shinymegawhich[64];
int uh_decoywhich[64];

// QwantShiny AltFire: flat weighted roll of the ACS table (vanilla + addon).
// 1 = move weapon selected; 0 = empty table / failure.
script "uh_QwantShinyMoveRoll" (void) {
	int pn = PlayerNumber();
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	str wep;

	if (pn < 0 || uh_shinyqwantmovecount <= 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < uh_shinyqwantmovecount; i++)
		total += uh_shinyqwantmoveweight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < uh_shinyqwantmovecount; i++) {
		acc += uh_shinyqwantmoveweight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	wep = uh_shinyqwantmovewep[pick];
	uh_movereturn[pn] = GetWeapon();
	uh_movecurrent[pn] = wep;
	uh_negachargelvl[pn] = 0;
	uh_decoywhich[pn] = 0;
	SetInventory("UH_MoveHud_F", 1);
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory(wep, 1);
	SetWeapon(wep);
	SetResultValue(1);
}

// Legacy SetWeapon dispatch — unused; held cycle fires in place.
script "uh_ShinyNegaCustomFire" (int lvl) {
	SetResultValue(0);
}

// Full-charge end: Give next cycle wep (or buster), SilentSelect, Take current.
// SNegaFlag stays as HUD sync only.
script "uh_ShinyNegaAdvanceHeld" (void) {
	int pn = PlayerNumber();
	int slot;
	int next;
	int waits;
	str old;
	str neww;

	if (pn < 0)
		terminate;

	waits = 0;
	while (StrCmp(uh_shinynegaslotwep[1][0], "") == 0 && waits < 35) {
		delay(1);
		waits++;
	}

	slot = CheckInventory("SNegaFlag");
	old = GetWeapon();
	if (StrICmp(old, "NegaManShiny_W") == 0)
		slot = 0;
	else if (StrCmp(uh_negaheld[pn], "") != 0)
		old = uh_negaheld[pn];

	next = UH_ShinyNegaNextSlot(slot);

	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);

	if (next <= 0) {
		neww = "NegaManShiny_W";
		SetInventory("SNegaFlag", 0);
	}
	else {
		neww = GetShinyNegaSlotWep(next, 1);
		if (StrCmp(neww, "") == 0) {
			neww = "NegaManShiny_W";
			SetInventory("SNegaFlag", 0);
			next = 0;
		}
		else
			SetInventory("SNegaFlag", next);
	}

	GiveInventory(neww, 1);
	SetWeapon(neww);
	if (StrCmp(old, "") != 0 && StrICmp(old, neww) != 0)
		TakeInventory(old, 1);
	uh_negaheld[pn] = neww;
	uh_negachargelvl[pn] = 0;
	SetInventory("UH_MoveHud_F", 0);
	TakeInventory("WeaponCharge", 999);
}

// For the move weapon's Select: which charge level launched it (1..3, 0 none).
script "uh_ShinyNegaGetChargeLevel" (void) {
	int pn = PlayerNumber();
	SetResultValue(pn >= 0? uh_negachargelvl[pn]:0);
}

// Gate for docs / rare DECORATE checks: 1 = addon slots 26..33 present.
script "uh_HasCustomNegaSlots" (void) {
	SetResultValue(HasCustomNegaSlots());
}

function str UH_CopyParentFromHud(void) {
	int hud = CheckInventory("UH_MoveHud_F");
	if (hud == 1)
		return "QwantShiny_W";
	if (hud == 2)
		return "NegaManShiny_W";
	if (hud == 3)
		return "DecoyBot_W";
	if (hud == 4)
		return "DecoyBot_W2";
	if (hud == 5)
		return "DecoyBot_W3";
	return "";
}

// Client prediction: uh_ShinyMoveReturn is server-only, so SetWeapon never
// runs locally. Without a pending parent, Deselect/A_Lower re-raises the copy
// (6H50 A); a TNT1 wait holds the copy forever (gun vanishes). Set pending
// here so A_Lower brings up the parent.
script "uh_ShinyMoveReturn_cs" (void) CLIENTSIDE {
	int pn = PlayerNumber();
	int cons = ConsolePlayerNumber();
	str ret;
	if (cons >= 0 && pn != cons)
		terminate;
	ret = UH_CopyParentFromHud();
	if (StrCmp(ret, "") == 0)
		terminate;
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	SetWeapon(ret);
}

// Legacy M1 SetWeapon dispatch — unused; held copies fire in place.
script "uh_DecoyBotCustomFire" (int which) {
	SetResultValue(0);
}

// Which weapon slot is currently ready (1/2/3) from GetWeapon() suffix.
function int UH_DecoyHeldSlotFromWeapon(str wep) {
	int len = StrLen(wep);
	int d;
	if (len >= 4
		&& GetChar(wep, len - 3) == '_'
		&& GetChar(wep, len - 2) == 'W') {
		d = GetChar(wep, len - 1);
		if (d == '2')
			return 2;
		if (d == '3')
			return 3;
		if (d == '1')
			return 1;
	}
	if (StrICmp(wep, "DecoyBot_W2") == 0)
		return 2;
	if (StrICmp(wep, "DecoyBot_W3") == 0)
		return 3;
	return 1;
}

// After M2 roll: Give three new held copies, SetWeapon current slot, Take old.
// Always strip leftover DecoyBot_W* parents (ScriptBar-only; never held).
script "uh_DecoyBotApplyHeldWeps" (void) {
	int pn = PlayerNumber();
	int s1;
	int s2;
	int s3;
	int slot;
	str stem1;
	str stem2;
	str stem3;
	str new1;
	str new2;
	str new3;
	str old1;
	str old2;
	str old3;
	str cur;
	str setto;

	if (pn < 0)
		terminate;
	// Caller (WepSwap) waits for the table; do not bootstrap 00 here.
	if (uh_decoymovecount <= 0)
		terminate;

	s1 = CheckInventory("DecoyBotFlag1");
	s2 = CheckInventory("DecoyBotFlag2");
	s3 = CheckInventory("DecoyBotFlag3");
	if (s1 < 0 || s1 >= uh_decoymovecount)
		terminate;
	if (s2 < 0 || s2 >= uh_decoymovecount)
		terminate;
	if (s3 < 0 || s3 >= uh_decoymovecount)
		terminate;

	stem1 = uh_decoymovewep[s1];
	stem2 = uh_decoymovewep[s2];
	stem3 = uh_decoymovewep[s3];
	if (StrCmp(stem1, "") == 0 || StrCmp(stem2, "") == 0 || StrCmp(stem3, "") == 0)
		terminate;

	new1 = StrParam(s:stem1, s:"_W1");
	new2 = StrParam(s:stem2, s:"_W2");
	new3 = StrParam(s:stem3, s:"_W3");

	old1 = uh_decoyheld1[pn];
	old2 = uh_decoyheld2[pn];
	old3 = uh_decoyheld3[pn];

	cur = GetWeapon();
	slot = UH_DecoyHeldSlotFromWeapon(cur);
	if (slot == 2)
		setto = new2;
	else if (slot == 3)
		setto = new3;
	else
		setto = new1;

	// Before any Give: first auto-raise must SilentSelect (not SelectSwap Ready).
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);

	GiveInventory(new1, 1);
	GiveInventory(new2, 1);
	GiveInventory(new3, 1);

	SetWeapon(setto);

	if (StrCmp(old1, "") != 0 && StrICmp(old1, new1) != 0)
		TakeInventory(old1, 1);
	if (StrCmp(old2, "") != 0 && StrICmp(old2, new2) != 0)
		TakeInventory(old2, 1);
	if (StrCmp(old3, "") != 0 && StrICmp(old3, new3) != 0)
		TakeInventory(old3, 1);

	// Parents are never valid held guns (ScriptBar / bar remap only).
	TakeInventory("DecoyBot_W", 1);
	TakeInventory("DecoyBot_W2", 1);
	TakeInventory("DecoyBot_W3", 1);

	uh_decoyheld1[pn] = new1;
	uh_decoyheld2[pn] = new2;
	uh_decoyheld3[pn] = new3;
}

// For Decoy move Select: which launcher weapon (1..3).
// Array is server-only; on clients (v==0) derive from synced UH_MoveHud_F.
script "uh_DecoyBotGetWhich" (void) {
	int pn = PlayerNumber();
	int v = pn >= 0? uh_decoywhich[pn]:0;
	int hud;
	if (v <= 0) {
		hud = CheckInventory("UH_MoveHud_F");
		if (hud >= 3 && hud <= 5)
			v = hud - 2;
		else
			v = 1;
	}
	SetResultValue(v);
}

// Dynamic DecoyBot copy slot count.
script "uh_CountDecoyBotSlots" (void) {
	SetResultValue(CountDecoyBotSlots());
}

// Equip Shiny Decoy's current slot, or advance to the next registered shiny
// partner. Old addons may leave shiny entries empty; M2 skips those rows.
function int UH_DecoyBotShinyEquip(int advance) {
	int pn = PlayerNumber();
	int count = CountDecoyBotSlots();
	int slot;
	int tries;
	str nextwep;
	str oldwep;

	if (pn < 0 || count <= 0)
		return 0;
	slot = CheckInventory("DecoyBotFlag1");
	if (slot < 0 || slot >= count)
		slot = 0;
	if (advance)
		slot = (slot + 1) % count;

	for (tries = 0; tries < count; tries++) {
		nextwep = uh_decoyshinywep[slot];
		if (StrCmp(nextwep, "") != 0)
			break;
		slot = (slot + 1) % count;
	}
	if (StrCmp(nextwep, "") == 0)
		return 0;

	oldwep = uh_decoyshinyheld[pn];
	SetInventory("DecoyBotFlag1", slot);
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	GiveInventory(nextwep, 1);
	if (!CheckInventory(nextwep) || !SetWeapon(nextwep)) {
		TakeInventory("UH_SilentSelect_F", 1);
		TakeInventory("NoWeaponSwitchSound", 1);
		return 0;
	}
	if (StrCmp(oldwep, "") != 0 && StrICmp(oldwep, nextwep) != 0)
		TakeInventory(oldwep, 1);
	if (StrICmp(nextwep, "DecoyBotShiny_W") != 0 && CheckInventory("DecoyBotShiny_W")) {
		TakeInventory("DecoyBotShiny_W", 1);
	}
	uh_decoyshinyheld[pn] = nextwep;
	return 1;
}

// MorphActor carries the ordinary Decoy loadout into the shiny pawn. Remove
// the three dynamically named held weapons so number keys cannot escape the
// one-weapon shiny cycle. The new shiny held actor is equipped by MorphWeapon.
script "uh_DecoyBotShinyMorphSetup" (void) {
	int pn = PlayerNumber();
	if (pn < 0)
		terminate;

	if (StrCmp(uh_decoyheld1[pn], "") != 0)
		TakeInventory(uh_decoyheld1[pn], 1);
	if (StrCmp(uh_decoyheld2[pn], "") != 0)
		TakeInventory(uh_decoyheld2[pn], 1);
	if (StrCmp(uh_decoyheld3[pn], "") != 0)
		TakeInventory(uh_decoyheld3[pn], 1);
	TakeInventory("DecoyBot_W", 1);
	TakeInventory("DecoyBot_W2", 1);
	TakeInventory("DecoyBot_W3", 1);
	uh_decoyheld1[pn] = "";
	uh_decoyheld2[pn] = "";
	uh_decoyheld3[pn] = "";
}

script "uh_DecoyBotShinyStart" (void) {
	// Zandronum clears a pending SetWeapon when the active MorphWeapon is
	// removed in the same tic. Remove it first, then select on the next tic.
	TakeInventory("DecoyBotShiny_W", 1);
	Delay(1);
	SetResultValue(UH_DecoyBotShinyEquip(false));
}

script "uh_DecoyBotShinyAdvance" (void) {
	SetResultValue(UH_DecoyBotShinyEquip(true));
}

// Called from a move weapon's last animation frame: switch back to the
// launching shiny weapon. TakeInventory of the move wep is deferred to
// parent SilentSelect (uh_ShinyMoveTake) so ReadyWeapon is never None.
script "uh_ShinyMoveReturn" (void) {
	int pn = PlayerNumber();
	str cur;
	str ret;

	if (pn < 0)
		terminate;
	cur = uh_movecurrent[pn];
	if (StrCmp(cur, "") == 0)
		terminate;
	ret = uh_movereturn[pn];
	uh_negachargelvl[pn] = 0;
	uh_decoywhich[pn] = 0;

	// Only clean up when we are still the ready weapon (player may have
	// switched manually mid-move; then the record is simply cleared).
	if (StrICmp(GetWeapon(), cur) != 0) {
		uh_movecurrent[pn] = "";
		uh_movereturn[pn] = "";
		SetInventory("UH_MoveHud_F", 0);
		TakeInventory(cur, 1);
		terminate;
	}
	// Mute ACS menu/cursor (and Decoy gravitywarn) on parent Ready, and
	// mark Select to skip SelectSwap raise + Ready color frame.
	GiveInventory("NoWeaponSwitchSound", 1);
	GiveInventory("UH_SilentSelect_F", 1);
	SetWeapon(ret);
	// Do not TakeInventory here: that sets ReadyWeapon to None and skips
	// move Deselect. Parent SilentSelect calls uh_ShinyMoveTake instead.
}

script "uh_ShinyMoveTake" (void) {
	int pn = PlayerNumber();
	str cur;

	if (pn < 0)
		terminate;
	cur = uh_movecurrent[pn];
	uh_movecurrent[pn] = "";
	uh_movereturn[pn] = "";
	if (StrCmp(cur, "") != 0)
		TakeInventory(cur, 1);
}

// Team-color the move weapon by the player's shiny class. Call from Select.
// CLRF_SILENT (=1) skips ACS switch noise; StopSound kills engine UpSound.
script "uh_ShinyMoveColor" (void) {
	str cls = GetActorClass(0);
	int dye = UH_MOVE_DYE_MEGA;
	if (StrICmp(cls, "QwantShiny") == 0)
		dye = UH_MOVE_DYE_QWANT;
	else if (StrICmp(cls, "NegaManShiny") == 0)
		dye = UH_MOVE_DYE_NEGA;
	else if (StrICmp(cls, "DecoyBot") == 0 || StrICmp(cls, "DecoyBotShiny") == 0)
		dye = UH_MOVE_DYE_DECOY;
	StopSound(0, CHAN_WEAPON);
	// 1 = CLRF_SILENT (8BDMDEFS); mute ACS menu/cursor switch noise
	ACS_NamedExecuteWithResult("core_weaponcolor", dye, 1);
}

// Shiny MegaMan flat pool roll. which: 0 = M1 (Fire), 1 = M2 (AltFire).
// Always picks from the ACS table (vanilla leaves are registered too).
script "uh_ShinyMegaRollCustom" (int which) {
	int pn = PlayerNumber();
	int n;
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	int poolwhich;

	if (pn < 0) {
		SetResultValue(0);
		terminate;
	}

	if (which == 0) {
		n = uh_shinymegamaincount;
		poolwhich = UH_SHINYMEGA_M1;
	}
	else {
		n = uh_shinymegaaltcount;
		poolwhich = UH_SHINYMEGA_M2;
	}
	if (n <= 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < n; i++)
		total += which == 0? uh_shinymegamainweight[i]:uh_shinymegaaltweight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < n; i++) {
		acc += which == 0? uh_shinymegamainweight[i]:uh_shinymegaaltweight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	uh_shinymegawhich[pn] = poolwhich;
	if (which == 0)
		GiveInventory(uh_shinymegamainactor[pick], 1);
	else
		GiveInventory(uh_shinymegaaltactor[pick], 1);
	SetResultValue(1);
}

// Shiny MegaMan full-table roll for DecoyBot's MegaMan copy. Every unique API
// definition contributes exactly one row and its declared weight.
script "uh_ShinyMegaRollTrue" (void) {
	int pn = PlayerNumber();
	int total;
	int roll;
	int acc;
	int i;
	int pick;
	str fireactor;
	int poolwhich;

	if (pn < 0) {
		SetResultValue(0);
		terminate;
	}

	total = 0;
	for (i = 0; i < uh_shinymegaallcount; i++)
		total += uh_shinymegaallweight[i];
	if (total <= 0) {
		SetResultValue(0);
		terminate;
	}

	roll = random(0, total - 1);
	acc = 0;
	pick = -1;
	for (i = 0; i < uh_shinymegaallcount; i++) {
		acc += uh_shinymegaallweight[i];
		if (roll < acc) {
			pick = i;
			break;
		}
	}
	if (pick < 0) {
		SetResultValue(0);
		terminate;
	}

	fireactor = uh_shinymegaallactor[pick];
	poolwhich = uh_shinymegaallkind[pick];
	if (poolwhich == UH_SHINYMEGA_TRUE)
		poolwhich = random(0, 1)? UH_SHINYMEGA_M2:UH_SHINYMEGA_M1;
	uh_shinymegawhich[pn] = poolwhich;
	GiveInventory(fireactor, 1);
	SetResultValue(1);
}

// For ShinyMega_*_P Pickup: which pool launched this fire (M1 or M2).
script "uh_ShinyMegaGetWhich" (void) {
	int pn = PlayerNumber();
	SetResultValue(pn >= 0? uh_shinymegawhich[pn]:0);
}

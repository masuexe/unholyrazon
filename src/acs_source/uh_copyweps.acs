#library "uh_copyweps"
#include "zcommon.acs"
#import "uh_acsutils.acs"
#import "uhdt.acs"

function int MegaWepRNG_Func(int max_r2, int skip) {
	int dwep;
	if (max_r2 <= 0)
		return -1;
	if (max_r2 == 1)
		return 0;
	do {
		dwep = random(0, max_r2 - 1);
	} while (dwep == skip);
	return dwep;
}

script "uh_MegamanWeapons" (int check) {
	int n1 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_RANGED);
	int n2 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_RAPID);
	int n3 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_CLOSE);
	int n4 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_POWER);
	int n5 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_AOE);
	int n6 = CountCopyWepByKindSlot(UHCOPY_MEGA, UHCOPY_SLOT_SHIELD);
	int w1 = CheckInventory("MegaSlotRanged_F") - 1;
	int w2 = CheckInventory("MegaSlotRapid_F") - 1;
	int w3 = CheckInventory("MegaSlotClose_F") - 1;
	int w4 = CheckInventory("MegaSlotPower_F") - 1;
	int w5 = CheckInventory("MegaSlotAoE_F") - 1;
	int w6 = CheckInventory("MegaSlotShield_F") - 1;
	str wep;

	if (w1 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_RANGED, w1);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}
	if (w2 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_RAPID, w2);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}
	if (w3 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_CLOSE, w3);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}
	if (w4 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_POWER, w4);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}
	if (w5 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_AOE, w5);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}
	if (w6 >= 0) {
		wep = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_SHIELD, w6);
		if (StrCmp(wep, "") != 0)
			TakeInventory(wep, 1);
	}

	w1 = MegaWepRNG_Func(n1, w1);
	w2 = MegaWepRNG_Func(n2, w2);
	w3 = MegaWepRNG_Func(n3, w3);
	w4 = MegaWepRNG_Func(n4, w4);
	w5 = MegaWepRNG_Func(n5, w5);
	w6 = MegaWepRNG_Func(n6, w6);

	if (w1 >= 0)
		SetInventory("MegaSlotRanged_F", w1 + 1);
	if (w2 >= 0)
		SetInventory("MegaSlotRapid_F", w2 + 1);
	if (w3 >= 0)
		SetInventory("MegaSlotClose_F", w3 + 1);
	if (w4 >= 0)
		SetInventory("MegaSlotPower_F", w4 + 1);
	if (w5 >= 0)
		SetInventory("MegaSlotAoE_F", w5 + 1);
	if (w6 >= 0)
		SetInventory("MegaSlotShield_F", w6 + 1);

	if (w1 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_RANGED, w1), 1);
	if (w2 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_RAPID, w2), 1);
	if (w3 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_CLOSE, w3), 1);
	if (w4 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_POWER, w4), 1);
	if (w5 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_AOE, w5), 1);
	if (w6 >= 0)
		GiveInventory(GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, UHCOPY_SLOT_SHIELD, w6), 1);
}

script "uh_QwantMoveRelearn" (void) {
	int qcount = CountCopyWepByKind(UHCOPY_QWANT);
	int i;
	int t1;
	int t2;
	int t3;
	int t4;
	int temp;
	int newmove;
	str currwep;

	if (GetUserArray(0, "user_PKMN_MoveMem", 7) == 77) {
		Log(s:"\cgERROR [!] \cdQwant variables are not set!");
		terminate;
	}
	currwep = GetWeapon();
	for (i = 0; i < qcount; i++) {
		if (StrCmp(currwep, GetCopyWepActorByKindIndex(UHCOPY_QWANT, i)) == 0)
			break;
	}
	if (i >= qcount) {
		Log(s:"\cgERROR [!] \cdThis weapon is not in the move list! >> \ck", s:currwep);
		terminate;
	}

	t1 = GetUserArray(0, "user_PKMN_MoveMem", 0);
	t2 = GetUserArray(0, "user_PKMN_MoveMem", 1);
	t3 = GetUserArray(0, "user_PKMN_MoveMem", 2);
	t4 = GetUserArray(0, "user_PKMN_MoveMem", 3);
	newmove = Func_QwantCheckRNG(t1, t2, t3, t4);

	if (i == t1)
		temp = 0;
	else if (i == t2)
		temp = 1;
	else if (i == t3)
		temp = 2;
	else if (i == t4)
		temp = 3;
	else
		temp = 0;

	SetUserArray(0, "user_PKMN_MoveMem", temp, newmove);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, newmove), 1);
	SetWeapon(GetCopyWepActorByKindIndex(UHCOPY_QWANT, newmove));
	TakeInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, i), 1);
}

script "uh_QwantDebugUserArray" (void) {
	Log(s:"\cduh_QwantDebugUserArray");
	Log(i:GetUserArray(0, "user_PKMN_MoveMem", 0));
	Log(i:GetUserArray(0, "user_PKMN_MoveMem", 1));
	Log(i:GetUserArray(0, "user_PKMN_MoveMem", 2));
	Log(i:GetUserArray(0, "user_PKMN_MoveMem", 3));
	Log(i:GetUserArray(0, "user_PKMN_MoveMem", 7));
}

script "uh_QwantStartMoves" (void) {
	int waits;
	int qcount;
	int t1;
	int t2;
	int t3;
	int t4;

	// startitem Pickup can run before uh_define_vanilla_copyweps OPEN fills UHDT.
	waits = 0;
	qcount = CountCopyWepByKind(UHCOPY_QWANT);
	while (qcount <= 0 && waits < 35) {
		Delay(1);
		waits++;
		qcount = CountCopyWepByKind(UHCOPY_QWANT);
	}
	if (qcount <= 0)
		terminate;

	t1 = Func_QwantCheckRNG(-1, -1, -1, -1);
	t2 = Func_QwantCheckRNG(t1, -1, -1, -1);
	t3 = Func_QwantCheckRNG(t1, t2, -1, -1);
	t4 = Func_QwantCheckRNG(t1, t2, t3, -1);

	SetUserArray(0, "user_PKMN_MoveMem", 0, t1);
	SetUserArray(0, "user_PKMN_MoveMem", 1, t2);
	SetUserArray(0, "user_PKMN_MoveMem", 2, t3);
	SetUserArray(0, "user_PKMN_MoveMem", 3, t4);
	SetUserArray(0, "user_PKMN_MoveMem", 7, 777);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, t1), 1);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, t2), 1);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, t3), 1);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_QWANT, t4), 1);
}

function int Func_QwantCheckRNG(int p1, int p2, int p3, int p4) {
	int qcount = CountCopyWepByKind(UHCOPY_QWANT);
	int qwep;
	if (qcount <= 0)
		return 0;
	if (qcount == 1)
		return 0;
	do {
		qwep = random(0, qcount - 1);
	} while (qwep == p1 || qwep == p2 || qwep == p3 || qwep == p4);
	return qwep;
}

function void GiveNegaStartCopyWeps(void) {
	int ncount = CountCopyWepByKind(UHCOPY_NEGA);
	int negalimit;
	int negaulast2;
	int negaulast1;
	int negau;

	if (ncount <= 0)
		return;
	negalimit = 2;
	negaulast2 = -1;
	negaulast1 = random(0, ncount - 1);
	GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_NEGA, negaulast1), 1);
	while (negalimit > 0) {
		while (negalimit > 1) {
			negau = random(0, ncount - 1);
			if (negau != negaulast1) {
				GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_NEGA, negau), 1);
				negaulast2 = negau;
				negalimit--;
			}
		}
		negau = random(0, ncount - 1);
		if (negau != negaulast1 && negau != negaulast2) {
			GiveInventory(GetCopyWepActorByKindIndex(UHCOPY_NEGA, negau), 1);
			negalimit--;
		}
	}
}

script "uh_NegaManStartMoves" (void) {
	int waits;
	int ncount;

	waits = 0;
	ncount = CountCopyWepByKind(UHCOPY_NEGA);
	while (ncount <= 0 && waits < 35) {
		Delay(1);
		waits++;
		ncount = CountCopyWepByKind(UHCOPY_NEGA);
	}
	if (ncount <= 0)
		terminate;
	GiveNegaStartCopyWeps();
}

script "uh_GiveRandomCopyweps" (int check) {
	if (check == 0)
		Log(s:"U_RNGWEAPONGIVE CHECK 0 IS GONE! USE UH_COPYWEPS.acs");
	if (check == 1)
		Log(s:"U_RNGWEAPONGIVE CHECK 1 IS GONE! USE UH_COPYWEPS.acs");
	if (check == 2)
		GiveNegaStartCopyWeps();
}

// --- Pharaoh Roulette: copywep pool (exact MegaManU / Qwant / NegaMan only) ---
#define RZ_COPY_NONE 0
#define RZ_COPY_MEGA 1
#define RZ_COPY_QWANT 2
#define RZ_COPY_NEGA 3

str rz_copyownedbuf[16];
int rz_copyownedn;

function int RZ_CopyWepKind(void) {
	str cls = GetActorClass(0);
	if (StrCmp(cls, "MegaManU") == 0)
		return RZ_COPY_MEGA;
	if (StrCmp(cls, "Qwant") == 0)
		return RZ_COPY_QWANT;
	if (StrCmp(cls, "NegaMan") == 0)
		return RZ_COPY_NEGA;
	return RZ_COPY_NONE;
}

function void RZ_CopyOwnedPush(str weap) {
	if (rz_copyownedn >= 16 || StrLen(weap) == 0)
		return;
	rz_copyownedbuf[rz_copyownedn] = weap;
	rz_copyownedn++;
}

function void RZ_CopyOwnedPushMegaSlot(str slotflag, int slot) {
	int idx = CheckInventory(slotflag) - 1;
	str cand;
	if (idx < 0)
		return;
	cand = GetCopyWepActorByKindSlotIndex(UHCOPY_MEGA, slot, idx);
	if (StrLen(cand) > 0)
		RZ_CopyOwnedPush(cand);
}

function int RZ_CollectCopyOwned(void) {
	rz_copyownedn = 0;
	int kind = RZ_CopyWepKind();
	int i;
	int move;
	int qcount;
	int ncount;
	str wep;

	if (kind == RZ_COPY_MEGA) {
		if (CheckInventory("MegaManU_W"))
			RZ_CopyOwnedPush("MegaManU_W");
		RZ_CopyOwnedPushMegaSlot("MegaSlotRanged_F", UHCOPY_SLOT_RANGED);
		RZ_CopyOwnedPushMegaSlot("MegaSlotRapid_F", UHCOPY_SLOT_RAPID);
		RZ_CopyOwnedPushMegaSlot("MegaSlotClose_F", UHCOPY_SLOT_CLOSE);
		RZ_CopyOwnedPushMegaSlot("MegaSlotPower_F", UHCOPY_SLOT_POWER);
		RZ_CopyOwnedPushMegaSlot("MegaSlotAoE_F", UHCOPY_SLOT_AOE);
		RZ_CopyOwnedPushMegaSlot("MegaSlotShield_F", UHCOPY_SLOT_SHIELD);
		return rz_copyownedn;
	}
	if (kind == RZ_COPY_QWANT) {
		if (CheckInventory("Qwant_W"))
			RZ_CopyOwnedPush("Qwant_W");
		qcount = CountCopyWepByKind(UHCOPY_QWANT);
		for (i = 0; i < 4; i++) {
			move = GetUserArray(0, "user_PKMN_MoveMem", i);
			if (move >= 0 && move < qcount) {
				wep = GetCopyWepActorByKindIndex(UHCOPY_QWANT, move);
				if (CheckInventory(wep))
					RZ_CopyOwnedPush(wep);
			}
		}
		return rz_copyownedn;
	}
	if (kind == RZ_COPY_NEGA) {
		if (CheckInventory("NegaMan_W"))
			RZ_CopyOwnedPush("NegaMan_W");
		ncount = CountCopyWepByKind(UHCOPY_NEGA);
		for (i = 0; i < ncount; i++) {
			wep = GetCopyWepActorByKindIndex(UHCOPY_NEGA, i);
			if (CheckInventory(wep))
				RZ_CopyOwnedPush(wep);
		}
		return rz_copyownedn;
	}
	return 0;
}

function int RZ_CountCopyWeaponsFunc(void) {
	return RZ_CollectCopyOwned();
}

script "rz_CountCopyWeapons" (void) {
	SetResultValue(RZ_CountCopyWeaponsFunc());
}

script "rz_RoulettePickCopyWeapon" (void) {
	str weap = GetWeapon();
	int n = RZ_CollectCopyOwned();
	if (n < 2) {
		SetResultValue(0);
		terminate;
	}
	for (int tries = 0; tries < 24; tries++) {
		int idx = random(0, n - 1);
		if (StrCmp(rz_copyownedbuf[idx], weap) != 0) {
			SetWeapon(rz_copyownedbuf[idx]);
			SetResultValue(1);
			terminate;
		}
	}
	for (int j = 0; j < n; j++) {
		if (StrCmp(rz_copyownedbuf[j], weap) != 0) {
			SetWeapon(rz_copyownedbuf[j]);
			SetResultValue(1);
			terminate;
		}
	}
	SetResultValue(0);
}

script "rz_FlameBurstSplitDmg" (int ratio) {
	int victim = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TRACER);
	int owner = ACS_NamedExecuteWithResult("core_getptrtid", AAPTR_TARGET);
	if (victim <= 0)
		terminate;

	int maxhp = GetActorProperty(victim, APROP_SPAWNHEALTH);
	if (maxhp <= 0)
		maxhp = 100;
	int dmg = maxhp / ratio;
	if (dmg <= 0)
		terminate;

	ACS_NamedExecuteWithResult("core_damageactor", "FlameBurstSplitDamager", dmg, victim, owner);
}

// --- MegaManU / Qwant / Nega Ready ammo regen ---
#define UH_COPYWEP_REGEN_PULSES 8
#define UH_COPYWEP_REGEN_BASE 28

int uh_cwregencount[64];
int uh_cwregenlasttic[64];

str uh_qwanttypeammo[18] = {
	"NormalTypeAmmo",
	"FireTypeAmmo",
	"WaterTypeAmmo",
	"ElectricTypeAmmo",
	"GrassTypeAmmo",
	"IceTypeAmmo",
	"FightingTypeAmmo",
	"PoisonTypeAmmo",
	"GroundTypeAmmo",
	"FlyingTypeAmmo",
	"PsychicTypeAmmo",
	"BugTypeAmmo",
	"RockTypeAmmo",
	"GhostTypeAmmo",
	"DragonTypeAmmo",
	"DarkTypeAmmo",
	"SteelTypeAmmo",
	"FairyTypeAmmo"
};

function void UH_CopyWepGiveRatio(str ammo) {
	int give;
	if (StrCmp(ammo, "") == 0)
		return;
	give = GetAmmoCapacity(ammo) / UH_COPYWEP_REGEN_BASE;
	if (give < 1)
		give = 1;
	GiveInventory(ammo, give);
}

function str UH_CopyWepNegaAmmo(int slot) {
	switch (slot) {
		case 1: return "NegaMM1_Ammo";
		case 2: return "NegaMM2_Ammo";
		case 3: return "NegaMM3_Ammo";
		case 4: return "NegaMM4_Ammo";
		case 5: return "NegaMM5_Ammo";
		case 6: return "NegaMM6_Ammo";
		case 7: return "NegaMM7_Ammo";
		case 8: return "NegaMM8_Ammo";
		case 9: return "NegaMM9_Ammo";
		case 10: return "NegaMM10_Ammo";
		case 11: return "NegaMM11_Ammo";
		case 12: return "NegaMMB_Ammo";
		case 13: return "NegaMMK_Ammo";
		case 14: return "NegaMMV_Ammo";
		case 15: return "NegaMMWT_Ammo";
	}
	return "";
}

// immediate: 1 = one Ready pulse (8-tic DECORATE loops). 0 = MegaManU 1-tic gate.
script "uh_CopyWepReadyRegen" (int immediate) {
	int pn = PlayerNumber();
	int len;
	int t;
	int row;
	int kind;
	int slot;
	int skip;
	str wep;
	str ammo;

	if (pn < 0) {
		SetResultValue(0);
		terminate;
	}

	wep = GetWeapon();
	len = StrLen(wep);

	if (!immediate) {
		t = Timer();
		if (uh_cwregenlasttic[pn] != t - 1)
			uh_cwregencount[pn] = 0;
		uh_cwregenlasttic[pn] = t;

		uh_cwregencount[pn]++;
		if (uh_cwregencount[pn] < UH_COPYWEP_REGEN_PULSES) {
			SetResultValue(0);
			terminate;
		}
		uh_cwregencount[pn] = 0;
	}

	if (len >= 4 && StrCmp(StrRight(wep, 4), "WepU") == 0) {
		ammo = StrParam(s:StrLeft(wep, len - 4), s:"Ammo");
		UH_CopyWepGiveRatio(ammo);
		SetResultValue(1);
		terminate;
	}

	row = FindCopyWepByActor(wep);
	if (row < 0) {
		SetResultValue(0);
		terminate;
	}

	kind = GetCopyWepKind(row);
	slot = GetCopyWepSlot(row);
	skip = GetCopyWepRegenFlags(row) & UHCOPY_REGEN_SKIP_ENERGY;

	if (kind == UHCOPY_QWANT) {
		if (!skip && slot >= 0 && slot < 18)
			UH_CopyWepGiveRatio(uh_qwanttypeammo[slot]);
		GiveInventory("MoveRelearnAmmo", 1);
		SetResultValue(1);
		terminate;
	}

	if (kind == UHCOPY_NEGA) {
		if (!skip)
			UH_CopyWepGiveRatio(UH_CopyWepNegaAmmo(slot));
		SetResultValue(1);
		terminate;
	}

	SetResultValue(0);
}

script "uh_MegaManUNoAmmo" (void) {
	if (PlayerIsBot(PlayerNumber())) {
		str wep = GetWeapon();
		int len = StrLen(wep);
		str ammo = "BusterAmmo";
		if (len >= 4 && StrCmp(StrRight(wep, 4), "WepU") == 0)
			ammo = StrParam(s:StrLeft(wep, len - 4), s:"Ammo");

		ACS_NamedExecuteWithResult("core_freezeplayer", 0, 1);
		GiveInventory(ammo, GetAmmoCapacity(ammo));
		Delay(15);
		ACS_NamedExecuteWithResult("core_freezeplayer", 0, 0);
	}
}

function int DefineSurvivorCore(int id, str actor, str name, str mugshot)
{
	if (StrCmp(actor, "") == 0)
		return UHSURV_FAIL;

	if (FindSurvivorByActor(actor) != UHSURV_FAIL)
		return UHSURV_FAIL;

	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_SURV)
			return UHSURV_FAIL;
		if (uh_survVanillaDefined[id] != 0)
			return UHSURV_FAIL;
		SurvWriteVanilla(id, actor, name, mugshot);
		return id;
	}

	if (id == -1)
	{
		if (uh_survCustomCount >= UH_MAX_CUSTOM_SURV)
			return UHSURV_FAIL;
		return SurvWriteCustom(actor, name, mugshot);
	}

	return UHSURV_FAIL;
}

// Do NOT add CLIENTSIDE: same rule as uh_DefineBoss_S — clients run this
// locally via ACS_NamedExecuteWithResult from their OPEN CLIENTSIDE twin.
Script "uh_DefineSurvivor_S" (void)

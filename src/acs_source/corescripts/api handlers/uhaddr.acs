function int DefineUnholyItemCore(int id, str actor, str name, str mugshot, str sound)
{
	if (StrCmp(actor, "") == 0)
		return UHITEM_FAIL;
	if (StrCmp(name, "") == 0)
		return UHITEM_FAIL;
	if (FindItemByActor(actor) != UHITEM_FAIL)
		return UHITEM_FAIL;

	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_ITEM)
			return UHITEM_FAIL;
		if (uh_itemVanillaDefined[id] != 0)
			return UHITEM_FAIL;
		ItemWriteVanilla(id, actor, name, mugshot, sound);
		return id;
	}

	if (id == -1)
	{
		if (uh_itemCustomCount >= UH_MAX_CUSTOM_ITEM)
			return UHITEM_FAIL;
		return ItemWriteCustom(actor, name, mugshot, sound);
	}

	return UHITEM_FAIL;
}

Script "uh_DefineUnholyItem_S" (void)
{
	SetResultValue(DefineUnholyItemCore(
		GetCVar("uh_di_id"),
		GetCVarString("uh_di_actor"),
		GetCVarString("uh_di_name"),
		GetCVarString("uh_di_mugshot"),
		GetCVarString("uh_di_sound")
	));
}

Script "uh_SetUnholyBox_S" (void)
{

#library "uhaddr"
#include "zcommon.acs"

#import "uhdt.acs"

function int UH_DefineBossCore(
	  int id,
	  str actor,
	  str name,
	  int rarity,
	  int basehp,
	  int addhp,
	  str exboss_baseactor,
	  str mugshot,
	  str musiclump,
	  str musiccredit,
	  str instruction,
	  str spawnmessagetype,
	  str spawnmessage) {
	if (StrCmp(actor, "") == 0)
		return UHBOSS_FAIL;

	if (FindBossByActor(actor) != UHBOSS_FAIL)
		return UHBOSS_FAIL;

	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_BOSS)
			return UHBOSS_FAIL;
		if (uh_bossVanillaDefined[id] != 0)
			return UHBOSS_FAIL;
		UH_BossWriteVanilla(id, actor, name, rarity, basehp, addhp,
			exboss_baseactor, mugshot, musiclump, musiccredit,
			instruction, spawnmessagetype, spawnmessage);
		return id;
	}

	if (id == -1)
	{
		if (uh_bossCustomCount >= UH_MAX_CUSTOM_BOSS)
			return UHBOSS_FAIL;
		return UH_BossWriteCustom(actor, name, rarity, basehp, addhp,
			exboss_baseactor, mugshot, musiclump, musiccredit,
			instruction, spawnmessagetype, spawnmessage);
	}

	// Explicit negatives other than AUTO are rejected in v1
	return UHBOSS_FAIL;
}

// Do NOT add CLIENTSIDE: listen-server hosts share one ACS VM with the
// client; a CLIENTSIDE twin would double-write UHDT on the host.
Script "uh_DefineBoss_S" (void)
{
	SetResultValue(UH_DefineBossCore(
		GetCVar("uh_db_id"),
		GetCVarString("uh_db_actor"),
		GetCVarString("uh_db_name"),
		GetCVar("uh_db_rarity"),
		GetCVar("uh_db_basehp"),
		GetCVar("uh_db_addhp"),
		GetCVarString("uh_db_exbase"),
		GetCVarString("uh_db_mugshot"),
		GetCVarString("uh_db_music"),
		GetCVarString("uh_db_musiccredit"),
		GetCVarString("uh_db_instruction"),
		GetCVarString("uh_db_spawnmsgtype"),
		GetCVarString("uh_db_spawnmsg")
	));
}

Script "uh_IsBossDefined_S" (int id)
{
	SetResultValue(IsBossDefined(id));
}

Script "uh_FindBossByActor_S" (void)
{
	int id = FindBossByActor(GetCVarString("uh_db_actor"));
	SetCVar("uh_db_id", id);
	SetResultValue(id);
}

Script "uh_GetBossActor_S" (int id)
{
	SetCVarString("uh_db_out_str", GetBossActor(id));
	SetResultValue(IsBossDefined(id));
}

Script "uh_GetBossName_S" (int id)
{
	SetCVarString("uh_db_out_str", GetBossName(id));
	SetResultValue(IsBossDefined(id));
}

Script "uh_GetBossHPBase_S" (int id)
{
	SetResultValue(GetBossHPBase(id));
}

Script "uh_GetBossHPAdd_S" (int id)
{
	SetResultValue(GetBossHPAdd(id));
}

Script "uh_GetBossBaseId_S" (int id)
{
	int baseId = GetBossBaseId(id);
	SetCVar("uh_db_id", baseId);
	SetResultValue(baseId);
}

Script "uh_GetBossExId_S" (int id)
{
	int exId = GetBossExId(id);
	SetCVar("uh_db_id", exId);
	SetResultValue(exId);
}

Script "uh_IsBossEx_S" (int id)
{
	SetResultValue(IsBossEx(id));
}

Script "uh_RandomBossFromPool_S" (int rarity)
{
	int pick = RandomBossFromPool(rarity);
	SetCVar("uh_db_id", pick);
	SetResultValue(pick);
}

Script "uh_GetPlayerBossId_S" (int playerNum)
{
	int id = GetPlayerBossId(playerNum);
	SetCVar("uh_db_id", id);
	SetResultValue(id);
}

Script "uh_GetBossMugshot_S" (int id)
{
	SetCVarString("uh_db_out_str", GetBossMugshot(id));
	SetResultValue(IsBossDefined(id));
}

function int DefineSurvivorCore(int id, str actor, str name, str mugshot)
{
	if (StrCmp(actor, "") == 0)
		return UHSURV_FAIL;

	if (FindSurvivorByActor(actor) != UHSURV_FAIL)
		return UHSURV_FAIL;

	if (id >= 0)
	{
		if (id >= UH_MAX_VANILLA_SURV)
			return UHSURV_FAIL;
		if (uh_survVanillaDefined[id] != 0)
			return UHSURV_FAIL;
		SurvWriteVanilla(id, actor, name, mugshot);
		return id;
	}

	if (id == -1)
	{
		if (uh_survCustomCount >= UH_MAX_CUSTOM_SURV)
			return UHSURV_FAIL;
		return SurvWriteCustom(actor, name, mugshot);
	}

	return UHSURV_FAIL;
}

// Do NOT add CLIENTSIDE: same rule as uh_DefineBoss_S — clients run this
// locally via ACS_NamedExecuteWithResult from their OPEN CLIENTSIDE twin.
Script "uh_DefineSurvivor_S" (void)
{
	SetResultValue(DefineSurvivorCore(
		GetCVar("uh_ds_id"),
		GetCVarString("uh_ds_actor"),
		GetCVarString("uh_ds_name"),
		GetCVarString("uh_ds_mugshot")
	));
}

Script "uh_IsSurvivorDefined_S" (int id)
{
	SetResultValue(IsSurvivorDefined(id));
}

Script "uh_FindSurvivorByActor_S" (void)
{
	int id = FindSurvivorByActor(GetCVarString("uh_ds_actor"));
	SetCVar("uh_ds_id", id);
	SetResultValue(id);
}

Script "uh_GetSurvivorActor_S" (int id)
{
	SetCVarString("uh_ds_out_str", GetSurvivorActor(id));
	SetResultValue(IsSurvivorDefined(id));
}

Script "uh_GetSurvivorName_S" (int id)
{
	SetCVarString("uh_ds_out_str", GetSurvivorName(id));
	SetResultValue(IsSurvivorDefined(id));
}

Script "uh_GetSurvivorMugshot_S" (int id)
{
	SetCVarString("uh_ds_out_str", GetSurvivorMugshot(id));
	SetResultValue(IsSurvivorDefined(id));
}

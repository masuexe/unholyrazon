	SetResultValue(SetUnholyBoxCore(
		boxid,
		GetCVarString("uh_di_opensound"),
		GetCVarString("uh_di_eyedropsound")
	));
}

Script "uh_AddUnholyItemDrop_S" (void)
{
	int boxid = FindItemByActor(GetCVarString("uh_di_boxactor"));
	int itemid = FindItemByActor(GetCVarString("uh_di_itemactor"));
	SetResultValue(AddUnholyItemDropCore(
		boxid,
		itemid,
		GetCVar("uh_di_weight"),
		GetCVar("uh_di_amt"),
		GetCVarString("uh_di_sound"),
		GetCVarString("uh_di_giveactor")
	));
}


script "uh_AddLMSEventDrop_S" (void)
{
	int eventid;
	eventid = FindLMSEventByStem(GetCVarString("uh_le_stem"));
	if (eventid == UHLMS_FAIL)
	{
		SetResultValue(UHLMS_FAIL);
		terminate;
	}
	SetResultValue(AddLMSEventDropCore(
		eventid,
		GetCVarString("uh_le_item"),
		GetCVar("uh_le_amt"),
		GetCVar("uh_le_rare")
	));
}


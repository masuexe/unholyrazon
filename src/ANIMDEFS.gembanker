// Independent animation targets keep the static portrait untouched.
// v7b: each color lasts a random 350-700 tics; v7a: exactly 4 tics.
texture GBF_SLOW allowdecals
  pic GBFACEA rand 350 700
  pic GBFACEB rand 350 700
  pic GBFACEC rand 350 700
  pic GBFACED rand 350 700
  pic GBFACEE rand 350 700
  pic GBFACEF rand 350 700
  pic GBFACEG rand 350 700

texture GBF_FAST allowdecals
  pic GBFACEA tics 4
  pic GBFACEB tics 4
  pic GBFACEC tics 4
  pic GBFACED tics 4
  pic GBFACEE tics 4
  pic GBFACEF tics 4
  pic GBFACEG tics 4

texture GBM_SLOW allowdecals
  pic GBMUGA rand 350 700
  pic GBMUGB rand 350 700
  pic GBMUGC rand 350 700
  pic GBMUGD rand 350 700
  pic GBMUGE rand 350 700
  pic GBMUGF rand 350 700
  pic GBMUGG rand 350 700

texture GBM_FAST allowdecals
  pic GBMUGA tics 4
  pic GBMUGB tics 4
  pic GBMUGC tics 4
  pic GBMUGD tics 4
  pic GBMUGE tics 4
  pic GBMUGF tics 4
  pic GBMUGG tics 4



OptionValue UH_EyeMainfire
{
0,"\cdA slap"//Plain
1,"\cdA competitively aggressive slap"//MLG
2,"\cdA ghoulish slap"//Ghost
3,"\cdAn immediate charging tackle"//Joust
4,"\cdA leaping tackle"//Sumo
5,"\cdA violent explosion"//Kamikaze
6,"\cdDistribute money\nSpread the wealth"//Rich
7,"\cdLobs a bomb\nExplodes immediately on contact with foe"//Bomber
8,"\cdFabricate coins\nDestroy a stock market"//Business
9,"\cdTosses a ring"//Quick

10,"\cdFires a projectile that explodes\nProjectile becomes stronger with charge"//Tank
11,"\cdBaton smack"//Eyelento
12,"\cdRapid fire stream of otherwordly energy"//Alien (Speciman Jr)
13,"\cdSummons a floor tornado\nLaunches foes upward and blocks shots"//Typhoon
14,"\cdThrows explosive Brick Mines\nAt full ammo, scatters 5 mines around"//Brick
15,"\cdDashes forward to latch onto foes\nDrains health while latched"//Mosquito

30,"\ciKills you"//Fox
31,"\cuABSOLUTELY NOTHING"//Furry
32,"\cdFires explosive dark energy orbs"//DarkPurpleClone

100,"\cdAn underpaid slap"//Plain Lackey
111,"\cdBaton smack with a different coat of pain"//Eyelento Lackey
}

OptionValue UH_EyeAltfire
{
0,"\cuLacks the intellect to have an altfire"//Plain
1,"\cdZooms in and allows mainfire to change\ninto a sniper shot"//MLG
2,"\cdTemporarily become harder to see"//Ghost
3,"\cuNone"//Joust
4,"\cuNone"//Sumo
5,"\cdFake out explosion"//Kamikaze
6,"\cuAlready invested enough"//Rich
7,"\cuNone"//Bomber
8,"\cuForgot to invest into an altfire"//Business
9,"\cdEmpowers mainfire temporarily"//Quick

10,"\cdHovers in the air"//Tank
11,"\cdTosses a grenade"//Eyelento
12,"\cdAssumes a flash causing different results"//Alien (Speciman Jr)
13,"\cuNone"//Typhoon
14,"\cuNone"//Brick
15,"\cuNone"//Mosquito

30,"\cuImmediately win\nBut that's too easy"//Fox
31,"\cuABSOLUTELY NOTHING"//Furry
32,"\cdFires a heavy recoil blast at 50 ammo"//DarkPurpleClone

100,"\cuUnderpaid, doesn't receive an altfire"//Plain Lackey
111,"\cuTosses a differently colored grenade"//Eyelento Lackey
}

OptionValue UH_EyeExtra
{
0,"\ctThe minion of all time\n\cuCan cause mayhem, doesn't pick sides"//Plain
1,"\cdHas falling into pit damage reduction"//MLG
2,"\cuStarts with invisibility in respective event"//Ghost
3,"\cuPlays like Juggernaut"//Joust
4,"\cuPlays like Sumowrestler"//Sumo
5,"\cdDoesn't recover health used for mainfire"//Kamikaze
6,"\cdCan cause a rich overtaking"//Rich
7,"\cdCan climb larger stairs"//Bomber
8,"\cdRelies on coins to act\nCoins result in mayhem on use\nunpredictable"//Business
9,"\cuWho are you running from?"//Quick

10,"\cdEmpowered mainfire can fling"//Tank
11,"\cdResistant to Fox Demoneye"//Eyelento
12,"\cuAssumes an extra tip"//Alien (Speciman Jr)
13,"\cdDisruptive wind knockback"//Typhoon
14,"\cdImmune to Brick Mines, Pit Spikes, and tacks"//Brick
15,"\cdTiny hitbox with permanent flight\nUses pit stamina, heals on drain"//Mosquito

30,"\cdWeak to cash attacks and Eyelento"//Fox
31,"\cuABSOLUTELY NOTHING"//Furry
32,"\cdEvent clone variant\nDrops a potion on death"//DarkPurpleClone

100,"\ctDevileye's minions\n\cdCannot hurt Devileye directly"//Plain Lackey
111,"\cdResistant to Fox Demoneye\nNo different from regular Eyelentos"//Eyelento Lackey
}

// ============================================================================
// CVARINFO.user - user (per-player) settings.
//
// "user" cvars are synced into player userinfo by Zandronum, so each player
// controls their own copy; scripts read them with GetUserCVar().  These are the
// only cvars an ordinary player may change, and they are safe to expose in the
// Unholy user options menu.
// ============================================================================

user bool uh_cl_GemBankerHud = true;
user bool uh_cl_DeathTips = true;
user bool uh_cl_automap_items = true;
user int uh_cl_MusicDisplay = 1;
user int uh_cl_MusicMode = 0;  // 0 = Unholy boss/LMS music, 1 = map stage/boss music
user bool uh_cl_HideScreenScare = false;
user bool uh_cl_ShowTipsOnScreen = true;
//UH_Log threshold (0=OFF, 1=ERROR, 2=+WARN, 3=+INFO, 4=+DEBUG). Local to each
//player: it is a user cvar, so Zandronum syncs it into userinfo and UH_Log
//reads it with GetUserCVar() for the acting player.
//Default 3 includes INFO/WARN/ERROR; set 4 to include DEBUG as well.
user int uh_cl_LogLevel = 3;

// Multi-boss HUD vertical offset adjustment in pixels (0=default, negative moves up, positive moves down)
user int uh_cl_BossHudY = 0;

// Multi-boss HUD horizontal offset adjustment in pixels (0=default, positive moves right)
user int uh_cl_BossHudX = 0;

// Multi-boss HUD text vertical offset adjustment relative to mugshot (0=default, negative moves up, positive moves down)
user int uh_cl_BossTextY = 0;

// Boss enraged warning banner and alarm sound (true=Show warning, false=Disable)
user bool uh_cl_BossRageWarning = true;

// --- Unholy native teammate bar ---------------------------------------------
// Shown in ordinary LMS when UIX's Better Team Display is not taking over.
// UIX_SV_TEAMINFO + UIX_CL_Enable + UIX_CL_TEAMINFO together suppress it; those
// cvars read as 0 when UIX is not loaded, so UIX is not a dependency.
user bool uh_cl_teaminfo = true;          // Master switch
user bool uh_cl_teaminfo_names = true;    // Player names
user bool uh_cl_teaminfo_health = true;   // health / armor line
user int uh_cl_teaminfo_hpstyle = 0;      // Health style: 0=HP/MaxHP (+Armor), 1=HP Only, 2=Percentage, 3=HP/Armor
user bool uh_cl_teaminfo_weapon = true;   // weapon display tag + ammo line
user int uh_cl_teaminfo_subline = 0;      // Subline style: 0=Auto (Weapon or Class), 1=Class only, 2=Weapon only, 3=None
user bool uh_cl_teaminfo_lives = true;    // Show extra lives [xN]
user bool uh_cl_teaminfo_dead = true;     // Keep dead teammates as dead rows
user int uh_cl_teaminfo_scale = 100;      // Whole-bar content scale, percent (50-200)
user int uh_cl_teaminfo_x = 0;            // Inward margin from both screen edges
user int uh_cl_teaminfo_y = 0;            // Vertical offset below the chat area
user int uh_cl_teaminfo_alpha = 100;      // Text alpha, percent (0-100)

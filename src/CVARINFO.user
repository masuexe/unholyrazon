// ============================================================================
// CVARINFO.user - user (per-player) settings.
//
// "user" cvars are synced into player userinfo by Zandronum, so each player
// controls their own copy; scripts read them with GetUserCVar().  These are the
// only cvars an ordinary player may change, and they are safe to expose in the
// Unholy user options menu.
// ============================================================================

user bool uh_cl_GemBankerHud = true;
user bool uh_cl_DeathTips = true;
user int uh_cl_MusicDisplay = 1;
user bool uh_cl_HideScreenScare = false;
user bool uh_cl_ShowTipsOnScreen = true;
//UH_Log threshold (0=OFF, 1=ERROR, 2=+WARN, 3=+INFO, 4=+DEBUG). Local to each
//player: it is a user cvar, so Zandronum syncs it into userinfo and UH_Log
//reads it with GetUserCVar() for the acting player.
//Default 3 keeps the pre-existing behaviour: INFO/WARN/ERROR always printed,
//DEBUG still gated server-side by uh_sv_BossDebugText.
user int uh_cl_LogLevel = 3;

// Multi-boss HUD border (0=Disabled/None, 1=Enabled/Compact 36x36)
user int uh_cl_BossBorder = 1;

// Multi-boss HUD vertical offset adjustment in pixels (0=default, negative moves up, positive moves down)
user int uh_cl_BossHudY = 0;

// Multi-boss HUD horizontal offset adjustment in pixels (0=default, positive moves right)
user int uh_cl_BossHudX = 0;

// Multi-boss HUD text vertical offset adjustment relative to mugshot (0=default, negative moves up, positive moves down)
user int uh_cl_BossTextY = 0;

// Boss enraged warning banner and alarm sound (true=Show warning, false=Disable)
user bool uh_cl_BossRageWarning = true;

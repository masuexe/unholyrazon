actor DLC_CoinItem : BasicDroppedItem
{
Tag "$TAG_T_BOX03"
inventory.amount 1
inventory.maxamount 9999
inventory.pickupmessage "\ckLovely money!"
//+Inventory.Quiet
inventory.icon "TANKOW03"
+INVBAR
inventory.pickupsound "misc/coingetX"////
States
{
Spawn:
//I_TA D 6
I_TD M 6
loop
Use:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("PlayerPropertyCantUseItems",1,"No")
goto UseX
No:
TNT1 A 0
fail
UseX:
TNT1 A 0 A_PlaySoundEx("misc/coinget","SoundSlot5")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",999,"UseX999")
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",25,"UseX2")
TNT1 A 0 A_TakeInventory("DLC_CoinItem",25)
TNT1 A 0 A_PlaySoundEx("items/SoUnlucky","SoundSlot5")
//TNT1 A 0 A_GiveInventory("???",1)
fail
UseX999:
TNT1 A 0 A_PlaySoundEx("misc/WellDoneMan","SoundSlot5")
TNT1 A 0 A_TakeInventory("DLC_CoinItem",999)
TNT1 A 0 A_GiveInventory("AirStrikeItem",1)
fail
UseX2:
TNT1 A 0 A_TakeInventory("DLC_CoinItem",25)
goto UseX2ReRoll
UseX2ReRoll:
TNT1 A 0 A_Jump(1,"Rare1")
TNT1 A 0 A_PlaySoundEx("items/GoldenWaspShot","SoundSlot6")
TNT1 A 0 A_Jump(2,"Rare2")
TNT1 A 0 A_Jump(4,"Rare4")
TNT1 A 0 A_Jump(8,"Rare8")
TNT1 A 0 A_Jump(16,"Rare16")
TNT1 A 0 A_Jump(32,"Rare32")
TNT1 A 0 A_Jump(56,"Rare56")
TNT1 A 0 A_Jump(128,"Rare128")
TNT1 A 0 A_Jump(255,"Rare255")
TNT1 A 0 A_Jump(256,"Rare256")
fail


Rare256:
TNT1 A 0 A_Jump(256,1,2)
fail
TNT1 A 0 A_GiveInventory("DLC_CoinItem",777)
fail
TNT1 A 0 A_GiveInventory("DLC_CoinItem",777)
fail

Rare1:
TNT1 A 0 A_Jump(256,1,2)
fail
TNT1 A 0 A_GiveInventory("TankOfWondersItem",1)
fail
// TNT1 A 0 A_JumpIfInventory("BuddhaFlagItem",1,2)
// TNT1 A 0 A_GiveInventory("AutoUnholyInsuranceItem",1)
// fail
// TNT1 A 0 A_PlaySoundEx("misc/coinget","SoundSlot6")
// TNT1 A 0 A_GiveInventory("DLC_CoinItem",300)
// fail

// Rare2:
// TNT1 A 0 A_Jump(256,1,2,3)
// fail
// TNT1 A 0 A_GiveInventory("AutoZtarItem2",1)
// fail
// TNT1 A 0 A_GiveInventory("AutoUnholyBookItem",1)

actor DLC_CoinItem : BasicDroppedItem
{
Tag "$TAG_T_BOX03"
inventory.amount 1
inventory.maxamount 9999
inventory.pickupmessage "\ckLovely money!"
//+Inventory.Quiet
inventory.icon "TANKOW03"
+INVBAR
inventory.pickupsound "misc/coingetX"////
States
{
Spawn:
//I_TA D 6
I_TD M 6
loop
Use:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyCantUseItems",1,"No")
goto UseX
No:
TNT1 A 0
fail
UseX:
TNT1 A 0 A_PlaySoundEx("misc/coinget","SoundSlot5")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",9999,"UseX10k")
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",6666,"UseX6667")
// TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",6666,"UseX6666")
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",1000,"UseX1000")
TNT1 A 0 A_JumpIfInventory("DLC_CoinItem",25,"UseX2")
TNT1 A 0 A_TakeInventory("DLC_CoinItem",25)
TNT1 A 0 A_PlaySoundEx("items/SoUnlucky","SoundSlot5")
//TNT1 A 0 A_GiveInventory("???",1)
fail
UseX10k:
TNT1 A 0 A_PlaySoundEx("S_Spin/Surprise", "SoundSlot5")
TNT1 A 0 A_TakeInventory("DLC_CoinItem")
TNT1 A 0 A_GiveInventory("I_WinItem", 1)
fail
UseX6667:
TNT1 A 0 A_PlaySoundEx("misc/WellDoneMan", "SoundSlot5")
TNT1 A 0 A_TakeInventory("DLC_CoinItem", 6666)
TNT1 A 0 A_GiveInventory("WishingStarXItem", 1)
fail
// UseX6666:
// TNT1 A 0 A_PlaySoundEx("GNT/SuperShot", "SoundSlot5")
// TNT1 A 0 A_TakeInventory("DLC_CoinItem", 6666)
// TNT1 A 0 A_GiveInventory("SatanSealItem", 1)
// fail
UseX1000:
TNT1 A 0 A_PlaySoundEx("misc/WellDoneMan", "SoundSlot5")
TNT1 A 0 A_TakeInventory("DLC_CoinItem", 1000)
TNT1 A 0 A_GiveInventory("AirStrikeItem", 1)
fail
UseX2:
TNT1 A 0 A_TakeInventory("DLC_CoinItem",25)
goto UseX2ReRoll
UseX2ReRoll:
TNT1 A 0 ACS_NamedExecuteWithResult("rz_DlcCoinRoll", 0)
fail
  }
}

actor AutoDLC_CoinItem : DLC_CoinItem{Inventory.PickupSound ""Inventory.MaxAmount 0 +ALWAYSPICKUP States{Pickup:goto UseX}}
actor AutoDLC_CoinItemSilent : AutoDLC_CoinItem{States{Pickup:goto UseX_Silent}}
actor DLC_CoinItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TD M 0
            goto Spawn2
    }
}

actor DLCGoldCoin : BasicDroppedItem
{
Translation "192:192=160:160","198:198=161:161","199:199=162:162"
inventory.amount 1
inventory.pickupmessage ""
+Inventory.Quiet
+INVENTORY.TOSSED
+INVBAR
+THRUACTORS
+NOBLOCKMONST
reactiontime 8
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("misc/coinget","Item")
TNT1 A 0 A_GiveInventory("DLC_CoinItem",1)
stop
Spawn:
I_TD FGHIFGHI 2
I_TD F 0 A_ChangeFlag("THRUACTORS",0)
goto Spawn2
Spawn2:
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD F 0 A_CountDown
loop
Death:
TNT1 A 1
stop
}
}


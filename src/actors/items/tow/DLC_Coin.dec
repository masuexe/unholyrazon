actor DLC_CoinItem : BasicDroppedItem {
  Tag "$TAG_T_BOX03"
  Inventory.MaxAmount 9999
  inventory.pickupmessage "\ckLovely money!"
  // +Inventory.Quiet
  Inventory.Icon "TANKOW03"
  +INVBAR
  inventory.pickupsound "misc/coingetX"  /// /
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    // I_TA D 6
    I_TD M 6
    loop
   Use:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyCantUseItems", 1, "No")
    goto UseX
   No:
    TNT1 A 0
    fail
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "SoundSlot5")
   UseX_Silent:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_DlcCoinUse")
    fail
  }
}

actor AutoDLC_CoinItem : DLC_CoinItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDLC_CoinItemSilent : AutoDLC_CoinItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DLC_CoinItemFX : UnholyItemFX {
  States {
   Spawn:
    I_TD M 0
    goto Spawn2
  }
}

actor DLCGoldCoin : BasicDroppedItem {
  Translation "192:192=160:160", "198:198=161:161", "199:199=162:162"
  inventory.pickupmessage ""
  +Inventory.Quiet
  +INVENTORY.TOSSED
  +INVBAR
  +THRUACTORS
  +NOBLOCKMONST
  ReactionTime 8
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Item")
    TNT1 A 0 A_GiveInventory("DLC_CoinItem", 1 + CallACS("uh_CheckForLuckyPenny"))
    stop
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_TD FGHIFGHI 2
    I_TD F 0 A_ChangeFlag("THRUACTORS", 0)
    goto Spawn2
   Spawn2:
    I_TD FGHIFGHIFGHIFGHIFGHI 2
    I_TD FGHIFGHIFGHIFGHIFGHI 2
    I_TD FGHIFGHIFGHIFGHIFGHI 2
    I_TD FGHIFGHIFGHIFGHIFGHI 2
    I_TD FGHIFGHIFGHIFGHIFGHI 2
    I_TD F 0 A_CountDown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor DLCRedCoin : DLCGoldCoin {
  Translation "192:192=174:174", "198:198=42:42", "199:199=43:43"
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Item")
    TNT1 A 0 A_GiveInventory("DLC_CoinItem", 2 * (1 + CallACS("uh_CheckForLuckyPenny")))
    stop
  }
}

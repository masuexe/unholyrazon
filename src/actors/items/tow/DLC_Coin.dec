actor AutoDLC_CoinItem : DLC_CoinItem{Inventory.PickupSound ""Inventory.MaxAmount 0 +ALWAYSPICKUP States{Pickup:goto UseX}}
actor AutoDLC_CoinItemSilent : AutoDLC_CoinItem{States{Pickup:goto UseX_Silent}}
actor DLC_CoinItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TD M 0
            goto Spawn2
    }
}

actor DLCGoldCoin : BasicDroppedItem
{
Translation "192:192=160:160","198:198=161:161","199:199=162:162"
inventory.amount 1
inventory.pickupmessage ""
+Inventory.Quiet
+INVENTORY.TOSSED
+INVBAR
+THRUACTORS
+NOBLOCKMONST
reactiontime 8
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("misc/coinget","Item")
TNT1 A 0 A_GiveInventory("DLC_CoinItem",1)
stop
Spawn:
I_TD FGHIFGHI 2
I_TD F 0 A_ChangeFlag("THRUACTORS",0)
goto Spawn2
Spawn2:
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD FGHIFGHIFGHIFGHIFGHI 2
I_TD F 0 A_CountDown
loop
Death:
TNT1 A 1
stop
}
}

actor DLCRedCoin : DLCGoldCoin
{
Translation "192:192=174:174","198:198=42:42","199:199=43:43"
States
{

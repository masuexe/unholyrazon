// DruExMachina
actor CarpetBomberItem : UnholyItem {
  Tag "$TAG_T_BOX08"
  inventory.pickupmessage "Looks like it is time for some aerial warfare!"
  Inventory.Icon "TANKOW08"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_TA I 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("S_Spin/Button", "Item")
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "UseX2")
    TNT1 A 0 A_FireCustomMissile("CarpetBombSpawner", 0, 0, 0, 0)
    goto End
   UseX2:
    TNT1 A 0 A_FireCustomMissile("CarpetBombSpawnerB", 0, 0, 0, 0)
    goto End
  }
}

actor AutoCarpetBomberItem : CarpetBomberItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoCarpetBomberItemSilent : AutoCarpetBomberItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor CarpetBomberItemFX : UnholyItemFX {
  States {
   Spawn:
    I_TA I 0
    goto Spawn2
  }
}

actor CarpetBombSpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlane", 0, 60, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlane", 0, 20, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlane", 0, -20, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlane", 0, -60, 0, 20)
    TNT1 A 2
    stop
  }
}
actor CarpetBombSpawnerB : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlaneB", 0, 60, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlaneB", 0, 20, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlaneB", 0, -20, 0, 20)
    TNT1 A 0 A_SpawnItemEx("CarpetBombPlaneB", 0, -60, 0, 20)
    TNT1 A 2
    stop
  }
}

actor CarpetBombPlane : BasicNoClassTranslationProjectile {
  DamageType "CarpetBomb"
  Obituary "%o touched %k's invisible carpet bombing plane."
  +CEILINGHUGGER
  +DONTBLAST
  +THRUACTORS
  +THRUGHOST
  +HEXENBOUNCE
  BounceFactor 1.0
  WallBounceFactor 1.0
  BounceCount 6
  ReactionTime 35
  Damage (0)
  Radius 2
  Height 16
  Speed 20
  Scale 2.5
  States {
   Spawn:
    TNT1 A 1 A_CountDown
    TNT1 A 0 A_Explode(100, 16, 0, 0, 17)
    TNT1 A 0 A_SetAngle(angle + random(-15, 15))
    TNT1 A 2 A_ChangeVelocity(20, 0, 0, 3)
    TNT1 A 3 A_SpawnItemEx("CarpetBomb", 0, 0, 0)
    loop
   Death:
    TNT1 A 1
    TNT1 A 0
    stop
  }
}

actor CarpetBombPlaneB : CarpetBombPlane {
  DamageType "CarpetBombB"
  States {
   Spawn:
    TNT1 A 1 A_CountDown
    TNT1 A 0 A_Explode(100, 16, 0, 0, 17)
    TNT1 A 0 A_SetAngle(angle + random(-15, 15))
    TNT1 A 2 A_ChangeVelocity(20, 0, 0, 3)
    TNT1 A 3 A_SpawnItemEx("CarpetBombB", 0, 0, 0)
    loop
  }
}

actor CarpetBomb : BasicNoClassTranslationProjectile {
  Translation "192:192=90:90", "198:198=93:93"  // given due to the basic boom FX below
  DamageType "CarpetBomb"
  Obituary "%o wasn't paying attention when %k's Carpet Bombing began."
  -NOGRAVITY
  +THRUGHOST
  +DONTREFLECT
  Gravity 2.0
  Damage (50)
  Radius 10
  Height 16
  Speed 0
  Scale 2.5
  States {
   Spawn:
    I_TP I 0
    I_TP I 1 ThrustThingZ(0, 8, 1, 1)
    I_TP I 1
    wait
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_Explode(275, 196, 0, 0, 32)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX_Tic2_Dull", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor CarpetBombB : CarpetBomb {damagetype "CarpetBombB"}

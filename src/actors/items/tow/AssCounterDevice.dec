actor AssCounterDeviceItem : UnholyItem {
  Tag "$TAG_RZ_TBOX01"
  inventory.pickupmessage "Concern your ass? It can help you."
  Inventory.Icon "RZTI_01"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_RT B 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("weapon/SumoLeap", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("AssCounter")
    goto End
  }
}

actor AutoAssCounterDeviceItem : AssCounterDeviceItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoAssCounterDeviceItemSilent : AutoAssCounterDeviceItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor AssCounterDeviceItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RT B 0
    goto Spawn2
  }
}

actor AssCounter : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, WARPF_COPYINTERPOLATION | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_SpawnItemEx("AssCounterDevice", -32, 0, 20, velx, vely, velz, 0, SXF_TRANSFERPOINTERS)
    loop
  }
}

actor AssCounterDevice {
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  +GHOST
  +SHOOTABLE
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +NODAMAGE
  +THRUSPECIES
  +INVISIBLE
  Species "AssCounter"
  RenderStyle "None"
  bloodtype ""
  damagefactor "Telefrag", 0.0
  painchance 256
  Health 999999
  Damage 0
  Height 42
  Radius 12
  Speed 0
  args 100
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 1 A_Warp(2, -32, 0, 20, 0, WARPF_COPYINTERPOLATION | WARPF_NOCHECKPOSITION)
    stop
   Pain:
    TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
   PainL:
    TNT1 A 1 A_Warp(2, -32, 0, 20, 0, WARPF_COPYINTERPOLATION | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_GiveInventory("AssCounter_P")
    TNT1 A 0 A_SetArg(0, args[0] - 1)
    TNT1 A 0 A_JumpIf(args[0] == 0, "Death")
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor AssCounter_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/devilfire", "Body")
    TNT1 A 0 A_SpawnItemEx("AssCounterBullet", 0, 0, 24, -40, 0, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("AssCounterBullet", 0, 0, 24, -40, 0, 0, -15)
    TNT1 A 0 A_SpawnItemEx("AssCounterBullet", 0, 0, 24, -40, 0, 0, 15)
    stop
  }
}

actor AssCounterBullet : BasicNoClassTranslationFastProjectile {
  DamageType "AssCounter"
  Species "AssCounter"
  Obituary "%k's Ass Counter Device found %o wanted to steal their ass!"
  // Obituary "%o failed to hunt %k's ass."
  Damage (30)
  Radius 6
  +THRUSPECIES
  Height 7
  Speed 90
  // reactiontime 35
  States {
   Spawn:
    TNT1 A 0
   Fly:
    BASB A 1
    wait
   Death:
    TNT1 A 0
    stop
  }
}

Actor RandomPonyItem : UnholyItem
{//This is kept due to being neato
Tag "$TAG_T_BOX04"
inventory.pickupmessage "\caLies. Equestria DOES exist if you BELIEVE."
inventory.icon "TANKOW04"
states
{
Spawn:
I_TA E 5
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("misc/pinkiewee","SoundSlot6")
UseX_Silent:
TNT1 A 0 A_FireCustomMissile("PinkieShot",0,0,0,5)
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_FireCustomMissile("PinkieShotB",0,0,0,5)
goto End
}
}

actor AutoRandomPonyItem : RandomPonyItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoRandomPonyItemSilent : AutoRandomPonyItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor RandomPonyItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TA E 0
            goto Spawn2
    }
}

Actor PinkieShot : BasicNoClassTranslationProjectile
{
damagetype "RandomPony"
Obituary "%o got pied by %k's \caPinkie Pie\c-."
+THRUGHOST
+SKYEXPLODE
+EXPLODEONWATER
damage (450)
Radius 15
Height 15
speed 36
scale 3.0
states
{
Spawn:
I_TP E 4
loop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("misc/partyball","SoundSlot5")
TNT1 A 0 A_PlaySoundEx("wep_L/mm1/hyperbombexplode","Weapon")
TNT1 AA 0 A_SpawnItemEx("ConfettiDeathSpawner",0,0,7)
TNT1 A 1 A_Explode(2650,333,1,0,111)
BOMB BCDEFGHIJKLMN 1
stop
}
}

Actor PinkieShotB : PinkieShot {damagetype "RandomPonyB"}

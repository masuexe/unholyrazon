Actor DickHatItem : UnholyItem {
  Tag "$TAG_RZ_TBOX02"
  inventory.amount 1
  inventory.pickupmessage "\cgYou are worthy of the Dick-Hat!"
  inventory.icon "RZTI_02"
  States {
   Spawn:
    I_RT C 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc_L/itemthrow", "Item")
   UseX_Silent:
    //TNT1 A 0 A_JumpIfInventory("PowerRage_ST",1,"UseXR")
    TNT1 A 0 A_SpawnItemEx("DickHatItemX", cos(-pitch)*2, 0, 32+(sin(-pitch)*2), cos(-pitch)*20, 0, sin(-pitch)*20, 0, 32, 0)
    TNT1 A 0 //A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("DickHatItemX", cos(-pitch)*2, 0, 32+(sin(-pitch)*2), cos(-pitch)*20, 0, sin(-pitch)*20, 15, 32, 0)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX", cos(-pitch)*2, 0, 32+(sin(-pitch)*2), cos(-pitch)*20, 0, sin(-pitch)*20, -15, 32, 0)
    goto End
    //UseXR:
    //TNT1 A 0 A_SpawnItemEx("DickHatItemXR",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*20,0,sin(-pitch)*20,0,32,0)
    //TNT1 A 0
    //goto End
  }
}

actor AutoDickHatItem : DickHatItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDickHatItemSilent : AutoDickHatItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DickHatItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RT C 0
    goto Spawn2
  }
}


Actor DickHatItemX : BasicDroppedItem {
  Translation "192:192=116:116", "198:198=122:122", "195:195=95:95"
  inventory.pickupmessage "\cgPicked up a Dick-Hat."
  inventory.PickupSound "GNT/Treasure"//GNT/Treasure
  -SPECIAL
  +THRUACTORS
  +NOBLOCKMONST
  Speed 20
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    I2TC H 0 //A_SetAngle(random(0,11)*30)
    I2TC H 0 ThrustThingZ(0, 12, 0, 1)
    I2TC H 0 A_GiveInventory("VivifyDelay10", 1)
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn2")
    I2TC H 0 A_ChangeFlag("THRUACTORS", 0)
    I2TC H 0 A_ChangeFlag("SPECIAL", 1)
    goto Spawn1
   Spawn1:
    I2TC H 1 A_SetAngle(angle+30)
    I2TC H 0 A_JumpIf(momx==0||momz==0, "Spawn3")
    loop
   Spawn2:
    I2TC H 1
    I2TC H 0 A_JumpIfInventory("VivifyDelay10", 1, "Spawn2")
    goto Spawn3
   Spawn3:
    I2TC H 0 A_ChangeFlag("THRUACTORS", 0)
    I2TC H 0 A_ChangeFlag("SPECIAL", 1)
    I2TC H 2
    I2TC H 0 A_GiveInventory("DickHatItemX_P", 1)
    stop
   Pickup:
    I2TC H 0 //A_JumpIfInventory("DickHatItem",99,"No")
    I2TC H 0 A_GiveInventory("DickHatItem", 1)
    stop
   No:
    I2TC H 0
    fail
  }
}


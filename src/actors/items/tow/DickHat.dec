Actor DickHatItemTestHelper : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_TG", 0)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_MI", 40)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BW", 80)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BH2", 120)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_TA", 160)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BY", 200)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_ME", 240)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BB", 280)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BR", 320)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_MA", 360)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_MD", 400)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX_BQ", 440)
    TNT1 A 0 A_SpawnItemEx("DickHatItemX0", 480)
    TNT1 A 1
    stop

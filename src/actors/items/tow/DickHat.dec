actor DickHatItemX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_DickHatRoll")
    stop
  }
}

actor DickHatItemX_FX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    //X_1G EFGHINMLKJ 2
    X_1G EKGMINHLFJ 2
    stop
  }
}

Actor DickHatItemX0 : DickHatItemX {
  Translation "192:192=4:4", "198:198=176:176", "195:195=95:95"
  States {
   Spawn:
    I2TC H 0
    goto Spawn2
   Spawn2:
    I2TC H 0
    goto Spawn3
   Pickup:
    I2TC H 0 A_GiveInventory("DickHatItem", 1)
    stop
  }
}

Actor DickHatItemX_Generic : DickHatItemX0 {
  States {
   Spawn:
    I2TC H 0
    I2TC H 0 ACS_NamedExecuteWithResult("uh_DickHatGenericSpawnFX")
    goto Spawn2
   Pickup:
    I2TC H 0 ACS_NamedExecuteWithResult("uh_DickHatGenericPickup")
    stop
  }
}


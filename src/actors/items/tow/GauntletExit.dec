actor GauntletExitItem : UnholyItem
{//Gauntlet II
    Tag "$TAG_T_BOX10"
    inventory.pickupmessage "No Dummy Exits here!"
    inventory.icon "TANKOW10"
    States {
     Spawn:
      I_TA K 6
      loop
     UseX:
      TNT1 A 0
      TNT1 A 0 A_PlaySoundEx("GNT/ExitUse", "Item")
     UseX_Silent:
      TNT1 A 0 A_GiveInventory("GauntletExitStart_P")
      goto End
    }
}

actor AutoGauntletExitItem : GauntletExitItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
     Pickup:
      goto UseX
    }
}
actor AutoGauntletExitItemSilent : AutoGauntletExitItem {
    States {
     Pickup:
      goto UseX_Silent
    }
}
actor GauntletExitItemFX : UnholyItemFX {
    States {
     Spawn:
      I_TA K 0
      goto Spawn2
    }
}

actor GauntletExitSound : BasicSoundFollow {
    PainSound "GNT/ExitUse"
    ReactionTime 40
}

actor GauntletExitStart_P : CustomInventory {
    States {
     Pickup:
      TNT1 A 0 A_JumpIf(z-floorz>0, "PickupAir")
      TNT1 A 0 A_SpawnItemEx("GauntletExit", 0, 0, 16)
      goto P_Teleport
     PickupAir:
      TNT1 A 0 A_SpawnItemEx("GauntletExitFloat", 0, 0, 8)
      goto P_Teleport
     P_Teleport:
      TNT1 A 0 A_GiveInventory("PowerGauntletExitSpeed")
      TNT1 A 0 A_GiveInventory("NoTeleportFX_Flag")
      TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P", 1)
      stop
    }
}

actor PowerGauntletExitSpeed : PowerSpeed {
    Powerup.Duration 6
    //Speed 1.5
}

actor GauntletExit : BasicDroppedItem {
    //inventory.amount 1
    inventory.maxamount 0
    inventory.pickupmessage "You found the exit!"
    inventory.icon "G_EXIT_I"
    Inventory.PickupSound "GNT/ExitUse"
    //+NOCLIP

    -SPECIAL
    //+THRUACTORS
    //+NOBLOCKMONST

    +STEPMISSILE
    MaxStepHeight 32
    Height 32
    speed 0
    states {
     Spawn:
      I_TP K 0
      I_TP K 1 A_Recoil(-0.0001)
      //I_TP K 0 A_ChangeFlag("NOCLIP",0)
      I_TP K 1 //A_ChangeVelocity(momx,momy,0,3)//A_Stop


      //I_TP K 0 A_JumpIf(Momz!=0,"Spawn2")
      //goto Spawn3
      //Spawn2:
      //I_TP K 1 ThrustThing(angle*256/360,1,1,0)
      //I_TP K 0 A_JumpIf(Momz!=0,1)
      //goto Spawn3
      //I_TP K 1 ThrustThing(angle*256/360,-1,1,0)
      //I_TP K 0 A_JumpIf(Momz!=0,"Spawn2")
      //goto Spawn3
     Spawn3:
      I_TP K 0
      I_TP K 1
     SpawnWait:
      I_TP K 1
      I_TP K 1 A_ChangeFlag("SPECIAL", 1)
      I_TP K 21000
      I_TP KKKKKKKKK 4 A_Fadeout
      stop
     Pickup:
      TNT1 A 0 A_JumpIfInventory("PowerGauntletExitSpeed", 1, "No")
      TNT1 A 0 A_GiveInventory("PowerGauntletExitSpeed")
      TNT1 A 0 A_SpawnItemEx("GauntletExitSnd_H", 0, 0, 28)
      TNT1 A 0 A_PlaySoundEx("GNT/ExitUse", "SoundSlot6")
      fail
     No:
      TNT1 A 0
      fail
    }
}

actor GauntletExitFloat : GauntletExit {
    +NOGRAVITY
    States {
     Spawn:
      I_TP K 0
      I_TP K 3
      goto SpawnWait
    }
}

actor GauntletExitSnd_H : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 A_GiveToTarget("NoTeleportFX_Flag", 1)
      TNT1 A 0 A_GiveToTarget("UH_ArtiTeleport_P")
      TNT1 A 0 A_PlaySoundEx("GNT/ExitUse", "Voice")
      TNT1 A 10
      stop
    }
}

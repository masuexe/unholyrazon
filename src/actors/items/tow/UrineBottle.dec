actor UrineBottleItem : UnholyItem {
  Tag "$TAG_RZ_TBOX03"
  inventory.amount 1
  inventory.pickupmessage "Don't worry. It's just lemonade."
  Inventory.icon "RZTI_03"
  States {
   Spawn:
    I_RT D 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/UnholyWater1", "Item")
   UseX_Silent:
    // TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
    TNT1 A 0 A_FireCustomMissile("UrineBottleShot", 0, 0, 0, 0)
    goto End
   UseX2:
    TNT1 A 0 A_FireCustomMissile("UrineBottleShotB", 0, 0, 0, 0)
    goto End
  }
}

actor AutoUrineBottleItem : UrineBottleItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoUrineBottleItemSilent : AutoUrineBottleItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor UrineBottleItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RT D 0
    goto Spawn2
  }
}

actor UrineBottleShot : BasicNoClassTranslationProjectile {
  Translation "192:192=162:162", "198:198=163:163", "0:0=139:139"
  Damagetype "UrineBottle"
  Obituary "%o could not face %k's Urine Bottle."
  -DONTSPLASH
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  +THRUGHOST
  Damage (50)
  Height 9
  Radius 9
  speed 45
  scale 2.5
  States {
   Spawn:
    X_8H B 0
    X_8H B 0 ThrustThingZ(0, 8, 0, 1)
    X_8H BCDC 1
    goto Spawn+2
   Death:
    TNT1 A 0 A_Explode(150, 128, 1, 0, 12)
    TNT1 A 0 A_PlaySoundEx("item/UnholyWater2", "Body")
    TNT1 A 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")

    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 22.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -22.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 67.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -67.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 112.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -112.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 157.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -157.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 0)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 90)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -90)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 180)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 45)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -45)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, 135)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBit", 96, 0, 0, 32, 0, 4, -135)

    X_8B ABCDEF 1
    stop
  }
}

actor UrineBottleShotBit : UrineBottleShot {
  speed 12
  Height 4
  Radius 4
  scale 1.0
  States {
   Spawn:
    X_8H B 0
    X_8H BCDC 1
    loop
   Death:
    TNT1 A 0 A_Explode(20, 5, 1, 0, 0)
    X_8H KLMN 1
    stop
  }
}


actor UrineBottleShotB : UrineBottleShot {
  Damagetype "UrineBottleB"
  States {
   Death:
    TNT1 A 0 A_Explode(150, 128, 0, 0, 12)
    TNT1 A 0 A_PlaySoundEx("item/UrineBottle2", "Body")
    TNT1 A 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 22.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -22.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 67.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -67.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 112.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -112.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 157.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -157.5)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 0)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 90)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -90)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 180)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 45)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -45)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, 135)
    TNT1 A 0 A_SpawnItemEx("UrineBottleShotBitB", 96, 0, 0, 32, 0, 4, -135)
    X_8B ABCDEF 1
    stop
  }
}

actor UrineBottleShotBitB : UrineBottleShotBit {Damagetype "UrineBottleB"}

actor UrineBottleFlag : UOnce {}

actor UrineDebuff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UrineBottleFlag", 1, "No")
    TNT1 A 0 A_GiveInventory("GuardDownFlag")
    TNT1 A 0 A_GiveInventory("UrineBottleDamage")
    TNT1 A 0 A_SpawnItemEx("UrineDebuff_H")
    TNT1 A 0 A_SpawnItemEx("TheDentistDebuff_Snd")
    TNT1 A 0 A_GiveInventory("UrineBottleFlag")
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor UrineBottleDamage : PowerProtection {
  Powerup.Duration 0x7ffffffd
  DamageFactor "Normal", 2.0
}

actor UrineDebuff_H : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 16 A_GiveToTarget("UrineDebuffFX_P2")
    loop
  }
}

actor UrineDebuffFX_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEX("UrineDripDrop", random(-16, 16), random(-16, 16), random(8, 32), 0, 0, 0.1)
    stop
  }
}

actor UrineDebuffFX_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEX("UrineDripDrop2", random(-16, 16), random(-16, 16), random(8, 32), 0, 0, 0.1)
    stop
  }
}

actor UrineDripDrop : DentistDripDrop {
  Translation "192:192=162:162", "198:198=163:163"
}

actor UrineDripDrop2 : UrineDripDrop {
  DeathSound "TheDentist/Debuff"
}

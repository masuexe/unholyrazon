// Pegg
actor HogWashItem : UnholyItem {
  Tag "$TAG_T_BOX09"
  inventory.pickupmessage "order now and get your hog wash for twice the price"
  Inventory.Icon "TANKOW09"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_TA J 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("weapon/SumoLeap", "Item")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("HogWash_Shot", 0, 0, 0, 0)
    goto End
  }
}

actor AutoHogWashItem : HogWashItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoHogWashItemSilent : AutoHogWashItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor HogWashItemFX : UnholyItemFX {
  States {
   Spawn:
    I_TA J 0
    goto Spawn2
  }
}

actor HogWash_Shot : BasicNoClassTranslationProjectile {
  Translation "192:192=35:35", "198:198=39:39"
  -NOGRAVITY
  +THRUACTORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +NOEXPLODEFLOOR
  +STEPMISSILE
  MaxStepHeight 16
  BounceFactor 2.0
  WallBounceFactor 2.0
  ReactionTime 25
  Damage (0)
  Radius 16
  Height 16
  Speed 50
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 12, 0, 1)
    TNT1 A 0 A_PlaySoundEx("MMX7/BoarskiPain", "SoundSlot7")
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   SpawnWait:
    HSHZ OOPPQQRR 1 A_JumpIf(z - floorz == 0, "WashStart")
    loop
   WashStart:
    HSHZ O 0 A_ChangeVelocity(50, 0, 0, 3)
    HSHZ O 0 A_PlaySoundEx("weapon/rainflush", 1, 1.0)
   Wash:
    HSHZ O 2 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 35, 0, 5, random(0, 359))
    HSHZ P 0 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 5, 0, 5, random(0, 359))
    HSHZ P 0 A_SpawnItemEx("HogWash_ShotFX")
    HSHZ P 2 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 35, 0, 5, random(0, 359))
    HSHZ Q 0 A_SpawnItemEx("HogWash_ShotFX")
    HSHZ Q 2 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 35, 0, 5, random(0, 359))
    HSHZ R 0 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 5, 0, 5, random(0, 359))
    HSHZ R 0 A_SpawnItemEx("HogWash_ShotFX")
    HSHZ R 2 A_SpawnItemEx("HogWash_OxiClean", 0, 0, 0, 35, 0, 5, random(0, 359))
    HSHZ O 0 A_SpawnItemEx("HogWash_ShotFX")
    HSHZ O 0 A_CountDown
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_SetGravity(0.0)
    TFOG FE 2
    TFOG E 0 A_ChangeFlag("NOCLIP", 1)
    TFOG DDDDDDD 5 ThrustThingZ(0, 75, 0, 0)
    stop
  }
}

actor HogWash_ShotFX : BasicGraphicEffect {
  Translation "192:192=202:202", "198:198=197:197"
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 AAAAAA 1 A_SpawnItemEx("HogWash_ShotFX2", random(-15, 15), random(-15, 15), 0, 0, 0, 5, 0, 1)
    stop
  }
}

actor HogWash_ShotFX2 : BasicGraphicEffect {
  RenderStyle "Translucent"
  Alpha 0.8
  States {
   SpawnFrame:
    X_BG IJKL 4
    stop
  }
}

actor HogWash_OxiClean : BasicNoClassTranslationProjectile {
  Translation "192:192=202:202", "198:198=197:197", "0:0=198:198"
  DamageType "HogWash"
  Obituary "%o drank up all of %k's laundry sauce."
  -NOGRAVITY
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 0.1
  WallBounceFactor 0.1
  BounceCount 10
  RenderStyle "Translucent"
  Alpha 0.8
  Damage (50)
  Radius 15
  Height 15
  Speed 0
  Scale 2.5
  States {
   Spawn:
    X_1H B 0
    X_1H B 0 ThrustThingZ(0, 4, 0, 1)
    X_1H B 5
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("HogWash_OxiClean2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor HogWash_OxiClean2 : BasicNoClassTranslationProjectile {
  DamageType "HogWash"
  Obituary "%o drank up all the laundry sauce."
  -NOGRAVITY
  +BOUNCEONCEILINGS
  +NOEXPLODEFLOOR
  BounceFactor 1.0
  WallBounceFactor 0.0
  RenderStyle "Translucent"
  Alpha 0.8
  Damage (50)
  Radius 15
  Height 15
  Speed 0
  Scale 2.5
  States {
   Spawn:
    X_1H B 0 A_Stop
    X_1H B 2
    X_1H C 350
    X_1H C 0 A_SpawnItemEx("HogWash_OxiCleanFX", 0, 0, 0, 0, 0, 0, 0, 33)
    stop
  }
}

actor HogWash_OxiCleanFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    X_1H C 0
    X_1H CCCC 2 A_FadeOut(0.2)
    stop
  }
}

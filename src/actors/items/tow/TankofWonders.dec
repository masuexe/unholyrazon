actor TankOfWondersItem : BasicDroppedItem
{//Celebi//Pikmin555/Dakutatoru
Tag "$TAG_T_BOX00"
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "Tank of ideas that are reality!"
inventory.icon "TANKOW00"
Inventory.PickupSound "items/UnholyPickup"
+INVBAR
states
{
Spawn:
I_TA A 5
loop
Use:
UseX:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity",1,"UseProsperity")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_GiveRandomBoxItem", 3, 0, 0)
stop
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity",1,"UseProsperitySilent")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_GiveRandomBoxItem", 3, 0, 1)
stop
UseProsperity:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_GiveRandomBoxItem", 3, 1, 0)
stop
UseProsperitySilent:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_GiveRandomBoxItem", 3, 1, 1)
stop

}
}

actor AutoTankOfWondersItem : TankOfWondersItem
{
Translation "62:62=56:56"
inventory.maxamount 0
inventory.pickupmessage "\ctAutomatic Tank Of Wonders!"
Inventory.PickupSound ""
-INVENTORY.INVBAR
+INVENTORY.ALWAYSPICKUP
States
{
Pickup:
goto UseX
}
}
actor AutoTankOfWondersItemSilent : AutoTankOfWondersItem
{
States
{
Pickup:
goto UseX_Silent
}
}
actor TankOfWondersItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_TA A 0
            goto Spawn2
    }
}


actor TankOfWondersItem : BasicDroppedItem
{//Celebi//Pikmin555/Dakutatoru
Tag "$TAG_T_BOX00"
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "Tank of ideas that are reality!"
inventory.icon "TANKOW00"
Inventory.PickupSound "items/UnholyPickup"
+INVBAR
states
{
Spawn:
I_TA A 5
loop
Use:
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("GNT/ChestOpen","SoundSlot5")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity",1,"UseProsperity")
TNT1 A 0 A_Jump(1,"Rare1")
TNT1 A 0 A_Jump(2,"Rare2")
TNT1 A 0 A_Jump(8,"Rare8")
TNT1 A 0 A_Jump(16,"Rare16")
TNT1 A 0 A_Jump(32,"Rare32")
TNT1 A 0 A_Jump(64,"Rare64")
TNT1 A 0 A_Jump(74,"Rare74")
TNT1 A 0 A_Jump(128,"Rare128")
TNT1 A 0 A_Jump(198,"Rare198")
TNT1 A 0 A_Jump(256,"Rare256")
stop
UseProsperity:
TNT1 A 0 A_Jump(3,"Rare1")
TNT1 A 0 A_Jump(8,"Rare2")
TNT1 A 0 A_Jump(16,"Rare8")
TNT1 A 0 A_Jump(64,"Rare16")
TNT1 A 0 A_Jump(96,"Rare32")
TNT1 A 0 A_Jump(96,"Rare64")
TNT1 A 0 A_Jump(112,"Rare74")
TNT1 A 0 A_Jump(144,"Rare128")
TNT1 A 0 A_Jump(160,"Rare198")
TNT1 A 0 A_Jump(256,"Rare256")
stop

// Rare1:
// TNT1 A 0 A_PlaySoundEx("misc/BlankSound","SoundSlot5")
// TNT1 A 0 A_PlaySoundEx("S_Spin/Surprise","SoundSlot7")
// TNT1 A 0 A_JumpIfInventory("I_WinItem",1,"Rare2")
// TNT1 A 0 A_GiveInventory("I_WinItem",1)
// stop
// Rare2:
// ObtainDLC:
// TNT1 A 0 A_GiveInventory("DLC_CoinItem",777)
// stop
// Rare8:
// SuperWasp:
// TNT1 A 0 A_GiveInventory("GoldenWaspBombItem",1)
// stop
// Rare16:
// //LookSomeCoins:
// OM_Insurance:
// TNT1 A 0 A_GiveInventory("UnholyInsuranceItem",1)
// stop
// Rare32:
MLGProDrinkSponser:
TNT1 A 0 A_GiveInventory("MountainDewItem",1)
stop
// Rare64: //HogWash
// TNT1 A 0 A_GiveInventory("HogWashItem",1)
// stop
// Rare74:
// PrepareDruBombs:
// TNT1 A 0 A_GiveInventory("CarpetBomberItem",1)
// stop
// Rare128:
// RandomPone:
// TNT1 A 0 A_GiveInventory("RandomPonyItem",1)
// stop
// Rare198:
// //GetStoned:
// TNT1 A 0 A_GiveInventory("DeadlyFireArmsItem",1)
// stop
Rare256:
ThatMadeNoSense:
TNT1 A 0 A_PlaySoundEx("misc/BlankSound","SoundSlot5")
TNT1 A 0 A_PlaySoundEx("items/DamnABox","SoundSlot6")
TNT1 A 0 A_GiveInventory("MysticBoxItem",1)
stop

}
}

actor AutoTankOfWondersItem : TankOfWondersItem
{
Translation "62:62=56:56"
inventory.maxamount 0
inventory.pickupmessage "\ctAutomatic Tank Of Wonders!"
Inventory.PickupSound ""
-INVENTORY.INVBAR
+INVENTORY.ALWAYSPICKUP
States
{
Pickup:
goto UseX
}
}
actor AutoTankOfWondersItemSilent : AutoTankOfWondersItem
{
States
{
Pickup:
goto UseX_Silent
}
}
actor TankOfWondersItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_TA A 0
            goto Spawn2
    }
}


actor I_WinItem : UnholyItem
{//Celebi & Pegg
Tag "$TAG_T_BOX06"
inventory.maxamount 1
inventory.pickupmessage "Winner! :)"
inventory.icon "TANKOW06"
States
{
Spawn:
I_TA G 6
loop
UseX:
TNT1 A 0
TNT1 A 0 //A_PlaySound("S_Spin/SUCCESS",7,1.0)
UseX_Silent:
//TNT1 A 0 A_PrintBold("\ciYou're Winner !",5.0,"BIGFONT")
TNT1 A 0 ACS_NamedExecuteAlways("UB_I_WinACS",0)
TNT1 A 0 //A_SpawnItemEx("",0,0,28,0,0,0,0,1)
goto End
}
}

actor AutoI_WinItem : I_WinItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoI_WinItemSilent : AutoI_WinItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor I_WinItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TA G 0
            goto Spawn2
    }
}
actor DickheadItem : UnholyItem {
  Tag "$TAG_RZ_TBOX04"
  inventory.pickupmessage "Just a dickhead, push it into their mouths!"
  Inventory.Icon "RZTI_04"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_RT E 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc_L/itemthrow", "SoundSlot6")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("DickheadProjectile", 0, 0, 0, 0)
    goto End
  }
}
actor AutoDickheadItem : DickheadItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDickheadItemSilent : AutoDickheadItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DickheadItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RT E 0
    goto Spawn2
  }
}

actor DickheadProjectile : BasicNoClassTranslationProjectile {
  -NOGRAVITY
  +THRUGHOST
  +STEPMISSILE
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +BOUNCEONACTORS
  Speed 20
  Damage (0)
  States {
   Spawn:
    I2TE A 0
    I2TE A 1 A_CheckFloor("Floor")
    wait
   Floor:
    I2TE A 0 A_SpawnItemEx("Dickhead", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    goto Death
   Death:
    TNT1 A 0
    stop
  }
}

actor Dickhead : CustomInventory {
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I2TE AAA 35
   Revive:
    I2TE A 0 A_ChangeFlag("SPECIAL", 0)
    I2TE A 0 ACS_NamedExecuteAlways("rz_DickheadRevival", 0)
    I2TE A 1
    wait
   UsedUp:
    TNT1 A 0
    stop
   BecomePickup:
    I2TE A 0 A_ChangeFlag("SPECIAL", 1)
    I2TE A 1
    wait
   Pickup:
    TNT1 A 0 A_GiveInventory("AutoUnholyInsuranceItem", 1)
    stop
  }
}

actor DickheadReviveBoom : BasicExplosion {
  Translation "192:192=176:176", "198:198=182:182"
  DamageType "DickheadRevive"
  Obituary "$OB_MPTELEFRAG"
  // +OLDRADIUSDMG
  +PIERCEARMOR
  Radius 12
  Height 64
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("RPGMaker/Explosion2", "Auto")
    TNT1 A 0 A_SpawnItemEx("BasicBoomRMFX_Fire2_Tic2", 0, 0, 32, 0, 0, 0, 0, SXF_TRANSFERSCALE)
    TNT1 A 1 A_Explode(999900, 48, 1, 0, 97)
    stop
  }
}

actor HazardTag_DickheadRevive : BasicACSDamager {
  DamageType "DickheadRevive"
  Obituary "%o was caught in a Dickhead revival explosion while fighting %k."
}

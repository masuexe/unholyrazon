actor DickheadItem : UnholyItem {
  Tag "$TAG_P_BOX01"
  inventory.pickupmessage "Just a dickhead, push it into their mouths!"
  inventory.icon "PANBOX01"
  States {
   Spawn:
    I_BA B 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("items/GoldTank", "SoundSlot6")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("DickheadProjectile", 0, 0, 0, 0)
    goto End
  }
}
actor AutoDickheadItem : DickheadItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDickheadItemSilent : AutoDickheadItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DickheadItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA B 0
    goto Spawn2
  }
}

actor DickheadProjectile : BasicNoClassTranslationProjectile {
  -NOGRAVITY
  +STEPMISSILE
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +BOUNCEONACTORS
  Speed 20
  Damage (0)
  States {
   Spawn:
    I2TE A 1 A_CheckFloor("Floor")
    wait
   Floor:
    I2TE A 0 A_SpawnItemEx("Dickhead")
    goto Death
   Death:
    TNT1 A 0
    stop
  }
}

actor Dickhead : CustomInventory {
  Scale 2.5
  States {
   Spawn:
    I2TE A 1
    wait
   Pickup:
    TNT1 A 0 A_GiveInventory("AutoUnholyInsuranceItem")
    stop
  }
}

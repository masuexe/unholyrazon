actor GoldenWaspBombItem : UnholyItem
{//Braixen
Tag "$TAG_T_BOX01"
inventory.amount 1
inventory.pickupmessage "Get Super Raped! Golden Wasp!"
inventory.icon "TANKOW01"
States
{
Spawn:
I_TA B 6
loop
UseX:
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("GoldenWaspDelay",1,"No")
TNT1 A 0 A_JumpIfInventory("GoldenWaspFlag",1,"UseX1")
TNT1 A 0 A_GiveInventory("GoldenWaspFlag",1)
TNT1 A 0 A_GiveInventory("GoldenWaspTimer",176)
TNT1 A 0 A_SpawnItemEx("GoldenWaspBombTimer_H",0,0,24)
goto UseX1
UseX1:
TNT1 A 0 A_PlaySoundEx("items/GoldenWaspShot","Item")
UseX1_Silent:
TNT1 A 0 A_FireCustomMissile("GoldenWaspBomb",0,0,0,0)
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
TNT1 A 0 A_GiveInventory("GoldenWaspDelay",1)
TNT1 A 0
fail
}
}

actor AutoGoldenWaspBombItem : GoldenWaspBombItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX1
    }
}
actor AutoGoldenWaspBombItemSilent : AutoGoldenWaspBombItem {
    States {
        Pickup:
            goto UseX1_Silent
    }
}
actor GoldenWaspBombItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TA B 0
            goto Spawn2
    }
}

actor GoldenWaspDelay : Powerup
{
Powerup.Duration 4
}

actor GoldenWaspFlag : UOnce{}

actor GoldenWaspTimer : Inventory
{
inventory.amount 1
inventory.maxamount 176
}


actor GoldenWaspBombTimer_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/GoldenWaspShot","Item")
TNT1 A 0 A_FireCustomMissile("GoldenWaspBomb",0,0,0,0)
stop
}
}

actor GoldenWaspBombTimer_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAA 2 A_TakeFromTarget("GoldenWaspTimer",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "SpawnEnd")
TNT1 A 1 A_JumpIfInTargetInventory("GoldenWaspTimer",1,1)
goto SpawnEnd
TNT1 AAAA 2 A_TakeFromTarget("GoldenWaspTimer",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "SpawnEnd")
TNT1 A 0 A_GiveToTarget("GoldenWaspBombTimer_P",1)
TNT1 A 1 A_JumpIfInTargetInventory("GoldenWaspTimer",1,"Spawn")
goto SpawnEnd
SpawnEnd:
TNT1 A 0 A_TakeFromTarget("GoldenWaspBombItem",1)
TNT1 A 0 A_TakeFromTarget("GoldenWaspFlag")
TNT1 A 0 A_TakeFromTarget("GoldenWaspTimer")
stop
}
}

actor GoldenWaspBomb : WaspBomb
{
Translation "192:192=160:160", "198:198=229:229"
damagetype "GoldenWasp"
Obituary "%o couldn't handle %k's overuse of Golden Wasps."
BounceCount 5
ReactionTime 130
damage (0)
States
{
Spawn:
I_BL A 0
I_BL A 0 A_SeekerMissile(60,60,1,256,7)
I_BL AABBCCDD 1 //A_SeekerMissile(2,12,3,256,7)
I_BL A 0 A_CountDown
loop
Death:
TNT1 A 0 A_PlaySoundEx("wep_L/mm9/hornetchaserfire","Item")
TNT1 A 0 A_SpawnItemEx("GoldenWaspBomb2",0,0,1,20,random(-20,20),random(5,20),random(0,179),1024)
TNT1 A 0 A_SpawnItemEx("GoldenWaspBomb2",0,0,1,20,random(-20,20),random(-5,-20),random(180,359),1024)
TMFX A 2 A_Explode(55,66,0,0,8)
TMFX BCD 2
stop
}
}

actor GoldenWaspBomb2 : GoldenWaspBomb
{
-SCREENSEEKER
+RIPPER
damage (0)
Radius 4
Height 4
States
{
Spawn:
I_BL HGFE 1
I_BL E 0 A_ChangeFlag("RIPPER",0)
Spawn2:
I_BL E 0 A_SeekerMissile(75,75,1,55,6)
I_BL LKJIHGFE 1 //A_SeekerMissile(3,15,SMF_LOOK,55,6)
I_BL E 0 A_CountDown
loop
Death:
TMFX A 2 A_Explode(45,66,0,0,8)
TMFX BCD 2
stop
}
}


Actor DeadlyFireArmsItem : UnholyItem
{//SuperJustinBros
Tag "$TAG_T_BOX05"
inventory.pickupmessage "Support Item! Deadly Fire Arms!"
inventory.icon "TANKOW05"
states
{
Spawn:
I_TA F 1
loop

UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("item/refill","Item")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("DeadlyFireArmsFlag",1,3)
TNT1 A 0 A_GiveInventory("DeadlyFireGunWarperFX_P")
TNT1 A 0 A_SpawnItemEx("DeadlyFireArmsWatcher_H")
TNT1 A 0 A_SpawnItemEx("DeadlyFireArmsCountdown_H")
TNT1 A 0
goto End
}
}

actor AutoDeadlyFireArmsItem : DeadlyFireArmsItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoDeadlyFireArmsItemSilent : AutoDeadlyFireArmsItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor DeadlyFireArmsItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TA F 0
            goto Spawn2
    }
}

actor DeadlyFireGunWarperFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("DeadlyFireGunWarperFX")
stop
}
}

actor DeadlyFireArmsFlag : Inventory {
  Inventory.Amount 1
  Inventory.MaxAmount 0x7ffffffc  // 840
}

actor DeadlyFireArmsCountdown_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("DeadlyFireArmsFlag", 1, "No")
    TNT1 A 0 A_GiveToTarget("DeadlyFireArmsFlag", 840)
   SpawnLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 1 A_TakeFromTarget("DeadlyFireArmsFlag", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("DeadlyFireArmsFlag", 1, "SpawnLoop")
    goto Death
   Death:
    TNT1 A 0
    stop
   No:
    TNT1 A 0 A_GiveToTarget("DeadlyFireArmsFlag", 840)
    stop
  }
}

actor DeadlyFireArmsWatcher_H : BasicHelper
{
states
{
Spawn:
TNT1 A 5
SpawnLoop:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 AA 1 A_JumpIf(CallACS("UB_DeadlyFireArmsButtonCheck")==2,"SpawnFire")
TNT1 A 0 A_JumpIfInTargetInventory("DeadlyFireArmsFlag",1,"SpawnLoop")
goto Death
SpawnFire:
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "SpawnFireRage")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 5 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 5 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 6 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 AAAAAAAAAA 2 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
goto SpawnLoop+3
SpawnFireRage:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 2 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 2 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 3 A_GiveToTarget("DeadlyFireFire_P",1)
TNT1 AAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
goto SpawnLoop+3
//TNT1 A 0 A_JumpIfInTargetInventory("DeadlyFireArmsFlag",1,"SpawnLoop")
//goto Death
Death:
TNT1 A 0
TNT1 A 1 A_GiveToTarget("DeadlyFireGXDeath",1)
stop
}
}

actor DeadlyFireGunWarperFX : BasicShieldWarper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Warp(2,-8,0,64,0,24)
Goto SpawnL
SpawnL:
I_TF A 1 A_Warp(2,-8,0,64,0,24)
I_TF A 0 A_JumpIfInTargetInventory("DeadlyFireArmsFlag",1,"SpawnL")
I_TF A 1 A_JumpIf(1,"Death")
wait
Death:
TNT1 A 1
stop
}
}

actor DeadlyFireFire_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_SpawnItemEx("DeadlyFireFireSnd",0,0,92)
TNT1 A 0 A_JumpIfInventory("BAWS",1,"Pickup2")
TNT1 A 0 A_FireCustomMissile("DeadlyFireShot",0,0,0,64)
stop
Pickup2:
TNT1 A 0 A_FireCustomMissile("DeadlyFireShotB",0,0,0,64)
stop
}
}

actor DeadlyFireFire_P3 : CustomInventory//DLC Coins
{
states
{
Pickup:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"Pickup2")
TNT1 A 0 A_FireCustomMissile("DeadlyFireShot",0,0,0,0)
TNT1 A 0 A_FireCustomMissile("DeadlyFireShot",15,0,0,0)
TNT1 A 0 A_FireCustomMissile("DeadlyFireShot",-15,0,0,0)
stop
Pickup2:
TNT1 A 0 A_FireCustomMissile("DeadlyFireShotB",0,0,0,0)
TNT1 A 0 A_FireCustomMissile("DeadlyFireShotB",15,0,0,0)
TNT1 A 0 A_FireCustomMissile("DeadlyFireShotB",-15,0,0,0)
stop
}
}

actor DeadlyFireFireSnd : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 10 A_PlaySoundEx("items/DeadlyShot","Item")
stop
}
}

actor DeadlyFireGXDeath : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_SpawnItemEx("RealDeadlyFireExplosion",-8,0,64)
stop
}
}

actor RealDeadlyFireExplosion : BasicExplosion
{
Translation "198:198=45:45", "192:192=247:247"
damagetype "DeadlyFireArmB"
Obituary "\"Nice trick, %k.\" \cf-%o"
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX","Weapon")
TNT1 A 0 A_Explode(450,128,0,0,32)
X_8B ABCDEF 2
stop
}
}

actor DeadlyFireShot : BasicNoClassTranslationProjectile
{
damagetype "DeadlyFireArm"
Obituary "\"Nice catch, %o.\" \cf-%k"
-NOGRAVITY
gravity 0.5
Damage (45)
radius 16
height 16
Speed 50
scale 3.5
States
{
Spawn:
I_TF S 0
I_TF S 0 ThrustThingZ(0,8,0,1)
I_TF S 1
wait
Death:
I_TF T 0
I_TF T 0 A_SetGravity(0.0)
I_TF T 0 A_PlaySoundEx("wep_L/mm1/hyperbombexplode", "Weapon")
I_TF T 0 A_Explode(145,148,0,0,24)
I_TF TUVWVUT 1
stop
}
}

actor DeadlyFireShotB : DeadlyFireShot {damagetype "DeadlyFireArmB"}

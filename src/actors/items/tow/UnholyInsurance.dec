actor UnholyInsuranceItem : UnholyItem
{//OrangeMario
Tag "$TAG_T_BOX07"
inventory.maxamount 9
inventory.pickupmessage "Now without paperwork; Unholy Insurance!"
inventory.icon "TANKOW07"
States
{
Spawn:
I_TA H 6
loop
UseX:
UseX_Silent:
// TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLifeUnholyInsurance",1,"UseX2")
TNT1 A 0 A_PlaySound("KirbyNES/1up",7,0.885)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, ELP_INSURANCE)
TNT1 A 0 A_SpawnItemEx("UnholyInsuranceFX",0,0,28,0,0,2)
goto End
UseX2:
TNT1 A 0 A_PlaySoundEx("GNT/FailUse","Item")
fail
}
}

actor AutoUnholyInsuranceItem : UnholyInsuranceItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoUnholyInsuranceItemSilent : AutoUnholyInsuranceItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor UnholyInsuranceItemFX : UnholyItemFX {
    States {
        Spawn:
            I_TA H 0
            goto Spawn2
    }
}

actor UnholyInsuranceFlag : Inventory {}

actor UnholyInsuranceFX : BasicClientSide
{
Translation "192:192=211:211","198:198=222:222"
Scale 2.5
States
{
Spawn:
I_TH TUTUTUTUTUTUTU 2
stop
}
}


actor UI_ItemStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TNT1 A 0 A_SpawnItemEx("UnholyInsuranceTruck",-768,0,0,15,0,0,random(0,11)*30,32)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
TNT1 A 0 A_GiveInventory("UnholyInsuranceFlag",1)
TNT1 A 0 A_SpawnItemEx("UInsurance_Delay_H",0,0,0,0,0,0,0,32)
stop
}
}
actor UI_ItemWait_P : CustomInventory
{//130 tics
States
{
Pickup:
// TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TNT1 A 0 A_Stop
stop
}
}
actor UI_ItemEnd_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 2000)
TNT1 A 0 A_GiveInventory("NoTeleportFX_Flag",1)
TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P",1)
TNT1 A 0 A_TakeInventory("UnholyInsuranceFlag")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_INSURANCE)
stop
}
}

actor UInsurance_Delay_H : BasicHelper
{
Args 130
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_GiveToTarget("UI_ItemWait_P",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "End")
TNT1 A 0 A_CountDownArg(0)
loop
End:
TNT1 A 1
stop
Death:
TNT1 A 0
TNT1 A 1 A_GiveToTarget("UI_ItemEnd_P",1)
stop
}
}


actor UnholyInsuranceTruckDmg : BasicExplosion
{
Damagetype "UnholyInsurance"
Obituary "%k gave %o %p quiet life."
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(125,96,0,0,97)
stop
}
}


actor UnholyInsuranceTruck_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("UnholyInsuranceTruckDmg",64,0,28)
TNT1 A 0 A_SpawnItemEx("UnholyInsuranceTruckDmg",-64,0,28)
stop
}
}
actor UnholyInsuranceTruckFadeIn_P : UnholyInsuranceTruck_P
{
States
{
Pickup:
TNT1 A 0 A_FadeIn(0.1)
goto Super::Pickup
}
}
actor UnholyInsuranceTruckFadeOut_P : UnholyInsuranceTruck_P
{
States
{
Pickup:
TNT1 A 0 A_FadeOut(0.1)
goto Super::Pickup
}
}

actor UnholyInsuranceTruckSlow_P : UnholyInsuranceTruck_P
{
States
{
Pickup:
TNT1 A 0 A_ChangeVelocity(momx*0.875,momy*0.875,0,2)
TNT1 A 0 ThrustThing(angle*256/360,0)
goto Super::Pickup
}
}
actor UnholyInsuranceTruckFast_P : UnholyInsuranceTruck_P
{
States
{
Pickup:
TNT1 A 0 A_Recoil(-2.25)
goto Super::Pickup
}
}


actor UnholyInsuranceTruck : BasicNoClassTranslationExplosion
{
Translation "192:192=222:222", "198:198=89:89"
Damagetype "UnholyInsurance"
Obituary "%k gave %o %p quiet life."
RenderStyle Translucent
Alpha 0.1
scale 2.5
States
{
Spawn:
I_TH A 0
I_TH A 0 A_PlaySoundEx("items/Insurance","Weapon")
I_TH BBBAAABBB 1 A_GiveInventory("UnholyInsuranceTruckFadeIn_P",1)
goto Spawn2
Spawn2:
I_TH ABABABABABAB 3 A_GiveInventory("UnholyInsuranceTruck_P",1)
I_TH ABABABAB 3 A_GiveInventory("UnholyInsuranceTruckSlow_P",1)
I_TH CCC 2 A_GiveInventory("UnholyInsuranceTruck_P",1)
I_TH C 0 A_ChangeVelocity(0,0,0,3)
I_TH C 0 A_GiveInventory("ReSyncPickup",1)
I_TH C 10
I_TH DEFFFFEDCC 5
I_TH A 0 A_Recoil(-2)
I_TH ABABABAB 3 A_GiveInventory("UnholyInsuranceTruckFast_P",1)
I_TH ABABA 3 A_GiveInventory("UnholyInsuranceTruck_P",1)
I_TH BBBAAABBB 1 A_GiveInventory("UnholyInsuranceTruckFadeOut_P",1)
stop
}
}


actor MountainDewItem : UnholyItem {
  Tag "$TAG_T_BOX02"

  inventory.pickupmessage "MOUNTAIN DEW!"
  Inventory.Icon "TANKOW02"
  States {
   Spawn:
    I_TA C 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("item/UnholyWater1", "Item")  // weapon/flashbomb
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, 2)
    TNT1 A 0 A_GiveInventory("UnholyWaterGSpeed")
    TNT1 A 0 A_FireCustomMissile("MountainDewShot", 0, 0, 0, 0)
    goto End
  }
}
actor AutoMountainDewItem : MountainDewItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoMountainDewItemSilent : AutoMountainDewItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor MountainDewItemFX : UnholyItemFX {
  States {
   Spawn:
    I_TA C 0
    goto Spawn2
  }
}

actor UnholyWaterGSpeed : PowerSpeed {
  powerup.color green 0.45
  powerup.duration -6
  Speed -5.5
}

actor MountainDewShot : BasicNoClassTranslationProjectile {
  Translation "192:192=110:110", "198:198=111:111", "0:0=127:127"
  DamageType "MountainDew"
  Obituary "%o could not face %k's Mountain Dew."
  -DONTSPLASH
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  +THRUGHOST
  Damage (100)
  Height 9
  Radius 9
  Speed 50
  Scale 2.5
  States {
   Spawn:
    X_8H B 0
    X_8H B 0 ThrustThingZ(0, 12, 0, 1)
    X_8H BCDC 1
    goto Spawn+2
   Death:
    TNT1 A 0 A_Explode(900, 256, 1, 0, 12)
    TNT1 A 0 A_PlaySoundEx("item/UnholyWater2", "Body")
    TNT1 A 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")
    TNT1 A 0 A_PlaySoundEx("weapon/flashbomb", "Item")
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, 90, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, -90, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, 180, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, 45, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, -45, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, 135, 1)
    TNT1 A 0 A_SpawnItemEx("MountainDewSpawner", 32, 0, 0, 0, 0, 0, -135, 1)
    X_8B ABCDEF 1
    stop
  }
}

actor MountainDewSpawner : BasicNoClassTranslationProjectile {
  DamageType "MountainDew"
  Obituary "%o could not face %k's Mountain Dew."
  +RIPPER
  +DONTREFLECT
  -NOGRAVITY
  ReactionTime 35
  Damage (40)
  Radius 10
  Height 10
  Scale 1.0
  States {
   Spawn:
    X_8H B 0
    X_8H C 1 ThrustThingZ(0, 100, 1, 0)
    X_8H D 1 A_CountDown
    X_8H B 1
    goto Spawn+2
   Crash:
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("MountainDewTower")
    TNT1 A 1 A_SpawnItemEx("MountainDew", 0, 0, 0, 8)
    stop
  }
}

actor MountainDew : BasicNoClassTranslationProjectile {
  +THRUACTORS
  +FLOORHUGGER
  +DONTREFLECT
  +THRUGHOST
  DamageType "MountainDew"
  Damage (0)
  Radius 10
  Height 50
  Speed 8
  States {
   Spawn:
    TNT1 A 6 A_SpawnItemEx("MountainDewTower")
    loop
  }
}

actor MountainDewTower : BasicNoClassTranslationProjectile {
  Translation "192:192=4:4", "198:198=110:110"
  DamageType "MountainDew"
  Obituary "%o got too much of a rush from %k's Mountain Dew and died."
  +THRUGHOST
  +RIPPER
  +DONTSPLASH
  +DONTBLAST
  +DONTREFLECT
  +FLOORHUGGER
  Damage (32)
  Height 60
  Radius 16
  Speed 0
  Scale 4.5
  States {
   Spawn:
    X_5B ABCD 1
    X_5B CD 1
    X_5B CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDC 1
    X_5B DCBA 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_MountainDew : BasicACSDamager {
  DamageType "MountainDew"
  Obituary "%o could not face their own Mountain Dew while fighting %k."
}

// razon3 death shitting random pool, adapted to razon4's surviving actors.
// Retired FakeItems / BugBomb / BossBoxer / Ralph / MiniElemental slots omitted.
// PitSpike replaces JustSpike; ColdSummon owns the old Stoptagon explosion;
// Dickhead replaces the retired revival mushroom. One Pickup roll per death.
actor UH_DeathShitting_P : CustomInventory
{
  States
  {
   Pickup:
    TNT1 A 0 A_Jump(256,
    "Pandora", "ChanceBox", "AssHat", "JohnMadden", "SatanGift", // items
    "Ztar", "STank", "PTank", "1UP", // buffs
    "Wasp", // weapons
    "Lego", // mines
    "Flinging", "Tornado", "Flashing", "RushCoil", "Box", "KillerBox", "MBox", "MKillerBox", "RKillerBox", "RKillerBoxX", // eyes
    "STOPThem", "Coffee", "CarpetBomber", "HogWash", "Waters", "FakeGUHU", "Chair", // AOE
    "DLCMoney", "YouMeanSomeMoney", // money
    "RedNote", "Boom", "RealSpike", // instantkill
    "Fireman", "Bird", "Pyramid", "HackedEnemy", // monsters
    "Plants", "Revive" // misc
    )
    TNT1 A 1
    stop
    // boxes
   Pandora:
    TNT1 A 0 A_Jump(64, "Mystic")
    TNT1 A 0 A_SpawnItemEX("PandoraBoxItem")
    stop
   Mystic:
    TNT1 A 0 A_Jump(64, "ToW")
    TNT1 A 0 A_SpawnItemEX("MysticBoxItem")
    stop
   ToW:
    TNT1 A 0 A_Jump(64, "ShitPower")
    TNT1 A 0 A_SpawnItemEX("TankOfWondersItem")
    stop
   ShitPower:
    TNT1 A 0 A_SpawnItemEX("TruePowerItem")
    stop
   ChanceBox:
    TNT1 A 0 A_SpawnItemEX("ChanceBoxReal")
    stop
   AssHat:
    TNT1 A 0 A_Jump(256, "AssHatDrop", "DickHatDrop")
   AssHatDrop:
    TNT1 A 0 A_SpawnItemEX("AssHatItemX")
    stop
   DickHatDrop:
    TNT1 A 0 A_SpawnItemEX("DickHatItemX")
    stop
   JohnMadden:
    TNT1 A 0 A_SpawnItemEX("TheFootBallItemX")
    stop
   SatanGift:
    TNT1 A 0 A_SpawnItemEX("SatanSealItem")
    stop

    // buffs
   Ztar:
    TNT1 A 0 A_SpawnItemEX("ZtarmanItemToss")
    stop
   STank:
    TNT1 A 0 A_SpawnItemEX("SuperMysticTankItem")
    stop
   PTank:
    TNT1 A 0 A_SpawnItemEX("PeriwinkleTankItem")
    stop
   1UP:
    TNT1 A 0 A_SpawnItemEX("UnholyInsuranceItem")
    stop

    // weapons
   Wasp:
    TNT1 A 0 A_Jump(64, "GoldWasp")
    TNT1 A 0 A_SpawnItemEX("WaspBombItem")
    stop
   GoldWasp:
    TNT1 A 0 A_SpawnItemEX("GoldenWaspBombItem")
    stop

    // mines
   Lego:
    TNT1 A 0 A_Jump(64, "Spike")
    TNT1 A 0 A_GiveInventory("BrickMineRNG_P", 1)
    stop
   Spike:
    TNT1 A 0 A_Jump(64, "Thumbtack")
    TNT1 A 0 A_GiveInventory("PitSpikeRNG_P", 1)
    stop
   Thumbtack:
    TNT1 A 0 A_GiveInventory("ThumbtackRNG_P", 1)
    stop

    // eyes
   Flinging:
    TNT1 A 0 A_SpawnItemEx("FlingingDE", 56, 0, 38, 1, 0, 0, 0, 0, 0)
    stop
   Tornado:
    TNT1 A 0 A_SpawnItemEx("TornadoDE", 32, 0, 32, 0, 0, 0, 0, 32)
    stop
   Flashing:
    TNT1 A 0 A_SpawnItemEx("FlashingDE", 0, 0, 32, 0, 0, 0, 0, 32)
    stop
   RushCoil:
    TNT1 A 0 A_SpawnItemEx("RushCoilDE", 0, 0, 32, cos(-pitch)*22, 0, sin(-pitch)*22, 0, 32, 0)
    stop
   Box:
    TNT1 A 0 A_SpawnItemEx("FriendlyBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop
   KillerBox:
    TNT1 A 0 A_SpawnItemEx("KillerBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop
   MBox:
    TNT1 A 0 A_SpawnItemEx("GoldenFriendlyBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop
   MKillerBox:
    TNT1 A 0 A_SpawnItemEx("GoldenKillerBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop
   RKillerBox:
    TNT1 A 0 A_SpawnItemEx("AwfulBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop
   RKillerBoxX:
    TNT1 A 0 A_SpawnItemEx("SuperAwfulBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    stop

    // AOE
   STOPThem:
    TNT1 A 0 A_SpawnItemEX("ColdSummonStoptagonExplosion")
    stop
   Coffee:
    TNT1 A 0 A_GiveInventory("AutoHackyCoffeeItem")
    stop
   CarpetBomber:
    TNT1 A 0 A_GiveInventory("AutoCarpetBomberItem")
    stop
   HogWash:
    TNT1 A 0 A_GiveInventory("AutoHogWashItem")
    stop
   Waters:
    TNT1 A 0 A_Jump(64, "WatersX")
    TNT1 A 0 A_SpawnItemEX("UnholyWaterShot")
    stop
   WatersX:
    TNT1 A 0 A_Jump(64, "WatersXX")
    TNT1 A 0 A_SpawnItemEX("MountainDewShot")
    stop
   WatersXX:
    TNT1 A 0 A_SpawnItemEX("MolotovCocktailShot")
    stop

   FakeGUHU:
    TNT1 A 0 A_SpawnItemEx("TrueMistressCopyVisionGUHU")
    stop
   Chair:
    TNT1 A 0 A_SpawnItemEx("VergilChair")
    stop

    // money
   DLCMoney:
    TNT1 A 1 A_SpawnItemEx("UH_DeathShittingCoinSpawner", 40, 0, 0)
    stop
   YouMeanSomeMoney:
    TNT1 A 0 A_Jump(64, "MoneyBomb")
    TNT1 A 0 A_SpawnItemEX("MoneyBaitShot")
    stop
   MoneyBomb:
    TNT1 A 0 A_SpawnItemEX("MoneyBomb")
    stop

    // instantkill
   RedNote:
    TNT1 A 0 A_PlaySoundEx("items/UnholyBook", "SoundSlot7")
    TNT1 A 0 A_SpawnItemEX("UnholyBookToss")
    stop
   Boom:
    TNT1 A 0 A_GiveInventory("AutoAirStrikeItem")
    stop
   RealSpike:
    TNT1 A 0 A_SpawnItemEX("PitSpikeTossInstagib")
    stop

    // monsters
   Fireman:
    TNT1 A 0 A_SpawnItemEx("UH_DeathShittingMinivile")
    stop
   Bird:
    TNT1 A 0 A_GiveInventory("AutoCrowNestItem")
    stop
   HackedEnemy:
    TNT1 A 0 A_SpawnItemEx("ZakoBox")
    stop
   Pyramid:
    TNT1 A 0 A_GiveInventory("AutoWonderStoneItem")
    stop

    // misc
   Plants:
    TNT1 A 0 A_PlaySoundEX("classes/WaterSoak", "Voice")
    TNT1 AAAAAA 0 A_SpawnItemEX("StreetTree", random(-256, 256), random(-256, 256), 4, 0, 0, -256)
    TNT1 AAAAAA 0 A_SpawnItemEX("BurnerBush_B", random(-256, 256), random(-256, 256), 4, 0, 0, -256)
    TNT1 AAAAAAAAAAAAAA 0 A_SpawnItemEX("PlantManGrass_B", random(-256, 256), random(-256, 256), 4, 0, 0, -256)
    TNT1 AAAAAAAAAAAAAA 0 A_SpawnItemEX("ERGrass_B", random(-256, 256), random(-256, 256), 4, 0, 0, -256)
    stop
   Revive:
    TNT1 A 0 A_SpawnItemEx("DickheadProjectile")
    stop
  }
}

actor UH_DeathShittingCoinSpawner : BasicHelper
{
  reactiontime 96
  States
  {
   Spawn:
    TNT1 A 1
    goto Spawn2
    //4 BLUE
    //4 GREEN
    //5 RED
    //7 GOLD
   Spawn2:
    TNT1 A 0 A_CountDown
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Weapon")
    TNT1 A 0 A_Jump(64, "SpawnBlue")
    TNT1 A 0 A_Jump(96, "SpawnGreen")
    TNT1 A 0 A_Jump(128, "SpawnRed")
    TNT1 A 0 A_Jump(256, "SpawnGold")
   SpawnBlue://2+15+1=18
    TNT1 A 1 A_SpawnItemEx("DLCRedCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(3, 12), 0)
    TNT1 AAA 1 A_SpawnItemEx("DLCBlueCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(2, 12), 0)
    TNT1 A 1 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    goto Spawn2
   SpawnGreen://5+9+1=15
    TNT1 A 1 A_SpawnItemEx("DLCBlueCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(2, 12), 0)
    TNT1 AAA 1 A_SpawnItemEx("DLCGreenCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(2, 12), 0)
    TNT1 A 1 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    goto Spawn2
   SpawnRed://6+3+1=10
    TNT1 AAA 1 A_SpawnItemEx("DLCRedCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(3, 12), 0)
    TNT1 A 1 A_SpawnItemEx("DLCGreenCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(2, 12), 0)
    TNT1 A 1 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    goto Spawn2
   SpawnGold://2+4=6
    TNT1 A 1 A_SpawnItemEx("DLCRedCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(3, 12), 0)
    TNT1 AAAA 1 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    goto Spawn2
  }
}

// Preserve razon3's equal choice among the three hidden Minivile disguises.
actor UH_DeathShittingMinivile : BoxDE_MinivileHidden {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "DefaultBox", "SpecialBox", "ThirdBox")
   DefaultBox:
    TNT1 A 0
    goto Super::Spawn+2
   SpecialBox:
    TNT1 A 0
    goto Super::Spawn2+1
   ThirdBox:
    TNT1 A 0
    goto Super::Spawn3
  }
}

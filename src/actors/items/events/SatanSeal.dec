// Satan Seal FFA (event 151): usable gift from Satan.  Each use grants a
// random auto havoc item and re-deals the seal while its user stays in play.
// Razon3 SatanSealItem rebuilt on the v4 UnholyItem base.
actor SatanSealItem : UnholyItem {
  +INVENTORY.KEEPDEPLETED
  Tag "Satan Seal"
  inventory.pickupmessage "\cgYou received a gift from Satan..."
  Inventory.Icon "RZEV_00"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_EV A 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("items/GoldenWaspShot", "SoundSlot6")
    TNT1 A 0 A_SpawnItemEx("SatanSeal_Helper")
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    stop
    TNT1 A 0 A_GiveInventory("AutoRubberBandItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoAirStrikeItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoUnholyBookItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoTheFootBallItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoYouWillDieItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoThumbtackItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoRandomPonyItem", 1)
    stop
    TNT1 A 0 A_GiveInventory("AutoMolotovCocktailItem", 1)
    stop
  }
}

actor SatanSeal_Helper : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 7 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Death")
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Death")
    TNT1 A 2 A_GiveToTarget("SatanSealItem", 1)
    stop
  }
}

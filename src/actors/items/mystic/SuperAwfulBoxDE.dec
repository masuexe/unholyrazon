actor SuperAwfulBoxDEItem : UnholyItem {
  Translation "4:4=228:228", "13:13=80:80", "14:14=88:88", "15:15=92:92", "8:8=176:176", "0:0=95:95"
  Tag "$TAG_RZ_MBOX01"
  inventory.pickupmessage "Box-Demoneye assist!"
  inventory.icon "RZMI_01"
  states {
   Spawn:
    I_BA H 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("SuperAwfulBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("SuperAwfulBoxDE", 0, 56, 38, 1, 0, 0, 90, 32)
    TNT1 A 0 A_SpawnItemEx("SuperAwfulBoxDE", 0, -56, 38, 1, 0, 0, 270, 32)
    goto End
  }
}

actor AutoSuperAwfulBoxDEItem : SuperAwfulBoxDEItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoSuperAwfulBoxDEItemSilent : AutoSuperAwfulBoxDEItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor SuperAwfulBoxDEItemFX : UnholyItemFX {
  Translation "4:4=228:228", "13:13=80:80", "14:14=88:88", "15:15=92:92", "8:8=176:176", "0:0=95:95"
  States {
   Spawn:
    I_BA H 0
    goto Spawn2
  }
}

actor SuperAwfulBoxDE : AwfulBoxDE {
  Translation "192:192=80:80", "198:198=88:88", "199:199=92:92", "204:204=180:180", "195:195=180:180", "8:8=176:176", "0:0=95:95"
  obituary "%o didn't get their \c[g1]refund\c-."
  Health 8500
  speed 10
  DropItem "TruePowerItem" 256 1  // placeholder, idk what to drop now
  States {
   Melee:
    I_BD NN 0 A_FaceTarget
    I_BD N 0 A_CustomMeleeAttack(1270, "weapon/pursuithit", "", "KillerBoxFling", 0)
    I_BD N 0 //A_GiveToTarget("WithAidsDamage",1)
    I_BD N 0 //A_PlaySoundEx("weapon/pursuithit","Weapon")
    I_BD N 1 A_TakeInventory("WeaponCharge")
    goto MeleeWait
   MeleeWait:
    I_BD N 60
    I_BD N 30 A_ClearTarget
    goto Spawn+1//Look+9
  }
}

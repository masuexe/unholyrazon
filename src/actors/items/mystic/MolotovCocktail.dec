actor MolotovCocktailShotBadLMS : MolotovCocktailShot {
  Damagetype "MolotovCocktail"
  States {
   Spawn:
    X_8H B 0
    X_8H B 0 A_ClearTarget
    X_8H B 0 ThrustThingZ(0, 8, 0, 1)
    X_8H BCDC 1
    goto Spawn+2
  }
}


actor MolotovCocktailSpawner : BasicNoClassTranslationProjectile {
  Translation "192:192=214:214", "198:198=217:217", "0:0=220:220"
  Damagetype "MolotovCocktail"
  Obituary "%o was incinerated by %k's Molotov. ("
  +RIPPER
  -NOGRAVITY
  +DONTREFLECT
  ReactionTime 35
  Damage(4)
  Radius 6
  Height 6
  Scale 1.0
  States {
   Spawn:
    WTRB B 0
    WTRB C 1 ThrustThingZ(0, 100, 1, 0)
    WTRB D 2 A_CountDown
    Goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailTower")
    TNT1 A 1 //A_SpawnItemEx("MolotovCocktail",0,0,0,8)
    stop
  }
}
actor MolotovCocktailSpawnerB : MolotovCocktailSpawner {
  Damagetype "MolotovCocktailB"
  States {
   Death:
    TNT1 A 1 A_SpawnItemEx("MolotovCocktailTowerB")
    stop
  }
}


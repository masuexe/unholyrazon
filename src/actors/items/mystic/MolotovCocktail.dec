actor MolotovCocktailItem : UnholyItem {
  Tag "$TAG_RZ_MBOX00"
  inventory.amount 1
  inventory.pickupmessage "Molotov Cocktail! Light, toss, burn!"
  Inventory.icon "RZMI_00"
  States {
   Spawn:
    I_RM A 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/MolotovThrow", "Item")
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "UseX2")
    //TNT1 A 0 A_GiveInventory("MolotovCocktailSpeed")
    TNT1 A 0 A_FireCustomMissile("MolotovCocktailShot", 0, 0, 0, 0)
    goto End
   UseX2:
    TNT1 A 0 A_FireCustomMissile("MolotovCocktailShotB", 0, 0, 0, 0)
    goto End
  }
}

actor MolotovCocktailShot : BasicNoClassTranslationProjectile {
  Translation "192:192=214:214", "198:198=217:217", "0:0=220:220"
  Damagetype "MolotovCocktailShot"
  Obituary "%o was incinerated by %k's Molotov."
  -DONTSPLASH
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  +THRUGHOST
  Damage (10)
  Height 9
  Radius 9
  speed 45
  States {
   Spawn:
    X_8H B 0
    X_8H B 0 ThrustThingZ(0, 8, 0, 1)
    X_8H BCDC 1
    goto Spawn+2
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 4)
    TNT1 A 0 A_Explode(450, 128, XF_HURTSOURCE, 0, 12)
    TNT1 A 0 A_PlaySoundEx("item/UnholyWater2", "Body")
    TNT1 A 0 A_PlaySoundEx("item/MolotovDetonate", "Weapon")
    X_8B ABCDEF 1
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner", 0, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner", 0, 0, 0, 0, 0, 0, 0)
    TNT1 A 7
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, 90)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, -90)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, 45)
    TNT1 A 0 A_SpawnItemEx("MolotovCocktailSpawner2", 60, 0, 0, 0, 0, 0, -45)

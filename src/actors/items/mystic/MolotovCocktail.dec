actor PainMolotovCocktail_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("OnFireSound")
    TNT1 A 0 A_JumpIfInventory("SUDDENLYONFIRE", 1, "MC2")
    TNT1 A 0 A_GiveInventory("SUDDENLYONFIRE")
    TNT1 A 0 A_GiveInventory("OnFireItemFlag", 1)
    TNT1 A 0 A_SpawnItemEx("OnFireItem_H")
    goto Pain
   MC2:
    TNT1 A 0 A_GiveInventory("OnFireItemFlag", 1)
    goto Pain
  }
}

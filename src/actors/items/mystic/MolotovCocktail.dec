actor MolotovCocktail : BasicNoClassTranslationProjectile {
  Damagetype "MolotovCocktail"
  +RIPPER
  +FLOORHUGGER
  +DONTREFLECT
  ReactionTime 5
  Damage (0)
  Height 50
  Radius 10
  Speed 20
  States {
   Spawn:
    TNT1 A 6 A_SpawnItemEx("MolotovCocktailTower")
    TNT1 A 0 A_CountDown
    Loop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    stop
  }
}

actor MolotovCocktailTower : BasicNoClassTranslationProjectile {
  Translation "202:202=215:215", "199:199=217:217"
  DamageType "MolotovCocktail"
  Obituary "%o was toasted by %k's inferno."
  +THRUGHOST
  +RIPPER
  +DONTSPLASH
  +DONTBLAST
  +DONTREFLECT
  +FLOORHUGGER
  Damage (3)
  Radius 32
  Height 66
  Speed 0
  Scale 5.5
  States {
   Spawn:
    FWVE UVWX 2
    FWVE YX 2
    FWVE YXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXYXY 2 //96
    FWVE XWVU 2
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    stop
  }
}
actor MolotovCocktailTowerB : MolotovCocktailTower {
  DamageType "MolotovCocktailB"
}

actor MolotovCocktailTower2 : MolotovCocktailTower {
  Radius 16
  Height 48
  Scale 4.5
}

actor YouWillDieItem : UnholyItem {
  Tag "$TAG_M_BOX02"
  Inventory.MaxAmount 99
  inventory.pickupmessage "Magical Words: \cgYOU DIE!"
  Inventory.Icon "MYSBOX02"
  States {
   Spawn:
    I_MA C 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("YouWillDieItemSnd_P")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("YouWillDieShot", 0, 0, 0, 0)
    goto End
  }
}

actor AutoYouWillDieItem : YouWillDieItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoYouWillDieItemSilent : AutoYouWillDieItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor YouWillDieItemFX : UnholyItemFX {
  States {
   Spawn:
    I_MA C 0
    goto Spawn2
  }
}

actor YouWillDieItemSnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("items/GanonYouDie1", "Item")
    stop
    TNT1 A 0 A_PlaySoundEx("items/GanonYouDie2", "Item")
    stop
  }
}

actor YouWillDieShot : BasicFastProjectile {
  var int user_NoTranslation;
  Translation "192:192=176:176", "198:198=186:186"
  DamageType "YouDieUnit"
  Obituary "\"\cgYOU DIE!\c-\" %k said. And thus, %o died!"
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUGHOST
  Damage (0)
  Radius 5
  Height 5
  Speed 1000
  Scale 5.0
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:  // A_PlaySoundEx("items/YouDie","Weapon")
    TNT1 A 0 A_Jump(256, 1, 2)
    TNT1 A 0 A_PlaySoundEx("items/GanonYouDie1", "Item")
    goto Death2
    TNT1 A 0 A_PlaySoundEx("items/GanonYouDie2", "Item")
    goto Death2
   Death2:
    X_8B ABCDEF 2 A_Explode(850, 275, 1)
    stop
  }
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_YouDieUnit : BasicACSDamager {
  DamageType "YouDieUnit"
  Obituary "%o heard \"\cgYOU DIE!\c-\" while fighting %k."
}

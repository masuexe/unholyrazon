actor DrainRuneChecker_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PowerPeriwinkleDrain", 1, "P_Take1")
    goto PickupGive
   P_Take1:
    TNT1 A 0 A_TakeInventory("PowerPeriwinkleDrain")
    goto PickupGive
   PickupGive:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_runeplayer", 0, true, RUNE_DRAIN)
    stop
  }
}

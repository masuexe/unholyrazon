actor PeriwinkleTankItem : UnholyItem {
  Tag "$TAG_M_BOX01"
  inventory.pickupmessage "Get Hyped? Periwinkle Tank!"
  Inventory.Icon "MYSBOX01"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_MA B 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("items/GoldTank", "SoundSlot6")
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("PowerDrainRune", 1, "UseX2")
    TNT1 A 0 A_GiveInventory("PowerPeriwinkleDrain")
    goto UseX2
   UseX2:
    TNT1 A 0 A_GiveInventory("PowerPeriwinkleStrength")
    goto End
  }
}
actor AutoPeriwinkleTankItem : PeriwinkleTankItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoPeriwinkleTankItemSilent : AutoPeriwinkleTankItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor PeriwinkleTankItemFX : UnholyItemFX {
  States {
   Spawn:
    I_MA B 0
    goto Spawn2
  }
}


actor PeriwinkleStrengthGiver : BasicPowerupGiver {
  Powerup.Type "PowerPeriwinkleStrength"
}
actor PowerPeriwinkleStrength : PowerDamage {
  Powerup.Duration -30
  DamageFactor "Normal", 1.5
}

actor PeriwinkleDrainGiver : BasicPowerupGiver {
  Powerup.Type "PowerPeriwinkleDrain"
}
actor PowerPeriwinkleDrain : PowerDrain {
  powerup.color purple 0.30
  Powerup.Duration -15
}


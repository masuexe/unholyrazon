actor TheFootBallItem : UnholyItem
{
Tag "$TAG_M_BOX04"
inventory.pickupmessage "\csJOHN MADDEN!"
inventory.icon "MYSBOX04"
States
{
Spawn:
I_MA E 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("items/FOOTBALLTIME","Item")
UseX_Silent:
TNT1 A 0 A_FireCustomMissile("TheFootBallShot",0,0,0,0)
goto End
}
}

actor TheFootBallItemX : TheFootBallItem
{
+INVENTORY.KEEPDEPLETED
inventory.amount 1
inventory.maxamount 1
States
{
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/FOOTBALLTIME","Item")
TNT1 A 0 A_SpawnItemEx("TheFootBallX_Helper")
TNT1 A 0 A_FireCustomMissile("TheFootBallShot",0,0,0,0)
stop
}
}
actor AutoTheFootBallItem : TheFootBallItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
        goto UseX
    }
}
actor AutoTheFootBallItemSilent : AutoTheFootBallItem {
    States {
        Pickup:
        goto UseX_Silent
    }
}
actor TheFootBallItemFX : UnholyItemFX {
    States {
        Spawn:
            I_MA E 0
            goto Spawn2
    }
}

actor TheFootBallX_Helper : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAAA 7 A_JumpIf(CallACS("uh_PointerExists", 2)==0,"Death")
TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2)==0,"Death")
TNT1 A 2 A_GiveToTarget("TheFootBallItemX",1)
stop
}
}

actor TheFootBallShot : BasicProjectile
{
damagetype "Football"
Obituary "\csJOHN MADDEN! \c-(%k -> %o)"
+RIPPER
+THRUGHOST
+CANBOUNCEWATER
+SKYEXPLODE
+HEXENBOUNCE
WALLBOUNCEFACTOR 0.995
BOUNCEFACTOR 0.995
BounceCount 8
damage (2500)
Radius 14
Height 14
speed 45
scale 2.5
States
{
Spawn:
I_ME ABCDEFGHI 1 A_SpawnItemEx("TheFootBallShot2")
loop
}
}


actor TheFootBallShot2 : BasicProjectile
{
damagetype "Football"
Obituary "\csJOHN MADDEN! \c-(%k -> %o)"
+RIPPER
+THRUGHOST
+DONTSPLASH
+DONTBLAST
+DONTREFLECT
damage (999)
Radius 14
Height 14
States
{
Spawn:
TNT1 A 1
stop
}
}

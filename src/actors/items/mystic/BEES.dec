actor BEESItem : UnholyItem {
  Tag "$TAG_M_BOX06"
  inventory.amount 2
  inventory.pickupmessage "You found the \ckB\c-ig \ckE\c-xplosive \ckE\c-vil \ckS\c-eeker!"
  Inventory.Icon "MYSBOX06"
  States {
   Spawn:
    I_MA G 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Item")
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "UseX2")
    TNT1 A 0 A_FireCustomMissile("BEES_Shot", 0, 0, 8, 0)
    goto End
   UseX2:
    TNT1 A 0 A_FireCustomMissile("BEES_ShotB", 0, 0, 8, 0)
    goto End
  }
}

actor AutoBEESItem : BEESItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoBEESItemSilent : AutoBEESItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor BEESItemFX : UnholyItemFX {
  States {
   Spawn:
    I_MA G 0
    goto Spawn2
  }
}

actor BEES_Shot : BasicNoClassTranslationProjectile {
  Translation "192:192=229:229", "198:198=230:230"
  DamageType "BEESItem"
  Obituary "%o was stung by %k's \ckB\c-ig \ckE\c-xplosive \ckE\c-vil \ckS\c-eeker."
  +THRUGHOST
  +SKYEXPLODE
  +SEEKERMISSILE
  BounceType "Hexen"
  +SCREENSEEKER
  +CANBOUNCEWATER
  BounceCount 5
  ReactionTime 105
  Damage (250)
  Radius 5
  Height 5
  Speed 50
  Scale 3.5
  States {
   Spawn:
    I_MG AAAAAAAAAA 1 A_SeekerMissile(2, 14, SMF_LOOK, 55, 8)
    I_MG A 0 A_Countdown
    loop
   Death:
    TNT1 A 0 A_JumpIf(z - ceilingz == 0 - 5, "Ceiling")
    TNT1 A 0
    TNT1 AAAAAA 0 A_SpawnItemEx("BEES_Shot2", 0, 0, 8, random(-10, 10), random(-10, 10), random(0, 10), 0, 1)
    X_8B ABCDEF 2
    stop
   Ceiling:
    TNT1 A 0
    TNT1 AAAAAA 0 A_SpawnItemEx("BEES_Shot2", 0, 0, -8, random(-10, 10), random(-10, 10), random(0, 10), 0, 1)
    X_8B ABCDEF 2
    stop
  }
}

actor BEES_ShotB : BEES_Shot {
  DamageType "BEESItemB"
  States {
   Death:
    TNT1 A 0 A_JumpIf(z - ceilingz == 0 - 5, "Ceiling")
    TNT1 A 0
    TNT1 AAAAAA 0 A_SpawnItemEx("BEES_ShotB2", 0, 0, 8, random(-10, 10), random(-10, 10), random(0, 10), 0, 1)
    X_8B ABCDEF 2
    stop
   Ceiling:
    TNT1 A 0
    TNT1 AAAAAA 0 A_SpawnItemEx("BEES_ShotB2", 0, 0, -8, random(-10, 10), random(-10, 10), random(0, 10), 0, 1)
    X_8B ABCDEF 2
    stop
  }
}

actor BEES_Shot2 : BEES_Shot {
  Obituary "%o was stung by %k's \ckB. E. E. S.\c-"
  -SCREENSEEKER
  +THRUACTORS
  BounceCount 8
  ReactionTime 75
  Damage (50)
  Speed 30
  Scale 3.0
  States {
   Spawn:
    I_MG B 4
    I_MG B 14 A_ChangeFlag("THRUACTORS", 0)
    I_MG BBBBBBBBBB 1 A_SeekerMissile(2, 12, SMF_LOOK, 55, 5)
    I_MG B 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
    TNT1 A 0 A_Explode(100, 128, 0, 0, 8)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

actor BEES_ShotB2 : BEES_Shot2 {damagetype "BEESItemB"}

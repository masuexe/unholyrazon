actor MoneyBombItem : UnholyItem
{
Tag "$TAG_M_BOX14"
inventory.pickupmessage "We got to have... MONEY..."
inventory.icon "MYSBOX14"
States
{
Spawn:
I_MA K 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/MoneyUse","Item")
UseX_Silent:
TNT1 A 1 A_FireCustomMissile("MoneyBomb",0,0,0,0)
goto End
}
}

actor AutoMoneyBombItem : MoneyBombItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoMoneyBombItemSilent : AutoMoneyBombItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor MoneyBombItemFX : UnholyItemFX {
    States {
        Spawn:
            I_MA K 0
            goto Spawn2
    }
}

actor MoneyBombFX : BasicClientSide
{
Translation "198:198=112:112"
scale 1.5
Reactiontime 2
States
{
Spawn:
TNT1 A 1
I_BI C 35 A_CountDown
wait
Death:
I_BI C 5 A_SetTranslucent(0.75,1)
stop
}
}

actor MoneyBombFX_Helper : BasicClientSide
{
ReactionTime 40
States
{
Spawn:
TNT1 A 0
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("MoneyBombFX",random(-450,450),random(-450,450),random(-450,450))
TNT1 A 1 A_CountDown
loop
}
}

actor MoneyBombDamage : BasicExplosion
{
damagetype "MoneyBombCash"
Obituary "%o \cvlearned you shouldn't wish for a million \cqbucks!"
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(175,196,0,0,32)
stop
}
}

actor MoneyBomb : BasicProjectile
{
var int user_NoTranslation;
Translation "192:192=107:107","198:198=110:110","195:195=130:130"
PROJECTILE
damagetype "MoneyBombCash"
Obituary "%o \cvlearned you shouldn't wish for a million \cqbucks!"
BounceSound "items/MoneyUse"
-NOGRAVITY
+THRUGHOST
//+RIPPER
+SKYEXPLODE
//+HEXENBOUNCE
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
//-BOUNCEONACTORS
bouncefactor 0.725
wallbouncefactor 0.85
bouncecount 50
reactiontime 5
Damage (0)
Radius 6
Height 7
speed 38
scale 2.5
States
{
Spawn:
I_MP K 0
I_MP K 2 ThrustThingZ(0,12,0,1)
I_MP K 0 A_ClearTarget
I_MP K 40
I_BI K 2
I_MP K 20
I_BI K 2
I_MP K 10
I_BI K 2
I_MP K 5
I_BI K 2
I_MP K 4
I_BI K 2
I_MP K 3
I_BI K 2
SpawnL:
I_BI K 1
I_MP K 1 A_CountDown
loop
SpawnOld://ReactionTime 2
I_MP K 95 A_CountDown
wait
Death:
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("items/MoneyUse","Weapon")
TNT1 AAA 0 A_SpawnItemEx("MoneyBombDamage",0,0,8)
TNT1 A 0 A_SpawnItemEx("MoneyBombFX_Helper")
X_1D BCDEFGHIJKLMNBCDEFGHIJKLMNBCDEFGHIJKLMN 1 A_SpawnItemEx("MoneyBomb_MoolaB",0,0,16)
stop
}
}

Actor MoneyBomb_MoolaB : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(4,"Fox")
TNT1 A 0 A_Jump(12,"Rich")
TNT1 A 0 A_Jump(76,"Ghost","Quick")
TNT1 A 0 A_Jump(126,"Joust","Eyelento","Alien")
TNT1 A 0 A_Jump(198,"Tank","Business")
TNT1 A 0 A_Jump(255,"Kamikaze","Bomber")
goto Furry
Kamikaze:
TNT1 A 0 A_SpawnItemEx("Kamikaze_MoolaB")
stop
Bomber:TNT1 A 0 A_SpawnItemEx("Bomber_MoolaB")stop
Tank:TNT1 A 0 A_SpawnItemEx("Tank_MoolaB")stop
Business:TNT1 A 0 A_SpawnItemEx("Business_MoolaB")stop
Joust:TNT1 A 0 A_SpawnItemEx("Joust_MoolaB")stop
Eyelento:TNT1 A 0 A_SpawnItemEx("Eyelento_MoolaB")stop
Alien:TNT1 A 0 A_SpawnItemEx("Alien_MoolaB")stop
Ghost:TNT1 A 0 A_SpawnItemEx("Ghost_MoolaB")stop
Quick:TNT1 A 0 A_SpawnItemEx("Quick_MoolaB")stop
Rich:TNT1 A 0 A_SpawnItemEx("Rich_MoolaB")stop
Fox:TNT1 A 0 A_SpawnItemEx("Fox_MoolaB")stop
Furry:TNT1 A 0 A_SpawnItemEx("Furry_MoolaB")stop
}
}

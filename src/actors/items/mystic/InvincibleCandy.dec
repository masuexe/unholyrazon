actor InvincibleCandyItem : UnholyItem {
    Tag "$TAG_M_BOX13"
    inventory.pickupmessage "Heck yeah! Invincible Candy!"
    inventory.icon "MYSBOX13"
    States {
     Spawn:
      I_MA J 6
      loop
     UseX:
      TNT1 A 0
      TNT1 A 0
      TNT1 A 0 A_JumpIfInventory("PowerInvincibleCandy", 1, "UseX2")
      TNT1 A 0 A_SpawnItemEx("InvincibleCandySound")
      goto UseX_Do
     UseX_Silent:
      TNT1 A 0 A_JumpIfInventory("PowerInvincibleCandy", 1, "UseX2")
     UseX_Do:
      TNT1 A 0 A_GiveInventory("InvincibleCandyPowerGiver", 1)
      TNT1 A 1 A_SpawnItemEx("InvincibleCandy_H")
      goto End
     UseX2:
      TNT1 A 0 A_PlaySoundEx("KirbyNES/Hit_D", "Item")
      fail
    }
}

actor AutoInvincibleCandyItem : InvincibleCandyItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
     Pickup:
      goto UseX
    }
}
actor AutoInvincibleCandyItemSilent : AutoInvincibleCandyItem {
    States {
     Pickup:
      goto UseX_Silent
    }
}
actor InvincibleCandyItemFX : UnholyItemFX {
    States {
     Spawn:
      I_MA J 0
      goto Spawn2
    }
}

actor InvincibleCandyPowerGiver : BasicPowerupGiver {
    powerup.type "PowerInvincibleCandy"
}

actor PowerInvincibleCandy : PowerUp {
    powerup.duration 380
}

actor InvincibleCandySound : BasicSoundFollow {
    PainSound "items/candy"
    ReactionTime 380
}

actor InvincibleCandy_H : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", CallACS("core_getptrtid", 2)-999, true)
     SpawnLoop:
      TNT1 A 1 A_JumpIf(!CallACS("uh_PointerExists", 2), "SpawnEnd")
      TNT1 A 0 A_GiveToTarget("InvincibleCandy_P", 1)
      TNT1 A 0 A_JumpIfInTargetInventory("PowerInvincibleCandy", 1, "SpawnLoop")
      goto SpawnEnd
     SpawnEnd:
      TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", CallACS("core_getptrtid", 2)-999, false)
      TNT1 A 1 A_TakeFromTarget("PowerInvincibleCandy", 375)
      stop
    }
}

actor InvincibleCandy_P : CustomInventory {
    States {
     Pickup:
      TNT1 AAAA 0 A_SpawnItemEx("InvincibleCandyFX", random(-16, 16), random(-16, 16), 32, random(-10, 10), random(-10, 10), random(-5, 12))
      TNT1 A 0 A_SpawnItemEx("InvincibleCandyBoom", 0, 0, 28)
      stop
    }
}

actor InvincibleCandyBoom : BasicExplosion {
    Damagetype "InvincibleCandy"
    Obituary "%o stood in the way of %k's Invincible Candy Rampage."
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 A_JumpIfInventory("BAWS", 1, "Spawn2", 2)
      TNT1 A 1 A_Explode(49, 138, 0, 0, 16)
      stop
     Spawn2:
      TNT1 A 0 A_SetDamageType("InvincibleCandyB")
      goto Spawn+2
    }
}

actor InvincibleCandyFX {
    Translation "192:192=211:211", "198:198=222:222"
    PROJECTILE
    +THRUACTORS
    +DOOMBOUNCE
    +SKYEXPLODE
    +DONTSPLASH
    +CANBOUNCEWATER
    +CLIENTSIDEONLY
    +PAINLESS
    //renderstyle add
    Alpha 0.90
    damage (0)
    Radius 2
    Height 2
    speed 35
    Scale 1.0//0.5
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 A_Jump(256, "S_E", "S_F", "S_G", "S_H")
     S_E:
      6P0K EFGHEFGHEFGH 2 bright
      6P0K EEFFGGHH 1 bright A_FadeOut
      stop
     S_F:
      6P0K FGHEFGHEFGHE 2 bright
      6P0K FFGGHHEE 1 bright A_FadeOut
      stop
     S_G:
      6P0K GHEFGHEFGHEF 2 bright
      6P0K GGHHEEFF 1 bright A_FadeOut
      stop
     S_H:
      6P0K HEFGHEFGHEFG 2 bright
      6P0K HHEEFFGG 1 bright A_FadeOut
      stop
    }
}

Actor AssHatItem : UnholyItem
{
Tag "$TAG_M_BOX07"
inventory.amount 1
inventory.pickupmessage "\cgYou are worthy of the Ass-Hat!"
inventory.icon "MYSBOX07"
States
{
Spawn:
I_MA H 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("misc_L/itemthrow","Item")
UseX_Silent:
//A_SpawnItemEx is used due to A_FireCustomMissile not working on 'cliff' edges.
//2 = distance away, 20 = projectile speed
TNT1 A 0 A_SpawnItemEx("AssHatItemX",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*20,0,sin(-pitch)*20,0,32,0)
TNT1 A 0 //A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("AssHatItemX",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*20,0,sin(-pitch)*20,15,32,0)
TNT1 A 0 A_SpawnItemEx("AssHatItemX",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*20,0,sin(-pitch)*20,-15,32,0)
goto End
}
}

actor AutoAssHatItem : AssHatItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoAssHatItemSilent : AutoAssHatItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor AssHatItemFX : UnholyItemFX {
    States {
        Spawn:
            I_MA H 0
            goto Spawn2
    }
}

Actor AssHatItemX : BasicDroppedItem
{
Translation "192:192=4:4","198:198=176:176","195:195=95:95"
inventory.pickupmessage "\cgPicked up an Ass-Hat."
inventory.PickupSound "GNT/Treasure"//GNT/Treasure
-SPECIAL
+THRUACTORS
+NOBLOCKMONST
Speed 20
scale 2.5
States
{
Spawn:
TNT1 A 0
I_MP H 0 //A_SetAngle(random(0,11)*30)
I_MP H 0 ThrustThingZ(0,12,0,1)
I_MP H 0 A_GiveInventory("VivifyDelay10",1)
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn2")
I_MP H 0 A_ChangeFlag("THRUACTORS",0)
I_MP H 0 A_ChangeFlag("SPECIAL",1)
goto Spawn1
Spawn1:
I_MP H 1 A_SetAngle(angle+30)
I_MP H 0 A_JumpIf(momx==0||momz==0,"Spawn3")
loop
Spawn2:
I_MP H 1
I_MP H 0 A_JumpIfInventory("VivifyDelay10",1,"Spawn2")
goto Spawn3
Spawn3:
I_MP H 0 A_ChangeFlag("THRUACTORS",0)
I_MP H 0 A_ChangeFlag("SPECIAL",1)
I_MP H 350//10 seconds
I_MP H 0 A_GiveInventory("AssHatItemX_P",1)
stop
Pickup:
I_MP H 0 //A_JumpIfInventory("AssHatItem",99,"No")
I_MP H 0 A_GiveInventory("AssHatItem",1)
stop
No:
I_MP H 0
fail
}
}

actor AssHatItemX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Jump(1,"P_1")
TNT1 A 0 A_Jump(4,"P_4")
TNT1 A 0 A_Jump(16,"P_16")
TNT1 A 0 A_Jump(32,"P_32")
TNT1 A 0 A_Jump(64,"P_64")
TNT1 A 0 A_Jump(96,"P_96")
TNT1 A 0 A_Jump(128,"P_128")
TNT1 A 0 A_Jump(192,"P_192")
TNT1 A 0 A_Jump(256,"P_256")
stop
P_1:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_TG")
stop
P_4:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_MI")
stop
P_16:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BW")
stop
P_32:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BH2")
stop
P_64:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_TA")
stop
P_96:
TNT1 A 0 A_Jump(256,1,2)
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BY")
stop
TNT1 A 0 A_SpawnItemEx("AssHatItemX_ME")
stop
P_128:
TNT1 A 0 A_Jump(256,1,2)
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BB")
stop
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BR")
stop
P_192:
TNT1 A 0 A_Jump(256,1,2)
TNT1 A 0 A_SpawnItemEx("AssHatItemX_MA")
stop
TNT1 A 0 A_SpawnItemEx("AssHatItemX_MD")
stop
P_256:
TNT1 A 0 A_SpawnItemEx("AssHatItemX_BQ")
stop
TNT1 A 0 A_SpawnItemEx("AssHatItemX0")
stop
}
}

actor AssHatItemX_FX : BasicClientSide
{
States
{
Spawn:
TNT1 A 0
//X_1G EFGHINMLKJ 2
X_1G EKGMINHLFJ 2
stop
}
}

Actor AssHatItemX0 : AssHatItemX
{
Translation "192:192=4:4","198:198=176:176","195:195=95:95"
States
{
Spawn:
I_MP H 0
I_MP H 0 A_SpawnItemEx("AssHatItemFX",0,0,8,0,0,2)
goto Spawn2
Spawn2:
I_MP H 0 A_SpawnItemEx("AssHatItemX_FX",0,0,8,0,0,0,0,1)
goto Spawn3
Pickup:
I_MP H 0 A_GiveInventory("AssHatItem",1)
stop
}
}


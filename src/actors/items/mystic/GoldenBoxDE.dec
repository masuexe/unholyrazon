actor GoldenBoxDEItem : UnholyItem
{
Tag "$TAG_M_BOX08"
Translation "4:4=228:228","13:13=160:160","14:14=161:161","15:15=162:162"
inventory.pickupmessage "Golden-Box-Demoneye assist!"
inventory.icon "MYSBOX08"
states
{
Spawn:
I_BA H 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox","Item")
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("GoldenFriendlyBoxDE",56,0,38,1,0,0,0,32)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("GoldenFriendlyBoxDE_Spread",0,56,38,1,0,0,90,32)
TNT1 A 0 A_SpawnItemEx("GoldenFriendlyBoxDE_Spread",0,-56,38,1,0,0,270,32)
goto End
}
}

actor AutoGoldenBoxDEItem : GoldenBoxDEItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoGoldenBoxDEItemSilent : AutoGoldenBoxDEItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor GoldenBoxDEItemFX : UnholyItemFX {
    States {
        Spawn:
            I_BA H 0
            goto Spawn2
    }
}

actor GoldenFriendlyBoxDE : FriendlyBoxDE
{
Translation "192:192=160:16","198:198=161:161","199:199=162:162","204:204=160:160","195:195=161:161"

DropItem "AutoMysticBoxItem" 256 1
Health 625
painchance 96
Speed 10
States
{
Spawn:
I_BD N 0
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNN 1 A_Wander
I_BD N 0 A_JumpIfInventory("WeaponCharge",5,"DeathTimer")
I_BD N 0 A_GiveInventory("U_PSN",random(1,2))
I_BD N 0 A_JumpIfInventory("U_PSN",11,"Item")
I_BD N 0 A_Jump(32,"Spawn3")
I_BD N 0 A_Jump(64,"Spawn2")
I_BD N 0 A_Jump(128,"Spawn1")
loop
Spawn1:
I_BD N 0
goto Spawn+20
Spawn2:
I_BD N 0
goto Spawn+40
Spawn3:
I_BD N 0
goto Spawn+60
Item:
I_BD N 0 A_Stop
I_BD N 1 A_TakeInventory("U_PSN",13)
I_BD N 0 A_GiveInventory("WeaponCharge",1)
I_BD N 0 A_ChangeVelocity(0,0,10)
I_BD N 1 A_SpawnItemEx("MysticBoxEyeDrop")
I_BD N 0 A_Jump(16,"Spawn3")
I_BD N 0 A_Jump(32,"Spawn2")
I_BD N 0 A_Jump(64,"Spawn1")
Goto Spawn+1
Pain:
I_BD N 0 A_Pain
I_BD NNNNNNNNNN 2 A_SpawnItem("PainFX",0,3)
I_BD N 0 A_Jump(32,"Spawn3")
I_BD N 0 A_Jump(64,"Spawn2")
I_BD N 0 A_Jump(128,"Spawn1")
goto Spawn+1
DeathTimer:
I_BD N 0 A_ChangeFlag("INVULNERABLE",1)
I_BD N 0 A_ChangeFlag("DONTBLAST",1)
I_BD N 0 A_ChangeFlag("NOGRAVITY",1)
I_BD N 6 A_Stop
I_BD N 0 A_ChangeVelocity(0,0,9,3)
I_BD NNNNNNNNNN 1 A_FadeOut(0.1,0)
I_BD N 1 A_SpawnItemEx("GoldenBoxDEItem",0,0,0,0,0,7)
stop
}
}

actor GoldenFriendlyBoxDE_Spread : GoldenFriendlyBoxDE
{
States
{
DeathTimer:
I_BD N 0 A_ChangeFlag("INVULNERABLE",1)
I_BD N 0 A_ChangeFlag("DONTBLAST",1)
I_BD N 0 A_ChangeFlag("NOGRAVITY",1)
I_BD N 6 A_Stop
I_BD N 0 A_ChangeVelocity(0,0,9,3)
I_BD NNNNNNNNNN 1 A_FadeOut(0.1,0)
stop
}
}

actor ThumbtackTossX : BasicNoClassTranslationProjectile {
    damagetype "Thumbtack"
    Obituary "%o eternally suffers from stepping on %k's thumbtack."
    -NOGRAVITY
    +THRUGHOST
    +DONTBLAST
    +HITTRACER
    +BOUNCEONCEILINGS
    +DONTSPLASH
    +NOEXPLODEFLOOR
    +STEPMISSILE
    maxstepheight 24
    BounceCount 1
    BounceFactor 1.0
    WallBounceFactor 0.15
    gravity 1.0
    ReactionTime 72
    Damage (1250)
    Radius 16
    Height 16
    speed 20
    Scale 2.5
    States {
     Spawn:
      I_MP L 0
      I_MP L 0 A_PlaySoundEx("DuckHunt/Flap", "Weapon")
      I_MP L 300 A_CountDown
      wait
     XDeath:
     Crash:
      TNT1 A 2 A_GiveInventory("ThumbtackTossDeathCheck_P", 1, 8)
      stop
     Death:
      TNT1 A 1
      stop
    }
}


actor ThumbtackTossDeathCheck_P : CustomInventory
{//Morph fix?
    States {
     Pickup:
      TNT1 A 0 A_JumpIfInventory("IsDead", 1, 2)
      TNT1 A 0 A_SpawnItemEx("ThumbtackTossPain_H", 0, 0, 28, 0, 0, 0, 0, 32)
      stop
      TNT1 A 0 A_SpawnItemEx("ThumbtackTossDeath_H", 0, 0, 28, 0, 0, 0, 0, 32)
      stop
    }
}

actor ThumbtackTossPain_H : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 6 A_PlaySound("S3_K/Spikes", 1, 0.5)
      stop
    }
}

actor ThumbtackTossDeath_H : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 A_PlaySoundEx("Shin_1/Explode", "Weapon")
      TNT1 A 0 A_SpawnItemEx("CB_Item2PlatformFX1", 0, 0, -12, 0, 0, 5, 0, 0)
      TNT1 A 0 A_SpawnItemEx("CB_Item2PlatformFX2", 0, 6, -4, 0, 2.5f, 15, 0, 0)
      TNT1 A 0 A_SpawnItemEx("CB_Item2PlatformFX2", 0, -6, -4, 0, -2.5f, 15, 0, 0)
      TNT1 A 0 A_SpawnItemEx("CB_Item2PlatformFX2", 0, 10, -8, 0, 4.5f, 11, 0, 0)
      TNT1 A 0 A_SpawnItemEx("CB_Item2PlatformFX2", 0, -10, -8, 0, -4.5f, 11, 0, 0)
      TNT1 A 20
      stop
    }
}

actor WonderStoneItem : UnholyItem {
  Tag "$TAG_RZ_MBOX02"
  inventory.pickupmessage "Do you have four legs in the morning, two legs at noon, and three legs in the evening?"
  Inventory.Icon "RZMI_02"
  States {
   Spawn:
    I_RM C 6
    loop
   UseX:
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    TNT1 A 0 A_Jump(32, "X")
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 0)
    TNT1 A 0 A_SpawnItemEx("WonderStoneRed", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 1)
    TNT1 A 0 A_SpawnItemEx("WonderStoneBlue", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 2)
    TNT1 A 0 A_SpawnItemEx("WonderStoneYellow", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 3)
    TNT1 A 0 A_SpawnItemEx("WonderStoneGreen", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    goto End
   X:
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 4)
    TNT1 A 0 A_SpawnItemEx("WonderStoneX", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    goto End

   UseX2:
    TNT1 A 0 A_Jump(32, "XS")
    TNT1 A 0 A_Jump(256, 1, 5, 9, 13)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 0)
    TNT1 A 0 A_SpawnItemEx("WonderStoneRed", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneRed", 0, 56, 38, 1, 0, 0 /*frandom(-2,2)*/, 90, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneRed", 0, -56, 38, 1, 0, 0 /*frandom(-2,2)*/, 270, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 1)
    TNT1 A 0 A_SpawnItemEx("WonderStoneBlue", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneBlue", 0, 56, 38, 1, 0, 0 /*frandom(-2,2)*/, 90, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneBlue", 0, -56, 38, 1, 0, 0 /*frandom(-2,2)*/, 270, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 2)
    TNT1 A 0 A_SpawnItemEx("WonderStoneYellow", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneYellow", 0, 56, 38, 1, 0, 0 /*frandom(-2,2)*/, 90, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneYellow", 0, -56, 38, 1, 0, 0 /*frandom(-2,2)*/, 270, 32)
    goto End
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 3)
    TNT1 A 0 A_SpawnItemEx("WonderStoneGreen", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneGreen", 0, 56, 38, 1, 0, 0 /*frandom(-2,2)*/, 90, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneGreen", 0, -56, 38, 1, 0, 0 /*frandom(-2,2)*/, 270, 32)
    goto End
   XS:
    TNT1 A 0 ACS_NamedExecuteAlways("rz_WonderStoneNotice", 0, 4)
    TNT1 A 0 A_SpawnItemEx("WonderStoneX", 56, 0, 38, 1, 0, 0 /*frandom(-2,2)*/, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneX", 0, 56, 38, 1, 0, 0 /*frandom(-2,2)*/, 90, 32)
    TNT1 A 0 A_SpawnItemEx("WonderStoneX", 0, -56, 38, 1, 0, 0 /*frandom(-2,2)*/, 270, 32)

    goto End
  }
}

actor AutoWonderStoneItem : WonderStoneItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoWonderStoneItemSilent : AutoWonderStoneItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor WonderStoneItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RM C 0
    goto Spawn2
  }
}

actor WonderStoneRed : UH_ShootableItemActor {
  var int user_NoClassTranslation;
  // +CANPASS
  -ISMONSTER
  +FLOAT
  -COUNTKILL
  +SHOOTABLE
  +NOBLOOD
  -SOLID
  +DONTCORPSE
  +NOGRAVITY
  painsound "misc/devilpain"
  deathsound "misc/devildeath"
  Obituary "%o was in the tomb with \cgWonder Stone\c-."
  DropItem "WonderStoneTreasureRed" 256 1
  Health 3430
  Mass 500
  painchance 256

  Damage (0)
  Radius 53
  Height 100
  Speed 16
  FloatSpeed 16  // 8
  Scale 2.5
  States {
   Spawn:
    I2RC A 0
    I2RC ABCDE 1 A_Wander
    I2RC N 0 A_GiveInventory("U_PSN", random(1, 2))
    I2RC N 0 A_JumpIfInventory("U_PSN", 12, "Spam")
    loop
   Spam:
    I2RC A 0 A_TakeInventory("U_PSN", 12)
    I2RC A 0 A_CustomMissile("WonderStoneShot1", 58, 0, 0, 0)
    I2RC A 0 A_CustomMissile("WonderStoneShot2", 58, 0, 0, 0)
    I2RC A 0 A_CustomMissile("WonderStoneShot3", 58, 0, 0, 0)
    I2RC A 0 A_CustomMissile("WonderStoneShot4", 58, 0, 0, 0)
    goto Spawn
   Pain:
    I2RC A 0 A_Pain
    I2RC A 0 A_SpawnItem("PainFX", 0, 3)
    goto Spawn
   Death:
    I2RC A 0 A_Fall
    I2RC A 0 A_Stop
    I2RC A 0 A_Scream
    I2RC A 0  // A_DropItem("PandoraBoxItem",1)
    TNT1 A 0 A_CustomMissile("FakeDeathFX")
    TNT1 A 70
    stop
  }
}

actor WonderStoneBlue : WonderStoneRed {
  Obituary "%o was in the tomb with \cvWonder Stone\c-."
  DropItem "WonderStoneTreasureBlue" 256 1
  States {
   Spawn:
    I2RC F 0
    I2RC FGHIJ 1 A_Wander
    I2RC F 0 A_GiveInventory("U_PSN", random(1, 2))
    I2RC F 0 A_JumpIfInventory("U_PSN", 8, "Spam")
    loop
   Spam:
    I2RC F 0 A_TakeInventory("U_PSN", 8)
    I2RC F 0 A_PlaySoundEx("misc/devilfire", "weapon")
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, 22.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, 67.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, 112.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, 157.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, -157.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, -112.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, -67.5, 0)
    I2RC F 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, 0, -22.5, 0)
    goto Spawn
   Pain:
    I2RC F 0 A_Pain
    I2RC F 0 A_SpawnItem("PainFX", 0, 3)
    goto Spawn
  }
}
actor WonderStoneYellow : WonderStoneRed {
  Obituary "%o was in the tomb with \ckWonder Stone\c-."
  DropItem "WonderStoneTreasureYellow" 256 1
  States {
   Spawn:
    I2RC K 0
    I2RC KLMNO 1 A_Wander
    I2RC K 0 A_GiveInventory("U_PSN", random(1, 2))
    I2RC K 0 A_JumpIfInventory("U_PSN", 6, "Spam")
    loop
   Spam:
    I2RC K 0 A_TakeInventory("U_PSN", 6)
    I2RC K 0 A_PlaySoundEx("misc/devilfire", "weapon")
    I2RC K 0 A_CustomMissile("WonderStoneShot3", 58, 0, -15, 0)
    I2RC K 0 A_CustomMissile("WonderStoneShot3", 58, 0, -5, 0)
    I2RC K 0 A_CustomMissile("WonderStoneShot3", 58, 0, 5, 0)
    I2RC K 0 A_CustomMissile("WonderStoneShot3", 58, 0, 15, 0)
    goto Spawn
   Pain:
    I2RC K 0 A_Pain
    I2RC K 0 A_SpawnItem("PainFX", 0, 3)
    goto Spawn
  }
}
actor WonderStoneGreen : WonderStoneRed {
  Obituary "%o was in the tomb with \cdWonder Stone\c-."
  DropItem "WonderStoneTreasureGreen" 256 1
  States {
   Spawn:
    I2RC P 0
    I2RC PQRST 1 A_Wander
    I2RC P 0 A_Jump(240, "Spam")
    loop
   Spam:
    I2RC K 0 A_PlaySoundEx("misc/devilfire", "weapon")
    I2RC P 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, sin(random(0, 359)), random(0, 359), 0)
    I2RC P 0 A_Jump(64, "Spawn")
    I2RC P 0 A_SpawnItemEx("WonderStoneShot3", 0, 0, 38, 18, 0, sin(random(0, 359)), random(0, 359), 0)
    goto Spawn
   Pain:
    I2RC P 0 A_Pain
    I2RC P 0 A_SpawnItem("PainFX", 0, 3)
    goto Spawn
  }
}

const int WONDERSTONEDELAY = 5;

actor WonderStoneX : WonderStoneRed {
  Obituary "%o was in the tomb with \cgWonder Stone\c-."
  DropItem "WonderStoneTreasureX" 256 1
  Health 6370
  Damage (0)
  Radius 210
  Height 197
  States {
   Spawn:
    I3RC A 0
   WanderRed:
    I3RC F 0 A_TakeInventory("CutterFlag")
    I3RC A 0 A_SetArg(0, WONDERSTONEDELAY)

    I3RC A 0 A_JumpIf(args[0] <= 0, "WanderBlue")
    I3RC A 3 A_Wander
    I3RC A 0 A_GiveInventory("WonderStoneSpamRedX")
    I3RC B 3 A_Wander
    I3RC A 0 A_GiveInventory("WonderStoneSpamRedX")
    I3RC C 3 A_Wander
    I3RC A 0 A_GiveInventory("WonderStoneSpamRedX")
    I3RC D 3 A_Wander
    I3RC A 0 A_GiveInventory("WonderStoneSpamRedX")
    I3RC E 3 A_Wander
    I3RC A 0 A_GiveInventory("WonderStoneSpamRedX")
    I3RC A 0 A_SetArg(0, args[0] - 1)
    goto WanderRed+2

   WanderBlue:
    I3RC F 0 A_GiveInventory("CutterFlag", 1)
    I3RC A 0 A_SetArg(0, WONDERSTONEDELAY)

    I3RC A 0 A_JumpIf(args[0] <= 0, "WanderYellow")
    I3RC F 3 A_Wander
    I3RC F 0 A_GiveInventory("WonderStoneSpamBlueX")
    I3RC G 3 A_Wander
    I3RC G 0 A_GiveInventory("WonderStoneSpamBlueX")
    I3RC H 3 A_Wander
    I3RC H 0 A_GiveInventory("WonderStoneSpamBlueX")
    I3RC I 3 A_Wander
    I3RC I 0 A_GiveInventory("WonderStoneSpamBlueX")
    I3RC J 3 A_Wander
    I3RC J 0 A_GiveInventory("WonderStoneSpamBlueX")
    I3RC A 0 A_SetArg(0, args[0] - 1)
    goto WanderBlue+2

   WanderYellow:
    I3RC F 0 A_GiveInventory("CutterFlag", 1)
    I3RC A 0 A_SetArg(0, WONDERSTONEDELAY)

    I3RC K 0 A_JumpIf(args[0] <= 0, "WanderGreen")
    I3RC K 3 A_Wander
    I3RC L 0 A_GiveInventory("WonderStoneSpamYellowX")
    I3RC L 3 A_Wander
    I3RC M 0 A_GiveInventory("WonderStoneSpamYellowX")
    I3RC M 3 A_Wander
    I3RC N 0 A_GiveInventory("WonderStoneSpamYellowX")
    I3RC N 3 A_Wander
    I3RC O 0 A_GiveInventory("WonderStoneSpamYellowX")
    I3RC O 3 A_Wander
    I3RC J 0 A_GiveInventory("WonderStoneSpamYellowX")
    I3RC A 0 A_SetArg(0, args[0] - 1)
    goto WanderYellow+2

   WanderGreen:
    I3RC F 0 A_GiveInventory("CutterFlag", 1)
    I3RC A 0 A_SetArg(0, WONDERSTONEDELAY)

    I3RC P 0 A_JumpIf(args[0] <= 0, "WanderRed")
    I3RC P 3 A_Wander
    I3RC Q 0 A_GiveInventory("WonderStoneSpamGreenX")
    I3RC Q 3 A_Wander
    I3RC R 0 A_GiveInventory("WonderStoneSpamGreenX")
    I3RC R 3 A_Wander
    I3RC S 0 A_GiveInventory("WonderStoneSpamGreenX")
    I3RC S 3 A_Wander
    I3RC T 0 A_GiveInventory("WonderStoneSpamGreenX")
    I3RC T 3 A_Wander
    I3RC J 0 A_GiveInventory("WonderStoneSpamGreenX")
    I3RC A 0 A_SetArg(0, args[0] - 1)
    goto WanderGreen+2



   Pain:
    I3RC A 0 A_Pain
    I3RC A 0 A_SpawnItem("PainFX", 0, 3)
    I3RC A 0 A_JumpIfInventory("CutterFlag", 3, "WanderRed")
    I3RC A 0 A_JumpIfInventory("CutterFlag", 2, "WanderGreen")
    I3RC A 0 A_JumpIfInventory("CutterFlag", 1, "WanderYellow")
    goto WanderBlue
   Death:
    I3RC A 0 A_Fall
    I3RC A 0 A_Stop
    I3RC A 0 A_Scream
    I3RC A 0  // A_DropItem("PandoraBoxItem",1)
    TNT1 A 0 A_CustomMissile("FakeDeathFX")
    TNT1 A 70
    stop
  }
}


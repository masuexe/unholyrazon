actor WonderStoneShot1 : BasicNoClassTranslationProjectile {
  Damage (120)
  DamageType "WanderStone"
  Speed 6
  Scale 2.5
  Height 8
  Radius 8
  SeeSound "misc/devilfire"
  States {
   Spawn:
    BASB A 1
    loop
  }
}
actor WonderStoneShot2 : WonderStoneShot1 {Speed 12}
actor WonderStoneShot3 : WonderStoneShot1 {Speed 18}
actor WonderStoneShot4 : WonderStoneShot1 {Speed 24}
actor WonderStoneShot5 : WonderStoneShot1 {Speed 30}
actor WonderStoneShotX : WonderStoneShot1 {
  Damage (40)
  States {
   Spawn:
    BASB A 35  // 100 //175
    stop
  }
}

actor WonderStoneTreasureRed : BasicWatcher {
  ReactionTime 24
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(224, "RealReward")
    goto LoopEnd
   RealReward:
    TNT1 A 0 A_Jump(1, "Hell")
    TNT1 A 0 A_Jump(8, "SuperRare")
    TNT1 A 0 A_Jump(32, "Rare")
    goto Common

   Hell:
    TNT1 A 0 A_Jump(256, 1, 2, 3)
    TNT1 A 0 A_SpawnItemEx("AirStrikeItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd
    TNT1 A 0 A_SpawnItemEx("UnholyBookItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd
    TNT1 A 0 A_SpawnItemEx("WishingStarXItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd

   SuperRare:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    TNT1 A 0 A_SpawnItemEx("GUHUItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd
    TNT1 A 0 A_SpawnItemEx("SuperGUHUItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd
    TNT1 A 0 A_SpawnItemEx("YouWillDieItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd
    TNT1 A 0 A_SpawnItemEx("UnholyInsuranceItem", 0, 0, 0, random(-4, 4), random(-4, 4), random(8, 12), random(0, 359))
    goto LoopEnd

   Rare:
    TNT1 A 0 A_Jump(256, 1, 2)

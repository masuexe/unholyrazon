Actor MysticBoxItem : BasicDroppedItem
{
Tag "$TAG_M_BOX00"
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cfMystery Awaits...!"
inventory.icon "MYSBOX00"
Inventory.PickupSound "items/UnholyPickup"//"item/1up"
+INVBAR
states
{
Spawn:
I_MA A 6
loop
Use:
UseX:
TNT1 A 0 A_PlaySoundEx("items/MysticItemUse","SoundSlot5")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity",1,"UseProsperity")

TNT1 A 0 A_Jump(1,"Rare1")
TNT1 A 0 A_Jump(4,"Rare4")
TNT1 A 0 A_Jump(8,"Rare8")
TNT1 A 0 A_Jump(16,"Rare16")
TNT1 A 0 A_Jump(24,"Rare24")
TNT1 A 0 A_Jump(48,"Rare48")
TNT1 A 0 A_Jump(64,"Rare64")
TNT1 A 0 A_Jump(80,"Rare80")
TNT1 A 0 A_Jump(96,"Rare96")
TNT1 A 0 A_Jump(128,"Rare128")
TNT1 A 0 A_Jump(192,"Rare192")
TNT1 A 0 A_Jump(248,"Rare248")
TNT1 A 0 A_Jump(256,"Rare0")
stop
UseProsperity:
TNT1 A 0 A_Jump(4,"Rare1")
TNT1 A 0 A_Jump(16,"Rare4")
TNT1 A 0 A_Jump(32,"Rare8")
TNT1 A 0 A_Jump(48,"Rare16")
TNT1 A 0 A_Jump(60,"Rare24")
TNT1 A 0 A_Jump(80,"Rare48")
TNT1 A 0 A_Jump(112,"Rare64")
TNT1 A 0 A_Jump(144,"Rare80")
TNT1 A 0 A_Jump(176,"Rare96")
TNT1 A 0 A_Jump(208,"Rare128","Rare192")
TNT1 A 0 A_Jump(240,"Rare248")
TNT1 A 0 A_Jump(256,"Rare0")
stop

Rare0:
TNT1 A 0 A_PlaySoundEx("items/GoldSadness","SoundSlot6")
TNT1 A 0 A_GiveInventory("PandoraBoxItem",3)
stop

Rare1:
TNT1 A 0 A_Jump(256,1,2,3)
TNT1 A 0 A_GiveInventory("WishingStarItem",1)
stop
TNT1 A 0 A_GiveInventory("WishingStarXItem",1)
stop
TNT1 A 0 A_GiveInventory("WishingStarCItem",1)
stop

// Rare4:
// TNT1 A 0 A_Jump(256,1,2)
// TNT1 A 0 A_GiveInventory("GoldenBoxDEItem",1)
// stop
// TNT1 A 0 A_GiveInventory("GoldenKillerBoxDEItem",1)
// stop
// Rare8:
// TNT1 A 0 A_Jump(256,1,2)
// TNT1 A 0 A_GiveInventory("YouWillDieItem",1)
// stop
// TNT1 A 0 A_GiveInventory("HackyCoffeeItem",1)
// stop
// Rare16:
// TNT1 A 0 A_GiveInventory("SuperGUHUItem",1)
// stop
// Rare24:
// TNT1 A 0 A_GiveInventory("InvincibleCandyItem",1)
// stop
// Rare48:
// TNT1 A 0 A_GiveInventory("TheFootBallItem",1)
// stop
// Rare64:
// TNT1 A 0 A_GiveInventory("BEESItem",2)
// stop
// Rare80:
// TNT1 A 0 A_GiveInventory("TankOfWondersItem",1)
// stop
// Rare96:
// TNT1 A 0 A_GiveInventory("MoneyBombItem",1)
// stop
// Rare128:
// TNT1 A 0 A_GiveInventory("AssHatItem",1)
// stop
// Rare192:
// TNT1 A 0 A_GiveInventory("ThumbtackItem",2)
// stop
Rare248:
TNT1 A 0 A_GiveInventory("PeriwinkleTankItem",1)
stop

}
}

actor AutoMysticBoxItem : MysticBoxItem
{
Translation "228:228=4:4","231:231=160:160"
inventory.maxamount 0
inventory.pickupmessage "\cfAutomatic Mystic Box!"
Inventory.PickupSound ""
-INVENTORY.INVBAR
+INVENTORY.ALWAYSPICKUP
States
{
Pickup:
goto UseX
}
}
actor AutoMysticBoxItemSilent : AutoMysticBoxItem
{
States
{
Pickup:
goto UseX_Silent
}
}
actor MysticBoxItemFX : UnholyItemFX {
    States {
        Spawn:
            I_MA A 0
            goto Spawn2
    }
}


actor MysticBoxEyeDrop : BasicHelper
{
States
{
Spawn:
TNT1 A 1
TNT1 A 0
TNT1 A 0 A_Jump(56,"SpeedUpBox")
goto Spawn2
SpeedUpBox:
TNT1 A 0 A_GiveToTarget("U_PSN",random(1,4))
Goto Spawn2

Spawn2:
TNT1 A 0 A_Jump(1,"DuplicateBox")
TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox","SoundSlot5")
TNT1 A 0 A_Jump(1,"Rare1")

TNT1 A 0 A_Jump(1,"Rare1")

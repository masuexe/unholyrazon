Actor MysticBoxItem : BasicDroppedItem {
    Tag "$TAG_M_BOX00"
    inventory.amount 1
    inventory.maxamount 99
    inventory.pickupmessage "\cfMystery Awaits...!"
    inventory.icon "MYSBOX00"
    Inventory.PickupSound "items/UnholyPickup"//"item/1up"
    +INVBAR
    states {
     Spawn:
      I_MA A 6
      loop
     Use:
     UseX:
      TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity", 1, "UseProsperity")
      TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 37, 0, 0)
      stop
     UseX_Silent:
      TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity", 1, "UseProsperitySilent")
      TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 37, 0, 1)
      stop
     UseProsperity:
      TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 37, 1, 0)
      stop
     UseProsperitySilent:
      TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 37, 1, 1)
      stop
    }
}

actor AutoMysticBoxItem : MysticBoxItem {
    Translation "228:228=4:4", "231:231=160:160"
    inventory.maxamount 0
    inventory.pickupmessage "\cfAutomatic Mystic Box!"
    Inventory.PickupSound ""
    -INVENTORY.INVBAR
    +INVENTORY.ALWAYSPICKUP
    States {
     Pickup:
      goto UseX
    }
}
actor AutoMysticBoxItemSilent : AutoMysticBoxItem {
    States {
     Pickup:
      goto UseX_Silent
    }
}
actor MysticBoxItemFX : UnholyItemFX {
    States {
     Spawn:
      I_MA A 0
      goto Spawn2
    }
}


actor MysticBoxEyeDrop : BasicWatcher {
    States {
     Spawn:
      TNT1 A 1
      TNT1 A 0
      TNT1 A 0 A_Jump(56, "SpeedUpBox")
      goto Spawn2
     SpeedUpBox:
      TNT1 A 0 A_GiveToTarget("U_PSN", random(1, 4))
      Goto Spawn2

     Spawn2:
      TNT1 A 0 A_Jump(1, "DuplicateBox")
      TNT1 A 0 ACS_NamedExecuteWithResult("uh_SpawnRandomBoxItem", 37)
      stop

     DuplicateBox:
      TNT1 A 0 A_PlaySoundEx("GNT/Invun", "SoundSlot7")
      TNT1 A 0 A_Jump(256, 1, 2)
      TNT1 A 2 A_SpawnItemEx("GoldenKillerBoxDE")
      stop
      TNT1 A 2 A_SpawnItemEx("GoldenFriendlyBoxDE")
      stop
    }
}

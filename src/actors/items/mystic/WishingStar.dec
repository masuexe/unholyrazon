goto UseX1
UseX1:
TNT1 A 0 A_JumpIfInventory("PowerInvUseAll_F",1,"UseX2")
TNT1 A 0 A_GiveInventory("PowerInvUseAll_F")
TNT1 A 0 ACS_NamedExecuteAlways("uh_WishingStar", 0,0,1)
TNT1 A 0 A_SpawnItemEx("WishingStar_Help2")
TNT1 A 0 A_SpawnItemEx("WishingStarShot",0,0,32)
TNT1 A 0
goto End
}
}

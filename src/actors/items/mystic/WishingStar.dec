actor SonicExeWishing_H : BasicHelper
{
var int user_D;
RenderStyle "None"
ReactionTime 35
States
{
Spawn:
TNT1 A 0
TNT1 A 5 A_SpawnItemEx("OrdinarySonicExe_Wait",128,0,8)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 5 A_JumpIf(!CallACS("uh_PointerExists", 2), "D_Spec")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "D_Spec")
TNT1 A 5
TNT1 A 0 A_GiveToTarget("OrdinarySonicExe_Warper_P",1)
goto Spawn1
Spawn1:
TNT1 AA 6 A_JumpIf(!CallACS("uh_PointerExists", 2), "D_Spec")
TNT1 A 0 A_CountDown
loop
Death:
TNT1 A 0 A_GiveToTarget("SonicExeWishingScare_P",1)
TNT1 A 10
stop
D_Spec:
TNT1 A 0 A_GiveToTarget("SonicExeWishingScareSpec_P",1)
TNT1 A 10
stop
}
}

actor OrdinarySonicExe_Wait : BasicClientSide
{
Scale 1.0
ReactionTime 4
States
{
Spawn:
I_MI S 9
I_MI STUTSTUTS 4
I_MI S 60
I_MI S 0 A_CountDown
loop
Death:
I_MI S 0
I_MI S 1 A_FadeOut(0.15)
wait
}
}

actor OrdinarySonicExe_Warper_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("OrdinarySonicExe_Warper",436,0,32)
stop
}
}
actor OrdinarySonicExe_Warper : BasicShieldWarper
{
var int user_D;
ReactionTime 35
Scale 1.0
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper",0,0)
Goto SpawnL+1
SpawnL:
I_MI V 0 Radius_Quake(4-ReactionTime*0.2,13,0,5,0)
I_MI V 1 A_Warp(2,436-user_D,0,32,0,24)
I_MI V 1 A_Warp(2,435-user_D,0,32,0,24)
I_MI V 1 A_Warp(2,434-user_D,0,32,0,24)
I_MI V 1 A_Warp(2,433-user_D,0,32,0,24)
I_MI V 1 A_Warp(2,432-user_D,0,32,0,24)
I_MI V 1 A_Warp(2,431-user_D,0,32,0,24)
I_MI W 0 A_SetUserVar("user_D",user_D+6)
I_MI W 1 A_Warp(2,436-user_D,0,32,0,24)
I_MI W 1 A_Warp(2,435-user_D,0,32,0,24)
I_MI W 1 A_Warp(2,434-user_D,0,32,0,24)
I_MI W 1 A_Warp(2,433-user_D,0,32,0,24)
I_MI W 1 A_Warp(2,432-user_D,0,32,0,24)
I_MI W 1 A_Warp(2,431-user_D,0,32,0,24)
I_MI V 0 A_CountDown
I_MI V 0 A_SetUserVar("user_D",user_D+6)
I_MI V 0 A_JumpIf(ReactionTime<25,"SpawnL")
Goto SpawnL+1
}
}

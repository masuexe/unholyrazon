}


actor WishingStar_Help2 : WishingStar_Help
{
Translation "0:255=191:191"
Obituary "%o couldn't escape."
States
{
Death:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death2")
TNT1 A 0 A_JumpIfInventory("Once",1,"Death2")
TNT1 A 1500 ACS_NamedExecuteAlways("uh_WishingStar", 0,6)
stop
}
}


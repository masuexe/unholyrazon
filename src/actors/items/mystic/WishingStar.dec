actor WishingStarItem : UnholyItem
{
Tag "$TAG_M_BOX10"
inventory.amount 1
inventory.maxamount 10
inventory.pickupmessage "\ctMake a wish!"
inventory.icon "MYSBOX10"
States
{
Spawn:
I_MA I 6
loop
UseX:
UseX_Silent:
TNT1 A 0 A_JumpIf(CallACS("uh_WishingStar", -1), "UseX2")
goto UseX1
UseX1:
TNT1 A 0 A_JumpIfInventory("PowerInvUseAll_F",1,"UseX2")
TNT1 A 0 A_GiveInventory("PowerInvUseAll_F")
TNT1 A 0 ACS_NamedExecuteAlways("uh_WishingStar",0,0,0)
TNT1 A 0 A_SpawnItemEx("WishingStar_Help")
TNT1 A 0 A_SpawnItemEx("WishingStarShot",0,0,32)
goto End
UseX2:
TNT1 A 0 A_PlaySoundEx("GNT/FailUse","Item")
fail
}
}
actor AutoWishingStarItem : WishingStarItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoWishingStarItemSilent : AutoWishingStarItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor WishingStarItemFX : UnholyItemFX {
    States {
        Spawn:
            I_MA I 0
            goto Spawn2
    }
}

actor WishingStar_Help
{
var int user_TID;
Translation "0:255=160:160"
Damagetype "WishingStar"
Obituary "%o realized the meaning of Critical Existence Failure."
-SOLID
+NOGRAVITY
+NOINTERACTION
ReactionTime 26
scale 2.5
States
{
Spawn:
MMFX A 0
MMFX A 0 A_SetUserVar("user_TID", CallACS("core_gettarget"))
MMFX A 2 A_CountDown
TNT1 A 2 A_ChangeVelocity(0,0,2)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "SpawnNo")
Goto Spawn+2
SpawnNo:
MMFX A 0 A_GiveInventory("Once",1)
MMFX A 2 A_CountDown
TNT1 A 2 A_ChangeVelocity(0,0,2)
goto SpawnNo+1
Death:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death2")
TNT1 A 0 A_JumpIfInventory("Once",1,"Death2")
TNT1 A 35 ACS_NamedExecuteAlways("uh_WishingStar", 0,1,user_TID)
stop
Death2:
TNT1 A 35 ACS_NamedExecuteAlways("uh_WishingStar", 0,66,0)
stop
}
}

actor WishingStarShot : BasicProjectile
{
Translation "192:192=62:62","198:198=63:63"
Damagetype "WishingStar"
Obituary "%o tried to stop %k's wish from happening!"
+RIPPER
Damage (9999)
Radius 16
Height 16
States
{
Spawn:
X_5E C 0
X_5E C 2
X_5E D 2 A_ChangeVelocity(0,0,2)
X_5E E 2
X_5E F 2 A_ChangeVelocity(0,0,2)
Goto Spawn+1
}
}

actor WishingStarXItem : WishingStarItem
{
Tag "$TAG_M_BOX11"
Translation "62:62=63:63","8:8=191:191"
inventory.pickupmessage "\crMake a wish!"
inventory.icon "MYSBOX11"
States
{
UseX:
TNT1 A 0

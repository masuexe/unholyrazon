actor SurvivorBoxItems_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(random(1, 100) <= 2, "P_Wonder")
TNT1 A 0 A_JumpIf(random(1, 100) <= 12, "P_Mystic")
TNT1 A 0 A_JumpIf(random(1, 100) <= 99, "P_Pandora")
goto P_Unlucky
P_Wonder:
TNT1 A 0 A_GiveInventory("TankOfWondersItem",1)
stop
P_Mystic:
TNT1 A 0 A_GiveInventory("MysticBoxItem",1)
stop
P_Pandora:
TNT1 A 0 A_GiveInventory("PandoraBoxItem",3)
stop
P_Unlucky:
TNT1 A 0 A_PlaySoundEx("misc/HonkHonk64","Weapon")
TNT1 A 0 A_GiveInventory("AutoMysticBoxItemSilent",1)
TNT1 A 0 A_GiveInventory("AutoPandoraBoxItemSilent",1)
stop
}
}

actor DropItemsOnDeath_P : CustomInventory
{
states
{
Pickup:
//TNT1 A 0 A_PlaySoundEx("EDDYTHING","Weapon")

TNT1 A 0 A_JumpIfInventory("SpawnTeleFragFlag",1,"TheEnd")
TNT1 A 0 A_JumpIfInventory("UnholyItem",1,"TheEnd")
TNT1 A 0 ACS_NamedExecuteAlways("UH_DropItemsOnDeath",0)//ACS of A_DropItem + A_TakeInventory
goto TheEnd

//TNT1 A 0 A_DropInventory("FagCapItem")
//TNT1 AAAAA 0 A_DropInventory("PandoraBoxItem")//Works but requires multiple calls
//TNT1 A 0 A_DropInventory("PandoraBoxItem",99)//Does not work yet
//TNT1 A 0 A_DropItem("PandoraBoxItem",9999)//Works, but ALWAYS drops X amount (9999)
goto TheEnd

TheEnd:
TNT1 A 0
TNT1 A 0
stop
}
}

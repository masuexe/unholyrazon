actor InfiniteItemTesting_F : UOnceX{}

Actor PowerInvUseAll_F : PowerUp
{//Prevents InvUseAll from using items at the same time (WishingStar)
Powerup.Duration 2
}

Actor BasicDroppedItem : CustomInventory
{
+DONTGIB
scale 2.0
}

Actor UnholyItem : BasicDroppedItem
{
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cdSuddenly Placeholder!"
inventory.icon "C_I_00D"
inventory.PickupSound "items/UnholyPickup"//"item/1up"
Inventory.UseSound ""
+INVBAR
states
{
Spawn:
6N00 D 5
loop
Use:
TNT1 A 0
TNT1 A 0 //A_LOG("Use")
TNT1 A 0 A_JumpIfInventory("UsingTimeStopperU",1,"TimeStop")
TNT1 A 0 A_JumpIf(1,"UseX")
TNT1 A 0 A_JumpIf(1,"UseX")//But why?
TNT1 A 0 A_JumpIf(1,"UseX")
TNT1 A 0 A_JumpIf(1,"UseX")
TNT1 A 0 A_JumpIf(1,"UseX")
goto UseX
UseX://Wierd note, for online, both Use/UseX are displayed for clients but only Use is shown for the server.
TNT1 A 0 //A_LOG("UseX")
stop
End:
TNT1 A 0 A_JumpIfInventory("InfiniteItemTesting_F",1,"TimeStop")
stop
TimeStop:
TNT1 A 0
fail
}
}



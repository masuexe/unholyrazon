actor LoliPornPicItem : UnholyItem {
  Tag "Loli porn picture"
  inventory.pickupmessage "You found Mihato porn picture!"
  inventory.icon "MHTPIC"
  states {
   Spawn:
    8P91 A 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("GNT/FailUse", "Item")
    fail
   UseX_Silent:
    TNT1 A 0
    fail
  }
}

actor AutoLoliPornPicItem : LoliPornPicItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoLoliPornPicItemSilent : AutoLoliPornPicItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor LoliPornPicItemFX : UnholyItemFX {
  States {
   Spawn:
    8P91 A 0
    goto Spawn2
  }
}

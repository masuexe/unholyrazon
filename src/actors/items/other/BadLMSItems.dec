// LMS event 12 / Bad LMS support actors.
actor DeleteThisItem : UnholyItem {
  Tag "No Data"
  inventory.pickupmessage "ERROR: Item not found"
  Inventory.Icon "C_I_00D"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_BA H 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Item")
    TNT1 A 0 A_SpawnItemEx("DeleteThisHelper")
    goto End
  }
}

// Legacy Invalid LMS reward: each use triggers 1-3 random item effects.
// Keep the pool limited to effects available in this version.
actor DeleteThisHelper : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(0, random(0, 2))
   Roll:
    TNT1 A 0 A_GiveToTarget("DeleteThisRandom_P")
    TNT1 A 1 A_CountdownArg(0, "Death")
    loop
   Death:
    TNT1 A 0
    stop
  }
}


actor PowerLMSDarkness : Powerup {
  powerup.color 0 0 0 0.85
  powerup.duration 0x7ffffffd
}

actor HorseMorphGiver : BasicPowerupGiver {
  Powerup.Type "PowerHorseMorph"
}

actor PowerHorseMorph : PowerMorph {
  PowerMorph.MorphFlash ""
  PowerMorph.PlayerClass "WeakHorse"
  PowerMorph.UnMorphFlash ""
  Powerup.Duration 0x7ffffffd
  PowerMorph.MorphStyle MRF_ADDSTAMINA | MRF_FULLHEALTH | MRF_LOSEACTUALWEAPON | MRF_NEWTIDBEHAVIOUR | MRF_UNDOBYDEATH | MRF_UNDOBYDEATHFORCED
}

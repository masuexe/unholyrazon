// LMS event 12 / Bad LMS support actors.
actor DeleteThisItem : UnholyItem {
  Tag "No Data"
  inventory.pickupmessage "ERROR: Item not found"
  inventory.icon "C_I_00D"
  States {
   Spawn:
    I_BA H 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Item")
    TNT1 A 0 A_GiveInventory("DeleteThisRandom_P", 1)
    stop
  }
}

actor DeleteThisRandom_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "A", "B", "C")
   A:
    TNT1 A 0 A_GiveInventory("ChanceBoxItem", 1)
    stop
   B:
    TNT1 A 0 A_GiveInventory("PandoraBoxItem", 1)
    stop
   C:
    TNT1 A 0 A_GiveInventory("MysticBoxItem", 1)
    stop
  }
}

actor PowerLMSBadProtection : PowerProtection {
  Powerup.Duration 0x7FFFFFFC
  DamageFactor "Normal", 4.0
}

actor BadEventBossProtection : PowerProtection {
  Powerup.Duration 0x7FFFFFFC
  DamageFactor "Normal", 0.25
}

actor InfiniteRocketItem : UnholyItem {
  +INVENTORY.KEEPDEPLETED
  inventory.pickupmessage "Support item! Infinite Rocket!"
  inventory.icon "C_I_00D"
  States {
   Spawn:
    I_BA U 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Item")
    TNT1 A 0 A_SpawnItemEx("InfiniteRocket_Helper")
    TNT1 A 0 A_FireCustomMissile("BluntRocketB", 0, 0, 0, 0)
    stop
  }
}

actor InfiniteRocket_Helper : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 2 A_GiveToTarget("InfiniteRocketItem", 1)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor InfiniteRubberBandItem : UnholyItem {
  +INVENTORY.KEEPDEPLETED
  inventory.pickupmessage "PREE-PAIR-2-DEI!"
  inventory.icon "C_I_00D"
  States {
   Spawn:
    I_BA R 6
    loop
   UseX:
    TNT1 A 0 A_SpawnItemEx("InfiniteRubberBand_Helper")
    TNT1 A 0 A_FireCustomMissile("Rubberband", 0, 0, 0, 0)
    stop
  }
}

actor InfiniteRubberBand_Helper : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAA 7 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 2 A_GiveToTarget("InfiniteRubberBandItem", 1)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor LMSBadGuyAppears_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 45, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 90, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 135, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 180, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 225, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 270, 0)
    TNT1 A 0 A_SpawnItemEx("BoxDE_MinivileHidden", 96, 0, 0, 0, 0, 0, 315, 0)
    stop
  }
}

actor PowerLMSDarkness : Powerup {
  powerup.color 0 0 0 0.85
  powerup.duration 0x7FFFFFFD
}

actor HorseMorphGiver : BasicPowerupGiver {
  Powerup.Type "PowerHorseMorph"
}

Actor PowerHorseMorph : PowerMorph {
  PowerMorph.MorphFlash ""
  PowerMorph.PlayerClass "WeakHorse"
  PowerMorph.UnMorphFlash ""
  Powerup.Duration 0x7FFFFFFC
  PowerMorph.MorphStyle (MRF_ADDSTAMINA|MRF_FULLHEALTH|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR|MRF_UNDOBYDEATH|MRF_UNDOBYDEATHFORCED)
}

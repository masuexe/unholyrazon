// Specialized Items here.
actor MistressCopyVisedBoxItem : BasicDroppedItem {
  Tag "$TAG_TBM_BOX00"
  Inventory.MaxAmount 99
  inventory.pickupmessage "\cqWe have the technology!"
  Inventory.Icon "SAXFUG1"
  Inventory.PickupSound "item/1up"
  +INVBAR
  +COUNTITEM
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    SAX2 A 6
    loop
   Use:
   UseX:
    TNT1 A 0 A_PlaySoundEx("items/PandoraItemUse", "SoundSlot5")
   UseX_Silent:
    TNT1 A 0 A_Jump(24, "BoxEXTREMEHEALING")
    TNT1 A 0 A_Jump(64, "BoxGUHU")
    TNT1 A 0 A_Jump(94, "BoxPOTION")
    TNT1 A 0 A_Jump(168, "BoxBIGFIST")
    TNT1 A 0 A_Jump(256, "BoxSOURET")
    stop
   BoxBIGFIST:
    TNT1 A 0 A_GiveInventory("MistressBoxTimeFist", 2)
    stop
   BoxSOURET:
    TNT1 A 0 A_GiveInventory("MistressBoxSouret", 3)
    stop
   BoxEXTREMEHEALING:
    TNT1 A 0 A_GiveInventory("MistressBoxRegen", 2)
    stop
   BoxPOTION:
    TNT1 A 0 A_GiveInventory("MistressBoxPotion", 1)
    stop
   BoxGUHU:
    TNT1 A 0 A_GiveInventory("MistressBoxGUHU", 1)
    stop
  }
}

actor AutoMistressCopyVisedBoxItem : MistressCopyVisedBoxItem {
  Translation "120:120=84:84", "124:124=4:4" Inventory.MaxAmount 0
  Inventory.PickupSound ""
  -INVENTORY.INVBAR
  +INVENTORY.ALWAYSPICKUP
  States {
   Pickup:
    goto Use
  }
}
actor AutoMistressCopyVisedBoxItemSilent : AutoMistressCopyVisedBoxItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor MistressCopyVisedBoxItemFX : UnholyItemFX {
  States {
   Spawn:
    SAX2 A 0
    goto Spawn2
  }
}

actor MistressBoxTimeFist : UnholyItem {
  Tag "$TAG_TBM_BOX01"
  inventory.amount 2 Inventory.MaxAmount 99
  inventory.pickupmessage "POWA-FISTA!!"
  Inventory.Icon "SAXFUG6"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    SAX2 F 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("weapon/cfire", "Item")
   UseX_Silent:
    TNT1 A 1 A_FireCustomMissile("MistressGigaFist", 0, 0, 8, 0)
    goto End
  }
}


actor MistressFalseSuicidalExplosion : BasicExplosion
{
Translation "198:198=120:120", "192:192=116:116"
Damagetype "TrueMistressHell"
Obituary "%o didn't know that holograms were realistic."
RenderStyle "Translucent"
Alpha 0.8
Scale 7.5
States
{
Spawn:
X_8B A 0
X_8B A 0 A_playSoundEx("S_Spin/Explode","Weapon")
X_8B A 0 A_Explode(2500,250,0,0,16)
X_8B ABCDEF 2
stop
}
}

actor TrueMistressCopyVisionEX : BasicProjectile
{
Translation "192:192=120:120", "198:198=127:127"
Damagetype "BossTimeStop"
Obituary "%o fell in love with \cmTrue \cuBusterMistress\c- (%k)'s Double."
-NOGRAVITY
+DONTBLAST
+THRUGHOST
Bouncetype Classic
-BOUNCEONWALLS
-BOUNCEONFLOORS
-BOUNCEONCEILINGS
-ALLOWBOUNCEONACTORS
+DONTSPLASH
+NOEXPLODEFLOOR
+STEPMISSILE
maxstepheight 24
BounceFactor 1.0
WallBounceFactor 0.0
gravity 1.0
Damage (125)
Radius 32
Height 56
speed 19
Scale 2.5
States
{
Spawn:
8A25 B 0
8A25 B 0 A_ChangeVelocity(19,0,0,3)
8A25 B 1 A_GiveInventory("ResyncPickup",1)
8A25 BCDE 5
Goto Spawn+3
Crash:
XDeath:
TNT1 A 0
TNT1 A 0 ThrustThingZ(0,45,0,0)
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTWind",0,0,30,0,0,0)
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTATTACK",0,0,30,0,0,0)
8A25 FF 1 A_SetAngle(angle-45.0)
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTATTACK",0,0,30,0,0,0)
8A25 FF 1 A_SetAngle(angle-45.0)
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTATTACK",0,0,30,0,0,0)
8A25 FF 1 A_SetAngle(angle-45.0) 
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTWind",0,0,30,0,0,0)
8A25 F 1 A_SpawnItemEx("MistressUPPERCUTATTACK",0,0,30,0,0,0)
8A25 FF 1 A_SetAngle(angle-45.0) 
8A25 FFFF 2 A_Fadeout
stop
Death:
8A25 BBBB 2 A_Fadeout
stop
}
}

actor TrueMistressCopyVisionGUHU : TrueMistressCopyVisionEX
{
Translation "192:192=120:120", "198:198=127:127"
Obituary "%o didn't know that \cmTrue \cuBusterMistress\c- (%k)'s holograms were realistic."
Damagetype "TrueMistressHell"
speed 18 //10
States
{
Crash:
XDeath:
TNT1 A 0 A_SpawnItem("MistressFalseSuicidalExplosion")
TNT1 A 3
stop
Death:
TNT1 A 0 A_SpawnItem("MistressFalseSuicidalExplosion")
TNT1 A 3
stop
}
}


//Specialized Items here.
actor MistressCopyVisedBoxItem : CustomInventory
{
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cqWe have the technology!"
inventory.icon "SAXFUG1"
Inventory.PickupSound "item/1up"
+INVBAR
+COUNTITEM
scale 2.0
States
{
Spawn:
SAX2 A 6
loop
Use:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/PandoraItemUse","SoundSlot5")
TNT1 A 0 A_Jump(24,"BoxEXTREMEHEALING")
TNT1 A 0 A_Jump(64,"BoxGUHU")
TNT1 A 0 A_Jump(94,"BoxPOTION")
TNT1 A 0 A_Jump(168,"BoxBIGFIST")
TNT1 A 0 A_Jump(256,"BoxSOURET")
stop
BoxBIGFIST:
TNT1 A 0 A_GiveInventory("MistressBoxTimeFist",2)
stop
BoxSOURET:
TNT1 A 0 A_GiveInventory("MistressBoxSouret",3)
stop
BoxEXTREMEHEALING:
TNT1 A 0 A_GiveInventory("MistressBoxRegen",2)
stop
BoxPOTION:
TNT1 A 0 A_GiveInventory("MistressBoxPotion",1)
stop
BoxGUHU:
TNT1 A 0 A_GiveInventory("MistressBoxGUHU",1)
stop
}
}

actor MistressBoxTimeFist : UnholyItem
{
inventory.amount 2
inventory.maxamount 99
inventory.pickupmessage "POWA-FISTA!!"
inventory.icon "SAXFUG6"
States
{
Spawn:
SAX2 F 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("weapon/cfire","Item")
TNT1 A 1 A_FireCustomMissile("MistressGigaFist",0,0,8,0)
goto End
}
}

actor MistressBoxSouret : UnholyItem
{
inventory.amount 3
inventory.maxamount 99
inventory.pickupmessage "\cqSouret..Souret..SOURET."
inventory.icon "SAXFUG5"
States
{
Spawn:
SAX2 E 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("weapon/firestorm","Item")
TNT1 A 1 A_FireCustomMissile("MistressSouretShot",0,0,8,0)
goto End
}
}

actor MistressBoxRegen : UnholyItem
{
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cqDamn cheap imported goods."
inventory.icon "SAXFUG4"
States
{
Spawn:
SAX2 D 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("item/refill","Item")
TNT1 A 0 A_TakeInventory("EternalPainFlag")
TNT1 A 0 A_SpawnItemEx("MistressRegeneration_H")
goto End
}
}

actor MistressRegeneration_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 AAA 1 A_JumpIfInTargetInventory("EternalPainFlag",1,"StopTheHealing")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "StopTheHealing")
TNT1 A 0 A_GiveToTarget("MistressRegeneration_P",1)
loop
StopTheHealing:
TNT1 A 1 A_TakeFromTarget("EternalPainFlag")
stop
}
}

actor MistressRegeneration_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 1)  // Increase MaxHp if cap is hit
TNT1 AA 0 A_SpawnItemEx("BossHealingGFX",random(-32,32),random(-32,32),0,momx,momy,20,0,8)
stop
}
}

actor BossHealingGFX : BasicNoClassTranslationGraphicEffect
{
Translation "198:198=128:128", "192:192=4:4"
States
{
SpawnFrame:
CHPO X 5
stop
}
}

actor MistressBoxPotion : UnholyItem
{
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cqDoesn't green give magic?"
inventory.icon "SAXFUG3"
States
{
Spawn:
SAX2 C 6
loop
UseX:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 500)//Increase MaxHp if cap is hit
TNT1 A 0 A_PlaySoundEx("E_B/Heal2","Item")
TNT1 A 0 A_SpawnItemEx("MistressBoxPotionFX_H")
goto End
}
}

actor MistressBoxPotionFX_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("E_B/Heal2","Weapon")
TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MistressBoxPotionFX",random(-32,32),random(-32,32),random(-20,70),0,0,0,0,32)
TNT1 A 1
stop
}
}
actor MistressBoxPotionFX
{
//translation "4:4=236:236"
-SOLID
+NOGRAVITY
+CLIENTSIDEONLY
+NOINTERACTION
speed 0
Radius 2
Height 2
Scale 4.0
States
{
Spawn:
FLAS BABABABABA 2
stop
}
}


actor MistressBoxGUHU : UnholyItem
{
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cqFINAL JUSTICE!"
inventory.icon "SAXFUG2"
States
{
Spawn:
SAX2 B 6
loop
UseX:

actor DarkPurplePotionItem : UnholyItem {
  Tag "$TAG_DPC_BOX00"
  Inventory.MaxAmount 99
  inventory.pickupmessage "\ctMysterious! Dark Clone Potion!"
  Inventory.Icon "8M00I0"
  States {
   Spawn:
    8M00 I 6
    loop
   Pickup:
    TNT1 A 0 A_JumpIf(CheckClass("DarkPurpleClone"), "Pickup_No")
    TNT1 A 0 A_RailWait
    stop
   Pickup_No:
    TNT1 A 0
    fail
   UseX:
    TNT1 A 0 A_PlaySoundEx("item/energyup", "Item")
    TNT1 A 0 A_PlaySoundEx("items/EatDrink", "SoundSlot5")
   UseX_Silent:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 400)
    goto End
  }
}

actor AutoDarkPurplePotionItem : DarkPurplePotionItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDarkPurplePotionItemSilent : AutoDarkPurplePotionItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DarkPurplePotionItemFX : UnholyItemFX {
  States {
   Spawn:
    8M00 I 0
    goto Spawn2
  }
}

actor S_ClassBAWS_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_GiveToTarget("S_ClassBAWS_P")
    stop
  }
}
actor S_ClassBAWS_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(1, "Done")
    TNT1 A 0 A_JumpIf(CallACS("uh_TruePower_AmmoGiver"), "Done")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_ADD_MAX, 2000)
   Done:
    TNT1 A 0
    stop
  }
}


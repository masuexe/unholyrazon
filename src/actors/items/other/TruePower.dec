Actor TruePowerItem : CustomInventory
{
DropItem "TruePowerItem"
Tag "$TAG_TRUEPOWER"
inventory.amount 1
inventory.maxamount 10
inventory.pickupmessage "\cdSuddenly TRUE POWER!"
inventory.icon "C_I_00A"
inventory.PickupSound "GNT/Treasure"
scale 2.0
+DONTGIB
+INVBAR
States
{
Spawn:
//6N00 BCDEFGHIJKLMNOPQ 4
6N00 BCCCBDEEEDFGGGFHIIIHJKKKJLMMMLNOOONPQQQP 4
loop
Use:

UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("Contra/C_POWUP","Item")

TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseB")
TNT1 A 0 A_JumpIfInventory("MorphedFlag",1,"No")
TNT1 A 0 A_JumpIfInventory("TruePowerItemFlag",1,"No")
TNT1 A 0 //A_CheckFlag("INVULNERABLE","No")

TNT1 A 0 ACS_NamedExecuteWithResult("uh_shinyclassmorpher",-1)
stop
UseB:
TNT1 A 0 A_SpawnItemEx("S_ClassBAWS_H")
stop
No:
TNT1 A 0 A_PlaySoundEx("GNT/FailUse","Item")//A_Log("No")
fail
}
}

actor S_ClassSpawn_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteAlways("uh_IsUnderWaterGravity",0)
//TNT1 A 0 A_GiveInventory("PowerNoGravityFix",1)
TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
TNT1 A 0 A_JumpIfInventory("UnSolid",1,2)
TNT1 A 0 A_SpawnItemEx("ResolidifyPlayer_H")
TNT1 A 0 A_GiveInventory("MorphedFlag",1)
TNT1 A 0 A_GiveInventory("TruePowerItemFlag",1)
TNT1 A 0 A_GiveInventory("ShinySparkleItem",1)

TNT1 A 0 A_TakeInventory("ShieldCheck")
TNT1 A 0 A_TakeInventory("DisableJumpTricks_F")

TNT1 A 0 SetPlayerProperty(0,0,PROP_FROZEN)
TNT1 A 0 A_GiveInventory("SelfStoppedUnfreeze",1)
TNT1 A 0 A_TakeInventory("SelfTotallyFrozenFlag")

TNT1 A 0 A_GiveInventory("StopShield",1)
TNT1 A 0 A_TakeInventory("BasicArmor")

TNT1 A 0 A_TakeInventory("VivifyFlag1")
TNT1 A 0 A_TakeInventory("VivifyFlag2")
TNT1 A 0 A_TakeInventory("VivifyFlag3")

TNT1 A 0 A_TakeInventory("VivifyCycle1")
TNT1 A 0 A_TakeInventory("VivifyCycle2")
TNT1 A 0 A_TakeInventory("VivifyCycle3")
TNT1 A 0 A_TakeInventory("VivifyCycle4")
TNT1 A 0 A_TakeInventory("VivifyCycle5")
TNT1 A 0 A_TakeInventory("VivifyCycle6")

TNT1 A 0 A_TakeInventory("BotFlag1")
TNT1 A 0 A_TakeInventory("BotFlag2")
TNT1 A 0 A_TakeInventory("BotFlag3")
stop
}
}

actor TruePowerItemFlag : UOnce{}

actor S_ClassSpawnNo_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_ChangeFlag("DONTMORPH",1)
TNT1 A 0 A_GiveInventory("TruePowerItemFlag",1)
TNT1 A 0 A_GiveInventory("ShinySparkleItem",1)
TNT1 A 0 A_GiveInventory("PowerFakeTruePower1",1)
TNT1 A 0 A_GiveInventory("PowerFakeTruePower2",1)
TNT1 A 0 A_GiveInventory("PowerFakeTruePower3",1)
TNT1 A 0 ACS_NamedExecuteAlways("uh_Health",0,UHEALTH_HEAL_ADD_MAX,2000)//7
stop
}
}


}
actor UH_MorphLMSFixAbort_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
TNT1 A 0 //A_ChangeFlag("INVISIBLE",0)
TNT1 A 0 A_ChangeFlag("NOSECTOR",0)
TNT1 A 0 A_ChangeFlag("NOBLOCKMAP",0)

stop
}
}

actor S_ClassBAWS_H : BasicHelper//Replaced in Boss file
{
States
{
Spawn:
TNT1 A 0
TNT1 A 4 A_GiveToTarget("S_ClassBAWS_P",1)
stop
}
}
actor S_ClassBAWS_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("misc/HonkHonk64","Item")
stop
}
}

actor PowerFakeTruePower1 : PowerDamage
{
Powerup.Duration 0x7FFFFFFD
DamageFactor "Normal", 1.25
}
actor PowerFakeTruePower2 : PowerProtection
{
Powerup.Duration 0x7FFFFFFD
DamageFactor "Normal", 0.8
}
actor PowerFakeTruePower3 : PowerSpeed
{
Powerup.Duration 0x7FFFFFFD
Speed 1.1
+NOTRAIL
}

actor PowerGutsCheat : PowerDamage
{
Powerup.Duration 0x7FFFFFFE
DamageFactor "Normal", 2.0
}


actor PowerTimeCheat : PowerSpeed
{
Speed 1.5//1.0
Powerup.Duration 0x7FFFFFFE

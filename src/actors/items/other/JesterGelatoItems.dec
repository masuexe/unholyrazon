actor GelatoPizzaItem : UnholyItem {
  Tag "$TAG_GELATOPIZZA"
  inventory.pickupmessage "Got Item! Pizza Pasta!"
  Inventory.Icon "9H10Z0_I"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    9H10 Z 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("misc/stonethrow", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("GelatoStickyPizzaToss", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, 0, 32, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX_S")
    goto End
   UseX_S:
    TNT1 A 0 A_SpawnItemEx("GelatoStickyPizzaToss", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, 15, 32, 0)
    TNT1 A 0 A_SpawnItemEx("GelatoStickyPizzaToss", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, -15, 32, 0)
    goto End
  }
}

actor AutoGelatoPizzaItem : GelatoPizzaItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoGelatoPizzaItemSilent : AutoGelatoPizzaItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor GelatoPizzaItemFX : UnholyItemFX {
  States {
   Spawn:
    9H10 Z 0
    goto Spawn2
  }
}

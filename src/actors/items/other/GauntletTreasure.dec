actor GauntletTreasure_P : CustomInventory {
  // Inventory.MaxAmount 0
  Inventory.PickupMessage "You found some treasure!"
  // Inventory.Icon "EXITICON"
  Inventory.PickupSound "GNT/Treasure"
  Scale 2.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    6G44 ABCD 8
    loop

   Pickup:
    TNT1 A 0 A_GiveInventory("GauntletTreasure_F", 1)
    TNT1 A 0 A_JumpIf(CallACS("rz_GauntletTreasureACS", 0), "Special")
    stop

   Special:
    TNT1 A 0 A_SpawnItemEx("TruePowerItem", 0, 0, 8, 0, 0, 1, 0, 32)  // A_GiveInventory("TruePowerItem",1)
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_GauntletTreasureACS", 1)
    stop
  }
}

actor GauntletTreasure_F : Inventory {
  Inventory.MaxAmount 100
}

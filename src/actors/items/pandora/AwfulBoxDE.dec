actor AwfulBoxDEItem : UnholyItem {
  Translation "13:13=183:183", "14:14=185:185", "15:15=187:187", "8:8=180:180", "0:0=176:176"
  inventory.amount 2
  Tag "$TAG_RZ_PBOX04"
  inventory.pickupmessage "Box-Demoneye assist??"
  inventory.icon "RZPI_04"
  states {
   Spawn:
    I_BA H 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("AwfulBoxDE", 56, 0, 38, 1, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("AwfulBoxDE", 0, 56, 38, 1, 0, 0, 90, 32)
    TNT1 A 0 A_SpawnItemEx("AwfulBoxDE", 0, -56, 38, 1, 0, 0, 270, 32)
    goto End
  }
}

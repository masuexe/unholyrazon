actor BoxFlashBangHelper : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 1 A_SpawnItemEX("BoxFlashBangHelper_Helper", random(-128, 128), random(-128, 128), 0, 0)
      TNT1 A 0 A_GiveInventory("CutterFlag", 1)
      TNT1 A 0 A_JumpIfInventory("CutterFlag", 8, 1)
      loop
      TNT1 A 0
      stop
    }
}

actor BoxFlashBangHelper_Helper : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 A_PlaySoundEx("item/refill", "Item")
      TNT1 A 0 A_SpawnItemEX("FlashingDE")
      NAPA EFGHIJKLMNOPQRS 1
      stop
    }
}

actor PayRespectsFX : BasicClientSide {
    translation "198:198=182:182", "192:192=177:177"
    scale 1.0
    renderstyle translucent
    States {
     Spawn:
      F_NN FFFFF 1 A_FadeIn(0.2)
      F_NN F 35 A_Stop
      F_NN FFFFFFFFFF 2 A_FadeOut(0.1)
      Stop
    }
}

actor PlantManGrass_B : PlantManGrass{-NOINTERACTION -SOLID}
actor BurnerBush_B : BurnerBush{-NOINTERACTION -SOLID}
actor ERGrass_B : ERGrass{-NOINTERACTION -SOLID}

actor AwfulBoxDE : KillerBoxDE //does not drop items. purely pain
{
    Translation "192:192=183:183", "198:198=185:185", "199:199=187:187", "204:204=180:180", "195:195=180:180", "8:8=180:180", "0:0=176:176"
    obituary "%o didn't get their refund."
    deathsound "misc/partyball"
    seesound "S3_K/ZapFloor" //maybe
    painchance 1
    DropItem "ConfettiSpawner" 256 1
    Health 850
    speed 30
    States {
     Melee:
      I_BD NN 0 A_FaceTarget
      I_BD N 0 A_CustomMeleeAttack(85, "weapon/pursuithit", "", "KillerBoxFling", 0)
      I_BD N 0 //A_GiveToTarget("WithAidsDamage",1)
      I_BD N 0 //A_PlaySoundEx("weapon/pursuithit","Weapon")
      I_BD N 1 A_TakeInventory("WeaponCharge", 999)
      goto MeleeWait
     MeleeWait:
      I_BD N 20
      I_BD N 10 A_ClearTarget
      goto Spawn+1//Look+9
    }
}



actor BoxChocula //i forgot how to make FX that isn't clientsided
{
    PROJECTILE
    +THRUACTORS
    +NOINTERACTION
    +DONTBLAST
    Speed 0
    Damage (0)
    Radius 8
    Height 8
    renderstyle translucent
    States {
     Spawn:
      F_NN G 0
      F_NN G 2 A_PlaySoundEX("UT/TemChat1", "Body")
      F_NN G 2 A_PlaySoundEX("UT/TemChat3", "Body")
      F_NN G 2 A_PlaySoundEX("UT/TemChat5", "Body")
      F_NN G 0 A_Stop
      F_NN GHGHGHGHGHGH 3 A_SpawnItemEX("ChoculaCocoaPuff", random(-128, 128), random(-128, 128), 64, 0)
      F_NN GHGHGHGHGHGH 3
      F_NN GHGHG 3 A_FadeOut(0.2)
      stop
    }
}

actor ChoculaCocoaPuff : AmberHealthShot {
    Translation "192:192=148:148", "198:198=151:151", "202:202=210:210", "199:199=144:144"
    States {
     Spawn:
      X_5C B 0
      X_5C B 4 A_CountDown
      loop
     Death:
      X_5C BBBBBBBBBBBBBBB 1 A_FadeIn(0.05)
      X_5C BBBBB 1 A_FadeIn(0.05)
      X_5C Y 0 A_SpawnItemEx("ChoculaCocoaPuffPickup", 0, 0, 0, 0, 0, 0, 0, 1)
      stop
    }
}

actor ChoculaCocoaPuffPickup : CustomInventory {
    inventory.pickupmessage "Picked up a stale cocoa puff."
    scale 2.5
    Gravity 0.5
    States {
     Spawn:
      X_5C B 5
      Y_5C B 5
      loop
     Pickup:
      TNT1 A 0 A_PlaySound("item/energyup", 3, 1.0)
      TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 100)
      stop
    }
}

actor BoxWilyUFO3 : WilyUFO3 {
    Reactiontime 30
    States {
     Spawn:
      WUFO D 0
      WUFO D 0 A_PlaySoundEx("misc/ufo", "Voice", 1, 0)
     Fly:
      WUFO DEF 4 A_CountDown
      TNT1 A 0 ThrustThingZ(0, 10, 0, 0)
      loop
     Death:
      TNT1 A 0 A_PlaySoundEX("weapon/coilexplode", "Voice")
      TNT1 A 0 A_SpawnItemEX("BoxWilyGrovel", 0, 0, 0, 0, 0, 16, 0)
      NAPA EFGHIJKLMNOPQRS 1
      stop
    }
}

actor BoxWilyGrovel {
    PROJECTILE
    +THRUACTORS
    -NOGRAVITY
    damage (0)
    scale 2.5
    States {
     Spawn:
      WILG A 1 A_JumpIf(floorz-z==0, "Death")
      loop
     Death:
      WILG BCBCBCBCBCBC 7
      WILG OPOQOPOQOPOQ 7
      TNT1 A 0 A_PlaySoundEX("weapon/coilexplode", "Voice")
      NAPA EFGHIJKLMNOPQRS 1
      stop
    }
}

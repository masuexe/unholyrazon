actor PandoraBoxItem : BasicDroppedItem
{
Tag "$TAG_P_BOX00"
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cgHell Awaits...!"
inventory.icon "PANBOX00"
Inventory.PickupSound "items/UnholyPickup"//"item/1up"
+INVBAR
states
{
Spawn:
I_BA A 6
loop
Use:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/PandoraItemUse","SoundSlot5")
stop



Death:
TNT1 A 0
stop
}
}

actor AutoPandoraBoxItem : PandoraBoxItem
{
Translation "93:93=84:84","3:3=4:4"
inventory.maxamount 0
inventory.pickupmessage "\cgAutomatic Pandora Box!"
Inventory.PickupSound ""
-INVENTORY.INVBAR
+INVENTORY.ALWAYSPICKUP
States
{
Pickup:
goto Use
}
}
actor AutoPandoraBoxItem2 : AutoPandoraBoxItem
{
States
{
Pickup:
goto Use+2
}
}



actor PandoraBoxItem : BasicDroppedItem
{
Tag "$TAG_P_BOX00"
inventory.amount 1
inventory.maxamount 99
inventory.pickupmessage "\cgHell Awaits...!"
inventory.icon "PANBOX00"
Inventory.PickupSound "items/UnholyPickup"//"item/1up"
+INVBAR
states
{
Spawn:
I_BA A 6
loop
Use:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/PandoraItemUse","SoundSlot5")
TNT1 A 0 A_JumpIfInventory("PowerProsperity_ST",1,"UseProsperity")
TNT1 A 0 A_Jump(256,"BishPlz")

TNT1 A 0 A_Jump(1,"Rare1")
TNT1 A 0 A_Jump(4,"Rare4")
TNT1 A 0 A_Jump(8,"Rare8")
TNT1 A 0 A_Jump(32,"Rare32")
TNT1 A 0 A_Jump(56,"Rare56")
TNT1 A 0 A_Jump(128,"Rare128")
TNT1 A 0 A_Jump(254,"Rare254")
TNT1 A 0 A_Jump(250,"Rare250")
TNT1 A 0 A_Jump(256,"Rare0")
//TNT1 A 0 A_LOG("OnlineCheck")//This shows up online, could do a fancy effect
stop
UseProsperity:
TNT1 A 0 A_Jump(4,"Rare1")
TNT1 A 0 A_Jump(16,"Rare4")
TNT1 A 0 A_Jump(32,"Rare8")
TNT1 A 0 A_Jump(96,"Rare32")
TNT1 A 0 A_Jump(128,"Rare56")
TNT1 A 0 A_Jump(196,"Rare128")
TNT1 A 0 A_Jump(250,"Rare254")
TNT1 A 0 A_Jump(244,"Rare250")
TNT1 A 0 A_Jump(256,"Rare0")
stop

PseudoRagePowers:
TNT1 A 0 A_GiveInventory("FagCapItem",1)
stop

Rare0:
LuckofSatan:
TNT1 A 0 A_PlaySoundEx("misc/BlankSound","SoundSlot5")
TNT1 A 0 A_PlaySoundEx("items/MysticItemUse","SoundSlot7")
TNT1 A 0 A_GiveInventory("MysticBoxItem",1)
stop
Rare250:
ExtremeUnlucky:
TNT1 A 0 A_PlaySoundEx("misc/BlankSound","SoundSlot5")
TNT1 A 0 A_PlaySoundEx("items/SoUnlucky","SoundSlot7")
TNT1 A 0 A_GiveInventory("ZtarItem",1)
stop

Rare1:
TNT1 A 0 A_PlaySoundEx("misc/BlankSound","SoundSlot5")
TNT1 A 0 A_PlaySoundEx("GNT/SuperShot","SoundSlot7")
TNT1 A 0 A_Jump(256,1,2)
stop
AirStrike:
TNT1 A 0 A_GiveInventory("AirStrikeItem",1)
stop
UnholyBook:
TNT1 A 0 A_GiveInventory("UnholyBookItem",1)
stop

Rare4:
/*SurpriseAmber:
TNT1 A 0 A_GiveInventory("PentaMorphItem",1)
stop*/
BoxofWishes:
TNT1 A 0 A_Jump(256,1,2)
BoxInABox:
TNT1 A 0 A_GiveInventory("BoxDEItem",1)
stop
KillerBox:
TNT1 A 0 A_GiveInventory("KillerBoxDEItem",1)
stop


Rare8:
TNT1 A 0 A_Jump(256,1,2,3,4)
stop
DoomInACan:
TNT1 A 0 A_GiveInventory("SuperMysticTankItem",1)
stop
ElPoderDelSatsuiNoHado:
TNT1 A 0 A_GiveInventory("GUHUItem",1)
stop
SuperSandLegend:
TNT1 A 0 A_GiveInventory("RubberBandItem",1)
stop
JustAnotherBox:
TNT1 A 0 A_GiveInventory("ChanceBoxItem",1)
stop

Rare32:
TNT1 A 0 A_Jump(256,1,2,3,4,5)
stop
BEGONEEVIL:
TNT1 A 0 A_GiveInventory("UnholyWaterItem",1)
stop
NonLameRockets:
TNT1 A 0 A_GiveInventory("SharpRocketItem",1)
stop
BURNTOTHEGROUND:
TNT1 A 0 A_GiveInventory("OnFireItem",1)
stop
UniversalEscapeRoute:
TNT1 A 0 A_GiveInventory("MaltShopItem",1)
stop
TopDeckSuddenDeath:
TNT1 A 0 A_GiveInventory("WhackSpellItem",1)
stop

Rare56:
TNT1 A 0 A_Jump(256,1,2,3,4,5)
stop
WaspInMyButt:
TNT1 A 0 A_GiveInventory("WaspBombItem",3)
stop
EvilRobotSpawnHorseRaper:
TNT1 A 0 A_GiveInventory("TornadoDEItem",1)
stop
GoAwayFaggot:
TNT1 A 0 A_GiveInventory("StepAsideItem",1)
stop
BishPlz:
TNT1 A 0 A_GiveInventory("MoneyBaitItem",1)
stop
OhNoReturnOfTankuuBotto:
TNT1 A 0 A_GiveInventory("DemoneyeToyItem",1)
stop

Rare128:
TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
stop
HomoSpecialistGet:
TNT1 A 0 A_GiveInventory("FlingingDEItem",1)
stop
BanPls:
TNT1 A 0 A_GiveInventory("ShinBanishItem",2)
stop
FrenchCard:
TNT1 A 0 A_GiveInventory("SolitaireCardItem",2)
stop
HIYOUMUST:
TNT1 A 0 A_GiveInventory("FlashingDEItem",1)
stop
LameRockets:
TNT1 A 0 A_GiveInventory("BluntRocketItem",3)
stop
GimmeLego:
TNT1 A 0 A_GiveInventory("BrickMineItem",5)
stop

Rare254:
TNT1 A 0 A_Jump(256,1,2,3,4,5)
stop
BeerGet:
TNT1 A 0 A_GiveInventory("ThunderTankItem",5)
stop
EnviousRaeg:
TNT1 A 0 A_GiveInventory("DarkmanToyItem",1)
stop
RushWentDie:
TNT1 A 0 A_GiveInventory("RushCoilDEItem",1)
stop
BootlegItem2:
TNT1 A 0 A_GiveInventory("ContrabandItem2Item",2)
stop
Balloons:
TNT1 A 0 A_Jump(256,"LoliFaggots","GothicFaggots")
stop
LoliFaggots:
TNT1 A 0 A_GiveInventory("LoliBalloonItem",3)
stop
GothicFaggots:
TNT1 A 0 A_GiveInventory("GothicBalloonItem",1)
stop



Death:
TNT1 A 0
stop
}
}

actor AutoPandoraBoxItem : PandoraBoxItem
{
Translation "93:93=84:84","3:3=4:4"
inventory.maxamount 0
inventory.pickupmessage "\cgAutomatic Pandora Box!"
Inventory.PickupSound ""
-INVENTORY.INVBAR
+INVENTORY.ALWAYSPICKUP
States
{
Pickup:
goto Use
}
}
actor AutoPandoraBoxItem2 : AutoPandoraBoxItem
{
States
{
Pickup:
goto Use+2
}
}


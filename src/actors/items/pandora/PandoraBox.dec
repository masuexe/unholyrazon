actor PandoraBoxItem : BasicDroppedItem {
  Tag "$TAG_P_BOX00"
  Inventory.MaxAmount 99
  inventory.pickupmessage "\cgHell Awaits...!"
  Inventory.Icon "PANBOX00"
  Inventory.PickupSound "items/UnholyPickup"  // "item/1up"
  +INVBAR
  States {
   Spawn:
    I_BA A 6
    loop
   Use:
   UseX:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity", 1, "UseProsperity")
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 0, 0, 0)
    stop
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyProsperity", 1, "UseProsperitySilent")
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 0, 0, 1)
    stop
   UseProsperity:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 0, 1, 0)
    stop
   UseProsperitySilent:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_GiveRandomBoxItem", 0, 1, 1)
    stop

   Death:
    TNT1 A 0
    stop
  }
}

actor AutoPandoraBoxItem : PandoraBoxItem {
  Translation "93:93=84:84", "3:3=4:4" Inventory.MaxAmount 0
  inventory.pickupmessage "\cgAutomatic Pandora Box!"
  Inventory.PickupSound ""
  -INVENTORY.INVBAR
  +INVENTORY.ALWAYSPICKUP
  States {
   Pickup:
    goto Use
  }
}
actor AutoPandoraBoxItemSilent : AutoPandoraBoxItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor PandoraBoxItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA A 0
    goto Spawn2
  }
}

actor PandoraBoxEyeDrop : BasicWatcher {
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(32, "SpeedUpBox")
    goto Spawn2
   SpeedUpBox:
    TNT1 A 0 A_GiveToTarget("U_PSN", random(1, 3))
    goto Spawn2
   Spawn2:
    TNT1 A 0 A_Jump(1, "DuplicateBox")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SpawnRandomBoxItem", 0)
    stop

   DuplicateBox:
    TNT1 A 0 A_PlaySoundEx("GNT/Invun", "SoundSlot7")
    TNT1 A 0 A_Jump(256, 1, 2)
    TNT1 A 2 A_SpawnItemEx("KillerBoxDE")
    stop
    TNT1 A 2 A_SpawnItemEx("FriendlyBoxDE")
    stop
  }
}

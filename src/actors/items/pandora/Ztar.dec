actor ZtarItem : UnholyItem {
  Tag "$TAG_P_BOX25"
  inventory.pickupmessage "Heck no! Invincibility? Ztar?!"
  Inventory.Icon "PANBOX25"
  States {
   Spawn:
    I_BA Y 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("misc_L/itemthrow", "Item")
   UseX_Silent:
    TNT1 A 0  // A_FireCustomMissile("ZtarShot",0,0,8,0,0,5)
    TNT1 A 0 A_SpawnItemEx("ZtarmanItemToss", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, 0, 32, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("ZtarmanItemToss_Spread", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, 15, 32, 0)
    TNT1 A 0 A_SpawnItemEx("ZtarmanItemToss_Spread", cos(-pitch) * 2, 0, 28 + (sin(-pitch) * 2), cos(-pitch) * 30, 0, sin(-pitch) * 30, -15, 32, 0)
    goto End
  }
}
actor AutoZtarItem : ZtarItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoZtarItemSilent : AutoZtarItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor ZtarItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA Y 0
    goto Spawn2
  }
}


actor ZtarmanItemToss : BasicDroppedItem {
  inventory.pickupmessage "Picked up a \cmZtar\c-!"
  -SPECIAL
  +THRUACTORS
  +NOBLOCKMONST
  Speed 30
  Scale 2.5
  States {
   Spawn:
    I_BP Y 0
    I_BP Y 0 ThrustThing(angle * 256 / 360, 4, 1, 0)
    I_BP Y 0 ThrustThingZ(0, 12, 0, 1)
    I_BY ABCDE 2
    I_BY A 0 A_ChangeFlag("THRUACTORS", 0)
    I_BY A 0 A_ChangeFlag("SPECIAL", 1)
    goto SpawnL+5
   SpawnL:
    I_BY ABCDEFGH 2
    loop
   SpawnOld:
    I_BP Y 1 A_SetAngle(angle + 15)
    loop

   Pickup:
    I_BP Y 0 A_JumpIfInventory("PowerZtarmanSpeed", 1, "No")
    I_BP Y 0 A_SpawnItemEx("ZtarmanItemSound")
    I_BP Y 0 A_GiveInventory("ZtarmanSpeedGiver", 1)
    I_BP Y 0 A_SpawnItemEx("ZtarmanItem_H")
   No:
    I_BP Y 0 A_GiveInventory("ZtarItem", 1)
    stop
  }
}
actor ZtarmanItemToss_Spread : ZtarmanItemToss {
  Translation "0:0=5:5", "70:70=70:70", "244:244=244:244"
  inventory.pickupmessage "Picked up a phantom \cmZtar\c-!"
  RenderStyle "Translucent"
  // RenderStyle "Shadow"
  Alpha 0.64
  States {
   Pickup:
    I_BP Y 0 A_JumpIfInventory("PowerZtarmanSpeed", 1, "No")
    I_BP Y 0 A_SpawnItemEx("ZtarmanItemSound")
    I_BP Y 0 A_GiveInventory("ZtarmanSpeedGiver", 1)
    I_BP Y 0 A_SpawnItemEx("ZtarmanItem_H")
   No:
    I_BP Y 0 A_RailWait
    stop
  }
}

actor ZtarmanSpeedGiver : BasicPowerupGiver {
  powerup.type "PowerZtarmanSpeed"
}

actor PowerZtarmanSpeed : PowerSpeed {
  Powerup.Duration 222
  Speed 1.5
}

actor ZtarmanItemSound : BasicSoundFollow {
  PainSound "items/StarTime"
  ReactionTime 230
}

actor ZtarmanItem_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "SpawnEnd")
    TNT1 A 0 A_GiveToTarget("ZtarmanItem_P")
    TNT1 A 0 A_JumpIfInTargetInventory("PowerZtarmanSpeed", 1, "Spawn")
    goto SpawnEnd
   SpawnEnd:
    TNT1 A 0
    TNT1 A 1
    stop
  }
}

actor ZtarmanItem_P : CustomInventory {
  States {
   Pickup:
    TNT1 AAAAAA 0 A_SpawnItemEx("ZtarmanItemFX", random(-8, 8), random(-8, 8), random(20, 36), random(velx - 7, velx + 7), random(vely - 7, vely + 7), random(velz - 4, velz + 9), 0, 8, 0)
    TNT1 A 2 A_SpawnItemEx("ZtarmanItemBoom", 0, 0, 28, velx, vely, velz, 0, 8)
    stop
  }
}

actor ZtarmanItemBoom : BasicExplosion {
  DamageType "Ztar"
  Obituary "%o was coruscated by %k's Ztar surge."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "Spawn2", 2)
    TNT1 A 2 A_Explode(23, 148, 0, 0, 16)
    stop
   Spawn2:
    TNT1 A 0 A_SetDamageType("ZtarB")
    goto Spawn+2
  }
}

actor ZtarmanItemFX {
  Translation "4:4=70:70", "192:192=244:244", "198:198=247:247"
  Projectile
  +DONTBLAST
  +THRUACTORS
  +DOOMBOUNCE
  +DONTSPLASH
  +CANBOUNCEWATER
  +CLIENTSIDEONLY
  +PAINLESS
  +BRIGHT
  // RenderStyle "Add"
  Alpha 0.75
  Damage (0)
  Radius 2
  Height 2
  Speed 35
  Scale 1.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P0K EEFFGGHHEEFFGGHHEEFFGGHHEEFFGGHH 1
    stop
  }
}

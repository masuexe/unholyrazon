actor MoneyBait_Moola : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 ACS_NamedExecuteWithResult("uh_SpawnMoneyBaitShot")
      stop
    }
}

actor MoneyBait_MoolaB32 : BasicWatcher {
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 ACS_NamedExecuteWithResult("uh_SpawnMoneyBaitBurst")
      stop
    }
}

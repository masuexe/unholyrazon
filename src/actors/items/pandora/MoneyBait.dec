{
Spawn:
TNT1 A 0
// TNT1 A 0 A_Jump(1,"Ghost","Joust","Quick")
// TNT1 A 0 A_Jump(8,"Business","Tank")
// TNT1 A 0 A_Jump(32,"Kamikaze")
// TNT1 A 0 A_Jump(128,"Sumo","MLG","Bomber")

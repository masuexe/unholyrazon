actor WaspBombItem : UnholyItem
{
Tag "$TAG_P_BOX12"
inventory.amount 3
inventory.pickupmessage "Get Swarmed! Wasps Nest!"
inventory.icon "PANBOX12"
States
{
Spawn:
I_BA L 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("item/refill","Item")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 1 A_FireCustomMissile("WaspBomb",0,0,0,0)
goto End
UseX2:
TNT1 A 1 A_FireCustomMissile("WaspBombB",0,0,0,0)
goto End
}
}
actor AutoWaspBombItem : WaspBombItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoWaspBombItemSilent : AutoWaspBombItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor WaspBombItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA L 0
            goto Spawn2
    }
}


actor WaspBomb : BasicNoClassTranslationProjectile
{
Translation "192:192=64:64", "198:198=62:62"
damagetype "WaspBomb"
Obituary "%o was swatted by %k's Wasp Nest!"
+SEEKERMISSILE
+SCREENSEEKER
+SKYEXPLODE
+EXPLODEONWATER
+THRUGHOST
BounceType "Hexen"
BounceCount 6
ReactionTime 70
damage (50)
Radius 5
Height 5
speed 40
scale 2.5
States
{
Spawn:
I_BL A 0
I_BL ABCD 2 A_SeekerMissile(4,20,1,110,7)
I_BL A 0 A_CountDown
loop
Death:
TNT1 A 0 A_PlaySoundEx("wep_L/hornetchaser","Item")
TNT1 AA 0 A_SpawnItemEx("WaspBomb2",0,0,1,random(15,20),random(-20,20),random(5,20),random(0,179),1024)
TNT1 AA 0 A_SpawnItemEx("WaspBomb2",0,0,1,random(15,20),random(-20,20),random(-5,-20),random(180,359),1024)
TMFX ABCD 2
stop
}
}

actor WaspBombB : WaspBomb
{
damagetype "WaspBombB"
States
{
Death:
TNT1 A 0 A_PlaySoundEx("wep_L/hornetchaser","Item")
TNT1 AA 0 A_SpawnItemEx("WaspBomb2B",0,0,1,random(15,20),random(-20,20),random(5,20),random(0,179),1024)
TNT1 AA 0 A_SpawnItemEx("WaspBomb2B",0,0,1,random(15,20),random(-20,20),random(-5,-20),random(180,359),1024)
TMFX ABCD 2
stop
}
}

actor WaspBomb2 : WaspBomb
{
Translation "192:192=64:64","198:198=62:62","213:213=176:176"
Obituary "%o was engulfed by %k's swarm of wasps!"
damagetype "WaspBomb"
+RIPPER
BounceCount 5
ReactionTime 88
damage (4)
Radius 4
Height 4
speed 16
States
{
Spawn:
I_BL L 0
I_BL LK 1
I_BL J 0 A_SeekerMissile(4,20,1,110,5)
I_BL JI 1
I_BL H 0 A_SeekerMissile(4,20,1,110,5)
I_BL HG 1
I_BL F 0 A_SeekerMissile(4,20,1,110,5)
I_BL FE 1
//I_BL LKJIHGFE 1 A_SeekerMissile(2,10,1,55,5)
I_BL L 0 A_CountDown
I_BL L 0 A_SeekerMissile(4,20,1,110,5)
loop
Death:
TMFX ABCD 2 A_Explode(10,66,0,0,8)
stop
}
}

actor WaspBomb2B : WaspBomb2 {
  damagetype "WaspBombB"
  damage (5)
}

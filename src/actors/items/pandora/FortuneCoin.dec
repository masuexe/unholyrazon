actor FortuneCoinItem : UnholyItem {
  Tag "$TAG_RZ_PBOX02"
  inventory.amount 2
  inventory.pickupmessage "You win some, you lose some."
  Inventory.Icon "RZPI_02"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_RP C 6
    loop
   Use:
   UseX:
   UseX_Silent:
    // TNT1 A 0 A_PlaySoundEx("weapon/BoxBeep","Voice")
    TNT1 A 0 A_GiveInventory("FortuneCoinChanceTime_P")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_GiveInventory("FortuneCoinChanceTime_P")
    TNT1 A 0 A_GiveInventory("FortuneCoinChanceTime_P")
    goto End
  }
}

actor AutoFortuneCoinItem : FortuneCoinItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoFortuneCoinItemSilent : AutoFortuneCoinItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor FortuneCoinItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RP C 0
    goto Spawn2
  }
}

actor FortuneCoinChanceTime_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "ThatsGood", "OhShit")
   ThatsGood:
    TNT1 A 0 A_GiveInventory("FortuneCoinHeal_P")
    goto End
   OhShit:
    TNT1 A 0 A_GiveInventory("FortuneCoinPunish_P")
    goto End
  }
}

actor FortuneCoinHeal_P : CustomInventory {
  // inventory.pickupmessage "\cdDivine Blessing! HP Restored!"
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("item/energyup", "Item")
    // TNT1 A 0 A_PlaySoundEx("items/EatHotDog","SoundSlot5")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, CallACS("uh_Health", UHEALTH_GET_MAX) / 2)
    stop
  }
}

actor FortuneCoinPunish_P : CustomInventory {
  // inventory.pickupmessage "\chCursed Fate! Thunderstruck!"
  DamageType "FortuneCoin"
  Obituary "%k's Fortune Coin showed %o's fortune is death."
  +BRIGHT
  States {
   Pickup:
    Y_BC N 1 A_SpawnItemEx("ThunderTankShotExtendFX", 0, 0, 355, 0, 0, 0, 0, 1)
    Y_BC O 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    X_8B A 0 A_SpawnItemEx("FortuneCoinPunishSelf_H", 0, 0, 0, 0, 0, 0, 0, 0)
    Y_BC O 0 A_Explode(CallACS("uh_Health", UHEALTH_GET_MAX) / 4, 128, 0, 0, 16)
    Y_BC O 1 A_SpawnItemEx("UnfortuneShockWaveSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 32, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 64, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 96, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 128, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 160, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 192, 0, 0, 0, 0, 1)
    Y_BC PQR 1
    stop
  }
}

actor FortuneCoinPunishSelf_H : BasicWatcher {
  Obituary "%o met the cursed side of Fortune Coin."
  -MISSILE
  // +FOILINVUL
  // +NODAMAGETHRUST
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ACS_NamedExecuteWithResult("rz_ThingDamage_FortuneCoin", CallACS("core_gettarget"), CallACS("uh_Health", UHEALTH_GET_MAX, 0, AAPTR_TARGET) / 2)
    stop
  }
}


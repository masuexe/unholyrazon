    TNT1 A 0 A_SpawnItemEx("UnfortuneShockwaveAttack", 0, 0, 0, 30, 0, 0, 345)
    TNT1 A 1
    stop
  }
}

actor UnfortuneShockwaveAttack : BasicNoClassTranslationProjectile {
  Translation "192:192=79:79"
  DamageType "FortuneCoin"
  Obituary "%k's Fortune Coin showed %o's fortune is death."
  +FLOORHUGGER
  +THRUGHOST
  +RIPPER
  Damage (CallACS("uh_Health", UHEALTH_GET_MAX, 0, AAPTR_TARGET) / 4)
  Radius 32
  Height 32
  Speed 30
  Scale 2.0
  States {
   Spawn:
    X_0E T 0
    X_0E T 1 A_FadeOut
    wait
  }
}

actor FortuneCoinProtect : PowerProtection {
  Powerup.Duration 8
  damagefactor "FortuneCoin", 0
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_FortuneCoin : BasicACSDamager {
  DamageType "FortuneCoin"
  Obituary "%o met the cursed side of Fortune Coin while fighting %k."
}

actor BrickMineTossX : BasicNoClassTranslationProjectile {
damagetype "BrickMine"
Obituary "%o felt agonizing pain from stepping on %k's misplaced brick."
-NOGRAVITY
+THRUGHOST
+DONTBLAST
+BOUNCEONCEILINGS
+DONTSPLASH
+NOEXPLODEFLOOR
+STEPMISSILE
  +HITTRACER
maxstepheight 24
BounceCount 1
BounceFactor 1.0
WallBounceFactor 0.15
gravity 1.0
ReactionTime 36
Damage (125)
Radius 16
Height 16
speed 20
Scale 2.5
States
{
Spawn:
I_CP G 0
I_CP G 0 A_PlaySoundEx("DuckHunt/Flap","Weapon")
I_CP G 300 A_CountDown
wait
Crash:
XDeath:
    TNT1 A 0 A_PlaySound("S3_K/Spikes", 1, 0.5)
    TNT1 A 1 A_JumpIf(CheckClass("BrickDemoneye", AAPTR_TRACER, 0), "Recycle")
    stop
   Death:
    TNT1 A 1
    stop
   Recycle:
    TNT1 A 1 A_GiveInventory("BrickEyeBrickMineStack", 1, AAPTR_TRACER)
    stop
}
}

actor BoxDEItem : UnholyItem
{
Tag "$TAG_P_BOX07"
inventory.pickupmessage "Box-Demoneye assist!"
inventory.icon "PANBOX07"
states
{
Spawn:
I_BA H 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox","Item")
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("FriendlyBoxDE",56,0,38,1,0,0,0,32)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("FriendlyBoxDE_Spread",0,56,38,1,0,0,90,32)
TNT1 A 0 A_SpawnItemEx("FriendlyBoxDE_Spread",0,-56,38,1,0,0,270,32)
goto End
}
}

actor AutoBoxDEItem : BoxDEItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoBoxDEItemSilent : AutoBoxDEItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor BoxDEItemFX : UnholyItemFX {
  States {
   Spawn: 
    I_BA H 0
    goto Spawn2
  }
}

actor FriendlyBoxDE : UH_ShootableItemActor
{
Translation "192:192=13:13","198:198=14:14","199:199=15:15","204:204=13:13","195:195=14:14"
//+CANPASS
-ISMONSTER
-COUNTKILL
+SHOOTABLE
+NOBLOOD
-SOLID
+DONTCORPSE
painsound "misc/devilpain"
deathsound "misc/devildeath"

//damagefactor "", 0.0

DropItem "AutoPandoraBoxItem" 256 1
Health 1250
Mass 500
gravity 0.8
painchance 64

Damage (0)
Radius 20
Height 52
Speed 16
scale 2.5
States
{
Spawn:
I_BD N 0
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
I_BD NNNNNNNNNN 1 A_Wander
I_BD N 0 A_JumpIfInventory("WeaponCharge",10,"DeathTimer")
I_BD N 0 A_GiveInventory("U_PSN",random(1,2))
I_BD N 0 A_JumpIfInventory("U_PSN",5,"Item")
I_BD N 0 A_Jump(32,"Spawn3")
I_BD N 0 A_Jump(64,"Spawn2")
I_BD N 0 A_Jump(128,"Spawn1")
loop
Spawn1:
I_BD N 0
goto Spawn+20
Spawn2:
I_BD N 0
goto Spawn+40
Spawn3:
I_BD N 0
goto Spawn+60
Item:
I_BD N 0 A_Stop
I_BD N 1 A_TakeInventory("U_PSN",6)
I_BD N 0 A_GiveInventory("WeaponCharge",1)
I_BD N 0 A_ChangeVelocity(0,0,6)
I_BD N 1 A_SpawnItemEx("PandoraBoxEyeDrop")
I_BD N 0 A_Jump(16,"Spawn3")
I_BD N 0 A_Jump(32,"Spawn2")
I_BD N 0 A_Jump(64,"Spawn1")
Goto Spawn+1
Pain:
I_BD N 0 A_Pain
I_BD NNNNNNNNNN 2 A_SpawnItem("PainFX",0,3)
I_BD N 0 A_Jump(32,"Spawn3")
I_BD N 0 A_Jump(64,"Spawn2")
I_BD N 0 A_Jump(128,"Spawn1")
goto Spawn+1
DeathTimer:
I_BD N 0 A_ChangeFlag("INVULNERABLE",1)
I_BD N 0 A_ChangeFlag("DONTBLAST",1)
I_BD N 0 A_ChangeFlag("NOGRAVITY",1)
I_BD N 6 A_Stop
I_BD N 0 A_ChangeVelocity(0,0,8,3)
I_BD NNNNNNNNNN 1 A_FadeOut(0.1,0)
I_BD N 1 A_SpawnItemEx("BoxDEItem",0,0,0,0,0,6)
stop
Death:
I_BD N 0 A_Fall
I_BD N 20 A_Stop
I_BD N 0 A_Scream
I_BD N 0 //A_DropItem("PandoraBoxItem",1)
TNT1 A 0 A_CustomMissile("FakeDeathFX")
TNT1 A 70
stop
}
}

actor FriendlyBoxDE_Spread : FriendlyBoxDE
{
States
{
DeathTimer:
I_BD N 0 A_ChangeFlag("INVULNERABLE",1)
I_BD N 0 A_ChangeFlag("DONTBLAST",1)
I_BD N 0 A_ChangeFlag("NOGRAVITY",1)
I_BD N 6 A_Stop
I_BD N 0 A_ChangeVelocity(0,0,8,3)
I_BD NNNNNNNNNN 1 A_FadeOut(0.1,0)
stop
}
}



actor PitSpikeTossX : BasicNoClassTranslationProjectile {
  damagetype "PitSpike"
  Obituary "%o fell into %k's pit spike and teleported to Dixieland."
  -NOGRAVITY
  -NOCLIP
  +SOLID
  +THRUGHOST
  +DONTBLAST
  +BOUNCEONCEILINGS
  +DONTSPLASH
  +NOEXPLODEFLOOR
  +STEPMISSILE
  +RIPPER
  +THRUSPECIES
  +PUSHABLE
  species "PitSpike"
  maxstepheight 24
  BounceCount 1
  BounceFactor 1.0
  WallBounceFactor 0.15
  gravity 1.0
  ReactionTime 72
  Damage (375)
  Radius 16
  Height 8
  speed 20
  Mass 20
  States {
   Spawn:
    I2PB A 0 A_PlaySoundEx("DuckHunt/Flap", "Weapon")
    I2PB A 300 A_CountDown
    wait
   Death:
    TNT1 A 1
    stop
  }
}

actor PitSpikeTossInstagib : PitSpikeTossX {
  damagetype "PitSpikeInstagib"
  Obituary "%o was lucky to find %k's \cginstagib\c- spike."
  Damage (6999999)
}

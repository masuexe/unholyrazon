actor GUHUItem : UnholyItem {
    Tag "$TAG_P_BOX17"
    inventory.pickupmessage "FOR FREEDOM! STARS AND STRIPES!"
    inventory.icon "PANBOX17"
    States {
     Spawn:
      I_BA Q 6
      loop
     UseX:
      TNT1 A 0 A_PlaySoundEx("S_Battle/Beep", "Item")
     UseX_Silent:
      TNT1 A 0 A_JumpIfInventory("GUHUItemDelay", 1, 4)
      TNT1 A 0 //A_GiveInventory("AntiInvincibleB",1)
      TNT1 A 0 A_GiveInventory("GUHUItemDelay", 1)
      TNT1 A 0 A_SpawnItemEx("GUHUExplode", 0, 0, 28, 0, 0, 0, 0, 1)
      TNT1 A 0
      fail
    }
}
actor AutoGUHUItem : GUHUItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
     Pickup:
      goto UseX
    }
}
actor AutoGUHUItemSilent : AutoGUHUItem {
    States {
     Pickup:
      goto UseX_Silent
    }
}
actor GUHUItemFX : UnholyItemFX {
    States {
     Spawn:
      I_BA Q 0
      goto Spawn2
    }
}

actor GUHUItemDelay : Powerup {
    Powerup.Duration 5
}

actor GUHUExplode : BasicExplosion {
    Translation "192:192=176:176", "198:198=186:186"
    var int user_S;
    Damagetype "GiveUpHope"
    Obituary "%k sent %o to Dixieland."
    +FOILINVUL
    Scale 7.5
    Args 1
    States {
     Spawn:
      X_8B A 0
      X_8B A 0 A_SetArg(0, CallACS("rz_CountInv_GUHUItem", AAPTR_TARGET))
      X_8B A 0 A_TakeFromTarget("GUHUItem", user_S)
      X_8B A 0 //A_LogInt(Args[0])
      X_8B A 0 A_SetArg(0, Args[0]*(CallACS("uh_checkrune", RUNE_SPREAD, AAPTR_TARGET)*2+1))
      X_8B A 0 A_SpawnItemEx("GUHUExplodeSelf_H", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
      //X_8B A 0 A_Explode(2500*Args[0],256,True,1,96)
      X_8B A 0 A_Explode(2500*Args[0], 256, 0, 0, 96)
      X_8B ABCDEF 2
      stop

      //SXF_TRANSFERSPECIAL
    }
}

actor GUHUExplodeSelf_H : BasicWatcher {
    Obituary "%o went to Dixieland."
    -MISSILE
    +FOILINVUL
    +NODAMAGETHRUST
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 0 //Thing_Damage(ACS_ExecuteWithResult(257),2500*Args[0],0)
      TNT1 A 0 //A_Warp(2,0,0,28,0,WARPF_NOCHECKPOSITION)
      TNT1 A 0 //A_SpawnItemEx("GUHUExplodeSelf",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL)
      TNT1 A 1 ACS_NamedExecuteWithResult("rz_ThingDamage_GiveUpHope", CallACS("core_getptrtid", AAPTR_TARGET), 2500*(Args[0] > 0 ? Args[0] : 1))
      stop
    }
}


actor GUHUExplodeSelf : BasicExplosion {
    Damagetype "GiveUpHope"
    Obituary "%k sent %o to Dixieland."
    +FOILINVUL
    +NODAMAGETHRUST
    Args 1
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 2 A_Explode(2500*Args[0], 8, True, 1, 8)
      stop
    }
}

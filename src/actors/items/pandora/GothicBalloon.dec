Actor GothicBalloonItem : UnholyItem
{
Tag "$TAG_P_BOX14"
inventory.pickupmessage "\cmDepressing things... Gothic-Balloons..."
inventory.icon "PANBOX14"
states
{
Spawn:
I_BA N 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("assists_L/item1spawn","Item")
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("GothicBalloon",56,0,38,1,0,0,0,0,0)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX_S")
goto End
UseX_S:
TNT1 A 0 A_SpawnItemEx("GothicBalloon",0,56,38,0,1,0,0,0,0)
TNT1 A 0 A_SpawnItemEx("GothicBalloon",0,-56,38,0,-1,0,0,0,0)
goto End
}
}
actor AutoGothicBalloonItem : GothicBalloonItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoGothicBalloonItemSilent : AutoGothicBalloonItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor GothicBalloonItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA N 0
            goto Spawn2
    }
}


actor GothicBalloon : LoliBalloon {
Translation "192:192=4:4", "198:198=63:63"
damagetype "GothicBalloon"
Obituary "%o became utterly depressed due to %k's Gothic-Balloon."
ReactionTime 60
States
{
Spawn:
I_BN A 0
I_BN A 0 A_Stop
goto Spawn1
Spawn1:
I_BN A 0 A_Explode(35,66,0)
I_BN A 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN A 2 A_Countdown
I_BN B 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
goto Spawn2
Spawn2:
I_BN B 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN B 2 A_Countdown
I_BN A 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
goto Spawn1
Spawn1_S:
I_BN C 0 A_TakeInventory("BalloonTouchedFlag",1)
I_BN C 0 A_Explode(35,66,0)
I_BN C 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN C 2 A_Countdown
I_BN D 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
I_BN D 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN D 2 A_Countdown
I_BN C 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
goto Spawn1
Spawn2_S:
I_BN D 0 A_TakeInventory("BalloonTouchedFlag",1)
I_BN D 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN D 2 A_Countdown
I_BN C 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
I_BN C 0 A_Explode(35,66,0)
I_BN C 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BN C 2 A_Countdown
I_BN D 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
goto Spawn2

Death:
X_3D B 2 A_ChangeFlag("SOLID",0)
YMFX C 2
TMFX ACD 2
stop
}
}

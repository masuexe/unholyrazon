actor SharpRocketItem : UnholyItem {
  Tag "$TAG_P_BOX22"
  inventory.pickupmessage "Support item! Sharp-Rocket!"
  Inventory.Icon "PANBOX22"
  States {
   Spawn:
    I_BA V 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Item")
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "UseX2")
    TNT1 A 0 A_FireCustomMissile("SharpRocket", 0, 0, 0, 0)
    goto End
   UseX2:
    TNT1 A 0 A_FireCustomMissile("SharpRocketB", 0, 0, 0, 0)
    goto End
  }
}
actor AutoSharpRocketItem : SharpRocketItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoSharpRocketItemSilent : AutoSharpRocketItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor SharpRocketItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA V 0
    goto Spawn2
  }
}


actor SharpRocket : BasicNoClassTranslationProjectile {
  Translation "192:192=200:200", "198:198=207:207"
  DamageType "SharpRocket"
  Obituary "%o no longer had an ass thanks to %k's Sharp Rocket."
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUGHOST
  Damage (450)
  Radius 10
  Height 10
  Speed 20
  Scale 2.5
  States {
   Spawn:
    I_BP V 3 A_ScaleVelocity(1.15)
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm1/hyperbombexplode", "Weapon")
    TNT1 A 0 A_Explode(675, 148, 1, 0, 12)
    X_8B ABCDEF 2
    stop
  }
}

actor SharpRocketB : SharpRocket {damagetype "SharpRocketB"}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_SharpRocket : BasicACSDamager {
  DamageType "SharpRocket"
  Obituary "%o no longer had an ass thanks to their own Sharp Rocket while fighting %k."
}

actor HazardTag_SharpRocketB : HazardTag_SharpRocket { DamageType "SharpRocketB" }

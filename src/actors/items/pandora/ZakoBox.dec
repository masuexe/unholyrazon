actor ZakoBoxItem : UnholyItem {
  Tag "$TAG_RZ_PBOX06"
  inventory.pickupmessage "Yes! You can even co-op in this game!"
  Inventory.Icon "RZPI_06"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_RP F 6
    loop
   UseX:
    TNT1 A 0 A_PlaySoundEx("SMWNes/ItemSpawn", "Item")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("ZakoBoxSpawner", 0, 0, 0, 0)
    goto End
  }
}

actor AutoZakoBoxItem : ZakoBoxItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoZakoBoxItemSilent : AutoZakoBoxItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor ZakoBoxItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RP F 0
    goto Spawn2
  }
}

actor ZakoBoxSpawner {
  Projectile
  +THRUACTORS
  +THRUGHOST
  +DONTBLAST
  -NOGRAVITY
  Gravity 2.0
  Radius 20
  Height 43
  Scale 2.5

  Speed 20
  +BOUNCEONWALLS
  +CANBOUNCEWATER
  WallBounceFactor 0.85

  States {
   Spawn:
    I2PF A 0
    I2PF A 0 ThrustThingZ(0, 52, 0, 0)
   SpawnLoop:
    I2PF A 3
    I2PF B 1
    loop

   Death:
    I2PF A 0 A_SpawnItemEx("ZakoBox")
    stop
  }
}

actor ZakoBox {
  -NOGRAVITY
  +SHOOTABLE
  +SOLID
  +NEVERTARGET
  +DONTDRAIN
  +NOTAUTOAIMED
  +NOBLOOD
  Mass 0x7ffffffd
  Health 700
  painchance 256
  painsound "Somari/Boom"
  Radius 20
  Height 43
  Scale 2.5
  States {
   Spawn:
    I2PF A 0
    I2PF A 3
    I2PF B 1
    loop
   Pain:
    TNT1 A 0 A_Pain
    goto Spawn
   Death:
    // TNT1 A 0 A_PlaySoundEx("Somari/Boom",4)
    TNT1 AAAAA 6 A_SpawnItemEx("ZakoSpawnOrb", 0, 0, 12, random(12, 18), 0, random(5, 11), random(0, 359), SXF_ABSOLUTEANGLE)
    stop
  }
}

actor RomhackedEnemySpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("ZakoSpawnOrb", 0, 0, 0, random(12, 18), 0, random(5, 11), random(0, 359), SXF_ABSOLUTEANGLE)
    stop
  }
}

actor ZakoOrbHatched_F : Once {}

actor ZakoSpawnOrb {
  var int user_NoClassTranslation;
  Projectile
  +THRUACTORS
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  +SKYEXPLODE
  -NOGRAVITY
  Gravity 0.85
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  BounceFactor 0.65
  WallBounceFactor 0.85
  BounceCount 40
  Damage (0)
  Radius 12
  Height 20
  Speed 0
  Scale 2.5
  +BRIGHT
  +FORCEXYBILLBOARD
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ClearTarget
    TNT1 A 0 ACS_NamedExecuteAlways("rz_ZakoOrbThink", 0)
   SpawnLoop:
    TMFX BA 2 BRIGHT
    loop
   Hatch:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 A_PlaySoundEx("misc/galaxyteleport", "Voice")
    TMFX OBCH 2 BRIGHT
    stop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_ZakoOrbForceHatch", 0)
    TNT1 A 0 A_PlaySoundEx("misc/galaxyteleport", "Voice")
    TMFX OBCH 2 BRIGHT
    stop
  }
}

actor ZakoWallProbeBase {
  +ISMONSTER
  +THRUACTORS
  -SOLID
  -COUNTKILL
  +NOGRAVITY
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    stop
  }
}

actor ZakoWallProbe_64x128 : ZakoWallProbeBase { Radius 64 Height 128 }
actor ZakoWallProbe_48x52 : ZakoWallProbeBase { Radius 48 Height 52 }
actor ZakoWallProbe_40x120 : ZakoWallProbeBase { Radius 40 Height 120 }
actor ZakoWallProbe_40x46 : ZakoWallProbeBase { Radius 40 Height 46 }
actor ZakoWallProbe_36x75 : ZakoWallProbeBase { Radius 36 Height 75 }
actor ZakoWallProbe_32x64 : ZakoWallProbeBase { Radius 32 Height 64 }
actor ZakoWallProbe_32x52 : ZakoWallProbeBase { Radius 32 Height 52 }
actor ZakoWallProbe_20x52 : ZakoWallProbeBase { Radius 20 Height 52 }
actor ZakoWallProbe_18x18 : ZakoWallProbeBase { Radius 18 Height 18 }

actor ZakoBoxItem : UnholyItem {
	Tag "$TAG_RZ_PBOX06"
	inventory.pickupmessage "Yes! You can even co-op in this game!"
	inventory.icon "RZTI_06"
	states {
	 Spawn:
	  I_RP F 6
	  loop
	 UseX:
	  TNT1 A 0
	  TNT1 A 0 A_PlaySoundEx("SMWNes/ItemSpawn", "Item")
	  TNT1 A 0 A_FireCustomMissile("ZakoBoxSpawner", 0, 0, 0, 0)
	  goto End
	}
}

actor ZakoBoxSpawner {
	PROJECTILE
	+THRUACTORS
	+THRUGHOST
	+DONTBLAST
	-NOGRAVITY
	gravity 2.0
	radius 20
	height 43
	Scale 2.5

	Speed 20
	+BOUNCEONWALLS
	+CANBOUNCEWATER
	WallBounceFactor 0.85

	States {
	 Spawn:
	  I2PF A 0
	  I2PF A 0 ThrustThingZ(0, 52, 0, 0)
	 SpawnLoop:
	  I2PF A 3
	  I2PF B 1
	  loop

	 Death:
	  I2PF A 0 A_SpawnItemEx("ZakoBox")
	  stop
	}
}

actor ZakoBox {
	-NOGRAVITY
	+SHOOTABLE
	+SOLID
	+NEVERTARGET
	+DONTDRAIN
	+NOTAUTOAIMED
	+NOBLOOD
	mass 0x7ffffffd
	health 700
	painchance 256
	painsound "Somari/Boom"
	radius 20
	height 43
	scale 2.5
	States {
	 Spawn:
	  I2PF A 0
	  I2PF A 3
	  I2PF B 1
	  loop
	 Pain:
	  TNT1 A 0 A_Pain
	  goto Spawn
	 Death:
	  // TNT1 A 0 A_PlaySoundEx("Somari/Boom",4)
	  TNT1 AAAAA 8 A_SpawnItemEx("RomhackedEnemySpawner", 0, 0, 32)
	  stop
	}
}

actor RomhackedEnemySpawner : BasicHelper {
	var int user_xVel;
	var int user_zVel;
	var int user_angle;
	States {
	 Spawn:
	  TNT1 A 2
	  TNT1 A 0 A_SetUserVar("user_xVel", random(12, 18))
	  TNT1 A 0 A_SetUserVar("user_zVel", random(4, 10))
	  TNT1 A 0 A_SetUserVar("user_angle", random(0, 359))
	  TNT1 A 0 A_Jump(16, "Boss")
	  TNT1 A 0 A_Jump(32, "JoeArmor", "BigEye")
	  TNT1 A 0 A_Jump(64, "Flea", "PropTop", "CrazyCannon", "HotHead")  // "FlyingShell", "TopFiend"
	  TNT1 A 0 A_Jump(128, "Joe")  // "HammerJoe"
	  goto Metool

	 Boss:
	  TNT1 A 0 A_Jump(256, 1, 2, 3,4)
	  TNT1 A 1 A_SpawnItemEx("ToadmanBossU_4BCAS", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("HeatmanBossU_DEM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("CutmanBossU_SRT", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("CutmanBossU_Claw", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	 JoeArmor:
	  TNT1 A 0 A_Jump(256, 1, 2, 3)
	  //TNT1 A 1 A_SpawnItemEx("SniperArmorU_MindRoar")
	  //stop
	  TNT1 A 1 A_SpawnItemEx("SniperArmorU_Exile", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("SniperArmorU_Z", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("SniperArmorU_DEM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	 Joe:
	  TNT1 A 0 A_Jump(256, 1, 2, 3)
	  // TNT1 A 1 A_SpawnItemEx("ReturningSniperJoeU_MindRoar", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  // stop
	  TNT1 A 1 A_SpawnItemEx("ReturningSniperJoeU_Exile", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("ReturningSniperJoeU_Z", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("ReturningSniperJoeU_DEM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	 BigEye:
	  TNT1 A 0 A_Jump(256, 1, 2)
	  TNT1 A 1 A_SpawnItemEx("BigEyeEnemyU_2BM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 0 A_Jump(256, 1, 2)
	  TNT1 A 1 A_SpawnItemEx("BigEyeEnemyU_Claw", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("BigEyeEnemyU_Claw_Color2", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	//  HammerJoe:
	//   TNT1 A 0 A_Jump(256, 1)
	//   TNT1 A 1 A_SpawnItemEx("HammerJoeU_3BC", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	//   stop

	 Metool:
	  TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
	  // TNT1 A 1 A_SpawnItemEx("MetEnemyU_2BM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  // stop
	  TNT1 A 1 A_SpawnItemEx("MetEnemyU_3BC", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("MetEnemyU_Exile", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("MetEnemyU_Z", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("MetEnemyU_2Core", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	 Flea:
	  TNT1 A 0 A_Jump(256, 1)
	  TNT1 A 1 A_SpawnItemEx("FleaU_Claw", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	//  FlyingShell:
	//   TNT1 A 0 A_Jump(256, 1, 2, 3)
	//   TNT1 A 1 A_SpawnItemEx("FlyingShellU_Claw", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	//   stop
	//   TNT1 A 1 A_SpawnItemEx("FlyingShellU_Claw_Color2", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	//   stop
	//   TNT1 A 1 A_SpawnItemEx("FlyingShellU_Claw_Color3", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	//   stop

	 CrazyCannon:
	  TNT1 A 0 A_Jump(256, 1, 2)
	  TNT1 A 1 A_SpawnItemEx("CrazyCannonU_DEM", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	  TNT1 A 1 A_SpawnItemEx("CrazyCannonU_DEM_Color2", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	 PropTop:
	  TNT1 A 1 A_SpawnItemEx("PropTopU_Claw2", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop

	//  TopFiend:
	//   TNT1 A 1 A_SpawnItemEx("TopFiendU_3BC", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	//   stop

	 HotHead:
	  TNT1 A 1 A_SpawnItemEx("HotHeadEnemyU_Claw2", 0, 0, 0, user_xVel, 0, user_zVel, user_angle)
	  stop
	}
}

actor BluntRocketItem : UnholyItem
{
Tag "$TAG_P_BOX21"
inventory.amount 3
inventory.pickupmessage "Support item! Blunt-Rocket!"
inventory.icon "PANBOX21"
States
{
Spawn:
I_BA U 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("weapon/napalm","Item")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 0 A_FireCustomMissile("BluntRocket",0,0,0,0)
goto End
UseX2:
TNT1 A 0 A_FireCustomMissile("BluntRocketB",0,0,0,0)
goto End
}
}

actor AutoBluntRocketItem : BluntRocketItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoBluntRocketItemSilent : AutoBluntRocketItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor BluntRocketItemFX : UnholyItemFX {
  States {
   Spawn: 
    I_BA U 0
    goto Spawn2
  }
}

actor BluntRocket : BasicNoClassTranslationProjectile
{
Translation "202:202=203:203", "199:199=237:237"
damagetype "BluntRocket"
Obituary "%o had a blunt rocket inside %p ass thanks to %k's Blunt Rocket."
+SKYEXPLODE
+THRUGHOST
+CANBOUNCEWATER
+HEXENBOUNCE
wallbouncefactor 1.0
bouncefactor 0.95
BounceCount 10
Damage (random(125,175))
radius 8
height 8
Speed 35
scale 2.5
States
{
Spawn:
I_BP U 1
loop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/crackerexplode","Weapon")
TNT1 A 0 A_Explode(random(125,175),128,0,0,8)
TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorY",0,0,0,0,0,0,0,1)
stop
}
}

actor BluntRocketB : BluntRocket {damagetype "BluntRocketB"}

actor ThunderTankItem : UnholyItem {
  Tag "$TAG_P_BOX11"
  inventory.amount 5
  inventory.pickupmessage "Support item! Thunder-Tank!"
  Inventory.Icon "PANBOX11"
  States {
   Spawn:
    I_BA K 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("misc_L/itemthrow", "Item")  // item/refill
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "UseX2")
    TNT1 A 1 A_FireCustomMissile("ThunderTankShot", 0, 0, 0, 0)
    goto End
   UseX2:
    TNT1 A 1 A_FireCustomMissile("ThunderTankShotB", 0, 0, 0, 0)
    goto End
  }
}
actor AutoThunderTankItem : ThunderTankItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoThunderTankItemSilent : AutoThunderTankItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor ThunderTankItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA K 0
    goto Spawn2
  }
}


actor ThunderTankShot : BasicNoClassTranslationProjectile {
  Translation "192:192=93:93", "198:198=229:229", "4:4=160:160", "202:202=161:161", "199:199=228:228"
  DamageType "ThunderTankStun"
  Obituary "%o faced the divine wrath of %k's TTank."
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUGHOST
  Damage (15)
  Radius 6
  Height 5
  Speed 28
  Scale 2.5
  States {
   Spawn:
    I_BP K 0
    I_BP K 0 ThrustThingZ(0, 12, 0, 1)
    I_BP K 2
    wait
   Death:
    Y_BC N 0
    Y_BC N 0 A_SetGravity(0.0)
    Y_BC N 1 bright A_SpawnItemEx("ThunderTankShotExtendFX", 0, 0, 355, 0, 0, 0, 0, 1)
    Y_BC O 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    Y_BC O 0 A_Explode(125, 128, 0, 0, 16)
    Y_BC O 1 bright
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 32, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 64, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 96, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 128, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(32, 96), Random(32, 96), 160, 0, 0, 0, 0, 1)
    Y_BC P 0 A_SpawnItemEx("ThunderTankShotFX", Random(-32, -96), Random(-32, -96), 192, 0, 0, 0, 0, 1)
    Y_BC PQR 1 bright
    stop
  }
}

actor ThunderTankShotFX : BasicNoClassTranslationGraphicEffect {
  States {
   SpawnFrame:
    Y_BC K 0
    Y_BC K 0 A_ChangeVelocity(fRandom(-2, 2), fRandom(-2, 2), fRandom(-2, 2), CVF_REPLACE)
    Y_BC KLM 1
    stop
  }
}

actor ThunderTankShotExtendFX : BasicNoClassTranslationGraphicEffect {
  States {
   SpawnFrame:
    Y_BC S 0
    Y_BC S 0 A_JumpIf(ceilingz - z <= 32, "Death")
    Y_BC S 0 A_SpawnItemEx("ThunderTankShotExtendFX", 0, 0, 160, 0, 0, 0, 0, 1)
    Y_BC SSTU 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor ThunderTankShotB : ThunderTankShot {damagetype "ThunderTankStunB"}

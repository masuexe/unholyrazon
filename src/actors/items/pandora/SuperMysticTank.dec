actor SuperMysticTankItem : UnholyItem
{
Tag "$TAG_P_BOX01"
inventory.pickupmessage "Get Hyped! Super Mystic Tank!"
inventory.icon "PANBOX01"
States
{
Spawn:
I_BA B 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("items/GoldTank","SoundSlot6")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("PowerSMTankBuff",1,"UseX1")
TNT1 A 0 A_GiveInventory("PowerSMTankBuff")
TNT1 A 0 A_GiveInventory("GuardDownFlag")
TNT1 A 0 A_GiveInventory("PowerSMTankNerf")
TNT1 A 0 A_SpawnItemEx("SuperMysticTank_Helper")
goto UseX1
UseX1:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_ADD_MAX, 2000)//Max health +2k, heal 2k
goto End
UseX2:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 2000)
goto End
}
}
actor AutoSuperMysticTankItem : SuperMysticTankItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoSuperMysticTankItemSilent : AutoSuperMysticTankItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor SuperMysticTankItemFX : UnholyItemFX {
    States {
        Spawn:
            I_BA B 0
            goto Spawn2
    }
}

actor PowerSMTankNerf : PowerProtection
{
Powerup.Duration 0x7FFFFFFC
DamageFactor "Normal", 2.0
}

actor PowerSMTankBuff : PowerDamage
{
Powerup.Duration 0x7FFFFFFC
DamageFactor "Normal", 2.0
}

actor SuperMysticTank_Helper : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_GiveToTarget("SuperMysticTankFX_P",1)
TNT1 AAAAAAA 5 A_JumpIf(!CallACS("uh_PointerExists", 2),"Death")
loop
}
}

actor SuperMysticTankFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_CheckFlag(CANTSEEK,"No")
goto Pickup1
Pickup1:
TNT1 A 0 A_SpawnItemEx("SuperMysticTankFX",-1,0,56,0,0,2.5)
stop
No:
TNT1 A 0
stop
}
}

actor SuperMysticTankFX : BasicClientSide
{
Scale 1.5
States
{
Spawn:
I_BP B 0
I_BP B 1 A_Fadeout
I_BP B 0 A_SetScale(ScaleX+0.2,ScaleY+0.2)
loop
}
}

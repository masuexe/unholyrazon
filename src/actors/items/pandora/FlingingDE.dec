actor FlingingDEItem : UnholyItem {
  Tag "$TAG_P_BOX03"
  inventory.pickupmessage "\cmNO! I don't want that!"
  Inventory.Icon "PANBOX03"
  States {
   Spawn:
    I_BA D 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/refill", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("FlingingDE", 56, 0, 38, 1, 0, 0, 0, 0, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX_S")
    goto End
   UseX_S:
    TNT1 A 0 A_SpawnItemEx("FlingingDE", 0, 56, 38, 0, 1, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("FlingingDE", 0, -56, 38, 0, -1, 0, 0, 0, 0)
    goto End
  }
}
actor AutoFlingingDEItem : FlingingDEItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoFlingingDEItemSilent : AutoFlingingDEItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor FlingingDEItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA D 0
    goto Spawn2
  }
}


actor FlingingDE : ProjSpawnFuncNoClassTranslationActor {
  Translation "192:192=89:89", "198:198=93:93", "249:249=5:5"  // 195:195=
  // "192:192=65:65", "198:198=58:58"
  Obituary "%o was flirted by \cjMagic \cmSpecialist\c-."
  -SOLID
  +THRUGHOST
  RenderStyle "Translucent"
  Alpha 0.95
  Mass 0x7ffffffd
  ReactionTime 12
  Radius 32
  Height 64
  Scale 2.5
  States {
   Spawn:
    8B15 C 0
    8B15 C 0
   SpawnFall:
    8B15 CCCCEEEE 1 A_JumpIf(z - floorz == 0, "Landed")
    8B15 C 0 A_Countdown
    loop
   Landed:
    8B15 A 34
    8B15 I 5
    8B15 FFFFFFFFFF 1
    8B15 GGGGGGGGGGGGGGGGGGGGG 2 A_SpawnItemEx("FlingingDE_Boom", 0, 0, 16)
    8B15 I 4
    8B15 A 1 A_Countdown
    wait
   Death:
    8B15 C 0 A_SpawnItemEx("FlingingDEDeathFX", 0, 0, 0, 0, 0, 1, 0, 1)
    stop
  }
}
actor FlingingDEDeathFX : BasicNoClassTranslationGraphicEffect {
  States {
   SpawnFrame:
    8B15 C 0
    8B15 C 0 ThrustThingZ(0, 20, 0, 1)
    8B15 CCCC 1 A_FadeOut(0.05)
    8B15 C 0 ThrustThingZ(0, 20, 0, 1)
    8B15 EEEE 1 A_FadeOut(0.05)
    loop
  }
}


actor FlingingDE_Boom : BasicNoClassTranslationExplosion {
  DamageType "MagicSpecialist"
  Obituary "%o was flirted by \cjMagic \cmSpecialist\c-."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(11, 1000, 0, 0, 56)
    stop
  }
}

actor KillerBoxDEItem : UnholyItem
{
Tag "$TAG_P_BOX08"
Translation "8:8=180:180"
inventory.pickupmessage "Box-Demoneye assist?"
inventory.icon "PANBOX08"
states
{
Spawn:
I_BA H 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/ABoxEyeBox","Item")
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("KillerBoxDE",56,0,38,1,0,0,0,32)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("KillerBoxDE",0,56,38,1,0,0,90,32)
TNT1 A 0 A_SpawnItemEx("KillerBoxDE",0,-56,38,1,0,0,270,32)
goto End
}
}
actor AutoKillerBoxDEItem : KillerBoxDEItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoKillerBoxDEItemSilent : AutoKillerBoxDEItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor KillerBoxDEItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA H 0
            goto Spawn2
    }
}


actor KillerBoxDE : UH_ShootableItemActor
{
var int user_NoTranslation;
Translation "192:192=13:13","198:198=14:14","199:199=15:15","204:204=180:180","195:195=180:180","8:8=180:180"
obituary "%o didn't have any imagination."

-ISMONSTER
+SHOOTABLE
-SOLID
//+CANPASS
-NOGRAVITY
+DONTBLAST
+NOBLOOD
+WINDTHRUST
+NODAMAGETHRUST
+NEVERRESPAWN
+NOBLOCKMONST//
+LOOKALLAROUND
+ACTIVATEMCROSS
+NOINFIGHTING
-NOTARGETSWITCH
+QUICKTORETALIATE
+NOICEDEATH
-NODROPOFF
+DONTCORPSE
//+NEVERFAST

MaxStepHeight 7777
MaxDropOffHeight 7777

painsound "misc/devilpain"
deathsound "misc/devildeath"
//Monster
species "DemonEye"

//damagefactor "KillerBoxFling", 0.0

painchance 16

DropItem "AutoPandoraBoxItem" 256 1

MaxTargetRange 32
MeleeRange 32
Health 1250
gravity 1.5
reactiontime 2

Damage (0)
Radius 20
Height 52
speed 19
scale 2.5
States
{
Spawn:
I_BD N 35
I_BD N 1 A_Wander
I_BD N 0 A_Look//Ex(LOF_NOSOUNDCHECK,0,0,0,360,"See")
goto Spawn+1

See:
I_BD N 0 A_GiveInventory("WeaponCharge",1)
I_BD N 0 A_JumpIfInventory("WeaponCharge",100,"ScrewChasing")
I_BD N 0 A_JumpIfCloser(384,"SeeC")
I_BD N 0 //A_PlaySoundEx("","soundslot7",0,0)
I_BD NN 2 A_FastChase
I_BD NNNN 1 A_Chase
Loop
SeeC:
I_BD N 0 //A_PlaySoundEx("","soundslot7",0,0)
I_BD NNNNNNNN 1 A_Chase
goto See

Melee:
I_BD NN 0 A_FaceTarget
I_BD N 0 A_CustomMeleeAttack(85,"weapon/pursuithit","","KillerBoxFling",0)
I_BD N 0 //A_GiveToTarget("WithAidsDamage",1)
I_BD N 0 //A_PlaySoundEx("weapon/pursuithit","Weapon")
I_BD N 1 A_TakeInventory("WeaponCharge",999)
I_BD N 1 A_GiveInventory("U_PSN",random(1,3))
I_BD N 0 A_JumpIfInventory("U_PSN",5,"Melee2")
goto MeleeWait
MeleeWait:
I_BD N 20
I_BD N 10 A_ClearTarget
goto Spawn+1//Look+9
Melee2:
I_BD N 2
I_BD N 6 A_TakeInventory("U_PSN",9)
I_BD N 12 A_SpawnItemEx("PandoraBoxEyeDrop")
I_BD N 10 A_ClearTarget
goto Spawn+1//Look+9

Pain:
I_BD N 0 A_Pain
I_BD NNNN 2 A_SpawnItem("PainFX",0,3)
ScrewChasing:
I_BD N 0 A_TakeInventory("WeaponCharge",999)
I_BD N 25 A_ClearTarget
goto Spawn+1//Look+7
Death://Crash:
I_BD N 0 A_Scream
I_BD N 0 A_Fall
I_BD N 1 A_Stop
I_BD N 0 //A_DropItem("PandoraBoxItem",1)
TNT1 A 0 A_CustomMissile("FakeDeathFX")
TNT1 A 70
stop
//Death:
//I_BD N 0
//goto Crash
}
}

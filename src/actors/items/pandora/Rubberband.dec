actor RubberBandItem : UnholyItem
{
Tag "$TAG_P_BOX18"
inventory.pickupmessage "PREE-PAIR-2-DEI!"
inventory.icon "PANBOX18"
States
{
Spawn:
I_BA R 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("RubberBandSound")
UseX_Silent:
TNT1 A 0 A_FireCustomMissile("Rubberband",0,0,0,0)
goto End
}
}
actor AutoRubberBandItem : RubberBandItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
        goto UseX
    }
}
actor AutoRubberBandItemSilent : AutoRubberBandItem {
    States {
        Pickup:
        goto UseX_Silent
    }
}
actor RubberBandItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA R 0
            goto Spawn2
    }
}

actor RubberBandSound : BasicSoundFollow
{
PainSound "items/rubberban"
ReactionTime 210
}

actor Rubberband : BasicNoClassTranslationProjectile
{
Translation "192:192=50:50","198:198=145:145"
damagetype "RubberBand"
Obituary "%o has witnessed that %k is a real Super-Sand-Lesbian!"
+THRUGHOST
damage (10000)
Radius 12
Height 12
speed 95
scale 3.5
States
{
Spawn:
I_BR A 2 A_SpawnItemEx("RubberbandFX1",0,0,0,0,0,0,0,1)
I_BR B 2 A_SpawnItemEx("RubberbandFX2",0,0,0,0,0,0,0,1)
I_BR C 2 A_SpawnItemEx("RubberbandFX3",0,0,0,0,0,0,0,1)
I_BR B 2 A_SpawnItemEx("RubberbandFX4",0,0,0,0,0,0,0,1)
loop
}
}


actor RubberbandFX1 : BasicClientSide
{
Alpha 0.8
RenderStyle Translucent
States
{
Spawn:
TNT1 A 1
I_BR A 2
I_BR BCB 2 A_FadeOut(0.15)
stop
}
}

actor RubberbandFX2 : RubberbandFX1
{
States
{
SpawnFrame:
TNT1 A 1
I_BR B 2
I_BR CBA 2 A_FadeOut(0.15)
stop
}
}
actor RubberbandFX3 : RubberbandFX1
{
States
{
SpawnFrame:
TNT1 A 1
I_BR C 2
I_BR BAB 2 A_FadeOut(0.15)
stop
}
}
actor RubberbandFX4 : RubberbandFX1
{
States
{
SpawnFrame:
TNT1 A 1
I_BR B 2
I_BR ABC 2 A_FadeOut(0.15)
stop
}
}


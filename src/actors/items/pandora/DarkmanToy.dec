actor DarkmanToy1 : DarkmanToyBase {
  Translation "192:192=4:4", "198:198=110:110"
  Obituary "%o was envious of %k's Cheap-Wind-Up-DarkMan1-Bot-Toy."
  Damage (333)
  Speed 5
  States {
   Spawn:
    I_BO A 1
    I_BO A 0 A_ChangeVelocity(5, 0, 0, 3)
    I_BO A 1 A_GiveInventory("ResyncPickup")
   SpawnL:

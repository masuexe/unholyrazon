actor DarkmanToyBoom : BasicNoClassTranslationExplosion {
  DamageType "DarkmanToy"
  Obituary "%o tried to play with %k's Cheap-Wind-Up-DarkMan-Bot-Toy."
  Scale 2.5
  Args 222
  States {
   Spawn:
    X_8B A 0
    X_8B AA 0 A_Explode(args[0], 128, 1, 0, 32)
    X_8B A 2 A_PlaySoundEx("weapon/napalm", "Weapon")
    X_8B BCDEF 2
    stop
  }
}
actor DarkmanToyBoom2 : DarkmanToyBoom {Args 333}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_DarkmanToy : BasicACSDamager {
  DamageType "DarkmanToy"
  Obituary "%o played with their own Cheap-Wind-Up-DarkMan-Bot-Toy while fighting %k."
}

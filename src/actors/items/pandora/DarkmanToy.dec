actor DarkmanToyItem : UnholyItem {
  Tag "$TAG_P_BOX15"
  inventory.pickupmessage "Kick ass! Wind-up Darkman!"
  Inventory.Icon "PANBOX15"
  States {
   Spawn:
    I_BA O 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/refill", "Item")
   UseX_Silent:
    TNT1 A 0 A_Jump(256, "DarkMan1Spawned", "DarkMan2Spawned", "DarkMan3Spawned", "Darkman4Spawned")
    goto DarkMan1Spawned
   DarkMan1Spawned:
    TNT1 A 0 A_FireCustomMissile("DarkmanToy1", 0, 0, 0, 0)
    goto End
   DarkMan2Spawned:
    TNT1 A 0 A_FireCustomMissile("DarkmanToy2", 0, 0, 0, 0)
    goto End
   DarkMan3Spawned:
    TNT1 A 0 A_FireCustomMissile("DarkmanToy3", 0, 0, 0, 0)
    goto End
   DarkMan4Spawned:
    TNT1 A 0 A_FireCustomMissile("DarkmanToy4", 0, 0, 0, 0)
    goto End
  }
}
actor AutoDarkmanToyItem : DarkmanToyItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoDarkmanToyItemSilent : AutoDarkmanToyItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor DarkmanToyItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA O 0
    goto Spawn2
  }
}


actor DarkmanToyBase : BasicNoClassTranslationProjectile {
  DamageType "DarkmanToy"
  Obituary "%o tried to play with %k's Cheap-Wind-Up-DarkMan-Bot-Toy."
  -NOGRAVITY
  +THRUGHOST
  /*
Bouncetype Classic
-BOUNCEONWALLS
-BOUNCEONFLOORS
-BOUNCEONCEILINGS
-ALLOWBOUNCEONACTORS
   */
  +DONTSPLASH
  +NOEXPLODEFLOOR
  +STEPMISSILE
  MaxStepHeight 24
  // BounceFactor 1.0
  // WallBounceFactor 0.0
  Gravity 1.0
  Damage (222)
  Radius 16
  Height 32
  Speed 5
  Scale 2.5
  States {
   Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("DarkmanToyBoom", 0, 0, 8, 0, 0, 0, 0, 1)
    stop
  }
}

actor DarkmanToy4 : DarkmanToyBase {
  Translation "192:192=87:87", "198:198=227:227"
  Obituary "%o was envious of %k's Cheap-Wind-Up-DarkMan4-Bot-Toy."
  MaxStepHeight 32
  Speed 7
  States {
   Spawn:
    I_BO M 1
    I_BO M 0 A_ChangeVelocity(7, 0, 0, 3)
    I_BO M 1 A_GiveInventory("ResyncPickup")
    goto S_T
   SpawnOld:
    I_BO MNOM 4
    I_BO M 0 A_ChangeVelocity(5, 0, 8, CVF_RELATIVE)
    loop
   S_T:
    I_BO M 4 A_Jump(48, "S_T1")
    I_BO N 4 A_Jump(48, "S_T2")
    I_BO O 4 A_Jump(48, "S_T3")
    I_BO N 4 A_Jump(48, "S_T4")
    loop
   S_T1:
    I_BO M 4 A_CheckFloor(1)
    goto S_T+1
    I_BO M 4 ThrustThingZ(0, random(8, 64), 0, 1)
    goto S_T+1
   S_T2:
    I_BO N 4 A_CheckFloor(1)
    goto S_T+2
    I_BO N 4 ThrustThingZ(0, random(8, 64), 0, 1)
    goto S_T+2
   S_T3:
    I_BO O 4 A_CheckFloor(1)
    goto S_T+3
    I_BO O 4 ThrustThingZ(0, random(8, 64), 0, 1)
    goto S_T+3
   S_T4:
    I_BO N 4 A_CheckFloor(1)
    goto S_T
    I_BO N 4 ThrustThingZ(0, random(8, 64), 0, 1)
    goto S_T
  }
}

actor DarkmanToy3 : DarkmanToyBase {
  Translation "192:192=64:64", "198:198=62:62"
  Obituary "%o was envious of %k's Cheap-Wind-Up-DarkMan3-Bot-Toy."
  Speed 6
  States {
   Spawn:
    I_BO I 1
    I_BO I 0 A_ChangeVelocity(6, 0, 0, 3)
    I_BO I 1 A_GiveInventory("ResyncPickup")
   SpawnL:
    I_BO IJ 4
    I_BO K 0 A_PlaySound("misc/devilfire", 1, 0.75)
    I_BO K 0 A_SpawnItemEx("DarkmanToy3Shot", 0, 0, 16, 30, 0, 0, 0, 1)
    I_BO KJ 4
    loop
  }
}

actor DarkmanToy3Shot : BasicNoClassTranslationProjectile {
  DamageType "DarkmanToy"
  Obituary "%o was shot by %k's Cheap-Wind-Up-DarkMan3-Bot-Toy."
  Damage (85)
  Speed 60
  Radius 5
  Height 5
  Scale 2.5
  States {
   Spawn:
    TNT1 A 2
    I_BO L 1
    wait
  }
}


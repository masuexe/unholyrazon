actor FlashingDEItem : UnholyItem
{
Tag "$TAG_P_BOX05"
inventory.pickupmessage "Illumination! Flashbang Demoneye!"
inventory.icon "PANBOX05"
States
{
Spawn:
I_BA F 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("item/refill","Item")
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("FlashingDE",0,0,32,0,0,0,0,32)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("FlashingDE",0,0,0,0,0,0,0,32)
TNT1 A 0 A_SpawnItemEx("FlashingDE",0,0,64,0,0,0,0,32)
goto End
}
}
actor AutoFlashingDEItem : FlashingDEItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoFlashingDEItemSilent : AutoFlashingDEItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor FlashingDEItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA F 0
            goto Spawn2
    }
}


actor FlashingDE : BasicNoClassTranslationProjectile
{
Translation "192:192=93:93","198:198=3:3","195:195=77:77"
damagetype "FlashingDemoneye"
Obituary "%o eyes were obliterated by %k's \ctDemoneye\c-."
+THRUGHOST
+SKYEXPLODE
+EXPLODEONWATER
+DONTREFLECT
Damage (250)
Height 32
Radius 16
Speed 0
Scale 2.5
States
{
Spawn:
I_BD JK 5
I_BD J 0 ThrustThingZ(0,10,0,0)
I_BD JKJKJKJKJKJKJKJKJKJK 5
I_BD J 0 A_SpawnItemEx("FlashingDE_Boom")
stop
Crash:
XDeath:
TNT1 A 1 A_SpawnItemEx("FlashingDE_Boom")
stop
Death:
TNT1 A 1 A_SpawnItemEx("FlashingDE_Boom")
stop
}
}

actor FlashingDE_Boom : BasicNoClassTranslationExplosion
{
damagetype "FlashingDemoneye"
Obituary "%o witnessed the beauty of %k's \ctDemoneye\c-."
Reactiontime 35
Scale 3.5
States
{
Spawn:
FLEX AB 1 bright 
FLEX CD 1 bright
FLEX A 0 A_Explode(11,1000,1,0,16)
FLEX EE 0 A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(-40,40),Random(-32,32),0,0,0,0)
FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX EE 0 A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(-40,40),Random(-32,32),0,0,0,0)
FLEX GF 1 bright A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX A 0 A_Explode(11,1000,1,0,16)
Goto Pattern1
Pattern1:
FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX E 0 A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(-16,-40),Random(-32,32),0,0,0,0)
FLEX G 0 A_Countdown
FLEX GF 1 bright A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(16,40),Random(-32,32),0,0,0,0)
FLEX G 0 A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX G 0 A_CountDown
Goto DamageNow
Pattern2:
FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX E 0 A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(32,64),Random(-32,40),0,0,0,0)
FLEX E 0 A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(-32,-64),Random(-32,40),0,0,0,0)
FLEX G 0 A_Countdown
FLEX EF 1 bright A_SpawnItemEx("FlashBombFX2",Random(-16,16),Random(-40,40),Random(-32,32),0,0,0,0)
FLEX G 0 A_SpawnItemEx("FlashBombFX1",0,0,0,random(-7,7),random(-7,7),random(-7,7),random(0,359))
FLEX G 0 A_CountDown
Goto DamageNow
DamageNow:
FLEX A 0 A_Explode(11,1000,1,0,16)
FLEX G 0 A_Jump(256,"Pattern1","Pattern2")
Goto Spawn+5
}
}

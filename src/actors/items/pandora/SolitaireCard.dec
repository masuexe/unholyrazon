actor SolitaireCardItem : UnholyItem
{
Tag "$TAG_P_BOX20"
inventory.amount 2
inventory.pickupmessage "\cgSOLITAIRE"
inventory.icon "PANBOX20"
States
{
Spawn:
I_BA T 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/SolitaireShot","Item")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 0 A_FireCustomMissile("SolitaireCard",0,0,0,0)
goto End
UseX2:
TNT1 A 0 A_FireCustomMissile("SolitaireCardB",0,0,0,0)
goto End
}
}
actor AutoSolitaireCardItem : SolitaireCardItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoSolitaireCardItemSilent : AutoSolitaireCardItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor SolitaireCardItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA T 0
            goto Spawn2
    }
}



actor SolitaireCard : BasicNoClassTranslationProjectile
{
damagetype "Solitaire"
Obituary "\cgSOLITAIRE \c-(%k -> %o)"
+SKYEXPLODE
+EXPLODEONWATER
+THRUGHOST
damage (50)
Radius 9
Height 9
speed 55
scale 2.5
States
{
Spawn:
I_BT ABCEF 1
loop
Death:
Crash:
TNT1 AAA 0 A_SpawnItemEx("CardSpawner",0,0,8)
TNT1 A 1 A_PlaySoundEx("weapon/magiccard","Weapon")
TNT1 A 0 A_Explode(225,108,0,0,16)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,60)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,-60)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,120)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,-120)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,180)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,-180)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2",0,0,0,28,0,0,0)
stop
}
}

actor SolitaireCard2 : BasicNoClassTranslationProjectile
{
damagetype "Solitaire"
Obituary "%o lost The Game to %k."
+RIPPER
Damage (50)
Radius 9
Height 9
Speed 30
scale 2.5
States
{
Spawn:
I_BT ABCEF 2
loop
}
}

actor SolitaireCardB : SolitaireCard
{
damagetype "SolitaireB"
States
{
Death:
Crash:
TNT1 AAA 0 A_SpawnItemEx("CardSpawner",0,0,8)
TNT1 A 1 A_PlaySoundEx("weapon/magiccard","Weapon")
TNT1 A 0 A_Explode(225,108,0,0,16)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,60)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,-60)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,120)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,-120)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,180)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,-180)
TNT1 A 0 A_SpawnItemEx("SolitaireCard2B",0,0,0,28,0,0,0)
stop
}
}

actor SolitaireCard2B : SolitaireCard2 {damagetype "SolitaireB"}

actor RushCoilDEItem : UnholyItem
{
Tag "$TAG_P_BOX06"
inventory.pickupmessage "Oh No! Trampoline Demoneye Coil!"
inventory.icon "PANBOX06"
states
{
Spawn:
I_BA G 6
loop
UseX:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("item/refill","Item")
UseX_Silent:
//TNT1 A 0 A_FireCustomMissile("RushCoilDE",0,0,0,0,0,0)
//TNT1 A 0 //A_SpawnItemEx("TrampolineHatDemonEyeTeleport", 40, 0, 256, 0, 0, -32, 0, SXF_NOCHECKPOSITION, 0)
TNT1 A 0 A_SpawnItemEx("SpawnRushCoilDE_H",0,0,0,0,0,0,0)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX2")
goto End
UseX2:
TNT1 A 0 A_SpawnItemEx("SpawnRushCoilDE_H",0,0,0,0,0,0,15)
TNT1 A 0 A_SpawnItemEx("SpawnRushCoilDE_H",0,0,0,0,0,0,-15)
goto End
}
}

actor AutoRushCoilDEItem : RushCoilDEItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoRushCoilDEItemSilent : AutoRushCoilDEItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor RushCoilDEItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA G 0
            goto Spawn2
    }
}

actor SpawnRushCoilDE_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(200, "Down")
    TNT1 A 0 A_SpawnItemEx("RushCoilDE",0,0,32,cos(-pitch)*22,0,sin(-pitch)*22,0,32)
    stop
   Down:
    TNT1 A 0 A_SpawnItemEx("RushCoilDownDE",0,0,32,cos(-pitch)*22,0,sin(-pitch)*22,0,32)
    stop
  }
}

actor RushCoilDE : ProjSpawnFuncNoClassTranslationActor {
  Translation "192:192=216:216","198:198=220:220","195:195=46:46"
  Damagetype "SpringEye"
  Obituary "%o had some trouble using a springhat demoneye."
  -SOLID
  -NOGRAVITY
  //+MISSILE
  +DONTBLAST
  //+NOCLIP
  +THRUACTORS
  +SKYEXPLODE
  +LOOKALLAROUND
  +THRUGHOST
  +NOBLOCKMONST
  +SLIDESONWALLS
  reactiontime 61//600//125
  Radius 12
  Height 32
  speed 22
  scale 2.5
  states {
   Spawn:
    I_BD L 0 //A_Jump(256,"Death")
    I_BD L 4 //A_ChangeFlag("MISSILE",0)
    //I_BD L 1 A_JumpIf(z-floorz <=0, "LookHere")
    //wait
   LookHere:
    I_BD L 0 //A_ChangeFlag("NOCLIP",0)
    I_BD LL 2
    I_BD L 0 A_Cleartarget
    I_BD L 0 A_JumpIf(true, "PlaceHolder")
   PlaceHolder:
    I_BD L 0 A_CountDown
    I_BD L 0 A_CustomMissile("RushCoilDEDetect",-26,0,0,2,0)//A_SpawnItemEx("EyeSpringDetect", 0, 0, -26)
    I_BD LL 1 A_JumpIfInventory("UOnce",1,"BOOSTEMUP")
    I_BD L 0 A_CustomMissile("RushCoilDEDetect",-26,0,0,2,0)
    I_BD LL 1 A_JumpIfInventory("UOnce",1,"BOOSTEMUP")
    I_BD L 0 A_CustomMissile("RushCoilDEDetect",-26,0,0,2,0)
    I_BD LL 1 A_JumpIfInventory("UOnce",1,"BOOSTEMUP")
    I_BD L 0 A_CustomMissile("RushCoilDEDetect",-26,0,0,2,0)
    I_BD LL 1 A_JumpIfInventory("UOnce",1,"BOOSTEMUP")
    I_BD L 0 A_CustomMissile("RushCoilDEDetect",-26,0,0,2,0)
    I_BD LL 1 A_JumpIfInventory("UOnce",1,"BOOSTEMUP")
    loop
   BOOSTEMUP:
    I_BD M 0 A_PlaySound("S_2/Spring",1,0.85)//A_GiveToTarget("SpringActivate",1)
    I_BD MMMMMMMMMMMMMMMMMM 1
    I_BD M 0 A_TakeInventory("UOnce")//A_Die
    I_BD M 0 A_SpawnItemEx("RushCoilDEBoom",0,0,16)
    I_BD L 2 A_CountDown
    Goto PlaceHolder
   Death:
    I_BD L 0 A_ChangeFlag("NOINTERACTION",0)
    I_BD L 0 ThrustThingZ(0,15,0,1)
    I_BD L 1 A_Fadeout(0.05)
    loop
  }
}

actor RushCoilDownDE : RushCoilDE {
  states {
   PlaceHolder:
    I_BD O 0 A_CountDown
    I_BD O 0 A_GiveInventory("RushCoilDEJump_P")
    I_BD O 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD O 0 A_JumpIfInventory("CutterFlag",1,"JumpMyself")
    I_BD OO 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD O 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD OO 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD O 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD OO 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD O 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD OO 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD O 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD OO 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    loop
   JumpMyself:
    I_BD P 0 ThrustThingZ(0,100,0,0)
    I_BD P 0 A_TakeInventory("CutterFlag")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    I_BD P 0 A_CustomMissile("RushCoilDownDEDetect",-26,0,0,2,0)
    I_BD PP 1 A_JumpIfInventory("UOnce",1,"BOOSTEMDOWN")
    goto PlaceHolder+1
   BOOSTEMDOWN:
    I_BD P 0 A_PlaySound("S_2/Spring",1,0.85)
    I_BD PPPPPPPPPPPPPPPPPP 1
    I_BD P 0 A_TakeInventory("UOnce")
    I_BD P 0 A_SpawnItemEx("RushCoilDEBoom",0,0,16)
    I_BD O 2 A_CountDown
    Goto PlaceHolder
   Death:
    I_BD O 0 A_ChangeFlag("NOINTERACTION",0)
    I_BD O 0 ThrustThingZ(0,15,0,1)
    I_BD O 1 A_Fadeout(0.05)
    loop
  }
}

actor RushCoilDEJump_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_JumpIf(velx > frandom(0, 1), "No")
    TNT1 A 0 A_CheckFloor(1)
    stop
    TNT1 M 0 A_PlaySound("S_2/Spring", 1, 0.85)
    TNT1 A 0 A_GiveInventory("CutterFlag")
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor RushCoilDEBoom : BasicExplosion
{
Damagetype "SpringEye"
Obituary "%o had some trouble using a springhat demoneye."
States
{
Spawn:
TNT1 A 0
TNT1 A 3 A_Explode(75,32,0,0,32)
stop
}
}

actor RushCoilDEDetect : BasicProjectile {
  var int user_NoTranslation;
  Damagetype "SpringEye"
  Obituary "%o had some trouble using %k's springhat demoneye."
  +THRUGHOST
  +SKYEXPLODE
  +DONTSPLASH
  +DONTBLAST
  +HITTRACER
  Damage (0)  //25
  radius 46
  height 90
  Speed 0
  States {
   Spawn:
    TNT1 A 2
    stop
   Crash:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("UOnce",1)
    TNT1 A 1 A_JumpIf(ACS_NamedExecuteWithResult("uh_istracerplayer")==1,"GiveSpring")
    stop
   GiveSpring:
    TNT1 A 1 A_GiveInventory("RushCoilDEBoost_P",1,8)
    stop
   Death:
    TNT1 A 0 
    TNT1 A 1
    stop
  }
}

actor RushCoilDownDEDetect : RushCoilDEDetect {
  States {
   GiveSpring:
    TNT1 A 1 A_GiveInventory("RushCoilDownDEBoost_P", 1, 8)
    stop
  }
}

actor RushCoilDEBoost_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0
TNT1 A 0 ThrustThingZ(0,100,0,0)
goto End
}
}

actor RushCoilDownDEBoost_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0
TNT1 A 0 ThrustThingZ(0,100,1,0)
goto End
}
}

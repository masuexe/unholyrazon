actor LoliBalloonItem : UnholyItem
{
Tag "$TAG_P_BOX13"
inventory.amount 3
inventory.pickupmessage "\caKawaii \cgDe\cdsu\c-! Loli-Balloons!"
inventory.icon "PANBOX13"
states
{
Spawn:
I_BA M 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("assists_L/item1spawn","Item")  // misc_L/gutslift
UseX_Silent:
TNT1 A 0 A_SpawnItemEx("LoliBalloon",56,0,38,1,0,0,0,0,0)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"UseX_S")
goto End
UseX_S:
TNT1 A 0 A_SpawnItemEx("LoliBalloon",0,56,38,0,1,0,0,0,0)
TNT1 A 0 A_SpawnItemEx("LoliBalloon",0,-56,38,0,-1,0,0,0,0)
goto End

}
}
actor AutoLoliBalloonItem : LoliBalloonItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoLoliBalloonItemSilent : AutoLoliBalloonItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor LoliBalloonItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA M 0
            goto Spawn2
    }
}


actor LoliBalloon : ProjSpawnFuncNoClassTranslationActor {
Translation "192:192=4:4", "198:198=34:34"
damagetype "LoliBalloon"
Obituary "%o fell in love with %k's Loli-Balloon."
+FORCEYBILLBOARD
+NOGRAVITY
-SHOOTABLE
+SOLID
+NEVERTARGET
+DONTDRAIN
+NOTAUTOAIMED
ReactionTime 50
radius 24
height 4
scale 2.5
States
{
Spawn:
I_BM A 0
I_BM A 0 A_Stop
goto Spawn1
Spawn1:
I_BM A 0 A_Explode(8,66,0)
I_BM A 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM A 2 A_Countdown
I_BM B 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
goto Spawn2
Spawn2:
I_BM B 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM B 2 A_Countdown
I_BM A 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
goto Spawn1
Spawn1_S:
I_BM C 0 A_TakeInventory("BalloonTouchedFlag")
I_BM C 0 A_Explode(8,66,0)
I_BM C 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM C 2 A_Countdown
I_BM D 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
I_BM D 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM D 2 A_Countdown
I_BM C 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
goto Spawn1
Spawn2_S:
I_BM D 0 A_TakeInventory("BalloonTouchedFlag")
I_BM D 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM D 2 A_Countdown
I_BM C 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn1_S")
I_BM C 0 A_Explode(8,66,0)
I_BM C 0 A_SpawnItemEx("BalloonMM4Detect",0,0,12)
I_BM C 2 A_Countdown
I_BM D 0 A_JumpIfInventory("BalloonTouchedFlag",1,"Spawn2_S")
goto Spawn2

Death:
X_3D B 2 A_ChangeFlag("SOLID",0)
YMFX C 2
TMFX ACD 2
stop
}
}

Actor BalloonTouchedFlag : Once {}

actor BalloonMM4Detect
{
PROJECTILE
+SKYEXPLODE
+DONTBLAST
+DONTREFLECT
+THRUGHOST
+CLIENTSIDEONLY
//+SERVERSIDEONLY
RenderStyle "None"
Damage (0)
radius 24
height 4
Speed 0
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 2
stop
Death:
TNT1 A 0
TNT1 A 0 A_GiveToTarget("BalloonTouchedFlag",1)
stop
}
}


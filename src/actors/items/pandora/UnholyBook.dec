actor UnholyBookItem : UnholyItem {
  Tag "$TAG_P_BOX33"
  inventory.pickupmessage "Mysteries Await! Unholy Book!"
  Inventory.Icon "PANBOX33"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_BB H 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("items/UnholyBook", "SoundSlot7")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("UnholyBookToss", 0, 0, 0, 0)
    goto End
  }
}
actor AutoUnholyBookItem : UnholyBookItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoUnholyBookItemSilent : AutoUnholyBookItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor UnholyBookItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BB H 0
    goto Spawn2
  }
}



actor UnholyBookToss : BasicNoClassTranslationProjectile {
  DamageType "UnholyBook"
  Obituary "%k couldn't send %o to hell."
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUACTORS
  +DONTREFLECT
  +DONTSPLASH
  +BOUNCEONCEILINGS
  +BOUNCEONWALLS
  BounceFactor 0.4
  WallBounceFactor 0.75
  BounceCount 10
  Gravity 0.95
  Damage (0)
  Radius 12
  Height 12
  Speed 26
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    I_CH A 1 ThrustThingZ(0, 30, 0, 1)
    I_CH A 1
    wait

   Death:
    I_CH B 0 A_SetGravity(0.0)
    I_CH B 0 A_Stop
    I_CH B 0 A_SpawnItemEx("UnholyBookSuctionHelper", 0, 0, 16)
    I_CH B 0 A_PlaySoundEx("S3_K/LaserCharge", "Weapon")
    I_CH BCBCBCBCBCBC 3 A_SpawnItemEx("UnholyBookTossFX1")
    I_CH BCBCBCBCBCBCBC 2 A_SpawnItemEx("UnholyBookTossFX1")
    I_CH BCBCBC 1 A_SpawnItemEx("UnholyBookTossFX1")
    I_CH BCBCBCBC 1
    I_CH C 10
    I_CH C 0 A_PlaySoundEx("S3_K/FireExplosion", "Weapon")
    I_CH C 0 A_SpawnItemEx("UnholyBookLaser")
    I_CH C 1 A_FadeOut
    wait
  }
}

actor UnholyBookSuctionHelper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    // Razon 3: one 32/256 roll per book; most books keep the normal radius.
    TNT1 A 0 A_Jump(32, "SuperSuck")
    BLKH FGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLM 1 ACS_NamedExecuteWithResult("uh_radiuspull", 40, 256, 0)
    goto ReleaseThrust
   SuperSuck:
    BLKH FGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLMNOPQFGHIJKLM 1 ACS_NamedExecuteWithResult("uh_radiuspull", 40, 8192, 0)
   ReleaseThrust:
    TNT1 A 0 A_SpawnItemEx("UnholyBookThrustShot", 0, 0, 0, 0, 0, 300)
    TNT1 A 0 A_SpawnItemEx("UnholyBookThrustShot", 0, 0, 0, 0, 0, 600)
    TNT1 A 0 A_SpawnItemEx("UnholyBookThrustShot", 0, 0, 0, 0, 0, 900)
    TNT1 A 0
    TNT1 AAAAA 1 A_RadiusGive("UnholyBookThrust_P", 196, RGF_PLAYERS, 1)
    stop
  }
}
actor UnholyBookSuctionHelper2 : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 1 A_RadiusGive("UnholyBookThrust_P", 196, RGF_PLAYERS, 1)
    stop
  }
}

actor UnholyBookThrustShot {
  Projectile
  +DONTBLAST
  +THRUACTORS
  +THRUGHOST
  Radius 10
  Height 10
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("UnholyBookSuctionHelper2")
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor UnholyBookThrust_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_ChangeVelocity(0, 0, 5, 3)
    stop
  }
}

actor UnholyBookTossFX1 : BasicClientSide {
  Translation "192:192=176:176", "198:198=182:182"
  var int user_A;
  ReactionTime 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_A", random(0, 30))
    TNT1 A 0 A_SpawnItemEx("UnholyBookTossFX2", random(182, 222), 0, random(0, 16), random(-18, -20), 0, 0, user_A + random(-15, 15), 37, 224)

    TNT1 A 0 A_SpawnItemEx("UnholyBookTossFX2", random(172, 212), 0, random(28, 44), random(-17, -19), 0, random(-6, -9), user_A + random(-20, 20), 37, 224)
    TNT1 A 0 A_SpawnItemEx("UnholyBookTossFX2", random(172, 212), 0, random(-28, -12), random(-17, -19), 0, random(6, 9), user_A + random(-20, 20), 37, 224)

    TNT1 A 0 A_SpawnItemEx("UnholyBookTossFX3", random(172, 212), 0, random(56, 72), random(-16, -18), 0, random(-6, -11), user_A + random(-25, 25), 37, 224)
    TNT1 A 0 A_SpawnItemEx("UnholyBookTossFX3", random(172, 212), 0, random(-56, -40), random(-16, -18), 0, random(6, 11), user_A + random(-25, 25), 37, 224)
    TNT1 A 0 A_SetUserVar("user_A", user_A + 30)
    TNT1 A 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    stop
  }
}

actor UnholyBookTossFX2 : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    I_CH HHHIIIJJJ 1 A_ChangeVelocity(velx * 1.1, vely * 1.1, velz * 0.925, 2)
    stop
  }
}

actor UnholyBookTossFX3 : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    I_CH HHHIIIJJJ 1 A_ChangeVelocity(velx * 1.115, vely * 1.115, velz * 0.85, 2)
    stop
  }
}

actor UnholyBookLaser : BasicNoClassTranslationExplosion {
  Translation "192:192=176:176", "198:198=182:182"
  DamageType "UnholyBook"
  Obituary "%k told %o to go to hell."
  +OLDRADIUSDMG
  +PIERCEARMOR
  Radius 12
  Height 64  // 640
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("UnholyBookLaserUpFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("UnholyBookLaserDownFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 3  // 6
    TNT1 AAAAAAAAAAAA 1 A_Explode(7000000, 96, 1, 0, 97)
    TNT1 A 2
    stop
  }
}

actor UnholyBookLaserUpFX : BasicClientSide {
  States {
   Spawn:
    I_CH D 0
    I_CH D 0 A_JumpIf(ceilingz - z <= 50, "Spawn2")
    I_CH D 0 A_SpawnItemEx("UnholyBookLaserUpFX2", 0, 0, 50, 0, 0, 0, 0, 1)
   Spawn2:
    I_CH D 1
    I_CH E 1  // 2
    I_CH F 1  // 3
    I_CH G 12  // 4
    I_CH F 2
    I_CH E 3
    I_CH D 4
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor UnholyBookLaserUpFX2 : UnholyBookLaserUpFX {
  States {
   Spawn:
    I_CH D 0
    I_CH D 0 A_JumpIf(ceilingz - z <= 50, "Spawn2")  // Death
    I_CH D 0 A_SpawnItemEx("UnholyBookLaserUpFX2", 0, 0, 50, 0, 0, 0, 0, 1)
    goto Spawn2
  }
}

actor UnholyBookLaserDownFX : UnholyBookLaserUpFX {
  States {
   Spawn:
    I_CH D 0
    I_CH D 0 A_JumpIf(floorz - z >= 0, "Spawn2")
    I_CH D 0 A_SpawnItemEx("UnholyBookLaserDownFX2", 0, 0, -50, 0, 0, 0, 0, 1)
    goto Spawn2
  }
}

actor UnholyBookLaserDownFX2 : UnholyBookLaserUpFX {
  States {
   Spawn:
    I_CH D 0
    I_CH D 0 A_JumpIf(floorz - z >= 0 || ceilingz - z <= 50, "Spawn2")  // Death
    I_CH D 0 A_SpawnItemEx("UnholyBookLaserDownFX2", 0, 0, -50, 0, 0, 0, 0, 1)
    goto Spawn2
  }
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_UnholyBook : BasicACSDamager {
  DamageType "UnholyBook"
  Obituary "%o went to hell with their own Unholy Book while fighting %k."
}

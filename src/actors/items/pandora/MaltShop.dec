actor SundaeFoodItem : UnholyItem
{
Tag "$TAG_P_BOX31"
inventory.amount 1
inventory.pickupmessage "Got a sundae from the Malt Shop!"
inventory.icon "PANBOX31"
States
{
Spawn:
I_BB F 6
loop
Use:
UseX:
TNT1 A 0 A_PlaySoundEx("item/energyup","Item")
TNT1 A 0 A_PlaySoundEx("items/EatDrink","SoundSlot5")
UseX_Slient:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_ADD_MAX, 500)
goto End
}
}
actor AutoSundaeFoodItem : SundaeFoodItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
        goto UseX
    }
}
actor AutoSundaeFoodItemSilent : AutoSundaeFoodItem {
    States {
        Pickup:
        goto UseX_Silent
    }
}
actor SundaeFoodItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BB F 0
            goto Spawn2
    }
}

actor HamburgerFoodItem : UnholyItem
{
Tag "$TAG_P_BOX30"
inventory.amount 1
inventory.pickupmessage "SHUT UP, PEGGY. 'MERICA."
inventory.icon "PANBOX30"
States
{
Spawn:
I_BB E 6
loop
Use:
UseX:
TNT1 A 0 A_PlaySoundEx("item/energyup","Item")
TNT1 A 0 A_PlaySoundEx("items/EatBurger","SoundSlot5")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 2000)
goto End
UseX2:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 2000)
goto End
}
}
actor AutoHamburgerFoodItem : HamburgerFoodItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoHamburgerFoodItemSilent : AutoHamburgerFoodItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor HamburgerFoodItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BB E 0
            goto Spawn2
    }
}


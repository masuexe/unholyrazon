actor MaltShopItem : UnholyItem
{
Tag "$TAG_P_BOX26"
inventory.amount 1
inventory.pickupmessage "LET'S ALL HEAD TO THE MALT SHOP."
inventory.icon "PANBOX26"
states
{
Spawn:
I_BB A 6
Loop
UseX:
TNT1 A 0 A_SpawnItemEx("MaltShopSound")
UseX_Slient:
TNT1 A 0 A_SpawnItemEx("MaltShopDelayer")
goto End
}
}
actor AutoMaltShopItem : MaltShopItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoMaltShopItemSilent : AutoMaltShopItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor MaltShopItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA I 0
            goto Spawn2
    }
}

actor MaltShopSound : BasicSoundFollow
{
PainSound "items/maltshop"
ReactionTime 70
}

Actor MaltShopDelayer : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAAAAAA 10 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_GiveToTarget("UH_ArtiTeleport_P",1)
TNT1 A 0 A_Jump(64,"Burger")
TNT1 A 0 A_Jump(96,"Malt")
TNT1 A 0 A_Jump(128,"Pancake")
TNT1 A 0 A_Jump(198,"Cake")
TNT1 A 0 A_GiveToTarget("HotdogFoodItem",3)
stop
Burger:
TNT1 A 0 A_GiveToTarget("HamburgerFoodItem",1)
stop
Malt:
TNT1 A 0 A_GiveToTarget("SundaeFoodItem",1)
stop
Pancake:
TNT1 A 0 A_GiveToTarget("PancakeFoodItem",1)
stop
Cake:
TNT1 A 0 A_GiveToTarget("CakeFoodItem",2)
stop
}
}

actor UnholyWSpawner : BasicProjectile
{
Translation "192:192=176:176", "198:198=191:191", "0:0=223:223"
Damagetype "UnholyWater"
Obituary "%o could not face %k's Unholy Water."
+RIPPER
-NOGRAVITY
+DONTREFLECT
ReactionTime 35
Damage(20)
Radius 6
Height 6
Scale 1.0
States
{
Spawn:
WTRB B 0
WTRB C 1 ThrustThingZ(0,100,1,0)
WTRB D 2 A_CountDown
Goto Spawn+2
Crash:
Death:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("UnholyWaterTower")
TNT1 A 1 //A_SpawnItemEx("UnholyWater",0,0,0,8)
stop
}
}

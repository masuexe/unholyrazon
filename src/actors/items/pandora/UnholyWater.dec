actor UnholyWaterItem : UnholyItem
{
Tag "$TAG_P_BOX24"
inventory.amount 1
inventory.pickupmessage "UNHOLY WATER!"
Inventory.icon "PANBOX24"
States
{
Spawn:
I_BA X 6
loop
UseX:
TNT1 A 0 A_PlaySoundEx("item/UnholyWater1","Item")
UseX_Silent:
TNT1 A 0 A_JumpIfInventory("BAWS",1,"UseX2")
TNT1 A 0 A_GiveInventory("UnholyWaterSpeed")
TNT1 A 0 A_FireCustomMissile("UnholyWaterShot",0,0,0,0)
goto End
UseX2:
TNT1 A 0 A_FireCustomMissile("UnholyWaterShotB",0,0,0,0)
goto End
}
}
actor AutoUnholyWaterItem : UnholyWaterItem {
    Inventory.PickupSound ""
    Inventory.MaxAmount 0
    +ALWAYSPICKUP
    States {
        Pickup:
            goto UseX
    }
}
actor AutoUnholyWaterItemSilent : AutoUnholyWaterItem {
    States {
        Pickup:
            goto UseX_Silent
    }
}
actor UnholyWaterItemFX : UnholyItemFX {
    States {
        Spawn: 
            I_BA X 0
            goto Spawn2
    }
}

actor UnholyWaterSpeed : PowerSpeed
{
powerup.color blue 0.45
powerup.duration -6
Speed 4.5
}


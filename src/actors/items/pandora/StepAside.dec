actor StepAsideItem : UnholyItem {
  Tag "$TAG_P_BOX10"
  inventory.pickupmessage "Oh Noes! Get Away!"
  Inventory.Icon "PANBOX10"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_BA J 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/refill", "Item")
   UseX_Silent:
    TNT1 A 0 A_FireCustomMissile("StepAsideExplode", 0, 0, 0, 0)
    goto End
  }
}
actor AutoStepAsideItem : StepAsideItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoStepAsideItemSilent : AutoStepAsideItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor StepAsideItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA J 0
    goto Spawn2
  }
}


actor StepAsideExplode : BasicExplosion {
  DamageType "StepAsideFling"
  Obituary "%o wrote a love song about %k."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(85, 1001, 0, 0, 16)
    TNT1 A 0 A_SpawnItemEx("StepAsideExplodeFX_H", 0, 0, 0, 0, 0, 0, random(0, 359), 32)
    // TNT1 A 1 ACS_ExecuteAlways(247,0,-500,1000) //No
    TNT1 AAAAA 1 A_GiveToTarget("Repulsion", 1)  // Just A_Blast
    stop
  }
}

actor StepAsideExplodeFX_H : BasicNoClassTranslationGraphicEffect {
  RenderStyle "None"
  ReactionTime 36
  States {
   SpawnFrame:
    TNT1 A 0
   SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("StepAsideExplodeFX0", 32, 0, 0, cos(60) * random(80, 120), 0, sin(60) * random(90, 110), ReactionTime * 10 + random(-3, 3), 32)
    TNT1 A 0 A_SpawnItemEx("StepAsideExplodeFX0", 32, 0, 0, cos(20) * random(80, 120), 0, sin(20) * random(90, 110), ReactionTime * 10 + random(-3, 3), 32)
    TNT1 A 0 A_SpawnItemEx("StepAsideExplodeFX0", 32, 0, 0, cos(20) * random(80, 120), 0, -sin(20) * random(90, 110), ReactionTime * 10 + random(-3, 3), 32)
    TNT1 A 0 A_SpawnItemEx("StepAsideExplodeFX0", 32, 0, 0, cos(60) * random(80, 120), 0, -sin(60) * random(90, 110), ReactionTime * 10 + random(-3, 3), 32)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 0
    stop
  }
}


actor StepAsideExplodeFX0 : BasicNoClassTranslationGraphicEffect {
  // 198 207
  Translation "192:192=204:204", "198:198=206:206"
  +NOBLOCKMONST
  +NOBLOCKMAP
  +SLIDESONWALLS
  -MISSILE
  +DONTBLAST
  +THRUACTORS
  // RenderStyle "None"
  Radius 4
  Height 4
  Scale 4.0
  States {
   SpawnFrame:
    X_5A A 0
    X_5A A 1
    X_5A AAAAA 1 A_SetScale(scaleX - 0.5, scaleY)
    stop
    // X_5A A 1 A_Fadeout(0.15)
    // wait
  }
}

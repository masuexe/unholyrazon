	  TNT1 A 0
	  TNT1 A 0
	  TNT1 A 2 A_SpawnItemEx("IceWaveIcicleWallUX", 0, 0, 0, 0, 0, 0, 0, 1)
	  Goto Spawn+1
	 Death:
	  TNT1 A 0 A_SpawnItemEx("IceWaveUX", 0, 0, 0, 20, 0, 0, 0, 1)
	  stop
	}
}

actor IceWaveUpUX : IceWaveUX {
	+DONTBLAST
	States {
	 Spawn:
	  TNT1 A 2
	  TNT1 A 0
	  TNT1 A 0
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleWallUX", 0, 0, 0, 0, 0, 0, 180, 1)
	  TNT1 A 0 A_ChangeVelocity(20, 0, 0, 3)
	  TNT1 A 1
	  TNT1 A 0 A_SpawnItemEx("IceWaveUX", 0, 0, 0, 20, 0, 0, 0, 1)
	  stop
	 Death:
	  TNT1 A 0 A_JumpIf(ceilingz-z > 48, "Continue")
	  TNT1 A 0
	  stop
	 Continue:
	  TNT1 A 0 A_SpawnItemEx("IceWaveUpUX", 0, 0, 4, 0, 0, 20, 0, 1)
	  stop
	}
}


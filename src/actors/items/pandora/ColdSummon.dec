// Cold Dragoon's greatest legacy

actor ColdSummonItem : UnholyItem {
	tag "$TAG_RZ_PBOX05"
	inventory.pickupmessage "The Dragon of Destruction."
	inventory.icon "RZTI_05"
	scale 2.0
	States {
	 Spawn:
	  I_RP E 6
	  loop
	 UseX:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIfInventory("ColdDragoonFlag", 1, "UseNo")
	  TNT1 A 0 A_PlaySoundEx("weapon/BNBombToss", "Weapon")
	  goto UseX_Do
	 UseX_Silent:
	  TNT1 A 0 A_JumpIfInventory("ColdDragoonFlag", 1, "UseNo")
	 UseX_Do:
	  TNT1 A 0 A_GiveInventory("ColdShield", 1)
	  TNT1 A 0 A_FireCustomMissile("ColdmanSD", 0, 0, 0)
	  TNT1 A 0 A_GiveInventory("ColdDragoonFlag")
	  goto End
	 UseNo:
	  TNT1 A 0 A_PlaySoundEx("GNT/FailUse", "Item")
	  fail
	}
}

actor AutoColdSummonItem : ColdSummonItem {
	Inventory.PickupSound ""
	Inventory.MaxAmount 0
	+ALWAYSPICKUP
	States {
	 Pickup:
	  goto UseX
	}
}
actor AutoColdSummonItemSilent : AutoColdSummonItem {
	States {
	 Pickup:
	  goto UseX_Silent
	}
}
actor ColdSummonItemFX : UnholyItemFX {
	States {
	 Spawn:
	  I_RP E 0
	  goto Spawn2
	}
}

actor ColdDragoonFlag : Once {}

actor ColdShield : BasicArmorPickup {
	Armor.Savepercent 100
	Armor.Saveamount 4000
}

// Local effects used by ColdSummon; the standalone razon3 Stoptagon actor was
// removed, so keep this damage effect scoped to the summon.
actor ColdSummonStoptagonExplosion : BasicExplosion {
	Obituary "%o was stopped to watch the ducks cross the road."
	DamageType "Stoptagon"
	ReactionTime 35
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 1 A_Explode(1, 1024, 0, 0, 1024)
	  TNT1 A 0 A_Countdown
	  loop
	}
}

// Use the current UH sparkle base while retaining the old white translation.
actor ColdSummonTimeStopSparkleFX : FlashM_SparkleFX_Base {
	Translation "198:198=4:4", "192:192=4:4"
}

actor ColdSummonTimeStopSparkleHelper : BasicWatcher {
	ReactionTime 3
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItemEx("ColdSummonTimeStopSparkleFX", random(-512, 512), random(-512, 512), random(-512, 512), 0, 0, 0, 0, 129)
	  TNT1 A 2 A_Countdown
	  loop
	}
}

actor ColdmanSD : BasicNoClassTranslationProjectile {
	translation "192:192=69:69", "198:198=198:198"  // , "249:249=119:119", "250:250=85:85"
	DamageType "Item"
	Damage (350)
	Speed 10
	+RIPPER
	+NOEXPLODEFLOOR
	+DONTBLAST
	+THRUGHOST
	-NOGRAVITY
	+BOUNCEONWALLS
	+BOUNCEONFLOORS
	+ALLOWBOUNCEONACTORS
	+BOUNCEONACTORS
	+CANBOUNCEWATER
	bouncecount 20
	bouncefactor 0.001
	+SEEKERMISSILE
	+MISSILEMORE
	+MISSILEEVENMORE
	+LOOKALLAROUND
	Radius 12
	Height 32
	States {
	 Spawn:
	  TNT1 A 0
	  CLSD A 0 A_Explode(10, 128, 0, 0, 200)
	  CLSD A 1 A_JumpIf(z-floorz==0, "Floor")
	  wait

	 Floor:
	  CLSD G 0 A_SpawnItemEx("ColdSummonStoptagonExplosion", 0, 0, 0, 0)
	  CLSD G 0 A_PlaySoundEx("misc/hugequake", "Weapon")
	  CLSD G 0 Radius_Quake(8, 50, 0, 125, 0)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*1, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*2, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*3, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*4, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*5, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*6, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*7, 1)
	  CLSD G 0 A_SpawnItemEX("ColdShockwave", 32, 0, 0, 50, 0, 0, 360/8*8, 1)
	  CLSD G 1 A_SeekerMissile(130, 130, SMF_LOOK|SMF_PRECISE|SMF_CURSPEED, 50, 10)
	  TNT1 A 0 A_JumpIfTargetInLOS("Missile", 0, JLOSF_PROJECTILE)
	  goto MissileFail
	 MissileFail:
	  TNT1 A 0 A_ClearTarget
	 Missile:
	  CLSD G 3 A_FaceTracer(0, 0)
	  CLSD G 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
	  CLSD G 0 A_CustomMissile("IceWallPinpoint", 32, 8, 0, CMF_AIMDIRECTION)
	  CLSD G 18
	  CLSD G 0
	  CLSD BCDEBCDE 1 A_Wander
	  CLSD F 0 A_SpawnItemEx("HamburgerFoodItem")
	  CLSD BCDEBCDE 1 A_Wander
	  CLSD F 0 A_SpawnItemEx("HamburgerFoodItem")
	  CLSD BCDEBCDE 1 A_Wander
	  CLSD F 0 A_SpawnItemEx("HamburgerFoodItem")
	  CLSD BCDE 1 A_Wander
	  CLSD F 0 A_PlaySound("weapon/timestopper", CHAN_WEAPON|CHAN_NOPAUSE, 1, 0, 0)
	  CLSD F 1 A_SpawnItemEx("BlackHoleBombExplosionUS", 0, 0, 32, 0, 0, 0, 0, 1)
	  stop
	}
}

Actor IceWallPinpoint : FastProjectile {
	translation "192:192=69:69", "198:198=198:198"
	PROJECTILE
	Damagetype "Icewall"
	Obituary "%o felt the chills from %k's Ice Wall Beam ("
	+SKYEXPLODE
	+DONTBLAST
	+RIPPER
	Reactiontime 5
	Damage (666666)
	radius 10
	height 10
	speed 125
	Scale 2.5
	States {
	 Spawn:
	  TMFX B 0
	  TMFX BBBBBBBBBBBBBBBBBBBBB 1 A_SpawnItemEx("IceWallBeamFX")
	  TMFX B 1 A_CountDown
	  loop
	 Death:
	  TNT1 A 0 A_SpawnItemEx("IceWallBeamDeath", 0, 0, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 Radius_Quake(8, 50, 0, 125, 0)
	  TNT1 A 0 A_SpawnItemEx("IceExplode1", 0, 0, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU1", 0, 0, 0, 0, 0, 0, 0)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU1", 0, 0, 0, 0, 0, 0, 135)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU1", 0, 0, 0, 0, 0, 0, -135)
	  stop
	 Crash:
	  TNT1 A 0
	  stop
	}
}

Actor IceWallBeamFX : BasicNoClassTranslationGraphicEffect {
	Translation "192:192=205:205", "198:198=77:77"
	Renderstyle "Add"
	Scale 2.0
	States {
	 Spawn:
	  TMFX BCD 2
	  stop
	}
}

Actor IceWallBeamDeath : BasicNoClassTranslationExplosion {
	DamageType "Item"
	Obituary "%o felt the chills from %k's Ice Wall ("
	+FORCEXYBILLBOARD
	+BRIGHT
	Scale 2.5
	States {
	 Spawn:
	  TNT1 A 0
	  X_8B A 1 A_PlaySoundEx("misc/mm3explosion", "Voice")  // want a better sound for ice wall being broken by a beam pinpoint
	  X_8B AAAAAAAAAA 0 A_SpawnItemEx("IceWallDeathFX", 0, 0, 4, random(3, 13), 0, random(3, 15), random(0, 359))
	  X_8B A 1 A_Explode(260, 128, 0, 0, 24)  // 300,150,0,0,30
	  X_8B BCDEF 2
	  stop
	}
}

Actor IceWallDeathFX : BasicNoClassTranslationGraphicEffectM {
	BounceSound "item/protoreflect"
	PROJECTILE
	-NOGRAVITY
	// +DOOMBOUNCE
	+BOUNCEONCEILINGS
	+BOUNCEONFLOORS
	+BOUNCEONWALLS
	+ALLOWBOUNCEONACTORS
	+BOUNCEAUTOOFF
	+DONTSPLASH
	+DONTBLAST
	Bouncecount 4
	Bouncefactor 0.8
	WallBouncefactor 0.8
	Damage 0
	Radius 6
	Height 6
	Speed 10
	Scale 2.0
	States {
	 SpawnFrame:
	  ICWB UVWXUVWXUVWXUVWXUVWX 3
	  stop
	 Death:
	  TNT1 A 0
	  stop
	}
}

actor MissileBitU1 : BasicNoClassTranslationProjectile {
	damagetype "ChillSpike"
	Obituary "%o felt the chills from %k's Ice BIT ("
	+NOINTERACTION
	ReactionTime 53
	Height 15
	Radius 15
	scale 2.5
	damage (0)
	speed 0
	var int user_speed;
	var int user_maxturn;
	var int user_turndivisor;
	var int user_turndivisor_add;
	States {
	 Spawn:
	  LV4M A 0
	  TNT1 A 0 A_SetUserVar("user_speed", 18)
	  TNT1 A 0 A_SetUserVar("user_maxturn", 10000)
	  TNT1 A 0 A_SetUserVar("user_turndivisor", 80)
	  TNT1 A 0 A_SetUserVar("user_turndivisor_add", 10)
	  TNT1 A 0 A_SetAngle(angle-user_maxturn/user_turndivisor)
	  LV4M A 1 A_ChangeVelocity(user_speed, 0, 0, CVF_RELATIVE|CVF_REPLACE)
	  TNT1 A 0 A_SetUserVar("user_turndivisor", user_turndivisor+user_turndivisor_add)
	 loopit:
	  TNT1 A 0 A_SetAngle(angle-user_maxturn/user_turndivisor)
	  LV4M A 1 A_ChangeVelocity(user_speed, 0, 0, CVF_RELATIVE|CVF_REPLACE)
	  TNT1 A 0 A_SetUserVar("user_speed", user_speed+1)
	  TNT1 A 0 A_SetUserVar("user_turndivisor", user_turndivisor+user_turndivisor_add)
	  TNT1 A 0 A_Explode(100, 100, 0)
	  LV4M A 0 A_CountDown
	  LV4M A 4 A_SpawnItemEx("IceWaveDropperUX", 32, 0, 0, 0, 0, 0, 0, 1)
	  loop
	 Death:
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItemEx("IceExplode1", 0, 0, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU2", 0, 0, 0, 0, 0, 0, 45)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU2", 0, 0, 0, 0, 0, 0, 135)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU2", 0, 0, 0, 0, 0, 0, -135)
	  TNT1 A 0 A_SpawnItemEx("MissileBitU2", 0, 0, 0, 0, 0, 0, -45)
	  stop
	}
}


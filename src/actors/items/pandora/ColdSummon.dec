actor BlueBoxDE : UH_ShootableItemActor {
	translation "192:192=69:69", "198:198=198:198"
	-ISMONSTER
	-COUNTKILL
	+SHOOTABLE
	+NOBLOOD
	-SOLID
	+DONTCORPSE
	painsound "misc/devilpain"
	deathsound "misc/devildeath"
	DropItem "DickHatItemX" 256 1
	Health 99999
	Mass 500
	gravity 0.8
	painchance 64
	Damage (0)
	Radius 20
	Height 52
	Speed 50
	scale 2.5
	States {
	 Spawn:
	  I_BD N 0
	  I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
	  I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
	  I_BD NNNNNNNNNNNNNNNNNNNN 1 A_Wander
	  I_BD NNNNNNNNNN 1 A_Wander
	  I_BD N 0 A_JumpIfInventory("WeaponCharge", 10, "DeathTimer")
	  I_BD N 0 A_GiveInventory("U_PSN", random(1, 2))
	  I_BD N 0 A_JumpIfInventory("U_PSN", 5, "ATK")
	  I_BD N 0 A_Jump(32, "Spawn3")
	  I_BD N 0 A_Jump(64, "Spawn2")
	  I_BD N 0 A_Jump(128, "Spawn1")
	  loop
	 Spawn1:
	  I_BD N 0
	  goto Spawn+20
	 Spawn2:
	  I_BD N 0
	  goto Spawn+40
	 Spawn3:
	  I_BD N 0
	  goto Spawn+60
	 ATK:
	  I_BD N 0 A_Stop
	  I_BD N 1 A_TakeInventory("U_PSN", 6)
	  I_BD N 0 A_GiveInventory("WeaponCharge", 1)
	  I_BD N 0 A_ChangeVelocity(0, 0, 6)
	  I_BD N 0 A_PlaySoundEx("weapon/TDRCharge", "Weapon")
	  I_BD N 0 A_SpawnItemEx("ColdSummonTimeStopSparkleHelper")
	  I_BD N 1 A_SpawnItemEx("KickAuraDamageRadiusU")
	  I_BD N 0 A_Jump(16, "Spawn3")
	  I_BD N 0 A_Jump(32, "Spawn2")
	  I_BD N 0 A_Jump(64, "Spawn1")
	  Goto Spawn+1
	 Pain:
	  I_BD N 0 A_Pain
	  I_BD N 0 A_Jump(32, "Spawn3")
	  I_BD N 0 A_Jump(64, "Spawn2")
	  I_BD N 0 A_Jump(128, "Spawn1")
	  goto Spawn+1
	 DeathTimer:
	  I_BD N 0 A_ChangeFlag("INVULNERABLE", 1)
	  I_BD N 0 A_ChangeFlag("DONTBLAST", 1)
	  I_BD N 0 A_ChangeFlag("NOGRAVITY", 1)
	  I_BD N 6 A_Stop
	  I_BD N 0 A_ChangeVelocity(0, 0, 8, 3)
	  I_BD NNNNNNNNNN 1 A_FadeOut(0.1, 0)
	  I_BD N 1 A_SpawnItemEx("ColdmanSD2", 0, 0, 0, 0, 0, 6)
	  stop
	 Death:
	  I_BD N 0 A_Fall
	  I_BD N 20 A_Stop
	  I_BD N 0 A_Scream
	  I_BD N 0
	  TNT1 A 0 A_CustomMissile("FakeDeathFX")
	  TNT1 A 70
	  stop
	}
}

actor BlueBoxDE_Spread : BlueBoxDE {
	States {
	 DeathTimer:
	  I_BD N 0 A_ChangeFlag("INVULNERABLE", 1)
	  I_BD N 0 A_ChangeFlag("DONTBLAST", 1)
	  I_BD N 0 A_ChangeFlag("NOGRAVITY", 1)
	  I_BD N 6 A_Stop
	  I_BD N 0 A_ChangeVelocity(0, 0, 8, 3)
	  I_BD NNNNNNNNNN 1 A_FadeOut(0.1, 0)
	  stop
	}
}


Actor IceWallD : ProjSpawnFuncNoClassTranslationActor {
	Translation "192:192=93:93", "198:198=0:0"
	DamageType "TDRManForcesYouToEatShitAndDie"
	Obituary "$%o felt the chills from %k's Apoptotic Ice Wall. ("
	+MISSILE
	+QUICKTORETALIATE
	-NOGRAVITY
	+RIPPER
	+NODAMAGETHRUST
	+NOTARGETSWITCH
	+NOEXPLODEFLOOR
	+BOUNCEONCEILINGS
	+CANBOUNCEWATER
	+NOBLOOD
	+DONTSPLASH
	+DONTREFLECT
	+DONTDRAIN
	+NOTAUTOAIMED
	+THRUSPECIES
	+STEPMISSILE
	+PIERCEARMOR
	Species "IceWall"
	PushFactor 0.1
	BounceFactor 0.9
	WallBounceFactor 0.9
	Bouncecount 6
	Maxstepheight 7
	Mass 0x7ffffffd
	Painchance "Normal", 0
	Painchance "IceWallBeam", 256
	Painchance "IceWallExplode", 256
	damagefactor "IceWall", 0.0
	Health 5000
	Damage (0)
	Radius 24
	Height 64
	speed 0
	scale 2.1
	States {
	 Spawn:
	  X_BD X 0
	  X_BD X 0 A_SetScale(2.1, 0.1)
	  X_BD XXXXXXXXXX 1 A_SetScale(2.1, scaleY+0.2)
	  X_BD X 0 A_ChangeFlag("SOLID", 1)
	  X_BD X 0 A_ChangeFlag("SHOOTABLE", 1)
	  X_BD X 0 ThrustThingZ(0, 35, 0, 1)
	  X_BD X 0 A_PlaySoundEx("weapon/icewallspawn", "Voice")
	 Spawn2:
	  X_BD X 0 A_JumpIfHealthLower(321, "Spawn2Low")
	  X_BD X 0 A_Explode(50, 72, 0)
	  X_BD X 1 Thing_Damage(0, 4)
	  loop
	 Spawn2Low:
	  X_BD YYYYYYYYYY 1 A_Explode(35, 72, 0)
	  X_BD Y 1 A_Die
	  wait
	 Death:
	  X_BD L 0
	  X_BD L 0 A_SetGravity(0.0)
	  X_BD L 0 A_ChangeFlag("SOLID", 0)
	  X_BD L 0 A_PlaySoundEx("misc/freeze", "Voice")
	  X_BD LM 5
	  TNT1 A 0 A_SpawnItemEx("IceExplode1", 0, 0, 0, 0, 0, 0, 0, 1)
	  stop
	}
}



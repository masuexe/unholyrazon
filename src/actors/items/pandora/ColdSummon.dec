actor IceWaveUX : BasicNoClassTranslationProjectile {
	+RIPPER
	+DONTREFLECT
	Damagetype "ChillSpike"
	Obituary "$OB_ICEWAVE"
	Damage (210)
	Speed 40
	Height 48
	Radius 10
	Scale 2.5
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorUUX", 0, 32, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorUUX", 0, -32, 0, 0, 0, 0, 0, 1)
	  TNT1 A 2 A_SpawnItemEx("IceWaveIcicleFloorUX", 0, 0, 0, 0, 0, 0, 0, 1)
	 SpawnL:
	  TNT1 A 0 A_CheckFloor("MakeIcicle")
	  TNT1 AA 1 A_JumpIf(z-floorz!=0, "Down")
	  Loop
	 MakeIcicle:
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorUUX", 0, 32, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorUUX", 0, -32, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorUX", 0, 0, 0, 0, 0, 0, 0, 1)
	  Goto SpawnL+1
	 Down:
	  TNT1 A 0 A_SpawnItemEx("IceWaveDownUX", 0, 0, 0, 0, 0, -20, 0, 1)
	  stop
	 Death:
	  TNT1 A 0 A_SpawnItemEx("IceWaveUpUX", 0, 0, 0, 0, 0, 20, 0, 1)
	  stop
	}
}

actor IceWaveDownUX : IceWaveUX {
	+DONTBLAST
	States {

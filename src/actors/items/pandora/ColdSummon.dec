actor IceWallUSD : ProjSpawnFuncNoClassTranslationActor {
	var int user_playerRiding[64];
	DamageType "ChillSpike"
	Obituary "%o felt the chills from %k's Apoptotic Ice Wall ("
	+MISSILE
	+RIPPER
	+PUSHABLE
	+SHOOTABLE
	+SOLID
	+NODAMAGETHRUST
	+NOTARGETSWITCH
	+NOEXPLODEFLOOR
	+BOUNCEONWALLS
	+ALLOWBOUNCEONACTORS
	+CANBOUNCEWATER
	+NOBLOOD
	+MOVEWITHSECTOR
	+DONTSPLASH
	+DONTRIP
	+DONTREFLECT
	+DONTDRAIN
	+NOTAUTOAIMED
	+THRUSPECIES
	+STEPMISSILE
	Maxstepheight 7
	species "MovingPlatform"
	+QUICKTORETALIATE
	PainChance 256
	Mass 9999999
	Health 10000
	BounceFactor 0.925
	WallBounceFactor 0.965
	DamageFactor "IceWall", 0.05
	Damage (180)
	Radius 24
	Height 64
	speed 0
	scale 2.1
	States {
	 Spawn:
	  X_BD X 0
	  X_BD X 1 A_SetArg(3, 121)
	 SpawnLoop:
	  X_BD X 1 A_CountDownArg(3)
	  X_BD X 0 A_JumpIf(momx>1||momy>1||momx<-1||momy<-1, "MoveBegin")
	  X_BD X 0 A_Explode(250, 56, 0, 0, 8)
	  loop
	 MoveBegin:
	  X_BD X 0 ACS_NamedExecuteAlways("core_stickyLifts", 0, STICKYMODE_GUTSLIFT)
	  X_BD X 0 A_ChangeFlag("PUSHABLE", 0)
	  X_BD X 1 ACS_ExecuteAlways(994, 0, 1)
	 Accelerate:
	  X_BD X 0 A_Recoil(-5)
	  X_BD XXXXX 1
	  X_BD X 0 A_Recoil(-4)
	  X_BD XXXXX 1
	  X_BD X 0 A_Recoil(-3.5)
	  X_BD XXXXX 1
	  X_BD X 0 A_Recoil(-3)
	  X_BD XXXXX 1
	  X_BD X 0 A_Recoil(-2.5)
	  X_BD XXXXX 1
	  Goto Moving
	 Moving:
	  X_BD X 1 A_CountDownArg(3)
	  X_BD X 0 A_JumpIf(Args[3]<45, "MovingLow")
	  loop
	 MovingLow:
	  X_BD Y 1 A_CountDownArg(3)
	  loop

	 Pain.IceWall:
	  X_BD Y 0 ThrustThingZ(0, 8, 0, 1)
	  X_BD Y 0 A_CheckFlag("PUSHABLE", "SpawnLoop")
	  goto Moving
	 Death:
	  X_BD Y 0
	  X_BD Y 0 A_TakeInventory("CutterFlag", 1)
	  X_BD Y 0 A_SetGravity(0.0)
	  X_BD Y 0 A_ChangeFlag("SOLID", 0)
	  X_BD YYYYYYYYYY 1 A_ScaleVelocity(0.05)
	  X_BD LM 5
	  TNT1 A 0 A_SpawnItemEx("IceWallExplodeSD", 0, 0, 0, 0, 0, 0, 0, 1)
	  TNT1 A 1 A_PlaySoundEx("weapon/freezecrackerhit", "Weapon")
	  stop
	}
}


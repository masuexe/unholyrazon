actor TornadoBlowUSD : BasicNoClassTranslationExplosion {
	Translation "192:192=69:69", "198:198=198:198"
	damagetype "TornadoBlow"
	Obituary "$OB_TORNADOBLOW"
	PROJECTILE
	+DONTBLAST
	+NOINTERACTION
	damage 0
	radius 1
	height 1
	Scale 2.5
	States {
	 Spawn:
	  X_9B B 0
	  X_9B B 0 ThrustThingZ(0, 5, 0, 0)
	  X_9B B 0 A_SpawnItemEx("TornadoDamagerUSD")
	  X_9B BC 2
	  X_9B B 0 ThrustThingZ(0, 10, 0, 1)
	  X_9B DE 2
	  X_9B B 0 ThrustThingZ(0, 10, 0, 1)
	  X_9B B 0 A_SpawnItemEx("TornadoDamagerUSD")
	  X_9B BC 2

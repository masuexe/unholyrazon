actor WallSpikeUSD : ChillSpike {
	var int user_angle;
	-FLOORHUGGER
	radius 10
	Height 50
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 1
	  TNT1 A 0 A_GiveInventory("Once")
	  TNT1 A 0 A_SetUserVar(user_angle, random(1, 120))
	  TNT1 A 0 A_PlaySoundEx("weapon/chillspike", "Weapon")
	  X_AD S 0 A_SpawnItemEx("ChillSpikeWallFX1USD", 3, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD S 0 A_SpawnItemEx("ChillSpikeWallFX1USD", 3, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD S 0 A_SpawnItemEx("ChillSpikeWallFX1USD", 3, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD S 2
	 Spawn2:
	  X_AD T 0 A_SpawnItemEx("ChillSpikeWallFX2USD", 3, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD T 0 A_SpawnItemEx("ChillSpikeWallFX2USD", 3, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD T 0 A_SpawnItemEx("ChillSpikeWallFX2USD", 3, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
	  X_AD T 1 A_CountDown
	  loop
	 Death:
	  X_AD T 0 A_JumpIfInventory("Once", 1, "DeathReal")
	  X_AD T 1 A_JumpIf(true, "DeathVanish")
	  wait
	 DeathReal:
	  TNT1 A 0 A_PlaySoundEx("weapon/chillbreak", "Weapon")
	  TNT1 A 0 A_SpawnItemEx("ChillDebrisUSD", 0, 0, 28, -random(6, 12), 0, random(2, 6), random(-6, 6), 1)
	  TNT1 A 0 A_SpawnItemEx("ChillDebrisUSD", 0, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
	  TNT1 A 0 A_SpawnItemEx("ChillDebrisUSD", 0, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
	  TNT1 A 0 A_SpawnItemEx("ChillDebrisUSD", 0, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
	 DeathVanish:
	  TNT1 A 0 A_ChangeFlag(NOINTERACTION, true)
	  TNT1 A 15
	  stop
	}
}


actor GravityHoldFXUSD : BasicNoClassTranslationGraphicEffect {
	var int user_A;
	var int user_Add;
	+MISSILE
	+THRUACTORS
	+DONTSPLASH
	+NOGRAVITY
	+CLIENTSIDEONLY
	+HEXENBOUNCE
	+SKYEXPLODE
	Bouncefactor 0.0
	RenderStyle "None"
	Mass 1024
	Reactiontime 60
	Radius 4
	Height 4
	Scale 6.5
	States {
	 SpawnFrame:
	  TNT1 A 0 A_SetUserVar("user_Add", 360/Reactiontime)
	  TNT1 A 0 A_SetUserVar("user_A", random(0, user_Add))
	  goto SpawnLoop
	 SpawnLoop:
	  TNT1 A 0 A_SpawnItemEx("GravityHoldParticleUSD", Mass, 0, 0, 0, 0, -15-(ceilingz-floorz)/32, user_A, 37+16384)  // -75
	  TNT1 A 0 A_SetUserVar("user_A", user_A+user_Add)  // 6
	  TNT1 A 0 A_Countdown
	  loop
	 Death:
	  TNT1 A 0
	  stop
	}
}

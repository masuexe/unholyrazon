actor IceExplode1 : BasicNoClassTranslationExplosion {
	DamageType "IceWall"
	Obituary "%o felt the chills from %k's Ice Explode ("
	Scale 4.5
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
	  TNT1 A 0 A_Explode(200, 256, 0, 0, 64)
	  X_8B AABBCCDDEEFF 1 A_SpawnItemEx("IceBlastBoomFXX", random(-192, 192), random(-192, 192), random(-156, 156), 0, 0, 0, 0, 1)
	  TNT1 A 0 A_Explode(300, 256, 0, 0, 64)
	  X_8B AABBCCDDEEFF 1 A_SpawnItemEx("IceBlastBoomFXX", random(-292, 292), random(-292, 292), random(-256, 256), 0, 0, 0, 0, 1)
	  TNT1 A 0 A_Explode(400, 256, 0, 0, 64)
	  X_8B AABBCCDDEEFF 1 A_SpawnItemEx("IceBlastBoomFXX", random(-392, 392), random(-392, 392), random(-356, 356), 0, 0, 0, 0, 1)
	  TNT1 A 0 A_Explode(500, 256, 0, 0, 64)
	  X_8B ABCDEF 1 A_SpawnItemEx("IceBlastBoomFX1", random(-492, 492), random(-492, 492), random(-456, 456), 0, 0, 0, 0, 1)
	  stop
	}
}
actor IceBlastBoomFXX : IceExplode1 {
	Scale 2.5
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
	  TNT1 A 0 A_Explode(255, 128, 0, 0, 16)
	  X_8B ABCDEF 2 A_Fadeout(0.08)
	  stop
	}
}


actor ColdMeteorRage1 : BasicNoClassTranslationProjectile {
	damagetype "Item"
	Obituary "%o was not tough enough to face %k's meteor. ("
	+THRUGHOST
	+RIPPER
	+NOINTERACTION
	+DONTBLAST
	+DONTREFLECT
	renderstyle translucent
	alpha 0.1
	Reactiontime 100
	Damage (666)
	Radius 260
	Height 300
	Speed 0
	Scale 4.0
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 AAAAAA 0 A_SpawnItemEx("ColdMeteorRage2", random(500, -500), random(500, -500), 0, 0, 0, random(-6, -18), 0, 1)
	  8P29 QQQQQQQQQ 1 A_FadeIn(0.1)
	 Travel:
	  8P29 Q 0 A_ChangeVelocity(0, 0, momz, 3)
	  8P29 QQ 1 A_JumpIf(ceilingz-z>300, "Spawn2")
	  8P29 Q 0 A_SpawnItemEx("ColdMeteorRage1FX", 0, 0, 0, 0, 0, 0, 0, 1)
	  8P29 Q 0 A_JumpIf(momz==0, "Death")
	  8P29 Q 0 A_CountDown
	  goto Travel

	 Spawn2:
	  8P29 Q 0 A_ChangeFlag("RIPPER", 0)
	  8P29 Q 0 A_ChangeFlag("NOINTERACTION", 0)
	  8P29 Q 2 A_ChangeVelocity(0, 0, momz, 3)
	  8P29 Q 0 A_SpawnItemEx("ColdMeteorRage1FX", 0, 0, 0, 0, 0, 0, 0, 1)
	  8P29 Q 0 A_JumpIf(momz==0, "Death")
	  8P29 Q 0 A_CountDown
	  Goto Spawn2+2

	 Death:
	  TNT1 A 0 Radius_Quake(6, 35, 0, 50, 0)
	  TNT1 A 0 A_playSoundEx("weapon/astrocrush", "Weapon", 0, 1)
	  TNT1 A 0 A_Explode(400, 9000, 1, 1, 9000)
	  TNT1 AAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("ColdMeteorRageBoom", random(-300, 300), random(-300, 300), random(-300, 300))
	  stop
	}
}


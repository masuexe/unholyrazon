actor TornadoDEItem : UnholyItem {
  Tag "$TAG_P_BOX04"
  inventory.pickupmessage "Dixieland Magic! Tornado Justice!"
  Inventory.Icon "PANBOX04"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ItemAutomapStart")
   UH_ItemSpawn:
    I_BA E 6
    loop
   UseX:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("item/refill", "Item")
   UseX_Silent:
    TNT1 A 0 A_SpawnItemEx("TornadoDE", 32, 0, 32, 0, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("TornadoDE", 32, 0, 32, 0, 0, 0, 120, 32)
    TNT1 A 0 A_SpawnItemEx("TornadoDE", 32, 0, 32, 0, 0, 0, 240, 32)
    goto End
  }
}
actor AutoTornadoDEItem : TornadoDEItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoTornadoDEItemSilent : AutoTornadoDEItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor TornadoDEItemFX : UnholyItemFX {
  States {
   Spawn:
    I_BA E 0
    goto Spawn2
  }
}


actor TornadoDE : BasicNoClassTranslationProjectile {
  Translation "192:192=64:64", "198:198=66:66"
  DamageType "WindDemoneye"
  Obituary "%o couldn't hang onto %k's \ctDemoneye\c-."
  +NOGRAVITY
  +THRUGHOST
  +THRUACTORS
  Gravity 0.0
  Damage (50)
  Height 32
  Radius 16
  Scale 2.5
  States {
   Spawn:
    I_BD FGHIFGHIFGHIFGHIFGHIFGHI 1
    goto TornadoLoop
   TornadoLoop:
    I_BD F 0 A_GiveInventory("WeaponCharge", 1)
    I_BD F 0 A_JumpIfInventory("WeaponCharge", 15, "Death")
    I_BD F 0 A_JumpIfInventory("WeaponCharge", 9, "TornadoSpin")
    I_BD F 0 A_JumpIfInventory("WeaponCharge", 8, "FastSpin")
    I_BD FGHI 1 A_SetAngle(8 + angle)
    goto TornadoLoop
   FastSpin:
    I_BD FGHIFGHIFGHIFGHIFGHIFGHI 1 A_SetAngle(15 + angle)
    goto TornadoLoop
   TornadoSpin:
    I_BD F 0 A_CustomMissile("TornadoDE_TornadoSit", 0, 0, 0, 2)
    I_BD FGHIFGHIFGHIFGHIFG 1 A_SetAngle(15 + angle)
    I_BD H 0 A_PlaySound("weapon/superboost", 2, 1, 0, 0.3)
    I_BD H 0 A_CustomMissile("TornadoDE_Tornado", 0, 0, random(-8, 8), 2)
    I_BD H 0 A_CustomMissile("TornadoDE_TornadoSit", 0, 0, 0, 2)
    I_BD HIFGHIFGHIFGHIFGHI 1 A_SetAngle(15 + angle)
    I_BD H 0 A_PlaySound("weapon/superboost", 2, 1, 0, 0.3)
    I_BD F 0 A_CustomMissile("TornadoDE_Tornado", 0, 0, random(-8, 8), 2)
    goto TornadoLoop
   Death:
    I_BD FGHIFGHIFGHI 1 A_FadeOut(0.1)
    stop
  }
}

actor TornadoDE_TornadoSit : BasicNoClassTranslationExplosion {
  Translation "192:192=64:64", "198:198=66:66"
  DamageType "WindDemoneye"
  Obituary "%o couldn't hang onto %k's \ctDemoneye\c-."
  +FLOORHUGGER
  Scale 4.5
  States {
   SpawnFrame:
    EVFL N 0
    EVFL NNOOPPNNOOPPNNOOPP 1 A_Explode(10, 200, 1, 0, 8)
    stop
  }
}

actor TornadoDE_Tornado : BasicNoClassTranslationProjectile {
  Translation "192:192=64:64", "198:198=66:66"
  DamageType "WindDemoneyeFling"
  Obituary "%o flew away to Dixieland due to %k's \ctDemoneye\c-."
  +OLDRADIUSDMG
  +DONTBLAST
  +FLOORHUGGER
  +THRUACTORS
  +DONTSPLASH
  RenderStyle "Translucent"
  Alpha 0.7
  ReactionTime 350
  Damage (0)
  Radius 4
  Height 4
  Speed 14
  Scale 4.5
  States {
   Spawn:
    EVFL NNNOOOPPP 1 A_Explode(10, 200, 1, 0, 8)
    EVFL N 0 A_CountDown
    loop
  }
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_WindDemoneye : BasicACSDamager {
  DamageType "WindDemoneye"
  Obituary "%o couldn't hang onto their own \ctDemoneye\c- while fighting %k."
}

actor HazardTag_WindDemoneyeFling : BasicACSDamager {
  DamageType "WindDemoneyeFling"
  Obituary "%o flew away to Dixieland due to their own \ctDemoneye\c- while fighting %k."
}

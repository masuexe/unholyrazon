actor ContrabandWireAdaptorItem : UnholyItem {
  inventory.pickupmessage "Support Item? Wire Adaptor?"
  inventory.icon "RZPI_00"  // "RZPI_00"
  Tag "$TAG_RZ_PBOX00"
  scale 2.0
  states {
   Spawn:
    I_RP A 6
    loop
   Use:
   UseX:
    TNT1 A 0 A_JumpIfInventory("ContrabandWireHookShotDelay", 1, "TooSoon")
    TNT1 A 0 A_GiveInventory("ContrabandWireHookShotDelay")
    TNT1 A 0 A_PlaySoundEx("assists/wirefire", "Item")
    goto UseX_Do
   UseX_Silent:
    TNT1 A 0 A_JumpIfInventory("ContrabandWireHookShotDelay", 1, "TooSoon")
    TNT1 A 0 A_GiveInventory("ContrabandWireHookShotDelay")
   UseX_Do:
    TNT1 A 0 A_SpawnItemEx("ContrabandWireAdaptorHook", -2, 0, 32, cos(-pitch), 0, sin(-pitch), 0, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "UseX2")
    goto End
   UseX2:
    TNT1 A 0 A_SpawnItemEx("ContrabandWireAdaptorHook", -2, 0, 32, cos(-pitch), 0, sin(-pitch), -15, 0)
    TNT1 A 0 A_SpawnItemEx("ContrabandWireAdaptorHook", -2, 0, 32, cos(-pitch), 0, sin(-pitch), 15, 0)
    goto End
   TooSoon:
    TNT1 A 0
    fail
  }
}

actor AutoContrabandWireAdaptorItem : ContrabandWireAdaptorItem {
  Inventory.PickupSound ""
  Inventory.MaxAmount 0
  +ALWAYSPICKUP
  States {
   Pickup:
    goto UseX
  }
}
actor AutoContrabandWireAdaptorItemSilent : AutoContrabandWireAdaptorItem {
  States {
   Pickup:
    goto UseX_Silent
  }
}
actor ContrabandWireAdaptorItemFX : UnholyItemFX {
  States {
   Spawn:
    I_RP A 0
    goto Spawn2
  }
}

actor ContrabandWireHookShotDelay : Powerup {
  Powerup.Duration 5
}

actor ContrabandWireAdaptorDelay : Powerup {
  Powerup.Duration 0x7ffffffd
}

actor ContrabandWireAdaptorHook : WireAdaptorHook {
  obituary "%o was grappled by %k's Contraband Wire Adaptor."
  damagetype "ContrabandWireAdaptor"
  // +PAINLESS
  +SKYEXPLODE
  ReactionTime 10  // 1
  Damage (500)
  states {
   Spawn:
    I2PA B 0
    I2PA B 0 A_SetUserVar("user_CountDown", reactiontime)
    I2PA B 0 A_SetUserVar(user_PTID, ACS_NamedExecuteWithResult("core_gettarget"))
    I2PA B 0 A_GiveInventory("WeaponCharge", 1)
    I2PA B 0 A_ScaleVelocity(50)  // Speed of projectile.
    goto Spawn2

   Spawn2:
    I2PA B 0 ACS_NamedExecuteAlways("core_drawhookshot", 0, user_PTID, 18)
    I2PA B 0 A_GiveToTarget("ContrabandWireHookShotDelay")
    I2P1 ABABAB 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0, "SuperDeath")
    I2PA B 0 A_GiveToTarget("ContrabandWireHookShotDelay")
    I2P1 ABABAB 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0, "SuperDeath")
   WireLoop:
    I2PA B 0 A_GiveToTarget("ContrabandWireHookShotDelay")
    I2P1 ABABAB 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0, "SuperDeath")
    I2PA B 0 A_SetUserVar("user_CountDown", user_CountDown - 1)
    I2P1 A 0 A_CountDown
    loop

   Death:
    I2PA B 0 A_JumpIfCloser(64, "SuperDeath")
   XDeath:
   Crash:
    I2PA B 0 A_JumpIf(user_CountDown == 0, "SuperDeath")
    I2PA B 0 A_JumpIfInventory("WeaponCharge", 2, "SuperDeath")
    I2PA B 0 A_JumpIfInventory("WeaponCharge", 1, 1)
    goto SuperDeathPoof  // Kill hook early if it never got through the Spawn state.
    I2PA B 0 A_PlaySoundEx("assists/wirecling", "Weapon")
    I2PA B 0 A_JumpIfInventory("NoHookshot", 1, "Death1", AAPTR_TRACER)
    I2PA B 0 A_CheckFlag("SHOOTABLE", "Death2", AAPTR_TRACER)
    goto Death1
   Death1:  // Tracer isn't shootable (probably can't move)
    I2PA B 0 ACS_NamedExecuteAlways("core_hookshot", 0, user_PTID, 30, 0)
    I2P1 B 3
    goto DeathLoop1
   Death2:  // Tracer IS shootable (probably CAN move)
    I2PA B 0 ACS_NamedExecuteAlways("core_hookshot", 0, user_PTID, 30, 1)
    I2P1 B 3  // Needs at least 3 tics of delay.
    goto DeathLoop2
   DeathLoop1:
    I2PA B 0 A_JumpIfCloser(64, "SuperDeathPoof")
    I2PA B 0 A_GiveToTarget("ContrabandWireHookShotDelay")
    I2P1 B 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0, "SuperDeath")
    loop
   DeathLoop2:
    I2PA B 0 A_JumpIfCloser(64, "SuperDeathPoof")
    I2PA B 0 A_Warp(AAPTR_TRACER, -4, 0, 28)
    I2PA B 0 A_GiveToTarget("ContrabandWireHookShotDelay")
    I2P1 B 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0, "SuperDeath")
    I2P1 B 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1)==0, "DeathLoop1")
    loop
   SuperDeathPoof:
    I2PA B 0 A_PlaySoundEx("assists/wirefinish", "Weapon")
    I2PA B 0 A_TakeFromTarget("ContrabandWireAdaptorDelay")
    I2PA B 0 A_ChangeFlag("NOINTERACTION", 1)
    I2P1 B 6 A_Stop
    stop
   SuperDeath:
    I2P1 B 0
    stop
  }
}

Actor ContrabandWireAdaptorHookFX {
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOGRAVITY
  +NOTIMEFREEZE
  -SOLID
  radius 2
  height 2
  scale 2.5
  States {
   Spawn:
    I2P1 I 0
    I2P1 C 1
    stop
  }
}

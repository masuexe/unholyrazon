actor BaseUnholyBossWep : BaseMM8BDMWep_UH {
    States {
        Deselect:
            TNT1 A 0
            goto DeselectSwap
        Select:
            TNT1 A 0
            goto SelectSwap
        Ready:
            TNT1 A 1
            TNT1 A 0 A_TakeInventory("IsPissedFlag")
            TNT1 A 0 A_GiveInventory("BasicBossItem", 1)
            TNT1 A 1 A_Jump(256, "Ready0")
            wait
        Ready0:
            BUST B 1 A_WeaponReady
            wait
        Fire:
            BUST B 0 A_PlaySoundEx("items/rubberban","Weapon")
            BUST B 0 A_FireCustomMissile("Rubberband",0,0,8,0)
            BUST CD 3
            BUST B 2
            BUST B 0 A_Refire
            goto Ready0+1
    }
}

actor BasicBossItem : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_TakeInventory("ShieldCheck")
TNT1 A 0 A_TakeInventory("StunArmor")
TNT1 A 0 A_TakeInventory("SemiStunArmor")
TNT1 A 0 A_TakeInventory("FlingArmor")
TNT1 A 0 A_TakeInventory("SemiFlingArmor")
TNT1 A 0 A_TakeInventory("ShinySparkleFlag")
TNT1 A 0 A_TakeInventory("TruePowerItemFlag")

TNT1 A 0 A_TakeInventory("OilBoat")
TNT1 A 0 A_TakeInventory("WheelCount")
TNT1 A 0 A_GiveInventory("StopShield",1)
// TNT1 A 0 A_GiveInventory("RaiderHookRelease_F",1)
// TNT1 A 0 A_GiveInventory("CaptainAssDetonateFlag",1)

TNT1 A 0 A_TakeInventory("VivifyFlag1")
TNT1 A 0 A_TakeInventory("VivifyFlag2")
TNT1 A 0 A_TakeInventory("VivifyFlag3")

TNT1 A 0 A_TakeInventory("VivifyCycle1")
TNT1 A 0 A_TakeInventory("VivifyCycle2")
TNT1 A 0 A_TakeInventory("VivifyCycle3")
TNT1 A 0 A_TakeInventory("VivifyCycle4")
TNT1 A 0 A_TakeInventory("VivifyCycle5")
TNT1 A 0 A_TakeInventory("VivifyCycle6")

//TNT1 A 0 A_GiveInventory("PowerNoGravityFix",1)
TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
TNT1 A 0 A_ChangeFlag("NONSHOOTABLE",0)
TNT1 A 0 A_ChangeFlag("NORADIUSDMG",0)
TNT1 A 0 A_GiveInventory("InvulnerableOff_Pickup",1)
TNT1 A 0 A_GiveInventory("BasicBossSolidCheck",1)

TNT1 A 0 A_GiveInventory("SelfTotallyUnfrozen",1)
TNT1 A 0 A_GiveInventory("OtherTotallyUnfrozen",1)
TNT1 A 0 A_GiveInventory("TimeStoppedUnfreeze",1)
TNT1 A 0 A_GiveInventory("SelfStoppedUnfreeze",1)
TNT1 A 0 SetPlayerProperty(0,0,0)
TNT1 A 0 SetPlayerProperty(0,0,3)

TNT1 A 0 A_GiveInventory("PowerTelefragProtect")

TNT1 A 0 A_TakeInventory("UnholyPower500")
TNT1 A 0 A_TakeInventory("UnholyPower1000")
TNT1 A 0 A_TakeInventory("UnholyPower1500")
TNT1 A 0 A_TakeInventory("UnholyPower2000")
TNT1 A 0 A_TakeInventory("UnholyPower2500")
TNT1 A 0 A_TakeInventory("UnholyPower3000")

TNT1 A 0 A_TakeInventory("CanAirJump")
TNT1 A 0 A_TakeInventory("CanWallJump")
TNT1 A 0 A_TakeInventory("CanWallJumpLimit")
TNT1 A 0 A_TakeInventory("CanAirJumpLimit")
TNT1 A 0 A_SpawnItemEx("BTWIMRIGHTHERE")
TNT1 A 0 ACS_NamedExecuteAlways("uh_IsUnderWaterGravity",0)//Underwater
TNT1 A 0 A_GiveInventory("AirJumpBossFix_P",1)
TNT1 A 0 A_GiveInventory("WallJumpBossFix_P",1)
stop
}
}


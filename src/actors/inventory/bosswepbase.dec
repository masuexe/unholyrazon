actor BaseUnholyBossWep : BaseMM8BDMWep_UH {
    States {
        Deselect:
            TNT1 A 0
            goto DeselectSwap
        Select:
            TNT1 A 0
            goto SelectSwap
        Ready:
            TNT1 A 1
            goto ReadyX
        ReadyX:
            BUST B 1 A_WeaponReady
            wait
        Fire:
            BUST B 0 A_PlaySoundEx("items/rubberban","Weapon")
            BUST B 0 A_FireCustomMissile("Rubberband",0,0,8,0)
            BUST CD 3
            BUST B 2
            BUST B 0 A_Refire
            goto ReadyX
    }
}

actor BasicBossItem : CustomInventory
{
States
{
Pickup:
// TNT1 A 0 ACS_NamedExecuteAlways("uh_ChangeTeam", 0, 1)
TNT1 A 0 A_GiveInventory("NoTeamTranslation")
TNT1 A 0 A_GiveInventory("NoProjectileTeamTranslation")
TNT1 A 0 A_GiveInventory("RemoveWeaponsOfMortals_P")

TNT1 A 0 A_TakeInventory("WeaponCharge", 1)
TNT1 A 0 A_TakeInventory("ShieldCheck")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer",0,false)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_HalfHitStunplayer",0,false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer",0,false)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfpushplayer",0,false)
TNT1 A 0 A_TakeInventory("ShinySparkleFlag")
TNT1 A 0 A_TakeInventory("TruePowerItemFlag")

TNT1 A 0 A_TakeInventory("OilBoat")
TNT1 A 0 A_TakeInventory("WheelCount", 1)
TNT1 A 0 A_GiveInventory("StopShield")
TNT1 A 0 A_GiveInventory("RaiderHookRelease_F")

TNT1 A 0 A_TakeInventory("VivifyFlag1")
TNT1 A 0 A_TakeInventory("VivifyFlag2")
TNT1 A 0 A_TakeInventory("VivifyFlag3")

TNT1 A 0 A_TakeInventory("VivifyCycle1", 1)
TNT1 A 0 A_TakeInventory("VivifyCycle2", 1)
TNT1 A 0 A_TakeInventory("VivifyCycle3", 1)
TNT1 A 0 A_TakeInventory("VivifyCycle4", 1)
TNT1 A 0 A_TakeInventory("VivifyCycle5", 1)
TNT1 A 0 A_TakeInventory("VivifyCycle6", 1)

TNT1 A 0 A_GiveInventory("StopSnd_P0")
TNT1 A 0 A_GiveInventory("StopSnd_P1")
TNT1 A 0 A_GiveInventory("StopSnd_P2")
TNT1 A 0 A_GiveInventory("StopSnd_P3")
TNT1 A 0 A_GiveInventory("StopSnd_P4")
TNT1 A 0 A_GiveInventory("StopSnd_P5")
TNT1 A 0 A_GiveInventory("StopSnd_P6")
TNT1 A 0 A_GiveInventory("StopSnd_P7")

TNT1 A 0 A_TakeInventory("IsQwantSFlag")
TNT1 A 0 A_TakeInventory("IsNegaManFlag")
TNT1 A 0 A_TakeInventory("IsNegaManSFlag")
TNT1 A 0 A_TakeInventory("IsLimFlag")
TNT1 A 0 A_TakeInventory("IsDecoyBotFlag")
TNT1 A 0 A_TakeInventory("IsDecoyBotSFlag")

TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_nonshootableplayer", 0, false)
TNT1 A 0 A_ChangeFlag("NORADIUSDMG",0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer",0,0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer",0,USP_TOGGLEOFF_DAMAGE,CallACS("core_getmaxhealth")/10)

TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer",0,0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, 0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_flyplayer", 0, false)

TNT1 A 0 A_GiveInventory("PowerTelefragProtect")

TNT1 A 0 A_TakeInventory("UnholyPower500", 1)
TNT1 A 0 A_TakeInventory("UnholyPower1000", 1)
TNT1 A 0 A_TakeInventory("UnholyPower1500", 1)
TNT1 A 0 A_TakeInventory("UnholyPower2000", 1)
TNT1 A 0 A_TakeInventory("UnholyPower2500", 1)
TNT1 A 0 A_TakeInventory("UnholyPower3000", 1)

TNT1 A 0 A_TakeInventory("WallJumpLimit", 1)
TNT1 A 0 A_TakeInventory("AirJumpLimit", 1)

TNT1 A 0 A_SpawnItemEx("BTWIMRIGHTHERE")
stop
}
}


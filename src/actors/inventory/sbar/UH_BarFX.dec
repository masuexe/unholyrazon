// Unholy-owned HUD inventory actors. MM8BDM supplies its own BarFX.txt.

// Display proxies for DrawBar*Owned (avoid SBARINFO Ammo1/Ammo2 keywords)
actor Ammo1Disp : Ammo {
  +INVENTORY.IGNORESKILL
  inventory.maxamount 1
}

actor Ammo2Disp : Ammo {
  +INVENTORY.IGNORESKILL
  inventory.maxamount 1
}

actor SBARUseAmmo1Disp : Once {}

actor SBARUseAmmo2Disp : Once {}

actor Ammo3 : Ammo {
  +INVENTORY.IGNORESKILL
  inventory.maxamount 1
}

actor SBARDarken3 : Once {}

actor SBARFlash3 : Once {}

actor SBARFlashOverlayAmmo3 : Ammo {
  +INVENTORY.IGNORESKILL
  inventory.maxamount 1
}

actor SBARFlashOverlayAmmoR3 : Ammo {
  +INVENTORY.IGNORESKILL
  inventory.maxamount 1
}

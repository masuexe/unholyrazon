actor BaseCorpseFX
{
height 4
radius 4
-NOGRAVITY
-SOLID
+CLIENTSIDEONLY
scale 2.5
States
{
Spawn:
PLAY A 350
goto Spawn2
Spawn2:
"----" "###########" 3 A_Fadeout
stop
}
}


actor BaseCorpse
{
Radius 16
Height 56
Scale 2.5
Speed 1
-SOLID
+DONTBLAST
States
{
Spawn:
PLAY H 19
goto Spawn2
Spawn2:
TNT1 A 0 A_SpawnItemEx("BaseCorpse2",0,0,32)
TNT1 A 1 A_SpawnItemEx("FakeUnholyDeathFX",0,0,32,0,0,0,random(0,359),1)
stop//loop
Spawn2B:
TNT1 A 0 A_SpawnItemEx("BaseCorpse2",0,0,32)
TNT1 A 1 A_SpawnItemEx("FakeDeathFX",0,0,32,0,0,0,random(0,359),0)
stop//loop
Spawn3:
"----" H 0 A_SpawnItemEx("BaseCorpse3",0,0,32)
"----" HHHHHHHHHHHHHHHHHHHH 1 A_Fadeout
stop
Spawn3B:
"----" H 0 A_SpawnItemEx("BaseCorpse3",0,0,32)
"----" HHHHHHHHHHHHHHHHHHHH 3 A_Fadeout
stop
Spawn3G:
"----" H 0 A_SpawnItemEx("BaseCorpse4",0,0,32)
"----" HHHHHHHHHHHHHHHHHHHH 2 A_Fadeout
stop

SpawnIce:
"----" H 0 A_GenericFreezeDeath
"----" H 1 A_FreezeDeathChunks
wait
 
Death:
TNT1 A 1 A_SpawnItemEx("FrozenDeathFX",0,0,16)
stop
}
}


actor BaseCorpse2 : BasicHelper//Because a morphed actor deflashing with BaseCorpse plays no sound.
{
States
{
Spawn:
TNT1 A 0
TNT1 A 10 A_PlaySoundEx("misc/devildeath","Weapon")
stop
}
}


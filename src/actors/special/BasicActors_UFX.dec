actor UH_BasicBoomFX : BasicGraphicEffect
{
+FORCEXYBILLBOARD
+BRIGHT
}

//MEGAMAN 1//MEGAMAN 1//MEGAMAN 1//MEGAMAN 1
//MEGAMAN 1//MEGAMAN 1//MEGAMAN 1//MEGAMAN 1
actor BasicBoom1FX_XA : UH_BasicBoomFX
{// HyperBomb 192/198
States
{
Spawn:
X_1D A 0
X_1D BCDEFGHIJKLMN 1
stop
}
}

actor BasicBoom1FX_XB : UH_BasicBoomFX
{// HyperBomb 4/192
States
{
Spawn:
X_1D O 0
X_1D "OPQRSTUVWXYZ[" 1
stop
}
}

actor BasicBoom1FX_YA : UH_BasicBoomFX
{// HyperBomb 202/199
States
{
Spawn:
Y_1D A 0
Y_1D BCDEFGHIJKLMN 1
stop
}
}

actor BasicBoom1FX_YB : UH_BasicBoomFX
{// HyperBomb 4/202
States
{
Spawn:
Y_1D O 0
Y_1D "OPQRSTUVWXYZ[" 1
stop
}
}

//MEGAMAN 3//MEGAMAN 3//MEGAMAN 3//MEGAMAN 3
//MEGAMAN 3//MEGAMAN 3//MEGAMAN 3//MEGAMAN 3
actor BasicBoom3FX_ColorX : UH_BasicBoomFX
{// MM3 Boom 192/198
States
{
Spawn:
X_3L A 0
X_3L ABCDEFGHIJKLM 1
stop
}
}

actor BasicBoom3FX_ColorX_Precise : UH_BasicBoomFX
{// MM3 Boom *Accurate Frames?* 192/198
States
{
Spawn:
X_3L A 0
X_3L AABBCDDEFFGHHIJJKKKLLLMMM 1
stop
}
}

actor BasicBoom3FX_WhiteX1 : UH_BasicBoomFX
{// MM3 Boom 4/192
States
{
Spawn:
X_3L N 0
X_3L NOPQRSTUVWXYZ 1
stop
}
}

actor BasicBoom3FX_WhiteX1_Precise : UH_BasicBoomFX
{// MM3 Boom *Accurate Frames?* 4/192
States
{
Spawn:
X_3L N 0
X_3L NNOOPQQRSSTUUVWWXXXYYYZZZ 1
stop
}
}

//MEGAMAN 4//MEGAMAN 4//MEGAMAN 4//MEGAMAN 4 (Megaman 5 uses Megaman 4's FX)
//MEGAMAN 4//MEGAMAN 4//MEGAMAN 4//MEGAMAN 4 (DrillBomb == NapalmBomb)
actor BasicBoom4FX_ColorX : UH_BasicBoomFX
{// MM4 Boom 192/198
States
{
Spawn:
X_4L A 0
X_4L ABCDEFGHIJKLMNOPQRST 1
/////AABCCDEFGHIJKLMNOPQRST 1//Accurate Frames?
/////ABCDFHJKMNOPQRST//New sprite to match old
/////EFGHIJKLMNOPQRS//old animation
stop
}
}

actor BasicBoom4FX_ColorX_Tic2 : UH_BasicBoomFX
{// MM4 Boom 192/198
States
{
Spawn:
X_4L A 0
X_4L ABCDEFGHIJKLMNOPQRST 2
stop
}
}

actor BasicBoom4FX_ColorX_Tic2_Dull : BasicBoom4FX_ColorX_Tic2{-BRIGHT}


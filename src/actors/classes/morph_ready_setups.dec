actor UH_ArchivistShiny_MorphSetup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, "Done")
    TNT1 A 0 A_GiveInventory("S_ArchivistFlag1", random(1, 4))
    TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 4))
   Done:
    TNT1 A 0
    stop
  }
}


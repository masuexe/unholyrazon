// Eye and shiny setup pickups depend on the class definitions above.

actor UH_Eye2_MorphSetup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo400", 250)
    stop
  }
}


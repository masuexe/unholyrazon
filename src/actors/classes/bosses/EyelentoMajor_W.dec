actor EyelentoMajor_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor EyelentoMajor_Ready8_P : EyelentoMajor_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY|WRF_NOBOB)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY|WRF_NOBOB|WRF_ALLOWRELOAD)
    goto Ammo
  }
}

actor EyelentoMajor_BatonThrust_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("GenericBossFlag1",2,"Pickup2")
TNT1 A 0 A_JumpIfInventory("GenericBossFlag1",1,"Pickup1")
TNT1 A 0 A_ScaleVelocity(0.90)
TNT1 A 0 A_Recoil(-15)//-5
goto End
Pickup1:
TNT1 A 0 A_ScaleVelocity(0.60)//A_Recoil(-10)
TNT1 A 0 A_Recoil(-25)//-15
goto End
Pickup2:
TNT1 A 0 A_ScaleVelocity(0.60)//A_Recoil(-15)
TNT1 A 0 A_Recoil(-35)//-25
goto End
End:
TNT1 A 0 A_GiveInventory("GenericBossFlag1",1)
stop
}
}


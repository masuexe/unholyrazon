actor EyelentoMajor_PlayerGrenade : BasicExplosion
{
Translation "192:192=171:171", "198:198=191:191"
Obituary "%o perished from \cuEyelento Major\c- (%k)'s grenade."
damagetype "EyelentoMajor"
+NOCLIP
+NOTARGETSWITCH
ReactionTime 4
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("core_SetPointer", 8,CallACS("uh_ZangiefCountInv",2,2)-1+1000)
TNT1 A 0 A_PlaySoundEx("KirbyNES/ThrowToss","Weapon")
goto SpawnLoop
SpawnLoop:
8T01 AAABBB 1 A_Warp(8,0,0,28,0,24)
8T01 C 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
8T01 CCCDDD 1 A_Warp(8,0,0,28,0,24)
8T01 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
8T01 A 0 A_CountDown
loop
Death:
TNT1 A 0 A_Warp(8,0,0,28,0,24)
TNT1 A 0 A_PlaySoundEx("wep_L/mm4/drillbombexplode","Weapon")
TNT1 A 0 Radius_Quake(6,10,0,16,0)
TNT1 A 1 A_Explode(random(175,200),92,0,0,92)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,60)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,-60)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,120)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,-120)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,180)
TNT1 A 0 A_SpawnItemEx("SharpnelGrenadeNeedle",0,0,0,48,0,0,0)
TNT1 AAAAAA 0 A_SpawnItemEx("MajorExplode_Trail",random(-2,2),random(-2,2),8,random(-25,25),random(-25,25),random(-25,25),0,0)
X_8B AABB 1 A_SpawnItemEx("MajorGrenadeAftermath_X",random(-120,120),random(-120,120),random(-96,96),0,0,0,0,1)
X_8B CCDD 1 A_SpawnItemEx("MajorGrenadeAftermath_X",random(-156,156),random(-156,156),random(-128,128),0,0,0,0,1)
X_8B EEFF 1 A_SpawnItemEx("MajorGrenadeAftermath_X",random(-192,192),random(-192,192),random(-156,156),0,0,0,0,1)
stop
}
}


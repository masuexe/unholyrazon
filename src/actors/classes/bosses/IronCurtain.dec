actor IronCurtain : BossBase {
  // Now why would a tank have this much speed?
  Player.ScoreIcon "UB011MUG"
  Player.SoundClass "IronCurtain"
  Player.DamageScreenColor "green"
  Player.ForwardMove 0.7, 0.7  // 1.0
  Player.SideMove 0.65, 0.65  // 0.95
  Player.JumpZ 10
  Player.MaxHealth 5000
  Health 5000
  Player.MorphWeapon "IronCurtain_W"
  States {  // Don't worry, the damagetype was also made less severe.
   Spawn:
    8A11 A 0
    8A11 B 1
    8A11 A 1
    goto Spawn+2
   See:
    8A11 BCDE 5
    goto Spawn
   Melee:
   WALKING:
    8A11 BCDE 1
    8A11 B 0 A_JumpIfInventory("HandyFlag", 1, "WALKING")
    goto Spawn+2
   Missile:
    8A11 FFFFF 1 A_JumpIfInventory("HandyFlag", 1, "WALKING")
    8A11 G 4
    goto Spawn+2

   ClassPain:
    8A11 H 0
    goto MegamanPain
   ClassDeath:
    8A11 H 0
    goto MegamanDeath
  }
}

// SovietUnionIgniter
actor SovietIgniter : BossBase {
  Player.ScoreIcon "UB015MUG"
  Player.SoundClass "SovietIgniter"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 10
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "SovietIgniter_W"
  States {
   Spawn:
    8A15 A 0
    8A15 B 1
    8A15 A 1
    goto Spawn+2
   See:
    8A15 BCDE 5
    goto Spawn
   Missile:
    8A15 F 5
    8A15 G 4
    goto Spawn+2
   ClassPain:
    8A15 H 0
    goto MegamanPain
   ClassDeath:
    8A15 H 0
    goto MegamanDeath
  }
}

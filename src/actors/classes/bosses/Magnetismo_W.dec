actor Magnetismo_W_NormalBar : NormalBar {args 216, 75}
actor Magnetismo_W_SecondBar : SecondBar {args 198, 5}

actor Magnetismo_W : BaseUnholyBossWep
{
Tag "$TAG_Boss020_W"
Obituary "%o was fatally attracted by \chMagnetismo\c- (%k)'s Magnet Pull."  // Wooden Gun
Inventory.Pickupmessage "\cnPREPARING FOR MORPHING."
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H20 [ 1
wait

Deselect:
8H20 A 0
goto DeselectSwap
Select:
8H20 A 0
goto SelectSwap

Ready:
8H20 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H20 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MAGNETISMO_DYE)
8H20 A 1 ACS_NamedExecuteWithResult("uh_BossMorph", 20,2000,300) 
goto ReadyX
ReadyX:
8H20 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyX1")
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",25,"ReadyX2")
8H20 A 2 A_GiveInventory("Magnetismo_Ready12_P")
loop
ReadyX1:
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",25,"ReadyX3")
8H20 A 2 A_GiveInventory("Magnetismo_Ready8_P")
loop
ReadyX2:
8H20 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyX3")
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",50,"ReadyX3")
8H20 A 2 A_GiveInventory("Magnetismo_Ready4_P")
loop
ReadyX3:
8H20 A 2 A_GiveInventory("Magnetismo_Ready0_P")
loop

Fire:
8H20 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ComeHere")
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",50,"MagnetWave")
Goto ReadyX
MagnetWave:
8H20 A 1 OffSet(-14,22)
8H20 A 1 OffSet(-28,12)
8H20 A 0 A_TakeInventory("UnholyBossAmmo100",50)
8H20 A 0 A_Recoil(35)
8H20 B 1 OffSet(-20,16) A_FireCustomMissile("MadMagnetMissile",-9,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",-6,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",-3,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",0,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",3,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",6,0,8,0)
8H20 B 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8H20 B 1 A_FireCustomMissile("MadMagnetMissile",9,0,8,0)
8H20 B 1 OffSet(-20,16) A_FireCustomMissile("MadMagnetMissile",9,0,8,0)
8H20 B 2 OffSet(-12,20)
8H20 A 2 OffSet(-6,24)
8H20 A 2 OffSet(-2,28)
8H20 A 34 A_WeaponReady(14)
Goto ReadyX
AltFire:
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",25,"MagnetCrusher")
goto ReadyX
MagnetCrusher:
8H20 A 0 A_PlaySound("Weapon/MagnetMissile")
8H20 A 0 A_TakeInventory("UnholyBossAmmo100",25)
8H20 A 0 A_FireCustomMissile("MagnetCrusher",0,0,8,0)
8H20 A 2 OffSet(-14,22)
8H20 A 2 OffSet(-28,12)
8H20 A 2 OffSet(-20,16)
8H20 A 2 OffSet(-12,20)
8H20 A 2 OffSet(-6,24)
8H20 A 2 OffSet(-2,28)
Goto ReadyX

Reload:
8H20 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"MagnetPulse")
goto ReadyX
MagnetPulse:
8H20 A 0 A_GiveInventory("Magnetismo_ItemStart_P")
8H20 A 0 A_GiveInventory("MagnetismoPulseFlag", 7)
8H20 A 1 Offset(2,52)
8H20 A 1 Offset(4,72) A_JumpIfInventory("PlayerPropertyRage",1,1)
TNT1 A 1 A_WeaponReady(14)
8H20 C 1 Offset(0,82) A_JumpIfInventory("PlayerPropertyRage",1,1)
8H20 C 1 Offset(0,72)
8H20 C 1 Offset(0,62) A_JumpIfInventory("PlayerPropertyRage",1,1)
8H20 C 1 Offset(0,52)
8H20 C 1 Offset(0,42) A_JumpIfInventory("PlayerPropertyRage",1,1)
8H20 C 1 Offset(0,32)
MagnetPulseLoop:
8H20 C 2 Offset(0,33) A_FireCustomMissile("MagnetPullPull",0,0,0,0)
8H20 C 2 Offset(0,58) A_FireCustomMissile("MagnetPullPull",0,0,0,0)
8H20 C 0 A_TakeInventory("MagnetismoPulseFlag", 1)
8H20 C 0 A_JumpIfInventory("MagnetismoPulseFlag", 1, "MagnetPulseLoop")
8H20 A 0 A_GiveInventory("Magnetismo_ItemEnd_P")
8H20 AA 1 A_SpawnItemEx("MagnetPullPush",0,0,8)
Goto ReadyX
Flash:
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("MagnetPullPull",0,0,0,0)
stop
ComeHere:
8H20 A 0 A_GunFlash
8H20 A 0 A_GiveInventory("Magnetismo_RageStart_P")
8H20 A 0 A_GiveInventory("MagnetismoPulseFlag", 17)
ComeHereLoop:
8H20 C 1 Offset(0,33) A_FireCustomMissile("MagnetPullRadius",0,0,0,0)
8H20 C 1 Offset(0,58) A_FireCustomMissile("MagnetPullRadius",0,0,0,0)
8H20 C 0 A_TakeInventory("MagnetismoPulseFlag",1)
8H20 C 0 A_JumpIfInventory("MagnetismoPulseFlag",1,"ComeHereLoop")
8H20 A 0 A_GiveInventory("Magnetismo_RageEnd_P")
8H20 C 1 Offset(0,58) A_SpawnItemEx("MagnetPullPush",0,0,8)
8H20 C 1 Offset(0,33) A_SpawnItemEx("MagnetPullPush",0,0,8)
8H20 C 1 Offset(0,58) A_SpawnItemEx("MagnetPullPush",0,0,8)
Goto ReadyX
}
}

actor MagnetismoPulseFlag : Inventory
{
inventory.amount 1
inventory.maxamount 17
}

actor Magnetismo_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    stop
  }
}
actor Magnetismo_Ready4_P : Magnetismo_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(4)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(4 + 16)
    goto Ammo
  }
}
actor Magnetismo_Ready8_P : Magnetismo_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}
actor Magnetismo_Ready12_P : Magnetismo_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(12)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(12 + 16)
    goto Ammo
  }
}


actor Magnetismo_ItemStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("MagnetismoJunkWarper")
TNT1 A 0 A_GiveInventory("ShieldCheck",1)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F",1000)
TNT1 A 0 A_GiveInventory("Magnetismo_BasicArmor_P",1)
TNT1 A 0 A_PlaySound("weapon/junkend",1)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo100",50,1)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo100",50)
stop
}
}
actor Magnetismo_ItemEnd_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("weapon/napalm",1)
TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("MagnetismoJunkDebris",0,0,8,random(-30,30),random(-30,30),random(5,10))
TNT1 A 0 A_FireCustomMissile("MagnetismoJunkExplode",0,0,0,0)
Pickup0:
TNT1 A 0 A_TakeInventory("BasicArmor")
TNT1 A 0 A_TakeInventory("ShieldCheck")
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
stop
}
}

actor Magnetismo_RageStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F",2500)
TNT1 A 0 A_GiveInventory("Magnetismo_BasicArmor_P2",1)
TNT1 A 0 A_GiveInventory("ShieldCheck",1)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
TNT1 A 0 A_TakeInventory("UnholyPower1500",750,1)
TNT1 A 0 A_TakeInventory("UnholyPower1500",750)
stop
}
}
actor Magnetismo_RageEnd_P : Magnetismo_ItemEnd_P
{
States
{
Pickup:
goto Pickup0
}
}

actor MagnetismoJunkWarper : BasicShieldWarper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper",0,-1)
JSHF GFEDCBA 1 A_Warp(AAPTR_TARGET,-12,0,0,0,24)
Goto Shield
Shield:
JSHI AABBCCDDEEFFGGHHIIJJKKLLMMNNOO 1 A_Warp(AAPTR_TARGET,0,0,0,0,24)
loop
}
}

Actor MagnetismoJunkDebris : BasicProjectile
{
Translation "192:192=4:4", "198:198=93:93"
-NOGRAVITY
damagetype "Magnetismo"
Obituary "%o was destroyed by \chMagnetismo\c- (%k)'s Magnet Pulse."
Damage (100)
Radius 21
Height 10
Speed 10
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,2,3,4)
X_4F B 2
wait
X_4F C 2
wait
X_4F D 2
wait
X_4F E 2
wait
Death:
TMFX ABCD 2
stop
}
}

actor MagnetismoJunkExplode : BasicExplosion
{
damagetype "Magnetismo"
Obituary "%o was destroyed by \chMagnetismo\c- (%k)'s Magnet Pulse."
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(345,188,0)
stop
}
}

Actor MagnetPullPull : BasicExplosion
{
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("uh_radiuspull", 100, 1000, 0, 1)
TNT1 A 0 A_Jump(256,"X","Y")
X:
8A20 X 2
stop
Y:
8A20 Y 2
stop
}
}

Actor MagnetPullPush : MagnetPullPull
{
States
{
Spawn:
TNT1 A 0
TNT1 A 5 ACS_NamedExecuteWithResult("uh_radiuspull", -1000, 1000, 0, 1)
stop
}
}

Actor MagnetPullRadius : BasicExplosion
{
damagetype "Magnetismo"
Obituary "%o was destroyed by \chMagnetismo\c- (%k)'s Magnet Pulllllllllllllllll."
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(28,390,0)
stop
}
}

Actor MadMagnetMissile : BasicProjectile
{
Translation "192:192=4:4", "198:198=74:74"
+SEEKERMISSILE
+SCREENSEEKER
Damagetype "Magnetismo"
Obituary "%o could not evade \chMagnetismo\c- (%k)'s Magnet Wave."
reactiontime 100
damage (85)
Radius 8
Height 5
speed 50
scale 2.5
States
{
Spawn:
X_3B A 3 A_SeekerMissile(2,10,SMF_LOOK,55,10)
X_3B A 0 A_CountDown
loop
Death:
X_3B A 0 A_Stop
X_3B A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
X_3B A 0 A_Explode(85,128,0)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}

Actor MagnetCrusher : BasicProjectile
{
Translation "192:192=4:4", "198:198=74:74"
+SEEKERMISSILE
+SKYEXPLODE
+EXPLODEONWATER
damagetype "Magnetismo"
Obituary "%o was crushed by \chMagnetismo\c- (%k)'s Magnet Crusher."
Speed 32
Damage (50)
radius 8
height 5
scale 2.5
States
{
Spawn:
X_3B A 0
X_3B A 0 A_ScaleVelocity(0.625)
X_3B A 0 A_SeekerMissile(0,0,3,256,0)
X_3B A 1 A_JumpIfInventory("MM8BDMPlayer",1,"CrushThem",AAPTR_TRACER)
goto Spawn+2
CrushThem:
X_3B B 1 A_SeekerMissile(90,90,3,0,0)
wait
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
TNT1 A 0 //A_SetGravity(0.0)
TNT1 A 0 A_Explode(225,180,0)
X_1D BCDEFGHIJKLMN 1
stop
}
}

actor MagnetCrushCheck : BasicProjectile
{
Damagetype "Magnetismo"
Obituary "%o was found by \chMagnetismo\c- (%k)'s Magnet Crusher."
+DONTSPLASH
+DONTBLAST
+THRUGHOST
+PICKUP
+FLOORHUGGER
damage (25)
Radius 32
Height 512
States
{
Spawn:
TNT1 A 0
TNT1 A 1
TNT1 A 0
stop
XDeath:
TNT1 A 0 A_GiveToTarget("DecoyFlag1",1)
TNT1 A 0
Stop
Death:
TNT1 A 0
Stop
}
}

actor TrueBusterExpert : BossBase {
  Player.ScoreIcon "UB000MUG"
  Player.SoundClass "truebusterexpert"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 5000
  Health 5000
  Player.MorphWeapon "TrueBusterExpert_W"
  States {
   Spawn:
    MEGM A 0
    8A00 B 1
    8A00 A 1
    goto Spawn+2
   See:
    8A00 BCDE 5
    goto Spawn
   Missile:
    8A00 F 5 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    8A00 G 4
    goto Spawn+2
   Missile2:
    8A00 C 5
    8A00 F 1 A_JumpIfInventory("VivifyDelay3", 1, "Spawn")
    wait
   ClassPain:
    8A00 H 0
    goto MegamanPain
   ClassDeath:
    8A00 H 0
    goto MegamanDeath
  }
}

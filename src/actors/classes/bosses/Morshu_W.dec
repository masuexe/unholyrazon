actor Morshu_W_ScriptBar : ScriptBar {}
actor Morshu_W : BaseUnholyBossWep {
  Tag "$TAG_Morshu_W"
  Obituary "%o couldn't afford \ciMorshu\c- (%k)'s wares."
  Inventory.Pickupmessage "\cgMMMMMMMMMMMMMMMMM."
  Weapon.AmmoType "UnholyBossAmmo150"
  Weapon.AmmoType2 "UnholyBossAmmo100"
  // weapon.ammotype2 "UnholyPower3000"
  States {
   Spawn:
    8H56 [ 1
    wait
   Ready:
    8H56 A 0  // Initial setup: boss morph hook.
    8H56 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, MORSHU_DYE)
    goto ReadyX

   ReadyX:
    8H56 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ReadyX2")
    8H56 A 3 A_GiveInventory("Morshu_Ready8_P")
    loop

   ReadyX2:
    8H56 A 3 A_GiveInventory("Morshu_Ready0_P")
    loop

   Deselect:
    8H56 A 0
    goto DeselectSwap
   Select:
    8H56 A 0
    goto SelectSwap

   Fire:
    8H56 A 1 Offset(0, 34) A_JumpIfInventory("SuperArmTemp", 1, "Throw")
    8H56 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "YOULITTLE")
    8H56 A 0 A_PlaySoundEx("weapon/superarmuse", "Weapon")
    8H56 A 0 A_GiveInventory("SuperArmTemp")
    8H56 A 1 Offset(0, 42)
    8H56 A 1 Offset(0, 58)
    8H56 A 1 Offset(0, 90)
    8H56 A 1 Offset(0, 128)
    TNT1 A 4 A_WeaponReady(14)  // 2
    8H56 D 1 Offset(-33, 84)
    8H56 D 1 Offset(-21, 56) A_SpawnItemEx("MorshuBombLiftWarp", 86, 0, 0, 0, 0, 0, 0, 0)
    8H56 D 1 Offset(1, 32)
    8H56 B 1 Offset(-121, 112)
    8H56 B 1 Offset(-70, 72)
    8H56 B 1 Offset(-1, 32)
    TNT1 A 4 A_WeaponReady(14)  //
    TNT1 A 10  // 7 //
    goto FireWait
   FireWait:
    TNT1 A 2 A_WeaponReady
    8H56 A 0 A_GiveInventory("UnholyBossAmmo150", 2)
    8H56 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    loop
   Throw:
    8H56 B 2 Offset(-1, 32)
    8H56 B 1 Offset(-35, 56)  // 2
    8H56 A 0 A_FireCustomMissile("MorshuBombProjectile", 0, 1, 0, 56)
    8H56 A 0 A_TakeInventory("SuperArmTemp")
    8H56 B 0 A_ReFire(1)
    8H56 B 1 Offset(-70, 72)
    8H56 B 1 Offset(-121, 112)
    8H56 D 1 Offset(1, 32)
    8H56 D 1 Offset(-21, 56)
    8H56 D 1 Offset(-33, 84)
    TNT1 AAAAA 2
    TNT1 AAAAA 2 A_WeaponReady(WRF_NOPRIMARY)
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    8H56 A 1 Offset(0, 112)
    8H56 A 1 Offset(0, 100)
    8H56 A 1 Offset(0, 82)
    8H56 A 1 Offset(0, 70)
    8H56 A 1 Offset(0, 60)
    8H56 A 1 Offset(0, 52)
    8H56 A 1 Offset(0, 44)
    8H56 A 1 Offset(0, 36)
    8H56 A 1 Offset(0, 34)
    8H56 A 1 Offset(0, 32)
    goto ReadyX

   Altfire:
    8H56 A 0 A_JumpIfInventory("SuperArmTemp", 1, "Throw")
    8H56 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ComeGetSome")
    goto ReadyX
   ComeGetSome:
    // 8H56 A 0 A_JumpIfInventory("UnholyPower2",1500,"YOULITTLE")
    8H56 A 0 A_TakeInventory("UnholyBossAmmo150", 150)
    // This is a delay throw, but is it necessary?
    // I thought it'd just make sense, but meh.
    // Who cares.
    /*
8H56 A 1 Offset(10,28)
8H56 A 1 Offset(17,27)
8H56 A 1 Offset(25,26)
8H56 A 1 Offset(40,25)
8H56 A 1 Offset(80,25)
8H56 A 1 Offset(120,27)
8H56 A 1 Offset(180,30)
TNT1 A 4 A_WeaponReady(14)//2
     */
    8H56 B 2 Offset(-1, 32)
    8H56 B 1 Offset(-35, 56)  // 2
    8H56 B 1 Offset(-70, 72)
    8H56 A 0 A_PlaySoundEx("weapon/oilshot", "Weapon")
    8H56 A 0 A_FireCustomMissile("LampOilProjectile", 0, 1, 8, 0)
    8H56 B 1 Offset(-121, 112)
    8H56 D 1 Offset(1, 32)
    8H56 D 1 Offset(-21, 56)
    TNT1 AAAA 2
    TNT1 AAAAAAA 2 A_WeaponReady(WRF_NOPRIMARY)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    8H56 A 1 Offset(0, 112)
    8H56 A 1 Offset(0, 100)
    8H56 A 1 Offset(0, 82)
    8H56 A 1 Offset(0, 70)
    8H56 A 1 Offset(0, 60)
    8H56 A 1 Offset(0, 52)
    8H56 A 1 Offset(0, 44)
    8H56 A 1 Offset(0, 36)
    8H56 A 1 Offset(0, 34)
    8H56 A 1 Offset(0, 32)
    goto ReadyX

   Reload:
    8H56 A 0 A_JumpIfInventory("WireHookShotDelay", 1, "ReadyX")
    8H56 A 1 A_JumpIfInventory("UnholyBossAmmo100", 100, 1)
    goto ReadyX
    8H56 A 0 A_GiveInventory("WireHookShotDelay")
    // TNT1 A 0 A_TakeInventory("UnholyBossAmmo100",100)
    8H56 A 0 A_PlaySoundEx("KirbyNES/Hit_D", "Item")
    8H56 A 1 A_SpawnItemEx("MorshuRopeProjectile", -2, 0, 32, cos(-pitch) * 1, 0, sin(-pitch) * 1, 0, 0)
    // goto ReadyX  // Funny, but too op
    goto ReReloadLoop
   ReReloadLoop:
    8H56 A 1
    8H56 A 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_RELOAD), "ReadyX")
    loop

    // I'm sorry, I can't give credit!
    // Come back when you're a little...
    // MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM

    // Okay I'm lazy to do this.
    // Basically a warning would be the following line
    // COME GET SOME YOU LITTLE--
    // During the rage itself, you go a constant MMMMMMMMMMMMMMMMMMMMMMMM
    // And at the end you just say the final line that is BITCH.
    // Or the whole phrase is said before the rage itself at all.
    // Point is this rage is supposed to be destructive.
    // You're blowing the joint up with bombs, you've been challenged!
    // Yes this man is invul during the speech too, he's standing there and menacingly
    // Telling you to come at him.

    // Edit 2023 - Trist
    // That's no longer the case, enjoy this 12 second rage in where he's crying his woes.
    // Catch this Baka Mitai.

   YOULITTLE:
    8H56 B 0 A_TakeInventory("UnholyPower3000")
    8H56 B 0
    // 8H56 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)  // We expect to see him always falling
    8H56 B 0 A_GiveInventory("MorshuArmorPower")
    8H56 B 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    8H56 B 0 A_GiveInventory("CutterFlag", 420)  // 100
    8H56 B 0 A_GiveInventory("MorshuMitaiSound_P")
   MMMMMM:  // I'm sure you can make angle turns random?
    // 8I04 G 0 A_GiveInventory("VivifyDelay5") //I've no idea what this does.
    8H56 B 0 A_Jump(128, "MMMMMMX")
    8H56 B 0 A_TakeInventory("CutterFlag", 1)
    8H56 B 0 A_SpawnItemEx("MorshuBombProjectileLITE", 0, 0, 8, random(-96, 96), random(-96, 96), random(-96, 96))  // 32
    8H56 B 0 A_SetAngle(angle - 10.0)
    8H56 B 0 ThrustThing(random(0, 255), 500, 1, 0)
    8H56 B 1 A_SpawnItemEx("ForcedNegotiationHitbox", 0, 0, -44, velx, vely, velz, 0, 8, 0)
    // 8H56 B 0 A_PlaySoundEx("BUTTSCKS","Body")
    8H56 B 0 A_JumpIfInventory("CutterFlag", 1, "MMMMMM")
    goto BITCH
   MMMMMMX:
    8H56 B 0 A_TakeInventory("CutterFlag", 1)
    8H56 B 0 A_SpawnItemEx("MorshuBombProjectileLITE", 0, 0, 8, random(-96, 96), random(-96, 96), random(-96, 96))  // 32
    8H56 B 0 A_SetAngle(angle + 10.0)
    8H56 B 0 ThrustThing(random(0, 255), 500, 1, 0)
    8H56 B 1 A_SpawnItemEx("ForcedNegotiationHitbox", 0, 0, -44, velx, vely, velz, 0, 8, 0)
    // 8H56 B 0 A_PlaySoundEx("BUTTSCKS","Body")
    8H56 B 0 A_JumpIfInventory("CutterFlag", 1, "MMMMMM")
    goto BITCH
   BITCH:
    8H56 B 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    // 8H56 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    8H56 B 0 A_TakeInventory("MorshuArmorPower")
    8H56 B 35
    8H56 B 0
    goto ReadyX
  }
}

actor MorshuArmorPower : BasePowerPro {
  damagefactor "Normal", 0.15
}

actor Morshu_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    8H56 A 0 A_GiveInventory("UnholyBossAmmo150", 3)
    8H56 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    stop
  }
}
actor Morshu_Ready8_P : Morshu_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

// I'm not coloring bombs.
// Besides, I'm sure there's a way to make the m1 look pretty--
// ..Right?

actor MorshuBombLiftWarp : BasicShieldWarper {
  Translation "192:192=216:216", "198:198=41:41"
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    BOMB A 0 ACS_NamedExecuteAlways("uc_clientwarper", 0, -4)
    goto Lift
   Lift:
    "####" "#" 1 A_Warp(AAPTR_TARGET, 86, 0, 0, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 80, 0, 50, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 74, 0, 97, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 68, 0, 139, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 62, 0, 174, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 56, 0, 200, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 50, 0, 215, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 44, 0, 217, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 38, 0, 217, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 32, 0, 215, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 26, 0, 200, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 20, 0, 174, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 15, 0, 139, 0, 24)
    "####" "#" 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 2)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 10, 0, 97, 0, 24)
    "####" "#" 1 A_Warp(AAPTR_TARGET, 5, 0, 76, 0, 24)
   Shield:
    "####" "#" 1 A_Warp(AAPTR_TARGET, 0, 0, 56, 0, 24)  // 56
    loop
  }
}


actor ForcedNegotiationHitbox : BasicProjectile {
  Obituary "%o had buyer's remorse because of \ciMorshu\c- (%k)'s forced sales."
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  DamageType "MorshuRage"
  Radius 72
  Height 168
  Scale 5.5
  Damage (150)
  States {
   Spawn:
    TNT1 AAA 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor MorshuBombProjectile : BasicProjectile {
  DamageType "MorshuBomb"  // Victim plays clientsided MMM or some shit, why?
  Obituary "\ciMorshu\c- (%k) sold a bomb to %o."  // I mean, he just sold you this bomb.
  Damage (50)
  -NOGRAVITY
  Radius 10  // 6
  Height 10  // 7
  Scale 3.5  // 2.5
  Speed 42  // 40
  States {
   Spawn:
    BOMB A 0
    BOMB A 0 ThrustThingZ(0, 10, 0, 1)  // 12 Z
    BOMB A 1
    goto Spawn+2
   Death:  // Ceiling variant needed?
    BOMB A 0 A_Stop
    BOMB A 0 A_PlaySound("weapon/hyperbomb", 1, 0.9)
    BOMB A 0 A_ChangeFlag("NOGRAVITY", 1)
    BOMB A 0 Radius_Quake(3, 10, 0, 16, 0)  // 6
    BOMB A 0 A_Explode(228, 200, 0, 0, 96)  // 200 radius //Adjust if needed.
    CRAS A 0 A_JumpIf(z - floorz < 9, "FloorBoom")
    CRAS A 0 A_JumpIf(z - ceilingz == 0 - 10, "CeilingBoom")
    BOMB AAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, 8, random(-16, 16), random(-16, 16), random(-16, 16))  // 32
    BOMB AAAAAAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, 8, random(-32, 32), random(-32, 32), random(-32, 32))  // 32
    goto BaseBoom
    //
   FloorBoom:
    BOMB AAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, 8, random(-16, 16), random(-16, 16), random(4, 16))  // 32
    BOMB AAAAAAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, 8, random(-32, 32), random(-32, 32), random(6, 32))  // 32
    goto BaseBoom
    //
   CeilingBoom:
    BOMB AAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, -8, random(-16, 16), random(-16, 16), random(-4, -16))  // 32
    BOMB AAAAAAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, -8, random(-32, 32), random(-32, 32), random(-6, -32))  // 32
    goto BaseBoom
    //
   BaseBoom:
    BOMB BCDEFGHIJKLMNOPQR 1
    stop
  }
}

actor MorshuBombProjectileLITE : MorshuBombProjectile {  // Intensity reduction
  States {
   Death:  // Quake necessary? Who knows.
    BOMB A 0 A_Stop
    BOMB A 0 A_PlaySound("weapon/hyperbomb", 1, 0.9)
    BOMB A 0 A_ChangeFlag("NOGRAVITY", 1)
    BOMB A 0 A_Explode(228, 200, 0, 0, 96)  // 200 radius //Adjust if needed.
    BOMB AAAA 0 A_SpawnItemEx("MorshuBombDebris", 0, 0, 0, random(-32, 32), random(-32, 32), random(-32, 32))  // 32
    BOMB BCDEFGHIJKLMNOPQR 1
    stop
  }
}

actor MorshuBombDebris : BasicProjectile {
  Obituary "%o was caught by \ciMorshu\c- (%k)'s bomb debris."  // I mean, he just sold you this bomb.
  Translation "192:192=214:214"
  DamageType "MorshuBombX"
  +RIPPER
  -NOGRAVITY
  +FORCEXYBILLBOARD
  Damage (10)
  Radius 10
  Height 10
  Speed 20
  Scale 2.5
  States {
   Spawn:
    X_8G C 2 A_SpawnItemEx("MorshuBombDebrisFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    CRAS A 0 A_Stop
    CRAS A 0 A_ChangeFlag("NOGRAVITY", 1)
    CRAS A 0 A_PlaySound("weapon/crashexplode", 2, 0.55)
    CRAS K 3 A_Explode(75, 64, 0, 0, 32)
    CRAS LM 3
    CRAS N 3 A_Explode(75, 64, 0, 0, 32)
    CRAS OP 3
    CRAS Q 3 A_Explode(75, 64, 0, 0, 32)
    CRAS RS 3
    CRAS T 3 A_Explode(75, 64, 0, 0, 32)
    CRAS VW 3
    stop
  }
}

actor MorshuBombDebrisFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    X_8G AB 1 A_FadeOut
    loop
  }
}

actor LampOilProjectile : BasicProjectile {
  Translation "192:192=37:37", "198:198=46:46"
  DamageType "MorshuBomb"  //
  Obituary "%o caught \ciMorshu\c- (%k)'s lampoil Molotov."  // Or just Molotov.
  -NOGRAVITY
  // +SKYEXPLODE
  Damage (random(250, 275))  // 150
  Radius 12  // 8
  Height 12  // 8
  Speed 38  // 32
  Scale 2.5
  States {
   Spawn:
    8P56 A 0
    8P56 A 0 ThrustThingZ(0, 24, 0, 1)  // 25 //16
    8P56 ABCD 3  // 4
    goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 1 A_SpawnItemEx("LampOilExplode")
    stop
  }
}

actor LampOilExplode : BasicExplosion {
  DamageType "MorshuLampOil"  //
  Translation "192:192=160:160", "198:198=220:220"
  Obituary "%o caught \ciMorshu\c- (%k)'s lampoil Molotov."
  Scale 8.5  //
  States {
   Spawn:  // 6P03 ABCDEFG
    TNT1 A 0
    TNT1 A 0 Radius_Quake(6, 10, 0, 16, 0)
    TNT1 A 0 A_PlaySound("weapon/drillexplode", 1, 0.8)
    TNT1 A 0 A_ChangeFlag(NOGRAVITY, 1)
    TNT1 A 0 A_Explode(random(100, 125), 186, 0, 0, 64)  // 125 //164 range
    /*
TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX",0,10,-8,0,4.5f,11,0,0)
TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX",0,-10,-8,0,-4.5f,11,0,0)
TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX",10,0,-8,4.5f,0,11,0,0)
TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX",-10,0,-8,-4.5f,0,11,0,0)
     */
    6P03 AA 1 A_SpawnItemEx("LampOilExplode_Extend", random(-96, 96), random(-96, 96), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 BB 1 A_SpawnItemEx("LampOilExplode_Extend", random(-112, 112), random(-112, 112), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 CC 1 A_SpawnItemEx("LampOilExplode_Extend", random(-128, 128), random(-128, 128), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 DD 1 A_SpawnItemEx("LampOilExplode_Extend", random(-140, 140), random(-140, 140), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 EE 1 A_SpawnItemEx("LampOilExplode_Extend", random(-156, 156), random(-156, 156), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 FF 1 A_SpawnItemEx("LampOilExplode_Extend", random(-172, 172), random(-172, 172), random(-96, 96), 0, 0, 0, 0, 0)
    6P03 GG 1 A_SpawnItemEx("LampOilExplode_Extend", random(-192, 192), random(-192, 192), random(-96, 96), 0, 0, 0, 0, 0)
    stop
  }
}


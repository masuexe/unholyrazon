actor MorshuRopeProjectile : WireAdaptorHook {
  Translation "225:227=3:3", "42:45=3:3", "4:4=95:95", "168:168=95:95"
  Obituary "Upon the sight of Morshu\c- (%k)'s power, %o got on %p knees and surrendered."
  DamageType "MorshuRope"  // WireAdaptor
  ReactionTime 2  // 1 = normal, length = +1
  Damage (50)
  States {
   Spawn:
    WADP B 0
    WADP B 0 A_SetUserVar("user_CountDown", reactiontime)
    WADP B 0 A_SetUserVar(user_PTID, ACS_NamedExecuteWithResult("core_gettarget"))
    WADP B 0 A_GiveInventory("WeaponCharge", 1)
    WADP B 0 A_ScaleVelocity(50)  // 44
    goto Spawn2

   Spawn2:
    WADP B 0 ACS_NamedExecuteAlways("core_drawhookshot", 0, user_PTID, 18)
    WADP B 0 A_GiveToTarget("WireHookShotDelay", 1)
    WAD1 ABABAB 1 A_JumpIf(!CallACS("core_targetexists"), "SuperDeath")
    WADP B 0 A_GiveToTarget("WireHookShotDelay", 1)
    WAD1 ABABAB 1 A_JumpIf(!CallACS("core_targetexists"), "SuperDeath")
   WireLoop:
    WADP B 0 A_GiveToTarget("WireHookShotDelay", 1)
    WAD1 ABABAB 1 A_JumpIf(!CallACS("core_targetexists"), "SuperDeath")
    WADP B 0 A_SetUserVar("user_CountDown", user_CountDown - 1)
    WAD1 A 0 A_CountDown
    loop

   Death:
    WADP B 0 A_JumpIfCloser(64, "SuperDeath")
   XDeath:
   Crash:
    WADP B 0 A_JumpIf(user_CountDown == 0, "SuperDeath")
    WADP B 0 A_JumpIfInventory("WeaponCharge", 2, "SuperDeath")
    WADP B 0 A_JumpIfInventory("WeaponCharge", 1, 1)
    goto SuperDeathPoof  // Kill hook early if it never got through the Spawn state.
    WADP B 0 A_PlaySoundEx("weapon/crashland", "Weapon")
    WADP B 0 A_GiveToTarget("MorshuRope_P")
    WADP B 0 A_JumpIfInventory("NoHookshot", 1, "Death1", AAPTR_TRACER)
    WADP B 0 A_CheckFlag("SHOOTABLE", "Death2", AAPTR_TRACER)
    goto Death1
   Death1:
    WADP B 0 ACS_NamedExecuteAlways("core_hookshot", 0, user_PTID, 40, 0)
    WAD1 B 3
    goto DeathLoop1
   Death2:
    WADP B 0 ACS_NamedExecuteAlways("core_hookshot", 0, user_PTID, 40, 1)
    WAD1 B 3
    goto DeathLoop2
  }
}

actor MorshuRope_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    TNT1 A 0 A_SpawnItemEx("MorshuBombProjectile", 0, 0, 36, 0, 0, 15, 0, 1)
    stop
  }
}


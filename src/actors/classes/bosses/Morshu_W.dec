actor PainMorshuMolotovBurn : Basic_PainTID_H {
  States {
   Check:
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 6056, PSN_SET_TO, 16) > 0, "DoT")
    stop
   DoT:  // 50
    TNT1 AAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("PainMorshuMolotovBurnDamager")
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 6056, PSN_ADJUST, -1) <= 0, "Death")
    loop
  }
}

actor PainMorshuMolotovBurnDamager : BasicExplosion {
  Translation "192:192=217:217", "198:198=221:221", "199:199=223:223", "202:202=214:214", "168:168=214:214", "4:4=214:214"
  DamageType "MorshuLampBurn"
  Obituary "Oof (%k -> %o)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pokemon/FireSpin", 2, 0.75)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_Explode(10, 15, 0, 0, 15)
    TNT1 AAAA 0 A_SpawnItemEx("MorshuMolotovBurnExtraFX", random(-24, 24), random(-24, 24), random(-8, 8), frandom(-3, 3), frandom(-3, 3), frandom(-1, 4), 0, 1)
    TNT1 A 1 A_SpawnItemEx("MorshuMolotovBurnFX", 0, 0, -8, 0, 0, 0.5, 0, 1)
    stop
  }
}

actor MorshuMolotovBurnExtraFX : BasicClientSide {
  Alpha 0.95
  Scale 1.5
  States {

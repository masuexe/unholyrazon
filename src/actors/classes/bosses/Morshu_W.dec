actor LampOilExplode_Extend : LampOilExplode {
  Translation "202:202=160:160", "192:192=218:218", "198:198=227:227", "199:199=167:167"
  DamageType "MorshuBomb"  //
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    // TNT1 A 0 A_Explode(random(20,25),128,0,0,32) //25 damage //80 range
    TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX", 0, 10, -8, 0, 4.5f, 11, 0, 0)
    TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX", 0, -10, -8, 0, -4.5f, 11, 0, 0)
    TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX", 10, 0, -8, 4.5f, 0, 11, 0, 0)
    TNT1 A 0 A_SpawnItemEx("LampOilExplodeFX", -10, 0, -8, -4.5f, 0, 11, 0, 0)
    6PRS ABCDEFG 2 A_Explode(10, 128, 0, 0, 32)  // 25 damage //80 range
    6PRS HIJ 2  // A_Fadeout(0.04) //08
    stop
  }
}


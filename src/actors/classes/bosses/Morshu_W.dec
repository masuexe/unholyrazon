actor MorshuMitaiSound_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_GetPlayerInfo", PLAYERINFO_GENDER) == 2, "NonHuman")
    // TNT1 A 0 A_PlaySoundEx("weapon/MorshuMitai","SoundSlot6") //If it ain't loud enough.
    // TNT1 A 0 A_PlaySoundEx("weapon/MorshuMitai","SoundSlot7") //Make it play twice to make it loud enough.
    TNT1 A 0 A_PlaySound("weapon/MorshuMitai", 6, 0.8, 0, ATTN_NONE)  // Just make this louder.
    // TNT1 A 0 A_PlaySound("weapon/MorshuMitai", 7, 1.0, 0, ATTN_NONE) //Playing it twice might cause an issue and rather, inconsistent... eeheheheehe..........
    stop
   NonHuman:
    TNT1 A 0 A_PlaySound("weapon/NotMorshuMitai", 6, 0.8, 0, ATTN_NONE)
    stop
  }
}

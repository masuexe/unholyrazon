actor TorCal_KO_FX : BasicGraphicEffect {
  Translation "192:192=61:61", "198:198=79:79"
  Radius 3
  Height 3
  renderstyle add
  States {
   SpawnFrame:
    X_7D IJKL 2 A_FadeOut(0.02)
    stop
  }
}


// I JUST WANT TO RECREATE THE DAMN SMASH EFFECT ON BEING HIT REALLY HARD
actor TorCal_KO_DUST : BasicGraphicEffect  // "Thanks Cel." - Trist 2022
{
  -CLIENTSIDEONLY
  Translation "192:192=61:61", "198:198=79:79"
  States {
   SpawnFrame:
    6P51 ABC 3
    stop
  }
}

//

actor TorCal_Smoke : BasicGraphicEffect  // Clientsided, this shouldn't damage anything or anyone.
{
  Translation "192:192=86:86", "198:198=92:92"
  -NOINTERACTION
  +THRUACTORS
  +NOPAIN
  +HEXENBOUNCE
  +DONTSPLASH
  alpha 0.55  // 0.75
  Speed 20
  Radius 8
  Height 8
  scale 2.0  // 2.5
  damage (0)
  reactiontime 3  // 4 //20
  Bouncecount 6
  states {
   SpawnFrame:
    8P03 ABCD 2
    8P03 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0
    8P03 ABCD 2 A_FadeOut(0.08)
    stop
  }
}

actor TorCal_Smoke_Cancel_P : CustomInventory {
  States {
   Pickup:
    TNT1 AAAAAAAAA 0 A_SpawnItemEx("TorCal_Smoke", random(-5, 0), random(-20, 20), random(0, 70), random(-2, 2), random(-2, 2), random(-2, 2), 0, 0)  // 32
    stop
  }
}


//

// One should not have to repeat this method just to beat out desync, this game sucks
actor TorCal_Cloak_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 1 A_TakeFromTarget("The_Cloak_From_Harry_Potter", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("The_Cloak_From_Harry_Potter", 1, "Spawn")
    goto Death
   Death:
    TNT1 A 0 A_GiveToTarget("TorCal_Reset_P", 1)
    TNT1 A 0
    stop
  }
}

actor TorCal_Reset_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("TorCal_Invis_Powerup")
    TNT1 A 0 A_GiveInventory("TorCal_Smoke_Cancel_P")  // 1
    TNT1 A 0 A_TakeInventory("The_Cloak_From_Harry_Potter")
    TNT1 A 0 A_ChangeFlag("DONTIDENTIFYTARGET", 0)
    TNT1 A 0 A_ChangeFlag("CANTSEEK", 0)  // just to be sure?
    stop
  }
}

actor TorCal_MiniReset_P : CustomInventory  // All it does is FORCEFULLY remove the ammo in the case something messes up.
{  // Look, I know there's a better way of handling this.
  States  // But copying actors doesn't... really hurt anyone.
  {  // Maybe bloat the filesize of a text lump-- BUT STILL !
   Pickup:
    TNT1 A 0 A_TakeInventory("The_Cloak_From_Harry_Potter")
    stop
  }
}

actor TorCal_Invis_Powerup : PowerInvisibility {
  +CANTSEEK
  Powerup.Mode "Translucent"
  Powerup.Strength 100
  Powerup.Duration 0x7FFFFFFD
}

actor The_Cloak_From_Harry_Potter : Inventory {
  inventory.amount 1
  inventory.maxamount 200
}

// My favorite recycle methods.
actor TorCal_Revolver_Shot : BasicFastProjectile {
  DamageType "TorCal_Damage"
  Obituary "\ccAgent Torcal \c-(%k) shot %o, somehow."
  Translation "192:192=229:229", "198:198=43:43", "202:202=229:229", "199:199=43:43"
  +SKYEXPLODE
  +DONTBLAST
  +BLOODLESSIMPACT
  +THRUGHOST
  //
  var int user_POWER;  //
  //
  MissileHeight 6
  MissileType "TorCal_Revolver_Shot_FX"
  damage (random(185, 205)-user_POWER)
  radius 12
  height 12
  speed 500
  Scale 2.5
  States {
   Spawn:  // Originally TNT1 A 1, but 3 ticks seems good for MAX damage upclose... right?
    TNT1 A 3  // Unless this sucks ass and it's not worth keeping.
   OkForReal:  // ...You tell me.
    TNT1 A 2 A_SetUserVar("user_POWER", user_POWER+15)  // originally 1 tic
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 6, "NoMoreDrop")  // originally 8, but that's too harsh.
    loop  // wait
   NoMoreDrop:
    TNT1 A 1
    wait
   Crash:
    8P51 B 0
    8P51 B 0 A_PlaySoundEx("weapon/SpyHit", "SoundSlot5")  //
    8P51 BCDEF 1
    stop
   Death:
    8P51 B 0
    8P51 B 0 A_SpawnItemEX("Torcal_Smoke_Puff", 0, 0, 4, 0, 0, 3)  // 8z //4zv
    UMFX B 2
    8P51 B 0 A_PlaySoundEx("weapon/SpyMiss", "SoundSlot5")  //
    UMFX BCD 2
    stop
  }
}

actor TorCal_Revolver_Shot_FX : BasicGraphicEffect {
  Translation "192:192=214:214", "198:198=248:248"
  +FORCEXYBILLBOARD
  Alpha 0.95  // 0.8
  Scale 1.0  // 1.5
  States {
   SpawnFrame:  // 2 tic
    X_8G C 2
   OKNOWGO:
    X_8G C 1 A_FadeOut(0.065)  // 0.05
    loop
  }
}

actor Torcal_Smoke_Puff : BasicGraphicEffect {
  Translation "192:192=82:82", "198:198=90:90"
  Renderstyle "Translucent"
  Alpha 1.0  //
  Scale 2.5  // 2.0
  States {
   SpawnFrame:
    6P28 AB 2
    goto Death
   Death:
    6P28 AB 2 A_Fadeout(0.05)
    loop
  }
}

actor TorCal_Knife_Damager : BasicProjectile
{  // Well Hi there.
  Translation "192:192=86:86", "198:198=92:92"
  damagetype "TorCal_Knifers"
  Obituary "\ccAgent Torcal \c-(%k) clapped %o."  // Filler
  +DONTBLAST
  +DONTSPLASH
  reactiontime 1
  damage (10)  // Fair game.
  Radius 20
  Height 20
  speed 70
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 1
    stop
   XDeath:
    TNT1 A 1
    stop
   Death:
    TNT1 A 0  // A_Explode(10,64,0,0,64)
    TNT1 A 1 A_SpawnItemEx("TorCal_Knife_FX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor TorCal_Knife_FX : BasicGraphicEffect  // BasicKnifeStabFX
{
  States {
   SpawnFrame:
    6P53 FE 2
    stop
  }
}

actor TorCal_Stab_Protect : PowerProtection {
  Powerup.Duration 5
  damagefactor "TorCal_Knifers", 0.0
}

// Just make sure the sounds are appropriate.

actor TorCal_Normal_Stab : BasicExplosion {
  Translation "192:192=86:86", "198:198=92:92"
  damagetype "TorCal_Damage"
  Obituary "\ccAgent Torcal \c-(%k) ineffectively silenced %o."  // Filler
  +FORCEXYBILLBOARD
  Scale 2.5
  Args 250  // 200
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pokemon/FireSpin", 2, 0.75)
    TNT1 A 0 A_Explode(Args[0], 15, 0, 0, 15)
    6P53 LJI 3
    stop
  }
}

actor TorCal_Back_Stab : TorCal_Normal_Stab {
  Translation "192:192=86:86", "198:198=92:92"
  damagetype "TorCal_DamageEX"
  Obituary "\ccAgent Torcal \c-(%k) effectively silenced %o."  // Filler
  +PIERCEARMOR  //
  Args 3000  // 1200
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("KirbyNES/Hit_D", 2, 1.0)
    TNT1 A 0 A_Explode(Args[0], 15, 0, 0, 15)
    6P53 LKJ 3
    stop
  }
}

//
actor Pain_TorCal_Backstab : Basic_PainFling_H {
  var int user_A;
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, CallACS("core_getptrtid", 2))
    TNT1 A 0 A_TransferPointer(2, 0, 2, 2)
    TNT1 A 0 A_SetUserVar("user_A", angle)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SetUserVar("user_A", angle-user_A)
    TNT1 A 0 Thing_Move(0, Args[4], 1)
    TNT1 A 0 A_JumpIf((user_A>90 && user_A<270)||(user_A<-90 && user_A>-270), "Back")
    TNT1 A 0 A_JumpIf(1, "Front")
   Front:
    TNT1 A 3 A_SpawnItemEx("TorCal_Normal_Stab", 0, 0, 32)
    stop
   Back:
    TNT1 A 3 A_SpawnItemEx("TorCal_Back_Stab", 0, 0, 32)
    stop
  }
}
//

actor ConniverRetribution : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/LeAppear", "SoundSlot7")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, ELP_NATIVE)
    // TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 1000)
    stop
  }
}

   PhaseHold21:
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
   PhaseFrame22:
    TNT1 A 0 A_ScaleVelocity(0.0)
   PhaseFrame23:
    TNT1 A 0 A_PlaySoundEx("Pain/TerryBogard", "SoundSlot7")
   PhaseFrame24:

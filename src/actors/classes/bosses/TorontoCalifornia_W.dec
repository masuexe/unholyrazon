actor TorontoCalifornia_W_ScriptBar : ScriptBar {}
actor TorontoCalifornia_W : BaseUnholyBossWep {
  Tag "$TAG_TorontoCalifornia_W"
  Obituary "%o and %k reached S support."
  Inventory.Pickupmessage "\cjLET'S FIGHTING LOVE!"
  Weapon.AmmoType1 "UnholyBossAmmo150"  // 100
  //
  -WEAPON.DONTBOB
  Weapon.BobStyle "Smooth"
  Weapon.BobSpeed 3.0
  //
  States {
   Spawn:
    8H62 [ 1
    wait

   Ready:
    8H62 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, TORCAL_DYE)
    // ExtraLife: morphActorToBoss (Ready may re-enter online)
    // 8H62 A 0 A_GiveInventory("Your_Taxes",2) //Acts as 3 lives, might be the base.
    8H62 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H62 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ReadyX16")
    8H62 A 2 A_WeaponReady
    loop
   ReadyX16:
    8H62 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
    goto ReadyX
    //
   Flash:
    TNT1 A 0  // A_Log("Flash")
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak")  //
    TNT1 A 1 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_ChangeVelocity(velx * 1.045, vely * 1.045, velz, CVF_REPLACE)  // 1.045
    goto Flash+1
    TNT1 A 0 A_ChangeVelocity(velx * 1.035, vely * 1.035, velz, CVF_REPLACE)  // 1.035
    goto Flash+1
    // Fix was attempted here
   Flash_Cloak:
    TNT1 A 0  // A_Log("Flash_Cloak")
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 3)
    TNT1 A 0 A_ChangeVelocity(velx * 1.045, vely * 1.045, velz, CVF_REPLACE)  // 1.045
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak_A")  //
    goto Delayed_Flash
    TNT1 A 0 A_ChangeVelocity(velx * 1.035, vely * 1.035, velz, CVF_REPLACE)  // 1.035
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak_A")  //
    goto Delayed_Flash

   Flash_Cloak_A:
    goto Flash_Cloak+1

   Delayed_Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 100, "Quick_Cancel_2")  // 50 //20
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 3)
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 1 A_ChangeVelocity(velx * 1.045, vely * 1.045, velz, CVF_REPLACE)  // 1.045
    loop
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 1 A_ChangeVelocity(velx * 1.035, vely * 1.035, velz, CVF_REPLACE)  // 1.035
    loop
    //
   Quick_Cancel_2:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    goto Flash
    //

    //
   Deselect:
    8H00 C 0
    goto DeselectSwap
   Select:
    8H00 C 0
    goto SelectSwap

   Fire:
    // 8H62 A 1 A_WeaponReady(14)
    8H62 A 0  // A_JumpIfNoAmmo("ReloadXX") //High Priority. //ReloadX
    8H62 A 0 A_GiveInventory("TorCal_MiniReset_P")  // A_TakeInventory("The_Cloak_From_Harry_Potter")
    8H62 A 1 Offset(3, 36)
    8H62 A 1 Offset(6, 39)
    8H62 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")  //
    8H62 A 0 A_FireCustomMissile("TorCal_Revolver_Shot", 0, 0, 8, 0)
    // 8H62 A 1 Offset(28,61)
    8H62 A 1 Offset(29, 62)  //
    8H62 A 1 Offset(28, 61)
    8H62 A 1 Offset(27, 60)
    8H62 A 1 Offset(15, 48)
    8H62 A 1 Offset(10, 44)
    8H62 A 1 Offset(7, 42) A_ReFire("FireHoldDelay")
    8H62 A 1 Offset(5, 40) A_ClearReFire
    8H62 A 2 A_WeaponReady(14)
    goto FireEnd  // ReadyX
   FireHoldDelay:
    8H62 A 1 Offset(5, 40) A_RailWait
    8H62 A 1 A_WeaponReady(14)
    8H62 A 1 A_RailWait
    8H62 A 0 A_ReFire("FireHoldDelayX")
    goto FireEnd
   FireHoldDelayX:
    8H62 A 1 A_RailWait
    8H62 A 0 A_ReFire("FireHoldDelayX")
    goto FireEnd
   FireEnd:
    8H62 A 1 A_ClearReFire
    8H62 A 1 A_WeaponReady(14)
    goto ReadyX
    /// ////////////

   Altfire:  // Or should it check if you have the power up? I don't know what's better.
    8H62 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "ForceOfHabit")  //
   AltfireX:
    8H62 A 0 A_GiveInventory("TorCal_MiniReset_P")  // A_TakeInventory("The_Cloak_From_Harry_Potter")
    8H62 A 1 A_WeaponReady(14)
    8H62 A 1 Offset(0, 40) A_GiveInventory("TorCal_Animation_Flag")
    // 8H62 A 1 Offset(0,46)
    8H62 A 1 Offset(0, 58)
    // 8H62 A 1 Offset(0,80)
    8H62 A 1 Offset(0, 100)
    TNT1 A 6
    8H62 B 1 Offset(30, 70)
    8H62 B 1 Offset(24, 60)
    8H62 B 0 A_PlaySoundEx("B_Toad/Swipe", "Weapon")
    8H62 B 1 Offset(-4, 36) A_TakeInventory("TorCal_Animation_Flag")
    8H62 C 1 Offset(-120, 20) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, 16, 0)
    8H62 C 1 Offset(-140, 32) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, 0, 0)
    8H62 C 1 Offset(-162, 60) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, -16, 0)
    8H62 C 1 Offset(-180, 74)
    8H62 C 1 Offset(-188, 85)
    TNT1 A 8 A_WeaponReady(14)
    8H62 A 1 Offset(0, 80)
    8H62 A 1 Offset(0, 70)
    8H62 A 1 Offset(0, 60)
    8H62 A 1 Offset(0, 50)
    8H62 A 1 Offset(0, 40)
    8H62 A 1 Offset(0, 35)
    8H62 A 1 Offset(0, 33)
    8H62 A 1 Offset(0, 32)
    // 8H62 A 1 Offset(0,34)
    goto ReadyX

   Reload:
    8H62 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "Jump")
    goto ReadyX
   Jump:
    8H62 A 0 A_TakeInventory("UnholyBossAmmo150")
    8H62 A 0 A_SpawnItemEx("TorCal_Smoke_Helper", 0, 0, 28, 0, 0, 0, 0, 0)  // 1
    8H62 A 0 A_GiveInventory("TorCal_Invis_Powerup")
    8H62 A 0 A_GiveInventory("The_Cloak_From_Harry_Potter", 200)  // 100
    8H62 A 0 A_SpawnItemEx("TorCal_Cloak_H", 0, 0, 28)
    8H62 A 1
    goto ReadyX

   ForceOfHabit:  //
    TNT1 A 0 A_PlaySoundEx("S_Spin/DANGER", "SoundSlot6")  //
    goto Altfirex
    //
    //
    //
   PhaseResume:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 59, "PhaseHold58")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 58, "PhaseHold57")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 57, "PhaseHold56")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 56, "PhaseHold55")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 55, "PhaseHold54")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 54, "PhaseHold53")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 53, "PhaseHold52")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 52, "PhaseHold51")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 46, "PhaseHold45")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 44, "PhaseHold43")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 43, "PhaseHold42")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 41, "PhaseHold40")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 39, "PhaseHold38")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 37, "PhaseHold36")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 35, "PhaseHold34")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 33, "PhaseHold32")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 31, "PhaseHold30")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 29, "PhaseHold28")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 27, "PhaseHold26")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 25, "PhaseHold24")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 22, "PhaseHold21")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 20, "PhaseHold19")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 18, "PhaseHold17")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 16, "PhaseHold15")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 14, "PhaseHold13")
    TNT1 A 1
    goto PhaseResume

   Violent_Eggman_Coughing:
   PhaseFrame0:
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaPainFlag")
   PhaseFrame1:
    TNT1 A 0 A_TakeInventory("TorCal_Animation_Flag")
   PhaseFrame2:
    TNT1 A 0 A_GiveInventory("TorCal_Animation_Flag_X")
   PhaseFrame3:
    TNT1 A 0 A_GiveInventory("TorCal_MiniReset_P")
   PhaseFrame4:
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Body")
   PhaseFrame5:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
   PhaseFrame6:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
   PhaseFrame7:
    TNT1 A 0 A_TakeInventory("StuntDoubleFlagX")
   PhaseFrame8:
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
   PhaseFrame9:
    TNT1 A 0 A_SpawnItemEx("TorCal_KO_DUST", 0, 0, 0, 0, 0, 0, 0, 0, 0)
   PhaseFrame10:
    TNT1 A 0 A_SpawnItemEx("TorCal_KO_Helper", 0, 0, 28, 0, 0, 0, 0, 0)
   PhaseFrame11:
    TNT1 A 0 A_WeaponReady(14)
   PhaseFrame12:
    TNT1 A 0 A_ScaleVelocity(0.0)
   PhaseFrame13:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 14)
   PhaseHold13:
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
   PhaseFrame14:
    TNT1 A 0 A_ScaleVelocity(0.0)
   PhaseFrame15:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 16)
   PhaseHold15:
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
   PhaseFrame16:

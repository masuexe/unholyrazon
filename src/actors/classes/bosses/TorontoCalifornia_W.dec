actor TorontoCalifornia_W_ScriptBar : ScriptBar {}
actor TorontoCalifornia_W : BaseUnholyBossWep  // TheSpyHasFallenForAnIntelligence
{
  Obituary "%o and %k reached S support."
  Inventory.Pickupmessage "\cjLET'S FIGHTING LOVE!"
  weapon.ammotype1 "UnholyBossAmmo150"  // 100
  //
  -WEAPON.DONTBOB
  Weapon.BobStyle "Smooth"
  Weapon.BobSpeed 3.0
  //
  States {
   Spawn:
    8H62 [ 1
    wait

   Ready:
    8H62 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, TORCAL_DYE)
    // ExtraLife: morphActorToBoss (Ready may re-enter online)
    // 8H62 A 0 A_GiveInventory("Your_Taxes",2) //Acts as 3 lives, might be the base.
    8H62 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H62 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ReadyX16")
    8H62 A 2 A_WeaponReady
    loop
   ReadyX16:
    8H62 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
    goto ReadyX
    //
   Flash:
    TNT1 A 0  // A_Log("Flash")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak")  //
    TNT1 A 1 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_ChangeVelocity((momx)*1.045, (momy)*1.045, (momz), CVF_REPLACE)  // 1.045
    goto Flash+1
    TNT1 A 0 A_ChangeVelocity((momx)*1.035, (momy)*1.035, (momz), CVF_REPLACE)  // 1.035
    goto Flash+1
    // Fix was attempted here
   Flash_Cloak:
    TNT1 A 0  // A_Log("Flash_Cloak")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 1 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 3)
    TNT1 A 0 A_ChangeVelocity((momx)*1.045, (momy)*1.045, (momz), CVF_REPLACE)  // 1.045
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak_A")  //
    Goto Delayed_Flash
    TNT1 A 0 A_ChangeVelocity((momx)*1.035, (momy)*1.035, (momz), CVF_REPLACE)  // 1.035
    TNT1 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "Flash_Cloak_A")  //
    Goto Delayed_Flash

   Flash_Cloak_A:
    goto Flash_Cloak+1

   Delayed_Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 100, "Quick_Cancel_2")  // 50 //20
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 3)
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 1 A_ChangeVelocity((momx)*1.045, (momy)*1.045, (momz), CVF_REPLACE)  // 1.045
    loop
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaHealthCheck_P")
    TNT1 A 1 A_ChangeVelocity((momx)*1.035, (momy)*1.035, (momz), CVF_REPLACE)  // 1.035
    loop
    //
   Quick_Cancel_2:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    Goto Flash
    //

    //
   Deselect:
    8H00 C 0
    goto DeselectSwap
   Select:
    8H00 C 0
    goto SelectSwap

   Fire:
    // 8H62 A 1 A_WeaponReady(14)
    8H62 A 0  // A_JumpIfNoAmmo("ReloadXX") //High Priority. //ReloadX
    8H62 A 0 A_GiveInventory("TorCal_MiniReset_P")  // A_TakeInventory("The_Cloak_From_Harry_Potter")
    8H62 A 1 Offset(3, 36)
    8H62 A 1 Offset(6, 39)
    8H62 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")  //
    8H62 A 0 A_FireCustomMissile("TorCal_Revolver_Shot", 0, 0, 8, 0)
    // 8H62 A 1 Offset(28,61)
    8H62 A 1 Offset(29, 62)  //
    8H62 A 1 Offset(28, 61)
    8H62 A 1 Offset(27, 60)
    8H62 A 1 Offset(15, 48)
    8H62 A 1 Offset(10, 44)
    8H62 A 1 Offset(7, 42) A_Refire("FireHoldDelay")
    8H62 A 1 Offset(5, 40) A_ClearRefire
    8H62 A 2 A_WeaponReady(14)
    Goto FireEnd  // ReadyX
   FireHoldDelay:
    8H62 A 1 Offset(5, 40) A_RailWait
    8H62 A 1 A_WeaponReady(14)
    8H62 A 1 A_RailWait
    8H62 A 0 A_Refire("FireHoldDelayX")
    Goto FireEnd
   FireHoldDelayX:
    8H62 A 1 A_RailWait
    8H62 A 0 A_Refire("FireHoldDelayX")
    goto FireEnd
   FireEnd:
    8H62 A 1 A_ClearRefire
    8H62 A 1 A_WeaponReady(14)
    Goto ReadyX
    /// ////////////

   Altfire:  // Or should it check if you have the power up? I don't know what's better.
    8H62 A 0 A_JumpIfInventory("The_Cloak_From_Harry_Potter", 1, "ForceOfHabit")  //
   AltfireX:
    8H62 A 0 A_GiveInventory("TorCal_MiniReset_P")  // A_TakeInventory("The_Cloak_From_Harry_Potter")
    8H62 A 1 A_WeaponReady(14)
    8H62 A 1 offset(0, 40) A_GiveInventory("TorCal_Animation_Flag", 1)
    // 8H62 A 1 offset(0,46)
    8H62 A 1 offset(0, 58)
    // 8H62 A 1 offset(0,80)
    8H62 A 1 offset(0, 100)
    TNT1 A 6
    8H62 B 1 Offset(30, 70)
    8H62 B 1 Offset(24, 60)
    8H62 B 0 A_PlaySoundEx("B_Toad/Swipe", "Weapon")
    8H62 B 1 Offset(-4, 36) A_TakeInventory("TorCal_Animation_Flag", 1)
    8H62 C 1 Offset(-120, 20) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, 16, 0)
    8H62 C 1 Offset(-140, 32) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, 0, 0)
    8H62 C 1 Offset(-162, 60) A_FireCustomMissile("TorCal_Knife_Damager", 0, 0, -16, 0)
    8H62 C 1 Offset(-180, 74)
    8H62 C 1 Offset(-188, 85)
    TNT1 A 8 A_WeaponReady(14)
    8H62 A 1 offset(0, 80)
    8H62 A 1 offset(0, 70)
    8H62 A 1 offset(0, 60)
    8H62 A 1 offset(0, 50)
    8H62 A 1 offset(0, 40)
    8H62 A 1 offset(0, 35)
    8H62 A 1 offset(0, 33)
    8H62 A 1 offset(0, 32)
    // 8H62 A 1 offset(0,34)
    Goto ReadyX

   Reload:
    8H62 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "Jump")
    goto ReadyX
   Jump:
    8H62 A 0 A_TakeInventory("UnholyBossAmmo150")
    8H62 A 0 A_SpawnItemEx("TorCal_Smoke_Helper", 0, 0, 28, 0, 0, 0, 0, 0)  // 1
    8H62 A 0 A_GiveInventory("TorCal_Invis_Powerup", 1)
    8H62 A 0 A_GiveInventory("The_Cloak_From_Harry_Potter", 200)  // 100
    8H62 A 0 A_SpawnItemEx("TorCal_Cloak_H", 0, 0, 28)
    8H62 A 1
    goto ReadyX

   ForceOfHabit:  //
    TNT1 A 0 A_PlaySoundEx("S_Spin/DANGER", "SoundSlot6")  //
    Goto Altfirex
    //
    //
    //
   Violent_Eggman_Coughing:
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaPainFlag")
    TNT1 A 0 A_TakeInventory("TorCal_Animation_Flag")
    TNT1 A 0 A_GiveInventory("TorCal_Animation_Flag_X")
    TNT1 A 0 A_GiveInventory("TorCal_MiniReset_P")  // A_TakeInventory("The_Cloak_From_Harry_Potter")
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Body")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 A_TakeInventory("StuntDoubleFlagX")
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
    TNT1 A 0 A_SpawnItemEx("TorCal_KO_DUST", 0, 0, 0, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("TorCal_KO_Helper", 0, 0, 28, 0, 0, 0, 0, 0)  // 1
    TNT1 A 0 A_WeaponReady(14)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 10, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 0 A_PlaySoundEx("Pain/TerryBogard", "SoundSlot7")  //
    TNT1 A 1 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    TNT1 A 0 ThrustThingZ(0, 35, 0, 0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 50, 1, 0)
    TNT1 A 0 A_ScaleVelocity(0.0)
    TNT1 A 1 ThrustThing(random(0, 255), 100, 1, 0)
   I_MISS_MY_WIFE_TAILS:
    TNT1 A 140  // Add some fun dialogue here, I do not know.
    Goto THE_BIGGEST_THRRRRRRRRRRROT
   THE_BIGGEST_THRRRRRRRRRRROT:
    TNT1 A 0 A_GiveInventory("TorCal_Smoke_Cancel_P")  // Fun
    TNT1 A 2
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P")
    TNT1 A 0 HealThing(30000, CallACS("core_getmaxhealth"))  // CallACS("UH_FetchMyHealth",1) //ACS_ExecuteAlways(U_HEALTHACS,0,7)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    TNT1 A 0 A_TakeInventory("TorCal_Animation_Flag_X")
    8H62 A 1 offset(0, 80)
    8H62 A 1 offset(0, 70)
    8H62 A 1 offset(0, 60)
    8H62 A 1 offset(0, 50)
    8H62 A 1 offset(0, 40)
    8H62 A 1 offset(0, 35)
    8H62 A 1 offset(0, 33)
    8H62 A 1 offset(0, 32)
    Goto IM_BACK_AT_THE_BASE_AGAIN
   IM_BACK_AT_THE_BASE_AGAIN:
    8H62 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
    8H62 A 0 A_TakeInventory("TorontoCaliforniaPainFlag")
    8H62 A 0 A_GiveInventory("TorontoCaliforniaSwapBack_P")
    // God_Take_Me:
    // 8H62 A 0 A_GiveInventory("StopUser_Buddha",1)
    stop
  }
}

// Same attacks; Pissed Ready only runs Violent_Eggman_Coughing once.
// Swap back to TorontoCalifornia_W after revive so ConniverRetribution ExtraLife can trigger again.
actor TorontoCalifornia_W_Pissed : TorontoCalifornia_W {
  States {
   Ready:
    8H62 A 0 A_JumpIfInventory("TorontoCaliforniaGetUpDone_F", 1, "ReadyAfterGetUp")
    8H62 A 0 A_GiveInventory("TorontoCaliforniaGetUpDone_F")
    8H62 A 0 A_JumpIf(true, "Violent_Eggman_Coughing")
    Goto Violent_Eggman_Coughing
   ReadyAfterGetUp:
    8H62 A 0 A_GunFlash
    Goto ReadyX
  }
}

actor TorontoCaliforniaHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, 1)
    goto NoSwap
    TNT1 A 0 A_JumpIfInventory("TorontoCalifornia_W_Pissed", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("TorontoCaliforniaPainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("TorontoCaliforniaSwapPissed_P")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor TorontoCaliforniaSwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("TorontoCaliforniaGetUpDone_F")
    TNT1 A 0 A_GiveInventory("TorontoCalifornia_W_Pissed")
    TNT1 A 0 A_TakeInventory("TorontoCalifornia_W")
    stop
  }
}

actor TorontoCaliforniaSwapBack_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("TorontoCalifornia_W", 1, "Done")
    TNT1 A 0 A_GiveInventory("TorontoCalifornia_W")
    TNT1 A 0 A_TakeInventory("TorontoCalifornia_W_Pissed")
   Done:
    TNT1 A 0 A_GunFlash
    stop
  }
}

actor TorontoCaliforniaGetUpDone_F : Once {}
actor TorontoCaliforniaPainFlag : Once {}

actor TorCal_CloakAmmoDrain_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("The_Cloak_From_Harry_Potter", 1)
    stop
  }
}

actor TorCal_Animation_Flag : Once {}
actor TorCal_Animation_Flag_X : Once {}

actor TorCal_Smoke_Helper : BasicWatcher {
  ReactionTime 28  // 35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 28, 0, 8)
    TNT1 A 1 A_SpawnItemEx("TorCal_Smoke", random(-15, 15), random(-20, 20), random(-28, 42), 0, 0, 0, 0, 0)  // 33
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor TorCal_KO_Helper : BasicWatcher {
  ReactionTime 25  // 35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 28, 0, 8)
    TNT1 A 0 A_SpawnItemEx("TorCal_KO_FX", random(-15, 15), random(-20, 20), random(-28, 42), 0, 0, 0, 0, 0)  // 33
    TNT1 A 1 A_SpawnItemEx("TorCal_KO_FX", random(-15, 15), random(-20, 20), random(-28, 42), 0, 0, 0, 0, 0)  // 33
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 1
    stop
  }
}


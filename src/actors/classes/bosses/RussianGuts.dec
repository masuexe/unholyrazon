// TODO: add "SeeSomeRocks" sprite

// Comrade Guts in russian?
actor RussianGuts : BossBase {
  Player.ScoreIcon "UB047MUG"
  Player.SoundClass "RussianGuts"
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 0.92, 0.92
  Player.JumpZ 13
  Player.MaxHealth 3275
  Health 3275
  Player.MorphWeapon "RussianGuts_W"
  States {
   Spawn:
    8A47 A 0
    // 8A47 A 0 A_JumpIfInventory("SuperArmTemp",1,3)
    8A47 B 1
    8A47 A -1
    goto Spawn+2
   See:
    8A47 BCDE 2
    goto Spawn
   Missile:
    // 8A47 F 0 A_JumpIfInventory("SuperArmTemp",1,"SeeSomeRocks")
    8A47 F 0 A_JumpIfInventory("VivifyDelay10", 1, "MissileL")
    8A47 F 5
    8A47 G 4
    goto Spawn+2
   MissileL:
    8A47 F 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileL2")
    loop
   MissileL2:
    8A47 F 1
    8A47 G 5
    goto Spawn+2
   ClassPain:
    8A47 H 0
    goto MegamanPain
   ClassDeath:
    8A47 H 0
    goto MegamanDeath
  }
}

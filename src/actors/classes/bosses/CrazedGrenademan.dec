// TODO: update skin sprite to fit in his mugshot

// Doctor VYG, please forgive me!
actor CrazedGrenademan : BossBase {  // Filler name
  // Havoc Harry - Lunatic Larry - Dane Insane | <-- Alt names
  Player.ScoreIcon "UB055MUG"
  Player.SoundClass "CrazedGrenademan"
  Player.ForwardMove 1.32, 1.32  // 1.15
  Player.SideMove 1.16, 1.16  // 1.12
  Player.JumpZ 12
  Player.MaxHealth 3865  // 3000~ish.
  Health 3865
  Player.MorphWeapon "CrazedGrenademan_W"
  States {
   Spawn:
    GREM A 0
    GREM B 1
    GREM A 1
    goto Spawn+2
   See:
    GREM BCDE 3  // 5
    goto Spawn
   CustomState1:
    GREM B 1
    GREM B 0 A_JumpIfInventory("VivifyFlag1", 1, 2) GREM B 0 A_JumpIf(true, "Spawn")
    GREM C 1
    GREM C 0 A_JumpIfInventory("VivifyFlag1", 1, 2) GREM C 0 A_JumpIf(true, "Spawn")
    GREM D 1
    GREM D 0 A_JumpIfInventory("VivifyFlag1", 1, 2) GREM D 0 A_JumpIf(true, "Spawn")
    GREM E 1
    GREM E 0 A_JumpIfInventory("VivifyFlag1", 1, "CustomState1") GREM E 0 A_JumpIf(true, "Spawn")
    loop
   Missile:
    GREM F 5
    GREM G 4
    goto Spawn+2
   ClassPain:
    GREM H 0
    goto MegamanPain
   ClassDeath:
    GREM H 0
    goto MegamanDeath
  }
}

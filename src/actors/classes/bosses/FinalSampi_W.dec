actor FinalSampi_W : BaseUnholyBossWep {
  Tag "$TAG_Boss402_W"
  Obituary "\c[UH49]Sampi\c- (%k) turned %o into ashes."
  weapon.ammotype "UnholyBossAmmo250"
  weapon.ammotype2 "UnholyBossAmmo200"
  States {
   Spawn:
    8L02 [ 1
    wait

   Deselect:
    8L02 A 0
    goto DeselectSwap
   Select:
    8L02 A 0
    goto SelectSwap

   Ready:
    8L02 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, FINALSAMPI_DYE)
    8L02 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8L02 A 2 A_WeaponReady
    8L02 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8L02 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    loop

   Flash:
    TNT1 A 4 A_GiveInventory("UnholyBossAmmo200", 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 1)  // 2
    loop
   Fire:
    8L02 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "THUNDERBREAKER")
    8L02 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8L02 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    8L02 A 0 A_PlaySoundEx("weapon/flamesword", "Weapon")
    8L02 A 0 A_PlaySoundEx("weapon/slashclaw", "Body")
    8L02 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "Fire2")
    8L02 A 0 A_GiveInventory("DuoBusterFlag")
    8L02 A 0 A_FireCustomMissile("BladeOfSampiCutter", 0, 0, 8, 0)
    8L02 EFGGGFE 2
    8L02 A 12
    Goto ReadyX
   Fire2:
    8L02 A 0 A_FireCustomMissile("BladeOfSampiCutter", 0, 0, -8, 0)
    8L02 KLMMMLK 2
    8L02 A 12 A_TakeInventory("DuoBusterFlag")
    Goto ReadyX

   Reload:
    8L02 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, 1)
    goto ReadyX
    8L02 A 0 A_TakeInventory("UnholyBossAmmo250", 250)
    8L02 A 0 A_JumpIf(true, "SampiReload")
   SampiReload:
    8L02 A 2
    goto ReadyX

    // Make altfire counter
    // short lasting skullbarrier
    // If close, zangief grab them and slam into the ground
    // doing a shock wave.
   AltFire:
    // TREB B 0 A_JumpIfNoAmmo("NoAmmo")
    // HEBO A 0 A_Jump(256,"TYRANTFISTMOVE")
    HEBO B 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "SampiAttackA")
    Goto ReadyX

   CounterMoveA:  // Unused.
    HEBO A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    // HEBO A 0 A_FireCustomMissile("HISMCOUNTERHITBOXFLING",0,0,8,0)
    // HEBO A 0 A_FireCustomMissile("HISMCOUNTERHITBOX",0,0,8,0)
    // HEBO BCB 2 A_JumpIfCloser(96, "TOHELLYOUGOFAGGASSO")
    HEBO A 15
    Goto ReadyX
    /*TOHELLYOUGOFAGGASSO:
HEBO A 0 A_FaceTarget
HEBO A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
HEBO A 0 A_FireCustomMissile("HISMCOUNTERHITBOXFLING",0,0,8,0)
HEBO BCB 2
HEBO A 15
Goto ReadyX*/

   THUNDERBREAKER:
    8L02 B 0 A_GiveInventory("UnholyPowerDazzle_F")
    8L02 B 0 A_TakeInventory("UnholyPower3000")
    8L02 B 0 A_SpawnItemEx("SampiLightningRage", 32)
    8L02 B 0 A_Stop
    8L02 B 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    8L02 B 4 ThrustThingZ(0, 75, 0, 0)
    8L02 B 0 A_Stop
    8L02 BCCC 3
    8L02 B 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    8L02 DDDDDDDD 10 A_FireCustomMissile("SampiLightningBolt1", random(-320, 320), 0, 0, 0)  // 1280
    8L02 DDDDDDDDDD 6 A_FireCustomMissile("SampiLightningBolt2", random(-150, 150), 0, 0, 0)  // 680
    8L02 DDDDDDDDDDDDDD 4 A_FireCustomMissile("SampiLightningBolt2", random(-90, 90), 0, 0, 0)  // 360
    8L02 JJPPJJPPJJPPJJPPJJPPJJ 2 A_FireCustomMissile("SampiLightningBolt3", random(-45, 45), 0, 0, 0)  // 60
    8L02 C 3 A_TakeInventory("UnholyPowerDazzle_F")
    8L02 CB 3
    8L02 B 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 0, 0)
    8L02 B 0
    8L02 BAAA 3
    Goto ReadyX

   TYRANTFISTMOVE:
    8L02 A 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    8L02 B 0 A_GiveInventory("UnholyPowerDazzle_F")
    8L02 B 0 A_TakeInventory("UnholyPower3000")
    8L02 B 0 A_Stop
    8L02 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8L02 B 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8L02 BBBBBBBBB 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12))
    8L02 B 0 ThrustThingZ(0, 300, 0, 0)
    8L02 B 0 A_SetTranslucent(0.0, 0)
    8L02 BBBBB 2 A_SpawnItemEx("SampiParticleFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    8L02 CCCCCCCCCCCC 10 ThrustThingZ(0, 100, 0, 0)
    8L02 C 0 A_SetTranslucent(1.0, 0)

    8L02 C 0 A_PlaySoundEx("items/AMETEOR", "Weapon")
    8L02 C 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8L02 C 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8L02 C 0 ThrustThingZ(0, 175, 1, 0)
   TYRANTTHRASHER:
    8L02 DD 0 A_SpawnItemEx("SampiParticleFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    8L02 D 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "POWAFISTAAH")
    8L02 D 0 A_SpawnItemEX("BackupSampiHitbox", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    loop
   POWAFISTAAH:
    8L02 A 0 Radius_Quake(8, 35, 0, 50, 0)
    8L02 A 0 A_PlaySoundEx("misc/hugequake", "Body")
    8L02 B 0 A_SpawnItemEx("SampiLightningShockwaveSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    8L02 BBBBBBBBB 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12))
    8L02 BBB 2 A_SpawnItemEx("SampiLightningShockwaveSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    8L02 B 2 A_FireCustomMissile("SampiMeteorRageSpawner", 0, 0, 0, 0)
    8L02 B 12 A_TakeInventory("UnholyPowerDazzle_F")
    8L02 BBB 3
    8L02 A 20
    Goto ReadyX

   SampiAttackA:
    8L02 B 0 A_JumpIfInventory("UnholyPower3000", 3000, "TYRANTFISTMOVE")
    8L02 A 0 A_PlaySoundEx("Pokemon/RageStart", "Weapon")
    8L02 B 0 ThrustThingZ(0, 5, 0, 0)
    8L02 BBBBBBBBB 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12))
    8L02 A 0 A_Recoil(-35)  // -105
    // HEBO CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 1 A_JumpIfCloser(96, "SampiMeleeContact") //64 //128
    // HEBO CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 1 A_SpawnItemEX("KREIYYUKENHITBOXER",0,0,8,momx,momy,momz,0,SXF_ABSOLUTEMOMENTUM,0)
   POWAFISTA:
    8L02 B 0 A_Recoil(-3)
    8L02 B 1 A_SpawnItemEX("KREIYYUKENHITBOXER", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    8L02 BB 0 A_SpawnItemEx("SampiParticleFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    8L02 B 0 A_TakeInventory("UnholyBossAmmo200", 10)
    8L02 B 0 A_JumpIfInventory("UnholyBossAmmo200", 1, "POWAFISTA")
    Goto MovementCease1
   MovementCease1:
    8L02 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8L02 A 15
    Goto ReadyX

    /*SampiMeleeContact:
HEBO B 1 A_SpawnItemEX("KREIYYUKENHITBOXER",0,0,8,momx,momy,momz,0,SXF_ABSOLUTEMOMENTUM,0)
HEBO B 0 ThrustThingZ(0,25,0,0)
HEBO C 3 A_Recoil(10)
HEBO B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
HEBO B 15
HEBO A 0 A_Refire
Goto ReadyX*/
  }
}


    8L02 B 0 A_PlaySoundEx("weapon/firestorm", "Weapon")
    8L02 B 0 A_FireCustomMissile("FlareFrenzyFlameHelper", 0, 0, 0, 0)
    8L02 BCD 3
    8L02 DDDCB 2
    8L02 A 10
    Goto ReadyX
  }
}

actor BladeOfSampiCutter : BasicProjectile {
  Translation "192:192=186:186", "198:198=191:191"
  Damagetype "Sampi"
  Obituary "%k turned %o into ashes."
  // +RIPPER
  // renderstyle "Translucent"
  // Alpha 1.0
  Damage (225)
  Radius 24
  Height 14
  speed 55
  scale 4
  States {
   Spawn:
    // X_BA HI 2 A_SpawnItemEx("SampiParticleFX", random(-34,34), random(-34,34), random(-66,66),0,0,0,0,32)
    X_BA HI 2 A_SpawnItemEx("BladeOfSampiCutterFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Crash:
    TNT1 A 0 A_Explode(100, 168, 0)
    X_BA HIHI 4 A_SpawnItemEx("BladeOfSampiCutterBoom", 0, 0, 0, 0, 0, 0, 0, 1)
    X_BA HIHIHI 2 A_Fadeout
    stop
   Death:
    TNT1 A 0 A_Explode(150, 168, 0)
    X_BA H 2 A_Recoil(4)
    TNT1 A 4
    X_BA I 2
    TNT1 A 4
    X_BA H 2
    TNT1 A 4
    X_BA I 2
    stop
  }
}

actor BladeOfSampiCutterBoom : BasicExplosion {
  Damagetype "Sampi"
  Obituary "%k turned %o into ashes."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(6, 35, 0, 50, 0)
    TNT1 AAA 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), 0, random(-10, 10), random(-10, 10), 0, random(-5, 12), random(0, 359), 1)
    TNT1 A 4 A_Explode(65, 96, 0)
    stop
  }
}

actor BladeOfSampiCutterFX : BasicGraphicEffect {
  Scale 4
  States {
   SpawnFrame:
    TNT1 A 0 A_SpawnItemEx("SampiParticleFX", random(-34, 34), random(-34, 34), random(-66, 66), 0, 0, 0, 0, 33)
    X_BA HIHIHIHI 2 BRIGHT A_FadeOut
    stop
  }
}


actor SampiFlingShot : BasicProjectile {
  Translation "192:192=186:186", "198:198=191:191"
  damagetype "SampiFling"
  Obituary "%o BECAME WINNER."
  +SEEKERMISSILE
  renderstyle "Translucent"
  alpha 0.95
  damage (75)
  Radius 12
  Height 12
  speed 60
  scale 4
  States {
   Spawn:
    TMFX A 0 A_SeekerMissile(90, 90, 3, 256, 4)
    TMFX A 1 A_SpawnItemEx("SampiParticleFX", random(-4, 4), random(-6, 6), random(-2, 8), random(-4, 4), random(-2, 2), random(0, 6), 0, 1)
    TMFX B 0 A_SeekerMissile(90, 90, 3, 256, 4)
    TMFX B 1 A_SpawnItemEx("SampiParticleFX", random(-4, 4), random(-2, 8), random(-6, 6), random(-4, 4), random(0, 6), random(-2, 2), 0, 1)
    TMFX C 0 A_SeekerMissile(90, 90, 3, 256, 4)
    TMFX C 1 A_SpawnItemEx("SampiParticleFX", random(-4, 4), random(-6, 6), random(-8, 2), random(-4, 4), random(-2, 2), random(-6, 0), 0, 1)
    TMFX D 0 A_SeekerMissile(90, 90, 3, 256, 4)
    TMFX D 1 A_SpawnItemEx("SampiParticleFX", random(-4, 4), random(-8, 2), random(-6, 6), random(-4, 4), random(-6, 0), random(-2, 2), 0, 1)
    loop
   XDeath:
    TNT1 A 0 A_Stop
    TNT1 A 1 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
    TNT1 A 0 Radius_Quake(6, 35, 0, 50, 0)
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TMFX ABCD 2
    stop
   Death:
    TMFX ABCD 2
    stop
  }
}


actor FlareFrenzyFlameHelper : BasicWatcher {
  Translation "192:192=186:186", "198:198=191:191"
  ReactionTime 5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("FlareFrenzyFlame", 20, 60, 0, 25, 0, 0, 0, 1)  // 30
    TNT1 A 0 A_SpawnItemEx("FlareFrenzyFlame", 20, 20, 0, 25, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("FlareFrenzyFlame", 20, -20, 0, 25, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("FlareFrenzyFlame", 20, -60, 0, 25, 0, 0, 0, 1)

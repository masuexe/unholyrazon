actor FinalSampi_W1_ScriptBar : ScriptBar {}
actor FinalSampi_W2_ScriptBar : ScriptBar {}
actor FinalSampi_W3_ScriptBar : ScriptBar {}
actor FinalSampi_W4_ScriptBar : ScriptBar {}
actor FinalSampi_W5_ScriptBar : ScriptBar {}
actor FinalSampi_W6_ScriptBar : ScriptBar {}

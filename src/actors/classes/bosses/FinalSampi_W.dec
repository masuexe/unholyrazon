actor SampiPinpointMeteor : BasicProjectile {
  damagetype "SampiStun"
  Obituary "\c[UH49]Sampi\c- (%k) turned %o into ashes."
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  renderstyle "Translucent"
  alpha 0.95
  Reactiontime 100
  damage (50)
  Radius 8
  Height 16
  speed 20
  scale 4.0
  States {
   Spawn:
    TMFX A 0
    TMFX A 0 A_ChangeVelocity(0, 0, momz, 3)
    TMFX A 1 A_JumpIf(ceilingz-z>8, "Spawn2")
    TMFX A 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TMFX B 1 A_JumpIf(ceilingz-z>8, "Spawn2")
    TMFX B 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TMFX B 0 A_JumpIf(momz==0, "Death")
    TMFX B 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    TMFX A 0 A_ChangeFlag("RIPPER", 0)
    TMFX A 0 A_ChangeFlag("NOINTERACTION", 0)
    TMFX A 0 A_ChangeVelocity(0, 0, momz, 3)
    TMFX AB 1 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TMFX B 0 A_JumpIf(momz==0, "Death")
    TMFX B 0 A_CountDown
    Goto Spawn2+2
   Death:
    TNT1 A 0
    TNT1 A 0  // A_SetGravity(0.0)
    TNT1 A 0 Radius_Quake(6, 35, 0, 50, 0)
    TNT1 AAAAA 0 A_SpawnItemEx("SampiParticleFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TNT1 A 0 A_Explode(215, 168, 0)
    TMFX ABCD 2
    stop
  }
}


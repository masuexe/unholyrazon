    TNT1 A 0 A_SpawnItemEx("SampiLightningShockwave", 0, 0, 0, 3, 0, 0, 260, 1)
    TNT1 A 0 A_SpawnItemEx("SampiLightningShockwave", 0, 0, 0, 3, 0, 0, 280, 1)
    TNT1 A 0 A_SpawnItemEx("SampiLightningShockwave", 0, 0, 0, 3, 0, 0, 300, 1)
    TNT1 A 0 A_SpawnItemEx("SampiLightningShockwave", 0, 0, 0, 3, 0, 0, 320, 1)
    TNT1 A 0 A_SpawnItemEx("SampiLightningShockwave", 0, 0, 0, 3, 0, 0, 340, 1)
    TNT1 A 1
    stop
  }
}

actor SampiLightningShockwave : BasicProjectile {
  Translation "192:192=186:186"
  damagetype "SampiHell"
  Obituary "%o never stood a chance against \c[UH49]Sampi\c- (%k)."
  +FLOORHUGGER
  +THRUGHOST
  +RIPPER
  +DONTBLAST
  +DONTREFLECT
  Damage (85)
  Radius 32
  Height 32
  Speed 36
  Scale 2.0
  States {
   Spawn:
    X_0E T 10
    X_0E T 5 A_ScaleVelocity(1.8)
    X_0E T 4 A_ScaleVelocity(2.2)
    X_0E T 3 A_ScaleVelocity(3.0)
    TNT1 A 10 A_SpawnItemEx("SampiLightningShockwaveFX", -1*sqrt(momx*momx+momy*momy), 0, 0, momx, momy, momz, 0, 1+8)
    stop
  }
}

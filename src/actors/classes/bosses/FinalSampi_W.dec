  }
}


// Special B - Tyrant's Fists

actor SampiMeteorRage1 : BasicProjectile {
  Translation "4:4=176:176", "202:202=179:179", "192:192=182:182", "198:198=186:186", "199:199=191:191"
  damagetype "SampiHell"
  Obituary "%o was not tough enough to face \c[UH49]Sampi\c- (%k)'s meteor."
  +THRUGHOST
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  +DONTREFLECT
  renderstyle translucent
  alpha 0.1
  Reactiontime 100
  Damage (666)
  Radius 260
  Height 300
  Speed 0
  Scale 4.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAA 0 A_SpawnItemEx("SampiMeteorRage2", random(500, -500), random(500, -500), 0, 0, 0, random(-6, -18), 0, 1)
    8P29 QQQQQQQQQ 1 A_FadeIn(0.1)
   Travel:
    8P29 Q 0 A_ChangeVelocity(0, 0, momz, 3)
    8P29 QQ 1 A_JumpIf(ceilingz-z>300, "Spawn2")
    8P29 Q 0 A_SpawnItemEx("SampiMeteorRage1FX", 0, 0, 0, 0, 0, 0, 0, 1)
    8P29 Q 0 A_JumpIf(momz==0, "Death")
    8P29 Q 0 A_CountDown
    goto Travel

   Spawn2:
    8P29 Q 0 A_ChangeFlag("RIPPER", 0)
    8P29 Q 0 A_ChangeFlag("NOINTERACTION", 0)
    8P29 Q 2 A_ChangeVelocity(0, 0, momz, 3)
    8P29 Q 0 A_SpawnItemEx("SampiMeteorRage1FX", 0, 0, 0, 0, 0, 0, 0, 1)
    8P29 Q 0 A_JumpIf(momz==0, "Death")
    8P29 Q 0 A_CountDown
    Goto Spawn2+2

   Death:
    TNT1 A 0 Radius_Quake(6, 35, 0, 50, 0)
    TNT1 A 0 A_playSoundEx("weapon/astrocrush", "Weapon", 0, 1)
    TNT1 A 0 A_Explode(400, 640, 0, 0, 128)
    TNT1 AAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("SampiMeteorRageBoom", random(-300, 300), random(-300, 300), random(-300, 300))
    stop
  }
}

actor SampiMeteorRage1FX : BasicGraphicEffect {
  Scale 4.0
  alpha 0.3
  States {
   SpawnFrame:
    8P29 Q 2 A_FadeOut(0.02)
    loop
  }
}

actor SampiMeteorRage2 : BasicProjectile {
  damagetype "SampiHell"
  Obituary "%o was not tough enough to face \c[UH49]Sampi\c- (%k)'s meteor."
  +THRUGHOST
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  damage (105)
  radius 32
  height 16
  Speed 0
  Scale 5
  States {
   Spawn:
    X_8B B 0
    X_8B B 0 A_ChangeVelocity(0, 0, momz, 3)
    X_8B XXXYYYZZZ 1 A_JumpIf(ceilingz-z>16, "Spawn2")
    X_8B B 0 A_JumpIf(momz==0, "Death")
    X_8B B 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    X_8B B 0 A_ChangeFlag("RIPPER", 0)
    X_8B B 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B XYZ 3 A_ChangeVelocity(0, 0, momz, 3)
    X_8B B 0 A_JumpIf(momz==0, "Death")

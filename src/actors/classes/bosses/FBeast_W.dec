actor FBeast_W1_ScriptBar : ScriptBar {}
actor FBeast_W2_ScriptBar : ScriptBar {}
actor FBeast_W3_ScriptBar : ScriptBar {}
actor FBeast_W4_ScriptBar : ScriptBar {}
actor FBeast_W5_ScriptBar : ScriptBar {}

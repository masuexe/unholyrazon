Actor FBeast_W1 : BaseUnholyBossWep
{
Tag "$TAG_Boss109_W"
Obituary "%o was removed from the system by \c[UB109]F-Beast\c- (%k)."
Inventory.Pickupmessage "\crHow did you literally rip off the talons from a giant bird...? Oh well, they're yours now."
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyPower1500"
Inventory.Icon "BI_109A"
States
{
Spawn:
8I09 [ 1
wait

Ready:
8I09 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,"ReadyRage")
8I09 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FBEAST_DYE)
goto ReadyX
ReadyRage:
8I09 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_PREVCOLOR)
8I09 A 0 A_GunFlash
goto ReadyX
ReadyX:
8I09 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"ReadyX1")
8I09 A 2 A_WeaponReady(8)
8I09 A 0 A_JumpIfInventory("AquaCrossFlag",1,"ReadyX")
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
ReadyX1:
8I09 A 2 A_WeaponReady
8I09 A 0 A_JumpIfInventory("AquaCrossFlag",1,"ReadyX1")
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
Deselect:
8I09 A 0
goto DeselectSwap
Select:
8I09 A 0
goto SelectSwap

Fire:
8I09 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,"PrimalFire")
8I09 A 0 A_JumpIfInventory("UnholyPower1500",1500,"EnragedMode")
8I09 A 0 A_GiveInventory("VivifyDelay9")
8I09 A 0 A_Refire(1)
8I09 A 0 A_PlaySoundEx("MMBN6/FalzarBuster","Weapon")
8I09 A 0 A_FireCustomMissile("FBeast_Shot",0,0,8,0)
8I09 A 0 A_FireCustomMissile("FBeast_Shot2",0,0,-32,0)
8I09 A 0 A_FireCustomMissile("FBeast_Shot2",0,0,48,0)
8I09 B 2
8I09 C 2
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8I09 A 0 A_PlaySoundEx("MMBN6/FalzarBuster","Weapon")
8I09 A 0 A_FireCustomMissile("FBeast_Shot",0,0,8,0)
8I09 A 0 A_FireCustomMissile("FBeast_Shot2",0,0,-32,0)
8I09 A 0 A_FireCustomMissile("FBeast_Shot2",0,0,48,0)
8I09 B 2
8I09 C 2
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8I09 A 0 A_PlaySoundEx("MMBN6/FalzarBuster","Weapon")
8I09 A 0 A_FireCustomMissile("FBeast_Shot",0,0,8,0)
8I09 B 2
8I09 C 2
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",1)
Goto ReadyX
PrimalFire:
8I09 A 0 A_GiveInventory("VivifyDelay3")
8I09 A 0 A_Refire(1)
8I09 A 0 A_PlaySoundEx("MMBN6/FalzarBuster","Weapon")
8I09 B 2 A_FireCustomMissile("FBeastFury_Shot",0,0,8,0)
8I09 C 1 A_FireCustomMissile("FBeastFury_Shot",0,0,random(-12,12),random(-12,12),0)
8I09 A 0 A_GiveInventory("UnholyBossAmmo100",1)
Goto ReadyX

EnragedMode:
8I09 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I09 A 0 A_GiveInventory("PrimalBeastOut_F",700)
8I09 A 0 A_TakeInventory("UnholyPower1500",1500)
8I09 A 2 A_SpawnItemEx("FBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I09 A 0 A_GunFlash("Flash.Primal")
8I09 AA 4 A_GiveInventory("PrimalBeastOut_F",700)
8I09 AAA 8 A_SpawnItemEx("FBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I09 AAAAA 5 A_SpawnItemEx("FBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I09 A 0 A_GiveInventory("PrimalBeastOut_F",700)
8I09 A 0 A_SpawnItemEx("PrimalBeastOut_H")
8I09 A 0 A_GunFlash
8I09 A 5 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
goto ReadyX


Flash.Primal:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", FBEAST_DYE2)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", FBEAST_DYE)
loop
Flash:
TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,1)
goto FlashEnd
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FBEAST_DYE2)
TNT1 AAAAA 1
TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,1)
goto FlashEnd
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FBEAST_DYE)
TNT1 AAAAA 1
goto Flash
FlashEnd:
TNT1 AA 1 ACS_NamedExecuteWithResult("core_chargecolor", FBEAST_DYE)
stop

AltFire:
8I09 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"AltSuccess")
goto NoAmmo
NoAmmo:
8I09 A 1
goto ReadyX
AltSuccess:
8I09 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
8I09 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, "CrossAttackB")
8I09 A 0 A_JumpIf(true, "CrossAttack")
CrossAttack:
8I09 A 0 A_TakeInventory("UnholyBossAmmo100",100)
8I09 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,"CrossAttackB")
FSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
FSWP A 0 A_CustomPunch(300,1,0,"FBeastLongSwipe",300)
FSWP ABC 2
FSWP D 10
TNT1 A 5
FSWP A 0 A_PlaySoundEx("weapon/GBSlash2","Weapon")
FSWP E 2 A_FireCustomMissile("FBeastWideSwipe",-60,0,20,-16,0,0)
FSWP F 2 A_FireCustomMissile("FBeastWideSwipe",-30,0,10,-8,0,0)
FSWP G 2 A_FireCustomMissile("FBeastWideSwipe",0,0,0,0,0,0)
FSWP H 1 A_FireCustomMissile("FBeastWideSwipe",30,0,-10,8,0,0)
FSWP H 1 A_FireCustomMissile("FBeastWideSwipe",60,0,-20,-16,0,0)
FSWP H 8
TNT1 A 5
goto ReadyX

CrossAttackB:
//same as above here
FSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
FSWP A 0 A_CustomPunch(300,1,0,"FBeastLongSwipe",300)
FSWP ABC 1
FSWP D 2
TNT1 A 2
FSWP A 0 A_PlaySoundEx("weapon/GBSlash2","Weapon")
FSWP E 1 A_FireCustomMissile("FBeastWideSwipe",-60,0,20,-16,0,0)
FSWP F 1 A_FireCustomMissile("FBeastWideSwipe",-30,0,10,-8,0,0)
FSWP G 1 A_FireCustomMissile("FBeastWideSwipe",0,0,0,0,0,0)

actor BerserkerRageFlag : Inventory {
  Inventory.MaxAmount 32
}

actor BerserkerRageGiver_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 1 A_GiveToTarget("UnholyPower2500", 2)
    loop
  }
}
actor BerserkerRageConsumer_P : CustomInventory //Desync fix
{
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyPower2500", 2500)
    TNT1 A 0 A_TakeInventory("UnholyPower2500", 2500)
    stop
  }
}
actor MountainousWheelWaveSpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 45)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 90)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 135)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 225)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 270)
    TNT1 A 0 A_SpawnItemEx("MountainousWheelWave", 0, 0, 0, 32, 0, 0, 315)
    stop
  }
}
actor MountainousWheelWave : BasicProjectile {
  damagetype "Berserker"
  Obituary "%o was crushed by \cgBerserker\c- (%k)'s Mountainous Wheel."
  +RIPPER
  +FLOORHUGGER
  +DONTREFLECT
  +INVISIBLE
  Damage (random(25, 35))
  Radius 10
  Height 10
  Speed 32
  reactiontime 15
  States {
   Spawn:
    //TNT1 A 0 A_Explode(150, 150, 0)
    TNT1 A 1 A_SpawnItemEx("MountainousWheelWave2")
    TNT1 A 0 A_Countdown
    Loop
  }
}
actor MountainousWheelWave2 : MountainousWheelWave {
  +THRUGHOST
  +DONTBLAST
  Damage (random(40, 65))
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 10 A_SpawnItemEx("MountainousWheelWaveFX")
    stop
  }
}
actor MountainousWheelWaveFX : BasicGraphicEffect {
  Translation "4:4=175:175", "192:192=43:43", "198:198=223:223"
  Scale 5
  States {
   SpawnFrame:
    X_BG D 4
    X_BG CBA 2 A_Fadeout
    stop
  }
}
actor Berserker_SuplexGrabber : BasicExplosion {
  damagetype "BerserkerSuplex"
  Obituary "%o was drained to death by \cgBerserker\c- (%k)'s Bloodlust."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(100, 1280, 0, 1, 128)//64
    TNT1 A 1
    stop
  }
}
actor Berserker_SuplexThrow : BasicExplosion {
  damagetype "Berserker"
  Obituary "%o was drained to death by \cgBerserker\c- (%k)'s Bloodlust."
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Thing_Move(0, CallACS("rz_CountInv_SuplexID", 2)-1+1000, 1)
    TNT1 A 0 A_Explode(150, 48, 0, 1, 49)
    Stop
  }
}
actor Berserker_Suplex_Toss_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "P_S")
    TNT1 A 0 A_SpawnItemEx("Berserker_SuplexThrow", 0, 0, 0, 0, 0, 0, 0, 41, 0)
    stop
   P_S:
    TNT1 AAA 0 A_SpawnItemEx("Berserker_SuplexThrow", 0, 0, 0, 0, 0, 0, 0, 41, 0)
    stop
  }
}
actor Berserker_GrabReset_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SuplexID")
    TNT1 A 0 A_TakeInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, false)
    stop
  }
}
actor ExtremeOverkill_StompWave_H : BasicWatcher {
  DeathSound "misc/hugequake"
  Args 200
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(7, 45, 0, 8, 0)
    //TNT1 A 0 A_PlaySound("misc/hugequake",1)
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("ExtremeOverkill_StompWave", 0, 0, 0, 30, 0, 0, -60+Args[0]*6)
    TNT1 A 0 A_CountDownArg(0)
    loop
   SpawnL2:
    TNT1 A 0 A_SpawnItemEx("ExtremeOverkill_StompWave", 0, 0, 0, 30, 0, 0, 0+Args[0]*15)
    TNT1 A 0 A_CountDownArg(0)//23
    TNT1 A 0 A_Jump(256, "SpawnL2")
    goto Death
   Death:
    TNT1 A 0
    TNT1 A 45
    stop
  }
}
actor ExtremeOverkill_StompWave : BasicProjectile {
  Translation "192:192=144:144", "198:198=15:15"
  Damagetype "Berserker"
  Obituary "%o couldn't survive \cgBerserker\c- (%k)'s Extreme Overkill."
  +FORCEXYBILLBOARD
  +FLOORHUGGER
  //+NODROPOFF
  //MaxDropOffHeight 64
  Damage (48)//80
  Radius 32
  Height 32
  Speed 30
  Scale 2.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    6P36 L 36
    6P36 L 32
    //6P36 PQMNOPQMNOPQMNOPQ 1
    TNT1 A 1 A_SpawnItemEx("SumoW_StompWaveFX", -1*sqrt(momx*momx+momy*momy), 0, 0, momx, momy, momz, 0, 1+8)
    stop
    //6P36 A 1 A_FadeOut(0.1)
    //wait
    //DUOR T
  }
}
actor ExtremeOverkillBloodSpawner {
  States {
   Spawn:
    TNT1 A 1//70
   Death:
    TNT1 A 0 A_SpawnItemEx("ExtremeOverkillBlood")
    stop
  }
}
actor ExtremeOverkillBlood : BasicProjectile {
  Translation "4:4=160:160", "192:192=217:217", "198:198=220:220"
  +FLOORHUGGER
  +THRUGHOST
  +THRUACTORS
  +RIPPER
  Damagetype "BerserkerBlood"
  Obituary "%o couldn't survive \cgBerserker\c- (%k)'s Extreme Overkill."
  Speed 0
  Damage (0)
  radius 1
  height 1
  scale 5.0
  reactiontime 64
  States {
   Spawn:
    ECL4 H 2
   SpawnL:
    ECL4 I 1 A_PlaySoundEx("misc/eclipsegravitywellpain", "SoundSlot7")
    ECL4 J 1 A_SpawnItemEx("ExtremeOverkillRockFX", frandom(-200.0, 200.0), frandom(-200.0, 200.0), 0, 0, 0, 24)
    ECL4 I 1 A_SpawnItemEx("ExtremeOverkillBloodDamager", 0, 0, 0)
    ECL4 J 1 A_Countdown
    loop
   Death:
    ECL4 KLM 2
    stop
  }
}
actor ExtremeOverkillRockFX : BasicGraphicEffectM {
  Translation "192:192=46:46", "198:198=190:190"
  Scale 4.0
  States {
   SpawnFrame:
    X_5C D 0
    X_5C D 1
    wait
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_Jump(256, 1, 2, 3)
    TNT1 AAAA 0 A_SpawnItemEx("ExtremeOverkillRockFX2", 0, 0, 0, frandom(-5.0, 5.0), frandom(-5.0, 5.0), 0, 0, 1)
    X_5C FGHI 1
    TNT1 A 1
    stop
  }
}
actor ExtremeOverkillRockFX2 : BasicGraphicEffectM {
  -NOGRAVITY
  Gravity 1.5
  States {
   SpawnFrame:
    X_5C A 1
    TNT1 A 1
    loop
   Death:
    TNT1 A 1
    stop
  }
}
actor ExtremeOverkillBloodDamager : MagicCardDamager {
  +RIPPER
  +OLDRADIUSDMG
  Damagetype "BerserkerBlood"
  Obituary "%o couldn't survive \cgBerserker\c- (%k)'s Extreme Overkill."
  radius 180
  height 1000
  Damage (100)
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 3
    stop
  }
}
actor BerserkerDrainHeath : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("item/energyup", "Item")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 40)
    stop
  }
}

actor Berserker_W_NormalBar : NormalBar {Args 161, 218}
actor Berserker_W_SecondBar : SecondBar {Args 219, 174}
actor Berserker_W : BaseUnholyBossWep {
  Tag "$TAG_Boss088_W"
  Obituary "%o was torn limb from limb by \cgBerserker\c- (%k)."
  Inventory.Pickupmessage "\cgI will do anything for more power... even if it means selling my soul."
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyPower2500"
  States {
   Spawn:
    8H73 [ 1
    wait

   Deselect:
    8H73 A 0
    goto DeselectSwap
   select:
    8H73 A 0
    goto selectSwap

   Ready:
    8H73 A 0 A_GiveInventory("UnholyPowerLimit_F", 2500)
    8H73 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, BERSERKER_DYE)
    //8H73 A 0 A_GiveInventory("BerserkerDiehardItem",1)
    8H73 A 0 A_GunFlash("Flash_Diehard")
    //8H73 A 0 A_SpawnItemEx("BerserkerRageGiver_H")
    8H73 A 0 A_GiveInventory("UnholyBossAmmo200", 50)
    goto ReadyX
   ReadyX:
    8H73 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200-100*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyX2")
    8H73 A 3 A_WeaponReady(8)
    8H73 A 0 A_GiveInventory("UnholyBossAmmo200", 5)
    loop
   ReadyX2:
    8H73 A 3 A_WeaponReady
    8H73 A 0 A_GiveInventory("UnholyBossAmmo200", 5)
    Goto ReadyX

   Flash_Diehard:
    TNT1 A 1 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.35, 1)
    Goto Flash_Diehard
    TNT1 A 0 A_PlaySound("weapon/mirrorabsorb")
    // TNT1 A 0 A_GiveInventory("BerserkerDiehardItem", 1)
    TNT1 A 0 A_GunFlash("Flash_Healing")
    stop

   Flash_Healing:
    TNT1 A 1 A_JumpIfInventory("KamikazeEyeFlag", 1, 1)
    Goto Flash_Healing
    TNT1 A 3 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 10)
    TNT1 A 0 A_TakeInventory("KamikazeEyeFlag", 2)
    loop

   Fire:
    8H73 A 0 A_JumpIfInventory("UnholyPower2500", 2500, "IAmAwakening")
    8H73 A 0 A_GiveInventory("NoJumpCancel")
    8H73 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
    8H73 A 0 A_GiveInventory("HandyFlag", 1)
    8H73 A 0 A_Refire(1)
    8H73 A 0 A_Recoil(-20)
    8H73 A 0 A_PlaySoundEx("Leba/BerserkerMain", "Body")
    8H73 A 0 A_PlaySoundEx("weapon/superarmuse", "Weapon")
    8H73 A 2 ThrustThingZ(0, 64, 0, 0)
    8H73 A 1 Offset(3, 27)
    8H73 A 1 Offset(7, 23)
    8H73 A 1 Offset(18, 11)
    8H73 A 1 Offset(32, -1)
    8H73 B 1 Offset(14, -24)
    Goto Fallcheck

   Fallcheck:
    8H73 B 0 ThrustThingZ(0, 1, 1, 1)
    8H73 B 0 A_SpawnItemEx("DixieLeapCrush", 0, 0, -10, 0, 0, -10)
    8H73 B 0 A_JumpIf(momz<=0, "FallX")
    8H73 B 1 Offset(37, -52)
    loop
   FallX:
    8H73 A 0 ThrustThingZ(0, 2, 1, 1)
    8H73 A 0 A_SpawnItemEx("DixieLeapCrush", 0, 0, -10, 0, 0, -10)
    8H73 A 0 A_JumpIf(z-floorz==0, "REKTPOOKEN")
    8H73 A 0 A_JumpIfInventory("HandyFlag", 999, "REKTPOOKEN")
    8H73 A 0 A_GiveInventory("HandyFlag", 1)
    8H73 B 1 Offset(37, -52) //(62,-76)
    goto Fall
   Fall:
    8H73 A 0 ThrustThingZ(0, 2, 1, 1)
    8H73 A 0 A_SpawnItemEx("DixieLeapCrush", 0, 0, -10, 0, 0, -10)
    8H73 A 0 A_JumpIf(z-floorz==0, "REKTPOOKEN")
    8H73 A 0 A_JumpIfInventory("HandyFlag", 999, "REKTPOOKEN")
    8H73 A 0 A_GiveInventory("HandyFlag", 1)
    8H73 B 1 Offset(37, -52) //(62,-76)
    loop
   REKTPOOKEN:
    8H73 B 1 Offset(16, -40)
    8H73 A 1 Offset(3, -2)
    8H73 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    8H73 A 0 A_TakeInventory("NoJumpCancel")
    8H73 A 0 A_TakeInventory("HandyFlag")
    8H73 A 0 A_Stop
    8H73 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE", "SoundSlot5") //A_PlaySoundEx("misc/quake","Weapon")
    8H73 A 0 Radius_Quake(1, 35, 0, 50, 0)
    8H73 A 0 A_SpawnItemEx("MountainousWheelWaveSpawner", 32, 0, 0, 0, 0, 0, 0)
    8H73 A 0//20 //A_GiveInventory("SelfStoppedUnfreeze",1)
    8H73 A 1 Offset(-55, 15)
    8H73 A 1 Offset(-113, 28)
    8H73 C 1 Offset(-103, 8)
    8H73 C 1 Offset(-158, 29)
    8H73 C 1 Offset(-182, 47)
    8H73 C 1 Offset(-186, 58)
    TNT1 A 24
    Goto FireEnd

   IAmAwakening:
    8H73 A 0 A_PlaySoundEx("weapon/pchargelong", "Weapon")
    8H73 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    8H73 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    8H73 A 1 Offset(3, 27)
    8H73 A 1 Offset(7, 23)
    8H73 A 1 Offset(18, 11)
    8H73 A 1 Offset(32, -1)
    8H73 B 1 Offset(14, -24)
    Goto IAmAngry
   IAmAngry:
    8H73 B 1 Offset(37, -52) A_JumpIfInventory("BerserkerRageFlag", 0, "ExtremeOverkill")
    8H73 B 1 Offset(39, -54) A_GiveInventory("BerserkerRageFlag", 1)
    loop
   ExtremeOverkill:
    8H73 A 0 A_GiveInventory("BerserkerRageConsumer_P")//A_TakeInventory("UnholyPower2500",2500)
    8H73 B 1 Offset(16, -40)
    8H73 A 1 Offset(3, -2)
    8H73 A 0 A_PlaySoundEx("Leba/BerserkerRage", "Body")
    8H73 A 0 A_SpawnItemEx("ExtremeOverkill_StompWave_H", 0, 0, 32, 0, 0, 0, 0, 32)
    8H73 A 0 A_SpawnItemEx("ExtremeOverkillBlood", 256, 0, 0, 0, 0, 0)
    8H73 A 1 Offset(-55, 15)
    8H73 A 1 Offset(-113, 28)
    8H73 C 1 Offset(-103, 8)
    8H73 C 1 Offset(-158, 29)
    8H73 C 1 Offset(-182, 47)
    8H73 C 36 Offset(-186, 58)
    Goto AwakeningEnd
   AwakeningEnd:
    8H73 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H73 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    8H73 A 0 A_TakeInventory("BerserkerRageFlag", 1)
    TNT1 A 1
    Goto FireEnd

   Altfire: //Bloodlust
    8H73 A 0 A_GiveInventory("VivifyDelay8")
    8H73 A 0 A_ReFire(1)
    8H73 A 0 A_TakeInventory("UnholyBossAmmo200", 100, 1)
    8H73 A 0 A_TakeInventory("UnholyBossAmmo200", 100)
    8H73 A 1 Offset(14, 15)
    8H73 B 1 Offset(14, -24)
    // 8H73 B 16 Offset(14,-24)
    // 8H73 B 0 A_SpawnItemEx("CallOfBerserker",64,0,32,0,0,0,0,8)
    8H73 B 1 Offset(37, -52)
    8H73 B 1 Offset(65, -74)
    8H73 H 1 A_WeaponReady(14)
    8H73 G 1
    8H73 F 12
    goto BloodLust
    8H73 F 6
   BloodLust:
    8H73 F 1
    8H73 F 1 A_SpawnItemEx("Berserker_SuplexGrabber", 0, 0, 56, momx, momy, momz, 0, 40, 0)
    8H73 F 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    8H73 FGH 1
    goto FireEnd
   Suplex:
    8H73 F 1 A_WeaponReady(14)
    8H73 F 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, true)
    // 8H57 H 0 A_GiveInventory("CaughtYouFlag",1)
    // 8H57 H 0 A_GiveInventory("LadderEnable",1)
    // 8H57 H 0 A_TakeInventory("NoJumpCancel",9)
    // 8H73 H 0 A_GiveInventory("Berserker_SuplexStart_P",1)
    8H73 E 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000, 100, 2700000)
    8H73 H 0 A_SpawnItemEx("ZangiefGrabFX", 56, 0, 28, 0, 0, 0, 0, 1)
    8H73 H 0 A_SpawnItemEx("ZangiefGrabFX2", 56, 0, 28, 0, 0, 0, 0, 1)
   SuplexPause:
    8H73 E 0 A_GiveInventory("Berserker_BasicArmor_P", 1)
    8H73 E 0 A_JumpIfInventory("PlayerPropertyRage", 1, "SuplexPauseRage")
    8H73 EEEEEEEEEEEEEEEEEEEE 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000, 100, 2700000) //20
    Goto DischargeIt
   SuplexPauseRage:
    8H73 EEEE 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000, 100, 2700000) //20
    Goto DischargeIt
    //8H73 E 0 A_Jumpif(CallACS("uh_ZangiefGrab",300,angle*256/360,100)==0,"DischargeIt")
   DischargeIt:
    TNT1 A 0 A_TakeInventory("BasicArmor")
    TNT1 A 0 A_GiveInventory("Berserker_Suplex_Toss_P")
    8H73 E 1
    8H73 H 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID")+999, cos(-pitch)*80, sin(-pitch)*60+40)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 A_SetPitch(0)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    TNT1 A 0 A_TakeInventory("NoJumpCancel")
    TNT1 A 0 A_GiveInventory("Berserker_GrabReset_P")
    8H73 EFGH 1
    TNT1 A 1 A_GiveInventory("ZangiefResetFlags_P")
    goto FireEnd

   FireEnd:
    8H73 A 1 Offset(-32, 124)
    8H73 A 1 Offset(-22, 96)
    8H73 A 1 Offset(-16, 72)
    8H73 A 1 Offset(-10, 58)
    8H73 A 1 Offset(-6, 49)
    8H73 A 1 Offset(-2, 39)
    Goto ReadyX
  }
}

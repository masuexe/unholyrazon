actor BlueDestron_W : PurpleDestron_W {
  Tag "$TAG_BlueDestron_W"
  Obituary "%o can't defeat \chBlue Destron\c- (%k)."
  Inventory.Pickupmessage "\cnYou think the boss is bad? You guessed right. It's intended"
  // weapon.ammotype "UnholyBossAmmo200"
  States {
   Spawn:
    8L03 [ 1
    wait

   Deselect:
    TNT1 A 0
    goto DeselectSwap
   Select:
    TNT1 A 0
    goto SelectSwap

   Ready:
    TNT1 A 3
    TNT1 A 0 ACS_NamedExecuteAlways("rz_BlueDestronShotCooldown")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    TNT1 A 0 A_GunFlash
   ReadyX:
    TNT1 A 1 A_WeaponReady(WRF_NOFIRE)
    TNT1 A 0 A_PlaySoundEx("TransformersNES/DestronShot", "weapon")
    TNT1 A 0 A_FireCustomMissile("DestronShotBlue", 0, 0, 0)
    TNT1 A 65
    loop

   Flash:
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONBLUE_DYE0)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONBLUE_DYE1)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONBLUE_DYE0)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONBLUE_DYE2)
    loop
  }
}

actor BlueDestronAbility_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("BlueDestronCollision")
    stop
  }
}

actor BlueDestronCollision : BasicExplosion {
  Damagetype "BlueDestron"
  Obituary "%o was smashed by \chBlue Destron \c-(%k)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(100, 64, 0, 0)
    stop
  }
}
actor DestronShotBlue : BasicProjectile {
  Translation "192:192=217:217", "198:198=42:42"
  damagetype "BlueDestron"
  Obituary "%o was shredded by \chBlue Destron\c- (%k)'s bullet."
  Damage (1200)
  radius 8
  height 8
  Speed 16
  scale 2.5
  Args 0
  States {
   Spawn:
    8P70 AB 5
    loop
   Death:
    TNT1 A 1
    stop
  }
}

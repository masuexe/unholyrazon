actor CuttyCut : BossBase
{
player.scoreIcon "UB026MUG"
player.soundclass "CuttyCut"
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
Player.MaxHealth 2150
Health 2150
player.jumpz 12
player.morphweapon "CuttyCut_W"
States
{
Spawn:
CUTM A 0
CUTM A 0 A_JumpIfInventory("CutterReturned",1,"Spawn_Idle")
CUTM A 0 A_JumpIfInventory("CuttyCutNoCutterF",1,"Spawn_Cutless2")
Spawn_Cutless:
CUTM R 1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
CUTM QQQQQQQQQQ 1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
Spawn_Cutless2:
CUTM QQQQVVVV 1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
CUTM Q -1 A_JumpIfInventory("CuttyCutNoCutterF",1,"Spawn")
Spawn_Idle:
CUTM B 1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
CUTM  1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
Spawn_Idle2:
CUTM AAAAJJJJ 1 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
loop

SpawnDead:
CUTM W 1 A_JumpIfInventory("CuttyCutPainFlag2",1,"SpawnDown")
loop
SpawnDown:
CUTM X 1
CUTM XX 1 A_JumpIfInventory("CuttyCutPainFlag2",1,"SpawnDown")
goto Spawn_Idle

See:
CUTM B 0 A_JumpIfInventory("CuttyCutNoCutterF",1,"See_Cutless")
CUTM BCDE 5
Goto Spawn_Idle
See_Cutless:
CUTM RSTS 5
Goto Spawn_Cutless

Melee:
CUTM GF 6
goto Spawn_Idle

Missile:
CUTM F 4
CUTM FF 1 A_JumpIfInventory("CuttyCutNoCutterF",1,"Missile2")
CUTM G 6
goto Spawn_Idle
Missile2:
CUTM G 7
goto Spawn_Cutless

ClassPain:
CUTM H 0 A_JumpIfInventory("CuttyCutNoCutterF",1,"ClassPain_Cutless")
CUTM H 0 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
goto MegamanPain
ClassPain_Cutless:
CUTM U 0 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
goto MegamanPain

MegamanPain:
CUTM "#####" 2 A_SpawnItemEx("PainFX_UH",-5,0,3,0,0,0)
CUTM "#" 0 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
CUTM "#####" 2 A_SpawnItemEx("PainFX_UH",-5,0,3,0,0,0)
CUTM "#" 0 A_JumpIfInventory("CuttyCutPainFlag",1,"SpawnDead")
Goto Spawn

ClassDeath:
CUTM H 0 A_JumpIfInventory("CuttyCutNoCutterF",1,"ClassDeathC")
Goto MegamanDeath
ClassDeathC:
CUTM U 0
Goto MegamanDeath
}
}

// Phase 3 acceptance: custom id=-1 DefineBoss morph target
actor UHPhase3TestBoss : CuttyCut {}


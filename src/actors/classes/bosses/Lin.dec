actor Lin : BossBase {
	player.soundclass "Lin"
	player.forwardmove 1.15, 1.15
	player.sidemove 1.15, 1.15
	player.jumpz 14
	Player.MaxHealth 2000
	Player.WeaponSlot 1, "Lin_W1"
	Player.WeaponSlot 2, "Lin_W2"
	Health 2000
	States {
	 Spawn:
	  PLY1 A 0
	  PLY1 B 1
	  PLY1 A 1
	  Goto Spawn+2
	 See:
	  PLY1 BCDE 5
	  Goto Spawn
	 Missile:
	  PLY1 F 5
	  PLY1 G 4
	  Goto Spawn+2
	 ClassPain:
	  PLY1 H 0
	  Goto MegamanPain
	 ClassDeath:
	  PLY1 H 0
		goto MegamanDeath
	}
}

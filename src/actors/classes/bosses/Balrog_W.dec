actor BalrogMissile_Fired_1 : BasicProjectile
{
translation "192:192=4:4", "198:198=219:219"
damagetype "Balrog"
Obituary "%o was blown up by \ciBalrog\c- (%k)'s missiles." //Filler
+DONTSPLASH
+THRUGHOST
+DOOMBOUNCE
Renderstyle "Translucent"
Alpha 0.35
Damage(100)
Radius 12
Height 12
speed 70
scale 4.0
States
{
Spawn:
8P59 A 0
8P59 AAAAAAA 1 A_Recoil(3)
8P59 A 0 A_Stop
8P59 A 0 A_FadeIn(0.4)
8P59 AAA 2 A_GiveToTarget("UH_TargetMarker")
8P59 A 0 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 32)
8P59 A 2 A_GiveToTarget("UH_TargetMarker")
//8P59 A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
8P59 A 0 A_SpawnItemEX("BalrogMissile_Fired_FX",0,0,0,0,0,0,0,0)
8P59 A 0 A_CustomMissile("BalrogMissile_Fired_2",0,0,0, 2, -pitch)
stop
Death:
TNT1 A 1 A_SpawnItemEX("Balrog_Missile_BOOM",0,0,0,0,0,0,0,1)
stop
}
}


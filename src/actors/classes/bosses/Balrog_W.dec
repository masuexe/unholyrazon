actor Balrog_Cooldown : Inventory
{
inventory.amount 1
inventory.maxamount 200
}

actor Balrog_Suplextime : Inventory
{
inventory.amount 1
inventory.maxamount 50
}

actor Balrog_BasicArmor_P : BasicArmorPickup
{
Armor.Savepercent 75
Armor.Saveamount 5000
}

actor Balrog_MadDash : UOnce {inventory.amount 1 inventory.maxamount 4}

actor Balrog_Animate : UOnce {}

actor Balrog_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    8H59 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    8H59 A 0 A_GiveInventory("UnholyBossAmmo100", 4)
    stop
  }
}
actor Balrog_Ready4_P : Balrog_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(4)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(4 + 16)
    goto Ammo
  }
}

actor BalrogReadyHold_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_WeaponReady
TNT1 A 0 A_TakeInventory("Balrog_Suplextime", 1)
stop
}
}

actor BalrogReadyHoldX_P : CustomInventory

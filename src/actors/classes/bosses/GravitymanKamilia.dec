actor GravitymanKamilia : BossBase {
  Player.ScoreIcon "UB119MUG"
  player.soundclass "GravitymanKamilia"
  player.maxhealth 1000
  health 1000
  player.jumpz 15
  player.forwardmove 0.8, 0.8
  player.sidemove 0.78, 0.78
  Player.Morphweapon "GravitymanKamilia_W"
  States {
   Spawn:
    GRAM A 0
    GRAM A 0 A_JumpIfInventory("CeilingFlag", 1, "SpawnCeiling")
    GRAM B 1
    GRAM A -1 A_JumpIfInventory("CeilingFlag", 1, "SpawnCeiling")
   SpawnCeiling:
    GRAM N 1
    GRAM M 1 A_JumpIfInventory("GroundFlag", 1, "Spawn")
    wait
   Melee:
    GRAM A 0 A_JumpIfInventory("VivifyDelay5", 1, "MeleeWait_Ceiling")
    GRAM A 0 A_JumpIfInventory("CeilingFlag", 1, "MeleeWait")
    goto Spawn
   MeleeWait:
    GRAM IJK 3
    GRAM K 2
    GRAM J 3
    GRAM LLLLLLLLLLLLLLLLLLLL 1 A_JumpIf(z-ceilingz==0-56, "Spawn")
    GRAM X 1 A_JumpIf(z-ceilingz==0-56, "Spawn")
    wait
   MeleeWait_Ceiling:
    GRAM UVW 3
    GRAM W 2
    GRAM V 3
    GRAM XXXXXXXXXXXXXXXXXXXX 1 A_JumpIf(momz==0, "Spawn")
    GRAM L 1 A_JumpIf(momz==0, "Spawn")
    wait
   See:
    GRAM B 0 A_JumpIfInventory("CeilingFlag", 1, "See_Ceiling")
    GRAM BBBBBCCCCCDDDDDEEEEE 1 A_JumpIfInventory("CeilingFlag", 1, "See_Ceiling")
    Goto Spawn
   See_Ceiling:
    GRAM NNNNNOOOOOPPPPPQQQQQ 1
    Goto Spawn
   Missile:
    GRAM F 0 A_JumpIfInventory("VivifyDelay8", 1, "MissileGHold")
    GRAM F 0 A_JumpIfInventory("CeilingFlag", 1, "Missile_Ceiling")
    GRAM F 5
    GRAM G 4
    GRAM F 5
    GRAM G 4
    goto Spawn
   Missile_Ceiling:
    GRAM R 5
    GRAM S 4
    GRAM R 5
    GRAM S 4
    goto Spawn
   MissileGHold:
    GRAM I 0 A_JumpIfInventory("CeilingFlag", 1, "MissileGHold_Ceiling")
    GRAM IJK 3
    GRAM K 2
    GRAM J 3
    goto Spawn
   MissileGHold_Ceiling:
    GRAM UVW 3
    GRAM W 2
    GRAM V 3
    goto Spawn

   ClassPain:
    GRAM H 0 A_JumpIfInventory("CeilingFlag", 1, "ClassPain_Ceiling")
    GRAM H 0
    goto MegamanPain
   ClassPain_Ceiling:
    GRAM T 0
    goto MegamanPain

   ClassDeath:
    GRAM H 0 A_JumpIfInventory("CeilingFlag", 1, "ClassDeathCeiling")
    GRAM H 0 A_GiveInventory("GravitymanFullReset_P")
    goto MegamanDeath
   ClassDeathCeiling:
    GRAM T 0 A_GiveInventory("GravitymanFullReset_P")
    goto MegamanDeath

   MegamanRise:
    GRAM H 0 A_JumpIfInventory("CeilingFlag", 1, 1)
    Goto Super::MegamanRise
    GRAM T 1 A_SetGravity(0.0)
   RiseMyMegaman:
    GRAM T 1 ThrustThingZ(0, -10, 0, 1)
    GRAM T 0 A_JumpIf(z-floorz<=(height+1), "RiseMyMegamanEnd")
    GRAM T 0 A_GiveInventory("BlowDeathTimer", 1)
    GRAM T 0 A_JumpIfInventory("BlowDeathTimer", 25, "RiseMyMegamanEnd")
    loop
  }
}

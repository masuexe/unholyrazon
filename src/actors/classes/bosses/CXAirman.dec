actor CXAirMan : BossBase {
  Player.ScoreIcon "UB101MUG"
  Player.SoundClass "CXAirMan"
  Player.DamageScreenColor "white"
  Player.ForwardMove 0.98, 0.98
  Player.SideMove 0.98, 0.98
  Player.JumpZ 16
  Player.MaxHealth 3050
  Health 3050
  Player.MorphWeapon "CXAirMan_W"
  States {
   Spawn:
    8B01 A 0
    8B01 B 1
    8B01 A 1
    goto Spawn+2
   See:
    8B01 BCDE 3  // 5
    goto Spawn
   Missile:
    8B01 F 5
    8B01 G 4
    goto Spawn+2
   ClassPain:
    8B01 H 0
    goto MegamanPain
   ClassDeath:
    8B01 H 0
    goto MegamanDeath
  }
}

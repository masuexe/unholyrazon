actor TricksterGiovanni_W_ScriptBar : ScriptBar {}

actor TricksterGiovanni_W : BaseUnholyBossWep
{
Tag "TAG_Boss010_W"
Obituary "%o was fooled by \cmTrickster \cjGiovanni\c- (%k)."
Inventory.Pickupmessage "\cjYou ain't nothing, pedestrian!"
weapon.ammotype "TricksterGiovanniAmmo"
weapon.ammotype2 "UnholyBossAmmo250" //UnholyPower1500
States
{
Spawn:
8H10 [ 1
wait

Deselect:
8H10 A 0
goto DeselectSwap
Select:
8H10 A 0
goto SelectSwap

Ready:
8H10 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H10 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, TRICKSTERGIOVANNI_DYE)
goto ReadyX
ReadyX: //	"Altered so it's a long wait for 4 consecutive shots.
8H10 A 0 A_TakeInventory("Giovanni_Is_Walking_Here")
8H10 A 0 A_TakeInventory("Fogettabou_et") //Welcome to the Trist spaghetti coding.
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 AA 2 A_GiveInventory("Giovanni_Ready_P",1) //
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 AA 2 A_GiveInventory("Giovanni_Ready_P",1) //
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 AA 2 A_GiveInventory("Giovanni_Ready_P",1) //
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 AA 2 A_GiveInventory("Giovanni_Ready_P",1) //
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 AA 2 A_GiveInventory("Giovanni_Ready_P",1) //20
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX2")
8H10 A 0 A_GiveInventory("TricksterGiovanniAmmo", 1) //2 ammo
loop //	The reason for this change is because, well... I wanted a tommy gun." - Trist
ReadyX2:
//
8H10 A 0 A_TakeInventory("Giovanni_Is_Walking_Here")
8H10 AA 2 A_GiveInventory("Giovanni_ReadyX2_P")
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,2)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"ReadyX")
8H10 AA 2 A_GiveInventory("Giovanni_ReadyX2_P")
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,2)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"ReadyX")
8H10 AA 2 A_GiveInventory("Giovanni_ReadyX2_P")
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,2)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"ReadyX")
8H10 AA 2 A_GiveInventory("Giovanni_ReadyX2_P")
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,2)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"ReadyX")
8H10 AA 2 A_GiveInventory("Giovanni_ReadyX2_P")
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,2)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"ReadyX")
//
8H10 A 0 A_GiveInventory("TricksterGiovanniAmmo", 1)
loop
CanYouWaitReady: //Hey, if you run out of M1, you might as well not M2, right? Maybe??
8H10 A 0 A_TakeInventory("Giovanni_Is_Walking_Here")
8H10 A 0 A_JumpIfInventory("TricksterGiovanniAmmo", 1, "ReadyX")
8H10 AAAAAAAAAAAAAAAAAAAAAA 2 A_GiveInventory("Giovanni_Ready_P2",1) //44
8H10 A 0 A_GiveInventory("TricksterGiovanniAmmo", 1)
loop //Trust me, I'm sure we can do something else to make this BETTER?
InvisiblyReady:
8H10 A 2 A_GiveInventory("Giovanni_Ready_P_Invisible",1)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",1,"InvisiblyReady")
goto AltfireR

Fire:
8H10 A 0 A_JumpIfInventory("Fogettabou_et",1,"SurpriseShot")
8H10 A 0 A_JumpIfInventory("UnholyPower1500",1500,"Assassination")
8H10 A 0 A_TakeInventory("TricksterGiovanniAmmo", 1, TIF_NOTAKEINFINITE)
8H10 A 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
8H10 A 0 A_FireCustomMissile("GiovanniCracker_Shot",0,1,-8,0)
8H10 BCB 2
8H10 A 6 //40
8H10 A 0 A_JumpIfInventory("TricksterGiovanniAmmo", 1, "ReadyX")
Goto CanYouWaitReady
SurpriseShot:
8H10 A 0 A_TakeInventory("Fogettabou_et") //
8H10 A 0 A_TakeInventory("Giovanni_Is_Walking_Here") //
8H10 A 0 A_TakeInventory("UnholyBossAmmo250",250)
8H10 A 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
8H10 A 0 A_FireCustomMissile("SinisterStopperBoss",0,1,-8,0)
8H10 A 0 A_JumpIfInventory("UH_00_AlphaPower", 1, "RevealMe")
8H10 CB 4
8H10 A 10
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo100",0,"CanYouWaitReady")
Goto ReadyX
RevealMe:
8H10 C 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
8H10 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
8H10 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
8H10 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
8H10 C 2 Offset(-24, 44)
8H10 C 2 Offset(-48, 64)
8H10 C 2 Offset(-44, 64)
8H10 B 2 Offset(-36, 56)
8H10 B 2 Offset(-16, 40)
8H10 B 2 Offset(-8, 32)
8H10 A 6 A_WeaponReady(14)
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo100",0,"CanYouWaitReady")
Goto ReadyX
Assassination:
8H10 C 0 A_GiveInventory("UnholyPowerDazzle_F")
8H10 A 0 A_TakeInventory("UnholyPower1500", 1500)
8H10 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H10 B 2
8H10 C 2 A_GunFlash("Flash.RageCharge") //46 tics
8H10 CCC 2 A_GiveInventory("Giovanni_Rage_P1")
8H10 CC 2
8H10 CC 2 A_GiveInventory("Giovanni_Rage_P2")
8H10 CC 2
8H10 CC 2 A_GiveInventory("Giovanni_Rage_P3")
8H10 CC 2
8H10 CC 2 A_GiveInventory("Giovanni_Rage_P1")
8H10 CC 2
8H10 CC 2 A_GiveInventory("Giovanni_Rage_P2")
8H10 CC 2
8H10 CC 2 A_GiveInventory("Giovanni_Rage_P3")
8H10 C 2
8H10 C 2 A_GunFlash("NoFlash")
8H10 C 0 ACS_NamedExecuteWithResult("core_chargecolor", TRICKSTERGIOVANNI_DYE)
8H10 C 0 A_TakeInventory("UnholyPowerDazzle_F")
8H10 C 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H10 C 0 A_FireCustomMissile("GiovanniCracker_Shot_Rage",0,0,-8,0)
8H10 C 2
8H10 BA 2 ACS_NamedExecuteWithResult("core_chargecolor", TRICKSTERGIOVANNI_DYE)
8H10 A 56
Goto ReadyX
/*SelectAnAttack:
8H10 A 0 A_TakeInventory("UnholyBossAmmo100",100)
8H10 A 0 A_Jump(256,"StopRightThere","PeusAltLikeFire","HeyScotty","JesusManAttack")
8H10 BCB 2
8H10 A 8
Goto ReadyX*/

Flash.RageCharge:
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", TRICKSTERGIOVANNI_DYE2)
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", TRICKSTERGIOVANNI_DYE3)
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", TRICKSTERGIOVANNI_DYE)
loop

/*Altfire:
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"Deadly")
8H10 A 1
goto ReadyX
Deadly:
8H10 B 0 A_TakeInventory("UnholyBossAmmo100",200)
8H10 A 0 A_GiveInventory("GiovanniInvisPower",1)
8H10 A 0 A_PlaySoundEx("classes/hide","Weapon")
8H10 A 1 A_SpawnItemEx("TricksterTrickCorpse",0,0,0,0,0,0,0,1)
8H10 A 10
Goto ReadyX*/
//
Altfire:
8H10 A 0 A_JumpIfInventory("Fogettabou_et",1,"AltfireR")
//8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",0,"AltfireX") //Yeah, yeah. I get it. This also means full ammo.
8H10 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"AltfireX")
8H10 C 1
goto ReadyX
AltfireX:
8H10 A 0 A_GiveInventory("Fogettabou_et",1)
8H10 A 0 A_TakeInventory("Giovanni_Is_Walking_Here",1)
8H10 A 0 A_GiveInventory("TricksterGiovanniAmmo", 4) //Wow it's just like Reaper from OW!
8H10 A 0 A_PlaySoundEx("classes/hide","Weapon")
8H10 A 0 A_SpawnItemEx("UH_AlphaFadeOut_H")
8H10 AABBBCCCCC 1
8H10 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
8H10 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
8H10 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
8H10 C 1 //A_GiveInventory("Fogettabou_et",1)
goto InvisiblyReady
AltfireR:
8H10 A 0 A_TakeInventory("UnholyBossAmmo250",50) //penalty
8H10 C 0 A_TakeInventory("Fogettabou_et")
//8H10 C 0 A_TakeInventory("Giovanni_Is_Walking_Here")
8H10 C 0 A_PlaySoundEx("classes/reveal","Weapon")
8H10 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
8H10 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
8H10 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
8H10 C 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
8H10 CCCCBBBAAA 1
8H10 A 1 //A_TakeInventory("Fogettabou_et")
goto ReadyX

Reload:
TNT1 A 0 A_JumpIfInventory("Giovanni_Is_Walking_Here",1,"ReadyX")
TNT1 A 0 A_JumpIfInventory("Fogettabou_et",1,"Bamboozle_Buddy")
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"Gio_Leap")
goto ReadyX
Gio_Leap:
TNT1 A 0 A_JumpIfInventory("Giovanni_Is_Walking_Here",1,"ReadyX")
TNT1 A 0 A_JumpIfInventory("Fogettabou_et",1,"ReadyX")
TNT1 A 0 A_TakeInventory("UnholyBossAmmo250",200) //125 is too generous.
TNT1 A 0 A_GiveInventory("Giovanni_BigFunny_P")
goto ReadyX
//
Bamboozle_Buddy: //Once per invis state. As a result, lessens your cloak time.
TNT1 A 0 A_JumpIfInventory("Giovanni_Is_Walking_Here",1,"ReadyX")
TNT1 A 0 A_GiveInventory("Giovanni_Is_Walking_Here")
TNT1 A 0 A_TakeInventory("UnholyBossAmmo250",100) //150
TNT1 A 0 A_GiveInventory("Giovanni_Bamboozle_P")
goto ReadyX

//

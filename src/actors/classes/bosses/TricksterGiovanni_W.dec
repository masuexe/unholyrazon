actor TricksterGiovanniAmmo : Ammo {
  Inventory.Amount 1
  Inventory.MaxAmount 4
  +INVENTORY.IGNORESKILL
}

actor Fogettabou_et : Inventory {}
actor Giovanni_Is_Walking_Here : Inventory {}

actor Giovanni_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("Giovanni_Is_Walking_Here", 1, "PickupNormal")
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
TNT1 A 0 A_Jump(256, "PickupNormal")
goto PickupNormal
PickupNormal:
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
PickupReload:
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
goto Ammo
Ammo:
TNT1 A 0 A_GiveInventory("UnholyBossAmmo250",2) //1
stop
}
}

actor Giovanni_ReadyX2_P : Giovanni_Ready_P
{
States
{
PickupNormal:
TNT1 A 0 A_WeaponReady
stop
PickupReload:
TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
stop
}
}

actor Giovanni_Ready_P2 : Giovanni_Ready_P
{
States
{
PickupNormal:
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
goto Ammo
PickupReload:
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
goto Ammo
}
}

actor Giovanni_Rage_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","SoundSlot6") //weapon
TNT1 A 0 A_SpawnItemEx("TrickAntiGround1",0,0,32,15,random(-16,-16),random(0,0))
stop
}
}
actor Giovanni_Rage_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","SoundSlot6") //weapon
TNT1 A 0 A_SpawnItemEx("TrickAntiGround1",0,0,32,15,random(-32,32),random(-8,16))
stop
}
}
actor Giovanni_Rage_P3 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","SoundSlot6") //weapon
TNT1 A 0 A_SpawnItemEx("TrickAntiGround1",0,0,32,15,random(-64,64),random(-16,32))
stop
}
}


actor Giovanni_Ready_P_Invisible : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady
goto Ammo
Ammo:
TNT1 A 0 A_TakeInventory("UnholyBossAmmo250",2)
stop
}
}

actor Giovanni_Bamboozle_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("Giovanni_FakeOut",0,0,0,0)
stop
}
}


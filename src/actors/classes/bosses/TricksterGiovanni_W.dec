actor Giovanni_BigFunny_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ThrustThingZ(0,60,0,0)
TNT1 A 0 A_Recoil(-35)
TNT1 A 0 A_playSoundEx("weapon/mirrordeflect2","Weapon")
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,60)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,-60)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,120)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,-120)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,180)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,-180)
TNT1 A 0 A_SpawnItemEx("JesuCrayCracker",0,0,0,5,0,0,0)
stop
}
}


actor GiovanniCracker_Shot_Rage : BasicProjectile
{
Translation "192:192=4:4", "198:198=5:5"
damagetype "Giovanni"
Obituary "%o was fooled by \cmTrickster \cjGiovanni\c- (%k)."
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
damage (0)
Radius 10
Height 10
scale 2.5
speed 70
States
{
Spawn:
X_KC ABCD 3
loop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_Explode(450,128,0)
TNT1 AAAAAAAA 0 A_SpawnItemEx("GiovanniCracker_Shot",0,0,8,random(-20,20),random(-20,20),random(0,20),0,1,0)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}


actor GiovanniCracker_Shot : BasicProjectile
{
Translation "192:192=4:4", "198:198=5:5"
damagetype "Giovanni"
Obituary "%o was fooled by \cmTrickster \cjGiovanni\c- (%k)."
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
damage (0) //Reduced damage due to faster RoF
Radius 10
Height 10
speed 70
scale 2.5
States
{
Spawn:
X_KC ABCD 3
loop
Death: //BasicBoom4FX_ColorX_Dull
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_Explode(125,128,0) //250
TNT1 AAAAAAAAA 0 A_SpawnItemEx("GiovanniCracker_Shot_Expand",0,0,8,random(-20,20),random(-20,20),random(0,20),0,1,0)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}


actor GiovanniCracker_Shot_Expand : BasicProjectile
{
Translation "192:192=4:4", "198:198=5:5"
damagetype "Giovanni"
Obituary "%o was fooled by \cmTrickster \cjGiovanni\c- (%k)."
-NOGRAVITY
+BOUNCEONFLOORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+BOUNCEAUTOOFF

stop
}
}

actor TCChampShot : BasicProjectile
{
translation "204:204=232:232","195:195=220:220","202:202=216:216","192:192=208:208","198:198=216:216"
+SKYEXPLODE
Damagetype "TheCommandoChamp"
Obituary "%o was shown true patriotism by \cqThe CommandoChamp\c- (%k)'s Hommando Missile."
Damage (150)
Radius 10
Height 10
Speed 10//40
Scale 2.5
States
{
Spawn:
CMDH G 0
CMDH G 10
CMDH G 0 A_PlaySoundEx("weapon/commandoswitch","Weapon")//weapon/commandoexplosion
CMDH G 0 A_SpawnItemEX("CommandoHommandoMissileFX",0,0,0,0,0,0,0,1)
CMDH G 0 A_ScaleVelocity(3.0)
Whomstev: //Traveling sound?
CMDH G 2 A_SpawnItemEX("TCChampSmokeFX",random(-8,8),0,random(-8,8),0,0,0,0,1)
CMDH G 0 A_ScaleVelocity(1.2)
loop
DeathF:
TNT1 A 0 A_SpawnItemEx("TCChampWaveTrail",20,0,16,10,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("TCChampWaveTrail",20,0,16,10,0,0,90,1)
TNT1 A 0 A_SpawnItemEx("TCChampWaveTrail",20,0,16,10,0,0,180,1)
TNT1 A 0 A_SpawnItemEx("TCChampWaveTrail",20,0,16,10,0,0,270,1)
TNT1 AAAAAAAA 0 A_SpawnItemEx("TCChampWaveBit",0,0,8,random(-32,32),random(-32,32),random(0,16),random(0,359),1)
//TNT1 A 0 A_PlaySoundEX("wep_L/commandowave","Body") //
goto DeathEnd
DeathC:
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",random(-10,10),0,-13,8,0,0,0,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",random(-10,10),0,-13,8,0,0,90,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",random(-10,10),0,-13,8,0,0,180,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",random(-10,10),0,-13,8,0,0,270,1)
TNT1 AAAAAAAA 0 A_SpawnItemEx("TCChampWaveBit",0,0,-8,random(-32,32),random(-32,32),random(-16,0),random(0,359),1)
goto DeathEnd
Death:
TNT1 A 0 A_CheckFloor("DeathF")
TNT1 A 0 A_JumpIf(z-ceilingz==0-10,"DeathC")
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",0,0,random(-10,10),10,0,0,210,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",0,0,random(-10,10),10,0,0,190,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",0,0,random(-10,10),10,0,0,170,1)
TNT1 A 0 A_SpawnItemEX("TCChampWaveBit",0,0,random(-10,10),10,0,0,150,1)
TNT1 AAAAAAAA 0 A_SpawnItemEx("TCChampWaveBit",0,0,random(-10,10),random(4,20),0,0,random(150,210),1)
goto DeathEnd
XDeath:
TNT1 AAAAAAAA 0 A_SpawnItemEx("TCChampWaveBit",0,0,8,random(-16,16),random(-16,16),random(-8,8),random(0,359),1)
goto DeathEnd
DeathEnd:
TNT1 A 0 Radius_Quake(3,10,0,16,0)//6
TNT1 A 0 A_PlaySound("weapon/drillexplode",1,0.75)//weapon/napalm
TNT1 A 0 A_Explode(150,96,0,0,32)
X_8B ABCDEF 2
stop
}
}


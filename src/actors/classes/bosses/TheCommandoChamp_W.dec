actor TCChampMine : BasicProjectile
{
DamageType "TheCommandoChamp"
Obituary "%o failed \cqThe CommandoChamp\c- (%k)'s bootcamp lesson."
-NOGRAVITY
ReactionTime 1
Damage (125)
Radius 16
Height 16
speed 40
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ThrustThingZ(0,8,0,1)
CMDH NOPQRSTUNOPQ 2
goto Spawn+2
Death:
TNT1 A 0 A_PlaySound("weapon/crashland",2,0.65)
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_JumpIf(z-floorz<15,"Floor")
TNT1 A 0 A_JumpIf(z-ceilingz==0-16,"Ceiling")
TNT1 A 1 A_SpawnItemEX("TCChampMine_WallH",0,0,0,0,0,0,180,1)
stop
Floor:
TNT1 A 1 A_SpawnItemEx("TCChampMine_Floor",0,0,0,0,0,0,0,1)
stop
Ceiling:
TNT1 A 1 A_SpawnItemEx("TCChampMine_Ceil",0,0,0,0,0,0,0,1)
stop
XDeath:
X_2E A 0
X_2E A 0 A_SetGravity(0.0)
X_2E A 0 A_PlaySound("weapon/crashexplode",2,0.65)
X_2E KKK 0 A_SpawnItemEx("TCChampWaveBit_Mine",0,0,8,random(-32,32),random(-32,32),random(0,16),random(0,359),1)
X_2E K 3 A_Explode(50,64,0)
X_2E LM 3 A_SpawnItemEx("TCChampPlethoraBoom_Mine",random(-96,96),random(-96,96),random(-64,64),0,0,0,0,1)
X_2E KKK 0 A_SpawnItemEx("TCChampWaveBit_Mine",0,0,8,random(-32,32),random(-32,32),random(0,16),random(0,359),1)
X_2E N 3 A_Explode(50,64,0)
X_2E OP 3 A_SpawnItemEx("TCChampPlethoraBoom_Mine",random(-96,96),random(-96,96),random(-64,64),0,0,0,0,1)
X_2E KKK 0 A_SpawnItemEx("TCChampWaveBit_Mine",0,0,8,random(-32,32),random(-32,32),random(0,16),random(0,359),1)
X_2E Q 3 A_Explode(50,64,0)
X_2E RS 3 A_SpawnItemEx("TCChampPlethoraBoom_Mine",random(-96,96),random(-96,96),random(-64,64),0,0,0,0,1)
X_2E KKK 0 A_SpawnItemEx("TCChampWaveBit_Mine",0,0,8,random(-32,32),random(-32,32),random(0,16),random(0,359),1)
X_2E T 3 A_Explode(50,64,0)
X_2E VW 3
stop
}
}

actor TCChampMine_Bounce : TCChampMine
{
//Obituary "filler."
+BOUNCEONWALLS
Wallbouncefactor 0.75
States
{

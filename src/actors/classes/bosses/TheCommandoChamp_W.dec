actor TheCommandoChamp_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor TheCommandoChamp_Ready8_P : TheCommandoChamp_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor CommandoReadyHold_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_WeaponReady
TNT1 A 0 A_TakeInventory("CommandoInterrogation",1)
stop
}
}

actor CommandoInterrogationRemover_P : CustomInventory
{
states
{

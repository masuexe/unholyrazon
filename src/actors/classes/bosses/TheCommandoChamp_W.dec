CMDH NOPQRSTU 2 A_SpawnItemEx("TCChampPlethoraBoom_Mine",random(-64,64),random(-64,64),random(-64,64),0,0,0,0,1)
CMDH N 1 A_CountDown
wait
Death:
TNT1 A 0
goto XDeath
}
}


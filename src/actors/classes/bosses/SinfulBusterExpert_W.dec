actor SinfulBE_Rage_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
TNT1 AAAAAA 0 A_FireCustomMissile("PlasmaThingyAttack",random(-10,10),0,8,0,0,random(-5,5))
stop
}
}

actor SBEMagicBombSpawner : BasicProjectile
{
Translation "192:192=3:3", "198:198=6:6"
Damagetype "SinfulBuster"
Obituary "%o was no match for \cmSinful \cuBusterExpert\c- (%k)."
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
Damage (50)
radius 6
height 7
Speed 80
scale 2.5
States
{
Spawn:
TMFX AB 2
loop
Death:
TNT1 A 1
X_8G A 0 A_Stop
X_8G A 0 A_PlaySoundEx("weapon/flashbomb", "Weapon")
X_8G AABB 1 A_Explode(50,80,0)
X_8G CCEE 1 A_Explode(45,80,0)
X_8G FFEE 1 A_Explode(40,80,0)
X_8G FFEE 1 A_Explode(35,80,0)
X_8G FFEE 1 A_Explode(30,80,0)
X_8G FFEE 1 A_Explode(25,80,0)
X_8G FFEE 1 A_Explode(20,80,0)
X_8G FFEE 1 A_Explode(15,80,0)
X_8G FECBA 1
stop
}
}

actor SBEHawkNeedleBullet : BasicFastProjectile
{
Translation "192:192=3:3", "198:198=6:6"
Damagetype "SinfulBuster"
Obituary "%o was no match for \cmSinful \cuBusterExpert\c- (%k)."
+RIPPER
Damage (95)
radius 5
height 5
Speed 120
scale 2.5
States
{
Spawn:
X_3A A 1
loop

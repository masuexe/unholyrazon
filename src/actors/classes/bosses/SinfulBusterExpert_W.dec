}
}

// Envy
actor SinfulBusterExpert_W6 : SinfulBusterExpert_W
{
weapon.ammotype "SBEKachidongaAmmo"
States
{
ReadyX:
8I02 A 2 A_GiveInventory("SinfulBusterExpert_Ready_P6")
loop


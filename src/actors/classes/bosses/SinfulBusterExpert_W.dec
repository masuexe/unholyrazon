// IDEA: when survivors defeat all 7 sin bosses, strong boss will appear
//       what strong boss? HellBot or SBE?

actor SinfulBusterExpert_W1_NormalBar : NormalBar {args 203, 206}
actor SinfulBusterExpert_W2_NormalBar : NormalBar {args 63, 79}
actor SinfulBusterExpert_W3_NormalBar : NormalBar {args 198, 244}
actor SinfulBusterExpert_W4_NormalBar : NormalBar {args 132, 135}
actor SinfulBusterExpert_W5_NormalBar : NormalBar {args 180, 5}
actor SinfulBusterExpert_W6_NormalBar : NormalBar {args 178, 5}
actor SinfulBusterExpert_W7_NormalBar : NormalBar {args 218, 5}
actor SinfulBusterExpert_W8_NormalBar : NormalBar {args 4, 84}

actor SinfulBusterExpert_W1_SecondBar : SecondBar {args 3, 6}
actor SinfulBusterExpert_W2_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W3_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W4_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W5_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W6_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W7_SecondBar : SinfulBusterExpert_W1_SecondBar {}
actor SinfulBusterExpert_W8_SecondBar : SinfulBusterExpert_W1_SecondBar {}

// Base
actor SinfulBusterExpert_W : BaseUnholyBossWep
{
Tag "$TAG_Boss102_W"
Obituary "%o was no match for \cmSinful \cuBuster Expert\c- (%k)."
weapon.ammotype "SBEHawkeyeAmmo"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8I02 [ 1
wait

Deselect:
8I02 A 0
goto DeselectSwap
Select:
8I02 A 0
goto SelectSwap

Ready:
8I02 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SINFULBUSTEREXPERT_DYE, CLRF_GRAVITYWARN)
8I02 A 0 A_JumpIf(true, "ReadyX")
ReadyX:
8I02 A 2 A_GiveInventory("SinfulBusterExpert_Ready_P1")
loop

Fire:
8I02 A 20
Goto ReadyX

AltFire:
//AttackCombo9:
8I02 A 0 A_JumpIfInventory("UnholyPower1500",1500,"PlasmaPls")
Goto ReadyX
PlasmaPls:
8I02 A 0 A_TakeInventory("UnholyPower1500",1500)
8I02 A 0 A_GiveInventory("SinfulBE_Rage_P")
8I02 BCBCBCBCBC 3 A_GiveInventory("SinfulBE_Rage_P")
8I02 A 20
Goto ReadyX
}
}

// Lust
actor SinfulBusterExpert_W1 : SinfulBusterExpert_W
{
weapon.ammotype "SBESueAmmo"
States
{
Fire:
8I02 A 0 A_JumpIfInventory("SBESueAmmo",145,"Attack2Go")
Goto ReadyX
Attack2Go:
8I02 A 0 A_TakeInventory("SBESueAmmo",145)
8I02 A 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire","Weapon")
8I02 B 0 A_FireCustomMissile("SBEMagicBombSpawner",0,0,8,0)
8I02 B 0 A_FireCustomMissile("SBEMagicBombSpawner",random(-7,-5),0,8,0)
8I02 B 0 A_FireCustomMissile("SBEMagicBombSpawner",random(5,7),0,8,0)
8I02 B 0 A_FireCustomMissile("SBEMagicBombSpawner",random(-14,-10),0,8,0)
8I02 B 0 A_FireCustomMissile("SBEMagicBombSpawner",random(10,14),0,8,0)
8I02 BC 2
8I02 A 38
Goto ReadyX
}
}

// Gluttony
actor SinfulBusterExpert_W2 : SinfulBusterExpert_W
{
weapon.ammotype "SBEWaylonAmmo"
States
{
ReadyX:
8I02 A 2 A_GiveInventory("SinfulBusterExpert_Ready_P2")
loop

Fire:
8I02 A 0 A_JumpIfInventory("SBEWaylonAmmo",175,"Attack5Go")
Goto ReadyX
Attack5Go:
8I02 A 0 A_TakeInventory("SBEWaylonAmmo",175)
8I02 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
8I02 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
8I02 B 0 A_Stop
8I02 A 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8I02 B 0 A_FireCustomMissile("SBEGaleSpawner",0,0,8,0)
8I02 C 0 ThrustThingZ(0,20,0,0)
8I02 BCB 2
8I02 A 0 A_Recoil(-95)
8I02 AAAAA 3 A_FireCustomMissile("SBEArmorPiercer",random(-10,10),0,8,0,0,random(-5,5))
8I02 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
8I02 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
8I02 A 20
Goto ReadyX
}
}


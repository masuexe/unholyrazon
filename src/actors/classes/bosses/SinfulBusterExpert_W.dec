8I02 A 0 A_JumpIfInventory("SBEKachidongaAmmo",250,"Attack7Go")
Goto ReadyX
Attack7Go:
8I02 A 0 A_TakeInventory("SBEKachidongaAmmo",250)
8I02 B 0 A_GiveInventory("SBEAimThingy",50)
8I02 A 5
Goto NiceAndSteady
NiceAndSteady:
8I02 B 0 A_FireCustomMissile("SBELaserCrosshair",0,0,8,0)
8I02 A 1 A_WeaponReady(WRF_NOFIRE)
8I02 A 0 A_TakeInventory("SBEAimThingy",1)
8I02 A 0 A_JumpIfInventory("SBEAimThingy",1,"NiceAndSteady")
Goto TargetAquired
TargetAquired:
8I02 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
8I02 A 0 A_Stop
8I02 B 0 A_PlaySoundEx("weapon/lshot","Weapon")
8I02 B 0 A_FireCustomMissile("SBELaserThingShot",0,0,8,0)
8I02 A 0 ThrustThingZ(0,35,0,0)
8I02 A 0 A_Recoil(35)
8I02 BCB 5
8I02 A 20
8I02 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
Goto ReadyX
}
}


actor SBEHawkeyeAmmo : Ammo {inventory.amount 1 inventory.maxamount 105 +INVENTORY.IGNORESKILL}
actor SBESueAmmo : Ammo {inventory.amount 1 inventory.maxamount 145 +INVENTORY.IGNORESKILL}
actor SBEJavierAmmo : Ammo {inventory.amount 1 inventory.maxamount 85 +INVENTORY.IGNORESKILL}
actor SBESutokaAmmo : Ammo {inventory.amount 1 inventory.maxamount 175 +INVENTORY.IGNORESKILL}
actor SBEWaylonAmmo : Ammo {inventory.amount 1 inventory.maxamount 175 +INVENTORY.IGNORESKILL}
actor SBEJohnsonAmmo : Ammo {inventory.amount 1 inventory.maxamount 145 +INVENTORY.IGNORESKILL}
actor SBEKachidongaAmmo : Ammo {inventory.amount 1 inventory.maxamount 250 +INVENTORY.IGNORESKILL}
actor SBEHellBotAmmo :  Ammo {inventory.amount 1 inventory.maxamount 250 +INVENTORY.IGNORESKILL}

actor SinfulMode : Ammo
{
inventory.amount 1
inventory.maxamount 8
+INVENTORY.IGNORESKILL
}

actor SBEAimThingy : Inventory
{
inventory.amount 1
inventory.maxamount 50
}


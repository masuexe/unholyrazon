8I02 A 5 A_PlaySoundEx("Pokemon/AeroBlast1","Weapon")
8I02 A 5 //ThrustThingZ(0,60,0,0)
8I02 A 5 //ThrustThingZ(0,-60,0,0)
Attack1Loop:
8I02 A 0 A_TakeInventory("SBEHawkeyeAmmo",5)
8I02 A 0 A_Recoil(1)
8I02 A 0 ThrustThingZ(0,10,0,0)

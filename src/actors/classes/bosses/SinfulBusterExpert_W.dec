actor SinfulBusterExpert_Ready_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("SBESueAmmo", 0, "PrimaryFull")
    goto PickupAlt
   PickupAlt:
    TNT1 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "AltFull")
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    goto Ammo
   AltFull:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    goto Ammo
   PrimaryFull:
    TNT1 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "AllFull")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
   AllFull:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("SBESueAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEWaylonAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBESutokaAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEJohnsonAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEHawkeyeAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEKachidongaAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEJavierAmmo", 2)
    TNT1 A 0 A_GiveInventory("SBEHellBotAmmo", 2)
    stop
  }
}
actor SinfulBusterExpert_Ready_P2 : SinfulBusterExpert_Ready_P1 {

actor ShadowBoss_QRBlade : BasicProjectile {
  translation "192:192=210:210", "198:198=4:4"
  damagetype "ShadowBossBladeQR"
  Obituary "\chShadowman\c- killed %o."
  +RIPPER
  +DONTSPLASH
  +HEXENBOUNCE
  +NOTARGETSWITCH
  +SKYEXPLODE
  +CANBOUNCEWATER
  reactiontime 120  // 40
  damage (0)
  Radius 16  // 10 //14
  Height 16  // 10 //14
  speed 74  // 40 //70
  States {
   Spawn:  // KKKLLL
    6P17 C 0
    6P17 CDEFCDEF 1 A_SpawnItemEx("ShadowBoss_QRDamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    6P17 C 0 A_ScaleVelocity(0.0)  // A_Stop
   TheStoppingPoint:
    6P17 CDEF 1 A_SpawnItemEx("ShadowBoss_QRDamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    6P17 C 0 A_GiveInventory("Cutterflag", 1)
    6P17 C 0 A_JumpIfInventory("Cutterflag", 14, "TheReturningPoint")  // 6 //12
    Loop
   TheReturningPoint:
    6P17 C 0 A_SpawnItemEx("ShadowBoss_QRBladeReturn", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Death:
    6P17 C 0 A_GiveToTarget("KnightFlag")
    6P17 C 0 A_TakeFromTarget("KnightDouble", 1)
    stop
  }
}


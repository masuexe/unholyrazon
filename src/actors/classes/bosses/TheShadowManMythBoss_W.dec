    TNT1 A 2 A_Countdown
    loop
  }
}

// repurposed Item alt
actor ShadowBoss_FinalSliceSlicer : BasicExplosion {
  damagetype "ShadowBoss_FinalSliceW"
  Obituary "\chShadowman\c- killed %o."
  ReactionTime 10  // 10
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
   SpawnL:
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 24)
    TNT1 A 1 A_Explode(50, 48, 0, 0, 49)
    stop
  }
}


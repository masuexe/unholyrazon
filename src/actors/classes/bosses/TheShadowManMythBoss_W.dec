actor ShadowBoss_BladePlatform {
  Damagetype "ShadowBossPlatform"
  Obituary "\chShadowman\c- killed %o."
  translation "192:192=210:210", "198:198=4:4"
  +RIPPER  /// /////////////////////////////////////////////////////////////////////
  +FORCEXYBILLBOARD  // Y
  +NOGRAVITY
  +SHOOTABLE
  +THRUSPECIES
  +THRUGHOST
  +CANPASS
  +NOBLOCKMONST
  +DONTBLAST
  +SOLID
  +DONTREFLECT
  +MISSILE
  +NODAMAGE
  +NOTAUTOAIMED
  species "MovingPlatform"
  +THRUSPECIES
  +INVULNERABLE
  var int user_playerRiding[64];
  mass 99999999
  // ReactionTime 50
  var int user_C;
  maxstepheight 0
  height 4  // 14 //Too high.
  radius 24  // 24 //14
  scale 2.5
  States {
   Spawn:
    6P17 C 0
    // 6P17 C 0 A_RearrangePointers(0,0,2)
    6P17 C 0 A_Stop
    6P17 C 0  // A_ChangeFlag(RIPPER,1)
    // 6P17 C 0 A_Cleartarget
   Waiting:
    6P17 E 1 A_SetUserVar("user_C", user_C+1)
    6P17 C 0 A_JumpIf(user_C==200, "Death")  // 125
    6P17 C 0 A_JumpIfCloser(24, "MoveStart")  // 8 //16
    Loop
    // POINTERS:
    // TNT1 A 0 A_RearrangePointers(8,0,0)
   MoveStart:  // Explode 32 radius
    6P17 C 0  // A_GiveInventory("WeaponCharge",100)
    6P17 C 0 ACS_NamedExecuteAlways("core_stickyLifts", 0, STICKYMODE_GUTSLIFT)
    // 6P17 C 0 A_PlaySoundEx("weapon/superboost", "weapon")
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 E 2 A_ChangeVelocity(6, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 F 2 A_ChangeVelocity(18, 0, 0, 3)
    6P17 C 0 A_JumpIfCloser(86, "FlyA")
    Goto AbortMission
   FlyA:
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 C 1 A_ChangeVelocity(30, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 C 1 A_GiveInventory("WeaponCharge", 1)
    6P17 C 0 A_JumpIfInventory("WeaponCharge", 100, "AbortMission")
    6P17 C 0 A_JumpIfCloser(86, "FlyB")
    Goto AbortMission
   FlyB:
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 D 1 A_ChangeVelocity(30, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 D 1 A_GiveInventory("WeaponCharge", 1)
    6P17 C 0 A_JumpIfInventory("WeaponCharge", 100, "AbortMission")
    6P17 C 0 A_JumpIfCloser(86, "FlyC")
    Goto AbortMission
   FlyC:
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 E 1 A_ChangeVelocity(30, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 E 1 A_GiveInventory("WeaponCharge", 1)
    6P17 C 0 A_JumpIfInventory("WeaponCharge", 100, "AbortMission")
    6P17 C 0 A_JumpIfCloser(86, "FlyD")
    Goto AbortMission
   FlyD:
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 F 1 A_ChangeVelocity(30, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    6P17 F 1 A_GiveInventory("WeaponCharge", 1)
    6P17 C 0 A_JumpIfInventory("WeaponCharge", 100, "AbortMission")
    6P17 C 0 A_JumpIfCloser(86, "FlyA")
    Goto AbortMission
   AbortMission:
    6P17 E 1 A_ChangeVelocity(26, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 E 1 A_ChangeVelocity(20, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 F 1 A_ChangeVelocity(16, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 F 1 A_ChangeVelocity(14, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 1 A_ChangeVelocity(13, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 1 A_ChangeVelocity(12, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 D 1 A_ChangeVelocity(11, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 D 1 A_ChangeVelocity(10, 0, 0, 3)
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 A_GiveInventory("CutterFlag", 50)
    6P17 C 0 A_ChangeFlag("NOGRAVITY", 0)
   AbortAbort1:
    6P17 E 1
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 A_TakeInventory("CutterFlag", 1)
    6P18 C 0 A_JumpIfInventory("CutterFlag", 1, "AbortAbort2")
    Goto Death
   AbortAbort2:
    6P17 F 1
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 A_TakeInventory("CutterFlag", 1)
    6P18 C 0 A_JumpIfInventory("CutterFlag", 1, "AbortAbort3")
    Goto Death
   AbortAbort3:
    6P17 C 1
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 A_TakeInventory("CutterFlag", 1)
    6P18 C 0 A_JumpIfInventory("CutterFlag", 1, "AbortAbort4")
    Goto Death
   AbortAbort4:
    6P17 D 1
    6P17 C 0 A_Explode(random(40, 50), 56, 0, 0, 56)  /// //////////////////////
    6P17 C 0 A_TakeInventory("CutterFlag", 1)
    6P18 C 0 A_JumpIfInventory("CutterFlag", 1, "AbortAbort1")
    Goto Death
   Bruh:  // This should drop and explode.
    6P17 C 0 A_ChangeFlag("NOGRAVITY", 0)
   BruhMoment:
    6P17 E 1 A_JumpIf(z-floorz==0, "Death")
    Loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_TakeInventory("CutterFlag", 1)
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 A_Stop
    TNT1 A 0 A_TakeInventory("CutterFlag", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    TNT1 A 0 A_ChangeFlag("NoInteraction", 1)
    TNT1 A 0 A_ChangeFlag("NoClip", 1)
    TNT1 A 0 A_Stop
    6P17 E 2
    6P17 E 0 A_SpawnItemEx("ShadowBoss_Platform_Boom")
    TNT1 A 10
    stop
  }
}

actor ShadowBoss_Platform_Boom: BasicExplosion {
  Damagetype "ShadowBossPlatform"
  Obituary "\chShadowman\c- killed %o."
  translation "192:192=210:210", "198:198=4:4"
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, -60)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, 120)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, -120)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 0, 50, 0, 0, 0)
    TNT1 A 0 A_ChangeFlag(NOGRAVITY, 1)
    TNT1 A 0 A_Explode(random(95, 105), 164, 0, 0, 32)
    X_8B AABBCCDDEEFF 1 A_SpawnItemEx("ShadowBoss_Platform_Boom_2", random(-120, 120), random(-120, 120), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}

actor ShadowBoss_Platform_Boom_2 : ShadowBoss_Platform_Boom {
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(random(25, 35), 80, 0, 0, 16)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}


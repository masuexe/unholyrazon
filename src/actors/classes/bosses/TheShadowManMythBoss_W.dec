actor TheShadowManMythBoss_W_ScriptBar : ScriptBar {}
actor TheShadowManMythBoss_W : BaseUnholyBossWep  // YouCannotGraspTheTrueFormOfShadowManWeapon
{  // I think the player's name should be hidden since this is Shadowman.
  Obituary "$OB_BOSS305A"
  Inventory.Pickupmessage "\ccYou dare to take 'em on?"
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo150"
  States {
   Spawn:
    8K05 [ 1
    wait

   Deselect:
    SHAH A 0 A_Lower
    goto DeselectSwap
   Select:
    SHAH A 0 A_Raise
    goto SelectSwap

   Ready:
    SHAH A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SHADOWMAN_DYE)
    SHAH A 6
    SHAH A 0 A_GiveInventory("WallJumpLimit", 4)
    SHAS A 0 A_GunFlash
    goto ReadyX

   ReadyX:
    SHAH A 0 A_GiveInventory("ShadowBossResetPickup")
    SHAH A 0 A_TakeInventory("ShadowBoss_GrappleTime", 1)
    SHAH A 2 A_GiveInventory("Shadowman_Ready0_P")
    goto ReadyX+2

   Reload:
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_ItemTimer", 1, "SpawnySpawn")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "Give")
    goto ReadyX
   Give:
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo150", 1)
    TNT1 A 0 A_GiveInventory("ShadowBoss_ItemTimer", 100)
    goto ReadyX
   SpawnySpawn:
    TNT1 A 0 A_Jumpif(floorz<z, "Under")
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_BladePlatform", 56, 0, 28, 1)
    goto ReadyX
   Under:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_BladePlatform", 0, 0, 0, 1)
    goto ReadyX

    /*ReadyCloak:
    SHAH A 1 A_WeaponReady
    SHAH A 0 A_TakeInventory("ShadowBoss_Cloak",1)
    SHAH A 0 A_JumpIfInventory("ShadowBoss_Cloak",1,"ReadyCloak")
    SHAH A 0 A_GiveInventory("ShadowBoss_StopInvis_P",1)
    goto ReadyX*/

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_Cloak", 1, "CloakFlash")
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 2
    Loop
   CloakFlash:  // NoAltAmmo
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)  // Failsafe
    TNT1 A 2
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_Cloak", 1, "CloakFlash")
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_FunnyTrail", 1, "CloakFlash")  //
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_GrappleTime", 1, "CloakFlash")  //
    TNT1 A 0 A_JumpIfInventory("SuplexID", 1, "CloakFlash")  //
    Goto Flash

   Fire:  // ShadowBoss_ShadowBlade //TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer")
    SHAH B 0 A_JumpIfInventory("ShadowBoss_GrappleTime", 1, "BreakYourBokuChecker")  // SuplexID//BreakYourBoku
    SHAH B 0 A_JumpIfInventory("ShadowBoss_ItemTimer", 1, "FireShadowBladeQR")  //
    SHAH A 2  // 1
    SHAH A 0 A_Refire("NoCharge")
    goto FireKunais
   NoCharge:
    SHAH A 1 A_GiveInventory("ShadowBoss_Charge", 1)  // 2
    SHAH A 0 A_JumpIfInventory("ShadowBoss_Charge", 15, "KeepHolding")
    SHAH A 0 A_Refire("NoCharge")
    goto FireKunais

   KeepHolding:
    SHAH A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)  // A_GiveInventory("GraniteOverCharger",2)
    SHAH A 0 A_Refire("KeepHolding")
    goto FireShadowBlade

   FireKunais:
    // SHAH D 0 A_PlaySound("weapon/Shad_Kunai",1,0.75) //What if we brought this here...?
    SHAH B 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    SHAH B 0 A_TakeInventory("ShadowBoss_Charge", 1)
    SHAH B 0 A_GiveInventory("ShadowBoss_StopInvis_P")
    // SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai",0,1,8,0)
    // SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai",10,0,8,0)
    // SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai",-10,0,8,0)
    SHAH D 0 A_Refire(1)
    SHAH B 1
    SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai", 0, 1, 8, 0)
    SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai", 10, 0, 8, 0)
    SHAH B 0 A_FireCustomMissile("ShadowBoss_Kunai", -10, 0, 8, 0)
    SHAH B 1 OffSet(-70, 72)
    SHAH B 1 OffSet(-121, 112)
    SHAH C 1 OffSet(1, 33)
    SHAH C 1 OffSet(-21, 56)
    SHAH C 1 OffSet(-35, 84)
    TNT1 A 2
    SHAH A 1 OffSet(0, 69)
    SHAH A 1 OffSet(0, 48)
    SHAH A 2 A_WeaponReady(14)
    goto ReadyX
   FireKunaisLess:
    // SHAH D 0 A_PlaySound("weapon/Shad_Kunai",1,0.75)
    SHAH B 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    SHAH B 0 A_TakeInventory("ShadowBoss_Charge", 1)  //
    SHAH B 0 A_GiveInventory("ShadowBoss_StopInvis_P")  //
    // SHAH D 0 A_Refire(1) //
    SHAH B 1
    SHAH B 0 A_GiveInventory("ShadowBoss_Kunai_Alt")  // A_FireCustomMissile("ShadowBoss_Kunai",0,1,8,0)
    SHAH B 1 OffSet(-70, 72)
    SHAH B 1 OffSet(-121, 112)
    SHAH C 1 OffSet(1, 33)
    SHAH C 1 OffSet(-21, 56)
    SHAH C 1 OffSet(-35, 84)
    TNT1 A 2
    SHAH A 2 OffSet(0, 69)
    SHAH A 2 OffSet(0, 48) A_Refire("FireKunaisLess")  //
    SHAH A 2 A_WeaponReady(14)
    goto ReadyX

   FireShadowBlade:
    SHAH A 0 A_PlaySoundEx("weapon/shadow", "Weapon")  //
    SHAH B 0 A_TakeInventory("ShadowBoss_Charge", 1)
    SHAH B 0 A_GiveInventory("ShadowBoss_StopInvis_P")
    /*
    SHAH A 0 A_TakeInventory("ShadowSlide",1)
    SHAH A 0 A_GiveInventory("ShadowmanFlashInvisOff_P",1)
    SHAH A 0 A_GiveInventory("ShadowmanMainfireBlade_P",1)
    */
    // SHAH A 0 A_FireCustomMissile("ShadowBoss_ShadowBlade",0,0,0,0)

    SHAH A 0 A_Refire(1)

    SHAH B 2
    SHAH B 2 OffSet(-70, 72) A_GiveInventory("ShadowBoss_ShadowBlade_Decider")  // A_FireCustomMissile("ShadowBoss_ShadowBlade",0,0,0,0) //Logic //A_GiveInventory("ShadowmanFlashInvisOff_P",1)
    SHAH B 2 OffSet(-121, 112)
    SHAH C 2 OffSet(1, 33)
    SHAH C 2 OffSet(-21, 56)
    SHAH C 2 OffSet(-35, 84)
    TNT1 A 4
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 2 A_WeaponReady(14)
    goto ReadyX

   FireShadowBladeQR:
    SHAH A 0 A_PlaySoundEx("weapon/shadow", "Weapon")  //
    SHAH B 0 A_TakeInventory("ShadowBoss_Charge", 1)
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)  //
    SHAH B 0 A_GiveInventory("ShadowBoss_StopInvis_P")
    /*
    SHAH A 0 A_TakeInventory("ShadowSlide",1)
    SHAH A 0 A_GiveInventory("ShadowmanFlashInvisOff_P",1)
    SHAH A 0 A_GiveInventory("ShadowmanMainfireBlade_P",1)
    */
    // SHAH A 0 A_FireCustomMissile("ShadowBoss_ShadowBlade",0,0,0,0)

    SHAH A 0 A_Refire(1)

    SHAH B 2
    SHAH B 0 OffSet(-70, 72) A_FireCustomMissile("ShadowBoss_QRBlade", -16, 0, 0, 0)  //
    SHAH B 0 OffSet(-70, 72) A_FireCustomMissile("ShadowBoss_QRBlade", 16, 0, 0, 0)  //
    SHAH B 2 OffSet(-70, 72) A_FireCustomMissile("ShadowBoss_QRBlade", 0, 0, 0, 0)  //
    SHAH B 2 OffSet(-121, 112)
    SHAH C 1 OffSet(1, 33)  // 2
    SHAH C 1 OffSet(-21, 56)  // 2
    SHAH C 1 OffSet(-35, 84)  // 2
    TNT1 A 2  // 4
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 2 A_WeaponReady(14)
    goto ReadyX

   Altfire:
    SHAH A 0 A_JumpIfInventory("ShadowBoss_GrappleTime", 1, "BokuAlmostBrokenChecker")
    SHAH A 0 A_JumpIfInventory("ShadowBoss_Charge", 1, "FireKunaisLess")  /// //
    SHAH A 0 A_JumpIfInventory("ShadowBoss_ItemTimer", 1, "BOLIVARELHEROE")
    SHAH A 0 A_JumpIfInventory("ShadowBoss_Cloak", 1, "AltfireSlide")
    SHAH A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Altfire2")
    goto FireKunaisLess  // Use the m1, numbnuts.
   AltfireSlide:
    SHAH G 0 A_GiveInventory("ShadowBoss_Slide_P")
    SHAH G 0 A_Refire(1)
    SHAH G 1
    SHAH G 1 A_GiveInventory("ShadowBoss_StopInvis_P")
   ShadowManGrabber:
    SHAH G 0 A_SpawnItemEx("ShadowBoss_SuplexThing", 0, 0, 56, momx, momy, momz, 0, 40, 0)
    SHAH G 1
    SHAH G 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    SHAH G 0  A_JumpIfInventory("ShadowBoss_FunnyTrail", 1, "ShadowManGrabber")
    // SHAH G 1 A_WeaponReady(14) //
   NoLuck:
    SHAH A 0 A_TakeInventory("UH_125_SpeedPower")
    SHAH A 0 A_TakeInventory("UH_225_SpeedPower")
    SHAH G 10 A_WeaponReady(14)  //
    goto ReadyX
   Altfire2:
    // 8L01 A 0 A_JumpIf(pitch>47 && pitch<=90 && z-floorz<=0,"PowerOfShadowSneak") //Down //IM SKEPTICAL - TRIST 2022
    SHAH A 1 A_TakeInventory("ShadowBoss_Cloak", 1)
    SHAH A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    SHAH A 0 A_SpawnItemEx("ShadowBossSmoke_Start", 0, 0, 28, 0, 0, 0, 0, 0)  // 1
    SHAH A 0 A_SpawnItemEx("ShadowBossSmoke_Helper", 0, 0, 28, 0, 0, 0, 0, 0)  // 1
    SHAH A 0 A_FireCustomMissile("ShadowBoss_Flashbang", 0, 0, 0, 0)
    SHAH A 9 A_GiveInventory("ShadowBoss_GoInvis_P")
    goto ReadyX

    // Bolivar, the hero.
    // The big shitpost movie.
    // There's a fucking STUPID SCENE WHERE THE DUDE JUST SLICES INTO PEOPLE
    // SO SLOOOOOOOOOOOOOWWWWW...........
    // It's incredibly funny, please understand this state's joke name.
   BOLIVARELHEROE:  // ShadowBoss_DancingBlade
    TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer", 1)  //
    TNT1 A 0 A_GiveInventory("ShadowBoss_StopInvis_P")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    // TENA E 0 A_GiveInventory("CutterFlag",12) //
    TENA E 0 A_Recoil(-50)  // 50
    TENA E 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    TENA E 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    TENA E 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    TENA E 0 A_FireCustomMissile("ShadowBoss_FinalSliceSlicer", 0, 0, 8, 0)
    TENA EEEEEEEEEEEE 1 A_ChangeVelocity(cos(pitch)*65, 0, -sin(pitch)*35, 3)  // 45 //30
    TENA E 1
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TENA E 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    TENA E 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    TENA E 0 A_ScaleVelocity(0.41)
    TENA FG 2
    TNT1 A 12 A_TakeInventory("WeaponCharge", 1)
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 2 A_WeaponReady(14)
    Goto ReadyX

    /*PowerOfShadowSneak:
    TNT1 A 0 A_ScaleVelocity(0.05) //
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    TNT1 A 0 A_SpawnItemEX("ShadowBoss_Fade_FX")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true) //
    TNT1 A 0 A_TakeInventory("UnSolid",1) //
    TNT1 A 0 A_ChangeFlag("NONSHOOTABLE",1) //
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON) //
    TNT1 A 0 A_ChangeFlag("PICKUP",0) //
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER",1) //
    TNT1 A 0 A_SetTranslucent(0.0,0) //
    TNT1 A 0 ThrustThingZ(0,40,1,0) //
    TNT1 A 0 A_TakeInventory("UH_225_SpeedPower") //
    TNT1 A 0 A_GiveInventory("UH_125_SpeedPowerGiver") //
    TNT1 A 0 A_GiveInventory("UH_DisableJumpPowerGiver") //
    TNT1 A 10 //
    TNT1 A 0 A_GiveInventory("ShadowBoss_ShadowSneak_Setup",1)
    TNT1 A 0 A_SpawnItemEX("ShadowBoss_SneakThunder")
    TNT1 A 2
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    goto ShadowSneakReady*/

    /*ShadowSneakReady:
    TNT1 A 0 A_TakeInventory("ShadowBoss_SneakTimer",1)
    TNT1 A 2 A_WeaponReady
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_SneakTimer",1,"ShadowSneakReady")
    Goto SneakNoMore*/

   SneakNoMore:
    TNT1 A 0 A_TakeInventory("ShadowBoss_SneakTimer", 1)
    TNT1 A 0 A_SetTranslucent(1.0, 0)
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER", 0)
    TNT1 A 0 A_ChangeFlag("PICKUP", 1)
    TNT1 A 0 A_TakeInventory("UH_125_SpeedPower")
    TNT1 A 0 A_TakeInventory("UH_225_SpeedPower")
    TNT1 A 0 A_TakeInventory("UH_DisableJumpPower")  // 16
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 A_TakeInventory("NoJumpCancel")
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 2 A_WeaponReady(14)
    Goto ReadyX

    /// ///////////////////////////
    /// ///////////////////////////
    /// ///////////////////////////


    //  ////////  //
    //  GRAPPLES  //
    //  ////////  //

   Suplex:
    // 6H51 I 0 A_TakeInventory("UnholyBossAmmo250")
    SHAH B 1 A_WeaponReady(14)
    SHAH B 0 A_TakeInventory("UH_125_SpeedPower")
    SHAH B 0 A_TakeInventory("UH_225_SpeedPower")
    SHAH B 0 A_TakeInventory("ShadowBoss_FunnyTrail")
    SHAH B 0 A_GiveInventory("ShadowBoss_GrappleTime", 100)

    SHAH B 0 A_PlaySoundEx("KirbyNES/FoeGrab", "Weapon")

    SHAH B 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)

    SHAH B 0 A_ScaleVelocity(0.75)
    SHAH B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    SHAH B 0 A_SpawnItemEx("ZangiefGrabFX", 56, 0, 28, 0, 0, 0, 0, 1)
    SHAH B 0 A_SpawnItemEx("ZangiefGrabFX2", 56, 0, 28, 0, 0, 0, 0, 1)
    Goto Wait25TurnsToMove
   Wait25TurnsToMove:
    SHAH BBBBBBBBBBBBBBBBBBBB 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    Goto ReadySteady+2
   ReadySteady:
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "Shittaba")  //
    SHAB B 0 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    SHAH B 1 A_GiveInventory("ShadowBossReadyHold_P")  // A_WeaponReady(WRF_NOSWITCH)
    // SHAH B 0 A_TakeInventory("ShadowBoss_GrappleTime",1)
    SHAH B 0 A_JumpIfInventory("ShadowBoss_GrappleTime", 1, "ReadySteady")
    Goto JustInCaseChecker  // BreakYourBokuChecker
   JustInCaseChecker:
    SHAH B 0 A_JumpIfInventory("SuplexID", 1, "BreakYourBokuChecker")
    Goto Shittaba

   BreakYourBokuChecker:
    SHAH B 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "Shittaba")  //
    SHAH B 0 A_JumpIfInventory("SuplexID", 1, "BreakYourBoku")
    Goto Shittaba
   BreakYourBoku:
    // SHAH B 0 A_GiveInventory("CommandoCooldown",200)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "Shittaba")  //
    SHAH B 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    // SHAH B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true) //You have no idea how annoying this shit can get.
    SHAH B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    SHAH B 0 A_TakeInventory("ShadowBoss_GrappleTime", 1)
    SHAH B 0 A_GiveInventory("NoJumpCancel")
    SHAH B 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
    // SHAH B 0 A_GiveInventory("HandyFlag",1)
    // SHAH B 0 A_TakeInventory("CaughtYouFlag")
    SHAH B 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1, 0)
    // SHAH B 0 SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab",338,CallACS("uh_ZangiefGrab",0,angle*256/360,100)==0,"PrimaryDieLand"))
    SHAH B 0 A_Recoil(-35)  // -20
    SHAH B 1 ThrustThingZ(0, 60, 0, 0)  //
   PrimaryDieLeap:
    SHAH B 0 ThrustThingZ(0, 1, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(momz<=0, "PrimaryDieCont")  // A_Jumpif(CallACS("uh_ZangiefGrab",338,CallACS("rz_CountInv_ZangiefAngle")+128,100)==0,"PrimaryDieLand")
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "Shittaba")
    SHAH B 1
    loop
   PrimaryDieCont:
    SHAH B 0 ThrustThingZ(0, 2, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "PrimaryDieLand")
    SHAH B 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360, 100)==0, "Shittaba")
    SHAH B 1
    SHAH B 0 ThrustThingZ(0, 2, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "PrimaryDieLand")
    SHAH B 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 270, angle*256/360, 100)==0, "Shittaba")
    SHAH B 1
    SHAH B 0 ThrustThingZ(0, 2, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "PrimaryDieLand")
    SHAH B 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360+128, 100)==0, "Shittaba")
    SHAH B 1
    SHAH B 0 ThrustThingZ(0, 2, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "PrimaryDieLand")
    SHAH B 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360+128, 100)==0, "Shittaba")
    SHAH B 1
    goto PrimaryDieFall
   PrimaryDieFall:  // Already going to slam, so....
    SHAH B 0 ThrustThingZ(0, 2, 1, 1)
    SHAH B 0 A_SpawnItemEx("ShadowBoss_Crusher", 0, 0, -10, 0, 0, -10)
    SHAH B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "PrimaryDieLand")
    SHAH B 0 A_JumpIfInventory("ShadowBoss_AirTimer", 105, "PrimaryDieLand")
    SHAH B 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    SHAH B 0 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360+128, 100)==0, "PrimaryDieLand")
    SHAH B 1
    loop
   PrimaryDieLand:
    SHAH C 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID")-1+1000)  // Disable invun on grabbed player
    //
    SHAH C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)  //
    SHAH C 0 A_SpawnItemEX("ShadowBoss_Pound_A", -5, 0, 32, 0, 0, 0, 0, 1, 0)
    SHAH C 0 A_PlaySoundEx("misc/quake", "Weapon")  //
    SHAH C 0 Radius_Quake(3, 35, 0, 50, 0)
    SHAH C 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1, 0)  //
    SHAH C 0 A_SetPitch(0)  //
    SHAH C 10
    //
   PrimaryOverToss:
    SHAH B 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360+128, 100)==0, "PrimaryEndToss")
    SHAH B 1 OffSet(-121, 112) A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360+128, 100)==0, "PrimaryEndToss")
    SHAH C 1 OffSet(1, 33) A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360+128, 100)==0, "PrimaryEndToss")
    SHAH C 1 OffSet(-21, 56) A_Jumpif(CallACS("uh_ZangiefGrab", 270, angle*256/360, 100)==0, "PrimaryEndToss")
    SHAH C 1 OffSet(-35, 84) A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360, 100)==0, "PrimaryEndToss")
    TNT1 A 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "PrimaryEndToss")
    //
   PrimaryEndToss:
    SHAH C 0 A_GiveInventory("ShadowBoss_SuplexPickup")  //
    SHAH C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    SHAH C 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    SHAH C 0 A_TakeInventory("NoJumpCancel")
    // SHAH C 0 A_TakeInventory("ShadowBoss_AirTimer") //
    SHAH C 0 A_ScaleVelocity(0.25)
    SHAH C 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    TNT1 A 1 A_Recoil(20)  /// /
    SHAH C 0 ThrustThingZ(0, 45, 0, 0)  /// /
    TNT1 A 2
    // 8H00 A 0 A_TakeInventory("MegaSmashFlag")
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 0 A_GiveInventory("ShadowBossResetPickup")
    SHAH A 2 A_WeaponReady(14)
    SHAH A 10 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    Goto ReadyX


    /// /////

   BokuAlmostBrokenChecker:
    SHAH B 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "Shittaba")  //
    SHAH B 0 A_JumpIfInventory("SuplexID", 1, "BokuAlmostBroken")
    Goto Shittaba
   BokuAlmostBroken:  //
    SHAH B 0 A_WeaponReady(14)  //
    SHAH B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    SHAH B 0 A_TakeInventory("ShadowBoss_GrappleTime", 1)
    SHAH B 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1, 0)
    SHAH B 1 offset(0, 12)A_Jumpif(CallACS("uh_ZangiefGrab", 325, angle*256/360, 80)==0, "Shittaba")
    SHAH B 1 offset(0, -12)A_Jumpif(CallACS("uh_ZangiefGrab", 320, angle*256/360, 90)==0, "Shittaba")
    TNT1 A 0 A_ChangeVelocity(30*cos(pitch), 0, 6*-sin(pitch), 3)
    TNT1 A 0 ThrustThingZ(0, 35, 0, 1)
   SecondaryDie:
    SHAH B 1 A_Jumpif(CallACS("uh_ZangiefGrab", 315, angle*256/360, 100)==0, "Shittaba")  // 110
    TNT1 A 0 ThrustThingZ(0, 3, 1, 1)  // 2
    SHAH A 0 A_JumpIfInventory("ShadowBoss_AirTimer", 105, "SecondaryDieSlammers")
    SHAH A 0 A_GiveInventory("ShadowBoss_AirTimer", 1)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "SecondaryDieSlammers")
    loop
   SecondaryDieSlammers:
    SHAH C 0 A_WeaponReady(14)
    SHAH C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 95)==0, "Shittaba")
    SHAH C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 345, angle*256/360, 90)==0, "Shittaba")
    SHAH C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 359, angle*256/360, 80)==0, "Shittaba")
    // SHAH C 2 A_FireCustomMissile("",0,0,0,0)
    goto SecondaryDieEnd
   SecondaryDieEnd:
    SHAH C 0 A_GiveInventory("ShadowBoss_SuplexPickup_Root")  //
    // SHAH C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    // SHAH C 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    // SHAH C 0 A_TakeInventory("NoJumpCancel")
    // SHAH C 0 A_TakeInventory("HandyFlag") //
    SHAH C 0 A_ScaleVelocity(0.45)  // 0.25
    // SHAH C 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    TNT1 A 1 A_Recoil(5)  /// /
    SHAH C 0 ThrustThingZ(0, 25, 0, 0)  /// /
    TNT1 A 4  // 2
    SHAH A 1 OffSet(-2, 69)
    SHAH A 1 OffSet(-1, 48)
    SHAH A 0 A_GiveInventory("ShadowBossResetPickup")  //
    SHAH A 1 A_WeaponReady(14)
    SHAH A 4  // ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    Goto ReadyX


    /// /////
    /// /////
    /// /////


   Shittaba:
    SHAH B 0 A_TakeInventory("ShadowBoss_FunnyTrail")
    SHAH B 0 A_TakeInventory("ShadowBoss_GrappleTime", 1)
    SHAH C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    SHAH C 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    SHAH C 0 A_TakeInventory("NoJumpCancel")
    // SHAH C 0 A_TakeInventory("ShadowBoss_AirTimer") //
    SHAH A 0 A_GiveInventory("ShadowBossResetPickup")
    SHAH C 2 OffSet(-35, 84)
    SHAH C 2 OffSet(-21, 56)
    SHAH C 2 OffSet(1, 33)
    SHAH B 2 OffSet(-121, 112)
    TNT1 A 4
    SHAH A 2 OffSet(-2, 69)
    SHAH A 2 OffSet(-1, 48)
    SHAH A 2 A_WeaponReady(14)
    SHAH A 10 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    Goto ReadyX
  }
}

actor Shadowman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_ItemTimer", 1, "PickupReload")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    stop
  }
}
actor Shadowman_Ready8_P : Shadowman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}


actor ShadowBoss_Cloak_Helper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 1 A_TakeFromTarget("ShadowBoss_Cloak", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("ShadowBoss_Cloak", 1, "Spawn")
    goto Death
   Death:
    TNT1 A 0 A_GiveToTarget("ShadowBoss_StopInvis_P", 1)
    TNT1 A 0
    stop
  }
}

actor ShadowBoss_StopInvis_P : CustomInventory {

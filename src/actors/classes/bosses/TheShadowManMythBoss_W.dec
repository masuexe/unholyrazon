actor ShadowBoss_ShadowStep : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("ShadowBoss_Flag_1", 1, "Dustbowl")
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "MiniShockwave")
    stop
   MiniShockwave:  // Cool sound effect here, fun stepping.
    TNT1 A 0  // A_PlaySoundEx("misc/quake","Weapon")
    TNT1 A 1 A_SpawnItemEx("ShadowBoss_Dust")
    stop
   Dustbowl:
    TNT1 A 0
    TNT1 A 1
    stop
  }
}


actor ShadowBossResetPickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SuplexID", 1)
    TNT1 A 0 A_TakeInventory("ZangiefAngle", 255)  //
    TNT1 A 0 A_TakeInventory("ZangiefHoldFlag", 1)  //
    TNT1 A 0 A_TakeInventory("BasicArmor")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfpushplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfHitStunplayer", 0, false)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)
    TNT1 A 0 A_TakeInventory("ShadowBoss_AirTimer", 1)
    TNT1 A 0 A_TakeInventory("ShadowBoss_GrappleTime", 1)  // Just incase.

    TNT1 A 0 ACS_NamedExecuteWithResult("core_nonshootableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)

    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    stop
  }
}



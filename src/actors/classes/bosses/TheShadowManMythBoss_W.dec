actor ShadowBoss_ReturnBlade : ShadowBoss_ShadowBlade {
  +NOINTERACTION
  // +SEEINVISIBLE //
  // -DONTSEEKINVISIBLE //
  +SEEKERMISSILE
  states {
   Spawn:
    SHAH K 0
    SHAH K 0 A_FaceTarget
    SHAH K 0 A_RearrangePointers(0, 0, 2)
   Spawn2:
    SHAH K 0 A_JumpIfCloser(42, "Death")
    SHAH K 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH K 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    SHAH K 0 A_JumpIfCloser(42, "Death")
    SHAH K 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH K 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    SHAH K 0 A_JumpIfCloser(42, "Death")
    SHAH K 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH K 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    //
    //
    //
    SHAH L 0 A_JumpIfCloser(42, "Death")
    SHAH L 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH L 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    SHAH L 0 A_JumpIfCloser(42, "Death")
    SHAH L 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH L 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    SHAH L 0 A_JumpIfCloser(42, "Death")
    SHAH L 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    SHAH L 1 A_SpawnItemEx("ShadowBoss_DamagerBlade", 0, 0, 0, momx, momy, momz, 0, 8)
    SHAH L 0 A_CountDown
    SHAH L 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    loop
  }
}


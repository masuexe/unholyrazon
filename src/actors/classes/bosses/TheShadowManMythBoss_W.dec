   Pickup:
    TNT1 A 0 A_TakeInventory("ShadowBoss_Flag_1")
    TNT1 A 0 A_TakeInventory("ShadowBoss_Flag_Delay", 1)  //
    TNT1 A 0 A_TakeInventory("ShadowBoss_Cloak", 1)
    TNT1 A 0 A_TakeInventory("Power_ShadMan")
    TNT1 A 0 A_ChangeFlag("DONTIDENTIFYTARGET", 0)
    stop
  }
}


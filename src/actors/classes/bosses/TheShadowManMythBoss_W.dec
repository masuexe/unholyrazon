actor ShadowBoss_SneakThunder : BasicProjectile {
  translation "192:192=63:63", "198:198=8:8"
  +THRUACTORS
  +NOEXPLODEFLOOR
  +FORCEYBILLBOARD
  +FLOORHUGGER
  +DONTBLAST
  Damage (0)
  damagetype "ShadowBossOther"  // Etc damage.
  Obituary "\chShadowman\c- killed %o."
  height 32
  radius 16
  states {
   Spawn:
    X_BC N 0
    X_BC N 0 A_SpawnItemEx("LightningExtend", 0, 0, 355)
    X_BC N 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    X_BC N 0 A_Explode(100, 128, 0)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(32, 96), Random(32, 96), 32)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(-32, -96), Random(-32, -96), 64)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(32, 96), Random(32, 96), 96)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(-32, -96), Random(-32, -96), 128)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(32, 96), Random(32, 96), 160)
    X_BC N 0 A_SpawnItemEx("LightningBoltFX", Random(-32, -96), Random(-32, -96), 192)
    X_BC OPQR 1
    Stop
  }
}

actor ShadowBoss_Fade_FX : BasicGraphicEffect {
  Translation "192:192=56:56", "198:198=79:79"
  // +FORCEXYBILLBOARD
  Alpha 0.95
  States {
   SpawnFrame:
    SHAG F 10
    SHAG FF 2 A_Fadeout(0.1)
    SHAG GGGGGGG 2 A_Fadeout(0.1)
    stop
  }
}

actor ShadowBoss_SneakDropper {
  // Translation "192:192=232:232", "198:198=167:167", "195:195=210:210"
  translation "4:4=63:63", "195:195=8:8", "202:202=8:8"
  PROJECTILE
  +NOINTERACTION
  height 1
  radius 1
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_SneakSpawner", 32, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor ShadowBoss_SneakSpawner {
  PROJECTILE
  +RIPPER
  -NOGRAVITY
  damagetype "ShadowBossOther"  // Etc damage.
  Obituary "\chShadowman\c- killed %o."
  Damage (150)
  Scale 3.0
  ReactionTime 35
  States {
   Spawn:
    6P25 A 0
    TNT1 A 1 ThrustThingZ(0, 100, 1, 0)
    TNT1 A 2 A_CountDown
    Goto Spawn+2
   Crash:
   Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("ShadowBoss_SneakerThing", 0, 0, 0, 15, 0, 0, 0, 1)
    stop
  }
}


actor ShadowBoss_Clone_AI {
  Translation "192:192=4:4", "198:198=199:199"
  Obituary "%o died to Shadow clone."
  MONSTER
  Species "ShadowmanHaha"
  +THRUSPECIES
  +DROPOFF  // -
  -COUNTKILL
  +NOBLOOD
  +MISSILEMORE
  +LOOKALLAROUND
  +SLIDESONWALLS  // Wut
  Health 1000  //
  damagefactor "Normal", 1.0
  mass 999999
  Radius 16
  Height 56
  Scale 2.5
  Speed 30  // 10
  MaxStepHeight 32  //
  MaxDropOffHeight 32  //
  States {
   Spawn:
   Standing:
   Seek:
    SHAG A 1 A_Look
    SHAG A 0 A_Jump(96, "Wander")
    loop

   See:  // A_GiveInventory("ShadowBoss_ShadowStep",1) //5
    SHAG B 0 A_Jump(16, "Jump", "Dash")
    SHAG B 0 A_Jump(32, "SuperWander")
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG B 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG BBCCC 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_FaceTarget
    SHAG A 0 A_JumpIfCloser(228, "Attack")  // 128
    // SHAG A 0 A_SetAngle(angle - random(-25,25)) //45
    SHAG D 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG D 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG DDEEE 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_FaceTarget
    SHAG A 0 A_SetAngle(angle - random(-25, 25))  // 45
    SHAG A 0 A_JumpIfCloser(228, "Attack")  // 128
    SHAG A 0 A_Jump(100, "Attack")
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG B 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG BBCCC 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_FaceTarget
    SHAG A 0 A_JumpIfCloser(228, "Attack")  // 128
    // SHAG A 0 A_SetAngle(angle - random(-25,25)) //45
    SHAG D 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG D 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG DDEEE 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_FaceTarget
    SHAG A 0 A_SetAngle(angle - random(-25, 25))  // 45
    SHAG A 0 A_JumpIfInventory("CutterFlag", 2, "Attack")
    SHAG A 0 A_JumpIfCloser(228, "Attack")  // 128
    SHAG A 0 A_Jump(100, "Attack")
    SHAG A 0 A_GiveInventory("CutterFlag", 1)
    loop

   Wander:
    SHAG A 0 A_SetAngle(angle - random(-120, 120))  // 45
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG BBB 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_Jump(16, "BasicJump")
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_Look
    SHAG CCC 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_Jump(16, "BasicJump")
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_Look
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG DDD 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_Jump(16, "BasicJump")
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_Look
    SHAG EEE 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_Jump(16, "BasicJump")
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_Look
    Goto Wander
   BasicJump:
    SHAG A 0 A_ScaleVelocity(0.35)
    SHAG A 2
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_ChangeVelocity(random(-10, 10), random(-10, 10), random(8, 14), CVF_RELATIVE|CVF_REPLACE)
    SHAG BCDE 3
   Jumpers:
    SHAG BBBCCCDDDEEE 1 A_CheckFloor("Wander")
    Loop
    /// /
    /// /
    /// /

   SuperWander:
    SHAG A 0 A_SetAngle(angle - random(-120, 120))  // 45
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG BBB 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_JumpIfCloser(356, "Attack")  // 128
    SHAG CCC 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_JumpIfCloser(356, "Attack")  // 128
    SHAG B 0 A_GiveInventory("ShadowBoss_ShadowStep")
    SHAG DDD 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_JumpIfCloser(356, "Attack")  // 128
    SHAG EEE 1 A_ChangeVelocity(20.0, 0.0, -20.0, CVF_REPLACE|CVF_RELATIVE)
    SHAG A 0 A_SetAngle(angle - random(-45, 45))  // 45
    SHAG A 0 A_JumpIfCloser(356, "Attack")  // 128
    SGAH A 0 A_Jump(96, "SuperWander")  // 64
    Goto See

    // This does damage? Maybe?
   Dash:
    SHAG F 0 A_ScaleVelocity(0.35)
    SHAG F 0 A_FaceTarget
    SHAG A 2
    SHAG A 0 A_SetAngle(angle - random(-120, 120))  // 45
    // SHAG IIIII 1 A_ChangeVelocity(24.0,0,0,CVF_REPLACE|CVF_RELATIVE)
    // SHAG III 1 A_ChangeVelocity(30.0,0,0,CVF_REPLACE|CVF_RELATIVE)
    // SHAG II 1 A_ChangeVelocity(38.0,0,0,CVF_REPLACE|CVF_RELATIVE)
    SHAG I 2 A_Recoil(-10)  //
    SHAG I 3 A_Recoil(-20)  //
    SHAG I 6 A_Recoil(-40)  // 8
    SHAG I 2 A_ScaleVelocity(0.85)
    SHAG A 0 A_JumpIfCloser(512, "Attack")
    Goto Seek

   Attack:
    SHAG F 0 A_Jump(16, "Dash")
    SHAG F 0 A_Jump(64, "Jump")
    SHAG F 0 A_FaceTarget
    SHAG F 0 A_ScaleVelocity(0.85)
    SHAG AF 3
    SHAG B 0 A_PlaySoundEx("weapon/mbuster", "voice", 0, 1)  //
    SHAG G 5 A_CustomMissile("ShadowBoss_Kunai", 32, 8, 0, 0)
    SHAG A 2 A_JumpIfCloser(512, "Attack")  // 128
    SHAG A 0 A_Jump(64, "Attack")
    goto Seek

   Jump:
    SHAG A 0 A_Jump(96, "JumpAttack")
    SHAG A 0 A_ScaleVelocity(0.35)
    SHAG A 0 A_FaceTarget
    SHAG A 2
    SHAG A 0 A_SetAngle(angle - random(-120, 120))  // 45
    SHAG A 0 A_ChangeVelocity(random(-20, 20), random(-20, 20), random(12, 18), CVF_RELATIVE|CVF_REPLACE)
    SHAG BCDE 3  // A_FaceTarget
   Jumpers:
    SHAG BBBCCCDDDEEE 1 A_CheckFloor("See")
    Loop
    //
   JumpAttack:
    SHAG A 0 A_ScaleVelocity(0.35)
    SHAG A 0 A_FaceTarget
    SHAG A 2
    SHAG A 0 A_ChangeVelocity(random(-20, 20), random(-20, 20), random(12, 18), CVF_RELATIVE|CVF_REPLACE)
    SHAG F 2 A_FaceTarget
   JumpersAttack:
    SHAG A 0 A_FaceTarget
    SHAG FFF 1 A_CheckFloor("See")
    SHAG F 0 A_CustomMissile("ShadowBoss_Kunai", 32, 8, 0, 0)
    SHAG GGGGG 1 A_CheckFloor("See")
    Loop

   Death:
    SHAG H 0 A_ScaleVelocity(0.35)
    SHAG HHH 2 A_SpawnItemEx("BassExplode", random(-64, 64), random(-64, 64), random(-6, 56))
    SHAG H 14
    TNT1 A 1 A_SpawnItemEx("FakeDeathFX", 0, 0, 50)
    TNT1 A 0 A_PlaySoundEx("misc/devildeath", "SoundSlot5", 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, -60)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, 120)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, -120)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Kunai", 0, 0, 32, 60, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("ShadowBoss_Clone_Drop", 0, 0, 32, random(-5, 5), random(-5, 5), random(-5, 5))
    Stop
  }
}

actor ShadowBoss_Clone_Drop {
  Translation "192:192=4:4", "198:198=199:199"
  +MISSILE
  +DONTBLAST
  +DONTSPLASH
  +THRUACTORS
  +BOUNCEONFLOORS
  +CLIENTSIDEONLY
  WALLBOUNCEFACTOR 0.85
  BOUNCEFACTOR 0.8  // 0.6

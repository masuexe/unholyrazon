actor GelatoTwinThingGuyPSEUDOISM : BasicProjectile {
  Translation "192:192=4:4", "198:198=5:5"
  DamageType "Gelato"
  Obituary "%o was now friends with \cjJester \cmGelato\c- (%k)."
  -NOGRAVITY
  +DONTBLAST
  +THRUGHOST
  Bouncetype Classic
  -BOUNCEONWALLS
  -BOUNCEONFLOORS
  -BOUNCEONCEILINGS
  -ALLOWBOUNCEONACTORS

actor HarpStrummShot9 : HarpStrummShot  // White
{
  Translation "192:192=80:80", "198:198=87:87"
  Obituary "%k's \cjwhite\c- note blast rocked %o's world."
  +HITTRACER
  Damage (100)
  Args 100, 128, 32
  States {
   Death:
    TNT1 A 0 A_GiveToTarget("HarpStrummShot9HealerW_P", 1)
    goto Super::Death
   Crash:
    TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer"), "CrashSpawn")
    goto Death
   CrashSpawn:
    TNT1 A 0 A_SpawnItemEx("HarpStrummShot9Healer", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Super::Death
  }
}
actor HarpStrummShot9Healer {
  PROJECTILE
  +THRUACTORS
  +NOTARGETSWITCH
  +DONTREFLECT
  +NOINTERACTION
  +SEEKERMISSILE
  ReactionTime 60
  damage (0)
  radius 4
  height 4
  speed 40
  scale 2.5
  States {
   Spawn:
    8P52 X 0
    8P52 X 0 A_RearrangePointers(0, 0, 2)
    8P52 X 0 A_FaceTarget
    goto Spawn2
   Spawn2:
    8P52 X 0 A_JumpIfCloser(60, "Death")
    8P52 X 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    8P52 X 1 A_SpawnItemEx("HarpStrummShot9HealerFX", 0, 0, 0, 0, 0, 0, 0, 1)
    8P52 X 0 A_JumpIfCloser(60, "Death")
    8P52 X 1 A_SpawnItemEx("HarpStrummShot9HealerFX", 0, 0, 0, 0, 0, 0, 0, 1)
    8P52 X 0 A_JumpIfCloser(60, "Death")
    8P52 X 1 A_SpawnItemEx("HarpStrummShot9HealerFX", 0, 0, 0, 0, 0, 0, 0, 1)
    8P52 X 0 A_JumpIfCloser(60, "Death")
    8P52 X 0 A_CountDown
    8P52 X 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "DeathU")
    loop
   DeathU:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0 A_GiveToTarget("HarpStrummShot9Healer_P", 1)
    stop
  }
}

actor HarpStrummShot9HealerFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 1
    8P52 YYYZZZ 1 A_FadeTo(0.4, 0.1, 1)
    wait
  }
}

actor HarpStrummShot9Healer_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 350)
    stop
  }
}
actor HarpStrummShot9HealerW_P : CustomInventory {
  States {

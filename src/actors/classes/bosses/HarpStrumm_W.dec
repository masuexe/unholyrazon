// IDEA: add jukeboxes like Blitzkrieg?

actor HarpStrumm_W_ScriptBar : ScriptBar {}
actor HarpStrumm_W : BaseUnholyBossWep {
  Tag "$TAG_Boss052_W"
  Obituary "%k strummed their guitar. %o didn't feel so good."
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammouse 25
  States {
   Spawn:
    8H52 [ 1
    wait

   Deselect:
    8H52 A 0
    goto DeselectSwap
   Select:
    8H52 A 0
    goto SelectSwap

   Ready:
    8H52 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, HARPSTRUMM_DYE)
    8H52 A 0 ACS_NamedExecuteWithResult("rz_LowHPWarning", 1)
    goto ReadyX
   ReadyReset:
    8H52 A 0 ACS_NamedExecuteWithResult("core_chargecolor", HARPSTRUMM_DYE)
    8H52 A 0 A_PlaySoundEx("S3_K/MetalSpark", "Body")
    8H52 A 0 A_SetArg(4, Args[4]+4)  // Bonus for emptying clip
    8H52 AA 1 A_TakeInventory("HarpStrummColorF")
    goto ReadyX
   ReadyX:
    8H52 A 2 A_WeaponReady
    wait

   Rdy_Red:
    8H52 E 2 A_WeaponReady
    wait
   Rdy_Orange:
    8H52 G 2 A_WeaponReady
    wait
   Rdy_Yellow:
    8H52 I 2 A_WeaponReady
    wait
   Rdy_Green:
    8H52 K 2 A_WeaponReady
    wait
   Rdy_Cyan:
    8H52 M 2 A_WeaponReady
    wait
   Rdy_Blue:
    8H52 O 2 A_WeaponReady
    wait
   Rdy_Purple:
    8H52 Q 2 A_WeaponReady
    wait
   Rdy_Black:
    8H52 S 2 A_WeaponReady
    wait
   Rdy_White:
    8H52 U 2 A_WeaponReady
    wait

   Fire:
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 9, "F_White")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 8, "F_Black")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 7, "F_Purple")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 6, "F_Blue")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 5, "F_Cyan")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 4, "F_Green")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 3, "F_Yellow")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 2, "F_Orange")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 1, "F_Red")
    8H52 A 0 A_PlaySoundEx("MMSF2/MachineGunStringNote", "Weapon")
    8H52 A 0 A_FireCustomMissile("HarpStrummShot", 0, 1, 0, 0)
    /*
8H52 A 2 Offset(0,60)
8H52 A 8 Offset(0,88)
8H52 A 2 Offset(0,77)
8H52 A 2 Offset(0,66)
8H52 A 2 Offset(0,55)
8H52 A 2 Offset(0,44)
     */

    8H52 B 2 Offset(-18, 22)  // A limit if 14?
    8H52 B 8 Offset(-36, 12)
    8H52 B 2 Offset(-26, 32)
    8H52 A 2 Offset(-17, 50)
    8H52 A 2 Offset(-10, 42)
    8H52 A 2 Offset(-5, 36)
    8H52 A 2 Offset(-2, 34)
    Goto ReadyX


   F_Red:  // Power
    8H52 E 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 E 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 E 0 A_ChangeVelocity(-Cos(pitch)*18, 0, sin(pitch)*10, CVF_RELATIVE)
    8H52 E 0 A_FireCustomMissile("HarpStrummShot1", 0, 1, 0, 0)
    8H52 F 2 Offset(-18, 22)
    8H52 F 12 Offset(-36, 12)
    8H52 F 2 Offset(-26, 32)
    8H52 E 2 Offset(-17, 50)
    8H52 E 2 Offset(-10, 42)
    8H52 E 2 Offset(-5, 36)
    8H52 E 2 Offset(-2, 34)
    8H52 E 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Red

   F_Orange:  // Gravity
    8H52 G 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 G 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 G 0 A_FireCustomMissile("HarpStrummShot2", 0, 1, 0, 0)
    8H52 H 2 Offset(-18, 22)
    8H52 H 6 Offset(-36, 12)
    8H52 H 2 Offset(-26, 32)
    8H52 G 2 Offset(-17, 50)
    8H52 G 2 Offset(-10, 42)
    8H52 G 2 Offset(-5, 36)
    8H52 G 2 Offset(-2, 34)
    8H52 G 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Orange

   F_Yellow:  // Rapid
    8H52 I 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 I 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 I 0 A_FireCustomMissile("HarpStrummShot3", random(-2, 2), 1, 0, 0)
    8H52 J 2 Offset(-18, 22)
    8H52 J 2 Offset(-36, 12)
    8H52 D 2 Offset(-36, 12)
    8H52 I 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 I 0 A_FireCustomMissile("HarpStrummShot3", random(-2, 2), 0, 0, 0)
    8H52 J 4 Offset(-36, 12)
    8H52 D 2 Offset(-36, 12)
    8H52 I 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 I 0 A_FireCustomMissile("HarpStrummShot3", random(-2, 2), 0, 0, 0)
    8H52 J 2 Offset(-26, 32)
    8H52 I 2 Offset(-17, 50)
    8H52 I 2 Offset(-10, 42)
    8H52 I 2 Offset(-5, 36)
    8H52 I 2 Offset(-2, 34)
    8H52 I 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Yellow

   F_Green:  // Explosive
    8H52 K 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 K 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 K 0 A_FireCustomMissile("HarpStrummShot4", 0, 1, 0, 0)
    8H52 L 2 Offset(-18, 22)
    8H52 L 6 Offset(-36, 12)
    8H52 L 2 Offset(-26, 32)
    8H52 K 2 Offset(-17, 50)
    8H52 K 2 Offset(-10, 42)
    8H52 K 2 Offset(-5, 36)
    8H52 K 2 Offset(-2, 34)
    8H52 K 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Green

   F_Cyan:  // Bounce
    8H52 M 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 M 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 M 0 A_FireCustomMissile("HarpStrummShot5", 0, 1, 0, 0)
    8H52 N 2 Offset(-18, 22)
    8H52 N 6 Offset(-36, 12)
    8H52 N 2 Offset(-26, 32)
    8H52 M 2 Offset(-17, 50)
    8H52 M 2 Offset(-10, 42)
    8H52 M 2 Offset(-5, 36)
    8H52 M 2 Offset(-2, 34)
    8H52 M 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Cyan

   F_Blue:  // Split
    8H52 O 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 O 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 O 0 A_FireCustomMissile("HarpStrummShot6", 0, 1, 0, 0)
    8H52 P 2 Offset(-18, 22)
    8H52 P 6 Offset(-36, 12)
    8H52 P 2 Offset(-26, 32)
    8H52 O 2 Offset(-17, 50)
    8H52 O 2 Offset(-10, 42)
    8H52 O 2 Offset(-5, 36)
    8H52 O 2 Offset(-2, 34)
    8H52 O 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Blue

   F_Purple:  // Spread
    8H52 Q 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 Q 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 Q 0 A_FireCustomMissile("HarpStrummShot7", 0, 1, 0, 0)
    8H52 Q 0 A_FireCustomMissile("HarpStrummShot7", 15, 0, 0, 0)
    8H52 Q 0 A_FireCustomMissile("HarpStrummShot7", -15, 0, 0, 0)
    8H52 R 2 Offset(-18, 22)
    8H52 R 6 Offset(-36, 12)
    8H52 R 2 Offset(-26, 32)
    8H52 Q 2 Offset(-17, 50)
    8H52 Q 2 Offset(-10, 42)
    8H52 Q 2 Offset(-5, 36)
    8H52 Q 2 Offset(-2, 34)
    8H52 Q 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Purple

   F_Black:  // Slow
    8H52 S 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 S 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 S 0 A_FireCustomMissile("HarpStrummShot8", 0, 1, 0, 0)
    8H52 T 2 Offset(-18, 22)
    8H52 T 6 Offset(-36, 12)
    8H52 T 2 Offset(-26, 32)
    8H52 S 2 Offset(-17, 50)
    8H52 S 2 Offset(-10, 42)
    8H52 S 2 Offset(-5, 36)
    8H52 S 2 Offset(-2, 34)
    8H52 S 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_Black

   F_White:  // Drain
    8H52 U 0 A_PlaySoundEx("S_CD/ShockFloor", "Weapon")
    8H52 U 0 A_GiveInventory("HarpStrummNoteKillF", 1)
    8H52 U 0 A_FireCustomMissile("HarpStrummShot9", 0, 1, 0, 0)
    8H52 V 2 Offset(-18, 22)
    8H52 V 6 Offset(-36, 12)
    8H52 V 2 Offset(-26, 32)
    8H52 U 2 Offset(-17, 50)
    8H52 U 2 Offset(-10, 42)
    8H52 U 2 Offset(-5, 36)
    8H52 U 2 Offset(-2, 34)
    8H52 U 0 A_JumpIfInventory("HarpStrummNoteKillF", 8, "ReadyReset")
    Goto Rdy_White



   Altfire:
    8H52 A 0 A_GiveInventory("VivifyDelay5")
    8H52 A 0 A_Refire(1)
    8H52 A 0 A_TakeInventory("HarpStrummColorF")
    8H52 A 0 A_GiveInventory("HarpStrummNoteKillF", 9)
    8H52 A 2 Offset(6, 42)
    8H52 A 2 Offset(12, 52)
    8H52 A 0 A_TakeInventory("HarpStrummColorF")
    8H52 A 0 A_GiveInventory("HarpStrummNoteKillF", 9)
    8H52 A 2 Offset(17, 62)
    8H52 C 1 Offset(22, 72)A_TakeInventory("HarpStrummNoteKillF")
    8H52 C 1 Offset(22, 72)A_GiveInventory("HarpStrummAltColorRNG_P")
    8H52 A 0 Offset(25, 75)A_GunFlash
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 9, "A_White")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 8, "A_Black")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 7, "A_Purple")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 6, "A_Blue")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 5, "A_Cyan")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 4, "A_Green")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 3, "A_Yellow")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 2, "A_Orange")
    8H52 A 0 A_JumpIfInventory("HarpStrummColorF", 1, "A_Red")
    8H52 A 1
    Goto A_Faker

   A_Faker:
    8H52 AA 1
    // 8H52 C 2 Offset(22,72)
    // 8H52 A 2 Offset(25,75)
    8H52 Z 2 Offset(25, 75)
    8H52 AZAZAZAZAZAZAZA 2
    Goto A_SpawnNotes

   A_Red:
    8H52 EE 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLRED)
    8H52 Z 2 Offset(25, 75)
    8H52 EZEZEZEZEZEZEZE 2
    Goto A_SpawnNotes

   A_Orange:
    8H52 GG 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLORANGE)
    8H52 Z 2 Offset(25, 75)
    8H52 GZGZGZGZGZGZGZG 2
    Goto A_SpawnNotes

   A_Yellow:
    8H52 II 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLYELLOW)
    8H52 Z 2 Offset(25, 75)
    8H52 IZIZIZIZIZIZIZI 2
    Goto A_SpawnNotes

   A_Green:
    8H52 KK 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLGREEN)
    8H52 Z 2 Offset(25, 75)
    8H52 KZKZKZKZKZKZKZK 2
    Goto A_SpawnNotes

   A_Cyan:
    8H52 MM 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLCYAN)
    8H52 Z 2 Offset(25, 75)
    8H52 MZMZMZMZMZMZMZM 2
    Goto A_SpawnNotes

   A_Blue:
    8H52 OO 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLBLUE)
    8H52 Z 2 Offset(25, 75)
    8H52 OZOZOZOZOZOZOZO 2
    Goto A_SpawnNotes

   A_Purple:
    8H52 QQ 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLPURPLE)
    8H52 Z 2 Offset(25, 75)
    8H52 QZQZQZQZQZQZQZQ 2
    Goto A_SpawnNotes

   A_Black:
    8H52 SS 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLBLACK)
    8H52 Z 2 Offset(25, 75)
    8H52 SZSZSZSZSZSZSZS 2
    Goto A_SpawnNotes

   A_White:
    8H52 UU 1 ACS_NamedExecuteWithResult("core_chargecolor", FULLWHITE)
    8H52 Z 2 Offset(25, 75)
    8H52 UZUZUZUZUZUZUZU 2
    Goto A_SpawnNotes

   Flash:
    TNT1 A 1 A_TakeInventory("UnholyBossAmmo200", 200)
    TNT1 A 1
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Body")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Weapon")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Body")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Weapon")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Body")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Weapon")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")

    TNT1 A 0 A_GiveInventory("HarpStrummAuraWarper_P")

    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep1", "Body")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 25)
    TNT1 A 0 A_PlaySoundEx("S3_K/RaceBeep2", "Weapon")
    TNT1 A 4 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 4 A_GiveInventory("VivifyDelay4")
    TNT1 A 4 A_GiveInventory("UnholyBossAmmo200", 200)
    stop

   A_SpawnNotes:
    8H52 "#" 2 Offset(16, 65)
    8H52 "#" 2 Offset(11, 58)
    8H52 "#" 2 Offset(7, 51)
    8H52 "#" 2 Offset(4, 44)
    8H52 "#" 2 Offset(2, 37)
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 9, "Rdy_White")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 8, "Rdy_Black")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 7, "Rdy_Purple")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 6, "Rdy_Blue")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 5, "Rdy_Cyan")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 4, "Rdy_Green")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 3, "Rdy_Yellow")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 2, "Rdy_Orange")
    8H52 "#" 0 A_JumpIfInventory("HarpStrummColorF", 1, "Rdy_Red")
    Goto ReadyX
  }
}

actor HarpStrummNoteKillF : Inventory {
  inventory.amount 1
  inventory.maxamount 8
}
actor HarpStrummColorF : Inventory {
  inventory.amount 1
  inventory.maxamount 9
}

actor HarpStrummAltColorRNG_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(Args[4], "A_Rare")
    TNT1 A 0 A_SetArg(4, Args[4]+2)
    TNT1 A 0 A_Jump(256, "A_Red", "A_Orange", "A_Yellow", "A_Green", "A_Cyan", "A_Blue", "A_Purple")
    stop
   A_Red:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLRED)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 1)
    stop
   A_Orange:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLORANGE)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 2)
    stop
   A_Yellow:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLYELLOW)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 3)
    stop
   A_Green:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLGREEN)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 4)
    stop
   A_Cyan:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLCYAN)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 5)
    stop
   A_Blue:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLBLUE)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 6)
    stop
   A_Purple:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLPURPLE)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 7)
    stop
   A_Rare:
    TNT1 A 0 A_SetArg(4, 4)
    TNT1 A 0 A_Jump(256, "A_Black", "A_White")
   A_Black:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLBLACK)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 8)
    stop
   A_White:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", FULLWHITE)
    TNT1 A 0 A_GiveInventory("HarpStrummColorF", 9)
    stop
  }
}

actor HarpStrummAuraWarper_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper1", 18, 0, 32, 0, 0, 0, 0, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper5", 18, 0, 32, 0, 0, 0, 45, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper2", 18, 0, 32, 0, 0, 0, 90, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper6", 18, 0, 32, 0, 0, 0, 135, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper3", 18, 0, 32, 0, 0, 0, 180, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper7", 18, 0, 32, 0, 0, 0, 225, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper4", 18, 0, 32, 0, 0, 0, 270, 33)
    TNT1 A 0 A_SpawnItemEX("HarpStrummAuraWarper8", 18, 0, 32, 0, 0, 0, 315, 33)
    stop
  }
}

actor HarpStrummShot : BasicProjectile {
  Translation "192:192=170:170", "198:198=41:41"
  // Translation "192:192=80:80", "198:198=40:40"
  damagetype "HarpStrumm"
  Obituary "%k's note blast rocked %o's world."
  +SKYEXPLODE
  +EXPLODEONWATER
  Alpha 0.95  // 0.5
  RenderStyle Translucent
  Damage (50)  // 80
  Speed 45
  radius 16  // 20
  height 16
  scale 2.5  // 3.5
  Args 50, 128, 32
  // Explosion settings
  // Damage Size Set_Size
  States {
   Spawn:
   SpawnScale:
    8P52 C 1
    8P52 CCCCCC 1 A_SetScale(ScaleX-0.1, ScaleY+0.1)
    8P52 C 1
    8P52 CCCCCC 1 A_SetScale(ScaleX+0.2, ScaleY-0.3)
    8P52 C 1
    8P52 CCCCCC 1 A_SetScale(ScaleX-0.1, ScaleY+0.2)
    8P52 C 2
    loop
   Death:
    TNT1 A 0 A_SetScale(2.5)
    goto DeathBoom
   DeathBoom:
    TNT1 A 0 A_PlaySoundEx("KirbyNES/BombBoom", "Weapon")  // weapon/drillexplode
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 4 A_SpawnItemEx("HarpStrummShotBoomFX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
  }
}


actor HarpStrummShotBoom : BasicExplosion {
  damagetype "HarpStrumm"
  Obituary "%k's note blast rocked %o's world."

  Scale 2.5
  Args 50, 128, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 4 A_SpawnItemEx("HarpStrummShotBoomFX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
  }
}


actor HarpStrummShotBoomFX : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  Speed 0
  States {
   SpawnFrame:
    X_3L A 0
    X_3L A 0 A_Jump(256, "Spawn_R", "Spawn_L")
   Spawn_R:
    X_3L A 1
    8P52 EFGHIJ 2
    X_3L LM 2
    stop
   Spawn_L:
    X_3L A 1
    8P52 KLMNOPQ 2
    X_3L M 2
    stop
    // XMFX C 1
    // 8P52 EFGHIJKLMNOP 1//Old sprites
    // X_4L MNOPQRST 1 A_Fadeout(0.05)
  }

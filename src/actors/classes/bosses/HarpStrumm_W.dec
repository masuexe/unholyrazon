    8P52 CCCCCC 1 A_SetScale(ScaleX-0.1, ScaleY+0.2)
    8P52 C 2 A_SpawnItemEx("HarpStrummShot5Boom", random(-96, 96), random(-96, 96), random(-72, 72), 0, 0, 0, 0, 1)
    loop
  }
}


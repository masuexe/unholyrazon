actor HarpStrummAuraWarper : BasicShieldWarper {
  Alpha 0.7
  RenderStyle Translucent
  Mass 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper", 0, 0)
    Goto SpawnWait
   SpawnWait:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 18, 0, 24, 4*(CallACS("uh_checkrune", RUNE_RAGE, 2)+1), 28)
    TNT1 A 1 A_JumpIfInTargetInventory("VivifyDelay4", 1, "SpawnAppear")
    loop
   SpawnAppear:
    8P52 A 1 A_Warp(2, 34, 0, 26, 0.8*(CallACS("uh_checkrune", RUNE_RAGE, 2)+1), 28)
    8P52 A 1 A_Warp(2, 50, 0, 28, 0.8*(CallACS("uh_checkrune", RUNE_RAGE, 2)+1), 28)
    8P52 A 1 A_Warp(2, 66, 0, 30, 0.8*(CallACS("uh_checkrune", RUNE_RAGE, 2)+1), 28)
    goto SpawnExist
   SpawnExist:
    8P52 A 0 A_JumpIfInTargetInventory("HarpStrummNoteKillF", Mass, "Death")
    8P52 A 1 A_Warp(2, 82, 0, 32, 4*(CallACS("uh_checkrune", RUNE_RAGE, 2)+1), 28)
    loop
   Death:
    TNT1 A 1
    stop
  }
}
actor HarpStrummAuraWarper1 : HarpStrummAuraWarper {
  Mass 1
}
actor HarpStrummAuraWarper2 : HarpStrummAuraWarper {
  Mass 2
}
actor HarpStrummAuraWarper3 : HarpStrummAuraWarper {
  Mass 3
}

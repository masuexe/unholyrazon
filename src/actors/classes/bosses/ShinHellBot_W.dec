actor NormalHelltatoruShotBoss : BasicProjectile
{
Translation "192:192=95:95","198:198=189:189","202:202=4:4","199:199=210:210"
damagetype "ShinHellbot"
Obituary "%o was KPOW'D by \cmShin \cuHellBot \c-(%k)!"
+SKYEXPLODE
+EXPLODEONWATER
Damage (125)
radius 15
height 15
Speed 50
scale 2.5
States
{
Spawn:
X_0A ABCBC 2
Y_0A B 2
X_0A CBCB 2
Y_0A C 2
goto Spawn+1
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
TNT1 A 0 A_Explode(75,128,0,0,16)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}


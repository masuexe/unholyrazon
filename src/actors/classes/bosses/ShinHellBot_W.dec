actor ShinHellBloodReturn : BasicProjectile
{
Translation "192:192=4:4","198:198=189:189"
+THRUACTORS
+NOTARGETSWITCH
+DONTREFLECT
+NOINTERACTION
+SEEKERMISSILE
ReactionTime 120//About 10 seconds
damage (0)
radius 4
height 4
speed 40//16
scale 2.5
States
{
Spawn:
TMFX A 0
TMFX A 0 A_RearrangePointers(0,0,2)
TMFX A 0 A_FaceTarget
goto Spawn2
Spawn2:
TMFX A 0 A_JumpIfCloser(60,"Death")
TMFX A 0 A_SeekerMissile(90,90,SMF_PRECISE)
TMFX A 1 A_SpawnItemEx("ShinHellBloodReturnFX",0,0,0,0,0,0,0,1)
TMFX B 0 A_JumpIfCloser(60,"Death")
TMFX B 1 A_SpawnItemEx("ShinHellBloodReturnFX1",0,0,0,0,0,0,0,1)
TMFX C 0 A_JumpIfCloser(60,"Death")
TMFX C 1 A_SpawnItemEx("ShinHellBloodReturnFX2",0,0,0,0,0,0,0,1)
TMFX A 0 A_JumpIfCloser(60,"Death")
TMFX A 0 A_CountDown
TMFX A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "DeathU")
loop
DeathU:
TNT1 A 1
stop
Death:

actor BlueThwomp_W : BaseUnholyBossWep {
  Tag "$TAG_BlueThwomp_W"
  Weapon.SlotNumber 1
  Inventory.Pickupmessage "\chURGH"
  Obituary "%o was crushed by a \chThwomp \c-(%k)."
  States {
   Spawn:
    WEA2 Q 1
    wait

   Deselect:
    TNT1 A 0
    goto DeselectSwap
   Select:
    TNT1 A 0
    goto SelectSwap

   Ready:
    // TNT1 A 0 A_GiveInventory("IsRage1500",1)
    TNT1 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLUETHWOMP_DYE)
    TNT1 A 0 A_GunFlash
    Goto ReadyX
   ReadyX:
    TNT1 A 1 A_WeaponReady(8)
    loop

   Fire:
    TNT1 A 0 A_SpawnItemEX("ThwompDustFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_ChangeVelocity(10, 0, 15, 1)
    TNT1 A 0 A_ChangeVelocity(0, 0, 15*-sin(pitch))
    TNT1 A 1  // A_ChangeVelocity(50*cos(pitch)+4,0,30*-sin(pitch),3)
   Check:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), 4)
    TNT1 A 0 A_Recoil(-2)
    TNT1 A 0 ThrustThingZ(0, 2, 1, 1)
    TNT1 A 1 A_WeaponReady(6)
    goto Check
    TNT1 A 0 A_SpawnItemEX("ThwompShockWave")
    TNT1 A 0 A_PlaySoundEX("misc/hugequake", "Weapon")
    TNT1 A 0 A_Quake(9, 15, 0, 512)
    TNT1 AAAAA 1 A_Stop
    TNT1 A 15
    goto ReadyX

   Altfire:
    TNT1 A 1 A_ChangeVelocity(0, 0, -100, 3)
    goto Check

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 A_JumpIf(!CallACS("core_CheckFooting_ThruPlayer"), 1)
    loop
    TNT1 A 1 A_SpawnItemEX("ThwompAssCrusher", 0, 0, -32)
    loop
  }
}

actor ThwompAssCrusher {
  PROJECTILE
  Obituary "%o was crushed very hard by a \chThwomp \c-(%k)."
  DamageType "ThwompCrush"
  +THRUACTORS
  +DONTBLAST
  Speed 0
  Damage (0)
  Radius 5
  Height 5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(50, 64, 0, 0, 64)
    stop
  }
}


actor PowerThwompCrushSlow : PowerSpeed {
  speed 0.2
  powerup.duration 105
}

actor ThwompCrush_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PowerThwompCrushSlow", 1, "No")
    TNT1 A 0 A_SetScale(ScaleX, ScaleX-(ScaleX/4)*3)
    TNT1 A 0 A_GiveInventory("PowerThwompCrushSlow")
    TNT1 A 0 A_SpawnItemEx("ThwompCrushWatcher")
    stop
   No:
    TNT1 A 0
    stop
  }
}
actor StoneGuyUnStomped_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_SetScale(2.5, 2.5)
    stop
  }
}

actor ThwompCrushWatcher : BasicWatcher {
  ReactionTime 105
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_CountDown
    wait
   Death:
    TNT1 A 1 A_GiveToTarget("StoneGuyUnStomped_P")
    stop
  }
}




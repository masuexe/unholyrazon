actor ThwompShockwavePart : BasicProjectile {
  Translation "192:192=197:197", "199:199=75:75"
  Obituary "%o was crushed by a \chThwomp \c-(%k)."
  DamageType "Thwomp"
  +FLOORHUGGER
  Damage (100)
  Radius 32
  Height 32
  Speed 30
  Scale 3.0
  States {
   Spawn:
    6P36 A 1 A_FadeOut(0.05)
    loop
  }
}


actor ThwompShockwavePartT1 : ThwompShockwavePart {
  Speed 0
  States {
   Spawn:
    6P36 A 0
    6P36 A 8
    6P36 A 1 A_SpawnItemEx("ThwompShockwavePartT1", 0, 0, 0, 0, 0, 0, 0, 1)
    6P36 A 1
    wait
  }
}
actor ThwompShockwavePartT2 : ThwompShockwavePartT1 {
  Scale 12.0
  States {
   Spawn:
    6P36 B 0
    6P36 B 8
    6P36 B 1 A_SpawnItemEx("ThwompShockwavePartT2", 0, 0, 0, 0, 0, 0, 0, 1)
    6P36 B 1
    wait
  }
}

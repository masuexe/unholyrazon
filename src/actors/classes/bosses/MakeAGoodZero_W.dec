actor MGZeroCutterDriveShot : BasicProjectile {
	damagetype "MGZero"
	Obituary "%o was sliced apart by \c[c4]Zero\c- (%k)'s Cutter Drive."
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+SKYEXPLODE
	+DONTBLAST
	+NOINTERACTION
	+THRUSPECIES
	Species "MGZero"
	Radius 38
	Height 16
	damage (0)
	speed 0
	scale 2.5
	reactiontime 120

	// accuracy 1
	// alpha 25
	// mass 1
	// meleerange 625

	//Args[0] = angle
	//Args[1] = angleAdd

	States {
	 Spawn:
	  8R21 A 0
	  8R21 A 0 A_SetArg(0, Args[0])
	  8R21 A 0 A_SetArg(1, 8)
	 SpawnLoopA:
	  8R21 A 0 A_SetArg(0, Args[0]+Args[1])
	  8R21 A 0 A_SetArg(2, args[2]+1)
	  8R21 A 0 A_SetArg(3, -args[2]*args[2]+50*args[2]) //A_SetArg(3,-accuracy*((args[2]-alpha)/mass)*((args[2]-alpha)/mass)+meleerange)
	  8R21 A 0 A_Warp(2, cos(-Args[0])*Args[3], sin(-Args[0])*Args[3], 32, 0, 2+8+16, "SpawnLoopAC")
	  goto SpawnDeath
	 SpawnLoopAC:
	  8R21 A 0 A_Explode(reactiontime, 38, 0, 0, 0)
	  8R21 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
	  8R21 A 0 A_JumpIf(args[3]<=0, "Death")
	  8R21 A 1
	 SpawnLoopB:
	  8R21 B 0 A_SetArg(0, Args[0]+Args[1])
	  8R21 B 0 A_SetArg(2, args[2]+1)
	  8R21 B 0 A_SetArg(3, -args[2]*args[2]+50*args[2])
	  8R21 B 0 A_Warp(2, cos(-Args[0])*Args[3], sin(-Args[0])*Args[3], 32, 0, 2+8+16, "SpawnLoopBC")
	  goto SpawnDeath
	 SpawnLoopBC:
	  8R21 B 0 A_Explode(reactiontime, 38, 0, 0, 0)
	  8R21 B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
	  8R21 B 0 A_JumpIf(args[3]<=0, "Death")
	  8R21 B 1
	 SpawnLoopC:
	  8R21 A 0 A_SetArg(0, Args[0]+Args[1])
	  8R21 A 0 A_SetArg(2, args[2]+1)
	  8R21 A 0 A_SetArg(3, -args[2]*args[2]+50*args[2])
	  8R21 A 0 A_Warp(2, cos(-Args[0])*Args[3], sin(-Args[0])*Args[3], 32, 0, 2+8+16, "SpawnLoopCC")
	  goto SpawnDeath
	 SpawnLoopCC:
	  8R21 A 0 A_Explode(reactiontime, 38, 0, 0, 0)
	  8R21 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
	  8R21 A 0 A_JumpIf(args[3]<=0, "Death")
	  8R21 C 1
	 SpawnLoopD:
	  8R21 A 0 A_SetArg(0, Args[0]+Args[1])
	  8R21 A 0 A_SetArg(2, args[2]+1)
	  8R21 A 0 A_SetArg(3, -args[2]*args[2]+50*args[2])
	  8R21 A 0 A_Warp(2, cos(-Args[0])*Args[3], sin(-Args[0])*Args[3], 32, 0, 2+8+16, "SpawnLoopDC")
	  goto SpawnDeath
	 SpawnLoopDC:
	  8R21 A 0 A_Explode(reactiontime, 38, 0, 0, 0)
	  8R21 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
	  8R21 A 0 A_JumpIf(args[3]<=0, "Death")
	  8R21 D 1
	  goto SpawnLoopA

	 SpawnDeath:
	  8R21 A 1
	  8R21 A 0 A_JumpIf(true, "Death")
	  8R21 ABCDABCDABCDABCDABCDABCD 1
	  goto Death

	 Death:
	  X_5C A 0
	  stop
	}
}
actor MGZeroFlameDriveCore : BasicProjectile {
	Translation "192:192=217:217", "198:198=42:42"
	damagetype "MGZero"
	Obituary "%o was very hot thanks to \c[c4]Zero\c- (%k)'s Flame Drive."
	+THRUSPECIES
	Species "MGZero"
	+BRIGHT
	Radius 38
	Height 16
	damage (150)
	speed 30
	scale 2.5
	var int user_pitch;
	var int user_speed;
	reactiontime 7
	States {
	 Spawn:
	  X_5C A 0
	  8R21 E 0 ThrustThingZ(0, 75, 0, 0)
	  8R21 E 0 A_SetUserVar("user_pitch", -85)
	  8R21 E 0 A_SetUserVar("user_speed", 30)
	  8R21 EEFFEEFF 1
	  8R21 E 0 A_Stop
	 SpawnL:
	  TNT1 A 0 A_PlaySoundEx("weapon/solarblaze", "weapon")
	  8R21 E 2 A_SpawnItemEx("MGZeroFlameDriveShot", 0, 0, 0, cos(user_pitch)*user_speed, 0, sin(user_pitch)*user_speed, frandom(-4, 4), 1)
	  8R21 F 2
	  8R21 E 0 A_SetUserVar("user_pitch", user_pitch+15)
	  X_5C D 0 A_CountDown//A_JumpIf(user_pitch>=12,"Death")
	  TNT1 A 0 A_PlaySoundEx("weapon/solarblaze", "weapon")
	  8R21 E 2 A_SpawnItemEx("MGZeroFlameDriveShot", 0, 0, 0, cos(user_pitch)*user_speed, 0, sin(user_pitch)*user_speed, frandom(-4, 4), 1)
	  8R21 F 2
	  8R21 E 0 A_SetUserVar("user_pitch", user_pitch+15)
	  X_5C D 0 A_CountDown
	  loop

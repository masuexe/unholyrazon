  Inventory.Icon "B_I_306A"
  Weapon.SelectionOrder 3067
  States {
   Select:
    8K06 I 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MAKEAGOODZERO_PISSED_DYE, CLRF_SILENT)
    TNT1 A 0 A_TakeInventory("MGZeroChipFlag")
    // W2-W7 are phase-2 weapons.  Their cleanup runs once W8 is current so
    // removing W2 cannot abort ThePowerToDefeatMegaman.
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W2")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W3")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W4")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W5")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W6")
    TNT1 A 0 A_TakeInventory("MakeAGoodZero_W7")
    TNT1 A 0 A_TakeInventory("MakeAGoodZeroPhase3PainFlag")
    goto SelectSwap

   Ready:
    8K06 O 0 A_GiveInventory("UnholyPower3000", 1)
    8K06 O 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8K06 O 0 A_GiveInventory("UnholyPower3000", 1)
    8K06 O 1 A_WeaponReady(16)
    loop

   Flash:
    TNT1 A 1 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain", 0)
    TNT1 A 1 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain", 0)
    TNT1 A 1 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain", 0)
    TNT1 A 1 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain", 0, 1)
    loop

   Fire:
    8K06 OP 2
    8K06 O 0 A_GiveInventory("CrystrapRapidShotFlag")
   Fire.a:
    8K06 Q 2 A_WeaponReady(6)
    8K06 A 0 A_PlaySoundEx("misc/mm3explosion", 2)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroShot", 0, 0, 0, 0)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterBuster", 3)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroCutterShot", 0, 0, 0, 0)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroFlameBuster", 4)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroFlameShot", 0, 0, 0, 0)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroIcicleBuster", 5)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroIcicleShot", 0, 0, 0, 0)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroZapBuster", 6)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroZapShot", -18, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroZapShot", 0, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroZapShot", 18, 0, 0, 0)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroPsychoBuster", 7)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroPsychoShot", 0, 0, 0, 0)
    8K06 Q 6
    8K06 Q 0 A_ReFire("Fire.a")
    8K06 QP 2
    8K06 O 2 A_TakeInventory("CrystrapRapidShotFlag")
    goto ReadyX

   AltFire:
    8K06 A 0 A_JumpIfInventory("CrystrapRapidShotFlag", 1, "Drive")
    8K06 A 0 A_TakeInventory("UnholyPower3000", MGZERO_SABER_AMMOUSE, 1)
    8K06 G 0 A_JumpIf(!CallACS("core_CheckFooting"), "AltFire.Air")
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 20, 0, 0, 0)
    8K06 J 1 A_FireCustomMissile("MGZeroAbsoluteSaber", -50, 0, 16, 0, 0, 20)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 10, 0, 0, 0)
    8K06 K 1 A_FireCustomMissile("MGZeroAbsoluteSaber", -25, 0, 8, 0, 0, 10)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0)
    8K06 L 1 A_FireCustomMissile("MGZeroAbsoluteSaber2", 0, 0, 0, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", -10, 0, 0, 0)
    8K06 M 1 A_FireCustomMissile("MGZeroAbsoluteSaber", 25, 0, -8, 0, 0, -5)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", -20, 0, 0, 0)
    8K06 N 1 A_FireCustomMissile("MGZeroAbsoluteSaber", 50, 0, -16, 0, 0, -10)
    TNT1 A 2
    8K06 G 0 A_ReFire("AltFire.b")
    goto AltFireEnd
   AltFire.b:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", -20, 0, 0, 0, 0, 0)
    8K06 C 1 A_FireCustomMissile("MGZeroAbsoluteSaber", 50, 0, -16, 0, 0, -10)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", -10, 0, 0, 0, 0, 0)
    8K06 D 1 A_FireCustomMissile("MGZeroAbsoluteSaber", 25, 0, -8, 0, 0, -5)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, 0)
    8K06 E 1 A_FireCustomMissile("MGZeroAbsoluteSaber2", 0, 0, 0, 0, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 10, 0, 0, 0, 0, 0)
    8K06 F 1 A_FireCustomMissile("MGZeroAbsoluteSaber", -25, 0, 8, 0, 0, 10)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 20, 0, 0, 0, 0, 0)
    8K06 G 1 A_FireCustomMissile("MGZeroAbsoluteSaber", -50, 0, 16, 0, 0, 20)
    TNT1 A 2
    8K06 G 0 A_ReFire("AltFire.c")
    goto AltFireEnd
   AltFire.c:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, 30)
    8K06 K 1 Offset(-8, 22) A_FireCustomMissile("MGZeroAbsoluteSaber", 0, 0, 0, 30, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, 20)
    8K06 K 1 Offset(-18, 52) A_FireCustomMissile("MGZeroAbsoluteSaber", 0, 0, 0, 20, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, 10)
    8K06 M 1 Offset(110, 47) A_FireCustomMissile("MGZeroAbsoluteSaber", 0, 0, 0, 10, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, 0)
    8K06 M 1 Offset(100, 77) A_FireCustomMissile("MGZeroAbsoluteSaber2", 0, 0, 0, 0, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, -10)
    8K06 N 1 Offset(160, 49) A_FireCustomMissile("MGZeroAbsoluteSaber", 0, 0, 0, -10, 0, 0)
    8I20 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot", 0, 0, 0, 0, 0, -20)
    8K06 N 1 Offset(150, 79) A_FireCustomMissile("MGZeroAbsoluteSaber", 0, 0, 0, -20, 0, 0)
    8K06 N 0 A_WeaponReady(14)
    goto AltFireEnd
   AltFire.Air:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleSaberShot_H", 0, 0, 0, 0)
    8K06 M 1 Offset(100, 77) A_SpawnItemEx("MGZeroAbsoluteSaberAir2", MGZERO_CUTTERSABER_RANGE * sqrt(2), 0, 0 + 32, MGZERO_CUTTERSABER_SPEED * sqrt(2), 0, 0)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 N 1 Offset(160, 49) A_SpawnItemEx("MGZeroAbsoluteSaberAir", MGZERO_CUTTERSABER_RANGE, 0, -MGZERO_CUTTERSABER_RANGE + 32, MGZERO_CUTTERSABER_SPEED, 0, -MGZERO_CUTTERSABER_SPEED)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 N 1 Offset(150, 79) A_SpawnItemEx("MGZeroAbsoluteSaberAir", 0, 0, -MGZERO_CUTTERSABER_RANGE * sqrt(2) + 32, 0, 0, -MGZERO_CUTTERSABER_SPEED * sqrt(2))
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    TNT1 A 1 A_SpawnItemEx("MGZeroAbsoluteSaberAir", -MGZERO_CUTTERSABER_RANGE, 0, -MGZERO_CUTTERSABER_RANGE + 32, -MGZERO_CUTTERSABER_SPEED, 0, -MGZERO_CUTTERSABER_SPEED)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    TNT1 A 1 A_SpawnItemEx("MGZeroAbsoluteSaberAir2", -MGZERO_CUTTERSABER_RANGE * sqrt(2), 0, 0 + 32, -MGZERO_CUTTERSABER_SPEED * sqrt(2), 0, 0)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 K 1 Offset(-8, 22) A_SpawnItemEx("MGZeroAbsoluteSaberAir", -MGZERO_CUTTERSABER_RANGE, 0, MGZERO_CUTTERSABER_RANGE + 32, -MGZERO_CUTTERSABER_SPEED, 0, MGZERO_CUTTERSABER_SPEED)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 K 1 Offset(-18, 52) A_SpawnItemEx("MGZeroAbsoluteSaberAir", 0, 0, MGZERO_CUTTERSABER_RANGE * sqrt(2) + 32, 0, 0, MGZERO_CUTTERSABER_SPEED * sqrt(2))
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 M 1 Offset(110, 47) A_SpawnItemEx("MGZeroAbsoluteSaberAir", MGZERO_CUTTERSABER_RANGE, 0, MGZERO_CUTTERSABER_RANGE + 32, MGZERO_CUTTERSABER_SPEED, 0, MGZERO_CUTTERSABER_SPEED)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    goto AltFire.Air+1
   AltFireEnd:
    TNT1 A 6 A_WeaponReady(14)
    8K06 HI 2
    8K06 A 2
    goto ReadyX

   Reload:
    8K06 OPQ 2
    8K06 A 0 A_TakeInventory("UnholyPower3000", 50, 1)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroBurst", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -25, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", 15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", 25, 0, 0, 0)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterBurst", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -25, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroCutterBurstShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroCutterBurstShot", -5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroCutterBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroCutterBurstShot", 15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroCutterBurstShot", 25, 0, 0, 0)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroFlameBurst", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", -5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", 15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameBurstShot", 25, 0, 0, 0)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroIcicleBurst", 1)
    8K06 AAAAAAAA 0 A_SpawnItemEx("MGZeroIcicleBurstFX", random(-32, 32), 0, random(0, 32), 0, 0, 0, random(0, 359))
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", -25, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", -5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", 15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroIcicleBurstShot", 25, 0, 0, 0)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroZapBurst", 6)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", -10, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", -6, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", -2, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", 2, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", 6, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroZapBurstShot", 10, 0, 0, 0)

    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroPsychoBurst", 7)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", -25, 0, 0, 0, 0, 30)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", -15, 0, 0, 0, 0, 30)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", -5, 0, 0, 0, 0, 30)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", 5, 0, 0, 0, 0, 30)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", 15, 0, 0, 0, 0, 30)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoBurstShot", 25, 0, 0, 0, 0, 30)
    8K06 Q 6
    8K06 QPO 2
    goto ReadyX

   Drive:
    8K06 A 0 A_TakeInventory("UnholyPower3000", 50, 1)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterDrive", 1)
    8K06 A 0 A_GiveInventory("SpawnCutterDrive")
    8K06 A 0 A_PlaySoundEx("weapon/mbuster", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroFlameDriveCore", 0, 0, 0, 0, 0, 30)
    SKLA A 0 A_JumpIfInventory("MGZeroIcicleDriveShieldCheck", 1, "Drive.a")
    SKLA A 0 A_PlaySoundEx("MaGMML/ZeroIcicleDrive", "Weapon")
    SKLA A 0 A_GiveInventory("MGZeroIcicleDriveShieldCheck", 8)
    SKLA A 0 A_SpawnItemEx("MGZeroIcicleDriveWarper", 0, 0, 32, 0, 0, 0, 0, 0)
    SKLA A 0 A_SpawnItemEx("MGZeroIcicleDriveWatcher")
   Drive.a:
    SKLA A 0 A_PlaySoundEx("MaGMML/ZeroZapDrive", "Weapon")
    8K06 A 0 A_SpawnItemEx("MGZeroZapDriveShot", 0, 0, 0, 0, 0, -1, 0, 8192)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroPsychoDrive", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoDriveShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoDriveShot", 0, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroPsychoDriveShot", 15, 0, 0, 0)
    8K06 Q 6 A_TakeInventory("CrystrapRapidShotFlag")
    8K06 QPO 2
    goto ReadyX
  }
}

// A weapon psprite's GiveInventory calls are predicted, without inventory
// packets. A Pickup chain sends every chip to the owning client even when
// the server's phase transition advances past frames the client did not run.
actor MakeAGoodZeroPhase2Weapons_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W2")
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W3")
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W4")
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W5")
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W6")
    TNT1 A 0 A_GiveInventory("MakeAGoodZero_W7")
    stop
  }
}

actor MakeAGoodZeroGetUpDone_F : Once {}
actor MakeAGoodZeroPainFlag : Once {}
actor MakeAGoodZeroPhase3PainFlag : Once {}
actor MakeAGoodZeroPhase3Transition_F : Once {}

actor MakeAGoodZeroHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("MakeAGoodZeroPainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("MakeAGoodZeroPainFlag")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor MakeAGoodZeroHealthCheck2_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("MakeAGoodZeroPhase3Transition_F", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag2", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("MakeAGoodZeroPhase3PainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("MakeAGoodZeroPhase3PainFlag")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor MakeAGoodZeroFakeC : BasicClientSide {
  States {
   Spawn:
    8K06 H 8
    8K06 I 8 A_FadeOut(0.08)
    stop
  }
}
actor MGZeroChipAmmoCutter : Ammo {Inventory.MaxAmount 1200 +INVENTORY.IGNORESKILL}
actor MGZeroChipAmmoFlame : Ammo {Inventory.MaxAmount 1200 +INVENTORY.IGNORESKILL}
actor MGZeroChipAmmoIcicle : Ammo {Inventory.MaxAmount 1200 +INVENTORY.IGNORESKILL}
actor MGZeroChipAmmoZap : Ammo {Inventory.MaxAmount 1200 +INVENTORY.IGNORESKILL}
actor MGZeroChipAmmoPsycho : Ammo {Inventory.MaxAmount 1200 +INVENTORY.IGNORESKILL}
actor MGZeroChipAmmoWatcher : BasicWatcher {
  States {
   Spawn:
    // Boss-targeted: retire on unmorph (uh_IsLiveMorphedBossByPointer includes the
    // MorphedFlag test) instead of draining a demorphed survivor forever.
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("IsPissedFlag2", 1, "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroChipFlag", 5, "Psycho")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroChipFlag", 4, "Zap")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroChipFlag", 3, "Icicle")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroChipFlag", 2, "Flame")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroChipFlag", 1, "Cutter")
    TNT1 A 1
    loop
   Cutter:
    TNT1 A 1 A_TakeFromTarget("MGZeroChipAmmoCutter", 1, 1)
    goto Spawn
   Flame:
    TNT1 A 1 A_TakeFromTarget("MGZeroChipAmmoFlame", 1, 1)
    goto Spawn
   Icicle:
    TNT1 A 1 A_TakeFromTarget("MGZeroChipAmmoIcicle", 1, 1)
    goto Spawn
   Zap:
    TNT1 A 1 A_TakeFromTarget("MGZeroChipAmmoZap", 1, 1)
    goto Spawn
   Psycho:
    TNT1 A 1 A_TakeFromTarget("MGZeroChipAmmoPsycho", 1, 1)
    goto Spawn
  }
}
actor MGZeroChipFlag : Inventory {
  Inventory.MaxAmount 5
}

actor MakeAGoodZeroProjectile : BasicProjectile {
  DamageType "MGZero"
  Species "MGZero"
  +THRUSPECIES
}

actor MakeAGoodZeroShot : MakeAGoodZeroProjectile {
  Obituary "%o was bombed by \c[c4]Zero\c- (%k)'s Z-Buster."
  +FORCEXYBILLBOARD
  Damage (80)
  Radius 8
  Height 8
  Speed 27
  Scale 2.5
  States {
   Spawn:
    TNT1 A 2
    BASB A 1
    wait
   Death:
    TNT1 A 1
    stop
  }
}
actor MakeAGoodZeroCutterShot : MakeAGoodZeroShot {
  Translation "192:192=208:208", "198:198=210:210"
  +RIPPER
  Damage (20)
  Speed 52
  States {
   Spawn:
    TNT1 A 0
   SpawnL:
    8Q21 ABCDABCD 1 A_ChangeVelocity(-2, 0, 0, CVF_RELATIVE)
    // 8Q21 A 0 A_JumpIf(velx==0,"Return")
    // 8Q21 B 1 A_ChangeVelocity(-2,0,0,CVF_RELATIVE)
    // 8Q21 B 0 A_JumpIf(velx==0,"Return")
    // 8Q21 C 1 A_ChangeVelocity(-2,0,0,CVF_RELATIVE)
    // 8Q21 C 0 A_JumpIf(velx==0,"Return")
    // 8Q21 D 1 A_ChangeVelocity(-2,0,0,CVF_RELATIVE)
    // 8Q21 D 0 A_JumpIf(velx==0,"Return")
    // loop
   Return:
    8Q21 A 0 A_Stop
    8Q21 A 0 A_RearrangePointers(0, 0, 2)
    8Q21 A 0 A_FaceTarget
    goto ReturnL
   ReturnL:
    8Q21 A 1 A_SeekerMissile(9, 28, SMF_PRECISE)
    8Q21 A 0 A_JumpIfCloser(40, "Death")
    8Q21 B 1 A_SeekerMissile(9, 28, SMF_PRECISE)
    8Q21 B 0 A_JumpIfCloser(40, "Death")
    8Q21 C 1 A_SeekerMissile(9, 28, SMF_PRECISE)
    8Q21 C 0 A_JumpIfCloser(40, "Death")
    8Q21 D 1 A_SeekerMissile(9, 28, SMF_PRECISE)
    8Q21 D 0 A_JumpIfCloser(40, "Death")
    loop
   Death:
    TNT1 A 1
    stop
  }
}
actor MakeAGoodZeroFlameShot : MakeAGoodZeroShot {
  Translation "192:192=229:229", "198:198=41:41"
  +BRIGHT
  Radius 6
  Height 6
  Speed 48
  Scale 2.5
  States {
   Spawn:
    X_2G A 1 A_SpawnItemEx("MakeAGoodZeroFlameShotTrail", 0, 0, 2)
    X_2G B 1 A_SpawnItemEx("MakeAGoodZeroFlameShotTrail", 0, 0, -2)
    loop
   Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("OilPitIgnite", 0, 0, 4)
    stop
  }
}
actor MakeAGoodZeroFlameShotTrail : MakeAGoodZeroFlameShot {
  Translation "192:192=248:248", "198:198=222:222"
  Damage (20)
  Radius 2
  Height 2
  Scale 2.5
  States {
   Spawn:
    8Q21 EFGHI 2
   Death:
    TNT1 A 1 A_SpawnItemEx("OilPitIgnite", 0, 0, 4)
    stop
  }
}
actor MakeAGoodZeroIcicleShot : MakeAGoodZeroShot {
  Translation "192:192=208:208", "198:198=196:196", "202:202=208:208", "199:199=210:210"
  DamageType "MGZeroIcicle"

actor MGZeroCutterBurstShot : MGZeroBurstShot {
	Translation "192:192=86:86", "198:198=94:94"
	Damage (20)
	Speed 52
	States {
	 Spawn:
	  TNT1 A 0
	 SpawnL:
	  8Q21 V 1 A_ChangeVelocity(velx*0.90, vely*0.90, velz*0.90, CVF_REPLACE)
	  8Q21 V 0 A_JumpIf(CallACS("core_getspeed")<=10*65536, "Return")
	  loop
	 Return:
	  8Q21 V 0 A_Stop
	  8Q21 V 0 A_RearrangePointers(0, 0, 2)
	  8Q21 V 0 A_FaceTarget
	  goto ReturnL
	 ReturnL:
	  8Q21 V 1 A_SeekerMissile(9, 28, SMF_PRECISE)
	  8Q21 V 0 A_JumpIfCloser(40, "Death")
	  loop
	 Death:
	  TNT1 A 1
	  stop
	}
}

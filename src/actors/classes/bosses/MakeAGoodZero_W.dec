   Shield:
    8R21 G 1 A_Warp(2, 0, 0, 32, 0, 8 + 16)
    8R21 G 0 A_JumpIfInTargetInventory("MGZeroIcicleDriveShieldCheck", 1, 2) TNT1 A 0 A_Jump(256, "Death")
    8R21 H 1 A_Warp(2, 0, 0, 32, 0, 8 + 16)
    8R21 H 0 A_JumpIfInTargetInventory("MGZeroIcicleDriveShieldCheck", 1, 2) TNT1 A 0 A_Jump(256, "Death")
    8R21 I 1 A_Warp(2, 0, 0, 32, 0, 8 + 16)
    8R21 I 0 A_JumpIfInTargetInventory("MGZeroIcicleDriveShieldCheck", 1, 2) TNT1 A 0 A_Jump(256, "Death")

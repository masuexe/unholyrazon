// TODO: finish sprites at /sprites/classes/bosses/306MakeAGoodZero
//       a lot of them are placeholder

const int MGZERO_CUTTERSABER_RANGE = 24;
const int MGZERO_CUTTERSABER_SPEED = 10;

const int MGZERO_SABER_AMMOUSE = 100;
const int MGZERO_BURST_AMMOUSE = 200;

// Zero uses the standard two weapon-ammo bar slots.  The first slot follows
// weapon.ammotype; chip weapons override it with their own chip ammo below.
// Their second slot is UnholyPower3000, which is assigned through
// weapon.ammotype2 on the chip weapons.
actor MakeAGoodZero_W_NormalBar : NormalBar {args 228, 227}
actor MakeAGoodZero_W2_NormalBar : MakeAGoodZero_W_NormalBar {}
actor MakeAGoodZero_W3_NormalBar : NormalBar {args 87, 93}
actor MakeAGoodZero_W4_NormalBar : NormalBar {args 201, 219}
actor MakeAGoodZero_W5_NormalBar : NormalBar {args 215, 205}
actor MakeAGoodZero_W6_NormalBar : NormalBar {args 32, 229}
actor MakeAGoodZero_W7_NormalBar : NormalBar {args 108, 239}
actor MakeAGoodZero_W8_NormalBar : NormalBar {args 253, 208}

actor MakeAGoodZero_W3_SecondBar : SecondBar {args 213, 93}
actor MakeAGoodZero_W4_SecondBar : SecondBar {args 213, 219}
actor MakeAGoodZero_W5_SecondBar : SecondBar {args 213, 205}
actor MakeAGoodZero_W6_SecondBar : SecondBar {args 213, 229}
actor MakeAGoodZero_W7_SecondBar : SecondBar {args 213, 239}

// W1 has no Reload attack; each phase-two weapon uses its own Reload state.
actor MakeAGoodZero_W2_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W3_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W4_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W5_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W6_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W7_ReloadIcon : ReloadIcon {}
actor MakeAGoodZero_W8_ReloadIcon : ReloadIcon {}

actor MakeAGoodZero_W : BaseUnholyBossWep {
  Tag "$TAG_MakeAGoodZero_W"
  Obituary "%o was quickly defeated by \c[c4]Zero\c- (%k)."
  Inventory.Pickupmessage "You got a shit drawn in 3 minutes using mspaint"
  Weapon.AmmoType "UnholyPower3000"
  Inventory.Icon "B_I_306A"
  Weapon.SelectionOrder 3060
  States {
   Spawn:
    8K06 [ 1
    wait

   Deselect:
    8K06 I 0
    goto DeselectSwap
   Select:
    8K06 I 0
    goto SelectSwap

   Ready:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 1, "PhaseResume")
    8K06 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, MAKEAGOODZERO_DYE)
    8K06 A 0  // Initial setup: boss morph hook.
    8K06 A 0  // Initial setup: boss morph hook.
    8K06 A 0  // Initial setup: boss morph hook.
    8K06 A 0  // Initial setup: boss morph hook.
    8K06 A 0 A_GunFlash
    8K06 A 0  // Initial setup: boss morph hook.
    goto ReadyX

   ReadyX:
    8K06 A 0 A_JumpIfInventory("MakeAGoodZeroPainFlag", 1, "WhyWilyDiscardedMe")
    8K06 A 1 A_WeaponReady
    loop

   PhaseResume:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 28, "PhaseHold27")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 9, "PhaseHold8")
    TNT1 A 1
    goto PhaseResume

   WhyWilyDiscardedMe:
   PhaseFrame0:
    TNT1 A 0 A_WeaponReady(WRF_NOSWITCH | WRF_NOFIRE)
   PhaseFrame1:
    TNT1 A 0 A_SpawnItemEx("FakeDeathFX")
   PhaseFrame2:
    TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
   PhaseFrame3:
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
   PhaseFrame4:
    TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
   PhaseFrame5:
    TNT1 A 0 A_SetTranslucent(0.0, 0)
   PhaseFrame6:
    TNT1 A 0 ThrustThingZ(0, 120, 0, 0)
   PhaseFrame7:
    TNT1 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, -1, 0)
   PhaseFrame8:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 9)
   PhaseHold8:
    TNT1 A 200
   PhaseFrame9:
    8K06 E 0 A_ChangeFlag("THRUACTORS", 0)
   PhaseFrame10:
    8K06 E 0 A_ChangeFlag("INVULNERABLE", 0)
   PhaseFrame11:
    8K06 E 0 A_ChangeFlag("NOGRAVITY", 0)
   PhaseFrame12:
    8K06 E 0 SetPlayerProperty(0, 0, 3)
   PhaseFrame13:
    8K06 E 0 A_SetTranslucent(1.0, 0)
   PhaseFrame14:
    8K06 E 0 A_GiveInventory("IsPissedFlag")
   PhaseFrame15:
    8K06 E 0 A_GiveInventory("MGZeroChipAmmoCutter", 1200)
   PhaseFrame16:
    8K06 E 0 A_GiveInventory("MGZeroChipAmmoFlame", 1200)
   PhaseFrame17:
    8K06 E 0 A_GiveInventory("MGZeroChipAmmoIcicle", 1200)
   PhaseFrame18:
    8K06 E 0 A_GiveInventory("MGZeroChipAmmoZap", 1200)
   PhaseFrame19:
    8K06 E 0 A_GiveInventory("MGZeroChipAmmoPsycho", 1200)
   PhaseFrame20:
    8K06 E 0 A_SpawnItemEx("MGZeroChipAmmoWatcher", 1)
   PhaseFrame21:
    8K06 E 0 A_GiveInventory("UnholyPower3000", 1500)
    // This must complete before W2's Flash health poll can run.  The
    // phase-health script has no delay, so the result form executes it
    // synchronously; ACS_NamedExecuteAlways would leave it queued for a
    // later tic and W2 could see the transition HP of 1 first.
   PhaseFrame22:
    8K06 E 0 ACS_NamedExecuteWithResult("uh_BossPhaseHealth", 2020, 626)
   PhaseFrame23:
    8K06 E 0 A_GiveInventory("UnholyPowerLimit_F", 3000)
   PhaseFrame24:
    8K06 E 0 ACS_NamedExecuteAlways("ub_RageDisplay", 0)
   PhaseFrame25:
    8K06 E 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, ELP_NATIVE)
   PhaseFrame26:
    8K06 E 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, 306, 0)
   PhaseFrame27:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 28)
   PhaseHold27:
    8K06 E 1
   PhaseFrame28:
    8K06 E 0 A_GiveInventory("MakeAGoodZeroPhase2Weapons_P")
   PhaseFrame34:
    8K06 E 0 A_TakeInventory("MakeAGoodZeroPainFlag")
   PhaseFrame35:
    8K06 E 0 A_GiveInventory("MakeAGoodZeroGetUpDone_F")
    // The transition state disabled switching.  Re-enable weapon switching
    // without allowing an attack before requesting W2.
   PhaseFrame36:
    8K06 E 0 A_WeaponReady(WRF_NOFIRE)
   PhaseFrame37:
    8K06 E 0 A_SelectWeapon("MakeAGoodZero_W2")
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    stop

   Flash:
    // Phase 1 only polls for the first phase transition.  The HP drain is
    // intentionally not active until the phase-3 weapon (MakeAGoodZero_W8).
    TNT1 A 0 A_GiveInventory("MakeAGoodZeroHealthCheck_P")
    TNT1 A 1
    loop

   Fire:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroSaber", 1)
    8K06 J 1 A_FireCustomMissile("MGZeroSaber0", -50, 0, 16, 0, 0, 20)
    8K06 K 1 A_FireCustomMissile("MGZeroSaber0", -25, 0, 8, 0, 0, 10)
    8K06 L 1 A_FireCustomMissile("MGZeroSaber0", 0, 0, 0, 0, 0, 0)
    8K06 M 1 A_FireCustomMissile("MGZeroSaber0", 25, 0, -8, 0, 0, -5)
    8K06 N 1 A_FireCustomMissile("MGZeroSaber0", 50, 0, -16, 0, 0, -10)
    TNT1 A 14
    8K06 HI 2
    8K06 A 10
    goto ReadyX

   AltFire:
    TNT1 A 0
    goto ReadyX
  }
}

actor MakeAGoodZero_W2 : BaseUnholyBossWep {
  Tag "$TAG_MakeAGoodZero_W2"
  Obituary "%o was quickly defeated by \c[c4]Zero\c- (%k)."
  Inventory.Pickupmessage "You got a shit drawn in 3 minutes using mspaint"
  Weapon.AmmoType "UnholyPower3000"
  Inventory.Icon "B_I_306A"
  Weapon.SelectionOrder 3061
  States {
   Spawn:
    8K06 [ 1
    wait
   Deselect:
    8K06 I 0
    goto DeselectSwap
   Select:
    8K06 I 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MAKEAGOODZERO_DYE, CLRF_SILENT)
    TNT1 A 0 A_TakeInventory("MGZeroChipFlag")
    TNT1 A 0 ACS_NamedExecuteAlways("rz_setactorproperty", 0, APROP_Speed, 1, 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_setactorproperty", 0, APROP_Gravity, 1, 1)
    goto SelectSwap

   Ready:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 1, "PhaseResume")
    // The W1 -> W2 switch has completed, so the obsolete phase-1 weapon can
    // now be removed without taking away the weapon driving the transition.
    8K06 O 0 A_TakeInventory("MakeAGoodZero_W")
    8K06 O 0 A_GiveInventory("UnholyPower3000", 1)
    8K06 O 0 A_GunFlash("Flash", true)
    goto ReadyX
   ReadyX:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 1, "PhaseResume")
    8K06 O 0 A_JumpIfInventory("MakeAGoodZeroPhase3Transition_F", 1, "Phase3WeaponSwap")
    8K06 O 0 A_JumpIfInventory("MakeAGoodZeroPhase3PainFlag", 1, "ThePowerToDefeatMegaman")
    8K06 O 0 A_GiveInventory("UnholyPower3000", 1)
    8K06 O 2 A_WeaponReady(16)
    loop

   PhaseResume:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 13, "PhaseHold12")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 5, "PhaseHold4")
    TNT1 A 1
    goto PhaseResume

   ThePowerToDefeatMegaman:
    // Consume the trigger before the long transition.  The guard makes the
    // operation one-shot even if a weapon event interrupts the state.
   PhaseFrame0:
    8K06 A 0 A_GiveInventory("MakeAGoodZeroPhase3Transition_F")
   PhaseFrame1:
    8K06 A 0 A_TakeInventory("MakeAGoodZeroPhase3PainFlag")
   PhaseFrame2:
    8I04 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
   PhaseFrame3:
    8K06 E 0 ACS_NamedExecuteWithResult("core_chargecolor", WHITECOLOR)
   PhaseFrame4:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 5)
   PhaseHold4:
    TNT1 A 200
   PhaseFrame5:
    8K06 A 0 A_TakeInventory("IsPissedFlag")
   PhaseFrame6:
    8K06 A 0 A_GiveInventory("IsPissedFlag2")
   PhaseFrame7:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 10000)
   PhaseFrame8:
    8K06 I 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, ELP_NATIVE)
   PhaseFrame9:
    8K06 I 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, 306, 1)
   PhaseFrame10:
    8K06 E 0 ACS_NamedExecuteWithResult("core_chargecolor", MAKEAGOODZERO_PISSED_DYE)
    // core_invulnerableplayer(false) only removes one stack.  Clear any stale
    // layers left by an interrupted transition before entering phase 3.
   PhaseFrame11:
    8I04 A 0 ACS_NamedExecuteWithResult("uh_StripInvulnStacks", 0)
   PhaseFrame12:
    8K06 E 0 A_GunFlash
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 13)
   PhaseHold12:
    8K06 E 1
   PhaseFrame13:
    8K06 A 0 A_GiveInventory("MakeAGoodZero_W8")
   PhaseFrame14:
    8K06 A 0 A_WeaponReady(WRF_NOFIRE)
   PhaseFrame15:
    8K06 A 0 A_SelectWeapon("MakeAGoodZero_W8")
   PhaseFrame16:
    TNT1 A 0
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    stop

   Phase3WeaponSwap:
    // Idempotent recovery if the old transition was interrupted after setting
    // its guard.  This also repairs color/invulnerability from that attempt.
    8K06 A 0 A_TakeInventory("MakeAGoodZeroPhase3PainFlag")
    8K06 A 0 A_TakeInventory("IsPissedFlag")
    8K06 A 0 A_GiveInventory("IsPissedFlag2")
    8K06 E 0 ACS_NamedExecuteWithResult("core_chargecolor", MAKEAGOODZERO_PISSED_DYE)
    8I04 A 0 ACS_NamedExecuteWithResult("uh_StripInvulnStacks", 0)
    8K06 A 0 A_GiveInventory("MakeAGoodZero_W8")
    8K06 A 0 A_WeaponReady(WRF_NOFIRE)
    8K06 A 0 A_SelectWeapon("MakeAGoodZero_W8")
    TNT1 A 0
    stop

   Flash:
    // Phase 2 keeps the health poll so it can enter phase 3, but does not
    // inherit the phase-3 HP drain.
    TNT1 A 0 A_GiveInventory("MakeAGoodZeroHealthCheck2_P")
    TNT1 A 1
    loop

   Fire:
    8K06 O 0 A_GiveInventory("CrystrapRapidShotFlag")
    8K06 OP 2
   Fire.a:
    8K06 Q 2 A_WeaponReady(6)
    8K06 A 0 A_PlaySoundEx("misc/mm3explosion", 1)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroShot", 0, 0, 0, 0)
    8K06 Q 6 A_WeaponReady(6)
    8K06 Q 0 A_ReFire("Fire.b")
    8K06 QP 2
    8K06 O 2 A_TakeInventory("CrystrapRapidShotFlag")
    goto ReadyX
   Fire.b:
    TNT1 A 0
    goto Fire.a

   AltFire:
    8K06 A 0 A_JumpIfInventory("UnholyPower3000", 10, 1)
    goto ReadyX
    8K06 O 0 A_JumpIfInventory("UnholyPower3000", 3000, 1)
    goto Altfire.a
    8K06 A 0 A_JumpIfInventory("CrystrapRapidShotFlag", 1, "Drive")
   Altfire.a:
    8K06 A 0 A_TakeInventory("UnholyPower3000", MGZERO_SABER_AMMOUSE, 1)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroSaber", 1)
    8K06 J 1 A_FireCustomMissile("MGZeroSaber1", -50, 0, 16, 0, 0, 20)
    8K06 K 1 A_FireCustomMissile("MGZeroSaber1", -25, 0, 8, 0, 0, 10)
    8K06 L 1 A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 0, 0, 0)
    8K06 M 1 A_FireCustomMissile("MGZeroSaber1", 25, 0, -8, 0, 0, -5)
    8K06 N 1 A_FireCustomMissile("MGZeroSaber1", 50, 0, -16, 0, 0, -10)
    TNT1 A 4
    8K06 G 0 A_JumpIf(!CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 G 0 A_ReFire("Altfire.b")
    goto AltFireEnd
   Altfire.b:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroSaber", 1)
    8K06 C 1 A_FireCustomMissile("MGZeroSaber1", 50, 0, -16, 0, 0, -10)
    8K06 D 1 A_FireCustomMissile("MGZeroSaber1", 25, 0, -8, 0, 0, -5)
    8K06 E 1 A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 0, 0, 0)
    8K06 F 1 A_FireCustomMissile("MGZeroSaber1", -25, 0, 8, 0, 0, 10)
    8K06 G 1 A_FireCustomMissile("MGZeroSaber1", -50, 0, 16, 0, 0, 20)
    TNT1 A 4
    8K06 G 0 A_ReFire("Altfire.c")
    goto AltFireEnd
   Altfire.c:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroSaber", 1)
    8K06 K 1 Offset(-8, 22) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 30, 0, 0)
    8K06 K 1 Offset(-18, 52) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 20, 0, 0)
    8K06 M 1 Offset(110, 47) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 10, 0, 0)
    8K06 M 1 Offset(100, 77) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, 0, 0, 0)
    8K06 N 1 Offset(160, 49) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, -10, 0, 0)
    8K06 N 1 Offset(150, 79) A_FireCustomMissile("MGZeroSaber1", 0, 0, 0, -20, 0, 0)
    8K06 N 0 A_WeaponReady(14)
   AltFireEnd:
    TNT1 A 6
    8K06 HI 2
    8K06 A 2
    goto ReadyX

   Reload:
    8K06 A 0 A_TakeInventory("UnholyPower3000", MGZERO_BURST_AMMOUSE, 1)
    8K06 OPQ 2
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroBurst", 1)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -15, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", -5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", 5, 0, 0, 0)
    8K06 A 0 A_FireCustomMissile("MGZeroBurstShot", 15, 0, 0, 0)
    8K06 Q 6
    8K06 QPO 2
    goto ReadyX

   Drive:
    // 8K06 A 0 ThrustThingZ(0,10,0,0)
    // "----" "#" 1 Offset(0,32)
    8K06 O 0 A_TakeInventory("UnholyPower3000")
    8K06 O 1 Offset(0, 44)
    8K06 O 1 Offset(0, 56)
    8K06 O 1 Offset(0, 68)
    8K06 O 1 Offset(0, 80)
    8K06 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroGigaCrushStart", 1)
    8K06 A 0 A_SpawnItemEx("MGZeroGigaCrushStartFX", 0, 0, 52)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 1 A_Stop
    TNT1 A 0 A_PlaySound("MaGMML/ZeroGigaCrush", 0, 1.0, 0, ATTN_NONE)
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 AAAAAAAAAAAA 1 A_GiveInventory("MGZeroGigaCrush_P")
    TNT1 AAAAAAAAAAAA 1 A_Stop
    8K06 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8K06 A 0 A_TakeInventory("VivifyFlag1")
    8K06 O 0 A_TakeInventory("CrystrapRapidShotFlag")
    8K06 O 1 Offset(0, 80)
    8K06 O 1 Offset(0, 68)
    8K06 O 1 Offset(0, 56)
    8K06 O 1 Offset(0, 44)
    // 8K06 O 1 Offset(0,32)
    goto ReadyX
  }
}

actor MakeAGoodZero_W3 : MakeAGoodZero_W2 {
  Tag "$TAG_MakeAGoodZero_W3"
  Weapon.AmmoType2 "MGZeroChipAmmoCutter"
  Inventory.Icon "B_I_306B"
  Weapon.SelectionOrder 3062
  States {
   Select:
    8K06 I 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MAKEAGOODZERO_CUTTER_DYE, CLRF_SILENT)
    TNT1 A 0 A_TakeInventory("MGZeroChipFlag")
    TNT1 A 0 A_GiveInventory("MGZeroChipFlag", 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_setactorproperty", 0, APROP_Speed, 1, 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_setactorproperty", 0, APROP_Gravity, 1, 1)
    goto SelectSwap

   Fire:
    8K06 O 0 A_JumpIfInventory("MGZeroChipAmmoCutter", 1, 1)
    goto ReadyX
    8K06 O 0 A_GiveInventory("CrystrapRapidShotFlag")
    8K06 OP 2
   Fire.a:
    8K06 Q 2 A_WeaponReady(6)
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterBuster", 1)
    8K06 A 0 A_FireCustomMissile("MakeAGoodZeroCutterShot", 0, 0, 0, 0)
    8K06 Q 6 A_WeaponReady(6)
    8K06 Q 0 A_ReFire("Fire.b")
    8K06 QP 2
    8K06 O 2 A_TakeInventory("CrystrapRapidShotFlag")
    goto ReadyX
   Fire.b:
    8K06 O 0 A_JumpIfInventory("MGZeroChipAmmoCutter", 1, 1)
    goto ReadyX
    TNT1 A 0
    goto Fire.a

   AltFire:
    8K06 O 0 A_JumpIfInventory("MGZeroChipAmmoCutter", 1, 1)
    goto ReadyX
    8K06 A 0 A_TakeInventory("UnholyPower3000", MGZERO_SABER_AMMOUSE, 1)
    8K06 A 0 A_JumpIfInventory("CrystrapRapidShotFlag", 1, "Drive")
    8K06 G 0 A_JumpIf(!CallACS("core_CheckFooting"), "AltFire.Air")
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 J 1 A_FireCustomMissile("MGZeroCutterSaber", -50, 0, 16, 0, 0, 20)
    8K06 K 1 A_FireCustomMissile("MGZeroCutterSaber", -25, 0, 8, 0, 0, 10)
    8K06 L 1 A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 0, 0, 0)
    8K06 M 1 A_FireCustomMissile("MGZeroCutterSaber", 25, 0, -8, 0, 0, -5)
    8K06 N 1 A_FireCustomMissile("MGZeroCutterSaber", 50, 0, -16, 0, 0, -10)
    TNT1 A 2
    8K06 G 0 A_ReFire("Altfire.b")
    goto AltFireEnd
   Altfire.b:
    8I20 O 0 A_JumpIfInventory("MGZeroChipAmmoCutter", 1, 1)
    goto ReadyX
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 C 1 A_FireCustomMissile("MGZeroCutterSaber", 50, 0, -16, 0, 0, -10)
    8K06 D 1 A_FireCustomMissile("MGZeroCutterSaber", 25, 0, -8, 0, 0, -5)
    8K06 E 1 A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 0, 0, 0)
    8K06 F 1 A_FireCustomMissile("MGZeroCutterSaber", -25, 0, 8, 0, 0, 10)
    8K06 G 1 A_FireCustomMissile("MGZeroCutterSaber", -50, 0, 16, 0, 0, 20)
    TNT1 A 2
    8K06 G 0 A_ReFire("Altfire.c")
    goto AltFireEnd
   Altfire.c:
    8I20 O 0 A_JumpIfInventory("MGZeroChipAmmoCutter", 1, 1)
    goto ReadyX
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 K 1 Offset(-8, 22) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 30, 0, 0)
    8K06 K 1 Offset(-18, 52) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 20, 0, 0)
    8K06 M 1 Offset(110, 47) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 10, 0, 0)
    8K06 M 1 Offset(100, 77) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, 0, 0, 0)
    8K06 N 1 Offset(160, 49) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, -10, 0, 0)
    8K06 N 1 Offset(150, 79) A_FireCustomMissile("MGZeroCutterSaber", 0, 0, 0, -20, 0, 0)
    8K06 N 0 A_WeaponReady(14)
    goto AltFireEnd
   AltFire.Air:
    8K06 A 0 A_PlaySoundEx("MaGMML/ZeroCutterSaber", 1)
    8K06 M 1 Offset(100, 77) A_SpawnItemEx("MGZeroCutterSaberAir", MGZERO_CUTTERSABER_RANGE * sqrt(2), 0, 0 + 32, MGZERO_CUTTERSABER_SPEED * sqrt(2), 0, 0)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 N 1 Offset(160, 49) A_SpawnItemEx("MGZeroCutterSaberAir", MGZERO_CUTTERSABER_RANGE, 0, -MGZERO_CUTTERSABER_RANGE + 32, MGZERO_CUTTERSABER_SPEED, 0, -MGZERO_CUTTERSABER_SPEED)
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")
    8K06 N 1 Offset(150, 79) A_SpawnItemEx("MGZeroCutterSaberAir", 0, 0, -MGZERO_CUTTERSABER_RANGE * sqrt(2) + 32, 0, 0, -MGZERO_CUTTERSABER_SPEED * sqrt(2))
    8K06 M 0 A_JumpIf(CallACS("core_CheckFooting"), "AltFireEnd")

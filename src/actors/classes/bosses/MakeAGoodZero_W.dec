actor MGZeroIcicleDriveWatcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("InvulnerableOn_Pickup", 1)
   SpawnL:
    // uh_IsLiveMorphedBossByPointer also fails once the target is no longer morphed, so a
    // shadow unmorph takes the Death path and returns the extra invuln layer
    // instead of keeping the demorphed survivor invulnerable forever.
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("MGZeroIcicleDriveShieldCheck", 1, 2) TNT1 A 0 A_Jump(256, "Death")
    TNT1 A 0 A_GiveToTarget("MGZeroIcicleDriveGuard_P")
    TNT1 A 0 A_JumpIfInTargetInventory("IsUnderWater", 1, "FloatMe")
    TNT1 A 1
    loop
   FloatMe:
    TNT1 A 1 A_GiveToTarget("MGZeroIcicleDriveWaterThrust_P")
    goto Spawn
   Death:
    TNT1 A 0 A_GiveToTarget("InvulnerableOff_Pickup", 1)
    stop
  }
}

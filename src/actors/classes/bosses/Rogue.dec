actor Rogue : BossBase {
  Player.ScoreIcon "UB107MUG"
  Player.SoundClass "Rogue"
  Player.DamageScreenColor "yellow"
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.3, 1.3
  Player.JumpZ 15
  Player.MaxHealth 2750
  Health 2750
  Player.MorphWeapon "Rogue_W"
  States {
   Spawn:
    8B07 A 0
    8B07 B 1
    8B07 A 1
    goto Spawn+2
   See:
    8B07 BCDE 5
    goto Spawn
   Missile:
    8B07 K 0 A_JumpIfInventory("VivifyDelay6", 1, "MissileR")
    8B07 K 0 A_JumpIfInventory("IsPissedFlag", 1, "MissileSword")
    8B07 K 0 A_JumpIfInventory("VivifyDelay9", 1, "Missile1")
    8B07 K 0 A_JumpIfInventory("VivifyFlag1", 1, 2)
    8B07 KL 4
    goto Spawn
   Missile1:
    8B07 K 20
    8B07 L 4
    goto Spawn
   MissileSword:
    8B07 I 0 A_JumpIfInventory("VivifyDelay9", 1, "MissileSwordAlt")
    8B07 I 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileSwordTriple")
    8B07 I 5
    8B07 J 4
    goto Spawn
   MissileSwordAlt:
    8B07 K 12
    8B07 KKKKKKKKKKKK 1 A_JumpIfInventory("VivifyDelay5", 1, "MissileSwordAlt2")
    goto MissileSwordAlt2
   MissileSwordAlt2:
    8B07 L 6
    goto Spawn
   MissileSwordTriple:
    8B07 IJIJ 3
    8B07 I 2
    8B07 I 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileSwordTriple2")
    wait
   MissileSwordTriple2:
    8B07 J 7
    goto Spawn
   MissileR:
    8B07 F 15
    8B07 G 6
    8B07 G 1 A_JumpIfInventory("VivifyDelay6", 1, "MissileR2")
    wait
   MissileR2:
    8B07 G 5
    goto Spawn

   ClassPain:
    8B07 H 0 A_GiveInventory("RogueShieldWasHit")
    goto MegamanPain
   ClassDeath:
    8B07 H 0 A_TakeInventory("RogueShieldWarper_F")
    goto MegamanDeath
   MegamanDeath0:
    8B07 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8B07 H 3
    8B07 HHHHHHHHH 8 A_SpawnItemEx("RogueCD_FX", random(14, 48), random(-10, 10), random(24, 48), 0, 0, 0, random(0, 35) * 10, 0)
    8B07 H 4 A_ChangeFlag("NOGRAVITY", 1)
    8B07 H 0 A_ChangeVelocity(0, 0, 5, 2)
   MegamanDeathLoop:
    8B07 H 0 A_GiveInventory("DeathFadeOutFlag")
    8B07 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8B07 H 0 A_FadeOut(0.125, 0)
    8B08 H 0 A_JumpIfInventory("DeathFadeOutFlag", 8, "MegamanErase")
    loop
  }
}

actor RogueCD_FX : BasicGraphicEffect {
  Translation "192:192=58:58", "198:198=249:249"
  // Translation "192:192=0:0", "198:198=4:4"
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("MMSF3/Explode", 1, 0.75)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor RogueCDeathFX : FakeUnholyDeathFX {
  Translation "192:192=58:58", "198:198=249:249"
}

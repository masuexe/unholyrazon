X_0D A 1 A_SpawnItemEx("KachidongaCannonShotX2",0,0,0,0,0,0,0,1)
wait
Death:
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
TNT1 A 0 A_Explode(825,400,0)
X_1D BCDEFGHIJKLMN 1
stop
}
}


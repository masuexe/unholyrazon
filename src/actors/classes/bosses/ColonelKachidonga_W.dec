actor KangoCannonMode : UOnce {}

actor KangoHowitzerMode : UOnce {}

actor KangoLaserMode : UOnce {}

actor KangoFireFlag : UOnce {}


actor KachidongaCannonShot : BasicProjectile
{
-NOGRAVITY
damagetype "Kachidonga"
Obituary "%o was blown up by \cmColonel \cgKachidonga\c- (%k)'s Kangogias-Cannon."
Translation "198:198=5:5","192:192=4:4"
gravity 1.5
Speed 80
Damage (125)
radius 20
height 20
scale 5
States
{
Spawn:
X_0D A 0
X_0D A 0 ThrustThingZ(0,30,0,1)//120
X_0D A 1
wait
Death:
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
TNT1 A 0 A_Explode(375,200,0)
X_1D BCDEFGHIJKLMN 1
stop
}
}

actor KachidongaCannonShotX : KachidongaCannonShot
{
+RIPPER
+DONTBLAST
Obituary "%o was in range of \cmColonel \cgKachidonga\c- (%k)'s Charged Kangogias-Cannon."

actor ColonelKachidonga_W_ScriptBar : ScriptBar {}

actor ColonelKachidonga_W : BaseUnholyBossWep
{
Tag "$TAG_Boss004_W"
Obituary "%o was blown up by \cmColonel \cgKachidonga\c- (%k)'s Kangogias-Cannon."
Inventory.Pickupmessage "\cgEnvy."
weapon.ammotype "UnholyBossAmmo400"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H04 [ 1
wait

Ready:
8H04 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H04 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, COLONELKACHIDONGA_DYE)
8H04 A 0 //A_GunFlash
goto ReadyX
ReadyX:
8H04 A 0 A_JumpIfInventory("UnholyBossAmmo400",400,"ReadyXReload")
8H04 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyXReload")
8H04 A 2 A_WeaponReady
goto ReadyXGive
ReadyXReload:
8H04 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
ReadyXGive:
8H04 A 0 A_GiveInventory("UnholyBossAmmo400",2)
goto ReadyX

Flash:
TNT1 A 4 A_GiveInventory("UnholyBossAmmo400",1)
loop

Fire:
8H04 A 0
8H04 A 0 A_JumpIfInventory("UnholyPower1500",1500,"PowerKangoCannonism")
8H04 BCCC 2 A_GiveInventory("UnholyBossAmmo400",1)//BC 2|C 4
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*22,0,sin(pitch)*13,CVF_RELATIVE)//A_Recoil(20)
8H04 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H04 C 0 A_FireCustomMissile("KachidongaCannonShot",0,0,8,0)
8H04 BBBBBBBBBBBAA 2 A_GiveInventory("UnholyBossAmmo400",1)//B 2|A 24
Goto ReadyX

PowerKangoCannonism:
8H04 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H04 A 0 A_GiveInventory("KangoFireFlag",1)
8H04 A 0 A_TakeInventory("UnholyPower1500", 1500)
8H04 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H04 BCCCCCCCCCCCCCCCCCCCCCCCCC 2 A_GiveInventory("UnholyBossAmmo400",1)//BC 2|C 48
8H04 C 0 A_TakeInventory("UnholyPowerDazzle_F")
8H04 C 0 A_TakeInventory("KangoFireFlag")
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*30,0,sin(pitch)*17,CVF_RELATIVE)//A_Recoil(35)
8H04 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H04 C 0 A_FireCustomMissile("KachidongaCannonShotX",0,0,8,0)
8H04 BBBBBBBBBBBBBBBBBBBBBBBAA 2 A_GiveInventory("UnholyBossAmmo400",1)//B 2|A 48
Goto ReadyX

AltFire:
8H04 A 0

8H04 A 0 A_JumpIfInventory("UnholyPower1500",1500,"PowerKangoHowitzerism")
8H04 BCCC 2 A_GiveInventory("UnholyBossAmmo400",1)//BC 2|C 8
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*54,0,sin(pitch)*40,CVF_RELATIVE)//A_Recoil(50)
8H04 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H04 CCCCCCCCCCCCCCCCCCCC 0 A_FireCustomMissile("KachidongaBlunderShot",random(-10,10),0,8,0,0,random(-5,5))
8H04 BBBBBBBBBBBBBBBBBBBAA 2 A_GiveInventory("UnholyBossAmmo400",1)//BA 2|A 40
Goto ReadyX
PowerKangoHowitzerism:
8H04 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H04 A 0 A_GiveInventory("KangoFireFlag",1)
8H04 A 0 A_TakeInventory("UnholyPower1500", 1500)
8H04 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H04 BCCCCCCCCCCCCCCCCCCCCCCCCC 2 A_GiveInventory("UnholyBossAmmo400",1)//BC 2|C 48
8H04 C 0 A_TakeInventory("UnholyPowerDazzle_F")
8H04 C 0 A_TakeInventory("KangoFireFlag")
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*65,0,sin(pitch)*50,CVF_RELATIVE)//A_Recoil(75)
8H04 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H04 CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_FireCustomMissile("KachidongaBlunderShotX",random(-10,10),0,8,0,0,random(-5,5))
8H04 BBBBBBBBBBBBBBBBBBBAA 2 A_GiveInventory("UnholyBossAmmo400",1)//BA 2|A 40
Goto ReadyX

Reload:
KangoLaserism:
8H04 A 0 A_GiveInventory("KangoFireFlag",1)
8H04 A 0 A_JumpIfInventory("UnholyPower1500",1500,"PowerKangoLaserism")
8H04 A 0 A_TakeInventory("UnholyBossAmmo400")
8H04 BC 2
8H04 C 4 A_TakeInventory("KangoFireFlag")
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*30, 0, sin(pitch)*17,CVF_RELATIVE)//A_Recoil(35)
8H04 C 0 A_PlaySoundEx("weapon/lshot","Weapon")
8H04 C 0 A_FireCustomMissile("KachidongaLaser",0,0,8,0)
8H04 CB 2
8H04 B 26
8H04 A 4
Goto ReadyX
PowerKangoLaserism:
8H04 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H04 A 0 A_TakeInventory("UnholyPower1500", 1500)
8H04 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H04 BC 2
8H04 C 44
8H04 C 4 A_TakeInventory("KangoFireFlag")
8H04 C 0 A_TakeInventory("UnholyPowerDazzle_F")
8H04 C 0 A_ChangeVelocity(-Cos(pitch)*54,0,sin(pitch)*42,CVF_RELATIVE)//A_Recoil(50)
8H04 C 0 A_PlaySoundEx("weapon/lshot","Weapon")
8H04 C 0 A_FireCustomMissile("KachidongaLaserX",0,0,8,0)
8H04 B 26
8H04 A 4
Goto ReadyX
}
}


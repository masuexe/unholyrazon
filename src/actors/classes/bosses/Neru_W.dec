// I NEED SOMETHING THAT FEELS LIKE ACTUAL BULLETS
actor Neru_SMG_Bullet : BasicFastProjectile {
  var int user_R;  // age //10 damage increment
  var int user_W;  // rath //25 damage increment
  Translation "192:192=208:208", "198:198=229:229"  // "192:192=214:214","198:198=229:229"
  damagetype "Neru"
  Obituary "STOP BULLSHITTING"  // - Rough Translation of Neru's EX skill //Placeholder
  +SKYEXPLODE
  +DONTBLAST
  +BLOODLESSIMPACT
  +THRUGHOST  // Rage being 10 per stack is too much and so is Wrath being 25
  damage (50+user_R*5+user_W*15)  // Previous R*10 | W*25
  radius 14
  height 14
  speed 150
  Scale 4.0  // 2.5 //
  Args 1  // I DONT GET THIS
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_R", CallACS("neru_countinv_acs", 1, 2)+0)  // +1
    TNT1 A 0 A_SetUserVar("user_W", CallACS("neru_countinv_acs", 2, 2)+0)  // +1
    6P54 A 2
    6P54 A 0 A_Jump(256, 1, 5, 9, 13, 17, 21)
   SpawnL:
    6P54 AAA 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 A 1 A_GiveInventory("Neru_SMG_Trail_P")
    6P54 AAA 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 A 1 A_GiveInventory("Neru_SMG_Trail_P")
    6P54 AAA 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 A 1 A_GiveInventory("Neru_SMG_Trail_P")
    6P54 BBB 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 B 1 A_GiveInventory("Neru_SMG_Trail_P")
    6P54 BBB 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 B 1 A_GiveInventory("Neru_SMG_Trail_P")
    6P54 BBB 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    6P54 B 1 A_GiveInventory("Neru_SMG_Trail_P")
    loop
    //
   DeathFix2:  // If actor hit double bonus damage
    TNT1 A 0 A_SetArg(0, 2)
   DeathFix:  // Fixes damage not being set if Projectile dies Tic 0
    TNT1 A 0 A_SetUserVar("user_R", CallACS("neru_countinv_acs", 1, 2)*Args[0]+0)  // +1
    TNT1 A 0 A_SetUserVar("user_W", CallACS("neru_countinv_acs", 2, 2)*Args[0]+0)  // +1
    goto Death+2
    //
    //
   XDeathFix2:  // If actor hit double bonus damage
    TNT1 A 0 A_SetArg(0, 2)
   XDeathFix:  // Fixes damage not being set if Projectile dies Tic 0
    TNT1 A 0 A_SetUserVar("user_R", CallACS("neru_countinv_acs", 1, 2)*Args[0]+0)  // +1
    TNT1 A 0 A_SetUserVar("user_W", CallACS("neru_countinv_acs", 2, 2)*Args[0]+0)  // +1
    goto XDeath+2
    //
   XDeath:
    TNT1 A 0 A_JumpIf(user_R==0, "XDeathFix2")
    TNT1 A 0 A_JumpIf(user_W==0, "XDeathFix2")
    TNT1 A 1
    TNT1 A 1 A_SpawnItemEx("Neru_SMG_Hit_FX_2", 0, 0, 0, 0, 0, 0, 0, 1+32)
    stop
   Death:
    TNT1 A 0 A_JumpIf(user_R==0, "DeathFix2")
    TNT1 A 0 A_JumpIf(user_W==0, "DeathFix2")
    TNT1 A 1
    TNT1 A 1 A_SpawnItemEx("Neru_SMG_Hit_FX", 0, 0, 0, 0, 0, 0, 0, 1+32)  // 2
    stop
  }
}

actor Neru_SMG_Trail_P : CustomInventory {
  States {
   Pickup:
    TNT1 AAA 0 A_SpawnItemEx("Neru_SMG_Bullet_FX", frandom(-12, -0), frandom(-7.5, 7.5), frandom(-7.5, 7.5), momx*-0.2, momy*-0.2, momz*-0.2, 0, 1+8, Args[2])
    TNT1 A 0 A_JumpIf(Args[0]>=Args[1], 2)
    TNT1 A 0 A_SetArg(0, Args[0]+1)
    TNT1 A 0
    stop
  }
}


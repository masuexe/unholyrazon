// Fun!
actor Sukajan : OnceX {}  // Specific flag to let something know it's Neru.
// It's a jacket by the way.

actor Neru_W : BaseUnholyBossWep {
  Weapon.AmmoUse 10  // 1 //2 if 70.
  Weapon.AmmoGive 350  // 35 x 2 = 70
  Inventory.Pickupmessage "\ccThe two submachine guns used by \crNeru\cc. Both are engraved with a beautiful pattern of golden dragons."  // Actual description of the weapon.
  Obituary "%k did not like %o, at all."  // Something something die.
  Tag "Twin Dragon"
  weapon.ammotype "MillenniumAmmo"
  weapon.ammotype2 "MikAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:  // Note: use dual wielding gun sprites from whatever.
    6H16 [ 6
    loop

   Deselect:
    6H16 A 0  // A_TakeInventory("HeavyGunnerFlag")
    goto DeselectSwap
   Select:
    6H16 A 0  // A_TakeInventory("HeavyGunnerFlag")
    goto SelectSwap

   Ready:
    // 6H16 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BUSTEREXPERT_DYE)
    //
    6H16 A 0 A_GiveInventory("MillenniumAmmo", 350)
    6H16 A 0 A_GiveInventory("MikAmmo", 180)
    //
    6H16 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)  // 1000
    6H16 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
    6H16 A 0 A_SpawnItemEx("Neru_Rage_Count_Watcher")  //
    6H16 A 0 A_SpawnItemEx("Neru_Wrath_Count_Watcher")  //
    6H16 A 0 A_GiveInventory("UnholyPower1500", 500)  // Starting Gun
    6H16 A 0 A_GiveInventory("WallJumpLimit", 2)
    6H16 A 0 A_GunFlash("Flash", 1)
    Goto Ready2
   Ready2:
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 0, "Ready3")
    6H16 A 0 A_JumpIfNoAmmo("ReloadWait")
    Goto ReloadCheck
   Ready3:
    6H16 A 2 A_GiveInventory("Neru_W_Ready_P")
    wait


   ReloadTime:
    6H16 A 0 A_PlaySound("V_Man/Snd54", 1, 0.50)
    6H16 NOPQ 2 A_GiveInventory("Neru_W_Ready_P")
    TNT1 AAAA 2 A_GiveInventory("Neru_W_Ready_P")
    6H16 QPON 2 A_GiveInventory("Neru_W_Ready_P")
    6H16 A 0 A_PlaySoundEx("V_Man/HP_Pick", "Body")
    6H16 A 0 A_GiveInventory("MillenniumAmmo", 350)
    goto Ready2

   ReloadCheck:
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 50, 1) goto ReloadWait+0
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 100, 1) goto ReloadWait+1
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 150, 1)goto ReloadWait+2
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 200, 1)goto ReloadWait+3
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 250, 1)goto ReloadWait+4
    6H16 A 0 A_JumpIfInventory("MillenniumAmmo", 300, 1)goto ReloadWait+5
    6H16 A 0
    goto ReloadWait+6

   ReloadWait:
    6H16 AAAAAAAAAAAA 2 A_GiveInventory("Neru_W_Ready_P")
    goto ReloadTime

    /// //////////////////
    /// //////////////////

   Fire:  // The 8 and -8 offset doesn't feel like it spreads...
    /*6H16 C 0 A_JumpIfInventory("MillenniumAmmo",1,"FireForReal")
    6H16 A 1
    Goto Ready2
    FireForReal:*/
    6H16 B 0 A_JumpIfNoAmmo("FireEndG")
    6H16 B 0 A_JumpIfInventory("Double_O_Flag", 1, "DeathWish")
    6H16 B 0 A_JumpIfInventory("ShortTemper_Flag", 1, "StoppingPower")
    6H16 B 0 A_TakeInventory("MillenniumAmmo", 10)
    6H16 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, 8, 28, frandom(-6, -18), 0, frandom(3, 7), random(3, 24), 0)  // 1
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Bullet", random(-2, 3), 0, 8, 0)  // -1 2 spread
    6H16 B 0 A_ReFire(1)
    6H16 DE 2 A_GiveInventory("Neru_W_NotSo_P")
    6H03 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, -8, 28, frandom(-6, -18), 0, frandom(3, 7), random(-3, -24), 0)  // 1
    6H03 B 0 A_FireCustomMissile("Neru_SMG_Bullet", random(-2, 3), 0, -8, 0)
    6H16 B 0 A_ReFire(1)
    6H16 BH 2 A_GiveInventory("Neru_W_NotSo_P")
    6H16 H 0 A_Refire("Fire")  //
    Goto FireEndG
   FireEndG:
    6H16 A 2 A_RailWait
    6H16 A 0 A_GiveInventory("Neru_W_NotSo_P")
    Goto Ready2

   StoppingPower:
    6H16 B 0 A_JumpIfNoAmmo("FireEndG")
    6H16 B 0 A_TakeInventory("MillenniumAmmo", 20)  // Burn more
    6H16 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 BB 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, 8, 28, frandom(-6, -18), 0, frandom(3, 7), random(3, 24), 0)  // 1
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Lesser_Bullet", random(-2, 3), 0, 8, 0, 0, random(-5, 5))
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Bullet", random(-1, 2), 0, 8, 0)  // -1 2 spread
    6H16 B 0 A_ReFire(1)
    6H16 DE 1
    6H16 D 0 A_GiveInventory("Neru_W_NotSo_P")
    6H03 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 BB 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, -8, 28, frandom(-6, -18), 0, frandom(3, 7), random(-3, -24), 0)  // 1
    6H03 B 0 A_FireCustomMissile("Neru_SMG_Lesser_Bullet", random(-2, 3), 0, -8, 0, 0, random(-5, 5))
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Bullet", random(-1, 2), 0, 8, 0)  // -1 2 spread
    6H16 B 0 A_ReFire(1)
    6H16 BH 1
    6H16 B 0 A_GiveInventory("Neru_W_NotSo_P")
    6H16 H 0 A_Refire("Fire")  //
    Goto FireEndG

   DeathWish:
    6H16 B 0 A_JumpIfNoAmmo("FireEndG")
    6H16 B 0 A_TakeInventory("MillenniumAmmo", 20)
    6H16 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, 8, 28, frandom(-6, -18), 0, frandom(3, 7), random(3, 24), 0)  // 1
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Lesser_Bullet", random(-2, 3), 0, 8, 0, 0, random(-5, 5))
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX_2", 0, -8, 28, frandom(-6, -18), 0, frandom(3, 7), random(-3, -24), 0)  // 1
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Bullet_Amped", 0, 0, 8, 0)  // Assured Stability
    6H16 B 0 A_ReFire(1)
    6H16 DE 1
    6H16 D 0 A_GiveInventory("Neru_W_NotSo_P")
    6H03 B 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")  //
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX", 0, -8, 28, frandom(-6, -18), 0, frandom(3, 7), random(-3, -24), 0)  // 1
    6H03 B 0 A_FireCustomMissile("Neru_SMG_Lesser_Bullet", random(-2, 3), 0, -8, 0, 0, random(-5, 5))
    6H16 B 0 A_SpawnItemEx("Neru_Bullet_Used_FX_2", 0, -8, 28, frandom(-6, -18), 0, frandom(3, 7), random(-3, -24), 0)  // 1
    6H16 B 0 A_FireCustomMissile("Neru_SMG_Bullet_Amped", 0, 0, 8, 0)  // Assured Stability
    6H16 B 0 A_ReFire(1)
    6H16 BH 1
    6H16 B 0 A_GiveInventory("Neru_W_NotSo_P")
    6H16 H 0 A_Refire("Fire")  //
    Goto FireEndG
   FireEndG:
    6H16 A 2 A_RailWait
    6H16 A 0 A_GiveInventory("Neru_W_NotSo_P")
    Goto Ready2

    /// //////////////////
    /// //////////////////

   Flash:
    TNT1 A 3  // 21
    TNT1 A 1 A_JumpIfInventory("MikAmmo", 60, 1)  //
    wait
    TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, 1)
    wait
    // EFGHIJ[EH] KLMNOP[KN] QRSTUV[QT]
    TNT1 E 0 A_GunFlash(1)
    TNT1 K 0 A_GiveInventory("Neru_AltDash_P")
    TNT1 Q 0 A_RailWait
    TNT1 E 0 A_Jump(256, 1, 4, 7, 10, 13, 16, 19, 22, 25, 28, 31, 34, 37, 40, 43)
    TNT1 EKQ 3  // Solid
    loop
    TNT1 FLR 3
    loop
    TNT1 GMS 3
    loop
    TNT1 HNT 3
    loop
    TNT1 IOU 3
    loop
    TNT1 JPV 3
    loop
    TNT1 ELS 3
    loop
    TNT1 FMT 3
    loop
    TNT1 GNU 3
    loop
    TNT1 HOV 3
    loop
    TNT1 IPQ 3
    loop
    TNT1 JKR 3
    loop
    TNT1 JKT 3
    loop
    TNT1 ENQ 3
    loop
    TNT1 HKQ 3
    loop
  }
}

// Holy shit, Cel. Just how many PICKUPS DO I HAVE TO PUT?
// PICKING UP SLADE IS BAD ENOUGH AND THATS AN OPTIONAL POWERUP!

actor Neru_W_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_WeaponReady
    TNT1 A 0 A_GiveInventory("UnholyPower500", 1)
    TNT1 A 0 A_GiveInventory("UnholyPower1500", 1)
    TNT1 A 0 A_GiveInventory("MikAmmo", 1)  //
    stop
  }
}

//
actor Neru_W_NotSo_P: CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyPower500", 1)
    TNT1 A 0 A_GiveInventory("UnholyPower1500", 1)
    TNT1 A 0 A_GiveInventory("MikAmmo", 1)  //
    stop
  }
}
//
//

actor Neru_Rage_Count_Watcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("UnholyPower500", 500, "RAGE_UP")
    loop
   RAGE_UP:
    TNT1 A 0 A_GiveToTarget("Neru_RageSound_P", 1)
    TNT1 A 0 A_TakeFromTarget("UnholyPower500", 500)  // 9999
    TNT1 A 1 A_GiveToTarget("Neru_Rage_Stacker", 1)
    // TNT1 A 0 A_Log("\cfRage Stack +1 \cc(+5 Damage Mainfire & +250 MaxHP)")
    goto Spawn+1
  }
}

// This is the only one that has severe punishment for players.
actor Neru_Wrath_Count_Watcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("UnholyPower1500", 1500, "WrathStackChecker")
    loop
   WrathStackChecker:
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once5", 1, "WRATH_UP")
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once4", 1, "Buff_5")
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once3", 1, "Buff_4")
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once2", 1, "Buff_3")
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once1", 1, "Buff_2")
    Goto Buff_1  // Just Incase
   Buff_1:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once1", 1, "WRATH_UP")
    // TNT1 A 0 A_Log("\ccStarter Buff Perk")
    TNT1 A 0 A_GiveToTarget("Neru_WrathBuff_1", 1)
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Once1", 1)
    goto WRATH_UP
   Buff_2:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once2", 1, "WRATH_UP")
    // TNT1 A 0 A_Log("\ccDamage Reduction Perk")
    TNT1 A 0 A_GiveToTarget("Neru_WrathBuff_2", 1)
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Once2", 1)
    goto WRATH_UP
   Buff_3:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once3", 1, "WRATH_UP")
    // TNT1 A 0 A_Log("\ccRapid Fire Perk")
    TNT1 A 0 A_GiveToTarget("Neru_WrathBuff_3", 1)
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Once3", 1)
    goto WRATH_UP
   Buff_4:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once4", 1, "WRATH_UP")
    // TNT1 A 0 A_Log("\ccAmplfied Bullet Perk")
    TNT1 A 0 A_GiveToTarget("Neru_WrathBuff_4", 1)
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Once4", 1)
    goto WRATH_UP
   Buff_5:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("Neru_Wrath_Once5", 1, "WRATH_UP")
    // TNT1 A 0 A_Log("\ccRaw Acceleration Perk")
    TNT1 A 0 A_GiveToTarget("Neru_WrathBuff_5", 1)
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Once5", 1)
    goto WRATH_UP
   WRATH_UP:
    TNT1 A 0
    // TNT1 A 0 A_Log("\crWrath Stack +1 \cc(+15 Damage Mainfire & +500 MaxHP)")
    TNT1 A 0 A_GiveToTarget("Neru_WrathSound_P", 1)
    TNT1 A 0 A_TakeFromTarget("UnholyPower1500", 1500)  // 9999
    TNT1 A 0 A_GiveToTarget("Neru_Wrath_Stacker", 1)
    goto Spawn+1
  }
}

actor Neru_WrathBuff_1: CustomInventory  // Mobility Buff
{
  States {
   Pickup:
    // TNT1 A 0 A_Log("The Speed")
    TNT1 A 0 A_JumpIfInventory("Neru_Wrath_Once1", 1, "No")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 18)  // Max 150
    TNT1 A 0 A_GiveInventory("Neru_Rage_Stacker", 3)  // +15 damage, first time bonus!
    // TNT1 A 0 A_Log("\ccStarter Buff Perk")
    // TNT1 A 0 A_GiveInventory("WallJumpLimit", 2) already on spawn
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 250)  // First time bonus additional health, totalling about... 750.
    // TNT1 A 0 A_GiveInventory("UH_150_JumpPowerGiver") //Absurd, not doing it.
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor Neru_WrathBuff_2: Neru_WrathBuff_1  // Damage Reduction
{
  States {
   Pickup:  // Thought about adding armor... but wouldn't that be overkill at this point with 30% DR?
    TNT1 A 0 A_JumpIfInventory("Neru_Wrath_Once2", 1, "No")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 18)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 19)  // Max 150
    TNT1 A 0 A_GiveInventory("Neru_DamageReduction")
    // TNT1 A 0 A_Log("\ccDamage Reduction Perk")
    stop  // That and I don't have a good indicator that you have DR.
  }
}
//
actor Neru_DamageReduction : PowerProtection {
  Powerup.Duration 0x7FFFFFFF
  damagefactor "Normal", 0.70
}
//
actor Neru_WrathBuff_3: Neru_WrathBuff_1  // Empowered Firing
{
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Neru_Wrath_Once3", 1, "No")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 19)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 20)  // Max 150
    TNT1 A 0 A_GiveInventory("ShortTemper_Flag")
    // TNT1 A 0 A_Log("\ccRapid Fire Perk")
    stop
  }
}

actor Neru_WrathBuff_4: Neru_WrathBuff_1  // Jacked bullets
{
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Neru_Wrath_Once4", 1, "No")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 20)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 21)  // Max 150
    TNT1 A 0 A_GiveInventory("Double_O_Flag")
    // TNT1 A 0 A_Log("\ccAmplfied Bullet Perk")
    stop
  }
}
//
actor Neru_Adrenaline_Rush_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 10)  // Can't decide if 5 or 10 or more...
    stop
  }
}
actor Neru_Thrill_Rush_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 100)  // 50
    stop
  }
}


actor Neru_WrathBuff_5: Neru_WrathBuff_1  // THAT IS BULLSHIT BLAZING
{
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Neru_Wrath_Once5", 1, "No")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 21)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 22)  // Max 150
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 6)  // A SLIGHT improvement
    TNT1 A 0 A_GiveInventory("Sukajan")
    // TNT1 A 0 A_Log("\ccRaw Acceleration Perk")
    TNT1 A 0 A_FireCustomMissile("WrathManifest_FX", 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("WrathManifest_FX", 180, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("Unbridled_Wrath_Manifested")  // OnFire without the drawback
    stop
  }
}

//
actor Unbridled_Wrath_Manifested : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_GiveInventory("SUDDENLYONFIRE",1)
    // TNT1 A 0 A_GiveInventory("OnFireItemFlag",1)
    TNT1 A 0 A_SpawnItemEx("WrathManifest_H")
    goto End
  }
}

actor WrathManifest_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_GiveToTarget("WrathManifest_P", 1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "StopThis")
    TNT1 A 0 A_JumpIfInTargetInventory("ShortTemper_Flag", 1, "Spawn")
    goto StopThis
   StopThis:
    TNT1 A 0 A_TakeFromTarget("ShortTemper_Flag")
    TNT1 A 1 A_TakeFromTarget("Double_O_Flag")
    stop
  }
}

actor WrathManifest_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyPower500", 2)  // Part of Acceleration
    TNT1 A 0 A_GiveInventory("UnholyPower1500", 1)
    TNT1 A 0 A_SpawnItemEx("WrathManifest_Explode", 0, 0, 28, momx, momy, momz, 0, 8)
    stop
    // goto Done
    /*Done:
    TNT1 A 0
    stop*/
  }
}

//
actor WrathManifest_FX : BasicProjectile {
  Translation "192:192=4:4", "198:198=218:218"
  var int User_Spinny;
  +THRUGHOST
  +RIPPER
  +NOCLIP
  +DONTBLAST
  Renderstyle "Translucent"  // add
  Alpha 1.0  //
  Damage (0)  //
  Radius 8
  Height 8
  Speed 25
  states {
   Spawn:  // Should this be farther?
    X_5H A 0 A_GiveInventory("KnightFlag", 1)
    6P55 A 1 A_Warp(AAPTR_TARGET, 8+User_Spinny, 0, 8, 6, WARPF_NOCHECKPOSITION|WARPF_USECALLERANGLE)  // 32z
    6P55 A 0 A_SetUserVar("User_Spinny", User_Spinny+8)
    6P55 A 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P55 A 0 A_JumpIfInventory("KnightFlag", 12, "Spawn1")
    Loop
   Spawn1:
    6P55 A 0 A_GiveInventory("CutterFlag", 1)
    6P55 A 1 A_Warp(AAPTR_TARGET, 96, 0, 8, 6, WARPF_NOCHECKPOSITION|WARPF_USECALLERANGLE)  // 96x
    6P55 A 0 A_SpawnItemEx("WrathMani_Fire_FX")  //
    6P55 A 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P55 A 0 A_JumpIfInventory("CutterFlag", 2, "Spawn2")
    Loop
   Spawn2:
    6P55 B 0 A_GiveInventory("CutterFlag", 1)
    6P55 B 1 A_Warp(AAPTR_TARGET, 96, 0, 8, 6, WARPF_NOCHECKPOSITION|WARPF_USECALLERANGLE)
    6P55 B 0 A_SpawnItemEx("WrathMani_Fire_FX")  //
    6P55 B 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P55 B 0 A_JumpIfInventory("CutterFlag", 4, "Spawn3")
    Loop
   Spawn3:
    6P55 C 0 A_GiveInventory("CutterFlag", 1)
    6P55 C 1 A_Warp(AAPTR_TARGET, 96, 0, 8, 6, WARPF_NOCHECKPOSITION|WARPF_USECALLERANGLE)
    6P55 C 0 A_SpawnItemEx("WrathMani_Fire_FX")  //
    6P55 C 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P55 C 0 A_JumpIfInventory("CutterFlag", 6, "Do_It_Again")
    Loop
   Do_It_Again:
    X_5H E 0 A_TakeInventory("CutterFlag")
    Goto Spawn1
   Death:
    TNT1 A 2
    Stop
  }
}

actor WrathMani_Fire_FX : BasicGraphicEffect {
  Translation "192:192=4:4", "198:198=218:218"
  alpha 0.9
  Radius 6
  Height 6
  scale 3.5  // 1.0
  states {
   SpawnFrame:  // ThrustThingZ(0,2,0,1)
    X_8C AABBCC 2 A_Fadeout(0.05)
    X_8C D 2 A_Fadeout(0.05)
    wait
   Death:
    TNT1 A 1
    stop
  }
}
//

actor WrathManifest_Explode : BasicExplosion {
  DamageType "NeruFire"
  Obituary "BULLSHIT BLAZING"
  States {
   Spawn:
    TNT1 A 0  // 25 damage too much? Tone it down to 10.
    TNT1 A 2 A_Explode(25, 64, 0, 0, 32)  // 138 radius
    stop
  }
}
//


actor Neru_RageSound_P: CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 250)  // 200 is probably TOO much...
    TNT1 A 0 A_PlaySoundEx("weapon/NeruRageStack", "SoundSlot6")  // 1
    stop
  }
}


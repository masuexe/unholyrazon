actor Neru_AltDash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Neru_AltDashFX_P")
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 1)
    goto Check
    TNT1 A 0 ThrustThingZ(0, 16, 0, 0)
    goto Check
   Check:
    TNT1 A 0 A_JumpIf(CallACS("UH_IsInputingMovement"), "Booster")
    goto NoBoost
   Booster:
    TNT1 A 0 A_JumpIfInventory("Sukajan", 1, "Heated_Booster")
    TNT1 A 0 A_ChangeVelocity(sin(CallACS("UH_FetchInputDir", 0))*35, sin(CallACS("UH_FetchInputDir", 1))*-35, momz, 3)
    goto End
   Heated_Booster:
    TNT1 A 0 A_SpawnItemEx("Neru_Explosive_Dash", 0, 0, 32)  //
    TNT1 A 0 A_ChangeVelocity(sin(CallACS("UH_FetchInputDir", 0))*45, sin(CallACS("UH_FetchInputDir", 1))*-45, momz, 3)
    goto End
   NoBoost:
    TNT1 A 0 ThrustThingZ(0, 26, 0, 1)  // 18
    goto End
   End:
    TNT1 A 0 ThrustThingZ(0, 12, 0, 1)
    TNT1 A 0 A_TakeInventory("MikAmmo", 30, 1)
    TNT1 A 0 A_TakeInventory("MikAmmo", 30)
    stop
  }
}
actor Neru_AltDashFX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep/ClaireDash", 4, 1.0)  // weapon/slashclaw
    TNT1 A 0 A_SpawnItemEx("Neru_DashFX", 0, 22.5, 0, 0, 0, frandom(1, 2), 0, 32)
    TNT1 A 0 A_SpawnItemEx("Neru_DashFX", 0, 0, 0, 0, 0, frandom(1, 2), 0, 32)
    TNT1 A 0 A_SpawnItemEx("Neru_DashFX", 0, -22.5, 0, 0, 0, frandom(1, 2), 0, 32)
    stop
  }
}


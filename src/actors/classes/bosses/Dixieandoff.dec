// TODO: add sprites without Knight Crush

actor Dixieandoff : BossBase {
  Player.ScoreIcon "UB023MUG"
  Player.SoundClass "Dixieandoff"
  Player.DamageScreenColor "white"
  Player.ForwardMove 0.9, 0.9
  Player.SideMove 0.9, 0.9
  Player.JumpZ 10
  Player.MaxHealth 2775
  Health 2775
  Player.MorphWeapon "Dixieandoff_W"
  States {
   Spawn:
    8A23 A 0
    8A23 B 1 A_JumpIfInventory("HandyFlag", 1, "Missile")
    8A23 A 1
    goto Spawn+2
   See:
    8A23 B 0 A_JumpIfInventory("HandyFlag", 1, "Missile")
    8A23 BCDE 5
    goto Spawn
   Missile:
    8A23 F 0 A_JumpIfInventory("HandyFlag", 2, "Missile2")
    8A23 F 0 A_JumpIfInventory("HandyFlag", 1, "Missile1")
    8A23 F 5
    8A23 G 0 A_JumpIfInventory("HandyFlag", 2, "Missile2")
    8A23 G 4
    goto Spawn+2
   Missile1:
    8A23 F 1
    goto Missile
   Missile2:
    8A23 G 1
    goto Missile+3
   ClassPain:
    8A23 H 0
    goto MegamanPain
   ClassDeath:
    8A23 H 0
    goto MegamanDeath
  }
}

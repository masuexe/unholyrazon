actor Troutius_W_ScriptBar : ScriptBar {}
actor Troutius_W : BaseUnholyBossWep {
  Tag "$TAG_Troutius_W"
  Obituary "%o didn't like how fishy Troutius (%k) was being."
  Inventory.Pickupmessage "\cuShut up."
  Weapon.AmmoType "UnholyBossAmmo100"
  Weapon.AmmoType2 "UnholyBossAmmo150"
  States {
   Spawn:
    8H49 [ 1
    wait

   Deselect:
    8H49 A 0
    goto DeselectSwap
   Select:
    8H49 A 0
    goto SelectSwap

   Ready:
    8H49 A 0  // Initial setup: boss morph hook.
    8H49 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, TROUTIUS_DYE)
    // ExtraLife: morphActorToBoss (Ready may re-enter online)
    8H49 A 0  // Initial setup: boss morph hook.
    8H49 A 0  // Initial setup: boss morph hook.
    8H49 A 0 A_GunFlash("Flash", true)
    goto ReadyX

   ReadyX:
    8H49 A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "ChunLiNews")
    8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "ReadyX1")
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 2 A_WeaponReady(8)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    loop
   ReadyX1:
    8H49 A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "ChunLiNews")
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 2 A_WeaponReady
    8H49 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    loop
   ReadyX2:
    8H49 A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "ChunLiNews")
    8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "ReadyX3")
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 2 A_WeaponReady(8)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    loop
   ReadyX3:
    8H49 A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "ChunLiNews")
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 2 A_WeaponReady
    8H49 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8H49 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    loop

   FireRageBegin:
    8H49 A 0 A_GiveInventory("UnholyPowerDazzle_F")
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 0 A_TakeInventory("TroutiusDashFlag")
    8H49 A 0 A_GiveInventory("VivifyDelay4")
    8H49 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8H49 A 0  // ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    8H49 A 0 A_PlaySoundEx("Pokemon/RageStart", "Weapon")
    8H49 A 0 A_ReFire(1)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H49 H 5 A_ScaleVelocity(0.15)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)
    8H49 A 0 ThrustThingZ(0, 40, 0, 0)
    8H49 I 2 A_Recoil(15)
    8H49 J 3
    8H49 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 J 4
    8H49 J 6 A_TakeInventory("WeaponCharge")
    8H49 K 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
   FireRageBeginLand:
    8H49 K 1 A_JumpIf(CallACS("core_CheckFooting"), "FireRageLanded")
    loop
   FireRageLanded:
    8H49 A 0 A_GiveInventory("VivifyDelay4")
    8H49 K 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H49 K 2 Offset(0, 52)
    8H49 K 2 Offset(0, 72)
    8H49 K 2 Offset(0, 92)
    8H49 K 2 Offset(0, 112)
    TNT1 A 4
    8H49 F 2 Offset(0, 112)
    8H49 F 2 Offset(0, 92)
    8H49 F 2 Offset(0, 72)
    8H49 F 2 Offset(0, 52)
    8H49 F 2 A_WeaponReady(14)
    8H49 G 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
   FireRageLoop:
    8H49 G 1 A_GiveInventory("TroutiusRageDash_P")
    8H49 G 0 A_JumpIfInventory("WeaponCharge", 1, "FireRageCollide")
    8H49 G 0 A_JumpIfInventory("UnholyPower1500", 1, 1)
    goto FireRageEnd
    8H49 G 1 A_GiveInventory("TroutiusRageDash_P")
    8H49 G 0 A_JumpIfInventory("WeaponCharge", 1, "FireRageCollide")
    8H49 G 0 A_JumpIfInventory("UnholyPower1500", 1, 1)
    goto FireRageEnd
    8H49 F 1 A_GiveInventory("TroutiusRageDash_P")
    8H49 F 0 A_JumpIfInventory("WeaponCharge", 1, "FireRageCollide")
    8H49 F 0 A_JumpIfInventory("UnholyPower1500", 1, 1)
    goto FireRageEnd
    8H49 F 1 A_GiveInventory("TroutiusRageDash_P")
    8H49 F 0 A_JumpIfInventory("WeaponCharge", 1, "FireRageCollide")
    8H49 F 0 A_JumpIfInventory("UnholyPower1500", 1, "FireRageLoop")
    goto FireRageEnd
   FireRageCollide:
    8H49 G 2 A_FireCustomMissile("TroutiusRageKaboom", 0, 0, 0, 0)
    goto FireRageEnd+1
   FireRageEnd:
    8H49 G 2 A_ScaleVelocity(0.25)
    8H49 F 0 A_GiveInventory("VivifyDelay4")
    8H49 F 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8H49 F 0 A_TakeInventory("UnholyPowerDazzle_F")
    8H49 F 0 A_TakeInventory("WeaponCharge")
    TNT1 F 0 A_TakeInventory("UnholyPower1500")
    8H49 F 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 F 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    8H49 F 2 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H49 E 4
    8H49 D 4
    8H49 A 4
    goto ReadyX

   PhaseResume:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 39, "PhaseHold38")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 38, "PhaseHold37")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 37, "PhaseHold36")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 32, "PhaseHold31")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 30, "PhaseHold29")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 26, "PhaseHold25")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 22, "PhaseHold21")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 18, "PhaseHold17")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 14, "PhaseHold13")
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 11, "PhaseHold10")
    TNT1 A 1
    goto PhaseResume

   AatroxTime:
   PhaseFrame0:
    TNT1 A 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "ReadyX2")
   PhaseFrame1:
    TNT1 A 0 A_GiveInventory("TroutiusPainFlag")
   PhaseFrame2:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
   PhaseFrame3:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
   PhaseFrame4:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
   PhaseFrame5:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
   PhaseFrame6:
    TNT1 A 0 A_PlaySound("wep/MM8BassWhat", 1)
   PhaseFrame7:
    TNT1 A 0 A_PlaySound("wep/MM8BassWhat", 2)
   PhaseFrame8:
    TNT1 A 0 A_PlaySound("wep/MM8BassWhat", 3)
   PhaseFrame9:
    TNT1 A 0 A_GunFlash("NoFlash")
   PhaseFrame10:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 11)
   PhaseHold10:
    TNT1 A 140
   PhaseFrame11:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
   PhaseFrame12:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
   PhaseFrame13:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 14)
   PhaseHold13:
    TNT1 A 2 ThrustThingZ(0, 125, 0, 0)
   PhaseFrame14:
    TNT1 A 0 A_Stop
    goto AatroxRecover
   AatroxRecover:
   PhaseFrame15:
    8H49 G 0 A_GiveInventory("TroutiusHPRegain_P")
   PhaseFrame16:
    8H49 G 0 A_PlaySound("wep/MM8BassWhat", 1)
   PhaseFrame17:
    8H49 G 0 A_SpawnItemEx("TroutiusRegainEffect", 0, 0, 28, 20, 0, random(-20, 20), random(0, 359), 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 18)
   PhaseHold17:
    8H49 G 1
   PhaseFrame18:
    8H49 F 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "AatroxEnd")
   PhaseFrame19:
    8H49 F 0 A_GiveInventory("TroutiusHPRegain_P")
   PhaseFrame20:
    8H49 F 0 A_PlaySound("wep/MM8BassWhat", 3)
   PhaseFrame21:
    8H49 F 0 A_SpawnItemEx("TroutiusRegainEffect", 0, 0, 28, 20, 0, random(-20, 20), random(0, 359), 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 22)
   PhaseHold21:
    8H49 F 1
   PhaseFrame22:
    8H49 G 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "AatroxEnd")
   PhaseFrame23:
    8H49 G 0 A_GiveInventory("TroutiusHPRegain_P")
   PhaseFrame24:
    8H49 G 0 A_PlaySound("wep/MM8BassWhat", 4)
   PhaseFrame25:
    8H49 G 0 A_SpawnItemEx("TroutiusRegainEffect", 0, 0, 28, 20, 0, random(-20, 20), random(0, 359), 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 26)
   PhaseHold25:
    8H49 G 1
   PhaseFrame26:
    8H49 F 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "AatroxEnd")
   PhaseFrame27:
    8H49 F 0 A_GiveInventory("TroutiusHPRegain_P")
   PhaseFrame28:
    8H49 F 0 A_PlaySound("wep/MM8BassWhat", 5)
   PhaseFrame29:
    8H49 F 0 A_SpawnItemEx("TroutiusRegainEffect", 0, 0, 28, 20, 0, random(-20, 20), random(0, 359), 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 30)
   PhaseHold29:
    8H49 F 1
   PhaseFrame30:
    8H49 G 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "AatroxEnd")
    goto AatroxRecover
   AatroxEnd:
   PhaseFrame31:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 32)
   PhaseHold31:
    8H49 F 2
   PhaseFrame32:
    8H49 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
   PhaseFrame33:
    8H49 E 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
   PhaseFrame34:
    8H49 E 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
   PhaseFrame35:
    8H49 E 0 A_TakeInventory("TroutiusPainFlag")
   PhaseFrame36:
    8H49 E 0 A_GunFlash("Flash", true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 37)
   PhaseHold36:
    8H49 E 2
   PhaseFrame37:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 38)
   PhaseHold37:
    8H49 D 2
   PhaseFrame38:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 39)
   PhaseHold38:
    8H49 A 2
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    goto ReadyX2

   Flash:
    TNT1 A 1 A_GiveInventory("TroutiusHealthCheck_P")
    loop

   Fire:
    8H49 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "FireRageBegin")
    8H49 A 0 A_JumpIfInventory("TroutiusEXChance", 1, "FireEX")
    8H49 A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "ChunLiNews")
    8H49 A 0 A_GiveInventory("TroutiusEXChance")
    8H49 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H49 A 0 A_FireCustomMissile("TroutiusShot", random(-5, 5), 0, 8, 0)
    8H49 B 2 A_WeaponReady(4)
    8H49 C 1 A_GiveInventory("UnholyBossAmmo150", 1)
    8H49 A 1 A_TakeInventory("TroutiusEXChance")
    goto ReadyX
   FireEX:
    8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "FireEXReal")
    8H49 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 B 1 A_TakeInventory("TroutiusDashFlag")
    8H49 C 1 A_GiveInventory("UnholyBossAmmo150", 1)
    8H49 A 1
    goto ReadyX

   FireEXReal:
    8H49 A 0 A_TakeInventory("VivifyDelay7", 1)
    8H49 A 0 A_TakeInventory("TroutiusEXChance")
    8H49 A 0 A_ReFire(1)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    // 8H49 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    8H49 B 0 A_TakeInventory("UnholyBossAmmo100", 20)
    8H49 B 0 A_ScaleVelocity(0.25)
    8H49 B 0 A_ChangeVelocity(-cos(pitch) * 25, 0, sin(pitch) * 20, CVF_RELATIVE)  // 15 - 10
    8H49 B 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    8H49 B 0 A_FireCustomMissile("TroutiusEXShot", 0, 0, 8, 0)
    8H49 B 2
    8H49 BCCAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo150", 1)
    goto ReadyX
   Altfire:  // Limiter of 3 - 3 dashes ammo thing.
    8H49 A 0 A_JumpIfInventory("TroutiusEXChance", 1, "FireEX")
    8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "TroutDasher")
    goto ReadyX
   TroutDasher:
    8H49 D 0 A_TakeInventory("UnholyBossAmmo100", 20)
    8H49 D 0 A_GiveInventory("TroutiusDashFlag")
    8H49 D 0 A_ReFire(1)
    8H49 D 0 A_PlaySoundEx("weapon/chargekick", "Weapon")
    8H49 D 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H49 D 0 A_Recoil(-35)
    8H49 D 0 ThrustThingZ(0, 40, 0, 0)
    8H49 DEFFF 2  // A_WeaponReady(8)  // causes PlayerPropertyStopped leakage
    8H49 F 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    goto TroutDashWait
   TroutDashWait:
    8H49 F 1 A_WeaponReady(8)
    8H49 F 0 A_JumpIf(CallACS("core_CheckFooting"), "TroutDashStop")
    loop
   Re_TroutDasher:
    8H49 E 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "TroutDasher")
    8H49 E 4
    8H49 D 4
    8H49 A 4
    goto ReadyX
   TroutDashStop:
    8H49 F 0 A_TakeInventory("TroutiusDashFlag")
    8H49 F 0 A_ReFire("Re_TroutDasher")
    // 8H49 A 15
    8H49 E 4
    8H49 D 4
    8H49 A 4
    goto ReadyX

   ChunLiNews:
    8H49 A 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ChunLiPowers")
    8H49 E 2
    8H49 E 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H49 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 E 0 A_TakeInventory("TroutiusEXChance")
    8H49 E 2 A_TakeInventory("TroutiusDashFlag")
    8H49 D 4
    8H49 A 4
    goto ReadyX


   ChunLiPowers:
    8H49 H 0 A_GiveInventory("VivifyDelay7")
    8H49 H 0 A_TakeInventory("UnholyBossAmmo150", 200)
    8H49 H 0 A_TakeInventory("TroutiusDashFlag")
    8H49 H 0 A_ReFire(1)
    8H49 H 2 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H49 I 0 A_Recoil(-30)
    8H49 I 0 ThrustThingZ(0, 30, 0, 0)
    8H49 I 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    8H49 I 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8H49 I 0 ThrustThingZ(0, 75, 0, 0)
    8H49 I 0 A_Recoil(-5)
    8H49 I 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)  // A_FireBullets(0,0,0,0,"Kickwallcheck2",FBF_NOFLASH,64)
    8H49 I 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 I 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 I 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 I 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 0  // A_Recoil(-5)
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 0  // A_Recoil(-1)
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 0 A_Recoil(5)  // -5
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 0  // A_Recoil(-5)
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "ChunLiPowersEX")
    8H49 J 0  // A_Recoil(-5)
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 K 2 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 K 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    goto ChunLiWait
   ChunLiPowersEX:
    8H49 J 0 A_GiveInventory("TroutiusEXChance")
    8H49 J 0  // A_Recoil(-5)
    8H49 J 0 A_SpawnItemEx("Kickwallcheck", 0, 0, 28, 64)
    8H49 J 0 A_SpawnItemEx("TroutiusLiftup", 0, 0, -50)
    8H49 J 0 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    8H49 J 0 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    8H49 J 0 A_FireCustomMissile("TroutiusKickers", 0, 0, 8, 0)
    8H49 J 1 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    8H49 K 0  // A_TakeInventory("UnholyBossAmmo150")
    8H49 K 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H49 K 2 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    8H49 K 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H49 K 2 A_WeaponReady(8)
    goto ChunLiWaitEX
   ChunLiWaitEX:
    8H49 K 2 A_WeaponReady(8)
    8H49 K 0 A_JumpIf(CallACS("core_CheckFooting"), "ChunLiLand")
    loop
   ChunLiWait:
    8H49 K 2 A_WeaponReady(12)
    8H49 K 0 A_JumpIf(CallACS("core_CheckFooting"), "ChunLiLand")
    loop

   ChunLiLand:
    TNT1 A 2 A_WeaponReady(12)
    TNT1 A 0 A_GiveInventory("VivifyDelay7")
    TNT1 A 0 A_TakeInventory("TroutiusEXChance")
    TNT1 A 2 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H49 FEDA 4 A_GiveInventory("UnholyBossAmmo150", 20)
    8H49 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    goto ReadyX
  }
}

actor Troutius_W_Pissed_ScriptBar : ScriptBar {}
actor Troutius_W_Pissed : Troutius_W {
  // Same attacks as Troutius_W; only Ready runs AatroxTime once after ExtraLife.
  States {
   Ready:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 1, "PhaseResume")
    8H49 A 0 A_JumpIfInventory("TroutiusGetUpDone_F", 1, "ReadyAfterGetUp")
    8H49 A 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "ReadyAfterGetUp")
    8H49 A 0 A_GiveInventory("TroutiusGetUpDone_F")
    8H49 A 0 A_JumpIf(true, "AatroxTime")
    goto AatroxTime
   ReadyAfterGetUp:
    8H49 A 0 A_GunFlash("Flash", true)
    goto ReadyX2
  }
}

// Flash polls HP; swap to Troutius_W_Pissed (same moveset; no Ready HealthLower spam)
actor TroutiusHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("TroutiusIsAatrox", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("Troutius_W_Pissed", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("TroutiusPainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("TroutiusSwapPissed_P")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor TroutiusSwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    TNT1 A 0 A_TakeInventory("TroutiusGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Troutius_W_Pissed")
    TNT1 A 0 A_TakeInventory("Troutius_W")
    stop
  }
}

actor TroutiusGetUpDone_F : Once {}

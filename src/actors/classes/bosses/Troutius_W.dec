}

actor TroutiusHPRegain_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.50, "GiveHealth")
    goto Pickup3
   GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 20)
    stop
   Pickup3:
    TNT1 A 0 A_GiveInventory("TroutiusIsAatrox")
    stop
  }
}


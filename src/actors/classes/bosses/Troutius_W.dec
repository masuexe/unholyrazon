  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("TroutiusKaboomFX", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    TNT1 A 0 A_Explode(100, 128, 0, 0, 32)
    X_8B ABCDEF 2 A_SpawnItemEx("TroutiusKaboom2", random(-96, 96), random(-96, 96), random(-64, 64), 0, 0, 0, 0, 1)
    stop
  }
}


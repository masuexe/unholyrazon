actor Troutius_W_ScriptBar : ScriptBar {}
actor Troutius_W : BaseUnholyBossWep
{
Tag "$TAG_Boss049_W"
Obituary "%o didn't like how fishy Troutius (%k) was being."
Inventory.Pickupmessage "\cuShut up."
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyBossAmmo150"
States
{
Spawn:
8H49 [ 1
wait

Deselect:
8H49 A 0
goto DeselectSwap
Select:
8H49 A 0
goto SelectSwap

Ready:
8H49 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H49 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TROUTIUS_DYE)
8H49 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 49,2500,366)
8H49 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, ELP_NATIVE)
8H49 A 0 A_GiveInventory("UnholyBossAmmo100",75)
8H49 A 0 A_GiveInventory("UnholyBossAmmo150",100)
goto ReadyX

ReadyX:
8H49 A 0 A_JumpIfHealthLower(2,"AatroxTime")
8H49 A 0 A_JumpIfInventory("TroutiusDashFlag",1,"ChunLiNews")
8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100",20,"ReadyX1")
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 2 A_WeaponReady(8)
8H49 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8H49 A 0 A_GiveInventory("UnholyBossAmmo150",1)
loop
ReadyX1:
8H49 A 0 A_JumpIfHealthLower(2,"AatroxTime")
8H49 A 0 A_JumpIfInventory("TroutiusDashFlag",1,"ChunLiNews")
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 2 A_WeaponReady
8H49 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8H49 A 0 A_GiveInventory("UnholyBossAmmo150",1)
loop
ReadyX2:
8H49 A 0 A_JumpIfInventory("TroutiusDashFlag",1,"ChunLiNews")
8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100",20,"ReadyX3")
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 2 A_WeaponReady(8)
8H49 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8H49 A 0 A_GiveInventory("UnholyBossAmmo150",1)
loop
ReadyX3:
8H49 A 0 A_JumpIfInventory("TroutiusDashFlag",1,"ChunLiNews")
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 2 A_WeaponReady
8H49 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8H49 A 0 A_GiveInventory("UnholyBossAmmo150",1)
loop

FireRageBegin:
8H49 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 0 A_TakeInventory("TroutiusDashFlag",1)
8H49 A 0 A_GiveInventory("VivifyDelay4")
8H49 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8H49 A 0 //ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H49 A 0 A_PlaySoundEx("Pokemon/RageStart","Weapon")
8H49 A 0 A_Refire(1)
8H49 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H49 H 5 A_ScaleVelocity(0.15)
8H49 A 0 A_TakeInventory("UnSolid")
8H49 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
8H49 A 0 A_ChangeFlag("THRUSPECIES",1)
8H49 A 0 ThrustThingZ(0,40,0,0)
8H49 I 2 A_Recoil(15)
8H49 J 3
8H49 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 J 4
8H49 J 6 A_TakeInventory("WeaponCharge")
8H49 K 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
FireRageBeginLand:
8H49 K 1 A_CheckFloor("FireRageLanded")
loop
FireRageLanded:
8H49 A 0 A_GiveInventory("VivifyDelay4")
8H49 K 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H49 K 2 Offset(0,52)
8H49 K 2 Offset(0,72)
8H49 K 2 Offset(0,92)
8H49 K 2 Offset(0,112)
TNT1 A 4
8H49 F 2 Offset(0,112)
8H49 F 2 Offset(0,92)
8H49 F 2 Offset(0,72)
8H49 F 2 Offset(0,52)
8H49 F 2 A_WeaponReady(14)
8H49 G 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
FireRageLoop:
8H49 G 1 A_GiveInventory("TroutiusRageDash_P",1)
8H49 G 0 A_JumpIfInventory("WeaponCharge",1,"FireRageCollide")
8H49 G 0 A_JumpIfInventory("UnholyPower1500",1,1)
Goto FireRageEnd
8H49 G 1 A_GiveInventory("TroutiusRageDash_P",1)
8H49 G 0 A_JumpIfInventory("WeaponCharge",1,"FireRageCollide")
8H49 G 0 A_JumpIfInventory("UnholyPower1500",1,1)
Goto FireRageEnd
8H49 F 1 A_GiveInventory("TroutiusRageDash_P",1)
8H49 F 0 A_JumpIfInventory("WeaponCharge",1,"FireRageCollide")
8H49 F 0 A_JumpIfInventory("UnholyPower1500",1,1)
Goto FireRageEnd
8H49 F 1 A_GiveInventory("TroutiusRageDash_P",1)
8H49 F 0 A_JumpIfInventory("WeaponCharge",1,"FireRageCollide")
8H49 F 0 A_JumpIfInventory("UnholyPower1500",1,"FireRageLoop")
Goto FireRageEnd
FireRageCollide:
8H49 G 2 A_FireCustomMissile("TroutiusRageKaboom",0,0,0,0)
Goto FireRageEnd+1
FireRageEnd:
8H49 G 2 A_ScaleVelocity(0.25)
8H49 F 0 A_GiveInventory("VivifyDelay4")
8H49 F 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8H49 F 0 A_TakeInventory("UnholyPowerDazzle_F")
8H49 F 0 A_TakeInventory("WeaponCharge")
TNT1 F 0 A_TakeInventory("UnholyPower1500")
8H49 F 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 F 0 A_ChangeFlag("THRUSPECIES",1)
8H49 F 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
8H49 F 2 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H49 E 4
8H49 D 4
8H49 A 4
goto ReadyX

AatroxTime:
TNT1 A 0 A_JumpIfInventory("TroutiusIsAatrox",1,"ReadyX2")
TNT1 A 0 A_GiveInventory("VivifyDelay6")
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
TNT1 A 0 A_PlaySound("wep/MM8BassWhat",1)
TNT1 A 0 A_PlaySound("wep/MM8BassWhat",2)
TNT1 A 0 A_PlaySound("wep/MM8BassWhat",3)
TNT1 A 0 A_GunFlash("NoFlash")
TNT1 A 140
TNT1 A 0 A_GiveInventory("VivifyDelay6")
TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
TNT1 A 2 ThrustThingZ(0,125,0,0)
TNT1 A 0 A_Stop
goto AatroxRecover
AatroxRecover:
8H49 G 0 A_GiveInventory("TroutiusHPRegain_P")
8H49 G 0 A_PlaySound("wep/MM8BassWhat",1)
8H49 G 1 A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
8H49 F 0 A_JumpIfInventory("TroutiusIsAatrox",1,"AatroxEnd")
8H49 F 0 A_GiveInventory("TroutiusHPRegain_P")
8H49 F 0 A_PlaySound("wep/MM8BassWhat",3)
8H49 F 1 A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
8H49 G 0 A_JumpIfInventory("TroutiusIsAatrox",1,"AatroxEnd")
8H49 G 0 A_GiveInventory("TroutiusHPRegain_P")
8H49 G 0 A_PlaySound("wep/MM8BassWhat",4)
8H49 G 1 A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
8H49 F 0 A_JumpIfInventory("TroutiusIsAatrox",1,"AatroxEnd")
8H49 F 0 A_GiveInventory("TroutiusHPRegain_P")
8H49 F 0 A_PlaySound("wep/MM8BassWhat",5)
8H49 F 1 A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
8H49 G 0 A_JumpIfInventory("TroutiusIsAatrox",1,"AatroxEnd")
loop
AatroxEnd:
8H49 F 2
8H49 E 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 E 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8H49 E 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8H49 E 2
8H49 D 2
8H49 A 2
Goto ReadyX2

Fire:
8H49 A 0 A_JumpIfInventory("UnholyPower1500",1500,"FireRageBegin")
8H49 A 0 A_JumpIfInventory("TroutiusEXChance",1,"FireEX")
8H49 A 0 A_JumpIfInventory("TroutiusDashFlag",1,"ChunLiNews")
8H49 A 0 A_GiveInventory("TroutiusEXChance",1)
8H49 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H49 A 0 A_FireCustomMissile("TroutiusShot",random(-5,5),0,8,0)
8H49 B 2 A_WeaponReady(4)
8H49 C 1 A_GiveInventory("UnholyBossAmmo150",1)
8H49 A 1 A_TakeInventory("TroutiusEXChance")
Goto ReadyX
FireEX:
8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100",20,"FireEXReal")
8H49 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H49 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 B 1 A_TakeInventory("TroutiusDashFlag",1)
8H49 C 1 A_GiveInventory("UnholyBossAmmo150",1)
8H49 A 1
Goto ReadyX

FireEXReal:
8H49 A 0 A_TakeInventory("VivifyDelay7",1)
8H49 A 0 A_TakeInventory("TroutiusEXChance")
8H49 A 0 A_Refire(1)
8H49 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H49 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
//8H49 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8H49 B 0 A_TakeInventory("UnholyBossAmmo100",20)
8H49 B 0 A_ScaleVelocity(0.25)
8H49 B 0 A_ChangeVelocity(-Cos(pitch)*25,0,sin(pitch)*20,CVF_RELATIVE) //15 - 10
8H49 B 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H49 B 0 A_FireCustomMissile("TroutiusEXShot",0,0,8,0)
8H49 B 2
8H49 BCCAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo150",1)
Goto ReadyX
Altfire: //Limiter of 3 - 3 dashes ammo thing.
8H49 A 0 A_JumpIfInventory("TroutiusEXChance",1,"FireEX")
8H49 A 0 A_JumpIfInventory("UnholyBossAmmo100",20,"TroutDasher")
goto ReadyX
TroutDasher:
8H49 D 0 A_TakeInventory("UnholyBossAmmo100",20)
8H49 D 0 A_GiveInventory("TroutiusDashFlag",1)
8H49 D 0 A_Refire(1)
8H49 D 0 A_PlaySoundEx("weapon/chargekick","Weapon")
8H49 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H49 D 0 A_Recoil(-35)
8H49 D 0 ThrustThingZ(0,40,0,0)
8H49 DEFFF 2  // A_WeaponReady(8)  // causes PlayerPropertyStopped leakage
8H49 F 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
Goto TroutDashWait
TroutDashWait:
8H49 F 1 A_WeaponReady(8)
8H49 F 0 A_CheckFloor("TroutDashStop")
loop
Re_TroutDasher:
8H49 E 0 A_JumpIfInventory("UnholyBossAmmo100",20,"TroutDasher")
8H49 E 4
8H49 D 4
8H49 A 4
goto ReadyX
TroutDashStop:
8H49 F 0 A_TakeInventory("TroutiusDashFlag",1)
8H49 F 0 A_Refire("Re_TroutDasher")
//8H49 A 15
8H49 E 4
8H49 D 4
8H49 A 4
goto ReadyX

ChunLiNews:
8H49 A 0 A_JumpIfInventory("UnholyBossAmmo150",150,"ChunLiPowers")
8H49 E 2
8H49 E 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H49 E 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 E 0 A_TakeInventory("TroutiusEXChance")
8H49 E 2 A_TakeInventory("TroutiusDashFlag",1)
8H49 D 4
8H49 A 4
goto ReadyX


ChunLiPowers:
8H49 H 0 A_GiveInventory("VivifyDelay7")
8H49 H 0 A_TakeInventory("UnholyBossAmmo150",200)
8H49 H 0 A_TakeInventory("TroutiusDashFlag")
8H49 H 0 A_Refire(1)
8H49 H 2 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H49 I 0 A_Recoil(-30)
8H49 I 0 ThrustThingZ(0,30,0,0)
8H49 I 0 A_PlaySoundEx("weapon/tengudash","Weapon")
8H49 I 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H49 I 0 ThrustThingZ(0,75,0,0)
8H49 I 0 A_Recoil(-5)
8H49 I 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)//A_FireBullets(0,0,0,0,"Kickwallcheck2",FBF_NOFLASH,64)
8H49 I 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 I 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 I 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 I 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 0 //A_Recoil(-5)
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 0 //A_Recoil(-1)
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 0 A_Recoil(5)//-5
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 0 //A_Recoil(-5)
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 0 A_JumpIfInventory("UnholyBossAmmo100",20,"ChunLiPowersEX")
8H49 J 0 //A_Recoil(-5)
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 K 2 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 K 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
Goto ChunLiWait
ChunLiPowersEX:
8H49 J 0 A_GiveInventory("TroutiusEXChance",1)
8H49 J 0 //A_Recoil(-5)
8H49 J 0 A_SpawnItemEx("Kickwallcheck",0,0,28,64)
8H49 J 0 A_SpawnItemEx("TroutiusLiftup",0,0,-50)
8H49 J 0 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_WeaponReady(8)
8H49 J 0 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_WeaponReady(8)
8H49 J 0 A_FireCustomMissile("TroutiusKickers",0,0,8,0)
8H49 J 1 A_WeaponReady(8)
8H49 K 0 //A_TakeInventory("UnholyBossAmmo150")
8H49 K 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H49 K 2 A_WeaponReady(8)
8H49 K 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H49 K 2 A_WeaponReady(8)
Goto ChunLiWaitEX
ChunLiWaitEX:
8H49 K 2 A_WeaponReady(8)
8H49 K 0 A_CheckFloor("ChunLiLand")
loop
ChunLiWait:
8H49 K 2 A_WeaponReady(12)
8H49 K 0 A_CheckFloor("ChunLiLand")
loop

ChunLiLand:
TNT1 A 2 A_WeaponReady(12)
TNT1 A 0 A_GiveInventory("VivifyDelay7")
TNT1 A 0 A_TakeInventory("TroutiusEXChance")
TNT1 A 2 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H49 FEDA 4 A_GiveInventory("UnholyBossAmmo150",20)
8H49 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
goto ReadyX
}
}

actor TroutiusDashFlag : UOnce {}
actor TroutiusEXChance : UOnce {}
actor TroutiusIsAatrox : UOnce {}

actor TroutiusRegainEffect : BasicGraphicEffect
{
States
{
SpawnFrame:
TNT1 A 0
TNT1 A 1 A_ScaleVelocity(4.0)//A_FaceTarget
TNT1 A 0 A_SpawnItemEx("TroutiusRegainEffect2",0,0,0,-momx*0.1,-momy*0.1,-momz*0.1,0,9)
stop
}
}

actor TroutiusRegainEffect2 : BasicGraphicEffect
{
ReactionTime 14
scale 2.0
states
{
SpawnFrame:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,3,5,7,9,11,13,15)
SpawnFrameLoop:
6P06 A 0 A_CountDown
6P06 A 1 A_SetScale(ScaleX-0.1)
6P06 A 0 A_CountDown
6P06 A 1 A_SetScale(ScaleX-0.1)
6P06 B 0 A_CountDown
6P06 B 1 A_SetScale(ScaleX-0.1)
6P06 B 0 A_CountDown
6P06 B 1 A_SetScale(ScaleX-0.1)
6P06 C 0 A_CountDown
6P06 C 1 A_SetScale(ScaleX-0.1)
6P06 C 0 A_CountDown
6P06 C 1 A_SetScale(ScaleX-0.1)
6P06 D 0 A_CountDown
6P06 D 1 A_SetScale(ScaleX-0.1)
6P06 D 0 A_CountDown
6P06 D 1 A_SetScale(ScaleX-0.1)
loop
}
}

actor TroutiusHPRegain_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH) * 0.50,"GiveHealth")
goto Pickup3
GiveHealth:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 20)
stop
Pickup3:
TNT1 A 0 A_GiveInventory("TroutiusIsAatrox",1)
stop
}
}

actor TroutiusRageDash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_ChangeVelocity(45*cos(pitch),0,33*-sin(pitch),3)
TNT1 A 0 //ACS_NamedExecuteAlways("uh_missileyank",0,96)
TNT1 A 1 A_SpawnItemEX("TroutiusRageWallCheck",0,0,8,momx,momy,momz,0,8)
TNT1 A 1 A_SpawnItemEX("TroutiusRageDashYank",0,0,0,momx,momy,momz,0,8)
TNT1 A 0 A_TakeInventory("UnholyPower1500",10)
stop
}
}

actor TroutiusRageDashYank : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 2 ACS_NamedExecuteWithResult("uh_missileyank",96)
stop
}
}


actor TroutiusFireFX1 : BasicGraphicEffect
{
Translation "192:192=208:208","198:198=102:102"
+FORCEXYBILLBOARD
-NOINTERACTION
renderstyle "Translucent"
alpha 0.85
radius 6
height 6
scale 4.5
States
{
SpawnFrame:
X_8C EEFFG 2 A_Fadeout
stop
}
}

actor TroutiusFireFX2 : TroutiusFireFX1
{
States
{
SpawnFrame:
X_8C AAABBCCDD 3 A_Fadeout
stop
}
}


actor TroutiusFireFX3 : BasicProjectile
{
damagetype "TroutiusFire"
Obituary "%o was bass boosted by Troutius (%k)'s ass kicker."
+RIPPER
-NOGRAVITY
+HEXENBOUNCE
renderstyle "Translucent"
alpha 0.8
Damage (20)
Height 10
Radius 10
speed 34
Scale 5
States
{
Spawn:
X_BG D 2 A_Fadeout
X_BG CC 0 A_SpawnItemEx("TroutiusFireFX2",random(-3,3),random(-3,3),random(-3,3),random(2,8),random(2,8),random(-8,8),random(0,359),1) 
X_BG C 2 A_Fadeout
X_BG BB 0 A_SpawnItemEx("TroutiusFireFX1",random(-3,3),random(-3,3),random(-3,3),random(2,8),random(2,8),random(-8,8),random(0,359),1) 
X_BG B 2 A_Fadeout
X_BG AA 0 A_SpawnItemEx("TroutiusFireFX1",random(-3,3),random(-3,3),random(-3,3),random(2,8),random(2,8),random(-8,8),random(0,359),1) 
X_BG A 2 A_Fadeout
X_BG AA 0 A_SpawnItemEx("TroutiusFireFX1",random(-3,3),random(-3,3),random(-3,3),random(2,8),random(2,8),random(-8,8),random(0,359),1) 
stop
}
}

actor TroutiusKickers : BasicProjectile
{
Translation "192:192=208:208","198:198=102:102"
damagetype "TroutiusFire"
Obituary "%o was bass boosted by Troutius (%k)'s ass kicker."
+RIPPER
renderstyle "Translucent"
alpha 0.75
damage (20)
Radius 5
Height 5
speed 30
scale 2.5
States
{
Spawn:
TNT1 A 0
TMFX A 1 A_Explode(85,65,0)

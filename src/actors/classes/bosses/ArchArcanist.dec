actor ArchArcanist : BossBase
{
player.scoreIcon "UB018MUG"
player.soundclass "ArchArcanist"
player.damagescreencolor "black"
player.forwardmove 1.0, 1.0
player.sidemove 1.0, 1.0
player.jumpz 13
Player.MaxHealth 2750
Health 2750
player.morphweapon "ArchArcanist_W"
player.weaponslot 1, "ArchArcanist_W"
player.weaponslot 2, "ArchArcanist_W2"
player.weaponslot 3, "ArchArcanist_W3"
States
{
Spawn:
DAR4 A 0
DAR4 B 1
DAR4 A 1 A_JumpIf(!CallACS("core_checkfooting"), "DarkLeap")
Goto Spawn+2
See:
DAR4 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "DarkLeap")
Goto Spawn
Missile:
DAR4 F 1
DAR4 F 0 A_JumpIf(!CallACS("core_checkfooting"), "DarkLeap")
DAR4 F 4
DAR4 G 4
goto Spawn+2
ClassPain:
DAR4 H 0
Goto MegamanPain
ClassDeath:
DAR4 H 0
Goto MegamanDeath
DarkLeap:
DAR4 Y 1 A_SpawnItemEx("ElementalDamager")
DAR4 Y 0 A_JumpIf(CallACS("core_checkfooting"), "Spawn")
loop
}
}

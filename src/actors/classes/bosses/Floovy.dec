actor Floovy : BossBase {
  player.soundclass "BOSS090"
  player.forwardmove 1.2, 1.2
  player.sidemove 1.2, 1.2
  player.jumpz 12
  Player.MaxHealth 5000
  Health 5000
  player.morphweapon "Floovy_W"
  States {
   Spawn:
    8A75 A 0
    8A75 B 1
    8A75 A 1
    Goto Spawn+2
   See:
    8A75 BCDE 5
    Goto Spawn
   Missile:
    8A75 FFFFFFFFF 1 A_JumpIfInventory("FloovyPlugFlag", 1, "Plugging")
    goto Spawn+2
   Plugging:
    8A75 F 1
    8A75 F 0 A_JumpIfInventory("FloovyPlugFlag", 1, "Plugging")
    goto Spawn+2
   ClassPain:
    8A75 H 0
    Goto MegamanPain
   ClassDeath:
    8A75 H 0
    Goto MegamanDeath
  }
}

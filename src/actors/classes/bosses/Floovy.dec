actor Floovy : BossBase {
  Player.ScoreIcon "UB075MUG"
  Player.SoundClass "Floovy"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 5000
  Health 5000
  Player.MorphWeapon "Floovy_W"
  States {
   Spawn:
    8A75 A 0
    8A75 B 1
    8A75 A 1
    goto Spawn+2
   See:
    8A75 BCDE 5
    goto Spawn
   Missile:
    8A75 FFFFFFFFF 1 A_JumpIfInventory("FloovyPlugFlag", 1, "Plugging")
    goto Spawn+2
   Plugging:
    8A75 F 1
    8A75 F 0 A_JumpIfInventory("FloovyPlugFlag", 1, "Plugging")
    goto Spawn+2
   ClassPain:
    8A75 H 0
    goto MegamanPain
   ClassDeath:
    8A75 H 0
    goto MegamanDeath
  }
}

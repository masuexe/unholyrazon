actor RedHero_W_ScriptBar : ScriptBar {}
actor RedHero_W : BaseUnholyBossWep
{
Tag "$TAG_Boss038_W"
Obituary "%o was vanquished by \cgRed Anti-Unholy Elite\c- (%k)!"
Inventory.Pickupmessage "\cgAGAINST THE EVIL!"
weapon.ammotype "UnholyBossAmmo150"
//weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8H38 [ 1
wait

Deselect:
8H38 A 0
goto DeselectSwap
Select:
8H38 A 0
goto SelectSwap

Ready:
8H38 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, REDHERO_DYE)
8H38 A 6 
8H38 A 0 A_SpawnItemEX("RedHero_Empower_Watcher")
8H38 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H38 A 0 A_JumpIfInventory("RedHero_Empower",1,"ReadyX3")
8H38 A 0 A_JumpIfInventory("UnholyBossAmmo150",150,"ReadyX2")
8H38 A 2 A_WeaponReady(8)
8H38 A 0 A_GiveInventory("UnholyBossAmmo150",2)
loop
ReadyX2:
8H38 A 0 A_JumpIfInventory("RedHero_Empower",1,"ReadyX3")
8H38 A 2 A_WeaponReady
8H38 A 0 A_GiveInventory("UnholyBossAmmo150",2)
loop
ReadyX3: //Empower
8H38 A 2 A_WeaponReady
8H38 A 0 A_JumpIfInventory("RedHero_Empower",1,"ReadyX3")
Goto ReadyX

Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//1001
TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag")*0.50+1,"Flash.GetHypedForPain")
TNT1 A 1
loop
Flash.GetHypedForPain:
TNT1 A 0 A_PlaySound("weapon/mirrorabsorb")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_runeplayer", 0, true, RUNE_STRENGTH)
TNT1 A 1
TNT1 A 4 //ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
//stop
Flash.Old:
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", REDHERO_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
loop

Fire:
8H38 A 0 A_JumpIfInventory("RedHero_Empower",1,"Empowered_Fire")
8H38 A 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H38 A 0 A_FireCustomMissile("RedHeroShot",0,0,8,0)
// Recoil 18 + recover 21 = 39 tics. Peak (48,64). Ammo x2 every 3 tics (13 gives).
8H38 B 1 Offset(8, 36) A_GiveInventory("UnholyBossAmmo150", 2)
8H38 B 1 Offset(16, 42) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 C 1 Offset(28, 52)
8H38 C 1 Offset(40, 60) A_GiveInventory("UnholyBossAmmo150", 2)
8H38 B 1 Offset(48, 64) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 B 1 Offset(48, 64)
8H38 A 1 Offset(44, 62) A_GiveInventory("UnholyBossAmmo150", 2)
8H38 A 1 Offset(36, 56) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(28, 50)
8H38 A 1 Offset(20, 44) A_GiveInventory("UnholyBossAmmo150", 2)
8H38 A 1 Offset(14, 40) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(10, 36)
8H38 A 1 Offset(8, 34) A_GiveInventory("UnholyBossAmmo150", 2)
8H38 A 1 Offset(6, 34) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(4, 34)
8H38 AAAAAAAA 3 Offset(2, 34) A_GiveInventory("UnholyBossAmmo150", 2)
goto ReadyX
Empowered_Fire:
8H38 A 0 A_TakeInventory("RedHero_Empower",25) //50
8H38 A 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H38 A 0 A_FireCustomMissile("RedHeroShot_Empowered",0,0,8,0)
// Stronger recoil than Fire. Peak (72,88). Same 18+21=39 tics.
8H38 B 1 Offset(12, 40)
8H38 B 1 Offset(24, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 C 1 Offset(40, 68)
8H38 C 1 Offset(56, 80) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 B 1 Offset(68, 86)
8H38 B 1 Offset(72, 88) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 C 1 Offset(72, 88)
8H38 C 1 Offset(64, 82) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 B 1 Offset(52, 72)
8H38 B 1 Offset(40, 62) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(28, 52)
8H38 A 1 Offset(18, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(12, 40)
8H38 A 1 Offset(8, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 1 Offset(4, 34)
8H38 AAAAAAAA 3 Offset(2, 34)
goto ReadyX3
AltFire:
8H38 A 0 A_JumpIfInventory("UnholyBossAmmo150",150,"Overloaded")
Goto ReadyX
Overloaded:
8H38 A 0 A_TakeInventory("UnholyBossAmmo150",150)
8H38 A 0 A_GiveInventory("RedHero_Empower",250)
8H38 A 0 A_PlaySoundEx("weapon/lightningbolt","SoundSlot6")
// A→B→C charge raise, C tremble + FX, then ready. 14 tics (Rage skips ~half).
8H38 A 1 Offset(0, 38)
8H38 A 1 Offset(0, 40) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 B 1 Offset(0, 30)
8H38 B 1 Offset(0, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 C 1 Offset(0, 20)
8H38 C 1 Offset(0, 18) A_SpawnItemEx("RedHero_Indication_FX1")
8H38 B 1 Offset(0, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 B 1 Offset(0, 18)
8H38 C 1 Offset(0, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 C 1 Offset(0, 18)
8H38 B 1 Offset(0, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H38 A 3 A_WeaponReady(14)
Goto ReadyX3

/*PlasmaPls:
8H38 C 0 A_TakeInventory("UnholyBossAmmo150",150)
8H38 C 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 C 2
8H38 B 1
8H38 B 0 A_GiveInventory("RedPlasmaThingyAttack_P2",1)
8H38 B 1
8H38 C 2
8H38 B 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 B 2
8H38 C 1
8H38 C 0 A_GiveInventory("RedPlasmaThingyAttack_P2",1)
8H38 C 1
8H38 B 2
8H38 C 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 C 2
8H38 B 1
8H38 B 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 B 1
8H38 C 2
8H38 B 0 A_GiveInventory("RedPlasmaThingyAttack_P2",1)
8H38 B 2
8H38 C 1
8H38 C 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 C 1
8H38 B 2
8H38 C 0 A_GiveInventory("RedPlasmaThingyAttack_P2",1)
8H38 C 2
8H38 B 1
8H38 B 0 A_GiveInventory("RedPlasmaThingyAttack_P1",1)
8H38 B 1
8H38 C 2
8H38 B 2
8H38 A 18
Goto ReadyX*/
}
}

actor RedHero_Empower : Inventory
{
inventory.amount 1
inventory.maxamount 250 //100
}

actor RedHero_Empower_Watcher : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 //A_TakeFromTarget("",1)
goto Spawn2
Spawn2:
TNT1 A 0 
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
TNT1 A 1 A_JumpIfInTargetInventory("RedHero_Empower",1,"Spawn3")
//TNT1 A 1 A_TakeFromTarget("RedHero_Empower",2)
loop
Spawn3:
TNT1 A 0 
TNT1 A 0 A_GiveToTarget("RedHero_FX_P")
TNT1 A 2 A_TakeFromTarget("RedHero_Empower",2)
TNT1 A 0 A_JumpIfInTargetInventory("RedHero_Empower",1,"Spawn3")
goto Spawn2
End:
TNT1 A 1
stop
}
}

actor RedHero_FX_P : CustomInventory
{
States
{
Pickup:
TNT1 AA 0 A_SpawnItemEx("RedHero_Visual_FX",random(-32,32),random(-32,32),0,momx,momy,20,0,8)
stop
}
}

actor RedHero_Visual_FX : BasicClientSide
{
Translation "198:198=41:41", "192:192=4:4"
States
{
Spawn:
CHPO X 5
stop
}
}

actor RedHeroShot : BasicProjectile
{
Translation "192:192=41:41", "198:198=185:185", "202:202=171:171", "199:199=40:40"
damagetype "HeroRed"
Obituary "%o was vanquished by \cgRed Anti-Unholy Elite\c- (%k)!"
+SKYEXPLODE
+EXPLODEONWATER
Damage (200) //250
radius 12
height 15
Speed 48 //60
scale 2.5
States
{
Spawn:
X_0A ABCBC 2
Y_0A B 2
X_0A CBCB 2
Y_0A C 2
goto Spawn+1
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
TNT1 A 0 A_Explode(175,148,0) //300
X_8B ABCDEF 2
stop
}
}

actor RedHeroShot_Empowered : BasicProjectile
{
Translation "192:192=41:41", "198:198=43:43"//, "202:202=171:171", "199:199=40:40"
damagetype "HeroRed"
Obituary "%o was vanquished by \cgRed Anti-Unholy Elite\c- (%k)!"
+SKYEXPLODE
+EXPLODEONWATER
Damage (350)
radius 22
height 22
Speed 60
scale 2.5
States
{
Spawn:
CHBU ABCD 2
loop
Death:
TNT1 A 0
TNT1 A 0 Radius_Quake(4,10,0,32,0) //5 rad
TNT1 A 1 A_SpawnItemEX("RedHeroShot_EmpExplode")
stop
}
}

actor RedHeroShot_EmpExplode : BasicExplosion
{
Translation "192:192=4:4", "198:198=41:41"
Damagetype "HeroRed"
Obituary "%o was vanquished by \cgRed Anti-Unholy Elite\c- (%k)!"
Scale 3.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/drillexplode","Weapon")
TNT1 A 0 A_Explode(200,164,0,0,8)
X_8B ABCDEF 2 A_SpawnItemEx("RedHeroShot_EmpExplode2",random(-120,120),random(-120,120),random(-96,96),0,0,0,0,1)
stop
}
}

actor RedHeroShot_EmpExplode2 : RedHeroShot_EmpExplode
{
Scale 1.5
States
{
Spawn:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/astrocrush2","Weapon") //
TNT1 A 0 A_Explode(75,80,0)
X_8B ABCDEF 2 A_Fadeout(0.08)
stop
}
}

actor RedHero_Indication_FX1 : BasicGraphicEffect
{
Translation "192:192=4:4", "198:198=41:41"
scale 3.0
States
{
SpawnFrame:
TNT1 A 1
6P08 PQR 3
stop
}
}


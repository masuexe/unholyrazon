actor VoidWalker : BossBase {
  Player.ScoreIcon "UB054MUG"
  Player.SoundClass "VoidWalker"
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 12
  Player.MaxHealth 4750
  Health 4750
  Player.MorphWeapon "VeryFunOrbWep"
  Player.WeaponSlot 1, "VoidWalker_W"
  Player.WeaponSlot 2, "VoidWalker_W2"
  Player.WeaponSlot 3, "VoidWalker_W3"
  Player.WeaponSlot 4, "VoidWalker_W4"
  Player.WeaponSlot 5, "VoidWalker_W5"
  States {
   Spawn:
    ASTM A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Spawn3D")
    ASTM B 1
   SpawnLoop:
    ASTM A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Spawn3DLoop")
    ASTM A 1
    loop
   Spawn3D:
    ASTV A 0
    ASTV B 1
   Spawn3DLoop:
    ASTV A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Idle3D")
    goto Spawn
   Idle3D:
    ASTV A 1
    goto Spawn3DLoop
   See:
    ASTM B 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "See3D")
    ASTM BCDE 5
    goto Spawn
   See3D:
    ASTV BCDE 5
    goto Spawn3D
   Missile:
    ASTM F 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Missile3D")
    ASTM F 5
    ASTM G 4
    goto SpawnLoop
   Missile3D:
    ASTV F 5
    ASTV G 4
    goto Spawn3DLoop
   ClassPain:
    ASTM H 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "ClassPain3D")
    ASTM H 0
    goto MegamanPain
   ClassPain3D:
    ASTV H 0
    goto MegamanPain
   ClassDeath:
    ASTM H 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "ClassDeath3D")
    ASTM H 0
    goto MegamanDeath
   ClassDeath3D:
    ASTV H 0
    goto MegamanDeath
  }
}

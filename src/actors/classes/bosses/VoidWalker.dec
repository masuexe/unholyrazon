actor VoidWalker : BossBase {
  Player.ScoreIcon "UB054MUG"
  Player.SoundClass "VoidWalker"
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 12
  Player.MaxHealth 4750
  Health 4750
  Player.MorphWeapon "VeryFunOrbWep"
  Player.WeaponSlot 1, "VoidWalker_W"
  Player.WeaponSlot 2, "VoidWalker_W2"
  Player.WeaponSlot 3, "VoidWalker_W3"
  Player.WeaponSlot 4, "VoidWalker_W4"
  Player.WeaponSlot 5, "VoidWalker_W5"
  States {
   Spawn:
    ASTM A 0
    ASTM B 1
    ASTM A 1
    goto Spawn+2
   See:
    ASTM BCDE 5
    goto Spawn
   Missile:
    ASTM F 5
    ASTM G 4
    goto Spawn+2
   ClassPain:
    ASTM H 0
    goto MegamanPain
   ClassDeath:
    ASTM H 0
    goto MegamanDeath
  }
}

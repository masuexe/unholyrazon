actor AstromancerComplex_W_NormalBar : NormalBar {args 64, 62}
actor AstromancerComplex_W_SecondBar : SecondBar {args 161, 62}

actor AstromancerComplex_W : BaseUnholyBossWep {
  Tag "$TAG_AstromancerComplex_W"
  Obituary "%o was broken by \ctAstromancer Crasher\c- (%k)!"
  Inventory.Pickupmessage "\cvDON'T BREAK IT!"
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyPower1500"
  States {
   Spawn:
    8H29 [ 1
    wait

   Deselect:
    8H29 A 0
    goto DeselectSwap
   Select:
    8H29 A 0
    goto SelectSwap

   Ready:
    8H29 A 0  // Initial setup: boss morph hook.
    8H29 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ASTROMANCERCOMPLEX_DYE)
    goto ReadyX
   ReadyX:
    8H29 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX2")
    8H29 A 2 A_WeaponReady(WRF_NOSECONDARY)
    8H29 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    loop
   ReadyX2:
    8H29 A 2 A_WeaponReady
    8H29 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    loop

   Flash:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Flash_Rage")
    TNT1 A 0 A_SpawnItemEx("AstromancerRadius", 0, 0, 28, velx, vely, velz, 0, 8, 0)
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("AstromancerRadius", 0, 0, 28, velx, vely, velz, 0, 8, 0)
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, "Flash")
    stop
   Flash_Rage:
    TNT1 A 0 A_SpawnItemEx("AstromancerRadius", 0, 0, 28, velx, vely, velz, 0, 8, 0)
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("AstromancerRadius", 0, 0, 28, velx, vely, velz, 0, 8, 0)
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("ShieldCheck", 1, "Flash")
    stop

   Fire:
    8H29 A 0 A_JumpIfInventory("ShieldCheck", 1, "HomingAttack")
    8H29 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "PinpointMeteorAttack")
    8H29 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H29 A 0 A_GiveInventory("ShieldCheck")
    8H29 A 1 A_GunFlash
    goto ShieldActive

   ShieldActive:
    8H29 B 0 A_SpawnItemEx("AstromancerShieldWarper", 0, 0, 28, 0, 0, 0, 0, 1)
    8H29 B 2 Offset(18, 35) A_GiveInventory("UnholyBossAmmo200", 1)
    8H29 BCCC 2 Offset(-2, 21) A_GiveInventory("UnholyBossAmmo200", 1)
    goto Shield
   Shield:
    8H29 C 2 Offset(-2, 21) A_WeaponReady(1)
    8H29 C 0 A_GiveInventory("UnholyBossAmmo200", 2)
    goto Shield

   HomingAttack:
    8H29 A 0 A_TakeInventory("ShieldCheck")
    8H29 C 5 Offset(-2, 21) A_FireCustomMissile("AstromancerC_ShotM", 0, 0, 0, 0)
    8H29 CB 2
    8H29 B 2 Offset(-2, 21)
    8H29 B 2 Offset(18, 35)
    8H29 A 7 A_WeaponReady(14)
    goto ReadyX

   PinpointMeteorAttack:
    8H29 D 2
    8H29 EE 2 Offset(-3, 30)
    8H29 E 0 A_TakeInventory("UnholyPower1500", 1500)
    8H29 E 1 Offset(-3, 30) A_FireCustomMissile("AstromancerC_Target", 0, 0, 0, 0)
    8H29 E 2 Offset(-3, 30)
    8H29 A 5 A_WeaponReady(14)
    goto ReadyX

   AltFire:
    8H29 A 1 A_JumpIfInventory("UnholyBossAmmo200", 200, "AstroCRASH")
    goto ReadyX
   AstroCRASH:
    8H29 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8H29 A 0 A_TakeInventory("ShieldCheck")
    8H29 A 0 A_PlaySound("weapon/timestopper", 1, 1.0)
    8H29 D 2 A_FireCustomMissile("AstromancerC_ShotA", 0, 0, 0, 0)
    8H29 EEE 2 Offset(-3, 30)
    8H29 D 2 A_WeaponReady(14)
    8H29 A 2
    goto ReadyX
  }
}

actor AstromancerShieldWarper : ShieldWarper_UH {
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  // +BRIGHT
  States {
   Shield:
    8P30 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "ShieldR")
    8P30 AABBCCDD 1 A_Warp(AAPTR_TARGET, 0, 0, 28, 0, 24)
    loop
   ShieldR:
    8P30 ABCD 1 A_Warp(AAPTR_TARGET, 0, 0, 28, 0, 24)
    goto Shield
  }
}

actor AstromancerRadius : BasicExplosion {
  DamageType "Astromancer"
  Obituary "%o was broken by an \ctAstromancer\c- (%k)!"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_Explode(168, 148, 0, 0, 16)
    stop
  }
}

actor AstromancerC_ShotM : BasicProjectile {
  Translation "192:192=161:161", "198:198=62:62"
  DamageType "Astromancer"
  Obituary "%o was broken by \ctAstromancer Crasher\c- (%k)!"
  +RIPPER
  +SEEKERMISSILE
  +SCREENSEEKER
  ReactionTime 20
  Damage (45)
  Speed 35
  Radius 12
  Height 12
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    8P30 ABCD 2 A_SeekerMissile(2, 10, SMF_LOOK, 55, 10)
    8P30 A 0 A_CountDown
    goto Spawn+2
   Death:
    TNT1 A 0
    stop
  }
}

actor AstromancerC_ShotA : FastProjectile {
  +DONTBLAST
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUACTORS
  +DONTREFLECT
  Damage 0
  Radius 16
  Height 16
  Speed 1000
  Scale 4.0
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:
    TNT1 A 0 A_PlaySound("weapon/timestopper", 1, 1.0)
    TNT1 A 0 A_GiveToTarget("UH_TargetMarker")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("AstromancerC_ShotA2", random(0, 250), 0, random(256, 320), 0, 0, random(-30, -25), random(0, 359))
    stop
  }
}

actor AstromancerC_ShotA1 : BasicProjectile {
  Translation "192:192=161:161", "198:198=62:62"
  DamageType "Astromancer"
  Obituary "%o was broken by \ctAstromancer Crasher\c- (%k)!"
  +RIPPER
  +DONTSPLASH
  -NOGRAVITY
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  BounceFactor 0.80
  WallBounceFactor 0.80
  BounceCount 4
  Damage (150)
  Radius 24
  Height 24
  Speed 10
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    8P30 ABCD 2
    goto Spawn+2
  }
}

actor AstromancerC_ShotA2 : BasicProjectile {
  Translation "192:192=161:161", "198:198=62:62"
  DamageType "Astromancer"
  Obituary "%o was broken by \ctAstromancer Crasher\c- (%k)!"
  +RIPPER
  +NOINTERACTION
  ReactionTime 100
  Damage (0)
  Height 24
  Radius 24
  Speed 1
  Scale 5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8, 9)
    X_8B XXXYYYZZZ 1 A_JumpIf(ceilingz - z > 25, "Spawn2")
    X_8B X 0 A_JumpIf(velz == 0, "Death")
    X_8B X 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B X 0 A_ChangeFlag("RIPPER", 0)
    X_8B X 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B XYZ 3
    X_8B X 0 A_JumpIf(velz == 0, "Death")
    X_8B X 0 A_CountDown
    goto Spawn2+2
   Death:
    X_8B A 0 A_PlaySoundEx("weapons/mm8/astrocrushexplode", "Weapon")
    X_8B A 0  // A_SetGravity(0.0)
    X_8B A 0 A_Explode(85, 256, 0, 0, 32)
    X_8B ABCDEF 2
    stop
  }
}


actor AstromancerC_Target : ProjSpawnFuncActorFast {
  Translation "192:192=161:161", "198:198=62:62"
  +DONTBLAST
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUACTORS
  +DONTREFLECT
  Damage 0
  Radius 16
  Height 16
  Speed 1000
  Scale 4.0
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 4
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 4
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 4
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL R 0 A_JumpIf(true, "DeathSpawn")
   DeathSpawn:
    EVFL R 0 A_SpawnItemEx("AstromancerC_Meteor", 0, 0, 480, 0, 0, -25)
    EVFL RST 4
    stop
  }
}

actor AstromancerC_Meteor : BasicProjectile {
  Translation "4:4=4:4", "202:202=160:160", "192:192=161:161", "198:198=59:59", "199:199=62:62"
  DamageType "Astromancer"
  Obituary "%o didn't listen to \ctAstromancer Crasher\c- (%k)'s forecast of death."
  +THRUGHOST
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  +DONTREFLECT
  ReactionTime 100
  Damage (5000)
  Radius 16
  Height 16
  Speed 0
  Scale 4.0
  States {
   Spawn:
    8P29 Q 0
    8P29 Q 0
    8P29 QQ 1 A_JumpIf(ceilingz - z > 17, "Spawn2")
    8P29 Q 0 A_JumpIf(velz == 0, "Death")
    8P29 Q 0 A_CountDown
    loop
   Spawn2:
    8P29 Q 0 A_ChangeFlag("RIPPER", 0)
    8P29 Q 0 A_ChangeFlag("NOINTERACTION", 0)
    8P29 Q 3
    8P29 Q 0 A_JumpIf(velz == 0, "Death")
    8P29 Q 0 A_CountDown
    goto Spawn2+2
   Death:
    TNT1 A 0 Radius_Quake(4, 35, 0, 10, 0)
    TNT1 A 0 A_PlaySoundEx("weapons/mm8/astrocrushexplode", "Weapon")
    TNT1 A 0 A_PlaySoundEx("weapon/astrocrush", "Voice")
    TNT1 A 0 A_PlaySoundEx("weapon/astrocrush", "Body")
    TNT1 A 0 A_Explode(2000, 640, 0, 0, 32)
    TNT1 A 0 A_JumpIf(true, "DeathFX")
   DeathFX:
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("AstromancerC_MeteorFX", random(-640, 640), random(-640, 640), random(-256, 576))
    stop
  }
}

actor AstromancerC_MeteorFX : BasicGraphicEffect {
  Translation "192:192=161:161", "198:198=62:62"
  States {
   SpawnFrame:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    TNT1 AA 1
    X_8B ABCDEF 2
    stop
  }
}

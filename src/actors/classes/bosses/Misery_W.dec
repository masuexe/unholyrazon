actor Misery_ThunderBreak : BasicProjectile {
  Translation "192:192=77:77", "198:198=8:8"  // "4:4=84:84","192:192=77:77","198:198=78:78"
  DamageType "Misery"
  Obituary "%o was smitten by \cdMisery \c-(%k)'s Lightning Bolt."
  +THRUACTORS
  +NOEXPLODEFLOOR
  +FORCEYBILLBOARD
  +FLOORHUGGER
  +DONTBLAST
  +OLDRADIUSDMG
  +PIERCEARMOR  // We live in a society.
  Damage (0)
  height 32
  radius 16
  scale 2.5  // 6, sorry but this needs to be fixed
  States {
   Spawn:
    X_BC N 0
    X_BC N 1 A_SpawnItemEx("LightningExtendElec", 0, 0, 355, 0, 0, 0, 0, 1)  // I hope this is just core.
    X_BC N 0 A_PlaySoundEx("weapon/MiseryThunder", "Weapon")
    X_BC N 0 A_Explode(250, 128, 0, 64)
    X_BC N 0 A_SpawnItemEx("Misery_ThunderBreak_WaveSP", 0, 0, 0, 0, 0, 0, 0, 0)
    X_BC N 0 Radius_Quake(4, 35, 0, 20, 0)
    X_BC NNNNNNNNN 0 A_SpawnItemEx("Misery_Smoke_Cloud_X", random(-64, 64), random(-64, 64), random(4, 64), random(-8, 8), random(-8, 8), random(-4, 4), 0, 0)  // A_SpawnItemEx("Misery_Smoke_Cloud_X",random(-32,32),random(-32,32),random(2,16),random(-20,20),random(-20,20),random(4,28),0,0) //1
    X_BC OPQR 2
    Stop
  }
}


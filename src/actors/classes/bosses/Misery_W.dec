// Thank you classes v9f DM2 shield?
actor Misery_Orb_Spinner : ProjSpawnFuncActor {
  translation "192:192=3:3", "198:198=7:7"
  damagetype "Misery_A"
  Obituary "$OB_BOSS60B"  // filler
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +GHOST
  // +INVULNERABLE
  +SHOOTABLE
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +BRIGHT
  Renderstyle "Translucent"
  Alpha 0.8
  damagefactor "Misery", 0.0
  damagefactor "Misery_A", 0.0
  damagefactor "Misery_B", 0.0
  damagefactor "Misery_C", 0.0
  painchance 0  // make 256 and give a painstate if you want to be convinced they work as intended? Also have a check there for CutterFlags/KnightFlags to jump properly
  painchance "Misery", 0
  painchance "Misery_A", 0
  painchance "Misery_B", 0
  painchance "Misery_C", 0
  //
  painchance "Telefrag", 0
  damagefactor "Telefrag", 0.0
  //
  Species "TheseOrbsAreAStupid"
  PainSound "weapon/CaveStoryBlock"
  health 0x7ffffffd
  Args 8, 25
  Damage (0)
  Radius 16
  Height 20
  Speed 0
  scale 2.5
  // X_5H ABCDE
  States {
   Spawn:
    8P60 K 0
    8P60 K 0 ACS_NamedExecuteAlways("ub_enemypain", 0)
    8P60 K 0 A_JumpIfInventory("KnightFlag", 12, "Spawn1")
    8P60 K 0 A_JumpIfInTargetInventory("Misery_Orb_Canceller", 1, "Orb_Shatter")
    8P60 K 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    8P60 K 0 A_JumpIfInTargetInventory("IsAFakeBoss", 1, "SpawnStop")
    8P60 K 0 A_JumpIfInTargetInventory("StopShield", 1, "SpawnStop")
    8P60 K 0 A_Warp(2, Args[0], 0, 32, 6, 28)
    8P60 K 1 A_Explode(Args[1]*(CallACS("uh_checkrune", RUNE_SPREAD)*2+1), radius*2, 0, 0, radius*2)
    8P60 K 0 A_SetArg(0, Args[0]+8)
    8P60 K 0 A_GiveInventory("KnightFlag", 1)
    goto Spawn+2
   Spawn1:
    8P60 K 0 A_JumpIfInTargetInventory("Misery_Orb_Canceller", 1, "Orb_Shatter")
    8P60 K 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    8P60 K 0 A_JumpIfInTargetInventory("IsAFakeBoss", 1, "SpawnStop")
    8P60 K 0 A_JumpIfInTargetInventory("StopShield", 1, "SpawnStop")
    8P60 K 0 A_Warp(2, 96, 0, 32, 6, 28)
    8P60 K 1 A_Explode(Args[1]*(CallACS("uh_checkrune", RUNE_SPREAD)*2+1), radius*2, 0, 0, radius*2)
    loop
   Around_And_Around:
    8P60 E 0 A_TakeInventory("CutterFlag")
    Goto Spawn1  // Misery_Orb_Canceller
   Orb_Shatter:  // Make the orb shatter... like orbs shattering
    TNT1 A 0  // The clouds could be smaller, maybe prettier like air just puffs out of it.
    TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    TNT1 AAAA 0 A_SpawnItemEx("Misery_Smoke_Cloud_X", random(-32, 32), random(-32, 32), random(-32, 32), random(-8, 8), random(-8, 8), random(-4, 4), 0, 0)  // 32
    TNT1 A 0 A_SpawnItemEX("Misery_Bat_SpawnerH", 0, 0, 0, 20, 0, 0, 0, SXF_NOCHECKPOSITION)
    TNT1 A 1 A_SpawnItemEX("Misery_Orb_ShatterBoom", 0, 0, 0, 0, 0, 0, 0, 0)
   Death:
    TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    TNT1 AAAA 0 A_SpawnItemEx("Misery_Smoke_Cloud_X", random(-32, 32), random(-32, 32), random(-32, 32), random(-8, 8), random(-8, 8), random(-4, 4), 0, 0)  // 32
    TNT1 A 2
    stop
   SpawnStop:
    TNT1 A 0
    TNT1 A 1
    stop
  }
}


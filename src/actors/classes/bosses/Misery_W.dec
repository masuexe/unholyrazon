actor Misery_Pinpointer : BasicFastProjectile {
  Translation "192:192=84:84", "198:198=77:77"
  Obituary "\cdMisery \c-(%k) made sure %o's life story was given various ports on various consoles."  // filler
  damagetype "Misery"
  +SKYEXPLODE
  +DONTBLAST
  // +RIPPER
  +BLOODLESSIMPACT
  +THRUGHOST  //
  reactiontime 20  // 20
  MissileHeight 8
  MissileType "Misery_Pinpointer_FX"
  damage (10)
  radius 16  // 16 //30
  height 16  // 16 //30
  speed 1000  // 1000
  Scale 2.5
  States
  {  // If the hitbox is 30 | 30, wouldn't that be... I dunno..
   Spawn:
    TNT1 A 1
    wait
   Crash:
   XDeath:
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
    TNT1 A 0 A_SpawnItemEx("Misery_PP_Target_DH", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
   Ceiling:
    TNT1 A 0 A_SpawnItemEx("Misery_PP_Target", 0, 0, -16, 0, 0, 0, 0, 1)  // -8z
    TNT1 A 1
    stop
   Death:
    TNT1 A 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    TNT1 A 0 A_JumpIf(ceilingz-z<=16, "Ceiling")
    TNT1 A 0 A_SpawnItemEx("Misery_PP_Target", -16, 0, 0, 0, 0, 0, 0, 1)  // -14x
    TNT1 A 1
    stop
  }
}


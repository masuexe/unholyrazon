actor Misery_TeleFX_Proc : BasicClientSide
{  // Make this better
  States  // I dunno if both instances should be called at the same tic.
  {  // Or it goes left and right inbetween tics.
   Spawn:  // But hey, as long as it looks pretty.
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Misery_TeleFX", 0, 0, 0, 0, 0, 0)
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("Misery_TeleFX", 0, 3, 0, 0, 0, 0)
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("Misery_TeleFX", 0, -3, 0, 0, 0, 0)
    TNT1 A 1

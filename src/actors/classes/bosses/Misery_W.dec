actor Misery_Block_Warning {
  Translation "192:192=84:84", "198:198=77:77"
  +MISSILE
  -SOLID
  +THRUACTORS
  +CLIENTSIDEONLY
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  //
  +NOINTERACTION
  //
  bouncecount 8
  bouncefactor 0.2
  wallbouncefactor 0.2
  Reactiontime 15
  radius 2
  height 2
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
    TNT1 A 0  // A_ChangeVelocity(0,0,momz,3)
    TNT1 AAAAAAAAA 1 A_JumpIf(ceilingz-z>2, "Spawn2")
    TNT1 A 0  // A_JumpIf(momz==0,"Death")
    TNT1 A  0 A_CountDown
    Goto Spawn+2
   Spawn2:
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_Jump(256, "Frame_A", "Frame_B", "Frame_C")
   Frame_A:
    6P51 D 1
    Loop
   Frame_B:
    6P51 E 1
    Loop
   Frame_C:
    X_5C A 1
    Loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TMFX ABCD 1
    stop
  }
}



    TNT1 A 0 A_PlaySoundEx("Boss/BalrogBoom", "Weapon")
    X_8B AA 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-96, 96), random(-96, 96), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B BB 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-102, 102), random(-102, 102), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B CC 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-108, 108), random(-108, 108), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B DD 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-114, 114), random(-114, 114), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B EE 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-120, 120), random(-120, 120), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B FF 1 A_SpawnItemEx("Misery_Block_Drop_Boom", random(-126, 126), random(-126, 126), random(-84, 84), 0, 0, 0, 0, 1)
    stop

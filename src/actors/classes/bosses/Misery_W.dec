actor Misery_W_ScriptBar : ScriptBar {}
actor Misery_W : BaseUnholyBossWep  // Magic_Of_Sorrow
{
  Obituary "\cdMisery \c-(%k) casted \ciA_Kill\c- on %o."  // filler
  Inventory.Pickupmessage "\cjImagine liking Curly."  // "I'm calling any of you out."
  weapon.ammotype "UnholyBossAmmo400"  // "I really will go on a tangent on why goth girls are better."
  weapon.ammotype2 "UnholyPower1000"  // "Cel, you better not take out these green texts." - Trist, unhinged.
  States {
   Spawn:
    8H60 [ 1
    wait

   Ready:
    MGCH A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    MGCH A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, MISERY_DYE)
    MGCH A 0 A_TakeInventory("StopShield")
    MGCH A 0 ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_AirJumpZ, 400000)
    // MGCH A 0 A_GiveInventory("Misery_Item", 1) //For some reason, it doesn't give it on the get go.
    MGCH A 0 A_GunFlash
    goto ReadyX
   ReadyX:  // THE FIRST READY ALWAYS
    MGCH A 2 A_GiveInventory("Misery_Ready8_P")
    MGCH A 0 A_JumpIfInventory("Misery_Cooldown", 1, "ReadyX")
    Goto ReadyY
   ReadyY:
    MGCH A 2 A_GiveInventory("Misery_Ready0_P")
    loop
   Deselect:
    MGCH C 0
    goto DeselectSwap
   Select:
    MGCH C 0
    goto SelectSwap
    /// ///

   Flash:  // Misery_Cooldown
    TNT1 A 0 A_GiveInventory("Misery_Orb_Spawner")
    goto The_Idle_Game
   The_Idle_Game:
    TNT1 A 0 A_TakeInventory("Misery_Cooldown", 1)
    TNT1 A 1 A_GiveInventory("UnholyBossAmmo400", 1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("Misery_Orb_Canceller", 1, "Gacha_Joke")
    Loop
   Gacha_Joke:  // Just so it's not instant.
    TNT1 A 0 A_TakeInventory("Misery_Cooldown", 1)
    TNT1 A 1 A_GiveInventory("UnholyBossAmmo400", 1)
    TNT1 A 0 A_TakeInventory("Misery_Cooldown", 1)
    TNT1 A 1 A_GiveInventory("UnholyBossAmmo400", 1)
    TNT1 A 0 A_TakeInventory("Misery_Orb_Canceller")
    TNT1 A 0 A_TakeInventory("Misery_Cooldown", 1)
    TNT1 A 1 A_GiveInventory("UnholyBossAmmo400", 1)
    Goto Farm_It_All_Again
   Farm_It_All_Again:  // You don't get your orbs after a few.
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_TakeInventory("Misery_Cooldown", 1)
    TNT1 A 1 A_GiveInventory("UnholyBossAmmo400", 1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 105, "Here_We_Go_Again")  // 35 tics //70 tics
    Loop
   Here_We_Go_Again:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    Goto Flash

    /// ///
   Fire:
   Charge:  //
    MGCH A 1 Offset(2, 48)
    MGCH A 1 Offset(2, 50)
    MGCH A 1 Offset(2, 51)
    MGCH A 1 Offset(2, 52)
    goto Charge0
   Charge0:
    MGCH A 0 A_JumpIfInventory("Misery_Charge", 17, "Charge1")
    MGCH A 0 A_JumpIfInventory("Misery_Charge", 16, "ChargeStart")
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 1 A_GiveInventory("Misery_Charge", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    MGCH A 0 A_Refire("Charge0")
    goto Fire1
   ChargeStart:
    MGCH A 0 A_PlaySoundEx("weapon/MiseryCharge", "Weapon")
    Goto Charge1

   Charge1:
    MGCH A 0 A_JumpIfInventory("Misery_Charge", 30, "Charge2")
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 1 Offset(2, 52) A_GiveInventory("Misery_Charge", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    MGCH A 0 A_Refire("Charge1")
    goto Fire1

   Charge2:
    MGCH A 0 A_JumpIfInventory("Misery_OverCharge", 50, "Charge33")
    MGCH A 1 Offset(2, 52) A_RailWait
    MGCH A 0  // A_SpawnItemEX("StuntDoubleFistInidicator",-10,18,29,0,0,0)
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 0 A_GiveInventory("Misery_OverCharge", 1)
    MGCH A 0 A_Refire("Charge22")
    goto Fire2
   Charge22:
    MGCH A 0 A_JumpIfInventory("Misery_OverCharge", 50, "Charge3")
    MGCH B 1 Offset(2, 52) A_RailWait
    MGCH A 0  // A_SpawnItemEX("StuntDoubleFistInidicator",-10,18,28,0,0,0)
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 0 A_GiveInventory("Misery_OverCharge", 1)
    MGCH A 0 A_Refire("Charge2")
    goto Fire2

    // A_RailWait, do you need it? Maybe? Just tryin' somethin here.
   Charge3:
    MGCH A 0 A_SpawnItemEx("Misery_ChargeFX", random(-32, 32), random(-32, 32), 0, momx, momy, 20, 0, 9)
    MGCH B 1 Offset(2, 52) A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)  // A_RailWait
    MGCH A 0  // A_SpawnItemEX("StuntDoubleFistInidicator",-10,18,29,0,0,0)
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 93)
    MGCH A 0 A_Refire("Charge33")
    goto Fire3
   Charge33:
    MGCH A 0 A_SpawnItemEx("Misery_ChargeFX", random(-32, 32), random(-32, 32), 0, momx, momy, 20, 0, 9)
    MGCH C 1 Offset(2, 52) A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)  // A_RailWait
    MGCH A 0  // A_SpawnItemEX("StuntDoubleFistInidicator",-10,18,29,0,0,0)
    MGCH A 0  // A_GiveInventory("UnholyBossAmmo250", 1)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)
    MGCH A 0 A_Refire("Charge3")
    goto Fire3

   Fire1:
    MGCH A 0 Offset(16, 5)A_TakeInventory("Misery_OverCharge")
    MGCH A 2 Offset(16, 5)A_TakeInventory("Misery_Charge")
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    MGCH A 2 Offset(4, 13)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 2 Offset(-10, 22)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-26, 32)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", 0, 0, 8, 0)
    MGCH BC 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-22, 37)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 0
    Goto ReadyX
   Fire2:
    MGCH A 0 Offset(16, 5)A_TakeInventory("Misery_OverCharge")
    MGCH A 2 Offset(16, 5)A_TakeInventory("Misery_Charge")
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    MGCH A 2 Offset(4, 13)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 2 Offset(-10, 22)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-26, 32)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", 0, 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", random(-4, 4), 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", random(-4, 4), 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", random(-6, 6), 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", random(-7, 7), 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryOrbFire", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Basic_Projectile", random(-8, 8), 0, 8, 0)
    MGCH BC 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-22, 37)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 0
    Goto ReadyX
   Fire3:
    MGCH A 0 Offset(16, 5)A_TakeInventory("Misery_OverCharge")
    MGCH A 2 Offset(16, 5)A_TakeInventory("Misery_Charge")
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    MGCH A 2 Offset(4, 13)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 2 Offset(-10, 22)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-26, 32)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryThunder", "SoundSlot7")
    MGCH B 0 A_FireCustomMissile("Misery_Bolt_Projectile", 0, 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryThunder", "SoundSlot7")
    MGCH B 0 A_FireCustomMissile("Misery_Bolt_Projectile", random(-2, 2), 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryThunder", "SoundSlot7")
    MGCH B 0 A_FireCustomMissile("Misery_Bolt_Projectile", random(-2, 2), 0, 8, 0)
    MGCH BC 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-22, 37)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 0
    Goto ReadyX

   DecideMyFate:
    MGCH A 1 A_WeaponReady(14)
    MGCH A 0 A_JumpIfInventory("UnholyPower1000", 1000, "THUNDERBREAKER")
    Goto Fire3

   THUNDERBREAKER:
    MGCH A 0 A_SpawnItemEx("Misery_ThunderBreak_PlayerFX", 0, 0, 0, 0, 0, 0, 0, 1)
    MGCH A 0 A_TakeInventory("UnholyPower1000")
    MGCH A 0 Offset(16, 5)A_TakeInventory("Misery_OverCharge")
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH B 2 Offset(16, 5)A_TakeInventory("Misery_Charge")
    MGCH C 2 Offset(4, 13)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH B 2 Offset(-10, 22)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH C 2 Offset(-26, 32)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH B 0 A_PlaySoundEx("weapon/MiseryThunder", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_ThunderBreak_Spawner", 0, 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH BABABABAAA 2 Offset(-44, 43)
    MGCH A 2 Offset(-22, 37)
    MGCH A 0
    Goto ReadyX

   Altfire:  // There is no way you're able to enter this alt with the charge.
    MGCH A 0 A_JumpIfInventory("Misery_OverCharge", 50, "DecideMyFate")
    MGCH A 2  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 2 Offset(4, 13)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-10, 22)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 2 Offset(-26, 32)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH B 0 A_PlaySoundEx("weapon/jewelsatellite", "Weapon")
    MGCH B 0 A_FireCustomMissile("Misery_Pinpointer", 0, 0, 8, 0)
    MGCH B 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH C 2 Offset(-44, 43)  // ACS_NamedExecuteWithResult("core_chargecolor", 40003)
    MGCH A 0  // ACS_NamedExecuteWithResult("core_chargecolor", 40002)
    MGCH A 2 Offset(-22, 37) A_GiveInventory("Misery_Cooldown", 100)
    Goto ReadyX

    //
   Reload:
    MGCH A 0 A_JumpIfInventory("UnholyBossAmmo400", 400, "StateNoOneAsked")
    goto ReadyX
   StateNoOneAsked:
    MGCH A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    MGCH A 0 A_Stop
    MGCH A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    MGCH A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    //
    MGCH A 2 Offset(4, 13)
    MGCH A 2 Offset(-10, 22)
    MGCH A 2 Offset(-26, 32)
    MGCH A 0 A_GiveInventory("Misery_ItemUse_P")
    MGCH B 0 A_PlaySoundEx("weapon/MiseryCharge", "Weapon")
    //
    MGCH BCBCBCBCBCBCBC 2 Offset(-44, 43)  // 28 //26 tics
    MGCH A 0 A_SpawnItemEX("Misery_Tele_SND")  //
    MGCH A 2 Offset(-22, 37) A_SpawnItemEx("Misery_Tele_Starter", 0, 0, 0)
    MGCH A 0 A_GiveInventory("Misery_ItemEnd_P")
    MGCH A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    MGCH A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    MGCH A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    MGCH AAAAA 2  // MAKING SURE YOU CAN'T SPAM THIS
    Goto ReadyX
    //
  }
}

actor Misery_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo400", 400, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0
    stop
  }
}
actor Misery_Ready8_P : Misery_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

Actor Misery_Orb_Spawner : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("Misery_Orb_Spinner", 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("Misery_Orb_Spinner", 90, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("Misery_Orb_Spinner", 180, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("Misery_Orb_Spinner", 270, 0, 0, 0)
    stop
  }
}

// Uh oh
actor Misery_ChargeFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    CHPO X 5
    stop
  }
}
//
actor Misery_Cooldown : Inventory {
  inventory.amount 1
  inventory.maxamount 100  // 100
}

// Basic Charge
actor Misery_Charge : Inventory {
  inventory.amount 1
  inventory.maxamount 30  // 40
}
// The.. "Over" charge...
actor Misery_OverCharge : Inventory {
  inventory.amount 1
  inventory.maxamount 50  // 60
}

actor Misery_Fling_10 : Basic_PainFling_H {Args 0, 10, 2}
actor Misery_Fling_30 : Basic_PainFling_H {Args 0, 30, 2}

actor Misery_Basic_Projectile : BasicProjectile
{  // You're better off extracting the... actual projectile sprites
  Translation "4:4=8:8", "210:214=77:77"
  Obituary "\cdMisery \c-(%k) eliminated %o."  // filler
  damage (150)  // 75
  damagetype "Misery_A"
  +FORCEXYBILLBOARD
  +THRUGHOST  //
  Radius 14  // 16
  Height 14  // 16
  speed 60  // 80
  scale 2.5  // 2.5
  States {
   Spawn:
    8P59 GHI 3
    loop
   Death:
    TNT1 A 0
    8P59 A 0 A_PlaySoundEX("weapon/BalrogOrbHit", "Weapon")
    8P59 BCDEF 3
    stop
  }
}

actor Misery_Bolt_Projectile : BasicProjectile {
  Translation "192:192=78:78", "198:198=77:77", "202:202=78:78", "4:4=84:84"
  Obituary "\cdMisery \c-(%k) turned %o into ashes."  // filler
  damagetype "Misery_B"
  +THRUGHOST  //
  Damage (325)  //
  Radius 25
  Height 16
  Speed 80  // 60
  scale 2.5
  States {
   Spawn:  // The SHOCKING version of Proto charge shot.
    8P60 CD 3 A_SpawnItemEx("Misery_Bolt_FX_A", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:  // Technically, the bolts spawn cloud smoke
    TNT1 A 1 A_SpawnItemEX("Misery_Bolt_Projectile_BOOM", 0, 0, 0, 0, 0, 0, 0, 1)  // You could try adding them???
    Stop
  }
}

actor Misery_Bolt_Projectile_BOOM : BasicExplosion {
  Obituary "\cdMisery \c-(%k) turned %o into ashes."  // filler
  damagetype "Misery"
  scale 2.5  // 3.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/BalrogMissileExplode", "Weapon")
    TNT1 A 0 A_Explode(75, 128, 0, 0, 64)
    TNT1 AAA 0 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-10, 10), random(-10, 10), random(-10, 10), random(-8, 8), random(-8, 8), random(-4, 4), 0, 0)  // 32
    TNT1 AAAAAA 2 A_SpawnItemEx("Misery_Bolt_Projectile_EX", random(-96, 96), random(-96, 96), random(-96, 96), 0, 0, 0, 0, 1)
    stop  // X_8B ABCDEF 2
  }
}

actor Misery_Bolt_Projectile_EX : BasicExplosion {
  Obituary "\cdMisery \c-(%k) turned %o into ashes."  // filler
  damagetype "Misery"
  scale 3.5  // 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Stop  // Unnecessary?
    // TNT1 A 0 A_PlaySoundEx("classes/thunderbolt","Weapon")
    TNT1 A 0 A_Explode(15, 48, 0, 0, 16)
    TNT1 AAAA 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    stop
  }
}

// Basic Bolt FX
// The shots look more like protobuster shots-- but you know how bland that is.
// The excuse for making the bolts projectiles and not like Magnet boss's alt is, well--
// In a FPS atmosphere, that is kinda... EEEEH at best.
// ...So just make them into a damn projectile.
actor Misery_Bolt_FX_A : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P60 OPQRST 2
    stop
  }
}

actor Misery_Smoke_Cloud : Balrog_Smoke_Cloud {}

actor Misery_Smoke_Cloud_X : Misery_Smoke_Cloud {
  alpha 0.65
  Radius 6
  Height 6
  scale 1.5
}

//
//

actor Misery_Block_Drop : BasicProjectile {
  Translation "204:204=84:84", "195:195=77:77"
  Obituary "%o's bones were broken by \cdMisery \c-(%k)'s block drop."  // filler
  damagetype "Misery_C"
  +RIPPER
  +THRUGHOST  //
  +NOINTERACTION
  Reactiontime 15
  damage (450)  // Listen, it's a giant block...
  radius 30  // 30 //20
  height 30  // 30 //12
  States {
   Spawn:
    8P60 A 0
    8P60 A 0 A_ChangeVelocity(0, 0, momz, 3)
    8P60 AAAAAAAA 1 A_JumpIf(ceilingz-z>30, "Spawn2")
    8P60 A 0 A_JumpIf(momz==0, "Death")
    8P60 A 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    8P60 A 0 A_ChangeFlag("RIPPER", 0)
    8P60 A 0 A_ChangeFlag("NOINTERACTION", 0)
    8P60 AAA 3 A_ChangeVelocity(0, 0, momz, 3)
    8P60 A 0 A_JumpIf(momz==0, "Death")
    8P60 A 0 A_CountDown
    Goto Spawn2+2
   Death:
    TNT1 A 1 A_SpawnItemEX("Misery_Block_Drop_Explode", 0, 0, 0, 0, 0, 0, 0, 0)
    stop
  }
}

actor Misery_Block_Drop_Explode : BasicExplosion {
  Translation "192:192=84:84", "198:198=77:77"
  Obituary "Despite everything, \cdMisery \c-(%k)'s block managed to kill %o."  // filler
  damagetype "Misery"
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 A_PlaySoundEx("weapon/CaveStoryQuake", "Voice")
    TNT1 A 0 A_SpawnItemEx("Misery_Block_Drop_FX_Starter", 0, 0, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_Explode(100, 164, 0, 0, 32)  // 125
    TNT1 A 0 Radius_Quake(6, 10, 0, 16, 0)

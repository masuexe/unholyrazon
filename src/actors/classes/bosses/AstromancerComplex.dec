actor AstromancerComplex : BossBase {
  Player.ScoreIcon "UB029MUG"
  Player.SoundClass "AstromancerComplex"
  Player.DamageScreenColor "purple"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 12
  Player.MaxHealth 2000
  Health 2000
  Player.MorphWeapon "AstromancerComplex_W"
  States {
   Spawn:
    STAM A 0
    STAM B 1
    STAM A 1
    goto Spawn+2
   See:
    STAM BCDE 5
    goto Spawn
   Missile:
    STAM F 5
    STAM G 4
    goto Spawn+2
   ClassPain:
    STAM H 0
    goto MegamanPain
   ClassDeath:
    STAM H 0
    goto MegamanDeath
  }
}

actor ASPDeathFlashPinpoint : BasicFastProjectile {
  Translation "192:192=185:185", "198:198=5:5"
  DamageType "BossTimeStop"
  Obituary "%o could not grasp such concepts."
  +THRUGHOST
  +DONTREFLECT
  +DONTBLAST
  +HITTRACER
  Damage (10)
  Radius 16
  Height 16
  Speed 775
  Scale 3.5
  States {
   Spawn:
    TNT1 A 1
    loop
   Crash:
    TNT1 A 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_GiveToTarget("SuperSpecimanFlag", 1)
    X_8B FEDCBA 2
    TNT1 A 10
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("ASPHarkExplodeFX", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    TNT1 A 0 A_SpawnItemEx("ASPDeathFlashKaboom")
    X_8B ABCDEF 1
    stop
   Death:
    TNT1 A 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    X_8B FEDCBA 2
    stop
  }
}


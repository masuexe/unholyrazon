  Translation "192:192=185:185", "198:198=5:5"
  Scale 20.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_PlaySound("E_B/EnemyTurn", 1, 1.0, 0, ATTN_NONE)
    TNT1 A 1 A_PlaySound("E_B/EnemyTurn", 2, 1.0, 0, ATTN_NONE)
    TNT1 A 0 A_PlaySound("E_B/EnemyTurn", 3, 1.0, 0, ATTN_NONE)
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RST 2
    EVFL R 0 A_SpawnItemEx("ASPDoomsdayMeteor", 0, 0, 480, 0, 0, -10)
    EVFL RST 2
    stop
  }
}

actor ASPDoomsdayMeteor : BasicProjectile {
  Translation "4:4=173:173", "202:202=178:178", "192:192=185:185", "198:198=5:5", "199:199=0:0"
  DamageType "ASPHell"
  Obituary "%o was in sights of \crFinal Speciman\c- (%k)'s \cmASP Doomsday\c-..."
  +RIPPER
  +NOINTERACTION
  +PIERCEARMOR
  +DONTREFLECT
  +DONTBLAST
  ReactionTime 350
  Damage (200)
  Radius 16
  Height 75
  Speed 20
  Scale 15
  States {
   Spawn:
    8P29 Q 0
    8P29 QQ 1 A_JumpIf(ceilingz - z > 76, "Spawn2")
    8P29 Q 0 A_JumpIf(velz == 0, "Death")
    8P29 Q 0 A_CountDown
    loop
   Spawn2:
    8P29 Q 0 A_ChangeFlag("RIPPER", 0)
    8P29 Q 0 A_ChangeFlag("NOINTERACTION", 0)
    8P29 Q 3
    8P29 Q 0 A_JumpIf(velz == 0, "Death")
    8P29 Q 0 A_CountDown
    goto Spawn2+2
   Death:
    TNT1 A 0 A_PlaySound("misc/hugequake", 0, 1.0, 0, ATTN_NONE)
    TNT1 A 0 A_Explode(2500, 3500, 0, 0, 256)
    TNT1 A 0 Radius_Quake(9, 35, 0, 150, 0)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ASPDoomsdayBoom", random(-1000, 1000), random(-1000, 1000), random(-200, 500))
    TNT1 A 1
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ASPDoomsdayBoom", random(-1000, 1000), random(-1000, 1000), random(-200, 500))
    TNT1 A 35
    stop
  }
}


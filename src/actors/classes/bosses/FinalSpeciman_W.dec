actor FinalSpeciman_W_ScriptBar : ScriptBar {}
actor FinalSpeciman_W : BaseUnholyBossWep {
  Tag "$TAG_FinalSpeciman_W"
  Obituary "\cfFinal Speciman\c- (%k) made a huge assumption that %o is %o in disguise."  // Obituary "\cfFinal Faggasso \c-acted demickey."
  Inventory.Pickupmessage "Hark Hark"
  Weapon.AmmoType "UnholyBossAmmo250"
  Weapon.AmmoType2 "UnholyBossAmmo200"
  States {
   Spawn:
    8L04 [ 1
    wait

   Deselect:
    8L04 A 0
    goto DeselectSwap
   Select:
    8L04 A 0
    goto SelectSwap

   Ready:
    8L04 A 0 A_GiveInventory("UnholyPowerLimit_F", 3000)
    8L04 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, FINALSPECIMAN_DYE)
    8L04 A 0 A_GiveInventory("IsSpecimanFlag")
    8L04 A 6
    goto ReadyX
   ReadyX:
    8L04 A 0 A_JumpIfInventory("UnholyBossAmmo250", 50, "ReadyX2")
    8L04 A 2 A_GiveInventory("FinalSpeciman_Ready8_P")
    loop
   ReadyX2:
    8L04 A 2 A_GiveInventory("FinalSpeciman_Ready0_P")
    loop

   Reload:
    8L04 A 0 A_JumpIfInventory("SuperSpecimanFlag", 1, "Thunder")
    goto ReadyX
   Thunder:
    8L04 A 0 A_TakeInventory("SuperSpecimanFlag")
    8L04 A 0 A_PlaySoundEx("E_B/Thunder1", "Body")
    8L04 A 2 A_FireCustomMissile("FinalF_ThunderSeeker", 0, 0, 0, 0)
    8L04 A 1
    goto ReadyX

   Fire:
    8L04 D 0 A_JumpIfInventory("UnholyPower3000", 3000, "GetALoadOfThis")
    8L04 D 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Fire2")
    8L04 D 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    8L04 D 2 Offset(-6, 25) A_FireCustomMissile("ASPMeteorPinPointer", 0, 0, 0, 8)
    8L04 DDDDD 2 Offset(-12, 18)
    8L04 D 2 Offset(-8, 23)
    8L04 B 2 Offset(-4, 28)
    8L04 B 2 Offset(-2, 30)
    8L04 B 0 A_WeaponReady(14)
    8L04 B 30
    goto ReadyX
   Fire2:
    8L04 D 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8L04 D 0 A_PlaySoundEx("wep/AlienBeam", "Weapon")
    8L04 D 2 Offset(-6, 25) A_FireCustomMissile("ASPAstralWaveSpawner_H", 0, 0, 0, 0)
    8L04 DDDDD 2 Offset(-12, 18)
    8L04 D 2 Offset(-8, 23)
    8L04 B 2 Offset(-4, 28)
    8L04 B 2 Offset(-2, 30)
    8L04 B 0 A_WeaponReady(14)
    8L04 B 45
    goto ReadyX
   GetALoadOfThis:
    8L04 D 0 A_TakeInventory("UnholyPower3000")
    8L04 D 0 A_FireCustomMissile("ASPDoomsdayTarget", 0, 0, 0, 0)
    8L04 D 35 Offset(-12, 18)
    8L04 D 2 Offset(-8, 23)
    8L04 B 2 Offset(-4, 28)
    8L04 B 2 Offset(-2, 30)
    8L04 B 0 A_WeaponReady(14)
    8L04 B 35
    goto ReadyX
   Altfire:
    8L04 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PowerfulShield")
    8L04 A 0 A_JumpIfInventory("UnholyBossAmmo250", 50, "Blaster")
    goto ReadyX
   Blaster:
    // TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Fire2")
    8L04 D 0 A_TakeInventory("UnholyBossAmmo250", 50)
    8L04 D 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    8L04 D 2 Offset(-6, 25) A_FireCustomMissile("ASPHarkShot", 0, 0, 0, 8)
    8L04 DDDDD 2 Offset(-12, 18)
    8L04 D 2 Offset(-8, 23)
    8L04 B 2 Offset(-4, 28)
    8L04 B 2 Offset(-2, 30)
    8L04 B 0 A_WeaponReady(14)
    8L04 B 30
    goto ReadyX
   PKFlash:
    8L04 D 0 A_TakeInventory("UnholyBossAmmo250", 250)
    8L04 D 0 A_FireCustomMissile("ASPDeathFlashPinpoint", 0, 0, 0, 0)
    8L04 DDDDD 2 Offset(-12, 18)
    8L04 D 2 Offset(-8, 23)
    8L04 B 2 Offset(-4, 28)
    8L04 B 2 Offset(-2, 30)
    8L04 B 0 A_WeaponReady(14)
    8L04 B 45
    goto ReadyX
   PowerfulShield:
    8L04 C 0 A_JumpIfInventory("BasicArmor", 1, "PKFlash")
    8L04 C 2 Offset(5, 28) A_GiveInventory("FinalSpeciman_ItemStart_P")
    8L04 E 2 Offset(12, 25)
    8L04 E 2 Offset(18, 19) A_SpawnItemEx("ASPPowerShieldAppliedFX")
    8L04 DDDDDDDDDDDDDD 2 Offset(23, 16) A_SpawnItemEx("ASPPowerShieldAppliedFX")
    8L04 E 2 Offset(18, 19) A_SpawnItemEx("ASPPowerShieldAppliedFX")
    8L04 E 2 Offset(12, 25)
    8L04 B 2 Offset(5, 28)
    8L04 B 0 A_WeaponReady(14)
    8L04 BBBBBBBBBBBBBBBBBBBBB 0 A_SpawnItemEx("ASPPowerShieldDeploymentFX", random(-2, 2), random(-2, 2), 28, random(-35, 35), random(-35, 35), random(-35, 35))
    8L04 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8L04 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8L04 BBBBBBBBBB 2
    goto ReadyX
  }
}

actor SuperSpecimanFlag : Once {}

actor FinalSpeciman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("SuperSpecimanFlag", 1, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor FinalSpeciman_Ready8_P : FinalSpeciman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor FinalSpeciman_ItemStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
    TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F", 1500)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125)
    TNT1 A 0 A_GiveInventory("FinalSpeciman_BasicArmor_P")
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySound("E_B/Shield1")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    stop
  }
}

actor ASPAstralWave : BasicProjectile {
  Translation "192:192=185:185", "198:198=5:5"
  DamageType "ASPHell"
  Obituary "%o got hurt and collapsed from \crFinal Speciman\c- (%k)'s \cmASP Decimate\c-."
  +RIPPER
  +NOINTERACTION
  +DONTREFLECT
  ReactionTime 30
  Damage (0)
  Radius 14
  Height 12
  Speed 10
  Scale 4.5
  States {
   Spawn:
    X_8B G 0
    X_8B G 0  // A_ChangeVelocity(12,0,velz,3)
    X_8B GGGHHHIII 1 A_JumpIf(ceilingz - z > 13, "Spawn2")
    X_8B G 0 A_JumpIf(velz == 0, "Death")
    X_8B G 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B G 0 A_ChangeFlag("RIPPER", 0)
    X_8B G 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B GHI 3  // A_ChangeVelocity(12,0,velz,3)
    X_8B G 0 A_JumpIf(velz == 0, "Death")
    X_8B G 0 A_CountDown
    goto Spawn2+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/StarStormHit", "Weapon")
    TNT1 A 0  // A_SetGravity(0.0)
    TNT1 A 0 A_Explode(250, 200, 0, 0, 100)
    X_8B ABCDEF 2
    stop
  }
}

actor ASPAstralWaveSpawner_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_SpawnItemEx("ASPAstralWaveSpawner", 0, 0, 0, 20)
    stop
  }
}

actor ASPAstralWaveSpawner {
  Projectile
  +FLOORHUGGER
  +THRUACTORS
  +DONTREFLECT
  +DONTBLAST
  +THRUGHOST
  Damage (0)
  Radius 10
  Height 48
  Speed 20
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/StarStorm", "Weapon")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("ASPAstralWave", random(300, -300), random(256, -256), 640, 12, 0, random(-30, -40))
    loop
  }
}

actor ASPMeteorPinPointer : FastProjectile {
  Projectile
  DamageType "ASPHell"
  +SKYEXPLODE
  +EXPLODEONWATER
  +RIPPER
  +THRUGHOST
  +DONTREFLECT
  MissileHeight 8
  MissileType "ASPMeteorPinPointerFX"
  Damage (0)
  Radius 4
  Height 4
  Speed 775
  Scale 6.5
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:
    TNT1 A 0 A_PlaySoundEx("weapon/mirrorabsorb", "Weapon")
    FLAS ABABAB 1
    TNT1 A 0 A_SpawnItemEx("ASPMeteorFalling", 0, 0, 640, 0, 0, -45)
    stop
  }
}

actor ASPMeteorPinPointerFX : BasicClientSide {
  Translation "192:192=95:95", "198:198=189:189"
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAA 0 A_SpawnItemEx("ShinySparkleFX2", random(4, 16), random(-20, 20), random(-20, 20), 0, 0, 0, random(0, 359), 1)
    TNT1 A 2
    stop
  }
}

actor ASPMeteorFalling : ASPAstralWave {
  Obituary "%o got hurt and collapsed from \crFinal Speciman\c- (%k)'s \cmASP Fuff\c-."
  Radius 4
  States {
   Spawn:
    X_8B B 0
    X_8B XXYYZZ 1 A_JumpIf(ceilingz - z > 13, "Spawn2")
    X_8B B 0 A_JumpIf(velz == 0, "Death")
    X_8B B 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B B 0 A_ChangeFlag("RIPPER", 0)
    X_8B B 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B XYZ 2
    X_8B B 0 A_JumpIf(velz == 0, "Death")
    X_8B B 0 A_CountDown
    goto Spawn2+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/StarStormHit2", "Weapon")
    TNT1 A 0  // A_SetGravity(0.0)
    TNT1 A 0 A_Explode(325, 200, 0, 0, 100)
    X_8B ABCDEF 2
    stop
  }
}


actor ASPHarkShot : BasicProjectile {
  Translation "192:192=185:185", "198:198=5:5"
  DamageType "ASPHell"
  Obituary "%o took mortal damage from \crFinal Speciman\c- (%k)'s \cmASP Hark\c-."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (180)
  Radius 26
  Height 26
  Speed 10
  Scale 4.5
  States {
   Spawn:
    CHBU A 0 A_ScaleVelocity(1.5)
    CHBU ABCD 2 A_SpawnItemEx("ASPHarkShotFX", -6, Random(-14, 14), random(-8, 8), 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(225, 188, 0, 0, 96)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("ASPHarkExplodeFX", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    X_8B ABCDEF 2 A_SpawnItemEx("ASPHarkExplode", random(-192, 192), random(-192, 192), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}


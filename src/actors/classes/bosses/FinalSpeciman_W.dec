actor FinalF_ThunderShockwave : BasicProjectile {
  Translation "192:192=185:185"
  DamageType "ASPHell"
  Obituary "%o's hope was ceased by \crFinal Speciman\c- (%k)'s \cmASP Thundergasso\c-."
  +FLOORHUGGER
  +THRUGHOST
  +DONTREFLECT
  // +RIPPER
  Damage (150)  // 75
  Radius 32
  Height 32
  Speed 5  // 3
  Scale 2.0
  States {
   Spawn:
    X_0E T 20
    X_0E T 4 A_ScaleVelocity(2.0)
    X_0E T 3 A_ScaleVelocity(2.4)
    X_0E T 2 A_ScaleVelocity(3.6)
    TNT1 A 20 A_SpawnItemEx("FinalF_ThunderShockwaveFX", -1 * sqrt(velx * velx + vely * vely), 0, 0, velx, vely, velz, 0, 1 + 8)
    stop
  }
}

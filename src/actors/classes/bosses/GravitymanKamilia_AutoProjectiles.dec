actor EdenmanStarFlurry {
  Translation "192:192=217:217", "198:198=222:222"
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +GHOST
  +SHOOTABLE
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +BRIGHT
  +FORCEXYBILLBOARD
  PainChance 0
  PainChance "Telefrag", 0
  DamageFactor "Telefrag", 0.0
  Species "EdenManStar"
  PainSound "item/protoreflect"
  Health 0x7ffffffd
  Args 50
  DamageType "GravitymanKamilia"
  Obituary "%o was star-struck by \ckEdenman\c- (%k)'s Star Flurry."
  Damage (0)
  Radius 10
  Height 10
  Speed 20
  Scale 2.5
  States {
   Spawn:
    STAP A 0
    STAP A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP A 1 A_Warp(AAPTR_TARGET, 96, 0, 32, 6, 28)
    STAP B 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP B 1 A_Warp(AAPTR_TARGET, 96, 0, 32, 6, 28)
    STAP B 0 A_Explode(args[0]*(CallACS("uh_checkrune", RUNE_SPREAD, AAPTR_TARGET)*2+1), radius*2, 0, 0, radius*2)
    STAP C 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP C 1 A_Warp(AAPTR_TARGET, 96, 0, 32, 6, 28)
    STAP D 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP D 1 A_Warp(AAPTR_TARGET, 96, 0, 32, 6, 28)
    STAP B 0 A_Explode(args[0]*(CallACS("uh_checkrune", RUNE_SPREAD, AAPTR_TARGET)*2+1), radius*2, 0, 0, radius*2)
    goto Spawn+1
   Death:
    TNT1 A 1
    stop
  }
}

actor EdenmanStarFlurry2 : EdenmanStarFlurry {
  States {
   Spawn:
    STAP A 0
    STAP A 0 A_SetPitch(args[0])
    goto SpawnRing
   SpawnRing:
    STAP A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP A 0 A_SetPitch(pitch+6)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", AAPTR_TARGET, 2)
    STAP A 1 A_Warp(AAPTR_TARGET, cos(pitch)*96, 0, sin(pitch)*96+32, 0, 28)
    STAP B 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP B 0 A_SetPitch(pitch+6)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", AAPTR_TARGET, 2)
    STAP B 1 A_Warp(AAPTR_TARGET, cos(pitch)*96, 0, sin(pitch)*96+32, 0, 28)
    STAP B 0 A_Explode(args[0]*(CallACS("uh_checkrune", RUNE_SPREAD, AAPTR_TARGET)*2+1), radius*2, 0, 0, radius*2)
    STAP C 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP C 0 A_SetPitch(pitch+6)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", AAPTR_TARGET, 2)
    STAP C 1 A_Warp(AAPTR_TARGET, cos(pitch)*96, 0, sin(pitch)*96+32, 0, 28)
    STAP D 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    STAP D 0 A_SetPitch(pitch+6)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", AAPTR_TARGET, 2)
    STAP D 1 A_Warp(AAPTR_TARGET, cos(pitch)*96, 0, sin(pitch)*96+32, 0, 28)
    STAP B 0 A_Explode(args[0]*(CallACS("uh_checkrune", RUNE_SPREAD, AAPTR_TARGET)*2+1), radius*2, 0, 0, radius*2)
    goto SpawnRing
  }
}


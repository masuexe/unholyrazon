// Dispatcher runs in the Gravityman player context.  A_JumpIfHealthLower
// uses strict '<' in Zandronum, so 75/50/25% remain in the preceding stage.
actor GravityKamiliaAutoAttack_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("GravitymanKamiliaPainFlag", 1, "NoAttack")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "PickupX")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") / 4, "Below25")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") / 2, "Below50")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 3 / 4, "Below75")
    TNT1 A 0
    stop
   NoAttack:
    TNT1 A 0
    stop
   Below75:
    TNT1 A 0 A_Jump(256, "AutoStone", "AutoGyro")
    stop
   AutoStone:
    TNT1 A 0 A_PlaySoundEx("weapon/powerstone", "Weapon")
    TNT1 A 0 A_FireCustomMissile("StoneM_PowerStoneStart_H", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 35 - 17 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoGyro:
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", -90, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", 90, 0, 8, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 35 - 17 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   Below50:
    TNT1 A 0 A_Jump(256, "AutoWave", "AutoCoal")
    stop
   AutoWave:
    TNT1 A 0 A_FireCustomMissile("PinpointWaterWaveSpawnerGK", 0, 0, -8, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 35 - 17 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoCoal:
    TNT1 A 0 A_FireCustomMissile("ChargeCoalTrainGK", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 35 - 17 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   Below25:
    TNT1 A 0 A_JumpIfInventory("GravityKamiliaCrystalReleased", 1, "AutoNapalm")
    goto AutoCrystal
   AutoNapalm:
    TNT1 A 0 A_FireCustomMissile("NapalmBombGK", random(0, 359), 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 8 - 4 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoCrystal:
    TNT1 A 0 A_FireCustomMissile("CrystalSpawnerGK", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 35 - 17 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   PickupX:
    TNT1 A 0 A_JumpIfInventory("GravityKamiliaCrystalReleased", 1, 1)
    goto AutoCrystalX
    TNT1 A 0 A_Jump(256, "AutoStoneX", "AutoGyroX", "AutoNapalmX", "AutoCoalX", "AutoWaveX")
    stop
   AutoStoneX:
    TNT1 A 0 A_PlaySoundEx("weapon/powerstone", "Weapon")
    TNT1 A 0 A_FireCustomMissile("StoneM_PowerStoneStart_H", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoGyroX:
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", -90, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("GyroAttackGK", 90, 0, 8, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoWaveX:
    TNT1 A 0 A_FireCustomMissile("PinpointWaterWaveSpawnerGK", 0, 0, -8, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoCoalX:
    TNT1 A 0 A_FireCustomMissile("ChargeCoalTrainGK", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoNapalmX:
    TNT1 A 0 A_FireCustomMissile("FireNapalmBombGK_H", random(0, 359), 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
   AutoCrystalX:
    TNT1 A 0 A_FireCustomMissile("CrystalSpawnerGK", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoCooldown_F", 12 - 6 * CallACS("uh_checkrune", RUNE_RAGE))
    stop
  }
}

// The target of this BasicWatcher is the Gravityman player.  Cooldown is
// decremented one tic at a time; a 1->0 transition returns to Spawn and the
// dispatcher is therefore called on the following tic, matching R3 cadence.
actor GravityKamiliaAutoAttack_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "Active")
    goto Death
   Active:
    TNT1 A 1
    TNT1 A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoCooldown_F", 1, "Cooldown")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", AAPTR_TARGET), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "Dispatch")
    goto Death
   Dispatch:
    TNT1 A 0 A_GiveToTarget("GravityKamiliaAutoAttack_P", 1)
    goto Spawn
   Cooldown:
    TNT1 A 0 A_TakeFromTarget("GravityKamiliaAutoCooldown_F", 1)
    goto Spawn
   Death:
    TNT1 A 0 A_TakeFromTarget("GravityKamiliaAutoCooldown_F", 999)
    TNT1 A 0 A_TakeFromTarget("GravityKamiliaCrystalReleased", 999)
    TNT1 A 0
    stop
  }
}

// GravitymanKamilia's R3 boss-only automatic projectile pool.
//
// This is deliberately separate from the player weapon projectiles.  The
// watcher runs independently of the weapon state, while the dispatcher is
// given to the boss player so A_FireCustomMissile keeps the boss as owner.

actor GravityKamiliaAutoWatcher_F : Once {}

actor GravityKamiliaAutoCooldown_F : Inventory {
  Inventory.MaxAmount 35
}

actor GravityKamiliaCrystalReleased : Powerup {
  Powerup.Duration 7
}

// All gameplay projectiles in this file inherit the R4 projectile spawn
// plumbing, but retain the R3 boss-specific species and damage type.
actor GravityKamiliaProjectile : BasicProjectile {
  damagetype "GravityKamilia"
  species "EdenManStar"
  +THRUSPECIES
}

// Keep the R3 pinpoint wave's FastProjectile collision path at speed 1000.
actor GravityKamiliaFastProjectile : BasicFastProjectile {
  damagetype "GravityKamilia"
  species "EdenManStar"
  +THRUSPECIES
}

actor GravityKamiliaShot : GravityKamiliaProjectile {
  Translation "192:192=4:4", "198:198=[255,255,0]:[255,255,0]"
  var int user_TranslateWhiteColors;
  Obituary "%o was shot down by \cgGravityman\c- (%k)'s Gravity Buster."
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (50)
  radius 10
  height 8
  Speed 50
  scale 8.0
  States {
   Spawn:
    TNT1 A 1
   SpawnLoop:
    8Q19 AB 8
    loop
   Death:
    TNT1 A 1
    stop
  }
}
actor GravityKamiliaShotUp : GravityKamiliaShot {
  Obituary "%o was shot up by \cgGravityman\c- (%k)'s Gravity Buster."
}

actor StoneM_PowerStoneStart_H : BasicWatcher {
  Translation "192:192=215:215", "198:198=216:216"
  Speed 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(0, random(0, 179))
    TNT1 A 0 A_SpawnItemEx("PowerStoneManGK", 46, 0, 0, 0, 0, 0, 0 + args[0], SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("PowerStoneManGK", 46, 0, 0, 0, 0, 0, 180 + args[0], SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    stop
  }
}

actor PowerStoneManGK : GravityKamiliaProjectile {
  var int user_speed;
  var int user_maxturn;
  var int user_turndivisor;
  var int user_turn_add;
  Obituary "$OB_POWERSTONE"
  +FORCEXYBILLBOARD
  Radius 38
  Height 10
  Damage 250
  Speed 10
  Scale 2.5
  States {
   Spawn:
    X_5C Q 0
    X_5C Q 0 A_SetUserVar("user_speed", 38)
    X_5C Q 0 A_SetUserVar("user_maxturn", 1000)
    X_5C Q 0 A_SetUserVar("user_turndivisor", 96)
    X_5C Q 0 A_SetUserVar("user_turn_add", 4)
   Spawn2:
    X_5C Q 0 A_ChangeVelocity(30, 0, momz, 3)
    X_5C QRS 2
    X_5C T 1 A_Stop
    POWB V 3 A_SetAngle(angle - 80)
    X_5C T 0
    goto Spawn3+1
   Spawn3:
    X_5C T 0 A_SetAngle(angle - user_maxturn / user_turndivisor)
    X_5C T 1 A_ChangeVelocity(user_speed, 0, momz, 3)
    X_5C T 0 A_JumpIf(user_turndivisor * 100 / user_maxturn > 92, "Spawn4")
    X_5C T 0 A_SetUserVar("user_turndivisor", user_turndivisor + user_turn_add)
    loop
   Spawn4:
    X_5C T 1
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("PowerStoneManFX", 16, 0, 0, frandom(4, 8), 0, frandom(1, 5), random(-20, 20), SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("PowerStoneManFX", 16, 0, 0, frandom(4, 8), 0, frandom(1, 5), random(-20, 20) + 120, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("PowerStoneManFX", 16, 0, 0, frandom(4, 8), 0, frandom(1, 5), random(-20, 20) + 240, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 1
    stop
  }
}

actor PowerStoneManFX : BasicGraphicEffect {
  +DOOMBOUNCE
  +DONTSPLASH
  +NOBLOCKMAP
  BounceCount 3
  ReactionTime 5
  Damage 0
  Radius 8
  Height 8
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Jump(256, "FX1", "FX2", "FX3")
   FX1:
    POWB A 2
    TNT1 A 1 A_CountDown
    loop
   FX2:
    POWB B 2
    TNT1 A 1 A_CountDown
    loop
   FX3:
    POWB C 2
    TNT1 A 1 A_CountDown
    loop
  }
}


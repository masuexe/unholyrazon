actor WaterWaveGK : GravityKamiliaProjectile {
  Obituary "$OB_WATERWAVE"
  +DONTSPLASH
  +FLOORHUGGER
  +STEPMISSILE
  ReactionTime 31
  Damage 80
  Radius 6
  Height 40
  Speed 12
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
   WaveLoop:
    X_5B A 1
    X_5B A 3 A_GiveInventory("ResyncPickup", 1)
    X_5B BCDCBA 4
    X_5B A 0 A_CountDown
    goto WaveLoop
   Crash:
   XDeath:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0
    TNT1 A 1
    stop
  }
}

actor WaterWaveGK2 : WaterWaveGK {
  -FLOORHUGGER
  +CEILINGHUGGER
  MaxStepHeight 16
  BounceCount 1
  Gravity 51.0
  ReactionTime 31
  Damage 80
  Radius 6
  Height 40
  Speed 12
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
   WaveLoop:
    X_5B E 1
    X_5B E 3 A_GiveInventory("ResyncPickup", 1)
    X_5B FGHGFE 4
    X_5B E 0 A_CountDown
    goto WaveLoop
   Crash:
   XDeath:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0
    TNT1 A 1
    stop
   Continue:
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 0, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 1
    stop
  }
}


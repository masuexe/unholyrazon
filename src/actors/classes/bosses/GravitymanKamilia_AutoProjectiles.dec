    TNT1 A 0 A_SpawnItemEx("CrystalEyeBitGK", 0, 0, 0, 32, 0, sin(random(215, 235)) * 31, random(215, 235), SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)

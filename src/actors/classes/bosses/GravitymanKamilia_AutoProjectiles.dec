actor CrystalEyeBitGK : GravityKamiliaProjectile {
  Translation "4:4=208:208", "192:192=8:8", "198:198=193:193", "202:202=208:208", "199:199=215:215"
  Obituary "$OB_CRYSTALEYE"
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  +SKYEXPLODE
  +FORCEXYBILLBOARD
  BounceFactor 0.945
  WallBounceFactor 0.945
  ReactionTime 35
  Damage 50
  Height 9
  Radius 9
  Speed 30
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
   CheckA:
    X_5H A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveA")
    goto Death
   GiveA:
    X_5H A 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckB:
    X_5H B 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveB")
    goto Death
   GiveB:
    X_5H B 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckC:
    X_5H C 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveC")
    goto Death
   GiveC:
    X_5H C 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckD:
    X_5H D 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveD")
    goto Death
   GiveD:
    X_5H D 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckE:
    X_5H E 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveE")
    goto Death
   GiveE:
    X_5H E 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckA2:
    X_5H A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveA2")
    goto Death
   GiveA2:
    X_5H A 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
   CheckA3:
    X_5H A 0 A_JumpIfInTargetInventory("GravityKamiliaAutoWatcher_F", 1, "GiveA3")
    goto Death
   GiveA3:
    X_5H A 4 A_GiveToTarget("GravityKamiliaCrystalReleased", 1)
    goto CheckA
   Death:
    XMFX N 2
    UMFX BCD 2
    stop
  }
}


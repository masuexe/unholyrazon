actor WaterWaveSpawnerGK : GravityKamiliaProjectile {
  +DONTBLAST
  Height 40
  Radius 6
  Scale 2.5
  Damage 0
  +THRUACTORS
  +FLOORHUGGER
  ReactionTime 30
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/waterwave", "Weapon")
   Spawn2:
    TNT1 AA 1 A_CountDown
    X_5B AAAABBAAAA 1 A_CountDown
    loop
   Death:
    TNT1 A 0
   Wave:
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 0, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 45, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 90, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 135, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 180, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 225, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 270, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("WaterWaveGK", 0, 0, 0, 23, 0, 0, 315, SXF_TRANSFERTRANSLATION|SXF_TRANSFERPOINTERS)
    TNT1 A 1
    stop
   Launch:
    TNT1 A 0 A_JumpIf(z != floorz, "Wave")
    goto Wave
  }
}


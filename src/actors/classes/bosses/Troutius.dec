actor Troutius : BossBase {
  Player.ScoreIcon "UB049MUG"
  Player.SoundClass "Troutius"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "Troutius_W"
  States {
   Spawn:
    BASS A 0
    BASS A 0 A_JumpIfInventory("TroutiusDashFlag", 1, "MissileDash")
    BASS B 1
    BASS A 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    wait
   See:
    BASS B 0 A_JumpIfInventory("TroutiusDashFlag", 1, "MissileDash")
    BASS BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn

   Jumping:
    BSB1 B 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileRage")
    BSB1 B 0 A_JumpIfInventory("VivifyDelay7", 1, "MissileKicker")
    BSB1 B 0 A_JumpIfInventory("TroutiusDashFlag", 1, "MissileDash")
    BSB1 B 1 A_JumpIf(CallACS("core_checkfooting"), "Spawn")
    loop

   Missile:
    BASS B 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileRage")
    BASS B 0 A_JumpIfInventory("VivifyDelay7", 1, "MissileKicker")
    BASS B 0 A_JumpIfInventory("TroutiusDashFlag", 1, "MissileDash")
    // BASS B 0 A_JumpIf(!CallACS("core_checkfooting"), "Missile_Jumping")
    BASS FFFFF 1
    BASS GGGG 1
    goto Spawn+2

   Missile_Jumping:
    BSB1 C 1
    loop

   MissileDash:
    BSB1 A 1
    BSB1 AA 1 A_JumpIfInventory("TroutiusDashFlag", 1, "MissileDash")
    goto Spawn

   MissileKicker:
    BSB1 EFGHEFGH 3
    BSB1 I 1 A_JumpIfInventory("VivifyDelay7", 1, "MissileKickerE")
    // BSB1 I 1 A_Checkfloor("MissileKickL")
    wait
   MissileKickerE:
    BSB1 JJJJJJJ 2
    goto Spawn+2

   MissileRage:
    BSB1 DEFGH 3
    BSB1 I 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileRage2")
    // BSB1 I 1 A_Checkfloor("MissileRage2")
    wait
   MissileRage2:
    BSB1 JJJJDD 2
    BSB0 GFGF 2
   MissileRageL:
    BSB2 CCVV 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileRageEnd")
    loop
   MissileRageEnd:
    BSB2 I 4
    goto Spawn

   Melee:
    BASS A 0 A_JumpIfInventory("VivifyDelay6", 1, "MeleeKnockDown")
    BASS A 1
    goto Spawn
   MeleeKnockDown:
    BASS J 20
    BASS J 1 A_JumpIfInventory("VivifyDelay6", 1, "MeleeGetUp")
    wait
   MeleeGetUp:
    BSB0 FFGG 2 A_JumpIfInventory("TroutiusIsAatrox", 1, "Spawn")
    loop


   ClassPain:
    BASS H 0
    goto MegamanPain
   ClassDeath:
    BASS H 0
    goto MegamanDeath
  }
}

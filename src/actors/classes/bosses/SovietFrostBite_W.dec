TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TMFX BCD 2
stop
}
}

actor SovietColdBomber : BasicProjectile
{
Translation "192:192=203:203","198:198=201:201","0:0=168:168","199:199=168:168","202:202=168:168"
-NOGRAVITY
+CANBOUNCEWATER
+BOUNCEONCEILINGS
+BOUNCEONWALLS
+THRUACTORS
BounceFactor 1.0
DamageType "SovietChill"
Obituary "%o did not warm up enough to \cmSoviet \cnFrostbite\c- (%k)'s Cold Bomber."
Damage(0)
Radius 12
Height 20
Speed 40
Scale 3.0
Args 3
States
{
Spawn:
X_9A X 0
X_9A X 0 ThrustThingZ(0,12,0,1)
X_9A X 0 ThrustThing(angle*256/360,4,1,0)
SpawnL:
X_9A XXXXXXXXXXXX 3 A_Explode(36,84,0)
X_9A X 0 A_CountDownArg(0,"Death2")
loop
Death2:
TNT1 A 0 A_PlaySoundEx("weapon/icewallspawn","SoundSlot5")
TNT1 A 0 Radius_Quake(4,30,0,45,0)
TNT1 A 0 A_Explode(475,256,0,0,64)
TNT1 AAAAA 0 A_SpawnItemEx("SovietColdSpikeWave",random(-8,8),random(-8,8),4,random(5,15),0,random(-5,20),random(0,359))
TNT1 A 0 A_SpawnItemEx("SovietColdExplosion_H")
TNT1 A 4
stop
Death:
X_9A X 0 A_SpawnItemEx("SovietColdBomber2",0,0,0,0,0,0,0,1)
stop
}
}

actor SovietColdBomber2 : BasicExplosion
{
+FORCEXYBILLBOARD
Damagetype "SovietCold"
Obituary "%o did not warm up enough to \cmSoviet \cnFrostbite\c- (%k)'s Cold Bomber."
Scale 3.0
States
{
Spawn:
X_9A X 0
X_9A X 0 A_PlaySoundEx("wep_L/GhostTrapLand","Weapon")
SpawnL:
//opted to just apply passive damage on the FX instead, would be easier to deal with imo
X_9A XXXXXX 5 A_SpawnItemEx("SovietChill_Radius",random(32,48),0,random(-8,56),0,0,0,random(0,359),16384+1)
Y_9A X 3
X_9A XXXXXXXX 4 A_SpawnItemEx("SovietChill_Radius",random(32,48),0,random(-8,56),0,0,0,random(0,359),16384+1)
Y_9A X 2
X_9A XXXXXXXXXXX 3 A_SpawnItemEx("SovietChill_Radius",random(32,48),0,random(-8,56),0,0,0,random(0,359),16384+1)
Y_9A X 1
goto Death
Death:
TNT1 A 0 A_PlaySoundEx("weapon/icewallspawn","SoundSlot5")
TNT1 A 0 Radius_Quake(4,30,0,45,0)
TNT1 A 0 A_Explode(475,256,0,0,64)
TNT1 AAAAA 0 A_SpawnItemEx("SovietColdSpikeWave",random(-8,8),random(-8,8),4,random(16,20),0,random(-5,20),random(0,359))
TNT1 A 0 A_SpawnItemEx("SovietColdExplosion_H")
TNT1 A 4
stop
}
}

Actor SovietChill_Radius : BasicExplosion
{

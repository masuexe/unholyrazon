actor HailRainShotBossBit : SovietColdShotBit {+DONTSPLASH}

actor HailRainSpawnerBossHelper : BasicWatcher
{
Reactiontime 53
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_GiveToTarget("HailRainSpawnerBoss_P",1)
TNT1 AAA 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
TNT1 A 0 A_CountDown
loop
}
}

actor HailRainSpawnerBoss_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("HailRainSpawnerBoss",0,0,32)
stop
}
}


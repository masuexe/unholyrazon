actor SovietFrostBite_W_NormalBar : NormalBar {args 4, 198}
actor SovietFrostBite_W_SecondBar : NormalBar {args 203, 5}

actor SovietFrostBite_W : BaseUnholyBossWep
{
Tag "$TAG_Boss014_W"
Obituary "%o was now shivering in fear due to \cmSoviet \cnFrostBite\c- (%k)."
Inventory.Pickupmessage "\cjFor Soviet Union!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H14 [ 1
wait

Deselect:
8H14 A 0
goto DeselectSwap
Select:
8H14 A 0
goto SelectSwap

Ready:
8H14 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H14 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SOVIETFROSTBITE_DYE)
8H14 A 6 
goto ReadyX
ReadyX:
8H14 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX2")
8H14 A 2 A_WeaponReady(8)
8H14 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX2:
8H14 A 2 A_WeaponReady
8H14 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop

FireX:
8H14 B 1 A_TakeInventory("UnholyPower1500", 1500)
8H14 B 1 A_PlaySoundEx("weapon/icewaveloop","Body")
8H14 C 2 A_FireCustomMissile("HailRainSpawnerBossHelper",0,0,0,0)
8H14 B 2
Goto ReadyX

Fire:
8H14 A 0 A_JumpIfInventory("UnholyPower1500",1500,"FireX")
8H14 B 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H14 B 1 A_FireCustomMissile("SovietColdShot",random(-10,10),0,8,0,0,random(-5,5))
8H14 C 2 A_GiveInventory("UnholyBossAmmo200",1)
8H14 B 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H14 B 1 A_FireCustomMissile("SovietColdShot",random(-10,10),0,8,0,0,random(-5,5))
8H14 C 2 A_GiveInventory("UnholyBossAmmo200",1)
8H14 B 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H14 B 1 A_FireCustomMissile("SovietColdShot",random(-10,10),0,8,0,0,random(-5,5))
8H14 C 2 A_GiveInventory("UnholyBossAmmo200",1)
8H14 C 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H14 C 1 A_FireCustomMissile("SovietColdShot",random(-1,1),0,8,0,0,random(-1,1))
8H14 CBAAAAAA 3 A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX
Altfire:
8H14 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Hail")
goto ReadyX
Hail:
8H14 A 0 A_TakeInventory("UnholyBossAmmo200",200)
8H14 A 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire","Weapon")
8H14 A 0 A_FireCustomMissile("SovietColdBomber",0,0,8,0)
8H14 BCB 4
8H14 A 12
Goto ReadyX
}
}

actor HailRainShotBoss : BasicProjectile
{
//Translation "214:215=203:203"
Translation "192:192=203:203","198:198=5:5"
Damagetype "SovietCold"
Obituary "%o was now shivering in fear due to \cmSoviet \cnFrostBite\c- (%k)."
+RIPPER
damage (50)
radius 10
height 10
Scale 2.5
States
{
Spawn:
X_7A D 4
loop
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TNT1 AAAA 0 A_SpawnItemEx("SovietColdShotBit",0,0,8,random(-20,20),random(-20,20),random(0,20),0,1)
TMFX ABCD 2
stop
}
}

actor SovietColdShot : BasicProjectile
{
Translation "192:192=203:203","198:198=5:5"
Damagetype "SovietCold"
Obituary "%o was now shivering in fear due to \cmSoviet \cnFrostBite\c- (%k)."
+SKYEXPLODE
+EXPLODEONWATER
Damage (95)
radius 12
height 12
Speed 50
scale 3.0
States
{
Spawn:
X_7A D 1
X_7A D 0 A_SpawnItemEx("SovietColdShotFX",0,0,0,0,0,0,0,1)
Loop
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TNT1 A 0 A_PlaySoundEx("weapons/mm7/freezecrackersplit","Weapon")
TNT1 AAAAAAA 0 A_SpawnItemEx("SovietColdShotBit",0,0,8,random(-20,20),random(-20,20),random(0,20),0,1)
TNT1 A 0 A_Explode(70,112,0)
TMFX ABCD 2
stop
}
}

actor SovietColdShotFX : BasicGraphicEffect
{
scale 2.5
States
{
SpawnFrame:
X_7A DDDDEEEE 1 A_FadeOut
stop
}
}

actor SovietColdShotBit : BasicProjectile
{
damagetype "SovietCold"
Obituary "%o was now shivering in fear due to \cmSoviet \cnFrostBite\c- (%k)."
-NOGRAVITY
Damage (random(55, 85))
Radius 6
Height 6
Scale 2.5
States
{
Spawn:
X_7A E 4
loop
Death:

X_7A E 0 A_Explode(32,42,0,0,6)
X_7A EE 1 A_SetScale(scaleX-0.3,scaleY-0.3)
X_7A E 0 A_Explode(32,42,0,0,6)
X_7A EE 1 A_SetScale(scaleX-0.3,scaleY-0.3)
X_7A E 0 A_Explode(32,42,0,0,6)
X_7A EE 1 A_SetScale(scaleX-0.3,scaleY-0.3)
stop
}
}


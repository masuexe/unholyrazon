actor GBeast : BossBase
{
player.scoreIcon "UB108MUG"
Translation "192:192=220:220", "198:198=46:46"
player.soundclass "GBeast"
player.damagescreencolor "black"
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 9
Player.MaxHealth 3725
Health 3725
StencilColor "White"
MaxStepHeight 32//24
MaxDropOffHeight 32//24
player.morphweapon "GBeast_W"
States
{
Spawn:
8B08 A 0
8B08 B 1
8B08 A 1
wait
See:
8B08 BCDE 5
Goto Spawn
Missile:
//At some point I should make some frames specifically for the dash. When? I don't know.
8B08 F 5
8B08 G 4
goto Spawn+1
ClassPain:
8B08 H 0
Goto MegamanPain
ClassDeath:
8B08 H 0
Goto MegamanDeath
MegamanDeath0:
8B08 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
8B08 H 0 A_GiveInventory("CutterFlag", 5)
MegamanExplode:
8B08 H 0 A_JumpIfInventory("KnightFlag", 6, "Spawn2")
8B08 H 0 A_JumpIfInventory("CutterFlag", 4, "SpawnXP")
8B08 H 1 Thing_SetTranslation(0, GBEAST_DEATHDYE)
8B08 H 1 Thing_SetTranslation(0, GBEAST_DYE)
8B08 H 0 A_GiveInventory("CutterFlag", 1)
loop
SpawnXP:
8B08 H 0 A_PlaySoundEx("MMBN6/DeathExplode", "Body")  // 0.274s = 9.59 tic
8B08 H 0 A_SpawnItemEx("BN_ExplodeFX", random(14,48), 0, random(16,42), 0, 0, 4, random(0,359))
8B08 H 0 A_TakeInventory("CutterFlag")
8B08 H 0 A_GiveInventory("KnightFlag", 1)
goto MegamanExplode
Spawn2:
8B08 H 0 A_GiveInventory("DeathFadeOutFlag", 1)
8B08 H 1 Thing_SetTranslation(0, GBEAST_DEATHDYE)
8B08 H 1 Thing_SetTranslation(0, GBEAST_DYE)
8B08 H 0 A_FadeOut(0.18, 0)
8B08 H 0 A_JumpIfInventory("DeathFadeOutFlag", 6, "MegamanErase")
loop
}
}

Actor BN_ExplodeFX : BasicGraphicEffect
{
Scale 2.0
States
{
SpawnFrame:
BNXP B 0
BNXP BCDEFGHIJKL 1
stop
}
}

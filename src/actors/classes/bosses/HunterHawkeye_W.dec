actor Hawkeye_Bullet_FX  // Basic Bullet drop
{
	Translation "199:199=188:188", "200:207=175:175"
	BounceSound "item/protoreflect"
	+DONTBLAST
	+MISSILE
	-NOGRAVITY
	+THRUACTORS
	+CLIENTSIDEONLY
	+FLOORCLIP
	+DONTSPLASH
	//
	+BOUNCEONWALLS
	+BOUNCEONFLOORS
	+BOUNCEONCEILINGS
	// +HEXENBOUNCE
	// +USEBOUNCESTATE
	BounceCount 5
	BounceFactor 0.65
	WallBounceFactor 0.8
	Damage (0)
	Height 4
	Radius 4
	Speed 30
	Scale 1.5
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
	  FAKR MNOPQRST 1
	  goto Spawn+2
	}
}

//
//
//

actor Aim_Of_Hawkeye : BasicFastProjectile {
	DamageType "Hawkeye"
	Obituary "%o was shot by \cmHunter \crHawkeye\c- (%k)'s HellShot Revolver!"
	Translation "192:192=175:175", "198:198=188:188"
	+SKYEXPLODE
	+EXPLODEONWATER
	+DONTBLAST
	+BLOODLESSIMPACT
	+THRUGHOST
	//
	var int user_POWER;  //
	//
	MissileHeight 6  // 8?
	MissileType "Aim_Of_Hawkeye_FX"
	damage (random(285, 315)-user_POWER)  // 100
	radius 12  // 16
	height 12  // 16
	speed 500
	Scale 2.5
	States {
	 Spawn:
	  TNT1 A 1 A_SetUserVar("user_POWER", user_POWER+25)  // 25
	  TNT1 A 0 A_GiveInventory("CutterFlag", 1)
	  TNT1 A 0 A_JumpIfInventory("CutterFlag", 6, "NoMoreDrop")  // 8
	  loop  // wait
	 NoMoreDrop:
	  TNT1 A 1
	  wait
	 Death:
	  8P51 B 0

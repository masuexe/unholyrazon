actor HunterHawkeye_W_ScriptBar : ScriptBar {}

actor HunterHawkeye_W : BaseUnholyBossWep {
	Tag "$TAG_Boss001_W"
	Obituary "%o declared that \cmHunter \crHawkeye\c- (%k) was cheating."
	Inventory.Pickupmessage "\crWrath."
	weapon.ammotype "Hawkeye_Rounds"
	weapon.ammotype2 "UnholyBossAmmo200"  // UnholyPower1000
	weapon.ammouse 1
	Weapon.AmmoGive 6
	States {
	 Spawn:
	  8H01 [ 1
	  wait

	 Ready:
	  8H01 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
	  8H01 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
	  8H01 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, HUNTERHAWKEYE_DYE)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 200)
	  8H01 A 0 A_GunFlash
	  goto ReadyX

	 ReadyX:
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Rounds", 6, "ReadyTrue")
	  8H01 A 0 A_JumpIfNoAmmo("ReloadX_Checker")  // Reload
	  Goto ReloadX_Checker
	 ReadyTrue:
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Rounds", 6, "ReadyTrueREAL")
	  8H01 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 2)
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY)
	  goto ReadyTrueGive
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	 ReadyTrueGive:
	  8H01 A 1 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  goto ReadyTrue
	 ReadyTrueREAL:
	  8H01 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 2)
	  8H01 A 2 A_WeaponReady
	  goto ReadyTrueREALGive
	  8H01 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
	 ReadyTrueREALGive:
	  8H01 A 1 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Rounds", 6, "ReadyTrueREAL")
	  goto ReadyTrue


	  // This... could look a lot better...
	  // If this is too long, it can be reduced.
	  // But it's only this long for the sake of things.
	  // I know you can use a A_JumpIfInventory checker, but bleh.
	 ReloadX_Checker:
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 0 A_JumpIfNoAmmo("ReloadXX")
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  8H01 A 2 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
	  8H01 A 0 A_GiveInventory("UnholyBossAmmo200", 2)  // 4
	  Goto ReloadX

	 ReloadX:  // Reload
	  8H01 A 1 Offset(0, 34)A_WeaponReady(15)  // 40
	  8H01 A 1 Offset(0, 46)A_WeaponReady(15)  // 50
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)  // 60
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)  // 70
	  8H01 A 1 Offset(0, 96)A_WeaponReady(15)  // 80
	  8H01 A 1 Offset(0, 102)A_WeaponReady(15)  // 90
	  TNT1 AAA 8 A_PlaySoundEx("wep/SmokeB_Load1", "Weapon")
	  // 8H01 A 0 A_PlaySoundEx("wep/SmokeB_Load2","Weapon")
	  8H01 A 0 A_PlaySoundEX("Weapon/LockAndLoad", "Weapon")
	  8H01 A 0 A_GiveInventory("Hawkeye_Rounds", 6)
	  8H01 A 1 Offset(0, 90)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 56)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 48)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 40)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 36)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 33)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 31)A_WeaponReady(15)
	  8H01 A 1 A_WeaponReady(14)
	  goto ReadyX

	 ReloadXX:  // Reload
	  8H01 A 1 Offset(0, 34)A_WeaponReady(15)  // 40
	  8H01 A 1 Offset(0, 46)A_WeaponReady(15)  // 50
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)  // 60
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)  // 70
	  8H01 A 1 Offset(0, 96)A_WeaponReady(15)  // 80
	  8H01 A 1 Offset(0, 102)A_WeaponReady(15)  // 90
	  TNT1 AAAAAA 8 A_PlaySoundEx("wep/SmokeB_Load1", "Weapon")
	  // 8H01 A 0 A_PlaySoundEx("wep/SmokeB_Load2","Weapon")
	  8H01 A 0 A_PlaySoundEX("Weapon/LockAndLoad", "Weapon")
	  8H01 A 0 A_GiveInventory("Hawkeye_Rounds", 6)
	  8H01 A 1 Offset(0, 90)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 56)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 48)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 40)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 36)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 33)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 31)A_WeaponReady(15)
	  8H01 A 1 A_WeaponReady(14)
	  goto ReadyX

	 ReloadXXX:  // Reload
	  8H01 A 1 Offset(0, 34)A_WeaponReady(15)  // 40
	  8H01 A 1 Offset(0, 46)A_WeaponReady(15)  // 50
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)  // 60
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)  // 70
	  8H01 A 1 Offset(0, 96)A_WeaponReady(15)  // 80
	  8H01 A 1 Offset(0, 102)A_WeaponReady(15)  // 90
	  TNT1 AAAAAA 8 A_PlaySoundEx("wep/SmokeB_Load1", "Weapon")
	  TNT1 A 8
	  // 8H01 A 0 A_PlaySoundEx("wep/SmokeB_Load2","Weapon")
	  8H01 A 0 A_PlaySoundEX("Weapon/LockAndLoad", "Weapon")
	  8H01 A 0 A_GiveInventory("Hawkeye_Rounds", 6)
	  8H01 A 1 Offset(0, 90)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 80)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 68)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 56)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 48)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 40)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 36)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 33)A_WeaponReady(15)
	  8H01 A 1 Offset(0, 31)A_WeaponReady(15)
	  8H01 A 1 A_WeaponReady(14)
	  goto ReadyX

	  /*ReloadX:
	  8H01 A 1 Offset(0,40)A_WeaponReady(14)
	  8H01 A 1 Offset(0,46)A_WeaponReady(14)
	  8H01 A 1 Offset(0,58)A_WeaponReady(14)
	  8H01 A 1 Offset(0,80)A_WeaponReady(14)
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Rounds",1,1)
	  goto Reload+5
	  TNT1 A 4 A_WeaponReady(14)
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Rounds",1,1)
	  goto Reload+6
	  8H01 A 1 Offset(0,80)A_WeaponReady(14)
	  8H01 A 1 Offset(0,60)A_WeaponReady(14)
	  8H01 A 1 Offset(0,50)A_WeaponReady(14)
	  8H01 A 1 Offset(0,40)A_WeaponReady(14)
	  8H01 A 0 A_GiveInventory("Hawkeye_Rounds",6)
	  goto ReadyX*/
	  //




	 Flash:  // If too much, 2 tics, 1 rage gain ammo, 2 exhaust take
	  TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
	  8H01 A 0 A_GiveInventory("UnholyPower1000", 1)
	  TNT1 A 1 A_TakeInventory("Hawkeye_Exhaust", 1)  // 1 ~ 2
	  loop

	  // 8H01 A 0 A_PlaySoundEx("weapon/timestopper","Weapon")
	 Fire:  // A_RailAttack(750,0,0,"AA AA AA","00 00 00",1,0,"HawkeyeHellShotter")
	  8H01 A 0 A_JumpIfNoAmmo("ReloadXX")  // High Priority. //ReloadX
	  // 8H01 A 0 A_JumpIfInventory("UnholyPower1000",1000,"HeyHeyImStillHere")
	  8H01 A 0 A_JumpIfInventory("HawkeyeSnipeFlag1", 1, "StrongerFireShot")
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Exhaust", 100, "FireAgonyOOF")  // 80
	  8H01 A 0 A_JumpIfInventory("Hawkeye_Exhaust", 70, "FireAgony")  // 40
	  8H01 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")  /// //////////
	  8H01 A 0 A_ZoomFactor(1.0)  //
	  8H01 A 0 A_TakeInventory ("HawkeyeSnipeFlag1")
	  8H01 B 1 A_GiveInventory ("Hawkeye_Exhaust", 30)  // 25
	  8H01 B 1 A_FireCustomMissile("Aim_Of_Hawkeye", 0, 1, -8, 0)  // C
	  8H01 CC 2 A_Refire("FireHoldDelay")
	  8H01 C 1 A_ClearRefire
	  Goto FireEnd  // ReadyX
	 FireAgony:
	  8H01 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")
	  8H01 A 0 A_ZoomFactor(1.0)
	  8H01 A 0 A_TakeInventory ("HawkeyeSnipeFlag1")
	  8H01 B 1 A_GiveInventory ("Hawkeye_Exhaust", 30)
	  8H01 B 1 A_FireCustomMissile("Aim_Of_Hawkeye", frandom(-2, 2), 1, -8, 0, 0, frandom(-2, 2))
	  8H01 CC 2 A_Refire("FireHoldDelay")
	  8H01 C 1 A_ClearRefire
	  Goto FireEnd  // ReadyX
	 FireAgonyOOF:
	  8H01 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")
	  8H01 A 0 A_ZoomFactor(1.0)
	  8H01 A 0 A_TakeInventory ("HawkeyeSnipeFlag1")
	  8H01 B 1 A_GiveInventory ("Hawkeye_Exhaust", 30)
	  8H01 B 1 A_FireCustomMissile("Aim_Of_Hawkeye", frandom(-4, 4), 1, -8, 0, 0, frandom(-4, 4))
	  8H01 CC 2 A_Refire("FireHoldDelay")
	  8H01 C 1 A_ClearRefire
	  Goto FireEnd  // ReadyX
	  /// ////////////////////////////////////////////
	 FireHoldDelay:
	  TNT1 A 0 A_SpawnItemEx("Hawkeye_Bullet_FX", 0, 4, 28, frandom(2, 8), 0, frandom(5, 10), random(10, 25)*15, 0)
	  8H01 C 1 A_RailWait
	  8H01 C 0 A_Refire("FireHoldDelayX")
	  goto FireEnd+1
	 FireHoldDelayX:
	  8H01 C 1 A_RailWait
	  8H01 C 0 A_Refire("FireHoldDelayX")
	  goto FireEnd+1
	 FireEnd:
	  8H01 C 1 A_SpawnItemEx("Hawkeye_Bullet_FX", 0, 4, 28, frandom(2, 8), 0, frandom(5, 10), random(10, 25)*15, 0)
	  8H01 B 1 A_ClearRefire
	  8H01 A 1 A_WeaponReady(14)
	  Goto ReadyX
	  /// ////////////////////////////////////////////

	  // A_RailAttack(1250,0,0,"FF 00 00","00 00 00",1,0,"HawkeyeHellShotter")
	 StrongerFireShot:  // RAGE_Of_Hawkeye
	  8H01 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "HeyHeyImStillHere")
	  8H01 A 0 A_TakeInventory ("HawkeyeSnipeFlag1")
	  8H01 A 0 A_ZoomFactor(1.0)
	  8H01 A 0 A_PlaySoundEx("weapon/timestopper", "Weapon")
	  8H01 A 0 A_TakeInventory("Hawkeye_Rounds")
	  8H01 B 1
	  8H01 B 1 A_RailAttack(1000, 0, 0, "FF 00 00", "AA AA AA", 1, 0, "HawkeyeHellShotter")
	  8H01 C 2 A_GiveInventory("UnholyBossAmmo200", 1)
	  TNT1 AAAAAA 0 A_SpawnItemEx("Hawkeye_Bullet_FX", 0, 4, 28, frandom(2, 8), 0, frandom(5, 10), random(10, 25)*15, 0)
	  8H01 CBAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
	  Goto ReloadXX  // ReloadX_Checker //ReadyX
	 HeyHeyImStillHere:  // RAGE_Of_Hawkeye
	  8H01 A 0 A_TakeInventory("UnholyPower1000", 3000)
	  8H01 A 0 A_TakeInventory ("HawkeyeSnipeFlag1")
	  8H01 A 0 A_ZoomFactor(1.0)
	  8H01 A 0 A_PlaySoundEx("weapon/timestopper", "Weapon")
	  8H01 A 0 A_TakeInventory("Hawkeye_Rounds")
	  8H01 B 1
	  8H39 C 0 A_ChangeVelocity(-Cos(pitch)*30, 0, sin(pitch)*15, CVF_RELATIVE)
	  8H01 B 1 A_FireCustomMissile("RAGE_Of_Hawkeye", 0, 0, -8, 0)  // C
	  8H01 C 2 A_GiveInventory("UnholyBossAmmo200", 1)
	  TNT1 AAAAAA 0 A_SpawnItemEx("Hawkeye_Bullet_FX", 0, 4, 28, frandom(2, 8), 0, frandom(5, 10), random(10, 25)*15, 0)
	  8H01 CBAAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
	  Goto ReloadXXX  // ReadyX
	 Altfire:
	  8H01 A 0 A_JumpIfInventory("HawkeyeSnipeFlag1", 1, "CancelZoomIn")
	  8H01 A 0 A_ZoomFactor(2.0)
	  8H01 A 1 A_GiveInventory("HawkeyeSnipeFlag1")
	  8H01 A 4
	  8H01 A 0 A_ReFire
	  goto ReadyX
	 AltHold:
	  8H01 A 2 A_GiveInventory("UnholyBossAmmo200", 1)
	  8H01 A 0 A_ReFire
	  goto ReadyX
	 CancelZoomin:
	  8H01 A 0 A_ZoomFactor(1.0)
	  8H01 A 1 A_TakeInventory("HawkeyeSnipeFlag1")
	  8H01 A 4
	  8H01 A 0 A_ReFire
	  goto ReadyX
	  /*HeyHeyImStillHere:
	  8H01 A 0 A_TakeInventory("UnholyPower1000",3000)
	  8H01 C 0 A_ZoomFactor(1.0)
	  8H01 C 0 A_TakeInventory("HawkeyeSnipeFlag1",1)
	  8H01 C 0 A_GiveInventory("Shocked",1)
	  8H01 C 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
	  8H01 C 0 A_FireCustomMissile("HawkeyeRageShot",0,0,0,0)
	  8H01 BCB 2 A_GiveInventory("UnholyBossAmmo200",1)
	  8H01 AAAAAAAAAAAAAAAAAA 3 A_GiveInventory("UnholyBossAmmo200",1)
	  Goto ReadyX*/
	 NoAmmo:
	  8H01 A 1
	  Goto ReadyX

	 Reload:
	  TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Jump")
	  Goto ReadyX
	 Jump:
	  TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
	  TNT1 A 0 A_SpawnItemEx("FlashBangThingyBoss", 0, 0, 0)
	  TNT1 A 0 A_GiveInventory("HunterHawkeyeSpeedHelp")
	  TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P", 1)
	  Goto ReadyX
	}
}

actor HawkeyeSnipeFlag1 : Once {}

actor Hawkeye_Exhaust : Inventory {
	inventory.amount 1
	inventory.maxamount 120
}

actor Hawkeye_Reload_Flag : Inventory {
	inventory.amount 1
	inventory.maxamount 52
}
actor Hawkeye_Reload : Inventory {
	inventory.amount 1
	inventory.maxamount 12
}

actor Hawkeye_Rounds : Ammo  // Inventory
{
	inventory.amount 1
	inventory.maxamount 6
	+INVENTORY.IGNORESKILL
}


actor HunterHawkeyeFlag : Inventory {
	inventory.amount 1
	inventory.maxamount 20
}


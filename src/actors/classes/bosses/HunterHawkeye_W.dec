actor HunterHawkeyeSpeedHelp : PowerSpeed {
	Speed 1.0
	Powerup.Duration 10
}

actor Hawkeye_Noontime_Flash : BasicClientSide {
	Translation "192:192=170:170", "198:198=40:40"
	renderstyle translucent
	alpha 1.0
	scale 3.5  // 5.0
	states {
	 Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_PlaySoundEx("weapon/lasertrident", "Weapon")
	  X_4A ABCDEF 1 A_FadeOut(0.12)
	  stop
	}
}

actor FlashBangThingyBoss : BasicExplosion {
	damagetype "HawkeyeBlind"
	Obituary "%o's eyes were fried by \cmHunter \crHawkeye\c- (%k)'s \cjNoontime\c-."
	States {
	 Spawn:
	  TNT1 A 0
	  TNT1 AA 0 A_SpawnItemEx("Hawkeye_Noontime_Flash", random(-1000, 1000), random(-1000, 1000), random(-96, 256), 0, 0, 0, 0, 0)
	  TNT1 A 2 A_Explode(20, 1000, 0, 0, 1000)
	  TNT1 AA 0 A_SpawnItemEx("Hawkeye_Noontime_Flash", random(-1000, 1000), random(-1000, 1000), random(-96, 256), 0, 0, 0, 0, 0)
	  TNT1 A 2 A_Explode(20, 1000, 0, 0, 1000)
	  TNT1 AA 0 A_SpawnItemEx("Hawkeye_Noontime_Flash", random(-1000, 1000), random(-1000, 1000), random(-96, 256), 0, 0, 0, 0, 0)
	  TNT1 A 2 A_Explode(20, 1000, 0, 0, 1000)
	  TNT1 AA 0 A_SpawnItemEx("Hawkeye_Noontime_Flash", random(-1000, 1000), random(-1000, 1000), random(-96, 256), 0, 0, 0, 0, 0)
	  TNT1 A 2 A_Explode(20, 1000, 0, 0, 1000)
	  TNT1 AA 0 A_SpawnItemEx("Hawkeye_Noontime_Flash", random(-1000, 1000), random(-1000, 1000), random(-96, 256), 0, 0, 0, 0, 0)
	  TNT1 A 2 A_Explode(20, 1000, 0, 0, 1000)
	  stop
	}
}


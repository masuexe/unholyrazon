// SkullanMinusInfinityBoss
actor Skullman4MI : BossBase {
  Player.ScoreIcon "UB028MUG"
  Player.SoundClass "Skullman4MI"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 2250
  Health 2250
  Player.MorphWeapon "Skullman4MI_W"
  States {
   Spawn:
    SKUL A 0
    SKUL B 1
    SKUL A 1
    goto Spawn+2
   See:
    SKUL BCDE 5
    goto Spawn
   Missile:
    SKUL F 5
    SKUL G 4
    goto Spawn+2
   ClassPain:
    SKUL H 0
    goto MegamanPain
   ClassDeath:
    SKUL H 0
    goto MegamanDeath
  }
}

actor JuggerbroSilver_W_ScriptBar : ScriptBar {}
actor JuggerbroSilver_W : BaseUnholyBossWep {
  Tag "$TAG_JuggerbroSilver_W"
  Obituary "%o was crushed by \cuJuggerbro Silver\c- (%k)."
  Inventory.Pickupmessage "\cfJuggernauts... made of SOLID SILVER."
  Weapon.AmmoType "UnholyPower1000"
  States {
   Spawn:
    8H32 [ 1
    wait

   Deselect:
    8H32 A 0
    goto DeselectSwap
   Select:
    8H32 A 0
    goto SelectSwap

   Ready:
    8H32 A 0  // Initial setup: boss morph hook.
    8H32 A 0  // Initial setup: boss morph hook.
    8H32 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, JUGGERBROSILVER_DYE)
    8H32 A 6
    8H32 A 0  // Initial setup: boss morph hook.
    8H32 A 0  // Initial setup: boss morph hook.
    goto ReadyX
   ReadyX:
    8H32 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX2")
    8H32 A 2 A_WeaponReady(WRF_NOSECONDARY)
    8H32 A 0 A_GiveInventory("UnholyPower1000", 15)
    goto ReadyX
   ReadyX2:
    8H32 A 2 A_WeaponReady
    8H32 A 0 A_GiveInventory("UnholyPower1000", 15)
    loop

   Fire:
    8H32 B 0 A_GiveInventory("VivifyDelay6")
    8H32 B 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "FireX")
    8H32 B 0 A_JumpIfInventory("UnholyBossAmmo100", 80, "Fire5")
    8H32 B 0 A_JumpIfInventory("UnholyBossAmmo100", 60, "Fire4")
    8H32 B 0 A_JumpIfInventory("UnholyBossAmmo100", 40, "Fire3")
    8H32 B 0 A_JumpIfInventory("UnholyBossAmmo100", 20, "Fire2")
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 0, 0, 8, 0)
    // 8H32 B 0 A_GunFlash("Flash.Ammo",1)
    8H32 B 0 A_GiveInventory("UnholyBossAmmo100", 10)
    8H32 BCDEFGZZZHIAA 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
    goto FireEnd
   Fire2:
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 0, 0, 8, 0)
    8H32 B 0 A_GiveInventory("UnholyBossAmmo100", 10)
    8H32 BCDEFGZZZHIA 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
    goto FireEnd
   Fire3:
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 0, 0, 8, 0)
    8H32 B 0 A_GiveInventory("UnholyBossAmmo100", 10)
    8H32 BCDEFGZZZHI 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
    goto FireEnd
   Fire4:
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", -5, 0, 8, 0)
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 5, 0, 8, 0)
    8H32 B 0 A_GiveInventory("UnholyBossAmmo100", 10)
    8H32 BCDEFGZZHI 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
    goto FireEnd
   Fire5:
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", -5, 0, 8, 0)
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 5, 0, 8, 0)
    8H32 B 0 A_GiveInventory("UnholyBossAmmo100", 10)
    8H32 BCDEFGZHI 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
    goto FireEnd
   FireX:
    8H32 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", -10, 0, 8, 0)
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 0, 0, 8, 0)
    8H32 B 0 A_FireCustomMissile("JuggerSilverCrusher", 10, 0, 8, 0)
    8H32 BCDEFGHI 2 A_GiveInventory("UnholyPower1000", 15)
    8H32 B 0 A_ReFire
   FireEnd:
    8H32 B 0 A_SpawnItemEx("JuggerSilverAmmo_H", 0, 0, 28)
    goto ReadyX

    /*Flash.Ammo:
TNT1 AAAAAAAAAAA 2 A_GiveInventory("UnholyPower1000",15)
stop*/

   AltFire:
    // 8H32 A 0 A_JumpIfInventory("UnholyPower1000",1000,"BeginMeteor")
    // goto ReadyX
    // BeginMeteor:
    8H32 M 0 A_GiveInventory("JuggerGold_AltStart_P")
    8H32 M 0 A_ReFire(1)
    8H32 N 2 A_TakeInventory("UnholyPower1000", 63)
    8H32 O 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8H32 OPQRS 2 A_GiveInventory("JuggerSilver_AltWindup_P")
    TNT1 AAAAAAAAAA 2 A_GiveInventory("JuggerSilver_AltWindup_P")  // -8
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    TNT1 A 0 A_PlaySoundEx("weapon/solarblaze", "Weapon")
    TNT1 A 0 ThrustThingZ(0, 0, 0, 0)
    TNT1 A 0 A_SetArg(1, angle * 100000)
    TNT1 A 0 A_SetArg(2, pitch * 100000)
    // TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    TNT1 A 1 A_GiveInventory("JuggerSilver_AltLoop_P0")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorCollide")
    TNT1 A 0 A_JumpIfInventory("JuggerSilverFlag", 100, "MeteorTimeOut")

   MeteorLoop:
    TNT1 A 1 A_GiveInventory("JuggerSilver_AltLoop_P2")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorCollide")
    TNT1 A 0 A_JumpIfInventory("JuggerSilverFlag", 100, "MeteorTimeOut")

    TNT1 A 1 A_GiveInventory("JuggerSilver_AltLoop_P")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorCollide")
    TNT1 A 0 A_JumpIfInventory("JuggerSilverFlag", 100, "MeteorTimeOut")

    TNT1 A 1 A_GiveInventory("JuggerSilver_AltLoop_P")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorCollide")
    TNT1 A 0 A_JumpIfInventory("JuggerSilverFlag", 100, "MeteorTimeOut")

    TNT1 A 1 A_GiveInventory("JuggerSilver_AltLoop_P")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorCollide")
    TNT1 A 0 A_JumpIfInventory("JuggerSilverFlag", 100, "MeteorTimeOut")
    loop

   MeteorTimeOut:
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    goto MeteorEnd
   MeteorCollide:
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "Body")
    TNT1 A 0 A_FireCustomMissile("JuggerSilverCollide", 0, 0, 0, 0)
    TNT1 A 0 ThrustThingZ(0, 60, 0, 0)
    goto MeteorEnd
   MeteorEnd:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    // TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 A_GiveInventory("VivifyDelay5")
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_ReFire(1)
    8H32 HIA 4
    8H32 A 1 A_GiveInventory("JuggerGold_AltReset_P")
    goto ReadyX
  }
}

actor JuggerSilverFlag : Inventory {
  Inventory.MaxAmount 100
}

actor JuggerSilverAmmo_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("VivifyDelay6", 1, "Death")  // kills old one, new one spawns at end
    TNT1 A 2 A_TakeFromTarget("UnholyBossAmmo100", 2)
    TNT1 A 0 A_JumpIfInTargetInventory("UnholyBossAmmo100", 2, "Spawn")
    goto Death
  }
}

actor JuggerSilver_AltWindup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 32, 1)
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 31)
    // TNT1 A 0 A_TakeInventory("JuggerSilverFlag",5)
    stop
  }
}

actor JuggerSilver_AltLoop_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(sqrt(velx * velx + vely * vely + velz * velz) < 40, "End")
    // TNT1 A 0 A_SpawnItemEx("JuggerSilverMotionCheck")
    TNT1 A 0 A_SpawnItemEx("JuggerSilverWallChecker", cos(-args[2] * 0.00001) * 4, 0, 32 + (sin(-args[2] * 0.00001) * 4), cos(-args[2] * 0.00001) * 40, 0, sin(-args[2] * 0.00001) * 40, args[1] * 0.00001, 4)
    TNT1 A 0 A_SpawnItemEx("JuggerSilverCollideCheck", 0, 0, -8, velx, vely, velz, 0, 1 + 8)
    TNT1 A 0 A_GiveInventory("JuggerSilverFlag", 1)
    // TNT1 A 0 A_ChangeVelocity(cos(pitch)*75,0,-sin(pitch)*75,3)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_ChangeVelocity(cos(args[1] * 0.00001) * cos(args[2] * 0.00001) * 80, sin(args[1] * 0.00001) * cos(args[2] * 0.00001) * 80, -sin(args[2] * 0.00001) * 80, 2)  // 75
    stop
    TNT1 A 0 A_ChangeVelocity(cos(args[1] * 0.00001) * cos(args[2] * 0.00001) * 100, sin(args[1] * 0.00001) * cos(args[2] * 0.00001) * 100, -sin(args[2] * 0.00001) * 100, 2)
    stop
   End:
    TNT1 A 0 A_GiveInventory("JuggerSilverFlag", 100)
    stop
  }
}
actor JuggerSilver_AltLoop_P0 : JuggerSilver_AltLoop_P {
  States {
   Pickup:  // No velocity check since '0' on first call
    goto Super::Pickup+1
  }
}
actor JuggerSilver_AltLoop_P2 : JuggerSilver_AltLoop_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("JuggerSilverMeteorRing", 0, 0, 32, 0, 0, 0, args[1] * 0.00001, 1 + 4)  // SXF_ABSOLUTEANGLE = 4
    goto Super::Pickup
  }
}

actor JuggerSilverCrusher : BasicFastProjectile {
  Translation "192:192=83:83", "198:198=90:90", "0:0=3:3"
  Projectile
  DamageType "JuggerSilver"
  Obituary "%o was crushed by \cuJuggerbro Silver\c- (%k)."
  // +HEXENBOUNCE
  // -ALLOWBOUNCEONACTORS
  +SKYEXPLODE
  Damage (100)  // 150
  Radius 18
  Height 10
  Speed 125  // 85
  Scale 3.0
  States {
   Spawn:
    X_KB ABABABABABAB 3
    X_KB A 0 A_CountDown
    loop
  }
}

actor JuggerSilverMotionCheck : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2
    TNT1 A 1 A_JumpIfCloser(40, "Stopped")
    stop
   Stopped:
    TNT1 A 1 A_GiveToTarget("JuggerSilverFlag", 100)
    stop
  }
}

actor JuggerSilverWallChecker {
  Projectile
  +THRUSPECIES
  Species "Megaman"  // Players
  Damage (0)
  Radius 4
  Height 4
  Speed 40
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    stop
   XDeath:
   Death:
    TNT1 A 0 A_GiveToTarget("JuggerGoldFlag")
   Crash:
   Cease:
    TNT1 A 1
    stop
  }
}

actor JuggerSilverCollideCheck : BasicFastProjectile {
  DamageType "JuggerSilver"
  Obituary "%o was hugged by \cuJuggerbro Silver\c- (%k)."
  +DONTSPLASH
  +DONTBLAST
  +THRUGHOST
  +DONTREFLECT
  Damage (25)
  Radius 62
  Height 72
  States {
   Spawn:
    goto Death
   XDeath:
    TNT1 A 0 A_GiveToTarget("JuggerGoldFlag")
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("JuggerGoldMeteorFX_H", 0, 0, 8 + 32, 0, 0, 0, 0, 1)
    stop
  }
}

actor JuggerSilverCollide : BasicExplosion {
  Translation "192:192=83:83", "198:198=90:90"
  DamageType "JuggerSilver"
  Obituary "%o was \cuDESTROYED\c- by \cuJuggerbro Silver\c- (%k)."
  Scale 3.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(1000, 192, 0, 0, 144)  // Just leaving a note, why such odd numbers before
    X_8B ABCDEF 2
    stop
  }
}
actor JuggerSilverMeteorRing : BasicExplosion {
  DamageType "JuggerSilver"
  Obituary "%o was \cuDESTROYED\c- by \cuJuggerbro Silver\c- (%k)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(100, 196, 0, 0, 64)
    TNT1 A 2 A_SpawnItemEx("JuggerGoldMeteorRingFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor IronCurtainItemTime : Inventory
{
inventory.amount 1
inventory.maxamount 100
}

actor IronCurtainHiddenFuel : Inventory
{
inventory.amount 1
inventory.maxamount 25
}

actor IronCurtainRamTime : Inventory
{
inventory.amount 1
inventory.maxamount 100
}

actor IronCurtain_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    stop
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    stop
  }
}
actor IronCurtain_Ready8_P : IronCurtain_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    stop
   PickupReload:
    TNT1 A 0 A_WeaponReady(8+16)
    stop
  }
}

actor IronCurtainIronBody : BasicProjectile
{
var int user_NoTranslation;
PROJECTILE
damagetype "IronCurtainRam"
Obituary "%o was run over by \cmIron \cdCurtain\c- (%k)."
+THRUGHOST
+DONTBLAST
+DONTREFLECT
Renderstyle "None"
Damage (random(315,425))
radius 72
Height 168
States
{
Spawn:
TNT1 AA 1
stop
Death:
TNT1 A 0
Stop
}
}

actor IronCurtainIronBodyFX : BasicExplosion
{

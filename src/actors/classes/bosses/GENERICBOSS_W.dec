actor GENERICBOSS_W_NormalBar : NormalBar {args 218, 40}
actor GENERICBOSS_W_SecondBar : SecondBar {args 204, 132}

// Marks DisabledAirJumps granted by GENERICBOSS_W Flash for low ammo (not external).
actor GenericBossAirDisable_F : Inventory {
  inventory.amount 1
  inventory.maxamount 1
}

actor GENERICBOSS_W : BaseUnholyBossWep
{
Tag "$TAG_Boss024_W"
Obituary "%o was downed by a \cgGENERIC BOSS\c- (%k)!"
Inventory.Pickupmessage "\cgERIKEDAWT?"
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H24 [ 1
wait

Deselect:
8H24 A 0 A_JumpIfInventory("GenericBossAirDisable_F", 1, "Deselect_ClearAir")
goto DeselectSwap
Deselect_ClearAir:
8H24 A 0 A_TakeInventory("DisabledAirJumps", 1)
8H24 A 0 A_TakeInventory("GenericBossAirDisable_F", 1)
goto DeselectSwap
Select:
8H24 A 0
goto SelectSwap

Ready:
8H24 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H24 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GENERICBOSS_DYE)
8H24 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 24,3500,550)  // minimum delay for core_SetCustomActorProperty
8H24 A 0 A_GiveInventory("AirJumpLimit", 1)
8H24 A 0 ACS_NamedExecuteWithResult("core_SetCustomActorProperty", 0, CAPROP_AirJumpZ, 1966080)  // 30 * 65536
// 8H24 A 0 A_GiveInventory("AirJumpZ", 120)
8H24 A 0 A_GunFlash  // A_GunFlash("Flash1")  // Needs DONTTHRUST to exist
goto ReadyX
ReadyX:
8H24 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyX2")
8H24 A 2 A_WeaponReady(WRF_NOSECONDARY)
8H24 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
ReadyX2:
8H24 A 2 A_WeaponReady
8H24 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop

Fire:
8H24 A 2 Offset(10,54)
8H24 C 0 A_PlaySound("Bat_Rob/Short_P",1,0.85)
8H24 C 0 A_CustomPunch(500,1,0,"GenericMeleeFisterPuff", 256)//,0.2)
8H24 BCD 2 Offset(-1,33)
8H24 D 2 Offset(-10,45)
8H24 C 2 Offset(-1,33)
8H24 C 2 Offset(-10,41)
8H24 B 2 Offset(-1,33)
8H24 A 2 Offset(6,42)A_ReFire
Goto ReadyX

// Ammo-gated air jump: disable when ammo < 100; re-enable only the stack we applied.
// GenericBossAirDisable_F marks OUR DisabledAirJumps so external disables are never taken.
Flash:
TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
TNT1 A 0 A_JumpIfInventory("AirJumpsUsed", 1, "Flash_UsedJump")
goto Flash_Ammo
Flash_UsedJump:
TNT1 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
goto Flash_Ammo
Flash_Ammo:
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "Flash_Full")
goto Flash_Low
Flash_Full:
TNT1 A 0 A_JumpIfInventory("GenericBossAirDisable_F", 1, "Flash_ClearOurs")
goto Flash_End
Flash_ClearOurs:
TNT1 A 0 A_TakeInventory("DisabledAirJumps", 1)
TNT1 A 0 A_TakeInventory("GenericBossAirDisable_F", 1)
goto Flash_End
Flash_Low:
TNT1 A 0 A_JumpIfInventory("DisabledAirJumps", 1, "Flash_End")
TNT1 A 0 A_GiveInventory("DisabledAirJumps", 1)
TNT1 A 0 A_GiveInventory("GenericBossAirDisable_F", 1)
goto Flash_End
Flash_End:
TNT1 A 1
goto Flash

// Flash1://Flash:
// TNT1 A 1 A_GiveInventory("JumpCancler",1)
// TNT1 A 0 A_JumpIfInventory("PowerQuarterDamage",1,"Flash2")
// loop
// Flash2:
// TNT1 A 1 A_GiveInventory("JumpCancler",1)
// TNT1 A 0 A_JumpIfInventory("PowerQuarterDamage",1,"Flash2")
// goto Flash3
// Flash3:
// TNT1 A 0 A_SetMass(25)
// goto Flash

AltFire:
8H24 A 0 A_JumpIfInventory("UnholyPower1500",1500,"FaggotasoDefenses")
Goto ReadyX
FaggotasoDefenses:
8H24 A 2 Offset(10,54)
8H24 C 0 A_PlaySoundEx("item/refill","Weapon")
8H24 C 0 A_TakeInventory("UnholyPower1500",1500)
8H24 C 0 A_GiveInventory("Guardsphere",1)
8H24 BCD 2 Offset(-1,33)
8H24 D 0 A_GiveInventory("GenericBossDefensive_P",1)
8H24 D 2 Offset(-10,45)
8H24 C 2 Offset(-1,33)
8H24 C 2 Offset(-10,41)
8H24 B 2 Offset(-1,33)
8H24 A 2 Offset(6,42)//A_SetMass(9999)
Goto ReadyX
}
}

actor GenericMeleeFisterPuff : BulletPuff
{
+USESPAWNEVENTSCRIPT
var int user_UseProjSpawnFunc;
Translation "192:192=204:204", "198:198=132:132"
Damagetype "GenericBoss"
Obituary "%o was downed by a \cgGENERIC BOSS\c- (%k)!"
+PUFFGETSOWNER
+ALWAYSPUFF
+THRUGHOST
+PUFFONACTORS
+NOGRAVITY
-RANDOMIZE
+DONTBLAST
VSpeed 0
RenderStyle Translucent
Alpha 0.99
Scale 1.75
States
{
Spawn:
Melee:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("GenericMeleeFisterSound",0,0,8)
TMFX ABCD 2
stop
Crash:
TNT1 A 0
TMFX ABCD 2
stop
}
}

actor GenericMeleeFisterSound : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("classes/DerpyHit2",1,0.85)
TNT1 A 0 A_PlaySound("classes/DerpyHit2",2,0.85)
TNT1 A 4 A_PlaySound("classes/DerpyHit2",3,0.85)
stop
}
}

actor GenericBossDefensive_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, true)
TNT1 A 0 A_SpawnItemEx("GenericBossDefensive_H",0,0,28)
stop
}
}

actor GenericBossDefensive_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("PowerQuarterDamage",1,"Spawn")
goto Death
Death:
TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", CallACS("core_getptrtid",2)-999, false)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", CallACS("core_getptrtid",2)-999, false)
TNT1 A 1
stop
}
}

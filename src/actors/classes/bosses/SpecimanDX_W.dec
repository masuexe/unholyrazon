actor SpecimanDX_W_ScriptBar : ScriptBar {}
actor SpecimanDX_W : BaseUnholyBossWep {
  Tag "$TAG_Boss542_W"
  Obituary "\cjSpeciman DX\c- (%k) assumed that %o was not worthy of being assumed."
  Inventory.Pickupmessage "Hark Hark"
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo250"
  States {
   Spawn:
    9H42 [ 1
    wait

   Deselect:
    9H42 A 0
    goto DeselectSwap
   Select:
    9H42 A 0
    goto SelectSwap

   Ready:
    9H42 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    9H42 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, SpecimanDX_DYE)
    9H42 A 0 A_GiveInventory("IsSpecimanFlag")
    9H42 A 6
    goto ReadyX
   ReadyX:
    9H42 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "ReadyX2")
    9H42 A 2 A_GiveInventory("SpecimanDX_Ready8_P")
    loop
   ReadyX2:
    9H42 A 2 A_GiveInventory("SpecimanDX_Ready0_P")
    loop

   Reload:
    9H42 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Pinpoint")
    goto ReadyX
   Pinpoint:
    9H42 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    9H42 A 2 A_FireCustomMissile("ASPFlashGammaPinpoint", 0, 0, 0, 0)
    9H42 A 1
    goto ReadyX

   Fire:
    9H42 D 0 A_JumpIfInventory("UnholyPower1500", 1500, "FlashMenacingSmile")
    9H42 D 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    9H42 D 2 Offset(-6, 25)A_FireCustomMissile("ASPSmackerShot", 0, 0, 0, 8)
    9H42 DDDDD 2 Offset(-12, 18)
    9H42 D 2 Offset(-8, 23)A_GiveInventory("UnholyBossAmmo200", 1)
    9H42 B 2 Offset(-4, 28)A_GiveInventory("UnholyBossAmmo200", 1)
    9H42 B 2 Offset(-2, 30)A_GiveInventory("UnholyBossAmmo200", 1)
    9H42 B 0 A_WeaponReady(14)
    9H42 BBBBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo200", 1)
    Goto ReadyX
   FlashMenacingSmile:
    9H42 C 0 A_TakeInventory("UnholyPower1500", 1500)
    9H42 C 0 A_SpawnItemEx("GhostF_RageStartHelper")
    9H42 C 2 Offset(5, 28)
    9H42 E 2 Offset(12, 25)
    9H42 E 2 Offset(18, 19)
    9H42 DDD 2 Offset(23, 16)
    9H42 D 0 A_PlaySoundEx("E_B/StarStorm", "Weapon")
    9H42 D 0 A_PlaySoundEx("E_B/StarStorm", "Body")
    9H42 FDFDFDFDFDFDFDFDFDFDFD 3 A_SpawnItemEx("ASPStarStormAlpha", random(256, -256), random(256, -256), 512, 0, 0, random(-20, -40), random(0, 359))
    9H42 FDFDFDFDFD 2 A_SpawnItemEx("ASPStarStormAlpha", random(512, -512), random(512, -512), 512, 0, 0, random(-20, -40), random(0, 359))
    9H42 D 0 A_PlaySoundEx("E_B/StarStorm", "Weapon")
    9H42 D 0 A_PlaySoundEx("E_B/StarStorm", "Body")
    9H42 FDFDFDFDFDFDFDFDFDFD 2 A_SpawnItemEx("ASPStarStormAlpha", random(512, -512), random(512, -512), 512, 0, 0, random(-20, -40), random(0, 359))
    9H42 FDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFD 1 A_SpawnItemEx("ASPStarStormAlpha", random(728, -728), random(728, -728), 512, 0, 0, random(-20, -40), random(0, 359))
    9H42 E 2 Offset(18, 19)
    9H42 E 2 Offset(12, 25)
    9H42 C 2 Offset(5, 28)
    9H42 C 0 A_WeaponReady(14)
    9H42 C 10
    9H42 B 12
    Goto ReadyX
   Altfire:
    9H42 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PowerfulShield")
    Goto ReadyX
   DeployClone:  // Applying another shield is mean.
    9H42 C 0 A_FireCustomMissile("SpecimanPowerVisionSpawner", 0, 0, 8, 0, 0, 0)
    9H42 C 0 A_TakeInventory("UnholyBossAmmo250", 250)

    9H42 C 2 Offset(5, 28)
    9H42 E 2 Offset(12, 25)
    9H42 E 2 Offset(18, 19)
    9H42 DDDDDD 2 Offset(23, 16)
    9H42 E 2 Offset(18, 19)
    9H42 E 2 Offset(12, 25)
    9H42 B 2 Offset(5, 28)
    Goto ReadyX
   PowerfulShield:
    9H42 A 0 A_JumpIfInventory("BasicArmor", 1, "DeployClone")
    9H42 C 2 Offset(5, 28)A_GiveInventory("SpecimanDX_ItemStart_P")
    9H42 E 2 Offset(12, 25)
    9H42 E 2 Offset(18, 19)A_SpawnItemEx("ASPPowerShieldAppliedFX")
    9H42 DDDDDDDDDDDDDD 2 Offset(23, 16)A_SpawnItemEx("ASPPowerShieldAppliedFX")
    9H42 E 2 Offset(18, 19)A_SpawnItemEx("ASPPowerShieldAppliedFX")
    9H42 E 2 Offset(12, 25)
    9H42 B 2 Offset(5, 28)
    9H42 B 0 A_WeaponReady(14)
    9H42 BBBBBBBBBBBBBBBBBB 0 A_SpawnItemEx("ASPPowerShieldDeploymentFX", random(-2, 2), random(-2, 2), 28, random(-35, 35), random(-35, 35), random(-35, 35))
    9H42 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    9H42 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    9H42 BBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo200", 1)
    Goto ReadyX
  }
}

actor SpecimanDX_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor SpecimanDX_Ready8_P : SpecimanDX_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor SpecimanDX_ItemStart_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
    TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F", 1250)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125)
    TNT1 A 0 A_GiveInventory("SpecimanDX_BasicArmor_P", 1)
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySound("E_B/Shield1")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    stop
  }
}

actor ASPSmackerShot : BasicProjectile {
  Translation "192:192=4:4", "198:198=84:84"
  damagetype "ASPMagicDX"
  Obituary "%o was power-smacked by \cjSpeciman DX\c- (%k)'s \ccASP Smacker\c-."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (150)
  radius 26
  height 26
  Speed 42
  scale 4.5
  States {
   Spawn:
    CHBU ABCD 2 A_SpawnItemEx("ASPSmackerShotFX", -6, Random(-14, 14), random(4, -4), 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(200, 188, 0)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("ASPSmackerShotFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    X_8B ABCDEF 2 A_SpawnItemEx("ASPSmackerShotExplode", random(-164, 164), random(-164, 164), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPSmackerShotFX : BasicGraphicEffect {
  scale 4.5
  States {
   SpawnFrame:
    X_7A I 2
    X_7A J 8
    X_7A J 1 A_Fadeout
    wait
  }
}

actor ASPSmackerShotFX2 : BasicGraphicEffect {
  Scale 4.5
  States {
   SpawnFrame:
    TMFX AAAABBBCC 2 A_FadeOut(0.05)
    Stop
  }
}

actor ASPSmackerShotExplode : BasicExplosion {
  damagetype "ASPMagicDX"
  Obituary "%o was power-smacked by \cjSpeciman DX\c- (%k)'s \ccASP Smacker\c-."
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(100, 164, 0)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}


actor ASPStarStormAlpha : BasicProjectile {
  Translation "192:192=3:3", "198:198=208:208"
  damagetype "ASPMagicDX"
  Obituary "%o saw stars from \cjSpeciman DX\c- (%k)'s \cuASP Starstorm\c-."
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  Reactiontime 40
  damage (0)
  radius 20
  height 12
  Scale 16
  States {
   Spawn:
    6P0K E 0
    6P0K E 0 A_ChangeVelocity(10, 0, momz, 3)
    6P0K EEFFGGHH 1 A_JumpIf(ceilingz-z>8, "Spawn2")
    6P0K E 0 A_JumpIf(momz==0, "Death")
    6P0K E 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    6P0K E 0 A_ChangeFlag("RIPPER", 0)
    6P0K E 0 A_ChangeFlag("NOINTERACTION", 0)
    6P0K E 0 A_SpawnItemEx("ASPStarStormAlphaFX", 0, 0, 16)
    6P0K E 2 A_ChangeVelocity(10, 0, momz, 3)
    6P0K E 0 A_SpawnItemEx("ASPStarStormAlphaFX", 0, 0, 16)
    6P0K F 2 A_ChangeVelocity(10, 0, momz, 3)
    6P0K F 0 A_SpawnItemEx("ASPStarStormAlphaFX", 0, 0, 16)
    6P0K G 2 A_ChangeVelocity(10, 0, momz, 3)
    6P0K G 0 A_SpawnItemEx("ASPStarStormAlphaFX", 0, 0, 16)
    6P0K H 2 A_ChangeVelocity(10, 0, momz, 3)
    6P0K H 0 A_JumpIf(momz==0, "Death")
    6P0K H 0 A_CountDown
    Goto Spawn2+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_playSoundEx("E_B/StarStormHit", "Weapon")
    TNT1 A 0  // A_SetGravity(0.0)
    TNT1 A 0 A_Explode(random(135, 165), 192, 0, 0, 193)
    TNT1 AAAA 1 A_SpawnItemEx("ASPStarStormAlphaExplode", random(-192, 192), random(-192, 192), random(-96, 96))
    stop
  }
}

actor ASPStarStormAlphaFX : BasicGraphicEffect {
  Translation "192:192=95:95", "198:198=85:85"
  Scale 12
  States {
   SpawnFrame:
    6P0K EFGHEFGH 2 A_FadeOut(0.06)
    Stop
  }
}

actor ASPStarStormAlphaExplode : BasicExplosion {
  Translation "192:192=4:4", "198:198=84:84"
  damagetype "ASPMagicDX"
  Obituary "%o saw stars from \cjSpeciman DX\c- (%k)'s \cuASP Starstorm\c-."
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(random(135, 165), 128, 0, 0, 128)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}



actor ASPFlashGammaPinpoint : FastProjectile {
  Translation "192:192=4:4", "198:198=84:84"
  damagetype "BossTimeStop"
  Obituary "%o entered a real-life war scenario."
  +THRUGHOST
  +DONTREFLECT
  +DONTBLAST
  +HITTRACER
  damage (10)
  Radius 10
  Height 10
  Speed 775
  Scale 3.5
  States {
   Spawn:
    TNT1 A 1
    loop
   Crash:
    TNT1 A 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    X_8B FEDCBA 2
    TNT1 A 10
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("ASPSmackerShotFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    TNT1 A 0 A_SpawnItemEx("ASPFlashGammaKaboom")
    X_8B ABCDEF 1
    stop
   Death:
    TNT1 A 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    X_8B FEDCBA 2
    stop
  }
}

actor ASPFlashGammaKaboom : ASPFlashReal {
  Obituary "%o's life ceased from \cjSpeciman DX\c- (%k)'s \cuASP Flash DX\c-."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Weapon")
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Voice")
    TNT1 A 1 A_Explode(9999, 48, 0, 0, 49)
    stop
  }
}

actor ASPPowerShieldDeploymentFX : ASPShieldDeploymentFX {
  Translation "192:192=208:208", "198:198=254:254"
}

actor ASPPowerShieldAppliedFX : ASPShieldAppliedFX {
  Translation "192:192=4:4", "198:198=254:254"
}

actor SpecimanPowerVisionSpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("SpecimanPowerVision", 48, 0, -32, 0, 0, 0, 0, 0, 0)
    stop
  }
}

actor SpecimanPowerVision : BasicProjectile {
  Translation "192:192=251:251", "198:198=254:254", "0:8=246:246", "247:247=246:246"
  +THRUGHOST
  +THRUACTORS
  +NOCLIP
  +DONTBLAST
  RenderStyle "Translucent"
  Alpha 0.70
  reactiontime 50
  health 9999
  Damage (0)
  Radius 32
  Height 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/copyvision", "weapon")
    TNT1 A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
    8E04 A 2
    TNT1 A 2
    8E04 A 2
    TNT1 A 2
    Goto Shooting
   Shooting:
    8E04 A 1 A_GiveToTarget("UH_TargetMarker")
    8E04 A 1 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 32)
    8E04 F 0 A_PlaySoundEx("weapon/minchrgshot", "Body")
    8E04 F 1 A_CustomMissile("ASPVisionShot", 32, 0, Random(-2, 2), 2, -pitch)
    8E04 F 2
    8E04 A 1
    8E04 G 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    8E04 G 0 A_Countdown
    Loop
   Death:
    8E04 HHHHH 3 A_Fadeout
    Stop
  }
}

actor ASPVisionShot : BasicProjectile {
  Translation "192:192=251:251", "198:198=254:254"
  damagetype "ASPMagicDX"
  Obituary "%o was in-sights of \ctClone Speciman\c- (%k)'s \cmASP Pew\c-."
  RenderStyle "Translucent"
  Alpha 0.4
  Damage (150)
  radius 16
  height 16
  Speed 50
  States {
   Spawn:
    TNT1 A 1
    CHBU ABCDAB 2 A_FadeIn(0.1)
   Spawn2:
    CHBU CDAB 2
    loop
   Death:
    TMFX ABC 2
    stop
  }
}

actor TheCommandoChamp : BossBase
{
player.scoreIcon "UB057MUG"
player.soundclass "CommandoChamp"
player.forwardmove 0.9, 0.9
player.sidemove 0.85, 0.85
player.jumpz 12
Player.MaxHealth 4250
Health 4250
player.morphweapon "TheCommandoChamp_W"
States
{
Spawn:
CMDM A 0
CMDM A 0 A_JumpIfInventory("VivifyFlag1",1,"Leap")
CMDM B 1
CMDM A 1
wait
See:
CMDM BCDE 5// A_JumpIfInventory("VivifyFlag1",1,"Leap")
Goto Spawn
Missile:
CMDM F 2 A_JumpIfInventory("VivifyFlag1",1,"Leap")
CMDM FFF 1 A_JumpIfInventory("VivifyFlag1",1,"Leap")
CMDM G 4 A_JumpIfInventory("VivifyFlag1",1,"Leap")
goto Spawn+2
Leap:
CMDM R 0 A_JumpIfInventory("CaughtYouFlag",1,"Throw")
CMDM R 1 A_CheckFloor("Leap2")
loop
Leap2:
CMDM S 5 //8
CMDM S 2 A_JumpIfInventory("VivifyFlag1",1,"Leap2") //0
goto Spawn
Throw:
CMDM F 4 
CMDM F 2 A_JumpIfInventory("CaughtYouFlag",1,"Throw") //0
CMDM S 2 A_JumpIfInventory("VivifyFlag1",1,"Leap") //0
goto Leap2
ClassPain:
CMDM H 0
Goto MegamanPain
ClassDeath:
CMDM H 0
Goto MegamanDeath
}
}

actor RichDevilEye_W_NormalBar : NormalBar {args 130, 10}  // ScriptBar {}

Actor RichDevilEye_W : BaseUnholyBossWep {
  Tag "$TAG_RichDevilEye_W"
  Obituary "%o was envious of %k the \cqDevileye Richman\c-!"
  weapon.ammotype "UnholyBossAmmo400"
  Inventory.Pickupmessage "\cdConvert them!"
  States {
   Spawn:
    8K02 [ 1
    wait

   Ready:
    8K02 D 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, RICHDEVILEYE_DYE)
    goto ReadyX
   ReadyX:
    8K02 D 2 A_WeaponReady
    8K02 D 0 A_GiveInventory("UnholyBossAmmo400", 4)
    loop

   Fire:
    8K02 E 0 A_PlaySoundEx("items/MoneyUse", "Weapon")
    8K02 E 0 A_FireCustomMissile("RichDevilCashDamage", 0, 0, 0, 0)
    8K02 E 1 A_FireCustomMissile("RichDevil_Moola", 0, 0, 0, 0)
    8K02 E 0 A_FireCustomMissile("RichDevil_Moola", 15, 0, 0, 0)
    8K02 E 1 A_FireCustomMissile("RichDevil_Moola", -15, 0, 0, 0)
    8K02 F 0 A_FireCustomMissile("RichDevil_Moola", 30, 0, 0, 0)
    8K02 F 1 A_FireCustomMissile("RichDevil_Moola", -30, 0, 0, 0)
    8K02 F 0 A_FireCustomMissile("RichDevil_Moola", 45, 0, 0, 0)
    8K02 F 1 A_FireCustomMissile("RichDevil_Moola", -45, 0, 0, 0)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo400", 2)
    8K02 D 2 Offset(0, 132)A_GiveInventory("UnholyBossAmmo400", 2)
    8K02 D 2 Offset(0, 112)A_GiveInventory("UnholyBossAmmo400", 2)
    8K02 D 2 Offset(0, 92)A_GiveInventory("UnholyBossAmmo400", 2)
    8K02 D 2 Offset(0, 72)A_GiveInventory("UnholyBossAmmo400", 2)
    8K02 D 2 Offset(0, 52)A_GiveInventory("UnholyBossAmmo400", 2)
    Goto ReadyX
   Altfire:
    8K02 D 0 A_JumpIfNoAmmo("NoAmmo")
    8K02 D 0 A_JumpIfInventory("UnholyBossAmmo400", 400, "JumpDamnit")
    goto ReadyX
   JumpDamnit:
    8K02 D 0 A_TakeInventory("UnholyBossAmmo400", 10)
    8K02 ABC 1
    8K02 D 0 A_GiveInventory("SpecialDemonEyeJumpPowers")
    goto ReadyX
   NoAmmo:
    8K02 D 1
    goto ReadyX
  }
}


actor SpecialDemonEyeJumpPowers : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("Pokemon/SpiderWeb", "Body")
    TNT1 A 0 A_SpawnItemEx("SpecialJumpPowerGiver")
    // TNT1 A 0 A_GiveInventory("HighJumpRuneFlag", 1)
    TNT1 A 0 A_GiveInventory("PowerHighJump")
    stop
  }
}

actor SpecialJumpPowerGiver : BasicWatcher {
  States {
   Spawn:
    TNT1 A 1
   DrainTheAmmo:
    TNT1 A 1 A_TakeFromTarget("UnholyBossAmmo400", 5)
    TNT1 A 0 A_JumpIfInTargetInventory("UnholyBossAmmo400", 5, "DrainTheAmmo")
    // TNT1 A 0 A_GiveToTarget("",1)
   LoseTheRunes:
    TNT1 A 0  // A_TakeFromTarget("HighJumpRuneFlag")
    TNT1 A 1 A_TakeFromTarget("PowerHighJump", 10)  // A_GiveToTarget("ProsperityRune",1)
    stop
  }
}


actor RichDevilCashDamage : BasicExplosion {
  damagetype "RichDevilCash"
  Obituary "%k the \cqDevileye Richman\c- caused %o to witness the GREAT DEPRESSION."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(175, 182, 0, 0, 24)
    stop
  }
}

actor RichDevil_Moola : EyeMorphShot {
  MorphProjectile.PlayerClass "RichDevilDemoneye"
  MorphProjectile.UnMorphFlash "RichDevilDemoneyeC"
}

actor FBeast : BossBase {
  Player.ScoreIcon "UB109MUG"
  Translation "192:192=24:24", "198:198=45:45", "208:208=224:224", "199:199=204:204"
  Player.SoundClass "FBeast"
  Player.DamageScreenColor "black"
  Player.ForwardMove 0.88, 0.88
  Player.SideMove 0.88, 0.88
  Player.JumpZ 16
  Player.MaxHealth 3250
  Health 3250
  StencilColor "White"
  Player.MorphWeapon "FBeast_W"
  Player.WeaponSlot 1, "FBeast_W1"
  Player.WeaponSlot 2, "FBeast_W2"
  Player.WeaponSlot 3, "FBeast_W3"
  Player.WeaponSlot 4, "FBeast_W4"
  Player.WeaponSlot 5, "FBeast_W5"
  Player.WeaponSlot 6, "FBeast_W6"
  States {
   Spawn:  // SHDE
    8B09 A 0
    8B09 B 1
    8B09 A 1
    goto Spawn+2
   See:
    8B09 BCDE 5
    goto Spawn
   Missile:
    8B09 F 0 A_JumpIfInventory("VivifyDelay9", 1, "Missile1")
    8B09 F 0 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    8B09 F 5
    8B09 G 4
    goto Spawn
   Missile1:
    8B09 F 2
    8B09 G 2
    8B09 F 3
    8B09 G 2
    8B09 F 3
    8B09 G 2
    8B09 F 2
    goto Spawn
   Missile2:
    8B09 F 1
    8B09 G 2
    8B09 F 1
    goto Spawn
   ClassPain:
    8B09 H 0
    goto MegamanPain
   ClassDeath:
    8B09 H 0
    goto MegamanDeath
   MegamanDeath0:
    8B09 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8B09 H 0 A_GiveInventory("CutterFlag", 5)
   MegamanExplode:
    8B09 H 0 A_JumpIfInventory("KnightFlag", 6, "Spawn2")
    8B09 H 0 A_JumpIfInventory("CutterFlag", 4, "SpawnXP")
    8B09 H 1 Thing_SetTranslation(0, GBEAST_DEATHDYE)
    8B09 H 1 Thing_SetTranslation(0, FBEAST_DYE)
    8B09 H 0 A_GiveInventory("CutterFlag", 1)
    loop
   SpawnXP:
    8B09 H 0 A_PlaySoundEx("MMBN6/DeathExplode", "Body")  // 0.274s = 9.59 tic
    8B09 H 0 A_SpawnItemEx("BN_ExplodeFX", random(14, 48), 0, random(16, 42), 0, 0, 4, random(0, 359))
    8B09 H 0 A_TakeInventory("CutterFlag")
    // The local client jumps on inventory but cannot Give/Take it here.
    // Yield before rechecking CutterFlag to avoid a recursive 0-tic cycle.
    8B09 H 1 A_GiveInventory("KnightFlag", 1)
    goto MegamanExplode
   Spawn2:
    8B09 H 0 A_GiveInventory("DeathFadeOutFlag")
    8B09 H 1 Thing_SetTranslation(0, GBEAST_DEATHDYE)
    8B09 H 1 Thing_SetTranslation(0, FBEAST_DYE)
    8B09 H 0 A_FadeOut(0.18, 0)
    8B09 H 0 A_JumpIfInventory("DeathFadeOutFlag", 6, "MegamanErase")
    loop
  }
}

  Player.SideMove 0.9, 0.9
  Player.JumpZ 10
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "RedHero_W"
  States {
   Spawn:
    8A38 A 0
    8A38 B 1
    8A38 A 1
    goto Spawn+2
   See:
    8A38 BCDE 5
    goto Spawn
   Missile:
    8A38 F 5
    8A38 G 4
    goto Spawn+2
   ClassPain:
    8A38 H 0
    goto MegamanPain
   ClassDeath:
    8A38 H 0
    goto MegamanDeath
  }
}

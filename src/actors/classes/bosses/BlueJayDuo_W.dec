actor BlueJayDuo_W_NormalBar : NormalBar {args 73, 78}
actor BlueJayDuo_W : BaseUnholyBossWep {
  Tag "$TAG_BlueJayDuo_W"
  Obituary "%o was shot down by \chBlue Jay\c- (%k)."
  Weapon.AmmoType "UnholyBossAmmo250"
  States {
   Spawn:
    8H34 [ 1
    wait

   Deselect:
    8H34 A 0
    goto DeselectSwap
   Select:
    8H34 A 0
    goto SelectSwap

   Ready:
    8H34 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLUEJAYDUO_DYE)
    goto ReadyX
   ReadyX:
    8H34 A 0 A_JumpIfInventory("UnholyBossAmmo250", 40, "ReadyX2")
    8H34 A 2 A_WeaponReady(WRF_NOSECONDARY)
    8H34 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    loop
   ReadyX2:
    8H34 A 2 A_WeaponReady
    8H34 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    loop

   Fire:
    8H34 A 0 A_PlaySoundEx("Contra3/Rifle", "Weapon")
    // 8H34 GG 1 A_FireBullets(6,2.5,2,30,"BlueJayBulletHit",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
    8H34 GG 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 G 1
    8H34 GG 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 G 1
    8H34 H 2 A_GiveInventory("UnholyBossAmmo250", 1)
    8H34 B 0 A_PlaySoundEx("Contra3/Rifle", "Body")
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 E 2 A_GiveInventory("UnholyBossAmmo250", 1)
    8H34 D 0 A_ReFire("Fire2")
    8H34 D 2 A_GiveInventory("UnholyBossAmmo250", 1)
    goto ReadyX
   Fire2:
    8H34 A 0 A_PlaySoundEx("Contra3/Rifle", "Weapon")
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 H 2 A_GiveInventory("UnholyBossAmmo250", 1)
    8H34 B 0 A_PlaySoundEx("Contra3/Rifle", "Body")
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 BB 0 A_FireCustomMissile("BlueJayBullet", frandom(-6, 6), 0, 0, 0, 0, random(-2.5, 2.5))
    8H34 B 1
    8H34 E 2 A_GiveInventory("UnholyBossAmmo250", 1)
    8H34 D 0 A_ReFire("Fire2")
    8H34 D 2 A_GiveInventory("UnholyBossAmmo250", 1)
    goto ReadyX
   AltFire:
    8H34 A 0 A_JumpIfInventory("UnholyBossAmmo250", 40, "AirFire")
    goto ReadyX
   AirFire:
    8H34 A 0 A_TakeInventory("UnholyBossAmmo250", 40)
    8H34 A 0 A_PlaySoundEx("Contra3/CrushGun", "Weapon")
    8H34 A 0 A_FireCustomMissile("BlueJayMissile", 0, 0, 0, 0)
    8H34 BCB 2
    goto ReadyX
  }
}
/*
actor BlueJayBulletHit
{
Translation "192:192=73:73","198:198=78:78"
Damagetype "BlueJay"
Obituary "%o was shot down by \chBlue Jay\c- (%k)."
+NOGRAVITY
+BLOODLESSIMPACT
Scale 1.5
States
{
Spawn:
TMFX ABCD 2
stop
}
}
 */
actor BlueJayBullet : RedBaronBullet {
  Translation "192:192=73:73", "198:198=78:78"
  DamageType "BlueJay"
  Obituary "%o was shot down by \chBlue Jay\c- (%k)."
  Damage (30)
}

actor BlueJayMissile : BasicProjectile {
  Translation "192:192=73:73", "198:198=78:78"
  DamageType "BlueJayFling"
  Obituary "%o went boom from \chBlue Jay\c- (%k)'s Danger Missile."
  -EXTREMEDEATH
  Damage (random(95, 195))
  Radius 10
  Height 10
  Speed 95
  Scale 3.5
  States {
   Spawn:
    X_4G AB 1
    loop
   Death:
    TNT1 A 0 A_PlaySoundEx("Contra3/GrenadeExplode", "Body")
    TNT1 A 0 A_PlaySoundEx("Contra3/GrenadeExplodeBG", "Weapon")
    TNT1 A 1 A_SpawnItemEx("BlueJayMissileExplosion")
    stop
  }
}

actor BlueJayMissileExplosion : BasicExplosion {
  DamageType "BlueJayFling"
  Obituary "%o went boom from \chBlue Jay\c- (%k)'s Danger Missile."
  +FORCEXYBILLBOARD
  Scale 5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(random(75, 150), 200, 1, 0, 10)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ColorAnyPalette", 0x183858, 0x4060f8)
    C3XP PAQRS 2
    stop
  }
}


// HazardTag credits lethal self/environment damage to the recent attacker.

actor HazardTag_BlueJayFling : BasicACSDamager {
  DamageType "BlueJayFling"
  Obituary "%o went boom from their own Danger Missile while fighting %k."
}

actor Floovy_W_NormalBar : NormalBar {Args 161, 218}
actor Floovy_W_SecondBar : SecondBar {Args 219, 174}
actor Floovy_W : BaseUnholyBossWep {
  Tag "$TAG_Floovy_W"
  Obituary "%o became nourishment for \c[p5]Floovy\c- (%k)."
  Inventory.Pickupmessage "\cmFloovy? Flowey?"
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyPower3000"
  States {
   Spawn:
    8H75 [ 1
    wait

   Deselect:
    8H75 A 0
    goto DeselectSwap
   Select:
    8H75 A 0
    goto SelectSwap

   Ready:
    8H75 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, FLOOVY_DYE)
    8H75 A 0  // Initial setup: boss morph hook.
    goto ReadyX

   ReadyX:
    // 8H75 A 0 A_JumpIfInventory("FloovyPlugFlag",1,"ReadyX.Plugging")
    8H75 A 1 A_WeaponReady
    8H75 A 0 A_GiveInventory("UnholyBossAmmo200", 1)
    loop

   Fire:
    8H75 C 0 A_JumpIfInventory("FloovyPlugFlag", 1, "ReadyX")
    8H75 C 0 A_JumpIfInventory("UnholyPower3000", 0, "GoldExperienceRequiem")
    8H75 C 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    8H75 C 0 A_FireCustomMissile("FloovyOutOfBodyShot", 0, 0, 8, 0)
    8H75 CBAAAAAAA 3 A_GiveInventory("UnholyBossAmmo200", 1)
    goto ReadyX

   AltFire:
    8H75 C 0 A_JumpIfInventory("FloovyPlugFlag", 1, "ReadyX")
    8H75 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto ReadyX
    8H75 C 0 A_TakeInventory("UnholyBossAmmo200", 0, 1)
    8H75 C 0 A_PlaySoundEx("weapon/magnetmissile", "Weapon")
    8H75 C 0 A_FireCustomMissile("FloovyPlug", 0, 0, 8, 0)
    8H75 CE 2
    8H75 DDDD 1 A_JumpIfInventory("FloovyPlugFlag", 1, "ReadyX.Plugging")
    // 8H75 DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD 1 A_JumpIfInventory("FloovyPlugFlag",1,"ReadyX.Plugging")
   AltFireEnd:
    8H75 A 4 A_PlaySoundEx("weapon/adapterreturn", "Body")
    goto ReadyX

   ReadyX.Plugging:
    8H75 D 1 A_WeaponReady(14)
    8H75 D 0 A_JumpIfInventory("FloovyPlugFlag", 1, "ReadyX.Plugging")
    goto AltFireEnd

   GoldExperienceRequiem:
    8H75 C 0 A_TakeInventory("UnholyPower3000")
    8H75 BC 2
    8H75 C 0 A_JumpIfInventory("FloovyPlugFlag", 1, "ReadyX")
    8H75 C 0 A_PlaySoundEx("Pokemon/ShadowBall", "Weapon")
    8H75 C 0 A_FireCustomMissile("FloovyGoldenShot", 0, 0, 8, 0)
    8H75 CBA 2
    8H75 A 40
    goto ReadyX
  }
}
actor FloovyPlugFlag : Once {}
actor FloovyOutOfBodyDebugItem : CustomInventory {
  Inventory.PickupMessage "\cmFloovy out-of-body debug"
  Inventory.PickupSound "WilyWar/Snd_37"
  Inventory.Icon "UMUG_S50"
  +COUNTITEM
  +INVBAR
  States {
   Spawn:
    TNT1 A 0
    stop
   Use:
    // A_SpawnItemEx is executed with the item owner's player as `self`, so
    // the carrier's TARGET pointer remains valid even when that player is a
    // morphed Floovy actor with TID 0.
    TNT1 A 0 A_SpawnItemEx("FloovyOutOfBodyDebugTrigger", 0, 0, 0, 0, 0, 0, 0, 0)
    fail
  }
}
actor FloovyOutOfBodyDebugTrigger {
  +NOINTERACTION
  +NOGRAVITY
  States {
   Spawn:
    // Defer one tic so A_SpawnItemEx has finished installing the carrier's
    // TARGET pointer before the ACS preparation runs.
    TNT1 A 1
    TNT1 A 0 A_JumpIf(CallACS("rz_debug_FloovyOutOfBodyPrepare") == 0, "Abort")
    TNT1 A 0 A_SpawnItemEx("FloovyGhost", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS, 0, CallACS("rz_CountInv_FloovyOutOfBodyTID", 2))
    goto Done
   Abort:
    TNT1 A 0
   Done:
    TNT1 A 0
    stop
  }
}
actor FloovyOutOfBodyTID : Inventory {
  // Stores a per-effect link TID.  It must not be limited to the 1000-series
  // player TIDs because morphed players may have actor TID 0.
  Inventory.MaxAmount 0x7ffffffd
}
actor FloovyOutOfBodyViewTID : Inventory {
  // Camera target link stored on the hit player; unlike the owner marker it
  // must be readable by FloovyGhostOn when that player has TID 0.
  Inventory.MaxAmount 0x7ffffffd
}
actor FloovyStandTID : Inventory {
  Inventory.MaxAmount 0x7ffffffd
}
actor FloovyDiesForMeTID : Inventory {
  Inventory.MaxAmount 0x7ffffffd
}
actor FloovyOutOfBodyShot : BasicProjectile {
  Translation "192:192=180:180", "198:198=189:189"
  var int user_linktid;
  DamageType "FloovyOutOfBody"  // "FloovyTimeStop"//"Floovy"
  Obituary "%o was out of body but without body!"
  +HITTRACER
  Damage (50 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)))
  Radius 16
  Height 16
  Speed 40
  Scale 2.5
  States {
   Spawn:
    6P50 OPQ 2
    loop
   Crash:
   XDeath:
    TNT1 A 0 A_JumpIf(!CallACS("uh_istracerplayer"), "Death")
    6P50 R 0 A_JumpIfInventory("Is_UH_BossNum", 1, "BoostYou", 8)
    goto OutOfBody
   OutOfBody:
    6P50 R 0 A_JumpIfInventory("FloovyOutOfBodyProtect", 1, "Death", 8)
    // 6P50 R 0 A_GiveInventory("FloovyOutOfBody_P",1,8)
    6P50 R 0 A_SetUserVar("user_linktid", CallACS("core_uniquetid", 0, 1))
    6P50 R 0 A_JumpIf(user_linktid <= 0, "Death")
    6P50 R 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCancel", CallACS("rz_CountInv_FloovyOutOfBodyTID", 2))
    6P50 R 0 A_TakeInventory("FloovyOutOfBodyTID", 0, 0, 2)
    6P50 R 0 A_GiveInventory("FloovyOutOfBodyTID", user_linktid, 2)
    6P50 R 0 A_GiveInventory("FloovyOutOfBodyViewTID", user_linktid, 8)
    6P50 R 0 A_SpawnItemEx("FloovyGhost", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS, 0, user_linktid)
    6P50 R 0 A_GiveInventory("FloovyOutOfBodyProtect", 1, 8)
    goto Death
   BoostYou:
    6P50 R 0 A_GiveInventory("PowerFloovyDamage", 1, 8)
    6P50 R 0 A_GiveInventory("PowerFloovySpeed", 1, 8)
   Death:
    6P50 OPQ 2 A_FadeOut(0.1)
    loop
  }
}
actor FloovyOutOfBodyProtect : PowerProtection {
  powerup.duration 110  // 105
  damagefactor "FloovyOutOfBody", 0.0
}
actor PowerFloovyDamage : PowerDamage {
  Powerup.duration -5
  DamageFactor "normal", 1.5
}
actor PowerFloovySpeed : PowerSpeed {
  Powerup.duration -5
  Speed 1.5
}
actor FloovyGhost {
  -NOGRAVITY
  +SKYEXPLODE
  +NOINTERACTION
  +THRUACTORS
  +NOCLIP
  +INVULNERABLE
  // A_Countdown drains reactiontime once per game tic; 105 tics = 3 seconds.
  ReactionTime 105
  States {
   Spawn:
    _D02 A 0
    // The owner stores the link TID, while the tracer remains a direct
    // pointer to the hit player (including a morphed player with TID 0).
    // Production/debug spawns pass the link explicitly.  Only the fallback
    // path (legacy map spawn) derives it from the owner marker; this prevents
    // an old Ghost from adopting a newer effect's marker between tics.
    _D02 A 0 A_JumpIf(tid > 0, "SpawnCheck")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) <= 0, "Death")
    _D02 A 0 Thing_ChangeTID(0, CallACS("rz_CountInv_FloovyOutOfBodyTID", 2))
   SpawnCheck:
    _D02 A 0 A_JumpIf(tid <= 0, "Death")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) != tid, "Death")
    _D02 A 0 A_GiveInventory("FloovyGhostOn", 1, 8)
   SpawnL:
    _D02 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 8), "Death")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) != tid, "Death")
    _D02 A 0 ACS_NamedExecuteAlways("rz_FloovyGhostMoving", 0, 8)
    _D02 A 1 A_Countdown
    _D02 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 8), "Death")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) != tid, "Death")
    _D02 A 0 ACS_NamedExecuteAlways("rz_FloovyGhostMoving", 0, 8)
    _D02 B 1 A_Countdown
    _D02 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 8), "Death")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) != tid, "Death")
    _D02 A 0 ACS_NamedExecuteAlways("rz_FloovyGhostMoving", 0, 8)
    _D02 C 1 A_Countdown
    _D02 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 8), "Death")
    _D02 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyOutOfBodyTID", 2) != tid, "Death")
    _D02 A 0 ACS_NamedExecuteAlways("rz_FloovyGhostMoving", 0, 8)
    _D02 B 1 A_Countdown
    loop
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCleanup", 8, tid)
    stop
  }
}
actor FloovyGhostOn : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCameraOn")
    stop
  }
}
actor FloovyGhostOff : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ChangeCamera(0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    TNT1 A 0 A_TakeInventory("FloovyOutOfBodyViewTID", 0x7fffffff)
    TNT1 A 0 A_TakeInventory("FloovyOutOfBodyProtect", 0x7fffffff)
    stop
  }
}
actor FloovyGhostMoveForward : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCopyPitch", 8)
    TNT1 A 0 A_ChangeVelocity(0.5 * cos(pitch), 0, 0.5 * sin(-pitch), CVF_RELATIVE)
    stop
  }
}
actor FloovyGhostMoveBack : CustomInventory {States {Pickup: TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCopyPitch", 8) TNT1 A 0 A_ChangeVelocity(-0.5 * cos(pitch), 0, 0.5 * sin(-pitch), CVF_RELATIVE) stop}}
actor FloovyGhostMoveLeft : CustomInventory {States {Pickup: TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCopyPitch", 8) TNT1 A 0 A_ChangeVelocity(0, 0.5 * cos(pitch), 0.5 * sin(-pitch), CVF_RELATIVE) stop}}
actor FloovyGhostMoveRight : CustomInventory {States {Pickup: TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyGhostCopyPitch", 8) TNT1 A 0 A_ChangeVelocity(0, -0.5 * cos(pitch), 0.5 * sin(-pitch), CVF_RELATIVE) stop}}
actor FloovyGhostTurnLeft : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SetAngle(angle + 1)
    stop
  }
}
actor FloovyGhostTurnRight : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SetAngle(angle - 1)
    stop
  }
}
actor FloovyPlug : BasicProjectile {
  Translation "195:195=180:180", "204:204=59:59"
  var int user_targetTid;
  var int user_tracerTid;
  DamageType "Floovy"
  Obituary "%o was raped by \c[p5]Floovy\c- (%k)'s little plug."
  +HITTRACER
  +THRUGHOST
  +DONTREFLECT
  +DONTBLAST
  +SKYEXPLODE
  Damage (75 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)))
  Height 52
  Radius 52
  Speed 40
  Scale 5
  ReactionTime 70
  States {
   Spawn:
    // 6P50 RRSSTT 1 A_SpawnItemEx("FloovyPlugFX",0,0,0,0,0,0,0,1)
    // loop
    PLGH G 0
    PLGH G 0 A_GiveInventory("FloovyPlugFlag", 1, 2)
    PLGH G 0 A_SetUserVar("user_targetTid", CallACS("core_getptrtid", 2))
   SpawnL:
    PLGH G 1 ACS_NamedExecuteAlways("rz_DrawFloovyPlugCable", 0, 0, user_targetTid, 0)
    PLGH G 0 A_Countdown
    loop
   Crash:
   XDeath:
    TNT1 AAAAAA 0 A_SpawnItemEx("FloovyPlugDeathFX", 0, 0, 0, frandom(-3, 3), 0, frandom(8, 12), random(0, 359), 1)
    PLGH G 0 A_SetUserVar("user_tracerTid", CallACS("core_getptrtid", 8))
    PLGH G 0 ACS_NamedExecuteAlways("rz_FloovyPlugLatch", 0, user_targetTid, user_tracerTid)

    // 6P50 R 0 A_GiveInventory("FloovyPlugFlag",1,2)
    6P50 R 0 A_JumpIfInventory("Is_UH_BossNum", 1, "BoostYou", 8)
    goto VineSummon
   VineSummon:
    6P50 R 0 A_SpawnItemEx("FloovyVine_H", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)  // A_GiveInventory("FloovyVine_P",1,8)
    goto Death
   BoostYou:
    // 6P50 R 0 A_GiveInventory("PowerFloovyRegen",1,8)
    6P50 R 0 A_SpawnItemEx("FloovyRageCharge_H", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)  // A_GiveInventory("FloovyRageCharge_P",1,8)
   Death:
    TNT1 A 0 A_TakeInventory("FloovyPlugFlag", 1, 0, 2)
    stop
  }
}
actor FloovyPlugCableFX : BasicGraphicEffect {
  Translation "204:204=107:107", "195:195=117:117"  // , "250:250=4:4", "249:249=228:228"
  States {
   SpawnFrame:
    PLGH H 0
    PLGH H 2 A_JumpIf(angle > 0, "Woah")
    stop
   Woah:
    PLGH H 0 A_Jump(100, "FX2", "FX3")
   FX1:
    PLGH H 2
    stop
   FX2:
    PLGH I 2 bright
    stop
   FX3:
    PLGH J 2 bright
    stop
  }
}
actor FloovyPlugDeathFX : BasicGraphicEffectM {
  -NOGRAVITY
  States {
   SpawnFrame:
    6P50 OZPZQZ 1
    loop
  }
}
actor FloovyVine_H : BasicWatcher {
  // A_Countdown runs once after each generated tendril.  Four countdowns
  // therefore give this connection a deterministic four-tendril budget.
  ReactionTime 4
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("FloovyPlugFlag", 1, 2)
    TNT1 A 0 A_Jump(256, "Death")
    TNT1 A 0 A_Warp(8, 0, 0, 0, 0, 24)
    TNT1 A 0 A_SpawnItemEx("FloovyVine")
    TNT1 A 0 A_GiveToTarget("UnholyPower3000", 36)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "CountDownRage")
   CountDown:
    TNT1 A 18 A_Countdown
    goto Spawn
   CountDownRage:
    TNT1 A 9 A_Countdown
    goto Spawn
   Death:
    TNT1 A 0 A_TakeInventory("FloovyPlugFlag", 1, 0, 2)
    stop
  }
}
actor FloovyRageCharge_H : BasicWatcher {
  ReactionTime 140
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("FloovyPlugFlag", 1, 2) TNT1 A 0 A_Jump(256, "Death")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 1, 8)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_FloovyRageAmmoGiver", 0, 8)  // A_GiveInventory("")
    TNT1 A 0 A_GiveToTarget("UnholyPower3000", 4)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "CountDownRage")
   CountDown:
    TNT1 A 2 A_Countdown
    goto Spawn
   CountDownRage:
    TNT1 A 1 A_Countdown
    goto Spawn
    loop
   Death:
    TNT1 A 0 A_TakeInventory("FloovyPlugFlag", 1, 0, 2)
    stop
  }
}
actor FloovyVine : BasicProjectile {
  Translation "60:60=107:107", "249:249=60:60", "61:61=160:160", "62:62=229:229"
  DamageType "FloovyFling"  // FloovyVine
  Obituary "%o's buttocks were bruised and mangled by \c[p5]Floovy\c- (%k)'s thorns."
  Radius 12
  Height 12
  Scale 2.5
  Damage (20 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)))
  +FLOORHUGGER
  +THRUACTORS
  ReactionTime 10
  States {
   Spawn:
    BEC2 A 3
    BEC2 A 0 A_PlaySound("misc/mm3explosion", "Voice")
    BEC2 BCDEFG 3 A_Explode(75 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)), 42, 0, 0, 42)
    BEC2 G 0 A_SetDamageType("Floovy")
    BEC2 G 0 A_Jump(256, "SpawnL1", "SpawnL2", "SpawnL3")
   SpawnL1:
    BEC2 H 3
    BEC2 I 3
    BEC2 F 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)), 42, 0, 0, 42)
    BEC2 F 0 A_Countdown
   SpawnL2:
    BEC2 H 3
    BEC2 J 3
    BEC2 F 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)), 42, 0, 0, 42)
    BEC2 F 0 A_Countdown
   SpawnL3:
    BEC2 K 3
    BEC2 L 3
    BEC2 F 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 3)), 42, 0, 0, 42)
    BEC2 F 0 A_Countdown
    goto SpawnL1
   Death:
    BEC2 JMNA 3
    stop
  }
}
actor FloovyGoldenShot : BasicFastProjectile {
  var int user_linktid;
  Translation "192:192=180:180", "198:198=189:189"
  DamageType "Floovy"  // FloovyOutOfBody
  +HITTRACER
  +SEEKERMISSILE
  Damage (0)
  Radius 16
  Height 16
  Speed 70
  States {
   Spawn:
    6P50 RRSSTT 1 A_SeekerMissile(30, 90, SMF_LOOK | SMF_PRECISE, 256, 12)
    loop
   Crash:
   XDeath:
    TNT1 A 0 A_JumpIf(!CallACS("uh_istracerplayer"), "Death")
    6P50 R 0 A_JumpIfInventory("Is_UH_BossNum", 1, "SacrificeMe", 8)
    goto GoldExperience
   GoldExperience:
    // TARGET(2) is the Floovy player that fired this projectile.
    6P50 R 0 A_SetUserVar("user_linktid", CallACS("core_uniquetid", 0, 1))
    6P50 R 0 A_JumpIf(user_linktid <= 0, "Death")
    // ACS_NamedExecuteWithResult has no map-number argument here; the wrapper
    // expects exactly (pointer, toggle, type).
    6P50 R 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 2, false, ELP_FLOOVY_G)
    6P50 R 0 A_TakeInventory("FloovyStandTID", 0, 0, 2)
    6P50 R 0 A_GiveInventory("FloovyStandTID", user_linktid, 2)
    6P50 R 0 A_SpawnItemEx("FloovyStandWatcher", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS, 0, user_linktid)
    6P50 R 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 2, true, ELP_FLOOVY_G)
    goto Death
   SacrificeMe:
    // TRACER(8) is the ally hit by this projectile.
    6P50 R 0 A_SetUserVar("user_linktid", CallACS("core_uniquetid", 0, 1))
    6P50 R 0 A_JumpIf(user_linktid <= 0, "Death")
    6P50 R 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 8, false, ELP_FLOOVY_D)
    6P50 R 0 A_TakeInventory("FloovyDiesForMeTID", 0, 0, 8)
    6P50 R 0 A_GiveInventory("FloovyDiesForMeTID", user_linktid, 8)
    6P50 R 0 A_SpawnItemEx("FloovyDiesForMeLink", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS, 0, user_linktid)
    6P50 R 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 8, true, ELP_FLOOVY_D)
   Death:
    6P50 RST 2 A_FadeOut(0.1)
    loop
  }
}
actor FloovyStandWatcher : BasicWatcher {
  // The watcher is the delayed inflictor for Golden Experience Requiem.
  // A_Explode supplies this actor as the inflictor, so the engine can use
  // this obituary while the direct TARGET/TRACER pointers keep TID 0 safe.
  // Gold Experience Requiem's signature "return to zero" reference.
  Obituary "%o was returned to zero by \c[p5]Floovy\c- (%k)'s Golden Experience Requiem."
  +FORCERADIUSDMG
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 2), "Death")
    TNT1 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyStandTID", 2) != tid, "Stale")
    TNT1 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 8), "Death")
    TNT1 A 1
    loop
   Stale:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 2, false, ELP_FLOOVY_G)
    TNT1 A 0 A_TakeInventory("FloovyStandTID", 0, 0, 2)
    stop
   GoldExperienceKill:
    // TRACER is the enemy and TARGET is Floovy, which becomes %k.
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_Explode(30000, 8, 0, 0, 8)
    stop
  }
}
actor FloovyDiesForMeLink : BasicWatcher {
  // In LMS, the TRACER player is the beneficiary/source and therefore %k.
  // The damage state temporarily moves the original TARGET (Floovy) into
  // MASTER so A_Explode can use TRACER as its attacker without losing the
  // victim pointer.
  // Die For Me! is Alice's signature instant-death skill; here the joke is
  // inverted because Floovy pays the price to save the beneficiary.
  Obituary "\c[p5]Floovy\c- (%o) answered %k's request: \"Die for me!\""
  +FORCERADIUSDMG
  +NOINTERACTION
  +NOGRAVITY
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("rz_FloovyPointerAlive", 2), "FloovyDead")
    TNT1 A 0 A_JumpIf(CallACS("rz_CountInv_FloovyDiesForMeTID", 8) != tid, "Stale")
    TNT1 A 1
    loop
   Stale:
    TNT1 A 0
    stop
   FloovyDead:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FloovyExtraLifePointer", 8, false, ELP_FLOOVY_D)
    TNT1 A 0 A_TakeInventory("FloovyDiesForMeTID", 0, 0, 8)
    stop
   DieForMeKill:
    // Keep the link at Floovy, then use the ally in TRACER as the source.
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
    TNT1 A 0 A_RearrangePointers(AAPTR_TRACER, AAPTR_DEFAULT, AAPTR_DEFAULT)
    TNT1 A 0 A_Explode(30000, 8, 0, 0, 8)
    TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_NULL, AAPTR_DEFAULT)
    stop
  }
}

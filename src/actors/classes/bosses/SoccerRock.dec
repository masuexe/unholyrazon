actor SoccerRock : BossBase {
  Player.SoundClass "SoccerRock"
  Player.ForwardMove 1.225, 1.225
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 5000
  Health 5000
  Player.MorphWeapon "SoccerRock_W"
  States {
   Spawn:
    ROCK A 0
    ROCK B 1
    ROCK A 1
    goto Spawn+2
   See:
    ROCK BCDE 5
    goto Spawn
   Missile:
    ROCK F 5
    ROCK G 4
    goto Spawn+2
   ClassPain:
    ROCK H 0
    goto MegamanPain
   ClassDeath:
    ROCK H 0
    goto MegamanDeath
  }
}

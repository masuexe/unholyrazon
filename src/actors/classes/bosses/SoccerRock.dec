actor SoccerRock : BossBase {
  player.soundclass "SoccerRock"
  player.forwardmove 1.225, 1.225
  player.sidemove 1.2, 1.2
  player.jumpz 12
  Player.MaxHealth 5000
  Health 5000
  player.morphweapon "SoccerRock_W"
  States {
   Spawn:
    ROCK A 0
    ROCK B 1
    ROCK A 1
    Goto Spawn+2
   See:
    ROCK BCDE 5
    Goto Spawn
   Missile:
    ROCK F 5
    ROCK G 4
    goto Spawn+2
   ClassPain:
    ROCK H 0
    Goto MegamanPain
   ClassDeath:
    ROCK H 0
    Goto MegamanDeath
  }
}

  Player.SoundClass "BlackDevilEye"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 2150

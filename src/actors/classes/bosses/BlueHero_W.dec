actor BlueHero_W_NormalBar : NormalBar {args 196, 198}
// "Nothing to change about him, he's perfect." - Trist.
actor BlueHero_W : BaseUnholyBossWep
{
Tag "$TAG_Boss039_W"
Obituary "%o was vanquished by \chBlue Anti-Unholy Elite\c- (%k)!"
Inventory.Pickupmessage "\chAGAINST THE EVIL!"
weapon.ammotype "UnholyBossAmmo150"
//weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8H39 [ 1
wait

Deselect:
8H39 A 0
goto DeselectSwap
Select:
8H39 A 0
goto SelectSwap

Ready:
8H39 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BLUEHERO_DYE)
8H39 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H39 A 0 A_JumpIfInventory("UnholyBossAmmo150",75,"ReadyX2")
8H39 A 2 A_WeaponReady(8)
8H39 A 0 A_GiveInventory("UnholyBossAmmo150",2)
loop
ReadyX2:
8H39 A 2 A_WeaponReady
8H39 A 0 A_GiveInventory("UnholyBossAmmo150",2)
loop

Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//1251
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.60+1,"Flash.GetHypedForPain")
TNT1 A 1
loop
Flash.GetHypedForPain:
TNT1 A 0 A_PlaySound("weapon/mirrorabsorb")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_runeplayer", 0, true, RUNE_RESISTANCE) //_GiveInventory("ResistanceRune_ST",1)
TNT1 A 1
TNT1 A 4 //ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
//stop
Flash.Old:
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", BLUEHERO_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
loop

Fire:
8H39 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H39 A 0 A_FireCustomMissile("BlueHeroShot",0,0,8,0)
// 22 tics (was BCBAAAAAAAA 2). Peak (32,56). Ammo x1 x11.
// 8H39 A/B/C share TEXTURES Offset — safe to switch frames mid-recoil.
8H39 B 1 Offset(8, 38) A_GiveInventory("UnholyBossAmmo150",1)
8H39 B 1 Offset(16, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 C 1 Offset(24, 50) A_GiveInventory("UnholyBossAmmo150",1)
8H39 C 1 Offset(32, 56) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 B 1 Offset(28, 54) A_GiveInventory("UnholyBossAmmo150",1)
8H39 B 1 Offset(20, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 A 1 Offset(14, 42) A_GiveInventory("UnholyBossAmmo150",1)
8H39 A 1 Offset(8, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 A 1 Offset(4, 34) A_GiveInventory("UnholyBossAmmo150",1)
8H39 A 1 Offset(2, 34)
// 8H39 A 0 A_WeaponReady(14)
8H39 AAAAAA 2 A_GiveInventory("UnholyBossAmmo150", 1)
Goto ReadyX
AltFire: //	"This now costs 75, I think it'll reduce a little bit of abuse... I think." - Trist
8H39 A 0 A_JumpIfInventory("UnholyBossAmmo150",75,"SpreadDashThing")
Goto ReadyX //Formerly 50 ammo cost.
SpreadDashThing:
8H39 C 0 A_TakeInventory("UnholyBossAmmo150",75)
8H39 C 0 A_ChangeVelocity(-Cos(pitch)*40,0,sin(pitch)*25,CVF_RELATIVE)
8H39 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H39 C 0 A_FireCustomMissile("BlueHeroShot",-5,0,8,0)
8H39 C 0 A_FireCustomMissile("BlueHeroShot",0,0,8,0)
8H39 C 0 A_FireCustomMissile("BlueHeroShot",5,0,8,0)
// 15 tics (was BCBA 2 + A 7). Stronger dash recoil, peak (48,68).
8H39 C 1 Offset(16, 44)
8H39 C 1 Offset(32, 56) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 C 1 Offset(48, 68)
8H39 B 1 Offset(40, 62) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 B 1 Offset(28, 52)
8H39 A 1 Offset(16, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H39 A 1 Offset(8, 36)
8H39 A 8 A_WeaponReady(14)
Goto ReadyX
}
}

Actor BlueHeroShot : RedHeroShot
{
Translation "192:192=197:197", "198:198=198:198", "202:202=196:196", "199:199=197:197"
Damagetype "HeroBlue"
Obituary "%o was vanquished by \chBlue Anti-Unholy Elite\c- (%k)!"
Damage(150)
States
{
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
TNT1 A 0 A_Explode(150,128,0)
X_8B ABCDEF 2
stop
}
}

Actor BlueHeroShotAlt : BlueHeroShot {
  Damage(100)
  Scale 3.0
}

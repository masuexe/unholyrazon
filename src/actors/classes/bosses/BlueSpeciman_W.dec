actor BlueSpeciman_W_NormalBar : NormalBar {args 200, 75}
actor BlueSpeciman_W_SecondBar : SecondBar {args 4, 94}
actor BlueSpeciman_W_ReloadIcon : ReloadIcon {Tag "R042B0"}
actor BlueSpeciman_W : Speciman_W {
  Tag "$TAG_BlueSpeciman_W"
  Obituary "\chBlue Speciman\c- (%k) assumed that %o was super cereal."
  Inventory.Pickupmessage "Hark Hark"
  Weapon.AmmoType2 "UnholyBossAmmo200"
  Weapon.AmmoType "UnholyBossAmmo250"
  States {
   Spawn:
    8H44 [ 1
    wait

   Deselect:
    8H44 A 0
    goto DeselectSwap
   Select:
    8H44 A 0
    goto SelectSwap

   Ready:
    8H44 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLUESPECIMAN_DYE)
    8H44 A 0  // Initial setup: boss morph hook.
    8H44 A 0  // Initial setup: boss morph hook.
    goto ReadyX
   ReadyX:
    8H44 A 0 A_JumpIfInventory("UnholyBossAmmo250", 125, "ReadyX2")
    8H44 A 2 A_GiveInventory("Speciman_Ready8_P")
    loop
   ReadyX2:
    8H44 A 2 A_GiveInventory("Speciman_Ready0_P")
    loop

   Fire:
    8H44 B 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire", "Weapon")
    8H44 B 2 Offset(-6, 25) A_FireCustomMissile("ASPFreezeShot", 0, 0, 0, 8)
    8H44 C 2 Offset(-12, 18) A_GunFlash("FlashFire")
    8H44 C 0 A_ReFire("FireH")
    goto FireEnd
   FireH:
    8H44 C 1 Offset(-12, 18) A_RailWait
    8H44 C 0 A_ReFire("FireH")
    goto FireEnd
   FireEnd:
    8H44 D 8 Offset(-12, 18) A_GiveInventory("GyroFlag", 1)
    8H44 D 2 Offset(-8, 23)
    8H44 B 2 Offset(-4, 28)
    8H44 B 2 Offset(-2, 30) A_TakeInventory("GyroFlag")
    8H44 B 0 A_WeaponReady(14)
    8H44 BBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo250", 1)
    goto ReadyX

   FlashFire:
    TNT1 A 0 A_JumpIfInventory("GyroFlag", 1, "NoFlash")
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 2 A_GiveInventory("UnholyBossAmmo250", 1)
    loop

   FlashAFire:
    TNT1 A 0 A_JumpIfInventory("GyroFlag", 1, "NoFlash")
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("SpecimanBlockShard", random(-2, 2), random(-2, 2), 32, random(-16, 16), random(-16, 16), random(2, 12), 0, 1)
    TNT1 A 2 A_GiveInventory("UnholyBossAmmo200", 1)
    loop

   Altfire:
    8H44 A 0 A_JumpIfInventory("UnholyBossAmmo250", 125, "ASPFreezeaport")
    goto ReadyX
   ASPFreezeaport:
    8H44 A 0 A_TakeInventory("UnholyBossAmmo250", 125)
    8H44 A 0 A_Stop
    8H44 A 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")
    8H44 A 0 A_GunFlash("FlashAFire")
    8H44 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 30)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 32)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 34)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 36)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 38)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_invisibleplayer", 0, 1)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, 1)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_dontidentifytargetplayer", 0, 1)
    8H44 A 0 A_ChangeVelocity(cos(pitch) * 120, 0, -sin(pitch) * 100, 3)
    8H44 BBBBB 2 Offset(33, 80) A_GiveInventory("UnholyBossAmmo200", 1)
    8H44 B 0 A_ScaleVelocity(0.2)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_invisibleplayer", 0, 0)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, 0)
    8H44 A 0 ACS_NamedExecuteWithResult("uh_dontidentifytargetplayer", 0, 0)
    8H44 B 1 Offset(33, 80) ACS_NamedExecuteWithResult("uh_BossPowerTake", 30)
    8H44 B 1 Offset(25, 67) ACS_NamedExecuteWithResult("uh_BossPowerTake", 32)
    8H44 B 1 Offset(18, 56) ACS_NamedExecuteWithResult("uh_BossPowerTake", 34)
    8H44 B 1 Offset(12, 47) ACS_NamedExecuteWithResult("uh_BossPowerTake", 36)
    8H44 B 1 Offset(7, 40) ACS_NamedExecuteWithResult("uh_BossPowerTake", 38)
    8H44 B 1 Offset(3, 35) A_GiveInventory("GyroFlag", 1)
    8H44 B 2 A_WeaponReady(14)
    8H44 B 10
    8H44 A 2 A_TakeInventory("GyroFlag")
    goto ReadyX

   ASPFlash:
    8H44 B 1 A_GiveInventory("BlueSpecimanASPFlash_P")
    goto ReadyX
  }
}

actor ASPFreezeShot : BasicProjectile {
  Translation "192:192=200:200", "198:198=75:75"
  DamageType "ASPIceMagic"
  Obituary "%o was frozen by \chBlue Speciman\c- (%k)'s \cnASP Freeze\c-."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (100)
  Radius 16
  Height 16
  Speed 24
  Scale 5.0
  States {
   Spawn:
    X_7A D 0
    X_7A D 0 A_ScaleVelocity(1.05)
    X_7A D 0 A_SpawnItemEx("ASPFreezeShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_7A DD 1 A_JumpIfInTargetInventory("GyroFlag", 1, "HarkDeath")
    X_7A E 0 A_SpawnItemEx("ASPFreezeShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_7A EE 1 A_JumpIfInTargetInventory("GyroFlag", 1, "HarkDeath")
    loop
   HarkDeath:
    TNT1 A 0 A_Stop
    TNT1 A 1 A_PlaySoundEx("E_B/IceHit", "Body")
    X_7A DEDEDEDE 1 A_SpawnItemEx("ASPFreezeShotFX2", random(-128, 128), random(-128, 128), random(-128, 128), 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ASPFreezeExplode", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_PlaySoundEx("weapons/mm7/freezecrackersplit", "Weapon")
    stop
   Crash:
    TNT1 A 0 A_SpawnItemEx("ASPFreezeExplode", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_PlaySoundEx("weapons/mm7/freezecrackersplit", "Weapon")
    stop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 1 A_PlaySoundEx("E_B/IceHit", "Body")
    X_7A DEDEDEDEDEDEDEDEDE 1 A_SpawnItemEx("ASPFreezeShotFX2", random(-128, 128), random(-128, 128), random(-128, 128), 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ASPFreezeExplode", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_PlaySoundEx("weapons/mm7/freezecrackersplit", "Weapon")
    stop
  }
}

actor ASPFreezeShotFX : BasicGraphicEffect {
  Alpha 0.75
  Scale 4.5
  States {
   Spawn:
    X_7A BAC 3
    stop
  }
}

actor ASPFreezeShotFX2 : BasicGraphicEffect {
  Alpha 0.90
  States {
   Spawn:
    X_7A DEDEDEDEDE 2 A_FadeOut(0.02)
    stop
  }
}

actor SpecimanBlockShard : BasicProjectile {
  DamageType "ASPIceMagic"
  Obituary "%o was frozen by \chBlue Speciman\c- (%k)'s \cnASP Freeze Shards\c-."
  -NOGRAVITY
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +DONTSPLASH
  +CANBOUNCEWATER
  BounceCount 4
  BounceFactor 0.5
  WallBounceFactor 0.5
  ReactionTime 2
  Damage (25)
  Radius 8
  Height 8
  Speed 10
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "E", "F", "G", "H")
    TNT1 A 1
   E:
    8P44 E 140 A_CountDown
    wait
   F:
    8P44 F 140 A_CountDown
    wait
   G:
    8P44 G 140 A_CountDown
    wait
   H:
    8P44 H 140 A_CountDown
    wait
   Death:
    "----" "#" 0 A_SpawnItemEx("IcePitFreeze")
    "----" "#########" 1 A_Fadeout
    stop
  }
}

actor ASPFreezeExplode : BasicExplosion {
  DamageType "ASPIceMagic"
  Obituary "%o was frozen by \chBlue Speciman\c- (%k)'s \cnASP Freeze\c-."
  Scale 4.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 A 0 A_Explode(250, 186, 0, 0, 64)
    X_8B AABBCCDDEEFF 1 A_SpawnItemEx("ASPFreezeBlastBoomFX", random(-192, 192), random(-192, 192), random(-156, 156), 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPFreezeBlastBoomFX : ASPFreezeExplode {
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(125, 128, 0, 0, 16)
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("SpecimanBlockShard", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor BlueSpecimanASPFlash_P : SpecimanASPFlash_P {
  States {
   FlashC:
    TNT1 A 0 A_FireCustomMissile("ASPFlashTimeStopB", 0, 0, 0, 0)
    stop
   FlashD:
    TNT1 A 0 A_FireCustomMissile("ASPFlashShockerB", 0, 0, 0, 0)
    stop
   FlashE:
    TNT1 A 0 A_FireCustomMissile("ASPFlashBlindB", 0, 0, 0, 0)
    stop
   FlashF:
    TNT1 A 0 A_FireCustomMissile("ASPFlashFlingB", 0, 0, 0, 0)
    stop
  }
}

actor ASPFlashTimeStopB : ASPFlashTimeStop {
  Obituary "%o saw the sudden light of \chBlue Speciman\c- (%k)'s \cuASP Flash\c-."
}
actor ASPFlashShockerB : ASPFlashShocker {
  Obituary "%o saw the sudden light of \chBlue Speciman\c- (%k)'s \cuASP Flash\c-."
}
actor ASPFlashBlindB : ASPFlashBlind {
  Obituary "%o saw the sudden light of \chBlue Speciman\c- (%k)'s \cuASP Flash\c-."
}
actor ASPFlashFlingB : ASPFlashFling {
  Obituary "%o saw the sudden light of \chBlue Speciman\c- (%k)'s \cuASP Flash\c-."
}

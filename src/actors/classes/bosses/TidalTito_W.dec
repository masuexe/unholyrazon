Actor TidalTitoEchoWaver : BasicProjectile {
  // Diveman CBM's copywep sonar ability - is it feasible? It'd be nice for something that can be used somewhat quickly and with low cost.
  Translation "192:192=202:202", "198:198=194:194"
  +DONTBLAST
  +THRUGHOST
  +NOCLIP
  +NOINTERACTION
  Renderstyle "Translucent"
  Alpha 0.65
  Damagetype "TidalTitoEcho"  // .75 hitstun until the possibility of Diveman CBM sonar is applied, if not it stays
  Obituary "\cvTidal \chTito\c- (%k) discovered where %o washed up."
  Damage (0)
  Radius 8
  Height 8
  Speed 24
  Scale 2.0
  Reactiontime 5
  States {
   Spawn:
    TMFX L 0
    TMFX LL 2 A_SetScale(scaleX+0.25, scaleY+0.25)
    TMFX L 0 A_SpawnItemEx("SoakifyEffect")
    TMFX L 0 A_Explode(72, 64, 0)
    TMFX L 0 A_SpawnItemEx("TidalTitoEchoWaverTrail", -8, 0, 0, 0, 0, 0, 0, 1)
    TMFX MM 2 A_SetScale(scaleX+0.25, scaleY+0.25)
    TMFX L 0 A_SpawnItemEx("SoakifyEffect")
    TMFX L 0 A_Explode(60, 80, 0)
    TMFX L 0 A_SpawnItemEx("TidalTitoEchoWaverTrail", -8, 0, 0, 0, 0, 0, 0, 1)
    TMFX LL 2 A_SetScale(scaleX-0.25, scaleY-0.25)
    TMFX L 0 A_SpawnItemEx("SoakifyEffect")
    TMFX L 0 A_Explode(52, 96, 0)
    TMFX L 0 A_SpawnItemEx("TidalTitoEchoWaverTrail", -8, 0, 0, 0, 0, 0, 0, 1)
    TMFX MM 2 A_SetScale(scaleX-0.25, scaleY-0.25)
    TMFX L 0 A_SpawnItemEx("SoakifyEffect")
    TMFX L 0 A_Explode(44, 112, 0)
    TMFX L 0 A_SpawnItemEx("TidalTitoEchoWaverTrail", -8, 0, 0, 0, 0, 0, 0, 1)
    TMFX L 0 A_Countdown
    goto Spawn+1
   Death:
    TNT1 A 0
    stop
  }
}

Actor TidalTitoEchoWaverTrail : BasicGraphicEffect {
  Alpha 0.6
  States {
   SpawnFrame:
    TMFX L 0
    TMFX LL 1 A_SetScale(scaleX-0.3, scaleY-0.3)
    TMFX L 0 A_Fadeout(0.2)
    TMFX MM 1 A_SetScale(scaleX-0.3, scaleY-0.3)
    TMFX L 0 A_Fadeout(0.2)
    TMFX LL 1 A_SetScale(scaleX-0.3, scaleY-0.3)
    TMFX MM 1 A_Fadeout(0.1)
    stop
  }
}


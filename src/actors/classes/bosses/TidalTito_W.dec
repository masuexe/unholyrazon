Actor TidalTitoWave : BasicProjectile {
  // The beauty of aesthetics here is, over time you learn to do the same thing more efficiently, and make it
  // look far better with less. Probably not completely true here but the math works great.
  +DONTBLAST
  +RIPPER
  +THRUGHOST
  +THRUACTORS
  +NOCLIP
  +NOINTERACTION
  +NOTIMEFREEZE
  Damagetype "TidalMaster"
  Obituary "\cvTidal \chTito\c- (%k)'s flow was too much for %o."
  Damage (0)
  Radius 6
  Height 6
  Scale 2.5
  Args 12, 20, 6, 6
  States {
   Spawn:
    6P37 F 0
    6P37 F 0 A_JumpIf(Args[0]>=192, "Spawn2")
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 F 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 F 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 G 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 G 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 H 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 H 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]+Args[3])
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    goto Spawn+1
   Spawn2:
    6P37 FF 1 A_Warp(2, Args[0], 0, Args[1], -2, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    6P37 GG 1 A_Warp(2, Args[0], 0, Args[1], -3, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    6P37 HH 1 A_Warp(2, Args[0], 0, Args[1], -4, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
   Spawn3:
    6P37 F 0 A_SetArg(2, -6)
    6P37 F 0 A_PlaySound("weapon/waterwave", 4, 0.4)
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 FF 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 GG 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 HH 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 F 0 A_JumpIfInTargetInventory("VivifyDelay8", 1, "Death2")
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 FF 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 GG 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 HH 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion2")
    6P37 F 0 A_JumpIfInTargetInventory("VivifyDelay8", 1, "Death2")
    loop
   Death:
    TNT1 A 0
    stop
   Death2:
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 FF 1 A_Warp(2, Args[0], 0, Args[1], 2, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 GG 1 A_Warp(2, Args[0], 0, Args[1], 4, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 HH 1 A_Warp(2, Args[0], 0, Args[1], 6, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(2, 8)
   Death2X:
    6P37 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    6P37 F 0 A_JumpIf(Args[0]<=12, "Death")
    6P37 F 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]-Args[3]*2)
    6P37 G 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]-Args[3]*2)
    6P37 H 1 A_Warp(2, Args[0], 0, Args[1], Args[2], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    6P37 F 0 A_SetArg(0, Args[0]-Args[3]*2)
    6P37 F 0 A_SpawnItemEx("TidalTitoWaveExplosion1")
    loop
  }
}
actor TidalTitoWaveExplosion1 : TidalTitoExplosion {args 36, 64}
actor TidalTitoWaveExplosion2 : TidalTitoExplosion {args 48, 72}

Actor WakeWavePickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "MoveCheck")
    stop
   MoveCheck:
    TNT1 A 0 A_JumpIf(momx!=0, "YesWave")
    stop
   YesWave:
    TNT1 A 0 A_SpawnItemEx("WakeWave", -4, 0, 0, -8, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("WakeWave", -4, -15, 0, -8, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("WakeWave", -4, 15, 0, -8, 0, 0, 0, 1)
    stop
  }
}

Actor WakeWave : BasicProjectile {
  Translation "192:192=202:202", "198:198=194:194", "199:199=206:206"
  Damagetype "TidalMasterThrust"
  Obituary "%o was forced by %k to sleep with the sharks."
  +DONTBLAST
  +RIPPER
  +FLOORHUGGER
  -NOGRAVITY
  +DONTSPLASH
  +NOEXPLODEFLOOR
  Renderstyle "Translucent"
  Alpha 0.6
  Damage (30)
  Radius 22
  Height 10
  Scale 1.5
  States {
   Spawn:
    6P37 FFGGFF 1 A_SpawnItemEx("SoakifyEffect")
    stop
  }
}

Actor TidalTitoRageFX_P : CustomInventory {

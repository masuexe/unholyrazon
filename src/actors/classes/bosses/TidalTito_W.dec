// Boss rage uses TidalTitoPropertyRage + shorter even-duration states.
// Native Rage rune (CF_DOUBLEFIRINGSPEED) stacks on top; do not inherit PlayerPropertyRage.

actor TidalTito_W_ScriptBar : ScriptBar {}
actor TidalTito_W : BaseUnholyBossWep {
  Tag "$TAG_TidalTito_W"
  Inventory.Pickupmessage "Your looks, broski. Hand them over."
  Obituary "%o couldn't live up to the legend of \cvTidal \chTito\c- (%k)."
  weapon.ammotype "UnholyBossAmmo100"
  weapon.ammotype2 "UnholyPower1500"
  States {
   Spawn:
    8H53 ] 6
    loop

   Deselect:
    8H53 A 0
    goto DeselectSwap
   Select:
    8H53 A 0
    goto SelectSwap

   Ready:
    8H53 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    8H53 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, TIDALMASTER_DYE)
    8H53 A 0 A_GunFlash
    Goto ReadyX
   ReadyX:
    8H53 A 0 A_JumpIfInventory("TidalShieldFlag", 1, "ReadyY")
    8H53 A 0 A_JumpIfInventory("UnholyBossAmmo100", 4, "ReadyX2")
    8H53 A 2 A_WeaponReady(8)
    8H53 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    loop
   ReadyX2:
    8H53 A 2 A_WeaponReady
    8H53 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    loop
   ReadyY:
    8H53 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "ReadyY2")
    8H53 A 2 A_WeaponReady(8)
    8H53 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    loop
   ReadyY2:
    8H53 A 2 A_WeaponReady
    8H53 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    loop

   Fire:
    8H53 C 0 A_JumpIfInventory("UnholyBossAmmo300", 1, 1)  // ingore the check if you are already in rage
    8H53 C 0 A_JumpIfInventory("UnholyPower1500", 1500, "Never_AGAIN")
    8H53 C 0 A_JumpIfInventory("TidalShieldFlag", 1, "PlaytimeIsOVER")
    8H53 C 0 A_PlaySoundEx("Contra/C_LASER", "Weapon")
    8H53 C 0 A_FireCustomMissile("TidalTitoLaser", 0, 0, 8, 0)
    8H53 C 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "IAMTHESOLITAIRECHAMPION")
    8H53 CBAAAAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo100", 1)
    goto ReadyX
   IAMTHESOLITAIRECHAMPION:
    // Half of CBAAAAAAAAAAAA 2 (28 -> 14); even duration so Rage rune can halve again
    8H53 CBAAAAA 2 A_GiveInventory("UnholyBossAmmo100", 1)
    goto ReadyX
   PlaytimeIsOVER:
    8H53 C 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H53 C 0 A_FireCustomMissile("TidalTitoPinpointJetSpawner", 0, 0, 8, 0)
    8H53 C 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "PLAYTIMEISOVERTIME")
    8H53 CCBBAAAAAAAAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo100", 1)
    goto ReadyX
   PLAYTIMEISOVERTIME:
    // ~Half recovery; even duration for CF_DOUBLEFIRINGSPEED stacking
    8H53 CCBBAAAAAAA 2 A_GiveInventory("UnholyBossAmmo100", 1)
    goto ReadyX

   Never_AGAIN:
    8H53 A 0 A_GiveInventory("TidalTitoRage_P")
    8H53 A 0 A_SpawnItemEx("TidalTitoRageWatcher")
    8H53 A 0 A_PlaySoundEx("CBM/TrebleFuse", "Weapon")  // note to make consistent with CBM later
    8H53 CB 4
    8H53 A 18
    goto ReadyX

   Altfire:
    8H53 A 0 A_JumpIfInventory("TidalShieldFlag", 1, "I_Run_This_SHIT")
    8H53 B 2
   AltHold:
    8H53 C 0 A_JumpIfInventory("UnholyBossAmmo100", 4, 1)
    goto ReadyX
    8H53 C 0 A_TakeInventory("UnholyBossAmmo100", 4)
    8H53 C 0 A_PlaySoundEx("CBM/ShadeNoise", "Weapon")  // note to make consistent with CBM later
    8H53 C 0 A_FireCustomMissile("TidalTitoEchoWaver", 0, 0, 8, 0)
    8H53 C 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "AltHoldRage")
    8H53 CC 4
    8H53 C 0 A_Refire("AltHold")
    8H53 CB 2
    goto ReadyX
   AltHoldRage:
    8H53 CC 2
    8H53 C 0 A_Refire("AltHold")
    8H53 CB 2
    goto ReadyX

   I_Run_This_SHIT:
    8H53 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    8H53 A 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "NOT_YOU")
    8H53 CB 4
    8H53 A 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H53 A 0 A_FireCustomMissile("HighTideSplitterXSpawner", 0, 0, 8, 0)
    8H53 AA 0 A_SpawnItemEx("HighTideSplitterXSpawner", 0, 0, 28, random(10, 20), random(-20, -10), random(1, 10), 0, 1)
    8H53 AA 0 A_SpawnItemEx("HighTideSplitterXSpawner", 0, 0, 28, random(-10, -20), random(10, 20), random(1, 10), 0, 1)
    8H53 A 20
    goto ReadyX
   NOT_YOU:
    8H53 CB 2
    8H53 A 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H53 A 0 A_FireCustomMissile("HighTideSplitterXSpawner", 0, 0, 8, 0)
    8H53 AA 0 A_SpawnItemEx("HighTideSplitterXSpawner", 0, 0, 28, random(10, 20), random(-20, -10), random(1, 10), 0, 1)
    8H53 AA 0 A_SpawnItemEx("HighTideSplitterXSpawner", 0, 0, 28, random(-10, -20), random(10, 20), random(1, 10), 0, 1)
    8H53 A 10
    goto ReadyX

   Flash:
    TNT1 A 0 A_JumpIfInventory("TidalTitoFlow", 350, "Flash2")
    TNT1 A 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_GiveInventory("TidalTitoFlow_P")
    loop
   Flash2:
    TNT1 A 0 A_GiveInventory("TidalTitoWaveHelper_P")
    TNT1 A 0 A_GiveInventory("TidalShieldFlag")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
   FlashX:
    TNT1 A 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_GiveInventory("TidalTitoFlow_P_X")
    TNT1 A 0 A_JumpIfInventory("TidalTitoFlow", 1, "FlashX")
    goto FlashReset
   FlashReset:
    TNT1 A 0 A_GiveInventory("VivifyDelay8")
    TNT1 A 0 A_TakeInventory("TidalShieldFlag")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    goto Flash
  }
}

Actor TidalTitoFlow : Inventory {Inventory.amount 1  Inventory.maxamount 350}
// Independent of PlayerPropertyRage so uh_runeplayer can still grant PowerDoubleFiringSpeedRune
Actor TidalTitoPropertyRage : Once {}

Actor TidalTitoRage_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UnholyPower1500", 1500)
    TNT1 A 0 A_GiveInventory("TidalTitoPropertyRage")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 300)
    stop
  }
}

Actor TidalTitoFlow_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "No")
    TNT1 A 0 A_GiveInventory("TidalTitoFlow", 1)
    stop
   No:
    TNT1 A 0
    stop
  }
}

Actor TidalTitoFlow_P_X : TidalTitoFlow_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("TidalTitoPropertyRage", 1, "No")
    TNT1 A 0 A_TakeInventory("TidalTitoFlow", 1)
    stop
  }
}

Actor TidalTitoRageWatcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_TakeFromTarget("UnholyBossAmmo300", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("UnholyBossAmmo300", 1, "Spawn")
    goto Death
   Death:
    TNT1 A 0 A_TakeFromTarget("TidalTitoPropertyRage")
    TNT1 A 0 A_TakeFromTarget("UnholyPowerDazzle_F")
    TNT1 A 0 A_TakeFromTarget("CutterFlag")
    TNT1 A 1
    stop
  }
}

Actor TidalTitoLaser : BasicProjectile {
  Translation "192:192=202:202", "198:198=194:194", "199:199=206:206"
  Damagetype "TidalMaster"
  Obituary "%o couldn't withstand \cvTidal \chTito\c- (%k)'s Tidal Waver."
  +RIPPER
  +DONTBLAST
  +THRUGHOST
  +FORCEXYBILLBOARD
  Reactiontime 32
  Damage (60)  // 85
  Radius 12  // 16
  Height 12  // 16
  Speed 60
  Scale 3.0
  States {
   Spawn:
    6P37 A 0
    6P37 A 1 A_SpawnItemEx("TidalTitoLaserTrailA", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 A 1 A_SpawnItemEx("TidalTitoLaserTrailA", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 A 0 A_CountDown
    6P37 B 1 A_SpawnItemEx("TidalTitoLaserTrailB", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 B 1 A_SpawnItemEx("TidalTitoLaserTrailB", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 B 0 A_CountDown
    6P37 C 1 A_SpawnItemEx("TidalTitoLaserTrailC", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 C 1 A_SpawnItemEx("TidalTitoLaserTrailB", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 C 0 A_CountDown
    6P37 D 1 A_SpawnItemEx("TidalTitoLaserTrailD", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 D 1 A_SpawnItemEx("TidalTitoLaserTrailD", 0, 0, 0, 0, 0, 0, 0, 1)
    6P37 A 0 A_Weave(5, 0, 2.5, 0.0)
    6P37 D 0 A_CountDown
    loop
  }
}

Actor TidalTitoPinpointJetSpawner : FastProjectile {
  PROJECTILE
  +DONTBLAST
  +DONTREFLECT
  +DONTSPLASH
  +THRUGHOST
  +THRUACTORS
  Damage (0)
  radius 4
  height 4
  Speed 450
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    goto Spawn+1
   Death:
    TNT1 A 0 A_CheckFloor("JetUp")
    TNT1 A 0 A_JumpIf(z-floorz==0, "JetUp")
    TNT1 AAAAAAAA 1 A_SpawnItemEx("TidalTitoJetFX", 0, 0, 2, random(-2, -10), random(-8, 8), random(-8, 8), 0)
    TNT1 A 0 A_PlaySound("Contra/C_LASER")
    TNT1 AAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("TidalTitoJetShot", 0, 0, 0, -35, 0, 0, 0)
    stop
   JetUp:
    TNT1 AAAAAAAA 1 A_SpawnItemEx("TidalTitoJetFX", 0, 0, 2, random(-4, 4), random(-8, 8), random(2, 6), 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/WaveSummonGo2", "Voice")
    TNT1 A 0 A_SpawnItemEx("TidalTitoJetWave", 0, 0, 2, 0, 0, 0, 0)
    TNT1 A 1
    stop
  }
}


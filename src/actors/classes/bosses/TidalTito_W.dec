actor TidalTitoJetWave : BasicProjectile {
  Translation "192:192=202:202", "198:198=194:194"
  Damagetype "TidalMasterThrust"
  Obituary "%o was sent back to shore by \cvTidal \chTito\c- (%k)'s Jet Wave."
  +THRUACTORS
  +THRUGHOST
  +FLOORHUGGER
  -SOLID
  +NOTARGETSWITCH
  Gravity 9.0
  Reactiontime 7
  Damage (0)
  Radius 2
  Height 2
  Scale 1.5
  States {
   Spawn:
    8P53 A 0
    8P53 ABCDEFG 1
   Loop1:
    8P53 H 0 A_JumpIfCloser(72, "Lift1")
    8P53 H 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 H 0 A_JumpIfCloser(72, "Lift1")
    8P53 H 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 H 0 A_Countdown
   Loop2:
    8P53 I 0 A_JumpIfCloser(72, "Lift2")
    8P53 I 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 I 0 A_JumpIfCloser(72, "Lift2")
    8P53 I 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 H 0 A_Countdown
   Loop3:
    8P53 J 0 A_JumpIfCloser(72, "Lift3")
    8P53 J 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 J 0 A_JumpIfCloser(72, "Lift3")
    8P53 J 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    8P53 J 0 A_Countdown
    goto Loop1
   Lift1:
    8P53 H 0 A_GiveToTarget("TidalTito_JWBoost_P", 1)
    8P53 HH 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    goto Loop2
   Lift2:
    8P53 I 0 A_GiveToTarget("TidalTito_JWBoost_P", 1)
    8P53 II 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    goto Loop3
   Lift3:
    8P53 J 0 A_GiveToTarget("TidalTito_JWBoost_P", 1)
    8P53 JJ 1 A_SpawnItemEx("TidalTitoJetWaveExplosion")
    goto Loop1
   Death:
    8P53 GFEDCBA 2
    stop
  }
}

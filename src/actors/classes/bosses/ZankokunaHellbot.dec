actor ZankokunaHellbot : BossBase {
  Player.ScoreIcon "UB400MUG"
  Player.SoundClass "ZankokunaHellbot"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.JumpZ 15
  Player.MaxHealth 30000
  Health 30000
  Player.MorphWeapon "ZankokunaHellbot_W"
  States {
   Spawn:
    8A08 A 0
    8A08 B 1
    8A08 A 1
    goto Spawn+2
   See:
    8A08 BCDE 5
    goto Spawn
   Missile:
    8A08 F 5
    8A08 G 4
    goto Spawn+2
   ClassPain:
    8A08 H 0 A_JumpIfInventory("DeadlyFlag1", 1, "Interrupted")
    8A08 H 10
    goto Spawn
    // Goto MegamanPain
   Interrupted:
    8A08 H 0 ACS_NamedExecute("uh_StopZankokunaRage", 0, true)
    8A08 H 0 A_TakeInventory("DeadlyFlag1")
    8A08 H 0 A_PlaySoundEx("weapon/crashexplode", "Voice")
    8A08 HHHHHHHHHHHHHHH 1 A_SpawnItemEx("ZankokunaRageEndFX", random(-100, 100), random(-100, 100), random(0, 100))
    goto Spawn
   ClassDeath:
    8A08 H 0
    goto MegamanDeath
   MegamanDeath0:
    8A08 H 20 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
   MegamanExplode:
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 90, 1)
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 45, 1)
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 135, 1)
    goto MegamanFall
   MegamanGib:
    8A08 H 0 A_GiveInventory("CriticalDeathGiver")
    8A08 H 0 A_GiveInventory("CriticalDeathGiver")
    8A08 H 0 A_GiveInventory("CriticalDeathGiver")
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 90, 1)
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 45, 1)
    8A08 H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32, 0, 0, 0, 135, 1)
    goto MegamanErase
  }
}

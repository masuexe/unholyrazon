actor SPOOKYGHOSTHITLER_W_ScriptBar : ScriptBar {}
actor SPOOKYGHOSTHITLER_W : BaseUnholyBossWep {
  Tag "$TAG_SPOOKYGHOSTHITLER_W"
  Obituary "%o was ear-raped by %k"
  Inventory.Pickupmessage "\cgNEEEEEEEIIIINNN"
  Weapon.AmmoType "UnholyBossAmmo200"
  States {
   Spawn:
    8L03 [ 1
    wait

   Deselect:
    TNT1 A 0
    goto DeselectSwap
   Select:
    TNT1 A 0
    goto SelectSwap

   Ready:
    TNT1 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, -1)  // SPOOKYGHOSTHITLER_DYE
    TNT1 A 0 A_GiveInventory("CosmeticBossSpeedTrail")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    goto ReadyX
   ReadyX:
    TNT1 A 1 A_WeaponReady
    TNT1 A 0  // A_GiveInventory("UnholyBossAmmo200",1)
    loop

   Fire:
    TNT1 A 0
    TNT1 A 1 A_PlaySoundEx("weapon/HilterScream", "Weapon")
    goto ScreamTime
   ScreamTime:
    TNT1 A 1 A_GiveInventory("HitlerScreamTimerFlag", 1)
    TNT1 A 0 A_JumpIfInventory("HitlerScreamTimerFlag", 34, "Fire2")
    goto ScreamTime
   Fire2:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("HitlerRandomScreamItem")
    TNT1 A 4
    TNT1 AAAAAAAA 2 A_TakeInventory("HitlerScreamTimerFlag", 6)
    goto ReadyX
   Altfire:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/HilterHonor", "Weapon")
    TNT1 A 0 A_Stop
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    // Was a raw SetPlayerProperty(0,1,PROP_FLY), which no stacker owned and no
    // cleanup could return.  Use the flight stacker so the demorph baseline
    // snapshot can take the layer back (Ready already holds one).
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    TNT1 A 2
    TNT1 AAAAA 4 A_GiveInventory("HitlerRandomHonorItem")
    TNT1 A 4
    TNT1 A 4 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 0, 0)
    TNT1 AAAAAAAA 2
    goto ReadyX
  }
}

actor HitlerScreamTimerFlag : Inventory {
  Inventory.MaxAmount 34
}

actor HitlerScreamBoom0 : BasicExplosion {
  Translation "192:192=89:89", "198:198=3:3"
  DamageType "HitlerScream"
  Obituary "\cmHiglur\c- (%k) told a story about how %o became ZHE UBERMENSCH."
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(800, 468, 0, 0, 64)
    X_1G EFGHIJKLMNEFGHIJKLMN 1 bright
    stop
  }
}

actor HitlerScreamBoom1 : HitlerScreamBoom0 {Obituary "%o wasn't invited to \cmHiglur\c- (%k)'s Oktoberfest party."}
actor HitlerScreamBoom2 : HitlerScreamBoom0 {Obituary "%o was not allowed to get money because of \cmHiglur\c- (%k)'s policies."}
actor HitlerScreamBoom3 : HitlerScreamBoom0 {Obituary "%o did Nazi \cmHiglur\c- (%k) coming."}
actor HitlerScreamBoom4 : HitlerScreamBoom0 {Obituary "\cmHiglur\c- (%k) wanted %o to die \cfNEIN\c- more times."}
actor HitlerScreamBoom5 : HitlerScreamBoom0 {Obituary "\cmHiglur\c- (%k) rolled a Nahtzee and %o lost the game."}
actor HitlerScreamBoom6 : HitlerScreamBoom0 {Obituary "%o was glad %g didn't see \cmMecha Higlur\c- (%k)."}
actor HitlerScreamBoom7 : HitlerScreamBoom0 {Obituary "%o couldn't understand what \cmHiglur\c- (%k) was saying."}
actor HitlerScreamBoom8 : HitlerScreamBoom0 {Obituary "%o suffered a fatal migraine from \cmHiglur\c- (%k)'s screaming."}
actor HitlerScreamBoom9 : HitlerScreamBoom0 {Obituary "%o attended \cmHiglur\c- (%k)'s 1945 war."}
actor HitlerScreamBoom10 : HitlerScreamBoom0 {Obituary "%o wurde von \cmHiglur\c- (%k) getoetet."}
actor HitlerScreamBoom11 : HitlerScreamBoom0 {Obituary "%o wurde von \cmHiglur\c- (%k) erschrocken."}

actor HitlerRandomScreamItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "H0", "H1", "H2", "H3", "H4", "H5", "H6", "H7", "H8", "H9", "H10", "H11")
    TNT1 A 0
    goto H0
   H0:
    TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom0", 0, 0)
    stop
   H1: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom1", 0, 0) stop
   H2: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom2", 0, 0) stop
   H3: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom3", 0, 0) stop
   H4: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom4", 0, 0) stop
   H5: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom5", 0, 0) stop
   H6: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom6", 0, 0) stop
   H7: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom7", 0, 0) stop
   H8: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom8", 0, 0) stop
   H9: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom9", 0, 0) stop
   H10: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom10", 0, 0) stop
   H11: TNT1 A 0 A_FireCustomMissile("HitlerScreamBoom11", 0, 0) stop
  }
}


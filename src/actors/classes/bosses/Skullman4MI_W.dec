actor Skull4MI_BarrierWarper : BasicShieldWarper
{
+NOTIMEFREEZE
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_GiveInventory("MM8BDMProjSpawnFuncClient")
TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper",0,-28)
Goto Shield
Shield:
X_4H A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"ShieldR")
X_4H ABCDEFGH 1 A_Warp(AAPTR_TARGET,0,0,28,0, WARPF_NOCHECKPOSITION | WARPF_COPYINTERPOLATION)
loop
ShieldR:
X_4H A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,1)
goto Shield
X_4H BDFH 1 A_Warp(AAPTR_TARGET,0,0,28,0, WARPF_NOCHECKPOSITION | WARPF_COPYINTERPOLATION)
goto ShieldR
}
}

actor Skull4MI_HellWheel : ProjSpawnFuncActor
{
Translation "192:192=4:4", "198:198=94:94"
damagetype "Skull4MI"
-SOLID
+MISSILE
+RIPPER
-NOGRAVITY
+NOBLOOD
+SHOOTABLE
+INVULNERABLE
+NODAMAGE
+NOPAIN
species "SkullMan4MI_HellWheel"
maxstepheight 33
damage (0)
Radius 16
Height 40
speed 32
scale 2.5
States
{
Spawn:
X_4H A 0
X_4H ABCDEFGH 1 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
loop
Death:
TNT1 A 0 A_SpawnItemEx("Skull4MI_HellWheel2",0,0,0,cos(pitch)*32,0,-sin(pitch)*32,0,1)
stop
}
}

actor Skull4MI_HellWheel2 : Skull4MI_HellWheel
{
+BOUNCEONWALLS
bouncefactor 1.0
wallbouncefactor 1.0
reactiontime 20
+NOEXPLODEFLOOR
+STEPMISSILE
+CANBOUNCEWATER
States
{
Spawn:
X_4H A 0
X_4H ABCDEFGH 1 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
X_4H A 0 A_Countdown
loop
Death:
TNT1 A 0 A_PlaySoundEx("misc/devilfire","Body")
TNT1 A 0 A_SpawnItemEx("Skull4MI_HellWheelDebris",0,0,28,-cos(pitch)*16,0,-sin(pitch)*16+8,random(-65,-55))
TNT1 A 0 A_SpawnItemEx("Skull4MI_HellWheelDebris",0,0,28,-cos(pitch)*16,0,-sin(pitch)*16+8,random(-25,-15))
TNT1 A 0 A_SpawnItemEx("Skull4MI_HellWheelDebris",0,0,28,-cos(pitch)*16,0,-sin(pitch)*16+8,random(15,25))
TNT1 A 0 A_SpawnItemEx("Skull4MI_HellWheelDebris",0,0,28,-cos(pitch)*16,0,-sin(pitch)*16+8,random(55,65))
stop
}
}


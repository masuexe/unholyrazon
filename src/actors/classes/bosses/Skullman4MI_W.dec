actor Skullman4MI_W_NormalBar : NormalBar {args 4, 94}

actor Skullman4MI_W : BaseUnholyBossWep
{
Tag "$TAG_Boss028_W"
Obituary "%o was defeated by \cjSkull Man\c- (%k)'s \cuSkull Buster\c-."
Inventory.Pickupmessage "\cmAmbition!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8H28 [ 1
wait

Deselect:
8H28 D 0
goto DeselectSwap
Select:
8H28 D 0
goto SelectSwap

Ready:
SKUB A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SKULLMAN4MI_DYE)
SKUB A 0 A_TakeInventory("IsPissedFlag")
SKUB A 6
goto ReadyX
ReadyX:
//SKUB A 0 A_JumpIfHealthLower(1351,"GetHypedForPain")
SKUB A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.32+1,"GetHypedForPain")
SKUB A 2 A_WeaponReady
SKUB A 0 A_GiveInventory("UnholyBossAmmo200", 2)
loop
ReadyX_Pissed:
8H28 A 2 A_WeaponReady
8H28 A 0 A_GiveInventory("UnholyBossAmmo200", 3)
loop

Fire:
SKUB A 0 A_JumpIfInventory("IsPissedFlag",1,"FireX")
SKUB A 0 A_JumpIfInventory("Skull4MIFlag",1,"Fire_WheelGo")
SKUB A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.32+1,"GetHypedForPain")
SKUB A 0 A_PlaySoundEx("weapon/skullbust","Weapon")
SKUB A 0 A_FireCustomMissile("Skull4MI_Shot",0,0,8,0)
// SKUB C 2 A_GiveInventory("UnholyBossAmmo200",1)
// SKUB C 1 A_GiveInventory("UnholyBossAmmo200",1)
// SKUB B 1
SKUB C 2 Offset(7, 33) A_GiveInventory("UnholyBossAmmo200", 1)
SKUB CCCCC 2 Offset(14, 40) A_GiveInventory("UnholyBossAmmo200", 1)
SKUB B 0 A_WeaponReady(14)
SKUB BA 2 A_GiveInventory("UnholyBossAmmo200", 1)
goto ReadyX
Fire_WheelGo:
SKUB G 0 A_PlaySoundEx("weapon/skullcounter","Body")
SKUB G 2 A_TakeInventory("UnholyBossAmmo200", 10)
SKUB F 0 A_TakeInventory("UH_125_SpeedPower")
SKUB F 2 A_TakeInventory("UnholyBossAmmo200", 10)
SKUB F 0 A_FireCustomMissile("Skull4MI_HellWheel",0,0,0,0)
SKUB F 2 Offset(-29, 59) A_TakeInventory("UnholyBossAmmo200",10)
SKUB F 2 Offset(-49, 85) A_TakeInventory("Skull4MIFlag")
goto ReadyX

FireX:
8H28 A 0 A_JumpIfInventory("Skull4MIFlag",1,"FireX_WheelGo")
8H28 D 0 A_PlaySoundEx("weapon/skullbust","Weapon")
8H28 D 0 A_FireCustomMissile("Skull4MI_ShotX",0,0,8,0)
8H28 C 2 Offset(7, 33) A_GiveInventory("UnholyBossAmmo200", 2)
8H28 CC 2 Offset(14, 40) A_GiveInventory("UnholyBossAmmo200", 2)
8H28 B 0 A_WeaponReady(14)
8H28 BA 2 A_GiveInventory("UnholyBossAmmo200", 2)
goto ReadyX
goto ReadyX_Pissed
FireX_WheelGo:
8H28 G 0 A_PlaySoundEx("misc/kingchop","Body")
8H28 G 2 A_TakeInventory("UnholyBossAmmo200", 10)
8H28 F 0 A_TakeInventory("UH_150_SpeedPower")
8H28 F 2 A_TakeInventory("UnholyBossAmmo200", 10)
8H28 F 0 A_FireCustomMissile("Skull4MI_HellWheelX",0,0,0,0)
8H28 F 2 Offset(-29, 59) A_TakeInventory("UnholyBossAmmo200",10)
8H28 F 2 Offset(-49, 85) A_TakeInventory("Skull4MIFlag")
goto ReadyX_Pissed

GetHypedForPain:
SKUB A 0 A_GiveInventory("IsPissedFlag")
SKUB A 0 ACS_NamedExecuteWithResult("core_chargecolor", DESPERATECOLOR)  // A_GunFlash
SKUB A 2
8H28 A 2
SKUB A 2
8H28 A 2
goto ReadyX_Pissed
Flash:
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", DESPERATECOLOR)
Goto Flash

AltFire:
SKUB A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"AltFire_Real")
SKUB A 0 A_JumpIfInventory("IsPissedFlag",1,"AltFireX_Real")
Goto Fire
AltFire_Real:
//TNT1 A 0 A_GiveInventory("Skull4MI_HellBoost1",1)
//TNT1 A 0 A_GiveInventory("Skull4MI_HellBoost2",1)
TNT1 A 0 A_GiveInventory("Skull4MIFlag")
TNT1 A 0 A_SpawnItemEx("Skull4MI_BarrierWarper",0,0,28,0,0,0,0,SXF_TRANSFERTRANSLATION)
TNT1 A 1 A_PlaySoundEx("weapon/skullcounter","Body")
TNT1 A 1 A_TakeInventory("UnholyBossAmmo200",10)
SKUB F 1 Offset(-49, 85)
SKUB F 1 Offset(-29, 59)
SKUB F 1 A_WeaponReady(14)
SKUB G 1
SKUB G 0 A_JumpIfInventory("PlayerPropertyRage",1,"HellWheelingRage")
goto HellWheeling
AltFireX_Real:
TNT1 A 0 A_GiveInventory("Skull4MIFlag")
TNT1 A 0 A_SpawnItemEx("Skull4MI_BarrierWarper",0,0,28,0,0,0,0,SXF_TRANSFERTRANSLATION)
TNT1 A 1 A_PlaySoundEx("weapon/skullcounter","Body")
TNT1 A 1 A_TakeInventory("UnholyBossAmmo200",10)
8H28 F 1 Offset(-49, 85)
8H28 F 1 Offset(-29, 59)
8H28 F 1 A_WeaponReady(14)
8H28 G 1
8H28 G 0 A_JumpIfInventory("PlayerPropertyRage",1,"HellWheelingRage")
goto HellWheeling
HellWheeling:
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_TakeInventory("UnholyBossAmmo200",10)
"----" "#" 0 A_JumpIfInventory("UnholyBossAmmo200",1,"HellWheeling")
"----" "#" 0 A_JumpIfInventory("IsPissedFlag",1,"FireX_WheelGo")
goto Fire_WheelGo
HellWheelingRage:
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_GiveInventory("Skull4MI_WheelD_P2",1)
"----" "#" 1 A_WeaponReady(8)
"----" "#" 0 A_TakeInventory("UnholyBossAmmo200",8)
"----" "#" 0 A_JumpIfInventory("UnholyBossAmmo200",1,"HellWheeling")
"----" "#" 0 A_JumpIfInventory("IsPissedFlag",1,"FireX_WheelGo")
goto Fire_WheelGo
}
}

actor Skull4MIFlag : UOnce {}

actor Skull4MI_WheelD_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"PFire_S")
goto PFire
PFire:
TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"PFire_S")
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
stop
PFireX:
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoomX",0,0,28,momx,momy,momz,0,8,0)
stop
PFire_S:
TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"PFireX_S")
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoom",0,0,28,momx,momy,momz,0,8,0)
stop
PFireX_S:
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoomX",0,0,28,momx,momy,momz,0,8,0)
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoomX",0,0,28,momx,momy,momz,0,8,0)
TNT1 A 0 A_SpawnItemEx("Skull4MI_WheelBoomX",0,0,28,momx,momy,momz,0,8,0)
stop
}
}
actor Skull4MI_WheelD_P2 : Skull4MI_WheelD_P
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("Skull4MI_WheelT_P",1)
goto Skull4MI_WheelD_P::Pickup
}
}

actor Skull4MI_WheelT_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"),"PSpeedG")
goto PSpeedA
PSpeedG:
TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"PSpeedGX")
TNT1 A 0 A_Recoil(-6.25)//-25
goto End
PSpeedGX:
TNT1 A 0 A_Recoil(-12.5)//-50
goto End
PSpeedA:
TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"PSpeedAX")
TNT1 A 0 A_Recoil(-3)
goto End
PSpeedAX:
TNT1 A 0 A_Recoil(-6)
goto End

End:
TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"EndX")
TNT1 A 0 A_GiveInventory("Skull4MI_HellBoost1")
TNT1 A 0 A_GiveInventory("UH_125_SpeedPowerGiver")
stop
EndX:
TNT1 A 0 A_GiveInventory("Skull4MI_HellBoost2")
TNT1 A 0 A_GiveInventory("UH_150_SpeedPowerGiver")
stop
}
}

actor Skull4MI_WheelBoom : BasicExplosion
{
damagetype "Skull4MI"
Obituary "%o lost all hope due to \cjSkull Man\c- (%k)'s \cuHell Wheel."
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(100,120,0,0,16)
stop
}
}

actor Skull4MI_WheelBoomX : BasicExplosion
{
damagetype "Skull4MI2"
Obituary "%o was never seen again."
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(250,120,0,0,16)
stop
}
}

Actor PowerHellWheelProtect : PowerProtection{Damagefactor "Skull4MI", 0.55 Powerup.duration 10}
Actor PowerHellWheelProtect2 : PowerProtection{Damagefactor "Skull4MI2", 0.35 Powerup.duration 10}


// TODO: too boring, rework it

actor SoccerRock_W_NormalBar : NormalBar {Args 168, 88}
actor SoccerRock_W : BaseUnholyBossWep {
  Tag "$TAG_SoccerRock_W"
  Obituary "%o was vaporized by \c[g1]Soccer Rock\c- (%k)!"
  Inventory.Pickupmessage "\cafuck give me the refund"
  Weapon.AmmoType "UnholyBossAmmo50"
  // weapon.ammotype2 "UnholyPower1500"
  States {
   Spawn:
    H0RK [ 1
    wait

   Deselect:
    H0RK Z 0
    goto DeselectSwap
   Select:
    H0RK Z 0
    goto SelectSwap

   Ready:
    H0RK Z 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, SOCCERROCK_DYE)
    goto ReadyX
   ReadyX:
    H0RK B 0 A_JumpIfInventory("UnholyBossAmmo50", 50, "ReadyX2")
    H0RK B 6 A_WeaponReady(8)
    H0RK B 0 A_GiveInventory("UnholyBossAmmo50", 8)
    loop
   ReadyX2:
    H0RK B 6 A_WeaponReady
    H0RK B 0 A_GiveInventory("UnholyBossAmmo50", 8)
    loop

   Fire:
    H0RK K 0 A_GiveInventory("SoccerRockFire_P")
    H0RK K 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    H0RK L 1 A_GiveInventory("UnholyBossAmmo50", 2)
    H0RK M 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    H0RK N 1 A_GiveInventory("UnholyBossAmmo50", 2)
    goto ReadyX
   AltFire:
    H0RK K 0 A_GiveInventory("SoccerRockAlt_P")
    H0RK KLMN 2 A_GiveInventory("UnholyBossAmmo50", 2)
    goto ReadyX

    /*H0RK K 0 A_TakeInventory("UnholyBossAmmo50",50,1)
    H0RK K 0 A_PlaySoundEx("weapon/tengudash","Weapon")
    H0RK K 0 A_ChangeFlag("THRUACTORS",1)
    H0RK K 0 A_Recoil(-20)
    H0RK K 0 A_FireCustomMissile("SoccerRockKick",0,0,0,0)
    H0RK KLMN 2
    H0RK K 0 A_ChangeFlag("THRUACTORS",0)
    goto ReadyX*/
  }
}
actor SoccerRockFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/megaball", "SoundSlot7")
    TNT1 A 0 A_FireCustomMissile("SoccerRockBall", 0, 0, 0, 0)
    stop
  }
}
actor SoccerRockAlt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo50", 50, 1)
    // TNT1 A 0 A_TakeInventory("UnholyBossAmmo50",25)
    TNT1 A 0 A_PlaySoundEx("weapon/megaball", "SoundSlot7")
    TNT1 A 0 A_FireCustomMissile("SoccerRockBallX", 0, 0, 0, 0)
    stop
  }
}
actor SoccerRockBall : BasicProjectile {
  Translation "192:192=4:4", "198:198=170:170"
  Obituary "%o was obliterated by \c[g1]Soccer Rock\c- (%k)'s Mega Soccer Ball strike!"
  DamageType "SoccerRock"
  Damage (random(100, 300))
  Radius 20
  Height 20
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +ALLOWBOUNCEONACTORS
  BounceCount 11
  BounceFactor 0.9
  WallBounceFactor 0.9
  States {
   Spawn:
    8P74 A 1
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("ExplosionEffect1", 0, 0, 20)
    stop
  }
}
actor SoccerRockBallX : SoccerRockBall {
  Translation "198:198=77:77", "192:192=205:205"
  Damage (0)
  Radius 33
  Height 33
  +THRUACTORS
  BounceCount 0
  BounceFactor 0.6
  WallBounceFactor 0.6
  args 120
  States {
   Spawn:
    8P74 B 0
    8P74 B 1 A_JumpIfInventory("CutterFlag", 120, "ThrustIt")
    8P74 B 0 A_GiveInventory("CutterFlag", 1)
    loop
   ThrustIt:
    8P74 B 0 A_Stop
    8P74 B 0 A_PlaySoundEx("misc/soccerballplatform", "Voice")
   ThrustLoop:
    8P74 C 0 ThrustThingZ(0, 30, 0, 1)
    8P74 C 1 A_CheckCeiling("Death")
    8P74 D 0 ThrustThingZ(0, 30, 0, 1)
    8P74 D 1 A_CheckCeiling("Death")
    8P74 E 0 ThrustThingZ(0, 30, 0, 1)
    8P74 E 1 A_CheckCeiling("Death")
    loop
   Crash:
   XDeath:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, 45, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, 90, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, 135, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, 180, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, -135, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, -90, 0)
    TNT1 A 0 A_SpawnItemEx("SoccerRockBall", 0, 0, 0, 64, 0, 0, -45, 0)
    stop
  }
}
actor PainSoccerRockFlingHit : Basic_PainFling_H {Args 128, 120, 2}
actor SoccerRockKick : BasicProjectile {
  Translation "198:198=77:77", "192:192=205:205"
  Obituary "%o met their maker via \c[g1]Soccer Rock\c- (%k)'s cleat-to-cranium tornado kick!"
  DamageType "SoccerRockKick"
  Damage (200)
  Radius 14
  Height 25
  Speed 60
  Scale 2.5
  States {
   Spawn:
    X_5F DEF 2
    stop
  }
}

// === Reload-driven active stealth (2026-09-11, v2) ==========================
// Full invisibility goes through the mod's unified DTADD AlphaPower channel
// (UH_00_AlphaPowerGiver -> APROP_Alpha 0.0); core_clampalpha_client keeps a
// 0.25 floor for teammates/spectators.  RNCStealthBreak_P removes the power
// and the DTADD watcher restores the default alpha.  Do NOT add +CANTSEEK
// (breaks tracking weapons; see Power_ShadMan note).

// Marker: stealth is currently active.  Removed by every break path.
actor RNCStealthActive_F : Once {}

// Cooldown token: plain Inventory so the HUD can read the remaining amount.
// uh_rncstealth_cooldowntick subtracts 1 per tic (same value as the
// A_GiveInventory in RNCStealthBreak_P and the HUD bar capacity).
actor RNCStealthCooldown : Inventory {Inventory.MaxAmount 80}

// Judgement-circle sweep dot (clientside; see uh_rncstealth_ring).
// 2026-09-12: static dot -> one-shot "shrink and vanish" particle (NCXP A, then
// MXP1 C..E -> stop).  The ring script spawns one per tic at each of the two
// intersections of the circle with the rotating line, so the frame animation
// itself draws the comet tail.  It is spawned with NO TID (tid 0) and deletes
// itself through stop, so nothing has to track or clean it up - and it can
// never collide with a map's or another mod's TID scheme.
// Lifetime = 4 frames x 6 tics = 24 tics; keep in sync with
// RNCSTEALTH_RING_SPAWN_TICS (rnc_clashman.acs).  With
// RNCSTEALTH_RING_STEPS 48 (7.5 deg/tic) that makes each tail span
// 24 x 7.5 = 180 deg, i.e. the two tails meet and the whole ring is dotted.
// Do NOT use loop/wait: the dot would never die and the tail would pile up
// into a solid ring.  Scale 2.0 -> 32 map units wide, which covers the 33.5 u
// arc gap left by RING_STEPS 48 (base class scale is 2.5 = 40).
actor RNCStealthRingDot : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  Alpha 0.55
  Scale 2.0
  States {
   Spawn:
    NCXP A 6
    MXP1 C 6
    MXP1 D 6
    MXP1 E 6
    stop
  }
}

// Cloak transform FX: one MXP1 B..E pop (2 tics per frame) that rides the boss,
// so the body appears to become MXP1 and then vanish together with the cloak.
// uh_rncstealth_transform spawns it on the boss and points its target at them.
// A_Warp is an INSTANT reposition to target + offset (thingdef_codeptr.cpp:5640)
// and WARPF_COPYINTERPOLATION slides the rendered position along with the boss.
//
// -CLIENTSIDEONLY is the only deviation from the rest of this mod's FX, and it
// is NOT about visibility: a clientside-only actor exists as one local copy per
// client (NETWORK_IsActorClientHandled, network.cpp:1598) and each copy is
// created from a bare position command - CLIENT_SpawnThing receives no pointers
// (cl_main.cpp:2809, sv_commands.cpp:1464) - so its A_Warp(AAPTR_TARGET) would
// find no target and silently do nothing, leaving the pop behind whenever the
// boss moves.  Keeping this one server-side lets the server run the warp and
// broadcast the movement (thingdef_codeptr.cpp:5684); everyone sees it either
// way.  Everything else (NOINTERACTION / NOGRAVITY / -SOLID / DONTBLAST /
// Translucent / alpha 1.0 / scale 2.5) comes from BasicGraphicEffect.
actor RNCCloakTransformFX : BasicGraphicEffect {
  -CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    NCXP A 2
    MXP1 CDE 2 A_Warp(AAPTR_TARGET, 0, 0, 32, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    stop
  }
}

// Reload entry point.  Silently refuses while already active or cooling down.
actor RNCStealthBegin_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RNCStealthActive_F", 1, "NoOp")
    TNT1 A 0 A_JumpIfInventory("RNCStealthCooldown", 1, "NoOp")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_rncstealth_transform", 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 30)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_dontidentifytargetplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invisibleplayer", 0, true)
    TNT1 A 0 A_GiveInventory("RNCStealthActive_F")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_rncstealth_monitor", 0)
   NoOp:
    TNT1 A 0
    stop
  }
}

// Idempotent break: only acts while RNCStealthActive_F is present, so the
// monitor, Fire/AltFire and ClassDeath can all call it concurrently.
actor RNCStealthBreak_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RNCStealthActive_F", 1, "BreakStealth")
    stop
   BreakStealth:
    TNT1 A 0 A_TakeInventory("RNCStealthActive_F")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 30)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_dontidentifytargetplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invisibleplayer", 0, false)
    TNT1 A 0 A_GiveInventory("RNCStealthCooldown", 80)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_rncstealth_cooldowntick", 0)
    stop
  }
}

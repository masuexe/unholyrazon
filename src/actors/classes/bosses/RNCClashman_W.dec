actor ClashSpreadingBoss1 : BasicExplosion {
  var int user_radius;
  var int user_angle;
  +FORCEXYBILLBOARD
  Damagetype "ClashmanRNC"
  Obituary "%o no longer had a face due to \cuRNC \ctClashMan\c- (%k)."
  States {
   Spawn:
    NCXP A 0
    NCXP A 0 A_Explode(180, 96, 0)
    NCXP A 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    NCXP A 0 A_SpawnItemEx("ClashSpreadingBoss2", user_radius*cos(user_angle), user_radius*sin(user_angle))
    NCXP A 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    NCXP A 0 A_SpawnItemEx("ClashSpreadingBoss2", user_radius*cos(user_angle), user_radius*sin(user_angle))
    NCXP A 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    NCXP A 0 A_SpawnItemEx("ClashSpreadingBoss2", user_radius*cos(user_angle), user_radius*sin(user_angle))
    NCXP A 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    NCXP A 2 A_SpawnItemEx("ClashSpreadingBoss2", user_radius*cos(user_angle), user_radius*sin(user_angle))

    MXP1 C 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 C 0 A_SpawnItemEx("ClashSpreadingBoss3", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 C 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 C 0 A_SpawnItemEx("ClashSpreadingBoss3", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 C 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 C 0 A_SpawnItemEx("ClashSpreadingBoss3", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 C 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 C 2 A_SpawnItemEx("ClashSpreadingBoss3", user_radius*cos(user_angle), user_radius*sin(user_angle))

    MXP1 D 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 D 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 D 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 D 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 D 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 D 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 D 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 D 2 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))

    MXP1 E 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 E 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 E 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 E 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 E 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 E 0 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    MXP1 E 0 A_GiveInventory("ClashSpreadingBossRandomVar_P")
    MXP1 E 2 A_SpawnItemEx("ClashSpreadingBoss4", user_radius*cos(user_angle), user_radius*sin(user_angle))
    stop
  }
}

actor ClashSpreadingBossRandomVar_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SetUserVar("user_radius", 368 * sqrt(frandom(0.0, 1.0)))
    TNT1 A 0 A_SetUserVar("user_angle", random(0, 359))
    stop
  }
}


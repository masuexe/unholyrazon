actor RNCClashman_W_ScriptBar : ScriptBar {}

actor RNCClashman_W : BaseUnholyBossWep
{
Tag "$TAG_Boss017_W"
Obituary "%o no longer had a face due to \cuRNC \ctClashMan\c- (%k)."
Inventory.Pickupmessage "\cmPewPewPew."
weapon.ammotype "UnholyBossAmmo150"
weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8H17 [ 1
wait

Deselect:
8H17 F 0
goto DeselectSwap
Select:
8H17 F 0
goto SelectSwap

Ready:
8H17 A 0 A_GiveInventory("UnholyPowerLimit_F",3000)
8H17 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, RNCCLASHMAN_DYE)
8H17 A 6 
8H17 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H17 A 0 A_JumpIfInventory("UnholyBossAmmo150",150,"ReadyX2")
8H17 A 2 A_WeaponReady(WRF_NOSECONDARY)
8H17 A 0 A_GiveInventory("UnholyBossAmmo150",2)
//8H17 A 0 A_GiveInventory("UnholyBossAmmo200",1)
loop
ReadyX2:
8H17 A 2 A_WeaponReady
8H17 A 0 A_GiveInventory("UnholyBossAmmo150",2)
//8H17 A 0 A_GiveInventory("UnholyBossAmmo200",1)
loop

Fire:
8H17 A 0 A_JumpIfInventory("UnholyPower3000",3000,"RapistShot")
8H17 A 0 A_PlaySoundEx("Pokemon/ShadowBall","Weapon")
8H17 A 0 A_GiveInventory("ClashingBombBoss_P") //A_FireCustomMissile("ClashingBombBoss_P",0,0,8,0)
8H17 H 2 Offset(-24, 44)
8H17 H 2 Offset(-48, 64)
8H17 H 2 Offset(-44, 64)
8H17 G 2 Offset(-36, 56)
8H17 G 2 Offset(-16, 40)
8H17 G 2 Offset(-8, 32)
8H17 F 0 A_WeaponReady(14)
8H17 FEDCB 5
8H17 A 3
Goto ReadyX
RapistShot:
8H17 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H17 A 0 A_TakeInventory("UnholyPower3000",3000)
8H17 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H17 BCDEFG 4
8H17 H 22
8H17 A 0 A_TakeInventory("UnholyPowerDazzle_F")
8H17 A 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H17 A 0 A_FireCustomMissile("FailingBangBoss3_H",0,0,0,0)
8H17 H 2 Offset(-24, 44)
8H17 H 2 Offset(-48, 64)
8H17 H 2 Offset(-44, 64)
8H17 G 2 Offset(-36, 56)
8H17 G 2 Offset(-16, 40)
8H17 G 2 Offset(-8, 32)
8H17 F 0 A_WeaponReady(14)
8H17 FEDCB 5
8H17 A 3
Goto ReadyX
AltFire:
8H17 A 0 A_JumpIfInventory("UnholyBossAmmo150",150,"PowerFapping")
Goto ReadyX
PowerFapping:
8H17 C 0 A_TakeInventory("UnholyBossAmmo150",200)
8H17 C 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8H17 C 0 A_FireCustomMissile("FailingBangBoss1_H",0,0,0,0)
8H17 HGFFEDCBA 2
Goto ReadyX
Flash:
TNT1 A 2
TNT1 A 0 A_GiveInventory("UnholyBossAmmo200",2) //1
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Flash.Go")
loop
Flash.Go:
TNT1 A 0 A_GiveInventory("ClashingBombBoss_S_P")
TNT1 A 1
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,1)
goto Flash
TNT1 A 0
goto Flash.Go+1
}
}

actor FailingBangBoss1_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 4 A_SpawnItemEx("FailingBangBoss1",24,0,32,0,0,15,0)
stop
}
}

actor FailingBangBoss1 : BasicProjectile
{
var int user_timer;
Translation "192:192=204:204", "198:198=61:61"
Damagetype "ClashmanRNC"
Obituary "%o no longer had a face due to \cuRNC \ctClashMan\c- (%k)."
+RIPPER
-NOGRAVITY
Damage (105)
Radius 6
Height 7
Speed 80
scale 2.5
States
{
Spawn:
8P17 A 5
loop
Death:
TNT1 A 0 A_JumpIf(z-floorz<6,"Floor")
TNT1 A 0 A_JumpIf(z-ceilingz==0-7,"Ceiling")
goto Wall
Ceiling:
TNT1 A 0 A_PlaySound("weapon/crashland")
TNT1 A 1 A_SpawnItemEx("FallingClashingBombBoss1")
stop
Wall:
TNT1 A 0
TNT1 A 0 A_PlaySound("weapon/crashexplode")
TNT1 A 0 A_SetGravity(0.0)
X_2E K 3 A_Explode(150,270,0,0,32)
X_2E LM 3
X_2E N 3 A_Explode(150,270,0,0,32)
X_2E OP 3
X_2E Q 3 A_Explode(150,270,0,0,32)
X_2E RS 3
X_2E T 3 A_Explode(150,270,0,0,32)
X_2E UVW 3
stop
XDeath:
Floor:
TNT1 A 0 A_SetUserVar("user_timer", 5)
TNT1 A 0 A_Explode(350,270,0)
TNT1 A 0 A_Jump(256, "FloorLoop")
FloorLoop:
// TNT1 A 0 A_PlaySound("misc_L/metdie")
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 0, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 45, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 90, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 135, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 180, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 225, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 270, 1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2", 150*(6-user_timer),0,32, 0,0,32, 315, 1)
TNT1 A 0 A_JumpIf(user_timer <= 0, "End")
TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
TNT1 A 5
loop
End:
TNT1 A 0
stop
}
}
actor FailingBangBoss1_Bot : FailingBangBoss1 {
States {
FloorLoop:
// TNT1 A 0 A_PlaySound("misc_L/metdie")
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, 60,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, -60,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, 120,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, -120,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, 180,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, -180,1)
TNT1 A 0 A_SpawnItemEx("FailingBangBoss2Mute", 30*(6-user_timer),0,32, 0,0,0, 0,1)
TNT1 A 0 A_JumpIf(user_timer <= 0, "End")
TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
TNT1 A 5
loop
}
}

actor FallingClashingBombBoss1 : FailingBangBoss1
{
damage (175)
States
{
Spawn:
8P17 A 1
loop
Death:
TNT1 A 0
goto Floor
}
}


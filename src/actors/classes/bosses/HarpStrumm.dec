actor HarpStrumm : BossBase {
  Player.ScoreIcon "UB052MUG"
  Player.SoundClass "HarpStrumm"
  Player.ForwardMove 1.24, 1.24
  Player.SideMove 1.12, 1.12
  Player.JumpZ 12
  Player.MaxHealth 3950
  Health 3950
  Player.MorphWeapon "HarpStrumm_W"
  States {
   Spawn:
    8A52 A 0
    8A52 B 1
    8A52 A 1
    wait
   See:
    8A52 BCDE 5
    goto Spawn
   Missile:
    8A52 F 0 A_JumpIfInventory("VivifyDelay5", 1, "MissileL")
    8A52 F 5
    8A52 G 4
    goto Spawn+2
   MissileL:
    8A52 FFFFAAA 1 A_JumpIfInventory("VivifyDelay4", 1, "Spawn")
    loop

   ClassPain:
    8A52 H 0
    goto MegamanPain
   ClassDeath:
    8A52 H 0
    goto MegamanDeath
   MegamanDeath0:
    8A52 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8A52 H 3
    8A52 HHHHHHHHH 8 A_SpawnItemEx("HarpStrummBossCD_FX", random(14, 48), random(-10, 10), random(24, 48), 0, 0, 0, random(0, 35) * 10, 1)
    8A52 H 4 A_ChangeFlag("NOGRAVITY", 1)
    8A52 H 0 A_ChangeVelocity(0, 0, 5, 2)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    8A52 H 1 A_SetScale(scaleX - 0.1, scaleY + 0.25)
    8A52 H 0 A_FadeOut(0.125)
    goto MegamanErase
  }
}

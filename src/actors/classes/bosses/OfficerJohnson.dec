actor OfficerJohnson : BossBase {
  Player.ScoreIcon "UB006MUG"
  Player.SoundClass "officerjohnson"
  Player.ForwardMove 0.75, 0.75
  Player.SideMove 0.75, 0.75
  Player.JumpZ 10
  Player.MaxHealth 4375
  Health 4375
  Player.MorphWeapon "OfficerJohnson_W"
  States {
   Spawn:
    8A06 A 0
    8A06 B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
   SpawnFrame:
    8A06 AAAAAYYYYY 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    loop
   See:
    8A06 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn
   Jumping:
    8A06 N 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
    BREK F 0 A_JumpIfInventory("VivifyDelay10", 1, "MissileAlt")
   MissileF1: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir1")
   MissileF2: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir2")
   MissileF3: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir3")
   MissileF4: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir4")
   MissileF5: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir5")
   MissileF6: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir6")
   MissileF7: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir7")
   MissileF8: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir8")
   MissileF9: BREK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "OJAir9")
    goto SpawnFrame
   OJAir1: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF2")
   OJAir2: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF3")
   OJAir3: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF4")
   OJAir4: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF5")
   OJAir5: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF6")
   OJAir6: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF7")
   OJAir7: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF8")
   OJAir8: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileF9")
   OJAir9: 8A06 O 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Jumping
   MissileAlt:
    8A06 P 18
    goto Spawn

   ClassPain:
    8A06 H 0
    goto MegamanPain
   ClassDeath:
    8A06 H 0
    goto MegamanDeath
  }
}

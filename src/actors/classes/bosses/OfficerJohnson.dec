actor OfficerJohnson : BossBase
{
Player.ScoreIcon "UB006MUG"
player.soundclass "officerjohnson"
player.forwardmove 0.75, 0.75
player.sidemove 0.75, 0.75
player.jumpz 10
Player.MaxHealth 4375
Health 4375
player.morphweapon "OfficerJohnson_W"
States
{
Spawn:
8A06 A 0
8A06 B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
SpawnFrame:
8A06 AAAAAYYYYY 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
loop
See:
8A06 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
Goto Spawn
Jumping:
8A06 N 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
loop
Missile:
BREK F 5
BREK G 4
goto SpawnFrame
ClassPain:
8A06 H 0
Goto MegamanPain
ClassDeath:
8A06 H 0
Goto MegamanDeath
}
}


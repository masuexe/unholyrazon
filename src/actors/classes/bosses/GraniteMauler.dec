actor GraniteMauler : BossBase {
  Player.ScoreIcon "UB114MUG"
  Player.SoundClass "GraniteMauler"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.18, 1.18
  Player.JumpZ 10
  Player.MaxHealth 4099
  Health 4099
  Player.MorphWeapon "GraniteMauler_W"
  States {
   Spawn:
    8B14 A 0
    8B14 A 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileLeap")
    8B14 B 1 A_JumpIfInventory("VivifyFlag1", 1, "MissileLeap")
    8B14 A 210
    8B14 AQ 5
    goto Spawn+4
   See:
    8B14 B 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileLeap")
    8B14 BCDE 5
    goto Spawn
   Melee:
    8B14 R 0 A_JumpIfInventory("VivifyDelay5", 1, "MissileSuplex")
    goto Spawn
   Missile:
    8B14 F 0 A_JumpIfInventory("GenericBossFlag1", 1, "MissileD_Grab")
    8B14 F 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileLeap")
    8B14 F 0 A_JumpIfInventory("GenericBossFlag100", 1, "MissileCharge")
    8B14 F 5
    8B14 G 4
    goto Spawn
   MissileCharge:
    8B14 I 3
    goto Missile
   MissileLeap:
    8B14 J 1 A_JumpIfInventory("VivifyDelay3", 1, "MissileLand")
    loop
   MissileLand:
    8B14 KLMMLK 2
    goto Spawn
   MissileSuplex:
    8B14 J 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileSuplexEnd")
    loop
   MissileSuplexEnd:
    8B14 AQAQ 4
    goto Spawn

   MissileD_Grab:
    8B14 G 0 A_JumpIfInventory("GenericBossFlag1", 8, "ARunF")
    8B14 G 0 A_JumpIfInventory("GenericBossFlag1", 7, "ARunE")
    8B14 G 0 A_JumpIfInventory("GenericBossFlag1", 5, "ARunD")
    8B14 G 0 A_JumpIfInventory("GenericBossFlag1", 3, "ARunC")
    8B14 G 0 A_JumpIfInventory("GenericBossFlag1", 1, "ARunB")
    8B14 GF 3
    goto Spawn

   ARunB:
    8B14 B 2
    goto MissileD_Grab+5
   ARunC:
    8B14 C 2
    goto MissileD_Grab+5
   ARunD:
    8B14 D 2
    goto MissileD_Grab+5
   ARunE:
    8B14 E 2
    goto MissileD_Grab+5
   ARunF:
    8B14 E 2 A_TakeInventory("GenericBossFlag1")
    goto MissileD_Grab+5

   ClassPain:
    8B14 H 0
    goto MegamanPain
   ClassDeath:
    8B14 H 0
    goto MegamanDeath
  }
}

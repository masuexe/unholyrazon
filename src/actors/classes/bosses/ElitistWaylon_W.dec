    STOP
    //X_8A HGF 1 A_Fadeout
    //loop
  }
}

actor WaylonGaleSlasher1 : WaylonGaleSlasher0 {
  States {
   Spawn2:
    X_8A H 0 A_CountDown
    X_8A H 1 A_ChangeVelocity(2, 0, 1, 1)
    X_8A G 1
    X_8A F 1
    //X_8A H 0 ThrustThingZ(0,4,0,1)
    Loop
  }
}
actor WaylonGaleSlasher3 : WaylonGaleSlasher0 {
  ReactionTime 3//10
  Scale 2.5
  States {
   Spawn:
    8P08 ABCDEFGH 1
    8P08 A 0 A_CountDown
    Loop
  }
}

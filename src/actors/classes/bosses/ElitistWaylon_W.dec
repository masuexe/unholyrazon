actor ElitistWaylon_W_NormalBar : NormalBar {args 4, 94}
actor ElitistWaylon_W_SecondBar : SecondBar {args 63, 79}

actor ElitistWaylon_W : BaseUnholyBossWep {
  Tag "$TAG_ElitistWaylon_W"
  Obituary "%o was blown away by \cmHurricane \ctWaylon\c- (%k)!"
  Inventory.Pickupmessage "\ctGluttony."
  Weapon.AmmoType "UnholyBossAmmo150"
  Weapon.AmmoType2 "UnholyPower1500"
  States {
   Spawn:
    8H07 [ 1
    wait

   Deselect:
    8H07 C 0
    goto DeselectSwap
   Select:
    8H07 C 0
    goto SelectSwap

   Ready:
    8H07 C 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    8H07 C 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE)
    8H07 C 4 A_GiveInventory("UnholyBossAmmo150", 150)
    goto ReadyX
   ReadyX:
    8H07 C 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "ReadyX2")
    8H07 C 2 A_WeaponReady(8)
    8H07 C 0 A_GiveInventory("UnholyBossAmmo150", 2)
    loop
   ReadyX2:
    8H07 C 2 A_WeaponReady
    8H07 C 0 A_GiveInventory("UnholyBossAmmo150", 2)
    loop

   Fire:
    8H07 C 0 A_JumpIfInventory("UnholyPower1500", 1500, "HurricaneWaylon")
    8H07 C 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H07 C 0 A_FireCustomMissile("WaylonGaleSpawner", 0, 0, 8, 0)
    8H07 C 0 A_JumpIfInventory("PlayerPropertyRage", 1, "FireR")
    8H07 C 1 Offset(10, 41)
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(30, 48)
    8H07 D 1 Offset(40, 50)
    8H07 D 1 Offset(45, 52)
    8H07 DDDDDDD 2 Offset(50, 54) A_GiveInventory("UnholyBossAmmo150", 1)
    8H07 D 1 Offset(45, 52)
    8H07 D 1 Offset(40, 50)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(10, 41)
    8H07 C 1 Offset(7, 38)
    8H07 C 1 Offset(4, 36)
    8H07 C 1 Offset(2, 34)
    goto ReadyX
   FireR:
    8H07 C 1 Offset(15, 41)
    8H07 C 1 Offset(30, 45)
    8H07 D 1 Offset(45, 50)
    8H07 DDDDDDD 2 Offset(50, 54)
    8H07 D 1 Offset(45, 50)
    8H07 C 1 Offset(30, 45)
    8H07 C 1 Offset(15, 41)
    8H07 C 1 Offset(5, 36)
    goto ReadyX

   AltFire:
    8H07 C 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "JumpDamnYouJump")
    goto ReadyX
   JumpDamnYouJump:
    8H07 C 0 A_TakeInventory("UnholyBossAmmo150", 150)
    8H07 C 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8H07 C 0 A_Stop
    8H07 C 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, 60)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, -60)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, 120)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, -120)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, 180)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner2", 0, 0, 0, 5, 0, 0, -180)
    8H07 C 0 A_SpawnItemEx("WaylonGaleSpawner3", 0, 0, 0, 5, 0, 0, 0)
    8H07 C 0 ThrustThingZ(0, 64, 0, 0)

    8H07 C 0 A_JumpIfInventory("PlayerPropertyRage", 1, "JumpDamnYouJumpR")
    8H07 C 1 Offset(10, 41)
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(40, 52)
    8H07 D 1 Offset(50, 56)
    8H07 D 1 Offset(60, 49)
    8H07 D 1 Offset(70, 42)
    8H07 D 1 Offset(80, 35)
    8H07 E 1 Offset(-10, 39)
    8H07 E 1 Offset(-6, 33)
    8H07 E 1 Offset(-2, 27)
    8H07 E 0 A_Recoil(-45)
    8H07 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H07 E 1 Offset(-2, 27)
    8H07 E 1 Offset(-6, 33)
    8H07 E 1 Offset(-10, 39)
    8H07 D 1 Offset(80, 35)
    8H07 D 1 Offset(70, 42)
    8H07 D 1 Offset(60, 49)
    8H07 D 1 Offset(50, 56)
    8H07 C 1 Offset(40, 52)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(10, 41)
    goto ReadyX
   JumpDamnYouJumpR:
    8H07 C 1 Offset(15, 41)
    8H07 C 1 Offset(30, 48)
    8H07 D 1 Offset(55, 56)
    8H07 D 1 Offset(70, 42)
    8H07 E 1 Offset(-10, 39)
    8H07 E 1 Offset(-2, 27)
    8H07 E 0 A_Recoil(-45)
    8H07 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H07 E 1 Offset(-2, 27)
    8H07 E 1 Offset(-10, 39)
    8H07 D 1 Offset(70, 42)
    8H07 D 1 Offset(55, 56)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(15, 41)
    goto ReadyX

   HurricaneWaylon:
    8H07 C 0 A_GiveInventory("UnholyPowerDazzle_F")
    8H07 C 0 A_TakeInventory("UnholyPower1500", 1500)
    8H07 C 0 A_PlaySoundEx("weapon/pcharge", "Weapon")

    8H07 C 1 Offset(10, 41) A_GunFlash("Flash.RageCharge")
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(40, 52)
    8H07 D 1 Offset(50, 56)
    8H07 D 1 Offset(60, 49)
    8H07 D 1 Offset(70, 42)
    8H07 D 1 Offset(80, 35)
    8H07 E 1 Offset(-10, 39)
    8H07 E 1 Offset(-6, 33)
    8H07 E 40 Offset(-2, 27)
    8H07 EKL 2

    8H07 E 2 A_GunFlash("NoFlash")
    8H07 E 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE, true)
    // TNT1 AAAAAAAAAAAA 12 A_SpawnItemEx("ElitistWaylon_RageNoise_H")
    8H07 E 0 A_SpawnItemEx("ElitistWaylon_RageNoise_H")
    8H07 E 0 A_GiveInventory("Shocked", 1)
    8H07 E 0 SetPlayerProperty(0, 1, 3)
    8H07 EKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKLEKL 2 A_SpawnItemEx("WaylonDoesEvilRobotGigaTornado")
    // A_SpawnItemEx("WaylonDoesEvilRobotGigaTornado",0,0,0,velx,vely,velz,0,8,0)
    8H07 E 0 SetPlayerProperty(0, 0, 3)

    8H07 E 42 Offset(-2, 27) A_TakeInventory("UnholyPowerDazzle_F")

    8H07 E 1 Offset(-2, 27)
    8H07 E 1 Offset(-6, 33) ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE, true)
    8H07 E 1 Offset(-10, 39) ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE, true)
    8H07 D 1 Offset(80, 35) ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE, true)
    8H07 D 1 Offset(70, 42)
    8H07 D 1 Offset(60, 49)
    8H07 D 1 Offset(50, 56)
    8H07 C 1 Offset(40, 52)
    8H07 C 1 Offset(30, 48)
    8H07 C 1 Offset(20, 44)
    8H07 C 1 Offset(10, 41)
    goto ReadyX

   Flash.RageCharge:
    TNT1 A 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE2, true)
    TNT1 A 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE3, true)
    TNT1 A 1 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, ELITISTWAYLON_DYE, true)
    loop
  }
}

actor ElitistWaylon_RageNoise_H : BasicWatcher {
  ReactionTime 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("E_Way_GigaFXSpawn_P")  // Sync Online
   Spawn2:
    TNT1 A 0 A_PlaySoundEx("weapon/superboost", "Weapon", 0, 1)
    TNT1 A 0 A_CountDown
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "SpawnR")
    TNT1 AAAAAA 2 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    loop
   SpawnR:
    TNT1 AAA 2 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    goto Spawn2
   Death:
    TNT1 A 10
    stop
  }
}

actor WaylonDoesEvilRobotGigaTornado : BasicExplosion {
  Translation "192:192=79:79", "198:198=5:5"  // "1:255=85:85"
  DamageType "Waylon"
  Obituary "%o was blown away by \cmHurricane \ctWaylon\c- (%k)!"
  // +FLOORHUGGER
  +OLDRADIUSDMG
  // -NOINTERACTION
  // +THRUACTORS
  RenderStyle "None"  // Translucent
  Alpha 0.7
  Scale 4.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0  // A_SpawnItemEx("E_Way_GigaFX",0,0,floorz-z,0,0,0,0,1)
    TNT1 AAAAAAAAA 1 A_Explode(85, 200, 0)
    stop
  }
}

actor E_Way_GigaFXSpawn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("E_Way_GigaFX0", 0, 0, 28)
    stop
  }
}

actor E_Way_GigaFX0 : BasicClientSide {
  RenderStyle "None"
  ReactionTime 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX1", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX2", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX3", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX4", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX5", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX6", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX7", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX8", 0, 0, floorz - z)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 24)
    TNT1 A 1 A_SpawnItemEx("E_Way_GigaFX9", 0, 0, floorz - z)
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor E_Way_GigaFX1 : BasicClientSide {
  Translation "192:192=79:79", "198:198=5:5"
  RenderStyle "Translucent"
  Alpha 0.7
  ReactionTime 10
  Scale 4.5
  States {
   Spawn:
   Spwn:
    EVFL N 0
    EVFL NNNOOOPPP 1 A_CountDown
    loop
  }
}
actor E_Way_GigaFX2 : E_Way_GigaFX1 {
  States {
   Spawn:
    goto Spwn+2
  }
}
actor E_Way_GigaFX3 : E_Way_GigaFX1 {States {Spawn: goto Spwn+3}}
actor E_Way_GigaFX4 : E_Way_GigaFX1 {States {Spawn: goto Spwn+4}}
actor E_Way_GigaFX5 : E_Way_GigaFX1 {States {Spawn: goto Spwn+5}}
actor E_Way_GigaFX6 : E_Way_GigaFX1 {States {Spawn: goto Spwn+6}}
actor E_Way_GigaFX7 : E_Way_GigaFX1 {States {Spawn: goto Spwn+7}}
actor E_Way_GigaFX8 : E_Way_GigaFX1 {States {Spawn: goto Spwn+8}}
actor E_Way_GigaFX9 : E_Way_GigaFX1 {States {Spawn: goto Spwn+9}}

actor BreezingHellSpread2 : BasicProjectile {
  Translation "192:192=79:79", "198:198=5:5"  // "1:255=85:85"
  DamageType "Waylon"
  Obituary "%o was blown away by \cmHurricane \ctWaylon\c- (%k)!"
  +RIPPER
  +DOOMBOUNCE
  +BLOODLESSIMPACT
  RenderStyle "Add"
  Alpha 0.8
  ReactionTime 20
  Damage (21)
  Radius 6
  Height 6
  Speed 5
  Scale 2.5
  States {
   Spawn:
    X_8A H 0 ThrustThingZ(0, 2, 0, 1)
    X_8A H 0 A_CountDown
    X_8A H 2 A_SetTranslucent(0.7, 0)
    X_8A H 0 ThrustThingZ(0, 2, 0, 1)
    X_8A G 0 A_CountDown
    X_8A G 2 A_SetTranslucent(0.5, 0)
    X_8A H 0 ThrustThingZ(0, 2, 0, 1)
    X_8A F 0 A_CountDown
    X_8A F 2 A_SetTranslucent(0.6, 0)
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor WaylonGaleSpawner : BasicProjectile {
  Translation "192:192=79:79", "198:198=5:5"  // "1:255=85:85"
  DamageType "Waylon"
  Obituary "%o was too gluttonous to be blown away by \cmHurricane \ctWaylon\c- (%k)!"
  +RIPPER
  // +FLOORHUGGER
  // +SERVERSIDEONLY
  RenderStyle "Add"
  ReactionTime 18
  Damage (20)
  Radius 4
  Height 4
  Speed 40
  Scale 4
  States {
   Spawn:
    X_8A H 0 A_CountDown
    X_8A G 1 A_SpawnItemEx("WaylonGaleSlasher1", 32, 0, 0, velx, vely, velz, 0, 8)
    X_8A F 1 A_SpawnItemEx("WaylonGaleSlasher1", 32, 0, 0, velx, vely, velz, 0, 8)
    loop
   Death:
    TNT1 A 0 A_JumpIf(z - floorz == 0, "Floor")
    stop
   Floor:
    TNT1 A 0 A_CustomMissile("WaylonGaleSpawner2", 1, 0, 0, 2, 0)
    stop
   XDeath:
    TNT1 A 0
    stop
  }
}

actor WaylonGaleSpawner2 : WaylonGaleSpawner {
  +FLOORHUGGER
  States {
   Death:
    TNT1 A 1
    goto XDeath
  }
}


actor WaylonGaleSpawner3 : WaylonGaleSpawner2 {
  States {
   Spawn:
    X_8A H 0 A_CountDown
    X_8A G 1 A_SpawnItemEx("WaylonGaleSlasher3", 32, 0, 0, 20, 0, 10, 0, 1)
    X_8A F 1 A_SpawnItemEx("WaylonGaleSlasher3", 32, 0, 0, 20, 0, 10, 0, 1)
    loop
  }
}


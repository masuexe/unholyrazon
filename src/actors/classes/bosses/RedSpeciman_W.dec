actor RedSpeciman_W_ScriptBar : ScriptBar {}
actor RedSpeciman_W : Speciman_W
{
Tag "$TAG_Boss043_W"
Obituary "\cgRed Speciman\c- (%k) assumed that %o was already on fire."
Inventory.Pickupmessage "Hark Hark"
weapon.ammotype2 "UnholyBossAmmo200"
weapon.ammotype "UnholyBossAmmo250"
States
{
Spawn:
8H43 [ 1
wait

Deselect:
8H43 A 0
goto DeselectSwap
Select:
8H43 A 0
goto SelectSwap

Ready:
8H43 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, REDSPECIMAN_DYE)
8H43 A 0 A_GiveInventory("IsSpecimanFlag")
goto ReadyX
ReadyX:
8H43 A 0 A_JumpIfInventory("UnholyBossAmmo250",125,"ReadyX2")
8H43 A 2 A_GiveInventory("Speciman_Ready8_P")
loop
ReadyX2:
8H43 A 2 A_GiveInventory("Speciman_Ready0_P")
loop

Fire:
8H43 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 171)
8H43 A 0 A_PlaySoundEx("weapon/firestorm","Weapon")
8H43 A 0 A_FireCustomMissile("ASPFireMiniShot",0,0,0,8)
//BUSH YXWVU 1
//BUS2 B 3 A_TakeInventory("ASPFireCharge")
8H43 D 2 Offset(-6,25)A_TakeInventory("ASPFire_Flag")
8H43 D 2 Offset(-12,18)
8H43 D 2 Offset(-8,23)
8H43 B 2 Offset(-4,28)A_TakeInventory("ASPFireCharge", 1)
8H43 A 0 A_Refire("FireH0")
Goto ReadyX
FireH0:
8H43 C 0 A_GiveInventory("ASPFire_Flag")
8H43 C 0 A_GunFlash
8H43 C 0 A_WeaponReady(14)
goto FireH1
FireH1:
8H43 C 0 A_JumpIfInventory("ASPFireCharge",50,"FireH2")
8H43 F 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE1)//60
8H43 C 0 A_Refire(1)
Goto Fire
8H43 C 0 A_JumpIfInventory("ASPFireCharge",50,"FireH2")
8H43 C 1 ACS_NamedExecuteWithResult("core_chargecolor", REDSPECIMAN_DYE)//3
8H43 C 0 A_Refire("FireH1")
Goto Fire
FireH2:
8H43 G 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE2)//62
8H43 C 0 A_Refire(1)
Goto ASPFireGoHado
8H43 C 1 ACS_NamedExecuteWithResult("core_chargecolor", REDSPECIMAN_DYE)//3
8H43 C 0 A_Refire("FireH2")
Goto ASPFireGoHado

Flash:
TNT1 A 0 A_GiveInventory("UnholyBossAmmo250",1)
TNT1 A 2 A_GiveInventory("ASPFireCharge",1)
TNT1 A 0 A_JumpIfInventory("ASPFire_Flag",1,1)
stop
TNT1 A 0 A_JumpIfInventory("ASPFireCharge",50,2)
TNT1 A 0 A_PlaySoundEx("weapon/heat2","Weapon")
loop
TNT1 A 0 A_GiveInventory("UnholyBossAmmo200",1)
TNT1 A 0 A_PlaySoundEx("weapon/heat3","Weapon")
loop

ASPFireGoHado:
8H43 D 0 ACS_NamedExecuteWithResult("core_chargecolor", REDSPECIMAN_DYE)
8H43 D 0 A_TakeInventory("ASPFireCharge", 1)
8H43 D 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H43 D 0 A_FireCustomMissile("ASPFireShot",0,0,0,8)
//BUSH YXWVU 2
//TNT1 A 10
//BUSH UVWXY 2
//BUS2 B 5
8H43 D 2 Offset(-6,25)A_TakeInventory("ASPFire_Flag")
8H43 DDDDD 2 Offset(-12,18)
8H43 D 2 Offset(-8,23)
8H43 B 2 Offset(-4,28)
8H43 B 2 Offset(-2,30)
8H43 A 0 A_Refire("FireH0")
Goto ReadyX
Altfire:
8H43 A 0 A_JumpIfInventory("UnholyBossAmmo250",125,"Point") //Originally 250
Goto ReadyX
Point:
8H43 D 0 A_TakeInventory("UnholyBossAmmo250",125) //Two makes him stronger.
8H43 D 0 A_PlaySoundEx("weapon/mirrordeflect","Weapon")
8H43 D 0 A_FireCustomMissile("ASPFlamePinPointer",0,0,0,8)
//BUSH YXWVU 1
//TNT1 A 10
//BUSH UVWXY 1
//BUS2 B 25
8H43 D 2 Offset(-6,25)
8H43 DDDDD 2 Offset(-12,18)
8H43 D 2 Offset(-8,23)
8H43 B 2 Offset(-4,28)
8H43 B 2 Offset(-2,30)
8H42 B 0 A_WeaponReady(14)
8H43 B 16
Goto ReadyX

ASPFlash:
8H43 B 1 A_GiveInventory("RedSpecimanASPFlash_P")
goto ReadyX
}
}

actor ASPFireCharge : Inventory
{
inventory.amount 1
inventory.maxamount 50
}

actor ASPFire_Flag : Once {}

actor ASPFireShot : BasicProjectile
{
Translation "4:4=218:218", "192:192=40:40", "198:198=44:44"
damagetype "ASPFireMagic"
Obituary "%o was badly burnt by \cgRed Speciman\c- (%k)'s \crASP Charged Fire\c-."
+SKYEXPLODE
+EXPLODEONWATER
Damage (150)
Radius 20
Height 20
speed 45
scale 4.5
States
{
Spawn:
6P50 U 2
TNT1 AAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",random(-3,3),random(-3,3),random(-3,3),random(5,15),random(5,15),random(-15,15),random(0,359))
6P50 V 2
TNT1 AAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail1",random(-3,3),random(-3,3),random(-3,3),random(5,15),random(5,15),random(-15,15),random(0,359))
6P50 W 2
TNT1 AAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",random(-3,3),random(-3,3),random(-3,3),random(5,15),random(5,15),random(-15,15),random(0,359))
loop
Death:
TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TNT1 AAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",0,0,8,random(-20,20),random(-20,20),random(-20,20),0,0,0)
TNT1 A 1 A_SpawnItemEx("ASPFireExplode")
stop
}
}

actor ASPFireExplode : BasicExplosion
{
Translation "198:198=40:40", "192:192=218:218"
damagetype "ASPFireMagic"
Obituary "%o was badly burnt by \cgRed Speciman\c- (%k)'s \crASP Charged Fire\c-."
+THRUGHOST
Scale 4.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
TNT1 A 0
TNT1 A 0 A_Explode(200,186,0)
TNT1 AAAAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",0,0,8,random(-20,20),random(-20,20),random(-20,20),0,0,0)
X_8B AABBCCDDEEFF 1 A_SpawnItemEx("ASPFireBlastBoomFX",random(-192,192),random(-192,192),random(-96,96),0,0,0,0,1)
stop
}
}

actor ASPFireBlastBoomFX : BasicExplosion
{
Translation "198:198=40:40", "192:192=218:218"
damagetype "ASPFireMagic"
Obituary "%o was badly burnt by \cgRed Speciman's \crASP Charged Fire\c-."
Scale 2.5
States
{
Spawn:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
TNT1 A 0 A_Explode(125, 128, 0)
TNT1 AAA 0 A_SpawnItemEx("ASPFireSpecimanTrail1",0,0,8,random(-20,20),random(-20,20),random(-20,20),0,0,0)
TNT1 AA 0 A_SpawnItemEx("ASPFireSpecimanExplosivesTrail",0,0,8,random(-25,25),random(-25,25),random(-25,25),0,0,0)
X_8B ABCDEF 2 A_Fadeout(0.08)
stop
}
}

actor ASPFireSpecimanExplosivesTrail : BasicProjectile
{
Translation "198:198=40:40", "192:192=218:218"
damagetype "ASPFireMagic"
Obituary "%o was badly burnt by \cgRed Speciman\c- (%k)'s \crASP Charged Fire\c-."
-NOGRAVITY
+HEXENBOUNCE
+BOUNCEONACTORS
+CANBOUNCEWATER
bouncefactor 0.85
wallbouncefactor 0.8
bouncecount 4
ReactionTime 7
damage (20)
Radius 4
Height 3
speed 80
scale 1.0
States
{
Spawn:
X_8B ABCDEF 2 A_SpawnitemEX("ASPFireSpecimanExplosivesTrailX",0,0,0,0,0,0,0,1)
X_8B A 0 A_Explode(80,90,0)
X_8B A 0 A_Countdown
loop
Death:
TNT1 A 1
stop
}
}

actor ASPFireSpecimanExplosivesTrailX : BasicGraphicEffect
{
Scale 1.5
States
{
SpawnFrame:
X_8B ABCDEF 2
stop
}
}


actor ASPFireSpecimanTrail1 : BasicGraphicEffect
{
Translation "192:192=218:218", "198:198=40:40"
+FORCEXYBILLBOARD
scale 4.5 
States
{
SpawnFrame:
X_8C DDEEF 2 A_Fadeout(0.2) 
stop
}
}

actor ASPFireSpecimanTrail2 : ASPFireSpecimanTrail1
{
States
{
SpawnFrame:
X_8C AAABBCCDD 3 A_Fadeout
stop
}
}

actor ASPFireMiniShot : BasicProjectile
{
Translation "192:192=218:218","198:198=40:40"
damagetype "ASPFireMagic"
Obituary "%o was badly burnt by \cgRed Speciman\c- (%k)'s \crASP Fire\c-."
+SKYEXPLODE
Damage (85)
Radius 12
Height 12
speed 50
scale 2.5
States
{
Spawn:
6P50 UVW 1 A_SpawnItemEx("ASPFireSpecimanTrail1",random(-6,6),random(-6,6),random(-6,6),0,0,0,0,32)
loop
Death:
TNT1 A 0 A_Explode(50,64,0,0,8)
TNT1 AAA 0 A_SpawnItemEx("ASPFireSpecimanTrail1",0,0,4,random(-12,12),random(-12,12),random(-12,12),0,0,0)
TNT1 AAAAA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",0,0,4,random(-6,6),random(-6,6),random(-6,6),0,0,0)
TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TNT1 A 1
stop
}
}

actor ASPFireMiniShot2 : ASPFireMiniShot
{
Obituary "%o was caught in range of \cgRed Speciman\c- (%k)'s \crASP Flame\c-."
-NOGRAVITY
+THRUGHOST
Damage (55)
}

actor ASPFlamePinPointer : FastProjectile
{
damagetype "ASPFireMagic"
//Obituary "%o was unable to afford insurance."
+THRUGHOST
+THRUACTORS
+DONTREFLECT
+DONTBLAST
damage (0)
Radius 8
Height 12
Speed 1000
Scale 2.5
States
{
Spawn:
TNT1 A 1
loop
Death:
// TNT1 A 0 A_GiveToTarget("UH_TargetMarker")
TNT1 A 0 A_SpawnItemEx("ASPFlameBoom")
stop
}
}

actor ASPFlameBoom : BasicProjectile
{
damagetype "ASPFireMagic"
Obituary "%o was caught in range of \cgRed Speciman\c- (%k)'s \crASP Flame\c-."
+THRUACTORS
+DONTREFLECT
+DONTBLAST
+FLOORHUGGER
gravity 9.0
Reactiontime 20
damage (0)
Radius 2
Height 2
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect","Weapon")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("ASPFireSpecimanTrail1",0,0,0,random(-5,5),random(-5,5),random(5,10))
TNT1 A 2 A_Explode(75,100,0,0,20)
Kalalala:
TNT1 AA 0 A_SpawnItemEx("ASPFireSpecimanTrail2",0,0,0,random(-16,16),random(-16,16),32)
TNT1 A 0 A_SpawnItemEx("ASPFireMiniShot2",0,0,2,random(-8,8),random(-8,8),random(8,32))
TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
TNT1 A 2 A_Explode(50,100,0,0,20)
TNT1 A 0 A_Countdown
loop
Death:
TNT1 A 1
stop
}
}


actor MagicDevilEye_RageFX_H : BasicClientSide {
  Translation "192:192=65:65", "198:198=58:58"
  var int user_A;
  ReactionTime 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_A", random(0, 30))
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_RageFX1", random(182, 222), 0, random(0, 16), random(-18, -20), 0, 0, user_A + random(-15, 15), 37, 224)

    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_RageFX1", random(172, 212), 0, random(28, 44), random(-17, -19), 0, random(-6, -9), user_A + random(-20, 20), 37, 224)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_RageFX1", random(172, 212), 0, random(-28, -12), random(-17, -19), 0, random(6, 9), user_A + random(-20, 20), 37, 224)

    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_RageFX2", random(172, 212), 0, random(56, 72), random(-16, -18), 0, random(-6, -11), user_A + random(-25, 25), 37, 224)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_RageFX2", random(172, 212), 0, random(-56, -40), random(-16, -18), 0, random(6, 11), user_A + random(-25, 25), 37, 224)
    TNT1 A 0 A_SetUserVar("user_A", user_A + 30)

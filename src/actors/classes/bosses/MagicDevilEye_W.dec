    stop
  }
}

actor PainMagicDevilEyeFling_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("NoPushFlag", 1, "No")
    TNT1 A 0 A_JumpIfInventory("HalfPushFlag", 1, "Half")
    TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
    TNT1 A 0 ThrustThing(random(0, 255), random(2, 8) + 4, 1, 0)
    TNT1 A 0 A_SetAngle(angle + (random(0, 1) * 2 - 1) * random(1, 4) * 5)
    stop
   Half:
    TNT1 A 0 ThrustThingZ(0, 15, 0, 0)
    TNT1 A 0 ThrustThing(random(0, 255), random(1, 4) + 2, 1, 0)
    TNT1 A 0 A_SetAngle(angle + (random(0, 1) * 2 - 1) * random(1, 4) * 2.5)
    stop
   No:
    TNT1 A 0
    stop
  }
}

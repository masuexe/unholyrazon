  powerup.duration 4
}

actor MagicDevilEyeMash_F : Inventory {
  Inventory.MaxAmount 200
}
actor MagicDevilEyeDelay_F : Inventory {
  Inventory.MaxAmount 100
}

// Ownership markers for our core_*player stacks (GenericBossAirDisable_F pattern).
// Deselect/DeselectDeath peel only when these are present so external layers stay intact.
actor MagicDevilEyeInvul_F : Once {}
actor MagicDevilEyeNoGrav_F : Once {}
actor MagicDevilEyeStop_F : Once {}

actor MagicDevilEye_ClearProps_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MagicDevilEyeInvul_F", 1, "DoInvul")
    goto CheckNoGrav
   DoInvul:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 A_TakeInventory("MagicDevilEyeInvul_F")
   CheckNoGrav:
    TNT1 A 0 A_JumpIfInventory("MagicDevilEyeNoGrav_F", 1, "DoNoGrav")
    goto CheckStop
   DoNoGrav:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    TNT1 A 0 A_TakeInventory("MagicDevilEyeNoGrav_F")
   CheckStop:
    TNT1 A 0 A_JumpIfInventory("MagicDevilEyeStop_F", 1, "DoStop")
    stop
   DoStop:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    TNT1 A 0 A_TakeInventory("MagicDevilEyeStop_F")
    stop
  }
}

actor MagicDevilEye_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "PickupReload")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)
    stop
  }
}
actor MagicDevilEye_Ready8_P : MagicDevilEye_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}


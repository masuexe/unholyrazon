actor MagicDevilEye_PainFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P0K A 2
    goto Spawn2
    6P0K B 2
    goto Spawn2
    6P0K C 2
    goto Spawn2
    6P0K D 2
    goto Spawn2
   Spawn2:

actor MagicDevilEye_PewWarper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "DeathTarget")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathTracer")
    TNT1 A 0  // A_GiveInventory("",1,8)
    TNT1 A 0  // A_GiveToTarget("",1)
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, 8)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_PewWarperFX", random(-86, 86), random(-86, 86), random(-86, 86), 0, 0, 0, 0, 0, 32)
    TNT1 A 1 A_JumpIfInTargetInventory("MagicDevilEyePew_PU", 1, "NukeCharge")
    loop

   NukeCharge:
    TNT1 A 5 A_TakeInventory("MagicDevilEyeMarked_F", 99, 0, 8)
   NukeWait:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathTracer")
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, 8)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_PewWarperFX", random(-86, 86), random(-86, 86), random(-86, 86), 0, 0, 0, 0, 0, 32)
    TNT1 A 1 A_JumpIfInTargetInventory("MagicDevilEyePew_PU", 1, "NukeTime")
    loop

   NukeTime:
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, 8)
    TNT1 A 0 A_JumpIfInTargetInventory("MagicDevilEyeMash_F", 175, "SHE_WHO_STRIKES_FIRST")
    TNT1 A 0 A_JumpIfInTargetInventory("MagicDevilEyeMash_F", 100, "BlastoBoom")
   BasicBoom:
    TNT1 A 1 A_SpawnItemEx("MagicDevilEye_PewNuke1")
    stop
   BlastoBoom:
    TNT1 A 1 A_SpawnItemEx("MagicDevilEye_PewNuke2")
    stop
   SHE_WHO_STRIKES_FIRST:
    TNT1 A 1 A_SpawnItemEx("MagicDevilEye_PewNuke3")
    stop

   DeathTarget:
    TNT1 A 0 A_TakeInventory("MagicDevilEyeMarked_F", 99, 0, 8)
    stop
   DeathTracer:
    TNT1 A 0  // A_TakeFromTarget("")
    stop
   Death:
    TNT1 A 0
    stop
  }
}


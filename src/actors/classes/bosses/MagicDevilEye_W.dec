actor MagicDevilEye_Shot : BasicProjectile {
  Translation "192:192=4:4", "198:198=58:58", "202:202=58:58", "199:199=65:65"
  // Translation "192:192=65:65", "198:198=58:58"
  DamageType "MagicDevilEye"
  Obituary "%o was hit by %k's spectacular magic shot."
  Damage (125)
  Radius 22
  Height 22
  Speed 70
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   Spawn1:
    8Q15 A 2 A_SpawnItemEx("MagicDevilEye_ShotFX4", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 J 2 A_SpawnItemEx("MagicDevilEye_ShotFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 K 2 A_SpawnItemEx("MagicDevilEye_ShotFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 L 2 A_SpawnItemEx("MagicDevilEye_ShotFX3", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Spawn2:
    8Q15 L 2 A_SpawnItemEx("MagicDevilEye_ShotFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 K 2 A_SpawnItemEx("MagicDevilEye_ShotFX4", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 J 2 A_SpawnItemEx("MagicDevilEye_ShotFX3", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 A 2 A_SpawnItemEx("MagicDevilEye_ShotFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("KirbyNES/BombBoom", "Weapon", 0, 0.5)
    TNT1 A 0 A_Explode(85, 156, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_ShotFX0")
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("MagicDevilEye_StarBitFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 0)
    TNT1 AA 2 A_SpawnItemEx("MagicDevilEye_ShotBoom", random(-96, 96), random(-96, 96), random(-72, 72))
    TNT1 AA 2 A_SpawnItemEx("MagicDevilEye_ShotBoom", random(-128, 128), random(-128, 128), random(-72, 72))
    TNT1 AA 2 A_SpawnItemEx("MagicDevilEye_ShotBoom", random(-156, 156), random(-156, 156), random(-72, 72))
    stop
  }
}


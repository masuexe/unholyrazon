actor MagicDevilEye_PewMarker : FastProjectile {
  Translation "192:192=250:250", "198:198=238:238"
  DamageType "MagicDevilEye"
  +SKYEXPLODE
  +EXPLODEONWATER
  +DONTBLAST
  +DONTREFLECT
  +DONTSPLASH
  +THRUGHOST
  +HITTRACER
  RenderStyle "None"
  ReactionTime 1
  Damage (0)
  Radius 16
  Height 16
  Speed 3750
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    TNT1 A 1 A_CountDown
    wait

   XDeath:
    TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer"), "NukeCheck")
    goto Death
   NukeCheck:
    TNT1 A 0 A_JumpIfInventory("MagicDevilEyeMarked_F", 1, "DeathJ", 8)
    TNT1 A 0 A_GiveToTarget("WeaponCharge", 1)
    TNT1 A 0 A_GiveInventory("MagicDevilEyeMarked_F", 1, 8)
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_PewWarper", 0, 0, 0, 0, 0, 0, 0, 1057)
    goto Death

   Death:
    TNT1 A 0
    TNT1 A 0  // A_Stop
    TNT1 A 0 A_SpawnItemEx("MagicDevilEye_PewTargetFX")
    stop

   DeathJ:
    TNT1 A 0  // A_LOG("FAILED, ALREADY MARKED!")
    goto Death
  }
}


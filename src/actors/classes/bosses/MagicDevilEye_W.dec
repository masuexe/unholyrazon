actor MagicDevilEye_W_ScriptBar : ScriptBar {}
actor MagicDevilEye_W : BaseUnholyBossWep {
  Tag "$TAG_MagicDevilEye_W"
  Obituary "\ctMagic \caSpecialist\c- (%k) checked %o's pressure level."
  Inventory.Pickupmessage "\cjGoing MY way."
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyBossAmmo300"
  States {
   Spawn:
    8I15 [ 1
    wait

   Deselect:
    8I15 A 0 A_GiveInventory("MagicDevilEye_ClearProps_P")
    goto DeselectSwap
   DeselectDeath:
    8I15 "#" 0 A_GunFlash("NoFlash", GFF_NOEXTCHANGE)
    8I15 "#" 1 A_SetTics(1 - CallACS("uh_IsItOnline"))
    8I15 "#" 0 A_GiveInventory("MagicDevilEye_ClearProps_P")
    goto DeselectSwap+1
   Select:
    8I15 A 0
    goto SelectSwap

   Ready:
    8I15 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8I15 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, MAGICDEVILEYE_DYE)
    8I15 A 2
    8I15 A 0 A_GiveInventory("UnholyBossAmmo200", 150)
    8I15 A 4 A_GiveInventory("UnholyBossAmmo300", 200)
    goto ReadyX
   ReadyX:
    8I15 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX1")
    8I15 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX2")
    8I15 A 2 A_GiveInventory("MagicDevilEye_Ready8_P")
    loop
   ReadyX1:
    8I15 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX3")
    8I15 A 2 A_GiveInventory("MagicDevilEye_Ready8_P")
    loop
   ReadyX2:
    8I15 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX3")
    8I15 A 2 A_GiveInventory("MagicDevilEye_Ready0_P")
    loop
   ReadyX3:
    8I15 A 2 A_GiveInventory("MagicDevilEye_Ready0_P")
    loop

   Flash.ItemGlow:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    loop
   Flash.ItemGlow2:
    TNT1 AA 2 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE2)
    TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE3)
    TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE4)
    goto Flash.ItemGlow2+2
   Flash.ItemGlowEnd:
    TNT1 AA 2 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    stop

   Reload:
    8I15 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "GoingMyWayComedy")
    8I15 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300, "GoingMyWay")
    goto ReadyX
   GoingMyWay:
    8I15 A 0 A_GiveInventory("VivifyDelay10")
    8I15 A 0 A_GunFlash("Flash.ItemGlow")
    8I15 A 0 A_TakeInventory("UnholyBossAmmo300")
    8I15 A 0 A_PlaySoundEx("KirbyNES/CrashStart", "Weapon")
    8I15 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I15 A 0 A_ScaleVelocity(0.75)

    8I15 A 1 Offset(5, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(11, 42)
    8I15 A 1 Offset(18, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(23, 41)
    8I15 A 1 Offset(26, 35) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(28, 28)
    8I15 A 1 Offset(26, 21) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(23, 16)
    8I15 A 1 Offset(20, 13) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(17, 11)
    8I15 A 1 Offset(13, 11) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(9, 12)
    8I15 A 1 Offset(4, 15) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-1, 18)
    8I15 A 1 Offset(-7, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-13, 26) A_GiveInventory("VivifyDelay5")
    8I15 A 1 Offset(-21, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-29, 34)
    8I15 A 1 Offset(-39, 39) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-50, 44)
    8I15 A 0 A_GiveInventory("VivifyDelay4")
    8I15 A 1 Offset(-58, 50) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-66, 56) A_GunFlash("Flash.ItemGlowEnd", GFF_NOEXTCHANGE)

    8I15 BCBCBCBCBCBC 2 Offset(-66, 56) A_GiveInventory("MagicDevilEye_AOEItem_P")

    8I15 A 2 Offset(-66, 56)
    8I15 A 1 Offset(-54, 52)
    8I15 A 1 Offset(-44, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-35, 45) A_GiveInventory("VivifyDelay3")
    8I15 A 1 Offset(-27, 42) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-20, 40) ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8I15 A 1 Offset(-14, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-9, 36)
    8I15 A 1 Offset(-5, 34) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-2, 33)

    8I15 A 4 A_WeaponReady(14)
    8I15 AA 2
    goto ReadyX

   GoingMyWayComedy:
    8I15 A 0 A_GiveInventory("VivifyDelay10")
    8I15 A 0 A_GunFlash("Flash.ItemGlow")
    8I15 A 0 ThrustThingZ(0, 20, 0, 1)
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeNoGrav_F", 1, 2)
    8I15 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I15 A 0 A_GiveInventory("MagicDevilEyeNoGrav_F")
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeStop_F", 1, 2)
    8I15 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I15 A 0 A_GiveInventory("MagicDevilEyeStop_F")
    8I15 A 0 A_GiveInventory("UnholyPowerDazzle_F")
    8I15 A 0 A_GiveInventory("MagicDevilEye_RageFX_P")
    8I15 A 0 A_PlaySoundEx("KirbyNES/CrashStart", "Weapon", 0, 1)
    8I15 B 1 Offset(-11, 15) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 B 1 Offset(-22, -2)
    8I15 A 0 A_Stop
    8I15 A 0 A_GiveInventory("VivifyDelay5")

    8I15 A 0 A_GiveInventory("MagicDevilEye_RageFX_P")
    8I15 C 1 Offset(-33, -19) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 C 1 Offset(-44, -36)

    8I15 BCBCBCBC 2 Offset(-44, -36) A_GiveInventory("MagicDevilEye_RageFX_P")
    8I15 AAA 2 Offset(-44, -36)
    8I15 A 0 A_GiveInventory("VivifyDelay7")
    8I15 A 1 Offset(-49, -16) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-55, 4)
    8I15 A 0 A_GunFlash("Flash.ItemGlow2")
    8I15 B 0 ACS_NamedExecuteAlways("UB_MagicDevilFlingACS", 0, 115)
    8I15 BC 2 Offset(-55, 4)
    8I15 A 0 A_GiveInventory("VivifyDelay5")
    8I15 A 1 Offset(-55, -16) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-55, -36)
    8I15 A 1 Offset(-55, -36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-59, -5)
    8I15 A 1 Offset(-63, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-66, 56)
    8I15 A 0 A_GiveInventory("VivifyDelay4")
    8I15 A 0 A_TakeInventory("UnholyPowerDazzle_F")
    8I15 B 0 A_PlaySoundEx("KirbyNES/QuickDrawCannon", "Weapon", 0, 1)
    8I15 B 0 A_GunFlash("Flash.ItemGlowEnd", GFF_NOEXTCHANGE)
    8I15 B 0 ACS_NamedExecuteAlways("UB_MagicDevilFlingACS", 0, 2115)
    8I15 BCAAA 2 Offset(-66, 56)
    8I15 A 0 A_GiveInventory("MagicDevilEye_ClearProps_P")
    8I15 A 0 A_GiveInventory("VivifyDelay3")
    8I15 A 1 Offset(-54, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-44, 48)
    8I15 A 1 Offset(-35, 45) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-27, 42)
    8I15 A 1 Offset(-20, 40) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-14, 38)
    8I15 A 1 Offset(-9, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-5, 34)
    8I15 A 1 Offset(-2, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 6 A_WeaponReady(14)
    goto ReadyX

   Fire:
    8I15 A 0 A_GiveInventory("VivifyFlag1")
    8I15 A 0 A_ReFire(1)
    8I15 A 0
   FireH0:
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeCharge_F", 7, "FireH1_Snd")
    8I15 A 1 Offset(6, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    8I15 A 0 A_ReFire(1)
    goto Fire1
    8I15 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 1 Offset(6, 20) A_GiveInventory("MagicDevilEyeCharge_F", 1)
    8I15 A 0 A_ReFire("FireH0")
    goto Fire1

   FireH1_Snd:
    8I15 A 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
   FireH1:
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeCharge_F", 17, "FireH2")
    8I15 A 1 Offset(10, 14) A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    8I15 A 0 A_ReFire(1)
    goto Fire2
    8I15 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 1 Offset(10, 14) A_GiveInventory("MagicDevilEyeCharge_F", 1)
    8I15 A 0 A_ReFire("FireH1")
    goto Fire2

   FireH2:
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeCharge_F", 28, "FireH3")
    8I15 A 1 Offset(12, 11) A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    8I15 A 0 A_ReFire(1)
    goto Fire2
    8I15 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 1 Offset(12, 11) A_GiveInventory("MagicDevilEyeCharge_F", 1)
    8I15 A 0 A_ReFire("FireH2")
    goto Fire2

   FireH3:
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 1 Offset(12, 11) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE2)
    8I15 A 0 A_ReFire(1)
    goto Fire3
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 1 Offset(12, 8) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE3)
    8I15 A 0 A_ReFire(1)
    goto Fire3
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 0 A_GiveInventory("MagicDevilEyeCharge_RC")
    8I15 A 1 Offset(14, 6) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE4)
    8I15 A 0 A_ReFire(1)
    goto Fire3
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 1 Offset(16, 8) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE2)
    8I15 A 0 A_ReFire(1)
    goto Fire3
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 1 Offset(16, 11) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE3)
    8I15 A 0 A_ReFire(1)
    goto Fire3
    8I15 AA 0 A_SpawnItemEx("MagicDevilEye_ChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 0)
    8I15 A 0 A_GiveInventory("MagicDevilEyeCharge_RC")
    8I15 A 1 Offset(14, 13) ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE4)
    8I15 A 0 A_ReFire("FireH3")
    goto Fire3

   Fire1:
    8I15 A 2 Offset(16, 5) A_TakeInventory("MagicDevilEyeCharge_F")
    8I15 A 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    8I15 A 2 Offset(4, 13) A_GiveInventory("VivifyDelay5")
    8I15 A 2 Offset(-10, 22)
    8I15 A 2 Offset(-26, 32) A_GiveInventory("VivifyDelay4")
    8I15 B 0 A_PlaySoundEx("KirbyNES/StarRod", "Weapon")
    8I15 B 0 A_FireCustomMissile("MagicDevilEye_Pew", 0, 0, 8, 0)
    8I15 BC 2 Offset(-44, 43) A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 2 Offset(-22, 37) A_GiveInventory("VivifyDelay3")
    8I15 A 0 A_TakeInventory("VivifyFlag1")
    goto ReadyX

   Fire2:
    8I15 A 2 Offset(16, 5) A_TakeInventory("MagicDevilEyeCharge_F")
    8I15 A 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    8I15 A 2 Offset(4, 13) A_GiveInventory("VivifyDelay5")
    8I15 A 2 Offset(-10, 22)
    8I15 A 2 Offset(-26, 32) A_GiveInventory("VivifyDelay4")
    8I15 B 0 A_PlaySoundEx("KirbyNES/StarRod", "Weapon")
    8I15 B 0 A_FireCustomMissile("MagicDevilEye_Pew2", 0, 0, 8, 0)
    8I15 BC 2 Offset(-44, 43) A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 2 Offset(-22, 37) A_GiveInventory("VivifyDelay3")
    8I15 A 0 A_TakeInventory("VivifyFlag1")
    goto ReadyX

   Fire3:
    8I15 A 2 Offset(16, 5) A_TakeInventory("MagicDevilEyeCharge_F")
    8I15 A 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
    8I15 A 2 Offset(4, 13) A_GiveInventory("VivifyDelay5")
    8I15 A 2 Offset(-10, 22)
    8I15 A 2 Offset(-26, 32)
    8I15 A 2 Offset(-44, 43) A_GiveInventory("VivifyDelay4")
    8I15 B 0 A_ChangeVelocity(-cos(pitch) * 20, 0, sin(pitch) * 16, CVF_RELATIVE)
    8I15 B 0 A_PlaySoundEx("KirbyNES/MultiStarShot", "Weapon")
    8I15 B 0 A_FireCustomMissile("MagicDevilEye_Shot", 0, 0, 8, 0)
    8I15 BCB 2 Offset(-44, 43) A_GiveInventory("UnholyBossAmmo200", 2)
    8I15 A 2 Offset(-28, 39)
    8I15 A 2 Offset(-15, 37) A_GiveInventory("VivifyDelay3")
    8I15 A 2 Offset(-6, 35)
    8I15 A 0 A_TakeInventory("VivifyFlag1")
    goto ReadyX


   Altfire:
    8I15 A 0 A_JumpIfInventory("WeaponCharge", 1, "AltfireThingGiver")
    8I15 A 1 A_JumpIfInventory("UnholyBossAmmo200", 200, "HeyThereNeighborino")
    goto ReadyX
   HeyThereNeighborino:
    8I15 A 0 A_JumpIfInventory("WeaponCharge", 1, "AltfireThingGiver")
    8I15 A 0 A_GiveInventory("VivifyFlag2")
    8I15 A 0 A_ReFire(1)
    8I15 A 1 Offset(10, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(22, 14)
    8I15 A 0 A_ReFire(1)
    8I15 A 1 Offset(36, 10) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(20, 14)
    8I15 A 0 A_ReFire(1)
    8I15 A 1 Offset(4, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-13, 28)
    8I15 A 0 A_ReFire(1)
    8I15 A 1 Offset(-31, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-50, 38)
    goto ItsLikeImFeeling

    /*
    //Up and down
    8I15 A 1 Offset(-9,8)
    8I15 A 1 Offset(-18,-16)
    8I15 A 1 Offset(-27,-28)
    8I15 A 1 Offset(-36,-34)
    8I15 A 1 Offset(-45,-16)
    8I15 A 1 Offset(-54,4)
    8I15 A 1 Offset(-63,26)
    8I15 A 0
    //Go to X
    8I15 A 1 Offset(-9,36)
    8I15 A 1 Offset(-18,38)
    8I15 A 1 Offset(-27,40)
    8I15 A 1 Offset(-36,42)
    8I15 A 1 Offset(-45,44)
    8I15 A 1 Offset(-54,46)
    8I15 A 1 Offset(-63,48)
    8I15 A 0
     */

   ItsLikeImFeeling:
    // 8I15 A 0 A_JumpIfNoAmmo("NothingAtAll")
    8I15 A 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 2)
    8I15 A 0 A_JumpIf(true, "NothingAtAll")
    8I15 A 0 A_PlaySoundEx("KirbyNES/UFOLoop", "weapon")
    8I15 A 0 A_FireCustomMissile("MagicDevilEye_PewMarkerFX", 0, 0, 0, 0)
    // 8I15 A 0 A_SpawnItemEx("MagicDevilEye_PewMarkerFX",0,0,32,cos(-pitch)*120,0,sin(-pitch)*120,0,32)
    // 8I15 A 0 A_SpawnItemEx("MagicDevilEye_PewMarker",0,0,32,cos(-pitch)*3750,0,sin(-pitch)*3750,0,32)
    8I15 A 0 A_TakeInventory("UnholyBossAmmo200", 2)
    8I15 A 1 Offset(-72, 50) A_FireCustomMissile("MagicDevilEye_PewMarker", 0, 0, 0, 0)
    8I15 A 0 A_ReFire(2)
    8I15 A 1 A_JumpIfInventory("WeaponCharge", 1, "AltfireThingGiver")
    goto NothingAtAll
    8I15 A 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 2)
    8I15 A 0 A_JumpIf(true, "NothingAtAll")
    8I15 A 0 A_FireCustomMissile("MagicDevilEye_PewMarkerFX", 0, 0, 0, 0)
    8I15 A 0 A_TakeInventory("UnholyBossAmmo200", 2)
    8I15 A 1 Offset(-72, 50) A_FireCustomMissile("MagicDevilEye_PewMarker", 0, 0, 0, 0)
    8I15 A 0 A_ReFire("ItsLikeImFeeling")
    8I15 A 1 A_JumpIfInventory("WeaponCharge", 1, "AltfireThingGiver")
    goto NothingAtAll
   NothingAtAll:
    8I15 A 1 A_JumpIfInventory("WeaponCharge", 1, "AltfireThingGiver")
    8I15 A 1 Offset(-64, 46) A_TakeInventory("UnholyBossAmmo200", 50)
    8I15 A 1 Offset(-42, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-28, 40)
    8I15 A 0 A_TakeInventory("VivifyFlag2")
    8I15 A 1 Offset(-12, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-6, 34)
    8I15 A 1 Offset(-2, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 A_WeaponReady(14)
    goto ReadyX

   AltfireThingGiver:
    // Already owning stacks: do not push again (WeaponReady used to allow secondary re-entry).
    8I15 A 0 A_JumpIfInventory("MagicDevilEyeInvul_F", 1, "AltfireMasher")
    8I15 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I15 A 0 A_GiveInventory("MagicDevilEyeInvul_F")
    8I15 A 0 A_PlaySoundEx("KirbyNES/QuickDrawStart", "Body")
    8I15 A 0 A_TakeInventory("UnholyBossAmmo200")
    8I15 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I15 A 0 A_GiveInventory("MagicDevilEyeNoGrav_F")
    8I15 A 0 A_GiveInventory("MagicDevilEyePew_PU")
    8I15 A 0 A_GiveInventory("VivifyFlag1")
    8I15 A 0 A_GiveInventory("VivifyDelay10")
    8I15 A 0 A_ScaleVelocity(0.45)
    8I15 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I15 A 0 A_GiveInventory("MagicDevilEyeStop_F")
    8I15 A 0 ThrustThingZ(0, 4, 0, 1)
    // 14 = NOSWITCH|NOPRIMARY|NOSECONDARY — no cancel/restack window
    8I15 A 1 A_WeaponReady(14)
    goto AltfireMasher

   AltfireMashed:
    8I15 C 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE1)
    8I15 C 0 A_PlaySoundEx("KirbyNES/Beam", "Weapon")
    8I15 CCC 0 A_SpawnItemEx("MagicDevilEye_StarBitFX", 36, 0, 82, random(-15, 15), random(-15, 15), random(-5, 20), 0, 0)
    8I15 CCCC 0 A_SpawnItemEx("MagicDevilEye_PewFX", random(28, 44), random(-6, 6), random(78, 86), 0, 0, 0, 0, 0)
    8I15 C 0 A_GiveInventory("MagicDevilEyeMash_F", 30)
    8I15 C 1 A_GiveInventory("MagicDevilEyeDelay_F", 1)
    8I15 C 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)
   AltfireMashWait:
    8I15 C 0 A_JumpIfInventory("MagicDevilEyeDelay_F", 100, "AltfireMashEnd")
    8I15 C 1 A_TakeInventory("MagicDevilEyeMash_F", 2)
    8I15 C 0 A_SpawnItemEx("MagicDevilEye_MashIdleFX", random(-86, 86), random(-86, 86), random(-86, 86), 0, 0, 0, 0, 0)
    8I15 C 0 A_GiveInventory("MagicDevilEyeDelay_F", 1)
    8I15 C 0 A_ReFire("AltfireMashWait")
   AltfireMasher:
    8I15 B 0 A_JumpIfInventory("MagicDevilEyeDelay_F", 100, "AltfireMashEnd")
    8I15 B 1 A_TakeInventory("MagicDevilEyeMash_F", 2)
    8I15 B 0 A_SpawnItemEx("MagicDevilEye_MashIdleFX", random(-86, 86), random(-86, 86), random(-86, 86), 0, 0, 0, 0, 0)
    8I15 B 0 A_GiveInventory("MagicDevilEyeDelay_F", 1)
    8I15 B 0 A_ReFire("AltfireMashed")
    loop
   AltfireMashEnd:
    8I15 A 0 A_GiveInventory("VivifyDelay5")
    8I15 A 2 A_GiveInventory("MagicDevilEye_ClearProps_P")
    8I15 A 0 A_GiveInventory("MagicDevilEyePew_PU")
    8I15 A 0 ACS_NamedExecuteWithResult("core_chargecolor", MAGICDEVILEYE_DYE)

    8I15 A 8 A_GiveInventory("VivifyDelay4")
    8I15 A 0 A_TakeInventory("MagicDevilEyeMash_F")
    8I15 A 0 A_TakeInventory("MagicDevilEyeDelay_F")
    8I15 A 0 A_TakeInventory("WeaponCharge")
    8I15 A 1 Offset(-63, 35)
    8I15 A 1 Offset(-42, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-28, 39)
    8I15 A 1 Offset(-12, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 1 Offset(-6, 34)
    8I15 A 1 Offset(-2, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I15 A 2 A_WeaponReady(14)
    8I15 A 8 A_GiveInventory("VivifyDelay3")
    8I15 A 0 A_TakeInventory("VivifyFlag1")
    8I15 A 0 A_TakeInventory("VivifyFlag2")
    goto ReadyX
  }
}


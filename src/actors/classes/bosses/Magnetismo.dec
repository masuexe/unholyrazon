actor Magnetismo : BossBase {
  Player.ScoreIcon "UB020MUG"
  Player.SoundClass "Magnetismo"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 18
  Player.MaxHealth 2000
  Health 2000
  Player.MorphWeapon "Magnetismo_W"
  States {
   Spawn:
    8A20 A 0
    8A20 B 1
    8A20 A 1 A_JumpIfInventory("ShieldCheck", 1, "Magnetize")
    goto Spawn+2
   See:
    8A20 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIfInventory("ShieldCheck", 1, "Magnetize")
    goto Spawn
   Missile:
    8A20 F 1
    8A20 F 0 A_JumpIfInventory("ShieldCheck", 1, "Magnetize")
    8A20 F 4
    8A20 G 4
    goto Spawn+2
   Magnetize:
    8A20 F 4
    8A20 F 2 A_JumpIfInventory("ShieldCheck", 1, "Magnetize")
    goto Spawn+2
   ClassPain:
    8A20 H 0
    goto MegamanPain
   ClassDeath:
    8A20 H 0
    goto MegamanDeath
  }
}

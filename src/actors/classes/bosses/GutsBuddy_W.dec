actor GutsBuddy_W_NormalBar : NormalBar {args 4, 94}
actor GutsBuddy_W_SecondBar : SecondBar {args 216, 41}
actor GutsBuddy_W_ReloadIcon {Tag "R046MUG"}
actor GutsBuddy_W : BaseUnholyBossWep
{
Tag "$TAG_Boss046_W"
Obituary "%o had a friend named %k."
Inventory.Pickupmessage "\cjYou got the guts!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H46 [ 1
wait

Deselect:
8H46 A 0
goto DeselectSwap
Select:
8H46 A 0
goto SelectSwap

Ready:
8H46 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H46 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GUTSBUDDY_DYE)
8H46 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 46,3850,355)
8H46 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H46 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX_16")
8H46 A 2 A_WeaponReady
loop
ReadyX_16:
8H46 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
loop

Fire:
8H46 A 1 Offset(8,66)A_JumpIfInventory("SuperArmTemp",1,"Throw")
8H46 A 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8H46 A 0 A_ScaleVelocity(0.75)
8H46 A 0 A_GiveInventory("SuperArmTemp",1)
8H46 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H46 A 0 A_JumpIfInventory("UnholyPower1500",1500,"FireFeelings")
8H46 B 2 Offset(-20,131)A_SpawnItemEx("GutsBuddyRockLiftWarp",80,0,0,0,0,0,0,0)
8H46 B 2 Offset(-10,83)
8H46 B 4 A_WeaponReady(14)
8H46 B 6 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
goto FireWait
FireFeelings:
8H46 A 0 A_GiveInventory("GutsBuddyFlag",1)
8H46 B 2 Offset(-20,131)A_SpawnItemEx("GutsBuddyRockLiftWarpX",80,0,0,0,0,0,0,0)
8H46 B 2 Offset(-10,83)
8H46 B 4 A_WeaponReady(14)
8H46 B 4 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H46 B 2 A_TakeInventory("UnholyPower1500", 1500)
goto FireWait2
FireWait:
8H46 B 1 A_GiveInventory("IdleGutsBuddyTempRock_PU")
8H46 B 0 A_GiveInventory("UnholyBossAmmo200",1)
loop
FireWait2:
8H46 B 1 A_GiveInventory("IdleGutsBuddyTempRockX_PU")
8H46 B 0 A_GiveInventory("UnholyBossAmmo200",1)
loop
Throw:
8H46 A 0 A_JumpIfInventory("GutsBuddyFlag",1,"MyFeelings")
8H46 A 0 A_FireCustomMissile("GutsBuddyRock",0,1,0,56)
8H46 A 0 A_TakeInventory("SuperArmTemp",1)
8H46 C 2 Offset(80,-98)
8H46 C 2 Offset(9,-57)
8H46 C 2 Offset(-42,-17)
8H46 D 2 Offset(-62,56)
8H46 D 2 Offset(-84,79)
8H46 D 2 Offset(-100,107)
TNT1 A 14
8H46 A 2 Offset(6,92)
8H46 A 2 Offset(4,72)
8H46 A 2 Offset(2,52)
Goto ReadyX
MyFeelings:
8H46 A 0 A_FireCustomMissile("GutsBuddyFeelings",0,1,0,56)
8H46 A 0 A_TakeInventory("SuperArmTemp",1)
8H46 A 0 A_TakeInventory("GutsBuddyFlag",1)
8H46 C 2 Offset(80,-98)
8H46 C 2 Offset(9,-57)
8H46 C 2 Offset(-42,-17)
8H46 D 2 Offset(-62,56)
8H46 D 2 Offset(-84,79)
8H46 D 2 Offset(-100,107)
TNT1 A 30
8H46 A 2 Offset(6,92)
8H46 A 2 Offset(4,72)
8H46 A 2 Offset(2,52)
Goto ReadyX

Altfire:
8H46 A 0 A_JumpIfInventory("SuperArmTemp",1,"Throw")
8H46 A 0 A_PlaySoundEx("Weapon/GutMelee","Weapon")
8H46 A 0 A_FireCustomMissile("GutsBuddyPunch",0,0,0,0)
8H46 F 2 Offset(-28,8)
8H46 F 2 Offset(-56,-16)
8H46 E 2 Offset(-30,4)
8H46 E 2 Offset(-15,18)
Goto ReadyX

Flash:
TNT1 A 0 A_JumpIfInventory("IsDead",1,"NoFlash")
TNT1 A 2 A_GiveInventory("GutsBuddyFlash_P",1)
loop

// TODO: is "Reload" state better than check input in "Flash" state?
Reload:
8H46 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "GutsLeap")
goto ReadyX
GutsLeap:
8H46 A 0 A_PlaySoundEx("weapon/superarmuse","Body")
8H46 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
8H46 A 0 ThrustThingZ(0,60,0,0)
//TNT1 A 0 A_Recoil(-35)//Unsure.
8H46 AA 2
GutsAirTime:
8H46 A 1 A_JumpIf(CallACS("core_checkfooting_thruplayer"), "GutsLand")
8H46 A 0 A_PlaySoundEx("BUTTSCKS", "Body")
8H46 A 0 A_SpawnItemEX("GutsBuddyContactDamage",0,0,0,momx,momy,momz,0,8,0)
loop
GutsLand:
8H46 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H46 A 0 Radius_Quake(6,35,0,50,0)
8H46 A 0 A_PlaySoundEx("misc/hugequake","Body")
8H46 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE","SoundSlot5") //
8H46 AAA 2 A_GiveInventory("GutsBuddy_FloorQuake_P",1)
8H46 A 6
8H46 A 0 A_TakeInventory("BossItemUseFlag")
8H46 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
goto ReadyX
}
}


actor RussianGuts_W : BaseUnholyBossWep
{
Tag "$TAG_Boss047_W"
Obituary "%o lacked the muscle spirit \cvRussian \ccGutsman\c- (%k) has."
Inventory.Pickupmessage "\cjYou confiscated the guts!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H47 [ 1
wait

Deselect:
8H47 A 0
goto DeselectSwap
Select:
8H47 A 0
goto SelectSwap

Ready:
8H47 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H47 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, RUSSIANGUTS_DYE)
8H46 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H47 A 2 A_WeaponReady
loop

Fire:
8H47 A 1 Offset(8,66)A_JumpIfInventory("SuperArmTemp",1,"Throw")
8H47 A 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8H47 A 0 A_ScaleVelocity(0.85)
8H47 A 0 A_GiveInventory("SuperArmTemp")
8H47 A 0 ACS_NamedExecuteWithResult("uh_BossStackOn", 1)
8H47 B 2 Offset(-20,131)A_SpawnItemEx("RussianGutsRockLiftWarp",80,0,0,0,0,0,0,0)
8H47 B 2 Offset(-10,83)
8H47 B 4 A_WeaponReady(14)
8H47 B 6 ACS_NamedExecuteWithResult("uh_BossStackOff", 1)
goto FireWait
FireWait:
8H47 B 1 A_GiveInventory("IdleRussianGutsTempRock_PU")
loop
Throw:
8H47 A 0 A_JumpIfInventory("UnholyPower1500",1500,"SOVIETICWRATH")
8H47 A 0 A_FireCustomMissile("RussianGutsRock",0,1,0,56)
8H47 A 0 A_TakeInventory("SuperArmTemp")
8H47 C 2 Offset(80,-98)
8H47 C 2 Offset(9,-57)
8H47 C 2 Offset(-42,-17)
8H47 D 2 Offset(-62,56)
8H47 D 2 Offset(-84,79)
8H47 D 2 Offset(-100,107)
TNT1 AAAAAAA 2
8H47 A 2 Offset(6,92)
8H47 A 2 Offset(4,72)
8H47 A 2 Offset(2,52)
Goto ReadyX
TossUp:
8H47 A 0 A_FireCustomMissile("RussianGutsRockAlt",0,1,0,56)
8H47 A 0 A_TakeInventory("SuperArmTemp")
8H47 C 2 Offset(80,-98)
8H47 C 2 Offset(9,-57)
8H47 C 2 Offset(-42,-17)
8H47 D 2 Offset(-62,56)
8H47 D 2 Offset(-84,79)
8H47 D 2 Offset(-100,107)
TNT1 AAAA 2
8H47 A 2 Offset(6,92)
8H47 A 2 Offset(4,72)
Goto ReadyX

SOVIETICWRATH:
8H47 B 0 A_GiveInventory("VivifyDelay10")
8H47 B 0 A_PlaySoundEx("weapon/pchargelong","Weapon")
8H47 B 0 A_SpawnItemEx("TempRussianGutsWrathRock",0,0,76)
8H47 B 2 Offset(-3,16)A_SpawnItemEx("RussianGutsPowerFX_H")
8H47 B 2 Offset(-1,16)
8H47 B 2 Offset(1,16)
8H47 B 2 Offset(-1,16)
8H47 B 2 Offset(-4,16)
8H47 B 2 Offset(-1,16)
8H47 B 2 Offset(2,16)
8H47 B 2 Offset(-1,16)
8H47 B 2 Offset(-5,16)
8H47 B 2 Offset(-1,16)
8H47 B 2 Offset(3,16)
8H47 B 2 Offset(-1,16)
8H47 B 1 Offset(-6,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(4,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(-8,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(6,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(-15,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(13,16)
8H47 B 1 Offset(-1,16)
8H47 B 1 Offset(-15,16)
8H47 B 1 Offset(-1,16)A_GiveInventory("VivifyDelay4")
Goto HEUGH

HEUGH:
8H47 A 0 A_TakeInventory("UnholyPower1500")
8H47 A 0 A_PlaySoundEx("weapon/lightningbolt","Weapon")
8H47 A 0 A_FireCustomMissile("SovietWrathBoulder",0,1,0,56)
8H47 A 0 A_TakeInventory("SuperArmTemp")
8H47 C 1 Offset(80,-98)
8H47 C 1 Offset(9,-57)
8H47 C 1 Offset(-42,-17)
8H47 D 1 Offset(-62,56)
8H47 D 1 Offset(-84,79)
8H47 D 1 Offset(-100,107)
TNT1 A 30
8H47 A 2 Offset(6,92)
8H47 A 2 Offset(4,72)
8H47 A 2 Offset(2,52)
Goto ReadyX

Altfire:
8H47 A 0 A_JumpIfInventory("SuperArmTemp",1,"TossUp")
8H47 A 0 A_PlaySoundEx("Weapon/GutMelee","Weapon")
8H47 A 0 A_FireCustomMissile("RussianGutsPunch",0,0,0,0)
8H47 F 2 Offset(-28,8)
8H47 F 2 Offset(-56,-16)
8H47 E 2 Offset(-30,4)
8H47 E 2 Offset(-15,18)
8H47 E 2 A_WeaponReady(14)
8H47 EEEE 2
Goto ReadyX


Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 A_GiveInventory("GutsBuddyFlash_P")
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 1)
loop
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_RELOAD, "WorldWarLeapOne")
loop

WorldWarLeapOne:
TNT1 A 0 A_PlaySoundEx("weapon/superarmuse","Body")
TNT1 A 0 A_TakeInventory("UnholyBossAmmo200")
TNT1 A 0 ThrustThingZ(0,40,0,0)
TNT1 A 0 A_Recoil(-35)
TNT1 AA 2 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
WorldWarLeapTwo:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//10
TNT1 A 1 A_JumpIf(CallACS("core_checkfooting_thruplayer"), "ColdWarFall")
TNT1 A 0 A_PlaySoundEx("BUTTSCKS","Body")
TNT1 A 0 A_SpawnItemEx("RussianGutsContactDamage",0,0,0,momx,momy,momz,0,8,0)
loop
ColdWarFall:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOn", 1)
TNT1 A 0 Radius_Quake(6,35,0,50,0)
TNT1 A 0 A_PlaySound("misc/hugequake",4,0.6,0,ATTN_NORM)
TNT1 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE","SoundSlot5")
TNT1 A 0 A_FireCustomMissile("RussianGutsShockwaveLand",0,0,0,0)
TNT1 AAA 2 A_GiveInventory("RussianGuts_FloorQuake_P")
TNT1 AAA 2 A_JumpIfInventory("IsDead", 1, "NoFlash")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOff", 1)
TNT1 AAA 10 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//
goto Flash
}
}


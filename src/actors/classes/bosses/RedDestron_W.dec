actor RedDestron_W : PurpleDestron_W {
  Tag "$TAG_RedDestron_W"
  Obituary "%o can't defeat \cgRed Destron\c- (%k)."
  Inventory.Pickupmessage "\cgYou think the boss is bad? You guessed right. It's intended"
  // weapon.ammotype "UnholyBossAmmo200"
  States {
   Spawn:
    8L03 [ 1
    wait

   Ready:
    TNT1 A 3
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    TNT1 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    TNT1 A 1 A_WeaponReady(WRF_NOFIRE)
    TNT1 A 0 A_PlaySoundEx("TransformersNES/DestronShot", "weapon")
    TNT1 A 0 A_FireCustomMissile("DestronShotRed", 0, 0, 0)
    TNT1 A 67
    loop

   Flash:
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONRED_DYE0)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONRED_DYE1)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONRED_DYE0)
    TNT1 A 9 ACS_NamedExecuteWithResult("core_chargecolor", DESTRONRED_DYE2)
    loop
  }
}
actor DestronShotRed : BasicProjectile {
  Translation "192:192=217:217", "198:198=42:42"
  damagetype "RedDestron"
  Obituary "%o was shredded by \cgRed Destron\c- (%k)'s bullet."
  Damage (0)
  +SEEKERMISSILE
  +SCREENSEEKER
  +NOCLIP
  +NOINTERACTION
  radius 32
  height 32
  Speed 12
  scale 10
  reactiontime 140
  States {
   Spawn:
    8P70 A 1 A_Weave(4, 0, 16, 0)
    8P70 A 0 A_Explode(1000, 32, 0, 0, 32)
    8P70 A 1 A_Weave(4, 0, 16, 0)
    8P70 B 1 A_Weave(4, 0, 16, 0)
    8P70 B 0 A_Explode(1000, 32, 0, 0, 32)
    8P70 B 1 A_Weave(4, 0, 16, 0)
    8P70 A 0 A_SeekerMissile(0, 0, SMF_LOOK, 256, 6)
    8P70 A 0 A_JumpIf(CallACS("uh_PointerExists", 8), "See")
    8P70 A 0 A_Countdown
    loop
   See:
    8P70 A 0 A_ScaleVelocity(1.2)
    8P70 AB 2 A_SeekerMissile(90, 90, SMF_LOOK, 256, 6)
    Goto Flying
   Flying:
    8P70 ABAB 2 A_Explode(1000, 32, 0, 0, 32)
    8P70 A 0 A_SeekerMissile(1, 1, SMF_LOOK, 256, 1)
    8P70 A 0 A_Countdown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

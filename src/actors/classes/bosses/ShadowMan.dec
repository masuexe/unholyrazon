actor ShadowMan : BossBase  // TheShadowManMythBoss
{
player.scoreIcon "UB305MUG"
player.soundclass "Shadowman" //
player.forwardmove 1.4, 1.4 //
player.sidemove 1.4, 1.4 //
player.jumpz 16 //15
Player.MaxHealth 10000
Health 10000
player.morphweapon "ShadowMan_W"
/*
+THRUSPECIES
Species "ShadowmanHaha"
*/
States
{
Spawn:
SHAG A 0
SHAG B 1
SHAG A 1
Goto Spawn+2
See: //A_GiveInventory("ShadowBoss_ShadowStep",1)
SHAG B 3 A_GiveInventory("ShadowBoss_ShadowStep",1) //5
SHAG C 3 //5
SHAG D 3 A_GiveInventory("ShadowBoss_ShadowStep",1) //5
SHAG E 3 //5
Goto Spawn
Missile:
SHAG F 0 A_JumpIfInventory("ShadowBoss_FunnyTrail",1,"MissileSlide")
SHAG F 5 A_JumpIfInventory("VivifyDelay3",1,"Missile2")
SHAG G 4
goto Spawn+2
Missile2:
SHAG C 5
SHAG F 1 A_JumpIfInventory("VivifyDelay3",1,"Spawn")
wait
MissileSlide:
SHAG I 23 //
goto Spawn+2
ClassPain:
SHAG H 0
Goto MegamanPain
ClassDeath:
SHAG H 0
Goto MegamanDeath
}
}

actor BHRollingFlareShot : BasicProjectile {
  Translation "192:192=3:3", "198:198=5:5"
  damagetype "BlackDevilFire"
  Obituary "%o no longer exists due to \cmIncognito\c- (%k)."
  +FLOORHUGGER
  +DONTREFLECT
  Damage (50)
  Radius 16
  Height 16
  Speed 35
  Scale 5
  States {
   Spawn:
    TNT1 AA 0 A_SpawnItemEx("BHFaggassoTrail2", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    TNT1 A 1 A_SpawnItemEx("BHRollingFlareEffect", 0, 0, 0, 0, 0, 0, 0, 1)
    Loop
   Death:
    TNT1 AAAAAA 0 A_SpawnItemEx("BHFaggassoTrail3", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    TNT1 A 0 A_PlaySoundEx("wep_L/mm1/hyperbombexplode", "Weapon")
    TNT1 A 0 A_Explode(175, 200, 0)
    X_8B ABCDEF 2 Bright
    stop
  }
}

ACTOR BHVileFlareChaser : BasicExplosion {
  Translation "192:192=3:3", "198:198=5:5"
  var int user_T;
  +SEEKERMISSILE
  RenderStyle Translucent  // Add
  Alpha 0.75
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 0 A_SeekerMissile(0, 0, 3, 256, 6)
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("MM8BDMPlayer", 1, "Spawn0", AAPTR_TRACER)
    goto Spawn1
   Spawn0:
    6P10 A 0 A_PlaySoundEx("weapon/firestorm", "Weapon")
    6P10 A 2 Bright A_Fire(8)
    6P10 BBC 2 Bright A_Fire(8)
    6P10 A 0 A_PlaySoundEx("wep_L/atomicfire", "Body")
    6P10 C 2 Bright A_Fire(8)
    6P10 AAABBBCCCDDDD 2 Bright A_Fire(8)
    6P10 A 0 A_PlaySoundEx("wep_L/atomicfire", "Weapon")
    6P10 A 2 Bright A_Fire(8)
    6P10 AABBBCCCDDD 2 Bright A_Fire(8)
    6P10 A 0 A_SetUserVar("user_T", CallACS("core_getptrtid", 8))
    6P10 A 0 Thing_Move(0, user_T, 1)
    6P10 A 1 A_ChangeVelocity(0, 0, 32, 3)
    6P10 A 0 A_Stop
    6P10 A 0 bright A_JumpIfTargetInLOS("Spawn2")  // ,0,JLOSF_DEADNOJUMP
    6P10 AABBCCDD 1 A_FadeOut(0.05)
    stop
   Spawn1:
    6P10 A 2 A_PlaySoundEx("TetrisU/Menu1", "Weapon")
    TNT1 A 2
    6P10 B 2
    TNT1 A 2
    6P10 C 2
    TNT1 A 2
    6P10 D 2
    TNT1 A 2 A_GiveToTarget("UnholyBossAmmo200", 100)
    stop
   Spawn2:
    TNT1 A 0 Thing_Move(0, user_T, 1)
    TNT1 A 6 A_SpawnItemEx("BHVileFlareChaserBoom", 0, 0, 28, 0, 0, 0, 0, 1)
    stop
  }
}

actor BHVileFlareChaserBoom : BasicExplosion {
  damagetype "BlackDevilFire"
  Obituary "%o no longer exists due to \cmIncognito\c- (%k)."
  Scale 3.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Weapon")
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Body")
    TNT1 A 0 A_Explode(500, 196, 0, 0, 64)
    TNT1 A 0
    TNT1 AAAA 0 A_SpawnItemEx("BHFaggassoTrail2", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    TNT1 AAAA 0 A_SpawnItemEx("BHFaggassoTrail4", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    X_8B ABCDEF 2 Bright
    stop
  }
}


actor BHDuplicateRisingUpper : BasicProjectile {
  Translation "192:192=3:3", "198:198=5:5"
  damagetype "BlackDevilFire"
  Obituary "%o no longer exists due to \cmIncognito\c- (%k)."
  // Obituary "%o was KO'D by \chDevileye's\c- Flare Upper!"
  +RIPPER
  renderstyle "Translucent"
  alpha 0.75
  damage (50)
  Radius 5
  Height 5
  speed 30
  States {
   Spawn:
    TNT1 A 0
    TMFX A 1 A_Explode(85, 65, 0)
    TNT1 A 0 A_SpawnItemEx("BHFaggassoTrail3", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    TMFX B 1 A_Explode(85, 65, 0)
    TNT1 A 0 A_SpawnItemEx("BHFaggassoTrail2", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    TMFX C 1 A_Explode(85, 65, 0)
    TNT1 A 0 A_SpawnItemEx("BHFaggassoTrail1", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    TMFX D 1 A_Explode(85, 65, 0)
    stop
  }
}


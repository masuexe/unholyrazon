actor BlackDevilEye_W_NormalBar : NormalBar {args 212, 5}
actor BlackDevilEye_W_SecondBar : SecondBar {args 248, 41}
actor BlackDevilEye_W : BaseUnholyBossWep {
  Tag "$TAG_Boss509_W"
  Obituary "%o no longer exists due to \cmIncognito\c- (%k)."
  Inventory.Pickupmessage "\cmFATE."
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo100"
  States {
   Spawn:
    9H09 [ 1
    wait

   Deselect:
    9H09 A 0
    goto DeselectSwap
   Select:
    9H09 A 0
    goto SelectSwap

   Ready:
    9H09 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLACKDEVILEYE_DYE)
    9H09 A 6
    goto ReadyX
   ReadyX:
    9H09 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "ReadyX2")
    9H09 A 2 A_GiveInventory("BlackDevilEye_Ready8_P")
    loop
   ReadyX2:
    9H09 A 2 A_GiveInventory("BlackDevilEye_Ready0_P")
    loop

   Reload:
    9H09 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "FlareChaser")
    goto ReadyX
   FlareChaser:
    9H09 A 0 A_FireCustomMissile("BHVileFlareChaser", 0, 0, 0, 0)
    9H09 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    9H09 A 2
    goto ReadyX

   Fire:
    9H09 B 0 A_PlaySoundEx("weapon/firestorm", "Weapon")
    9H09 B 0 A_FireCustomMissile("BlackHatFlareShotDuplicate", 0, 0, 8, 0)
    9H09 BCAAAAA 5 A_GiveInventory("BlackDevilEyeAmmoItem")
    Goto ReadyX
   AltFire:
    9H09 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "CheapDevilUppercut")
    Goto ReadyX
   CheapDevilUppercut:
    9H09 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    9H09 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    9H09 B 0 A_Recoil(-25)
    9H09 B 0 ThrustThingZ(0, 25, 0, 0)
    9H09 B 0 A_SpawnItemEx("BHFaggassoWind", 0, 0, -50)
    9H09 B 3
    9H09 C 0 A_PlaySoundEx("weapon/FlamingUpper", "Weapon")
    9H09 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    9H09 B 0 ThrustThingZ(0, 75, 0, 0)
    9H09 B 0 A_SpawnItemEx("BHFaggassoWind", 0, 0, -50)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 0 A_SpawnItemEx("BHFaggassoWind", 0, 0, -50)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 0 A_SpawnItemEx("BHFaggassoWind", 0, 0, -50)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 B 1 A_FireCustomMissile("BHDuplicateRisingUpper", 0, 0, 8, 0)
    9H09 B 0 A_SetAngle(angle-20.0)
    9H09 AA 3 A_GiveInventory("UnholyBossAmmo200", 4)
    9H09 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    9H09 AA 3 A_GiveInventory("UnholyBossAmmo200", 4)
    9H09 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    9H09 AAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 4)
    goto ReadyX
  }
}

actor BlackDevilEye_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo100", 3)
    stop
  }
}
actor BlackDevilEye_Ready8_P : BlackDevilEye_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor BlackDevilEyeAmmoItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo100", 3)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    stop
  }
}


actor BlackHatFlareShotDuplicate : BasicProjectile {
  Translation "192:192=3:3", "198:198=5:5"
  damagetype "BlackDevilFire"
  Obituary "%o no longer exists due to \cmIncognito\c- (%k)."
  +SKYEXPLODE
  +EXPLODEONWATER
  renderstyle "Translucent"
  alpha 0.8
  Damage (175)
  Radius 20
  Height 20
  speed 54
  scale 3.5
  States {
   Spawn:
    6P50 U 2  // Bright
    6P50 VVVV 0 A_SpawnItemEx("BHFaggassoTrail2", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    6P50 V 2
    6P50 WWWW 0 A_SpawnItemEx("BHFaggassoTrail1", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    6P50 W 2
    6P50 UUUU 0 A_SpawnItemEx("BHFaggassoTrail1", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 AAAA 0 A_SpawnItemEx("BHFaggassoTrail2", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    TNT1 AAAAAA 0 A_SpawnItemEx("BHFaggassoTrail3", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 1)
    TNT1 A 0 A_PlaySoundEx("wep_L/mm1/hyperbombexplode", "Weapon")
    TNT1 A 0 A_Explode(315, 160, 0, 0, 20)
    X_8B ABCDEF 2
    stop
  }
}


actor BHFaggassoTrail1 : BasicGraphicEffect {
  Translation "192:192=3:3", "198:198=5:5"
  +FORCEXYBILLBOARD
  alpha 0.85
  radius 6
  height 6
  scale 4.5
  States {
   SpawnFrame:
    X_8C EEFFG 2 A_Fadeout
    stop
  }
}

actor BHFaggassoTrail2 : BHFaggassoTrail1 {
  States {
   SpawnFrame:
    X_8C AAABBCCDD 3 A_Fadeout
    stop
  }
}



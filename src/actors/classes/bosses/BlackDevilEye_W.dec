    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
    X_BG D 2 Bright A_Fadeout
    TNT1 A 1 A_SpawnItemEx("BHFaggassoTrail1", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    X_BG C 2 Bright A_Fadeout
    TNT1 A 1 A_SpawnItemEx("BHFaggassoTrail1", random(-3, 3), random(-3, 3), random(-3, 3), random(5, 15), random(5, 15), random(-15, 15), random(0, 359), 1)
    X_BG B 2 Bright A_Fadeout

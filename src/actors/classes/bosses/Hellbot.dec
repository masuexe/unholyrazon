actor HellBot : BossBase {
  Player.ScoreIcon "UB100MUG"
  Player.SoundClass "hellbot"
  Player.DamageScreenColor "Red"
  Player.ForwardMove 1.35, 1.35
  Player.SideMove 1.35, 1.35
  Player.JumpZ 16
  Player.MaxHealth 6666
  Health 6666
  DamageFactor "UnholyWater", 10.0
  DamageFactor "UnholyWaterB", 10.0
  Player.MorphWeapon "HellBot_W"
  States {
   Spawn:
    8A08 A 0
    8A08 B 1
    8A08 A 1
    goto Spawn+2
   See:
    8A08 BCDE 5
    goto Spawn
   Missile:
    8A08 F 5
    8A08 G 4
    goto Spawn+2
   ClassPain:
    8A08 H 0
    goto MegamanPain
   ClassDeath:
    8A08 H 0
    goto MegamanDeath
    // ClassPain:
    // 8A08 H 0
    // 8A08 H 20 //A_TakeInventory("JellyJellyJellyPower",1)
    // Goto Spawn
    // Goto MegamanPain
    // /*
    // Death.UnholyWater:Death.MountainDew:
    // 8A08 H 0 SetPlayerProperty(0, 0, 4)
    // 8A08 H 0 A_TakeInventory("WeaponCharge",999)
    // 8A08 H 0 A_NoBlocking
    // 8A08 H 0 A_GiveInventory("CutterFlag",999)
    // 8A08 H 0 A_GiveInventory("IsDead",1)
    // 8A08 H 0 A_SetTranslucent (0.0, 0)
    // 8A08 H 0 A_GiveToTarget("KilledMe",1)
    // 8A08 H 0 ACS_ExecuteAlways(999,0,0)
    // 8A08 H 0 A_SpawnItemEx("HellBotIceStatue",0,0,0,velx,vely,velz,0,SXF_ABSOLUTEMOMENTUM)
    // 8A08 H 0 SetPlayerProperty(0, 0, 4)
    // 8A08 H 0 A_Jump(256,"ClassDeath")
    // Goto ClassDeath
    // */
    // ClassDeath:
    // 8A08 H 18 //ACS_NamedExecuteAlways("ub_InitiateUltraBoss",0,400)
    // 8A08 H 0
    // 8A08 H 0
    // Goto MegaDeathEnd
  }
}

actor HellBotIceStatue {
  Radius 16
  Height 56
  Health 1
  Scale 2.5
  +SOLID
  Translation "192:192=4:4", "198:198=201:201", "3:8=72:72", "243:247=72:72", "208:208=72:72", "38:47=72:72"
  States {
   Spawn:
    8A08 H 35
    8A08 H 0 A_ChangeFlag("SHOOTABLE", 1)
    8A08 H 1
    goto Spawn+2
   Death:
    TNT1 A 1 A_SpawnItemEx("FrozenDeathFX", 0, 0, 16)
    stop
  }
}

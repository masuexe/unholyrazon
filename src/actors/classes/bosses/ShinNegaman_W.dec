actor ShinNegaman_W_NormalBar : NormalBar {args 62, 79}
actor ShinNegaman_W_ReloadIcon : ReloadIcon {}

actor ShinNegaman_W : BaseUnholyBossWep {
  Tag "$TAG_ShinNegaman_W"
  Obituary "%o was negated by \cmShin \ctNegaman\c- (%k)'s \ctNega Buster\c-."
  Weapon.AmmoType "MightyNegaDuckAmmo"
  inventory.pickupsound "weapon/weaponup"
  States {
   Spawn:
    8H21 [ 1
    wait

   Deselect:
    8H21 A 0
    goto DeselectSwap
   Select:
    8H21 A 0
    goto SelectSwap

   Ready:
    8H21 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, SHINNEGAMAN_DYE)
    8H21 A 1  // Initial setup: boss morph hook.
    goto ReadyX
   ReadyX:
    8H21 A 0 A_JumpIfInventory("MightyNegaDuckAmmo", 300, "ReadyX_16")
    8H21 A 2 A_WeaponReady
    8H21 A 0 A_GiveInventory("MightyNegaDuckAmmo", 6)
    loop
   ReadyX_16:
    8H21 A 2 A_WeaponReady(16)
    8H21 A 0 A_GiveInventory("MightyNegaDuckAmmo", 6)
    goto ReadyX

   Fire:
    8H21 A 0 A_JumpIfInventory("IsPissedFlag", 1, 2)
    // 8H21 A 0 A_JumpIfHealthLower(1500,"GetHypedForPain")
    8H21 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.25 + 1, "GetHypedForPain")
    8H21 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H21 A 0 A_FireCustomMissile("ShinNegaPelletShot", 0, 0, 8, 0)
    8H21 CCBBA 1 A_GiveInventory("MightyNegaDuckAmmo", 3)
    goto ReadyX

   Reload:
    8H21 A 0 A_JumpIfInventory("MightyNegaDuckAmmo", 300, "RandomizeSelection")
    goto ReadyX
   RandomizeSelection:
    8H21 A 0 A_JumpIf(true, "CopyAttack4")  // debug, remove later
    8H21 A 0 A_TakeInventory("MightyNegaDuckAmmo")
    8H21 A 0 A_JumpIfInventory("IsPissedFlag", 1, "RandomizeSelection2")
    8H21 A 0 A_Jump(256, "CopyAttack1", "CopyAttack2", "CopyAttack3", "CopyAttack4", "CopyAttack5", "CopyAttack6")
    8H21 CBA 2
    goto ReadyX
   RandomizeSelection2:
    8H21 A 0 A_Jump(128, "DeadlyAttack1", "DeadlyAttack2")
    8H21 A 0 A_Jump(256, "CopyAttack1", "CopyAttack2", "CopyAttack3", "CopyAttack4", "CopyAttack5", "CopyAttack6")
    8H21 CBA 2
    goto ReadyX

   Altfire:
    8H21 A 0 A_JumpIf(CallACS("core_checkfooting"), "UpRiseKick")
    goto ReadyX
   UpRiseKick:
    8H21 A 0 A_GiveInventory("SlideVivifyFlag")
    8H21 A 0 A_ReFire(1)
    8H21 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8H21 A 0 A_PlaySoundEx("weapon/chargekick", "Weapon")
    8H21 A 0 A_Recoil(-50)
    8H21 A 0 ThrustThingZ(0, 70, 0, 0)
    8H21 A 0 A_JumpIfInventory("IsPissedFlag", 1, 2)
    8H21 A 0 A_GunFlash("FlashKick")
    goto UpRiseKick2
    8H21 A 0 A_GunFlash("FlashKick2")
    goto UpRiseKick2
   UpRiseKick2:  // 18tic
    8H21 A 1 Offset(8, 40)  // no feet
    8H21 A 1 Offset(16, 48) A_FireCustomMissile("NegaSlideKicker", 0, 0, 0, 0)  // feet start
    8H21 A 1 Offset(24, 56) A_FireCustomMissile("NegaSlideKicker", 0, 0, 0, 0)
    8H21 A 1 Offset(40, 72) A_FireCustomMissile("NegaSlideKicker", 0, 0, 0, 0)
    8H21 A 1 Offset(56, 88) A_FireCustomMissile("NegaSlideKicker", 0, 0, 0, 0)
    8H21 A 1 Offset(74, 104) A_FireCustomMissile("NegaSlideKicker", 0, 0, 0, 0)
    8H21 A 1 Offset(74, 102)
    8H21 A 5 Offset(70, 104) ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)  // 5
    8H21 A 1 Offset(70, 102)
    8H21 A 3 Offset(54, 86)
    8H21 A 2 Offset(38, 70)
    8H21 A 2 Offset(22, 54)
    8H21 A 1 Offset(14, 46)
    8H21 A 1 Offset(6, 38) A_TakeInventory("SlideVivifyFlag")  // no feet
    goto ReadyX

   FlashKick:
    TNT1 A 1
    8S21 A 1
    8S21 B 1
    8S21 C 1
    8S21 D 1
    8S21 E 8
    8S21 D 3
    8S21 C 2
    8S21 B 2
    8S21 A 1
    stop
   FlashKick2:
    TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", SHINNEGAMAN_DYE)
    8S21 A 1
    8S21 B 1
    8S21 C 1
    8S21 D 1
    8S21 E 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
    8S21 E 3
    8S21 D 2
    8S21 D 1 ACS_NamedExecuteWithResult("core_chargecolor", SHINNEGAMAN_DYE)
    8S21 C 2
    8S21 B 2
    8S21 A 1
    TNT1 A 1 A_GunFlash
    stop

   GetHypedForPain:
    8H21 A 0 A_PlaySound("weapon/mirrorabsorb")
    8H21 A 0 A_GunFlash
    8H21 A 0 A_GiveInventory("ShieldCheck")
    8H21 B 5
    goto NotGivingUp
   Flash:
    TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
    TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", SHINNEGAMAN_DYE)
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    loop
   NotGivingUp:
    8H21 C 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    // 8H21 C 0 A_ChangeFlag("INVULNERABLE",1)//Translation "192:192=78:78", "193:198=77:77"
   NotGivingUpLoop:
    8H21 C 1 A_SpawnItemEx("NegaSkullBarrierWarper", 0, 0, 28, 0, 0, 0, 0, 1)
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    8H21 C 1
    8H21 C 0 A_GiveInventory("ShinNegamanHealthGiver")
    8H21 C 0 A_JumpIfInventory("IsPissedFlag", 1, "GaveUp")
    loop
   GaveUp:
    8H21 B 1 A_TakeInventory("ShieldCheck")
    8H21 B 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    goto ReadyX
   CopyAttack1:
    8H21 A 1 Offset(-4, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(-12, 14) A_FireCustomMissile("ShinNegaRollingCutter", 10, 0, 8, 0)
    8H21 C 1 Offset(-14, 8) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 C 1 Offset(-10, 14)
    8H21 B 1 Offset(-6, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(-2, 28)
    8H21 A 0 A_WeaponReady(14)
    8H21 A 1 Offset(0, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(0, 10) A_FireCustomMissile("ShinNegaRollingCutter", 0, 0, 8, 0)
    8H21 C 1 Offset(0, 4) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 C 1 Offset(0, 10)
    8H21 B 1 Offset(0, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(0, 28)
    8H21 A 1 Offset(4, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(12, 14) A_FireCustomMissile("ShinNegaRollingCutter", -10, 1, 8, 0)
    8H21 C 1 Offset(14, 8) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 C 1 Offset(10, 14)
    8H21 B 2 Offset(6, 22)
    8H21 B 2 Offset(3, 28)
    8H21 A 6 Offset(2, 34)
    goto ReadyX
   CopyAttack2:
    8H21 A 0 A_Recoil(-40)
    8H21 A 1 Offset(-6, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 B 1 Offset(-14, 44)
    8H21 B 1 Offset(-20, 52)
    8H21 A 0 A_WeaponReady(14)
    8H21 A 0 A_PlaySoundEx("assists/reggaecandrop", "Weapon")
    8H21 A 0 A_PlaySoundEx("weapons/mm2/crashbombfire", "SoundSlot5")
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, 45, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, 90, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, 135, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, -45, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, -90, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, -135, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, 0, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 10, 0, 10, 180, 0, 0)
    8H21 A 0 A_SpawnItemEx("ShinNegaCrashBomb", 0, 0, 8, 0, 0, 10, 0, 0, 0)
    8H21 C 1 Offset(0, 16) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 C 1 Offset(0, 8)
    8H21 C 1 Offset(6, 26)
    8H21 B 2 Offset(16, 46)
    8H21 B 2 Offset(22, 58)
    8H21 B 2 Offset(16, 50)
    8H21 A 2 Offset(8, 42)
    8H21 A 2 Offset(4, 36)
    8H21 A 2 A_WeaponReady(14)
    goto ReadyX
   CopyAttack3:
    8H21 B 2 Offset(4, 36)
    8H21 C 2 Offset(6, 40)
    8H21 B 2 Offset(10, 44)
    8H21 C 2 Offset(12, 46)
    8H21 A 0 A_PlaySoundEx("weapons/mm3/hardknucklelaunch", "Weapon")
    8H21 A 0 A_SpawnItemEx("ShinNegaHardKnuckleFX", -1, 8, 32, 0, 0, 0)
    8H21 B 0 A_FireCustomMissile("ShinNegaHardKnuckle", 0, 1, 10, -2)
    8H21 B 0 A_Recoil(15)
    8H21 C 1 Offset(6, 16) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H21 C 1 Offset(8, 10)
    8H21 C 1 Offset(16, 26)
    8H21 B 2 Offset(28, 46)
    8H21 B 2 Offset(44, 62)
    8H21 B 2 Offset(38, 56)
    8H21 B 2 Offset(22, 44)
    8H21 A 2 Offset(10, 36)
    8H21 A 2 A_WeaponReady(14)
    goto ReadyX
   CopyAttack4:
    // Shot 1: Center (0°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, 0, 0)
    8H21 C 2 Offset(0, 18)
    8H21 B 2 Offset(0, 26)
    // Shot 2: Left (-16°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, -16, 2)
    8H21 C 2 Offset(-12, 16)
    8H21 B 2 Offset(-8, 25)
    // Shot 3: Right (+16°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, 16, 2)
    8H21 C 2 Offset(12, 16)
    8H21 B 2 Offset(8, 25)
    // Shot 4: Mid-Left (-32°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, -32, 4)
    8H21 C 2 Offset(-24, 14)
    8H21 B 2 Offset(-18, 24)
    // Shot 5: Mid-Right (+32°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, 32, 4)
    8H21 C 2 Offset(24, 14)
    8H21 B 2 Offset(18, 24)
    // Shot 6: Wide-Left (-60°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, -60, 6)
    8H21 C 2 Offset(-36, 12)
    8H21 B 2 Offset(-28, 23)
    // Shot 7: Wide-Right (+60°)
    8H21 B 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8H21 B 0 A_SpawnItemEx("ShinNegaDiveSpread", 0, 0, 32, 15, 60, 6)
    8H21 C 2 Offset(36, 12)
    // Final Heavy Recoil & Recovery (Plan B)
    8H21 C 2 Offset(42, 28)
    8H21 B 2 Offset(30, 42)
    8H21 B 2 Offset(16, 38)
    8H21 A 2 Offset(6, 34)
    8H21 A 2 A_WeaponReady(14)
    goto ReadyX
   CopyAttack5:
    8H21 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk1", 12, 0, 0, 0)
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk2", 7, 0, 0, 0)
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk1", 2, 0, 0, 0)
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk2", -2, 0, 0, 0)
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk1", -7, 0, 0, 0)
    8H21 C 0 A_FireCustomMissile("ShinNegaTomahawk2", -12, 0, 0, 0)
    8H21 BCBAA 2
    goto ReadyX
   CopyAttack6:
    8H21 B 0
    8H21 B 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire", "Weapon")
    8H21 B 0 A_FireCustomMissile("ShinNegaFreezeCracker", 0, 0, 8, 0)
    8H21 B 0 A_FireCustomMissile("ShinNegaFreezeCracker", random(-7, -5), 0, 8, 0)
    8H21 B 0 A_FireCustomMissile("ShinNegaFreezeCracker", random(5, 7), 0, 8, 0)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield1", 48, 0, 34)
    8H21 B 1 A_SpawnItemEx("ShinNegaFreezeShield2", -38, -22, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield3", 22, 38, 34)
    8H21 B 1 A_SpawnItemEx("ShinNegaFreezeShield1", -48, 0, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield2", -22, 38, 34)
    8H21 C 1 A_SpawnItemEx("ShinNegaFreezeShield3", -22, -38, 34)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield1", 0, 48, 34)
    8H21 C 1 A_SpawnItemEx("ShinNegaFreezeShield2", 22, -38, 34)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield3", -38, 22, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield1", 0, -48, 34)
    8H21 B 1 A_SpawnItemEx("ShinNegaFreezeShield2", 38, 22, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield3", 38, -22, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield1", 48, 0, 34)
    8H21 C 1 A_SpawnItemEx("ShinNegaFreezeShield2", -38, -22, 34)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield3", 22, 38, 34)
    8H21 C 1 A_SpawnItemEx("ShinNegaFreezeShield1", -48, 0, 34)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield2", -22, 38, 34)
    8H21 B 1 A_SpawnItemEx("ShinNegaFreezeShield3", -22, -38, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield1", 0, 48, 34)
    8H21 B 1 A_SpawnItemEx("ShinNegaFreezeShield2", 22, -38, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield3", -38, 22, 34)
    8H21 B 0 A_SpawnItemEx("ShinNegaFreezeShield1", 0, -48, 34)
    8H21 C 1 A_SpawnItemEx("ShinNegaFreezeShield2", 38, 22, 34)
    8H21 C 0 A_SpawnItemEx("ShinNegaFreezeShield3", 38, -22, 34)
    8H21 CBAA 3
    goto ReadyX
   DeadlyAttack1:
    8H21 A 0
    8H21 ABC 3  // A_FireCustomMissile("NegaAstroWave",0,1,0,0)
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 C 3
    8H21 B 3 A_SpawnItemEx("NegaAstroWave", 0, 0, 8, 20)
    8H21 CBAA 3
    goto ReadyX
   DeadlyAttack2:
    // 8H21 D 16 A_PlaySoundEx("weapon/mirrorabsorb","Weapon")
    8H21 D 2 Offset(160, -40) A_PlaySoundEx("weapon/mirrorabsorb", "Weapon")
    8H21 D 2 Offset(140, -31)
    8H21 D 2 Offset(120, -22)
    8H21 D 2 Offset(100, -13)
    8H21 D 2 Offset(80, -4)
    8H21 D 2 Offset(60, 5)
    8H21 D 2 Offset(40, 14)
    8H21 D 2 Offset(20, 23)

    8H21 E 2 Offset(1, 31)
    8H21 F 0 A_PlaySoundEx("weapon/atomicfire", "Weapon")
    8H21 F 2 A_SpawnItemEx("ShinNegaFlameSwing1", 0, 0, 28, cos(-pitch), 0, sin(-pitch), 0, 0)
    8H21 GHI 2
    TNT1 A 4
    8H21 J 2
    8H21 K 0 A_PlaySoundEx("weapon/atomicfire", "Weapon")
    8H21 K 2 A_SpawnItemEx("ShinNegaFlameSwing2", 0, 0, 28, cos(-pitch), 0, sin(-pitch), 0, 0)
    8H21 LMN 2
    TNT1 A 4
    8H21 A 2 Offset(0, 92)
    8H21 A 2 Offset(0, 72)
    8H21 A 2 Offset(0, 52)
    goto ReadyX
   NoAmmo:
    8H21 A 1
    goto ReadyX
    /// /////////
  }
}

actor MightyNegaDuckAmmo : Ammo {
  Inventory.MaxAmount 300
  +INVENTORY.IGNORESKILL
}

actor ShinNegamanHealthGiver : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("ShinNegaBarrierDamage", 0, 0, 28, velx, vely, velz, 0, 8)
    TNT1 A 0 A_Recoil(-1)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.50, "GiveHealth")
    goto Pickup3
   GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 10)
    stop
   Pickup3:
    TNT1 A 0 A_GiveInventory("IsPissedFlag")
    stop
  }
}

actor ShinNegaPelletShot : BasicProjectile {
  Translation "4:4=62:62", "198:198=79:79"
  DamageType "ShinNega"
  Obituary "%o was negated by \cmShin \ctNegaman\c- (%k)'s \ctNega Buster\c-."
  Damage (random(35, 65))
  Speed 60
  Radius 6
  Height 6
  Scale 2.5
  States {
   Spawn:
    TNT1 A 1
    X_0D A 1
    wait
   Crash:
    TNT1 A 0 A_GiveToTarget("MightyNegaDuckAmmo", 15)
   Death:
    X_0D A 1
    stop
  }
}

actor NegaSlideKicker : BasicProjectile {
  Translation "192:192=79:79", "198:198=62:62"
  Obituary "%o went poof by \cmShin \ctNegaman\c- (%k)'s \ctNega-UpperRise Kick\c-."  // was in range
  DamageType "ShinNega"
  Damage (random(125, 205))
  Radius 14
  Height 25
  Speed 60
  Scale 2.5
  States {
   Spawn:
    X_5F D 0
    X_5F DEF 2
    stop
  }
}

actor ShinNegaRollingCutter : BasicProjectile {
  Translation "192:192=62:62", "198:198=79:79"
  DamageType "ShinNega"
  Obituary "%o was sliced and diced by \cmShin \ctNegaman\c- (%k)'s \ctNega Rolling Cutter\c-."
  +DONTBLAST
  +RIPPER
  -NOGRAVITY
  +DOOMBOUNCE
  +CANBOUNCEWATER
  BounceCount 10
  BounceFactor 0.92
  Damage (125)
  Radius 20
  Height 20
  Speed 20
  Scale 2.5
  States {
   Spawn:
    X_1A A 0
    X_1A A 0 ThrustThingZ(0, 45, 0, 1)
    X_1A A 0 A_PlaySound("wep_L/mm1/rollingcutterfly")
    X_1A ABCD 2
    goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_SetGravity(0.0)
    TMFX ABCD 2
    stop
  }
}

actor ShinNegaCrashBomb : BasicProjectile {
  Translation "192:192=62:62", "198:198=79:79"
  DamageType "ShinNega"
  Obituary "%o was broken by \cmShin \ctNegaman\c- (%k)'s \ctNega Crash Bomb\c-."
  -NOGRAVITY
  Damage (10)
  Radius 8
  Height 8
  Speed 40
  Scale 3.0
  States {
   Spawn:
    X_2E E 1
    loop
   Death:
    X_2E E 0
    X_2E E 0 A_PlaySound("weapon/crashexplode")

actor NegarAstrorCrushr : BasicProjectile {
  Translation "192:192=229:229", "198:198=79:79"
  DamageType "ShinNega"
  Obituary "%o got hurt and collapsed due to \cmShin \ctNegaman\c- (%k)'s \ctNega Astro Crush\c-."
  +RIPPER
  +NOINTERACTION
  +DONTBLAST
  Damage (0)
  Height 8
  Radius 16
  Scale 2.5
  ReactionTime 10
  States {
   Spawn:
    X_8B B 0
    X_8B B 0 A_ChangeVelocity(11, 0, velz, 3)
    X_8B GGGHHHIII 1 A_JumpIf(ceilingz - z > 8, "Spawn2")
    X_8B B 0 A_JumpIf(velz == 0, "Death")
    X_8B B 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B B 0 A_ChangeFlag("RIPPER", 0)
    X_8B B 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B GHI 3 A_ChangeVelocity(11, 0, velz, 3)
    X_8B B 0 A_JumpIf(velz == 0, "Death")
    X_8B B 0 A_CountDown
    goto Spawn2+2
   Death:
    X_8B A 0 A_PlaySoundEx("weapons/mm8/astrocrushexplode", "Weapon")
    X_8B A 0  // A_SetGravity(0.0)
    X_8B A 0 A_Explode(250, 128, 0)
    X_8B ABCDEF 2
    stop
  }
}


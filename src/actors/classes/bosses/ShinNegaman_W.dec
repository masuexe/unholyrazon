actor MightyNegaDuckAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor ShinNegamanHealthGiver : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("ShinNegaBarrierDamage",0,0,28,momx,momy,momz,0,8)
TNT1 A 0 A_Recoil(-1)
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH) * 0.50, "GiveHealth")
goto Pickup3
GiveHealth:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 10)
stop
Pickup3:
TNT1 A 0 A_GiveInventory("IsPissedFlag")
stop
}
}


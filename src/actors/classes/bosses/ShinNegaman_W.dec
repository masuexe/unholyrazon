actor ShinNegaman_W_NormalBar : NormalBar {args 62, 79}

actor ShinNegaman_W : BaseUnholyBossWep
{
Tag "$TAG_Boss021_W"
Obituary "%o was negated by \cmShin \ctNegaman\c- (%k)'s \ctNega Buster\c-."
weapon.ammotype "MightyNegaDuckAmmo"
inventory.pickupsound "weapon/weaponup"
States
{
Spawn:
8H21 [ 1
wait

Deselect:
8H21 A 0
goto DeselectSwap
Select:
8H21 A 0
goto SelectSwap

Ready:
8H21 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SHINNEGAMAN_DYE)
8H21 A 1 A_TakeInventory("IsPissedFlag")
goto ReadyX
ReadyX:
8H21 A 0 A_JumpIfInventory("MightyNegaDuckAmmo", 300, "ReadyX_16")
8H21 A 2 A_WeaponReady
8H21 A 0 A_GiveInventory("MightyNegaDuckAmmo",6)
loop
ReadyX_16:
8H21 A 2 A_WeaponReady(16)
8H21 A 0 A_GiveInventory("MightyNegaDuckAmmo",6)
goto ReadyX

Fire:
8H21 A 0 A_JumpIfInventory("IsPissedFlag",1,2)
//8H21 A 0 A_JumpIfHealthLower(1500,"GetHypedForPain")
8H21 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.25+1,"GetHypedForPain")
8H21 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H21 A 0 A_FireCustomMissile("ShinNegaPelletShot",0,0,8,0)
8H21 CCBBA 1 A_GiveInventory("MightyNegaDuckAmmo",3)
goto ReadyX

Reload:
8H21 A 0 A_JumpIfInventory("MightyNegaDuckAmmo", 300, "RandomizeSelection")
goto ReadyX
RandomizeSelection:
8H21 A 0 A_TakeInventory("MightyNegaDuckAmmo",300)
8H21 A 0 A_JumpIfInventory("IsPissedFlag",1,"RandomizeSelection2")
8H21 A 0 A_Jump(256, "CopyAttack1", "CopyAttack2", "CopyAttack3", "CopyAttack4", "CopyAttack5", "CopyAttack6")
8H21 CBA 2
goto ReadyX
RandomizeSelection2:
8H21 A 0 A_Jump(128,"DeadlyAttack1", "DeadlyAttack2")
8H21 A 0 A_Jump(256,"CopyAttack1", "CopyAttack2", "CopyAttack3", "CopyAttack4", "CopyAttack5", "CopyAttack6")
8H21 CBA 2
Goto ReadyX

Altfire:
8H21 A 0 A_JumpIf(CallACS("core_checkfooting"), "UpRiseKick")
goto ReadyX
UpRiseKick:
8H21 A 0 A_GiveInventory("SlideVivifyFlag")

actor KakusaretaSutoka : BossBase {
  Player.ScoreIcon "UB005MUG"
  Player.SoundClass "KakusaretaSutoka"
  Player.ForwardMove 1.45, 1.45
  Player.SideMove 1.45, 1.45
  Player.JumpZ 14
  Player.MaxHealth 2100
  Health 2100
  Player.MorphWeapon "KakusaretaSutoka_W"
  Player.WeaponSlot 1, "KakusaretaSutoka_W"
  Player.WeaponSlot 2, "KakusaretaSutoka_W2"
  Player.WeaponSlot 3, "KakusaretaSutoka_W3"
  States {
   Spawn:
    SHAM A 0
    SHAM B 1
    SHAM A 1
    goto Spawn+2
   See:
    SHAM BCDE 5
    goto Spawn
   Missile:
    SHAM F 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileMain1")
    SHAM F 0 A_JumpIfInventory("VivifyFlag2", 1, "MissileMain2")
    // SHAM F 0 A_JumpIfInventory("VivifyFlag3", 1, "MissileMain3")
    // SHAM F 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileAlt1")
    SHAM F 0 A_JumpIfInventory("VivifyDelay5", 1, "MissileAlt2")
    SHAM F 0 A_JumpIfInventory("VivifyDelay6", 1, "MissileAlt3")
    SHAM F 5
    SHAM G 4
    goto Spawn+2
   MissileMain1:
    SHAM FGFGFG 3
    goto Spawn+2
   MissileMain2:
    SHAM F 6
    SHAM F 10
    SHAM G 10
    goto Spawn+2
   MissileAlt2:
    SHAM F 39
    SHAM G 5
    goto Spawn+2
   MissileAlt3:
    SHAM F 18
    SHAM G 6
    goto Spawn+2
   ClassPain:
    SHAM H 0
    goto MegamanPain
   ClassDeath:
    SHAM H 0
    goto MegamanDeath
  }
}

// Ugly Proto Man

actor ProtoManBadGuyMorph_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_MorphPreReset")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_MorphPostReset", 1)
    TNT1 A 0 A_GiveInventory("BasicBossItem")
    TNT1 A 0 A_GiveInventory("MorphedFlag")
    TNT1 A 0 A_GiveInventory("BAWS")
    stop
  }
}

actor ProtoManBadGuy_W : BaseUnholyBossWep  // BaddieProtoBuster
{
Weapon.AmmoUse 1
Weapon.AmmoGive 3
Weapon.SlotNumber 1
Inventory.Pickupmessage "\cgI am an enemy."
Obituary "%o was removed from play by \cgProtoman\c- (%k)."
Tag "Proto Bad Guy"
weapon.ammotype "BusterAmmo"
inventory.icon "NULLICON"
Dropitem ""
States
{
Spawn:
WEA2 Q 1
wait
Ready:
PROC L 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CLR_PROTOBUSTER)
PROC L 0 A_GiveInventory("ScrotoStrikerProtect")
PROC L 0 A_GiveInventory("ProtoManBadGuyMorph_P")
Goto Ready2
Ready2:
PROC J 0 A_TakeInventory("WeaponCharge", 1)
PROC J 0 A_TakeInventory("StopShield")
PROC J 0 A_GunFlash
PROC LKJ 1 A_WeaponReady
wait
Deselect:
PROC J 0
goto DeselectSwap
Select:
PROC J 0
goto SelectSwap
Altfire:
PROC D 0 A_JumpIfNoAmmo("Hold")
PROC D 0 A_GiveInventory("StopShield")
PROC KLD 1 A_TakeInventory("WeaponCharge", 1)
Altfire.a:
PROC D 0 A_PlaySoundEx("weapon/mbuster","Weapon")
PROC D 0 A_FireCustomMissile("ProtoShot",0,0,8,0)
PROC EFD 3
PROC D 3 A_Refire("Altfire.a")
goto Ready2+2
Fire:
PROC D 0 A_JumpIfNoAmmo("Hold")
PROC D 0 A_GiveInventory("StopShield")
PROC D 0 A_PlaySoundEx("weapon/mbuster","Weapon")
PROC D 0 A_FireCustomMissile("BaddieProtoShot",0,0,8,0)
PROC KLD 1 A_TakeInventory("WeaponCharge", 1)
PROC EF 3
PROC D 3 A_Refire
goto Ready2+2
Fire2:
PROC D 0 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC D 0 A_TakeInventory("WeaponCharge", 1)
PROC D 0 A_GiveInventory("StopShield")
PROC F 0 A_PlaySoundEx("weapon/pshot","Weapon")
PROC F 3 A_FireCustomMissile("BaddieProtoShot2",0,0,8,0)
PROC EFD 3
PROC D 0 A_Refire
goto Ready2+2
Fire3:
PROC D 0 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC D 0 A_TakeInventory("WeaponCharge", 1)
PROC D 0 A_GiveInventory("StopShield")
PROC D 0 A_PlaySoundEx("weapon/pshot","Weapon")
PROC F 6 A_FireCustomMissile("BaddieProtoShot3",0,0,8,0)
PROC ED 3
PROC D 9
PROC D 0 A_Refire
goto Ready2+1
Hold:
PROC J 0 A_TakeInventory("StopShield")
PROC D 0 A_JumpIfInventory("WeaponCharge",36,"Charge2")
PROC D 0 A_JumpIfInventory("WeaponCharge",10,"Charge")
PROC D 1 A_GiveInventory("WeaponCharge",1)
PROC D 0 A_Refire
Goto Ready2+1
Charge:
PROC D 0 A_JumpIfInventory("WeaponCharge",36,"Charge2")
PROC D 0 A_JumpIfInventory("WeaponCharge",11,"Charge1")
PROC D 0 A_PlaySoundEx("weapon/pchargelong","Weapon")
Goto Charge1
Charge1:
PROC J 0 A_JumpIfInventory("WeaponCharge",36,"Charge2")
PROC D 1 ACS_NamedExecuteWithResult("core_chargecolor", 63)
PROC H 0 A_Refire("Charge1.a")
Goto Fire2
Charge1.a:
PROC H 1 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC H 0 A_Refire("Charge1.b")
Goto Fire2
Charge1.b:
PROC H 1 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC H 0 A_Refire("Charge1.c")
Goto Fire2
Charge1.c:
PROC H 1 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC H 0 A_GiveInventory("WeaponCharge",2)
PROC H 0 A_Refire("Charge1")
Goto Fire2
Charge2:
PROC I 1 ACS_NamedExecuteWithResult("core_chargecolor", 64)
PROC H 0 A_Refire("Charge2.a")
Goto Fire3
Charge2.a:
PROC H 1 ACS_NamedExecuteWithResult("core_chargecolor", 36)
PROC J 0 A_JumpIfInventory("IsBot", 1, "BotFire")
PROC H 0 A_Refire("Charge2")
Goto Fire3
BotFire:
PROC J 0 A_Jump(16, "Fire3")
PROC H 0 A_Refire("Charge2")
Goto Fire3
Flash:
TNT1 A 0 A_SpawnItemEx("ProtoShieldHitbox1",28,-16,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ProtoShieldHitbox2",28,-8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ProtoShieldHitbox3",28,0,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ProtoShieldHitbox4",28,8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ProtoShieldHitbox5",28,16,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ProtoShieldFX",23,-10,8,momx,momy,momz,0,9,0)
TNT1 A 1 A_JumpIfInventory("StopShield",1,"NoFlash")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
goto Flash+5
}
}

actor BaddieProtoShot : BasicProjectile
{
damagetype "ProtoBuster"
Obituary "%o was busted by \cgProtoman\c- (%k)."
+THRUGHOST
Damage (75)
radius 6
height 6
Speed 32
States
{
Spawn:
TNT1 A 2
BUST A 2
BUST A 0 A_ChangeFlag("THRUGHOST",0)
BUST A 1
wait
}
}


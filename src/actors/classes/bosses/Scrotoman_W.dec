actor Scrotoman_W_ScriptBar : ScriptBar {}
actor Scrotoman_W : BaseUnholyBossWep
{
Tag "$TAG_Boss113_W"
Obituary "%o wasn't cool enough to be like \chScrotoman\c- (%k)."
Inventory.Pickupmessage "\cgI'm waiting for my position as Boss 0."
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyBossAmmo250"
States
{
Spawn:
8I13 [ 1
wait

Deselect:
8I13 A 0
goto DeselectSwap
Select:
8I13 A 0
goto SelectSwap

Ready:
8I13 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8I13 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, SCROTOMAN_DYE)
goto Ready2

Ready1:
8I13 A 0 A_TakeInventory("StopShield")
8I13 A 0 A_GunFlash
8I13 CB 2 A_GiveInventory("ScrotoProto_Ready0_P")
goto Ready3
Ready2:
8I13 A 0 A_TakeInventory("StopShield")
8I13 A 0 A_GunFlash
goto Ready3
Ready3:
8I13 A 2 A_GiveInventory("ScrotoProto_Ready0_P")
loop

Reload:
8I13 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "ScrotoStrike")
goto Ready1
ScrotoStrike:
8I13 A 0 A_GiveInventory("StopShield")
8I13 BC 2
8I13 C 0 A_PlaySoundEx("BUTTSCKS","Weapon")
8I13 C 0 A_TakeInventory("UnholyBossAmmo250",250)
8I13 C 0 A_FireCustomMissile("ScrotoStriker", 0, 0, 8, 0)
8I13 E 2 Offset(24, 44)
8I13 E 2 Offset(48, 64)
8I13 E 2 Offset(44, 64)
8I13 D 2 Offset(36, 56)
8I13 D 2 Offset(16, 40)
8I13 D 2 Offset(8, 32)
8I13 C 4 A_WeaponReady(14)
goto Ready1

Flash:
8I13 Z 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
8I13 ZY 2
FlashHold:
8I13 X 0 A_GiveInventory("ScrotoShieldHitbox_P")
8I13 X 0 A_SpawnItemEx("ScrotoShieldFX",23,-14,8,momx,momy,momz,0,9,0)
8I13 X 1 A_JumpIfInventory("StopShield", 1, "FlashEnd")
loop
FlashEnd:
8I13 YZ 2
stop

Fire:
8I13 A 0 A_JumpIfInventory("UnholyPower1500",1500,"CMON")
8I13 A 0 A_GiveInventory("StopShield")
8I13 BC 2 A_TakeInventory("WeaponCharge", 1)
8I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I13 A 0 A_FireCustomMissile("ScrotoShotI",0,0,8,0)
8I13 DE 2
8I13 A 0 A_GiveInventory("UnholyBossAmmo200",2)
8I13 A 0 A_GiveInventory("UnholyBossAmmo250",1)
8I13 C 0 A_Refire("FireH")
goto Ready1
Fire2:
8I13 E 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 E 0 A_TakeInventory("WeaponCharge", 1)
8I13 E 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I13 E 2 A_FireCustomMissile("ScrotoShotII",0,0,8,0)
8I13 DCC 2
8I13 C 0 A_Refire("FireH")
goto Ready1
Fire3:
8I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 A 0 A_TakeInventory("WeaponCharge", 1)
8I13 A 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I13 E 3 A_FireCustomMissile("ScrotoShotIII",0,0,8,0)
8I13 DC 2
8I13 C 3
8I13 C 0 A_Refire("FireH")
goto Ready1

FireH:
8I13 C 0 A_JumpIfInventory("UnholyPower1500",1500,"CMON")
8I13 C 0 A_TakeInventory("StopShield")
8I13 C 0 A_JumpIfInventory("WeaponCharge",24,"Charge2")
8I13 C 0 A_JumpIfInventory("WeaponCharge",10,"Charge")
8I13 C 1 A_GiveInventory("WeaponCharge",1)
8I13 C 0 A_Refire("FireH")
Goto Ready2
Charge:
8I13 C 0 A_JumpIfInventory("WeaponCharge",24,"Charge2")
8I13 C 0 A_JumpIfInventory("WeaponCharge",11,"Charge1")
8I13 C 0 A_PlaySoundEx("weapon/pchargelong","Weapon")
Goto Charge1
Charge1:
8I13 C 0 A_JumpIfInventory("WeaponCharge",24,"Charge2")
8I13 C 1 ACS_NamedExecuteWithResult("core_chargecolor", 94)
8I13 F 0 A_Refire("Charge1.a")
Goto Fire2
Charge1.a:
8I13 F 1 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 F 0 A_Refire("Charge1.b")
Goto Fire2
Charge1.b:
8I13 F 1 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 F 0 A_Refire("Charge1.c")
Goto Fire2
Charge1.c:
8I13 F 1 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOMAN_DYE)
8I13 F 0 A_GiveInventory("WeaponCharge",2)
8I13 C 0 A_Refire("Charge1")
Goto Fire2
Charge2:
8I13 G 0 A_GiveInventory("UnholyBossAmmo200",2)
8I13 G 0 A_GiveInventory("UnholyBossAmmo250",1)
8I13 G 1 ACS_NamedExecuteWithResult("core_chargecolor", 93)
8I13 F 0 A_Refire("Charge2.a")
Goto Fire3
Charge2.a:
8I13 F 1 ACS_NamedExecuteWithResult("core_chargecolor", 94)
8I13 G 0 A_JumpIfInventory("IsBot", 1, "BotFire")
8I13 G 0 A_Refire("Charge2")
Goto Fire3
BotFire:
8I13 G 0 A_Jump(16,"Fire3")
8I13 G 0 A_Refire("Charge2")
Goto Fire3

Altfire:
8I13 A 0 A_GiveInventory("StopShield")
8I13 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"SideB")
Goto Altfire.a

Altfire.a:
8I13 BC 2
goto Altfire.b
Altfire.b:
8I13 D 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I13 D 0 A_FireCustomMissile("ScrotoShotI",0,0,8,0)
8I13 DE 2
8I13 C 0 A_GiveInventory("UnholyBossAmmo200",2)
8I13 C 0 A_GiveInventory("UnholyBossAmmo250",1)
8I13 C 1
8I13 C 0 A_Refire("Altfire.b")
goto Ready1

SideB:
8I13 A 0 A_GiveInventory("StopShield")
8I13 A 0 A_GiveInventory("VivifyDelay7")
8I13 A 0 A_Refire(1)
8I13 A 0 A_PlaySoundEx("weapon/SumoLeap","Weapon")
8I13 A 0 A_TakeInventory("UnholyBossAmmo200",200)
8I13 A 0 ThrustThingZ(0,35,0,0)
8I13 A 0 A_Recoil(-50)
8I13 BCD 2
Tch:
8I13 E 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "GREATFIGHTINGMAC")
8I13 E 0 A_SpawnItemEX("ScrotoHaymaker",0,0,-48,momx,momy,momz,0,8,0)
8I13 E 0 A_JumpIfInventory("DecoyFlag1",1,"GAMESET")
loop

GREATFIGHTINGMAC:
8I13 A 0 A_GiveInventory("VivifyDelay5")
8I13 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I13 A 0 A_PlaySoundEx("weapon/SumoHit","Weapon")
8I13 EEEE 2 A_Recoil(-25)
8I13 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I13 DDD 2 A_TakeInventory("DecoyFlag1")
8I13 C 20
8I13 C 0 A_Refire("Altfire.b")
Goto Ready1
GAMESET:
8I13 E 5 A_GiveInventory("VivifyDelay5")
8I13 DD 2 A_TakeInventory("DecoyFlag1")
8I13 C 10
8I13 C 0 A_Refire("Altfire.b")
Goto Ready1

CMON:
TNT1 A 0 A_PlaySoundEx("weapon/ScrotoRadio","Body")
TNT1 A 0 A_GiveInventory("UnholyPowerDazzle_F")
TNT1 A 0 A_GiveInventory("StopShield")
TNT1 A 0 A_Refire(1)
BLUEFALCON:
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_radiuspull", 25, 500, 0, 1)
TNT1 A 0 A_GiveInventory("ScrotomanRageBoost_P")//SS++ Class Driving //
TNT1 A 1 A_SpawnItemEX("ScrotoCruiseRamming",0,0,28,momx,momy,momz,0,8,0)
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"BLUEFALCONX")
TNT1 A 0 A_TakeInventory("UnholyPower1500",10)
TNT1 A 0 A_JumpIfInventory("UnholyPower1500",1,"BLUEFALCON")
Goto NOTSOCOOLNOW
BLUEFALCONX:
TNT1 A 0 A_TakeInventory("UnholyPower1500",5)
TNT1 A 0 A_JumpIfInventory("UnholyPower1500",1,"BLUEFALCON")
Goto NOTSOCOOLNOW
NOTSOCOOLNOW: //EJECT BUTTON
TNT1 A 0 A_PlaySoundEx("weapon/drillexplode","Body")
TNT1 A 0 A_FireCustomMissile("ScrotoCruisePoof",0,0,0,0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
TNT1 A 0 A_GiveInventory("VivifyDelay6")
TNT1 A 0 ThrustThingZ(0,60,0,0)
TNT1 A 5 A_Recoil(-75)
TNT1 A 1 A_TakeInventory("UnholyPowerDazzle_F")
8I13 A 2
Goto Ready2
}
}


actor ScrotoProto_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor ScrotoProto_Ready8_P : ScrotoProto_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor ScrotomanRageBoost_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"),"PSpeedG")
goto PSpeedA
PSpeedG:
TNT1 A 0 A_Recoil(-15)
stop
PSpeedA:
TNT1 A 0 A_Recoil(-7.5)
stop
}
}


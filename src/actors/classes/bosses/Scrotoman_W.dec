TNT1 A 0 A_SpawnItemEx("ScrotoShieldHitbox2",28,-8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ScrotoShieldHitbox3",28,0,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ScrotoShieldHitbox4",28,8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("ScrotoShieldHitbox5",28,16,8,0,0,0,0,1)
stop
}

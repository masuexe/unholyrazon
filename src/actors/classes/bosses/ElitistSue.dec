// Rename to Enchantress? Sorceress? Sue. I never knew why I went my way to call her ELITIST.
actor ElitistSue : BossBase {
  Player.ScoreIcon "UB003MUG"
  Player.SoundClass "ElitistSue"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 1875
  Health 1875
  Player.MorphWeapon "ElitistSue_W"
  States {
   Spawn:
    8A03 A 0
    8A03 B 1
    8A03 A 1
    goto Spawn+2
   See:
    8A03 BCDE 5
    goto Spawn
   Missile:
    8A03 F 5
    8A03 G 4
    goto Spawn+2
   ClassPain:
    8A03 H 0
    goto MegamanPain
   ClassDeath:
    8A03 H 0
    goto MegamanDeath
  }
}

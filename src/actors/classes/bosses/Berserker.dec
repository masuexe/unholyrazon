actor Berserker : BossBase {
  player.soundclass "BOSS073"
  player.forwardmove 1.25, 1.25
  player.sidemove 1.25, 1.25
  player.jumpz 10
  Player.MaxHealth 2100
  Health 2100
  player.morphweapon "Berserker_W"
  PainSound "classes/BerserkerPain"
  States {
   Spawn:
    8A73 A 0
    8A73 B 1
   SpawnFrame:
    8A73 A 1
    loop
   See:
    8A73 BCDE 5
    Goto Spawn
   Missile:
    8A73 F 0 A_JumpIfInventory("VivifyDelay8", 1, "Grabbing")
    8A73 F 1 A_JumpIf(velz < 0, "Missile2")
    wait
   Missile2:
    8A73 G 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpawnFrame")
    wait
   Grabbing:
    8A73 I 20
    8A73 I 0 A_JumpIfInventory("SuplexID", 1, "Grabbing")
    goto SpawnFrame
   ClassPain:
    8A73 H 0
    Goto MegamanPain
   ClassDeath:
    8A73 H 0
    Goto MegamanDeath
  }
}

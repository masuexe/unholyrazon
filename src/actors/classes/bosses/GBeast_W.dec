actor GBeast_W5 : GBeast_W1
{
Inventory.Icon "BI_108E"
States
{
CrossAttack:
8I08 A 0 A_JumpIfInventory("CutterFlag",8,"Cross4End")
8I08 B 3 A_FireCustomMissile("GBeast_EraseCross",0,0,8,0)
8I08 C 3 A_FireCustomMissile("GBeast_EraseCross",random(-4,4),0,8,0,0,random(-4,4))
8I08 B 3 A_FireCustomMissile("GBeast_EraseCross",0,0,8,0)
8I08 C 3 A_FireCustomMissile("GBeast_EraseCross",random(-4,4),0,8,0,0,random(-4,4))
8I08 C 0 A_GiveInventory("CutterFlag", 1)
loop
CrossAttackB:
8I08 A 0 A_JumpIfInventory("CutterFlag",10,"Cross4bEnd")
8I08 B 2 A_FireCustomMissile("GBeastFury_EraseCross",0,0,8,0)
8I08 C 2 A_FireCustomMissile("GBeastFury_EraseCross",random(-3,3),0,8,0,0,random(-3,3))
8I08 B 2 A_FireCustomMissile("GBeastFury_EraseCross",0,0,8,0)
8I08 C 2 A_FireCustomMissile("GBeastFury_EraseCross",random(-3,3),0,8,0,0,random(-3,3))
8I08 C 0 A_GiveInventory("CutterFlag", 1)
loop
Cross4End:
8I08 B 3 A_TakeInventory("CutterFlag")
goto ReadyX
Cross4bEnd:
8I08 B 0 A_TakeInventory("CutterFlag")
8I08 BC 4
8I08 B 20 A_FireCustomMissile("GBeastFury_EraseBeam",0,0,8,0)
goto ReadyX
}
}
actor GBeast_W6 : GBeast_W1
{
Inventory.Icon "BI_108F"
States
{
AltFire:
8I08 A 0 A_JumpIfInventory("KnightFlag", 1,"Cross5End") //Charge Attack cancel
8I08 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"CrossAttack")
goto NoAmmo

CrossAttack:
8I08 A 1 Offset(2,49) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8I08 A 1 Offset(5,69)
8I08 A 1 Offset(9,92) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8I08 A 1 Offset(14,118)
8I08 A 1 Offset(20,147) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
TNT1 A 2
TNT1 A 10 A_GiveInventory("KnightFlag", 1) //Prep for ramming
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
TNT1 A 0 A_GiveInventory("UH_00_AlphaPowerGiver")
TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1,"Cross5bLoop")/////////
Cross5Loop:
TNT1 A 0 A_ChangeVelocity(cos(pitch)*30,0,-sin(pitch)*25,CVF_RELATIVE|CVF_REPLACE)
TNT1 A 0 A_FireCustomMissile("GBeast_ChargeCross",0,0,0,0)
TNT1 AA 1 A_TakeInventory("UnholyBossAmmo100",2)
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100",2,"Cross5Loop")
goto Cross5End
Cross5bLoop:
TNT1 A 0 A_ChangeVelocity(cos(pitch)*40,0,-sin(pitch)*30,CVF_RELATIVE|CVF_REPLACE)
TNT1 A 0 A_FireCustomMissile("GBeastFury_ChargeCross",0,0,0,0)
TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo100",2)
TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo100",2)
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100",2,"Cross5bLoop")
goto Cross5End

Cross5End:
8I08 A 0 A_TakeInventory("KnightFlag")
8I08 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
8I08 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8I08 A 0 A_TakeInventory("UH_00_AlphaPower")
8I08 A 1 Offset(24,166)
8I08 A 1 Offset(19,136) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8I08 A 1 Offset(14,106)
8I08 A 1 Offset(10,84) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8I08 A 1 Offset(6,62)
8I08 A 1 Offset(3,47) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8I08 A 1 A_WeaponReady(14)
goto ReadyX
}
}


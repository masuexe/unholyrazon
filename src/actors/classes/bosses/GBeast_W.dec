// TODO: finish hud sprites
// IDEA: when healthlower(2), go to fully berserk mode:
//       invulnerable, but quickly drains HP.
//       when HP drops to 1, kill player.

actor GBeast_W1_ScriptBar : ScriptBar {}
actor GBeast_W2_ScriptBar : ScriptBar {}
actor GBeast_W3_ScriptBar : ScriptBar {}
actor GBeast_W4_ScriptBar : ScriptBar {}
actor GBeast_W5_ScriptBar : ScriptBar {}
actor GBeast_W6_ScriptBar : ScriptBar {}

actor GBeast_W1 : BaseUnholyBossWep {
  Tag "$TAG_Boss108_W"
  Obituary "%o was removed from the system by \c[UB108]G-Beast\c- (%k)."
  Inventory.Pickupmessage "\crHow did you literally rip off the claws from a giant wolf...? Oh well, they're yours now."
  weapon.ammotype "UnholyBossAmmo100"
  weapon.ammotype2 "UnholyPower1500"
  Inventory.Icon "BI_108A"
  States {
   Spawn:
    8I08 [ 1
    wait

   Ready:
    8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, "ReadyRage")
    8I08 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, GBEAST_DYE)
    goto ReadyX
   ReadyRage:
    8I08 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, CLR_PREVCOLOR)
    8I08 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8I08 A 0 A_JumpIfInventory("UnholyBossAmmo100", 25, "ReadyX1")
    8I08 A 2 A_WeaponReady(8)
    8I08 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    loop
   ReadyX1:
    8I08 A 2 A_WeaponReady
    8I08 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    loop
   Deselect:
    8I08 A 0
    goto DeselectSwap
   Select:
    8I08 A 0
    goto SelectSwap

   Fire:
    8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, "PrimalFire")
    8I08 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "EnragedMode")
    8I08 A 0 A_PlaySoundEx("MMBN6/GregarBuster", "Weapon")
    8I08 A 0 A_FireCustomMissile("GBeast_Shot", 0, 0, 8, 0)
    8I08 C 1
    8I08 C 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8I08 B 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    8I08 B 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8I08 A 1
    8I08 A 0 A_GiveInventory("UnholyBossAmmo100", 1)
    Goto ReadyX
   PrimalFire:
    8I08 A 0 A_PlaySoundEx("MMBN6/GregarBuster", "Weapon")
    8I08 A 0 A_FireCustomMissile("GBeastFury_Shot", 0, 0, 8, 0)
    8I08 C 1
    8I08 C 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8I08 B 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    8I08 B 0 A_GiveInventory("UnholyBossAmmo100", 1)
    8I08 B 0
    Goto ReadyX
   EnragedMode:
    8I08 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I08 A 0 A_GiveInventory("PrimalBeastOut_F", 700)
    8I08 A 0 A_TakeInventory("UnholyPower1500", 2500)
    8I08 A 0 A_PlaySoundEx("MMBN6/GBeastOutYell", "Auto")
    8I08 A 2 A_SpawnItemEx("GBeastFury_Bolt", random(-400, 400), random(-400, 400), 0)
    8I08 A 0 A_GunFlash("Flash.Primal")
    8I08 AA 4 A_GiveInventory("PrimalBeastOut_F", 700)
    8I08 AAA 8 A_SpawnItemEx("GBeastFury_Bolt", random(-400, 400), random(-400, 400), 0)
    8I08 AAAAA 5 A_SpawnItemEx("GBeastFury_BoltX", random(-400, 400), random(-400, 400), 0)
    8I08 A 0 A_GiveInventory("PrimalBeastOut_F", 700)
    8I08 A 0 A_SpawnItemEx("PrimalBeastOut_H")
    8I08 A 0 A_GunFlash
    8I08 A 5 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    goto ReadyX

   Flash.Primal:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE2)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
    loop
   Flash:
    TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, 1)
    goto FlashEnd
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE2)
    TNT1 AAAAA 1
    TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, 1)
    goto FlashEnd
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
    TNT1 AAAAA 1
    goto Flash
   FlashEnd:
    TNT1 AA 1 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
    stop


   AltFire:
    8I08 A 0 A_JumpIfInventory("UnholyBossAmmo100", 25, "AltSuccess")
    goto NoAmmo
   NoAmmo:
    8I08 A 1
    goto ReadyX
   AltSuccess:
    8I08 A 0 A_TakeInventory("UnholyBossAmmo100", 25)
    8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, "CrossAttackB")
    8I08 A 0 A_JumpIf(true, "CrossAttack")

    // Beast slash
   CrossAttack:
   LongSword:
    8I08 G 0 A_PlaySoundEx("MMBN6/BeastClaw1", "Weapon")
    8I08 G 0 A_FireCustomMissile("GBeastLongSwipe", random(-1, 1), 1, -8, 20)
    8I08 G 0 A_FireCustomMissile("GBeastLongSwipe", random(-1, 1), 1, -8, 0)
    8I08 G 0 A_FireCustomMissile("GBeastLongSwipe", random(-1, 1), 1, -8, -20)
    8I08 G 1 offset(106, 64)
    8I08 G 1 offset(82, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 G 1 offset(57, 43)
    8I08 G 1 offset(31, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(11, -16)
    8I08 F 1 offset(-16, -32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(-44, -50)
    8I08 F 1 offset(-73, -70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(-103, -92)
    8I08 F 1 offset(-134, -116) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
   WideSword:
    8I08 E 0 A_PlaySoundEx("MMBN6/BeastClaw2", "Weapon")
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6+20, 0, -10)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6, 0, -10)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6-20, 0, -10)
    8I08 E 1 offset(-106, 64)
    8I08 E 1 offset(-82, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_N", 5, 0, -2, -2+20, 0, -5)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_N", 5, 0, -2, -2, 0, -5)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_N", 5, 0, -2, -2-20, 0, -5)
    8I08 E 1 offset(-57, 43)
    8I08 E 1 offset(-31, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_M", -10, 0, 0, 4+20, 0, 0)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_M", -10, 0, 0, 4, 0, 0)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_M", -10, 0, 0, 4-20, 0, 0)
    8I08 D 1 offset(-11, -16)
    8I08 D 1 offset(16, -32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_L", -25, 0, 8, 10+20, 0, 5)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_L", -25, 0, 8, 10, 0, 5)
    8I08 E 0 A_FireCustomMissile("GBeastWideSwipe_L", -25, 0, 8, 10-20, 0, 5)
    8I08 D 1 offset(44, -50)
    8I08 D 1 offset(73, -70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 D 1 offset(103, -92)
    8I08 D 1 offset(134, -116) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 6
    goto ReadyX

   CrossAttackB:
   LongSwordB:
    8I08 G 0 A_PlaySoundEx("MMBN6/BeastClaw1", "Weapon")
    8I08 G 0 A_FireCustomMissile("GBeastFuryLongSwipe", random(-1, 1), 1, -8, 20)
    8I08 G 0 A_FireCustomMissile("GBeastFuryLongSwipe", random(-1, 1), 1, -8, 0)
    8I08 G 0 A_FireCustomMissile("GBeastFuryLongSwipe", random(-1, 1), 1, -8, -20)
    8I08 G 1 offset(106, 64)
    8I08 G 1 offset(82, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 G 1 offset(57, 43)
    8I08 G 1 offset(31, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(11, -16)
    8I08 F 1 offset(-16, -32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(-44, -50)
    8I08 F 1 offset(-73, -70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 F 1 offset(-103, -92)
    8I08 F 1 offset(-134, -116) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
   WideSwordB:
    8I08 E 0 A_PlaySoundEx("MMBN6/BeastClaw2", "Weapon")
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6+20, 0, -10)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6, 0, -10)
    8I08 D 0 A_FireCustomMissile("GBeastWideSwipe_O", 15, 0, -8, -6-20, 0, -10)
    8I08 E 1 offset(-106, 64)
    8I08 E 1 offset(-82, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 D 0 A_FireCustomMissile("GBeastFuryWideSwipe_N", 5, 0, -2, -2+20, 0, -5)
    8I08 D 0 A_FireCustomMissile("GBeastFuryWideSwipe_N", 5, 0, -2, -2, 0, -5)
    8I08 D 0 A_FireCustomMissile("GBeastFuryWideSwipe_N", 5, 0, -2, -2-20, 0, -5)
    8I08 E 1 offset(-57, 43)
    8I08 E 1 offset(-31, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_M", -10, 0, 0, 4+20, 0, 0)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_M", -10, 0, 0, 4, 0, 0)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_M", -10, 0, 0, 4-20, 0, 0)
    8I08 D 1 offset(-11, -16)
    8I08 D 1 offset(16, -32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_L", -25, 0, 8, 10+20, 0, 5)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_L", -25, 0, 8, 10, 0, 5)
    8I08 E 0 A_FireCustomMissile("GBeastFuryWideSwipe_L", -25, 0, 8, 10-20, 0, 5)
    8I08 D 1 offset(44, -50)
    8I08 D 1 offset(73, -70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I08 D 1 offset(103, -92)
    8I08 D 1 offset(134, -116) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 6
    goto ReadyX}
}

actor GBeast_W2 : GBeast_W1 {
  Inventory.Icon "BI_108B"
  States {
   CrossAttack:
    8I08 C 0 A_FireCustomMissile("GBeast_HeatCross", 0, 0, 8, 0)
    8I08 CBA 4
    goto ReadyX
   CrossAttackB:
    8I08 C 0 A_FireCustomMissile("GBeastFury_HeatCross", 0, 0, 8, 0)
    8I08 CBA 4
    goto ReadyX
  }
}


Actor GBeast_Shot : BasicFastProjectile
{
Translation "192:192=220:220","198:198=195:195"
+DONTBLAST
Damagetype "GBeast"
Obituary "%o got mowed down by \c[UB108]G-Beast \c-(%k)'s Buster shots."
Damage(40)
Radius 12
Height 12
Speed 400//250
Scale 1.25
States
{
Spawn:
TNT1 A 2
loop
Crash:
XDeath:
TNT1 A 0 A_PlaySoundEx("MMBN6/ShotHit","Weapon")
goto DeathFrame
Death:
TNT1 A 0 A_PlaySoundEx("MMBN6/BusterBlock","Weapon")
DeathFrame:
TNT1 A 1
8P51 BCDEF 1
stop
}
}

Actor GBeastFury_Shot : GBeast_Shot
{
Translation "192:192=215:215","198:198=116:116"
Obituary "%o was mowed down by \c[UB108]G-Beast \c-(%k)'s Primal G-Buster."
Scale 1.5
}

Actor GBeast_HeatCross : BasicProjectile
{
Translation "192:192=220:220","198:198=195:195","199:199=195:195","202:202=220:220"
Damagetype "GBeastFire"
Obituary "%o was in the path of \c[UB108]G-Beast \c-(%k)'s Heat Eruption."
Reactiontime 20
Damage (250)
Radius 14 //24
Height 14 //24
Speed 36
Scale 3.5
States
{
Spawn:
X_2G C 0
X_2G C 0 A_PlaySound("weapon/atomicfire")
X_2G CCCCDDDD 1 A_SpawnItemEx("GBeast_HeatCrossTrail",random(-8,8),random(-8,8),random(-8,8),0,0,0,0, 1)
X_2G C 0 A_Countdown
loop
Death:
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionSpawner",0,0,0,0,0,0,0, 1)
TNT1 A 1 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
stop
}
}

Actor GBeastFury_HeatCross : GBeast_HeatCross
{
Translation "192:192=116:116","198:198=215:215","199:199=116:116","202:202=215:215"
Obituary "%o was in the path of \c[UB108]G-Beast \c-(%k)'s Primal Heat Eruption."
Speed 48
Damage(400)
States
{
Spawn:
X_2G C 0
X_2G C 0 A_PlaySound("weapon/atomicfire")
X_2G CCCDDD 1 A_SpawnItemEx("GBeast_HeatCrossTrail",random(-8,8),random(-8,8),random(-8,8),0,0,0,0, 1)
X_2G C 0 A_Countdown
loop
Death:
TNT1 A 0 A_SpawnItemEx("GBeast_PrimalHeatEruptionSpawner",0,0,0,0,0,0,0, 1)
TNT1 A 1 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
stop
}
}

Actor GBeast_HeatEruptionSpawner : BasicExplosion
{
Obituary "%o was surrounded by \c[UB108]G-Beast \c-(%k)'s Heat Eruption."
Damagetype "GBeastFire"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("CutterFlag",6,"Spawn2")
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",256,0,0,0,0,-120,0, 1)
TNT1 A 4 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",256,0,0,0,0,-120,180, 1)
TNT1 A 0 A_Explode(36,256,0)
TNT1 A 0 A_SetAngle(angle+15.0)
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",256,0,0,0,0,-120,0, 1)
TNT1 A 4 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",256,0,0,0,0,-120,180, 1)
TNT1 A 0 A_SetAngle(angle+15.0)
TNT1 A 0 A_GiveInventory("CutterFlag", 1)
goto Spawn+1
Spawn2:
TNT1 A 0 A_JumpIfInventory("CutterFlag",10,"Death")
TNT1 A 6 A_Explode(36,256,0)
TNT1 A 0 A_GiveInventory("CutterFlag", 1)
loop
Death:
TNT1 A 0
stop
}
}

Actor GBeast_PrimalHeatEruptionSpawner : GBeast_HeatEruptionSpawner
{
Obituary "%o was surrounded by \c[UB108]G-Beast \c-(%k)'s Primal Heat Eruption."
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("CutterFlag",4,"Spawn2")
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,0, 1)
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,120, 1)
TNT1 A 3 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,240, 1)
TNT1 A 0 A_Explode(48,384,0,0,32)
TNT1 A 0 A_SetAngle(angle+15.0)
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,0, 1)
TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,120, 1)
TNT1 A 3 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner",384,0,0,0,0,-120,240, 1)
TNT1 A 0 A_SetAngle(angle+15.0)
TNT1 A 0 A_GiveInventory("CutterFlag", 1)
goto Spawn+1
Spawn2:
TNT1 A 0 A_JumpIfInventory("CutterFlag",12,"Death")
TNT1 A 5 A_Explode(48,384,0,0,32)
TNT1 A 0 A_GiveInventory("CutterFlag", 1)
loop
Death:
TNT1 A 0
stop
}
}

Actor GBeast_HeatEruptionFlameSpawner
{
PROJECTILE
+DONTBLAST
+THRUACTORS
+THRUGHOST
+DONTSPLASH
Radius 4
Height 4
States
{
Spawn:
TNT1 A 0
TNT1 A 1
goto Spawn+1
Death:

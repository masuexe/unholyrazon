actor GBeast_W1 : BaseUnholyBossWep
{
Tag "$TAG_Boss108_W"
Obituary "%o was removed from the system by \c[UB108]G-Beast \c-(%k)."
Inventory.Pickupmessage "\crHow did you literally rip off the claws from a giant wolf...? Oh well, they're yours now."
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyPower1500"
Inventory.Icon "BI_108A"
States
{
Spawn:
8I08 [ 1
wait

Ready:
8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,"ReadyRage")
8I08 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GBEAST_DYE)
goto ReadyX
ReadyRage:
8I08 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_PREVCOLOR)
8I08 A 0 A_GunFlash
goto ReadyX
ReadyX:
8I08 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"ReadyX1")
8I08 A 2 A_WeaponReady(8)
8I08 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
ReadyX1:
8I08 A 2 A_WeaponReady
8I08 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
Deselect:
8I08 A 0
goto DeselectSwap
Select:
8I08 A 0
goto SelectSwap

Fire:
8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1,"PrimalFire")
8I08 A 0 A_JumpIfInventory("UnholyPower1500",1500,"EnragedMode")
8I08 A 0 A_PlaySoundEx("MMBN6/GregarBuster","Weapon")
8I08 A 0 A_FireCustomMissile("GBeast_Shot",0,0,8,0)
8I08 CB 2 A_GiveInventory("UnholyBossAmmo100",2)
Goto ReadyX
PrimalFire:
8I08 A 0 A_PlaySoundEx("MMBN6/GregarBuster","Weapon")
8I08 A 0 A_FireCustomMissile("GBeastFury_Shot",0,0,8,0)
8I08 C 2
8I08 B 1 A_GiveInventory("UnholyBossAmmo100", 1)
Goto ReadyX
EnragedMode:
8I08 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I08 A 0 A_GiveInventory("PrimalBeastOut_F",700)
8I08 A 0 A_TakeInventory("UnholyPower1500",2500)
8I08 A 2 A_SpawnItemEx("GBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I08 A 0 A_GunFlash("Flash.Primal")
8I08 AA 4 A_GiveInventory("PrimalBeastOut_F",700)
8I08 AAA 8 A_SpawnItemEx("GBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I08 AAAAA 5 A_SpawnItemEx("GBeastFury_Bolt",random(-400,400),random(-400,400),0)
8I08 A 0 A_GiveInventory("PrimalBeastOut_F",700)
8I08 A 0 A_SpawnItemEx("PrimalBeastOut_H")
8I08 A 0 A_GunFlash
8I08 A 5 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
goto ReadyX

Flash.Primal:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE2)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
loop
Flash:
TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,1)
goto FlashEnd
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE2)
TNT1 AAAAA 1
TNT1 A 0 A_JumpIfInventory("PrimalBeastOut_F",1,1)
goto FlashEnd
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
TNT1 AAAAA 1
goto Flash
FlashEnd:
TNT1 AA 1 ACS_NamedExecuteWithResult("core_chargecolor", GBEAST_DYE)
stop


AltFire:
8I08 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"AltSuccess")
goto NoAmmo
NoAmmo:
8I08 A 1
goto ReadyX
AltSuccess:
8I08 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
8I08 A 0 A_JumpIfInventory("PrimalBeastOut_F", 1, "CrossAttackB")
8I08 A 0 A_JumpIf(true, "CrossAttack")
CrossAttack:
8I08 C 0 A_FireCustomMissile("GBeast_HeatCross",0,0,8,0)
8I08 CBA 4
goto ReadyX
CrossAttackB:
8I08 C 0 A_FireCustomMissile("GBeastFury_HeatCross",0,0,8,0)
8I08 CBA 4
goto ReadyX

// Beast slash
CrossAttack:
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_CustomPunch(450,1,0,"GBeastLongSwipe",375)
GSWP ABC 2
GSWP D 7
TNT1 A 2
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_CustomPunch(450,1,0,"GBeastLongSwipe",375)
GSWP EFGH 2
GSWP D 7
TNT1 A 10
GSWP A 0 A_PlaySoundEx("misc/kingblast","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP ABC 2
GSWP D 20
TNT1 A 5
goto ReadyX

CrossAttackB:
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP ABC 1
GSWP D 2
TNT1 A 3
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP EFG 1
GSWP H 2
TNT1 A 3
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP ABC 1
GSWP D 2
TNT1 A 3
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP EFG 1
GSWP H 2
TNT1 A 3
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP ABC 1
GSWP D 10
TNT1 A 5
GSWP A 0 A_PlaySoundEx("weapon/GBSlash1","Weapon")
GSWP A 0 A_FireCustomMissile("GBeastXSwipe",0,0,8,0)
GSWP EFG 1
GSWP H 10
TNT1 A 5
goto ReadyX
}
}


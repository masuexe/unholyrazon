Actor GBeast_HeatEruptionSpawner : BasicExplosion {
  Obituary "%o was surrounded by \c[UB108]G-Beast\c- (%k)'s Heat Eruption."
  Damagetype "GBeastFire"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 6, "Spawn2")
    TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner", 256, 0, 0, 0, 0, -120, 0, 1)
    TNT1 A 4 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner", 256, 0, 0, 0, 0, -120, 180, 1)
    TNT1 A 0 A_Explode(36, 256, 0)
    TNT1 A 0 A_SetAngle(angle+15.0)
    TNT1 A 0 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner", 256, 0, 0, 0, 0, -120, 0, 1)
    TNT1 A 4 A_SpawnItemEx("GBeast_HeatEruptionFlameSpawner", 256, 0, 0, 0, 0, -120, 180, 1)
    TNT1 A 0 A_SetAngle(angle+15.0)
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn+1
   Spawn2:
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 10, "Death")
    TNT1 A 6 A_Explode(36, 256, 0)
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    loop
   Death:
    TNT1 A 0
    stop
  }
}


actor PrimalBeastOut_F : Inventory {
  inventory.amount 1
  inventory.maxamount 700
}

actor PrimalBeastOut_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
   Drain:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("PrimalBeastOut_F", 1, 1)
    stop
    TNT1 A 0 A_TakeFromTarget("PrimalBeastOut_F", 5)
    TNT1 AAAAA 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    loop
  }
}

actor GBeastLongSwipe : BasicProjectile {
  Translation "4:4=220:220", "202:202=195:195"
  Damagetype "GBeast"
  Obituary "%o's vital organs were clawed out by \c[UB108]G-Beast\c- (%k)."
  +THRUACTORS
  +DONTBLAST
  +DONTREFLECT
  damage (0)
  Radius 5
  Height 5
  speed 60  // 30
  States {
   Spawn:

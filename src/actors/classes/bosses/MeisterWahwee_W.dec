actor Wahwee_Power_Bolt : BasicProjectile
{
Translation "192:192=178:178", "198:198=186:186", "202:202=178:178"
damagetype "WahweeDamage"
Obituary "%o took a fatal shock from \ctMeister \cjWahwee\c- (%k)'s EVIL power bolt."
Damage (175)
Radius 25
Height 16
Speed 52 //52 //30
scale 2.5
States
{
Spawn:
CLOF A 1 A_SpawnItemEx("Wahwee_BoltFX_A",0,0,0,0,0,0,0,1)
CLOF B 1 A_SpawnItemEx("Wahwee_BoltFX_B",0,0,0,0,0,0,0,1)
CLOF C 1 A_SpawnItemEx("Wahwee_BoltFX_C",0,0,0,0,0,0,0,1)
CLOF D 1 A_SpawnItemEx("Wahwee_BoltFX_D",0,0,0,0,0,0,0,1)
CLOF E 1 A_SpawnItemEx("Wahwee_BoltFX_E",0,0,0,0,0,0,0,1)
CLOF F 1 A_SpawnItemEx("Wahwee_BoltFX_F",0,0,0,0,0,0,0,1)
loop
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX","Weapon")
TNT1 A 0 A_Explode(50,128,0,0,64)
X_8B ABCDEF 2 A_SpawnItemEx("Wahwee_Power_Bolt_X",random(-64,64),random(-64,64),random(-64,64),0,0,0,0,1)
stop
}
}

actor Wahwee_Power_Bolt_X : BasicExplosion
{
damagetype "WahweeDamage"
Obituary "%o took a fatal shock from \ctMeister \cjWahwee\c- (%k)'s EVIL power bolt."
scale 3.5 //3.5
States
{
Spawn:
TNT1 A 0 A_Stop //Unnecessary?
TNT1 A 0 A_PlaySoundEx("classes/thunderbolt","Weapon")
X_7D IJKL 2 A_Explode(10,32,0,0,16) //32
stop
}
}

actor Wahwee_Power_Bolt_Shazam : Wahwee_Power_Bolt_X
{
Obituary "Upon being hit by \ctMeister \cjWahwee\c- (%k)'s EVIL deplorable killer voltage blast, %o fell to the ground and perished."
States
{
Spawn:
TNT1 A 0 A_Stop 
TNT1 A 0 A_PlaySoundEx("classes/thunderbolt","Weapon")
X_7D IJKL 2 A_Explode(random(10,20),32,0,0,16) //32
stop
}
}

actor Wahwee_Power_Polt_X : Wahwee_Power_Bolt_X
{
Obituary "%o took a shock from \ctMeister \cjWahwee\c- (%k)'s EVIL power bolt."
}


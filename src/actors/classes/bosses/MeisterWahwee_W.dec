actor MeisterWahwee_W : BaseUnholyBossWep  // MeisterhardtWep //WilySoMadThatMM11OSTIsAllTechnoWhatTheFuck
{
Obituary "Upon the sight of such EVIL, %o got on their knees and became enslaved by \ctMeister \cjWahwee\c- (%k)." //Polish this I guess?
Inventory.Pickupmessage "\cjI am a mad scientist, is so cool! Sonofabitch."
weapon.ammotype "UnholyBossAmmo200" //
weapon.ammotype2 "UnholyBossAmmo300" //
States
{
Spawn:
8H64 [ 1
wait

Ready:
WICH H 0 ACS_NamedExecuteWithResult("core_weaponcolor", MEISTERWAHWEE_DYE)
WICH H 3 ACS_NamedExecuteWithResult("uh_BossMorph", 64,3500,250)
WICH H 0 A_GiveInventory("WahweeMechaPower") //
WICH H 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 1, ELP_NATIVE)
goto ReadyX
ReadyX:
WICH H 0 A_JumpIfHealthLower(2,"YouFool")
WICH H 2 A_WeaponReady(WRF_NOSECONDARY)
WICH H 0 A_GiveInventory("UnholyBossAmmo200",4)
WICH H 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX_Real")
loop
ReadyX_Real:
WICH H 0 A_JumpIfHealthLower(2,"YouFool")
WICH H 2 A_WeaponReady
loop

Deselect:
WICH H 0
goto DeselectSwap
Select:
WICH H 0
goto SelectSwap

Fire: //Offset(0,33) - Base
/*
WICH JI 3
WICH H 6
*/
// WICH H 0 A_JumpIfInventory("SPEED_GEAR_BOSS",1,"SPEED_GEAR_FIRE")
// WICH H 0 A_JumpIfInventory("POWER_GEAR_BOSS",1,"Power_Charge")
WICH H 1 Offset(3,36)
WICH H 1 Offset(6,39)
WICH H 0 A_PlaySoundEX("weapon/photonmissilelaunch","Weapon")
WICH J 0 A_FireCustomMissile("Wahwee_Rocket",0,0,8,0)
WICH J 1 Offset(10,43)
WICH J 1 Offset(15,48)
WICH J 1 Offset(20,53)
WICH J 1 Offset(23,56)
WICH J 1 Offset(25,58)
WICH J 1 Offset(26,59)
WICH I 1 Offset(27,60)
WICH I 1 Offset(28,61)
WICH II 1 Offset(29,62)
WICH J 1 Offset(28,61)
WICH J 1 Offset(27,60)
WICH J 1 Offset(25,58)
WICH J 1 Offset(20,53)
WICH J 1 Offset(15,48)
WICH J 1 Offset(10,43) 
WICH H 1 Offset(6,39) 
WICH H 1 Offset(3,36)
WICH H 10 A_WeaponReady(14)
Goto ReadyX

AltFire:
WICH H 0 A_JumpIfInventory("SPEED_GEAR_BOSS",1,"SPEED_GEAR_ALT")
WICH H 0 A_JumpIfInventory("POWER_GEAR_BOSS",1,"POWER_GEAR_ALT")
WICH H 1 A_JumpIfInventory("UnholyBossAmmo200",200,"Altfire2")
Goto ReadyX
Altfire2:
WICH H 0 A_JumpIfInventory("SPEED_GEAR_BOSS",1,"SPEED_GEAR_ALT")

WICH H 1 Offset(0,35)
WICH H 1 Offset(0,37)
WICH H 1 Offset(0,39)
WICH H 1 Offset(0,41)

WICH H 1 Offset(0,42)ThrustThingZ(0,60,0,0)
WICH A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
WICH A 0 ThrustThingZ(0,25,0,0)
WICH A 0 A_TakeInventory("UnholyBossAmmo200",8) //10 //5
Altfire3:
WICH H 0 A_PlaySound("weapon/spreaddrillhit",4)
WICH H 0 A_TakeInventory("UnholyBossAmmo200",8) //10 //5
WICH H 0 A_SpawnItemEx("Wahwee_Jet_Damage",0,0,28,momx,momy,momz,0,8,0)
WICH H 0 A_SpawnItemEx("Wahwee_Jet_FX",0,-14,-14,0,-2,-10,0,1)
WICH H 0 A_SpawnItemEx("Wahwee_Jet_FX",0,14,-14,0,2,-10,0,1)
WICH H 0 ThrustThingZ(0,25,0,0) //-26 x offset
WICH H 2 Offset(0,42)
WICH H 0 A_JumpIfHealthLower(2,"YouFool") //
WICH H 0 A_ReFire("Altfire_H")
AltEnd:
WICH H 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
WICH H 1 Offset(0,39) A_TakeInventory("UnholyBossAmmo200",10)
WICH H 1 Offset(0,37)
WICH H 1 Offset(0,35)
WICH H 1 Offset(0,34)
Goto ReadyX
Altfire_H:
WICH H 0 A_JumpIfInventory("UnholyBossAmmo200",1,"Altfire3")
goto AltEnd


///////////
//PHASE 2//
///////////

//This is where all the more important stuff goes.
//You have no idea how much I want to cry in the process of doing all this.
//I should be rewarded.

//The checker itself
YouFool:
// TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"Ready_Gear")
TNT1 A 0 A_GiveInventory("Wily_DoSOMETHING_Flag")
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)

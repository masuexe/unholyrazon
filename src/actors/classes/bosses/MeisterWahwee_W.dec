    TNT1 AA 0 A_SpawnItemEx("Wahwee_Shock_Aura", random(-92, 92), random(-92, 92), random(-12, 92), 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Wahwee_Shock_Melee", 0, 0, 56, velx, vely, velz, 0, 40, 0)
    stop
  }
}

actor Wahwee_PowerShock_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Wahwee_PowerShock_Aura", random(-92, 92), random(-92, 92), random(-12, 92), 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Wahwee_PowerShock_Melee", 0, 0, 56, velx, vely, velz, 0, 40, 0)
    stop
  }
}


TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
//TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
//
TNT1 A 0 A_TakeInventory("WahweeMechaPower") //
//
//TNT1 A 140 //
TNT1 A 35 
TNT1 A 35 A_PlaySoundEx("weapon/WilySecondWind","SoundSlot7") //Additional time
TNT1 A 0 A_GiveInventory("Wahwee_PlanB_P")
TNT1 A 10
TNT1 A 0 A_GiveInventory("Wahwee_PlanB_P")
TNT1 A 5
TNT1 AAAAA 3 A_GiveInventory("Wahwee_PlanB_P") //15
TNT1 AAAAA 3 A_GiveInventory("Wahwee_PlanB_P") //15
TNT1 AAAAA 2 A_GiveInventory("Wahwee_PlanB_P") //10
TNT1 AAAAA 2 A_GiveInventory("Wahwee_PlanB_P") //10
TNT1 AAAAA 2 A_GiveInventory("Wahwee_PlanB_P") //10
TNT1 AAAAA 2 A_GiveInventory("Wahwee_PlanB_P") //10
TNT1 AAAAA 1 A_GiveInventory("Wahwee_PlanB_P") //5
//
TNT1 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,64)//Music call
TNT1 A 0 A_TakeInventory("Wily_DoSOMETHING_Flag")
//TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
TNT1 A 2 A_GiveInventory("Wahwee_PlanBB_P") //5//ThrustThingZ(0,125,0,0)
TNT1 A 70 A_PlaySoundEx("weapon/WilyAlwaysWins","SoundSlot7") //
//TNT1 A 0 A_Stop
goto DontYouUnderstand
DontYouUnderstand:
TNT1 A 0 A_GiveInventory("WahweeHPRegain_P")
TNT1 A 1 //A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"IHave70AlternativeAccounts")
TNT1 A 0 A_PlaySoundEx("item/energyup","Weapon")
TNT1 A 0 A_GiveInventory("WahweeHPRegain_P")
TNT1 A 1 //A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"IHave70AlternativeAccounts")
TNT1 A 0 A_PlaySoundEx("item/energyup","Weapon")
TNT1 A 0 A_GiveInventory("WahweeHPRegain_P")
TNT1 A 1 //A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"IHave70AlternativeAccounts")
TNT1 A 0 A_PlaySoundEx("item/energyup","Weapon")
TNT1 A 0 A_GiveInventory("WahweeHPRegain_P")
TNT1 A 1 //A_SpawnItemEx("TroutiusRegainEffect",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"IHave70AlternativeAccounts")
loop
IHave70AlternativeAccounts: //Originally TNT1 2
//TNT1 A 120 A_PlaySoundEx("weapon/WilyAlwaysWins","SoundSlot7")
TNT1 A 2
// TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
TNT1 A 2
TNT1 A 2
TNT1 A 2
// 
TNT1 A 0 A_GiveInventory("Wahwee_W1")
TNT1 A 0 A_GiveInventory("Wahwee_W2")
TNT1 A 0 A_Jump(128,"Gear_SwapTo_Power")
Goto Gear_SwapTo_Speed //
//
Gear_SwapTo_Power:
TNT1 A 0 A_SelectWeapon("Wahwee_W2")
goto Gear_SwapEnd
Gear_SwapTo_Speed:
TNT1 A 0 A_SelectWeapon("Wahwee_W1")
goto Gear_SwapEnd
Gear_SwapEnd:
TNT1 A 0 A_TakeInventory("MeisterWahwee_W")
stop

// SWAP_TO_SPEED:

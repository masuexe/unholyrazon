}

//
actor Wahwee_Always_Wins_BOOM : BasicExplosion {
  Translation "192:192=66:66", "198:198=249:249"
  DamageType "WahweeDamage"
  Obituary "Not yet, %o! It's not over yet..."
  Scale 8.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "Weapon")
    TNT1 A 0 Radius_Quake(6, 10, 0, 5, 0)
    TNT1 AAAAAA 0 A_SpawnItemEx("Wahwee_Always_Wins_Debris", 0, 0, 8, random(-10, 10), random(-10, 10), random(6, 12))
    TNT1 A 0 A_Explode(200, 160, 0, 0, 96)  // 192 radius
    6P03 ABCDEFG 2
    stop
  }
}

actor Wahwee_Always_Wins_XOOM : BasicExplosion {
  Translation "192:192=66:66", "198:198=249:249"
  DamageType "WahweeDamage"
  Obituary "Not yet, %o! It's not over yet..."
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")  //
    TNT1 A 0 A_Explode(25, 64, 0, 0, 32)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor Wahwee_Always_Wins_Debris : BasicProjectile {
  // A color change.
  Translation "192:192=41:41", "198:198=191:191"
  DamageType "WahweeDamage"
  Obituary "Not yet, %o! It's not over yet..."
  +RIPPER
  +HEXENBOUNCE
  -NOGRAVITY
  WallBounceFactor 0.8
  BounceFactor 0.6
  BounceCount 6
  // RenderStyle "Add"

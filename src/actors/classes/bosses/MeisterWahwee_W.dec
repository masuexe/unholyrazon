   Pickup:
    TNT1 A 0 A_SpawnItemEx("Wahwee_Always_Wins_XOOM", random(-64, 64), random(-64, 64), random(4, 64), 0, 0, 0, 0, 0)
    stop
  }
}

actor Wahwee_PlanBB_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ThrustThingZ(0, 65, 0, 1)  // 45
    TNT1 A 0 A_SpawnItemEx("Wahwee_Always_Wins_BOOM", 0, 0, 8)
    stop

8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1",-1,0,-16,0)
8H64 F 0 A_FireCustomMissile("Wahwee_Laser_Damage",-1,-16,0,0)
8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1",1,0,16,0)
8H64 E 1 A_FireCustomMissile("Wahwee_Laser_Damage",1,16,0,0)

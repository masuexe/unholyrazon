    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 7, "PhaseHold6")
    TNT1 A 1
    goto PhaseResume

   YouFool:
    // TNT1 A 0 A_JumpIfInventory("WahweeMadGears",1,"Ready_Gear")

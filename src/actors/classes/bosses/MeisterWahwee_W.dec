actor WahweeHPRegain_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 1.0, "GiveHealth")
    goto Pickup3
   GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 100)  // 100
    stop
   Pickup3:
    TNT1 A 0 A_GiveInventory("WahweeMadGears")
    stop
  }
}

actor Wahwee_PlanB_P : CustomInventory {

actor Wahwee_Polt : BasicProjectile
{
Translation "192:192=43:43","198:198=40:40","202:202=208:208","199:199=178:178"
damagetype "WahweeDamage"
Obituary "%o took a shock from \ctMeister \cjWahwee\c- (%k)'s EVIL power bolt."
Damage (75) //75 //50
Radius 25
Height 16
Speed 42 //35
scale 2.5
States
{
Spawn:
X_7D ABCD 1
Goto Flying
Flying:
X_7D N 1
X_7D M 1 A_SpawnItemEx("Wahwee_Polt_Trail",0,0,0,0,0,0,0,1)
loop
Death:
YMFX Q 2 A_SpawnItemEx("ElectrifyEffect")
UMFX BBCCDD 1 A_SpawnItemEx("Wahwee_Power_Polt_X",random(-32,32),random(-32,32),random(-32,32),0,0,0,0,1)
stop
}
}

actor Wahwee_Polt_Trail : BasicGraphicEffect
{
States
{
SpawnFrame:
X_7D IJKL 2
stop
}
}

actor Wahwee_Alt_Bolt : BasicProjectile
{
Translation "192:192=43:43", "198:198=171:171", "202:202=43:43"
damagetype "WahweeDamage"
Obituary "WHAT IS UP, %o? TODAY, I WILL SHOW YOU SOMETHING TRULY DEPLORABLE."
+NOCLIP
+NOINTERACTION
+DONTREFLECT
+THRUGHOST
Damage (50) //
radius 10 //
height 10 //
Speed 80 //80
reactiontime 8 //9
States
{
Spawn:
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF A 1 A_SpawnItemEx("Wahwee_BoltFX_A",0,0,0,0,0,0,0,1)
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF B 1 A_SpawnItemEx("Wahwee_BoltFX_B",0,0,0,0,0,0,0,1)
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF C 1 A_SpawnItemEx("Wahwee_BoltFX_C",0,0,0,0,0,0,0,1)
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF D 1 A_SpawnItemEx("Wahwee_BoltFX_D",0,0,0,0,0,0,0,1)
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF E 1 A_SpawnItemEx("Wahwee_BoltFX_E",0,0,0,0,0,0,0,1)
CLOF A 0 A_SpawnItemEx("Wahwee_Alt_Bolt_D",0,0,0,momx,momy,momz,0,8)
CLOF F 1 A_SpawnItemEx("Wahwee_BoltFX_F",0,0,0,0,0,0,0,1)
CLOF A 0 A_CountDown
Loop
}
}

actor Wahwee_Alt_Bolt_D : BasicProjectile
{
damagetype "WahweeGraze"

actor Wahwee_Rocket : BasicProjectile {
  // translation "204:204=3:3", "195:195=86:86", "202:202=82:82", "192:192=4:4","198:198=82:82"
  Translation "199:199=249:249", "192:192=4:4", "198:198=82:82"
  DamageType "WahweeDamage"
  Obituary "%o had been defeated by \ctMeister \cjWahwee\c- (%k)'s EVIL rocket."
  +SKYEXPLODE
  +THRUGHOST
  Damage (225)  // 175
  Radius 10
  Height 10
  Speed 38  // 20
  Scale 2.5  // 2.5
  States {
   Spawn:  // Rest in peace, CMDH. You were such a nice sprite.
    TNT1 A 0
    KLRC A 2 A_PlaySoundEx("weapon/FunniRocket", "Weapon", 1)  // A_SpawnItemEx("Wahwee_Rocket_FX",-14,0,0,0,0,0,0,0) //You were too good for this world...
    KLRC AA 0 A_SpawnItemEx("Wahwee_Rocket_FX", -14, random(-6, 6), random(-6, 6), 0, 0, random(2, 4), 0, 0)
    KLRC A 2 A_ScaleVelocity(1.11)
    KLRC AA 0 A_SpawnItemEx("Wahwee_Rocket_FX", -14, random(-6, 6), random(-6, 6), 0, 0, random(2, 4), 0, 0)
    KLRC A 2 A_ScaleVelocity(1.12)
    KLRC AA 0 A_SpawnItemEx("Wahwee_Rocket_FX", -14, random(-6, 6), random(-6, 6), 0, 0, random(2, 4), 0, 0)
    KLRC A 2 A_ScaleVelocity(1.13)
    KLRC AA 0 A_SpawnItemEx("Wahwee_Rocket_FX", -14, random(-6, 6), random(-6, 6), 0, 0, random(2, 4), 0, 0)
    KLRC A 2 A_ScaleVelocity(1.15)
   Limiter:  // 1 tic //2
    KLRC AA 0 A_SpawnItemEx("Wahwee_Rocket_FX", -14, random(-6, 6), random(-6, 6), 0, 0, random(2, 4), 0, 0)
    KLRC A 2
    loop
   Death:  // But ideas will always manifest, ahahaha.
    TNT1 A 0 A_PlaySoundEx("weapon/FunniRocketExplode", "Weapon")            // IF this doesn't sync right, then I'm doing something wrong.
    TNT1 A 1 A_SpawnItemEx("Wahwee_Rocket_Explode", 0, 0, 0, 0, 0, 0, 0, 0)  // But that's okay ! We're making lovely changes, aren't we?
    stop
  }
}


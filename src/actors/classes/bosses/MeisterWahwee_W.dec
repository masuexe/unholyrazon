    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 71)
   PhaseHold70:
    TNT1 A 2
   PhaseFrame71:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_PHASE_RESUME, 72)
   PhaseHold71:
    TNT1 A 2
    //
   PhaseFrame72:
    TNT1 A 0 A_GiveInventory("Wahwee_W1")
   PhaseFrame73:
    TNT1 A 0 A_GiveInventory("Wahwee_W2")
   PhaseFrame74:
    TNT1 A 0 A_Jump(128, "Gear_SwapTo_Power")
    goto Gear_SwapTo_Speed  //
    //
   Gear_SwapTo_Power:
   PhaseFrame75:
    TNT1 A 0 A_SelectWeapon("Wahwee_W2")
    goto Gear_SwapEnd
   Gear_SwapTo_Speed:
   PhaseFrame76:
    TNT1 A 0 A_SelectWeapon("Wahwee_W1")
    goto Gear_SwapEnd
   Gear_SwapEnd:
   PhaseFrame77:
    TNT1 A 0 A_TakeInventory("MeisterWahweePainFlag")
   PhaseFrame78:
    TNT1 A 0 A_TakeInventory("MeisterWahwee_W")
   PhaseFrame79:
    TNT1 A 0 A_TakeInventory("MeisterWahwee_W_Pissed")
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    stop

    // SWAP_TO_SPEED:
    // TNT1 A 0
    // TNT1 A 0 ACS_ExecuteAlways(CORE_ACS_191,0,APROP_Speed,150,100) //150 speed
    // TNT1 A 0 ACS_ExecuteAlways(CORE_ACS_191,0,APROP_JumpZ,14,1)
    // 8H64 AAAA 1 A_GiveInventory("UnholyBossAmmo200",2)
    // Goto Ready_Gear

    // SWAP_TO_POWER:
    // TNT1 A 0
    // TNT1 A 0 ACS_ExecuteAlways(CORE_ACS_191,0,APROP_Speed,90,100) //100 speed
    // TNT1 A 0 ACS_ExecuteAlways(CORE_ACS_191,0,APROP_JumpZ,10,1)
    // 8H64 FFFF 1 A_GiveInventory("UnholyBossAmmo200",2)
    // Goto Ready_Gear
  }
}

// Phase-change ExtraLife shell: Ready runs YouFool once, then swaps to Wahwee_W1/W2.
actor MeisterWahwee_W_Pissed : MeisterWahwee_W {
  States {
   Ready:
    TNT1 A 0 A_JumpIfInventory("UH_PhaseResume_F", 1, "PhaseResume")
    WICH H 0 A_JumpIfInventory("MeisterWahweeGetUpDone_F", 1, "ReadyAfterGetUp")
    WICH H 0 A_JumpIfInventory("WahweeMadGears", 1, "ReadyAfterGetUp")
    WICH H 0 A_GiveInventory("MeisterWahweeGetUpDone_F")
    WICH H 0 A_JumpIf(true, "YouFool")
    goto YouFool
   ReadyAfterGetUp:
    WICH H 0 A_GunFlash("Flash", true)
    goto ReadyX
  }
}

actor MeisterWahweeHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, 1)
    goto NoSwap
    TNT1 A 0 A_JumpIfInventory("WahweeMadGears", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("Wahwee_W1", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("Wahwee_W2", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("MeisterWahwee_W_Pissed", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("MeisterWahweePainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("MeisterWahweeSwapPissed_P")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor MeisterWahweeSwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UH_PhaseResume_F")
    TNT1 A 0 A_TakeInventory("MeisterWahweeGetUpDone_F")
    TNT1 A 0 A_GiveInventory("MeisterWahwee_W_Pissed")
    TNT1 A 0 A_TakeInventory("MeisterWahwee_W")
    stop
  }
}

actor MeisterWahweeGetUpDone_F : Once {}
actor MeisterWahweePainFlag : Once {}

// SPEED GEAR
actor Wahwee_W1 : BaseUnholyBossWep {
  Tag "$TAG_Wahwee_W1"
  Obituary "Upon the sight of such EVIL, %o got on their knees and became enslaved by \ctMeister \cjWahwee\c- (%k)."  // Polish this I guess?
  Inventory.Pickupmessage "\cjI am a mad scientist, is so cool! Sonofabitch."
  Weapon.AmmoType "UnholyBossAmmo200"   //
  Weapon.AmmoType2 "UnholyBossAmmo300"  //
  Inventory.Icon "WilyICap"
  States {
   Spawn:
    8H64 [ 1
    wait

   Deselect:
    8H64 A 0
    goto DeselectSwap
   Select:
    8H64 A 0
    goto SelectSwap

   Ready:
    8H64 A 0 A_PlaySoundEx("mmWilyWars/MegaRemoveWep", "SoundSlot6")
    8H64 A 0 ACS_NamedExecuteWithResult("core_chargecolor", MEISTERWAHWEE_DYE2)
    8H64 A 0 A_TakeInventory("UnholyBossAmmo300")
    8H64 A 0 A_GunFlash
    8H64 JIH 2 A_GiveInventory("UnholyBossAmmo200", 2)
    8H64 CHCH 4 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 0 A_PlaySoundEx("weapon/WilySpeedGear", "SoundSlot7")
    8H64 CDE 2 A_GiveInventory("UnholyBossAmmo200", 2)
    goto ReadyX
   ReadyX:  // Alt is useable whenever unless..
    8H64 A 2 A_GiveInventory("Wahwee_Ready8_P")
    8H64 A 0 A_JumpIfInventory("Wahwee_Cooldown", 1, "ReadyX")
    goto ReadyX0
   ReadyX0:
    8H64 A 2 A_GiveInventory("Wahwee_Ready0_P")
    loop

   Fire:
    8H64 A 1 A_JumpIfInventory("UnholyBossAmmo200", 200, "SPEED_GEAR_GRAZE")
    goto ReadyX
   SPEED_GEAR_GRAZE:
    8H64 EDC 2
   LaserHoldA:
    8H64 A 0 A_JumpIfInventory("UnholyBossAmmo200", 2, 1)
    goto EndLaser
    8H64 F 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H64 F 0 A_PlaySoundEx("weapon/electricshock", "Weapon")
    8H64 F 0 A_SpawnItemEx("Wahwee_Shock_FX1", 0, 0, 42, 0, 0, 0, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", -1, 0, -16, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_Damage", -1, -16, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", 1, 0, 16, 0)
    8H64 E 1 A_FireCustomMissile("Wahwee_Laser_Damage", 1, 16, 0, 0)
    8H64 F 0 A_ReFire("LaserHoldB")
    goto EndLaser
   LaserHoldB:
    8H64 A 0 A_JumpIfInventory("UnholyBossAmmo200", 2, 1)
    goto EndLaser
    8H64 F 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H64 F 0 A_PlaySoundEx("weapon/electricshock", "Weapon")
    8H64 F 0 A_SpawnItemEx("Wahwee_Shock_FX2", 0, 0, 42, 0, 0, 0, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", -1, 0, -16, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_Damage", -1, -16, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", 1, 0, 16, 0)
    8H64 E 1 A_FireCustomMissile("Wahwee_Laser_Damage", 1, 16, 0, 0)
    8H64 F 0 A_ReFire("LaserHoldC")
    goto EndLaser
   LaserHoldC:
    8H64 A 0 A_JumpIfInventory("UnholyBossAmmo200", 2, 1)
    goto EndLaser
    8H64 F 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H64 F 0 A_PlaySoundEx("weapon/electricshock", "Weapon")
    8H64 F 0 A_SpawnItemEx("Wahwee_Shock_FX3", 0, 0, 42, 0, 0, 0, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", -1, 0, -16, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_Damage", -1, -16, 0, 0)
    8H64 F 0 A_FireCustomMissile("Wahwee_Laser_FX1", 1, 0, 16, 0)
    8H64 E 1 A_FireCustomMissile("Wahwee_Laser_Damage", 1, 16, 0, 0)
    8H64 F 0 A_ReFire("LaserHoldA")
    goto EndLaser
   EndLaser:  // EFG
    8H64 EEDDCCDDEE 2 A_TakeInventory("UnholyBossAmmo200", 2)  // 10
    8H64 A 6  // 10
    8H64 A 1 A_WeaponReady(14)
    goto ReadyX

    //
   SPEED_GEAR_ALT_CHECKER_A:
    8H64 A 1 Offset(0, 47)
    8H64 A 0 A_JumpIfInventory("HE_WAS_BOSS", 2, "SPEED_GEAR_HUSSLE_AGAIN")
    goto SPEED_GEAR_ALT_END

   SPEED_GEAR_ALT_CHECKER_B:
    8H64 A 1 Offset(0, 49)
    8H64 A 0 A_JumpIfInventory("HE_WAS_BOSS", 2, "SPEED_GEAR_HUSSLE_AGAINERS")
    goto SPEED_GEAR_ALT_END

   SPEED_GEAR_ALT_CHECKER_C:
    8H64 A 1 Offset(0, 47)
    8H64 A 0 A_JumpIfInventory("HE_WAS_BOSS", 2, "SPEED_GEAR_HUSSLE")
    goto SPEED_GEAR_ALT_END
    //

   AltFire:
   SPEED_GEAR_ALT:
    8H64 A 0 A_SpawnItemEx("Wahwee_SpeedAlt_FX", 0, 0, 0, 0, 0, 0, 0, 1)  // 0
    8H64 A 0 A_GiveInventory("HE_WAS_BOSS", 100)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 27)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 9)
    8H64 A 1 Offset(0, 35)
    8H64 A 1 Offset(0, 40)
    8H64 A 1 Offset(0, 45)
   SPEED_GEAR_HUSSLE:  // This could be improved greatly.
    8H64 A 0 A_TakeInventory("HE_WAS_BOSS", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Cooldown", 5)  // Test
    8H64 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Shock_P")
    8H64 A 1 Offset(0, 46)  // 2
    8H64 A 0 A_ReFire("SPEED_GEAR_ALT_CHECKER_A")
    goto SPEED_GEAR_ALT_END

   SPEED_GEAR_HUSSLE_AGAIN:  // This could be improved greatly.
    8H64 A 0 A_TakeInventory("HE_WAS_BOSS", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Cooldown", 5)  // Test
    8H64 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Shock_P")
    8H64 A 1 Offset(0, 48)  // 2
    8H64 A 0 A_ReFire("SPEED_GEAR_ALT_CHECKER_B")
    goto SPEED_GEAR_ALT_END

   SPEED_GEAR_HUSSLE_AGAINERS:  // This could be improved greatly.
    8H64 A 0 A_TakeInventory("HE_WAS_BOSS", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Cooldown", 5)  // Test
    8H64 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H64 A 0 A_GiveInventory("Wahwee_Shock_P")
    8H64 A 1 Offset(0, 50)  // 2
    8H64 A 0 A_ReFire("SPEED_GEAR_ALT_CHECKER_C")
    goto SPEED_GEAR_ALT_END

   SPEED_GEAR_ALT_END:
    8H64 A 0 A_TakeInventory("HE_WAS_BOSS")
    8H64 A 0 A_GiveInventory("Wahwee_Cooldown", 75)  // 200 is too punishing.
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 27)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 9)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 22)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 7)
    8H64 A 1 Offset(0, 45)
    8H64 A 1 Offset(0, 40)
    8H64 A 1 Offset(0, 35)
    goto ReadyX

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("HE_WAS_BOSS", 1, "SPEED_FlashChecker")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)  // 1
    TNT1 A 1 A_TakeInventory("Wahwee_Cooldown", 1)
    loop
   SPEED_FlashChecker:
    TNT1 A 0 A_JumpIfInventory("HE_WAS_BOSS", 1, "SPEED_Flash")
    goto Flash
   SPEED_Flash:  // Fastest man alive.
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)  // 1
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 2)
    TNT1 A 1 A_ChangeVelocity(velx * 1.045, vely * 1.045, velz, CVF_REPLACE)
    goto SPEED_FlashChecker
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)  // 1
    TNT1 A 1 A_ChangeVelocity(velx * 1.035, vely * 1.035, velz, CVF_REPLACE)
    goto SPEED_FlashChecker
  }
}

// POWER GEAR
actor Wahwee_W2 : Wahwee_W1 {
  Tag "$TAG_Wahwee_W2"
  Inventory.Icon "WilyFCap"
  States {
   Spawn:
    8H64 [ 1
    wait

   Deselect:
    8H64 F 0
    goto DeselectSwap
   Select:
    8H64 F 0
    goto SelectSwap

   Ready:
    8H64 F 0 A_PlaySoundEx("mmWilyWars/MegaRemoveWep", "SoundSlot6")
    8H64 F 0 ACS_NamedExecuteWithResult("core_chargecolor", MEISTERWAHWEE_DYE3)
    8H64 F 0 A_TakeInventory("UnholyBossAmmo300")
    8H64 F 0 A_GunFlash
    8H64 EDC 2 A_GiveInventory("UnholyBossAmmo200", 2)
    8H64 HCHC 4 A_GiveInventory("UnholyBossAmmo200", 2)  // 2
    TNT1 A 0 A_PlaySoundEx("weapon/WilyPowerGear", "SoundSlot7")
    8H64 HIJ 2 A_GiveInventory("UnholyBossAmmo200", 2)
    goto ReadyX
   ReadyX:
    8H64 F 2 A_GiveInventory("Wahwee_Ready8_P")
    8H64 F 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX0")
    loop
   ReadyX0:
    8H64 F 2 A_GiveInventory("Wahwee_Ready0_P")
    loop

   Fire:
   Power_Charge:
    8H64 JIH 2
    8H64 H 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    goto Power_Charge_Start
   Power_Charge_Start:  // Alter if necessary.
    8H64 H 0 A_JumpIfInventory("Wily_Goes_Ham", 33, "Charge1")  // 17
    8H64 H 0 A_JumpIfInventory("Wily_Goes_Ham", 32, "ChargeStart")  // 16
    8H64 H 0 A_GiveInventory("UnholyBossAmmo200", 1 + CallACS("uh_CheckRune", RUNE_RAGE))  // 1
    8H64 A 0 A_GiveInventory("Wahwee_PowerShock_P")  //
    8H64 H 1 A_GiveInventory("Wily_Goes_Ham", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    8H64 H 0 A_ReFire("Power_Charge_Start")
    goto FirePower_1
   ChargeStart:
    8H64 H 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
    goto Charge1

   Charge1:
    8H64 H 0 A_JumpIfInventory("Wily_Goes_Ham", 80, "Charge2")
    8H64 H 0 A_GiveInventory("UnholyBossAmmo200", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    8H64 A 0 A_GiveInventory("Wahwee_PowerShock_P")  //
    8H64 H 1 A_GiveInventory("Wily_Goes_Ham", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    8H64 H 0 A_ReFire("Charge1")
    goto FirePower_2

   Charge2:
    8H64 H 0 A_GiveInventory("UnholyBossAmmo200", 1)
    8H64 A 0 A_GiveInventory("Wahwee_PowerShock_P")  //
    8H64 H 1 A_RailWait
    8H64 H 0 A_ReFire("Charge2")
    goto FirePower_3

   FirePower_1:
    8H64 IJ 2
    8H64 H 0 A_TakeInventory("Wily_Goes_Ham")
    8H64 H 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")  // Deflect 1?
    8H64 H 0 A_FireCustomMissile("Wahwee_Polt", 0, 0, 0, 0)
    8H64 JJF 2
    // 8H64 H 0 A_ReFire("Power_Charge")
    goto ReadyX
   FirePower_2:
    8H64 IJ 2
    8H64 H 0 A_TakeInventory("Wily_Goes_Ham")
    8H64 H 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H64 H 0 A_ChangeVelocity(-cos(pitch) * 10, 0, sin(pitch) * 8, CVF_RELATIVE)
    8H64 H 0 A_FireCustomMissile("Wahwee_Power_Bolt", 0, 0, 0, 0)  // Wahwee_Polt_Trail
    8H64 JJJFF 2
    // 8H64 H 0 A_ReFire("Power_Charge")
    goto ReadyX
   FirePower_3:  //
    8H64 IJ 2
    8H64 H 0 A_TakeInventory("Wily_Goes_Ham")
    8H64 H 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    8H64 H 0 A_ChangeVelocity(-cos(pitch) * 20, 0, sin(pitch) * 16, CVF_RELATIVE)
    8H64 H 0 A_FireCustomMissile("Wahwee_Shazam_Blast", 0, 0, 0, 0)
    8H64 JJJJJJJFF 2
    goto ReadyX

   AltFire:
   POWER_GEAR_ALT:
    8H64 IHHI 1
   ThisMoveBelongsInAMuseum:
    8H64 F 0 A_TakeInventory("UnholyBossAmmo200")
    8H64 F 0 A_PlaySound("wep_L/ElectricianFire2", "Weapon")
    8H64 H 0 A_FireCustomMissile("Wahwee_Alt_Bolt", 0, 0, 0, 0)
    8H64 JJF 2
    goto ReadyX
  }
}

actor WahweeMadGears : Once {}
actor WahweeMechaPower : Once {}

actor SPEED_GEAR_BOSS : Once {}
actor POWER_GEAR_BOSS : Once {}

actor Wahwee_Cooldown : Inventory {
  Inventory.MaxAmount 200  // 100
}

actor Wily_Goes_Ham : Inventory {
  Inventory.MaxAmount 80  // 100
}

actor HE_WAS_BOSS : Inventory {
  Inventory.MaxAmount 100
}

actor Wahwee_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300, "PickupNormal")
    TNT1 A 0 A_Jump(256, "PickupNoSwitch")
    goto PickupNoSwitch
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupNoSwitch:
    TNT1 A 0 A_WeaponReady(WRF_DISABLESWITCH)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    stop
  }
}
actor Wahwee_Ready8_P : Wahwee_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupNoSwitch:
    TNT1 A 0 A_WeaponReady(8 + 64)
    goto Ammo
  }
}


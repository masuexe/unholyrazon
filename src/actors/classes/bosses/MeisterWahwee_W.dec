actor Wahwee_Laser_FX1
{
Translation "202:202=205:205","199:199=195:195"
PROJECTILE
// damagetype "WahweeZAPDamage"
// Obituary "%o was electrocuted by \ctMeister \cjWahwee\c- (%k)'s EVIL thunder power."
+THRUACTORS
+DONTBLAST
+DONTREFLECT
+CLIENTSIDEONLY
+FORCEYBILLBOARD
+PAINLESS
damage (0)
Radius 8
Height 8
speed 30
scale 1.5
states
{
Spawn:
ESHB A 0
ESHB A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
ESHB A 0 A_JumpIf(true, "SpawnFrame")
SpawnFrame:
ESHB A 0 A_SetPitch(pitch+1)
ESHB A 0 A_JumpIf(pitch>WAHWEE_ZAPRANGE,"Death2")
ESHB A 0 A_SpawnItemEx("Wahwee_Laser_FX1",0,0,0,momx,momy,momz,0,553)
ESHB A 1 A_Stop
stop
Death:
ESHB A 1 A_SpawnItemEx("Wahwee_Laser_Puff_Noise",0,0,0,0,0,0,0,33)
stop
Death2:
TNT1 A 0
TNT1 A 0 A_SetScale(2.5)
ESHB D 1
stop
}
}


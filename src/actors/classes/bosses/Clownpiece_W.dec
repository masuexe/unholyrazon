//"Fake Apollo"
//"Apollo Hoax Theory"
//Moon Dream "Eclipse Nightmare"
actor Clownpiece_MOON : ProjSpawnFuncActor  // BasicExplosion
{
Translation "0:0=42:42","192:192=48:48","198:198=224:224","195:195=144:144"
Damagetype "Clownpiece"
Obituary "%o went insane from touching %k's Apollo Hoax Theory."
+FORCEXYBILLBOARD
-SOLID
+MISSILE
+DONTSPLASH
+DONTBLAST
+DONTDRAIN
+DONTREFLECT
+DONTRIP
+GHOST
+SHOOTABLE
+NOBLOOD
+NOCLIP
+NORADIUSDMG
+NOTIMEFREEZE
+NOGRAVITY
+NOTARGETSWITCH
+BRIGHT
PainChance 0
Species "Clownpiece_MOON"
Health 0x7ffffffd
Reactiontime 100
Renderstyle "Translucent"
Alpha 0.75
Scale 2.5
states
{
Spawn:
8Q12 N 0
8Q12 N 0 //A_PlaySoundEx("","Weapon")
SpawnL:
8Q12 N 0 A_Explode(random(45,55),32,0,0,32)
8Q12 N 0 A_SpawnItemEx("Clownpiece_FULLMOON_SHOT",0,0,8,60,0,0,0,0)
8Q12 N 1 A_Warp(2,100,0,32,3,28)
8Q12 N 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
8Q12 N 0 A_JumpIfInTargetInventory("GenericBossFlag200",1,"SpawnL") //A_CountDown
Goto SpinTime
SpinTime:
8Q12 N 0 //A_PlaySoundEx("","Weapon")
Spinning:
8Q12 N 0 A_Explode(random(45,55),32,0,0,32)
8Q12 N 1 A_Warp(2,reactiontime,0,32+80-reactiontime*0.80,9,28)
8Q12 N 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
8Q12 N 0 A_Countdown
Loop
Death:
TNT1 A 2
Stop
}
}


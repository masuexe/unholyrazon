// Hell Sign "Flash and Stripe"
// Hell Sign "Star and Stripe"
actor Clownpiece_W4 : Clownpiece_SpellWep {
  States {
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 4, 30)
    goto SpellBreakDone
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_W4_P")
    loop
   Fire:
    8I12 C 0 A_PlaySoundEx("Touhou/Tan0", "Weapon")
    8I12 CCC 0 A_FireCustomMissile("ClownpieceStar_B", 0, 0, random(-256, 256), 0)
    8I12 CBA 2
    8I12 B 0 A_ReFire
   FireEnd:
    8I12 BA 2
    goto Ready2
   AltFire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W4_P")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 100, "StripeFire")
    Goto Ready2
   StripeFire:
    8I12 A 0 A_TakeInventory("UnholyBossAmmo200", 100)
    8I12 A 0 A_FireCustomMissile("ClownpieceStripeCurtainShot")
    goto FireEnd
   FireEnd:
    8I12 CBCB 2
    8I12 A 8
    Goto Ready2
  }
}


// Spell-card timeout on W8: strip revive powers then kill (any Clownpiece_Wn).
actor ClownpieceTimeoutKill_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W1", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W2", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W3", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W4", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W5", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W6", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W7", 1, "KillGo")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W8", 1, "KillGo")
    goto Skip
   KillGo:
    TNT1 A 0 A_TakeInventory("ClownpieceSurvivalInvuln_F")
    TNT1 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    TNT1 A 0 A_TakeInventory("PlayerPropertyExtraLife", 999)
    TNT1 A 0 A_TakeInventory("PlayerPropertyExtraLifeNative", 999)
    TNT1 A 0 A_TakeInventory("PlayerPropertyBuddha", 999)
    TNT1 A 0 A_TakeInventory("PlayerPropertyBuddhaOn")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 DamageThing(10000)
    stop
   Skip:
    TNT1 A 0
    stop
  }
}

actor Clownpiece_W1 : Clownpiece_W {
  States {
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_W1_P")
    loop
   Fire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W1_P")
   FireRed:
    // Shot 1: 0 deg (center forward slash - high wave)
    8I12 B 1 Offset(-10, 25)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(5, 22) A_FireCustomMissile("ClownpieceStar", 0, 0, 0, 0)
    8I12 B 1 Offset(20, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 2: +7 deg (high swing right)
    8I12 B 1 Offset(35, 18)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(50, 19) A_FireCustomMissile("ClownpieceStar", 7, 0, 0, 0)
    8I12 B 1 Offset(65, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 3: +14 deg (right apex high wave)
    8I12 B 1 Offset(78, 25)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(85, 27) A_FireCustomMissile("ClownpieceStar", 14, 0, 0, 0)
    8I12 B 1 Offset(78, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 4: +7 deg (returning leftward)
    8I12 B 1 Offset(62, 28)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(42, 26) A_FireCustomMissile("ClownpieceStar", 7, 0, 0, 0)
    8I12 B 1 Offset(22, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 5: 0 deg (center slash leftward)
    8I12 B 1 Offset(8, 23)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-8, 22) A_FireCustomMissile("ClownpieceStar", 0, 0, 0, 0)
    8I12 B 1 Offset(-24, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 6: -7 deg (high swing left)
    8I12 B 1 Offset(-38, 18)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-52, 19) A_FireCustomMissile("ClownpieceStar", -7, 0, 0, 0)
    8I12 B 1 Offset(-66, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 7: -14 deg (left apex high wave)
    8I12 B 1 Offset(-78, 25)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-85, 27) A_FireCustomMissile("ClownpieceStar", -14, 0, 0, 0)
    8I12 B 1 Offset(-78, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 8: -7 deg (returning rightward)
    8I12 B 1 Offset(-62, 28)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-42, 26) A_FireCustomMissile("ClownpieceStar", -7, 0, 0, 0)
    8I12 B 1 Offset(-22, 25) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire("FireRed")
    goto FireEndDelay

   FireEndDelay:
    8I12 B 1 Offset(-5, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 1 Offset(0, 28)
    8I12 A 2 Offset(0, 30)
    8I12 A 2 Offset(1, 32)
    Goto Ready2

   AltFire:
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 1)
    goto Ready2
    // Torch windup: pulled back and down
    8I12 B 1 Offset(-12, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 1 Offset(-24, 38)
    8I12 B 1 Offset(-30, 42)
    // High forward heavy thrust: emit laser beam and burst flame!
    8I12 A 0 A_GiveInventory("ClownpieceKickerfire_P")
    8I12 C 1 Offset(12, 14)
    8I12 C 2 Offset(20, 10)
    8I12 C 2 Offset(16, 12)
    // Recoil & return to ready
    8I12 B 2 Offset(8, 20)
    8I12 B 1 Offset(3, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 A 2 Offset(1, 32)
    goto Ready2
  }
}

// Spell weapons that are not W1: stub AltFire so they do not inherit base orberino.
// Do not inherit W1/W2 as inventory classes — TakeInventory/CheckInventory use IsKindOf.
actor Clownpiece_SpellWep : Clownpiece_W {
  States {
   Ready:
    goto ReadySpell
   AltFire:
    8I12 A 0
    goto Ready2
  }
}

// Hell Sign "Hell Eclipse"
// Hell Sign "Eclipse of Hell"
actor Clownpiece_W2 : Clownpiece_SpellWep {
  States {
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 2, 30)
    goto SpellBreakDone
    // Time Sign: keep SpellBreak invuln for the whole timer (do not re-stack invuln)
   SpellBreakDone:
    8I12 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    8I12 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    8I12 A 0 A_GiveInventory("ClownpieceSurvivalInvuln_F")
    // Invuln already on from SpellBreak; calling core_invulnerableplayer again would STACK
    8I12 A 0 A_GiveInventory("UnholyBossAmmo200", 200)
    8I12 A 0 A_GunFlash("Flash", true)
    Goto Ready2
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_W2_P")
    loop
   Fire:
   AltFire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W2_P")
    8I12 A 0 A_JumpIfInventory("ClownpieceOrbFlag", 1, "OrbDie")
    8I12 A 0 A_PlaySoundEx("wep_L/ThLunaNight123", "Weapon")
    8I12 A 0 A_GiveInventory("DuoBusterFlag")
   AltfireRed:
    // Stage 1: Raising torch to summon moon (举火引月)
    8I12 B 1 Offset(-10, 25) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 1 Offset(-4, 18)
    8I12 A 0 A_GiveInventory("ClownpieceOrbFlag")
    8I12 A 0 A_SpawnItemEx("SpawnClownpieceOrberinoRed_H")
    8I12 C 1 Offset(0, 14)
    8I12 C 2 Offset(1, 22)
    8I12 B 2 Offset(1, 32)
    goto OrbReady
   OrbReady:
    // Stage 2: Stable channeling while moon is active (不带Offset以防止与A_WeaponReady冲突造成重置抖动)
    8I12 C 2 A_WeaponReady(8)
    8I12 C 2 A_TakeInventory("UnholyBossAmmo200", 3)
    8I12 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, "OrbReady")
   OrbDie:
    // Stage 3: Downward strike & moon detonation (破月重斩引爆)
    8I12 A 0 A_TakeInventory("ClownpieceOrbFlag")
    8I12 B 1 Offset(-8, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 C 1 Offset(5, 18)
    8I12 C 2 Offset(16, 28)
    8I12 C 2 Offset(22, 42)
    8I12 B 2 Offset(12, 36)
    8I12 B 1 Offset(5, 34) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 A 2 Offset(1, 32)
    8I12 A 6
    Goto Ready2
  }
}


actor ClownpieceLaserWarp1 : BasicExplosion {
  Damagetype "Clownpiece"
  Obituary "%o went insane from touching %k's Flash and Stripe."
  Reactiontime 1
  +FORCEXYBILLBOARD
  Args 0, -100
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(3, angle)
    TNT1 A 0 A_Warp(2, Args[0], Args[1], 32, 0, 8)
   SpawnFrame:
    Y_8G AABB 1  // A_Warp(2,0,Args[0],32,0,24)
    Y_8G CCBBAABBCCBBAABBCCC 1  // A_Warp(2,0,Args[0],32,0,24)
    Y_8G C 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    Y_8G C 0  // A_PlaySoundEx("weapon/lshot","Voice")
    Y_8G C 1  // A_Warp(2,0,Args[0],32,0,24)
    Y_8G C 0 A_PlaySoundEx("Touhou/Lazer0", "Auto")
    Y_8G C 0 A_SpawnItemEx("ClownpieceLaser", 0, 0, 0, cos(-pitch)*50, 0, sin(-pitch)*50, 0+Args[3], 33)
    Y_8G C 1 A_Countdown
    wait
   Death:
    Y_8G IJK 2
    Stop
  }
}


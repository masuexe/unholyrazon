// Hellfire "Graze Inferno"
// Hellfire "Infernal Essence of Grazing"
actor ClownpieceItemShot : ProjSpawnFuncActor  // BasicProjectile
{
  Damagetype "Clownpiece"
  Obituary "%o went insane from touching %k's Graze Inferno."
  +MISSILE
  -SOLID
  +NOTELEPORT
  +SHOOTABLE
  +NOBLOOD
  +RIPPER
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +ALLOWBOUNCEONACTORS
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  renderstyle "translucent"
  species "Clownpiece_GrazeInferno"
  Painchance 0
  Damagefactor "Clownpiece", 0.0
  Damagefactor "ignition", 0.0
  mass 0x7ffffffd
  health 1500
  bouncecount 10
  bouncefactor 1.0
  wallbouncefactor 1.0
  Reactiontime 20
  damage (11)
  Radius 16
  Height 16
  speed 4
  scale 2.5
  States {
   Spawn:
    6P06 A 0
    6P06 A 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6553, 192)
    6P06 A 0 ThrustThingZ(0, 4, 0, 1)
   Spawn2:
    6P06 ABCD 3 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    6P06 A 0 A_CountDown
    Loop
   Death:
    TMFX A 0 A_SetGravity(0.0)
    TMFX ABCD 3
    stop
  }
}

//
actor ClownpieceStar : BasicProjectile {
  Translation "4:4=169:169", "192:192=16:16", "198:198=40:40", "0:0=191:191"
  Damagetype "Clownpiece"
  Obituary "%o went insane from touching %k's Spangled Stars."
  RenderStyle "Translucent"
  Alpha 0.95
  Damage (25)  // 10 ~ 50
  Radius 16
  Height 16
  Speed 35  // 70
  Scale 0.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    TNT1 A 0 A_Jump(256, "S_1", "S_2", "S_3", "S_4", "S_5", "S_6", "S_7", "S_8", "T_1", "T_2", "T_3", "T_4", "T_5", "T_6", "T_7", "T_8")
   S_1:
    8Q12 SSTTUUVV 1 A_SetScale(ScaleX+0.25)
    goto S_L
   S_2: 8Q12 SSTTUUVV 1 A_SetScale(ScaleX+0.25)goto S_L+1
   S_3: 8Q12 STTUUVVS 1 A_SetScale(ScaleX+0.25)goto S_L+2
   S_4: 8Q12 TTUUVVSS 1 A_SetScale(ScaleX+0.25)goto S_L+3
   S_5: 8Q12 TUUVVSST 1 A_SetScale(ScaleX+0.25)goto S_L+4
   S_6: 8Q12 UUVVSSTT 1 A_SetScale(ScaleX+0.25)goto S_L+5
   S_7: 8Q12 UVVSSTTU 1 A_SetScale(ScaleX+0.25)goto S_L+6
   S_8: 8Q12 VVSSTTUU 1 A_SetScale(ScaleX+0.25)goto S_L+7
   T_1: 8Q12 VVUUTTSS 1 A_SetScale(ScaleX+0.25)goto T_L
   T_2: 8Q12 VUUTTSSV 1 A_SetScale(ScaleX+0.25)goto T_L+1
   T_3: 8Q12 UUTTSSVV 1 A_SetScale(ScaleX+0.25)goto T_L+2
   T_4: 8Q12 UTTSSVVU 1 A_SetScale(ScaleX+0.25)goto T_L+3
   T_5: 8Q12 TTSSVVUU 1 A_SetScale(ScaleX+0.25)goto T_L+4
   T_6: 8Q12 TSSVVUUT 1 A_SetScale(ScaleX+0.25)goto T_L+5
   T_7: 8Q12 SSVVUUTT 1 A_SetScale(ScaleX+0.25)goto T_L+6
   T_8: 8Q12 SVVUUTTS 1 A_SetScale(ScaleX+0.25)goto T_L+7

   S_L:
    8Q12 SSTTUUVV 1
    loop
   T_L:
    8Q12 VVUUTTSS 1
    loop

   Death:
    6P0K I 0 A_SetScale(2.5)
    6P0K IKJ 2
    stop
  }
}

actor ClownpieceStar_B : ClownpieceStar {
  Translation "4:4=196:196", "192:192=205:205", "198:198=75:75", "0:0=244:244"
}

// Hell Sign "Star and Stripe" — forward curtain drops L/R horizontal stripe walls (coverage, not aim)

// Flies forward; every few tics drops left then right emitters at 3 heights.
actor ClownpieceStripeCurtainShot {
  Projectile
  +NOINTERACTION
  +NOCLIP
  +NOGRAVITY
  Height 0
  Radius 0
  Speed 22
  Damage (0)
  Reactiontime 55
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Touhou/Tan1", "Auto")
   Drop:
    // Left wall (fires right / -90). SXF_TRANSFERPOINTERS=32 keeps boss as Target for damage.
    TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterL", 0, -180, 0, 0, 0, 0, 0, 32)
    // TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterL", 0, -180, 40, 0, 0, 0, 0, 32)
    // TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterL", 0, -180, 80, 0, 0, 0, 0, 32)
    TNT1 A 6
    // Right wall (fires left / +90), staggered for stripe rhythm
    TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterR", 0, 180, 0, 0, 0, 0, 0, 32)
    // TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterR", 0, 180, 40, 0, 0, 0, 0, 32)
    // TNT1 A 0 A_SpawnItemEx("ClownpieceStripeEmitterR", 0, 180, 80, 0, 0, 0, 0, 32)
    TNT1 A 6 A_Countdown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

// Base emitter: warn then stream horizontal beams (Args[0] = yaw offset)
actor ClownpieceStripeEmitter {
  +NOINTERACTION
  +NOCLIP
  +NOGRAVITY
  +MISSILE
  +FORCEXYBILLBOARD
  +BRIGHT
  Height 0
  Radius 0
  Speed 0
  Scale 1.25
  Reactiontime 12
  Args 0
  States {
   Spawn:
    TNT1 A 0
   Warn:
    MXP1 E 2
    MXP1 D 2
    MXP1 C 2
    MXP1 B 2
    MXP1 A 2 A_PlaySoundEx("misc/quicktrap", "Auto")
   Fire:
    MXP1 A 0 A_CustomMissile("ClownpieceStripeBeam", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 A 1 A_CustomMissile("ClownpieceStripeBeamFX", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 A 0 A_Countdown
    MXP1 B 0 A_CustomMissile("ClownpieceStripeBeam", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 B 1 A_CustomMissile("ClownpieceStripeBeamFX", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 B 0 A_Countdown
    Goto Fire
   Death:
    TNT1 A 1
    Stop
  }
}

// Left of curtain → beams right (-90)
actor ClownpieceStripeEmitterL : ClownpieceStripeEmitter {Args -90}

// Right of curtain → beams left (+90)
actor ClownpieceStripeEmitterR : ClownpieceStripeEmitter {Args 90}

// Legacy ACS uh_ClownpieceStripeVolley spawn name — warn then fire toward facing (unused by W4)
actor ClownpieceStripeSpawner : ClownpieceStripeEmitter {
  Args 0
}

actor ClownpieceStripeBeam : BasicProjectile {
  Translation "192:192=39:39", "198:198=175:175"

    TNT1 A 8 A_SpawnItemEx("ClownpieceLaserWarp3", 0, 0, 0, 0, 0, 0, 0, 5)
    stop
   SpawnSpread:
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp1", 0, 0, 0, 0, 0, 0, 0, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp1", 0, 0, 0, 0, 0, 0, 15, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp1", 0, 0, 0, 0, 0, 0, -15, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp4", 0, 0, 0, 0, 0, 0, 0, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp4", 0, 0, 0, 0, 0, 0, 15, 5)
    TNT1 A 8 A_SpawnItemEx("ClownpieceLaserWarp4", 0, 0, 0, 0, 0, 0, -15, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp2", 0, 0, 0, 0, 0, 0, 0, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp2", 0, 0, 0, 0, 0, 0, 15, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp2", 0, 0, 0, 0, 0, 0, -15, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp3", 0, 0, 0, 0, 0, 0, 0, 5)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp3", 0, 0, 0, 0, 0, 0, 15, 5)
    TNT1 A 8 A_SpawnItemEx("ClownpieceLaserWarp3", 0, 0, 0, 0, 0, 0, -15, 5)

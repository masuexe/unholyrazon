// Inferno "Striped Abyss" — dual red horizontal stripe walls flanking a long channel
actor ClownpieceAbyssWall {
  PROJECTILE
  +NOINTERACTION
  +NOCLIP
  +NOGRAVITY
  +FORCEXYBILLBOARD
  +BRIGHT
  Height 0
  Radius 0
  Speed 20
  Scale 1.5
  Reactiontime 70
  Args 0
  Damagetype "Clownpiece"
  Obituary "%o went insane from touching %k's Striped Abyss."
  States {
   Spawn:
    TNT1 A 0
   Warn:
    MXP1 E 2
    MXP1 D 2
    MXP1 C 2
    MXP1 B 2
    MXP1 A 2 A_PlaySoundEx("misc/quicktrap", "Auto")
   Fire:
    // One red band at this runner's height (spawnheight set by FireCustomMissile)
    MXP1 A 0 A_CustomMissile("ClownpieceAbyssBeam", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 A 1 A_CustomMissile("ClownpieceAbyssBeamFX", 0, 0, Args[0], CMF_AIMDIRECTION, 0)
    MXP1 A 0 A_Countdown
    Goto Fire
   Death:
    TNT1 A 1
    Stop
  }
}


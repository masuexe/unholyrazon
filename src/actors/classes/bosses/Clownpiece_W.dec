actor ClownpieceLaserWarp2_3R : ClownpieceLaserWarp1 {Args -18, 14}
actor ClownpieceLaserWarp2_4L : ClownpieceLaserWarp1 {Args 40, -20}
actor ClownpieceLaserWarp2_4R : ClownpieceLaserWarp1 {Args 40, 20}

actor ClownpieceLaserWarp_3 : ClownpieceLaserWarp1 {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(3, angle)
    goto SpawnFrame
   SpawnFrame:
    Y_8G AABB 1
    Y_8G CCBBAABBCCBBAABBCCC 1
    Y_8G C 1 A_GiveToTarget("UH_TargetMarker")
    Y_8G C 1 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget") + PLN_TARGETPOINT_OFFSET, 32)
    Y_8G C 0 A_PlaySoundEx("Touhou/Lazer0", "Auto")
    Y_8G C 0 A_SpawnItemEx("ClownpieceLaser", 0, 0, 0, cos(-pitch)*50, 0, sin(-pitch)*50, 0+Args[3], 33)
    Y_8G C 1 A_Countdown
    wait
  }
}


  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W5")
    TNT1 A 0 A_TakeInventory("Clownpiece_W4")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 5)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 5)
    stop
  }
}

actor ClownpieceHealthCheck_W5_P : ClownpieceHealthCheck_P {
  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W6")
    TNT1 A 0 A_TakeInventory("Clownpiece_W5")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 6)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 6)
    stop
  }
}

actor ClownpieceHealthCheck_W6_P : ClownpieceHealthCheck_P {
  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W7")
    TNT1 A 0 A_TakeInventory("Clownpiece_W6")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 7)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 7)
    stop
  }
}

actor ClownpieceHealthCheck_W7_P : ClownpieceHealthCheck_P {
  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W8")
    TNT1 A 0 A_TakeInventory("Clownpiece_W7")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 8)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 8)
    stop
  }
}

// Multi-Clownpiece shared phase: give to other survivors still on Wn-1.
// Skip if already on target gun, dead, mid-break, or no ExtraLife (W8 true-death path).
actor ClownpieceForceSwap_W2_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W2", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("ClownpiecePainFlag", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, "DoSwap")
    goto Skip
   DoSwap:
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W1", 1, "Swap")
    goto Skip
   Swap:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W2")
    TNT1 A 0 A_TakeInventory("Clownpiece_W1")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 2)
    stop
   Skip:
    TNT1 A 0
    stop
  }
}

actor ClownpieceForceSwap_W3_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W3", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("ClownpiecePainFlag", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, "DoSwap")
    goto Skip
   DoSwap:
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W2", 1, "Swap")
    goto Skip
   Swap:
    TNT1 A 0 A_TakeInventory("ClownpieceSurvivalInvuln_F")
    TNT1 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_StripInvulnStacks", 0)
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W3")
    TNT1 A 0 A_TakeInventory("Clownpiece_W2")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 3)
    stop
   Skip:
    TNT1 A 0
    stop
  }
}

actor ClownpieceForceSwap_W4_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W4", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("ClownpiecePainFlag", 1, "Skip")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, "DoSwap")
    goto Skip
   DoSwap:
    TNT1 A 0 A_JumpIfInventory("Clownpiece_W3", 1, "Swap")
    goto Skip
   Swap:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")

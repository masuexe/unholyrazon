actor ClownpieceLaser3_H : ClownpieceLaserRed_H {
  var int user_x;
  var int user_y;
  args 80, 80
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_x", random(-Args[0], Args[0]))
    TNT1 A 0 A_SetUserVar("user_y", random(-Args[1], Args[1]))
    TNT1 A 0 A_Warp(2, user_x, user_y, 32, 0, 8)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaserWarp_3", 0, 0, 0, 0, 0, 0, 0, 5)
    TNT1 A 0 A_Warp(2, user_x, -user_y, 32, 0, 8)

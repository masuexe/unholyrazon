// 8 spell lives: W1–W8. Flash polls HP; on life break Give Wn+1 / Take Wn.
// Each new weapon Ready heals, consumes ExtraLife, starts uh_SpellCardStart.

// TODO: optimize hud sprites: replace buster with torch sprites

// TEMP Phase 1 test helpers (give from console)
actor UH_SpellCardCapture_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_SpellCardCapture", 0)
    stop
  }
}

actor UH_SpellCardFail_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_SpellCardFail", 0)
    stop
  }
}

actor Clownpiece_W_ScriptBar : ScriptBar {}
actor Clownpiece_W1_ScriptBar : ScriptBar {}
actor Clownpiece_W2_ScriptBar : ScriptBar {}
actor Clownpiece_W3_ScriptBar : ScriptBar {}
actor Clownpiece_W4_ScriptBar : ScriptBar {}
actor Clownpiece_W5_ScriptBar : ScriptBar {}
actor Clownpiece_W6_ScriptBar : ScriptBar {}
actor Clownpiece_W7_ScriptBar : ScriptBar {}
actor Clownpiece_W8_ScriptBar : ScriptBar {}
actor Clownpiece_W : BaseUnholyBossWep {
  Tag "$TAG_Boss112_W"
  Obituary "%o went insane from touching %k's torch."
  Inventory.Pickupmessage "The moon is property of the United States."
  Weapon.AmmoGive 400
  Weapon.AmmoType "UnholyBossAmmo200"
  States {
   Spawn:
    8I12 [ 1
    wait

   Deselect:
    8I12 A 0
    goto DeselectSwap
   Select:
    8I12 A 0
    goto SelectSwap

   Ready:
    8I12 A 0 A_JumpIfInventory("ClownpieceGetUpDone_F", 1, "ReadyAfterGetUp")
    goto FirstSpawn
    // W2–W8 override Ready to jump here after a life break (GetUpDone cleared).
   ReadySpell:
    8I12 A 0 A_JumpIfInventory("ClownpieceGetUpDone_F", 1, "ReadyAfterGetUp")
    goto SpellBreak
   FirstSpawn:
    8I12 A 0 A_GiveInventory("ClownpieceGetUpDone_F")
    // 7 ExtraLife + this W1 = 8 lives. Skip if morphActorToBoss already granted.
    8I12 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, "FirstSpawnHud")
    8I12 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 7, ELP_NATIVE)
   FirstSpawnHud:
    8I12 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CLOWNPIECE_DYE)
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 1, 30)
    8I12 A 0 A_GunFlash("Flash", true)
    Goto Ready2
   SpellBreak:
    8I12 A 0 A_GiveInventory("ClownpieceGetUpDone_F")
    8I12 A 0 A_GiveInventory("ClownpiecePainFlag")
    8I12 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I12 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    8I12 A 0 A_Stop
    8I12 A 0 A_TakeInventory("GenericBossFlag200")
   SpellBreakHeal:
    8I12 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 200)
    8I12 A 1 A_JumpIf(CallACS("uh_Health", UHEALTH_IS_FULL), "SpellBreakEnd")
    loop
   SpellBreakEnd:
    8I12 A 0 A_TakeInventory("ClownpiecePainFlag")
    8I12 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
    // Dynamic jump so W2–W8 StartSpell overrides are used (static goto binds parent)
    8I12 A 0 A_Jump(256, "StartSpell")
    Stop
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 1, 30)
    goto SpellBreakDone
   SpellBreakDone:
    8I12 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    // End Time Sign invuln if leaving W2/W8; then start normal 3s phase invuln
    8I12 A 0 A_TakeInventory("ClownpieceSurvivalInvuln_F")
    8I12 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    8I12 A 0 A_GiveInventory("ClownpiecePhaseInvulnTics", 105)  // 3s @ 35tic
    8I12 A 0 A_GiveInventory("UnholyBossAmmo200", 200)
    8I12 A 0 A_GunFlash("Flash", true)
    Goto Ready2
   ReadyAfterGetUp:
    8I12 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CLOWNPIECE_DYE)
    8I12 A 0 A_GunFlash("Flash", true)
    Goto Ready2
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_P")
    loop
   Ready1:
    8I12 A 0 A_JumpIfHealthLower(2, "TryLifeBreak")
    8I12 A 2 A_GiveInventory("Clownpiece_Ready8_P")
    Goto Ready2
   Ready2:
    8I12 A 0 A_GunFlash("Flash", true)
    8I12 A 0 A_JumpIfHealthLower(2, "TryLifeBreak")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Ready3")
    8I12 A 2 A_GiveInventory("Clownpiece_Ready8_P")
    loop
   Ready3:
    8I12 A 0 A_JumpIfHealthLower(2, "TryLifeBreak")
    8I12 A 0 A_JumpIfInventory("VivifyDelay4", 1, "Ready1")
    8I12 A 2 A_GiveInventory("Clownpiece_Ready0_P")
    loop
   TryLifeBreak:
    8I12 A 1 A_GunFlash("Flash", true)
    goto Ready2

    // Reload:
    // 8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 67, "DollarGive")
    // Goto Ready2
    // DollarGive:
    // 8I12 A 0 A_GiveInventory("VivifyDelay4")
    // 8I12 A 0 A_TakeInventory("UnholyBossAmmo200",67)
    // 8I12 A 2 A_FireCustomMissile("ClownpieceItemRNG_H",0,0,0,0)
    // 8I12 A 1
    // Goto Ready2

   Fire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_P")
    8I12 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireBlueStart")
    8I12 A 0 A_GiveInventory("DuoBusterFlag")
   FireRed:
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", 0, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", 7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", 14, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", 7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", 0, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", -7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", -14, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar", -7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire("FireRed")
    goto FireEndDelay

   FireBlueStart:
    8I12 C 0 A_TakeInventory("DuoBusterFlag")
   FireBlue:
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", 0, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", -7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", -14, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", -7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", 0, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", 7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", 14, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 2 A_FireCustomMissile("ClownpieceStar_B", 7, 0, 0, 0)
    8I12 B 1
    8I12 B 0 A_Refire("FireBlue")
    goto FireEndDelay

   FireEndDelay:
    // 8I12 C 0 A_TakeInventory("GenericBossFlag100")
    8I12 B 2
    8I12 A 4
    Goto Ready2

   FireMoon:
    8I12 A 0 A_PlaySoundEx("misc_L/darkthrow", "Weapon")
    8I12 A 0 A_GiveInventory("GenericBossFlag200", 200)

    8I12 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I12 E 2 ThrustThingZ(0, 20, 0, 0)
    8I12 F 2
    8I12 A 0 A_SpawnItemEx("Clownpiece_MOON_H", 100, 0, 32)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 0, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 120, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 240, 0, 0, 0)
    8I12 FE 2
    8I12 D 5
    goto MoonReady2
   MoonReady1:
    8I12 D 2 A_WeaponReady(14)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I12 D 0 A_TakeInventory("GenericBossFlag200", 1)
    8I12 D 0 A_JumpIfInventory("GenericBossFlag200", 1, "MoonReady2")
    goto MoonEnd
   MoonReady2:
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "MoonReady3")
    8I12 D 2 A_WeaponReady(14)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I12 D 0 A_TakeInventory("GenericBossFlag200", 1)
    8I12 D 0 A_JumpIfInventory("GenericBossFlag200", 1, "MoonReady2")
    goto MoonEnd
   MoonReady3:
    8I12 D 0 A_JumpIfInventory("VivifyDelay4", 1, "MoonReady1")
    8I12 D 2 A_WeaponReady(6)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I12 D 0 A_TakeInventory("GenericBossFlag200", 1)
    8I12 D 0 A_JumpIfInventory("GenericBossFlag200", 1, "MoonReady3")
    goto MoonEnd
   AltfireMoon:
    8T12 D 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8I12 D 0 A_PlaySoundEx("wep_L/ThLunaNight123", "Weapon")
    8I12 D 0 A_FireCustomMissile("ClownpieceOrberinoPurple", 0, 0, 0, 0)
    8I12 D 0 A_FireCustomMissile("ClownpieceStarSpiralPurple_H", 0, 0, 0, 0)
    8I12 F 3
    8I12 E 3 A_TakeInventory("GenericBossFlag200", 3)
    8I12 D 0 A_JumpIfInventory("GenericBossFlag200", 1, "MoonReady2")
    goto MoonEnd

   MoonEnd:
    8I12 A 2
    8I12 D 2 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8I12 AD 2
    Goto Ready2

   Altfire:
    8I12 A 0 A_JumpIfInventory("GenericBossFlag200", 1, "AltfireMoon")
    8T12 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8I12 A 0 A_PlaySoundEx("wep_L/ThLunaNight123", "Weapon")
    8I12 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "AltfireBlue")
    8I12 A 0 A_GiveInventory("DuoBusterFlag")
   AltfireRed:
    8I12 A 0 A_FireCustomMissile("ClownpieceOrberinoRed", 0, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralRed_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralRed_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralRed_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 10
    Goto Ready2

   AltfireBlue:
    8I12 A 0 A_TakeInventory("DuoBusterFlag")
    8I12 A 0 A_FireCustomMissile("ClownpieceOrberinoBlue", 0, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralBlue_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralBlue_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 0 A_FireCustomMissile("ClownpieceStarSpiralBlue_H", 0, 0, 0, 0)
    8I12 CBCBCB 2
    8I12 A 10
    Goto Ready2
  }
}

actor ClownpieceGetUpDone_F : Once {}
actor ClownpiecePainFlag : Once {}
actor ClownpieceOrbFlag : Once {}
// Survival spell (Time Sign W2/W8): boss stays invuln until timer ends
actor ClownpieceSurvivalInvuln_F : Once {}
// Post-phase invuln timer (105 = 3s). Drained 1/tic by HealthCheck while Flash runs.
actor ClownpiecePhaseInvulnTics : Inventory {
  inventory.amount 1
  inventory.maxamount 105
  +INVENTORY.UNDROPPABLE
}
// Shared HP poll. DoSwapGo is a no-op (W8 / inherited Fire+Ready). Each Wn Flash gives HealthCheck_Wn_P.
actor ClownpieceHealthCheck_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ClownpieceSurvivalInvuln_F", 1, "SurvivalHold")
    TNT1 A 0 A_JumpIfInventory("ClownpiecePhaseInvulnTics", 1, "TickInvuln")
    goto CheckSwap
   SurvivalHold:
    // Do NOT call core_invulnerableplayer here — it STACKS (+1/Give). SpellBreak already enabled invuln once.
    TNT1 A 0
    stop
   TickInvuln:
    TNT1 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics", 1)
    TNT1 A 0 A_JumpIfInventory("ClownpiecePhaseInvulnTics", 1, "CheckSwap")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
   CheckSwap:
    TNT1 A 0 A_JumpIfHealthLower(2, "DoSwap")
    stop
   DoSwap:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("ClownpiecePainFlag", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyExtraLife", 1, "DoSwapGo")
    goto NoSwap
   DoSwapGo:
    TNT1 A 0
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

// Drop Time Sign invuln when the survival timer ends (before ForceSwap / kill).
actor ClownpieceClearSurvivalInvuln_P : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ClownpieceSurvivalInvuln_F", 1, "ClearGo")
    stop
   ClearGo:
    TNT1 A 0 A_TakeInventory("ClownpieceSurvivalInvuln_F")
    TNT1 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    stop
  }
}

actor ClownpieceHealthCheck_W1_P : ClownpieceHealthCheck_P {
  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W2")
    TNT1 A 0 A_TakeInventory("Clownpiece_W1")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 2)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 2)
    stop
  }
}

actor ClownpieceHealthCheck_W2_P : ClownpieceHealthCheck_P {
  States {
    // Time Sign: never advance by HP
   DoSwap:
    TNT1 A 0
    goto NoSwap
   DoSwapGo:
    TNT1 A 0
    stop
  }
}

actor ClownpieceHealthCheck_W3_P : ClownpieceHealthCheck_P {
  States {
   DoSwapGo:
    TNT1 A 0 A_GiveInventory("ClownpiecePainFlag")
    TNT1 A 0 A_TakeInventory("ClownpieceGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Clownpiece_W4")
    TNT1 A 0 A_TakeInventory("Clownpiece_W3")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceSelectW", 0, 4)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ClownpieceBroadcastPhase", 0, 4)
    stop
  }
}


// Hell Sign "Flash and Stripe"
// Hell Sign "Star and Stripe"
actor Clownpiece_W4 : Clownpiece_W2 {
  States {
   Fire:
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 100, "StripeFire")
    Goto Ready2
   StripeFire:
    // 8I12 A 0 A_TakeInventory("UnholyBossAmmo200", 100)
    8I12 A 0 A_PlaySoundEx("wep_L/TouhouLazer0", "Weapon")
    8I12 A 0 A_Jump(256, "Stripe1", "Stripe2")
   Stripe1:
    // r=600, theta=60, xOffset=160 (boss-right of enemy; laser fires left toward E)
    8I12 A 0 ACS_NamedExecuteWithResult("uh_ClownpieceStripeVolley", 600, 60, 160)
    goto FireEnd
   Stripe2:
    8I12 A 0 ACS_NamedExecuteWithResult("uh_ClownpieceStripeVolley", 600, 60, -160)
    goto FireEnd
   FireEnd:
    8I12 CBCB 2
    8I12 A 8
    Goto Ready2
  }
}


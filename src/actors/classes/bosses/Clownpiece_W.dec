// "Fake Apollo"
// "Apollo Hoax Theory"
// Moon Dream "Eclipse Nightmare"

// Ring burst cooldown; drained 1 per orbit tic (higher = longer gap between rings)
actor Clownpiece_MOON_BurstCD : Inventory {
  inventory.amount 1
  inventory.maxamount 80
  +INVENTORY.UNDROPPABLE
}

actor Clownpiece_MOON : ProjSpawnFuncActor  // BasicExplosion
{
  var int user_age;  // M1-held age; BurstCD arm length = max(20, 80 - user_age/16)
  Translation "0:0=42:42", "192:192=48:48", "198:198=224:224", "195:195=144:144"
  Damagetype "Clownpiece"
  Obituary "%o went insane from touching %k's Apollo Hoax Theory."
  +FORCEXYBILLBOARD
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +GHOST
  +SHOOTABLE
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +BRIGHT
  PainChance 0
  Species "Clownpiece_MOON"
  Health 0x7ffffffd
  Renderstyle "Translucent"
  Alpha 0.75
  Scale 2.5
  Args 60  // max of user_age
  states {
   Spawn:
    8Q12 N 0
    // FireMoon + hold/press M1 while orbiting; BurstCD arms from 80 → 20 as M1-held age rises
   BurstOnce:
    8Q12 N 0 A_PlaySoundEx("Touhou/Tan0", "Auto")
    8Q12 N 0 A_SpawnItemEx("ClownpieceMoonShot12_H", 0, 0, 0, 0, 0, 0, 0, 32)
    8Q12 N 0 A_JumpIf(user_age >= Args[0]-20, "ArmFloor")
    8Q12 N 0 A_SetUserVar("user_age", user_age+2)
    8Q12 N 0 A_GiveInventory("Clownpiece_MOON_BurstCD", Args[0] - user_age)
    Goto Orbit
   ArmFloor:
    8Q12 N 0 A_GiveInventory("Clownpiece_MOON_BurstCD", 20)
   Orbit:
    8Q12 N 0 A_Explode(random(45, 55), 32, 0, 0, 32)
    8Q12 N 1 A_Warp(2, 100, 0, 32, 3, 28)
    8Q12 N 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    8Q12 N 0 A_TakeInventory("Clownpiece_MOON_BurstCD", 1)
   OrbitBtn:
    8Q12 N 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 2, 0) & BT_ATTACK), "Orbit")
    8Q12 N 0 A_JumpIfInventory("Clownpiece_MOON_BurstCD", 1, "Orbit")
    Goto BurstOnce
   Death:
    // Boss died: fly outward as Clownpiece_FULLMOON
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SetAngle(angle+180.0)
    TNT1 A 0 A_PlaySoundEx("wep_L/ThLunaNightPew", "Auto")
    TNT1 A 0 A_CustomMissile("Clownpiece_FULLMOON", 0, 0, 0, CMF_AIMDIRECTION, 0)
    TNT1 A 2
    Stop
  }
}



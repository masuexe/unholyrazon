actor ClownpieceLaserBlue_H : BasicWatcher {
  Translation "192:192=4:4", "198:198=196:196", "4:4=196:196", "202:202=75:75"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, "SpawnSpread")

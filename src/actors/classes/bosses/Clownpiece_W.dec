    8I12 B 1 Offset(110, 32)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(100, 30) A_FireCustomMissile("ClownpieceStar_B", 21, 0, 0, 0)
    8I12 B 1 Offset(88, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 7: +14 deg (returning leftward)
    8I12 B 1 Offset(76, 27)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(64, 25) A_FireCustomMissile("ClownpieceStar_B", 14, 0, 0, 0)
    8I12 B 1 Offset(50, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 8: +7 deg (returning leftward)
    8I12 B 1 Offset(38, 24)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(24, 23) A_FireCustomMissile("ClownpieceStar_B", 7, 0, 0, 0)
    8I12 B 1 Offset(12, 23) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 9: 0 deg (center slash leftward)
    8I12 B 1 Offset(5, 23)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(0, 22) A_FireCustomMissile("ClownpieceStar_B", 0, 0, 0, 0)
    8I12 B 1 Offset(-12, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 10: -7 deg (swinging left)
    8I12 B 1 Offset(-24, 19)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-36, 18) A_FireCustomMissile("ClownpieceStar_B", -7, 0, 0, 0)
    8I12 B 1 Offset(-48, 19) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 11: -14 deg (swinging further left)
    8I12 B 1 Offset(-60, 20)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-72, 21) A_FireCustomMissile("ClownpieceStar_B", -14, 0, 0, 0)
    8I12 B 1 Offset(-84, 23) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 12: -21 deg (swinging high left)
    8I12 B 1 Offset(-94, 25)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-104, 27) A_FireCustomMissile("ClownpieceStar_B", -21, 0, 0, 0)
    8I12 B 1 Offset(-112, 29) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 13: -28 deg (left apex wide wave)
    8I12 B 1 Offset(-118, 30)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-124, 31) A_FireCustomMissile("ClownpieceStar_B", -28, 0, 0, 0)
    8I12 B 1 Offset(-118, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 14: -21 deg (returning rightward)
    8I12 B 1 Offset(-110, 32)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-100, 30) A_FireCustomMissile("ClownpieceStar_B", -21, 0, 0, 0)
    8I12 B 1 Offset(-88, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 15: -14 deg (returning rightward)
    8I12 B 1 Offset(-76, 27)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-64, 25) A_FireCustomMissile("ClownpieceStar_B", -14, 0, 0, 0)
    8I12 B 1 Offset(-50, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire(1)
    goto FireEndDelay
    // Shot 16: -7 deg (returning rightward to center)
    8I12 B 1 Offset(-38, 24)
    8I12 C 0 A_GiveInventory("ClownpieceMainfire_P")
    8I12 C 1 Offset(-24, 23) A_FireCustomMissile("ClownpieceStar_B", -7, 0, 0, 0)
    8I12 B 1 Offset(-16, 24) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 0 A_Refire("FireRed")
    goto FireEndDelay

   FireEndDelay:
    8I12 B 1 Offset(-5, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 1 Offset(0, 28)
    8I12 A 2 Offset(0, 30)
    8I12 A 2 Offset(1, 32)
    Goto Ready2

   AltFire:
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 1)
    goto Ready2
    // Torch windup: pulled back and down
    8I12 B 1 Offset(-12, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 B 1 Offset(-24, 38)
    8I12 B 1 Offset(-30, 42)
    // High forward heavy thrust: emit laser beam and burst flame!
    8I12 A 0 A_GiveInventory("ClownpieceKickerfire3_P")
    8I12 C 1 Offset(12, 14)
    8I12 C 2 Offset(20, 10)
    8I12 C 2 Offset(16, 12)
    // Recoil & return to ready
    8I12 B 2 Offset(8, 20)
    8I12 B 1 Offset(3, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I12 A 2 Offset(1, 32)
    goto Ready2
  }
}

// Hellfire "Graze Inferno"
// Hellfire "Infernal Essence of Grazing"
actor Clownpiece_W6 : Clownpiece_SpellWep {
  States {
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 6, 30)
    goto SpellBreakDone
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_W6_P")
    loop
   Fire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W6_P")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 67, "DollarGive")
    Goto Ready2
   DollarGive:
    8I12 A 0 A_GiveInventory("VivifyDelay4")
    8I12 A 0 A_TakeInventory("UnholyBossAmmo200", 67)
    8I12 A 0 A_PlaySoundEx("Touhou/Tan0", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceItemShotRed24_H", 0, 0, 0, 0)
    8I12 BCAAAAAAAA 2
    8I12 A 0 A_PlaySoundEx("Touhou/Tan0", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceItemShotRed12_H", 0, 0, 0, 0)
    8I12 BCAAAAAAAA 2
    Goto Ready2
  }
}

// Inferno "Striped Abyss"
actor Clownpiece_W7 : Clownpiece_SpellWep {
  States {
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 7, 30)
    goto SpellBreakDone
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_W7_P")
    loop
   Fire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W7_P")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 80, "AbyssFire")
    Goto Ready2
   AbyssFire:
    8I12 A 0 A_TakeInventory("UnholyBossAmmo200", 80)
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    // Six wall runners: L/R x three Z bands (each has its own MXP1 warn)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 144)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 144)
    8I12 CBAA 2
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 72)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 72)
    8I12 CBAA 2
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 0)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 0)
    8I12 CBAA 2
    Goto Ready2
   AltFire:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_W7_P")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 80, "AbyssAltFire")
    Goto Ready2
   AbyssAltFire:
    8I12 A 0 A_TakeInventory("UnholyBossAmmo200", 80)
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    // Six wall runners: L/R x three Z bands (each has its own MXP1 warn)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 0)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 0)
    8I12 CBAA 2
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 72)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 72)
    8I12 CBAA 2
    8I12 A 0 A_PlaySoundEx("Touhou/Tan1", "Weapon")
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallL", 0, 0, -160, 144)
    8I12 A 0 A_FireCustomMissile("ClownpieceAbyssWallR", 0, 0, 160, 144)
    8I12 CBAA 2
    Goto Ready2
  }
}

// "Fake Apollo"
// "Apollo Hoax Theory"
// Moon Dream "Eclipse Nightmare"
actor Clownpiece_W8 : Clownpiece_W {
  States {
   Ready:
    goto ReadySpell
   StartSpell:
    8I12 A 0 ACS_NamedExecuteAlways("uh_SpellCardStart", 0, 8, 30)
    goto SpellBreakDone
    // Time Sign: keep SpellBreak invuln for the whole timer; only timeout ends the fight
   SpellBreakDone:
    8I12 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    8I12 A 0 A_TakeInventory("ClownpiecePhaseInvulnTics")
    8I12 A 0 A_GiveInventory("ClownpieceSurvivalInvuln_F")
    // Invuln already on from SpellBreak; do not re-stack
    8I12 A 0 A_GiveInventory("UnholyBossAmmo200", 200)
    8I12 A 0 A_GunFlash("Flash", true)
    Goto Ready2
   Flash:
    TNT1 A 1 A_GiveInventory("ClownpieceHealthCheck_P")
    loop
   Fire:
   FireMoon:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_P")
    8I12 A 0 A_PlaySoundEx("misc_L/darkthrow", "Weapon")
    8I12 E 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    8I12 E 2 ThrustThingZ(0, 20, 0, 0)
    8I12 F 2
    8I12 A 0 A_SpawnItemEx("Clownpiece_MOON_H", 100, 0, 32)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 0, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 120, 0, 0, 0)
    8I12 A 0 A_FireCustomMissile("Clownpiece_MOON", 240, 0, 0, 0)
    8I12 FE 2
    8I12 D 5
    goto MoonReady2
   MoonReady1:
    8I12 D 0 A_GiveInventory("ClownpieceHealthCheck_P")
    8I12 D 2 A_WeaponReady(14)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    goto MoonReady2
   MoonReady2:
    8I12 A 0 A_GiveInventory("ClownpieceHealthCheck_P")
    8I12 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "MoonReady3")
    8I12 D 2 A_WeaponReady(14)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    goto MoonReady2
   MoonReady3:
    8I12 D 0 A_GiveInventory("ClownpieceHealthCheck_P")
    8I12 D 0 A_JumpIfInventory("VivifyDelay4", 1, "MoonReady1")
    8I12 D 2 A_WeaponReady(6)
    8I12 D 0 A_FireCustomMissile("Clownpiece_MOONGravity", 0, 0, 0, 0)
    8I12 D 0 A_GiveInventory("UnholyBossAmmo200", 2)
    goto MoonReady3
   Altfire:
   AltfireMoon:
    8T12 D 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8I12 D 0 A_PlaySoundEx("wep_L/ThLunaNight123", "Weapon")
    8I12 D 0 A_FireCustomMissile("ClownpieceOrberinoPurple", 0, 0, 0, 0)
    8I12 D 0 A_FireCustomMissile("ClownpieceStarSpiralPurple_H", 0, 0, 0, 0)
    8I12 F 3
    8I12 E 3
    goto MoonReady2
  }
}

actor Clownpiece_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 67, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor Clownpiece_Ready8_P : Clownpiece_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor ClownpieceMainfire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("ClownpieceHealthCheck_P")
    TNT1 A 0 A_PlaySound("Touhou/Tan1", 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 10)
    stop
  }
}

actor ClownpieceKickerfire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
   Kicker:
    // TNT1 A 0 A_PlaySoundEx("Touhou/Lazer0","Auto")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    TNT1 A 0 A_FireCustomMissile("ClownpieceLaserBlue_H", 0, 0, 0, 0)
    stop
  }
}

actor ClownpieceKickerfire2_P : ClownpieceKickerfire_P {
  States {
   Pickup:
    // TNT1 A 0 A_PlaySoundEx("Touhou/Lazer0","Auto")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    TNT1 A 0 A_SpawnItemEx("ClownpieceLaser2_H")
    stop
  }
}

actor ClownpieceKickerfire3_P : ClownpieceKickerfire_P {
  States {
   Pickup:
    // TNT1 A 0 A_PlaySoundEx("Touhou/Lazer0","Auto")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    TNT1 A 0 A_FireCustomMissile("ClownpieceLaser3_H", 0, 0, 0, 0)
    stop
  }
}


actor JoeOfDuty_W_NormalBar : NormalBar {args 216, 42}
actor JoeOfDuty_W_SecondBar : SecondBar {args 4, 94}
actor JoeOfDuty_W_ReloadIcon : ReloadIcon {}
actor JoeOfDuty_W : BaseUnholyBossWep {
  Obituary "%o was rushed down by \cqJoe\c- (%k)."
  Inventory.Pickupmessage "\cgMW2 hacked lobby, how can I help you?"
  weapon.ammotype "CoD_Rifle_Ammo"
  weapon.ammotype2 "UnholyBossAmmo200"
  Weapon.AmmoUse 10
  Weapon.AmmoGive 200
  -WEAPON.DONTBOB
  Weapon.BobStyle "Smooth"
  Weapon.BobSpeed 3.0
  States {
   Spawn:
    8H58 [ 1
    wait

   Deselect:
    JOEB Q 0
    goto DeselectSwap
   Select:
    JOEB Q 0
    goto SelectSwap

   Ready:
    JOEB Q 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, JOEOFDUTY_DYE)
    JOEB Q 0 A_GiveInventory("CoD_Rifle_Ammo", 200)
    goto ReadyX
   ReadyX:
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 200, "ReadyTrue")
    JOEB Q 0 A_JumpIfNoAmmo("ReloadA")
    Goto ReloadCheck
   ReadyTrue:
    JOEB Q 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyTrue_16")
    JOEB Q 2 A_WeaponReady
    JOEB Q 0 A_GiveInventory("UnholyBossAmmo200", 4)
    loop
   ReadyTrue_16:
    JOEB Q 2 A_WeaponReady(16)
    JOEB Q 0 A_GiveInventory("UnholyBossAmmo200", 4)
    goto ReadyTrue

   LockAndLoad:
    JOEB Q 0 A_PlaySound("mmWilyWars/MegaRemoveWep", "Weapon")
    JOEB Q 1 Offset(0, 40)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 46)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 58)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 80)A_WeaponReady(1)
    TNT1 A 26 A_WeaponReady(1)
    JOEB Q 1 Offset(0, 80)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 60)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 50)A_WeaponReady(1)
    JOEB Q 1 Offset(0, 40)A_WeaponReady(1)
    JOEB Q 0 A_GiveInventory("CoD_Rifle_Ammo", 200)
    JOEB Q 0 A_PlaySoundEX("Weapon/LockAndLoad", "Weapon")
    // JOEB Q 0 A_PlaySoundEX("Weapon/LockAndLoad","Weapon")
    goto ReadyX

   ReloadX:
    JOEB Q 0 A_PlaySound("mmWilyWars/MegaRemoveWep", "Weapon")
    JOEB Q 1 Offset(0, 40)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 46)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 58)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 80)A_WeaponReady(14)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Flag", 1, 1)
    goto LockAndLoad+6
    TNT1 A 8 A_WeaponReady(14)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Flag", 1, 1)
    goto LockAndLoad+7
    JOEB Q 1 Offset(0, 80)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 60)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 50)A_WeaponReady(14)
    JOEB Q 1 Offset(0, 40)A_WeaponReady(14)
    JOEB Q 0 A_GiveInventory("CoD_Rifle_Ammo", 200)
    JOEB Q 0 A_PlaySoundEX("Weapon/LockAndLoad", "Weapon")
    // JOEB Q 0 A_PlaySoundEX("Weapon/LockAndLoad","Weapon")
    goto ReadyX

   ReloadCheck:
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 20, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 40, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 60, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 80, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 100, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 120, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 140, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 160, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Ammo", 180, 1)goto ReloadA
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)goto ReloadA

   ReloadA:
    JOEB Q 0 A_TakeInventory("Joe_Animation_Flag")
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Flag", 1, "ReloadWaitX")
    goto ReloadWait

   ReloadWait:
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 2 A_WeaponReady
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Reload", 1, "ReloadWait")
    goto LockAndLoad

   ReloadWaitX:
    JOEB Q 0 A_TakeInventory("CoD_Rifle_Reload", 1)
    JOEB Q 2 A_WeaponReady(9)
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Flag", 1, 1)
    goto ReloadWait+2
    JOEB Q 0 A_JumpIfInventory("CoD_Rifle_Reload", 1, "ReloadWaitX")
    goto ReloadX

   Fire:  // Quick ready up delay.
    JOEB Q 0 A_JumpIfNoAmmo("STOPHOLDINGM1")
    JOEB Q 1 offset(-6, 40)
    JOEB Q 1 offset(-8, 38) A_GiveInventory("Joe_Animation_Flag")
    JOEB Q 1 offset(-7, 37)
    JOEB Q 1 offset(-2, 36)
    JOEB Q 1 offset(4, 35)
    JOEB Q 1 offset(6, 34)
   FireMags:
    JOEB Q 0 A_JumpIfNoAmmo("ReloadA")
    JOEB Q 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")
    JOEB Q 0 A_FireCustomMissile("CoDRifleBullet", random(-2, 2), 1, 8, 0)
    // JOEB Q 0 A_TakeInventory("CoD_Rifle_Ammo",10)
    JOEB RQ 1 A_GiveInventory("UnholyBossAmmo200", 1)
    JOEB S 1 offset(9, 40) A_GiveInventory("UnholyBossAmmo200", 1)
    JOEB Q 1 offset(4, 36) A_GiveInventory("UnholyBossAmmo200", 1)
    JOEB QQQ 1 offset(6, 34) A_Refire("FireMags")
   FireNoFiring:
    JOEB Q 0 A_TakeInventory("Joe_Animation_Flag")
    JOEB Q 1 offset(8, 40) A_WeaponReady(WRF_NOPRIMARY)
    JOEB Q 1 offset(13, 42)
    JOEB Q 1 offset(14, 43)
    JOEB Q 1 offset(12, 42)
    JOEB Q 1 offset(8, 41)
    JOEB Q 3 A_WeaponReady(14)
    Goto ReadyX
   Altfire:
    JOEB Q 1 A_WeaponReady(14)
    JOEB Q 1 offset(-20, 40)
    JOEB Q 1 offset(-80, 46)
    JOEB Q 1 offset(-120, 58)
    JOEB Q 1 offset(-180, 80)
    JOEB Q 1 offset(-220, 100)
    TNT1 A 3
    8H58 D 1 Offset(30, 70)
    8H58 D 1 Offset(24, 60)
    8H58 D 0 A_PlaySoundEx("B_Toad/Swipe", "Weapon")
    8H58 D 1 Offset(-4, 36) A_GiveInventory("Joe_Animation_Flag")
    8H58 E 1 Offset(-120, 20) A_FireCustomMissile("CoDJoeStabby", 0, 0, 16, 0)
    8H58 E 1 Offset(-140, 32) A_FireCustomMissile("CoDJoeStabby", 0, 0, 0, 0)
    8H58 E 1 Offset(-162, 60) A_FireCustomMissile("CoDJoeStabby", 0, 0, -16, 0)
    8H58 E 1 Offset(-180, 74)
    8H58 E 1 Offset(-188, 85) A_TakeInventory("Joe_Animation_Flag")
    TNT1 A 5 A_WeaponReady(14)  // -3
    JOEB Q 1 offset(-80, 80)
    JOEB Q 1 offset(-60, 70)
    JOEB Q 1 offset(-40, 60)
    JOEB Q 1 offset(-30, 50)
    JOEB Q 1 offset(-20, 40)
    JOEB Q 1 offset(-10, 35)
    JOEB Q 1 offset(-6, 33)
    JOEB Q 1 offset(-4, 32)
    JOEB Q 1 offset(-2, 34)
    Goto ReadyX

   STOPHOLDINGM1:
    JOEB Q 1 offset(-6, 40)
    JOEB Q 1 offset(-8, 38) A_GiveInventory("Joe_Animation_Flag")
    JOEB Q 1 offset(-7, 37) A_PlaySoundEx("Weapon/pshot", "Weapon")
    JOEB Q 1 offset(-2, 36)
    JOEB Q 1 offset(4, 35)
    JOEB Q 1 offset(6, 34)
    JOEB Q 0 A_JumpIfNoAmmo("ReloadA")
    Goto ReadyX
    /// /
    /// /
    /// /
   Reload:
    JOEB Q 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "SomeoneShoutsGrenade")
    goto ReadyX
   SomeoneShoutsGrenade:  // I'd make this charged based, but...
    // Basically, it would flag M1 so it would enter a chargeable state to throw
    // The dumb grenade, but... Is that really necessary?
    // It'd be quality of life, yet.
    // Ugghghghghghghhgh.
    JOEB Q 1 offset(-20, 40) A_TakeInventory("UnholyBossAmmo200")
    JOEB Q 1 offset(-80, 46)
    JOEB Q 1 offset(-120, 58)
    JOEB Q 1 offset(-180, 80)
    JOEB Q 1 offset(-220, 100)
    TNT1 A 3 A_WeaponReady(14)
    8H58 G 0 A_PlaySoundEx("weapon/tengushot", "Weapon")
    8H58 G 1 A_GiveInventory("Joe_Animation_Flag")
    8H58 H 1
    8H58 I 1
    8H58 J 1 A_FireCustomMissile("CoDJoe_Grenade", 0, 0, 8, 0)
    8H58 K 1
    TNT1 A 1  // 8H58 L 1
    TNT1 A 5 A_WeaponReady(14)  // -3
    JOEB Q 1 offset(-80, 80)
    JOEB Q 1 offset(-60, 70)
    JOEB Q 1 offset(-40, 60)
    JOEB Q 1 offset(-30, 50)
    JOEB Q 1 offset(-20, 40)
    JOEB Q 1 offset(-10, 35)
    JOEB Q 1 offset(-6, 33)
    JOEB Q 1 offset(-4, 32) A_TakeInventory("Joe_Animation_Flag")
    JOEB Q 1 offset(-2, 34)
    Goto ReadyX
  }
}

actor CoD_Rifle_Flag : Inventory {
  inventory.amount 1
  inventory.maxamount 52
}
actor CoD_Rifle_Reload : Inventory {
  inventory.amount 1
  inventory.maxamount 12
}

actor CoD_Rifle_Ammo : Ammo {
  inventory.amount 1
  inventory.maxamount 200  // 30, most ARs have that much ammo in a mag.
}  // Let it be an exception?

actor Joe_Animation_Flag : Once {}

actor CoDRifleBullet : BasicFastProjectile {
  var int user_POWER;  // FINALLY
  Translation "192:192=4:4", "198:198=227:227"
  damagetype "CoDBullet"
  Obituary "\cqJoe\c- (%k) killed %o in cold blood."
  // Alpha 0.90
  // RenderStyle Add
  Radius 6  // 6
  Height 6  // 6
  Scale 1.5
  Damage (random(195, 215)-user_POWER)  // 115 ~ 135
  Speed 120
  States {
   Spawn:
    6P40 A 0
    6P40 A 1 A_SpawnItemEx("CoDRifleBulletTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    6P40 A 0 A_GiveInventory("CutterFlag", 1)
    6P40 A 0 A_SetUserVar("user_POWER", user_POWER+2)
    6P40 A 0 A_JumpIfInventory("CutterFlag", 45, "NoMoreDrop")
    goto Spawn+1
   NoMoreDrop:
    6P40 A 1 A_SpawnItemEx("CoDRifleBulletTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0
    8P51 B 0 A_PlaySoundEx("MMBN6/ShotHit", "SoundSlot5")
    8P51 BCDEF 1
    stop
  }
}


actor CoDRifleBulletTrail : BasicGraphicEffect {
  Scale 1.3
  States {
   SpawnFrame:
    TMFX D 1 A_FadeOut(0.2)
    loop
  }
}

actor CoDJoeStabProtect : PowerProtection {
  Powerup.Duration 5
  damagefactor "CoDKnife", 0.0
}

actor CoDJoeStabby : BasicProjectile
{  // Technically this one shotted anything, even if just stabbed someone's foot.
  Translation "192:192=80:80", "198:198=3:3"
  damagetype "CoDKnife"
  Obituary "\cqJoe\c- (%k) knifed %o in cold blood."
  +DONTBLAST
  +DONTSPLASH
  +PIERCEARMOR
  reactiontime 1
  damage (500)  // Fair game.
  Radius 20
  Height 20
  speed 70
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 1
    stop
   XDeath:
    TNT1 A 1
    stop
   Death:
    TNT1 A 0  // A_Explode(10,64,0,0,64)
    TNT1 A 1 A_SpawnItemEx("JoeMeleeStabFx", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor JoeMeleeStabFx : BasicGraphicEffect  // BasicKnifeStabFX
{
  States {
   SpawnFrame:
    6P53 FE 2
    stop
  }
}

actor CoDJoe_Grenade : BasicProjectile {
  Translation "192:192=120:120", "198:198=124:124"
  Damagetype "CoDGrenade"
  Obituary "\cqJoe\c- (%k) blew up %o in cold blood."
  -NOGRAVITY
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  +SKYEXPLODE
  bouncefactor 0.6  // 0.65
  wallbouncefactor 0.45  // 0.35
  bouncecount 8  // 10
  reactiontime 20  // 30
  Damage (100)  // 50
  Radius 7
  Height 8
  speed 36  // 25
  scale 2.5
  States {
   Spawn:
    8T01 A 0
    8T01 A 0 ThrustThingZ(0, 30, 0, 1)
    8T01 A 0 A_CountDown
    8T01 ABCD 4
    Goto Spawn+2
   Death:
    TNT1 A 0
    // TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 1 A_SpawnItemEX("CoDJoe_Explode_A", 0, 0, 0, 0, 0, 0, 0, 0)  // 1
    stop
  }
}

actor CoDJoe_Explode_A : BasicExplosion {
  Translation "192:192=4:4", "198:198=216:216"
  Damagetype "CoDGrenade"  // GrenadeX
  Obituary "\cqJoe\c- (%k) blew up %o in cold blood."
  Scale 4.5  // 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(6, 10, 0, 16, 0)
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("CoDJoe_Explode_Debris", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 0)
    TNT1 A 0 A_Explode(200, 192, 0, 0, 8)
    X_8B AABB 1 A_SpawnItemEx("CoDJoe_Explode_B", random(-120, 120), random(-120, 120), random(-96, 96), 0, 0, 0, 0, 1)
    X_8B CCDD 1 A_SpawnItemEx("CoDJoe_Explode_B", random(-156, 156), random(-156, 156), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B EEFF 1 A_SpawnItemEx("CoDJoe_Explode_B", random(-192, 192), random(-192, 192), random(-156, 156), 0, 0, 0, 0, 1)
    stop
  }
}

actor CoDJoe_Explode_B : CoDJoe_Explode_A {
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    TNT1 A 0 A_Explode(75, 128, 0)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor CoDJoe_Explode_Debris : BasicProjectile {
  Translation "192:192=216:216", "198:198=4:4"
  damagetype "CoDGrenade"
  Obituary "\cqJoe\c- (%k) blew up %o in cold blood."  //
  +RIPPER
  -NOGRAVITY
  +HEXENBOUNCE
  +CANBOUNCEWATER
  +FORCEXYBILLBOARD
  Reactiontime 16
  damage (20)
  Radius 10
  Height 10
  speed 20
  Scale 2.5  // 2.5
  States {
   Spawn:
    X_8G C 1 A_SpawnItemEx("CoDJoe_Explode_Debris_Trail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8G C 2 A_CountDown
    loop
   Death:
    X_8G CCCC 2 A_Fadeout(0.1)
    stop
  }
}

actor CoDJoe_Explode_Debris_Trail : BasicGraphicEffect {
  States {
   SpawnFrame:
    X_8G AB 1 A_FadeOut
    loop
  }
}

8H37 A 2 Offset(0,77)
8H37 A 2 Offset(0,62)
8H37 A 2 Offset(0,47)
Goto ReadyX*/
}
}

actor YelTankBoi_Jump_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("weapon/superarmuse",4,1.0)
goto Check
//TNT1 A 0 ThrustThingZ(0,16,0,0)
//goto Check
Check:
TNT1 A 0 A_JumpIf(CallACS("UH_IsInputingMovement"),"Booster")
goto NoBoost
Booster:
TNT1 A 0 A_ChangeVelocity(sin(CallACS("UH_FetchInputDir",0))*25,sin(CallACS("UH_FetchInputDir",1))*-25,momz,3) //35
goto End
NoBoost:
End:
TNT1 A 0 ThrustThingZ(0,80,0,1) //80
stop
}
}

actor YelTankBoi_Rage_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("YelHeavyRageShot_Helper")
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
stop
TNT1 A 0 A_FireCustomMissile("YelHeavyRageShot_Helper")
stop
}
}

actor YelTankBoi_Rage_Sound_P : CustomInventory //Convoluted engine, dude.
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("misc_L/fakereloadshort","SoundSlot6")
stop
}
}

actor YelHeavyShot : RedHeavyShot
{
Translation "192:192=160:160", "198:198=164:164"
damagetype "YelTank"
Obituary "%o went boom due to \ckYel TankBoi\c- (%k)'s Machine Buster."
Damage (66)
radius 12 //16
height 12 //16
Speed 65 //70
scale 2.0 //2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,3,5,7,9,11,13,15)
6P16 A 1
6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn1+1
6P16 B 1
6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn1+2
6P16 C 1
6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn1+3
6P16 D 1
6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn1
6P16 D 1
6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn2+1
6P16 C 1
6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn2+2
6P16 B 1
6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn2+3
6P16 A 1
6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,momx/6+frandom(-2,2),momy/6+frandom(-2,2),momz/6+frandom(0,2),0,9,96)
goto Spawn2
}
}


actor YelHeavyRageShot_Helper : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("Caliber/Pew","Weapon")
TNT1 A 0 A_SpawnItemEx("YelHeavyRageShot",0,0,0,random(8,15),random(-32,8),random(-4,8))
TNT1 A 0 A_SpawnItemEx("YelHeavyRageShot",0,0,0,random(8,15),random(-8,32),random(-4,8))
TNT1 A 1
stop
}
}
actor YelHeavyRageShot_Helper2 : BasicWatcher
{
States
{
Spawn:
TNT1 A 0

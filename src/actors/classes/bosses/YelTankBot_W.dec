actor YelTankBot_W_NormalBar : NormalBar {args 228, 164}
actor YelTankBot_W : BaseUnholyBossWep
{
Tag "$TAG_Boss037_W"
Obituary "%o was crushed by \ckYel TankBoi\c- (%k)'s Machine Buster!"
Inventory.Pickupmessage "\ckTankboi Yel\c- Waiting for orders!"
weapon.ammotype "UnholyPower1000"
States
{
Spawn:
8H37 [ 1
wait

Deselect:
8H37 A 0
goto DeselectSwap
Select:
8H37 A 0
goto SelectSwap

Ready:
8H37 A 0 A_GiveInventory("UnholyPowerLimit_F",1000)
8H37 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", YELTANKBOT_DYE)
8H37 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 37,3075,355)
8H37 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H37 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX_16")
8H37 A 2 A_WeaponReady(8)
goto ReadyX
ReadyX_16:
8H37 A 2 A_WeaponReady(8+16)
goto ReadyX

Fire:
//8H37 A 0 A_JumpIfInventory("UnholyPower1000",1000,"FireRage")
8H37 A 0 A_JumpIfInventory("DuoBusterFlag",1,"FireA")
8H37 A 0 A_GiveInventory("DuoBusterFlag",1)
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")  // Using the HeavyGunner sound can hurt someone's ears if fired at this rate.
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"FireR")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 DE 1
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 BH 1
8H37 G 0 A_Refire("Fire2")
Goto FireEndG
Fire2:
8H37 A 0 //A_JumpIfInventory("IsBot",1,"BotFire")
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"FireR2")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 BE 1
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 BH 1
8H37 G 0 A_Refire("Fire2")
Goto FireEndG
FireA:
8H37 A 0 A_TakeInventory("DuoBusterFlag")
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"FireRA")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 GH 1
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 BE 1
8H37 D 0 A_Refire("FireA2")
Goto FireEndD
FireA2:
8H37 A 0 //A_JumpIfInventory("IsBot",1,"BotFire")
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"FireRA2")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 BH 1
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 A 0 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 BE 1
8H37 D 0 A_Refire("FireA2")
Goto FireEndD

FireR:
8H37 DE 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 BH 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 G 0 A_Refire("Fire2")
Goto FireEndG
FireR2:
8H37 BE 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 BH 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 G 0 A_Refire("Fire2")
Goto FireEndG
FireRA:
8H37 GH 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 BE 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 D 0 A_Refire("FireA2")
Goto FireEndD
FireRA2:
8H37 BH 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,-8,0)
8H37 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
8H37 BE 1 A_FireCustomMissile("YelHeavyShot",random(-2,2),0,8,0)
8H37 D 0 A_Refire("FireA2")
Goto FireEndD

FireEndD:
8H37 D 1
Goto ReadyX
FireEndG:
8H37 G 1
Goto ReadyX

Flash: //	"I don't have your mental patience to make things look cleaner, Cel. But if it works, it works!" - Trist
TNT1 A 2 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, 1)
wait //	 "Even if it means I have to borrow the same code from other things. It still works." - Trist
TNT1 A 2 A_JumpIf(momz==0,"LongJump")
Goto NoJumpForYou
LongJump:
//TNT1 A 0 A_GunFlash(1)
TNT1 A 0 A_GiveInventory("YelTankBoi_Jump_P")
TNT1 A 0 A_RailWait
TNT1 A 0 //A_Jump(256,1,4,7,10,13,16,19,22,25,28,31,34,37,40,43)
TNT1 A 3 //9
Goto ZaFloorChex
ZaFloorChex:
TNT1 A 2 A_JumpIf(CallACS("core_CheckFooting"), "ZaLanding")
ZaLanding:
TNT1 A 2
Goto Flash
/*TNT1 FLR 3
loop
TNT1 GMS 3
loop
TNT1 HNT 3
loop
TNT1 IOU 3
loop
TNT1 JPV 3
loop
TNT1 ELS 3
loop
TNT1 FMT 3
loop
TNT1 GNU 3
loop
TNT1 HOV 3
loop
TNT1 IPQ 3
loop
TNT1 JKR 3
loop
TNT1 JKT 3
loop
TNT1 ENQ 3
loop
TNT1 HKQ 3
loop*/
NoJumpForYou:
TNT1 A 6
Goto Flash

Reload:
8H37 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "MissileBarrage")
MissileBarrage:
8H37 A 0 A_TakeInventory("UnholyPower1000", 1000)
8H37 A 0 A_PlaySoundEx("misc_L/fakereloadshort", "SoundSlot6")
8H37 ABC 5
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"MissileBarrageRage")
8H37 BCBCBCBCBCBCBCBCBCBCBCBCBCBCBC 1 A_GiveInventory("YelTankBoi_Rage_Fire_P")
8H37 CB 3
goto ReadyX
MissileBarrageRage:
8H37 BCBCBCBCBCBCBCB 1 A_GiveInventory("YelTankBoi_Rage_Fire_P")
8H37 CB 3
goto ReadyX

/*Flash:
TNT1 A 1 A_JumpIfInventory("IsDead",1,"NoFlash")
TNT1 A 2 A_JumpIfInventory("BossItemUseFlag",1,"UnleashMissiles")
loop
UnleashMissiles: //If this procs more than once, then there's a problem.
TNT1 A 0 A_TakeInventory("UnholyPower1000",1000)
TNT1 A 0 A_TakeInventory("BossItemUseFlag")
TNT1 A 0 A_PlaySoundEx("misc_L/fakereloadshort","Weapon")

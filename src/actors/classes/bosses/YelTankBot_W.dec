8H37 A 0 A_TakeInventory("UnholyPower1000",1000)
8H37 A 0 A_PlaySoundEx("misc_L/fakereloadshort","Weapon")
8H37 ABC 5
8H37 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"FireR2")
8H37 FDHFDHFDHFDHFDHFDHFDHFDHFDHFDH 1 A_FireCustomMissile("YelHeavyRageShot_Helper",0,0,0,0)
8H37 HGA 2
Goto ReadyX
FireRageR:
8H37 FDHFDHFDHFDHFDH 1 A_FireCustomMissile("YelHeavyRageShot_Helper2",0,0,0,0)
8H37 HGA 2
Goto ReadyX*/

/*Altfire:
8H37 A 0 A_JumpIf(momz==0,"LongJump")
goto ReadyX
LongJump:
8H37 A 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8H37 A 0 ThrustThingZ(0,80,0,0)
8H37 A 0 A_Recoil(-20)
8H37 A 2 Offset(0,47)
8H37 A 2 Offset(0,62)
8H37 A 2 Offset(0,77)
8H37 A 2 Offset(0,92)
TNT1 A 9//19

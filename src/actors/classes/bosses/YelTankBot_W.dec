actor YelHeavyRageShot : BasicProjectile
{
Translation "192:192=160:160", "198:198=164:164"
damagetype "YelTank"
Obituary "%o went boom due to \ckYel TankBoi\c- (%k)'s Machine Buster."
+SKYEXPLODE
+EXPLODEONWATER
+DONTSPLASH
+THRUGHOST
+DOOMBOUNCE
damage (100)
Radius 12
Height 12
speed 65
scale 2.5
States
{
Spawn:
X_4G A 0
X_4G A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_4G AAABBB 1 A_Recoil(2)
X_4G A 0 A_Stop
X_4G AABBAB 1
X_4G A 0 A_CustomMissile("YelHeavyRageShot2",0,0,0,2,-pitch)
stop
Death:
YMFX C 2 A_Explode(50,64,0,0,32)
TMFX BCD 2
stop
}
}


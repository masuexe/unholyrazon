{
Mass 3
Scale 100
}

Actor AbePennyContactDamage : BasicExplosion
{
Damagetype "AbePenny"
Obituary "%o became \cmAbe \cuPenny\c- (%k)'s best friend."
States
{
Spawn:
TNT1 A 0 
TNT1 A 1 A_Explode(300,110,0,0,24)
stop
}
}


actor AbePennyBullet : BasicFastProjectile
{
Translation "192:192=3:3","198:198=5:5"
var int user_P;
Damagetype "AbePenny"
Obituary "%o was shot down by \cmAbe \cuPenny\c- (%k)."
//MissileHeight 8
//MissileType "AbePennyBulletFX"
Damage (175+user_P*25)
Radius 12
Height 12
Speed 120
Scale 4.0
States
{
Spawn:
X_0D A 1 A_SpawnItemEx("AbePennyBulletFX1",0,0,2,0,0,0,0,1)
X_0D A 1 A_SpawnItemEx("AbePennyBulletFX2",0,0,2,0,0,0,0,1)
X_0D A 0 A_SetUserVar("user_P",user_P+1)
loop
Crash:
XDeath:
YMFX C 1 A_SetScale(3.0)
TMFX ABC 1
stop
Death:
TMFX C 1 A_SetScale(3.0)
TMFX BA 1
stop
}
}

actor AbePennyBulletFX1 : BasicClientSide
{
Alpha 0.90
RenderStyle "Translucent"
Scale 1.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1
XMFX A 1
Spawn2:
XMFX "#" 0 A_FadeTo(0.3,0.15,1)
XMFX "#" 1 A_SetScale(ScaleX+0.25)
loop
}
}
actor AbePennyBulletFX2 : AbePennyBulletFX1
{
States
{
Spawn:
TNT1 A 0
TNT1 A 1
XMFX C 1
goto Spawn2
}
}

actor AbePennyNapalmBomb : BasicProjectile
{
Translation "192:192=176:176", "198:198=180:180", "4:4=189:189"
damagetype "AbePennyStun"
Obituary "%o was removed from play by \cmAbe \cuPenny\c- (%k)."
-NOGRAVITY
+SKYEXPLODE
+CANBOUNCEWATER
+HEXENBOUNCE
bouncefactor 0.75
wallbouncefactor 0.75
reactiontime 20
bouncecount 3
damage (65)
Radius 14
Height 16
speed 36
scale 3.5
States
{
Spawn:
X_5G A 0
X_5G A 0 ThrustThingZ(0,15,0,1)
X_5G A 0 A_CountDown
X_5G ABCD 4
Goto Spawn+2
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode","Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 Radius_Quake(4,1015,0,10,0)
TNT1 A 0 A_Explode(285,128,0)
TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1+16384)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("AbePennyNapalmBomb2",random(-175,175),random(-175,175),random(-32,128),0,0,0,0,1)
TNT1 A 6
stop
}
}

actor AbePennyNapalmBomb2 : BasicExplosion
{
damagetype "AbePennyInsta"
Obituary "%o was in sights of \cmAbe \cuPenny\c- (%k)'s Dastardly Explosive."
Scale 3.0
States
{

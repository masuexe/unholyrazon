actor AbePenny_FloorQuake_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteAlways("uh_FloorQuakeDamageBoss",0,1000,15,1301)
TNT1 A 0 A_SpawnItemEx("AbePenny_QuakeFX_H")
stop
}
}

actor AbePenny_FloorQuakeSpawn : Basic_FloorQuakeSpawn
{
Obituary "%o couldn't handle \cmAbe \cuPenny\c- (%k)'s manipulating shockwaves."
damagetype "AbePennyStun"
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("AbePenny_FloorQuakeBoom",0,0,28,0,0,0,0,16384+1)
stop
}
}

actor AbePenny_FloorQuakeBoom : Basic_FloorQuakeBoom
{
Obituary "%o couldn't handle \cmAbe \cuPenny\c- (%k)'s manipulating shockwaves."
damagetype "AbePennyStun"
}


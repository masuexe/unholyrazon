TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX_Tic2_Dull",0,0,0,0,0,0,0,1+16384)
stop
}
}



actor AbePennyDrJekyllBomb : ProjSpawnFuncActor//BasicProjectile
{
Translation "192:192=3:3", "198:198=5:5"
damagetype "AbePennyFling"
Obituary "\cmAbe \cuPenny\c- (%k) didn't like %o and bribed %h to go die."
+MISSILE
+THRUACTORS
-NOGRAVITY
+DONTREFLECT
+HEXENBOUNCE
+CANBOUNCEWATER
bouncefactor 0.0
wallbouncefactor 0.0
reactiontime 16
Radius 6
Height 7
Speed 0
scale 5.0
States
{
Spawn:
8S01 L 0
8S01 L 0 Radius_Quake(1,48,0,140,0)
8S01 LLLL 3 A_CountDown
Spawn2:
8S01 M 0 A_CountDown
8S01 N 2 A_PlaySoundEx("wep/DrJekyllFuse","Weapon",0,1)
8S01 N 1 A_PlaySoundEx("wep/DrJekyllFuse","Weapon",0,1)
8S01 M 1 A_CountDown
8S01 M 2 A_PlaySoundEx("wep/DrJekyllFuse","Weapon",0,1)
loop
Death:
X_1D B 0 Radius_Quake(8,1190,0,140,0)
X_1D B 0 A_PlaySoundEx("wep/DrJekyllBoom","Weapon",0,1)
X_1D B 0 A_SpawnItemEx("AbePennyDrJekyllBomb_FX",0,0,0,0,0,0,0,1)
X_1D BCDEFGHIJKLMFGHIJKLMFGHIJKLMFGHIJKLM 1 A_Explode(100,9000,0)
X_1D N 1
TNT1 A 15
stop
}
}


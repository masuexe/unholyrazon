actor AbePenny_W_ScriptBar : ScriptBar {}

actor AbePenny_W : BaseUnholyBossWep
{
Tag "$TAG_Boss301_W"
Weapon.AmmoUse 1
Weapon.AmmoGive 0
Weapon.AmmoUse2 0
Weapon.AmmoGive2 250
Obituary "%o was removed from play by \cmAbe \cuPenny\c- (%k)."
Inventory.Pickupmessage "\chFour Score."
weapon.ammotype "AbePennyAmmo"
weapon.ammotype2 "UnholyBossAmmo250"
States
{
Spawn:
8K01 [ 1
wait

Deselect:
8K01 C 0
goto DeselectSwap
Select:
8K01 C 0
goto SelectSwap

Ready:
8K01 A 0 A_GiveInventory("UnholyPowerLimit_F",3000)
8K01 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ABEPENNY_DYE)
8K01 A 0 ACS_NamedExecuteWithResult("uh_BossMorph", 301,3765,515)
Goto ReadyX
ReadyX:
8K01 A 0 A_TakeInventory("AbePennyFlag")
8K01 A 0 A_JumpIfNoAmmo("ReloadNoAmmo")
8K01 A 0 A_JumpIfInventory("AbePennyAmmo", 8, "ReadyX2")
goto Reload1

ReadyX2:
8K01 A 0 A_JumpIfInventory("UnholyPower3000",3000,"ReadyX3")
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReadyX3")
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250", 0, 2)
8K01 A 2 A_WeaponReady(8)
goto ReadyX2G
8K01 A 2 A_WeaponReady(8+16)
ReadyX2G:
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
goto ReadyX2
ReadyX3:
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250", 0, 2)
8K01 A 2 A_WeaponReady
goto ReadyX3G
8K01 A 2 A_WeaponReady(16)
ReadyX3G:
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
goto ReadyX3

Reload1:
8K01 A 0 A_JumpIfInventory("UnholyPower3000",3000,"Reload2")
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"Reload2")
8K01 A 0 A_JumpIfInventory("AbePennyFlag",10,"ReloadTime1")
8K01 A 2 A_WeaponReady(8)
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
8K01 A 0 A_GiveInventory("AbePennyFlag",1)
loop
Reload2:
8K01 A 0 A_JumpIfInventory("AbePennyFlag",10,"ReloadTime1")
8K01 A 2 A_WeaponReady
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
8K01 A 0 A_GiveInventory("AbePennyFlag",1)
loop
ReloadNoAmmo:
8K01 A 0 A_JumpIfInventory("UnholyPower3000",3000,"ReloadNoAmmo2")
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"ReloadNoAmmo2")
8K01 A 0 A_JumpIfInventory("AbePennyFlag",14,"ReloadTime0")
8K01 A 2 A_WeaponReady(12)
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
8K01 A 0 A_GiveInventory("AbePennyFlag",1)
loop
ReloadNoAmmo2:
8K01 A 0 A_JumpIfInventory("AbePennyFlag",14,"ReloadTime2")
8K01 A 2 A_WeaponReady(4)
8K01 A 0 A_GiveInventory("UnholyBossAmmo250",2)
8K01 A 0 A_GiveInventory("AbePennyFlag",1)
loop

ReloadTime:
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 B 4 A_WeaponReady
8K01 C 4 A_WeaponReady
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 C 4 A_WeaponReady
8K01 C 4 A_WeaponReady
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 C 4 A_WeaponReady
8K01 B 4 A_WeaponReady
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 A 0 A_GiveInventory("AbePennyAmmo", 8)
Goto ReadyX
ReloadTime0:
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 BC 4 A_WeaponReady(12)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 CC 4 A_WeaponReady(12)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 CB 4 A_WeaponReady(12)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 A 0 A_GiveInventory("AbePennyAmmo", 8)
Goto ReadyX
ReloadTime1:
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 BC 4 A_WeaponReady(8)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 CC 4 A_WeaponReady(8)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 CB 4 A_WeaponReady(8)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 A 0 A_GiveInventory("AbePennyAmmo", 8)
Goto ReadyX
ReloadTime2:
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 B 4 A_WeaponReady(4)
8K01 C 4 A_WeaponReady(4)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 C 4 A_WeaponReady(4)
8K01 C 4 A_WeaponReady(4)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 C 4 A_WeaponReady(4)
8K01 B 4 A_WeaponReady(4)
8K01 A 0 A_PlaySoundEx("weapon/noisecrush1","Weapon")
8K01 A 0 A_GiveInventory("AbePennyAmmo", 8)
Goto ReadyX

Fire:
8K01 A 0 A_JumpIfNoAmmo("ReloadNoAmmo")
8K01 A 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
8K01 A 0 A_FireCustomMissile("AbePennyBullet",0,1,8,0)
8K01 BCBA 2 A_GiveInventory("UnholyBossAmmo250",2)
8K01 A 1 A_GiveInventory("UnholyBossAmmo250",1)
Goto ReadyX

Altfire:
8K01 A 0 A_JumpIfInventory("UnholyPower3000",3000,"DeathApproaches")
8K01 A 0 A_JumpIfInventory("UnholyBossAmmo250",250,"Altfire2")
Goto ReadyX

DeathApproaches:
8K01 A 0 A_TakeInventory("UnholyPower3000",3000)
8K01 A 0 A_PlaySoundEx("weapon/crackermine","Weapon",0,1)
8K01 A 0 A_FireCustomMissile("AbePennyDrJekyllBomb",0,0,0,0)
8K01 BC 2
8K01 A 16
Goto ReadyX

Altfire2:
//TNT1 A 0 A_PlaySoundEx("BUTTSCKS","Weapon")
8K01 A 0 A_TakeInventory("UnholyBossAmmo250",250)
8K01 A 0 A_PlaySoundEx("weapon/oilshot","Weapon")
8K01 B 0 A_FireCustomMissile("AbePennyNapalmBomb",-6,0,4,0)
8K01 B 0 A_FireCustomMissile("AbePennyNapalmBomb",6,0,-4,0)
8K01 CBA 3
8K01 A 10
Goto ReadyX

Reload:
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 0, "AttackFour")
AttackFour:
TNT1 A 0 A_PlaySoundEx("BUTTSCKS","Weapon")
TNT1 A 0 A_TakeInventory("UnholyBossAmmo250",250)
TNT1 A 0 ThrustThingZ(0,80,0,0)
TNT1 A 4 A_Recoil(-35)
AttackScore:
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "AttackSixteen")
TNT1 A 0 A_SpawnItemEx("PowerCoinAttackThing",0,0,8,random(-30,30),random(-30,30),random(-14,14),0,0,0)
TNT1 A 0 A_SpawnItemEX("AbePennyContactDamage",0,0,-24,momx,momy,momz,0,8,0)
loop
AttackSixteen:
TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
TNT1 A 0 Radius_Quake(6,35,0,50,0)
TNT1 A 0 A_PlaySoundEx("misc/hugequake","Body")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PowerCoinAttackThing",0,0,8,random(-40,40),random(-40,40),random(4,26),0,0,0)
TNT1 AAA 2 A_GiveInventory("AbePenny_FloorQuake_P",1)
TNT1 A 7
TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
TNT1 AAA 3
TNT1 A 20
Goto ReadyX
}
}

actor AbePennyAmmo : Ammo {
    Inventory.Amount 1
    Inventory.MaxAmount 8
    +INVENTORY.IGNORESKILL
}

actor AbePennyFlag : Inventory
{
inventory.amount 1
inventory.maxamount 50
}


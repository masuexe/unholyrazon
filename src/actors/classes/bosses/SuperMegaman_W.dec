}

actor HorseShot : MorphProjectile {
  MorphProjectile.MorphFlash ""//"GigaAstroExplode"
  MorphProjectile.UnMorphFlash "WeakHorseC" //FakeUnholyDeathFX
  MorphProjectile.PlayerClass "WeakHorse"
  MorphProjectile.Duration 999999999999//4200
  MorphProjectile.MorphStyle MRF_ADDSTAMINA|MRF_FULLHEALTH|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR|MRF_UNDOBYDEATH|MRF_UNDOBYDEATHFORCED

  Translation "192:192=144:144", "198:198=235:235"
  Projectile
  Damagetype "SuperMegaman"
  Obituary "%o tried to attack at \cnSuper Megaman\c- (%k), but missed and turned into a weak horse!"
  Damage (1000*(1+0.01*CallACS("ub_countinv_acs", 81, 2))*(1+9*(CallACS("rz_CheckBirthday")==0)))
  +FOILINVUL
  +THRUGHOST
  +RIPPER
  +LOOKALLAROUND
  +SKYEXPLODE
  +EXPLODEONWATER

  Radius 20
  Height 20
  Speed 50
  Scale 2.5
  States {
   Spawn:
    CHBU ABCD 2
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("Contra/C_SPING", "Weapon")
    TNT1 A 0 A_Explode(500, 64, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("HorseShot2", 0, 0, 16)
    X_8B ABCDEF 2
    stop
  }
}

actor HorseShot2 : BasicExplosion {
  Damagetype "SuperMegaman"
  Obituary "%o tried to attack at \cnSuper Megaman\c- (%k), but missed and turned into a weak horse!"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(500*(1+0.01*CallACS("ub_countinv_acs", 81, 2)), 64, 0, 0, 64)
    stop
  }
}

actor HorseShotProtect : PowerProtection {
  Powerup.Duration 16
  DamageFactor "SuperMegaman", 0.0
}

actor HorseGun_W : BaseUnholyBossWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 3
  Weapon.SlotNumber 1
  Inventory.Pickupmessage "\cgI am an enemy?"
  Obituary "%o's skill level was so low that %g was killed by a \c[g8]weak horse\c- (%k)."
  Tag "Horse Gun"
  Weapon.ammotype "BusterAmmo"
  Inventory.icon "NULLICON"
  Dropitem ""
  States {
   Spawn:
    WEA2 Q 1
    wait
   Ready:
    8H66 D 0 ACS_ExecuteAlways(998, 0, 31081)
    8H66 D 0 A_GiveInventory("HorseShotProtect", 1)
    8H66 D 0 A_GiveInventory("IsAHorse")
    8H66 D 0 A_GiveInventory("MorphedFlag")
    8H66 D 2 A_GiveInventory("BasicBossItem", 1)
    8H66 D 1 A_GunFlash
    goto Ready2
   Ready2:
    8H66 D 1 A_WeaponReady
    goto Ready2
   Deselect:
    TNT1 AAAAAAAAAAAAAAAAAAAAAA 0 A_Lower
    8H66 D 1 A_Lower
    loop
   Select:
    TNT1 AAAAAAAAAAAAAAAAAAAAAA 0 A_Raise
    8H66 D 1 A_Raise
    loop
   Fire:
    8H66 D 0 A_PlaySoundEx("weapon/chargekick", "Weapon")
    //8H66 D 0 A_GiveInventory("NegaSlideBoost_P",1)
    8H66 D 1 Offset(11, 50)
    8H66 E 2 Offset(22, 68) A_FireCustomMissile("HorseKick", 180, 0, 0, 0)
    8H66 F 7 Offset(33, 104)
    8H66 E 4 Offset(22, 68)
    8H66 E 4 Offset(11, 50)
    goto Ready2

   Flash:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
    TNT1 A 2 A_GiveInventory("Horse_Flash_P")
    loop
  }
}

actor Horse_Flash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Horse_Contact_Damage", 0, 0, 32, momx, momy, momz, 0, 8)
    stop
  }
}


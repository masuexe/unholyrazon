actor SuperMegaman_W_ScriptBar : ScriptBar {}
actor SuperMegaman_W : BaseUnholyBossWep {
  Tag "$TAG_SuperMegaman_W"
  Obituary "%o lost %p ass somehow."
  Inventory.Pickupmessage "\ckYou want to kill me? I spectate lol"
  Weapon.AmmoType "UnholyBossAmmo100"
  Weapon.AmmoType2 "UnholyBossAmmo200"  // UnholyPower2000
  States {
   Spawn:
    8H66 [ 1
    wait

   Deselect:
    8H66 A 0
    goto DeselectSwap
   Select:
    8H66 A 0
    goto SelectSwap

   Ready:
    8H66 A 0  // Initial setup: boss morph hook.
    8H66 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, SUPERMEGAMAN_DYE)
    8H66 A 0  // Initial setup: boss morph hook.
    8H66 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H66 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX0")
    8H66 A 1 A_GiveInventory("SuperMegaman_Ready8_P")
    loop
   ReadyX0:
    8H66 A 1 A_GiveInventory("SuperMegaman_Ready0_P")
    loop

   Flash:
    TNT1 A 0 A_TakeInventory("HorseShotCooldown", 1)
    TNT1 A 1 A_JumpIfHealthLower(2, "NoYouCantDefeatMe")
    loop
   NoYouCantDefeatMe:
    TNT1 A 1 ACS_NamedExecuteWithResult("rz_ForceSpectatePlayer", 1)
    stop

   Fire:
    8H66 A 0 A_JumpIfInventory("UnholyPower2000", 0, "EndlessBeamLauncher")
    8H66 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100 - 50 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "Fire3")
    8H66 A 0 A_JumpIfInventory("UnholyBossAmmo100", 50 - 25 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "Fire2")
    goto Fire1

   Fire1:
    8H66 A 0 A_TakeInventory("WeaponCharge")
    8H66 A 0 A_TakeInventory("UnholyBossAmmo100", 50, 1)
    8H66 A 0 A_TakeInventory("UnholyBossAmmo100", 50)
    8H66 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H66 A 0 A_FireCustomMissile("SuperMegaChargeShot1", 0, 0, 8, 0)
    8H66 BCA 2
    8H66 A 0 A_ReFire  // ("Charge")
    goto ReadyX
   Fire2:
    8H66 B 0 A_TakeInventory("WeaponCharge")
    8H66 B 0 A_TakeInventory("UnholyBossAmmo100", 50, 1)
    8H66 B 0 A_TakeInventory("UnholyBossAmmo100", 50)
    8H66 B 0 A_PlaySoundEx("weapon/magmabazooka", "Weapon")
    TNT1 A 0 A_FireCustomMissile("SuperMegaChargeShot2", -2, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("SuperMegaChargeShot2", -12, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("SuperMegaChargeShot2", 2, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("SuperMegaChargeShot2", 12, 0, 8, 0)
    8H66 CBA 2
    8H66 A 0 A_ReFire  // ("Charge")
    goto ReadyX
   Fire3:
    8H66 C 0 A_TakeInventory("WeaponCharge")
    8H66 C 0 A_TakeInventory("UnholyBossAmmo100", 50, 1)
    8H66 C 0 A_TakeInventory("UnholyBossAmmo100", 50)
    8H66 C 0 A_PlaySoundEx("weapon/magmabazooka", "Weapon")
    8H66 C 0 A_FireCustomMissile("SuperMegaChargeShot3", -1, 0, 8, 0)
    8H66 C 0 A_FireCustomMissile("SuperMegaChargeShot3", -15, 0, 8, 0)
    8H66 C 0 A_FireCustomMissile("SuperMegaChargeShot3", 1, 0, 8, 0)
    8H66 C 0 A_FireCustomMissile("SuperMegaChargeShot3", 15, 0, 8, 0)
    8H66 CBA 3
    8H66 A 0 A_ReFire  // ("Charge")
    goto ReadyX

   AltFire:
    8H66 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200 - 100 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "UseWarp")
   UseWarp:
    // Coil → lift the buster like opening a gate, then yank up off-screen.
    8H66 A 1 Offset(8, 40)
    8H66 B 1 Offset(16, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H66 B 1 Offset(22, 54)
    8H66 C 1 Offset(10, 32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H66 C 1 Offset(4, 16)
    8H66 C 0 A_TakeInventory("UnholyBossAmmo200", 100, 1)
    8H66 C 0 A_TakeInventory("UnholyBossAmmo200", 100)
    8H66 C 0 A_GiveInventory("ProjectilePorting")
    8H66 C 0 A_SpawnItemEx("SuperMegaWarp")
    // Drop in from below, overshoot forward, settle. Warp spawn stays on 0-tic.
    8H66 C 1 Offset(28, 72)
    8H66 B 1 Offset(-10, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H66 B 1 Offset(12, 42)
    8H66 A 1 Offset(-4, 30) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H66 A 1 Offset(6, 36)
    8H66 A 0 A_WeaponReady(14)
    goto ReadyX

   Reload:
    8H66 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200 - 100 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "HorseFire")
   HorseFire:
    8H66 B 2
    8H66 C 0 A_GiveInventory("HorseShotCooldown", 200)
    8H66 C 0 A_PlaySoundEx("BUTTSCKS", "Weapon")
    8H66 C 0 A_FireCustomMissile("HorseShot", 0, 0, 8, 0)
    8H66 C 2 Offset(24, 44)
    8H66 C 2 Offset(48, 64)
    8H66 C 2 Offset(44, 64)
    8H66 B 2 Offset(36, 56)
    8H66 B 2 Offset(16, 40)
    8H66 B 2 Offset(8, 32)
    8H66 A 16 A_WeaponReady(14)
    goto ReadyX

   EndlessBeamLauncher:
    8H66 A 0 A_PlaySoundEx("misc/sunstarbeamcharge", "SoundSlot6")
    8H66 A 0 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 1, 0)
    8H66 B 2 ThrustThingZ(0, 20, 0, 0)
    8H66 B 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8H66 CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 2 A_GiveInventory("SuperMegaFlightPack_P")
    8H66 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    goto BeamReady
   BeamReady:
    8H66 C 2 A_WeaponReady(14)
    8H66 A 0 A_GiveInventory("SuperMegaFlightPack_P")
    8H66 A 0 A_FireCustomMissile("SuperMegaEndlessBeamSpawn", 0, 0, 0, -16, 0, 0)
    8H66 C 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H66 C 0 A_TakeInventory("UnholyPower2000", 10, true)
    8H66 C 0 A_TakeInventory("UnholyPower2000", 10)
    8H66 C 0 A_JumpIfInventory("UnholyPower2000", 1, "BeamReady")
    goto BeamEnd

   BeamEnd:
    8H66 C 0 A_PlaySoundEx("weapon/ultrabeam", "SoundSlot6")
    8H66 C 0 A_SpawnItemEx("SuperMegaEndlessBeamEndFXSpawn", 24 * cos(pitch), 0, 32 + 24 * sin(-pitch), 0, 0, 0, 0, 544)
    8H66 C 2
    8H66 C 2 ACS_NamedExecuteWithResult("uh_flyplayer", 0, 0, 0)
    8H66 BA 2
    goto ReadyX
  }
}

actor HorseBountyStack : Inventory {
  Inventory.MaxAmount 999
}
actor HorseShotCooldown : Inventory {
  Inventory.MaxAmount 200
}

actor SuperMegaman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("HorseShotCooldown", 1, "PickupNormal")
    TNT1 A 0 A_Jump(256, "PickupReload")
    goto PickupReload
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 1)
    stop
  }
}
actor SuperMegaman_Ready8_P : SuperMegaman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}


actor SuperMegaChargeShot1 : BasicProjectile {
  Translation "192:192=216:216", "198:198=41:41"
  DamageType "SuperMegaman"
  Obituary "%o is destroyed by \cnSuper Megaman\c- (%k) with Super Lemon Buster ONLY!"
  +BRIGHT
  Damage (100 * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)) * (1 + 9 * (CallACS("rz_CheckBirthday") == 0)))
  Radius 8
  Height 8
  Speed 50
  States {
   Spawn:
    TNT1 A 1
    BUST A 1
    wait
  }
}

actor SuperMegaChargeShot2 : SuperMegaChargeShot1 {
  DamageType "SuperMegaChargeShot"
  Obituary "%o didn't notice the appearance of \cnSuper Megaman\c- (%k), and found their ass burnt out."
  +RIPPER
  Damage (160 * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)) * (1 + 9 * (CallACS("rz_CheckBirthday") == 0)))
  Radius 14
  Height 14
  Speed 60
  States {
   Spawn:
    X_9G ABCDEF 2
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite")
    stop
  }
}

actor SuperMegaChargeShot3 : SuperMegaChargeShot1 {
  DamageType "SuperMegaChargeShot"
  Obituary "\cnSuper Megaman\c- (%k) whispered to %o: \cg\"I'm on your ass.\""
  Damage (300 * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)) * (1 + 9 * (CallACS("rz_CheckBirthday") == 0)))
  Radius 20
  Height 20
  Speed 70
  Args 100, 128, 16
  States {
   Spawn:
    X_9G GHIJKL 2
    loop
   Death:
    TNT1 A 0 A_PlaySoundEx("wep_L/Igniter_Boom", "Weapon")
    TNT1 A 0 A_Explode(args[0] * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)), args[1], 0, 0, args[2])
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite")
    TNT1 A 4 A_SpawnItemEx("BasicBoom6FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor SuperMegaWarp : HPHM_WarpToUniverse {
  States {
   SpawnWarp:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", args[3] - 999, USP_TOGGLEON, 0)
    TNT1 A 0 A_GiveToTarget("Nudge")
    TNT1 A 0 A_SpawnItemEx("SuperMegaWarpFX", 0, 0, 28)
    TNT1 A 1 ACS_NamedExecuteWithResult("rz_WarpToTID", args[4], 0, 0, 2)  // Thing_Move(args[3],args[4],1)
    TNT1 A 1 A_SpawnItemEx("SuperMegaWarpMoveBack_H", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", args[3] - 999, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    TNT1 A 0 A_Warp(2, 0, 0, 28, 0, 16)
    TNT1 A 4 A_PlaySound("M_64/Warp1", 1)
    stop
  }
}

actor SuperMegaWarpMoveBack_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_GiveToTarget("SuperMegaMoveBack_P")
    goto StopIt
   StopIt:
    TNT1 A 0 A_GiveToTarget("SuperMegaMoveStop_P")
    stop
  }
}
actor SuperMegaMoveBack_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_ChangeVelocity(-52, 0, velz, CVF_RELATIVE | CVF_REPLACE)
    stop
  }
}

actor SuperMegaMoveStop_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Stop
    stop
  }
}

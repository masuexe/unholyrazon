actor SuperMegaFlightPack_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("SuperMegaFlightBoosterSmoke", 0, -15, 12, 0, -2, -10, 0)
    TNT1 A 0 A_SpawnItemEx("SuperMegaFlightBoosterSmoke", 0, 15, 12, 0, 2, -10, 0)
    TNT1 A 0 A_ChangeVelocity(0.5, 0, 0, 1)
    stop
  }
}

actor SuperMegaFlightBoosterSmoke : BasicProjectile {
  Damage (20)
  DamageType "SuperMegaman"
  Obituary "%o stuck %p head into the chimney for the second time."
  +RIPPER
  Radius 20
  Height 20
  Speed 0
  Scale 1.5
  States {
   Spawn:
    MXP1 ABCDE 2
    stop
  }
}

// 545 = SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH
actor SuperMegaEndlessBeamSpawn : BasicProjectile {
  Translation "248:248=160:160", "227:227=66:66", "183:183=202:202"
  Obituary "Thanks to Endless Beam Launcher, %o finally realized they shouldn't challenge \cnSuper Megaman\c- (%k) at the expense of %p horse!"
  DamageType "EndlessBeamLauncher"
  +THRUGHOST
  +BRIGHT
  +DONTBLAST
  +FORCEXYBILLBOARD
  +DONTREFLECT
  Damage (0)
  Radius 8
  Height 8
  Speed 0
  RenderStyle "Add"
  Alpha 0.05
  States {
   Spawn:
    S_UN M 0
    S_UN M 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    S_UN M 0 A_PlaySoundEx("misc/sunstarbeamloop", "SoundSlot6")
    S_UN M 0 A_SpawnItemEx("SuperMegaEndlessBeamWallHit", 0, 0, 0, 1000 * cos(pitch), 0, 1000 * sin(-pitch), 0, 545)
    S_UN M 0 A_SpawnItemEx("SuperMegaEndlessBeamDamager", 32 * cos(pitch), 0, 32 * sin(-pitch), 0, 0, 0, 0, 545)
    S_UN M 0 A_SpawnItemEx("SuperMegaEndlessBeam", 10 * cos(pitch), 0, 10 * sin(-pitch), 0, 0, 0, 0, 545)
    S_UN M 0 A_Stop
    S_UN MN 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor SuperMegaEndlessBeam : SuperMegaEndlessBeamSpawn {
  States {
   Spawn:
    S_UN M 0
    S_UN M 0 A_JumpIfCloser(1200, "Appear")
    stop
   Appear:
    S_UN M 0 A_SpawnItemEx("SuperMegaEndlessBeam", 10 * cos(pitch), 0, 10 * sin(-pitch), 0, 0, 0, 0, 545)
    S_UN OP 1
    stop
  }
}


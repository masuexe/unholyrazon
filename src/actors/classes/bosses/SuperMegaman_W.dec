}

actor HorseShot : BasicMorphProjectile {
  MorphProjectile.PlayerClass "WeakHorse"
  Translation "192:192=144:144", "198:198=235:235"
  Projectile
  DamageType "SuperMegaman"
  // Obituary "%o tried to attack at \cnSuper Megaman\c- (%k), but missed and turned into a weak horse!"
  Obituary "%o refused to become a weak horse."
  Damage (1000 * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)) * (1 + 9 * (CallACS("rz_CheckBirthday") == 0)))
  +FOILINVUL
  +THRUGHOST
  +RIPPER
  +LOOKALLAROUND
  +SKYEXPLODE
  +EXPLODEONWATER

  Radius 20
  Height 20
  Speed 50
  Scale 2.5
  States {
   Spawn:
    CHBU ABCD 2
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("Contra/C_SPING", "Weapon")
    TNT1 A 0 A_Explode(500, 64, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("HorseShotExplosion")
    X_8B ABCDEF 2
    stop
  }
}

actor HorseShotExplosion : BasicExplosion {
  DamageType "SuperMegaman"
  Obituary "%o refused to become a weak horse."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(500 * (1 + 0.01 * CallACS("rz_CountInv_HorseBountyStack", 2)), 64, 0, 0, 64)
    stop
  }
}

actor HorseShotProtect : PowerProtection {
  Powerup.Duration 16
  DamageFactor "SuperMegaman", 0.0
}

actor WeakHorse_W : BaseUnholyBossWep {
  Inventory.Pickupmessage "\c[g8]Now everyone is coming after you."
  Obituary "%o actually got killed by a \c[g8]weak horse\c- (%k), what a disgrace."
  Tag "$TAG_WeakHorse_W"
  States {
   Spawn:
    WEA2 Q 1
    wait
   Ready:
    8H66 D 0 A_GiveInventory("HorseShotProtect")
    8H66 D 0 A_GiveInventory("IsHorseFlag")
    8H66 D 0 A_GiveInventory("ProtoManBadGuyMorph_P")
    8H66 D 1 A_GunFlash
    goto Ready2
   Ready2:
    8H66 D 1 A_WeaponReady
    loop
   Deselect:
    8H66 D 0
    goto DeselectSwap
   Select:
    8H66 D 0
    goto SelectSwap
   Fire:
    8H66 D 0 A_PlaySoundEx("weapon/chargekick", "Weapon")
    8H66 D 1 Offset(11, 50)
    8H66 E 2 Offset(22, 68) A_FireCustomMissile("HorseKick", 180, 0, 0, 0)
    8H66 F 7 Offset(33, 104)
    8H66 E 4 Offset(22, 68)
    8H66 E 4 Offset(11, 50)
    goto Ready2

   Flash:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
    TNT1 A 2 A_GiveInventory("Horse_Flash_P")
    loop
  }
}

actor Horse_Flash_P : CustomInventory {
  States {

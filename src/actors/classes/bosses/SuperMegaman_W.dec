  Obituary "%o's skill level was so low that %g was killed by a \c[g8]weak horse\c- (%k)."
  Damagetype "WeakHorse"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(10, 36, 0, 0, 36) //32 radius

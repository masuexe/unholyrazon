actor CaptainBlitzkrieg_W_ScriptBar : ScriptBar {}

actor CaptainBlitzkrieg_W : BaseUnholyBossWep
{
Tag "$TAG_Boss012_W"
Obituary "%o had better teeth all thanks to \cmCaptain \ciBlitzkrieg\c- (%k)."
Inventory.Pickupmessage "\cgOpen Zee Mouth!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H12 [ 1
wait

Deselect:
8H12 A 0
goto DeselectSwap
Select:
8H12 A 0
goto SelectSwap

Ready:
8H12 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H12 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CAPTAINBLITZKRIEG_DYE)
8H12 A 0 ACS_NamedExecuteWithResult("uh_BossMorph", 12,2000,205)
8H12 A 1 A_GiveInventory("WallJumpLimit", 1)
8H12 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H12 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "ReadyXReload")
8H12 A 0 A_WeaponReady
goto ReadyAmmo
ReadyXReload:
8H12 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
ReadyAmmo:
8H12 A 1 A_GiveInventory("UnholyBossAmmo200",1) //
goto ReadyX

Flash:
TNT1 A 1
TNT1 A 1 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.5+1,"SIEG_HEIL") //A_JumpIfInventory("UnholyPower1500",1500,"SIEG_HEIL")
loop
SIEG_HEIL: 
TNT1 A 0 A_GiveInventory("No_More_Nazzies",1)
TNT1 A 0 A_PlaySoundEx("item/eddiecry","SoundSlot6")
TNT1 A 0 A_GiveInventory("BlitzKrieg_JawBreaker_Warper_Spawner")
TNT1 A 0 A_SpawnItemEx("Blitzkrieg_Jawbreaker_H")
Goto The_Idle_Game
The_Idle_Game: //Think of this as a desperation of sorts.
TNT1 A 2 A_GiveInventory("UnholyPower1500",3) //
Loop //Except now, you get to accelerate rage ammo...

/*Fire:
8H12 A 0 A_JumpIfInventory("UnholyPower1000",1000,"HumiliationaryButtsecks")
8H12 A 0 A_TakeInventory("KnightFlag")
8H12 A 0 A_PlaySoundEx("weapon/metalblade","Weapon")
8H12 A 0 A_FireCustomMissile("GermanShinyBladeT",0,0,8,0)
8H12 B 2 Offset(-1,33)
8H12 B 2 Offset(-70,74)
8H12 B 2 Offset(-121,114)
8H12 C 2 Offset(-146,201)
8H12 C 2 Offset(-171,225)
Goto Check*/

Fire: //ShadowBoss_ShadowBlade //TNT1 A 0 A_TakeInventory("ShadowBoss_ItemTimer")
8H12 A 1 
8H12 A 0 A_Refire("NoCharge")
goto FireBlade
NoCharge:
8H12 A 1 A_GiveInventory("Blitzkrieg_Charge",1) 
8H12 A 0 A_GiveInventory("UnholyBossAmmo200",1) //
8H12 A 0 A_JumpIfInventory("Blitzkrieg_Charge",25,"KeepHolding")
8H12 A 0 A_Refire("NoCharge")
goto FireBlade

KeepHolding:
8H12 A 0 A_GiveInventory("UnholyBossAmmo200",1) //
8H12 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
8H12 A 0 A_Refire("KeepHolding")
goto Fire_EVIL_Blade

FireBlade:
8H12 A 0 A_PlaySoundEx("weapon/metalblade","Weapon")
8H12 A 0 A_TakeInventory("Blitzkrieg_Charge")
8H12 A 0 A_Refire(1)
8H12 A 1
8H12 A 0 A_FireCustomMissile("Blitzkrieg_MetalBlade",0,0,8,0)
8H12 B 2 Offset(-1,33) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-70,74) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-121,114) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-146,201) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-171,225) A_GiveInventory("UnholyBossAmmo200",1) //
goto ReadyX
FireBlade_More:
8H12 A 0 A_PlaySoundEx("weapon/wheelstart","Weapon")
8H12 A 0 A_TakeInventory("Blitzkrieg_Charge") //
8H12 A 1
8H12 A 0 A_SpawnItemEx("Blitzkrieg_CutterW_Bouncer_Spawn",0,0,0,1.5,0,1.0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION|SXF_MULTIPLYSPEED)
8H12 B 2 Offset(-1,33) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-70,74) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-121,114) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-146,201) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-171,225) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 A 6 //2 //Delay
//8H12 A 0 A_Refire("FireBlade_More")//
goto ReadyX

Fire_EVIL_Blade:
8H12 A 0 A_PlaySoundEx("weapon/metalblade","Weapon") //
8H12 A 0 A_TakeInventory("Blitzkrieg_Charge")
8H12 A 0 A_Refire(1)
8H12 A 2
8H12 A 2 A_FireCustomMissile("Blitzkrieg_MetalBlade_Charged",0,0,8,0)
8H12 B 2 Offset(-1,33) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-70,74) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 B 2 Offset(-121,114) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-146,201) A_GiveInventory("UnholyBossAmmo200",1) //
8H12 C 2 Offset(-171,225) A_GiveInventory("UnholyBossAmmo200",1) //
goto ReadyX

//

/*Check:
TNT1 A 1 A_GiveInventory("KnightFlag",1)
TNT1 A 0 A_JumpIfInventory("KnightFlag",50,"Return")
loop
Return:
8H12 A 2 Offset(-30,88)A_TakeInventory("KnightFlag")
8H12 A 2 Offset(-15,60)
Goto ReadyX

HumiliationaryButtsecks:
8H12 D 2 Offset(-1,27)A_TakeInventory("UnholyPower1000",1000)
8H12 D 2 Offset(-2,21)
8H12 E 0 A_PlaySoundEx("Pokemon/Swift","Body")
8H12 E 2 Offset(-2,21)A_FireCustomMissile("BlitzKriegAssistantRainHelper",0,0,0,0)
8H12 D 2 Offset(-2,21)
8H12 D 2 Offset(-1,27)
Goto ReadyX*/

AltFire:
8H12 A 0 A_JumpIfInventory("Blitzkrieg_Charge",1,"FireBlade_More") /////
8H12 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"CavityBegone")
Goto ReadyX
CavityBegone:
8H12 D 2 Offset(8,27) A_TakeInventory("UnholyBossAmmo200",200)
8H12 D 2 Offset(-2,21)
8H12 D 2 Offset(-2,21)
8H12 E 2 Offset(-2,21)
8H12 C 0 A_PlaySoundEx("weapon/spreaddrill1","Weapon")
8H12 E 2 Offset(-2,21)A_FireCustomMissile("Blitzkrieg_BigDrill",0,0,0,0)
8H12 D 8 Offset(-2,21)
8H12 D 10 Offset(8,27)
Goto ReadyX

/*AltFire:
8H12 A 0 A_JumpIfInventory("Blitzkrieg_Charge",1,"FireBlade_More") /////
8H12 D 2 Offset(8,27)A_PlaySoundEx("weapon/mirroractivate","Weapon")
8H12 D 2 Offset(-2,21)
AltHold:
8H12 E 0 A_PlaySoundEx("weapon/metalblade","Weapon")
8H12 E 2 Offset(-2,21)A_FireCustomMissile("DrillingHoleWepAttack",0,0,8,0)
8H12 E 0 A_ReFire
8H12 E 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H12 E 2 Offset(-2,21)A_FireCustomMissile("DrillingHoleWepAttackRanged",0,0,8,0)
8H12 D 8 Offset(-2,21)
8H12 D 10 Offset(8,27)
Goto ReadyX*/

Reload:
TNT1 A 0 A_JumpIfInventory("UnholyPower1500",1500,"BLITZKRIEG_CALL")
goto ReadyX
BLITZKRIEG_CALL:
TNT1 A 0 A_TakeInventory("UnholyPower1500",1500) 
TNT1 A 0 A_GiveInventory("Blitzkrieg_Rage_P")
goto ReadyX
}
}


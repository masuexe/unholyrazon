States 
{
Spawn:
X_2A A 0
X_2A A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_TARGET)
SpawnLoop:
X_2A AAAA 0 A_SeekerMissile(90, 90, SMF_PRECISE)
//X_2A A 0 A_PlaySoundEx("weapon/gyroattack","Weapon")
X_2A A 0 A_SpawnItemEx("Blitzkrieg_MetalBlade_Damager",0,0,0,0,0,0,0,1)
X_2A A 1 //A_GiveToTarget("CringeFlag", 1)
X_2A A 0 A_Countdown
X_2A A 0 A_JumpIfCloser(64, "Death")
X_2A AAAA 0 A_SeekerMissile(90, 90, SMF_PRECISE)
X_2A A 0 A_PlaySoundEx("weapon/wheelclimb","Weapon")
X_2A B 1 //A_GiveToTarget("CringeFlag", 1)
X_2A A 0 A_Countdown
X_2A A 0 A_JumpIfCloser(64, "Death")
loop
Death:
TNT1 A 0
stop
}
}


actor Blitzkrieg_BigDrill : BasicProjectile
{
Translation "192:192=223:223","198:198=5:5"
DamageType "BlitzKrieg"
Obituary "%o had better teeth all thanks to \cmCaptain \ciBlitzkrieg\c- (%k)."
//+RIPPER
+SKYEXPLODE
+EXPLODEONWATER
+THRUACTORS
+THRUGHOST
+DONTBLAST
Gravity 0.25
damage (0) //50
radius 8 //32
height 8 //16
speed 30 //20
scale 2.5
states
{
Spawn:
X_BE A 0
X_BE B 0 A_SpawnItemEX("Blitzkrieg_BigDrill_Yank",0,0,0,momx,momy,momz,0,8)
X_BE B 0 A_Explode(50,64,0,0,65) //I wonder why it has to be a number higher.
X_BE B 2 A_SpawnItemEX("Blitzkrieg_BigDrill_Yank",0,0,0,momx,momy,momz,0,8)
X_BE A 0 A_Explode(50,64,0,0,65) //
X_BE A 2 A_SpawnItemEX("Blitzkrieg_BigDrill_Yank",0,0,0,momx,momy,momz,0,8)
Goto Spawn+2
Death:

actor BlitzKriegAssistantRainHelper : BasicWatcher
{
Reactiontime 56
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_GiveToTarget("BlitzKriegAssistantRain_P",1)
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_CountDown
loop
}
}

actor BlitzKriegAssistantRain_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("BlitzKriegAssistantRain",random(800,-800),random(800,-800),400,0,0,random(-20,-22))
stop
}
}

actor BlitzKriegAssistantRain : BasicProjectile
{
Translation "192:192=5:5", "198:198=185:185"
damagetype "BlitzKrieg"
Obituary "%o caught a \cmCaptain \ciBlitzkrieg\c- (%k)'s \cmJawbreaker \cgAssistant\c-."
+RIPPER
+NOINTERACTION
+DONTBLAST
Reactiontime 20
damage (50)
radius 16
height 8
Scale 2.5
States
{
Spawn:
DRIM K 0
DRIM K 1 A_JumpIf(ceilingz-z>8,"Spawn2a")
DRIM K 1 A_JumpIf(ceilingz-z>8,"Spawn2b")
DRIM K 1 A_JumpIf(ceilingz-z>8,"Spawn2c")
goto Spawn1
Spawn1:
DRIM LLLMMM 1 A_JumpIf(ceilingz-z>8,"Spawn2")
DRIM L 0 A_JumpIf(momz==0,"Death")
DRIM L 0 A_CountDown
loop
Spawn2a:
DRIM K 0 A_ChangeFlag("RIPPER",0)
DRIM K 3 A_ChangeFlag("NOINTERACTION",0)
goto SpawnL
Spawn2b:
DRIM K 0 A_ChangeFlag("RIPPER",0)
DRIM K 2 A_ChangeFlag("NOINTERACTION",0)
goto SpawnL
Spawn2c:
DRIM K 0 A_ChangeFlag("RIPPER",0)
DRIM K 1 A_ChangeFlag("NOINTERACTION",0)
goto SpawnL
Spawn2:
DRIM L 0 A_ChangeFlag("RIPPER",0)
DRIM L 0 A_ChangeFlag("NOINTERACTION",0)
goto SpawnL
SpawnL:
DRIM LM 3
DRIM L 0 A_JumpIf(momz==0,"Death")
DRIM M 0 A_CountDown
loop
Death:
X_8B A 0
X_8B A 0 A_PlaySoundEx("wep_L/mm8/astrocrushexplode","Weapon")
X_8B A 0 A_SetGravity(0.0)
X_8B A 0 A_Explode(375,248,0,0,32)
X_8B ABCDEF 2
stop
}
}

actor Blitzkrieg_CutterW_Bouncer_Spawn : BasicProjectile
{
var int user_NoTranslation;
Translation "192:192=223:223","198:198=5:5","202:202=223:223","199:199=5:5"
Damagetype "BlitzKrieg"
Obituary "%o got an unprescribed surgery from \cmCaptain \ciBlitzkrieg\c- (%k)'s Secondary Cutter."
+STEPMISSILE
+CANBOUNCEWATER
+NOEXPLODEFLOOR
+RIPPER
+INVISIBLE
maxstepheight 32
RenderStyle None
Damage (150)
Radius 10
Height 10
Speed 5
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1
TNT1 A 1 A_Stop //SXF_TRANSFERTRANSLATION
TNT1 A 0 A_SpawnItemEx("Blitzkrieg_CutterW_Bouncer",0,0,0,1.5,0,1.0,0,SXF_NOCHECKPOSITION|SXF_MULTIPLYSPEED)//1+32+8192
stop
Death:
TNT1 A 0 A_SpawnItemEx("MegaU_MMFX",0,0,20,0,0,0,0,1)
stop
}
}

actor Blitzkrieg_CutterW_Bouncer : BasicProjectile
{
var int user_angle;
Translation "192:192=223:223","198:198=5:5","202:202=223:223","199:199=5:5"
DeathSound "weapon/wheelshot"
Damagetype "BlitzKrieg"
Obituary "%o got an unprescribed surgery from \cmCaptain \ciBlitzkrieg\c- (%k)'s Secondary Cutter."
-NOGRAVITY
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
+RIPPER //
bouncecount 3
bouncefactor 0.8 //0.6
wallbouncefactor 1.0
gravity 1.5
Damage (150)
Radius 10
Height 10
speed 8 //5
scale 2.5
States
{
Spawn:
X_AG C 0
X_AG C 0 A_SetUserVar(user_angle,angle*1000000)
X_AG C 0 A_JumpIf(z-floorz<=0,"Boost")
SpawnL:
X_AG CD 2
loop
Boost:
X_AG C 0 A_ChangeVelocity(0,0,10,CVF_RELATIVE)
goto SpawnL
XDeath:
TNT1 A 0 A_SpawnItemEx("MegaU_MMFX",0,0,20,0,0,0,0,1)
stop
Death:
X_AG C 0 
TNT1 A 0 A_SpawnItemEx("Blitzkrieg_CutterW",0,0,0,1.0,0,0,user_angle/1000000.0,1|SXF_ABSOLUTEANGLE|SXF_MULTIPLYSPEED)//1+4+8192
TNT1 A 1 
stop
}
}


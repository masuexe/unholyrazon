actor Blitzkrieg_MetalBlade : BasicProjectile
{
var int user_TranslateWhiteColors;
Translation "4:4=223:223"
BounceSound "TheDentist/BladeBounce"
damagetype "BlitzKrieg"
Obituary "%o had better teeth all thanks to \cmCaptain \ciBlitzkrieg\c- (%k)."
+RIPPER
+USEBOUNCESTATE
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+BOUNCEONACTORS
+ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
+NOGRAVITY //Fine, you can stay on.
WALLBOUNCEFACTOR 0.8 //1.0
BOUNCEFACTOR 0.8 //1.0
bouncecount 3 //4
Gravity 1.25
Damage (100+Args[0]) //125 base
Radius 12
Height 12
Speed 54 //60
scale 2.5
Args 0,2
States
{
Spawn:
TNT1 A 1
TNT1 A 0 A_Jump(256,1,2,3,4,5,6,7,8)
Spawn1:
6P29 ABCD 2
loop
Spawn2:
6P29 DCBA 2
loop
Spawn3:
TNT1 A 0 A_Jump(256,"Spawn4","Spawn5")
Spawn4:
6P29 ABCD 1 A_SetArg(0,Args[0]+Args[1])
loop
Spawn5:
6P29 DCBA 1 A_SetArg(0,Args[0]+Args[1])
loop

Bounce:
"####" "#" 0 A_ChangeFlag("USEBOUNCESTATE",0)
"####" "#" 0 A_ChangeFlag("NOGRAVITY",0)
"####" "#" 0 //
"####" "#" 0 A_ChangeVelocity(momx,momy,momz*2/3,CVF_REPLACE)
"####" "#" 0 A_SetArg(0,Args[1]*5)
goto Spawn3

Death:
TNT1 A 1
stop
}
}

actor Blitzkrieg_MetalBlade_Charged : BasicProjectile
{
Translation "192:192=223:223"
var int user_stuck;
damagetype "BlitzKrieg"
Obituary "%o had better teeth all thanks to \cmCaptain \ciBlitzkrieg\c- (%k)."
+HITTRACER //
+SKYEXPLODE //
+DONTSPLASH
+HEXENBOUNCE
+NOTARGETSWITCH
+DONTREFLECT
+SKYEXPLODE
+CANBOUNCEWATER
Bouncefactor 1.0
WallBounceFactor 1.0
reactiontime 12 //
damage (180) //Used to be 450
Radius 12 //
Height 12 //
speed 60
Scale 2.5
States
{
Spawn:
X_2A A 0
X_2A ABABABABABABABABABAB 1 A_PlaySoundEx("weapon/wheelclimb","Weapon") //A_SpawnItemEx("GermanShinyBladeD",0,0,0,momx,momy,momz,0,8)
X_2A A 0 A_SpawnItemEx("Blitzkrieg_MetalBlade_ChargedR",0,0,0,0,0,0,0,1)
stop
Crash:
XDeath: //
X_6F V 0 A_SetUserVar("user_stuck",1)
Death: //HARKEN TO ME.
X_6F V 0 A_ChangeFlag("DONTBLAST",1) //
X_6F V 0 A_Stop
X_6F V 0 A_PlaySound("classes/KOSpecialSFX","SoundSlot5")
I_Sawed_The_Demons:
X_2A A 0 A_Warp(8,-4,0,28,0,8+16)//64
X_2A A 0 A_PlaySoundEx("weapon/metalblade","Weapon")
X_2A A 0 A_SpawnItemEx("BlitzKrieg_Blade_Stuck_Damager",0,0,0,0,0,0,0,1)
X_2A A 0 A_GiveInventory("BlitzBlade_Check",1)
X_2A A 1 A_JumpIfInventory("BlitzBlade_Check",12,"GetBack")
X_2A A 0 A_Warp(8,-4,0,28,0,8+16)
X_2A B 1 A_JumpIfInventory("BlitzBlade_Check",12,"GetBack")
X_2A B 0 A_Warp(8,-4,0,28,0,8+16)
X_2A A 1 A_JumpIfInventory("BlitzBlade_Check",12,"GetBack")
X_2A A 0 A_Warp(8,-4,0,28,0,8+16)
X_2A B 1 A_JumpIfInventory("BlitzBlade_Check",12,"GetBack")
X_2A B 0 A_Warp(8,-4,0,28,0,8+16)
//X_2A V 0 A_CountDown
X_2A A 0 A_JumpIf(CallACS("core_targetexists")==0,"GetBack")
X_2A A 0 A_JumpIf(user_stuck==0,"I_Sawed_The_Demons")
X_2A A 0 A_JumpIf(CallACS("core_targetexists",1)==0,"GetBack")
loop
GetBack:
X_2A A 0 A_Warp(8,0,0,28,0,8)
X_2A A 0 A_SpawnItemEx("BlitzKrieg_Blade_Yoink",0,0,0,0,0,0,0,1) //
X_2A A 1 A_SpawnItemEx("Blitzkrieg_MetalBlade_ChargedR",0,0,0,0,0,0,0,1)
stop
}
}


actor BlitzKrieg_Blade_Yoink : BasicExplosion
{
damagetype "BlitzKrieg" //I originally wanted this to pull, but I don't think that's worth doing. - Trist
Obituary "%o had better teeth all thanks to \cmCaptain \ciBlitzkrieg\c- (%k)."
States
{
Spawn:
TNT1 A 0 //Should it spew teeth? FX teeth, I mean. Stuff that wouldn't hurt. Ehh... - Trist
TNT1 A 2 A_Explode(50,16,0,0,16) //
stop
} //But if it should pluck people, you tell me. - Trist.
}


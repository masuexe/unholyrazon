actor BlitzKrieg_JawBreaker_Warper_Spawner : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("Blitzkrieg_Jawbreaker_Warper_L")
TNT1 A 0 A_SpawnItemEx("Blitzkrieg_Jawbreaker_Warper_R")
stop
}
}

actor Blitzkrieg_Jawbreaker_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 5
SpawnLoop:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 AA 1 A_JumpIf(CallACS("UB_DeadlyFireArmsButtonCheck")==2,"SpawnFire")
TNT1 A 0 A_JumpIfInTargetInventory("No_More_Nazzies",1,"SpawnLoop")
goto Death
SpawnFire:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_GiveToTarget("VivifyDelay9")
TNT1 A 5 A_GiveToTarget("Blitzkrieg_Jawbreaker_P",1) //15 ?
TNT1 AAAAAAAAAA 2 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
goto SpawnLoop+3
Death:
TNT1 A 0
TNT1 A 1 //A_GiveToTarget("DeadlyFireGXDeath",1)
stop
}
}

// Animate this, somehow.
// TODO: add walking animation?
actor Blitzkrieg_Jawbreaker_Warper_L : BasicShieldWarper
{
Translation "192:192=5:5", "198:198=185:185"
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Warp(2,-16,52,0,0,24) //-8x
Goto SpawnL
SpawnL:
DRIM A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DRIM A 0 A_JumpIfInTargetInventory("VivifyDelay9", 1, "SpawnMissile")
DRIM A 1 A_Warp(2,-16,52,0,0,24) //-8x
DRIM A 0 A_JumpIfInTargetInventory("No_More_Nazzies",1,"SpawnL")
DRIM A 1 A_JumpIf(1,"Death")
wait
SpawnMissile:
DRIM F 1 A_Warp(2,-16,52,0,0,24) //-8x
DRIM F 0 A_JumpIfInTargetInventory("No_More_Nazzies",1,"SpawnL")
DRIM F 1 A_JumpIf(1,"Death")
wait
Death:
DRIM HHHHHHHHHHHHHHHHHH 1 A_Warp(2,-16,52,0,0,24)
DRIM H 0 A_SpawnItemEx("FakeUnholyDeathFX",0,0,32,0,0,0,random(0,359),1)
TNT1 A 1
stop
}
}


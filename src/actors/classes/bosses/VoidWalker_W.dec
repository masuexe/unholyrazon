Actor VoidWalker_W : BaseUnholyBossWep  // VeryFunOrbWep
{
Inventory.Pickupmessage "En-garde!"
Obituary "%o was consumed by %k's power."
//Tag "[Culex's Big Meaty Claws]"
weapon.ammotype "UnholyBossAmmo200"
States
{
Spawn:
6N02 I 6
loop

Deselect:
8H54 A 0
goto DeselectSwap
Select:
8H54 A 0
goto SelectSwap

Ready:
8H54 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", VOIDWALKER_DYE, CLRF_VOIDWALKER_WIND)
8H54 ABABAB 2
ReadyX8:
8H54 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX0")
8H54 A 2 A_WeaponReady(8)
8H54 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX0:
8H54 A 2 A_WeaponReady
8H54 A 0 A_GiveInventory("UnholyBossAmmo200",1)
loop

Fire:
WindOrbFire:
8H54 A 0 A_JumpIfInventory("WindOrbCommandM2",1,"ReadyX8")
8H54 A 0 A_GiveInventory("WindOrbCommandM1")
8H54 A 0 A_GiveInventory("VivifyFlag1") //done to prevent item switching mid-attack
8H54 I 1 Offset(-1,30)
8H54 I 1 Offset(-3,27)
WindOrbHold:
8H54 M 2 Offset(-4,24) A_GiveInventory("UnholyBossAmmo200",1)
8H54 M 0 A_Refire("WindOrbHold")
8H54 M 0 A_TakeInventory("WindOrbCommandM1")
8H54 M 0 A_TakeInventory("VivifyFlag1")
8H54 I 1 Offset(-2,26) A_GiveInventory("UnholyBossAmmo200",1)
8H54 I 1 Offset(-1,29)
Goto ReadyX8

Altfire:
8H54 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,1)
goto ReadyX8
AltfireCheckWind:
8H54 A 0 A_JumpIfInventory("WindOrbCommandM2",1,"ReadyX8")
8H54 A 0 A_TakeInventory("UnholyBossAmmo200",200)
AltfireWind:
8H54 I 0 A_GiveInventory("VivifyFlag1")
8H54 I 1 Offset(-1,30) A_GiveInventory("WindOrbCommandM2")
8H54 I 1 Offset(-3,27)
8H54 I 1 Offset(-4,25)
8H54 M 1 Offset(-6,22) A_FireCustomMissile("WindOrbStaticStormSpawner",0,0,0,0)
8H54 Q 1 Offset(-5,22)
8H54 Q 1 Offset(-6,22)
8H54 M 1 Offset(-5,22)
8H54 M 1 Offset(-6,22)
8H54 Q 1 Offset(-5,22)
8H54 Q 1 Offset(-6,22)
8H54 M 1 Offset(-5,22)
8H54 M 1 Offset(-6,22)
8H54 Q 1 Offset(-5,22)
8H54 Q 1 Offset(-6,22)
8H54 M 1 Offset(-5,22)
8H54 M 1 Offset(-6,22)
8H54 Q 1 Offset(-5,22)
8H54 Q 1 Offset(-6,22)
8H54 M 1 Offset(-5,22)
8H54 M 1 Offset(-6,22)
8H54 Q 1 Offset(-5,22)
8H54 Q 1 Offset(-6,22)
8H54 M 1 Offset(-5,22)
8H54 I 1 Offset(-4,26) A_TakeInventory("VivifyFlag1")
8H54 I 1 Offset(-3,28)
8H54 I 1 Offset(-1,30)
goto ReadyX8
/*Flash:
TNT1 A 1
TNT1 A 0 A_JumpIfInventory("WeaponCharge",1,"FlashSound")
loop
FlashSound:
TNT1 A 0 A_PlaySoundEx("MarioRPG/GenoCharge","Weapon")
TNT1 A 1
TNT1 A 0 A_JumpIfInventory("WeaponCharge",1,1)
goto Flash
TNT1 A 0
goto FlashSound+1*/
}
}


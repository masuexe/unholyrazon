}
}

Actor WindOrbCommandM1 : Powerup {powerup.duration 0x7FFFFFFD}
Actor WindOrbCommandM2 : WindOrbCommandM1 {}
Actor EarthOrbCommandM1 : WindOrbCommandM1 {}
Actor EarthOrbCommandM2 : WindOrbCommandM1 {}
Actor WaterOrbCommandM1 : WindOrbCommandM1 {}
Actor WaterOrbCommandM2 : WindOrbCommandM1 {}
Actor FireOrbCommandM1 : WindOrbCommandM1 {}
Actor FireOrbCommandM2 : WindOrbCommandM1 {}

Actor VeryFunOrbSpawner : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("VeryFunOrb",0,0,0,0)
TNT1 A 0 A_FireCustomMissile("VeryFunOrb2",90,0,0,0)
TNT1 A 0 A_FireCustomMissile("VeryFunOrb3",180,0,0,0)
TNT1 A 0 A_FireCustomMissile("VeryFunOrb4",270,0,0,0)
stop
}
}

Actor OrbSwitchDelay : Powerup {powerup.duration -1}
Actor OrbFlagWind : UOnce {}
Actor OrbFlagEarth : UOnce {}
Actor OrbFlagWater : UOnce {}
Actor OrbFlagFire : UOnce {}


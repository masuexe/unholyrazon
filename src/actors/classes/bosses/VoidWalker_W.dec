TNT1 A 0 A_Jump(256,"A","B","C","D","E")
goto A
A:
X_7A E 0
goto FrameLoop
B:
X_7A P 0
goto FrameLoop
C:
X_AD K 0
goto FrameLoop
D:
X_AD L 0
goto FrameLoop
E:

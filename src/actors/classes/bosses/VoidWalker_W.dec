Actor VeryFunOrbSparkFX : BasicGraphicEffect
{
Gravity 0.6
Alpha 0.8
States
{
SpawnFrame:
X_9H R 0
X_9H R 2
X_9H SSSTTTSSSTTT 1 A_SetScale(scaleX-0.08)
stop
}
}

Actor VeryFunOrb : BasicProjectile
{
Translation "192:192=106:106","198:198=110:110"
+DONTBLAST
+THRUGHOST
+THRUACTORS
+NOTARGETSWITCH
+NOCLIP
+NOINTERACTION
+BRIGHT
Renderstyle "Translucent"
Damage(0)
Alpha 0.65 //0.8
Radius 4
Height 4
Scale 2.0
var int user_OrbDist;
States
{
Spawn:
6P06 A 0
6P06 A 0 A_SetUserVar("user_OrbDist",0)
Spawn2:
6P06 A 0 A_JumpIfInventory("CutterFlag",4,"Spawn3")
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 B 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 B 1 A_Explode(80,80,0,0,8)
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 C 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 C 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 D 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_Warp(2,user_OrbDist,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 D 1
6P06 A 0 A_SetUserVar("user_OrbDist",user_OrbDist+4)
6P06 A 0 A_GiveInventory("CutterFlag",1)
goto Spawn2
Spawn3:
6P06 A 0 A_JumpIfInventory("CutterFlag",6,"WarpCloser")
6P06 AAAAAAAA 1 A_Warp(2,132,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 0 A_GiveInventory("CutterFlag",1)
loop
WarpCloser:
6P06 A 0 A_SetTranslucent(0.6)
6P06 A 1 A_SetScale(1.5,3.0)
6P06 A 0 A_Warp(2,132,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.4)
6P06 A 1 A_SetScale(1.0,4.0)
6P06 A 0 A_Warp(2,132,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.2)
6P06 A 1 A_SetScale(0.6,5.5)
6P06 A 0 A_Warp(2,132,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.1)
6P06 A 1 A_SetScale(0.2,7.0)
6P06 A 0 A_Warp(2,132,0,28,3,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.2)
6P06 A 0 A_SetScale(0.6,5.5)
6P06 A 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.4)
6P06 A 0 A_SetScale(1.0,4.0)
6P06 A 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.6)
6P06 A 0 A_SetScale(1.5,3.0)
6P06 A 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_SetTranslucent(0.8)
6P06 A 0 A_SetScale(2.0,2.0)
6P06 A 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
WarpLoop:
6P06 A 0 A_ChangeFlag("FLOATBOB",1)
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 A_JumpIf(CallACS("rz_CheckVoidWalkerWeapon") == 1, "SpawnSpark")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM1",1,"AeroBlade")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM2",1,"StaticStorm")
6P06 AA 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM1",1,"AeroBlade")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM2",1,"StaticStorm")
6P06 BB 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM1",1,"AeroBlade")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM2",1,"StaticStorm")
6P06 CC 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM1",1,"AeroBlade")
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM2",1,"StaticStorm")
6P06 DD 1 A_Warp(2,16,-96,48,0,WARPF_NOCHECKPOSITION)
goto WarpLoop+1
AeroBlade: //Optimize this later possibly
6P06 A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
6P06 A 0 A_PlaySoundEx("item/buy","Voice")
6P06 A 1 A_Warp(2,20,-84,46,0)
6P06 A 1 A_Warp(2,24,-72,44,0)
6P06 B 1 A_Warp(2,28,-60,42,0)
6P06 B 1 A_Warp(2,32,-48,40,0)
6P06 C 1 A_Warp(2,36,-36,38,0)
6P06 C 1 A_Warp(2,40,-24,36,0)
6P06 D 1 A_Warp(2,44,-12,34,0)
6P06 D 1 A_Warp(2,48,0,32,0)
AeroBladeX:
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 A_Warp(2,48,0,32,0)
6P06 A 1 A_GiveToTarget("UH_TargetMarker")
6P06 A 0 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 0)
6P06 AA 1 A_Warp(2,48,0,32,0)
6P06 A 0 A_SpawnItemEx("AeroBladeProjectile",0,0,0,cos(-pitch)*36,0,sin(-pitch)*36,0,1)
6P06 BBBCCCDDD 1 A_Warp(2,48,0,32,0)
6P06 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
6P06 A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
6P06 A 0 A_JumpIfInTargetInventory("WindOrbCommandM1",1,"AeroBladeX")
6P06 A 1 A_Warp(2,44,-12,34,0)
6P06 A 1 A_Warp(2,40,-24,36,0)
6P06 B 1 A_Warp(2,36,-36,38,0)
6P06 B 1 A_Warp(2,32,-48,40,0)
6P06 C 1 A_Warp(2,28,-60,42,0)
6P06 C 1 A_Warp(2,24,-72,44,0)
6P06 D 1 A_Warp(2,20,-84,46,0)
6P06 D 1 A_Warp(2,16,-96,48,0)
goto WarpLoop+1
StaticStorm:
6P06 A 0 A_PlaySoundEx("item/buy","Voice")
6P06 A 0 A_SetTranslucent(0.6)
6P06 A 1 A_SetScale(1.5,3.0)
6P06 A 0 A_Warp(2,16,-96,48,0)
6P06 A 0 A_SetTranslucent(0.4)
6P06 A 1 A_SetScale(1.0,4.0)
6P06 A 0 A_Warp(2,16,-96,48,0)
6P06 A 0 A_SetTranslucent(0.2)
6P06 A 1 A_SetScale(0.6,5.5)
6P06 A 0 A_Warp(2,16,-96,48,0)
6P06 A 0 A_SetTranslucent(0.1)
6P06 A 1 A_SetScale(0.2,7.0)
6P06 A 0 A_Warp(2,16,-96,48,0)
SStormLoop:
TNT1 A 1 A_Warp(2,0,0,28,0)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("WindOrbCommandM2",1,"SStormLoop")
goto WarpCloser+12
Death:
TNT1 A 0
stop
SpawnSpark:
6P06 AAA 0 A_SpawnItemEx("VeryFunOrbSparkFX",random(-12,12),random(-12,12),random(-12,12),0,0,random(-1,-2),0,1)
goto WarpLoop+4
}
}


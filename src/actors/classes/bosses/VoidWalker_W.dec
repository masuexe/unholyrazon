8H54 T 1 Offset(-6,22)
8H54 P 1 Offset(-5,22)
8H54 P 1 Offset(-6,22)
8H54 T 1 Offset(-5,22)
8H54 T 1 Offset(-6,22)
8H54 P 1 Offset(-5,22)
8H54 L 1 Offset(-4,26) A_TakeInventory("VivifyFlag1")

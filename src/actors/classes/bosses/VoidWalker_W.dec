Actor FrigidFreezerRadiusFX
{
Translation "192:192=201:201","198:198=203:203"
PROJECTILE
+CLIENTSIDEONLY
+FLOATBOB
Renderstyle "Add"
Gravity 0.6
Alpha 0.8
Scale 1.0
Reactiontime 35
States
{
Spawn:
TNT1 A 0

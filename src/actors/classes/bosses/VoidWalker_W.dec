// FIRE
Actor VoidWalker_W4 : VoidWalker_W {
States
{
Deselect:
8H54 G 0
goto DeselectSwap
Select:
8H54 G 0
goto SelectSwap

Ready:
8H54 G 0 ACS_NamedExecuteWithResult("core_weaponcolor", VOIDWALKER_DYE, CLRF_VOIDWALKER_FIRE)
8H54 GHGHGH 2
ReadyX8:
8H54 G 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX0")
8H54 G 2 A_WeaponReady(8)
8H54 G 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX0:
8H54 G 2 A_WeaponReady
8H54 G 0 A_GiveInventory("UnholyBossAmmo200",1)
loop

Fire:
8H54 G 0 A_JumpIfInventory("FireOrbCommandM2",1,"ReadyX8")
8H54 G 0 A_GiveInventory("VivifyFlag1")
8H54 G 2 A_PlaySound("MarioRPG/GenoCharge",1)
goto FireOrbHold
FireOrbHold:
8H54 G 0 A_JumpIfInventory("WeaponCharge",28,"FireOrbHold2")
8H54 G 1 A_GiveInventory("WeaponCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
8H54 G 0 A_Refire("FireOrbHold")
goto FireOrbRelease
FireOrbHold2:
8H54 H 0 A_JumpIfInventory("WeaponCharge",56,"FireOrbHold3")
8H54 H 1 A_GiveInventory("WeaponCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
8H54 H 0 A_Refire(1)
goto FireOrbRelease
8H54 H 0 A_JumpIfInventory("WeaponCharge",56,"FireOrbHold3")
8H54 H 1 A_GiveInventory("WeaponCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
8H54 H 0 A_Refire(1)
goto FireOrbRelease
8H54 G 0 A_JumpIfInventory("WeaponCharge",56,"FireOrbHold3")
8H54 G 1 A_GiveInventory("WeaponCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
8H54 G 0 A_Refire(1)
goto FireOrbRelease
8H54 G 0 A_JumpIfInventory("WeaponCharge",56,"FireOrbHold3")
8H54 G 1 A_GiveInventory("WeaponCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
8H54 G 0 A_Refire("FireOrbHold2")
goto FireOrbRelease
FireOrbHold3:
8H54 HG 1
8H54 H 0 A_Refire("FireOrbHold3")
goto FireOrbRelease
FireOrbRelease:
8H54 L 0 A_StopSound(CHAN_WEAPON)
8H54 L 0 A_GiveInventory("FireOrbCommandM1")
8H54 L 1 Offset(-1,30)
8H54 L 1 Offset(-3,27)
8H54 PPP 2 Offset(-4,24) A_GiveInventory("UnholyBossAmmo200",1)
8H54 P 0 A_TakeInventory("FireOrbCommandM1")
8H54 PPP 2 Offset(-4,24) A_GiveInventory("UnholyBossAmmo200",1)
8H54 L 0 A_TakeInventory("VivifyFlag1")
8H54 L 1 Offset(-2,26)
8H54 L 1 Offset(-1,29)
8H54 L 0 A_TakeInventory("WeaponCharge")
goto ReadyX8

AltFire:
8H54 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,1)
goto ReadyX8
8H54 A 0 A_JumpIfInventory("FireOrbCommandM2",1,"ReadyX8")
8H54 A 0 A_TakeInventory("UnholyBossAmmo200",200)
AltfireFire:
8H54 L 0 A_GiveInventory("VivifyFlag1")
8H54 L 1 Offset(-1,30) A_GiveInventory("FireOrbCommandM2")
8H54 L 1 Offset(-3,27)
8H54 L 1 Offset(-4,25)
8H54 P 1 Offset(-6,22)
8H54 T 1 Offset(-5,22)
8H54 T 1 Offset(-6,22)
8H54 P 1 Offset(-5,22)
8H54 P 1 Offset(-6,22)
8H54 T 1 Offset(-5,22)
8H54 T 1 Offset(-6,22)
8H54 P 1 Offset(-5,22)
8H54 P 1 Offset(-6,22)
8H54 T 1 Offset(-5,22)
8H54 T 1 Offset(-6,22)
8H54 P 1 Offset(-5,22)
8H54 P 1 Offset(-6,22)

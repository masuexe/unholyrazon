6P06 A 1 A_SetScale(0.2,7.0)
6P06 A 0 A_Warp(2,0,0,96,0,WARPF_NOCHECKPOSITION)
goto WarpCloser+12
SpawnSpark:
6P06 AAA 0 A_SpawnItemEx("VeryFunOrbSparkFX",random(-12,12),random(-12,12),random(-12,12),0,0,random(-1,-2),0,1)
goto WarpLoop+4
}
}


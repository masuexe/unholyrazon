Damagetype "TerraTracker"
Obituary "%k's \csTerra Tracker \c-left %o awakened."
Damage(250)
Radius 10
Height 10
Speed 60
Scale 2.0
States
{
Spawn:
6P06 A 0
6P06 A 1 A_SpawnItemEx("TerraTrackerThrownFX1",-4)
6P06 B 1 A_SpawnItemEx("TerraTrackerThrownFX2",-4)
6P06 C 1 A_SpawnItemEx("TerraTrackerThrownFX1",-4)
6P06 D 1 A_SpawnItemEx("TerraTrackerThrownFX2",-4)
goto Spawn+1
Death:
6P06 A 0 A_SpawnItemEx("TerraTrackerExplosion",0,0,0,0,0,0,0,1)
6P06 A 0 A_PlaySoundEx("misc/hugequake","Body")
6P06 A 0 Radius_Quake(6,60,0,85,0)
6P06 AAAA 0 A_SpawnItemEx("TerraTracker",0,0,4,random(15,20),0,random(4,20),random(0,359),1)
6P06 ABCDABCDABCD 2
6P06 A 0 A_SetTranslucent(0.6)
6P06 A 1 A_SetScale(1.5,3.0)
6P06 A 0 A_SetTranslucent(0.4)
6P06 A 1 A_SetScale(1.0,4.0)
6P06 A 0 A_SetTranslucent(0.2)
6P06 A 1 A_SetScale(0.6,5.5)
6P06 A 0 A_SetTranslucent(0.1)
6P06 A 1 A_SetScale(0.2,7.0)
TNT1 A 0 A_TakeFromTarget("EarthOrbCommandM2")
TNT1 A 1
stop
}
}


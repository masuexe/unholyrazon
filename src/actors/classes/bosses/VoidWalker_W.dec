Actor TerraTracker : BasicProjectile
{
-NOGRAVITY
+SEEKERMISSILE
+LOOKALLAROUND
+BOUNCEONCEILINGS
+BOUNCEONWALLS
+NOEXPLODEFLOOR
+THRUACTORS
+THRUSPECIES
//+FLOORHUGGER
Species "Culex"
Damagetype "TerraTracker"
Obituary "%o was hunted down by %k's Terra Tracker."
Damage(0)
Bouncefactor 0.88
Bouncecount 8
Radius 10
Height 10
Scale 2.0
Speed 15
Reactiontime 35
States
{
Spawn:
X_5C D 0
X_5C DDD 0 A_SpawnItemEx("TerraTrackerFX",random(-8,8),random(-8,8),random(-8,8),0,0,random(-4,-8),0,1)
X_5C D 2
X_5C D 0 A_CheckFloor("FloorLock")
goto Spawn+1
FloorLock:
TNT1 A 0 A_SetGravity(100.0)
TNT1 A 0 A_PlaySoundEx("CBM/GroundDig","Voice")
TNT1 A 0 A_SeekerMissile(15,20,SMF_LOOK|SMF_PRECISE,256,10)
TNT1 AAAA 0 A_SpawnItemEx("TerraTrackerFX",random(4,-4),random(-6,6),4,random(3,6),0,random(2,6),random(120,240),1)
TNT1 A 3 A_Explode(56,48,0)
TNT1 A 0 A_PlaySoundEx("CBM/GroundDig","Voice")
TNT1 A 0 A_SeekerMissile(15,20,SMF_LOOK|SMF_PRECISE,256,10)
TNT1 AAAA 0 A_SpawnItemEx("TerraTrackerFX",random(4,-4),random(-6,6),4,random(3,6),0,random(2,6),random(120,240),1)
TNT1 A 3 A_Explode(56,48,0)
TNT1 A 0 A_Countdown
goto FloorLock+1
Death:
TNT1 A 0
stop
}
}


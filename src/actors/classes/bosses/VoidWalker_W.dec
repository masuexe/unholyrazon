const int RAZINGRAY_RANGE = 48;

//Somewhat shamelessly "borrowed" from Pegg's Utsuho concept, look I really love the laser
Actor RazingRayPinpoint : BasicProjectile
{
Translation "192:192=174:174","198:198=176:176","4:4=229:229","208:208=229:229","0:0=175:175"
Damagetype "RazingRay"
+THRUACTORS
+FORCEXYBILLBOARD
+DONTBLAST
+DONTREFLECT
//+CLIENTSIDEONLY
+THRUSPECIES
Obituary "%o was eradicated completely by %k's \ciRazing Ray\c-."
Species "Culex"
speed 10
Radius 4
Height 4
damage (0)
reactiontime 25
scale 1.0
States
{
Spawn:
X_3C A 0
X_3C A 0 A_SetPitch(pitch+0.1)
X_3C A 0 A_JumpIf(pitch>RAZINGRAY_RANGE,"Death2")
X_3C A 0 A_SpawnItemEx("RazingRayPinpoint",0,0,0,momx,momy,momz,0,553)
X_3C A 1 A_Stop
stop
Death:
TNT1 A 5 A_SetScale(1.5)
6PMS L 0 A_PlaySoundEx("weapon/electricshock","Voice")
6PMS HI 2 A_Explode(55,180,0,0,24) //48,160,40
6PMS JKL 1 A_Explode(45,160,0,0,20) //A_SpawnItemEx("RazingRayExplosion",0,0,0,0,0,0,0,1)
stop
Death2:
TNT1 A 0
stop
}
}


actor GraniteMauler_W_ScriptBar : ScriptBar {}
actor GraniteMauler_W : BaseUnholyBossWep {
  Tag "$TAG_GraniteMauler_W"
  Obituary "%o lacked a good defense level to evade \caGranite Mauler\c- (%k)'s attacks."
  Weapon.AmmoType "GraniteCharger"
  Weapon.AmmoType2 "UnholyBossAmmo200"
  States  // Max hit is 41?
  {
   Spawn:
    8I14 [ 1
    wait

   Deselect:
    8I14 A 0
    goto DeselectSwap
   Select:
    8I14 A 0
    goto SelectSwap

   Ready:
    8I14 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, GRANITEMAULER_DYE)
    goto Ready2

   Ready2:
    8I14 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Ready3")
    8I14 A 2 A_WeaponReady(8)
    8I14 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    Loop
   Ready3:
    8I14 A 2 A_WeaponReady
    8I14 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    Loop

   Fire:
    8I14 D 0 A_CheckFlag("FLOORHUGGER", "QuickSmash")
    8I14 D 2 OffSet(0, 26)
    8I14 E 2 OffSet(0, 20)A_GiveInventory("UnholyBossAmmo200", 1)
    8I14 F 1 OffSet(0, 14)A_Refire("FireNullCharge")
    goto AirStrikeFire

   AirStrikeFire:
    8I14 A 0 A_CheckFlag("FLOORHUGGER", "QuickSmash")
    8I14 A 0 A_TakeInventory("GraniteCharger")
    8I14 A 0 A_TakeInventory("GenericBossFlag100")
    8I14 A 0 A_PlaySoundEx("weapon/powerstone", "Weapon")
    8I14 A 0 A_FireCustomMissile("GraniteMaulerAirStrike", 0, 0, 0, 0)
    8I14 A 0 A_FireCustomMissile("GraniteMaulerAirStrike", 90, 0, 0, 0)
    8I14 A 0 A_FireCustomMissile("GraniteMaulerAirStrike", 180, 0, 0, 0)
    8I14 A 0 A_FireCustomMissile("GraniteMaulerAirStrike", 270, 0, 0, 0)
    8I14 D 2 OffSet(0, 2)
    8I14 B 2 OffSet(0, -12)
    8I14 B 2 OffSet(0, -28)A_GiveInventory("UnholyBossAmmo200", 1)
    8I14 C 2 OffSet(0, -46)A_TakeInventory("GraniteCharger")
    8I14 C 2 OffSet(0, -66)A_TakeInventory("GenericBossFlag100")
    8I14 C 2 OffSet(0, -45)A_GiveInventory("UnholyBossAmmo200", 1)
    8I14 B 2 OffSet(0, -24)
    8I14 B 2 OffSet(0, -6)
    8I14 A 2 OffSet(0, 9)A_GiveInventory("UnholyBossAmmo200", 1)
    8I14 A 2 OffSet(0, 22)
    goto Ready2

   FireNullCharge:
    8I14 F 0 A_CheckFlag("FLOORHUGGER", "QuickSmash")
    8I14 F 0 A_JumpIfInventory("GraniteCharger", 20, "FireHold")
    8I14 F 0 A_JumpIfInventory("PlayerPropertyRage", 1, 3)
    8I14 F 1 OffSet(0, 14)A_GiveInventory("GraniteCharger", 1)
    8I14 F 0 A_Refire("FireNullCharge")
    goto AirStrikeFire
    8I14 F 1 OffSet(0, 14)A_GiveInventory("GraniteCharger", 2)
    8I14 F 0 A_Refire("FireNullCharge")
    goto AirStrikeFire

   FireHold:
    8I14 F 1 OffSet(0, 14)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire(1)
    goto FireLeap
    8I14 F 1 OffSet(0, 12)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire(1)
    goto FireLeap
    8I14 F 1 OffSet(0, 10)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire(1)
    goto FireLeap
    8I14 F 1 OffSet(0, 11)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire(1)
    goto FireLeap
    8I14 F 1 OffSet(0, 12)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire(1)
    goto FireLeap
    8I14 F 0 A_GiveInventory("UnholyBossAmmo200", 1)
    8I14 F 1 OffSet(0, 13)A_GiveInventory("GraniteMaulerCharge_RC")
    8I14 F 0 A_Refire("FireHold")
    goto FireLeap

   FireLeap:
    8I14 B 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 17)
    8I14 B 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 23)
    8I14 B 0 A_GiveInventory("VivifyFlag1")
    8I14 D 1 OffSet(0, -10)A_GiveInventory("GraniteMaulerLeap_P")
    8I14 B 1 OffSet(0, -30)A_GiveInventory("GraniteCharger", 20)
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "FireLeap_Alt")
    8I14 C 1 OffSet(0, -50)A_JumpIf(momz<=0, "FireLeapF")
    wait

   FireLeap_Alt:
    8I14 C 0  // A_SpawnItemEx("Headbutt",0,0,56,0,0,20)
    8I14 C 0 A_JumpIf(momz<=0, "FireLeapF_Alt")
    8I14 C 1 OffSet(0, -50)A_WeaponReady(7)
    loop

   FireLeapF:
    8I14 C 0 A_SpawnItemEx("GraniteMaulerCrusher", 0, 0, -28, 0, 0, 0, 0, 1)
    8I14 C 1 OffSet(0, -46)A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "FireLeapEnd")
    loop

   FireLeapF_Alt:
    8I14 C 0 A_SpawnItemEx("GraniteMaulerCrusher", 0, 0, -28, 0, 0, 0, 0, 1)
    8I14 C 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "FireLeapEnd")
    8I14 C 1 OffSet(0, -46)A_WeaponReady(7)
    loop

   FireLeapEnd:
    8I14 A 0 A_GiveInventory("GraniteMaulerStomp_P")
    8I14 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 23)
    8I14 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 17)
    8I14 B 1 OffSet(0, -10)A_ScaleVelocity(0.1)
    8I14 D 1 OffSet(0, 26)A_ScaleVelocity(0.1)
    8I14 F 1 OffSet(0, 44)A_ScaleVelocity(0.1)
    8I14 A 0 A_JumpIfInventory("GenericBossFlag100", 100, "FireLeapEndSecret")
    8I14 A 0 A_TakeInventory("GraniteCharger")
    8I14 A 0 A_TakeInventory("GenericBossFlag100")
    8I14 A 0 A_TakeInventory("VivifyFlag1")
    8I14 A 0 A_ScaleVelocity(0.1)
    8I14 F 2 OffSet(0, 54)
    8I14 E 2 OffSet(0, 45)A_GiveInventory("UnholyBossAmmo200", 2)
    8I14 D 2 OffSet(0, 38)A_GiveInventory("UnholyBossAmmo200", 2)
    Goto Ready2

   FireLeapEndSecret:
    8I14 F 0 A_TakeInventory("GraniteCharger")
    8I14 F 0 A_TakeInventory("GenericBossFlag100")
    8I14 F 0 A_TakeInventory("VivifyFlag1")
    8I14 F 1 OffSet(0, 62)A_ScaleVelocity(0.1)
    goto SecondaryMaulPowers

   SecondaryMaulPowers:
    TNT1 A 0 A_GiveInventory("GraniteDigger", 40)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    TNT1 A 0 A_ChangeFlag("NONSHOOTABLE", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)
    TNT1 A 0 A_ChangeFlag("PICKUP", 0)
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER", 1)
    TNT1 A 0 A_SetTranslucent(0.0, 0)
    TNT1 A 0 ThrustThingZ(0, 40, 1, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 23)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 17)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 0)
    TNT1 A 2
    TNT1 AA 4 A_GiveInventory("UnholyBossAmmo200", 1)
    goto MaulerDig

   MaulerDig:
    TNT1 AA 0 A_SpawnItemEx("GraniteMaulerRockFX", 0, 0, 8, random(-10, 10), 0, random(2, 12), random(0, 359), 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 1)
    TNT1 A 0 A_TakeInventory("GraniteDigger", 1)
    TNT1 A 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
    TNT1 A 0 A_JumpIfInventory("GraniteDigger", 1, 1)
    Goto QuickSmash
    TNT1 AA 0 A_SpawnItemEx("GraniteMaulerRockFX", 0, 0, 8, random(-10, 10), 0, random(2, 12), random(0, 359), 1)
    TNT1 A 0 A_TakeInventory("GraniteDigger", 1)
    TNT1 A 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
    TNT1 A 0 A_JumpIfInventory("GraniteDigger", 1, "MaulerDig")
    Goto QuickSmash

   QuickSmash:
    TNT1 A 0 A_GiveInventory("GraniteMaulerDigEnd_P")
    // TNT1 A 0 A_ClearRefire
    TNT1 A 0 A_GunFlash
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerDigSpecial2", 0, 0, 0)
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "SoundSlot6")

    8I14 F 1 OffSet(0, 88)A_FireCustomMissile("GraniteMaulerDigSpecial", 0, 0, 0, 20)
    8I14 F 1 OffSet(0, 80)A_FireCustomMissile("GraniteMaulerDigSpecial", 0, 0, 0, 20)
    8I14 F 1 OffSet(0, 70)A_FireCustomMissile("GraniteMaulerDigSpecial", 0, 0, 0, 20)
    8I14 E 1 OffSet(0, 58)A_FireCustomMissile("GraniteMaulerDigSpecial", 0, 0, 0, 20)

    // 8I14 E 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8I14 E 0 A_ChangeFlag("NONSHOOTABLE", 0)
    8I14 E 0 A_ChangeFlag("THRUACTORS", 0)
    8I14 E 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    8I14 E 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8I14 E 1 OffSet(0, 44)A_SetTranslucent(1.0, 0)
    8I14 E 1 OffSet(0, 28)A_GiveInventory("UnholyBossAmmo200", 3)
    8I14 D 1 OffSet(0, 10)A_GiveInventory("GenericBossFlag100", 75)
    8I14 D 0 A_SetTranslucent(1.0, 0)
    Goto FireLeap


   AltLeapCancel:
    8I14 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 23)
    8I14 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 17)
    8I14 B 0 A_TakeInventory("VivifyFlag1")
    8I14 B 0 A_TakeInventory("GraniteCharger")
    8I14 B 0 A_TakeInventory("GenericBossFlag100")
    8I14 B 0 A_Refire(1)
    8I14 B 0
    goto SteadyBreath
   Altfire:
    8I14 A 0 A_JumpIfInventory("GraniteCharger", 10, "AltLeapCancel")
    8I14 A 0 A_CheckFlag("FLOORHUGGER", "QuickSmash")
   SteadyBreath:
    8I14 B 2 OffSet(0, 10)A_TakeInventory("UnholyBossAmmo200", 4)
    8I14 B 0 A_GiveInventory("VivifyFlag2")
    8I14 B 2 OffSet(0, -12)A_TakeInventory("UnholyBossAmmo200", 4)
    8I14 C 2 OffSet(0, -34)A_TakeInventory("UnholyBossAmmo200", 4)
   WardingBreath:
    8I14 C 1 OffSet(0, -56)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto EdgeOfDawn
    8I14 C 0 A_Refire(1)
    goto EdgeOfDawn
    8I14 C 1 OffSet(0, -58)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto EdgeOfDawn
    8I14 C 0 A_Refire(1)
    goto EdgeOfDawn
    8I14 C 1 OffSet(0, -60)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto EdgeOfDawn
    8I14 C 0 A_Refire(1)
    goto EdgeOfDawn
    8I14 C 1 OffSet(0, -59)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto EdgeOfDawn
    8I14 C 0 A_Refire(1)
    goto EdgeOfDawn
    8I14 C 1 OffSet(0, -58)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, 1)
    goto EdgeOfDawn
    8I14 C 0 A_Refire(1)
    goto EdgeOfDawn
    8I14 C 1 OffSet(0, -57)A_GiveInventory("GraniteMaulerDash_P")
    8I14 C 0 A_JumpIfInventory("UnholyBossAmmo200", 1, "FierceBreath")
    goto EdgeOfDawn
   FierceBreath:
    8I14 C 0 A_Refire("WardingBreath")
    goto EdgeOfDawn

   EdgeOfDawn:
    8I14 C 0 A_TakeInventory("SuplexID")
    8I14 C 0 A_TakeInventory("UnholyBossAmmo200", 50)
    8I14 C 0 A_PlaySoundEx("G_Axe/S_30", "Weapon")
    8I14 C 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I14 C 0 A_TakeInventory("SuplexID")
    8I14 C 1 OffSet(0, -48)A_FireCustomMissile("GraniteMaulerGrabber", 0, 0, 0, 0)
    8I14 C 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 C 1 OffSet(0, -38)A_FireCustomMissile("GraniteMaulerGrabber", 0, 0, 0, 0)
    8I14 C 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 C 1 OffSet(0, -28)A_FireCustomMissile("GraniteMaulerGrabber", 0, 0, 0, 0)
    8I14 C 1 OffSet(0, -18)A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 B 1 OffSet(0, -8)A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 B 1 OffSet(0, 2)A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 B 1 OffSet(0, 12)A_JumpIfInventory("SuplexID", 1, "Suplex")
    8I14 A 1 OffSet(0, 21)
    8I14 A 2 OffSet(0, 25)ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8I14 A 2 OffSet(0, 28)A_TakeInventory("GenericBossFlag1")
    8I14 A 2 OffSet(0, 30)
    goto Ready2

   Suplex:
    TNT1 A 0 A_PlaySoundEx("KirbyNES/FoeGrab", "Weapon")

    TNT1 A 0  // ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    TNT1 A 0 A_SetAngle(CallACS("uh_ZangiefFaceTarget", CallACS("rz_CountInv_SuplexID")-1+1000)*360/256)
    TNT1 A 0 A_SetPitch(0)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_noradiusdmgplayer", 0, 1)
    TNT1 A 0 A_GiveInventory("VivifyDelay5")

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)

    8I14 B 0 A_GunFlash
    8I14 B 0 A_Stop
    8I14 B 1 OffSet(0, -18)ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 B 0 A_SpawnItemEx("ZangiefGrabFX", 56, 0, 28, 0, 0, 0, 0, 1, 0)
    8I14 B 0 A_SpawnItemEx("ZangiefGrabFX2", 56, 0, 28, 0, 0, 0, 0, 1, 0)
    8I14 B 0 A_Stop
    8I14 B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 B 0 A_Stop
    8I14 B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 B 0 A_Stop
    8I14 B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 B 0 A_Stop
    8I14 B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 B 0 A_Stop
    8I14 B 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)

    8I14 B 0 A_Stop
    8I14 B 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1, 0)
    8I14 B 1 A_Recoil(-4)
    8I14 B 0 ThrustThingZ(0, 100, 0, 0)
    8I14 B 0 A_TakeInventory("JumpCancler")
   GoingUp:
    8I14 B 0  // ThrustThingZ(0,1,1,1)
    8I14 B 0 A_SetAngle(angle+20.0)
    8I14 B 1 OffSet(0, -22)A_Jumpif(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "GraniteKaboom")
    8I14 B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "GraniteKaboom")
    8I14 B 0 A_JumpIf(momz>0, "GoingUp")
   GoingDown:
    8I14 B 0 ThrustThingZ(0, 2, 1, 1)
    8I14 B 0 A_SetAngle(angle+20.0)
    8I14 B 1 OffSet(0, -18)A_Jumpif(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "GraniteKaboom")
    8I14 B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "GraniteKaboom")
    8I14 B 0 A_JumpIf(momz<0, "GoingDown")

   GraniteKaboom:
    8I14 D 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    8I14 D 0 A_FireCustomMissile("GraniteMaulerSlamJam", 0, 0, 0, 0)
    8I14 D 0 A_GiveInventory("VivifyDelay4")
    8I14 D 0 A_Recoil(10)
    8I14 D 0 ThrustThingZ(0, 35, 0, 0)

    8I14 D 2 OffSet(0, 10)
    8I14 E 2 OffSet(0, 38)
    8I14 F 2 OffSet(0, 66)

    8I14 F 2 OffSet(0, 56)
    8I14 E 2 OffSet(0, 47)A_TakeInventory("GenericBossFlag1")
    8I14 D 2 OffSet(0, 39)A_GiveInventory("ZangiefResetFlags_P")
    goto Ready2
  }
}

actor GraniteDigger : Inventory {
  inventory.amount 1
  inventory.maxamount 40
}

actor GraniteCharger : Ammo {
  inventory.maxamount 20
  +INVENTORY.IGNORESKILL
}

actor GraniteMaulerCharge_RC : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("GenericBossFlag100", 1 + CallACS("uh_CheckRune", RUNE_RAGE))
    stop
  }
}

actor GraniteMaulerDigEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("GraniteDigger")
    TNT1 A 0 A_SetTranslucent(1.0, 0)
    TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER", 0)
    TNT1 A 0 A_ChangeFlag("PICKUP", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 23)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 17)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 0)
    TNT1 A 0 ThrustThingZ(0, 50, 0, 0)
    stop
  }
}


actor GraniteMaulerLeap_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/superarmuse", "Weapon")
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_TakeInventory("JumpCancler")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 100, "P_Leap5")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 75, "P_Leap4")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 50, "P_Leap3")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 25, "P_Leap2")
    goto P_Leap1

   P_Leap1:
    TNT1 A 0 A_Recoil(-10)
    TNT1 A 0 ThrustThingZ(0, 60, 0, 0)
    stop
   P_Leap2:
    TNT1 A 0 A_Recoil(-15)
    TNT1 A 0 ThrustThingZ(0, 80, 0, 0)
    stop
   P_Leap3:
    TNT1 A 0 A_Recoil(-20)
    TNT1 A 0 ThrustThingZ(0, 100, 0, 0)
    stop
   P_Leap4:
    TNT1 A 0 A_Recoil(-25)
    TNT1 A 0 ThrustThingZ(0, 120, 0, 0)
    stop
   P_Leap5:
    TNT1 A 0 A_Recoil(-30)
    TNT1 A 0 ThrustThingZ(0, 160, 0, 0)
    stop
  }
}

actor GraniteMaulerStomp_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/hugequake", "Weapon")

    TNT1 A 0 A_GiveInventory("VivifyDelay3")
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 100, "P_Stomp5")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 75, "P_Stomp4")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 50, "P_Stomp3")
    TNT1 A 0 A_JumpIfInventory("GenericBossFlag100", 25, "P_Stomp2")
    goto P_Stomp1

   P_Stomp1:
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerStomp1", 0, 0, 0, 0)
    stop
   P_Stomp2:
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerStomp2", 0, 0, 0, 0)
    stop
   P_Stomp3:
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerStomp3", 0, 0, 0, 0)
    stop
   P_Stomp4:
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerStomp4", 0, 0, 0, 0)
    stop
   P_Stomp5:
    TNT1 A 0 A_FireCustomMissile("GraniteMaulerStomp5", 0, 0, 0, 0)
    stop
  }
}

actor PowerGraniteMaulerTrail : PowerSpeed {
  Speed 1.0
  Powerup.Duration 10
}

actor GraniteMaulerDash_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_GiveInventory("PowerGraniteMaulerTrail")
    TNT1 A 0 A_GiveInventory("GenericBossFlag1")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 4)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "Ground")
    TNT1 A 0 A_Recoil(-1.3)
    TNT1 A 0 ThrustThingZ(0, 0.5f, 1, 1)
    stop
   Ground:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Ground2")
    TNT1 A 0 A_Recoil(-2.6)
    stop
   Ground2:
    TNT1 A 0 A_Recoil(-3.25)
    stop
  }
}


actor GraniteMaulerAirStrike : BasicProjectile {
  Translation "192:192=16:16", "198:198=31:31", "0:0=191:191"
  var int user_S;  // Speed
  var int user_MT;  // MaxTurn
  var int user_TD;  // TurnDivisor
  var int user_TD_A;  // TurnDivisor_Add
  Obituary "%o caught \caGranite Mauler\c- (%k)'s air strike."

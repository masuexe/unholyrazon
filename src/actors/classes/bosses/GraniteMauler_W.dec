    X_9B B 1 A_ChangeVelocity(user_S, 0, 0, 3)
    X_9B B 0 A_SpawnItemEx("GraniteMaulerAirStrikeFX", random(-10, 10), random(-10, 10), random(-10, 10), 0, 0, 0, 0, 1)
    X_9B B 0 A_SetUserVar("user_TD", user_TD+user_TD_A)
    X_9B B 0 A_Setangle(angle-user_MT/user_TD)
    X_9B B 1 A_ChangeVelocity(user_S, 0, 0, 3)
    X_9B B 0 A_SpawnItemEx("GraniteMaulerAirStrikeFX", random(-10, 10), random(-10, 10), random(-10, 10), 0, 0, 0, 0, 1)

    X_9B C 0 A_SetUserVar("user_TD", user_TD+user_TD_A)

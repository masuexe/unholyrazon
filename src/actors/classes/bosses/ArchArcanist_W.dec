X_2B A 0 A_SpawnItemEx("GenericWindRuneAttackRF",0,0,0,28,0,0,60)
X_2B A 0 A_SpawnItemEx("GenericWindRuneAttackLF",0,0,0,28,0,0,-60)
//X_2B A 0 A_SpawnItemEx("GenericWindRuneAttackX",0,0,0,30,0,0,0)
loop
Spawn2:
X_2B ABC 1
X_2B CBA 1
X_2B ABC 1 A_Changevelocity(0,user_C1,0,CVF_RELATIVE)
X_2B CAB 1
X_2B CBA 1
X_2B ABC 1 A_Changevelocity(0,user_C1*-1,0,CVF_RELATIVE)
loop

Death:
X_2B GHIJ 2
stop
}
}


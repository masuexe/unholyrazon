actor ArcaneArrowShotBoss : BasicFastProjectile
{
Translation "192:192=79:79","198:198=5:5"
var int user_P;
damagetype "ElementalFire"
Obituary "%o became nothing by \ctArch \cmArcanist\c- (%k)'s \ctArcane Inferno Arrow\c-."
+DONTBLAST
damage (150+user_P*25)
Radius 15
Height 15
speed 120
scale 3.25
States
{
Spawn:
TMFX B 0 A_SetUserVar("user_P",user_P+1)
TMFX B 1 A_SpawnItemEx("ArcaneArrowShotBossFX")
loop
Crash:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX","Weapon")
TNT1 A 0 A_Explode(185+user_P*25,148,0,0,32)
X_8B ABCDEF 2
stop
Death:
TMFX A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TMFX ABCD 2
stop
}
}

actor ArcaneSphereShotBoss : BasicProjectile
{

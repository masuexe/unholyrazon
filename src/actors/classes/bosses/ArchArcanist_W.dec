// Wind
actor ArchArcanist_W : BaseUnholyBossWep
{
Tag "$TAG_Boss018_W"
Obituary "%o learned that Nobody can win the game but \ctArch \cmArcanist\c- (%k). That's how the game works."
Inventory.Pickupmessage "\ctYou are about to die!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H18 [ 1
wait

Deselect:
8H18 Q 0
goto DeselectSwap
Select:
8H18 Q 0
goto SelectSwap

Ready:
8H18 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", ARCHARCANIST_DYE)
Goto ReadyX
ReadyX:
8H18 Q 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyXCheck")
8H18 H 2 A_WeaponReady(WRF_NOSECONDARY)
Goto ReadyEnd

ReadyXCheck:
8H18 H 2 A_WeaponReady
Goto ReadyEnd
ReadyEnd:
8H18 Q 0 A_GiveInventory("UnholyBossAmmo200",2)
Goto ReadyX

Fire:
8H18 Q 0 A_JumpIfInventory("UnholyPower1500",1500,"TakeMeAway")
WindMain:
8H18 I 2 Offset(18,35)
8H18 IJ 2 Offset(-2,21)
8H18 J 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttack",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackL",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackR",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackLF",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackRF",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackLS",0,0,8,0)
8H18 J 0 A_FireCustomMissile("GenericWindRuneAttackRS",0,0,8,0)
8H18 JI 2 Offset(-2,21)
8H18 I 2 Offset(18,35)
8H18 I 16 A_GiveInventory("UnholyBossAmmo200",5)
Goto ReadyX
AltFire:
8H18 H 1 A_JumpIfInventory("UnholyBossAmmo200",200,"KraiSekuoreh")
Goto ReadyX
KraiSekuoreh:
8H18 Q 0 A_TakeInventory("UnholyBossAmmo200",200)
ThunderAlt:
8H18 I 2 Offset(18,35)
8H18 IJ 2 Offset(-2,21)
8H18 J 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H18 J 20 A_SpawnItemEx("LightningStrikerWaver",0,0,0,20,0,0,0)
8H18 I 2 Offset(-2,21)
8H18 I 2 Offset(18,35)
Goto ReadyX

TakeMeAway:
8H18 Q 0 A_GiveInventory("UnholyPowerDazzle_F")
8H18 Q 0 A_TakeInventory("UnholyPower1500", 1500)
8H18 Q 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8H18 Q 0 A_Stop
8H18 Q 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H18 Q 0 A_GiveInventory("ArchArcanistFloorHop_P",1)
8H18 Q 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H18 Q 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",0,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",90,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",180,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",270,0,0,0)
8H18 RR 1
8H18 R 0 A_Stop
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",45,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",135,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",225,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",315,0,0,0)
8H18 R 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
8H18 R 5 ACS_NamedExecuteWithResult("core_chargecolor", ARCHARCANIST_DYE)
8H18 S 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
8H18 S 5 ACS_NamedExecuteWithResult("core_chargecolor", ARCHARCANIST_DYE)
8H18 T 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
8H18 T 5 ACS_NamedExecuteWithResult("core_chargecolor", ARCHARCANIST_DYE)
8H18 U 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
8H18 U 5 ACS_NamedExecuteWithResult("core_chargecolor", ARCHARCANIST_DYE)
8H18 V 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
8H18 V 5 ACS_NamedExecuteWithResult("core_chargecolor", ARCHARCANIST_DYE)
8H18 U 0 A_TakeInventory("UnholyPowerDazzle_F")
8H18 U 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H18 U 0 A_GiveInventory("ArcaneBangingWaveSync_P",1)
8H18 U 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8H18 U 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H18 U 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",0,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",90,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",180,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",270,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",45,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",135,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",225,0,0,0)
8H18 U 0 A_FireCustomMissile("ArcaneSphereShotBoss",315,0,0,0)
8H18 U 4
8H18 T 46 A_GiveInventory("UnholyBossAmmo200",100)
8H18 SSRRQ 2
Goto ReadyX
}
}

// Fire
actor ArchArcanist_W2 : ArchArcanist_W {
Tag "$TAG_Boss018_W"
States {
Ready:
8H18 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ARCHARCANIST_DYE)
Goto ReadyX_8
ReadyX:
ReadyX_8:
8H18 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX_0")
8H18 A 2 A_WeaponReady(WRF_NOSECONDARY)
8H18 A 0 A_GiveInventory("UnholyBossAmmo200",2)
Goto ReadyX
ReadyX_0:

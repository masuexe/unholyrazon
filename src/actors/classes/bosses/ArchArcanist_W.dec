8H18 A 0 A_GiveInventory("UnholyBossAmmo200",2)
Goto ReadyX

Fire:
8H18 Q 0 A_JumpIfInventory("UnholyPower1500",1500,"TakeMeAway")
FireMain:
8H18 B 0 A_PlaySoundEx("weapon/atomicfire","Weapon")
8H18 B 0 A_FireCustomMissile("PyreShotPellet",random(-2,2),0,8,random(-2,2))
8H18 B 2 Offset(18,35)
8H18 B 2 Offset(-2,21)A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX
AltFire:
8H18 A 1 A_JumpIfInventory("UnholyBossAmmo200",200,"KraiSekuoreh")
Goto ReadyX
KraiSekuoreh:
8H18 Q 0 A_TakeInventory("UnholyBossAmmo200",200)
FireAlt:
8H18 C 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire","Weapon")
8H18 C 0 A_FireCustomMissile("ArcaneArrowShotBoss",0,0,0,0)
8H18 CDEFG 2
TNT1 A 6
8H18 A 2 Offset(-7,69)
8H18 A 2 Offset(-3,48)
Goto ReadyX
}
}


// Reusing assets because, unfortuantely, when I make something like
// Faggasso's BOOM BOOM effect, its just pretty and well.
// Do I really want to use a different way of doing it?
// Who knows, its pretty and fits the boss very well.

actor CrazedMBExplodeExpand : BasicExplosion {
  Obituary "%o caught \cgCrazed \ciGrenademan\c- (%k)'s \caEmpowered \c-Grenade."
  +PIERCEARMOR
  Translation "192:192=4:4", "198:198=41:41"
  damagetype "CrazedMBEX"
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(45, 80, 0)  // 35 damage
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor CrazedMBExplodeFX : BasicGraphicEffect {
  Translation "192:192=4:4", "198:198=41:41"
  Scale 2.5
  States {
   SpawnFrame:
    TMFX BBBBCCCDD 2 A_FadeOut(0.05)
    Stop
  }
}


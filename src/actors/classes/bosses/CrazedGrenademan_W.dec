// TODO: All Moonbow hits should play Superstar Saga's EXCELLENT hit noise on pain.
actor CrazedMoonbowShot : BasicProjectile {
  Translation "192:192=41:41", "198:198=43:43"
  damagetype "CrazedMB"
  Obituary "%o caught \cgCrazed \ciGrenademan\c- (%k)'s \caEmpowered \c-Grenade."
  +PIERCEARMOR
  // +SKYEXPLODE
  damage (150)  // 50
  Radius 14
  Height 14
  speed 60  // 50
  scale 2.5
  States {
   Spawn:
    X_BF VVVWWWXXXYYY 1 A_SpawnItemEx("MBCrazedTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)  // Trail
    loop
   Death:
    TNT1 A 1 A_SpawnItemEx("CrazedMoonbowShotExplode")
    stop
  }
}

actor MBCrazedTrailFX : BasicGraphicEffect {
  Renderstyle "Add"
  Alpha 0.8
  States {
   SpawnFrame:
    X_BF VWXYVWXY 1
    X_BF VWXYVWXY 1 A_Fadeout(0.08)
    stop
  }
}


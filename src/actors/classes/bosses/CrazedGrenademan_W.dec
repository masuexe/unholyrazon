actor CrazedGrenademan_W_ScriptBar : ScriptBar {}
actor CrazedGrenademan_W : BaseUnholyBossWep  // Filler wep name
{  // CRUSHEVERYONEUHUHUHUHUHUHUWEP
  Obituary "%o was KO'd by \cgCrazed \ciGrenademan\c- (%k)."  // Filler obit
  Inventory.Pickupmessage "\cgREST IN PIECES, DOWN FOR THE COUNT! NO REVIVAL, YOU'RE BLEEDING OUT!"
  weapon.ammotype "UnholyBossAmmo200"  // 250??
  weapon.ammotype2 "UnholyBossAmmo100"
  States {
   Spawn:
    8H55 [ 1
    wait

   Deselect:
    8H55 A 0
    goto DeselectSwap
   Select:
    8H55 A 0
    goto SelectSwap

   Ready:
    8H55 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CRAZEDGRENADEMAN_DYE)
    8H55 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    // 8H55 A 0 A_JumpIfHealthLower(1751,"GetHypedForPain")
    8H55 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "ReadyX2")
    8H55 A 2 A_GiveInventory("CrazedGrenademan_Ready8_P")
    loop
   ReadyX2:
    8H55 A 2 A_GiveInventory("CrazedGrenademan_Ready0_P")
    loop

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 4 A_GiveInventory("UnholyBossAmmo100", 2)
    loop

   Fire:
    8H55 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Hold")  // 200
    Goto BUSTAH
   Hold:
   Charge:
    8H55 A 0
    goto Charge0
   Charge0:
    8H55 A 0 A_JumpIfInventory("WeaponChargeCG", 15, "Charge1")
    8H55 A 0 A_JumpIfInventory("WeaponChargeCG", 14, "ChargeStart")
    8H55 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge0R")
    8H55 A 1 A_GiveInventory("WeaponChargeCG", 1)
    8H55 A 0 A_Refire(1)
    goto BUSTAH
    8H55 B 0 A_JumpIfInventory("WeaponChargeCG", 15, "Charge1")
    8H55 B 0 A_JumpIfInventory("WeaponChargeCG", 14, "ChargeStart")
    8H55 B 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge0R2")
    8H55 B 1 A_GiveInventory("WeaponChargeCG", 1)
    8H55 B 0 A_Refire("Charge0")
    goto BUSTAH
   ChargeStart:
    8H55 A 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
    Goto Charge1
   Charge0R:
    8H55 A 1 A_GiveInventory("WeaponChargeCG", 2)
    8H55 A 0 A_Refire("Charge0")
    goto BUSTAH
   Charge0R2:
    8H55 B 1 A_GiveInventory("WeaponChargeCG", 2)
    8H55 B 0 A_Refire("Charge0")
    goto BUSTAH

   Charge1:
    8H55 A 0 A_JumpIfInventory("WeaponChargeCG", 50, "Charge2")
    8H55 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge1R")
    8H55 A 1 A_GiveInventory("WeaponChargeCG", 1)
    8H55 A 0 A_Refire(1)
    goto BUSTAH
    8H55 C 0 A_JumpIfInventory("WeaponChargeCG", 50, "Charge2")
    8H55 C 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge1R2")
    8H55 C 1 A_GiveInventory("WeaponChargeCG", 1)
    8H55 C 0 A_Refire(1)
    goto BUSTAH
   Charge1R:
    8H55 A 1 A_GiveInventory("WeaponChargeCG", 2)
    8H55 A 0 A_Refire("Charge1")
    goto BUSTAH
   Charge1R2:
    8H55 C 1 A_GiveInventory("WeaponChargeCG", 2)
    8H55 C 0 A_Refire("Charge1")
    goto BUSTAH

   Charge2:
    8H55 A 1 A_RailWait
    8H55 A 0 A_Refire(1)
    goto BUSTAH
    8H55 D 1 A_RailWait
    8H55 D 0 A_Refire("Charge2")
    goto BUSTAH

   BUSTAH:
    8H55 A 0 A_JumpIfInventory("WeaponChargeCG", 15, "WAULF")
    8H55 A 0 A_PlaySoundEx("wep_L/SluggerShotgun", "Weapon")
    8H55 A 0 A_FireCustomMissile("CrazedGMBurstExplode", 0, 0, 8, 0)
    8H55 A 0 A_FireCustomMissile("CrazedFlashBomb", 0, 0, 8, 0)
    8H55 A 1 Offset(4, 38)
    8H55 A 1 Offset(8, 44)
    8H55 A 1 Offset(13, 52)
    8H55 A 1 Offset(18, 60)
    8H55 BABAB 2 Offset(24, 72)  // -6
    8H55 A 1 Offset(20, 64)
    8H55 A 1 Offset(16, 56)
    8H55 A 1 Offset(12, 50)
    8H55 A 1 Offset(9, 44)
    8H55 A 1 Offset(6, 38)
    8H55 A 1 Offset(3, 35)
    8H55 A 0 A_WeaponReady(14)
    8H55 A 0 A_StopSound(1)
    8H55 A 0 A_TakeInventory("VivifyFlag1")
    8H55 A 10 A_TakeInventory("WeaponChargeCG", 1)  // A_GiveInventory("UnholyBossAmmo200",1)
    Goto ReadyX
   WAULF:
    8H55 A 0 A_TakeInventory("WeaponChargeCG", 5)
    8H55 A 0 A_PlaySoundEx("wep_L/SluggerShotgun", "Weapon")
    8H55 A 0 A_FireCustomMissile("MiniCrazedGMBurstExplode", 0, 0, 8, 0)
    8H55 A 0 A_FireCustomMissile("CrazedFlashBombR", random(-14, 14), 0, 8, 0, 0, random(-10, 10))
    8H55 B 1 Offset(24, 72)
    8H55 C 1 Offset(23, 73)
    8H55 B 1 Offset(24, 72)
    8H55 C 1 Offset(25, 71)
    8H55 C 0 A_JumpIfInventory("WeaponChargeCG", 5, "WAULF")
    Goto OHKEY
   OHKEY:
    8H55 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    goto BUSTAH+13
   Altfire:
    8H55 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "SPECIALTRIGGER")
    Goto ReadyX
   SPECIALTRIGGER:
    8H55 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    8H55 A 0 A_PlaySoundEx("weapon/mirrorabsorb", "Body")  // Some other channel????
    8H55 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    8H55 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    8H55 A 5 ACS_NamedExecuteWithResult("core_chargecolor", GENERICHELLCOLOR)
    8H55 A 2 ACS_NamedExecuteWithResult("core_chargecolor", CRAZEDGRENADEMAN_DYE)  // 5 tics
    8H55 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H55 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    8H55 A 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    8H55 A 0 A_FireCustomMissile("MBMiniCrazedGMBurstExplode", 0, 0, 8, 0)
    8H55 A 0 A_FireCustomMissile("CrazedMoonbowShot", 0, 0, 8, 0)
    8H55 A 1 Offset(4, 38)
    8H55 A 1 Offset(8, 44)
    8H55 A 1 Offset(13, 52)
    8H55 A 1 Offset(18, 60)
    8H55 D 1 Offset(24, 72)
    8H55 E 1 Offset(23, 73)
    8H55 D 1 Offset(24, 72)
    8H55 E 1 Offset(25, 71)
    8H55 D 1 Offset(24, 72)
    8H55 E 1 Offset(23, 73)
    8H55 D 1 Offset(24, 72)
    8H55 E 4 Offset(25, 71)
    Goto BUSTAH+13

   Reload:
    8H55 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "GETOFF")
    // WhereMyCountryGone: //In case someone happens to use the item while using M1 charge
    // 8H55 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"GETOFF")
    // 8H55 A 0 A_PlaySoundEx("weapon/pshot","Weapon")
    Goto ReadyX  // This'll throw them out so its not weird.
   GETOFF:
    8H55 A 0 A_PlaySoundEx("classes/skullabs", "Weapon")
    8H55 A 0 A_GiveInventory("VivifyFlag1")
    8H55 A 0 ACS_NamedExecuteWithResult("uh_SetClassCustomState", 1)
    8H55 A 0  // ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    8H55 D 1 Offset(4, 38)
    8H55 E 1 Offset(8, 44)
    8H55 D 1 Offset(13, 52)
    8H55 E 1 Offset(18, 60)
    8H55 A 0 A_PlaySound("misc/hsloop", 1, 2.0, 1)
   MY:
    8H55 D 0 A_Recoil(-5)  // -5
    8H55 D 0 A_SpawnItemEx("HillyBillyRamFX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    8H55 D 1 Offset(24, 72) A_SpawnItemEX("NoMansSkyRefundDamage", 0, 0, -44, momx, momy, momz, 0, 8, 0)
    8H55 D 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H55 D 0 A_JumpIfInventory("UnholyBossAmmo200", 5, 1)
    Goto WHATTHEFUCK
    8H55 E 0 A_Recoil(-5)  // -5
    8H55 E 0 A_SpawnItemEx("HillyBillyRamFX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    8H55 E 1 Offset(23, 73) A_SpawnItemEX("NoMansSkyRefundDamage", 0, 0, -44, momx, momy, momz, 0, 8, 0)
    8H55 E 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H55 E 0 A_JumpIfInventory("UnholyBossAmmo200", 5, "PROPERTY")
    Goto WHATTHEFUCK
   PROPERTY:
    8H55 D 0 A_Recoil(-5)  // -5
    8H55 D 0 A_SpawnItemEx("HillyBillyRamFX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    8H55 D 1 Offset(24, 72) A_SpawnItemEX("NoMansSkyRefundDamage", 0, 0, -44, momx, momy, momz, 0, 8, 0)
    8H55 D 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H55 D 0 A_JumpIfInventory("UnholyBossAmmo200", 5, 1)
    Goto WHATTHEFUCK
    8H55 E 0 A_Recoil(-5)  // -5
    8H55 E 0 A_SpawnItemEx("HillyBillyRamFX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    8H55 E 1 Offset(25, 71) A_SpawnItemEX("NoMansSkyRefundDamage", 0, 0, -44, momx, momy, momz, 0, 8, 0)
    8H55 E 0 A_TakeInventory("UnholyBossAmmo200", 5)
    8H55 E 0 A_JumpIfInventory("UnholyBossAmmo200", 5, "MY")
    Goto WHATTHEFUCK
   WHATTHEFUCK:
    8H55 A 0 A_PlaySoundEx("misc/BlankSound", "Weapon", 0)
    8H55 A 0  // ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    8H55 A 0 A_TakeInventory("UnholyBossAmmo200", 1)
    8H55 A 0 A_JumpIfInventory("AwShucksTheyGotHit", 1, "SOITSCOMETOTHIS")
    8H55 A 15 Offset(24, 72)
    goto BUSTAH+13
   SOITSCOMETOTHIS:
    8H55 A 0 A_TakeInventory("AwShucksTheyGotHit")
    8H55 CCCCCCCC 2 A_SpawnItemEx("PainFX", 0, 3)
    8H55 A 6
    Goto ReadyX
  }
}

actor AwShucksTheyGotHit : Once {}
actor WeaponChargeCG : WeaponCharge {inventory.amount 1  inventory.maxamount 50}

actor CrazedGrenademan_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor CrazedGrenademan_Ready8_P : CrazedGrenademan_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor HillyBillyRamFX : BasicGraphicEffect {
  Translation "192:192=215:215", "198:198=229:229"
  Alpha 0.8
  States {
   SpawnFrame:
    X_8B ABCDEF 2 A_FadeOut(0.1)  // 1
    stop
  }
}


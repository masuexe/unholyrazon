    TNT1 AAA 3 A_SpawnItemEx("MiniCrazedGMBurstExplodeReal", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor MBMiniCrazedGMBurstExplode : BasicExplosion {
  Translation "192:192=4:4", "198:198=41:41"
  damagetype "CrazedMB"
  Obituary "%o's lights were knocked out by \cgCrazed \ciGrenademan\c- (%k) grenade spray."
  Speed 28  // 3
  States {
   Spawn:

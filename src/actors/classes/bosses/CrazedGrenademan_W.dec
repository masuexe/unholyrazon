}

actor CrazedGMBurstExplodeReal : CrazedGMBurstExplode {
  Renderstyle "Translucent"
  Alpha 0.4  // 0.6
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(100, 196, 0, 0, 64)  // 200 damage
    X_8B ABCD 2 A_SpawnItemEx("CrazedGMBurstExplodeFX", random(-56, 56), random(-56, 56), random(-56, 56), 0, 0, 0, 0, 1)
    X_8B EF 2 A_FadeIn(0.2)
    stop
  }
}

actor MiniCrazedGMBurstExplodeReal : CrazedGMBurstExplode {
  Renderstyle "Translucent"
  Alpha 0.3  // 0.6
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(50, 128, 0, 0, 48)  // 200 damage
    X_8B A 1 A_SpawnItemEx("CrazedGMBurstExplodeFX", random(-56, 56), random(-56, 56), random(-56, 56), 0, 0, 0, 0, 1)
    X_8B BB 1 A_FadeIn(0.2)
    X_8B CDEF 1
    stop
  }
}

actor CrazedGMBurstExplodeFX : BasicGraphicEffect {
  Alpha 0.6
  Scale 1.5
  States {
   SpawnFrame:
    X_8B ABCD 2 A_FadeIn(0.1)

    X_8B EF 1
    stop
  }
}

/// /////////////////////////////////////////////////////////////
actor CrazedFlashBomb : BasicProjectile {
  Translation "198:198=223:223", "192:192=216:216", "199:199=227:227", "202:202=220:220", "77:77=218:218"
  damagetype "CrazedFlashBomb"
  Obituary "\cgCrazed \ciGrenademan\c- (%k) figured out that %o was a city slicker."
  +FORCEXYBILLBOARD
  Radius 6  // 6
  Height 7  // 7
  scale 2.5
  speed 18  // 26 //56 real-speed?
  damage (50)  // 0
  States {
   Spawn:  // A_ScaleVelocity(1.3)
    X_8G W 2 A_ScaleVelocity(1.2)
    X_8G X 2 A_ScaleVelocity(1.3)
    X_8G Y 2 A_ScaleVelocity(1.6)
    X_8G Z 2 A_ScaleVelocity(2.2)
    X_8G WXYZ 1 A_SpawnItemEx("CrazedFlashFX", 0, 0, 0, 0, 0, 0, 0, 1)  // Trail
    Goto Spawn+4
   Death:
    FLEX A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    FLEX A 1 A_SpawnItemEx("CrazedFlashBombExplosion")
    stop
  }
}

actor CrazedFlashBombR : CrazedFlashBomb {
  States {
   Death:
    FLEX A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    FLEX A 1 A_SpawnItemEx("CrazedFlashBombExplosionR")
    stop
  }
}

// Note: Smokey trail because its steaming HOT.
actor CrazedFlashFX : BasicGraphicEffect {
  Renderstyle "Add"
  Alpha 0.8
  States {
   SpawnFrame:
    X_8G WXYZWXYZ 1
    X_8G WXYZWXYZ 1 A_Fadeout(0.08)
    stop
  }
}

actor CrazedFlashbombDebris : BasicProjectile {
  Translation "192:192=214:214"  // "4:4=208:208", | <- Its white anyways.
  damagetype "CrazedFlashBomb"
  Obituary "%o was unfortunate enough to get hit by \cgCrazed \ciGrenademan\c- (%k)'s explosive debris."
  +RIPPER
  -NOGRAVITY
  +HEXENBOUNCE
  +CANBOUNCEWATER
  +FORCEXYBILLBOARD
  Reactiontime 8  // 10
  damage (30)  // 50
  Radius 10
  Height 10
  speed 20
  Scale 2.5
  States {
   Spawn:
    X_8G C 1 A_SpawnItemEx("CrazedFlashbombDebrisTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8G C 2 A_CountDown
    loop
   Death:
    X_8G C 0 A_SetGravity(0.0)
    X_8G CCCC 2 A_Fadeout(0.1)
    stop
  }
}

actor CrazedFlashbombDebrisTrail : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  States {
   SpawnFrame:
    X_8G AB 1 A_FadeOut
    loop
  }
}
//

actor CrazedFlashBombExplosion : CrazedFlashBomb {
  Obituary "%o was blown up into pieces by \cgCrazed \ciGrenademan\c- (%k)'s grenade"
  +NOCLIP
  +DONTBLAST
  +DONTSPLASH
  Reactiontime 12
  Scale 4.5
  States {
   Spawn:
    TNT1 A 0 Radius_Quake(6, 10, 0, 16, 0)  // 50 tremrad ?
    FLEX AB 1 bright
    FLEX AA 0 A_SpawnItemEx("CrazedFlashbombDebris", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20))
    FLEX CD 1 bright
    FLEX A 0 A_Explode(120, 92, 0)
    FLEX EE 0 A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, 1)
    FLEX EF 1 bright A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    FLEX AA 0 A_SpawnItemEx("CrazedFlashbombDebris", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20))
    FLEX EE 0 A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, 1)
    FLEX GF 1 bright A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    FLEX A 0 A_Explode(108, 92, 0)
    Goto Pattern1
   Pattern1:
    TNT1 A 0 Radius_Quake(2, 10, 0, 8, 0)  // 50 tremrad ?
    FLEX EF 1 bright A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    FLEX AA 0 A_SpawnItemEx("CrazedFlashbombDebris", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20))
    FLEX E 0 A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(-16, -40), Random(-32, 32), 0, 0, 0, 0, 1)
    FLEX GF 1 bright A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(16, 40), Random(-32, 32), 0, 0, 0, 0, 1)
    FLEX G 0 A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    Goto DamageNow
   Pattern2:
    TNT1 A 0 Radius_Quake(2, 10, 0, 8, 0)  // 50 tremrad ?
    FLEX EF 1 bright A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    FLEX AA 0 A_SpawnItemEx("CrazedFlashbombDebris", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20))
    FLEX E 0 A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(32, 64), Random(-32, 40), 0, 0, 0, 0, 1)
    FLEX E 0 A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(-32, -64), Random(-32, 40), 0, 0, 0, 0, 1)
    FLEX EF 1 bright A_SpawnItemEx("BasicFlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, 1)
    FLEX G 0 A_SpawnItemEx("BasicFlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), 1)
    Goto DamageNow
   DamageNow:
    FLEX G 0 A_Explode(80, 92, 0)
    Goto Continue
   Continue:
    FLEX G 0 A_CountDown
    FLEX G 0 A_Jump(256, "Pattern1", "Pattern2")
    Goto Death
   Death:
    FLEX A 0 A_SetGravity(0.0)
    FLEX G 1 bright
    TNT1 A 1
    FLEX D 1 bright
    TNT1 A 1
    FLEX D 1 bright
    TNT1 A 1
    FLEZ C 1 bright
    stop
  }
}

actor CrazedFlashBombExplosionR : CrazedFlashBombExplosion {Reactiontime 2}


actor NoMansSkyRefundDamage : BasicProjectile  // HillbillyRamDamage
{
  // 250 damage (?)
  damagetype "HillbillyRam"
  Obituary "\cgCrazed \ciGrenademan\c- (%k) ran %o out of town and out of options."
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  damage (250)  // What, you're not gonna nuke them with a ram, now are you?
  radius 96
  Height 168
  States {
   Spawn:
    TNT1 AA 1
    stop
   Death:
    TNT1 A 0
    Stop
  }
}

actor MightyNumberPizzaExplosion : BasicExplosion  // HillybillyRamExplodeFX
{
  Translation "192:192=215:215", "198:198=229:229"
  scale 4.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "SoundSlot5")
    TNT1 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE", "SoundSlot5")  // Slot whatever, these two noises need to play.
    6P03 ABCDEFG 2
    stop
  }
}

actor ConfederatePainPickup : CustomInventory {
  states  // Unless this plays the amazing sound that is FLOOV
  {
   Pickup:
    TNT1 A 0 A_Stop
    TNT1 A 0 ThrustThingZ(0, 35, 0, 0)  // 25 ~ 75
    TNT1 A 0 ThrustThing(random(0, 255), 500, 1, 0)
    TNT1 A 0 A_GiveInventory("AwShucksTheyGotHit")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 1)
    stop
  }
}

// Yes, Slugger fx is the best thing ever.
actor CrazedGMBurstExplode : BasicExplosion {
  Translation "192:192=218:218", "198:198=222:222"
  damagetype "CrazedFlashBomb"
  Obituary "%o was blown to smithereens by \cgCrazed \ciGrenademan\c- (%k)'s explosives."
  Speed 36  // 3
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("S_CD/Pound", "Body")  // Different sfx????
    TNT1 A 1 A_SpawnItemEx("CrazedGMBurstExplodeReal", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 AAA 3 A_SpawnItemEx("CrazedGMBurstExplodeReal", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}


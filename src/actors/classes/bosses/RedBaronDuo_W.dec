actor RedBaronDuo_W_NormalBar : NormalBar {args 23, 184}
actor RedBaronDuo_W : BaseUnholyBossWep {
  Tag "$TAG_RedBaronDuo_W"
  Obituary "%o was shot down by \crRed Baron\c- (%k)."
  weapon.ammotype "UnholyBossAmmo100"
  States {
   Spawn:
    8H33 [ 1
    wait

   Deselect:
    8H33 A 0
    goto DeselectSwap
   Select:
    8H33 A 0
    goto SelectSwap

   Ready:
    8H33 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, REDBARONDUO_DYE)
    goto ReadyX
   ReadyX:
    8H33 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "ReadyX2")
    8H33 A 2 A_WeaponReady(WRF_NOSECONDARY)
    8H33 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    Goto ReadyX
   ReadyX2:
    8H33 A 2 A_WeaponReady
    8H33 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    loop

   Fire:
    8H33 A 0 A_PlaySoundEx("Contra3/Rifle", "Weapon")
    // 8H33 DD 1 A_FireBullets(4.5,4.5,2,random(25,35),"RedBaronBulletHit",FBF_NOFLASH|FBF_NORANDOMPUFFZ)
    8H33 DD 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 D 1
    8H33 DD 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 D 1
    // 8H33 D 1 A_SetPitch(pitch-0.5)
    8H33 E 2 A_GiveInventory("UnholyBossAmmo100", 1)
    8H33 B 0 A_PlaySoundEx("Contra3/Rifle", "Body")
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    // 8H33 B 1 A_SetPitch(pitch-0.5)
    8H33 H 2 A_GiveInventory("UnholyBossAmmo100", 1)
    8H33 G 0 A_Refire("Fire2")
    8H33 G 2 A_GiveInventory("UnholyBossAmmo100", 1)
    Goto ReadyX
   Fire2:
    8H33 B 0 A_PlaySoundEx("Contra3/Rifle", "Weapon")
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    // 8H33 B 1 A_SetPitch(pitch-0.5)
    8H33 E 2 A_GiveInventory("UnholyBossAmmo100", 1)
    8H33 B 0 A_PlaySoundEx("Contra3/Rifle", "Body")
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    8H33 BB 0 A_FireCustomMissile("RedBaronBullet", frandom(-4.5, 4.5), 0, 0, 0, 0, frandom(-4.5, 4.5))
    8H33 B 1
    // 8H33 B 1 A_SetPitch(pitch-0.5)
    8H33 H 2 A_GiveInventory("UnholyBossAmmo100", 1)
    8H33 G 0 A_Refire("Fire2")
    8H33 G 2 A_GiveInventory("UnholyBossAmmo100", 1)
    Goto ReadyX
   AltFire:
    8H33 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "AirFire")
    goto ReadyX
   AirFire:
    8H33 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    8H33 A 0 A_Stop
    8H33 A 0 A_PlaySoundEx("Contra3/SpreadGun", "Weapon")
    8H33 A 0 A_FireCustomMissile("RedBaronMissile", -5, 0, 20, 0)
    8H33 A 0 A_FireCustomMissile("RedBaronMissile", 5, 0, -20, 0)
    8H33 A 0 A_FireCustomMissile("RedBaronMissile", -10, 0, 25, 0)
    8H33 A 0 A_FireCustomMissile("RedBaronMissile", 10, 0, -25, 0)
    8H33 A 0 A_Recoil(10)
    8H33 BCB 3
    8H33 A 15
    Goto ReadyX
  }
}
/*
Actor RedBaronBulletHit
{
Translation "192:192=23:23","198:198=184:184"
Damagetype "RedBaron"
Obituary "%o was shot down by \crRed Baron\c- (%k)."
+NOGRAVITY
+BLOODLESSIMPACT
Scale 1.5
States
{
Spawn:
TMFX ABCD 2
stop
}
}
 */
actor RedBaronBullet : BasicFastprojectile {
  Translation "192:192=23:23", "198:198=184:184"
  Damagetype "RedBaron"
  Obituary "%o was shot down by \crRed Baron\c- (%k)."
  +FORCEXYBILLBOARD
  Damage (random(25, 35))
  Radius 7
  Height 8
  Speed 150
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    Goto Fly
   Fly:
    6P19 A 1
    loop
   Crash:
   XDeath:
    6P10 B 0 A_PlaySoundEx("Contra3/BulletAlienHit", "Weapon")
   Death:
    6P19 BCD 2
    stop
  }
}

actor RedBaronMissile : BasicProjectile {
  Translation "192:192=23:23", "198:198=184:184"
  damagetype "RedBaron"
  Obituary "%o went boom from \crRed Baron\c- (%k)'s Danger Missile."
  Damage (random(475, 665))
  Radius 10
  Height 10
  speed 5
  scale 3.5
  States {
   Spawn:
    X_4G A 0 A_Recoil(-6)
    X_4G A 0 ThrustThingZ(0, 3, 1, 1)
    X_4G ABAB 1 A_BishopMissileWeave
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("Contra3/GrenadeExplode", "Body")
    TNT1 A 0 A_PlaySoundEx("Contra3/GrenadeExplodeBG", "Weapon")
    TNT1 A 3 A_SpawnItemEx("RedBaronMissileExplosion", 0, 0, 0, 0, 0, 8)
    TNT1 AAAAA 3 A_SpawnItemEx("RedBaronMissileExplosion2", random(0, 32), 0, 0, 0, 0, 8, random(0, 359))
    // TNT1 A 0 A_Explode(random(375, 575), 200, 1)
    // X_1D BCDEFGHIJKLMN 1
    stop
  }
}

actor RedBaronMissileExplosion : BasicExplosion {
  damagetype "RedBaron"
  Obituary "%o went boom from \crRed Baron\c- (%k)'s Danger Missile."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(random(35, 50), 50, 1)
    C3XP BCDEFGHIJK 1
    stop
  }
}

actor RedBaronMissileExplosion2 : RedBaronMissileExplosion {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(random(35, 50), 50, 1)
    C3XP MNOEFGHIJK 1
    stop
  }
}

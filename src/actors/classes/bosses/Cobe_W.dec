actor Cobe_W_NormalBar : NormalBar {args 4, 228}
// actor Cobe_W_ScriptBar : ScriptBar {}

actor Cobe_W : BaseUnholyBossWep //This class doesn't use an alt, but if it does... Make it a funny sound with no other purpose.
{ //Maybe a bark, who knows.
//Tag "VULCAN, I'M SO HUNGRY! LET'S EAT THE FUNNY MUSHROOM!"
Weapon.AmmoUse 0 //1
Weapon.AmmoGive 1
//Weapon.SlotNumber 4 //DOES THIS MATTER????
Inventory.Pickupmessage "Dog"
Obituary "Bark bark"
Tag "https://www.youtube.com/watch?v=eWEwAQuD_sU"
weapon.ammotype "Biscuits"
inventory.icon "RCUTSI" //SOMETHING
States
{
Spawn: //Something.
8K03 [ 1
wait
Ready:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", 25) //Does it matter?
TNT1 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 303,1000,1000) //I don't know how much HP per player??
TNT1 A 0 A_GiveInventory("Biscuits", 1)
TNT1 A 0 A_TakeInventory("CringeFlag")
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_TakeInventory("Ceobe_Thing")
TNT1 A 0 A_GiveInventory("WallJumpLimit", 1)
TNT1 A 0 A_GunFlash
Goto ReadyReal
ReadyReal:
TNT1 A 0 A_JumpIfInventory("Ceobe_Thing",1,"ReadyTomahawkless")
TNT1 A 1 A_WeaponReady
Loop
ReadyTomahawkless:
TNT1 A 1 A_WeaponReady
TNT1 A 0 A_GiveInventory("CringeFlag",1)
TNT1 A 0 A_JumpIfInventory("Ceobe_Thing",1,"ReadyTomahawkless")
Goto ReadyReal
Deselect:
TNT1 A 0
goto DeselectSwap
Select:
TNT1 A 0
goto SelectSwap

Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 A_GiveInventory("Ceobe_Flash_P")
loop

Fire: //What if she taunted everytime she fired her weapon?
TNT1 A 0 A_JumpIfInventory("Ceobe_Thing", 1, "FOLLOW_UP") //I thought it'd be interesting.
TNT1 A 0 A_TakeInventory("CringeFlag")
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_TakeInventory("Ceobe_Thing")
TNT1 A 0 A_PlaySoundEx("weapon/CeobeFire","Voice") //A different slot?
TNT1 A 0 A_PlaySoundEx("weapon/tengudash","Weapon")
TNT1 A 2 A_FireCustomMissile("Ceobe_Tomahawk",0,0,0,0)
Goto RECOVERY
RECOVERY:
TNT1 A 2 A_GiveInventory("Ceobe_Thing", 1)
TNT1 A 10 //8
Goto ReadyReal
FOLLOW_UP:
TNT1 A 0 A_GiveInventory("CringeFlag", 999)
TNT1 A 0 A_PlaySoundEx("wep_L/GhostTrapButton","Weapon")
WAIT_DAYO:
TNT1 A 2 A_GiveInventory("WeaponCharge",1)
TNT1 A 0 A_JumpIfInventory("WeaponCharge",999,"OBTAINTHING") //999 //I dunno how long this should be.
TNT1 A 0 A_JumpIfInventory("Ceobe_Thing",1,"WAIT_DAYO")
Goto OBTAINTHING
OBTAINTHING: //Skim if necessary.
TNT1 A 0 A_TakeInventory("CringeFlag")
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_TakeInventory("Ceobe_Thing")
TNT1 A 12 //8
Goto ReadyReal
//Return:
//BUSH Y 0 A_TakeInventory("CutterFlag")
//BUSH Y 0 A_TakeInventory("RollingCutterFlag",1)
//BUSH YZ 2
//BUSH S 0 A_Refire
//Goto Ready+1
//NoAmmo:
//BUS2 B 1 ACS_Execute(979,0)
//Goto ReadyNoAmmo

/*Altfire:
DADADADADA:
REMB A 0 A_TakeInventory("WeaponCharge", 999)
REMB A 0 A_GiveInventory("CutterFlag", 100)
REMB DA 4
REMB A 0 A_TakeInventory("CutterFlag", 100)
goto Ready+1
NoAmmo:
NoTomahawk:
REMB A 1 A_GiveInventory("Biscuits",1)
REMB A 0 A_JumpIfInventory("WeaponCharge",1,"DADADADADA")
Goto Ready+1*/
}
}


actor Ceobe_Flash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("Ceobe_Contact_Damage",0,0,32,momx,momy,momz,0,8)
stop
}
}

actor Biscuits : Ammo
{
inventory.amount 1
inventory.maxamount 1
+INVENTORY.IGNORESKILL
}

actor Ceobe_Thing : Inventory
{
inventory.amount 1
inventory.maxamount 1
}

actor CringeFlag : Inventory
{
inventory.amount 1
inventory.maxamount 999
}


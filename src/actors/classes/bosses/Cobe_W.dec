actor Ceobe_Tomahawk : BasicProjectile
{
Translation "192:192=229:229","198:198=4:4"
var int user_stuck;
damagetype "CeobeTomahawkHit" //CeobeTomahawkGrabBack
Obituary "Die" //"https://youtu.be/J18xhVKIcz0?t=15"
+SKYEXPLODE
+HITTRACER
//+DONTSPLASH //
+FORCEXYBILLBOARD
ReactionTime 100 //
damage (275) //Used to be 450
Radius 24 //
Height 13 //
speed 80
Yscale 2.5
Xscale 4.5
States
{
Spawn:
X_6F A 0
X_6F A 0 A_PlaySoundEx("weapon/gyroattack","Weapon")
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_PlaySoundEx("weapon/gyroattack","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F A 0 A_JumpIf(CallACS("core_targetexists")==0,"Detonate")
loop
Crash:
XDeath: //
X_6F V 0 A_SetUserVar("user_stuck",1)
Death: //HARKEN TO ME.
X_6F V 0 A_JumpIfInventory("CringeFlag",210,"Detonate") //IF THE THING IS STUCK TO A PLAYER
//X_6F V 0 A_GiveInventory("CringeFlag",1) //MAKE IT SO IT PLAYS THIS SOUND INSTEAD "weapon/CeobeDead"
X_6F V 0 A_ChangeFlag("DONTBLAST",1) //
X_6F V 0 A_Stop
X_6F V 0 A_PlaySound("weapon/rminestick")
X_6F V 0 A_JumpIf(user_stuck,"LatchHarder") //////////////////
Latch:
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)//64
X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F V 0 A_SpawnItemEx("Ceobe_Tomahawk_Damager2",0,0,0,0,0,0,0,1)
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F V 0 A_CountDown
X_6F V 0 A_JumpIf(CallACS("core_targetexists")==0,"Detonate")
X_6F V 0 A_JumpIf(user_stuck==0,"Latch")
X_6F V 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Detonate")
loop
Detonate:
X_6F V 0 A_Warp(8,0,0,28,0,8)
X_6F A 0 A_SpawnItemEx("Ceobe_Pull_Pain",0,0,0,0,0,0,0,1)
X_6F A 1 A_SpawnItemEx("Ceobe_Tomahawk_Return",0,0,0,0,0,0,0,1)
stop
//I bet there's an easier way of handling this.
//I swear there is a better of doing this.
LatchHarder: // The difference is, sound consistency.
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)//64
X_6F V 0 A_PlaySoundEx("weapon/CeobeSuccess","Weapon")
X_6F V 0 A_SpawnItemEx("Ceobe_Tomahawk_Damager",0,0,0,0,0,0,0,1)
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F V 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",210,"Detonate")
X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
//X_6F A 1 A_JumpIfInTargetInventory("CringeFlag",100,"Detonate")
//X_6F Z 0 A_Warp(8,-4,0,28,0,8+16)
//X_6F V 0 A_PlaySoundEx("Shin_1/Ting","Weapon")
//X_6F B 1 A_JumpIfInTargetInventory("CringeFlag",100,"Detonate")
X_6F V 0 A_CountDown
X_6F V 0 A_JumpIf(CallACS("core_targetexists")==0,"Detonate")
X_6F V 0 A_JumpIf(user_stuck==0,"Latch")
X_6F V 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Detonate")
loop
}
}

//
actor Ceobe_Pull_Pain : BasicExplosion
{
damagetype "CeobeTomahawkGrabBack"
Obituary "Die"
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(25,16,0,0,16) //Used to be 50
stop
}
}

actor Ceobe_Tomahawk_Damager : BasicExplosion
{
damagetype "CeobeTomahawkNormal"
Obituary "Die"
mass 16
Accuracy 10
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(Accuracy,mass,0,0,mass)
stop
}
}

actor Ceobe_Tomahawk_Damager2 : Ceobe_Tomahawk_Damager
{
mass 40
Accuracy 25 //50 too much?
}

actor Ceobe_Contact_Damage : BasicExplosion
{
damagetype "CeobeTouch"
Obituary "Die"
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(10,36,0,0,36) //32 radius
stop
}
}

actor Ceobe_Tomahawk_Return : BasicProjectile
{
+NOINTERACTION
+NOCLIP
+SEEKERMISSILE
reactiontime 100 //100 //70
speed 40 //80 //40
Damage (0)
height 10
radius 10
Yscale 2.5
Xscale 4.5
States
{
Spawn:
X_6F A 0
X_6F A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_TARGET)
SpawnLoop:
X_6F AAAA 0 A_SeekerMissile(90, 90, SMF_PRECISE)
X_6F A 0 A_PlaySoundEx("weapon/gyroattack","Weapon")
X_6F A 0 A_SpawnItemEx("Ceobe_Tomahawk_Damager2",0,0,0,0,0,0,0,1)
X_6F A 1 //A_GiveToTarget("CringeFlag", 1)
X_6F A 0 A_Countdown
X_6F A 0 A_JumpIfCloser(64, "Death")
//
X_6F AAAA 0 A_SeekerMissile(90, 90, SMF_PRECISE)
X_6F A 0 A_PlaySoundEx("weapon/gyroattack","Weapon")
//X_6F A 0 A_SpawnItemEx("Ceobe_Tomahawk_Damager2",0,0,0,0,0,0,0,1) //Too much?
X_6F B 1 //A_GiveToTarget("CringeFlag", 1)
X_6F A 0 A_Countdown
X_6F A 0 A_JumpIfCloser(64, "Death")
loop
Death:
X_6F A 0 A_GiveToTarget("WeaponCharge", 999)
X_6F A 0 A_TakeFromTarget("CringeFlag", 999)
X_6F A 0 A_TakeFromTarget("Ceobe_Thing", 999)
stop
}
}


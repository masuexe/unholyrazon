actor Ceobe_SmackYou_Disorient : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Jump(128,"TheOtherway")
TNT1 A 0 A_SetAngle(angle-10.0)
stop
TheOtherWay:
TNT1 A 0 A_SetAngle(angle+10.0)
stop
}
}

actor CeobeFun : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEX("weapon/CeobeWin","SoundSlot6")
stop
}
}

actor PainCeobeContact : Basic_PainFling_H {Args 0, 10, 2}

actor PainCeobeTomahawkHit : Basic_PainFling_H {Args 0, 20, 2}

actor PainCeobeTomahawkPull : Basic_PainFling_H {Args 0, -45, 2}

actor JoeOfDuty : BossBase {
  Player.ScoreIcon "UB058MUG"
  Player.SoundClass "Joe"
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 12
  Player.MaxHealth 2000
  Health 2000
  Player.MorphWeapon "JoeOfDuty_W"
  States {
   Spawn:
    SJ01 A 0
    SJ01 B 1 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")
    SJ01 A 1 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")
    goto Spawn+2
   See:
    SJ01 BCDE 3 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")  // 3 ~ 5
    goto Spawn
   Missile:
    SJ01 FFFFF 1 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")
    SJ01 GGGG 1 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")
    goto Spawn+2
   MissileExtended:
    SJ01 F 5
    SJ01 F 0 A_JumpIfInventory("Joe_Animation_Flag", 1, "MissileExtended")
    goto Spawn+2
   ClassPain:
    SJ01 H 0
    goto MegamanPain
   ClassDeath:
    SJ01 H 0
    goto MegamanDeath
   MegamanDeath0:
    TNT1 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TNT1 A 1 A_SpawnItemEx("JoeOfDutyRealCorpse", 0, 0, 0, 0, 0, 4, 0, 9)
    goto MegamanErase
  }
}

// Don't make this kill. It will not account for who killed who.
// But, I wish it did !
actor JoeOfDutyRealCorpse : BasicExplosion {
  DamageType "CoDGrenade"
  Obituary "\cgMARTYRDOM!\cqJoe \c-(%k)'s last ditch effort killed %o in the coldest of blood."  //
  Speed 40
  Scale 2.5
  // 250,400
  Args 21, 27, 96, 32
  States {
   Spawn:
    SJ01 H 0
    SJ01 H 0 A_PlaySoundEx("UH_Boss/JoeDeath", "SoundSlot7")
   Im_Dying_Boys:
    SJ01 H 0 A_FadeOut(0.075)
    SJ01 HH 0 A_SpawnItemEx("SluggerRocketShotFX", random(-40, 40), random(-40, 40), random(8, 48), 0, 0, 0, 0, 1)
    SJ01 H 1 A_Explode(random(args[0], args[1]), args[2], 0, 0, args[3])
    SJ01 HH 0 A_SpawnItemEx("SluggerRocketShotFX", random(-40, 40), random(-40, 40), random(8, 48), 0, 0, 0, 0, 1)
    SJ01 H 1 A_Explode(random(args[0], args[1]), args[2], 0, 0, args[3])
    loop
  }
}

actor GravitymanKamilia_W_ScriptBar : ScriptBar {}
actor GravitymanKamilia_W : BaseUnholyBossWep {
  Obituary "\cgGravityman\c- (%k) wanted %o to be the popularity."
  Weapon.AmmoUse 0
  Weapon.AmmoGive 280
  weapon.ammotype "SurpriseGravityAmmo"

  States {
   Spawn:
    C_05 A 1
    loop

   Deselect:
    8I19 A 0
    goto DeselectSwap
   Select:
    8I19 A 0
    goto SelectSwap

   Ready:
    8I19 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, GRAVITYMANKAMILIA_DYE)
    8I19 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, true, ELP_NATIVE)
    8I19 A 0 A_TakeInventory("IsPissedFlag")
    8I19 A 0 A_GiveInventory("Gravityman_WepStartCheck_P")
    8I19 A 0 ACS_NamedExecuteAlways("uh_GravitymanKamiliaELPoll")
    8I19 A 0 A_GunFlash("Flash", true)
    goto Ready1

   Ready1:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    8I19 A 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "Ready2")
    // While global reverse is active, allow Reload to cancel even below full ammo.
    8I19 A 0 A_JumpIfInventory("ReverseGravityFlag", 1, 2)
    8I19 A 1 A_WeaponReady
    goto Ready1Regen
    8I19 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
   Ready1Regen:
    8I19 A 0 A_JumpIfInventory("ReverseGravityFlag", 1, "Ready1")
    8I19 A 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    8I19 A 0 A_GiveInventory("ScrewGravityAmmoGive_P")
    goto Ready1
   Ready2:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp2")
    8I19 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    8I19 A 0 A_JumpIfInventory("ReverseGravityFlag", 1, "Ready2")
    8I19 A 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    8I19 A 0 A_GiveInventory("ScrewGravityAmmoGive_P")
    goto Ready2

   ReadyUp1:
    8I19 D 0 A_JumpIfInventory("GroundFlag", 1, "Ready1")
    8I19 D 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "ReadyUp2")
    8I19 D 0 A_JumpIfInventory("ReverseGravityFlag", 1, 2)
    8I19 D 1 A_WeaponReady
    goto ReadyUp1Regen
    8I19 D 1 A_WeaponReady(WRF_ALLOWRELOAD)
   ReadyUp1Regen:
    8I19 D 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReadyUp1")
    8I19 D 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    goto ReadyUp1
   ReadyUp2:
    8I19 D 0 A_JumpIfInventory("GroundFlag", 1, "Ready2")
    8I19 D 1 A_WeaponReady(WRF_ALLOWRELOAD)
    8I19 D 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReadyUp2")
    8I19 D 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    goto ReadyUp2

   Fire:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "Fire2")
    goto Fire1
   Fire1:
    8I19 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 A 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 BCBA 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 A 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 BCBA 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 A 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 BCBAA 3 A_GiveInventory("ScrewGravityAmmoFire_P")
    goto Ready1
   Fire2:
    8I19 D 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 D 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 EFED 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 D 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 D 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 EFED 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 D 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 D 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 EFEDD 3 A_GiveInventory("ScrewGravityAmmoFire_P")
    goto ReadyUp1

   AltFire:
    8I19 A 0 A_JumpIfInventory("GravityCooldownFlag", 1, "AltFireCooldown")
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "AltFireUp")
    goto AltFireDown
   AltFireCooldown:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    goto Ready1
   AltFireDown:
    8I19 A 0 A_GiveInventory("GravitySwitch")
    8I19 A 0 A_GiveInventory("GravityCooldownFlag", 54)
    8I19 A 0 A_SpawnItemEx("GravitySwitchCooldown_H")
    8I19 A 0 A_GunFlash("Flash", true)
    8I19 G 1
    8I19 G 1 Offset(-20, 6)
    8I19 G 1 Offset(-47, -21)
    8I19 H 2 Offset(-47, -21)
    8I19 H 3 Offset(-47, -21)
    8I19 G 3 Offset(-47, -21)
    8I19 G 3 Offset(-20, 6)
    8I19 G 3 A_WeaponReady(14)
    goto Ready1
   AltFireUp:
    // Do not A_GunFlash("Flash") here — that restarts idle Flash, which
    // would treat GravitySwitch as SwitchUp again instead of SwitchDown.
    8I19 D 0 A_GiveInventory("GravitySwitch")
    8I19 D 0 A_GiveInventory("GravityCooldownFlag", 54)
    8I19 D 0 A_SpawnItemEx("GravitySwitchCooldown_H")
    8I19 I 1
    8I19 I 1 Offset(20, 58)
    8I19 I 1 Offset(47, 85)
    8I19 J 2 Offset(47, 85)
    8I19 J 3 Offset(47, 85)
    8I19 I 3 Offset(47, 85)
    8I19 I 3 Offset(20, 58)
    8I19 I 3 A_WeaponReady(14)
    goto ReadyUp1

   Reload:
    // Active reverse: Reload cancels early (no full-ammo gate).
    // Inactive: still requires SurpriseGravityAmmo == 280 (Ready2 / ReadyUp2 only).
    8I19 A 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReloadCancel")
    8I19 A 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "ReloadGo")
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    goto Ready1
   ReloadGo:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "Reload2")
    goto Reload1
   ReloadCancel:
    8I19 A 0 A_JumpIfInventory("CeilingFlag", 1, "ReloadCancel2")
    goto ReloadCancel1
   Reload1:
    8I19 A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 G 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 G 0 A_GiveInventory("ReverseGravitySwitch_P")
    8I19 G 0 A_SpawnItemEx("ReverseGravityCountdown_H")
    8I19 G 1 ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIAFLIP_DYE, TINT_TCLR1)
    8I19 G 1 Offset(-20, 6)
    8I19 G 1 Offset(-47, -21)
    8I19 H 2 Offset(-47, -21)
    8I19 H 3 Offset(-47, -21) ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIA_DYE, TCLR_NONE)
    8I19 G 3 Offset(-47, -21)
    8I19 G 3 Offset(-20, 6)
    8I19 G 3 A_WeaponReady(14)
    goto Ready1
   Reload2:
    8I19 A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 I 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 I 0 A_GiveInventory("ReverseGravitySwitch_P")
    8I19 I 0 A_SpawnItemEx("ReverseGravityCountdown_H")
    8I19 I 1 ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIAFLIP_DYE, TINT_TCLR1)
    8I19 I 1 Offset(20, 58)
    8I19 I 1 Offset(47, 85)
    8I19 J 2 Offset(47, 85)
    8I19 J 3 Offset(47, 85) ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIA_DYE, TCLR_NONE)
    8I19 I 3 Offset(47, 85)
    8I19 I 3 Offset(20, 58)
    8I19 I 3 A_WeaponReady(14)
    goto ReadyUp1
   ReloadCancel1:
    8I19 A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 G 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 G 0 A_TakeInventory("ReverseGravityFlag")
    8I19 G 1 ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIAFLIP_DYE, TINT_TCLR1)
    8I19 G 1 Offset(-20, 6)
    8I19 G 1 Offset(-47, -21)
    8I19 H 2 Offset(-47, -21)
    8I19 H 3 Offset(-47, -21) ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIA_DYE, TCLR_NONE)
    8I19 G 3 Offset(-47, -21)
    8I19 G 3 Offset(-20, 6)
    8I19 G 3 A_WeaponReady(14)
    goto Ready1
   ReloadCancel2:
    8I19 A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 I 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 I 0 A_TakeInventory("ReverseGravityFlag")
    8I19 I 1 ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIAFLIP_DYE, TINT_TCLR1)
    8I19 I 1 Offset(20, 58)
    8I19 I 1 Offset(47, 85)
    8I19 J 2 Offset(47, 85)
    8I19 J 3 Offset(47, 85) ACS_NamedExecuteWithResult("core_chargecolor", GRAVITYMANKAMILIA_DYE, TCLR_NONE)
    8I19 I 3 Offset(47, 85)
    8I19 I 3 Offset(20, 58)
    8I19 I 3 A_WeaponReady(14)
    goto ReadyUp1

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("GravitySwitch", 1, "Flash.HasSwitch")
    TNT1 A 1
    goto Flash
   Flash.HasSwitch:
    TNT1 A 0 A_JumpIfInventory("CeilingFlag", 1, "Flash.SwitchDown")
    goto Flash.SwitchUp
   Flash.SwitchUp:
    TNT1 A 0 A_GiveInventory("GravityFlashSwitchUp_P")
    TNT1 A 0 A_GunFlash("Flash.Up")
    goto Flash.Up
   Flash.Up:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIfInventory("GravitySwitch", 1, "Flash.SwitchDown")
    TNT1 A 1 A_GiveInventory("ReverseGravityThrust")
    goto Flash.Up
   Flash.SwitchDown:
    TNT1 A 0 A_GiveInventory("GravityFlashSwitchDown_P")
    TNT1 A 0 A_GiveInventory("ScrewGravityAmmoResync_P")
    TNT1 A 0 A_GunFlash("Flash.Land")
    goto Flash.Land

   Flash.Land:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_JumpIf(z-floorz==0, "Flash.LandEnd")
    TNT1 A 0 A_JumpIf(momz==0, "Flash.LandZ")
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("GravitySwitch", 1, "Flash.SwitchUp")
    goto Flash.Land
   Flash.LandZ:
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("GravitySwitch", 1, "Flash.SwitchUp")
    TNT1 A 0 A_JumpIf(z-floorz==0, "Flash.LandEnd")
    TNT1 A 0 A_JumpIf(momz==0, "Flash.LandEnd")
    goto Flash.Land+3

   Flash.LandEnd:
    TNT1 A 0 A_TakeInventory("GravitySwitchX")
    TNT1 A 0 A_JumpIfInventory("GravitySwitch", 1, "Flash.SwitchUp")
    TNT1 A 0 A_TakeInventory("GravitySwitch")
    goto Flash

   NoFlash:
    TNT1 A 0 A_GiveInventory("GravitymanFullReset_P")
    TNT1 A 1
    stop
  }
}

// HP < 2 → swap here; Ready runs IWannaBeThePopularity once, then Eden frames K–T.
actor GravitymanKamilia_W_Pissed_ScriptBar : ScriptBar {}
actor GravitymanKamilia_W_Pissed : GravitymanKamilia_W {
  Obituary "\ckEdenman\c- (%k) wanted %o to be the popularity."
  States {
   Deselect:
    8I19 K 0
    goto DeselectSwap
   Select:
    8I19 K 0
    goto SelectSwap

   Ready:
    8I19 K 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, EDENMAN_DYE)
    8I19 K 0 A_GiveInventory("Gravityman_WepStartCheck_P")
    8I19 K 0 A_JumpIfInventory("GravitymanKamiliaGetUpDone_F", 1, "ReadyAfterGetUp")
    8I19 K 0 A_JumpIfInventory("IsPissedFlag", 1, "ReadyAfterGetUp")
    goto IWannaBeThePopularity
   ReadyAfterGetUp:
    8I19 K 0 A_GunFlash("Flash", true)
    goto Ready1

   Ready1:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    8I19 K 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "Ready2")
    8I19 K 0 A_JumpIfInventory("ReverseGravityFlag", 1, 2)
    8I19 K 1 A_WeaponReady
    goto Ready1Regen
    8I19 K 1 A_WeaponReady(WRF_ALLOWRELOAD)
   Ready1Regen:
    8I19 K 0 A_JumpIfInventory("ReverseGravityFlag", 1, "Ready1")
    8I19 K 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    8I19 K 0 A_GiveInventory("ScrewGravityAmmoGive_P")
    goto Ready1
   Ready2:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp2")
    8I19 K 1 A_WeaponReady(WRF_ALLOWRELOAD)
    8I19 K 0 A_JumpIfInventory("ReverseGravityFlag", 1, "Ready2")
    8I19 K 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    8I19 K 0 A_GiveInventory("ScrewGravityAmmoGive_P")
    goto Ready2

   ReadyUp1:
    8I19 N 0 A_JumpIfInventory("GroundFlag", 1, "Ready1")
    8I19 N 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "ReadyUp2")
    8I19 N 0 A_JumpIfInventory("ReverseGravityFlag", 1, 2)
    8I19 N 1 A_WeaponReady
    goto ReadyUp1Regen
    8I19 N 1 A_WeaponReady(WRF_ALLOWRELOAD)
   ReadyUp1Regen:
    8I19 N 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReadyUp1")
    8I19 N 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    goto ReadyUp1
   ReadyUp2:
    8I19 N 0 A_JumpIfInventory("GroundFlag", 1, "Ready2")
    8I19 N 1 A_WeaponReady(WRF_ALLOWRELOAD)
    8I19 N 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReadyUp2")
    8I19 N 0 A_GiveInventory("SurpriseGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    goto ReadyUp2

   Fire:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "Fire2")
    goto Fire1
   Fire1:
    8I19 K 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 K 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 LMLK 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 K 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 K 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 LMLK 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 K 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 K 0 A_FireCustomMissile("GravityKamiliaShot", 0, 0, -8, 0)
    8I19 LMLKK 2 A_GiveInventory("ScrewGravityAmmoFire_P")
    goto Ready1
   Fire2:
    8I19 N 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 N 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 OPON 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 N 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 N 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 OPON 1 A_GiveInventory("ScrewGravityAmmoFire_P")
    8I19 N 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8I19 N 0 A_FireCustomMissile("GravityKamiliaShotUp", 0, 0, 8, 0)
    8I19 OPONN 2 A_GiveInventory("ScrewGravityAmmoFire_P")
    goto ReadyUp1

   AltFire:
    8I19 K 0 A_JumpIfInventory("GravityCooldownFlag", 1, "AltFireCooldown")
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "AltFireUp")
    goto AltFireDown
   AltFireCooldown:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    goto Ready1
   AltFireDown:
    8I19 K 0 A_GiveInventory("GravitySwitch")
    8I19 K 0 A_GiveInventory("GravityCooldownFlag", 54)
    8I19 K 0 A_SpawnItemEx("GravitySwitchCooldown_H")
    8I19 K 0 A_GunFlash("Flash", true)
    8I19 Q 1
    8I19 Q 1 Offset(-20, 6)
    8I19 Q 1 Offset(-47, -21)
    8I19 R 2 Offset(-47, -21)
    8I19 R 3 Offset(-47, -21)
    8I19 Q 3 Offset(-47, -21)
    8I19 Q 3 Offset(-20, 6)
    8I19 Q 3 A_WeaponReady(14)
    goto Ready1
   AltFireUp:
    8I19 N 0 A_GiveInventory("GravitySwitch")
    8I19 N 0 A_GiveInventory("GravityCooldownFlag", 54)
    8I19 N 0 A_SpawnItemEx("GravitySwitchCooldown_H")
    8I19 S 1
    8I19 S 1 Offset(20, 58)
    8I19 S 1 Offset(47, 85)
    8I19 T 2 Offset(47, 85)
    8I19 T 3 Offset(47, 85)
    8I19 S 3 Offset(47, 85)
    8I19 S 3 Offset(20, 58)
    8I19 S 3 A_WeaponReady(14)
    goto ReadyUp1

   Reload:
    8I19 K 0 A_JumpIfInventory("ReverseGravityFlag", 1, "ReloadCancel")
    8I19 K 0 A_JumpIfInventory("SurpriseGravityAmmo", 280, "ReloadGo")
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "ReadyUp1")
    goto Ready1
   ReloadGo:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "Reload2")
    goto Reload1
   ReloadCancel:
    8I19 K 0 A_JumpIfInventory("CeilingFlag", 1, "ReloadCancel2")
    goto ReloadCancel1
   Reload1:
    8I19 K 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 Q 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 Q 0 A_GiveInventory("ReverseGravitySwitch_P")
    8I19 Q 0 A_SpawnItemEx("ReverseGravityCountdown_H")
    8I19 Q 1 ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE2, TINT_TCLR1)
    8I19 Q 1 Offset(-20, 6)
    8I19 Q 1 Offset(-47, -21)
    8I19 R 2 Offset(-47, -21)
    8I19 R 3 Offset(-47, -21) ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE, TCLR_NONE)
    8I19 Q 3 Offset(-47, -21)
    8I19 Q 3 Offset(-20, 6)
    8I19 Q 3 A_WeaponReady(14)
    goto Ready1
   Reload2:
    8I19 K 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 S 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 S 0 A_GiveInventory("ReverseGravitySwitch_P")
    8I19 S 0 A_SpawnItemEx("ReverseGravityCountdown_H")
    8I19 S 1 ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE2, TINT_TCLR1)
    8I19 S 1 Offset(20, 58)
    8I19 S 1 Offset(47, 85)
    8I19 T 2 Offset(47, 85)
    8I19 T 3 Offset(47, 85) ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE, TCLR_NONE)
    8I19 S 3 Offset(47, 85)
    8I19 S 3 Offset(20, 58)
    8I19 S 3 A_WeaponReady(14)
    goto ReadyUp1
   ReloadCancel1:
    8I19 K 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 Q 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 Q 0 A_TakeInventory("ReverseGravityFlag")
    8I19 Q 1 ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE2, TINT_TCLR1)
    8I19 Q 1 Offset(-20, 6)
    8I19 Q 1 Offset(-47, -21)
    8I19 R 2 Offset(-47, -21)
    8I19 R 3 Offset(-47, -21) ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE, TCLR_NONE)
    8I19 Q 3 Offset(-47, -21)
    8I19 Q 3 Offset(-20, 6)
    8I19 Q 3 A_WeaponReady(14)
    goto Ready1
   ReloadCancel2:
    8I19 K 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    8I19 S 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, tid)
    8I19 S 0 A_TakeInventory("ReverseGravityFlag")
    8I19 S 1 ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE2, TINT_TCLR1)
    8I19 S 1 Offset(20, 58)
    8I19 S 1 Offset(47, 85)
    8I19 T 2 Offset(47, 85)
    8I19 T 3 Offset(47, 85) ACS_NamedExecuteWithResult("core_chargecolor", EDENMAN_DYE, TCLR_NONE)
    8I19 S 3 Offset(47, 85)
    8I19 S 3 Offset(20, 58)
    8I19 S 3 A_WeaponReady(14)
    goto ReadyUp1

   IWannaBeThePopularity:
    TNT1 A 0 A_GiveInventory("GravitymanKamiliaPainFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, ELP_NATIVE)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    TNT1 A 35
    goto Graviton
   Graviton:
    TNT1 A 0 A_GiveInventory("GravitymanKamiliaHealthGiver_P")
    TNT1 A 0 A_PlaySound("item/energyup")
    TNT1 A 1 A_JumpIfInventory("IsPissedFlag", 1, "EdenManComing")
    goto Graviton
   EdenManComing:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 A_GiveInventory("IsPissedFlag")
    TNT1 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_GravitymanKamiliaEdenDye")
    TNT1 A 0 A_GiveInventory("SpawnMyEdenStarShield_P")
    TNT1 A 0 A_GiveInventory("GravitymanKamiliaGetUpDone_F")
    TNT1 A 0 A_TakeInventory("GravitymanKamiliaPainFlag")
    goto ReadyAfterGetUp
  }
}

actor GravitymanKamiliaSwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("GravitymanKamiliaGetUpDone_F")
    TNT1 A 0 A_GiveInventory("GravitymanKamilia_W_Pissed")
    TNT1 A 0 A_TakeInventory("GravitymanKamilia_W")
    stop
  }
}

actor GravitymanKamiliaGetUpDone_F : Once {}
actor GravitymanKamiliaPainFlag : Once {}
actor GravitymanKamiliaELPoll_F : Once {}

actor GravitymanKamiliaHealthGiver_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag"), "GiveHealth")
    goto PickupFull
   GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 25)
    stop
   PickupFull:
    TNT1 A 0 A_GiveInventory("IsPissedFlag")
    stop
  }
}

actor ScrewGravityAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 280
  +INVENTORY.IGNORESKILL
}

actor SurpriseGravityAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 280
  +INVENTORY.IGNORESKILL
}

actor Gravityman_WepStartCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("GravityKamiliaAutoWatcher_F", 1, "AmmoInit")
    TNT1 A 0 A_GiveInventory("GravityKamiliaAutoWatcher_F")
    TNT1 A 0 A_SpawnItemEx("GravityKamiliaAutoAttack_H")
   AmmoInit:
    TNT1 A 0 A_JumpIfInventory("CeilingFlag", 1, "AmmoReady")
    TNT1 A 0 A_GiveInventory("GroundFlag")
   AmmoReady:
    TNT1 A 0 A_JumpIfInventory("ScrewGravityAmmo", 1, "Done")
    TNT1 A 0 A_GiveInventory("ScrewGravityAmmo", 280)
   Done:
    TNT1 A 0
    stop
  }
}

actor ScrewGravityAmmoGive_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CeilingFlag", 1, "No")
    TNT1 A 0 A_JumpIfInventory("GravitySwitchX", 1, "No")
    TNT1 A 0 A_GiveInventory("ScrewGravityAmmo", 1+CallACS("uh_checkrune", RUNE_RAGE))
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor ScrewGravityAmmoFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CeilingFlag", 1, "No")
    TNT1 A 0 A_JumpIfInventory("GravitySwitchX", 1, "No")
    TNT1 A 0 A_GiveInventory("ScrewGravityAmmo", 1)
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor ScrewGravityAmmoResync_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("ScrewGravityAmmo", 5)
    TNT1 A 0 A_TakeInventory("ScrewGravityAmmo", 18, 1)
    TNT1 A 0 A_TakeInventory("ScrewGravityAmmo", 7)
    stop
  }
}

actor ASPThunderShock : BasicProjectile
{
Translation "192:192=93:93","198:198=229:229","202:202=229:229","199:199=93:93"
damagetype "ASPStun"
Obituary "%o had a shocker by \cfYellow Speciman\c- (%k)'s \ckASP Shock\c-."
Damage (40)
Radius 25
Height 16
Speed 25
scale 3.0
States
{
Spawn:
X_7D B 1
Y_7D B 1
X_7D D 1
Y_7D D 1
SpawnLoop:
X_7D N 0 A_GiveToTarget("UH_TargetMarker")
X_7D N 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_7D N 0 A_ChangeVelocity(cos(-pitch)*25,0,sin(-pitch)*25,3)
X_7D N 0 A_SpawnItemEx("ASPThunderShockFX1",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,9)
X_7D N 1 A_SpawnItemEx("ASPThunderShock2",0,0,0,0,0,0,0,1)
Y_7D N 0 A_GiveToTarget("UH_TargetMarker")
Y_7D N 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
Y_7D N 0 A_ChangeVelocity(cos(-pitch)*25,0,sin(-pitch)*25,3)
Y_7D N 0 A_SpawnItemEx("ASPThunderShockFX2",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,9)
Y_7D N 1 A_SpawnItemEx("ASPThunderShock1",0,0,0,0,0,0,0,1)
loop
Death:
TNT1 A 0 A_PlaySoundEx("misc_L/wilybeam","Weapon")
TNT1 A 0 A_Explode(100,128,0,0,16)
TNT1 A 0 A_Jump(128,"Death2")
X_8B A 1
Y_8B B 1
X_8B C 1
Y_8B D 1
X_8B E 1
Y_8B F 1
stop
Death2:
Y_8B A 1
X_8B B 1
Y_8B C 1
X_8B D 1
Y_8B E 1
X_8B F 1
stop
}
}


actor YellowSpeciman_W_NormalBar : NormalBar {args 93, 229}
actor YellowSpeciman_W_SecondBar : SecondBar {args 4, 94}
actor YellowSpeciman_W_ReloadIcon : ReloadIcon {Tag "R042B0"}
actor YellowSpeciman_W : Speciman_W
{
Tag "$TAG_Boss045_W"
Obituary "\cfYellow Speciman\c- (%k) assumed that %o was becoming an hero."
Inventory.Pickupmessage "Hark Hark"
weapon.ammotype "UnholyBossAmmo250"
weapon.ammotype2 "UnholyBossAmmo200"
States
{
Spawn:
8H45 [ 1
wait

Deselect:
8H45 A 0
goto DeselectSwap
Select:
8H45 A 0
goto SelectSwap

Ready:
8H45 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, YELLOWSPECIMAN_DYE)
8H45 A 0 A_GiveInventory("IsSpecimanFlag")
goto ReadyX
ReadyX:
8H45 A 0 A_JumpIfInventory("UnholyBossAmmo250",125,"ReadyX2")
8H45 A 2 A_GiveInventory("Speciman_Ready8_P")
8H45 A 0 A_GiveInventory("UnholyBossAmmo200",2)
8H45 A 0 A_GiveInventory("UnholyBossAmmo250",2)
loop
ReadyX2:
8H45 A 2 A_GiveInventory("Speciman_Ready0_P")
8H45 A 0 A_GiveInventory("UnholyBossAmmo200",2)
8H45 A 0 A_GiveInventory("UnholyBossAmmo250",2)
loop

Fire:
8H45 D 0 A_PlaySoundEx("E_B/Thunder1","Weapon")
8H45 D 2 Offset(-6,25)A_FireCustomMissile("ASPThunderHoming",0,0,0,8)
8H45 DDDDD 2 Offset(-12,18)
8H45 D 2 Offset(-8,23)
8H45 B 2 Offset(-4,28)
8H45 B 2 Offset(-2,30)
8H45 B 0 A_WeaponReady(14)
8H45 BBBBBBBB 3 A_GiveInventory("UnholyBossAmmo250",1)
Goto ReadyX
Altfire:
8H45 A 0 A_JumpIfInventory("UnholyBossAmmo250",125,"StopperPower")
Goto ReadyX
StopperPower:
8H45 A 0 A_TakeInventory("UnholyBossAmmo250",125)
8H45 A 0 A_PlaySoundEx("wep/AlienBeam","Weapon")
8H45 A 0 A_FireCustomMissile("ASPThunderShock",0,0,0,8)
8H45 C 2 Offset(5,28)
8H45 E 2 Offset(12,25)
8H45 E 2 Offset(18,19)
8H45 DDDD 2 Offset(23,16)
8H45 E 2 Offset(18,19)
8H45 E 2 Offset(12,25)
8H45 B 2 Offset(5,28)
Goto ReadyX

ASPFlash:
8H45 B 1 A_GiveInventory("YellowSpecimanASPFlash_P")
goto ReadyX
}
}

actor ASPThunderHoming : BasicProjectile
{
Translation "192:192=93:93", "198:198=229:229"
damagetype "ASPElecMagic"
Obituary "%o ranked up as \cdSergeant of the Master Sergeants Most Important Person of Extreme Sergeants to the Max!"
+DONTSEEKINVISIBLE
+SEEKERMISSILE
+SCREENSEEKER
damage (10)
Radius 8
Height 8
speed 40
ReactionTime 125
scale 2.5
States
{
Spawn:
TNT1 A 0 A_SpawnItemEx("ASPThunderHomingFX",0,0,0,Random(-2,2),Random(-2,2),Random(-2,2),0,1)
TNT1 A 1 A_SeekerMissile(3,35,3,256,6)
TNT1 A 0 A_CountDown
loop
Crash:
TNT1 A 0 A_GiveInventory("Once",1)
TNT1 A 0 A_PlaySoundEx("E_B/Thunder3","Weapon")//weapon/lightningbolt
goto Death+1
Death:
TNT1 A 0 A_PlaySoundEx("E_B/Thunder2","Weapon")//weapon/lightningbolt
TNT1 A 2 A_SpawnItemEx("ASPThunderHomingHitFX1",0,0,0,0,0,0,0,1)
TNT1 A 6 A_SpawnItemEx("ASPThunderHomingHitFX2",0,0,0,0,0,0,0,1)
TNT1 A 0 //A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
TNT1 A 2 A_SpawnItemEx("ASPThunderHomingHitFX1",0,0,0,0,0,0,0,1)
TNT1 A 6 A_SpawnItemEx("ASPThunderHomingHitFX2",0,0,0,0,0,0,0,1)
TNT1 A 0 //A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
TNT1 A 2 A_SpawnItemEx("ASPThunderHomingHitFX1",0,0,0,0,0,0,0,1)
TNT1 A 6 A_SpawnItemEx("ASPThunderHomingHitFX2",0,0,0,0,0,0,0,1)
TNT1 A 0 A_JumpIfInventory("Once",1,"DeathH")
stop
DeathH:
TNT1 A 1 A_SpawnItemEx("ASPThunderStart",0,0,0,0,0,0,0,1)
stop
}
}


actor JesterGelato : BossBase {
  Player.ScoreIcon "UB510MUG"
  Player.SoundClass "JesterGelato"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 10
  Player.MaxHealth 1250
  Health 1250

  Player.MorphWeapon "JesterGelato_W"
  States {
   Spawn:
    9A10 A 0
    9A10 B 1
    9A10 A 1
    goto Spawn+2
   See:
    9A10 BCDE 5
    goto Spawn
   Melee:
    9P10 AAABBBCCCDDD 1 A_JumpIfInventory("VivifyDelay8", 1, "Missile")
    loop
   Missile:
    9A10 F 5
    9A10 G 4
    goto Spawn+2
   ClassPain:
    9A10 H 0
    goto MegamanPain
   ClassDeath:
    9A10 H 0
    goto MegamanDeath
  }
}

actor GivePharaoh4MICurse_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_ApplyPharaoh4MICurse")
    stop
  }
}
actor RemovePharaoh4MICurse_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Reverse")
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Hopping")
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Fidget")
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Darkness")
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Unknown")
    TNT1 A 0 A_TakeInventory("Pharaoh4MICurse_Roulette")
    TNT1 A 0 A_TakeInventory("UH_DisableJumpPower")
    TNT1 A 0 A_TakeInventory("Pharaoh4MIHopJumpCache")
    stop
  }
}

actor Pharaoh4MICurse_Reverse : PowerSpeed {
  +INVENTORY.ALWAYSPICKUP
  +POWERSPEED.NOTRAIL
  powerup.duration -20
  Speed -1.0
}
actor Pharaoh4MICurse_Hopping : Powerup {
  +INVENTORY.ALWAYSPICKUP
  powerup.duration -20
}
actor Pharaoh4MICurse_Fidget : Pharaoh4MICurse_Hopping {}
actor Pharaoh4MICurse_Darkness : Powerup {
  +INVENTORY.ALWAYSPICKUP
  powerup.color 0 0 0 0.85
  powerup.duration 0x7ffffffd  // to avoid blinding
}
actor Pharaoh4MICurse_Unknown : Pharaoh4MICurse_Hopping {}
actor Pharaoh4MICurse_Roulette : Pharaoh4MICurse_Hopping {}  // Only for classes with multiweapons

actor Pharaoh4MICurse_Reverse_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Reverse")
    stop
  }
}
actor Pharaoh4MICurse_Darkness_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Darkness")
    stop
  }
}
actor Pharaoh4MICurse_Unknown_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Unknown")
    stop
  }
}

actor Pharaoh4MIHopJumpCache : Inventory {
  Inventory.MaxAmount 0x7ffffffd
}

actor Pharaoh4MICurse_Hopping_P : CustomInventory {
  States {
   Pickup:
    // Cache JumpZ before DisableJump (watcher Spawn runs after Pickup).
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_HopCacheJumpZ")
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Hopping")
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MICurse_HoppingWatcher")
    TNT1 A 0 A_GiveInventory("UH_DisableJumpPowerGiver")
    stop
  }
}
actor Pharaoh4MICurse_HoppingWatcher : BasicWatcher {
  var int user_timer;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("Pharaoh4MICurse_Hopping", 1, 1)
    goto Death
    TNT1 A 1 A_JumpIf(user_timer >= 15, "Hop")
    TNT1 A 0 A_JumpIf(!CallACS("rz_CheckPointerFooting", 2, 0), "Spawn")
    TNT1 A 0 A_SetUserVar("user_timer", user_timer + 1)
    goto Spawn
   Hop:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_HopDoThrust")
    TNT1 A 0 A_SetUserVar("user_timer", 0)
    goto Spawn
   Death:
    TNT1 A 0 A_TakeFromTarget("UH_DisableJumpPower")
    TNT1 A 0 A_TakeFromTarget("Pharaoh4MIHopJumpCache")
    stop
  }
}

actor Pharaoh4MICurse_Fidget_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Fidget")
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MICurse_FidgetWatcher")
    stop
  }
}
actor Pharaoh4MICurse_FidgetWatcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("Pharaoh4MICurse_Fidget", 1, 1)
    goto Death
    TNT1 A 1 A_GiveToTarget("Pharaoh4MICurse_FidgetMover_P")
    loop
  }
}
actor Pharaoh4MICurse_FidgetMover_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SetArg(0, CallACS("core_getactorproperty", 0, APROP_Speed) / 4096)
    TNT1 A 0 A_JumpIf(velx*velx + vely*vely > args[0]*args[0], "No")
    TNT1 A 0 A_ChangeVelocity(args[0]*cos(angle), args[0]*sin(angle), velz, CVF_REPLACE)
   No:
    TNT1 A 0
    stop
  }
}

actor Pharaoh4MICurse_Roulette_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Pharaoh4MICurse_Roulette")
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MICurse_RouletteWatcher")
    stop
  }
}
actor Pharaoh4MICurse_RouletteWatcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("Pharaoh4MICurse_Roulette", 1, 1)
    goto Death
    TNT1 AAAAAA 1 A_GiveToTarget("Pharaoh4MICurse_RouletteSwitch_P")
    TNT1 A 35
    loop
  }
}
actor Pharaoh4MICurse_RouletteSwitch_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_RoulettePickOtherWeapon")
    stop
  }
}

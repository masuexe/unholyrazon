actor Pharaohman4MI_W_NormalBar : NormalBar {args 4, 218}
// actor Pharaohman4MI_W_ScriptBar : ScriptBar {}
actor Pharaohman4MI_W : BaseUnholyBossWep {
  Tag "$TAG_Boss027_W"
  Obituary "%o was sacrificed by \ckPharaoh Man\c- (%k)'s \ckPharaoh Shot."
  Inventory.Pickupmessage "\cmPower."
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo250"
  States {
   Spawn:
    8H27 [ 1
    wait

   Deselect:
    8H27 F 0
    goto DeselectSwap
   Select:
    8H27 F 0
    goto SelectSwap

   Ready:
    8H27 F 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, PHARAOHMAN4MI_DYE)
    8H27 F 0 A_TakeInventory("IsPissedFlag")
    8H27 F 0 A_GunFlash("Flash.HealthCheck", true)
    goto ReadyX
   ReadyX:
    8H27 F 2 A_GiveInventory("Pharaoh4MI_Ready_P")
    loop
   ReadyX_Pissing:
    8H27 A 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, "GoHealing")
    8H27 A 2 A_GiveInventory("Pharaoh4MI_Ready_P")
    loop
   ReadyX_Healing:
    8H27 B 2
    8H27 B 2 Offset(16, 2)
    8H27 C 2 Offset(-27, 45)
   ReadyX_HealingLoop:
    8H27 C 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, 1)
    Goto ReadyX_HealingEnd
    8H27 C 2 Offset(-1, 33) A_WeaponReady(14)
    loop
   ReadyX_HealingEnd:
    8H27 C 2 Offset(-27, 45)
    8H27 B 2 Offset(16, 2)
   ReadyX_Pissed:
    8H27 A 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, "GoHealing")
    8H27 A 2 A_GiveInventory("Pharaoh4MI_Ready_P")
    loop
   GoHealing:
    8H27 A 0 A_JumpIf(true, "ReadyX_Healing")
    Goto ReadyX_Healing

   Fire:
    PHAA A 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, "ReadyX_Healing")
    PHAA A 0 A_JumpIfInventory("Pharaohman4MIPissing_F", 1, "DesperationFire_Pissing")
    PHAA A 0 A_JumpIfInventory("IsPissedFlag", 1, "GoDesperationFire")
    PHAA A 0 A_PlaySoundEx("weapon/pharaoh1", "Weapon")
    PHAA A 0 A_GiveInventory("FirePharaoh4MIShot_P")
    // 28 tics. 8H27 F/B/C TEXTURES origins differ (FlipX U_HA*):
    //   A (-20,-94), B (0,-98), C (-4,-102). Compensate C→B by ~(+4,+4);
    //   B→A jump is absorbed by A_WeaponReady reset.
    8H27 H 2 Offset(-10, 38) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 H 2 Offset(-20, 46) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 H 2 Offset(-18, 46) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 G 2 Offset(-14, 50) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 G 2 Offset(-10, 42) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 G 2 Offset(-6, 36) A_GiveInventory("UnholyBossAmmo200", 3)
    8H27 F 0 A_WeaponReady(14)
    8H27 FFFFFFFF 2 A_GiveInventory("UnholyBossAmmo200", 3)
    Goto ReadyX

   GetHypedForPain:
    PHAA B 0 A_GiveInventory("Pharaohman4MIPainFlag")
    PHAA B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    PHAA B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    PHAA B 0 A_GiveInventory("Pharaohman4MIStartPiss_P")
    PHAA B 0 A_GunFlash("Flash_Pissing")
    PHAA B 2
    PHAA B 2 Offset(16, 2)
    PHAA C 2 Offset(-27, 45)
    PHAA C 2 Offset(-1, 33)
    8H27 C 0 A_SpawnItemEx("Pharaoh4MIRage_H")
    8H27 C 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")
    8H27 C 0 ACS_NamedExecuteWithResult("core_chargecolor", PHARAOHMAN4MI_PISSED_DYE)
    8H27 C 0 A_GiveInventory("CosmeticBossSpeedTrail")
    8H27 C 2 Offset(-1, 33)
    8H27 C 2 Offset(-27, 45)
    8H27 B 2 Offset(16, 2)
    8H27 B 2 A_WeaponReady(14)
    8H27 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H27 B 0 A_TakeInventory("Pharaohman4MIPainFlag")
    goto ReadyX_Pissing

   Flash.HealthCheck:
    TNT1 A 1 A_GiveInventory("Pharaohman4MIHealthCheck_P")
    loop

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", CLR_STARCRASH)
    TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", DESPERATECOLOR)
    loop

    // Rage window: timer only. Heal is Flash_Healing after timer ends.
   Flash_Pissing:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 1 A_TakeInventory("IsPissingTimer")
    TNT1 A 0 A_JumpIfInventory("IsPissingTimer", 1, "Flash_Pissing")
    TNT1 A 0 A_GiveInventory("Pharaohman4MIStartHeal_P")
    Goto Flash_Healing

   Flash_Healing:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 1 A_SpawnItemEx("Pharaohman4MI_RegainEffect", 0, 0, 28, 20, 0, random(-20, 20), random(0, 359), 1)
    TNT1 A 0 A_PlaySoundEx("item/energyup", "Item")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 20)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag")*0.75+1, "Flash_Healing")
    TNT1 A 0 A_TakeInventory("Pharaohman4MIHealingFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    TNT1 A 0 A_GiveInventory("Pharaohman4MIRageEnd_P")
    stop

   DesperationFire_Pissing:
    8H27 B 2
    8H27 B 2 Offset(16, 2)
    8H27 C 2 Offset(-27, 45)
    8H27 C 2 Offset(-1, 33)
    8H27 C 0 A_Jump(256, "DespPissAttack1", "DespPissAttack2")
   DespPissAttack1:
    TNT1 A 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", 0, 0, 8, 0)
    8H27 D 1 Offset(-1, 32)
    8H27 D 1 Offset(-70, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 D 1 Offset(-121, 112)
    8H27 E 1 Offset(1, 32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 E 1 Offset(-21, 56)
    8H27 E 1 Offset(-33, 84) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", 0, 0, 8, 0)
    8H27 D 1 Offset(-1, 32)
    8H27 D 1 Offset(-70, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 D 1 Offset(-121, 112)
    8H27 E 1 Offset(1, 32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 E 1 Offset(-21, 56)
    8H27 E 1 Offset(-33, 84) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", 0, 0, 8, 0)
    8H27 D 1 Offset(-1, 32)
    8H27 D 1 Offset(-70, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 D 1 Offset(-121, 112)
    8H27 E 1 Offset(1, 32) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H27 E 1 Offset(-21, 56)
    8H27 E 1 Offset(-33, 84) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 2
    8H27 A 2 Offset(-8, 69)
    8H27 A 2 Offset(-4, 48)
    Goto ReadyX_Pissing

   DespPissAttack2:
    TNT1 A 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", -37, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MIDesperatePissingShot", 37, 0, 8, 0)
    8H27 D 2 Offset(-1, 32)
    8H27 D 2 Offset(-70, 72)
    8H27 D 2 Offset(-121, 112)
    8H27 E 2 Offset(1, 32)
    8H27 E 2 Offset(-21, 56)
    8H27 E 2 Offset(-33, 84)
    TNT1 A 2
    8H27 A 2 Offset(-8, 69)
    8H27 A 2 Offset(-4, 48)
    Goto ReadyX_Pissing


   GoDesperationFire:
    8H27 A 0 A_JumpIf(true, "DesperationFire")
    Goto DesperationFire

   DesperationFire:
    8H27 F 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    8H27 F 0 A_FireCustomMissile("Pharaoh4MIDesperateShot", 0, 0, 8, 0)
    8H27 F 0 A_FireCustomMissile("Pharaoh4MIDesperateShot", -60, 0, 8, 0)
    8H27 F 0 A_FireCustomMissile("Pharaoh4MIDesperateShot", 60, 0, 8, 0)
    8H27 D 2 Offset(-1, 32)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 D 2 Offset(-70, 72)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 D 2 Offset(-121, 112)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 E 2 Offset(1, 32)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 E 2 Offset(-21, 56)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 E 2 Offset(-33, 84)A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 AAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 A 2 Offset(-8, 69)A_GiveInventory("UnholyBossAmmo200", 2)
    8H27 A 2 Offset(-4, 48)A_GiveInventory("UnholyBossAmmo200", 2)
    Goto ReadyX_Pissed


   AltFire:
    PHAA A 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, "ReadyX_Healing")
    PHAA A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PharaohWaveAttack")
    Goto Fire
   PharaohWaveAttack:
    PHAA A 0 A_JumpIfInventory("IsPissedFlag", 1, "RAMESESRAPEATTACK")
    PHAA A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    PHAA A 0 A_GiveInventory("VivifyDelay6")
    PHAA A 0 A_Refire(1)
    PHAA B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    PHAA B 2
    PHAA B 2 Offset(16, 2)
    PHAA C 2 Offset(-27, 45)
    PHAA C 2 Offset(-1, 33)
    PHAA C 2 Offset(-1, 32)
    PHAA C 2 Offset(-1, 33)
    PHAA C 2 Offset(-1, 32)
    8H27 F 1 A_WeaponReady(14)
    8H27 GH 1
    8H27 H 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    8H27 H 0 A_FireCustomMissile("Pharaoh4MI_Wave2", -8, 0, -8, 0)
    8H27 H 0 A_FireCustomMissile("Pharaoh4MI_Wave2", 8, 0, -8, 0)
    8H27 H 0 A_FireCustomMissile("Pharaoh4MI_Wave1", -4, 0, -8, 0)
    8H27 H 0 A_FireCustomMissile("Pharaoh4MI_Wave1", 4, 0, -8, 0)
    8H27 H 2 Offset(-24, 44)
    8H27 H 2 Offset(-48, 64)
    8H27 H 2 Offset(-44, 64)
    8H27 G 2 Offset(-36, 56)
    8H27 G 2 Offset(-16, 40)
    8H27 G 2 Offset(-8, 32)
    8H27 F 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H27 F 4 A_WeaponReady(14)
    goto ReadyX

   RAMESESRAPEATTACK:
    8H27 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8H27 A 0 A_GiveInventory("VivifyDelay7")
    8H27 A 0 A_Refire(1)
    8H27 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    8H27 B 2
    8H27 B 2 Offset(16, 2)
    8H27 C 2 Offset(-27, 45)
    8H27 C 2 Offset(-1, 33)
    8H27 C 2 Offset(-1, 32)
    8H27 C 2 Offset(-1, 33)
    8H27 C 2 Offset(-1, 32)
    // delay = 7tic
    8H27 K 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 0, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", -37, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 37, 0, 8, 0)
    8H27 K 0 A_WeaponReady(14)
    8H27 KJI 2
    8H27 K 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 0, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", -37, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 37, 0, 8, 0)
    8H27 KJI 2
    8H27 K 0 A_PlaySoundEx("weapon/pharaoh2", "Weapon")
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 0, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", -37, 0, 8, 0)
    8H27 K 0 A_FireCustomMissile("Pharaoh4MIDesperateWave", 37, 0, 8, 0)
    8H27 K 2 Offset(-24, 44)
    8H27 K 2 Offset(-48, 64)
    8H27 K 2 Offset(-44, 64)
    8H27 J 2 Offset(-36, 56)
    8H27 J 2 Offset(-16, 40)
    8H27 J 2 Offset(-8, 32)
    8H27 I 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H27 I 4 A_WeaponReady(14)
    goto ReadyX_Pissed

   Reload:
    8H27 B 2 A_TakeInventory("UnholyBossAmmo250", 1)
    8H27 B 2 Offset(16, 2)
    8H27 C 2 Offset(-27, 45)
    8H27 C 2 Offset(-1, 33) ACS_NamedExecuteWithResult("rzc_Pharaoh4MICurse", 1)
    8H27 C 2 Offset(-27, 45)
    8H27 B 2 Offset(16, 2)
    8H27 B 2 A_WeaponReady(14)
    Goto ReadyX_Pissed
  }
}

// HP < 50% spawn → swap here; Ready runs GetHypedForPain once, then ReadyX_Pissed.
actor Pharaohman4MI_W_Pissed_NormalBar : NormalBar {args 170, 38}
actor Pharaohman4MI_W_Pissed_SecondBar : SecondBar {args 236, 252}
actor Pharaohman4MI_W_Pissed_ReloadIcon : ReloadIcon {Tag "R027B0"}
actor Pharaohman4MI_W_Pissed : Pharaohman4MI_W {
  States {
   Ready:
    8H27 F 0 A_JumpIfInventory("Pharaohman4MIGetUpDone_F", 1, "ReadyAfterGetUp")
    8H27 F 0 A_JumpIfInventory("IsPissedFlag", 1, "ReadyAfterGetUp")
    8H27 F 0 A_GiveInventory("Pharaohman4MIGetUpDone_F")
    8H27 F 0 A_JumpIf(true, "GetHypedForPain")
    Goto GetHypedForPain
   ReadyAfterGetUp:
    8H27 A 0 A_JumpIfInventory("Pharaohman4MIHealingFlag", 1, "RestartFlashHealing")
    8H27 A 0 A_JumpIfInventory("Pharaohman4MIPissing_F", 1, "RestartFlashPissing")
    8H27 A 0 A_JumpIf(true, "ReadyX_Pissed")
    Goto ReadyX_Pissed
   RestartFlashHealing:
    8H27 A 0 A_GunFlash("Flash_Healing", true)
    Goto ReadyX_Healing
   RestartFlashPissing:
    8H27 A 0 A_TakeInventory("Pharaohman4MIPainFlag")
    8H27 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H27 A 0 A_GunFlash("Flash_Pissing", true)
    Goto ReadyX_Pissing
  }
}

actor Pharaohman4MIHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag")*0.5+1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("Pharaohman4MI_W_Pissed", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("Pharaohman4MIPainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("Pharaohman4MISwapPissed_P")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor Pharaohman4MISwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("Pharaohman4MIGetUpDone_F")
    TNT1 A 0 A_GiveInventory("Pharaohman4MI_W_Pissed")
    TNT1 A 0 A_TakeInventory("Pharaohman4MI_W")
    stop
  }
}

// Flash_Healing finished → force ReadyX_Pissed
actor Pharaohman4MIRageEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Pharaohman4MI_W_Pissed", 1, "Reselect")
    stop
   Reselect:
    TNT1 A 0 A_TakeInventory("Pharaohman4MIHealingFlag")
    TNT1 A 0 A_TakeInventory("Pharaohman4MIPissing_F")
    TNT1 A 0 A_TakeInventory("IsPissingTimer", 0x7ffffffd)
    TNT1 A 0 A_SelectWeapon("Pharaohman4MI_W_Pissed")
    stop
  }
}

actor Pharaohman4MIGetUpDone_F : Once {}
actor Pharaohman4MIPainFlag : Once {}
actor Pharaohman4MIHealingFlag : Once {}
actor Pharaohman4MIPissing_F : Once {}

actor Pharaohman4MIStartPiss_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("IsPissingTimer", 350)
    TNT1 A 0 A_GiveInventory("Pharaohman4MIPissing_F")
    TNT1 A 0 A_GiveInventory("IsPissedFlag")
    stop
  }
}

actor Pharaohman4MIStartHeal_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("Pharaohman4MIPissing_F")
    TNT1 A 0 A_TakeInventory("IsPissingTimer", 0x7ffffffd)
    TNT1 A 0 A_GiveInventory("Pharaohman4MIHealingFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    stop
  }
}

actor Pharaoh4MI_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "PickupCheck")
    goto PickupNormal
   PickupCheck:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 5)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 5)
    stop
  }
}

actor FirePharaoh4MIShot_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("rz_CountPlayerInFrontCone", 600, 60), "Shot45")
    goto Shot30
   Shot45:
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", 0, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", -45, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", 45, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", 0, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", -45, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", 45, 0, -8, 0)
    stop
   Shot30:
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", 0, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", -30, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot1", 30, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", 0, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", -30, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("Pharaoh4MI_Shot2", 30, 0, -8, 0)
    stop
  }
}

actor Pharaoh4MIRage_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 3, 3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, -3, 3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 3, -3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, -3, -3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 5, 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, -5, 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 5, -5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, -5, -5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, sqrt(50), 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 0, sqrt(50), 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, -sqrt(50), 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIRageParticleFX", 0, 0, 64, 0, 0, -sqrt(50), 0, 1)
    stop
  }
}

actor Pharaohman4MI_RegainEffect : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 1 A_ScaleVelocity(4.0)  // A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("Pharaohman4MI_RegainEffect2", 0, 0, 0, -momx*0.1, -momy*0.1, -momz*0.1, 0, 9)
    stop
  }
}
actor Pharaohman4MI_RegainEffect2 : BasicGraphicEffect {
  scale 2.0
  states {
   SpawnFrame:
    MXP1 EDCBA 2
    stop
  }
}

actor Pharaoh4MI_Shot : BasicProjectile {
  Translation "192:192=4:4", "198:198=218:218"
  damagetype "4MIPharaoh"
  Obituary "%o was sacrificed by \ckPharaoh Man\c- (%k)'s \ckPharaoh Shot."
  damage (95)
  Radius 10
  Height 10
  speed 14
  scale 2.5
  States {
   Spawn:
    X_4D A 4
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_4D EDCB 2
    stop
  }
}
actor Pharaoh4MI_Shot1 : Pharaoh4MI_Shot {damage (85)  Speed 40}
actor Pharaoh4MI_Shot2 : Pharaoh4MI_Shot {damage (85)  Speed 20}

actor Pharaoh4MIDesperateShot : BasicProjectile {
  Translation "192:192=37:37", "198:198=38:38"
  damagetype "4MIPharaoh2"
  Obituary "%o was shown who is the boss by \ckPharaoh Man\c- (%k)'s \crDesperate \ckPharaoh Shot."
  +SKYEXPLODE
  +EXPLODEONWATER
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  WallBounceFactor 1.0
  BounceFactor 1.0
  BounceCount 99
  accuracy 2  // real bounce count
  damage (125)  // 175
  Radius 14
  Height 14
  speed 60
  scale 2.5
  var int user_bouncecount;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_SetVelPitch")
   SpawnLoop:
    X_4D JK 4
    loop
   Bounce.Wall:
    X_4D J 0 A_SetUserVar("user_bouncecount", user_bouncecount + 1)
    X_4D J 0 A_JumpIf(user_bouncecount >= accuracy, "Bounce_Wall_Death")
    X_4D J 0 ACS_NamedExecuteWithResult("core_SetVelPitch")
    goto SpawnLoop
   Bounce_Wall_Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_PlaySoundEx("weapons/mm7/junkshieldbreak", "Weapon")
    TNT1 A 1 A_Explode(200, 112, 0)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotExplosion", 0, 0, 0, cos(pitch)*60.0, 0, sin(pitch)*60.0)
    stop
   Bounce.Floor:
   Bounce.Ceiling:
    X_4D J 0 A_SetUserVar("user_bouncecount", user_bouncecount + 1)
    X_4D J 0 A_JumpIf(user_bouncecount >= accuracy, "Bounce_Flat_Death")
    X_4D J 0 ACS_NamedExecuteWithResult("core_SetVelPitch")
    goto SpawnLoop
   Bounce_Flat_Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_PlaySoundEx("weapons/mm7/junkshieldbreak", "Weapon")
    TNT1 A 1 A_Explode(200, 112, 0)
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotExplosion", 0, 0, 0, cos(pitch)*60.0, 0, -sin(pitch)*60.0)
    stop

    // Death:
    // TNT1 A 0 A_CheckFloor("Death_Floor")
    // TNT1 A 0 A_CheckCeiling("Death_Floor")
    // TNT1 A 0 A_JumpIf(true, "Death_Wall")
    // goto Death_Wall
    // // X_4D J 0 A_JumpIf(BounceCount == 0, "Death_Wall")
    // Death_Wall:
    // TNT1 A 0 A_Stop
    // TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    // TNT1 A 0 A_PlaySoundEx("weapons/mm7/junkshieldbreak","Weapon")
    // TNT1 A 1 A_Explode(200,112,0)
    // TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotExplosion", 0, 0, 0,
    //                        -cos(pitch)*60.0, 0, sin(pitch)*60.0)
    // stop
    // // Bounce.Floor:
    // // Bounce.Ceiling:
    // // X_4D J 0 A_JumpIf(BounceCount == 0, "Death_Floor")
    // Death_Floor:
    // TNT1 A 0 A_Stop
    // TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    // TNT1 A 0 A_PlaySoundEx("weapons/mm7/junkshieldbreak","Weapon")
    // TNT1 A 1 A_Explode(200,112,0)
    // TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotExplosion", 0, 0, 0,
    //                        cos(pitch)*60.0, 0, -sin(pitch)*60.0)
    // stop
    // Death_No:
    // TNT1 A 0
    // stop
  }
}

actor Pharaoh4MIDesperatePissingShot : Pharaoh4MIDesperateShot {
  accuracy 1
  States {
   Bounce_Wall_Death:
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotPissingSplit", 0, 0, 0, random(4, 8), 0, 18, random(0, 359))
    goto Super::Bounce_Wall_Death
   Bounce_Flat_Death:
    TNT1 A 0 A_SpawnItemEx("Pharaoh4MIDesperateShotPissingSplit", 0, 0, 0, random(4, 8), 0, 18, random(0, 359))
    goto Super::Bounce_Flat_Death
  }
}

actor Pharaoh4MIDesperateShotPissingSplit : Pharaoh4MIDesperateShot {
  -NOGRAVITY
  -BOUNCEONFLOORS
  -BOUNCEONWALLS
  -BOUNCEONCEILINGS
  -CANBOUNCEWATER
  -USEBOUNCESTATE
  States {
   Spawn:
    X_4D JK 4
    loop
   Death:
    TNT1 A 0 A_Explode(75, 96, 0, 0, 16)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_4D LMNO 2
    stop
  }
}

actor Pharaoh4MIDesperateShotExplosion : BasicExplosion {
  translation "192:192=4:4", "198:198=210:210"
  reactiontime 3
  States {
   Spawn:
    X_GL A 0
    X_GL A 0 A_Explode(200, 120, 0, 0, 75)
    X_GL ABCD 1
    X_GL A 0 A_Explode(200, 120, 0, 0, 75)
    X_GL EFGH 1
    X_GL H 0 A_Countdown
    loop
  }
}


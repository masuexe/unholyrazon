actor CaptainDevilEye_W : BaseUnholyBossWep
{
Tag "$TAG_Boss009_W"
Obituary "%o was KO'D by %k the \chDevileye\c-!"
Inventory.Pickupmessage "\cgDo not fail our cause for underworld..."
weapon.ammotype2 "UnholyBossAmmo100"
weapon.ammotype "UnholyBossAmmo50"
States
{
Spawn:
8H09 [ 1
wait

Deselect:
8H09 A 0
goto DeselectSwap
Select:
8H09 A 0
goto SelectSwap

Ready:
8H09 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, -1)//CAPTAINDEVILEYE_DYE
// 8H09 A 0 A_GiveInventory("DevilEyeCaptainItem",1)
8H09 A 1 A_GiveInventory("UnholyBossAmmo100",100)
goto ReadyX

ReadyX:
8H09 A 0 A_JumpIfInventory("UnholyBossAmmo50",50,"ReadyX2")
8H09 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, 2)
8H09 A 2 A_WeaponReady(8)
goto ReadyXGive
8H09 A 2 A_WeaponReady(8+16)
ReadyXGive:
8H09 A 0 A_GiveInventory("UnholyBossAmmo100",2)
8H09 A 0 A_GiveInventory("UnholyBossAmmo50",2)
goto ReadyX

ReadyX2:
8H09 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, 2)
8H09 A 2 A_WeaponReady
goto ReadyXGive2
8H09 A 2 A_WeaponReady(16)
ReadyXGive2:
8H09 A 0 A_GiveInventory("UnholyBossAmmo100",2)
8H09 A 0 A_GiveInventory("UnholyBossAmmo50",2)
Goto ReadyX2

Fire:
8H09 B 0 A_PlaySoundEx("weapon/firestorm","Weapon")
8H09 B 0 A_FireCustomMissile("FaggassoRapassoShottasso",0,0,-8,0)
8H09 BCAAAAA 5 A_GiveInventory("UnholyBossAmmo50",1)
Goto ReadyX
AltFire:
8H09 A 0 A_JumpIfInventory("UnholyBossAmmo50",50,"CheapDevilUppercut")
Goto ReadyX
CheapDevilUppercut:
8H09 E 0 A_GiveInventory("VivifyFlag1")
8H09 E 0 A_ReFire(1)
8H09 E 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
8H09 E 0 A_GiveInventory("NoJumpCancel")
8H09 E 0 A_TakeInventory("UnholyBossAmmo50")
8H09 E 0 A_Recoil(-25)
8H09 E 0 ThrustThingZ(0,25,0,0)
8H09 E 3 A_SpawnItemEx("DevilFaggassoWind",0,0,-50)
8H09 E 0 A_PlaySoundEx("weapon/FlamingUpper","Weapon")
8H09 E 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
8H09 E 0 ThrustThingZ(0,75,0,0)
8H09 E 0 A_SpawnItemEx("DevilFaggassoWind",0,0,-50)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 0 A_SpawnItemEx("DevilFaggassoWind",0,0,-50)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 0 A_SpawnItemEx("DevilFaggassoWind",0,0,-50)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 E 1 A_FireCustomMissile("RISINGTAKOOATTAKOO",0,0,8,0)
8H09 E 0 A_SetAngle(angle-20.0)
8H09 A 5
8H09 A 0 A_TakeInventory("VivifyFlag1")
8H09 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
8H09 A 5 A_TakeInventory("NoJumpCancel")
8H09 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
8H09 A 16
goto ReadyX

// "Gain more money by spending money."
Reload:
8H09 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"DevilBait")
goto ReadyX
DevilBait:
8H09 A 0 ACS_NamedExecuteWithResult("uh_SetClassCustomState", 1)
8H09 A 0 A_TakeInventory("UnholyBossAmmo100",100)
8H09 A 0 A_PlaySoundEx("items/MoneyUse","Item")
8H09 A 0 A_FireCustomMissile("DevilBaitShot",0,0,-8,0)
8H09 BCA 2
goto ReadyX
}
}

actor DevilBaitShot : BasicProjectile
{
Translation "192:192=57:57", "198:198=79:79"
damagetype "DevilCash"
Obituary "%o couldn't handle %k the \chDevileye\c-'s loads of money!"
-NOGRAVITY
-RIPPER
+THRUGHOST
+SKYEXPLODE
Bouncetype Classic
+BOUNCEONWALLS
-BOUNCEONFLOORS
-BOUNCEONCEILINGS
-ALLOWBOUNCEONACTORS
+DONTSPLASH
+STEPMISSILE
maxstepheight 24
bouncecount 10
bouncefactor 0.4
wallbouncefactor 0.75
gravity 1.75
ReactionTime 2
Damage (0)
Radius 16
Height 16
Speed 25
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_CountDown
TNT1 A 1 ThrustThingZ(0,16,0,1)
I_BI A 1 A_CheckFloor("Spawn2")
wait
Spawn2:
I_BI A 1 A_CountDown
wait
Crash:
XDeath:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/MoneyUse","Body")
TNT1 A 1 A_SpawnItemEx("DevilBaitCash_Helper",0,0,8)
stop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("items/MoneyUse","Body")
TNT1 A 1 A_SpawnItemEx("DevilBaitShot2",0,0,0,0,0,0,0,1)
stop
}
}

actor DevilBaitShot2 : DevilBaitShot
{
+DONTBLAST
-BOUNCEONWALLS
+NOEXPLODEFLOOR
States
{
Spawn:
I_BI A 1
I_BI A 350 A_CountDown
wait
Death:
TNT1 A 0
goto XDeath
}
}


actor PlainDevilDemoneye_W : PlainDemoneye_W
{
Tag "$TAG_Lackey009_W"
Obituary "%o was bitch slapped by %k the \ctRecruited Demoneye\c-!"
States
{
Spawn:
_E00 ] 6
wait
Ready:
_E00 E 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CAPTAINDEVILEYE_DYE4)
_E00 E 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 0,1)
_E00 E 2
_E00 EE 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, CAPTAINDEVILEYE_DYE4,1)
goto ReadyX
ReadyX:
_E00 E 2 A_WeaponReady
Goto ReadyX

Fire:
_E00 E 1
_E00 E 0 A_PlaySoundEx("weapon/slashclaw","Weapon")
_E00 E 0 A_FireCustomMissile("PlainDevil_Slap",0,0,8,0)
_E00 FG 2
_E00 E 1 Offset(0,72)
_E00 E 1 Offset(0,62) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E00 E 1 Offset(0,52)
_E00 E 1 Offset(0,42) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E00 E 0 Offset(0,32)
Goto ReadyX
}
}


actor BluHeavyRageShot : RedHeavyRageShot {
  Translation "192:192=197:197", "198:198=199:199"
  damagetype "BluTank"
  Obituary "%o went boom due to \chBlu TankBoi\c- (%k)'s Machine Buster."
  +SEEKERMISSILE
  Damage (125)
  Radius 13
  Height 13
  speed 25
  scale 3.0
  States {
   Spawn:
    X_4G AB 1 A_SeekerMissile(5, 20, 3, 55, 3)
    loop
   Death:
    X_8G A 0 A_Stop
    X_8G A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
    X_8G A 0 A_Explode(125, 128, 0, 0, 64)
    X_8G ABCEFECBA 1
    stop
  }
}

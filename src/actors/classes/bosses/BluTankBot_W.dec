actor BluTankBot_W_NormalBar : NormalBar {args 198, 199}
actor BluTankBot_W_ReloadIcon : ReloadIcon {Tag "R036B0"}
actor BluTankBot_W : BaseUnholyBossWep {
  Tag "$TAG_Boss036_W"
  Obituary "%o was crushed by \chBlu TankBoi\c- (%k)'s Machine Buster!"
  Inventory.Pickupmessage "\chTankboi Blu\c- Waiting for orders!"
  weapon.ammotype "UnholyPower1000"
  States {
   Spawn:
    8H36 [ 1
    wait

   Deselect:
    8H36 A 0
    goto DeselectSwap
   Select:
    8H36 A 0
    goto SelectSwap

   Ready:
    8H36 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8H36 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLUTANKBOT_DYE)
    goto ReadyX
   ReadyX:
    8H36 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX_16")
    8H36 A 2 A_WeaponReady
    goto ReadyX
   ReadyX_16:
    8H36 A 2 A_WeaponReady(16)
    goto ReadyX
    loop

   Fire:
    // 8H36 A 0 A_JumpIfInventory("UnholyPower1000",1000,"FireRage")
    8H36 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireA")
    8H36 A 0 A_GiveInventory("DuoBusterFlag")
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, 8, 0)
    8H36 DE 2
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, -8, 0)
    8H36 BH 2
    8H36 G 0 A_Refire("Fire2")
    Goto FireEndG
   Fire2:
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, 8, 0)
    8H36 BE 2
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, -8, 0)
    8H36 BH 2
    8H36 G 0 A_Refire("Fire2")
    Goto FireEndG
   FireA:
    8H36 A 0 A_TakeInventory("DuoBusterFlag")
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, -8, 0)
    8H36 GH 2
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, 8, 0)
    8H36 BE 2
    8H36 D 0 A_Refire("FireA2")
    Goto FireEndD
   FireA2:
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, -8, 0)
    8H36 BH 2
    8H36 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H36 A 0 A_FireCustomMissile("BluHeavyShot", random(-2, 2), 0, 8, 0)
    8H36 BE 2
    8H36 D 0 A_Refire("FireA2")
    Goto FireEndD

   FireEndD:
    8H36 D 2
    Goto ReadyX
   FireEndG:
    8H36 G 2
    Goto ReadyX

   Reload:
    8H36 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "UnleashMissiles")
   UnleashMissiles:  // If this procs more than once, then there's a problem.
    8H36 A 0 A_TakeInventory("UnholyPower1000", 1000)
    8H36 A 0 A_PlaySoundEx("misc_L/fakereloadshort", "SoundSlot6")
    8H36 ABB 5
    8H36 C 0 A_FireCustomMissile("BluHeavyRageShot", -3, 0, 20, 0)
    8H36 C 0 A_FireCustomMissile("BluHeavyRageShot", 3, 0, -20, 0)
    8H36 C 0 A_PlaySoundEx("S3_K/SpikeMine", "SoundSlot7")
    8H36 CB 3
    8H36 A 2
    8H36 C 0 A_FireCustomMissile("BluHeavyRageShot", -3, 0, 20, 0)
    8H36 C 0 A_FireCustomMissile("BluHeavyRageShot", 3, 0, -20, 0)
    8H36 C 2 A_PlaySoundEx("S3_K/SpikeMine", "SoundSlot7")
    8H36 CBA 2
    Goto ReadyX

    /*FireRage:
8H36 A 0 A_TakeInventory("UnholyPower1000",1000)
8H36 A 0 A_PlaySoundEx("misc_L/fakereloadshort","Weapon")
8H36 ABC 5
8H36 C 0 A_FireCustomMissile("BluHeavyRageShot",-3,0,20,0)
8H36 C 0 A_FireCustomMissile("BluHeavyRageShot",3,0,-20,0)
8H36 C 2 A_PlaySoundEx("S3_K/SpikeMine","Body")
8H36 BAB 2
8H36 C 0 A_FireCustomMissile("BluHeavyRageShot",-3,0,20,0)
8H36 C 0 A_FireCustomMissile("BluHeavyRageShot",3,0,-20,0)
8H36 C 2 A_PlaySoundEx("S3_K/SpikeMine","Body")
8H36 BA 2
Goto ReadyX*/

   Altfire:
    8H36 A 0 A_JumpIf(momz==0, "LoongJump")
    goto ReadyX
   LoongJump:
    8H36 A 0 A_GiveInventory("BluTankBoi_Alt_P")
    8H36 A 2 Offset(0, 47)
    8H36 A 2 Offset(0, 62)
    8H36 A 2 Offset(0, 77)
    8H36 A 2 Offset(0, 92)
    TNT1 A 9  // 14
    8H36 A 2 Offset(0, 92)
    8H36 A 2 Offset(0, 77)
    8H36 A 2 Offset(0, 62)
    8H36 A 2 Offset(0, 47)
    Goto ReadyX
  }
}

actor BluTankBoi_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("BluTankBoi_Boost_Boom", 0, 0, 10, 0, 0, 0, 0, 1)
    goto Thrust
   Thrust:
    TNT1 A 0 ThrustThingZ(0, 70, 0, 0)  // 70
    TNT1 A 0 A_Recoil(-20)  // -20
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    stop
  }
}

actor BluTankBoi_Boost_Boom : BasicExplosion {
  Obituary "%o was crushed by \chBlu TankBoi\c- (%k)'s Machine Buster!"
  damagetype "BluTank"
  +FORCEXYBILLBOARD
  +BRIGHT
  Speed 48
  Scale 2.75
  Args 325, 128, 20  // 400 //I think a 75 damage drop for the boss is... fair, since this isn't... RED.
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("V_Man/Boom", "Body")
    TNT1 A 0 A_Explode(Args[0]*(1+CallACS("uh_checkrune", RUNE_SPREAD)*2), Args[1], 0, 0, Args[2])
    6P16 HIJKL 3
    stop
  }
}

actor BluHeavyShot : RedHeavyShot  // "Welcome to lazy inheritance! No need to define an effect again if it doesn't really DO damage." - Trist
{
  Translation "192:192=198:198", "198:198=199:199"  //
  damagetype "BluTank"
  Obituary "%o was crushed by \chBlu TankBoi\c- (%k)'s Machine Buster!"
  Damage (150)
  radius 16
  height 16
  Speed 50  // 40
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7, 9, 11, 13, 15)
    6P16 A 1
    6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+1
    6P16 B 1
    6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+2
    6P16 C 1
    6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+3
    6P16 D 1
    6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1
    6P16 D 1
    6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+1
    6P16 C 1
    6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+2
    6P16 B 1
    6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+3
    6P16 A 1
    6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2
  }
}


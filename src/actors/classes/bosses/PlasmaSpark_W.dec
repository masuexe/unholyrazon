actor Spark_Devourer_Shot : BasicProjectile
{
Translation "192:192=136:136","198:198=104:104","202:202=136:136","199:199=104:104"
damagetype "PlasmaSpark_B"
Obituary "%o got the shocker from \cdPlasma \cjSpark\c- (%k)." //Filler
+RIPPER
Damage (200) //Can max out at 400
Radius 24 //20
Height 24 //20
Speed 70
scale 2.0
States
{
Spawn://WCPJ
8P16 MNON 2 A_SpawnItemEx("Spark_Devourer_Shot_Trail_Spawner",0,0,0,0,0,0,0,1)
loop
Death:
TNT1 A 1 A_SpawnItemEX("Spark_Devourer_Boom",0,0,0,0,0,0,0,1)
stop
}
}

actor Spark_Devourer_Shot_Trail_Spawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    TNT1 A 0 A_SpawnItemEx("Spark_Devourer_Shot_Trail",0,0,0,0,0,0,0,1)
    stop
  }
}


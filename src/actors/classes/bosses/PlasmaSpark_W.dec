//Make FX + radius have farther reach.
//Make this look better, make the colors properly display.
//Just do, anything. Do something with it, I do not know.
actor Spark_Discharge_Radius : BasicExplosion
{
Translation "192:192=104:104", "202:202=136:136"
damagetype "PlasmaSpark_D"
Obituary "%o got the shocker from \cdPlasma \cjSpark\c- (%k)." //Filler
States
{
Spawn: //Hi it's 2023 Trist.
TNT1 A 0 //I don't know how to make this effect reach FARTHER to match the explosion size!
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H1",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H2",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H3",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H4",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H5",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_H6",0,0,0,0,0,0,0,1) //added
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_Boom",0,0,2,0,0,17,0,33)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_Boom",0,0,-2,0,0,-17,0,33)
TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
TNT1 A 0 A_Explode(200,384,0,0,96) //100,196,0,0,64
TNT1 A 4 //50 damage
stop
}
}

actor Spark_Discharge_FX_H1 : BasicGraphicEffect
{
Translation "192:192=104:104","202:202=136:136"
var int user_RT;
var int user_A;
Mass 250
MeleeRange 0
accuracy 6
renderstyle none
reactiontime 15
States
{
SpawnFrame:
TNT1 A 0 A_SetUserVar("user_RT",360/reactiontime)
TNT1 A 0 A_SetUserVar("user_A",random(0,user_RT))
TNT1 A 0 A_JumpIf(true, "SpawnLoop")
SpawnLoop:
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_Boom",0,0,0,Mass/accuracy,0,MeleeRange/accuracy,user_A,37)
TNT1 A 0 A_SetUserVar("user_A",user_A+user_RT)
TNT1 A 0 A_Countdown
loop
Death:
TNT1 A 1
stop
}
}


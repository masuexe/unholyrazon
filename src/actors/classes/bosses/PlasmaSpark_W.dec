actor PainPU_PlasmaMelee : PainPush_Fling
{
States
{
Full:
TNT1 A 0 ThrustThing(random(0,255),random(2,8),1,0)
TNT1 A 0 A_SetAngle(angle+(random(0,1)*2-1)*random(1,4)*5)
stop
Half:
TNT1 A 0 ThrustThing(random(0,255),random(1,4),1,0)
TNT1 A 0 A_SetAngle(angle+(random(0,1)*2-1)*random(1,4)*2.5)
stop
}
}

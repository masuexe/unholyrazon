+RIPPER
+NOGRAVITY
+DONTBLAST
Damage(20) //10
Radius 25
Height 16
scale 3.5
States
{
Spawn:
X_7D IIJJKKLL 1 A_SpawnItemEx("ElectrifyEffect")
stop
}
}

actor Plasma_Discharge_Boom : BasicExplosion
{
damagetype "PlasmaSpark_B"
Obituary "%o got the shocker from \cdPlasma \cjSpark\c- (%k)." //Filler
Scale 4.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_ChangeFlag(NOGRAVITY, 1)
TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
TNT1 A 0 A_Explode(96,20,0,0,64)
TNT1 A 1
stop
}
}


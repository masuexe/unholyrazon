//Zomo note: Mass/MeleeRange must always equal each other in FX4. FX2 and FX6 must have opposite values of each
//other for Mass/MeleeRange. Same goes for FX3 and FX5.

actor Spark_Discharge_FX_H2 : Spark_Discharge_FX_H1
{
Mass 240
MeleeRange 65
Reactiontime 12
States
{
SpawnLoop:
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_Boom",0,0,0,Mass/accuracy,0,MeleeRange/accuracy,user_A,37)
TNT1 A 0 A_SpawnItemEx("Spark_Discharge_FX_Boom",0,0,0,Mass/accuracy,0,MeleeRange/accuracy*-1,user_A,37)
TNT1 A 0 A_SetUserVar("user_A",user_A+user_RT)
TNT1 A 0 A_Countdown
loop
}
}


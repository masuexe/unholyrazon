actor PlasmaSpark_W_ScriptBar : ScriptBar {}
actor PlasmaSpark_W : BaseUnholyBossWep  // Plasma_Shock_Super_Star
{
Obituary "%o got the shocker from \cdPlasma \cjSpark\c- (%k)." //Filler
Inventory.Pickupmessage "\cdTHE SHOCKER."
weapon.ammotype "Voltage_Stocker"
weapon.ammotype2 "UnholyBossAmmo200"
States
{
Spawn:
8H63 [ 1
wait

Ready:
8H63 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, PLASMASPARK_DYE)
8H63 A 0 A_GunFlash
goto ReadyX
//
//A_SpawnItemEx("Plasma_Passive_Shocker",random(-100,100),random(-100,100),random(0,100),0,0,0,0,1)
Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 1 A_GiveInventory("PlasmaSpark_Pickup")
TNT1 A 0 A_JumpIfInventory("Voltage_Stocker",1200,"Flash_Harder")
loop
Flash_Harder:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 A_SpawnItemEx("Plasma_Passive_Shocker",random(-100,100),random(-100,100),random(0,100),0,0,0,0,1)
TNT1 A 1 A_GiveInventory("PlasmaSpark_Pickup") //Is this necessary at this point?
TNT1 A 0 A_JumpIfInventory("Voltage_Stocker",1200,"Flash_Harder")
Goto Flash
//
ReadyX:
8H63 A 2 A_WeaponReady(WRF_NOSECONDARY)
8H63 A 0 A_GiveInventory("UnholyBossAmmo200",2) //4
8H63 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Ready_True")
loop
Ready_True:
8H63 A 2 A_WeaponReady
loop

Deselect:
8H63 C 0
goto DeselectSwap
Select:
8H63 C 0
goto SelectSwap

Fire:
8H63 FGH 2 //2
8H63 H 0 A_JumpIfInventory("Voltage_Stocker",1200,"DEATHBLOW")
8H63 H 0 A_JumpIfInventory("Voltage_Stocker",900,"High_Fire")
8H63 H 0 A_JumpIfInventory("Voltage_Stocker",600,"Moderate_Fire")
8H63 H 0 A_JumpIfInventory("Voltage_Stocker",300,"Basic_Fire")
8H63 H 0 A_TakeInventory("Voltage_Stocker")
Hold: //Just INCASE.
8H63 H 0 A_TakeInventory("Voltage_Stocker")
8H63 H 0 A_PlaySoundEx("weapon/sparkshock","Weapon")
8H63 H 2 A_FireCustomMissile("Plasma_Spark_Melee",0,0,0,0)
8H63 H 0 A_ReFire
StopHold:
8H63 H 1 A_ClearRefire
8H63 HGFAA 2 //3
Goto ReadyX
Basic_Fire:
8H63 H 0 A_TakeInventory("Voltage_Stocker")
8H63 H 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H63 H 2 A_FireCustomMissile("Plasma_Spark_Shot_1",0,0,0,0)
8H63 HH 2
8H63 H 0 A_ReFire("Hold")
Goto StopHold
Moderate_Fire:
8H63 H 0 A_TakeInventory("Voltage_Stocker")
8H63 H 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H63 H 2 A_FireCustomMissile("Plasma_Spark_Shot_2",0,0,0,0)
8H63 HH 2
8H63 H 0 A_ReFire("Hold")
Goto StopHold
High_Fire:
8H63 H 0 A_TakeInventory("Voltage_Stocker")
8H63 H 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H63 H 0 A_ChangeVelocity(-Cos(pitch)*10,0,sin(pitch)*8,CVF_RELATIVE)
8H63 H 2 A_FireCustomMissile("Plasma_Spark_Shot_3",0,0,0,0)
8H63 HH 2
8H63 H 0 A_ReFire("Hold")
Goto StopHold
DEATHBLOW:
8H63 H 0 A_TakeInventory("Voltage_Stocker")
8H63 H 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
8H63 H 0 A_ScaleVelocity(0.2)
8H63 H 0 A_ChangeVelocity(-Cos(pitch)*20,0,sin(pitch)*16,CVF_RELATIVE)
8H63 H 2 A_FireCustomMissile("Spark_Devourer_Shot",0,0,0,0)
8H63 HHHHH 2
8H63 H 0 A_ReFire("Hold")
Goto StopHold

Discharge: //Should be 4 discharges per full ammo.
8H63 H 0 A_TakeInventory("UnholyBossAmmo200",50)
8H63 H 0 A_GiveInventory("Spark_Animation_X") //
8H63 H 0 A_GiveInventory("PlasmaSpark_BasicArmor_P", 1)
//8H63 H 0 A_JumpIfInventory("UnholyBossAmmo200",1,1)
//Goto StopAltHold
8H63 H 0 A_TakeInventory("Plasma_Powerinos")
8H63 H 0 A_PlaySoundEx("weapon/lightningbolt","SoundSlot5")
8H63 H 0 A_SpawnItemEx("PlasmaSpark_Thunder_Start")
8H63 H 0 A_SpawnItemEx("Spark_Discharge_Radius",0,0,16,0,0,0,0,1)
8H63 H 0 A_ReFire("AltHold")
Goto StopAltHold
Altfire: //Animate the alt properly, please.
8H63 H 0 A_GiveInventory("UH_35_SpeedPowerGiver") //ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H63 FGH 1 //A_ScaleVelocity(0.8)
AltHold: //Plasma_Discharge_FX
8H63 H 0 A_JumpIfInventory("UnholyBossAmmo200",1,1)
Goto StopAltHold
8H63 H 0 A_PlaySoundEx("weapon/sparkshock","Weapon")
8H63 H 0 A_GiveInventory("Plasma_Powerinos",1)
8H63 H 0 A_GiveInventory("Spark_Animation",1) //
8H63 H 0 A_SpawnItemEx("Plasma_Discharge_FX",random(-100,100),random(-100,100),random(0,100),0,0,0,0,1)
8H63 H 1 A_SpawnItemEx("Plasma_Discharge_Boom",0,0,16,0,0,0,0,1)
8H63 H 0 A_TakeInventory("Spark_Animation_X") //
8H63 H 0 A_JumpIfInventory("Plasma_Powerinos",30,"Discharge")
8H63 H 0 A_ReFire
StopAltHold:
8H63 H 0 A_TakeInventory("UH_35_SpeedPower")
8H63 H 0 A_TakeInventory("Spark_Animation") //
8H63 H 0 A_TakeInventory("Spark_Animation_X") //
8H63 H 0 A_TakeInventory("UnholyBossAmmo200",25) //Penalize. //50
8H63 H 0 A_TakeInventory("Plasma_Powerinos")
8H63 H 1 A_ClearRefire
8H63 HGF 2
8H63 H 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H63 AA 2 //3
Goto ReadyX
}
}

actor Voltage_Stocker : Ammo //Inventory
{
inventory.amount 1
inventory.maxamount 1200 //400 //500 //600
} //Every 300?

actor Plasma_Powerinos : Inventory //Inventory
{
inventory.amount 1
inventory.maxamount 30 //400 //500 //600
} //Every 300?


actor PlasmaSpark_Pickup : CustomInventory
{
States //I was thinking of making the first charge stack fast... while the rest is normal.
{
Pickup:
TNT1 A 0 A_JumpIfInventory("Voltage_Stocker",1200,"Pickup0")
//TNT1 A 0 A_JumpIfInventory("Voltage_Stocker",300,"Pickup1")
TNT1 A 0 A_JumpIf( (MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)*0.01 >= 1,"Pickup1")
stop
Pickup0:
TNT1 A 0 
stop
Pickup1:
TNT1 A 0 A_JumpIfInventory("Voltage_Stocker",300,"Pickup2")
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"Pickup_Rage")
goto Pickup3
Pickup2:
TNT1 A 0 A_GiveInventory("Voltage_Stocker",(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)*0.02)
stop
Pickup_Rage:
TNT1 A 0 A_GiveInventory("Voltage_Stocker",(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)*0.03)
stop
//
Pickup3: //3
TNT1 A 0 A_GiveInventory("Voltage_Stocker",(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)*0.03)
stop
}
}


actor PlasmaSpark_BasicArmor_P : BasicArmorBonus
{
Armor.Savepercent 50
Armor.Saveamount 250
Armor.MaxSaveAmount 1000
}

Actor Plasma_Passive_Shocker : BasicProjectile
{
damagetype "PlasmaSpark_A"

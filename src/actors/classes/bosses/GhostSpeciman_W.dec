actor GhostSpeciman_W_ScriptBar : ScriptBar {}
actor GhostSpeciman_W : BaseUnholyBossWep {
  Tag "$TAG_GhostSpeciman_W"
  Obituary "\ctGhost of Speciman\c- (%k) assumed that %o was anti-economic."
  Inventory.Pickupmessage "Hark Hark"
  Weapon.AmmoGive 300
  Weapon.AmmoType "UnholyBossAmmo300"
  Weapon.AmmoType2 "UnholyPower3000"
  States {
   Spawn:
    8I06 [ 1
    wait

   Deselect:
    8I06 A 0
    goto DeselectSwap
   Select:
    8I06 A 0
    goto SelectSwap

   Ready:
    8I06 A 0  // Initial setup: boss morph hook.
    8I06 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, GhostSpeciman_DYE)
    8I06 A 0  // Initial setup: boss morph hook.
    goto ReadyX
   ReadyX:
    8I06 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "ReadyX2")
    8I06 A 2 A_WeaponReady(8)
    8I06 A 0 A_GiveInventory("UnholyBossAmmo300", 2)
    loop
   ReadyX2:
    8I06 A 2 A_WeaponReady
    8I06 A 0 A_GiveInventory("UnholyBossAmmo300", 2)
    loop

   Fire:  // Flash a menacing smile.
    8I06 D 0 A_JumpIfInventory("UnholyBossAmmo300", 200, "Oven")
    8I06 D 0 A_PlaySoundEx("E_B/PSIAttack", "Weapon")
    8I06 D 2 Offset(-6, 25) A_GiveInventory("UnholyBossAmmo300", 2)
    8I06 D 2 A_FireCustomMissile("ASPEconomySmasher", 0, 0, 0, 0)
    8I06 D 2 Offset(-12, 18) A_GiveInventory("UnholyBossAmmo300", 2)
    8I06 D 2 Offset(-8, 23) A_GiveInventory("UnholyBossAmmo300", 2)
    8I06 D 2 Offset(-4, 28) A_GiveInventory("UnholyBossAmmo300", 2)
    8I06 B 2 Offset(-2, 30) A_GiveInventory("UnholyBossAmmo300", 2)
    8I06 B 0 A_WeaponReady(14)
    8I06 BBBBBBB 2 A_GiveInventory("UnholyBossAmmo300", 2)
    goto ReadyX
   Oven:  // Starstorm Alpha
    8I06 D 0 A_TakeInventory("UnholyBossAmmo300", 200)
    8I06 D 0 A_PlaySoundEx("wep/AlienBeam", "Weapon")
    8I06 D 0 A_FireCustomMissile("ASPEconomyPinPoint", 0, 0, 0, 8)
    8I06 D 2 Offset(-6, 25)
    8I06 D 2 Offset(-12, 18)
    8I06 D 2 Offset(-8, 23)
    8I06 D 2 Offset(-4, 28)
    8I06 B 2 Offset(-2, 30)
    8I06 B 0 A_WeaponReady(14)
    8I06 B 30
    goto ReadyX

   Altfire:
    8I06 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "PickingTheLock")
    goto ReadyX
   PickingTheLock:
    8I06 B 0 A_TakeInventory("UnholyPower3000")
    8I06 B 0 A_GiveInventory("DecoyFlag1")
    8I06 B 0 A_SpawnItemEx("GhostF_RageStartHelper")
    8I06 D 8 Offset(-6, 25)
    8I06 D 8 Offset(-12, 18)
    8I06 D 8 Offset(-8, 23)
    8I06 D 8 Offset(-4, 28)
    8I06 B 8 Offset(-2, 30)
    8I06 B 0 A_SpawnItemEx("GhostF_RageStartHelper")
    8I06 D 8 Offset(-6, 25)
    8I06 D 8 Offset(-12, 18)
    8I06 D 8 Offset(-8, 23)
    8I06 D 8 Offset(-4, 28)
    8I06 B 8 Offset(-2, 30)
    8I06 B 0 A_SpawnItemEx("GhostF_RageStartHelper")
    8I06 D 8 Offset(-6, 25)
    8I06 D 8 Offset(-12, 18)
    8I06 D 8 Offset(-8, 23)
    8I06 D 8 Offset(-4, 28)
    8I06 B 8 Offset(-2, 30)
    8I06 C 0 ThrustThingZ(0, 60, 0, 0)
    8I06 C 5 Offset(-6, 25)
    8I06 C 5 Offset(-12, 18)
    8I06 C 0 A_Stop
    8I06 C 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I06 C 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I06 C 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I06 C 0 A_FireCustomMissile("ASPEconomyStormOmegaLeviosaaa", 0, 0, 0, 0)
    goto Picking
   Picking:
    8I06 C 1 A_SetAngle(angle - 10.0)
    8I06 C 0 A_JumpIfInventory("DecoyFlag1", 1, "Picking")
    goto Scrubgasso
   Scrubgasso:
    8I06 C 0 A_PlaySoundEx("misc/devilpain", "Voice")
    8I06 C 0 ThrustThing(random(0, 255), 500, 1, 0)
    8I06 C 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8I06 C 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8I06 C 2 Offset(-8, 23) A_SpawnItemEx("PainFX", 0, 3)
    8I06 B 2 Offset(-4, 28) A_SpawnItemEx("PainFX", 0, 3)
    8I06 C 2 Offset(-2, 30) A_SpawnItemEx("PainFX", 0, 3)
    8I06 B 0 A_WeaponReady(14)
    8I06 BCBCBCBCB 2 A_SpawnItemEx("PainFX", 0, 3)
    8I06 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8I06 B 45
    goto ReadyX
  }
}
// PK Starstorm Omega
// The Ghost of Starman flashed a menacing smile!
// count down
// whispered 3
// murmured 2
// muttered 1

actor ASPEconomySmasher : BasicProjectile {
  DamageType "ASPGhostX"
  Obituary "\ctGhost of Speciman\c- (%k) gave %o a menacing smile."
  +THRUACTORS
  +DONTBLAST
  +DONTREFLECT
  ReactionTime 1
  Damage (0)
  Radius 6
  Height 6
  Speed 60
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_CountDown
    wait
   Death:
    TNT1 A 0
    TNT1 A 2 A_Explode(150, 64, 0, 0, 65)
    stop
  }
}



actor ASPEconomyPinPoint : ProjSpawnFuncActorFast {
  Translation "192:192=79:79", "198:198=41:41"
  DamageType "ASPGhost"
  Obituary "%o got hurt and collapsed."
  +SKYEXPLODE
  +EXPLODEONWATER
  +THRUACTORS
  +DONTBLAST
  Damage (0)
  Radius 6
  Height 6
  Speed 1000
  Scale 4.0
  States {
   Spawn:
    TNT1 A 2
    loop
   Death:
    TNT1 A 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RRSSTT 1
    TNT1 A 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RRSSTT 1
    TNT1 A 0 A_PlaySoundEx("misc/BombCount", "Voice")
    EVFL RRSSTT 1
    TNT1 A 0 A_SpawnItemEx("ASPEconomyStormSpawn")
    stop
  }
}

actor ASPEconomyStormSpawn : BasicWatcher {
  ReactionTime 15
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/StarStorm", "Weapon")
    TNT1 A 0 A_PlaySoundEx("E_B/StarStorm", "Voice")
    TNT1 AAA 1 A_SpawnItemEx("ASPEconomyStormAlpha", random(512, -512), random(512, -512), 320, 0, 0, random(-24, -32), random(0, 359))
    TNT1 A 1 A_CountDown
    goto Spawn+3
  }
}


actor ASPEconomyStormAlpha : BasicProjectile {
  Translation "192:192=41:41", "198:198=79:79", "0:0=5:5", "247:247=5:5", "202:202=79:79", "199:199=41:41"
  DamageType "ASPGhost"
  Obituary "%o was given insurance by \ctGhost of Speciman\c- (%k)'s \cmEconomic Storm\c-."
  +RIPPER
  +NOINTERACTION
  +DONTREFLECT
  ReactionTime 12
  Damage (0)
  Radius 20
  Height 12
  Scale 4.5
  States {
   Spawn:
    X_8B G 0
    X_8B G 0 A_ChangeVelocity(18, 0, velz, 3)
    X_8B GGGHHHIII 1 A_JumpIf(ceilingz - z > 13, "Spawn2")
    X_8B G 0 A_JumpIf(velz == 0, "Death")
    X_8B G 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B G 0 A_ChangeFlag("RIPPER", 0)
    X_8B G 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B GHI 3 A_ChangeVelocity(18, 0, velz, 3)
    X_8B G 0 A_JumpIf(velz == 0, "Death")
    X_8B G 0 A_CountDown
    goto Spawn2+2
   Death:
    Y_8B A 0 A_PlaySoundEx("E_B/StarStormHit", "Weapon")
    Y_8B A 0  // A_SetGravity(0.0)
    Y_8B A 0 A_Explode(200, 200, 0, 0, 200)
    Y_8B ABCDEF 2
    stop
  }
}

actor GhostF_RageStartHelper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/EnemyTurn", "Voice", 0, 2)
    TNT1 A 10 A_PlaySoundEx("E_B/EnemyTurn", "Weapon", 0, 2)
    stop
  }
}


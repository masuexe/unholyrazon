    TNT1 A 0 A_SpawnItemEx("ASPEconomyStormShockwave", 0, 0, 0, 25, 0, 0, 345)
    TNT1 A 1
    stop
  }
}

actor ASPEconomyStormShockwave : BasicProjectile {
  Translation "192:192=41:41"
  DamageType "ASPGhost"
  Obituary "%o was sent to court by \ctGhost of Speciman\c- (%k)'s \cmCredit-Card Storm\c-."
  +FLOORHUGGER
  +THRUGHOST
  +RIPPER
  +DONTREFLECT
  Damage (80)
  Radius 32
  Height 32
  Speed 25
  Scale 3.5
  States {
   Spawn:
    X_0E T 1
    TNT1 A 20 A_SpawnItemEx("ASPEconomyStormShockwaveFX", -1 * sqrt(velx * velx + vely * vely), 0, 0, velx, vely, velz, 0, 1 + 8)
    stop
  }
}
actor ASPEconomyStormShockwaveFX : ASPEconomyStormShockwave {
  +CLIENTSIDEONLY
  Damage (0)
  States {
   Spawn:
    X_0E T 0
    X_0E T 1 A_FadeOut(0.05)
    wait
  }
}

actor ASPEconomyStormOmegaLeviosaaa : BasicWatcher {
  ReactionTime 10
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("E_B/StarStorm", "Voice", 0, 2)
   Spawn2:
    TNT1 A 0 Radius_Quake(4, 20, 0, 28, 0)
    TNT1 AAAAAAAAA 3 A_SpawnItemEx("ASPEconomyStormOmega", random(1200, -1200), random(1200, -1200), 500, 0, 0, random(-28, -30), random(0, 359))
    TNT1 A 1 A_CountDown
    loop
   Death:
    TNT1 A 10
    TNT1 A 0 A_TakeFromTarget("DecoyFlag1", 1)
    stop
  }
}

actor ASPEconomyStormOmega : BasicProjectile {
  Translation "192:192=41:41", "198:198=79:79", "0:0=5:5", "247:247=5:5", "202:202=79:79", "199:199=41:41"
  DamageType "ASPGhost"
  Obituary "%o was sent to court by \ctGhost of Speciman\c- (%k)'s \cmCredit-Card Storm\c-."
  +RIPPER
  +NOINTERACTION
  +DONTREFLECT
  ReactionTime 100
  Damage (0)
  Radius 32
  Height 16
  Scale 7
  States {
   Spawn:
    X_8B B 0
    X_8B B 0 A_ChangeVelocity(22, 0, velz, 3)
    X_8B GGGHHHIII 1 A_JumpIf(ceilingz - z > 17, "Spawn2")
    X_8B B 0 A_JumpIf(velz == 0, "Death")
    X_8B B 0 A_CountDown
    goto Spawn+2
   Spawn2:
    X_8B G 0 A_ChangeFlag("RIPPER", 0)
    X_8B G 0 A_ChangeFlag("NOINTERACTION", 0)
    X_8B G 0 A_SpawnItemEx("ASPEconomyStormOmegaFX", 0, 0, 16)
    X_8B G 0 A_PlaySoundEx("BUTTSCKS", "Weapon")
    X_8B G 3 A_ChangeVelocity(22, 0, velz, 3)
    X_8B H 0 A_SpawnItemEx("ASPEconomyStormOmegaFX", 0, 0, 16)
    X_8B H 0 A_PlaySoundEx("BUTTSCKS", "Weapon")
    X_8B H 3 A_ChangeVelocity(22, 0, velz, 3)
    X_8B I 0 A_SpawnItemEx("ASPEconomyStormOmegaFX", 0, 0, 16)
    X_8B I 0 A_PlaySoundEx("BUTTSCKS", "Weapon")
    X_8B I 3 A_ChangeVelocity(22, 0, velz, 3)
    X_8B G 0 A_JumpIf(velz == 0, "Death")
    X_8B G 0 A_CountDown
    goto Spawn2+2
   Death:
    Y_8B A 0 A_PlaySoundEx("E_B/StarStormHit", "Weapon")
    Y_8B A 0  // A_SetGravity(0.0)
    Y_8B A 0 A_Explode(350, 256, 0, 0, 32)
    Y_8B A 0 A_SpawnItemEx("ASPEconomyStormShockSpawn")
    Y_8B AABBCCDDEEFF 1 A_SpawnItemEx("ASPEconomyStormOmegaFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25))
    stop
  }
}

actor ASPEconomyStormOmegaFX : BasicGraphicEffect {
  Translation "192:192=41:41", "198:198=79:79"
  Scale 4.5
  States {
   SpawnFrame:
    X_8B ABCDEF 3 A_Fadeout(0.07)
    stop
  }
}

actor ASPEconomyStormOmegaFX2 : BasicGraphicEffect {
  Translation "4:4=79:79", "192:192=5:5", "198:198=41:41"
  ReactionTime 8
  Scale 9.5
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7)
    6P0K E 2 A_FadeOut(0.02)
    6P0K F 0 A_CountDown
    6P0K F 2 A_FadeOut(0.02)
    6P0K G 0 A_CountDown
    6P0K G 2 A_FadeOut(0.02)
    6P0K H 0 A_CountDown
    6P0K H 2 A_FadeOut(0.02)
    6P0K E 0 A_CountDown
    goto Spawn+2
  }
}

actor ASPEconomyStormShockwave : BasicProjectile
{
Translation "192:192=41:41"
damagetype "ASPGhost"
Obituary "%o was sent to court by \ctGhost of Speciman\c- (%k)'s \cmCredit-Card Storm\c-."
+FLOORHUGGER
+THRUGHOST
+RIPPER
+DONTREFLECT
Damage (80)
Radius 32
Height 32
Speed 25
Scale 3.5
States
{
Spawn:
X_0E T 1
TNT1 A 20 A_SpawnItemEx("ASPEconomyStormShockwaveFX",-1*sqrt(momx*momx+momy*momy),0,0,momx,momy,momz,0,1+8)
stop
}
}
actor ASPEconomyStormShockwaveFX : ASPEconomyStormShockwave
{
+CLIENTSIDEONLY
Damage (0)
States
{
Spawn:
X_0E T 0
X_0E T 1 A_FadeOut(0.05)
wait
}
}

actor ASPEconomyStormOmegaLeviosaaa : BasicWatcher
{

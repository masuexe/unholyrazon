TNT1 A 0 A_SpawnItemEx("AstromancerS_ShotA2",2,0,0,15,random(-20,2),random(-4,12),0,1)
TNT1 A 0 A_SpawnItemEx("AstromancerS_ShotA2",2,0,0,15,random(10,40),random(-10,24),0,1)
TNT1 A 0 A_SpawnItemEx("AstromancerS_ShotA2",2,0,0,15,random(-40,-10),random(-10,24),0,1)

actor AstromancerSimple_W_NormalBar : NormalBar {args 64, 62}
actor AstromancerSimple_W_SecondBar : SecondBar {args 62, 161}

actor AstromancerSimple_W : AstromancerComplex_W
{
Tag "$TAG_Boss030_W"
Obituary "%o was broken by \ctAstromancer Crusher\c- (%k)!"
States
{
Spawn:
8H30 [ 1
wait

Deselect:
8H30 A 0
goto DeselectSwap
Select:
8H30 A 0
goto SelectSwap

Ready:
8H30 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H30 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ASTROMANCERSIMPLE_DYE)
8H30 A 3 ACS_NamedExecuteWithResult("uh_BossMorph", 30,2000,235)
goto ReadyX
ReadyX:
8H30 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX2")
8H30 A 2 A_WeaponReady(WRF_NOSECONDARY)
8H30 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX2:
8H30 A 2 A_WeaponReady
8H30 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop


Fire:
8H30 A 0 A_JumpIfInventory("ShieldCheck",1,"SpeedToss")
8H30 A 0 A_JumpIfInventory("UnholyPower1500",1500,"PinpointMeteorAttack")
8H30 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H30 A 0 A_GunFlash
8H30 A 1 A_GiveInventory("ShieldCheck")
Goto ShieldActive
ShieldActive:
8H30 B 0 A_SpawnItemEx("AstromancerShieldWarper",0,0,28,0,0,0,0,1)
8H30 B 2 Offset(18,35)A_GiveInventory("UnholyBossAmmo200",1)
8H30 BCCC 2 Offset(-2,21)A_GiveInventory("UnholyBossAmmo200",1)
Goto Shield
Shield:
8H30 C 2 Offset(-2,21)A_WeaponReady(1)
8H30 C 0 A_GiveInventory("UnholyBossAmmo200",2)
Goto Shield

SpeedToss:
8H30 A 0 A_TakeInventory("ShieldCheck")
8H30 C 5 Offset(-2,21)A_FireCustomMissile("AstromancerS_ShotM",0,0,0,0)
8H30 CB 2
8H30 B 2 Offset(-2,21)
8H30 B 2 Offset(18,35)
8H30 A 7 A_WeaponReady(14)
Goto ReadyX

PinpointMeteorAttack:
8H30 D 2
8H30 EE 2 Offset(-3,30)
8H30 E 0 A_TakeInventory("UnholyPower1500", 1500)
8H30 E 1 Offset(-3,30)A_FireCustomMissile("AstromancerS_Target",0,0,0,0)
8H30 E 2 Offset(-3,30)
8H30 A 5 A_WeaponReady(14)
Goto ReadyX

AltFire:
8H30 A 1 A_JumpIfInventory("UnholyBossAmmo200",200,"StarCRUSH")
Goto ReadyX
StarCRUSH:
8H30 A 0 A_TakeInventory("UnholyBossAmmo200",200)
8H30 A 0 A_TakeInventory("ShieldCheck")
//8H30 A 0 ThrustThingZ(0,25,0,0)
//8H30 A 0 A_Recoil(-60)
8H30 A 0 A_PlaySound("weapon/timestopper",1,1.0)
8H30 D 2 A_FireCustomMissile("AstromancerS_ShotA",0,0,0,0)
8H30 EEE 2 Offset(-3,30)
8H30 D 2 A_WeaponReady(14)
8H30 A 2
Goto ReadyX
}
}

Actor AstromancerS_ShotM : BasicFastProjectile
{
Translation "192:192=62:62","198:198=161:161"
Damagetype "Astromancer"
Obituary "%o was broken by \ctAstromancer Crusher\c- (%k)!"
Damage (225)
Radius 16
Height 16
Speed 90
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,2,3,4)
8P30 ABCD 1
goto Spawn+2
}
}



actor AstromancerS_ShotA2 : BasicProjectile
{
var int user_A;
Translation "192:192=62:62","198:198=161:161" //method of spawning got quick-changed, had to include this  -Zomo
Damagetype "Astromancer"
Obituary "%o was broken by \ctAstromancer Crusher\c- (%k)!"
+THRUGHOST
+NOEXPLODEFLOOR
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
renderstyle translucent
alpha 0.1
Damage (40)
Radius 52
Height 60
Speed 35
Scale 3.0
States
{
Spawn:
X_8B G 0
X_8B G 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
goto Spawn2
Spawn2:
X_8B G 0 A_JumpIfInventory("CutterFlag",8,"SpawnEnd")
X_8B GG 0 A_SpawnItemEx("FlashM_SparkleFX_Base",random(-16,16),random(-16,16),random(-16,16),0,0,0,0,1)
X_8B G 0 A_FadeIn(0.1)
X_8B G 1 A_Recoil(2.5)
X_8B G 0 A_GiveInventory("CutterFlag",1)
loop
SpawnEnd:
X_8B G 0 A_CustomMissile("AstromancerS_ShotA3",0,0,0,2,-pitch)
stop
Death:
TNT1 A 0
TNT1 A 1 A_JumpIfInventory("CutterFlag",4,"Death2")
stop
Death2:
TNT1 A 0 A_PlaySoundEx("weapons/mm8/astrocrushexplode", "Weapon")
TNT1 A 0 A_Explode(220,196,0,0,64)
TNT1 AAAAAAAAAA 1 A_SpawnItemEx("AstromancerS_MeteorFX2",random(-72,72),random(-72,72),random(-72,72),0,0,0,0,1)
stop
}
}


actor SadFaceToadMan : BossBase {
  Player.ScoreIcon "UB104MUG"
  Player.SoundClass "SadFaceToadMan"
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.MaxHealth 3500
  Health 3500
  Player.JumpZ 14
  Player.MorphWeapon "SadFaceToadMan_W"
  States {
   Spawn:
    8B04 A 0
    8B04 B 1
    8B04 A 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 A 4 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    8B04 I 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 I 4 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn+2
   See:
    8B04 B 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 BBBBB 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    8B04 C 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 CCCCC 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    8B04 D 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 DDDDD 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    8B04 E 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 EEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn
   Jumping:
    8B04 C 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 CCCC 1 A_JumpIf(CallACS("core_checkfooting"), "JumpingL")
    8B04 K 0 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    8B04 KKKK 1 A_JumpIf(CallACS("core_checkfooting"), "JumpingL")
    loop
   JumpingL:
    8B04 BBBBB 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    goto Spawn
   Missile:
    8B04 F 0 A_JumpIfInventory("VivifyDelay6", 1, "Missile2")
    8B04 F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile3")
    8B04 J 1
    8B04 F 4
    8B04 G 4
    goto Spawn+2
   Missile2:
    8B04 D 5
    8B04 B 4
    8B04 FFF 1 A_JumpIfInventory("VivifyDelay6", 1, "Missile2X")
    8B04 GGG 1 A_JumpIfInventory("VivifyDelay6", 1, "Missile2X")
    goto Missile2+2
   Missile2X:
    8B04 B 10
    8B04 BBBBBBBB 2 A_JumpIfInventory("VivifyDelay5", 1, "Missile2")
    goto Spawn+2
   Missile3:
    8B04 JB 4
    goto See
   ClassPain:
    8B04 H 0
    goto MegamanPain
   ClassDeath:
    8B04 H 0
    goto MegamanDeath
  }
}

// SovietUnionFrostBite
actor SovietFrostBite : BossBase {
  Player.ScoreIcon "UB014MUG"
  Player.SoundClass "SovietFrostBite"
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 10
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "SovietFrostBite_W"
  States {
   Spawn:
    FREE A 0
    FREE B 1
    FREE A 1
    goto Spawn+2
   See:
    FREE BCDE 5
    goto Spawn
   Missile:
    FREE F 6
    FREE G 6
    goto Spawn+2
   ClassPain:
    FREE I 0
    goto MegamanPain
   ClassDeath:
    FREE H 0
    goto MegamanDeath
  }
}

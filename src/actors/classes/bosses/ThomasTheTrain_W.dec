actor ThomasCoalShot : BasicFastProjectile
{
Damagetype "ThomasTrainFire"
Obituary "%o learned that \cnThomas (%k) is everywhere."
+THRUGHOST
+SKYEXPLODE
+EXPLODEONWATER
MissileType "ThomasCoalShotFX1"
reactiontime 5
damage (100)
radius 8
height 16
speed 1000
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_CountDown
loop
Death:
TNT1 A 0 A_JumpIf(z-ceilingz==0-16, "Ceiling")
TNT1 A 0 A_SpawnItemEx("ThomasCoalSpawner",0,0,0,0,0,0)
stop
Ceiling:
TNT1 A 0 A_SpawnItemEx("ThomasCoalSpawner",0,0,-16,0,0,0)
stop
}
}


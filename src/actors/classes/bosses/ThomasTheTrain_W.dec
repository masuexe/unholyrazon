9H19 D 0 A_ChangeVelocity(cos(pitch)*37,0,-sin(pitch)*37,3)
9H19 D 2 Offset(-2,70)A_FireCustomMissile("ThomasDamagerRam3",0,0,0,0)
9H19 D 0 A_TakeInventory("UnholyPower1500",10)
9H19 D 0 A_GiveInventory("ThomasTheTrainFlag",1)
9H19 D 0 A_GiveInventory("UnholyBossAmmo200",2)
9H19 D 0 A_JumpIfInventory("UnholyPower1500",1,1)
goto RepairTheTrain
9H19 D 0 A_Refire("FlyingTrain")
9H19 D 0 A_TakeInventory("ThomasTheTrainFlag", 1)
goto ReadyAlt
ReadyAlt:
9H19 C 0 A_ScaleVelocity(0.65)
9H19 C 2 Offset(-2,38)A_WeaponReady(5)
9H19 C 0 A_GiveInventory("ThomasBoosterFX_P")
9H19 C 0 A_GiveInventory("UnholyBossAmmo200",6)
9H19 C 0 A_TakeInventory("UnholyPower1500",5)
9H19 C 0 A_JumpIfInventory("UnholyPower1500",1,"ReadyAlt")
goto RepairTheTrain
RepairTheTrain:
9H19 B 0 //A_PlaySoundEx("wep/RDeath","Weapon")
9H19 B 0 A_TakeInventory("DecoyFlag1")
9H19 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
9H19 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
9H19 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
9H19 C 2 Offset(-6,41)
9H19 C 2 Offset(-10,45)A_TakeInventory("UnholyPowerDazzle_F")
9H19 B 2 Offset(14,4)
9H19 B 2 Offset(8,20)
9H19 A 1 Offset(3,27)
Goto ReadyX
}
}


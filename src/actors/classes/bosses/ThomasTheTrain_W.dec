9H19 B 0 A_ChangeVelocity(38,0,-100,3)
9H19 B 2 Offset(5,39)A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 Offset(8,45)A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 Offset(10,52)A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 Offset(11,56)A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)

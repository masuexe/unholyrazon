9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 A_ChangeVelocity(7,0,0,1)
9H19 B 2 A_SpawnItemEx("ThomasDamagerHelper",0,0,28,momx,momy,momz,0,8)
9H19 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
9H19 A 2 Offset(8,52)
9H19 A 2 Offset(6,47)
9H19 A 2 Offset(4,42)
9H19 A 2 Offset(2,37)
9H19 A 0 A_WeaponReady(14)
9H19 A 4
9H19 B 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
9H19 AAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200",1)
goto ReadyX

AltFire:
9H19 A 0 A_JumpIfInventory("DecoyFlag1",1,"FlyingTrain")
9H19 A 0 A_JumpIfInventory("UnholyPower1500",1500,"StockUpSomeCoal")
goto ReadyX
StockUpSomeCoal:
9H19 B 0 A_GiveInventory("UnholyPowerDazzle_F")
9H19 B 0 A_GiveInventory("DecoyFlag1")
9H19 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
9H19 B 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)

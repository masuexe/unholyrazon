9H19 D 0 A_ChangeVelocity(cos(pitch)*37,0,-sin(pitch)*37,3)
9H19 D 2 Offset(-2,70)A_FireCustomMissile("ThomasDamagerRam1",0,0,0,0)
goto FlyingTrain3+2
FlyingTrain2:
9H19 D 0 A_ChangeVelocity(cos(pitch)*37,0,-sin(pitch)*37,3)
9H19 D 2 Offset(-2,70)A_FireCustomMissile("ThomasDamagerRam2",0,0,0,0)
goto FlyingTrain3+2

actor ThomasTheTrain_W : BaseUnholyBossWep
{
Tag "$TAG_Boss519_W"
Obituary "%o suffered a heart attack from \cnThomas the Tank Engine\c- (%k)'s stare."
Inventory.Pickupmessage "Thomas was everywhere."
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
9H19 [ 1
wait

Deselect:
9H19 A 0
goto DeselectSwap
Select:
9H19 A 0
goto SelectSwap

Ready:
9H19 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
9H19 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, THOMASTHETRAIN_DYE)
9H19 A 0 A_SpawnItem("ThomasSteamFX_H")
9H19 A 6
Goto ReadyX
ReadyX:
9H19 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyX2")
9H19 A 2 A_GiveInventory("ThomasTheTrain_Ready8_P")
loop
ReadyX2:
9H19 A 2 A_GiveInventory("ThomasTheTrain_Ready0_P")
loop

Reload:
9H19 A 0 A_JumpIfInventory("UnholyBossAmmo200", 100, "CoalShot")
goto ReadyX
CoalShot:
9H19 A 0 A_TakeInventory("UnholyBossAmmo200",100)
9H19 A 0 A_PlaySoundEx("weapon/ChooChoo","Weapon")
9H19 A 2 A_FireCustomMissile("ThomasCoalShot",0,0,0,0)
9H19 A 1
goto ReadyX

Fire:
9H19 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
9H19 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
9H19 A 0 A_GiveInventory("VivifyDelay8")
9H19 A 0 A_Refire(1)

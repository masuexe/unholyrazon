actor SPOOKYGHOSTHITLER : BossBase {
  Player.ScoreIcon "UB403MUG"
  Player.SoundClass "SPOOKYGHOSTHITLER"
  Player.DamageScreenColor "white"
  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.JumpZ 9
  Player.MaxHealth 1945
  Health 1945
  RenderStyle "Add"
  Alpha 0.8
  Gravity 3.0
  MaxStepHeight 128  // 24
  MaxDropOffHeight 128  // 24
  Player.MorphWeapon "SPOOKYGHOSTHITLER_W"
  +BRIGHT
  States {
   Spawn:
    8E03 A 0
    8E03 A 0  // SetPlayerProperty (0, 1, 3)
    8E03 A 1
    goto Spawn+2
   See:
    8E03 A 0 A_PlaySoundEx("class/HitlerMove", "Auto")
    8E03 A 16  // 16
    goto Spawn+2
   Missile:
    8E03 A 50
    8E03 A 8
    goto Spawn
   ClassPain:
    8E03 A 0  // A_PlaySoundEx("misc/devilpain","Voice")//A_PlaySound("misc/DMGHIGLUR")
    8E03 AAAAAAAAAA 2 A_SpawnItemEx("PainFX", 0, 3)
    goto Spawn
    // Goto MegamanPain
   ClassDeath:
    8E03 A 0
    goto MegamanDeath
  }
}

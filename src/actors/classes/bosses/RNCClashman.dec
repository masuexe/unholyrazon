actor RNCClashman : BossBase {
  Player.ScoreIcon "UB017MUG"
  Player.SoundClass "RNCClashman"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 14
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "RNCClashman_W"
  States {
   Spawn:
    8A17 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEOFF_NONE, 0)
    8A17 B 1
    8A17 A 1
    goto Spawn+2
   See:
    8A17 BCDE 5
    goto Spawn
   Missile:
    8A17 F 5
    8A17 G 4
    goto Spawn+2
   ClassPain:
    8A17 H 0
    goto MegamanPain
   ClassDeath:
    8A17 H 0 A_GiveInventory("RNCStealthBreak_P")
    goto MegamanDeath
  }
}

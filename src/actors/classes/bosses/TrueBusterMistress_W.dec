actor TrueBusterMistress_W_NormalBar : NormalBar {args 120, 127}
actor TrueBusterMistress_W_ReloadIcon : ReloadIcon {Tag "R025B0"}

actor TrueBusterMistress_W : BaseUnholyBossWep {
  Tag "$TAG_TrueBusterMistress_W"
  Obituary "%o was greatly seduced by \cmTrue \cuBusterMistress\c- (%k)."
  Weapon.AmmoType "UnholyBossAmmo200"
  States {
   Spawn:
    8H25 [ 1
    wait

   Deselect:
    8H25 A 0
    goto DeselectSwap
   Select:
    8H25 A 0
    goto SelectSwap

   Ready:
    8H25 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, TRUEBUSTERMISTRESS_DYE)
    goto ReadyX
   ReadyX:
    8H25 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX2")
    8H25 A 2 A_GiveInventory("TrueBusterMistress_Ready8_P")
    loop
   ReadyX2:
    8H25 A 2 A_GiveInventory("TrueBusterMistress_Ready0_P")
    loop

   Fire:
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 BCB 3 A_GiveInventory("UnholyBossAmmo200", 1)
    8H25 A 0 A_FireCustomMissile("TrueMistressCopyVisionSpawnerFAST", 0, 0, 0, 0, 0, 0)  // A_Gunflash
    8H25 AAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
    goto ReadyX

   AltFire:
    8H25 A 1 A_JumpIfInventory("UnholyBossAmmo200", 200, "VamosMiSenora")
    goto ReadyX
   VamosMiSenora:
    8H25 A 0 A_GiveInventory("DecoyFlag2")
    8H25 A 0 A_GiveInventory("TrueBusterMistress_BasicArmor_P")
    8H25 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8H25 A 0 A_Stop
    8H25 A 0 ThrustThingZ(0, 60, 0, 0)
    8H25 A 5
    8H25 A 0 A_FireCustomMissile("TrueMistressCopyVisionSpawnerA", 0, 0, 0, 0, 0, 0)
    8H25 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8H25 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8H25 A 0 A_Stop
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 6
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 6
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 6
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 6
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 6
    8H25 B 4
    8H25 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H25 A 0 A_FireCustomMissile("TrueMistressShot", 0, 0, 8, 0)
    8H25 CB 4
    8H25 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H25 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H25 A 0 A_TakeInventory("DecoyFlag2")
    8H25 A 0 A_TakeInventory("BasicArmor")
    8H25 A 16
    goto ReadyX

   Reload:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "MistressBossItemA")
    goto ReadyX
   MistressBossItemA:
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    TNT1 A 0 A_GiveInventory("MistressInvisPower")
    TNT1 A 0 A_CustomMissile("TrueMistressCopyVisionEX", 0, 0, 0, 2, 0)  // A_GiveInventory("MistressBossItemFlagA",1)
    8H25 A 1
    goto ReadyX
  }
}

actor MistressInvisPower : PowerInvisibility {
  +CANTSEEK
  Powerup.Mode "Translucent"
  Powerup.Strength 100
  Powerup.Duration 95
  +INVENTORY.ALWAYSPICKUP
}

actor TrueBusterMistress_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor TrueBusterMistress_Ready8_P : TrueBusterMistress_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor TrueMistressShot : BasicProjectile {
  Translation "198:198=120:120", "192:192=116:116", "202:202=4:4", "199:199=120:120"
  DamageType "TrueMistress"
  Obituary "%o was greatly seduced by \cmTrue \cuBusterMistress\c- (%k)."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (95)
  Radius 12
  Height 12
  Speed 65
  Scale 2.5
  States {
   Spawn:
    X_0A ABCBC 2 A_SpawnItemEx("MissShotFX", 0, 0, 0, 4, 0, 0, random(-1, 1) * 55, 1)
    Y_0A B 2 A_SpawnItemEx("MissShotFX", 0, 0, 0, 4, 0, 0, random(-1, 1) * 55, 1)
    X_0A CBCB 2 A_SpawnItemEx("MissShotFX", 0, 0, 0, 4, 0, 0, random(-1, 1) * 55, 1)
    Y_0A C 2 A_SpawnItemEx("MissShotFX", 0, 0, 0, 4, 0, 0, random(-1, 1) * 55, 1)
    goto Spawn+1
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    TNT1 A 0 A_Explode(80, 108, 0, 0, 14)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor TrueMissShotFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    UMFX BBCD 2 A_Fadeout
    stop
  }
}

actor TrueMistressCopyVisionSpawnerA : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("TrueMistressCopyVision", 0, 38, -32, 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("TrueMistressCopyVision", 0, -38, -32, 0, 0, 0, 0, 0, 0)
    stop
  }
}

actor TrueMistressCopyVisionSpawnerFAST : TrueMistressCopyVisionSpawnerA {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("TrueMistressCopyVisionFAST", 0, 0, -32, 0, 0, 0, 0, 0, 0)
    stop
  }
}

actor TrueMistressCopyVision : BasicProjectile {
  Translation "192:192=135:135", "198:198=126:126", "168:168=126:126", "0:8=120:120", "247:247=120:120", "210:210=135:135", "183:183=135:135"
  +THRUGHOST
  +RIPPER
  +NOCLIP
  +DONTBLAST
  RenderStyle "Translucent"
  Alpha 0.70
  ReactionTime 6
  Health 9999
  Damage (0)
  Radius 32
  Height 32
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/copyvision", "weapon")
    TNT1 A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
    8A25 A 2
    TNT1 A 2
    goto Shooting
   Shooting:
    8A25 F 2 A_GiveToTarget("UH_TargetMarker", 1)
    8A25 F 2 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget") + PLN_TARGETPOINT_OFFSET, 32)
    8A25 F 0 A_PlaySoundEx("weapon/minchrgshot", "Body")
    8A25 F 1 A_CustomMissile("TrueMistressCopyShot", 32, 0, Random(-2, 2), 2, -pitch)
    8A25 F 13
    8A25 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    8A25 F 0 A_Countdown
    loop
   Death:
    8A25 FFF 3 A_Fadeout
    stop
  }
}

actor TrueMistressCopyVisionFAST : TrueMistressCopyVision {
  ReactionTime 1
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
    8A25 A 2
    goto Shooting
   Shooting:
    8A25 F 1 A_GiveToTarget("UH_TargetMarker", 1)
    8A25 F 1 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget") + PLN_TARGETPOINT_OFFSET, 32)
    8A25 F 0 A_PlaySoundEx("weapon/minchrgshot", "Body")
    8A25 F 1 A_CustomMissile("TrueMistressCopyShot", 32, 0, Random(-1, 1), 2, -pitch)
    8A25 F 10
    8A25 F 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    8A25 F 0 A_Countdown
    loop
   Death:
    8A25 FFF 3 A_Fadeout
    stop
  }
}

actor TrueMistressCopyShot : TrueMistressShot {
  Obituary "%o fell in love with \cmTrue \cuBusterMistress\c- (%k)'s Double."
}

actor MistressUPPERCUTATTACK : BasicProjectile {
  Translation "192:192=120:120", "198:198=127:127"
  DamageType "TrueMistress"
  Obituary "%o fell in love with \cmTrue \cuBusterMistress\c- (%k)'s Double."
  +RIPPER
  Damage (25)
  Radius 50
  Height 50
  Speed 30
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TMFX ABCD 1 A_Explode(65, 65, 0)
    stop
  }
}

actor MistressUPPERCUTWind : BasicProjectile {
  DamageType "TrueMistressUpper"
  Obituary "%o fell in love with \cmTrue \cuBusterMistress\c- (%k)'s Double."
  +RIPPER
  +DONTSPLASH
  +DONTBLAST
  +THRUGHOST
  +DONTREFLECT
  Damage (75)
  Radius 120
  Height 100
  Speed 0

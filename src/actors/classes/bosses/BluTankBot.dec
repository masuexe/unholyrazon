// Dragoon Tank
actor BluTankBot : BossBase {
  Player.ScoreIcon "UB036MUG"
  Player.SoundClass "BluTankBot"
  Player.DamageScreenColor "blue"
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 12  // 10
  Player.MaxHealth 3750
  Health 3750
  Player.MorphWeapon "BluTankBot_W"
  States {
   Spawn:
    8A36 A 0
    8A36 B 1
    8A36 A 1
    goto Spawn+2
   See:
    8A36 BCDE 5
    goto Spawn
   Missile:
    8A36 F 5
    8A36 G 4
    goto Spawn+2
   ClassPain:
    8A36 H 0
    goto MegamanPain
   ClassDeath:
    8A36 H 0
    goto MegamanDeath
  }
}

actor RepairManEdward : BossBase {
  Player.ScoreIcon "UB016MUG"
  Player.SoundClass "RepairManEdward"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 10
  Player.MaxHealth 2100
  Health 2100
  Player.MorphWeapon "RepairManEdward_W"
  States {
   Spawn:
    ELEC A 0
    ELEC B 1
    ELEC A 1
    goto Spawn+2
   See:
    ELEC BCDE 5
    goto Spawn
   Missile:
    ELEC F 0 A_JumpIfInventory("VivifyDelay10", 1, "Missile_GetAway")
    ELEC F 11
    ELEC G 24
    goto Spawn+2
   Missile_GetAway:
    ELEC F 19
    ELEC G 4
    goto Spawn+2
   ClassPain:
    ELEC H 0
    goto MegamanPain
   ClassDeath:
    ELEC H 0
    goto MegamanDeath
  }
}

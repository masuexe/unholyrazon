actor EyelentoMajor : BossBase {
  Player.ScoreIcon "UB401MUG"
  Player.SoundClass "EyelentoMajor"
  Player.ForwardMove 1.44, 1.44  // 1.16
  Player.SideMove 1.44, 1.44  // 1.16
  Player.MaxHealth 6000
  Health 6000
  Player.JumpZ 16  // 14
  Player.MorphWeapon "EyelentoMajor_W"
  damagefactor "Foxeye", 0.34
  damagefactor "MajorGasm", 0.0
  States {
   Spawn:
    8E01 A 0
    8E01 B 1
    8E01 A 1
    goto Spawn+2
   See:
    8E01 BCDE 5
    goto Spawn
   Missile:
    8E01 F 5 A_JumpIfInventory("EyelentoMajorFlag", 1, "Missile2")
    8E01 G 4
    goto Spawn+2
   MissileSpinWait:
    8E01 CCCCCC 1 A_JumpIfInventory("VivifyDelay3", 1, "MissileSpin")
   MissileSpin:
    8E01 IJIJIJIJIJIJ 1
    goto Spawn+2
   Missile2:
    8E01 IJ 1 A_JumpIfInventory("VivifyDelay5", 1, "Spawn")
    loop
   ClassPain:
    8E01 H 0 A_JumpIfInventory("EyelentoMajorFlag", 1, "Missile2")
    goto MegamanPain
   ClassDeath:
    8E01 H 0
    goto MegamanDeath
  }
}

actor CuttyCut_W : BaseUnholyBossWep
{
Tag "$TAG_Boss026_W"
Obituary "%o cut up by \caCutty Cut\c- (%k)."
Inventory.Pickupmessage "\cjCome on! Come on! Yay!"
weapon.ammotype "PaperDollsAmmo"
States
{
Spawn:
    8H26 [ 1
wait

Deselect:
    8H26 I 0
    goto DeselectSwap
Select:
    8H26 I 0
    goto SelectSwap

Ready:
    8H26 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, CUTTYCUT_DYE)
    // uh_BossMorph via mainBossHP; ExtraLife: morphActorToBoss case 26 (Ready may re-enter online)
    8H26 A 0 A_TakeInventory("IsPissedFlag")
    8H26 A 0 A_TakeInventory("IsPissedFlag2")
    8H26 A 0 A_GiveInventory("CutterReturned")
    8H26 A 0 A_GunFlash("Flash", true)
    goto ReadyX

ReadyX:
    8H26 A 1 A_WeaponReady
    loop

Flash:
    TNT1 A 1 A_GiveInventory("CuttyCutHealthCheck_P")
    loop

Fire:
    8H26 A 0 //A_JumpIfInventory("IsBot",1,"BotFire")
    8H26 A 0 A_FireCustomMissile("CuttyCutShot",0,0,8,0)
    8H26 B 2 A_GiveInventory("CuttyCutNoCutterF",1)
    8H26 B 2 Offset(-70,42)A_TakeInventory("CutterReturned")
    8H26 B 2 Offset(-121,114)
    8H26 C 2 Offset(1,32)
    8H26 C 2 Offset(-21,56)
    8H26 C 2 Offset(-33,84)
    TNT1 A 4
    TNT1 A 0 //A_JumpIfInventory("IsBot",1,"BotFire3")
    TNT1 A 12 Offset(1,32)
    goto FireWait

FireWait:
    TNT1 A 0 A_JumpIfInventory("RollingCutterFlag",1,"FireEnd")
    TNT1 A 1 A_GiveInventory("CutterFlag",1)
    TNT1 A 0 A_JumpIfInventory("CutterFlag",35,"FireEnd")
    loop
FireEnd:
    TNT1 A 0 //A_PlaySoundEx("weapon/CutterCatch","Weapon")
    8H26 D 2 Offset(-26,146)
    8H26 D 2 Offset(-4,95)A_GiveInventory("CutterReturned",1)
    8H26 D 2 Offset(1,32)A_TakeInventory("CuttyCutNoCutterF")
    TNT1 A 2 A_TakeInventory("RollingCutterFlag")
    TNT1 A 2 A_TakeInventory("CutterFlag")
    TNT1 A 2
    TNT1 A 8
    8H26 A 2 Offset(28,80)
    8H26 A 2 Offset(16,60)
    goto ReadyX

Altfire:
    8H26 A 0 A_PlaySoundEx("weapon/CutMelee","weapon")
    8H26 D 1 //A_FireCustomMissile("CuttyCutMelee",-40,0,16,16,0,10)
    8H26 D 1 offset(-9,59)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 D 1 offset(-20,96) A_FireCustomMissile("CuttyCutMelee",-25,0,8,10,0,5)
    8H26 D 1 offset(-33,119)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 D 1 offset(-48,147) A_FireCustomMissile("CuttyCutMelee",-10,0,0,4,0,0)
    8H26 D 1 offset(-65,180)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 D 1 offset(-83,220) A_FireCustomMissile("CuttyCutMelee",5,0,-2,-2,0,-5)
    8H26 D 1 offset(-102,241)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 D 1 offset(-122,276) A_FireCustomMissile("CuttyCutMelee",15,0,-8,-6,0,-10)
    8H26 D 1 offset(-143,291)A_JumpIfInventory("PlayerPropertyRage",1,1)
    TNT1 A 2
    8H26 A 1 offset(-64,89)
    8H26 A 1 offset(-50,77)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 A 1 offset(-36,66)
    8H26 A 1 offset(-24,56)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 A 1 offset(-14,47)
    8H26 A 1 offset(-6,39)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 A 0
// 8H26 A 0 A_JumpIfInventory("IsBot",1,"BotAltFire2")
    goto ReadyX
  }
}

actor CuttyCut_W_Pissed1 : CuttyCut_W {
  States {
   Ready:
    // Online can re-enter Ready after ComeOn; GetUp/ComeOn only once per phase weapon
    8H26 A 0 A_JumpIfInventory("CuttyCutGetUpDone_F",1,"ReadyAfterGetUp")
    8H26 A 0 A_GiveInventory("CuttyCutGetUpDone_F")
    8H26 A 0 A_WeaponReady(14)
    8H26 A 0 A_GiveInventory("CuttyCutPainFlag")
    8H26 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    8H26 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)//
    8H26 A 0 A_PlaySoundEx("weapon/SumoFall","Weapon")
    8H26 A 0 A_Stop
    8H26 A 0 ThrustThingZ(0,35,0,0)
    8H26 A 0 ThrustThing(random(0,255),40,1,0)
    8H26 A 0 A_JumpIf(true, "GetUp")
    goto GetUp
   ReadyAfterGetUp:
    8H26 E 0 A_GunFlash("Flash", true)
    goto ReadyX
   GetUp:
    8H26 A 2 Offset(-1,34) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-1,38) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-1,42) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-1,46) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-1,50) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-2,54) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-2,58) A_SetAngle(angle-20.0)
    8H26 A 0 A_PlaySoundEx("weapon/SumoFall","Weapon")
    8H26 A 0 A_Stop
    8H26 A 0 ThrustThing(random(0,255),40,1,0)
    8H26 A 2 Offset(-2,62) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-2,66) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-2,70) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-3,74) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-3,78) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-3,82) A_SetAngle(angle+20.0)
    8H26 A 2 Offset(-3,86) A_SetAngle(angle+20.0)
    8H26 A 0 A_PlaySoundEx("weapon/SumoFall","Weapon")
    8H26 A 0 A_Stop
    8H26 A 0 ThrustThing(random(0,255),40,1,0)
    8H26 A 2 Offset(-3,90) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-4,94) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-4,98) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-4,102) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-4,106) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-4,110) A_SetAngle(angle-20.0)
    8H26 A 2 Offset(-5,114) A_SetAngle(angle-20.0)
    goto GetUpEnd
   GetUpEnd:
    TNT1 A 0 A_ScaleVelocity(0.5)
    TNT1 A 0 A_TakeInventory("CuttyCutPainFlag")
    TNT1 A 0 A_GiveInventory("CuttyCutPainFlag2")
    TNT1 A 20 A_PlaySoundEx("weapon/SumoHit","Weapon")
    TNT1 A 100 //280
    TNT1 A 0 A_TakeInventory("CutterFlag")
    TNT1 AAA 2
    TNT1 A 0 A_Stop
    goto ComeOn
   ComeOn:
    TNT1 A 0 A_GiveInventory("CuttyCutHealthGiver")
    TNT1 A 0 A_PlaySound("item/energyup")
    TNT1 A 1 A_JumpIfInventory("CuttyCutIsHealed",1,"ComeOnEnd")
    TNT1 A 0 A_GiveInventory("CuttyCutHealthGiver")
    TNT1 A 0 A_PlaySound("item/energyup")
    TNT1 A 1 A_JumpIfInventory("CuttyCutIsHealed",1,"ComeOnEnd")
    loop
   ComeOnEnd:
    8H26 A 0 A_TakeInventory("CuttyCutIsHealed")
    8H26 A 0 A_TakeInventory("CuttyCutPainFlag2")
    8H26 A 0 A_JumpIf(true, "ComeOnEndX")
    goto ComeOnEndX
   ComeOnEndX:
    8H26 H 2 Offset(-44,146)ACS_NamedExecuteWithResult("core_chargecolor", CUTTYCUT_DYE)
    8H26 H 2 Offset(-4,95)ACS_NamedExecuteWithResult("core_chargecolor", CLR_SCREWCRUSHER)
    8H26 H 2 Offset(2,34)ACS_NamedExecuteWithResult("core_chargecolor", CUTTYCUT_DYE)
    8H26 E 2 Offset(-4,69)ACS_NamedExecuteWithResult("core_chargecolor", CLR_SCREWCRUSHER)
    8H26 E 2 Offset(2,48)ACS_NamedExecuteWithResult("core_chargecolor", CUTTYCUT_DYE)
    8H26 E 0 A_GiveInventory("CuttyCutExit_P")
    8H26 E 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)//
    8H26 E 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    8H26 E 0 A_GiveInventory("IsPissedFlag")
    8H26 I 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
    8H26 I 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,26,0)
    8H26 E 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_SCREWCRUSHER)
    8H26 E 0 A_GunFlash("Flash", true)
    goto ReadyX

   ReadyX:
    8H26 E 1 A_WeaponReady
    loop
   Fire:
    8H26 E 0 //A_JumpIfInventory("IsBot",1,"BotFire")
    8H26 E 0 A_FireCustomMissile("CuttyCutShot2",0,0,8,0)
    8H26 F 2 A_GiveInventory("CuttyCutNoCutterF",1)
    8H26 F 2 Offset(-70,42)A_TakeInventory("CutterReturned")
    8H26 F 2 Offset(-121,114)
    8H26 G 2 Offset(1,32)
    8H26 G 2 Offset(-21,56)
    8H26 G 2 Offset(-33,84)
    TNT1 A 4
    TNT1 A 0 //A_JumpIfInventory("IsBot",1,"BotFire3")
    TNT1 A 12 Offset(1,32)
    goto FireWait
   FireEnd:
    8H26 H 2 Offset(-26,146)
    8H26 H 2 Offset(-4,95)A_GiveInventory("CutterReturned",1)
    8H26 H 2 Offset(1,32)A_TakeInventory("CuttyCutNoCutterF")
    TNT1 A 2 A_TakeInventory("RollingCutterFlag")
    TNT1 A 2 A_TakeInventory("CutterFlag")
    TNT1 A 2
    TNT1 A 8
    8H26 E 2 Offset(28,80)
    8H26 E 2 Offset(16,60)
    goto ReadyX
   Altfire:
    8H26 H 0 A_PlaySoundEx("weapon/CutMelee","Weapon")
    8H26 H 1 //A_FireCustomMissile("CuttyCutMelee",-40,0,16,16,0,10)
    8H26 H 1 offset(-9,59)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 H 1 offset(-20,96) A_FireCustomMissile("CuttyCutMeleeX",-25,0,8,10,0,5)
    8H26 H 1 offset(-33,119)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 H 1 offset(-48,147) A_FireCustomMissile("CuttyCutMeleeX",-10,0,0,4,0,0)
    8H26 H 1 offset(-65,180)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 H 1 offset(-83,220) A_FireCustomMissile("CuttyCutMeleeX",5,0,-2,-2,0,-5)
    8H26 H 1 offset(-102,241)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 H 1 offset(-122,276) A_FireCustomMissile("CuttyCutMeleeX",15,0,-8,-6,0,-10)
    8H26 H 1 offset(-143,291)A_JumpIfInventory("PlayerPropertyRage",1,1)
    // 8H26 E 1 offset(-64,89)
    // 8H26 E 1 offset(-50,77)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 E 1 offset(-36,66)
    8H26 E 1 offset(-24,56)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 E 1 offset(-14,47)
    8H26 E 1 offset(-6,39)A_JumpIfInventory("PlayerPropertyRage",1,1)
    8H26 E 0
    // 8H26 E 0 A_JumpIfInventory("IsBot",1,"BotAltFire2")
    goto ReadyX
  }
}

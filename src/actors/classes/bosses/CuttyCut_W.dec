// Stoneman-style: Flash polls HP; swap to next phase weapon (no Fire-frame HealthLower)
actor CuttyCutHealthCheck_P : CustomInventory {
  States {
Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2,1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("CuttyCut_W_Pissed2",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("CuttyCutPainFlag",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("CuttyCutPainFlag2",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("CuttyCut_W_Pissed1",1,"Swap2")
    TNT1 A 0 A_GiveInventory("CuttyCutSwapPissed1_P")
    stop
Swap2:
    TNT1 A 0 A_GiveInventory("CuttyCutSwapPissed2_P")
    stop
NoSwap:
    TNT1 A 0
    stop
  }
}

actor CuttyCutSwapPissed1_P : CustomInventory
{
States
{
Pickup:
    TNT1 A 0 A_TakeInventory("CuttyCutGetUpDone_F")
    TNT1 A 0 A_GiveInventory("CuttyCut_W_Pissed1")
    TNT1 A 0 A_TakeInventory("CuttyCut_W")
    stop
}
}

actor CuttyCutSwapPissed2_P : CustomInventory
{
States
{
Pickup:
    TNT1 A 0 A_TakeInventory("CuttyCutGetUpDone_F")
    TNT1 A 0 A_GiveInventory("CuttyCut_W_Pissed2")
    TNT1 A 0 A_TakeInventory("CuttyCut_W_Pissed1")
    stop
}
}

actor CuttyCutGetUpDone_F : UOnce {}

actor PaperDollsAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 3
+INVENTORY.IGNORESKILL
}

actor CuttyCutIsHealed : UOnce {}

actor CuttyCutPainFlag : UOnce {}
actor CuttyCutPainFlag2 : UOnce {}

actor CutterDisappearFlag : UOnce {}

actor CutterReturned : UOnce {}

actor CuttyCutNoCutterF : UOnce {}

actor CuttyCutExit_P : CustomInventory
{
Tag "GET BACK TO YOUR CORNER"
inventory.pickupmessage "10, 9, 8, 7, 6, 5, 4, 3, 2, 2, 2, 2, 2, 2..."
states
{
Pickup:
    TNT1 A 0 A_GiveInventory("PowerGauntletExitSpeed",1)
    TNT1 A 0 A_SpawnItemEx("GauntletExitSnd_H",0,0,28)
    TNT1 A 0 A_PlaySoundEx("GNT/ExitUse","SoundSlot6")
stop
}
}

actor CuttyCutHealthGiver : CustomInventory
{
States
{
Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.75,"GiveHealth")
    goto Pickup3
GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 25)
stop
Pickup3:
    TNT1 A 0 A_GiveInventory("CuttyCutIsHealed")
stop
}
}

actor CuttyCutShot : BasicProjectile
{
translation "198:198=4:4"
damagetype "CuttyCut"
Obituary "%o was knocked down by \caCutty Cut\c- (%k)."
+HEXENBOUNCE
+RIPPER
+NOTARGETSWITCH
+SKYEXPLODE
+CANBOUNCEWATER
+DONTREFLECT
bouncefactor 1.0
wallbouncefactor 1.0
Damage (random(10,20))
Radius 9
Height 9
speed 36
scale 2.5
states
{
Spawn:
8P26 A 0
8P26 A 0 A_PlaySound("wep_L/mm1/rollingcutterfly",1)
8P26 AAAABBBBCCCCDDDD 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 A 0 A_TakeFromTarget("CutterFlag")
8P26 A 0 A_PlaySound("wep_L/mm1/rollingcutterfly",1)
8P26 AAAABBBBCCCCDDDD 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
8P26 A 0 A_SpawnItemEx("CuttyCutShotR",0,0,0,0,0,0,0,1)
stop
Death:
8P26 A 0
stop
DeathU:
    TNT1 A 0 A_GiveToTarget("RollingCutterFlag",1)
    TNT1 A 1 A_PlaySoundEx("weapon/CutterCatch","Weapon")
stop
}
}

actor CuttyCutShotD : BasicProjectile
{
damagetype "CuttyCut"
Obituary "%o was knocked down by \caCutty Cut\c- (%k)."
+RIPPER
+DONTBLAST
+THRUGHOST
Damage (random(80,120))
radius 16
height 16
States
{
Spawn:
    TNT1 A 2
stop
}
}

actor CuttyCutShotR : CuttyCutShot
{
+NOINTERACTION
+SEEKERMISSILE
ReactionTime 100
States
{
Spawn:
8P26 A 0
8P26 A 0 A_RearrangePointers(AAPTR_DEFAULT,AAPTR_DEFAULT,AAPTR_TARGET)//Target >> Tracer
8P26 A 0 A_FaceTarget
    goto Spawn2
Spawn2:
8P26 A 0 A_TakeFromTarget("CutterFlag")
8P26 A 0 A_JumpIfCloser(68,"DeathU")
8P26 AA 0 A_SeekerMissile(90,90,SMF_PRECISE)
8P26 A 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 A 0 A_JumpIfCloser(68,"DeathU")
8P26 A 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 A 0 A_JumpIfCloser(68,"DeathU")
8P26 A 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 A 0 A_JumpIfCloser(68,"DeathU")
8P26 A 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)

8P26 B 0 A_JumpIfCloser(68,"DeathU")
8P26 BB 0 A_SeekerMissile(90,90,SMF_PRECISE)
8P26 B 1 A_SpawnItemEx("CuttyCutShotD",0,0,0,momx,momy,momz,0,8,0)
8P26 B 0 A_JumpIfCloser(68,"DeathU")

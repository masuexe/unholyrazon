actor CuttyCutShot3X : BasicProjectile
{
+DONTBLAST
+THRUGHOST
+SKYEXPLODE
+EXPLODEONWATER
+DONTREFLECT
damagetype "CuttyCut"
Obituary "%o was knocked down by \caCutty Cut\c- (%k)."
Damage(random(150,200))
Speed 1
Radius 12
Height 12
scale 3.5
States
{
Spawn:
    TNT1 A 0
    TNT1 A 1 A_Jump(256,"AA","BB","CC","DD")
AA:
8P26 A 2100
8P26 A 2 A_Fadeout
    goto AA+1
BB:
8P26 B 2100
8P26 B 2 A_Fadeout
    goto BB+1
CC:
8P26 C 2100
8P26 C 2 A_Fadeout
    goto CC+1
DD:
8P26 D 2100
8P26 D 2 A_Fadeout
    goto DD+1
}
}

actor CuttyCutMelee : BasicProjectile
{
Translation "202:202=90:90", "4:4=208:208"
damagetype "CuttyCut"
Obituary "%o knocked down by \caCutty Cut\c- (%k)."
+THRUGHOST
+DONTBLAST
+RIPPER
+NOEXPLODEFLOOR
Damage (1)
Radius 5
Height 5
speed 40
scale 3.0
Args 35,52,26
States
{
Spawn://Y_7F CCDD 1
PLUH Q 1
PLUH R 1 A_Explode(Args[0],Args[1],0,0,Args[2])
PLUH S 1
PLUH T 1 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}

actor CuttyCutMeleeX : CuttyCutMelee
{
Translation "202:202=180:180", "4:4=172:172"
speed 50
Args 45,52,26
}

actor CuttyCutMeleeXX : CuttyCutMelee

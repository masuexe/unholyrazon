actor Scrotoman : BossBase
{//RISK LIFE FOR MISTER LINCOLN
player.scoreIcon "UB113MUG"
player.soundclass "Scrotoman"
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
Player.MaxHealth 2000
Health 2000
player.jumpz 12
player.morphweapon "Scrotoman_W"
States
{
Spawn:
8B13 A 0
8B13 B 1
8B13 A 1
Goto Spawn+2
See:
8B13 BCDE 1
Goto Spawn
Missile:
8B13 F 0 A_JumpIfInventory("VivifyDelay7",1,"Missile2")
8B13 FFFFF 1
8B13 G 4
goto Spawn+2
Missile2:
8B13 P 1 A_JumpIfInventory("VivifyDelay5",1,"Missile3")
loop
Missile3:
8B13 P 0
goto Missile+2

ScrotoCruise:
TURB BCDE 1 A_JumpIfInventory("VivifyDelay6",1,"CarCrash")
loop
CarCrash:
8B13 H 0 A_PlaySoundEx("misc/devilpain","Voice")
8B13 HHHHHHHHH 2 A_SpawnItemEx("PainFX",0,3)
Goto Spawn+2
ClassPain:
8B13 H 0
Goto MegamanPain
ClassDeath:
8B13 H 0
Goto MegamanDeath
}
}

actor ProtoManBadGuy : BossBase
{
player.soundclass "PROTO"
player.damagescreencolor "black"
player.sidemove 1.0, 1.0
player.forwardmove 1.0, 1.0
Player.MaxHealth 850
Health 850
player.morphweapon "BaddieProtoBuster"
player.jumpz 10
States
{
Spawn:
PROM A 0
PROM B 1
PROM A 1
Goto Spawn+2
See:
PROM BCDE 5
Goto Spawn
Missile:
PROM F 5
PROM G 4
goto Spawn+2
ClassPain:
PROM H 0
Goto MegamanPain
ClassDeath:
PROM H 0
Goto MegamanDeath
}
}

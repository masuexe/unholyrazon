// RISK LIFE FOR MISTER LINCOLN
actor Scrotoman : BossBase {
  Player.ScoreIcon "UB113MUG"
  Player.SoundClass "Scrotoman"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.MaxHealth 2000
  Health 2000
  Player.JumpZ 12
  Player.MorphWeapon "Scrotoman_W"
  States {
   Spawn:
    8B13 A 0
    8B13 B 1
   SpawnFrame:
    8B13 AY 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    loop
   See:
    8B13 BCDE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    goto Spawn
   Air:
    8B13 N 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
    8B13 F 0 A_JumpIfInventory("VivifyDelay7", 1, "Missile2")
   Missile_1: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
   Missile_2: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
   Missile_3: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
   Missile_4: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
   Missile_5: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
   Missile_6: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
   Missile_7: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
   Missile_8: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
   Missile_9: 8B13 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
    goto SpawnFrame
   Missile_Air_1: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
   Missile_Air_3: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
   Missile_Air_4: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
   Missile_Air_5: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
   Missile_Air_6: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
   Missile_Air_7: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
   Missile_Air_8: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_9")
   Missile_Air_9: 8B13 O 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air

   Missile2:
    8B13 P 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile3")
    loop
   Missile3:
    8B13 P 0
    goto Missile+2

   ScrotoCruise:
    TURB BCDE 1 A_JumpIfInventory("VivifyDelay6", 1, "CarCrash")
    loop
   CarCrash:
    8B13 H 0 A_PlaySoundEx("misc/devilpain", "Voice")
    8B13 HHHHHHHHH 2 A_SpawnItemEx("PainFX", 0, 3)
    goto SpawnFrame
   ClassPain:
    8B13 H 0
    goto MegamanPain
   ClassDeath:
    8B13 H 0
    goto MegamanDeath
  }
}

actor ProtoManBadGuy : BossBase {
  Player.ScoreIcon "UL113MUG"
  Player.SoundClass "ProtoManBadGuy"
  Player.DamageScreenColor "black"
  Player.SideMove 1.0, 1.0
  Player.ForwardMove 1.0, 1.0
  Player.MaxHealth 850
  Health 850
  Player.MorphWeapon "ProtoManBadGuy_W"
  Player.JumpZ 10
  States {
   Spawn:
    PRO_ A 0
    PRO_ B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
   SpawnFrame:
    PRO_ AAAAAYYYYY 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    loop
   See:
    PRO_ BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    goto Spawn
   Air:
    PRO_ N 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
   Missile_1: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
   Missile_2: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
   Missile_3: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
   Missile_4: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
   Missile_5: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
   Missile_6: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
   Missile_7: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
   Missile_8: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
   Missile_9: PROM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
    goto SpawnFrame
   Missile_Air_1: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
   Missile_Air_3: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
   Missile_Air_4: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
   Missile_Air_5: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
   Missile_Air_6: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
   Missile_Air_7: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
   Missile_Air_8: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_9")
   Missile_Air_9: PROM O 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air
   ClassPain:
    PRO_ H 0
    goto MegamanPain
   ClassDeath:
    PROM H 0
    goto MegamanDeath
  }
}

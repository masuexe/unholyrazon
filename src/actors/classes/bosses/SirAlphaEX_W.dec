actor SirAlphaEX_W_ScriptBar : ScriptBar {}
actor SirAlphaEX_W : BaseUnholyBossWep {
  Tag "$TAG_SirAlphaEX_W"
  Obituary "%o was slain by \cgA\cmlpha \crEX\c- (%k)."  // "Engarde!"
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo250"
  States {
   Spawn:
    9I03 [ 1
    wait

   Deselect:
    9I03 A 0
    goto DeselectSwap
   Select:
    9I03 A 0
    goto SelectSwap

   Ready:
    9I03 A 0 A_GiveInventory("UnholyPowerLimit_F", 3000)
    9I03 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, SIRALPHAEX_DYE)
    9I03 A 6
    9I03 A 0  // A_GunFlash
    goto ReadyX
   ReadyX:
    9I03 A 0 A_JumpIfInventory("UnholyPower3000", 1000, "ReadyX2")
    9I03 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "ReadyX2")
    9I03 A 2 A_GiveInventory("SirAlphaEX_Ready8_P")
    loop
   ReadyX2:
    9I03 A 2 A_GiveInventory("SirAlphaEX_Ready0_P")
    loop

   Fire:
    9I03 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "RequiescatInPace")
    9I03 B 1
    9I03 B 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    9I03 C 1 A_FireCustomMissile("EXAlphaSlashX", 50, 0, -16, 0, 0, -10)
    9I03 C 1 OffSet(21, 23)A_FireCustomMissile("EXAlphaSlashX", 40, 0, -9, 0, 0, -7)
    9I03 D 1 OffSet(1, 33)A_FireCustomMissile("EXAlphaSlashX", 25, 0, -8, 0, 0, -5)
    9I03 A 0 A_FireCustomMissile("EXAlphaSlash", random(-2, 2), 0, 0, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 0, 0, 0)
    9I03 F 1 A_FireCustomMissile("EXAlphaSlashX", -25, 0, 8, 0, 0, 10)
    9I03 G 1 OffSet(1, 33)A_FireCustomMissile("EXAlphaSlashX", -40, 0, 9, 0, 0, 7)
    9I03 G 1 OffSet(21, 23)A_FireCustomMissile("EXAlphaSlashX", -50, 0, 16, 0, 0, 20)
    TNT1 AA 1
    TNT1 A 0 A_Refire("Fire2")
    goto FireEnd
   FireEnd:
    TNT1 A 0 A_WeaponReady(12)
    9I03 HI 2
    GoTo ReadyX

   Fire2:
    TNT1 A 0 A_WeaponReady(12)
    TNT1 A 1
    TNT1 A 0 A_Recoil(-14)
    TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    9I03 K 1 Offset(2, 2)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 40, 0, 0)
    9I03 K 1 Offset(-8, 22)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 30, 0, 0)
    9I03 K 1 Offset(-18, 52)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 20, 0, 0)
    9I03 M 1 Offset(110, 47)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 10, 0, 0)
    9I03 M 0 A_FireCustomMissile("EXAlphaSlash", random(-2, 2), 0, 0, 0)
    9I03 M 1 Offset(100, 67)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 0, 0, 0)
    9I03 M 1 Offset(90, 87)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, -10, 0, 0)
    9I03 N 1 Offset(150, 59)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, -20, 0, 0)
    9I03 N 1 Offset(140, 79)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, -30, 0, 0)
    9I03 N 1 Offset(130, 99)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, -40, 0, 0)
    TNT1 AA 1
    TNT1 A 0 A_Refire("Fire3")
    goto FireEnd

   Fire3:
    TNT1 A 0 A_WeaponReady(12)
    TNT1 A 1
    TNT1 A 0 A_Recoil(-25)
    TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    9I03 J 1 A_FireCustomMissile("EXAlphaSlashX", -40, 0, 0, -40, 0, 0)
    9I03 J 1 OffSet(-19, 43)A_FireCustomMissile("EXAlphaSlashX", -30, 0, 0, -30, 0, 0)
    9I03 K 1 OffSet(1, 33)A_FireCustomMissile("EXAlphaSlashX", -20, 0, 0, -20, 0, 0)
    9I03 K 1 OffSet(-19, 43)A_FireCustomMissile("EXAlphaSlashX", -10, 0, -10, 0, 0, 0)
    9I03 A 0 A_FireCustomMissile("EXAlphaSlash", random(-2, 2), 0, 0, 0)
    9I03 L 1 OffSet(1, 33)A_FireCustomMissile("EXAlphaSlashX", 0, 0, 0, 0, 0, 0)
    9I03 L 1 OffSet(-19, 43)A_FireCustomMissile("EXAlphaSlashX", 10, 0, 0, 10, 0, 0)
    9I03 M 1 OffSet(1, 33)A_FireCustomMissile("EXAlphaSlashX", 30, 0, 0, 30, 0, 0)
    9I03 N 1 A_FireCustomMissile("EXAlphaSlashX", 30, 0, 0, 30, 0, 0)
    9I03 N 1 OffSet(-19, 43)A_FireCustomMissile("EXAlphaSlashX", 40, 0, 0, 40, 0, 0)
    TNT1 AAAAAA 1
    goto FireEnd

   RequiescatInPace:
    9I03 P 0 A_TakeInventory("UnholyPower3000")
    9I03 P 0 A_Stop
    9I03 P 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    9I03 P 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    9I03 P 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    9I03 P 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    9I03 P 0 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 P 2 Offset(18, 28)
    9I03 O 2 Offset(58, -6)
    9I03 O 2 Offset(98, -26)
    9I03 O 15 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 O 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    9I03 O 10 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 O 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    9I03 O 5 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 O 0 A_SpawnItemEx("EXAlphaThunderBreaker")
    9I03 O 20
    9I03 O 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    9I03 O 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    9I03 O 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)

    9I03 O 2 Offset(138, -46)
    9I03 O 2 Offset(178, -66)
    TNT1 AAAAA 2
    goto FireEnd

   AlphanStriker:
    9I03 J 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    9I03 J 1 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 J 0 ThrustThingZ(0, 5, 0, 0)
    9I03 J 0 A_Recoil(-35)
   OkayCharge:
    9I03 K 0 A_Recoil(-15)
    9I03 K 2 A_SpawnItemEX("MadAlphaRageStrike", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    9I03 KKK 0 A_SpawnItemEx("EXAlphaSlashFX", random(-5, 0), random(-20, 20), random(0, 56), 0, 0, 0, 0, 32)
    9I03 K 0 A_TakeInventory("UnholyPower3000", 50)
    9I03 K 0 A_JumpIfInventory("DecoyFlag1", 1, "StopRightThere")
    9I03 K 0 A_JumpIfInventory("UnholyPower3000", 1, "OkayCharge")
    goto StopRightThere
   StopRightThere:
    9I03 LMN 1 A_TakeInventory("DecoyFlag1")
    TNT1 A 9 A_TakeInventory("DecoyFlag1")
    goto FireEnd

   Altfire:
    9I03 A 0 A_JumpIfInventory("UnholyPower3000", 1000, "DarshDeBomba")
    9I03 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "OldFashionedAlt")
    Goto ReadyX

   DarshDeBomba:
    9I03 C 0 ThrustThingZ(0, 60, 0, 0)
    9I03 C 0 A_Recoil(-35)
    9I03 C 0 A_TakeInventory("UnholyPower3000", 1000)
    9I03 C 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    9I03 C 2 A_SpawnItemEX("EXAlphanIndicatorEffect", 4, 0, 48)
    9I03 D 2
    9I03 E 1
    goto Groovy
   Groovy:
    9I03 EE 0 A_SpawnItemEx("EXAlphaSlashFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    9I03 E 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "RockYou")
    9I03 E 0 A_SpawnItemEX("EXAlphaContactHitbox", 0, 0, -16, momx, momy, momz, 0, 8, 0)
    loop
   RockYou:
    9I03 L 0 Radius_Quake(6, 35, 0, 40, 0)
    9I03 L 0 A_PlaySoundEx("misc/hugequake", "Body")
    9I03 L 0 A_FireCustomMissile("AlphanReppuken", 0, 0, 0, 0)
    9I03 LL 1 A_GiveInventory("SirAlphaEX_FloorQuake_P")
    9I03 MN 2
    TNT1 A 8
    goto FireEnd
   OldFashionedAlt:
    9I03 P 0 A_TakeInventory("UnholyBossAmmo250")
    9I03 P 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    9I03 P 0 A_FireCustomMissile("EXAlphaSlashingBlitz", random(-4, 4), 0, 0, 0)
    9I03 P 2 Offset(18, 34)
    9I03 O 2 Offset(58, -6)
    9I03 O 2 Offset(98, -26)
    9I03 B 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    9I03 B 0 A_FireCustomMissile("EXAlphaSlashingBlitz", random(-8, 8), 0, 0, 0)
    9I03 P 2 Offset(18, 28)
    9I03 O 2 Offset(58, -6)
    9I03 O 2 Offset(98, -26)
    9I03 B 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    9I03 B 0 A_FireCustomMissile("EXAlphaSlashingBlitz", random(-12, 12), 0, 0, 0)
    9I03 P 2 Offset(18, 28)
    9I03 O 2 Offset(58, -6)
    9I03 O 2 Offset(98, -26)
    9I03 O 2 Offset(138, -46)
    9I03 O 2 Offset(178, -66)
    TNT1 AAA 2
    goto FireEnd

   Reload:
    9I03 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "RisingUpperAlpha")
    goto ReadyX
   RisingUpperAlpha:
    9I03 A 0 A_WeaponReady(12)
    9I03 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    9I03 A 0 A_TakeInventory("UnholyBossAmmo200", 200)
    9I03 A 0 A_Recoil(-45)
    9I03 A 0 ThrustThingZ(0, 45, 0, 0)
    9I03 A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    9I03 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    9I03 A 0 ThrustThingZ(0, 90, 0, 0)
    9I03 A 0 A_Recoil(-10)
    9I03 A 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 A 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 A 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 C 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 C 0 A_SetAngle(angle-20.0)
    9I03 C 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 C 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 C 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 D 0 A_SetAngle(angle-20.0)
    9I03 D 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 D 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 D 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 D 0 A_SetAngle(angle-20.0)
    9I03 D 0 A_Recoil(-10)
    9I03 D 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 D 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 D 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 D 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_Recoil(-10)
    9I03 E 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_Recoil(-14)
    9I03 E 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_Recoil(-14)
    9I03 E 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_Recoil(-20)
    9I03 E 0 A_SpawnItemEx("EXAlphanRiserWind", 0, 0, -50)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 0, 0)
    9I03 E 0 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, -14, 0)
    9I03 E 1 A_FireCustomMissile("EXAlphaSlashXX", 0, 0, 14, 0)
    9I03 E 0 A_SetAngle(angle-20.0)
    Goto SixFeetOver
   SixFeetOver:
    9I03 K 8 A_Stop
    9I03 L 2
    9I03 M 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    9I03 M 0 A_Recoil(-50)
    9I03 M 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)
    9I03 M 0 ThrustThingZ(0, 125, 1, 0)
   ASuddenEnd:
    9I03 MM 0 A_SpawnItemEx("EXAlphaSlashFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    9I03 M 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "OldFashionedCrusherMove")
    9I03 M 0 A_SpawnItemEX("EXAlphaContactHitbox", 0, 0, -16, momx, momy, momz, 0, 8, 0)
    loop
   OldFashionedCrusherMove:
    9I03 N 0 Radius_Quake(8, 35, 0, 40, 0)
    9I03 N 0 A_PlaySoundEx("misc/hugequake", "Body")
    9I03 NNNNNNNNNNNNNNNNNNNN 0 A_SpawnItemEx("EXAlphaSlash2", 0, 0, 10, random(-60, 60), random(-60, 60), random(5, 40), 0, 0, 0)
    9I03 NN 1 A_GiveInventory("SirAlphaEX_FloorQuake_P")
    TNT1 AAA 1 A_GiveInventory("SirAlphaEX_FloorQuake_P")
    TNT1 A 0 A_JumpIfInventory("UnholyPower3000", 2000, "AlphanStriker")
    TNT1 AAA 2
    TNT1 A 6
    Goto FireEnd
  }
}

actor SirAlphaEX_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor SirAlphaEX_Ready8_P : SirAlphaEX_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor MadAlphaRageStrike : AlphaRageStrike {
  Damagetype "MadAlphaRage"
  Obituary "%o was decapitated by \cgA\cmlpha \crEX\c- (%k)'s Alphan-Striker."
  damage (2000)
}

actor MadAlphaRageStrikeFX : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Voice")
    TNT1 AAAAAAAAA 0 A_SpawnItemEx("EXAlphaSlashFX", random(-2, 2), random(-2, 2), 8, random(-10, 10), random(-10, 10), random(-5, 12), 0, 1)
    TNT1 A 40 Radius_Quake(6, 35, 0, 7, 0)
    stop
  }
}

actor MadAlphaRageStrike_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_GiveInventory("DecoyFlag1")
    TNT1 A 0 A_SpawnItemEx("MadAlphaRageStrikeFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor EXAlphaContactHitbox : BasicExplosion {
  damagetype "MadAlphaD"
  Obituary "%o was slain by \cgA\cmlpha \crEX\c- (%k)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(150, 80, 0, 0, 81)
    stop
  }
}

actor SirAlphaEX_FloorQuake_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_FloorQuakeDamage", 0, 1000, 25)
    TNT1 A 0 A_SpawnItemEx("SirAlphaEX_QuakeFX_H")
    stop
  }
}

actor SirAlphaEX_FloorQuakeSpawn : Basic_FloorQuakeSpawn {
  Translation "4:4=180:180"
  Obituary "%o was slain by \cgA\cmlpha \crEX\c- (%k)."
  damagetype "MadAlphaStun"
  States {
   Quake:
    TNT1 A 4 A_SpawnItemEx("SirAlphaEX_FloorQuakeBoom", 0, 0, 28, 0, 0, 0, 0, 16384+1)
    stop
  }
}

actor SirAlphaEX_FloorQuakeBoom : Basic_FloorQuakeBoom {
  Obituary "%o was slain by \cgA\cmlpha \crEX\c- (%k)."
  damagetype "MadAlphaStun"
}

actor SirAlphaEX_QuakeFX_H : Basic_FloorQuakeFX_H {
  Translation "4:4=180:180"
  Mass 3
  Scale 100
}

actor EXAlphanIndicatorEffect : BasicExplosion {
  Translation "192:192=180:180", "198:198=185:185"
  Scale 3.0
  States {
   Spawn:
    X_BC B 0
    X_BC B 0 A_PlaySoundEx("wep_L/mmb/lightningboltfire", "Weapon")
    X_BC BCDEFGHIJ 3
    stop
  }
}

actor EXAlphanRiserWind : AlphanRiserWind {
  damagetype "MadAlphaUpper"
  Obituary "%o was caught in \cgA\cmlpha \crEX\c- (%k)'s Rising-Upper."
  damage (160)
  States {
   Spawn:
    TNT1 A 3
    stop
  }
}


actor EXAlphaSlashX : BasicProjectile {
  // Translation "209:248=5:5", "208:208=185:185"
  Translation "192:192=180:180", "198:198=185:185"
  damagetype "MadAlphaD"
  Obituary "%o was slain by \cgA\cmlpha \crEX\c- (%k)."
  +RIPPER
  ReactionTime 1
  Damage (25)
  Radius 5
  Height 5
  speed 48
  States {
   Spawn:
    TMFX AAAAA 1 A_Explode(50, 108, 0)
    TMFX A 1 A_CountDown
    wait
   Death:
    TMFX A 0 A_Explode(50, 108, 0)
    TMFX BBBCCCDDD 1 A_Fadeout(0.04)
    stop
  }
}


// "192:192=180:180","198:198=185:185","195:195=8:8"

actor EXAlphaSlashXX : EXAlphaSlashX {
  Obituary "%o was caught in \cgA\cmlpha \crEX\c- (%k)'s Rising-Upper."
  Damage (50)
  speed 42
  States {

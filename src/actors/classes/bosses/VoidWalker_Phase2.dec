    TNT1 A 0 A_SpawnItemEx("VWCrystalShard", 0, 0, 8, 12, 0, 8, 135, 1)
    TNT1 A 0 A_SpawnItemEx("VWCrystalShard", 0, 0, 8, 12, 0, 8, 225, 1)
    TNT1 A 0 A_SpawnItemEx("VWCrystalShard", 0, 0, 8, 12, 0, 8, 315, 1)
    stop
  }
}


actor VWWaterBlast : BasicExplosion {
  DamageType "VWWaterBlast"
  Obituary "%o was engulfed by %k's \ckWater Blast\c-."
  var int user_NoTranslation;
  States {
   Spawn:
    TNT1 A 0 nodelay A_SpawnItemEx("VWWaterBlastSoakify")
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("VWWaterBlastSoakify")
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("VWWaterBlastSoakify")
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("VWWaterBlastSoakify")
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    stop
  }
}

actor VWWaterBlastSoakify : SoakifyEffect { args 512 }

actor VWWaterBlastSprinkleSpawn : BasicGraphicEffect {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("VWWaterBlastSprinkle", random(-256, 256), random(-256, 256), 0, 0, 0, 24, 90, SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("VWWaterBlastSprinkle", random(-256, 256), random(-256, 256), 0, 0, 0, 24, 90, SXF_CLIENTSIDE)
    TNT1 A 0 A_Jump(64, "SpawnBlast")
    stop
   SpawnBlast:
    TNT1 A 0 A_SpawnItemEx("VWWaterBlastBurst", random(-256, 256), random(-256, 256), random(0, 256), 0, 0, 12, 90, SXF_CLIENTSIDE)
    stop
  }
}

actor VWWaterBlastSprinkle : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=4:4", "198:198=206:206"
  States {
   Spawn:
    RAIN D 30
    stop
  }
}

actor VWWaterBlastBurst : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=4:4", "198:198=206:206"
  States {
   Spawn:
    MXP1 EDCBA 2
    stop
  }
}


actor VWCrystal : VWProjectile {
  var int user_NoTranslation;
  Damage (70)
  DamageType "VWCrystal"
  Obituary "%o was struck by %k's Crystal."
  Speed 24
  Radius 20
  Height 40
  Scale 3.0
  +DONTBLAST
  -NOGRAVITY
  Gravity 1.0
  States {
   Spawn:
    X_5C D 0
   SpawnLoop:
    X_5C D 2
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("MarioRPG/CrystalCrush", 1)
    TNT1 A 0 A_Explode(65, 144, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")

  Translation "192:192=196:196", "198:198=197:197"
  +FORCEXYBILLBOARD
  RenderStyle "Translucent"
  Alpha 0.78
  Scale 2.6
  States {
   SpawnFrame:
    6P09 A 2
    6P09 BCDEBCDE 2
   FadeLoop:
    6P09 F 2 A_FadeOut(0.18)
    loop
  }
}

actor VWBlizzardSparkleFX : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=196:196", "198:198=197:197"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5

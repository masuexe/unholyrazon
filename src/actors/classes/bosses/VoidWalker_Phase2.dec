    stop
  }
}
actor VWMeteorBlast : VWProjectile {
  var int user_NoTranslation;
  Damage (35)
  DamageType "VWMeteorBlast"
  Obituary "%o was struck by %k's Meteor Blast."
  +BRIGHT
  +SKYEXPLODE
  +DONTBLAST
  Radius 12
  Height 24
  Speed 32
  Scale 3.0
  States {
   Spawn:
    8Q15 A 0
    8Q15 A 0 A_Jump(256, "Spawn1", "Spawn2")
   Spawn1:
    8Q15 A 2 A_SpawnItemEx("VWMeteorBlastTrailFX4", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 A 0 A_SpawnItemEx("VWShredderStarBitFX", random(-10, 10), random(-10, 10), random(0, 12), random(-2, 2), random(-2, 2), random(2, 5), 0, 1)
    8Q15 J 2 A_SpawnItemEx("VWMeteorBlastTrailFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 K 2 A_SpawnItemEx("VWMeteorBlastTrailFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 K 0 A_SpawnItemEx("VWShredderStarBitFX2", random(-10, 10), random(-10, 10), random(0, 12), random(-2, 2), random(-2, 2), random(2, 5), 0, 1)
    8Q15 L 2 A_SpawnItemEx("VWMeteorBlastTrailFX3", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Spawn2:
    8Q15 L 2 A_SpawnItemEx("VWMeteorBlastTrailFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 L 0 A_SpawnItemEx("VWShredderStarBitFX2", random(-10, 10), random(-10, 10), random(0, 12), random(-2, 2), random(-2, 2), random(2, 5), 0, 1)
    8Q15 K 2 A_SpawnItemEx("VWMeteorBlastTrailFX4", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 J 2 A_SpawnItemEx("VWMeteorBlastTrailFX3", 0, 0, 0, 0, 0, 0, 0, 1)
    8Q15 J 0 A_SpawnItemEx("VWShredderStarBitFX", random(-10, 10), random(-10, 10), random(0, 12), random(-2, 2), random(-2, 2), random(2, 5), 0, 1)
    8Q15 A 2 A_SpawnItemEx("VWMeteorBlastTrailFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_PlaySound("KirbyNES/BombBoom", 1)
    TNT1 A 0 A_PlaySound("KirbyNES/Spark", 2)
    TNT1 A 0 A_Explode(45, 144, 0, 0, 72)
    TNT1 A 0 A_SpawnItemEx("VWMeteorBlastBoomFX", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("VWShredderShatterBurst", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 AAAA 0 A_SpawnItemEx("VWMeteorBlastStarBit", random(-6, 6), random(-6, 6), 8, random(-14, 14), random(-14, 14), random(6, 16), 0, 1)
    TNT1 AAAA 0 A_SpawnItemEx("VWMeteorBlastStarBit2", random(-6, 6), random(-6, 6), 8, random(-14, 14), random(-14, 14), random(6, 16), 0, 1)
    stop
  }
}

actor VWMeteorBlastTrailFX1 : BasicGraphicEffect {
  var int user_NoTranslation;
  +BRIGHT
  RenderStyle "Add"
  Alpha 0.85
  Scale 2.8
  States {
   SpawnFrame:
    TNT1 A 1
    goto Spawn2
   Spawn2:
    8Q15 EFGH 2 A_FadeOut(0.22)
    stop
  }
}

actor VWMeteorBlastTrailFX2 : VWMeteorBlastTrailFX1 {
  States {
   SpawnFrame:
    TNT1 A 1
    goto Spawn2+1
  }
}

actor VWMeteorBlastTrailFX3 : VWMeteorBlastTrailFX1 {
  States {
   SpawnFrame:
    TNT1 A 1
    goto Spawn2+2
  }
}

actor VWMeteorBlastTrailFX4 : VWMeteorBlastTrailFX1 {
  States {
   SpawnFrame:
    TNT1 A 1
    goto Spawn2+3
  }
}


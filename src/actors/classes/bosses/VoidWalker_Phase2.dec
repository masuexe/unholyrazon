actor VWFreezeLock_F : Inventory { Inventory.MaxAmount 0x7fffffff }

// The server spawns this root from ACS, so peers need a replicated actor.
actor VWStormColumn : VWBoltColumn { -CLIENTSIDEONLY }

actor VWStormMissile : VWBoltMissile {
  DamageType "VWStorm"
  Obituary "%o was struck by %k's Storm."
  States {
   Death:
   Crash:
    TNT1 A 0 A_SpawnItemEx("VWStormStrike", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("VWStormColumn", 0, 0, 24)
    stop
  }
}

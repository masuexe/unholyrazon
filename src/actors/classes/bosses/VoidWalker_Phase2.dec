// Phase-two spell actors. Gameplay actors stay server-owned; cosmetic trails
// inherit the base game's clientside BasicGraphicEffect.
actor SMRPG_Fear : Powerup {
  Powerup.Duration 175
  Powerup.Color "BBAA55", 0.12
  +INVENTORY.ALWAYSPICKUP
}
actor VWChilled_F : Powerup {
  Powerup.Duration 70
  Powerup.Color "77BBFF", 0.12
  +INVENTORY.ALWAYSPICKUP
}
actor VWSolidified_F : Powerup {
  Powerup.Duration 35
  Powerup.Color "99DDFF", 0.25
  +INVENTORY.ALWAYSPICKUP
}
actor VWSandStormFollow_F : Powerup {
  Powerup.Duration 85
  +INVENTORY.ALWAYSPICKUP
}
actor VWBlizzardFollow_F : Powerup {
  Powerup.Duration 85
  +INVENTORY.ALWAYSPICKUP
}

// The invisible fast tracer snapshots the aimed impact point. It inherits the
// orb species bypass and cannot damage the target before the explosions.
actor VWBlastTracer : VWTargetTracer {
  States {
   Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("VWBlast", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
    stop
  }
}

// A stationary, server-owned three-hit burst: 25 damage every six tics.
actor VWBlast : BasicExplosion {
  DamageType "VWBlast"
  Obituary "%o was struck by %k's Blast."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("MarioRPG/StarGunDone", 1)
    TNT1 A 0 A_Explode(25, 64, 0, 0, 32)
    TNT1 A 6 A_SpawnItemEx("VWDarkStarExplosion")
    TNT1 A 0 A_PlaySound("MarioRPG/StarGunDone", 1)
    TNT1 A 0 A_Explode(25, 64, 0, 0, 32)
    TNT1 A 6 A_SpawnItemEx("VWDarkStarExplosion")
    TNT1 A 0 A_PlaySound("MarioRPG/StarGunDone", 1)
    TNT1 A 0 A_Explode(25, 64, 0, 0, 32)
    TNT1 A 1 A_SpawnItemEx("VWDarkStarExplosion")
    stop
  }
}

actor VWBoulderSlam : VWProjectile {
  var int user_NoTranslation;
  Translation "192:192=164:164", "198:198=166:166"
  Damage (60)
  DamageType "Boulder"
  Obituary "%o was crushed by %k's Boulder."
  Speed 20
  Radius 20
  Height 32
  Scale 2.5
  +DONTBLAST
  -NOGRAVITY
  +USEBOUNCESTATE
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +CANBOUNCEWATER
  +DONTSPLASH
  BounceFactor 0.7
  WallBounceFactor 0.75
  BounceCount 4
  Gravity 1.0
  ReactionTime 70
  States {
   Spawn:
    6P1M M 0
   SpawnLoop:
    6P1M MONP 2 A_CountDown
    loop
   Bounce:
    6P1M M 0 A_PlaySound("weapon/superarmhit", 1, 0.65)
    6P1M M 0 A_Explode(45, 112, 0, 0, 48)
    6P1M M 0 A_ChangeVelocity(22, 0, velz, CVF_RELATIVE | CVF_REPLACE)
    6P1M MM 0 A_SpawnItemEx("VWBoulderShard", 0, 0, 8, random(6, 12), 0, random(4, 10), random(0, 359), SXF_TRANSFERTRANSLATION)
    goto SpawnLoop
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapon/superarmhit", 1)
    TNT1 A 0 A_Explode(65, 144, 0, 0, 64)
    TNT1 AAAA 0 A_SpawnItemEx("VWBoulderShard", 0, 0, 8, random(8, 16), 0, random(6, 12), random(0, 359), SXF_TRANSFERTRANSLATION)
    X_5C FGHI 2
    stop
  }
}

actor VWBoulderShard : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=164:164", "198:198=166:166"
  -NOINTERACTION
  -NOGRAVITY
  +THRUACTORS
  +DONTSPLASH
  Gravity 0.9
  Radius 4
  Height 4
  Scale 1.5
  States {
   Spawn:
    6P1M Q 0
   SpawnLoop:
    6P1M QRST 2 A_CheckFloor("Death")
    loop
   Death:
    TNT1 A 0
    stop
  }
}


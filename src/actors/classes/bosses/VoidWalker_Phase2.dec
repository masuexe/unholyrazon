actor VWSandStormField {
  var int user_NoTranslation;
  +NOBLOCKMAP
  +NOINTERACTION
  +NOGRAVITY
  +DONTBLAST
  ReactionTime 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("misc/commandosandstorm", 5, 1.0, 0, ATTN_NONE)
    TNT1 A 0 A_PlaySound("MarioRPG/SandStorm", 6, 0.9, 0, ATTN_NORM)
   StormLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", AAPTR_TRACER), "StormEnd")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE | WARPF_INTERPOLATE)
    TNT1 AAAAAA 0 A_SpawnItemEx("VWSandStormParticle", random(-384, 160), random(-480, 480), random(8, 160), random(44, 68), random(-6, 6), random(-3, 2), 0, 1)
    TNT1 AAA 0 A_SpawnItemEx("VWSandStormCloudFX", random(-256, 192), random(-360, 360), random(8, 112), random(22, 38), random(-6, 6), random(-1, 3), 0, 1)
    TNT1 A 2 A_CountDown
    loop
   StormEnd:
    TNT1 A 1
    stop
  }
}


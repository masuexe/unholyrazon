   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "Sparkle1", "Sparkle2")
   Sparkle1:
    6P09 KLMN 2 A_FadeOut(0.16)
    stop
   Sparkle2:

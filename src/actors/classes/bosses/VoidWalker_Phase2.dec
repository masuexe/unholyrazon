actor VWFlameWallPillar : VWProjectile {
  Damage (24)
  DamageType "FlameWall"
  Obituary "%o was consumed by %k's Flame Wall."
  +RIPPER
  +BRIGHT
  Radius 20
  Height 64
  Speed 20
  Scale 2.8
  ReactionTime 35
  States {
   Spawn:
    FIRE Q 0
   WallTick:
    FIRE QRSTUV 2 A_CountDown
    goto WallTick
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite")
    stop
  }
}

// A damaging server actor, rather than BasicGraphicEffect (clientside only).
actor VWCoronaSun : BasicExplosion {
  var int user_NoTranslation;
  Species "Culex"
  DamageType "Corona"
  Obituary "%o was consumed by %k's Flare."
  -MISSILE
  -NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  +THRUACTORS
  +NOGRAVITY
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 4.2
  ReactionTime 12
  States {
   Spawn:
    PHAS J 0
    PHAS J 0 A_PlaySound("weapons/mm4/pharaohshotfire2", 1)
    PHAS J 0 A_SetArg(0, 15)
    PHAS J 0 A_ChangeVelocity(0, 0, -18, CVF_REPLACE)
   DescendLoop:
    PHAS J 0 A_JumpIf(z - floorz <= 80, "HoverStart")
    PHAS J 0 A_SpawnItemEx("VWCoronaHaloFX", 0, 0, 0, 0, 0, 0, 0, 1)
    PHAS J 0 A_SpawnItemEx("VWDrainTrailFX", random(-12, 12), random(-12, 12), 16, 0, 0, 4, 0, 1)
    PHAS J 1 A_SpawnItemEx("MagmaCannonFX1", random(-18, 18), random(-18, 18), random(0, 24), random(-3, 3), random(-3, 3), random(3, 7), 0, 1)
    PHAS K 0 A_JumpIf(z - floorz <= 80, "HoverStart")
    PHAS K 0 A_SpawnItemEx("VWCoronaHaloFX", 0, 0, 0, 0, 0, 0, 0, 1)
    PHAS K 1 A_SpawnItemEx("MagmaCannonFX2", random(-18, 18), random(-18, 18), random(0, 24), random(-3, 3), random(-3, 3), random(3, 7), 0, 1)
    PHAS K 0 A_SetArg(0, args[0] - 1)
    PHAS K 0 A_JumpIf(args[0] <= 0, "HoverStart")
    loop
   HoverStart:
    PHAS J 0 A_Stop
    PHAS J 0 A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
    PHAS J 0 A_SetScale(4.6, 4.6)
    PHAS J 0 Radius_Quake(3, 28, 0, 20, 0)
    PHAS J 0 A_PlaySound("MarioRPG/CoronaBeam", 1)
    PHAS J 0 A_PlaySound("weapon/firestorm", 2)
    PHAS J 0 A_Explode(30, 128, 0, 0, 64)
    PHAS J 0 A_SpawnItemEx("OilPitIgnite", 0, 0, -64)
    PHAS J 0 A_SpawnItemEx("VWCoronaFirePillar", 0, 0, -64, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    PHAS JKJK 1 A_SpawnItemEx("VWCoronaHaloFX", 0, 0, 0, 0, 0, 0, 0, 1)
   SpinLoop:
    PHAS J 0 A_Stop
    PHAS J 0 A_Explode(16, 112, 0, 0, 64)
    PHAS J 0 A_SpawnItemEx("VWCoronaHaloFX", 0, 0, 0, 0, 0, 0, 0, 1)
    PHAS J 0 A_SpawnItemEx("VWCoronaFireJet", 24, 0, -8, 38, 0, random(-7, -2), 0, SXF_TRANSFERPOINTERS)
    PHAS J 0 A_SpawnItemEx("VWCoronaFireJet", 24, 0, -24, 26, 0, random(-6, -1), -7, SXF_TRANSFERPOINTERS)
    PHAS J 0 A_SpawnItemEx("VWCoronaFirePillar", random(88, 208), 0, -64, 14, 0, 0, 0, SXF_TRANSFERPOINTERS)
    PHAS J 0 A_SpawnItemEx("MagmaCannonFX1", random(-20, 20), random(-20, 20), random(-16, 20), random(-4, 4), random(-4, 4), random(2, 6), 0, 1)
    PHAS J 1 A_SetAngle(angle + 15)
    PHAS K 0 A_Explode(16, 112, 0, 0, 64)
    PHAS K 0 A_SpawnItemEx("VWCoronaHaloFX", 0, 0, 0, 0, 0, 0, 0, 1)
    PHAS K 0 A_SpawnItemEx("VWCoronaFireJet", 24, 0, -8, 38, 0, random(-7, -2), 0, SXF_TRANSFERPOINTERS)
    PHAS K 0 A_SpawnItemEx("VWCoronaFireJet", 24, 0, -24, 26, 0, random(-6, -1), -7, SXF_TRANSFERPOINTERS)
    PHAS K 0 A_SpawnItemEx("MagmaCannonFX2", random(-20, 20), random(-20, 20), random(-16, 20), random(-4, 4), random(-4, 4), random(2, 6), 0, 1)
    PHAS K 1 A_SetAngle(angle + 15)
    PHAS K 0 A_CountDown
    loop
   Death:
    PHAS L 0 A_PlaySound("weapon/solarblaze", 1)
    PHAS L 0 A_Explode(45, 192, 0, 0, 96)
    PHAS L 0 A_SpawnItemEx("OilPitIgnite", 0, 0, -64)
    PHAS LLLLLLLL 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, random(10, 20), 0, random(-4, 8), random(0, 359), 1)
    PHAS LMNO 2
    X_4D PQRSTUVWXY 1
    stop
  }
}


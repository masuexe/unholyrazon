// A damaging server actor, rather than BasicGraphicEffect (clientside only).
actor VWCoronaFirePillar : BasicExplosion {
  Species "Culex"
  DamageType "Corona"
  Obituary "%o was consumed by %k's Corona."
  Scale 3.0
  +BRIGHT
  States {
   Spawn:
    FIRE Q 0
    FIRE QRSTUV 3 A_Explode(16, 80, 0, 0, 40)
    stop
  }
}

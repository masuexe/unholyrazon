    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Voice")
    TNT1 A 0 A_Explode(28, 512, 0)
    TNT1 AAAAAAAAAA 1 A_SpawnItemEx("VWWaterBlastSprinkleSpawn", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)

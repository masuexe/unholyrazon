actor VWFlame : VWProjectile {
  Damage (65)
  DamageType "VWFlame"
  Obituary "%o was incinerated by %k's Flame."
  Speed 10
  Radius 14
  Height 28
  Scale 2.5
  +DONTBLAST
  +BRIGHT
  States {
   Spawn:
    FIRE Q 0 nodelay A_ChangeVelocity(8, 0, 14, CVF_RELATIVE | CVF_REPLACE)
   Rise:
    FIRE Q 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE Q 1 A_ScaleVelocity(0.84)
    FIRE Q 0 A_SpawnItemEx("MagmaCannonFX1", random(-8, 8), random(-8, 8), random(-8, 8), 0, 0, -2, 0, 1)
    FIRE R 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE R 1 A_ScaleVelocity(0.84)
    FIRE S 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE S 1 A_ScaleVelocity(0.84)
    FIRE S 0 A_SpawnItemEx("MagmaCannonFX2", random(-8, 8), random(-8, 8), random(-8, 8), 0, 0, -2, 0, 1)
    FIRE T 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE T 1 A_ScaleVelocity(0.84)
    FIRE U 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE U 1 A_ScaleVelocity(0.84)
    FIRE U 0 A_SpawnItemEx("MagmaCannonFX1", random(-8, 8), random(-8, 8), random(-8, 8), 0, 0, -2, 0, 1)
    FIRE V 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE V 1 A_ScaleVelocity(0.84)
    FIRE Q 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE Q 1 A_ScaleVelocity(0.84)
    FIRE R 0 A_JumpIf(ceilingz - z < 48, "Hover")
    FIRE R 1 A_ScaleVelocity(0.84)
   Hover:
    FIRE Q 0 A_Stop
    FIRE Q 2 A_SpawnItemEx("VWDrainSpiralFX", random(-18, 18), random(-18, 18), random(-12, 12), 0, 0, 2, 0, 1)
    FIRE R 2 A_SetScale(2.8, 2.8)
    FIRE S 2 A_SpawnItemEx("MagmaCannonFX1", random(-14, 14), random(-14, 14), random(-10, 10), random(-2, 2), random(-2, 2), random(1, 3), 0, 1)
    FIRE T 2 A_SetScale(2.5, 2.5)
    FIRE U 2 A_SpawnItemEx("VWDrainSpiralFX", random(-18, 18), random(-18, 18), random(-12, 12), 0, 0, 2, 0, 1)
    FIRE V 2 A_SetScale(2.8, 2.8)
    FIRE Q 2 A_SpawnItemEx("MagmaCannonFX2", random(-14, 14), random(-14, 14), random(-10, 10), random(-2, 2), random(-2, 2), random(1, 3), 0, 1)
    FIRE R 0 A_SetScale(2.6, 2.6)
    FIRE R 0 A_PlaySound("MarioRPG/B_Hit2", 1)
    FIRE R 0 ACS_NamedExecuteWithResult("uh_VWFlameLaunch")
   FlyLoop:
    FIRE Q 1 A_SpawnItemEx("VWDrainTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    FIRE R 1 A_SpawnItemEx("MagmaCannonFX1", random(-10, 10), random(-10, 10), random(-10, 10), random(-2, 2), random(-2, 2), random(1, 3), 0, 1)
    FIRE S 1 A_SpawnItemEx("VWDrainTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    FIRE T 1 A_SpawnItemEx("MagmaCannonFX2", random(-10, 10), random(-10, 10), random(-10, 10), random(-2, 2), random(-2, 2), random(1, 3), 0, 1)
    FIRE U 1 A_SpawnItemEx("VWDrainTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    FIRE V 1 A_SpawnItemEx("MagmaCannonFX1", random(-10, 10), random(-10, 10), random(-10, 10), random(-2, 2), random(-2, 2), random(1, 3), 0, 1)
    loop
   Death:
    X_4D P 0 A_PlaySound("weapon/firestorm", 1)
    X_4D P 0 A_Explode(45, 112, 0, 0, 56)
    X_4D P 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_4D P 0 A_SpawnItemEx("VWFlameImpactPillar", 0, 0, 0, 0, 0, 0, 0, 1)
    X_4D P 0 A_SpawnItemEx("VWFlameSubPillarFX", 40, 0, 0, 0, 0, 0, 0, 1)
    X_4D P 0 A_SpawnItemEx("VWFlameSubPillarFX", -40, 0, 0, 0, 0, 0, 0, 1)
    X_4D P 0 A_SpawnItemEx("VWFlameSubPillarFX", 0, 40, 0, 0, 0, 0, 0, 1)
    X_4D P 0 A_SpawnItemEx("VWFlameSubPillarFX", 0, -40, 0, 0, 0, 0, 0, 1)
    X_4D PPPP 0 A_SpawnItemEx("MagmaCannonFX1", random(-12, 12), random(-12, 12), random(0, 16), random(2, 6), 0, random(2, 6), random(0, 359), 1)
    X_4D PPPP 0 A_SpawnItemEx("MagmaCannonFX2", random(-12, 12), random(-12, 12), random(0, 16), random(2, 6), 0, random(2, 6), random(0, 359), 1)
    X_4D P 0 A_SetScale(3.2, 3.2)
    X_4D PQRSTUVWXY 1
    stop
  }
}


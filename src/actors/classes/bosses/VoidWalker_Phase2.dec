  Powerup.Duration 40
  +INVENTORY.ALWAYSPICKUP
}

actor VWSolidify : VWProjectile {
  var int user_NoTranslation;
  Translation "192:192=96:96", "198:198=116:116"
  Damage (0)
  DamageType "VWSolidify"
  Obituary "%o was frozen solid by %k's Solidify."
  Speed 0
  Radius 16
  Height 24
  Scale 10.0
  +DONTBLAST
  +DONTREFLECT
  +THRUACTORS
  +THRUGHOST
  +FLOORHUGGER
  +NOEXPLODEFLOOR
  States {
   Spawn:
    CLDW F 0 nodelay A_PlaySound("weapon/icewallspawn", 1)
    CLDW F 0 A_SpawnItemEx("IcePitFreeze")
    CLDW FGEFG 3 ACS_NamedExecuteAlways("uh_VWSolidifyField", 0)
    CLDW FGE 3 ACS_NamedExecuteAlways("uh_VWSolidifyField", 0)
   Death:
    CLDW EEEFFFEEEFFF 1 A_FadeOut(0.1)
    stop
  }
}

actor VWSolidifyEncase : VWProjectile {
  var int user_NoTranslation;
  Translation "192:192=96:96", "198:198=116:116"
  +NOINTERACTION
  +NOGRAVITY
  Damage (0)
  DamageType "VWSolidify"
  Obituary "%o was frozen solid by %k's Solidify."
  Scale 2.5
  States {
   Spawn:
    CLDW J 0 nodelay A_PlaySound("weapon/icewallspawn", 1)
    CLDW JJJJ 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW K 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 20)
    CLDW KKKK 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW L 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 20)
    CLDW LLLL 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW A 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 25)
    CLDW AAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW A 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 25)
    CLDW AAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW B 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 25)
    CLDW BBBBBB 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW B 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 25)
    CLDW BBBBBB 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW C 0 A_PlaySound("MarioRPG/CrystalCrush", 1)
    CLDW C 0 A_SpawnItemEx("IcePitFreeze")
    CLDW C 0 ACS_NamedExecuteAlways("uh_VWSolidifyTick", 0, 45)
    CLDW CCCC 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    CLDW DDDD 1 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    stop
  }
}

// NOINTERACTION moves through geometry; native radius damage supplies the
// repeated cutting hits, with standard visibility and shooter attribution.
actor VWDiamondSaw : VWProjectile {
  +NOINTERACTION
  +RIPPER
  +BRIGHT
  +NODAMAGETHRUST
  Damage (0)
  DamageType "DiamondSaw"
  Obituary "%o was sliced by %k's Diamond Saw."
  Speed 32
  Radius 12
  Height 24
  Scale 1.8
  States {
   Spawn:
    METL A 0
    METL ABABABABABABABABABABABABABAB 1 A_Explode(12, 20, 0, 0, 20)
    stop
  }
}

actor VWDrain : VWProjectile {
  var int user_angle;
  RenderStyle "Add"
  Alpha 0.95
  Damage (45)
  DamageType "VWDrain"
  Obituary "%o was struck by %k's Hot Shot."
  Speed 44
  Radius 10
  Height 20
  Scale 2.2
  +DONTBLAST
  +BRIGHT
  States {
   Spawn:
    X_4D G 0
   SpawnLoop:
    X_4D G 0 A_SpawnItemEx("VWDrainTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_4D G 0 A_SpawnItemEx("VWDrainSpiralFX", -4, cos(user_angle) * 16, sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D G 0 A_SpawnItemEx("VWDrainSpiralFX", -4, -cos(user_angle) * 16, -sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D G 1 A_SetUserVar("user_angle", user_angle + 36)
    X_4D G 0 A_SpawnItemEx("MagmaCannonFX1", random(-8, 8), random(-8, 8), random(-8, 8), random(-1, -3), random(-3, 3), random(1, 3), 0, 1)
    X_4D G 0 A_SpawnItemEx("VWDrainSpiralFX", -4, cos(user_angle) * 16, sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D G 0 A_SpawnItemEx("VWDrainSpiralFX", -4, -cos(user_angle) * 16, -sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D G 1 A_SetUserVar("user_angle", user_angle + 36)
    X_4D H 0 A_SpawnItemEx("VWDrainTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_4D H 0 A_SpawnItemEx("VWDrainSpiralFX", -4, cos(user_angle) * 16, sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D H 0 A_SpawnItemEx("VWDrainSpiralFX", -4, -cos(user_angle) * 16, -sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D H 1 A_SetUserVar("user_angle", user_angle + 36)
    X_4D H 0 A_SpawnItemEx("MagmaCannonFX2", random(-8, 8), random(-8, 8), random(-8, 8), random(-1, -3), random(-3, 3), random(1, 3), 0, 1)
    X_4D H 0 A_SpawnItemEx("VWDrainSpiralFX", -4, cos(user_angle) * 16, sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D H 0 A_SpawnItemEx("VWDrainSpiralFX", -4, -cos(user_angle) * 16, -sin(user_angle) * 16, 0, 0, 0, 0, 1)
    X_4D H 1 A_SetUserVar("user_angle", user_angle + 36)
    loop
   Death:
    X_4D P 0 A_PlaySound("weapon/firestorm", 1)
    X_4D P 0 A_Explode(30, 80, 0, 0, 40)
    X_4D P 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 0, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 45, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 90, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 135, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 180, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 225, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 270, 1)
    X_4D P 0 A_SpawnItemEx("VWDrainBurstFX", 0, 0, 0, 10, 0, 4, 315, 1)
    X_4D PPPP 0 A_SpawnItemEx("MagmaCannonFX1", random(-10, 10), random(-10, 10), random(-10, 10), random(2, 6), 0, random(1, 5), random(0, 359), 1)
    X_4D PPPP 0 A_SpawnItemEx("MagmaCannonFX2", random(-10, 10), random(-10, 10), random(-10, 10), random(2, 6), 0, random(1, 5), random(0, 359), 1)
    X_4D P 0 A_SetScale(3.0, 3.0)
    X_4D PQRSTUVWXY 1
    stop
  }
}

actor VWDrainTrailFX : BasicGraphicEffect {
  +BRIGHT
  RenderStyle "Add"
  Alpha 0.75
  Scale 1.9
  States {
   SpawnFrame:
    FIRE Q 1 A_FadeOut(0.14)
    FIRE R 1 A_SetScale(scaleX - 0.2, scaleY - 0.2)
    FIRE S 1 A_FadeOut(0.14)
    FIRE T 1 A_SetScale(scaleX - 0.2, scaleY - 0.2)
    FIRE U 1 A_FadeOut(0.14)
    FIRE V 1 A_FadeOut(0.14)
    stop
  }
}


  }
}

actor VWBlizzardHailDropFX : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=203:203", "198:198=5:5"
  -NOINTERACTION
  -NOGRAVITY
  +THRUACTORS
  +DONTSPLASH
  +FORCEXYBILLBOARD
  Gravity 0.85
  Radius 6
  Height 6
  Scale 2.5
  States {
   SpawnFrame:
    X_7A D 0
   DropLoop:
    X_7A D 1 A_SpawnItemEx("VWBlizzardHailTrailFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_7A D 1 A_CheckFloor("Impact")
    loop
   Impact:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    TNT1 AA 0 A_SpawnItemEx("VWBlizzardSparkleFX", random(-16, 16), random(-16, 16), 8, random(-8, 8), random(-8, 8), random(2, 8), 0, 1)
    X_7A PQRS 2 A_FadeOut(0.18)
    stop
  }
}

actor VWBlizzardHailTrailFX : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "192:192=203:203", "198:198=5:5"
  +FORCEXYBILLBOARD
  Scale 2.2
  States {
   SpawnFrame:
    X_7A DDEE 1 A_FadeOut(0.2)
    stop
  }
}

actor VWBlizzardField {
  var int user_NoTranslation;
  +NOBLOCKMAP
  +NOINTERACTION
  +NOGRAVITY
  +DONTBLAST
  ReactionTime 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapons/mm6/blizzardattackfire", 5, 1.0, 0, ATTN_NONE)
    TNT1 A 0 A_PlaySound("weapon/icewaveloop", 6, 0.9, 0, ATTN_NORM)
   BlizzardLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", AAPTR_TRACER), "BlizzardEnd")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE | WARPF_INTERPOLATE)
    TNT1 AAAAA 0 A_SpawnItemEx("VWBlizzardSnowFlake", random(-384, 192), random(-480, 480), random(64, 240), random(32, 54), random(-10, 10), random(-18, -8), 0, 1)
    TNT1 AA 0 A_SpawnItemEx("VWBlizzardFlakeFX", random(-320, 160), random(-420, 420), random(48, 200), random(28, 46), random(-8, 8), random(-14, -6), 0, 1)
    TNT1 AA 0 A_SpawnItemEx("VWBlizzardMistFX", random(-256, 224), random(-360, 360), random(8, 120), random(20, 36), random(-8, 8), random(-2, 3), 0, 1)
    TNT1 AA 0 A_SpawnItemEx("VWBlizzardHailDropFX", random(-320, 320), random(-384, 384), random(180, 280), random(12, 24), random(-6, 6), random(-32, -22), 0, 1)
    TNT1 A 2 A_CountDown
    loop
   BlizzardEnd:
    TNT1 A 1
    stop
  }
}

actor VWBlizzardFollow {
  var int user_NoTranslation;
  +NOBLOCKMAP
  +NOINTERACTION
  +NOGRAVITY
  +DONTBLAST
  ReactionTime 40
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapon/icewaveloop", 5, 0.9, 0, ATTN_NORM)
    TNT1 A 0 A_PlaySound("weapons/mm6/blizzardattackfire", 6, 0.85, 0, ATTN_NORM)
   FollowLoop:
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "FollowEnd")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE | WARPF_INTERPOLATE)
    TNT1 AAAA 0 A_SpawnItemEx("VWBlizzardSnowFlake", random(-200, -24), random(-160, 160), random(32, 160), random(32, 52), random(-10, 10), random(-16, -8), 0, 1)
    TNT1 A 0 A_SpawnItemEx("VWBlizzardFlakeFX", random(-160, 24), random(-128, 128), random(24, 128), random(26, 44), random(-8, 8), random(-12, -5), 0, 1)
    TNT1 AA 0 A_SpawnItemEx("VWBlizzardMistFX", random(-96, 32), random(-96, 96), random(4, 64), random(16, 30), random(-6, 6), random(-2, 3), 0, 1)
    TNT1 A 0 A_SpawnItemEx("VWBlizzardSparkleFX", random(-36, 36), random(-36, 36), random(8, 56), random(-6, 6), random(-6, 6), random(-2, 6), 0, 1)
    TNT1 A 2 A_CountDown
    loop
   FollowEnd:
    TNT1 A 1 A_PlaySound("weapon/icewavebreak", 5, 0.75, 0, ATTN_NORM)
    stop
  }
}
actor VWFlameWallPillar : VWProjectile {
  var int user_NoTranslation;
  Translation "202:202=215:215", "199:199=217:217"
  Damage (18)
  DamageType "FlameWall"
  Obituary "%o was consumed by %k's Flame Wall."
  +RIPPER
  +BRIGHT
  +FLOORHUGGER
  +STEPMISSILE
  +DONTBLAST
  +DONTSPLASH
  MaxStepHeight 48
  Radius 24
  Height 72
  Speed 28
  Scale 4.2
  ReactionTime 18
  States {
   Spawn:
    FWVE U 0
    FWVE UVW 1
   WallTick:
    FWVE X 1 A_Explode(24, 72, 0, 0, 64)
    FWVE X 0 A_SpawnItemEx("VWFlameWallWakeFX", -16, random(-16, 16), 0, 0, 0, 0, 0, 1)
    FWVE X 1 A_SpawnItemEx("MagmaCannonFX1", random(-20, 20), random(-20, 20), random(8, 56), random(-2, 2), random(-2, 2), random(2, 6), 0, 1)
    FWVE Y 1 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    FWVE Y 1 A_SpawnItemEx("MagmaCannonFX2", random(-20, 20), random(-20, 20), random(8, 56), random(-2, 2), random(-2, 2), random(2, 6), 0, 1)
    FWVE Y 0 A_CountDown
    goto WallTick
   Death:
    FWVE X 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    FWVE XWVU 2
    stop
  }
}

actor VWFlameWallWakeFX : BasicGraphicEffect {
  var int user_NoTranslation;
  Translation "202:202=215:215", "199:199=217:217"
  +BRIGHT
  Scale 3.2
  States {

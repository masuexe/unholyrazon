    TNT1 A 0 A_SpawnItemEx("VWDarkStarExplosion")
    stop
  }
}

actor VWChillSpeedGiver : PowerApropGiver {}
actor VWChillSpeed : Base_UH_PropertyPower {}

actor VWStormStrike : BasicExplosion {
  var int user_NoTranslation;
  +BRIGHT
  DamageType "VWStorm"
  Obituary "%o was swept away by %k's \ckStorm\c-."
  RenderStyle "Translucent"
  Alpha 0.85
  XScale 0.5
  YScale 0.65
  States {
   Spawn:
    EVFL N 0 nodelay A_PlaySound("weapon/stormtornado", 1)
    EVFL N 1 A_SetScale(0.75, 0.65)
    EVFL O 1 A_SetScale(1.0, 0.65)
    EVFL P 1 A_SetScale(1.25, 0.65)
    EVFL N 1 A_SetScale(1.5, 0.65)
    EVFL O 0 A_Explode(20, 72, 0, 0, 48)
    EVFL OPN 2 A_SetScale(1.75, 0.65)
    EVFL O 0 A_Explode(20, 72, 0, 0, 48)
    EVFL OPN 2
    EVFL O 0 A_Explode(20, 72, 0, 0, 48)
    EVFL OP 2
    EVFL N 1 A_SetScale(1.4, 0.65)
    EVFL O 1 A_SetScale(1.1, 0.65)
    EVFL P 1 A_SetScale(0.8, 0.65)
    EVFL N 1 A_SetScale(0.5, 0.65)
    EVFL O 1 A_SetScale(0.25, 0.65)
    stop
  }
}


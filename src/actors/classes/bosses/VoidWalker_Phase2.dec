actor VWFreezeLock_F : Inventory { Inventory.MaxAmount 0x7fffffff }

actor VWStormMissile : VWProjectile {
  var int user_NoTranslation;
  +BRIGHT
  +DONTBLAST
  Radius 12
  Height 24
  Speed 42
  Damage (35)
  DamageType "VWStorm"
  Obituary "%o was swept away by %k's \ckStorm\c-."
  RenderStyle "Translucent"
  Alpha 0.85
  XScale 0.85
  YScale 0.22
  States {
   Spawn:
    EVFL N 0
   SpawnLoop:
    EVFL NOP 2
    loop
   Death:
   Crash:
    TNT1 A 0 A_SpawnItemEx("VWStormStrike", 0, 0, (z - floorz <= 48 ? floorz - z : -24), 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
    stop
  }
}

actor DonJavier : BossBase {
  Player.ScoreIcon "UB002MUG"
  Player.SoundClass "donjavier"
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 10
  Player.MaxHealth 2250
  Health 2250
  Player.MorphWeapon "DonJavier_W"
  States {
   Spawn:
    SNAM A 0
    SNAM B 1
    SNAM A 1
    goto Spawn+2
   See:
    SNAM BCDE 5
    goto Spawn
   Missile:
    SNAM F 5
    SNAM G 4
    goto Spawn+2
   ClassPain:
    SNAM H 0
    goto MegamanPain
   ClassDeath:
    SNAM H 0
    goto MegamanDeath
  }
}

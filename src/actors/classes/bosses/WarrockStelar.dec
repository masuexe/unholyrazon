// TODO: add death explode effect
actor WarRockStelar : BossBase {
  Player.ScoreIcon "UB051MUG"
  Player.SoundClass "WarRockStelar"
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.0, 1.0
  Player.JumpZ 12
  Player.MaxHealth 4065
  Health 4065
  Player.MorphWeapon "WarRockStelar_W"
  Player.WeaponSlot 1, "WarRockStelar_W"
  Player.WeaponSlot 2, "WarRockStelar_W2"
  States {
   Spawn:
    8A51 A 0
    8A51 B 1
    8A51 A 1
    goto Spawn+2
   See:
    8A51 BCDE 5
    goto Spawn
   Missile:
    8A51 F 5
    8A51 G 4
    goto Spawn+2
   ClassPain:
    8A51 H 0
    goto MegamanPain
   ClassDeath:
    8A51 H 0 A_PlaySoundEx("voice/MMSF3/Death", "Body")
    goto MegamanDeath
  }
}

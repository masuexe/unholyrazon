// actual Misery skin sprites by Soundwave
// Name this whatever, let it be Witch Splashwoman (SPWI), Misery, The state with a similar sounding name.
// I want to set Witch Splashwoman as an optional skin, but idk what to do lol
actor Misery : BossBase {
  Player.ScoreIcon "UB060MUG"
  Player.SoundClass "Misery"
  Player.ForwardMove 1.2, 1.2  // 1.2
  Player.SideMove 1.2, 1.2  // 1.2
  Player.JumpZ 12  // 12
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "Misery_W"
  States {
   Spawn:
    MSRY A 0
    MSRY B 1
    MSRY A 1
    goto Spawn+2
   See:
    MSRY BCDE 5  // 3
    goto Spawn
   Missile:
    MSRY F 5 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    MSRY G 4
    goto Spawn+2
   Missile2:
    MSRY C 5
    MSRY F 1 A_JumpIfInventory("VivifyDelay3", 1, "Spawn")
    wait  // I'm pretty sure we can make use of a unique pain noise Misery makes.
   ClassPain:
    MSRY H 0 A_SpawnItemEx("Misery_Pain_Spawner")
    MSRY H 0 A_PlaySoundEx("Pain/MiseryBoss", "SoundSlot5")
    goto MegamanPain  // The whole intent is to recreate things, y'know?
    /*ActualPain:
MSRY HH 2 A_SpawnItemEx("Misery_Pain_Spawner")
MSRY HHHHHHH 2
Goto Spawn+2*/
   ClassDeath:
    MSRY H 0
    goto MegamanDeath
   MegamanDeath0:
    TNT1 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TNT1 A 1 A_SpawnItemEx("Misery_RealCorpse", 0, 0, 0, 0, 0, 4, 0, 9)
    goto MegamanErase
  }
}


actor Misery_Pain_Spawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 0 A_SpawnItemEx("Misery_Pain_FX", random(-2, 2), random(-2, 2), random(6, 48), random(-18, 18), random(-18, 18), random(-8, 18))
    stop
  }
}

actor Misery_Pain_FX : Balrog_Pain_FX {}

actor Misery_RealCorpse {  // : BaseCorpse
  Translation "192:192=102:102", "198:198=119:119", "5:8=127:127", "0:0=127:127", "210:215=82:82", "40:47=77:77"
  -SOLID
  +THRUACTORS
  +DONTBLAST
  +DONTREFLECT
  damage 0
  Radius 2
  Height 2
  Scale 2.5
  States {
   Spawn:  // This is gonna suck
    MSRY H 0
    MSRY HHHHHH 0 A_SpawnItemEx("Misery_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    MSRY H 25  // 25
    MSRY A 10 A_SetAngle(random(0, 359))  // FUUUUCCCKKKK
    MSRY FFFFFFFFFGGGG 2
    MSRY F 0 A_PlaySoundEx("Boss/MiseryTeleport", "Voice")
    MSRY F 0 A_SpawnItemEx("Misery_Tele_Starter", 0, 0, 0)  // A_SpawnItemEx("Misery_FliesAway",0,0,0,0,0,4,0,1) //2 move
    stop
  }
}

// TODO: add actual Misery skin sprites

actor Misery : BossBase
{ //Name this whatever, let it be Witch Splashwoman, Misery, The state with a similar sounding name.
player.scoreIcon "UB060MUG"
player.soundclass "Misery"
player.forwardmove 1.2, 1.2 //1.2
player.sidemove 1.2, 1.2 //1.2
player.jumpz 12 //12
Player.MaxHealth 2500
Health 2500
player.morphweapon "Misery_W"
States
{
Spawn:
SPWI A 0
SPWI B 1
SPWI A 1
Goto Spawn+2
See:
SPWI BCDE 5 //3
Goto Spawn
Missile:
SPWI F 5 A_JumpIfInventory("VivifyDelay3",1,"Missile2")
SPWI G 4
goto Spawn+2
Missile2:
SPWI C 5
SPWI F 1 A_JumpIfInventory("VivifyDelay3",1,"Spawn")
wait //I'm pretty sure we can make use of a unique pain noise Misery makes.
ClassPain:
SPWI H 0 A_SpawnItemEx("Misery_Pain_Spawner")
SPWI H 0 A_PlaySoundEX("Pain/MiseryBoss","SoundSlot5")
Goto MegamanPain //The whole intent is to recreate things, y'know?
/*ActualPain:
SPWI HH 2 A_SpawnItemEx("Misery_Pain_Spawner")
SPWI HHHHHHH 2
Goto Spawn+2*/
ClassDeath:
SPWI H 0
goto MegamanDeath
MegamanDeath0:
TNT1 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
TNT1 A 1 A_SpawnItemEx("Misery_RealCorpse",0,0,0,0,0,4,0,9)
Goto MegamanErase
}
}


actor Misery_Pain_Spawner : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 AA 0 A_SpawnItemEx("Misery_Pain_FX",random(-2,2),random(-2,2),random(6,48),random(-18,18),random(-18,18),random(-8,18))
stop
}
}

actor Misery_Pain_FX : Balrog_Pain_FX {}

actor Misery_RealCorpse //: BaseCorpse
{
Translation "192:192=102:102", "198:198=119:119", "5:8=127:127", "0:0=127:127", "210:215=82:82", "40:47=77:77"
-SOLID
+THRUACTORS
+DONTBLAST
+DONTREFLECT
damage 0
radius 2
height 2
scale 2.5
states
{
Spawn: //This is gonna suck
SPWI H 0
SPWI HHHHHH 0 A_SpawnItemEx("Misery_Smoke_Cloud",random(-48,48),random(-48,48),random(-48,48),random(-8,8),random(-8,8),random(-8,8),0,0) //32
SPWI H 25 //25
SPWI A 10 A_SetAngle(random(0,359)) //FUUUUCCCKKKK
SPWI FFFFFFFFFGGGG 2
SPWI F 0 A_PlaySoundEx("Boss/MiseryTeleport","Voice")
SPWI F 0 A_SpawnItemEx("Misery_Tele_Starter",0,0,0) //A_SpawnItemEx("Misery_FliesAway",0,0,0,0,0,4,0,1) //2 move
stop
}
}

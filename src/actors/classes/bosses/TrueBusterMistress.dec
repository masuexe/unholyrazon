actor TrueBusterMistress : BossBase {
  Player.ScoreIcon "UB025MUG"
  Player.SoundClass "TrueBusterMistress"
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.3, 1.3
  Player.JumpZ 13
  Player.MaxHealth 3525
  Health 3525
  Player.MorphWeapon "TrueBusterMistress_W"
  States {
   Spawn:
    8A25 A 0
    8A25 B 1
    8A25 A 1 A_JumpIfInventory("DecoyFlag2", 1, "StayLikeThis")
    goto Spawn+2
   See:
    8A25 BCDE 5 A_JumpIfInventory("DecoyFlag2", 1, "StayLikeThis")
    goto Spawn
   Missile:
    8A25 FFFFF 1 A_JumpIfInventory("DecoyFlag2", 1, "StayLikeThis")
    8A25 GGGG 1 A_JumpIfInventory("DecoyFlag2", 1, "StayLikeThis")
    goto Spawn+2
   StayLikeThis:
    8A25 F 5
    8A25 G 4
    8A25 G 1 A_JumpIfInventory("DecoyFlag2", 1, "StayLikeThis")
    goto Spawn+2
   ClassPain:
    // 8A25 H 0 A_GiveInventory("EternalPainFlag",1) //for some reason the regen effect was uncancelable because the flag was given on a commented out state pointer?
    8A25 HHHH 0 A_SpawnItemEx("MistressSouretShotFX", random(-2, 2), random(-2, 2), 32, random(-4, 4), random(-4, 4), random(-5, 12))
    8A25 HHHHHHHHHH 2 A_GiveInventory("TrueBusterMistressPain_P")
    goto Spawn+2
    // Goto MegamanPain
   ClassDeath:
    8A25 H 0
    goto MegamanDeath
   MegamanDeath0:
    8A25 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8A25 H 0 A_Stop
    8A25 H 0 A_ChangeFlag("NOGRAVITY", 1)
    8A25 H 0 ThrustThingZ(0, 7, 0, 0)
    8A25 HHHHHHHHH 1 A_SpawnItemEx("MistressSouretShotFX", random(-2, 2), random(-2, 2), 32, random(-4, 4), random(-4, 4), random(-5, 12))
    8A25 H 0 A_Stop
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 H 0 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    8A25 HHHHHHHHHHH 1 A_SpawnItemEx("MistressSouretShotFX", random(-2, 2), random(-2, 2), 32, random(-20, 20), random(-20, 20), random(-5, 12))
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 HH 0 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    8A25 HHHHHHHHHHHH 1 A_SpawnItemEx("MistressSouretShotFX", random(-2, 2), random(-2, 2), 32, random(-35, 35), random(-35, 35), random(-5, 12))
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 HHHHHHHHH 1 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 HHHHH 1 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 HHHHHHH 0 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    8A25 H 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    8A25 HHHHHH 0 A_SpawnItemEx("MistressExplodeFX", random(-90, 50), random(-90, 90), random(-30, 90))
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_0", 0, 0, random(32, 40), random(0, 4), 0, random(2, 6), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_1", 0, 0, random(24, 32), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_2", 0, 0, random(24, 32), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_3", 0, 0, random(20, 28), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_4", 0, 0, random(20, 28), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_5", 0, 0, random(2, 10), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    TNT1 H 0 A_SpawnItemEx("TrueBusterMistressC_6", 0, 0, random(2, 10), random(0, 5), 0, random(1, 4), random(0, 359), 160, 0)
    8A25 Z 0
    goto MegamanErase

   MegamanGib:
    8A25 Z 0 A_GiveInventory("TrueBusterMistressCriticalDeathGiver")
    // 8A25 Z 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    goto MegamanErase
   MegamanIceGib:
    8A25 Z 0 A_SpawnItemEx("FrozenDeathFX", 0, 0, 1, 0, 0, 0, 0, 1)
    8A25 Z 0 A_SpawnItemEx("TrueBusterMistressCriticalDeathSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    8A25 Z 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    8A25 Z 0 A_PlaySoundEx("*icedeath", "Voice")
    goto MegamanErase
  }
}

actor TrueBusterMistressPain_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("PainFX_UH", -5, 0, 3, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("MistressSouretShotFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    stop
  }
}

actor TrueBusterMistressCriticalDeathGiver : CriticalHitGiver {
  States {
   Use:
    TNT1 A 0 A_PlaySoundEx("misc/gib", "SoundSlot6")
    TNT1 A 0 A_PlaySoundEx("*critdeth", "SoundSlot6")
    TNT1 A 0 A_SpawnItemEx("TrueBusterMistressCriticalDeathSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
    stop
  }
}

actor TrueBusterMistressCriticalDeathSpawner : CriticalHitSpawner {
  var int user_InFloor;
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_JumpIf(!CallACS("core_checkclientcvar", CLCVAR_GIBS), "End")
    TNT1 A 0 A_SetUserVar(user_InFloor, (z - floorz < 32))
   Spawn2:
    TNT1 A 0 A_SpawnItemEx("TrueBusterMistressC_0", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 2 A_SpawnItemEx("TrueBusterMistressC_1", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_SpawnItemEx("TrueBusterMistressC_2", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 2 A_SpawnItemEx("TrueBusterMistressC_3", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_SpawnItemEx("TrueBusterMistressC_4", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 2 A_SpawnItemEx("TrueBusterMistressC_5", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_SpawnItemEx("TrueBusterMistressC_6", 0, 0, (!user_InFloor + 3 + user_InFloor * -(z - floorz)), random(-9, 9), random(-9, 9), random(15, 20), random(0, 359), SXF_TRANSFERTRANSLATION)
    stop
   End:
    TNT1 A 0
    stop
  }
}

actor TrueBusterMistressC_0 : BaseCorpseFX {
  Translation "192:192=123:123", "198:198=126:126", "165:165=151:151", "86:86=3:3", "4:4=95:95"
  ReactionTime 10
  States {
   Spawn:
    1H04 O 5
    goto Spawn1
   Spawn1:
    1H04 OOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOO 3 A_SpawnItemEx("MistressSouretShotFX", random(-20, 20), random(-20, 20), random(-2, 32), 0, 0, 0, 0, 32)
    1H04 O 0 A_CountDown
    loop
   Spawn2:
    "----" "###########################" 4 A_SpawnItemEx("MistressSouretShotFX", random(-8, 8), random(-8, 8), random(2, 18), 0, 0, 0, 0, 32)
    "----" "#" 0 A_CountDown
    loop
   Death:
    "----" "#" 1 A_Fadeout
    wait
  }
}

actor TrueBusterMistressC_1 : TrueBusterMistressC_0 {States {Spawn: 1H04 P 5
    goto Spawn2}}
actor TrueBusterMistressC_2 : TrueBusterMistressC_0 {States {Spawn: 1H04 Q 5
    goto Spawn2}}
actor TrueBusterMistressC_3 : TrueBusterMistressC_0 {States {Spawn: 1H04 R 5
    goto Spawn2}}
actor TrueBusterMistressC_4 : TrueBusterMistressC_0 {States {Spawn: 1H04 S 5
    goto Spawn2}}
actor TrueBusterMistressC_5 : TrueBusterMistressC_0 {States {Spawn: 1H04 T 5
    goto Spawn2}}
actor TrueBusterMistressC_6 : TrueBusterMistressC_0 {States {Spawn: 1H04 U 5
    goto Spawn2}}

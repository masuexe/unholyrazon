actor HalfPressHardman : BossBase {
  Player.ScoreIcon "UB050MUG"
  Player.SoundClass "HalfPressHardman"
  Player.ForwardMove 1.55, 1.55
  Player.SideMove 1.7, 1.7
  Player.JumpZ 15
  Player.MaxHealth 2460
  Health 2460
  Player.MorphWeapon "HalfPressHardman_W"
  States {
   Spawn:
    HARM A 0
    HARM B 1
    HARM A 1
    wait
   See:
    HARM BCDE 2
    goto Spawn
   Missile:
    HARM F 0 A_JumpIfInventory("HalfPressHardmanFlag", 10, "MissileQ_Down")
    HARM F 0 A_JumpIfInventory("HalfPressHardmanFlag", 1, "MissileQ_Up")
    HARM F 5
    HARM F 0 A_JumpIfInventory("HalfPressHardmanFlag", 2, "MissileQ_DownTurn")
    HARM G 4
    HARM G 0 A_JumpIfInventory("HalfPressHardmanFlag", 2, "MissileQ_Down")
    goto Spawn
   MissileQ_Up:
    HARM I 6  // 8
    HARM I 0 A_JumpIfInventory("HalfPressHardmanFlag", 2, "MissileQ_DownTurn")
    HARM G 4
    HARM G 0 A_JumpIfInventory("HalfPressHardmanFlag", 2, "MissileQ_Down")
    goto Spawn
   MissileQ_DownTurn:
    HARM JJJKKK 1 A_JumpIfInventory("VivifyDelay10", 1, "MissileQuaked")
    goto MissileQ_Down
   MissileQ_Down:
    HARM L 1 A_JumpIfInventory("VivifyDelay10", 1, "MissileQuaked")
    loop
   MissileQuaked:
    HARM M 1 A_JumpIfInventory("VivifyDelay5", 1, "MissileQ_GetUp")
    loop
   MissileQ_GetUp:
    HARM NKJ 3
    goto Spawn+3

   ClassPainQuake:
    HARM "#" 0 A_SpawnItemEx("DelayPainFX")
    HARM "#" 0 A_JumpIfInventory("HalfPressHardmanFlag", 2, "MissileQ_Down")
    goto MissileQ_Up
   ClassPain:
    HARM H 0 A_JumpIfInventory("HalfPressHardmanFlag", 1, "ClassPainQuake")
    goto MegamanPain
   ClassDeath:
    // HARM H 2
    HARM H 0
    goto MegamanDeath
  }
}

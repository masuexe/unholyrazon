// FinalSampiKingofKings
actor FinalSampi : BossBase {
  Player.ScoreIcon "UB402MUG"
  Player.SoundClass "FinalSampi"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 13
  Player.MaxHealth 30000
  Health 30000
  Player.WeaponSlot 1, "FinalSampi_W1"
  Player.WeaponSlot 2, "FinalSampi_W2"
  Player.WeaponSlot 3, "FinalSampi_W3"
  Player.WeaponSlot 4, "FinalSampi_W4"
  Player.WeaponSlot 5, "FinalSampi_W5"
  Player.WeaponSlot 6, "FinalSampi_W6"
  Player.WeaponSlot 7, "FinalSampi_W7"
  States {
   Spawn:
    8E02 A 0
    8E02 B 1
    8E02 A 1
    goto Spawn+2
   See:
    8E02 BCDE 5
    goto Spawn
   Missile:
    8E02 F 5
    8E02 G 4
    goto Spawn+2
   ClassPain:
    8E02 HHHHHHHHHH 2 A_SpawnItemEx("SampiPainSpawner")
    goto Spawn
    // Goto MegamanPain
   ClassDeath:
    8E02 H 0
    goto MegamanDeath
  }
}

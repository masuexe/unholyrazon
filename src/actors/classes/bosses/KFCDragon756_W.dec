actor CFaKeFriedChicken : CustomInventory {
  Translation "192:192=248:248", "198:198=217:217", "199:199=222:222"
  inventory.pickupmessage "Delicious but fattening fried chicken! (150)"
  ReactionTime 8
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    8P69 A 1050 A_CountDown
   Pickup:
    TNT1 A 0 A_PlaySound("GNT/FoodGet", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 150)
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_CFakeChickenObesity") //("core_setactorproperty",APROP_Speed,17,20)
    TNT1 A 0 A_SetScale(scalex+0.3, scaley)
    stop
  }
}
actor KJBBulletReloadFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("KJBBulletReloadFX", 0, 4, 28, frandom(0, 3), 0, frandom(3, 7), random(0, 23)*15, 1)
    stop
  }
}
actor KJBBulletReloadFX : BasicGraphicEffectM {
  -NOGRAVITY
  +THRUACTORS
  +FLOORCLIP
  +HEXENBOUNCE
  BounceCount 5
  BounceFactor 0.65
  WallBounceFactor 0.8
  Damage (0)
  Height 4
  Radius 4
  Speed 30
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    FAKR MNOPQRST 1
    goto Spawn+2
  }
}
actor SixWalnutsFX : BasicGraphicEffectM {
  Gravity 1.0
  scale 1.0
  States {
   Spawn:

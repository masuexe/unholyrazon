actor CFaKeFriedChicken : CustomInventory {
  Translation "192:192=248:248", "198:198=217:217", "199:199=222:222"
  inventory.pickupmessage "Delicious but fattening fried chicken! (150)"
  ReactionTime 8
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    8P69 A 1050 A_CountDown
   Pickup:
    TNT1 A 0 A_PlaySound("GNT/FoodGet", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 150)
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_CFakeChickenObesity") //("core_setactorproperty",APROP_Speed,17,20)
    TNT1 A 0 A_SetScale(scalex+0.3, scaley)
    stop
  }
}

actor KFCDragon756_W_NormalBar : NormalBar {args 71, 73}
actor KFCDragon756_W_SecondBar : SecondBar {args 248, 217}
actor KFCDragon756_W_ReloadIcon : ReloadIcon {Tag "R069B0"}
actor KFCDragon756_W_Pissed_NormalBar : NormalBar {args 42, 46}
actor KFCDragon756_W_Pissed_SecondBar : KFCDragon756_W_SecondBar {}
actor KFCDragon756_W_Pissed_ReloadIcon : KFCDragon756_W_ReloadIcon {}

actor KFCDragon756_W : BaseUnholyBossWep { // DickGnawer_W
  Tag "$TAG_Boss084_W"
  Obituary "%o didn't bring Power Shield to the duel with \c[u2]KFC\c[d8]Dragon\c[w8]756\c- (%k)."  // P♂wer Shield
  Inventory.Pickupmessage "\cmHow to KJJ?"
  weapon.ammotype "DickGnawerAmmo"
  weapon.ammotype2 "UnholyPower1500"
  States {
   Spawn:
    8H00 [ 1
    wait

   Deselect:
    FAKR A 0
    goto DeselectSwap
   Select:
    FAKR A 0
    goto SelectSwap

   Ready:
    FAKR A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    FAKR A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, KFCDRAGON756_DYE)
    FAKR A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, true, ELP_NATIVE)
    FAKR A 0 A_TakeInventory("IsPissedFlag")
    FAKR A 0 A_GiveInventory("DickGnawerAmmo", 10)
    FAKR A 0 A_GunFlash("Flash", true)
    goto ReadyX0

   ReadyX0:
    FAKR A 0 A_Jumpifinventory("DickGnawerAmmo", 1, "ReadyX1")
    FAKR A 2 A_WeaponReady(4 + 16)
    loop
   ReadyX1:
    FAKR A 0 A_Jumpifinventory("DickGnawerAmmo", 0, "ReadyX2")
    FAKR A 2 A_WeaponReady(16)
    loop
   ReadyX2:
    FAKR A 2 A_WeaponReady
    loop

   Flash:
    TNT1 A 1 A_GiveInventory("KFCDragon756HealthCheck_P")
    loop

   Fire:
    FAKR A 0 A_TakeInventory("DickGnawerAmmo", 1, 1)
    FAKR E 0 A_PlaySoundEx("misc/fakeshot", "Weapon")
    FAKR E 0 A_FireCustomMissile("KJBBullet", 0, 1, 8, 0)
    FAKR E 0 A_Refire("FakemenCant")
    FAKR E 0 A_ClearRefire
    FAKR BCD 1
    Goto ReadyX0

   FakemenCant:
    FAKR BCD 1
    FAKR A 0 A_Refire("CantHold")
    Goto ReadyX0
   CantHold:
    FAKR A 1
    FAKR A 0 A_Refire("CantHold")
    goto FireEnd
   FireEnd:
    FAKR A 1 A_ClearRefire
    FAKR A 0
    FAKR A 1 A_WeaponReady(14)
    Goto ReadyX0

   DeliciousFriedChicken:
    FAKR A 0 A_TakeInventory("UnholyPower1500", 3000)
    FAKR A 1 Offset(0, 42)
    FAKR A 1 Offset(0, 52)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 72)
    FAKR A 2 Offset(0, 82)
    FAKR A 3 Offset(0, 82)
    FAKR A 0 A_FireCustomMissile("CFaKeChickenPot", 0, 0, 0, 10)
    FAKR A 0
    Goto ReadyX0

   AltFire:
    FAKR A 0 A_JumpIfInventory("UnholyPower1500", 1500, "DeliciousFriedChicken")
    FAKR E 0 A_JumpIfInventory("CFaKeBatonFlag", 2, "FireBaton3")
    FAKR E 0 A_JumpIfInventory("CFaKeBatonFlag", 1, "FireBaton2")
    goto FireBatonStart

   FireBatonStart:
    FAKR A 1 Offset(30, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(60, 82) A_GiveInventory("CFaKeBatonFlag", 1)
    goto FireBaton2
   FireBaton2:
    FAKR F 0 A_PlaySoundEx("SoRage123/Punch", "Weapon")
    FAKR F 1 Offset(110, 84)
    FAKR F 1 Offset(96, 75) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR F 1 Offset(81, 66) A_FireCustomMissile("CFaKeBatonSwing1", 0, 0, 0, 0)
    FAKR F 1 Offset(65, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR F 1 Offset(48, 45)
    FAKR F 1 Offset(30, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(8, 22)
    FAKR G 1 Offset(-18, 12) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(-48, 3)
    FAKR G 1 Offset(-82, -5) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(-120, -12)
    FAKR G 1 Offset(-162, -18) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(-208, -23)
    FAKR G 1 Offset(-258, -27) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 6 A_GiveInventory("CFaKeBatonFlag", 1)
    goto ReadyBaton
   FireBaton3:
    FAKR I 0 A_PlaySoundEx("SoRage123/Punch", "Weapon")
    FAKR I 1 Offset(-9, 21)
    FAKR I 1 Offset(1, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR I 1 Offset(12, 42) A_FireCustomMissile("CFaKeBatonSwing1", 0, 0, 0, 0)
    FAKR I 1 Offset(24, 53) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR I 1 Offset(37, 65)
    FAKR I 1 Offset(51, 77) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(16, 48)
    FAKR J 1 Offset(30, 65) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(43, 84)
    FAKR J 1 Offset(55, 105) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(66, 128)
    FAKR J 1 Offset(76, 153) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(85, 180)
    FAKR J 1 Offset(93, 209) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 6 A_TakeInventory("CFaKeBatonFlag", 1)
    goto ReadyBaton

   ReadyBaton:
    TNT1 A 30 A_WeaponReady
    FAKR A 0 A_TakeInventory("CFaKeBatonFlag", 9)
    FAKR A 1 Offset(60, 82)
    FAKR A 1 Offset(30, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 0 A_GiveInventory("CFaKeBatonFlag", 1)
    goto ReadyX0

   Reload:
    FAKR A 2
    FAKR A 1 Offset(0, 42) A_TakeInventory("CFaKeBatonFlag", 99)
    FAKR A 1 Offset(0, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 2 Offset(0, 82)
    FAKR A 3 Offset(0, 82) A_PlaySound("wep/SmokeB_Load2", "Body")
    FAKR DCB 2
    FAKR A 4
   QLoad:
    FAKR A 0
    FAKR A 1 Offset(0, 82) A_PlaySoundEx("wep/SmokeB_Load1", "Body")
    FAKR BC 1 Offset(0, 82)
    FAKR D 0 A_SpawnItemEx("KJBBulletReloadFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    FAKR D 1 Offset(0, 82) A_Giveinventory("DickGnawerAmmo", 1)
    FAKR A 1 Offset(0, 82)
    FAKR A 0 A_Jumpifinventory("DickGnawerAmmo", 0, 1)
    Goto QLoad
    FAKR A 0
    FAKR A 1 Offset(0, 82)
    FAKR A 1 Offset(0, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 42)
    FAKR A 0 A_WeaponReady(14)
    FAKR A 1 A_PlaySoundEx("wep/SmokeB_Load2", "Body")
    Goto ReadyX0
  }
}

// HP < 2 → swap here; Ready runs PowerOfSixWalnuts once, then mad kit.
actor KFCDragon756_W_Pissed : KFCDragon756_W {
  States {
   Ready:
    FAKR A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    FAKR A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, KFCDRAGON756_DYE)
    FAKR A 0 A_JumpIfInventory("KFCDragon756GetUpDone_F", 1, "ReadyAfterGetUp")
    FAKR A 0 A_JumpIfInventory("IsPissedFlag", 1, "ReadyAfterGetUp")
    goto PowerOfSixWalnuts
   ReadyAfterGetUp:
    FAKR A 0 A_GunFlash("Flash", true)
    goto ReadyMadX

   ReadyX0:
    goto ReadyMadX
   ReadyMadX:
    FAKR A 0 A_Jumpifinventory("DickGnawerAmmo", 0, "ReadyMadX2")
    FAKR A 2 A_WeaponReady(16)
    loop
   ReadyMadX2:
    FAKR A 2 A_WeaponReady
    loop

   Flash:
    TNT1 A 1
    loop

   Fire:
    FAKR A 0 A_JumpIfInventory("DickGnawerAmmo", 0, "DickGrawingFire")
    FAKR E 0 A_PlaySoundEx("misc/fakeshot", "Weapon")
    FAKR F 0 A_FireCustomMissile("PissedOffKJBBullet", 0, 1, 8, 0)
    FAKR E 0 A_Refire("CFaKemenCant")
    FAKR E 0 A_ClearRefire
    FAKR BCD 1
    Goto ReadyMadX

   DickGrawingFire:
    FAKR B 0 A_GiveInventory("VivifyFlag1")
    FAKR B 0 A_ReFire(1)
   DickGrawingFireLoop:
    FAKR B 0 A_JumpIfInventory("DickGnawerAmmo", 1, 1)
    Goto DickGrawingFireEnd
    FAKR B 0 A_GiveInventory("DickGrawingFire_P")
    FAKR B 1
    FAKR C 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR D 1
    FAKR A 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 0
    loop
   DickGrawingFireEnd:
    FAKR B 0 A_TakeInventory("VivifyFlag1")
    Goto ReadyMadX

   CFaKemenCant:
    FAKR BCD 1
    FAKR A 0 A_Refire("CCantHold")
    Goto ReadyMadX
   CCantHold:
    FAKR A 1
    FAKR A 0 A_Refire("CCantHold")
    goto CFireEnd
   CFireEnd:
    FAKR A 1 A_ClearRefire
    FAKR A 1 A_WeaponReady(14)
    Goto ReadyMadX

   DeliciousFriedChicken:
    FAKR A 0 A_TakeInventory("UnholyPower1500", 3000)
    FAKR A 1 Offset(0, 42)
    FAKR A 1 Offset(0, 52)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 72)
    FAKR A 2 Offset(0, 82)
    FAKR A 3 Offset(0, 82)
    FAKR A 0 A_FireCustomMissile("CFaKeChickenPotX", 0, 0, 0, 10)
    FAKR A 0
    Goto ReadyMadX

   AltFire:
    FAKR A 0 A_JumpIfInventory("UnholyPower1500", 1500, "DeliciousFriedChicken")
    FAKR E 0 A_JumpIfInventory("CFaKeBatonFlag", 2, "FireBatonX3")
    FAKR E 0 A_JumpIfInventory("CFaKeBatonFlag", 1, "FireBatonX2")
    goto FireBatonStartX

   FireBatonStartX:
    FAKR A 1 Offset(30, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(60, 82) A_GiveInventory("CFaKeBatonFlag", 1)
    goto FireBatonX2
   FireBatonX2:
    FAKR F 0 A_PlaySoundEx("SoRage123/Punch", "Weapon")
    FAKR F 1 Offset(110, 84)
    FAKR F 1 Offset(96, 75) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR F 1 Offset(81, 66) A_FireCustomMissile("CFaKeBatonSwing1", 0, 0, 0, 0)
    FAKR F 1 Offset(30, 33) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(8, 22)
    FAKR G 1 Offset(-82, -5) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR G 1 Offset(-120, -12)
    FAKR G 1 Offset(-258, -27) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 2 A_GiveInventory("CFaKeBatonFlag", 1)
    goto ReadyBatonX
   FireBatonX3:
    FAKR I 0 A_PlaySoundEx("SoRage123/Punch", "Weapon")
    FAKR I 1 Offset(-9, 21)
    FAKR I 1 Offset(1, 31) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR I 1 Offset(12, 42) A_FireCustomMissile("CFaKeBatonSwing1", 0, 0, 0, 0)
    FAKR I 1 Offset(51, 77) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(16, 48)
    FAKR J 1 Offset(55, 105) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR J 1 Offset(66, 128)
    FAKR J 1 Offset(93, 209) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 2 A_TakeInventory("CFaKeBatonFlag", 1)
    goto ReadyBatonX

   ReadyBatonX:
    TNT1 A 1 A_WeaponReady
    FAKR A 0 A_TakeInventory("CFaKeBatonFlag", 9)
    FAKR A 1 Offset(60, 82)
    FAKR A 1 Offset(30, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 0 A_GiveInventory("CFaKeBatonFlag", 1)
    goto ReadyMadX

   Reload:
    FAKR A 2
    FAKR A 1 Offset(0, 42) A_TakeInventory("CFaKeBatonFlag", 99)
    FAKR A 1 Offset(0, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 2 Offset(0, 82)
    FAKR A 3 Offset(0, 82) A_PlaySound("wep/SmokeB_Load2", "Body")
    FAKR DCB 2
    FAKR A 4
   QLoad:
    FAKR A 0
    FAKR A 1 Offset(0, 82) A_PlaySoundEx("wep/SmokeB_Load1", "Body")
    FAKR BC 1 Offset(0, 82)
    FAKR D 0 A_SpawnItemEx("KJBBulletReloadFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    FAKR D 1 Offset(0, 82) A_Giveinventory("DickGnawerAmmo", 1)
    FAKR A 1 Offset(0, 82)
    FAKR A 0 A_Jumpifinventory("DickGnawerAmmo", 0, 1)
    Goto QLoad
    FAKR A 0
    FAKR A 1 Offset(0, 82)
    FAKR A 1 Offset(0, 72) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 62)
    FAKR A 1 Offset(0, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    FAKR A 1 Offset(0, 42)
    FAKR A 0 A_WeaponReady(14)
    FAKR A 1 A_PlaySoundEx("wep/SmokeB_Load2", "Body")
    Goto ReadyMadX

   PowerOfSixWalnuts:
    TNT1 A 0 A_GiveInventory("KFCDragon756PainFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, ELP_NATIVE)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    TNT1 A 32
    TNT1 A 0 A_SpawnItemEx("SixWalnutsFX", 0, 0, 0, 0, 0, 20)
    TNT1 A 64
    TNT1 A 4 A_Stop
    TNT1 A 0 ThrustThingZ(0, 150, 0, 0)
    Goto UseYourBrainOften
   UseYourBrainOften:
    TNT1 A 0 A_GiveInventory("KFCHealthGiver_P")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "DrinkMoreSixWalnuts")
    TNT1 A 1
    loop
   DrinkMoreSixWalnuts:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", KFCDRAGON756_PISSED_DYE)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_SetActorProperty", APROP_Speed, 1, 1)
    TNT1 A 0 A_GiveInventory("UH_150_SpeedPowerGiver")
    TNT1 A 0 A_GiveInventory("CosmeticBossSpeedTrail")
    TNT1 A 0 A_SetScale(2.5, scaleY)
    TNT1 A 0 A_GiveInventory("KFCDragon756GetUpDone_F")
    TNT1 A 0 A_TakeInventory("KFCDragon756PainFlag")
    Goto ReadyMadX
  }
}

actor DickGnawerAmmo : Ammo {
  Inventory.MaxAmount 10
  +INVENTORY.IGNORESKILL
}

actor KFCDragon756HealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("KFCDragon756_W_Pissed", 1, "NoSwap")
    TNT1 A 0 A_JumpIfInventory("KFCDragon756PainFlag", 1, "NoSwap")
    TNT1 A 0 A_GiveInventory("KFCDragon756SwapPissed_P")
    stop
   NoSwap:
    TNT1 A 0
    stop
  }
}

actor KFCDragon756SwapPissed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("KFCDragon756GetUpDone_F")
    TNT1 A 0 A_GiveInventory("KFCDragon756_W_Pissed")
    TNT1 A 0 A_TakeInventory("KFCDragon756_W")
    stop
  }
}

actor KFCDragon756GetUpDone_F : UOnce {}
actor KFCDragon756PainFlag : UOnce {}

actor CFaKeBatonFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 2
}
actor DickGrawingFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DickGnawerAmmo", 1, 1)  // the cost of endless ammo lol
    // TNT1 A 0 A_TakeInventory("DickGnawerAmmo", 1)
    TNT1 A 0 A_PlaySoundEx("weapon/SpyFire", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PissedOffKJBBulletX", 0, 1, 8, 0)
    stop
  }
}
actor KFCHealthGiver_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.65, "GiveHealth")
    goto Pickup3
   GiveHealth:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 45+random(0, 9))
    stop
   Pickup3:
    TNT1 A 0 A_GiveInventory("IsPissedFlag")
    stop
  }
}
actor KJBBullet : BasicFastprojectile {
  Translation "212:215=71:71", "192:192=4:4", "198:198=71:71"//
  damagetype "KFCDragon756"
  Obituary "%o was gunned down by \c[u2]KFC\c[d8]Dragon\c[w8]756\c- (%k)'s CFaKe Revolver."
  Damage (random(100, 200))
  radius 14
  height 15
  Speed 120
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
   Fly:
    BASB A 1 A_SpawnItemEx("KJBBulletFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 1 A_PlaySoundEx("MMBN6/ShotHit", "SoundSlot5")
    8P51 BCDEF 1
    stop
  }
}
actor PissedOffKJBBullet : KJBBullet {
  Obituary "%o was riddled with bullets by \c[u2]KFC\c[d8]Dragon\c[w8]756\c- (%k)'s Circuited CFaKe Revolver."
  Translation "212:215=42:42", "192:192=4:4", "198:198=42:42"//
  Damage (random(120, 240))
  Speed 240
  States {
   Death:
    TNT1 A 0
    8P51 B 0 A_PlaySoundEx("MMBN6/ShotHit", "SoundSlot5")
    8P51 BCDEF 1
    stop
  }
}
actor PissedOffKJBBulletX : KJBBullet {
  Obituary "%o was riddled with bullets by \c[u2]KFC\c[d8]Dragon\c[w8]756\c- (%k)'s Circuited CFaKe Revolver."
  Translation "212:215=42:42", "192:192=4:4", "198:198=42:42"//
  Damage (random(80, 150))
  Speed 240
  States {
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    TNT1 A 0 A_Explode(random(100, 200), 148, 0, 0, 24)
    X_8B ABCDEF 2
    stop
  }
}
actor KJBBulletFX : BasicGraphicEffect {
  renderstyle add
  states {
   SpawnFrame:
    BASB A 1 A_FadeOut(0.25)
    loop
  }
}
actor CFaKeBatonSwing1 : ProjSpawnFuncActorFast {
  Damagetype "KFCDragon756"
  Obituary "%o was beaten to a pulp by \c[u2]KFC\c[d8]Dragon\c[w8]756\c- (%k)'s CFaKe Baton."
  +DONTSPLASH
  +DONTBLAST
  damage (random(525, 575) + 500*(CallACS("rz_CountInv_CFaKeBatonFlag",2)))
  Radius 14
  Height 14
  speed 105
  scale 2.5
  States {
   Spawn:
    TNT1 A 1
    stop
   Crash:
   XDeath:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_Jump(256, 1, 3)
    TNT1 A 0 A_PlaySound("weapon/fakewhack1", 2, 1.0)
    TNT1 A 1 A_PlaySound("weapon/fakewhack1", 1, 1.0)
    goto Death+3
    TNT1 A 0 A_PlaySound("weapon/fakewhack2", 2, 1.0)
    TNT1 A 1 A_PlaySound("weapon/fakewhack2", 1, 1.0)
    goto Death+3
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySound("weapon/fakewhack3", 2, 1.0)
    TNT1 A 1 A_PlaySound("weapon/fakewhack3", 1, 1.0)
    //QMFX ABC 2
    QMFX DEFGH 2 bright
    stop
  }
}
actor CFaKeChickenPot : BasicProjectile {
  Translation "192:192=248:248", "198:198=217:217", "199:199=222:222"
  +THRUACTORS
  +THRUGHOST
  +DONTBLAST
  -NOGRAVITY
  +RIPPER
  Damage (random(400, 800))
  Speed 35
  Radius 14
  Height 16
  Scale 2.5
  DamageType "KJBPot"
  Obituary "%o did not know %k's chicken-frying pot is very hot!"
  States {
   Spawn:
    // 8P69 B 0 ThrustThingZ(0, 25, 0, 0)
    8P69 B 1
    wait
   Death:
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 0, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 45, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 90, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 135, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 180, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 225, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 270, 0)
    8P69 B 0 A_SpawnItemEx("CFaKeFriedChicken", 0, 0, 0, 10, 4, 8, 315, 0)
    8P69 B 1
    stop
  }
}
actor CFaKeChickenPotX : CFaKeChickenPot {
  Damage (random(800, 1200))
  States {
   Death:

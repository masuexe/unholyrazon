// ShinHelltatoruHellBotBoss
actor ShinHellbot : BossBase {
  Player.ScoreIcon "UB008MUG"
  Player.SoundClass "shinhellbot"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.JumpZ 15
  Player.MaxHealth 1000
  Health 1000
  Player.MorphWeapon "ShinHellbot_W"
  States {
   Spawn:
    8A08 A 0
    8A08 B 1
    8A08 A 1
    goto Spawn+2
   See:
    8A08 BCDE 5
    goto Spawn
   Missile:
    8A08 F 5
    8A08 G 4
    goto Spawn+2
   ClassPain:
    8A08 H 0
    goto MegamanPain
   ClassDeath:
    8A08 H 0
    goto MegamanDeath
  }
}

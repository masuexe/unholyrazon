actor GemBanker : BossBase {
  Player.ScoreIcon "UB022MUG"
  Player.SoundClass "GemBanker"
  Player.DamageScreenColor "cyan"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 13
  Player.MaxHealth 2500
  Health 2500
  Player.MorphWeapon "GemBanker_W"
  States {
   Spawn:
    CRYM A 0
    CRYM B 1
    CRYM A 1
    goto Spawn+2
   See:
    CRYM BCDE 5
    goto Spawn
   Missile:
    CRYM F 5
    CRYM G 4
    goto Spawn+2
   ClassPain:
    CRYM H 0
    goto MegamanPain
   ClassDeath:
    CRYM H 0
    goto MegamanDeath
  }
}

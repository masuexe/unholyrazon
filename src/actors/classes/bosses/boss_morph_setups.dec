// Initial boss effects formerly in Ready. Run by the registered server morph hook.
// Keep after class includes: pickups reference the classes' inventories/helpers.

actor UH_AbePenny_MorphSetup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_POWER_LIMIT, 3000)
    stop
  }
}


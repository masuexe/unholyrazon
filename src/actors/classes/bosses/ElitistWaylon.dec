actor ElitistWaylon : BossBase
{
Player.ScoreIcon "UB007MUG"
player.soundclass "elitistwaylon"
player.forwardmove 1.15, 1.15
player.sidemove 1.15, 1.15
player.jumpz 14
Player.MaxHealth 2000
Health 2000
player.morphweapon "ElitistWaylon_W"
PainSound "classes/DerpyHit"
States
{
Spawn:
ENKR A 0
ENKR B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
SpawnFrame:
ENKR A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
loop
See:
ENKR BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
Goto Spawn
Air:
ENKR I 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
loop
Missile:
Missile_1: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
Missile_2: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
Missile_3: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
Missile_4: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
Missile_5: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
Missile_6: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
Missile_7: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
Missile_8: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
Missile_9: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
Goto SpawnFrame
Missile_Air_1: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
Missile_Air_2: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
Missile_Air_3: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
Missile_Air_4: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
Missile_Air_5: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
Missile_Air_6: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
Missile_Air_7: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
Missile_Air_8: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_9")
Missile_Air_9: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
Goto Air
ClassPain:
ENKR H 0
Goto MegamanPain
ClassDeath:
ENKR H 0
goto MegamanDeath
}
}

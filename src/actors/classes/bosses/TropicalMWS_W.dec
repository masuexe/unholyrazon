actor TropicalBlitzKrieg : BasicExplosion {
  Translation "200:203=214:214", "204:208=218:218"

  Alpha 0.75
  Renderstyle "Translucent"
  ReactionTime 50
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    MWSZ P 0 A_PlaySoundEX("weapon/waterwave", "Weapon")
    MWSZ P 0 A_SpawnItemEx("MelonBombingA", random(1000, -1000), random(1000, -1000), 450, 0, 0, random(-25, -50))
    MWSZ PP 1 A_SpawnItemEx("MelonBombingB", 0, 0, 40, random(-35, 35), random(-35, 35), random(-35, 35), 0, 0, 0)
    MWSZ Q 0 A_SpawnItemEx("MelonBombingA", random(1000, -1000), random(1000, -1000), 450, 0, 0, random(-25, -50))
    MWSZ QQ 1 A_SpawnItemEx("MelonBombingB", 0, 0, 40, random(-35, 35), random(-35, 35), random(-35, 35), 0, 0, 0)
    MWSZ Q 0 A_CountDown
    loop
   Death:
    TNT1 A 0
    stop
  }
}


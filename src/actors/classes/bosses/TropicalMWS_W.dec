actor TropicalMWS_W_ScriptBar : ScriptBar {}
actor TropicalMWS_W : BaseUnholyBossWep {
  Tag "$TAG_Boss110_W"
  Obituary "%o donated a cow to \cfTropical \ckMWS\c- (%k)."
  Inventory.Pickupmessage "\cjWhoa, chill out brah!"
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo250"
  States {
   Spawn:
    8I10 [ 1
    wait

   Deselect:
    8I10 A 0
    goto DeselectSwap
   Select:
    8I10 A 0
    goto SelectSwap

   Ready:
    8I10 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8I10 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, TROPICALMWS_DYE)
    8I10 A 6
    goto ReadyX
   ReadyX:
    8I10 A 0 A_JumpIfInventory("CocoSliderCheck", 1, "SlideBegin")
    8I10 A 0 A_JumpIfInventory("UnholyBossAmmo200", 10, "ReadyX2")
    8I10 A 2 A_GiveInventory("TropicalMWS_Ready8_P")
    loop
   ReadyX2:
    8I10 A 0 A_JumpIfInventory("CocoSliderCheck", 1, "SlideBegin")
    8I10 A 2 A_GiveInventory("TropicalMWS_Ready0_P")
    loop

   Reload:
    8I10 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "Melon")
    goto ReadyX
   Melon:
    8I10 A 0 A_PlaySoundEx("S_Spin/Surprise", "Body")
    8I10 A 0 A_TakeInventory("UnholyPower1000", 1000)
    8I10 A 2 A_FireCustomMissile("TropicalBlitzKrieg", 0, 0, 0, 0)
    8I10 A 1
    goto ReadyX

   Fire:
    8I10 A 0 A_JumpIfInventory("CocoSliderCheck", 1, "SlideBegin")
    8I10 B 0 A_PlaySoundEx("wep/ReccaHit", "Weapon")
    8I10 B 0 A_FireCustomMissile("CoconutProjectile", 0, 0, 8, 0)
    8I10 BCBAAAA 3 A_GiveInventory("UnholyBossAmmo200", 2)
    Goto ReadyX
   Altfire:
    8I10 A 0 A_JumpIfInventory("CocoSliderCheck", 1, "SlideWhoops")
    8I10 A 0 A_JumpIfInventory("UnholyBossAmmo200", 10, "EXPENSIVEJUICE")
    Goto ReadyX
   EXPENSIVEJUICE:
    8I10 C 0 A_JumpIfInventory("CocoSliderCheck", 1, "SlideWhoops")
    8I10 C 0 A_TakeInventory("UnholyBossAmmo200", 10)
    8I10 C 0 A_PlaySoundEx("weapon/waterwave", "Weapon")
    8I10 CC 0 A_FireCustomMissile("IllegalPineappleJuice", random(-3, 3), 0, 8, 0, 0, random(-3, 3))
    8I10 C 2
    8I10 B 0 A_PlaySoundEx("weapon/waterwave", "Weapon")
    8I10 BB 0 A_FireCustomMissile("IllegalPineappleJuice", random(-3, 3), 0, 8, 0, 0, random(-3, 3))
    8I10 B 2
    Goto ReadyX
   SlideWhoops:
    8I10 A 0 A_TakeInventory("CocoFaggoFlags", 2)
    8I10 A 0 A_SpawnItemEx("CoconutSliderDamage", 24, 0, 12, momx, momy, momz, 0, 8, 0)
    OILL A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "SlideWhoopsRage")
    8I10 B 1 A_WeaponReady(8)
    8I10 A 0 A_GiveInventory("ThoseDamnBananas_P", 1)
    8I10 C 1 A_WeaponReady(8)
    8I10 A 0 A_GiveInventory("ThoseDamnBananas_P", 1)
    8I10 A 0 A_JumpIfInventory("CocoFaggoFlags", 1, "Slide")
    Goto SlideEnd
   SlideWhoopsRage:
    8I10 C 1 A_WeaponReady(8)
    8I10 AA 0 A_GiveInventory("ThoseDamnBananas_P", 1)
    8I10 A 0 A_JumpIfInventory("CocoFaggoFlags", 1, "Slide")
    Goto SlideEnd

   SlideBegin:
    8I10 A 0 A_JumpIfInventory("CocoJump", 1, "CocoPogo")
    8I10 A 0 A_GiveInventory("CocoFaggoFlags", 30)
    8I10 A 0 A_GiveInventory("CocoJump", 1)
    8I10 A 0 A_SpawnItemEx("CoconutSliderWarper", 24, 0, 2, 0, 0, 0, 0, 0)
    8I10 A 0 A_GunFlash
    8I10 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    8I10 A 0 A_JumpIfInventory("CocoFaggoFlags", 1, "Slide")
    Goto SlideEnd
   Slide:
    8I10 A 0 A_TakeInventory("CocoFaggoFlags", 1)
    8I10 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8I10 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    8I10 A 0 A_SpawnItemEx("PineAnapalm", 0, 0, 32, random(-25, 25), random(-25, 25), random(-25, 25), 0, 0, 0)
    Goto SlideContinue
   SlideContinue:
    8I10 A 0 A_SpawnItemEx("CoconutSliderDamage", 24, 0, 12, momx, momy, momz, 0, 8, 0)
    8I10 A 2 A_WeaponReady
    8I10 A 0 A_JumpIfInventory("CocoFaggoFlags", 1, "Slide")
    Goto SlideEnd
   CocoPogo:
    8I10 A 0 A_Recoil(-10)
    8I10 A 0 ThrustThingZ(0, 45, 0, 0)
    8I10 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "VorcanicDeVipah")
    8I10 A 0 A_FireCustomMissile("PineAnapalm", 0, 0, 8, 0)
    8I10 A 0 A_FireCustomMissile("PineAnapalm", 16, 0, 8, 0)
    8I10 A 0 A_FireCustomMissile("PineAnapalm", -16, 0, 8, 0)
    Goto SlideEnd
   VorcanicDeVipah:
    8I10 A 0 A_TakeInventory("UnholyBossAmmo250", 250)
    8I10 A 0 A_FireCustomMissile("MixedTropicalPunch", 0, 0, 8, 0)
    Goto SlideEnd
   SlideEnd:
    8I10 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8I10 A 0 A_StopSound(CHAN_WEAPON)
    8I10 A 0 A_TakeInventory("CocoFaggoFlags", 32)
    8I10 A 0 A_TakeInventory("CocoSliderCheck")
    8I10 A 0 A_TakeInventory("CocoJump")
    8I10 A 10
    goto ReadyX

   Flash:
    TNT1 A 0 A_JumpIfInventory("OilBoat", 1, 7)
    TNT1 A 0 A_GiveInventory("OilBoat", 1)
    TNT1 A 0 A_PlaySoundEx("weapon/OilSlider", "Weapon")
    8I10 GFED 2 A_ChangeVelocity(40, 0, momz, 3)
    8I10 D 0 A_JumpIfInventory("MWSSoundTime", 1, 3)
    8I10 D 0 A_PlaySoundEx("weapon/OilSlider", "Weapon")
    8I10 D 0 A_GiveInventory("MWSSoundTime", 1)
    8I10 D 2 A_ChangeVelocity(40, 0, momz, 3)  // A_GiveInventory("OilSliderUThrust",1)
    8I10 D 0 A_JumpIfInventory("CocoSliderCheck", 1, "Flash")
    8I10 EFG 2 A_TakeInventory("OilBoat")
    stop
  }
}


actor CocoFaggoFlags : Inventory {
  inventory.amount 1
  inventory.maxamount 30
}

actor CocoSliderCheck : Once {}

actor CocoJump : Once {}
actor MWSSoundTime : Powerup {powerup.duration 6}  // readded for now, the original is just OilSoundTimeU

actor TropicalMWS_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    stop
  }
}
actor TropicalMWS_Ready8_P : TropicalMWS_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}


actor MixedTropicalPunch : BasicProjectile {
  Translation "192:192=180:180", "198:198=188:188"
  damagetype "MWS_FruitFling"
  Obituary "%o was sent flying by \cfTropical \ckMWS\c- (%k)'s Kool-aid Hawaiian Punch."
  +SKYEXPLODE
  +EXPLODEONWATER
  RenderStyle "Translucent"
  Alpha 0.98
  Damage (270)
  Radius 24
  Height 14
  Speed 75
  scale 3.5
  States {
   Spawn:
    X_0E I 2
    X_0E I 1 A_SpawnItemEx("MixedTropicalPunchFX", 64, 0, 0, momx/7, momy/7, momz/7, 0, 9)
    X_0E K 2
    loop
   Death:
    X_0E I 0
    X_0E I 1 A_SpawnItemEx("MixedTropicalPunchBoom")
    stop
  }
}

Actor MixedTropicalPunchFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 1
    X_0E M 3
    X_0E N 5
    X_0E N 1 A_FadeOut(0.5)
    wait
  }
}

actor MixedTropicalPunchBoom : BasicExplosion {
  Translation "192:192=180:180", "198:198=188:188"
  damagetype "MWS_FruitFling"
  Obituary "%o was drenched by \cfTropical \ckMWS\c- (%k)'s Kool-aid Explosion."
  Scale 3.5
  States {
   Spawn:
    X_8B A 0
    X_8B A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    X_8B A 0 A_Explode(150, 196, 0)
    X_8B AABBCCDDEEFF 1 A_SpawnItemEx("MixedTropicalPunchBoom2", random(-120, 120), random(-120, 120), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}

actor MixedTropicalPunchBoom2 : MixedTropicalPunchBoom {
  Damagetype "MWS_Fruit"
  Scale 2.5
  States {
   Spawn:
    X_8B A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    X_8B A 0 Radius_Quake(3, 35, 0, 50, 0)
    X_8B A 0 A_Explode(100, 128, 0)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

Actor IllegalPineappleJuice : BasicProjectile {
  Translation "192:192=208:208", "198:198=248:248", "199:199=218:218"
  Damagetype "MWS_Fruit"
  Obituary "%o drowned on \cfTropical \ckMWS\c- (%k)'s Illegal Pineapple Juioe."
  +RIPPER
  RenderStyle Translucent
  Alpha 0.85
  Damage (10)  // 25
  Radius 10
  Height 10
  Speed 26
  States {
   Spawn:
    TNT1 A 2
    6P37 ABCD 2 A_ScaleVelocity(1.05)
    Goto Spawn+1
   Death:
    TNT1 A 0
    stop
  }
}


actor CoconutProjectile : BasicProjectile {
  Translation "202:202=48:48", "199:199=52:52", "192:192=165:165", "198:198=234:234"
  damagetype "MWS_Fruit"
  Obituary "%o's teeth were no more by \cfTropical \ckMWS\c- (%k)'s Coconutter."
  Damage (165)
  Height 8
  Radius 8
  Scale 2.0
  speed 40
  States {
   Spawn:
    8Q10 ABCDEFGH 2 A_ScaleVelocity(1.08)
    loop
   Death:
    TNT1 A 0 A_JumpIf(ceilingz-z<=8, "Ceiling")
    TNT1 A 0
    TNT1 AAAAA 0 A_SpawnItemEx("CocoBlobShot2", 0, 0, 8, random(-20, 20), random(-20, 20), random(-20, 20))
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(95, 128, 0)
    TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorY_Tic2", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
   Ceiling:
    TNT1 AAAAA 0 A_SpawnItemEx("CocoBlobShot2", 0, 0, -8, random(-20, 20), random(-20, 20), random(-20, 0))
    goto Death+7
  }
}

actor CocoBlobShot : BasicProjectile {
  Translation "192:192=4:4", "198:198=48:48", "0:0=52:52"
  damagetype "MWS_Fruit"
  Obituary "%o wasn't chill enough to be a cool guy like \cfTropical \ckMWS\c- (%k)."
  -NOGRAVITY
  Damage (95)
  Radius 8
  Height 5
  speed 28
  Scale 2.0
  States {
   Spawn:
    X_1H B 0
    X_1H B 0 ThrustThingZ(0, 4, 0, 1)
    X_1H B 5
    wait
   Crash:
   XDeath:
    X_1H B 0
    stop
   Death:
    X_1H B 0
    X_1H B 0 A_JumpIf(z-floorz<=0, "DeathF")
    X_1H B 0 A_SpawnItemEx("CocoBlobDrop", 0, 0, 0, 0, 0, momz, 0, 1)
    stop
   DeathF:
    X_1H B 0 A_SpawnItemEx("CoconutBlob", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor CocoBlobShot2 : CocoBlobShot {
  +THRUACTORS
  States {
   Spawn:
    X_1H B 0
    X_1H B 3 ThrustThingZ(0, 4, 0, 1)
    X_1H B 0 A_ChangeFlag("THRUACTORS", 0)
    X_1H B 5
    wait
  }
}

actor CocoBlobDrop : CocoBlobShot {
  States {
   Spawn:
    X_1H B 0
    X_1H B 0 ThrustThingZ(0, 1, 0, 1)
    X_1H B 5
    wait
   Death:
    X_1H B 0 A_JumpIf(z-floorz<=0, "DeathF")
    goto XDeath
  }
}

Actor CoconutBlob : BasicProjectile {
  damagetype "MWS_Fruit"
  Obituary "%o wasn't chill enough to be a cool guy like \cfTropical \ckMWS\c- (%k)."
  +DONTSPLASH
  +BOUNCEONCEILINGS
  +NOEXPLODEFLOOR
  +NOTARGETSWITCH
  mass 99999
  reactiontime 90
  Damage (55)
  Height 10
  Radius 8
  states {
   Spawn:
    X_1H D 0
    X_1H D 1
    Goto Spawn2
   Spawn2:
    X_1H D 1 A_ChangeVelocity(0, 0, momz, 2)  // A_Stop
    Goto SlideWait
   SlideWait:
    X_1H C 1 A_JumpIfCloser(40, "Slide")
    X_1H C 0 A_CheckFlag("BLASTED", "NewShot")
    X_1H C 1 A_JumpIfCloser(40, "Slide")
    X_1H C 0 A_CheckFlag("BLASTED", "NewShot")
    X_1H C 0 A_CountDown
    loop
   Slide:
    X_1H C 0
    X_1H C 0 A_JumpIfInTargetInventory("CocoSliderCheck", 1, "MoreSlideC")
    TNT1 A 0 A_TakeFromTarget("CocoFaggoFlags")
    TNT1 A 2 A_GiveToTarget("CocoSliderCheck", 1)
    stop
   MoreSlideC:
    TNT1 A 0 A_JumpIfInTargetInventory("CocoJump", 1, "MoreSlide")
    goto SlideSnd
   MoreSlide:
    TNT1 A 0 A_GiveToTarget("CocoFaggoFlags", 10)
    goto SlideSnd
   SlideSnd:
    TNT1 A 1 A_PlaySoundEx("weapon/oilshot", "Weapon")
    stop
   NewShot:
    TNT1 A 1 A_SpawnItemEx("CocoBlobShot", 0, 0, 0, momx, momy, momz, 0, 9)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor CoconutSliderWarper : BaseShieldWarper {
  Translation "192:192=4:4", "198:198=48:48", "0:0=52:52"
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ACS_NamedExecuteAlways("uc_clientwarper", 0)
   Shield:
    X_1H A 1 A_Warp(2, 24, 0, 2, 0, 24)
    X_1H A 0 A_JumpIfInTargetInventory("OilBoat", 1, "Shield")
    stop
  }
}

actor CoconutSliderDamage : BasicExplosion {
  damagetype "MWS_Fruit"
  Obituary "%o couldn't afford a cow to give to \cfTropical \ckMWS\c- (%k)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(40, 98, 0)  // 160
    stop
  }
}

actor ThoseDamnBananas_P : CustomInventory {
  States {
   Pickup:
    TNT1 AA 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, random(-40, 40), random(-40, 40), random(-40, 40), 0, 0)
    TNT1 A 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, cos(-pitch)*40, 0, sin(-pitch)*40+random(-5, 5), random(-15, 15), 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    stop
   Pickup2:
    TNT1 AA 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, random(-40, 40), random(-40, 40), random(-40, 40), 15, 0)
    TNT1 AA 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, random(-40, 40), random(-40, 40), random(-40, 40), -15, 0)
    TNT1 A 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, cos(-pitch)*40, 0, sin(-pitch)*40+random(-5, 5), random(0, 30), 0)
    TNT1 A 0 A_SpawnItemEx("ThoseDamnBananas", 0, 0, 32, cos(-pitch)*40, 0, sin(-pitch)*40+random(-5, 5), random(-30, 0), 0)
    stop
  }
}
Actor ThoseDamnBananas : BasicProjectile {
  Translation "192:192=228:228", "198:198=232:232"
  Damagetype "MWS_Fruit"
  Obituary "%o was smacked by \cfTropical \ckMWS\c- (%k)'s Damn Banana."
  +DOOMBOUNCE
  -ALLOWBOUNCEONACTORS
  +DONTSPLASH
  BounceCount 6
  BounceFactor 0.9
  Damage (35)
  Radius 10
  Height 10
  Speed 40
  States {
   Spawn:
    8Q10 IJKL 2
    loop
  }
}

actor PineAnapalm : BasicProjectile {
  Translation "4:4=211:211", "192:192=218:218", "198:198=165:165", "195:195=120:120", "202:202=4:4", "199:199=248:248"
  damagetype "MWS_Fruit"
  Obituary "%o took tropical damage from \cfTropical \ckMWS\c- (%k)'s PineAnaplams."
  -NOGRAVITY
  +CANBOUNCEWATER
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  bouncefactor 0.8
  wallbouncefactor 0.8
  bouncecount 6
  reactiontime 10
  Damage (25)
  Radius 8
  Height 8
  speed 25
  States {
   Spawn:
    8Q10 A 0
    8Q10 A 0 ThrustThingZ(0, 32, 0, 1)
    8Q10 A 0 A_CountDown
    8Q10 MNOPQRST 2
    Goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_Explode(180, 128, 0, 0, 9)
    Y_8B ABCDEF 2
    stop
  }
}

actor TropicalMWS_MelonPickup : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("TropicalMWS_MelonPickup2", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), frandom(0, 3), 0, 1)
    stop
  }
}

actor TropicalMWS_MelonPickup2 : CustomInventory {
  inventory.pickupmessage "Found a tasty watermelon! (450)"
  ReactionTime 8
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    8Q10 U 1050 A_CountDown
    wait
    8Q10 V 1050 A_CountDown
    wait
    8Q10 W 1050 A_CountDown
    wait
    8Q10 X 1050 A_CountDown
    wait
   Pickup:
    TNT1 A 0 A_PlaySound("GNT/FoodGet", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 450)
    stop
  }
}


actor MelonBombingA : BasicProjectile {
  Translation "192:192=128:128", "198:198=131:131", "199:199=130:130", "202:202=38:38"
  Damagetype "MWS_FruitX"
  Obituary "%o was proven to be allergic to \cfTropical \ckMWS\c- (%k)'s Tasty WaterMelon."
  +NOINTERACTION
  +DONTBLAST
  Reactiontime 10
  damage (85)
  radius 16
  height 8
  Scale 4.5
  States {
   Spawn:
    8Q10 U 0
    8Q10 U 0 A_ChangeVelocity(11, 0, momz, 3)
    8Q10 UUVVWWXX 1 A_JumpIf(ceilingz-z>8, "Spawn2")
    8Q10 U 0 A_JumpIf(momz==0, "Death")
    8Q10 U 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    8Q10 U 0
    8Q10 U 0 A_ChangeFlag("NOINTERACTION", 0)
    8Q10 UVWX 2 A_ChangeVelocity(11, 0, momz, 3)
    8Q10 U 0 A_JumpIf(momz==0, "Death")
    8Q10 U 0 A_CountDown
    Goto Spawn2+2
   Death:
    Y_8B A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    Y_8B A 0  // A_SetGravity(0.0)
    Y_8B A 0
    Y_8B A 0 A_Explode(240, 256, 0, 0, 16)
    Y_8B AAAAA 0 A_SpawnItemEx("MelonBombingBit", 0, 0, 4, random(10, 15), random(-10, 10), random(2, 15), random(0, 23)*15)
    Y_8B ABCDEF 2
    stop
  }
}


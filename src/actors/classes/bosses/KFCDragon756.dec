actor KFCDragon756 : BossBase {
  Player.ScoreIcon "UB084MUG"
  player.soundclass "BOSS084"
  player.forwardmove 0.9, 0.9
  player.sidemove 0.88, 0.88
  player.jumpz 10
  Player.MaxHealth 5000
  Health 5000
  player.morphweapon "KFCDragon756_W"
  States {
   Spawn:
    FAKM A 0
    FAKM B 1
   SpawnFrame:
    FAKM A 1 A_JumpIf(!CallACS("core_CheckFooting"), "FakeJumping")
    loop
   See:
    FAKM BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "FakeJumping")
    Goto Spawn
   FakeJumping:
    FAKM S 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop

   Missile:
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Pissed")
   Missile_1: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
   Missile_2: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
   Missile_3: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
   Missile_4: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Spawn")
   Missile_5: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
   Missile_6: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
   Missile_7: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
   Missile_8: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
    goto Spawn
   Missile_Air:
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Pissed_Air")
   Missile_Air_1: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
   Missile_Air_3: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
   Missile_Air_4: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Spawn")
   Missile_Air_5: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
   Missile_Air_6: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
   Missile_Air_7: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
   Missile_Air_8: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto FakeJumping

   Missile_Pissed:
   Missile_Pissed_1: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Pissed_Air_1")
   Missile_Pissed_2: FAKM F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Pissed_Air_2")
   Missile_Pissed_3: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Pissed_Air_3")
   Missile_Pissed_4: FAKM G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Pissed_Air_4")
   Missile_Pissed_Check:
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Pissed")
    goto Spawn
   Missile_Pissed_Air:
   Missile_Pissed_Air_1: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_Pissed_2")
   Missile_Pissed_Air_2: FAKM O 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_Pissed_3")
   Missile_Pissed_Air_3: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_Pissed_4")
   Missile_Pissed_Air_4: FAKM R 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_Pissed_Check")
   Missile_Pissed_Air_Pissed_Check:
    FAKM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Pissed_Air")
    goto FakeJumping

   ClassPain:
    FAKM H 0
    Goto MegamanPain
   ClassDeath:
    FAKM H 0
    Goto MegamanDeath
  }
}



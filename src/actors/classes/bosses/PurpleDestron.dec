actor PurpleDestron : BossBase {
  Player.ScoreIcon "UB070MUG"
  player.soundclass "BOSS070"
  player.damagescreencolor "purple"
  player.forwardmove 0.55, 0.55
  player.sidemove 0.45, 0.45
  player.jumpz 9
  Player.MaxHealth 2000
  Health 2000
  gravity 3.0
  MaxStepHeight 128//24
  MaxDropOffHeight 128//24
  scale 1.5
  player.morphweapon "PurpleDestron_W"
  States {
   Spawn:
    8A70 A -1
    wait
   See:
    8A70 A 114
    Goto Spawn
   Missile:
    8A70 A 514
    goto Spawn
   ClassPain:
    8A70 H 0
    Goto MegamanPain
   ClassDeath:
    8A70 H 0
    Goto MegamanDeath
   MegamanDeath0:
    8A70 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8A70 H 0 A_PlaySoundEx("TransformersNES/DestronDeath", "Body")
    8A70 H 28 A_SpawnItemEx("DestronExplodeFX", -3, 0, 70, 0, 0, 0, 0, 1)
    8A70 H 0 A_TakeInventory("CutterFlag")
   Exploding:
    8A70 H 0 A_JumpIfInventory("CutterFlag", 7, "FadeOut")
    8A70 H 0 A_JumpIfInventory("KnightFlag", 9, "ExplosionSpawn")
    8A70 H 1
    8A70 H 0 A_GiveInventory("KnightFlag", 1)
    loop
   ExplosionSpawn:
    8A70 H 0 A_PlaySoundEx("TransformersNES/DestronDeathLoop", "Body")
    8A70 H 0 A_SpawnItemEx("DestronExplodeFX", random(0, 60), 0, random(0, 120), 0, 0, 0, random(0, 359), 1)
    8A70 H 0 A_GiveInventory("CutterFlag", 1)
    8A70 H 0 A_TakeInventory("KnightFlag")
    goto Exploding
   FadeOut:
    8A70 H 20
   FadeOutLoop:
    8A70 H 0 A_GiveInventory("DeathFadeOutFlag")
    8A70 H 1 A_FadeOut(0.18, false)
    8A70 H 0 A_JumpIfInventory("DeathFadeOutFlag", 6, "MegamanErase")
    loop
  }
}

actor TransformerClassDeathFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 FG 6
    stop
  }
}
actor DestronExplodeFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 DCDE 5
    stop
  }
}

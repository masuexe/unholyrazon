actor PurpleDestron : BossBase {
  Player.ScoreIcon "UB070MUG"
  Player.SoundClass "PurpleDestron"
  Player.DamageScreenColor "purple"
  Player.ForwardMove 0.55, 0.55
  Player.SideMove 0.45, 0.45
  Player.JumpZ 9
  Player.MaxHealth 2000
  Health 2000
  Gravity 3.0
  MaxStepHeight 128  // 24
  MaxDropOffHeight 128  // 24
  Scale 1.5
  Player.MorphWeapon "PurpleDestron_W"
  States {
   Spawn:
    8A70 A -1
    wait
   See:
    8A70 A 114
    goto Spawn
   Missile:
    8A70 A 514
    goto Spawn
   ClassPain:
    8A70 H 0
    goto MegamanPain
   ClassDeath:
    8A70 H 0
    goto MegamanDeath
   MegamanDeath0:
    8A70 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    8A70 H 0 A_PlaySoundEx("TransformersNES/DestronDeath", "Body")
    8A70 H 28 A_SpawnItemEx("DestronExplodeFX", -3, 0, 70, 0, 0, 0, 0, 1)
    8A70 H 0 A_TakeInventory("CutterFlag")
   Exploding:
    8A70 H 0 A_JumpIfInventory("CutterFlag", 7, "FadeOut")
    8A70 H 0 A_JumpIfInventory("KnightFlag", 9, "ExplosionSpawn")
    8A70 H 1
    8A70 H 0 A_GiveInventory("KnightFlag", 1)
    loop
   ExplosionSpawn:
    8A70 H 0 A_PlaySoundEx("TransformersNES/DestronDeathLoop", "Body")
    8A70 H 0 A_SpawnItemEx("DestronExplodeFX", random(0, 60), 0, random(0, 120), 0, 0, 0, random(0, 359), 1)
    8A70 H 0 A_GiveInventory("CutterFlag", 1)
    8A70 H 0 A_TakeInventory("KnightFlag")
    goto Exploding
   FadeOut:
    8A70 H 20
   FadeOutLoop:
    8A70 H 0 A_GiveInventory("DeathFadeOutFlag")
    8A70 H 1 A_FadeOut(0.18, false)
    8A70 H 0 A_JumpIfInventory("DeathFadeOutFlag", 6, "MegamanErase")
    loop
  }
}

actor TransformerClassDeathFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 FG 6
    stop
  }
}
actor DestronExplodeFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 DCDE 5
    stop
  }
}

// Head weak-point proxy for the Destron bosses. Invisible, non-solid shootable
// actor warped to the head every other tic. Its own damage is cancelled by
// uh_DestronHeadDamage and forwarded to the master player, so the boss's native
// damage pipeline (armor/damage type/credit) still applies. The boss body is
// made NONSHOOTABLE in the three UH_*Destron_MorphSetup_P actors, so projectiles
// pass through the body and only this box can be hit.
actor DestronHeadHitbox {
  Health 100000000
  Radius 9
  Height 14
  PainChance 0
  RenderStyle "None"
  +SHOOTABLE
  +USEDAMAGEEVENTSCRIPT
  +NOGRAVITY
  +NOTARGET
  +NODAMAGETHRUST
  +NOBLOOD
  -SOLID
  -COUNTKILL
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    goto Follow
   Follow:
    TNT1 A 1 A_Warp(AAPTR_MASTER, 0, 0, 62, 0, WARPF_NOCHECKPOSITION | WARPF_COPYINTERPOLATION)
    TNT1 A 1 A_JumpIf(CallACS("uh_DestronHeadProxyAlive") == 0, "Death")
    loop
   Death:
    TNT1 A 0
    stop
  }
}

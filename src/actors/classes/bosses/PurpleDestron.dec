actor PurpleDestron : BossBase {
  player.soundclass "BOSS070"
  player.damagescreencolor "purple"
  player.forwardmove 0.55, 0.55
  player.sidemove 0.45, 0.45
  player.jumpz 9
  Player.MaxHealth 2000
  Health 2000
  gravity 3.0
  MaxStepHeight 128//24
  MaxDropOffHeight 128//24
  scale 1.0
  player.morphweapon "PurpleDestron_W"
  States {
   Spawn:
    8A70 A -1
    wait
   See:
    8A70 A 114
    Goto Spawn
   Missile:
    8A70 A 514
    goto Spawn
   ClassPain:
    8A70 A 0
    Goto MegamanPain
   ClassDeath:
    8A70 A 0
    Goto MegamanDeath
   MegamanDeath0:
    8A70 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    goto MegamanErase
  }
}

actor TransformerClassDeathFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 FG 6
    stop
  }
}
actor DestronExplodeFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8P70 DCDE 3
    stop
  }
}

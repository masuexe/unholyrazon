// MWS = Manly Womanizing Simpson
actor TropicalMWS : BossBase {
  Player.ScoreIcon "UB110MUG"
  Player.SoundClass "TropicalMWS"
  Player.ForwardMove 1.4, 1.4
  Player.SideMove 1.4, 1.4
  Player.MaxHealth 2000
  Health 2000
  Player.JumpZ 14
  Player.MorphWeapon "TropicalMWS_W"
  States {
   Spawn:
    MWSZ A 0
    MWSZ B 1
    MWSZ A 1
    goto Spawn+2
   See:
    MWSZ BCDE 5
    goto Spawn
   Missile:
    MWSZ F 5
    MWSZ G 4
    goto Spawn+2
   ClassPain:
    MWSZ H 0
    goto MegamanPain
   ClassDeath:
    MWSZ H 0
    goto MegamanDeath
  }
}

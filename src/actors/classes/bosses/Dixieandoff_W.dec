actor Dixieandoff_W_ScriptBar : ScriptBar {}

actor Dixieandoff_W : BaseUnholyBossWep
{
Tag "$TAG_Boss023_W"
Obituary "\cjDixieandoff\c- (%k) broke %o's face."
Inventory.Pickupmessage "\cgTIS CONFUSION!"
weapon.ammotype "UnholyBossAmmo100"
weapon.ammotype2 "UnholyPower1000"
States
{
Spawn:
8H23 [ 1
wait

Deselect:
8H23 A 0
goto DeselectSwap
Select:
8H23 A 0
goto SelectSwap

Ready:
8H23 A 0 A_GiveInventory("UnholyPowerLimit_F",1000)
8H23 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, DIXIEANDOFF_DYE)
8H23 A 0 A_GiveInventory("ArmorBonusScale_F",85)
8H23 A 0 A_GiveInventory("Dixieandoff_BasicArmor_P",1)
goto ReadyX
ReadyX:
8H23 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"ReadyX2")
8H23 A 2 A_WeaponReady(8)
8H23 A 0 A_GiveInventory("UnholyBossAmmo100",3)
loop
ReadyX2:
8H23 A 2 A_WeaponReady
8H23 A 0 A_GiveInventory("UnholyBossAmmo100",3)
loop

Fire:
8H23 C 0 A_JumpIfInventory("UnholyPower1000",1000,"SPINNINGLANCER")
8H23 A 0 A_PlaySoundEx("weapon/CBMKnightShot","Weapon")
8H23 A 0 A_TakeInventory("KnightFlag")
8H23 A 0 A_FireCustomMissile("HowuoKenMaceThing",0,0,8,0)
8H23 BCD 2 A_GiveInventory("UnholyBossAmmo100",1)
Goto Check
Check:
8H23 D 1 A_GiveInventory("KnightFlag",1)
8H23 D 0 A_JumpIfInventory("KnightFlag",20,"Return")
Goto Check
Return:
8H23 CB 2 A_TakeInventory("KnightFlag")
Goto ReadyX

AltFire:
8H23 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"SAOSETZKENREPPUKEN")
Goto ReadyX
SAOSETZKENREPPUKEN:
8H23 A 0 A_TakeInventory("UnholyBossAmmo100",100)
8H23 A 0 //ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8H23 A 0 A_GiveInventory("NoJumpCancel")
8H23 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
8H23 A 0 A_GiveInventory("HandyFlag",1)
8H23 A 0 A_Refire(1)

8H23 A 0 A_Recoil(-20)
8H23 A 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8H23 I 1 ThrustThingZ(0,120,0,0)
8H23 EEEFF 1 ThrustThingZ(0,4,1,1)

Fallcheck:
8H23 F 0 ThrustThingZ(0,1,1,1)
8H23 F 0 A_SpawnItemEx("DixieLeapCrush",0,0,-10,0,0,-10)
8H23 F 0 A_JumpIf(momz<=0,"FallX")
8H23 F 1
loop
FallX:
8H23 E 0 ThrustThingZ(0,2,1,1)
8H23 E 0 A_SpawnItemEx("DixieLeapCrush",0,0,-10,0,0,-10)
8H23 E 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"),"REKTPOOKEN")
8H23 E 0 A_JumpIfInventory("HandyFlag",999,"REKTPOOKEN")
8H23 E 0 A_GiveInventory("HandyFlag",1)
8H23 E 1
8H23 E 0 ThrustThingZ(0,2,1,1)
8H23 E 0 A_SpawnItemEx("DixieLeapCrush",0,0,-10,0,0,-10)
8H23 E 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"),"REKTPOOKEN")
8H23 E 0 A_JumpIfInventory("HandyFlag",999,"REKTPOOKEN")
8H23 E 0 A_GiveInventory("HandyFlag",1)
8H23 E 1
goto Fall
Fall:
8H23 I 0 ThrustThingZ(0,2,1,1)
8H23 I 0 A_SpawnItemEx("DixieLeapCrush",0,0,-10,0,0,-10)
8H23 I 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"),"REKTPOOKEN")
8H23 I 0 A_JumpIfInventory("HandyFlag",999,"REKTPOOKEN")
8H23 I 0 A_GiveInventory("HandyFlag",1)
8H23 I 1
loop
REKTPOOKEN:
8H23 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
8H23 A 0 A_TakeInventory("NoJumpCancel")
8H23 A 0 A_TakeInventory("HandyFlag")
8H23 A 0 A_Stop
8H23 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE","SoundSlot5") //A_PlaySoundEx("misc/quake","Weapon")
8H23 A 0 Radius_Quake(6,35,0,50,0)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,0)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,45)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,90)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,135)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,180)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,225)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,270)
8H23 A 0 A_SpawnItemEx("GoosePukoon",0,0,0,32,0,0,315)
8H23 A 0//20 //ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8H23 CDDDD 3
8H23 CB 2
8H23 A 1
Goto ReadyX

SPINNINGLANCER:
8H23 A 0 ACS_NamedExecuteWithResult("core_chargecolor", DIXIEANDOFF_DYE2)
8H23 A 0 A_PlaySoundEx("classes/skullabs","Weapon")
8H23 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H23 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8H23 A 0 A_GiveInventory("HandyFlag",1)
8H23 A 0 A_Refire(1)
8H23 A 0 A_SpawnItemEX("DixieDeusVultStart_Helper",0,0,28)
8H23 N 1 A_TakeInventory("UnholyPower1000",10)
8H23 JKLKMKLKJ 2
8H23 N 0 A_GiveInventory("HandyFlag",1)
8H23 N 0 A_PlaySound("misc/hsloop",1,2.0,1)
HIGHPOINTEDWAVE:
8H23 N 0 A_Recoil(-5)
8H23 N 1 A_SpawnItemEX("DixieDeusVultHitbox",0,0,-44,momx,momy,momz,0,8,0)
8H23 N 0 A_TakeInventory("UnholyPower1000",10)
8H23 N 0 A_JumpIfInventory("UnholyPower1000",1,"HIGHPOINTEDWAVE2")
Goto OVERSOSOON
HIGHPOINTEDWAVE2: //Formerly 8H23 I, but I hate for my eyes to strain.
8H23 N 0 A_Recoil(-5)
8H23 N 1 A_SpawnItemEX("DixieDeusVultHitbox",0,0,-44,momx,momy,momz,0,8,0)
8H23 N 0 A_TakeInventory("UnholyPower1000",10)
8H23 N 0 A_JumpIfInventory("UnholyPower1000",1,"HIGHPOINTEDWAVE")
Goto OVERSOSOON
OVERSOSOON:
8H23 A 0 A_StopSound(1)
8H23 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8H23 A 0 ACS_NamedExecuteWithResult("core_chargecolor", DIXIEANDOFF_DYE)
8H23 A 0 A_TakeInventory("UnholyPowerDazzle_F")
8H23 A 0 A_TakeInventory("HandyFlag")
8H23 A 0 A_TakeInventory("UnholyPower1000", 1)
8H23 C 20
8H23 BA 5
Goto ReadyX
}
}

actor DixieDeusVultStart_Helper : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("HowuoKenMaceThingFX",random(0,8),0,random(-16,16),random(14,28),0,random(-6,24),random(0,71)*5,0)
TNT1 A 2
stop
}
}

actor DixieDeusVultHitbox : BasicProjectile
{
damagetype "DixieandoffRage"
Obituary "%o was completely and utterly destroyed by \cjDixieandoff\c- (%k)'s critical strike."
+THRUGHOST
+DONTBLAST
+DONTREFLECT
damage (9999)
radius 96//72
Height 168
States
{
Spawn:
TNT1 AA 1
stop
Death:
TNT1 A 0
Stop
}
}

actor DixieDeusVultFX : BasicExplosion
{
//Translation "210:210=189:189", "208:208=247:247"
Translation "192:192=176:176","198:198=184:184"
scale 4.0
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX","SoundSlot5")
6P03 ABCDEFG 2
stop
}
}

actor DixieDeusVult_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_Stop
TNT1 A 0 ThrustThingZ(0,75,0,0)
TNT1 A 0 A_Recoil(35)
TNT1 A 0 //A_PlaySoundEx("classes/DakuSpecialSFX","SoundSlot5")
TNT1 A 0 A_TakeInventory("UnholyPower1000")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", DIXIEANDOFF_DYE)
stop
}
}



actor DixieLeapCrush : BasicExplosion
{
damagetype "Dixieandoff"
Obituary "\cjDixieandoff\c- (%k)'s broke %o's face."
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(50,75,0,0,8)
stop
}
}

actor GoosePukoon : BasicProjectile
{
damagetype "Dixieandoff"
Obituary "\cjDixieandoff\c- (%k) broke %o's face."
+RIPPER
+FLOORHUGGER
+DONTREFLECT
RenderStyle None
Damage (random(25,40))
Radius 10
Height 10
Speed 32
States
{
Spawn:
//TNT1 A 0 A_Explode(150, 150, 0)
TNT1 A 1 A_SpawnItemEx("GoosePseukken")
Loop
}
}

actor GoosePseukken : GoosePukoon
{
+THRUGHOST
+DONTBLAST
Damage (random(40,100))

actor HowuoKenMaceThingR : HowuoKenMaceThing
{
+NOINTERACTION
+SEEKERMISSILE
damage (0)
states
{
Spawn:
X_6D A 0
X_6D A 0 A_RearrangePointers(0,0,2)
X_6D A 0 A_FaceTarget
goto Spawn2
Spawn2:
X_6D A 0 A_TakeFromTarget("KnightFlag",50)
X_6D A 0 A_JumpIfCloser(42,"Death")
X_6D A 0 A_SpawnItemEx("HowuoKenMaceThingSound") //
X_6D AA 0 A_SeekerMissile(90,90,SMF_PRECISE)
X_6D A 1 A_SpawnItemEx("HowuoKenMaceThingD",0,0,0,momx,momy,momz,0,9)
X_6D A 0 A_JumpIfCloser(42,"Death")
X_6D A 1 A_SpawnItemEx("HowuoKenMaceThingD",0,0,0,momx,momy,momz,0,9)
X_6D A 0 A_JumpIfCloser(42,"Death")
X_6D A 1 A_SpawnItemEx("HowuoKenMaceThingD",0,0,0,momx,momy,momz,0,9)
X_6D A 0 A_JumpIfCloser(42,"Death")
X_6D A 1 A_SpawnItemEx("HowuoKenMaceThingD",0,0,0,momx,momy,momz,0,9)
X_6D A 0 A_JumpIfCloser(42,"Death")
X_6D A 0 A_CountDown
X_6D A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
loop
}
}

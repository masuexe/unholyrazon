SpawnFrame:
X_BG D 0
X_BG D 4
X_BG CBA 2 A_Fadeout
stop
}
}


actor HowuoKenMaceThing : BasicProjectile
{
Translation "192:192=162:162","198:198=164:164"
damagetype "Dixieandoff"
Obituary "\cjDixieandoff\c- (%k) broke %o's face."
+THRUACTORS
+DONTSPLASH
+HEXENBOUNCE
+NOTARGETSWITCH
+DONTREFLECT
+SKYEXPLODE
+CANBOUNCEWATER
Bouncefactor 1.0
WallBounceFactor 1.0
reactiontime 60
Damage (0)
Radius 8
Height 8
speed 56
scale 2.5
States
{
Spawn:
X_6D A 0
X_6D AAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("HowuoKenMaceThingD",0,0,0,momx,momy,momz,0,9)
X_6D A 0 A_TakeFromTarget("KnightFlag",50)
X_6D A 0 A_SpawnItemEx("HowuoKenMaceThing2")
stop


SpawnEnd:
X_6D A 0 A_CustomMissile("HowuoKenMaceThingR",0,0,0,0)
stop

Death:
X_6D A 0 A_GiveToTarget("KnightFlag",50)
stop
}
}


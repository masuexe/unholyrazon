actor TrueBusterExpert_W_ScriptBar : ScriptBar {} //NormalBar {args 95, 6}

actor TrueBusterExpert_W : BaseUnholyBossWep
{
Tag "$TAG_Boss000_W"
Obituary "%o was KO'd by \cmTrue \cuBusterExpert\c- (%k)."
Inventory.Pickupmessage "\cmMaster of all sins."
weapon.ammotype "UnholyBossAmmo200"
States
{
Spawn:
8H00 [ 1
wait

Ready:
8H00 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, TRUEBUSTEREXPERT_DYE)
ReadyX:
	8H00 A 0 A_JumpIfHealthLower(CallACS("uh_health", UHEALTH_GET_MAX)*0.35+1,"GetHypedForPain")
	8H00 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,2)
	8H00 A 2 A_WeaponReady
	goto ReadyXGive
	8H00 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
ReadyXGive:
	8H00 A 1 A_GiveInventory("UnholyBossAmmo200",4)
	goto ReadyX
ReadyX2:
	8H00 D 0 A_GunFlash
	8H00 D 0 A_JumpIfInventory("UnholyBossAmmo200",200,2)
	8H00 D 2 A_WeaponReady
	goto ReadyX2Give
	8H00 D 2 A_WeaponReady(WRF_ALLOWRELOAD)
ReadyX2Give:
	8H00 D 1 A_GiveInventory("UnholyBossAmmo200",8)
	goto ReadyX2

GetHypedForPain:
8H00 D 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,0)
8H00 D 0 A_GiveInventory("IsPissedFlag")
8H00 D 0 A_GiveInventory("CosmeticBossSpeedTrail")
8H00 D 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, TRUEBUSTEREXPERT_DYE2, true)
8H00 DADADADA 2
goto ReadyX2

Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2
loop

Fire:
8H00 A 0 A_JumpIfInventory("IsPissedFlag",1,"Fire2")
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",0,0,-8,0)
8H00 CBAAAAAAA 3 A_GiveInventory("UnholyBossAmmo200",1)
Goto FireEnd
Fire2:
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",0,0,-8,0)
8H00 FEDDDDDDD 2 A_GiveInventory("UnholyBossAmmo200",2)
Goto ReadyX2

AltFire:
8H00 A 0 A_GiveInventory("VivifyDelay3")
8H00 A 0 A_Refire(1)
8H00 A 0 A_JumpIfInventory("IsPissedFlag",1,"AltFire2")
8H00 A 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H00 A 0 ThrustThingZ(0,60,0,0)
8H00 A 10
8H00 C 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H00 C 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",-7,0,-8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",-3,0,-8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",0,0,-8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",3,0,-8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",7,0,-8,0)
8H00 CBA 2
8H00 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H00 A 5 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H00 A 40 A_GiveInventory("VivifyDelay3")
goto FireEnd
AltFire2:
8H00 D 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8H00 D 0 ThrustThingZ(0,75,0,0)
8H00 D 5
8H00 F 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H00 F 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",-7,0,-8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",-3,0,-8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",0,0,-8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",3,0,-8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",7,0,-8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
8H00 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8H00 D 5 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H00 D 20 A_GiveInventory("VivifyDelay3")
goto ReadyX2

FireEnd:
8H00 A 0 A_JumpIfHealthLower(CallACS("uh_health", UHEALTH_GET_MAX)*0.35+1,"GetHypedForPain")
Goto ReadyX

Reload:
8H00 D 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Jump")
goto ReadyX
Jump:
8H00 D 0 A_TakeInventory("UnholyBossAmmo200")
8H00 D 0 ThrustThingZ(0,25,0,0)
8H00 D 1 A_Recoil(-75)
goto ReadyX
}
}

actor TrueGreatShotBoss : BasicProjectile
{
Translation "192:192=95:95", "198:198=6:6", "199:199=210:210", "202:202=4:4"
damagetype "TrueGreat"
Obituary "%o was KO'd by \cmTrue \cuBusterExpert\c- (%k)."
+SKYEXPLODE
+EXPLODEONWATER
Damage (225)
radius 14
height 15
Speed 65
scale 2.5
States
{
Spawn:
X_0A A 0
X_0A ABCBC 2
Y_0A B 2
X_0A CBCB 2
Y_0A C 2
goto Spawn+2
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
TNT1 A 0 A_Explode(175,148,0,0,16)
X_8B ABCDEF 2
stop
}
}

actor TrueGreatShotBoss_Des : TrueGreatShotBoss
{
Translation "192:192=5:5", "198:198=8:8", "199:199=189:189", "202:202=184:184"
Damage (325)
Speed 85
States
{
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
TNT1 A 0 A_Explode(275,148,0,0,24)
X_8B ABCDEF 2
stop
}
}


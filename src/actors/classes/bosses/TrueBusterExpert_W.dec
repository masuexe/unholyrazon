actor TrueBusterExpert_W : BaseUnholyBossWep
{
Tag "$TAG_Boss000_W"
Obituary "%o was KO'd by \cmTrue \cuBusterExpert\c- (%k)."
Inventory.Pickupmessage "\cmMaster of all sins."
weapon.ammotype "UnholyBossAmmo200"
States
{
Spawn:
8H00 [ 1
wait

Ready0:
8H00 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TRUEBUSTEREXPERT_DYE)
ReadyX:
8H00 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.35+1,"GetHypedForPain")
8H00 A 2 A_WeaponReady
8H00 A 0 A_GiveInventory("UnholyBossAmmo200",4)
loop
ReadyX2:
8H00 D 0 A_GunFlash
8H00 D 2 A_WeaponReady
8H00 D 0 A_GiveInventory("UnholyBossAmmo200",8)
loop

GetHypedForPain:
8H00 D 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,0)
8H00 D 0 A_GiveInventory("IsPissedFlag",1)
8H00 D 0 A_GiveInventory("CosmeticBossSpeedTrail",1)
8H00 D 0 ACS_ExecuteAlways(991,0,22)
8H00 DADADADA 2
goto ReadyX2

Flash:
TNT1 A 0 A_JumpIfInventory("IsDead",1,"NoFlash")
TNT1 A 2
loop

Fire:
8H00 A 0 A_JumpIfInventory("IsPissedFlag",1,"Fire2")
8H00 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.35+1,"GetHypedForPain")
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",0,0,8,0)
8H00 CBAAAAAAA 3 A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX
Fire2:
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",0,0,8,0)
8H00 FEDDDDDDD 2 A_GiveInventory("UnholyBossAmmo200",2)
Goto ReadyX2

AltFire:
8H00 A 0 A_GiveInventory("VivifyDelay3",1)
8H00 A 0 A_Refire(1)
8H00 A 0 A_JumpIfInventory("IsPissedFlag",1,"AltFire2")
8H00 A 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 A 0 SetPlayerProperty(0,1,0)
8H00 A 0 ThrustThingZ(0,60,0,0)
8H00 A 10
8H00 C 0 A_ChangeFlag("NOGRAVITY",1)
8H00 C 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",-7,0,8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",-3,0,8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",0,0,8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",3,0,8,0)
8H00 CBA 2
8H00 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 C 0 A_FireCustomMissile("TrueGreatShotBoss",7,0,8,0)
8H00 CBA 2
8H00 A 0 SetPlayerProperty(0,0,0)
8H00 A 5 A_ChangeFlag("NOGRAVITY",0)
8H00 A 40 A_GiveInventory("VivifyDelay3",1)
goto ReadyX
AltFire2:
8H00 D 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 D 0 SetPlayerProperty(0,1,0)
8H00 D 0 ThrustThingZ(0,75,0,0)
8H00 D 5
8H00 F 0 A_ChangeFlag("NOGRAVITY",1)
8H00 F 0 A_ChangeVelocity(momx,momy,0,2)//A_Stop
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",-7,0,8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PowerRage_ST",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",-3,0,8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PowerRage_ST",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",0,0,8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PowerRage_ST",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",3,0,8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PowerRage_ST",1,1)
8H00 F 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H00 F 0 A_FireCustomMissile("TrueGreatShotBoss_Des",7,0,8,0)
8H00 FE 1
8H00 D 1 A_JumpIfInventory("PowerRage_ST",1,1)
8H00 D 0 SetPlayerProperty(0,0,0)
8H00 D 5 A_ChangeFlag("NOGRAVITY",0)
8H00 D 20 A_GiveInventory("VivifyDelay3",1)
goto ReadyX2
}
}


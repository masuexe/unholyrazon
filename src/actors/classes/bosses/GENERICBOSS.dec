actor GENERICBOSS : BossBase {
  Player.ScoreIcon "UB024MUG"
  // +PLAYERPAWN.NOTHRUSTWHENINVUL
  Player.SoundClass "GENERICBOSS"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.MaxHealth 3500
  Health 3500
  Player.JumpZ 12
  // Mass 25
  Player.MorphWeapon "GENERICBOSS_W"  // Fist
  States {
   Spawn:
    GUTS A 0
    GUTS B 1
    GUTS A 1
    goto Spawn+2
   See:
    GUTS BCDE 5
    goto Spawn
   Missile:
    GUTS FFFFF 1
    GUTS GGGG 1
    goto Spawn+2
   ClassPain:
    GUTS H 0
    goto MegamanPain
   ClassDeath:
    GUTS H 0
    goto MegamanDeath
  }
}

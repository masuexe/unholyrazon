actor SuperSpeciman_W_NormalBar : NormalBar {args 200, 75}
actor SuperSpeciman_W_SecondBar : SecondBar {args 201, 110}
actor SuperSpeciman_W_ReloadIcon : ReloadIcon {tag "R105B0"}
actor SuperSpeciman_W : BaseUnholyBossWep {
  Tag "$TAG_SuperSpeciman_W"
  Obituary "\cfSuper \ccSpeciman\c- (%k) assumed that %o was the strongman."
  Inventory.Pickupmessage "Hark Hark"
  weapon.ammotype "UnholyBossAmmo200"
  weapon.ammotype2 "UnholyBossAmmo250"
  States {
   Spawn:
    8I05 [ 1
    wait

   Deselect:
    8I05 A 0
    goto DeselectSwap
   Select:
    8I05 A 0
    goto SelectSwap

   Ready:
    8I05 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, SUPERSPECIMAN_DYE)
    8I05 A 0 A_GiveInventory("IsSpecimanFlag")
    // 8I05 A 0 A_GiveInventory("SuperSpecimanItem",1)
    8I05 A 4
    8I05 A 2 A_TakeInventory("DecoyFlag1")
    goto ReadyX
   ReadyX:
    8I05 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ReadyX2")
    8I05 A 2 A_GiveInventory("SuperSpeciman_Ready8_P")
    loop
   ReadyX2:
    8I05 A 2 A_GiveInventory("SuperSpeciman_Ready0_P")
    loop

   Fire:
    8I05 B 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    8I05 D 2 Offset(-6, 25)A_FireCustomMissile("ASPBeamShot", 0, 0, 0, 8)
    8I05 DDDDD 2 Offset(-12, 18)
    8I05 D 2 Offset(-8, 23)
    8I05 B 2 Offset(-4, 28)
    8I05 B 2 Offset(-2, 30)
    8I05 B 0 A_WeaponReady(14)
    8I05 BBBBB 2
    Goto ReadyX

   Reload:
    8I05 A 0 A_JumpIfInventory("DecoyFlag1", 1, "StopperPerkPro")
    8I05 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "ApplyHealing")
    Goto ReadyX
   ApplyHealing:
    8I05 C 0 A_Stop
    8I05 C 0 A_PlaySoundEx("E_B/Shield1", "Weapon")
    8I05 C 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I05 C 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I05 C 2 Offset(5, 28)
    8I05 E 2 Offset(12, 25)A_GiveInventory("DecoyFlag1")
    8I05 E 2 Offset(18, 19)
    8I05 D 2 Offset(23, 16)
    8I05 D 0 A_PlaySoundEx("E_B/Heal2", "Weapon")
    Goto HealingPower
   HealingPower:
    8I05 DDD 0 A_SpawnItemEx("ASPHealCastingFX", random(-162, 162), random(-162, 162), 0, momx, momy, 7, 0, 8)
    8I05 D 0 A_RadiusGive("SuperSpeciman_GroupHeal_P", 162, RGF_GIVESELF|RGF_PLAYERS|RGF_NOSIGHT, 1)
    8I05 D 0 A_TakeInventory("UnholyBossAmmo250", 3)
    8I05 D 2 A_WeaponReady(14 + 16)
    8I05 D 0 A_JumpIfInventory("UnholyBossAmmo250", 1, "HealingPower")
    Goto StopperPerkPro
   StopperPerkPro:
    8I05 E 0 A_PlaySound("weapon/mirrordeflect2")
    8I05 EEEEEEEEEEEEEEEE 0 A_SpawnItemEx("ASPHealApplyingFX", random(-2, 2), random(-2, 2), 32, random(-35, 35), random(-35, 35), random(-35, 35))
    8I05 E 2 Offset(18, 19)A_TakeInventory("UnholyBossAmmo250", 50)
    8I05 E 2 Offset(12, 25)A_TakeInventory("DecoyFlag1")
    8I05 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8I05 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8I05 B 2 Offset(5, 28)
    8I05 B 0 A_WeaponReady(14)
    8I05 B 10
    Goto ReadyX

   AltFire:
    8I05 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ApplyShieldPowers")
    goto ReadyX
   ApplyShieldPowers:
    8I05 C 0 A_GiveInventory("SuperSpeciman_ItemStart_P")
    8I05 C 2 Offset(5, 28)A_SpawnItemEx("ASPShieldAppliedFX", random(-32, 32), random(-32, 32), 0, momx, momy, 7, 0, 8)
    8I05 E 2 Offset(12, 25)A_SpawnItemEx("ASPShieldAppliedFX", random(-32, 32), random(-32, 32), 0, momx, momy, 7, 0, 8)
    8I05 E 2 Offset(18, 19)A_SpawnItemEx("ASPShieldAppliedFX", random(-32, 32), random(-32, 32), 0, momx, momy, 7, 0, 8)
    8I05 DDDDDDDDDDDDDDDDDDDD 1 Offset(23, 16)A_SpawnItemEx("ASPShieldAppliedFX", random(-32, 32), random(-32, 32), 0, momx, momy, 7, 0, 8)
    8I05 E 0  // A_PlaySound("weapon/mirrordeflect2")//////
    8I05 EEEEEEEEEEEEEEEE 0 A_SpawnItemEx("ASPShieldDeploymentFX", random(-2, 2), random(-2, 2), 32, random(-35, 35), random(-35, 35), random(-35, 35))
    8I05 E 2 Offset(18, 19)
    8I05 E 2 Offset(12, 25)
    8I05 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8I05 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8I05 B 2 Offset(5, 28)
    8I05 B 0 A_WeaponReady(14)
    8I05 B 10
    Goto ReadyX
  }
}


actor SuperSpeciman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 1)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor SuperSpeciman_Ready8_P : SuperSpeciman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor SuperSpeciman_ItemStart_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
    TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F", 800)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 100, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 100)
    TNT1 A 0 A_GiveInventory("SuperSpeciman_BasicArmor_P", 1)
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySound("E_B/Shield1")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    stop
  }
}

actor ASPBeamShot : BasicProjectile {
  Translation "192:192=160:160", "198:198=163:163"
  damagetype "ASPSuper"
  Obituary "%o couldn't block \cfSuper \ccSpeciman\c- (%k)'s \ckASP Beam\c-."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (70)
  radius 22
  height 22
  Speed 56
  scale 3.5
  States {
   Spawn:
    CHBU ABCD 2 A_SpawnItemEx("ASPBeamShotFX", -6, Random(-14, 14), random(4, -4), 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(125, 128, 0)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("ASPBeamShotFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    X_8B ABCDEF 2 A_SpawnItemEx("ASPBeamShotExplode", random(-96, 96), random(-96, 96), random(-72, 72), 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPBeamShotFX : BasicGraphicEffect {
  scale 3.5
  States {
   SpawnFrame:
    X_7A I 2
    X_7A J 8
    X_7A J 1 A_Fadeout
    wait
  }
}

actor ASPBeamShotFX2 : BasicGraphicEffect {
  States {
   SpawnFrame:
    TMFX BBBBCCCDD 2 A_FadeOut(0.05)
    Stop
  }
}

actor ASPBeamShotExplode : BasicExplosion {
  damagetype "ASPSuper"
  Obituary "%o couldn't block \cfSuper \ccSpeciman\c- (%k)'s \ckASP Beam\c-."
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(45, 96, 0, 0, 16)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor ASPHealApplyingFX : BasicGraphicEffect {
  Translation "192:192=208:208", "198:198=128:128"
  States {
   SpawnFrame:
    TMFX CCCCDDDEE 2 A_FadeOut(0.05)
    Stop
  }
}

actor ASPHealCastingFX : BasicGraphicEffect {
  Translation "198:198=128:128", "192:192=4:4"
  States {
   SpawnFrame:
    CHPO X 4
    CHPO XXXX 2 A_ScaleVelocity(1.4)
    CHPO XXXXX 1 A_Fadeout(0.08)
    stop
  }
}

actor SuperSpeciman_GroupHeal_P : BasicGroupHealPickup {
  States {
   HealMe:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, 2)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 1)
    stop
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 8)
    stop
  }
}

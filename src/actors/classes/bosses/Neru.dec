actor Mikamo_Neru : BossBase {
  Player.ScoreIcon "UB304MUG"
  Player.SoundClass "Neru"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 24
  Gravity 2.0
  MaxStepHeight 32
  Player.MaxHealth 2523
  Health 2523
  Player.MorphWeapon "Neru_W"
  //
  // Player.StartItem "CanWallJump", 2 //Requires Wrath stack 1 //Turns out you can't do that, I think.
  // Player.StartItem "MillenniumAmmo", 350
  // Player.StartItem "MikAmmo", 180 //90
  //
  Scale 1.5  // 0.5
  States {
   Spawn:
    NERU A 0
    NERU A 1
    NERU A 1
    goto Spawn+2
   See:
    NERU AA 3
    goto Spawn
   Missile:
    NERU AA 3
    goto Spawn+2
   Missile2:
    NERU A 5
    NERU A 1 A_JumpIfInventory("VivifyDelay3", 1, "Spawn")
    wait
   ClassPain:
    NERU A 0
    goto MegamanPain
   ClassDeath:
    NERU A 0
    goto MegamanDeath
  }
}  // 10

Scale 100
}


actor FrankensteinMadDashWildRide : BasicProjectile
{ //Must be accurate to actual skin size??
Obituary "\cqRedead \ccGutsman\c- (%k) slapped %o."
damagetype "RedeadGutsRam"
+DONTSPLASH
+DONTBLAST
+THRUGHOST
+NOEXPLODEFLOOR
damage (375)//575
Radius 60 //60
Height 168 //168
scale 5.5
States
{
Spawn:
TNT1 AAA 1
stop
Crash:
XDeath:
TNT1 A 0 Radius_Quake(6,35,0,50,0)
TNT1 A 0 A_GiveToTarget("RedeadGutsRecoilPuff")
TNT1 A 1
Stop
Death:
TNT1 A 1
Stop
}
}

actor RedeadGutsRecoilPuff : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_Stop
TNT1 A 0 ThrustThingZ(0,25,0,0)
TNT1 A 0 ThrustThing(angle*256/360+128,80,1,0)
TNT1 A 0 A_SpawnItemEx("TheYouKnowWhatSoundHelper",0,0,24)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo200")
stop
}
}

//Who wouldn't love this.
actor TheYouKnowWhatSoundHelper : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 10 A_PlaySoundEx("ED_IMPACT/CYCLE","weapon")
stop
}
}


actor RedeadGutsCrushFX : BasicShieldWarper
{
Translation "192:192=217:217","198:198=42:42"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper",0,-39)
Goto SpawnL
SpawnL:
TNT1 A 1 A_Warp(2,0,0,-10,0,24)
6PW4 ABBCCD 1 A_Warp(2,0,0,-10,0,24)
loop
}
}

actor RedeadGutsCrush : BasicExplosion
{
Obituary "%o couldn't withstand the massive weight that \cqRedead \ccGutsman\c- (%k) had."
damagetype "RedeadGutsHell"
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(50,75,0,0,8)
stop
}
}


actor RedeadGutsRockLiftWarpX : GutsBuddyRockLiftWarp
{
Translation "192:192=4:4","198:198=3:3"
States
{
Spawn:
TNT1 A 0
8P48 A 0 ACS_NamedExecuteAlways("uc_clientwarper",0,-4)
Goto Lift2
Lift2:
"####" "#" 0 A_SpawnItemEx("ForgottenGiantCubeRocksSpawner",0,0,0,0,0,0,0,1)
"####" "#" 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
"####" "##" 1 A_Warp(AAPTR_TARGET,80,0,0,0,24)
"####" "#" 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
"####" "##" 1 A_Warp(2,80,0,10,0,24)
"####" "#" 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
"####" "##" 1 A_Warp(2,80,0,20,0,24)
"####" "#" 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
"####" "##" 1 A_Warp(2,80,0,30,0,24)
"####" "#" 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
"####" "##" 1 A_Warp(2,80,0,40,0,24)
goto Lift
}
}


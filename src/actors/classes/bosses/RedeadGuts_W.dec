8I04 I 1 A_SetAngle(angle-20.0)
8I04 C 0 A_JumpIfInventory("IsPissedFlag",1,"SPAGHETTICODEREVIVAL")
8I04 C 0 A_GiveInventory("SadFaceToadManHealthGiver")
8I04 C 0 A_PlaySound("item/energyup")//Something silly.
8I04 HH 0 A_SpawnItemEx("RedeadGutsHealingGFX",random(-32,32),random(-32,32),0,momx,momy,20,0,8)
8I04 C 1 A_SetAngle(angle-20.0)

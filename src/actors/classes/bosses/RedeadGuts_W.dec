8I04 D 1 A_SetAngle(angle-20.0)
8I04 H 0 A_JumpIfInventory("IsPissedFlag",1,"SPAGHETTICODEREVIVAL")
loop
SPAGHETTICODEREVIVAL:
8I04 F 0 A_PlaySound("Why/ThisSound","SoundSlot7")
8I04 G 2 A_GunFlash("Flash.SionPassive")
8I04 F 2 A_GiveInventory("DrainRuneChecker_P",1)
8H26 I 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
8I04 F 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 F 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Goto ReadyMadX



Flash.SionPassiveStart:
TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE)
TNT1 AAA 1
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 1 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE2)
TNT1 AAA 1
TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
loop
Flash.SionPassive: //3tics - slowed down hp drain to match the supposed walking sound, please do not get mad at me for this  -Zomo
TNT1 A 0 A_PlaySoundEx("DesDemo/CoyoteWalking","Auto")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE)
TNT1 A 0 //ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain",0)//HealThing(-10,30000)
TNT1 AAA 1 
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 A_PlaySoundEx("DesDemo/CoyoteWalking","Auto")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE2)
TNT1 A 0 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain",0)
TNT1 AAA 1 
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")

TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE)
TNT1 A 0 A_PlaySoundEx("DesDemo/CoyoteWalking","Auto")
TNT1 A 0 //ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain",0)
TNT1 AAA 1 
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 A_PlaySoundEx("DesDemo/CoyoteWalking","Auto")
TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", REDEADGUTS_DYE2)
TNT1 A 0 ACS_NamedExecuteAlways("ub_RedeadGutsHPDrain",0,1)
TNT1 AAA 1 
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
loop

// Why the fuck they spam relative offset jumps
// instead state labels they have already defined
Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 2 A_GiveInventory("RedeadGutsFlash_P")
TNT1 A 0 A_JumpIfInventory("RedeadGutsJumpAmmo", 200, 1)
loop
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_RELOAD, "REACHFORTHESKY")
loop
REACHFORTHESKY:
TNT1 A 0 A_PlaySoundEx("weapon/superarmuse","Body")
TNT1 A 0 A_ScaleVelocity(0.85)
TNT1 A 0 A_TakeInventory("RedeadGutsJumpAmmo", 200)
TNT1 A 0 A_GiveInventory("NoJumpCancel")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
TNT1 A 0 A_Recoil(-20)
TNT1 A 0 A_SpawnItemEx("ZangiefDustFX",0,0,0,0,0,0,0,1,0)//At this point it might as well be called, BasicDustFX
TNT1 A 1 ThrustThingZ(0,120,0,0)
TNT1 A 0 A_GiveInventory("ClientFXWarp_F", 1)
TNT1 AAA 2 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 0 A_SpawnItemEx("RedeadGutsCrushFX",0,0,-10)
Fallcheck:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//15
TNT1 A 0 ThrustThingZ(0,1,1,1)
TNT1 A 1 A_JumpIf(momz<=0, "Fall")
TNT1 A 0 A_SpawnItemEx("RedeadGutsCrush",0,0,-10,momx,momy,-10,0,8)
loop
Fall:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//19
TNT1 A 0 ThrustThingZ(0,2,1,1)
TNT1 A 1 A_JumpIf(CallACS("core_checkfooting_thruplayer"), "BuzzDepressionScene")
TNT1 A 0 A_PlaySoundEx("BUTTSCKS","Body")//Body
TNT1 A 0 A_SpawnItemEx("RedeadGutsCrush",0,0,-10,momx,momy,-10,0,8)
loop
BuzzDepressionScene:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
TNT1 A 0 A_TakeInventory("NoJumpCancel")
TNT1 A 0 A_TakeInventory("ClientFXWarp_F")
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("misc/quake","Body")
TNT1 A 0 A_PlaySoundEx("ED_IMPACT/CYCLE","SoundSlot5")
TNT1 A 0 Radius_Quake(6,35,0,50,0)
TNT1 A 0 A_SpawnItemEx("ZangiefDustFX",0,0,0,0,0,0,0,1,0)
TNT1 AAA 2 A_GiveInventory("RedeadGuts_FloorQuake_P",1)
TNT1 A 20 A_JumpIfInventory("IsDead", 1, "NoFlash")
TNT1 A 16 A_JumpIfInventory("IsDead", 1, "NoFlash")
goto Flash
}
}

actor RedeadGutsJumpAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 200
  +INVENTORY.IGNORESKILL
}

actor RedeadGutsHealthDrain : Inventory
{
inventory.amount 1
inventory.maxamount 30000
}

actor PowerRedeadGutsDrain : PowerDrain
{
Powerup.Strength 0.88
Powerup.Duration -15
}

actor RedeadGutsFlash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("SuperArmTemp",1,"Pickup2")
TNT1 A 0 A_GiveInventory("RedeadGutsJumpAmmo",4)
stop
Pickup2:
TNT1 A 0 A_GiveInventory("RedeadGutsJumpAmmo",2)
stop
}
}

actor RedeadGutsHealthGiver : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH) * 0.75,"GiveHealth")
goto Pickup3
GiveHealth:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 45+random(0,9))
stop
Pickup3:
TNT1 A 0 A_GiveInventory("IsPissedFlag")
stop
}
}

actor RedeadGutsThrust_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"),"PickupAir")
TNT1 A 0 A_Recoil(-2)
TNT1 A 1 A_ChangeVelocity((momx)*1.045,(momy)*1.045,(momz),CVF_REPLACE)
stop
PickupAir:
TNT1 A 0 A_Recoil(-1.15f)
TNT1 A 0 A_ChangeVelocity((momx)*1.025,(momy)*1.025,(momz),CVF_REPLACE)
stop
}
}

actor RedeadGutsClimb_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 ThrustThingZ(0,35,0,0)
stop
}
}

actor RedeadGutsClimbCheck
{
PROJECTILE
+DONTBLAST
+DONTSPLASH
+SKYEXPLODE
+THRUACTORS
+DONTREFLECT
RenderStyle "None"
Damage (0)
radius 12
height 16
speed 0
States
{
Spawn:
TNT1 A 0
TNT1 A 1
stop
Death:
TNT1 A 1 A_GiveToTarget("RedeadGutsClimb_P")
TNT1 A 1
stop
Death2:
TNT1 A 0
stop
}
}

actor RedeadGutsHealingGFX : BasicGraphicEffect
{
Translation "198:198=3:3", "192:192=4:4"
States
{
SpawnFrame:
CHPO X 5
stop
}
}

actor RedeadGutsRNGCollision_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ATTACK), "PickupCollision")
TNT1 A 0 A_SpawnItemEx("RedeadGutsClimbCheck",0,0,28,32,0,0,0)
PickupCollision:
TNT1 A 0 A_Jump(256,"R0","R1")
goto R0
R0:
TNT1 A 0 A_SpawnItemEx("RedeadGutsCollisionDam0",0,0,32,momx,momy,momz,0,8,0)
stop
R1:
TNT1 A 0 A_SpawnItemEx("RedeadGutsCollisionDam1",0,0,32,momx,momy,momz,0,8,0)
stop
}
}

actor RedeadGutsCollisionDam0 : BasicExplosion
{
Obituary "%o fed \cqRedead \ccGutsman\c- (%k) a kill. (300g)"
Damagetype "RedeadGutsRage"
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(100,64,0,0,8)
stop
}
}
actor RedeadGutsCollisionDam1 : RedeadGutsCollisionDam0
{
Obituary "\cqRedead \ccGutsman\c- (%k) shutdown %o. (300g)"
}

actor RedeadGuts_FloorQuake_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteAlways("uh_FloorQuakeDamageBoss",0,1000,7,1048)
TNT1 A 0 A_SpawnItemEx("RedeadGuts_QuakeFX_H")
stop
}
}

actor RedeadGuts_FloorQuakeSpawn : Basic_FloorQuakeSpawn
{
Obituary "\cqRedead \ccGutsman\c- (%k) made %o do the thriller."
damagetype "RedeadGutsStun"
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("RedeadGuts_FloorQuakeBoom",0,0,28,0,0,0,0,32768+1)
stop
}
}

actor RedeadGuts_FloorQuakeBoom : Basic_FloorQuakeBoom
{
Obituary "\cqRedead \ccGutsman\c- (%k) made %o do the thriller."
damagetype "RedeadGutsStun"
}


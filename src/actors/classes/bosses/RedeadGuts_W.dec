goto RITOSUPPORTSERVICE
RITOSUPPORTSERVICE:
8I04 H 0 A_GiveInventory("RedeadGutsHealthGiver")
8I04 H 0 A_PlaySound("item/energyup")//Eargrating
8I04 HH 0 A_SpawnItemEx("RedeadGutsHealingGFX",random(-32,32),random(-32,32),0,momx,momy,20,0,8)

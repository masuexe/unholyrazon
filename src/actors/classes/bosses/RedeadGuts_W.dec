//Help reduce the amount of A_JumpIfHealthLower(2,"ReportedForFeeding")checks plox.

/////////////////
// SION POWERS //
/////////////////
//When's the Loud Nigra beginning "UAAAAHHHH" extended loop for this stuff.
//(Best example is where Bugs bunny screwed around with the opera singer.)
//Or we could just use the basic sounds, that's cool too.
// ' ~' I don't listen to the sfx for the obvious reason of broken audio.


ReportedForFeeding:
8I04 A 0 A_JumpIfInventory("IsPissedFlag",1,"ReadyMadX")
8I04 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8I04 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
8I04 A 0 A_TakeInventory("NoJumpCancel")
8I04 A 0 A_TakeInventory("UnholyBossAmmo200")
8I04 A 0 A_TakeInventory("RedeadGutsJumpAmmo")
8I04 A 0 A_TakeInventory("SuperArmTemp")
8I04 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I04 A 0 ThrustThingZ(0,25,0,0)
8I04 A 0 ThrustThing(random(0,255),500,1,0)
8I04 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,48)
8I04 A 0 A_GunFlash("Flash.SionPassiveStart")
8I04 B 2
8I04 C 2 A_GiveInventory("StopUser_Buddha",1)

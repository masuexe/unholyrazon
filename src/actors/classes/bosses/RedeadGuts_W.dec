actor ForgottenGiantCube : BasicProjectile
{
Translation "192:192=4:4","198:198=3:3"
Obituary "%o collided with \cqRedead \ccGutsman\c- (%k)'s massive boulder."
damagetype "RedeadGuts"
+SKYEXPLODE
+EXPLODEONWATER
-NOGRAVITY
Damage (700)
Height 40
Radius 40
Speed 50
scale 2.5
States
{
Spawn:
8P48 A 1
wait
Death:
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("weapon/superarmhit","Voice")
X_8B AA 0 A_SpawnItemEx("ForgottenGiantCubeRocksSpawner",0,0,0,0,0,0,0,1)
X_8B AA 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-72,72),random(-72,72),random(-72,72),0,0,0,0,0)
X_8B BB 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-102,102),random(-102,102),random(-72,72),0,0,0,0,0)
X_8B CC 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-132,132),random(-132,132),random(-84,84),0,0,0,0,0)
X_8B DD 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-186,186),random(-186,186),random(-96,96),0,0,0,0,0)
X_8B EE 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-248,248),random(-248,248),random(-102,102),0,0,0,0,0)
X_8B FF 1 A_SpawnItemEx("ForgottenGiantCubeKaboom",random(-292,292),random(-292,-292),random(-128,128),0,0,0,0,0)
stop
}
}

actor ForgottenGiantCubeRocksSpawner : BasicGraphicEffect
{
ReactionTime 6
States
{
SpawnFrame:
TNT1 A 0
TNT1 AAAA 0 A_SpawnItemEx("ForgottenGiantCubeRocksFX",0,0,0,random(-30,30),random(-30,30),random(10,20),random(0,359),1)
TNT1 A 2 A_CountDown
loop
}
}

actor ForgottenGiantCubeRocksFX : BasicGraphicEffect
{
-NOINTERACTION
-NOGRAVITY
+HEXENBOUNCE
+DONTSPLASH
+THRUACTORS
States
{
SpawnFrame:
TNT1 A 0 A_SetScale(frandom(2.0,2.5))
8P48 B 2
TNT1 A 2
8P48 B 2
TNT1 A 2
8P48 B 2
TNT1 A 2
8P48 B 2
TNT1 A 2
8P48 B 2
TNT1 A 2
stop
}
}


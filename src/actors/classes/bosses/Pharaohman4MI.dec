// PharaohManMinusInfinityBoss
actor Pharaohman4MI : BossBase {
  Player.ScoreIcon "UB027MUG"
  Player.SoundClass "Pharaohman4MI"
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 10
  Player.MaxHealth 3500
  Health 3500
  Player.MorphWeapon "Pharaohman4MI_W"
  States {
   Spawn:
    PHAR A 0
    PHAR B 1
    PHAR A 1
    goto Spawn+2
   See:
    PHAR BCDE 5
    goto Spawn
   Missile:
    PHAR F 0 A_JumpIfInventory("VivifyDelay6", 1, "Missile1")
    PHAR F 0 A_JumpIfInventory("VivifyDelay7", 1, "Missile2")
    PHAR F 5
    PHAR G 4
    goto Spawn+2
   Missile1:
    PHAR NNG 4
    goto Spawn+2
   Missile2:
    PHAR NNNGG 4
    goto Spawn+2
   ClassPain:
    PHAR H 0
    goto MegamanPain
   ClassDeath:
    PHAR H 0
    goto MegamanDeath
  }
}

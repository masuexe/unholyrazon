actor RichDevilEye : BossBase {
  Player.ScoreIcon "UB302MUG"
  Player.SoundClass "richdevileye"
  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.JumpZ 10
  Player.MaxHealth 1500
  Health 1500

  damagefactor "RichGasm", 0.0

  Player.MorphWeapon "RichDevilEye_W"
  States {
   Spawn:
    8D02 A 0
    8D02 B 1
    8D02 A 1
    goto Spawn+2
   See:
    8D02 BCDE 5
    goto Spawn
   Missile:
    8D02 F 5
    8D02 G 4
    goto Spawn+2
   ClassPain:
    8D02 H 0
    goto MegamanPain
   ClassDeath:
    8D02 H 0
    goto MegamanDeath
  }
}

actor SovietIgniter_W_NormalBar : NormalBar {args 229, 227}
actor SovietIgniter_W_SecondBar : SecondBar {args 223, 5}

actor SovietIgniter_W : BaseUnholyBossWep
{
Tag "$TAG_Boss015_W"
Obituary "%o was burnt badly by \cmSoviet \ciIgniter\c- (%k)."
Inventory.Pickupmessage "\cmFor Soviet Union!"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H15 [ 1
wait

Deselect:
8H15 A 0
goto DeselectSwap
Select:
8H15 A 0
goto SelectSwap

Ready:
8H15 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H15 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SOVIETIGNITER_DYE)
8H15 A 6 
goto ReadyX
ReadyX:
8H15 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX2")
8H15 A 2 A_WeaponReady(8)
8H15 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX2:
8H15 A 2 A_WeaponReady
8H15 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop

FireX:
8H15 A 1 A_TakeInventory("UnholyPower1500",1500)
8h15 A 0 A_GiveInventory("SovietIgniteFlySpawnerFlag", 50)
8H15 A 1 A_PlaySoundEx("weapon/atomicfire","Weapon")
8H15 A 1 A_GunFlash
Goto ReadyX
Flash:
TNT1 A 10 A_FireCustomMissile("FireFlySpawner")
TNT1 A 0 A_TakeInventory("SovietIgniteFlySpawnerFlag")
TNT1 A 0 A_JumpIfInventory("SovietIgniteFlySpawnerFlag", 1, "Flash")
stop

Fire:
8H15 A 0 A_JumpIfInventory("UnholyPower1500",1500,"FireX")
8H15 A 0 A_PlaySoundEx("weapon/firestorm","Weapon")
8H15 A 0 A_FireCustomMissile("SovietIgniteShot",0,0,8,0)
8H15 B 1 Offset(10, 42)
8H15 B 1 Offset(20, 51) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(30, 61)
8H15 B 1 Offset(37, 68) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(40, 70)
8H15 B 1 Offset(28, 58) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(16, 46)
8H15 B 1 Offset(6, 37) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 0
8H15 B 1 A_WeaponReady(14)
8H15 AAAAAA 3 A_GiveInventory("UnholyBossAmmo200", 1)
Goto ReadyX
Altfire:
8H15 A 0 A_TakeInventory("UnholyBossAmmo200",200)
8H15 B 0 A_PlaySoundEx("weapon/magmabazooka","Weapon")
8H15 B 0 A_FireCustomMissile("SovietIgniterCannon",0,0,8,0)
8H15 B 1 Offset(12, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(28, 60)
8H15 B 1 Offset(48, 80) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(64, 96)
8H15 B 1 Offset(64, 96) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(58, 90)
8H15 B 1 Offset(44, 76) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 1 Offset(28, 60)
8H15 B 1 Offset(12, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H15 B 0
8H15 B 1 A_WeaponReady(14)
8H15 A 16
Goto ReadyX
}
}

actor SovietIgniteFlySpawnerFlag : Inventory {
  Inventory.Amount 1
  Inventory.Amount 50
}

actor SovietIgniteShot : BasicProjectile
{
//Translation "198:198=227:227", "192:192=229:229"
Translation "192:192=223:223", "198:198=5:5"
Damagetype "SovietIgnite"
Obituary "%o was burnt badly by \cmSoviet \ciIgniter\c- (%k)."
+SKYEXPLODE
+EXPLODEONWATER
Damage (175)
radius 12
height 12
Speed 60
scale 2.5
States
{
Spawn:
X_1E D 1 A_SpawnItemEx("SovietIgniteShotFX",0,0,0,0,0,0,0,1)
Loop
Death:
TNT1 AAAAAAAA 0 A_SpawnItemEx("SovietFlameThrowerFlames",0,0,8,random(-20,20),random(-20,20),random(0,20),0,0)
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
TNT1 A 0 A_Explode(175, 128, 0)
TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}

actor SovietIgniteShotFX : BasicGraphicEffect
{
States
{
SpawnFrame:
X_1E EEEEFFFF 1 A_FadeOut
stop
}
}

actor SovietFlameThrowerFlames : BasicProjectile
{
Translation "192:192=223:223", "198:198=5:5"
Damagetype "SovietIgnite"
Obituary "%o was burnt badly by \cmSoviet \ciIgniter\c- (%k)."
+RIPPER
+DOOMBOUNCE
-ALLOWBOUNCEONACTORS
+BLOODLESSIMPACT
+SKYEXPLODE
-CANBOUNCEWATER
renderstyle translucent//add
alpha 0.8
reactiontime 1
damage (35)
Radius 6
Height 6
Speed 30
scale 2.5
states
{
Spawn:
6P10 ABCDA 2 A_FadeTo(0.3,0.1,0)
6P10 BCDAB 2 A_FadeTo(0.8,0.1,0)
6P10 CDABC 2 A_FadeTo(0.3,0.1,0)
6P10 DABCD 2 A_FadeTo(0.8,0.1,0)
6P10 D 1 A_CountDown
wait
}
}

actor SovietIgniterCannon : BasicProjectile
{
Translation "192:192=223:223", "198:198=5:5"
+THRUACTORS
+THRUGHOST
+RIPPER
+DONTSPLASH
+DONTBLAST
Obituary "%o was unable to escape %k's \cmSoviet \ciIgniter \cgCannon\c-." //Ignition
Damagetype "SovietIgnite"
Damage(0)
Radius 4
Height 4
Reactiontime 36
Speed 50 //40
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("CutterFlag",6,"SpawnSound")
TNT1 A 0 A_Explode(64,80,0) //56,72
TNT1 A 0 A_SpawnItemEx("SovietIgniterCannonDeathFX")
TNT1 A 0 A_SpawnItemEx("SovietIgniterCannonBit",0,0,0,0,cos(pitch)*3.0,-sin(pitch)*3.0,0,1)
TNT1 A 1 A_SpawnItemEx("SovietIgniterCannonBit",0,0,0,0,cos(pitch+180)*3.0,-sin(pitch+180)*3.0,0,1)
TNT1 A 0 A_SetPitch(pitch%360+30)
TNT1 A 0 A_SpawnItemEx("SovietIgniterCannonDeathFX")
TNT1 A 0 A_SpawnItemEx("SovietIgniterCannonBit",0,0,0,0,cos(pitch)*3.0,-sin(pitch)*3.0,0,1)
TNT1 A 1 A_SpawnItemEx("SovietIgniterCannonBit",0,0,0,0,cos(pitch+180)*3.0,-sin(pitch+180)*3.0,0,1)
TNT1 A 0 A_SetPitch(pitch%360+30)
TNT1 A 0 A_GiveInventory("CutterFlag",1)
TNT1 A 0 A_Countdown
goto Spawn+1
SpawnSound:
TNT1 A 0 A_TakeInventory("CutterFlag")
TNT1 A 0 A_PlaySoundEx("weapon/atomicfire","Body")
goto Spawn+1
Death:
TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
TNT1 A 0 A_SpawnItemEx("SovietIgniterCannonDeath",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
}
}

Actor SovietIgniterCannonDeath : BasicExplosion
{
Obituary "%o forgot to dodge %k's \cmSoviet \ciIgniter \cgCannon\c-."
Damagetype "SovietIgnite"
Damage(0)
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/solarblaze","SoundSlot5")
TNT1 A 0 A_Explode(250,160,0,0,20)
TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("SovietIgniterCannonDeathFX",0,0,0,random(-8,8),0,random(-8,8),random(0,359))
TNT1 A 2
stop
}
}

Actor SovietIgniterCannonDeathFX : BasicClientside
{
Translation "192:192=5:5", "198:198=223:223"
+CANBOUNCEWATER
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+BOUNCEONFLOORS
BounceFactor 1.0
Bouncecount 6
Scale 2.0
States
{
Spawn:
6P10 G 0
6P10 GGHH 2
SpawnLoop:
6P10 G 0 A_Fadeout(0.07)
6P10 GH 1 A_SetScale(scaleX-0.03,scaleY+0.05)
loop
}
}

actor SovietIgniterCannonBit : BasicProjectile
{
Damagetype "SovietIgnite"
Obituary "%o wasn't cool enough to survive (%k)'s \cmSoviet \ciIgniter \cgCannon\c-."
+BRIGHT
+RIPPER
+DONTBLAST

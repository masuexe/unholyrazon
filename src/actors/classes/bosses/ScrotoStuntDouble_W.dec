    9I13 F 1 A_SpawnItemEX("StuntDoubleHaymaker", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    9I13 F 0 A_JumpIfInventory("DecoyFlag1", 1, "GAMESET")
   Tch:
    9I13 F 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "GREATFIGHTINGMAC")
    9I13 F 0 A_SpawnItemEX("StuntDoubleHaymaker", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    9I13 F 0 A_JumpIfInventory("DecoyFlag1", 1, "GAMESET")
    loop

   GREATFIGHTINGMAC:
    9I13 F 0 A_TakeInventory("StuntDoubleFlag")
    9I13 A 0 A_GiveInventory("VivifyDelay5")
    9I13 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    9I13 A 0 A_PlaySoundEx("weapon/SumoHit", "Weapon")
    9I13 F 0 A_ScaleVelocity(0.4)
    9I13 I 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    9I13 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    9I13 A 0 A_TakeInventory("DecoyFlag1")
    9I13 FFFFF 2 Offset(-56, -16)

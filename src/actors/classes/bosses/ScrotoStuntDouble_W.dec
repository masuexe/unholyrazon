actor ScrotoStuntDouble_W_ScriptBar : ScriptBar {}
actor ScrotoStuntDouble_W : BaseUnholyBossWep {
  Tag "$TAG_Boss613_W"
  Obituary "%o was thrown out of the scene by \chScrotoman!\c- (%k)."
  Inventory.Pickupmessage "\cjThe Twin Scrotums."
  weapon.ammotype "UnholyBossAmmo250"
  weapon.ammotype2 "UnholyPower1500"
  States {
   Spawn:
    8H00 [ 1
    wait

   Deselect:
    9I13 A 0
    goto DeselectSwap
   Select:
    9I13 A 0
    goto SelectSwap

   Ready:
    9I13 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    9I13 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 A 6
    9I13 A 0 A_GiveInventory("AirJumpLimit", 1)  // He is literally
    9I13 A 0 A_GiveInventory("WallJumpLimit", 1)  // Captain Falcon, but not really at the same time???????
    9I13 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    9I13 A 0 A_TakeInventory("StuntDoubleCharge", 1)
    9I13 A 2 A_GiveInventory("ScrotoStuntDouble_Ready0_P")
    loop

   Flash:  // 250mil aircontrol effects, invested and stolen by Scrotium productions.
    TNT1 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "VroomVroom")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_TakeInventory("StuntDoubleExhaust", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 2)
    TNT1 A 1 A_ChangeVelocity((momx)*1.025, (momy)*1.025, (momz), CVF_REPLACE)
    loop
    TNT1 A 1 A_ChangeVelocity((momx)*1.015, (momy)*1.015, (momz), CVF_REPLACE)
    loop
   VroomVroom:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
    TNT1 A 0 A_TakeInventory("StuntDoubleExhaust", 1)
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 3)
    TNT1 A 1 A_ChangeVelocity((momx)*1.045, (momy)*1.045, (momz), CVF_REPLACE)
    TNT1 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "VroomVroom")
    Goto Flash
    TNT1 A 1 A_ChangeVelocity((momx)*1.025, (momy)*1.025, (momz), CVF_REPLACE)
    loop

   Fire:
   Charge:
    9I13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "THISISVERYMYSTERIOUS")
    9I13 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "CMON")
    9I13 A 0
    goto Charge0
   Charge0:
    9I13 A 0 A_JumpIfInventory("StuntDoubleCharge", 17, "Charge1")
    9I13 A 0 A_JumpIfInventory("StuntDoubleCharge", 16, "ChargeStart")
    9I13 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge0R")
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 1 A_GiveInventory("StuntDoubleCharge", 1)
    9I13 A 0 A_Refire("Charge0")
    goto BasicFire
   ChargeStart:
    9I13 A 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
    Goto Charge1
   Charge0R:
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    9I13 A 1 A_GiveInventory("StuntDoubleCharge", 2)
    9I13 A 0 A_Refire("Charge0")
    goto BasicFire

   Charge1:
    9I13 A 0 A_JumpIfInventory("StuntDoubleCharge", 60, "Charge2")
    9I13 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Charge1R")
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 1 Offset(2, 52) A_GiveInventory("StuntDoubleCharge", 1)
    9I13 A 0 A_Refire("Charge1")
    goto BasicFire
   Charge1R:
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    9I13 A 1 A_GiveInventory("StuntDoubleCharge", 2)
    9I13 A 0 A_Refire("Charge1")
    goto BasicFire

   Charge2:
    9I13 A 0 A_JumpIfInventory("OverStuntDoubleCharge", 80, "Charge33")
    9I13 A 1 Offset(2, 52) A_RailWait  // Basically this is to indicate the fist is charged.
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 A_GiveInventory("OverStuntDoubleCharge", 1)
    9I13 A 0 A_Refire("Charge22")
    goto MillionDollarPunch
   Charge22:
    9I13 A 0 A_JumpIfInventory("OverStuntDoubleCharge", 80, "Charge333")
    9I13 A 1 Offset(2, 50) A_RailWait  // I know, there are better ways, but.
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 28, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 A_GiveInventory("OverStuntDoubleCharge", 1)
    9I13 A 0 A_Refire("Charge222")
    goto MillionDollarPunch
   Charge222:  // 48
    9I13 A 0 A_JumpIfInventory("OverStuntDoubleCharge", 80, "Charge3")
    9I13 A 1 Offset(2, 51) A_RailWait  // It was a good try.
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 28, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 A_GiveInventory("OverStuntDoubleCharge", 1)
    9I13 A 0 A_Refire("Charge2")
    goto MillionDollarPunch

   Charge3:
    9I13 A 1 Offset(2, 56) A_RailWait
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE1)
    9I13 A 0 A_Refire("Charge33")
    goto NobelEmmyPeacePrizeAwardCeremony
   Charge33:
    9I13 A 1 Offset(2, 50) A_RailWait
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)  // SCROTOSTUNTDOUBLE_DYE
    9I13 A 0 A_Refire("Charge333")
    goto NobelEmmyPeacePrizeAwardCeremony
   Charge333:  // 48
    9I13 A 1 Offset(2, 42) A_RailWait
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 A_Refire("Charge3333")
    goto NobelEmmyPeacePrizeAwardCeremony
   Charge3333:
    9I13 A 1 Offset(2, 50) A_RailWait
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 A 0 A_GiveInventory("UnholyBossAmmo250", 1)
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)  // SCROTOSTUNTDOUBLE_DYE
    9I13 A 0 A_Refire("Charge3")
    goto NobelEmmyPeacePrizeAwardCeremony

   BasicFire:  // StuntDoubleFlagX
    9I13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "THISISVERYMYSTERIOUS")
    9I13 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "CMON")
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 F 0 A_TakeInventory("OverStuntDoubleCharge")
    9I13 F 0 A_TakeInventory("StuntDoubleCharge")
    9I13 F 0 A_PlaySoundEx("weapon/GutMelee", "Weapon")
    9I13 F 0 A_FireCustomMissile("StuntDoubleActionPunch", 0, 0, 8, 0)
    9I13 F 2 Offset(-28, 8)
    9I13 F 2 Offset(-56, -16)
    9I13 E 2 Offset(-30, 4)
    9I13 E 2 Offset(-15, 18)
    9I13 A 1 A_RailWait
    Goto ReadyX

   MillionDollarPunch:
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 F 0 A_TakeInventory("OverStuntDoubleCharge")
    9I13 F 0 A_TakeInventory("StuntDoubleCharge")
    9I13 F 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    9I13 F 2 Offset(-28, 8)
    9I13 F 0 A_FireCustomMissile("StuntDoubleThousandDollarPunch", 0, 0, 8, 0)
    9I13 FFF 2 Offset(-56, -16)
    9I13 E 2 Offset(-30, 4)
    9I13 E 2 Offset(-15, 18)
    9I13 E 0 A_WeaponReady(WRF_NOPRIMARY)
    9I13 AAAAAAA 2
    Goto ReadyX

   NobelEmmyPeacePrizeAwardCeremony:
    9I13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE //' x'
    9I13 F 0 A_TakeInventory("OverStuntDoubleCharge")
    9I13 A 0 A_TakeInventory("StuntDoubleCharge")
    6H51 E 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    6H51 I 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    6H51 I 0 A_ScaleVelocity(0.45)  // 0.45
    9I13 B 0 A_PlaySoundEx("weapon/mirrorabsorb", "Body")
    6H51 I 0 A_GiveInventory("StuntDoubleFlag")
    9I13 F 1 Offset(-28, 8) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE1)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 6) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 5) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 8) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE1)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 6) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 5) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 8) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE1)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 6) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 5) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 8) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE1)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 6) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE2)
    9I13 A 0 A_SpawnItemEX("StuntDoubleFistInidicator", -10, 18, 29, 0, 0, 0)
    9I13 F 1 Offset(-28, 5) ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    6H51 I 0 A_TakeInventory("StuntDoubleFlag")
    9I13 F 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 B 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    9I13 F 0 A_FireCustomMissile("BlinkAndYoullMiss", 0, 0, 8, 0)
    6H51 E 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    6H51 I 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    9I13 FFFFF 2 Offset(-56, -16)
    9I13 E 2 Offset(-30, 4)
    9I13 E 2 Offset(-15, 18)
    9I13 AAAA 2 A_WeaponReady(WRF_NOSECONDARY)
    9I13 AAAAAAAAAAA 2
    Goto ReadyX

    //

    // I mean, he is the stunt double.
   Altfire:
    9I13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "THISISVERYMYSTERIOUS")
    9I13 F 1 A_Railwait
    9I13 F 0 A_JumpIfInventory("StuntDoubleExhaust", 1, "ReadyX")
    Goto SideB

   SideB:
    9I13 A 0 A_TakeInventory("DecoyFlag1")
    9I13 F 0 A_GiveInventory("StuntDoubleFlag")
    9I13 F 0 A_GiveInventory("VivifyDelay7")
    9I13 F 0 A_Refire(1)
    9I13 F 0 A_PlaySoundEx("weapon/SumoLeap", "Weapon")
    9I13 F 0 A_TakeInventory("UnholyBossAmmo200", 200)
    9I13 F 0 ThrustThingZ(0, 35, 0, 0)
    9I13 F 0 A_Recoil(-60)
    9I13 F 1 A_SpawnItemEX("StuntDoubleHaymaker", 0, 0, -48, momx, momy, momz, 0, 8, 0)
    9I13 F 0 A_JumpIfInventory("DecoyFlag1", 1, "GAMESET")
    9I13 F 1 A_SpawnItemEX("StuntDoubleHaymaker", 0, 0, -48, momx, momy, momz, 0, 8, 0)

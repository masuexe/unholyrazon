actor StuntDoubleLander : BasicExplosion {
  damagetype "ScrotoStunt_Damage"  // ScrotoFling
  Obituary "\chScrotoman!\c- (%k)'s performance stopped %o's heart."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_Explode(100, 128, 0, 0, 92)
    stop
  }
}

actor StuntDoubleHaymaker : BasicProjectile {
  damagetype "ScrotoStunt_LiftUp"  // ScrotoFlingUp
  Obituary "\chScrotoman!\c- (%k) stole the rights to %o's life."
  +THRUGHOST
  +DONTREFLECT
  damage (75)
  Radius 60
  Height 168
  scale 5.5
  States {
   Spawn:
    TNT1 AAA 1
    stop
   XDeath:
   Crash:
    TNT1 A 0 A_GiveToTarget("StuntDoubleHayMakerPuff", 1)
    TNT1 A 2
    Stop
   Death:
    TNT1 A 0
    Stop
  }
}

actor StuntDoubleHaymaker2 : BasicExplosion {
  damagetype "ScrotoStunt_Damage"  // ScrotoFlingUp
  Obituary "\chScrotoman!\c- (%k) stole the rights to %o's life."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_Explode(250, 128, 0, 0, 64)
    stop
  }
}


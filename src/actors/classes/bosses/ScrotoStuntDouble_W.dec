// Bonfire is orange. Do not change this.
actor BlinkAndYoullMiss : FastProjectile {
  PROJECTILE
  Translation "192:192=192:192", "198:198=198:198"
  damagetype "ScrotoStunt_Damage"  // ScrotoBlingBling //Screamer but something something Protoman
  Obituary "%o caught \chScrotoman!\c- (%k)'s infamous-- I mean, famous \chCelebrity Greeting\c-.."
  +THRUGHOST
  +DONTREFLECT
  +DONTBLAST
  Damage (250)  // 250 ~ 1000 ~ 9999
  Radius 10
  Height 10
  Speed 775
  Scale 3.5
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(8, 35, 0, 32, 0)  // A second = 35 tics
    TNT1 A 0 A_Explode(200, 256, 0, 0, 96)  // Impact damage
    TNT1 A 0  // A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "Voice")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_radiuspull", 25, 500, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-76, 76), random(-76, 76), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B ABC 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-76, 76), random(-76, 76), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B BCB 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-76, 76), random(-76, 76), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B CBC 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-128, 128), random(-128, 128), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B BCB 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-128, 128), random(-128, 128), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B CBC 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    X_8B AA 0 A_SpawnItemEx("StuntDoubleKabooming", random(-128, 128), random(-128, 128), random(-84, 84), 0, 0, 0, 0, 1)
    X_8B DEF 2 A_SpawnItemEx("StuntDoubleKaboomingEX", random(-256, 256), random(-256, 256), random(-128, 128), 0, 0, 0, 0, 1)
    stop
  }
}


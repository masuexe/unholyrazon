actor ReplicaScrotoCruiseProjectile : BasicProjectile {
  -SOLID
  Translation "192:192=192:192", "198:198=198:198"
  -NOGRAVITY
  +RIPPER
  Damage (250)
  damagetype "ScrotoStunt_Fling"
  Obituary "%o caught \chScrotoman!'s 250mil Scroto-Cruiser replica\c-."
  Height 16  // 40
  Radius 12  // 16
  gravity 1.8  // 900.0
  speed 60
  States {
   Spawn:
    TNT1 A 1
    TURB A 0 A_GiveInventory("Clip", 1)
    TURB BCDE 1
    Goto Spawn+2
    // Crash:
   XDeath:
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruisePoof", 0, 0, 6, 0, 0, 0, 0)
    stop
   Death:
    TNT1 A 0 A_JumpIfInventory("Clip", 1, "Continue")
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruisePoof", 0, 0, 6, 0, 0, 0, 0)
    stop
   Continue:
    TNT1 A 0 A_CustomMissile("ReplicaScrotoCruiseProjectile", 0, 0, 0, 2, 0)
    TNT1 A 1
    stop
  }
}

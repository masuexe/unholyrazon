    9I13 L 1 A_SpawnItemEx("StuntDoubleHyes", 0, 0, 56, momx, momy, momz, 0, 40, 0)
    9I13 G 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    9I13 G 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE3)
    9I13 L 1 A_SpawnItemEx("StuntDoubleHyes", 0, 0, 56, momx, momy, momz, 0, 40, 0)
    9I13 G 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    9I13 G 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 G 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)  //
   Whomstev:
    // 6H51 I 0 A_SpawnItemEx("StuntDoubleHyes",0,0,56,momx,momy,momz,0,40,0)
    9I13 L 1 A_JumpIfInventory("SuplexID", 1, "Suplex")
    9I13 G 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "MFWLanded")
    Loop
   MFWLanded:  // Should landing even do any damage at all?
    9I13 G 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 G 0 A_ScaleVelocity(0.25)
    9I13 G 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1, 0)
    9I13 G 0 A_SpawnItemEx("StuntDoubleLander", 0, 0, 5, 0, 0, 0, 0, 0)  // 5z
    // 9I13 G 0 ACS_ExecuteAlways(247,0,750,128,1) //All this did was disorient people... uncommonly.
    9I13 G 0 A_TakeInventory("StuntDoubleFlag")
    9I13 G 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    9I13 G 0 A_TakeInventory("NoJumpCancel")
    9I13 LL 1 A_JumpIfInventory("SuplexID", 1, "Suplex")
    9I13 KJIH 2
    9I13 G 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    TNT1 A 10
    9I13 AAAAA 2
    goto ReadyX
   Suplex:
    // 9I13 L 0 A_TakeInventory("UnholyBossAmmo250")
    9I13 L 0 A_WeaponReady(14)
    9I13 L 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    9I13 L 0 A_PlaySoundEX("weapon/crashland", "SoundSlot7")
    9I13 L 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    9I13 L 0 A_TakeInventory("NoJumpCancel")
    // Drop DejaVu/reload stackers before re-applying (Unholy: SetPlayerProperty off + ChangeFlag).
    // Jumping here mid-ascent otherwise leaves one PlayerPropertyNoGravity layer.
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    TNT1 A 0 A_GiveInventory("Zangief_SuplexStartA_P")
    9I13 L 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    9I13 L 0 A_Stop
    9I13 L 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    9I13 L 1 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)  // ACS_NamedExecuteAlways("uh_ZangiefStartGrab",0,CallACS("rz_CountInv_ZangiefAngle")-1+1000)

    9I13 L 0 A_SpawnItemEx("ZangiefGrabFX", 56, 0, 28, 0, 0, 0, 0, 1, 0)
    9I13 L 0 A_SpawnItemEx("ZangiefGrabFX2", 56, 0, 28, 0, 0, 0, 0, 1, 0)
    // 360
    9I13 L 0 A_SetPitch(-348)
    9I13 L 0 A_JumpIfInventory("PlayerPropertyRage", 1, 4)
    9I13 LLLLLL 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "AtomicKaboom")  // A_Jumpif(CallACS("uh_ZangiefGrab",348,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
    9I13 L 0 A_JumpIfInventory("PlayerPropertyRage", 1, 4)
    9I13 LLLLLL 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "AtomicKaboom")  // A_Jumpif(CallACS("uh_ZangiefGrab",348,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
    9I13 L 0 A_JumpIfInventory("PlayerPropertyRage", 1, 4)
    9I13 LLLLLL 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "AtomicKaboom")  // A_Jumpif(CallACS("uh_ZangiefGrab",348,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
    9I13 L 0 A_JumpIfInventory("PlayerPropertyRage", 1, 4)
    9I13 LLLLLL 1 A_Jumpif(CallACS("uh_ZangiefGrab", 0, angle*256/360, 100)==0, "AtomicKaboom")  // A_Jumpif(CallACS("uh_ZangiefGrab",348,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
    9I13 L 0 A_TakeInventory("StuntDoubleFlag")
    9I13 L 0 A_SetPitch(0)
    9I13 L 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    9I13 L 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
   AtomicKaboom:
    // Grab abort can jump here before the clears above — drop stackers once.
    9I13 L 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    9I13 L 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    9I13 L 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_ZangiefAngle")-1+1000)  // Disable invun on grabbed player
    9I13 L 0 A_SpawnItemEX("MichaelBayKaboom", 5, 0, 32, 0, 0, 0)
    9I13 L 0 A_GiveInventory("StuntDoubleCharge", 25)  // 30
    9I13 L 1 A_Recoil(25)
    9I13 L 0 ThrustThingZ(0, 60, 0, 0)
    9I13 KJIH 2
    TNT1 A 0 A_GiveInventory("ScrotoStuntDoubleResetPickup")
    TNT1 A 12
    6H51 B 0 A_WeaponReady
    9I13 AAAA 2
    goto ReadyX
    /// /////
    /// /////
    // Rage//
    /// /////
    /// /////
   CMON:
    9I13 L 0 A_GiveInventory("UnholyPowerDazzle_F")
    9I13 L 0 A_GiveInventory("StuntDoubleFlagX")
    9I13 F 0 A_TakeInventory("OverStuntDoubleCharge")
    9I13 F 0 A_TakeInventory("StuntDoubleCharge")
    9I13 L 0 A_GiveInventory("FuelOverStuntDoubleCharge", 200)
    TNT1 A 0 A_PlaySoundEx("weapon/ScrotoRadio", "Body")
    TNT1 A 0 A_Refire(1)
   MYSTERIOUS:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    goto MYSTERIOUS_Loop
   MYSTERIOUS_Loop:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_radiuspull", 25, 500, 0, 1)
    TNT1 A 0 A_GiveInventory("StuntDoubleRageBoost_P")  // F- Class Driving //
    TNT1 A 1 A_SpawnItemEX("StuntDoubleCruiseRam", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "MYSTERIOUSX")
    TNT1 A 0 A_TakeInventory("UnholyPower1500", 10)  // 5
    TNT1 A 0 A_JumpIfInventory("UnholyPower1500", 1, "MYSTERIOUS_Loop")
    Goto UHOH
   MYSTERIOUSX:
    TNT1 A 0 A_TakeInventory("UnholyPower1500", 5)  // 2
    TNT1 A 0 A_JumpIfInventory("UnholyPower1500", 1, "MYSTERIOUS_Loop")
    Goto UHOH
   THISISVERYMYSTERIOUS:  // EJECT BUTTON
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    TNT1 A 0 A_ScaleVelocity(0.2)
    TNT1 A 0 A_TakeInventory("UnholyPowerDazzle_F")
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge")
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Body")
    TNT1 A 0 A_FireCustomMissile("ReplicaScrotoCruiseProjectile", 0, 0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    9I13 L 0 A_TakeInventory("StuntDoubleFlagX")
    TNT1 A 0 ThrustThingZ(0, 60, 0, 0)
    TNT1 A 5 A_Recoil(25)
    TNT1 A 1
    9I13 A 2
    Goto ReadyX

    // TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", 31604)
    // TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", 31605)

   UHOH:
    TNT1 A 0 A_GiveInventory("StuntDoubleRageBoost_PX")
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 50, "UHOH")
    Goto UMU
   UMU:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31604)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU2")
    Goto WHATTHEFUCK
   UMU2:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31604)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU3")
    Goto WHATTHEFUCK
   UMU3:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31604)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU4")
    Goto WHATTHEFUCK
    //
   UMU4:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31605)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU5")
    Goto WHATTHEFUCK
   UMU5:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31605)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU6")
    Goto WHATTHEFUCK
   UMU6:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31605)
    TNT1 A 0 A_SpawnItemEX("StuntDoubleCruiseRamX", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY|WRF_NOSWITCH)
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge", 1)
    TNT1 A 0 A_JumpIfInventory("FuelOverStuntDoubleCharge", 1, "UMU")
    Goto WHATTHEFUCK
   WHATTHEFUCK:  // Disallow Jumping
    TNT1 A 0 ACS_NamedExecuteWithResult("core_chargecolor", SCROTOSTUNTDOUBLE_DYE)  // SCROTOSTUNTDOUBLE_DYE
    TNT1 A 0 A_TakeInventory("UnholyPowerDazzle_F")
    TNT1 A 0 A_TakeInventory("FuelOverStuntDoubleCharge")
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Body")
    TNT1 A 0 A_FireCustomMissile("StuntDoubleCruisePoof", 0, 0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    6H51 I 0 A_TakeInventory("StuntDoubleFlagX")
    TNT1 A 0 A_GiveInventory("StuntDoublePain", 100)
    TNT1 A 0 ThrustThingZ(0, 75, 0, 0)  // 25 ~ 75
    TNT1 A 5 ThrustThing(random(0, 255), 500, 1, 0)
    TNT1 A 1 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
   AGONY:
    TNT1 A 1 A_TakeInventory("StuntDoublePain", 1)
    TNT1 A 0 A_JumpIfInventory("StuntDoublePain", 1, "AGONY")
    Goto RESTORED
   RESTORED:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    9I13 AA 2
    Goto ReadyX
  }
}

//
actor ScrotoStuntDoubleResetPickup : CustomInventory {
  // Well, I don't know what to pluck out, so I'm just doing it all like this - Trist.
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SuplexID")
    TNT1 A 0 A_TakeInventory("IsPerformingSuplex")
    TNT1 A 0 A_TakeInventory("ZangiefAngle")
    TNT1 A 0 A_TakeInventory("ZangiefHoldFlag")

    TNT1 A 0 A_TakeInventory("BasicArmor")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfpushplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfHitStunplayer", 0, false)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)

    TNT1 A 0 ACS_NamedExecuteWithResult("core_nonshootableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)

    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    stop
  }
}

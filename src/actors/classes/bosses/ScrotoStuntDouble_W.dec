}

actor StuntDoubleHayMakerPuff : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("DecoyFlag1", 1, "No")
    TNT1 A 0 A_Stop
    TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
    TNT1 A 0 A_GiveInventory("DecoyFlag1")
    TNT1 A 0 A_FireCustomMissile("StuntDoubleHaymaker2", 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("StuntDoubleHaymakerFX")
    TNT1 A 0 A_Recoil(20)
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor ScrotoStuntDouble_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor ScrotoStuntDouble_Ready8_P : ScrotoStuntDouble_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}


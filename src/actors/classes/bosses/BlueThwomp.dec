actor BlueThwomp : BossBase {
  Player.ScoreIcon "UB116MUG"
  Player.SoundClass "BlueThwomp"
  Player.ForwardMove 0.01, 0.01
  Player.SideMove 0.01, 0.01
  Player.JumpZ 0
  Player.MaxHealth 10000
  Health 10000
  Player.MorphWeapon "BlueThwomp_W"
  MaxStepHeight 32  // 24
  MaxDropOffHeight 32  // 24
  States {
   Spawn:
    8C00 A 0
    8C00 A 1
    8C00 A 1
    wait
   See:
    8C00 A 4
    goto Spawn
   Missile:
    8C00 A 1
    goto Spawn+2
   ClassPain:
    8C00 H 0
    goto MegamanPain
   ClassDeath:
    8C00 H 0
    goto MegamanDeath
  }
}

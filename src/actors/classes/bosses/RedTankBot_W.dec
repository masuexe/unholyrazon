actor RedTankBot_W_NormalBar : NormalBar {args 184, 189}
actor RedTankBot_W_ReloadIcon : ReloadIcon {Tag "R035B0X"}
actor RedTankBot_W : BaseUnholyBossWep {
  Tag "$TAG_RedTankBot_W"
  Obituary "%o was crushed by \cgRed TankBoi\c- (%k)'s Machine Buster!"
  Inventory.Pickupmessage "\cgTankboi Red\c- Waiting for orders!"
  weapon.ammotype "UnholyPower1000"
  States {
   Spawn:
    8H35 [ 1
    wait

   Deselect:
    8H35 A 0
    goto DeselectSwap
   Select:
    8H35 A 0
    goto SelectSwap

   Ready:
    8H35 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8H35 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, REDTANKBOT_DYE)
    8H35 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
   ReadyX_0:
    8H35 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX_16")
    8H35 A 2 A_WeaponReady(8)
    goto ReadyX
   ReadyX_16:
    8H35 A 2 A_WeaponReady(8+16)
    goto ReadyX

   Fire:
    // 8H35 A 0 A_JumpIfInventory("UnholyPower1000",1000,"FireRage")
    8H35 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireA")
    8H35 A 0 A_GiveInventory("DuoBusterFlag")
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, 8, 0)
    8H35 DE 3
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, -8, 0)
    8H35 BH 3
    8H35 G 0 A_Refire("Fire2")
    Goto FireEndG
   Fire2:
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, 8, 0)
    8H35 BE 3
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, -8, 0)
    8H35 BH 3
    8H35 G 0 A_Refire("Fire2")
    Goto FireEndG
   FireA:
    8H35 A 0 A_TakeInventory("DuoBusterFlag")
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, -8, 0)
    8H35 GH 3
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, 8, 0)
    8H35 BE 3
    8H35 D 0 A_Refire("FireA2")
    Goto FireEndD
   FireA2:
    8H35 A 0  // A_JumpIfInventory("IsBot",1,"BotFire")
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, -8, 0)
    8H35 BH 3
    8H35 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    8H35 A 0 A_FireCustomMissile("RedHeavyShot", random(-2, 2), 0, 8, 0)
    8H35 BE 3
    8H35 D 0 A_Refire("FireA2")
    Goto FireEndD

   FireEndD:
    8H35 D 3
    Goto ReadyX
   FireEndG:
    8H35 G 3
    Goto ReadyX

   Flash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
    TNT1 A 2 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "I_Love_The_Floor")
    loop
   I_Love_The_Floor:
    TNT1 A 2 A_JumpIf(momz==0, "HighJump")
    Goto NoJumpForYou
   HighJump:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_Boost_Boom", 0, 0, 10, 0, 0, 0, 0, 1)
    TNT1 A 0 ThrustThingZ(0, 60, 0, 0)
    TNT1 A 0 A_Recoil(-35)
    TNT1 AA 2 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")
   TonyHawkAirCheck:
    TNT1 A 0 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")  // 9
    TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting"), "LandingPoint")
    // TNT1 A 0 A_PlaySoundEx("BUTTSCKS","Body")
    TNT1 A 0 A_SpawnItemEX("RedTankBoi_Contact_Damage", 0, 0, 0, momx, momy, momz, 0, 8, 0)
    loop
   LandingPoint:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 Radius_Quake(4, 35, 0, 50, 0)  // 6 quake strength
    TNT1 A 0 A_SpawnItemEX("RedTankBoi_Dust", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("misc/hugequake", "Body")
    TNT1 A 2 A_SpawnItemEX("RedTankBoi_WaveSpawner")
    TNT1 A 6 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")  //
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    TNT1 AAA 10 A_JumpIf(!CallACS("uh_CanContinueBossWeaponFlash"), "NoFlash")  //
    Goto Flash
   NoJumpForYou:
    TNT1 A 6
    Goto Flash

   Reload:
    8H35 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "MissileBarrage")
   MissileBarrage:
    8H35 A 0 A_TakeInventory("UnholyPower1000", 1000)
    8H35 A 0 A_PlaySoundEx("misc_L/fakereloadshort", "SoundSlot6")
    8H35 AB 5
    8H35 A 0 A_GiveInventory("RedTankBoi_Rage_Fire_P")
    8H35 A 0 A_PlaySoundEx("S3_K/SpikeMine", "Body", "SoundSlot7")
    8H35 CCB 5
    goto ReadyX

    /*FireRage:
8H35 A 0 A_TakeInventory("UnholyPower1000",1000)
8H35 A 0 A_PlaySoundEx("misc_L/fakereloadshort","Weapon")
8H35 AB 5
8H35 C 0 A_FireCustomMissile("RedHeavyRageShot",0,0,0,0)
8H35 C 0 A_FireCustomMissile("RedHeavyRageShot",-4,0,20,0)
8H35 C 0 A_FireCustomMissile("RedHeavyRageShot",4,0,-20,0)
8H35 C 0 A_PlaySoundEx("S3_K/SpikeMine","Body")
8H35 C 0 A_ChangeVelocity(-Cos(pitch)*50,0,sin(pitch)*25,CVF_RELATIVE)
8H35 CBA 5
Goto ReadyX*/

    /*Altfire:
8H35 A 0 A_JumpIf(momz==0,"LongJump")
goto ReadyX
LongJump:
8H35 A 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8H35 A 0 ThrustThingZ(0,50,0,0)
8H35 A 0 A_Recoil(-35)
8H35 A 2 Offset(0,47)
8H35 A 2 Offset(0,62)
8H35 A 2 Offset(0,77)
8H35 A 2 Offset(0,92)
TNT1 A 9
8H35 A 2 Offset(0,92)
8H35 A 2 Offset(0,77)
8H35 A 2 Offset(0,62)
8H35 A 2 Offset(0,47)
Goto ReadyX*/
  }
}

actor RedTankBoi_Rage_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RedHeavyRageShot", 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("RedHeavyRageShot", -4, 0, 20, 0)
    TNT1 A 0 A_FireCustomMissile("RedHeavyRageShot", 4, 0, -20, 0)
    TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*50, 0, sin(pitch)*25, CVF_RELATIVE)
    stop
  }
}

actor RedTankBoi_Dust : BasicGraphicEffect {
  States {
   SpawnFrame:
    6P51 ABC 2
    Stop
  }
}


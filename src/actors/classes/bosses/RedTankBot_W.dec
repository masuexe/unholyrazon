    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 285)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 300)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 315)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 330)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 345)
    stop
  }
}


actor RedTankBoi_WavePart : BasicProjectile {
  Translation "192:192=184:184", "198:198=189:189"
  Damagetype "RedTank"
  Obituary "%o was crushed by \cgRed TankBoi\c- (%k)'s Machine Buster!"
  +FLOORHUGGER
  Damage (20)
  Radius 32
  Height 32
  Speed 30
  Scale 3.0
  States {
   Spawn:
    6P36 A 1 A_FadeOut(0.05)
    loop
  }
}

Actor RedTankBoi_Contact_Damage : BasicExplosion {
  Damagetype "RedTank"
  Obituary "%o was crushed by \cgRed TankBoi\c- (%k)'s Machine Buster!"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(75, 110, 0, 0, 24)  // 225
    stop
  }
}

actor RedTankBoi_Boost_Boom : BasicExplosion {
  Obituary "%o was crushed by \cgRed TankBoi\c- (%k)'s Machine Buster!"
  damagetype "RedTank"
  +FORCEXYBILLBOARD
  +BRIGHT
  Speed 48
  Scale 2.75
  Args 400, 128, 20  // 400 Too much?
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("V_Man/Boom", "Body")
    TNT1 A 0 A_Explode(Args[0]*(1+CallACS("uh_checkrune", RUNE_SPREAD)*2), Args[1], 0, 0, Args[2])
    6P16 HIJKL 3
    stop
  }
}

actor RedHeavyShot : BasicProjectile {
  Translation "192:192=184:184", "198:198=189:189"
  damagetype "RedTank"
  Obituary "%o was crushed by \cgRed TankBoi\c- (%k)'s Machine Buster!"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (225)
  radius 20  // 16
  height 20  // 16
  Speed 35  // 40
  scale 3.0  // 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7, 9, 11, 13, 15)
    6P16 A 1
    6P16 AA 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+1
    6P16 B 1
    6P16 BB 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+2
    6P16 C 1
    6P16 CC 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+3
    6P16 D 1
    6P16 DD 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1
    6P16 D 1
    6P16 DD 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+1
    6P16 C 1
    6P16 CC 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+2
    6P16 B 1
    6P16 BB 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+3
    6P16 A 1
    6P16 AA 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2
   Spawn1:
    6P16 ABCD 2
    loop
   Spawn2:
    6P16 DCBA 2
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotEndFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 2
    stop
  }
}


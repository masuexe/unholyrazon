    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 135)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 150)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 165)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 195)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 210)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 225)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 240)

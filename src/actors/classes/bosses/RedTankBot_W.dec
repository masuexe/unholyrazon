actor RedHeavyRageShot : BasicProjectile {
  Translation "192:192=176:176", "198:198=189:189"
  damagetype "RedTank"
  Obituary "%o went boom due to \cgRed TankBoi\c- (%k)'s Machine Buster."
  +SKYEXPLODE
  +EXPLODEONWATER
  -EXTREMEDEATH
  +THRUGHOST
  Damage (200)
  Radius 16
  Height 16
  speed 6
  scale 5.0
  States {
   Spawn:
    X_4G A 4
    X_4G AB 1 A_ChangeVelocity(velx*1.15, vely*1.15, velz*1.15, CVF_REPLACE)
    Goto Spawn+1
   Death:
    X_8G A 0 A_Stop
    X_8G A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    X_8G A 0 A_Explode(600, 256, 0, 0, 64)
    X_8G ABCEFECBA 1
    stop
  }
}

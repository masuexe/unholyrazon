    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 15)
    TNT1 A 0 A_SpawnItemEx("RedTankBoi_WavePart", 0, 0, 0, 32, 0, 0, 30)

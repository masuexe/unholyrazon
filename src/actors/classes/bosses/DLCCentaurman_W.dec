actor DLCCentaurman_W_ScriptBar : ScriptBar {}
actor DLCCentaurman_W : BaseUnholyBossWep {
  Tag "$TAG_Boss111_W"
  Obituary "%o was used as target practice by \cdDLC Centaurman\c- (%k)."
  weapon.ammotype "UnholyBossAmmo150"
  weapon.ammotype2 "UnholyBossAmmo500"
  States {
   Spawn:
    8I11 [ 1
    wait

   Deselect:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, 1)
    goto DeselectSwap
    8I11 A 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)  // 1
    goto DeselectSwap
   Select:
    8I11 A 0
    goto SelectSwap

   Ready:
    8I11 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    8I11 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, DLCCENTAURMAN_DYE)
    8I11 A 0 A_GiveInventory("DLCCentaurmanFlag")
    goto Ready2
   Ready2:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "Ready3R")
    8I11 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "Ready3")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready8_P")
    loop
   Ready3:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready0_P")
    loop
   Ready3R:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready0_P")
    goto Ready2

   Reload:
    8I11 A 0 A_JumpIfInventory("UnholyBossAmmo500", 500, "CentaurJump")
    goto ReadyX
   CentaurJump:
    8I11 A 0 A_TakeInventory("UnholyBossAmmo500", 500)
    8I11 A 0 A_SpawnItemEx("DLCCentaurmanItemFX", 0, 0, 0, 0, 0, 0, 0, 1)
    8I11 A 0 A_GiveInventory("DLCCentaurmanInvunPickup")
    8I11 A 0 A_GiveInventory("DLCCentaurmanInvunPickupFix")
    8I11 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31666)
    8I11 A 2
    goto ReadyX

   ReadyItem:
    8I11 C 2 A_WeaponReady
    8I11 C 0 A_GiveInventory("UnholyBossAmmo150", 4)
    8I11 C 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)  // 1
    8I11 BA 2
    goto Ready2

   Fire:
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "FireX")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "Fire3")
    8I11 B 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "Fire2")
    8I11 B 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrow1", 15, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrow1", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrow1", -15, 0, 8, 0)
    8I11 BCBAAA 3 A_GiveInventory("UnholyBossAmmo500", 1)
    Goto Ready2
   Fire2:
    8I11 A 0 A_TakeInventory("UnholyBossAmmo150", 150)
    8I11 B 0 A_PlaySoundEx("LuckyLass/Fire3", "Weapon")  // "weapon/RaygunSmash" Apparently, this sound does not exist.
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrow2", 0, 0, 8, 0)  // Though, I feel like this is the correct sound... maybe?
    8I11 BCBAAA 3 A_GiveInventory("UnholyBossAmmo500", 1)
    Goto Ready2
   Fire3:
    8I11 B 0 A_PlaySoundEx("wep/ReccaHit", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowRage", 0, 0, 8, 0)
    8I11 CB 2
    Goto Ready2
   FireX:
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)  // 1
    goto Fire+1


   AltFire:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "AltFireX")
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "AltfireBomb")
    8I11 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "TurnOnRage")
    goto Ready2
   TurnOnRage:
    8I11 A 0 A_TakeInventory("UnholyPower1500", 1500)
    8I11 B 0 A_PlaySoundEx("weapon/centaurflash", "Body")
    8I11 B 0 A_FireCustomMissile("DLCCentaurRageStopper", 0, 0, 0, 0)
    8I11 B 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, true)
    8I11 B 0 A_GiveInventory("DLCCentaurmanRageDelay")
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanRage_Watcher")
    8I11 CBA 3
    Goto Ready2
   AltfireBomb:
    8I11 B 0 A_PlaySoundEx("weapon/crackermine", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurRageBomb", 0, 0, 0, 0)
    8I11 CBA 3
    Goto Ready2
   AltFireX:
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)  // 1
    goto AltFire+1
  }
}

actor DLCCentaurmanFlag : Once {}

actor DLCCentaurmanRageDelay : PowerUp {
  Powerup.Duration -7
  powerup.color green 0.30
}

actor DLCCentaurmanInvunPickup : PowerInvisibility  // PowerInvulnerable
{
  +CANTSEEK
  Powerup.Duration -8
  Powerup.Mode "Translucent"
  Powerup.Strength 100
}
actor DLCCentaurmanInvunPickupFix : PowerInvulnerable {
  Powerup.Duration -8
  // Powerup.Color InverseMap
  Powerup.Colormap 1.0, 1.0, 1.0, 0.0, 0.0, 0.0
}

actor DLCCentaurman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo500", 500, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 3)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo500", 2)
    stop
  }
}
actor DLCCentaurman_Ready8_P : DLCCentaurman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor DLCCentaurmanRage_Watcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanFlag")
    goto Spawn2
   Spawn2:
    TNT1 A 1 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 AA 1 A_JumpIfInTargetInventory("DLCCentaurmanRageDelay", 1, "Spawn2")
    goto End
   End:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", CallACS("core_getptrtid", 2)-999, false)
    TNT1 A 1 A_GiveToTarget("DLCCentaurmanFlag")
    stop
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", CallACS("core_getptrtid", 2)-999, false)
    stop
  }
}

actor DLCCentaurmanItemFX : BasicExplosion {
  Scale 2.5
  States {
   Spawn:
    CENT F 0
    CENT F 0 A_PlaySoundEx("S3_K/U_Shield", "Weapon")
    CENT F 2 A_FadeOut
    wait
  }
}

actor DLCCentaurmanItemExplosion : BasicExplosion {
  damagetype "DLCCent"
  Obituary "\cdDLC Centaurman\c- (%k) accidentally killed %o when they returned to reality."
  Translation "192:192=104:104", "198:198=128:128"
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanInvunPickupFix", 1)
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanInvunPickup", 1)
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Weapon")
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Body")
    TNT1 A 0 A_Explode(random(400, 600), 128, 0, 0, 16)
    X_1D BCDEFGHIJKLMN 1
    stop
  }
}

actor DLCCentaurArrow1 : BasicProjectile {
  Translation "192:192=104:104", "198:198=128:128"
  Damage (120)
  damagetype "DLCCent"
  Obituary "%o was used as target practice by \cdDLC Centaurman\c- (%k)."
  radius 10
  height 10
  Speed 65
  scale 3.0
  States {
   Spawn:
    8Q11 A 2
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor DLCCentaurArrow2 : DLCCentaurArrow1 {
  Obituary "\cdDLC Centaurman\c- (%k) reduced %o to pulp with their Explosive Arrow."
  Speed 80
  Damage (200)
  radius 12
  height 12
  scale 3.5
  States {
   Spawn:
    8Q11 B 2
    loop
   Death:
    TNT1 A 0 A_ChangeFlag("DONTBLAST", 1)
    TNT1 A 0 A_SpawnItemEx("DLCCentaurPowerExplosionFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 2 A_SpawnItemEx("DLCCentaurPowerExplosion")
    stop
  }
}

actor DLCCentaurPowerExplosion : BasicExplosion {
  damagetype "DLCCent"
  Obituary "\cdDLC Centaurman\c- (%k) reduced %o to pulp with his Explosive Arrow."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep/ReccaBomb", "Weapon")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAA 4 A_Explode(75, 256, 0, 0, 128)
    stop
  }
}

actor DLCCentaurPowerExplosionFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    8Q11 IZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZGZHZIZJZIZHZG 1
    8Q11 ZZZG 1
    stop
  }
}

actor DLCCentaurArrowRage : DLCCentaurArrow1 {
  Obituary "%o couldn't survive the journey of over time and space with \cdDLC Centaurman\c- (%k)'s Arrow Stream."
  +THRUACTORS
  +DONTBLAST
  Damage (225)
  radius 12
  height 12
  Speed 80
  States {
   Spawn:
    8Q11 B 0
    8Q11 B 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    8Q11 BBBBB 1 A_ScaleVelocity(0.75)
    8Q11 B 0 A_Stop
   Spawn2:
    8Q11 B 1 A_JumpIfInTargetInventory("DLCCentaurmanFlag", 1, "SpawnB")
    8Q11 B 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "SpawnB")
    loop
   SpawnB:
    8Q11 B 1 A_CustomMissile("DLCCentaurArrowRage2", 0, 0, 0, 2, -pitch)
    stop
  }
}

actor DLCCentaurArrowRage2 : DLCCentaurArrowRage {
  -THRUACTORS
  -DONTBLAST
  States {
   Spawn:
    8Q11 B 1
    wait
  }
}


actor DLCCentaurRageStopper : BasicExplosion {
  Translation "192:192=104:104", "198:198=128:128"
  damagetype "BossTimeStop"
  Obituary "%o couldn't survive the journey of over time and space with \cdDLC Centaurman\c- (%k)."

  ReactionTime 4
  Scale 5.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("DLCCentaurRageStopperFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(100, 1000, 0, 0, 1000)
    X_8B ABCDEFF 2
    TNT1 A 0 A_SpawnItemEx("DLCCentaurRageStopperFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(10, 1000, 0, 0, 1000)
    goto SpawnL
   SpawnL:
    X_1G EFGHINMLKJ 2 bright
    TNT1 A 0 A_SpawnItemEx("DLCCentaurRageStopperFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(10, 1000, 0, 0, 1000)
    X_1G JKLMNIHGFE 2 bright
    TNT1 A 0 A_SpawnItemEx("DLCCentaurRageStopperFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(10, 1000, 0, 0, 1000)
    TNT1 A 0 A_CountDown
    loop
   Death:
    X_1G JEKFLGMHNI 2 bright A_Fadeout(0.05)
    TNT1 A 50
    stop
  }
}

actor DLCCentaurRageStopperFX : BasicClientSide {
  ReactionTime 3
  States {
   Spawn:
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FlashM_SparkleFX_Base", random(-1000, 512), random(-1000, 1000), random(-1000, 1000), 0, 0, 0, 0, 129)
    TNT1 A 2 A_CountDown
    loop
  }
}


actor DLCCentBombProtect : PowerProtection {
  Powerup.Duration 3
  DamageFactor "DLCCentBomb", 0.0
}

actor DLCCentaurRageBomb : BasicExplosion {
  Translation "192:192=104:104", "198:198=128:128"
  damagetype "DLCCentBomb"
  Obituary "%o had %p mind sawed out by \cdDLC Centaurman\c- (%k)'s Delayed Blades."
  ReactionTime 70
  Scale 2.5
  States {
   Spawn:
    8Q11 E 0 A_CountDown
    8Q11 EEFF 1 A_JumpIfInTargetInventory("DLCCentaurmanFlag", 1, "SpawnB")
    8Q11 E 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "SpawnB")
    loop
   SpawnB:
    TNT1 A 1 A_SpawnItemEx("DLCCentaurRageBomb2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor DLCCentaurRageBomb2 : DLCCentaurRageBomb {
  States {
   Spawn:
    8Q11 C 0
    8Q11 C 0 A_PlaySoundEx("wep/DLC_CentBoom", "Weapon")
    8Q11 CDCDCDCDCDCDCDCDCDC 4 A_Explode(151, 128, 0, 0, 128)
    8Q11 D 2 A_Explode(151, 128, 0, 0, 128)
    stop
  }
}

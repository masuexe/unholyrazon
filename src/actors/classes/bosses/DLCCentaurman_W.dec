// Idempotent option spawner: fills this player's two independently tracked slots.
actor DLCCentaurOptionSync_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(!CallACS("rz_CentaurOptionSyncNeeded"), "Nothing")
    // Non-monster spawn: engine sets TARGET=caller; SXF_SETMASTER is ignored
    // (only applies to MF3_ISMONSTER). Orbit/input use AAPTR_TARGET.
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOption", 0, 0, 32, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0, CallACS("rz_CentaurOptionSpawnTid"))
    TNT1 A 0 A_JumpIf(!CallACS("rz_CentaurOptionSyncNeeded"), "Nothing")
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOption", 0, 0, 32, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0, CallACS("rz_CentaurOptionSpawnTid"))
    stop
   Nothing:
    TNT1 A 0
    stop
  }
}


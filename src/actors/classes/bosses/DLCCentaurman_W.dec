// Recca-style option satellite.  One actor class serves both slots; the spawn
// angle (absolute) marks the side: 64 = right option, 16384 = left option.
// ACS helpers store slot angles as byte angles; DECORATE angle parameters use
// degrees, so convert with the exact 360/256 factor (1.40625).
actor DLCCentaurOption : ProjSpawnFuncActor {
  Translation "192:192=229:229", "198:198=165:165"
  -SOLID
  +MISSILE
  +NOBLOOD
  +NOGRAVITY
  +SHOOTABLE
  +THRUSPECIES
  +THRUGHOST
  +DONTBLAST
  +NOCLIP
  +INVULNERABLE
  +NODAMAGE
  +NOPAIN
  Species "DLCCentaurman"
  Damage (0)
  Radius 5
  Height 5
  Scale 2.5
  var int user_idx;  // 0 = right slot, 1 = left slot
  var int user_theta;  // orbit slot angle, byte angle 0-255
  var int user_tmp;
  var int user_cool;
  var int user_rep;  // periodic repair counter
  States {
   Spawn:
    TNT1 A 0
    X_4G B 0 A_SetUserVar("user_idx", CallACS("rz_CentaurOptionSlot"))
    goto LoopHead

   LoopHead:
    X_4G B 0 A_JumpIf(!CallACS("rz_CentaurOptionValid", user_idx), "Cleanup")
    X_4G B 0 A_SetUserVar("user_rep", (user_rep + 1) % 71)
    X_4G B 0 A_JumpIf(user_rep > 0, "ModeDispatch")
    X_4G B 0 A_GiveToTarget("DLCCentaurOptionSync_P")
   ModeDispatch:
    X_4G B 0 A_JumpIfInTargetInventory("DLCCentaurOptionMode", 5, "ModeS")
    X_4G B 0 A_JumpIfInTargetInventory("DLCCentaurOptionMode", 4, "ModeR")
    X_4G B 0 A_JumpIfInTargetInventory("DLCCentaurOptionMode", 3, "ModeF")
    X_4G B 0 A_JumpIfInTargetInventory("DLCCentaurOptionMode", 2, "ModeC")
    X_4G B 0 A_JumpIfInTargetInventory("DLCCentaurOptionMode", 1, "ModeB")
    // Clients skip these server-owned inventory jumps. Keep their actor alive
    // until the server's state/position/removal packets arrive.
    goto TailTick

    // B: rear diagonals relative to master facing (right = -135).
   ModeB:
    X_4G B 0 A_Warp(AAPTR_TARGET, 48, 0, 32, 225 - user_idx * 90, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    goto Tail
    // F: slots sit directly right/left of the master's facing; muzzles fan
    // forward by 30 degrees (right = -30, left = +30).
   ModeF:
    X_4G B 0 A_Warp(AAPTR_TARGET, 48, 0, 32, 270 - user_idx * 180, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    X_4G B 0 ACS_NamedExecuteWithResult("rz_CentaurOptionAngle", CallACS("uh_FetchPointerAngle", AAPTR_TARGET) * 256 + (330 + user_idx * 60) * 65536 / 360)
    goto Tail
    // R: fast shared rotation, opposite phases.
   ModeR:
    X_4G B 0 A_SetUserVar("user_theta", (CallACS("rz_CentaurTic") * 12 + user_idx * 128) % 256)
    goto WarpSlot
    // C: slots sit directly right/left of the velocity direction; both muzzles
    // point straight back along the opposite vector. Freeze completely stopped.
   ModeC:
    X_4G B 0 A_SetUserVar("user_tmp", CallACS("uh_GetPointerVelocityAngle", AAPTR_TARGET))
    X_4G B 0 A_JumpIf(user_tmp < 0, "Tail")
    X_4G B 0 A_SetUserVar("user_theta", (user_tmp + 192 - user_idx * 128) % 256)
    X_4G B 0 A_Warp(AAPTR_TARGET, 48, 0, 32, user_theta * 1.40625, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    X_4G B 0 ACS_NamedExecuteWithResult("rz_CentaurOptionAngle", (user_tmp + 128) * 256)
    goto Tail
    // S: slide the slot toward its tangent aim point; muzzle rides the tangent.
   ModeS:
    X_4G B 0 A_SetUserVar("user_theta", CallACS("uh_GradualAngleTurn", user_theta, CallACS("rz_CentaurOptionSeek", user_idx, 896), 2, 256))
    X_4G B 0 A_Warp(AAPTR_TARGET, 48, 0, 32, user_theta * 1.40625, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    X_4G B 0 ACS_NamedExecuteWithResult("rz_CentaurOptionAngle", (user_theta + 64 - user_idx * 128) * 256)
    goto Tail

   WarpSlot:
    X_4G B 0 A_Warp(AAPTR_TARGET, 48, 0, 32, user_theta * 1.40625, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)

    // Listen for the master's AltFire; cooldown paces the shots while held.
    // Must spend >=1 tic per orbit cycle — all-0tic LoopHead/Tail crashes Zandronum.
   Tail:
    X_4G B 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", AAPTR_TARGET, 0) & BT_ALTATTACK, "TailFire")
    X_4G B 0 A_SetUserVar("user_cool", 0)
    goto TailTick
   TailFire:
    X_4G B 0 A_JumpIf(user_cool > 0, "TailCool")
    X_4G B 0 A_SetUserVar("user_cool", 4 - CallACS("uh_checkrune", RUNE_RAGE, AAPTR_TARGET) * 2)
   TailShoot:
    // X_4G B 0 A_PlaySoundEx("Recca/ShotV", "Weapon")
    X_4G B 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, "TailShootSpread")
    X_4G B 0 A_CustomMissile("DLCCentaurOptionShot", 0, 0, 0, 2, 0)
    goto TailCool
   TailShootSpread:
    X_4G B 0 A_CustomMissile("DLCCentaurOptionShot", 0, 0, -15, 2, 0)
    X_4G B 0 A_CustomMissile("DLCCentaurOptionShot", 0, 0, 0, 2, 0)
    X_4G B 0 A_CustomMissile("DLCCentaurOptionShot", 0, 0, 15, 2, 0)
   TailCool:
    X_4G B 0 A_SetUserVar("user_cool", user_cool - 1)
    goto TailTick
   TailTick:
    X_4G B 1
    goto LoopHead

   Cleanup:
    X_4G B 0 ACS_NamedExecuteAlways("rz_CentaurOptionKill", 0)
    X_4G B 1
    // Only the server removes the actor; a predicted stop destroys the client's
    // net-id before later state updates can find it.
    wait
   Death:
    TNT1 A 1
    stop
  }
}


    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 3)
    stop
   HadSome:
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 4, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 3)
    stop

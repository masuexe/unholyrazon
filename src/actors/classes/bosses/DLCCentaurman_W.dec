actor DLCCentaurman_W_ScriptBar : ScriptBar {}
actor DLCCentaurman_W : BaseUnholyBossWep {
  Tag "$TAG_DLCCentaurman_W"
  Obituary "%o was used as target practice by \cdDLC Centaurman\c- (%k)."
  Weapon.AmmoType "UnholyBossAmmo150"
  Weapon.AmmoType2 "UnholyBossAmmo500"
  States {
   Spawn:
    8I11 [ 1
    wait

   Deselect:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, 1)
    goto DeselectSwap
    8I11 A 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)
    goto DeselectSwap
   Select:
    8I11 A 0
    goto SelectSwap

   Ready:
    8I11 A 0  // Initial setup: boss morph hook.
    8I11 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, DLCCENTAURMAN_DYE)
    8I11 A 0  // Initial setup: boss morph hook.
    goto Ready2
   Ready2:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "Ready3R")
    8I11 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "Ready3")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready8_P")
    loop
   Ready3:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready0_P")
    loop
   Ready3R:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 A 2 A_GiveInventory("DLCCentaurman_Ready0_P")
    goto Ready2

   ReadyItem:
    8I11 C 2 A_WeaponReady
    8I11 C 0 A_GiveInventory("UnholyBossAmmo150", 4)
    8I11 C 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "ReadyItem")
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)
    8I11 BA 2
    goto Ready2

    // Dimension jump on Reload (4.0). Recca modes change via world pickups only.
   Reload:
    8I11 A 0 A_JumpIfInventory("UnholyBossAmmo500", 500, "CentaurJump")
    goto Ready2
   CentaurJump:
    8I11 A 0 A_TakeInventory("UnholyBossAmmo500", 500)
    8I11 A 0 A_SpawnItemEx("DLCCentaurmanItemFX", 0, 0, 0, 0, 0, 0, 0, 1)
    8I11 A 0 A_GiveInventory("DLCCentaurmanInvunPickup", 1)
    8I11 A 0 A_GiveInventory("DLCCentaurmanInvunPickupFix", 1)
    8I11 A 0 ACS_NamedExecuteWithResult("core_chargecolor", 31666)
    8I11 A 2
    goto Ready2

   Fire:
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "FireX")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "Fire3")
    8I11 B 0 A_JumpIfInventory("UnholyBossAmmo150", 150, "Fire2")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 4, "FireH")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 3, "FireF")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 2, "FireB")
    8I11 B 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 1, "FireL")
   FireV:
    8I11 B 0 A_PlaySoundEx("Recca/ShotV", "Weapon")
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 1, "FireV2")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 0, 0, 8, 0)
    goto FireEnd
   FireV2:
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 2, "FireV3")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 15, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", -15, 0, 8, 0)
    goto FireEnd
   FireV3:
    8I11 B 0 A_PlaySoundEx("Recca/ShotV", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 15, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", -15, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowV", -30, 0, 8, 0)
    goto FireEnd

   FireL:
    8I11 B 0 A_PlaySoundEx("Recca/ShotL", "Weapon")
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 1, "FireL2")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowL", 0, 0, 8, 0)
    goto FireEnd
   FireL2:
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 2, "FireL3")
    8I11 B 0 A_JumpIfInventory("DLCCentaurLaserSide_F", 1, "FireL2_R")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowL", 0, 0, 8 + 32, 0)
    8I11 B 0 A_GiveInventory("DLCCentaurLaserSide_F")
    goto FireEnd
   FireL2_R:
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowL", 0, 0, 8 - 32, 0)
    8I11 B 0 A_TakeInventory("DLCCentaurLaserSide_F")
    goto FireEnd
   FireL3:
    8I11 B 0 A_JumpIfInventory("DLCCentaurLaserSide_F", 1, "FireL3_R")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowL3", 0, 0, 8 + 32, 0)
    8I11 B 0 A_GiveInventory("DLCCentaurLaserSide_F")
    goto FireEnd
   FireL3_R:
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowL3", 0, 0, 8 - 32, 0)
    8I11 B 0 A_TakeInventory("DLCCentaurLaserSide_F")
    goto FireEnd

   FireB:
    8I11 B 0 A_PlaySoundEx("Recca/ShotB", "Weapon")
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 1, "FireB2")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 - 36, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 + 36, 0)
    goto FireEnd
   FireB2:
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 2, "FireB3")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 - 36, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 + 36, 0)
    goto FireEnd
   FireB3:
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 - 36, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 + 36, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 - 18, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowB", 0, 0, 8 + 18, 0)
    goto FireEnd

   FireF:
    8I11 B 0 A_PlaySoundEx("Recca/ShotF", "Weapon")
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 1, "FireF2")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", -30, 0, 8, 0)
    goto FireEnd
   FireF2:
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 2, "FireF3")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", -30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 180, 0, 8, 0)
    goto FireEnd
   FireF3:
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 0, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", -30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 180 + 30, 0, 8, 0)
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowF", 180 - 30, 0, 8, 0)
    goto FireEnd

   FireH:
    8I11 B 0 A_PlaySoundEx("Recca/ShotH", "Weapon")
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 1, "FireH2")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowH", 0, 0, 8, 0)
    goto FireEnd
   FireH2:
    8I11 B 0 A_JumpIfInventory("DLCCentaurWepStack", 2, "FireH3")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowH2", 0, 0, 8, 0)
    goto FireEnd
   FireH3:
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowH3", 0, 0, 8, 0)
    goto FireEnd

   FireEnd:
    8I11 A 0 A_TakeInventory("UnholyBossAmmo150", 150)
    8I11 B 1 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE), 1)
    8I11 C 1 A_GiveInventory("UnholyBossAmmo500", 1)
    8I11 B 1 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE), 1)
    8I11 A 1 A_GiveInventory("UnholyBossAmmo500", 1)
    goto Ready2
   Fire2:
    8I11 A 0 A_TakeInventory("UnholyBossAmmo150", 150)
    8I11 B 0 A_PlaySoundEx("weapon/RaygunSmash", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrow2", 0, 0, 8, 0)
    8I11 BCBAAA 3 A_GiveInventory("UnholyBossAmmo500", 1)
    goto Ready2
   Fire3:
    8I11 B 0 A_PlaySoundEx("Recca/Hit", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurArrowRage", 0, 0, 8, 0)
    8I11 CB 2
    goto Ready2
   FireX:
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)
    goto Fire+1

   AltFire:
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanInvunPickup", 1, "AltFireX")
    8I11 A 0 A_JumpIfInventory("DLCCentaurmanRageDelay", 1, "AltfireBomb")
    8I11 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "TurnOnRage")
    goto Ready2
   TurnOnRage:
    8I11 A 0 A_TakeInventory("UnholyPower1500", 1500)
    8I11 B 0 A_PlaySoundEx("weapon/centaurflash", "Body")
    8I11 B 0 A_FireCustomMissile("DLCCentaurRageStopper", 0, 0, 0, 0)
    8I11 B 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, 1)
    8I11 B 0 A_GiveInventory("DLCCentaurmanRageDelay", 1)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanRage_Watcher")
    8I11 CBA 3
    goto Ready2
   AltfireBomb:
    8I11 B 0 A_PlaySoundEx("weapon/crackermine", "Weapon")
    8I11 B 0 A_FireCustomMissile("DLCCentaurRageBomb", 0, 0, 0, 0)
    8I11 CBA 3
    goto Ready2
   AltFireX:
    8I11 B 0 ACS_NamedExecuteWithResult("core_chargecolor", DLCCENTAURMAN_DYE)
    8I11 B 0 A_SpawnItemEx("DLCCentaurmanItemExplosion", 0, 0, 32, 0, 0, 0, 0, 0)
    goto AltFire+1
  }
}

actor DLCCentaurmanFlag : Once {}
actor DLCCentaurLaserSide_F : Once {}

actor DLCCentaurmanWepFlag : Inventory {
  Inventory.MaxAmount 4
}

actor DLCCentaurWepStack : Inventory {
  Inventory.MaxAmount 2
}

// Recca-style Option satellites.  Mode: 1=B, 2=C, 3=F, 4=R, 5=S.
// Stack: option count level; switching mode keeps the level.
actor DLCCentaurOptionMode : Inventory {
  Inventory.MaxAmount 5
}

actor DLCCentaurOptionStack : Inventory {
  Inventory.MaxAmount 2
}

actor DLCCentaurmanRageDelay : PowerUp {
  Powerup.Duration -7
  powerup.color green 0.30
}

actor DLCCentaurmanInvunPickup : PowerInvisibility {
  +CANTSEEK
  Powerup.Duration -8
  Powerup.Mode "Translucent"
  Powerup.Strength 100
}

actor DLCCentaurmanInvunPickupFix : PowerInvulnerable {
  Powerup.Duration -8
  Powerup.Colormap 1.0, 1.0, 1.0, 0.0, 0.0, 0.0
}

actor DLCCentaurman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo500", 500, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 3)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo500", 2)
    stop
  }
}

actor DLCCentaurman_Ready8_P : DLCCentaurman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 | WRF_ALLOWRELOAD)
    goto Ammo
  }
}

actor DLCCentaurmanRage_Watcher : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanFlag")
    goto Spawn2
   Spawn2:
    TNT1 A 1 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    TNT1 AA 1 A_JumpIfInTargetInventory("DLCCentaurmanRageDelay", 1, "Spawn2")
    goto End
   End:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", CallACS("core_getptrtid", 2) - 999, false)
    TNT1 A 1 A_GiveToTarget("DLCCentaurmanFlag")
    stop
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", CallACS("core_getptrtid", 2) - 999, false)
    stop
  }
}

actor DLCCentaurmanItemFX : BasicExplosion {
  Scale 2.5
  States {
   Spawn:
    CENT F 0
    CENT F 0 A_PlaySoundEx("S3_K/U_Shield", "Weapon")
    CENT F 2 A_FadeOut
    wait
  }
}

actor DLCCentaurmanItemExplosion : BasicExplosion {
  DamageType "DLCCent"
  Obituary "\cdDLC Centaurman\c- (%k) accidentally killed %o when they returned to reality."
  Translation "192:192=104:104", "198:198=128:128"
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanInvunPickupFix", 1)
    TNT1 A 0 A_TakeFromTarget("DLCCentaurmanInvunPickup", 1)
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Weapon")
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Body")
    TNT1 A 0 A_Explode(random(400, 600), 128, 0, 0, 16)
    X_1D BCDEFGHIJKLMN 1
    stop
  }
}

actor DLCCentaurWepPickup : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5)
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupV")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupL")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupB")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupF")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupH")
    stop
  }
}

actor DLCCentaurWepPickupV : CustomInventory {
  inventory.pickupmessage "Power up! Recca Vulcan!"
  args 100
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    8I11 D 30
    8I11 D 0 A_CountdownArg(0)
    8I11 D 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupL", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Expired:
    TNT1 A 0
    stop
    // razon3 ub_countinv 111: save flag, clear, set mode; stack only if already on that mode.
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 1, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    stop
   No:
    TNT1 A 0
    fail
  }
}

actor DLCCentaurWepPickupL : DLCCentaurWepPickupV {
  inventory.pickupmessage "Power up! Recca Laser!"
  States {
   Spawn:
    8I11 E 0
    8I11 E 30
    8I11 E 0 A_CountdownArg(0)
    8I11 E 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupB", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 1, "HadSome")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 1)
    stop
   HadSome:
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 2, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 1)
    stop
  }
}

actor DLCCentaurWepPickupB : DLCCentaurWepPickupV {
  inventory.pickupmessage "Power up! Recca Beam!"
  States {
   Spawn:
    8I11 F 0
    8I11 F 30
    8I11 F 0 A_CountdownArg(0)
    8I11 F 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupF", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 2, "HadSome")
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 2)
    stop
   HadSome:
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 3, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 2)
    stop
  }
}

actor DLCCentaurWepPickupF : DLCCentaurWepPickupV {
  inventory.pickupmessage "Power up! Recca 5-way!"
  States {
   Spawn:
    8I11 G 0
    8I11 G 30
    8I11 G 0 A_CountdownArg(0)
    8I11 G 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupH", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 3, "HadSome")
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 3)
    stop
   HadSome:
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 4, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 3)
    stop
  }
}

actor DLCCentaurWepPickupH : DLCCentaurWepPickupV {
  inventory.pickupmessage "Power up! Recca Homing!"
  States {
   Spawn:
    8I11 H 0
    8I11 H 30
    8I11 H 0 A_CountdownArg(0)
    8I11 H 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurWepPickupV", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurmanWepFlag", 4, "HadSome")
    TNT1 A 0 A_TakeInventory("DLCCentaurmanWepFlag")
    TNT1 A 0 A_GiveInventory("DLCCentaurmanWepFlag", 4)
    stop
   HadSome:
    TNT1 A 0 A_GiveInventory("DLCCentaurWepStack", 1)
    stop
  }
}

// --- Recca-style Option mode pickups (independent B -> C -> F -> R -> S cycle) ---
// Same letter while below 2 options: raise the count level.  Different letter:
// switch mode, keep the level.  First letter: mode + one option.

actor DLCCentaurOptionPickup : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5)
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupB")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupC")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupF")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupR")
    stop
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupS")
    stop
  }
}

actor DLCCentaurOptionPickupB : CustomInventory {
  inventory.pickupmessage "Recca Option! Backwards!"
  args 100
  Scale 2.5
  Translation "192:192=176:176"
  States {
   Spawn:
    8I11 I 30
    8I11 I 0 A_CountdownArg(0)
    8I11 I 0 A_JumpIf(args[0] == 0, "Expired")
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("DLCCentaurOptionPickupC", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
   Expired:
    TNT1 A 0
    stop
   Pickup:
    TNT1 A 0 A_JumpIf(!CheckClass("DLCCentaurman"), "No")
    TNT1 A 0 A_PlaySound("Recca/WepPickup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("DLCCentaurOptionMode", 1, "HaveSome")
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionMode", 1)
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionStack", 1)
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionSync_P")
    stop
   HaveSome:
    TNT1 A 0 A_JumpIfInventory("DLCCentaurOptionMode", 2, "PickupSwitch")
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionStack", 1)
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionSync_P")
    stop
   PickupSwitch:
    TNT1 A 0 A_TakeInventory("DLCCentaurOptionMode")
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionMode", 1)
    TNT1 A 0 A_GiveInventory("DLCCentaurOptionSync_P")
    stop
   No:
    TNT1 A 0
    fail
  }
}


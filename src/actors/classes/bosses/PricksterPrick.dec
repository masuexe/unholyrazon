actor PricksterPrick : BossBase {
  Player.ScoreIcon "UB513MUG"
  Player.SoundClass "PricksterPrick"
  Player.ForwardMove 1.55, 1.55
  Player.SideMove 1.55, 1.55
  Player.JumpZ 15
  Player.MaxHealth 2000
  Health 2000
  Player.MorphWeapon "PricksterPrick_W"
  States {
   Spawn:
    9A13 A 0
    9A13 B 1
    9A13 A 35
    9A13 AQ 5
    goto Spawn+3
   See:
    9A13 BCDE 4
    goto Spawn
   Missile:
    9A13 F 0 A_JumpIfInventory("VivifyDelay8", 1, "Missile2")
    9A13 F 5
    9A13 G 5
    goto Spawn+2
   Missile2:
    9A13 IJKLIJKLIJKL 3
    goto Spawn+2
   ClassPain:
    9A13 H 0
    goto MegamanPain
   ClassDeath:
    9A13 H 0
    goto MegamanDeath
  }
}

actor TheShadowManMythBoss : BossBase {
  Player.ScoreIcon "UB305MUG"
  Player.SoundClass "TheShadowManMythBoss"  //
  Player.ForwardMove 1.4, 1.4  //
  Player.SideMove 1.4, 1.4  //
  Player.JumpZ 16  // 15
  Player.MaxHealth 10000
  Health 10000
  Player.MorphWeapon "TheShadowManMythBoss_W"
  /*
+THRUSPECIES
Species "ShadowmanHaha"
   */
  States {
   Spawn:
    SHAG A 0
    SHAG B 1
    SHAG A 1
    goto Spawn+2
   See:  // A_GiveInventory("ShadowBoss_ShadowStep",1)
    SHAG B 3 A_GiveInventory("ShadowBoss_ShadowStep")  // 5
    SHAG C 3  // 5
    SHAG D 3 A_GiveInventory("ShadowBoss_ShadowStep")  // 5
    SHAG E 3  // 5
    goto Spawn
   Missile:
    SHAG F 0 A_JumpIfInventory("ShadowBoss_FunnyTrail", 1, "MissileSlide")
    SHAG F 5 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    SHAG G 4
    goto Spawn+2
   Missile2:
    SHAG C 5
    SHAG F 1 A_JumpIfInventory("VivifyDelay3", 1, "Spawn")
    wait
   MissileSlide:
    SHAG I 23  //
    goto Spawn+2
   ClassPain:
    SHAG H 0
    goto MegamanPain
   ClassDeath:
    SHAG H 0
    goto MegamanDeath
  }
}

actor ColonelKachidonga : BossBase {
  Player.ScoreIcon "UB004MUG"
  Player.SoundClass "ColonelKachidonga"
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 11
  Player.MaxHealth 4375
  Health 4375
  Player.MorphWeapon "ColonelKachidonga_W"
  States {
   Spawn:
    GREM A 0
    GREM B 1 A_JumpIfInventory("KangoFireFlag", 1, "Missile")
    GREM A 1 A_JumpIfInventory("KangoFireFlag", 1, "Missile")
    goto Spawn+2
   See:
    GREM BBBBBCCCCCDDDDDEEEEE 1 A_JumpIfInventory("KangoFireFlag", 1, "Missile")
    goto Spawn
   Missile:
    GREM F 5
    GREM GGGG 1 A_JumpIfInventory("KangoFireFlag", 1, "Missile")
    goto Spawn+3
   ClassPain:
    GREM H 0
    goto MegamanPain
   ClassDeath:
    GREM H 0
    goto MegamanDeath
  }
}

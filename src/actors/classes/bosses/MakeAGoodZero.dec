actor MakeAGoodZero : BossBase {
  Player.ScoreIcon "UB306MUG"
  Player.SoundClass "MakeAGoodZero"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.MaxHealth 2150
  Health 2150
  Player.JumpZ 12
  Player.MorphWeapon "MakeAGoodZero_W"
  States {
   Spawn:
    8D06 A 0
    8D06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    8D06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    goto Spawn+2
   See:
    8D06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    goto Spawn
   Missile:
    8D06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    goto Spawn+2
   ZeroSoul:
    8D06 J 20
    goto Spawn
   ClassPain:
    8D06 H 0
    // 8D06 H 0 A_PlaySoundEx("TDN/OhShit",0)
    // 8D06 HHHHHHHHHH 2 A_SpawnItemEx("UH_PainFX",-5,0,3,0,0,0)
    // 8D06 H 1
    // 8D06 H 0 A_Jump(256, "Spawn")
    // 8D06 H 1 A_Jump(256, "Spawn")
    // Goto Spawn
    goto MegamanPain
   ClassDeath:
    8D06 H 0
    goto MegamanDeath
  }
}

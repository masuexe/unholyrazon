actor MakeAGoodZero : BossBase {
  player.soundclass "BOSS306"
  player.forwardmove 1.2, 1.2
  player.sidemove 1.2, 1.2
  Player.MaxHealth 2150
  Health 2150
  player.jumpz 12
  player.morphweapon "MakeAGoodZero_W"
  States {
   Spawn:
    8K06 A 0
    8K06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    8K06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    Goto Spawn+2
   See:
    8K06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    Goto Spawn
   Missile:
    8K06 A 1 A_JumpIfInventory("VivifyFlag1", 1, "ZeroSoul")
    goto Spawn+2
   ZeroSoul:
    8K06 J 20
    Goto Spawn
   ClassPain:
    8K06 H 0
    // 8K06 H 0 A_PlaySoundEx("TDN/OhShit",0)
    // 8K06 HHHHHHHHHH 2 A_SpawnItemEx("UH_PainFX",-5,0,3,0,0,0)
    // 8K06 H 1
    // 8K06 H 0 A_Jump(256, "Spawn")
    // 8K06 H 1 A_Jump(256, "Spawn")
    // Goto Spawn
    Goto MegamanPain
   ClassDeath:
    8K06 H 0
    Goto MegamanDeath
  }
}



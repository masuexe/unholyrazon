actor ShinNegaman : BossBase {
  Player.ScoreIcon "UB021MUG"
  Player.SoundClass "ShinNegaman"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 12
  Player.MaxHealth 3000
  Health 3000
  Player.MorphWeapon "ShinNegaman_W"
  States {
   Spawn:
    EMEG A 0
    EMEG B 1
    EMEG A 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn+2
   See:
    EMEG BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn
   Jumping:
    EMEG R 0 A_JumpIfInventory("SlideVivifyFlag", 1, "Missile_Slide")
    EMEG R 1 A_JumpIf(CallACS("core_checkfooting"), "Spawn")
    loop
   Missile:
    EMEG F 0 A_JumpIfInventory("SlideVivifyFlag", 1, "Missile_Slide")
    EMEG F 5
    EMEG G 4
    goto Spawn+2
   Missile_Slide:
    EMEG I 22
    goto Spawn+2
   ClassPain:
    EMEG H 0
    goto MegamanPain
   ClassDeath:
    EMEG H 0
    goto MegamanDeath
  }
}

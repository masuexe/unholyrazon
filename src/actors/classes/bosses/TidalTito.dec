// IDEA: add a "Teto replaces Tito" mod lol

Actor TidalTito : BossBase
{
player.scoreIcon "UB053MUG"
player.soundclass "TidalMaster"
player.forwardmove 1.05, 1.05
player.sidemove 1.1, 1.1
Player.Maxhealth 3365
health 3365
player.jumpz 14
player.morphweapon "TidalTito_W"
States
{
Spawn:
WAVM A 0
WAVM B 1
WAVM A 1 //A_JumpIfInventory("CutterFlag",1,"Rage")
Goto Spawn+2
See:
WAVM A 0 A_JumpIfInventory("TidalTitoPropertyRage",1,"Rage")
WAVM A 2 A_GiveInventory("WakeWavePickup")
Goto Spawn+2
Missile:
WAVM FFGG 2 A_GiveInventory("WakeWavePickup")
goto Spawn+2
Rage:
WAVM FG 4
WAVM AA 2 A_GiveInventory("WakeWavePickup")
WAVM A 0 A_GiveInventory("TidalTitoRageFX_P")
WAVM A 0 A_JumpIfInventory("TidalTitoPropertyRage",1,"RageLoop")
goto Spawn+2
RageLoop:
WAVM G 0
goto Rage+2
ClassPain:
WAVM H 0
Goto MegamanPain
ClassDeath:
WAVM H 0
Goto MegamanDeath
}
}

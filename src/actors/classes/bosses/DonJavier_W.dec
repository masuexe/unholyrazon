actor DonJavier_W_ScriptBar : ScriptBar {}

actor DonJavier_W : BaseUnholyBossWep {
  Tag "$TAG_DonJavier_W"
  Obituary "%o was defeated by \cmDon \ckJavier \c-(%k)."
  Inventory.Pickupmessage "\ckPride."
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyPower1500"
  States {
   Spawn:
    8H02 [ 1
    wait

   Ready:
    8H02 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    8H02 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, DONJAVIER_DYE)
    8H02 A 0 A_GiveInventory("WallJumpLimit", 1)
    goto ReadyX

   ReadyX:
    8H02 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 2)
    8H02 A 0 A_WeaponReady
    goto ReadyXGive
    8H02 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
   ReadyXGive:
    8H02 A 2 A_GiveInventory("UnholyBossAmmo200", 3)
    goto ReadyX

   Fire:
    8H02 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "PseudoBloodyHighClaw")
    8H02 A 0 A_Recoil(-40)
    8H02 A 0 ThrustThingZ(0, 5, 0, 0)
    8H02 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H02 A 0 A_FireCustomMissile("ZenDelaSlashAttack", 0, 1, 8, 0)
    8H02 A 0 A_FireCustomMissile("ZenDelaSlashAttack", 15, 0, 8, 6)
    8H02 A 0 A_FireCustomMissile("ZenDelaSlashAttack", -15, 0, 8, 6)

    8H02 B 2 Offset(-1, 33)
    8H02 B 2 Offset(-70, 74) A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 B 2 Offset(-121, 114) A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 C 2 Offset(-146, 201) A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 C 2 Offset(-171, 225) A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 C 2 Offset(-179, 253) A_GiveInventory("UnholyBossAmmo200", 1)
    TNT1 AAAAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 A 2 Offset(-7, 69) A_GiveInventory("UnholyBossAmmo200", 1)
    8H02 A 2 Offset(-3, 48) A_GiveInventory("UnholyBossAmmo200", 1)


    goto ReadyX
   DireHellClawSlash:  // Legacy
    8H02 A 0 A_TakeInventory("UnholyPower1500")
    8H02 A 0 A_Stop
    8H02 A 0 A_FaceTarget
    8H02 A 0 A_Recoil(-25)
    8H02 A 0 ThrustThingZ(0, 5, 0, 0)
    8H02 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H02 A 0 A_FireCustomMissile("DireZenDelaSlashAttack", 0, 1, 8, 0)
    8H02 A 0 A_FireCustomMissile("DireZenDelaSlashAttack", 15, 0, 8, 6)
    8H02 A 0 A_FireCustomMissile("DireZenDelaSlashAttack", -15, 0, 8, 6)
    8H02 B 2 Offset(-1, 33)
    8H02 B 2 Offset(-70, 74)
    8H02 B 2 Offset(-121, 114)
    8H02 C 2 Offset(-146, 201)
    8H02 C 2 Offset(-171, 225)
    8H02 C 2 Offset(-179, 253)
    TNT1 A 42
    8H02 A 2 Offset(-7, 69)
    8H02 A 2 Offset(-3, 48)
    goto ReadyX
   Flash:
    TNT1 AAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
    stop
   AltFire:
    8H02 A 0 A_GunFlash
    8H02 BB 1 Offset(-1, 33) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", FBF_NOFLASH, 64)
    8H02 BB 1 Offset(-70, 74) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 BB 1 Offset(-121, 114) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 CC 1 Offset(-146, 201) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 CC 1 Offset(-171, 225) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 CC 1 Offset(-179, 253) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    TNT1 AA 1 A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 AA 1 Offset(-7, 69) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    8H02 AA 1 Offset(-3, 48) A_FireBullets(0, 0, 0, 0, "ClimbCheckingThing", 0, 64)
    goto ReadyX
   Reload:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "ThrowingKnivesLikeABaus")
    goto ReadyX
   ThrowingKnivesLikeABaus:
    8H02 A 0 A_TakeInventory("UnholyBossAmmo200")
    8H02 A 0 A_PlaySoundEx("wep_L/ThLunaNightKnifeToss", "Weapon")  // weapon/slashclaw
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 0, 1, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 8, 0, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 4, 0, 8, 0)
    8H02 B 2 Offset(-1, 33)
    8H02 B 2 Offset(-70, 74)
    8H02 B 2 Offset(-121, 114)
    8H02 C 2 Offset(-146, 201)
    8H02 C 2 Offset(-171, 225)
    8H02 C 2 Offset(-179, 253)
    TNT1 A 2
    8H02 C 0 A_PlaySoundEx("wep_L/ThLunaNightKnifeToss", "Weapon")
    8H02 C 0 A_FireCustomMissile("JavierPocketKnives", 0, 1, 8, 0)
    8H02 C 0 A_FireCustomMissile("JavierPocketKnives", -8, 0, 8, 0)
    8H02 C 0 A_FireCustomMissile("JavierPocketKnives", -4, 0, 8, 0)
    8H02 C 2 Offset(-179, 253)
    8H02 C 2 Offset(-171, 225)
    8H02 C 2 Offset(-146, 201)
    8H02 B 2 Offset(-121, 114)
    8H02 B 2 Offset(-70, 74)
    8H02 B 2 Offset(-1, 33)
    TNT1 A 2
    8H02 B 0 A_PlaySoundEx("wep_L/ThLunaNightKnifeToss", "Weapon")
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 0, 1, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", -8, 0, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", -4, 0, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 8, 0, 8, 0)
    8H02 B 0 A_FireCustomMissile("JavierPocketKnives", 4, 0, 8, 0)
    8H02 B 2 Offset(-1, 33)
    8H02 B 2 Offset(-70, 74)
    8H02 B 2 Offset(-121, 114)
    8H02 C 2 Offset(-146, 201)
    8H02 C 2 Offset(-171, 225)
    8H02 C 2 Offset(-179, 253)
    goto ReadyX
    /*PseudoBloodyHighClaw:
    8H02 B 2 A_JumpIfCloser(256, "DireHellClawSlash")
    //8H02 B 0 A_SpawnItemEx("RosePetalEffect",0,0,0)
    8H02 B 0 A_Recoil(-15)
    8H02 B 0 A_TakeInventory("UnholyPower1500",25)
    8H02 B 0 A_JumpIfInventory("UnholyPower1500",1,"PseudoBloodyHighClaw")
    8H02 A 2 Offset(-7,69)
    8H02 A 2 Offset(-3,48)
    8H02 A 2 A_WeaponReady(14)
    goto ReadyX*/
   PseudoBloodyHighClaw:
    8H02 B 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, DONJAVIER_DYE2, true)
    8H02 B 0 A_PlaySoundEx("classes/skullabs", "Weapon")
    8H02 B 0 A_GiveInventory("UnholyPowerDazzle_F")
    8H02 B 2 A_TakeInventory("UnholyPower1500", 10)
    8H02 B 0  // ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    8H02 B 0  // A_PlaySound("misc/hsloop",1,2.0,1)
   RISINGCLAW:
    8H02 B 0 A_Recoil(-10)
    8H02 B 2 A_SpawnItemEx("HaxingHitboxOfJav", 0, 0, -44, velx, vely, velz, 0, 8, 0)
    8H02 B 0 A_TakeInventory("UnholyPower1500", 40)
    8H02 B 0 A_JumpIfInventory("UnholyPower1500", 1, "RISINGCLAW")
    goto TIMETOSTOP
   TIMETOSTOP:
    8H02 B 0  // A_PlaySoundEx("misc/BlankSound","Weapon",0)
    8H02 B 0  // ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    8H02 B 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, DONJAVIER_DYE, true)
    TNT1 A 2 A_TakeInventory("UnholyPower1500")
    8H02 A 2 Offset(-7, 69) A_TakeInventory("UnholyPowerDazzle_F")
    8H02 A 2 Offset(-3, 48)
    goto ReadyX
  }
}

actor JavierFlag1 : Once {}

actor HaxingHitboxOfJav : BasicProjectile {
  Obituary "%o was \cgBrutally\c- defeated by \cmDon \ckJavier \c-(%k)"
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  DamageType "DonJavierRage"
  Radius 72
  Height 168
  Scale 5.5
  Damage (9999)
  States {
   Spawn:
    TNT1 AAA 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor DonJavierRageHitFX : BasicExplosion {
  Translation "192:192=176:176", "198:198=184:184"
  Scale 4.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "SoundSlot5")
    6P03 ABCDEFG 2
    stop
  }
}

actor ClimbCheckingThing : BulletPuff {
  +PUFFGETSOWNER
  States {
   Spawn:
    TNT1 A 1
    stop
   Crash:
    TNT1 A 1
    TNT1 A 0 A_GiveToTarget("ClimbItDamnit", 1)
    stop
  }
}

actor ClimbItDamnit : CustomInventory {
  States {
   Pickup:
    TNT1 A 0  // A_Stop
    TNT1 A 0 ThrustThingZ(0, 35, 0, 0)
    stop
  }
}

actor JavierPocketKnives : BasicProjectile {
  Translation "192:192=218:218", "198:198=5:5"
  DamageType "DonJavier"
  Obituary "%o caught a knife from \cmDon \ckJavier \c-(%k)"
  +THRUGHOST
  Damage (185)
  Radius 9
  Height 9
  Speed 75
  Scale 2.5
  States {
   Spawn:
    X_3A A 1
    loop
  }
}

actor ZenDelaSlashAttack : BasicProjectile {
  Translation "192:192=218:218", "198:198=5:5"
  DamageType "DonJavier"
  Obituary "%o was defeated by \cmDon \ckJavier \c-(%k)."
  +RIPPER
  +DONTBLAST
  +THRUGHOST
  Damage (250)
  Radius 5
  Height 5
  Speed 45
  Scale 2.5
  States {
   Spawn:
    X_7F A 0
    X_7F ABCDE 1 A_Explode(150, 90, 0)
    stop
  }
}

actor DireZenDelaSlashAttack : ZenDelaSlashAttack {
  Translation "192:192=189:189", "198:198=5:5"
  Obituary "%o was \cgBrutally\c- defeated by \cmDon \ckJavier \c-(%k)"
  Damage (650)
  Speed 55
  States {
   Spawn:
    X_7F A 0
    X_7F ABCDE 1 A_Explode(350, 90, 0)
    stop
  }
}

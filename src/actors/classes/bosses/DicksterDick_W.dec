    stop
  }
}


actor CollisionDamage0 : BasicExplosion {
  Damagetype "Dickster"
  Obituary "\cmDickster \cdDick\c- (%k) stole %o's wallet."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(250, 64, 0, 0, 8)
    stop
  }
}

actor CollisionDamage1  : CollisionDamage0 {Obituary "%o was flabbergasted by \cmDickster \cdDick\c- (%k)!"}
actor CollisionDamage2  : CollisionDamage0 {Obituary "%o was caught by \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage3  : CollisionDamage0 {Obituary "%o couldn't handle the true power of \cmDickster \cdDick\c- (%k)!"}
actor CollisionDamage4  : CollisionDamage0 {Obituary "%o got too close to \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage5  : CollisionDamage0 {Obituary "%o was tackled by \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage6  : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) sucker punched %o."}
actor CollisionDamage7  : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) gave %o a hug."}
actor CollisionDamage8  : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) ran over %o."}
actor CollisionDamage9  : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) thought %o was a goomba."}
actor CollisionDamage10 : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) showed %o a magic trick."}
actor CollisionDamage11 : CollisionDamage0 {Obituary "%o failed to fend off \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage12 : CollisionDamage0 {Obituary "\cmDickster \cdDick\c- (%k) told %o a story about Rudy the Clown."}
actor CollisionDamage13 : CollisionDamage0 {Obituary "%o didn't see \cmDickster \cdDick\c- (%k) coming!"}
actor CollisionDamage14 : CollisionDamage0 {Obituary "%o couldn't escape from \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage15 : CollisionDamage0 {Obituary "%o was unable to dodge \cmDickster \cdDick\c- (%k)."}
actor CollisionDamage16 : CollisionDamage0 {Obituary "%o tried to ditch \cmDickster \cdDick\c- (%k) and failed."}

actor DicksterDickJumpFX : BasicGraphicEffect {
  Translation "202:202=102:102", "192:192=116:116", "198:198=122:122", "199:199=124:124"
  height 6
  radius 6
  Scale 3.0
  States {
   SpawnFrame:
    8P13 BCBCBCACACAC 2
    stop
  }
}

actor DicksterDickJump_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_ChangeVelocity(momx, momy, 21, CVF_REPLACE)
    TNT1 A 0 A_GiveInventory("JumpCancler")
    stop
  }
}

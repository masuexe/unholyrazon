actor DicksterDick_W_NormalBar : NormalBar {args 116, 122}

actor DicksterDick_W : BaseUnholyBossWep {
  Tag "$TAG_Boss013_W"
  Weapon.AmmoUse 200
  Weapon.AmmoGive 200
  Obituary "\cmDickster \cdDick\c- (%k) stole %o's wallet."
  Inventory.Pickupmessage "\cgHAWT DAMN! Buttsecks!"
  weapon.ammotype "UnholyPower1000"
  States {
   Spawn:
    8H13 [ 1
    wait

   Deselect:
    8H13 A 0
    goto DeselectSwap
   Select:
    8H13 A 0
    goto SelectSwap

   Ready:
    8H13 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8H13 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
    8H13 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, DICKSTERDICK_DYE)
    8H13 A 0  // A_GiveInventory("CosmeticBossSpeedTrail")
    8H13 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H13 A 0 A_JumpIfInventory("UnholyPower1000", 250, "ReadyX2")
    8H13 A 2 A_WeaponReady(12)
    8H13 A 0 A_GiveInventory("UnholyPower1000", 5)
    goto ReadyX
   ReadyX2:
    8H13 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX3")
    8H13 A 2 A_WeaponReady(4)
    8H13 A 0 A_GiveInventory("UnholyPower1000", 5)
    loop
   ReadyX3:
    8H13 A 2 A_WeaponReady
    8H13 A 0 A_GiveInventory("UnholyPower1000", 5)
    loop

   Flash:
    TNT1 A 0 A_JumpIf(velx*velx + vely*vely + velz*velz <= 1368, 2)
    TNT1 A 0 A_GiveInventory("DisksterDickHalfInvis")
    TNT1 A 2 A_GiveInventory("DicksterRandomCollisionItem")
    goto Flash
   Fire:
    8H13 A 0 A_PlaySoundEx("S_Spin/DANGER", "Weapon")  // "S_Spin/Surprise"  // "gauntlet/SILYITEM"
    8H13 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8H13 A 0 ACS_NamedExecuteWithResult("core_chargecolor", GENERICHELLCOLOR)
    8H13 BBCCDDCCCDDDCCCDDDCCCDDDCCCDDDCCCDDDCCB 1 A_TakeInventory("UnholyPower1000", 25)
    8H13 A 0 A_TakeInventory("UnholyPower1000", 1000)
    8H13 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8H13 B 1 ACS_NamedExecuteWithResult("core_chargecolor", DICKSTERDICK_DYE)
    Goto ReadyX
   AltFire:
    8H13 A 0 A_JumpIfInventory("UnholyPower1000", 250, "AltDickJump")
    goto ReadyX
   AltDickJump:
    8H13 A 1 Offset(0, 37)
    8H13 A 1 Offset(0, 43)
    8H13 A 1 Offset(0, 47)
    8H13 A 1 Offset(0, 53)
    8H13 A 1 Offset(0, 57)
    8H13 A 1 Offset(0, 63)
    8H13 A 1 Offset(0, 67)
    8H13 A 0 A_SpawnItemEx("DicksterDickJumpFX")
    8H13 A 0 A_PlaySoundEx("S_2/Spring", "Weapon")
    8H13 A 0 A_GiveInventory("DicksterDickJump_P")
    8H13 A 0 A_TakeInventory("UnholyPower1000", 250)
    8H13 A 1 Offset(0, 67)
    8H13 A 1 Offset(0, 63)
    8H13 A 1 Offset(0, 57)
    8H13 A 1 Offset(0, 53)
    8H13 A 1 Offset(0, 47)
    8H13 A 1 Offset(0, 43)
    8H13 A 1 Offset(0, 37)
    Goto ReadyX
  }
}

actor DisksterDickHalfInvis : PowerInvisibility {
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration 3
  Powerup.Strength 25
  Powerup.Mode "Translucent"
}

actor DicksterRandomCollisionItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13", "D14", "D15", "D16")
    TNT1 A 0
    goto D0
   D0:
    TNT1 A 0 A_SpawnItemEx("CollisionDamage0", 0, 0, 32, momx, momy, momz, 0, 8, 0)
    stop
   D1:
    TNT1 A 0 A_SpawnItemEx("CollisionDamage1", 0, 0, 32, momx, momy, momz, 0, 8, 0)

// Rage states by Moca
// TODO: fix Peashooter firing

actor BlueElephant_W_NormalBar : NormalBar {Args 200, 205}
actor BlueElephant_W_SecondBar : SecondBar {Args 201, 204}
actor BlueElephant_W : BaseUnholyBossWep {
  Tag "$TAG_BlueElephant_W"
  Obituary "%o is just a piece of paper against \cvBlue Elephant\c- (%k)."
  Inventory.Pickupmessage "C! C! B!"
  Weapon.AmmoType "UnholyBossAmmo300"
  Weapon.AmmoType2 "UnholyPower3000"
  States {
   Spawn:
    TNT1 [ 1
    wait

   Deselect:
    TNT1 A 0
    goto DeselectSwap
   Select:
    TNT1 A 0
    goto SelectSwap

   Ready:
    TNT1 A 0 A_GiveInventory("UnholyPowerLimit_F", 3000)
    TNT1 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, BLUEELEPHANT_DYE)
    TNT1 A 0 A_GiveInventory("UnholyPower3000", 0, 1)
    TNT1 A 1 A_GunFlash
    goto ReadyX
   ReadyX:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300 - 150 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyX2")
    TNT1 A 2 A_WeaponReady(8)
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)
    TNT1 A 0 A_GiveInventory("UnholyPower3000", 3000, 1)
    loop
   ReadyX2:
    TNT1 A 2 A_WeaponReady
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo300", 2)
    loop

   Fire:
    TNT1 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "SkyDropRage")
    TNT1 A 0 A_SpawnItemEx("ThwompDustFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/CCBJump", "Body")
    TNT1 A 0 A_ChangeVelocity(0, 0, 30, 1)
    TNT1 A 0  // A_ChangeVelocity(0,0,15*-sin(pitch))
    TNT1 A 1  // A_ChangeVelocity(50*cos(pitch)+4,0,30*-sin(pitch),3)
   Check:
    TNT1 A 0 A_CheckFloor("CCB")
    TNT1 A 0  // A_Recoil(-2)
    TNT1 A 0 ThrustThingZ(0, 2, 1, 1)
    TNT1 A 1 A_WeaponReady(14)
    goto Check
   CCB:
    TNT1 A 0 A_SpawnItemEx("CCBShockWave")
    TNT1 A 0 A_PlaySoundEx("misc/hugequake", "Body")
    TNT1 A 0 A_Quake(9, 15, 0, 512)
    TNT1 AAAAA 1 A_Stop
    TNT1 A 15
    goto ReadyX

   SkyDropRage:
    TNT1 A 0 A_TakeInventory("UnholyPower3000", 3000)
    TNT1 A 0 A_PlaySoundEx("weapon/CCBJump", "Body")
    TNT1 A 0 A_PlaySound("taunt/DB_616", 6, 2.0, 0, ATTN_NONE)
    // TNT1 A 0 A_GiveInventory("SkyDropActive",1)
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
    // TNT1 A 0 A_ChangeVelocity(0,0,80,1)
    TNT1 A 0 ThrustThingZ(0, 300, 0, 0)
    TNT1 A 0 A_SetTranslucent(0.0, 0)
    TNT1 ACCCCCCCCCCC 10 ThrustThingZ(0, 100, 0, 0)
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_DISABLESWITCH)
    TNT1 A 15

   SkyDropFall:
    // TNT1 A 0 A_ChangeVelocity(0,0,-120,1)
    // TNT1 A 1 A_CheckFloor("SkyDropImpact")
    TNT1 A 0 A_SetTranslucent(1.0, 0)
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 0)
    TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0)
    TNT1 A 0 ThrustThingZ(0, 175, 1, 0)
    TNT1 A 1 A_CheckFloor("SkyDropImpact")
    loop

   SkyDropImpact:
    // TNT1 A 0 A_TakeInventory("SkyDropActive",1)
    TNT1 A 0 A_SpawnItemEx("CCBMegaShockWave")
    TNT1 A 0 A_PlaySound("misc/hugequake", 6, 2.0, 0, ATTN_NONE)
    // TNT1 A 0 A_PlaySoundEx("misc/hugequake","Body")
    TNT1 A 0 A_Quake(15, 105, 0, 2048)
    // TNT1 A 0 A_CustomMissile("SkyDropDamageField", 0, 0, 0, CMF_AIMDIRECTION)
    TNT1 A 30
    goto ReadyX

   AltFire:
    TNT1 A 0 A_JumpIfInventory("UnholyPower3000", 3000, "PeashooterSeedRage")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo300", 300 - 150 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
    goto ReadyX
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo300", 150, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo300", 150)
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", 0, 0, 0, 0)
    TNT1 A 10
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_DISABLESWITCH)
    goto ReadyX

   PeashooterSeedRage:
    TNT1 A 0 A_TakeInventory("UnholyPower3000", 3000)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo300", 150, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo300", 150)
    TNT1 A 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
    TNT1 A 37
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-2, 2), 0, 8, 0, 0, frandom(-2, 2))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-2, 2), 0, 8, 0, 0, frandom(-24, 24))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-10, 10), 0, 8, 0, 0, frandom(-10, 10))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-20, 20), 0, 8, 0, 0, frandom(-64, 64))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-3, 3), 0, 16, 0, 0, frandom(-3, 3))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-4, 4), 0, 8, 0, 0, frandom(-10, 10))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-35, 35), 0, 10, 0, 0, frandom(-15, 15))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-15, 15), 0, 4, 0, 0, frandom(-128, 128))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-5, 5), 0, 16, 0, 0, frandom(-25, 25))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-15, 15), 0, 8, 0, 0, frandom(-18, 18))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-10, 10), 0, 8, 0, 0, frandom(-3, 3))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-20, 20), 0, 10, 0, 0, frandom(-48, 48))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-50, 50), 0, 16, 0, 0, frandom(-32, 32))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-4, 4), 0, 4, 0, 0, frandom(-4, 4))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-8, 8), 0, 8, 0, 0, frandom(-32, 32))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-15, 15), 0, 4, 0, 0, frandom(-15, 15))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-10, 10), 0, 8, 0, 0, frandom(-64, 64))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-35, 35), 0, 4, 0, 0, frandom(-15, 15))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-15, 15), 0, 8, 0, 0, frandom(-48, 48))
    TNT1 A 2
    TNT1 A 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    TNT1 A 0 A_FireCustomMissile("PeashooterSeed", frandom(-5, 5), 0, 4, 0, 0, frandom(-5, 5))
    TNT1 A 10
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_DISABLESWITCH)
    goto ReadyX

   Flash:
    TNT1 A 7 A_SpawnItemEx("CCBCollisionItem")
    loop
  }
}
actor CCBCollisionItem : BasicExplosion {
  DamageType "CCBStomp"
  Obituary "%o didn't like \cvBlue Elephant\c- (%k) stepping on their back."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(random(85, 125), 64, 0, 0, 8)
    stop
  }
}

actor CCBShockwavePart : BasicProjectile {
  Translation "192:192=197:197", "199:199=75:75"
  Obituary "%o, I'm here to step on your back!"
  DamageType "CCBStomp"
  +FLOORHUGGER
  Damage (200)
  Radius 32
  Height 32
  Speed 30
  Scale 3.0
  States {
   Spawn:
    6P36 A 1 A_FadeOut(0.05)
    loop
  }
}
actor CCBShockwavePartR : BasicProjectile {
  Translation "192:192=197:197", "199:199=75:75"
  Obituary "%o, I'm here to step on your back!"
  DamageType "CCBStomp"
  +FLOORHUGGER
  +RIPPER
  +DONTBLAST
  Damage (100)
  Radius 64
  Height 32
  Speed 10
  Scale 3.0
  States {
   Spawn:
    6P36 A 1 A_FadeOut(0.05)
    loop
  }
}
actor PeashooterSeed : BasicProjectile {
  Projectile
  -NOGRAVITY
  +RIPPER
  // +DONTBLAST
  Gravity 2.25
  Speed 45
  Radius 16
  Height 16
  Scale 2.5
  States {
   Spawn:
    AQAQ KLM 1 A_SpawnItemEx("PeashooterSeedFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    AQAQ N 0 A_SpawnItemEx("Peashooter", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION | SXF_SETMASTER)
    AQAQ NOP 1
    stop
  }
}
actor PeashooterSeedFX : BasicGraphicEffect {
  RenderStyle "Translucent"
  Alpha 0.7
  Scale 2.5
  States {
   Spawn:
    AQAQ KLM 1 A_FadeOut(0.05)
    loop
  }
}
actor Peashooter : UH_ShootableActor {
  +MISSILE
  -ISMONSTER
  -COUNTKILL
  +SHOOTABLE
  +NOBLOOD
  -SOLID
  +DONTCORPSE
  +SEEKERMISSILE
  +THRUSPECIES
  Species "Peashooter"
  Scale 1.5
  Radius 32
  Height 32
  Health 750
  Gravity 1
  PainChance 256
  Speed 0
  Damage (0)
  States {
   Spawn:
    PEAS A 0
    PEAS A 10
    PEAS A 0 A_SeekerMissile(90, 90, SMF_LOOK | SMF_PRECISE | SMF_CURSPEED, 256, 3)
    PEAS A 1 A_FaceTracer(0, 0)
    PEAS A 0 A_PlaySoundEx("weapon/DLCPFire", "Weapon")
    PEAS A 0 A_CustomMissile("Peashot", 27, 0, frandom(-5, 5), CMF_AIMDIRECTION, -pitch + random(-5, 5))
    // PEAS A 0 A_SpawnItemEx("Peashot",0,0,27,cos(pitch)*40,0,sin(-pitch)*40,0,1)
    PEAS A 5
    loop

   Death:
    PEAS A 0
    stop
  }
}
actor Peashot : BasicProjectile {
  Translation "4:4=215:215", "198:198=218:218"
  Species "Peashooter"
  +THRUSPECIES
  DamageType "Wandou99"
  Obituary "%o got shelled in the Garden of Warfare."
  Damage (random(123, 228))
  Speed 60
  Radius 6
  Height 6
  Scale 2.5
  States {
   Spawn:
    X_0D A 1
    loop
   Death:
    X_0D A 1
    stop
  }
}

// Just have no idea about the following actors
actor NotCutoutedMelon : BasicProjectile {
  DamageType "CCBMelon"
  -NOGRAVITY
  -RIPPER
  +THRUGHOST
  +SKYEXPLODE
  Bouncetype Classic
  +BOUNCEONWALLS
  -BOUNCEONFLOORS
  -BOUNCEONCEILINGS
  -ALLOWBOUNCEONACTORS
  +DONTSPLASH
  +STEPMISSILE
  Gravity 1.5
  Speed 45
  Radius 32
  Height 32
  Scale 0.5
  States {
   Spawn:
    MELN A 1
    loop
   Death:
    MELN A 1 A_SpawnItemEx("NotCutoutedMelon2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor NotCutoutedMelon2 : NotCutoutedMelon {
  +DONTBLAST
  -BOUNCEONWALLS
  +NOEXPLODEFLOOR
  States {
   Spawn:
    MELN A 1
    loop
   Death:
    MELN A 1
    stop
  }
}
actor CCBYourMates : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_SetArg(3, ACS_ExecuteWithResult(257, 0))
    TNT1 A 0 A_SetArg(4, CallACS("uh_HPHM_WarpChecker"))
    TNT1 A 0 A_JumpIf(args[3] == args[4], "SpawnError")
    TNT1 A 0 A_ChangeVelocity(0, 0, 30, 0)
    TNT1 A 0 ThrustThingZ(0, 2, 1, 1)
    TNT1 A 1
    goto BorderCheck
   BorderCheck:
    TNT1 A 0 A_CheckCeiling("Warp")
    TNT1 A 0 A_CheckFloor("RealCCB")
    TNT1 A 1
    loop
   Warp:
    TNT1 A 0 Thing_Move(args[3], args[4], 1)
    TNT1 A 0 A_Warp(2, 0, 0, 128, 0, 24)
    TNT1 A 1
    goto BorderCheck
   RealCCB:
    TNT1 A 0 A_SpawnItemEx("ThwompShockWave")
    TNT1 A 0 A_PlaySoundEx("misc/hugequake", "Weapon")
    goto End
   SpawnError:
    TNT1 A 4 A_PlaySound("M_64/Invalid", 1)
    TNT1 A 0 A_Explode(1000, 100, 0, 0)
    goto End
   End:
    TNT1 A 1
    stop
  }
}

actor BalladeGB : BossBase {
  player.soundclass "BalladeGB"
  player.damagescreencolor "black"
  player.forwardmove 1.2, 1.2
  player.sidemove 1.1, 1.1
  player.jumpz 18
  Player.MaxHealth 2
  Health 2
  player.morphweapon "BalladeGB_W"
  States {
   Spawn:
    8A83 A 0
    8A83 B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    8A83 A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    Goto Spawn+2
   See:
    8A83 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    Goto Spawn
   Missile:
    8A83 F 0 A_JumpIfInventory("VivifyDelay8", 1, "Air")
    8A83 F 5
    8A83 G 4
    goto Spawn+2
   Air:
    8A83 Y 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    wait
   ClassPain:
    8A83 H 0
    Goto MegamanPain
   ClassDeath:
    8A83 H 0
    Goto MegamanDeath
  }
}



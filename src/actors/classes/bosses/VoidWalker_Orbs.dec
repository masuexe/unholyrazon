    stop
  }
}

// Electroshock: Damaging ball of electricity surrounding the target
actor VWElectroshockBallWatcher {
  +NOBLOCKMAP
  +NOGRAVITY
  +DONTBLAST
  DamageType "Electroshock"
  RenderStyle "None"
  States {
   Spawn:
    TNT1 A 0 nodelay
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_SpawnItemEx("VWElectroshockBallFX", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
   BallLoop:
    // Tick 1 (10 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 AAAAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(15, 64, 0, 0, 64)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    // Tick 2 (10 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 AAAAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(15, 64, 0, 0, 64)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    // Tick 3 (10 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 AAAAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(15, 64, 0, 0, 64)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    // Tick 4 (10 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 AAAAAAAA 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(15, 64, 0, 0, 64)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    stop
  }
}


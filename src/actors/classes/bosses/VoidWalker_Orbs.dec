actor VWElectroshockStrike : BasicExplosion {
  +THRUACTORS
  +DONTBLAST
  +BRIGHT
  DamageType "Electroshock"
  Obituary "%o was electrocuted by %k's \cdElectroshock\c-."
  Scale 2.4
  States {
   Spawn:
    TNT1 A 0 nodelay
    TNT1 A 0 A_PlaySound("MarioRPG/BowserLightning", 1)
    TNT1 A 0 A_Explode(70, 112, 0, 0, 56)
    TNT1 A 0 A_SpawnItemEx("VWElectroshockColumn", 0, 0, 32, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "NoCage")
    TNT1 A 0 A_SpawnItemEx("VWElectroshockBallWatcher", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
   NoCage:
    LIBO GHIJK 2
    stop
  }
}

actor VWElectroshockColumn : BasicGraphicEffect {
  +FORCEYBILLBOARD
  +BRIGHT
  Scale 2.4

  Player.SoundClass "Megaman"
  Player.ScoreIcon "MUSHMUG"
  Player.ForwardMove 0.65, 0.65
  Player.SideMove 0.65, 0.65
  Player.JumpZ 7
  Player.MorphWeapon "PetalMushroom_W"
  Player.ViewHeight 20
  Radius 16
  Height 28
  Scale 1.8
  States {
   Spawn:
    IR00 A -1
    stop
   See:
    IR00 A 1
    loop
   Missile:
    IR00 A 1
    loop
   ClassPain:
    IR00 A 0
    goto MegamanPain
   ClassDeath:
    IR00 A 0
    goto MegamanDeath
  }
}


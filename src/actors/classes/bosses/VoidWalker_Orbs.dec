// M2 Stage 2 (Charge): Light Beam (60 ammo)
// SMRPG: a large bubble floats forward and bursts. The burst traps every enemy
// survivor it catches in the shared Bubble status. NOINTERACTION keeps the
// bubble out of geometry collision, so the burst point is the travel endpoint,
// not an impact point. The flight is deliberately short: the burst is the
// attack, so a long flight would only move the damage away from the target.
// Four intact frames at two tics each and Speed 18 give a 144-unit flight.
actor VWLightBubble : VWProjectile {
  +NOINTERACTION
  +DONTBLAST
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  Damage (0)
  DamageType "LightBeam"
  Obituary "%o was sealed inside %k's \cdLight Beam\c-."
  Radius 20
  Height 40
  Speed 18
  Scale 3.0
  RenderStyle "Translucent"
  Alpha 0.75
  States {
   Spawn:
    TNT1 A 0
   Travel:
    UBBL ABCD 2
    goto Burst
   Burst:
    TNT1 A 0 nodelay A_PlaySound("MMBN6/BubbleRelease", 1)
    // The shooter stays on the target pointer, so the burst script can resolve
    // the boss and its morph generation.
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_VWLightBubbleBurst")
    UBBL LMN 4
    stop
   Death:
    goto Burst
  }
}

// M2 Stage 3 (Full Charge): Static E! (90 ammo)
// SMRPG: a blue discharge that covers the whole screen, hits every target,
// and cannot be blocked. The damage comes from uh_VWCast spell 9, which ignores
// sight; these two actors are its server-visible presentation.
actor VWStaticEDischarge : BasicExplosion {
  +BRIGHT
  +THRUACTORS
  +DONTBLAST
  DamageType "StaticE"
  Obituary "%o was vaporized by %k's \cdStatic E!\c-."
  RenderStyle "Add"
  Scale 1.0
  States {
   Spawn:
    TNT1 A 0 nodelay A_PlaySound("MarioRPG/StaticE", 1)
    SPAS ABCDEFGH 1 A_SetScale(scaleX + 1.2, scaleY + 1.2)
    stop
  }
}

actor VWStaticESparkFX : BasicGraphicEffect {
  // Server ACS spawns this at each victim, so peers need a replicated actor.
  -CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +DONTBLAST
  +BRIGHT
  RenderStyle "Add"
  Scale 1.8
  States {
   SpawnFrame:
    SPAS FG 2
    SPAS FG 2
    SPAS FG 2
    stop
  }
}

actor VWPetalBlastMissile : BasicMorphProjectile {
  MorphProjectile.PlayerClass "PetalMushroomPlayer"
  MorphProjectile.Duration 105
  MorphProjectile.MorphStyle MRF_UNDOBYDEATH | MRF_UNDOBYDEATHFORCED | MRF_NEWTIDBEHAVIOUR
  MorphProjectile.MorphFlash "PetalMorphFlash"
  MorphProjectile.UnMorphFlash "PetalUnMorphFlash"
  Species "Culex"
  +THRUSPECIES
  +BRIGHT
  Radius 8
  Height 8
  Speed 32
  Damage (45)
  DamageType "PetalBlast"
  Obituary "%o was turned into a mushroom by %k's \cdPetal Blast\c-."
  Scale 1.8
  States {
   Spawn:
    PLAN ABCD 2
    loop
   Death:
    TNT1 A 0 A_PlaySound("MarioRPG/Mushroom", 1)
    TNT1 A 0 A_SpawnItemEx("PetalMorphFlash")
    stop
  }
}

actor PetalMorphFlash : BasicGraphicEffect {
  +BRIGHT
  RenderStyle "Add"
  Scale 1.5
  States {
   SpawnFrame:
    TNT1 A 0 A_PlaySound("MarioRPG/Mushroom", 1)
    PLAN ABCD 2 A_FadeOut(0.2)
    stop
  }
}

actor PetalUnMorphFlash : BasicGraphicEffect {
  +BRIGHT
  RenderStyle "Add"
  Scale 1.5
  States {
   SpawnFrame:
    TMFX ABCDE 2 A_FadeOut(0.2)
    stop
  }
}

actor PetalMushroomPlayer : ClassBaseUH00 {
  Player.DisplayName "$TAG_PetalMushroomPlayer"
  Player.SoundClass "Megaman"
  Player.ScoreIcon "MUSHMUG"
  Player.ForwardMove 0.65, 0.65
  Player.SideMove 0.65, 0.65
  Player.JumpZ 7
  Player.MorphWeapon "PetalMushroom_W"
  Player.ViewHeight 20
  Radius 16
  Height 28
  Scale 1.8
  States {
   Spawn:
    IR00 A -1
    stop
   See:
    IR00 A 1
    loop
   Missile:
    IR00 A 1
    loop
   ClassPain:
    IR00 A 0
    goto MegamanPain
   ClassDeath:
    IR00 A 0
    goto MegamanDeath
  }
}

actor PetalMushroom_W : BaseMM8BDMWep_UH {
  Tag "$TAG_PetalMushroom_W"
  +WEAPON.CHEATNOTWEAPON
  +WEAPON.DONTBOB
  States {
   Deselect:
    TNT1 A 0
    goto DeselectSwap
   Select:
    TNT1 A 0
    goto SelectSwap
   Ready:
    TNT1 A 1 A_WeaponReady(WRF_NOSWITCH)
    loop
   Fire:
    TNT1 A 0 A_PlaySoundEx("MarioRPG/Mushroom", "Weapon")
    TNT1 A 8
    goto Ready
   AltFire:
    goto Fire
  }
}


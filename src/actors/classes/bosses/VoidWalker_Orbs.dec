actor VWOrbMaxHP : Inventory { Inventory.MaxAmount 99999 }
actor VWOrbHP0 : Ammo { Inventory.Amount 1 Inventory.MaxAmount 99999 +INVENTORY.IGNORESKILL }
actor VWOrbHP1 : Ammo { Inventory.Amount 1 Inventory.MaxAmount 99999 +INVENTORY.IGNORESKILL }
actor VWOrbHP2 : Ammo { Inventory.Amount 1 Inventory.MaxAmount 99999 +INVENTORY.IGNORESKILL }
actor VWOrbHP3 : Ammo { Inventory.Amount 1 Inventory.MaxAmount 99999 +INVENTORY.IGNORESKILL }

actor VoidWalkerPhase2_F : Once {}
actor VWPhase2TransitionFlag : Once {}

actor VWHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(2, "TriggerPhase2")
    stop
   TriggerPhase2:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoOp")
    TNT1 A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "NoOp")
    TNT1 A 0 A_JumpIfInventory("VWPhase2TransitionFlag", 1, "NoOp")
    TNT1 A 0 A_GiveInventory("VWPhase2TransitionFlag")
    stop
   NoOp:
    TNT1 A 0
    stop
  }
}

// One server-owned hitbox per visual orb. Health is independent of the Boss.
// The 16x16 orb sprite is centered on its origin and displayed at scale 2.
actor VWOrbHitbox : UH_ShootableActor {
  Health 4750 // Base HP; initialization applies the Boss population formula.
  Radius 16
  Height 32
  PainChance 0
  RenderStyle "None"
  Species "Culex"
  +USEDAMAGEEVENTSCRIPT
  +NOGRAVITY
  +NOBLOOD
  +NODAMAGETHRUST
  +DONTBLAST
  +NOTARGET
  -SOLID
  -COUNTKILL
  var int user_NoTranslation;
  var int user_vwIndex;
  var int user_vwGeneration;
  var int user_vwMaxHealth;
  var int user_vwRetired;
  var int user_vwLastSyncedHP;
  States {
   Spawn:
    TNT1 A 1
   Hidden:
    TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
   HiddenTick:
    TNT1 A 0 A_JumpIf(!CallACS("uh_VWOrbValid"), "Cleanup")
    TNT1 A 0 A_JumpIf(CallACS("uh_VWOrbVisible"), "Exposed")
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, -16, 0, WARPF_NOCHECKPOSITION | WARPF_COPYINTERPOLATION)
    goto HiddenTick
   Exposed:
    TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
   ExposedTick:
    TNT1 A 0 A_JumpIf(!CallACS("uh_VWOrbValid"), "Cleanup")
    TNT1 A 0 A_JumpIf(!CallACS("uh_VWOrbVisible"), "Hidden")
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, -16, 0, WARPF_NOCHECKPOSITION | WARPF_COPYINTERPOLATION)
    goto ExposedTick
   XDeath:
   Death:
    TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
    TNT1 A 0 A_SpawnItemEx("ExplosionEffect1", 0, 0, 16)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_VWOrbDestroyed")
    stop
   Cleanup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_VWOrbCleanup")
    stop
  }
}

// Shared species preserves the existing Terra Mine/projectile collision rules.
// Boss attacks pass through orb hitboxes but still collide with other targets.
actor VWProjectile : BasicProjectile {
  Species "Culex"
  +THRUSPECIES
}

// The positioning probe uses the same collision group with its fast tracer base.
actor VWTargetTracer : UH_TargetTracer {
  Species "Culex"
  +THRUSPECIES
}

actor VWTargetMarker : UH_TargetMarker {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("VWTargetTracer", 0, 0, 32, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
    goto Super::SetupAimPoint
  }
}

actor VWVoidShot : VWProjectile {
  Translation "192:192=202:202", "198:198=61:61"
  DamageType "VoidShot"
  Obituary "%o was struck by %k's Void Shot."
  Damage (60)
  Speed 36
  +BRIGHT
  States {
   Spawn:
    BUST A 1
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor VoidWalker_W5_ScriptBar : ScriptBar {}
actor VoidWalker_W5_SecondBar : SecondBar { args 228, 111 }

// Granted when all four elements are gone in Phase 1, or permanently in Phase 2.
actor VoidWalker_W5 : BaseUnholyBossWep {
  Tag "$TAG_VoidWalker_W5"
  Weapon.SlotNumber 5
  Weapon.AmmoUse 0
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyPower1000"
  Weapon.AmmoUse2 0
  Inventory.Icon "UB054MUG"
  States {
   Spawn:
    6N02 I 6
    loop
   Select:
    8H54 A 0
    goto SelectSwap
   Deselect:
    8H54 A 0 A_TakeInventory("WeaponCharge")
    goto DeselectSwap
   Flash:
    TNT1 A 0 A_GiveInventory("VWHealthCheck_P")
    TNT1 A 1
    loop
   Ready:
    8H54 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", VOIDWALKER_DYE)
    8H54 A 0 A_GunFlash
   ReadyTick:
    8H54 A 0 A_JumpIfInventory("VWPhase2TransitionFlag", 1, "Phase2Transition")
    8H54 A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Phase2Ready")
    8H54 A 1 A_WeaponReady
    loop
   Phase2Ready:
    8H54 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 2)
    8H54 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H54 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
    loop
   Phase2Transition:
    8H54 A 0 A_WeaponReady(WRF_NOSWITCH | WRF_NOFIRE)
    8H54 A 0 A_ChangeFlag("INVULNERABLE", 1)
    8H54 A 0 A_ChangeFlag("NOGRAVITY", 1)
    8H54 A 0 A_Stop
    8H54 A 0 A_SetTranslucent(0.0, 0)
    8H54 A 0 A_SpawnItemEx("FakeDeathFX")
    8H54 A 0 A_PlaySoundEx("MarioRPG/EnemyCrystal", "Body")
    TNT1 A 35
    8H54 A 0 A_SpawnItemEx("ExplosionEffect1", 0, 0, 16)
    8H54 A 0 A_SetTranslucent(1.0, 0)
    8H54 A 0 A_ChangeFlag("INVULNERABLE", 0)
    8H54 A 0 A_ChangeFlag("NOGRAVITY", 0)
    8H54 A 0 A_GiveInventory("VoidWalkerPhase2_F")
    8H54 A 0 A_GiveInventory("IsPissedFlag")
    8H54 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, ELP_NATIVE)
    8H54 A 0 ACS_NamedExecuteWithResult("uh_BossPhaseHealth", 4750, 385)
    8H54 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic", 0, 54, 0)
    8H54 A 0 ACS_NamedExecuteAlways("uh_VWOrbsPhase2Reset", 0)
    8H54 A 0 A_TakeInventory("VWPhase2TransitionFlag")
    8H54 A 0 A_TakeInventory("VivifyFlag1")
    goto ReadyTick
   Fire:
    8H54 A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Phase2Fire")
    8H54 I 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    8H54 I 0 A_FireCustomMissile("VWVoidShot", 0, 0, 0, 0)
    8H54 I 4
    8H54 A 10
    8H54 A 0 A_ReFire
    goto ReadyTick
   Phase2Fire:
    8H54 I 0 A_JumpIfInventory("VivifyFlag1", 1, "Phase2Ready")
    8H54 I 0 A_GiveInventory("VivifyFlag1")
    8H54 I 0 A_TakeInventory("WeaponCharge")
   Phase2FireHold:
    8H54 I 0 A_JumpIfInventory("VWPhase2TransitionFlag", 1, "Phase2Transition")
    8H54 I 0 A_JumpIfInventory("WeaponCharge", 35, "Phase2FireCharged")
    8H54 I 1 Offset(-3, 27) A_GiveInventory("WeaponCharge", 1 + CallACS("uh_checkrune", RUNE_RAGE))
    8H54 I 0 A_ReFire("Phase2FireHold")
    goto Phase2FireRelease
   Phase2FireCharged:
    8H54 I 1 Offset(-5, 24)
    8H54 I 0 A_ReFire("Phase2FireCharged")
    goto Phase2FireRelease
   Phase2FireRelease:
    8H54 I 0 A_JumpIfInventory("WeaponCharge", 35, "P2DarkStar")
    goto P2FlameStone

   P2FlameStone:
    8H54 I 0 ACS_NamedExecuteAlways("uh_AnnounceBossSkill", 0, 5436)
    8H54 I 0 A_PlaySoundEx("MarioRPG/M_FireBall", "Weapon")
    8H54 I 2 Offset(-4, 25)
    8H54 I 2 Offset(-6, 22) A_FireCustomMissile("VWFlameStone", 0, 0, 0, 0)
    8H54 I 8 Offset(-3, 28)
    8H54 I 0 A_TakeInventory("WeaponCharge")
    8H54 I 0 A_TakeInventory("VivifyFlag1")
    goto Phase2Ready

   P2DarkStar:
    8H54 I 0 ACS_NamedExecuteAlways("uh_AnnounceBossSkill", 0, 5408)
    8H54 I 0 A_PlaySoundEx("MarioRPG/DeathStar", "Weapon")
    8H54 I 2 Offset(-4, 25)
    8H54 I 2 Offset(-6, 22) A_FireCustomMissile("VWDarkStar", 0, 0, 0, 0)
    8H54 I 18 Offset(-3, 28)
    8H54 I 0 A_TakeInventory("WeaponCharge")
    8H54 I 0 A_TakeInventory("VivifyFlag1")
    goto Phase2Ready

   AltFire:
    8H54 A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "Phase2AltFire")
    8H54 A 1
    goto ReadyTick
   Phase2AltFire:
    8H54 I 0 A_JumpIfInventory("VivifyFlag1", 1, "Phase2Ready")
    8H54 I 0 A_JumpIfInventory("UnholyBossAmmo200", 30, "Phase2AltFireStart")
    goto Phase2Ready
   Phase2AltFireStart:
    8H54 I 0 A_GiveInventory("VivifyFlag1")
    8H54 I 0 A_TakeInventory("WeaponCharge")
   Phase2AltFireHold:
    8H54 I 0 A_JumpIfInventory("VWPhase2TransitionFlag", 1, "Phase2Transition")
    8H54 I 0 A_JumpIfInventory("WeaponCharge", 24, "Phase2AltFireCharged")
    8H54 I 1 Offset(-3, 27) A_GiveInventory("WeaponCharge", 1 + CallACS("uh_checkrune", RUNE_RAGE))
    8H54 I 0 A_ReFire("Phase2AltFireHold")
    goto Phase2AltFireRelease
   Phase2AltFireCharged:
    8H54 I 1 Offset(-5, 24)
    8H54 I 0 A_ReFire("Phase2AltFireCharged")
    goto Phase2AltFireRelease
   Phase2AltFireRelease:
    8H54 I 0 A_JumpIfInventory("WeaponCharge", 24, "P2MeteorBlastCheck")
    goto P2Shredder
   P2MeteorBlastCheck:
    8H54 I 0 A_JumpIfInventory("UnholyBossAmmo200", 60, "P2MeteorBlast")
    goto P2Shredder

   P2Shredder:
    8H54 I 0 A_SpawnItemEx("VWShredderWave", 0, 0, 24)
    8H54 I 0 A_TakeInventory("UnholyBossAmmo200", 30)
    8H54 I 0 ACS_NamedExecuteAlways("uh_AnnounceBossSkill", 0, 5406)
    8H54 I 0 A_PlaySoundEx("MarioRPG/Shredder", "Weapon")
    8H54 I 2 Offset(-4, 25)
    8H54 I 2 Offset(-6, 22) ACS_NamedExecuteAlways("uh_VWShredderCast", 0)
    8H54 I 12 Offset(-3, 28)
    8H54 I 0 A_TakeInventory("WeaponCharge")
    8H54 I 0 A_TakeInventory("VivifyFlag1")
    goto Phase2Ready

   P2MeteorBlast:
    8H54 I 0 A_TakeInventory("UnholyBossAmmo200", 60)
    8H54 I 0 ACS_NamedExecuteAlways("uh_AnnounceBossSkill", 0, 5437)
    8H54 I 0 A_PlaySoundEx("MarioRPG/Meteor", "Weapon")
    8H54 I 2 Offset(-4, 25)
    8H54 I 2 Offset(-6, 22) ACS_NamedExecuteAlways("uh_VWCast", 0, 8)
    8H54 I 20 Offset(-3, 28)
    8H54 I 0 A_TakeInventory("WeaponCharge")
    8H54 I 0 A_TakeInventory("VivifyFlag1")
    goto Phase2Ready

   Reload:
    8H54 A 0 A_JumpIfInventory("VoidWalkerPhase2_F", 1, "FinalClawCheck")
    goto ReadyTick
   FinalClawCheck:
    8H54 A 0 A_JumpIfInventory("VivifyFlag1", 1, "Phase2Ready")
    8H54 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "FinalClaw")
    goto Phase2Ready
   FinalClaw:
    8H54 I 0 A_TakeInventory("UnholyPower1000", 1000)
    8H54 I 0 A_GiveInventory("VivifyFlag1")
    8H54 I 0 ACS_NamedExecuteAlways("uh_AnnounceBossSkill", 0, 5407)
    8H54 I 0 A_PlaySoundEx("MarioRPG/DeathSickle", "Weapon")
    8H54 I 2 Offset(-2, 30)
    8H54 I 0 A_ChangeFlag("INVULNERABLE", 1)
    8H54 I 0 A_SetTranslucent(0.0)
    8H54 I 0 A_Stop
    8H54 I 0 A_FireCustomMissile("VWFinalClawSlash", 0, 0, 0, 0)
    8H54 I 0 A_ChangeVelocity(cos(pitch) * 85, 0, -sin(pitch) * 85, 3)
    8H54 I 8
    8H54 M 0 A_Stop
    8H54 M 0 A_SetTranslucent(1.0)
    8H54 M 0 A_ChangeFlag("INVULNERABLE", 0)
    8H54 M 4 Offset(-4, 22)
    8H54 I 14 Offset(-2, 28) A_TakeInventory("VivifyFlag1")
    goto Phase2Ready

  }
}

// ==========================================
// CULEX 3D CORE ATTACKS (Dark Star, Shredder, Final Claw)
// ==========================================

actor VWDarkStar : VWProjectile {
  +RIPPER
  +THRUGHOST
  +DONTBLAST
  +SKYEXPLODE
  +BRIGHT
  Radius 14
  Height 14
  Speed 30
  Damage (95)
  DamageType "DarkStar"
  Obituary "%o was consumed by %k's \cmDark Star\c-."
  RenderStyle "Translucent"
  Alpha 0.9
  Scale 2.5
  Translation "0:255=112:127"
  States {
   Spawn:
    STAR E 0
   SpawnLoop:
    STAR EFGH 2 A_SpawnItemEx("VWDarkStarTrail", random(-8, 8), random(-8, 8), random(-8, 8), 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_PlaySound("MarioRPG/DeathStar", 1)
    TNT1 A 0 A_Explode(120, 160, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("VWDarkStarExplosion")
    stop
  }
}

actor VWDarkStarTrail : BasicGraphicEffect {
  +BRIGHT
  RenderStyle "Add"
  Scale 1.8
  Translation "0:255=112:127"
  States {
   SpawnFrame:
    TMFX ABCDE 2 A_FadeOut(0.15)
    stop
  }
}

actor VWDarkStarExplosion : BasicExplosion {
  +BRIGHT
  RenderStyle "Add"
  Scale 2.5
  Translation "0:255=112:127"
  States {
   Spawn:
    6Q28 ABCDEF 2
    stop
  }
}

actor VWShredderWave : BasicGraphicEffect {
  +BRIGHT
  RenderStyle "Add"
  Scale 1.0
  Translation "0:255=168:183"
  States {
   SpawnFrame:
    TMFX ABCDE 2 A_SetScale(scaleX + 0.8, scaleY + 0.8)
    stop
  }
}

actor VWFinalClawSlash : VWProjectile {
  +RIPPER
  +DONTBLAST
  +FORCEXYBILLBOARD
  +BRIGHT
  Radius 24
  Height 24
  Speed 85
  Damage (260)
  DamageType "FinalClaw"
  Obituary "%o was torn to shreds by %k's \cjFinal Claw\c-."
  RenderStyle "Normal"
  Translation "0:255=176:191"
  Scale 3.0
  States {
   Spawn:
    SCLA H 1 A_PlaySound("MarioRPG/DeathSickle", 1)
    SCLA IJKL 2 A_Explode(60, 96, 0, 0, 32)
    stop
  }
}

// ==========================================
// CULEX 3D PHASE 2: METEOR SYSTEM
// ==========================================

actor VWMeteor : VWProjectile {
  +BRIGHT
  +SKYEXPLODE
  +DONTBLAST
  Radius 20
  Height 20
  Speed 35
  Damage (0)
  DamageType "VWMeteor"
  Obituary "%o was pulverized by %k's \cgMeteor\c-."
  RenderStyle "Add"
  Scale 2.8
  States {
   Spawn:
    6Q28 G 0
   SpawnLoop:
    6Q28 GH 2 A_SpawnItemEx("VWDarkStarTrail", random(-12, 12), random(-12, 12), random(-12, 12), 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 0 A_PlaySound("MarioRPG/Meteor", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_VWMeteorImpact")
    TNT1 A 0 A_SpawnItemEx("VWDarkStarExplosion")
    stop
  }
}

actor VWMeteorStrikeSpawner_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("VWMeteor", random(-650, 650), random(-650, 650), (ceilingz - z < 598 ? ceilingz - z - 48 : 550), random(-6, 6), random(-6, 6), -34, 0, 1)
    stop
  }
}

// ==========================================
// CULEX 3D PHASE 2: WIND ORB (Lightning Orb, Electroshock, Bolt, Light Beam, Static E!, Petal Blast)
// ==========================================

// M1 Tap: Lightning Orb (0 ammo)
actor VWLightningOrb : VWProjectile {
  +BRIGHT
  +DONTBLAST
  +HITTRACER
  Radius 12
  Height 12
  Speed 44
  Damage (25)
  DamageType "LightningOrb"
  Obituary "%o was electrocuted by %k's \cdLightning Orb\c-."
  RenderStyle "Add"
  Scale 1.8
  States {
   Spawn:
    SPAS A 0
   SpawnLoop:
    SPAS AB 2 A_SpawnItemEx("VWDarkStarTrail", random(-4, 4), random(-4, 4), random(-4, 4), 0, 0, 0, 0, 1)
    loop
   Crash:
   XDeath:
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 1)
    TNT1 A 0 A_SpawnItemEx("VWLightningCageWatcher", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("VWDarkStarExplosion")
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    stop
   Death:
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 1)
    TNT1 A 0 A_Explode(20, 48, 0, 0, 24)
    TNT1 A 0 A_SpawnItemEx("VWDarkStarExplosion")
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    stop
  }
}

// Lightning Orb: Attached electrical cage watcher on target
actor VWLightningCageWatcher {
  +NOBLOCKMAP
  +NOGRAVITY
  +DONTBLAST
  DamageType "LightningOrb"
  RenderStyle "None"
  States {
   Spawn:
    TNT1 A 0 nodelay
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_SpawnItemEx("VWLightningCageFX", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_Explode(5, 48, 0, 0, 48)
   CageLoop:
    // Tick 1 (12 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(5, 48, 0, 0, 48)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    // Tick 2 (12 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 0 A_Explode(5, 48, 0, 0, 48)
    TNT1 A 0 A_PlaySound("MarioRPG/StaticE", 2)
    // Tick 3 (12 tics)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", 1), "Null")
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)

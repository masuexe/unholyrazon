actor FireRapistShot1Z_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
TNT1 A 0 A_GiveInventory("GenericComboFlag1",1)
TNT1 A 0 A_JumpIfInventory("GenericComboFlag1",7,"Reset")
TNT1 A 0 A_JumpIfInventory("GenericComboFlag1",6,"Combo4")
TNT1 A 0 A_JumpIfInventory("GenericComboFlag1",4,"Combo3")
TNT1 A 0 A_JumpIfInventory("GenericComboFlag1",2,"Combo2")
Combo1:
8L00 A 0 A_SpawnItemEx("RapistShot1Z",0,0,32,15,0,0)
stop
Combo2:
8L00 A 0 A_SpawnItemEx("RapistShot1Z",0,0,32,15,random(-16,-16),random(0,0))
stop
Combo3:
8L00 A 0 A_SpawnItemEx("RapistShot1Z",0,0,32,15,random(-32,32),random(-8,16))
stop
Combo4:
8L00 A 0 A_SpawnItemEx("RapistShot1Z",0,0,32,15,random(-64,64),random(-16,32))
stop
Reset:
TNT1 A 0 A_TakeInventory("GenericComboFlag1")
goto Combo4
}
}


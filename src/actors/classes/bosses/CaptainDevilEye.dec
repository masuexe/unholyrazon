actor CaptainDevilEye : BossBase {
  Player.ScoreIcon "UB009MUG"
  Player.SoundClass "CaptainDevilEye"
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 10
  Player.MaxHealth 1500
  Health 1500

  damagefactor "DevilGasm", 0.0

  Player.MorphWeapon "CaptainDevilEye_W"
  States {
   Spawn:
    8A09 A 0
    8A09 B 1
    8A09 A 1
    goto Spawn+2
   See:
    8A09 BCDE 5
    goto Spawn
   Missile:
    8A09 F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Upper")
    8A09 F 5
    8A09 G 4
    goto Spawn+2
   Missile_Upper:
    8A09 A 3
    8A09 III 6
    goto Spawn+2
   CustomState1:
    goto Missile+1
   ClassPain:
    8A09 H 0
    goto MegamanPain
   ClassDeath:
    8A09 H 0
    goto MegamanDeath
  }
}

actor PlainDevilDemoneye : PlainDemoneye {
  damagefactor "DevilCash", 0.0
  damagefactor "DevilFire", 0.0
  damagefactor "DevilWindUp", 0.0
  damagefactor "DevilGasm", 0.0

  Player.MorphWeapon "PlainDevilDemoneye_W"
}

actor Cobe : BossBase {  // Dog
  Player.ScoreIcon "UB303MUG"
  // +PLAYERPAWN.NOTHRUSTWHENINVUL
  Player.SoundClass "Cobe"
  Player.DamageScreenColor "black"
  Player.ForwardMove 1.45, 1.45
  Player.SideMove 1.45, 1.45
  Player.MaxHealth 1000
  Health 1000
  Player.JumpZ 24  // 12
  Gravity 2.0  // Special class, special things.
  MaxStepHeight 32  //
  Player.MorphWeapon "Dog_W"  // Fist
  States {
   Spawn:
    COBE A 0
    COBE A 1  // A_PlaySoundEx("weapon/CeobeSpawn","SoundSlot7")
    COBE A 175
    COBE A 5 A_PlaySoundEx("weapon/CeobeSpawn", "SoundSlot7")
    COBE A 1
    goto Spawn+4
   See:
    COBE BA 3
    goto Spawn
   Missile:
    COBE BA 3
    goto Spawn+2
   ClassPain:
    COBE A 0
    goto MegamanPain
   ClassDeath:
    COBE C 0
    goto MegamanDeath
   MegamanDeath0:
    COBE C 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    COBE C 0 A_PlaySoundEx("weapon/CeobeFail", "SoundSlot5")  // 1
    COBE C 0 ThrustThing(random(0, 255), 30, 1, 0)
    COBE C 0 ThrustThingZ(0, 50, 0, 0)
    COBE C 240  // 14
    COBE C 15 A_PlaySoundEx("weapon/CeobePoof", "SoundSlot5")  // 1
   MegamanDeathLoop:
    COBE C 1 A_Fadeout(0.1, false)
    COBE C 0 A_GiveInventory("DeathFadeOutFlag")
    COBE C 0 A_JumpIfInventory("DeathFadeOutFlag", 9, "MegamanErase")
    loop
  }
}

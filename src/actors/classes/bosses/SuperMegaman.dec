actor SuperMegaman : BossBase {
  Player.ScoreIcon "UB066MUG"
  player.soundclass "SuperMegaman"
  player.forwardmove 1.1, 1.1
  player.sidemove 1.08, 1.08
  player.jumpz 12.5
  Player.MaxHealth 2000
  Health 2000
  player.morphweapon "SuperMegaman_W"
  States {
   Spawn:
    SPMM A 0
    SPMM B 1
    SPMM A 1
    Goto Spawn+2
   See:
    SPMM BCDE 5
    Goto Spawn
   Missile:
    SPMM F 5
    SPMM G 4
    goto Spawn+2
   ClassPain:
    SPMM H 0
    Goto MegamanPain
   ClassDeath:
    SPMM H 0
    Goto MegamanDeath
  }
}

actor WeakHorse : BossBase {
  Player.ScoreIcon "UL066MUG"
  player.soundclass "WeakHorse"
  player.damagescreencolor "black"
  player.sidemove 1.0, 1.0
  player.forwardmove 1.0, 1.0
  Player.MaxHealth 850
  Health 850
  player.morphweapon "WeakHorse_W"
  player.jumpz 10
  States {
   Spawn:
    HORS A -1
    loop
   See:
    HORS A 114
    Goto Spawn
   Missile:
    HORS A 514
    goto Spawn
   ClassPain:
    HORS A 0
    Goto MegamanPain
   ClassDeath:
    HORS A 0 A_Explode(700, 78, 0, 0, 78)
    Goto MegamanDeath
  }
}



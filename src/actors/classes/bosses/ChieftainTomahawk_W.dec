    8H61 E 0 ACS_NamedExecuteWithResult("core_chargecolor", CHIEFTAINTOMAHAWK_DYEC1)
    8H61 E 0  // A_GiveInventory("UnholyBossAmmo250",2)
    8H61 E 1 Offset(62, -3) A_GiveInventory("ChieftainCharge", 2)

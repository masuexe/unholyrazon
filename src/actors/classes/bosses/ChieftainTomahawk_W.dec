actor ChieftainHold_H : BasicWatcher {
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 1 A_TakeFromTarget("ChieftainHold", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("ChieftainHold", 1, "Spawn")
    goto Death
  }
}


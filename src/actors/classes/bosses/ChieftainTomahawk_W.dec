actor Chieftain_Tomahawk_S : BasicProjectile {
  //
  +NOGRAVITY
  -HEXENBOUNCE
  WALLBOUNCEFACTOR 0.8
  BOUNCEFACTOR 0.6
  bouncecount 8
  //
  Translation "192:192=218:218", "198:198=43:43"
  Radius 16
  Height 8  // 7
  scale 2.5
  Damage (random(175, 200))  // 350 ~ 400
  speed 35  // 40   //50
  +NOEXPLODEFLOOR
  // +RIPPER
  damagetype "Chieftain"
  Obituary "%o caught \ciChieftain Tomahawk \c-(%k)'s tomahawk."
  States {
   Spawn:
    X_6F A 1 ThrustThingZ(0, 2, 0, 1)  // 3
    X_6F A 0 A_ScaleVelocity(1.05)  // 1.05
    X_6F A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F B 1 ThrustThingZ(0, 2, 0, 1)
    X_6F B 0 A_ScaleVelocity(1.05)  // 1.05
    X_6F B 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    loop
   Crash:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("classes/DerpyHit", "Weapon")  // Something something, impacts hard.
    TNT1 A 1 A_SpawnItemEX("CTTomahawkClash")
    Stop
   Death:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 ThrustThingZ(0, 25, 0, 1)
    TNT1 A 0 A_Recoil(6)
    TNT1 A 0 A_PlaySoundEx("weapon/freezecrackerhit", "Weapon")
    8I15 A 0 A_ChangeFlag("NOGRAVITY", 0)
    8I15 A 0 A_ChangeFlag("HEXENBOUNCE", 0)
    X_6F ABAB 2
    TNT1 A 2
    X_6F A 2
    TNT1 A 2
    X_6F B 2
    TNT1 A 2
    X_6F A 2
    TNT1 A 2
    X_6F B 2
    TNT1 A 2
    X_6F A 2
    stop
  }
}


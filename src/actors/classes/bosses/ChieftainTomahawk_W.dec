   ReadyX:
    8H61 A 2 A_WeaponReady
    8H61 A 0 A_GiveInventory("UnholyBossAmmo200", 4)
    loop
   Deselect:
    8H61 C 0
    goto DeselectSwap
   Select:
    8H61 C 0
    goto SelectSwap
    //
    //
   Flash:
    TNT1 A 0 A_GiveInventory("Chieftain_Dash_Limiter", 2)
    TNT1 AAA 2 A_JumpIfInventory("Chieftain_Dash_Stopper", 1, "WhenTheresSmoke")
    loop
   WhenTheresSmoke:  // TheyAlwaysPinchBack
    TNT1 A 0 A_TakeInventory("Chieftain_Dash_Limiter")
    TNT1 A 0 A_TakeInventory("Chieftain_Dash_Stopper")
    TNT1 A 115
    Goto Flash
    //
    //
   Fire:
    // Hold:
   Charge:
    8H61 D 0 ACS_NamedExecuteWithResult("core_chargecolor", CHIEFTAINTOMAHAWK_DYE)
    8H61 D 0 A_JumpIfInventory("SuplexID", 1, "ImTheLorax")

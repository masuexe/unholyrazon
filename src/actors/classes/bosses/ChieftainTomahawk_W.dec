    8H61 D 2
    8H61 D 1 Offset(4, -16)
    8H61 E 1 Offset(46, -2)
    8H61 E 1 Offset(58, -3)
    8H61 E 1 Offset(64, -3)
    8H61 E 3 Offset(66, -3)
    goto Charge0
   Charge0:  // BossAmmo250 isn't used, for some reason. Maybe I never thought he'd use it... Not yet anyways..
    8H61 E 0 A_JumpIfInventory("ChieftainCharge", 17, "Charge1")

actor Chieftain_Dash_Stopper : Once {}

actor Chieftain_Suplex_Damager_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "P_S")
    TNT1 A 0 A_FireCustomMissile("ChieftainDukeNukemLite", 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("ChieftainShockwaveLite", 0, 0, 0, 0)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "P_S")
    TNT1 A 0 A_SpawnItemEX("ChieftainLandingExplodeLite", 64, 0, 5, 0, 0, 0, 0, 0)
    //
    // TNT1 A 0 A_FireCustomMissile("ChieftainDukeNukemLite",0,0,0,0)
    // TNT1 A 0 A_FireCustomMissile("ChieftainShockwaveLite",0,0,0,0)
    // TNT1 A 0 A_SpawnItemEX("ChieftainLandingExplodeLite",64,0,5,0,0,0,0,0)
    //
    stop
   P_S:  // You have to be some kind of fucked up dude to realize how much this is going to do.
    TNT1 AAA 0 A_SpawnItemEX("ChieftainLandingExplodeLite", 64, 0, 5, 0, 0, 0, 0, 0)
    stop
  }
}

actor Chieftain_GrabReset_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SuplexID")
    TNT1 A 0 A_TakeInventory("IsPerformingSuplex")

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)

    TNT1 A 0 A_TakeInventory("Chieftain_AirTimer")  // In case.
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    stop
  }
}


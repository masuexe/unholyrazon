actor Chieftain_Tomahawk_X : Chieftain_Tomahawk_S {
  Translation "192:192=43:43", "198:198=218:218", "202:202=218:218", "199:199=43:43"
  // +RIPPER
  +THRUACTORS
  +THRUGHOST
  +NOEXPLODEFLOOR
  +DONTBLAST
  // +PIERCEARMOR
  Radius 4  // 20
  Height 4  // 8
  scale 3.5  // Damage is lessened a lot because of how this should work.
  Damage (0)  // (random(240,280))
  speed 70  // 60
  damagetype "Chieftain"  // ChieftainTHawk //Chieftain_FlingUp
  Obituary "%o was cut up by \ciChieftain Tomahawk \c-(%k)'s empowered tomahawk."
  States {
   Spawn:
    X_6F A 0 ThrustThingZ(0, 1, 0, 1)  // 3
    X_6F A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F ABA 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
    X_6F B 0 ThrustThingZ(0, 1, 0, 1)
    X_6F A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F BAB 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
    X_6F A 0 ThrustThingZ(0, 1, 0, 1)  // 3
    X_6F A 0 A_ScaleVelocity(0.85)  // 1.05
    X_6F A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F ABA 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
    X_6F B 0 ThrustThingZ(0, 1, 0, 1)
    X_6F B 0 A_ScaleVelocity(0.95)  // 1.05
    X_6F B 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F BAB 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
   FlyMore:
    X_6F A 0 ThrustThingZ(0, 2, 0, 1)
    X_6F B 0 A_ScaleVelocity(1.05)
    X_6F A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F ABA 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
    X_6F B 1 ThrustThingZ(0, 2, 0, 1)
    X_6F B 0 A_ScaleVelocity(1.05)
    X_6F B 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    X_6F A 0 A_SpawnItemEx("CTTomahawkTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6F A 0 A_Explode(100, 48, 0, 0, 49)
    X_6F BAB 1 ACS_NamedExecuteWithResult("uh_missileyank", 48)  // ACS_NamedExecuteAlways("uh_missileyank",0,48,48)
    loop
   Death:
    X_1D A 0 A_Stop
    X_1D A 0 Radius_Quake(5, 10, 0, 16, 0)
    X_1D A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    X_1D A 0 A_Explode(250, 128, 0)
    TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZangiefRockFX", random(0, 10), 0, 8, random(3, 18), 0, random(3, 16), random(0, 359), 1, 8)  // It's just visual FX, after all.
    Y_1D BCDEFGHIJKLMN 1
    stop
  }
}

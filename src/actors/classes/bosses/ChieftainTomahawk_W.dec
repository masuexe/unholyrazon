actor ChieftainTomahawk_W_ScriptBar : ScriptBar {}
actor ChieftainTomahawk_W : BaseUnholyBossWep  // AxeOfTheMountainsWithNoBuffalos
// There are.... better names out there.
{  // Chieftain's_Axe+ | Tomahawk_Axe+ | Stout_Tomahawk (Dorcas Prf Weapon.)
  Obituary "$OB_BOSS61A"
  // Satire.
  Inventory.Pickupmessage "\ccAnything put here is going to come off as stereotypical, so..."
  weapon.ammotype "Chieftain_Dash_Limiter"
  States {
   Spawn:
    8H61 [ 1
    wait

   Ready:
    8H61 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CHIEFTAINTOMAHAWK_DYE)
    8H61 A 0 A_GunFlash
    8H61 A 0 A_GiveInventory("WallJumpLimit", 1)

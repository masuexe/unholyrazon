// HP < 35% spawn → swap here; Ready runs ThatsItImGettingMySword once.
actor Rogue_W_Pissed_ScriptBar : ScriptBar {}
actor Rogue_W_Pissed : Rogue_W {
  States {
   Ready:
    8I07 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
    8I07 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, ROGUE_DYE)
    8I07 A 0 A_JumpIfInventory("RogueGetUpDone_F",1,"ReadyAfterGetUp")
    8I07 A 0 A_JumpIfInventory("IsPissedFlag",1,"ReadyAfterGetUp")
    8I07 A 0 A_GiveInventory("RogueGetUpDone_F")
    8I07 A 0 A_JumpIf(true, "ThatsItImGettingMySword")
    goto ThatsItImGettingMySword
   ReadyAfterGetUp:
    8I07 R 0 A_GunFlash("Flash",1)
    goto ReadyX2
   ReadyX:
    goto ReadyX2
   Fire:
    8I07 A 0 A_JumpIfInventory("RogueArtsFlag", 0, "RogueArtsKick")
    8I07 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "RogueBreak")
    8I07 A 0 A_GiveInventory("RogueCubeFire_F")
    goto Combo1
   RogueBreak:
    8I07 B 0 A_GiveInventory("VivifyDelay6")
    8I07 B 0 A_TakeInventory("UnholyPower1500", 1500)
    8I07 B 0 A_PlaySoundEx("MMSF2/RogueLeap", "Weapon")
    8I07 B 0 A_ChangeVelocity(25,0,100,3)
    goto RogueBreakSword
   RogueBreakGenesis:
    8I07 N 0 A_GiveInventory("VivifyDelay6")
    8I07 N 0 A_PlaySoundEx("MMSF2/RogueBreak", "Weapon")
    8I07 N 0 Radius_Quake(5,35,0,50,0)
    8I07 N 0 A_FireCustomMissile("Rogue_WaveSpawner",0,0,0,0)
    8I07 N 0 A_FireCustomMissile("Rogue_WaveSpawner",90,0,0,0)
    8I07 N 0 A_FireCustomMissile("Rogue_WaveSpawner",180,0,0,0)
    8I07 N 0 A_FireCustomMissile("Rogue_WaveSpawner",270,0,0,0)
    8I07 N 0 A_SpawnItemEx("Rogue_BreakSpawner",80,0,10,0,0,0,0)
    8I07 N 0 A_SpawnItemEx("Rogue_BreakSpawner",0,-120,10,0,0,0,0)
    8I07 N 0 A_SpawnItemEx("Rogue_BreakSpawner",0,120,10,0,0,0,0)
    8I07 N 0 A_SpawnItemEx("Rogue_BreakSpawner",160,120,10,0,0,0,0)
    8I07 N 0 A_SpawnItemEx("Rogue_BreakSpawner",160,-120,10,0,0,0,0)
    8I07 X 1 OffSet(-141,26)
    8I07 X 3 OffSet(-168,44)
    TNT1 A 3
    goto RogueBreakSwordEnd
   Altfire:
    8I07 A 0 A_JumpIfInventory("RogueArtsFlag", 0, "RogueBurst")
    goto AltfireXCheck
  }
}

// Flash polls HP; swap to Rogue_W_Pissed (no Ready-frame HealthLower)
actor RogueHealthCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_CountBossInventory", CNTB_SPAWNHEALTH)*0.35+1,1)
    stop
    TNT1 A 0 A_JumpIfInventory("IsDead",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("Rogue_W_Pissed",1,"NoSwap")
    TNT1 A 0 A_JumpIfInventory("RoguePainFlag",1,"NoSwap")
    TNT1 A 0 A_GiveInventory("RogueSwapPissed_P")
    stop
   NoSwap:

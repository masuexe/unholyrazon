actor Rogue_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RogueCubeIsAlive", 1, "PickupCheck")
    TNT1 A 0 A_Jump(256, "PickupReload")
    goto PickupReload
   PickupCheck:
    TNT1 A 0 A_JumpIfInventory("RogueCubeWarp_F", 1, "PickupNormal")
    TNT1 A 0 A_Jump(256, "PickupReload")
    goto PickupReload
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo150", 2)
    stop
  }
}
actor Rogue_Ready8_P : Rogue_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}



Actor Rogue_MuCube : ProjSpawnFuncActor
{//About 1:3 ratio for rage or a flat 3-500?
//Translation "192:192=62:62","198:198=61:61"
Translation "192:192=58:58","198:198=249:249"
Damagetype "Rogue"
Obituary "%k's Mu Cube eliminated %o."
+MISSILE
-SOLID
+NOGRAVITY
+NOTELEPORT
+THRUGHOST
//+THRUACTORS
+NOCLIP
+DONTBLAST
+DONTDRAIN
+NOTAUTOAIMED
+DONTREFLECT
+SHOOTABLE
//+THRUSPECIES
//+DONTHURTSPECIES
//+DONTHARMSPECIES
+NOTARGETSWITCH
+CANTSEEK

Species "Rogue_MuCube"
Painchance 0
Damagefactor "Rogue", 0.0
Damagefactor "RogueSlow", 0.0

Mass 0x7ffffffc
Health 1500
Damage (0)
Radius 32
Height 32
Scale 2.0
States
{
Spawn:
8Q07 R 0
8Q07 R 0 A_PlaySoundEx("MMSF2/MuPower","SoundSlot5")
8Q07 R 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
Goto Idling
Idling:
8Q07 R 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 R 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 R 0 A_JumpIfInTargetInventory("RogueCubeWarp_F",1,"Warping")
8Q07 R 0 A_JumpIfInTargetInventory("RogueCubeFire_F",1,"CubeMain")
8Q07 R 0 A_JumpIfInTargetInventory("VivifyDelay9",1,"CubeAlt")
8Q07 R 3

8Q07 S 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 S 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 S 0 A_JumpIfInTargetInventory("RogueCubeWarp_F",1,"Warping")
8Q07 S 0 A_JumpIfInTargetInventory("RogueCubeFire_F",1,"CubeMain")
8Q07 S 0 A_JumpIfInTargetInventory("VivifyDelay9",1,"CubeAlt")
8Q07 S 3

8Q07 T 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 T 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 T 0 A_JumpIfInTargetInventory("RogueCubeWarp_F",1,"Warping")
8Q07 T 0 A_JumpIfInTargetInventory("RogueCubeFire_F",1,"CubeMain")
8Q07 T 0 A_JumpIfInTargetInventory("VivifyDelay9",1,"CubeAlt")
8Q07 T 3

8Q07 U 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 U 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 U 0 A_JumpIfInTargetInventory("RogueCubeWarp_F",1,"Warping")
8Q07 U 0 A_JumpIfInTargetInventory("RogueCubeFire_F",1,"CubeMain")
8Q07 U 0 A_JumpIfInTargetInventory("VivifyDelay9",1,"CubeAlt")
8Q07 U 3
loop
Warping:
TFOG C 0 A_Warp(2,-24,0,32,8)
TFOG C 0 A_PlaySoundEx("item/ItemUseMM9","Body")
TFOG C 2 A_Stop
TFOG BA 2
goto Idling
CubeMain:
8Q07 R 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 R 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 RR 1 A_GiveToTarget("Rogue_TargetMarker",1)
8Q07 R 0 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 32)
8Q07 R 0 A_PlaySoundEx("ToyStory/LaserPew","Voice")
8Q07 R 0 A_SpawnItemEx("Rogue_MuCubeShot",cos(-pitch)*8,0,32+(sin(-pitch)*8),cos(-pitch)*55,0,sin(-pitch)*55,0,1)
//8Q07 R 0 A_CustomMissile("Rogue_MuCubeShot",8,0,0,2,-pitch)
8Q07 STU 2
goto Idling
CubeAlt:
8Q07 R 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 R 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 R 1 //A_ChangeFlag("BUDDHA",1)
8Q07 S 0 A_JumpIfInTargetInventory("IsPissedFlag",1,"CubeAlt2")
8Q07 S 1 A_SpawnItemEx("Rogue_MuCubeEMWave",0,0,12,0,0,0,0,1)
8Q07 TURSTURSTURSTURSTURSTURSTURSTURSTURSTURSTU 1
8Q07 R 0 //A_ChangeFlag("INVULNERABLE",0)
goto Idling
CubeAlt2:
8Q07 S 0 A_JumpIfInTargetInventory("IsAFakeBoss",1,"Death2")
8Q07 S 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
8Q07 S 1 A_SpawnItemEx("Rogue_MuCubeEMWave2",0,0,12,0,0,0,0,1)
8Q07 TURSTURSTURSTURSTURSTURSTURSTURSTURSTURSTURSTURSTU 1
goto Idling

Death:
TNT1 A 0 A_GiveToTarget("UnholyPower1500",300)
TNT1 A 0 A_SpawnItemEx("Rogue_MuCubeReviver_H")
Death2:
TNT1 A 0 //A_GiveToTarget("RogueCubeIsDead",1)
TNT1 A 0 //A_TakeFromTarget("RogueCubeIsAlive")
TNT1 A 1 A_SpawnItemEx("Rogue_MuCubeDeathFX",0,0,12,0,0,0,0,1)
Stop
}
}


 goto Flash_ShieldCooldown
Flash_ShieldCooldown:
 TNT1 A 0 A_GiveInventory("RogueShieldFlag", (velx*velx + vely*vely + velz*velz) * 0.01)
 TNT1 A 1 A_GiveInventory("RogueHealthCheck_P")
 TNT1 A 0 A_JumpIfInventory("RogueShieldFlag", 0, "Flash_ShieldSpawn")
 loop
}

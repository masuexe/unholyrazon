Flash_ShieldSpawn:
 TNT1 A 1 A_PlaySoundEx("S3_K/U_Shield","Body")
 TNT1 A 0 A_TakeInventory("RogueShieldFlag")
 TNT1 A 0 ACS_NamedExecuteWithResult("core_buddhaplayer", 0, true)

/// //////////////////////
// Beep Boop Whirr Click//
/// //////////////////////

// Faggasso are renamed to Speciman, visually.
// Not code wise.
// Mainly because I don't expect people to look into the code.
// Changing everything is a bit tedious, please understand. - Trist.

actor Speciman_W_NormalBar : NormalBar {args 200, 75}
actor Speciman_W_SecondBar : SecondBar {args 4, 94}
actor Speciman_W_ReloadIcon : ReloadIcon {Tag "R042B0"}
actor Speciman_W : BaseUnholyBossWep {
  Tag "$TAG_Boss042_W"
  Obituary "\ccSpeciman\c- (%k) assumed that %o was dead."
  Inventory.Pickupmessage "Hark Hark"
  weapon.ammotype2 "UnholyBossAmmo200"
  weapon.ammotype "UnholyBossAmmo250"
  States {
   Spawn:
    8H42 [ 1
    wait

   Ready:
    8H42 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, SPECIMAN_DYE)
    8H42 A 0 A_GiveInventory("IsSpecimanFlag")
    // 8H42 A 0 A_GiveInventory("SpecimanItem",1)
    8H42 A 0 A_GunFlash
    goto ReadyX

   ReadyX:
    8H42 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "ReadyX2")
    8H42 A 2 A_GiveInventory("Speciman_Ready8_P")
    loop
   ReadyX2:
    8H42 A 2 A_GiveInventory("Speciman_Ready0_P")
    loop

   Fire:
    8H42 A 0 A_PlaySoundEx("weapon/pshot", "Weapon")
    8H42 A 0 A_FireCustomMissile("ASPGenericBlast", 0, 0, 0, 8)
    8H42 D 2 Offset(-6, 25)A_GiveInventory("UnholyBossAmmo200", 1)
    8H42 D 2 Offset(-12, 18)A_GiveInventory("UnholyBossAmmo200", 1)
    8H42 D 2 Offset(-8, 23)A_GiveInventory("UnholyBossAmmo200", 1)
    8H42 D 2 Offset(-4, 28)A_GiveInventory("UnholyBossAmmo200", 1)
    8H42 B 2 Offset(-2, 30)A_GiveInventory("UnholyBossAmmo200", 1)
    8H42 B 0 A_WeaponReady(14)
    8H42 BBBBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo200", 1)
    // BUSH YXWVUUVWXY 2 A_GiveInventory("UnholyBossAmmo200",1)
    // BUS2 BBBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo200",1)
    Goto ReadyX
   Altfire:
    8H42 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "DeployShield")
    Goto ReadyX
   DeployShield:
    8H42 C 2 Offset(5, 28)A_GiveInventory("Speciman_ShieldStart_P")
    8H42 E 2 Offset(12, 25)
    8H42 E 2 Offset(18, 19)A_SpawnItemEx("ASPShieldAppliedFX")
    8H42 DDDDDDD 2 Offset(23, 16)A_SpawnItemEx("ASPShieldAppliedFX")
    8H42 E 2 Offset(18, 19)A_SpawnItemEx("ASPShieldAppliedFX")
    8H42 E 2 Offset(12, 25)
    8H42 B 2 Offset(5, 28)
    8H42 B 0 A_WeaponReady(14)
    TNT1 BBBBBBBBBBBBBBBBBB 0 A_SpawnItemEx("ASPShieldDeploymentFX", random(-2, 2), random(-2, 2), 32, random(-35, 35), random(-35, 35), random(-35, 35))
    8H42 B 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    8H42 B 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8H42 BBBBBBBBBB 2 A_GiveInventory("UnholyBossAmmo200", 1)
    Goto ReadyX

   Flash:
    TNT1 A 1 A_JumpIfInventory("UnholyBossAmmo200", 200, 1)
    loop
    TNT1 A 4 A_SpawnItemEx("ASPFlashIndicatorWarn", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    loop

   Reload:
    8H42 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, 1)
    goto ReadyX
    8H42 B 0 A_TakeInventory("UnholyBossAmmo200", 200)
    8H42 B 0 A_JumpIf(true, "ASPFlash")
   ASPFlash:
    8H42 B 1 A_GiveInventory("SpecimanASPFlash_P")
    goto ReadyX
  }
}

actor Speciman_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    8H43 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    8H43 A 0 A_GiveInventory("UnholyBossAmmo250", 2)
    stop
  }
}
actor Speciman_Ready8_P : Speciman_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8+16)
    goto Ammo
  }
}

actor Speciman_ShieldStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DynamicArmorDosage")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo250", 125)
    TNT1 A 0 A_GiveInventory("Speciman_BasicArmor_P", 1)
    TNT1 A 0 A_GiveInventory("SetDynamicArmorDosage")

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    TNT1 A 0 A_PlaySound("E_B/Shield1")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    stop
  }
}


actor ASPFlashReal : BasicExplosion {
  Translation "0:255=190:190"
  damagetype "ASPDeath"
  Obituary "\ccSpeciman\c- (%k) assumed %o was no more."
  Mass 9999
  MeleeRange 1000
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(Mass, MeleeRange, 0, 0, MeleeRange)
    TNT1 A 3 A_SpawnItemEx("ASPFlashFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPFlashDud : ASPFlashReal {
  Translation "0:255=4:4"
  damagetype "ASPDeath"
  Obituary "%o saw the sudden light of \ccSpeciman\c- (%k)'s \cuASP Flash\c-."
  // Obituary "%o could not grasp such concepts."
  Mass 0
}

actor ASPFlashTimeStop : ASPFlashDud {
  Translation "0:255=239:239"
  damagetype "BossTimeStop"
  Mass 50
}

actor ASPFlashShocker : ASPFlashDud {
  Translation "0:255=228:228"
  damagetype "ASPStun"
  Mass 50
}

actor ASPFlashBlind : ASPFlashDud {
  Translation "0:255=128:128"
  damagetype "ASPBlind"
  Mass 50
}

actor ASPFlashFling : ASPFlashDud {
  Translation "0:255=199:199"
  damagetype "ASPFling"
  Mass 50
}

actor ASPFlashFX_H : BasicClientSide {
  var int user_A;
  reactiontime 18
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_A", random(0, 20))
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 10, 0, 30, 4, 0, 9, user_A+15, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 20, 0, 20, 8, 0, 6, user_A+10, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 30, 0, 10, 12, 0, 3, user_A+5, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 40, 0, 0, 8, 0, 0, user_A, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 30, 0, -10, 12, 0, -3, user_A+5, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 20, 0, -20, 8, 0, -6, user_A+10, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 10, 0, -30, 4, 0, -9, user_A+15, 37)
    TNT1 A 0 A_SetUserVar("user_A", user_A+20)
    TNT1 A 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 0, 0, 40, 0, 0, 4, 0, 37)
    TNT1 A 0 A_SpawnItemEx("ASPFlashFX", 0, 0, -40, 0, 0, -4, 0, 37)
    stop
  }
}

actor ASPFlashFX : BasicClientSide {
  RenderStyle Translucent
  Alpha 0.75
  Speed 200
  Scale 1.75
  States {
   Spawn:
    TNT1 A 1
    TMFX A 2
    X_8G C 2
    TMFX BC 2
    X_8G A 2
    TMFX D 2
    X_9A G 2
    stop
  }
}


actor ASPFlashIndicatorWarn {
  Translation "192:192=0:0", "198:198=80:80", "202:202=80:80", "199:199=0:0"
  -SOLID
  +NOGRAVITY
  +NOINTERACTION
  +CLIENTSIDEONLY
  Radius 3
  Height 3
  renderstyle add
  Alpha 0.95
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "Spawn1", "Spawn2")
   Spawn1:
    X_7A D 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    X_7A D 1 A_FadeOut(0.05)
    X_7A D 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    X_7A D 1 A_FadeOut(0.05)
    X_7A E 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    X_7A E 1 A_FadeOut(0.05)
    X_7A E 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    X_7A E 1 A_FadeOut(0.05)
    loop
   Spawn2:
    Y_7A D 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    Y_7A D 1 A_FadeOut(0.05)
    Y_7A D 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    Y_7A D 1 A_FadeOut(0.05)
    Y_7A E 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    Y_7A E 1 A_FadeOut(0.05)
    Y_7A E 0 A_SetScale(scaleX+0.05, scaleY+0.05)
    Y_7A E 1 A_FadeOut(0.05)
    loop
  }
}

actor ASPGenericBlast {
  Translation "192:192=4:4", "198:198=93:93"
  PROJECTILE
  Damagetype "ASPMagic"
  Obituary "%o was smacked by \ccSpeciman\c- (%k)'s \cuASP Blast\c-."
  +SKYEXPLODE
  +EXPLODEONWATER
  Damage (75)
  Radius 16
  Height 16
  Speed 60
  Scale 3.5
  States {
   Spawn:
    TMFX A 1 A_SpawnItemEx("ASPGenericBlastFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 1 A_SpawnItemEX("ASPGenericBlastExplode", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPGenericBlastExplode : BasicExplosion {
  Damagetype "ASPMagic"
  Obituary "%o was smacked by \ccSpeciman\c- (%k)'s \cuASP Blast\c-."
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
    TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ASPGenericBlastFX2", random(-2, 2), random(-2, 2), 8, random(-25, 25), random(-25, 25), random(-25, 25), 0, 1)
    TNT1 A 0
    TNT1 A 0 A_Explode(180, 164, 0, 0, 8)
    X_8B AABBCCDDEEFF 1 A_SpawnItemEx("ASPGenericBlastExplode2", random(-120, 120), random(-120, 120), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}

actor ASPGenericBlastExplode2 : ASPGenericBlastExplode {
  Scale 1.5
  States {
   Spawn:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(50, 80, 0)
    X_8B ABCDEF 2 A_Fadeout(0.08)
    stop
  }
}

actor ASPGenericBlastFX : BasicClientSide {
  Scale 3.0
  States {
   Spawn:
    TMFX BBBCCCCCD 1 A_FadeOut(0.05)
    Stop
  }
}

actor ASPGenericBlastFX2 : BasicClientSide {
  Scale 2.5
  States {
   Spawn:
    TMFX BBBBCCCDD 2 A_FadeOut(0.05)
    Stop
  }
}

actor ASPShieldDeploymentFX : BasicClientSide {
  Translation "192:192=208:208", "198:198=74:74"
  States {
   Spawn:
    TMFX BBBBCCCDD 2 A_FadeOut(0.05)
    Stop
  }
}

actor ASPShieldAppliedFX : BasicClientSide {
  Translation "192:192=4:4", "198:198=74:74"
  States {
   Spawn:
    TNT1 A 0
    TNT1 AA 1 A_SpawnItemEx("ASPShieldAppliedFX2", random(-32, 32), random(-32, 32), 0, 0, 0, 7, 0, 1)
    stop
  }
}

actor ASPShieldAppliedFX2 : BasicClientSide {
  States {
   Spawn:
    CHPO X 4
    CHPO XXXX 2 A_ScaleVelocity(1.4)
    CHPO XXXXX 1 A_Fadeout(0.08)
    stop
  }
}

actor SpecimanASPFlash_P : CustomInventory {
  inventory.pickupmessage "Good old classic item projectile."
  states {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/centaurflash", "Weapon")
    TNT1 A 0 A_SetBlend(white, 0.95, 5)
    TNT1 A 0 A_Jump(16, "FlashA")
    TNT1 A 0 A_Jump(32, "FlashF")
    TNT1 A 0 A_Jump(64, "FlashC")
    TNT1 A 0 A_Jump(128, "FlashD")
    TNT1 A 0 A_Jump(192, "FlashE")
    TNT1 A 0 A_Jump(256, "FlashB")
    stop
   FlashA:
    TNT1 A 0 A_FireCustomMissile("ASPFlashReal", 0, 0, 0, 0)
    stop
   FlashB:
    TNT1 A 0 A_FireCustomMissile("ASPFlashDud", 0, 0, 0, 0)
    stop
   FlashC:
    TNT1 A 0 A_FireCustomMissile("ASPFlashTimeStop", 0, 0, 0, 0)
    stop
   FlashD:
    TNT1 A 0 A_FireCustomMissile("ASPFlashShocker", 0, 0, 0, 0)
    stop
   FlashE:
    TNT1 A 0 A_FireCustomMissile("ASPFlashBlind", 0, 0, 0, 0)
    stop
   FlashF:
    TNT1 A 0 A_FireCustomMissile("ASPFlashFling", 0, 0, 0, 0)
    stop
  }
}

actor MeguhMang_W_NormalBar : NormalBar {args 87, 227}
actor MeguhMang_W_SecondBar : SecondBar {args 34, 39}

actor MeguhMang_W : BaseUnholyBossWep
{
Tag "$TAG_Boss019_W"
Obituary "%o failed to defeat \cfMeguh Mang\c- (%k)!"
Inventory.Pickupmessage "\caYOU GOT THE REAL MEGABUSTER!"
weapon.ammotype "UnholyBossAmmo50"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H19 [ 1
wait

Deselect:
8H19 A 0
goto DeselectSwap
Select:
8H19 A 0
goto SelectSwap

Ready:
8H19 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H19 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MEGUHMANG_DYE)
8H19 A 0 ACS_NamedExecuteWithResult("uh_BossMorph", 19,3500,155)
8H19 A 6 
goto ReadyX
ReadyX:
8H19 A 0 A_JumpIfInventory("UnholyBossAmmo50",50,"ReadyX2")
8H19 A 2 A_WeaponReady(8)
8H19 A 0 A_GiveInventory("UnholyBossAmmo50",2)
loop
ReadyX2:
8H19 A 2 A_WeaponReady
8H19 A 0 A_GiveInventory("UnholyBossAmmo50",2)
loop

Fire:
8H19 A 0 A_JumpIfInventory("UnholyPower1500",1500,"REALMEGUHBUSTER")
8H19 A 0 A_PlaySoundEx("BBA_Snd/shotgun","Weapon")
// 8H19 ACBB 2 A_FireBullets(10,10,5,50,"MeguhHit",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
8H19 AAAAA 0 A_FireCustomMissile("MeguhBullet",frandom(-10,10),0,8,0,0,frandom(-10,10))
8H19 A 1 Offset(12, 44)
8H19 A 1 Offset(22, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 AAAAA 0 A_FireCustomMissile("MeguhBullet",frandom(-10,10),0,8,0,0,frandom(-10,10))
8H19 A 1 Offset(32, 64)
8H19 A 1 Offset(38, 70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 AAAAA 0 A_FireCustomMissile("MeguhBullet",frandom(-10,10),0,8,0,0,frandom(-10,10))
8H19 A 1 Offset(40, 72)
8H19 A 1 Offset(38, 70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 AAAAA 0 A_FireCustomMissile("MeguhBullet",frandom(-10,10),0,8,0,0,frandom(-10,10))
8H19 A 1 Offset(32, 64)
8H19 A 1 Offset(26, 58) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 1 Offset(20, 52)
8H19 A 1 Offset(14, 46) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 1 Offset(8, 40)
8H19 A 1 Offset(4, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 1 Offset(2, 34)
8H19 A 19 A_WeaponReady(14)
goto ReadyX

AltFire:
8H19 A 0 A_JumpIfInventory("UnholyBossAmmo50",50,"OhNoItsRush")
Goto ReadyX
OhNoItsRush:
8H19 A 0 A_TakeInventory("UnholyBossAmmo50",50)
8H19 A 0 A_PlaySoundEx("item/refill","Weapon")
// Call skyward, then point at landing. Offset(0,y) is Y-only from ready sx.
8H19 A 1 Offset(0, 28)
8H19 A 1 Offset(0, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 2 Offset(0, 20) A_SpawnItemEx("RAWSHTeleport",40,0,256,0,0,-32,0,SXF_NOCHECKPOSITION,0)
8H19 A 1 Offset(0, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 1 Offset(0, 48)
8H19 A 1 Offset(0, 60) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 2 Offset(0, 64)
8H19 A 1 Offset(0, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H19 A 1 Offset(0, 34)
8H19 A 1 A_WeaponReady(14)
Goto ReadyX

REALMEGUHBUSTER:
8H19 A 0 A_GiveInventory("DecoyFlag1",1)
8H19 A 0 A_PlaySound("voice/REAL",0,1.0,0,ATTN_NONE)
8H19 A 0 A_TakeInventory("UnholyPower1500", 1500)
8H19 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "REALMEGUHBUSTERRage")
// Timed to voice/REAL (~1.30s ≈ 46 tics) before voice/MEGABUSTER in RealFire.
// Raise 10 + lock 36 = 46.
8H19 A 1 Offset(-2, 31)
8H19 A 1 Offset(-4, 30)
8H19 A 1 Offset(-6, 27)
8H19 A 1 Offset(-8, 24)
8H19 A 1 Offset(-9, 22)
8H19 A 1 Offset(-10, 20)
8H19 A 1 Offset(-11, 18)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 15)
// Lock aim with micro-bob. 9*4=36 tics.
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 14)
Goto RealFire

REALMEGUHBUSTERRage:
// Rage: ~half of 46. Raise 6 + lock 18 = 24 tics, then RealFireRage.
8H19 A 1 Offset(-4, 30)
8H19 A 1 Offset(-8, 24)
8H19 A 1 Offset(-11, 18)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
// Lock 9*2=18 tics.
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
8H19 A 1 Offset(-13, 15)
8H19 A 1 Offset(-12, 16)
Goto RealFireRage

RealFire:
// Fire + recoil + settle. 34 tics ≈ 0.959s (voice/MEGABUSTER).
8H19 A 0 A_PlaySound("voice/MEGABUSTER",0,1.0,0,ATTN_NONE)
8H19 A 0 A_PlaySoundEx("weapons/busters/laserbusterfire3","Weapon")
8H19 A 1 Offset(-13, 15) A_FireCustomMissile("MeguhLaser",0,0,8,0)
8H19 A 0 A_TakeInventory("DecoyFlag1",1)
// Recoil 10
8H19 A 1 Offset(-10, 20)
8H19 A 1 Offset(-6, 28)
8H19 A 1 Offset(-2, 36)
8H19 A 1 Offset(2, 44)
8H19 A 1 Offset(4, 50)
8H19 A 1 Offset(5, 52)
8H19 A 1 Offset(4, 50)
8H19 A 1 Offset(2, 46)
// Offset(0,y) does not clear sx — reset X before Y-only settle.
8H19 A 0 A_WeaponReady(14)
8H19 A 1 Offset(0, 42)
8H19 A 1 Offset(0, 38)
8H19 A 1 Offset(0, 36)
8H19 A 1 Offset(0, 34)
8H19 A 1 Offset(0, 33)
// Hold through voice. 1+8+5+20=34
8H19 A 20 A_WeaponReady(14)
Goto ReadyX

RealFireRage:
// Half of RealFire: 17 real tics under Rage. ReadyX resumes A_WeaponReady.
8H19 A 0 A_PlaySound("voice/MEGABUSTER",0,1.0,0,ATTN_NONE)
8H19 A 0 A_PlaySoundEx("weapons/busters/laserbusterfire3","Weapon")
8H19 A 1 Offset(-13, 15) A_FireCustomMissile("MeguhLaser",0,0,8,0)
8H19 A 0 A_TakeInventory("DecoyFlag1",1)
// Recoil 2 (duration 1 unchanged by CF_DOUBLEFIRINGSPEED)
8H19 A 1 Offset(-4, 40)
8H19 A 1 Offset(6, 54)
// Written 28 → real 14 under Rage. Real total: 1+2+14=17.
8H19 A 28 A_WeaponReady(14)
Goto ReadyX

LegacyOffset:
8H19 A 1 Offset(20, 52)//B
8H19 A 1 Offset(40, 72)//C
8H19 A 1 Offset(-4, 30)//D
8H19 A 1 Offset(-7, 25)//E
8H19 A 1 Offset(-10, 20)//F
8H19 A 1 Offset(-13, 15)//G
loop
}
}


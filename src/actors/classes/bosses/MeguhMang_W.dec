actor MeguhBullet : BasicFastprojectile {
  Translation "192:192=69:69", "198:198=74:74"
  // Translation "192:192=4:4","198:198=215:215"
  DamageType "Meguh"
  Obituary "%o failed to defeat \cfMeguh Mang\c- (%k)!"
  +FORCEXYBILLBOARD
  Damage (50)
  Radius 7
  Height 8
  Speed 150
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    goto Fly
   Fly:
    6P19 A 1  // A_SpawnItemEx("MeguhBulletShotFX",0,0,0,0,0,0,0,1)
    loop
   Death:
    6P19 BCD 2
    stop
  }
}

actor MeguhLaser : BasicProjectile {
  Translation "192:192=4:4", "198:198=39:39"
  DamageType "Meguh"
  Obituary "%o was vanquished by \cnMeguh Mang\c- (%k)'s REAL MEGABUSTER!"
  +THRUACTORS
  +FORCEXYBILLBOARD
  +HEXENBOUNCE
  +CANBOUNCEWATER
  +SKYEXPLODE
  BounceCount 2
  BounceFactor 1.0
  WallBounceFactor 1.0
  ReactionTime 150
  Damage (0)
  Radius 8
  Height 8
  Speed 80
  Scale 12
  States {
   Spawn:
    X_3C A 0 A_SpawnItemEx("MeguhLaser2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_3C A 1 A_CountDown
    X_3C A 0 A_Explode(200, 80, 0, 0, 8)
    loop
  }
}

actor MeguhLaser2 : BasicExplosion {
  DamageType "Meguh"
  Obituary "%o was vanquished by \cnMeguh Mang\c- (%k)'s REAL MEGABUSTER!"
  +FORCEXYBILLBOARD
  ReactionTime 28
  Scale 12
  States {
   Spawn:
    X_3C A 0 A_CountDown
    X_3C AAAAA 1 A_Explode(200, 80, 0, 0, 8)
    loop
  }
}

actor RAWSHTeleport : BasicProjectile {
  Translation "4:4=211:211", "227:227=252:252"
  Obituary "%o wanted to use \ckMeguh Mang\c-'s Rawsh Coil."
  +NOINTERACTION
  +THRUACTORS
  +DONTREFLECT
  +DONTBLAST
  +SKYEXPLODE
  Radius 12
  Height 32
  Scale 2.5
  States {
   Spawn:
    // TFOG A
    RUSH D 0
    RUSH D 6
    RUSH D 0 A_ChangeFlag("NOINTERACTION", 0)
    RUSH DDDDDDDDDD 1 A_CheckFloor("Next")
    goto Next
   Next:
    RUSH D 0
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("RAWSH", 0, 0, 3, 0, 0, velz, 0, 32, 0)
    stop
  }
}


actor RAWSH : ProjSpawnFuncActor {
  Translation "192:192=211:211", "198:198=252:252", "4:4=211:211", "227:227=252:252"
  Obituary "%o wanted to use \ckMeguh Mang\c-'s Rawsh Coil."
  DamageType "Meguh"  // "Rawsh"
  -SOLID
  +NOGRAVITY
  +MISSILE
  +DONTBLAST
  +NOCLIP
  +SKYEXPLODE
  +LOOKALLAROUND
  ReactionTime 150
  // meleerange 80
  Radius 12
  Height 32
  Speed 0
  Scale 2.5
  States {
   Spawn:
    RUSH D 0 A_Jump(256, "Death")
    RUSH D 0 A_ChangeFlag("MISSILE", 0)
    RUSH D 0 A_ChangeVelocity(0, 0, -32, CVF_REPLACE)
    RUSH D 1 A_JumpIf(z - floorz <= 0, "LookHere")
    goto Spawn+2
   LookHere:
    RUSH E 0 A_ChangeFlag("NOCLIP", 0)
    RUSH EF 2
    8P19 A 0 A_ChangeFlag(THRUACTORS, 1)
    8P19 A 0 A_Cleartarget
   PlaceHolder:
    8P19 A 0 A_SpawnItemEx("RAWSHSpringDetect", 0, 0, -26)
    8P19 A 3 A_CountDown
    8P19 A 0 A_JumpIfInventory("RAWSHSpringFlag", 1, "BOOSTEMUP")
    8P19 B 0 A_SpawnItemEx("RAWSHSpringDetect", 0, 0, -26)
    8P19 B 3 A_CountDown
    8P19 B 0 A_JumpIfInventory("RAWSHSpringFlag", 1, "BOOSTEMUP")
    loop
   BOOSTEMUP:
    8P19 C 0 A_PlaySoundEx("S_2/Spring", "Weapon")
    8P19 C 18  // A_GiveToTarget("SpringActivate",1)
    8P19 C 0 A_Explode(600, 192, 0, 0, 16)
    8P19 C 0 A_Die
    goto Death
   Death:
    // TNT1 A 0 A_SpawnItemEx("RushDeath",0,0,0,0,0,0,0,32)
    TNT1 A 0 A_PlaySoundEx("S_Spin/Explode", "Weapon")
    TNT1 A 1 A_SpawnItemEx("RAWSHBoomFx", 0, 0, 16)
    stop
  }
}

actor RAWSHBoomFx : BasicExplosion {
  Translation "192:192=211:211", "198:198=252:252"
  Scale 3.5
  States {
   Spawn:
    6P03 ABCDEFG 2
    stop
  }
}

actor RAWSHSpringDetect : BasicProjectile {
  DamageType "Rawsh"
  Obituary "%o wanted to use \ckMeguh Mang\c-'s Rawsh Coil."
  +THRUGHOST
  +NOGRAVITY
  +DONTSPLASH
  +DONTBLAST
  +HITTRACER
  /// //////HITOWNER
  Damage (250)
  Radius 46
  Height 90
  Speed 0
  Scale 2.5
  States {
   Spawn:
    TNT1 A 2
    stop
   Crash:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("RAWSHSpringFlag", 1)
    TNT1 A 1 A_JumpIf(CallACS("uh_istracerplayer"), "GiveSpring")
    stop
   GiveSpring:
    TNT1 A 1 A_GiveInventory("RAWSHSpringDetect_P", 1, 8)
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor RAWSHSpringDetect_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 140, 0, 0)
    goto End
  }
}

actor RAWSHSpringFlag : Once {}

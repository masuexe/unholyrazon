actor RAWSH : ProjSpawnFuncActor
{
Translation "192:192=211:211", "198:198=252:252", "4:4=211:211", "227:227=252:252"
Obituary "%o wanted to use \ckMeguh Mang\c-'s Rawsh Coil."
damagetype "Meguh"//"Rawsh"
-SOLID
+NOGRAVITY
+MISSILE
+DONTBLAST
+NOCLIP
+SKYEXPLODE
+LOOKALLAROUND
reactiontime 150
//meleerange 80
Radius 12
Height 32
speed 0
scale 2.5
states
{
Spawn:
RUSH D 0 A_Jump(256,"Death")
RUSH D 0 A_ChangeFlag("MISSILE",0)
RUSH D 0 A_ChangeVelocity(0, 0, -32, CVF_REPLACE)
RUSH D 1 A_JumpIf(z-floorz<=0, "LookHere")
Goto Spawn+2
LookHere:
RUSH E 0 A_ChangeFlag("NOCLIP",0)
RUSH EF 2
8P19 A 0 A_ChangeFlag(THRUACTORS,1)
8P19 A 0 A_Cleartarget
PlaceHolder:
8P19 A 0 A_SpawnItemEx("RAWSHSpringDetect",0,0,-26)
8P19 A 3 A_CountDown
8P19 A 0 A_JumpIfInventory("RAWSHSpringFlag",1,"BOOSTEMUP")
8P19 B 0 A_SpawnItemEx("RAWSHSpringDetect",0,0,-26)
8P19 B 3 A_CountDown
8P19 B 0 A_JumpIfInventory("RAWSHSpringFlag",1,"BOOSTEMUP")
loop
BOOSTEMUP:
8P19 C 0 A_PlaySoundEx("S_2/Spring","Weapon")
8P19 C 18 //A_GiveToTarget("SpringActivate",1)
8P19 C 0 A_Explode(600,192,0,0,16)
8P19 C 0 A_Die
Goto Death
Death:
//TNT1 A 0 A_SpawnItemEx("RushDeath",0,0,0,0,0,0,0,32)
TNT1 A 0 A_PlaySoundEx("S_Spin/Explode","Weapon")
TNT1 A 1 A_SpawnItemEx("RAWSHBoomFx",0,0,16)
stop
}
}


Goto ReadyX

Reload:
8H03 A 0 A_JumpIfInventory("LookAtSueFly",1,"Fall")
8H03 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Jump")
8H03 A 2 A_GiveInventory("UnholyBossAmmo200", 2)
goto ReadyX
Jump:
8H03 A 0 A_JumpIfInventory("SueMagicFlag1",1,"No")
8H03 A 0 A_GiveInventory("SueMagicFlag1",1)
8H03 A 2
goto ReadyX
Fall:
8H03 A 0 A_GiveInventory("SueMagicFlag2",1)
8H03 A 2
goto ReadyX
No:
8H03 A 2
goto ReadyX
}

//Not exactly the most interesting
actor Sue_BlizzardCloseBoom : BasicExplosion
{
Translation "202:202=4:4","199:199=203:203"
damagetype "SueIce" //SueBlizzard
Obituary "$OB_BOSS02A" //Filler
Scale 2.5
States
{
Spawn: //64 radius
TNT1 A 0
//TNT1 A 2 A_Explode(250,128,0,0,64) //10 //15 damage
X_1D A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
TNT1 A 0 A_Explode(250,256,0,0,128) //10 //15 damage
Y_1D BCDEFGHIJKLMN 1 
stop //Adjust explosion radius to be justified or logical.
}
}


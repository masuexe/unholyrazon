actor FreezingHellBlastingShot : BasicProjectile
{
Translation "192:192=203:203","198:198=206:206"
damagetype "SueIce"
Obituary "%o was completely frozen today by \cmElitist \cnSue \c-(%k)!"
Damage (random(230, 355))
Height 12
Radius 12
Speed 80
Scale 5
States
{
Spawn:
TMFX B 0
TMFX B 1 A_SpawnItemEx("FreezingHellBlastingShotFX",0,0,0,0,0,0,0,1)
wait
Death:
TNT1 A 0
TNT1 A 0 A_Explode(random(385,595),225,0,0,16)
TNT1 AAAA 0 A_SpawnItemEx("FrozenShotCounterBoss",0,0,8,random(-20,20),random(-20,20),random(0,20),0,0,0)
TNT1 AAAAAAAA 0 A_SpawnItemEx("SueBossColdBit",0,0,8,random(-20,20),random(-20,20),random(0,20),0,0,0)
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
X_8B ABCDEF 2
stop
}
}


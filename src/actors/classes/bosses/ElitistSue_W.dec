8H03 C 0 A_PlaySoundEx("weapon/superboost","Weapon")
8H03 C 1 A_FireCustomMissile("Sue_ChillingBreeze",random(-8,8),0,8,0,0,random(-4,4))
8H03 CCC 1 A_Refire("ContinueChecker")
Goto EndedFire
ContinueChecker:
8H03 C 0 A_JumpIfInventory("UnholyBossAmmo200",3,"ContinueFire")
8H03 C 1
Goto EndedFire
ContinueFire:
8H03 C 0 A_TakeInventory("UnholyBossAmmo200",3)
8H03 C 0 A_PlaySoundEx("weapon/superboost","Weapon")
8H03 C 1 A_FireCustomMissile("Sue_ChillingBreeze",random(-8,8),0,8,0,0,random(-4,4))
8H03 C 1 A_Refire("ContinueChecker")
goto EndedFire
EndedFire:
//8H03 C 2 //A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
8H03 C 1 A_ClearRefire 
8H03 CB 1 A_TakeInventory("UnholyBossAmmo200",4)
8H03 BA 1 A_TakeInventory("UnholyBossAmmo200",3) //1
8H03 AA 1 A_TakeInventory("UnholyBossAmmo200",2) //1
8H03 AA 1 A_TakeInventory("UnholyBossAmmo200",1) //1
8H03 A 2 //10
Goto ReadyX
//
//
//

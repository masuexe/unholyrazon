actor ChillingMistBoss : BasicClientSide
{
Translation "192:192=4:4","198:198=203:203"
renderstyle add
alpha 0.8
reactiontime 5//20
Radius 8
Height 8
scale 1.2 //1.0
states
{ //A_SpawnItemEx("SueBossFX2_REAL",random(32,-32),random(32,-32),random(32,-32),0,0,0,0,1)
Spawn: //8P03 CDAB
8P03 A 0 ThrustThingZ(0,1,0,1)
8P03 A 2 A_SetTranslucent(0.7,0)
8P03 A 0 A_SpawnItemEx("SueBossFX2_REAL",random(32,-32),random(32,-32),random(32,-32),0,0,0,0,1)
8P03 B 0 ThrustThingZ(0,1,0,1)
8P03 B 2 A_SetTranslucent(0.6,0)
8P03 C 0 ThrustThingZ(0,1,0,1)
8P03 C 2 A_SetTranslucent(0.7,0)
8P03 A 0 A_SpawnItemEx("SueBossFX2_REAL",random(32,-32),random(32,-32),random(32,-32),0,0,0,0,1)
8P03 D 0 ThrustThingZ(0,1,0,1)
8P03 D 2 A_SetTranslucent(0.8,0)
8P03 D 0 A_CountDown
loop
Death:
TNT1 A 0
8P03 CDAB 2 A_Fadeout(0.05)
stop
}
}





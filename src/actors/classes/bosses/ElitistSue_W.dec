TNT1 AA 2 A_GiveInventory("SueBlizzard_Rage_P",1)
//Isn't it cute that this was cut out for being intense as is? Hah, well...
/*TNT1 A 0 A_SpawnItemEx("SueBlizzard_HailSpawner")
TNT1 AAAAAA 2 A_GiveInventory("SueBlizzard_Rage_P",1)

8H00 A 0 Radius_Quake(6,35,0,50,0) //
8H00 C 0 A_SpawnItemEx("ZangiefDustFX",0,0,0,0,0,0,0,1,0) //
TNT1 A 0 A_SpawnItemEx("Sue_BlizzardCloseBoom",32,0,8,0,0,0,0,0)
TNT1 A 0 A_SpawnItemEx("SueBlizzard_HailSpawner")
TNT1 A 2 A_GiveInventory("SueBlizzard_Rage_P",1)

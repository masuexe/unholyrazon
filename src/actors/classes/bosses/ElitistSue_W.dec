loop
ReadyXZ:
8H03 A 0 A_JumpIfInventory("SueMagicFlag1",1,"SuePreparesToFly")
8H03 A 2 A_WeaponReady(WRF_ALLOWRELOAD)
8H03 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop

//Base buster offset is 32 ~ 33

States
{

/*
Add me
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
*/

Spawn:
8H03 [ 1
wait

Ready:
8H03 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)

actor ElitistSue_W : BaseUnholyBossWep
{
Tag "$TAG_Boss003_W"
Obituary "%o was frozen by \cmElitist \cnSue\c- (%k)!"
Inventory.Pickupmessage "\cnLust."
weapon.ammotype "UnholyBossAmmo200"

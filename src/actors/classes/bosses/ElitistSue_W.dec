8H03 CBAAAAAAAA 2 A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX
IAMFULLYCHARGED:
8H03 A 0 A_TakeInventory("LuckyEnergyAmmo",1500)
8H03 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H03 BC 2
8H03 C 36
//8H03 C 0 A_GiveInventory("Shocked",1)
//8H03 C 0 ThrustThingZ(0,25,0,0)
//8H03 C 0 A_Recoil(50)
8H03 C 0 A_ChangeVelocity(-Cos(pitch)*55,0,sin(pitch)*45,CVF_RELATIVE)
8H03 C 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
8H03 C 0 A_FireCustomMissile("FreezingHellBlastingShot",0,0,8,0)
8H03 CB 2
8H03 A 35
Goto ReadyX
AltFire: //Ammo consumpiton 2 //4
8H03 B 0 A_JumpIfInventory("LookAtSueFly",1,"FlyStop")
8H03 B 0 A_JumpIfInventory("UnholyBossAmmo200",200,"AlterFires")
8H03 A 1
Goto ReadyX //Freezecracker FX
AlterFires:
8H03 B 0 A_JumpIfInventory("LookAtSueFly",1,"FlyStop")
8H03 B 2 //A_GiveInventory("UnholyBossAmmo200",1)
8H03 B 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)

actor HellBot_W_ScriptBar : ScriptBar {}

actor HellBot_W : BaseUnholyBossWep
{
Tag "$TAG_Boss100_W"
Inventory.Pickupmessage "\cgWHEN ALL SINS ARE COMBINED, ONLY HE SHALL APPEAR."
Obituary "%o was destroyed by \c[UB100]HellBot\c- (%k)."
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8I00 [ 1
wait

Ready:
8I00 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8I00 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HELLBOT_DYE)
8I00 A 0 ACS_NamedExecuteWithResult("uh_BossMorph", 100,6666,0)
8I00 A 0 A_GiveInventory("HellbotBossHelper_P",1)
8I00 A 0 A_GiveInventory("StopWhiningForLightKTHXBAI",1)
// 8I00 A 0 A_GiveInventory("HellBotItem",1)
8I00 A 0 A_GiveInventory("LesserHellishArmor",1)
goto ReadyX
ReadyX:
	8I00 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ReadyX2")
	8I00 A 0 A_JumpIfInventory("UnholyBossAmmo200",100,"ReadyX2")
	8I00 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,2)
	8I00 A 0 A_WeaponReady(8)
	goto ReadyXGive
	8I00 A 0 A_WeaponReady(8+16)
ReadyXGive:
	8I00 A 2 A_GiveInventory("UnholyPower1500",6)
	8I00 A 0 A_GiveInventory("HellbotInvisCheck_P",1)
	goto ReadyX
ReadyX2:
	8I00 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,2)
	8I00 A 0 A_WeaponReady
	goto ReadyX2Give
	8I00 A 0 A_WeaponReady(16)
ReadyX2Give:
	8I00 A 2 A_GiveInventory("UnholyPower1500",6)
	8I00 A 0 A_GiveInventory("HellbotInvisCheck_P",1)
	goto ReadyX2

Altfire:
8I00 A 0 A_JumpIfInventory("UnholyPower1500",1500,"ShunGokuSatsu")
8I00 A 0 A_JumpIfInventory("UnholyBossAmmo200",100,"Helltaforwards")
Goto ReadyX
Helltaforwards:
8I00 B 0 A_TakeInventory("UnholyBossAmmo200",100)
8I00 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I00 B 0 ThrustThingZ(0,5,0,0)
8I00 B 0 A_Stop
8I00 B 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8I00 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8I00 B 0 A_Recoil(-45)
8I00 BBBBBBBBBBBBBBBB 1 A_SpawnItemEx("HellbotEvadingMoveBoss",0,0,0,0,0,0,0,1)
8I00 B 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8I00 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8I00 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8I00 A 5
Goto ReadyX

ShunGokuSatsu:
8I00 B 0 A_TakeInventory("UnholyPower1500",1500)
8I00 B 0 A_TakeInventory("DecoyFlag1")
8I00 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I00 B 0 A_ChangeVelocity(46*cos(pitch),0,46*-sin(pitch),3)
8I00 B 0 A_SetArg(4,momz)
8I00 B 0 A_SetArg(3,momy)
8I00 B 0 A_SetArg(2,momx)
//8I00 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8I00 BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 A_GiveInventory("HellBotRage_P",1)
//8I00 B 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8I00 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Goto ReadyX


Fire:
8I00 A 0 A_Jump(256,"Set1","Set2","Set3","Set4","Set5")
goto Set1
Set1:
8I00 K 2
8I00 L 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 L 0 A_FireCustomMissile("DLVBlastHell",0,0,-8,0)

8I00 LM 2
8I00 M 6
8I00 LK 2
goto Phase2
Phase2:
8I00 E 2
8I00 G 0 A_GiveInventory("Shocked",1)
8I00 G 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I00 G 0 A_FireCustomMissile("NapalmPowerShotHell",0,0,8,0)
8I00 FG 2
8I00 G 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I00 G 0 A_FireCustomMissile("NapalmPowerShotHell",0,0,8,0)
8I00 G 4
8I00 G 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I00 G 0 A_FireCustomMissile("NapalmPowerShotHell",0,0,8,0)
8I00 G 4
8I00 GFE 2
goto Phase3
Phase3:
8I00 K 0 ThrustThingZ(0,42,0,0)
8I00 K 2
8I00 L 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 L 0 A_FireCustomMissile("ForceBlastShotHell",0,0,-8,0)
8I00 LMM 2
8I00 MMLK 2
goto Phase4
Phase4:
8I00 E 0 A_Recoil(-40)
8I00 EF 2
8I00 G 0 A_PlaySoundEx("weapon/slashclaw","Weapon")
8I00 G 0 A_FireCustomMissile("MeleeClashHell",0,0,8,0)
8I00 G 6
8I00 GFE 2
goto Phase5
Phase5:
8I00 K 2
8I00 L 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
8I00 L 0 A_FireCustomMissile("TripleCrackerShotHell",15,0,-8,6)
8I00 LMM 2
8I00 M 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
8I00 M 0 A_FireCustomMissile("TripleCrackerShotHell",0,1,-8,0)
8I00 M 6
8I00 M 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
8I00 M 0 A_FireCustomMissile("TripleCrackerShotHell",-15,0,-8,6)
8I00 M 6
8I00 MLKA 2
goto ReadyX
Set2:
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 ThrustThingZ(0,60,0,0)
8I00 BC 6
goto Swoop
Swoop:
8I00 D 0 A_JumpIfInventory("DecoyFlag1",1,"SwoopingEnd")
8I00 D 1
8I00 D 0 A_Recoil(-70)
8I00 D 0 ThrustThingZ(0,7,1,1)
8I00 D 0 A_GiveInventory("DecoyFlag1")
8I00 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8I00 D 0 A_PlaySoundEx("weapon/topspin","Weapon")
8I00 D 0 A_GunFlash
SwoopingSpin:
8I00 D 0 A_SpawnItemEx("DecoyCrasherHell",0,0,32,0,0,0,0,33)
8I00 D 0 A_SpawnItemEx("DecoyCloseFuckRangeHell",0,0,8,random(-20,20),random(-20,20),random(0,20),0,0,0)
8I00 D 0 A_SetAngle(angle-10.0)//ACS_ExecuteAlways(990,0,1)
8I00 D 1 A_JumpIfInventory("DecoyFlag2",1,"SwoopingEnd")
loop
SwoopingEnd:
8I00 D 0 A_TakeInventory("DecoyFlag2",1)
8I00 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8I00 D 0 A_TakeInventory("DecoyFlag1",1)
8I00 D 1
8I00 CBA 6
Goto FaggotRageSpin
Flash:
TNT1 AA 20
TNT1 A 0 A_GiveInventory("DecoyFlag2",1)
stop
FaggotRageSpin:
8I00 B 2 A_GiveInventory("WeaponCharge",9)
goto FaggotRageSpinL
FaggotRageSpinL:
8I00 I 0 A_TakeInventory("WeaponCharge",1)
8I00 I 0 A_GiveInventory("Shocked",1)
8I00 I 0 A_PlaySoundEx("weapon/pshot","Weapon")
8I00 I 0 A_FireCustomMissile("NapalmPowerShotHell",random(-10,10),0,8,0,0,random(-5,5))
8I00 I 4
8I00 O 0 A_PlaySoundEx("weapon/pshot","Body")
8I00 O 0 A_FireCustomMissile("NapalmPowerShotHell",random(-10,10),0,-8,0,0,random(-5,5))
8I00 O 4
8I00 A 0 A_JumpIfInventory("WeaponCharge",1,"FaggotRageSpinL")
goto FaggotRageSpinE
FaggotRageSpinE:
8I00 BA 5
goto ReadyX
Set3:
8I00 B 2 A_GiveInventory("WeaponCharge",3)
goto Set3L
Set3L:
8I00 A 0 A_TakeInventory("WeaponCharge",1)
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H0",0,0,8,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H0",0,0,-8,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H1",0,0,8,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H1",0,0,-8,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H2",0,0,8,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H2",0,0,-8,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H3",0,0,8,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I00 A 0 A_FireCustomMissile("RapistShot1Hell_H3",0,0,-8,0)
8I00 O 4

8I00 A 0 A_JumpIfInventory("WeaponCharge",1,"Set3L")
goto Set3E
Set3E:
8I00 BA 6
goto AwShitNOTOP
AwShitNOTOP:
8I00 E 2
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",0,0,8,0)
8I00 FGG 2
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",15,0,8,0)
8I00 G 6
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",-15,0,8,0)
8I00 G 6
8I00 F 2
8I00 A 0 A_Recoil(-40)
8I00 EB 2
8I00 A 0 A_PlaySoundEx("weapon/slashclaw","Weapon")
8I00 A 0 A_FireCustomMissile("MeleeClashHell",0,0,0,0)
8I00 NMM 2
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",0,0,-8,0)
8I00 M 6
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",15,0,-8,0)
8I00 M 6
8I00 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8I00 A 0 A_FireCustomMissile("ForceBlastShotHell",-15,0,-8,0)
8I00 M 6
8I00 LK 3
goto ReadyX
Set4:
8I00 B 2
8I00 B 0 ThrustThingZ(0,40,0,0)
8I00 BC 5
8I00 D 0 ThrustThingZ(0,-60,0,0)
8I00 D 1 A_GiveInventory("Hellbot_FloorQuake_P",1)
8I00 DDDDDD 0 A_FireCustomMissile("DecoyRapeCrushHell",0,0,0,0)
8I00 D 6
8I00 CBA 2
goto ReadyX
Set5:
8I00 B 2
8I00 C 2 A_GiveInventory("WeaponCharge",10)

goto Set5L
Set5L:
8I00 D 0 A_TakeInventory("WeaponCharge",1)
8I00 D 0 A_PlaySoundEx("weapon/gravityhold","Weapon")
8I00 D 0 A_FireCustomMissile("AWFUCKGRAVITYHell",0,1,0,0)
8I00 D 2
8I00 D 0 A_JumpIfInventory("WeaponCharge",1,"Set5L")
goto Set5E
Set5E:
8I00 D 4
8I00 CBAA 2
goto SafetyFirst
SafetyFirst:
8I00 B 2
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",0,0,0,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",45,0,0,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",90,0,0,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",135,0,0,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",180,0,0,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",225,0,0,0)
8I00 O 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",270,0,0,0)
8I00 I 4
8I00 A 0 A_PlaySoundEx("weapon/crackermine","Weapon")
8I00 A 0 A_FireCustomMissile("RapeTasticExplosiveHell",315,0,0,0)
8I00 O 4
8I00 BA 5
goto ReadyX


Reload:
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Jump")
goto ReadyX
Jump:
//TNT1 A 0 A_PlaySoundEx("misc/difsbounce","Item")
TNT1 A 0 A_GiveInventory("HellbotJellyJellyJellyInvisOn_P",1)
TNT1 A 0 A_SpawnItemEx("HellBotFakeOutBody")
TNT1 A 0
goto ReadyX
}
}

actor HellBotRage_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("HellbotComboPoison",0,0,0,0)
TNT1 A 0 A_ChangeVelocity(args[2],args[3],args[4],CVF_REPLACE)
stop
}
}

actor HellBotFakeOutBody : BasicClientSide
{
Translation "192:192=186:186","198:198=191:191"
RenderStyle "translucent"
+FORCEYBILLBOARD
Alpha 0.70
States
{
Spawn:
8A08 A 0
8A08 A 5
8A08 A 1 A_Fadeout(0.1)
Goto Spawn+2
}
}


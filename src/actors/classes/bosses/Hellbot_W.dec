actor HellbotPoisonHit : Basic_PainTID_H
{
States
{
Check:
TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 6100, PSN_SET_TO, 1) > 0, "DoT")
stop
DoT:
TNT1 A 0 A_GiveInventory("HellbotPoisonFX_P",1,AAPTR_TRACER)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists",8),"Death")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists",8),"Death")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists",8),"Death")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists",8),"Death")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists",8),"Death")
TNT1 A 0 A_Warp(AAPTR_TRACER,0,0,28,0,WARPF_NOCHECKPOSITION)
TNT1 A 0 A_SpawnItemEx("HellBotPoisonExplosion")
TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 6100, PSN_ADJUST, -1) <= 0, "Death")
loop
}
}
actor HellbotPoisonFX_P : CustomInventory {
	States {
		Pickup:
			TNT1 A 0 A_SpawnItemEx("HellbotPoisonFX_H")
			stop
	}
}
actor HellbotPoisonFX_H : BasicHelper {
	reactiontime 175
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Warp(AAPTR_TARGET,0,0,28,0,WARPF_NOCHECKPOSITION)
			TNT1 A 1 A_SpawnItemEx("HellbotPoisonFX",random(-32,32),random(-32,32),random(0,64),0,0,8)
			TNT1 A 0 A_Countdown
			loop
	}
}

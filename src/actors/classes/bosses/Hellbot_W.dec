actor HellbotJellyJellyJellyInvisOn_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("CloakFlag",1)
TNT1 A 0 A_GiveInventory("HellbotInvisAlphaGiver",1)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer",0,true)//mmrf maps
TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer",0,true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer",0,true)
stop
}
}

actor HellbotJellyJellyJellyInvisOff_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("CloakFlag",1,1)
stop
TNT1 A 0 A_TakeInventory("CloakFlag")
TNT1 A 0 A_TakeInventory("CloakFlagDelay")
TNT1 A 0 A_TakeInventory("HellbotInvisAlpha")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer",0,false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer",0,false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer",0,false)
stop
}
}

actor HellbotInvisCheck_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("CloakFlag",1,1) goto No
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",1,"Countdown")
TNT1 A 0 A_GiveInventory("HellbotJellyJellyJellyInvisOff_P")
stop
Countdown:
TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 1)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo200", 1, 1)
stop
No:
TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 1)
stop
}
}

actor HellbotBossHelper_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("IsGonnaBeFake",1,"Pickup1")
goto Pickup2
Pickup1:
TNT1 A 0
stop
Pickup2:
TNT1 A 0 A_SpawnItemEx("HellbotBossHelper")
stop
}
}
actor HellbotBossHelper : BasicHelper
{
States
{
Spawn:
TNT1 A 1
TNT1 A 1
TNT1 A 1
goto Spawn2
Spawn2:
TNT1 A 0
TNT1 A 0 A_JumpIfInTargetInventory("IsDead",1,"TheEndX")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "TheEnd")
TNT1 A 1
loop
//PowerEvilArmor
TheEnd:
TNT1 A 1
stop
TheEndX:
TNT1 A 0
TNT1 A 1 ACS_NamedExecuteAlways("ub_InitiateUltraBoss",0,400)
TNT1 A 10
stop
}
}

Actor HellbotComboPoison : BasicExplosion

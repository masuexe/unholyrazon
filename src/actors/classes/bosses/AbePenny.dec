actor AbePenny : BossBase {
  Player.ScoreIcon "UB301MUG"
  Player.SoundClass "abepenny"
  Player.ForwardMove 0.98, 0.98
  Player.SideMove 0.98, 0.98
  Player.JumpZ 12
  Player.MaxHealth 3765
  Health 3765
  Player.MorphWeapon "AbePenny_W"
  States {
   Spawn:
    8D01 A 0
    8D01 B 1
    8D01 A 1
    goto Spawn+2
   See:
    8D01 BCDE 5
    goto Spawn
   Missile:
    8D01 F 5
    8D01 G 4
    goto Spawn+2
   ClassPain:
    8D01 HHHHHHHHHH 2 A_SpawnItemEx("AbeLosesMoneyOnHitFX", random(4, 16), 0, random(8, 48), random(3, 18), random(-2, 2), random(4, 14), random(0, 35) * 10, 0)  // A_SpawnItemEx("PainFX_UH",-5,0,3,0,0,0)
    8D01 H 1
    goto SuperSpawn
   ClassDeath:
    8D01 H 0
    goto MegamanDeath
  }
}

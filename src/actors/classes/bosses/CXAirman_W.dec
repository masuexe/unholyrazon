actor CXAirMan_W_ScriptBar : ScriptBar {}
actor CXAirMan_W : BaseUnholyBossWep
{
Tag "$TAG_Boss101_W"
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
Obituary "%o cannot be literally air like %k."
States
{
Spawn:
8I01 [ 1
wait

Deselect:
// 8I01 A 0 A_ChangeFlag("CANTSEEK",0)
// 8I01 A 0 A_SetTranslucent(1.0,0)
// 8I01 A 0 A_TakeInventory("DecoyFlag1")
// 8I01 A 0 A_TakeInventory("CXAirManFlag")
8I01 A 0
goto DeselectSwap
Select:
8I01 A 0
goto SelectSwap

Ready:
8I01 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
8I01 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, CXAIRMAN_DYE)
// 8I01 A 0 A_TakeInventory("DecoyFlag1")
goto ReadyX
ReadyX:
8I01 A 0 A_JumpIfInventory("CXAirManFlag", 1, "ReadyTake")
8I01 A 2 A_GiveInventory("CXAirMan_Ready_P")
// 8I01 A 0 A_GiveInventory("CXAirManFlag",1)
loop
// ReadyInvis:
// 8I01 A 0 A_GiveInventory("CXAirManFlashOn_P")
// 8I01 A 0 A_SetTranslucent(0.0,0)
// goto ReadyX2
ReadyTake:
8I01 A 2 A_GiveInventory("CXAirMan_Ready_P")
8I01 A 0 A_TakeInventory("CXAirManFlag", 1)
8I01 A 0 A_JumpIfInventory("CXAirManFlag", 1, "ReadyTake")
8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
goto ReadyX

Fire:
8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
8I01 A 0 A_PlaySoundEx("misc/devilfire","Weapon")
8I01 A 0 A_FireCustomMissile("CXAirShot_H",0,0,8,0)
8I01 BCAAAA 2 A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX

Altfire:
8I01 A 0 A_JumpIfInventory("UnholyPower1500",1500,"AntiPowerDamage")
goto Altfire2
Altfire2:
// 8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
// 8I01 A 0 A_SetTranslucent(1.0,0)
8I01 A 0 A_PlaySoundEx("weapons/mm2/leafshieldactive_short", "Weapon")
8I01 A 0 A_FireCustomMissile("CXAirShotX",frandom(-2,2),0,0,0)

8I01 A 1 ACS_NamedExecuteWithResult("rz_AirManInvis")
8I01 A 0 A_GiveInventory("CXAirManFlag", 50)
// goto Altfire2End
// Altfire2End:
8I01 BCA 2 A_GiveInventory("UnholyBossAmmo200", 1)
Goto ReadyX
AntiPowerDamage:
8I01 C 0 A_GiveInventory("CXAirManFlashOff_P")
8I01 C 0 A_SetTranslucent(1.0,0)
goto AntiPowerDamageL
AntiPowerDamageL:
8I01 C 0 A_TakeInventory("UnholyPower1500",150)
8I01 C 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I01 C 0 A_SpawnItemEx("AirBrgWall",0,0,32,15,0,0)
8I01 CC 0 A_SpawnItemEx("AirBrgWall",0,0,32,15,random(-16,-16),random(0,0))
8I01 CC 0 A_SpawnItemEx("AirBrgWall",0,0,32,15,random(-32,32),random(-8,16))
8I01 CC 0 A_SpawnItemEx("AirBrgWall",0,0,32,15,random(-64,64),random(-16,32))
8I01 CBA 5
TNT1 A 0 A_JumpIfInventory("UnholyPower1500",150,"AntiPowerDamageL")
8I01 C 25
8I01 BA 3
Goto ReadyX

Reload:
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"Jump")
goto ReadyX
Jump:
TNT1 A 0 A_TakeInventory("UnholyBossAmmo200",200)
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
8I01 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I01 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
8I01 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8I01 A 24 A_GiveInventory("CXAirManFlashOn_P")
8I01 A 0 ACS_NamedExecuteWithResult("rz_AirManWarp")  // A_GiveInventory("UH_ArtiTeleport_P")
8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
8I01 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8I01 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
8I01 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
goto ReadyX
// AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-16,-16),random(0,0))
// AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-32,32),random(-8,16))
// AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-64,64),random(-16,32))
// TNT1 A 0 A_GiveInventory("NoTeleportFX_Flag",1)
// TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P")
// TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
// TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,60)
// TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,-60)
// TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,120)
// TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,-120)
// TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,180)
// 8I01 A 1 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,0)
// goto ReadyX
}
}

actor CXAirManFlag : Inventory
{
inventory.amount 1
inventory.maxamount 50
}

actor CXAirManAltFlag : Inventory
{
inventory.amount 1
inventory.maxamount 6
}

actor CXAirMan_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CXAirManAltFlag", 0, "PickupNoAlt")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_GiveInventory("CXAirMan_Ready0_P")
    stop
   PickupNoAlt:
    TNT1 A 0 A_GiveInventory("CXAirMan_Ready8_P")
    stop
  }
}
actor CXAirMan_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 5)
    stop
  }
}
actor CXAirMan_Ready8_P : CXAirMan_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor CXAirManFlashOn_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("DecoyFlag1")
TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
TNT1 A 0 A_GiveInventory("UH_00_AlphaPowerGiver")
TNT1 A 0 A_TakeInventory("UH_10_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_20_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_30_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_40_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_50_AlphaPower")
TNT1 A 0 A_JumpIfInventory("CXAirManAltFlag", 0, "End")
TNT1 A 0 A_SpawnItemEx("CXAirManTeleportFX2_Helper",0,0,32,0,0,0,0,1)
stop
End:
TNT1 A 0
stop
}
}

actor CXAirManFlashOff_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("DecoyFlag1",1,"Pickup2")
TNT1 A 0 A_JumpIfInventory("UH_10_AlphaPower",1,"Pickup3")
TNT1 A 0 A_JumpIfInventory("UH_20_AlphaPower",1,"Pickup3")
TNT1 A 0 A_JumpIfInventory("UH_30_AlphaPower",1,"Pickup3")
TNT1 A 0 A_JumpIfInventory("UH_40_AlphaPower",1,"Pickup3")
TNT1 A 0 A_JumpIfInventory("UH_50_AlphaPower",1,"Pickup3")
goto End
Pickup2:
TNT1 A 0 A_TakeInventory("DecoyFlag1")
TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
TNT1 A 0 A_TakeInventory("UH_00_AlphaPower")
TNT1 A 0 A_TakeInventory("CXAirManAltFlag", 1)
TNT1 A 0 A_SpawnItemEx("CXAirManTeleportFX_Helper",0,0,32,0,0,0,0,1)
goto End
Pickup3:
TNT1 A 0 A_TakeInventory("UH_10_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_20_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_30_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_40_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_50_AlphaPower")
TNT1 A 0 A_TakeInventory("CXAirManAltFlag", 1)
TNT1 A 0 A_SpawnItemEx("CXAirManTeleportFX_Helper",0,0,32,0,0,0,0,1)
goto End
End:
TNT1 A 0 A_TakeInventory("CXAirManFlag", 1)
stop
}
}


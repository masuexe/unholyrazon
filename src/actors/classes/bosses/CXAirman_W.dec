actor CXAirManTeleportFX_Helper : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
TNT1 A 2 A_SpawnItemEx("CXAirManTeleportFX",0,0,0,0,0,0,0,1)
stop
}
}

actor CXAirManTeleportFX : BasicClientSide
{
States
{
Spawn:
8Q01 DEF 4
stop
}
}

actor CXAirManTeleportFX2_Helper : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
TNT1 A 2 A_SpawnItemEx("CXAirManTeleportFX2",0,0,0,0,0,0,0,1)
stop
}
}

actor CXAirManTeleportFX2 : BasicClientSide
{
States
{
Spawn:
8Q01 FEDD 2
stop
}
}

actor CXAirShot_H : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 1)
TNT1 A 0 A_SpawnItemEx("CXAirShot",0,0,0,random(4,60)*cos(-pitch),0,random(20,60)*sin(-pitch)+frandom(-1,1),random(-15,15),0)
TNT1 A 0 A_SpawnItemEx("CXAirShot",0,0,0,random(4,60)*cos(-pitch),0,random(20,60)*sin(-pitch)+frandom(-1,1),random(-15,15),0)
TNT1 A 0 A_SpawnItemEx("CXAirShot",0,0,0,random(4,60)*cos(-pitch),0,random(20,60)*sin(-pitch)+frandom(-1,1),random(-15,15),0)
TNT1 A 0 A_SpawnItemEx("CXAirShot",0,0,0,random(4,60)*cos(-pitch),0,random(20,60)*sin(-pitch)+frandom(-1,1),random(-15,15),0)
stop
}
}

actor CXAirShot : BasicProjectile
{
damagetype "AirCX"
Obituary "%o was shot down by %k's Spread Buster."
+RIPPER
Damage (75)
radius 9
height 9
Speed 54
scale 2.5
States
{
Spawn:
BASB A 2
loop
Death:
BASB AAAAAA 1 A_Fadeout
stop
}
}

actor CXAirShotX : BasicProjectile
{
Translation "192:192=4:4", "198:198=74:74"
var int user_P;
+RIPPER
+NOEXPLODEFLOOR
Radius 10
Height 12
damage (85+user_P)
damagetype "AirCX"
Obituary "%o was blown away by %k's Air Shooter."
speed 45
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Recoil(-4)
TNT1 A 0 A_JumpIf(momz>0,"SpawnDown")
goto SpawnUp
SpawnUp:
TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
8Q01 AABBCC 1 ThrustThingZ(0,4,0,1)
goto SpawnUp+1
SpawnDown:
TNT1 A 0 A_setUserVar("user_P",20)
TNT1 A 0 A_ChangeFlag("NOEXPLODEFLOOR",0)
TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
8Q01 AABBCC 1 ThrustThingZ(0,4,1,1)
goto SpawnDown+3
Death:
X_2B GHIJ 2
stop
}
}

actor AirBrgWall : BasicProjectile
{
Translation "192:192=4:4", "198:198=74:74"
damagetype "AirCX"
Obituary "%o was blown away by %k's Air Shooter Barrage."
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
+SKYEXPLODE
damage (50)
Radius 6
Height 7
speed 0
scale 3.0
States
{
Spawn:
8Q01 A 0
8Q01 AABBCC 1 A_Recoil(3)
8Q01 A 0 A_Stop
8Q01 ABC 2
8Q01 A 0 A_SpawnItemEx("AirBrg")
stop
Death:
X_2B GHIJ 3
stop
}
}

actor AirBrgWall2 : AirBrgWall
{
Obituary "%o was blown away by %k's Air Shooter."
damage (30)
Scale 2.5
States
{
Spawn:
8Q01 A 0
8Q01 AABBCC 1 A_Recoil(2)
8Q01 A 0 A_Stop
8Q01 ABC 2
8Q01 A 0 A_SpawnItemEx("AirBrg2")
stop
}
}

actor AirBrg : BasicProjectile
{
Translation "192:192=4:4", "198:198=74:74"
damagetype "AirCXFling"
Obituary "%o was blown away by %k's Air Shooter Barrage."
+SEEKERMISSILE
ReactionTime 75
Damage (50)
Radius 6
Height 7
Speed 42
scale 3.5
States
{
Spawn:
8Q01 ABC 2 A_SeekerMissile(2,10,SMF_LOOK,55,10)
8Q01 A 0 A_Countdown
loop
Death:
X_2B GGHHIIJJ 1 A_Fadeout
stop
}
}

actor AirBrg2 : AirBrg
{
Obituary "%o was blown away by %k's Air Shooter."
ReactionTime 45
Damage (30)
scale 3.0
}

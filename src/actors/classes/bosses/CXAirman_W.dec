actor CXAirMan_W_ScriptBar : ScriptBar {}

actor CXAirMan_HoverActive_F : Inventory {}

actor CXAirMan_HoverStamina_F : Inventory {
  Inventory.MaxAmount 500
}
actor CXAirMan_W : BaseUnholyBossWep {
  Tag "$TAG_CXAirman_W"
  Weapon.AmmoType "UnholyBossAmmo200"
  Weapon.AmmoType2 "UnholyPower1500"
  Obituary "%o cannot be literally air like %k."
  States {
   Spawn:
    8I01 [ 1
    wait

   Deselect:
    // 8I01 A 0 A_ChangeFlag("CANTSEEK",0)
    // 8I01 A 0 A_SetTranslucent(1.0,0)
    // 8I01 A 0 A_TakeInventory("DecoyFlag1")
    // 8I01 A 0 A_TakeInventory("CXAirManFlag")
    8I01 A 0
    goto DeselectSwap
   Select:
    8I01 A 0
    goto SelectSwap

   Ready:
    8I01 A 0  // Initial setup: boss morph hook.
    8I01 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, CXAIRMAN_DYE)
    // 8I01 A 0 A_TakeInventory("DecoyFlag1")
    goto ReadyX
   ReadyX:
    8I01 A 0 A_JumpIfInventory("CXAirManFlag", 1, "ReadyTake")
    8I01 A 2 A_GiveInventory("CXAirMan_Ready_P")
    // 8I01 A 0 A_GiveInventory("CXAirManFlag",1)
    loop
    // ReadyInvis:
    // 8I01 A 0 A_GiveInventory("CXAirManFlashOn_P")
    // 8I01 A 0 A_SetTranslucent(0.0,0)
    // goto ReadyX2
   ReadyTake:
    8I01 A 2 A_GiveInventory("CXAirMan_Ready_P")
    8I01 A 0 A_TakeInventory("CXAirManFlag", 1)
    8I01 A 0 A_JumpIfInventory("CXAirManFlag", 1, "ReadyTake")
    8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
    goto ReadyX

   Fire:
    8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
    8I01 A 0 A_PlaySoundEx("misc/devilfire", "Weapon")
    8I01 A 0 A_FireCustomMissile("CXAirShot_H", 0, 0, 8, 0)
    8I01 BCAAAA 2 A_GiveInventory("UnholyBossAmmo200", 1)
    goto ReadyX

   Altfire:
    8I01 A 0 A_JumpIfInventory("UnholyPower1500", 1500, "AntiPowerDamage")
    goto Altfire2
   Altfire2:
    // 8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
    // 8I01 A 0 A_SetTranslucent(1.0,0)
    8I01 A 0 A_PlaySoundEx("weapons/mm2/leafshieldactive_short", "Weapon")
    8I01 A 0 A_FireCustomMissile("CXAirShotX", frandom(-2, 2), 0, 0, 0)

    8I01 A 1 ACS_NamedExecuteWithResult("rz_AirManInvis")
    8I01 A 0 A_GiveInventory("CXAirManFlag", 50)
    // goto Altfire2End
    // Altfire2End:
    8I01 BCA 2 A_GiveInventory("UnholyBossAmmo200", 1)
    goto ReadyX
   AntiPowerDamage:
    8I01 C 0 A_GiveInventory("CXAirManFlashOff_P")
    goto AntiPowerDamageL
   AntiPowerDamageL:
    8I01 C 0 ACS_NamedExecuteWithResult("uh_CXAirMan_PowerDrain")
    8I01 C 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8I01 C 0 A_SpawnItemEx("AirBrgWall", 0, 0, 32, 15, 0, 0)
    8I01 CC 0 A_SpawnItemEx("AirBrgWall", 0, 0, 32, 15, random(-16, -16), random(0, 0))
    8I01 CC 0 A_SpawnItemEx("AirBrgWall", 0, 0, 32, 15, random(-32, 32), random(-8, 16))
    8I01 CC 0 A_SpawnItemEx("AirBrgWall", 0, 0, 32, 15, random(-64, 64), random(-16, 32))
    8I01 CBA 5
    TNT1 A 0 A_JumpIfInventory("UnholyPower1500", 150, "AntiPowerDamageL")
    8I01 C 25
    8I01 BA 3
    goto ReadyX

   Reload:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "Jump")
    goto ReadyX
   Jump:
    TNT1 A 0 A_GiveInventory("CXAirManReloadSound_F")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CXAirMan_ReloadSpend")
    TNT1 A 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8I01 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8I01 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    8I01 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    8I01 A 24 A_GiveInventory("CXAirManFlashOn_P")
    8I01 A 0 ACS_NamedExecuteWithResult("rz_AirManWarp")  // A_GiveInventory("UH_ArtiTeleport_P")
    8I01 A 0 A_GiveInventory("CXAirManFlashOff_P")
    8I01 A 0 A_TakeInventory("CXAirManReloadSound_F")
    8I01 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    8I01 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    8I01 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    goto ReadyX
    // AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-16,-16),random(0,0))
    // AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-32,32),random(-8,16))
    // AIRA AAA 0 A_SpawnItemEx("AirBrgWall2",0,0,32,15,random(-64,64),random(-16,32))
    // TNT1 A 0 A_GiveInventory("NoTeleportFX_Flag",1)
    // TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P")
    // TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Weapon")
    // TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,60)
    // TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,-60)
    // TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,120)
    // TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,-120)
    // TNT1 A 0 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,180)
    // 8I01 A 1 A_SpawnItemEx("CXAirShotX",0,0,32,25,0,0,0)
    // goto ReadyX
  }
}

actor CXAirManReloadSound_F : Inventory {
  Inventory.MaxAmount 1
}

actor CXAirManFlag : Inventory {
  Inventory.MaxAmount 50
}

actor CXAirManAltFlag : Inventory {
  Inventory.MaxAmount 6
}

actor CXAirMan_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CXAirManAltFlag", 0, "PickupNoAlt")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_GiveInventory("CXAirMan_Ready0_P")
    stop
   PickupNoAlt:
    TNT1 A 0 A_GiveInventory("CXAirMan_Ready8_P")
    stop
  }
}
actor CXAirMan_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 5)
    stop
  }
}
actor CXAirMan_Ready8_P : CXAirMan_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor CXAirManFlashOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CXAirManRevealCancel")
    // M2 and Reload share one cloak. Do not acquire a second property layer.
    TNT1 A 0 A_JumpIfInventory("DecoyFlag1", 1, "End")
    TNT1 A 0 A_GiveInventory("DecoyFlag1")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantseekplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_dontidentifytargetplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invisibleplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerGive", 30)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 31)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 32)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 33)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 34)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossPowerTake", 35)
    TNT1 A 0 A_JumpIfInventory("CXAirManAltFlag", 0, "End")
    TNT1 A 0 A_JumpIfInventory("CXAirManReloadSound_F", 1, "SilentFX")
    TNT1 A 0 A_SpawnItemEx("CXAirManTeleportFX2_Helper", 0, 0, 32, 0, 0, 0, 0, 1)
    stop
   SilentFX:
    TNT1 A 0 A_SpawnItemEx("CXAirManTeleportFX2_SilentHelper", 0, 0, 32, 0, 0, 0, 0, 1)
    stop
   End:
    TNT1 A 0
    stop
  }
}

actor CXAirManRevealPending_F : Inventory {
  Inventory.MaxAmount 1
}

actor CXAirManFlashOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CXAirManRevealBegin")
    stop
  }
}

// Temporary server-side sight endpoint for validating Reload destinations.
actor CXAirManWarpProbe {
  +NOBLOCKMAP
  +NOGRAVITY
  Radius 1
  Height 1
  States {
   Spawn:
    TNT1 A 1
    stop
  }
}

// Server-owned: restore the cloak exactly when the final frame ends.
actor CXAirManTeleportFX : BasicGraphicEffect {
  -CLIENTSIDEONLY
  var int user_reveal_generation;
  var int user_morph_generation;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    8Q01 DEFE 2
    8Q01 F 1
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CXAirManRevealDone")
    stop
  }
}

actor CXAirManTeleportFX2_Helper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    TNT1 A 2 A_SpawnItemEx("CXAirManTeleportFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor CXAirManTeleportFX2 : BasicGraphicEffect {
  States {
   SpawnFrame:
    8Q01 FED 2
    stop
  }
}

actor CXAirShot_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 1)
    TNT1 A 0 A_SpawnItemEx("CXAirShot", 0, 0, 0, random(4, 60) * cos(-pitch), 0, random(20, 60) * sin(-pitch) + frandom(-1, 1), random(-15, 15), 0)
    TNT1 A 0 A_SpawnItemEx("CXAirShot", 0, 0, 0, random(4, 60) * cos(-pitch), 0, random(20, 60) * sin(-pitch) + frandom(-1, 1), random(-15, 15), 0)
    TNT1 A 0 A_SpawnItemEx("CXAirShot", 0, 0, 0, random(4, 60) * cos(-pitch), 0, random(20, 60) * sin(-pitch) + frandom(-1, 1), random(-15, 15), 0)
    TNT1 A 0 A_SpawnItemEx("CXAirShot", 0, 0, 0, random(4, 60) * cos(-pitch), 0, random(20, 60) * sin(-pitch) + frandom(-1, 1), random(-15, 15), 0)
    stop
  }
}

// All CXAirMan projectiles pass through the shootable spread shots.
actor CXAirManProjectile : BasicProjectile {
  Species "CXAirManProjectile"
  +THRUSPECIES
}

actor CXAirShot : UH_ShootableActor {
  Projectile
  Species "CXAirManProjectile"
  +THRUSPECIES
  +SHOOTABLE
  -NOBLOCKMAP
  +NOBLOOD
  Health 100
  PainChance 256
  PainSound "misc/devilpain"
  DamageType "AirCX"
  Obituary "%o was shot down by %k's Spread Buster."
  +RIPPER
  Damage (75)
  Radius 9
  Height 9
  Speed 54
  Scale 2.5
  States {
   Spawn:
    BASB A 2
    loop
   Pain:
    BASB A 0 A_Pain
    goto Spawn
   Death:
    MXP1 AB 2
    CXP1 C 2
    MXP1 D 2
    CXP1 E 2
    stop
  }
}

actor CXAirShotX : CXAirManProjectile {
  Translation "192:192=4:4", "198:198=74:74"
  var int user_power;
  +RIPPER
  +NOEXPLODEFLOOR
  Radius 10
  Height 12
  Damage (85 + user_power)
  DamageType "AirCX"
  Obituary "%o was blown away by %k's Air Shooter."
  Speed 45
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Recoil(-4)
    TNT1 A 0 A_JumpIf(velz > 0, "SpawnDown")
    goto SpawnUp
   SpawnUp:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    8Q01 AABBCC 1 ThrustThingZ(0, 4, 0, 1)
    goto SpawnUp+1
   SpawnDown:
    TNT1 A 0 A_setUserVar("user_power", 20)
    TNT1 A 0 A_ChangeFlag("NOEXPLODEFLOOR", 0)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    8Q01 AABBCC 1 ThrustThingZ(0, 4, 1, 1)
    goto SpawnDown+3
   Death:
    X_2B GHIJ 2
    stop
  }
}

actor AirBrgWall : CXAirManProjectile {
  Translation "192:192=4:4", "198:198=74:74"
  DamageType "AirCX"
  Obituary "%o was blown away by %k's Air Shooter Barrage."
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  +SKYEXPLODE
  Damage (50)
  Radius 6
  Height 7
  Speed 0
  Scale 3.0
  States {
   Spawn:
    8Q01 A 0
    8Q01 AABBCC 1 A_Recoil(3)
    8Q01 A 0 A_Stop
    8Q01 ABC 2
    8Q01 A 0 A_SpawnItemEx("AirBrg")
    stop
   Death:
    X_2B GHIJ 3
    stop
  }
}

actor AirBrgWall2 : AirBrgWall {
  Obituary "%o was blown away by %k's Air Shooter."
  Damage (30)
  Scale 2.5
  States {
   Spawn:
    8Q01 A 0
    8Q01 AABBCC 1 A_Recoil(2)
    8Q01 A 0 A_Stop
    8Q01 ABC 2
    8Q01 A 0 A_SpawnItemEx("AirBrg2")
    stop
  }
}

actor AirBrg : CXAirManProjectile {
  Translation "192:192=4:4", "198:198=74:74"
  DamageType "AirCXFling"
  Obituary "%o was blown away by %k's Air Shooter Barrage."
  +SEEKERMISSILE
  ReactionTime 75
  Damage (50)
  Radius 6
  Height 7
  Speed 42
  Scale 3.5
  States {
   Spawn:
    8Q01 ABC 2 A_SeekerMissile(2, 10, SMF_LOOK, 55, 10)
    8Q01 A 0 A_Countdown
    loop
   Death:
    X_2B GGHHIIJJ 1 A_Fadeout
    stop
  }
}

actor AirBrg2 : AirBrg {
  Obituary "%o was blown away by %k's Air Shooter."
  ReactionTime 45
  Damage (30)
  Scale 3.0
}

// Reload plays its opening sound directly; suppress only the opening FX sound.
actor CXAirManTeleportFX2_SilentHelper : CXAirManTeleportFX2_Helper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("CXAirManTeleportFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

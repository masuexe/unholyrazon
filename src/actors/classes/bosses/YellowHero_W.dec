// If it's weak, make it weaker
actor YellowHero_W_NormalBar : NormalBar {args 229, 220}
actor YellowHero_W : BaseUnholyBossWep
{
Tag "$TAG_Boss040_W"
Obituary "%o was vanquished by \ckYellow Anti-Unholy Elite\c- (%k)!"
Inventory.Pickupmessage "\ckAGAINST THE EVIL!"
weapon.ammotype "UnholyBossAmmo100"
//weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8H40 [ 1
wait

Deselect:
8H40 A 0
goto DeselectSwap
Select:
8H40 A 0
goto SelectSwap

Ready:
8H40 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, YELLOWHERO_DYE)
8H40 A 0 A_GunFlash
goto ReadyX
ReadyX:
8H40 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"ReadyX2")
8H40 A 2 A_WeaponReady(8)
8H40 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop
ReadyX2:
8H40 A 2 A_WeaponReady
8H40 A 0 A_GiveInventory("UnholyBossAmmo100",2)
loop

Flash:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")//1001
TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag")*0.50+1,"Flash.GetHypedForPain")
TNT1 A 1
loop
Flash.GetHypedForPain:
TNT1 A 0 A_PlaySound("weapon/mirrorabsorb")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_runeplayer", 0, true, RUNE_RAGE)
TNT1 A 1
TNT1 A 4 //ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
//stop
Flash.Old:
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", YELLOWHERO_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", THEDENTIST_DYE)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
loop

Fire:
8H40 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8H40 A 0 A_FireCustomMissile("YellowHeroShot",0,0,8,0)
8H40 A 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(4,9),0,8,0,0,(random(0,1)*2-1)*random(1,2))
// 8 tics (was BCBA 2). Peak (32,56). Ammo x1 x4.
// duration 1 is not halved by Rage — skip settle frames. Give on 0-tic before
// the kept frame so Rage still grants 4 ammo in ~4 real tics.
8H40 B 0 A_GiveInventory("UnholyBossAmmo100",1)
8H40 B 1 Offset(10, 40) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 C 1 Offset(20, 48)
8H40 B 0 A_GiveInventory("UnholyBossAmmo100",1)
8H40 C 1 Offset(28, 54) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 C 1 Offset(32, 56)
8H40 B 0 A_GiveInventory("UnholyBossAmmo100",1)
8H40 B 1 Offset(24, 50) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 B 1 Offset(14, 42)
8H40 A 0 A_GiveInventory("UnholyBossAmmo100",1)
8H40 A 1 Offset(6, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 A 1 Offset(4, 34)
8H40 A 0 A_WeaponReady(14)
Goto ReadyX
AltFire:
8H40 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"SpreadShotThing") //BRIAN_LOOKOUT
Goto Fire  // ReadyX
/*BRIAN_LOOKOUT:
8H40 C 0 A_TakeInventory("UnholyBossAmmo100",100)
8H40 C 0 A_GiveInventory("YellowHero_Alt_Start_P")
8H40 C 1
8H40 CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 1 A_GiveInventory("YellowHero_Alt_P")
8H40 B 4 A_GiveInventory("YellowHero_Alt_End_P")
8H40 AA 4
Goto ReadyX*/
SpreadShotThing:
8H40 B 0 A_TakeInventory("UnholyBossAmmo100",100)
// Straight-line 5-volley burst (10 tics) — per-shot pulse, not one sweep-kick.
// Fires stay on 0-tic; Rage only skips settle holds (all 5 volleys kept).
// Milder than a one-shot alt: kick ~ (20,48), brief recover between volleys.
8H40 B 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H40 B 0 A_FireCustomMissile("YellowHeroShot",-7,0,8,0)
8H40 BB 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(1,2)-7,0,8,0,0,(random(0,1)*2-1)*random(1,3))
8H40 B 1 Offset(18, 46) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 B 1 Offset(8, 38)
8H40 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H40 C 0 A_FireCustomMissile("YellowHeroShot",-3,0,8,0)
8H40 CC 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(1,2)-3,0,8,0,0,(random(0,1)*2-1)*random(1,3))
8H40 C 1 Offset(20, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 C 1 Offset(8, 38)
8H40 B 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H40 B 0 A_FireCustomMissile("YellowHeroShot",0,0,8,0)
8H40 BB 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(1,2),0,8,0,0,(random(0,1)*2-1)*random(1,3))
8H40 B 1 Offset(22, 50) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 B 1 Offset(8, 38)
8H40 A 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H40 A 0 A_FireCustomMissile("YellowHeroShot",3,0,8,0)
8H40 AA 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(1,2)+3,0,8,0,0,(random(0,1)*2-1)*random(1,3))
8H40 A 1 Offset(20, 48) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 A 1 Offset(8, 38)
8H40 A 0 A_PlaySoundEx("weapon/pshot","Weapon")
8H40 A 0 A_FireCustomMissile("YellowHeroShot",7,0,8,0)
8H40 AA 0 A_FireCustomMissile("YellowHeroShot",(random(0,1)*2-1)*random(1,2)+7,0,8,0,0,(random(0,1)*2-1)*random(1,3))
8H40 A 1 Offset(16, 44) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
8H40 A 1 Offset(4, 34)
8H40 A 0 A_WeaponReady(14)
Goto ReadyX
}
}

Actor YellowHeroShot : BlueHeroShot
{
Translation "192:192=218:218", "198:198=220:220", "202:202=214:214", "199:199=229:229"
Damagetype "HeroYellow"
Obituary "%o was vanquished by \ckYellow Anti-Unholy Elite\c- (%k)!"
Speed 80
Damage (random(59,68))
States
{
Death:
TMFX ABCD 2
stop
}
}

actor YellowHero_Alt_Start_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_ChangeVelocity(cos(pitch)*30,0,-sin(pitch)*30,3)
TNT1 A 0 A_SetArg(1,angle)
TNT1 A 0 A_SetArg(4,momz*100000)
TNT1 A 0 A_SetArg(3,momy*100000)
TNT1 A 0 A_SetArg(2,momx*100000)

TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOn", 22)
TNT1 A 0 A_GiveInventory("VivifyFlag1")

TNT1 A 0 A_PlaySoundEx("weapon/BionicMovement","SoundSlot7")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOn", 6)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossUnsolidOn")
stop
}
}

actor YellowHero_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
TNT1 A 0 A_SpawnItemEx("YellowHero_Alt_Damager",0,0,32,0,0,0,0,1)
goto Part2
TNT1 A 0 A_SpawnItemEx("YellowHero_Alt_Damager_X",0,0,32,0,0,0,0,1)
goto Part2
Part2:
TNT1 A 0 A_JumpIfInventory("WeaponCharge",3,"Spew_D")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",2,"Spew_C")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",1,"Spew_B")
Goto Spew_A
Spew_A:
TNT1 A 0 A_GiveInventory("WeaponCharge",1)
TNT1 A 0 A_SpawnItemEx("YellowHero_Trail_Frame_1",-16,0,0,0,0,0,0,0)
goto End
Spew_B:
TNT1 A 0 A_GiveInventory("WeaponCharge",1)
TNT1 A 0 A_SpawnItemEx("YellowHero_Trail_Frame_2",-16,0,0,0,0,0,0,0)
goto End
Spew_C:
TNT1 A 0 A_GiveInventory("WeaponCharge",1)
TNT1 A 0 A_SpawnItemEx("YellowHero_Trail_Frame_3",-16,0,0,0,0,0,0,0)
goto End
Spew_D:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_SpawnItemEx("YellowHero_Trail_Frame_4",-16,0,0,0,0,0,0,0)
goto End
End:
TNT1 A 0 A_ChangeVelocity(Args[2]*0.00001,Args[3]*0.00001,Args[4]*0.00001,CVF_REPLACE)
stop
}
}

actor YellowHero_Alt_End_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOff", 22)
TNT1 A 0 A_TakeInventory("VivifyFlag1")
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_ScaleVelocity(0.75)

TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossStackOff", 6)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_BossUnsolidOffDmg", CallACS("core_getmaxhealth")/10)
stop
}
}

actor YellowHero_Alt_Damager : BasicExplosion_Args_Trio
{
Damagetype "HeroYellow"
Obituary "%o was vanquished by \ckYellow Anti-Unholy Elite\c- (%k)!"
Args 25,64,32 //
}
actor YellowHero_Alt_Damager_X : YellowHero_Alt_Damager
{
Args 75,64,32 //
}

actor YellowHero_Trail_Frame_1 : BasicGraphicEffect
{//	"I wanted to replicate those street fighter alpha trails you see in special moves." - Trist
Translation "192:192=74:74", "198:198=244:244"
Alpha 0.70
States
{
SpawnFrame:
8A38 B 0
goto SpawnSkin
SpawnSkin:
8A38 "#" 5
8A38 "#" 1 A_Fadeout(0.05)
wait
}
}
actor YellowHero_Trail_Frame_2 : YellowHero_Trail_Frame_1
{
States
{
SpawnFrame:
8A38 C 0
goto SpawnSkin
}
}
actor YellowHero_Trail_Frame_3 : YellowHero_Trail_Frame_1
{
States
{
SpawnFrame:
8A38 D 0
goto SpawnSkin
}
}
actor YellowHero_Trail_Frame_4 : YellowHero_Trail_Frame_1
{
States
{
SpawnFrame:
8A38 E 0
goto SpawnSkin
}
}

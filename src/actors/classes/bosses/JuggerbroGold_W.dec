    TNT1 A 2 A_SpawnItemEx("JuggerGoldMeteorRingFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor JuggerGoldMeteorRing2 : JuggerGoldMeteorRing {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(100, 196, 0, 0, 64)
    TNT1 A 2 A_SpawnItemEx("JuggerGoldMeteorFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor JuggerGoldMeteorRingFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 1
    X_0E N 4
    X_0E M 5
    X_0E M 1 A_FadeOut(0.2)
    wait
  }
}

actor JuggerGoldMeteorFX_H : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 AA 0 A_SpawnItemEx("JuggerGoldRamFX31", random(-32, 32), random(-32, 32), random(-32, 32), random(-2, 2), random(-2, 2), random(-2, 2), 0, 1, 128)
    TNT1 AA 0 A_SpawnItemEx("JuggerGoldRamFX33", random(-32, 32), random(-32, 32), random(-32, 32), random(-2, 2), random(-2, 2), random(-2, 2), 0, 1, 128)
    TNT1 A 1
    stop
  }
}

actor JuggerGoldMeteorPickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 ThrustThingZ(0, 40, 0, 0)
    TNT1 A 0 ThrustThing(angle * 256 / 360 + 128, 10, 1, 0)
    TNT1 A 0 A_PlaySoundEx("classes/DakuSpecialSFX", "Body")
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    stop
  }
}

actor JuggerGoldMeteorEndSync_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("JuggerGoldFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", CallACS("core_gettarget") - 999, false)
    TNT1 A 0 A_TakeFromTarget("UnholyPower1000", 250, 1)
    TNT1 A 0 A_TakeFromTarget("UnholyPower1000", 250)
    TNT1 A 1 A_SpawnItemEx("JuggerGoldMeteorEndFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor JuggerGoldMeteorEndFX : BasicGraphicEffect {
  var int user_A;
  ReactionTime 18
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_A", random(0, 20))
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 10, 0, 30, 2, 0, 3, user_A + 15, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 20, 0, 20, 4, 0, 2, user_A + 10, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 30, 0, 10, 6, 0, 1, user_A + 5, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 40, 0, 0, 8, 0, 0, user_A, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 30, 0, -10, 6, 0, -1, user_A + 5, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 20, 0, -20, 4, 0, -2, user_A + 10, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 10, 0, -30, 2, 0, -3, user_A + 15, 37)
    TNT1 A 0 A_SetUserVar("user_A", user_A + 20)
    TNT1 A 0 A_Countdown
    goto SpawnFrame+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 0, 0, 40, 0, 0, 4, 0, 37)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldRamFX32", 0, 0, -40, 0, 0, -4, 0, 37)
    stop
  }
}

actor JuggerGoldRamFX31 : BasicGraphicEffect {

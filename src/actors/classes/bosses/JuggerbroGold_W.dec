    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1)
   Spawn1:
    GIGO M 5
    GIGO N 10
    GIGO N 1 A_Fadeout(0.15)
    wait
  }
}

actor JuggerGoldRamFX32 : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 4)
   Spawn1:
    GIGO O 6
    GIGO P 2 A_ScaleVelocity(1.05)
    GIGO P 1 A_Fadeout
    goto Spawn1+1
   Spawn2:
    GIGO O 6
    GIGO Q 2 A_ScaleVelocity(1.05)
    GIGO Q 1 A_Fadeout
    goto Spawn2+1
  }
}

actor JuggerGoldRamFX33 : BasicGraphicEffect {
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "Spawn1", "Spawn2")
   Spawn1:
    GIGO RS 3
    GIGO T 3 A_Fadeout(0.2)
    goto Spawn1+1
   Spawn2:
    GIGO UV 3
    GIGO W 3 A_Fadeout(0.2)
    goto Spawn2+1
  }
}

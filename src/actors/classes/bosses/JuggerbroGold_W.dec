actor JuggerbroGold_W_ScriptBar : ScriptBar {}

actor JuggerbroGold_W : BaseUnholyBossWep {
  Tag "$TAG_JuggerbroGold_W"
  Obituary "%o was crushed by \cfJuggerbro Gold\c- (%k)."
  Inventory.Pickupmessage "\cfJuggernauts... made of SOLID GOLD."
  Weapon.AmmoType "UnholyPower1000"
  States {
   Spawn:
    8H31 [ 1
    wait

   Deselect:
    8H31 A 0
    goto DeselectSwap
   Select:
    8H31 A 0
    goto SelectSwap

   Ready:
    8H31 A 0 A_GiveInventory("UnholyPowerLimit_F", 1000)
    8H31 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
    8H31 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, JUGGERBROGOLD_DYE)
    8H31 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 1)
    8H31 A 0 A_TakeInventory("JuggerGoldFlag")
    goto ReadyX
   ReadyX:
    8H31 A 0 A_JumpIfInventory("UnholyPower1000", 1000, "ReadyX2")
    8H31 A 2 A_WeaponReady(WRF_NOSECONDARY)
    8H31 A 0 A_GiveInventory("UnholyPower1000", 10)
    loop
   ReadyX2:
    8H31 A 2 A_WeaponReady
    8H31 A 0 A_GiveInventory("UnholyPower1000", 10)
    loop

   Fire:
    8H31 A 0 A_JumpIfInventory("VivifyFlag1", 1, "MeteorEnd")
    8H31 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    8H31 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    8H31 A 2
    goto FireC
   FireC:
    // 8H31 J 0 A_JumpIfInventory("UnholyBossAmmo100",100,"FireCHold2")
    8H31 J 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "FireCSound")
    8H31 J 1 ACS_NamedExecuteWithResult("core_chargecolor", JUGGERBROGOLDCHARGE_DYE)
    8H31 J 0 A_GiveInventory("UnholyBossAmmo100", 2)
    8H31 J 0 A_ReFire(1)
    goto Fire0
    8H31 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "FireCSound")
    8H31 A 1 ACS_NamedExecuteWithResult("core_chargecolor", JUGGERBROGOLD_DYE)
    8H31 A 0 A_GiveInventory("UnholyBossAmmo100", 2)
    8H31 A 0 A_GiveInventory("UnholyPower1000", 10)
    8H31 A 0 A_ReFire("FireC")
    goto Fire0
   FireCSound:
    8H31 A 0 A_PlaySoundEx("wep/CrysCharge1", "Weapon")
    goto FireCHold
   FireCHold:
    8H31 J 1 ACS_NamedExecuteWithResult("core_chargecolor", JUGGERBROGOLDCHARGE_DYE)
    8H31 A 1 ACS_NamedExecuteWithResult("core_chargecolor", JUGGERBROGOLD_DYE)
    8H31 A 0 A_GiveInventory("UnholyPower1000", 10)
    8H31 A 0 A_ReFire("FireCHold")
    goto Fire0
   Fire0:
    8H31 B 0 ACS_NamedExecuteWithResult("core_chargecolor", JUGGERBROGOLD_DYE)
    8H31 B 0 A_PlaySoundEx("weapon/screwcrusher", "Weapon")
    8H31 B 0 A_GiveInventory("JuggerGoldCrusher_P")  // JuggerGoldCrusher
    // 8H31 B 0 A_GunFlash("Flash.Ammo",1)
    8H31 BCDEFGZZHI 2 A_GiveInventory("UnholyPower1000", 10)
    goto ReadyX

    /*Flash.Ammo:
    TNT1 AAAAAAAAAA 2 A_GiveInventory("UnholyPower1000",10)
    stop*/

   Flash.Meteor:
    TNT1 A 1 A_SpawnItemEx("JuggerGoldMeteorRing", 0, 0, 32, 0, 0, 0, 0, 1)
    TNT1 AA 1 A_SpawnItemEx("JuggerGoldMeteorRing2", 0, 0, 32, 0, 0, 0, 0, 1)
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "NoFlash")
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 13, 1)
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 12)
    TNT1 A 0 A_JumpIfInventory("UnholyPower1000", 1, 2)
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    stop
    TNT1 AAA 1 A_SpawnItemEx("JuggerGoldMeteorRing2", 0, 0, 32, 0, 0, 0, 0, 1)
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "NoFlash")
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 13, 1)
    TNT1 A 0 A_TakeInventory("UnholyPower1000", 12)
    TNT1 A 0 A_JumpIfInventory("UnholyPower1000", 1, "Flash.Meteor")
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    stop

   AltFire:
    8H31 A 0 A_JumpIfInventory("VivifyFlag1", 1, "MeteorEnd")
    8H31 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    8H31 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    // 8H31 A 0 A_JumpIfInventory("UnholyPower1000",1000,"BeginMeteor")
    // goto ReadyX
    // BeginMeteor:
    8H31 N 0 A_GiveInventory("JuggerGold_AltStart_P")
    8H31 N 0 A_ReFire(1)
    8H31 N 2
    8H31 O 2 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    8H31 PQRS 2
    TNT1 A 12  // 18
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 0, 0)
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    TNT1 A 0 A_GunFlash("Flash.Meteor")
    TNT1 A 0 A_PlaySoundEx("weapon/solarblaze", "Weapon")
    TNT1 A 0 A_SpawnItemEx("JuggerGoldMeteor", 0, 0, 0, cos(-pitch), 0, sin(-pitch), 0, 1)
    TNT1 A 1 A_ClearReFire
    TNT1 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    TNT1 A 1 A_ClearReFire
    TNT1 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    TNT1 A 1 A_ClearReFire
    goto MeteorLoop
   MeteorLoop:
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY | WRF_NOSWITCH)
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    TNT1 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    TNT1 A 1 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY | WRF_NOSWITCH)
    TNT1 A 0 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd")
    TNT1 A 0 A_JumpIfInventory("ProjectilePortDead", 1, "MeteorEnd")
    loop

   MeteorEnd:
    TNT1 A 0 A_GiveInventory("VivifyDelay5")
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 0)
    TNT1 A 0 A_SpawnItemEx("JuggerGoldMeteorEndSync_H", 0, 0, 28, 0, 0, 0, 0, 1)
    TNT1 A 0 A_ReFire(1)
    8H31 H 1 A_JumpIfInventory("JuggerGoldFlag", 1, "MeteorEnd1")  // Sync
    goto MeteorEnd1
   MeteorEnd1:
    8H31 H 4 A_ChangeVelocity(sqrt(velx * velx + vely * vely), 0, velz, 3)
    8H31 IA 4
    8H31 A 1 A_GiveInventory("JuggerGold_AltReset_P")
    goto ReadyX
  }
}

actor JuggerGoldFlag : Once {}

actor JuggerGold_AltAmmo_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("UnholyPower1000", 10)
    stop
  }
}

actor JuggerGold_AltStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_Stop
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nogravityplayer", 0, 1, 0)
    TNT1 A 0 A_PlaySoundEx("weapon/pcharge", "Weapon")
    TNT1 A 0 ThrustThingZ(0, 4, 0, 0)
    goto Reset+1
   Reset:
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_TakeInventory("JuggerGoldFlag")
    TNT1 A 0 A_TakeInventory("JuggerSilverFlag")
    TNT1 A 0 A_TakeInventory("ProjectilePortDead")
    stop
  }
}

actor JuggerGold_AltReset_P : JuggerGold_AltStart_P {
  States {
   Pickup:
    goto Reset
  }
}

actor JuggerGoldCrusher_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo100", 100, "Pickup2")
    TNT1 A 0 A_FireCustomMissile("JuggerGoldCrusher", 0, 0, 8, 0)
    goto End
    /*Pickup2:
    TNT1 A 0 A_FireCustomMissile("JuggerGoldCrusher2",0,0,8,0)
    goto End*/
   Pickup2:
    TNT1 A 0 A_FireCustomMissile("JuggerGoldCrusher3", 0, 0, 8, 0)
    goto End
   End:
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo100", 100)
    stop
  }
}

actor JuggerGoldCrusher : BasicProjectile {
  Translation "192:192=161:161", "198:198=163:163", "0:0=167:167"
  +SKYEXPLODE
  DamageType "JuggerGold"
  Obituary "%o was crushed by \cfJuggerbro Gold\c- (%k)."
  Damage (180)  // 120
  Radius 18
  Height 10
  Speed 55  // 85
  Scale 3.0
  States {
   Spawn:
    X_KB A 0
    X_KB AB 3
    goto Spawn+1
   Death:
    TNT1 A 0 A_PlaySoundEx("misc/mm3explosion", "SoundSlot5")
    TNT1 A 0 A_Explode(180, 96, 0, 0, 48)  // 120
    TMFX AAAA 1 A_SetScale(scaleX + 0.5, scaleY + 0.5)
    TMFX AAAAAA 1 A_SetScale(scaleX - 0.8, scaleY - 0.8)
    stop
  }
}

actor JuggerGoldCrusher3 : JuggerGoldCrusher {
  +THRUGHOST
  Damage (450)  // 320
  Speed 1
  States {
   Spawn:
    X_KB A 0
    X_KB ABAB 2  // -4
   Spawn2:
    X_KB A 0 A_PlaySoundEx("classes/bikebrake", "Voice")
    X_KB A 0 A_ScaleVelocity(75.0)  // 85
    X_KB A 0 A_SpawnItemEx("JuggerGoldCrusherFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    X_KB A 1 A_ScaleVelocity(1.1)
    X_KB B 0 A_SpawnItemEx("JuggerGoldCrusherFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_KB B 1 A_ScaleVelocity(1.1)
    X_KB A 0 A_SpawnItemEx("JuggerGoldCrusherFX1", 0, 0, 0, 0, 0, 0, 0, 1)
    X_KB A 1 A_ScaleVelocity(1.1)
    X_KB B 0 A_SpawnItemEx("JuggerGoldCrusherFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_KB B 1 A_ScaleVelocity(1.1)
    X_KB A 0 A_SpawnItemEx("JuggerGoldCrusherX", 0, 0, 0, random(4, 8), 0, random(3, 6), random(0, 359), 1)
    goto Spawn2+2
   Death:
    TNT1 A 0 A_PlaySoundEx("Pokemon/Explosion", "SoundSlot5")
    TNT1 AAAAAA 0 A_SpawnItemEx("JuggerGoldCrusherX", random(8, 8), random(-8, 8), random(-8, 8), random(6, 12), 0, random(4, 8), random(0, 359), 1)
    TNT1 AAAAAAAAAAAA 1 A_SpawnItemEx("JuggerGoldCrusher3Explode", random(-96, 96), random(-96, 96), random(-96, 96), 0, 0, 0, 0, 1)
    stop
  }
}

actor JuggerGoldCrusherFX1 : BasicGraphicEffect {
  Scale 3.0
  RenderStyle "Translucent"
  Alpha 0.6
  States {
   SpawnFrame:
    X_KB A 2
    stop
  }
}

actor JuggerGoldCrusherFX2 : JuggerGoldCrusherFX1 {
  States {
   SpawnFrame:
    X_KB B 2
    stop
  }
}

actor JuggerGoldCrusherX : JuggerGoldCrusher {
  -NOGRAVITY
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  BounceFactor 0.88
  BounceCount 8
  Damage (75)  // 90
  Radius 14
  Height 8
  Scale 2.0
  States {
   Spawn:
    X_KB AB 4
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor JuggerGoldCrusher3Explode : BasicExplosion {
  +BRIGHT
  Obituary "%o was \cfDEVASTATED\c- by \cfJuggerbro Gold\c- (%k)."
  DamageType "JuggerGold"
  Scale 1.5
  States {
   Spawn:
    X_8B A 0
    X_8B A 0 A_Explode(140, 144, 0, 0, 36)  // 160,160,0,0,80
    X_8B AB 2
    X_8B CDEF 1
    stop
  }
}

actor GoldRammingDamage : BasicExplosion {
  // Old A_SkullAttack
  DamageType "JuggerGold"
  Obituary "%o was \cfDESTROYED\c- by \cfJuggerbro Gold\c- (%k)."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(300, 100, 0)
    stop
  }
}

actor JuggerGoldMeteor : BasicProjectile {
  BounceSound "misc/quake"
  DamageType "JuggerGold"
  Obituary "%o was \cfDESTROYED\c- by \cfJuggerbro Gold\c- (%k)."
  +DONTBLAST
  +DONTREFLECT
  +THRUGHOST
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  BounceFactor 1.0
  WallBounceFactor 1.0
  Radius 15
  Height 54
  Damage (0)
  Speed 75  // 60
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ACS_NamedExecuteAlways("uh_ProjectilePort", 0, 200)
    TNT1 A 0 A_ScaleVelocity(75)  // 60
    goto Spawn2
   Spawn2:
    TNT1 AAAAA 1 A_JumpIfInTargetInventory("JuggerGoldFlag", 1, "Death")
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    loop

   Crash:
   XDeath:
    TNT1 A 0 A_GiveInventory("ProjectilePortDead")
    TNT1 A 0 A_JumpIfInTargetInventory("JuggerGoldFlag", 1, "DeathXL")
    TNT1 A 0 A_Explode(2000 * (CallACS("uh_checkrune", RUNE_SPREAD) * 2 + 1), 256, 0, 0, 256)  // 1400,196,0,0,196
    TNT1 A 0 A_GiveToTarget("JuggerGoldMeteorPickup", 1)
    TNT1 A 3 A_GiveToTarget("JuggerGoldFlag")
    TNT1 A 2 A_GiveToTarget("UnholyPower1000", 250)
    stop
   Death:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("ProjectilePortDead")
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("JuggerGoldFlag", 1, "DeathXL")
    TNT1 A 0 A_Stop
    goto DeathXL
   DeathXL:
    TNT1 A 0 A_SpawnItemEx("JuggerGoldMeteorExplosion", 0, 0, 27, 0, 0, 0, 0, 1)
    TNT1 A 1 A_GiveToTarget("JuggerGoldFlag")
    stop
  }
}

actor JuggerGoldMeteorExplosion : BasicExplosion {
  DamageType "JuggerGold"
  Obituary "%o was \cfDESTROYED\c- by \cfJuggerbro Gold\c- (%k)."
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Pitfall/Boom", "Body")
    TNT1 A 0 A_Explode(500 * (CallACS("uh_checkrune", RUNE_SPREAD) * 2 + 1), 192, 0, 0, 96)  // 250,196,0,0,64
    X_8B ABCD 2 A_SpawnItemEx("JuggerGoldMeteorExplosionFX", random(-56, 56), random(-56, 56), random(-56, 56), 0, 0, 0, 0, 1)
    X_8B EF 2
    stop
  }
}

actor JuggerGoldMeteorExplosionFX : BasicGraphicEffect {
  States {
   SpawnFrame:
    X_8B ABCDEF 2
    stop
  }
}


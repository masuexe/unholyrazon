actor SakiNoteFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("MMSF2/ShockNote", "Weapon")
    TNT1 A 0 A_FireCustomMissile("SakiNote", 0, 0, 0, 0)
    stop
  }
}
actor SakiNoteFire2_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("MMSF2/ShockNote", "Weapon")
    TNT1 A 0 A_FireCustomMissile("SakiNote2", 0, 0, 0, 0)
    stop
  }
}
actor SakiNote : BasicProjectile {
  translation "192:192=82:82", "198:198=66:66"
  damagetype "SakikoTogawa"
  Obituary "\c[h6]Sakiko \c[q5]Togawa\c- (%k)'s piano note made %o a victim of its sorrow."
  +BRIGHT
  +RIPPER
  Radius 10
  Height 10
  scale 2.5
  damage (random(57, 535))
  speed 24
  var int user_direction;
  var int user_speed;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_direction", 1)
    TNT1 A 0 A_SetUserVar("user_speed", 8)
    goto SpawnStart
   SpawnStart:
    8P52 CC 1 A_Changevelocity(0, -(user_speed/2)*user_direction, 0, 1)
    8P52 C 0 A_Changevelocity(0, 3*user_speed*user_direction, 0, 1)
    goto SpawnLoop
   SpawnLoop:
    8P52 C 6 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 C 0 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 CC 3 A_Changevelocity(0, -user_speed*user_direction, 0, 1)
    8P52 C 0 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 CC 3 A_Changevelocity(0, -user_speed*user_direction, 0, 1)
    8P52 C 6 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 C 0 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 CC 3 A_Changevelocity(0, user_speed*user_direction, 0, 1)
    8P52 C 0 A_SpawnItemEx("SakiNoteFX", 0, 0, 0, random(-4, -10), random(-3, 3), random(-3, 3), 0, 1)
    8P52 CC 3 A_Changevelocity(0, user_speed*user_direction, 0, 1)
    loop
   Death:
    TNT1 A 0
    stop
  }
}
actor SakiNote2 : SakiNote {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_direction", -1)
    TNT1 A 0 A_SetUserVar("user_speed", 8)
    goto SpawnStart
  }
}
actor SakiNoteFX : BasicClientSide {
  Scale 3.0
  Renderstyle "Translucent"
  Alpha 0.6
  +BRIGHT
  States {
   Spawn:
    X_9H TSR 4
    stop
  }
}
actor SoraNoMusicaWave : BasicFastProjectile {
  translation "192:192=67:67", "198:198=77:77"
  Radius 10
  Height 10
  scale 15
  damage (27)
  damagetype "SoraNoMusica"
  Obituary "%o refused to become a member of Ave Mujica."
  speed 80
  +FORCEXYBILLBOARD
  +RIPPER
  +THRUACTORS
  +THRUGHOST
  +NOCLIP
  +SKYEXPLODE
  +NOINTERACTION
  // reactiontime 150
  States {
   Spawn:
    X_7G A 0
    X_7G AA 1 A_Explode(8, 60, 0, 0, 0)
    X_7G BB 1 A_Explode(8, 75, 0, 0, 0)
    X_7G CC 1 A_Explode(8, 90, 0, 0, 0)
    X_7G DD 1 A_Explode(8, 105, 0, 0, 0)
    X_7G GG 1 A_Explode(8, 150, 0, 0, 0)
    X_7G HH 1 A_Explode(8, 180, 0, 0, 0)
    stop
  }
}

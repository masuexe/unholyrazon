actor SakikoTogawa_W_NormalBar : NormalBar {Args 201, 204}
actor SakikoTogawa_W : BaseUnholyBossWep {
  Obituary "An obliviating blast from Oblivious erases %o's existence."
  Inventory.Pickupmessage "\cnI already told you, give me the rest of your life."
  weapon.ammotype "UnholyPower1500"
  States {
   Spawn:
    8I18 [ 1
    wait

   Deselect:
    8I18 A 0
    goto DeselectSwap
   Select:
    8I18 A 0
    goto SelectSwap

   Ready:
    8I18 A 0 A_GiveInventory("UnholyPowerLimit_F", 1500)
    8I18 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
    8I18 A 3 ACS_NamedExecuteAlways("core_weaponcolor", 0, SAKIKOTOGAWA_DYE)
    8I18 A 0 ACS_NamedExecuteAlways("rz_SakiInit")  // A_GiveInventory("IsAMujicaMember",1)
    goto ReadyX
   ReadyX:
    8I18 A 0 A_JumpIfInventory("UnholyPower1500", 1500-750*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyX2")
    8I18 A 1 A_WeaponReady(8)
    8I18 A 0 A_GiveInventory("UnholyPower1500", 5)
    loop
   ReadyX2:
    8I18 A 1 A_WeaponReady
    8I18 A 0 A_GiveInventory("UnholyPower1500", 5)
    loop

   Fire:
    8I18 A 0 A_GiveInventory("UH_50_SpeedPowerGiver")
    8I18 A 1 Offset(0, 36)
    8I18 A 1 Offset(0, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I18 A 1 Offset(0, 39)
    8I18 BC 2
    // 8I18 C 0 A_JumpIfInventory("SakiFlag",1,"Fire2")
    8I18 C 0 A_GiveInventory("SakiNoteFire_P")
    8I18 C 0 A_GiveInventory("SakiNoteFire2_P")
    8I18 DD 2 A_GiveInventory("UnholyPower1500", 1)
    // 8I18 C 0 A_GiveInventory("SakiFlag")
    Goto FireEnd
   Fire2:
    8I18 C 0 A_GiveInventory("SakiNoteFire2_P")
    8I18 DCBC 2 A_GiveInventory("UnholyPower1500", 8)
    8I18 C 0 A_GiveInventory("SakiNoteFire_P")
    8I18 DCBC 2 A_GiveInventory("UnholyPower1500", 8)
    8I18 C 0 A_GiveInventory("SakiNoteFire2_P")
    8I18 DCBC 2 A_GiveInventory("UnholyPower1500", 8)
    8I18 C 0 A_GiveInventory("SakiNoteFire_P")
    8I18 C 0 A_TakeInventory("SakiFlag")
    Goto FireEnd
   FireEnd:
    8I18 DCBAAAAAA 2 A_GiveInventory("UnholyPower1500", 1)
    8I18 A 1 Offset(0, 38)
    8I18 A 1 Offset(0, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I18 A 4 Offset(0, 32) A_TakeInventory("UH_50_SpeedPower")
    Goto ReadyX

   AltFire:
    8I18 A 0 A_GiveInventory("UH_50_SpeedPowerGiver")
    8I18 A 1 Offset(0, 36)
    8I18 A 1 Offset(0, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I18 A 1 Offset(0, 39)
    8I18 BC 2
    8I18 A 0 A_TakeInventory("UnholyPower1500", 750, 1)
    8I18 A 0 A_TakeInventory("UnholyPower1500", 750)
    8I18 C 0 A_PlaySoundEx("MMSF2/PulseSong", "Weapon")
    8I18 A 0 A_GiveInventory("SakiAltFlag", 6)
   AltLoop:
    8I18 C 0 A_JumpIfInventory("SakiAltFlag", 1, 1)
    goto AltEnd
    8I18 A 0 A_TakeInventory("SakiAltFlag", 1)
    8I18 D 4 A_FireCustomMissile("SoraNoMusicaWave", 0, 0, 0, 0)
    loop
   AltEnd:
    8I18 DCBAAA 2
    8I18 A 1 Offset(0, 38)
    8I18 A 1 Offset(0, 36) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8I18 A 6 Offset(0, 32) A_TakeInventory("UH_50_SpeedPower")
    Goto ReadyX
  }
}

actor SakiFlag : Once {}
actor SakiAltFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 999
}
actor IsAMujicaMember : Inventory {}

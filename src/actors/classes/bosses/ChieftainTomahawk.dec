actor ChieftainTomahawk : BossBase
{ //Relentless stats, or just above average.
player.scoreIcon "UB061MUG"
player.soundclass "ChieftainTomahawk" //Something not stereotypical, I hope.
player.forwardmove 1.32, 1.32
player.sidemove 1.32, 1.32
player.jumpz 14
Player.MaxHealth 3700
Health 3700 //+ 675 per person?
player.morphweapon "ChieftainTomahawk_W"
States
{
Spawn:
TMTB A 0
TMTB B 1 A_JumpIfInventory("ChieftainFlag",1,"TheLunge")
TMTB A 1 A_JumpIfInventory("ChieftainFlag",1,"TheLunge")
Goto Spawn+2
See:
TMTB BCDE 3 A_JumpIfInventory("ChieftainFlag",1,"TheLunge")
Goto Spawn
Missile:
TMTB FFFFF 1 A_JumpIfInventory("ChieftainFlag",1,"TheLunge")
TMTB GGGG 1 A_JumpIfInventory("ChieftainFlag",1,"TheLunge")
goto Spawn+2
TheLunge:
TMTB F 2 A_JumpIfInventory("ChieftainFlagX",1,"TheHold")
TMTB F 2 A_JumpIfInventory("ChieftainFlag",1,"TheLunge") //0
TheLeap:
TMTB G 10
Goto Spawn+2
TheHold:
TMTB G 2
TMTB G 2 A_JumpIfInventory("ChieftainFlagX",1,"TheHold") //0
TMTB G 2 A_JumpIfInventory("ChieftainFlag",1,"TheLunge") //0
Goto Spawn+2
ClassPain:
TMTB H 0
Goto MegamanPain
ClassDeath:
TMTB H 0
Goto MegamanDeath
}
}

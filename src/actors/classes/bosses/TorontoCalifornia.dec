//Or just name it TorCal for short. Or worse, Caltor.
actor TorontoCalifornia : BossBase
{
player.scoreIcon "UB062MUG"
player.soundclass "TorontoCalifornia"
player.forwardmove 0.8, 0.8 //1.4
player.sidemove 0.8, 0.8 //1.4
player.jumpz 10 //10
Player.MaxHealth 1500
Health 1500
player.morphweapon "TorontoCalifornia_W"
States
{
Spawn:
NJSP A 0
NJSP B 1 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP A 1 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")
Goto Spawn+2
See:
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP B 2 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")//3
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP C 2 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")//3
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP D 2 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")//3
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP E 2 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")//3
Goto Spawn
Missile:
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP FFFFF 1 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP GGGG 1 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")
NJSP A 0 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
goto Spawn+2
MissileExtended:
NJSP F 2 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger")
NJSP F 2 A_JumpIfInventory("TorCal_Animation_Flag",1,"MissileExtended")
NJSP GGGG 2 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"DeadRinger") //5
Goto Spawn+2
//
DeadRinger:
NJSP H 0 A_PlaySoundEx("misc/devilpain","Voice")
NJSP HHHHHHHHH 2 A_SpawnItemEx("PainFX",0,3)
NJSP H 2 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"Collecting_Life_Insurance_Money")
Goto Spawn+2
Collecting_Life_Insurance_Money:
NJSP H 6
NJSP H 2 A_JumpIfInventory("TorCal_Animation_Flag_X",1,"Collecting_Life_Insurance_Money")
Goto Spawn+2
//
ClassPain:
NJSP H 0
Goto MegamanPain
ClassDeath:
NJSP H 0
Goto MegamanDeath
}
}

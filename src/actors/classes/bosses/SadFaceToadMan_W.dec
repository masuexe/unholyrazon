actor RainFlushOfSadToadNess : BasicExplosion
{
var int user_C;
damagetype "SadToad"
Obituary "%o was flushed away by \cdToadman\c- (%k) sadness."
ReactionTime 37
States
{
Spawn:
TNT1 A 0
TNT1 A 1
TNT1 A 0 A_PlaySoundEx("weapon/rainflush","Voice")
TNT1 A 0 A_Explode(200,10000,0,0,10000)
Spawn2:
TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("SadToadRainFX",random(-1256,1768),random(-1256,1768),256,-30,0,-30,90,128)
TNT1 A 1 A_CountDown
TNT1 A 0 A_SetUserVar("user_C",user_C+1)
TNT1 A 0 A_JumpIf(user_C>=3,"Spawn3")
loop
Spawn3:
TNT1 A 0 A_Explode(65,10000,0,0,10000)
TNT1 A 0 A_SetUserVar("user_C",0)
goto Spawn2
}
}




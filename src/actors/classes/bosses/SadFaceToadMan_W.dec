actor SadFaceToadMan_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsPissedFlag", 1, 2)
    TNT1 A 0 A_Jump(256, "PickupNormal")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor SadFaceToadMan_Ready8_P : SadFaceToadMan_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor SadFaceToadManHealthGiver : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfHealthLower(CallACS("rz_CountInv_BossSpawnHealthFlag") * 0.75,"GiveHealth")
goto Pickup3
GiveHealth:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 50)
stop
Pickup3:
TNT1 A 0 A_GiveInventory("IsPissedFlag")
stop
}
}


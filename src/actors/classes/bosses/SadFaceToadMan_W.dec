actor SadFaceToadMan_W_ScriptBar : ScriptBar {}
actor SadFaceToadMan_W : BaseUnholyBossWep
{
Tag "$TAG_Boss104_W"
Obituary "%o became a fan of \cdToadman\c- (%k)."
Inventory.Pickupmessage "\cdMy tears are made of acid."
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower3000"
States
{
Spawn:
8I04 [ 1
wait

Deselect:
8I04 A 0
goto DeselectSwap
Select:
8I04 A 0
goto SelectSwap

Ready:
8I04 A 0 A_GiveInventory("UnholyPowerLimit_F",3000)
8I04 A 0 ACS_NamedExecuteAlways("core_weaponcolor", 0, SADFACETOADMAN_DYE)
// ExtraLife: morphActorToBoss (Ready may re-enter online)
goto ReadyX
ReadyX:
8I04 A 0 A_JumpIfHealthLower(2, "PissedRage")
8I04 A 1 A_WeaponReady
loop
ReadyMadX:
8I04 F 2 A_GiveInventory("SadFaceToadMan_Ready0_P")
8I04 F 0 A_GiveInventory("UnholyBossAmmo200", 2)
loop

Fire:
8I04 A 0 A_JumpIfInventory("IsPissedFlag",1,"MadFire")
8I04 A 0 A_GiveInventory("VivifyDelay6")
8I04 A 0 A_Refire(1)
8I04 A 0 A_JumpIfInventory("UnholyPower3000",3000,"FireSadness")
8I04 A 0 A_TakeInventory("EternalPainFlag")
8I04 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 B 8 A_JumpIfInventory("EternalPainFlag",1,"FireFail")
8I04 CD 6 A_JumpIfInventory("EternalPainFlag",1,"FireFail")
8I04 CDCD 4 A_JumpIfInventory("EternalPainFlag",1,"FireFail")
8I04 CDCD 3 A_JumpIfInventory("EternalPainFlag",1,"FireFail")
Goto IGetToAttack
FireFail:
8I04 B 0 A_TakeInventory("VivifyDelay6")
8I04 B 2 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
goto ReadyX

IGetToAttack:
8I04 C 0 A_SpawnItemEx("RainFlushOfTears",0,0,28)
8I04 C 0 A_GiveInventory("VivifyDelay6")
8I04 CDCDCDCDCDCDCDCD 2 A_JumpIfHealthLower(2, "PissedRage")
8I04 D 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 DDCCBBAA 2 A_JumpIfHealthLower(2, "PissedRage")
Goto ReadyX
FireSadness:
8I04 B 0 A_TakeInventory("UnholyPower3000", 1)
8I04 B 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I04 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 B 0 A_PlaySound("S_Spin/EggPain",1,0.80,0,ATTN_NONE)
8I04 B 8
8I04 CD 6
8I04 CDCD 4
8I04 CDCD 3
8I04 C 0 A_GiveInventory("VivifyDelay6")
8I04 C 0 A_SpawnItemEx("RainFlushOfSadToadNess",0,0,28)
8I04 CDCDCDCD 2
8I04 D 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 D 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8I04 DDCCBBAA 2 A_JumpIfHealthLower(2, "PissedRage")
Goto ReadyX

Altfire:
8I04 A 0 A_JumpIfInventory("IsPissedFlag",1,"MadAltfire")
8I04 A 0 A_JumpIf(CallACS("core_checkfooting"), "ToadJump")
goto ReadyX
ToadJump:
8I04 A 0 A_GiveInventory("VivifyDelay4")
8I04 A 0 A_Refire(1)
8I04 A 2 Offset(0,52)
8I04 E 2 Offset(0,72)
8I04 E 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8I04 E 0 ThrustThingZ(0,76,0,0)
8I04 E 1 A_Recoil(-24)
goto ToadJumpWait
ToadJumpWait:
8I04 E 0 A_JumpIfHealthLower(2, "PissedRage")
8I04 E 2 A_SpawnItemEx("ToadHuggingLeap",0,0,16,momx,momy,momz,0,8,0)
8I04 E 0 A_JumpIf(CallACS("core_checkfooting"), "Splat")
8I04 E 0 A_JumpIf(momz==0,"SplatV")
loop
SplatV:
8I04 E 1 A_JumpIfHealthLower(2, "PissedRage")
8I04 E 0 A_JumpIf(CallACS("core_checkfooting"), "Splat")
8I04 E 0 A_JumpIf(momz==0,"Splat")
goto ToadJumpWait
Splat:
8I04 E 0 A_ChangeVelocity(momx,momy,0,CVF_REPLACE)
8I04 E 1 Offset(0,62)A_SpawnItemEx("ToadHuggingLeap",0,0,16,momx,momy,momz,0,8,0)
8I04 E 1 Offset(0,52)A_SpawnItemEx("ToadHuggingLeap",0,0,16,momx,momy,momz,0,8,0)
8I04 A 1 Offset(0,42)A_SpawnItemEx("ToadHuggingLeap",0,0,16,momx,momy,momz,0,8,0)
Goto ReadyX

Flash:
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", SADFACETOADMAN_DYE2)
TNT1 A 5 ACS_NamedExecuteWithResult("core_chargecolor", SADFACETOADMAN_DYE3)
loop

PissedRage:
8I04 A 0 A_JumpIfInventory("IsPissedFlag",1,"ReadyMadX")
8I04 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I04 A 0 ThrustThingZ(0,45,0,0)
8I04 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8I04 A 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 0, ELP_NATIVE)
8I04 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 A 0 ACS_NamedExecuteAlways("ub_BossEnrageMusic",0,104)//Music call
8I04 A 0 A_GunFlash
8I04 BCD 2
8I04 C 0 A_Stop
goto TRYTOBEPOLITE
TRYTOBEPOLITE:
8I04 H 0 A_GiveInventory("SadFaceToadManHealthGiver")
8I04 H 0 A_PlaySound("BUTTSCKS")
8I04 H 0 A_SpawnItemEx("SadToadParticleFX",random(-4,4),random(-4,4),48,random(-20,20),random(-20,20),random(-15,15))
8I04 H 1 A_SetAngle(angle-20.0)
8I04 I 0 A_JumpIfInventory("IsPissedFlag",1,"FUCKOFFFAGGOT")
8I04 I 0 A_GiveInventory("SadFaceToadManHealthGiver")
8I04 I 0 A_PlaySound("BUTTSCKS")
8I04 I 0 A_SpawnItemEx("SadToadParticleFX",random(-4,4),random(-4,4),48,random(-20,20),random(-20,20),random(-15,15))
8I04 I 1 A_SetAngle(angle-20.0)
8I04 C 0 A_JumpIfInventory("IsPissedFlag",1,"FUCKOFFFAGGOT")
8I04 C 0 A_GiveInventory("SadFaceToadManHealthGiver")
8I04 C 0 A_PlaySound("BUTTSCKS")
8I04 C 0 A_SpawnItemEx("SadToadParticleFX",random(-4,4),random(-4,4),48,random(-20,20),random(-20,20),random(-15,15))
8I04 C 1 A_SetAngle(angle-20.0)
8I04 D 0 A_JumpIfInventory("IsPissedFlag",1,"FUCKOFFFAGGOT")
8I04 D 0 A_GiveInventory("SadFaceToadManHealthGiver")
8I04 D 0 A_PlaySound("BUTTSCKS")
8I04 D 0 A_SpawnItemEx("SadToadParticleFX",random(-4,4),random(-4,4),48,random(-20,20),random(-20,20),random(-15,15))
8I04 D 1 A_SetAngle(angle-20.0)
8I04 H 0 A_JumpIfInventory("IsPissedFlag",1,"FUCKOFFFAGGOT")
loop
FUCKOFFFAGGOT:
8I04 GF 2
8I04 F 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8I04 F 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 F 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Goto ReadyMadX

//DESP Attacking
MadFire:
8I04 G 0 A_GiveInventory("VivifyDelay6")
8I04 G 0 A_Refire(1)
8I04 G 0 A_JumpIfInventory("UnholyPower3000",3000,"ToadgassoAttackko")
8I04 G 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 G 5
8I04 HIH 4
8I04 IHIH 3
8I04 I 0 Radius_Quake(6,35,0,50,0)
8I04 I 0 A_FireCustomMissile("SadToadShockWaveSpawner",0,0)
8I04 I 0 A_SpawnItemEx("MadRainFlusherGusher",0,0,28)
8I04 I 0 A_GiveInventory("VivifyDelay6")
8I04 IHIHIHIH 3
8I04 I 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 IHGF 3
Goto ReadyMadX

MadAltfire:
TOAH A 0 A_JumpIf(CallACS("core_checkfooting"), "MadToadJump")
goto ReadyMadX
MadToadJump:
8I04 F 0 A_GiveInventory("VivifyDelay4")
8I04 F 0 A_Refire(1)
8I04 F 2 Offset(0,52)
8I04 J 2 Offset(0,72)
8I04 J 0 A_PlaySoundEx("weapon/superarmuse","Weapon")
8I04 J 0 ThrustThingZ(0,84,0,0)
8I04 J 1 A_Recoil(-36)
MadFaceWait:
8I04 J 0 A_GiveInventory("UnholyBossAmmo200",1)
8I04 J 2 A_SpawnItemEx("AngryToadLeap",0,0,16,momx,momy,momz,0,8,0)
8I04 J 0 A_JumpIf(CallACS("core_checkfooting"), "MadSplat")
8I04 J 0 A_JumpIf(momz==0,"MadSplatV")
loop
MadSplatV:
8I04 J 1 A_SpawnItemEx("AngryToadLeap",0,0,16,momx,momy,momz,0,8,0)
8I04 J 0 A_JumpIf(CallACS("core_checkfooting"), "MadSplat")
8I04 J 0 A_JumpIf(momz==0,"MadSplat")
goto MadFaceWait
MadSplat:
8I04 J 0 //ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 J 0 Radius_Quake(6,20,0,50,0)
8I04 J 0 A_FireCustomMissile("SadToadCrumblingExplosive",0,0,0,0)
8I04 J 0 A_FireCustomMissile("SadToadShockWaveSpawner",0,0,0,0)
8I04 J 2 Offset(0,54)//A_Stop
8I04 F 2 Offset(0,36)
8I04 F 8
8I04 F 2 Offset(0,34)//ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
Goto ReadyMadX

Reload:
8I04 G 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "StormFlush")
goto ReadyMadX
StormFlush:
8I04 G 0 A_TakeInventory("UnholyBossAmmo200",200)
8I04 G 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 G 0 A_GiveInventory("VivifyDelay5")
8I04 GBGBGB 5 A_PlaySound("misc/gravitywarn")
8I04 H 0 Radius_Quake(6,35,0,50,0)
8I04 H 0 A_FireCustomMissile("SadToadShockWaveSpawner",0,0)
8I04 H 0 A_FireCustomMissile("SadToadTornado",0,0,0,0)//75
8I04 H 0 A_FireCustomMissile("SadToadTornado",180,0,0,0)//-75
8I04 HH 0 A_FireCustomMissile("SadToadLightningTracer",random(-150,150),0,0,0)
8I04 H 0 A_GiveInventory("VivifyDelay6")
8I04 HIHIHIHI 2 A_FireCustomMissile("SadToadLightningTracer",random(-150,150),0,0,0)
TOAH A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 GF 3
Goto ReadyMadX

ToadgassoAttackko:
8I04 G 0 A_GiveInventory("UnholyPowerDazzle_F")
8I04 G 0 A_TakeInventory("UnholyPower3000", 1)
8I04 G 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
8I04 G 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8I04 G 0 A_GiveInventory("CutterFlag",6)
8I04 G 0 A_PlaySoundEx("misc/alarmlong","Weapon")
8I04 GBGBGBGBGBGB 4
ToadgassoAttackLoop:
8I04 G 0 A_GiveInventory("VivifyDelay5")
8I04 G 0 A_TakeInventory("CutterFlag",1)
8I04 G 0 ThrustThingZ(0,60,0,0)
8I04 G 0 A_Recoil(-125)
8I04 G 0 A_PlaySoundEx("S_Spin/EggPain","Body")
8I04 GBGB 2
8I04 H 0 ThrustThingZ(0,125,1,0)
8I04 H 0 Radius_Quake(6,35,0,50,0)
8I04 H 0 A_PlaySoundEx("BUTTSCKS","Weapon")
8I04 H 0 A_FireCustomMissile("SadToadShockWaveSpawner",0,0)
8I04 HH 0 A_FireCustomMissile("SadToadTornado",random(-150,150),0,0,0)
8I04 H 0 A_FireCustomMissile("SadToadCrumblingExplosive")
8I04 HHHH 0 A_FireCustomMissile("SadToadLightningTracer",random(-150,150),0,0,0)
8I04 H 0 A_SpawnItemEx("MadRainFlusherGusher",0,0,28)
8I04 HI 2
8I04 H 0 A_GiveInventory("VivifyDelay6")
8I04 CD 2
8I04 HICD 3
8I04 G 0 A_JumpIfInventory("CutterFlag",1,"ToadgassoAttackLoop")
Goto HUSEEAH
HUSEEAH:
8I04 G 0 A_TakeInventory("UnholyPowerDazzle_F")
8I04 G 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8I04 G 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
8I04 GBFA 3
Goto ReadyMadX
}
}


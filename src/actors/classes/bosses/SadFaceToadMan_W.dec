actor SadToadExplosive : BasicProjectile
{
Translation "192:192=190:190", "198:198=189:189"
Damagetype "SadToad"
Obituary "%o became \cabest friends\c- with \cdToadman\c- (%k)."
+RIPPER
+NOINTERACTION
+DONTBLAST
Reactiontime 20
damage (0)
height 6
radius 6
Scale 2.5
States
{
Spawn:
X_BF V 0
X_BF V 0 A_ChangeVelocity(0,0,momz,3)
X_BF VVWWXXYY 1 A_JumpIf(ceilingz-z>6, "Spawn2")
X_BF V 0 A_JumpIf(momz==0,"Death")
X_BF V 0 A_CountDown
Goto Spawn+2
Spawn2:
X_BF V 0 A_ChangeFlag("RIPPER",0)
X_BF V 0 A_ChangeFlag("NOINTERACTION",0)
X_BF VWXY 2 A_ChangeVelocity(0,0,momz,3) 
X_BF V 0 A_JumpIf(momz==0,"Death")
X_BF V 0 A_CountDown
Goto Spawn2+2
Death:
TNT1 A 0 A_ChangeFlag("FORCEXYBILLBOARD", true)
TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
X_8G ABCEFF 1 A_Explode(30,80,0)
X_8G ECBA 1
stop
}
}


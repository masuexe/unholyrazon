actor SadToadTornado : BasicProjectile
{
Translation "192:192=180:180","198:198=190:190"
Damagetype "SadToadWind"
Obituary "\cdToadman\c- (%k) sent %o \caSky-High\c-."
+OLDRADIUSDMG

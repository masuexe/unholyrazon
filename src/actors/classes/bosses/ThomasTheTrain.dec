actor ThomasTheTrain : BossBase {
  Player.ScoreIcon "UB519MUG"
  Player.SoundClass "ThomasTheTrain"
  Player.DamageScreenColor "blue"
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 0.725, 0.725
  Player.JumpZ 12
  Player.MaxHealth 3500
  Health 3500
  Player.MorphWeapon "ThomasTheTrain_W"
  States {
   Spawn:
    9A19 A 0
    9A19 I 1  // B
    9A19 A 1
    goto Spawn+2
   See:
    9A19 IJKL 5  // BCDE
    goto Spawn
   Missile:
    9A19 F 0 A_JumpIfInventory("VivifyDelay8", 1, "Missile2")
    9A19 F 0 A_JumpIfInventory("ThomasTheTrainFlag", 5, "ARunF")
    9A19 F 0 A_JumpIfInventory("ThomasTheTrainFlag", 4, "ARunE")
    9A19 F 0 A_JumpIfInventory("ThomasTheTrainFlag", 3, "ARunD")
    9A19 F 0 A_JumpIfInventory("ThomasTheTrainFlag", 2, "ARunC")
    9A19 F 0 A_JumpIfInventory("ThomasTheTrainFlag", 1, "ARunB")
    9A19 F 5
    9A19 G 4
    goto Spawn
   Missile2:
    9A19 MNONMNONMNONM 2
    goto Spawn

   ARunB:
    9A19 M 5
    goto Spawn
   ARunC:
    9A19 N 5
    goto Spawn
   ARunD:
    9A19 O 5
    goto Spawn
   ARunE:
    9A19 N 5
    goto Spawn
   ARunF:
    9A19 M 0 A_TakeInventory("ThomasTheTrainFlag", 4)
    goto ARunB

   ClassPain:
    9A19 H 0
    goto MegamanPain
   ClassDeath:
    9A19 H 0
    goto MegamanDeath
  }
}

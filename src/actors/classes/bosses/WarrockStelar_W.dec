Actor SFTriCrystalR
{
PROJECTILE
-MISSILE
+THRUACTORS
+MOVEWITHSECTOR
+SKYEXPLODE
+DONTBLAST
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+BOUNCEONFLOORS
+DONTSPLASH
+CANBOUNCEWATER
+FORCEXYBILLBOARD
+BRIGHT
+THRUSPECIES
Species "TriCrystal"
Bouncecount 10
Bouncefactor 1.0
Damage 0
Speed 25
Radius 8
Height 8
Scale 2.5
States
{
Spawn:
X_5H K 0
X_5H K 0 Thing_SetTranslation(0, CLR_FIRESTORM)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball1",48,0,0,0,0,0,0,1)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball2",96,0,0,0,0,0,0,1)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball3",144,0,0,0,0,0,0,1)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball1",48,0,0,0,0,0,180,1)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball2",96,0,0,0,0,0,180,1)
X_5H K 0 A_SpawnItemEx("SFTriCrystalFireball3",144,0,0,0,0,0,180,1)
X_5H K 0 A_ChangeFlag("MISSILE",1)
SpawnL:
X_5H K 0 A_JumpIfInventory("CutterFlag",4,"BackToSender")
X_5H KKKKKLMNO 2 A_JumpIf(CallACS("core_targetexists")==0,"Death")
X_5H K 0 A_GiveInventory("CutterFlag",1)
loop
BackToSender:

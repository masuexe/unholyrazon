Actor SFMoaiFall : AstroCrush
{
Translation "192:192=88:88", "198:198=92:92"
Obituary "%o found themselves crushed by %k's Moai Fall."
Damagetype "SFMoaiFall"
+DONTBLAST
+THRUGHOST
Damage(100)
Scale 3.5
Radius 16
Height 24
States
{
Spawn:
QBOP D 0
QBOP D 0 A_PlaySoundEx("MMSF3/PuffBlastFalling", "SoundSlot6")
QBOP D 0 A_ChangeVelocity(0,0,momz,CVF_RELATIVE|CVF_REPLACE)
QBOP DDDDDDDDD 1 A_JumpIf(ceilingz-z>24,"Spawn2")
QBOP D 0 A_JumpIf(momz==0,"Death")
QBOP D 0 A_CountDown
Goto Spawn+3
Spawn2:
QBOP D 0 A_ChangeFlag("RIPPER",0)
QBOP D 0 A_ChangeFlag("NOINTERACTION",0)
QBOP DDD 3 A_ChangeVelocity(0,0,momz,CVF_RELATIVE|CVF_REPLACE) 
QBOP D 0 A_JumpIf(momz==0,"Death")
QBOP D 0 A_CountDown
Goto Spawn2+2
Death:
QBOP D 0 A_PlaySoundEx("SJBOOM1","SoundSlot5")
QBOP D 0 A_ChangeFlag(NOGRAVITY,1)
QBOP D 0 Radius_Quake(4,20,0,40,0)
QBOP D 0 A_Explode(250,192,0,0,24)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),0,1)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),90,1)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),180,1)
QBOP D 1 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),270,1)
QBOP D 69 A_ChangeFlag("NOINTERACTION",1)
QBOP Z 1
QBOP D 4
QBOP Z 1
QBOP D 3
QBOP Z 1
QBOP D 2
QBOP Z 0 A_SetTranslucent(0.7)
QBOP ZDZDZD 1
stop
Crash:
XDeath:
QBOP D 0 A_PlaySoundEx("SJBOOM1","SoundSlot5")
QBOP D 0 A_ChangeFlag(NOGRAVITY,1)
QBOP D 0 A_Explode(250,192,0,0,24)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),0,1)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),90,1)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),180,1)
QBOP D 0 A_SpawnItemEx("MoaiFallSplit",4,0,0,random(4,8),0,random(4,8),270,1)
TNT1 A 1
stop
}
}


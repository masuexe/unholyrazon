actor WarRockStelar_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BattleCardDelay", 1, "PickupNormal")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo250", 250, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_JumpIfInventory("SFBusterNoCharge", 1, "No")
    TNT1 A 0 A_GiveInventory("SFBusterCharge", 4)
    TNT1 A 0 A_JumpIfInventory("SFBusterIsCharged", 1, "No")
    TNT1 A 0 A_JumpIfInventory("SFBusterCharge", 120, "ChargedSound")
    stop
   ChargedSound:
    TNT1 A 0 A_PlaySoundEx("MMSF3/Charged", "SoundSlot7")
    TNT1 A 0 A_GiveInventory("SFBusterIsCharged")
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor WarRockStelar2_Ready0_P : WarRockStelar_Ready0_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BattleCardDelay", 1, "PickupNormal")
    TNT1 A 0 A_Jump(256, "PickupReload")
    goto PickupReload
  }
}

actor WR_LockOnWatcher : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
SpawnL:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockOnFlag",1,2) TNT1 A 0 A_Jump(256,"Death")
TNT1 A 0 A_GiveToTarget("WR_LockOnDetector_P")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockedTID",1000,"SpawnLocked")
TNT1 A 1 A_SetArg(0,Args[0]-1)
TNT1 A 0 A_JumpIf(Args[0]<=0,"SpawnL2")
loop
SpawnL2:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockOnFlag",1,2) TNT1 A 0 A_Jump(256,"Death")
TNT1 A 0 A_GiveToTarget("WR_LockOnDetector_P")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockedTID",1000,"SpawnLocked")
TNT1 A 0 A_GiveToTarget("WarrockTargetSound_PU")
TNT1 A 1 A_SetArg(0,10)
goto SpawnL
SpawnLocked:
TNT1 A 0 A_GiveToTarget("WR_LockedSound_P")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockedTID",1000,2) TNT1 A 0 A_Jump(256,"SpawnL")
TNT1 A 0 A_JumpIfInTargetInventory("WR_LockOnFlag",1,2) TNT1 A 0 A_Jump(256,"Death")
TNT1 A 0 A_GiveToTarget("WR_LockOnDetector_P")
TNT1 A 1
goto SpawnLocked+1
Death:
TNT1 A 0 A_TakeFromTarget("WR_LockedTID")
stop
}
}

actor WR_LockOnDetector_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("WR_LockOnDetector",0,0,32,cos(-pitch),0,sin(-pitch),0,8192)
stop// TNT1 A 0 A_FireBullets(0,0,0,0,"WR_LockOnDetector",FBF_NOFLASH|FBF_NORANDOMPUFFZ)
}
}


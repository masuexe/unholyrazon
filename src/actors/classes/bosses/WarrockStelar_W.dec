actor SF_ShieldHitbox1 : BasicShieldHitbox
{
Translation "192:192=138:138","198:198=104:104"
Meleerange 28 //Warp X
Accuracy -16 //Warp Y 
Mass 8 //Warp Z
States
{
Pain:
TNT1 A 0 A_PlaySound("SF2/ShieldHit")
TNT1 A 0 A_SpawnItemEx("SF_ShieldDeathFX")
goto Spawn
}
}

actor SF_ShieldHitbox2 : SF_ShieldHitbox1{Accuracy -8}
actor SF_ShieldHitbox3 : SF_ShieldHitbox1{Accuracy 0}
actor SF_ShieldHitbox4 : SF_ShieldHitbox1{Accuracy 8}
actor SF_ShieldHitbox5 : SF_ShieldHitbox1{Accuracy 16}

actor SF_ShieldDeathFX : ProtoShieldDeathFX

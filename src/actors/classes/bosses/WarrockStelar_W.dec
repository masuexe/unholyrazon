Actor MoaiFallAOEMarker : BasicClientside
{
+BRIGHT
Translation "192:192=104:104","198:198=104:104"
Renderstyle "Translucent"
VisibleToPlayerClass WarRockStelar
Alpha 0.75
Scale 2.0
States
{

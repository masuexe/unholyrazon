Actor SFShuriken : BasicProjectile
{
Translation "192:192=128:128","198:198=3:3"
Damagetype "WarRockStelar"
Obituary "\cvWar-Rock (%k)'s \c-Shuriken took %o out without a sound."
+THRUGHOST
+HITTRACER
Damage(250)
Radius 16
Height 16
Speed 25
Scale 1.5
States
{
Spawn:
6P17 C 0
6P17 C 0 A_JumpIfInventory("CutterFlag",3,"Split")
6P17 CDEF 4
6P17 C 0 A_GiveInventory("CutterFlag",1)
goto Spawn+1
Crash:
XDeath:
TNT1 A 0 A_SpawnItemEx("SFShurikenStuck_P",0,0,0,0,0,0,0,1+SXF_TRANSFERPOINTERS)
stop
Death:
6P17 C 0 A_SetGravity(0.0)
6P17 C 0 
6P17 C 0 A_CheckFloor("DeathX")
6P17 C 0 A_CheckCeiling("DeathX")
TNT1 A 0 A_PlaySoundEx("Shin_1/Ting","Voice")
TNT1 A 1 A_SpawnItemEx("SFShurikenStuck",0,0,0,0,0,0,0,1)
stop
DeathX:
TNT1 A 1
stop
Split:
TNT1 A 0 A_SpawnItemEx("SFShuriken2",0,0,0,18,0,0,45,1)
TNT1 A 0 A_SpawnItemEx("SFShuriken2",0,0,0,18,0,0,135,1)
TNT1 A 0 A_SpawnItemEx("SFShuriken2",0,0,0,18,0,0,225,1)
TNT1 A 1 A_SpawnItemEx("SFShuriken2",0,0,0,18,0,0,315,1)
stop
}
}

Actor SFShurikenStuck_P : BasicExplosion
{
Damagetype "SFShuriken"
Obituary "%o tragically bled out from one of %k's Shinobi tools."
Reactiontime 10 //8
Scale 1.5
Args 0,0,28
States
{
Spawn:
6P17 D 0
6P17 D 0 ACS_NamedExecuteWithResult("uh_SetPtrCoordToArgs",AAPTR_TRACER)
Latch:
6P17 D 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Death") //At the beginning so that it despawns immediately if the spawning projectile killed the hit person
6P17 DDDDDD 1 A_Warp(AAPTR_TRACER,Args[0],Args[1],Args[2],angle,WARPF_ABSOLUTEOFFSET|WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
6P17 C 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Death")
6P17 DDDDDD 1 A_Warp(AAPTR_TRACER,Args[0],Args[1],Args[2],angle,WARPF_ABSOLUTEOFFSET|WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
6P17 D 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Death")
6P17 DDDDDD 1 A_Warp(AAPTR_TRACER,Args[0],Args[1],Args[2],angle,WARPF_ABSOLUTEOFFSET|WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
6P17 D 0 A_Explode(32,24,0,0,24) //I'm 95% sure this should be fine
6P17 D 0 A_CountDown
loop
Death:
TNT1 A 0
stop
}
}

Actor SFShurikenStuck : SFShuriken
{
-HITTRACER
Obituary "%o accidently touched one of %k's Shinobi tools."
States
{
Spawn:
6P17 D 0
6P17 D 80
Crash:
XDeath:
Death:
6P17 Z 0 A_ChangeFlag("NOINTERACTION",1)
6P17 Z 1
6P17 D 5
6P17 Z 1
6P17 D 4
6P17 Z 1
6P17 D 3
6P17 Z 1
6P17 D 2
6P17 Z 0 A_SetTranslucent(0.7)
6P17 ZDZDZD 1
stop
}
}


Actor SFTriCrystalFireball1 : BasicExplosion
{
Obituary "%k's Tri-Crystal lit a fire in %o's heart."
Damagetype "SFTriCrystal"
+FORCEXYBILLBOARD
+BRIGHT
Height 8
Radius 8
Scale 3.0
Args 48
States
{
Spawn:
X_1E A 0
X_1E A 0 A_ReArrangePointers(0,0,2)//Copy Target(Crystal) to Tracer(Fireball)
X_1E A 0 A_TransferPointer(2,0,2,2)//Fetch Target(Player) from Target(Crystal) to Target(Fireball)
SpawnL:
X_1E A 0 A_JumpIf(CallACS("core_targetexists",1)==0,"Death")
X_1E AA 1 A_Warp(8,Args[0],0,0,6,4+8+16)//INTERPOLATE+CALLERANGLE+NOCHECKPOISITION
X_1E A 0 A_Explode(72,56,0,0,14) //56,48,0,0,8
X_1E BB 1 A_Warp(8,Args[0],0,0,6,4+8+16)
X_1E A 0 A_Explode(72,56,0,0,14)
X_1E CC 1 A_Warp(8,Args[0],0,0,6,4+8+16)
X_1E A 0 A_Explode(72,56,0,0,14)
loop
Death:
X_1E A 0
stop
}
}


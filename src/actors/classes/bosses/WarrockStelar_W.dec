8P51 L 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 L 0 A_SetArg(0,Args[0]-1)
loop
SpawnL2:
8P51 M 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 M 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 M 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 M 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 M 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 M 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 N 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 N 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 N 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 N 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 N 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 N 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 N 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 N 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 N 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 N 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 N 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 N 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 M 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 M 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 M 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 M 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
8P51 M 0 A_JumpIfInTargetInventory("WR_Locked",1,2) 8P51 L 0 A_Jump(256,"Death")
8P51 M 1 A_Warp(2,0,0,32,0,WARPF_NOCHECKPOSITION|WARPF_COPYINTERPOLATION)
8P51 N 0 A_SetArg(0,10)
goto SpawnL
Death:
TNT1 A 0
stop
}
}

actor WR_LockOnWarp : BasicWatcher {
  args -100  // X Offset
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", CallACS("core_gettarget")-999, USP_TOGGLEON)
    TNT1 A 0 A_GiveToTarget("Nudge")
    goto Warp
   Warp:
    TNT1 A 1 ACS_NamedExecuteWithResult("rz_WarpToTID", CallACS("ub_countinv_acs",51,2), Args[0], WARPF_USECALLERANGLE, 2)
    goto WarpEnd
   WarpEnd:
    TNT1 A 0 A_Warp(2,0,0,28,0,24)
    TNT1 A 4 A_PlaySound("MMSF3/LockOnAttack", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", CallACS("core_gettarget")-999, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    stop
  }
}
actor WR_LockOnWarp_RadarMissile : WR_LockOnWarp {args -192}
actor WR_LockOnWarp_PuffBlast : WR_LockOnWarp {args -128}
actor WR_LockOnWarp_GhostPulse : WR_LockOnWarp {args -36}
actor WR_LockOnWarp_Shuriken : WR_LockOnWarp {args -16}
actor WR_LockOnWarp_StunKnuckle : WR_LockOnWarp {args -32}
actor WR_LockOnWarp_HurricaneDance : WR_LockOnWarp {args -48}
actor WR_LockOnWarp_MagicCrystal : WR_LockOnWarp {args -192}
actor WR_LockOnWarp_PlasmaSword : WR_LockOnWarp {args -64}


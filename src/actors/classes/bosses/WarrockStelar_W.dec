8H51 B 1 Offset(3,48) A_FireCustomMissile("SFHurricaneDanceEndFX",270,0,0,0)
8H51 B 1 Offset(-2,40) A_FireCustomMissile("SFHurricaneDanceEndFX",315,0,0,0)
Goto ReadyX
HurricaneDance_LockOn:
8H51 A 2 A_SpawnItemEx("WR_LockOnWarp_HurricaneDance")
goto HurricaneDanceAmmoCheck+1

MagicCrystalAmmoCheck:
8H51 A 0 A_JumpIfInventory("WR_LockedTID", 1000, "MagicCrystal_LockOn")

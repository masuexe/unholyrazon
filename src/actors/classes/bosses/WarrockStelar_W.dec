}

actor SFMegaPlasmaSword : BasicProjectile
{
Translation "192:192=138:138","198:198=104:104"
+THRUACTORS
+DONTSPLASH
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
damage (0)

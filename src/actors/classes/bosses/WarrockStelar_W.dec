HurricaneDanceAmmoCheck:
8H51 A 0 A_JumpIfInventory("WR_LockedTID", 1000, "HurricaneDance_LockOn")
8H51 A 0 ACS_NamedExecuteWithResult("rz_MoveSFCardQueue")
8H51 A 0 A_JumpIfInventory("SpinTime",1,"SpinEnd")
8H51 A 0 A_JumpIf(!CallACS("core_CheckFooting"),"SpinBegin")
8H51 A 2 A_ChangeVelocity(0, 0, 28, CVF_RELATIVE|CVF_REPLACE)
Goto SpinBegin
SpinBegin:
8H51 A 0 A_GiveInventory("StartHDance_PU")
8H51 B 1 Offset(-24,26)
8H51 B 1 Offset(-48,20)
8H51 B 1 Offset(-72,14)
8H51 B 1 Offset(-96,20)
8H51 B 1 Offset(-120,26)
8H51 B 1 Offset(-144,32)
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
Spin:
TNT1 A 0 A_GiveInventory("SFHurricaneDance_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_JumpIfInventory("CutterFlag",30,1)
Loop
TNT1 A 0 A_TakeInventory("CutterFlag",30)
TNT1 A 0 A_GiveInventory("TopSpinFlag",1)
TNT1 A 0 A_JumpIfInventory("TopSpinFlag",5,"SpinEnd")
TNT1 A 0 A_JumpIf(momz==0,"SpinEnd")
Loop
SpinEnd:
TNT1 A 0 A_TakeInventory("TopSpinFlag") 
TNT1 A 0 A_TakeInventory("SpinTime")
TNT1 A 1 A_TakeInventory("CutterFlag")
8H51 B 0 A_TakeInventory("WarrockHDFlag")
8H51 B 1 Offset(64,144) A_FireCustomMissile("SFHurricaneDanceEndFX",0,0,0,0)
8H51 B 1 Offset(48,128) A_FireCustomMissile("SFHurricaneDanceEndFX",45,0,0,0)

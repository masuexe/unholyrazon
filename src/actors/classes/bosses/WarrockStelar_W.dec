Actor RadarMissileShot : BasicProjectile
{
Translation "192:192=4:4","198:198=176:176","199:199=94:94","202:202=86:86"
Damagetype "WarRockStelar"
Obituary "\cvWar-Rock (%k)'s \c-Radar Missile somehow found %o by chance."
+BOUNCEONFLOORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+DONTSPLASH
Bouncefactor 1.0
Bouncecount 5
Damage (50)
Radius 10
Height 10
Speed 15
Scale 2.5
states
{
Spawn:
X_4G A 0
X_4G A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_4G ABAB 2 A_ScaleVelocity(1.1)
X_4G A 0 A_Stop
X_4G A 0 A_GiveInventory("ReSyncPickup")
X_4G AB 2
X_4G AA 1 A_GiveToTarget("UH_TargetMarker")
X_4G A 0 ACS_NamedExecuteAlways("core_aimattargetcursor", 0, CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 0)
X_4G B 2
X_4G A 0 A_SpawnItemEx("RadarMissileShot2",0,0,0,cos(-pitch)*70,0,sin(-pitch)*70,0,1)
stop
Death:
TMFX A 0 A_Explode(70,80,0)
TMFX ABCD 2
stop
}
}

Actor RadarMissileShot2 : RadarMissileShot //FastProjectile? Fuck if I know
{
Obituary "\cvWar-Rock (%k)'s \c-Radar Missile found %o."
+SKYEXPLODE
-BOUNCEONFLOORS
-BOUNCEONWALLS
-BOUNCEONCEILINGS
Damage (70)
Speed 70
States
{
Spawn:
X_4G A 0
X_4G AB 1 A_ScaleVelocity(1.15)
loop
Death:
TNT1 A 0 A_SetScale(1.5)
TNT1 A 0 A_Explode(120,128,0,0,16)
TNT1 A 0 A_PlaySound("Pokemon/Bide",5)
Y_4L ABCDEFGHIJKLMNOPQRST 1
stop
}
}

Actor SFPuffBlast : BasicProjectile
{
Translation "192:192=34:34","198:198=36:36"
Damagetype "WarRockStelar"
Obituary "%o suffocated on \cvWar-Rock (%k)'s \c-Puff Blast."
Renderstyle "Translucent"
Alpha 0.7
+BRIGHT
+DONTBLAST
+RIPPER
+THRUGHOST
+BOUNCEONFLOORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
+DONTSPLASH
Damage (0)
Radius 12
Height 12
Speed 15
Scale 2.5
Reactiontime 8
States
{
Spawn:
6Q28 W 0
6Q28 WX 2
6Q28 YYYYY 1 A_SetScale(scaleX+0.15)
6Q28 W 0 A_Explode(36,80,0)
6Q28 ZZZZZ 1 A_SetScale(scaleX+0.15)
6Q28 W 0 A_Explode(36,80,0)
6Q28 YYYYY 1 A_SetScale(scaleX-0.15)
6Q28 W 0 A_Explode(36,80,0)
6Q28 ZZZZZ 1 A_SetScale(scaleX-0.15)
6Q28 W 0 A_Explode(36,80,0)
6Q28 W 0 A_Countdown
goto Spawn+3
Death:
6P28 Y 0 A_Fadeout(0.05)
6P28 YYY 1 A_SetScale(scaleX-0.1)
6P28 Y 0 A_Fadeout(0.05)
6P28 ZZZ 1 A_SetScale(scaleX-0.1)
loop
}
}

Actor SFGhostPulse : BasicProjectile
{
Translation "192:192=168:168","198:198=93:93"
Damagetype "WarRockStelar"
Obituary "%o was spooked out by \cvWar-Rock (%k)'s \c-Ghost Pulse."
Renderstyle "Translucent"
Alpha 0.6
+BRIGHT
+DONTBLAST
+RIPPER
+THRUGHOST
+NOCLIP
+NOINTERACTION
+THRUACTORS
Damage (0)
Radius 10
Height 10
Speed 0  // 24
Scale 4.0
Reactiontime 5
States
{
Spawn:
X_7G E 0
X_7G EF 2
Spawn2:
X_7G G 0 A_Explode(56,128,0,0,16)
X_7G G 3 A_SpawnItemEx("SFGhostPulseTrail",-4,0,0,0,0,0,0,1)
X_7G H 0 A_ScaleVelocity(0.9)
X_7G G 0 A_Explode(56,128,0,0,16)
X_7G G 3 A_SpawnItemEx("SFGhostPulseTrail",-4,0,0,0,0,0,0,1)
X_7G H 0 A_ScaleVelocity(0.9)
X_7G H 0 A_Explode(56,128,0,0,16)
X_7G H 3 A_SpawnItemEx("SFGhostPulseTrail",-4,0,0,0,0,0,0,1)
X_7G H 0 A_ScaleVelocity(0.9)
X_7G H 0 A_Explode(56,128,0,0,16)
X_7G H 3 A_SpawnItemEx("SFGhostPulseTrail",-4,0,0,0,0,0,0,1)
X_7G H 0 A_ScaleVelocity(0.9)
X_7G H 0 A_Countdown
loop
Death:
X_7G G 0 A_SetScale(scaleX-0.3)
X_7G G 3 A_Fadeout(0.08)
X_7G H 0 A_SetScale(scaleX-0.3)
X_7G H 3 A_Fadeout(0.08)
loop
}
}


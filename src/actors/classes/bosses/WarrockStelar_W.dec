Reload:
8H51 A 0 A_TakeInventory("UnholyBossAmmo250", 250)
8H51 A 0 ACS_NamedExecuteWithResult("rz_DrawSFCards")
8H51 A 2 A_PlaySoundEx("MMSF2/BattleStart", "Weapon")
goto ReadyX

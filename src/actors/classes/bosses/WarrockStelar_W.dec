actor WarRockStelar_W2 : WarRockStelar_W {
  States {
   ReadyX:
    8H51 A 1 A_GiveInventory("WarRockStelar2_Ready0_P")
    loop 
   Fire:
    8H51 A 0 A_JumpIfInventory("MoaiFall_BCFlag",1,"MoaiFallAmmoCheck")
    8H51 A 0 A_JumpIfInventory("GhostPulse_BCFlag",1,"GhostPulseAmmoCheck")
    8H51 A 0 A_JumpIfInventory("RadarMissile_BCFlag",1,"RadarMissileAmmoCheck")
    8H51 A 0 A_JumpIfInventory("PuffBlast_BCFlag",1,"PuffBlastAmmoCheck")
    8H51 A 0 A_JumpIfInventory("Shuriken_BCFlag",1,"ShurikenAmmoCheck")
    8H51 A 0 A_JumpIfInventory("StunKnuckle_BCFlag",1,"StunKnuckleAmmoCheck")
    8H51 A 0 A_JumpIfInventory("HurricaneDance_BCFlag",1,"HurricaneDanceAmmoCheck")
    8H51 A 0 A_JumpIfInventory("MagicCrystal1_BCFlag",1,"MagicCrystalAmmoCheck")
    8H51 A 0 A_JumpIfInventory("MagicCrystal2_BCFlag",1,"MagicCrystalAmmoCheck")
    8H51 A 0 A_JumpIfInventory("MagicCrystal3_BCFlag",1,"MagicCrystalAmmoCheck")
    8H51 A 0 A_JumpIfInventory("PlasmaSword_BCFlag",1,"PlasmaSwordAmmoCheck")
    8H51 AA 2 A_GiveInventory("SFBusterCharge",2)
    Goto ReadyX

   Reload:
    8H51 A 0 A_JumpIfInventory("WR_LockOnFlag", 1, "DisLock")
    8H51 A 1 A_JumpIfInventory("SF_CanLockOn", 1, 1)
    goto ReadyX
    8H51 A 1 A_GiveInventory("WR_LockOnFlag")
    8H51 A 1 A_SpawnItemEx("WR_LockOnWatcher")
    Goto ReReloadLoop
   DisLock:
    8H51 A 1 A_TakeInventory("WR_LockOnFlag")
    Goto ReReloadLoop
   ReReloadLoop:
    8H51 A 1
    8H51 A 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_RELOAD), "ReadyX")
    loop

RadarMissileAmmoCheck:
8H51 A 0 A_JumpIfInventory("WR_LockedTID", 1000, "RadarMissile_LockOn")
8H51 A 0 ACS_NamedExecuteWithResult("rz_MoveSFCardQueue")
8H51 A 0 A_PlaySoundEx("MMSF3/RadarMissile", "Weapon")
8H51 A 0 A_SpawnItemEx("RadarMissileShot",8,0,24,random(12,24),random(-15,15),random(-8,8),0)
8H51 BA 3
goto ReadyX
RadarMissile_LockOn:
8H51 A 2 A_SpawnItemEx("WR_LockOnWarp_RadarMissile")
goto RadarMissileAmmoCheck+1

PuffBlastAmmoCheck:
8H51 A 0 A_JumpIfInventory("WR_LockedTID", 1000, "PuffBlast_LockOn")
8H51 A 0 ACS_NamedExecuteWithResult("rz_MoveSFCardQueue")
8H51 A 0 A_GiveInventory("WarrockPuffFlag")
8H51 A 1 Offset(-2,36)
8H51 A 1 Offset(-6,42)
PuffBlastX:
8H51 B 0 A_PlaySoundEx("CBM/WindLoop","Weapon")
8H51 B 0 A_FireCustomMissile("SFPuffBlast",0,0,8,0)
8H51 B 2 Offset(-6,42) A_FireCustomMissile("SFPuffBlast",random(5,10),0,8,0,0,random(-3,3))
8H51 BB 2 A_PlaySoundEx("CBM/WindLoop","Weapon")
//8H51 A 0 A_PlaySoundEx("MMSF/PuffBlast","Weapon")
8H51 B 0 A_PlaySoundEx("CBM/WindLoop","Weapon")
8H51 B 0 A_FireCustomMissile("SFPuffBlast",0,0,8,0)
8H51 B 2 A_FireCustomMissile("SFPuffBlast",random(-5,-10),0,8,0,0,random(-3,3))
8H51 BB 2 A_PlaySoundEx("CBM/WindLoop","Weapon")
// 8H51 B 0 A_Refire("PuffBlastX")
8H51 A 0 A_TakeInventory("WarrockPuffFlag")
8H51 A 1 Offset(-2,36)
goto ReadyX
PuffBlast_LockOn:

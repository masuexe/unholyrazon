// MagicSpecialist
actor MagicDevilEye : BossBase {
  Player.ScoreIcon "UB115MUG"
  Player.SoundClass "MagicDevilEye"
  Player.ForwardMove 1.33, 1.33
  Player.SideMove 1.33, 1.33
  Player.JumpZ 13
  Player.MaxHealth 2930
  Health 2930
  Player.MorphWeapon "MagicDevilEye_W"
  States {
   Spawn:
    8B15 A 0
    8B15 B 1
    8B15 A 1
    wait
   See:
    8B15 BCDE 5
    goto Spawn
   Melee:
    8B15 I 0 A_JumpIfInventory("VivifyDelay7", 1, "MissileM_G")
    goto Missile2_I
   Missile:
    8B15 F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile1_I")
    8B15 F 0 A_JumpIfInventory("VivifyFlag2", 1, "Missile2_I")
    8B15 F 4
    8B15 G 5
    goto Spawn+1
   Missile1_I:
    8B15 I 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile1_F")
    loop
   Missile1_F:
    8B15 F 1 A_JumpIfInventory("VivifyDelay4", 1, "Missile1_G")
    loop
   Missile1_G:
    8B15 G 1 A_JumpIfInventory("VivifyDelay3", 1, 1)
    loop
    8B15 G 1
    goto Spawn+1
   Missile2_I:
    8B15 III 1 A_JumpIfInventory("VivifyDelay10", 1, "Missile1_I")
    goto Spawn+1
   MissileM_G:
    8B15 G 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile1_F")
    loop

   ClassPain:
    8B15 H 0
    8B15 HHHHHHHHHH 2 A_SpawnItemEx("MagicDevilEye_PainFX", random(-12, -2), random(-24, 24), random(-4, 68), 0, 0, 0, 0, 33)
    goto Spawn
    // Goto MegamanPain
   ClassDeath:
    8B15 H 0
    goto MegamanDeath
  }
}

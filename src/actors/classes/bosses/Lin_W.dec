actor LinSwordFlag : Once {}
actor LinBubblerFlag : Once {}
actor LinGutsShot : BasicFastProjectile {
  Translation "204:204=4:4", "195:195=215:215"
  damagetype "Lin"
  Obituary "%o's got one-shotted by \chL\cji\cvn\c- (%k)'s Guts Shot."
  Damage (30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)))
  radius 6
  height 6
  Speed 90
  States {
   Spawn:
    VP_D Q 0
    VP_D Q 1 A_SpawnItemEx("LinGutsShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    wait
   Death:
    BBAB BCD 2
    stop
  }
}
Actor LinGutsShotFX : BasicGraphicEffect {
  RenderStyle "Add"
  States {
   SpawnFrame:
    VP_D Q 1 A_FadeOut(0.25)
    loop
  }
}
actor LinAquaShot : BasicFastProjectile {
  Translation "192:192=200:200", "198:198=75:75"
  Damagetype "LinBubbler"
  Obituary "%o was disintegrated in \chL\cji\cvn\c- (%k)'s High-Pressure Deluge."
  +DONTREFLECT
  -NOGRAVITY
  Gravity 2
  Renderstyle "Translucent"
  Alpha 0.75
  Damage (0)
  radius 16
  height 16
  Speed 150
  scale 3.25
  States {
   Spawn:
    PUM4 E 1
    wait

   Death:
    TNT1 A 0 A_JumpIf(z - floorz < 16, "Floor")
    TNT1 A 0 A_JumpIf(z - ceilingz == -18, "Ceiling")
    TNT1 A 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 120, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("LinAquaShotEnd", -15, 0, 0, random(5, 15), random(5, 15), random(5, 15), random(0, 360), 1)
    TNT1 A 2
    stop

   Floor:
    TNT1 A 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 120, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("LinAquaShotEnd", -15, 0, 0, random(-15, 15), random(-15, 15), random(10, 15), random(0, 360), 1)
    TNT1 A 2
    stop

   Ceiling:
    TNT1 A 0 A_Explode(30 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 120, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("LinAquaShotEnd", 0, 0, -15, random(-15, 15), random(-15, 15), random(-10, -15), 0, 1)
    TNT1 A 2
    stop
  }
}
actor LinAquaShotEnd {
  PROJECTILE
  -NOGRAVITY
  +NOCLIP
  +CLIENTSIDEONLY
  Gravity 1.5
  damagetype "Lin"
  Speed 0
  Damage (0)
  radius 16
  height 16
  scale 3.25
  States {
   Spawn:
    PUM4 E 0
    PUM4 E 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
   SpawnFrame:
    PUM4 EDC 4
    stop
  }
}
actor PainMaestroAquaGuts : Basic_PainFling_H {Args 20, 0, 0}
actor DeathMaestroAquaGuts : Basic_DeathFling_H {Args 60, 0, 0}

actor LinSlash : BasicProjectile {
  Translation "192:192=103:103", "198:198=117:117"
  damagetype "Lin"
  Obituary "%o was cleaved into oblivion by \chL\cji\cvn\c- (%k)'s Sundering Blade."
  +RIPPER
  Damage (15 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)))
  Radius 5
  Height 5
  speed 45
  scale 2.5
  States {
   Spawn:
    TMFX ABCD 1 A_Explode(35 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 92, 0)
    stop
  }
}
actor LinSlashWave : BasicProjectile {
  Translation "192:192=103:103", "198:198=117:117"
  Damagetype "Lin"
  Obituary "%o vanished in the wake of \chL\cji\cvn\c- (%k)'s Resonant Severance."
  +THRUACTORS
  +NOCLIP
  +SKYEXPLODE
  +NOINTERACTION
  Renderstyle "Translucent"
  Alpha 0.8
  Damage (0)  // 135
  Radius 16  // 26//52
  Height 24
  speed 60
  scale 5
  reactiontime 35
  States {
   Spawn:
    8Q07 G 0
    8Q07 GF 1 A_Explode(150 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 130, 0, 0, 16)
   SpawnL:
    8Q07 E 1 A_Explode(150 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 130, 0, 0, 16)
    8Q07 E 0 A_Countdown
    8Q07 F 1 A_Explode(150 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 130, 0, 0, 16)
    8Q07 F 0 A_Countdown
    loop
   Death:
    8Q07 FGH 1 A_Explode(150 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 130, 0, 0, 16)
    8Q07 I 1 A_Explode(150 * (1 + 9 * (CallACS("rz_CheckBirthday") == 1)), 33, 0, 0, 16)
    stop
  }
}
actor LinCheating_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("weapon/mirrorabsorb")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 1)
    TNT1 A 0 A_GiveInventory("XRayVisionEnable_P")
    stop
  }
}

// IDEA: add Illusion Sword Dance from DFO as rage

actor Lin_W1_NormalBar : NormalBar {args 192, 198}
actor Lin_W2_NormalBar : Lin_W1_NormalBar {}

actor Lin_W1 : BaseUnholyBossWep {
  Tag "$TAG_Boss082_W"
  Obituary "%o was overwhelmed by \chL\cji\cvn\c- (%k)."
  Inventory.Pickupmessage "\ctPicked up server holder's weapon!"
  weapon.ammotype "UnholyBossAmmo150"
  Inventory.Icon "LINICA"
  States {
   Spawn:
    8H67 [ 1
    wait

   Deselect:
    8H67 C 0
    goto DeselectSwap
   Select:
    8H67 C 0
    goto SelectSwap

   Ready:
    8H67 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, CLR_MEGABUSTER)
    goto ReadyX
   ReadyX:
    8H67 A 2 A_WeaponReady
    8H67 A 0 A_GiveInventory("UnholyBossAmmo150", 2)
    loop

    // Stolen from Gondola
   Fire:
    // 8H67 A 0 A_JumpIfInventory("UnholyPower1500",1500,"DawnBreakerSP")//WinEvenByCheating
    8H67 A 0 A_JumpIfInventory("LinSwordFlag", 1, "FireSword")
    8H67 A 0 A_PlaySoundEx("weapon/RockBuster", "Weapon")
    8H67 A 0 A_PlaySoundEx("weapon/marsvulcan", "SoundSlot6")
    8H67 A 0 A_FireCustomMissile("LinGutsShot", frandom(-1, 1), 0, 8, 0, 1, frandom(-0.5, 0.5))
    8H67 B 1
    8H67 C 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H67 A 1
    goto ReadyX

   FireSword:
    // 8H67 A 1 Offset(18,50)
    8H67 A 1 Offset(10, 42)
    8H67 A 1 Offset(28, 60) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 1 A_WeaponReady(14)
   FireSword1:
    8H67 E 1
    TNT1 A 0 A_Recoil(-15)
    8H67 F 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    8H67 F 0 A_JumpIfInventory("PlayerPropertyRage", 1, "FireSwordR")
    8H67 F 0 A_FireCustomMissile("LinSlash", 75, 0, -24, 0, 0, -15)
    8H67 F 1 A_FireCustomMissile("LinSlash", 50, 0, -16, 0, 0, -10)
    8H67 G 1 A_FireCustomMissile("LinSlash", 25, 0, -8, 0, 0, -5)
    8H67 H 1 A_FireCustomMissile("LinSlash", 0, 0, 0, 0, 0, 0)
    8H67 J 1 A_FireCustomMissile("LinSlash", -25, 0, 8, 0, 0, 5)
    8H67 I 1 A_FireCustomMissile("LinSlash", -50, 0, 16, 0, 0, 10)
    8H67 K 1 A_FireCustomMissile("LinSlash", -75, 0, 24, 0, 0, 15)
    TNT1 A 1
    TNT1 A 0 A_Refire("FireSword2")
    goto FireSwordEnd
   FireSwordR:
    8H67 F 0 A_FireCustomMissile("LinSlash", 75, 0, -24, 0, 0, -15)
    8H67 F 1 A_FireCustomMissile("LinSlash", 50, 0, -16, 0, 0, -10)
    8H67 G 0 A_FireCustomMissile("LinSlash", 25, 0, -8, 0, 0, -5)
    8H67 H 1 A_FireCustomMissile("LinSlash", 0, 0, 0, 0, 0, 0)
    8H67 J 0 A_FireCustomMissile("LinSlash", -25, 0, 8, 0, 0, 5)
    8H67 I 1 A_FireCustomMissile("LinSlash", -50, 0, 16, 0, 0, 10)
    8H67 K 0 A_FireCustomMissile("LinSlash", -75, 0, 24, 0, 0, 15)
    TNT1 A 1
    TNT1 A 0 A_Refire("FireSword2")
    goto FireSwordEnd

   FireSword2:
    TNT1 A 0 A_WeaponReady(12)
    TNT1 A 1
    TNT1 A 0 A_Recoil(-15)
    TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    8H67 M 1 A_FireCustomMissile("LinSlash", -75, 0, 24, 0, 0, 15)
    8H67 N 0 A_FireCustomMissile("LinSlash", -50, 0, 16, 0, 0, 10)
    8H67 N 1 A_FireCustomMissile("LinSlash", -25, 0, 8, 0, 0, 5)
    8H67 O 0 A_FireCustomMissile("LinSlash", 0, 0, 0, 0, 0, 0)
    8H67 O 1 A_FireCustomMissile("LinSlash", 25, 0, -8, 0, 0, -5)
    8H67 P 0 A_FireCustomMissile("LinSlash", 50, 0, -16, 0, 0, -10)
    8H67 P 1 A_FireCustomMissile("LinSlash", 75, 0, -24, 0, 0, -15)
    8H67 Q 1
    TNT1 A 1
    TNT1 A 0 A_Refire("FireSword1")
    goto FireSwordEnd
   FireSword2R:
    8H67 M 1 A_FireCustomMissile("LinSlash", -75, 0, 24, 0, 0, 15)
    8H67 N 0 A_FireCustomMissile("LinSlash", -50, 0, 16, 0, 0, 10)
    8H67 N 0 A_FireCustomMissile("LinSlash", -25, 0, 8, 0, 0, 5)
    8H67 O 0 A_FireCustomMissile("LinSlash", 0, 0, 0, 0, 0, 0)
    8H67 O 1 A_FireCustomMissile("LinSlash", 25, 0, -8, 0, 0, -5)
    8H67 P 0 A_FireCustomMissile("LinSlash", 50, 0, -16, 0, 0, -10)
    8H67 P 0 A_FireCustomMissile("LinSlash", 75, 0, -24, 0, 0, -15)
    8H67 Q 1
    TNT1 A 1
    TNT1 A 0 A_Refire("FireSword1")
    goto FireSwordEnd

   FireSwordEnd:
    TNT1 A 1
    8H67 A 1 Offset(28, 60) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    // 8H67 A 1 Offset(18,50)
    8H67 A 1 Offset(10, 42)
    // 8H67 A 1 Offset(4,36)
    goto ReadyX

   AltFire:
    8H67 C 0 A_JumpIfInventory("LinSwordFlag", 1, "AltFireSword")
    8H67 C 0 A_JumpIfInventory("UnholyBossAmmo150", 15 - 8*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "AquaStream")
    8H67 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    Goto ReadyX
   AquaStream:
    8H67 A 0 A_StopSoundEx("Body")
    8H67 A 1 Offset(-9, 23)
    8H67 D 1 Offset(-18, 14)
    8H67 D 0 A_PlaySoundEx("weapon/waterwave", "Weapon")
    8H67 D 0 A_PlaySoundEx("weapon/watershieldburst", "SoundSlot6")
    8H67 D 0 A_TakeInventory("UnholyBossAmmo150", 8, 1)
    8H67 D 0 A_TakeInventory("UnholyBossAmmo150", 7)
    8H67 A 1 Offset(-18, 10) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 D 1 Offset(-18, 14) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 A 1 Offset(-18, 10) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 D 1 Offset(-18, 14) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 A 1 Offset(-18, 10) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 D 1 Offset(-18, 14) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 A 1 Offset(-18, 10) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 D 1 Offset(-18, 14) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 A 1 Offset(-18, 10) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 D 1 Offset(-18, 14) A_FireCustomMissile("LinAquaShot", 0, 0, 8, -8)
    8H67 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "AquaStreamR")
    8H67 A 1 Offset(-18, 14)
    8H67 A 1 Offset(-9, 23)
    8H67 A 9 A_WeaponReady(14)
    8H67 A 0 A_Refire
    goto ReadyX
   AquaStreamR:
    8H67 A 1 Offset(-18, 14)
    8H67 A 1 Offset(-9, 23)
    8H67 A 5 A_WeaponReady(14)
    8H67 A 0 A_Refire
    goto ReadyX

   AltFireSword:
    8H67 C 0 A_JumpIfInventory("UnholyBossAmmo150", 150 - 75*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "PhantomSwordDance")
    8H67 A 0 A_GiveInventory("UnholyBossAmmo150", 1)
    Goto ReadyX
   PhantomSwordDance:
    8H67 A 0 A_TakeInventory("UnholyBossAmmo150", 75, 1)  // 50
    8H67 A 0 A_TakeInventory("UnholyBossAmmo150", 75)
    8H67 T 0 A_PlaySoundEx("weapon/swordswing2", "Weapon")
    8H67 M 1 A_FireCustomMissile("LinSlashWave", 0, 0, 0, 0, 0, 0)
    8H67 N 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H67 O 1
    8H67 P 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H67 Q 1
    TNT1 A 12  // A_GiveInventory("UnholyBossAmmo150",2)
    8H67 A 0 A_Refire
    goto FireSwordEnd
  }
}


Damagetype "HalfPressHardman"
+DONTBLAST
+DONTREFLECT
+THRUGHOST
Damage (10)
Radius 24
Height 24
Speed 50
Scale 3.0
States
{
Spawn:
HFI2 T 0
HFI2 T 1
wait
Death:
HFI2 T 0 A_SetArg(4,20)
HFI2 T 0 A_PlaySoundEx("weapon/powerstone","Weapon")
HFI2 TTTTTT 0 A_SpawnItemEx("HPHM_TASCrusherFistFX1",random(-40,0),random(-40,40),random(-50,50),random(-5,-20),random(-20,20),random(-20,20))
HFI2 TTTTTT 0 A_SpawnItemEx("HPHM_TASCrusherFistFX2",0,0,random(4,12),random(-25,25),random(-25,25),random(5,25),0,1)
HFI2 T 1 A_CountDownArg(4,"Death2")
goto Death+1
Death2:
TNT1 A 0 A_PlaySoundEx("wep/ReccaBomb","Weapon")
TNT1 A 10 A_SpawnItemEx("HPHM_TASCrusherFistBoom",0,0,0,0,0,0,0,1)
stop
}
}


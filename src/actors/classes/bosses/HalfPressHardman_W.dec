actor HPHM_KnuckleR : HPHM_Knuckle
{
Obituary "%k beat %o's reverse boss order record."
//+NOINTERACTION
+SEEKERMISSILE
ReactionTime 210
Damage (random(250,300)) //111,228
States
{
Spawn:
HFIS T 0
HFIS T 0 A_RearrangePointers(0,0,2)
HFIS T 0 A_FaceTarget
goto Spawn2
Spawn2:
HFIS T 0 A_TakeFromTarget("GenericBossFlag1")
HFIS TT 0 A_SeekerMissile(90,90,3)
HFIS T 1 A_JumpIfCloser(60,"Return")
HFIS T 0 A_CountDown
HFIS T 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
HFIS T 0 A_TakeFromTarget("GenericBossFlag1")
HFIS TT 0 A_SeekerMissile(90,90,3)
HFIS T 1 A_JumpIfCloser(60,"Return")
HFIS T 0 A_CountDown
HFIS T 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death2")
HFIS T 0 A_SpawnItemEx("HPHM_KnuckleFX",0,0,0,0,0,0,0,1)
loop
Death:
TNT1 A 0 A_JumpIfCloser(60,"Return")
goto OldDeath
}
}


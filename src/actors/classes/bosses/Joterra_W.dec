actor JoterraInvisOff_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("JoterraInvisPower",1,"Pickup2")
stop
Pickup2:
TNT1 A 0 A_PlaySoundEx("classes/reveal","Body")
TNT1 A 0 A_TakeInventory("JoterraWorldPart3")
TNT1 A 0 A_TakeInventory("JoterraHideStand_F")
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
TNT1 A 0 A_TakeInventory("JoterraInvisPower")
stop
}
}

actor Joterra_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo200", 200, "PickupReload")
    TNT1 A 0 A_Jump(256, "PickupNormal")
    goto PickupNormal
   PickupNormal:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo200", 2)
    stop
  }
}
actor Joterra_Ready8_P : Joterra_Ready0_P {
  States {
   PickupNormal:
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
   PickupReload:
    TNT1 A 0 A_WeaponReady(8 + 16)
    goto Ammo
  }
}

actor JoterraCooldown_H : BasicWatcher
{
ReactionTime 100
States
{
Spawn:
TNT1 A 0
TNT1 A 2
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"SpawnL_R")
goto SpawnL
SpawnL:
TNT1 A 1 A_TakeFromTarget("JoterraCooldown",1)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
TNT1 A 0 A_CountDown
loop
SpawnL_R:
TNT1 A 1 A_TakeFromTarget("JoterraCooldown",2)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
TNT1 AA 0 A_CountDown//
loop
}
}

actor Joterra_CrusaderSound_H : BasicWatcher
{
ReactionTime 46
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_RearrangePointers(0,0,2)
TNT1 A 0 A_PlaySound("wep_L/SansCrusader",6,1,0,2)
TNT1 A 0 A_PlaySound("wep_L/SansCrusader",7,1,0,2)
goto SpawnL
SpawnL:
TNT1 AAAAA 1 A_Fire
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Stopper")
TNT1 A 0 A_CountDown
loop
Stopper:
TNT1 A 0
TNT1 A 0 A_StopSound(6)
TNT1 A 1 A_StopSound(7)
TNT1 A 1
stop
}
}

actor Joterra_StarChaser : BasicProjectile
{//Terra green?
Translation "192:192=56:56","198:198=61:61","202:202=61:61","199:199=63:63"
Damagetype "Joterra"
Obituary "\cdJoterra\c- (%k) turned %o into stardust."
ReactionTime 1
Damage (50)
Radius 16
Height 16
Speed 40
States
{
Spawn:
X_7D B 0
X_7D B 1 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
Y_7D D 1
X_7D N 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_7D N 0 A_JumpIfInTargetInventory("JoterraShot_F",1,"ReleaseDeath")
X_7D N 0 A_ChangeVelocity(cos(-pitch)*40,0,sin(-pitch)*40,3)
X_7D N 0 A_SpawnItemEx("Joterra_StarChaserFX1",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,9)
X_7D N 1 A_SpawnItemEx("Joterra_StarChaserT2",0,0,0,0,0,0,0,1)
Y_7D N 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_7D N 0 A_JumpIfInTargetInventory("JoterraShot_F",1,"ReleaseDeath")
Y_7D N 0 A_ChangeVelocity(cos(-pitch)*40,0,sin(-pitch)*40,3)
Y_7D N 0 A_SpawnItemEx("Joterra_StarChaserFX2",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,9)
Y_7D N 1 A_SpawnItemEx("Joterra_StarChaserT1",0,0,0,0,0,0,0,1)
goto Spawn+3
ReleaseDeath:
TNT1 A 1 A_CountDown
wait
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("misc_L/wilybeam","Weapon")
TNT1 A 0 A_Explode(75,128,0,0,32)
TNT1 A 0 A_GiveToTarget("JoterraShot_F",1)
X_8B A 2 A_SpawnItemEx("Joterra_StarChaserBit",0,0,0,13,0,0,0)
X_8B B 2 A_SpawnItemEx("Joterra_StarChaserBit",0,0,0,13,0,0,72)
X_8B C 2 A_SpawnItemEx("Joterra_StarChaserBit",0,0,0,13,0,0,144)
X_8B D 2 A_SpawnItemEx("Joterra_StarChaserBit",0,0,0,13,0,0,216)
X_8B E 2 A_SpawnItemEx("Joterra_StarChaserBit",0,0,0,13,0,0,288)
X_8B F 2
stop
}
}


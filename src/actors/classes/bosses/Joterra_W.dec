actor Joterra_SP_Punching : BasicExplosion
{
Translation "192:192=61:61","198:198=245:245"
alpha 0.8
renderstyle "Translucent"
reactiontime 24
Speed 0
scale 2.5
States
{
Spawn:
8R02 F 0
8R02 F 0 A_PlaySound("JoJo/StarP_OraStart",1,0.85)
8R02 F 0 A_PlaySound("JoJo/StarP_OraStart",2,0.85)
Spawn1:
8R02 F 0 A_Stop
8R02 F 0 A_JumpIf(ReactionTime==20,"SpawnLoopSnd")
Spawn2:
8R02 F 0 A_FaceMaster(90,90)
8R02 F 1 A_CustomMissile("Joterra_SP_Ora",random(16,64),random(-48,0),random(0,3),2,pitch+random(-2,2))
8R02 F 1 A_CustomMissile("Joterra_SP_Ora",random(16,64),random(-24,24),random(-2,2),2,pitch+random(-2,2))
8R02 F 1 A_CustomMissile("Joterra_SP_Ora",random(16,64),random(0,48),random(-3,0),2,pitch+random(-2,2))
8R02 F 0 A_Countdown
8R02 F 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
8R02 F 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "SpawnD")
8R02 F 0 A_JumpIfTracerCloser(100,"Spawn1")
8R02 F 0 A_JumpIfTracerCloser(1000,2)
8R02 F 0 A_ChangeVelocity(cos(pitch)*39,0,sin(pitch)*32,3)
goto Spawn1+1
8R02 F 0 A_JumpIfTracerCloser(500,2)
8R02 F 0 A_ChangeVelocity(cos(pitch)*26,0,sin(pitch)*21,3)
goto Spawn1+1
8R02 F 0 A_ChangeVelocity(cos(pitch)*13,0,sin(pitch)*6,3)
goto Spawn1+1
SpawnLoopSnd:
8R02 F 0 A_PlaySound("JoJo/StarP_OraLoop",3,0.85,1)
8R02 F 0 A_PlaySound("JoJo/StarP_OraLoop",4,0.85,1)
goto Spawn2
SpawnDLoopSnd:
8R02 F 0 A_PlaySound("JoJo/StarP_OraLoop",3,0.85,1)
8R02 F 0 A_PlaySound("JoJo/StarP_OraLoop",4,0.85,1)
goto SpawnD+2

SpawnD:
8R02 F 0 A_Stop
8R02 F 0 A_JumpIf(ReactionTime==20,"SpawnDLoopSnd")
8R02 FFF 1 A_CustomMissile("Joterra_SP_Ora",random(16,64),random(-48,48),random(-3,3),2,pitch+random(-2,2))
8R02 F 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
8R02 F 0 A_Countdown
goto SpawnD+1

Death:
8R02 H 0 A_FaceMaster(90,90)
8R02 H 0 A_CustomMissile("Joterra_SP_OraFinisher",0,0,0,2,pitch)
8R02 H 0 //A_SpawnItemEX("Joterra_SP_OraFinisher",86,0,32,0,0,0,0,8)
TNT1 A 1 A_SpawnItemEX("Joterra_SP_PunchingEnd",0,0,0,0,0,0,0,1)
Stop
}
}

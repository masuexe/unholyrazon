actor BlueElephant : BossBase {
  player.soundclass "BlueElephant"
  player.forwardmove 1.5, 1.5
  player.sidemove 1.25, 1.25
  player.jumpz 20
  Player.MaxHealth 2000
  Health 2000
  player.morphweapon "BlueElephant_W"
  MaxStepHeight 32//24
  MaxDropOffHeight 32//24
  States {
   Spawn:
    ELPH A 0
    ELPH B 1
    ELPH A 1
    wait
   See:
    ELPH BCDA 2
    Goto Spawn
   Missile:
    ELPH A 1
    goto Spawn+2
   ClassPain:
    ELPH H 0
    Goto MegamanPain
   ClassDeath:
    ELPH H 0
    Goto MegamanDeath
  }
}

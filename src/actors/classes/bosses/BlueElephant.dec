actor BlueElephant : BossBase {
  Player.ScoreIcon "UB616MUG"
  Player.SoundClass "BlueElephant"
  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.25, 1.25
  Player.JumpZ 20
  Player.MaxHealth 2000
  Health 2000
  Player.MorphWeapon "BlueElephant_W"
  MaxStepHeight 32     // 24
  MaxDropOffHeight 32  // 24
  States {
   Spawn:
    ELPH A 0
    ELPH B 1
    ELPH A 1
    wait
   See:
    ELPH BCDA 2
    goto Spawn
   Missile:
    ELPH A 1
    goto Spawn+2
   ClassPain:
    ELPH H 0
    goto MegamanPain
   ClassDeath:
    ELPH H 0
    goto MegamanDeath
  }
}

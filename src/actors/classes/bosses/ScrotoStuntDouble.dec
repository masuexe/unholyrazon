// Scroticus | Liquid Scrotous
actor ScrotoStuntDouble : BossBase {
  Player.ScoreIcon "UB613MUG"
  Player.SoundClass "ScrotoStuntDouble"
  Player.ForwardMove 1.4, 1.4
  Player.SideMove 1.15, 1.15
  Player.JumpZ 14
  Player.MaxHealth 2705
  Health 2705
  Player.MorphWeapon "ScrotoStuntDouble_W"
  States {
   Spawn:
    9B13 A 0
    9B13 B 1
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 A 1 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    goto Spawn+2
   See:
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 B 1 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 C 1 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 D 1 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 E 1 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    goto Spawn
   Missile:
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 F 5 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    9B13 A 0 A_JumpIfInventory("StuntDoubleFlagX", 1, "ScrotoCar")
    9B13 G 4 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")
    goto Spawn+2

   MissileStanceA:
    9B13 F 2
    9B13 F 2 A_JumpIfInventory("StuntDoubleFlag", 1, "MissileStanceA")  // 0
   MissileStanceB:
    9B13 G 10
    goto Spawn+2

   ScrotoCar:
    TURB BCDE 1 A_JumpIfInventory("VivifyDelay6", 1, "CarCrash")
    loop
   CarCrash:
    9B13 H 0 A_PlaySoundEx("misc/devilpain", "Voice")
    9B13 HHHHHHHHH 2  // A_SpawnItemEx("PainFX",0,3) //Removed because this is seizure inducing, because I... don't know how to adjust it better !
    9B13 H 2 A_JumpIfInventory("StuntDoublePain", 1, "PainAgony")  // 0
    goto Spawn+2
   PainAgony:
    9B13 H 2  // A_SpawnItemEx("PainFX",0,3) //Same reason
    9B13 H 2 A_JumpIfInventory("StuntDoublePain", 1, "PainAgony")  // 0
    goto Spawn+2

   ClassPain:
    9B13 H 0 A_JumpIfInventory("StuntDoublePain", 1, "PainAgony")
    goto MegamanPain
   ClassDeath:
    9B13 H 0
    goto MegamanDeath
  }
}

actor PricksterPrick_W : BaseUnholyBossWep {
  Tag "$TAG_Boss513_W"
  Obituary "\cmPrickster \cgPrick\c- (%k) showed %o the official Sonic The Hedgehog Joke Book."
  Inventory.Pickupmessage "\cgHOT DAMN! New Shoes!"
  States {
   Spawn:
    9H13 [ 1
    wait

   Deselect:
    9H13 A 0
    goto DeselectSwap
   Select:
    9H13 A 0
    goto SelectSwap

   Ready:
    9H13 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, PRICKSTERPRICK_DYE)
    9H13 A 0 A_GiveInventory("SpeedTrailofEnvyEX")
    9H13 A 6
    goto ReadyX
   ReadyX:
    9H13 A 8 A_WeaponReady
    9H13 A 0 A_SpawnItemEx("PrickingDamage", 0, 0, 28, momx, momy, momz, 0, 8, 0)  // SXF_ABSOLUTEMOMENTUM
    loop

   Fire:
    9H13 B 0 A_GiveInventory("VivifyDelay8")
    9H13 B 0 A_ReFire(1)
    9H13 B 0 A_PlaySoundEx("S_1/Dash", "Weapon")
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*20, 0, -sin(pitch)*6, 3)  // CVF_RELATIVE|CVF_REPLACE
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*30, 0, -sin(pitch)*10, 3)
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*40, 0, -sin(pitch)*14, 3)
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*50, 0, -sin(pitch)*18, 3)
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*60, 0, -sin(pitch)*22, 3)
    9H13 B 0 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 B 2 A_ChangeVelocity(cos(pitch)*70, 0, -sin(pitch)*26, 3)
    9H13 BBBBB 2 A_GiveInventory("PricksterRandomCollisionItem")
    9H13 A 15
    Goto ReadyX
  }
}

actor PrickingDamage : BasicExplosion {
  Damagetype "Prickster"
  Obituary "\cmPrickster \cgPrick\c- (%k) told %o an actual good joke."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(85, 64, 0)
    stop
  }
}

actor PrickingDamage0 : PrickingDamage {
  Obituary "%o was creeped out by \cmPrickster \cgPrick\c- (%k)'s chuckling."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(225, 138, 0, 0, 12)
    stop
  }
}
actor PrickingDamage1  : PrickingDamage0 {Obituary "$OB_BOSS513A"}

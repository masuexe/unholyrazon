actor PricksterRandomCollisionItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12", "P13", "P14", "P15", "P16")
    TNT1 A 0
    goto P0
   P0:  // SXF_ABSOLUTEMOMENTUM
    TNT1 A 0 A_SpawnItemEx("CollisionDamage0", 0, 0, 28, momx, momy, momz, 0, 8, 0)
    stop
   P1: TNT1 A 0 A_SpawnItemEx("PrickingDamage1", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P2: TNT1 A 0 A_SpawnItemEx("PrickingDamage2", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P3: TNT1 A 0 A_SpawnItemEx("PrickingDamage3", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P4: TNT1 A 0 A_SpawnItemEx("PrickingDamage4", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P5: TNT1 A 0 A_SpawnItemEx("PrickingDamage5", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P6: TNT1 A 0 A_SpawnItemEx("PrickingDamage6", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P7: TNT1 A 0 A_SpawnItemEx("PrickingDamage7", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P8: TNT1 A 0 A_SpawnItemEx("PrickingDamage8", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P9: TNT1 A 0 A_SpawnItemEx("PrickingDamage9", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P10: TNT1 A 0 A_SpawnItemEx("PrickingDamage10", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P11: TNT1 A 0 A_SpawnItemEx("PrickingDamage11", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P12: TNT1 A 0 A_SpawnItemEx("PrickingDamage12", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P13: TNT1 A 0 A_SpawnItemEx("PrickingDamage13", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P14: TNT1 A 0 A_SpawnItemEx("PrickingDamage14", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P15: TNT1 A 0 A_SpawnItemEx("PrickingDamage15", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
   P16: TNT1 A 0 A_SpawnItemEx("PrickingDamage16", 0, 0, 28, momx, momy, momz, 0, 8, 0)stop
  }
}

actor SpeedTrailofEnvyEX : PowerupGiver {
  +COUNTITEM
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 1
  Powerup.Type "PowerTimeFastEX"
  States {
   Spawn:
    TNT1 A 1
    Loop
  }
}

actor PowerTimeFastEx : PowerSpeed {
  Powerup.Duration 0x7ffffffd
  Speed 1.5
}

actor GutsBuddy : BossBase {
  Player.ScoreIcon "UB046MUG"
  Player.SoundClass "GutsBuddy"
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 12
  Player.MaxHealth 3850
  Health 3850
  Player.MorphWeapon "GutsBuddy_W"
  States {
   Spawn:
    GUT2 A 0
    GUT2 A 0 A_JumpIfInventory("SuperArmTemp", 1, 3)
    GUT2 B 1
    GUT2 A -1
    GUT2 R 1
    GUT2 Q 1
    goto Spawn+5
   See:
    GUT2 B 0 A_JumpIfInventory("SuperArmTemp", 1, "SeeSomeRocks")
    GUT2 BCDE 2
    goto Spawn
   SeeSomeRocks:
    GUT2 RSTS 2
    goto Spawn+4
   Missile:
    GUT2 FG 5
    GUT2 G 0 A_JumpIfInventory("SuperArmTemp", 1, 1)
    goto Spawn+3
    GUT2 G 0
    goto Spawn+5
   ClassPain:
    GUT2 H 0
    goto MegamanPain
   ClassDeath:
    GUT2 H 0
    goto MegamanDeath
  }
}

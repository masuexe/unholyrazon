actor PlasmaSpark : BossBase {
  Player.ScoreIcon "UB063MUG"
  Player.SoundClass "PlasmaSpark"
  Player.ForwardMove 1.28, 1.28
  Player.SideMove 1.28, 1.28
  Player.JumpZ 12
  Player.MaxHealth 2150
  Health 2150
  Player.MorphWeapon "PlasmaSpark_W"
  States {
   Spawn:
    SPAR A 0
    SPAR B 1
    SPAR A 1
    goto Spawn+2
   See:
    SPAR BCDE 3  // 5
    goto Spawn
   Missile:  //
    SPAR G 0 A_JumpIfInventory("Spark_Animation_X", 1, "Ridden_Missile")
    SPAR GGGGGGGGGG 1 A_JumpIfInventory("Spark_Animation", 1, "Hidden_Missile")
    goto CanYouStop
   CanYouStop:
    SPAR F 6
    goto Spawn+2
    //
   Hidden_Missile:
    SPAR L 1 A_JumpIfInventory("Spark_Animation_X", 1, 1)
    goto Missile+3
    SPAR K 1
    goto Missile
   Ridden_Missile:
    SPAR K 1
    goto Missile
    //
   ClassPain:
    SPAR H 0
    goto MegamanPain
   ClassDeath:
    SPAR H 0
    goto MegamanDeath
  }
}

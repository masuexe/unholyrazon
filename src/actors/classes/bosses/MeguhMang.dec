actor MeguhMang : BossBase {
  Player.ScoreIcon "UB019MUG"
  Player.SoundClass "MeguhMang"
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.85, 0.85
  Player.JumpZ 12
  Player.MaxHealth 3500
  Health 3500
  Damagefactor "Rawsh", 0.15
  Player.MorphWeapon "MeguhMang_W"
  States {
   Spawn:
    BBAM A 0
    BBAM B 1 A_JumpIfInventory("DecoyFlag1", 1, "Missile")
    BBAM A 1
    goto Spawn+2
   See:
    BBAM B 0 A_JumpIfInventory("DecoyFlag1", 1, "Missile")
    BBAM BCDE 5
    goto Spawn
   Missile:
    BBAM F 5
    BBAM G 2
    BBAM G 2 A_JumpIfInventory("DecoyFlag1", 1, "Missile")
    goto Spawn+2
   ClassPain:
    BBAM H 0
    goto MegamanPain
   ClassDeath:
    BBAM H 0
    goto MegamanDeath
  }
}

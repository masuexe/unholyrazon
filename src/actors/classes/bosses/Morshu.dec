actor MorshuBoss : BossBase {  // HOW BAA-AH-A-AH-A-AH-A-AH-AD CAN I BE--
  // Hey, don't mind me. Just doing what comes naturally.
  Player.ScoreIcon "UB056MUG"
  Player.SoundClass "Morshu"
  Player.ForwardMove 1.225, 1.225  // 12
  Player.SideMove 1.225, 1.225  // 12
  Player.JumpZ 12  // 12
  Player.MaxHealth 3310
  Health 3310
  Player.MorphWeapon "Morshu_W"
  States {
   Spawn:
    MRSH A 0
    MRSH B 1
    MRSH A 1
    goto Spawn+2
   See:
    MRSH BCDE 2  // 5
    goto Spawn
   Missile:
    MRSH F 5
    MRSH G 4
    goto Spawn+2
   ClassPain:
    MRSH H 0
    goto MegamanPain
   ClassDeath:
    MRSH H 0
    goto MegamanDeath
  }
}

actor DLCCentaurman : BossBase {
  player.scoreIcon "UB111MUG"
  player.soundclass "DLCCentaurman"
  player.forwardmove 1.2, 1.2
  player.sidemove 1.2, 1.2
  player.jumpz 12
  Player.MaxHealth 3500
  Health 3500
  player.morphweapon "DLCCentaurman_W"
  States {
   Spawn:
    CENT A 0
    CENT B 1
    CENT A 1
    Goto Spawn+2
   See:
    CENT BCDE 5
    Goto Spawn
   Missile:
    CENT F 5
    CENT G 4
    goto Spawn+2
   ClassPain:
    CENT H 0
    Goto MegamanPain
   ClassDeath:
    CENT H 0
    Goto MegamanDeath
   MegamanDeath0:
    CENT H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CENT H 0 A_PlaySoundEx("Recca/PlayerDie", "Body")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    CENT H 1 A_SpawnItemEx("DLCCentaurReccaExplode", random(-64, 64), random(-64, 64), 32+random(-64, 64), 0, 0, 0, random(0, 359), 1)
    CENT H 1 A_GiveInventory("DLCCentaurZankiShotSpammer")
    Goto MegamanErase
  }
}

actor DLCCentaurman : BossBase
{
player.scoreIcon "UB111MUG"
player.soundclass "DLCCentaurman"
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
player.jumpz 12
Player.MaxHealth 3500
Health 3500
player.morphweapon "DLCCentaurman_W"
States
{
Spawn:
CENT A 0
CENT B 1
CENT A 1
Goto Spawn+2
See:
CENT BCDE 5
Goto Spawn
Missile:
CENT F 5
CENT G 4
goto Spawn+2
ClassPain:
CENT H 0
Goto MegamanPain
ClassDeath:
CENT H 0
Goto MegamanDeath
MegamanDeath0:
TNT1 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
TNT1 A 1 A_SpawnItemEx("DLCCentaurmanC", 0, 0, 0, 0, 0, 4, 0, 9)
Goto MegamanErase
}
}

// Recca afterlife corpse (razon3 DLCCentaurmanC)

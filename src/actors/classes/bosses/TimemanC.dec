actor TimemanC : BossBase {
  Player.ScoreIcon "UB091MUG"
  Player.SoundClass "TimemanC"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.MaxHealth 5000
  Health 5000
  Player.MorphWeapon "TimemanC_W"
  States {
   Spawn:
    NTIM A 0
    NTIM B 1
    NTIM A 1
    NTIM A 174
    NTIM Q 76
   SpawnFrame:
    NTIM Q 55
    NTIM S 5
    loop
   See:
    NTIM BCDE 5
    goto Spawn
   Missile:
    NTIM F 0 A_JumpIfInventory("VivifyDelay10", 1, "Missile2")
    NTIM F 0 A_JumpIfInventory("IsPissedFlag", 1, "Missile_Pissed")
    NTIM F 5
    NTIM G 4
    goto Spawn
   Missile_Pissed:
    NTIM FG 2
    goto Spawn
   Missile2:
    NTIM IJKLKLK 2
    goto Spawn
   ClassPain:
    NTIM H 0
    goto MegamanPain
   ClassDeath:
    NTIM H 0
    goto MegamanDeath
  }
}

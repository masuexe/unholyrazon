actor TimemanC : BossBase {
  player.soundclass "BOSS091"
  player.forwardmove 1.2, 1.2
  player.sidemove 1.2, 1.2
  player.jumpz 12
  Player.MaxHealth 5000
  Health 5000
  player.morphweapon "TimemanC_W"
  States {
   Spawn:
    NTIM A 0
    NTIM B 1
    NTIM A 1
    NTIM A 174
    NTIM Q 76
   SpawnFrame:
    NTIM Q 55
    NTIM S 5
    loop
   See:
    NTIM BCDE 5
    Goto Spawn
   Missile:
    NTIM F 5 A_JumpIfInventory("VivifyDelay10", 1, "Missile2")
    NTIM G 4
    goto Spawn
   Missile2:
    NTIM IJKLKLK 2
    goto Spawn
   ClassPain:
    NTIM H 0
    Goto MegamanPain
   ClassDeath:
    NTIM H 0
    Goto MegamanDeath
  }
}

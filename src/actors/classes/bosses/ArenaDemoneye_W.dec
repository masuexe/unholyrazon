actor ArenaDemoneye_W : BaseUnholyBossWep {
  // A Zomo note: Perhaps you'd want to give this "boss" a small visual glow so it isn't confused for a normal demoneye?
  Tag "Me and my friends get no respect"  // https://www.youtube.com/watch?v=Vn1pf0Xi3nU - It's a piece of lyrics from this one song.
  Obituary "%o was bitch slapped by %k the \ctDemoneye\c-!"
  States {
   Spawn:
    8H65 [ 6
    wait

   Ready:
    8H65 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, GLADIATORDEMONEYE_DYE)
    // If 1k + 500 per player isn't enough.
    // Then just jack up his HP.
    // ACS_NamedExecuteAlways("core_weaponcolor", 0, GLADIATORDEMONEYE_DYE,1) //Though I'll put 2,5k just in the very case of things.
    goto ReadyX
   ReadyX:
    8H65 A 2 A_WeaponReady
    Goto ReadyX

   Fire:  // I don't think he needs an alt, now does he?
    8H65 A 1
    8H65 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H65 A 0 A_FireCustomMissile("ArenaDemoneye65_Slap", 0, 0, 8, 0)
    8H65 BC 2
    8H65 A 1 Offset(0, 72)
    8H65 A 1 Offset(0, 62) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H65 A 1 Offset(0, 52)
    8H65 A 1 Offset(0, 42) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    8H65 A 0
    Goto ReadyX  // But if he does need an alt, then I'm not sure what he could get to stand out.
  }  // But it's not like the average arena waddle dee had anything.
}  // I mean... he died if you inhaled him. so...

actor ArenaDemoneye65_Slap : PlainD_Slap {
  damagetype "Demoneye65_Damage"
  Translation "192:192=254:254", "198:198=251:251"
}

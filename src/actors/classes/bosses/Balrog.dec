    8A59 H 10 A_SetAngle(random(0, 359))  // FUUUUCCCKKKK
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")

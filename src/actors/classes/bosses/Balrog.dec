actor Balrog_Flies_Away : BasicGraphicEffect
{
States
{
SpawnFrame:
8A59 M 0
8A59 M 0 A_GiveInventory("HandyFlag",15) //10
ImOffToTunnelTales:
8A59 M 0 A_SpawnItemEx("Balrog_Smoke_Cloud",random(-48,48),random(-48,48),random(-48,48),0,0,random(-8,-4),0,0) //32
8A59 M 2 A_FadeOut(0.04) //.01
8A59 M 0 A_TakeInventory("HandyFlag",1)
8A59 M 0 A_JumpIfInventory("HandyFlag",1,"ImOffToTunnelTales")
Goto ImDeadInSpace
ImDeadInSpace:
8A59 M 2 A_FadeOut(0.04)
loop
}
}

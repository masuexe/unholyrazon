actor Balrog : BossBase {
  Player.ScoreIcon "UB059MUG"
  Player.SoundClass "Balrog"
  Player.ForwardMove 0.82, 0.82
  Player.SideMove 0.82, 0.82
  Player.JumpZ 10
  Player.MaxHealth 3750  // Change value if dumb.
  Health 3750
  Player.MorphWeapon "Balrog_W"
  // PainSound "Pain/BalrogBoss"
  States {
   Spawn:
    8A59 A 0
    8A59 A 1 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 A 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 A 0 A_JumpIfInventory("Balrog_MadDash", 1, "ARunX")
    8A59 A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn+2
   See:
    8A59 A 0 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    8A59 B 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 B 5 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    8A59 C 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 C 5 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    8A59 D 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 D 5 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    8A59 E 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 E 5 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn
   Jumping:
    8A59 B 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 M 0 A_JumpIfInventory("Balrog_MadDash", 1, "ARunX")
    8A59 M 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
    8A59 F 0
    8A59 F 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 F 0 A_JumpIfInventory("Balrog_MadDash", 1, "ARunX")
    8A59 F 0 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air")
    8A59 FFFFF 1 A_JumpIfInventory("Balrog_MadDash", 1, "ARunX")
    8A59 G 8 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn
   Missile_Air:
    8A59 NONO 2 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    goto Jumping
   Missile_Item:
    8A59 FG 3
    8A59 F 0 A_JumpIfInventory("Balrog_Animate", 1, "Missile_Item")
    8A59 G 2 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn
   ARunX:
    8A59 B 0 A_JumpIfInventory("Balrog_MadDash", 4, "ARunX3")
    8A59 B 0 A_JumpIfInventory("Balrog_MadDash", 3, "ARunX2")
    8A59 B 0 A_JumpIfInventory("Balrog_MadDash", 2, "ARunX1")
    8A59 BB 1
    8A59 B 0 A_JumpIfInventory("Balrog_MadDash", 1, 1)
    goto Missile+2
   ARunX1:
    8A59 CC 1
    8A59 C 0 A_JumpIfInventory("Balrog_MadDash", 1, 1)
    goto Missile+2
   ARunX2:
    8A59 DD 1
    8A59 D 0 A_JumpIfInventory("Balrog_MadDash", 1, 1)
    goto Missile+2
   ARunX3:
    8A59 EE 1
    8A59 E 0 A_JumpIfInventory("Balrog_MadDash", 1, "ARunX")
    goto Missile+2
   ClassPain:
    8A59 H 0 A_SpawnItemEx("Balrog_Pain_Spawner")
    8A59 H 0 A_PlaySoundEx("Pain/BalrogBoss", "SoundSlot5")
    goto MegamanPain
   ClassDeath:
    8A59 H 0
    goto MegamanDeath
   MegamanDeath0:
    TNT1 A 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TNT1 A 1 A_SpawnItemEx("Balrog_RealCorpse", 0, 0, 0, 0, 0, 4, 0, 9)
    goto MegamanErase
  }
}

actor Balrog_Pain_Spawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    // TNT1 A 0 A_PlaySoundEx("Pain/BalrogBoss","Voice")
    TNT1 AA 0 A_SpawnItemEx("Balrog_Pain_FX", random(-6, 6), random(-6, 6), random(6, 96), random(-18, 18), random(-18, 18), random(-8, 18))
    stop
  }
}

actor Balrog_Pain_FX : BasicGraphicEffect {
  Translation "192:192=43:43", "198:198=191:191"
  Alpha 1.0
  Speed 20   // 40
  Scale 3.5  // 2.5
  States {
   SpawnFrame:  // X_2G
    X_2G B 3
    X_2G BB 1 A_ScaleVelocity(0.75)
    X_2G B 1 A_FadeOut(0.1)
    goto Spawn+3  // stop //Loop until gone.
  }
}

actor Balrog_RealCorpse {

    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 H 0 A_PlaySoundEx("Boss/BalrogBoom", "Soundslot7")
    8A59 HHHH 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)             // 32
    8A59 AAAAAAAAAFFFFFF 2 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), random(-8, 8), random(-8, 8), random(-8, 8), 0, 0)  // 32
    8A59 F 0 A_SpawnItemEx("Balrog_Flies_Away", 0, 0, 0, 0, 0, 20, 0, 1)  // 2 move
    stop
  }
}

actor Balrog_Flies_Away : BasicGraphicEffect {
  States {
   SpawnFrame:
    8A59 M 0 A_GiveInventory("HandyFlag", 15)  // 10
   ImOffToTunnelTales:
    8A59 M 0 A_SpawnItemEx("Balrog_Smoke_Cloud", random(-48, 48), random(-48, 48), random(-48, 48), 0, 0, random(-8, -4), 0, 0)  // 32
    8A59 M 2 A_FadeOut(0.04)  // .01
    8A59 M 0 A_TakeInventory("HandyFlag", 1)
    8A59 M 0 A_JumpIfInventory("HandyFlag", 1, "ImOffToTunnelTales")
    goto ImDeadInSpace
   ImDeadInSpace:
    8A59 M 2 A_FadeOut(0.04)
    loop
  }
}

actor SutokaWhipBoss : BasicProjectile {
  Translation "192:192=244:244", "198:198=5:5"
  DamageType "SutokaSteal"
  Obituary "%o failed to stop \cmKakusareta \chSutoka \c-(%k)!"
  +DONTSPLASH
  +NOTARGETSWITCH
  +DONTREFLECT
  +THRUGHOST
  +HITTRACER
  ReactionTime 210
  Damage (250)
  Radius 18
  Height 18
  Speed 75
  Scale 4
  States {
   Spawn:
    X_6D A 0
    X_6D AAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("SutokaWhipBoss2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6D A 0 A_CustomMissile("SutokaWhipBossR", 0, 0, 0, 0)
    stop
   XDeath:
   Crash:
    X_6D A 0 A_CustomMissile("SutokaWhipBossR", 0, 0, 0, 0)
    TNT1 A 1 A_JumpIf(CallACS("uh_istracerenemy"), "StealCheck")
    stop
   StealCheck:
    TNT1 A 0 A_JumpIfInventory("PowerProtectBoss", 1, "Death", 8)
    TNT1 A 0 A_JumpIf(CallACS("uh_SutokaStealsAnything"), "StealEnd")
    goto Death
   StealEnd:
    TNT1 A 0 A_PlaySound("PKMN/Thief", 1, 0.75)
    TNT1 A 0 A_PlaySound("PKMN/Thief", 4, 0.75)
    TNT1 A 2
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor SutokaWhipBoss2 : BasicProjectile {
  +DONTBLAST
  Damage (25)
  DamageType "Sutoka"
  Obituary "%o failed to stop \cmKakusareta \chSutoka \c-(%k)!"
  Radius 18
  Height 18
  Scale 3.5
  States {
   Spawn:
    TMFX ABCD 3
    stop
  }
}

actor SutokaWhipBossR2 : SutokaWhipBoss2 {
  Damage (100)
}

actor SutokaWhipBossR : SutokaWhipBoss {
  +NOINTERACTION
  +SEEKERMISSILE
  -HITTRACER
  Damage (0)
  States {
   Spawn:
    X_6D A 0
    X_6D A 0 A_RearrangePointers(0, 0, 2)
    X_6D A 0 A_FaceTarget
    goto Spawn2
   Spawn2:
    X_6D A 0 A_JumpIfCloser(46, "Death")
    X_6D AA 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    X_6D A 1 A_SpawnItemEx("SutokaWhipBossR2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6D A 0 A_JumpIfCloser(46, "Death")
    X_6D A 1 A_SpawnItemEx("SutokaWhipBossR2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6D A 0 A_JumpIfCloser(46, "Death")
    X_6D A 0 A_CountDown
    X_6D A 0 A_JumpIf(!CallACS("uh_IsLiveMorphedBossByPointer", 2), "Death")
    loop
   Death:
   XDeath:
   Crash:
    TNT1 A 1
    stop
  }
}

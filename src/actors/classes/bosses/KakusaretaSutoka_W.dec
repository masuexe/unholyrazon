actor KakusaretaSutoka_W_NormalBar : NormalBar {args 198, 244}

actor KakusaretaSutoka_W : BaseUnholyBossWep {
  Tag "$TAG_KakusaretaSutoka_W"
  Obituary "%o failed to stop \cmKakusareta \chSutoka \c-(%k)!"
  Inventory.Pickupmessage "\chGreed."
  Weapon.AmmoType "UnholyPower1500"
  Inventory.Icon "C_I_50A"
  States {
   Spawn:
    8H05 [ 1
    wait

   Ready:
    // 8H05 A 0 ACS_NamedExecuteWithResult("uh_SetMorphInventory", UH_MORPHINV_POWER_LIMIT, 1500)
    // 8H05 A 0 A_GiveInventory("UnholyPowerDisableRazzle_F")
    8H05 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, KAKUSARETASUTOKA_DYE)
    8H05 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H05 A 2 A_WeaponReady
    8H05 A 0 A_GiveInventory("UnholyPower1500", 2)
    loop

   Fire:
   Attack1:
    // 8H05 BCDEFG 1
    8H05 A 0 A_GiveInventory("VivifyFlag1")
    8H05 A 0 A_ReFire(1)
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H05 A 0 A_FireCustomMissile("SutokaSlashAttackBossThreeSlash", 0, 0, 8, 0)
    8H05 A 0 A_FireCustomMissile("SutaburedoThingBoss", 0, 0, 8, 0)
    8H05 C 2 Offset(-179, 253)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H05 A 0 A_FireCustomMissile("SutokaSlashAttackBossThreeSlash", 0, 0, 8, 0)
    8H05 A 0 A_FireCustomMissile("SutaburedoThingBoss", 1, 0, 8, 0)
    8H05 C 2 Offset(-179, 253)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H05 A 0 A_FireCustomMissile("SutokaSlashAttackBossThreeSlash", 0, 0, 8, 0)
    8H05 A 0 A_FireCustomMissile("SutaburedoThingBoss", -1, 0, 8, 0)
    8H05 C 2 Offset(-179, 253)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 B 2 Offset(-121, 114)
    8H05 B 2 Offset(-70, 74)
    8H05 B 2 Offset(-1, 33)
    8H05 B 0 A_TakeInventory("VivifyFlag1")
    8H05 A 8 A_WeaponReady(14)
    goto ReadyX

   NoAmmo:
    8H05 A 1 ACS_NamedExecuteAlways("core_noammo", 0)
    goto ReadyX
   Flash:
    TNT1 A 6 A_JumpIfInventory("UnholyPower1500", 0, 2)
    TNT1 A 0 A_GiveInventory("UnholyPower1500", 1)
    loop
    TNT1 A 0 A_PlaySoundEx("Contra/C_POWUP", "Body")
    // Each pickup opens one box; Amount 4 would still run Pickup only once.
    TNT1 AAAA 0 A_GiveInventory("AutoPandoraBoxItemSilent")
    TNT1 A 0 A_TakeInventory("UnholyPower1500")
    loop
   AltFire:
   AltAttack1:
    8H05 A 0 A_PlaySoundEx("Pokemon/ShadowBall", "Weapon")
    8H05 A 0 A_FireCustomMissile("SutokaWhipBoss", 0, 0, 8, 0)
    8H05 D 1 Offset(1, 13)
    8H05 D 1 Offset(31, -53)
    8H05 E 1 Offset(80, -69)
    8H05 E 6 Offset(100, -87)
    8H05 D 2 Offset(31, -53)
    8H05 D 3 Offset(1, 13)
    goto ReadyX
  }
}

actor KakusaretaSutoka_W2_NormalBar : NormalBar {args 198, 244}

actor KakusaretaSutoka_W2 : KakusaretaSutoka_W {
  Tag "$TAG_KakusaretaSutoka_W2"
  Inventory.Icon "C_I_50B"
  States {
   Ready:
    8H05 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, KAKUSARETASUTOKA_DYE)
    8H05 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H05 A 2 A_WeaponReady
    8H05 A 0 A_GiveInventory("UnholyPower1500", 2)
    loop

   Fire:
   Attack2:
    8H05 A 0 A_GiveInventory("VivifyFlag2")
    8H05 A 0 A_ReFire(1)
    8H05 A 0  // A_PlaySoundEx("Pokemon/Frustration2","Weapon")
    8H05 B 2 Offset(-1, 33)
    8H05 B 2 Offset(-70, 74)
    8H05 B 2 Offset(-121, 114)
    8H05 C 2 Offset(-146, 201)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-179, 253)
    8H05 C 10 A_PlaySoundEx("Pokemon/HornAttack", "Weapon")
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Body")
    8H05 A 0 A_FireCustomMissile("SutokaSlashAttackBoss", 0, 0, 8, 0)
    8H05 A 0 A_FireCustomMissile("AvenganceStarOfHonor", 0, 0, 8, 0)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 B 2 Offset(-121, 114)
    8H05 B 2 Offset(-70, 74)
    8H05 B 2 Offset(-1, 33)
    8H05 B 0 A_TakeInventory("VivifyFlag2")
    8H05 A 5 A_WeaponReady(14)
    goto ReadyX

   AltFire:
   AltAttack2:
    8H05 A 0 A_GiveInventory("VivifyDelay5")
    8H05 A 0 A_ReFire(1)
    8H05 A 0 A_Stop
    // 8H05 A 0 A_ChangeVelocity(-cos(pitch)*12, 0, sin(pitch)*10,CVF_RELATIVE)
    8H05 A 0 A_Recoil(-15)
    8H05 A 0 A_ChangeVelocity(cos(pitch) * 70, 0, -sin(pitch) * 13, CVF_RELATIVE)
    8H05 A 0 ThrustThingZ(0, 25, 0, 1)
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H05 CCCCCCCCCCCCC 3 Offset(-146, 201) A_FireCustomMissile("SutokaSlashAttackBossAlt2", 0, 0, 8, 0)
    8H05 C 1 Offset(-171, 225)
    8H05 C 1 Offset(-146, 201)
    8H05 B 1 Offset(-121, 114)
    8H05 B 1 Offset(-70, 74)
    8H05 B 1 Offset(-1, 33)
    8H05 B 0 A_TakeInventory("VivifyDelay5")
    8H05 A 4 A_WeaponReady(14)
    goto ReadyX
  }
}

actor KakusaretaSutoka_W3_NormalBar : NormalBar {args 198, 244}

actor KakusaretaSutoka_W3 : KakusaretaSutoka_W {
  Tag "$TAG_KakusaretaSutoka_W3"
  Inventory.Icon "C_I_50C"
  States {
   Ready:
    8H05 A 1 ACS_NamedExecuteAlways("core_weaponcolor", 0, KAKUSARETASUTOKA_DYE)
    8H05 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    8H05 A 2 A_WeaponReady
    8H05 A 0 A_GiveInventory("UnholyPower1500", 2)
    loop

   Fire:
   Attack3:
    // 8H05 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
    // 8H05 BCDEFG 2
    // 8H05 C 0 A_PlaySoundEx("weapon/mirrordeflect","Weapon")
    8H05 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    8H05 A 0 A_FireCustomMissile("SutokaSlashAttackBoss", 0, 0, 8, 0)
    8H05 A 0 A_FireCustomMissile("StarBladeFakeOutAttack1", 0, 0, 8, 0)
    8H05 C 2 Offset(-179, 253)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 B 2 Offset(-121, 114)
    8H05 B 2 Offset(-70, 74)
    8H05 B 2 Offset(-1, 33)
    8H05 A 8 A_WeaponReady(14)
    goto ReadyX

   AltFire:
   AltAttack3:
    8H05 A 0 A_GiveInventory("VivifyDelay6")
    8H05 A 0 A_ReFire(1)
    // "Spread shot Shadow Blade that rips, bounces once"
    8H05 A 0 A_PlaySoundEx("Pokemon/Frustration2", "Weapon")
    8H05 C 2 Offset(-179, 253)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-146, 201)
    8H05 B 2 Offset(-121, 114)
    8H05 B 2 Offset(-70, 74)
    8H05 BB 2 Offset(-1, 33)
    8H05 B 2 Offset(-70, 74)
    8H05 B 2 Offset(-121, 114)
    8H05 C 0 A_PlaySoundEx("weapon/Mirrordeflect2", "Weapon")
    8H05 C 0 A_FireCustomMissile("SutokaThreeStarSlasher", 0, 0, 8, 0)
    8H05 C 0 A_FireCustomMissile("SutokaThreeStarSlasher", -10, 0, 8, 0)
    8H05 C 0 A_FireCustomMissile("SutokaThreeStarSlasher", 10, 0, 8, 0)
    8H05 C 2 Offset(-146, 201)
    8H05 C 2 Offset(-171, 225)
    8H05 C 2 Offset(-179, 253)
    // 8H05 GFEDCB 2
    8H05 A 6 A_WeaponReady(14)
    goto ReadyX
  }
}



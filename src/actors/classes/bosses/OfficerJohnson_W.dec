actor JohnsonMangChargeDamager : BasicExplosion
{
+THRUGHOST
damagetype "Johnson"
Obituary "%o had a concussion due to \cmOfficer \cqJohnson\c- (%k)'s Justice Slam."
States
{
Spawn:
TNT1 A 0 
TNT1 A 0 A_Explode(475,128,0,0,16)
TNT1 A 1 A_SpawnItemEx("OfficerJohnsonChargeFX")
stop
}
}

actor OfficerJohnsonChargeFX : BasicClientSide
{
Scale 3.5
States
{
Spawn:
HEAT FEDCBA 2 A_FadeOut
stop
}
}


actor DireDeadShotAttack : BasicFastProjectile
{
Translation "192:192=135:135","198:198=5:5"
damagetype "Johnson"
Obituary "%o was completely destroyed..."
+SKYEXPLODE
+EXPLODEONWATER
+RIPPER
+DONTBLAST
damage (495)
radius 16
Height 16
Speed 40
scale 12.0
States
{
Spawn:
6P50 UUUVVVWWW 1 bright A_Explode(42,188,0,0,16)
loop
Death:
6P50 UVWUVWUVW 1 bright A_SpawnItemEx("DireBossFlashBombExplosion",random(-90,90),random(-90,90),random(-30,90),0,0,0,0,1)
6P50 UVW 1 bright A_Fadeout
6P50 UVWUVWUVW 1 bright A_SpawnItemEx("DireBossDrillExplode",random(-90,50),random(-90,90),random(-30,90),0,0,0,0,1)
loop
}
}

actor DireBossDrillExplode : BasicExplosion
{
Damagetype "Johnson"
Obituary "%o had met with terrible fate.."
Scale 3.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 bright A_Explode(175,148,0)
X_4L ABCDFHJKMNOPQRST 2 bright
stop
//X_5G EFGHIJKLMNOPQRS 2
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX_Tic2",0,0,0,0,0,0,0,1+16384)
stop

}
}

actor DireBossFlashBombExplosion : BasicExplosion
{
damagetype "Johnson"
Obituary "RIP %o..."
+FORCEXYBILLBOARD
//+DONTSPLASH
Reactiontime 17
Scale 3.5
States
{
Spawn:
X_8G AB 1 bright 
X_8G CD 1 bright
X_8G A 0 A_Explode(275,80,0)
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H0",0,0,0,0,0,0,0,1)
X_8G EFGF 1 bright
X_8G A 0 A_Explode(275,80,0)
Goto Pattern1
Pattern1:
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H1",0,0,0,0,0,0,0,1)
X_8G EFGF 1 bright
Goto DamageNow
Pattern2:
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H2",0,0,0,0,0,0,0,1)
X_8G EFEF 1 bright
Goto DamageNow
DamageNow:
X_8G G 0 A_Explode(275,80,0)
X_8G G 0 A_CountDown
X_8G G 0 A_Jump(256,"Pattern1","Pattern2")
Goto Death
Death:
X_8G GQDQDQN 1 bright
stop
}
}


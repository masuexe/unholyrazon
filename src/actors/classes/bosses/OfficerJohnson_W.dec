actor OfficerJohnson_W_NormalBar : NormalBar { args 229, 41 }
actor OfficerJohnson_W_SecondBar : SecondBar { args 132, 135 }

actor OfficerJohnson_W : BaseUnholyBossWep
{
Tag "$TAG_Boss006_W"
Obituary "%o was defeated by \cmOfficer \cqJohnson \c-(%k)'s SSG!"
Inventory.Pickupmessage "\cqSloth."
weapon.ammotype "UnholyBossAmmo200"
weapon.ammotype2 "UnholyPower1500"
States
{
Spawn:
8H06 [ 1
wait

Ready:
8H06 A 0 A_GiveInventory("UnholyPowerLimit_F",1500)
8H06 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", OFFICERJOHNSON_DYE)
8H06 A 1 ACS_NamedExecuteWithResult("uh_BossMorph", 6,4375,715)
8H06 A 0 A_TakeInventory("StopShield")
8H06 A 0 A_Gunflash("FlashInst")
goto ReadyX
ReadyX:
8H06 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReadyX2")
8H06 A 2 A_WeaponReady(8)
8H06 A 0 A_GiveInventory("UnholyBossAmmo200",2)
loop
ReadyX2:
8H06 A 2 A_WeaponReady
8H06 A 0 A_GiveInventory("UnholyBossAmmo200",2)
//8H06 A 4 A_GiveInventory("UnholyBossAmmo200",1)//FLASH
loop

Fire:
8H06 A 0 A_GiveInventory("StopShield")
8H06 A 0 A_JumpIfInventory("UnholyPower1500",1500,"BewareEvil")
8H06 BCD 1
8H06 E 0 A_PlaySoundEx("BBA_Snd/shotgun_x","Weapon")
8H06 E 0 A_FireCustomMissile("BossRiotGunShot",0,0,8,0,0,0)
8H06 EEE 0 A_FireCustomMissile("BossRiotGunShot1",random(-10,10),0,8,0,0,random(-5,5))
8H06 EEE 0 A_FireCustomMissile("BossRiotGunShot2",random(-10,10),0,8,0,0,random(-5,5))
8H06 EEE 0 A_FireCustomMissile("BossRiotGunShot3",random(-10,10),0,8,0,0,random(-5,5))
8H06 EEE 0 A_FireCustomMissile("BossRiotGunShot4",random(-10,10),0,8,0,0,random(-5,5))
8H06 EEE 0 A_FireCustomMissile("BossRiotGunShot5",random(-10,10),0,8,0,0,random(-5,5))
8H06 EEEEEEEEEEEEDC 3 A_GiveInventory("UnholyBossAmmo200",1)
goto FireEnd
FireEnd:
8H06 B 0 A_TakeInventory("StopShield")
8H06 B 0 A_GunFlash
8H06 BAA 2 A_GiveInventory("UnholyBossAmmo200",1)
Goto ReadyX
BewareEvil:
8H06 A 0 A_GiveInventory("UnholyPowerDazzle_F")
8H06 A 0 A_TakeInventory("UnholyPower1500",1500)
8H06 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
8H06 B 4
8H06 C 48
8H06 D 0 A_PlaySoundEx("Pokemon/ShadowBall","Weapon")
8H06 D 0 A_GiveInventory("Shocked",1)
8H06 D 0 A_TakeInventory("UnholyPowerDazzle_F")
8H06 D 0 A_FireCustomMissile("DireDeadShotAttack",0,0,8,0)
8H06 DE 2
8H06 E 50
8H06 DC 3
goto FireEnd

// Flash:
// 8H06 U 0 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
// 8H06 U 0 A_JumpIfInventory("StopShield",1,5)
// 8H06 WV 2
// 8H06 U 0 A_GiveInventory("StopShield")
// 8H06 U 0 A_GiveInventory("RiotOfficerShieldHitbox_P",1)
// 8H06 U 0 A_SpawnItemEx("RiotOfficerShieldFX",23,-17,6,momx,momy,momz,0,9,0)
// 8H06 U 1 A_JumpIfInventory("StopShield",1,1)
// loop
// 8H06 VW 2
// stop

Flash:
8H06 WV 2
FlashInst:
8H06 U 0 A_GiveInventory("RiotOfficerShieldHitbox_P",1)
FlashLoop:
8H06 U 0 A_SpawnItemEx("RiotOfficerShieldFX",23,-17,6,momx,momy,momz,0,9,0)
8H06 U 1 A_JumpIfInventory("StopShield",1,"FlashEnd")
loop
FlashEnd:
8H06 VW 2
stop

FlashAltBash:
8H06 X 1 A_SpawnItemEx("RiotOfficerShieldFX",23,-17,6,momx,momy,momz,0,9,0)
8H06 Y 0 A_SpawnItemEx("RiotOfficerShieldFX",23,-17,8,momx,momy,momz,0,9,0)
8H06 Y 1 A_JumpIf(!CallACS("uh_PointerIsABoss_CheckInv"), "NoFlash")
goto FlashAltBash+1

AltFire:
8H06 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"PerformThatJustice")
Goto ReadyX
PerformThatJustice:
8H06 A 0 A_TakeInventory("UnholyBossAmmo200",200)
8H06 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
8H06 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
8H06 A 0 A_Stop
8H06 F 2 A_GunFlash("FlashAltBash")
8H06 G 2
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)//SXF_ABSOLUTEMOMENTUM
8H06 G 1 A_Recoil(-10)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-15)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-20)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-25)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-30)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-35)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-40)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-45)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-50)
8H06 G 0 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 1 A_Recoil(-55)
8H06 GGG 1 A_SpawnItemEx("JohnsonMangChargeDamager",0,0,8,momx,momy,momz,0,8,0)
8H06 G 0 A_GunFlash
8H06 G 1
8H06 G 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
8H06 G 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
8H06 G 0 A_Stop
8H06 FAA 2
goto ReadyX
}
}

actor RiotOfficerShieldHitbox_P : CustomInventory

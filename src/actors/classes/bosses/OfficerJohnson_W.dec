TNT1 A 0 A_SpawnItemEx("RiotOfficerShieldHitbox2",28,-12,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("RiotOfficerShieldHitbox3",28,0,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("RiotOfficerShieldHitbox4",28,12,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("RiotOfficerShieldHitbox5",28,24,2,0,0,0,0,1)
stop
}
}


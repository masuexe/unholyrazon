actor GreenElf_W_ScriptBar : ScriptBar {}

actor GreenElf_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 300
Inventory.Pickupmessage "$PU_47"
Obituary "$OB_47W"
Tag "$TAG_GreenElf_W"
weapon.ammotype "StolenTreasureAmmo"
States
{
Spawn:
6H47 [ 6
loop

Deselect:
6H47 A 0
goto DeselectSwap
Select:
6H47 A 0 A_TakeInventory("GreenElfFlag", 1)
goto SelectSwap

Ready:
6H47 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GREENELF_DYE)
6H47 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H47 A 2 A_GiveInventory("GreenElf_WepReady_P")
loop

Flash:
TNT1 A 1 A_GiveInventory("GreenElf_LowHP_P")
loop

Fire:
6H47 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H47 A 0 A_JumpIfInventory("GreenElfQuickDraw",1,4)
6H47 BCD 3
goto FireH
6H47 BCD 2
goto FireH
FireH:
6H47 E 1 A_GiveInventory("GreenElf_FireHold_P")
6H47 E 0 A_Refire("FireH")
FireEnd:
6H47 F 2 A_GiveInventory("GreenElf_Fire_P")
6H47 G 2
Goto Ready2

BotFire:
6H47 A 0 A_FaceTarget
6H47 A 0 A_JumpIfCloser(128,"BotAltfire")
6H47 A 0 A_JumpIfInventory("StolenTreasureAmmo",300,"AltfireOld")
6H47 A 0 A_Jump(32,1)
goto BotFire1
6H47 A 0 A_PlaySoundEx("taunt/D_47","Voice")
6H47 A 0 A_GiveInventory("GreenElfFlag",random(40,80))
goto BotFire1

BotFire1:
6H47 A 0 A_JumpIfInventory("GreenElfQuickDraw",1,4)
6H47 BCD 3 A_Jump(12,"FireEnd")
goto BotFireH
6H47 BCD 2 A_Jump(12,"FireEnd")
goto BotFireH

BotFireH:
6H47 E 0 A_JumpIfInventory("GreenElfFlag",0,"BotFireH2")
6H47 E 0 A_Jump(8,2)
6H47 E 0 A_GiveInventory("GreenElfFlag",random(1,3))
goto BotFireH3
6H47 E 0 A_Recoil(random(-9,9))
6H47 E 0 ThrustThing(angle*256/360+64,random(-12,12),1,0)
goto BotFireH3
BotFireH2:
6H47 E 0 A_Jump(4,2)
6H47 E 0 A_Jump(48,"FireEnd")
goto BotFireH+1
6H47 E 0 A_PlaySoundEx("taunt/D_47","Voice")
6H47 E 0 A_ChangeVelocity(-40,0,momz+4,3)
goto FireEnd
BotFireH3:
6H47 E 0 A_Jump(4,3)
6H47 E 1 A_GiveInventory("GreenElf_FireHold_P")
6H47 E 0 A_Refire("BotFireH")
goto FireEnd
6H47 E 0 A_FaceTarget
goto FireEnd

BotAltfire:
6H47 H 0 A_GiveInventory("VivifyDelay4")
6H47 H 0 A_PlaySound("GNT/RNGMelee",1)
6H47 H 0 A_Refire(1)
6H47 H 18 A_FireCustomMissile("GreenElfMeleeStab",0,0,0,0)
6H47 H 0 A_FaceTarget
6H47 H 2 A_JumpIfCloser(128,"BotAltfire")
6H47 FG 2
Goto Ready2

Altfire:
6H47 A 0 A_GiveInventory("VivifyDelay4")
6H47 A 0 A_Refire(1)
6H47 A 2 Offset(-14,74)A_PlaySound("GNT/RNGMelee",1)
6H47 H 2 Offset(62,68)A_FireCustomMissile("GreenElfMeleeStab",0,0,0,0)
6H47 H 6 Offset(2,32)
6H47 H 2 Offset(28,50)
6H47 H 2 Offset(54,68)
6H47 H 2 Offset(80,86)
6H47 H 2 Offset(106,104)
TNT1 A 2 A_Refire(3)
6H47 A 2 Offset(-18,80)A_Refire(2)
6H47 A 2 Offset(-9,54)A_Refire("Altfire")
Goto Ready2
6H47 H 0 Offset(106,104)A_GiveInventory("VivifyDelay4")
6H47 H 0 A_Refire(1)
6H47 H 2 A_PlaySound("GNT/RNGMelee",1)
goto Altfire+3
AltfireOld:
6H47 G 0 A_GiveInventory("GreenElf_OldAlt_P")
6H47 GFGA 3
Goto Ready2
}
}

actor StolenTreasureAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor GreenElfFlag : Inventory
{
inventory.amount 1
inventory.maxamount 100
}

actor GreenElfSpeed : PowerSpeed
{
Speed 1.0
Powerup.Duration 16
}
actor GreenElfQuickDraw : Powerup
{
Powerup.Duration 14
}

actor GreenElf_WepReady_P : CustomInventory
{
States
{
Pickup:
//A_JumpIfInventory("StolenTreasureAmmo",100,2)
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("StolenTreasureAmmo",2)
stop
}
}

actor GreenElf_LowHP_P : RedWarrior_LowHP_P
{
States
{
Gauntlet2:
TNT1 A 0 A_GiveInventory("PowerDamageGreenElf")
stop
}
}

actor PowerDamageGreenElf : PowerDamage
{
Powerup.Duration 40
DamageFactor "GreenElfArrow", 1.25
DamageFactor "GreenElf", 1.25
}

actor GreenElfBoostCheck_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("UH_IsInputingMovement"),"Booster")
goto NoBoost
Booster:
TNT1 A 0 A_ChangeVelocity(sin(CallACS("UH_FetchInputDir",0))*35,sin(CallACS("UH_FetchInputDir",1))*-35,momz+3,3)
goto End
NoBoost:
TNT1 A 0 ThrustThingZ(0,18+12,0,1)
goto End
End:
TNT1 A 0 A_PlaySound("S_CD/Laser",1)// // //
TNT1 A 0 A_GiveInventory("GreenElfSpeed")
TNT1 A 0 A_TakeInventory("StolenTreasureAmmo",50,1)
TNT1 A 0 A_TakeInventory("StolenTreasureAmmo",50)
TNT1 A 0 A_SpawnItemEx("GreenElfAltFX",0,0,0,0,0,0,0,1)
stop
}
}
actor GreenElf_OldAlt_P : GreenElfBoostCheck_P
{
States
{
Pickup:
TNT1 A 0 A_ChangeVelocity(40,0,momz+4,3)
goto End
}
}

actor GreenElf_FireHold_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("GreenElfSpeed",1,"Pickup2")
TNT1 A 0 A_JumpIfInventory("StolenTreasureAmmo",100,1)
goto Pickup2
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK,1)
goto Pickup2
TNT1 A 0 A_GiveInventory("GreenElfBoostCheck_P")
goto Pickup2
Pickup2:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,3)
TNT1 A 0 A_GiveInventory("GreenElfFlag",1)
TNT1 A 0 A_GiveInventory("StolenTreasureAmmo",1)
stop
TNT1 A 0 A_GiveInventory("GreenElfFlag",2)
TNT1 A 0 A_GiveInventory("StolenTreasureAmmo",2)
stop
}
}

actor GreenElf_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",100,"F_5")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",80,"F_4")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",60,"F_3")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",40,"F_2")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",20,"F_1")
goto F_0
F_5:
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",15,0,-5,0)
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",-15,0,5,0)
F_4:
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",12,0,-4,0)
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",-12,0,4,0)
F_3:
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",9,0,-3,0)
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",-9,0,3,0)
F_2:
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",6,0,-2,0)
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",-6,0,2,0)
F_1:
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",3,0,-1,0)
TNT1 A 0 A_FireCustomMissile("GreenElfArrow",-3,0,1,0)
F_0:
TNT1 A 0 A_FireCustomMissile("GreenElfArrowSnd",0,0,0,0)
End:
TNT1 A 0 A_PlaySound("GNT/Green47",1)
TNT1 A 0 A_GiveInventory("GreenElfQuickDraw")
TNT1 A 0 A_TakeInventory("GreenElfFlag", 1)
stop
}
}


actor GreenElfArrowProtect : PowerProtection
{
Powerup.Duration 3
DamageFactor "GreenElfArrow", 0.202
}

actor GreenElfArrow : BasicFastProjectile
{
Translation "192:192=128:128","198:198=132:132"
damagetype "GreenElfArrow"
Obituary "$OB_47M"
+SKYEXPLODE
+EXPLODEONWATER
+NOEXTREMEDEATH
Damage (200)
Radius 9
Height 9
Speed 100
Scale 2.5
States
{
Spawn:
6P47 A 1 A_SpawnItemEx("GreenElfArrowFX",0,0,0,0,0,0,0,1)
6P47 A 1 A_SpawnItemEx("GreenElfArrowFX2",0,0,0,0,0,0,0,1)
Loop
Death:
6P44 A 5
stop
}
}
actor GreenElfArrowSnd : GreenElfArrow
{
SeeSound "GNT/RNGShot"
}

actor GreenElfArrowFX : BasicClientSide
{
+MISSILE
+FORCEXYBILLBOARD
Alpha 0.85
Speed 60
Scale 2.0
States
{
Spawn:
TNT1 A 2
TMFX HH 1 A_FadeOut(0.1)
6P18 BBBB 1 A_FadeOut(0.1)
stop
}
}
actor GreenElfArrowFX2 : GreenElfArrowFX
{
States
{
Spawn:
TNT1 A 2
TMFX DD 1 A_FadeOut(0.1)
6P18 CCCC 1 A_FadeOut(0.1)
stop
}
}

actor GreenElfAltFX : BasicClientSide
{
Alpha 0.8
States
{
Spawn:
CENT F 4
CENT F 2 A_FadeOut
wait
}
}

actor GreenElfMeleeStab : BasicFastProjectile
{
Translation "192:192=128:128","198:198=132:132"
damagetype "GreenElf"
Obituary "$OB_47A"
+DONTBLAST
RenderStyle None
reactiontime 1
damage (random(201,259))
Radius 20
Height 24
speed 80
scale 2.5
Args 201,259,72,28
var int user_NoTranslation;
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_CountDown
wait
Death:
TNT1 A 0 A_Explode(random(Args[0],Args[1]),Args[2],0,0,Args[3])
goto XDeath
XDeath:
TNT1 A 2 A_SpawnItemEx("GreenElfMeleeStabFX",0,0,10,0,0,0,0,1)
stop
}
}
actor GreenElfMeleeStabFX : BasicClientSide
{
+FORCEXYBILLBOARD
States
{
Spawn:
//6P44 A 6
6P47 B 0
6P47 BCD 4
stop
}
}


actor BusterMistressShiny_W_ScriptBar : ScriptBar {}

actor BusterMistressShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_BusterMistress_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_04"
Obituary "$OB_04W"
weapon.ammotype "SeductiveEnergyAmmo"
States
{
Spawn:
7H04 [ 6
loop

Deselect:
7H04 A 0
goto DeselectSwap
Select:
7H04 A 0
goto SelectSwap

Ready:
7H04 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", BUSTERMISTRESS_SDYE)
7H04 A 0 A_GiveInventory("BusterMistressCloneKill_F")
7H04 A 0 A_TakeInventory("BusterMistressCloneFlag2")
goto Ready2
Ready2:
7H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"Ready2X")
7H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,"Ready3")
7H04 A 2 A_WeaponReady(WRF_NOSECONDARY)
7H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",3)
loop
Ready3:
7H04 A 2 A_WeaponReady
7H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",3)
loop
Ready2X:
7H04 A 1 A_WeaponReady
goto Ready2

Fire:
7H04 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H04 A 0 A_GiveInventory("S_BusterMistressMainF_P")
7H04 CBAA 4
Goto Ready2

BotFire:
7H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"BotFire2")
7H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,1)
goto Fire+1
7H04 A 0 A_Jump(16,"BOOMBADDABOOM")
7H04 A 0 A_Jump(64,1)
goto Fire+1
7H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",10)
goto Fire+1
BotFire2:
7H04 A 0 A_Jump(64,"BotFire3")
7H04 A 0 A_Jump(32,1)
goto Fire+1
7H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",10)
goto Fire+1
BotFire3:
7H04 A 0 A_PlaySoundEx("classes/taunt/bustermistress","Voice")
7H04 A 0 A_FireCustomMissile("S_MistressCopyVisionSpawner",0,0,0,0,0,0)
goto Fire+1

Flash:
TNT1 A 0 A_JumpIfInventory("BusterMistressCloneKill_F",1,3)
TNT1 A 1 A_TakeInventory("SeductiveEnergyAmmo",1,1)
TNT1 A 1 A_JumpIfInventory("SeductiveEnergyAmmo",1,"Flash")
TNT1 A 0 A_TakeInventory("BusterMistressCloneFlag2")
TNT1 A 1 A_GiveInventory("BusterMistressCloneKill_F")
stop


AltFire:
7H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"AltfireCloneOff")
7H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,"BOOMBADDABOOM")
Goto Ready2
BOOMBADDABOOM:
7H04 A 0 A_FireCustomMissile("S_MistressCopyVisionSpawner",0,0,0,0,0,0)
7H04 A 0 A_TakeInventory("BusterMistressCloneKill_F")
7H04 A 0 A_GiveInventory("BusterMistressCloneFlag2")
7H04 A 0 A_TakeInventory("SeductiveEnergyAmmo",8)
7H04 ADEF 2
7H04 A 0 A_GunFlash("Flash",1)
goto Ready2
AltfireCloneOff:
7H04 A 0 A_GiveInventory("BusterMistressCloneKill_F")
7H04 F 0 A_GiveInventory("SeductiveEnergyAmmo",8)
7H04 FEDA 2
7H04 A 0 A_TakeInventory("BusterMistressCloneFlag2")
goto Ready2
}
}

actor S_BusterMistressMainF_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("BusterMistress/Pew",1,0.725)
TNT1 A 0 A_FireCustomMissile("S_MistressShot",0,0,8,0)
TNT1 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,2)
TNT1 A 0 A_GiveInventory("SeductiveEnergyAmmo",16)
stop
TNT1 A 0 A_GiveInventory("BusterMistressFiredFlag")
stop
}
}


actor S_MistressShot : MistressShot
{
Translation "192:192=69:69","198:198=74:74","202:202=4:4","199:199=74:74"
Damage (128)//85
Args 128,108,15//85
}

actor S_MistressCopyVisionSpawner : MistressCopyVisionSpawner
{
Translation "192:192=72:72","198:198=3:3","0:0=74:74","247:247=74:74","4:4=3:3","168:168=3:3","208:208=3:3","210:210=72:72","183:183=72:72","165:165=69:69"//68
States
{
Spawn:
TNT1 A 0
TNT1 A 1
Death:
TNT1 A 0 A_SpawnItemEx("S_MistressCopyVision",0,0,-32,0,0,0,0,1)
stop
}
}


actor S_MistressCopyVision : MistressCopyVision
{
States
{
FireTime:
1H04 F 0 A_GiveToTarget("UH_TargetMarker",1)
1H04 F 0 ACS_NamedExecuteWithResult("core_aimattargetcursor", CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 32)
1H04 F 0 A_PlaySoundEx("weapon/minchrgshot","Body")
1H04 F 0 A_CustomMissile("S_MistressCopyShot",32,0,Random(-2,2),2,-pitch)
1H04 F 5
1H04 FF 1
Goto Waiting
}
}

actor S_MistressCopyShot : S_MistressShot
{
damagetype "SeductiveClone"
Obituary "$OB_04A"
}

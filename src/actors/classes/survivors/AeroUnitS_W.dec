actor AeroUnitS_W_NormalBar : NormalBar {args 107, 117}

actor AeroUnitS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_AeroUnit_W"
Weapon.AmmoUse 2
Inventory.Pickupmessage "$PU_31"
Obituary "$OB_31W"
weapon.ammotype "TerrorEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H31 [ 6
loop

Deselect:
7H31 A 0
goto DeselectSwap
Select:
7H31 A 0
goto SelectSwap

Ready:
7H31 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", AEROUNIT_SDYE)
7H31 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
Goto Ready2
Ready2:
7H31 A 2 A_GiveInventory("AeroUnit_Ready_P")
7H31 A 2 A_GiveInventory("AeroUnit_Ready_P2")
wait

Fire:
7H31 B 2 A_GiveInventory("S_AeroUnit_Fire_P")
7H31 C 1
7H31 C 1 A_GiveInventory("S_AeroUnit_Fire_P")
7H31 B 2
7H31 C 2 A_GiveInventory("S_AeroUnit_Fire_P")
7H31 B 1
Goto Ready2

AltFire:
7H31 B 2 A_GiveInventory("S_AeroUnit_Alt_P")
7H31 CB 2
7H31 A 4
goto Ready2

BotReady:
7H31 A 0
7H31 A 0 A_ChangeFlag("NOBLOCKMONST",1)
7H31 A 0 A_WeaponReady(12)
7H31 A 2 A_Refire("BotFire")
7H31 A 0 A_GiveInventory("TerrorEnergyAmmo",2)
goto BotReady+2
BotFire:
7H31 A 0 A_GiveInventory("TerrorEnergyAmmo",random(4,13))
7H31 A 0 A_JumpIfInventory("TerrorEnergyAmmo",100,"BotFire2")
7H31 A 0 A_Jump(128,1)
goto BotFire1
7H31 A 0 A_JumpIf(momz<=0,1)
goto BotFire1
7H31 A 0 A_JumpIf(momz==0,2)
// 7H31 A 0 A_PlaySound("*djump", 4)
goto BotFire1
7H31 A 0 A_ChangeVelocity(momx,momy,11.5,2)
goto BotFire1
BotFire1:
7H31 C 2 A_GiveInventory("S_AeroUnit_Fire_P")
7H31 C 1
7H31 B 1 A_GiveInventory("S_AeroUnit_Fire_P")
7H31 B 2
goto BotReady+2
BotFire2:
7H31 A 0 A_TakeInventory("TerrorEnergyAmmo",random(10,30))
7H31 A 0 A_Jump(160,"BotAltfire")
7H31 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
7H31 A 0 A_PlaySoundEx("taunt/D_31","Voice")
7H31 AAAAAAAAAA 0 A_FireCustomMissile("S_TerrorSound0",random(-10,10),0,-8,0,0,random(-15,15))
7H31 A 0 A_FireCustomMissile("S_TerrorSoundX",0,0,-8,0)
7H31 BCBAAAAAAA 2 A_TakeInventory("TerrorEnergyAmmo",9)
7H31 A 6 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
Goto BotReady+2
BotAltfire:
7H31 B 2 A_GiveInventory("S_AeroUnit_Alt_P")
7H31 CB 2
7H31 A 4
goto BotReady+2
}
}


actor S_AeroUnit_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/AeroUnitFire",1)
TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
TNT1 A 0 A_FireCustomMissile("S_TerrorSound1",random(-10,10),1,-8,0,0,random(-5,5))
stop
TNT1 A 0 A_FireCustomMissile("S_TerrorSound2",random(-10,10),1,-8,0,0,random(-5,5))
stop
TNT1 A 0 A_FireCustomMissile("S_TerrorSound3",random(-10,10),1,-8,0,0,random(-5,5))
stop
TNT1 A 0 A_FireCustomMissile("S_TerrorSound4",random(-10,10),1,-8,0,0,random(-5,5))
stop
TNT1 A 0 A_FireCustomMissile("S_TerrorSound5",random(-10,10),1,-8,0,0,random(-5,5))
stop
TNT1 A 0 A_FireCustomMissile("S_TerrorSound6",random(-10,10),1,-8,0,0,random(-5,5))
stop
}
}

actor S_AeroUnit_Alt_P : AeroUnit_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TerrorSoundX",0,0,-8,0,0)
goto Take
}
}

actor S_TerrorSound0 : TerrorSound0
{
Translation "192:192=0:0","198:198=107:107"
Damage (68)//45
States
{
D1:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound1P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
D2:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound2P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
D3:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound3P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
D4:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound4P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
D5:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound5P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
D6:
TNT1 A 0 A_SpawnItemEx("S_TerrorSound6P",0,0,0,sqrt(momx*momx+momy*momy),0,Args[1],0,32768)
stop
}
}

actor S_TerrorSound1 : S_TerrorSound0
{
States
{
Spawn:
goto S1
Bounce.Floor:
goto D1
}
}
actor S_TerrorSound2 : S_TerrorSound0{States{Spawn:goto S2 Bounce.Floor:goto D2}}
actor S_TerrorSound3 : S_TerrorSound0{States{Spawn:goto S3 Bounce.Floor:goto D3}}
actor S_TerrorSound4 : S_TerrorSound0{States{Spawn:goto S4 Bounce.Floor:goto D4}}
actor S_TerrorSound5 : S_TerrorSound0{States{Spawn:goto S5 Bounce.Floor:goto D5}}
actor S_TerrorSound6 : S_TerrorSound0{States{Spawn:goto S6 Bounce.Floor:goto D6}}

actor S_TerrorSound1P : S_TerrorSound1
{
-USEBOUNCESTATE
}
actor S_TerrorSound2P : S_TerrorSound2{-USEBOUNCESTATE}
actor S_TerrorSound3P : S_TerrorSound3{-USEBOUNCESTATE}
actor S_TerrorSound4P : S_TerrorSound4{-USEBOUNCESTATE}
actor S_TerrorSound5P : S_TerrorSound5{-USEBOUNCESTATE}
actor S_TerrorSound6P : S_TerrorSound6{-USEBOUNCESTATE}


actor S_TerrorSoundX : TerrorSoundX
{
Translation "192:192=0:0","198:198=117:117","202:202=107:107","199:199=117:117"
Damage (165)//110
}


actor S_TerrorSound0Death : S_TerrorSound0
{
Obituary "$OB_31D"
-USEBOUNCESTATE
Damage(83)//55
}
actor S_TerrorSoundXDeath : S_TerrorSoundX
{
Obituary "$OB_31D"
Damage(158)//105
reactiontime 55
}



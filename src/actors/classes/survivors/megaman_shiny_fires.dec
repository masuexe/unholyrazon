actor ShinyMega_DawnBreaker_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_ShinyMegaGetWhich") == UH_SHINYMEGA_M2, "M2")
   M1:
    TNT1 A 0 A_FireCustomMissile("BlastRuneWave", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("BlastRuneWaveL", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("BlastRuneWaveR", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySoundEx("weapons/mmk/dawnbreakerfire", "Weapon")
    stop
   M2:
    TNT1 A 0 A_FireCustomMissile("DawnBreakerSlam_H", 0, 0, 0, 0)
    TNT1 A 0 A_PlaySoundEx("weapons/mmk/dawnbreakerfire", "Weapon")
    stop
  }
}

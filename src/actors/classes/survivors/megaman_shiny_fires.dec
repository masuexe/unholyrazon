// Shiny MegaMan flat fire CustomInventory leaves.
// Registered via UH_COPYDEFS DefineShinyMegaCopyWep (M1/M2/TRUE + weight).

actor ShinyMega_RollingCutter_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RollingCutterU", 0, 0, 8, 0)
    stop
  }
}


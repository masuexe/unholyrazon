actor BeerMan_W_NormalBar : NormalBar {args 232, 167}

actor BeerMan_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 2//4
  Weapon.AmmoGive 200
  Inventory.Pickupmessage "$PU_25"
  Obituary "$OB_25W"
  Tag "$TAG_BeerMan_W"
  weapon.ammotype "DrunkEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H25 [ 6
    loop

   Deselect:
    6H25 A 0
    goto DeselectSwap
   Select:
    6H25 A 0
    goto SelectSwap

   Ready:
    6H25 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BEERMAN_DYE)
    Goto Ready2
   Ready2:
    6H25 A 18 A_WeaponReady
   Spawn3:
    6H25 R 0 A_JumpIfInventory("DrunkEnergyAmmo", 0, 5)
    6H25 RSTU 2 A_GiveInventory("Beerman_Ready_P")
    loop
    6H25 VWXYZYXWV 2 A_GiveInventory("Beerman_Ready_P")
    6H25 A 8 A_GiveInventory("Beerman_Ready_P")
    wait

   Fire:
    6H25 B 2 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireH:
    6H25 D 2 A_GiveInventory("Beerman_Fire2_P")
    6H25 B 0 A_Refire(1)
    goto FireEnd
    6H25 D 2 A_GiveInventory("Beerman_Fire1_P")
    6H25 B 0 A_Refire(1)
    goto FireEnd
    6H25 D 2 A_GiveInventory("Beerman_Fire2_P")
    6H25 B 0 A_Refire(1)
    goto FireEnd
    6H25 D 2 A_GiveInventory("Beerman_Fire3_P")
    6H25 B 0 A_Refire("FireH")
    goto FireEnd
   FireEnd:
    6H25 BA 2
    Goto Ready2

   AltFire:
    6H25 F 0 A_GiveInventory("VivifyFlag1")
    6H25 F 0 A_Refire(1)
    6H25 F 2 A_JumpIfInventory("IsBot", 1, "BotAlt2")
   AltFireH:
    6H25 G 2 A_GiveInventory("Beerman_Alt_P")
    6H25 F 0 A_Refire("AltFireH")
    goto AltEnd
   AltEnd:
    6H25 F 2 A_TakeInventory("VivifyFlag1")
    Goto Ready2

   BotFire:
    6H25 A 0 A_JumpIfNoAmmo("BotReload")
    6H25 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 200, "BotFire2")
    6H25 A 0 A_Jump(16, "BotFireX")
    6H25 A 0 A_Jump(32, 1)
    goto BotFire1
    6H25 A 0 A_Jump(32, "BotAlt2")
    6H25 A 0 A_Jump(128, "BotAlt1")
    6H25 A 0 A_GiveInventory("DrunkEnergyAmmo", 40)
    goto BotFire1

   BotReload:
    6H25 A 0 A_PlaySoundEx("weapon/pursuitfire", "Weapon")
    6H25 A 4 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    6H25 VWXYZZYXWV 2 A_GiveInventory("DrunkEnergyAmmo", 20)
    6H25 A 4 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    6H25 A 0 A_ReFire("BotAlt2")
    Goto Ready2

   BotFireX:
    6H25 A 0 A_SpawnItemEx("HSH_DustBoostFX")
    6H25 A 0 A_PlaySoundEx("classes/taunt/beerman", "Voice")
    6H25 A 0 A_TakeInventory("DrunkEnergyAmmo", 20)
    6H25 A 0 A_FireCustomMissile("Beerman_TheBeer", -20, 0, 0, 0, 0, 1)
    6H25 A 0 A_FireCustomMissile("Beerman_TheBeer", 20, 0, 0, 0, 0, 1)
    goto BotAlt2

   BotFire1:
    6H25 B 0 A_Jump(4, 3, 3, "BotFire2")
    6H25 D 2 A_GiveInventory("Beerman_Fire2_P")
    6H25 B 0 A_ReFire("BotFire1")
    6H25 B 2
    Goto Ready2
   BotFire2:
    6H25 A 0 A_Jump(8, 6)
    6H25 B 0 A_FireCustomMissile("Beerman_DrunkShot", random(-2, 2), 0, random(-8, 8), 0)
    6H25 D 0 A_TakeInventory("DrunkEnergyAmmo", 4)
    6H25 BD 2
    6H25 B 0 A_ReFire("BotFire2")
    6H25 B 2
    Goto Ready2

   BotAlt1:
    6H25 B 0 A_Jump(4, 3)
    6H25 D 2 A_GiveInventory("Beerman_Alt_P")
    6H25 B 2 A_ReFire("BotAlt1")
    Goto Ready2
    6H25 B 0 A_Jump(128, 1)
    Goto Ready2
   BotAlt2:
    6H25 B 0 A_TakeInventory("DrunkEnergyAmmo", 20, 1)
    6H25 C 0 A_FireCustomMissile("Beerman_TheBeer", 0, 0, 0, 0, 0, 1)
    6H25 B 2
    6H25 CDCD 2
    6H25 A 6
    Goto Ready2
  }
}

actor DrunkEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 200
  +INVENTORY.IGNORESKILL
}

actor Beerman_Ready_P : CustomInventory {
  States {
   Pickup:
    //TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo",20,2)
    //TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    //goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("DrunkEnergyAmmo", 5)
    stop
  }
}


actor Beerman_Fire1_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 //A_JumpIfNoAmmo("")//Doesn't work sadly. No infinite ammo stuff
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 1, "Hose")
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray0", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), 20*cos(-pitch)+4, 0, 20*sin(-pitch)+3, 0, 32)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    goto Snd
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray0", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), 20*cos(-pitch)+4, 0, 20*sin(-pitch)+3, 15, 32)
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray0", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), 20*cos(-pitch)+4, 0, 20*sin(-pitch)+3, -15, 32)
    goto Snd

   Hose:
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*cos(-pitch)+4, 0, (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*sin(-pitch)+3, 0, 32)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    goto Ammo
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*cos(-pitch)+4, 0, (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*sin(-pitch)+3, 15, 32)
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray", cos(-pitch)*14, -10, 32+(sin(-pitch)*14), (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*cos(-pitch)+4, 0, (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*sin(-pitch)+3, -15, 32)
    goto Ammo

   Snd:
    TNT1 A 0 A_PlaySound("weapon/mbuster", 1)
    stop
   Ammo:
    TNT1 A 0 A_TakeInventory("DrunkEnergyAmmo", 2, 1)
    TNT1 A 0 A_TakeInventory("DrunkEnergyAmmo", 1)
    TNT1 A 0 A_PlaySound("Beerman/FireX", 1)//weapon/waterballoon
    stop
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 160, "Snd1")
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 120, "Snd2")
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 80, "Snd3")
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 40, "Snd4")
    goto Snd5
   Snd1:
    TNT1 A 0 A_PlaySound("Beerman/Fire1", 1)
    stop
   Snd2:
    TNT1 A 0 A_PlaySound("Beerman/Fire2", 1)
    stop
   Snd3:
    TNT1 A 0 A_PlaySound("Beerman/Fire3", 1)
    stop
   Snd4:
    TNT1 A 0 A_PlaySound("Beerman/Fire4", 1)
    stop
   Snd5:
    TNT1 A 0 A_PlaySound("Beerman/Fire5", 1)
    stop
   Snd6:
    TNT1 A 0 A_PlaySound("Beerman/Fire6", 1)//weapon/mbuster
    stop
  }
}

  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 1, "Hose")
    TNT1 A 0 A_SpawnItemEx("Beerman_Spray0", cos(-pitch)*14, 0, 32+(sin(-pitch)*14), 20*cos(-pitch)+4, 0, 20*sin(-pitch)+3, 0, 32)

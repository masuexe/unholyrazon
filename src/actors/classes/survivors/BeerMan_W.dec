actor Beerman_TheBeer : BasicProjectile {
  Damagetype "BeermanConcrete"
  Obituary "$OB_25A"
  +RIPPER
  +FLOORHUGGER
  +DONTREFLECT
  Damage (0)
  Height 52
  Radius 14
  Speed 30
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("Beerman_BeerWave")
    stop
   Death:

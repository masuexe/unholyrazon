    TNT1 A 0 A_SpawnItemEx("Beerman_Spray", cos(-pitch)*14, 0, 32+(sin(-pitch)*14), (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*cos(-pitch)+4, 0, (CallACS("rz_CountInv_DrunkEnergyAmmo",0)/200.0f*40.0f+20)*sin(-pitch)+3, -15, 32)
    goto Ammo
  }

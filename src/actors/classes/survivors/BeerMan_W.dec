actor Beerman_BeerWave : Beerman_TheBeer {
  Translation "192:192=232:232", "198:198=167:167", "195:195=210:210"
  +DONTBLAST
  -DONTREFLECT
  +RIPPER
  Damage (18)
  Scale 2.5
  States {
   Spawn:
    6P25 ABCDC 2 A_SpawnItemEx("SoakifyEffect")
    6P25 A 0 A_PlaySoundEx("weapon/waterwave", "Weapon")
    6P25 DCDCBA 2 A_SpawnItemEx("SoakifyEffect")
    stop
   Death:
    TNT1 A 1
    Stop
  }
}






actor Power_RootBeerVision : PowerUp {
  powerup.color "73 2B 00", 0.25
  //powerup.color "C0 70 00", 0.4
  powerup.duration 0x7FFFFFFB//105
}

actor Power_RootBeerTime : PowerUp {
  powerup.duration 55
}

actor Beerman_Concrete_H : BasicWatcher {
  +SERVERSIDEONLY
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_GiveToTarget("Beerman_ConcreteGravity_P", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("Power_RootBeerTime", 1, "Spawn")
    TNT1 A 0 A_TakeFromTarget("Power_RootBeerVision", 1)
    stop
  }
}

actor Beerman_ConcreteStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Power_RootBeerVision", 1, 3)
    TNT1 A 0 A_SpawnItemEx("Beerman_Concrete_H")
    TNT1 A 0 A_GiveInventory("Power_RootBeerVision")
    TNT1 A 0 A_GiveInventory("Power_RootBeerTime")
    stop
  }
}
actor Beerman_ConcreteGravity_P : CustomInventory {
  States {
   Pickup:
    TNT1 AAAAAA 0 A_SpawnItemEx("Beerman_ConcreteFX", random(-20, 20), random(-20, 20), frandom(8, 16), 0, 0, -1)
    TNT1 A 0 A_JumpIf(z-floorz<5, 2)
    TNT1 A 0 ThrustThingZ(0, 20, 1, 1)
    TNT1 A 0
    stop
  }
}

actor Beerman_ConcreteFX : BasicClientSide {
  Translation "192:192=232:232", "198:198=167:167"
  +FORCEXYBILLBOARD
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 10, 11)
    X_9A GGGGGHHHHH 1 ThrustThingZ(0, 4, 1, 1)
    stop
    X_9A HHHHHGGGGG 1 ThrustThingZ(0, 4, 1, 1)
    stop
  }
}

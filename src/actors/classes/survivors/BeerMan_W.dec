actor Beerman_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo", 1, "Waves")
    TNT1 A 0 A_FireCustomMissile("Beerman_Wave0", 0, 0, 0, 0, 0, 1)
    //TNT1 A 0 A_FireCustomMissile("Beerman_DrunkShot",frandom(-3,3),0,frandom(-10,10),frandom(-10,10),1,frandom(-3,3))
    TNT1 A 0 A_PlaySound("weapon/mbuster", 1)
    stop
   Waves:
    TNT1 A 0 A_FireCustomMissile("Beerman_Wave", 0, 0, 0, 0, 0, 1)//Beerman_SprayWave
    TNT1 A 0 A_TakeInventory("DrunkEnergyAmmo", 4, 1)
    TNT1 A 0 A_TakeInventory("DrunkEnergyAmmo", 2)
    TNT1 A 0 A_PlaySound("weapon/waterwave", 1)
    TNT1 A 0
    stop
  }
}

actor Beerman_Spray : BasicProjectile {
  Translation "192:192=232:232", "198:198=167:167", "0:0=235:235"
  Damagetype "BeermanConcrete"
  Obituary "$OB_25M"
  +DONTSPLASH
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +VISIBILITYPULSE
  Gravity 1.65
  RenderStyle "Translucent"
  Alpha 0.25
  Damage (random(20, 34))
  radius 14
  height 16
  Speed 60
  Scale 2.5
  States {
   Spawn:
    TNT1 A 2
    TNT1 A 0 A_Jump(256, 1, 2, 3)
   SpawnL:
    X_8H BCD 1
    loop

   Death:
    X_8H K 0 A_SpawnItemEx("SoakifyEffect")
    X_8H K 0 //A_SetGravity(0.0)//A_SetTranslucent(1)
    X_8H K 0 //A_CheckCeiling("DeathUp")//Doesn't work online due to gravity
    X_8H KLMN 2
    stop
   DeathUp:
    X_8H O 0
    X_8H OPQR 2
    stop
  }
}


actor Beerman_Spray0 : Beerman_Spray {
  Translation "192:192=232:232", "198:198=167:167", "0:0=4:4"
  Damagetype "Beerman"
  Damage (random(10, 17))
  Speed 20
}

actor Beerman_SprayWave : Beerman_Spray {
  Gravity 3.3
  Damage (random(30, 44))
  Speed 40
  States {
   XDeath:
   Crash:
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("Beerman_Wave", 2, 0, 100, 30, 0, 20, 0, 1)
    stop
  }
}

actor Beerman_DrunkShot : BasicProjectile {
  Translation "192:192=232:232", "198:198=167:167"
  damagetype "BeermanConcrete"
  Obituary "$OB_25M"
  Damage (random(50, 70))
  radius 14
  height 16
  Speed 70
  scale 2.5
  States {
   Spawn:
    6P25 E 0
    6P25 E 0
    6P25 E 0 A_Jump(256, 1, "S2", "S3", "S4")
    6P25 EFGFEFGF 2
    goto End
   S2:
    6P25 FGFEFGFE 2
    goto End
   S3:
    6P25 GFEFGFEF 2
    goto End
   S4:
    6P25 FEFGFEFG 2
    goto End
   End:
    6P25 E 0 A_CountDownArg(0)
    stop
   Death:
    X_AB B 4 A_SpawnItemEx("SoakifyEffect")
    stop
  }
}

actor Beerman_Wave : BasicProjectile {
  Translation "192:192=232:232", "198:198=167:167", "195:195=235:235"
  Damagetype "BeermanConcrete"
  Obituary "$OB_25A"
  +RIPPER
  +FLOORHUGGER
  //+STEPMISSILE
  //maxstepheight 32
  //+NODROPOFF
  //MaxDropOffHeight 640
  Damage (random(19, 25))
  Radius 16
  Height 52
  Speed 33
  Scale 2.5
  States {
   Spawn:
    6P25 ABCDCBCDCBCDCBCDCBCDCBA 2
    stop
   Death:
    TNT1 A 1 A_SpawnItemEx("SoakifyEffect")
    Stop
  }
}
actor Beerman_Wave0 : Beerman_Wave {

  States {
   Spawn:
    LIBO B 0
    LIBO B 0 A_GiveToTarget("FireLightningBoltEndpointU_P")  // populates the distance
    LIBO C 2 A_SpawnItemEx("LightningStartFX1", 0, 0, 48)
    LIBO C 0 A_GiveToTarget("FireLightningBoltGuessShooterU_P")
    LIBO D 2 A_SpawnItemEx("LightningStartFX2", 0, 0, 48)
    LIBO EF 2
    TNT1 A 10
    TNT1 A 12 A_GiveToTarget("FireLightningBoltTracerShooterU_P")
    TNT1 A 0 A_TakeFromTarget("LightningBoltLength")
    stop
  }
}

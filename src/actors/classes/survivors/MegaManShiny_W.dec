actor S_BreakDashCheckU : BreakDashCheckU {
  +FORCEXYBILLBOARD
  ReactionTime 1
  Scale 2.5
  States {
   Spawn:
    BDAS B 0
    BDAS BBBBB 1 A_SpawnItemEx("BreakDashSpark", 0, 0, 0, -frandom(8, 16), 0, frandom(4, 16), frandom(-20, 20), 1)
    BDAS B 1 A_CountDown
    wait
   XDeath:
    TNT1 A 0 A_PlaySoundEx("weapons/mmv/breakdashimpact", "Weapon")
    TNT1 A 0 A_SpawnItemEx("BreakDashQuake")
   Death:
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BreakDashSpark", 0, 0, 0, -frandom(8, 16), 0, frandom(4, 16), frandom(-20, 20), 1)
    TNT1 A 1
    stop
  }
}

// It should be noted that slopes cause this to break, so 2 more failsafes were added to try to fight that  ~Zomo
actor S_SakugarnePogoU : BasicProjectile {
  DamageType "Sakugarne"
  Obituary "$OB_SAKUGARNE"
  -NOGRAVITY
  +THRUACTORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +BOUNCEONFLOORS
  +USEBOUNCESTATE
  BounceCount 20
  ReactionTime 20  // 35
  Damage (100)
  Height 56
  Radius 20
  Speed 20
  Scale 2.5
  Args 20
  States {
   Spawn:
    TNT1 A 0
   SpawnAir:
    SAKU B 10 A_CountDown
    wait
   Bounce.Floor:
    SAKU A 0 A_SpawnItemEx("SakugarneDrillerU", 0, 0, 0, 0, 0, 0, 0, 1)
    SAKU A 0 A_PlaySoundEx("weapons/mmk/sakugarneactivate", "Weapon")
    SAKU A 0 A_ChangeFlag("NOGRAVITY", 1)
    SAKU A 6 A_ChangeVelocity(0, 0, 0, 2)
    SAKU A 0 A_ChangeFlag("NOGRAVITY", 0)
    SAKU A 0 A_ChangeVelocity(10, 0, 10, 3)
    SAKU A 0 A_CountdownArg(0)
    goto SpawnAir
   Death:
    TNT1 A 0 A_SpawnItemEx("S_SakugarnePogoFXU", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}


actor S_SakugarnePogoFXU : BasicClientSide {
  States {
   Spawn:
    SAKU A 4
    SAKU B 8 A_ChangeVelocity(0, 0, 20, 3)
    SAKU B 1 A_FadeOut(0.25)
    wait
  }
}

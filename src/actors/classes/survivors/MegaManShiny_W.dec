actor MegamanUShiny_W_ScriptBar : ScriptBar {}

actor MegamanUShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Megaman_W"
  Weapon.AmmoUse 1
  Weapon.AmmoGive 3
  Weapon.SlotNumber 1
  Scale 2.0
  Obituary "%o was bombed by %k's \cgS\ciH\cfI\cdN\chY \c-BUSTER."
  Inventory.Pickupmessage "You got the Shiny Buster!"
  Weapon.AmmoType "S_RockNRollAmmo"
  States {
   Spawn:
    7H00 [ 6
    loop

   Deselect:
    BUST B 0
    goto DeselectSwap
   Select:
    BUST B 0
    goto SelectSwap

   Ready:
    BUST B 1 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE)
    BUST B 0 A_GiveInventory("BlackHoleTrigger")
    BUST B 0 A_TakeInventory("SakugarneActive")
    BUST B 0 A_GunFlash("Flash", 1)
    goto Ready2
   Ready2:
    7H00 "#" 0 A_JumpIfInventory("S_RockNRollAmmo", 4, "Ready3")
    7H00 "#" 8 A_WeaponReady(8)
    7H00 "#" 0 A_GiveInventory("S_RockNRollAmmo", 1)
    loop
   Ready3:
    7H00 A 8 A_WeaponReady
    7H00 A 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 D 8 A_WeaponReady
    7H00 D 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 G 8 A_WeaponReady
    7H00 G 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 J 8 A_WeaponReady
    7H00 J 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 M 8 A_WeaponReady
    7H00 M 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 P 8 A_WeaponReady
    7H00 P 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 S 8 A_WeaponReady
    7H00 S 0 A_GiveInventory("S_RockNRollAmmo", 1)
    7H00 V 8 A_WeaponReady
    7H00 V 0 A_GiveInventory("S_RockNRollAmmo", 1)
    loop

   Fire:
    BUST B 0 A_GiveInventory("S_MegamanMainRNG_P")  // S_MegamanTrueRNG_P
    goto FireAnim
   Altfire:
    BUST B 0 A_GiveInventory("S_MegamanAltRNG_P")  // S_MegamanFireShot2_P
    goto AltFireAnim

   FireAnim:
    BUST B 0 A_Jump(256, "FireAnim1", "FireAnim2", "FireAnim3", "FireAnim4", "FireAnim5", "FireAnim6", "FireAnim7", "FireAnim8")
   FireAnim1:
    7H00 BC 3
    7H00 A 6
    7H00 A 0 A_ReFire
    goto Ready2
   FireAnim2:
    7H00 EF 3
    7H00 D 6
    7H00 D 0 A_ReFire
    goto Ready2
   FireAnim3:
    7H00 HI 3
    7H00 G 6
    7H00 G 0 A_ReFire
    goto Ready2
   FireAnim4:
    7H00 KL 3
    7H00 J 6
    7H00 J 0 A_ReFire
    goto Ready2
   FireAnim5:
    7H00 NO 3
    7H00 M 6
    7H00 M 0 A_ReFire
    goto Ready2
   FireAnim6:
    7H00 QR 3
    7H00 P 6
    7H00 P 0 A_ReFire
    goto Ready2
   FireAnim7:
    7H00 TU 3
    7H00 S 6
    7H00 S 0 A_ReFire
    goto Ready2
   FireAnim8:
    7H00 WX 3
    7H00 V 6
    7H00 V 0 A_ReFire
    goto Ready2

   AltFireAnim:
    BUST B 0 A_Jump(256, "AltFireAnim1", "AltFireAnim2", "AltFireAnim3", "AltFireAnim4", "AltFireAnim5", "AltFireAnim6", "AltFireAnim7", "AltFireAnim8")
   AltFireAnim1:
    7H00 BC 3
    7H00 A 6
    goto Ready2
   AltFireAnim2:
    7H00 EF 3
    7H00 D 6
    goto Ready2
   AltFireAnim3:
    7H00 HI 3
    7H00 G 6
    goto Ready2
   AltFireAnim4:
    7H00 KL 3
    7H00 J 6
    goto Ready2
   AltFireAnim5:
    7H00 NO 3
    7H00 M 6
    goto Ready2
   AltFireAnim6:
    7H00 QR 3
    7H00 P 6
    goto Ready2
   AltFireAnim7:
    7H00 TU 3
    7H00 S 6
    goto Ready2
   AltFireAnim8:
    7H00 WX 3
    7H00 V 6
    goto Ready2


   Flash:
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE1, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE2, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE3, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE4, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE5, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE6, 1)
    TNT1 A 0 A_GiveInventory("MegaManSColor_F", 1)
    TNT1 A 7 ACS_NamedExecuteWithResult("core_weaponcolor", MEGAMAN_SDYE7, 1)
    TNT1 A 0 A_TakeInventory("MegaManSColor_F")
    loop


    // Flash2:
    // TNT1 A 7 ACS_ExecuteAlways(991,0,5001)//>>5012
    // loop
  }
}

actor S_RockNRollAmmo : Ammo {
  Inventory.MaxAmount 28
  +INVENTORY.IGNORESKILL
}

actor MegaManSColor_F : Inventory {
  Inventory.MaxAmount 7
}

actor S_MegamanMainRNG_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("S_RockNRollAmmo", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyMegaRollCustom", 0)
    stop
  }
}

actor S_MegamanAltRNG_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("S_RockNRollAmmo", 4, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyMegaRollCustom", 1)
    stop
  }
}

actor S_MegamanFireShot_P : BallAction {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapons/busters/megabusterfire", "Weapon")
    TNT1 A 0 A_FireCustomMissile("S_ChargeShotU", 0, 0, 8, 0)
    TNT1 A 0 A_JumpIf(CallACS("core_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_FireCustomMissile("S_ChargeShotU", 0, 0, 8, 0)
    TNT1 A 0 A_FireCustomMissile("S_ChargeShotU", 0, 0, 8, 0)
    stop
  }
}
actor S_MegamanFireShot2_P : BallAction {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MegaBallKickedU", 0, 0, 0, 0)
    TNT1 A 0 A_JumpIf(CallACS("core_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_FireCustomMissile("MegaBallKickedU", 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("MegaBallKickedU", 0, 0, 0, 0)
    stop
  }
}

actor S_ChargeShotU : ChargeShotU {
  Obituary "%o was bombed by %k's \cgS\ciH\cfI\cdN\chY \c-BUSTER."
  Damage (250)
}


actor S_FlameSwordU_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    FHUD A 0 A_JumpIf(CallACS("rz_CheckPointerFooting", AAPTR_TARGET, 0), "GroundSwing")
    goto AirSwing
   GroundSwing:
    TNT1 A 1 A_GiveToTarget("FireFlameSwordU_P1")
    TNT1 A 1 A_GiveToTarget("FireFlameSwordU_P2")
    TNT1 A 1 A_GiveToTarget("FireFlameSwordU_P3")
    TNT1 A 1 A_GiveToTarget("FireFlameSwordU_P4")
    TNT1 A 1 A_GiveToTarget("FireFlameSwordU_P5")
    stop
   AirSwing:
    TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P1")
    TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P2")
    TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P3")
    TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P4")
    TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P5")
    stop
  }
}

    TNT1 A 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 180, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 135, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 90, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 45, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 0 A_SpawnItemEx("FireShieldDamage", 0, 0, 28)
    TNT1 A 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 315, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 270, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 225, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 0 A_SpawnItemEx("FireShieldDamage", 0, 0, 28)
    TNT1 A 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 180, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 135, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 90, SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, 8 + 64) TNT1 A 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 45, SXF_ABSOLUTEMOMENTUM, 0)

    TNT1 A 0 A_GiveToTarget("FireWaveBurnU_Pm2")
    TNT1 A 1
    TNT1 A 0 A_GiveToTarget("FireWaveBurnU_Pm1")
    TNT1 A 1
    TNT1 A 0 A_GiveToTarget("FireWaveBurnU_P0")
    stop
  }
}
actor FireWaveBurnU_P0 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    TNT1 A 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    TNT1 A 0 A_Jump(256, "NotUnderWater")
    goto NotUnderWater
   NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", 0, 0, 8, 0)
    stop
   UnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnUWU", 0, 0, 8, 0)
    TNT1 A 0 A_Jump(random(16, 128), 2)
    TNT1 A 0 A_FireCustomMissile("WaveBurnerBubbleFX", random(-7, 7), 0, 8, 0, 0, random(-4, 4))
    TNT1 A 0
    stop
  }
}
actor FireWaveBurnU_P1 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", 5, 0, 8, 0) stop}}
actor FireWaveBurnU_P2 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", 10, 0, 8, 0) stop}}
actor FireWaveBurnU_P3 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", 15, 0, 8, 0) stop}}
actor FireWaveBurnU_Pm1 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", -5, 0, 8, 0) stop}}
actor FireWaveBurnU_Pm2 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", -10, 0, 8, 0) stop}}
actor FireWaveBurnU_Pm3 : FireWaveBurnU_P0 {States {NotUnderWater:
    TNT1 A 0 A_FireCustomMissile("WaveBurnU", -15, 0, 8, 0) stop}}


actor S_TornadoBlowU_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveToTarget("FireTornadoBlow1", 1)
    TNT1 A 0 A_SpawnItemEx("TornadoDamagerU")
    TNT1 A 1 A_GiveToTarget("TornadoBlowThrust", 1)
    TNT1 AA 1
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 72)
    TNT1 A 0 A_GiveToTarget("FireTornadoBlow2", 1)
    TNT1 A 0 A_SpawnItemEx("TornadoDamagerU")
    TNT1 A 1 A_GiveToTarget("TornadoBlowThrust", 1)
    TNT1 AA 1
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 72)
    TNT1 A 0 A_GiveToTarget("FireTornadoBlow3", 1)
    TNT1 A 0 A_SpawnItemEx("TornadoDamagerU")
    TNT1 A 1 A_GiveToTarget("TornadoBlowThrust", 1)
    TNT1 A 1
    TNT1 A 1
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, 72)
    TNT1 A 0 A_GiveToTarget("FireTornadoBlow4", 1)
    TNT1 A 0 A_SpawnItemEx("TornadoDamagerU")
    TNT1 AA 1 A_GiveToTarget("TornadoBlowThrust", 1)
    TNT1 AAAAA 3 A_GiveToTarget("TornadoBlowThrust", 1)
    stop
  }
}

actor FireMagmaBazookaU_P : CustomInventory {
  States {
   Pickup:
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 0, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", -16, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", 16, 0, 8, 0)
    stop
  }
}

actor FireTripleBladeU_P : CustomInventory {
  States {
   Pickup:
    TRIP C 0 A_FireCustomMissile("TripleBladeU", 0, 0, 8, 0, 0, 0)
    TRIP C 0 A_JumpIf(pitch > 270 && pitch < 270 + 11.25, "Top")
    TRIP C 0 A_JumpIf(pitch > 90 - 11.25 && pitch < 90, "Bottom")
    goto Center
   Top:
    TRIP C 0 A_FireCustomMissile("TripleBladeRU", 180, 0, 8, 0, 0, 11.25)
    TRIP C 0 A_FireCustomMissile("TripleBladeU", 0, 0, 8, 0, 0, -11.25)
    stop
   Bottom:
    TRIP C 0 A_FireCustomMissile("TripleBladeU", 0, 0, 8, 0, 0, 11.25)
    TRIP C 0 A_FireCustomMissile("TripleBladeRU", 180, 0, 8, 0, 0, -11.25)
    stop
   Center:
    TRIP C 0 A_FireCustomMissile("TripleBladeU", 0, 0, 8, 0, 0, 11.25)
    TRIP C 0 A_FireCustomMissile("TripleBladeU", 0, 0, 8, 0, 0, -11.25)
    stop
  }
}

actor S_BlackHoleBomb_Fire_P : Custominventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("S_BlackHoleBomb", 0, 8, 32, cos(-pitch) * 10, 0, sin(-pitch) * 10, 0, SXF_TRANSFERTRANSLATION | SXF_TRANSFERPITCH)
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
    stop
   PickupSpread:
    TNT1 A 0 A_SpawnItemEx("S_BlackHoleBomb", -48, 8 + 32, 32, cos(-pitch) * 10, 0, sin(-pitch) * 10, 0, SXF_TRANSFERTRANSLATION | SXF_TRANSFERPITCH)
    TNT1 A 0 A_SpawnItemEx("S_BlackHoleBomb", -48, 8 - 32, 32, cos(-pitch) * 10, 0, sin(-pitch) * 10, 0, SXF_TRANSFERTRANSLATION | SXF_TRANSFERPITCH)
    stop
  }
}

actor S_BlackHoleBomb : BlackHoleBomb {
  States {
   Death:
    BLKH B 0 A_TakeFromTarget("BlackHoleFlag")
    BLKH B 0 A_StopSound
    goto Explode
  }
}

actor Shiny_WaterShieldU_H : BasicWatcher {
  Args 8
  States {
   Spawn:
    TNT1 A 0
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("Shiny_WaterShieldU", 64, 0, -24, 0, 0, 0, 45 * args[0])
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}
actor Shiny_WaterShieldU : WaterShieldU {
  -BOUNCEONWALLS
  States {
   Spawn:
    WATS B 0
    WATS B 0 A_SetUserVar("user_angle", angle)
    goto Shoot
  }
}

actor S_ElectricShock_H : BasicWatcher {
  ReactionTime 3
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapons/mmv/electricshockfire", "Weapon")
    TNT1 A 0 A_GiveToTarget("FireElectricShockBurstStart_P")
    TNT1 A 0 A_GiveToTarget("FireElectricShockDamager_P")
    TNT1 A 1 A_JumpIfInTargetInventory("PowerDoubleFiringSpeed", 1, 1)
    TNT1 A 1
    TNT1 A 0 A_Countdown
    loop
  }
}
actor FireElectricShockBurstStart_P : CustomInventory {States {Pickup:
    TNT1 A 0 A_FireCustomMissile("ElectricShockBurstStart", 0, 0, 0, 0) stop}}
actor FireElectricShockDamager_P : CustomInventory {States {Pickup:
    TNT1 A 0 A_FireCustomMissile("S_ElectricShockDamagerU", 0, 0, 0, 0) stop}}

actor S_ElectricShockDamagerU : ElectricShockDamagerU {
  Damage (270)  // 90
  // Radius 20//10
  // Height 20//10
}


actor S_BlackHoleSpawnerU : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BlackHoleSpawnerSync")
    TNT1 A 12
    // TNT1 A 0 A_Warp(2,0,0,32,0,24)
    // TNT1 A 0 A_PlaySoundEx("weapons/mmv/blackholetrigger","Weapon")
    TNT1 A 0 A_SpawnItemEx("BlackHoleTrigger_W")

actor HandyManShiny_W_NormalBar : NormalBar {args 228, 75}

actor HandyManShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_HandyMan_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_41"
Obituary "$OB_41W"
weapon.ammotype "HandyHandAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H41 [ 6
loop

Deselect:
7H41 Q 0 A_GiveInventory("StopShield",1)
goto DeselectSwap
Select:
7H41 Q 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
7H41 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", HANDYMAN_SDYE)
7H41 Q 0 A_TakeInventory("HandyFlag")
7H41 Q 2 A_GiveInventory("StopShield",1)//Morph skips Deselect/Select
Goto Ready2
Ready2:
7H41 A 2 A_TakeInventory("StopShield")
7H41 A 0 A_GunFlash("Flash",1)
goto ReadyX
ReadyX:
7H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,"ReadyX3")
7H41 A 2 A_WeaponReady(WRF_NOSECONDARY)
7H41 A 0 A_GiveInventory("HandyHandAmmo",4)
loop
ReadyX3:
7H41 A 2 A_WeaponReady
7H41 A 0 A_GiveInventory("HandyHandAmmo",4)
goto ReadyX

Flash:
TNT1 A 0 A_GiveInventory("HandyShieldHitbox_P")
TNT1 A 0 A_JumpIfInventory("StopShield",1,"NoFlash")
TNT1 A 1 A_GiveInventory("HandyShieldBackFX_P")
goto Flash+1
Flash.Ammo:
TNT1 A 2 A_GiveInventory("HandyHandAmmo",2)
loop
Flash.AirTimer:
TNT1 A 0 A_SetArg(4,1)
TNT1 A 2 A_SetArg(4,Args[4]+1)
wait

Fire:
7H41 B 0 A_JumpIfInventory("HandyFlag",1,"QuakeBoostUp")
7H41 B 0 A_GiveInventory("StopShield",1)
7H41 B 1 A_GunFlash("Flash.Ammo",1)
7H41 E 1
FireH:
7H41 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H41 C 0 A_PlaySound("S3_K/SpikeMine",1)
7H41 C 0 A_FireCustomMissile("S_HandyFistShot2",0,0,-28,8)
7H41 C 0 A_FireCustomMissile("S_HandyFistShot",0,0,28,8)
7H41 CDE 2
7H41 E 10
7H41 EEFG 2 A_ReFire("FireH")
7H41 H 0 A_GiveInventory("Handyman_FireAltCheck_P")
7H41 H 2 A_ReFire("FireH")
7H41 I 0 A_GiveInventory("Handyman_FireAltCheck_P")
7H41 I 2 A_ReFire("FireH")
7H41 J 0 A_GiveInventory("Handyman_FireAltCheck_P")
7H41 J 2 A_ReFire("FireH")
7H41 K 0 A_GiveInventory("Handyman_FireAltCheck_P")
7H41 K 2 A_ReFire("FireH")
7H41 A 0 A_ReFire("FireH")
Goto Ready2

BotFire:
7H41 A 0 A_Jump(4,"BotFireX")
7H41 A 0 A_Jump(8,"QuakeStart")
7H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,1)
goto FireH+1
7H41 A 0 A_Jump(10,"BotFireX")
7H41 A 0 A_Jump(32,"QuakeStart")
goto FireH+1
BotFireX:
7H41 A 0 A_JumpIfInventory("HandymanBotPowerD",1,"QuakeStart")
7H41 A 0 A_PlaySoundEx("taunt/D_41","Voice")
7H41 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
7H41 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
7H41 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("HandyHandBotChargeStart",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_S_Handyman",1000,9)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
7H41 A 2 A_PlaySound("S_Spin/Explode",4)
7H41 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
7H41 A 0 A_GiveInventory("HandymanBotPowerD",1)
7H41 A 0 A_GiveInventory("HandymanBotPowerS",1)
7H41 A 2 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Goto FireH+1

Altfire:
7H41 A 0 A_JumpIfInventory("HandyFlag",1,"QuakeBoostDown")
7H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,"QuakeStart")
Goto ReadyX
QuakeStart:
7H41 L 0 A_GiveInventory("Handyman_AltStart_P")
7H41 L 0 A_ReFire(1)
7H41 L 3 A_GunFlash("Flash.AirTimer",1)
7H41 M 1 A_ReFire("QuakeUpCheck0")
7H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
7H41 M 1 A_ReFire("QuakeUpCheck0")
7H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
7H41 M 1 A_ReFire("QuakeUpCheck0")
7H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
QuakeUp:
7H41 N 1 A_ReFire("QuakeUpCheck")
7H41 N 0 A_JumpIf(momz<=0, "QuakeDownA")
loop
QuakeUp0:
7H41 N 1 A_JumpIf(momz<=0, "QuakeDownA")
7H41 N 0 A_ReFire("QuakeUp0")
loop
QuakeUpCheck0:
7H41 M 3 A_GiveInventory("Handyman_AltBoost_P")
goto QuakeUp
QuakeUpCheck:
7H41 N 0 OffSet(0,32)A_JumpIfInventory("HandyHandAmmo",1,1)
goto QuakeUp0
7H41 N 2 OffSet(0,34)A_GiveInventory("Handyman_AltBoost_P")
7H41 N 1 OffSet(0,32)
goto QuakeUp


QuakeDown:
7H41 N 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "QuakeCrash")
7H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
7H41 N 1 A_GiveInventory("Handyman_AltFall_P")
loop
QuakeDownF:
7H41 N 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "QuakeCrash")
7H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
7H41 N 0 A_GiveInventory("Handyman_AltFallF_P")
7H41 N 1 A_ReFire("QuakeBoostUp")
loop
QuakeDownA:
7H41 N 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "QuakeCrash")
7H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
7H41 N 0 A_GiveInventory("Handyman_AltFallA_P")
7H41 N 1 A_ReFire("QuakeBoostDown")
loop

QuakeBoostUp:
7H41 N 1 Offset(0,29)A_GiveInventory("Handyman_AltBoostUp_P")
goto QuakeDownF
QuakeBoostDown:
7H41 N 1 Offset(0,35)A_GiveInventory("Handyman_AltBoostDown_P")
goto QuakeDownA

QuakeCrash:
7H41 M 0 A_GiveInventory("S_Handyman_FloorQuake_P")
7H41 M 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY|WRF_NOSECONDARY)
7H41 MO 1
7H41 OO 1 A_TakeInventory("HandyFlag")
7H41 OOO 1
7H41 P 0 A_GiveInventory("VivifyDelay4",1)
7H41 P 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
7H41 P 3
7H41 Q 3
Goto Ready2

}
}

actor S_Handyman_AltFall_P : Handyman_AltFall_P
{
States
{
Pickup:
Pickup2:
TNT1 A 0 A_SpawnItemEx("S_HandCrush",0,0,-10,0,0,-10)
goto End
}
}
actor S_Handyman_AltFallF_P : S_Handyman_AltFall_P
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY)
goto Pickup2
}
}
actor S_Handyman_AltFallA_P : S_Handyman_AltFall_P
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(WRF_NOSWITCH|WRF_NOSECONDARY)
goto Pickup2
}
}


actor S_HandyFistShot : HandyFistShot
{
Translation "192:192=228:228","198:198=75:75"
Damage (177)//118
}
actor S_HandyFistShot2 : HandyFistShot2
{
Translation "192:192=228:228","198:198=75:75"
Damage (177)//118
}

actor S_HandCrush : HandCrush
{
damage (113*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*2))//75
}

actor S_Handyman_FloorQuake_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("misc/BlankSound","Body")
TNT1 A 0 A_GiveInventory("VivifyDelay8",1)
TNT1 A 0 A_JumpIf(Args[4]>=100,"Limit")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_S_Handyman",100+100*(Args[4]/10),1+Args[4]/10)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1+SXF_TRANSFERSPECIAL)
stop
Limit:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_S_Handyman",1000,9)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
stop
}
}

actor S_Handyman_FloorQuakeSpawn : Handyman_FloorQuakeSpawn
{
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("S_Handyman_FloorQuakeBoom",0,0,28,0,0,0,0,SXF_TRANSFERSPECIAL)
stop
}
}
actor S_Handyman_FloorQuakeBoom : Handyman_FloorQuakeBoom
{
Translation "4:4=75:75"
MeleeRange 75//50
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(38+Args[0]*MeleeRange,15,0,0,15)//25+
goto FX
}
}

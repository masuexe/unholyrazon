actor GloryGuster : CustWepClassBase {
  Player.ScoreIcon "UMUG_27"
  Player.DisplayName "GloryGuster"
  Player.SoundClass "GloryGuster"
  Player.MaxHealth 925
  Health 925
  Player.ForwardMove 0.90, 0.90
  Player.SideMove 0.90, 0.90
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "GloryGuster_W"
  Player.StartItem "SouthWindMagic", 51
  Player.StartItem "AirJumpLimit", 3
  States {
   Spawn:
    TENG A 0
    TENG B 1
    TENG A 1
    goto Spawn+2
   See:
    TENG BCDE 5
    goto Spawn
   Missile:
    TENG FFFFF 1
    TENG GGGG 1
    goto Spawn+2
   ClassPain:
    TENG H 0
    goto MegamanPain

   ClassDeath:
    TENG H 0
    goto MegamanDeath
   MegamanDeath0:
    TENG H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TENG H 0 A_PlaySound("classes/woosh", 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 0, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 90, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 180, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 270, 1)
    goto MegamanFade
   MegamanDisintegrate:
    TENG Z 0 A_SpawnItemEx("Corpse_27", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor GloryGusterShiny : GloryGuster {
  Player.ScoreIcon "UMUG_S27"
  Health 2925
  Player.MaxHealth 2925
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 11
  Player.MorphWeapon "GloryGusterShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    TENG H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TENG H 0 A_PlaySound("classes/woosh", 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 0, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 90, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 180, 1)
    TENG H 0 A_SpawnItemEx("GloryGuster_NadoDeath", 0, 0, 10, 15, 0, 0, 270, 1)
    goto MegamanErase
  }
}

actor Corpse_27 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_27_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_27_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_27_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_27_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_27_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_27_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


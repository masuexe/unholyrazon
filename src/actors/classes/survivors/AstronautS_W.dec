actor S_Astronaut_Alt_P : Astronaut_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_AstronautJetPackDamage",-2,0,32,momx,momy,momz,0,8)
goto Take
}
}

actor S_AstronautLaserPew : AstronautLaserPew
{
Translation "192:192=33:33","198:198=239:239","0:0=253:253"
damage (120)//80
}

actor S_AstronautLaserPew2 : AstronautLaserPew2
{
Translation "192:192=197:197","198:198=198:198","0:0=199:199"
damage (375)//250
}

actor S_AstronautLaserPew3 : AstronautLaserPew3
{
Translation "192:192=192:192","198:198=194:194","0:0=195:195"
damage (863)//575
}

actor S_AstronautJetPackDamage : AstronautJetPackDamage
{
Args 68,80,16//45
}

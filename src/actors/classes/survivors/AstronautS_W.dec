actor AstronautS_W_ScriptBar : ScriptBar {}

actor AstronautS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Astronaut_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_34"
Obituary "$OB_34W"
weapon.ammotype "AstronautCharging"
weapon.ammotype2 "MockingAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H34 [ 6
loop

Deselect:
7H34 A 0
goto DeselectSwap
Select:
7H34 A 0
goto SelectSwap

Ready:
7H34 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", ASTRONAUT_SDYE)
7H34 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready2:
7H34 A 2 A_GiveInventory("Astronaut_Ready_P")
loop

Fire:
goto Holdin1
Fire1:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P1")
7H34 A 0 A_GunFlash("Flash.Fire1",1)
7H34 DA 2
Goto Ready2
Fire2:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P2")
7H34 B 0 A_GunFlash("Flash.Fire2",1)
7H34 DBDBD 2
Goto Ready2
Fire3:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P3")
7H34 C 0 A_GunFlash("Flash.Fire3",1)
7H34 DCDCDCDA 2
Goto Ready2

Holdin1:
7H34 A 0 A_GiveInventory("AstronautChargeFlag",1)
7H34 A 0 A_GunFlash("Flash.Charged1",1)
Hold1:
7H34 A 0 A_JumpIfInventory("AstronautCharging",20,"Holdin2")
7H34 A 1 A_WeaponReady(4|2)
7H34 A 0 A_ReFire(1)
goto Fire1
7H34 D 0 A_JumpIfInventory("AstronautCharging",20,"Holdin2")
7H34 D 1 A_WeaponReady(4|2)
7H34 D 0 A_ReFire("Hold1")
goto Fire1
Holdin2:
7H34 B 0 A_GunFlash("Flash.Charged2",1)
Hold2:
7H34 B 1 A_JumpIfInventory("AstronautCharging",70,"Holdin3")
7H34 B 0 A_ReFire(1)
goto Fire2
7H34 D 1 A_JumpIfInventory("AstronautCharging",70,"Holdin3")
7H34 D 0 A_ReFire("Hold2")
goto Fire2
Holdin3:
7H34 C 0 A_GunFlash("Flash.Charged3",1)
Hold3:
7H34 C 1 A_RailWait
7H34 C 0 A_ReFire(1)
goto Fire3
7H34 D 1 A_RailWait
7H34 D 0 A_ReFire("Hold3")
goto Fire3

Flash.Fire1:
7I34 JKLM 1 A_RailWait
stop
Flash.Fire2:
7I34 NOPQ 1 A_RailWait
stop
Flash.Fire3:
7I34 RSTU 1 A_RailWait
stop
Flash.Alt1:
7I34 KLM 1 A_RailWait
stop

Flash.Charged1:
TNT1 A 2 A_GiveInventory("Astronaut_Flash_P")
loop
Flash.Charged2:
7I34 ABCB 2 A_GiveInventory("Astronaut_Flash_P")
loop
Flash.Charged3:
7I34 DEFE 2 A_GiveInventory("Astronaut_Flash_P")
loop

Altfire_Fire:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P1")
goto Altfire_FireH+1
Altfire_FireH:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P0")
7H34 A 0 A_GunFlash("Flash.Alt1",1)
7H34 D 2
7H34 A 3
7H34 A 0 A_ReFire("Altfire_FireH")
Goto Ready2

AltFire:
7H34 A 0 A_JumpIfInventory("AstronautChargeFlag",1,"Altfire_Fire")
7H34 A 0 A_JumpIfInventory("MockingAmmo",50,"Altfire2")
Goto Ready2
Altfire2:
7H34 A 0 A_ChangeFlag("NOGRAVITY",1)
7H34 A 0 ThrustThingZ(0,4,0,0)
7H34 A 0 A_TakeInventory("MockingAmmo",8)
Altfire3:
7H34 A 2 OffSet(9,69)A_GiveInventory("S_Astronaut_Alt_P")
7H34 A 0 A_ReFire("Altfire_H")
AltEnd:
7H34 A 0 A_ChangeFlag("NOGRAVITY",0)
7H34 A 2 OffSet(5,53)
7H34 A 2 OffSet(2,41)
7H34 A 0 A_ClearReFire
Goto Ready2
Altfire_H:
7H34 A 0 A_JumpIfInventory("MockingAmmo",1,"Altfire3")
goto AltEnd

BotReady:
7H34 A 0 //A_ChangeFlag("NOBLOCKMONST",1)
7H34 A 0 A_WeaponReady(12)
7H34 A 2 A_Refire("BotFire")
7H34 A 0 A_GiveInventory("MockingAmmo",3)
goto BotReady+1

BotPew:
7H34 D 0 A_JumpIfInventory("AstronautCharging",20,"BotPew2")
7H34 D 2 A_GiveInventory("S_Astronaut_Fire_P1")
7H34 A 2
Goto BotReady+1
BotPew2:
7H34 D 0 A_JumpIfInventory("AstronautCharging",70,"BotPew3")
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P2")
7H34 DBDBD 2
Goto BotReady+1
BotPew3:
7H34 D 0 A_GiveInventory("S_Astronaut_Fire_P3")
7H34 DCDCDCDA 2
Goto BotReady+1

BotRare:
7H34 A 0 A_PlaySoundEx("taunt/D_34","Voice")
7H34 A 0 A_FaceTarget
7H34 A 0 A_Jump(32,"BotPew3")
goto BotPew2

BotFire:
7H34 A 0 A_Jump(16,3)
7H34 A 0 A_Jump(16,5)
7H34 A 1 A_Jump(8,"BotRare")
goto BotPew
7H34 A 0 A_Jump(16,"BotRare")
7H34 A 0 A_GiveInventory("AstronautChargeFlag",1)
7H34 A 0 A_GunFlash("Flash.Charged1",1)
goto BotHold2
7H34 A 0 A_ChangeVelocity(momx,momy,10.0,CVF_REPLACE)
goto BotPew

BotHold2:
7H34 A 0 A_JumpIfInventory("AstronautCharging",20,"BotHold3")
7H34 A 0 A_Jump(8,"BotBoost2")
7H34 A 0 A_Jump(4,2)
7H34 A 0 A_Jump(2,"BotPew")
goto BotReFire2
7H34 A 0 A_Jump(16,2)
7H34 A 0 A_GiveInventory("AstronautCharging",10)
goto BotReFire2
7H34 A 0 A_GiveInventory("AstronautCharging",20)
goto BotPew

BotHold3:
7H34 A 0 A_JumpIfInventory("AstronautCharging",70,"BotHold4")
7H34 A 0 A_Jump(12,3)
7H34 A 0 A_Jump(2,"BotPew")
7H34 A 0 A_Jump(12,"BotBoost3")
goto BotReFire3
7H34 A 0 A_Jump(24,"BotPew")
7H34 A 0 A_GiveInventory("AstronautCharging",40)
goto BotReFire3

BotHold4:
7H34 A 0 A_Jump(64,"BotPew")
7H34 A 0 A_Jump(128,"BotBoost3")
goto BotReFire3

BotReFire2:
7H34 D 1
7H34 A 0 A_Refire("BotHold2")
goto BotPew
BotReFire3:
7H34 D 1
7H34 A 0 A_Refire("BotHold2")
goto BotPew

BotBoost2:
7H34 A 0 A_ChangeVelocity(momx,momy,10.0,CVF_REPLACE)
goto BotReFire2
BotBoost3:
7H34 A 0 A_ChangeVelocity(momx,momy,10.0,CVF_REPLACE)
goto BotReFire3
}
}

actor S_Astronaut_Fire_P0 : Astronaut_Fire_P0
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_AstronautLaserPew",0,0,8,0)
goto Take
}
}
actor S_Astronaut_Fire_P1 : Astronaut_Fire_P1

actor SaboteurShiny_W_NormalBar : NormalBar {args 35, 136}

actor SaboteurShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Saboteur_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_22"
Obituary "$OB_22W"
weapon.ammotype "SaboteurEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H22 [ 6
loop

Deselect:
7H22 A 0
goto DeselectSwap
Select:
7H22 A 0
goto SelectSwap

Ready:
7H22 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", SABOTEUR_SDYE)
goto Ready2
Ready2:
7H22 A 2 A_WeaponReady
7H22 A 0 A_GiveInventory("SaboteurEnergyAmmo",2)
loop

Fire:
7H22 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
FireL:
7H22 C 2 A_GiveInventory("S_Saboteur_Fire_P")
7H22 B 2
7H22 A 0 A_Refire("FireL")
Goto Ready2

BotFire:
7H22 C 2 A_GiveInventory("S_Saboteur_BotFire_P")
7H22 B 2
7H22 A 0 A_Refire("BotFire")
Goto Ready2

AltFire:
7H22 C 2 A_GiveInventory("S_Saboteur_Alt_P")
7H22 B 2
7H22 A 0 A_Refire("Altfire")
Goto Ready2
}
}

actor S_Saboteur_Fire_P : CustomInventory
{
States
{
Pickup:
Fire0:
TNT1 A 0 A_JumpIfInventory("SaboteurEnergyAmmo",100,"Fire2")
goto Fire1
Fire1:
TNT1 A 0 A_FireCustomMissile("S_SaboteurShot",random(-2,2),0,8,0)
TNT1 A 0 A_PlaySound("wep_L/SaboteurPew",1,0.9)
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",2)
stop
Fire2:
TNT1 A 0 A_FireCustomMissile("S_SaboteurPrettyShot",0,1,0,0)
TNT1 A 0 A_PlaySound("wep_L/SaboteurPew2",4)
TNT1 A 0 A_TakeInventory("SaboteurEnergyAmmo",50,1)
TNT1 A 0 A_TakeInventory("SaboteurEnergyAmmo",50)
stop
}
}
actor S_Saboteur_Alt_P : S_Saboteur_Fire_P
{
States
{
Pickup:
AFire0:
TNT1 A 0 A_JumpIfInventory("SaboteurEnergyAmmo",100,"AFire2")
goto AFire1
AFire1:
TNT1 A 0 A_FireCustomMissile("S_SaboteurShotAlt",random(-2,2),0,8,0)
goto Fire1+1
AFire2:
TNT1 A 0 A_FireCustomMissile("S_SaboteurPrettyShotAlt",0,1,0,0)
goto Fire2+1
}
}
actor S_Saboteur_BotFire_P : S_Saboteur_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_Jump(3,2)
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",1)
goto Bot0
TNT1 A 0 A_PlaySoundEx("taunt/D_22","Voice")
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",random(28,42))
goto Bot0
Bot0:
TNT1 A 0 A_Jump(128,"AFire0")
goto Fire0
}
}

actor S_SaboteurShot : SaboteurShot
{
Translation "192:192=35:35","198:198=136:136"
Damage (66)//44
}

actor S_SaboteurShotAlt : SaboteurShotAlt
{
Translation "192:192=35:35","198:198=136:136"
Damage (83)//55
States
{
Spawn:
X_BB DEDEDEDEDEDEDEDEDEDEDEDEDEDEDE 2
X_BB D 0 A_SpawnItemEx("S_SaboteurShotAlt2",0,0,0,momx*45,momy*45,momz*45,0,1+8)
stop
}
}

actor S_SaboteurShotAlt2 : SaboteurShotAlt2
{
Translation "192:192=35:35","198:198=136:136"
Damage (83)//55
}


actor S_SaboteurPrettyShot : SaboteurPrettyShot
{
Translation "0:255=136:136","192:192=35:35","198:198=136:136"
Damage (150)//100
}

actor S_SaboteurPrettyShotAlt : SaboteurPrettyShotAlt
{
Translation "0:255=136:136","192:192=35:35","198:198=136:136"
Damage (150)//100
}

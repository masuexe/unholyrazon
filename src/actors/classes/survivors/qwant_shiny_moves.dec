actor QwantShiny_RapidSpin_W : QwantShinyMoveBase_W
{
States
{
Select:
	7H01 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
	7H01 A 0 A_WeaponReady(14)
	goto SelectAnim
SelectAnim:
7H01 A 1 //Backup checker here?
7H01 A 0 A_JumpIf(CallACS("core_CheckFooting"), "RapidSpinX")
loop
RapidSpinX:
7H01 A 0 A_GiveInventory("Shocked",1)
7H01 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
7H01 A 0 A_GiveInventory("S_StartRapidSpin_PU")
7H01 A 1 Offset(24,26)
7H01 A 1 Offset(48,20)
7H01 A 1 Offset(72,14)
7H01 A 1 Offset(96,20)
7H01 A 1 Offset(120,26)
7H01 A 1 Offset(144,32)
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Spin:
TNT1 A 0 A_GiveInventory("S_RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_JumpIfInventory("KnightFlag",30,1)
Loop
TNT1 A 0 A_TakeInventory("KnightFlag",30)
TNT1 A 0 A_GiveInventory("TopSpinFlag",1)
TNT1 A 0 A_JumpIfInventory("TopSpinFlag",5,"SpinEnd")
TNT1 A 1 A_JumpIf(momz==0,"SpinEnd")
Loop
SpinEnd:
7H01 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
7H01 A 0 A_TakeInventory("TopSpinFlag", 1)
7H01 A 0 A_TakeInventory("SpinTime")
7H01 A 0 A_TakeInventory("CutterFlag")
7H01 A 0 A_TakeInventory("PowerShock",999)
7H01 A 1 Offset(-64,144)
7H01 A 1 Offset(-48,128)
7H01 A 1 Offset(-34,112)
7H01 A 1 Offset(-22,96)
7H01 A 1 Offset(-12,80)
7H01 A 1 Offset(-6,64)
7H01 A 1 Offset(-3,48)
goto MoveReturn
}
}


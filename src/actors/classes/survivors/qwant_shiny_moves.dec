// Vanilla QwantShiny AltFire moves as slotless move-weapons.
// Registered via UH_COPYDEFS DefineShinyQwantMoveWep (weight 1 each).

actor QwantShinyMoveBase_W : BaseMM8BDMWep_UH
{
	weapon.ammotype "MyDestinyAmmo"
	weapon.ammouse 0
	Weapon.UpSound ""
	+WEAPON.NOALERT
States
{
Spawn:
	7H01 [ 6
	loop
Deselect:
	TNT1 A 0 Offset(1, 128) A_Lower
Select:
	7H01 A 0
	goto Ready
Ready:
Fire:
AltFire:
	7H01 A 1 A_WeaponReady
	wait
MoveReturn:
	TNT1 A 0 ACS_NamedExecuteAlways("uh_ShinyMoveReturn_cs", 0)
	TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
	goto Deselect
FireEnd:
	7H01 CB 4
	7H01 A 8
	goto MoveReturn
}
}

actor QwantShiny_BulletSeed_W : QwantShinyMoveBase_W
{
States
{
Select:
	7H01 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
	7H01 A 0 A_WeaponReady(14)
	goto SelectAnim
SelectAnim:
7H01 CCCBB 2 A_FireCustomMissile("S_IceShardPKMN",0,0,8,0)
goto FireEnd+2
}
}


actor GloryGuster_W_NormalBar : NormalBar {args 34, 39}

actor GloryGuster_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 150
Inventory.Pickupmessage "$PU_27"
Obituary "$OB_27W"
Tag "$TAG_GloryGuster_W"
weapon.ammotype "SouthWindMagic"
States
{
Spawn:
6H27 [ 6
loop

Deselect:
6H27 A 0
goto DeselectSwap
Select:
6H27 A 0
goto SelectSwap

Ready:
6H27 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GLORYGUSTER_DYE)
goto Ready2
Ready2:
6H27 A 2 A_GiveInventory("GloryGuster_Ready_P")
loop

Fire:
6H27 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H27 E 0 A_GiveInventory("GloryGuster_Fire_P")
6H27 H 1
6H27 I 3
6H27 J 1
6H27 J 1 Offset(12,40)
6H27 J 7 Offset(26,50)
6H27 J 22 Offset(26,50)//Offset(33,62)
6H27 J 2 Offset(16,44) A_GiveInventory("SouthWindMagic", 3)
6H27 J 2 Offset(6,37) A_GiveInventory("SouthWindMagic", 3)
6H27 J 2 Offset(-5,35) A_GiveInventory("SouthWindMagic", 3)
6H27 A 2 Offset(39,26) A_GiveInventory("SouthWindMagic", 3)
6H27 A 2 Offset(26,26) A_GiveInventory("SouthWindMagic", 3)
6H27 A 2 Offset(13,29) A_GiveInventory("SouthWindMagic", 3)
Goto Ready2

BotFire:
6H27 A 0 A_Jump(24,"BotFire3")
6H27 A 0 A_JumpIfInventory("SouthWindMagic",150-80*CallACS("uh_checkrune", RUNE_ENDLESSAMMO),"Altfire")
6H27 A 0 A_Jump(48,"BotFire2")
goto Fire+1
BotFire2:
6H27 A 0 A_ChangeVelocity(momx,momy,9.5,CVF_REPLACE)
6H27 A 0 A_PlaySound("classes/woosh",4)
6H27 TSSST 2 A_GiveInventory("SouthWindMagic",5)
6H27 A 0 A_WeaponReady(14)
6H27 A 2 A_GiveInventory("SouthWindMagic",5)
6H27 A 0 A_Jump(8,"BotFire3")
6H27 A 0 A_Jump(128,"BotFire2")
goto BotFire
BotFire3:
6H27 A 0 A_FireCustomMissile("GloryGuster_BladesInABox",0,0,0,0)
6H27 A 10 A_PlaySoundEx("taunt/D_27","Voice")
goto Fire+1

Altfire:
6H27 M 0 A_GiveInventory("GloryGuster_Alt_P")
6H27 CDCB 2
6H27 B 8
6H27 EFGA 2
Goto Ready2
}
}

actor SouthWindMagic : Ammo
{
inventory.amount 1
inventory.maxamount 150
+INVENTORY.IGNORESKILL
}

actor GloryGuster_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("SouthWindMagic",150-80*CallACS("uh_checkrune", RUNE_ENDLESSAMMO),2)
TNT1 A 0 A_WeaponReady(8)
goto Ammo
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("SouthWindMagic",1)
stop
}
}

actor GloryGuster_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("GloryGuster_Vortex",0,0,0,0)
Firin:
TNT1 A 0 A_PlaySound("weapon/stormtornado",1)
TNT1 A 0 A_GiveInventory("SouthWindMagic",3)
stop
}
}
actor GloryGuster_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("GloryGuster_BladesInABox",0,0,0,-8)
Altin:
TNT1 A 0 A_TakeInventory("SouthWindMagic",80,1)
TNT1 A 0 A_TakeInventory("SouthWindMagic",70)
stop
}
}


actor GloryGuster_Vortex : BasicProjectile
{
Translation "192:192=34:34","198:198=39:39"
Damagetype "Glory"
Obituary "$OB_27M"
+RIPPER
+FORCEXYBILLBOARD
Damage (36)
Radius 22
Height 22
speed 32
Scale 2.25
Args 40////65
States
{
Spawn:
6P27 A 0
6P27 A 1 A_SpawnItemEx("GloryGuster_VortexD",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,8)
6P27 B 1 A_SpawnItemEx("GloryGuster_VortexA",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,8)
6P27 C 1 A_SpawnItemEx("GloryGuster_VortexB",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,8)
6P27 D 1 A_SpawnItemEx("GloryGuster_VortexC",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,8)
6P27 A 0 A_CountDownArg(0)
loop
Death:
TNT1 A 0 A_SpawnItemEx("GloryGuster_VortexBlade",0,0,4,32,0,0,0,1)
XDeath:
Crash:
TNT1 A 2
stop
}
}


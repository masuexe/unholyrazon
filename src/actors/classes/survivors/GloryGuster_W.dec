Actor GloryGuster_Nado : BasicExplosion
{
damagetype "GloryFling"
Obituary "$OB_27A3"
+FORCEYBILLBOARD
+FLOORHUGGER
+BOUNCEONWALLS
-NOCLIP
-NOINTERACTION
BounceCount 2
RenderStyle None
Reactiontime 12
Radius 16
Height 48
Speed 20
Args 50,64,64,128
States
{
Spawn:
TNT1 A 0
goto SpawnL+3
SpawnL:
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBurst",0,0,Args[3],0,0,0,0,SXF_TRANSFERSPECIAL,(ceilingz-z <= Args[3])*256)
TNT1 A 0 A_PlaySound("weapon/superboost",1,1.0,False,0.5)
TNT1 A 2 A_SpawnItemEx("GloryGuster_NadoFX1",-sqrt(momx*momx+momy*momy),0,0,momx,momy,momz,0,1+8)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBurst",0,0,Args[3],0,0,0,0,32768,(ceilingz-z <= Args[3])*256)
TNT1 A 2 A_SpawnItemEx("GloryGuster_NadoFX2",-sqrt(momx*momx+momy*momy),0,0,momx,momy,momz,0,1+8)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBurst",0,0,Args[3],0,0,0,0,32768,(ceilingz-z <= Args[3])*256)
TNT1 A 2 A_SpawnItemEx("GloryGuster_NadoFX3",-sqrt(momx*momx+momy*momy),0,0,momx,momy,momz,0,1+8)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBurst",0,0,Args[3],0,0,0,0,32768,(ceilingz-z <= Args[3])*256)
TNT1 A 2 A_SpawnItemEx("GloryGuster_NadoFX4",-sqrt(momx*momx+momy*momy),0,0,momx,momy,momz,0,1+8)
TNT1 A 0 A_CountDown
loop
Death:
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBlade",1,0,8,40,0,0,20,1)
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBlade",1,0,8,40,0,0,60,1)
TNT1 A 0 A_SpawnItemEx("GloryGuster_NadoBlade",1,0,8,40,0,0,-20,1)
TNT1 A 1 A_SpawnItemEx("GloryGuster_NadoBlade",1,0,8,40,0,0,-60,1)
stop
}
}
Actor GloryGuster_NadoBurst : BasicExplosion
{
damagetype "GloryFling"
Obituary "$OB_27A3"
RenderStyle None
Args 50,64,64
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(Args[0]*1.05,Args[1]*1.35,0,0,Args[2]*1.35)
stop
}
}



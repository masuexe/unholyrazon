actor GloryGuster_BladesInABox : BasicProjectile
{
Translation "192:192=34:34","198:198=39:39"
damagetype "Glory"
Obituary "$OB_27A1"
+RIPPER
+NODAMAGETHRUST
+HEXENBOUNCE////
+CANBOUNCEWATER
+FORCEXYBILLBOARD
+SKYEXPLODE
BounceFactor 1.0
WallBounceFactor 1.0
damage (22-Args[2])
Radius 18
Height 32
Speed 20
scale 2.0
Args 10
States
{
Spawn:
6P27 E 0
6P27 E 0 A_PlaySound("weapon/crackermine",1)
6P27 EFGE 4
6P27 FGEF 3
6P27 GEFG 2
6P27 E 0 A_Stop
//6P27 E 0 A_ChangeFlag("DONTBLAST",1)
6P27 E 0 A_SetArg(2,20)
Goto Spinning
Spinning:
6P27 E 0 A_PlaySoundEx("weapon/icewaveloop","Weapon")
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*0,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*1,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*2,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*3,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*4,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_NadoBlade",4,0,8,40,0,random(-5,5),Args[0]*15+60*5,1)
6P27 EFG 1
6P27 E 0 A_CountDownArg(0)
loop
Death:
6P27 E 0 A_SpawnItemEx("GloryGuster_Nado",0,0,0,20,0,0,0,1)
6P27 E 0 A_SpawnItemEx("GloryGuster_Nado",0,0,0,20,0,0,180,1)
6P27 EFGEFGEFG 1 A_Fadeout(0.1)
stop
}
}


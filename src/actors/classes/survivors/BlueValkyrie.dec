    goto Spawn2}}
actor Corpse_45_4 : BaseCorpseFX {States {Spawn: 1H45 S 350
    goto Spawn2}}
actor Corpse_45_5 : BaseCorpseFX {States {Spawn: 1H45 T 350
    goto Spawn2}}
actor Corpse_45_6 : BaseCorpseFX {States {Spawn: 1H45 U 350

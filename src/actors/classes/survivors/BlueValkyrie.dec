actor BlueValkyrie : CustWepClassBase {
  Player.ScoreIcon "UMUG_45"
  Player.DisplayName "BlueValkyrie"
  Player.SoundClass "BlueValkyrie"
  Player.MaxHealth 1400
  Health 1400
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.85, 0.85
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "BlueValkyrie_W"
  Player.StartItem "BlueValkyrie_W2"
  Player.StartItem "BlueHungerAmmo", 150

  Player.WeaponSlot 1, "BlueValkyrie_W"
  Player.WeaponSlot 2, "BlueValkyrie_W2"
  States {
   Spawn:
    KNIM A 0
    KNIM B 1
    KNIM A 1
    goto Spawn+2
   See:
    KNIM BCDE 5
    goto Spawn
   Missile:
    KNIM F 5
    KNIM G 4
    goto Spawn+2
   ClassPain:
    KNIM H 0
    goto MegamanPain

   ClassDeath:
    KNIM H 0
    goto MegamanDeath
   MegamanDeath0:
    KNIM H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    KNIM H 0 A_SpawnItemEx("GauntletTreasure_P", 0, 0, Height / 2, random2() / 256.0, random2() / 256.0, 5.0 + random2() / 64.0)
    goto MegamanFade3
   MegamanDisintegrate:
    KNIM Z 0 A_SpawnItemEx("Corpse_45", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor BlueValkyrieShiny : BlueValkyrie {
  Player.ScoreIcon "UMUG_S45"
  Player.MaxHealth 3400
  Health 3400
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 11
  Player.MorphWeapon "BlueValkyrieShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_45 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_45_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_45_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_45_0 : BaseCorpseFX {States {Spawn: 1H45 O 350
    goto Spawn2}}
actor Corpse_45_1 : BaseCorpseFX {States {Spawn: 1H45 P 350
    goto Spawn2}}

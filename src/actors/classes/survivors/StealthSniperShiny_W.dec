actor StealthSniperShiny_W_ScriptBar : ScriptBar {}

actor StealthSniperShiny_W : StealthSniper_W
{
Tag "$TAG_S_StealthSniper_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_23"
Obituary "$OB_23W"
weapon.ammotype "StealthyAmmo"
weapon.ammotype2 "Steal_thyFakeDashAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H23 [ 6
loop

Deselect:
7H23 A 0
goto DeselectSwap
Select:
7H23 A 0
goto SelectSwap

Ready:
7H23 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", STEALTHSNIPER_SDYE)
7H23 A 0 A_GunFlash("Flash",1)
goto Ready1
Ready1:
7H23 A 3 A_GiveInventory("StealthSniper_Ready_P")
loop

Flash:
TNT1 A 3 A_GiveInventory("Steal_thyFakeDashAmmo",1)
loop

Fire:
7H23 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H23 B 0 A_PlaySound("wep_L/SRB2_Rail1",1)
7H23 A 0 A_GiveInventory("S_StealthSniper_Fire_P")
7H23 CB 3
7H23 A 2
7H23 "###" 2
7H23 # 2 Offset(20,38)
7H23 # 2 Offset(37,50)
7H23 # 2 Offset(51,66)
7H23 # 2 Offset(62,86)
7H23 # 2 Offset(71,108)
TNT1 A 8
TNT1 A 8 A_TakeInventory("StealthyAmmo")
7H23 A 2 Offset(71,108)
7H23 A 2 Offset(62,86)
7H23 A 2 Offset(51,66)
7H23 A 2 Offset(37,50)
7H23 A 2 Offset(20,38)
Goto Ready1

BotFire:
7H23 A 0 A_JumpIfCloser(256,"BLINDINGBLIND")
7H23 A 0 A_Jump(32,"BotFire2")
7H23 A 0 A_Jump(96,"BotFire3")
7H23 A 0 A_Jump(64,1)
goto Fire+1
7H23 A 0 A_Jump(128,"BotFire4")
7H23 A 0 A_GiveInventory("StealthyAmmo",random(1,3)*28)
7H23 A 0 A_Jump(64,"BotFire3")
goto Fire+1
BotFire2:
7H23 A 0 A_GiveInventory("StealthyAmmo",28)
7H23 A 0 A_PlaySoundEx("taunt/D_23","Voice")
7H23 AAA 0 A_FaceTarget
goto Fire+1
BotFire3:
7H23 A 5
7H23 A 0 ThrustThingZ(0,random(16,40),0,0)
7H23 A 0 ThrustThing(angle*256/360+64*random(0,3),random(25,40),0,0)
7H23 A 20 A_Jump(96,2)
7H23 A 0 A_Jump(128,"BotFire4")
goto Fire+1
7H23 AAAAA 3 A_GiveInventory("StealthyAmmo",random(3,10))
7H23 A 0 ThrustThingZ(0,random(16,40),0,0)
7H23 A 0 ThrustThing(angle*256/360+64*random(0,3),40,1,0)
7H23 A 10
7H23 A 10 A_Jump(160,"BotFire2")
goto Fire+1
BotFire4:
7H23 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
7H23 A 0 A_PlaySound("weapon/pursuitfire",1)
7H23 BBCCCCCCCCCCCBB 2 A_GiveInventory("StealthyAmmo",random(2,6))
7H23 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
7H23 A 0 A_Jump(128,"BotFire2")
goto Fire+1
BotAlt:
7H23 A 0 A_Jump(196,"BLINDINGBLIND")
goto Altfire

Altfire:
7H23 A 0 A_GiveInventory("S_StealthSniper_Alt_P")
7H23 # 0 A_ReFire(1)
AltFireEnd:
7H23 # 2 Offset(20,88)
7H23 # 2 Offset(15,74)
7H23 # 2 Offset(10,60)
7H23 # 2 Offset(5,46)
Goto Ready1

BLINDINGBLIND:
7H23 A 0 A_TakeInventory("StealthyAmmo",14)
7H23 A 0 A_FireCustomMissile("S_ShortRangeBlindofDeath",0,0,0,0)
7H23 B 1 A_PlaySound("Pokemon/IceBeamEnd",1)
7H23 B 1 A_SetBlend(white,0.85,5)
7H23 CBA 2
Goto Ready1
}
}

actor S_StealthSniper_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Jump(256,1,2)
stop //Seperate pickups for online sync
TNT1 A 0 A_GiveInventory("S_StealthSniper_Fire1_P")
stop
TNT1 A 0 A_GiveInventory("S_StealthSniper_Fire2_P")
stop
}
}

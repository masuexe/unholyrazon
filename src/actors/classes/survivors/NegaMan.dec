// TODO: add jump sprites

actor NegaMan : CustWepClassBase {
  Player.ScoreIcon "UMUG_2"
  Player.DisplayName "NegaMan"
  Player.SoundClass "NegaMan"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "IsNegaManFlag"
  Player.StartItem "NegaManCopywepGive_P"
  Player.StartItem "NegaMan_W"
  Player.StartItem "NegaDuckAmmo", 400
  Player.StartItem "NegaReadyRef_F", 1
  Player.StartItem "NoDrawMaestroMugshot"
  Player.StartItem "UHMugshotNegaMan"
  // Player.StartItem "NegamanDebugItem1"//NegamanWeapons1_P // Re-enable for testing purposes.
  // Player.StartItem "NegamanWeapons2_P"

  States {
   Spawn:
    EMEG A 0
    EMEG B 1
    EMEG A 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn+2
   See:
    EMEG BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn
   Jumping:
    EMEG R 0 A_JumpIfInventory("SlideVivifyFlag", 1, "Missile_Slide")
    EMEG R 1 A_JumpIf(CallACS("core_checkfooting"), "Spawn")
    loop
   Missile:
    EMEG F 0 A_JumpIfInventory("SlideVivifyFlag", 1, "Missile_Slide")
    EMEG F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_NegaTripleBlade")
    EMEG FFFFF 1
    EMEG GGGG 1
    goto Spawn+2
   Missile_Slide:
    EMEG I 18
    goto Spawn+2
   Missile_NegaTripleBlade:
    EMEG FGFGFG 6
    goto Spawn+2
   ClassPain:
    EMEG H 0
    goto MegamanPain

   ClassDeath:
    EMEG H 0
    goto MegamanDeath
   MegamanDisintegrate:
    EMEG Z 0 A_SpawnItemEx("Corpse_02", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor NegaManShiny : NegaMan {
  Player.ScoreIcon "UMUG_S2"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 11
  Player.MorphWeapon "NegaManShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}



actor Corpse_02 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_02_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_02_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_02_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_02_3", 0, 0, 30, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_02_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_02_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_02_0 : BaseCorpseFX {States {Spawn: 1H02 O 350
    goto Spawn2}}
actor Corpse_02_1 : BaseCorpseFX {States {Spawn: 1H02 P 350
    goto Spawn2}}
actor Corpse_02_2 : BaseCorpseFX {States {Spawn: 1H02 Q 350
    goto Spawn2}}
actor Corpse_02_3 : BaseCorpseFX {States {Spawn: 1H02 R 350
    goto Spawn2}}
actor Corpse_02_4 : BaseCorpseFX {States {Spawn: 1H02 S 350
    goto Spawn2}}
actor Corpse_02_5 : BaseCorpseFX {States {Spawn: 1H02 T 350
    goto Spawn2}}

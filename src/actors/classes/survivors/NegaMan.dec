// TODO: add jump and slide sprites

actor NegaMan : CustWepClassBase
{
player.scoreIcon "UMUG_2"
player.displayname "NegaMan"
player.soundclass "NegaMan"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 1.0, 1.0
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "NegaMan_W"
player.startitem "NegaDuckAmmo", 50
//player.startitem "NegamanDebugItem1"//NegamanWeapons1_P // Re-enable for testing purposes.
//player.startitem "NegamanWeapons2_P"

States
{
Spawn:
EMEG A 0
EMEG B 1
EMEG A 1
Goto Spawn+2
See:
EMEG BCDE 5
Goto Spawn
Missile:
EMEG FFFFF 1
EMEG GGGG 1
goto Spawn+2
ClassPain:
EMEG H 0
Goto MegamanPain

ClassDeath:
EMEG H 0
Goto MegamanDeath
MegamanCorpse:
EMEG Z 0 A_SpawnItemEx("Corpse_02",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}


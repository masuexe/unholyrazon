// TODO: add jump and slide sprites

actor NegaMan : CustWepClassBase
{
player.scoreIcon "UMUG_2"
player.displayname "NegaMan"
player.soundclass "NegaMan"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 1.0, 1.0
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "NegaMan_W"
player.startitem "NegaDuckAmmo", 400
//player.startitem "NegamanDebugItem1"//NegamanWeapons1_P // Re-enable for testing purposes.
//player.startitem "NegamanWeapons2_P"

States
{
Spawn:
EMEG A 0
EMEG B 1
EMEG A 1
Goto Spawn+2
See:
EMEG BCDE 5
Goto Spawn
Missile:
EMEG F 0 A_JumpIfInventory("SlideVivifyFlag", 1, "Missile_Slide")
EMEG F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_NegaTripleBlade")
EMEG FFFFF 1
EMEG GGGG 1
goto Spawn+2
Missile_Slide:
EMEG I 18
goto Spawn+2
Missile_NegaTripleBlade:
EMEG FGFGFG 6
goto Spawn+2
ClassPain:
EMEG H 0
Goto MegamanPain

ClassDeath:
EMEG H 0
Goto MegamanDeath
MegamanCorpse:
EMEG Z 0 A_SpawnItemEx("Corpse_02",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor NegaManS : NegaMan
{
player.scoreIcon "UMUG_S2"
Player.Maxhealth 3000
health 3000
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 11
player.morphweapon "NegaManS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}



actor Corpse_02:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_02_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_02_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_02_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_02_3",0,0,30,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_02_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_02_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}

actor Corpse_02_0:BaseCorpseFX{States{Spawn:1H02 O 350
goto Spawn2}}

actor Raider_DDS00 {
  // Translation "192:192=181:181","198:198=186:186","199:199=189:189"
  Obituary "$OB_17A2"
  Damagetype "RaiderB"

  +PUFFGETSOWNER
  +THRUGHOST
  +DONTBLAST

  +NOBLOCKMAP
  +NOGRAVITY
  // +ALLOWPARTICLES
  // +RANDOMIZE
  RenderStyle None
  // Alpha 0.99
  // VSpeed 0
  // Mass 5
  MeleeRange 2
  // scale 1.5
  States {
   Spawn:
   Melee:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_RaiderHitSplat", MeleeRange)  // nodelay A_SpawnItemEx("RS_HitSplat00")
    stop
   Crash:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Contra/C_SPING", 1)
    TNT1 A 1 A_SpawnItemEx("RS_HitSplat0")
    stop
  }
}


actor RaiderHookshot : BasicProjectile
{
Translation "192:192=139:139","198:198=140:140","202:202=142:142","195:195=15:15"
var int user_PTID;
damagetype "Raider"
Obituary "$OB_17M2"
//+RIPPER
+DONTBLAST
+DONTREFLECT
+THRUGHOST
+SKYEXPLODE
+EXPLODEONWATER
+NOTIMEFREEZE
+FORCEXYBILLBOARD
+HITTRACER
ReactionTime 1
Damage (100)
Radius 8
Height 8
Speed 1
scale 2.5
states
{
Spawn:
6P17 A 0
6P17 A 0 A_SetUserVar("user_PTID", CallACS("core_gettarget"))
6P17 A 0 A_ScaleVelocity(60)//Speed
6P17 A 0 ACS_NamedExecuteWithResult("core_drawhookshot", user_PTID, 17)//ACS_NamedExecuteAlways("uh_raiderhookshotfx",0,user_PTID)
goto Spawn2
Spawn2:
6P17 A 0 A_JumpIfInTargetInventory("RaiderHookRelease_F",1,"SpawnX")
6P17 A 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0,"SuperDeath")
loop
SpawnX:
6P17 A 0 A_SpawnItemEx("RaiderHookshot2",0,0,0,momx,momy,momz+0.1f,0,1+8+SXF_TRANSFERSPECIAL)//32768
stop

Death:
//6P17 I 0 A_JumpIfInTargetInventory("FlightDisableFlag",1,"SuperDeath")
6P17 A 0 A_JumpIf(user_PTID>0,"Death0")
goto SuperDeathPoof
Death0:
//6P17 A 0 A_JumpIfInTargetInventory("RaiderHookFiredFlag",1,1)
//goto SuperDeathPoof
6P17 A 0 A_JumpIfInTargetInventory("RaiderHookRelease_F",1,"SuperDeathPoof")
6P17 A 0 A_PlaySound("weapon/crashland",1)
6P17 A 0 A_GiveToTarget("RaiderHookshotGravityPickup",1)
6P17 A 0 A_JumpIfInventory("NoHookshot",1,"Death1",AAPTR_TRACER)
6P17 A 0 A_JumpIf(CallACS("uh_istracerplayer"), "Death3")
6P17 A 0 A_CheckFlag("SHOOTABLE","Death2",AAPTR_TRACER)
goto Death1
Death1:
6P17 A 0 ACS_NamedExecuteWithResult("uh_raiderhookshot",user_PTID,4,0)
6P17 A 2
goto DeathLoop1
Death2:
6P17 A 0 ACS_NamedExecuteWithResult("uh_raiderhookshot",user_PTID,4,1)
6P17 A 2
goto DeathLoop2
Death3:
6P17 A 0 ACS_NamedExecuteWithResult("uh_raiderhookshot",user_PTID,4,1)
6P17 A 2
goto DeathLoop3
DeathLoop1://Sit
6P17 A 0 A_JumpIfInTargetInventory("RaiderHookRelease_F",1,"SuperDeath")
6P17 A 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0,"SuperDeath")
loop
DeathLoop2://Stick
6P17 A 0 A_Warp(AAPTR_TRACER,-4,0,28)
6P17 A 0 A_JumpIfInTargetInventory("RaiderHookRelease_F",1,"SuperDeath")
6P17 A 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0,"SuperDeath")
6P17 A 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists",1)==0,"SuperDeath")
loop
DeathLoop3://Stick to player but stop when they don't exist
6P17 A 0 A_Warp(AAPTR_TRACER,-4,0,28)
6P17 A 0 A_JumpIfInTargetInventory("RaiderHookRelease_F",1,"SuperDeath")
6P17 A 0 A_JumpIfInventory("IsPerformingSuplex",1,"DeathLoop1",8)
6P17 A 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists")==0,"SuperDeath")
6P17 A 1 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists",1)==0,"DeathLoop1")
loop


SuperDeathPoof:
6P17 A 0
6P17 A 2 A_SpawnItemEx("RaiderHookshotDeathFX",0,0,0,0,0,0,0,1)
6P17 A 2
stop
SuperDeath:
6P17 A 0
6P17 A 1
stop
}
}

Actor RaiderHookshotFX : BasicClientSide
{
Translation "192:192=140:140","198:198=139:139"
+NOTIMEFREEZE
+FORCEXYBILLBOARD
States
{
Spawn:
6P17 B 0
6P17 B 1
Stop
}
}

actor RaiderHookshot2 : BasicProjectile
{
damagetype "Raider"
Obituary "$OB_17M2"
-NOGRAVITY
+FORCEXYBILLBOARD
Damage (100+Args[0])
Radius 8
Height 8
Speed 60
scale 2.5
States
{
Spawn:
6P17 A 0
6P17 A 0 A_PlaySound("S3_K/MetalSpark",1)
6P17 A 10
wait
Death:
6P17 A 1
stop
}
}

actor RaiderHookshotDeathFX : BasicClientSide
{
-CLIENTSIDEONLY
+NOTIMEFREEZE
+FORCEXYBILLBOARD
+BRIGHT
States
{
Spawn:
TMFX O 0
TMFX O 2
TMFX ABCD 2
stop
}
}

actor RaiderHookshotGravityPickup : CustomInventory
{
States
{
Pickup:
TNT1 A 0 //A_Stop
TNT1 A 0 A_GiveInventory("RaiderHookedFlag",1)
TNT1 A 0 //A_ChangeFlag("NOGRAVITY",1)
TNT1 A 0 //SetPlayerProperty(0,1,0)
stop
}
}

actor RaiderPoison : BasicProjectile
{
Translation "192:192=233:233","198:198=234:234","95:95=3:3","202:202=181:181","199:199=184:184","118:118=110:110","119:119=129:129"
damagetype "RaiderA"
Obituary "$OB_17A1"
damage (250)
//PoisonDamage 50,2,35//Poison is way too hardcoded to work with.
//PoisonDamageType "RaiderPoison"
//+ADDITIVEPOISONDURATION
Radius 14
Height 14
speed 50
scale 4.0
States
{
Spawn:
6P17 H 1
loop
XDeath:
6P17 I 1
6P17 I 3 A_SpawnItemEx("RS_HitSplat25",1)
stop
Death:
6P17 I 1 A_PlaySound("Contra/C_SPING",1)
6P17 I 3 A_SpawnItemEx("RS_HitSplat0",1)
stop
}
}

actor RaiderPoisonHitDamager : BasicExplosion
{
Translation "192:192=110:110","198:198=131:131","199:199=134:134"
damagetype "RaiderPoison"
Obituary "$OB_17A3"
states
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("GNT/Poison",2,0.75)
TNT1 A 0 A_SpawnItemEx("RS_HitSplat05",0,0,0,0,0,0,0,1)
TNT1 A 1 A_Explode(50,15,0,0,15)
stop
}
}


actor Raider_W_NormalBar : NormalBar {Args 139, 140}
actor Raider_W_ScriptBar : ScriptBar {}
actor Raider_W2_NormalBar : NormalBar {Args 139, 140}
actor Raider_W2_ScriptBar : ScriptBar {}

actor Raider_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 5
Weapon.AmmoGive 200
Inventory.Pickupmessage "$PU_17_A"
Obituary "$OB_17W1"
Tag "$TAG_Raider_W"
weapon.ammotype "ShadowEnergyAmmo"
inventory.icon "C_I_17A"
States
{
//6H17 [ 6
Spawn:
6N17 A 10
loop

Deselect:
6H17 A 0
goto DeselectSwap
Select:
6H17 A 0
goto SelectSwap

Ready:
6H17 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAIDER_DYE)
6H17 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H17 A 2 A_GiveInventory("Raider_ReadyState1_P")
6H17 A 0 A_GiveInventory("ShadowEnergyAmmo",2)
loop

Flash:
TNT1 A 1 A_GiveInventory("Raider_FlashState_P")
loop

Fire:
6H17 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H17 B 0 A_PlaySound("weapon/shadow",1)
6H17 B 0 A_FireCustomMissile("RaiderBladeShot",0,1,8,0)
6H17 BCDEFG 2
TNT1 A 4
6H17 HI 2
Goto Ready2

Altfire:
6H17 K 1 A_GiveInventory("Raider_FireHook_P")
AltfireH:
6H17 L 0 A_JumpIfInventory("RaiderHookRelease_F",1,"AltFireEnd")
6H17 L 1 A_GiveInventory("RaiderHookHold_F",1)
6H17 L 0 A_ReFire("AltfireH")
goto AltFireEnd
AltFireEnd:
6H17 M 2 A_GiveInventory("RaiderHookRelease_F",1)
6H17 N 2
//6H17 N 0 SetPlayerProperty(0,0,0)
6H17 K 2 A_ClearReFire
Goto Ready2

BotFire:
6H17 A 0 A_JumpIfInventory("ShadowEnergyAmmo",150,"BotFireA")
6H17 A 0 A_Jump(16,"BotBonus")
6H17 A 0 A_Jump(56,"BotDodge")
6H17 A 0 A_PlaySound("weapon/shadow",1)
6H17 A 0 A_Jump(256,"BotFire1","BotFire2","BotFire3","BotFire4","BotFire5")
6H17 A 1
Goto Ready2

BotDodge:
6H17 A 20 A_GiveInventory("Raider_BotDodge_P")
6H17 AA 0 A_Jump(18,"BotBonus")
Goto Ready2

BotBonus:
6H17 A 1 A_GiveInventory("ShadowEnergyAmmo",30)
goto BotFire+2

BotFireEnd:
6H17 B 0 A_GiveInventory("ShadowEnergyAmmo",8)
6H17 BCDEFGHI 2
6H17 A 1 A_Jump(16,"BotDodge")
Goto Ready2

BotFire1:
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire2:
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire3:
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire4:
BEXP A 0 A_FireCustomMissile("RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire5:
6H17 A 0 ThrustThingZ(0,42,0,0)
6H17 A 0 A_Jump(8,"BotBonus")
6H17 A 0 A_Jump(192,"BotFire1","BotFire2","BotFire3","BotFire4")
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",0,0,8,0)
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",8,0,8,3)
6H17 A 0 A_FireCustomMissile("RaiderBladeShot",-8,0,8,3)
goto BotFireEnd
BotFireA:
BEXP A 0 A_JumpIfInventory("ShadowEnergyAmmo",150,1)
goto BotFire+2
6H17 A 0 A_TakeInventory("ShadowEnergyAmmo",150)
6H17 A 0 A_PlaySound("misc/stonethrow",1)
6H17 A 0 A_FireCustomMissile("RaiderPoison",0,0,8,0)
6H17 A 0 A_FireCustomMissile("RaiderPoison",8,0,8,3)
6H17 A 0 A_FireCustomMissile("RaiderPoison",-8,0,8,3)
goto BotFireEnd
}
}

Actor Raider_W2 : Raider_W
{
Weapon.AmmoUse 65
Inventory.Pickupmessage "$PU_17_B"
Obituary "$OB_17W2"
Tag "$TAG_Raider_W2"
inventory.icon "C_I_17B"
States
{
Spawn:
6N17 B 10
loop

Deselect:
6H17 P 0
goto DeselectSwap
Select:
6H17 P 0
goto SelectSwap

Ready:
6H17 P 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAIDER_DYE)
6H17 P 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H17 P 0 A_JumpIfInventory("ShadowEnergyAmmo",100,"Ready3")
6H17 P 2 A_WeaponReady(WRF_NOPRIMARY)
6H17 P 0 A_GiveInventory("ShadowEnergyAmmo",2)
loop
Ready3:
6H17 P 2 A_WeaponReady
6H17 P 0 A_GiveInventory("ShadowEnergyAmmo",2)
loop

Fire:
//6H17 B 0 A_TakeInventory("ShadowEnergyAmmo",65,1)
6H17 B 0 A_TakeInventory("ShadowEnergyAmmo",35)
6H17 B 0 A_PlaySound("misc/stonethrow",1)
6H17 B 0 A_FireCustomMissile("RaiderPoison",0,1,8,0)
6H17 BCDEFG 2
TNT1 A 6
6H17 RS 2
Goto Ready2

Altfire:
6H17 P 0 A_GiveInventory("VivifyDelay4",1)
6H17 P 0 A_ReFire(1)
6H17 P 2 Offset(7,-13)
6H17 Q 2 Offset(13,-23)A_PlaySound("Pokemon/HornAttack",1,0.775)
6H17 Q 2 Offset(-53,-4)
6H17 Q 2 Offset(-118,16)A_GiveInventory("Raider_Alt_P")
6H17 Q 2 Offset(-183,37)
6H17 Q 2 Offset(-248,59)
6H17 Q 2 Offset(-252,28)
6H17 Q 2 Offset(-246,-2)
6H17 Q 2 Offset(-187,10)A_PlaySound("Pokemon/HornAttack",1,0.775)
6H17 Q 2 Offset(-128,22)
6H17 Q 2 Offset(-69,33)A_GiveInventory("Raider_Alt_P")
6H17 Q 2 Offset(-10,44)
6H17 Q 2 Offset(49,53)
6H17 P 2 Offset(43,53)
6H17 P 2 Offset(25,44)
6H17 P 2 Offset(11,37)
Goto Ready2
}
}

actor ShadowEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor HookshotStamina : Ammo
{
inventory.amount 1
inventory.maxamount 999
+INVENTORY.IGNORESKILL
}

actor RaiderHookFiredFlag : UOnce {}
actor RaiderHookedFlag : UOnce {}
actor RaiderHookHold_F : Powerup
{
Powerup.Duration 8
}
actor RaiderHookRelease_F : Powerup
{
Powerup.Duration 35
}


actor Raider_ReadyState1_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HookshotStamina",200,"AltReady")
TNT1 A 0 A_JumpIfInventory("ShadowEnergyAmmo",5,"Ready2")
goto Ready1
AltReady:
TNT1 A 0 A_JumpIfInventory("ShadowEnergyAmmo",5,"Ready4")
goto Ready3

Ready1:
TNT1 A 0 A_WeaponReady(WRF_NOFIRE)
stop
Ready2:
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
stop
Ready3:
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
stop
Ready4:
TNT1 A 0 A_WeaponReady
stop

Ammo:
TNT1 A 0 A_GiveInventory("ShadowEnergyAmmo",2)
stop
}
}

actor Raider_FlashState_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("RaiderHookHold_F",1,"No")
TNT1 A 0 A_JumpIfInventory("RaiderHookFiredFlag",1,"LookingForGround")
TNT1 A 0 A_JumpIfInventory("HookshotStamina",999,"No")
TNT1 A 0 A_GiveInventory("HookshotStamina",1)
stop
LookingForGround:
TNT1 A 0 A_JumpIfInventory("RaiderHookHold_F",1,"No")
TNT1 A 0 A_JumpIf(z-floorz==0,"FoundGround")
TNT1 A 0 A_JumpIfInventory("PowerMomZVerify",1,"CheckMomZ")
TNT1 A 0 A_JumpIf(momz==0,"MomZVerify")
stop
CheckMomZ:
TNT1 A 0 A_JumpIf(momz==0,"FoundGround")
stop
MomZVerify:
TNT1 A 0 A_GiveInventory("PowerMomZVerify")
stop
FoundGround:
TNT1 A 0 A_TakeInventory("RaiderHookFiredFlag")
stop
No:
TNT1 A 0
stop
}
}

actor Raider_FireHook_P : CustomInventory
{
States
{
Pickup:
//TNT1 A 0 A_FireCustomMissile("RaiderHookshot",0,0,8,0)
TNT1 A 0 A_SpawnItemEx("RaiderHookshot",0,8,32,cos(-pitch)*1,0,sin(-pitch)*1,0,0)
goto End
TNT1 A 0 A_TakeInventory("RaiderHookRelease_F")
TNT1 A 0 A_TakeInventory("HookshotStamina",10)
TNT1 A 0 A_TakeInventory("HookshotStamina",40,1)
TNT1 A 0 A_PlaySound("S3_K/BasicPew",1)
TNT1 A 0 A_GiveInventory("RaiderHookFiredFlag",1)
stop
}
}

actor Raider_BotDodge_P  : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("ShadowEnergyAmmo",10)
TNT1 A 0 A_Jump(256,"DodgeLeft","DodgeRight","DodgeBack","DodgeUp")
DodgeUp:
TNT1 AA 0 A_Recoil(-25)
stop
DodgeBack:
TNT1 AA 0 A_Recoil(25)
stop
DodgeRight:
TNT1 AA 0 ThrustThing(angle*256/360+64,40,1,0)
stop
DodgeLeft:
TNT1 AA 0 ThrustThing(angle*256/360+192,40,1,0)
stop
}
}

actor RaiderBladeShot : BasicProjectile
{
Translation "192:192=139:139","198:198=140:140"
damagetype "Raider"
Obituary "$OB_17M1"
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
+SKYEXPLODE
BounceCount 3
ReactionTime 20
Damage (150)
Radius 14
Height 14
Speed 50
scale 1.85
States
{
Spawn:
6P17 C 0
6P17 C 0 A_Jump(128,"Spawn2")
Spawn1:
6P17 CDEFCDEF 2
6P17 C 0 A_CountDown
loop
Spawn2:
6P17 FEDCFEDC 2
6P17 F 0 A_CountDown
Loop
Death:
TNT1 A 0
TNT1 A 0 A_SetScale(2.5)
6P17 GGGG 1
stop
}
}


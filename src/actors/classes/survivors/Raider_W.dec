  States {
   Pickup:
    TNT1 A 0  // A_Stop
    TNT1 A 0 A_GiveInventory("RaiderHookedFlag", 1)
    TNT1 A 0  // A_ChangeFlag("NOGRAVITY",1)
    TNT1 A 0  // ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    stop
  }
}

actor RaiderPoison : BasicProjectile {
  Translation "192:192=233:233", "198:198=234:234", "95:95=3:3", "202:202=181:181", "199:199=184:184", "118:118=110:110", "119:119=129:129"
  damagetype "RaiderA"
  Obituary "$OB_17A1"
  damage (250)
  // PoisonDamage 50,2,35//Poison is way too hardcoded to work with.
  // PoisonDamageType "RaiderPoison"
  // +ADDITIVEPOISONDURATION
  Radius 14
  Height 14
  speed 50
  scale 4.0
  States {
   Spawn:
    6P17 H 1
    loop
   XDeath:
    6P17 I 1
    6P17 I 3 A_SpawnItemEx("RS_HitSplat25", 1)
    stop
   Death:
    6P17 I 1 A_PlaySound("Contra/C_SPING", 1)
    6P17 I 3 A_SpawnItemEx("RS_HitSplat0", 1)
    stop
  }
}

actor RaiderPoisonHitDamager : BasicExplosion {
  Translation "192:192=110:110", "198:198=131:131", "199:199=134:134"
  damagetype "RaiderPoison"
  Obituary "$OB_17A3"
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("GNT/Poison", 2, 0.75)
    TNT1 A 0 A_SpawnItemEx("RS_HitSplat05", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(50, 15, 0, 0, 15)
    stop
  }
}

actor PainRaiderPoisonHit : Basic_PainTID_H  // BasicPoisonBase
{
  States {
   Check:
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 17, PSN_SET_TO, 5) > 0, "DoT")
    stop
   DoT:  // 50
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEX("RaiderPoisonHitDamager")
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 17, PSN_ADJUST, -1) <= 0, "Death")
    loop
  }
}

actor PainRaiderPoisonHit2 : PainRaiderPoisonHit  // Weaker poison start
{
  States {
   Check:
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 17, PSN_SET_TO, 2) > 0, "DoT")
    stop
  }
}

actor PainDecoy17PoisonHit : PainRaiderPoisonHit
{  // Exactly the same, just different damager
  States {
    // Since there is a A_JumpIfInventory loop in the original actor, it can actually hop to this version.
   DoT:
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEX("Decoy17PoisonHitDamager")
    TNT1 A 0 A_JumpIf(CallACS("uh_PoisonControl_acs", 17, PSN_ADJUST, -1) <= 0, "Death")
    loop
  }
}


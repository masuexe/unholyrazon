actor SiteWorkerS_W_ScriptBar : ScriptBar {}

actor SiteWorkerS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_SiteWorker_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_35"
Obituary "$OB_35W"
weapon.ammotype "SteroidEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H35 [ 6
loop

Deselect:
7H35 A 0 A_JumpIfInventory("SiteWorkerRockFlag",1,1)
goto DeselectSwap
7H35 F 0 A_GunFlash("NoFlash",1)
7H35 F 0 A_GiveInventory("S_SiteWorker_Fire_P")
7H35 FGHIJK 2
7H35 ZZZLMA 2 A_Lower
Goto DeselectSwap

Select:
7H35 A 0
goto SelectSwap

Ready:
//7H35 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", NO_DYE)//SITEWORKER_SDYE
7H35 A 1 ACS_NamedExecuteWithResult("uh_FetchAndSetPlayerColor",0,190,205,3500)
7H35 A 0 A_GunFlash("NoFlash",1)
7H35 A 0 A_GiveInventory("SiteWorkerFlagRNG_P")
goto Ready2
Ready2:
7H35 A 2 A_GiveInventory("SiteWorker_Ready_P")
loop

Flash:
TNT1 A 1
TNT1 A 1 A_SpawnItemEx("S_TetrisRock_FX",0,0,70,0,0,0,0,1)
loop

Fire:
7H35 A 0 A_JumpIfInventory("SiteWorkerRockFlag",1,"Throw")
7H35 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H35 B 2 A_GiveInventory("S_SiteWorker_FireStart_P")
7H35 CDEZZ 2 A_GiveInventory("S_SiteWorker_FireStart2_P")
TNT1 A 0 A_GunFlash("Flash",1)
goto Holding

HoldingAlt:
TNT1 A 3 A_WeaponReady(8)
TNT1 AAAAA 4 A_WeaponReady(8)
Holding:
TNT1 A 2 A_GiveInventory("SiteWorker_Ready_P")
loop

HoldingSwap:
TNT1 A 1 A_GiveInventory("SiteWorkerSaveFlags_P")
goto HoldingAlt
Throw:
7H35 F 0 A_JumpIfInventory("IsBot",1,"BotFire2")
7H35 F 0 A_GunFlash("NoFlash",1)
7H35 F 2 A_GiveInventory("S_SiteWorker_Fire_P")
7H35 G 2 A_GiveInventory("SiteWorkerFlagRNG_P")
7H35 HIJK 2
7H35 Z 6
7H35 LMA 2
Goto Ready2

Altfire:
7H35 A 0 A_JumpIfInventory("SiteWorkerRockFlag",1,"HoldingSwap")
Altfire2:
7H35 Q 1 A_PlaySound("Tetris/Pause",2,0.75)
7H35 R 2 A_GiveInventory("S_SiteWorker_Alt_P")
7H35 S 2
7H35 R 2
7H35 S 2
7H35 R 4
7H35 Q 3
7H35 A 2
Goto Ready2


BotFire:
7H35 A 0 A_JumpIfInventory("SteroidEnergyAmmo",50,2)
7H35 A 0 A_Jump(8,"Altfire2")
goto Fire+2
7H35 A 0 A_Jump(128,"Altfire2")
goto Fire+2
BotFire2:
7H35 A 0 A_Jump(24,1)
goto Throw+1
BotFireX:
7H35 F 0 A_GiveInventory("S_SiteWorker_Fire_P")
7H35 G 0 A_GiveInventory("SiteWorkerRockFlag",1)
7H35 H 0 A_PlaySoundEx("taunt/D_35","Voice")
7H35 I 0 A_GiveInventory("SiteWorker_FlagCycle_P")
7H35 J 0 A_RailWait
7H35 FGHIJK 2
TNT1 A 9 A_GiveInventory("BotFlag1",1)
TNT1 A 0 A_JumpIfInventory("BotFlag1",6,2)
TNT1 A 0 A_ReFire("BotFireX")
TNT1 A 66 A_TakeInventory("BotFlag1")
goto Holding

}
}

actor S_SiteWorker_FireStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("misc/hugequake2",1)
TNT1 A 0 A_GiveInventory("SiteWorkerRockFlag",1)
TNT1 A 0 A_SetArg(3,322)
goto Fall+1
Fall:
TNT1 A 0 A_GiveInventory("SteroidEnergyAmmo",1)
TNT1 A 0 A_SetArg(3,Args[3]-36)
TNT1 A 0 A_SpawnItemEx("S_TetrisRock_FX",8,0,Args[3],0,0,0,0,1+32)
stop
}
}
actor S_SiteWorker_FireStart2_P : S_SiteWorker_FireStart_P
{
States
{
Pickup:
goto Fall
}
}


6Q35 M 0 A_SetGravity(0.0)
6Q35 M 0 A_SpawnItemEx("S_TetrisRockBoomFX2",0,0,16,0,0,0,0,1)
6Q35 M 0 A_Explode(Args[0],Args[1],0,0,Args[2])
6Q35 MXMXMXM 2
stop
}
}


actor SamuraiSam : CustWepClassBase {
  player.scoreIcon "UMUG_33"
  player.displayname "SamuraiSam"
  player.soundclass "SamuraiSam"
  Player.Maxhealth 900
  health 900
  player.forwardmove 1.0, 1.0
  player.sidemove 1.0, 1.0
  player.jumpz 20//15
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "SamuraiSam_W"
  player.startitem "FoolishSamuraiWarriorAmmo", 28

  player.startitem "WallJumpLimit", 2

  Gravity 1.6

  States {
   Spawn:
    1H33 A 0
    1H33 B 1
    1H33 A 1
    Goto Spawn+2
   See:
    1H33 BCDE 5
    Goto Spawn
   Missile:
    1H33 F 0 A_JumpIfInventory("VivifyDelay3", 1, "MissileDash")
    1H33 F 3
    1H33 G 6
    goto Spawn+2
   MissileDash:
    1H33 BCDE 2
    goto Spawn
   ClassPain: 1H33 H 0
    Goto MegamanPain

   ClassDeath:
    1H33 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H33 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H33 H 0 A_SpawnItemEx("SamuraiSamBackToThePast_H", 0, 0, 0, 0, 0, 1, 0, 1)
    1H33 H 0 A_SpawnItemEx("SamuraiSamBackToThePastExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    1H33 Z 10
    Goto MegamanErase
   MegamanDisintegrate:
    1H33 Z 0 A_SpawnItemEx("Corpse_33", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor SamuraiSamShiny : SamuraiSam {
  player.scoreIcon "UMUG_S33"
  Player.Maxhealth 2900
  health 2900
  player.forwardmove 1.1, 1.1
  player.sidemove 1.1, 1.1
  player.jumpz 22//16.5
  Gravity 1.6//
  player.morphweapon "SamuraiSamShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H33 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H33 H 0 A_SpawnItemEx("SamuraiSamBackToThePast_H", 0, 0, 0, 0, 0, 1, 0, 1)
    1H33 H 0 A_SpawnItemEx("S_SamuraiSamBackToThePastExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    1H33 Z 10
    Goto MegamanErase
  }
}


actor SamuraiSamBackToThePast_H : BasicExplosion {
  damagetype "SamuraiSam"
  Obituary "$OB_33D"
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    1H33 HHHHHHHHHHHHHHHH 1 A_SetScale(ScaleX-0.15)
    stop
  }
}

actor SamuraiSamBackToThePastExplosion : SamuraiSamBackToThePast_H {
  RenderStyle Translucent
  Alpha 0.5
  ReactionTime 6
  Scale 3.2
  Args 250, 128, 48
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 //A_Explode(100+5-(3.2/ScaleX*5),128+10-(3.2/ScaleX*10),0,0,64+5-(3.2/ScaleX*5))
    9P_H AB 2 A_SetScale(ScaleX-0.2)
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_PlaySound("Shin_1/Explode", 1)
    TNT1 A 0 A_Explode(250, 128, 0, 0, 48)
    TNT1 A 0 A_SpawnItemEx("SamuraiSamBackToThePastFX1", 0, 0, -12, 0, 0, 5, 0, 0/*1*/)
    TNT1 A 0 A_SpawnItemEx("SamuraiSamBackToThePastFX2", 0, 6, -4, 0, 2.5f, 15, 0, 0/*1*/)
    TNT1 A 0 A_SpawnItemEx("SamuraiSamBackToThePastFX2", 0, -6, -4, 0, -2.5f, 15, 0, 0/*1*/)
    TNT1 A 0 A_SpawnItemEx("SamuraiSamBackToThePastFX2", 0, 10, -8, 0, 4.5f, 11, 0, 0/*1*/)
    TNT1 A 0 A_SpawnItemEx("SamuraiSamBackToThePastFX2", 0, -10, -8, 0, -4.5f, 11, 0, 0/*1*/)
    TNT1 A 20
    stop
  }
}
actor S_SamuraiSamBackToThePastExplosion : SamuraiSamBackToThePastExplosion {
  Args 375, 128, 48
}

actor SamuraiSamBackToThePastFX1 : BasicClientSide {
  Translation "202:202=160:160", "192:192=218:218", "198:198=227:227", "199:199=167:167"
  States {
   Spawn:
    6PRS A 3
    6PRS BCDEFGH 4
    6PRS I 4//8
    6PRS J 5//9
    stop
  }
}

actor SamuraiSamBackToThePastFX2 : BasicClientSide {
  Translation "202:202=160:160", "192:192=218:218", "198:198=227:227", "199:199=167:167"
  States {
   Spawn:
    6PRS K 0
    6PRS KKKLLLLLLLLMMMMNNNNOOOOPPPP 1 ThrustThingZ(0, 3, 1, 1)
    stop
  }
}

actor Corpse_33 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_33_0", 0, -2, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_1", 0, 2, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_2", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_4", 0, 0, 30, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_33_6", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


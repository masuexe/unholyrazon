actor ArchivistShiny : Archivist {
  Player.ScoreIcon "UMUG_S49"
  Player.MaxHealth 2850
  Health 2850
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.3, 1.3
  Player.JumpZ 14
  Player.MorphWeapon "ArchivistShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_49 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_49_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_49_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_49_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 HH 0 A_SpawnItemEx("Corpse_49_34", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_49_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_49_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_49_0 : BaseCorpseFX {States {Spawn: 1H49 O 350
    goto Spawn2}}
actor Corpse_49_1 : BaseCorpseFX {States {Spawn: 1H49 P 350
    goto Spawn2}}
actor Corpse_49_2 : BaseCorpseFX {States {Spawn: 1H49 Q 350
    goto Spawn2}}

actor Corpse_49_34 : BaseCorpseFX {
  States {
   Spawn:
    1H49 R 0
    1H49 R 0 A_Jump(128, 2)
    1H49 R 350
    goto Spawn2
    1H49 S 350
    goto Spawn2
  }
}

actor Corpse_49_5 : BaseCorpseFX {States {Spawn: 1H49 T 350
    goto Spawn2}}
actor Corpse_49_6 : BaseCorpseFX {States {Spawn: 1H49 U 350
    goto Spawn2}}

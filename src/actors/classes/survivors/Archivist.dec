   Missile_9: DOCB F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
    goto SpawnFrame
   Missile_Air_1: DOCB K 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: DOCB K 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")

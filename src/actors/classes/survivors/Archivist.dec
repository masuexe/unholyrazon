actor Archivist : CustWepClassBase
{
player.scoreIcon "UMUG_49"
player.displayname "Archivist"
player.soundclass "Archivist"
Player.Maxhealth 850
health 850
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
player.jumpz 13
Player.StartItem "UH_BaseFlagPack"
player.startitem "Archivist_W"
player.startitem "Archivist_W2"
player.startitem "Archivist_W3"
player.startitem "Archivist_W4"
player.startitem "RustyEnergyAmmo", 50

player.weaponslot 1, "Archivist_W"
player.weaponslot 2, "Archivist_W2"
player.weaponslot 3, "Archivist_W3"
player.weaponslot 4, "Archivist_W4"
States
{
Spawn:
DOCB A 0
DOCB B 1
DOCB A 1
Goto Spawn+2
See:
DOCB BCDE 5
Goto Spawn
Missile:
DOCB F 5
DOCB G 4
goto Spawn+2
ClassPain: DOCB H 0
Goto MegamanPain

ClassDeath:
DOCB H 0
goto MegamanDeath
MegamanDeath0:
DOCB H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
DOCB H 0
Goto MegamanFade3
MegamanDisintegrate:
DOCB Z 0 A_SpawnItemEx("Corpse_49",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor ArchivistS : Archivist
{
player.scoreIcon "UMUG_S49"
Player.Maxhealth 2850
health 2850
player.forwardmove 1.3, 1.3
player.sidemove 1.3, 1.3
player.jumpz 14
player.morphweapon "ArchivistS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}

actor Corpse_49:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_49_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_49_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_49_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 HH 0 A_SpawnItemEx("Corpse_49_34",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_49_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_49_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


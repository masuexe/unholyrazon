actor RaiderS_W_NormalBar : NormalBar {Args 139, 140}
actor RaiderS_W_ScriptBar : ScriptBar {}

actor RaiderS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Raider_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_17_A"
Obituary "$OB_17W2"
weapon.ammotype "ShadowEnergyAmmo"
States
{
Spawn:
7H17 [ 6
loop

Deselect:
7H17 P 0
goto DeselectSwap
Select:
7H17 P 0
goto SelectSwap

Ready:
7H17 P 1 ACS_NamedExecuteWithResult("core_weaponcolor", RAIDER_SDYE)
7H17 P 0 A_GunFlash("Flash",1)
7H17 P 0 A_JumpIfInventory("RaiderHookFiredFlag",1,"AltFireEnd")
goto Ready2
Ready2:
7H17 P 0 A_JumpIfInventory("HookshotStamina",200,"Ready3")
7H17 P 2 A_WeaponReady(WRF_NOSECONDARY)
7H17 P 0 A_GiveInventory("ShadowEnergyAmmo",2)
loop
Ready3:
7H17 P 2 A_WeaponReady
7H17 P 0 A_GiveInventory("ShadowEnergyAmmo",2)
loop

Flash:
TNT1 A 1 A_GiveInventory("Raider_FlashState_P")
loop

Fire:
7H17 P 0 A_JumpIfInventory("IsBot",1,"BotFire")
//7H17 P 0 A_JumpIf(CallACS("uh_CheckForRage"),"Fire3")

7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
7H17 P 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 P 0 A_Refire(1)
Goto Fire2
FireH:
7H17 A 1 A_GiveInventory("ShadowEnergyAmmo",1)
7H17 A 0 A_Refire("FireH")
Goto Fire3

Fire2:
7H17 P 0 A_GiveInventory("VivifyDelay4",1)
7H17 P 0 A_ReFire(1)
7H17 P 2 Offset(7,-13)
7H17 Q 2 Offset(13,-23)A_PlaySound("Pokemon/HornAttack",1,0.775)
7H17 Q 2 Offset(-53,-4)
7H17 Q 2 Offset(-118,16)A_GiveInventory("S_Raider_Alt_P")
7H17 Q 2 Offset(-183,37)
7H17 Q 2 Offset(-248,59)
7H17 Q 2 Offset(-252,28)
7H17 Q 2 Offset(-246,-2)
7H17 Q 2 Offset(-187,10)A_PlaySound("Pokemon/HornAttack",1,0.775)
7H17 Q 2 Offset(-128,22)
7H17 Q 2 Offset(-69,33)A_GiveInventory("S_Raider_Alt_P")
7H17 Q 2 Offset(-10,44)
7H17 Q 2 Offset(49,53)
7H17 P 2 Offset(43,53)
7H17 P 2 Offset(25,44)
7H17 P 2 Offset(11,37)
Goto Ready2

Fire3:
7H17 B 0 A_GiveInventory("S_Raider_Fire_P")
7H17 BCDEFG 2
TNT1 A 2
7H17 RS 2
Goto Ready2

Altfire:
7H17 K 0 A_JumpIfInventory("HookshotStamina",200,"Altfire2")
goto Ready2
Altfire2:
7H17 K 1 A_GiveInventory("S_Raider_FireHook_P")
Goto AltfireH
AltfireH:
7H17 L 0 A_JumpIfInventory("RaiderHookRelease_F",1,"AltFireEnd")
7H17 L 1 A_GiveInventory("RaiderHookHold_F",1)
7H17 L 0 A_ReFire("AltfireH")
goto AltFireEnd
AltFireEnd:
7H17 M 2 A_GiveInventory("RaiderHookRelease_F",1)
7H17 N 2
7H17 K 2 A_ClearReFire
Goto Ready2

BotFire:
7H17 A 0 A_JumpIfInventory("ShadowEnergyAmmo",150,"BotFireA")
7H17 A 0 A_Jump(16,"BotBonus")
7H17 A 0 A_Jump(56,"BotDodge")
7H17 A 0 A_JumpIfCloser(208,"Fire2")
7H17 A 0 A_PlaySoundEx("weapon/shadow",1)
7H17 A 0 A_Jump(256,"BotFire1","BotFire2","BotFire3","BotFire4","BotFire5")
7H17 A 1
Goto Ready2

BotDodge:
7H17 A 20 A_GiveInventory("Raider_BotDodge_P")
7H17 AA 0 A_Jump(18,"BotBonus")
Goto Ready2

BotBonus:
7H17 A 1 A_GiveInventory("ShadowEnergyAmmo",30)
goto BotFire+2

BotFireEnd:
7H17 B 0 A_GiveInventory("ShadowEnergyAmmo",8)
7H17 BCDEFGHI 2
7H17 A 1 A_Jump(16,"BotDodge")
Goto Ready2

BotFire1:
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire2:
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire3:
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire4:
BEXP A 0 A_FireCustomMissile("S_RaiderBladeShot",0,0,8,0)
goto BotFireEnd
BotFire5:
7H17 A 0 ThrustThingZ(0,42,0,0)
7H17 A 0 A_Jump(8,"BotBonus")
7H17 A 0 A_Jump(192,"BotFire1","BotFire2","BotFire3","BotFire4")
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",0,0,8,0)
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",8,0,8,3)
7H17 A 0 A_FireCustomMissile("S_RaiderBladeShot",-8,0,8,3)
goto BotFireEnd
BotFireA:
BEXP A 0 A_JumpIfInventory("ShadowEnergyAmmo",150,1)
goto BotFire+2
7H17 A 0 A_TakeInventory("ShadowEnergyAmmo",150)
7H17 A 0 A_PlaySoundEx("misc/stonethrow",1)
7H17 A 0 A_FireCustomMissile("S_RaiderPoison",0,0,8,0)
7H17 A 0 A_FireCustomMissile("S_RaiderPoison",8,0,8,3)
7H17 A 0 A_FireCustomMissile("S_RaiderPoison",-8,0,8,3)
goto BotFireEnd
}
}

actor S_Raider_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ShadowEnergyAmmo",100,"Fire2")
TNT1 A 0 A_PlaySoundEx("weapon/shadow",1)
TNT1 A 0 A_FireCustomMissile("S_RaiderBladeShot",0,1,8,0)
TNT1 A 0 A_GiveInventory("ShadowEnergyAmmo",9)
stop
Fire2:
TNT1 A 0 A_TakeInventory("ShadowEnergyAmmo",65,1)
TNT1 A 0 A_TakeInventory("ShadowEnergyAmmo",35)
TNT1 A 0 A_PlaySoundEx("misc/stonethrow",1)
TNT1 A 0 A_FireCustomMissile("S_RaiderPoison",0,1,8,0)
//TNT1 A 0 A_FireCustomMissile("S_RaiderPoison",15,0,8,0)
//TNT1 A 0 A_FireCustomMissile("S_RaiderPoison",-15,0,8,0)
stop
}
}

actor S_Raider_FireHook_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_RaiderHookshot",0,8,32,cos(-pitch)*1,0,sin(-pitch)*1,0,0)
goto End
}
}


actor S_RaiderBladeShot : RaiderBladeShot
{
Translation "192:192=54:54","198:198=48:48"
Damage (225)//150
}

actor S_Raider_Alt_P : Raider_Alt_P
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_JumpIf(CallACS("uh_CheckForSpread"),"PickupSpread")
TNT1 A 0 A_Jump(256,"P23","P24","P25","P26","P27","P28","P29","P30","P31","P32","P33","P34","P35","P36","P37","P38","P39","P40","P41","P42","P43","P44","P45","P46","P47","P48","P49","P50","P51","P52","P53")
stop
PickupSpread:
TNT1 A 0 A_Jump(256,"P69","P72","P75","P78","P81","P84","P87","P90","P93","P96","P99","P102","P105","P108","P111","P114","P117","P120","P123","P126","P129","P132","P135","P138","P141","P144","P147","P150","P153","P156","P159")
stop
}
}


actor S_RaiderHookshot : RaiderHookshot
{
Translation "192:192=48:48","198:198=54:54","202:202=20:20","195:195=31:31"
Damage (150)//100
Args 50//0
}

Actor S_RaiderHookshotFX : BasicClientSide
{
Translation "192:192=54:54","198:198=48:48"
States
{
Spawn:
6P17 B 0
6P17 B 1
Stop
}
}

actor S_RaiderPoison : RaiderPoison
{
Translation "192:192=233:233","198:198=234:234","95:95=3:3","202:202=181:181","199:199=184:184","118:118=110:110","119:119=129:129"

damage (380)//250
//Radius 14
//Height 14
//speed 50
States
{
XDeath:
6P17 I 1
6P17 I 3 A_SpawnItemEx("RS_HitSplat38",1)
stop
}
}

actor S_RaiderPoisonHitDamager : RaiderPoisonHitDamager
{
states
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("GNT/Poison",2,0.75)
TNT1 A 0 A_SpawnItemEx("RS_HitSplat08",0,0,0,0,0,0,0,1)
TNT1 A 1 A_Explode(80,15,0,0,15)
stop
}
}


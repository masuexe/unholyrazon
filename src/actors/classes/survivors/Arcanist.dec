actor Arcanist : CustWepClassBase
{
player.scoreIcon "UMUG_12"
player.displayname "Arcanist"
player.soundclass "Arcanist"
player.maxhealth 825
health 825
player.forwardmove 1.15, 1.15
player.sidemove 1.15, 1.15
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "Arcanist_W"
player.startitem "Arcanist_W2"
player.startitem "Arcanist_W3"
player.startitem "Arcanist_W4"
player.startitem "CatalyticRuneAmmo", 84

player.weaponslot 1, "Arcanist_W"
player.weaponslot 2, "Arcanist_W2"
player.weaponslot 3, "Arcanist_W3"
player.weaponslot 4, "Arcanist_W4"

States
{
Spawn:
1H12 A 0
1H12 B 1
1H12 A 1
Goto Spawn+2
See:
1H12 BCDE 5
Goto Spawn
Missile:
1H12 F 0 A_JumpIfInventory("VivifyFlag1",1,"Missile1")
1H12 F 0 A_JumpIfInventory("VivifyDelay1",1,"Missile2")
1H12 F 5
1H12 G 4
goto Spawn+2
Missile1:
1H12 KF 2
goto Spawn+2
Missile2:
1H12 FFKKFFKKFFKKFFKKFFKKFFKKFFKKFFKKFFKK 1 A_JumpIfInventory("VivifyDelay3",1,"Missile3")
Missile3:
1H12 G 7
goto Spawn+2
ClassPain: 1H12 H 0
Goto PainContinue

ClassDeath:
1H12 H 1
1H12 H 1 A_SpawnItemEx("ArcanistDeathFlamesSpawner",0,0,8,0,0,0,0,1)
Goto FadeDeathEnd3
ClassCorpse:
1H12 Z 0 A_SpawnItemEx("Corpse_12",0,0,0,momx,momy,momz,0,9)
Goto MegaDeathEndGib
}
}

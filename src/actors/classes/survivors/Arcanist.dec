actor Arcanist : CustWepClassBase {
  Player.ScoreIcon "UMUG_12"
  Player.DisplayName "Arcanist"
  Player.SoundClass "Arcanist"
  Player.MaxHealth 825
  Health 825
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Arcanist_W"
  Player.StartItem "Arcanist_W2"
  Player.StartItem "Arcanist_W3"
  Player.StartItem "Arcanist_W4"
  Player.StartItem "CatalyticRuneAmmo", 84
  Player.StartItem "NoDrawMaestroMugshot"
  Player.StartItem "UHMugshotArcanist"

  Player.WeaponSlot 1, "Arcanist_W"
  Player.WeaponSlot 2, "Arcanist_W2"
  Player.WeaponSlot 3, "Arcanist_W3"
  Player.WeaponSlot 4, "Arcanist_W4"

  States {
   Spawn:
    1H12 A 0
    1H12 B 1
    1H12 A 1
    goto Spawn+2
   See:
    1H12 BCDE 5
    goto Spawn
   Missile:
    1H12 F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile1")
    1H12 F 0 A_JumpIfInventory("VivifyDelay1", 1, "Missile2")
    1H12 F 5
    1H12 G 4
    goto Spawn+2
   Missile1:
    1H12 KF 2
    goto Spawn+2
   Missile2:
    1H12 FFKKFFKKFFKKFFKKFFKKFFKKFFKKFFKKFFKK 1 A_JumpIfInventory("VivifyDelay3", 1, "Missile3")
   Missile3:
    1H12 G 7
    goto Spawn+2
   ClassPain:
    1H12 H 0
    goto MegamanPain

   ClassDeath:
    1H12 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H12 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H12 H 1 A_SpawnItemEx("ArcanistDeathFlamesSpawner", 0, 0, 8, 0, 0, 0, 0, 1)
    goto MegamanFade3
   MegamanDisintegrate:
    1H12 Z 0 A_SpawnItemEx("Corpse_12", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor ArcanistShiny : Arcanist {
  Player.ScoreIcon "UMUG_S12"
  Player.MaxHealth 2825
  Health 2825
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 11
  Player.MorphWeapon "ArcanistShiny_W"
  Player.WeaponSlot 1, "ArcanistShiny_W"
  Player.WeaponSlot 2, "ArcanistShiny_W2"
  Player.WeaponSlot 3, "ArcanistShiny_W3"
  Player.WeaponSlot 4, "ArcanistShiny_W4"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H12 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H12 H 1 A_SpawnItemEx("S_ArcanistDeathFlamesSpawner", 0, 0, 8, 0, 0, 0, 0, 1)
    goto MegamanFade3
  }
}

actor ArcanistDeathFlamesSpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 0, 0, 8, 0, 0, 0, 0, 1 + SXF_TRANSFERSPECIAL)  // 32768
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 40, 0, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 20, 20, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 0, 40, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", -20, 20, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", -40, 0, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", -20, -20, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 0, -40, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 20, -20, 8, 0, 0, 0, 0, 1 + 32768)
    TNT1 A 2 A_SpawnItemEx("ArcanistDeathFlames", 40, 0, 8, 0, 0, 0, 0, 1 + 32768)
    stop
  }
}
actor S_ArcanistDeathFlamesSpawner : ArcanistDeathFlamesSpawner {
  Args 18
}

actor ArcanistDeathFlamesPulse_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 ThrustThingZ(0, 1, 0, 1)
    stop
  }
}

actor ArcanistDeathFlames : BasicProjectile {
  DamageType "ArcaneFire"
  Obituary "$OB_12D"
  +RIPPER
  +VISIBILITYPULSE
  RenderStyle "Add"
  Alpha 0.25
  Damage (35 + args[0])
  Radius 8
  Height 8
  Speed 30
  Scale 2.5
  States {
   Spawn:
    6P10 ABCDABCDABCDABCDABCDABCD 2 A_GiveInventory("ArcanistDeathFlamesPulse_P")
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor Corpse_12 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_12_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_12_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_12_0 : BaseCorpseFX {States {Spawn: 1H12 O 350
    goto Spawn2}}

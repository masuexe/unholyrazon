    goto Spawn2}}
actor Corpse_12_2 : BaseCorpseFX {States {Spawn: 1H12 Q 350
    goto Spawn2}}
actor Corpse_12_3 : BaseCorpseFX {States {Spawn: 1H12 R 350
    goto Spawn2}}
actor Corpse_12_4 : BaseCorpseFX {States {Spawn: 1H12 S 350
    goto Spawn2}}
actor Corpse_12_5 : BaseCorpseFX {States {Spawn: 1H12 T 350
    goto Spawn2}}
actor Corpse_12_6 : BaseCorpseFX {States {Spawn: 1H12 U 350
    goto Spawn2}}

Actor S_TristanaExplosiveCharge : TristanaExplosiveCharge
{
Translation "202:202=32:32","192:192=34:34","198:198=77:77","199:199=78:78"
Damage (75)//50
States
{
XDeath:
Crash:
TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer"),"StickyMine")
goto Death
StickyMine:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySound("wep_L/mm2/crashbombland")
TNT1 A 0 A_Explode(10,24,0,0,24)
TNT1 A 4 A_SpawnItemEx("S_TristanaExplosiveChargeFollow",0,0,0,0,0,0,0,1+102)
stop

Death:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySound("wep_L/mm2/crashbombland")
TNT1 A 0 A_Explode(10,24,0,0,24)
TNT1 A 4 A_SpawnItemEx("S_TristanaExplosiveChargeSit",0,0,0,0,0,0,0,1)
stop
}
}


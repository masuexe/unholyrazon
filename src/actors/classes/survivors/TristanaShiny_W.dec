actor TristanaShiny_W_ScriptBar : ScriptBar {}

actor TristanaShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Tristana_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_38_A"
Obituary "$OB_38W"
weapon.ammotype "IWannaShootSomethingAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H38 [ 6
loop

Deselect:
7H38 A 0
goto DeselectSwap
Select:
7H38 A 0
goto SelectSwap

Ready:
7H38 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TRISTANA_SDYE)
7H38 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H38 A 0 A_JumpIfInventory("IWannaShootSomethingAmmo",446,"Ready3")
7H38 A 2 A_WeaponReady(8)
7H38 A 0 A_GiveInventory("IWannaShootSomethingAmmo",8)
loop
Ready3:
7H38 A 2 A_WeaponReady
7H38 A 0 A_GiveInventory("IWannaShootSomethingAmmo",8)
loop

Fire:
7H38 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H38 A 0 A_Refire("FireH1")
Goto Ready2

AltHold:
7H38 A 2 Offset(0,32)
Fire1:
FireRNG:
7H38 A 0 Offset(0,32)A_GiveInventory("S_Tristana_Fire_P")
7H38 A 0 A_JumpIfInventory("TristanaMuzzleRNG_F",1,2)
7H38 A 2
goto FireRNG_End
7H38 D 0 A_JumpIfInventory("TristanaMuzzleRNG_F",2,2)
7H38 D 2
goto FireRNG_End
7H38 E 0 A_JumpIfInventory("TristanaMuzzleRNG_F",3,2)
7H38 E 2
goto FireRNG_End
7H38 F 0 A_JumpIfInventory("TristanaMuzzleRNG_F",4,2)
7H38 F 2
goto FireRNG_End
7H38 G 0 A_JumpIfInventory("TristanaMuzzleRNG_F",5,2)
7H38 G 2
goto FireRNG_End
7H38 H 0 A_JumpIfInventory("TristanaMuzzleRNG_F",6,2)
7H38 H 2
goto FireRNG_End
7H38 I 0 A_JumpIfInventory("TristanaMuzzleRNG_F",7,2)
7H38 I 2
goto FireRNG_End
7H38 J 0
7H38 J 2
goto FireRNG_End

FireRNG_End:
7H38 A 1 Offset(0,59)
7H38 A 1 Offset(0,55) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 Offset(0,51)
7H38 A 1 Offset(0,47) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 Offset(0,43)
7H38 A 1 Offset(0,39) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 Offset(0,35)
7H38 A 0 A_Refire
Goto Ready2

FireH1:
7H38 A 0 A_JumpIfInventory("TristanaFlag",14,"FireH2")
7H38 A 0 A_GiveInventory("TristanaFlag_RC")
7H38 A 1 A_WeaponReady(6)
7H38 A 0 A_Refire("FireH1")
goto Fire1
FireH2:
7H38 B 0 A_JumpIfInventory("TristanaFlag",56,"FireH3")
7H38 B 0 A_GiveInventory("TristanaFlag_RC")
7H38 B 1 A_WeaponReady(6)
7H38 B 0 A_Refire(1)
goto Fire1
7H38 B 0 A_JumpIfInventory("TristanaFlag",56,"FireH3")
7H38 B 0 A_GiveInventory("TristanaFlag_RC")
7H38 B 1 A_WeaponReady(6)
7H38 B 0 A_Refire(1)
goto Fire1
7H38 A 0 A_JumpIfInventory("TristanaFlag",56,"FireH3")
7H38 A 0 A_GiveInventory("TristanaFlag_RC")
7H38 A 1 A_WeaponReady(6)
7H38 A 0 A_Refire(1)
goto Fire1
7H38 A 0 A_JumpIfInventory("TristanaFlag",56,"FireH3")
7H38 A 0 A_GiveInventory("TristanaFlag_RC")
7H38 A 1 A_WeaponReady(6)
7H38 A 0 A_Refire("FireH2")
goto Fire1
FireH3:
7H38 B 0 A_JumpIfInventory("IsBot",1,"BotFireH")
7H38 B 0 A_GiveInventory("TristanaFlag_RC")
7H38 B 1 A_WeaponReady(6)
7H38 B 0 A_Refire(1)
goto Fire1
7H38 B 0 A_JumpIfInventory("IsBot",1,"BotFireH")
7H38 B 0 A_GiveInventory("TristanaFlag_RC")
7H38 A 1 Offset(0,33)A_WeaponReady(7)
7H38 B 0 A_Refire("FireH3")
goto Fire1

BotFire:
7H38 A 0 A_JumpIfInventory("IWannaShootSomethingAmmo",892,"AltFire2")
7H38 A 0 A_Jump(16,"AltFire2")
7H38 A 0 A_Jump(8,"BotFire3")
7H38 A 0 A_Jump(128,"Fire1")
7H38 A 0 A_Jump(32,"BotFire1")
7H38 A 0 A_Jump(32,1)
goto Fire+1
7H38 A 0 A_GiveInventory("IWannaShootSomethingAmmo",random(80,160))
7H38 A 0 A_PlaySoundEx("taunt/D_38","Voice")
goto Fire+1
BotFire1:
7H38 A 0 A_Jump(10,"BotFire2")
7H38 A 0 A_Jump(6,"Fire1")
7H38 A 0 A_Jump(8,"BotFire3")
7H38 C 0 A_PlaySound("KirbyNES/QuickDrawF",1)
7H38 C 0 A_FireCustomMissile("S_TristanaBasicAttack",0,0,8,0)
7H38 CBAA 3 A_GiveInventory("IWannaShootSomethingAmmo",6)
7H34 B 0 A_ReFire("BotFire1")
Goto Ready2
BotFire2:
7H38 B 0 A_GiveInventory("TristanaFlag_RC",56)
goto Fire1
BotFire3:
7H38 A 0 A_GiveInventory("IWannaShootSomethingAmmo",892)
7H38 A 0 A_GiveInventory("TristBShot_Jump_P")
7H38 A 0 A_PlaySoundEx("taunt/D_38","Voice")
goto Fire+1

BotFireH:
7H38 B 0 A_Jump(12,"BotFire2")
7H38 B 0 A_JumpIfInventory("DecoyFlag1",1,"BotFireH2")
7H38 B 0 A_Jump(1,1)
goto FireH3+1
7H38 B 0 A_GiveInventory("TristBShot_Jump_P")
goto FireH3+1
BotFireH2:
7H38 B 0 A_Recoil(-0.5f)
goto FireH3+1

Flash:
TNT1 A 0 A_JumpIfInventory("DecoyFlag1",1,"Flash.RocketJump")
TNT1 A 1
loop
Flash.RocketJump://Morphes cannot use powerspeed. So ACS is required to change their speed.
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,250,100)//A_GiveInventory("PowerTristanaRocketJumpSpeed")
TNT1 A 1
goto Flash.Land

Flash.Land:
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "Flash.LandEnd")
TNT1 A 0 A_JumpIf(momz==0,"Flash.LandZ")
TNT1 A 0 A_JumpIfInventory("DecoyFlag2",1,"Flash.LandEnd")
TNT1 A 1 A_SpawnItemEx("TristanaRocketJumpLander",0,0,-8,momx,momy,momz,0,8)
loop
Flash.LandZ:
TNT1 A 1 A_SpawnItemEx("TristanaRocketJumpLander",0,0,-8,momx,momy,momz,0,8)
TNT1 A 0 A_JumpIfInventory("DecoyFlag2",1,"Flash.LandEnd")
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "Flash.LandEnd")
TNT1 A 0 A_JumpIf(momz==0,"Flash.LandEnd")
goto Flash.Land+3
Flash.LandEnd://Same as above. Turns speed off.
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,1,1)//A_TakeInventory("PowerTristanaRocketJumpSpeed")
TNT1 A 0 A_SpawnItemEx("TristanaRocketJumpLand_H",0,0,12,0,0,0,0,1)
TNT1 A 1 A_SpawnItemEx("S_TristanaRocketJumpBoom",0,0,24,momx,momy,momz,0,8)
TNT1 A 0 A_TakeInventory("DecoyFlag1")
TNT1 A 0 A_TakeInventory("DecoyFlag2")
goto Flash

AltFire:
7H38 A 0 A_JumpIfInventory("TristanaFlag",1,"Fire1")
AltFire2:
7H38 A 0 A_GiveInventory("Tristana_Alt_P")
7H38 A 1 OffSet(-15, 42)
7H38 A 1 OffSet(-30, 57) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 OffSet(-45, 72)
7H38 A 1 OffSet(-38, 62) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 OffSet(-30, 52)
7H38 A 1 OffSet(-22, 47) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 1 OffSet(-15, 42)
7H38 A 1 OffSet(-7, 37) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H38 A 0 A_WeaponReady(14)
Goto Ready2
}
}

actor S_Tristana_Fire_P : Tristana_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TristanaFlag",56,2)
TNT1 A 0 A_FireCustomMissile("S_TristanaBasicAttack",0,0,8,0)
goto End
TNT1 A 0 A_FireCustomMissile("S_TristanaBusterShot",0,0,8,0)
goto End
}
}

actor S_Tristana_Alt_P : Tristana_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TristanaExplosiveCharge",0,0,8,0)
goto End
}
}


actor S_AncientSmokeShot1 : AncientSmokeShot1
{
Translation "192:192=80:80","198:198=79:79","199:199=6:6"
Damage (225)//150
States
{
Crash:
XDeath:
TNT1 A 0 A_SpawnItemEx("S_AncientSmoke_H1T",0,0,0,0,0,0,0,1+SXF_TRANSFERPOINTERS)//1024
goto DeathFX
Death:
TNT1 A 0 A_SpawnItemEx("S_AncientSmoke_H1",0,0,16-(ceilingz-z<=height)*46,0,0,0,0,1)
goto DeathFX

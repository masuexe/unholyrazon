actor S_AncientBloodShot1 : AncientBloodShot1
{
Translation "192:192=42:42","198:198=79:79","199:199=6:6"
damage (405)//270
States
{
Death:
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0],sin(15)*Args[0],10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0],sin(7.5)*Args[0],10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0]+4,sin(7.5)*Args[0],10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0]+0,0,10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0]+4,0,10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0]+8,0,10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0]+4,-sin(7.5)*Args[0],10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0],-sin(7.5)*Args[0],10)
TNT1 A 0 A_SpawnItemEx("S_AncientBlood1",0,0,0,Args[0],-sin(15)*Args[0],10)
goto DeathOil
}
}

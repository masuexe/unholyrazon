actor S_AncientIce_H1 : AncientIce_H1
{
States
{
Spawn:
TNT1 A 0 nodelay A_SpawnItemEx("S_AncientIce1",0,0,0,0,0,0,0,1)
goto Up
SpawnL:
TNT1 A 0 A_SpawnItemEx("S_AncientIce1",50*Args[4],-50*Args[4]+50*Args[1],0,0,0,0,45*1,1)
TNT1 A 0 A_SpawnItemEx("S_AncientIce1",50*Args[4],-50*Args[4]+50*Args[1],0,0,0,0,45*3,1)
TNT1 A 0 A_SpawnItemEx("S_AncientIce1",50*Args[4],-50*Args[4]+50*Args[1],0,0,0,0,45*5,1)
TNT1 A 0 A_SpawnItemEx("S_AncientIce1",50*Args[4],-50*Args[4]+50*Args[1],0,0,0,0,45*7,1)
TNT1 A 0 A_CountDownArg(1)//A_SetArg(1,Args[1]-1)
TNT1 A 0 A_JumpIf(Args[1]<1,"Up")
loop
}
}


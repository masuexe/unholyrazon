actor ArcanistS_W_ScriptBar : ScriptBar {}
actor ArcanistS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Arcanist_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_12_A"
Obituary "$OB_S12W"
Tag "$TAG_Arcanist_W"
weapon.ammotype "CatalyticRuneAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H12 [ 6
loop

Deselect:
7H12 A 0
goto DeselectSwap
Select:
7H12 A 0
goto SelectSwap

Ready:
7H12 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", ARCANIST_SDYE)
7H12 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto ReadyX
ReadyX:
7H12 Q 2 A_GiveInventory("Arcanist_ReadyState_P")
wait


Fire:
7H12 B 0 A_GiveInventory("VivifyDelay1",1)
7H12 C 0 A_ReFire(1)
7H12 BC 2
Fire1://Ice
7H12 DEFGDEFGDEF 2
7H12 I 0 A_GiveInventory("S_Arcanist_Fire_P1")
7H12 HIJ 2
7H12 KK 6 A_RailWait
goto FireEnd

FireEnd:
7H12 LMN 2
7H12 A 2 A_JumpIfInventory("IsBot",1,"BotReady")
goto ReadyX

AltFire:
7H12 O 0 A_GiveInventory("Arcanist_AltCycle_P")
7H12 O 0 A_ReFire("AltFireH")
AltFireH:
7H12 O 1 A_GiveInventory("CatalyticRuneAmmo",1)
7H12 P 1 A_ReFire("AltFireH")
7H12 P 1 A_TakeInventory("VivifyFlag1")
goto ReadyX


AltFireOld:
7H12 H 0 A_PlaySound("wep_L/RC_SpellOk",1)
7H12 H 0 A_FireCustomMissile("S_MiasmicShot",0,0,0,0)
7H12 H 0 A_FireCustomMissile("S_MiasmicShot",20,0,0,0)
7H12 H 0 A_FireCustomMissile("S_MiasmicShot",-20,0,0,0)
7H12 IJ 2
7H12 K 10 A_GiveInventory("CatalyticRuneAmmo",28)
7H12 LMN 2
7H12 AA 1 A_Jump(256,"BotReady")
Goto BotReady

Flash.BotAmmo:
TNT1 A 30
TNT1 A 0 A_GiveInventory("CatalyticRuneAmmo",112)
stop

BotReady0:
7H12 A 0 A_Jump(64,"BotAlt")
7H12 A 0 A_ReFire(1)
Goto BotReady
7H12 A 0 A_Jump(32,"AltFireOld")
7H12 A 0 A_Jump(192,"BotAlt")
7H12 A 0 A_Jump(256,"BotReady")
Goto BotReady

BotReady:
7H12 A 0 A_Jump(1,"BotReady0")
7H12 A 0 A_JumpIfInventory("CatalyticRuneAmmo",0,"BotReadyX")
7H12 A 2 A_WeaponReady(12)
7H12 A 0 A_GiveInventory("CatalyticRuneAmmo",3)
loop
BotReadyX:
7H12 A 0 A_WeaponReady(12)
7H12 A 2 A_Refire("BotCheck")
7H12 A 0 A_GiveInventory("CatalyticRuneAmmo",3)
loop

BotSwap:
7H12 A 0 A_GiveInventory("CatalyticRuneAmmo",random(1,7)*10)
7H12 A 0 A_PlaySound("taunt/D_12",2)
7H12 A 0 A_Jump(198,1,2,2,2)
7H12 A 0 A_GunFlash("Flash.BotAmmo",1)
goto BotFire
7H12 AAAA 0 A_GiveInventory("Arcanist_AltCycle_P")
goto BotReady

BotCheck:
7H12 A 0 A_Jump(24,"BotSwap")
7H12 A 0 A_Jump(64,"BotAlt")
7H12 A 0 A_Jump(32,"AltFireOld")
goto BotFire

BotFire:
goto Fire

BotAlt:
7H12 O 0 A_GiveInventory("Arcanist_AltCycle_P")
7H12 O 0 A_ReFire(1)
7H12 OOP 2 A_GiveInventory("CatalyticRuneAmmo",8)
7H12 P 2 A_TakeInventory("VivifyFlag1")
7H12 P 0 A_Jump(32,"BotAlt")
goto BotReady
}
}


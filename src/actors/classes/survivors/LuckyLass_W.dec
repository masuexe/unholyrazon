actor LuckyLass_FlashState_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("LuckyLassBonus_F",2,"Chargin")
TNT1 A 0 A_JumpIfInventory("LuckyCharge",103,1)
goto Chargin
TNT1 A 0 A_PlaySoundEx("misc/LuckUp2","Body")
TNT1 A 0 A_GiveInventory("LuckyLassBonus_F",2)
goto Chargin

Chargin:
TNT1 A 0 A_JumpIfInventory("LuckyCharge",22,1)
goto Give
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
TNT1 A 0 A_PlaySound("weapon/LuckyLoop",1,1.0,true)//14
goto Give
TNT1 A 0 A_JumpIfInventory("LuckyCharge",29,1)
goto Give
TNT1 A 0 A_PlaySound("weapon/LuckyLoopR",1,1.0,true)//11
goto Give

Give:
TNT1 A 0 A_GiveInventory("LuckyEnergyAmmo",1)
TNT1 A 0 A_GiveInventory("LuckyCharge",1)
TNT1 A 0 A_JumpIfInventory("LuckyLassBonus_F",2,1)
stop
TNT1 A 0 A_GiveInventory("LuckyLass_ChargedFX_P")
stop
}
}

actor LuckyLassShot1 : BasicProjectile
{
damagetype "LuckyLass"
Obituary "$OB_06M1"
+FORCEXYBILLBOARD
+BRIGHT
Damage (75)
radius 7
height 7
Speed 40
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1 ACS_NamedExecuteWithResult("core_copytranslation")
X_0D A 1
wait
Death:
X_0D A 1
stop
}
}

actor LuckyLassShot2 : LuckyLassShot1
{
Damage (150)
radius 15
height 15
Speed 50
States
{
Spawn:
TMFX C 0
TMFX C 0 ACS_NamedExecuteWithResult("core_copytranslation")
TMFX C 4
wait
Death:
TMFX C 1
stop
}
}

actor LuckyLassShot3 : LuckyLassShot1
{
Radius 16
Height 16
speed 80
States
{
Spawn:
6P06 A 0
6P06 A 0 ACS_NamedExecuteWithResult("core_copytranslation")
6P06 ABCD 3
goto Spawn+2
Spawn2:
6P06 A 0
6P06 A 0 ACS_NamedExecuteWithResult("core_copytranslation")
6P06 ABCD 2
goto Spawn+2
SpawnA:
6P06 A 0
6P06 A 0 ACS_NamedExecuteWithResult("core_copytranslation")
6P06 A 2
6P06 BCD 2 A_ScaleVelocity(2.0)//1.05 loop//A_Recoil(-4)
6P06 A 0 ThrustThingZ(0,0,0,1)
6P06 A 0 ThrustThing(angle*256/360,0,1,0)
goto Spawn2+2
Death:
TMFX ABCD 3
stop
}
}


TNT1 A 0 A_JumpIfInventory("LL_Color_F",5,9)
TNT1 A 0 A_JumpIfInventory("LL_Color_F",4,7)
TNT1 A 0 A_JumpIfInventory("LL_Color_F",3,5)
TNT1 A 0 A_JumpIfInventory("LL_Color_F",2,3)
TNT1 A 0 A_JumpIfInventory("LL_Color_F",1,1)
Flash.Slots:
6K06 ABCDEFGHIJKLMNOPQRSTUVWX 2 A_RailWait
loop

AltFire2:
"----" "#" 0 A_GunFlash("Flash.Rainbow",1)
"----" "#" 0 A_GiveInventory("LL_Alt_P")
"----" "#" 0 A_ReFire(1)
"----" "#####" 6 A_PlaySound("LuckyLass/Slots1",1)
"----" "#" 0 A_GunFlash("NoFlash",1)
"----" "#" 0 A_GiveInventory("LL_AltJudgement_P")
6H06 C 0 A_JumpIfInventory("LL_Color_F",2,6)
6H06 CBAAA 4
goto Ready2a
6H06 I 0 A_JumpIfInventory("LL_Color_F",3,6)
6H06 IHGGG 4
goto Ready2b
6H06 O 0 A_JumpIfInventory("LL_Color_F",4,6)
6H06 ONMMM 4
goto Ready2c
6I06 C 0 A_JumpIfInventory("LL_Color_F",5,6)
6I06 CBAAA 4
goto Ready2d
6I06 I 0 A_JumpIfInventory("LL_Color_F",6,6)
6I06 IHGGG 4
goto Ready2e
6I06 O 0 A_JumpIfInventory("LL_Color_F",7,6)
6I06 ONMMM 4
goto Ready2f
6J06 C 0 A_JumpIfInventory("LL_Color_F",8,6)
6J06 CBAAA 4
goto Ready2g
6J06 I 0 A_JumpIfInventory("LL_Color_F",9,6)
6J06 IHGGG 4
goto Ready2h
6J06 O 0 A_JumpIfInventory("LL_Color_F",10,1)
6J06 ONMMM 4
goto Ready2i

BotFire:
6I06 A 0 A_JumpIfInventory("LuckyEnergyAmmo",400,"AltFire2")
6I06 A 0 A_Jump(1,1)
goto Fire+1
6I06 A 0 A_PlaySound("taunt/D_06A",0)//Auto
6I06 A 0 A_GiveInventory("DoomSphere",1)
goto Fire+1

BotFireH:
6I06 A 0 A_JumpIfInventory("LuckyEnergyAmmo",400,"AltFire2")
6I06 A 0 A_Jump(160,1)
goto BotHold0
BotHold0:
6I06 A 0 A_Jump(8,"BotFire")
6I06 A 1 A_JumpIfInventory("LuckyCharge",9,"Hold1Snd")
6I06 A 0 A_Refire("BotHold0")
Goto FireCheck

BotHold1:
6I06 A 0 A_Jump(4,"FireCheck")
6I06 A 0 A_GiveInventory("LL_DyeChange_P0")
6I06 A 1 A_JumpIfInventory("LuckyCharge",27,"Hold2Snd")
6I06 A 0 A_Refire(1)
goto FireCheck
6I06 A 0 A_GiveInventory("LL_DyeChange_P1")
6I06 D 1 A_JumpIfInventory("LuckyCharge",27,"Hold2Snd")
6I06 D 0 A_Refire(1)
goto FireCheck
6I06 D 1 A_JumpIfInventory("LuckyCharge",27,"Hold2Snd")
6I06 D 0 A_Refire("BotHold1")
goto FireCheck

BotHold2Snd:
6I06 A 0 A_Jump(16,"FireCheck")
goto BotHold2
BotHold2X:
6I06 A 0 A_PlaySound("taunt/D_06",2)//Voice
6I06 A 0 A_GiveInventory("LuckyCharge",random(45,60))
goto BotHold2+3
BotHold2:
6I06 A 0 A_JumpIfInventory("LuckyLassBonus_F",3,"BotHold3")
6I06 A 0 A_Jump(3,"FireCheck")
6I06 A 0 A_Jump(5,"BotHold2X")
6I06 A 0 A_GiveInventory("LL_RandomColorF_P")
6I06 A 1 A_GiveInventory("LL_DyeChange_P0")
6I06 A 0 A_Refire(1)
goto FireCheck
6I06 E 1 A_GiveInventory("LL_DyeChange_P2")
6I06 E 0 A_Refire(1)
goto FireCheck
6I06 F 1 A_GiveInventory("LL_DyeChange_P3")
6I06 F 0 A_Refire("BotHold1")
goto FireCheck
BotHold3:
6I06 A 0 A_JumpIfInventory("LuckyEnergyAmmo",0,"FireCheck")
6I06 A 0 A_Jump(6,2)
6I06 A 0 A_Jump(6,"FireCheck")
goto BotHold2+3
6I06 A 0 A_PlaySound("taunt/D_06",2)
6I06 A 0 A_GiveInventory("LuckyLassBonus_F",random(3,5))
6I06 A 0 A_Jump(16,"BotHold2X")
6I06 A 0 A_FaceTarget
goto FireCheck

}
}

actor LuckyEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 400
+INVENTORY.IGNORESKILL
}

actor LuckyCharge : Inventory
{
inventory.maxamount 103
}

actor LuckyLassBonus_F : Inventory
{
inventory.maxamount 25
}

actor LL_Color_F : Inventory
{
inventory.maxamount 9
}
actor LL_Judge_F : Inventory
{
inventory.maxamount 9
}

actor LL_ColorDelay_F : PowerUp
{
Powerup.Duration 35
}



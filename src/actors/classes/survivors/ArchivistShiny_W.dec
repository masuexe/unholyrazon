actor S_YeOld_BetaRaidMine : S_YeOld_49_Base {
    -NOGRAVITY
    damage 0
    Radius 6
    Height 6
    speed 40
    States {
     Spawn:
      X_2E E 1
      loop
     Death:
      X_2E E 0 A_JumpIf(z-floorz<5, "Floor")
      X_2E E 3 A_PlaySound("weapon/crashland")
      X_2E E 3
      X_2E FGFGFGFGFGFGFG 3
      Goto XDeath
     Floor:
      X_2E E 3 A_PlaySound("weapon/crashland")
      X_2E E 3
      X_2E FGFGFGFGFGFGFG 3
      Goto XDeath
     XDeath:
      X_2E K 0 A_PlaySound("weapon/crashexplode")
      X_2E K 3 A_Explode(300, 64, 0)//200
      X_2E LM 3
      X_2E N 3 A_Explode(300, 64, 0)
      X_2E OP 3
      X_2E Q 3 A_Explode(300, 64, 0)
      X_2E RS 3
      X_2E T 3 A_Explode(300, 64, 0)
      X_2E VW 3
      stop
    }
}


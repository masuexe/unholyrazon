actor S_Archivist_Alt_P0 : CustomInventory {
    States {
     Pickup:
     Ammo:
      TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 30, 1)
      TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 30)
      stop
    }
}
actor S_Archivist_Alt_P1 : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 A_PlaySound("weapon/superarmuse", 1)//coilbounce1//Core renames
      TNT1 A 0 ThrustThingZ(0, 40, 0, 0)
      TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
      TNT1 A 0 A_Recoil(-30)
      goto P_Fire
      TNT1 A 0 A_Recoil(-45)
      goto P_Fire
     P_Fire:
      TNT1 AAAAAAAAAA 0 A_SpawnItemEx("S_YeOld_DeadlyGas", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 0, 0)
      TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 1)
      goto Ammo
      TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("S_YeOld_DeadlyGas", 0, 0, 8, (random(0, 1)*2-1)*random(10, 20), (random(0, 1)*2-1)*random(10, 20), random(10, 20), 0, 0, 0)
      goto Ammo
    }
}
actor S_Archivist_Alt_P2 : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 A_PlaySound("weapon/mbuster", 1)
      TNT1 A 0 A_FireCustomMissile("S_YeOld_CopyDeadlyExplosive", 0, 0, 0, 0)
      TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
      TNT1 A 0 A_Recoil(-40)
      goto Ammo
    }
}
actor S_Archivist_Alt_P3 : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 A_PlaySound("weapon/crackermine", 1)
      TNT1 A 0 A_FireCustomMissile("S_YeOld_CopyArcaneBomb", 0, 0, 8, 0)
      TNT1 A 0 ThrustThingZ(0, 14*4, 0, 0)
      //TNT1 A 0 A_PlaySound("weapon/firestorm",1)
      //TNT1 A 0 A_FireCustomMissile("S_YeOld_ArcaneFireSpreader",0,0,8,0)
      goto Ammo
    }
}
actor S_Archivist_Alt_P4 : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 A_PlaySound("weapon/timestopper", 1)
      TNT1 A 0 A_FireCustomMissile("S_YeOld_DLVRipperingShot", 0, 0, 8, 0)//DLVRipperingShot
      TNT1 A 0 A_Recoil(40)
      TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
      goto Ammo
    }
}
actor S_Archivist_Alt_P5 : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
      TNT1 A 0 A_Recoil(-70)
      goto Ammo
    }
}
actor S_Archivist_Alt_P5b : S_Archivist_Alt_P0 {
    States {
     Pickup:
      TNT1 A 0 A_FireCustomMissile("S_YeOld_BetaRaidMine_H", 0, 0, 0, 0)
      TNT1 A 0 A_PlaySound("weapon/topspin", 1)
      stop
    }
}

actor S_Archivist_FireEnd_P : CustomInventory {
    States {
     Pickup:
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 5, 2)
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag1", 1)
      stop
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag1", 4)
      stop
    }
}
actor S_Archivist_AltFireEnd_P : CustomInventory {
    States {
     Pickup:
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 5, 2)
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", 1)
      stop
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag2", 4)
      stop
     A_Random:
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 5, "A5")
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 4, "A4")
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 3, "A3")
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 2, "A2")
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag2", 1, "A1")
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 5))
      stop
     A1:
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 4))
      stop
     A2:
      TNT1 A 0 A_Jump(192, 2)
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag2", 1)
      stop
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 3))
      stop
     A3:
      TNT1 A 0 A_Jump(256, 1, 2)
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag2", random(1, 2))
      stop
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 2))
      stop
     A4:
      TNT1 A 0 A_Jump(64, 2)
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag2", random(1, 3))
      stop
      TNT1 A 0 A_GiveInventory("S_ArchivistFlag2", 1)
      stop
     A5:
      TNT1 A 0 A_TakeInventory("S_ArchivistFlag2", random(1, 4))
      stop
    }
}


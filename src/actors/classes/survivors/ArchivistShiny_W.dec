// TODO: add reload as switching patterns

actor ArchivistShiny_W_ScriptBar : ScriptBar {}
actor ArchivistShiny_W : BaseMM8BDMWep_UH {
    Tag "$TAG_S_Archivist_W"
    //Weapon.AmmoUse 100
    Inventory.Pickupmessage "$PU_49_A"
    Obituary "$OB_49W1"
    weapon.ammotype "RustyEnergyAmmo"
    +WEAPON.NOAUTOAIM
    //+WEAPON.ALT_USES_BOTH
    States {
     Spawn:
      7H49 [ 6
      loop

     Deselect:
      7H49 A 0
      goto DeselectSwap
     Select:
      7H49 A 0
      goto SelectSwap

     Ready:
      7H49 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", ARCHIVIST_SDYE, 2)
      7H49 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
      7H49 A 0 A_GiveInventory("S_ArchivistFlag1", random(1, 4))
      7H49 A 0 A_GiveInventory("S_ArchivistFlag2", random(1, 4))
      goto Ready2+6//15
     Ready2:
      7H49 DEFGHIAJKLMMLKJAIHGFED 4 A_GiveInventory("S_Archivist_WepReady_P")
      loop

     Fire:
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag1", 2, 1)
      goto Fire1
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag1", 3, 1)
      goto Fire2
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag1", 4, 1)
      goto Fire3
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag1", 5, 1)
      goto Fire4
      7H49 A 0
      goto Fire5

     Fire1:
      7H49 C 5 A_GiveInventory("S_Archivist_Fire_P1")
      7H49 B 5
      7H49 A 7
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 8-4*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
      goto Fire_ReFire+2
      7H49 A 0 A_Refire("Fire1")
      goto FireEnd

     Fire2:
      7H49 C 4 A_GiveInventory("S_Archivist_Fire_P2")
      7H49 B 4
      7H49 A 18
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 17-9*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
      goto Fire_ReFire+2
      7H49 A 0 A_Refire("Fire2")
      Goto FireEnd

     Fire3:
      7H49 B 5 A_GiveInventory("S_Archivist_Fire_P3")
      7H49 CB 5
      7H49 A 10
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 12-6*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
      goto Fire_ReFire+2
      7H49 A 0 A_Refire("Fire3")
      Goto FireEnd

     Fire4:
      7H49 B 5 A_GiveInventory("S_Archivist_Fire_P4")
      7H49 CBA 2
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 10-5*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
      goto Fire_ReFire+2
      7H49 A 0 A_Refire("Fire4")
      Goto FireEnd

     Fire5:
     Phase1:
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5")
      7H49 C 3
      7H49 A 10
      7H49 A 0 A_Refire("Phase2")
      goto FireEnd
     Phase2:
      //7H49 B 0 A_GiveInventory("Shocked",1)
      7H49 B 2 A_GiveInventory("S_Archivist_Fire_P5b")
      7H49 C 2
      7H49 B 2 A_GiveInventory("S_Archivist_Fire_P5b")
      7H49 C 2
      7H49 B 2 A_GiveInventory("S_Archivist_Fire_P5b")
      7H49 C 2
      7H49 A 10
      7H49 A 0 A_Refire("Phase3")
      goto FireEnd
     Phase3:
      7H49 B 2 ThrustThingZ(0, 42, 0, 0)
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5c")
      7H49 C 3
      7H49 A 10
      7H49 A 0 A_Refire("Phase4")
      goto FireEnd
     Phase4:
      7H49 A 4 A_Recoil(-40)
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5d")
      7H49 C 3
      7H49 A 10
      7H49 A 0 A_Refire("Phase5")
      goto FireEnd
     Phase5:
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5e")
      7H49 C 3
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5ee")
      7H49 C 3
      7H49 B 3 A_GiveInventory("S_Archivist_Fire_P5eee")
      7H49 C 3
      7H49 A 10
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 33-17*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
      goto Fire_ReFire+2
      7H49 A 0 A_Refire("Phase1")
      goto FireEnd

     Fire_ReFire:
      7H49 A 2
      7H49 A 2 A_GiveInventory("S_Archivist_WepReady_P2")
      7H49 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ATTACK, "Fire_ReFire")
      goto FireEnd
     FireEnd:
      7H49 A 2 A_GiveInventory("S_Archivist_FireEnd_P")
      goto Ready2+15
     AltFEnd:
      7H49 A 2 A_GiveInventory("S_Archivist_AltFireEnd_P")
      goto Ready2+6

     Altfire:
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag2", 2, 1)
      goto AltF1
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag2", 3, 1)
      goto AltF2
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag2", 4, 1)
      goto AltF3
      7H49 A 0 A_JumpIfInventory("S_ArchivistFlag2", 5, 1)
      goto AltF4
      7H49 A 0
      goto AltF5
      //7H49 A 1 A_Jump(256, "Deadly", "BetaRaid", "Lucky", "LongJump","ArcaneBombAttack")

      //7H49 A 0 A_JumpIfNoAmmo("AltFEnd")
      //7H49 A 0 A_Refire("AltF1")

     AltF1://LongJump
      7H49 A 10 A_GiveInventory("S_Archivist_Alt_P1")
      Goto AltFEnd
     AltF2://Deadly
      7H49 A 0 A_GiveInventory("S_Archivist_Alt_P2")
      7H49 BC 3
      7H49 A 10
      goto AltFEnd
     AltF3://ArcaneBombAttack
      7H49 A 0 A_GiveInventory("S_Archivist_Alt_P3")
      7H49 BC 2
      7H49 A 10
      //25 for Fire
      goto AltFEnd
     AltF4://Lucky
      7H49 A 0 A_GiveInventory("S_Archivist_Alt_P4")
      7H49 CB 2
      7H49 A 10
      goto AltFEnd
     AltF5://BetaRaid
      7H49 A 1
      7H49 A 0 A_GiveInventory("S_Archivist_Alt_P5")
      7H49 A 0 A_GunFlash("Flash.DLVSpin", 1)
      7H49 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
     DLVSpin:
      7H49 AAAA 10 A_GiveInventory("S_Archivist_Alt_P5b")
      7H49 A 0 A_GunFlash("NoFlash", 1)
      7H49 A 1 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
      7H49 A 20
      goto AltFEnd
     Flash.DLVSpin:
      TNT1 A 2 A_SpawnItemEx("S_YeOld_DLVCounter", 0, 0, 32, 0, 0, 0, 0, 32)
      loop


     BotReady:
      7H49 A 0 A_WeaponReady(12)
      7H49 AA 2 A_Refire("BotFire")
      7H49 A 0 A_GiveInventory("RustyEnergyAmmo", 6)
      goto BotReady

     BotFire:
      7H49 A 0 A_Jump(338, "BotFireX")
      7H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 0, "BotFire2")
      7H49 A 0 A_GiveInventory("RustyEnergyAmmo", random(15, 35))
      7H49 A 0 A_Jump(32, "BotA0")
      7H49 A 0 A_Jump(64, 2)
      goto BotF0
      //7H49 A 0 A_PlaySoundEx("taunt/D_49","Voice")
      7H49 A 0 ThrustThingZ(0, 14*4, 0, 0)
      goto BotF0
     BotFire2:
      7H49 A 0 A_Jump(192, "BotA0")
      7H49 A 0 A_Jump(8, "BotFireX")
      goto BotF0

     BotFireX:
      7H49 A 0 A_ChangeFlag("NOCLIP", 1)
      7H49 A 0 A_PlaySoundEx("taunt/D_49", "Voice")
      7H49 A 0 A_Warp(2, -32, 0, 0, 0, 0, "BotFireX2")
     BotFireX1:
      BEXP B 0 A_PlaySoundEx("taunt/D_49", "Voice")
      BEXP B 0 A_PlaySound("weapon/pshot", 1)
      BEXP B 0 A_FireCustomMissile("S_YeOld_Pikmin555", 0, 0, 8, 0)
      7H49 BCB 5
      7H49 A 15
     BotFireX2:
      7H49 A 5
      goto BotReady

     BotF_E:
      7H49 A 0 A_ReFire(1)
      goto BotReady
      7H49 A 0 A_Jump(4, "BotFireX1")
      7H49 A 0 A_Jump(16, "BotF0")
      7H49 A 0 A_GiveInventory("RustyEnergyAmmo", random(25, 50))
      goto BotReady
     BotA_E:
      7H49 A 0 A_ReFire(1)
      goto BotReady
      7H49 A 0 A_Jump(8, "BotFireX")
      7H49 A 0 A_Jump(32, "BotA0")
      goto BotReady

     BotF0://FireChoose
      7H49 A 1 A_Jump(256, "BotF1", "BotF2", "BotF3", "BotF4", "BotF5")
      7H49 BC 3
      7H49 A 10
      goto BotF_E

     BotA0://AltChoose
      7H49 A 1 A_Jump(256, "BotA1", "BotA2", "BotA3", "BotA4", "BotA5")
      7H49 BC 3
      7H49 A 10
      goto BotA_E

     BotF1:
      7H49 M 17 A_GiveInventory("S_Archivist_Fire_P1")
      goto BotF_E
     BotF2:
      7H49 L 26 A_GiveInventory("S_Archivist_Fire_P2")
      Goto BotF_E
     BotF3:
      7H49 K 25 A_GiveInventory("S_Archivist_Fire_P3")
      Goto BotF_E
     BotF4:
      7H49 JJJ 11 A_GiveInventory("S_Archivist_Fire_P4")
      7H49 J 0 A_GiveInventory("RustyEnergyAmmo", 20)
      Goto BotF_E
     BotF5:
      7H49 I 0 A_Jump(8, "BotFireX")
      7H49 I 16 A_GiveInventory("S_Archivist_Fire_P5")
      7H49 I 0 A_Refire(1)
      goto BotF_E
      7H49 I 0 SetPlayerProperty(0, 0, 1)//Shocked
      7H49 III 4 A_GiveInventory("S_Archivist_Fire_P5b")
      7H49 I 10
      7H49 I 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
      7H49 I 0 A_Refire(1)
      goto BotF_E
      7H49 I 2 ThrustThingZ(0, 42, 0, 0)
      7H49 I 16 A_GiveInventory("S_Archivist_Fire_P5c")
      7H49 I 0 A_Refire(1)
      goto BotF_E
      7H49 I 4 A_Recoil(-40)
      7H49 I 16 A_GiveInventory("S_Archivist_Fire_P5d")
      7H49 I 0 A_Refire(1)
      goto BotF_E
      7H49 I 6 A_GiveInventory("S_Archivist_Fire_P5e")
      7H49 I 6 A_GiveInventory("S_Archivist_Fire_P5ee")
      7H49 I 16 A_GiveInventory("S_Archivist_Fire_P5eee")
      goto BotF_E

     BotA1:
      7H49 D 10 A_GiveInventory("S_Archivist_Alt_P1")
      Goto BotA_E
     BotA2:
      7H49 E 16 A_GiveInventory("S_Archivist_Alt_P2")
      goto BotA_E
     BotA3:
      7H49 F 14 A_GiveInventory("S_Archivist_Alt_P3")
      goto BotA_E
     BotA4:
      7H49 G 14 A_GiveInventory("S_Archivist_Alt_P4")
      goto BotA_E
     BotA5:
      7H49 H 0 A_GiveInventory("S_Archivist_Alt_P5")
      7H49 H 0 A_GunFlash("Flash.DLVSpin", 1)
      7H49 HHHH 10 A_GiveInventory("S_Archivist_Alt_P5b")
      7H49 H 20 A_GunFlash("NoFlash", 1)
      goto BotA_E
    }
}

actor ArchivistShiny_W2_ScriptBar : ScriptBar {}
actor ArchivistShiny_W2 : ArchivistShiny_W {
    States {
    }
}

actor S_ArchivistFlag1 : Inventory {
    inventory.amount 1
    inventory.maxamount 10
}
actor S_ArchivistFlag2 : S_ArchivistFlag1{}

actor S_Archivist_WepReady_P : CustomInventory {
    States {
     Pickup:
      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 100, "Ready3")

      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 5, 9)
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 4, 7)
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 3, 5)
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 2, 3)
      TNT1 A 0 A_JumpIfInventory("S_ArchivistFlag1", 1, 1)

      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 8-4*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
      goto Ready1
      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 17-9*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
      goto Ready1
      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 12-6*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
      goto Ready1
      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 10-5*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
      goto Ready1
      TNT1 A 0 A_JumpIfInventory("RustyEnergyAmmo", 33-17*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
      goto Ready1

     Ready1:
      TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
      goto Ammo
     Ready2:
      TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
      goto Ammo
     Ready3:
      TNT1 A 0 A_WeaponReady
      goto Ammo
     Ammo:
      TNT1 A 0 A_Jump(256, "AmmoJ")
     AmmoJ:
      TNT1 A 0 A_GiveInventory("RustyEnergyAmmo", 6)
      stop
    }
}
actor S_Archivist_WepReady_P2 : S_Archivist_WepReady_P {
    States {
     AmmoJ:
      TNT1 A 0 A_GiveInventory("RustyEnergyAmmo", 4)
      stop
    }
}


actor S_Archivist_Fire_P1 : CustomInventory {
    States {
     Pickup:
      TNT1 A 0 A_PlaySound("misc/mm3explosion", 1)
      TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 4, 1)
      TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 4)
      TNT1 A 0 A_JumpIfInventory("DuoBusterFlag", 1, 3)
      TNT1 A 0 A_GiveInventory("DuoBusterFlag", 1)
      TNT1 A 0 A_FireCustomMissile("S_YeOld_ConfusionSphere", 0, 0, 8, 0)
      stop
      TNT1 A 0 A_TakeInventory("DuoBusterFlag")
      TNT1 A 0 A_FireCustomMissile("S_YeOld_ConfusionSphere2", 0, 0, -8, 0)
      stop
    }
}

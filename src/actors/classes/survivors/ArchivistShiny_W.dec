actor S_YeOld_ConfusionSphere : S_YeOld_49_Base {
    +SKYEXPLODE
    Damage (200)
    radius 13//5
    height 13
    Speed 30
    Args 1
    States {
     Spawn:
      TNT1 A 0
      TNT1 A 1 A_SetAngle(angle+90.0*Args[0])
      TNT1 A 1 A_ChangeVelocity(-10, 0, 0, CVF_RELATIVE)
     SpawnL:
      X_4D G 1 A_ChangeVelocity(20, 0, 0, CVF_RELATIVE)
      X_4D H 1 A_SetAngle(angle-60.0*Args[0])
      X_4D I 1 A_ChangeVelocity(20, 0, 0, CVF_RELATIVE)
      X_4D J 1 A_SetAngle(angle-60.0*Args[0])
      X_4D K 1 A_ChangeVelocity(20, 0, 0, CVF_RELATIVE)
      X_4D J 1 A_SetAngle(angle-60.0*Args[0])
      X_4D I 1 A_ChangeVelocity(20, 0, 0, CVF_RELATIVE)
      X_4D H 1 A_SetAngle(angle-60.0*Args[0])
      loop
     Death:
      X_4D PQSTVY 1
      //X_4D PQSUVY 1
      stop
    }
}
actor S_YeOld_ConfusionSphere2 : S_YeOld_ConfusionSphere {
    Args -1
}




actor HeavyGunnerS_W_ScriptBar : ScriptBar {}

actor HeavyGunnerS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_HeavyGunner_W"
Weapon.AmmoUse 20
Inventory.Pickupmessage "$PU_16"
Obituary "$OB_16W"
weapon.ammotype "MachineEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H16 [ 6
loop

Deselect:
7H16 A 0 A_TakeInventory("HeavyGunnerFlag")
goto DeselectSwap
Select:
7H16 A 0 A_TakeInventory("HeavyGunnerFlag")
goto SelectSwap

Ready:
7H16 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", HEAVYGUNNER_SDYE)
7H16 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",0,"Ready3")
7H16 A 0 A_JumpIfNoAmmo("ReloadWait")
Goto ReloadCheck
Ready3:
7H16 A 2 A_GiveInventory("HeavyGunner_Ready_P")
wait


ReloadTime:
7H16 A 0 A_PlaySound("V_Man/Snd54",1,0.50)
7H16 NOPQ 2 A_GiveInventory("HeavyGunner_Ready_P")
TNT1 A 8 A_GiveInventory("HeavyGunner_Ready_P")
7H16 QPON 2 A_GiveInventory("HeavyGunner_Ready_P")
7H16 A 0 A_PlaySoundEx("V_Man/HP_Pick","Body")
7H16 A 0 A_GiveInventory("MachineEnergyAmmo",400)
goto Ready2

ReloadCheck:
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",40,1) goto ReloadWait+0
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",80,1) goto ReloadWait+1
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",120,1)goto ReloadWait+2
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",160,1)goto ReloadWait+3
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",200,1)goto ReloadWait+4
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",240,1)goto ReloadWait+5
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",280,1)goto ReloadWait+6
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",320,1)goto ReloadWait+7
7H16 A 0 A_JumpIfInventory("MachineEnergyAmmo",360,1)goto ReloadWait+8
7H16 A 0
goto ReloadWait+9

ReloadWait:
7H16 AAAAAAAAAAAA 2 A_GiveInventory("HeavyGunner_Ready_P")
goto ReloadTime

BotFire:
7H16 A 0 A_Jump(32,"BotFire2")
7H16 A 0 A_Jump(32,1)
goto BotFire4
7H16 A 0 A_JumpIfNoAmmo("BotFire3")
7H16 A 0 A_GiveInventory("MachineEnergyAmmo",60)
goto BotFire4
BotFire2:
7H16 A 0 A_JumpIfNoAmmo("BotFire3")
7H16 A 0 A_SpawnItemEx("S_HeavyGunnerBoostBoom",0,0,19,0,0,0,0,1)
7H16 A 0 A_PlaySoundEx("taunt/D_16","Voice")
7H16 A 0 A_PlaySoundEx("V_Man/Boom","Body")
7H16 A 0 ThrustThingZ(0,70,0,0)
7H16 A 0 A_Recoil(-20)
7H16 BCCB 2 A_GiveInventory("MachineEnergyAmmo",10)
goto BotFire4
BotFire3:
7H16 A 0 A_Jump(198,1)
goto BotFire4
7H16 A 0 A_PlaySoundEx("weapon/pursuitfire","Weapon")
7H16 B 0 A_GiveInventory("SelfTotallyFrozen",1)
7H16 BC 2
7H16 CCCCCCCCCC 2 A_GiveInventory("MachineEnergyAmmo",40)
7H16 C 0 A_GiveInventory("SelfTotallyUnfrozen",1)
7H16 BA 2
goto BotFire4
BotFire4:
7H16 A 0 A_Refire("BotFire4a")
goto Ready2
BotFire4a:
7H16 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto Fire2+1
7H16 A 0
goto FireA2+1

Fire:
7H16 A 0 A_JumpIfInventory("DuoBusterFlag",1,"FireA")
7H16 A 0 A_GiveInventory("DuoBusterFlag",1)
7H16 D 0 A_GiveInventory("S_HeavyGunner_Fire_P1")
7H16 B 0 A_ReFire(1)
7H16 DE 2
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P2")
7H16 B 0 A_ReFire(1)
7H16 BH 2
7H16 H 0 A_Refire("Fire2")
Goto FireEndG
Fire2:
7H16 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P1")
7H16 B 0 A_ReFire(1)
7H16 BE 2
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P2")
7H16 B 0 A_ReFire(1)
7H16 BH 2
7H16 H 0 A_Refire("Fire2")
Goto FireEndG
FireA:
7H16 A 0 A_TakeInventory("DuoBusterFlag")
7H16 G 0 A_GiveInventory("S_HeavyGunner_Fire_P2")
7H16 G 0 A_ReFire(1)
7H16 GH 2
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P1")
7H16 B 0 A_ReFire(1)
7H16 BE 2
7H16 E 0 A_Refire("FireA2")
Goto FireEndD
FireA2:
7H16 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P2")
7H16 B 0 A_ReFire(1)
7H16 BH 2
7H16 B 0 A_GiveInventory("S_HeavyGunner_Fire_P1")
7H16 B 0 A_ReFire(1)
7H16 BE 2
7H16 E 0 A_Refire("FireA2")
Goto FireEndD

FireEndD:
7H16 D 2 A_RailWait
Goto Ready2
FireEndG:
7H16 G 2 A_RailWait
Goto Ready2


Flash:
TNT1 A 2 A_TakeInventory("HeavyGunnerFlag",1)
TNT1 A 0 A_JumpIfInventory("HeavyGunnerFlag",1,"Flash")
stop

Altfire:
7H16 R 0 A_GiveInventory("S_HeavyGunner_Alt_P")
7H16 R 0 A_ReFire(1)
7H16 R 2
7H16 S 2 A_GunFlash("Flash",1)
7H16 TU 2 A_RailWait
Goto Ready2
}
}

actor S_HeavyGunner_Fire_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("MachineEnergyAmmo",1,3)
TNT1 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
TNT1 A 0 A_FireCustomMissile("S_HeavyGunnerShotW",random(-2,2),0,8,0)
stop
TNT1 A 0 A_TakeInventory("MachineEnergyAmmo",15,1)
TNT1 A 0 A_TakeInventory("MachineEnergyAmmo",5)
TNT1 A 0 A_PlaySoundEx("V_Man/Pew","Weapon")
TNT1 A 0 A_FireCustomMissile("S_HeavyGunnerShot",random(-2,2),0,8,0)
stop
}
}
actor S_HeavyGunner_Fire_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("VivifyDelay1",1)
TNT1 A 0 A_JumpIfInventory("MachineEnergyAmmo",1,3)
TNT1 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
TNT1 A 0 A_FireCustomMissile("S_HeavyGunnerShotW",random(-2,2),0,-8,0)
stop
TNT1 A 0 A_TakeInventory("MachineEnergyAmmo",15,1)
TNT1 A 0 A_TakeInventory("MachineEnergyAmmo",5)
TNT1 A 0 A_PlaySoundEx("V_Man/Pew","Body")
TNT1 A 0 A_FireCustomMissile("S_HeavyGunnerShot",random(-2,2),0,-8,0)
stop
}
}

actor S_HeavyGunner_Alt_P : HeavyGunner_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_HeavyGunnerBoostBoom",0,0,10,0,0,0,0,1)
goto Thrust
}
}

actor S_HeavyGunnerShot : HeavyGunnerShot
{
Translation "192:192=111:111", "198:198=114:114"
Damage (225)//150
}

actor S_HeavyGunnerShotW : HeavyGunnerShotW
{
Translation "192:192=111:111", "198:198=114:114"
Damage (113)//75
}

actor S_HeavyGunnerBoostBoom : HeavyGunnerBoostBoom
{
Args 600,128,20//400
}

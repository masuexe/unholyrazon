    goto S_PartyBomberPresentBase::Death
  }
}

actor S_PartyBomberPresentBoom2 : PartyBomberPresentBoom1 {
  Args 450, 104, 104  // 300
}

actor S_PartyBomberPresent3 : S_PartyBomberPresentBase {

actor PartyBomberShiny_W_NormalBar : NormalBar {args 216, 41}

actor PartyBomberShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_PartyBomber_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_39"
  Obituary "$OB_39W"
  Weapon.AmmoType "PartyPowerAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H39 [ 6
    loop

   Deselect:
    7H39 A 0
    goto DeselectSwap
   Select:
    7H39 A 0 A_TakeInventory("PartyBomber_F")
    goto SelectSwap

   Ready:
    7H39 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", PARTYBOMBER_SDYE)
    7H39 A 0  // Initial setup: shiny morph hook.
    goto Ready2
   Ready2:
    7H39 A 2 A_GiveInventory("PartyBomber_WepReady_P")
    loop
   Ready4:
    7H39 OAOAOAOAOAOAOAOAOAOAOAOAOAOA 2 A_GiveInventory("PartyBomber_WepReady_P")
    7H39 A 0 A_GiveInventory("PartyPowerAmmo", 42)
    goto Ready2


   Fire:
    7H39 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H39 B 0 A_GiveInventory("S_PartyBomber_Fire_P")
    7H39 BCDEFG 2
    goto Ready2

   BotFire:
    7H39 A 0 A_JumpIfCloser(512, "BotFire2")
    7H39 A 0 A_JumpIfInventory("PartyPowerAmmo", random(100, 125), "AltFire")
    7H39 A 0 A_Jump(24, 1)
    goto Fire+1
    7H39 A 0 A_GiveInventory("PartyPowerAmmo", 25)
    goto Fire+1

   BotFire2:
    7H39 A 0 A_Jump(64, 2)
    7H39 A 0 A_Jump(32, "AltFire2")
    goto Fire+1
    7H39 A 0 A_PlaySoundEx("classes/taunt/partybomber", "Voice")
    7H39 BCDEFG 2 A_Recoil(-3)
    7H39 A 0 A_FireCustomMissile("S_PartyBomberSlamSurprise", 0, 0, 0, 0)
    goto AltStart

   AltFire2:
    7H39 B 2 A_GiveInventory("S_PartyBomber_Alt_P")
    7H39 CDEFG 2
    goto Ready2

   AltFire:
    7H39 A 0 A_JumpIfInventory("PartyPowerAmmo", 2, 1)
    goto StopRightThere

    7H39 I 1 A_PlaySound("weapon/pcharge", 1)
    7H39 I 0 A_ReFire(1)
    goto StopAlt

    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire(1)
    goto StopAlt
    7H39 I 2
    7H39 I 0 A_ReFire(1)
    goto StopAlt
    7H39 H 2
    7H39 H 0 A_ReFire("AltStart")
    goto StopAlt

   StopAlt:
    7H39 A 2 A_PlaySound("misc/NoSnd", 1)
    goto Ready2

   AltStart:
    7H39 E 0 A_PlaySound("misc/NoSnd", 1)
    7H39 E 0 A_PlaySound("PKMN1/Explosion1", 4, 0.65)
    7H39 E 0 A_ChangeVelocity(15 - 7.725 * (!CallACS("core_CheckFooting")), 0, 0, CVF_RELATIVE)
   AltDash:
    7H39 E 0 A_JumpIfInventory("PartyPowerAmmo", 1, 1)
    goto StopRightThere
    7H39 E 1 A_GiveInventory("S_PartyBomber_AltDash_P")
    7H39 E 0 A_JumpIfInventory("DecoyFlag1", 1, "ParteyBlast")
    7H39 E 1 A_ReFire(1)
    goto StopRightThere
    7H39 L 0 A_JumpIfInventory("PartyPowerAmmo", 1, 1)
    goto StopRightThere
    7H39 L 1 A_GiveInventory("S_PartyBomber_AltDash_P")
    7H39 L 0 A_JumpIfInventory("DecoyFlag1", 1, "ParteyBlast")
    7H39 L 1 A_ReFire("AltDash")
    goto StopRightThere
   StopRightThere:
    7H39 F 2 A_TakeInventory("VivifyCycle2")
    7H39 Z 2 A_TakeInventory("DecoyFlag1")
    7H39 MNA 2
    goto Ready2
   ParteyBlast:
    7H39 D 0 A_GiveInventory("S_PartyBomber_AltSlam_P")
    7H39 DCB 2
    7H39 Z 10
    7H39 MN 2
    goto Ready4
  }
}

actor S_PartyBomber_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("PartyPowerAmmo", 6)
    TNT1 A 0 A_JumpIfInventory("PartyBomber_F", 1, "Pickup2")
    TNT1 A 0 A_PlaySound("PartyBomber/TossFire", 1, 0.875)
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, 2)
    TNT1 A 0 A_FireCustomMissile("S_HyperPartyBomb", 0, 0, 8, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("S_HyperPartyBombBot", 0, 0, 8, 0)
    stop
   Pickup2:
    TNT1 A 0 A_PlaySound("Pokemon/Present", 4, 0.75)
    TNT1 A 0 A_GiveInventory("S_PartyBomber_Alt_P")
    TNT1 A 0 A_TakeInventory("PartyBomber_F")
    stop
  }
}
actor S_PartyBomber_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(16, "Pick3")
    TNT1 A 0 A_Jump(77, "Pick2")
    TNT1 A 0 A_Jump(102, "Pick1")
   Pick0:
    TNT1 A 0 A_FireCustomMissile("S_PartyBomberPresent0", 0, 0, 8, 0)
    stop
   Pick1:
    TNT1 A 0 A_FireCustomMissile("S_PartyBomberPresent1", 0, 0, 8, 0)
    stop
   Pick2:
    TNT1 A 0 A_FireCustomMissile("S_PartyBomberPresent2", 0, 0, 8, 0)
    stop
   Pick3:
    TNT1 A 0 A_FireCustomMissile("S_PartyBomberPresent3", 0, 0, 8, 0)
    stop
  }
}

actor S_PartyBomber_AltSlam_P : PartyBomber_AltSlam_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_PartyBomberSlamSurprise")
    goto End
  }
}

actor S_PartyBomber_AltDash_P : PartyBomber_AltDash_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("PartyBomberSlamCheck", 0, 0, -8, velx, vely, velz, 0, 1 + 8)
    goto End
  }
}

actor S_HyperPartyBomb : HyperPartyBomb {
  Translation "192:192=216:216", "198:198=41:41", "199:199=46:46"
  Damage (38)  // 25
  Args 248, 128, 16  // 165
}

actor S_HyperPartyBombBot : S_HyperPartyBomb {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ThrustThingZ(0, 8, 0, 1)
    6P39 A 1
    wait
  }
}

actor S_PartyBomberSlamCheck : PartyBomberSlamCheck {
  Damage (15)  // 10
}

actor S_PartyBomberSlamSurprise : PartyBomberSlamSurprise {
  Translation "192:192=216:216", "198:198=41:41", "199:199=46:46"
  Args 503, 215, 48  // 335
}

actor S_PartyBomberPresentBase : PartyBomberPresentBase {
  Translation "192:192=216:216", "198:198=41:41"
  Damage (15)  // 10
  States {
   Death:
    TNT1 A 0 A_SetGravity(0.0)
   PartyBoom:
    TNT1 A 0 A_SpawnItemEx("S_PB_PresentBoom", 0, 0, 14 + (ceilingz - z <= height) * -28, 0, 0, 0, 0, 1)
    TNT1 AAAAA 4 A_PlaySoundEx("Pokemon/Explosion", "Weapon")
    TNT1 A 6
    TNT1 A 0 A_CountDownArg(0, "NoDeath")
    loop
   NoDeath:
    TNT1 A 2
    stop
  }
}

actor S_PartyBomberPresent0 : S_PartyBomberPresentBase {
  Damage (15)  // 10
  States {
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("Pokemon/Swift", "Weapon")
    TNT1 A 0 A_SpawnItemEx("PartyB_HealFX_H", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 A 2 A_RadiusGive("S_PartyBomberPresentHeal_P", 196, RGF_PLAYERS, 1)
    stop
  }
}

actor S_PartyBomberPresentHeal_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 300)  // 200
    stop
  }
}


actor S_PartyBomberPresent1 : S_PartyBomberPresentBase {
  Args 0
  States {
   Death:
    TNT1 A 0 A_SpawnItemEx("S_PartyBomberPresentBoom1", 0, 0, 10, 0, 0, 0, 0, 1)
    goto S_PartyBomberPresentBase::Death
  }
}

actor S_PartyBomberPresentBoom1 : PartyBomberPresentBoom1 {
  Args 225, 104, 104  // 150
}

actor S_PartyBomberPresent2 : S_PartyBomberPresentBase {
  Args 1
  States {

actor YeOldeDangerCrystal : YeOld_49_Base {
  DamageType "YeFlight"
  Obituary "$OB_49M4"
  +RIPPER
  +FORCEXYBILLBOARD
  +DOOMBOUNCE
  +CANBOUNCEWATER
  +SKYEXPLODE
  BounceFactor 1.0
  WallBounceFactor 1.0
  Damage (random(125, 250))  // 120
  Radius 8
  Height 8
  Speed 50  // 30
  States {
   Spawn:
    X_5H ABCDEAA 4
    X_5H A 0 A_Stop
    X_5H ABCDEAA 4
    goto Death
   Death:
    TNT1 A 0 A_Explode(random(100, 150), 64, 0)
    TNT1 AAAAAAAA 0 A_SpawnItemEx("YeOldeDangerCrystalBit", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), 0, 0)
    TMFX ABCD 2 Bright
    stop
  }
}
actor YeOldeDangerCrystalBit : YeOld_49_Base {
  DamageType "YeFlight"
  Obituary "$OB_49M4"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER
  +SKYEXPLODE
  BounceFactor 1.0
  ReactionTime 4
  Damage (random(45, 75))  // 60
  Radius 20
  Height 20
  Speed 20
  States {
   Spawn:
    X_5H F 0 A_CountDown
    X_5H FGHIJFF 4
    loop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TMFX ABCD 2 Bright
    stop
  }
}

actor YeOldArcaneBomb : YeOld_49_Base {
  DamageType "YeArcane"
  Obituary "$OB_49A4"
  -NOGRAVITY
  +RIPPER
  +FORCEXYBILLBOARD
  +HEXENBOUNCE  // +DOOMBOUNCE
  +CANBOUNCEWATER
  +SKYEXPLODE
  BounceFactor 0.6
  WallBounceFactor 0.6
  ReactionTime 1
  Damage (random(50, 65))
  Radius 8
  Height 8
  Speed 30
  States {
   Spawn:
    6P49 I 0
    6P49 I 0 ThrustThingZ(0, 12, 0, 1)
    6P49 IIIIIIIIIIII 4
    6P49 I 0 A_ChangeFlag("NOGRAVITY", 1)
    6P49 I 0 A_Stop
    6P49 HIHIHI 4
    6P49 H 1 A_CountDown
    wait
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    TNT1 A 0 A_PlaySound("weapon/crackerexplode", 1)
    TNT1 AAAAAAAA 0 A_SpawnItemEx("YeOldHomingArcaneShot", 0, 0, 8, random(-20, 20), random(-20, 20), random(0, 20), random(0, 359), 0)
    TNT1 A 0 A_Explode(random(100, 150), 128, 0)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor YeOldHomingArcaneShot : YeOld_49_Base {
  DamageType "YeArcane"
  Obituary "$OB_49A4"
  +SEEKERMISSILE
  +SCREENSEEKER
  +FORCEXYBILLBOARD
  Damage (random(25, 45))
  ReactionTime 300
  Radius 5
  Height 5
  Speed 40
  States {
   Spawn:
    6P12 A 0
    6P12 AAAAAAAAA 1 A_SpawnItemEx("YeOldArcaneShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn2
   Spawn2:
    6P12 A 1 A_SeekerMissile(2, 10, SMF_LOOK, 50, 10)
    6P12 A 0 A_SpawnItemEx("YeOldArcaneShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    6P12 A 0 A_CountDown
    loop
   Death:
    6P12 CDEF 1
    stop
  }
}

actor YeOldArcaneShotFX : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    TNT1 A 2
    6P12 B 1 A_FadeOut(0.1)
    wait
  }
}

// Spend after an authoritative state jump and sync the remaining ammo.
actor Archivist_W2_AltFire_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 4)
    stop
  }
}

actor Archivist_W_ScriptBar : ScriptBar {}
actor Archivist_W : BaseMM8BDMWep_UH {
  // Weapon.UpSound "misc/gravitywarn"
  Weapon.AmmoUse 0
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_49_A"
  Obituary "$OB_49W1"
  Tag "$TAG_Archivist_W"
  Weapon.AmmoType "RustyEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H49 [ 6
    loop

   Deselect:
    6H49 A 0
    goto DeselectSwap
   Select:
    6H49 A 0
    goto SelectSwap

   Ready:
    6H49 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ARCHIVIST_DYE, CLRF_GRAVITYWARN)
    goto Ready2
   Ready2:
    6H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 25 - 13 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyX")
    6H49 A 2 A_WeaponReady(12)
    6H49 A 0 A_GiveInventory("RustyEnergyAmmo", 3)
    loop
   ReadyX:
    6H49 A 2 A_WeaponReady
    6H49 A 0 A_GiveInventory("RustyEnergyAmmo", 3)
    loop

   Fire:
    6H49 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H49 A 0 A_GiveInventory("Archivist_Fire_P1")
    // 6H49 BCB 3
    // 6H49 A 2
    // 6H49 A 6
    6H49 CB 4
    6H49 A 9
    goto Ready2

   BotFire:
    6H49 A 0 A_Jump(24, "BotSwap")
    6H49 A 0 A_JumpIfInventory("RustyEnergyAmmo", 100 - 50 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "BotFire2")
    6H49 A 0 A_GiveInventory("RustyEnergyAmmo", random(15, 35))
    6H49 A 0 A_Jump(64, "Altfire")
    6H49 A 0 A_Jump(64, 2)
    goto Fire+1
    6H49 A 0 A_PlaySoundEx("classes/taunt/archivist", "Voice")
    6H49 A 0 A_GiveInventory("RustyEnergyAmmo", random(25, 50))
    goto Fire+1
   BotFire2:
    6H49 A 0 A_Jump(196, "Altfire")
    6H49 A 0 A_Jump(24, "BotSwap")
    goto Fire+1

   BotSwap:
    6H49 A 0 A_PlaySoundEx("classes/taunt/archivist", "Voice")
    6H49 A 0 A_GiveInventory("RustyEnergyAmmo", random(25, 50))
    6H49 A 0 A_Jump(198, 1, 2, 3)
    goto AltFire
    6H49 A 0 A_SelectWeapon("Archivist_W2")
    goto BotSwapW
    6H49 A 0 A_SelectWeapon("Archivist_W3")
    goto BotSwapW
    6H49 A 0 A_SelectWeapon("Archivist_W4")
    goto BotSwapW
   BotSwapW:
    6H49 A 1 A_WeaponReady
    wait

   Altfire:
    6H49 A 0 A_GiveInventory("Archivist_Alt_P1")
    // 6H49 BCB 3//2
    // 6H49 A 8//16
    6H49 CB 4
    6H49 A 9
    goto Ready2

   NoAmmo:
    6H49 A 0
    goto Ready2
  }
}

actor Archivist_W2_ScriptBar : ScriptBar {}
actor Archivist_W2 : Archivist_W {
  Inventory.Pickupmessage "$PU_49_B"
  Obituary "$OB_49W2"
  Tag "$TAG_Archivist_W2"
  States {
   Deselect:
    6H49 D 0
    goto DeselectSwap
   Select:
    6H49 D 0
    goto SelectSwap

   Ready:
    6H49 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", ARCHIVIST_DYE, CLRF_GRAVITYWARN)
    goto Ready2
   Ready2:
    6H49 D 0 A_JumpIfInventory("RustyEnergyAmmo", 100 - 50 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyX")
    6H49 D 2 A_WeaponReady(12)
    6H49 D 0 A_GiveInventory("RustyEnergyAmmo", 3)
    loop
   ReadyX:
    6H49 D 2 A_WeaponReady
    6H49 D 0 A_GiveInventory("RustyEnergyAmmo", 3)
    loop

   Fire:
    6H49 D 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H49 D 0 A_GiveInventory("Archivist_Fire_P2")
    // 6H49 EFED 2
    6H49 FEDD 2
    6H49 D 0 A_JumpIfInventory("IsBot", 1, "BotFire1")
    goto Ready2

   BotFire:
    6H49 D 0 A_Jump(40, "BotSwap")
    6H49 D 0 A_Jump(64, "Altfire")
    goto Fire+1
   BotFire1:
    6H49 D 0 A_Jump(32, "BotSwap")
    6H49 D 0 A_Jump(48, 2)
    6H49 D 0 A_GiveInventory("RustyEnergyAmmo", random(35, 85))
    goto Ready2
    6H49 D 0 A_PlaySoundEx("classes/taunt/archivist", "Voice")
    6H49 D 0 A_Jump(48, "Altfire")
    goto Fire+1

   BotSwap:
    6H49 D 0 A_PlaySoundEx("classes/taunt/archivist", "Voice")
    6H49 D 0 A_GiveInventory("RustyEnergyAmmo", random(25, 50))
    6H49 D 0 A_Jump(198, 1, 2, 3)
    goto AltFire
    6H49 D 0 A_SelectWeapon("Archivist_W")
    goto BotSwapW
    6H49 D 0 A_SelectWeapon("Archivist_W3")
    goto BotSwapW
    6H49 D 0 A_SelectWeapon("Archivist_W4")
    goto BotSwapW
   BotSwapW:
    6H49 D 1 A_WeaponReady
    wait

   AltFire:
    6H49 D 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    // ADGJ
    // AGDJ
    6H49 D 0 A_GiveInventory("VivifyDelay10")
    6H49 D 0 A_ReFire(1)
    6H49 D 0 A_PlaySound("weapon/pcharge", 1)
    6H49 AGDJAGDJAGDJAGDJAGDJDDDDD 2 A_GiveInventory("Archivist_W2_AltFire_AmmoSpend_P")
    6H49 D 0 A_GiveInventory("Archivist_Alt_P2")
    6H49 FE 2
    6H49 D 2 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    6H49 D 2  // A_GiveInventory("RustyEnergyAmmo",3)
    6H49 D 0 A_JumpIfInventory("IsBot", 1, "BotFire1")
    goto Ready2
  }
}


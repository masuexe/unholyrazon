actor RustyEnergyAmmo : Ammo {
  Inventory.MaxAmount 100
  +INVENTORY.IGNORESKILL
}

actor Archivist_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 13, 1)
    TNT1 A 0 A_TakeInventory("RustyEnergyAmmo", 12)
    TNT1 A 0 A_FireCustomMissile("YeOldeRedCracker", 0, 0, 8, 0)
    // TNT1 A 0 A_PlaySound("weapon/crackerthrow",1)
    TNT1 A 0 A_PlaySound("weapon/crackerthrow", 1)
    stop
  }
}

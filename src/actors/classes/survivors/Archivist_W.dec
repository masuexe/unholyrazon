actor YeOld_49_Base : BasicProjectile {
  Translation "192:192=87:87", "198:198=146:146"
  DamageType "Archivist"
  Scale 2.5
}

actor YeOldeRedCracker : YeOld_49_Base {
  DamageType "YeCluster"
  Obituary "$OB_49M1"
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  Damage (random(75, 200))
  Radius 7
  Height 8
  Speed 60
  States {
   Spawn:
    6P49 EFG 3
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("SJBOOM1", "Weapon")  // weapon/crackerexplode
    TNT1 A 0 A_Explode(random(175, 325), 148, 0, 0, 8)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor YeOldRamesesGoldenSnakesSpawner : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, 0, 32)
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, 60, 32)
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, -60, 32)
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, 120, 32)
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, -120, 32)
    TNT1 A 0 A_SpawnItemEx("YeOldRamesesGoldenSnakes", 20, 0, 0, 28, 0, 0, 180, 32)
    stop
  }
}
actor YeOldRamesesGoldenSnakes : YeOld_49_Base {
  DamageType "YeDarkness"
  Obituary "$OB_49A1"
  +FLOORHUGGER
  +FORCEXYBILLBOARD
  MaxStepHeight 0
  Gravity 3.0
  Damage (random(150, 225))  // (100)
  Radius 12
  Height 10
  Speed 28
  States {
   Spawn:
    X_3F AB 4
    loop
  }
}


actor YeOldeRipperingShot : BasicWatcher {
  Speed 1
  Args 800
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ScaleVelocity(1.0 / 10.0)
    TNT1 A 0 A_SpawnItemEx("YeOldeRipperingTrail", 0, 0, 0, velx * args[0], vely * args[0], velz * args[0], 0, 40)
    TNT1 AAAAAAAAA 1 A_SpawnItemEx("YeOldeRipperingTrail2", 0, 0, 0, velx * args[0], vely * args[0], velz * args[0], 0, 40)
    stop
  }
}
actor YeOldeRipperingTrail : YeOld_49_Base {
  DamageType "YeLucky"
  Obituary "$OB_49M2"
  // +DONTBLAST
  +RIPPER
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (random(155, 280))  // 350
  Radius 20
  Height 20
  Speed 80
  States {
   Spawn:
    TMFX B 0
    TMFX B 2
    wait
  }
}
actor YeOldeRipperingTrail2 : YeOldeRipperingTrail {
  Damage (random(38, 67))  // (random(75,105))//100
}


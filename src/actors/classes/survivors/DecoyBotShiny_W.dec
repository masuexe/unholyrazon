actor S_Decoy_F_51 : S_AtomicSuplexGrab{Obituary "$OB_50M1"}
actor S_Decoy_F_51A : S_AtomicSuplex{Obituary "$OB_50M1"}

actor S_Decoy_F_51Start_P : CustomInventory {
	States {
	 Pickup:
	  TNT1 A 0 A_TakeInventory("DecoyEnergyAmmo", 21, 1)
	  TNT1 A 0 A_TakeInventory("DecoyEnergyAmmo", 21)
	  TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)

	  TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
	  TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
	  // TNT1 A 0 A_GiveInventory("UsingTimeStopperU",1)
	  TNT1 A 0 A_SetArg(0, angle*256/360)
	  TNT1 A 0 A_SetArg(1, angle)
	  // angle*256/360

	  TNT1 A 0 A_ChangeFlag("THRUSPECIES", 1)
	  TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
	  TNT1 A 0 A_SpawnItemEx("ZangiefGrabFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
	  TNT1 A 0 ACS_NamedExecuteWithResult("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)
	  stop
	}
}
actor S_Decoy_F_51Boom_P : CustomInventory {
	States {
	 Pickup:
	  // Keep this copy of DecoyBot's throw in sync with the current giver table.
	  TNT1 A 0 ACS_NamedExecuteWithResult("uh_ZangiefGiver", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
	  TNT1 A 0 A_SpawnItemEX("S_Decoy_F_51A", 0, 0, 0, 0, 0, 0, 0, 1+8+32)
	  stop
	}
}

	  7H50 C 0 A_SetPitch(348)
	  7H50 C 0 A_SetAngle(Args[1]+36)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-35, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(344)
	  7H50 C 0 A_SetAngle(Args[1]+48)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-46, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(340)
	  7H50 C 0 A_SetAngle(Args[1]+60)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-57, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(336)
	  7H50 C 0 A_SetAngle(Args[1]+72)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-68, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(333)
	  7H50 C 0 A_SetAngle(Args[1]+84)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-79, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(330)
	  7H50 C 0 A_SetAngle(Args[1]+103)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-90, Args[0], 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(336)
	  7H50 C 0 A_SetAngle(Args[1]+129)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-67, Args[0]+128, 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(343)
	  7H50 C 0 A_SetAngle(Args[1]+155)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-44, Args[0]+128, 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(351)
	  7H50 C 0 A_SetAngle(Args[1]+180)
	  7H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-22, Args[0]+128, 100)==0, "Fire51Boom")
	  7H50 C 0 A_SetPitch(0)
	 Fire51Boom:
	  7H50 C 0 A_GiveInventory("Decoy_F_51Boom_P")
	  7H50 X 2  // A_GiveInventory("VivifyDelay4",1)
	  7H50 CX 2
	  7H50 C 2 A_GiveInventory("Decoy_F_51End_P")
	  7H50 BA 2
	  goto Ready2
	}

actor DecoyShinyCopy_20_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_20_W"
	States {
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 B 2 OffSet(-2, 30)A_GiveInventory("VivifyFlag1")
	  7H50 B 0 A_JumpIfInventory("IsBot", 1, "Fire20Bot")
	 Fire20H:
	  7H50 X 1 OffSet(-2, 30)A_GiveInventory("S_DecoyB_F_P20", 1)
	  7H50 C 2 OffSet(-3, 30)
	  7H50 C 0 A_ReFire(1)
	  goto Fire20End
	  7H50 X 1 OffSet(-2, 31)A_GiveInventory("S_DecoyB_F_P20", 1)
	  7H50 C 2 OffSet(-3, 31)
	  7H50 C 0 A_ReFire(1)
	  goto Fire20End
	  7H50 X 1 OffSet(-2, 30)A_GiveInventory("S_DecoyB_F_P20", 1)
	  7H50 C 2 OffSet(-2, 31)
	  7H50 C 0 A_ReFire(1)
	  goto Fire20End
	  7H50 X 1 OffSet(-3, 30)A_GiveInventory("S_DecoyB_F_P20", 1)
	  7H50 C 2 OffSet(-3, 31)
	  7H50 C 0 A_ReFire("Fire20H")
	  goto Fire20End
	 Fire20End:
	  7H50 B 2 OffSet(-2, 30)A_TakeInventory("VivifyFlag1")
	  7H50 A 4 A_WeaponReady(2+4+8)
	  Goto Ready2
	 Fire20Bot:
	  7H50 X 1 A_GiveInventory("S_DecoyB_F_P20", 1)
	  7H50 C 2 A_Jump(1, "Fire20End")
	  7H50 C 0 A_ReFire(1)
	  goto Fire20End
	  7H50 C 0 A_JumpIfCloser(512, "Fire20Bot")
	  goto Fire20End
	}
}


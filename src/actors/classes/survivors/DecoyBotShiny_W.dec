// Shiny DecoyBot dynamically holds one registered copy weapon at a time.
// All built-in and addon copies inherit this base; only Fire is per-copy.
actor DecoyBotShinyCycleBase_W : BaseMM8BDMWep_UH
{
	Weapon.SlotNumber 1
	Weapon.AmmoUse 0
	Weapon.AmmoGive 0
	weapon.ammotype "DecoyEnergyAmmo"
	weapon.ammotype2 "FlukyNumberAmmo"
	Weapon.UpSound ""
	inventory.icon "C_I_50A"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	States
	{
	Spawn:
		7H50 [ 6
		loop
	Deselect:
		TNT1 A 0 Offset(1, 128) A_Lower
	Select:
		7H50 A 0 A_JumpIfInventory("UH_SilentSelect_F",1,"SilentSelect")
		goto SelectSwap
	SilentSelect:
		7H50 A 0 A_StopSound(CHAN_WEAPON)
		7H50 A 0 A_TakeInventory("UH_SilentSelect_F",1)
		7H50 A 0 A_TakeInventory("NoWeaponSwitchSound",1)
		7H50 A 0 A_TakeInventory("DecoyBotShiny_W",1)
		7H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_SDYE, CLRF_GRAVITYWARN)
		7H50 A 0 A_WeaponReady(14)
		goto Ready2
	Ready:
		7H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_SDYE, CLRF_GRAVITYWARN)
		goto Ready2
	Ready2:
		7H50 A 2 A_GiveInventory("S_DecoyBot_WepReady_P")
		7H50 A 0 A_GiveInventory("DecoyEnergyAmmo",3)
		7H50 A 0 A_GiveInventory("FlukyNumberAmmo",1)
		loop
	AltFire:
		7H50 D 0 ACS_NamedExecuteWithResult("uh_DecoyBotShinyAdvance")
		7H50 A 1
		goto Ready2
	BotFire:
		"####" A 0 A_JumpIfInventory("DecoyBotFlagBot",30,"BotFire1")
		"####" A 0 A_Jump(16,"BotFire2")
		"####" A 0 A_GiveInventory("DecoyBotFlagBot",1)
		"####" A 0 A_GiveInventory("DecoyEnergyAmmo",random(1,49))
		"####" A 0 A_Jump(256, "FireGo")
	BotFire1:
		"####" A 0 A_Jump(96,"BotFire2")
		"####" A 0 A_GiveInventory("DecoyEnergyAmmo",random(40,100))
		"####" A 0 A_Jump(256, "FireGo")
	BotFire2:
		"####" A 0 A_TakeInventory("DecoyBotFlagBot",30)
		"####" A 0 A_GiveInventory("DecoyEnergyAmmo",200)
		"####" A 0 A_PlaySoundEx("taunt/D_50","Voice")
		goto AltFire
	Fire:
		7H50 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
	FireGo:
		7H50 A 1 A_WeaponReady
		wait
	}
}


actor DecoyShinyCopy_60_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_60_W"
	States {
	 Ready2:
	  7H50 A 0 A_GiveInventory("DecoyEnergyAmmo", 3)
	  7H50 A 0 A_GiveInventory("FlukyNumberAmmo", 1)
	  7H50 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, 2)
	  7H50 A 2 A_WeaponReady(WRF_NOSECONDARY)
	  goto Ready2
	  7H50 A 2 A_WeaponReady
	  goto Ready2
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 A 0 A_JumpIfInventory("CrystrapShotAlive", 1, "Detonate")
	  7H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 100 - 50*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ShootCore")
	  goto ShootBit
	 ShootCore:
	  7H50 C 2 A_GiveInventory("S_DecoyB_F_P60", 1)
	  7H50 B 3
	  7H50 A 5
	  Goto Ready2
	 ShootBit:
	  7H50 C 2 A_GiveInventory("S_DecoyB_F_P60B", 1)
	  7H50 B 3
	  7H50 A 5
	  Goto Ready2
	 Detonate:
	  7H50 D 0 A_PlaySoundEx("Pokemon/Detect", "Weapon")
	  7H50 D 0 A_GiveInventory("CrystrapBoomFlag")
	  7H50 D 2 Offset(0, 38)
	  7H50 A 2 Offset(0, 35)
	  7H50 A 4 Offset(0, 32)
	  Goto Ready2
	}
}

actor DecoyBotShiny_W_ScriptBar : ScriptBar {}

// MorphWeapon enters this controller once, then Ready equips the registered
// shiny partner matching DecoyBotFlag1. A failed registration keeps it usable.
actor DecoyBotShiny_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_S_DecoyBot_W"
	States {
	 Ready:
	  7H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_SDYE, CLRF_GRAVITYWARN)
	  7H50 A 0 ACS_NamedExecuteWithResult("uh_DecoyBotShinyStart")
	  7H50 A 1 A_WeaponReady
	  wait
	}
}

// Ported from Unholy Razon 3 S_DecoyBot_W and adapted to v4 APIs.
actor S_DecoyBotAlt_P : CustomInventory {
	States {
	 Pickup:
	  TNT1 A 0 A_PlaySound("misc/gravitywarn", 1)
	  TNT1 A 0 A_GiveInventory("DecoyBotFlagCheck_P")
	  stop
	}
}

actor S_DecoyBotFlagBase_P : CustomInventory {
  States {
   Ready0:
    TNT1 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, "Ready2")
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
    stop
   Ready1:
    TNT1 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
   Ready2:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    stop
   Ready3:
    TNT1 A 0 A_WeaponReady
    stop
  }
}

actor S_DecoyBotFlag_P : S_DecoyBotFlagBase_P {

actor S_Decoy_F_59A : BasicProjectile {
  damagetype "Eden"
  Obituary "$OB_50M1"
  -NOGRAVITY
  +SKYEXPLODE
  Damage (random(36, 45))
  radius 8
  height 8
  scale 2.2
  gravity 0.22
  Speed 40
  States {
   Spawn:
    ISTR F 1
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("Isaac/splatter", "Weapon")
    ISBR ABCDEFGHIJKLMNO 1
    stop
  }
}

actor S_Decoy_F_59B : BasicProjectile {

actor DecoyShinyCopy_52_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_52_W"
	States {
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 Fire52H1:
	  7H50 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "Fire52H2")
	  7H50 A 1 OffSet(2, 34)  // A_GiveInventory("AmberChargeFlag",1+CallACS("uh_checkrune", RUNE_RAGE))
	  7H50 A 0  // A_ReFire("Fire52H1")
	  goto Fire52A
	 Fire52H2:
	  7H50 B 0 A_JumpIfInventory("AmberChargeFlag", 0, "Fire52H3")
	  7H50 B 1 OffSet(4, 37)A_GiveInventory("AmberChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
	  7H50 B 0 A_ReFire("Fire52H2")
	  goto Fire52A
	 Fire52H3:
	  7H50 C 1 OffSet(6, 40)ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE2, 1)
	  7H50 C 0 A_ReFire(1)
	  goto Fire52A
	  7H50 C 1 OffSet(6, 41)ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_SDYE, 1)
	  7H50 C 0 A_ReFire("Fire52H3")
	  goto Fire52A
	 Fire52Bot:
	  7H50 C 0 A_GiveInventory("AmberChargeFlag", 1+random(0, 2)*35)
	  7H50 C random(2, 8)
	  7H50 C 0 A_ReFire("Fire52A")
	  goto Fire52A
	 Fire52A:
	  7H50 C 1 OffSet(-12, 20)A_GiveInventory("S_DecoyB_F_P52", 1)
	  7H50 C 1 OffSet(-39, 23)
	  7H50 C 1 OffSet(-82, 32)
	  7H50 C 1 OffSet(-131, 41)
	  7H50 B 1 OffSet(-164, 47)
	  7H50 B 1 OffSet(-208, 55)
	  7H50 B 1 OffSet(-256, 69)
	  7H50 B 1 OffSet(-304, 86)
	  TNT1 A 4
	  TNT1 AAAAAAAAA 2 A_ReFire("Fire52B")
	  TNT1 A 0 A_TakeInventory("AmberChargeFlag")
	  7H50 A 2 OffSet(-48, 80)A_ReFire("FireGo")
	  7H50 A 2 OffSet(-32, 66)A_ReFire("FireGo")
	  7H50 A 2 OffSet(-19, 55)A_ReFire("FireGo")
	  7H50 A 2 OffSet(-10, 46)A_ReFire("FireGo")
	  7H50 A 2 OffSet(-3, 39)A_ReFire("FireGo")
	  Goto Ready2
	 Fire52B:
	  7H50 C 1 OffSet(-178, 54)A_GiveInventory("S_DecoyB_F_P52B", 1)
	  7H50 C 1 OffSet(-128, 45)
	  7H50 C 1 OffSet(-79, 34)A_TakeInventory("AmberChargeFlag")
	  7H50 B 1 OffSet(-30, 25)
	  7H50 B 1 OffSet(19, 19)
	  7H50 B 1 OffSet(72, 21)
	  7H50 B 1 OffSet(129, 33)
	  TNT1 A 8
	  7H50 A 2 OffSet(80, 75)
	  7H50 A 2 OffSet(54, 58)
	  7H50 A 2 OffSet(32, 45)
	  7H50 A 2 OffSet(16, 39)
	  7H50 A 2 OffSet(6, 35)
	  Goto Ready2
	}
}


7H50 O 2 Offset(12,25)
7H50 O 2 Offset(-7,70)
Goto Ready2
}
}

actor DecoyShinyCopy_56_W : DecoyBotShinyCycleBase_W
{
States
{
Fire:
7H50 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
FireGo:
7H50 C 5 A_GiveInventory("S_DecoyB_F_P56")
7H50 B 5
7H50 A 4
Goto Ready2
}
}

actor DecoyShinyCopy_57_W : DecoyBotShinyCycleBase_W
{
States
{
Fire:
7H50 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
FireGo:
7H50 B 2 A_JumpIfInventory("IsBot",1,"Fire57Bot")
7H50 B 0 A_ReFire(1)
Goto Fire57Det
7H50 B 2 A_RailWait
7H50 B 0 A_ReFire(1)
Goto Fire57Det
7H50 B 2 A_RailWait
7H50 B 0 A_ReFire("Fire57Toss")
Goto Fire57Det
Fire57Toss:
7H50 C 3
7H50 B 6 A_GiveInventory("S_DecoyB_F_P57")
7H50 A 3
7H50 A 2 A_ReFire(2)
7H50 A 8
Goto Ready2
7H50 A 8 A_JumpIfInventory("DecoyEnergyAmmo",20,"Fire57Toss")
Goto Ready2
Fire57Det:
7H50 X 1 offset(-2,36)A_GiveInventory("S_DecoyB_F_P57D",1)
Goto Ready2
Fire57Bot:
7H50 C 3 A_GiveInventory("S_DecoyB_F_P57")
7H50 B 6
7H50 A 5
7H50 A 10 A_ReFire(1)
Goto Ready2
7H50 A 10 A_Jump(64,"Fire57Det")
Goto Ready2
}
}

actor DecoyShinyCopy_58_W : DecoyBotShinyCycleBase_W
{
States
{
Fire:
7H50 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
FireGo:

6H58 Y 0 A_GiveInventory("Decoy_F_58_P1")
6H58 Y 0 A_ReFire(1)
6H58 Y 3
6H58 Y 2 A_TakeInventory("KickChampFlag")
6H58 Z 1 A_GiveInventory("Decoy_F_58_P2")
goto Fire58Kick//+2
Fire58Kick:
6H58 Z 1 A_GiveInventory("S_DecoyB_F_P58")
6H58 Z 0 A_JumpIfInventory("KickChampFlag",1,"Fire58Hit")
6H58 Z 0 A_CheckFloor("Fire58Land")
loop
Fire58Land:
6H58 Y 4 A_GiveInventory("Decoy_F_58_P3")
Goto Ready2
Fire58Hit:
6H58 Y 8 A_GiveInventory("KickChamp_AltRecoil_P")
goto Fire58Land

}
}

actor DecoyBotShiny_W_ScriptBar : ScriptBar {}

// MorphWeapon enters this controller once, then Ready equips the registered
// shiny partner matching DecoyBotFlag1. A failed registration keeps it usable.
actor DecoyBotShiny_W : DecoyBotShinyCycleBase_W
{
	Tag "$TAG_S_DecoyBot_W"
	States
	{
	Ready:
		7H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_SDYE, CLRF_GRAVITYWARN)
		7H50 A 0 ACS_NamedExecuteWithResult("uh_DecoyBotShinyStart")
		7H50 A 1 A_WeaponReady
		wait
	}
}

// Ported from Unholy Razon 3 S_DecoyBot_W and adapted to v4 APIs.
actor S_DecoyBotAlt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("misc/gravitywarn",1)
TNT1 A 0 A_GiveInventory("DecoyBotFlagCheck_P")
stop
}
}


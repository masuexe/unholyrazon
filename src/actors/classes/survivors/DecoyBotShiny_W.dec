		TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, 2)
		TNT1 A 0 A_FireCustomMissile("S_Decoy_F_13AAA", 0, 0, 8, 0)
		stop
		TNT1 A 0 A_FireCustomMissile("S_Decoy_F_13BBB", 0, 0, 8, 0)
		stop}}

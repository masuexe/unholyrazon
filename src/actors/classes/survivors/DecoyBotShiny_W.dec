actor DecoyShinyCopy_50_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_50_W"
	States {
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 200, 1)
	  goto NoAmmo
	  7H50 A 0 A_PlayWeaponSound("S3_K/LaserCharge")
	  7H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 200, "Hold50")
	  goto Fire50Check
	 Fire50Check:
	  7H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 115, "Fire50X")
	  7H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 1, "Fire50XX")
	  goto Fire50XXX
	 Fire50X:
	  7H50 A 0 A_TakeInventory("DecoyEnergyAmmo", 25)
	  7H50 A 0 A_FireCustomMissile("S_Decoy_F_50C", 0, 0, 8, 0)
	  7H50 A 0 A_PlayWeaponSound("S3_K/BasicPew")
	  7H50 CBAA 3
	  Goto Ready2
	 Fire50XX:
	  7H50 A 0 A_TakeInventory("DecoyEnergyAmmo", 25)
	  7H50 A 0 A_FireCustomMissile("S_Decoy_F_50B", 0, 0, 8, 0)
	  7H50 A 0 A_PlayWeaponSound("S3_K/FireBall")
	  7H50 CBAAAA 3
	  Goto Ready2
	 Fire50XXX:
	  7H50 A 0 A_TakeInventory("DecoyEnergyAmmo", 25)
	  7H50 A 0 A_FireCustomMissile("S_Decoy_F_50A", 0, 0, 8, 0)
	  7H50 A 0 A_PlayWeaponSound("S3_K/LaserFire")
	  7H50 CBAAAAAA 3
	  Goto Ready2
	 BotFire50:
	  7H50 C 0 A_JumpIfInventory("DecoyEnergyAmmo", 115, 5)
	  7H50 C 0 A_JumpIfInventory("DecoyEnergyAmmo", 1, 2)
	  7H50 C 0 A_Jump(64, "Fire50Check")
	  goto Hold50+1
	  7H50 C 0 A_Jump(16, "Fire50Check")
	  7H50 C 0 A_TakeInventory("DecoyEnergyAmmo", random(1, 4))
	  goto Hold50+1
	  7H50 C 0 A_Jump(3, "Fire50Check")
	  7H50 C 0 A_TakeInventory("DecoyEnergyAmmo", random(1, 5))
	  goto Hold50+1
	 Hold50:
	  7H50 C 0 A_JumpIfInventory("IsBot", 1, "BotFire50")
	  7H50 C 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Hold50R")
	  7H50 C 1 A_TakeInventory("DecoyEnergyAmmo", 2)
	  7H50 C 0 A_JumpIfInventory("DecoyEnergyAmmo", 1, 3)
	  7H50 CC 0 A_SpawnItemEx("LuckyChargingGFX", random(-32, 32), random(-32, 32), 0, momx, momy, 20, 0, 9)
	  7H50 C 0 A_ReFire("Hold50")
	  goto Fire50Check
	 Hold50R:
	  7H50 C 0 A_JumpIfInventory("IsBot", 1, "BotFire50")
	  7H50 C 1 A_TakeInventory("DecoyEnergyAmmo", 4)
	  7H50 C 0 A_JumpIfInventory("DecoyEnergyAmmo", 1, 5)
	  7H50 CCCC 0 A_SpawnItemEx("LuckyChargingGFX", random(-32, 32), random(-32, 32), 0, momx, momy, 20, 0, 9)
	  7H50 C 0 A_ReFire("Hold50R")
	  goto Fire50Check
	}
}


actor DecoyShinyCopy_57_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_57_W"
	States {
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 B 2 A_JumpIfInventory("IsBot", 1, "Fire57Bot")
	  7H50 B 0 A_ReFire(1)
	  Goto Fire57Det
	  7H50 B 2 A_RailWait
	  7H50 B 0 A_ReFire(1)
	  Goto Fire57Det
	  7H50 B 2 A_RailWait
	  7H50 B 0 A_ReFire("Fire57Toss")
	  Goto Fire57Det
	 Fire57Toss:
	  7H50 C 3
	  7H50 B 6 A_GiveInventory("S_DecoyB_F_P57", 1)
	  7H50 A 3
	  7H50 A 2 A_ReFire(2)
	  7H50 A 8
	  Goto Ready2
	  7H50 A 8 A_JumpIfInventory("DecoyEnergyAmmo", 20, "Fire57Toss")
	  Goto Ready2
	 Fire57Det:
	  7H50 X 1 offset(-2, 36)A_GiveInventory("S_DecoyB_F_P57D", 1)
	  Goto Ready2
	 Fire57Bot:
	  7H50 C 3 A_GiveInventory("S_DecoyB_F_P57", 1)
	  7H50 B 6
	  7H50 A 5
	  7H50 A 10 A_ReFire(1)
	  Goto Ready2
	  7H50 A 10 A_Jump(64, "Fire57Det")
	  Goto Ready2
	}
}

actor DecoyShinyCopy_58_W : DecoyBotShinyCycleBase_W {

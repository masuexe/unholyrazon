actor DecoyShinyCopy_08_W : DecoyBotShinyCycleBase_W {
	Tag "$TAG_DecoyShinyCopy_08_W"
	States {
	 Fire:
	  7H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
	 FireGo:
	  7H50 C 1 Offset(16, 56)A_GiveInventory("S_DecoyB_F_P08", 1)
	  7H50 C 3 Offset(34, 82)
	  7H50 B 2 Offset(19, 66)
	  7H50 B 2 Offset(11, 53)
	  7H50 A 0 Offset(5, 42)
	 FireH08:
	  7H50 V 1 A_RailWait
	  7H50 V 0 A_ReFire(1)
	  goto Fire08End
	  7H50 V 1 A_RailWait
	  7H50 V 0 A_ReFire(1)
	  goto Fire08End
	  7H50 A 1 A_RailWait
	  7H50 A 0 A_ReFire(1)
	  goto Fire08End
	  7H50 A 1 A_RailWait
	  7H50 A 0 A_ReFire("FireH08")
	  goto Fire08End
	 Fire08End:
	  7H50 X 2 A_GiveInventory("TacticalBomberFlag")
	  7H50 BV 2
	  Goto Ready2
	}
}


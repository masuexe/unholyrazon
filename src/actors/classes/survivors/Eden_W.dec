actor Eden_W_ScriptBar : ScriptBar {}
actor Eden_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_03"
  Obituary "$OB_59W"
  Tag "$TAG_Eden_W"
  Weapon.AmmoType "EdenToyAmmo"

  States {
   Spawn:
    6H59 [ 6
    loop

   Deselect:
    6H59 A 0
    goto DeselectSwap
   Select:
    6H59 A 0
    goto SelectSwap

   Ready:
    6H59 A 0 ACS_NamedExecuteAlways("rz_InitEdenProperties")
    6H59 A 0 ACS_NamedExecuteWithResult("rz_EdenWeaponColor")
    goto Ready2

   Ready2:
    TNT1 A 0 A_JumpIfInventory("BobHeadFlag", 1, "Ready2BobHead")
    6H59 A 2 A_GiveInventory("Eden_W_Ready_P")
    loop
   Ready2BobHead:
    TNT1 A 2 A_GiveInventory("Eden_W_Ready_P")
    goto Ready2

   Fire:
    6H59 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadThrowCheck")
    // Keep this as A_JumpIf: an unqualified state parameter resolves against
    // the concrete weapon class, so Eden subclasses can override the hook.
    6H59 A 1 A_JumpIf(true, "EdenMainFire")
    wait
   EdenMainFire:
    6H59 A 0 A_GiveInventory("EdenFire_P")
    goto CDCheck
   CDCheck:
    6H59 A 0 A_GiveInventory("EdenTearCoolDown", CallACS("rz_GetEdenAttr", 0, 1, 0) * (2 - CallACS("uh_checkrune", RUNE_RAGE)) / 2)
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 6, "Cooldown6")
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 4, "Cooldown4")
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 2, "Cooldown2")
    goto Cooldown1
   Cooldown6:
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2
   Cooldown4:
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 36)
    goto Ready2
   Cooldown2:
    6H59 A 2 Offset(0, 44)
    goto Ready2
   Cooldown1:
    6H59 A 1 Offset(0, 44)
    goto Ready2

   BobHeadThrowCheck:
    6H59 A 0 A_JumpIfInventory("BobHeadLeft_F", 1, "BobHeadThrowLeft")
    6H59 A 0
    goto BobHeadThrowRight
   BobHeadThrowRight:
    6H59 A 0 A_PlaySoundEx("weapon/deepdiggerthrow", "Weapon")
    6H59 A 0 A_TakeInventory("BobHeadFlag", 1)
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadRightHasLeft")
    6H59 A 0 A_FireCustomMissile("BobPoisonBomb", 0, 0, 10, -4)
    6H59 I 1
    6H59 I 1 Offset(-70, 74)
    6H59 I 1 Offset(-121, 114)
    TNT1 A 0 A_WeaponReady(14)
    6H59 J 1
    6H59 J 1 Offset(-25, 56)
    6H59 J 1 Offset(-33, 84)
    TNT1 A 4
    goto Ready2
   BobHeadRightHasLeft:
    6H59 A 0 A_GiveInventory("BobHeadLeft_F")
    6H59 A 0 A_FireCustomMissile("BobPoisonBomb", 0, 0, 10, -4)
    6H59 I 1
    6H59 I 1 Offset(-70, 74)
    6H59 I 1 Offset(-121, 114)
    TNT1 A 0 A_WeaponReady(14)
    6H59 J 1
    6H59 J 1 Offset(-25, 56)
    6H59 J 1 Offset(-33, 84)
    TNT1 A 4
    goto Ready2
   BobHeadThrowLeft:
    6H59 A 0 A_PlaySoundEx("weapon/deepdiggerthrow", "Weapon")
    6H59 A 0 A_TakeInventory("BobHeadFlag", 1)
    6H59 A 0 A_TakeInventory("BobHeadLeft_F")
    6H59 A 0 A_FireCustomMissile("BobPoisonBomb", 0, 0, -10, 4)
    6H59 K 1
    6H59 K 1 Offset(70, 74)
    6H59 K 1 Offset(121, 114)
    TNT1 A 0 A_WeaponReady(14)
    6H59 L 1
    6H59 L 1 Offset(25, 56)
    6H59 L 1 Offset(33, 84)
    TNT1 A 4
    goto Ready2

   BotFire:
    6H59 A 0 A_Jump(32, "AltFire")
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadThrowCheck")
    6H59 A 1 A_JumpIf(true, "EdenBotMainFire")
    wait
   EdenBotMainFire:
    6H59 A 0 A_GiveInventory("EdenFire_P")
    6H59 A 0 A_GiveInventory("EdenTearCoolDown", CallACS("rz_GetEdenAttr", 0, 1, 0))
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2

   AltFire:
    6H59 A 0 A_JumpIf(CallACS("rz_EdenCanUseAlt") == 0, "Ready2")
    6H59 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "AltUse")
    6H59 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "AltPay")
    goto Ready2
   AltPay:
    6H59 A 0 A_GiveInventory("Eden_W_AltPay_AmmoSpend_P")
   AltUse:
    6H59 A 0 A_JumpIfInventory("C42Flag", 1, "BobHeadAltUse")
    6H59 A 0 A_GiveInventory("EdenAltFire_P")
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    6H59 A 2 Offset(0, 32)
    goto Ready2
   BobHeadAltUse:
    6H59 A 0 A_PlaySoundEx("weapon/superarmuse", "Weapon")
    // Check before EdenAltFire_P adds the new bomb: without Car Battery,
    // zero means a right-hand load and one means a left-hand load.
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadAltUseLeft")
    6H59 A 0 A_JumpIfInventory("C356Flag", 1, "BobHeadAltUseBattery")
    goto BobHeadAltUseRight
   BobHeadAltUseRight:
    6H59 A 0 A_GiveInventory("EdenAltFire_P")
    6H59 A 1 Offset(0, 80)
    TNT1 A 1 A_WeaponReady(14)
    6H59 M 2
    6H59 M 2 Offset(0, -19)
    6H59 M 2 Offset(28, -67)
    goto Ready2
   BobHeadAltUseLeft:
    TNT1 A 0 A_GiveInventory("EdenAltFire_P")
    TNT1 A 1
    TNT1 A 1 A_WeaponReady(14)
    6H59 N 2
    6H59 N 2 Offset(0, -19)
    6H59 N 2 Offset(-28, -67)
    goto Ready2
   BobHeadAltUseBattery:
    6H59 A 0 A_GiveInventory("EdenAltFire_P")
    6H59 A 1 Offset(0, 80)
    TNT1 A 1 A_WeaponReady(14)
    6H59 O 2
    6H59 O 2 Offset(0, -19)
    6H59 P 2 Offset(0, -67)
    goto Ready2
  }
}

actor EdenAttr : Inventory {
  Inventory.MaxAmount 9999
}

actor EdenMaxHealthAttr : EdenAttr {}
actor EdenSpeedAttr : EdenAttr {}
actor EdenHeightAttr : EdenAttr {}
actor EdenTearsAttr : EdenAttr {}  // Fire Rate
actor EdenTearsHUDAttr : EdenAttr {
  Inventory.MaxAmount 300
}
actor EdenDamageAttr : EdenAttr {}
actor EdenRangeAttr : EdenAttr {}
actor EdenShotSpeedAttr : EdenAttr {}
actor EdenLuckAttr : EdenAttr {}

// Initial HUD baseline, captured before starting passives in the same tic.
actor EdenHudBaseSpeed : EdenAttr {}
actor EdenHudBaseHeight : EdenAttr {}
actor EdenHudBaseTears : EdenAttr {}
actor EdenHudBaseDamage : EdenAttr {}
actor EdenHudBaseRange : EdenAttr {}
actor EdenHudBaseShotSpeed : EdenAttr {}
actor EdenHudStartTic : Inventory {
  Inventory.MaxAmount 2147483647
}

actor EdenInitFlag : Once {}

actor EdenTearCoolDown : Inventory {
  Inventory.MaxAmount 9999
}

actor EdenToyAmmo : Ammo {
  Inventory.MaxAmount 300
  +INVENTORY.IGNORESKILL
}

actor Eden_W_Ready_P : CustomInventory {
  States {
   Pickup:
    // Keep the ready policy here so the weapon state only selects its pose.
    // CustomInventory actions run with the player as the action actor, so
    // A_WeaponReady still applies to the currently equipped weapon.
    TNT1 A 0 A_JumpIfInventory("EdenTearCoolDown", 1, "CooldownReady")
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenCanUseAlt") == 0, "PrimaryReady")
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "FullReady")
    TNT1 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "FullReady")

   PrimaryReady:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto ReadyMaintenance

   FullReady:
    TNT1 A 0 A_WeaponReady
    goto ReadyMaintenance

   CooldownReady:
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenCanUseAlt") == 0, "CooldownNoAlt")
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "CooldownAlt")
    TNT1 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "CooldownAlt")

   CooldownNoAlt:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    goto ReadyMaintenance

   CooldownAlt:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    goto ReadyMaintenance

   ReadyMaintenance:
    TNT1 A 0 A_GiveInventory("EdenToyAmmo", 1)
    TNT1 A 0 A_TakeInventory("EdenTearCoolDown", 1)
    stop
  }
}

actor EdenFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("C358Flag", 1, "Dunce")
    TNT1 A 0 A_JumpIfInventory("C678Flag", 1, "CSection")
    TNT1 A 0 A_PlaySoundEx("Isaac/tearfire", "Weapon")
    TNT1 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "RightEye")
    TNT1 A 0 A_FireCustomMissile("EdenTear", 0, 0, -16, 16)
    TNT1 A 0 A_GiveInventory("DuoBusterFlag")
    stop
   RightEye:
    TNT1 A 0 A_FireCustomMissile("EdenTear", 0, 0, 16, 16)
    TNT1 A 0 A_TakeInventory("DuoBusterFlag")
    stop
   CSection:
    TNT1 A 0 A_PlaySoundEx("Isaac/plop", "Weapon")
    TNT1 A 0 A_FireCustomMissile("EdenFetusTear", 0, 0, 0, -8)
    stop
   Dunce:
    TNT1 A 0 A_GiveInventory("EdenFire_Wiz_P")
    stop
  }
}

actor EdenAltFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenUseAlt")
    stop
  }
}

actor ResetEdenAttr_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("EdenMaxHealthAttr")
    TNT1 A 0 A_TakeInventory("EdenSpeedAttr")
    TNT1 A 0 A_TakeInventory("EdenHeightAttr")
    TNT1 A 0 A_TakeInventory("EdenTearsAttr")
    TNT1 A 0 A_TakeInventory("EdenDamageAttr")
    TNT1 A 0 A_TakeInventory("EdenRangeAttr")
    TNT1 A 0 A_TakeInventory("EdenShotSpeedAttr")
    stop
  }
}

#include "actors/classes/survivors/eden/eden_projectiles.dec"
#include "actors/classes/survivors/eden/eden_fx.dec"
#include "actors/classes/survivors/eden/eden_familiars.dec"
#include "actors/classes/survivors/eden/eden_itemlist.dec"
#include "actors/classes/survivors/eden/eden_cleanup.dec"
#include "actors/classes/survivors/eden/Eden678_W.dec"
#include "actors/classes/survivors/eden/Eden118_W.dec"

// Spend after an authoritative state jump and sync the remaining ammo.
actor Eden_W_AltPay_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"))
    stop
  }
}

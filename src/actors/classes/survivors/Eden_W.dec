actor Eden_W_ScriptBar : ScriptBar {}
actor Eden_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_03"
  Obituary "$OB_59W"
  Tag "$TAG_Eden_W"
  weapon.ammotype "EdenToyAmmo"

  States {
   Spawn:
    6H59 [ 6
    loop

   Deselect:
    6H59 A 0
    goto DeselectSwap
   Select:
    6H59 A 0
    goto SelectSwap

   Ready:
    6H59 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", EDEN_DYE)
    6H59 A 0 ACS_NamedExecuteAlways("rz_InitEdenProperties")
    goto Ready2

   Ready2:
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 1, "ReadyX")
    6H59 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2Alt")
    6H59 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "Ready2Alt")
    6H59 A 2 A_WeaponReady(WRF_NOSECONDARY)
    6H59 A 0 A_GiveInventory("Eden_W_Ready_P")
    loop
   Ready2Alt:
    6H59 A 2 A_WeaponReady
    6H59 A 0 A_GiveInventory("Eden_W_Ready_P")
    goto Ready2

   ReadyX:
    6H59 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ReadyXAlt")
    6H59 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "ReadyXAlt")
    6H59 A 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
    6H59 A 0 A_GiveInventory("Eden_W_Ready_P")
    goto Ready2
   ReadyXAlt:
    6H59 A 2 A_WeaponReady(WRF_NOPRIMARY)
    6H59 A 0 A_GiveInventory("Eden_W_Ready_P")
    goto Ready2

   Fire:
    6H59 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H59 A 0 A_GiveInventory("EdenFire_P")
    goto CDCheck
   CDCheck:
    6H59 A 0 A_GiveInventory("EdenTearCoolDown", CallACS("rz_GetEdenAttr", 0, 1, 0)*(2-CallACS("uh_checkrune", RUNE_RAGE))/2)
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 6, "Cooldown6")
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 4, "Cooldown4")
    6H59 A 0 A_JumpIfInventory("EdenTearCoolDown", 2, "Cooldown2")
    goto Cooldown1
   Cooldown6:
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    Goto Ready2
   Cooldown4:
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 36)
    Goto Ready2
   Cooldown2:
    6H59 A 2 Offset(0, 44)
    Goto Ready2
   Cooldown1:
    6H59 A 1 Offset(0, 44)
    Goto Ready2

   BotFire:
    6H59 A 0 A_Jump(32, "AltFire")
    6H59 A 0 A_GiveInventory("EdenFire_P")
    6H59 A 0 A_GiveInventory("EdenTearCoolDown", CallACS("rz_GetEdenAttr", 0, 1, 0))
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    Goto Ready2

   AltFire:
    6H59 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "AltUse")
    6H59 A 0 A_JumpIfInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"), "AltPay")
    goto Ready2
   AltPay:
    6H59 A 0 A_TakeInventory("EdenToyAmmo", CallACS("rz_EdenAltAmmoCost"))
   AltUse:
    6H59 A 0 A_GiveInventory("EdenAltFire_P")
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    6H59 A 2 Offset(0, 32)
    goto Ready2
  }
}

actor EdenAttr : Inventory {
  inventory.amount 1
  inventory.maxamount 9999
}

actor EdenMaxHealthAttr : EdenAttr {}
actor EdenSpeedAttr : EdenAttr {}
actor EdenHeightAttr : EdenAttr {}
actor EdenTearsAttr : EdenAttr {} // Fire Rate
actor EdenTearsHUDAttr : EdenAttr {
  inventory.maxamount 300
}
actor EdenDamageAttr : EdenAttr {}
actor EdenRangeAttr : EdenAttr {}
actor EdenShotSpeedAttr : EdenAttr {}
actor EdenLuckAttr : EdenAttr {}

actor EdenInitFlag : UOnce {}

actor EdenTearCoolDown : Inventory {
  inventory.amount 1
  inventory.maxamount 9999
}

actor EdenToyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 300
  +INVENTORY.IGNORESKILL
}

actor Eden_W_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("EdenToyAmmo", 1)
    TNT1 A 0 A_TakeInventory("EdenTearCoolDown", 1)
    stop
  }
}

actor EdenFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("Isaac/tearfire", "Weapon")
    TNT1 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "RightEye")
    TNT1 A 0 A_FireCustomMissile("EdenTear", 0, 0, -16, 16)
    TNT1 A 0 A_GiveInventory("DuoBusterFlag")
    stop
   RightEye:
    TNT1 A 0 A_FireCustomMissile("EdenTear", 0, 0, 16, 16)
    TNT1 A 0 A_TakeInventory("DuoBusterFlag")
    stop
  }
}

actor EdenAltFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenUseAlt")
    stop
  }
}

actor ResetEdenAttr_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("EdenMaxHealthAttr")
    TNT1 A 0 A_TakeInventory("EdenSpeedAttr")
    TNT1 A 0 A_TakeInventory("EdenHeightAttr")
    TNT1 A 0 A_TakeInventory("EdenTearsAttr")
    TNT1 A 0 A_TakeInventory("EdenDamageAttr")
    TNT1 A 0 A_TakeInventory("EdenRangeAttr")
    TNT1 A 0 A_TakeInventory("EdenShotSpeedAttr")
    stop
  }
}


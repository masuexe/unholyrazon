actor Electrician : CustWepClassBase {
  player.scoreIcon "UMUG_20"
  player.displayname "Electrician"
  player.soundclass "Electrician"
  player.maxhealth 850
  health 850
  player.forwardmove 1.2, 1.2
  player.sidemove 1.1, 1.1
  player.jumpz 10
  player.StartItem "UH_BaseFlagPack"
  player.startitem "Electrician_W"
  player.startitem "ElectricEnergyAmmo", 50
  States {
   Spawn:
    ELEC A 0
    ELEC B 1
    ELEC A 1
    Goto Spawn+2
   See:
    ELEC BCDE 5
    Goto Spawn
   Missile:
    ELEC F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile2")
    ELEC F 5
    ELEC G 4
    goto Spawn+2
   Missile2:
    ELEC GF 5
    goto Spawn+2

   ClassPain: ELEC H 0
    Goto MegamanPain

   ClassDeath:
    ELEC H 0
    goto MegamanDeath
   MegamanDeath0:
    ELEC H 14 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    ELEC H 0 A_SpawnItemEx("ElectricianZapDeath_H", 0, 0, 0, 0, 0, 0, 0, 1+32)
    Goto MegamanErase
   MegamanDisintegrate:
    ELEC Z 0 A_SpawnItemEx("Corpse_20", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor ElectricianShiny : Electrician {
  player.scoreIcon "UMUG_S20"
  player.maxhealth 2850
  health 2850
  player.forwardmove 1.3, 1.3
  player.sidemove 1.2, 1.2
  player.jumpz 11
  player.morphweapon "ElectricianShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    ELEC H 14 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    ELEC H 0 A_SpawnItemEx("S_ElectricianZapDeath_H", 0, 0, 0, 0, 0, 0, 0, 1+32)
    Goto MegamanErase
  }
}


actor ElectricianZapDeath_H : BasicExplosion {
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("ElectricianZapDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySound("weapon/lightningbolt", 1)

    TNT1 AAA 1 A_SpawnItemEx("Electrician_LBoltDeath", 0, 0, 8, 0, 0, 0, 0, 1+SXF_TRANSFERSPECIAL)//32768
    stop
  }
}
actor S_ElectricianZapDeath_H : ElectricianZapDeath_H {
  Args 88
}


actor ElectricianZapDeathFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    6P20 A 0
    6P20 ABCDE 2//Spark the Electric Jester
    stop
  }
}


actor Electrician_LBoltDeath : Electrician_LBolt {
  states {
   Spawn:
    X_BC N 0
    X_BC N 1 A_SpawnItemEx("Electrician_LBolt_EXT", 0, 0, 355, 0, 0, 0, 0, 1)
    X_BC O 1 A_SpawnItemEx("Electrician_LBoltBoomD", 0, 0, 16, 0, 0, 0, 0, 1+32768)
    goto Spawn2
  }
}

actor Electrician_LBoltBoomD : Electrician_LBoltBoom {
  Obituary "$OB_20D"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(175+Args[0], 224, 0, 0, 32)//175,298,32
    TNT1 AAAAAAAAAAAA 1 A_SpawnItemEx("Electrician_LBoltBoomD_FX", random(-100, 100), random(-100, 100), random(0, 100), 0, 0, 0, 0, 1)
    stop
  }
}
actor Electrician_LBoltBoomD_FX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    X_8D IJKI 2
    stop
  }
}


actor Corpse_20 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_20_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_20_1", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_20_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_20_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_20_4", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_20_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_20_0 : BaseCorpseFX {States {Spawn: 1H20 O 350
    goto Spawn2}}
actor Corpse_20_1 : BaseCorpseFX {States {Spawn: 1H20 P 350
    goto Spawn2}}
actor Corpse_20_2 : BaseCorpseFX {States {Spawn: 1H20 Q 350
    goto Spawn2}}
actor Corpse_20_3 : BaseCorpseFX {States {Spawn: 1H20 R 350
    goto Spawn2}}
actor Corpse_20_4 : BaseCorpseFX {States {Spawn: 1H20 S 350
    goto Spawn2}}
actor Corpse_20_5 : BaseCorpseFX {States {Spawn: 1H20 T 350
    goto Spawn2}}

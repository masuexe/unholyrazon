// TODO: add reload to detonate all barrels

actor CaptainAssShiny_W_NormalBar : NormalBar {args 42, 4}

actor CaptainAssShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_CaptainAss_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_42"
  Obituary "$OB_42W"
  Weapon.AmmoType "FreeDLCEnergyAmmo"
  States {
   Spawn:
    7H42 [ 6
    loop

   Deselect:
    7H42 A 0
    goto DeselectSwap
   Select:
    7H42 A 0
    goto SelectSwap

   Ready:
    7H42 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", CAPTAINASS_SDYE)
    7H42 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2

   Ready2:
    7H42 A 2 A_GiveInventory("CaptainAss_Ready_P")
    loop

   Fire:
    7H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, "Fire2")
    7H42 A 0 A_GiveInventory("S_CaptainAss_Fire_P")
    7H42 CBAAA 3
    goto Ready2
   Fire2:
    7H42 A 0 A_PlaySound("S_Spin/Button", 1, 0.65)
    7H42 B 2 Offset(0, 36) A_GiveInventory("CaptainAssDetonateFlag")
    7H42 B 2 Offset(0, 40)
    7H42 C 2 Offset(0, 44) A_TakeInventory("CaptainAssFlag")
    7H42 C 2 Offset(0, 44)
    7H42 B 2 Offset(0, 40)
    7H42 B 2 Offset(0, 36)
    goto Ready2

   Altfire:
    7H42 B 0 A_GiveInventory("CaptainAss_AltStart_P")
    7H42 B 0 A_ReFire(1)
    7H42 B 1
    // 23
    7H42 CCCCCCCCCCCCCCCCCCCCCCC 1 A_GiveInventory("S_CaptainAss_Alt_P")
    7H42 B 4 A_GiveInventory("CaptainAss_AltEnd_P")
    7H42 AA 4
    goto Ready2


   BotReady:
    7H42 A 0 A_WeaponReady(12)
    7H42 A 2 A_ReFire("BotCheck")
    7H42 A 0 A_GiveInventory("FreeDLCEnergyAmmo", 1)
    loop

   BotCheck:
    7H42 A 0 A_Jump(4, "BotFireX")
    7H42 A 0 A_JumpIfInventory("FreeDLCEnergyAmmo", 120, 4)
    7H42 A 0 A_Jump(16, "BotAlt")
    7H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, 1)
    goto BotFire
    7H42 A 0 A_Jump(64, "BotFire2")
    goto BotFire
    7H42 A 0 A_Jump(96, "BotAlt")
    7H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, 1)
    goto BotFire
    7H42 A 0 A_Jump(128, "BotFire2")
    goto BotFire

   BotFire:
    7H42 A 0 A_GiveInventory("S_CaptainAss_Fire_P")
    7H42 CBAAA 3
    goto BotReady
   BotFire2:
    7H42 A 0 A_PlaySound("S_Spin/Button", 1, 0.65)
    7H42 B 4 A_GiveInventory("CaptainAssDetonateFlag")
    7H42 C 4 A_TakeInventory("CaptainAssFlag")
    7H42 B 4
    goto BotReady

   BotFireX:
    7H42 A 0 A_PlaySoundEx("classes/taunt/captainass", "Voice")
    7H42 A 0 A_GiveInventory("CaptainAssFlag")
    7H42 C 0 A_PlaySound("S_Spin/MetalShake", 1, 1)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", 0, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", 45, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", 90, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", 135, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", -45, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", -90, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", -135, 0, 0, 0)
    7H42 A 0 A_FireCustomMissile("S_CaptainAssBarrel", 180, 0, 0, 0)
    7H42 CBAAA 3
    goto BotFire2

   BotAlt:
    7H42 B 0 A_GiveInventory("CaptainAss_AltStart_P")
    7H42 B 0 A_ReFire(1)
    7H42 B 1
    7H42 CCCCCCCCCCCCCCCCCCCCCCC 1 A_GiveInventory("S_CaptainAss_Alt_P")
    7H42 B 4 A_GiveInventory("CaptainAss_AltEnd_P")
    7H42 AA 4
    goto BotReady
  }
}

actor S_CaptainAss_Fire_P : CaptainAss_Fire_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("S_CaptainAssBarrel", cos(-pitch) * 1, 0, 32 + (sin(-pitch) * 0) - (ceilingz - z < 48 + 32) * (48 + 32 - (ceilingz - z)), cos(-pitch) * 32, 0, sin(-pitch) * 32, 0, 32)
    goto End
    TNT1 A 0 A_SpawnItemEx("S_CaptainAssBarrel2", cos(-pitch) * 1, 0, 32 + (sin(-pitch) * 0) - (ceilingz - z < 56 + 32) * (56 + 32 - (ceilingz - z)), cos(-pitch) * 40, 0, sin(-pitch) * 40, 0, 32)
    goto End
  }
}

actor S_CaptainAss_Alt_P : CaptainAss_Alt_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("S_CaptainAssMelee", 0, 0, 32, 0, 0, 0, 0, 1)
    goto End
    TNT1 A 0 A_SpawnItemEx("S_CaptainAssMelee2", 0, 0, 32, 0, 0, 0, 0, 1)
    goto End
  }
}


actor S_CaptainAssMelee : CaptainAssMelee {
  Translation "192:192=42:42", "198:198=4:4"
  Args 108, 68, 12  // 72
}
actor S_CaptainAssMelee2 : S_CaptainAssMelee {
  Args 324, 80, 24  // 216
}

actor S_CaptainAssBarrel : CaptainAssBarrel {
  Translation "192:192=42:42", "198:198=4:4", "195:195=160:160"
  Damage (75)  // 50
  States {
   XDeath:
    6P42 A 0 A_SpawnItemEx("S_CaptainAssBarrelBoom", 0, 0, 24, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    goto CaptainAssBarrel::XDeath+1
   Death:
    6P42 A 1 A_SpawnItemEx("S_CaptainAssBarrelSit", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION | SXF_TRANSFERSPECIAL)  // 1|32768
    6P42 A 1
    stop
  }
}
actor S_CaptainAssBarrel2 : CaptainAssBarrel2 {
  Translation "192:192=42:42", "198:198=4:4", "195:195=160:160"
  Damage (225)  // 150
  States {
   XDeath:
    6P42 C 0 A_SpawnItemEx("S_CaptainAssBarrelBoom2", 0, 0, 28, 0, 0, 0, 0, 32768)
    goto CaptainAssBarrel::XDeath+1
   Death:
    6P42 C 1 A_SpawnItemEx("S_CaptainAssBarrelSit2", 0, 0, 0, 0, 0, 0, 0, 1 | 32768)
    6P42 C 1
    stop
  }
}

actor S_CaptainAssBarrelBoom : CaptainAssBarrelBoom {
  Translation "192:192=170:170", "198:198=42:42", "118:118=4:4", "119:119=86:86"
  Accuracy 9  // 6
  Mass 188  // 125
}
actor S_CaptainAssBarrelBoom2 : CaptainAssBarrelBoom2 {
  Translation "192:192=170:170", "198:198=42:42", "118:118=4:4", "119:119=86:86"
  Accuracy 9  // 6
  Mass 563  // 375
}

actor S_CaptainAssBarrelSit : CaptainAssBarrelSit {
  Translation "192:192=42:42", "198:198=4:4", "195:195=160:160"
  Damage (75)  // 50
  States {
   Death:
   XDeath:
    6P42 A 0 A_SpawnItemEx("S_CaptainAssBarrelBoom", 0, 0, 24, 0, 0, 0, 0, 32768)
    goto CaptainAssBarrel::XDeath+1
  }
}
actor S_CaptainAssBarrelSit2 : CaptainAssBarrelSit2 {
  Translation "192:192=42:42", "198:198=4:4", "195:195=160:160"
  Damage (225)  // 150
  States {
   Death:
   XDeath:
    6P42 A 0 A_SpawnItemEx("S_CaptainAssBarrelBoom2", 0, 0, 24, 0, 0, 0, 0, 32768)
    goto CaptainAssBarrel::XDeath+1
  }
}

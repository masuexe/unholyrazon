actor AstronautLaserFX1 : BasicClientSide
{
+MISSILE
+DONTBLAST
+FORCEXYBILLBOARD
//+BRIGHT
Speed 70
Scale 4.0
Args 8
States
{
Spawn:
6P34 C 0
6P34 C 0 A_CountDownArg(0)
6P34 C 0 A_SpawnItemEx("AstronautLaserFX1",-1.5*sqrt(momx*momx+momy*momy),0,-1.5*momz,momx,momy,momz,0,1+8+16384+32768)
6P34 C 1
stop
}
}
actor AstronautLaserFX2 : AstronautLaserFX1
{
States
{
Spawn://D
6P34 B 0
6P34 B 0 A_CountDownArg(0)
6P34 B 0 A_SpawnItemEx("AstronautLaserFX2",-1.5*sqrt(momx*momx+momy*momy),0,-1.5*momz,momx,momy,momz,0,1+8+16384+32768)
6P34 B 1 Bright
stop
}
}
actor AstronautLaserFX3 : AstronautLaserFX1{Args 3}

actor AstronautJetPackDamage : BasicExplosion_Args_Trio
{
damagetype "Astronaut"
Obituary "$OB_34A"
Args 45,80,16
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_GiveToTarget("Astronaut_JetFX0_P",1)
goto BasicExplosion_Args_Trio::Spawn
}
}

actor Astronaut_JetFX0_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("Astronaut_JetFX1",-10,-7,30,0,-2,-10,0,1)
TNT1 A 0 A_SpawnItemEx("Astronaut_JetFX2",-10,7,30,0,2,-10,0,1)
stop
}
}

actor Astronaut_JetFX1 : BasicClientSideM
{
+FORCEXYBILLBOARD
+BRIGHT
+DONTBLAST
Speed 25
Args 8,-7
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetArg(2,random(0,1)*2-1)
TNT1 A 0 A_SetScale(ScaleX*Args[2],ScaleY)
TNT1 A 0 A_Jump(256,1,2,3,4,5,6,7,8)
Jet:
6P34 MMNNOOPP 1 A_GiveInventory("Astronaut_JetFX_P")
loop
}
}
actor Astronaut_JetFX2 : Astronaut_JetFX1
{
Args 8,7
}

actor Astronaut_JetFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_CountDownArg(0)
TNT1 A 0 //A_Warp(2,-10,Args[1]-(Args[0]*7/Args[1]),Args[0]*3,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)//8+16
TNT1 A 0 A_SetScale(ScaleX-0.2*Args[2],ScaleY-0.2)
TNT1 A 0 A_SpawnItemEx("Astronaut_LaserMissFX",0,0,0,frandom(-1,0),frandom(-1,1),-1,0,1+16384,256-ScaleY*16)
stop
}
}

actor AstronautShockWave : BasicExplosion {
  Translation "192:192=4:4"
  damagetype "AstronautPush"
  obituary "$OB_34A"
  args 10, 256  // 90
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, 32)
    TNT1 A 0 A_RadiusGive("AstronautShockWavePush_P", Args[1], RGF_PLAYERS | RGF_NOSIGHT | RGF_NOTARGET)
    TNT1 A 0 A_SpawnItemEx("AstronautShockWaveFX_H", 0, 0, -20, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
  }
}

actor AstronautShockWavePush_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("PainAstronautPushHit")
    stop
  }
}

actor PainAstronautPushHit : Basic_PainFling_H {Args 20, 0, 0}

actor AstronautShockWaveFX_H : BasicGraphicEffect {
  var int user_a;
  reactiontime 24
  States {
   SpawnFrame:
    TNT1 A 0 A_SetUserVar("user_a", random(0, 15))
   SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("AstronautShockWaveFX", 0, 0, 0, 10, 0, 0, user_a, 1)
    TNT1 A 0 A_SetUserVar("user_a", user_a + 15)
    TNT1 A 0 A_Countdown
    loop
  }
}

actor AstronautShockWaveFX {
  Projectile
  +DONTBLAST
  +THRUACTORS
  +CLIENTSIDEONLY
  Damage (0)
  Radius 2
  Height 2
  Speed 30
  Scale 2.0
  States {
   Spawn:
    X_0E T 0
    X_0E T 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
   SpawnFrame:
    X_0E T 1 A_FadeOut(0.06)
    wait
  }
}

actor SmokeBandit : CustWepClassBase {
  Player.ScoreIcon "UMUG_28"
  Player.DisplayName "SmokeBandit"
  Player.SoundClass "SmokeBandit"
  Player.MaxHealth 1250
  Health 1250
  Player.ForwardMove 1.00, 1.00
  Player.SideMove 0.95, 0.95
  Player.JumpZ 10.5
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "SmokeBandit_W"
  Player.StartItem "CigarAmmo", 30
  Player.StartItem "SmokinAmmo", 250
  Player.StartItem "AirJumpLimit", 1

  States {
   Spawn:
    CLOM A 0
    CLOM B 1
    CLOM A 1
    goto Spawn+2
   See:
    CLOM BCDE 5
    goto Spawn
   Melee:
    CLOM FG 3
    goto Spawn+2
   Missile:
    CLOM F 5
    CLOM G 5
    goto Spawn+2
   ClassPain:
    CLOM H 0
    goto MegamanPain

   ClassDeath:
    CLOM H 0
    goto MegamanDeath
   MegamanDeath0:
    CLOM H 2 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CLOM H 0 A_SpawnItemEx("SmokeBandit_DeathPoof_H", 0, 0, 28, 0, 0, 0, random(0, 11) * 30, 1)
    goto MegamanFade3
   MegamanDisintegrate:
    CLOM Z 0 A_SpawnItemEx("Corpse_28", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor SmokeBanditShiny : SmokeBandit {
  Player.ScoreIcon "UMUG_S28"
  Player.MaxHealth 3250
  Health 3250
  Player.ForwardMove 1.10, 1.10
  Player.SideMove 1.05, 1.05
  Player.JumpZ 11.5
  Player.MorphWeapon "SmokeBanditShiny_W"
  +NOSKIN
  +PLAYERPAWN.NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    CLOM H 2 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CLOM H 0 A_SpawnItemEx("S_SmokeBandit_DeathPoof_H", 0, 0, 28, 0, 0, 0, random(0, 11) * 30, 1)
    goto FadeDeathEnd3
  }
}


actor SmokeBandit_DeathPoof_H : BasicWatcher {
  ReactionTime 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 28, 30, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("SmokeBandit_DeathPoof", frandom(12, 18), frandom(-8, 8), 0, random(9, 12), random(-2, 2), random(5, 8), random(-20, 20), 1 + 32 + SXF_TRANSFERSPECIAL)  // 32768
    TNT1 A 0 A_SpawnItemEx("SmokeBandit_DeathPoof", frandom(12, 18), frandom(-8, 8), 0, random(9, 12), random(-2, 2), random(5, 8), random(160, 200), 1 + 32 + 32768)
    TNT1 A 1 A_CountDown
    loop
  }
}
actor S_SmokeBandit_DeathPoof_H : SmokeBandit_DeathPoof_H {
  Args 27
}

actor SmokeBandit_DeathPoof : BasicProjectile {
  Translation "192:192=160:160", "198:198=162:162"
  DamageType "SmokeBandit"
  Obituary "$OB_28D"
  // +RIPPER
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  +NOEXPLODEFLOOR
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 0.0
  WallBounceFactor 0.0
  Alpha 0.8
  RenderStyle "Translucent"
  Damage (53 + args[0])
  Radius 20
  Height 20
  Speed 32
  Scale 3.0
  States {
   Spawn:
    6P28 A 0
    6P28 ABABAB 2
    // 6P28 A 0 A_Jump(128,1,2,3)
    // 6P28 ABABAB 2 ThrustThingZ(0,random(0,2),0,1)
    // 6P28 ABABABABABABABAB 2 ThrustThingZ(0,random(4,10),0,1)
    6P28 A 0 A_SpawnItemEx("SmokeBandit_DeathPoofFX", 0, 0, 0, velx, vely, velz, 0, 1 + 8)
    stop
   Death:
    6P28 A 0 A_SpawnItemEx("SmokeBandit_DeathPoofFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor SmokeBandit_DeathPoofFX : BasicClientSide {
  +FORCEXYBILLBOARD
  Alpha 0.8
  RenderStyle "Translucent"
  States {
   Spawn:
    6P28 BA 1 ThrustThingZ(0, random(2, 5), 0, 1)
    6P28 A 0 A_FadeOut(frandom(0.09, 0.17))
    6P28 AB 1 ThrustThingZ(0, random(2, 5), 0, 1)
    6P28 B 0 A_FadeOut(frandom(0.09, 0.17))
    loop
  }
}


actor Corpse_28 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_28_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_3", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_4", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_5", 0, 0, 30, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_6", 0, 0, 20, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_28_7", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


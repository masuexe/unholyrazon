actor SamuraiSamS_W_ScriptBar : ScriptBar {}

actor SamuraiSamS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_SamuraiSam_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_33"
Obituary "$OB_33W"
weapon.ammotype "FoolishSamuraiWarriorAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H33 [ 6
loop

Deselect:
7H33 A 0
goto DeselectSwap
Select:
7H33 A 0
goto SelectSwap

Ready:
7H33 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE)
Goto Ready2
Ready2:
7H33 A 4 A_GiveInventory("SamuraiSam_Ready_P")
loop

Fire:
7H33 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H33 A 0
7H33 F 0 ACS_NamedExecuteWithResult("uc_SamuraiSetUser",angle,pitch,(65536 * 2))
goto FireH
FireH:
7H33 F 1 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")
7H33 F 0 A_Refire("FireH")
goto FireStab
FireStab:
7H33 F 0 A_GiveInventory("S_SamuraiSam_Fire1_P")
7H33 F 1 A_WeaponReady(14)
7H33 G 1
7H33 G 1 OffSet(-23,65)
7H33 H 3 A_WeaponReady(14)
TNT1 A 6 OffSet(0,92)
7H33 A 1 OffSet(0,92)
7H33 A 1 OffSet(0,82) A_JumpIfInventory("PlayerPropertyRage",1,1)
7H33 A 1 OffSet(0,72)
7H33 A 1 OffSet(0,62) A_JumpIfInventory("PlayerPropertyRage",1,1)
7H33 A 1 OffSet(0,52)
7H33 A 1 OffSet(0,42) A_JumpIfInventory("PlayerPropertyRage",1,1)
goto Ready2
FireAimSlash:
7H33 B 1 A_GiveInventory("S_SamuraiSam_Fire2_P")
7H33 C 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H33 C 1 Offset(-43, 36)
7H33 D 0 A_WeaponReady(14)
7H33 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H33 D 1 Offset(-48, 33)
7H33 E 0 A_WeaponReady(14)
7H33 E 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H33 E 1 Offset(-43, 43)
7H33 E 1 Offset(-102, 53) A_JumpIfInventory("PlayerPropertyRage",1,1)
TNT1 A 8 OffSet(-146,149)
7H33 A 1 OffSet(-127,142)
7H33 A 1 OffSet(-108,135) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H33 A 1 OffSet(-88,127)
7H33 A 1 OffSet(-71,118) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H33 A 1 OffSet(-54,108)
7H33 A 1 OffSet(-40,195) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H33 A 1 OffSet(-27,87)
7H33 A 1 OffSet(-18,70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
7H33 A 1 OffSet(-9,54)
7H33 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Ready2")
7H33 A 1 A_WeaponReady(14)
goto Ready2

BotFire:
7H33 A 0 A_JumpIfInventory("FoolishSamuraiWarriorAmmo",28,"BotFire0")
7H33 A 0 A_GiveInventory("FoolishSamuraiWarriorAmmo",random(2,5))
7H33 A 0 A_Jump(16,"BotFire3")
7H33 F 1 ACS_NamedExecuteAlways("uc_SamuraiSetUser",0,angle,pitch,(65536 * 2))
goto BotFire1
BotFire0:
7H33 A 0 A_JumpIfInventory("FoolishSamuraiWarriorAmmo",56,2)
7H33 A 0 A_Jump(64,1)
goto BotFire+1
7H33 A 0 A_ChangeVelocity(random(12,30),20*(random(0,1)*2-1),0,1)
goto Altfire
BotFire1:
7H33 F 0 A_JumpIfCloser(200,"FireStab")
7H33 F 0 A_Jump(4,"BotFire2")
7H33 F 0 A_Jump(1,3)
7H33 F 1 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")
7H33 F 0 A_ReFire("BotFire1")
goto FireStab
7H33 F 0 A_ChangeVelocity(8,30*(random(0,1)*2-1),0,1)
7H33 F 0 A_GiveInventory("PowerSamuraiDodgeSpeed",1)
goto BotFire1+3
BotFire2:
7H33 F 0 A_FaceTarget
goto FireStab
BotFire3:
7H33 A 0 A_Recoil(-50)
7H33 A 0 A_GiveInventory("FoolishSamuraiWarriorAmmo",56)
7H33 A 0 A_GiveInventory("PowerSamuraiBotSpeed",1)
7H33 A 0 A_PlaySoundEx("taunt/D_33","Voice")
7H33 A 0 A_FaceTarget
goto BotFire+3

AltFire:
7H33 A 0 A_GiveInventory("S_SamuraiSamAlt_P")
7H33 A 0 A_ReFire(1)
7H33 S 1 OffSet(2,40)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(5,51)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,2425,1000)//Short boost wears off here
7H33 S 1 OffSet(9,65)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(14,82)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 S 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 S 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 S 1 OffSet(14,82)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(9,65)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 S 1 OffSet(5,51)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE2,1)
7H33 A 1 OffSet(2,40)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_SDYE,1)
7H33 A 0 A_GiveInventory("S_SamuraiSamAlt_P2")
7H33 A 2 A_WeaponReady(8)
Goto Ready2
}
}

actor PowerSamuraiFakeSpeed : PowerSamuraiDodgeSpeed
{
powerup.duration 13
Speed 1.0001//For teleporters
}

actor S_SamuraiSam_Fire1_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_SamuraiSamStab",0,0,0,8)
TNT1 A 0 A_FireCustomMissile("S_SamuraiSamStabFX",0,0,0,8)
TNT1 A 0 A_FireCustomMissile("S_SamuraiSamStabSnd",0,0,0,8)
TNT1 A 0 A_PlaySound("Shin_3/Swipe",1,0.725)
stop
}
}


actor S_SamuraiSam_Fire2_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("Shin_1/Swipe",1,0.85)
TNT1 A 0 A_GiveInventory("SamuraiSamFlag",25)
goto AimSlash

SlashAdjust:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_SamuraiAddonUser")
TNT1 A 0 A_TakeInventory("SamuraiSamFlag",1)
AimSlash:
TNT1 A 0 A_SpawnItemEx("S_SamuraiSamSlashBit1",0,0,32,cos(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,0,sin(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,CallACS("uc_SamuraiGetUser",0)/65536.0f-angle,32,0)
TNT1 A 0 A_JumpIfInventory("SamuraiSamFlag",1,"SlashAdjust2")
stop
SlashAdjust2:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_SamuraiAddonUser")
TNT1 A 0 A_TakeInventory("SamuraiSamFlag",1)
AimSlash2:
TNT1 A 0 A_SpawnItemEx("S_SamuraiSamSlashBit2",0,0,32,cos(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,0,sin(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,CallACS("uc_SamuraiGetUser",0)/65536.0f-angle,32,0)
TNT1 A 0 A_JumpIfInventory("SamuraiSamFlag",1,"SlashAdjust")
stop
}
}


actor S_SamuraiSamAlt_P : SamuraiSamAlt_P
{
States
{
Pickup://Morphes don't work with PowerSpeed
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,5881,1000)//2425
TNT1 A 0 A_GiveInventory("PowerSamuraiFakeSpeed",1)
goto SamuraiSamAlt_P::Pickup+2
}
}
actor S_SamuraiSamAlt_P2 : SamuraiSamAlt_P2
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,1,1)
goto SamuraiSamAlt_P2::Pickup
}
}



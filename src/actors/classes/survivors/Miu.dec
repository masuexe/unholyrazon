actor Miu : CustWepClassBase
{
player.scoreIcon "UMUG_56"
player.displayname "Miu"
player.soundclass "Miu"
Player.Maxhealth 900
health 900
player.forwardmove 1.00, 1.00
player.sidemove 1.00, 1.00
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "Miu_W"
player.startitem "Miu_W2"
player.startitem "MiuEnergyAmmo", 120
player.startitem "MiuCannonAmmo", 120

player.weaponslot 1, "Miu_W"
player.weaponslot 2, "Miu_W2"
States
{
Spawn:
1H56 A 0
1H56 B 1
1H56 A 1
wait
See:
1H56 B 5
1H56 C 5 A_PlaySound("weapon/MiuStep",CHAN_BODY,0.15)
1H56 D 5
1H56 E 5 A_PlaySound("weapon/MiuStep",CHAN_BODY,0.15)
Goto Spawn

//Melee:
//1H56 BCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDE 1
//Goto Spawn

Missile:
1H56 F 0 A_JumpIfInventory("VivifyFlag1",1,"MissileSpin")
1H56 F 0 A_JumpIfInventory("VivifyDelay4",1,"MissileToss")
1H56 F 0 A_JumpIfInventory("VivifyFlag2",1,"MissileGun")
1H56 FG 5
goto Spawn+2
MissileToss:
1H56 I 9
goto Spawn+2
MissileGun:
1H56 J 7
goto Spawn+2
MissileSpin:
1H56 KLMKLMKLM 2
goto MissileSpinL
MissileSpinL:
1H56 KKKLLLMMM 1 A_JumpIfInventory("VivifyDelay6",1,"MissileToss")
loop

ClassPain:
1H56 H 0 A_JumpIfInventory("VivifyFlag1",1,"MissileSpinL")
goto MegamanPain

ClassDeath:
1H56 H 0
goto MegamanDeath
MegamanDeath0:
1H56 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H56 H 19 A_PlaySound("KirbyNES/Hit_D",2)
1H56 H 0 ThrustThingZ(0,82,0,0)
1H56 H 0 A_SpawnItemEx("MiuKirbyDeathCorpse",0,0,0,0,0,20,0,1)
Goto MegamanErase
MegamanDisintegrate:
1H56 Z 0 A_SpawnItemEx("Corpse_56",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor MiuS : Miu
{
player.scoreIcon "UMUG_S56"
Player.Maxhealth 2900
health 2900
player.forwardmove 1.10, 1.10
player.sidemove 1.10, 1.10
player.jumpz 11
player.morphweapon "MiuS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H56 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H56 H 19 A_PlaySound("KirbyNES/Hit_D",2)
1H56 H 0 ThrustThingZ(0,82,0,0)
1H56 H 0 A_SpawnItemEx("S_MiuKirbyDeathCorpse",0,0,0,0,0,20,0,1)
Goto MegamanErase
}
}


actor MiuKirbyDeathCorpse : BasicKirbyDeathCorpse
{
damagetype "Miu"
Obituary "$OB_56D"
States
{
Spawn:
1H56 H 0
1H56 H 0
goto Spawn2
}
}
actor S_MiuKirbyDeathCorpse : MiuKirbyDeathCorpse
{
Damage (113)
Args 375,168,16
}

actor Corpse_56:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_56_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_56_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_56_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_56_3",0,0,18,momx+frandom(-1,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_56_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_56_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


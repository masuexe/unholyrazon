actor Miu : CustWepClassBase {
  Player.ScoreIcon "UMUG_56"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Miu"
  Player.SoundClass "Miu"
  Player.MaxHealth 900
  Health 900
  Player.ForwardMove 1.00, 1.00
  Player.SideMove 1.00, 1.00
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Miu_W"
  Player.StartItem "Miu_W2"
  Player.StartItem "MiuEnergyAmmo", 120
  Player.StartItem "MiuCannonAmmo", 120

  Player.WeaponSlot 1, "Miu_W"
  Player.WeaponSlot 2, "Miu_W2"
  States {
   Spawn:
    1H56 A 0
    1H56 B 1
    1H56 A 1
    wait
   See:
    1H56 B 5
    1H56 C 5 A_PlaySound("weapon/MiuStep", CHAN_BODY, 0.15)
    1H56 D 5
    1H56 E 5 A_PlaySound("weapon/MiuStep", CHAN_BODY, 0.15)
    goto Spawn

    // Melee:
    // 1H56 BCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDEBCDE 1
    // Goto Spawn

   Missile:
    1H56 F 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileSpin")
    1H56 F 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileToss")
    1H56 F 0 A_JumpIfInventory("VivifyFlag2", 1, "MissileGun")
    1H56 FG 5
    goto Spawn+2
   MissileToss:
    1H56 I 9
    goto Spawn+2
   MissileGun:
    1H56 J 7
    goto Spawn+2
   MissileSpin:
    1H56 KLMKLMKLM 2
    goto MissileSpinL
   MissileSpinL:
    1H56 KKKLLLMMM 1 A_JumpIfInventory("VivifyDelay6", 1, "MissileToss")
    loop

   ClassPain:
    1H56 H 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileSpinL")
    goto MegamanPain

   ClassDeath:
    1H56 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H56 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H56 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H56 H 0 ThrustThingZ(0, 82, 0, 0)
    1H56 H 0 A_SpawnItemEx("MiuKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    1H56 Z 0 A_SpawnItemEx("Corpse_56", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor MiuShiny : Miu {
  Player.ScoreIcon "UMUG_S56"
  Player.MaxHealth 2900
  Health 2900
  Player.ForwardMove 1.10, 1.10
  Player.SideMove 1.10, 1.10
  Player.JumpZ 11
  Player.MorphWeapon "MiuShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H56 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H56 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H56 H 0 ThrustThingZ(0, 82, 0, 0)
    1H56 H 0 A_SpawnItemEx("S_MiuKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
  }
}


actor MiuKirbyDeathCorpse : BasicKirbyDeathCorpse {
  DamageType "Miu"
  Obituary "$OB_56D"
  States {
   Spawn:
    1H56 H 0
    1H56 H 0
    goto Spawn2
  }
}
actor S_MiuKirbyDeathCorpse : MiuKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

actor Corpse_56 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_56_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_56_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_56_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_56_3", 0, 0, 18, velx + frandom(-1, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_56_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_56_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_56_0 : BaseCorpseFX {States {Spawn: 1H56 O 350
    goto Spawn2}}
actor Corpse_56_1 : BaseCorpseFX {States {Spawn: 1H56 P 350
    goto Spawn2}}
actor Corpse_56_2 : BaseCorpseFX {States {Spawn: 1H56 Q 350
    goto Spawn2}}
actor Corpse_56_3 : BaseCorpseFX {States {Spawn: 1H56 R 350
    goto Spawn2}}
actor Corpse_56_4 : BaseCorpseFX {States {Spawn: 1H56 S 350
    goto Spawn2}}
actor Corpse_56_5 : BaseCorpseFX {States {Spawn: 1H56 T 350
    goto Spawn2}}



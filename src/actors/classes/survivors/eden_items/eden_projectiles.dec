actor EdenTear {
  translation "192:192=[185,207,252]:[185,207,252]", "198:198=[132,171,249]:[132,171,249]"
  PROJECTILE
  damagetype "Eden"
  Obituary "$OB_64M"
  -NOGRAVITY
  +SKYEXPLODE
  +SEEKERMISSILE
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0))
  radius 8
  height 8
  scale 2.5
  gravity 0.2
  Speed 10
  var int user_range;
  States {
   Spawn:
    ISTR F 0
    ISTR F 0 ACS_ExecuteWithResult(259, 0, 1)
    ISTR F 0 A_ChangeVelocity(cos(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    ISTR F 0 A_SetUserVar("user_range", CallACS("rz_GetEdenAttr", 2, 5, 0))
    ISTR F 1 A_Jump(256, "SpawnCheck")
    wait
   SpawnCheck:
    ISTR F 0 A_JumpIfInTargetInventory("C149Flag", 1, "SpawnCheck.Ipecac")
    ISTR F 0 A_JumpIfInTargetInventory("C315Flag", 1, "SpawnCheck.StrangeAttractor")
    ISTR F 0 A_JumpIfInTargetInventory("C331Flag", 1, "SpawnCheck.GodHead")
    goto SpawnEffect
   SpawnCheck.Ipecac:
    ISTR F 0 ACS_NamedExecuteWithResult("rz_EdenTearColor", EDEN_TEAR_EXPLOSIVE_DYE)
    ISTR F 0 A_SetDamageType("EdenPoisonIpecac")
    ISTR F 0 ThrustThingZ(0, 8, 0, 1)
    goto SpawnCheck+1
   SpawnCheck.StrangeAttractor:
    ISTR F 0 ACS_NamedExecuteWithResult("rz_EdenTearColor", EDEN_TEAR_ATTRACTOR_DYE)
    goto SpawnCheck+2
   SpawnCheck.GodHead:
    // ISTR F 0 A_ChangeFlag("SEEKERMISSILE",1)
    ISTR F 0 A_SpawnItemEx("GodHeadAura", 0, 0, 0, 0, 0, 0, 0, 0, 0, CallACS("core_NewUniqueTID"))
    ISTR F 0 ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", CallACS("core_CurrentUniqueTID"), AAPTR_MASTER)
    ISTR F 0 ACS_NamedExecuteWithResult("core_ClearUniqueTID", 0)
    goto SpawnEffect

   SpawnEffect:
    ISTR F 0 A_JumpIfInTargetInventory("C315Flag", 1, "SpawnFrame.StrangeAttractor")
    ISTR F 0 A_JumpIfInTargetInventory("C331Flag", 1, "SpawnFrame.GodHead")
    ISTR F 0 A_Jump(256, "SpawnFrame")
    goto SpawnFrame
   SpawnFrame.StrangeAttractor:
    ISTR F 0 ACS_ExecuteAlways(UB_PUSHPULLACS, 0, 10, 128, 0)
    goto SpawnEffect+1
   SpawnFrame.GodHead:
    ISTR F 0 A_SeekerMissile(8, 16, SMF_LOOK, 48, 4)
    ISTR F 0 A_Jump(256, "SpawnFrame")
    goto SpawnFrame
   SpawnFrame:
    ISTR F 1 A_SetUserVar("user_range", user_range - 1)
    ISTR F 0 A_JumpIf(user_range==0, "Death")
    goto SpawnEffect

   Crash:
   XDeath:
    TNT1 A 0 A_GiveInventory("DecoyFlag1")
   Death:
    TNT1 A 0 A_Stop
    ISTR H 0 A_SetGravity(0.0)
    TNT1 A 0 A_GiveInventory("UOnce")
    ISTR F 0 A_JumpIfInTargetInventory("C149Flag", 1, "Death.Ipecac")
    ISTR F 0 A_Jump(256, "Death.Normal")
    goto Death.Normal
   Death.Ipecac:
    ISTR H 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    ISTR H 0 A_Explode(CallACS("rz_GetEdenAttr", 2, 2, 0)/2, 140, XF_HURTSOURCE, 0, 50)
    X_8B ABCDEF 2
    stop
   Death.Normal:
    TNT1 A 0 A_JumpIfInventory("DecoyFlag1", 1, "Death.CrashNormal")
    ISTR F 0 A_PlaySoundEx("Isaac/splatter", "Weapon")
    ISBR ABCDEFGHIJKLMNO 1 //A_SpawnItemEx("EdenTearSplatterFX",0,0,0,0,0,0,0,1)
    stop
   Death.CrashNormal:
    ISTR F 0 A_PlaySoundEx("Isaac/TearBlock", "Weapon")
    ISBR ABCDEFGHIJKLMNO 1 //A_SpawnItemEx("EdenTearSplatterFX",0,0,0,0,0,0,0,1)
    stop
  }
}

actor EdenSpectralTear : EdenTear {
  +NOCLIP
  +NOINTERACTION
  damage (0)
  States {
   SpawnFrame:
    ISTR F 0 A_JumpIfInventory("UOnce", 1, "Death")
    ISTR F 0 A_SpawnItemEx("EdenSpectralTearDamager", 0, 0, 0, velx, vely, velz, 0, 0, 0, CallACS("core_NewUniqueTID"))
    ISTR F 0 ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", CallACS("core_CurrentUniqueTID"), AAPTR_MASTER)
    ISTR F 0 ACS_NamedExecuteWithResult("core_ClearUniqueTID", 0)
    ISTR F 1 A_SetUserVar("user_range", user_range - 1)
    ISTR F 0 A_JumpIf(user_range==0, "Death")
    goto SpawnEffect
  }
}

actor EdenSpectralTearDamager {
  PROJECTILE
  +DONTSPLASH
  +DONTBLAST
  // +THRUGHOST
  +INVISIBLE
  +SERVERSIDEONLY
  Damagetype "Eden"
  Obituary "$OB_64M"
  radius 8
  height 8
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0))
  States {
   Spawn:
    TNT1 A 1
    stop
   Crash:
    TNT1 A 0 A_GiveInventory("UOnce", 1, 4)
    stop
   Death:
    TNT1 A 0
    stop
  }
}


actor IsaacBomb : BasicProjectile {
  Translation "192:192=208:208", "198:198=0:0", "202:202=4:4", "199:199=210:210"
  damagetype "IsaacBomb"
  Obituary "%o was blown to bits by %k's bomb."
  -NOGRAVITY
  +RIPPER
  +BOUNCEONACTORS
  +HEXENBOUNCE
  +CANBOUNCEWATER
  gravity 1.0
  bouncefactor 0.68
  reactiontime 1
  Damage (0)
  Radius 12
  Height 16
  speed 20
  scale 3.0
  States {
   Spawn:
    X_1D A 0
    X_1D A 85 ThrustThingZ(0, 14, 0, 1)
    X_1D A 1 A_CountDown
    wait
   Death:
    X_1D A 0 A_SetGravity(0.0)
    X_1D A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    X_1D A 0 A_Explode(450, 212, XF_HURTSOURCE)
    X_1D A 0 A_SetScale(3.75)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

actor EdenTrollBomb : IsaacBomb {
  Obituary "%o was pranked to oblivion by %k's Troll Bomb."
  bouncefactor 0.2
  bouncecount 3
  States {
   Spawn:
    1SBM A 0
    1SBM A 25 ThrustThingZ(0, 14, 0, 1)
    1SBM A 1 //A_CountDown
    wait
  }
}

actor EdenMegaTrollBomb : IsaacBomb {
  Obituary "%o couldn't outrun %k's Mega Troll Bomb."
  +SEEKERMISSILE
  bouncefactor 0.85
  bouncecount 8
  Radius 24
  Height 32
  scale 6.0
  States {
   Spawn:
    1SBM B 0
    1SBM B 25 ThrustThingZ(0, 14, 0, 1)
    Goto SpawnL
   SpawnL:
    1SBM B 16 A_SeekerMissile(90, 90, SMF_LOOK|SMF_PRECISE, 256, 3)
    loop
   Death:
    1SBM B 0 A_SetGravity(0.0)
    1SBM B 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    1SBM B 0 A_Explode(900, 424, XF_HURTSOURCE)
    1SBM B 0 A_SetScale(7.5)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

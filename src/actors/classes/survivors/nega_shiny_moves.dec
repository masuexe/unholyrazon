7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P2",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 CC 1 A_WeaponReady
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P2",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 CC 1 A_WeaponReady
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P2",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 CC 1 A_WeaponReady
7H02 C 0 A_JumpIfInventory("SNBarrier_PU2",1,"Negaman4L2")
goto Nega4End
Negaman4L3:
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P3",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 C 1 A_WeaponReady
7H02 C 1 A_WeaponReady
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P3",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 C 1 A_WeaponReady
7H02 C 1 A_WeaponReady
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P3",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 C 1 A_WeaponReady
7H02 C 1 A_WeaponReady
7H02 C 0 A_GiveInventory("S_NegaSkullBoost_P3",1)
7H02 C 0 A_SpawnItemEx("S_NegaSkullDamageU",0,0,28,momx,momy,momz,0,8,0)
7H02 C 1 A_WeaponReady
7H02 C 1 A_WeaponReady

7H02 A 0 A_JumpIfInventory("ShieldCheck",1,"Nega4End")
7H02 B 3 A_TakeInventory("VivifyDelay8",999)
7H02 C 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
7H02 C 3 A_FireCustomMissile("S_NegaBalladeCracker",0,0,8,0)
7H02 B 3
goto NegaKHold_1
Fire2:
7H02 B 0 A_TakeInventory("WeaponCharge",999)
7H02 B 3 A_TakeInventory("VivifyDelay8",999)
7H02 C 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
7H02 C 3 A_FireCustomMissile("S_NegaBalladeCracker2",0,0,8,0)
7H02 B 3
goto NegaKHold_2
Fire3:
7H02 C 0 A_TakeInventory("WeaponCharge",999)
7H02 C 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
7H02 C 0 A_FireCustomMissile("S_NegaBalladeCracker3",0,0,8,0)
goto Fire3End
NegaKHold_1:
7H02 A 0 A_JumpIfInventory("VivifyDelay8",1,"NegaKEnd")
7H02 A 0 A_GiveInventory("SNC_Pickup",1)
7H02 A 1
loop
NegaKEnd:
7H02 A 5
goto Ready2
NegaKHold_2:
7H02 A 0 A_JumpIfInventory("VivifyDelay8",1,"NegaKEnd2")
7H02 A 0 A_GiveInventory("SNC_Pickup2",1)
7H02 A 1
loop
NegaKEnd2:
goto Fire2End+2
}
}


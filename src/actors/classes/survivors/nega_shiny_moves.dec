// Vanilla NegaManShiny slots 1..25 as held weapons (slot 1).
// Charge on this base; Fire1/2/3 are the current cycle slot's attacks.
// Full-charge (Fire3End) Give/Takes the next slot via uh_ShinyNegaAdvanceHeld.

actor NegaShinyHeldBase_W : BaseMM8BDMWep_UH
{
	Weapon.SlotNumber 1
	Weapon.AmmoUse 0
	Weapon.AmmoGive 0
	weapon.ammotype "S_NegaDuckAmmo"
	Weapon.UpSound ""
	inventory.icon "C_I_02B"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
States
{
Spawn:
	7H02 [ 6
	loop
Deselect:
	7H02 A 0
	goto DeselectSwap
Select:
	7H02 A 0 A_JumpIfInventory("UH_SilentSelect_F",1,"SilentSelect")
	goto SelectSwap
SilentSelect:
	7H02 A 0 A_StopSound(CHAN_WEAPON)
	7H02 A 0 A_TakeInventory("UH_SilentSelect_F",1)
	7H02 A 0 A_TakeInventory("NoWeaponSwitchSound",1)
	7H02 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_SDYE)
	7H02 A 0 A_WeaponReady(14)
	goto Ready2
Ready:
	7H02 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_SDYE)
	Goto Ready2
Ready2:
	7H02 A 0 A_JumpIfInventory("S_NegaDuckAmmo",100,"Ready3")
	7H02 A 2 A_WeaponReady(8)
	7H02 A 0 A_GiveInventory("S_NegaDuckAmmo",3)
	loop
Ready3:
	7H02 A 2 A_WeaponReady
	7H02 A 0 A_GiveInventory("S_NegaDuckAmmo",3)
	loop
Fire:
Charge:
	7H02 A 0
	goto Charge0
Charge0:
	7H02 A 0 A_JumpIfInventory("WeaponCharge",25,"Charge1")
	7H02 A 0 A_JumpIfInventory("WeaponCharge",24,"ChargeStart")
	7H02 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"Charge0R")
	7H02 A 1 A_GiveInventory("WeaponCharge",1)
	7H02 A 0 A_Refire("Charge0")
	// A_Jump resolves Fire1/2/3 on the *held* class (goto would stick on base stubs).
	7H02 A 0 A_Jump(256, "Fire1")
ChargeStart:
	7H02 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
	Goto Charge1
Charge0R:
	7H02 A 1 A_GiveInventory("WeaponCharge",2)
	7H02 A 0 A_Refire("Charge0")
	7H02 A 0 A_Jump(256, "Fire1")
Charge1:
	7H02 B 0 A_JumpIfInventory("WeaponCharge",56,"Charge2")
	7H02 B 0 A_JumpIfInventory("PlayerPropertyRage",1,"Charge1R")
	7H02 B 1 A_GiveInventory("WeaponCharge",1)
	7H02 B 0 A_Refire("Charge1")
	7H02 B 0 A_Jump(256, "Fire2")
Charge1R:
	7H02 B 1 A_GiveInventory("WeaponCharge",2)
	7H02 B 0 A_Refire("Charge1")
	7H02 B 0 A_Jump(256, "Fire2")
Charge2:
	7H02 C 1 A_RailWait
	7H02 C 0 A_Refire("Charge2")
	7H02 C 0 A_Jump(256, "Fire3")
Fire1:
	7H02 A 0 A_TakeInventory("WeaponCharge",999)
	7H02 A 0 A_JumpIfInventory("ShieldCheck",1,"Nega4End")
	goto Ready2
Fire2:
	7H02 B 0 A_TakeInventory("WeaponCharge",999)
	goto Ready2
Fire3:
	7H02 C 0 A_TakeInventory("WeaponCharge",999)
	goto Ready2
Nega4End:
	7H02 C 0 A_PlaySoundEx("weapon/skullcounter","Weapon")
	7H02 C 0 A_TakeInventory("ShieldCheck")
	7H02 BA 3
	goto Ready2
Nega4End3:
	7H02 C 0 A_PlaySoundEx("weapon/skullcounter","Weapon")
	7H02 C 0 A_TakeInventory("ShieldCheck")
	7H02 BA 3
	TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyNegaAdvanceHeld")
	goto Ready2
Fire2End:
7H02 CB 4
7H02 A 6
goto Ready2
Fire3End:
7H02 CBA 3
TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyNegaAdvanceHeld")
goto Ready2
Flash_Slide:
TNT1 A 1
7S02 A 1
7S02 B 1
7S02 C 1
7S02 D 1
7S02 E 4
7S02 D 3
7S02 C 2
7S02 B 2
7S02 A 1
stop

Altfire:
7H02 A 0 A_JumpIfInventory("S_NegaDuckAmmo",100,"Altfire2")
7H02 A 0 A_GiveInventory("S_NegaDuckAmmo",1)
goto Ready2
Altfire2:
// 7H02 A 0 A_TakeInventory("S_NegaDuckAmmo",100)
7H02 A 0 A_GiveInventory("SlideVivifyFlag")
7H02 A 0 A_Refire(1)
7H02 A 0 A_GiveInventory("S_NegaSlideDelay")
7H02 A 0 A_GiveInventory("S_NegaSlideAmmo_P")
7H02 A 0 A_PlaySoundEx("weapon/tengudash","Weapon")
7H02 A 0 A_GiveInventory("S_NegaSlideBoost_P",1)
7H02 A 0 A_GunFlash("Flash_Slide")
7H02 A 1 Offset(8, 40) A_TakeInventory("SlideVivifyFlag")
7H02 A 1 Offset(16, 48) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(24, 56)
7H02 A 1 Offset(40, 72) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(56, 88)
7H02 A 1 Offset(74, 104) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(74, 102)
7H02 A 1 Offset(70, 104) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(70, 102)
7H02 A 3 Offset(54, 86) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 2 Offset(38, 70) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 2 Offset(22, 54) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(14, 46) A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
7H02 A 1 Offset(6, 38)
Goto Ready2


// 7H02 A 1 Offset(11,50)A_GunFlash
// 7H02 A 2 Offset(22,68)A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
// 7H02 AAAA 2 Offset(33,104)A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
// 7H02 AA 2 Offset(22,68)A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
// 7H02 AA 2 Offset(11,50)A_FireCustomMissile("S_NegaSlideKick",0,0,0,0)
Goto Ready2
}
}



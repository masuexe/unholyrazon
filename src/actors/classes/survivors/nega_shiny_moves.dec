actor NegaShiny_Skull_W : NegaShinyMoveBase_W
{
States
{
Select:
	7H02 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
	7H02 A 0 A_WeaponReady(14)
	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 2, "Negaman4_2")
	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 3, "Negaman4_3")

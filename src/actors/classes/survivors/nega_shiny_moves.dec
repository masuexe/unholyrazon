	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 2, "NegamanK_2")
	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 3, "NegamanK_3")
	goto NegamanK_1
NegamanK_1:
7H02 B 3 A_TakeInventory("VivifyDelay8",999)
7H02 C 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
7H02 C 3 A_FireCustomMissile("S_NegaBalladeCracker",0,0,8,0)
7H02 B 3
goto NegaKHold_1
NegamanK_2:
7H02 B 3 A_TakeInventory("VivifyDelay8",999)
7H02 C 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
7H02 C 3 A_FireCustomMissile("S_NegaBalladeCracker2",0,0,8,0)
7H02 B 3
goto NegaKHold_2

// Vanilla NegaManShiny slots 1..25 as slotless move-weapons.
// Select branches on uh_ShinyNegaGetChargeLevel (1/2/3).
// Flag advance on full charge is done by ACS dispatcher (not in L3 bodies).

actor NegaShinyMoveBase_W : BaseMM8BDMWep_UH
{
	weapon.ammotype "S_NegaDuckAmmo"
	weapon.ammouse 0
	Weapon.UpSound ""
	+WEAPON.NOALERT
States
{
Spawn:
	7H02 [ 6
	loop
Deselect:
	TNT1 A 0 Offset(1, 128) A_Lower
Select:
	7H02 A 0
	goto Ready
Ready:
Fire:
AltFire:
	7H02 A 1 A_WeaponReady
	wait
MoveReturn:
	TNT1 A 0 ACS_NamedExecuteAlways("uh_ShinyMoveReturn_cs", 0)
	TNT1 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
	goto Deselect
Fire2End:  // 14 tics
7H02 CB 4
7H02 A 6
goto MoveReturn
Fire3End:  // 9 tics
7H02 CBA 3
goto MoveReturn
}
}

actor NegaShiny_ThunderBeam_W : NegaShinyMoveBase_W
{
States
{
Select:
	7H02 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
	7H02 A 0 A_WeaponReady(14)
	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 2, "Negaman1_2")
	7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 3, "Negaman1_3")
	goto Negaman1_1
Negaman1_1:
7H02 C 0 A_PlaySoundEx("weapon/thunderbeam","Weapon")
7H02 C 0 A_FireCustomMissile("S_NegaThunderBeam",0,0,8,0)
7H02 CB 4
7H02 A 6
goto MoveReturn
Negaman1_2:
7H02 C 0 A_PlaySoundEx("weapon/thunderbeam","Weapon")
7H02 C 0 A_FireCustomMissile("S_NegaThunderBeam2",0,0,8,0)
goto Fire2End
Negaman1_3:
7H02 C 0 A_PlaySoundEx("weapon/thunderbeam","Weapon")
7H02 C 0 A_FireCustomMissile("S_NegaThunderBeam3",0,0,8,0)
goto Fire3End
}
}


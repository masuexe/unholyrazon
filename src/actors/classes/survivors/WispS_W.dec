actor WispS_W_ScriptBar : ScriptBar {}

actor WispS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Wisp_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_55"
Obituary "$OB_55W"
weapon.ammotype "WispSpiritAmmo"
weapon.ammotype2 "BewitchingHexAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H55 [ 6
loop

Deselect:
7H55 A 0 A_TakeInventory("PowerWispPortal")
goto DeselectSwap
Select:
7H55 A 0 A_TakeInventory("BewitchingHexAmmo")
goto SelectSwap

Ready:
7H55 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", WISP_SDYE)
7H55 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
7H55 A 0 A_JumpIfInventory("PowerWispPortal",1,1)
Goto Ready2
7H55 A 0 A_GunFlash("Flash",1)
Goto Ready2

Ready2:
7H55 ABCDEFGGFEDCBAABCDEFGGFEDCBAABCDEFGGFEDCBA 4 A_GiveInventory("Wisp_ReadyState_P")
7H55 A 0 A_GiveInventory("WispSpiritAmmo",1)
loop

Fire:
7H55 H 0 A_GiveInventory("S_Wisp_Fire_P")
7H55 HIJK 2
goto Ready2

Flash:
TNT1 AAAA 1
TNT1 A 1 A_TakeInventory("BewitchingHexAmmo",1)
TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo",1,"Flash")
TNT1 A 0 A_TakeInventory("PowerWispPortal")
stop

Altfire:
7H55 A 0 A_JumpIfInventory("PowerWispPortal",1,"AltTele")
7H55 J 1
AltH1:
7H55 L 0 A_JumpIfInventory("BewitchingHexAmmo",56,"AltH5")
7H55 L 1 A_GiveInventory("S_Wisp_AltHold_P")
7H55 L 0 A_ReFire("AltH1")
goto AltHex
AltH5:
7H55 L 1 A_GiveInventory("S_Wisp_AltHoldTrick_P")
7H55 L 0 A_ReFire(1)
goto Alt2
7H55 Q 1
7H55 Q 0 A_ReFire(1)
goto Alt2
7H55 L 1 A_GiveInventory("S_Wisp_AltHoldTrick_P")
7H55 L 0 A_ReFire(1)
goto Alt2
7H55 Q 1
7H55 Q 0 A_ReFire("AltH5")
goto Alt2

AltHex:
7H55 M 2 A_GiveInventory("S_Wisp_AltShot_P")
7H55 N 2
7H55 O 2 A_TakeInventory("BewitchingHexAmmo")
7H55 P 6
7H55 ST 2
Goto Ready2
Alt2:
7H55 A 0 A_GiveInventory("S_Wisp_AltTeleStart_P")
7H55 A 0 A_ReFire(1)
7H55 MNO 2
7H55 PRPRPR 2
7H55 PPPS 2
7H55 T 2 A_GunFlash("Flash",1)
Goto Ready2
AltTele:
7H55 O 0 A_GiveInventory("S_Wisp_AltTele_P")
7H55 OUPUPPPST 2
goto Ready2


BotReady:
7H55 A 0 A_WeaponReady(12)
7H55 AAA 2 A_Refire("BotFire")
7H55 A 0 A_GiveInventory("BewitchingHexAmmo",1)
loop

BotFire:
7H55 A 0 A_JumpIfInventory("PowerWispPortal",1,"BotFireA2")
7H55 A 0 A_JumpIfInventory("BewitchingHexAmmo",56,"BotFireA")
7H55 A 0 A_Jump(32,"BotAlt0")
goto BotFire1
BotFireA:
7H55 A 0 A_Jump(96,"BotAlt1")
goto BotFire+2
BotFireA2:
7H55 A 0 A_Jump(64,1)
goto BotFire+2
7H55 A 0 A_Jump(24,1)
goto BotAlt2
7H55 A 0 A_PlaySoundEx("taunt/D_55","Voice")
7H55 A 0 A_GiveInventory("BewitchingHexAmmo",random(12,44))
goto BotAlt2

BotFire1:
7H55 H 0 A_Jump(4,"BotFireX1")
7H55 H 0 A_Jump(236,2)
7H55 H 0 A_FaceTarget
7H55 H 0 A_GiveInventory("S_Wisp_Fire_P")
7H55 HIJ 2
7H55 K 2 A_GiveInventory("BewitchingHexAmmo",random(1,3))
BotWait:
7H55 A 1 A_JumpIfInventory("WispSpiritAmmo",1,"BotReady")
7H55 A 1 A_Jump(2,"BotAlt0")
loop
BotFireX1:
7H55 A 0 A_Recoil(random(-10,-20))
7H55 A 0 A_GiveInventory("WispSpiritAmmo",1)
7H55 A 0 A_GiveInventory("BewitchingHexAmmo",random(1,3)*14)
7H55 A 0 A_PlaySoundEx("taunt/D_55","Voice")
goto BotFire1+1

BotAlt0:
7H55 M 2 A_GiveInventory("S_Wisp_AltShot_P")
7H55 N 2
7H55 O 2 A_TakeInventory("BewitchingHexAmmo")
7H55 P 6
7H55 ST 2
Goto BotReady
BotAlt1:
7H55 A 0 A_ChangeVelocity(cos(pitch)*60,0,-sin(pitch)*60,3)
7H55 A 0 A_SpawnItemEx("WispAltfireFX_H",0,0,0,0,0,0,0,1)
7H55 A 0 A_GiveInventory("S_Wisp_AltTeleStart_P")
7H55 J 2
7H55 L 22
7H55 J 2
7H55 A 2 A_GunFlash("Flash",1)
Goto BotReady
BotAlt2:
7H55 O 0 A_GiveInventory("S_Wisp_AltTeleBot_P")
7H55 OUPUPPPST 2
goto BotReady


}
}

actor S_Wisp_AltHold_P : Wisp_AltHold_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo",0,1)
goto Ammo
TNT1 A 0 A_GiveInventory("Wisp_AltHoldTrick_P")
goto Ammo
}
}
actor S_Wisp_AltHoldTrick_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_WispChargeFX",random(-32,32),random(-32,32),8,momx,momy,12,0,8)
stop
}
}


actor S_Wisp_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("WispSpiritAmmo",1,1)
TNT1 A 0 A_PlaySound("wep/WispFire",1)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,2)
TNT1 A 0 A_FireCustomMissile("S_WispCutter",0,0,0,0)
stop
TNT1 A 0 A_SpawnItemEx("S_WispCutter",cos(-pitch)*60,0,32+(sin(-pitch)*60),cos(-pitch)*60,0,sin(-pitch)*60,0,32)
TNT1 A 0 A_SpawnItemEx("S_WispCutter2",cos(-pitch)*60,0,32+(sin(-pitch)*60),cos(-pitch)*60,0,sin(-pitch)*60,15,32)
TNT1 A 0 A_SpawnItemEx("S_WispCutter2",cos(-pitch)*60,0,32+(sin(-pitch)*60),cos(-pitch)*60,0,sin(-pitch)*60,-15,32)
stop
}
}

actor S_Wisp_AltShot_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_WispHexShotStart",0,0,32,cos(-pitch)*50,0,sin(-pitch)*50,0,32+512)//SXF_TRANSFERPITCH

TNT1 A 0 A_PlaySound("wep_L/firestorm",1)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,1)
stop
TNT1 A 0 A_SpawnItemEx("S_WispHexShotStart",0,0,32,cos(-pitch)*50,0,sin(-pitch)*50,15,32+512)
TNT1 A 0 A_SpawnItemEx("S_WispHexShotStart",0,0,32,cos(-pitch)*50,0,sin(-pitch)*50,-15,32+512)
stop
}
}

actor S_Wisp_AltTeleStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("VivifyDelay6",1)
TNT1 A 0 A_GiveInventory("WispPortalActive",1)
TNT1 A 0 A_GiveInventory("BewitchingHexAmmo",56)
TNT1 A 0 A_PlaySound("wep/WispAlt1",1)
TNT1 A 0 A_SpawnItemEx("S_WispPortChecker",0,0,0,0,0,0,0,1)
stop
}
}

actor S_Wisp_AltTele_P : Wisp_AltTele_P
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("S_Wisp_AltShot_P")
TNT1 A 0
goto Wisp_AltTele_P::Pickup+1
Spawner:
TNT1 A 0 A_SpawnItemEx("S_WispPortChecker",0,0,0,0,0,0,0,1)
goto End
}
}
actor S_Wisp_AltTeleBot_P : S_Wisp_AltTele_P
{
States
{
Pickup:
goto Super::Pickup+1
}
}


actor S_WispChargeFX : WispChargeFX
{
Translation "192:192=66:66","198:198=60:60","202:202=56:56","199:199=61:61"
}


actor S_WispKindle_H : WispKindle_H
{
Translation "192:192=66:66","198:198=60:60"
}


actor S_WispCutter : WispCutter
{
Translation "192:192=66:66","198:198=60:60"
Args 30,56,56,15//15,56,56,15
}
actor S_WispCutter2 : S_WispCutter
{
RenderStyle Translucent
Alpha 0.75
States
{
Death:
TNT1 A 1
stop
}
}

actor S_WispHexShotStart : WispHexShotStart
{
Translation "192:192=66:66","198:198=60:60"
//Mass 50 //Speed
Args 75,56,56,10//50,56,56,10
}

actor S_WispHexBurn : WispHexBurn
{
Translation "192:192=66:66","198:198=60:60"
Accuracy 15//6
Meleerange 200//150
}

actor S_WispPortChecker : WispPortChecker
{
Args 150,128,64//100,128,64
}

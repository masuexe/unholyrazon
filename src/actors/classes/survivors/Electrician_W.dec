Actor Electrician_LBolt_EXT : Electrician_LBolt
{
-FLOORHUGGER
+CLIENTSIDEONLY
+NOINTERACTION
States
{
Spawn:
X_BC S 0 
X_BC S 0 A_JumpIf(ceilingz-z <= 32,"Death")
X_BC S 0 A_SpawnItemEx("Electrician_LBolt_EXT",0,0,160,0,0,0,0,1)
X_BC SSTU 1
stop
Death:
TNT1 A 1
stop
}
}


actor Electrician_W_NormalBar : NormalBar {args 228, 164}

actor Electrician_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 45
Weapon.AmmoGive 180
Inventory.Pickupmessage "$PU_20"
Obituary "$OB_20W"
Tag "$TAG_Electrician_W"
weapon.ammotype "ElectricEnergyAmmo"
States
{
Spawn:
6H20 [ 6
loop

Deselect:
6H20 A 0
goto DeselectSwap
Select:
6H20 A 0
goto SelectSwap

Ready:
6H20 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ELECTRICIAN_DYE)
6H20 A 0 A_GunFlash("Flash",1)
Goto Ready2
Ready2:
6H20 A 2 A_WeaponReady
6H20 A 0 A_GiveInventory("ElectricEnergyAmmo",1)//3
loop

Fire:
6H20 F 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H20 H 0 A_GiveInventory("Electrician_Fire_P")
6H20 J 0 A_RailWait
6H20 FGHIJ 2
TNT1 A 2 A_RailWait
6H20 KLM 2
6H20 L 0 A_RailWait
6H20 A 2
Goto Ready2

Flash:
TNT1 A 2 A_GiveInventory("Electrician_Flash_P")
loop

BotFire:
6H20 A 0 A_JumpIfInventory("ElectricEnergyAmmo",0,"BotFire2")
6H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(25,65))
6H20 A 0 A_Jump(16,"BotFire1")
6H20 A 0 A_JumpIfCloser(512,"BotAlt")
6H20 A 0 A_Jump(16,1)
goto Fire+1
6H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(75,210))
goto Fire+1
BotFire1:
6H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(135,180))
6H20 A 0 A_PlaySoundEx("taunt/D_20","Voice")
6H20 A 0 A_FireCustomMissile("ElectricianShotBit",20,0,8,0)
6H20 A 0 A_FireCustomMissile("ElectricianShotBit",10,0,8,0)
6H20 A 0 A_FireCustomMissile("ElectricianShotBit",-10,0,8,0)
6H20 A 0 A_FireCustomMissile("ElectricianShotBit",-20,0,8,0)
goto BotFire2
BotFire2:
6H20 A 0 A_Jump(128,"AltFireOld")
goto Fire+1
BotAlt:
6H20 Q 2 A_GiveInventory("VivifyFlag1",1)
BotAltH:
6H20 X 1 A_GiveInventory("Electrician_Alt_P")
6H20 S 2
6H20 S 0 A_ReFire(1)
goto AltFireEnd
6H20 A 0 A_Jump(1,2)
6H20 A 0 A_JumpIfCloser(512,"BotAlt")
goto AltFireEnd
6H20 Q 2 A_TakeInventory("VivifyFlag1")
goto BotFire1+1

AltFire:
//6H20 Q 0 A_FireCustomMissile("ElectricianRipperingShot",0,0,8,0)
6H20 Q 2 A_GiveInventory("VivifyFlag1",1)
AltFireH:
6H20 R 1 A_GiveInventory("Electrician_Alt_P")
6H20 S 2
6H20 S 0 A_ReFire(1)
goto AltFireEnd
6H20 T 1 A_GiveInventory("Electrician_Alt_P")
6H20 U 2
6H20 U 0 A_ReFire(1)
goto AltFireEnd
6H20 V 1 A_GiveInventory("Electrician_Alt_P")
6H20 W 2
6H20 W 0 A_ReFire(1)
goto AltFireEnd
6H20 X 1 A_GiveInventory("Electrician_Alt_P")
6H20 Y 2
6H20 Y 0 A_ReFire("AltFireH")
goto AltFireEnd
AltFireEnd:
6H20 Q 2 A_TakeInventory("VivifyFlag1")
6H20 A 4
Goto Ready2
AltFireOld:
6H20 Q 0 A_TakeInventory("ElectricEnergyAmmo",60,1)
6H20 Q 0 A_TakeInventory("ElectricEnergyAmmo",30)
6H20 Q 0 A_PlaySound("weapon/thunderclaw",1)
6H20 Q 0 A_FireCustomMissile("ElectricianRipperingShot",0,0,8,0)
6H20 Q 1
6H20 XSSQA 2
Goto Ready2

}
}

actor ElectricEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 180
+INVENTORY.IGNORESKILL
}

actor Electrician_Flash_P : CustomInventory
{
States
{
Pickup:
//TNT1 A 0 A_LogInt( sqrt(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)/10 )
//TNT1 A 0 A_JumpIfInventory("VivifyFlag1",1,3)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",0,2)
TNT1 A 0 A_JumpIf(sqrt(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)/10 >= 1,2)
TNT1 A 0
stop
TNT1 A 0 A_GiveInventory("ElectricEnergyAmmo",sqrt(MOMX*MOMX+MOMY*MOMY+MOMZ*MOMZ)/10)
stop
}
}

actor Electrician_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",180,8)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",135,6)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",90,4)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",45,2)
TNT1 A 0 A_FireCustomMissile("ElectricianShot",0,0,8,0)
goto Firin+1
TNT1 A 0 A_FireCustomMissile("ElectricianShot2",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("ElectricianShot3",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("ElectricianShot4",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("ElectricianShot5",0,1,8,0)
goto Firin
Firin:
TNT1 A 0 A_TakeInventory("ElectricEnergyAmmo",45)
TNT1 A 0 A_PlaySound("wep_L/ElectricianFire2",1)//weapon/thunderbolt
stop
}
}
actor Electrician_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/ElectricianAlt2",1)//weapon/electricshock
TNT1 A 0 A_FireCustomMissile("ElectricianLaserDam",0,0,8,0)
TNT1 A 0 A_FireCustomMissile("ElectricianLaserLine_H",0,0,8,0)
TNT1 A 0 A_TakeInventory("ElectricEnergyAmmo",1,1)
stop
}
}

actor ElectricianShot : BasicProjectile

actor FrostBite : CustWepClassBase {
  Player.ScoreIcon "UMUG_9"
  Player.DisplayName "FrostBite"
  Player.SoundClass "FrostBite"
  Player.MaxHealth 1200
  Health 1200
  Player.ForwardMove 0.98, 0.98
  Player.SideMove 0.98, 0.98
  Player.JumpZ 13
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "FrostBite_W"
  Player.StartItem "ColdEnergyAmmo", 225

  damagefactor "Ice", 0.5

  States {
   Spawn:
    FREE A 0
    FREE B 1
    FREE A 1
    goto Spawn+2
   See:
    FREE BCDE 5
    goto Spawn
   Missile:
    FREE FFFFF 1
    FREE GGGG 1
    goto Spawn+2
   ClassPain:
    FREE I 0
    goto MegamanPain

   ClassDeath:
    FREE U 0
    goto MegamanDeath
   MegamanIce:
    FREE U 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_ICEDEATH, TCLR_ICEDEATH)  // DYE_ICEDEATHCBM
    FREE U 1 A_PlaySoundEx("*icefreze", "Voice")
    FREE U 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanIceGib")
    goto MegamanDeath0+1
   MegamanDeath0:
    FREE U 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FREE U 0 A_PlaySound("*death", 2)
    FREE UUVWX 4
    FREE Z 0 A_SpawnItemEx("FrostBiteExplosionDeath", 0, 0, 0, 0, 0, 0, 0, 1)
    FREE Z 1
    goto MegamanErase
   MegamanDisintegrate:
    FREE Z 0 A_SpawnItemEx("Corpse_09", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor FrostBiteShiny : FrostBite {
  Player.ScoreIcon "UMUG_S9"
  Player.MaxHealth 3200
  Health 3200
  Player.ForwardMove 1.08, 1.08
  Player.SideMove 1.08, 1.08
  Player.JumpZ 14
  Player.MorphWeapon "FrostBiteShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    FREE U 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FREE U 0 A_PlaySound("*death", 2)
    FREE UUVWX 4
    FREE Z 0 A_SpawnItemEx("S_FrostBiteExplosionDeath", 0, 0, 0, 0, 0, 0, 0, 1)
    FREE Z 1
    goto MegamanErase
  }
}

actor Corpse_09 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_09_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_09_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


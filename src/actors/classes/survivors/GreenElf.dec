actor GreenElf : CustWepClassBase {
  Player.ScoreIcon "UMUG_47"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "GreenElf"
  Player.SoundClass "GreenElf"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.125, 1.125
  Player.SideMove 1.10, 1.10
  Player.JumpZ 13
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "GreenElf_W"
  Player.StartItem "StolenTreasureAmmo", 150

  Player.StartItem "WallJumpLimit", 7
  States {
   Spawn:
    CENT A 0
    CENT B 1
    CENT A 1
    goto Spawn+2
   See:
    CENT BCDE 5
    goto Spawn
   Missile:
    CENT F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile2")
    CENT F 5
    CENT G 4
    goto Spawn+2
   Missile2:
    CENT M 3
    CENT N 7
    CENT M 3
    goto Spawn+1
   ClassPain:
    CENT H 0
    goto MegamanPain

   ClassDeath:
    CENT H 0
    goto MegamanDeath
   MegamanDeath0:
    CENT H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CENT H 0 A_SpawnItemEx("GauntletTreasure_P", 0, 0, Height / 2, random2() / 256.0, random2() / 256.0, 5.0 + random2() / 64.0)
    goto MegamanFade3
   MegamanDisintegrate:
    CENT Z 0 A_SpawnItemEx("Corpse_47", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor GreenElfShiny : GreenElf {
  Player.ScoreIcon "UMUG_S47"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.225, 1.225
  Player.SideMove 1.20, 1.20
  Player.JumpZ 14
  Player.MorphWeapon "GreenElfShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_47 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_47_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_47_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_47_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_47_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_47_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 HHHH 0 A_SpawnItemEx("Corpse_47_5678", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_47_0 : BaseCorpseFX {States {Spawn: 1H47 O 350
    goto Spawn2}}
actor Corpse_47_1 : BaseCorpseFX {States {Spawn: 1H47 P 350
    goto Spawn2}}
actor Corpse_47_2 : BaseCorpseFX {States {Spawn: 1H47 Q 350
    goto Spawn2}}
actor Corpse_47_3 : BaseCorpseFX {States {Spawn: 1H47 R 350
    goto Spawn2}}
actor Corpse_47_4 : BaseCorpseFX {States {Spawn: 1H47 S 350
    goto Spawn2}}
actor Corpse_47_5678 : BaseCorpseFX {
  States {
   Spawn:
    1H47 T 0
    1H47 T 0 A_Jump(128, 2)
    1H47 T 350
    goto Spawn2
    1H47 U 350
    goto Spawn2
  }
}

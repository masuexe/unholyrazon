actor GreenElf : CustWepClassBase
{
player.scoreIcon "UMUG_47"
player.displayname "GreenElf"
player.soundclass "GreenElf"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.125, 1.125
player.sidemove 1.10, 1.10
player.jumpz 13
Player.StartItem "UH_BaseFlagPack"
player.startitem "GreenElf_W"
player.startitem "StolenTreasureAmmo", 150

player.startitem "WallJumpLimit", 7
States
{
Spawn:
CENT A 0
CENT B 1
CENT A 1
Goto Spawn+2
See:
CENT BCDE 5
Goto Spawn
Missile:
CENT F 0 A_JumpIfInventory("VivifyDelay4",1,"Missile2")
CENT F 5
CENT G 4
goto Spawn+2
Missile2:
CENT M 3
CENT N 7
CENT M 3
goto Spawn+1
ClassPain: CENT H 0
Goto MegamanPain

ClassDeath:
CENT H 0
goto MegamanDeath
MegamanDeath0:
CENT H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
CENT H 0 A_SpawnItemEx("GauntletTreasure_P",0,0,Height/2,random2()/256.0,random2()/256.0,5.0+random2()/64.0)
Goto MegamanFade3
MegamanDisintegrate:
CENT Z 0 A_SpawnItemEx("Corpse_47",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor GreenElfS : GreenElf
{
player.scoreIcon "UMUG_S47"
Player.Maxhealth 3000
health 3000
player.forwardmove 1.225, 1.225
player.sidemove 1.20, 1.20
player.jumpz 14
player.morphweapon "GreenElfS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}

actor Corpse_47:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_47_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_47_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_47_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_47_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_47_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 HHHH 0 A_SpawnItemEx("Corpse_47_5678",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


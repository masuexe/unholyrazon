actor HeavyGunner : CustWepClassBase
{
player.scoreIcon "UMUG_16"
player.displayname "HeavyGunner"
player.soundclass "HeavyGunner"
player.maxhealth 1500
health 1500
player.forwardmove 0.6, 0.6
player.sidemove 0.4, 0.4
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "HeavyGunner_W"
player.startitem "MachineEnergyAmmo", 400

States
{
Spawn:
DAR1 A 0
DAR1 B 1
DAR1 A 1
Goto Spawn+2
See:
DAR1 BCDE 5
Goto Spawn
Missile:
DAR1 F 0 A_JumpIfInventory("VivifyDelay1",1,"Missile2")
DAR1 F 0 A_JumpIfInventory("VivifyDelay4",1,"Missile3")
DAR1 F 4
DAR1 R 4
goto Spawn+2
Missile2:
DAR1 R 4
DAR1 F 4
goto Spawn+2
Missile3:
DAR1 S 10
goto Spawn+2
ClassPain:
DAR1 H 0
Goto MegamanPain

ClassDeath:
DARH H 0
goto MegamanDeath
MegamanDeath0:
DAR1 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathFX",0,0,32,0,0,0,0,1)
DAR1 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", BURNTDEATH_DYE,1)
DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathBoom",0,0,32,0,0,0,0,1)
DAR1 H 19
Goto MegamanFade
MegamanDisintegrate:
DAR1 Z 0 A_SpawnItemEx("Corpse_16",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor HeavyGunnerS : HeavyGunner
{
player.scoreIcon "UMUG_S16"
player.maxhealth 3500
health 3500
player.forwardmove 0.7, 0.7
player.sidemove 0.5, 0.5
player.jumpz 11
player.morphweapon "HeavyGunnerS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
DAR1 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathFX",0,0,32,0,0,0,0,1)
DAR1 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", BURNTDEATH_DYE,1)
DAR1 H 0 A_SpawnItemEx("S_HeavyGunnerDeathBoom",0,0,32,0,0,0,0,1)
DAR1 H 19
Goto MegamanFade
}
}

actor HeavyGunnerDeathFX : BasicExplosion
{
+FORCEXYBILLBOARD
+BRIGHT
Scale 2.5
States
{
Spawn:
X_8B A 0
X_8B A 0 A_SpawnItemEx("BasicBoom6FX_ColorX",0,0,0,0,0,0,0,1)
X_8B ABCDEF 2
stop
}
}

actor HeavyGunnerDeathBoom : BasicExplosion
{
Damagetype "HeavyBuster"
Obituary "$OB_16D"
+FORCEXYBILLBOARD
+BRIGHT
Scale 2.5
Args 363,198,16
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("weapon/hyperbomb",1)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
6P16 HIJKL 3
stop
}
}
actor S_HeavyGunnerDeathBoom : HeavyGunnerDeathBoom
{
Args 545,198,16
}



actor Corpse_16:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_16_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 HH 0 A_SpawnItemEx("Corpse_16_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_16_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_16_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 HH 0 A_SpawnItemEx("Corpse_16_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


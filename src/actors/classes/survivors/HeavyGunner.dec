actor HeavyGunner : CustWepClassBase {
  Player.ScoreIcon "UMUG_16"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "HeavyGunner"
  Player.SoundClass "HeavyGunner"
  Player.MaxHealth 1500
  Health 1500
  Player.ForwardMove 0.6, 0.6
  Player.SideMove 0.4, 0.4
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "HeavyGunner_W"
  Player.StartItem "MachineEnergyAmmo", 400

  States {
   Spawn:
    DAR1 A 0
    DAR1 B 1
    DAR1 A 1
    goto Spawn+2
   See:
    DAR1 BCDE 5
    goto Spawn
   Missile:
    DAR1 F 0 A_JumpIfInventory("VivifyDelay1", 1, "Missile2")
    DAR1 F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile3")
    DAR1 F 4
    DAR1 R 4
    goto Spawn+2
   Missile2:
    DAR1 R 4
    DAR1 F 4
    goto Spawn+2
   Missile3:
    DAR1 S 10
    goto Spawn+2
   ClassPain:
    DAR1 H 0
    goto MegamanPain

   ClassDeath:
    DARH H 0
    goto MegamanDeath
   MegamanDeath0:
    DAR1 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    DAR1 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", BURNTDEATH_DYE, 1)
    DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathBoom", 0, 0, 32, 0, 0, 0, 0, 1)
    DAR1 H 19
    goto MegamanFade
   MegamanDisintegrate:
    DAR1 Z 0 A_SpawnItemEx("Corpse_16", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor HeavyGunnerShiny : HeavyGunner {
  Player.ScoreIcon "UMUG_S16"
  Player.MaxHealth 3500
  Health 3500
  Player.ForwardMove 0.7, 0.7
  Player.SideMove 0.5, 0.5
  Player.JumpZ 11
  Player.MorphWeapon "HeavyGunnerShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    DAR1 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DAR1 H 0 A_SpawnItemEx("HeavyGunnerDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    DAR1 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", BURNTDEATH_DYE, 1)
    DAR1 H 0 A_SpawnItemEx("S_HeavyGunnerDeathBoom", 0, 0, 32, 0, 0, 0, 0, 1)
    DAR1 H 19
    goto MegamanFade
  }
}

actor HeavyGunnerDeathFX : BasicExplosion {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  States {
   Spawn:
    X_8B A 0
    X_8B A 0 A_SpawnItemEx("BasicBoom6FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8B ABCDEF 2
    stop
  }
}

actor HeavyGunnerDeathBoom : BasicExplosion {
  DamageType "HeavyBuster"
  Obituary "$OB_16D"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  Args 363, 198, 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapon/hyperbomb", 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    6P16 HIJKL 3
    stop
  }
}
actor S_HeavyGunnerDeathBoom : HeavyGunnerDeathBoom {
  Args 545, 198, 16
}



actor Corpse_16 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_16_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 HH 0 A_SpawnItemEx("Corpse_16_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_16_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_16_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 HH 0 A_SpawnItemEx("Corpse_16_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_16_0 : BaseCorpseFX {States {Spawn: 1H16 O 350
    goto Spawn2}}
actor Corpse_16_1 : BaseCorpseFX {States {Spawn: 1H16 P 350
    goto Spawn2}}
actor Corpse_16_2 : BaseCorpseFX {States {Spawn: 1H16 Q 350
    goto Spawn2}}
actor Corpse_16_3 : BaseCorpseFX {States {Spawn: 1H16 R 350
    goto Spawn2}}
actor Corpse_16_4 : BaseCorpseFX {States {Spawn: 1H16 S 350
    goto Spawn2}}

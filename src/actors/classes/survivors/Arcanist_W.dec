    6I12 A 0 A_Jump(64, "BotAlt")
    6I12 A 0 A_Jump(32, "AltFireOld")
    goto BotFire

   BotFire:
    6I12 B 0 A_GiveInventory("VivifyDelay1", 1)
    6I12 C 0 A_ReFire(1)
    6I12 D 0 A_PlaySound("wep_L/RBloodCast1", 4)
    6I12 BC 2
    6I12 DEFGDEFGDEFG 2
    6I12 D 1
    6I12 I 0 A_GiveInventory("Arcanist_Fire_P2")
    6I12 HIJ 2
    6I12 KK 2 A_RailWait
    6I12 LMNA 2
    goto BotReady

   BotAlt:
    6I12 O 0 A_GiveInventory("Arcanist_AltCycle_P")
    6I12 O 0 A_ReFire(1)
    6I12 OOP 2 A_GiveInventory("CatalyticRuneAmmo", 8)
    6I12 P 2 A_TakeInventory("VivifyFlag1")
    6I12 P 0 A_Jump(32, "BotAlt")
    goto BotReady
  }
}


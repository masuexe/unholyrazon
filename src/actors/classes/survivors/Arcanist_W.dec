actor CatalyticRuneAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 112
  +INVENTORY.IGNORESKILL
}

actor ArcanistCycle_F : Inventory {
  inventory.maxamount 3
}

actor Arcanist_ReadyState_P : CustomInventory {
  States {
   Pickup:
    /*
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F",3,"Check4")
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F",2,"Check3")
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F",1,"Check2")
    goto Ready
    Check2:
    TNT1 A 0 A_JumpIfInventory("CatalyticRuneAmmo",18,"Ready")
    goto ReadyF
    Check3:
    TNT1 A 0 A_JumpIfInventory("CatalyticRuneAmmo",37,"Ready")
    goto ReadyF
    Check4:
    */
    TNT1 A 0 A_JumpIfInventory("CatalyticRuneAmmo", 0, "Ready")
    goto ReadyF
   Ready:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   ReadyF:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("CatalyticRuneAmmo", 2)
    stop
  }
}

actor Arcanist_AltCycle_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE|WRF_DISABLESWITCH)
    TNT1 A 0 A_GiveInventory("VivifyFlag1", 1)
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F", 3, "Take")
    TNT1 A 0 A_GiveInventory("ArcanistCycle_F", 1)
    TNT1 A 0 A_PlaySound("wep_L/RC_SpellOk", 1)
    stop
   Take:
    TNT1 A 0 A_TakeInventory("ArcanistCycle_F")
    TNT1 A 0 A_PlaySound("wep_L/RC_SpellFail", 1)
    stop
  }
}

actor Arcanist_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep_L/RIceCast2", 1)
    goto Take0
   Take0:
    TNT1 A 0 A_GiveInventory("VivifyDelay3", 1)
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F", 3, "Take4")
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F", 2, "Take3")
    TNT1 A 0 A_JumpIfInventory("ArcanistCycle_F", 1, "Take2")
   Take1:
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 1, 1)
    TNT1 A 0 A_Jump(256, "Shot1")
    stop
   Take2:
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 19, 1)
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 19)
    TNT1 A 0 A_Jump(256, "Shot2")
    stop
   Take3:
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 37, 1)
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 37)
    TNT1 A 0 A_Jump(256, "Shot3")
    stop
   Take4:
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 56, 1)
    TNT1 A 0 A_TakeInventory("CatalyticRuneAmmo", 56)
    TNT1 A 0 A_Jump(256, "Shot4")
    stop

   Shot1:
    TNT1 A 0 A_FireCustomMissile("AncientIceShot1", 0, 0, 0, 0)
    stop
   Shot2:
    TNT1 A 0 A_FireCustomMissile("AncientIceShot2", 0, 0, 0, 0)
    stop
   Shot3:
    TNT1 A 0 A_FireCustomMissile("AncientIceShot3", 0, 0, 0, 0)
    stop
   Shot4:
    TNT1 A 0 A_FireCustomMissile("AncientIceShot4", 0, 0, 0, 0)
    stop
  }
}

actor AncientSmoke1 : BasicProjectile {
  Damagetype "ArcaneAir"
  Obituary "$OB_12M41"
  //+THRUACTORS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +SKYEXPLODE
  +FORCEXYBILLBOARD
  WALLBOUNCEFACTOR 1.0
  BOUNCEFACTOR 1.0
  //BounceCount 5
  Damage (113)
  Radius 13
  Height 16
  Speed 24
  Scale 2.0
  States {
   Spawn:
    TNT1 A 0
    X_9B B 1
    X_9B C 1 A_ChangeFlag(THRUACTORS, 0)
    X_9B DEBCDEBCDEBCDE 1
    X_9B B 0 A_ScaleVelocity(-1)
    X_9B B 0 ThrustThing(0, 0, 1, 0)
    X_9B BCDEBCDEBCDEBCDEBCD 1
    stop
   Death:
    X_2B GHIJ 2
    stop
  }
}
actor AncientSmoke2 : AncientSmoke1 {
  Obituary "$OB_12M42"
  Speed 30
}
actor AncientSmoke3 : AncientSmoke1 {
  Obituary "$OB_12M43"
  Speed 36
}
actor AncientSmoke4 : AncientSmoke1 {
  Obituary "$OB_12M44"
  Speed 42
}
actor AncientSmoke1T : AncientSmoke1{+THRUACTORS}
actor AncientSmoke2T : AncientSmoke2{+THRUACTORS}
actor AncientSmoke3T : AncientSmoke3{+THRUACTORS}
actor AncientSmoke4T : AncientSmoke4{+THRUACTORS}

actor AncientSmokeFX : BasicClientSide {
  alpha 0.85
  scale 0.80
  ReactionTime 5
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3)
    X_2B ABC 2 ThrustThingZ(0, random(1, 3), 0, 1)
    X_2B C 0 A_Countdown
    goto Spawn+2
   Death:
    X_2B GHIJ 2
    stop
  }
}


actor MiasmicShot : BasicProjectile {
  Translation "192:192=250:250", "198:198=253:253"
  damagetype "Arcane"
  Obituary "$OB_12A"
  +SEEKERMISSILE
  +SCREENSEEKER
  +FORCEXYBILLBOARD
  ReactionTime 100
  Radius 5
  Height 5
  damage (61)
  speed 34
  States {
   Spawn:
    6P12 A 1 A_SeekerMissile(2, 12, SMF_LOOK, 50, 8)
    6P12 A 0 A_SpawnItemEx("MiasmicShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    6P12 A 1 A_SeekerMissile(2, 12, SMF_LOOK, 50, 8)
    6P12 A 0 A_SpawnItemEx("MiasmicShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    6P12 A 1 A_SeekerMissile(2, 12, SMF_LOOK, 50, 8)
    6P12 A 0 A_SpawnItemEx("MiasmicShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    6P12 A 0 A_CountDown
    loop
   Death:
    6P12 A 0 A_PlaySoundEx("wep_L/RMagicSplash", "Weapon")
    6P12 ABCD 1
    stop
  }
}

actor MiasmicShotFX : BasicClientSide {
  +FORCEXYBILLBOARD
  renderstyle "translucent"
  States {
   Spawn:
    TNT1 A 2
   SpawnL:
    6P12 B 0 A_SetScale(ScaleX-0.1)
    6P12 B 1 A_FadeOut(0.1)
    loop
  }
}

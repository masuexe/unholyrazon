actor Arcanist_W_ScriptBar : ScriptBar {}
actor Arcanist_W : BaseMM8BDMWep_UH {
  Translation "57:57=69:69", "60:60=74:74", "79:79=241:241"
  Weapon.AmmoUse 0
  Weapon.AmmoGive 500//Ancient Magicks
  Inventory.Pickupmessage "$PU_12_A"
  Obituary "$OB_12W1"
  Tag "$TAG_Arcanist_W"
  weapon.ammotype "CatalyticRuneAmmo"
  +WEAPON.NOAUTOAIM
  inventory.icon "C_I_12A"
  States {
   Spawn://Ice
    6H12 [ 6
    loop

   Deselect:
    6H12 A 0
    goto DeselectSwap
   Select:
    6H12 A 0
    goto SelectSwap

   Ready:
    6H12 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ARCANIST_DYE1)
    6H12 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2
   Ready2:
    6H12 A 2 A_GiveInventory("Arcanist_ReadyState_P")
    wait

   Fire:
    6H12 B 0 A_GiveInventory("VivifyDelay1", 1)
    6H12 C 0 A_ReFire(1)
    6H12 D 0 A_PlaySound("wep_L/RIceCast1", 4)
    6H12 BC 2
    6H12 DEFGDEFGDEF 2
    6H12 I 0 A_GiveInventory("Arcanist_Fire_P1")
    6H12 HIJ 2
    6H12 KK 6 A_RailWait
    6H12 LMNA 2
    goto Ready2

   AltFire:
    6H12 O 0 A_GiveInventory("Arcanist_AltCycle_P")
    6H12 O 0 A_ReFire("AltFireH")
   AltFireH:
    6H12 O 1 A_GiveInventory("CatalyticRuneAmmo", 1)
    6H12 P 1 A_ReFire("AltFireH")
    6H12 P 1 A_TakeInventory("VivifyFlag1")
    goto Ready2

   AltFireOld:
    "####" H 0 A_PlaySound("wep_L/RC_SpellOk", 1)
    "####" H 0 A_FireCustomMissile("MiasmicShot", 0, 0, 0, 0)
    "####" H 0 A_FireCustomMissile("MiasmicShot", 20, 0, 0, 0)
    "####" H 0 A_FireCustomMissile("MiasmicShot", -20, 0, 0, 0)
    "####" IJ 2
    "####" K 10 A_GiveInventory("CatalyticRuneAmmo", 28)
    "####" LMN 2
    "####" AA 1 A_Jump(256, "BotReady")
    Goto BotReady

   Flash.BotAmmo:
    TNT1 A 30
    TNT1 A 0 A_GiveInventory("CatalyticRuneAmmo", 112)
    stop

   BotReady0:
    "####" A 0 A_Jump(64, "BotSwap0")
    "####" A 0 A_ReFire(2)
    "####" A 0 A_Jump(256, "BotReady")
    Goto BotReady
    "####" A 0 A_Jump(32, "AltFireOld")
    "####" A 0 A_Jump(192, "BotAlt")
    "####" A 0 A_Jump(256, "BotReady")
    Goto BotReady
   BotSwap0:
    "####" A 0 A_Jump(256, 1, 2, 3, 4)
    "####" A 1 A_SelectWeapon("Arcanist_W2")
    goto BotReady+2
    "####" A 1 A_SelectWeapon("Arcanist_W2")
    goto BotReady+2
    "####" A 1 A_SelectWeapon("Arcanist_W3")
    goto BotReady+2
    "####" A 1 A_SelectWeapon("Arcanist_W4")
    goto BotReady+2

   BotReady:
    6H12 A 0 A_Jump(1, "BotReady0")
    6H12 A 0 A_JumpIfInventory("CatalyticRuneAmmo", 0, "BotReady2")
    6H12 A 2 A_WeaponReady(12)
    6H12 A 0 A_GiveInventory("CatalyticRuneAmmo", 3)
    loop
   BotReady2:
    6H12 A 0 A_WeaponReady(12)
    6H12 A 2 A_Refire("BotCheck")
    6H12 A 0 A_GiveInventory("CatalyticRuneAmmo", 3)
    loop

   BotSwap:
    6H12 A 0 A_GiveInventory("CatalyticRuneAmmo", random(1, 7)*10)
    6H12 A 0 A_PlaySound("taunt/D_12", 2)
    6H12 A 0 A_Jump(198, 1, 2, 3, 4)
    6H12 A 0 A_GunFlash("Flash.BotAmmo", 1)
    goto BotFire
    6H12 A 1 A_SelectWeapon("Arcanist_W2")
    goto BotReady
    6H12 A 1 A_SelectWeapon("Arcanist_W3")
    goto BotReady
    6H12 A 1 A_SelectWeapon("Arcanist_W4")
    goto BotReady

   BotCheck:
    6H12 A 0 A_Jump(24, "BotSwap")//12
    6H12 A 0 A_Jump(64, "BotAlt")//32
    6H12 A 0 A_Jump(32, "AltFireOld")
    goto BotFire

   BotFire:
    6H12 B 0 A_GiveInventory("VivifyDelay1", 1)
    6H12 C 0 A_ReFire(1)
    6H12 D 0 A_PlaySound("wep_L/RIceCast1", 4)
    6H12 BC 2
    6H12 DEFGDEFGDEF 2
    6H12 I 0 A_GiveInventory("Arcanist_Fire_P1")
    6H12 HIJ 2
    6H12 KK 6 A_RailWait
    6H12 LMNA 2
    goto BotReady

   BotAlt:
    6H12 O 0 A_GiveInventory("Arcanist_AltCycle_P")
    6H12 O 0 A_ReFire(1)
    6H12 OOP 2 A_GiveInventory("CatalyticRuneAmmo", 8)
    6H12 P 2 A_TakeInventory("VivifyFlag1")
    6H12 P 0 A_Jump(32, "BotAlt")
    goto BotReady
  }
}


    goto Spawn2}}
actor Corpse_24_3 : BaseCorpseFX {States {Spawn: 1H24 R 350
    goto Spawn2}}
actor Corpse_24_4 : BaseCorpseFX {States {Spawn: 1H24 S 350
    goto Spawn2}}
actor Corpse_24_5 : BaseCorpseFX {States {Spawn: 1H24 T 350
    goto Spawn2}}
actor Corpse_24_6 : BaseCorpseFX {States {Spawn: 1H24 U 350

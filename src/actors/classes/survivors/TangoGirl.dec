actor TangoGirl : CustWepClassBase {
  Player.ScoreIcon "UMUG_24"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "TangoGirl"
  Player.SoundClass "TangoGirl"
  Player.MaxHealth 1500
  Health 1500
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "TangoGirl_W"
  Player.StartItem "TangoEnergyAmmo", 120
  States {
   Spawn:
    1H24 A 0
    1H24 B 1
    1H24 A 1
    goto Spawn+2
   See:
    1H24 BCDE 5
    goto Spawn
   Missile:
    1H24 FG 6
    goto Spawn+2
   ClassPain:
    1H24 H 0
    goto MegamanPain

   ClassDeath:
    1H24 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H24 H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H24 H 0 A_PlaySound("*death", 2)
    1H24 H 0 A_SpawnItemEx("TangoGirlCatAttackDeath", 0, 0, 12, 28, 0, 5, 0, 1)
    TNT1 A 1
    goto MegamanErase
   MegamanDisintegrate:
    1H24 Z 0 A_SpawnItemEx("Corpse_24", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TangoGirlShiny : TangoGirl {
  Player.ScoreIcon "UMUG_S24"
  Player.MaxHealth 3500
  Health 3500
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 11
  Player.MorphWeapon "TangoGirlShiny_W"
  +NOSKIN
  +PLAYERPAWN.NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H24 H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H24 H 0 A_PlaySound("*death", 2)
    1H24 H 0 A_SpawnItemEx("S_TangoGirlCatAttackDeath", 0, 0, 12, 28, 0, 5, 0, 1)
    TNT1 A 1
    goto MegamanErase
  }
}

actor TangoGirlCatAttackDeath : TangoGirlCatAttack {
  Obituary "$OB_24D"
  ReactionTime 16
  Damage (300)
  Radius 24  // 14
  Height 44  // 33
  Scale 3.5
}
actor S_TangoGirlCatAttackDeath : TangoGirlCatAttackDeath {
  Damage (450)
}

actor Corpse_24 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_24_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_24_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


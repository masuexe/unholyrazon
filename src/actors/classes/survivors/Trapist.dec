actor Trapist : CustWepClassBase {
  player.scoreIcon "UMUG_30"
  player.displayname "Trapist"
  player.soundclass "Trapist"
  Player.Maxhealth 925
  health 925
  player.forwardmove 1.2, 1.2
  player.sidemove 1.2, 1.2
  player.jumpz 10
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "Trapist_W"
  player.startitem "ClashEnergyAmmo", 80
  player.startitem "TrapistEnergyAmmo", 60
  States {
   Spawn:
    CRAM A 0
    CRAM B 1
    CRAM A 1
    Goto Spawn+2
   See:
    CRAM BCDE 5
    Goto Spawn
   Missile:
    CRAM FFFFF 1
    CRAM GGGG 1
    goto Spawn+2
   ClassPain: CRAM H 0
    Goto MegamanPain

   ClassDeath:
    CRAM H 0
    goto MegamanDeath
   MegamanDeath0:
    CRAM H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CRAM H 0 A_PlaySound("weapon/crashexplode", 1)
    CRAM HHH 8 A_SpawnItemEx("Trapist_DeathFX", 0, 0, 24, 0, 0, 0, 0, 1)
    CRAM H 0 A_SpawnItemEx("Trapist_BigDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    CRAM H 0 A_SpawnItemEx("TrapistMayhemBomb_H", 0, 0, 32, 0, 0, 0, 0, 1)
    Goto MegamanErase

   MegamanDisintegrate:
    CRAM Z 0 A_SpawnItemEx("Corpse_30", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TrapistShiny : Trapist {
  player.scoreIcon "UMUG_S30"
  Player.Maxhealth 2925
  health 2925
  player.forwardmove 1.3, 1.3
  player.sidemove 1.3, 1.3
  player.jumpz 11
  player.morphweapon "TrapistShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    CRAM H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CRAM H 0 A_PlaySound("weapon/crashexplode", 1)
    CRAM HHH 8 A_SpawnItemEx("Trapist_DeathFX", 0, 0, 24, 0, 0, 0, 0, 1)
    CRAM H 0 A_SpawnItemEx("Trapist_BigDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    CRAM H 0 A_SpawnItemEx("S_TrapistMayhemBomb_H", 0, 0, 32, 0, 0, 0, 0, 1)
    Goto MegamanErase
  }
}

actor Trapist_DeathFX : BasicExplosion {
  +BRIGHT
  +FORCEXYBILLBOARD
  scale 2.5
  States {
   Spawn:
    X_2E K 0
    X_2E KLMNOPQRSTVW 1
    stop
  }
}

actor Trapist_BigDeathFX : Trapist_DeathFX {
  States {
   Spawn:
    6Q30 X 0
    6Q30 XYZ 2
    stop
  }
}

actor TrapistMayhemBomb_H : BasicWatcher {
  Args 5
  States {
   Spawn:
    TNT1 A 0
    goto Total
   Total:
    TNT1 A 0 A_SpawnItemEx("TrapistMayhemBomb", random(4, 12), 0, 0, frandom(1, 2), 0, frandom(6, 8), Args[0]*60+random(-5, 5), 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
   Death:
    TNT1 AAAAAA 1 A_PlaySound("Bat_Rob/HealthBit", 1, 0.725)
    stop
  }
}
actor S_TrapistMayhemBomb_H : TrapistMayhemBomb_H {
  States {
   Spawn:
    TNT1 A 0
    goto Total
   Total:
    TNT1 A 0 A_SpawnItemEx("S_TrapistMayhemBomb", random(0, 8), 0, random(-8, 8), frandom(2, 3), 0, frandom(6, 8), Args[0]*60+random(-5, 5), 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}

actor TrapistMayhemBomb : TrapistFragShot {
  BounceSound ""
  DeathSound ""
  Obituary "$OB_30D"
  Damagetype "Trapist"
  +THRUACTORS
  -USEBOUNCESTATE
  bouncefactor 0.5
  wallbouncefactor 0.5
  bouncecount 2
  damage (0)
  speed 5
  Scale 2.0
  Args 4//2
  States {
   Spawn:
    6P30 E 0
    6P30 GFE random(0, 1)
   Total:
    6P30 AEBECEDE 1
    6P30 A 0 A_CountDownArg(0)
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("TrapistMayhemBombX", 0, 0, 7.5f, 0, 0, 0, 0, 1)
   DeathSnd:
    TNT1 A random(0, 3)
    TNT1 A 1 A_PlaySound("Trapist/Kaboom2", 1, 0.5, 0, 1.35)
    stop
  }
}

actor TrapistMayhemBombX : TrapistLobbedBlast {
  Obituary "$OB_30D"
  Damagetype "Trapist"
  Scale 2.0
  Args 50, 100, 8
}


actor S_TrapistMayhemBomb : TrapistMayhemBomb {
  States {
   Death:
    TNT1 A 0 A_SpawnItemEx("S_TrapistMayhemBombX", 0, 0, 7.5f, 0, 0, 0, 0, 1)
    goto DeathSnd
  }
}
actor S_TrapistMayhemBombX : TrapistMayhemBombX {
  Args 75, 100, 8
}


actor Corpse_30 : BasicWatcher {States{Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_30_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_30_1", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_30_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_30_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_30_4", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_30_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_30_0 : BaseCorpseFX {States {Spawn: 1H30 O 350
    goto Spawn2}}
actor Corpse_30_1 : BaseCorpseFX {States {Spawn: 1H30 P 350
    goto Spawn2}}
actor Corpse_30_2 : BaseCorpseFX {States {Spawn: 1H30 Q 350
    goto Spawn2}}
actor Corpse_30_3 : BaseCorpseFX {States {Spawn: 1H30 R 350
    goto Spawn2}}
actor Corpse_30_4 : BaseCorpseFX {States {Spawn: 1H30 S 350
    goto Spawn2}}
actor Corpse_30_5 : BaseCorpseFX {States {Spawn: 1H30 T 350
    goto Spawn2}}

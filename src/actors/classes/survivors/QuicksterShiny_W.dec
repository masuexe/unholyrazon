actor QuicksterShiny_W_NormalBar : NormalBar { Args 198, 199 }

actor QuicksterShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Quickster_W"
Weapon.AmmoUse 1
Inventory.Pickupmessage "$PU_07"
Obituary "$OB_07W"
weapon.ammotype "RapidEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H07 [ 6
loop

Deselect:
7H07 A 0
goto DeselectSwap
Select:
7H07 A 0
goto SelectSwap

Ready:
7H07 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", QUICKSTER_SDYE)
7H07 A 0 A_GunFlash
goto Ready2
Ready2:
7H07 A 2 A_WeaponReady
7H07 A 0 A_GiveInventory("RapidEnergyAmmo",1)
loop

Flash:
TNT1 A 1 A_GiveInventory("Quickster_Flash_P")
loop

Fire:
7H07 B 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H07 B 0 A_JumpIfNoAmmo("NoAmmoFire")
7H07 B 0 A_TakeInventory("RapidEnergyAmmo",2)
7H07 B 0 A_PlaySound("weapon/mbuster",1)
7H07 B 0 A_FireCustomMissile("S_RapidShot",random(-2,2),1,8,0)
7H07 BCA 2
Goto Ready2
NoAmmoFire:
7H07 C 0 A_PlaySound("Weapon/mbuster",1)
7H07 C 0 A_FireCustomMissile("S_NoHopeShot",random(-8,8),1,8,0,1,random(-4,4))
7H07 CB 2
Goto Ready2

Altfire:
7H07 A 0 A_JumpIfInventory("RapidEnergyAmmo",40,"FireTheFist")
AltfireH:
7H07 B 2 A_GiveInventory("S_Quickster_Alt_P")
7H07 B 0 A_ReFire(1)
goto Ready2
7H07 C 2 A_GiveInventory("S_Quickster_Alt_P")
7H07 C 0 A_ReFire("AltfireH")
goto Ready2
FireTheFist:
7H07 B 0 A_GiveInventory("S_Quickster_AltThrust_P")
7H07 CB 3
7H07 A 8
Goto Ready2

BotFire:
7H07 B 0 A_Jump(16,"BotFire2")
7H07 B 0 A_JumpIfCloser(128,"BotFire1")
7H07 B 0 A_Jump(8,"FireTheFist")
goto Fire+1
BotFire1:
7H07 B 2 A_GiveInventory("S_Quickster_Alt_P")
Goto Ready2
BotFire2:
7H07 B 0 A_PlaySoundEx("taunt/D_07","Voice")
7H07 B 0 A_JumpIfCloser(198,"FireTheFist")
7H07 B 0 A_JumpIfInventory("RapidEnergyAmmo",40,"FireTheFist")
7H07 B 0 A_GiveInventory("RapidEnergyAmmo",40)
goto BotFire+1
}
}

actor S_Quickster_Alt_P : Quickster_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_QuickJabbings",random(-10,10),0,8,0,1,random(-5,5))
goto End
}
}

actor S_Quickster_AltThrust_P : Quickster_AltThrust_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_DireJabShot",0,1,8,0)
goto Thrust
}
}

actor S_RapidShot : RapidShot
{
Translation "192:192=197:197","198:198=198:198","202:202=4:4","199:199=198:198"
Damage (150)//100
}

actor S_NoHopeShot : NoHopeShot
{
Translation "198:198=198:198"
Damage (75)//50
}

actor S_QuickJabbings : QuickJabbings
{
Translation "192:192=197:197"
Damage (38)//25
}

actor S_DireJabShot : DireJabShot
{
Translation "192:192=198:198","198:198=199:199"
Damage (938)//625
States
{
Spawn:
X_3D A 3
wait
}
}

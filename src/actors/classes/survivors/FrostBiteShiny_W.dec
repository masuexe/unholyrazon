actor FrostBiteShiny_W_ScriptBar : ScriptBar {}

actor FrostBiteShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_FrostBite_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_09"
Obituary "$OB_09W"
weapon.ammotype "ColdEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H09 [ 6
loop

Deselect:
7H09 A 0
goto DeselectSwap
Select:
7H09 A 0
goto SelectSwap

Ready:
7H09 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FROSTBITE_SDYE)
//7H09 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H09 A 2 A_GiveInventory("FrostBite_Ready_P",2)
loop

Fire:
7H09 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H09 B 0 A_GiveInventory("S_FrostBite_Fire_P")
7H09 CB 4
7H09 A 2
7H09 A 10 A_GiveInventory("ColdEnergyAmmo",5)
Goto Ready2

AltFire:
7H09 BC 2 A_GiveInventory("S_FrostBite_Alt_P")
Hail:
7H09 BC 2 A_GiveInventory("S_FrostBite_Alt_P")
7H09 B 0 A_ReFire(1)
Goto NoAmmoX
7H09 B 0 A_JumpIfInventory("ColdEnergyAmmo",2,1)
Goto NoAmmoX
7H09 BC 2 A_GiveInventory("S_FrostBite_Alt_P")
7H09 B 0 A_ReFire(1)
Goto NoAmmoX
7H09 B 0 A_JumpIfInventory("ColdEnergyAmmo",2,"Hail")
Goto NoAmmoX
NoAmmoX:
7H09 A 4
Goto Ready2

BotFire:
7H09 A 0 A_JumpIfInventory("ColdEnergyAmmo",300,"BotFire3")
7H09 A 0 A_GiveInventory("ColdEnergyAmmo",20)
7H09 A 0 A_Jump(16,"BotFire2")
7H09 A 0 A_Jump(128,"Hail")
7H09 A 0 A_Jump(24,"BotFire1")
goto Fire+1
BotFire1:
7H09 A 0 A_JumpIfInventory("FrostBiteFlag",28,2)
7H09 A 2 A_GiveInventory("FrostBiteFlag",2)
loop
7H09 A 0
goto Fire+1
BotFire2:
7H09 A 0 A_PlaySoundEx("classes/taunt/frostbite","Voice")
7H09 A 0 ThrustThingZ(0,42,0,0)
7H09 A 0 A_PlaySound("weapon/mbuster",1)
7H09 B 3 A_FireCustomMissile("S_FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
7H09 A 0 A_PlaySound("weapon/mbuster",1)
7H09 C 3 A_FireCustomMissile("S_FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
7H09 A 0 A_PlaySound("weapon/mbuster",1)
7H09 B 3 A_FireCustomMissile("S_FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
7H09 A 0 A_PlaySound("weapon/mbuster",1)
7H09 C 3 A_FireCustomMissile("S_FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
7H09 BAAA 2 A_GiveInventory("ColdEnergyAmmo",20)
Goto Ready2
BotFire3:
7H09 B 0 A_TakeInventory("ColdEnergyAmmo")
7H09 B 2
7H09 B 0 ThrustThingZ(0,40,0,0)
7H09 B 10
7H09 B 0 ThrustThingZ(0,-60,0,0)
7H09 A 0 A_PlaySoundEx("classes/taunt/frostbite","Voice")
7H09 BBBBBB 0 A_FireCustomMissile("S_FrostBiteRainSpawner",0,0,0,0)
7H09 B 2
7H09 B 10
Goto Ready2
}
}

actor S_FrostBite_Fire_P : FrostBite_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("FrostBiteFlag",28,"Fire2")
TNT1 A 0 A_PlaySound("wep_L/FrostB_Boom",1,0.75)
TNT1 A 0 A_FireCustomMissile("S_FrostBiteShot",0,0,8,0)
goto End
Fire2:
TNT1 A 0 A_PlaySound("wep_L/FrostB_Fire2",1)
TNT1 A 0 A_FireCustomMissile("S_FrostBiteShot2",0,0,8,0)
goto End
}
}

actor S_FrostBite_Alt_P : FrostBite_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_Jump(256,1,2)
TNT1 A 0 A_FireCustomMissile("S_FrostBiteMist",frandom(-4,4),0,8,0,1,frandom(-3,3))
goto Snd
TNT1 A 0 A_FireCustomMissile("S_FrostBiteMist2",frandom(-4,4),0,8,0,1,frandom(-3,3))
goto Snd
}
}


actor S_FrostBiteShot : FrostBiteShot
{
Translation "192:192=220:220","198:198=46:46","202:202=4:4","199:199=220:220"
Damage (303)//202
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 A 0 A_SpawnItemEx("S_FrostBiteShotBit",0,0,0,20*((ceilingz-z>height)&&(floorz-z!=0)),0,Args[4]*-5,0,1,0)
TNT1 AAAAAAA 0 A_SpawnItemEx("S_FrostBiteShotBit",0,0,0,random(1,15),0,random(1,15)*Args[4],random(0,359),1)
goto DeathEnd
}
}

actor S_FrostBiteShot2 : FrostBiteShot2
{
Translation "192:192=220:220","198:198=46:46","202:202=4:4","199:199=220:220"
Damage (681)//454
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 A 0 A_SpawnItemEx("S_FrostBiteShotBit",0,0,0,20*((ceilingz-z>height)&&(floorz-z!=0)),0,Args[4]*-5,0,1,0)
TNT1 AAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("S_FrostBiteShotBit",0,0,0,random(1,20),0,random(1,20)*Args[4],random(0,359),1)
goto DeathEnd
}
}


actor S_FrostBiteShotBit : FrostBiteShotBit
{
Damage (126)//84
States
{
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TNT1 A 0 A_CheckFloor("DeathF")
TNT1 A 0 A_CheckCeiling("DeathC")
TNT1 A 0 A_SpawnItemEx("S_FrostBiteSpike_W",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
DeathF:
TNT1 A 1 A_SpawnItemEx("S_FrostBiteSpike",0,0,0,0,0,0,0,1)
stop
DeathC:
TNT1 A 1 A_SpawnItemEx("S_FrostBiteSpike_C",0,0,0,0,0,0,0,1)
stop
}
}


actor S_FrostBiteMist : FrostBiteMist
{
Translation "192:192=220:220","198:198=46:46"
damage (78)//31
}

actor S_FrostBiteMist2 : S_FrostBiteMist
{
XScale -2.5
}

actor S_FrostBiteRainSpawner : FrostBiteRainSpawner
{
Translation "192:192=220:220","198:198=46:46"
States
{
Death:
TNT1 AAAAAAAAAA 3 A_SpawnItemEx("S_FrostBiteRainShot",random(300,-300),random(300,-300),-11,0,0,-20,random(0,359),1)
TNT1 A 1
stop
}
}

actor S_FrostBiteRainShot : FrostBiteRainShot
{
Damage (75)//50
States
{
Death:
TNT1 AAA 0 A_SpawnItemEx("S_FrostBiteShotBit",0,0,8,random(0,20),0,random(0,20),random(0,359),1)
TMFX ABCD 2
stop
}
}

actor S_FrostBiteSpike : FrostBiteSpike
{
Damage (113)//75
}

actor S_FrostBiteSpike_A : FrostBiteSpike_A
{
Damage (113)
}

actor S_FrostBiteSpike_W : FrostBiteSpike_W
{
Damage (113)
}

actor S_FrostBiteSpike_C : FrostBiteSpike_C
{
Damage (113)
}




actor S_FrostBiteExplosionDeath : FrostBiteExplosionDeath
{
Args 13
}

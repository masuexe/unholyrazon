actor TangoGirlShiny_W_ScriptBar : ScriptBar {}

actor TangoGirlShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_TangoGirl_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_24"
Obituary "$OB_24W"
weapon.ammotype "TangoEnergyAmmo"
States
{
Spawn:
7H24 [ 6
loop

Deselect:
7H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto DeselectSwap
7I24 A 0
goto DeselectSwap
Select:
7H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto SelectSwap
7I24 A 0
goto SelectSwap

Ready:
7H24 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TANGOGIRL_SDYE)
7H24 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready0
Ready0:
7H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,"Ready2")
7H24 A 2 A_GiveInventory("TangoGirl_Ready_P")
wait
Ready2:
7I24 A 2 A_GiveInventory("TangoGirl_Ready_P")
wait


Fire:
"####" B 1
"####" C 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" D 1 A_GunFlash("Flash",1)
"####" E 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" F 1
"####" G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" H 1
"####" I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" J 1
"####" K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" L 1
"####" M 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" N 1
"####" O 1 A_JumpIfInventory("PlayerPropertyRage",1,"Ready0")
goto Ready0

Flash:
TNT1 A 0 A_JumpIfInventory("DuoBusterFlag",1,7)
TNT1 A 1 A_GiveInventory("DuoBusterFlag")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire1_P2")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire2_P2")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire3_P2")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire4_P2")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire5_P2")
stop
TNT1 A 1 A_TakeInventory("DuoBusterFlag")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire1_P")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire2_P")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire3_P")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire4_P")
TNT1 A 2 A_GiveInventory("S_TangoGirl_Fire5_P")
stop

Altfire:
"####" S 2 A_PlaySound("item/tango",4,0.75)
"####" T 2 A_TakeInventory("SuplexID")
"####" U 0 A_GiveInventory("TangoGirl_Alt_P")
GrabbyLoop:
"####" U 0 A_JumpIfInventory("TangoGirlFlag",15,"GrabbyFail")
"####" U 1 A_GiveInventory("TangoGirlSuplexSpawn_P")
"####" U 0 A_JumpIfInventory("SuplexID",1,"GrabbySuplex")
loop
GrabbyFail:
"####" T 3
"####" S 3 A_GiveInventory("TangoGirlSuplexReset_P2")
goto Ready0
GrabbySuplex:
"####" T 2 A_PlaySoundEx("KirbyNES/FoeGrab","SoundSlot6")
"####" S 2
goto Ready0

BotReady:
7H24 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
7H24 A 0 A_WeaponReady(12)
7H24 A 2 A_Refire("BotFire")
7H24 A 0 A_GiveInventory("TangoEnergyAmmo",2)
goto BotReady+2
BotFire:
7H24 C 0 A_JumpIfInventory("TangoEnergyAmmo",0,"BotFire1")
7H24 C 0 A_Jump(14,"BotFireX")
7H24 C 2 A_GiveInventory("TangoEnergyAmmo",14)
7H24 D 2 A_GunFlash("Flash",1)
7H24 FHJLN 2
goto BotReady+2
BotFire1:
7H24 C 0 A_Jump(80,"BotFireX")
goto BotFire+2

BotFireX:
7H24 C 0 A_PlaySoundEx("taunt/D_24","Voice")
7H24 C 0 A_Warp(2,0,0,0,0,0,"BotFireX2")
7H24 C 0 A_TakeInventory("TangoEnergyAmmo",random(28,56))
7H24 C 2 A_FireCustomMissile("S_TangoGirlCatAttack",0,0,8,0)
goto BotFire+3
BotFireX2:
7H24 C 2 A_TakeInventory("TangoEnergyAmmo",random(100,200))
goto BotFire+3
}
}


actor Crystrap : CustWepClassBase {
  player.scoreIcon "UMUG_60"
  player.displayname "Crystrap"
  player.soundclass "Crystrap"
  Player.Maxhealth 1000
  health 1000
  player.forwardmove 0.90, 0.90
  player.sidemove 0.88, 0.88
  player.jumpz 14
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "Crystrap_W"
  player.startitem "CrystrapEnergyAmmo", 2
  // Translation "192:192=4:4", "198:198=96:96"
  States {
   Spawn:
    CRYM A 0
    CRYM B 1
    CRYM A 1
    Goto Spawn+2
   See:
    CRYM BCDE 5
    Goto Spawn
   Melee:
    CRYM FG 3
    goto Spawn+2
   Missile:
    CRYM FFFFF 1
    CRYM GGGG 1
    goto Spawn+2
   ClassPain:
    CRYM H 0
    Goto MegamanPain

   ClassDeath:
    CRYM H 0
    goto MegamanDeath
   MegamanDeath0:
    CRYM H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    CRYM H 0 A_PlaySound("*death", 2)
    CRYM H 19
    CRYM H 0 A_SpawnItemEx("CrystrapExplosionDeath", 0, 0, 0, 0, 0, 16, 0, 1)
    Goto MegamanErase
   MegamanDisintegrate:
    CRYM Z 0 A_SpawnItemEx("CorpseCrystrap", 0, 0, 0, momx, momy, momz, 0, 9)
    Goto MegamanCorpseEnd
  }
}
actor CrystrapShiny : Crystrap {
  player.scoreIcon "UMUG_S60"
  Player.Maxhealth 3000
  Health 3000
  player.forwardmove 0.90, 0.90
  player.sidemove 0.88, 0.88
  player.jumpz 14
  player.morphweapon "CrystrapShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    CRYM H 0 A_PlaySound("*death", 2)
    CRYM H 19
    CRYM H 0 A_SpawnItemEx("S_CrystrapExplosionDeath", 0, 0, 0, 0, 0, 16, 0, 1)
    Goto MegamanErase
  }
}


actor CrystrapExplosionDeath : BasicWatcher {
  args 16, 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/crystaleyesplit", 1)
    // TNT1 A 0 A_Explode(225*(1+args[0]*0.5),198,0)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 0, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 22.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 45, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 67.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 90, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 112.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 135, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 157.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 180, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 202.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 225, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 247.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 270, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 292.5, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 315, 1)
    CRYM H 0 A_SpawnItemEx("CrystrapShotBit_Death", 0, 0, 0, args[0], 0, args[0], 337.5, 1)
    TNT1 A 1
    stop
  }
}


actor CrystrapShotBit_Death : CrystrapShotBit {
  -NOGRAVITY
  Obituary "$OB_60D"
  damage (205)  // 328
}
actor S_CrystrapShotBit_Death : CrystrapShotBit_Death {
  damage (308)
}


actor FlightUnitS_W_NormalBar : NormalBar {args 128, 133}
actor FlightUnitS_W_SecondBar : SecondBar {args 86, 199}

actor FlightUnitS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_FlightUnit_W"
Weapon.AmmoUse 5
Weapon.AmmoUse2 0
Inventory.Pickupmessage "$PU_18"
Obituary "$OB_18W"
weapon.ammotype "DangerEnergyAmmo"
weapon.ammotype2 "FlightEnergyAmmo"
+WEAPON.ALT_AMMO_OPTIONAL
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H18 [ 6
loop

Deselect:
7H18 A 0
goto DeselectSwap
Select:
7H18 A 0
goto SelectSwap

Ready:
7H18 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", FLIGHTUNIT_SDYE)
7H18 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H18 A 2 A_GiveInventory("FlightUnit_Ready_P")
wait

Fire:
7H18 A 0 A_JumpIfInventory("DuoBusterFlag",1,"FireA")
7H18 A 0 A_GiveInventory("DuoBusterFlag",1)
7H18 D 2 A_GiveInventory("S_FlightUnit_Fire_P1")
7H18 E 2
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P2")
7H18 H 2
7H18 G 0 A_Refire("Fire2")
7H18 G 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
Fire2:
7H18 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H18 A 0 A_JumpIfNoAmmo(6)
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P1")
7H18 E 2
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P2")
7H18 H 2
7H18 G 0 A_Refire("Fire2")
7H18 G 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
FireA:
7H18 A 0 A_TakeInventory("DuoBusterFlag",9)
7H18 G 2 A_GiveInventory("S_FlightUnit_Fire_P2")
7H18 H 2
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P1")
7H18 E 2
7H18 D 0 A_Refire("FireA2")
7H18 D 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
FireA2:
7H18 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H18 A 0 A_JumpIfNoAmmo(6)
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P2")
7H18 H 2
7H18 B 2 A_GiveInventory("S_FlightUnit_Fire_P1")
7H18 E 2
7H18 D 0 A_Refire("FireA2")
7H18 D 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2

BotFire:
7H18 A 0 A_JumpIfNoAmmo("BotFire3")
7H18 A 0 A_JumpIfInventory("FlightEnergyAmmo",160,"AltFire")
7H18 A 0 A_Jump(16,"BotFire2")
7H18 A 0 A_Jump(32,1)
goto BotFire4
7H18 A 0 A_Jump(32,"AltFire")
7H18 A 0 A_GiveInventory("DangerEnergyAmmo",50)
goto BotFire4
BotFire2:
7H18 A 0 A_SpawnItemEx("HSH_DustBoostFX")
7H18 A 0 A_PlaySoundEx("taunt/D_18","Voice")
7H18 A 0 A_GiveInventory("BotFlagDelay",6)
goto BotFire2a
BotFire2a:
7H18 B 0 A_TakeInventory("BotFlagDelay",1)
7H18 B 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
7H18 BB 0 A_SpawnItemEx("S_DangerMissileBot",0,0,32,15,random(-32,32),random(-8,16))
7H18 BC 2
7H18 B 2 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
goto Ready2
BotFire3:
7H18 A 0 A_PlaySoundEx("weapon/pursuitfire","Weapon")
7H18 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
7H18 BC 2
7H18 CCCCCCCCCC 2 A_GiveInventory("DangerEnergyAmmo",20)
7H18 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
7H18 BA 2
goto BotFire4
BotFire4:
7H18 A 0 A_Refire("BotFire4a")
goto Ready2
BotFire4a:
7H18 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto Fire2+1
7H18 A 0
goto FireA2+1

Flash:
TNT1 A 1 A_GiveInventory("FlightUnit_Flash_P")
loop

AltFire:
7H18 B 2 A_GiveInventory("S_FlightUnit_Alt_P")
7H18 C 2 A_GiveInventory("DangerEnergyAmmo",8)
7H18 BA 2
Goto Ready2

}
}

actor S_FlightUnit_Fire_P1 : FlightUnit_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_FlightUnitBullet",random(-1,2),0,8,0)
goto Pickup2
}
}
actor S_FlightUnit_Fire_P2 : S_FlightUnit_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_FlightUnitBullet",random(-2,1),0,-8,0)
goto Pickup2
}
}

actor S_FlightUnit_Alt_P : FlightUnit_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_DangerMissile",0,0,0,0)
goto Thrust
}
}

actor S_FlightUnitBullet : FlightUnitBullet
{
Translation "192:192=128:128","198:198=133:133"
damage (30)//20
}

actor S_DangerMissile : DangerMissile
{
Translation "192:192=86:86","198:198=199:199"
damage (113)//75
Args 143,148,16//95
}

actor S_DangerMissileBot : DangerMissileBot
{
Translation "192:192=86:86","198:198=199:199"
damage (53)//35
Args 75,128,16//50
}

actor SmokeBanditShiny_W_ScriptBar : ScriptBar {}

actor SmokeBanditShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_SmokeBandit_W"
Weapon.AmmoUse 1
Inventory.Pickupmessage "$PU_28_A"
Obituary "$OB_28W"
weapon.ammotype "CigarAmmo"
weapon.ammotype2 "SmokinAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H28 [ 6
loop

Deselect:
7H28 A 0
goto DeselectSwap
Select:
7H28 A 0
goto SelectSwap

Ready:
7H28 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", SMOKEBANDIT_SDYE)
7H28 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
7H28 A 0 A_GunFlash("Flash",1)
Goto Ready1

Ready1:
7H28 A 0 A_JumpIfInventory("CigarAmmo",0,"Ready2")
Goto ReloadWait
Ready2:
7H28 A 4 A_WeaponReady(WRF_NOSECONDARY)
7H28 A 4 A_GiveInventory("SmokeBandit_W_Ready_P")
wait

ReloadWait:
7H28 A 0 A_JumpIfNoAmmo(5)
7H28 A 4 A_WeaponReady(WRF_NOSECONDARY)
7H28 AAAAAA 4 A_GiveInventory("SmokeBandit_W_Ready_P")
goto ReloadStart

ReloadStart:
7H28 D 0 A_PlaySound("wep/SmokeB_Load2",1)
7H28 D 2 A_GiveInventory("SmokeBandit_W_Ready_P")
7H28 E 2 A_WeaponReady(WRF_NOSECONDARY)
7H28 F 2 A_GiveInventory("SmokeBandit_W_Ready_P")
7H28 G 2 A_WeaponReady(WRF_NOSECONDARY)
7H28 H 4 A_GiveInventory("SmokeBandit_W_Ready_P")
goto Reloading

Reloading:
7H28 I 0 A_PlaySound("wep/SmokeB_Load1",1)
7H28 I 2 A_GiveInventory("SmokeBandit_W_Ready_P")
7H28 H 2 A_WeaponReady(WRF_NOSECONDARY)
7H28 I 0 A_Giveinventory("CigarAmmo",1)
7H28 I 2 A_GiveInventory("SmokeBandit_W_Ready_P")
7H28 H 2 A_WeaponReady(WRF_NOSECONDARY)
7H28 H 0 A_JumpIfInventory("CigarAmmo",0,"Reloaded")
loop

Reloaded:
7H28 G 0 A_SpawnItemEx("SmokeBanditReloadedSnd_H",0,0,32)
7H28 G 2 A_GiveInventory("SmokeBandit_W_Ready_P")
7H28 E 2 A_WeaponReady(WRF_NOSECONDARY)
Goto Ready2+1

NoAmmo:
7H28 A 1 A_GiveInventory("S_SmokeBandit_Fire0_P")
7H28 A 0 A_Refire("FireH0")
Goto FireEnd

Fire:
7H28 A 0 A_JumpIfNoAmmo("NoAmmo")
7H28 A 1 A_GiveInventory("S_SmokeBandit_Fire_P")
7H28 A 0 A_Refire("FireH0")
Goto FireEnd
FireH0:
7H28 C 1 A_JumpIfInventory("PlayerPropertyRage",1,"FireH1")
7H28 C 0 A_Refire("FireH1")
goto FireEnd+1
FireH1:
7H28 C 1
7H28 B 0 A_Refire("FireH2")
goto FireEnd+1
FireH2:
7H28 B 1 A_JumpIfInventory("PlayerPropertyRage",1,"FireH3")
7H28 B 0 A_Refire("FireH3")
goto FireEnd+2
FireH3:
7H28 B 1
7H28 A 0 A_Refire("FireH4")
goto FireEnd+2
FireH4:
7H28 A 1 A_GiveInventory("SmokinAmmo",1)
7H28 A 0 A_Refire("FireH4")
goto Ready1
FireEnd:
7H28 C 2
7H28 B 2
7H28 A 2
goto Ready1

Flash:
TNT1 A 1 A_JumpIfInventory("SmokinAmmo",125,1)
wait
TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK,1)
wait
7H28 Q 0 A_GunFlash(1)
7H28 Q 2 A_GiveInventory("S_SmokeBandit_Alt_P")
7H28 RST 2
TNT1 A 4 A_RailWait
loop



BotReady:
7H28 A 0 A_WeaponReady(12)
7H28 A 2 A_Refire("BotCheck")
7H28 A 0 A_GiveInventory("SmokinAmmo",4)
loop

BotCheck:
7H28 A 0 A_JumpIfInventory("SmokinAmmo",250,"BotAlt")
7H28 A 0 A_Jump(16,"BotFireX")
7H28 A 0 A_Jump(24,1)
goto BotFire
7H28 A 0 A_Jump(32,"BotAlt")
7H28 A 0 A_GiveInventory("SmokinAmmo",25)
goto BotFire

BotFireX:
7H28 F 0 A_PlaySoundEx("taunt/D_28","Voice")
7H28 F 0 A_GiveInventory("SmokeBanditBotSpeed_P")
7H28 F 0 A_FireCustomMissile("S_SmokeBanditBombToss",30,0,8,0)
7H28 F 0 A_FireCustomMissile("S_SmokeBanditBombToss",0,0,8,0)
7H28 F 0 A_FireCustomMissile("S_SmokeBanditBombToss",-30,0,8,0)
7H28 F 0 A_GiveInventory("CigarAmmo",20)
goto BotFire+2

BotFire:
7H28 C 0 A_JumpIfNoAmmo("BotReload")
7H28 C 0 A_Jump(8,"BotFireX")
7H28 C 2 A_GiveInventory("S_SmokeBandit_Fire_P")
7H28 B 2 A_GiveInventory("SmokinAmmo",random(2,6))
7H28 A random(0,4)
7H28 A 0 A_Refire("BotFire")
goto BotReady

BotAlt:
7H28 Q 2 A_GiveInventory("S_SmokeBandit_Alt_P")
7H28 RST 2
TNT1 A 2
Goto BotReady

BotReload:
7H28 F 0 A_PlaySound("wep/SmokeB_Load0",1)
7H28 FH 2
7H28 I 0 A_PlaySound("wep/SmokeB_Load1",1)
7H28 I 2 A_Giveinventory("CigarAmmo",1)
7H28 H 2 A_GiveInventory("SmokinAmmo",12)
7H28 H 0 A_JumpIfInventory("CigarAmmo",0,1)
goto BotReload+3
7H28 G 2 A_PlaySound("wep/SmokeB_Load2",1)
7H28 E 2
Goto BotReady
}
}

actor S_SmokeBandit_Fire_P : SmokeBandit_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_SmokeRodeoShot",cos(-pitch)*14,8,32+(sin(-pitch)*14),cos(-pitch),0,sin(-pitch),0,32+SXF_TRANSFERPITCH+SXF_MULTIPLYSPEED)//512+8192
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),2)
goto Take
TNT1 A 0 A_SpawnItemEx("S_SmokeRodeoShot",cos(-pitch)*14,8,32+(sin(-pitch)*14),cos(-pitch),0,sin(-pitch),15,32+512+8192)
TNT1 A 0 A_SpawnItemEx("S_SmokeRodeoShot",cos(-pitch)*14,8,32+(sin(-pitch)*14),cos(-pitch),0,sin(-pitch),-15,32+512+8192)
goto Take
}
}
actor S_SmokeBandit_Fire0_P : SmokeBandit_Fire0_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_SmokeRodeoShot00",0,0,8,0)
goto Take
}
}

actor S_SmokeBandit_Alt_P : SmokeBandit_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_SmokeBandit_BombTrap",cos(-pitch)*20,0,32+(sin(-pitch)*20),cos(-pitch)*20,0,sin(-pitch)*20,0,32)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),2)
goto Take
TNT1 A 0 A_SpawnItemEx("S_SmokeBandit_BombTrap2",cos(-pitch)*20,0,32+(sin(-pitch)*20),cos(-pitch)*20,0,sin(-pitch)*20,15,32)
TNT1 A 0 A_SpawnItemEx("S_SmokeBandit_BombTrap2",cos(-pitch)*20,0,32+(sin(-pitch)*20),cos(-pitch)*20,0,sin(-pitch)*20,-15,32)
goto Take
}
}

actor S_SmokeRodeoShot : SmokeRodeoShot
{
Translation "192:192=84:84","198:198=220:220","195:195=223:223"
Damage (218)//145
States
{
Death:
6P28 H 0 A_SpawnItemEx("S_SmokeRodeoShot2X",0,0,0,cos(-pitch)*10,0,sin(-pitch)*10,0,1)
goto DeathFX
XDeath:
Crash:
6P28 H 0 A_SpawnItemEx("S_SmokeRodeoShot3",0,0,0,cos(-pitch)*60,0,sin(-pitch)*60,0,1)
goto DeathFX
}
}

actor S_SmokeRodeoShot2X : SmokeRodeoShot2X
{
Damage (218)//145
States
{
Spawn:
6P28 A 0
6P28 A 0 A_SpawnItemEx("S_SmokeRodeoShot2",0,0,0,momx*6,momy*6,momz*6,0,1+8)
stop
}
}
actor S_SmokeRodeoShot2 : SmokeRodeoShot2
{
Damage (218)//145
}
actor S_SmokeRodeoShot3 : SmokeRodeoShot3
{
Damage (218)//145
}

actor S_SmokeRodeoShot00 : SmokeRodeoShot00
{
Translation "192:192=84:84","198:198=220:220"
Damage (78)//52
}




actor S_SmokeBandit_BombTrap : SmokeBandit_BombTrap
{
Translation "192:192=84:84","198:198=220:220","195:195=223:223"
damage (38)//25
States
{
Death:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("weapon/napalm","Weapon")
TNT1 A 0 A_Explode(150,128,0,0,80)//100
TNT1 A 0 A_SpawnItemEx("S_SmokeBanditBombTrapExp",0,0,28,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("SmokeB_TrapExpFX",0,0,0,0,0,0,0,1)
TNT1 A 4 A_SpawnItemEx("SmokeBanditBombTossFX",0,0,24,0,0,0,0,1)
stop
}
}
actor S_SmokeBandit_BombTrap2 : S_SmokeBandit_BombTrap
{
States
{
Spawn:
TNT1 A 0
goto SmokeBandit_BombTrap::Spawn+2
}
}

actor S_SmokeBanditBombTrapExp : SmokeBanditBombTrapExp
{
Args 30,80//20
}


actor S_SmokeBanditBombToss : SmokeBanditBombToss
{
Translation "192:192=84:84","198:198=220:220","195:195=223:223"
damage (75)//50
States
{
Death:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("weapon/napalm","Weapon")
TNT1 A 0 A_Explode(150,128,0,0,80)//100
TNT1 A 0 A_SpawnItemEx("S_SmokeBanditBombExp",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("S_SmokeBanditBombExp",0,120,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("S_SmokeBanditBombExp",0,-120,0,0,0,0,0,1)
TNT1 A 10 A_SpawnItemEx("SmokeBanditBombTossFX",0,0,24,0,0,0,0,1)
stop
}
}
actor S_SmokeBanditBombExp : SmokeBanditBombExp
{
Args 30,80//20
}

const int U_MARKMANSLOCK_LIMIT = 7;

actor Marksman_W_ScriptBar : ScriptBar {}

actor Marksman_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 50
  Inventory.Pickupmessage "$PU_40"
  Obituary "$OB_40W"
  Tag "$TAG_Marksman_W"
  weapon.ammotype "MarksmanEnergyAmmo"
  weapon.ammotype2 "MarksmanMissile_F"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H40 [ 6
    loop

   Deselect:
    6H40 A 0
    goto DeselectSwap
   Select:
    6H40 A 0
    goto SelectSwap

   Ready:
    6H40 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MARKSMAN_DYE)
    goto Ready1

   Ready1:
    6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo", 336, "Ready2")//168
    6H40 A 2 A_WeaponReady(8)
    6H40 A 0 A_GiveInventory("MarksmanEnergyAmmo", 6)
    loop
   Ready2:
    6H40 A 2 A_WeaponReady
    6H40 A 0 A_GiveInventory("MarksmanEnergyAmmo", 6)
    loop

   Fire:
    6H40 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H40 A 0 A_GiveInventory("Marksman_Fire_P1")
    6H40 A 0 A_ReFire(1)
    6H40 A 1 Offset(10, 42)
    6H40 A 1 Offset(20, 52)
    6H40 A 1 Offset(6, 38)
    6H40 A 0 A_WeaponReady(14)
    6H40 A 2 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H40 A 1 Offset(10, 42) A_GiveInventory("Marksman_Fire_P2")
    6H40 A 1 Offset(20, 52)
    6H40 A 1 Offset(6, 38)
    6H40 A 0 A_WeaponReady(14)
    6H40 A 2 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H40 A 1 Offset(10, 42) A_GiveInventory("Marksman_Fire_P3")
    6H40 A 1 Offset(20, 52)
    6H40 A 1 Offset(6, 38)
    6H40 A 0 A_WeaponReady(14)
    6H40 A 2 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H40 AAA 5 A_GiveInventory("MarksmanEnergyAmmo", 4)
    Goto Ready1

   BotFire:
    6H40 A 0 A_GiveInventory("MarksmanEnergyAmmo", random(6, 48))
    6H40 A 0 A_Jump(8, "BotFire2")
    6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo", 168, "BotFire1")
    6H40 A 0 A_Jump(56, "AltfireOld", 1)
    Goto Fire+1
    6H40 A 0 A_Facetarget
    goto AltfireOld
   BotFire1:
    6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo", 336, 3)
    6H40 A 0 A_Jump(16, 2)
    6H40 A 0 A_Jump(64, "AltfireOld")
    Goto Fire+1
    6H40 A 0 A_Facetarget
    goto AltfireOld

   BotFire2:
    6H40 A 0 A_PlaySoundEx("taunt/D_40", "Voice")
    6H40 A 0 A_Facetarget
    6H40 AAAAAA 0 A_FireCustomMissile("MarksmanQuickMarkBot", random(-6, 6), 0, 0, 0, 1, random(-7, 7))
    Goto AltfireOld+1

   Flash.Alt://Remove lockon if marked players are dead//
    TNT1 A 1 ACS_NamedExecuteWithResult("uc_MarksmanLockOn", 3, U_MARKMANSLOCK_LIMIT)
    loop

   AltFire:
    6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo", 336, "AltfireHStart")
    //6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",168,"AltfireOld")
    goto Ready1
   AltfireOld:
    6H40 A 0 A_TakeInventory("MarksmanEnergyAmmo", 168)
    6H40 A 0 A_FireCustomMissile("MarksmanQuickMark", 0, 0, 0, 0)
    6H40 A 5 Offset(10, 42)
    6H40 A 3 Offset(6, 38)
    Goto Ready1

   AltfireHStart:
    6H40 B 1 A_PlaySound("CowboyKid/Knife", 1)
   AltfireH:
    6H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo", 1, 1)
    goto AltfireHEnd
    6H40 A 1 A_GiveInventory("Marksman_AltHold_P")
    6H40 A 0 A_Refire(2)
    6H40 A 0 A_JumpIfInventory("MarksmanMissile_F", 1, "AltfireHEnd")
    goto AltfireHEnd2
    6H40 B 0 A_JumpIfInventory("MarksmanEnergyAmmo", 1, 1)
    goto AltfireHEnd
    6H40 B 1 A_GiveInventory("Marksman_AltHold_P")
    6H40 B 0 A_Refire("AltfireH")
    6H40 B 0 A_JumpIfInventory("MarksmanMissile_F", 1, "AltfireHEnd")
    goto AltfireHEnd2

   AltfireHEnd:
    6H40 A 0 A_GiveInventory("Marksman_Alt_P")
    6H40 A 0 A_GunFlash("NoFlash")
    6H40 A 1 Offset(10, 42) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H40 A 1 Offset(20, 52)
    6H40 A 1 Offset(6, 38) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H40 A 1 A_WeaponReady(14)
   AltfireHEnd2:
    6H40 A 2 A_JumpIfInventory("MarksmanMissile_F", 1, "AltfireHEnd")
    6H40 AA 2 A_TakeInventory("MarksmanMissile_F")
    6H40 A 2 ACS_NamedExecuteWithResult("uc_MarksmanLockOn", -1, U_MARKMANSLOCK_LIMIT)//Clear LockOn
    Goto Ready1
  }
}

actor MarksmanEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 336
  +INVENTORY.IGNORESKILL
}

actor MarksmanMissile_F : Ammo {
  inventory.maxamount 64
  +INVENTORY.IGNORESKILL
}

actor MarksmanLockOn_CD : Powerup {
  +INVENTORY.ADDITIVETIME
  powerup.duration 8
}

actor Marksman_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    TNT1 A 0 A_FireCustomMissile("MarksmanBullet1", 0, 0, 8, 0)
    goto End
   End:
    TNT1 A 0 A_PlaySound("CowboyKid/Shot2", 1)
    TNT1 A 0 A_GiveInventory("MarksmanEnergyAmmo", 5)
    stop
  }
}
actor Marksman_Fire_P2 : Marksman_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MarksmanBullet2", 0, 0, 8, 0)
    goto End
  }
}
actor Marksman_Fire_P3 : Marksman_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MarksmanBullet3", 0, 0, 8, 0)
    goto End
  }
}

actor Marksman_AltHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireBullets(0, 0, 0, 0, "MarksmanTargeterDeluxe", FBF_NOFLASH|FBF_NORANDOMPUFFZ)
    //TNT1 A 0 A_FireCustomMissile("MarksmanTargeter",0,0,0,0)
    TNT1 A 0 A_JumpIfInventory("MarksmanMissile_F", 1, 1)
    stop
    TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo", 1, 1)
    TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo", 1)
    stop
  }
}

actor Marksman_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MarksmanLockShot", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo", 18, 1)
    TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo", 18)
    TNT1 A 0 A_TakeInventory("MarksmanMissile_F", 1)
    TNT1 A 0 A_PlaySound("CowboyKid/Shot", 1, 0.85)
    stop
  }
}

actor MarksmanLockOn_CD_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("MarksmanLockOnFX", 0, 0, 88, 0, 0, 0, 0, 1)
    TNT1 A 0 A_GiveInventory("MarksmanMissile_F", 1)
    TNT1 A 0 A_GiveInventory("MarksmanEnergyAmmo", 32)
    TNT1 A 0 A_TakeInventory("MarksmanLockOn_CD")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 AA 0 A_GiveInventory("MarksmanLockOn_CD")
    stop
  }
}

actor MarksmanTargeterDeluxe : BasicWatcher {
  //Translation "192:192=211:211","198:198=231:231"
  Translation "4:4=4:4", "192:192=231:231", "198:198=0:0"
  //Damagetype "Marksman"
  //Obituary "$OB_40M"
  +ALWAYSPUFF
  +PUFFGETSOWNER
  +PUFFONACTORS
  +BLOODLESSIMPACT
  +HITTRACER
  +SKYEXPLODE
  +DONTSPLASH
  +THRUGHOST
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer")==1, 1)
    goto SpawnFX
    TNT1 A 0 ACS_NamedExecuteWithResult("uc_MarksmanLockOn", 0, CallACS("core_getptrtid", 2), CallACS("core_getptrtid", 8), U_MARKMANSLOCK_LIMIT)
    goto SpawnFX
   SpawnFX:
    TNT1 A 1 A_SpawnItemEx("MarksmanTargeterFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop

   Crash:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("MarksmanTargeterFX", 0, 0, 0)
    TNT1 A 0
    stop
  }
}

actor MarksmanTargeterFX : BasicClientSide {
  Translation "4:4=4:4", "192:192=211:211", "198:198=0:0"
  +FORCEXYBILLBOARD
  States {
   Spawn:
    X_8E K 2
    //6P40 M 3 A_Fadeout(0.2)
    stop
  }
}

actor MarksmanLockOnFX : BasicShieldWarper {
  +FORCEXYBILLBOARD
  ReactionTime 8
  States {
   Spawn:
    6P40 K 0
    6P40 K 1 A_Warp(AAPTR_TARGET, 0, 0, 88+16-ReactionTime*2, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    6P40 K 0 A_CountDown
    6P40 L 1 A_Warp(2, 0, 0, 88+16-ReactionTime*2, 0, 24)
    6P40 K 0 A_CountDown
    loop
  }
}

actor MarksmanLockShot : BasicProjectile {
  Translation "192:192=211:211", "198:198=231:231"
  Damagetype "Marksman"
  Obituary "$OB_40M"
  +SKYEXPLODE
  +EXPLODEONWATER
  +SEEKERMISSILE
  ReactionTime 5
  Damage (125)
  Radius 12
  Height 12
  Speed 16
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_setpointer", 8, CallACS("uc_MarksmanLockOn", 1)+999)//CountInv could help here
    TNT1 A 2
    TNT1 A 0 A_ScaleVelocity(3)
    //TNT1 A 0 A_JumpIfTargetInLOS("SpawnHome",0,JLOSF_PROJECTILE|JLOSF_NOSIGHT)
    TNT1 A 0 A_JumpIfInventory("MM8BDMPlayer", 1, "SpawnHome", AAPTR_TRACER)
    TNT1 A 0
   SpawnL:
    6P40 A 1
    wait
   SpawnHome:
    TNT1 AA 0 A_FaceTracer(90, 90)
   SpawnHomeL:
    X_4G ABABABABABABABABABAB 2 A_SeekerMissile(10, 10, SMF_PRECISE|SMF_CURSPEED, 0, 1)
    X_4G A 0 A_CountDown
    loop

   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("DuckHunt/Flap", 1)
    TMFX ABCD 2
    stop
  }
}


actor PowerMarksmanCombo1 : Powerup {
  powerup.duration 12
}
actor PowerMarksmanCombo2 : PowerMarksmanCombo1{}

actor MarksmanBullet1 : BasicFastProjectile {
  Translation "192:192=211:211", "198:198=231:231"
  Damagetype "Marksman"
  Obituary "$OB_40M"
  +HITTRACER
  Damage (100)
  Radius 15
  Height 15
  Speed 80
  Scale 3.0
  States {
   Spawn:
    6P40 A 0
    6P40 A 1
    wait
   Death:
    TNT1 A 0
    TMFX ABCD 2
    stop
   Crash:
   XDeath:
    TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer")==1, "DeathGive")
    goto Death
   DeathGive:
    TNT1 A 0 A_GiveInventory("PowerMarksmanCombo1", 1, AAPTR_TRACER)
    goto Death
  }
}
actor MarksmanBullet2 : MarksmanBullet1 {
  States {
   DeathGive:
    TNT1 A 0 A_JumpIfInventory("PowerMarksmanCombo1", 1, 1, 8)
    goto Death
    TNT1 A 0 A_GiveInventory("PowerMarksmanCombo2", 1, 8)
    goto Death
  }
}
actor MarksmanBullet3 : MarksmanBullet1 {
  Args 200, 128, 64
  States {
   DeathGive:
    TNT1 A 0 A_JumpIfInventory("PowerMarksmanCombo2", 1, "DeathBoom", 8)
    goto Death
   DeathBoom:
    TNT1 A 0 A_PlaySoundEx("CowboyKid/Bomb", "Weapon")//Pokemon/Bide
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
  }
}


actor MarksmanQuickMark : BasicFastProjectile {
  Translation "192:192=211:211", "198:198=231:231"
  Damagetype "MarksmanDebuff"
  Obituary "$OB_40A"
  +THRUACTORS
  +EXPLODEONDEATH
  Damage (120)
  Radius 8
  Height 8
  Speed 120
  Scale 3.0
  Args 12, 120, 120
  States {
   Spawn:
    //X_8E BC 2
    X_8E K 0
    X_8E K 0 A_PlaySoundEx("weapon/SearchCross", "Weapon")
    X_8E KLML 1 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    loop
  }
}

actor MarksmanQuickMarkBot : MarksmanQuickMark {
  Args 4, 120, 120
  States {
   Spawn:
    X_8E K 0
    X_8E KLML 1 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    loop
  }
}


actor PowerMarksmanDebuffGiver : BasicPowerupGiver {
  Powerup.Type "PowerMarksmanDebuff"
}

actor PowerMarksmanDebuff : PowerProtection {
  powerup.duration 175
  damagefactor "Marksman", 1.5
  damagefactor "MarksmanDebuff", 1.5
}

actor MarksmanDebuff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PowerMarksmanDebuff", 1, 2)
    TNT1 A 0 A_SpawnItemEx("MarksmanDebuff_H")
    TNT1 A 0 A_GiveInventory("PowerMarksmanDebuffGiver", 1)
    stop
  }
}

actor MarksmanDebuff_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_GiveToTarget("MarksmanDebuffFX_P", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("PowerMarksmanDebuff", 1, "Spawn")
    stop
  }
}

actor MarksmanDebuffFX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("MarksmanDebuffFX", random(24, 56), 0, Random(18, 56), 0, 0, -2, random(0, 359), 0)
    stop
  }
}

actor MarksmanDebuffFX {
  Translation "192:192=211:211", "198:198=231:231"
  +MISSILE
  //+FLOATBOB
  +NOGRAVITY
  +THRUACTORS
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  Damage(0)
  Height 2
  Radius 2
  Scale 2.5
  States {
   Spawn:
    6P40 M 3 A_Fadeout(0.2)
    wait
  }
}

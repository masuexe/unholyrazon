actor ElectricianS_W_NormalBar : NormalBar {args 214, 103}

actor ElectricianS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Electrician_W"
Weapon.AmmoUse 45
Inventory.Pickupmessage "$PU_20"
Obituary "$OB_20W"
weapon.ammotype "ElectricEnergyAmmo"
States
{
Spawn:
7H20 [ 6
loop

Deselect:
7H20 A 0
goto DeselectSwap
Select:
7H20 A 0
goto SelectSwap

Ready:
7H20 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", ELECTRICIAN_SDYE)
7H20 A 0 A_GunFlash("Flash",1)
Goto Ready2
Ready2:
7H20 A 2 A_WeaponReady
7H20 A 0 A_GiveInventory("ElectricEnergyAmmo",1)//3
loop

Fire:
7H20 F 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H20 H 0 A_GiveInventory("S_Electrician_Fire_P")
7H20 J 0 A_RailWait
7H20 FGHIJ 2
TNT1 A 2 A_RailWait
7H20 KLM 2
7H20 L 0 A_RailWait
7H20 A 2
Goto Ready2

Flash:
TNT1 A 2 A_GiveInventory("Electrician_Flash_P")
loop

BotFire:
7H20 A 0 A_JumpIfInventory("ElectricEnergyAmmo",0,"BotFire2")
7H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(25,65))
7H20 A 0 A_Jump(16,"BotFire1")
7H20 A 0 A_JumpIfCloser(512,"BotAlt")
7H20 A 0 A_Jump(16,1)
goto Fire+1
7H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(75,210))
goto Fire+1
BotFire1:
7H20 A 0 A_GiveInventory("ElectricEnergyAmmo",random(135,180))
7H20 A 0 A_PlaySoundEx("taunt/D_20","Voice")
7H20 A 0 A_FireCustomMissile("S_ElectricianShotBit",20,0,8,0)
7H20 A 0 A_FireCustomMissile("S_ElectricianShotBit",10,0,8,0)
7H20 A 0 A_FireCustomMissile("S_ElectricianShotBit",-10,0,8,0)
7H20 A 0 A_FireCustomMissile("S_ElectricianShotBit",-20,0,8,0)
goto BotFire2
BotFire2:
7H20 A 0 A_Jump(128,"AltFireOld")
goto Fire+1
BotAlt:
7H20 Q 2 A_GiveInventory("VivifyFlag1",1)
BotAltH:
7H20 X 1 A_GiveInventory("S_Electrician_Alt_P")
7H20 S 2
7H20 S 0 A_ReFire(1)
goto AltFireEnd
7H20 A 0 A_Jump(1,2)
7H20 A 0 A_JumpIfCloser(512,"BotAlt")
goto AltFireEnd
7H20 Q 2 A_TakeInventory("VivifyFlag1")
goto BotFire1+1

AltFire:
7H20 Q 2 A_GiveInventory("VivifyFlag1",1)
AltFireH:
7H20 R 1 A_GiveInventory("S_Electrician_Alt_P")
7H20 S 2
7H20 S 0 A_ReFire(1)
goto AltFireEnd
7H20 T 1 A_GiveInventory("S_Electrician_Alt_P")
7H20 U 2
7H20 U 0 A_ReFire(1)
goto AltFireEnd
7H20 V 1 A_GiveInventory("S_Electrician_Alt_P")
7H20 W 2
7H20 W 0 A_ReFire(1)
goto AltFireEnd
7H20 X 1 A_GiveInventory("S_Electrician_Alt_P")
7H20 Y 2
7H20 Y 0 A_ReFire("AltFireH")
goto AltFireEnd
AltFireEnd:
7H20 Q 2 A_TakeInventory("VivifyFlag1")
7H20 A 4
Goto Ready2

AltFireOld:
7H20 Q 0 A_TakeInventory("ElectricEnergyAmmo",60,1)
7H20 Q 0 A_TakeInventory("ElectricEnergyAmmo",30)
7H20 Q 0 A_PlaySound("weapon/thunderclaw",1)
7H20 Q 0 A_FireCustomMissile("S_ElectricianRipperingShot",0,0,8,0)
7H20 Q 1
7H20 XSSQA 2
Goto Ready2
}
}

actor S_Electrician_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",180,8)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",135,6)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",90,4)
TNT1 A 0 A_JumpIfInventory("ElectricEnergyAmmo",45,2)
TNT1 A 0 A_FireCustomMissile("S_ElectricianShot",0,0,8,0)
goto Firin+1
TNT1 A 0 A_FireCustomMissile("S_ElectricianShot2",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("S_ElectricianShot3",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("S_ElectricianShot4",0,1,8,0)
goto Firin
TNT1 A 0 A_FireCustomMissile("S_ElectricianShot5",0,1,8,0)
goto Firin
Firin:
TNT1 A 0 A_TakeInventory("ElectricEnergyAmmo",45)
TNT1 A 0 A_PlaySound("wep_L/ElectricianFire2",1)
stop
}
}
actor S_Electrician_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/ElectricianAlt2",1)
TNT1 A 0 A_FireCustomMissile("S_ElectricianLaserDam",0,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_ElectricianLaserLine_H",0,0,8,0)
TNT1 A 0 A_TakeInventory("ElectricEnergyAmmo",1,1)
stop
}
}

actor S_ElectricianShot : ElectricianShot
{
Translation "192:192=214:214","198:198=103:103"
Damage (300)//200
}

{
Translation "192:192=214:214","198:198=103:103"
Damage (413)//275
}
actor S_ElectricianShot3 : ElectricianShot3
{
Translation "192:192=214:214","198:198=103:103"
Damage (525)//350
}
actor S_ElectricianShot4 : ElectricianShot4
{
Translation "192:192=214:214","198:198=103:103"
Damage (638)//425
}
actor S_ElectricianShot5 : ElectricianShot5
{
Translation "192:192=214:214","198:198=103:103"
Damage (225)//150
Args 525,128,64//350
}

actor S_ElectricianShotBit : ElectricianShotBit
{
Translation "192:192=214:214","198:198=103:103"
Damage (75)//50
}

actor S_ElectricianRipperingShot : ElectricianRipperingShot
{
Translation "192:192=214:214","198:198=103:103"
Damage (128)//85
States
{
Spawn:
X_8D L 0
X_8D LMNM 1 A_SpawnItemEx("S_ElectricianRipperingShot2",0,0,0,0,0,0,0,1)
loop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapon/lightningbolt","Weapon")
TNT1 A 4 A_SpawnItemEx("Electrician_LBoltFX1",0,0,10,0,0,0,0,1)
TNT1 A 8 A_SpawnItemEx("Electrician_LBoltFX2",0,0,10,0,0,0,0,1)
TNT1 AAA 6 A_SpawnItemEx("S_Electrician_LBolt",0,0,10,0,0,0,0,1)
TNT1 A 10
stop
}
}

actor S_ElectricianRipperingShot2 : ElectricianRipperingShot2
{
Damage (60)//40
}

actor S_Electrician_LBolt : Electrician_LBolt
{
states
{
Spawn:
X_BC N 0
X_BC N 1 A_SpawnItemEx("Electrician_LBolt_EXT",0,0,355,0,0,0,0,1)
X_BC N 0 A_PlaySoundEx("weapon/lightningbolt","Weapon")
X_BC N 0 A_SpawnItemEx("S_Electrician_LBoltBoom",0,0,16)
X_BC O 1
goto Spawn2
}
}

actor S_Electrician_LBoltBoom : Electrician_LBoltBoom
{
Args 150,148,32//100
}

actor S_ElectricianLaserLine_H : ElectricianLaserLine_H
{
Translation "192:192=214:214","198:198=103:103"
}

actor S_ElectricianLaserDam : ElectricianLaserDam
{
Damage (random(62,75))//41,50
}

actor Corpse_34 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_34_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_1", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_4", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_6", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


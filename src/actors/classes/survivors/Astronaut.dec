actor Astronaut : CustWepClassBase {
  player.scoreIcon "UMUG_34"
  player.displayname "Astronaut"
  player.soundclass "Astronaut"
  Player.Maxhealth 1200
  health 1200
  player.forwardmove 0.75, 0.75
  player.sidemove 0.75, 0.75
  player.jumpz 10
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "Astronaut_W"
  player.startitem "MockingAmmo", 200

  player.startitem "AirJumpLimit", 3
  States {
   Spawn:
    DYNA A 0
    DYNA B 1
    DYNA A 1
    Goto Spawn+2
   See:
    DYNA BCDE 5
    Goto Spawn
   Missile:
    DYNA FFFFF 1
    DYNA GGGG 1
    goto Spawn+2
   ClassPain: DYNA H 0
    Goto MegamanPain

   ClassDeath:
    DYNA H 0
    goto MegamanDeath
   MegamanDeath0:
    DYNA H 15 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DYNA H 0
    DYNA H 1 A_SpawnItemEx("TeleportFog", 0, 0, 0, 0, 0, 0, 0, 1)
    DYNA Z 1
    Goto MegamanErase
   MegamanDisintegrate:
    DYNA Z 0 A_SpawnItemEx("Corpse_34", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor AstronautShiny : Astronaut {
  player.scoreIcon "UMUG_S34"
  Player.Maxhealth 3200
  health 3200
  player.forwardmove 0.85, 0.85
  player.sidemove 0.85, 0.85
  player.jumpz 11
  player.morphweapon "AstronautShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}


//Obituary "\cgAFTERLIFE!\c- %o's face was full of glass due %k's broken helmet."

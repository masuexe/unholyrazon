actor Astronaut : CustWepClassBase {
  Player.ScoreIcon "UMUG_34"
  Player.DisplayName "Astronaut"
  Player.SoundClass "Astronaut"
  Player.MaxHealth 1200
  Health 1200
  Player.ForwardMove 0.75, 0.75
  Player.SideMove 0.75, 0.75
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Astronaut_W"
  Player.StartItem "MockingAmmo", 200

  Player.StartItem "AirJumpLimit", 3
  States {
   Spawn:
    DYNA A 0
    DYNA B 1
    DYNA A 1
    goto Spawn+2
   See:
    DYNA BCDE 5
    goto Spawn
   Missile:
    DYNA FFFFF 1
    DYNA GGGG 1
    goto Spawn+2
   ClassPain:
    DYNA H 0
    goto MegamanPain

   ClassDeath:
    DYNA H 0
    goto MegamanDeath
   MegamanDeath0:
    DYNA H 15 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DYNA H 0
    DYNA H 1 A_SpawnItemEx("TeleportFog", 0, 0, 0, 0, 0, 0, 0, 1)
    DYNA Z 1
    goto MegamanErase
   MegamanDisintegrate:
    DYNA Z 0 A_SpawnItemEx("Corpse_34", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor AstronautShiny : Astronaut {
  Player.ScoreIcon "UMUG_S34"
  Player.MaxHealth 3200
  Health 3200
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.85, 0.85
  Player.JumpZ 11
  Player.MorphWeapon "AstronautShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}


// Obituary "\cgAFTERLIFE!\c- %o's face was full of glass due %k's broken helmet."
// TNT1 A 1 A_Explode(250,128,0)

actor Corpse_34 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_34_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_34_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


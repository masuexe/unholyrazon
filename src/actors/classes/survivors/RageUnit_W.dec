actor RageUnit_W_ScriptBar : ScriptBar {}

actor RageUnit_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 150
  Inventory.Pickupmessage "$PU_15"
  Obituary "$OB_15W"
  Tag "$TAG_RageUnit_W"
  Weapon.AmmoType "RageEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H15 [ 6
    loop

   Deselect:
    6H15 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, 1)
    goto DeselectSwap
    6H15 D 0 A_JumpIfInventory("RageUnitEnrage_F", 2, 1)
    goto DeselectSwap
    6H15 G 0 A_JumpIfInventory("RageUnitEnrage_F", 3, 1)
    goto DeselectSwap
    6H15 J 0 A_JumpIfInventory("RageUnitEnrage_F", 4, 1)
    goto DeselectSwap
    6H15 M 0
    goto DeselectSwap
   Select:
    6H15 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, 1)
    goto SelectSwap
    6H15 D 0 A_JumpIfInventory("RageUnitEnrage_F", 2, 1)
    goto SelectSwap
    6H15 G 0 A_JumpIfInventory("RageUnitEnrage_F", 3, 1)
    goto SelectSwap
    6H15 J 0 A_JumpIfInventory("RageUnitEnrage_F", 4, 1)
    goto SelectSwap
    6H15 M 0
    goto SelectSwap

   Ready:
    6H15 A 0 A_GiveInventory("RageUnit_ReadyDye_P")
    6H15 A 0 A_GunFlash("Flash", 1)
    goto Ready0
   Ready0:
    6H15 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "Ready1")
    6H15 A 2 A_GiveInventory("RageUnit_Ready_P")
    loop

   Ready1:
    6H15 D 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "Ready2")
    6H15 D 2 A_GiveInventory("RageUnit_Ready_P")
    6H15 D 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "Ready1")
    goto Ready0

   Ready2:
    6H15 G 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "Ready3")
    6H15 G 2 A_GiveInventory("RageUnit_Ready_P")
    6H15 G 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "Ready2")
    goto Ready0

   Ready3:
    6H15 J 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "Ready4")
    6H15 J 2 A_GiveInventory("RageUnit_Ready_P")
    6H15 J 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "Ready3")
    goto Ready0

   Ready4:
    6H15 M 2 A_GiveInventory("RageUnit_Ready_P")
    6H15 M 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "Ready4")
    goto Ready0

   Fire:
    6H15 "#" 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H15 "#" 0 A_GiveInventory("RageUnit_MainF_P")
   Fire0:
    6H15 C 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "Fire1")
    6H15 C 4
    6H15 BAA 4 A_GiveInventory("RageEnergyAmmo", 2)
    goto Ready0
   Fire1:
    6H15 F 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "Fire2")
    6H15 FE 2
    6H15 DD 4 A_GiveInventory("RageEnergyAmmo", 2)
    goto Ready1
   Fire2:
    6H15 I 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "Fire3")
    6H15 IH 2
    6H15 G 6 A_GiveInventory("RageEnergyAmmo", 3)
    goto Ready2
   Fire3:
    6H15 L 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "Fire4")
    6H15 LKJ 2
    goto Ready3
   Fire4:
    6H15 O 2 A_GiveInventory("RageUnit_Fire4D_P")
    6H15 M 2 A_GiveInventory("RageUnit_Fire4C_P")
    6H15 N 2 A_GiveInventory("RageUnit_Fire4B_P")
    6H15 M 2 A_GiveInventory("RageUnit_Fire4A_P")
    goto Ready4

   BotFire:
    6H15 A 0 A_JumpIfInventory("RageEnergyAmmo", 0, "BotFire2")
    6H15 A 0 A_GiveInventory("RageEnergyAmmo", random(5, 10))
    6H15 A 0 A_Jump(8, 1)
    goto Fire+1
    6H15 A 0 A_PlaySoundEx("classes/taunt/rageunit", "Voice")
    6H15 A 0 A_GiveInventory("RageUnitBotSpeed")
    goto Fire+1
   BotFire2:
    6H15 A 0 A_Jump(128, "AltFire")
    goto Fire+1

   Flash:
    TNT1 A 1
    TNT1 A 0 A_GiveInventory("RageUnit_Flash_P")
    loop

   AltFire:
    6H15 "#" 0 A_TakeInventory("RageEnergyAmmo", 95, 1)
    6H15 "#" 0 A_TakeInventory("RageEnergyAmmo", 65)
    6H15 B 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "AltFire1")
    6H15 P 1 Offset(-20, 6)
    6H15 P 1 Offset(-47, -21)
    6H15 Q 5 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 P 3 Offset(-47, -21)
    6H15 P 3 Offset(-20, 6)
    6H15 P 4 A_WeaponReady(14)
    // 6H15 BCB 2
    // 6H15 A 11
    goto Ready0
   AltFire1:
    6H15 E 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "AltFire2")
    6H15 R 1 Offset(-20, 6)
    6H15 R 1 Offset(-47, -21)
    6H15 S 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 R 2 Offset(-47, -21)
    6H15 S 3 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 R 3 Offset(-47, -21)
    6H15 R 3 Offset(-20, 6)
    6H15 R 6 A_WeaponReady(14)
    // 6H15 EFE 2
    // 6H15 D 0 A_GiveInventory("RageUnit_Alt_P")
    // 6H15 EFE 2
    // 6H15 D 9
    goto Ready1
   AltFire2:
    6H15 H 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "AltFire3")
    6H15 H 0 A_GiveInventory("RageUnit_Alt_P")
    6H15 T 1 Offset(-20, 6)
    6H15 T 1 Offset(-47, -21)
    6H15 U 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 T 2 Offset(-47, -21)
    6H15 U 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 T 2 Offset(-47, -21)
    6H15 U 4 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 T 3 Offset(-47, -21)
    6H15 T 3 Offset(-20, 6)
    6H15 T 4 A_WeaponReady(14)
    // 6H15 HI 2
    // 6H15 G 0 A_GiveInventory("RageUnit_Alt_P")
    // 6H15 HI 2
    // 6H15 G 0 A_GiveInventory("RageUnit_Alt_P")
    // 6H15 HIH 2
    // 6H15 G 7
    goto Ready2
   AltFire3:
    6H15 K 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "AltFire4")
    6H15 V 1 Offset(-20, 6)
    6H15 V 1 Offset(-47, -21)
    6H15 W 3 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 V 3 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 W 3 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 V 5 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 V 2 Offset(-20, 6)
    6H15 V 3 A_WeaponReady(14)
    // 6H15 KLKL 3 A_GiveInventory("RageUnit_Alt_P")
    // 6H15 K 3
    // 6H15 J 4
    goto Ready3
   AltFire4:
    6H15 X 1 Offset(-20, 6)
    6H15 X 1 Offset(-47, -21)
    6H15 Y 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 X 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 Y 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 X 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 Y 2 Offset(-47, -21) A_GiveInventory("RageUnit_Alt_P")
    6H15 X 1 Offset(-47, -21)
    6H15 X 1 Offset(-20, 6)
    6H15 X 0 A_WeaponReady(14)
    // 6H15 NONON 2 A_GiveInventory("RageUnit_Alt_P")
    // 6H15 M 1
    goto Ready4
  }
}

actor RageEnergyAmmo : Ammo {
  Inventory.MaxAmount 150
  +INVENTORY.IGNORESKILL
}

actor RageUnitEnrage_F : Inventory {Inventory.MaxAmount 4
}

actor RageUnitBotSpeed : PowerSpeed {
  Powerup.Duration -2
  Speed 3.0
}

actor RageUnit_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RageEnergyAmmo", 0, 2)
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 2)
    stop
  }
}

actor RageUnit_ReadyDye_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "P4")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "P3")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "P2")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "P1")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_DYE, 1)
    stop
   P1:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_DYE1, 1)
    stop
   P2:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_DYE2, 1)
    stop
   P3:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_DYE3, 1)
    stop
   P4:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_DYE4, 1)
    stop
  }
}

actor RageUnit_Flash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "P_4")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "P_3")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "P_2")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "P_1")
    goto P_0
   P_0:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75 + 1, "P_A")
    stop
   P_A:
    TNT1 A 0 A_GiveInventory("RageUnitEnrage_F", 1)
    goto P_11
   P_1:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "P_1A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75 + 1, "Done")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto DoneX
   P_11:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "P_1A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75 + 1, "DoneX")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto DoneX
   P_1A:
    TNT1 A 0 A_GiveInventory("RageUnitEnrage_F", 1)
    goto P_22
   P_2:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25 + 1, "P_2A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "Done")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_11
   P_22:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25 + 1, "P_2A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "DoneX")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_11
   P_2A:
    TNT1 A 0 A_GiveInventory("RageUnitEnrage_F", 1)
    goto P_33
   P_3:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01 + 1, "P_3A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25 + 1, "Done")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_22
   P_33:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01 + 1, "P_3A")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25 + 1, "DoneX")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_22
   P_3A:
    TNT1 A 0 A_GiveInventory("RageUnitEnrage_F", 1)
    goto P_44
   P_4:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01 + 1, "Done")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_33
   P_44:
    TNT1 A 1
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01 + 1, "DoneX")
    TNT1 A 0 A_TakeInventory("RageUnitEnrage_F", 1)
    goto P_33
   Done:
    TNT1 A 0
    stop
   DoneX:
    TNT1 A 0 A_GiveInventory("RageUnit_ReadyDye_P")
    stop
  }
}

actor RageUnit_MainF_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 4, "Fire4")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 3, "Fire3")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 2, "Fire2")
    TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F", 1, "Fire1")
   Fire0:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 2)  // 8
    TNT1 A 0 A_FireCustomMissile("RageShot1", 0, 0, -8, 0)
    goto Pew
   Fire1:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 2)  // 7
    TNT1 A 0 A_FireCustomMissile("RageShot2", -4.5, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot2", 4.5, 0, -8, 0)
    goto Pew
   Fire2:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 2)  // 5
    TNT1 A 0 A_FireCustomMissile("RageShot3", 0, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot3", 7, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot3", -7, 0, -8, 0)
    goto Pew
   Fire3:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 3)
    TNT1 A 0 A_FireCustomMissile("RageShot4", -7.5, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot4", -2.5, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot4", 2.5, 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot4", 7.5, 0, -8, 0)
    goto Pew
   Fire4:
    TNT1 A 0 A_GiveInventory("RageEnergyAmmo", 4)
    stop
   Pew:
    TNT1 A 0 A_PlaySound("Bat_Rob/Pew", 1, 0.8)  // weapon/mbuster
    stop
  }
}

actor RageUnit_Fire4A_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(3, 5), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-3, -5), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(11, 13), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-11, -13), 0, -8, 0)
    goto Pew
   Pew:
    TNT1 A 0 A_PlaySound("Bat_Rob/Pew", 1, 0.8)
    stop
  }
}
actor RageUnit_Fire4B_P : RageUnit_Fire4A_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-1, 1), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(7, 9), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-7, -9), 0, -8, 0)
    goto Pew
  }
}
actor RageUnit_Fire4C_P : RageUnit_Fire4A_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(3, 5), 0, -8, 0)
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-3, -5), 0, -8, 0)
    goto Pew
  }
}
actor RageUnit_Fire4D_P : RageUnit_Fire4A_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("RageShot5", random(-2, 2), 0, -8, 0)
    goto Pew
  }
}


actor RageUnit_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep_L/RageUnitAlt", 4)  // wep_L/gravityhold
    TNT1 A 0 A_SpawnItemEx("RageUnitBurst", 0, 0, 28, 0, 0, 0, 0, 1)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), "PickupSpread")
    stop
   PickupSpread:
    TNT1 A 0 A_SpawnItemEx("RageUnitBurst", 0, 0, 14, 0, 0, 0, 15, 1)
    TNT1 A 0 A_SpawnItemEx("RageUnitBurst", 0, 0, 42, 0, 0, 0, -15, 1)
    stop
  }
}

actor RageShotFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    QMFX D 0
    QMFX EFG 1
    stop
  }
}

actor RageShot1 : BasicProjectile {
  Translation "192:192=96:96", "198:198=102:102"
  Projectile
  Obituary "$OB_15M1"
  DamageType "RageShot"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (165)
  Radius 9
  Height 9
  Speed 45
  Scale 2.5
  States {
   Spawn:
    TNT1 A 1
    goto S2

   S1:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   S1R:
    6P15 EFGH 1
    loop
   S1L:
    6P15 HGFE 1
    loop
   S2:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   S2R:
    6P15 EFGH 2
    loop
   S2L:
    6P15 HGFE 2
    loop

   Death:
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("RageShotFX")
   XDeath:
    TNT1 A 1
    stop
  }
}

actor RageShot2 : RageShot1 {
  Translation "192:192=214:214", "198:198=228:228"
  Obituary "$OB_15M2"
  Damage (125)
  Speed 55
}

actor RageShot3 : RageShot1 {
  Translation "192:192=218:218", "198:198=220:220"
  Obituary "$OB_15M3"
  Damage (95)
  Speed 65
  States {
   Spawn:
    TNT1 A 1
    goto S1
  }
}

actor RageShot4 : RageShot3 {
  Translation "4:4=224:224", "192:192=227:227", "198:198=45:45"
  Obituary "$OB_15M4"
  Damage (85)
  Speed 75
}

actor RageShot5 : RageShot3 {
  Translation "4:4=59:59", "192:192=246:246", "198:198=79:79"
  Obituary "$OB_15M5"
  Damage (75)
  Speed 85
}

actor RageUnitBurst : BasicExplosion {
  Obituary "$OB_15A"
  DamageType "RageFling"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  Args 50, 450, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    6P15 MNOP 2
    stop
  }
}


actor RageUnitBurstDeath : RageUnitBurst {
  DamageType "RageFling"
  Obituary "$OB_15D"
  Args 55, 500, 0
}
actor S_RageUnitBurstDeath : RageUnitBurstDeath {
  Args 83, 500, 0
}

actor CaptainAss_W_NormalBar : NormalBar {args 74, 3}

actor CaptainAss_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 120
  Inventory.Pickupmessage "$PU_42"
  Obituary "$OB_42W"
  Tag "$TAG_CaptainAss_W"
  Weapon.AmmoType "FreeDLCEnergyAmmo"
  States {
   Spawn:
    6H42 [ 6
    loop

   Deselect:
    6H42 A 0
    goto DeselectSwap
   Select:
    6H42 A 0
    goto SelectSwap

   Ready:
    6H42 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CAPTAINASS_DYE)
    6H42 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2

   Ready2:
    6H42 A 2 A_GiveInventory("CaptainAss_Ready_P")
    loop

    // Original M1
    /*Fire:
    6H42 A 0 A_JumpIfInventory("CaptainAssFlag",1,"Fire2")
    6H42 A 0 A_GiveInventory("CaptainAss_Fire_P")
    6H42 CBAAA 3
    goto Ready2
    Fire2:
    6H42 A 0 A_PlaySound("S_Spin/Button",1,0.65)
    6H42 B 2 Offset(0,36)A_GiveInventory("CaptainAssDetonateFlag",1)
    6H42 B 2 Offset(0,40)
    6H42 C 2 Offset(0,44)A_TakeInventory("CaptainAssFlag")
    6H42 C 2 Offset(0,44)
    6H42 B 2 Offset(0,40)
    6H42 B 2 Offset(0,36)
    goto Ready2*/

   Fire:
    6H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, "Fire2")
    6H42 A 0 A_GiveInventory("CaptainAss_Fire_P")
    6H42 CBAAA 3
    goto Ready2
   Fire2:
    6H42 A 0 A_PlaySound("weapon/GrenadeShot", 1)
    6H42 A 0 A_GiveInventory("CaptainAss_Bombs_P")
    6H42 CBAAAAAAAA 2  // Change RoF if too fast or too slow.
    goto Ready2

   Altfire:
    //
    PIRB A 0 A_JumpIfInventory("AssPirateTomfooleryFlag", 1, "Lyrical_Change")
    PIRB A 0 A_GiveInventory("AssPirateTomfooleryFlag")
    PIRB A 0 A_PlaySoundEx("CaptAss/SingingSFX1", "SoundSlot7")  // Just so it doesn't conflict with other "weapon" sfx calls.
    goto The_Actual_Altfire
   Lyrical_Change:
    PIRB A 0 A_TakeInventory("AssPirateTomfooleryFlag")
    PIRB A 0 A_PlaySoundEx("CaptAss/SingingSFX2", "SoundSlot7")
    goto The_Actual_Altfire
    //
   The_Actual_Altfire:
    6H42 A 0 A_PlaySound("S_Spin/Button", 1, 0.65)  // Remove if otherwise.
    6H42 B 0 A_GiveInventory("CaptainAssDetonateFlag")
    6H42 B 0 A_TakeInventory("CaptainAssFlag")
    6H42 B 0 A_GiveInventory("CaptainAss_AltStart_P")
    6H42 B 0 A_ReFire(1)
    6H42 B 1
    // 23
    6H42 CCCCCCCCCCCCCCCCCCCCCCC 1 A_GiveInventory("CaptainAss_Alt_P")
    6H42 B 4 A_GiveInventory("CaptainAss_AltEnd_P")
    6H42 AA 4
    goto Ready2


   BotReady:
    6H42 A 0 A_WeaponReady(12)
    6H42 A 2 A_ReFire("BotCheck")
    6H42 A 0 A_GiveInventory("FreeDLCEnergyAmmo", 1)
    loop

   BotCheck:
    6H42 A 0 A_Jump(4, "BotFireX")
    6H42 A 0 A_JumpIfInventory("FreeDLCEnergyAmmo", 120, 4)
    6H42 A 0 A_Jump(16, "BotAlt")
    6H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, 1)
    goto BotFire
    6H42 A 0 A_Jump(64, "BotFire2")
    goto BotFire
    6H42 A 0 A_Jump(96, "BotAlt")
    6H42 A 0 A_JumpIfInventory("CaptainAssFlag", 1, 1)
    goto BotFire
    6H42 A 0 A_Jump(128, "BotFire2")
    goto BotFire

   BotFire:
    6H42 A 0 A_GiveInventory("CaptainAss_Fire_P")
    6H42 CBAAA 3
    goto BotReady
   BotFire2:
    6H42 A 0 A_PlaySound("S_Spin/Button", 1, 0.65)
    6H42 B 4 A_GiveInventory("CaptainAssDetonateFlag")
    6H42 C 4 A_TakeInventory("CaptainAssFlag")
    6H42 B 4
    goto BotReady

   BotFireX:
    6H42 A 0 A_PlaySoundEx("classes/taunt/captainass", "Voice")
    6H42 A 0 A_GiveInventory("CaptainAssFlag")
    6H42 C 0 A_PlaySound("S_Spin/MetalShake", 1, 1)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", 0, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", 45, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", 90, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", 135, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", -45, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", -90, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", -135, 0, 0, 0)
    6H42 A 0 A_FireCustomMissile("CaptainAssBarrel", 180, 0, 0, 0)
    6H42 CBAAA 3
    goto BotFire2

   BotAlt:
    6H42 B 0 A_GiveInventory("CaptainAss_AltStart_P")
    6H42 B 0 A_ReFire(1)
    6H42 B 1
    6H42 CCCCCCCCCCCCCCCCCCCCCCC 1 A_GiveInventory("CaptainAss_Alt_P")
    6H42 B 4 A_GiveInventory("CaptainAss_AltEnd_P")
    6H42 AA 4
    goto BotReady
  }
}

actor FreeDLCEnergyAmmo : Ammo {
  Inventory.MaxAmount 120
  +INVENTORY.IGNORESKILL
}

actor CaptainAssFlag : Once {}

//
actor AssPirateTomfooleryFlag : Once {}
//

actor CaptainAssDetonateFlag : PowerUp {
  Powerup.Duration 8
}

actor CaptainAss_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("FreeDLCEnergyAmmo", 40 - 16 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 2)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
    TNT1 A 2 A_WeaponReady
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("FreeDLCEnergyAmmo", 1)
    stop
  }
}

actor CaptainAss_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("CaptainAssBarrel", cos(-pitch), 0, 32 + (sin(-pitch) * 0) - (ceilingz - z < 48 + 32) * (48 + 32 - (ceilingz - z)), cos(-pitch) * 32, 0, sin(-pitch) * 32, 0, 32)
    goto End
    TNT1 A 0 A_SpawnItemEx("CaptainAssBarrel2", cos(-pitch), 0, 32 + (sin(-pitch) * 0) - (ceilingz - z < 56 + 32) * (56 + 32 - (ceilingz - z)), cos(-pitch) * 40, 0, sin(-pitch) * 40, 0, 32)
    goto End
   End:
    TNT1 A 0 A_GiveInventory("CaptainAssFlag")
    TNT1 A 0 A_PlaySound("S_Spin/MetalShake", 1, 1)
    TNT1 A 0 A_GiveInventory("FreeDLCEnergyAmmo", 8)
    // TNT1 A 0 A_FireCustomMissile("CaptainAssBarrel",0,0,8,0)
    stop
  }
}

actor CaptainAss_Bombs_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("CaptainAssBombs", 0, 0, 8, 0)
    TNT1 A 0 A_GiveInventory("FreeDLCEnergyAmmo", 8)
    stop
  }
}

actor CaptainAss_AltStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("FreeDLCEnergyAmmo", 16, 1)
    TNT1 A 0 A_TakeInventory("FreeDLCEnergyAmmo", 24)
    TNT1 A 0 A_ChangeVelocity(cos(pitch) * 30, 0, -sin(pitch) * 30, 3)
    TNT1 A 0 A_SetArg(1, angle)
    TNT1 A 0 A_SetArg(2, velx * 100000)
    TNT1 A 0 A_SetArg(3, vely * 100000)
    TNT1 A 0 A_SetArg(4, velz * 100000)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_PlaySoundEx("weapon/tengudash", "Weapon")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    stop
  }
}

actor CaptainAss_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("CaptainAssMelee", 0, 0, 32, 0, 0, 0, 0, 1)
    goto End
    TNT1 A 0 A_SpawnItemEx("CaptainAssMelee2", 0, 0, 32, 0, 0, 0, 0, 1)
    goto End
   End:
    TNT1 A 0 A_PlaySound("weapon/rminestick", 4, 0.85)
    TNT1 A 0 A_ChangeVelocity(args[2] * 0.00001, args[3] * 0.00001, args[4] * 0.00001, CVF_REPLACE)
    stop
  }
}

actor CaptainAss_AltEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_ScaleVelocity(0.75)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    stop
  }
}


actor CaptainAssMelee : BasicExplosion {
  Translation "192:192=74:74", "198:198=3:3"
  DeathSound "S_1/Explode"
  DamageType "CaptainAss"
  Obituary "$OB_42A1"
  +FORCEXYBILLBOARD
  RenderStyle "Translucent"
  Alpha 0.8
  ReactionTime 9
  Scale 2.5
  Args 72, 68, 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
   SpawnL:
    X_BF VWXY 2 A_CountDown
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("CaptainAssMeleeBoomFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_SpawnItemEx("CaptainAssMeleeBoom", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
  }
}
actor CaptainAssMelee2 : CaptainAssMelee {
  Args 216, 80, 24
}

actor CaptainAssMeleeBoom : BasicExplosion_Args {
  DamageType "CaptainAss"
  Obituary "$OB_42A2"
  Args 72, 68, 12
}

actor CaptainAssMeleeBoomFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Translucent"
  Alpha 0.8
  ReactionTime 2
  States {
   Spawn:
    X_BF A 0
    X_BF A 0 A_CountDown
    X_BF A 0 A_Jump(256, 1, 7, 13, 19)
    X_BF BACADA 1
    loop
    X_BF EAFAGA 1
    loop
    X_BF HAIAJA 1
    loop
    X_BF KALAMA 1
    loop
   Death:
    X_BF NAPOPO 1
    stop
  }
}

actor CaptainAssMeleeFX : CaptainAssMeleeBoomFX {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    X_BF V 0
    X_BF V 0 A_Jump(256, 1, 2, 3, 4)
    X_BF V 1
    stop
    X_BF W 1
    stop
    X_BF X 1
    stop
    X_BF Y 1
    stop
  }
}

actor CaptainAssBarrel : BasicProjectile {
  Translation "192:192=74:74", "198:198=3:3", "195:195=160:160"
  DamageType "CaptainAss"
  Obituary "$OB_42M1"
  -NOGRAVITY
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +ALLOWBOUNCEONACTORS
  +CANBOUNCEWATER

  BounceCount 20
  BounceFactor 0.5
  WallBounceFactor 0.25
  // gravity 1.8
  Damage (50)
  Radius 16  // 14
  Height 48  // 28
  Speed 32
  Scale 2.5
  Args 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 20, 0, 1)
    TNT1 A 1 A_GiveInventory("ReSyncPickup")
   SpawnL:
    6P42 AAAAAAAAA 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 A 0 A_SetArg(0, args[0] + 1)
    6P42 A 0 A_JumpIf(args[0] >= 3, "SpawnF")
    loop
   SpawnF:
    6P42 BBAAAAAAA 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 A 0 A_SetArg(0, args[0] + 1)
    6P42 AAAAAAAAA 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 A 0 A_SetArg(0, args[0] + 1)
    loop

   XDeath:
    6P42 A 0 A_SpawnItemEx("CaptainAssBarrelBoom", 0, 0, 24, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    6P42 A 0 A_ChangeFlag("NOINTERACTION", 1)
    6P42 A 0 A_SetGravity(0.0)
    6P42 A 0 A_TakeFromTarget("CaptainAssFlag")
    TNT1 A 2
    stop
   Death:
    6P42 A 1 A_SpawnItemEx("CaptainAssBarrelSit", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION | SXF_TRANSFERSPECIAL)  // 1|32768
    6P42 A 1
    stop
  }
}

// Spread version
actor CaptainAssBarrel2 : CaptainAssBarrel {
  Damage (150)
  Radius 20  // 14
  Height 56  // 28
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 20, 0, 1)
    TNT1 A 1 A_GiveInventory("ReSyncPickup")
   SpawnL:
    6P42 CCCCCCCCC 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 C 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 C 0 A_SetArg(0, args[0] + 3)
    6P42 C 0 A_JumpIf(args[0] >= 9, "SpawnF")
    loop
   SpawnF:
    6P42 DDCCCCCCC 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 C 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 C 0 A_SetArg(0, args[0] + 3)
    6P42 CCCCCCCCC 1 A_JumpIfInTargetInventory("CaptainAssDetonateFlag", 1, "XDeath")
    6P42 C 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "XDeath")
    6P42 C 0 A_SetArg(0, args[0] + 3)
    loop
   XDeath:
    6P42 C 0 A_SpawnItemEx("CaptainAssBarrelBoom2", 0, 0, 28, 0, 0, 0, 0, 32768)
    goto CaptainAssBarrel::XDeath+1
   Death:
    6P42 C 1 A_SpawnItemEx("CaptainAssBarrelSit2", 0, 0, 0, 0, 0, 0, 0, 1 | 32768)
    6P42 C 1
    stop
  }
}

actor CaptainAssBarrelBoom : BasicExplosion {
  Translation "192:192=69:69", "198:198=74:74", "118:118=95:95", "119:119=3:3"
  DamageType "CaptainAss"
  Obituary "$OB_42M1"
  +FORCEXYBILLBOARD
  +BRIGHT
  // Meleerange 28
  Accuracy 6
  Mass 125
  Scale 3.5
  States {
   Spawn:
    6P42 E 0
    6P42 E 0 A_JumpIf(args[0] >= 3, 1)
    goto Boom
    6P42 E 0 A_SetDamageType("CaptainAssStun")
   Boom:
    6P42 E 0 A_Explode(mass + args[0] * accuracy, 160, 0, 0, 28 + args[0])
   BoomFX:
    6P42 E 0 A_PlaySound("CaptAss/BarrelBoom", 1, 0.85)
    6P42 EFGH 2
    stop
  }
}
actor CaptainAssBarrelBoom2 : CaptainAssBarrelBoom {
  Mass 375
  Scale 5.0
  States {
   Spawn:
    6P42 E 0
    6P42 E 0 A_JumpIf(args[0] >= 9, 1)
    goto Boom
    6P42 E 0 A_SetDamageType("CaptainAssStun")
   Boom:
    6P42 E 0 A_Explode(mass + args[0] * accuracy, 178, 0, 0, 28 + args[0])
    goto BoomFX
  }
}

actor CaptainAssBarrelSit : CaptainAssBarrel {
  DamageType "CaptainAss"
  Obituary "$OB_42M2"
  +THRUGHOST
  +DONTBLAST
  -HEXENBOUNCE
  +NOGRAVITY
  +NOEXPLODEFLOOR
  States {
   Spawn:
    6P42 A 0
    6P42 A 0 A_JumpIf(args[0] >= 3, "SpawnF")
    goto SpawnL
   Death:
    goto XDeath
  }
}
actor CaptainAssBarrelSit2 : CaptainAssBarrel2 {
  DamageType "CaptainAss"
  Obituary "$OB_42M2"
  +THRUGHOST
  +DONTBLAST
  -HEXENBOUNCE
  +NOGRAVITY
  +NOEXPLODEFLOOR
  States {
   Spawn:
    6P42 C 0
    6P42 A 0 A_JumpIf(args[0] >= 9, "SpawnF")
    goto SpawnL
   Death:
    goto XDeath
  }
}

//
//

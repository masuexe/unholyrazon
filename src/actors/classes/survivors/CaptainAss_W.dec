// It's back! Except without the... detonating stuff, y'know?
actor CaptainAssBombs : BasicProjectile {
  Translation "192:192=74:74", "198:198=3:3"
  +SKYEXPLODE
  DamageType "CaptainAss"
  Obituary "$OB_42A2"
  // Just like before, but I can't think of a good obit.
  // I don't know uhh...
  // "%k illegally took %o's life."
  // You tell me.
  Radius 8
  Height 8
  Scale 2.5
  Damage (75)
  Speed 55
  States {
   Spawn:
    X_BF VWXY 3
    loop
   Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("CaptainAssBombs_Explode", 0, 0, 0, 0, 0, 0, 0, 1)  // SXF_TRANSFERSPECIAL
    stop
  }
}

actor CaptainAssBombs_Explode : BasicExplosion {
  DamageType "CaptainAss"
  Obituary "$OB_42A2"
  Scale 2.5
  Args 25, 50, 12
  States {
   Spawn:
    X_BF A 0
    X_BF A 0 A_PlaySound("weapon/rmineexplode")
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF B 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF C 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF D 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF F 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF G 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF H 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF I 1
    X_BF A 1 A_Explode(args[0], args[1], 0, 0, args[2])
    X_BF J 1
    X_BF ANAPOPO 1
    stop
  }
}

actor GreatShielderShiny_W_NormalBar : NormalBar { Args 224, 28 }

actor GreatShielderShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_GreatShielder_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_05"
Obituary "$OB_05W"
weapon.ammotype "TurtleEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H05 [ 6
loop

Deselect:
7H05 A 0 A_GiveInventory("StopShield",1)
goto DeselectSwap
Select:
7H05 A 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
7H05 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", GREATSHIELDER_SDYE)
7H05 A 0 A_TakeInventory("GreatShielderFlag")
7H05 A 0 A_TakeInventory("StopShield")
7H05 A 1 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",200,"Ready3")
7H05 A 2 A_WeaponReady(WRF_NOSECONDARY)
7H05 A 0 A_GiveInventory("TurtleEnergyAmmo",3)
loop
Ready3:
7H05 A 2 A_WeaponReady
7H05 A 0 A_GiveInventory("TurtleEnergyAmmo",3)
loop

Flash:
7H05 WV 2
Flash_Ready:
7H05 U 0 A_GiveInventory("GreatShieldHitbox_P",1)
goto Flash.Idle
Flash.Idle:
7H05 U 0 A_SpawnItemEx("GreatShieldFX",23,-17,5,momx,momy,momz,0,1+8)
7H05 U 0 A_JumpIfInventory("GreatShielderFlag",1,"Flash_CrushAttack")
7H05 U 1 A_JumpIfInventory("StopShield",1,1)
loop
7H05 VW 2
stop
Flash_CrushAttack:
7H05 X 1
7H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-13,5,momx,momy,momz,0,1+8)
7H05 X 1
7H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-9,5,momx,momy,momz,0,1+8)
7H05 Y 1
7H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-5,5,momx,momy,momz,0,1+8)
7H05 Y 1 A_TakeInventory("GreatShielderFlag")
7H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-5,5,momx,momy,momz,0,1+8)
7H05 Y 1
7H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-9,5,momx,momy,momz,0,1+8)
7H05 X 1
7H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-13,5,momx,momy,momz,0,1+8)
7H05 X 1
goto Flash.Idle

Fire:
7H05 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H05 B 2 A_GiveInventory("StopShield",1)
7H05 C 2 A_GiveInventory("TurtleEnergyAmmo",4)
7H05 E 0 A_GiveInventory("S_GreatShielderMainF_P")
7H05 EEE 4 A_GiveInventory("TurtleEnergyAmmo",4)
7H05 D 2 A_GiveInventory("TurtleEnergyAmmo",4)
7H05 C 2 A_TakeInventory("StopShield")
7H05 B 0 A_GunFlash("Flash",1)
7H05 B 2 A_GiveInventory("TurtleEnergyAmmo",4)
7H05 A 2
7H05 A 2 A_GiveInventory("TurtleEnergyAmmo",2)
7H05 A 0 A_GiveInventory("TurtleEnergyAmmo",2)
Goto Ready2
AltFire:
7H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",200,"CrushAttack")
goto Ready2
CrushAttack:
7H05 F 0 A_TakeInventory("TurtleEnergyAmmo",125,1)
7H05 F 0 A_TakeInventory("TurtleEnergyAmmo",75)
7H05 F 0 A_GiveInventory("GreatShielderFlag",1)
7H05 F 1
7H05 F 0 A_PlaySoundEx("weapon/chargekick","Weapon")
7H05 F 1 A_ChangeVelocity(Cos(pitch)*4+3, 0, -sin(pitch)*2.3,CVF_RELATIVE)
7H05 G 0 A_SpawnItemEx("S_GreatBumRush",0,0,32,momx,momy,momz,0,8)
7H05 G 1 A_ChangeVelocity(Cos(pitch)*5+4, 0, -sin(pitch)*3,CVF_RELATIVE)
7H05 G 0 A_SpawnItemEx("S_GreatBumRush",0,0,32,momx,momy,momz,0,8)
7H05 G 1 A_ChangeVelocity(Cos(pitch)*6+5, 0, -sin(pitch)*3.6,CVF_RELATIVE)
7H05 G 0 A_SpawnItemEx("S_GreatBumRush",0,0,32,momx,momy,momz,0,8)
7H05 G 1 A_ChangeVelocity(Cos(pitch)*7+6, 0, -sin(pitch)*4.3,CVF_RELATIVE)
7H05 G 0 A_SpawnItemEx("S_GreatBumRush",0,0,32,momx,momy,momz,0,8)
7H05 G 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire6")
7H05 FFAAAA 1
Goto Ready2




BotFire:
7H05 A 0 A_Jump(12,"BotFire3")
7H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",100,"BotFire2")
goto Fire+1
BotFire2:
7H05 A 0 A_Jump(128,2)
7H05 A 0 A_Jump(64,"BotFire5")
goto Fire+1
7H05 A 0 A_TakeInventory("TurtleEnergyAmmo",80)
goto CrushAttack+2

BotFire3:
7H05 A 0 A_PlaySoundEx("taunt/D_05","Voice")
7H05 A 0 A_PlaySound("weapon/mirrorabsorb")
7H05 A 0 A_GiveInventory("StopShield",1)
7H05 A 0 A_GiveInventory("BotFlagDelay",50)
7H05 BCDEEE 2
BotFire4:
7H05 E 0 A_PlaySoundEx("BBA_Snd/shotgun_x","Weapon")
7H05 E 0 A_GiveInventory("TurtleEnergyAmmo",1)
7H05 E 1 A_FireCustomMissile("S_ShotGunShot1",random(-10,10),0,8,0,0,random(-5,5))
7H05 E 1 A_FireCustomMissile("S_ShotGunShot2",random(-10,10),0,8,0,0,random(-5,5))
7H05 E 1 A_FireCustomMissile("S_ShotGunShot3",random(-10,10),0,8,0,0,random(-5,5))
7H05 E 0 A_TakeInventory("BotFlagDelay",1)
7H05 E 1 A_JumpIfInventory("BotFlagDelay",1,"BotFire4")
7H05 DC 2
7H05 B 0 A_TakeInventory("StopShield")
7H05 B 0 A_GunFlash("Flash",1)
7H05 BAA 2
Goto Ready2
BotFire5:
7H05 A 0 A_PlaySoundEx("taunt/D_05","Voice")
7H05 A 0 A_PlaySound("weapon/mirrorabsorb")
7H05 A 0 A_GiveInventory("BotFlagDelay",6)
7H05 A 0 A_GiveInventory("Shocked",1)
7H05 A 0 A_TakeInventory("TurtleEnergyAmmo",50)
BotFire6:
7H05 A 10 A_FaceTarget
7H05 A 0 A_TakeInventory("BotFlagDelay",1)
7H05 A 1 A_FaceTarget
goto CrushAttack+2
}
}

actor S_GreatShielderMainF_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("BBA_Snd/shotgun_x","Weapon")
TNT1 A 0 A_FireCustomMissile("S_ShotGunShot1",0,0,8,0)
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot1",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot1",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot2",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot2",random(0,10),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot3",random(0,10),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("S_ShotGunShot3",random(0,10),0,8,0,0,random(-5,5))
stop
}
}


actor S_ShotGunShot1 : ShotGunShot1
{
Translation "4:4=224:224","198:198=28:28"
Damage (15)//10
}

actor S_ShotGunShot2 : S_ShotGunShot1
{
Damage (21)//14
Speed 80
}

actor S_ShotGunShot3 : S_ShotGunShot1
{
Damage (9)//6
Speed 60
}

actor S_GreatBumRush : GreatBumRush
{
Args 188,80,20//125
}


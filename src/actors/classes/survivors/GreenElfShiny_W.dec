actor GreenElfShiny_W_ScriptBar : ScriptBar {}

actor GreenElfShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_GreenElf_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_47"
Obituary "$OB_47W"
weapon.ammotype "StolenTreasureAmmo"
States
{
Spawn:
7H47 [ 6
loop

Deselect:
7H47 A 0
goto DeselectSwap
Select:
7H47 A 0 A_TakeInventory("GreenElfFlag", 1)
goto SelectSwap

Ready:
7H47 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", GREENELF_SDYE)
7H47 A 0 A_TakeInventory("GreenElfFlag", 1)
7H47 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
7H47 A 2 A_GiveInventory("GreenElf_WepReady_P")
loop

Flash:
TNT1 A 1 A_GiveInventory("GreenElf_LowHP_P")
loop

Fire:
7H47 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H47 A 0 A_JumpIfInventory("GreenElfQuickDraw",1,4)
7H47 BCD 3
goto FireH
7H47 BCD 2
goto FireH
FireH:
7H47 E 1 A_GiveInventory("GreenElf_FireHold_P")
7H47 E 0 A_Refire("FireH")
FireEnd:
7H47 F 2 A_GiveInventory("S_GreenElf_Fire_P")
7H47 G 2
Goto Ready2

Altfire:
7H47 A 0 A_GiveInventory("VivifyDelay4")
7H47 A 0 A_Refire(1)
7H47 A 2 Offset(-14,74)A_PlaySound("GNT/RNGMelee",1)
7H47 H 2 Offset(62,68)A_FireCustomMissile("S_GreenElfMeleeStab",0,0,0,0)
7H47 H 6 Offset(2,32)
7H47 H 2 Offset(28,50)
7H47 H 2 Offset(54,68)
7H47 H 2 Offset(80,86)
7H47 H 2 Offset(106,104)
TNT1 A 2 A_Refire(3)
7H47 A 2 Offset(-18,80)A_Refire(2)
7H47 A 2 Offset(-9,54)A_Refire("Altfire")
Goto Ready2
7H47 H 0 Offset(106,104)A_GiveInventory("VivifyDelay4")
7H47 H 0 A_Refire(1)
7H47 H 2 A_PlaySound("GNT/RNGMelee",1)
goto Altfire+3
AltfireOld:
7H47 G 0 A_GiveInventory("GreenElf_OldAlt_P")
7H47 GFGA 3
Goto Ready2


BotFire:
7H47 A 0 A_JumpIfInventory("BotFlag2",1,"BotFireSuper")
7H47 A 0 A_FaceTarget
7H47 A 0 A_JumpIfCloser(128,"BotAltfire")
7H47 A 0 A_JumpIfInventory("StolenTreasureAmmo",300,"AltfireOld")
7H47 A 0 A_Jump(32,1)
goto BotFire1
7H47 A 0 A_PlaySoundEx("taunt/D_S47","Voice")
7H47 A 0 A_Jump(9,2)
7H47 A 0 A_GiveInventory("GreenElfFlag",random(40,80))
goto BotFire1
7H47 A 0 A_PlaySoundEx("GNT/KeyCollect","Auto")
7H47 A 0 A_GiveInventory("BotFlag2",512)
goto BotFireSuper

BotFireSuper:
7H47 E 0 A_JumpIfInventory("StolenTreasureAmmo",0,5)
7H47 E 0 A_GiveInventory("StolenTreasureAmmo",30)
7H47 E 2 A_GiveInventory("S_GreenElf_Fire_P")
7H47 F 2 A_TakeInventory("BotFlag2",1)
7H45 F 0 A_Refire("BotFireSuper")
Goto Ready2
7H47 F 0 A_GiveInventory("GreenElfFlag",random(1,5)*20)
7H47 F 0 A_TakeInventory("StolenTreasureAmmo", 1)
goto BotFireSuper+2

BotFire1:
7H47 A 0 A_JumpIfInventory("GreenElfQuickDraw",1,4)
7H47 BCD 3 A_Jump(12,"FireEnd")
goto BotFireH
7H47 BCD 2 A_Jump(12,"FireEnd")
goto BotFireH

BotFireH:
7H47 E 0 A_JumpIfInventory("GreenElfFlag",0,"BotFireH2")
7H47 E 0 A_Jump(8,2)
7H47 E 0 A_GiveInventory("GreenElfFlag",random(1,3))
goto BotFireH3
7H47 E 0 A_Recoil(random(-9,9))
7H47 E 0 ThrustThing(angle*256/360+64,random(-12,12),1,0)
goto BotFireH3
BotFireH2:
7H47 E 0 A_Jump(4,2)
7H47 E 0 A_Jump(48,"FireEnd")
goto BotFireH+1
7H47 E 0 A_PlaySoundEx("taunt/D_S47","Voice")
7H47 E 0 A_ChangeVelocity(-40,0,momz+4,3)
goto FireEnd
BotFireH3:
7H47 E 0 A_Jump(4,3)
7H47 E 1 A_GiveInventory("GreenElf_FireHold_P")
7H47 E 0 A_Refire("BotFireH")
goto FireEnd
7H47 E 0 A_FaceTarget
goto FireEnd

BotAltfire:
7H47 H 0 A_GiveInventory("VivifyDelay4")
7H47 H 0 A_PlaySound("GNT/RNGMelee",1)
7H47 H 0 A_Refire(1)
7H47 H 18 A_FireCustomMissile("GreenElfMeleeStab",0,0,0,0)
7H47 H 0 A_FaceTarget
7H47 H 2 A_JumpIfCloser(128,"BotAltfire")
7H47 FG 2
Goto Ready2

}
}

actor S_GreenElf_Fire_P : GreenElf_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",100,"F_5")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",80,"F_4")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",60,"F_3")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",40,"F_2")
TNT1 A 0 A_JumpIfInventory("GreenElfFlag",20,"F_1")
goto F_0

F_5:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",15,0,-5,0)
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",-15,0,5,0)
F_4:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",12,0,-4,0)
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",-12,0,4,0)
F_3:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",9,0,-3,0)
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",-9,0,3,0)
F_2:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",6,0,-2,0)
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",-6,0,2,0)
F_1:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",3,0,-1,0)
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrow",-3,0,1,0)
F_0:
TNT1 A 0 A_FireCustomMissile("S_GreenElfArrowSnd",0,0,0,0)
goto End
}
}



actor KateShiny_W_NormalBar : NormalBar {args 196, 198}
actor KateShiny_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_53_S"
  Obituary "$OB_53S1"
  Tag "$TAG_KateShiny_W"
  Weapon.AmmoType "MistCloakAmmo"
  Inventory.Icon "C_I_53A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H53 [ 6
    loop

   Deselect:
    7H53 A 0
    goto DeselectSwap
   Select:
    7H53 A 0
    goto SelectSwap

   Ready:
    7H53 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", KATE_SDYE)
    goto Ready2
   Ready2:
    7H53 A 0 A_JumpIfInventory("KateMistFlag", 1, "ReadyX")
    7H53 A 2 A_GiveInventory("Kate_WepReady_P")
    wait
   ReadyX:
    7H53 L 2 A_GiveInventory("Kate_WepReady_P")
    7H53 L 0 A_JumpIfInventory("MistCloakAmmo", 1, "ReadyX")
    7H53 L 0 A_GiveInventory("S_Kate_AltOff_P")
    7H53 KJI 2 A_WeaponReady(WRF_NOSECONDARY)
    goto Ready2+1

   BotFire:
    7H53 A 0 A_JumpIfInventory("MistCloakAmmo", 0, "BotFire2")
    7H53 A 0 A_Jump(16, 2)
    7H53 A 0 A_Jump(2, "BotSwap")
    goto Fire+1
    7H53 A 0 A_PlaySoundEx("classes/taunt/kate", "Voice")
    7H53 A 0 A_GiveInventory("MistCloakAmmo", random(45, 90))
    goto Fire+1
   BotFire2:
    7H53 A 0 A_Jump(16, "AltfireDash")
    7H53 A 0 A_Jump(64, "BotSwap")
    goto Fire+1

   BotSwap:
    7H53 A 0 A_PlaySoundEx("classes/taunt/kate", "Voice")
    7H53 A 0 A_GiveInventory("MistCloakAmmo", 300)
    7H53 A 0 A_SelectWeapon("Kate_W2")
    goto Altfire2

   Fire:
    7H53 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H53 B 2 A_GiveInventory("S_Kate_Fire_P1")
    7H53 CDEFZZZGHA 2
    goto Ready2

   Altfire:
    7H53 A 0 A_JumpIfInventory("KateMistFlag", 1, "AltfireDash")
    7H53 A 0 A_JumpIfInventory("MistCloakAmmo", 0, "Altfire2")
    goto Ready2

   Altfire2:
    7H53 A 2 A_GiveInventory("S_Kate_AltOn_P")
    7H53 A 0 A_ReFire("Altfire3")
    goto ReadyX
   Altfire3:
    7H53 A 1 A_TakeInventory("MistCloakAmmo", 1)
    7H53 A 0 A_ReFire(1)
    goto ReadyX
    7H53 A 0 A_JumpIfInventory("MistCloakAmmo", 1, 1)
    goto ReadyX+2
    7H53 A 1 A_TakeInventory("MistCloakAmmo", 1, 1)
    7H53 A 0 A_ReFire(1)
    goto ReadyX
    7H53 A 0 A_JumpIfInventory("MistCloakAmmo", 1, "Altfire3")
    goto ReadyX+2

   AltfireDash:
    7H53 K 2 A_GiveInventory("S_Kate_AltDash_P")
    7H53 JI 2
    goto Ready2
  }
}

actor KateShiny_W2_NormalBar : KateShiny_W_NormalBar {}
actor KateShiny_W2 : KateShiny_W {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 150
  Inventory.Pickupmessage "$PU_53_B"
  Obituary "$OB_53S2"
  Tag "$TAG_KateShiny_W2"
  Weapon.AmmoType "MistCloakAmmo"
  Inventory.Icon "C_I_53B"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H53 [ 6
    loop

   Deselect:
    7H53 M 0
    goto DeselectSwap
   Select:
    7H53 M 0
    goto SelectSwap

   Ready:
    7H53 M 0 ACS_NamedExecuteWithResult("core_weaponcolor", KATE_SDYE)
    goto Ready2
   Ready2:
    7H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "ReadyX")
    7H53 M 2 A_GiveInventory("Kate_WepReady_P")
    wait
   ReadyX:
    7H53 Y 2 A_GiveInventory("Kate_WepReady_P")
    7H53 Y 0 A_JumpIfInventory("MistCloakAmmo", 1, "ReadyX")
    7H53 Y 0 A_GiveInventory("S_Kate_AltOff_P")
    7H53 XWV 2 A_WeaponReady(WRF_NOSECONDARY)
    goto Ready2+1

   BotFire:
    7H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "BotFire2")
    7H53 M 0 A_Jump(16, "BotFireX")
    7H53 M 0 A_JumpIfCloser(256, 2)
    7H53 M 0 A_Jump(196, "BotSwap")
    goto Fire+1
    7H53 M 0 A_Jump(16, "BotSwap")
    goto Fire+1
   BotFire2:
    7H53 M 0 A_Jump(1, "AltfireDash")
    7H53 M 1 A_Recoil(-2)
    7H53 M 0 A_JumpIfCloser(128, 3)
    7H53 M 0 A_Jump(5, "BotFireX")
    7H53 M 0 A_ReFire("Fire")
    goto Ready2
    7H53 M 0 A_FaceTarget
    goto Fire+1
   BotFireX:
    7H53 M 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    7H53 M 0 A_PlaySoundEx("classes/taunt/kate", "Voice")
    7H53 M 0 A_Warp(2)
    7H53 M 0 A_FaceTarget
    goto Fire+1

   BotSwap:
    7H53 M 0 A_PlaySoundEx("classes/taunt/kate", "Voice")
    7H53 M 0 A_GiveInventory("MistCloakAmmo", random(75, 150))
    7H53 M 0 A_SelectWeapon("Kate_W")
    7H53 M 1 A_WeaponReady
    wait

   Fire:
    7H53 M 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H53 M 0 A_GiveInventory("Kate_Fire_P2")
    7H53 M 1 Offset(-37, 8)  // A_FireCustomMissile("KateMeleeStab",0,0,16,0)
    7H53 N 1 Offset(-70, 29)  // A_FireCustomMissile("KateMeleeStab",0,0,0,0)
    7H53 N 1 Offset(-90, 39)  // A_FireCustomMissile("KateMeleeStab",0,0,-16,0)
    7H53 N 1 Offset(-107, 50)
    7H53 N 6 Offset(-127, 63)
    7H53 N 2 Offset(-97, 55)
    7H53 N 2 Offset(-67, 48)
    7H53 N 2 Offset(-37, 42)
    7H53 M 2 Offset(-20, 24)
    goto Ready2

   Altfire:
    7H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "AltfireDash")
    7H53 M 0 A_JumpIfInventory("MistCloakAmmo", 0, "Altfire2")
    goto Ready2

   Altfire2:
    7H53 M 2 A_GiveInventory("S_Kate_AltOn_P")
    7H53 M 0 A_ReFire("Altfire3")
    goto ReadyX
   Altfire3:
    7H53 M 1 A_TakeInventory("MistCloakAmmo", 1)
    7H53 M 0 A_ReFire(1)
    goto ReadyX
    7H53 M 0 A_JumpIfInventory("MistCloakAmmo", 1, 1)
    goto ReadyX+2
    7H53 M 1 A_TakeInventory("MistCloakAmmo", 1, 1)
    7H53 M 0 A_ReFire(1)
    goto ReadyX
    7H53 M 0 A_JumpIfInventory("MistCloakAmmo", 1, "Altfire3")
    goto ReadyX+2

   AltfireDash:
    7H53 X 2 A_GiveInventory("S_Kate_AltDash_P")
    7H53 WV 2
    goto Ready2
  }
}

actor S_Kate_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_KateShadowBlade", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySound("weapon/shadow", 1)
    TNT1 A 0 A_JumpIfInventory("KateMistFlag", 1, "Take")
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 10)
    stop
   Take:
    TNT1 A 0 A_GiveInventory("S_Kate_AltOff_P")
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 40, 1)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 40)
    stop
  }
}

actor S_Kate_Fire_P2 : S_Kate_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_KateMeleeStab", 0, 0, 0, 0)
    TNT1 A 0 A_PlaySound("wep/KateStab", 1)
    TNT1 A 0 A_JumpIfInventory("KateMistFlag", 1, "Take")
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 10)
    stop
  }
}

actor S_Kate_AltOn_P : Kate_AltOn_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("S_KateShardFX_H")
    TNT1 A 0 A_SpawnItemEx("S_KateMistFX_H")
    goto Pickup0
  }
}
actor S_Kate_AltOff_P : Kate_AltOff_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("S_KateShardFX_H")
    goto Pickup0
  }
}

actor S_Kate_AltDash_P : Kate_AltDash_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("S_KateMistFX_H")
    TNT1 A 0 A_GiveInventory("S_Kate_AltOff_P")
    goto Pickup0
  }
}


actor S_KateShadowBlade : KateShadowBlade {
  Translation "192:192=4:4", "198:198=205:205", "247:247=198:198"
  Damage (188)  // 125
}

actor S_KateShardFX_H : KateShardFX_H {
  Translation "192:192=69:69", "198:198=75:75"
  // Translation "192:192=205:205","198:198=198:198"
}

actor S_KateMistFX_H : KateMistFX_H {
  Translation "192:192=196:196", "198:198=197:197"
}

actor S_KateMeleeStab : KateMeleeStab {
  Translation "192:192=205:205", "198:198=198:198"
  DamageType "S_KateBackstab"
}

actor S_KateMeleeStabFront : KateMeleeStabFront {
  Translation "192:192=205:205", "198:198=198:198"
  Args 300  // 200
}

actor S_KateMeleeStabBack : KateMeleeStabFront {
  Translation "192:192=205:205", "198:198=198:198"
  Args 1800  // 1200
}

actor PainS_KateBackstabHit : PainKateBackstabHit {
  States {
   Front:
    TNT1 A 3 A_SpawnItemEx("S_KateMeleeStabFront", 0, 0, 32)
    stop
   Back:
    TNT1 A 3 A_SpawnItemEx("S_KateMeleeStabBack", 0, 0, 32)
    stop
  }
}

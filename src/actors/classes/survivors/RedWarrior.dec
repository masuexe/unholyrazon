    goto Spawn2}}
actor Corpse_44_4 : BaseCorpseFX {States {Spawn: 1H44 S 350
    goto Spawn2}}
actor Corpse_44_5 : BaseCorpseFX {States {Spawn: 1H44 T 350
    goto Spawn2}}
actor Corpse_44_6 : BaseCorpseFX {States {Spawn: 1H44 U 350

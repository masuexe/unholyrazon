actor RedWarrior : CustWepClassBase
{
player.scoreIcon "UMUG_44"
player.displayname "RedWarrior"
player.soundclass "RedWarrior"
Player.Maxhealth 1600
health 1600
player.forwardmove 0.55, 0.55
player.sidemove 0.55, 0.55
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "RedWarrior_W"
player.startitem "RedWarrior_W2"
player.startitem "RedWarrior_W3"
player.startitem "RedWarrior_W4"
player.startitem "RedWarrior_W5"
player.startitem "RedWarrior_W6"
player.startitem "TreasureAmmo", 150

player.weaponslot 1, "RedWarrior_W"
player.weaponslot 2, "RedWarrior_W2"
player.weaponslot 3, "RedWarrior_W3"
player.weaponslot 4, "RedWarrior_W4"
player.weaponslot 5, "RedWarrior_W5"
player.weaponslot 6, "RedWarrior_W6"
States
{
Spawn:
TOMM A 0
TOMM B 1
TOMM A 1
Goto Spawn+2
See:
TOMM BCDE 5
Goto Spawn
Missile:
TOMM F 0 A_JumpIfInventory("VivifyDelay4",1,"MissileAlt")
TOMM F 2
TOMM G 6
goto Spawn+2
MissileAlt:
TOMM F 10
goto Spawn+2

ClassPain: TOMM H 0
Goto MegamanPain

ClassDeath:
TOMM H 0
goto MegamanDeath
MegamanDeath0:
TOMM H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
TOMM H 0 A_SpawnItemEx("GauntletTreasure_P",0,0,Height/2,random2()/256.0,random2()/256.0,5.0+random2()/64.0)
//A_SpawnItemEx("GauntletTreasure_P",0,0,24,random2(7),random2(7),0)
Goto MegamanFade3
MegamanCorpse:
TOMM Z 0 A_SpawnItemEx("Corpse_44",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor RedWarriorS : RedWarrior
{
player.soundclass "SNDX44"
player.scoreIcon "UMUG_S44"
Player.Maxhealth 3600
health 3600
player.forwardmove 0.66, 0.66
player.sidemove 0.66, 0.66
player.jumpz 11
player.morphweapon "RedWarriorS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}


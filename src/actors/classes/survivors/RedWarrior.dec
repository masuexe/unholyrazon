actor RedWarrior : CustWepClassBase {
  Player.ScoreIcon "UMUG_44"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "RedWarrior"
  Player.SoundClass "RedWarrior"
  Player.MaxHealth 1600
  Health 1600
  Player.ForwardMove 0.55, 0.55
  Player.SideMove 0.55, 0.55
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "RedWarrior_W"
  Player.StartItem "RedWarrior_W2"
  Player.StartItem "RedWarrior_W3"
  Player.StartItem "RedWarrior_W4"
  Player.StartItem "RedWarrior_W5"
  Player.StartItem "RedWarrior_W6"
  Player.StartItem "TreasureAmmo", 150

  Player.WeaponSlot 1, "RedWarrior_W"
  Player.WeaponSlot 2, "RedWarrior_W2"
  Player.WeaponSlot 3, "RedWarrior_W3"
  Player.WeaponSlot 4, "RedWarrior_W4"
  Player.WeaponSlot 5, "RedWarrior_W5"
  Player.WeaponSlot 6, "RedWarrior_W6"
  States {
   Spawn:
    TOMM A 0
    TOMM B 1
    TOMM A 1
    goto Spawn+2
   See:
    TOMM BCDE 5
    goto Spawn
   Missile:
    TOMM F 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileAlt")
    TOMM F 2
    TOMM G 6
    goto Spawn+2
   MissileAlt:
    TOMM F 10
    goto Spawn+2

   ClassPain:
    TOMM H 0
    goto MegamanPain

   ClassDeath:
    TOMM H 0
    goto MegamanDeath
   MegamanDeath0:
    TOMM H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TOMM H 0 A_SpawnItemEx("GauntletTreasure_P", 0, 0, Height / 2, random2() / 256.0, random2() / 256.0, 5.0 + random2() / 64.0)
    // A_SpawnItemEx("GauntletTreasure_P",0,0,24,random2(7),random2(7),0)
    goto MegamanFade3
   MegamanDisintegrate:
    TOMM Z 0 A_SpawnItemEx("Corpse_44", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor RedWarriorShiny : RedWarrior {
  Player.SoundClass "SNDX44"
  Player.ScoreIcon "UMUG_S44"
  Player.MaxHealth 3600
  Health 3600
  Player.ForwardMove 0.66, 0.66
  Player.SideMove 0.66, 0.66
  Player.JumpZ 11
  Player.MorphWeapon "RedWarriorShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_44 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_44_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_44_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_44_0 : BaseCorpseFX {States {Spawn: 1H44 O 350
    goto Spawn2}}

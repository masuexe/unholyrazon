actor DecoyBot : CustWepClassBase
{
player.scoreIcon "UMUG_50"
player.displayname "DecoyBot"
player.soundclass "DecoyBot"
player.maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 0.98, 0.98
player.jumpz 10

Player.StartItem "UH_BaseFlagPack"
player.startitem "IsDecoyBotFlag"
player.startitem "DecoyBotFlagCheck_P"
player.startitem "DecoyBot_W"
player.startitem "DecoyBot_W2"
player.startitem "DecoyBot_W3"
player.startitem "DecoyEnergyAmmo", 90
player.startitem "FlukyNumberAmmo", 150
//player.startitem "DecoyBotDebugItem" //Re-enable for testing purposes.


player.weaponslot 1, "DecoyBot_W"
player.weaponslot 2, "DecoyBot_W2"
player.weaponslot 3, "DecoyBot_W3"
States
{
Spawn:
1H50 A 0
1H50 B 1
1H50 A 1
Goto Spawn+2
See:
1H50 BCBC 5
Goto Spawn
Missile:
1H50 G 0 A_JumpIfInventory("VivifyDelay4",1,"Missile_58")
1H50 G 0 A_JumpIfInventory("VivifyCycle2",1,"Missile_51")
1H50 G 0 A_JumpIfInventory("DecoyVivify5",1,"Missile_50")
1H50 G 0 A_JumpIfInventory("DecoyCharge_F47",1,"Missile_47")
1H50 G 0 A_JumpIfInventory("VivifyDelay1",1,"Missile_12")
1H50 G 0 A_JumpIfInventory("VivifyDelay2",1,"Missile_05")
1H50 G 5
1H50 F 4
goto Spawn+2
Missile_05:
1H50 FG 5
goto Spawn+2
Missile_12:
1H50 FFMMFFMMFFMMFFMMFFMMFFMMFFMM 1 A_JumpIfInventory("VivifyDelay3",1,"Missile_12b")
Missile_12b:
1H50 G 7
goto Spawn+2
Missile_47:
1H50 FGGG 2
goto Spawn+2
Missile_50:
1H50 N 9
goto Spawn+2
Missile_58:
1H50 M 6
1H50 DDDEEE 1 A_JumpIfInventory("VivifyDelay5",1,"Missile_58e")
goto Missile_58+1
Missile_58e:
1H50 G 10
goto Spawn+2

Missile_51:
1H50 G 0 A_JumpIfInventory("VivifyCycle2",9,"Run51F")
1H50 G 0 A_JumpIfInventory("VivifyCycle2",8,"Run51E")
1H50 G 0 A_JumpIfInventory("VivifyCycle2",6,"Run51D")
1H50 G 0 A_JumpIfInventory("VivifyCycle2",4,"Run51E")//C
1H50 G 0 A_JumpIfInventory("VivifyCycle2",1,"Run51D")//B
1H50 "###" 1 A_JumpIfInventory("VivifyDelay3",1,"Missile_51A")
Missile_51A:
1H50 G 11
goto Spawn

Run51B:
1H50 B 1
Goto Missile_51+5
Run51C:
1H50 C 1
Goto Missile_51+5
Run51D:
1H50 D 1
Goto Missile_51+5
Run51F:
1H50 E 0 A_TakeInventory("VivifyCycle2",8)
Run51E:
1H50 E 1
Goto Missile_51+5


ClassPain: 1H50 H 0
Goto MegamanPain

ClassDeath:
1H50 H 0
goto MegamanDeath
MegamanDeath0:
1H50 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H50 H 0 A_JumpIfInventory("DeadlyFlag1",1,"DakuBoom")
1H50 H 0 A_Jump(34,"DakuBoom")
1H50 H 0 A_SpawnItemEx("DecoyBotDeathCorpse",0,0,12,-30,0,12,0,1)
1H50 H 0 A_ChangeVelocity(-30,0,12,3)
1H50 H 1 A_PlaySound("*death",2)
1H50 Z 2
Goto MegamanErase
DakuBoom:
1H50 H 1
1H50 Z 0 A_SpawnItemEX("DecoyBotDeathExplosion",0,0,28,0,0,0,0,1)
1H50 Z 0 A_PlaySound("classes/DakuSpecialSFX",2)
1H50 Z 0 A_ChangeVelocity(-5,0,10,1)
goto MegamanDisintegrate
MegamanDisintegrate:
1H50 Z 0 A_SpawnItemEx("Corpse_50",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}



actor HellishArmor: PowerProtection
{
damagefactor "Normal", 0.05
}

actor DeadlyPowerUp: PowerupGiver 
{
  inventory.maxamount 0
  powerup.duration -999999
  powerup.type "HellishArmor"
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  states
  {
  Spawn:
    TNT1 A 1
    loop
  }
}

actor DecoyBotDeathExplosion : BasicExplosion
{
damagetype "DecoyBot"
Obituary "$OB_50D2"
scale 3.0
Args 650,192,18
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
X_8B ABCDEF 2
stop
}
}
actor S_DecoyBotDeathExplosion : DecoyBotDeathExplosion
{
Args 975,192,18
}

actor DecoyBotDeathCorpse : BasicProjectile
{
damagetype "DecoyBot"
Obituary "$OB_50D1"
-NOGRAVITY
//+RIPPER
+SKYEXPLODE
+DONTSPLASH
+DONTREFLECT
+BOUNCEONWALLS
+BOUNCEONCEILINGS
BounceCount 10
BounceFactor 0.1
WallBounceFactor 0.90
Damage (250)
Radius 16
Height 32
speed 32
scale 2.5
Args 555,168,16
States
{
Spawn:
1H50 H 1
loop
Death:
TNT1 A 0 A_PlaySound("misc/devildeath")
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 1 A_SpawnItemEx("FakeUnholyDeathFX",0,0,32,0,0,0,0,1)
stop
}
}
actor S_DecoyBotDeathCorpse : DecoyBotDeathCorpse
{
Damage (375)
Args 833,168,16
}

actor Corpse_50:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_50_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_50_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


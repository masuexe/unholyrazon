actor DecoyBot : CustWepClassBase {
  Player.ScoreIcon "UMUG_50"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "DecoyBot"
  Player.SoundClass "DecoyBot"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 0.98, 0.98
  Player.JumpZ 10

  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "IsDecoyBotFlag"
  // Held guns come from uh_DecoyBotApplyHeldWeps (DecoyCopy_*_W1/W2/W3).
  // Do not startitem DecoyBot_W* — they only exist for ScriptBar / bar remap.
  Player.StartItem "DecoyBotStart_P"
  Player.StartItem "DecoyEnergyAmmo", 90
  Player.StartItem "FlukyNumberAmmo", 150
  // Player.StartItem "DecoyBotDebugItem" //Re-enable for testing purposes.

  // Number keys use Weapon.SlotNumber on DecoyCopy_*_W1/W2/W3 (not DecoyBot_W*).
  States {
   Spawn:
    1H50 A 0
    1H50 B 1
    1H50 A 1
    goto Spawn+2
   See:
    1H50 BCBC 5
    goto Spawn
   Missile:
    1H50 G 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile_58")
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 1, "Missile_51")
    1H50 G 0 A_JumpIfInventory("DecoyVivify5", 1, "Missile_50")
    1H50 G 0 A_JumpIfInventory("DecoyCharge_F47", 1, "Missile_47")
    1H50 G 0 A_JumpIfInventory("VivifyDelay1", 1, "Missile_12")
    1H50 G 0 A_JumpIfInventory("VivifyDelay2", 1, "Missile_05")
    1H50 G 5
    1H50 F 4
    goto Spawn+2
   Missile_05:
    1H50 FG 5
    goto Spawn+2
   Missile_12:
    1H50 FFMMFFMMFFMMFFMMFFMMFFMMFFMM 1 A_JumpIfInventory("VivifyDelay3", 1, "Missile_12b")
   Missile_12b:
    1H50 G 7
    goto Spawn+2
   Missile_47:
    1H50 FGGG 2
    goto Spawn+2
   Missile_50:
    1H50 N 9
    goto Spawn+2
   Missile_58:
    1H50 M 6
    1H50 DDDEEE 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile_58e")
    goto Missile_58+1
   Missile_58e:
    1H50 G 10
    goto Spawn+2

   Missile_51:
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 9, "Run51F")
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 8, "Run51E")
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 6, "Run51D")
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 4, "Run51E")  // C
    1H50 G 0 A_JumpIfInventory("VivifyCycle2", 1, "Run51D")  // B
    1H50 "###" 1 A_JumpIfInventory("VivifyDelay3", 1, "Missile_51A")
   Missile_51A:
    1H50 G 11
    goto Spawn

   Run51B:
    1H50 B 1
    goto Missile_51+5
   Run51C:
    1H50 C 1
    goto Missile_51+5
   Run51D:
    1H50 D 1
    goto Missile_51+5
   Run51F:
    1H50 E 0 A_TakeInventory("VivifyCycle2", 8)
   Run51E:
    1H50 E 1
    goto Missile_51+5


   ClassPain:
    1H50 H 0
    goto MegamanPain

   ClassDeath:
    1H50 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H50 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H50 H 0 A_JumpIfInventory("DeadlyFlag1", 1, "DakuBoom")
    1H50 H 0 A_Jump(34, "DakuBoom")
    1H50 H 0 A_SpawnItemEx("DecoyBotDeathCorpse", 0, 0, 12, -30, 0, 12, 0, 1)
    1H50 H 0 A_ChangeVelocity(-30, 0, 12, 3)
    1H50 H 1 A_PlaySound("*death", 2)
    1H50 Z 2
    goto MegamanErase
   DakuBoom:
    1H50 H 1
    1H50 Z 0 A_SpawnItemEx("DecoyBotDeathExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    1H50 Z 0 A_PlaySound("classes/DakuSpecialSFX", 2)
    1H50 Z 0 A_ChangeVelocity(-5, 0, 10, 1)
    goto MegamanDisintegrate
   MegamanDisintegrate:
    1H50 Z 0 A_SpawnItemEx("Corpse_50", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor DecoyBotShiny : DecoyBot {
  Player.ScoreIcon "UMUG_S50"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.08, 1.08
  Player.JumpZ 11
  Player.MorphWeapon "DecoyBotShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H50 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H50 H 0 A_JumpIfInventory("DeadlyFlag1", 1, "DakuBoom")
    1H50 H 0 A_Jump(34, "DakuBoom")
    1H50 H 0 A_SpawnItemEx("S_DecoyBotDeathCorpse", 0, 0, 12, -30, 0, 12, 0, 1)
    1H50 H 0 A_ChangeVelocity(-30, 0, 12, 3)
    1H50 H 1 A_PlaySound("*death", 2)
    1H50 Z 2
    goto MegamanErase
   DakuBoom:
    1H50 H 1
    1H50 Z 0 A_SpawnItemEx("S_DecoyBotDeathExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    1H50 Z 0 A_PlaySound("classes/DakuSpecialSFX", 2)
    1H50 Z 0 A_ChangeVelocity(-5, 0, 10, 1)
    goto MegamanDisintegrate
  }
}


actor HellishArmor : PowerProtection {
  damagefactor "Normal", 0.05
}

actor DeadlyPowerUp : PowerupGiver {
  Inventory.MaxAmount 0
  powerup.duration 0x7ffffffd
  powerup.type "HellishArmor"
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  States {
   Spawn:
    TNT1 A 1
    loop
  }
}

actor DecoyBotDeathExplosion : BasicExplosion {
  DamageType "DecoyBot"
  Obituary "$OB_50D2"
  Scale 3.0
  Args 650, 192, 18
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    X_8B ABCDEF 2
    stop
  }
}
actor S_DecoyBotDeathExplosion : DecoyBotDeathExplosion {
  Args 975, 192, 18
}

actor DecoyBotDeathCorpse : BasicNoClassTranslationProjectile {
  DamageType "DecoyBot"
  Obituary "$OB_50D1"
  -NOGRAVITY
  // +RIPPER
  +SKYEXPLODE
  +DONTSPLASH
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceCount 10
  BounceFactor 0.1
  WallBounceFactor 0.90
  Damage (250)
  Radius 16
  Height 32
  Speed 32
  Scale 2.5
  Args 555, 168, 16
  States {
   Spawn:
    1H50 H 1
    loop
   Death:
    TNT1 A 0 A_PlaySound("misc/devildeath")
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 1 A_SpawnItemEx("FakeUnholyDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_DecoyBotDeathCorpse : DecoyBotDeathCorpse {
  Damage (375)
  Args 833, 168, 16
}

actor Corpse_50 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_50_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_50_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_50_0 : BaseCorpseFX {States {Spawn: 1H50 O 350
    goto Spawn2}}
actor Corpse_50_1 : BaseCorpseFX {States {Spawn: 1H50 P 350
    goto Spawn2}}
actor Corpse_50_2 : BaseCorpseFX {States {Spawn: 1H50 Q 350
    goto Spawn2}}
actor Corpse_50_3 : BaseCorpseFX {States {Spawn: 1H50 R 350
    goto Spawn2}}
actor Corpse_50_4 : BaseCorpseFX {States {Spawn: 1H50 S 350
    goto Spawn2}}
actor Corpse_50_5 : BaseCorpseFX {States {Spawn: 1H50 T 350
    goto Spawn2}}
actor Corpse_50_6 : BaseCorpseFX {States {Spawn: 1H50 U 350
    goto Spawn2}}

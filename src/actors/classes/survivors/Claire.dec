actor Claire : CustWepClassBase {
  Player.ScoreIcon "UMUG_54"
  Player.DisplayName "Claire"
  Player.SoundClass "Claire"
  Player.MaxHealth 1100
  Health 1100
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.85, 0.85
  Player.JumpZ 11.5
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Claire_W"
  Player.StartItem "ClaireEnergyAmmo", 14
  Player.StartItem "ClaireZestAmmo", 84

  States {
   Spawn:
    1H54 A 0
    1H54 B 1
    1H54 A 1
    goto Spawn+2
   See:
    1H54 BCDE 5
    goto Spawn
   Missile:
    1H54 F 5
    1H54 G 4
    goto Spawn+2
   ClassPain:
    1H54 H 0
    goto MegamanPain

   ClassDeath:
    1H54 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H54 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H54 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H54 H 0 ThrustThingZ(0, 82, 0, 0)
    1H54 H 0 A_SpawnItemEx("ClaireKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    1H54 Z 0 A_SpawnItemEx("Corpse_54", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor ClaireShiny : Claire {
  Player.ScoreIcon "UMUG_S54"
  Player.MaxHealth 3200
  Health 3200
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 12.5
  Player.MorphWeapon "ClaireShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H54 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H54 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H54 H 0 ThrustThingZ(0, 82, 0, 0)
    1H54 H 0 A_SpawnItemEx("S_ClaireKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
  }
}


actor ClaireKirbyDeathCorpse : BasicKirbyDeathCorpse {
  DamageType "Claire"
  Obituary "$OB_54D"
  States {
   Spawn:
    1H54 H 0
    1H54 H 0
    goto Spawn2
  }
}
actor S_ClaireKirbyDeathCorpse : ClaireKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

actor Corpse_54 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_54_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_54_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_54_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_54_3", 0, 0, 18, velx + frandom(-1, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_54_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_54_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_54_0 : BaseCorpseFX {States {Spawn: 1H54 O 350
    goto Spawn2}}
actor Corpse_54_1 : BaseCorpseFX {States {Spawn: 1H54 P 350
    goto Spawn2}}
actor Corpse_54_2 : BaseCorpseFX {States {Spawn: 1H54 Q 350
    goto Spawn2}}
actor Corpse_54_3 : BaseCorpseFX {States {Spawn: 1H54 R 350
    goto Spawn2}}
actor Corpse_54_4 : BaseCorpseFX {States {Spawn: 1H54 S 350
    goto Spawn2}}
actor Corpse_54_5 : BaseCorpseFX {States {Spawn: 1H54 T 350
    goto Spawn2}}

actor BusterExpert : CustWepClassBase {
  Player.ScoreIcon "UMUG_3"
  Player.DisplayName "BusterExpert"
  Player.SoundClass "busterexpert"

  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.05, 1.05
  Player.JumpZ 10

  Player.StartItem "UH_BaseFlagPack"

  Player.StartItem "BusterExpert_W"
  Player.StartItem "ManlyManAmmo", 50

  States {
   Spawn:
    1H03 A 0
    1H03 B 1
    1H03 A 1
    goto Spawn+2
   See:
    1H03 BCDE 5
    goto Spawn
   Melee:
    1H03 FG 3
    goto Spawn+2
   Missile:
    1H03 FFFFF 1
    1H03 GGGG 1
    goto Spawn+2
   ClassPain:
    1H03 H 0
    goto MegamanPain

   ClassDeath:
    1H03 H 0
    goto MegamanDeath
   MegamanDisintegrate:
    1H03 Z 0 A_SpawnItemEx("Corpse_03", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor BusterExpertShiny : BusterExpert {
  Player.ScoreIcon "UMUG_S3"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 11
  Player.MorphWeapon "BusterExpertShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_03 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_03_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_03_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


actor BusterExpert : CustWepClassBase
{
Player.ScoreIcon "UMUG_3"
player.displayname "BusterExpert"
player.soundclass "busterexpert"

Player.Maxhealth 1000
health 1000
player.forwardmove 1.05, 1.05
player.sidemove 1.05, 1.05
player.jumpz 10

player.startitem "UH_BaseFlagPack"

player.startitem "BusterExpert_W"
player.startitem "ManlyManAmmo", 50

States
{
Spawn:
1H03 A 0
1H03 B 1
1H03 A 1
Goto Spawn+2
See:
1H03 BCDE 5
Goto Spawn
Melee:
1H03 FG 3
goto Spawn+2
Missile:
1H03 FFFFF 1
1H03 GGGG 1
goto Spawn+2
ClassPain: 1H03 H 0
Goto MegamanPain

ClassDeath:
1H03 H 0
Goto MegamanDeath
MegamanCorpse:
1H03 Z 0 A_SpawnItemEx("Corpse_03",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}

actor BusterExpertS : BusterExpert
{
player.scoreIcon "UMUG_S3"
Player.MaxHealth 3000
Health 3000
player.forwardmove 1.15, 1.15
player.sidemove 1.15, 1.15
player.jumpz 11
player.morphweapon "BusterExpertS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}


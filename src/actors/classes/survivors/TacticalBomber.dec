actor TacticalBomber : CustWepClassBase {
  Player.ScoreIcon "UMUG_8"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "TacticalBomber"
  Player.SoundClass "TacticalBomber"
  Player.MaxHealth 1200
  Health 1200
  Player.ForwardMove 1.35, 1.35
  Player.SideMove 0.75, 0.75
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "TacticalBomber_W"
  Player.StartItem "ExplosiveEnergyAmmo", 175
  States {
   Spawn:
    GREM A 0
    GREM B 1
    GREM A 1
    goto Spawn+2
   See:
    GREM BCDE 5
    goto Spawn
   Missile:
    GREM FFFFF 1
    GREM GGGG 1
    goto Spawn+2
   ClassPain:
    GREM H 0
    goto MegamanPain

   ClassDeath:
    GREM H 0
    goto MegamanDeath
   MegamanDeath0:
    GREM HHHHHHHHHHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    GREM H 0 A_SpawnItemEx("TacticalBomberDisintegrates", 0, 0, 16, 0, 0, 0, 0, 1)
    GREM H 1 A_SetTranslucent(0.0, 0)
    goto MegamanErase
   MegamanDisintegrate:
    GREM Z 0 A_SpawnItemEx("Corpse_08", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor TacticalBomberDisintegrates : BasicExplosion {
  DamageType "Cluster"
  Obituary "$OB_08D"
  Args 15, 100, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("TacticalBomberDisintegratesFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySound("Pokemon/Explosion", 1)
    TNT1 AAAAAAAAAAAAAAAAAAAA 1 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Explode(args[0], args[1], 0)
    stop
  }
}
actor S_TacticalBomberDisintegrates : TacticalBomberDisintegrates {
  Args 23, 100, 32
}

actor TacticalBomberDisintegratesFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 3.0
  States {
   Spawn:
    X_8G A 0
    X_8G ABCD 1
    X_8G FEFGFEFGFEFGFEFG 1 A_SpawnItemEx("DeathFX2", 0, 0, 0, random(-8, 8), random(-8, 8), random(0, 8))
    X_8G FEFGFEFGFEFGFEFGFEFGFEFGFGDDC 1
    stop
  }
}

actor TacticalBomberShiny : TacticalBomber {
  Player.ScoreIcon "UMUG_S8"
  Player.MaxHealth 3200
  Health 3200
  Player.ForwardMove 1.45, 1.45
  Player.SideMove 0.85, 0.85
  Player.JumpZ 11
  Player.MorphWeapon "TacticalBomberShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    GREM HHHHHHHHHHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    GREM H 0 A_SpawnItemEx("S_TacticalBomberDisintegrates", 0, 0, 16, 0, 0, 0, 0, 1)
    GREM H 1 A_SetTranslucent(0.0, 0)
    goto MegamanErase
  }
}

actor Corpse_08 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_08_0", 0, 0, 30, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_08_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


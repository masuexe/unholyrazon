actor GhostBuster : CustWepClassBase {
  player.scoreIcon "UMUG_57"
  player.displayname "GhostBuster"
  player.soundclass "GhostBuster"
  Player.Maxhealth 1000
  health 1000
  player.forwardmove 0.8, 0.8
  player.sidemove 1.03, 1.03
  player.jumpz 10
  //Player.ColorRange 189, 202//207
  Player.ColorRange 192, 204
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "GhostBuster_W"
  player.startitem "GhostBuster_W2"
  player.startitem "ProtonChargeAmmo", 150
  player.startitem "GhostTrapAmmo", 50

  player.weaponslot 1, "GhostBuster_W"
  player.weaponslot 2, "GhostBuster_W2"

  //BloodColor "GhostlyGreen"
  States {
   Spawn:
    1H57 A 0
    1H57 B 1
    1H57 A 1
    wait
   See:
    1H57 BCDE 4
    Goto Spawn
   Missile:
    1H57 F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile2")
    1H57 F 5
    1H57 G 4
    goto Spawn+2
   Missile2:
    1H57 GFGFGF 2
    1H57 G 4
    goto Spawn+2
   ClassPain: 1H57 H 0
    Goto MegamanPain

   ClassDeath:
    1H57 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H57 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H57 H 0 A_GiveInventory("GhostTrapDetonateFlag")
    1H57 H 0 A_SpawnItemEx("GhostBusterSkeletonCorpse", 0, 0, 12, -15, 0, 11, 0, 128+1)
    1H57 H 0 A_ChangeFlag("DONTSPLASH", 1)
    1H57 H 0 A_ChangeVelocity(0, 0, 0, 3)//-8,0,6
    1H57 H 0 A_GiveInventory("GhostBuster_DeathThruster_P")////////////Does it do anything?!?!
    1H57 H 0 ThrustThingZ(0, 44, 0, 0)//15
    1H57 H 1 A_Recoil(15)
    1H57 Z 0 A_PlaySoundEx("*death", 2)
    1H57 Z 2
    Goto MegamanErase

   MegamanDisintegrate:
    //1H57 Z 0 A_SpawnItemEx("Corpse_57",0,0,0,momx,momy,momz,0,1+8)
    1H57 Z 0 A_SpawnItemEx("GBust_GibSkull", 0, 0, 36, frandom(0.1f, 2), frandom(-1, 1), frandom(9, 13), 0, 1+32+128)
    1H57 Z 0 A_SpawnItemEx("GBust_GibBone", frandom(1, 10), 0, 6, frandom(1, 6), 0, frandom(9, 13), 33, 1+32+128)
    1H57 Z 0 A_SpawnItemEx("GBust_GibBone", frandom(1, 10), 0, 6, frandom(1, 6), 0, frandom(9, 13), -33, 1+32+128)
    1H57 Z 0 A_SpawnItemEx("GBust_GibBone", frandom(1, 10), 0, 18, frandom(1, 6), 0, frandom(9, 22), random(0, 359), 1+32+128)
    1H57 Z 0 A_SpawnItemEx("GBust_GibBone", frandom(1, 10), 0, 28, frandom(1, 6), 0, frandom(4, 17), random(0, 359), 1+32+128)
    1H57 Z 1 A_SpawnItemEx("GBust_GibsSpawner", 0, 0, 0, 0, 0, 0, 0, 1+32+128)//Oops all blood
    goto MegamanCorpseEnd
  }
}
actor GhostBusterShiny : GhostBuster {
  player.scoreIcon "UMUG_S57"
  Player.Maxhealth 3000
  health 3000
  player.forwardmove 0.9, 0.9
  player.sidemove 1.13, 1.13
  player.jumpz 11
  player.morphweapon "GhostBuster_W"
  //player.morphweapon "S_GhostBuster_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}


actor GhostBuster_DeathThruster_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ThrustThingZ(0, 15, 0, 0)
    stop
  }
}

actor GhostBusterSkeletonCorpse {
  Translation "192:192=4:4", "198:198=0:0"
  -NOGRAVITY
  -SOLID
  +DONTSPLASH
  +NOBLOCKMONST
  +SLIDESONWALLS
  +CORPSE
  //Friction 2
  Reactiontime 20
  Radius 15
  Height 22
  scale 2.5
  States {
   Spawn:
    1H57 S 0
    1H57 S 35 A_CountDown
    wait
   Crash:
    1H57 T 35 //A_stop
    1H57 T 35
    1H57 TTTTTTTT 35
    1H57 TTTTTTTTTTT 3 A_Fadeout
    stop
  }
}

/*

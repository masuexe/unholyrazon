    goto Spawn+2
   Death:
    TNT1 A 0 A_JumpIfInventory("CorpseFlag", 1, "DeathSplat")
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    _BON A 200
    stop
    _BON B 200
    stop
    _BON C 200
    stop
    _BON D 200
    stop
  }
}


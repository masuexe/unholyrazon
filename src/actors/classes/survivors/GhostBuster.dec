actor GBust_GibBone {
  Translation "192:192=4:4", "198:198=0:0"
  +CLIENTSIDEONLY
  +MISSILE
  -SOLID
  +THRUACTORS
  +NOPAIN
  +NOTELEPORT
  +DONTBLAST
  +DONTSPLASH
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +BOUNCEAUTOOFFFLOORONLY
  BounceCount 5
  BounceFactor 0.4
  WallBounceFactor 0.45
  radius 4
  height 4
  scale 2.5
  states {
   Spawn:
    _BON A 0
    _BON A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    _BON ABCD 2
    goto Spawn+2
    _BON ADCB 2
    goto Spawn+6
   Death:
    "####" "#" 150
    stop
  }
}
actor GBust_GibSkull : GBust_GibBone {
  states {
   Spawn:
    1H57 U 1
    wait
   Death:
    1H57 U 150
    stop
  }
}


actor GBust_GibBlood {
  +NOBLOCKMAP
  +NOTELEPORT
  +ALLOWPARTICLES
  +NOBLOCKMONST
  Mass 5
  Radius 6
  Height 6
  Scale 1.25
  States {
   Spawn:
    BLUD C 0
    BLUD C 0 A_SpawnItemEx("GBust_GibBlood2", random(1, 4), 0, random(4, 28), random(0, 5), random(0, 5), frandom(6, 14), random(0, 359), 1+32+128)
    BLUD CBA random(4, 8)
    stop
  }
}

actor GBust_GibBlood2 : GBust_GibBlood {
  +CORPSE
  Health 1
  Mass 1
  Reactiontime 20
  Radius 5
  Height 4
  Scale 1.0//0.75
  states {
   Spawn:
    _GIB V 0 A_CheckSight("Cheap")
    _GIB VWXY 2 A_SpawnItemEx("GBust_GibBloodFX", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), 0, 0, 1+32+128)
    loop
   Cheap:
    _GIB V 0 A_SpawnItemEx("GBust_GibBloodFX", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), 0, 0, 1+32+128)
    _GIB VWXY 2
    loop
   Crash:
    TNT1 A 1 A_SpawnItemEx("GBust_GibBloodLanded", 0, 0, 0, 0, 0, 0, 0, 1+32+128)
    stop
  }
}

actor GBust_GibBloodLanded {
  +CLIENTSIDEONLY
  -SOLID
  +THRUACTORS
  +NOTELEPORT
  +DONTSPLASH
  mass 1
  radius 4
  height 2
  scale 1.0
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 //A_PlaySound("",1,0.25)//Blood_Splat
    TNT1 A 0 A_Jump(64, 4)
    TNT1 A 0 A_Jump(128, 4)
    TNT1 A 0 A_Jump(192, 4)
    TNT1 A 0 A_Jump(255, 4)
    _GIB R 125
    stop
    _GIB S 125
    stop
    _GIB T 125
    stop
    _GIB U 125
    stop
  }
}

actor GBust_GibBloodFX : GBust_GibBloodLanded {
  +LOWGRAVITY
  +NOBLOCKMAP
  radius 2
  scale 0.70
  states {
   Spawn:
    _GIB Z 0
    _GIB "[\]" 4
    stop
  }
}

actor GBust_GibsSpawner// : BasicWatcher
{
  Translation "192:192=171:171", "198:198=41:41"
  -SOLID
  +NOCLIP
  RenderStyle None
  ReactionTime 9
  radius 16
  height 56
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 //A_PlaySound("",1)//XGib
   S_L:
    TNT1 A 0 A_SpawnItemEx("GBust_GibBone1", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 128)
    TNT1 A 0 A_SpawnItemEx("GBust_GibBone2", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 128)
    TNT1 A 0 A_SpawnItemEx("GBust_GibBit1", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 32)
    TNT1 A 0 A_SpawnItemEx("GBust_GibBit2", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 16)
    TNT1 A 0 A_SpawnItemEx("GBust_GibBit3", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 16)
    TNT1 A 0 A_SpawnItemEx("GBust_GibBit4", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 16)
    TNT1 A 1 A_SpawnItemEx("GBust_GibBit5", random(1, 4), 0, random(8, 32), random(0, 5), random(0, 5), random(8, 18), random(0, 359), 32+128, 16)
    TNT1 A 0 A_CountDown
    loop
  }
}

actor GIB_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 //A_SetScale(ScaleX+frandom(0,0.5f))
    TNT1 A 0 A_Jump(64, "PickupAlt")
    TNT1 A 0 ThrustThingZ(0, random(2, 45), 0, 1)
    stop
   PickupAlt:
    TNT1 A 0 A_ChangeFlag("BOUNCEONFLOORS", 0)
    TNT1 A 0 A_GiveInventory("CorpseFlag")
    stop
  }
}

actor GBust_GibBone1 {
  Translation "192:192=4:4", "198:198=0:0"
  +MISSILE
  -SOLID
  +NOBLOCKMAP
  //+DROPOFF
  +NOTELEPORT//-NOTELEPORT
  //+BLOODSPLATTER
  +DONTBLAST
  //+DOOMBOUNCE
  +DONTSPLASH
  +BOUNCEONCEILINGS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +ALLOWBOUNCEONACTORS
  +BOUNCEAUTOOFF

  bouncefactor 0.4
  renderstyle translucent
  Radius 2
  Height 4
  Damage 0
  Speed 15//5
  Scale 1.25
  States {
   Spawn:
    _BON E 0
    _BON E 0 A_GiveInventory("GIB_P")
    _BON E 0 A_SpawnItemEx("GBust_GibBlood", 0, 0, 2, 0, 0, 0, 0, 1+32+128)
    _BON EFEF 5
    goto Spawn+2
   Death:
    TNT1 A 0 A_JumpIfInventory("CorpseFlag", 1, "DeathSplat")
    TNT1 A 0 A_Jump(256, 1, 2)
    _BON E 200
    stop
    _BON F 200
    stop
   DeathSplat:
    _BON AAA 0 A_SpawnItemEx("GBust_GibBlood", 0, 0, 0, 0, 0, 0, 0, 1+32+128)
    _BON RSTU 4
    stop
  }
}

actor GBust_GibBone2 : GBust_GibBone1 {
  States {
   Spawn:
    _BON A 0
    _BON A 0 A_GiveInventory("GIB_P")
    _BON A 0 A_SpawnItemEx("GBust_GibBlood", 0, 0, 2, 0, 0, 0, 0, 1+32+128)

actor ClaireS_W_ScriptBar : ScriptBar {}  //NormalBar {args 108, 130}

actor ClaireS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Claire_W"
Weapon.AmmoUse 1
Inventory.Pickupmessage "$PU_54"
Obituary "$OB_54W"
weapon.ammotype "ClaireEnergyAmmo"
weapon.ammotype2 "ClaireZestAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H54 [ 6
loop

Deselect:
7H54 A 0
goto DeselectSwap
Select:
7H54 A 0
goto SelectSwap

Ready:
7H54 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", CLAIRE_SDYE)
7H54 A 0 A_GunFlash("Flash",1)
7H54 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready1:
7H54 AAAAA 2 A_GiveInventory("Claire_Ready_P2")
Ready2:
7H54 A 2 A_GiveInventory("Claire_Ready_P")
loop

Fire:
//7H54 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H54 B 2 Offset(-2, 34) A_GiveInventory("S_Claire_Fire_P")
7H54 A 2 Offset(-1, 33)
7H54 A 2 A_WeaponReady(14)
Goto Ready1

Flash:
TNT1 A 3
TNT1 A 1 A_JumpIfInventory("ClaireZestAmmo",28,1)
wait
TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK,1)
wait
6H54 E 0 A_GunFlash(1)
6H54 K 0 A_GiveInventory("S_Claire_AltDash_P")
6H54 Q 0 A_RailWait
6H54 E 0 A_Jump(256,1,4,7,10,13,16,19,22,25,28,31,34,37,40,43)
6H54 EKQ 3
loop
6H54 FLR 3
loop
6H54 GMS 3
loop
6H54 HNT 3
loop
6H54 IOU 3
loop
6H54 JPV 3
loop
6H54 ELS 3//19
loop
6H54 FMT 3
loop
6H54 GNU 3
loop
6H54 HOV 3
loop
6H54 IPQ 3
loop
6H54 JKR 3//34
loop
6H54 JKT 3
loop
6H54 ENQ 3
loop
6H54 HKQ 3
loop

BotReady:
7H54 A 0 A_WeaponReady(12)
7H54 A 2 A_Refire("BotFire")
7H54 A 0 A_GiveInventory("ClaireEnergyAmmo",1)
7H54 A 0 A_GiveInventory("ClaireZestAmmo",1)
loop

Bot_Fire:
7H54 B 2 Offset(-2, 34) A_GiveInventory("S_Claire_Fire_P")
7H54 A 2 Offset(-1, 33)
7H54 A 2 A_WeaponReady(14)
Goto BotReady

BotAlt:
7H54 A 0 A_Jump(96,"BotAlt2")
goto BotFire+1
BotFire:
7H54 A 0 A_JumpIfInventory("ClaireZestAmmo",0,"BotAlt")
7H54 A 0 A_Jump(32,"BotFire0")
7H54 A 0 A_Jump(14,"BotFire1")
7H54 A 0 A_JumpIfNoAmmo(1)
goto Bot_Fire
7H54 A 0 A_Jump(24,1)
goto Bot_Fire
7H54 A 10 A_GiveInventory("ClaireZestAmmo",5)
BotReload:
7H54 A 0 A_JumpIfInventory("ClaireEnergyAmmo",0,"BotReady")
7H54 A 0 A_GiveInventory("ClaireEnergyAmmo",random(1,2))
7H54 A 2 A_GiveInventory("ClaireZestAmmo",1)
loop

BotFire0:
7H54 A 0 A_JumpIf(momz==0,2)
7H54 A 0 A_Jump(32,1)
goto BotFire+2
7H54 A 0 ThrustThingZ(0,28,0,1)
7H54 A 0 ThrustThing(random(0,255),35,1,0)
7H54 A 0 A_GiveInventory("S_Claire_AltDashFX_P")
goto BotFire+2
BotFire1:
7H54 A 0 A_GiveInventory("ClaireEnergyAmmo",random(14,28))
7H54 A 0 A_GiveInventory("ClaireZestAmmo",random(42,84))
7H54 A 0 A_PlaySoundEx("taunt/D_54","Voice")
7H54 A 0 A_FaceTarget
goto Bot_Fire

BotAlt2:
7H54 B 0 A_GiveInventory("S_Claire_AltOld_P")
7H54 B 2 Offset(-2, 34)
7H54 A 2 A_WeaponReady(14)
7H54 B 2 Offset(-2, 34)
7H54 A 6 A_WeaponReady(14)
Goto BotReady
}
}

actor S_Claire_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",21,"Fire_Zen")//25
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",11,"Fire_CalmDown")
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",1,"Fire_SettleDown")
goto Fire_CANYOUSTOP

Fire_Zen:
TNT1 A 0 A_PlaySound("wep/ClaireFire3",1)
TNT1 A 0 A_FireCustomMissile("S_ClaireShot1",0,1,-8,0)
Goto FireEnd
Fire_CalmDown:
TNT1 A 0 A_PlaySound("wep/ClaireFire2",1)

TNT1 A 0 A_FireCustomMissile("S_ClaireShot2",random(-1,1),1,-8,0,1,random(-1,1))
Goto FireEnd
Fire_SettleDown:
TNT1 A 0 A_PlaySound("wep/ClaireFire2",1)
TNT1 A 0 A_FireCustomMissile("S_ClaireShot3",random(-2,2),1,-8,0,1,random(-2,2))
Goto FireEnd
Fire_CANYOUSTOP:
TNT1 A 0 A_PlaySound("wep/ClaireFire1",1)//random(-4,4)
TNT1 A 0 A_FireCustomMissile("S_ClaireShot4",(random(0,1)*2-1)*random(2,6),1,-8,0,1,(random(0,1)*2-1)*random(2,6))
Goto FireEnd

FireEnd:
TNT1 A 0 A_GiveInventory("ClaireZestAmmo",1)
TNT1 A 0 A_TakeInventory("ClaireEnergyAmmo",1,1)
stop
}
}

actor S_Claire_AltOld_P : Claire_AltOld_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_ClaireShotOld",0,0,-8,0)
goto Super::Pickup+1
}
}

actor S_Claire_AltDash_P : Claire_AltDash_P
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("S_Claire_AltDashFX_P")
goto Super::Pickup+1
}
}
actor S_Claire_AltDashFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep/ClaireDash",4,1.0)
TNT1 A 0 A_SpawnItemEx("S_Claire_DashFX",0,22.5,0,0,0,frandom(1,2),0,32)
TNT1 A 0 A_SpawnItemEx("S_Claire_DashFX",0,0,0,0,0,frandom(1,2),0,32)
TNT1 A 0 A_SpawnItemEx("S_Claire_DashFX",0,-22.5,0,0,0,frandom(1,2),0,32)
stop
}
}

actor S_Claire_DashFX : Claire_DashFX
{
Translation "192:192=102:102","198:198=116:116"
}

actor S_ClaireShot1 : ClaireShot1
{
Translation "192:192=108:108","198:198=130:130"
damage (random(293,308)-Args[0]*12)//200 8
//radius 14
//height 14
//speed 150
//Scale 4.0
Args -2,10,0
}

actor S_ClaireShot2 : S_ClaireShot1
{
Args 2,10,16
}
actor S_ClaireShot3 : S_ClaireShot1
{
Args 6,10,32
}
actor S_ClaireShot4 : S_ClaireShot1
{
Args 10,10,64
States
{
Spawn:
6P54 C 2
6P54 C 0 A_Jump(256,1,2,3,4,5,6)
SpawnL:
6P54 CCCDDD 1 A_GiveInventory("ClaireShotStuff_P")
loop
}
}

actor S_ClaireShotOld : ClaireShotOld
{
Translation "192:192=108:108","198:198=130:130"
Damage (150+(Args[3]*0.75))//100 0.5
Args 225,160,16,20//150,160,16,20
}

actor TrapistShiny_W_ScriptBar : ScriptBar {}

actor TrapistShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Trapist_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_30"
Obituary "$OB_30W"
weapon.ammotype "ClashEnergyAmmo"
weapon.ammotype2 "TrapistEnergyAmmo"
States
{
Spawn:
7H30 [ 6
loop

Deselect:
7H30 A 0
goto DeselectSwap
Select:
7H30 A 0
goto SelectSwap

Ready:
7H30 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TRAPIST_SDYE)
Goto Ready2
Ready2:
7H30 A 2 A_GiveInventory("Trapist_Ready_P")
7H30 A 0 A_GiveInventory("ClashEnergyAmmo",2)
7H30 A 0 A_GiveInventory("TrapistEnergyAmmo",1)
loop

Fire:
7H30 A 0 A_JumpIfInventory("IsBot",1,"BotCheck")
7H30 A 0 A_GiveInventory("S_Trapist_Fire_P")
7H30 HGFFFEDCB 2
Goto Ready2

AltFire:
7H30 A 0 A_JumpIfInventory("TrapistPrimedFlag",1,"AltDet")
7H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo",100,"AltTrapH0")
AltToss:
7H30 A 0 A_GiveInventory("S_Trapist_Alt_P")
7H30 HGFEDCB 1
Goto Ready2
AltDet:
7H30 I 0 A_GiveInventory("Trapist_AltDetonate_P")
7H30 IJKJIA 2
goto Ready2

AltTossed:
7H30 H 0 A_GunFlash("NoFlash",1)
7H30 H 0 A_TakeInventory("TrapistChargeFlag")
goto AltToss

AltTrapH0:
7H30 B 0 A_GunFlash("Flash.AltAmmo",1)
AltTrapH1:
7H30 B 0 A_JumpIfInventory("TrapistChargeFlag",12,"AltTrapH2")
7H30 B 1 A_GiveInventory("TrapistChargeFlag",1+CallACS("uh_checkrune", RUNE_RAGE))
7H30 B 0 A_Refire("AltTrapH1")
goto AltTossed
AltTrapH2:
7H30 C 0 A_JumpIfInventory("TrapistChargeFlag",24,"AltTrapH3")
7H30 C 1 A_GiveInventory("TrapistChargeFlag",1+CallACS("uh_checkrune", RUNE_RAGE))
7H30 C 0 A_Refire("AltTrapH2")
goto AltTossed
AltTrapH3:
7H30 D 0 A_JumpIfInventory("TrapistChargeFlag",36,"AltTrapH4")
7H30 D 1 A_GiveInventory("TrapistChargeFlag",1+CallACS("uh_checkrune", RUNE_RAGE))
7H30 D 0 A_Refire("AltTrapH3")
goto AltTossed
AltTrapH4:
7H30 L 1 A_RailWait
7H30 L 0 A_Refire(1)
goto AltTrap
7H30 E 1 A_RailWait
7H30 E 0 A_Refire("AltTrapH4")
goto AltTrap
AltTrap:
7H30 G 0 A_GunFlash("NoFlash",1)
7H30 G 0 A_GiveInventory("S_Trapist_Alt_P3")
7H30 GFFEDCB 2
goto Ready2

Flash.AltAmmo:
TNT1 AA 2
TNT1 A 5 A_GiveInventory("ClashEnergyAmmo",1)
wait

BotCheck:
7H30 A 0 A_Jump(16,"BotCheckX")
7H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo",50,"BotAlt")
7H30 A 0 A_Jump(32,"BotAlt")
7H30 A 0 A_Jump(48,2)
7H30 A 0 A_GiveInventory("ClashEnergyAmmo",random(1,7)*4)
goto Fire+1
7H30 A 0 A_GiveInventory("TrapistEnergyAmmo",random(8,14)*4)
7H30 A 0 A_GiveInventory("ClashEnergyAmmo",random(8,14)*2)
7H30 A 0 ThrustThingZ(0,40*CallACS("core_CheckFooting"),0,1)
goto Fire+1
BotCheckX:
7H30 A 0 A_GiveInventory("ClashEnergyAmmo",100)
7H30 A 0 A_GiveInventory("TrapistEnergyAmmo",100)
7H30 A 0 A_PlaySoundEx("classes/taunt/trapist","Voice")
7H30 A 0 A_Jump(256,"BotFire1","BotFire2","BotFire3")
BotFire1:
7H30 AA 0 A_FireCustomMissile("S_TrapistFragShot",7.5,0,0,0,1,random(-7,7))
7H30 AA 0 A_FireCustomMissile("S_TrapistFragShot",-7.5,0,0,0,1,random(-7,7))
goto Fire+1
BotFire2:
7H30 A 1 ThrustThingZ(0,20*CallACS("core_CheckFooting"),0,1)
7H30 A 0 A_GiveInventory("TrapistTrigger_F")
7H30 A 0 A_PlaySound("Trapist/Toss",1)
7H30 A 0 A_FireCustomMissile("S_TrapistMineStart",180+random(-3,3)*5,0,0,-24)
goto AltToss+1
BotFire3:
7H30 A 0 A_PlaySoundEx("misc/itemthrow",1)
7H30 A 0 A_FireCustomMissile("S_TrapistTrap",0,0)
7H30 A 0 A_FireCustomMissile("S_TrapistTrap",22.5,0)
7H30 A 0 A_FireCustomMissile("S_TrapistTrap",-22.5,0)
goto AltTrap+2
BotAlt:
7H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo",0,4)
7H30 A 0 A_Jump(48,"AltTrap")
7H30 A 0 A_JumpIfInventory("TrapistPrimedFlag",1,"AltDet")
7H30 A 0 A_Jump(128,"AltToss")
goto BotCheck+3
7H30 A 0 A_Jump(96,"AltTrap")
goto BotAlt+1

}
}

actor S_Trapist_Fire_P : Trapist_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TrapistFragShot",0,0)
goto End
}
}
actor S_Trapist_Alt_P : Trapist_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TrapistMineStart",0,0)
goto End
}
}
actor S_Trapist_Alt_P3 : Trapist_Alt_P3
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TrapistTrap",0,0)
goto End
}
}

actor S_TrapistFragShot : TrapistFragShot
{
Translation "192:192=40:40","198:198=77:77"
damage (300)//200
States
{
Death:
TNT1 A 1 A_SpawnItemEx("S_TrapistLobbedBlast",0,0,7.5f,0,0,0,0,1)
stop
}
}

actor S_TrapistFragShot2 : TrapistFragShot2
{
Translation "192:192=40:40","198:198=77:77","202:202=4:4","199:199=103:103"
damage (300)//200
States
{
Death:
TNT1 A 1 A_SpawnItemEx("S_TrapistLobbedBlast",0,0,7.5f,0,0,0,0,1)
stop
}
}

actor S_TrapistLobbedBlast : TrapistLobbedBlast
{
Args 225,128,20//150
}


actor S_TrapistMineStart : TrapistMineStart
{
Translation "192:192=103:103","198:198=206:206"
States
{
Command:
6Q30 N 0 A_SpawnItemEX("TrapistMineSnd_H")
6Q30 N 0 A_SpawnItemEx("S_TrapistMineBlast",0,0,Height/2)
stop
Death:
6Q30 N 0 A_SetGravity(0.0)
6Q30 N 0 A_CheckFloor("DeathF")
6Q30 N 0 A_CheckCeiling("DeathC")
6Q30 N 0
6Q30 N 1 A_SpawnItemEX("S_TrapistMineY_HelpStart",0,0,0,0,0,0,0,1)
stop
DeathF:
6Q30 N 0 A_SpawnItemEx("S_TrapistMineX",0,0,0,0,0,0,0,1)
stop
DeathC:
6Q30 N 0 A_SpawnItemEx("S_TrapistMineZ",0,0,0,0,0,0,0,1)
stop
}
}

actor S_TrapistMineX : TrapistMineX
{
States
{
Death:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineBlastX",0,0,Height/2)
stop
}
}


actor S_TrapistMineY_HelpStart : TrapistMineY_HelpStart
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY_HelpF",0,0,0,0,0,0,0,1)
stop
ForceSpawn:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY",0,0,0,0,0,0,180,1+32)
stop
Death:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY_HelpB",0,0,0,0,0,0,0,1)
stop
}
}
actor S_TrapistMineY_HelpF : S_TrapistMineY_HelpStart
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetPitch(pitch+1)
TNT1 A 0 A_JumpIf(pitch>=20,"FailSpawn")
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY_HelpF",2,0,0,0,0,0,0,1+32+512)
stop
FailSpawn:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY",40,0,0,0,0,0,180,1+32)
stop
Death:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY",2,0,0,0,0,0,180,1+32)
stop
}
}
actor S_TrapistMineY_HelpB : S_TrapistMineY_HelpStart
{
States
{
Spawn:
TNT1 A 0
goto ForceSpawn
Death:
TNT1 A 0 A_JumpIf(pitch>=10,"ForceSpawn")
TNT1 A 0 A_SpawnItemEx("S_TrapistMineY_HelpB",-2,0,0,0,0,0,0,1+32+512)
stop
}
}

actor S_TrapistMineY : TrapistMineY
{
States
{
Death:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineBlastY",0,0,Height/2)
stop
}
}

actor S_TrapistMineZ : TrapistMineZ
{
States
{
Death:
TNT1 A 0 A_SpawnItemEx("S_TrapistMineBlastZ")
stop
}
}

actor S_TrapistMineBlast : TrapistMineBlast
{
Translation "192:192=103:103","198:198=206:206","89:89=103:103","95:95=206:206"
Args 300,180,100//200
}
actor S_TrapistMineBlastX : S_TrapistMineBlast{Obituary "$OB_30A3" Accuracy 14}
actor S_TrapistMineBlastY : S_TrapistMineBlast{Obituary "$OB_30A4" Accuracy 0}
actor S_TrapistMineBlastZ : S_TrapistMineBlast{Obituary "$OB_30A5" Accuracy -14}


actor S_TrapistTrap : TrapistTrap
{
Translation "250:250=103:103","249:249=206:206","192:192=40:40","198:198=77:77"
States
{
TrapSet:
6Q30 A 0 A_SpawnItemEx("S_TrapistTrapSet",0,0,0,0,0,0,0,1)
stop
}
}

actor S_TrapistTrapSet : TrapistTrapSet
{
Damage (150)//100
Args 30,32,32//20
}

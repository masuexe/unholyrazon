SMK1:TNT1 A 0 A_SpawnItemEx("MirrorShotMediumU",0,0,32,cos(-pitch),0,sin(-pitch),15,1+8192)TNT1 A 0 A_SpawnItemEx("MirrorShotMediumU",0,0,32,cos(-pitch),0,sin(-pitch),-15,1+8192)goto MK1
SMK2:TNT1 A 0 A_SpawnItemEx("ScrewCrusherU",0,8,32,cos(-pitch),0,sin(-pitch),15,1+8192)TNT1 A 0 A_SpawnItemEx("ScrewCrusherU",0,8,32,cos(-pitch),0,sin(-pitch),-15,1+8192)goto MK2

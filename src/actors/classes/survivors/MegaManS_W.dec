actor MegamanS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Megaman_W"
Weapon.AmmoUse 1
Weapon.AmmoGive 3
Weapon.SlotNumber 1
scale 2.0
Obituary "%o was bombed by %k's \cgS\ciH\cfI\cdN\chY \c-BUSTER."
Inventory.Pickupmessage "You got the Shiny Buster!"
weapon.ammotype "S_RockNRollAmmo"
States
{
Spawn:
7H00 [ 6
loop

Deselect:
BUST B 0
goto DeselectX
Select:
BUST B 0
goto SelectX

Ready:
BUST B 1 ACS_ExecuteAlways(998,0,S_MEGAMAN_DYE)
BUST B 0 A_GiveInventory("BlackHoleTrigger",1)
BUST B 0 A_TakeInventory("SakugarneActive")
BUST B 0 A_GunFlash("Flash",1)
Goto Ready2
Ready2:
BUST B 0 A_JumpIfInventory("S_RockNRollAmmo",4,"Ready3")
BUST B 8 A_WeaponReady(8)
BUST B 0 A_GiveInventory("S_RockNRollAmmo",1)
loop
Ready3:
BUST B 8 A_WeaponReady
BUST B 0 A_GiveInventory("S_RockNRollAmmo",1)
loop

Fire:
BUST B 0 A_GiveInventory("S_MegamanMainRNG_P")//S_MegamanTrueRNG_P
BUST CD 3
BUST B 6
BUST B 0 A_ReFire
goto Ready2
Altfire:
BUST B 0 A_GiveInventory("S_MegamanAltRNG_P")//S_MegamanFireShot2_P
BUST CD 3
BUST B 6
//BUST B 2
goto Ready2


Flash:
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE1,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE2,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE3,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE4,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE5,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE6,1)
TNT1 A 7 ACS_ExecuteWithResult(998,S_MEGAMAN_DYE7,1)
loop


//Flash2:
//TNT1 A 7 ACS_ExecuteAlways(991,0,5001)//>>5012
//loop
}
}

actor S_RockNRollAmmo : Ammo
{
Inventory.Amount 1
Inventory.maxamount 28
+INVENTORY.IGNORESKILL
}


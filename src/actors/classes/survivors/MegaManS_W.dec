MK1:TNT1 A 0 A_SpawnItemEx("MirrorShotMediumU",0,0,32,cos(-pitch),0,sin(-pitch),0,1+8192)TNT1 A 0 A_PlaySound("weapon/mirrordeflect",1)goto EndQ

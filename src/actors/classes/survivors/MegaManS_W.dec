actor YamatoSpearU_H : BasicHelper
{
Mass 0
ReactionTime 3
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("YamatoSpearU",0,0,0,sqrt(momx*momx+momy*momy)*36,0,momz*36,0+Mass,1)
TNT1 A 0 A_SpawnItemEx("YamatoSpearU",0,0,0,sqrt(momx*momx+momy*momy)*36,0,momz*36,(random(0,1)*2-1)*random(1,2)+Mass,1)
TNT1 A 0 A_CountDown
TNT1 A 1 A_JumpIfInTargetInventory("PowerRage_ST",1,1)
TNT1 A 1

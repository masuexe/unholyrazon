SMV6:TNT1 A 0 A_SpawnItemEx("DeepDiggerU",0,8,32,cos(-pitch),0,sin(-pitch),15,1+8192)TNT1 A 0 A_SpawnItemEx("DeepDiggerU",0,8,32,cos(-pitch),0,sin(-pitch),-15,1+8192)goto MV6
SMV7:TNT1 A 0 A_SpawnItemEx("S_BreakDashCheckU",0,8,32,cos(-pitch),0,sin(-pitch),15,1+8192)TNT1 A 0 A_SpawnItemEx("S_BreakDashCheckU",0,8,32,cos(-pitch),0,sin(-pitch),-15,1+8192)goto MV7

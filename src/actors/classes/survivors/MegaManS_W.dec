SMK4:TNT1 A 0 A_SpawnItemEx("S_SakugarnePogoU",0,0,32,cos(-pitch),0,sin(-pitch),15,1)TNT1 A 0 A_SpawnItemEx("S_SakugarnePogoU",0,0,32,cos(-pitch),0,sin(-pitch),-15,1)goto MK4

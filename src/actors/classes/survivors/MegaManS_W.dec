SMV3:TNT1 A 0 A_SpawnItemEx("PhotonMissileLauncherU",0,8,32,cos(-pitch),0,sin(-pitch),15,1+512+8192)TNT1 A 0 A_SpawnItemEx("PhotonMissileLauncherU",0,8,32,cos(-pitch),0,sin(-pitch),-15,1+512+8192)goto MV3
SMV4:TNT1 A 0 A_SpawnItemEx("S_ElectricShockDamagerU",0,0,32,cos(-pitch),0,sin(-pitch),15,1+8192)TNT1 A 0 A_SpawnItemEx("S_ElectricShockDamagerU",0,0,32,cos(-pitch),0,sin(-pitch),-15,1+8192)

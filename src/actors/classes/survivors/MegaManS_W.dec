actor S_OilShotU : OilShotU
{
States
{
Death:
X_1H B 0
X_1H B 0 A_JumpIf(z-floorz<=0,"DeathF")
X_1H B 0 A_SpawnItemEx("S_OilShotDropU",0,0,0,0,0,momz,0,1)
stop
DeathF:
X_1H B 0 A_SpawnItemEx("S_OilBlobU",0,0,0,0,0,0,0,1)
stop
}
}
actor S_OilShotDropU : S_OilShotU
{
States
{
Spawn:
X_1H B 0
X_1H B 0 ThrustThingZ(0,1,0,1)
X_1H B 5
wait
Death:
X_1H B 0 A_JumpIf(z-floorz<=0,"DeathF")
goto XDeath
}
}

TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P3")
TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P4")
TNT1 A 1 A_GiveToTarget("FireFlameSword2U_P5")
stop
}
}

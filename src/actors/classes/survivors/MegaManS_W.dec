Actor S_OilBlobU : OilBlobU
{
states
{
Spawn:
X_1H D 0
X_1H D 1
X_1H D 0 A_ChangeFlag("SHOOTABLE",1)
X_1H D 1 A_ChangeVelocity(0,0,momz,2)
X_1H D 0 A_Jump(32,"pain.Ignition")
Goto SlideWait
Slide:
X_1H C 0 A_Jump(8,"pain.Ignition")
X_1H C 0 A_SpawnItemEx("S_OilShot2U",0,0,0,frandom(6,8),frandom(-2,2),frandom(4,6),0,1)
X_1H C 0 A_SpawnItemEx("S_OilShot2U",0,0,0,frandom(6,8),frandom(-2,2),frandom(4,6),90,1)
X_1H C 0 A_SpawnItemEx("S_OilShot2U",0,0,0,frandom(6,8),frandom(-2,2),frandom(4,6),180,1)
X_1H C 0 A_SpawnItemEx("S_OilShot2U",0,0,0,frandom(6,8),frandom(-2,2),frandom(4,6),270,1)
X_1H C 0 A_SpawnItemEx("S_OilShotDrop2U",0,0,0,0,0,0,0,1)
stop
NewShot:
X_1H C 0 A_SpawnItemEx("S_OilShotU",0,0,0,momx,momy,momz,0,9)
Goto Death
}
}
Actor S_OilBlob2U : S_OilBlobU
{
states
{
Spawn:
X_1H D 0
X_1H D 1
X_1H D 0 A_ChangeFlag("SHOOTABLE",1)
X_1H D 1 A_ChangeVelocity(0,0,momz,2)
X_1H D 0 A_Jump(32,"pain.Ignition")
Goto SlideWait2
SlideWait2:
X_1H C 1 A_GiveInventory("CutterFlag",1)
X_1H C 0 A_CheckFlag("BLASTED","NewShot")
X_1H C 0 A_JumpIfInventory("CutterFlag",350,"Death")
loop
NewShot:
X_1H C 0 A_SpawnItemEx("S_OilShot2U",0,0,0,momx,momy,momz,0,9)
Goto Death
}
}


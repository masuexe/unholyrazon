stop
}
}

actor S_SakugarnePogoU
{
PROJECTILE
damagetype "Sakugarne"
Obituary "$OB_SAKUGARNE"
-NOGRAVITY
+THRUACTORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+BOUNCEONFLOORS
+USEBOUNCESTATE
ReactionTime 35
Damage (100)
Height 56
Radius 20
Speed 20
Scale 2.5
States
{
Spawn:
TNT1 A 0
SpawnAir:
X_KD B 10 A_CountDown
wait
Bounce.Floor:
X_KD A 0 A_SpawnItemEx("SakugarneDrillerU",0,0,0,0,0,0,0,1)
X_KD A 0 A_PlaySound("weapon/sakugarne",1)
X_KD A 0 A_ChangeFlag("NOGRAVITY",1)
X_KD A 6 A_ChangeVelocity(0,0,0,2)
X_KD A 0 A_ChangeFlag("NOGRAVITY",0)
X_KD A 0 A_ChangeVelocity(10,0,10,3)
goto SpawnAir
Death:
TNT1 A 0 A_SpawnItemEx("S_SakugarnePogoFXU",0,0,0,0,0,0,0,1)
stop
}
}

actor S_SakugarnePogoFXU : BasicClientSide
{
States
{

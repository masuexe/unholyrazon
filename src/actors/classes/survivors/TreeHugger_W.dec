TNT1 A 0 A_JumpIf(CheckClass("TreeHugger",0,1),1)
stop
TNT1 A 0 A_GiveInventory("PowerTreeHuggerFlag",1)
//TNT1 A 0 A_Log("Wait is that an actual tree, wearing high heels, in the corner, of the house.")
stop
}
}

actor TreeHugger_HippyHeal_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("PowerTreeHuggerHeal",1,2)
TNT1 A 0 A_JumpIf(!CallACS("uh_Health", UHEALTH_IS_FULL), "HealMe")
TNT1 A 0
stop
HealMe:
TNT1 A 0 A_GiveInventory("PowerTreeHuggerHeal",1)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 20)
stop
}
}
actor S_TreeHugger_HippyHeal_P : TreeHugger_HippyHeal_P
{
States
{
HealMe:
TNT1 A 0 A_GiveInventory("PowerTreeHuggerHeal",1)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 30)//20
stop
}
}

actor TreeHugger_NewTree_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_RadiusGive("TreeHugger_HippyPower_P",Args[1],RGF_PLAYERS|RGF_NOSIGHT,1)
TNT1 A 0 A_CheckFlag("NOFEAR","S_Pickup")
TNT1 A 0 A_RadiusGive("TreeHugger_HippyHeal_P",Args[0],RGF_PLAYERS|RGF_NOSIGHT)//|RGF_CUBE)
TNT1 A 0 A_CountDown
stop
S_Pickup:
TNT1 A 0 A_RadiusGive("S_TreeHugger_HippyHeal_P",Args[0],RGF_PLAYERS|RGF_NOSIGHT)
TNT1 A 0 A_CountDown
stop
}
}

actor TreeHugger_NewTree : ProjSpawnFuncActor
{
//PROJECTILE
//+THRUACTORS
//+DONTBLAST
//+DONTREFLECT
-SOLID
+CANPASS
+DONTGIB
+DONTSPLASH
+FORCEYBILLBOARD
+MOVEWITHSECTOR
+NOBLOCKMAP
+NOBLOCKMONST
+NOTELEPORT
+SLIDESONWALLS
+WINDTHRUST
//+MTHRUSPECIES
//+THRUSPECIES//Nah, its funny
//Species "Unholy"
Gravity 5.0
ReactionTime 80
Radius 16
Height 56
scale 2.5
Args 80,263
States
{
Spawn:
TNT1 A 0
TNT1 A 10 A_SpawnItemEx("TreeHugger_NewTreeFX",0,0,0,0,0,0,0,1)
TNT1 A 10 A_SetScale(ScaleX*(random(0,1)*2-1),ScaleY)
TNT1 A 0 A_PlaySound("G_Axe/S_26",1,1,0,0.5)
TNT1 AA 1 A_Jump(256,"Tree")
Tree:
WODM BCDE 2
loop
DeathFade:
"####" "####" 2 A_FadeOut(0.2)
stop
}
}
//Seperate actors to better sync sprites online due to
// {{ 6R26 "#" }} defaulting to sprite 'A'
actor TreeHugger_NewTree1 : TreeHugger_NewTree
{
States
{
Tree:
6R26 EDCBA 2
Trees:
6R26 A 0 A_SpawnItemEx("Basic_HealFX",random(32,Args[0]),0,random(-32,16),0,0,frandom(4,5),random(0,35)*10,1)

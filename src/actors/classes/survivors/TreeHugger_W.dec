actor TreeHugger_W_NormalBar : NormalBar {args 110, 122}

actor TreeHugger_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 100
Inventory.Pickupmessage "$PU_26"
Obituary "$OB_26W"
Tag "$TAG_TreeHugger_W"
weapon.ammotype "TreeEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H26 [ 6
loop

Deselect:
6H26 A 0
goto DeselectSwap
Select:
6H26 A 0
goto SelectSwap

Ready:
6H26 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TREEHUGGER_DYE)
6H26 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready2:
6H26 A 2 A_GiveInventory("TreeHugger_Ready_P")
6H26 A 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,1)
loop
6H26 DEF 2 A_GiveInventory("TreeHugger_Ready_P")
Ready3:
6H26 F 2 A_GiveInventory("TreeHugger_Ready_P")
6H26 F 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,"Ready3")
6H26 ED 2 A_GiveInventory("TreeHugger_Ready_P")
goto Ready2

Fire:
6H26 "#" 0 A_GiveInventory("TreeHugger_Fire_P")
6H26 C 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,"Fire3")
6H26 BCBCBA 2
Goto Ready2
Fire3:
6H26 H 0 A_RailWait
6H26 GHGHGF 2
Goto Ready3

AltFire:
6H26 B 0 A_GiveInventory("TreeHugger_Alt_P")
6H26 C 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,"AltFire3")
6H26 BCBAAA 2
Goto Ready2
AltFire3:
6H26 GHGFFF 2
Goto Ready3


BotReady:
6H26 A 0 A_WeaponReady(12)
6H26 A 2 A_Refire("BotCheck")
6H26 A 0 A_GiveInventory("TreeEnergyAmmo",1)
loop

BotCheck:
6H26 A 0 A_Jump(12,"BotAlt2")
6H26 A 0 A_JumpIfInventory("TreeEnergyAmmo",100-50*CallACS("uh_checkrune", RUNE_ENDLESSAMMO),"BotAlt")
6H26 A 0 A_Jump(16,"BotAlt")
6H26 A 0 A_Jump(32,1)
goto BotFire
6H26 A 0 A_GiveInventory("TreeEnergyAmmo",10)
goto BotFire

BotFire:
6H26 B 0 A_Jump(192,2)
6H26 B 0 A_GiveInventory("PowerTreeHuggerFlag",1)
6H26 B 0 A_GiveInventory("TreeHugger_Fire_P")
6H26 BCBCBA 2
Goto BotReady

BotAlt:
6H26 B 0 A_Jump(12,"BotAlt2")
6H26 B 0 A_GiveInventory("TreeHugger_Alt_P")
6H26 BCBAAA 2
Goto BotReady
BotAlt2:
6H26 B 0 A_PlaySoundEx("taunt/D_26","Voice")
6H26 C 0 A_TakeInventory("TreeEnergyAmmo",50,1)
6H26 B 0 A_TakeInventory("TreeEnergyAmmo",50)
6H26 C 0 A_PlaySound("LuckyLass/Fire3",1)
6H26 B 0 A_FireCustomMissile("TreeHugger_BotShot",0,0)
6H26 BCB 2
6H26 A 10
Goto BotReady
}
}
//actor SeedBomb : RazorLeaf

actor TreeEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 100
+INVENTORY.IGNORESKILL
}

actor PowerTreeHuggerHeal : Powerup
{
Powerup.Duration 28
}
actor PowerTreeHuggerFlag : Powerup
{
Powerup.Duration 10
}

actor RazorLeafFlags : Inventory
{
inventory.amount 1
inventory.maxamount 2
}

actor TreeHugger_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TreeEnergyAmmo",100-50*CallACS("uh_checkrune", RUNE_ENDLESSAMMO),2)
TNT1 A 0 A_WeaponReady(8)
goto Ammo
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("TreeEnergyAmmo",1)
stop
}
}

actor TreeHugger_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("TreeEnergyAmmo",1)
TNT1 A 0 A_PlaySound("TreeHugger/Main",1)//weapon/leafshield
TNT1 A 0 A_JumpIfInventory("RazorLeafFlags",1,4)
TNT1 A 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,2)
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerA",0,0)
goto Give
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerA2",0,0)
goto Give
TNT1 A 0 A_JumpIfInventory("RazorLeafFlags",2,4)
TNT1 A 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,2)
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerB",0,0)
goto Give
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerB2",0,0)
goto Give
TNT1 A 0 A_JumpIfInventory("PowerTreeHuggerFlag",1,2)
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerC",0,0)
goto Take
TNT1 A 0 A_FireCustomMissile("TreeHugger_LeafSpawnerC2",0,0)
goto Take

Take:
TNT1 A 0 A_TakeInventory("RazorLeafFlags")
stop
Give:
TNT1 A 0 A_GiveInventory("RazorLeafFlags",1)
stop
}
}
actor TreeHugger_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("TreeEnergyAmmo",50,1)
TNT1 A 0 A_TakeInventory("TreeEnergyAmmo",50)
TNT1 A 0 A_PlaySound("TreeHugger/Alt",1)//S3_K/BasicPew

//TNT1 A 0 A_FireCustomMissile("TreeHugger_TreeStart",0,0)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),2)
TNT1 A 0 A_SpawnItemEx("TreeHugger_TreeStart",cos(-pitch)*14,0,32+(sin(-pitch)*14),cos(-pitch),0,sin(-pitch),0,32+SXF_MULTIPLYSPEED)//8192
stop
TNT1 A 0 A_SpawnItemEx("TreeHugger_TreeStart_Spread",cos(-pitch)*14,0,32+(sin(-pitch)*14),cos(-pitch),0,sin(-pitch),0,32+8192)
stop
}
}

actor TreeHugger_LeafSpawnerA : BasicHelper
{
Args 1,26,16,40
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch",2,1)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn",0,0,0,cos(-pitch)*13,0,sin(-pitch)*13,0,SXF_TRANSFERPITCH)//512
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn",0,16,0,cos(-pitch)*13,random(Args[0],Args[1]),sin(-pitch)*13+random(16,32),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn",0,-16,0,cos(-pitch)*13,random(-Args[0],-Args[1]),sin(-pitch)*13+random(16,32),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn",0,16,0,cos(-pitch)*13,random(Args[2],Args[3]),sin(-pitch)*13+random(0,16),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn",0,-16,0,cos(-pitch)*13,random(-Args[2],-Args[3]),sin(-pitch)*13+random(0,16),0,512)
stop
}
}
actor TreeHugger_LeafSpawnerB : TreeHugger_LeafSpawnerA{Args 1,32,1,32}
actor TreeHugger_LeafSpawnerC : TreeHugger_LeafSpawnerA{Args 1,40,1,40}

actor TreeHugger_LeafSpawnerA2 : BasicHelper
{
Args 1,26,16,40
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch",2,1)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn2",0,0,0,cos(-pitch)*13,0,sin(-pitch)*13,0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn2",0,16,0,cos(-pitch)*13,random(Args[0],Args[1]),sin(-pitch)*13+random(16,32),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn2",0,-16,0,cos(-pitch)*13,random(-Args[0],-Args[1]),sin(-pitch)*13+random(16,32),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn2",0,16,0,cos(-pitch)*13,random(Args[2],Args[3]),sin(-pitch)*13+random(0,16),0,512)
TNT1 A 0 A_SpawnItemEx("TreeHugger_LeafSpawn2",0,-16,0,cos(-pitch)*13,random(-Args[2],-Args[3]),sin(-pitch)*13+random(0,16),0,512)
stop
}
}
actor TreeHugger_LeafSpawnerB2 : TreeHugger_LeafSpawnerA2{Args 1,32,1,32}
actor TreeHugger_LeafSpawnerC2 : TreeHugger_LeafSpawnerA2{Args 1,40,1,40}

actor TreeHugger_LeafSpawn : BasicProjectile
{
Translation "192:192=110:110","198:198=122:122"
damagetype "LeafSlice"
Obituary "$OB_26M1"
+FORCEXYBILLBOARD
+DONTBLAST
//+RIPPER
+VISIBILITYPULSE
Alpha 0.25
RenderStyle "translucent"
damage (100)
Radius 17
Height 17
speed 40
scale 2.5
States
{
Spawn:
6Q26 A 0
6Q26 ABAB 1// A_FadeIn
6Q26 A 0 A_Stop
6Q26 ABAB 1 //A_FadeIn
6Q26 A 0 A_CustomMissile("TreeHugger_LeafFired",0,0,0,2,-pitch)
stop
}
}
actor TreeHugger_LeafSpawn2 : TreeHugger_LeafSpawn
{
+RIPPER
damage (70)
States
{
Spawn:
6Q26 A 0
6Q26 ABAB 1
6Q26 A 0 A_Stop
6Q26 ABAB 1
6Q26 A 0 A_CustomMissile("TreeHugger_LeafFired2",0,0,0,2,-pitch)
stop
}
}


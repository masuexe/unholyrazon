actor HomingSeeker_W_ScriptBar : ScriptBar {}

actor HomingSeeker_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 100
Inventory.Pickupmessage "$PU_13"
Obituary "$OB_13W"
Tag "$TAG_HomingSeeker_W"
weapon.ammotype "MagnetEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H13 [ 6
loop

Deselect:
6H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,1)
goto DeselectSwap
6I13 A 0
goto DeselectSwap
Select:
6H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,1)
goto SelectSwap
6I13 A 0
goto SelectSwap

Ready:
6H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "ReadyInitS")
ReadyInitN:
6H13 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE)
goto ReadyN
ReadyInitS:
6H13 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE2)
goto ReadyS
ReadyN:
6H13 A 2 A_GiveInventory("HomingSeeker_Ready_P")
loop
ReadyS:
6I13 A 2 A_GiveInventory("HomingSeeker_Ready_P")
loop

Fire:
6H13 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H13 A 0 A_JumpIfInventory("MagnetEnergyAmmo", 56 - 22*CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "FireHoming")
6H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"SnipeShotS")
SnipeShotN:
6H13 B 0 A_GiveInventory("HomingSeeker_Fire_P2")
6H13 N 1 A_GunFlash("Flash_SnipeN", true)
6H13 OOPQB 2
6H13 B 0 A_Refire("SnipeShotN")
Goto ReadyN
SnipeShotS:
6I13 B 0 A_GiveInventory("HomingSeeker_Fire_P2")
6I13 N 1 A_GunFlash("Flash_SnipeS", true)
6I13 OOPQB 2
6I13 B 0 A_Refire("SnipeShotS")
Goto ReadyS

Flash_SnipeN:
6H13 XYZ 2
stop
Flash_SnipeS:
6I13 XYZ 2
stop

FireHoming:
6H13 A 0 A_GiveInventory("HomingSeeker_Fire_P")
6H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"FireHomingS")
FireHomingN:
6H13 D 1
6H13 EEEFGHA 2
6H13 A 0 A_Refire("SnipeShotN")
Goto ReadyN
FireHomingS:
6I13 D 1
6I13 EEEFGHA 2
6I13 A 0 A_Refire("SnipeShotS")
Goto ReadyS

BotFire:
6H13 A 0 A_GiveInventory("MagnetEnergyAmmo",random(2,5))
6H13 A 0 A_Jump(16,"BotFire2")
6H13 A 0 A_JumpIfCloser(256,"AltfireOld")
6H13 A 0 A_JumpIfInventory("MagnetEnergyAmmo",56,"BotFire1")
6H13 A 0 A_GiveInventory("HomingSeeker_Fire_P2")
6H13 OPQB 2
6H13 B 0 A_ReFire("BotFire")
goto ReadyN
BotFire1:
6H13 A 0 A_Jump(8,"BotFire2")
6H13 A 0 A_GiveInventory("HomingSeeker_Fire_P")
6H13 DEFGH 2
6H13 A 0 A_ReFire("BotFire")
goto ReadyN

BotFire2:
6H13 A 0 A_SetArg(0,0)
6H13 A 0 A_PlaySoundEx("taunt/D_13","Voice")
6H13 A 0 A_PlaySound("weapon/magnetmissile",1)
6H13 B 2 A_FireCustomMissile("HomingSeekerShotBot2",0,0,0,0)
6I13 ABABA 2 A_GiveInventory("HomingSeeker_FireBot_P1")
6H13 BABA 2 A_GiveInventory("HomingSeeker_FireBot_P2")
6H13 B 0 A_PlaySound("weapon/magnetmissile",1)
6H13 B 2 A_FireCustomMissile("HomingSeekerShotBot2",0,0,0,0)
6H13 A 20
6H13 A 0 A_ReFire("BotFire")
goto ReadyS

Altfire:
6H13 B 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "AltS")
AltN:
6H13 R 1
6H13 S 2
6H13 T 1 A_GiveInventory("HomingSeeker_Alt_P")
6H13 UTUTUTU 1
6I13 T 2
6I13 V 3
6I13 W 3
Goto ReadyS
AltS:
6I13 R 1
6I13 S 2
6I13 T 1 A_GiveInventory("HomingSeeker_Alt_P")
6I13 UTUTUTU 1
6H13 T 2
6H13 V 3
6H13 W 3
Goto ReadyN

AltfireOld:
6H13 A 0 A_GiveInventory("HomingSeeker_Alt_P")
6H13 A 0 A_PlaySound("weapon/chargekick",4)
6H13 A 0 A_TakeInventory("MagnetEnergyAmmo",28,1)
6H13 A 0 A_TakeInventory("MagnetEnergyAmmo",28)
6H13 A 1 Offset(11,50)
6H13 A 2 Offset(22,68)A_FireCustomMissile("HomingSeekerKick",0,0,0,0)
6H13 A 7 Offset(33,104)
6H13 A 4 Offset(22,68)
6H13 A 4 Offset(11,50)
Goto ReadyN
}
}

actor MagnetEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 56
+INVENTORY.IGNORESKILL
}

actor HSeek_MagneticFlag : Inventory{}

actor HomingSeeker_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady
TNT1 A 0 A_GiveInventory("MagnetEnergyAmmo",2)
stop
}
}

actor HomingSeeker_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("weapon/magnetmissile",1)
TNT1 A 0 A_TakeInventory("MagnetEnergyAmmo",34,1)
TNT1 A 0 A_TakeInventory("MagnetEnergyAmmo",22)
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Pull")
goto Push
Pull:
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileSF",0,1,8,0)
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileS",7.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileS",-7.5,0,8,0)
stop
Push:
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileNF",0,1,8,0)
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileN",7.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("HomingSeekerMissileN",-7.5,0,8,0)
stop
}
}
actor HomingSeeker_Fire_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/HSeekMain2",1,0.85)
TNT1 A 0 A_GiveInventory("MagnetEnergyAmmo",2)
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Pull")
goto Push
Pull:
TNT1 A 0 A_FireCustomMissile("SnipeMissileS",0,0,8,0)
//TNT1 A 0 A_FireCustomMissile("SnipeMissileS",-7.5,0,8)
//TNT1 A 0 A_FireCustomMissile("SnipeMissileS",-7.5,0,8)
stop
Push:
TNT1 A 0 A_FireCustomMissile("SnipeMissileN",0,0,8,0)
stop
}
}

actor HomingSeeker_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Push")
goto Pull
Pull:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE2,1)
TNT1 A 0 A_PlaySound("wep_L/HSeekPullOn",4)
TNT1 A 0 A_GiveInventory("HSeek_MagneticFlag")
stop
Push:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE,1)
TNT1 A 0 A_PlaySound("wep_L/HSeekPushOn",4)
TNT1 A 0 A_TakeInventory("HSeek_MagneticFlag")
stop
}
}

actor HomingSeeker_FireBot_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SetArg(0,Args[0]+5)
Firin:
TNT1 A 0 A_PlaySound("weapon/magnetmissile",1)
TNT1 A 0 A_FireCustomMissile("HomingSeekerShotBot",Args[0],0,0,0)
TNT1 A 0 A_FireCustomMissile("HomingSeekerShotBot",-Args[0],0,0,0)
stop
}
}
actor HomingSeeker_FireBot_P2 : HomingSeeker_FireBot_P1
{
States
{
Pickup:
TNT1 A 0 A_SetArg(0,Args[0]-5)
goto Firin
}
}

actor HomingSeekerMissileN : BasicProjectile
{
Translation "192:192=170:170","198:198=227:227"
damagetype "HomingSeeker"
Obituary "$OB_13M1"
//+DONTSEEKINVISIBLE
+SCREENSEEKER
+SEEKERMISSILE
damage (0)
Radius 10
Height 10
speed 48
scale 2.5
Args 50,75,64,8
States
{
Spawn:
X_3B A 4
SpawnL:
X_3B AAAAAAAA 2 A_SeekerMissile(15,30,3,50,6)
X_3B A 0 A_CountDownArg(3)
loop
DeathX:
XDeath:
TNT1 A 0 A_Explode(Args[0]+Args[1],Args[2],0,0,Args[2])
goto Death+1
Death:
TNT1 A 0 A_Explode(Args[0],Args[2],0,0,Args[2])
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
TNT1 A 0 A_SetScale(2.0)
TNT1 A 4 A_SpawnItemEx("BasicBoom6FX_ColorX_Precise",0,0,0,0,0,0,0,1+16384)
stop
}
}
actor HomingSeekerMissileS : HomingSeekerMissileN
{
Translation "192:192=196:196","198:198=198:198"
}


actor HomingSeekerMissileFX : BasicClientSide
{
States
{
Spawn:
TNT1 A 0
TNT1 A random(1,2)A_SetScale(ScaleX*(random(0,1)*2-1),ScaleY)
TNT1 A 0 A_Jump(256,1,7)
6P13 JKLMNO random(1,2)
stop
6P13 PQRSTU random(1,2)
stop
}
}

actor HomingSeekerMissileNF : HomingSeekerMissileN
{
Obituary "$OB_13M2"
+HITTRACER
Accuracy 1
Args 50,100,64,35
States
{
Spawn:
X_3B A 2
SpawnL:
X_3B A 0 A_SeekerMissile(15,30,3,128,6)
X_3B AA 1 A_SpawnItemEx("HomingSeekerMissileFX",0,0,0,0,0,0,0,1,32)
X_3B A 0 A_SeekerMissile(15,30,3,128,6)
X_3B AA 1 A_SpawnItemEx("HomingSeekerMissileFX",0,0,0,0,0,0,0,1,32)
X_3B A 0 A_CountDownArg(3)
loop

XDeath:
TNT1 A 0 A_JumpIfInventory("PowerProtectSurvivor",1,2,AAPTR_TRACER)
TNT1 A 0 A_JumpIfInventory("MM8BDMPlayer",1,"Fling",AAPTR_TRACER)
TNT1 A 0
goto DeathX
Fling:
TNT1 A 0 A_SetArg(1,CallACS("uh_HomingSeekerPushPull",75,Accuracy)+Args[1])
TNT1 A 0 A_GiveToTarget("HomingSeeker_PushPull_P")
goto DeathX
}
}
actor HomingSeekerMissileSF : HomingSeekerMissileNF
{
Translation "192:192=196:196","198:198=198:198"
Accuracy -1
}
actor HomingSeeker_PushPull_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "Pull")
    goto Push
   Pull:
    TNT1 A 0 A_Recoil(-25)
    stop
   Push:
    TNT1 A 0 A_Recoil(25)
    stop
  }
}


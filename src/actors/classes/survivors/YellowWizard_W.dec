actor YellowWizard_W_NormalBar : NormalBar {args 161, 229}

actor YellowWizard_W : BaseMM8BDMWep_UH {
  // Weapon.UpSound "GNT/PotionCollect"
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_46_A"
  Obituary "$OB_46W1"
  Tag "$TAG_YellowWizard_W"
  Weapon.AmmoType "BluePotionAmmo"
  Inventory.Icon "C_I_46A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H46 [ 6
    loop

   Deselect:
    6H46 C 2
    6H46 C 2 A_GiveInventory("BluePotionAmmo", 1)
    goto DeselectSwap
   Select:
    6H46 C 0
    goto SelectSwap

   Ready:
    6H46 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", YELLOWWIZARD_DYE1, CLRF_GNTPOTION)
    6H46 A 0 A_GunFlash("Flash", 1)
    goto Ready2
   Ready2:
    6H46 G 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    6H46 GHIJKL 3 A_GiveInventory("YellowWizard_WepReady_P")
    goto Ready2+1

   Fire:
    6H46 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    // 6H46 B 0 //A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
    6H46 B 2 Offset(-8, 27)
    6H46 B 2 Offset(-16, 22) A_GiveInventory("YellowWizard_FireStart_P")
    6H46 B 0 A_JumpIfInventory("BluePotionAmmo", 1, "Fire2")
   Fire2:
    6H46 D 2 Offset(-24, 17)
    6H46 D 2 Offset(-32, 12)
    goto Fire_H+1

   Fire_H:
    // "####" "#" 0 A_Jump(256,1,2,3,4,5,6,7,8,9)//Awful desync
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 2, 2)
    "####" "#" 1 Offset(-32, 12) A_GiveInventory("YellowWizard_Fire_P1")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 3, 2)
    "####" "#" 1 Offset(-34, 12) A_GiveInventory("YellowWizard_Fire_P2")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 4, 2)
    "####" "#" 1 Offset(-30, 12) A_GiveInventory("YellowWizard_Fire_P3")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 5, 2)
    "####" "#" 1 Offset(-32, 14) A_GiveInventory("YellowWizard_Fire_P4")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 6, 2)
    "####" "#" 1 Offset(-32, 10) A_GiveInventory("YellowWizard_Fire_P5")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 7, 2)
    "####" "#" 1 Offset(-34, 14) A_GiveInventory("YellowWizard_Fire_P6")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 8, 2)
    "####" "#" 1 Offset(-30, 10) A_GiveInventory("YellowWizard_Fire_P7")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 9, 2)
    "####" "#" 1 Offset(-34, 10) A_GiveInventory("YellowWizard_Fire_P8")
    goto Fire_C
    "####" "#" 0 A_JumpIfInventory("VivifyCycle1", 10, 1)
    "####" "#" 1 Offset(-30, 14) A_GiveInventory("YellowWizard_Fire_P9")
    goto Fire_C
   Fire_C:
    "####" "#" 0 A_JumpIfInventory("VivifyCycle2", 14, 2)
    "####" "#" 0 A_ReFire("Fire_H")
    // "####" "#" 0 A_ClearReFire
    "####" "#" 2 Offset(-24, 17)
    6H46 B 2 Offset(-16, 22) A_GiveInventory("YellowWizard_ResetFire_P")
    6H46 B 2 Offset(-8, 26)
    6H46 A 2 Offset(-4, 28) A_GiveInventory("YellowWizard_ResetFire_P")
    6H46 A 2 Offset(-2, 30)
    6H46 AAA 1 Offset(-1, 30) A_JumpIfInventory("BluePotionAmmo", 1, "FireFix")
    goto Ready2

   FireFix:
    6H46 A 0 A_ReFire
    goto Ready2

   Flash:
    TNT1 A 1 A_GiveInventory("YellowWizard_LowHP_P")
    loop

   AltFire:
    6H46 A 0 A_JumpIfInventory("BluePotionAmmo", 150, "Altfire2")
    goto Ready2
   Altfire2:
    6J46 Z 1 A_PlaySound("GNT/PotionUse", 1)
    6J46 D 2 A_GiveInventory("Y_Wiz_Alt_P1")
    6J46 CBABABCDZ 2
    goto Ready2

   BotFire:
    6H46 A 0 A_Jump(24, "BotSwap")
    6H46 A 0 A_JumpIfInventory("BluePotionAmmo", 300, "BotFire2")
    6H46 A 0 A_Jump(64, "Altfire")
    6H46 A 0 A_Jump(64, 1)
    goto Fire+1
    6H46 A 0 A_PlaySoundEx("classes/taunt/yellowwizard", "Voice")
    6H46 A 0 A_GiveInventory("BluePotionAmmo", random(50, 100))
    goto Fire+1
   BotFire2:
    6H46 A 0 A_Jump(196, "Altfire")
    6H46 A 0 A_Jump(24, "BotSwap")
    goto Fire+1

   BotSwap:
    6H46 A 0 A_PlaySoundEx("classes/taunt/yellowwizard", "Voice")
    6H46 A 0 A_GiveInventory("BluePotionAmmo", random(50, 100))
    6H46 A 0 A_Jump(198, 1, 2, 3, 4, 5, 6)
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W")
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W2")
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W3")
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W4")
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W5")
    goto AltFire
    6H46 A 0 A_SelectWeapon("YellowWizard_W6")
    goto AltFire
  }
}

actor YellowWizard_W2_NormalBar : YellowWizard_W_NormalBar {}
actor YellowWizard_W2 : YellowWizard_W {
  Inventory.Pickupmessage "$PU_46_B"
  Obituary "$OB_46W2"
  Tag "$TAG_YellowWizard_W2"
  Inventory.Icon "C_I_46B"
  States {
   Ready:
    6H46 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", YELLOWWIZARD_DYE2, CLRF_GNTPOTION)
    6H46 A 0 A_GunFlash("Flash", 1)
    goto Ready2
   Ready2:
    6H46 M 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    6H46 MNOPQR 3 A_GiveInventory("YellowWizard_WepReady_P")
    goto Ready2+1

   Fire2:
    6H46 E 2 Offset(-24, 17)
    6H46 E 2 Offset(-32, 12)
    goto Fire_H+1

   FireFix:
    6H46 A 0 A_ReFire
    goto Ready2

   AltFire:
    6H46 A 0 A_JumpIfInventory("BluePotionAmmo", 150, "Altfire2")
    goto Ready2
   Altfire2:
    6J46 Z 1 A_PlaySound("GNT/PotionUse", 1)
    6J46 H 2 A_GiveInventory("Y_Wiz_Alt_P2")
    6J46 GFEFEFGHZ 2
    goto Ready2
  }
}


actor YShot : BasicProjectile {
  Translation "198:198=228:228", "192:192=160:160"
  DamageType "YellowWizard"
  Obituary "$OB_46M1"
  // +FOILINVUL
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (90)
  Speed 35
  Radius 10
  Height 10
  Scale 2.5
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P46 ABCD 2
    goto Spawn+2
   Death:
    6P46 EFG 3
    stop
  }
}


actor YShot_S : YShot {
  Translation "198:198=229:229", "192:192=4:4"
  Obituary "$OB_46M2"
  Damage (75)
  Speed 36
  Radius 12
  Height 12
  Scale 3.0
}

actor YShot_R : YShot_S {
  BounceSound "GNT/Bounce"
  Obituary "$OB_46M3"
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  -EXPLODEONWATER
  WallBounceFactor 0.945
  BounceFactor 0.945
  BounceCount 8
  Damage (85)
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P46 HIJK 3
    goto Spawn+2
   Death:
    6P46 LMN 3
    stop
  }
}

actor YShot_RS : YShot_R {
  Obituary "$OB_46M4"
  Damage (70)
  Speed 36
  Radius 14
  Height 14
  Scale 3.25
}


actor YShotExplode : YShot {  // Old
  Obituary "$OB_46M5"
  -NOGRAVITY
  Damage (55)
  Radius 14
  Height 14
  Scale 3.5
  Args 105, 118, 16
  States {
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySound("GNT/FakeWall", 1)  // GNT/PotionUse
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])  // 195,158
    TNT1 A 12 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    // 6P46 EFG 3
    stop
  }
}

actor YellowWizardPotionToss : YShot_S {
  Translation "192:192=203:203", "198:198=75:75"
  DamageType "YellowWizardPotion"
  Obituary "$OB_46A"
  -NOGRAVITY
  -BRIGHT
  Damage (10)
  Speed 40
  Scale 3.0
  Args 256, 512, 32
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   SpawnL:
    6P46 OPQR 3
    loop
   SpawnL2:
    6P46 RQPO 3
    loop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySound("GNT/PotionUse", 1)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFXY_H", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_Explode(args[0] * 0.2, args[1], 0, 0, args[1])
    X_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

actor Y_Wiz_EffectFX : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   SpawnFrame:
    X_VA WX 2
    X_VA W 2 A_SetScale(scaleX - 0.625)
    X_VA X 2
    X_VA W 2 A_SetScale(scaleX - 0.625)
    X_VA X 2
    // X_6B ABCD 3
    stop
  }
}

actor Y_Wiz_EffectFY : Y_Wiz_EffectFX {
  States {
   Spawn:
    X_VA OP 2
    X_VA O 2 A_SetScale(scaleX - 0.625)
    X_VA P 2
    X_VA O 2 A_SetScale(scaleX - 0.625)
    X_VA P 2
    // Y_6B ABCD 3
    stop
  }
}


actor Y_Wiz_PotionFXY_H : BasicClientSide {
  var int user_R;
  ReactionTime 6
  Args 512
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 8, 0, 0, args[0], 0, 0, ReactionTime * 60, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 8, 0, 0, args[0], 0, 0, ReactionTime * 60 - 30, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 8, 0, 0, args[0], 0, 0, ReactionTime * 60 - 15, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 8, 0, 0, args[0], 0, 0, ReactionTime * 60 - 45, 33)


    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 6, 0, 2, args[0] / 2, 0, args[0] / 2, ReactionTime * 60, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 6, 0, -2, args[0] / 2, 0, -args[0] / 2, ReactionTime * 60, 33)

    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 6, 0, 2, args[0] / 2, 0, args[0] / 2, ReactionTime * 60 - 30, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 6, 0, -2, args[0] / 2, 0, -args[0] / 2, ReactionTime * 60 - 30, 33)
    TNT1 A 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 0, 0, 8, args[0] / 8, 0, args[0], 0, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 0, 0, 8, args[0] / 8, 0, args[0], 90, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 0, 0, 8, args[0] / 8, 0, args[0], 180, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 0, 0, 8, args[0] / 8, 0, args[0], -90, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 0, 0, -8, args[0] / 8, 0, -args[0], 0, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 0, 0, -8, args[0] / 8, 0, -args[0], 90, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFX2", 0, 0, -8, args[0] / 8, 0, -args[0], 180, 33)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_PotionFY2", 0, 0, -8, args[0] / 8, 0, -args[0], -90, 33)
    stop
  }
}


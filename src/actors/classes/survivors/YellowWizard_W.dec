actor BluePotionAmmo : Ammo {
  Inventory.MaxAmount 300
  +INVENTORY.IGNORESKILL
}

actor YellowWizardFlag : Inventory {
  Inventory.MaxAmount 2
}
actor YellowWizardInvunFlag : Inventory {
  Inventory.MaxAmount 180
}
actor YellowWizardInvisFlag : Inventory {
  Inventory.MaxAmount 198
}

actor YellowWizard_WepReady_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BluePotionAmmo", 150, "Ready3")
   Ready2:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
   Ready3:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ammo:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 3)
    stop
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 4)
    stop
  }
}
actor YellowWizard_WepReady_P2 : YellowWizard_WepReady_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BluePotionAmmo", 300, "Ready3")
    goto YellowWizard_WepReady_P::Ready2
  }
}

actor YellowWizard_LowHP_P : RedWarrior_LowHP_P {
  States {
   Gauntlet2:
    TNT1 A 0 A_GiveInventory("PowerDamageYellowWizard")
    stop
  }
}

actor PowerDamageYellowWizard : PowerDamage {
  Powerup.Duration 40
  DamageFactor "YellowWizard", 1.25
  DamageFactor "YellowWizardPotion", 1.25
}


actor Y_Wiz_HealFX : BasicWatcher {
  Translation "192:192=170:170", "198:198=179:179"
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("Y_Wiz_PlusFX", random(-162, 162), random(-162, 162), random(-162, 162), 0, 0, random(4, 5), 0, 1)
    // TNT1 AAAA 0 A_SpawnItemEx("",random(32,256),0,random(-64,16),0,0,random(4,5),random(0,359),1)
    TNT1 A 1
    stop
  }
}

actor Y_Wiz_ReflectFX : BasicWatcher {
  Translation "192:192=218:218", "198:198=220:220"
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("Y_Wiz_CastFX", 64, 0, 28, random(14, 16), 0, random2(15), random(0, 359), 1)
    TNT1 A 2
    stop
  }
}

actor Y_Wiz_InvunFX : Y_Wiz_ReflectFX {Translation "192:192=228:228", "198:198=163:163"}
actor Y_Wiz_SpreadFX : Y_Wiz_ReflectFX {Translation "192:192=109:109", "198:198=131:131"}
actor Y_Wiz_PotionFX : Y_Wiz_ReflectFX {Translation "192:192=203:203", "198:198=75:75"}
actor Y_Wiz_InvisFX : Y_Wiz_ReflectFX {Translation "192:192=59:59", "198:198=246:246"}


actor Y_Wiz_PlusFX : Basic_HealFX {}

actor Y_Wiz_CastFX : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    X_VE H 0
    // X_VE HGEBFC 2
    X_VE HGABFC 2
    stop
  }
}


actor Y_Wiz_Alt_P0 : CustomInventory {
  States {
   Ammo1:
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 75, 1)
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 75)
    stop
   Ammo2:
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 100, 1)
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 200)
    stop
   Ammo2_Rage:
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 44, 1)
    TNT1 A 0 A_TakeInventory("BluePotionAmmo", 256)
    stop
  }
}

// Heal
actor Y_Wiz_Alt_P1 : Y_Wiz_Alt_P0 {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_HealFX")

    TNT1 A 0  // A_JumpIfInventory("PlayerPropertyRage",1,2)
    TNT1 A 0 A_RadiusGive("YellowWizard_GroupHeal_P", 162, RGF_GIVESELF | RGF_PLAYERS | RGF_NOSIGHT, 1)
    goto Ammo1
    TNT1 A 0 A_RadiusGive("YellowWizard_GroupHeal_P2", 162, RGF_GIVESELF | RGF_PLAYERS | RGF_NOSIGHT, 1)
    goto Ammo1
  }
}

actor YellowWizard_GroupHeal_P : BasicGroupHealPickup {
  States {
   HealMe:  // 15%
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, 2)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, (CallACS("uh_Health", UHEALTH_GET_MAX) * 0.15))
    stop
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, (CallACS("uh_Health", UHEALTH_GET_MAX) * 0.075))
    stop
  }
}
actor YellowWizard_GroupHeal_P2 : BasicGroupHealPickup {
  States {
   HealMe:  // 10%
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, 2)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, (CallACS("uh_Health", UHEALTH_GET_MAX) * 0.10))
    stop
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, (CallACS("uh_Health", UHEALTH_GET_MAX) * 0.05))
    stop
  }
}

// Reflect
actor Y_Wiz_Alt_P2 : Y_Wiz_Alt_P0 {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_ReflectFX")
    // TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
    TNT1 A 0 A_SpawnItemEx("PowerYellowWizardReflect_H")
    goto Ammo1
  }
}

actor PowerYellowWizardReflectGiver : BasicPowerupGiver {
  Powerup.Type "PowerYellowWizardReflect"
}

actor PowerYellowWizardReflect : PowerUp {
  +ADDITIVETIME
  Powerup.Duration 232  // 116//231//-6//-2
}

actor YellowWizardReflectFlag : Inventory {

  Inventory.MaxAmount 232
}

actor PowerYellowWizardReflect_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("YellowWizardReflectFlag", 1, "No")
    TNT1 A 0 A_GiveToTarget("PowerYellowWizardReflectGiver")
    TNT1 A 0 A_GiveToTarget("YellowWizardReflectFlag", 116)
   SpawnLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 1 A_TakeFromTarget("YellowWizardReflectFlag", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("YellowWizardReflectFlag", 1, "SpawnLoop")
    goto Death
   Death:
    TNT1 A 0 A_TakeFromTarget("PowerYellowWizardReflect")
    stop
   No:
    TNT1 A 0 A_GiveToTarget("YellowWizardReflectFlag", 116)
    stop
  }
}

// Invun
actor Y_Wiz_Alt_P3 : Y_Wiz_Alt_P0 {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_InvunFX")
    // TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
    TNT1 A 0 A_GiveInventory("PowerYellowWizardInvunGiver", 1)
    TNT1 A 0 A_JumpIfInventory("YellowWizardInvunFlag", 1, 2)
    TNT1 A 0 A_SpawnItemEx("Y_Wiz_Invun_H")
    TNT1 A 0 A_GiveInventory("YellowWizardInvunFlag", 180)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    goto Ammo2
    TNT1 A 0 A_TakeInventory("YellowWizardInvunFlag", 50)
    goto Ammo2_Rage
  }
}

actor PowerYellowWizardInvunGiver : BasicPowerupGiver {
  Powerup.Type "PowerYellowWizardInvun"
}

actor PowerYellowWizardInvun : PowerInvulnerable {
  // +ADDITIVETIME
  // +INVENTORY.NOSCREENBLINK
  Powerup.Duration -31  // 180 //30//207//60//87
  // Powerup.Color InverseMap

  // Powerup.Colormap 1.0, 1.0, 0.0, 0.5, 0.1, 0.9
  Powerup.Colormap 1.00625, 0.9125, 0.125, 0.1, 0.1, 0.0
  // 232 208 32
}

actor Y_Wiz_Invun_H : BasicWatcher {
  +NOTIMEFREEZE
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_TakeFromTarget("YellowWizardInvunFlag", 1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("YellowWizardInvunFlag", 1, "Spawn")
    goto Death
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", CallACS("core_getptrtid", 2) - 999, false)
    TNT1 A 0 A_TakeFromTarget("PowerYellowWizardInvun", 1)
    TNT1 A 0
    stop
  }
}


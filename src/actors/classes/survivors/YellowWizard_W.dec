actor GauntletFoodPickup : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2)
    TNT1 A 1 A_SpawnItemEx("GauntletFoodPickup1", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), frandom(0, 3), 0, 1)
    stop
    TNT1 A 1 A_SpawnItemEx("GauntletFoodPickup2", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), frandom(0, 3), 0, 1)
    stop
  }
}

actor GauntletFoodPickup1 : CustomInventory {
  inventory.pickupmessage "Picked up some delicious ham! (250)"
  ReactionTime 10
  Scale 2.5
  States {
   Spawn:
    6N46 X 1050 A_CountDown
    loop
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "BossHeal")
    TNT1 A 0 A_PlaySound("GNT/FoodGet", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 250)
    stop
   BossHeal:
    TNT1 A 0 A_PlaySound("GNT/FoodGet", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 250)
    stop
  }
}

actor GauntletFoodPickup2 : GauntletFoodPickup1 {
  inventory.pickupmessage "Picked up some tasty drumsticks! (250)"
  States {
   Spawn:
    6N46 Y 1050 A_CountDown
    loop
  }
}


actor Y_Wiz_InvisTrailFX_P : CustomInventory {

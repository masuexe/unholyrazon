}

actor Y_Wiz_Invis_H : BasicWatcher {
  +NOTIMEFREEZE
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_TakeFromTarget("YellowWizardInvisFlag", 1)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("YellowWizardInvisFlag", 1, "Spawn")
    stop
  }
}

actor YellowWizard_ResetFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 3)
    // TNT1 A 0 A_TakeInventory("YellowWizardFlag")
    TNT1 A 0 A_TakeInventory("VivifyCycle2")
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    stop
  }
}

actor YellowWizard_FireStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_GiveInventory("YellowWizardFlag", 2)
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 8)
    stop
  }
}

actor YellowWizard_Fire_P0 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("VivifyCycle1")
    TNT1 A 0 A_GiveInventory("VivifyCycle1", random(1, 9))

    TNT1 A 0 A_JumpIfInventory("YellowWizardFlag", 2, "Fire_Check")
    TNT1 A 0 A_GiveInventory("YellowWizardFlag", 1)
    stop
   Fire_Check:
    TNT1 A 0 A_JumpIfInventory("PowerYellowWizardReflect", 1, 3)
    TNT1 A 0 A_JumpIfInventory("PowerYellowWizardSpread", 1, "FireS")
    TNT1 A 0 A_JumpIfInventory("YellowWizardFlag", 2, "FireN")
    stop
    TNT1 A 0 A_JumpIfInventory("PowerYellowWizardSpread", 1, "FireRS")
    TNT1 A 0 A_JumpIfInventory("PowerYellowWizardReflect", 1, "FireR")
    stop

   End2:
    TNT1 A 0 A_PlaySound("GNT/Yellow46", 1)
    goto End+1
   End:
    TNT1 A 0 A_PlaySound("GNT/RNGShot", 1)
    TNT1 A 0 A_TakeInventory("YellowWizardFlag")

    TNT1 A 0 A_JumpIfInventory("PowerYellowWizardInvis", 1, "EndI")
   End_R:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "EndR")
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 2)
    TNT1 A 0 A_GiveInventory("VivifyCycle2", 2)
    stop
   EndI:
    TNT1 A 0 A_GiveInventory("Y_Wiz_InvisTrailFX_P")
    goto End_R
   EndR:
    TNT1 A 0 A_GiveInventory("BluePotionAmmo", 4)
    TNT1 A 0 A_GiveInventory("VivifyCycle2", 1)
    stop
  }
}


actor JuggernautShiny_W_NormalBar : NormalBar {args 228, 184}

actor JuggernautShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Juggernaut_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_48"
  Obituary "$OB_48W"
  Weapon.AmmoType "IAmTheAmmoBitch"
  States {
   Spawn:
    7H48 [ 6
    loop

   Deselect:
    7H48 A 0
    goto DeselectSwap
   Select:
    7H48 A 0
    goto SelectSwap

   Ready:
    7H48 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", JUGGERNAUT_SDYE)
    goto Ready2
   Ready2:
    7H48 A 0 A_JumpIfInventory("IAmTheAmmoBitch", 200, "Ready3")
    7H48 A 2 A_WeaponReady(WRF_NOSECONDARY)
    7H48 A 0 A_GiveInventory("IAmTheAmmoBitch", 4)
    loop
   Ready3:
    7H48 A 2 A_WeaponReady
    7H48 A 0 A_GiveInventory("IAmTheAmmoBitch", 4)
    loop

   Fire:
    7H48 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H48 B 2 A_GiveInventory("S_Juggernaut_Fire_P")
    7H48 B 2 Offset(-70, 74)  // C
    7H48 B 2 Offset(-121, 114)  // D
    7H48 C 2 A_WeaponReady(14)
    7H48 C 2 Offset(-25, 56)
    7H48 C 2 Offset(-33, 84)
    TNT1 A 8 Offset(-11, 101)
    7H48 A 2 Offset(-7, 69)
    7H48 A 2 Offset(-3, 48)
    goto Ready2

   BotFire:
    7H48 B 0 A_Jump(8, "BotFire2")
    7H48 B 0 A_Jump(12, "BotFire1")
    7H48 B 0 A_JumpIfInventory("IAmTheAmmoBitch", 200, 1)
    goto Fire+1
    7H48 B 0 A_Jump(10, "BotFire2")
    7H48 B 0 A_Jump(64, "SovietStriker")
    goto Fire+1
   BotFire1:
    7H48 B 0 A_PlaySoundEx("classes/taunt/juggernaut", "Voice")
    7H48 B 0 A_ChangeVelocity(velx, vely, 10.0, CVF_REPLACE)
    goto SovietStriker
   BotFire2:
    7H48 B 0 A_Jump(24, "BotFire1")
    7H48 B 0 A_PlaySoundEx("classes/taunt/juggernaut", "Voice")
    7H48 B 0 A_FireCustomMissile("S_JuggernautShot", 20, 0, 8, 0)
    7H48 B 0 A_FireCustomMissile("S_JuggernautShot", -20, 0, 8, 0)
    7H48 B 0 A_GiveInventory("IAmTheAmmoBitch", random(50, 100))
    goto Fire+1

   Flash.Dash:
    TNT1 A 1 A_Recoil(-5)
    TNT1 A 1 A_Recoil(-7)
    TNT1 A 1 A_Recoil(-10)
    TNT1 A 1 A_Recoil(-12)
    TNT1 A 1 A_Recoil(-17)
    TNT1 A 1 A_Recoil(-24)
    TNT1 A 1 A_Recoil(-33)
    TNT1 A 1 A_Recoil(-44)
    TNT1 A 1 A_Recoil(-57)
    TNT1 A 1 A_Recoil(-73)
    stop

   AltFire:
    7H48 A 0 A_JumpIfInventory("IAmTheAmmoBitch", 200, "SovietStriker")
    goto Ready2
   SovietStriker:
    6H48 D 0 A_GiveInventory("VivifyDelay8")
    6H48 D 0 A_ReFire(1)
    6H48 D 0 A_PlaySound("weapon/GameBoyPunkRam", 1)
    6H48 D 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    6H48 D 0 A_GunFlash("Flash.Dash", 1)
    7H48 E 1
    7H48 D 1
    7H48 E 1 Offset(-10, 27)
    7H48 DEDEDEDEDEDE 1 Offset(-20, 22) A_GiveInventory("S_Juggernaut_Alt_P")
    7H48 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    7H48 DDD 2 A_ChangeVelocity(velx * 0.94, vely * 0.94, velz, 2)
    7H48 D 2 Offset(-10, 27) A_ChangeVelocity(velx * 0.94, vely * 0.94, velz, 2)
    7H48 D 0 A_WeaponReady(14)
    7H48 DDD 2 A_ChangeVelocity(velx * 0.94, vely * 0.94, velz, 2)
    7H48 AAA 2 A_ChangeVelocity(velx * 0.94, vely * 0.94, velz, 2)
    goto Ready2
  }
}

actor S_Juggernaut_Fire_P : Juggernaut_Fire_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_JuggernautShot", 0, 0, 8, 0)
    goto End
  }
}
actor S_Juggernaut_Alt_P : Juggernaut_Alt_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("S_JuggernautExplosion", 0, 0, 32, velx, vely, velz, 0, 8)
    goto End
  }
}

actor S_JuggernautShot : JuggernautShot {
  Translation "192:192=228:228", "198:198=184:184"
  Damage (300)  // 200
}

actor S_JuggernautExplosion : JuggernautExplosion {
  Args 300, 110, 24  // 200
}

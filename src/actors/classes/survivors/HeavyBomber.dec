actor HeavyBomber : CustWepClassBase {
  Player.ScoreIcon "UMUG_19"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "HeavyBomber"
  Player.SoundClass "HeavyBomber"
  Player.MaxHealth 1250
  Health 1250
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 0.95, 0.95
  Player.JumpZ 12.5
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "HeavyBomber_W"
  Player.StartItem "SafeEnergyAmmo", 100
  Player.StartItem "HFlightEnergyAmmo", 50

  Player.StartItem "AirJumpLimit", 2
  States {
   Spawn:
    WINM A 0
    WINM B 1
    WINM A 1
    goto Spawn+2
   See:
    WINM BCDE 5
    goto Spawn
   Missile:
    WINM F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile2")
    WINM F 5
    WINM G 4
    goto Spawn+2
   Missile2:
    WINM BCDEBCDEBCDEBCDE 2
    goto Spawn

   ClassPain:
    WINM H 0
    goto MegamanPain

   ClassDeath:
    WINM H 0
    goto MegamanDeath
   MegamanDeath0:
    WINM H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    WINM H 0 A_ChangeFlag("THRUACTORS", 1)
    WINM H 0 A_JumpIf(z - floorz >= 120, "ClassDeathLoop")
    WINM H 0 A_ChangeVelocity(0, 0, 10)
   ClassDeathLoop:
    WINM H 1 A_SetAngle(angle - 15)
    WINM H 0 A_JumpIfInventory("ClassDeathFlag", 30, "ClassDeathEnd")
    WINM H 0 A_JumpIf(CallACS("core_CheckFooting"), "ClassDeathEnd")
    WINM H 0 A_SpawnItemEx("HeavyBomberExplosionFX", random(-50, 50), random(-50, 50), random(0, 50), 0, 0, 0, 0, 1)
    WINM H 0 A_GiveInventory("ClassDeathFlag", 1)
    loop
   ClassDeathEnd:
    WINM H 0 A_SpawnItemEx("HeavyBomberExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    WINM Z 0 A_SpawnItemEx("Corpse_19", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor HeavyBomberShiny : HeavyBomber {
  Player.ScoreIcon "UMUG_S19"
  Player.MaxHealth 3250
  Health 3250
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.05, 1.05
  Player.JumpZ 13.5
  Player.MorphWeapon "HeavyBomberShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   ClassDeathEnd:
    WINM H 0 A_SpawnItemEx("S_HeavyBomberExplosion", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
  }
}



actor HeavyBomberExplosionFX : BasicClientSide {
  States {
   Spawn:
    TMFX A 0
    TMFX A 0 A_SetScale(frandom(2.25, 2.75))
    TMFX ABCD 1
    stop
  }
}

actor HeavyBomberExplosion : BasicExplosion {
  DamageType "HeavyBomber"
  Obituary "$OB_19D"
  Args 300, 256, 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapon/drillexplode", 1)
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BasicBoom4FX_ColorX_Tic2", random(-100, 100), random(-100, 100), random(0, 100), 0, 0, 0, 0, 1)
    TNT1 A 2 A_Explode(args[0], args[1], 0, 0, args[2])
    stop
  }
}
actor S_HeavyBomberExplosion : HeavyBomberExplosion {
  Args 450, 256, 0
}


actor Corpse_19 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_19_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_19_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_19_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_19_3", 0, 0, 32, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_19_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_19_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_19_0 : BaseCorpseFX {States {Spawn: 1H19 O 350
    goto Spawn2}}
actor Corpse_19_1 : BaseCorpseFX {States {Spawn: 1H19 P 350
    goto Spawn2}}
actor Corpse_19_2 : BaseCorpseFX {States {Spawn: 1H19 Q 350
    goto Spawn2}}
actor Corpse_19_3 : BaseCorpseFX {States {Spawn: 1H19 R 350
    goto Spawn2}}
actor Corpse_19_4 : BaseCorpseFX {States {Spawn: 1H19 S 350
    goto Spawn2}}
actor Corpse_19_5 : BaseCorpseFX {States {Spawn: 1H19 T 350
    goto Spawn2}}

actor HeavyBomber : CustWepClassBase
{
player.scoreIcon "UMUG_19"
player.displayname "HeavyBomber"
player.soundclass "HeavyBomber"
Player.Maxhealth 1250
health 1250
player.forwardmove 1.0, 1.0
player.sidemove 0.95, 0.95
player.jumpz 12.5
player.StartItem "UH_BaseFlagPack"
player.startitem "HeavyBomber_W"
player.startitem "SafeEnergyAmmo", 100
player.startitem "HFlightEnergyAmmo", 50

player.startitem "AirJumpLimit", 2
States
{
Spawn:
WINM A 0
WINM B 1
WINM A 1
Goto Spawn+2
See:
WINM BCDE 5
Goto Spawn
Missile:
WINM F 0 A_JumpIfInventory("VivifyDelay4",1,"Missile2")
WINM F 5
WINM G 4
goto Spawn+2
Missile2:
WINM BCDEBCDEBCDEBCDE 2
Goto Spawn

ClassPain: WINM H 0
Goto MegamanPain

ClassDeath:
WINM H 0
goto MegamanDeath
MegamanDeath0:
WINM H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
WINM H 0 A_ChangeFlag("THRUACTORS",1)
WINM H 0 A_JumpIf(z-floorz>= 120,"ClassDeathLoop")
WINM H 0 A_ChangeVelocity(0,0,10)
ClassDeathLoop:
WINM H 1 A_SetAngle(angle-15)
WINM H 0 A_JumpIfInventory("ClassDeathFlag",30,"ClassDeathEnd")
WINM H 0 A_CheckFloor("ClassDeathEnd")
WINM H 0 A_SpawnItemEx("HeavyBomberExplosionFX",random(-50,50),random(-50,50),random(0,50),0,0,0,0,1)
WINM H 0 A_GiveInventory("ClassDeathFlag",1)
loop
ClassDeathEnd:
WINM H 0 A_SpawnItemEx("HeavyBomberExplosion",0,0,28,0,0,0,0,1)
goto MegamanErase
MegamanCorpse:
WINM Z 0 A_SpawnItemEx("Corpse_19",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor HeavyBomberS : HeavyBomber
{
player.scoreIcon "UMUG_S19"
Player.Maxhealth 3250
health 3250
player.forwardmove 1.1, 1.1
player.sidemove 1.05, 1.05
player.jumpz 13.5
player.morphweapon "HeavyBomberS_W"
+NOSKIN
States
{
ClassDeathEnd:
WINM H 0 A_SpawnItemEx("S_HeavyBomberExplosion",0,0,28,0,0,0,0,1)
goto MegamanErase
}
}



actor HeavyBomberExplosionFX : BasicClientSide
{
States
{
Spawn:
TMFX A 0
TMFX A 0 A_SetScale(frandom(2.25,2.75))
TMFX ABCD 1
stop
}
}

actor HeavyBomberExplosion : BasicExplosion
{
damagetype "HeavyBomber"
Obituary "$OB_19D"
Args 300,256,0
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("weapon/drillexplode",1)
TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BasicBoom4FX_ColorX_Tic2",random(-100,100),random(-100,100),random(0,100),0,0,0,0,1)
TNT1 A 2 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}
actor S_HeavyBomberExplosion : HeavyBomberExplosion
{
Args 450,256,0
}


actor Corpse_19:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_19_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_19_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_19_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_19_3",0,0,32,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_19_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_19_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


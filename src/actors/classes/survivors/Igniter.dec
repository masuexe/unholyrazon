actor Igniter : CustWepClassBase {
  Player.ScoreIcon "UMUG_10"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Igniter"
  Player.SoundClass "Igniter"
  Player.MaxHealth 900
  Health 900
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Igniter_W"
  Player.StartItem "IgniteEnergyAmmo", 125

  damagefactor "Fire", 0.5

  States {
   Spawn:
    FLAM A 0
    FLAM B 1
    FLAM A 1
    goto Spawn+2
   See:
    FLAM BCDE 5
    goto Spawn
   Missile:
    FLAM F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile2")
    FLAM F 5
    FLAM G 4
    goto Spawn+2
   Missile2:
    FLAM G 10
    goto Spawn+2

   ClassPain:
    FLAM H 0
    goto MegamanPain

    // IceDeath:
    // FLAM H 1 ACS_NamedExecuteWithResult("core_weaponcolor", 105,7)
    // FLAM H 0 A_PlaySound("CBM/icebreak",2)
    // FLAM H 0 A_SpawnItemEx("FrozenDeathFX_UH",0,0,0)
    // goto MegamanErase

   ClassDeath:
    FLAM H 0
    goto MegamanDeath
   MegamanDeath0:
    FLAM H 20 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLAM HHHHHHHH 1 A_GiveInventory("IgniterAfterMath_P")
    FLAM H 1 A_SetTranslucent(0.20, 0)
    FLAM H 1 A_SetTranslucent(0.10, 0)
    FLAM H 0
    goto MegamanErase
   MegamanDisintegrate:
    FLAM Z 0 A_SpawnItemEx("Corpse_10", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor IgniterShiny : Igniter {
  Player.ScoreIcon "UMUG_S10"
  Player.MaxHealth 2950
  Health 2950
  Player.ForwardMove 1.35, 1.35
  Player.SideMove 1.3, 1.3
  Player.JumpZ 11
  Player.MorphWeapon "IgniterShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    FLAM H 20 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLAM HHHHHHHH 1 A_GiveInventory("S_IgniterAfterMath_P")
    FLAM H 1 A_SetTranslucent(0.20, 0)
    FLAM H 1 A_SetTranslucent(0.10, 0)
    goto MegamanErase
  }
}


actor IgniterAfterMath_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("IgniterAfterMath", 12, 0, 8, 0, 0, 0, Alpha * -450 + 90, 1)
   End:
    TNT1 A 0 A_PlaySound("weapon/firestorm", 1)
    TNT1 A 0 A_FadeOut(0.1, 0)
    stop
  }
}
actor S_IgniterAfterMath_P : IgniterAfterMath_P {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("IgniterAfterMath", 12, 0, 8, 0, 0, 0, Alpha * -450 + 90, 1)
    goto End
  }
}

actor IgniterAfterMath : CircleFlame {
  +USESPAWNEVENTSCRIPT
  var int user_UseProjSpawnFunc;
  // +RIPPER
  // ActiveSound "weapon/firestorm"
  DeathSound ""
  DamageType "Igniter"
  Obituary "$OB_10D"
  // RenderStyle "Translucent"
  // Alpha 0.75
  Damage (158)
  Radius 10
  Height 32
  Scale 2.5
  States {
   Spawn:  // A_ActiveSound
    X_6C G 2
    X_6C FGFGFGF 4 A_CFlameRotate
    X_6C GF 2
    X_6C G 2 A_CFlameRotate
    X_6C DEBCA 1
    stop
   SpawnOld:
    X_6C F 2
    X_6C F 2 A_CFlameRotate
    X_6C G 2
    X_6C G 2 A_CFlameRotate
    X_6C F 2
    X_6C F 2 A_CFlameRotate
    X_6C G 2
    X_6C G 2 A_CFlameRotate
    X_6C F 2
    X_6C F 2 A_CFlameRotate
    X_6C G 2
    X_6C G 2 A_CFlameRotate
    X_6C F 2
    X_6C F 2 A_CFlameRotate
    X_6C GFG 2
    X_6C F 1 A_CFlameRotate
    X_6C GDEBCA 1
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor S_IgniterAfterMath : IgniterAfterMath {
  Damage (237)
}




actor Corpse_10 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_10_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_10_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


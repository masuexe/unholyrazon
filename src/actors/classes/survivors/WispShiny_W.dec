actor WispShiny_W_ScriptBar : ScriptBar {}

actor WispShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_Shiny_Wisp_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_55"
  Obituary "$OB_55W"
  Weapon.AmmoType "WispSpiritAmmo"
  Weapon.AmmoType2 "BewitchingHexAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H55 [ 6
    loop

   Deselect:
    7H55 A 0 A_TakeInventory("PowerWispPortal")
    goto DeselectSwap
   Select:
    7H55 A 0 A_TakeInventory("BewitchingHexAmmo")
    goto SelectSwap

   Ready:
    7H55 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", WISP_SDYE)
    7H55 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    7H55 A 0 A_JumpIfInventory("PowerWispPortal", 1, 1)
    goto Ready2
    7H55 A 0 A_GunFlash("Flash", 1)
    goto Ready2

   Ready2:
    7H55 ABCDEFGGFEDCBAABCDEFGGFEDCBAABCDEFGGFEDCBA 4 A_GiveInventory("Wisp_ReadyState_P")
    7H55 A 0 A_GiveInventory("WispSpiritAmmo", 1)
    loop

   Fire:
    7H55 H 0 A_GiveInventory("Shiny_Wisp_Fire_P")
    7H55 HIJK 2
    goto Ready2

   Flash:
    TNT1 AAAA 1
    TNT1 A 1 A_GiveInventory("Wisp_FlashDrain_P")
    TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo", 1, "Flash")
    TNT1 A 0 A_TakeInventory("PowerWispPortal")
    stop

   Altfire:
    7H55 A 0 A_JumpIfInventory("PowerWispPortal", 1, "AltTele")
    7H55 J 1
   AltH1:
    7H55 L 0 A_JumpIfInventory("BewitchingHexAmmo", 56, "AltH5")
    7H55 L 1 A_GiveInventory("Shiny_Wisp_AltHold_P")
    7H55 L 0 A_ReFire("AltH1")
    goto AltHex
   AltH5:
    7H55 L 1 A_GiveInventory("Shiny_Wisp_AltHoldTrick_P")
    7H55 L 0 A_ReFire(1)
    goto Alt2
    7H55 Q 1
    7H55 Q 0 A_ReFire(1)
    goto Alt2
    7H55 L 1 A_GiveInventory("Shiny_Wisp_AltHoldTrick_P")
    7H55 L 0 A_ReFire(1)
    goto Alt2
    7H55 Q 1
    7H55 Q 0 A_ReFire("AltH5")
    goto Alt2

   AltHex:
    7H55 M 2 A_GiveInventory("Shiny_Wisp_AltShot_P")
    7H55 N 2
    7H55 O 2 A_TakeInventory("BewitchingHexAmmo")
    7H55 P 6
    7H55 ST 2
    goto Ready2
   Alt2:
    7H55 A 0 A_GiveInventory("Shiny_Wisp_AltTeleStart_P")
    7H55 A 0 A_ReFire(1)
    7H55 MNO 2
    7H55 PRPRPR 2
    7H55 PPPS 2
    7H55 T 2 A_GunFlash("Flash", 1)
    goto Ready2
   AltTele:
    7H55 O 0 A_GiveInventory("Shiny_Wisp_AltTele_P")
    7H55 OUPUPPPST 2
    goto Ready2


   BotReady:
    7H55 A 0 A_WeaponReady(12)
    7H55 AAA 2 A_ReFire("BotFire")
    7H55 A 0 A_GiveInventory("BewitchingHexAmmo", 1)
    loop

   BotFire:
    7H55 A 0 A_JumpIfInventory("PowerWispPortal", 1, "BotFireA2")
    7H55 A 0 A_JumpIfInventory("BewitchingHexAmmo", 56, "BotFireA")
    7H55 A 0 A_Jump(32, "BotAlt0")
    goto BotFire1
   BotFireA:
    7H55 A 0 A_Jump(96, "BotAlt1")
    goto BotFire+2
   BotFireA2:
    7H55 A 0 A_Jump(64, 1)
    goto BotFire+2
    7H55 A 0 A_Jump(24, 1)
    goto BotAlt2
    7H55 A 0 A_PlaySoundEx("classes/taunt/wisp", "Voice")
    7H55 A 0 A_GiveInventory("BewitchingHexAmmo", random(12, 44))
    goto BotAlt2

   BotFire1:
    7H55 H 0 A_Jump(4, "BotFireX1")
    7H55 H 0 A_Jump(236, 2)
    7H55 H 0 A_FaceTarget
    7H55 H 0 A_GiveInventory("Shiny_Wisp_Fire_P")
    7H55 HIJ 2
    7H55 K 2 A_GiveInventory("BewitchingHexAmmo", random(1, 3))
   BotWait:
    7H55 A 1 A_JumpIfInventory("WispSpiritAmmo", 1, "BotReady")
    7H55 A 1 A_Jump(2, "BotAlt0")
    loop
   BotFireX1:
    7H55 A 0 A_Recoil(random(-10, -20))
    7H55 A 0 A_GiveInventory("WispSpiritAmmo", 1)
    7H55 A 0 A_GiveInventory("BewitchingHexAmmo", random(1, 3) * 14)
    7H55 A 0 A_PlaySoundEx("classes/taunt/wisp", "Voice")
    goto BotFire1+1

   BotAlt0:
    7H55 M 2 A_GiveInventory("Shiny_Wisp_AltShot_P")
    7H55 N 2
    7H55 O 2 A_TakeInventory("BewitchingHexAmmo")
    7H55 P 6
    7H55 ST 2
    goto BotReady
   BotAlt1:
    7H55 A 0 A_ChangeVelocity(cos(pitch) * 60, 0, -sin(pitch) * 60, 3)
    7H55 A 0 A_SpawnItemEx("WispAltfireFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    7H55 A 0 A_GiveInventory("Shiny_Wisp_AltTeleStart_P")
    7H55 J 2
    7H55 L 22
    7H55 J 2
    7H55 A 2 A_GunFlash("Flash", 1)
    goto BotReady
   BotAlt2:
    7H55 O 0 A_GiveInventory("Shiny_Wisp_AltTeleBot_P")
    7H55 OUPUPPPST 2
    goto BotReady
  }
}

actor Shiny_Wisp_AltHold_P : Wisp_AltHold_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo", 0, 1)
    goto Ammo
    TNT1 A 0 A_GiveInventory("Wisp_AltHoldTrick_P")
    goto Ammo
  }
}
actor Shiny_Wisp_AltHoldTrick_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Shiny_WispChargeFX", random(-32, 32), random(-32, 32), 8, velx, vely, 12, 0, 8)
    stop
  }
}


actor Shiny_Wisp_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("WispSpiritAmmo", 1, 1)
    TNT1 A 0 A_PlaySound("wep/WispFire", 1)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 2)
    TNT1 A 0 A_FireCustomMissile("Shiny_WispCutter", 0, 0, 0, 0)
    stop
    TNT1 A 0 A_SpawnItemEx("Shiny_WispCutter", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, 0, 32)
    TNT1 A 0 A_SpawnItemEx("Shiny_WispCutter2", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, 15, 32)
    TNT1 A 0 A_SpawnItemEx("Shiny_WispCutter2", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, -15, 32)
    stop
  }
}

actor Shiny_Wisp_AltShot_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("Shiny_WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, 0, 32 + 512)  // SXF_TRANSFERPITCH

    TNT1 A 0 A_PlaySound("wep_L/mm1/firestormfire", 1)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("Shiny_WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, 15, 32 + 512)
    TNT1 A 0 A_SpawnItemEx("Shiny_WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, -15, 32 + 512)
    stop
  }
}

actor Shiny_Wisp_AltTeleStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 A_GiveInventory("WispPortalActive", 1)
    TNT1 A 0 A_GiveInventory("BewitchingHexAmmo", 56)
    TNT1 A 0 A_PlaySound("wep/WispAlt1", 1)
    TNT1 A 0 A_SpawnItemEx("Shiny_WispPortChecker", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor Shiny_Wisp_AltTele_P : Wisp_AltTele_P {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Shiny_Wisp_AltShot_P")
    TNT1 A 0
    goto Wisp_AltTele_P::Pickup+1
   Spawner:
    TNT1 A 0 A_SpawnItemEx("Shiny_WispPortChecker", 0, 0, 0, 0, 0, 0, 0, 1)
    goto End
  }
}
actor Shiny_Wisp_AltTeleBot_P : Shiny_Wisp_AltTele_P {
  States {
   Pickup:
    goto Super::Pickup+1
  }
}


actor Shiny_WispChargeFX : WispChargeFX {
  Translation "192:192=66:66", "198:198=60:60", "202:202=56:56", "199:199=61:61"
}


actor Shiny_WispKindle_H : WispKindle_H {
  Translation "192:192=66:66", "198:198=60:60"
}


actor Shiny_WispCutter : WispCutter {
  Translation "192:192=66:66", "198:198=60:60"
  Args 30, 56, 56, 15  // 15,56,56,15
}
actor Shiny_WispCutter2 : Shiny_WispCutter {
  RenderStyle "Translucent"
  Alpha 0.75
  States {
   Death:
    TNT1 A 1
    stop
  }
}

actor Shiny_WispHexShotStart : WispHexShotStart {
  Translation "192:192=66:66", "198:198=60:60"
  // Mass 50 //Speed
  Args 75, 56, 56, 10  // 50,56,56,10
}

actor Shiny_WispHexBurn : WispHexBurn {
  Translation "192:192=66:66", "198:198=60:60"
  Accuracy 15  // 6
  Meleerange 200  // 150
}

actor Shiny_WispPortChecker : WispPortChecker {
  Args 150, 128, 64  // 100,128,64
}

actor Pain_WispHexHit : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(0, CallACS("uc_WispHex", 1))
    TNT1 A 0 A_JumpIf(args[0] > 0, 1)
    stop
    TNT1 A 0 A_TakeFromTarget("PowerWispKindleDelay")
    TNT1 A 0 A_Warp(2, 0, 0, 32, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_TransferPointer(AAPTR_TARGET, AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_TARGET)
    TNT1 A 0 A_PlaySound("Pokemon/Burn", 2, 0.80)
    TNT1 A 0 A_JumpIfInTargetInventory("TruePowerItemFlag", 1, 2)
    TNT1 A 1 A_SpawnItemEx("WispHexBurn", 0, 0, 32, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
    TNT1 A 1 A_SpawnItemEx("Shiny_WispHexBurn", 0, 0, 32, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
  }
}

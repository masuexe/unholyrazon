actor DecoyCopy_08_W1 : DecoyCopyHeldBase_W1
{
States
{
Fire:
6H50 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H50 C 1 Offset(16,56)A_GiveInventory("DecoyB_F_P08")
6H50 C 3 Offset(34,82)
6H50 B 2 Offset(19,66)
6H50 B 2 Offset(11,53)
6H50 A 0 Offset(5,42)
FireH08:
6H50 V 1 A_RailWait
6H50 V 0 A_ReFire(1)
goto Fire08End
6H50 V 1 A_RailWait
6H50 V 0 A_ReFire(1)
goto Fire08End
6H50 A 1 A_RailWait
6H50 A 0 A_ReFire(1)
goto Fire08End
6H50 A 1 A_RailWait
6H50 A 0 A_ReFire("FireH08")
goto Fire08End
Fire08End:
6H50 X 2 A_GiveInventory("TacticalBomberFlag",1)
6H50 BV 2
goto Ready2
}
}


// Vanilla DecoyBot copy slots 0..58 as slotless move-weapons.
// Select branches on uh_DecoyBotGetWhich (1/2/3) for sprite sets.

actor DecoyCopyMoveBase_W : BaseMM8BDMWep_UH
{
	weapon.ammotype "DecoyEnergyAmmo"
	weapon.ammouse 0
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
States
{
Spawn:
	6H50 [ 6
	loop
Deselect:
	6H50 A 0
	goto DeselectSwap
Select:
	6H50 A 0
	goto Ready
Ready:
Fire:
AltFire:
	6H50 A 1 A_WeaponReady
	wait
MoveReturn:
	6H50 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
	6H50 A 1 A_WeaponReady
	wait
}
}

actor DecoyCopy_00_W : DecoyCopyMoveBase_W
{
States
{
Select:
	6H50 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
	6H50 A 0 A_JumpIf(CallACS("uh_DecoyBotGetWhich") == 2, "Anim2")
	6H50 A 0 A_JumpIf(CallACS("uh_DecoyBotGetWhich") == 3, "Anim3")
	goto Anim1
Anim1:
6H50 C 2 A_GiveInventory("DecoyB_F_P00")
6H50 BAA 2
goto MoveReturn
Anim2:
6I50 C 2 A_GiveInventory("DecoyB_F_P00")
6I50 BAA 2
goto MoveReturn
Anim3:
6J50 C 2 A_GiveInventory("DecoyB_F_P00")
6J50 BAA 2
goto MoveReturn
}
}


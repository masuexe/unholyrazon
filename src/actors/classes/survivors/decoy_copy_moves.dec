6H50 C 1 OffSet(0,32)
goto F41Up
Flash.Fire41:
TNT1 A 0 A_SetArg(4,1)
TNT1 A 2 A_SetArg(4,Args[4]+1)
wait
F41Down:
6H50 B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "F41Crash")
6H50 B 0 A_JumpIfInventory("HandyFlag",999,"F41Crash")
6H50 B 0 A_GiveInventory("DecoyB_F_P41")

actor TacticalBomberShiny_W_NormalBar : NormalBar {Args 218, 5}

actor TacticalBomberShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_TacticalBomber_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_08"
  Obituary "$OB_08W"
  Weapon.AmmoType "ExplosiveEnergyAmmo"
  States {
   Spawn:
    7H08 [ 6
    loop

   Deselect:
    7H08 A 0
    goto DeselectSwap
   Select:
    7H08 A 0
    goto SelectSwap

   Ready:
    7H08 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TACTICALBOMBER_SDYE)
    7H08 A 0
    goto Ready2
   Ready2:
    7H08 A 2 A_GiveInventory("TacticalBomber_Ready_P", 2)
    7H08 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 2)
    loop

   Fire:
    7H08 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H08 A 0 A_TakeInventory("TacticalBomberFlag")
    7H08 A 0 A_PlaySound("wep_L/TactBombFire", 1)
    7H08 A 1 Offset(16, 56) A_FireCustomMissile("S_TacticalBombShot", 0, 1, 8, 0)
    7H08 A 3 Offset(34, 82) A_GunFlash("Flash", 1)

    7H08 A 2 Offset(19, 66)
    7H08 A 2 Offset(11, 53)
    7H08 A 0 Offset(5, 42)

   FireH:
    7H08 C 1 A_RailWait
    7H08 C 0 A_ReFire(1)
    goto FireEnd
    7H08 C 1 A_RailWait
    7H08 C 0 A_ReFire(1)
    goto FireEnd
    7H08 A 1 A_RailWait
    7H08 A 0 A_ReFire(1)
    goto FireEnd
    7H08 A 1 A_RailWait
    7H08 A 0 A_ReFire("FireH")
    goto FireEnd
   FireEnd:
    7H08 B 2 A_GiveInventory("TacticalBomberFlag")
    7H08 A 2
    7H08 B 2 A_GunFlash("NoFlash", 1)
    7H08 B 0 A_GiveInventory("ExplosiveEnergyAmmo", 2)
    goto Ready2

   Flash:
    TNT1 A 2 A_GiveInventory("ExplosiveEnergyAmmo", 1)
    loop

   Altfire:
    7H08 A 0 A_JumpIfInventory("DeadlyExplosiveFlag", 1, "AltFire2")
    7H08 A 0 A_GiveInventory("DeadlyExplosiveFlag", 1)
    7H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 250, 1)
    7H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 100)
    7H08 A 0 A_PlaySound("wep_L/TactBombAlt6", 1)
    7H08 A 0 A_FireCustomMissile("S_TacticalExplosive", 0, 0, 0, 0)

    7H08 A 1 Offset(16, 56)
    7H08 A 3 Offset(34, 82)
    7H08 A 2 Offset(19, 66)
    7H08 A 2 Offset(11, 53)
    7H08 A 2 Offset(5, 42)
    goto Ready2

   AltFire2:
    7H08 B 0 A_GiveInventory("TacticalBomber_Alt2_P")
    7H08 BCEA 1
    7H08 BCEA 1
    7H08 A 0 A_TakeInventory("DeadlyExplosiveFlag")
    goto Ready2


   BotFire:
    7H08 A 0 A_JumpIfInventory("ExplosiveEnergyAmmo", 350, "BotFireAlt")
    7H08 A 0 A_Jump(8, "BotFireAlt2")
    7H08 A 0 A_Jump(96, "BotFire1")
    7H08 A 0 A_Jump(43, "BotFire3")
    7H08 A 0 A_JumpIfInventory("DeadlyExplosiveFlag", 1, "AltFire2")
    7H08 B 0 A_TakeInventory("TacticalBomberFlag")
    7H08 A 0 A_PlaySound("wep_L/TactBombFire", 1)
    7H08 B 0 A_FireCustomMissile("S_TacticalBombShot", 0, 1, 8, 0)
    7H08 BCDEAA 2
    7H08 A random(4, 12)
    7H08 A 0 A_GiveInventory("TacticalBomberFlag")
    goto Ready2
   BotFire1:
    7H08 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 40)
    7H08 A 0 A_PlaySound("weapon/crackerthrow", 1)
    7H08 A 0 A_Jump(110, "BotFire2")
    7H08 B 0 A_FireCustomMissile("S_SJBombShot", 0, 0, 8, 0)
    7H08 BABABA 2
    7H08 A 12
    goto Ready2
   BotFire2:
    7H08 C 0 A_FireCustomMissile("S_TacticalCracker", 0, 0, 8, 0)
    7H08 CACACA 2
    7H08 A 12
    goto Ready2
   BotFire3:
    7H08 A 0 A_PlaySound("weapon/crackerthrow", 1)
    7H08 A 0 A_FireCustomMissile("S_ClusterBombShot", 0, 1, 8, 0)
    7H08 EAEAEA 2
    7H08 A 12
    goto Ready2
   BotFireAlt:
    7H08 A 0 A_Jump(198, "Altfire")
   BotFireAlt2:
    7H08 A 0 A_PlaySoundEx("classes/taunt/tacticalbomber", "Voice")
    7H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 250, 1)
    7H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 100)
    7H08 A 0 A_Jump(128, "BotFireAlt4")
    7H08 A 0 A_PlaySound("weapon/superarmuse", 1)
    7H08 B 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, -28, 0, 0, 0, 0, 33)
    7H08 B 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 0, 0, 0, 0, 0, 33)
    7H08 A 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 28, 0, 0, 0, 0, 33)
    7H08 A 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 56, 0, 0, 0, 0, 33)
    7H08 CCAADD 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 0, 0, 56, 0, 0, 0, 0, 33)
    7H08 E 0 A_SpawnItemEx("TempLobbingDeadlyBomb", 0, 0, 56, 0, 0, 0, 0, 33)
    7H08 E 0 A_FireCustomMissile("S_LobbingDeadlyBomb", 0, 0, 0, 56)
    7H08 AABBA 1
    7H08 A 0 A_FireCustomMissile("S_LobbingDeadlyBomb", 0, 0, 0, 56)
    7H08 ACCAA 1
    7H08 A 0 A_FireCustomMissile("S_LobbingDeadlyBomb", 0, 0, 0, 56)
    7H08 DD 1
    7H08 A 12
    goto Ready2
   BotFireAlt4:
    7H08 A 0 A_PlaySound("weapon/crackermine", 1)
    7H08 A 0 A_SpawnItemEx("S_LobbingDeadlyBomb2", 0, 0, 16)
    7H08 DADA 2
    7H08 A 0 A_PlaySound("weapon/crackermine", 1)
    7H08 A 0 A_SpawnItemEx("S_LobbingDeadlyBomb2", 0, 0, 16)
    7H08 CACA 2
    7H08 A 0 A_PlaySound("weapon/crackermine", 1)
    7H08 A 0 A_SpawnItemEx("S_LobbingDeadlyBomb2", 0, 0, 16)
    7H08 BABA 2
    goto Ready2
  }
}

actor S_TacticalBombShot : TacticalBombShot {
  Translation "192:192=218:218", "198:198=5:5"
  Args 195, 112, 16  // 130
  States {
   SpawnBoom:
    "----" "#" 0 A_SpawnItemEx("S_TacticalBombBoom", 0, 0, Height / 2, 0, 0, 0, 0, 1)
    stop
  }
}

actor S_TacticalBombBoom : TacticalBombBoom {
  Args 480, 128, 96  // 250
}


actor S_TacticalExplosive : TacticalExplosive {
  Translation "192:192=218:218", "198:198=5:5"
  States {
   SpawnBoom:
    TNT1 A 0 A_SpawnItemEx("S_TacticalExplosive3", 0, 0, Height / 2, 0, 0, 0, 0, 1)
    stop
   Death:
    6P08 "#" 0 A_SpawnItemEx("S_TacticalExplosive2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor S_TacticalExplosive2 : TacticalExplosive2 {
  States {
   Death:
    TNT1 A 0 A_SpawnItemEx("S_TacticalExplosive3", 0, 0, Height / 2, 0, 0, 0, 0, 1)
    stop
  }
}

actor S_TacticalExplosive3 : TacticalExplosive3 {
  Args 113, 256, 128  // 75
}

actor S_SJBombShot : SJBombShot {
  Translation "192:192=218:218", "198:198=5:5"
  Damage (random(113, 188))  // 75 125
  Args 150, 148, 8  // 100
}

actor S_LobbingDeadlyBomb : LobbingDeadlyBomb {
  Translation "192:192=218:218", "198:198=5:5"
  Damage (30)  // 20
  Args 450, 250, 8  // 300
}

actor S_LobbingDeadlyBomb2 : LobbingDeadlyBomb2 {
  Translation "192:192=218:218", "198:198=5:5"
  Damage (30)  // 20
  Args 450, 250, 8  // 300
}

actor S_TacticalCracker : TacticalCracker {
  Translation "192:192=218:218", "198:198=5:5"
  Damage (15)  // 10
  Args 450, 128, 8  // 300
}

actor S_ClusterBombShot : ClusterBombShot {
  Translation "192:192=218:218", "198:198=5:5"
  Damage (113)  // 75
  Args 116, 108, 32  // 77
}

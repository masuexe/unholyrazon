  }
}


actor AmberDinnerPlate : BasicProjectile {
  Translation "192:192=4:4", "198:198=220:220"
  var int user_P;
  DamageType "Amber"
  Obituary "$OB_52M2"
  -NOGRAVITY
  Gravity 0.75
  Damage (25)
  Radius 14
  Height 10
  Speed 48
  scale 2.5
  Args 160, 96, 32, 8
  States {
   Spawn:
    6P52 B 0
    6P52 B 5 ThrustThingZ(0, 24, 0, 1)
    6P52 B 5 A_SetUserVar("user_P", user_P+1)
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, 3, 2, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, 3, -2, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, -3, 2, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, -3, -2, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, 2, 3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, 2, -3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, -2, 3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX", 0, 0, 0, 0, -2, -3, 0, 1)

    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX1", 0, 0, 0, 0, -5, 6, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX2", 0, 0, 0, 0, 5, 6, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX3", 0, 0, 0, 0, 5, -6, 0, 1)
    TNT1 A 0 A_SpawnItemEx("AmberDinnerPlateFX4", 0, 0, 0, 0, -5, -6, 0, 1)
    TNT1 A 0 A_PlaySound("DuckHunt/Boom")
    TNT1 A 2 A_Explode(Args[0]+user_P*Args[3], Args[1], 0, 0, Args[2])
    stop
  }
}


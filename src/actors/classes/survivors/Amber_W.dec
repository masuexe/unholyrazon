  bloodtype ""
  damagefactor "Telefrag", 0.0
  painchance 256
  health 999999
  Damage 0
  Height 42
  Radius 25
  Speed 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAA 1 A_Warp(2, cos(-pitch)*36, 0, 11+sin(-pitch)*36, angle, 2)
    stop
   Pain:
    TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
    TNT1 A 0 A_PlaySound("item/protoreflect")//A_Pain
    TNT1 A 0 A_Warp(2, cos(-pitch)*36, 0, 11+sin(-pitch)*36, angle, 2)
    TNT1 A 1 A_SpawnItemEx("AmberBroomBlockFX", 0, 0, 24)
    stop
   Death:
    TNT1 A 0 //A_PlaySound("")
    TNT1 A 1
    stop
  }
}


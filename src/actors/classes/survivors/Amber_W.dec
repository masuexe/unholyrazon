actor AmberHealthPickup : CustomInventory {
  inventory.pickupmessage "Picked up Amber's health capsule. (250)"
  //Inventory.ForbiddenTo Amber
  //How sad, this doesn't work yet
  scale 2.5
  Gravity 0.5
  States {
   Spawn:
    6N52 YZ 6
    loop
   Pickup:
    TNT1 A 0 A_PlaySound("item/energyup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "BossHeal")
    //TNT1 A 0 A_JumpIfInventory("Amber_W2",1,"Pickup2")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 250)
    stop
   Pickup2:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 100)
    stop
   BossHeal:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 100)
    stop
  }
}

actor AmberHealthPickupDeath : BasicProjectile {
  Translation "192:192=0:0", "198:198=220:220", "202:202=220:220", "199:199=4:4", "206:206=93:93", "195:195=190:190"
  DamageType "Amber"
  Obituary "$OB_52D"
  -NOGRAVITY
  +THRUGHOST
  +THRUACTORS
  +NOEXPLODEFLOOR
  +THRUSPECIES
  species "DumbAmberBroom"
  ReactionTime 35
  Damage (300)
  Radius 16
  Height 16
  speed 0//38
  scale 2.5
  States {
   Spawn:
    TNT1 A 35
    TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
    6N52 Y 0 A_CountDown
    6N52 Y 0 A_Jump(16, "SpawnX")
    6N52 YZ 6 //ThrustThingZ(0,0,0,0)
    goto Spawn+3
   SpawnX:
    6N52 X 6 //ThrustThingZ(0,0,0,0)
    goto Spawn+5
   Death:
    TMFX A 0 A_SetGravity(0.0)
    TMFX A 0 A_PlaySound("S_Spin/OhNooo", 3, 1)
    TMFX ABCD 2
    stop
  }
}

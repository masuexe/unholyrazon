actor Amber_W_ScriptBar : ScriptBar {}
actor Amber_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_52"
  Obituary "$OB_52W1"
  Tag "$TAG_Amber_W"
  weapon.ammotype "VixenScuttleAmmo"
  weapon.ammotype2 "AmberEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H52 [ 6
    loop

   Deselect:
    6H52 A 0
    goto DeselectSwap
   Select:
    6H52 A 0
    goto SelectSwap

   Ready:
    6H52 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE)
    6H52 A 0 A_GunFlash("Flash", 1)
    6H52 A 0 A_TakeInventory("AmberChargeFlag")
    goto Ready2
   Ready2:
    6H52 AA 18 A_WeaponReady
    6H52 A 0 A_GiveInventory("VixenScuttleAmmo", 20)
    loop

   Flash:
    TNT1 AA 3
    TNT1 A 3 A_GiveInventory("Amber_Flash_P")
    loop

   Fire:
    6H52 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H52 A 0 A_JumpIfInventory("AmberChargeFlag", 1, "Fire2")
   FireH:
    6H52 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "FireH2")
    6H52 A 1 OffSet(2, 30)A_GiveInventory("AmberChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H52 A 0 A_ReFire("FireH")
    goto Fire1
   FireH2:
    6H52 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "FireH3")
    6H52 A 1 OffSet(4, 27)A_GiveInventory("AmberChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H52 A 0 A_ReFire("FireH2")
    goto Fire1
   FireH3:
    6H52 A 1 OffSet(6, 24)ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE2, 1)
    6H52 A 0 A_ReFire(1)
    goto Fire1
    6H52 A 1 OffSet(6, 23)ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE, 1)
    6H52 A 0 A_ReFire("FireH3")
    goto Fire1

   Fire1:
    6H52 B 1 OffSet(-12, 20)A_GiveInventory("Amber_Fire_P1")
    6H52 C 1 OffSet(-39, 23)
    6H52 C 1 OffSet(-84, 32)
    6H52 D 1 OffSet(-133, 42)
    6H52 E 1 OffSet(-164, 44)
    6H52 E 1 OffSet(-208, 55)
    6H52 E 1 OffSet(-256, 69)
    6H52 E 1 OffSet(-304, 86)
    TNT1 A 4
    TNT1 AAAAAAAAA 2 A_WeaponReady(1+2)//A_ReFire("Fire2")
    TNT1 A 0 A_TakeInventory("AmberChargeFlag")
    6H52 A 2 OffSet(-48, 217)A_WeaponReady(1)
    6H52 A 2 OffSet(-32, 162)A_WeaponReady(1)
    6H52 A 2 OffSet(-19, 118)A_WeaponReady(1)
    6H52 A 2 OffSet(-10, 83)A_WeaponReady(1)
    6H52 A 2 OffSet(-3, 55)A_WeaponReady(1)
    Goto Ready2+2
   Fire2:
    6H52 F 1 OffSet(-110, 47)A_GiveInventory("Amber_Fire_P2")
    6H52 G 1 OffSet(-93, 42)
    6H52 G 1 OffSet(-46, 33)A_TakeInventory("AmberChargeFlag")
    6H52 H 1 OffSet(-30, 25)
    6H52 H 1 OffSet(19, 19)
    6H52 H 1 OffSet(72, 21)
    6H52 H 1 OffSet(129, 33)
    TNT1 A 8
    6H52 A 2 OffSet(78, 67)
    6H52 A 2 OffSet(54, 54)
    6H52 A 2 OffSet(32, 45)
    6H52 A 2 OffSet(16, 39)
    6H52 A 2 OffSet(6, 35)
    Goto Ready2+2

   FirePlate:
    6J52 J 2 OffSet(-42, 71)
    6J52 L 2 OffSet(-103, 90)
    6J52 L 2 OffSet(-88, 64)
    6J52 L 2 OffSet(-69, 42)
    6J52 K 0 A_PlaySound("DuckHunt/Plate", 1, 0.85)
    6J52 K 2 OffSet(-55, -36)A_FireCustomMissile("AmberDinnerPlate", 0, 0, 8, 0)
    6J52 K 2 OffSet(-3, -61)
    6J52 K 2 OffSet(49, -89)
    6J52 J 2 OffSet(94, 5)
    6J52 J 2 OffSet(48, 19)
    6J52 J 2 OffSet(16, 28)
    goto Ready2

   Altfire:
    6H52 I 0 A_GiveInventory("Amber_Alt_P")
    6H52 I 0 A_Refire(1)
    6H52 I 1 OffSet(-14, 64)
    6H52 I 1 OffSet(-32, 41)
    6H52 I 10 OffSet(-56, 15)A_WeaponReady(11)
    6H52 I 3 OffSet(-43, 35)A_WeaponReady(11)
    6H52 I 3 OffSet(-26, 60)A_WeaponReady(11)
    6H52 I 2 OffSet(-4, 91)A_WeaponReady(11)
    6H52 I 0 A_TakeInventory("AmberChargeFlag")
    6H52 A 2 OffSet(30, 192)A_WeaponReady(1)
    6H52 A 2 OffSet(20, 142)A_WeaponReady(1)
    6H52 A 2 OffSet(12, 87)A_WeaponReady(1)
    6H52 A 2 OffSet(6, 62)A_WeaponReady(1)
    6H52 A 2 OffSet(2, 47)A_WeaponReady(1)
    Goto Ready2+1

   AltHeal:
    6J52 K 1 OffSet(-32, 62)A_GiveInventory("Amber_AltHeal_P")
    6J52 M 1 OffSet(-115, 70)
    6J52 M 1 OffSet(-115, 38)
    6J52 M 11 OffSet(-115, 6)
    6J52 M 2 OffSet(-115, 26)
    6J52 M 2 OffSet(-115, 50)
    6J52 M 2 OffSet(-115, 78)
    6J52 J 2 OffSet(-40, 71)
    6J52 J 2 OffSet(-24, 47)
    goto Ready2


    /*
    Fire:
    6J52 IH 1
    6J52 GFE 2 A_GiveInventory("AmberEnergyAmmo",1)
    6J52 D 0 A_PlaySound("weapon/slashclaw",1)
    6J52 D 1 A_FireCustomMissile("AmberNeedle",0,0,8,0)
    6J52 C 0 A_FireCustomMissile("AmberNeedle",3,0,8,0)
    6J52 C 1 A_FireCustomMissile("AmberNeedle",-3,0,8,0)
    6J52 C 0 A_FireCustomMissile("AmberNeedle",6,0,8,0)
    6J52 C 1 A_FireCustomMissile("AmberNeedle",-6,0,8,0)
    6J52 BHIA 2 A_GiveInventory("AmberEnergyAmmo",1)
    Goto Ready2
    */


   BotFire:
    6H52 A 0 A_Jump(4, "BotFireX")
    6H52 A 0 A_JumpIfInventory("BotFlag2", 1, "BotFireX2")
    6H52 A 0 A_Jump(15, "Altfire")
    6H52 A 0 A_Jump(2, "BotAlt2")
    6H52 A 0 A_FaceTarget
    6H52 A 0 A_JumpIfCloser(256, "BotFire1")//345
    6H52 A 0 A_JumpIfCloser(800, "BotFire2")
    goto BotFire3

   BotFire1:
    6H52 A 0 A_JumpIfInventory("AmberChargeFlag", 1, "Fire2")
    6H52 A 0 A_GiveInventory("AmberChargeFlag", 1+random(0, 2)*35)
    goto Fire1
   BotFire2:
    6H52 A 0 A_Jump(16, "BotFire1")
    6H52 A 0 A_Jump(64, "FirePlate")
    goto BotAlt
   BotFire3:
    6H52 A 0 A_Jump(8, "BotAlt2")
    6H52 A 0 A_Jump(4, "BotFire1")
    6H52 A 0 A_Jump(64, "BotAlt")
    goto FirePlate

   BotAlt:
    6H52 A 0 A_Jump(8, "BotAlt2")
    6H52 A 0 A_GiveInventory("Amber_Alt_P")
    6H52 A 0 A_Refire(1)
    6H52 AA random(2, 15)
    goto Ready2
   BotAlt2:
    6H52 A 0 A_PlaySoundEx("classes/taunt/amber", "Voice")
    6H52 A 0 A_GiveInventory("AmberEnergyAmmo", 5*random(5, 20))
    6H52 A 0 A_GiveInventory("VixenScuttleAmmo", 20*random(1, 3))
    goto AltHeal

   BotFireX:
    6H52 A 0 A_PlaySoundEx("classes/taunt/amber", "Voice")
    6H52 A 0 A_GiveInventory("AmberEnergyAmmo", 5*random(5, 10))
    6H52 A 0 A_GiveInventory("BotFlag2", random(40, 60))
   BotFireX2:
    6J52 K 0 A_PlaySound("Caliber/Pew", 1)
    6J52 K 0 A_TakeInventory("BotFlag2", 1)
    6J52 KK 1 A_FireCustomMissile("AmberNeedle", random(-1, 1), 0, random(-8, 8), random(-8, 8), 0, random(-1, 1))
    6J52 K 0 A_JumpIfInventory("BotFlag2", 1, 1)
    goto Ready2
    6J52 K 0 A_Refire("BotFireX2")
    goto Ready2
  }
}

actor AmberEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 100
  +INVENTORY.IGNORESKILL
}

actor VixenScuttleAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 280
  +INVENTORY.IGNORESKILL
}


actor AmberChargeFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 70
}

actor Amber_AmmoGetDelay : PowerUp {
  Powerup.Duration 2
}

actor Amber_GainOnHit_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Amber_AmmoGetDelay", 1, 3)
    TNT1 A 0 A_GiveInventory("AmberEnergyAmmo", 20)
    TNT1 A 0 A_GiveInventory("Amber_AmmoGetDelay")
    TNT1 A 0
    stop
  }
}

actor Amber_Flash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("AmberEnergyAmmo", 1, 1)//HealMe
    stop
    TNT1 A 0 A_JumpIf(!CallACS("uh_Health", UHEALTH_IS_FULL), "HealMe")
    stop
   HealMe:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 5)
    TNT1 A 0 A_TakeInventory("AmberEnergyAmmo", 2, 1)
    TNT1 A 0 A_TakeInventory("AmberEnergyAmmo", 3)
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor Amber_Fire_P1 : CustomInventory {
  States {
   Pickup:
    //A_GiveInventory("Repulsion",1)
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "A3")
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "A2")
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe1", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H1", 0, 0, 0, -4)
    goto Snd1
   A2:
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe3", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H3", 0, 0, 0, -4)
    goto Snd2
   A3:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE, 1)
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe5", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe5_H", -20, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H5", 0, 0, 0, -4)
    goto Snd3
   Snd1:
    TNT1 A 0 A_PlaySound("KirbyNES/InsertFlag", 1)
    goto End
   Snd2:
    TNT1 A 0 A_PlaySound("KirbyNES/WepSwing", 1)
    goto End
   Snd3:
    TNT1 A 0 A_PlaySound("KirbyNES/Fireball", 1)
    goto End
   End:
    TNT1 A 0 A_SpawnItemEx("AmberBroomBlock", cos(-pitch)*36, 0, 11+sin(-pitch)*36, 0, 0, 0, 0, 32+SXF_TRANSFERPITCH)//512
    stop
  }
}
actor Amber_Fire_P2 : Amber_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "A3")
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "A2")
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe2", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H2", 0, 0, 0, -4)
    goto Snd1
   A2:
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe4", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H4", 0, 0, 0, -4)
    goto Snd2
   A3:
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe6", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberBroomSwipe6_H", 20, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("AmberSwipe_H6", 0, 0, 0, -4)
    goto Snd3
  }
}

actor Amber_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay3")
    TNT1 A 0 A_TakeInventory("AmberChargeFlag")////Prevents Dash combo
    TNT1 A 0 A_SpawnItemEx("Amber_DashFX_H", -10, 0, 4)
    TNT1 A 0 A_JumpIfInventory("VixenScuttleAmmo", 40, "Pickup2")
    goto Pickup1
   Pickup1:
    TNT1 A 0 A_PlaySound("KirbyNES/Skid", 4)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "PickupG1")
    TNT1 A 0 ThrustThingZ(0, 6, 0, 1)
    TNT1 A 0 A_ChangeVelocity(15, 0, momz, 3)
    stop
   PickupG1:
    TNT1 A 0 ThrustThingZ(0, 14, 0, 0)
    TNT1 A 0 A_ChangeVelocity(18, 0, momz, 3)
    stop
   Pickup2:
    TNT1 A 0 A_PlaySound("KirbyNES/Dash", 4)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "PickupG2")
    //TNT1 A 0 A_Recoil(-22)
    TNT1 A 0 ThrustThingZ(0, 10, 0, 1)
    TNT1 A 0 A_ChangeVelocity(30, 0, momz, 3)
    goto End
   PickupG2:
    //TNT1 A 0 A_Recoil(-28)
    TNT1 A 0 ThrustThingZ(0, 28, 0, 0)
    TNT1 A 0 A_ChangeVelocity(36, 0, momz, 3)
    goto End
   End:
    TNT1 A 0 A_TakeInventory("VixenScuttleAmmo", 20, 1)
    TNT1 A 0 A_TakeInventory("VixenScuttleAmmo", 20)
    stop
  }
}


actor Amber_DashFX_H : BasicClientSide {
  ReactionTime 3
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Amber_DashFX", 0, 22.5, 0, 0, 0, frandom(1, 2))
    TNT1 A 0 A_SpawnItemEx("Amber_DashFX", 0, 0, 0, 0, 0, frandom(1, 2))
    TNT1 A 0 A_SpawnItemEx("Amber_DashFX", 0, -22.5, 0, 0, 0, frandom(1, 2))
    TNT1 A 4 A_CountDown
    TNT1 A 0 A_Warp(AAPTR_TARGET, -10, 0, 4, angle, WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION)
    loop
  }
}

actor Amber_DashFX : BasicClientSide {
  States {
   Spawn:
    6P0K S 0
    6P0K S 0 A_SetScale(2.5*(random(0, 1)*2-1), ScaleY)
    6P0K ST 2
    stop
  }
}



// Unbound: PainBaseFlingAngleHit Args=XY, then Pain.AmberFlingUp (PainPU_Z_30).
// Modern: Basic_*Fling_H Args forceXY, forceZ, flags (2 = KNK_ADDZTHRUST).
actor PainAmberFlingAwayHit : Basic_PainFling_H{Args 11, 30, 2}
actor PainAmberFlingAway2Hit : Basic_PainFling_H{Args 22, 30, 2}
actor PainAmberFlingAway3Hit : Basic_PainFling_H{Args 33, 30, 2}
actor PainAmberFlingUpHit : Basic_PainFling_H{Args 0, 30, 2}
actor DeathAmberFlingAwayHit : Basic_DeathFling_H{Args 11, 30, 0}
actor DeathAmberFlingAway2Hit : Basic_DeathFling_H{Args 22, 30, 0}
actor DeathAmberFlingAway3Hit : Basic_DeathFling_H{Args 33, 30, 0}
actor DeathAmberFlingUpHit : Basic_DeathFling_H{Args 0, 30, 0}

actor AmberBroomSwipe1 : BasicFastProjectile {
  Damagetype "AmberFlingUp"
  Obituary "$OB_52M1"
  +DONTBLAST
  +DONTREFLECT
  +NOTIMEFREEZE
  +THRUGHOST
  +THRUSPECIES
  Species "DumbAmberBroom"
  RenderStyle None
  Reactiontime 1
  Damage (0)
  Radius 20
  Height 28
  Speed 100
  Mass 50
  Args 170, 80, 40
  Scale 0.5
  var int user_NoTranslation;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_CountDown
    wait
   Death:
    TNT1 A 1 A_Explode(Args[0]*frandom(0.95, 1.05), Args[1], 0, 0, Args[2]*2/3)
    stop
   XDeath:
    TNT1 H 1 A_Explode((Args[0]+Mass)*frandom(0.95, 1.05), Args[1], 0, 0, Args[2])
    stop
  }
}

actor AmberBroomSwipe2 : AmberBroomSwipe1{Mass 70 Args 200, 80, 48 Damagetype "AmberFlingAway"}
actor AmberBroomSwipe3 : AmberBroomSwipe1{Mass 70 Args 220, 100, 50}
actor AmberBroomSwipe4 : AmberBroomSwipe2{Mass 90 Args 250, 100, 60 Damagetype "AmberFlingAway2"}
actor AmberBroomSwipe5 : AmberBroomSwipe1{Mass 90 Args 320, 120, 60}
actor AmberBroomSwipe6 : AmberBroomSwipe2{Mass 110 Args 350, 120, 72 Damagetype "AmberFlingAway3"}

actor AmberBroomSwipe5X : AmberBroomSwipe1 {
  Damagetype "AmberFire"
  Damage (0)
  Args 32, 120, 60
  Speed 175
  States {
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    goto AmberBroomSwipe1::Death
   XDeath:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    goto AmberBroomSwipe1::XDeath
  }
}

actor AmberBroomSwipe5_H : BasicWatcher {
  ReactionTime 5
  Speed 1
  Args 32, 120, 60, 10
  Speed 1
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0.0, 0, 33, angle, 2|8|16)
    TNT1 A 0 A_SpawnItemEx("AmberBroomSwipe5X", 0, 0, 0, sqrt(momx*momx+momy*momy), 0, momz, 0, SXF_MULTIPLYSPEED+SXF_TRANSFERSPECIAL)//8192+32768
    TNT1 A 2 A_CountDown
    TNT1 A 0 A_SetAngle(angle+Args[3])
    loop
  }
}
actor AmberBroomSwipe6_H : AmberBroomSwipe5_H {
  Args 38, 120, 60, -10
}


actor AmberSwipe_H1 : BasicWatcher//Sync being spawned
{
  Translation "192:192=211:211"
  +NOTIMEFREEZE
  speed 60
  States {
   Spawn:
    TNT1 A 0
   Swing1:
    TNT1 A 0 A_SpawnItemEx("AmberBroomSwipeFX1", 0, 0, 0, 0, 0, 0, 0, 1+SXF_TRANSFERPOINTERS)//1024
    stop
  }
}
actor AmberSwipe_H2 : AmberSwipe_H1 {
  States {
   Spawn:
    TNT1 A 0
   Swing2:
    TNT1 A 0 A_SpawnItemEx("AmberBroomSwipeFX2", 0, 0, 0, 0, 0, 0, 0, 1+1024)
    stop
  }
}
actor AmberSwipe_H3 : AmberSwipe_H1{Translation "192:192=216:216"}
actor AmberSwipe_H4 : AmberSwipe_H2{Translation "192:192=216:216"}
actor AmberSwipe_H5 : AmberSwipe_H1 {
  Translation "192:192=216:216", "198:198=220:220"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("AmberBroomSwipeFX5", 0, 0, 0, 0, 0, 0, -26, 1)
    goto Swing1
  }
}
actor AmberSwipe_H6 : AmberSwipe_H2 {
  Translation "192:192=216:216", "198:198=220:220"//234
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("AmberBroomSwipeFX6", 0, 0, 0, 0, 0, 0, 26, 1)
    goto Swing2
  }
}


actor AmberBroomSwipeFX1 : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  States {
   SpawnFrame:
    X_7F K 0
    X_7F K 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    X_7F KLLMMNNOO 1 A_Warp(AAPTR_TARGET, cos(-pitch)*75.0, 0, sin(-pitch)*75.0+28.0, angle, WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)//WARPF_COPYINTERPOLATION
    stop
  }
}
actor AmberBroomSwipeFX2 : AmberBroomSwipeFX1 {
  States {
   SpawnFrame:
    X_7F P 0
    X_7F P 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    X_7F PQQRRSSTT 1 A_Warp(2, cos(-pitch)*75.0, 0, sin(-pitch)*75.0+28.0, angle, 2|8|16)//64
    stop
  }
}
actor AmberBroomSwipeFX5 : AmberBroomSwipeFX1 {
  ReactionTime 11
  Args 6, 2
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    TNT1 A 0 A_SetPitch(pitch-Args[1]*5, SPF_INTERPOLATE)
   SpawnL:
    TNT1 A 0 A_Warp(2, cos(-pitch)*40.0, 0, sin(-pitch)*40.0+28.0, angle, 2|8|16)
    TNT1 AAA 0 A_SpawnItemEx("AmberBroomFireFX0", random(0, 8)*3, frandom(-4, 4)*3, random(-4, 4)*3, Cos(pitch)*20+random(-5, 5), 0, -sin(pitch)*20+random(-1, 5), frandom(-3, 0.5), 1, 32)
    TNT1 AAA 0 A_SpawnItemEx("AmberBroomFireFX0", random(0, 8)*3, frandom(-4, 4)*3, random(-4, 4)*3, Cos(pitch)*20+random(-5, 5), 0, -sin(pitch)*20+random(-5, 1), frandom(-3, 0.5), 1, 32)
    TNT1 AAA 0 A_SpawnItemEx("AmberBroomFireFX0", random(0, 8)*3, frandom(-4, 4)*3, random(-4, 4)*3, Cos(pitch)*20+random(-5, 5), 0, -sin(pitch)*20+random(-1, 5), frandom(-0.5, 3), 1, 32)
    TNT1 AAA 0 A_SpawnItemEx("AmberBroomFireFX0", random(0, 8)*3, frandom(-4, 4)*3, random(-4, 4)*3, Cos(pitch)*20+random(-5, 5), 0, -sin(pitch)*20+random(-5, 1), frandom(-0.5, 3), 1, 32)
    //A_SpawnItemEx("AmberBroomFireFX0",random(-4,4),random(-4,4),random(-4,4),random(5,15),random(-10,10),random(-15,15),random(-60,60),1)
    TNT1 A 1 A_CountDown
    TNT1 A 0 A_SetAngle(angle+Args[0])
    TNT1 A 0 A_SetPitch(pitch+Args[1], SPF_INTERPOLATE)
    loop
  }
}
actor AmberBroomSwipeFX6 : AmberBroomSwipeFX5{Args -6, -2}



actor AmberBroomChargeFX : BasicClientSide {
  +MISSILE
  Speed 60
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(0.1*random(15, 25)*(random(0, 1)*2-1))
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 9, 10, 11)
    6P52 PPQQRRSS 1
    stop
    6P52 TTUUVV 1
    stop
  }
}


actor AmberBroomFireFX0// : BasicClientSide
{

  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMONST
  +NOBLOCKMAP
  +SLIDESONWALLS
  //+MISSILE
  +DONTSPLASH
  +DONTBLAST
  +THRUACTORS
  -SOLID
  //RenderStyle "None"
  radius 4
  height 4
  Scale 4.0


  +FORCEXYBILLBOARD
  Args 15, 25
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(0.1*random(Args[0], Args[1])*(random(0, 1)*2-1))
    TNT1 A 0 A_Jump(256, "S0")
   S0:
    TNT1 A 0 A_Jump(256, "S2", "S3", "S4", "S5", "S6")
   S1:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 11, 12, 13, 14)
    6P52 HHIIJJKKLM 1
    stop
    6P52 JJKKHHIILM 1
    stop

   S2:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P52 WWXXYYZZ 1
    stop

   S3:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 7, 8, 9, 10, 13, 14)
    6Q52 EEFFHH 1
    stop
    6Q52 GGHHII 1
    stop
    6Q52 GGII 1
    stop

   S4:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6Q52 JJKKLLMM 1
    stop

   S5:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6Q52 NNOOPPQQ 1
    stop

   S6:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 9, 10, 11)
    6P52 PPQQRRSS 1
    stop
    6P52 TTUUVV 1
    stop
  }
}


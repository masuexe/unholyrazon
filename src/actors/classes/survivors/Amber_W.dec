actor AmberBroomBlock {
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  //+GHOST
  +SHOOTABLE
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +NODAMAGE
  Species "DumbAmberBroom"
  //PainSound "item/protoreflect"

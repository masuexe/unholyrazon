actor SumoWrestlerShiny_W_NormalBar : NormalBar {args 16, 20}

Actor SumoWrestlerShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_SumoWrestler_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_36"
Obituary "$OB_36W"
weapon.ammotype "SUBALUWAAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H36 [ 6
loop

Deselect:
7H36 A 0
goto DeselectSwap
Select:
7H36 A 0
goto SelectSwap

Ready:
7H36 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", SUMOWRESTLER_SDYE)
7H36 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
Goto Ready2
Ready2:
7H36 A 0 A_GunFlash("Flash",1)
7H36 A 1 A_WeaponReady
wait

Fire:
7H36 A 0 A_GiveInventory("VivifyFlag1",1)
7H36 A 0 A_ReFire(1)

7H36 QRS 1
7H36 T 2
7H36 T 0 A_GiveInventory("SumoW_Fire_P1")
Goto FireSlam
FireSlam:
7H36 T 1 A_GiveInventory("SumoW_SlamCheck_P")
7H36 T 0 A_JumpIf(CallACS("core_CheckFooting"),"FireEnd")
7H36 T 0 A_JumpIfInventory("DecoyFlag1",1,"FireEnd")
7H36 T 0 A_JumpIf(momz<=0,"FireSlamZ")
loop
FireSlamZ:
7H36 T 1 A_GiveInventory("SumoW_SlamCheck_P")
7H36 T 0 A_JumpIf(CallACS("core_CheckFooting"),"FireEnd")
7H36 T 0 A_JumpIfInventory("DecoyFlag1",1,"FireEnd")
7H36 T 0 A_JumpIf(momz>=0,"FireEnd")
loop
FireEnd:
TNT1 A 2 A_GiveInventory("S_SumoW_Fire_P2")
TNT1 A 7
7H36 NO 3
7H36 A 5
Goto Ready2

FireStomp:
7H36 U 0 A_PlaySound("SumoW/LeapCharge",1)
7H36 U 1 A_Stop
7H36 U 0 A_ReFire(1)
goto Stomp+1
7H36 T 1 A_Stop
7H36 T 0 A_ReFire(1)
goto Stomp+2
7H36 U 1 A_Stop
7H36 U 0 A_ReFire(1)
goto Stomp+3
7H36 T 1 A_Stop
7H36 T 0 A_ReFire(1)
goto Stomp+4
7H36 U 1 A_Stop
7H36 U 0 A_ReFire(1)
goto Stomp+5
7H36 T 1 A_Stop
7H36 T 0 A_ReFire(1)
goto Stomp+5
7H36 U 1 A_Stop
7H36 U 0 A_ReFire(1)
goto Stomp+5
7H36 T 1 A_Stop
7H36 T 0 A_ReFire(1)
goto Stomp+5
7H36 U 1 A_Stop
7H36 U 0 A_ReFire(1)
goto Stomp+5
7H36 U 0 A_PlaySound("SumoW/LeapCharge",1)
Stomp:
7H36 UTUTU 1 A_Stop
7H36 T 0 A_ChangeVelocity(0,0,-20,2)
FireStompFall:
7H36 T 1 A_ChangeVelocity(0,0,-4)
7H36 T 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "FireStompLand")
7H36 T 0 A_JumpIfInventory("PowerMomZVerify",1,2)
7H36 T 0 A_JumpIf(momz==0,2)
loop
7H36 T 0 A_JumpIf(momz==0,"FireStompLand")
loop
7H36 T 0 A_GiveInventory("PowerMomZVerify")
loop
FireStompLand:

7H36 U 0 A_GiveInventory("S_SumoW_StompLand_P")
7H36 VWX 1
7H36 B 8
7H36 C 3
7H36 A 2
Goto Ready2+1

Flash:
TNT1 A 1 A_JumpIfInventory("SumoWrestlerFlag",1,1)
loop
TNT1 A 1 A_GiveInventory("S_SumoW_Flash_P")
loop

AltFire:
7H36 B 0 A_JumpIfInventory("VivifyFlag1",1,"FireStomp")
7H36 B 0 A_GiveInventory("VivifyDelay3",1)
7H36 B 0 A_GiveInventory("VivifyFlag2",1)
7H36 B 0 A_ReFire(1)
7H36 EEFF 1
7H36 F 0 A_ReFire(1)
goto Altfire3
AltFireH:
7H36 F 0 A_JumpIfInventory("SUBALUWAAmmo",14,"AltFireH2")
7H36 F 2 A_GiveInventory("SumoW_AltCharge_P")
7H36 F 0 A_Refire("AltFireH")
goto Altfire3
AltFireH2:
7H36 P 1 A_GiveInventory("SumoW_AltCharge_P")
7H36 P 0 A_Refire(1)
goto Altfire4
7H36 F 1 A_RailWait
7H36 F 0 A_Refire("AltFireH2")
goto Altfire4
Altfire3:
7H36 F 0 A_JumpIfInventory("SUBALUWAAmmo",14,"AltFire4")
7H36 F 1 A_GiveInventory("S_SumoW_Alt_P1")
7H36 EDCB 1
goto AltEnd+1
AltFire4:
7H36 F 2 A_GiveInventory("S_SumoW_Alt_P2")
7H36 EDCB 2
goto AltEnd
AltEnd:
TNT1 A 10
TNT1 A 10 A_TakeInventory("VivifyFlag2")
7H36 GHA 2
Goto Ready2+1



BotReady:
7H36 A 0 A_GunFlash("Flash",1)
7H36 A 0 A_WeaponReady(12)
7H36 A 2 A_Refire("BotFire")
goto BotReady+1

BotFire:
7H36 A 0 A_Jump(96,"BotAlt")
7H36 A 0 A_Jump(56,1)
goto B_Fire
7H36 A 0 A_ChangeVelocity(random(4,12),0,random(2,10),1)
goto B_Fire

B_Fire:
7H36 A 0 A_GiveInventory("VivifyFlag1",1)
7H36 A 0 A_ReFire(1)
7H36 BCDEF 1
7H36 F 0 A_GiveInventory("SumoW_Fire_P1")
Goto B_FireSlam
B_FireSlam:
7H36 F 0 A_Jump(4,"B_FireStomp")
7H36 F 1 A_SpawnItemEx("SuperSlamCheck",0,0,-8,momx,momy,momz,0,8)
7H36 F 0 A_JumpIf(CallACS("core_CheckFooting"),"B_FireEnd")
7H36 F 0 A_JumpIfInventory("DecoyFlag1",1,"B_FireEnd")
7H36 F 0 A_JumpIf(momz<=0,"B_FireSlamZ")
loop
B_FireSlamZ:
7H36 F 1 A_SpawnItemEX("SuperSlamCheck",0,0,-8,momx,momy,momz,0,8)
7H36 F 0 A_JumpIf(CallACS("core_CheckFooting"),"B_FireEnd")
7H36 F 0 A_JumpIfInventory("DecoyFlag1",1,"B_FireEnd")
7H36 F 0 A_JumpIf(momz>=0,"B_FireEnd")
loop
B_FireEnd:
TNT1 A 2 A_GiveInventory("S_SumoW_Fire_P2")
TNT1 A 0 A_Jump(64,"BotRare2a")
TNT1 A 0 A_Jump(16,"BotRare1")
TNT1 A 7
7H36 GH 3
7H36 A 5
Goto BotReady

B_FireStomp:
7H36 U 0 A_PlaySound("SumoW/LeapCharge",1)
7H36 UTUTU 1 A_Stop
7H36 T 0 A_ChangeVelocity(0,0,-20,2)
B_FireStompFall:
7H36 T 1 A_ChangeVelocity(0,0,-4)
7H36 T 0 A_JumpIf(CallACS("core_CheckFooting"),"B_FireStompLand")
7H36 T 0 A_JumpIfInventory("PowerMomZVerify",1,2)
7H36 T 0 A_JumpIf(momz==0,2)
loop
7H36 T 0 A_JumpIf(momz==0,"FireStompLand")
loop
7H36 T 0 A_GiveInventory("PowerMomZVerify")
loop
B_FireStompLand:
7H36 U 0 A_GiveInventory("S_SumoW_StompLand_P")
7H36 VWX 1
7H36 B 8
7H36 C 3
7H36 A 0 A_Jump(64,"BotRare2a")
7H36 A 0 A_Jump(16,"BotRare1")
7H36 A 2
Goto BotReady

BotRare1:
7H36 F 0 A_PlaySoundEx("taunt/D_36","Voice")
7H36 F 0 A_GiveInventory("VivifyFlag2",1)
7H36 F 0 A_GiveInventory("SUBALUWAAmmo",10)
goto B_AltH

BotRare2:
7H36 F 0 A_GiveInventory("SumoW_Alt_P2")
7H36 F 0 A_TakeInventory("VivifyFlag2")
BotRare2a:
7H36 F 0 A_FaceTarget
7H36 F 0 A_PlaySoundEx("taunt/D_36","Voice")
goto BotFire+2

BotAlt:
7H36 A 0 A_GiveInventory("VivifyDelay3",1)
7H36 A 0 A_GiveInventory("VivifyFlag2",1)
7H36 A 0 A_ReFire(1)
7H36 EEFF 2
BotAlt0:
7H36 F 0 A_JumpIfInventory("SUBALUWAAmmo",14,4)
7H36 F 0 A_Jump(3,"BotRare2")
7H36 F 0 A_Jump(16,"B_Alt4")
7H36 F 0 A_Jump(48,"B_Alt3")
goto B_AltH
7H36 F 0 A_Jump(32,2)
7H36 F 0 A_Jump(128,"B_Alt4")
goto B_AltH
7H36 F 0 A_Recoil(random(-4,-12))
goto B_AltH
B_AltH:
7H36 F 2 A_GiveInventory("SumoW_AltCharge_P")
7H36 F 0 A_Refire("BotAlt0")
goto B_Alt3
B_Alt3:
7H36 F 0 A_JumpIfInventory("SUBALUWAAmmo",14,"B_Alt4")
7H36 F 1 A_GiveInventory("S_SumoW_Alt_P1")
7H36 EDCB 1
goto B_AltEnd+1
B_Alt4:
7H36 F 2 A_GiveInventory("S_SumoW_Alt_P2")
7H36 EDCB 2
goto B_AltEnd
B_AltEnd:
TNT1 A 10
TNT1 A 10 A_TakeInventory("VivifyFlag2")
7H36 GHA 2
Goto BotReady+1

}
}

actor S_SumoW_Fire_P2 : SumoW_Fire_P2
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("DecoyFlag1",1,2)
TNT1 A 0 //A_GiveInventory("S_SumoW_Flash_P")
TNT1 A 0 A_FireCustomMissile("S_RealSuperSlam",0,0,0,0)
goto End
}
}

actor S_SumoW_Alt_P1 : SumoW_Alt_P1
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("VivifyDelay4",1)
TNT1 A 0 A_TakeInventory("SUBALUWAAmmo",14,1)
TNT1 A 0 A_TakeInventory("SUBALUWAAmmo",CallACS("rz_CountInv_SUBALUWAAmmo",0)*0.5)
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWaveW_H",0,0,32,0,0,0,0,32)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
stop
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWaveW_H2",0,0,32,0,0,0,2,32)
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWaveW_H2",0,0,32,0,0,0,-2,32)
stop
}
}

actor S_SumoW_Alt_P2 : SumoW_Alt_P2
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("VivifyDelay4",1)
TNT1 A 0 A_TakeInventory("SUBALUWAAmmo",7,1)
TNT1 A 0 A_TakeInventory("SUBALUWAAmmo",7)
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWave_H",0,0,32,0,0,0,0,32)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
stop
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWave_H2",0,0,32,0,0,0,2,32)
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWave_H2",0,0,32,0,0,0,-2,32)
stop
}
}

actor S_SumoW_Flash_P : S_SumoW_Alt_P1
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("SumoWrestlerFlag")
goto S_SumoW_Alt_P1::Pickup+2
}
}

actor S_SumoW_StompLand_P : SumoW_StompLand_P
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_S_SumoWrestler",256,1)
TNT1 A 0 A_SpawnItemEx("S_SumoWrestler_FloorSlam",0,0,4)
TNT1 A 0 A_SpawnItemEx("S_SumoWrestler_FloorSlam2",0,0,0)
goto End
}
}

Actor S_RealSuperSlam : RealSuperSlam
{
Args 563,148,40//375
}

actor S_SumoW_StompWave_H : SumoW_StompWave_H
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 Radius_Quake(1,45,0,8,0)
goto SpawnL
SpawnL:
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWave",0,0,0,30,0,0,-60+Args[0]*6)
TNT1 A 0 A_CountDownArg(0)
loop
Death:
TNT1 A 0
TNT1 A 45
stop
}
}
actor S_SumoW_StompWave_H2 : S_SumoW_StompWave_H{DeathSound ""}

actor S_SumoW_StompWaveW_H : S_SumoW_StompWave_H
{
DeathSound "misc/quake"
Args 20
States
{
Spawn:
TNT1 A 0
SpawnL:
TNT1 A 0 A_SpawnItemEx("S_SumoW_StompWaveW",0,0,0,15,0,0,-60+Args[0]*6)
TNT1 A 0 A_CountDownArg(0)
loop
}
}
actor S_SumoW_StompWaveW_H2 : S_SumoW_StompWaveW_H{DeathSound ""}

actor S_SumoW_StompWave : SumoW_StompWave
{
Translation "192:192=16:16","198:198=20:20"
Damage (72)//48
}
Actor S_SumoW_StompWaveW : SumoW_StompWaveW
{
Translation "192:192=16:16"
Damage (18)//12
}


Actor S_SumoWrestler_FloorSlam : SumoWrestler_FloorSlam
{
Args 375,96,48//250
}
Actor S_SumoWrestler_FloorSlam2 : SumoWrestler_FloorSlam2
{
Args 225,16,16//150
}

actor S_SumoWrestler_FloorQuakeSpawn : SumoWrestler_FloorQuakeSpawn
{
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("S_SumoWrestler_FloorQuakeBoom",0,0,28,0,0,0,0,SXF_TRANSFERSPECIAL)
stop
}
}
actor S_SumoWrestler_FloorQuakeBoom : SumoWrestler_FloorQuakeBoom
{
MeleeRange 150//100
}




actor Lim_W_NormalBar : NormalBar {args 116, 122}

actor Lim_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Inventory.Pickupmessage "$PU_43"
  Obituary "$OB_43W"
  Tag "$TAG_Lim_W"
  weapon.ammotype "DireEnergyAmmo"
  States {
   Spawn:
    6H43 [ 6
    loop

   Deselect:
    6H43 A 0
    goto DeselectSwap
   Select:
    6H43 A 0
    goto SelectSwap

   Ready:
    6H43 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", LIM_DYE)
    6H43 A 0 A_GunFlash("Flash", 1)
    goto Ready2

   Ready1:
    6H43 A 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
    6H43 AAAAAAAAAA 2 A_WeaponReady(WRF_NOSECONDARY)
    6H43 A 0 A_GiveInventory("DireEnergyAmmo", 1)
   Ready2:
    6H43 A 35 A_WeaponReady
    6H43 A 0 A_GiveInventory("DireEnergyAmmo", 1)
    loop

   Fire:
    6H43 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H43 A 1 offset(21, 26)A_GiveInventory("Lim_Fire_P")
    6H43 A 1 offset(33, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 1 offset(45, 17)
    6H43 A 1 offset(54, 23) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 B 1 offset(63, 28)A_GiveInventory("PowerLimFiringSlow")
    6H43 B 1 offset(63, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 B 2 A_ReFire(1)
    goto FireEnd
    6H43 B 2
    6H43 B 0 A_ReFire(1)
    goto FireEnd
    6H43 B 2
    6H43 B 0 A_ReFire("FireH1")
    goto FireEnd

   FireEnd:
    6H43 A 1 offset(41, 16)A_TakeInventory("PowerLimFiringSlow")
    6H43 A 1 offset(32, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 1 offset(22, 23)
    6H43 A 1 offset(16, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 2 offset(9, 28)
    goto Ready2

   FireH1:
    6H43 K 2 offset(55, 36)A_GiveInventory("Lim_FireHold_P1")
    6H43 B 1
    6H43 B 0 A_ReFire(1)
    goto FireHEnd
    6H43 L 2 offset(63, 28)A_GiveInventory("Lim_FireHold_P2")
    6H43 B 1
    6H43 B 0 A_ReFire(1)
    goto FireHEnd
    6H43 K 2 offset(71, 36)A_GiveInventory("Lim_FireHold_P3")
    6H43 B 1
    6H43 B 0 A_ReFire(1)
    goto FireHEnd
    6H43 L 2 offset(63, 44)A_GiveInventory("Lim_FireHold_P2")
    6H43 B 1
    6H43 B 0 A_ReFire("FireH1")
    goto FireHEnd

   FireHEnd:
    6H43 B 1 offset(44, 32)
    6H43 B 1 offset(40, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 1 offset(35, 19)
    6H43 A 1 offset(27, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 1 offset(18, 25)A_TakeInventory("PowerLimFiringSlow")
    6H43 A 1 offset(13, 27) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 2 offset(7, 29)
    goto Ready2

   BotFire:
    6H43 A 0 A_JumpIfInventory("DireEnergyAmmo", 300, "BotFire2")
    6H43 A 0 A_Jump(32, "BotFire2")
    6H43 A 0 A_Jump(24, "BotFireX")
    6H43 A 4 A_GiveInventory("Lim_Fire_P")
    6H43 B 2 A_GiveInventory("DireEnergyAmmo", random(5, 15))
    6H43 B 0 A_Jump(64, 2)
    6H43 B 0 A_ReFire("BotFireH")
    6H43 BAAA 2
    goto Ready2
   BotFireH:
    6H43 K 1 A_GiveInventory("Lim_FireHold_P")
    6H43 B random(1, 2)
    6H43 L 1 A_GiveInventory("Lim_FireHold_P")
    6H43 B random(1, 2)
    6H43 B 0 A_Jump(8, "FireHEnd")
    6H43 B 0 A_Jump(2, "BotFireX")
    6H43 B 0 A_ReFire("BotFireH")
    goto FireHEnd
   BotFire2:
    6H43 A 0 A_JumpIfCloser(256, "AltFire")
    6H43 A 0 A_Jump(128, "AltFire")
    goto BotFire+2
   BotFireX:
    6H43 A 0 A_PlaySoundEx("classes/taunt/lim", "Voice")
    6H43 A 0 A_GiveInventory("RageUnitBotSpeed")
    6H43 A 0 A_GiveInventory("DireEnergyAmmo", random(50, 150))
    6H43 A 0 A_JumpIfInventory("DireEnergyAmmo", 300, "BotFire2")
    goto BotFire+3

   Flash:
    TNT1 A 1 ACS_NamedExecuteAlways("uc_LimHealth")
    loop

   AltFire:
    6H43 A 0 A_GiveInventory("Lim_AltStart_P")
    6H43 A 0 A_ReFire(1)
    6H43 A 1 Offset(21, 48)
    6H43 A 1 Offset(4, 55) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 B 1 Offset(-14, 62)
    6H43 B 1 Offset(-9, 56) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 B 1 Offset(-3, 49)
    6H43 B 1 Offset(-8, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 C 1 Offset(-13, 55)
    6H43 C 1 Offset(-8, 41) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 C 22 offset(-2, 27)
    6H43 C 0 A_TakeInventory("BasicArmor")
    goto AltCheck
   AltCheck:
    6H43 D 2 offset(-2, 27)A_GiveInventory("Lim_AltFlash_P")
    6H43 E 2 offset(-2, 27)ACS_NamedExecuteWithResult("core_weaponcolor", LIM_DYE, 1)
    6H43 C 0 A_JumpIfInventory("VivifyCycle1", 31, 2)
    6H43 C 0 A_JumpIfInventory("DireEnergyAmmo", 30, "AltCheck")
    6H43 C 2 offset(-2, 27)
    6H43 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    6H43 C 10 offset(-2, 27)A_TakeInventory("VivifyCycle1")
    6H43 B 1 Offset(8, 32)
    6H43 B 1 Offset(14, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 1 Offset(20, 23)
    6H43 A 1 Offset(14, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    6H43 A 2 Offset(8, 28)
    goto Ready1
  }
}

actor DireEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 300
  +INVENTORY.IGNORESKILL
}

Actor LimHealth : Inventory {
  inventory.amount 1
  inventory.maxamount 30000
}

Actor PowerLimFiringSlow : PowerSpeed {
  Powerup.Duration 0x7ffffffd
  Speed 0.5
  +NOTRAIL
}

actor Lim_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("LimMirrorSwipe", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_PlaySound("Lim/Swipe", 1)
    TNT1 A 0 A_SpawnItemEx("LimMirrorSwipeFX", cos(-pitch)*60, 0, 32+(sin(-pitch)*60), 0, 0, 0, 0, 1+32+512)  // SXF_TRANSFERPITCH
    stop
  }
}
actor Lim_FireHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "P1", "P2", "P3")
   P1:
    TNT1 A 0 A_FireCustomMissile("LimMirrorShot", random(3, 8), 0, 8+random(-8, -16), random(-3, 3), 1, random(-3, 3))
    goto Snd
   P2:
    TNT1 A 0 A_FireCustomMissile("LimMirrorShot", random(-1, 1), 0, 8+random(-4, 4), random(-3, 3), 1, random(-1, 1))
    goto Snd
   P3:
    TNT1 A 0 A_FireCustomMissile("LimMirrorShot", random(-8, -3), 0, 8+random(8, 16), random(-3, 3), 1, random(-3, 3))
    goto Snd
   Snd:
    TNT1 A 0 A_PlaySound("Lim/Mirror", 1)
    stop
  }
}
actor Lim_FireHold_P1 : Lim_FireHold_P {States {Pickup: goto P1}}
actor Lim_FireHold_P2 : Lim_FireHold_P {States {Pickup: goto P2}}
actor Lim_FireHold_P3 : Lim_FireHold_P {States {Pickup: goto P3}}

actor Lim_AltStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Lim_BasicArmor_P", 1)
    TNT1 A 0 A_GiveInventory("VivifyCycle1", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    TNT1 A 0 A_PlaySound("weapon/mirrorabsorb", 1)

    TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
    TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F", 5000)
    TNT1 A 0
    stop
  }
}

actor Lim_AltFlash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", LIM_DYE2, 1)
    TNT1 A 0 A_FireCustomMissile("LimAltFlash", 0, 0, 16, 14)
   End:
    TNT1 A 0 A_SpawnItemEx("LimAltFlashFX_H", 0, 16, 140+(ceilingz-z<140)*(ceilingz-z-140), 0, 0, 0, 0, 1)
    TNT1 A 0 A_GiveInventory("VivifyCycle1", 1)
    TNT1 A 0 A_TakeInventory("DireEnergyAmmo", 15, 1)  // 10
    TNT1 A 0 A_TakeInventory("DireEnergyAmmo", 15)  // 20
    TNT1 A 0 A_PlaySound("Lim/MirrorCounter", 1, 0.75)
    stop
  }
}


actor LimMirrorSwipe : BasicProjectile {
  damagetype "LimShot"
  Obituary "$OB_43M1"
  +THRUACTORS
  +DONTBLAST
  +DONTSPLASH
  RenderStyle None
  ReactionTime 1
  damage (0)
  Radius 6
  Height 6
  speed 60
  Args 165, 96, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_CountDown
    wait
   Death:
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 2
    stop
  }
}

actor LimMirrorSwipeFX : BasicExplosion {
  // Translation "192:192=116:116","198:198=122:122"
  scale 2.5
  Args 60, 0, 32
  States {
   Spawn:
    BLDH V 0
    BLDH VVWW 1 A_Warp(AAPTR_TARGET, cos(-pitch)*Args[0], Args[1], 32+(sin(-pitch)*Args[0]), 0, 24)  // WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION
    stop
  }
}

actor LimMirrorShot : BasicProjectile {
  Translation "4:4=102:102", "192:192=116:116", "198:198=122:122"
  damagetype "LimShot"
  Obituary "$OB_43M2"
  damage (random(44, 53))
  Radius 10
  Height 16
  speed 40
  scale 2.5
  States {
   Spawn:
    6P43 A 0
    6P43 ABABABCDCDCDEFEFEF 1
    stop
  }
}

actor LimAltFlash : BasicExplosion_Args {
  damagetype "LimFlash"
  Obituary "$OB_43A"
  Args 200, 416, 24
}


actor LimAltFlashFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("LimAltFlashFX", 0, 0, 0, 0, 0, 0, 0, 1+32)
    stop
  }
}

actor LimAltFlashFX : BasicClientSide {
  +FORCEXYBILLBOARD
  ReactionTime 6
  XScale 3.5
  YScale 1.75
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("LimSparkleFX", random(4, 16), random(-4, 4), random(-16, 0), frandom(26.25, 28.75), frandom(-1, 1), frandom(-4, 4), random(0, -23)*3+ReactionTime*60, 1, 32)
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_Jump(256, 1, 6)
    X_1G EFGHI 1
    stop
    X_1G JKLMN 1
    stop
  }
}

actor LimSparkleFX  // : BasicClientSide
{
  Translation "192:192=116:116", "198:198=122:122"
  // +MISSILE
  +DONTBLAST
  +DONTREFLECT
  +CLIENTSIDEONLY
  // +LOWGRAVITY
  +THRUGHOST
  +THRUACTORS
  +PAINLESS
  +DONTSPLASH
  +NOBLOCKMONST
  +SLIDESONWALLS
  +FORCEXYBILLBOARD
  damage 0
  height 2
  radius 2
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(ScaleX-frandom(0, 0.5))
    TNT1 A 0 A_Jump(256, "M4_1", "M7_1", "M9_5", "M9_7", "M10_4", "MV_1", "MV_2", "MV_5", "MV_8")
   M4_1:  // FlashStopper (C/B)
    X_4A IJKIJK 2
    stop
   M7_1:  // FreezeCracker (C/B)
    X_7A QRSQRS 2
    stop
   M9_5:  // JewelSatellite (C/B)
    X_9E UVWUVW 2
    stop
   M9_7:  // BlackHoleBomb (C/B)
    X_9H TSRTSR 2
    stop
   M10_4:  // ChillSpike (C)
    X_AD MNOMNO 2
    stop
   MV_1:  // SparkChaser (C/B) (W/C)
    X_VA X 0 A_Jump(256, 1, 7)  // 4
    X_VA XWVXWV 2
    stop
    X_VA PONPON 2
    stop
   MV_2:  // GrabBustER (W/C)
    X_VB EFGEFG 2
    stop
   MV_5:  // ElectricShock (W/C/B)
    X_VE A 0 A_Jump(64, 7)  // 4
    X_VE ABCABC 2
    stop
    X_VE HGFHGF 2
    stop
   MV_8:  // BreakDash (B)
    X_VH DCBDCB 2
    stop
  }
}

actor LimSparkleFX222 : FlashM_GenesisSparkleFX {
  Translation "192:192=116:116", "198:198=122:122"
  -BRIGHT
}

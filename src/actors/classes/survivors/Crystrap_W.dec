const int CRYSTRAP_OFFSETX = 45;
const int CRYSTRAP_OFFSETY = 2;
const int CRYSTRAP_VEL = 6;
const int CRYSTRAP_VELLOW = 2;
const int CRYSTRAP_VELHIGH = 10;

actor CrystrapShot : BasicProjectile {
  Translation "4:4=208:208", "192:192=202:202", "198:198=203:203", "202:202=208:208", "199:199=215:215"
  Obituary "$OB_65M1"
  DamageType "CrystrapStun"
  BounceSound "weapon/crystalbit"
  bouncecount 14
  +FORCEXYBILLBOARD
  +USEBOUNCESTATE
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +CANBOUNCEWATER
  +SKYEXPLODE
  bouncefactor 1.0
  wallbouncefactor 1.0
  reactiontime 75
  Damage (280)
  Height 16
  Radius 16
  Speed 24
  scale 2.5
  args 5, 32 //offset, velocity1
  States {
   Spawn:
    X_5H A 0
    //X_5H A 0 A_TakeFromTarget("CrystrapEnergyAmmo",1)
   SpawnL:
    X_5H A 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H A 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H B 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H B 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H C 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H C 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H D 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H D 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H E 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H E 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H A 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H A 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H A 0 A_GiveToTarget("CrystrapShotAlive")
    X_5H A 1 A_JumpIfInTargetInventory("CrystrapBoomFlag", 1, "Death")
    X_5H A 0 A_CountDown
    loop
   Bounce:
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, 32, 0, sin(random(0, 359))*31, random(0, 360), 1)
    goto SpawnL

   Death:
    TNT1 A 0
    TNT1 A 0 A_Stop
    TNT1 A 0 A_TakeFromTarget("CrystrapShotAlive", 1)
    TNT1 A 0 A_TakeFromTarget("CrystrapBoomFlag", 1)
    TNT1 A 1 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
    TNT1 A 0 A_JumpIf(true, "DeathSpray")

   DeathSpray:
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch)*Args[1], 0, -sin(pitch)*Args[1], 0, 1)

    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch+Args[0]*2)*Args[1], 0, -sin(pitch+Args[0]*2)*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch-Args[0]*2)*Args[1], 0, -sin(pitch-Args[0]*2)*Args[1], 0, 1)

    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch+Args[0])*Args[1], Args[0], -sin(pitch+Args[0])*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch-Args[0])*Args[1], Args[0], -sin(pitch-Args[0])*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch+Args[0]*3)*Args[1], Args[0], -sin(pitch+Args[0]*3)*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch-Args[0]*3)*Args[1], Args[0], -sin(pitch-Args[0]*3)*Args[1], 0, 1)

    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch+Args[0])*Args[1], -Args[0], -sin(pitch+Args[0])*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch-Args[0])*Args[1], -Args[0], -sin(pitch-Args[0])*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch+Args[0]*3)*Args[1], -Args[0], -sin(pitch+Args[0]*3)*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch-Args[0]*3)*Args[1], -Args[0], -sin(pitch-Args[0]*3)*Args[1], 0, 1)

    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch)*Args[1], Args[0]*2, -sin(pitch)*Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("CrystrapShotBit", 0, 0, 0, cos(pitch)*Args[1], -Args[0]*2, -sin(pitch)*Args[1], 0, 1)
    stop

   Crash:
    TNT1 A 0 A_PlaySoundEx("wep/CrystrapHit", "auto")
    stop
  }
}

actor CrystrapShotBit : BasicBouncer {
  Translation "4:4=208:208", "192:192=202:202", "198:198=203:203", "202:202=208:208", "199:199=215:215"
  damagetype "Crystrap"
  Obituary "$OB_65M2"
  SeeSound "weapon/crystalbit"
  +SKYEXPLODE
  +FORCEXYBILLBOARD
  bouncefactor 0.945
  wallbouncefactor 0.945
  reactiontime 1
  Damage(70)
  Height 9
  Radius 9
  speed 30
  States {
   Spawn:
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H FGHIJFF 4
    X_5H F 1 A_CountDown
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("ExplosionEffect1", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

actor CrystrapEyeShot : BasicBouncer {
  var int user_crystrapFlightTics;
  var int user_crystrapLifeTics;
  var int user_crystrapScanTics;
  Translation "192:192=33:33", "198:198=20:20"
  Obituary "$OB_65ME"
  DamageType "Crystrap"
  +HITTRACER
  +USEBOUNCESTATE
  Damage (0)//(82)
  Height 24
  Radius 24
  Speed 16
  bouncefactor 1.0
  wallbouncefactor 1.0
  scale 2.5
  States {
   Spawn:
    PDEV A 0
    PDEV A 0 A_SetUserVar("user_crystrapLifeTics", 100)
    PDEV A 0 A_SetUserVar("user_crystrapFlightTics", 18)
    PDEV A 0 A_SetUserVar("user_crystrapScanTics", 0)
    goto Flight

   Flight:
    PDEV A 0 A_JumpIf(user_crystrapFlightTics <= 0, "HoverEnter")
    PDEV A 0 A_SetUserVar("user_crystrapFlightTics", user_crystrapFlightTics - 1)
    PDEV A 1 A_SetUserVar("user_crystrapLifeTics", user_crystrapLifeTics - 1)
    PDEV A 0 A_JumpIf(user_crystrapLifeTics <= 0, "Death")
    goto Flight

   HoverEnter:
    PDEV A 0 A_Stop
    PDEV A 0 A_SetUserVar("user_crystrapScanTics", 0)
    goto Hover

   Hover:
    PDEV A 0 A_JumpIf(!CallACS("uh_PointerExists", AAPTR_TARGET), "Death")
    PDEV A 1 A_SetUserVar("user_crystrapLifeTics", user_crystrapLifeTics - 1)
    PDEV A 0 A_JumpIf(user_crystrapLifeTics <= 0, "Death")
    PDEV A 0 A_SetUserVar("user_crystrapScanTics", user_crystrapScanTics - 1)
    PDEV A 0 A_JumpIf(user_crystrapScanTics > 0, "HoverWait")
    PDEV A 0 A_SetUserVar("user_crystrapScanTics", 2)
    PDEV A 0 A_JumpIf(CallACS("rz_CrystrapEyeAcquire", 256), "Chase")
   HoverWait:
    goto Hover

   Chase:
    PDEV A 0 A_JumpIf(!CallACS("uh_PointerExists", AAPTR_TARGET), "Death")
    PDEV A 0 A_JumpIf(!CallACS("uh_PointerExists", AAPTR_TRACER), "HoverEnter")
    PDEV A 0 A_SeekerMissile(90, 90, SMF_PRECISE)
    PDEV A 1 A_SetUserVar("user_crystrapLifeTics", user_crystrapLifeTics - 1)
    PDEV A 0 A_JumpIf(user_crystrapLifeTics <= 0, "Death")
    goto Chase

   Bounce:
    PDEV A 0 A_JumpIf(user_crystrapLifeTics <= 0, "Death")
    PDEV A 0 A_JumpIf(user_crystrapFlightTics > 0, "Flight")
    PDEV A 0 A_JumpIf(CallACS("uh_PointerExists", AAPTR_TRACER), "Chase")
    goto HoverEnter

   Crash:
    PDEV A 0 A_JumpIf(!CallACS("uh_istracerplayer"), "Death")
    PDEV A 0 ACS_NamedExecuteAlways("rz_CrystrapSpying", 0, CallACS("core_getptrtid", 2), CallACS("core_getptrtid", 8))
   Death:
    PDEV A 0 A_PlaySoundEx("weapon/wrapfire", "Weapon")
    PDEV AAAA 0 A_SpawnItemEx("CrystrapEyeShotBitBitFX", 0, 0, 0, random(-4, 4), random(-4, 4), random(6, 12), random(0, 359), 1)
    stop
  }
}


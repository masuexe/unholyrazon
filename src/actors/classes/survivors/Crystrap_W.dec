const int CRYSTRAP_RAPIDSHOTOFFSET = 24;

actor Crystrap_W_NormalBar : NormalBar {Args 4, 96}
actor Crystrap_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_22"
  Obituary "$OB_65W"
  Tag "$TAG_Crystrap_W"
  weapon.ammotype "CrystrapCharge"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H60 [ 6
    loop

   Deselect:
    6H60 A 0
    goto DeselectSwap
   Select:
    6H60 A 0
    goto SelectSwap

   Ready:
    6H60 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CRYSTRAP_DYE)
    goto Ready2
   Ready2:
    6H60 A 1 A_WeaponReady(16)
    loop

   Fire:
    //6H60 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
    6H60 C 0 A_JumpIfInventory("CrystrapShotAlive", 1, "Detonate")
    6H60 B 1
    goto Hold
   FireWeak:
    6H60 C 0 A_TakeInventory("CrystrapCharge", 16, 1)
    6H60 C 0 A_TakeInventory("CrystrapCharge", 16)
    6H60 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8, 0)
    6H60 CB 2
    6H60 A 6
    Goto Ready2
   FireR:
    6H60 C 0 A_TakeInventory("CrystrapCharge", 16, 1)
    6H60 C 0 A_TakeInventory("CrystrapCharge", 16)
    6H60 C 0 A_TakeInventory("CrystrapRapidShotFlag")
    6H60 C 2 Offset(24, 44) A_GiveInventory("Crystrap_Fire_P")
    6H60 C 2 Offset(48, 64)
    6H60 C 2 Offset(44, 64)
    6H60 B 2 Offset(36, 56)
    6H60 B 2 Offset(16, 40)
    6H60 B 2 Offset(8, 32)
    Goto Ready2
   FireRapid:
    6H60 C 0 A_TakeInventory("CrystrapRapidShotFlag")
   FireRapidLoop:
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2, 1)
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2)
    6H60 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8+CRYSTRAP_RAPIDSHOTOFFSET*sqrt(2), 0)
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8-CRYSTRAP_RAPIDSHOTOFFSET*sqrt(2), 0)
    6H60 BA 2
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2, 1)
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2)
    6H60 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8+CRYSTRAP_RAPIDSHOTOFFSET, CRYSTRAP_RAPIDSHOTOFFSET)
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8-CRYSTRAP_RAPIDSHOTOFFSET, -CRYSTRAP_RAPIDSHOTOFFSET)
    6H60 BA 2
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2, 1)
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2)
    6H60 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8, CRYSTRAP_RAPIDSHOTOFFSET*sqrt(2))
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8, -CRYSTRAP_RAPIDSHOTOFFSET*sqrt(2))
    6H60 BA 2
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2, 1)
    6H60 A 0 A_TakeInventory("CrystrapCharge", 2)
    6H60 C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire", "Weapon")
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8+CRYSTRAP_RAPIDSHOTOFFSET, -CRYSTRAP_RAPIDSHOTOFFSET)
    6H60 C 0 A_FireCustomMissile("CrystrapShotBit", 0, 0, 8-CRYSTRAP_RAPIDSHOTOFFSET, CRYSTRAP_RAPIDSHOTOFFSET)
    6H60 BA 2
    6H60 A 0 A_JumpIfInventory("CrystrapCharge", 1, "FireRapidLoop")
    Goto Ready2

   Hold:
    6H60 B 0 A_JumpIfInventory("CrystrapCharge", 0, "Hold2")
    6H60 B 1 A_GiveInventory("CrystrapCharge", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H60 B 0 A_Refire
    goto FireWeak
   Hold2:
    6H60 C 0 A_JumpIfInventory("CrystrapRapidShotFlag", 1, "FireRapid")
    6H60 C 0 A_GiveInventory("CrystrapRapidShotFlag", 1)
    6H60 C 1 A_WeaponReady(6)
    6H60 C 0 A_TakeInventory("CrystrapRapidShotFlag", 1)
    6H60 C 0 A_Refire("Hold2")
    Goto FireR

   Detonate:
    6H60 C 0 A_PlaySoundEx("Pokemon/Detect", "Weapon")
    6H60 D 0 A_GiveInventory("CrystrapBoomFlag")
    6H60 DED 2
    6H60 A 8
    Goto Ready2

   BotFire:
    6H60 C 2 //A_GiveInventory("Crystrap_BotFire_P")
    6H60 B 2
    6H60 A 0 A_Refire("BotFire")
    Goto Ready2

   AltFire:
    6H60 C 0 A_JumpIfInventory("CrystrapRapidShotFlag", 1, "FireRapid")
    //6H60 C 0 A_JumpIfInventory("CrystrapCooldown",1,"No")
    //6H60 C 0 A_JumpIfInventory("CrystrapEyeExists",1,"AltDetonate")
    6H60 C 0 A_JumpIfInventory("CrystrapSpyingTID", 1, "LookTheEye")
    6H60 C 16 A_GiveInventory("Crystrap_Alt_P")
    6H60 B 8
    6H60 A 8
    Goto Ready2
   LookTheEye:
    6H60 A 2 A_GiveInventory("Crystrap_Spying_P")
    6H60 A 0 A_ReFire("NoAltHold")
    Goto Ready2
   NoAltHold:
    6H60 A 1
    6H60 A 0 A_Refire("NoAltHold")
    goto Ready2

    // AltDetonate:
    // 6H60 C 0 A_PlaySoundEx("Pokemon/Detect","Weapon")
    // 6H60 D 0 A_SpawnItemEx("CrystrapDetonator")
    // 6H60 C 0 A_TakeInventory("CrystrapEyeExists")
    // 6H60 C 0 A_TakeInventory("CrystrapIsLookingOnHisEye",1)
    // 6H60 DEDA 2
    // 6H60 A 8
    // Goto Ready2
   No:
    6H60 C 0
    Goto Ready2

   AltFireRapid:
    6H60 A 1 A_GiveInventory("CrystrapRapidShotFlag")
    goto Ready2

   Reload:
    6H60 A 1 A_GiveInventory("Crystrap_Reload_P")
    goto ReReloadLoop
   ReReloadLoop:
    6H60 A 1
    6H60 A 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_RELOAD), "Ready2")
    loop
  }
}

actor CrystrapCharge : Ammo {
  inventory.maxamount 32
  +INVENTORY.IGNORESKILL
}

actor CrystrapCooldown : Inventory {
  inventory.amount 1
  inventory.maxamount 30
}

actor CrystrapShotAlive : Powerup {
  Powerup.duration 7
}
actor CrystrapBoomFlag : UOnce {}
//actor CrystrapEyeExists : Powerup
//{
//Powerup.duration 7
//}
//actor CrystrapEyeBoomFlag : UOnce {}
actor CrystrapIsSpyingOnYou : UOnce {}
actor CrystrapSpyingTID : Inventory {
  inventory.maxamount 1063
}
actor CrystrapIsLookingOnHisEye : UOnce {}

actor CrystrapRapidShotFlag : UOnce {}

actor PowerCrystrapStun : PowerSpeed {
  +PowerSpeed.NoTrail
  Powerup.Duration -2
  Speed 0.0
}

actor Crystrap_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("CrystrapShotAlive")
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/crystaleyefire", "Weapon") //Pokemon/Detect
    TNT1 A 0 A_JumpIf(true, "PickupFire")
   PickupFire:
    TNT1 A 0 A_FireCustomMissile("CrystrapShot", 0, 0, 8, 0)
    // TNT1 A 0 A_PlaySound("wep_L/CrystrapPew", 1, 0.9)//weapon/mbuster
    stop
  }
}
actor Crystrap_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("weapon/crackerthrow", 1)
    TNT1 A 0 A_FireCustomMissile("CrystrapEyeShot", 0, 0, 8, 0)
    stop
  }
}
actor Crystrap_Spying_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CrystrapIsLookingOnHisEye", 1, "LookMyself")
    TNT1 A 0 ChangeCamera(CallACS("rz_CountInv_CrystrapSpyingTid"), 0, 0)
    TNT1 A 0 A_GiveInventory("CrystrapIsLookingOnHisEye")
    stop
   LookMyself:
    TNT1 A 0 ChangeCamera(0, 0, 0)
    TNT1 A 0 A_TakeInventory("CrystrapIsLookingOnHisEye")
    stop
  }
}
actor Crystrap_Reload_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("item/ItemUseMM9", "Item")
    TNT1 A 0 ChangeCamera(0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_CrystrapSpyingReset")
    /*TNT1 A 0 A_JumpIfInventory("CrystrapEyeExists",1,"LookTheEye") stop
    LookTheEye:
    TNT1 A 0 A_JumpIfInventory("CrystrapIsLookingOnHisEye",1,"LookMyself")
    TNT1 A 0 ChangeCamera(300+TID,0,0)
    TNT1 A 0 A_GiveInventory("CrystrapIsLookingOnHisEye",1)
    stop
    LookMyself:
    TNT1 A 0 ChangeCamera(0,0,0)
    TNT1 A 0 A_TakeInventory("CrystrapIsLookingOnHisEye",1)
    stop*/
    stop
  }
}
actor Crystrap_Reload_Decoy_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CrystrapSpyingTID", 1, 1)
    stop
    TNT1 A 0 A_PlaySoundEx("item/ItemUseMM9", "Item")
    TNT1 A 0 ChangeCamera(0, 0, 0)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_CrystrapSpyingReset")
    stop
  }
}

actor CrystrapCooldownTimer : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("CrystrapCooldown", 1, 1)
    goto Death
    TNT1 A 1 A_TakeFromTarget("CrystrapCooldown", 1)
    loop
   Death:
    TNT1 A 0
    stop
  }
}


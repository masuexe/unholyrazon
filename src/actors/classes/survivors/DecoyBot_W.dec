actor Decoy_F_04A : MistressCopyVision {
  ReactionTime 56
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    1H50 A 1
    TNT1 A 1
    1H50 A 1
    TNT1 A 1
    1H50 A 1
    TNT1 A 1
    goto Waiting
   Waiting:
    1H50 F 1 A_GiveToTarget("UH_TargetMarker", 1)
    1H50 F 0 A_JumpIfInTargetInventory("BusterMistressFiredFlag", 1, "FireTime")
    1H50 F 0 A_CountDown
    loop
   FireTime:
    1H50 G 0 ACS_NamedExecuteWithResult("core_aimattargetcursor", CallACS("core_gettarget") + PLN_TARGETPOINT_OFFSET, 32)
    1H50 G 0 A_PlaySoundEx("weapon/minchrgshot", 4)
    1H50 G 0 A_SpawnItemEx("Decoy_F_04", cos(-pitch) * 8, 0, 32 + (sin(-pitch) * 8), cos(-pitch), 0, sin(-pitch), Random(-2, 2), SXF_MULTIPLYSPEED)  // 8192
    TNT1 A 2 A_SpawnItemEx("Decoy_F_04A_FX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Death:
    1H50 H 0 A_SpawnItemEx("Decoy_F_04A_FX2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor Decoy_F_04A_FX : BasicClientSide {
  +BRIGHT
  +MISSILE
  RenderStyle "Translucent"
  Alpha 0.70
  Speed 45
  Scale 2.5
  States {
   Spawn:
    1H50 G 5
    1H50 GGGFFFF 1 A_Fadeout
    stop
  }
}
actor Decoy_F_04A_FX2 : Decoy_F_04A_FX {States {Spawn: 1H50 HHHHHHHH 1 A_Fadeout stop}}



actor DecoyBotDebugItem : CustomInventory {
  inventory.pickupmessage "Decoy Weapon Cycler"
  Inventory.Icon "UMUG_S50"
  inventory.PickupSound "WilyWar/Snd_37"
  +COUNTITEM
  +INVBAR
  Scale 1.0
  States {
   Spawn:
    7H50 "[" 4
    wait
   Use:
    TNT1 A 0 A_PlaySoundEx("KirbyNES/CranePoints", "Item")
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag1", CallACS("uh_CountDecoyBotSlots") - 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag1", 1)
    goto Use2
    TNT1 A 0 A_TakeInventory("DecoyBotFlag1", CallACS("uh_CountDecoyBotSlots") - 1)
    goto Use2
   Use2:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag2", CallACS("uh_CountDecoyBotSlots") - 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag2", 1)
    goto Use3
    TNT1 A 0 A_TakeInventory("DecoyBotFlag2", CallACS("uh_CountDecoyBotSlots") - 1)
    goto Use3
   Use3:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag3", CallACS("uh_CountDecoyBotSlots") - 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag3", 1)
    fail
    TNT1 A 0 A_TakeInventory("DecoyBotFlag3", CallACS("uh_CountDecoyBotSlots") - 1)
    fail
  }
}


actor DecoyBotFlagBase_P : CustomInventory {
  States {
   Ready0:
    TNT1 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, "Ready2")
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    stop
   Ready1:
    TNT1 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
   Ready2:
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    stop
   Ready3:
    TNT1 A 0 A_WeaponReady
    stop
  }
}


// 200  68  71  77  78
// 192:192=68:68, 198:198=78:78, 41:41=71:71

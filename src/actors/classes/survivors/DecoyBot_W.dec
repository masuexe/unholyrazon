// This file is a 50 in 1 bootleg game
actor DecoyBot_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_50_A"
  Obituary "$OB_50W1"
  Tag "$TAG_DecoyBot_W"
  Weapon.AmmoType "DecoyEnergyAmmo"
  Weapon.AmmoType2 "FlukyNumberAmmo"
  Inventory.Icon "C_I_50A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H50 [ 6
    loop

   Deselect:
    6H50 A 0 A_JumpIfInventory("UH_MoveHud_F", 1, "DeselectInstant")
    goto DeselectSwap
   DeselectInstant:
    TNT1 A 0 Offset(1, 128) A_Lower
   Select:
    6H50 A 0 A_JumpIfInventory("UH_SilentSelect_F", 1, "SilentSelect")
    goto SelectSwap
   SilentSelect:
    6H50 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveTake")
    6H50 A 0 A_StopSound(CHAN_WEAPON)
    6H50 A 0 A_TakeInventory("UH_SilentSelect_F")
    6H50 A 0 A_TakeInventory("NoWeaponSwitchSound")
    6H50 A 0 A_TakeInventory("UH_MoveHud_F")
    6H50 A 0 A_WeaponReady(14)
    goto Ready2

   Ready:
    6H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, CLRF_GRAVITYWARN)
    6H50 A 0  // A_GiveInventory("DecoyBotFlagResync_P")
    goto Ready2
   Ready2:
    6H50 A 2 A_GiveInventory("DecoyBot_WepReady1_P")
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", 3)
    6H50 A 0 A_GiveInventory("FlukyNumberAmmo", 1)
    loop

   AltFire:
    6H50 D 0 A_GiveInventory("DecoyBotAlt_P")
    6H50 DDAADD 1 A_RailWait
    6H50 A 0  // A_SetArg(4,CallACS("uc_DecoyBotFetchFlag",1))
    6H50 AADDAA 1
    goto Ready2

   BotFire:
    "####" A 0 A_JumpIfInventory("DecoyBotFlagBot", 30, "BotFire1")
    "####" A 0 A_Jump(16, "BotFire2")
    "####" A 0 A_GiveInventory("DecoyBotFlagBot", 1)
    "####" A 0 A_GiveInventory("DecoyEnergyAmmo", random(1, 49))
    goto Fire+1
   BotFire1:
    "####" A 0 A_Jump(96, "BotFire2")
    "####" A 0 A_GiveInventory("DecoyEnergyAmmo", random(40, 100))
    goto Fire+1
   BotFire2:
    "####" A 0 A_TakeInventory("DecoyBotFlagBot")
    // "####" A 0 A_GiveInventory("DecoyBotFlagRNG_P")
    "####" A 0 A_GiveInventory("DecoyEnergyAmmo", 200)
    "####" A 0 A_PlaySoundEx("classes/taunt/decoybot", "Voice")
    goto AltFire
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H50 A 0
    goto Ready2
  }
}


actor DecoyB_F_P59 : DB__CI {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("Isaac/tearfire", "Weapon")
    TNT1 A 0 A_Jump(40, "FireIpecac")
    TNT1 A 0 A_Jump(40, "FireGodhead")
    TNT1 A 0 A_Jump(28, "FireCSection")
    goto FireNormal
   FireNormal:
    TNT1 A 0 A_FireCustomMissile("Decoy_F_59A", random(-1, 1), 0, 8, 0, 1, random(-1, 1))
    stop
   FireIpecac:
    TNT1 A 0 A_FireCustomMissile("Decoy_F_59B", random(-1, 1), 0, 8, 0, 1, random(1, 3))
    stop
   FireGodhead:
    TNT1 A 0 A_FireCustomMissile("Decoy_F_59C", random(-1, 1), 0, 8, 0, 1, random(-1, 1))
    stop
   FireCSection:
    TNT1 A 0 A_FireCustomMissile("Decoy_F_59D", random(-1, 1), 0, 8, 0, 1, random(-1, 1))
    stop
  }
}


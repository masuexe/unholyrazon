}

actor DecoyBotFlagCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, "BotPickup")
    goto P_Check
   P_Check:
    TNT1 A 0 ACS_NamedExecuteWithResult("uc_DecoyBotWepSwap", 60)
    stop
   P_CheckOld:  // Checks for Loadout CVar and gives DecoyBotFlag123
    TNT1 A 0 ACS_NamedExecuteWithResult("uc_DecoyBotCvarLoadout", 60)
    stop
   BotPickup:
    TNT1 A 0 A_GiveInventory("DecoyBotFlagRNG_P")
    stop
  }
}

actor DecoyBotFlagRNG_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DecoyBotFlag1")
    TNT1 A 0 A_TakeInventory("DecoyBotFlag2")
    TNT1 A 0 A_TakeInventory("DecoyBotFlag3")
    // Count may still be 0 before UH_COPYDEFS OPEN; fall back to vanilla max 60.
    TNT1 A 0 A_JumpIf(CallACS("uh_CountDecoyBotSlots") > 0, "RollLive")
    TNT1 A 0 A_GiveInventory("DecoyBotFlag1", random(0, 60))
    TNT1 A 0 A_GiveInventory("DecoyBotFlag2", random(0, 60))
    TNT1 A 0 A_GiveInventory("DecoyBotFlag3", random(0, 60))
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_DecoyBotApplyHeldWeps")
    stop
   RollLive:
    TNT1 A 0 A_GiveInventory("DecoyBotFlag1", random(0, CallACS("uh_CountDecoyBotSlots") - 1))
    TNT1 A 0 A_GiveInventory("DecoyBotFlag2", random(0, CallACS("uh_CountDecoyBotSlots") - 1))
    TNT1 A 0 A_GiveInventory("DecoyBotFlag3", random(0, CallACS("uh_CountDecoyBotSlots") - 1))
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_DecoyBotApplyHeldWeps")
    stop
  }
}

actor DecoyBotAlt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("misc/gravitywarn", 1)
    TNT1 A 0 A_TakeInventory("FlukyNumberAmmo", 50, 1)
    TNT1 A 0 A_TakeInventory("FlukyNumberAmmo", 50)
    TNT1 A 0 A_GiveInventory("DecoyBotFlagCheck_P")
    stop
  }
}

actor DecoyBotFlag1Adjust_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("misc/gravitywarn", 1)
    TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_ATTACK, "P_Take")  // Check if Mainfire is held
    TNT1 A 0 A_Jump(256, "P_Give")
    stop
   P_Give:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag1", CallACS("uh_CountDecoyBotSlots") - 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag1", 1)
    stop
    TNT1 A 0 A_TakeInventory("DecoyBotFlag1", CallACS("uh_CountDecoyBotSlots") - 1)
    stop
   P_Take:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag1", 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag1", CallACS("uh_CountDecoyBotSlots") - 1)
    stop
    TNT1 A 0 A_TakeInventory("DecoyBotFlag1", 1)
    stop
  }
}

actor DecoyBotFlag2Adjust_P : DecoyBotFlag1Adjust_P {
  States {
   P_Give:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag2", CallACS("uh_CountDecoyBotSlots") - 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag2", 1)
    stop
    TNT1 A 0 A_TakeInventory("DecoyBotFlag2", CallACS("uh_CountDecoyBotSlots") - 1)
    stop
   P_Take:
    TNT1 A 0 A_JumpIfInventory("DecoyBotFlag2", 1, 2)
    TNT1 A 0 A_GiveInventory("DecoyBotFlag2", CallACS("uh_CountDecoyBotSlots") - 1)
    stop
    TNT1 A 0 A_TakeInventory("DecoyBotFlag2", 1)
    stop
  }
}

actor DecoyBotFlag3Adjust_P : DecoyBotFlag1Adjust_P {

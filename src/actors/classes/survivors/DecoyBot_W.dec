actor Decoy_F_55 : WispCutter
{
Obituary "$OB_50M1"
States
{
Spawn:
6P50 E 0
6P50 E 0 A_RearrangePointers(AAPTR_DEFAULT,AAPTR_DEFAULT,AAPTR_TARGET)
goto SpawnL+1
SpawnL:
6P50 EE 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 EF 1 A_GiveInventory("WispCutterChecker_P")
6P50 GG 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 GH 1 A_GiveInventory("WispCutterChecker_P")
6P50 EE 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 EF 1 A_GiveInventory("WispCutterChecker_P")
6P50 G 0 A_GiveInventory("WispCutterVelocity_P")
6P50 G 0 A_JumpIf(Args[4]>4,"SpawnL2")
6P50 GG 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 GH 1 A_GiveInventory("WispCutterChecker_P")
6P50 EE 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 EF 1 A_GiveInventory("WispCutterChecker_P")
6P50 GG 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 GH 1 A_GiveInventory("WispCutterChecker_P")
6P50 E 0 A_GiveInventory("WispCutterVelocity_P")
6P50 E 0 A_JumpIf(Args[4]>4,"SpawnL2")
loop
SpawnL2:
6P50 II 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 IJ 1 A_GiveInventory("WispCutterChecker_P")
6P50 KK 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 KL 1 A_GiveInventory("WispCutterChecker_P")
6P50 II 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 IJ 1 A_GiveInventory("WispCutterChecker_P")
6P50 K 0 A_GiveInventory("WispCutterVelocity_P")
6P50 KK 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 KL 1 A_GiveInventory("WispCutterChecker_P")
6P50 II 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 IJ 1 A_GiveInventory("WispCutterChecker_P")
6P50 KK 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),0,0,frandom(0,3),0,1,32)
6P50 KL 1 A_GiveInventory("WispCutterChecker_P")
6P50 I 0 A_GiveInventory("WispCutterVelocity_P")
loop

Death:
TNT1 A 0 A_GiveToTarget("DecoyEnergyAmmo",44)
TNT1 A 1 A_PlaySound("weapon/CutterCatch",1,0.75)
stop
}
}

TNT1 A 0 A_JumpIfInventory("DecoyBotFlag1",58,2)
TNT1 A 0 A_GiveInventory("DecoyBotFlag1",1)
stop
TNT1 A 0 A_TakeInventory("DecoyBotFlag1",58)
stop
P_Take:

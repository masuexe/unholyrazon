actor DecoyEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor FlukyNumberAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor DecoyBotFlag1 : Inventory
{
inventory.amount 1
inventory.maxamount 58
+INVENTORY.KEEPDEPLETED
}

actor DecoyBotFlag2 : DecoyBotFlag1 {}
actor DecoyBotFlag3 : DecoyBotFlag1 {}

actor DecoyBotFlagBot : Inventory
{
inventory.amount 1
inventory.maxamount 30
}

actor DecoyCharge_F47 : Inventory
{
inventory.amount 1
inventory.maxamount 100
}


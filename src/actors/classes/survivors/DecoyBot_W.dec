actor DecoyB_F_P52 : DB__CI {States {Pickup:
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "A3")
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "A2")
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52A", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52FX_H1", 0, 0, 0, -4)
    goto Snd1
    A2:
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52C", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52FX_H3", 0, 0, 0, -4)
    goto Snd2
    A3:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, 1)
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52E", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52G_H", -20, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("Decoy_F_52FX_H5", 0, 0, 0, -4)
    goto Snd3
    Snd1:
    TNT1 A 0 A_PlaySound("KirbyNES/InsertFlag", 1)
    goto End
    Snd2:
    TNT1 A 0 A_PlaySound("KirbyNES/WepSwing", 1)
    goto End
    Snd3:
    TNT1 A 0 A_PlaySound("KirbyNES/Fireball", 1)
    goto End
    End:
    TNT1 A 0 A_SpawnItemEx("AmberBroomBlock", cos(-pitch) * 36, 0, 11 + sin(-pitch) * 36, 0, 0, 0, 0, 32 + SXF_TRANSFERPITCH)  // 512
    stop}}

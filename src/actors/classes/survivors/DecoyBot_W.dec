actor Decoy_F_12_H : AncientIce_H2 {
  States {
   Spawn:
    TNT1 A 0 nodelay A_SpawnItemEx("Decoy_F_12A", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Up
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("Decoy_F_12A", 50 * args[4], -50 * args[4] + 50 * args[1], 0, 0, 0, 0, 45 * 1, 1)
    TNT1 A 0 A_SpawnItemEx("Decoy_F_12A", 50 * args[4], -50 * args[4] + 50 * args[1], 0, 0, 0, 0, 45 * 3, 1)
    TNT1 A 0 A_SpawnItemEx("Decoy_F_12A", 50 * args[4], -50 * args[4] + 50 * args[1], 0, 0, 0, 0, 45 * 5, 1)
    TNT1 A 0 A_SpawnItemEx("Decoy_F_12A", 50 * args[4], -50 * args[4] + 50 * args[1], 0, 0, 0, 0, 45 * 7, 1)
    TNT1 A 0 A_CountDownArg(1)
    TNT1 A 0 A_JumpIf(args[1] < 1, "Up")
    loop
  }
}

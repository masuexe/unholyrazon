    P2: TNT1 A 0 A_FireCustomMissile("Decoy_F_43B", random(-1, 1), 0, 8 + random(-4, 4), random(-3, 3), 1, random(-1, 1)) goto Snd
    P3: TNT1 A 0 A_FireCustomMissile("Decoy_F_43B", random(-8, -3), 0, 8 + random(8, 16), random(-3, 3), 1, random(-3, 3)) goto Snd
    Snd: TNT1 A 0 A_PlaySound("Lim/Mirror", 1) stop}}

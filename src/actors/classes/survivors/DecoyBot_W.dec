actor Decoy_F_59A : BasicProjectile {
  Translation "192:192=[185,207,252]:[185,207,252]", "198:198=[132,171,249]:[132,171,249]"
  DamageType "Eden"
  Obituary "$OB_50M1"
  -NOGRAVITY
  +SKYEXPLODE
  Damage (random(24, 30))
  Radius 8
  Height 8
  Gravity 0.25
  Speed 36
  States {
   Spawn:
    ISTR F 1
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("Isaac/splatter", "Weapon")
    ISBR ABCDEFGHIJKLMNO 1
    stop
  }
}


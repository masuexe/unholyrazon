actor PartyBomber : CustWepClassBase {
  Player.ScoreIcon "UMUG_39"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "PartyBomber"
  Player.SoundClass "PartyBomber"
  Player.MaxHealth 850
  Health 850
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "PartyBomber_W"
  Player.StartItem "PartyPowerAmmo", 75
  States {
   Spawn:
    1H39 A 0
    1H39 B 1
    1H39 A 1
    goto Spawn+2
   See:
    1H39 BCDE 5
    goto Spawn
   Missile:
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 1, "MissileDash")
    1H39 FFFFF 1 A_JumpIfInventory("VivifyDelay6", 1, "MissileDash2")
    1H39 G 4
    goto Spawn+2

   MissileDash:
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 9, "D_Run_F")
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 8, "D_Run_E")
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 6, "D_Run_D")
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 4, "D_Run_C")
    1H39 F 0 A_JumpIfInventory("VivifyCycle2", 1, "D_Run_B")
    1H39 "###" 1 A_JumpIfInventory("VivifyDelay6", 1, "MissileDash2")
    1H39 GG 4
    goto Spawn
   MissileDash2:
    1H39 H 10
    goto Spawn+2

   D_Run_B:
    1H39 B 1
    goto MissileDash+5
   D_Run_C:
    1H39 C 1
    goto MissileDash+5
   D_Run_D:
    1H39 D 1
    goto MissileDash+5
   D_Run_E:
    1H39 E 1
    goto MissileDash+5
   D_Run_F:
    1H39 E 0 A_TakeInventory("VivifyCycle2", 8)
    goto D_Run_E


   ClassPain:
    1H39 H 0 A_Jump(256, "H", "I", "J", "K", "L")
    goto H
   H:
    1H39 H 0
    goto MegamanPain
   I:
    1H39 I 0
    goto MegamanPain
   J:
    1H39 J 0
    goto MegamanPain
   K:
    1H39 K 0
    goto MegamanPain
   L:
    1H39 L 0
    goto MegamanPain

   TimeFix:
    1H39 MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 1 A_Stop
    goto Pain

   ClassDeath:  // 19 tics
    1H39 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H39 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H39 H 0 A_Jump(256, "H2", "I2", "J2", "K2", "L2")
    goto H2
   H2:
    1H39 H 0
    goto DeathContinue
   I2:
    1H39 I 0
    goto DeathContinue
   J2:
    1H39 J 0
    goto DeathContinue
   K2:
    1H39 K 0
    goto DeathContinue
   L2:
    1H39 L 0
    goto DeathContinue
   DeathContinue:
    1H39 "#" 1
    1H39 "#" 0 A_PlaySound("*death", 2)  //
    1H39 "#" 2
    1H39 "#" 0 A_PlaySound("PartyBomber/Death", 2)  //
    1H39 "#" 15
    1H39 "#" 0 A_SpawnItemEx("PartyBomberExplosionDeath2", random(-50, 50), random(-48, -8), random(16, 64), 0, 0, 0, 0, 1)
    1H39 "#" 0 A_SpawnItemEx("PartyBomberExplosionDeath2", random(-50, 50), random(8, 48), random(16, 64), 0, 0, 0, 0, 1)
    1H39 "#" 0 A_SpawnItemEx("PartyBomberExplosionDeath", random(8, 32), random(-8, 8), random(32, 48), 0, 0, 0, 0, 1)
    1H39 "#" 1 A_SetTranslucent(0.0, 0)
    goto MegamanErase
   MegamanDisintegrate:
    1H39 Z 0 A_SpawnItemEx("Corpse_39", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor PartyBomberShiny : PartyBomber {
  Player.ScoreIcon "UMUG_S39"
  Player.MaxHealth 2850
  Health 2850
  Player.ForwardMove 0.9, 0.9
  Player.SideMove 0.9, 0.9
  Player.JumpZ 13
  Player.MorphWeapon "PartyBomberShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    // note for future: get blue/cyan versions of extra pain frames
    1H39 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H39 H 0 A_PlaySound("*death", 2)  //
    1H39 H 2
    1H39 H 0 A_PlaySound("PartyBomber/Death", 2)  //
    1H39 H 15
    1H39 H 0 A_SpawnItemEx("PartyBomberExplosionDeath2", random(-50, 50), random(-48, -8), random(16, 64), 0, 0, 0, 0, 1)
    1H39 H 0 A_SpawnItemEx("PartyBomberExplosionDeath2", random(-50, 50), random(8, 48), random(16, 64), 0, 0, 0, 0, 1)
    1H39 H 0 A_SpawnItemEx("PartyBomberExplosionDeath", random(8, 32), random(-8, 8), random(32, 48), 0, 0, 0, 0, 1)
    1H39 H 1 A_SetTranslucent(0.0, 0)
    goto MegamanErase
  }
}



actor PartyBomberExplosionDeath : BasicExplosion {
  ActiveSound "misc/partyball"
  DamageType "PartyBomber"
  Obituary "$OB_39D"
  Scale 3.0
  Args 125, 256, 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ActiveSound
    TNT1 AA 0 A_SpawnItemEx("PartyBomberExplosionDeathFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom1FX_XA", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}
actor PartyBomberExplosionDeath2 : PartyBomberExplosionDeath {ActiveSound ""}

actor S_PartyBomberExplosionDeath : PartyBomberExplosionDeath {
  Args 188, 256, 16
}
actor S_PartyBomberExplosionDeath2 : S_PartyBomberExplosionDeath {ActiveSound ""}

actor PartyBomberExplosionDeathFX_H : BasicClientSide {
  ReactionTime 10
  States {
   Spawn:
    TNT1 A 1
    TNT1 AAA 0 A_SpawnItemEx("BasicConfettiFX", random(4, 16), random(-4, 4), random(8, 16), frandom(6.25, 8.75), frandom(-1, 1), frandom(-3, 3), random(0, 23) * 15, 1)
    TNT1 A 0 A_CountDown
    loop
  }
}

actor Corpse_39 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_39_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_39_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_39_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_39_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_39_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_39_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_39_0 : BaseCorpseFX {States {Spawn: 1H39 O 350
    goto Spawn2}}
actor Corpse_39_1 : BaseCorpseFX {States {Spawn: 1H39 P 350
    goto Spawn2}}
actor Corpse_39_2 : BaseCorpseFX {States {Spawn: 1H39 Q 350
    goto Spawn2}}
actor Corpse_39_3 : BaseCorpseFX {States {Spawn: 1H39 R 350
    goto Spawn2}}
actor Corpse_39_4 : BaseCorpseFX {States {Spawn: 1H39 S 350
    goto Spawn2}}
actor Corpse_39_5 : BaseCorpseFX {States {Spawn: 1H39 T 350
    goto Spawn2}}

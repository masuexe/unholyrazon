actor TidalManiac : CustWepClassBase {
  player.scoreIcon "UMUG_37"
  player.displayname "TidalManiac"
  player.soundclass "TidalManiac"
  Player.Maxhealth 900
  health 900
  player.forwardmove 0.9, 0.9
  player.sidemove 0.9, 0.9
  player.jumpz 10
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "TidalManiac_W"
  player.startitem "TidalManiac_W2"
  player.startitem "TideEnergyAmmo", 70
  player.startitem "FlowEnergyAmmo", 140

  player.weaponslot 1, "TidalManiac_W"
  player.weaponslot 2, "TidalManiac_W2"
  States {
   Spawn:
    WAVM A 0
    WAVM B 1
    WAVM A 1
    Goto Spawn+2
   See:
    WAVM BCDE 5
    Goto Spawn
   Missile:
    WAVM G 7
    WAVM F 5
    goto Spawn+2
   ClassPain: WAVM H 0
    Goto MegamanPain

   ClassDeath:
    WAVM H 0
    goto MegamanDeath
   MegamanDeath0:
    WAVM H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    WAVM H 0 A_SpawnItemEx("TidalPillarDeath", 0, 0, 8, 0, 0, 0, 0, 1)
    Goto MegamanFade3
   MegamanDisintegrate:
    WAVM Z 0 A_SpawnItemEx("Corpse_37", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TidalManiacShiny : TidalManiac {
  player.scoreIcon "UMUG_S37"
  Player.Maxhealth 2900
  health 2900
  player.forwardmove 0.95, 0.95
  player.sidemove 0.95, 0.95
  player.jumpz 11
  player.morphweapon "TidalManiacShiny_W"
  player.weaponslot 1, "TidalManiacShiny_W"
  player.weaponslot 2, "TidalManiacShiny_W2"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    WAVM H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    WAVM H 0 A_SpawnItemEx("TidalPillarDeath", 0, 0, 8, 0, 0, 0, 0, 1)
    Goto FadeDeathEnd3
  }
}



actor TidalPillarDeath {
  PROJECTILE
  damagetype "Tidal"
  Obituary "$OB_37D"
  +THRUACTORS
  +THRUGHOST
  +FLOORHUGGER
  //+PAINLESS
  +DONTBLAST
  +DONTREFLECT
  +DONTSPLASH
  Reactiontime 5
  damage (0)
  height 40
  radius 4
  scale 1.5
  Args 55, 96, 0 //55*7/11=35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0
    TNT1 A 1 A_PlaySound("misc/mwsburst", 1, 0.8)
    X_WB ABCDEFG 3 A_Explode(Args[0]*7/11, Args[1], 0, 0, Args[2])
   Burst:
    X_WB HIJ 3 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_WB H 0 A_Countdown
    loop
   Death:
    X_WB GFEDCBA 3 A_Explode(Args[0]*7/11, Args[1], 0, 0, Args[2])
    stop
  }
}
actor S_TidalPillarDeath : TidalPillarDeath {
  Args 83, 96, 0
}

actor Corpse_37 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_37_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_1", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_4", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


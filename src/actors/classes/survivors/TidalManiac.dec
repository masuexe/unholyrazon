actor TidalManiac : CustWepClassBase {
  Player.ScoreIcon "UMUG_37"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "TidalManiac"
  Player.SoundClass "TidalManiac"
  Player.MaxHealth 900
  Health 900
  Player.ForwardMove 0.9, 0.9
  Player.SideMove 0.9, 0.9
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "TidalManiac_W"
  Player.StartItem "TideEnergyAmmo", 70
  Player.StartItem "FlowEnergyAmmo", 140
  States {
   Spawn:
    WAVM A 0
    WAVM B 1
    WAVM A 1
    goto Spawn+2
   See:
    WAVM BCDE 5
    goto Spawn
   CustomState0:
   Missile:
    WAVM G 7
    WAVM F 5
    goto Spawn+2
   ClassPain:
    WAVM H 0
    goto MegamanPain

   ClassDeath:
    WAVM H 0
    goto MegamanDeath
   MegamanDeath0:
    WAVM H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    WAVM H 0 A_SpawnItemEx("TidalPillarDeath", 0, 0, 8, 0, 0, 0, 0, 1)
    goto MegamanFade3
   MegamanDisintegrate:
    WAVM Z 0 A_SpawnItemEx("Corpse_37", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TidalManiacShiny : TidalManiac {
  Player.ScoreIcon "UMUG_S37"
  Player.MaxHealth 2900
  Health 2900
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 11
  Player.MorphWeapon "TidalManiacShiny_W"
  Player.WeaponSlot 1, "TidalManiacShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    WAVM H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    WAVM H 0 A_SpawnItemEx("S_TidalPillarDeath", 0, 0, 8, 0, 0, 0, 0, 1)
    goto MegamanFade3
  }
}


actor TidalPillarDeath {
  Projectile
  DamageType "Tidal"
  Obituary "$OB_37D"
  +THRUACTORS
  +THRUGHOST
  +FLOORHUGGER
  // +PAINLESS
  +DONTBLAST
  +DONTREFLECT
  +DONTSPLASH
  ReactionTime 5
  Damage (0)
  Height 40
  Radius 4
  Scale 1.5
  Args 55, 96, 0  // 55*7/11=35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0
    TNT1 A 1 A_PlaySound("misc/mwsburst", 1, 0.8)
    X_WB ABCDEFG 3 A_Explode(args[0] * 7 / 11, args[1], 0, 0, args[2])
   Burst:
    X_WB HIJ 3 A_Explode(args[0], args[1], 0, 0, args[2])
    X_WB H 0 A_Countdown
    loop
   Death:
    X_WB GFEDCBA 3 A_Explode(args[0] * 7 / 11, args[1], 0, 0, args[2])
    stop
  }
}
actor S_TidalPillarDeath : TidalPillarDeath {
  Args 83, 96, 0
}

actor Corpse_37 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_37_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_37_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


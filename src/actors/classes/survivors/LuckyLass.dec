actor LuckyLass : CustWepClassBase {
  Player.ScoreIcon "UMUG_6_"
  Player.DisplayName "LuckyLass"
  Player.SoundClass "LuckyLass"
  Player.MaxHealth 900
  Health 900
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.175, 1.175
  Player.JumpZ 13
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "LuckyLass_W"
  Player.StartItem "LuckyEnergyAmmo", 400
  States {
   Spawn:
    1H06 A 0
    1H06 B 1
    1H06 A 1
    1H06 A 55
    1H06 Y 5
    goto Spawn+3
   See:
    1H06 BCDE 5
    goto Spawn
   Missile:
    1H06 F 0 A_JumpIfInventory("VivifyFlag1", 1, "MissilePose")
    1H06 F 0 A_JumpIfInventory("LuckyCharge", 1, "Missile1")
    1H06 F 5
    1H06 G 4
    goto Spawn+2
   Missile1:
    1H06 FFFAAA 1 A_JumpIfInventory("VivifyDelay5", 1, "Missile_1")
    goto Spawn+2
   Missile_1:
    1H06 F 1 A_TakeInventory("VivifyDelay5")
    goto Missile1+1
   Missile2:
    /*1H06 I 4
    1H06 J 5*/
    goto Missile+2  // Am sorry for this..
   MissilePose:
    1H06 KKKLLLMMMNNN 1 A_JumpIfInventory("VivifyDelay7", 1, "MissilePose2")
    loop
   MissilePose2:
    1H06 F 0
    // goto Missile+1
    goto Missile2

   ClassPain:
    1H06 H 0 A_JumpIfInventory("VivifyFlag1", 1, "ClassPainPose")
    goto MegamanPain

   ClassPainPose:
    1H06 H 0 A_SpawnItemEx("DelayPainFX5")
    1H06 HHH 1 A_JumpIfInventory("VivifyDelay7", 1, "MissilePose2")
    goto MissilePose

   ClassDeath:
    1H06 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H06 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H06 H 0 A_PlaySound("misc/BlankSound", 1)
    1H06 H 0 A_TakeInventory("LuckyCharge", 1)
    1H06 HHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H06 H 0 A_JumpIfInventory("LuckyCharge", 102, "ClassDeath_Boom7")
    1H06 H 0 A_Jump(32, "ClassDeath_Boom7")
    1H06 H 0 A_PlaySound("*death", 2)
    1H06 H 0 A_Jump(256, "ClassDeath_Fade", "ClassDeath_Fly", 1, 1)
    goto ClassDeath_None
    1H06 HHHHHHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H06 H 0 A_Jump(256, "ClassDeath_Mega", "ClassDeath_None")
    goto ClassDeath_None
   ClassDeath_Boom7:
    1H06 HHHHHHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H06 H 0 A_PlaySound("*death", 2)
    1H06 H 0 A_SpawnItemEx("LuckyLassGoesBoom", 0, 0, 28, 0, 0, 0, 0, 1)
    goto ClassDeath_Mega2
   ClassDeath_Mega:
    1H06 H 0 A_PlaySound("classes/LuckySound2", 7)
   ClassDeath_Mega2:
    1H06 H 0 A_SpawnItemEx("FakeUnholyDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    goto ClassDeath_End
   ClassDeath_Fly:
    1H06 H 0 A_PlaySound("classes/LuckyFly", 5)
    1H06 H 1 ThrustThingZ(0, 10, 0, 1)  // 5
    1H06 H 0 A_JumpIf(ceilingz - z < 64, "ClassDeath_Mega2")
    1H06 H 0 A_GiveInventory("ClassDeathFlag", 1)
    1H06 H 0 A_JumpIfInventory("ClassDeathFlag", 25, "ClassDeath_Mega2")
    goto ClassDeath_Fly+1
   ClassDeath_None:
    1H06 H 0 A_PlaySound("classes/LuckySound1", 6)
    goto ClassDeath_End
   ClassDeath_Fade:
    1H06 H 0 A_PlaySound("classes/LuckySound1", 6)
    1H06 H 1 A_SetTranslucent(0.90, 0)
    1H06 H 1 A_SetTranslucent(0.80, 0)
    1H06 H 1 A_SetTranslucent(0.70, 0)
    1H06 H 1 A_SetTranslucent(0.60, 0)
    1H06 H 1 A_SetTranslucent(0.50, 0)
    1H06 H 1 A_SetTranslucent(0.40, 0)
    1H06 H 1 A_SetTranslucent(0.30, 0)
    1H06 H 1 A_SetTranslucent(0.20, 0)
    1H06 H 1 A_SetTranslucent(0.10, 0)
    goto ClassDeath_End
   ClassDeath_End:
    1H06 Z 1
    goto MegamanErase

   MegamanDisintegrate:
    1H06 Z 0 A_SpawnItemEx("Corpse_06", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor LuckyLassGoesBoom : BasicExplosion {
  DamageType "LuckyLass"
  Obituary "$OB_06D"
  Scale 4.5
  Args 777, 555, 44
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("classes/LuckyBOOM", 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

actor LuckyLassShiny : LuckyLass {
  Player.ScoreIcon "UMUG_S6"
  Player.MaxHealth 2900
  Health 2900
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.275, 1.275
  Player.JumpZ 14
  Player.MorphWeapon "LuckyLassShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   ClassDeath_Boom7:
    1H06 HHHHHHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H06 H 0 A_PlaySound("*death", 2)
    1H06 H 0 A_SpawnItemEx("S_LuckyLassGoesBoom", 0, 0, 28, 0, 0, 0, 0, 1)
    goto ClassDeath_Mega2
  }
}
actor S_LuckyLassGoesBoom : LuckyLassGoesBoom {
  Args 1166, 555, 44
}

actor Corpse_06 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_06_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_06_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_06_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_06_3", 0, 0, 16, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_06_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_06_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}
actor Corpse_06_0 : BaseCorpseFX {States {Spawn: 1H06 O 350
    goto Spawn2}}
actor Corpse_06_1 : BaseCorpseFX {States {Spawn: 1H06 P 350
    goto Spawn2}}
actor Corpse_06_2 : BaseCorpseFX {States {Spawn: 1H06 Q 350
    goto Spawn2}}
actor Corpse_06_3 : BaseCorpseFX {States {Spawn: 1H06 R 350
    goto Spawn2}}
actor Corpse_06_4 : BaseCorpseFX {States {Spawn: 1H06 S 350
    goto Spawn2}}
actor Corpse_06_5 : BaseCorpseFX {States {Spawn: 1H06 T 350
    goto Spawn2}}

actor GhostBusterTrap : ProjSpawnFuncActor
{
Translation "192:192=183:183","198:198=235:235",
 /*Galaga*/ "168:168=197:197","250:250=74:74","249:249=245:245"
damagetype "GhostBusterTrap"
Obituary "$OB_57A2"
BounceSound "wep_L/GhostTrapLand"
//WallBounceSound ""
+MISSILE
-NOGRAVITY
+DONTBLAST
+DONTREFLECT
+DONTSPLASH
+THRUACTORS
+FORCEYBILLBOARD
+NOTARGETSWITCH
+BOUNCEONFLOORS
+BOUNCEONWALLS
+STEPMISSILE
maxstepheight 8
BounceFactor 0.00
WallBounceFactor 0.5
BounceCount 30
renderstyle translucent
alpha 1.0
reactiontime 50//325
damage 0
radius 5
height 16
speed 8
scale 2.5
States
{
Spawn:
6P57 E 0
6P57 E 0 ThrustThing(angle*256/360,2,1,0)
6P57 E 0 ThrustThingZ(0,4,0,1)
6P57 E 0 A_GiveInventory("ReSyncPickup")
6P57 E 0
Spawn1:
6P57 EEEEEEE 1 A_JumpIfInTargetInventory("GhostTrapDetonateFlag",1,"TrapActive")
6P57 E 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Fadeout")
6P57 E 0 A_CountDown
6P57 E 0 A_JumpIf(Reactiontime<=25,"Spawn2")
Loop
Spawn2:
6P57 E 0 A_PlaySound("S3_K/MetalSpark",1,0.65)
6P57 E 0 A_SpawnItemEx("GhostBusterTrapPuffFX",random(-3,3),random(-3,3),6,0,0,1,0,128,128)
6P57 EEEEEEE 1 A_JumpIfInTargetInventory("GhostTrapDetonateFlag",1,"TrapActive")
6P57 E 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Fadeout")
6P57 E 0 A_CountDown
Goto Spawn2+1
TrapActive:
6P57 F 0 //A_Stop
6P57 F 0 A_GiveInventory("ReSyncPickup")
//6P57 F 5 A_PlaySound("weapons/trapcharge")
6P57 F random(3,6)
6P57 F 0 A_PlaySound("wep/GhostTrap",1,0.925,1)
6P57 JKL 2 Bright A_Explode(11,80,0,0,24)
6P57 MNO 2 Bright A_GiveInventory("GhostBusterTrapDet1_P")
6P57 PQRPQRPQRPQRPQRPQRPQRPQRPQRPQRPQRPQRPQRPQRPQR 2 Bright A_GiveInventory("GhostBusterTrapDet2_P")
6P57 MNO 2 Bright A_GiveInventory("GhostBusterTrapDet1_P")
6P57 JKL 2 Bright A_Explode(11,80,0,0,24)
//6P57 FFFFFFFFFFFFF 8 A_Explode(264,128,0,0,24)//32
6P57 F 8 A_StopSound(1)
6P57 E 6
Goto Fadeout
Fadeout:
6P57 E 1 A_FadeOut(0.05)
wait
Death:
6P57 G 0 A_PlaySound("Pitfall/Boom",1,0.55)
6P57 G 0 A_SpawnItemEx("GhostBusterTrapBoomFX",0,0,8,0,0,0,0,129)
6P57 G 0 A_SpawnItemEx("GhostBusterTrapPuffFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 4 A_SpawnItemEx("GhostBusterTrapSmokeFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 0 A_SpawnItemEx("GhostBusterTrapPuffFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 4 A_SpawnItemEx("GhostBusterTrapSmokeFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 0 A_SpawnItemEx("GhostBusterTrapPuffFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 4 A_SpawnItemEx("GhostBusterTrapSmokeFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 0 A_SpawnItemEx("GhostBusterTrapPuffFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 4 A_SpawnItemEx("GhostBusterTrapSmokeFX",random(-2,2),random(-2,2),8,0,0,1,0,128,0)
6P57 G 1 A_FadeOut(0.05)
wait
}
}

actor GhostBusterTrapDet1_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Explode(11,80,0,0,24)
TNT1 A 0 A_SpawnItemEx("GhostBusterTrapDet",0,0,56,0,0,0,0,32)
stop
}
}
actor GhostBusterTrapDet2_P : GhostBusterTrapDet1_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("GhostBusterTrapDet",0,0,112,0,0,0,0,32)

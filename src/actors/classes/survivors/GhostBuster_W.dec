//seesound "wep/NewProtonPew"
//deathsound "weapons/plasmax"
damagetype "GhostBuster"
Obituary "$OB_57M"
+RANDOMIZE
renderstyle add
alpha 0.95
//Health 0x7fffffff
Damage (random(51,89))//[2]
radius 6
height 6
speed 38
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1
6P57 AB 2
6P57 C 1
6P57 C 1 //A_PlaySound("wep_L/NewProtonPew",2)
6P57 D 2
Spawn2:
//6P57 BD 2
6P57 ABCD 2
loop
Death:
TNT1 A 0
TNT1 A 1
stop
}
}


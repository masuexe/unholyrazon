actor GhostBuster_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 1
Weapon.AmmoGive 100
//Weapon.AmmoGive2 0
Inventory.PickupMessage "$PU_57_A"
Obituary "$OB_57W1"
Tag "$TAG_GhostBuster_W"
Weapon.AmmoType "ProtonChargeAmmo"
Weapon.AmmoType2 "GhostTrapAmmo"
inventory.icon "C_I_57A"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H57 [ 6
loop

Ready:
6H57 A 0 //ACS_ExecuteAlways(991,0,234)
Ready1:
6H57 A 16 A_GiveInventory("GhostBuster_Ready_P1")
6H57 A 0 A_GiveInventory("GhostBuster_AmmoReady_P1")
loop

Select:
6H57 J 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 J 1 offset(75,50)A_Raise//30
6H57 J 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 J 1 offset(29,52)A_Raise//32
6H57 J 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 J 1 offset(1,59)A_Raise//39
6H57 E 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 E 1 offset(1,39)A_Raise
6H57 D 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 D 1 offset(1,39)A_Raise
6H57 C 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 C 1 offset(1,39)A_Raise
6H57 B 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 B 1 offset(14,43)A_Raise
6H57 B 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 B 1 offset(1,39)A_Raise
6H57 A 0 A_TakeInventory("GhostB_SwapFlag")
6H57 A 1 offset(1,32)A_Raise
wait
Deselect:
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",8,8)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",7,9)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",6,10)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",5,11)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",4,12)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",3,13)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",2,14)
6H57 B 0 A_JumpIfInventory("GhostB_SwapFlag",1,15)
6H57 B 0 offset(1,27)A_TakeInventory("GhostB_SwapFlag",1)
6H57 B 1 offset(1,27)A_Lower
6H57 B 0 offset(14,31)A_TakeInventory("GhostB_SwapFlag",1)
6H57 B 1 offset(14,31)A_Lower
6H57 C 0 offset(1,27)A_TakeInventory("GhostB_SwapFlag",1)
6H57 C 1 offset(1,27)A_Lower
6H57 D 0 offset(1,27)A_TakeInventory("GhostB_SwapFlag",1)
6H57 D 1 offset(1,27)A_Lower
6H57 E 0 offset(1,27)A_TakeInventory("GhostB_SwapFlag",1)
6H57 E 1 offset(1,27)A_Lower
6H57 F 0 offset(1,27)A_TakeInventory("GhostB_SwapFlag",1)
6H57 F 1 offset(1,27)A_Lower
6H57 F 0 offset(29,20)A_TakeInventory("GhostB_SwapFlag",1)
6H57 F 1 offset(29,20)A_Lower
6H57 F 0 offset(75,18)A_TakeInventory("GhostB_SwapFlag",1)
6H57 F 1 offset(75,18)A_Lower
TNT1 A 1 offset(1,138)A_Lower
wait

Fire:
6H57 A 0 A_JumpIfNoAmmo("FireNoAmmo")
6H57 A 1 offset(26,36)
6H57 B 1 offset(1,33)
6H57 B 1 offset(14,37)
6H57 B 0 A_Refire(1)
FireH:
6H57 B 0 A_JumpIfNoAmmo("FireHNoAmmo")
6H57 B 3 offset(14,37)A_GiveInventory("GhostBuster_Fire_P1")//A_FireCustomMissile("GhostBusterShot",0,1,0,3)//2
6H57 B 3 offset(14,37)A_GiveInventory("GhostBuster_Fire_P2")//A_FireCustomMissile("GhostBusterShot",0,0,0,3)//2
6H57 B 1 A_Refire("FireH")
6H57 B 3 offset(14,37)
6H57 B 1 offset(1,33)
6H57 A 1 offset(26,36)
6H57 A 1 A_WeaponReady(14)
Goto Ready1
FireNoAmmo:
6H57 A 8 A_PlaySound("weapon/noammo",1)
Goto Ready1
FireHNoAmmo:
6H57 B 8 offset(14,37)A_PlaySound("weapon/noammo",1)
6H57 B 1 offset(1,33)
6H57 A 1 offset(26,36)
6H57 A 1 A_WeaponReady(14)
goto Ready1
//Altfire:
//6H57 A 12 A_PlaySoundEx("gbupgradefail","Voice")
//Goto Ready1

Altfire:
6H57 B 0 A_GiveInventory("VivifyDelay4")
6H57 B 0 A_Refire(1)
6H57 B 1 offset(-5,34)
6H57 B 1 offset(14,42)
6H57 H 0 A_TakeInventory("ProtonChargeAmmo",20)
6H57 H 0 A_PlaySound("wep_L/ClassicProton",1)
6H57 H 2 offset(20,54)A_FireCustomMissile("GhostBusterAltShot",0,1,0,0)
6H57 G 2 offset(17,47)
6H57 H 0 A_PlaySound("wep_L/ClassicProton",1)
6H57 H 2 offset(20,54)A_FireCustomMissile("GhostBusterAltShot",0,1,0,0)
6H57 G 2 offset(17,47)
6H57 H 0 A_PlaySound("wep_L/ClassicProton",1)
6H57 H 2 offset(20,54)A_FireCustomMissile("GhostBusterAltShot",0,1,0,0)
6H57 G 2 offset(17,47)
6H57 B 8 offset(14,42)
6H57 A 2 offset(15,38)
6H57 A 2 offset(9,35)
6H57 A 2 offset(4,33)

/*
//6H57 A 1 offset(26,36)
//6H57 B 1 offset(1,33)
6H57 B 1 offset(1,32)
6H57 B 1 offset(14,37)
6H57 H 2 offset(38,69)A_FireCustomMissile("",0,1,0,0)
6H57 H 2 offset(50,85)
6H57 H 6 offset(56,93)

6H57 H 2 offset(41,80)
6H57 H 2 offset(28,70)
6H57 G 2 offset(17,62)
6H57 B 2 offset(8,55)

6H57 A 2 offset(13,43)
6H57 A 2 offset(6,37)
*/
Goto Ready1
}
}

actor GhostBuster_W2 : BaseMM8BDMWep_UH
{
Weapon.AmmoUse2 5
Weapon.AmmoGive 50
//Weapon.AmmoGive2 0
Inventory.PickupMessage "$PU_57_B"
Obituary "$OB_57W2"
Tag "$TAG_GhostBuster_W2"
Weapon.AmmoType "ProtonChargeAmmo"
Weapon.AmmoType2 "GhostTrapAmmo"
Inventory.icon "C_I_57B"
+WEAPON.NOAUTOAIM
+WEAPON.ALT_AMMO_OPTIONAL

States
{
Spawn:
6H57 [ 6
loop

Select:
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(63,138)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(48,124)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(35,110)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(24,96)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(15,80)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(8,66)A_Raise
6H57 Q 0 A_GiveInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(3,52)A_Raise
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag", 1)
6H57 Q 1 offset(1,32)A_Raise
wait
Deselect:
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",7,7)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",6,8)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",5,9)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",4,10)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",3,11)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",2,12)
6H57 Q 0 A_JumpIfInventory("GhostB_SwapFlag",1,13)

6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(3,40)A_Lower
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(8,54)A_Lower
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(15,68)A_Lower
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(24,82)A_Lower
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(35,96)A_Lower
6H57 Q 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 Q 1 offset(48,110)A_Lower
6H57 V 0 A_TakeInventory("GhostB_SwapFlag",1)
6H57 V 1 offset(63,104)A_Lower//124

6H57 Q 1 offset(80,138)A_Lower
wait
Ready:
6H57 Q 0 //ACS_ExecuteAlways(991,0,NULL)//GHOSTBUSTER_DYE
goto Ready1

Ready1:
6H57 Q 16 A_GiveInventory("GhostBuster_Ready_P2")
6H57 Q 0 A_GiveInventory("GhostBuster_AmmoReady_P2")
loop

Fire:
6H57 R 0 A_JumpIfInventory("DecoyFlag1",1,"RaiseDet")
6H57 R 0 A_PlaySound("wep_L/GhostTrapButton",1,0.8)
FireH:
6H57 R 1 offset(-2,36)A_GiveInventory("GhostTrapDetonateFlag")
6H57 R 0 A_Refire("FireH")
//6H57 Q 2 A_WeaponReady(14)
Goto Ready1

NoAmmo:
6H57 Q 8 A_PlaySound("weapon/noammo",1)
Goto Ready1
Altfire:
6H57 Q 0 A_JumpIfInventory("DecoyFlag1",1,"NewTrap")
6H57 Q 0 A_JumpIfNoAmmo("NoAmmo")
6H57 Q 0 A_GiveInventory("DecoyFlag1")
6H57 Q 1 offset(4,44)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(10,56)
6H57 Q 1 offset(18,71)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(28,86)
6H57 Q 1 offset(40,104)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(54,122)
Goto NewTrap
NewTrap:
6H57 S 1 offset(-24,50)A_JumpIfNoAmmo("RaiseDet")
6H57 S 1 offset(-14,40)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 S 1 offset(-4,30)
6H57 T 0 A_FireCustomMissile("GhostBusterTrap",0,1,0,0)
6H57 T 1 offset(4,30)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 T 1 offset(8,26)
6H57 T 1 offset(12,24)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 T 1 offset(16,25)
6H57 T 1 offset(20,31)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 T 1 offset(24,41)
6H57 T 1 offset(28,55)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 T 1 offset(32,73)
6H57 T 1 offset(38,95)A_JumpIfInventory("PlayerPropertyRage",1,1)
TNT1 AA 1 A_WeaponReady(2)
Goto RaiseDet
RaiseDet:
6H57 Q 1 offset(44,124)A_TakeInventory("DecoyFlag1")
6H57 Q 1 offset(35,109)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(27,95)
6H57 Q 1 offset(20,82)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(14,70)
6H57 Q 1 offset(9,59)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(5,49)
6H57 Q 1 offset(2,40)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 0
Goto Ready1
/*
6H57 Q 1 offset(72,124)
6H57 Q 1 offset(56,109)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(42,95)
6H57 Q 1 offset(30,82)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(20,70)
6H57 Q 1 offset(12,59)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 1 offset(6,49)
6H57 Q 1 offset(2,40)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H57 Q 0
*/
}
}



actor GhostTrapAmmo : Ammo
{
inventory.pickupmessage "Picked up a new trap."
inventory.amount 1
inventory.maxamount 50
ammo.backpackamount 10
ammo.backpackmaxamount 100
+INVENTORY.IGNORESKILL
}

actor ProtonChargeAmmo : Ammo
{
Inventory.PickupMessage "Proton charge!"
inventory.amount 1
inventory.maxamount 100
Ammo.BackpackAmount 150
Ammo.BackpackMaxAmount 100
+INVENTORY.IGNORESKILL
}

actor GhostTrapDetonateFlag : PowerUp
{
//Inventory.PickupMessage "GO GO JESUS RANGERS!"
Powerup.Duration 5
}

actor GhostB_SwapFlag : Inventory
{
inventory.amount 1
inventory.maxamount 8
}

actor GhostBuster_Ready_P1 : CustomInventory
{
States
{
Pickup:
Ready1:
TNT1 A 0 A_JumpIfInventory("ProtonChargeAmmo",1,"Pickup2")
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
stop
Pickup2:
TNT1 A 0 A_JumpIfInventory("ProtonChargeAmmo",20,"Pickup4")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
stop
Pickup4:
TNT1 A 0 A_WeaponReady
stop
}
}

actor GhostBuster_Ready_P2 : GhostBuster_Ready_P1
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("GhostTrapAmmo",5,"Pickup4")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
stop
}
}

actor GhostBuster_AmmoReady_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ProtonChargeAmmo",0,2)
TNT1 A 0 A_Jump(256,"Ammo")
stop
TNT1 A 0 A_JumpIfInventory("GhostTrapAmmo",0,2)
TNT1 A 0 A_Jump(256,"Ammo")
TNT1 A 0
stop
Ammo:
TNT1 A 0 A_GiveInventory("ProtonChargeAmmo",10)//15
TNT1 A 0 A_GiveInventory("GhostTrapAmmo",2)
goto Snd
Snd:
TNT1 A 0 A_PlaySound("wep_L/GhostAmmo",1)
stop
}
}
actor GhostBuster_AmmoReady_P2 : GhostBuster_AmmoReady_P1
{
States
{
Ammo:
TNT1 A 0 A_GiveInventory("ProtonChargeAmmo",5)
TNT1 A 0 A_GiveInventory("GhostTrapAmmo",4)
goto Snd
}
}



// TODO: replace the single weapon with fat weapons in Slugger_W

actor SluggerS_W_NormalBar : NormalBar {args 109, 128}

actor SluggerS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Slugger_W"
Weapon.AmmoUse 0
Weapon.AmmoUse2 20
Weapon.AmmoGive 1
Weapon.AmmoGive2 1
Inventory.Pickupmessage "$PU_21"
Obituary "$OB_21W5"
weapon.ammotype ""
weapon.ammotype2 "SluggerCrateAmmo"
inventory.icon "C_I_21F"
+WEAPON.NOAUTOAIM
+WEAPON.ALT_AMMO_OPTIONAL
//+WEAPON.ALT_USES_BOTH
-WEAPON.DONTBOB
weapon.bobstyle "Smooth"
Weapon.BobSpeed 1.5
States
{
Spawn:
7H21 [ 6
loop

Deselect:
7H21 A 0 A_Lower
7H21 A 1 A_Lower
Loop
Select:
7H21 A 0 A_Raise
7H21 A 1 A_Raise
Loop

Ready:
7H21 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_SDYE)
7H21 A 0 //A_GunFlash
goto Ready1
Ready1:
7H21 A 0 A_JumpIfInventory("SluggerCrateAmmo",20,"Ready2")
7H21 A 4 A_WeaponReady(8)
7H21 A 0 A_GiveInventory("SluggerCrateAmmo",2)
loop
Ready2:
7H21 A 4 A_WeaponReady
7H21 A 0 A_GiveInventory("SluggerCrateAmmo",2)
loop

Flash:
TNT1 A 2
TNT1 A 2 A_GiveInventory("SluggerCrateAmmo",4)
loop


Fire:
7H21 A 0 A_JumpIfNoAmmo("NoAmmo")
7H21 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
Fire1:
7H21 B 0 A_JumpIfNoAmmo("NoAmmo")
7H21 B 2 A_GiveInventory("S_SluggerFire_P")
7H21 B 0 A_ReFire("Fire2")
Goto NoAmmo
Fire2:
7H21 C 0 A_JumpIfNoAmmo("NoAmmo")
7H21 C 2 A_GiveInventory("S_SluggerFire_P2")
7H21 C 0 A_ReFire("Fire1")
Goto NoAmmo

NoAmmo:
7H21 D 9 A_GiveInventory("SluggerCrateAmmo",5)
Goto Ready1


BotFire:
7H21 B 0 A_Jump(16,"BotFire4")
7H21 A 0 A_GiveInventory("SluggerCrateAmmo",random(24,32))
7H21 B 0 A_Jump(96,"BotFire3")
BotFire1:
7H21 B 0 A_Jump(8,"NoAmmo")
7H21 B 0 A_JumpIfNoAmmo("NoAmmo")
7H21 B 2 A_GiveInventory("S_SluggerFire_P")
7H21 B 0 A_ReFire("BotFire2")
Goto NoAmmo
BotFire2:
7H21 B 0 A_Jump(1,"BotFire4")
7H21 C 0 A_JumpIfNoAmmo("NoAmmo")
7H21 C 2 A_GiveInventory("S_SluggerFire_P")
7H21 C 0 A_ReFire("BotFire1")
Goto NoAmmo
BotFire3:
7H21 B 0 A_Jump(10,"BotFire4")
7H21 B 2 //A_JumpIfNoAmmo("NoAmmo2")
7H21 C 2
7H21 B 2 A_GiveInventory("S_SluggerAltfire_P")
7H21 CDDD 2
7H21 A 0 A_ReFire("BotFire3")
Goto Ready1
BotFire4:
7H21 A 0 A_PlaySoundEx("taunt/D_21","Voice")
7H21 A 0 A_GiveInventory("SluggerCrateAmmo",0)
7H21 A 0 A_FaceTarget
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",0,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",30,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",-30,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",60,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",-60,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",90,0,0,0)
7H21 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",-90,0,0,0)
7H21 BCBCDDD 2
goto Ready1

Altfire:
7H21 B 0 A_JumpIfNoAmmo("NoAmmo2")
7H21 B 2 Offset(0,53)A_GiveInventory("S_SluggerAltfire_P")
7H21 C 2 Offset(0,60)
7H21 D 2 Offset(0,63)
7H21 D 2 Offset(0,64)
7H21 D 2 Offset(0,61)
7H21 D 2 Offset(0,55)
7H21 D 2 Offset(0,47)
7H21 D 2 Offset(0,38)
7H21 A 0 A_ReFire("Altfire")
Goto Ready1
NoAmmo2:
7H21 D 1 Offset(0,32)
Goto Ready1
}
}


actor S_SluggerFire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("Caliber/Pew",1)
//TNT1 A 0 A_GiveInventory("SluggerLawnchairAmmo",1)
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
TNT1 A 0 A_FireCustomMissile("S_SluggerFlameShot",0,0,random(-2,2),random(-2,2))
stop
TNT1 A 0 A_FireCustomMissile("S_SluggerFlameShotRage",0,0,random(-2,2),random(-2,2))
stop
}
}
actor S_SluggerFire_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("Caliber/Pew",1)//4
TNT1 A 0 A_GiveInventory("SluggerCrateAmmo",1)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE),2)
TNT1 A 0 A_FireCustomMissile("S_SluggerFlameShot2",0,0,random(-2,2),random(-2,2))
stop
TNT1 A 0 A_FireCustomMissile("S_SluggerFlameShotRage2",0,0,random(-2,2),random(-2,2))
stop
}
}

actor S_SluggerAltfire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("SluggerCrateAmmo",12,1)
TNT1 A 0 A_TakeInventory("SluggerCrateAmmo",8)
TNT1 A 0 A_PlaySound("wep_L/SluggerRocket",1,1.0)
TNT1 A 0 A_FireCustomMissile("S_SluggerLawnChairShot",0,0,0)
stop
}
}

actor S_SluggerFlameShot : BasicProjectile
{
Translation "192:192=109:109", "198:198=128:128"
damagetype "SluggerFire"
Obituary "$OB_21M5"
+BOUNCEONWALLS
//+BOUNCEONFLOORS
+NOEXPLODEFLOOR
+BOUNCEONCEILINGS
+DONTSPLASH
+BRIGHT
BounceFactor 0.0
WallBounceFactor 0.0
renderstyle translucent
alpha 0.75
Damage (random(29,41))
radius 14
height 14
Speed 60
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 //A_SetScale(ScaleX*(random(0,1)*2-1),ScaleY)//ScaleY*(random(0,1)*2-1)
//Software does not render negative Y Scale, so flipped sprites
TNT1 A 1
TNT1 A 0 A_Jump(256,1,7,13,19,25,31,37,43)
7P21 ABCDEF 1
stop
7P21 BCDEFF 1
stop
7P21 CDEEFF 1
stop
7P21 DDEEFF 1
stop
//Flipped Y
7P21 GHIJKL 1
stop
7P21 HIJKLL 1
stop
7P21 IJKKLL 1
stop
7P21 JJKKLL 1
stop
Death:
TNT1 A 1 A_SpawnItemEx("OilPitIgnite",0,0,8)
stop
}
}
actor S_SluggerFlameShot2 : S_SluggerFlameShot
{
XScale -2.5
YScale 2.5
}

actor S_SluggerFlameShotRage : S_SluggerFlameShot
{
Damage (random(29,41))
Speed 90
}
actor S_SluggerFlameShotRage2 : S_SluggerFlameShotRage
{
XScale -2.5
YScale 2.5
}



actor S_SluggerLawnChairShot : SluggerLawnChairShot
{
Translation "192:192=109:109","198:198=128:128"
Damage (random(60,90))//40,60
Args 336,375,128,16//224,250
}


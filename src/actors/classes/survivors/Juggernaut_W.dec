actor Juggernaut_W_NormalBar : NormalBar {args 206, 195}

actor Juggernaut_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 200
Inventory.Pickupmessage "$PU_48"
Obituary "$OB_48W"
Tag "$TAG_Juggernaut_W"
weapon.ammotype "IAmTheAmmoBitch"
States
{
Spawn:
6H48 [ 6
loop

Deselect:
6H48 A 0
goto DeselectSwap
Select:
6H48 A 0
goto SelectSwap

Ready:
6H48 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", JUGGERNAUT_DYE)
Goto Ready2
Ready2:
6H48 A 0 A_JumpIfInventory("IAmTheAmmoBitch",200,"Ready3")
6H48 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H48 A 0 A_GiveInventory("IAmTheAmmoBitch",4)
loop
Ready3:
6H48 A 2 A_WeaponReady
6H48 A 0 A_GiveInventory("IAmTheAmmoBitch",4)
loop

Fire:
6H48 B 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H48 B 2 A_GiveInventory("Juggernaut_Fire_P")
6H48 B 2 Offset(-70, 74)
6H48 B 2 Offset(-121, 114)
6H48 C 2 A_WeaponReady(14)
6H48 C 2 Offset(-25, 56)
6H48 C 2 Offset(-33, 84)
TNT1 A 8 Offset(-11, 101)
6H48 A 2 Offset(-7, 69)
6H48 A 2 Offset(-3, 48)
Goto Ready2

BotFire:
6H48 B 0 A_Jump(8,"BotFire2")
6H48 B 0 A_Jump(12,"BotFire1")
6H48 B 0 A_JumpIfInventory("IAmTheAmmoBitch",200,1)
Goto Fire+1
6H48 B 0 A_Jump(10,"BotFire2")
6H48 B 0 A_Jump(64,"SovietStriker")
Goto Fire+1
BotFire1:
6H48 B 0 A_PlaySoundEx("taunt/D_48","Voice")
6H48 B 0 A_ChangeVelocity(momx,momy,10.0,CVF_REPLACE)
Goto SovietStriker
BotFire2:
6H48 B 0 A_Jump(24,"BotFire1")
6H48 B 0 A_PlaySoundEx("taunt/D_48","Voice")
6H48 B 0 A_FireCustomMissile("JuggernautShot",20,0,8,0)
6H48 B 0 A_FireCustomMissile("JuggernautShot",-20,0,8,0)
6H48 B 0 A_GiveInventory("IAmTheAmmoBitch",random(50,100))
Goto Fire+1

Flash.Dash:
TNT1 A 1 A_Recoil(-5)
TNT1 A 1 A_Recoil(-7)
TNT1 A 1 A_Recoil(-10)
TNT1 A 1 A_Recoil(-12)
TNT1 A 1 A_Recoil(-17)
TNT1 A 1 A_Recoil(-24)//28
TNT1 A 1 A_Recoil(-33)//40
TNT1 A 1 A_Recoil(-44)//62
TNT1 A 1 A_Recoil(-57)//85
TNT1 A 1 A_Recoil(-73)//100
stop

AltFire:
6H48 A 0 A_JumpIfInventory("IAmTheAmmoBitch",200,"SovietStriker")
Goto Ready2
SovietStriker:
6H48 D 0 A_GiveInventory("VivifyDelay8",1)
6H48 D 0 A_Refire(1)
6H48 D 0 A_PlaySound("weapon/GameBoyPunkRam", 1)
6H48 D 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
6H48 D 0 A_GunFlash("Flash.Dash",1)
//6H48 DKKLLLLLLL LLKKK 1 A_GiveInventory("Juggernaut_Alt_P")
6H48 E 1
6H48 D 1
6H48 E 1 Offset(-10, 27)
6H48 DEDEDEDEDEDE 1 Offset(-20, 22) A_GiveInventory("S_Juggernaut_Alt_P")
6H48 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
6H48 DDD 2 A_ChangeVelocity(momx*0.94,momy*0.94,momz,2)
6H48 D 2 Offset(-10, 27) A_ChangeVelocity(momx*0.94,momy*0.94,momz,2)
6H48 D 0 A_WeaponReady(14)
6H48 DDD 2 A_ChangeVelocity(momx*0.94,momy*0.94,momz,2)
6H48 AAA 2 A_ChangeVelocity(momx*0.94,momy*0.94,momz,2)
Goto Ready2
}
}

actor IAmTheAmmoBitch : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor Juggernaut_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("JuggernautShot",0,0,8,0)
End:
TNT1 A 0 A_PlaySound("weapon/screwcrusher",1)
TNT1 A 0 A_GiveInventory("IAmTheAmmoBitch",12)
stop
}
}
actor Juggernaut_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("JuggernautExplosion",0,0,32,momx,momy,momz,0,8)
End:
TNT1 A 0 A_TakeInventory("IAmTheAmmoBitch",8,1)
TNT1 A 0 A_TakeInventory("IAmTheAmmoBitch",6)
stop
}
}

actor JuggernautShot : BasicProjectile
{
Translation "192:192=206:206","198:198=195:195"
damagetype "JuggerShot"
Obituary "$OB_48M"
//+HEXENBOUNCE
//-ALLOWBOUNCEONACTORS
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
+SKYEXPLODE
BounceFactor 0.75
WallBounceFactor 0.75
BounceCount 4
Damage (200)
Radius 18
Height 10
Speed 85
scale 3.0
States
{
Spawn:
X_KB AB 3
loop
}
}

actor JuggernautExplosion : BasicExplosion_Args_Trio
{
damagetype "JuggerRam"
Obituary "$OB_48A"
Args 200,110,24
}

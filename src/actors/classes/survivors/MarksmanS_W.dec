const int U_S_MARKMANSLOCK_LIMIT = 64;

actor MarksmanS_W_ScriptBar : ScriptBar {}

actor MarksmanS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Marksman_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_40"
Obituary "$OB_40W"
weapon.ammotype "MarksmanEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H40 [ 6
loop

Deselect:
7H40 A 0
goto DeselectSwap
Select:
7H40 A 0
goto SelectSwap

Ready:
7H40 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", MARKSMAN_SDYE)
7H40 A 1 A_TakeInventory("MarksmanMissile_F")//Morph doesn't have lock on data since new actor
goto Ready1

Ready1:
7H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",336,"Ready2")
7H40 A 2 A_WeaponReady(8)
7H40 A 0 A_GiveInventory("MarksmanEnergyAmmo",6)
loop
Ready2:
7H40 A 2 A_WeaponReady
7H40 A 0 A_GiveInventory("MarksmanEnergyAmmo",6)
loop

Fire:
7H40 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H40 C 0 A_GiveInventory("S_Marksman_Fire_P1")
7H40 C 0 A_ReFire(1)
7H40 A 1 Offset(10,42)
7H40 A 1 Offset(20,52)
7H40 A 1 Offset(6,38)
7H40 A 0 A_WeaponReady(14)
7H40 A 2 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H40 A 1 Offset(10,42) A_GiveInventory("S_Marksman_Fire_P2")
7H40 A 1 Offset(20,52)
7H40 A 1 Offset(6,38)
7H40 A 0 A_WeaponReady(14)
7H40 A 2 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H40 A 1 Offset(10,42) A_GiveInventory("S_Marksman_Fire_P3")
7H40 A 1 Offset(20,52)
7H40 A 1 Offset(6,38)
7H40 A 0 A_WeaponReady(14)
7H40 A 2 A_JumpIfInventory("PlayerPropertyRage",1,1)
7H40 AAA 5 A_GiveInventory("MarksmanEnergyAmmo",4)
Goto Ready1

BotFire:
7H40 A 0 A_GiveInventory("MarksmanEnergyAmmo",random(6,48))
7H40 A 0 A_Jump(8,"BotFire2")
7H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",168,"BotFire1")
7H40 A 0 A_Jump(56,"AltfireOld",1)
Goto Fire+1
7H40 A 0 A_Facetarget
goto AltfireOld
BotFire1:
7H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",336,3)
7H40 A 0 A_Jump(16,2)
7H40 A 0 A_Jump(64,"AltfireOld")
Goto Fire+1
7H40 A 0 A_Facetarget
goto AltfireOld

BotFire2:
7H40 A 0 A_PlaySoundEx("taunt/D_40","Voice")
7H40 A 0 A_Facetarget
7H40 AAAAAA 0 A_FireCustomMissile("S_MarksmanQuickMarkBot",random(-6,6),0,0,0,1,random(-7,7))
Goto AltfireOld+1

AltFire:
7H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",336,"AltfireHStart")
goto Ready1
AltfireOld:
7H40 C 0 A_TakeInventory("MarksmanEnergyAmmo",168)
7H40 C 0 A_FireCustomMissile("S_MarksmanQuickMark",0,0,0,0)
7H40 A 5 Offset(10,42)
7H40 A 3 Offset(6,38)
Goto Ready1

AltfireHStart:
7H40 B 1 A_PlaySound("CowboyKid/Knife",1)
AltfireH:
7H40 A 0 A_JumpIfInventory("MarksmanEnergyAmmo",1,1)
goto AltfireHEnd
7H40 A 1 A_GiveInventory("S_Marksman_AltHold_P")
7H40 A 0 A_Refire(2)
7H40 A 0 A_JumpIfInventory("MarksmanMissile_F",1,"AltfireHEnd")
goto AltfireHEnd2
7H40 B 0 A_JumpIfInventory("MarksmanEnergyAmmo",1,1)
goto AltfireHEnd
7H40 B 1 A_GiveInventory("S_Marksman_AltHold_P")
7H40 B 0 A_Refire("AltfireH")
7H40 B 0 A_JumpIfInventory("MarksmanMissile_F",1,"AltfireHEnd")
goto AltfireHEnd2

AltfireHEnd:
7H40 A 0 A_GiveInventory("S_Marksman_Alt_P")
7H40 A 0 A_GunFlash("NoFlash")
7H40 A 1 Offset(10,42) A_JumpIfInventory("PlayerPropertyRage",1,1)
7H40 A 1 Offset(20,52)
7H40 A 1 Offset(6,38) A_JumpIfInventory("PlayerPropertyRage",1,1)
7H40 A 1 A_WeaponReady(14)
AltfireHEnd2:
7H40 A 2 A_JumpIfInventory("MarksmanMissile_F",1,"AltfireHEnd")
7H40 AA 2 A_TakeInventory("MarksmanMissile_F")
7H40 A 2 ACS_NamedExecuteWithResult("uc_MarksmanLockOn",-1,U_S_MARKMANSLOCK_LIMIT)//Clear LockOn
Goto Ready1

}
}

actor S_Marksman_Fire_P1 : Marksman_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("VivifyDelay4",1)
TNT1 A 0 A_FireCustomMissile("S_MarksmanBullet1",0,0,8,0)
goto End
}
}
actor S_Marksman_Fire_P2 : Marksman_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_MarksmanBullet2",0,0,8,0)
goto End
}
}
actor S_Marksman_Fire_P3 : Marksman_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_MarksmanBullet3",0,0,8,0)
goto End
}
}

actor S_Marksman_AltHold_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireBullets(0,0,0,0,"S_MarksmanTargeterDeluxe",FBF_NOFLASH|FBF_NORANDOMPUFFZ)
TNT1 A 0 A_JumpIfInventory("MarksmanMissile_F",1,1)
stop
TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo",1,1)
TNT1 A 0 A_TakeInventory("MarksmanEnergyAmmo",1)
stop
}
}

actor S_Marksman_Alt_P : Marksman_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_MarksmanLockShot",0,0,0,0)
goto End
}
}

actor S_MarksmanTargeterDeluxe : MarksmanTargeterDeluxe
{
Translation "4:4=4:4","192:192=244:244","198:198=0:0"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIf(CallACS("uh_istracerplayer")==1,1)
goto SpawnFX
TNT1 A 0 ACS_NamedExecuteWithResult("uc_MarksmanLockOn",0,CallACS("core_getptrtid", 2),CallACS("core_getptrtid", 8),U_S_MARKMANSLOCK_LIMIT)
goto SpawnFX
SpawnFX:
TNT1 A 1 A_SpawnItemEx("MarksmanTargeterFX",0,0,0,0,0,0,0,1)
stop

Crash:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("S_MarksmanTargeterFX",0,0,0)
TNT1 A 0
stop
}
}

actor S_MarksmanTargeterFX : MarksmanTargeterFX
{
Translation "4:4=4:4","192:192=204:204","198:198=0:0"
}

actor S_MarksmanLockShot : MarksmanLockShot
{
Translation "192:192=204:204","198:198=244:244"
Damage (188)//125
}


actor S_MarksmanBullet1 : MarksmanBullet1
{
Translation "192:192=204:204","198:198=244:244"
Damage (150)//100
}
actor S_MarksmanBullet2 : MarksmanBullet2
{
Translation "192:192=204:204","198:198=244:244"
Damage (150)
}
actor S_MarksmanBullet3 : MarksmanBullet3
{
Translation "192:192=204:204","198:198=244:244"
Damage (150)
Args 300,128,64//200
}


actor S_MarksmanQuickMark : MarksmanQuickMark
{
Translation "192:192=204:204","198:198=244:244"
Args 18,120,120//12
}

actor S_MarksmanQuickMarkBot : MarksmanQuickMarkBot
{
Translation "192:192=204:204","198:198=244:244"
Args 6,120,120//4
}


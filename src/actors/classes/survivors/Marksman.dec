actor Marksman : CustWepClassBase
{
player.scoreIcon "UMUG_40"
player.displayname "Marksman"
player.soundclass "Marksman"
player.maxhealth 1200
health 1200
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
player.jumpz 14
Player.StartItem "UH_BaseFlagPack"
player.startitem "Marksman_W"
player.startitem "MarksmanEnergyAmmo", 84
States
{
Spawn:
DAR3 A 0
DAR3 B 1
DAR3 A 1
Goto Spawn+2
See:
DAR3 BCDE 5 
Goto Spawn
Melee:
DAR3 F 1
DAR3 GF 3
goto Spawn+2
Missile:
DAR3 F 0 A_JumpIfInventory("VivifyDelay4",1,"Missile2")
DAR3 F 5
DAR3 G 4
goto Spawn+2
Missile2:
DAR3 FFGGGFFGGGFFGGGGG 1
goto Spawn+2

ClassPain: DAR3 H 0
Goto MegamanPain

ClassDeath:
DAR3 H 0
goto MegamanDeath
MegamanDeath0:
DAR3 H 13 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
DAR3 H 1 A_SpawnItemEx("MarksmanBulletDeath_H",0,0,28,0,0,0,0,1)
Goto MegamanErase
MegamanCorpse:
DAR3 Z 0 A_SpawnItemEx("Corpse_40",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor MarksmanS : Marksman
{
player.scoreIcon "UMUG_S40"
player.maxhealth 3200
health 3200
player.forwardmove 1.3, 1.3
player.sidemove 1.3, 1.3
player.jumpz 15
player.morphweapon "MarksmanS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
DAR3 H 13 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
DAR3 H 1 A_SpawnItemEx("S_MarksmanBulletDeath_H",0,0,28,0,0,0,0,1)
Goto MegamanErase
}
}



actor MarksmanBulletDeath_H : BasicHelper
{
DeathSound "Pokemon/Bide"
Args 8
States
{
Spawn:
TNT1 A 0
SpawnL:
TNT1 A 0 A_SpawnItemEx("MarksmanBulletDeath",0,0,0,80,0,0,0+Args[0]*45,1)
TNT1 A 0 A_CountDownArg(0)
loop
Death:
TNT1 A 10
stop
}
}
actor S_MarksmanBulletDeath_H : MarksmanBulletDeath_H
{
States
{
Spawn:
TNT1 A 0
SpawnL:
TNT1 A 0 A_SpawnItemEx("S_MarksmanBulletDeath",0,0,0,80,0,0,0+Args[0]*45,1)
TNT1 A 0 A_CountDownArg(0)
loop
}
}

actor MarksmanBulletDeath : FastProjectile
{
var int user_D;
Translation "192:192=211:211","198:198=231:231"
PROJECTILE
Damagetype "Marksman"
Obituary "$OB_40D"
+SKYEXPLODE
+EXPLODEONWATER
//+EXPLODEONDEATH
Damage (80)
Radius 12
Height 12
Speed 80
Scale 3.0
Args 40,96,24
States
{
Spawn:
6P40 AAAAAAAA 1
6P40 A 0 A_SetUserVar("user_D",-1)
6P40 A 1 A_SpawnItemEx("MarksmanBulletDeathFX",0,0,0,0,0,0,0,1)
wait
Death:
TNT1 A 0
TNT1 A 0 A_JumpIf(user_D == -1,"Death1")
TMFX ABCD 2
stop
Death1:
TNT1 A 0 A_SetScale(2.0)
TNT1 A 0 A_PlaySound("CowboyKid/Bomb",1)//Pokemon/Bide
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1+16384)
stop
}
}
actor S_MarksmanBulletDeath : MarksmanBulletDeath
{
Damage (120)
Args 60,96,24
}

actor MarksmanBulletDeathFX : BasicClientSide
{
Scale 1.5
States
{
Spawn:
TNT1 A 2
TMFX ABCD 1
stop
}
}

actor Corpse_40:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_40_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_40_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


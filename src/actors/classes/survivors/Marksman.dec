actor Marksman : CustWepClassBase {
  Player.ScoreIcon "UMUG_40"
  Player.DisplayName "Marksman"
  Player.SoundClass "Marksman"
  Player.MaxHealth 1200
  Health 1200
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 14
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Marksman_W"
  Player.StartItem "MarksmanEnergyAmmo", 84
  States {
   Spawn:
    DAR3 A 0
    DAR3 B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
   SpawnFrame:
    DAR3 A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    loop
   See:
    DAR3 BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    goto Spawn
   Air:
    DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Melee:
   Melee_1: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_1")
   Melee_2: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_2")
   Melee_3: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_3")
   Melee_4: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_4")
   Melee_5: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_5")
   Melee_6: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_6")
   Melee_7: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Melee_Air_7")
    goto SpawnFrame
   Melee_Air_1: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_2")
   Melee_Air_2: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_3")
   Melee_Air_3: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_4")
   Melee_Air_4: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_5")
   Melee_Air_5: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_6")
   Melee_Air_6: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Melee_7")
   Melee_Air_7: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air

   Missile:
    DAR3 F 0 A_JumpIfInventory("VivifyDelay4", 1, "Missile2")
   Missile_1: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
   Missile_2: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
   Missile_3: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
   Missile_4: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
   Missile_5: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
   Missile_6: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
   Missile_7: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
   Missile_8: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
   Missile_9: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
    goto SpawnFrame
   Missile_Air_1: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
   Missile_Air_3: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
   Missile_Air_4: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
   Missile_Air_5: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
   Missile_Air_6: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
   Missile_Air_7: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
   Missile_Air_8: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_9")
   Missile_Air_9: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air


   Missile2:
   Missile2_1: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_1")
   Missile2_2: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_2")
   Missile2_3: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_3")
   Missile2_4: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_4")
   Missile2_5: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_5")
   Missile2_6: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_6")
   Missile2_7: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_7")
   Missile2_8: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_8")
   Missile2_9: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_9")
   Missile2_10: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_10")
   Missile2_11: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_11")
   Missile2_12: DAR3 F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_12")
   Missile2_13: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_13")
   Missile2_14: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_14")
   Missile2_15: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_15")
   Missile2_16: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_16")
   Missile2_17: DAR3 G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_17")
    goto SpawnFrame
   Missile2_Air_1: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_2")
   Missile2_Air_2: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_3")
   Missile2_Air_3: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_4")
   Missile2_Air_4: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_5")
   Missile2_Air_5: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_6")
   Missile2_Air_6: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_7")
   Missile2_Air_7: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_8")
   Missile2_Air_8: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_9")
   Missile2_Air_9: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_10")
   Missile2_Air_10: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_11")
   Missile2_Air_11: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_12")
   Missile2_Air_12: DAR3 J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_13")
   Missile2_Air_13: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_14")
   Missile2_Air_14: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_15")
   Missile2_Air_15: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_16")
   Missile2_Air_16: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_17")
   Missile2_Air_17: DAR3 I 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air

   ClassPain:
    DAR3 H 0
    goto MegamanPain

   ClassDeath:
    DAR3 H 0
    goto MegamanDeath
   MegamanDeath0:
    DAR3 H 13 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DAR3 H 1 A_SpawnItemEx("MarksmanBulletDeath_H", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    DAR3 Z 0 A_SpawnItemEx("Corpse_40", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor MarksmanShiny : Marksman {
  Player.ScoreIcon "UMUG_S40"
  Player.MaxHealth 3200
  Health 3200
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.3, 1.3
  Player.JumpZ 15
  Player.MorphWeapon "MarksmanShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    DAR3 H 13 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    DAR3 H 1 A_SpawnItemEx("S_MarksmanBulletDeath_H", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
  }
}


actor MarksmanBulletDeath_H : BasicWatcher {
  DeathSound "Pokemon/Bide"
  Args 8
  States {
   Spawn:
    TNT1 A 0
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("MarksmanBulletDeath", 0, 0, 0, 80, 0, 0, 0 + args[0] * 45, 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
   Death:
    TNT1 A 10
    stop
  }
}
actor S_MarksmanBulletDeath_H : MarksmanBulletDeath_H {
  States {
   Spawn:
    TNT1 A 0
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("S_MarksmanBulletDeath", 0, 0, 0, 80, 0, 0, 0 + args[0] * 45, 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}

actor MarksmanBulletDeath : FastProjectile {
  var int user_d;
  Translation "192:192=211:211", "198:198=231:231"
  Projectile
  DamageType "Marksman"
  Obituary "$OB_40D"
  +SKYEXPLODE
  +EXPLODEONWATER
  // +EXPLODEONDEATH
  Damage (80)
  Radius 12
  Height 12
  Speed 80
  Scale 3.0
  Args 40, 96, 24
  States {
   Spawn:
    6P40 AAAAAAAA 1
    6P40 A 0 A_SetUserVar("user_d", -1)
    6P40 A 1 A_SpawnItemEx("MarksmanBulletDeathFX", 0, 0, 0, 0, 0, 0, 0, 1)
    wait
   Death:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(user_d == -1, "Death1")
    TMFX ABCD 2
    stop
   Death1:
    TNT1 A 0 A_SetScale(2.0)
    TNT1 A 0 A_PlaySound("CowboyKid/Bomb", 1)  // Pokemon/Bide
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}
actor S_MarksmanBulletDeath : MarksmanBulletDeath {
  Damage (120)
  Args 60, 96, 24
}

actor MarksmanBulletDeathFX : BasicClientSide {
  Scale 1.5
  States {
   Spawn:
    TNT1 A 2
    TMFX ABCD 1
    stop
  }
}

actor Corpse_40 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_40_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_40_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_40_0 : BaseCorpseFX {States {Spawn: 1H40 O 350
    goto Spawn2}}
actor Corpse_40_1 : BaseCorpseFX {States {Spawn: 1H40 P 350
    goto Spawn2}}
actor Corpse_40_2 : BaseCorpseFX {States {Spawn: 1H40 Q 350
    goto Spawn2}}
actor Corpse_40_3 : BaseCorpseFX {States {Spawn: 1H40 R 350
    goto Spawn2}}
actor Corpse_40_4 : BaseCorpseFX {States {Spawn: 1H40 S 350
    goto Spawn2}}
actor Corpse_40_5 : BaseCorpseFX {States {Spawn: 1H40 T 350
    goto Spawn2}}
actor Corpse_40_6 : BaseCorpseFX {States {Spawn: 1H40 U 350
    goto Spawn2}}

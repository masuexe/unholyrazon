TNT1 A 0 A_FireCustomMissile("S_MiuCannonShot",0,0,0,0)
TNT1 A 0 A_FireCustomMissile("S_MiuCannonShot",-15,0,0,0,1)
TNT1 A 0 A_FireCustomMissile("S_MiuCannonShot",15,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing3",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,0,40)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
stop
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing3",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,15,40)
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing3",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,-15,40)
stop
}
}

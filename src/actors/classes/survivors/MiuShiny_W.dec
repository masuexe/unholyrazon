actor MiuShiny_W_ScriptBar : ScriptBar {}

actor MiuShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Miu_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_56_A"
Obituary "$OB_56W1"
weapon.ammotype2 "MiuEnergyAmmo"
weapon.ammotype "MiuCannonAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H56 [ 6
loop

Deselect:
7H56 A 0
goto DeselectSwap
Select:
7H56 A 0 A_TakeInventory("WeaponCharge")
goto SelectSwap

Ready:
7H56 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", MIU_SDYE)
7H56 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
7H56 A 0 A_JumpIfInventory("MiuDashFlag",1,1)
goto Ready2
7H56 A 0 A_GiveInventory("Miu_RavagerEnd_P")
goto Ready2
Ready1:
7H56 A 20 A_WeaponReady(WRF_NOSECONDARY)
Ready2:
7H56 A 2 A_GiveInventory("Miu_Ready_P")
loop


Fire:
6H56 A 0 A_GunFlash("NoFlash", 1)
7H56 C 0 A_JumpIfInventory("VivifyFlag1",1,"AltEndF")
7H56 C 2 A_GiveInventory("S_Miu_Fire1_P1")
7H56 D 2 A_GiveInventory("S_Miu_Fire1_P2")
7H56 E 2 A_GiveInventory("S_Miu_Fire1_P3")
7H56 F 2 A_GiveInventory("S_Miu_Fire1_P4")
TNT1 A 2 A_GiveInventory("S_Miu_Fire1_P5")
TNT1 A 4
7H56 RS 2
7H56 T 2 A_Refire("FireHStart")
Goto Ready2

Flash:
TNT1 A 2 A_GiveInventory("Miu_FireHold_P")
loop

FireHStart:
7H56 A 0 A_GunFlash("Flash",1)
7H56 B 1
7H56 B 0 A_Refire("FireH")
Goto Fire
FireH:
7H56 C 0 A_JumpIfInventory("WeaponCharge",20,"FireH0")
7H56 C 1
7H56 C 0 A_Refire("FireH")
Goto Fire
FireH0:
7H56 G 0 A_PlaySound("wep/MiuCharge",1)
FireH1:
7H56 G 1
7H56 C 0 A_Refire(1)
Goto FireSwordSpin
7H56 G 1 A_RailWait
7H56 C 0 A_Refire(1)
Goto FireSwordSpin
7H56 C 1
7H56 C 0 A_Refire(1)
Goto FireSwordSpin
7H56 C 1 A_RailWait
7H56 C 0 A_Refire("FireH1")
Goto FireSwordSpin

FireSwordSpin:
7H56 H 0 A_GiveInventory("S_Miu_Fire2_P")
7H56 HIJK 1
7H56 ZZZZZZ 1
7H56 LMNODPQ 1
7H56 Z 7
7H56 RS 2
7H56 T 2 A_Refire("FireHStart")
goto Ready2

Altfire:
TNT1 A 0 A_GiveInventory("Miu_RavagerStart_P")
TNT1 A 0 A_Refire(1)
TNT1 A 0 A_GunFlash("NoFlash",1)
TNT1 AAAAAAAAAA 2 A_GiveInventory("S_Miu_Ravager_P")
TNT1 A 2 A_GiveInventory("Miu_RavagerHalt_P")
TNT1 A 1 A_JumpIfInventory("MiuEnergyAmmo",1,"AltIdle")
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_ATTACK,"AltEndF")
goto AltEnd
AltIdle:
TNT1 A 0 A_GiveInventory("Miu_RavagerHalt_P2")
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_GiveInventory("S_Miu_RavagerIdle_P")
goto AltEnd
AltEndF:
TNT1 A 0 A_GiveInventory("S_Miu_AltEndF_P")
AltEnd:
TNT1 A 0 A_GiveInventory("Miu_RavagerEnd_P")
TNT1 A 0 A_Refire(1)
TNT1 A 4
7H56 RST 2
goto Ready1



BotSwap:
7H56 A 0 A_PlaySoundEx("classes/taunt/miu","Voice")
7H56 A 1 A_GiveInventory("MiuCannonAmmo",random(1,4)*25)
//7H56 A 0 A_SelectWeapon("S_Miu_W2")
goto BotReady
BotSwap_2:
7H56 A 0 A_PlaySoundEx("classes/taunt/miu","Voice")
7H56 A 1 A_GiveInventory("MiuEnergyAmmo",random(1,4)*50)
//7H56 A 0 A_SelectWeapon("MiuShiny_W")
goto BotReady
BotReady:
7H56 A 0 A_WeaponReady(12)
7H56 A 2 A_Refire("S_Bot_F")
7H56 A 0 A_GiveInventory("MiuEnergyAmmo",3)
7H56 A 0 A_GiveInventory("MiuCannonAmmo",2)
loop

S_Bot_F:
7H56 A 0 A_JumpIfCloser(512,"Bot_F")
7H56 A 0 A_Jump(32,"Bot_F")
goto Bot_F_2

Bot_F:
7H56 A 0 A_JumpIfInventory("MiuDashFlag",1,"Bot_A2")
7H56 A 0 A_JumpIfInventory("MiuEnergyAmmo",0,"Bot_A")
7H56 A 0 A_Jump(16,2)
7H56 A 0 A_Jump(32,"BotSwap")
goto BotFire1
7H56 A 0 A_PlaySoundEx("classes/taunt/miu","Voice")
7H56 A 0 A_GiveInventory("MiuEnergyAmmo",random(60,240))
7H56 A 0 A_GiveInventory("MiuCannonAmmo",random(30,120))
goto Bot_F+3

Bot_A:
7H56 A 0 A_Jump(96,"BotAlt")
goto Bot_F+2
Bot_A2:
7H56 A 0 A_Jump(56,"BotAltEnd")
7H56 A 0 A_FaceTarget
7H56 A 0 A_Jump(32,1)
goto BotAlt
7H56 A 0 A_PlaySoundEx("classes/taunt/miu","Voice")
7H56 A 0 A_GiveInventory("MiuEnergyAmmo",random(2,6)*30)
goto BotAlt

Bot_F_2://Wep2
7H56 U 0 A_JumpIfInventory("MiuCannonAmmo",0,"Bot_A_2")
7H56 U 0 A_GiveInventory("MiuCannonAmmo",random(6,12))
7H56 U 0 A_Jump(10,"BotSwap_2")
7H56 U 0 A_Jump(24,"BotAlt_2")
7H56 U 0 A_Jump(11,1)
goto BotFire_2
7H56 U 0 A_PlaySoundEx("classes/taunt/miu","Voice")
7H56 U 0 A_GiveInventory("MiuEnergyAmmo",random(30,120))
7H56 U 0 A_GiveInventory("MiuCannonAmmo",random(15,60))
goto BotFire_2
Bot_A_2:
7H56 U 0 A_Jump(78,"BotAlt_2")
goto Bot_F_2+1

BotFire1:
7H56 C 0 A_Jump(224,2)
7H56 C 0 A_Recoil(-15)
7H56 C 2 A_GiveInventory("S_Miu_Fire1_P1")
7H56 D 2 A_GiveInventory("S_Miu_Fire1_P2")
7H56 E 2 A_GiveInventory("S_Miu_Fire1_P3")
7H56 F 2 A_GiveInventory("S_Miu_Fire1_P4")
7H56 Z 2 A_GiveInventory("S_Miu_Fire1_P5")
7H56 ZZRS 2
7H56 T 0 A_GiveInventory("MiuEnergyAmmo",20)
7H56 T 2 A_Refire(1)
Goto BotReady
7H56 A 0 A_Jump(96,"Bot_F")
goto BotFireH

BotFire2:
7H56 H 0 A_GiveInventory("S_Miu_Fire2_P")
7H56 HIJK 1
7H56 ZZZZZZ 1
7H56 LMNODPQZ 1
7H56 ZZZRST 2
goto BotReady

BotFireH:
7H56 C 0 A_JumpIfInventory("WeaponCharge",20,"BotFireH0")
7H56 C 0 A_Recoil(-2.5)
7H56 C 2 A_GiveInventory("WeaponCharge",2)
7H56 C 0 A_Refire("BotFireH")
Goto BotFire1
BotFireH0:
7H56 G 0 A_GiveInventory("MiuEnergyAmmo",20)
7H56 G 0 A_PlaySound("wep/MiuCharge",1)
BotFireH1:
7H56 G 0 A_Recoil(-2.5)
7H56 G 1 A_Jump(32,"BotFire2")
7H56 G 0 A_Refire("BotFireH1")
Goto BotFire2

BotAlt:
TNT1 A 0 A_GiveInventory("Miu_RavagerStart_P")
TNT1 A 0 A_Refire(1)
TNT1 AAAAAAAAAA 2 A_GiveInventory("S_Miu_Ravager_P")
TNT1 A 2 A_GiveInventory("Miu_RavagerHalt_P")
TNT1 A 1 A_JumpIfInventory("MiuEnergyAmmo",1,1)
goto BotAltEnd
TNT1 A 2 A_Refire("Bot_A2")
goto BotAltEnd
BotAltEnd:
TNT1 A 0 A_GiveInventory("Miu_RavagerEnd_P")
TNT1 A 0 A_Refire(1)
TNT1 A 4
7H56 RST 2
goto BotReady

BotFire_2:
7H56 U 0 A_GiveInventory("S_Miu_Fire3_P")
7H56 U 0 A_Refire(1)
7H56 WVU 2
Goto BotReady

BotAlt_2:
7H56 U 0 A_GiveInventory("S_Miu_Alt2_P")
7H56 U 0 A_Refire(1)
7H56 WV 5
7H56 U 4
goto BotReady
}
}


actor S_Miu_Fire1_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_PlaySound("wep/MiuSword",1)
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing1",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,0,40)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
stop
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing1",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,15,40)
TNT1 A 0 A_SpawnItemEx("S_MiuSlashing1",cos(-pitch)*52,0,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,-15,40)
stop
}
}

actor S_Miu_Fire2_P : Miu_Fire2_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("MiuSpinTrailFX_H",0,0,0,0,0,0,-30,1)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE),2)
TNT1 A 0 A_FireCustomMissile("S_MiuSpinExplosion",-30,0,0,0)
goto Thrust
TNT1 A 0 A_FireCustomMissile("S_MiuSpinExplosion2",-30,0,0,0)
TNT1 A 0 A_FireCustomMissile("S_MiuSpinExplosion2",-60,0,0,0)
goto Thrust
}
}

actor S_Miu_AltEndF_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("MiuCannonAmmo",0,2)
TNT1 A 0 A_GiveInventory("S_Miu_Fire3_P")
stop
TNT1 A 0 A_GiveInventory("S_Miu_Alt2_P")
stop
}
}
actor S_Miu_Fire3_P : Miu_Fire3_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_MiuCannonShot",0,0,0,0)
goto End
}
}
actor S_Miu_Alt2_P : Miu_Alt2_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_MiuKittyBombToss",0,0,0,0)
goto End
}
}

actor S_Miu_Ravager_P : Miu_Ravager_P
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("S_MiuRavager",0,0,32,momx,momy,momz,0,8)
goto Miu_Ravager_P::Pickup+1
}
}
actor S_Miu_RavagerIdle_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(WRF_DISABLESWITCH)
TNT1 A 0 A_SpawnItemEx("S_MiuRavager2",0,0,32,momx,momy,momz,0,8)
TNT1 A 0 A_TakeInventory("MiuDashFlag",1)
stop
}
}

actor S_MiuRavager : MiuRavager
{
Translation "192:192=248:248","198:198=164:164","202:202=160:160","199:199=228:228"
Args 144,128,14//96
}

actor S_MiuRavager2 : S_MiuRavager
{
Obituary "$OB_56A2"
Args 60,96,8//40
}

actor S_MiuSlashing1 : MiuSlashing1
{
Translation "192:192=160:160","198:198=228:228"
Args 98,88,0//65
}

actor S_MiuSlashing2 : S_MiuSlashing1
{
States
{
Spawn:
X_7F B 0
goto SpawnB
}
}

actor S_MiuSlashing3 : S_MiuSlashing1
{
States
{
Spawn:
X_7F C 0
goto SpawnB
}
}

actor S_MiuSlashing4 : S_MiuSlashing1
{
States
{
Spawn:
X_7F D 0
goto SpawnB
}
}

actor S_MiuSlashing5 : S_MiuSlashing1
{
States
{
Spawn:
X_7F E 0
goto SpawnB
}
}


actor S_MiuSpinExplosion : MiuSpinExplosion
{
Translation "192:192=160:160","198:198=228:228"
Args 120,128,128,30//80
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Warp(2,0,0,32,Args[3],4+8+16)
TNT1 A 0 A_PlaySound("KirbyNES/Shotzo",4,0.5)
TNT1 A 0 A_SpawnItemEx("S_MiuCannonShot",0,0,0,90,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("MiuSpinExplosionFX",85,0,0,0,0,0,0,1)
TNT1 A 1 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_CountDown
loop
}
}
actor S_MiuSpinExplosion2 : S_MiuSpinExplosion
{
ReactionTime 7
Args 120,128,128,60//80
}


Actor S_MiuCannonShot : MiuCannonShot
{
Translation "192:192=228:228","198:198=233:233"
Damage (38)//25
}


actor S_MiuKittyBombToss : MiuKittyBombToss
{
Translation "192:192=228:228","198:198=233:233"
Args 300,128,96,2//200
States
{
Death2:
TNT1 A 0 A_PlaySoundEx("V_Man/Boom",1)
TNT1 A 0 A_Explode(Args[0]*2,Args[1]*1.5,0,0,Args[2]*1.5)
TNT1 A 0 A_SpawnItemEx("S_MiuKittyBomb2_H",0,0,16,0,0,0,0,1)
TNT1 A 2 A_SpawnItemEx("BasicBoom1FX_XB",0,0,16,0,0,0,0,1)
stop
}
}

actor S_MiuKittyBomb2_H : MiuKittyBomb2_H
{
States
{
Spawn:
TNT1 A 0
goto SpawnL
SpawnL:
TNT1 A 0 A_SpawnItemEx("MiuKittyBombFX2",0,0,0,12,0,0,0+Args[0]*45,1)
TNT1 A 0 A_SpawnItemEx("S_MiuKittyBomb2",4,0,0,4,0,10.5,0+Args[0]*45,1)
TNT1 A 0 A_CountDownArg(0)
loop
}
}
actor S_MiuKittyBomb2 : MiuKittyBomb2
{
Damage(15)//10
Args 24,64,64//16
}


actor IgniterShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Igniter_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_10"
Obituary "$OB_10W"
weapon.ammotype "IgniteEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H10 [ 6
loop

Deselect:
7H10 A 0
goto DeselectSwap
Select:
7H10 A 0
goto SelectSwap

Ready:
7H10 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", IGNITER_SDYE)
goto Ready2
Ready2:
7H10 A 2 A_GiveInventory("Igniter_Ready_P")
loop

Fire:
7H10 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H10 B 0 A_GiveInventory("S_Igniter_Fire_P")
7H10 CBA 4
7H10 A 14 A_GiveInventory("IgniteEnergyAmmo",3)
Goto Ready2

AltFire:
7H10 A 0 A_GiveInventory("VivifyFlag1")
7H10 BC 2 A_GiveInventory("S_Igniter_Alt_P")
Burst:
7H10 BC 2 A_GiveInventory("S_Igniter_Alt_P")
7H10 B 0 A_ReFire(1)
Goto NoAmmoX
7H10 B 0 A_JumpIfInventory("IgniteEnergyAmmo",1,1)
Goto NoAmmoX
7H10 BC 2 A_GiveInventory("S_Igniter_Alt_P")
7H10 B 0 A_ReFire(1)
Goto NoAmmoX
7H10 B 0 A_JumpIfInventory("IgniteEnergyAmmo",1,"Burst")
Goto NoAmmoX
NoAmmoX:
7H10 B 4
7H10 A 4 A_TakeInventory("VivifyFlag1")
Goto Ready2

BotFire:
7H10 A 0 A_GiveInventory("IgniteEnergyAmmo",8)
7H10 A 0 A_Jump(16,"BotFire3")
7H10 A 0 A_JumpIfCloser(500,"BotFire2")
7H10 A 0 A_Jump(96,"Burst")
7H10 A 0 A_Jump(24,"BotFire1")
goto Fire+1
BotFire1:
7H10 A 0 A_JumpIfInventory("IgniterFlag",28,2)
7H10 A 2 A_GiveInventory("IgniterFlag",2)
loop
7H10 A 0
goto Fire+1
BotFire2:
7H10 A 0 A_JumpIfCloser(196,"Burst")
goto Fire+1
BotFire3:
7H10 B 0 A_PlaySoundEx("classes/taunt/igniter","Voice")
7H10 BCBCBCBCBC 0 A_GiveInventory("S_Igniter_Alt_P")
7H10 C 0 A_PlaySound("weapon/firestorm",1)
7H10 CB 4 A_GiveInventory("IgniteEnergyAmmo",25)
7H10 A 18
Goto Ready2

}
}

actor S_Igniter_Fire_P : Igniter_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("IgniterFlag",28,"Fire2")
TNT1 A 0 A_PlaySound("weapon/firestorm",1)
TNT1 A 0 A_FireCustomMissile("S_IgniterShot",0,0,8,0)
goto End
Fire2:
TNT1 A 0 A_PlaySound("weapon/magmabazooka",1)
TNT1 A 0 A_FireCustomMissile("S_IgniterShot2",0,0,8,0)
goto End
}
}

actor S_Igniter_Alt_P : Igniter_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("misc_L/magmaflameloop",1)
TNT1 A 0 A_FireCustomMissile("S_IgniterFlames",frandom(-1,1),0,8,-6,1,frandom(-1,1))
goto End
}
}

actor S_IgniterShot : IgniterShot
{
Translation "192:192=196:196","198:198=197:197"
Damage (246)//164
Args 150,128,16//100
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAAA 0 A_SpawnItemEx("IgniterShotBit",0,0,0,random(1,15),0,random(1,15)*Args[4],random(0,359),1)
goto DeathEnd
}
}

actor S_IgniterShot2 : IgniterShot2
{
Translation "192:192=196:196","198:198=197:197"
Damage (492)//328
Args 300,128,16//200
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("S_IgniterShotBit",0,0,0,random(1,20),0,random(1,20)*Args[4],random(0,359),1)
goto DeathEnd
}
}

actor S_IgniterShotBit : IgniterShotBit
{
damage (113)//75
}


actor S_IgniterFlames : IgniterFlames
{
Translation "192:192=196:196","198:198=197:197"
damage (138)//92
states
{
Death:
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_JumpIf(Args[0]<=0,"DeathFX")
TNT1 A 0 A_SpawnItemEx("S_IgniterFlamesSit",0,0,0,0,0,0,0,1+SXF_TRANSFERSPECIAL)//32768
TNT1 A 1
stop
}
}

actor S_IgniterFlamesSit : IgniterFlamesSit
{
damage (138)//92
}

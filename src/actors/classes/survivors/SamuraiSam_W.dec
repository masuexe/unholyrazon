actor SamuraiSam_W_ScriptBar : ScriptBar {}

actor SamuraiSam_W : BaseMM8BDMWep_UH
{//乇乂ㄒ尺卂 ㄒ卄丨匚匚
Weapon.AmmoUse 0
Weapon.AmmoGive 56
Inventory.Pickupmessage "$PU_33"
Obituary "$OB_33W"
Tag "$TAG_SamuraiSam_W"
weapon.ammotype "FoolishSamuraiWarriorAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H33 [ 6
loop

Deselect:
6H33 A 0
goto DeselectSwap
Select:
6H33 A 0
goto SelectSwap

Ready:
6H33 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE)
Goto Ready2
Ready2:
6H33 A 4 A_GiveInventory("SamuraiSam_Ready_P")
loop

Fire:
6H33 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H33 A 0
//6H33 F 1 ACS_NamedExecuteAlways("uc_SamuraiSetUser",0,angle,pitch,(65536 * 2))//2/3
6H33 F 0 ACS_NamedExecuteWithResult("uc_SamuraiSetUser",angle,pitch,(65536 * 2))//2/3
goto FireH
FireH:
6H33 F 1 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")
6H33 F 0 A_Refire("FireH")
//6H33 FFFFF 1 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")//20
//6H33 F 0 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")
goto FireStab
FireStab:
// 6H33 K 2 A_GiveInventory("SamuraiSam_Fire1_P")
// 6H33 L 2
// 6H33 F 6
// 6H33 A 2 OffSet(-48,88)
// 6H33 A 2 OffSet(-28,65)
// 6H33 A 2 OffSet(-12,47)
// 6H33 A 2 OffSet(-5,38)
6H33 F 0 A_GiveInventory("SamuraiSam_Fire1_P")
6H33 F 1 A_WeaponReady(14)
6H33 G 1
6H33 G 1 OffSet(-23,65)
6H33 H 3 A_WeaponReady(14)
TNT1 A 6 OffSet(0,92)
6H33 A 1 OffSet(0,92)
6H33 A 1 OffSet(0,82)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H33 A 1 OffSet(0,72)
6H33 A 1 OffSet(0,62)A_JumpIfInventory("PlayerPropertyRage",1,1)
6H33 A 1 OffSet(0,52)
6H33 A 1 OffSet(0,42)A_JumpIfInventory("PlayerPropertyRage",1,1)

goto Ready2
FireAimSlash:
6H33 B 1 A_GiveInventory("SamuraiSam_Fire2_P")
6H33 C 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H33 C 1 Offset(-43, 36)
6H33 D 0 A_WeaponReady(14)
6H33 D 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H33 D 1 Offset(-48, 33)
6H33 E 0 A_WeaponReady(14)
6H33 E 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H33 E 1 Offset(-43, 43)
6H33 E 1 Offset(-102, 53) A_JumpIfInventory("PlayerPropertyRage",1,1)
TNT1 A 8 OffSet(-146,149)
6H33 A 1 OffSet(-127,142)
6H33 A 1 OffSet(-108,135) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
6H33 A 1 OffSet(-88,127)
6H33 A 1 OffSet(-71,118) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
6H33 A 1 OffSet(-54,108)
6H33 A 1 OffSet(-40,195) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
6H33 A 1 OffSet(-27,87)
6H33 A 1 OffSet(-18,70) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
6H33 A 1 OffSet(-9,54)
6H33 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Ready2")
6H33 A 1 A_WeaponReady(14)
goto Ready2

BotFire:
6H33 A 0 A_JumpIfInventory("FoolishSamuraiWarriorAmmo",28,"BotFire0")
6H33 A 0 A_GiveInventory("FoolishSamuraiWarriorAmmo",random(2,5))
6H33 A 0 A_Jump(16,"BotFire3")
6H33 F 1 ACS_NamedExecuteAlways("uc_SamuraiSetUser",0,angle,pitch,(65536 * 2))
goto BotFire1
BotFire0:
6H33 A 0 A_JumpIfInventory("FoolishSamuraiWarriorAmmo",56,2)
6H33 A 0 A_Jump(64,1)
goto BotFire+1
6H33 A 0 A_ChangeVelocity(random(12,30),20*(random(0,1)*2-1),0,1)
goto Altfire
BotFire1:
6H33 F 0 A_JumpIfCloser(200,"FireStab")
6H33 F 0 A_Jump(4,"BotFire2")
6H33 F 0 A_Jump(1,3)
6H33 F 1 A_JumpIf(CallACS("uc_SamuraiCheckDrag",angle,pitch,15)==2,"FireAimSlash")
6H33 F 0 A_ReFire("BotFire1")
goto FireStab
6H33 F 0 A_ChangeVelocity(8,30*(random(0,1)*2-1),0,1)
6H33 F 0 A_GiveInventory("PowerSamuraiDodgeSpeed",1)
goto BotFire1+3
BotFire2:
6H33 F 0 A_FaceTarget
goto FireStab
BotFire3:
6H33 A 0 A_Recoil(-50)
6H33 A 0 A_GiveInventory("FoolishSamuraiWarriorAmmo",56)
6H33 A 0 A_GiveInventory("PowerSamuraiBotSpeed",1)
6H33 A 0 A_PlaySoundEx("taunt/D_33","Voice")
6H33 A 0 A_FaceTarget
goto BotFire+3

AltFire:
6H33 A 0 A_GiveInventory("SamuraiSamAlt_P")
6H33 A 0 A_ReFire(1)
6H33 S 1 OffSet(2,40)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(5,51)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 S 1 OffSet(9,65)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(14,82)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 S 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 S 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(20,102)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 S 1 OffSet(14,82)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(9,65)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 S 1 OffSet(5,51)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE2,1)
6H33 A 1 OffSet(2,40)ACS_NamedExecuteWithResult("core_weaponcolor", SAMURAISAM_DYE,1)
6H33 A 0 A_GiveInventory("SamuraiSamAlt_P2")
6H33 A 2 A_WeaponReady(8)
Goto Ready2
}
}


}


actor SamuraiSam_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("FoolishSamuraiWarriorAmmo",28,2)
TNT1 A 0 A_WeaponReady(8)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("FoolishSamuraiWarriorAmmo",1)
stop
}
}

actor SamuraiSam_Fire1_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("SamuraiSamStab",0,0,0,8)
TNT1 A 0 A_FireCustomMissile("SamuraiSamStabFX",0,0,0,8)
TNT1 A 0 A_FireCustomMissile("SamuraiSamStabSnd",0,0,0,8)
TNT1 A 0 A_PlaySound("Shin_3/Swipe",1,0.725)
stop
}
}

actor SamuraiSam_Fire2_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("Shin_1/Swipe",1,0.85)
TNT1 A 0 A_GiveInventory("SamuraiSamFlag",25)
goto AimSlash

SlashAdjust:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_SamuraiAddonUser")
TNT1 A 0 A_TakeInventory("SamuraiSamFlag",1)
AimSlash:
TNT1 A 0 A_SpawnItemEx("SamuraiSamSlashBit1",0,0,32,cos(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,0,sin(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,CallACS("uc_SamuraiGetUser",0)/65536.0f-angle,32,0)
//TNT1 A 0 A_FireCustomMissile("SamuraiSamSlashBit1",CallACS("uc_SamuraiGetUser",0)/65536.0f-angle,0,0,0,0,pitch-CallACS("uc_SamuraiGetUser",1)/65536.0f)
TNT1 A 0 A_JumpIfInventory("SamuraiSamFlag",1,"SlashAdjust2")
stop
SlashAdjust2:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_SamuraiAddonUser")
TNT1 A 0 A_TakeInventory("SamuraiSamFlag",1)
AimSlash2:
TNT1 A 0 A_SpawnItemEx("SamuraiSamSlashBit2",0,0,32,cos(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,0,sin(-CallACS("uc_SamuraiGetUser",1)/65536.0f)*60,CallACS("uc_SamuraiGetUser",0)/65536.0f-angle,32,0)
TNT1 A 0 A_JumpIfInventory("SamuraiSamFlag",1,"SlashAdjust")
stop
}
}

actor SamuraiSamAlt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("PowerSamuraiDodgeSpeed",1)
TNT1 A 0 A_GiveInventory("PowerSamuraiBurstSpeed",1)
TNT1 A 0 A_GiveInventory("VivifyDelay3",1)
TNT1 A 0 A_TakeInventory("FoolishSamuraiWarriorAmmo",14,1)
TNT1 A 0 A_TakeInventory("FoolishSamuraiWarriorAmmo",14)
TNT1 A 0 A_PlaySoundEx("Shin_1/FoeJump","Weapon")
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
TNT1 A 0 ACS_NamedExecuteWithResult("core_nonshootableplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_noradiusdmgplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
stop
}
}
actor SamuraiSamAlt_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_nonshootableplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_noradiusdmgplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
stop
}
}



actor GreatShielder_W_NormalBar : NormalBar { Args 138, 130 }

actor GreatShielder_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 200
Inventory.Pickupmessage "$PU_05"
Obituary "$OB_05W"
Tag "$TAG_GreatShielder_W"
weapon.ammotype "TurtleEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H05 [ 6
loop

Deselect:
6H05 A 0 A_GiveInventory("StopShield")
goto DeselectSwap
Select:
6H05 A 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
6H05 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GREATSHIELDER_DYE)
6H05 A 1
6H05 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",200,"Ready3")
6H05 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H05 A 0 A_GiveInventory("TurtleEnergyAmmo",3)
loop
Ready3:
6H05 A 2 A_WeaponReady
6H05 A 0 A_GiveInventory("TurtleEnergyAmmo",3)
loop

Flash:
6H05 WV 2
Flash_Ready:
6H05 U 0 A_GiveInventory("GreatShieldHitbox_P")
goto Flash.Idle
Flash.Idle:
6H05 U 0 A_SpawnItemEx("GreatShieldFX",23,-17,5,momx,momy,momz,0,1+8)
6H05 U 0 A_JumpIfInventory("GreatShielderFlag",1,"Flash_CrushAttack")
6H05 U 1 A_JumpIfInventory("StopShield",1,1)
loop
6H05 VW 2
stop
Flash_CrushAttack:
6H05 X 1
6H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-13,5,momx,momy,momz,0,1+8)
6H05 X 1
6H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-9,5,momx,momy,momz,0,1+8)
6H05 Y 1
6H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-5,5,momx,momy,momz,0,1+8)
6H05 Y 1 A_TakeInventory("GreatShielderFlag")
6H05 Y 0 A_SpawnItemEx("GreatShieldFX",23,-5,5,momx,momy,momz,0,1+8)
6H05 Y 1
6H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-9,5,momx,momy,momz,0,1+8)
6H05 X 1
6H05 X 0 A_SpawnItemEx("GreatShieldFX",23,-13,5,momx,momy,momz,0,1+8)
6H05 X 1
goto Flash.Idle

Fire:
6H05 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H05 B 2 A_GiveInventory("StopShield")
6H05 C 2 A_GiveInventory("TurtleEnergyAmmo",4)
6H05 E 0 A_GiveInventory("GreatShielderMainF_P")
6H05 EEE 4 A_GiveInventory("TurtleEnergyAmmo",4)
6H05 D 2 A_GiveInventory("TurtleEnergyAmmo",4)
6H05 C 2 A_TakeInventory("StopShield")
6H05 B 0 A_GunFlash("Flash",1)
6H05 B 2 A_GiveInventory("TurtleEnergyAmmo",4)
6H05 A 2
6H05 A 2 A_GiveInventory("TurtleEnergyAmmo",2)
6H05 A 0 A_GiveInventory("TurtleEnergyAmmo",2)
Goto Ready2
AltFire:
6H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",200,"CrushAttack")
goto Ready2
CrushAttack:
6H05 F 0 A_TakeInventory("TurtleEnergyAmmo",125,1)
6H05 F 0 A_TakeInventory("TurtleEnergyAmmo",75)
6H05 F 0 A_GiveInventory("GreatShielderFlag")
6H05 F 1
6H05 F 0 A_PlaySoundEx("weapon/chargekick","Weapon")
6H05 F 1 A_ChangeVelocity(Cos(pitch)*4+3, 0, -sin(pitch)*2.3,CVF_RELATIVE)
6H05 G 0 A_SpawnItemEx("GreatBumRush",0,0,32,momx,momy,momz,0,8)
6H05 G 1 A_ChangeVelocity(Cos(pitch)*5+4, 0, -sin(pitch)*3,CVF_RELATIVE)
6H05 G 0 A_SpawnItemEx("GreatBumRush",0,0,32,momx,momy,momz,0,8)
6H05 G 1 A_ChangeVelocity(Cos(pitch)*6+5, 0, -sin(pitch)*3.6,CVF_RELATIVE)
6H05 G 0 A_SpawnItemEx("GreatBumRush",0,0,32,momx,momy,momz,0,8)
6H05 G 1 A_ChangeVelocity(Cos(pitch)*7+6, 0, -sin(pitch)*4.3,CVF_RELATIVE)
6H05 G 0 A_SpawnItemEx("GreatBumRush",0,0,32,momx,momy,momz,0,8)
6H05 G 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire6")
6H05 FFAAAA 1
Goto Ready2




BotFire:
6H05 A 0 A_Jump(12,"BotFire3")
6H05 A 0 A_JumpIfInventory("TurtleEnergyAmmo",100,"BotFire2")
goto Fire+1
BotFire2:
6H05 A 0 A_Jump(128,2)
6H05 A 0 A_Jump(64,"BotFire5")
goto Fire+1
6H05 A 0 A_TakeInventory("TurtleEnergyAmmo",80)
goto CrushAttack+2

BotFire3:
6H05 A 0 A_PlaySoundEx("classes/taunt/greatshielder","Voice")
6H05 A 0 A_PlaySound("weapon/mirrorabsorb")
6H05 A 0 A_GiveInventory("StopShield")
6H05 A 0 A_GiveInventory("BotFlagDelay",50)
6H05 BCDEEE 2
BotFire4:
6H05 E 0 A_PlaySoundEx("BBA_Snd/shotgun_x","Weapon")
6H05 E 0 A_GiveInventory("TurtleEnergyAmmo",1)
6H05 E 1 A_FireCustomMissile("ShotGunShot1",random(-10,10),0,8,0,0,random(-5,5))
6H05 E 1 A_FireCustomMissile("ShotGunShot2",random(-10,10),0,8,0,0,random(-5,5))
6H05 E 1 A_FireCustomMissile("ShotGunShot3",random(-10,10),0,8,0,0,random(-5,5))
6H05 E 0 A_TakeInventory("BotFlagDelay",1)
6H05 E 1 A_JumpIfInventory("BotFlagDelay",1,"BotFire4")
6H05 DC 2
6H05 B 0 A_TakeInventory("StopShield")
6H05 B 0 A_GunFlash("Flash",1)
6H05 BAA 2
Goto Ready2
BotFire5:
6H05 A 0 A_PlaySoundEx("classes/taunt/greatshielder","Voice")
6H05 A 0 A_PlaySound("weapon/mirrorabsorb")
6H05 A 0 A_GiveInventory("BotFlagDelay",6)
6H05 A 0 A_GiveInventory("Shocked",1)
6H05 A 0 A_TakeInventory("TurtleEnergyAmmo",50)
BotFire6:
6H05 A 10 A_FaceTarget
6H05 A 0 A_TakeInventory("BotFlagDelay",1)
6H05 A 1 A_FaceTarget
goto CrushAttack+2
}
}

actor TurtleEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor GreatShielderFlag : Once {}

actor GreatShielderMainF_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("BBA_Snd/shotgun_x","Weapon")
TNT1 A 0 A_FireCustomMissile("ShotGunShot1",0,0,8,0)
TNT1 AA 0 A_FireCustomMissile("ShotGunShot1",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("ShotGunShot1",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("ShotGunShot2",random(-10,0),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("ShotGunShot2",random(0,10),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("ShotGunShot3",random(0,10),0,8,0,0,random(-5,5))
TNT1 AA 0 A_FireCustomMissile("ShotGunShot3",random(0,10),0,8,0,0,random(-5,5))
stop
}
}

actor GreatShieldHitbox_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_SpawnItemEx("GreatShieldHitbox1",28,-24,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("GreatShieldHitbox2",28,-12,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("GreatShieldHitbox3",28,0,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("GreatShieldHitbox4",28,12,2,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("GreatShieldHitbox5",28,24,2,0,0,0,0,1)
stop
}
}

actor GreatShieldHitbox1 : BasicShieldHitbox
{
Meleerange 28
Accuracy -24
Mass 2

Radius 7
Height 52

//Radius 26//5
//Height 48//42
States
{
Pain:
TNT1 A 0 A_PlaySound("item/protoreflect")
TNT1 A 0 A_SpawnItemEx("GreatShieldDeathFX")
goto Spawn
}
}
actor GreatShieldHitbox2 : GreatShieldHitbox1
{
Accuracy -12
}
actor GreatShieldHitbox3 : GreatShieldHitbox1
{
Accuracy 0
}
actor GreatShieldHitbox4 : GreatShieldHitbox1
{
Accuracy 12
}
actor GreatShieldHitbox5 : GreatShieldHitbox1
{
Accuracy 24
}

actor GreatShieldDeathFX : ProtoShieldDeathFX
{
states
{
SpawnFrame:
6P05 C 0 A_SetScale(scaleX+0.1,2.5)
6P05 C 1 A_FadeOut(0.05)
loop
}
}

actor GreatShieldFX : ProtoShieldFX
{
States
{
Spawn:
6P05 A 0
6P05 A 1
stop
}
}


actor ShotGunShot1 : BasicFastProjectile
{
Translation "4:4=138:138","198:198=130:130"
damagetype "GreatShield"
Obituary "$OB_05M"
//+THRUGHOST
+RIPPER
+BLOODLESSIMPACT
+FORCEXYBILLBOARD
+BRIGHT
Damage (10)
radius 6
height 6
Speed 70
scale 2.5
States
{
Spawn:
TNT1 A 1
X_0D A 1
//X_0D A 0 A_ChangeFlag("THRUGHOST",0)
X_0D A 1
wait
Death:
X_0D A 1
stop
}
}

actor ShotGunShot2 : ShotGunShot1
{
Damage (14)
Speed 80
}

actor ShotGunShot3 : ShotGunShot1
{
Damage (6)
Speed 60
}

actor GreatBumRush : BasicExplosion_Args_Trio
{
Damagetype "GreatShieldStun"
Obituary "$OB_05A"
Args 125,80,20
}


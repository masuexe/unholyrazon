actor BusterMistress : CustWepClassBase {
  Player.ScoreIcon "UMUG_4"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "BusterMistress"
  Player.SoundClass "BusterMistress"
  Player.MaxHealth 950
  Health 950
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.10, 1.10
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "BusterMistress_W"
  Player.StartItem "SeductiveEnergyAmmo", 75
  States {
   Spawn:
    1H04 A 0
    1H04 B 1
    1H04 A 1
    goto Spawn+2
   See:
    1H04 BCDE 5
    goto Spawn
   Missile:
    1H04 FFFFF 1
    1H04 GGGG 1
    goto Spawn+2
   ClassPain:
    1H04 H 0
    goto MegamanPain

   ClassDeath:
    1H04 H 0
    goto MegamanDeath
   MegamanDisintegrate:
    1H04 Z 0 A_SpawnItemEx("Corpse_04", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor BusterMistressShiny : BusterMistress {
  Player.ScoreIcon "UMUG_S4"
  Player.MaxHealth 2950
  Health 2950
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.20, 1.20
  Player.JumpZ 13
  Player.MorphWeapon "BusterMistressShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_04 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_04_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_3", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_4", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_04_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


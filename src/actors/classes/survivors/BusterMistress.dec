actor BusterMistress : CustWepClassBase
{
player.scoreIcon "UMUG_4"
player.displayname "BusterMistress"
player.soundclass "SND04"
Player.Maxhealth 950
health 950
player.forwardmove 1.15, 1.15
player.sidemove 1.10, 1.10
player.jumpz 12
player.startitem "UH_BaseFlagPack"
player.startitem "BusterMistress_W"
player.startitem "SeductiveEnergyAmmo", 75
States
{
Spawn:
1H04 A 0
1H04 B 1
1H04 A 1
Goto Spawn+2
See:
1H04 BCDE 5
Goto Spawn
Missile:
1H04 FFFFF 1
1H04 GGGG 1
goto Spawn+2
ClassPain:
1H04 H 0
Goto MegamanPain

ClassDeath:
1H04 H 0
Goto MegamanDeath
ClassCorpse:
1H04 Z 0 A_SpawnItemEx("Corpse_04",0,0,0,momx,momy,momz,0,9)
Goto MegaDeathEndGib
}
}

actor BusterMistressS : BusterMistress

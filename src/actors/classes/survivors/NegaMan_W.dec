actor S_NegaDuckAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor S_NegaSlideAmmo_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("S_NegaDuckAmmo",0,"Pickup2")
TNT1 A 0 A_TakeInventory("S_NegaDuckAmmo",100)
stop
Pickup2:
TNT1 A 0 A_SpawnItemEx("S_NegaManSlide_H")
stop
}
}

actor S_NegaSlideDelay : Powerup
{
Powerup.Duration 20
}

actor S_NegaManSlide_H : BasicHelper
{
States
{
Spawn:
TNT1 A 1
TNT1 A 5 A_TakeFromTarget("S_NegaDuckAmmo",100)
goto Spawn2
Spawn2:
TNT1 A 0 A_JumpIfInTargetInventory("S_NegaSlideDelay",1,2)
TNT1 A 0 A_GiveToTarget("S_NegaDuckAmmo",3)
TNT1 A 1
TNT1 A 0 A_JumpIfInTargetInventory("S_NegaSlideDelay",1,"Spawn2")
TNT1 A 0 A_JumpIfInTargetInventory("S_NegaDuckAmmo",200,"Death")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
loop
Death:
TNT1 A 1
stop
}
}

Actor SNegaFlag : UOnce{ inventory.amount 1 inventory.maxamount 99 }
Actor S_NegaBHFlag : UOnce{ inventory.amount 1 inventory.maxamount 28 }
Actor ShieldCheckBH : ShieldCheck {}

actor S_NegaSlideBoost_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "Ground")
goto Air
Ground:
TNT1 A 0 A_Recoil(-70)
stop
Air:
TNT1 A 0 A_Recoil(-42)
stop
}
}

actor S_NegaChargeShot1 : NegaChargeShot1
{
PROJECTILE
damagetype "NegaBuster"
Obituary "%o was negated by %k's Nega Buster."
Damage (100) //80
radius 8
height 8
Speed 50
scale 2.5
}

actor S_NegaChargeShot2 : NegaChargeShot2
{
+RIPPER
Damage (100) //125
radius 14
height 14
Speed 60
}

actor S_NegaChargeShot3 : NegaChargeShot3
{
Obituary "%o was banished by %k's Nega Buster."
Damage (375)
Radius 18
Height 18
Scale 2.5
States
{
Spawn:
6P02 C 0
6P02 C 2 A_SpawnItemEx("ShinySparkleFX",random(8,24),0,Random(8,24),0,0,0,random(45,315),33) 
6P02 D 2 A_SpawnItemEx("ShinySparkleFX1",random(8,24),0,Random(8,24),0,0,0,random(45,315),33)
6P02 E 2 A_SpawnItemEx("ShinySparkleFX",random(8,24),0,Random(8,24),0,0,0,random(45,315),33)
6P02 B 2 A_SpawnItemEx("ShinySparkleFX1",random(8,24),0,Random(8,24),0,0,0,random(45,315),33)
goto Spawn+1
Death:
X_8B A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
X_8B A 0 A_ChangeFlag("NOGRAVITY",1)
X_8B A 0 A_Explode(375,192,0,0,32)
X_8B A 0 A_SetScale(1.5,1.5)
MXP4 GHIJKLMNOPQRS 1 
stop
}
}

actor S_NegaSlideKick : BasicExplosion
{
Obituary "%o was smacked by %k's \cfNega Kick\c-."
Damagetype "NegaKick"
Damage (0)
Speed 24
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_Explode(150,96,0,0,24)
stop
}
}


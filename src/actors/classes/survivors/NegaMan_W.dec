actor NegaMan_W_ScriptBar : ScriptBar {}

actor NegaMan_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 300
Weapon.SlotNumber 1
Inventory.Pickupmessage "$PU_02"
Obituary "$OB_02W"
Tag "$TAG_NegaMan_W"
weapon.ammotype "NegaManChargeAmmo"
weapon.ammotype2 "NegaDuckAmmo"
inventory.icon "C_I_02A"
States
{
Spawn:
6H02 [ 6
loop

Deselect:
6H02 A 0
goto DeselectSwap
Select:
6H02 A 0
goto SelectSwap

Ready:
6H02 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE)
6H02 A 0 A_JumpIfInventory("UOnce",1,"Ready2")
// 6H02 A 0 ACS_NamedExecuteWithResult("uh_GiveRandomCopyweps", 2)
6H02 A 0 A_GiveInventory("UOnce",1) //TheNegaFlag or handle this some other way
Goto Ready2

Ready2:
6H02 A 0 A_JumpIfInventory("NegaDuckAmmo",100,"Ready3")
6H02 A 2 A_WeaponReady(8)
6H02 A 0 A_GiveInventory("NegaDuckAmmo",3)
loop
Ready3:
6H02 A 2 A_WeaponReady
6H02 A 0 A_GiveInventory("NegaDuckAmmo",3)
loop

Fire:
Charge:
6H02 A 0
goto Charge0
Charge0:
6H02 A 0 A_JumpIfInventory("NegaManChargeAmmo",17,"Charge1")
6H02 A 0 A_JumpIfInventory("NegaManChargeAmmo",16,"ChargeStart")
6H02 A 0 A_JumpIfInventory("PowerRage_ST",1,"Charge0R")
6H02 A 1 A_GiveInventory("NegaManChargeAmmo",1)
6H02 A 0 A_Refire("Charge0")
goto Fire1
ChargeStart:
6H02 A 0 A_PlaySoundEx("weapon/pcharge","Weapon")
Goto Charge1
Charge0R:
6H02 A 1 A_GiveInventory("NegaManChargeAmmo",2)
6H02 A 0 A_Refire("Charge0")
goto Fire1

Charge1:
6H02 B 0 A_JumpIfInventory("NegaManChargeAmmo",44,"Charge2")
6H02 B 0 A_JumpIfInventory("PowerRage_ST",1,"Charge1R")
6H02 B 1 A_GiveInventory("NegaManChargeAmmo",1)
6H02 B 0 A_Refire("Charge1")
goto Fire2
Charge1R:
6H02 B 1 A_GiveInventory("NegaManChargeAmmo",2)
6H02 B 0 A_Refire("Charge1")
goto Fire2

Charge2:
6H02 C 1 A_RailWait
6H02 C 0 A_Refire("Charge2")
goto Fire3


Fire1:
6H02 A 0 A_TakeInventory("NegaManChargeAmmo")
6H02 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
6H02 A 0 A_FireCustomMissile("NegaChargeShot1",0,0,8,0)
6H02 BC 2
6H02 A 0 A_Refire("Charge")
Goto Ready2
Fire2:
6H02 B 0 A_TakeInventory("NegaManChargeAmmo")
6H02 B 0 A_PlaySoundEx("weapon/pshot","Weapon")
6H02 B 0 A_FireCustomMissile("NegaChargeShot2",0,0,8,0)
6H02 BC 3
6H02 A 1
6H02 A 0 A_Refire("Charge")
Goto Ready2
Fire3:
6H02 C 0 A_TakeInventory("NegaManChargeAmmo")
6H02 C 0 A_PlaySoundEx("weapon/pshot","Weapon")
6H02 C 0 A_FireCustomMissile("NegaChargeShot3",0,0,8,0)
6H02 CBA 3
6H02 A 1
6H02 A 0 A_Refire("Charge")
Goto Ready2

Altfire:
"----" "#" 0 A_JumpIfInventory("NegaDuckAmmo",100,"Altfire2")
"----" "#" 0 A_GiveInventory("NegaDuckAmmo",1)
goto Ready2
Altfire2:
"----" "#" 0 A_GiveInventory("SlideVivifyFlag")
"----" "#" 0 A_Refire(1)
"----" "#" 0 A_TakeInventory("NegaDuckAmmo",100)
"----" "#" 0 A_PlaySoundEx("weapon/chargekick","Weapon")
"----" "#" 0 A_GiveInventory("NegaSlideBoost_P",1)
// Weapon Offset drives both layers (flash sx/sy is forced to weapon).
// Foot 6S02*: T_baked = T+(W-F), F default (0,32); see TEXTURES comments.
// "----" "#" keeps the caller's ready sprite so other weapons can reuse this path.
"----" "#" 0 A_GunFlash("Flash_Slide")
"----" "#" 1 Offset(8, 40) A_TakeInventory("SlideVivifyFlag")  // no feet
"----" "#" 1 Offset(16, 48) A_FireCustomMissile("NegaSlideKick",0,0,0,0)  // feet start
"----" "#" 1 Offset(24, 56)
"----" "#" 1 Offset(40, 72)
"----" "#" 1 Offset(56, 88)
"----" "#" 1 Offset(74, 104)
"----" "#" 1 Offset(74, 102)
"----" "#" 1 Offset(70, 104)  // 5
"----" "#" 1 Offset(70, 102)
"----" "#" 3 Offset(54, 86)
"----" "#" 2 Offset(38, 70)
"----" "#" 2 Offset(22, 54)
"----" "#" 1 Offset(14, 46)
"----" "#" 1 Offset(6, 38)   // no feet
Goto Ready2

Flash_Slide:
TNT1 A 1
6S02 A 1  // Y T(-79,-81)              @ W(16,48)
6S02 B 1  // Y T(-71,-73)              @ W(24,56)
6S02 C 1  // Z T(-63,-81)              @ W(40,72)
6S02 D 1  // Z T(-55,-73)              @ W(56,88)
6S02 E 4  // Z T(-47,-65)+Offset bob   @ W(74,104)..(70,102)  // 8
6S02 D 3  // Z T(-55,-73)+Offset(-2,30) @ W(54,86)
6S02 C 2  // Z T(-63,-81)+Offset(-2,30) @ W(38,70)
6S02 B 2  // Y T(-71,-73)+Offset(-2,30) @ W(22,54)
6S02 A 1  // Y T(-79,-81)+Offset(-2,30) @ W(14,46)
stop
}
}

actor NegaManChargeAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 44
+INVENTORY.IGNORESKILL
}

actor NegaDuckAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 400
+INVENTORY.IGNORESKILL
}


actor NegaSlideBoost_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_JumpIf(z-floorz==0,"Ground")
goto Air
Ground:
TNT1 A 0 A_Recoil(-50)
stop
Air:
TNT1 A 0 A_Recoil(-28)
stop
}
}

actor NegaChargeShot1 : BasicProjectile
{
Translation "4:4=205:205","198:198=77:77"
damagetype "NegaBuster"
Obituary "$OB_02M1"
+BRIGHT
Damage (50)
radius 8
height 8
Speed 50
scale 2.5
States
{
Spawn:
TNT1 A 1
X_0D A 1
goto spawn+1
}
}

actor NegaChargeShot2 : NegaChargeShot1
{
Translation "210:210=77:77","4:4=205:205"
+BRIGHT
+RIPPER
Damage (80)
radius 14
height 14
Speed 60
States
{
Spawn:
6P02 AB 2
loop
}
}

actor NegaChargeShot3 : NegaChargeShot1
{
Translation "210:210=77:77", "4:4=205:205", "192:192=205:205", "198:198=77:77"
Obituary "$OB_02M2"
Damage (125)
radius 20
height 20
Speed 70
States
{
Spawn:
6P02 CDEB 2
loop
Death:
X_8B A 0 A_playSoundEx("weapon/crackerexplode","Weapon")
X_8B A 0 A_SetGravity(0.0)
X_8B A 0 A_Explode(200,128,0,0,20)
X_8B ABCDEF 2
stop
}
}

actor NegaSlideKick : BasicProjectile
{
Translation "198:198=77:77","192:192=205:205"
Obituary "$OB_02A"
damagetype "NegaKick"
damage (200)
Radius 14
Height 25
speed 60
scale 2.5
States
{
Spawn:
X_5F DEF 2
stop
}
}


actor HomingSeekerShiny_W_ScriptBar : ScriptBar {}

actor HomingSeekerShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_Shiny_HomingSeeker_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_13"
Obituary "$OB_13W"
weapon.ammotype "MagnetEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H13 [ 6
loop

Deselect:
7H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,1)
goto DeselectSwap
7I13 A 0
goto DeselectSwap
Select:
7H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,1)
goto SelectSwap
7I13 A 0
goto SelectSwap

Ready:
7H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "ReadyInitS")
ReadyInitN:
7H13 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE)
goto ReadyN
ReadyInitS:
7H13 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_DYE2)
goto ReadyS
ReadyN:
7H13 A 2 A_GiveInventory("HomingSeeker_Ready_P")
loop
ReadyS:
6I13 A 2 A_GiveInventory("HomingSeeker_Ready_P")
loop

Fire:
7H13 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H13 A 0 A_JumpIfInventory("MagnetEnergyAmmo",0,"FireHoming")
7H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"SnipeShotS")
SnipeShotN:
7H13 B 0 A_GiveInventory("Shiny_HomingSeeker_Fire_P2")
7H13 O 5 A_GunFlash("Flash_SnipeN", true)
7H13 PQB 2
7H13 B 0 A_Refire("SnipeShotN")
Goto ReadyN
SnipeShotS:
7I13 B 0 A_GiveInventory("Shiny_HomingSeeker_Fire_P2")
7I13 N 1 A_GunFlash("Flash_SnipeS", true)
7I13 OOPQB 2
7I13 B 0 A_Refire("SnipeShotS")
Goto ReadyS

Flash_SnipeN:
7H13 XYZ 2
stop
Flash_SnipeS:
7I13 XYZ 2
stop

FireHoming:
7H13 A 0 A_GiveInventory("Shiny_HomingSeeker_Fire_P")
7H13 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"FireHomingS")
FireHomingN:
7H13 D 1
7H13 EEEFGHA 2
7H13 A 0 A_Refire("SnipeShotN")
Goto ReadyN
FireHomingS:
7I13 D 1
7I13 EEEFGHA 2
7I13 A 0 A_Refire("SnipeShotS")
Goto ReadyS

BotFire:
7H13 A 0 A_GiveInventory("MagnetEnergyAmmo",random(2,5))
7H13 A 0 A_Jump(16,"BotFire2")
7H13 A 0 A_JumpIfCloser(256,"AltfireOld")
7H13 A 0 A_JumpIfInventory("MagnetEnergyAmmo",56,"BotFire1")
7H13 A 0 A_GiveInventory("Shiny_HomingSeeker_Fire_P2")
7H13 OPQB 2
7H13 B 0 A_ReFire("BotFire")
goto ReadyN
BotFire1:
7H13 A 0 A_Jump(8,"BotFire2")
7H13 A 0 A_GiveInventory("Shiny_HomingSeeker_Fire_P")
7H13 DEFGH 2
7H13 A 0 A_ReFire("BotFire")
goto ReadyN

BotFire2:
7H13 A 0 A_SetArg(0,0)
7H13 A 0 A_PlaySoundEx("classes/taunt/homingseeker","Voice")
7H13 A 0 A_PlaySound("weapon/magnetmissile",1)
7H13 B 2 A_FireCustomMissile("Shiny_HomingSeekerShotBot2",0,0,0,0)
7I13 ABABA 2 A_GiveInventory("Shiny_HomingSeeker_FireBot_P1")
7H13 BABA 2 A_GiveInventory("Shiny_HomingSeeker_FireBot_P2")
7H13 B 0 A_PlaySound("weapon/magnetmissile",1)
7H13 B 2 A_FireCustomMissile("Shiny_HomingSeekerShotBot2",0,0,0,0)
7H13 A 20
7H13 A 0 A_ReFire("BotFire")
goto ReadyS

Altfire:
7H13 B 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "AltS")
AltN:
7H13 R 1
7H13 S 2
7H13 T 1 A_GiveInventory("Shiny_HomingSeeker_Alt_P")
7H13 UTUTUTU 1
7I13 T 2
7I13 V 3
7I13 W 3
Goto ReadyS
AltS:
7I13 R 1
7I13 S 2
7I13 T 1 A_GiveInventory("Shiny_HomingSeeker_Alt_P")
7I13 UTUTUTU 1
7H13 T 2
7H13 V 3
7H13 W 3
Goto ReadyN

AltfireOld:
7H13 A 0 A_GiveInventory("HomingSeeker_Alt_P")
7H13 A 0 A_PlaySound("weapon/chargekick",4)
7H13 A 0 A_TakeInventory("MagnetEnergyAmmo",28,1)
7H13 A 0 A_TakeInventory("MagnetEnergyAmmo",28)
7H13 A 1 Offset(11,50)
7H13 A 2 Offset(22,68)A_FireCustomMissile("Shiny_HomingSeekerKick",0,0,0,0)
7H13 A 7 Offset(33,104)
7H13 A 4 Offset(22,68)
7H13 A 4 Offset(11,50)
Goto ReadyN
}
}

actor Shiny_HomingSeeker_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("weapon/magnetmissile",1)
TNT1 A 0 A_TakeInventory("MagnetEnergyAmmo",34,1)
TNT1 A 0 A_TakeInventory("MagnetEnergyAmmo",22)
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Pull")
goto Push
Pull:
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileSF",0,1,8,0)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileS",7.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileS",-7.5,0,8,0)
stop
Push:
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileNF",0,1,8,0)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileN",7.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerMissileN",-7.5,0,8,0)
stop
}
}
actor Shiny_HomingSeeker_Fire_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/HSeekMain2",1,0.85)
TNT1 A 0 A_GiveInventory("MagnetEnergyAmmo",2)
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Pull")
goto Push
Pull:
TNT1 A 0 A_FireCustomMissile("S_SnipeMissileS",0,0,8,0)
stop
Push:
TNT1 A 0 A_FireCustomMissile("S_SnipeMissileN",0,0,8,0)
stop
}
}

actor Shiny_HomingSeeker_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag",1,"Push")
goto Pull
Pull:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_SDYE2,1)
TNT1 A 0 A_PlaySound("wep_L/HSeekPullOn",4)
TNT1 A 0 A_GiveInventory("HSeek_MagneticFlag")
stop
Push:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HOMINGSEEKER_SDYE,1)
TNT1 A 0 A_PlaySound("wep_L/HSeekPushOn",4)
TNT1 A 0 A_TakeInventory("HSeek_MagneticFlag")
stop
}
}

actor Shiny_HomingSeeker_FireBot_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SetArg(0,Args[0]+5)
Firin:
TNT1 A 0 A_PlaySound("weapon/magnetmissile",1)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerShotBot",Args[0],0,0,0)
TNT1 A 0 A_FireCustomMissile("Shiny_HomingSeekerShotBot",-Args[0],0,0,0)
stop
}
}
actor Shiny_HomingSeeker_FireBot_P2 : Shiny_HomingSeeker_FireBot_P1
{
States
{
Pickup:
TNT1 A 0 A_SetArg(0,Args[0]-5)
goto Firin
}
}

actor Shiny_HomingSeekerMissileN : HomingSeekerMissileN
{
Translation "192:192=32:32","198:198=252:252"
Args 75,75,64,8//50
}
actor Shiny_HomingSeekerMissileS : Shiny_HomingSeekerMissileN
{
Translation "192:192=99:99","198:198=118:118"
}

actor Shiny_HomingSeekerMissileNF : HomingSeekerMissileNF
{
Translation "192:192=32:32","198:198=252:252"
Args 75,150,64,35//50,100,64,35
States
{
Fling:
TNT1 A 0 A_SetArg(1,CallACS("uh_HomingSeekerPushPull",75,Accuracy)*1.5+Args[1])
TNT1 A 0 A_GiveToTarget("Shiny_HomingSeeker_PushPull_P")
goto DeathX
}
}
actor Shiny_HomingSeeker_PushPull_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("HSeek_MagneticFlag", 1, "Pull")
    goto Push
   Pull:
    TNT1 A 0 A_Recoil(-37.5)
    stop
   Push:
    TNT1 A 0 A_Recoil(37.5)
    stop
  }
}
actor Shiny_HomingSeekerMissileSF : Shiny_HomingSeekerMissileNF
{
Translation "192:192=99:99","198:198=118:118"
Accuracy -1
}

actor S_SnipeMissileN : SnipeMissileN
{
Translation "192:192=4:4","198:198=35:35"
damage (132)//88
}
actor S_SnipeMissileS : S_SnipeMissileN
{
Translation "192:192=4:4","198:198=102:102"
}


actor Shiny_HomingSeekerShotBot : HomingSeekerShotBot
{
Translation "192:192=99:99","198:198=118:118"
damage (25)//25
}

actor Shiny_HomingSeekerShotBot2 : HomingSeekerShotBot2
{
Translation "192:192=32:32","198:198=252:252"
damage (113)//75
Args 75,96,8//50
}

actor Shiny_HomingSeekerKick : HomingSeekerKick
{
Translation "192:192=32:32","198:198=252:252"
damage (150)//100
}

actor Quickster : CustWepClassBase {
  Player.ScoreIcon "UMUG_7"
  Player.DisplayName "Quickster"
  Player.SoundClass "Quickster"
  Player.MaxHealth 750
  Health 750
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 15
  Player.StartItem "UH_BaseFlagPack"
  // +SLIDESONWALLS
  Player.StartItem "Quickster_W"
  Player.StartItem "RapidEnergyAmmo", 20

  // damagefactor "GeminiLaser", 2.5
  States {
   Spawn:
    QUIM A 0
    QUIM B 1
    QUIM A 1
    goto Spawn+2
   See:
    QUIM BCDE 5
    goto Spawn
   Missile:
    QUIM FFFFF 1
    QUIM GGGG 1
    goto Spawn+2
   ClassPain:
    QUIM H 0
    goto MegamanPain

   ClassDeath:
    QUIM Z 0
    goto MegamanDeath
    // QUIM Z 0 A_JumpIfInventory("FireDeathFlag",1,"FireQuickWait")

   MegamanDeath0:
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 1 ThrustThingZ(0, 70, 0, 0)
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeath", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    QUIM Z 0
    goto MegamanErase

   MegamanGib:
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 1 ThrustThingZ(0, 100, 0, 0)
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeathGib", 0, 0, 16, velx, vely, 40, 0, 1 + 8)
    QUIM Z 0
    goto MegamanErase

   MegamanIce:
    QUIM Z 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_ICEDEATH, TCLR_ICEDEATH)  // DYE_ICEDEATHCBM
    QUIM Z 1 A_PlaySoundEx("*icefreze", "Voice")
    QUIM Z 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanIceGib")
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeathIce", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase

   MegamanIceGib:
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeathIceGib", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase

   MegamanFling:
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanFlingGib")
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeath", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase
   MegamanFlingGib:
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeathGib", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase

   Death.Falling:
    QUIM Z 0 A_GiveInventory("FallingDeathFlag")
    QUIM Z 0 A_GiveInventory("UH_ClassDeath_P")
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 1 ThrustThingZ(0, 70, 0, 0)
    QUIM Z 1 A_SpawnItemEx("QuicksterSonicDeath", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase

   MegamanDisintegrate:
    QUIM Z 0 A_SpawnItemEx("Corpse_07", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor QuicksterSonicDeath : BasicProjectile {
  DeathSound "classes/SonicDeath"
  DamageType "Rapid"
  Obituary "$OB_07D1"
  -NOGRAVITY
  +DONTSPLASH
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 0.01
  WallBounceFactor 1.0
  Damage (100)
  Radius 16
  Height 32
  Speed 32
  Scale 2.5
  Args 300, 218, 0
  States {
   Spawn:
    6P07 VWXY 3
    loop
   Death:
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_SpawnItemEx("FakeUnholyDeathFX", 0, 0, 32, 0, 0, 0, random(0, 359), 1)
    stop
  }
}
actor S_QuicksterSonicDeath : QuicksterSonicDeath {
  Damage (150)
  Args 450, 218, 0
}

actor QuicksterSonicDeathIce : QuicksterSonicDeath {
  DeathSound ""
  Damage (200)
  DamageType "ColdShot"
  Obituary "$OB_07D2"
  Args 600, 218, 0
  States {
   Death:
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_PlaySoundEx("*icedeath", "Body")  // Voice
    TNT1 A 0 A_SpawnItemEx("FrozenDeathFX", 0, 0, 1, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_QuicksterSonicDeathIce : QuicksterSonicDeathIce {
  Damage (300)
  Args 900, 218, 0
}

actor QuicksterSonicDeathGib : QuicksterSonicDeath {
  DeathSound ""
  Damage (400)
  Obituary "$OB_07D3"
  Args 1200, 218, 0
  States {
   Death:
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_GiveInventory("CriticalDeathGiver")
    TNT1 A 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    stop
  }
}
actor S_QuicksterSonicDeathGib : QuicksterSonicDeathGib {
  Damage (600)
  Args 1800, 218, 0
}

actor QuicksterSonicDeathIceGib : QuicksterSonicDeath {
  DeathSound ""
  Damage (600)
  Obituary "$OB_07D4"
  Args 1800, 218, 0
  States {
   Death:
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_SpawnItemEx("FrozenDeathFX", 0, 0, 1, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("CriticalDeathSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    TNT1 A 0 A_PlaySoundEx("*icedeath", "Voice")
    stop
  }
}
actor S_QuicksterSonicDeathIceGib : QuicksterSonicDeathIceGib {
  Damage (900)
  Args 2700, 218, 0
}

actor QuicksterShiny : Quickster {
  Player.ScoreIcon "UMUG_S7"
  Player.MaxHealth 2750
  Health 2750
  Player.ForwardMove 1.35, 1.35
  Player.SideMove 1.35, 1.35
  Player.JumpZ 16
  Player.MorphWeapon "QuicksterShiny_W"
  +NOSKIN
  States {
   ClassDeath:
    QUIM Z 0 A_JumpIfInventory("FireDeathFlag", 1, "FireQuickWait")
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 1 ThrustThingZ(0, 70, 0, 0)
    QUIM Z 0 A_JumpIfInventory("IceDeathFlag", 1, "IceQuickWait")
    QUIM Z 1 A_SpawnItemEx("S_QuicksterSonicDeath", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    QUIM Z 0
    goto MegamanErase

   IceQuickWait:
    QUIM Z 1 A_SpawnItemEx("S_QuicksterSonicDeathIce", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase
   FireQuickWait:
    QUIM H 16
    goto ClassDeath+1

   Death.Falling:
    QUIM Z 0 A_GiveInventory("FallingDeathFlag")
    QUIM Z 0 A_GiveInventory("UH_ClassDeath_P")
    QUIM Z 0 A_PlaySound("*death", 1)
    QUIM Z 1 ThrustThingZ(0, 70, 0, 0)
    QUIM Z 1 A_SpawnItemEx("S_QuicksterSonicDeath", 0, 0, 16, velx, vely, 20, 0, 1 + 8)
    goto MegamanErase
  }
}

actor Corpse_07_0 : BaseCorpseFX {States {Spawn: 1H07 O 350
    goto Spawn2}}
actor Corpse_07_1 : BaseCorpseFX {States {Spawn: 1H07 P 350
    goto Spawn2}}
actor Corpse_07_2 : BaseCorpseFX {States {Spawn: 1H07 Q 350
    goto Spawn2}}
actor Corpse_07_3 : BaseCorpseFX {States {Spawn: 1H07 R 350
    goto Spawn2}}
actor Corpse_07_4 : BaseCorpseFX {States {Spawn: 1H07 S 350
    goto Spawn2}}
actor Corpse_07_5 : BaseCorpseFX {States {Spawn: 1H07 T 350
    goto Spawn2}}


actor Corpse_07 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_07_0", 0, 0, 30, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_07_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_07_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_07_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_07_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_07_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

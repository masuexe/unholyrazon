// Slow
actor TetrisRock_Z : SiteWorkerRock {
  Obituary "$OB_35M8"
  Gravity 0.0083333
  Damage (750)
  Speed 5
  States {
   Spawn:
    6P35 R 0
    6P35 R 0 A_JumpIfInTargetInventory("IsBot", 1, "SpawnB")
    6P35 R 0 ThrustThingZ(0, 3, 0, 1)
   SpawnL:
    6P35 R 35
    6Q35 R 1 Bright
    loop
   SpawnB:
    6P35 R 0 ThrustThingZ(0, -2, 0, 1)  // -4
   SpawnL2:
    6P35 R 35
    6Q35 R 1 Bright
    loop
   Crash:
    "####" R 0 A_PlaySoundEx("Tetris/4Line", "Voice")
    goto Death+1
   Death:
    "####" R 0 A_PlaySoundEx("TetrisU/Line", "Weapon")
    "####" R 0 A_SetGravity(0.0)
    "####" RXRXRXR 2
    stop
  }
}


actor SiteWorkerPinpoint : ProjSpawnFuncActorFast {
  var int user_Height;
  var int user_NoTranslation;
  +SKYEXPLODE
  +EXPLODEONWATER
  +DONTBLAST
  // +RIPPER
  +BLOODLESSIMPACT
  +THRUGHOST
  reactiontime 1
  damage (0)
  Radius 22
  height 32
  speed 1000
  States {
   Spawn:
    TNT1 A 8
    TNT1 A 7 A_CountDown
    wait
   XDeath:
    TNT1 A 0 A_SetArg(0, 16)
    goto Death
   Death:
    TNT1 A 0 A_GiveToTarget("UH_TargetMarker")
    TNT1 A 0 A_JumpIf(z-ceilingz>=-16, "DeathC")
    TNT1 A 0 A_JumpIf(z-ceilingz<=-512, "DeathC2")
    TNT1 A 0 A_SetUserVar("user_Height", ceilingz-z-Height)
    TNT1 A 0 A_Jump(256, "Death2")
   Death2:
    TNT1 A 1 A_SpawnItemEx("SiteWorkerRock", Args[0], 0, user_Height, 0, 0, -20, 0, 1+32)
    stop
   DeathC:
    TNT1 A 0 A_SetUserVar("user_Height", -0)
    goto Death+3
   DeathC2:
    TNT1 A 0 A_SetUserVar("user_Height", 496)
    goto Death+3
  }
}

actor TetrisPinpoint_I : SiteWorkerPinpoint {
  States {
   Death2:
    TNT1 A 1 A_SpawnItemEx("TetrisRock_IA", Args[0], 0, user_Height, 0, 0, -20, 0, 1+32)
    stop
  }
}


// Ripper
actor TetrisRock_L : SiteWorkerRock {
  SeeSound "Tetris/Move"
  Obituary "$OB_35M4"
  +RIPPER
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +DONTSPLASH
  +CANBOUNCEWATER
  -EXPLODEONWATER
  bouncefactor 0.48
  wallbouncefactor 0.6
  BounceCount 8
  Damage (random(90, 110))
  States {
   Spawn:
    6P35 G 0
    6P35 G 0 A_JumpIfInTargetInventory("IsBot", 1, "SpawnB")
    6P35 G 0 ThrustThingZ(0, 30, 0, 1)
    6P35 G 1
    wait
   SpawnB:
    6P35 G 0 ThrustThingZ(0, -20, 0, 1)
    6P35 G 1
    wait
   Death:
    "####" G 0 A_PlaySoundEx("TetrisU/Line", "Weapon")
    "####" G 0 A_SetGravity(0.0)
    "####" GXGXGXG 2
    stop
  }
}


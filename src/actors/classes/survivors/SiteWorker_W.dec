// Split
actor TetrisRock_O : SiteWorkerRock {
  Obituary "$OB_35M5"
  Damage (400)
  States {
   Spawn:
    6P35 K 0
    6P35 K 0 A_JumpIfInTargetInventory("IsBot", 1, "SpawnB")
    6P35 K 0 ThrustThingZ(0, 30, 0, 1)
    6P35 K 1
    wait
   SpawnB:
    6P35 K 0 ThrustThingZ(0, -20, 0, 1)
    6P35 K 1
    wait

   Crash:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 AAAA 0 A_SpawnItemEx("TetrisRockDebris", 0, 0, 8, random(-14, 14), 0, random(3, 14), random(0, 359), 1)
    TNT1 AAAAAAAA 0 A_SpawnItemEx("TetrisRockDebrisFX", 0, 0, 0, random(-10, 10), 0, random(5, 10), random(0, 359), 1)
    TNT1 A 0 A_PlaySoundEx("Tetris/Line", "Voice")
    TNT1 A 0 A_PlaySoundEx("weapon/superarmhit", "Weapon")
    TNT1 A 2
    stop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_SpawnItemEx("TetrisRockBoomFX3", 0, 0, 24, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/superarmhit", "Weapon")
    TNT1 A 0 A_SetArg(4, 1-(ceilingz-z<=height)*2)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("TetrisRockDebris", 0, 0, 8*Args[4], random(-14, 14), 0, random(3, 14)*Args[4], random(0, 359), 1)
    TNT1 A 2
    stop
  }
}


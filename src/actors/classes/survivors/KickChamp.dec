actor KickChamp : CustWepClassBase 
{
player.scoreIcon "UMUG_58"
player.displayname "KickChamp"
player.soundclass "KickChamp"
Player.Maxhealth 850
health 850
player.forwardmove 0.85, 0.85
player.sidemove 0.85, 0.85
player.jumpz 12
Player.StartItem "UH_BaseFlagPack"
player.startitem "KickChamp_W"
player.startitem "MasterFootAmmo", 1
player.startitem "RonaldinhoAmmo", 150
player.startitem "AirJumpLimit", 1
States
{
Spawn:
1H58 A 0
1H58 B 1
1H58 A 128 A_JumpIfInventory("VivifyCycle1",2,"M_FrolicUp")
1H58 A 128
1H58 A 0 A_SpawnItemEx("KickChamp_BoredFX",0,0,96,0,0,0.2f,0,1)
1H58 MAMAMA 15
1H58 ONONON 15
Goto Spawn+5
See:
1H58 B 0 A_JumpIfInventory("VivifyCycle1",2,"M_FrolicUp")
1H58 BCDE 5
Goto Spawn
Missile:
1H58 F 0 A_JumpIfInventory("VivifyDelay7",1,2)
1H58 F 0 A_JumpIfInventory("VivifyCycle1",1,"M_Slide")
1H58 FG 8
goto Spawn+2
M_Slide:
1H58 I 0 A_JumpIfInventory("VivifyCycle1",2,"M_FrolicUp")
1H58 I 1 A_JumpIfInventory("VivifyDelay4",1,"M_SlideEnd")
loop
M_SlideEnd:
1H58 I 1
goto Spawn+2
M_FrolicUp:
1H58 J 0 A_JumpIfInventory("VivifyDelay5",1,"Spawn")//M_FrolicEnd
1H58 J 1 A_JumpIfInventory("VivifyFlag2",1,"M_DiveKick")
1H58 J 0 A_JumpIf(velz<0,"M_FrolicDown")
loop
M_FrolicDown:
1H58 K 0 A_JumpIfInventory("VivifyDelay5",1,"Spawn")
1H58 K 1 A_JumpIfInventory("VivifyFlag2",1,"M_DiveKick")
1H58 K 0 A_JumpIf(velz>=0,"M_FrolicUp")
loop
M_DiveKick:
1H58 L 0 A_JumpIfInventory("VivifyDelay3",1,"M_DiveKickHit")
1H58 L 1 A_JumpIfInventory("VivifyDelay5",1,"M_DiveEnd")
loop
M_DiveKickHit:
1H58 K 5
goto M_FrolicUp
M_DiveEnd:
1H58 BCDE 3
Goto Spawn

ClassPainSlide:
1H58 H 0 A_SpawnItemEx("DelayPainFX5")
1H58 HHH 1 A_JumpIfInventory("VivifyDelay4",1,"M_SlideEnd")
goto M_Slide

ClassPainFrolic:
1H58 H 0 A_SpawnItemEx("DelayPainFX5")
1H58 HHH 1 A_JumpIfInventory("VivifyDelay5",1,"Spawn")
goto M_FrolicUp

ClassPain:
1H58 H 0 A_JumpIfInventory("VivifyCycle1",2,"ClassPainFrolic")
1H58 H 0 A_JumpIfInventory("VivifyCycle1",1,"ClassPainSlide")
1H58 H 0
Goto MegamanPain

ClassDeath:
1H58 H 0
goto MegamanDeath
MegamanDeath0:
1H58 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H58 HHHHHHHHH 2 A_SpawnItemEx("KickChamp_DeadBoom_H")
1H58 H 0 A_SpawnItemEx("KickChamp_DeathBlast",0,0,32)
1H58 Z 0 A_PlaySound("*death",2)
Goto MegamanErase
MegamanDisintegrate:
1H58 Z 0 A_SpawnItemEx("Corpse_58",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor KickChampS : KickChamp 
{
player.scoreIcon "UMUG_S58"
Player.Maxhealth 2850
health 2850
player.forwardmove 0.95, 0.95
player.sidemove 0.95, 0.95
player.jumpz 13
player.morphweapon "KickChampS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H58 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H58 HHHHHHHHH 2 A_SpawnItemEx("S_KickChamp_DeadBoom_H")
1H58 H 0 A_SpawnItemEx("S_KickChamp_DeathBlast",0,0,32)
1H58 Z 0 A_PlaySound("*death",2)
Goto MegamanErase
}
}


actor KickChamp_BoredFX : BasicExplosion
{
RenderStyle Translucent
Alpha 0.0
Scale 2.0
States
{
Spawn:
TNT1 A 0
6P58 "]]]]]]]]" 2 A_FadeIn(0.125)
6P58 "]" 35
6P58 "]" 2 A_FadeOut(0.125)
wait
}
}

actor KickChamp_DeadBoom_H : BasicExplosion
{
Translation "0:255=%[0,0.53125,0.578125]:[0.9,1,1]"//RIP for Software
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("KickChamp_DeadBoomFX",random(1,8)*4,0,random(3,8)*8,0,0,0,random(0,89)*4,random(0,1))//Random TransferTranslation
TNT1 A 1
stop
}
}
actor S_KickChamp_DeadBoom_H : BasicExplosion
{
Translation "0:255=%[0.375,0.8125,0.875]:[0.9,1,1]"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("S_KickChamp_DeadBoomFX",random(1,8)*4,0,random(3,8)*8,0,0,0,random(0,89)*4,random(0,1))
TNT1 A 1
stop
}
}

actor KickChamp_DeathBlast : KickChamp_DeadBoom_H
{
DamageType "KickChamp"
Obituary "$OB_58D"
Args 1164,64,64
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("KickChamp_DeathBlastFX",0,0,-32,0,0,0,0,1)
Boom:
TNT1 A 2 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}
actor S_KickChamp_DeathBlast : KickChamp_DeathBlast
{
Translation "0:255=%[0.375,0.8125,0.875]:[0.9,1,1]"
Args 96,64,64
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("S_KickChamp_DeathBlastFX")
goto Boom
}
}


actor KickChamp_DeathBlastFX : BasicClientSide
{
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_SpawnItemEx("KickChamp_DeadWaveFX",0,0,0,0,0,0,0,random(0,1))
TNT1 AAAA 1 A_SpawnItemEx("KickChamp_DeadStarFX",random(2,10),0,random(16,32),frandom(0.5,2),0,frandom(8,10),random(0,44)*8,random(0,1))
TNT1 AAAAAAA 1 A_SpawnItemEx("KickChamp_DeadTwinkleFX",frandom(4,24),0,random(4,16)*4,0,0,0,random(0,89)*4,random(0,1))
stop
}
}

6R58 C 2
6R58 CAAB 2 A_SpawnItemEx("KickChamp_DeadLineFX",random(1,4)*3,0,random(0,2)*3,0,0,frandom(10,12),random(0,44)*8,1)
6R58 B 2
//6R58 D 4
stop
}
}

actor AmberShiny_W_ScriptBar : ScriptBar {}

actor AmberShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Amber_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_52"
  Obituary "$OB_52W1"
  Weapon.AmmoType2 "AmberEnergyAmmo"
  Weapon.AmmoType "VixenScuttleAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H52 [ 6
    loop

   Deselect:
    7H52 A 0
    goto DeselectSwap
   Select:
    7H52 A 0
    goto SelectSwap

   Ready:
    7H52 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_SDYE)
    7H52 A 0 A_GunFlash("Flash", 1)
    7H52 A 0  // Initial setup: shiny morph hook.
    goto Ready2
   Ready2:
    7H52 AA 18 A_WeaponReady
    7H52 A 0 A_GiveInventory("VixenScuttleAmmo", 20)
    loop

   Flash:
    TNT1 AA 3
    TNT1 A 3 A_GiveInventory("Amber_Flash_P")
    loop

   Fire:
    7H52 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H52 A 0 A_JumpIfInventory("AmberChargeFlag", 1, "Fire2")
   FireH:
    7H52 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "FireH2")
    7H52 A 1 Offset(2, 30) A_GiveInventory("AmberChargeFlag", 1 + CallACS("uh_checkrune", RUNE_RAGE))
    7H52 A 0 A_ReFire("FireH")
    goto Fire1
   FireH2:
    7H52 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "FireH3")
    7H52 A 1 Offset(4, 27) A_GiveInventory("AmberChargeFlag", 1 + CallACS("uh_checkrune", RUNE_RAGE))
    7H52 A 0 A_ReFire("FireH2")
    goto Fire1
   FireH3:
    7H52 A 1 Offset(6, 24) ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_SDYE2, 1)
    7H52 A 0 A_ReFire(1)
    goto Fire1
    7H52 A 1 Offset(6, 23) ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_SDYE, 1)
    7H52 A 0 A_ReFire("FireH3")
    goto Fire1

   Fire1:
    7H52 B 1 Offset(-12, 20) A_GiveInventory("S_Amber_Fire_P1")
    7H52 C 1 Offset(-39, 23)
    7H52 C 1 Offset(-84, 32)
    7H52 D 1 Offset(-133, 42)
    7H52 E 1 Offset(-164, 44)
    7H52 E 1 Offset(-208, 55)
    7H52 E 1 Offset(-256, 69)
    7H52 E 1 Offset(-304, 86)
    TNT1 A 4
    TNT1 AAAAAAAAA 2 A_WeaponReady(1 + 2)  // A_ReFire("Fire2")
    TNT1 A 0 A_TakeInventory("AmberChargeFlag")
    7H52 A 2 Offset(-48, 217) A_WeaponReady(1)
    7H52 A 2 Offset(-32, 162) A_WeaponReady(1)
    7H52 A 2 Offset(-19, 118) A_WeaponReady(1)
    7H52 A 2 Offset(-10, 83) A_WeaponReady(1)
    7H52 A 2 Offset(-3, 55) A_WeaponReady(1)
    goto Ready2+2
   Fire2:
    7H52 F 1 Offset(-110, 47) A_GiveInventory("S_Amber_Fire_P2")
    7H52 G 1 Offset(-93, 42)
    7H52 G 1 Offset(-46, 33) A_TakeInventory("AmberChargeFlag")
    7H52 H 1 Offset(-30, 25)
    7H52 H 1 Offset(19, 19)
    7H52 H 1 Offset(72, 21)
    7H52 H 1 Offset(129, 33)
    TNT1 A 8
    7H52 A 2 Offset(78, 67)
    7H52 A 2 Offset(54, 54)
    7H52 A 2 Offset(32, 45)
    7H52 A 2 Offset(16, 39)
    7H52 A 2 Offset(6, 35)
    goto Ready2+2

   FirePlate:
    6J52 J 2 Offset(-42, 71)
    6J52 L 2 Offset(-103, 90)
    6J52 L 2 Offset(-88, 64)
    6J52 L 2 Offset(-69, 42)
    6J52 K 0 A_PlaySound("DuckHunt/Plate", 1, 0.85)
    6J52 K 2 Offset(-55, -36) A_FireCustomMissile("S_AmberDinnerPlate", 0, 0, 8, 0)
    6J52 K 2 Offset(-3, -61)
    6J52 K 2 Offset(49, -89)
    6J52 J 2 Offset(94, 5)
    6J52 J 2 Offset(48, 19)
    6J52 J 2 Offset(16, 28)
    goto Ready2

   Altfire:
    7H52 I 0 A_GiveInventory("Amber_Alt_P")
    7H52 I 0 A_ReFire(1)
    7H52 I 1 Offset(-14, 64)
    7H52 I 1 Offset(-32, 41)
    7H52 I 10 Offset(-56, 15) A_WeaponReady(11)
    7H52 I 3 Offset(-43, 35) A_WeaponReady(11)
    7H52 I 3 Offset(-26, 60) A_WeaponReady(11)
    7H52 I 2 Offset(-4, 91) A_WeaponReady(11)
    7H52 I 0 A_TakeInventory("AmberChargeFlag")
    7H52 A 2 Offset(30, 192) A_WeaponReady(1)
    7H52 A 2 Offset(20, 142) A_WeaponReady(1)
    7H52 A 2 Offset(12, 87) A_WeaponReady(1)
    7H52 A 2 Offset(6, 62) A_WeaponReady(1)
    7H52 A 2 Offset(2, 47) A_WeaponReady(1)
    goto Ready2+1

   AltHeal:
    6J52 K 0 A_PlaySound("Pokemon/Frustration2", 1)
    6J52 K 1 Offset(-32, 62) A_FireCustomMissile("S_AmberHealthShot", 0, 0, 0, 0)
    6J52 M 1 Offset(-115, 70)
    6J52 M 1 Offset(-115, 38)
    6J52 M 11 Offset(-115, 6)
    6J52 M 2 Offset(-115, 26)
    6J52 M 2 Offset(-115, 50)
    6J52 M 2 Offset(-115, 78)
    6J52 J 2 Offset(-40, 71)
    6J52 J 2 Offset(-24, 47)
    goto Ready2

   BotFire:
    7H52 A 0 A_Jump(4, "BotFireX")
    7H52 A 0 A_JumpIfInventory("BotFlag2", 1, "BotFireX2")
    7H52 A 0 A_Jump(15, "Altfire")
    7H52 A 0 A_Jump(2, "BotAlt2")
    7H52 A 0 A_FaceTarget
    7H52 A 0 A_JumpIfCloser(256, "BotFire1")
    7H52 A 0 A_JumpIfCloser(800, "BotFire2")
    goto BotFire3

   BotFire1:
    7H52 A 0 A_JumpIfInventory("AmberChargeFlag", 1, "Fire2")
    7H52 A 0 A_GiveInventory("AmberChargeFlag", 1 + random(0, 2) * 35)
    goto Fire1
   BotFire2:
    7H52 A 0 A_Jump(16, "BotFire1")
    7H52 A 0 A_Jump(64, "FirePlate")
    goto BotAlt
   BotFire3:
    7H52 A 0 A_Jump(8, "BotAlt2")
    7H52 A 0 A_Jump(4, "BotFire1")
    7H52 A 0 A_Jump(64, "BotAlt")
    goto FirePlate

   BotAlt:
    7H52 A 0 A_Jump(8, "BotAlt2")
    7H52 A 0 A_GiveInventory("Amber_Alt_P")
    7H52 A 0 A_ReFire(1)
    7H52 AA random(2, 15)
    goto Ready2
   BotAlt2:
    7H52 A 0 A_PlaySoundEx("classes/taunt/amber", "Voice")
    7H52 A 0 A_GiveInventory("AmberEnergyAmmo", 5 * random(5, 20))
    7H52 A 0 A_GiveInventory("VixenScuttleAmmo", 20 * random(1, 3))
    goto AltHeal

   BotFireX:
    7H52 A 0 A_PlaySoundEx("classes/taunt/amber", "Voice")
    7H52 A 0 A_GiveInventory("AmberEnergyAmmo", 5 * random(5, 10))
    7H52 A 0 A_GiveInventory("BotFlag2", random(40, 60))
   BotFireX2:
    6J52 K 0 A_PlaySound("Caliber/Pew", 1)
    6J52 K 0 A_TakeInventory("BotFlag2", 1)
    6J52 KK 1 A_FireCustomMissile("S_AmberNeedle", random(-1, 1), 0, random(-8, 8), random(-8, 8), 0, random(-1, 1))
    6J52 K 0 A_JumpIfInventory("BotFlag2", 1, 1)
    goto Ready2
    6J52 K 0 A_ReFire("BotFireX2")
    goto Ready2
  }
}

actor S_Amber_Fire_P1 : Amber_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "A3")
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "A2")
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe1", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H1", 0, 0, 0, -4)
    goto Snd1
   A2:
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe3", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H3", 0, 0, 0, -4)
    goto Snd2
   A3:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_SDYE, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe5", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe5_H", -20, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H5", 0, 0, 0, -4)
    goto Snd3
  }
}
actor S_Amber_Fire_P2 : Amber_Fire_P2 {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 0, "A3")
    TNT1 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "A2")
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe2", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H2", 0, 0, 0, -4)
    goto Snd1
   A2:
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe4", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H4", 0, 0, 0, -4)
    goto Snd2
   A3:
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe6", 0, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberBroomSwipe6_H", 20, 0, 0, 1)
    TNT1 A 0 A_FireCustomMissile("S_AmberSwipe_H6", 0, 0, 0, -4)
    goto Snd3
  }
}


actor S_AmberBroomSwipe1 : AmberBroomSwipe1 {Mass 75 Args 225, 80, 40}  // 50 170
actor S_AmberBroomSwipe2 : AmberBroomSwipe2 {Mass 105 Args 250, 80, 48}  // 70 170
actor S_AmberBroomSwipe3 : AmberBroomSwipe3 {Mass 105 Args 330, 100, 50}  // 70 170
actor S_AmberBroomSwipe4 : AmberBroomSwipe4 {Mass 135 Args 375, 100, 60}  // 90 170
actor S_AmberBroomSwipe5 : AmberBroomSwipe5 {Mass 135 Args 480, 120, 60}  // 90 170
actor S_AmberBroomSwipe6 : AmberBroomSwipe6 {Mass 165 Args 525, 120, 72}  // 110 170

actor S_AmberBroomSwipe5_H : AmberBroomSwipe5_H {Args 48, 120, 60, 10}  // 32
actor S_AmberBroomSwipe6_H : AmberBroomSwipe6_H {Args 57, 120, 60, -10}  // 38


actor S_AmberSwipe_H1 : AmberSwipe_H1 {Translation "192:192=224:224"}
actor S_AmberSwipe_H2 : AmberSwipe_H2 {Translation "192:192=224:224"}
actor S_AmberSwipe_H3 : AmberSwipe_H3 {Translation "192:192=225:225"}
actor S_AmberSwipe_H4 : AmberSwipe_H4 {Translation "192:192=225:225"}
actor S_AmberSwipe_H5 : AmberSwipe_H5 {Translation "192:192=225:225", "198:198=173:173"}
actor S_AmberSwipe_H6 : AmberSwipe_H6 {Translation "192:192=225:225", "198:198=173:173"}


actor S_AmberDinnerPlate : AmberDinnerPlate {
  Translation "192:192=4:4", "198:198=173:173"
  Damage (38)  // 25
  Args 240, 96, 32, 12  // 160 8
}

actor S_AmberNeedle : AmberNeedle {
  Translation "192:192=224:224", "198:198=173:173"
  Damage (45)  // 45
}

actor S_AmberHealthShot : AmberHealthShot {
  Translation "192:192=191:191", "198:198=173:173", "202:202=173:173", "199:199=4:4"
  States {
   Death:
    6N52 YYYYYYYYYYYYYYYY 1 A_FadeIn(0.05)
    6N52 Y 0 A_SpawnItemEx("S_AmberHealthPickup", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor S_AmberHealthPickup : AmberHealthPickup {
  inventory.pickupmessage "Picked up Amber's health capsule. (250)"
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("item/energyup", 3, 1.0)
    TNT1 A 0 A_JumpIfInventory("BAWS", 1, "BossHeal")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 375)  // 250
    stop
   Pickup2:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 150)  // 100
    stop
   BossHeal:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 150)  // 100
    stop
  }
}

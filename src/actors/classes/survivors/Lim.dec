actor Corpse_43 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_43_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_1", 0, 0, 36, velx + random(-4, 4), vely + frandom(-1, 1), velz + frandom(6, 12), random(-2, 2), 169, 0)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_43_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_43_1 {
  +MISSILE
  +HEXENBOUNCE
  -BOUNCEONFLOORS
  -SOLID
  +CLIENTSIDEONLY
  +THRUACTORS
  BounceFactor 0.4
  WallBounceFactor 0.75
  ReactionTime 100
  Damage (0)
  Radius 4
  Height 4
  Scale 2.5
  States {
   Spawn:
    1H43 PQ 2 A_CountDown
    loop
   Death:
    1H43 R 0 A_ChangeFlag("DONTBLAST", 1)
    1H43 R 0 A_PlaySoundEx("weapon/freezecrackerhit", "Weapon")
    1H43 R 300
    1H43 RRRRRRRRRR 3 A_Fadeout
    stop
  }
}

actor Corpse_43_0 : BaseCorpseFX {States {Spawn: 1H43 O 350
    goto Spawn2}}
actor Corpse_43_2 : BaseCorpseFX {States {Spawn: 1H43 S 350
    goto Spawn2}}
actor Corpse_43_3 : BaseCorpseFX {States {Spawn: 1H43 T 350
    goto Spawn2}}
actor Corpse_43_4 : BaseCorpseFX {States {Spawn: 1H43 U 350
    goto Spawn2}}
actor Corpse_43_5 : BaseCorpseFX {States {Spawn: 1H43 V 350
    goto Spawn2}}
actor Corpse_43_6 : BaseCorpseFX {States {Spawn: 1H43 W 350
    goto Spawn2}}

actor Lim : CustWepClassBase {
  Player.ScoreIcon "UMUG_43"
  Player.DisplayName "Lim"
  Player.SoundClass "Lim"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.1, 1.1
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "IsLimFlag"
  Player.StartItem "Lim_W"
  Player.StartItem "DireEnergyAmmo", 60
  Player.StartItem "LimHealth", 1000
  States {
   Spawn:
    ENKR A 0
    ENKR B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
   SpawnFrame:
    ENKR A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    loop
   See:
    ENKR BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
    goto Spawn
   Air:
    ENKR I 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
    ENKR F 0 A_JumpIfInventory("VivifyCycle1", 1, "Missile2")
    ENKR F 0 A_JumpIfInventory("PowerLimFiringSlow", 1, "MissileFrame")
   Missile_1: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
   Missile_2: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
   Missile_3: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
   Missile_4: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
    goto MissileFrame
   Missile_Air_1: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
   Missile_Air_2: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
   Missile_Air_3: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
   Missile_Air_4: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame")
    goto MissileFrame_Air

   MissileFrame:
   MissileFrame_1: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_1")
   MissileFrame_2: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_2")
   MissileFrame_3: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_3")
   MissileFrame_4: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_4")
   MissileFrame_5: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_5")
   MissileFrame_6: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_6")
   MissileFrame_7: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_7")
   MissileFrame_8: ENKR F 1 A_JumpIf(!CallACS("core_CheckFooting"), "MissileFrame_Air_8")
    goto SpawnFrame
   MissileFrame_Air:
   MissileFrame_Air_1: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_2")
   MissileFrame_Air_2: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_3")
   MissileFrame_Air_3: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_4")
   MissileFrame_Air_4: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_5")
   MissileFrame_Air_5: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_6")
   MissileFrame_Air_6: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_7")
   MissileFrame_Air_7: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "MissileFrame_8")
   MissileFrame_Air_8: ENKR W 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
    goto Air

   Missile2:
   Missile2_1: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_1")
   Missile2_2: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_2")
   Missile2_3: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_3")
   Missile2_4: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_4")
   Missile2_5: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_5")
   Missile2_6: ENKR J 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile2_Air_6")
    goto Missile3
   Missile2_Air_1: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_2")
   Missile2_Air_2: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_3")
   Missile2_Air_3: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_4")
   Missile2_Air_4: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_5")
   Missile2_Air_5: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile2_6")
   Missile2_Air_6: ENKR M 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile3")
    goto Missile3_Air

   Missile3:
   Missile3_1: ENKR Y 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile3_Air_1")
   Missile3_2: ENKR Y 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile3_Air_2")
   Missile3_3: ENKR Y 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3")
   Missile3_4: ENKR Y 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3")
   Missile3_5: ENKR Y 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3")
    goto SpawnFrame
   Missile3_Air:
   Missile3_Air_1: ENKR X 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile3_2")
   Missile3_Air_2: ENKR X 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile3_3")
   Missile3_Air_3: ENKR X 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3_Air")
   Missile3_Air_4: ENKR X 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3_Air")
   Missile3_Air_5: ENKR X 1 A_JumpIfInventory("VivifyCycle1", 1, "Missile3_Air")
    goto Air

   ClassPain:
    ENKR H 0 A_JumpIfInventory("VivifyCycle1", 1, "Missile3")
    goto MegamanPain

   ClassDeath:
    ENKR H 0
    goto MegamanDeath
   MegamanDeath0:
    ENKR H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    ENKR HHHHHHHHHHHHHHHHHHHH 1 A_SpawnItemEx("LimDemiseFX_H", 0, 0, 28, 0, 0, 0, 0, 1)
    ENKR H 0 A_PlaySound("Lim/MirrorCounter", 1)
    ENKR H 0 A_SpawnItemEx("LimFlashDemiseFX_H", 0, 0, 28, 0, 0, 0, 0, 1)
    ENKR H 0 A_SpawnItemEx("LimFlashDemise", 0, 0, 28)
    ENKR H 1 A_PlaySound("*death", 2)
    ENKR HHHHHH 1 A_FadeOut(0.167, 0)
    ENKR H 1
    goto MegamanErase
   MegamanDisintegrate:
    ENKR Z 0 A_SpawnItemEx("Corpse_43", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor LimShiny : Lim {
  Player.ScoreIcon "UMUG_S43"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.2, 1.2
  Player.JumpZ 11
  Player.MorphWeapon "LimShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    ENKR H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    ENKR HHHHHHHHHHHHHHHHHHHH 1 A_SpawnItemEx("LimDemiseFX_H", 0, 0, 28, 0, 0, 0, 0, 1)
    ENKR H 0 A_PlaySound("Lim/MirrorCounter", 1)
    ENKR H 0 A_SpawnItemEx("LimFlashDemiseFX_H", 0, 0, 28, 0, 0, 0, 0, 1)
    ENKR H 0 A_SpawnItemEx("S_LimFlashDemise", 0, 0, 28)
    ENKR H 1 A_PlaySound("*death", 2)
    ENKR HHHHHH 1 A_FadeOut(0.167, 0)
    ENKR H 1
    goto MegamanErase
  }
}


actor LimFlashDemise : LimAltFlash {
  Obituary "$OB_43D"
  Args 250, 256, 24
}
actor S_LimFlashDemise : LimFlashDemise {
  Args 375, 256, 24
}

actor LimDemiseFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("FlashM_GenesisSparkleFX", random(28, 64), 0, random(-16, 32), 0, 0, 0, random(0, 359), 1)
    TNT1 AAA 0 A_SpawnItemEx("LimDemiseFX", random(28, 64), 0, random(-16, 32), 0, 0, 0, random(0, 359), 1)
    TNT1 A 1
    stop
  }
}
actor LimFlashDemiseFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LimFlashDemiseFX", random(28, 64), 0, random(-16, 8), frandom(31, 33), 0, frandom(4, 8), random(0, 359), 1)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LimFlashDemiseFX", random(28, 64), 0, random(8, 32), frandom(31, 33), 0, frandom(4, 8), random(0, 359), 1)
    TNT1 A 1
    stop
  }
}

actor LimDemiseFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(scaleX - frandom(0, 1))
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 21, 22, 23, 24, 41, 42, 43, 44)
    X_2F AABBAABBAABBAABBAABB 1
    stop
    X_2F DDEEDDEEDDEEDDEEDDEE 1
    stop
    X_2F XXYYXXYYXXYYXXYYXXYY 1
    stop
  }
}
actor LimFlashDemiseFX : LimDemiseFX {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(scaleX - frandom(0, 1))
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 11, 12, 13, 14, 21, 22, 23, 24)
    X_2F BBAABBAABB 1
    stop
    X_2F EEDDEEDDEE 1
    stop
    X_2F YYXXYYXXYY 1
    stop
  }
}


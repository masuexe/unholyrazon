actor Lim : CustWepClassBase
{
player.scoreIcon "UMUG_43"
player.displayname "Lim"
player.soundclass "Lim"
player.maxhealth 1000
health 1000
player.forwardmove 1.2, 1.2
player.sidemove 1.1, 1.1
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "IsLimFlag"
player.startitem "Lim_W"
player.startitem "DireEnergyAmmo", 60
player.startitem "LimHealth", 1000
States
{
Spawn:
ENKR A 0
ENKR B 1
ENKR A 1
goto Spawn+2
See:
ENKR BCDE 5
goto Spawn
Missile:
ENKR F 0 A_JumpIfInventory("VivifyCycle1",1,"Missile2")
ENKR F 0 A_JumpIfInventory("PowerLimFiringSlow",1,2)
ENKR J 4
//ENKR K 2
//ENKR L 7
ENKR FG 4
goto Spawn+2
Missile2:
ENKR J 6
Missile3:
ENKR Y 2
ENKR YYY 1 A_JumpIfInventory("VivifyCycle1",1,"Missile3")
goto Spawn+2

ClassPain:
ENKR H 0 A_JumpIfInventory("VivifyCycle1",1,"Missile3")
goto MegamanPain

ClassDeath:
ENKR H 0
goto MegamanDeath
MegamanDeath0:
ENKR H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
ENKR HHHHHHHHHHHHHHHHHHHH 1 A_SpawnItemEx("LimDemiseFX_H",0,0,28,0,0,0,0,1)
ENKR H 0 A_PlaySound("Lim/MirrorCounter",1)
ENKR H 0 A_SpawnItemEx("LimFlashDemiseFX_H",0,0,28,0,0,0,0,1)
ENKR H 0 A_SpawnItemEx("LimFlashDemise",0,0,28)
ENKR H 1 A_PlaySound("*death",2)
ENKR HHHHHH 1 A_FadeOut(0.167,0)
ENKR H 1
Goto MegamanErase
MegamanCorpse:
ENKR Z 0 A_SpawnItemEx("Corpse_43",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor LimS : Lim
{
player.scoreIcon "UMUG_S43"
player.maxhealth 3000
health 3000
player.forwardmove 1.3, 1.3
player.sidemove 1.2, 1.2
player.jumpz 11
player.morphweapon "LimS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
ENKR H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
ENKR HHHHHHHHHHHHHHHHHHHH 1 A_SpawnItemEx("LimDemiseFX_H",0,0,28,0,0,0,0,1)
ENKR H 0 A_PlaySound("Lim/MirrorCounter",1)
ENKR H 0 A_SpawnItemEx("LimFlashDemiseFX_H",0,0,28,0,0,0,0,1)
ENKR H 0 A_SpawnItemEx("S_LimFlashDemise",0,0,28)
ENKR H 1 A_PlaySound("*death",2)
ENKR HHHHHH 1 A_FadeOut(0.167,0)
ENKR H 1
Goto MegamanErase
}
}


actor LimFlashDemise : LimAltFlash
{
Obituary "$OB_43D"
Args 250,256,24
}
actor S_LimFlashDemise : LimFlashDemise
{
Args 375,256,24
}

actor LimDemiseFX_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("FlashM_GenesisSparkleFX",random(28,64),0,random(-16,32),0,0,0,random(0,359),1)
TNT1 AAA 0 A_SpawnItemEx("LimDemiseFX",random(28,64),0,random(-16,32),0,0,0,random(0,359),1)
TNT1 A 1
stop
}
}
actor LimFlashDemiseFX_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LimFlashDemiseFX",random(28,64),0,random(-16,8),frandom(31,33),0,frandom(4,8),random(0,359),1)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LimFlashDemiseFX",random(28,64),0,random(8,32),frandom(31,33),0,frandom(4,8),random(0,359),1)
TNT1 A 1
stop
}
}

actor LimDemiseFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetScale(ScaleX-frandom(0,1))
TNT1 A 0 A_Jump(256,1,2,3,4,21,22,23,24,41,42,43,44)
X_2F AABBAABBAABBAABBAABB 1
stop
X_2F DDEEDDEEDDEEDDEEDDEE 1
stop
X_2F XXYYXXYYXXYYXXYYXXYY 1
stop
}
}
actor LimFlashDemiseFX : LimDemiseFX
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetScale(ScaleX-frandom(0,1))
TNT1 A 0 A_Jump(256,1,2,3,4,11,12,13,14,21,22,23,24)
X_2F BBAABBAABB 1
stop
X_2F EEDDEEDDEE 1
stop
X_2F YYXXYYXXYY 1
stop
}
}


actor Corpse_43:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_43_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_43_1",0,0,36,momx+random(-4,4),momy+frandom(-1,1),momz+frandom(6,12),random(-2,2),169,0)
TNT1 A 0 A_SpawnItemEx("Corpse_43_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_43_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_43_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_43_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_43_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}

actor Corpse_43_1
{
+MISSILE
+HEXENBOUNCE
-BOUNCEONFLOORS
-SOLID
+CLIENTSIDEONLY
+THRUACTORS
bouncefactor 0.4
wallbouncefactor 0.75
ReactionTime 100
Damage (0)
radius 4
height 4
scale 2.5
States
{
Spawn:
1H43 PQ 2 A_CountDown
loop
Death:
1H43 R 0 A_ChangeFlag("DONTBLAST",1)
1H43 R 0 A_PlaySoundEx("weapon/freezecrackerhit","Weapon")
1H43 R 300
1H43 RRRRRRRRRR 3 A_Fadeout
stop
}
}


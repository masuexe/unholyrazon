actor GreatShielder : CustWepClassBase
{
player.scoreIcon "UMUG_5"
player.displayname "GreatShielder"
player.soundclass "GreatShielder"
player.maxhealth 1750
health 1750
player.forwardmove 0.75, 0.75
player.sidemove 0.7, 0.7
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "GreatShielder_W"
player.startitem "TurtleEnergyAmmo", 100
States
{
Spawn:
1H05 A 0
1H05 B 1
1H05 A 1
Goto Spawn+2
See:
1H05 BCDE 5
Goto Spawn
Missile:
1H05 AA 2
1H05 FFFFFF 1
1H05 GGGGGG 1
goto Spawn+2
ClassPain:
1H05 H 0
Goto MegamanPain

ClassDeath:
1H05 H 0
Goto MegamanDeath
MegamanDeath0:
1H05 HH 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H05 H 17 A_SpawnItemEx("FallingGreatShield",0,20,4,13,0,3,0,1)
Goto MegamanFade
MegamanDisintegrate:
1H05 Z 0 A_SpawnItemEx("Corpse_05",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}

actor FallingGreatShield : BasicProjectile
{
Translation "192:192=138:138","198:198=130:130"
Damagetype "GreatShield"
Obituary "$OB_05D"
-NOGRAVITY
+DOOMBOUNCE
-ALLOWBOUNCEONACTORS
+THRUGHOST
+CANBOUNCEWATER
+SKYEXPLODE
BounceFactor 0.5
Damage(250)
Radius 26
Height 32
Speed 14
Scale 2.5
Args 350,166,16
States
{
Spawn:
6P05 B 3
loop
Death:
6P05 B 0 A_PlaySound("wep_L/mm5/napalmbombexplode",1)
6P05 B 0 A_SetGravity(0.0)
6P05 B 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}

actor GreatShielderS : GreatShielder
{
player.scoreIcon "UMUG_S5"
player.maxhealth 3750
health 3750
player.forwardmove 0.85, 0.85
player.sidemove 0.8, 0.8
player.jumpz 11
player.morphweapon "GreatShielderS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H05 HH 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H05 H 17 A_SpawnItemEx("S_FallingGreatShield",0,20,4,13,0,3,0,1)
Goto MegamanFade
}
}

actor S_FallingGreatShield : FallingGreatShield
{
Translation "192:192=224:224","198:198=28:28"
Damage(375)
Args 525,166,16
}

actor Corpse_05:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_05_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_05_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_05_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_05_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_05_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


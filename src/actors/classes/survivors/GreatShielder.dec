actor GreatShielder : CustWepClassBase {
  Player.ScoreIcon "UMUG_5"
  Player.DisplayName "GreatShielder"
  Player.SoundClass "GreatShielder"
  Player.MaxHealth 1750
  Health 1750
  Player.ForwardMove 0.75, 0.75
  Player.SideMove 0.7, 0.7
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "GreatShielder_W"
  Player.StartItem "TurtleEnergyAmmo", 100
  States {
   Spawn:
    1H05 A 0
    1H05 B 1
    1H05 A 1
    goto Spawn+2
   See:
    1H05 BCDE 5
    goto Spawn
   Missile:
    1H05 AA 2
    1H05 FFFFFF 1
    1H05 GGGGGG 1
    goto Spawn+2
   ClassPain:
    1H05 H 0
    goto MegamanPain

   ClassDeath:
    1H05 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H05 HH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H05 H 17 A_SpawnItemEx("FallingGreatShield", 0, 20, 4, 13, 0, 3, 0, 1)
    goto MegamanFade
   MegamanDisintegrate:
    1H05 Z 0 A_SpawnItemEx("Corpse_05", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor FallingGreatShield : BasicProjectile {
  Translation "192:192=138:138", "198:198=130:130"
  DamageType "GreatShield"
  Obituary "$OB_05D"
  -NOGRAVITY
  +DOOMBOUNCE
  -ALLOWBOUNCEONACTORS
  +THRUGHOST
  +CANBOUNCEWATER
  +SKYEXPLODE
  BounceFactor 0.5
  Damage (250)
  Radius 26
  Height 32
  Speed 14
  Scale 2.5
  Args 350, 166, 16
  States {
   Spawn:
    6P05 B 3
    loop
   Death:
    6P05 B 0 A_PlaySound("wep_L/mm5/napalmbombexplode", 1)
    6P05 B 0 A_SetGravity(0.0)
    6P05 B 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor GreatShielderShiny : GreatShielder {
  Player.ScoreIcon "UMUG_S5"
  Player.MaxHealth 3750
  Health 3750
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.8, 0.8
  Player.JumpZ 11
  Player.MorphWeapon "GreatShielderShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H05 HH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H05 H 17 A_SpawnItemEx("S_FallingGreatShield", 0, 20, 4, 13, 0, 3, 0, 1)
    goto MegamanFade
  }
}

actor S_FallingGreatShield : FallingGreatShield {
  Translation "192:192=224:224", "198:198=28:28"
  Damage (375)
  Args 525, 166, 16
}

actor Corpse_05 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_05_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_05_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_05_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_05_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_05_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_05_0 : BaseCorpseFX {States {Spawn: 1H05 O 350
    goto Spawn2}}
actor Corpse_05_1 : BaseCorpseFX {States {Spawn: 1H05 P 350
    goto Spawn2}}
actor Corpse_05_2 : BaseCorpseFX {States {Spawn: 1H05 Q 350
    goto Spawn2}}
actor Corpse_05_3 : BaseCorpseFX {States {Spawn: 1H05 R 350
    goto Spawn2}}
actor Corpse_05_4 : BaseCorpseFX {States {Spawn: 1H05 S 350
    goto Spawn2}}

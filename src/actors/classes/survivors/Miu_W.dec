actor MiuKittyBombToss : BasicProjectile {
  Translation "192:192=248:248", "198:198=231:231"
  DamageType "Miu"
  Obituary "$OB_56A3"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +RIPPER
  +SKYEXPLODE
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  BounceFactor 1.0
  WallBounceFactor 1.0
  ReactionTime 2
  // Bouncecount 10
  Gravity 1.75
  Damage (0)
  Radius 16
  Height 16
  Speed 26  // 26
  Scale 2.5
  Args 200, 128, 96, 2
  States {
   Spawn:
    6P56 A 0
    6P56 A 0 ThrustThingZ(0, 28, 0, 1)  // 30
    6P56 A 0 ThrustThing(angle * 256 / 360, 2, 1, 0)
    goto Spawn1
   Spawn1:
    6P56 ABABABAB 4
    loop
   Spawn2:
    6P56 CBCBCBCB 3
    loop
   Spawn3:
    6P56 CBCBCBCB 2
    loop
   Bounce.Floor:
    6P56 B 0 A_CountDownArg(3)
    6P56 B 0 A_Explode(args[0], args[1], 0, 0, args[2])
    6P56 B 0 A_PlaySound("wep/MiuBombBoom", 1)
    6P56 B 0 A_SpawnItemEx("MiuKittyBombFX", 0, 0, 20, 0, 0, 0, 0, 1)  // A_SpawnItemEx("BasicBoom4FX_WhiteX1",0,0,16,0,0,0,0,1+16384)
    6P56 B 0 A_ChangeVelocity(8, 0, 14, 3)
    6P56 B 0 A_JumpIf(args[3] >= 1, "Spawn2")
    goto Spawn3

   Death:
    6P56 C 0 A_SetGravity(0.0)
    6P56 C 1 A_JumpIf(args[3] <= 0, "Death2")
    TNT1 A 0 A_PlaySound("wep/MiuBombBoom", 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    // TNT1 A 2 A_SpawnItemEx("BasicBoom4FX_WhiteX1",0,0,16,0,0,0,0,1)
    TNT1 A 2 A_SpawnItemEx("MiuKittyBombFX", 0, 0, 20, 0, 0, 0, 0, 1)
    stop
   Death2:
    TNT1 A 0 A_PlaySound("V_Man/Boom", 1)
    TNT1 A 0 A_Explode(args[0] * 2, args[1] * 1.5, 0, 0, args[2] * 1.5)
    TNT1 A 0 A_SpawnItemEx("MiuKittyBomb2_H", 0, 0, 16, 0, 0, 0, 0, 1)
    TNT1 A 2 A_SpawnItemEx("BasicBoom1FX_XB", 0, 0, 16, 0, 0, 0, 0, 1)
    stop
  }
}



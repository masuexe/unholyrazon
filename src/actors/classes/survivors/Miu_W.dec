// Unbound Ravager permits redirects during its idle window.
// One owned property layer spans the whole chain, including bot redirects.
actor MiuRavagerActive_F : Inventory {Inventory.MaxAmount 1}
actor MiuRavagerStopped_F : Inventory {Inventory.MaxAmount 1}

actor Miu_W_ScriptBar : ScriptBar {}

// Mindy 'Miu' Robinson
actor Miu_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 120
  Inventory.Pickupmessage "$PU_56_A"
  Obituary "$OB_56W1"
  Tag "$TAG_Miu_W"
  Weapon.AmmoType2 "MiuEnergyAmmo"
  Weapon.AmmoType "MiuCannonAmmo"
  Inventory.Icon "C_I_56A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H56 [ 6
    loop

   Deselect:
    6H56 A 0 A_GiveInventory("Miu_RavagerCleanup_P")
    goto DeselectSwap
   DeselectDeath:
    6H56 A 0 A_GiveInventory("Miu_RavagerCleanup_P")
    goto BaseMM8BDMWep_UH::DeselectDeath
   Select:
    6H56 A 0 A_TakeInventory("WeaponCharge")
    goto SelectSwap

   Ready:
    6H56 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", MIU_DYE)
    6H56 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2
   Ready1:
    6H56 A 20 A_WeaponReady(WRF_NOSECONDARY)
   Ready2:
    6H56 A 2 A_GiveInventory("Miu_Ready_P")
    loop


   Fire:
    6H56 A 0 A_GunFlash("NoFlash", 1)
    6H56 C 0 A_JumpIfInventory("VivifyFlag1", 1, "AltEnd")
    6H56 C 2 A_GiveInventory("Miu_Fire1_P1")
    6H56 D 2 A_GiveInventory("Miu_Fire1_P2")
    6H56 E 2 A_GiveInventory("Miu_Fire1_P3")
    6H56 F 2 A_GiveInventory("Miu_Fire1_P4")
    TNT1 A 2 A_GiveInventory("Miu_Fire1_P5")
    TNT1 A 4
    6H56 RS 2
    6H56 T 2 A_ReFire("FireHStart")
    goto Ready2

   Flash:
    TNT1 A 2 A_GiveInventory("Miu_FireHold_P")
    loop

   FireHStart:
    6H56 A 0 A_GunFlash("Flash", 1)
    6H56 B 1
    6H56 B 0 A_ReFire("FireH")
    goto Fire
   FireH:
    6H56 C 0 A_JumpIfInventory("WeaponCharge", 20, "FireH0")
    6H56 C 1
    6H56 C 0 A_ReFire("FireH")
    goto Fire
   FireH0:
    6H56 G 0 A_PlaySound("wep/MiuCharge", 1)
   FireH1:
    6H56 G 1
    6H56 C 0 A_ReFire(1)
    goto FireSwordSpin
    6H56 G 1 A_RailWait
    6H56 C 0 A_ReFire(1)
    goto FireSwordSpin
    6H56 C 1
    6H56 C 0 A_ReFire(1)
    goto FireSwordSpin
    6H56 C 1 A_RailWait
    6H56 C 0 A_ReFire("FireH1")
    goto FireSwordSpin

   FireSwordSpin:
    6H56 H 0 A_GiveInventory("Miu_Fire2_P")
    6H56 HIJK 1
    6H56 ZZZZZZ 1
    6H56 LMNODPQ 1
    6H56 Z 7
    6H56 RS 2
    6H56 T 2 A_ReFire("FireHStart")
    goto Ready2

   Altfire:
    TNT1 A 0 A_GiveInventory("Miu_RavagerStart_P")
    TNT1 A 0 A_ReFire(1)
    TNT1 A 0 A_GunFlash("NoFlash", 1)
    TNT1 AAAAAAAAAA 2 A_GiveInventory("Miu_Ravager_P")
    TNT1 A 2 A_GiveInventory("Miu_RavagerHalt_P")
    TNT1 A 1 A_JumpIfInventory("MiuEnergyAmmo", 1, "AltIdle")
    goto AltEnd
   AltIdle:
    TNT1 A 0 A_GiveInventory("Miu_RavagerHalt_P2")
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_GiveInventory("Miu_RavagerIdle_P")
    goto AltEnd
   AltEnd:
    TNT1 A 0 A_GiveInventory("Miu_RavagerEnd_P")
    TNT1 A 0 A_ReFire(1)
    TNT1 A 4
    6H56 RST 2
    goto Ready1


   BotSwap:
    6H56 A 0 A_PlaySoundEx("classes/taunt/miu", "Voice")
    6H56 A 0 A_GiveInventory("MiuCannonAmmo", random(1, 4) * 25)
    6H56 A 0 A_SelectWeapon("Miu_W2")
    goto BotReady
   BotReady:
    6H56 A 0 A_WeaponReady(12)
    6H56 A 2 A_ReFire("Bot_F")
    6H56 A 0 A_GiveInventory("MiuEnergyAmmo", 3)
    6H56 A 0 A_GiveInventory("MiuCannonAmmo", 2)
    loop

   Bot_F:
    6H56 A 0 A_JumpIfInventory("MiuDashFlag", 1, "Bot_A2")
    6H56 A 0 A_JumpIfInventory("MiuEnergyAmmo", 0, "Bot_A")
    6H56 A 0 A_Jump(16, 2)
    6H56 A 0 A_Jump(32, "BotSwap")
    goto BotFire1
    6H56 A 0 A_PlaySoundEx("classes/taunt/miu", "Voice")
    6H56 A 0 A_GiveInventory("MiuEnergyAmmo", random(60, 240))
    6H56 A 0 A_GiveInventory("MiuCannonAmmo", random(30, 120))
    goto Bot_F+3

   Bot_A:
    6H56 A 0 A_Jump(96, "BotAlt")
    goto Bot_F+2
   Bot_A2:
    6H56 A 0 A_Jump(56, "BotAltEnd")
    6H56 A 0 A_FaceTarget
    6H56 A 0 A_Jump(32, 1)
    goto BotAlt
    6H56 A 0 A_PlaySoundEx("classes/taunt/miu", "Voice")
    6H56 A 0 A_GiveInventory("MiuEnergyAmmo", random(2, 6) * 30)
    goto BotAlt

   BotFire1:
    6H56 C 0 A_Jump(224, 2)
    6H56 C 0 A_Recoil(-15)
    6H56 C 2 A_GiveInventory("Miu_Fire1_P1")
    6H56 D 2 A_GiveInventory("Miu_Fire1_P2")
    6H56 E 2 A_GiveInventory("Miu_Fire1_P3")
    6H56 F 2 A_GiveInventory("Miu_Fire1_P4")
    6H56 Z 2 A_GiveInventory("Miu_Fire1_P5")
    6H56 ZZRS 2
    6H56 T 0 A_GiveInventory("MiuEnergyAmmo", 20)
    6H56 T 2 A_ReFire(1)
    goto BotReady
    6H56 A 0 A_Jump(96, "Bot_F")
    goto BotFireH

   BotFire2:
    6H56 H 0 A_GiveInventory("Miu_Fire2_P")
    6H56 HIJK 1
    6H56 ZZZZZZ 1
    6H56 LMNODPQZ 1
    6H56 ZZZRST 2
    goto BotReady

   BotFireH:
    6H56 C 0 A_JumpIfInventory("WeaponCharge", 20, "BotFireH0")
    6H56 C 0 A_Recoil(-2.5)
    6H56 C 2 A_GiveInventory("WeaponCharge", 2)
    6H56 C 0 A_ReFire("BotFireH")
    goto BotFire1
   BotFireH0:
    6H56 G 0 A_GiveInventory("MiuEnergyAmmo", 20)
    6H56 G 0 A_PlaySound("wep/MiuCharge", 1)
   BotFireH1:
    6H56 G 0 A_Recoil(-2.5)
    6H56 G 1 A_Jump(32, "BotFire2")
    6H56 G 0 A_ReFire("BotFireH1")
    goto BotFire2

   BotAlt:
    TNT1 A 0 A_GiveInventory("Miu_RavagerStart_P")
    TNT1 A 0 A_ReFire(1)
    TNT1 AAAAAAAAAA 2 A_GiveInventory("Miu_Ravager_P")
    TNT1 A 2 A_GiveInventory("Miu_RavagerHalt_P")
    TNT1 A 1 A_JumpIfInventory("MiuEnergyAmmo", 1, 1)
    goto BotAltEnd
    TNT1 A 2 A_ReFire("Bot_A2")
    goto BotAltEnd
   BotAltEnd:
    TNT1 A 0 A_GiveInventory("Miu_RavagerEnd_P")
    TNT1 A 0 A_ReFire(1)
    TNT1 A 4
    6H56 RST 2
    goto BotReady
  }
}

actor Miu_W2_ScriptBar : Miu_W_ScriptBar {}
actor Miu_W2 : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 120
  Inventory.Pickupmessage "$PU_56_B"
  Obituary "$OB_56W2"
  Tag "$TAG_Miu_W2"
  Weapon.AmmoType2 "MiuEnergyAmmo"
  Weapon.AmmoType "MiuCannonAmmo"
  Inventory.Icon "C_I_56B"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H56 [ 6
    loop

   Deselect:
    6H56 U 0
    goto DeselectSwap
   Select:
    6H56 U 0 A_TakeInventory("WeaponCharge")
    goto SelectSwap

   Ready:
    6H56 U 0 ACS_NamedExecuteWithResult("core_weaponcolor", MIU_DYE)
    6H56 U 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2
   Ready2:
    6H56 U 2 A_GiveInventory("Miu_Ready_P2")
    loop

   Fire:
    6H56 W 0 A_GiveInventory("Miu_Fire3_P")
    6H56 W 0 A_ReFire(1)
    6H56 W 1
    6H56 W 1 A_ReFire(1)
    goto FireEnd+1
    6H56 W 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    6H56 W 0 A_ReFire(1)
    goto FireEnd+1
    6H56 V 1
    6H56 V 1 A_ReFire(1)
    goto FireEnd+2
    6H56 V 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    6H56 U 0 A_ReFire(1)
    goto FireEnd+2
   FireH:
    6H56 U 1 A_RailWait
    6H56 U 0 A_ReFire("FireH")
    goto FireEnd+3

   FireEnd:
    6H56 WVU 2
    6H56 U 0 A_TakeInventory("VivifyFlag2")
    goto Ready2

   Altfire:
    6H56 U 0 A_GiveInventory("Miu_Alt2_P")
    6H56 U 0 A_ReFire(1)
    6H56 W 2 Offset(24, 44)
    6H56 W 2 Offset(48, 64)
    6H56 W 2 Offset(44, 64)
    6H56 V 2 Offset(36, 56)
    6H56 V 2 Offset(16, 40)
    6H56 V 2 Offset(8, 32)
    6H56 U 2 A_WeaponReady(14)
    goto Ready2



   BotSwap:
    6H56 U 0 A_PlaySoundEx("classes/taunt/miu", "Voice")
    6H56 U 0 A_GiveInventory("MiuEnergyAmmo", random(1, 4) * 50)
    6H56 U 0 A_SelectWeapon("Miu_W")
    goto BotReady
   BotReady:
    6H56 U 0 A_WeaponReady(12)
    6H56 U 2 A_ReFire("Bot_F")
    6H56 U 0 A_GiveInventory("MiuEnergyAmmo", 3)
    6H56 U 0 A_GiveInventory("MiuCannonAmmo", 2)
    loop

   Bot_F:
    6H56 U 0 A_JumpIfInventory("MiuCannonAmmo", 0, "Bot_A")
    6H56 U 0 A_GiveInventory("MiuCannonAmmo", random(6, 12))
    6H56 U 0 A_Jump(10, "BotSwap")
    6H56 U 0 A_Jump(24, "BotAlt")
    6H56 U 0 A_Jump(11, 1)
    goto BotFire
    6H56 U 0 A_PlaySoundEx("classes/taunt/miu", "Voice")
    6H56 U 0 A_GiveInventory("MiuEnergyAmmo", random(30, 120))
    6H56 U 0 A_GiveInventory("MiuCannonAmmo", random(15, 60))
    goto BotFire
   Bot_A:
    6H56 U 0 A_Jump(78, "BotAlt")
    goto Bot_F+1

   BotFire:
    6H56 U 0 A_GiveInventory("Miu_Fire3_P")
    6H56 U 0 A_ReFire(1)
    6H56 WVU 2
    goto BotReady

   BotAlt:
    6H56 U 0 A_GiveInventory("Miu_Alt2_P")
    6H56 U 0 A_ReFire(1)
    6H56 WV 5
    6H56 U 4
    goto BotReady
  }
}

actor MiuEnergyAmmo : Ammo {
  Inventory.MaxAmount 240
  +INVENTORY.IGNORESKILL
}

actor MiuCannonAmmo : Ammo {
  Inventory.MaxAmount 120
  +INVENTORY.IGNORESKILL
}

actor MiuDashFlag : Inventory {
  Inventory.MaxAmount 28
}

actor Miu_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MiuEnergyAmmo", 0, 2)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("MiuEnergyAmmo", 3)
    TNT1 A 0 A_GiveInventory("MiuCannonAmmo", 2)
    stop
  }
}
actor Miu_Ready_P2 : Miu_Ready_P {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MiuCannonAmmo", 0, 2)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo
  }
}

actor Miu_FireHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("MiuCannonAmmo", 1)
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 20, "PickupX")
    TNT1 A 0 A_GiveInventory("MiuEnergyAmmo", 1)
    TNT1 A 0 A_GiveInventory("WeaponCharge", 1)
    stop
   PickupX:
    TNT1 A 0 A_GiveInventory("MiuEnergyAmmo", 2)
    stop
  }
}

actor Miu_Fire1_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("WeaponCharge")
    TNT1 A 0 A_PlaySound("wep/MiuSword", 1)  // weapon/slashclaw
    TNT1 A 0 A_SpawnItemEx("MiuSlashing1", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, 0, 40)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_SpawnItemEx("MiuSlashing1", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, 15, 40)
    TNT1 A 0 A_SpawnItemEx("MiuSlashing1", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, -15, 40)
    stop
  }
}
actor Miu_Fire1_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("MiuSlashing2", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, 0, 40)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_SpawnItemEx("MiuSlashing2", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, 15, 40)
    TNT1 A 0 A_SpawnItemEx("MiuSlashing2", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, -15, 40)
    stop
  }
}

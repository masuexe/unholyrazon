actor Miu_Fire2_P : CustomInventory {
  States {
   Pickup:
    // A_SpawnItemEx("MiuSpinExplosion",0,0,28,velx,vely,velz,0,8)
    // A_SetAngle(angle+30.0)
    TNT1 A 0 A_SpawnItemEx("MiuSpinTrailFX_H", 0, 0, 0, 0, 0, 0, -30, 1)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE), 2)
    TNT1 A 0 A_FireCustomMissile("MiuSpinExplosion", -30, 0, 0, 0)
    goto Thrust
    TNT1 A 0 A_FireCustomMissile("MiuSpinExplosion2", -30, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("MiuSpinExplosion2", -60, 0, 0, 0)
    goto Thrust

   Thrust:
    TNT1 A 0 A_TakeInventory("WeaponCharge")
    TNT1 A 0 A_PlaySound("wep/MiuSpinAtt", 1)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_Recoil(-18)  // -10
    goto EndF
    TNT1 A 0 A_Recoil(-28)
    goto EndF
   EndF:
    TNT1 A 0 A_GunFlash(1, 1)
    TNT1 A 0
    stop
  }
}


actor Miu_Fire3_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MiuCannonShot", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_GiveInventory("VivifyFlag2")
    TNT1 A 0 A_PlaySound("KirbyNES/Shotzo", 1)
    // TNT1 A 0 A_GiveInventory("MiuEnergyAmmo",3)
    // TNT1 A 0 A_GiveInventory("MiuCannonAmmo",2)
    stop
  }
}
actor Miu_Alt2_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("MiuKittyBombToss", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    TNT1 A 0 A_PlaySound("wep/MiuBomb", 1)
    TNT1 A 0 A_TakeInventory("MiuCannonAmmo", 60)
    TNT1 A 0 A_TakeInventory("MiuCannonAmmo", 60, 1)
    stop
  }
}



actor Miu_RavagerStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyFlag1")
    TNT1 A 0 A_TakeInventory("MiuDashFlag")
    TNT1 A 0 A_PlaySound("weapon/CatRavager", 1)
    TNT1 A 0 A_JumpIfInventory("MiuRavagerActive_F", 1, "Redirect")
    TNT1 A 0 A_GiveInventory("MiuRavagerActive_F")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, 2)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
   Redirect:
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE), 2)
    TNT1 A 0 A_ChangeVelocity(33 * cos(pitch), 0, 33 * -sin(pitch), 3)
    goto Setup
    TNT1 A 0 A_ChangeVelocity(46 * cos(pitch), 0, 46 * -sin(pitch), 3)
    goto Setup
   Setup:
    TNT1 A 0 A_SetArg(1, angle)
    TNT1 A 0 A_SetArg(2, velx * 100000)
    TNT1 A 0 A_SetArg(3, vely * 100000)
    TNT1 A 0 A_SetArg(4, velz * 100000)
    stop
  }
}

actor Miu_Ravager_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("MiuRavager", 0, 0, 32, velx, vely, velz, 0, 8)
    TNT1 A 0 A_ChangeVelocity(args[2] * 0.00001, args[3] * 0.00001, args[4] * 0.00001, CVF_REPLACE)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_RAGE), 3)
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 4)
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 4, 1)
    stop
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 3)
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 3, 1)
    stop
  }
}
actor Miu_RavagerHalt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_ScaleVelocity(0.25)
    // TNT1 A 0 ThrustThingZ(0,1,0,1)
    TNT1 A 0 A_GiveInventory("MiuDashFlag", 28)
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, "PickupEnd")
    TNT1 A 0 A_JumpIfInventory("MiuRavagerStopped_F", 1, "PickupEnd")
    TNT1 A 0 A_GiveInventory("MiuRavagerStopped_F")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
   PickupEnd:
    TNT1 A 0
    stop
  }
}
actor Miu_RavagerHalt_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 1)
    stop
    TNT1 A 0 ThrustThingZ(0, 4, 0, 0)
    stop
  }
}
actor Miu_RavagerIdle_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_WeaponReady(WRF_DISABLESWITCH)
    TNT1 A 0 A_SpawnItemEx("MiuRavager2", 0, 0, 32, velx, vely, velz, 0, 8)
    TNT1 A 0 A_TakeInventory("MiuDashFlag", 1)
    stop
  }
}
actor Miu_RavagerCleanup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MiuRavagerActive_F", 1, "Cleanup")
    TNT1 A 0
    stop
   Cleanup:
    TNT1 A 0 A_TakeInventory("MiuRavagerActive_F")
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_TakeInventory("MiuDashFlag")
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantpushwallsplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    TNT1 A 0 A_JumpIfInventory("MiuRavagerStopped_F", 1, "Unstop")
    TNT1 A 0
    stop
   Unstop:
    TNT1 A 0 A_TakeInventory("MiuRavagerStopped_F")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    stop
  }
}

actor Miu_RavagerEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MiuRavagerActive_F", 1, "EndDash")
    TNT1 A 0
    stop
   EndDash:
    TNT1 A 0 A_PlaySound("weapon/waterballoon", 4)
    TNT1 A 0 A_SpawnItemEx("BubblePop")
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 40, 1)
    TNT1 A 0 A_TakeInventory("MiuEnergyAmmo", 40)
    TNT1 A 0 A_GiveInventory("Miu_RavagerCleanup_P")
    stop
  }
}


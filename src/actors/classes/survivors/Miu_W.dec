actor Miu_Fire1_P5 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("MiuSlashing5", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, 0, 40)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)

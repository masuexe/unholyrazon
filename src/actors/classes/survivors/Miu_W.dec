actor MiuSpinTrailFX_H : BasicClientSide {
  Args 30, 14
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_JumpIf(CallACS("uh_IsPointerClient", 2, 0, 1) != 1, "Spawn2")
    TNT1 A 1
    stop
   Spawn2:
    TNT1 A 0
    TNT1 A 0 A_SetArg(2, 1 + CallACS("uh_checkrune", RUNE_RAGE, 2))
    TNT1 A 0 A_SetArg(1, 14 / args[2])
    TNT1 A 0 A_SetArg(0, 30 * args[2])
   SpawnL:
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 0, args[0], 4 + 8 + 16)
    TNT1 A 0 A_SpawnItemEx("MiuSpinTrailFX", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    TNT1 A 1 A_CountDownArg(1)
    loop
  }
}

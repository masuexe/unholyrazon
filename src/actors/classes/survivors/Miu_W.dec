    TNT1 A 0 A_SpawnItemEx("MiuSlashing5", cos(-pitch) * 52, 0, 32 + (sin(-pitch) * 52), cos(-pitch) * velx, vely, sin(-pitch) * velz, -15, 40)
    stop

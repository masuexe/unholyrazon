actor BusterExpert_W_NormalBar : NormalBar {Args 86, 94}

actor BusterExpert_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 140
Inventory.Pickupmessage "$PU_03"
Obituary "$OB_03W"
Tag "Great Buster"
weapon.ammotype "ManlyManAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H03 [ 6
loop

Deselect:
6H03 A 0
goto DeselectSwap
Select:
6H03 A 0
goto SelectSwap

Ready:
6H03 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BUSTEREXPERT_DYE)
6H03 A 0 A_GunFlash("Flash",1)
goto Ready2

Ready2:
6H03 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H03 A 2 A_GiveInventory("BusterExpert_W_Ready_P")
wait

Fire:
6H03 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H03 C 0 A_PlaySound("weapon/mbuster",1)
6H03 C 0 A_FireCustomMissile("GreatShot",0,0,-8,0)
6H03 CCBBAAAAAAAA 2 A_GiveInventory("ManlyManAmmo",2)
Goto Ready2

Flash:
TNT1 A 1 A_JumpIfInventory("ManlyManAmmo",35,1)
loop
TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, 1)
wait
6H03 F 0 A_GunFlash(1)
6H03 F 2 A_GiveInventory("BusterExpert_Alt_P")
6H03 ED 2
TNT1 A 2
loop

BotFire:
6H03 B 0 A_JumpIfInventory("BotFlagDelay",1,3)
6H03 B 0 A_GunFlash("OldFlash",1)
6H03 B 0 A_GiveInventory("BotFlagDelay",1)
6H03 B 0 A_JumpIfInventory("ManlyManAmmo",35,1)
goto Fire+1
6H03 B 0 A_Jump(16,"BotFireX")
6H03 B 0 A_Jump(64,1)
goto Fire+1
6H03 B 0 A_GiveInventory("BotFlag1",random(2,5))
goto Fire+1
BotFireX:
6H03 B 0 A_PlaySoundEx("taunt/D_03","Voice")
6H03 B 0 A_PlaySound("weapon/mbuster",1)
6H03 B 0 A_FireCustomMissile("GreatShot",0,0,-8,0)
6H03 B 0 A_GiveInventory("Shocked",1)
6H03 B 0 A_Recoil(8)
6H03 BCA 2
6H03 B 0 A_PlaySound("weapon/mbuster",1)
6H03 B 0 A_FireCustomMissile("GreatShot",random(-7,-5),0,8,0)
6H03 B 0 A_Recoil(8)
6H03 BCA 2
6H03 B 0 A_PlaySound("weapon/mbuster",1)
6H03 B 0 A_FireCustomMissile("GreatShot",random(5,7),0,8,0)
6H03 B 0 A_Recoil(8)
6H03 BCA 2
Goto Ready2

OldFlash:
TNT1 A 1 A_JumpIfInventory("BotFlag1",1,1)
loop
6H03 E 0 A_GunFlash(1)
6H03 E 2 A_GiveInventory("BusterExpert_Alt_P")
6H03 FD 2
TNT1 A 1 A_TakeInventory("BotFlag1",1)
goto OldFlash

}
}

actor UberEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 100
+INVENTORY.IGNORESKILL
}

actor ManlyManAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 140
+INVENTORY.IGNORESKILL
}

actor BusterExpert_W_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
TNT1 A 0 A_GiveInventory("ManlyManAmmo",2)
stop
}
}

actor BusterExpert_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("GreatShotAlt",random(-2,2),0,-8,0)
End:
TNT1 A 0 A_TakeInventory("ManlyManAmmo",18,1)//25
TNT1 A 0 A_TakeInventory("ManlyManAmmo",17)//10
TNT1 A 0 A_PlaySound("weapon/mbuster",4)
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*11, 0, sin(pitch)*9,CVF_RELATIVE)//12,10
stop
}
}

actor GreatShot : BasicProjectile
{
Translation "192:192=86:86", "198:198=94:94", "199:199=87:87", "202:202=4:4"
damagetype "GreatBuster"
Obituary "$OB_03M"
+EXPLODEONWATER
+BRIGHT
Damage (110)
radius 20
height 20
Speed 60
scale 3.0
Args 110,148,20
States
{
Spawn:
X_0A ABCBC 2
Y_0A B 2
X_0A CBCB 2
Y_0A C 2
goto Spawn+1
Death:
TNT1 A 0 A_PlaySound("weapon/crackerexplode",1)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("GreatShotBoomFX",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_TRANSFERSCALE)
stop
}
}
actor GreatShotAlt : GreatShot
{
Damage (75)
radius 18
height 18
scale 2.5
Args 100,128,20
}

actor GreatShotBoomFX : UH_BasicBoomFX
{
States
{
Spawn:
6P03 A 0
6P03 ABCDEFG 2
stop
}
}

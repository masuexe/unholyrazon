actor Kate : CustWepClassBase
{
player.scoreIcon "UMUG_53"
player.displayname "Kate"
player.soundclass "Kate"
Player.Maxhealth 950
health 950
player.forwardmove 0.975, 0.975
player.sidemove 0.975, 0.975
player.jumpz 13
Player.StartItem "UH_BaseFlagPack"
player.startitem "Kate_W"
player.startitem "Kate_W2"
player.startitem "MistCloakAmmo", 200

player.startitem "WallJumpLimit", 2

player.weaponslot 1, "Kate_W"
player.weaponslot 2, "Kate_W2"
States
{
Spawn:
1H53 A 0
1H53 B 1
1H53 A 1
Goto Spawn+2
See:
1H53 BCDE 5
Goto Spawn
Missile:
1H53 F 5
1H53 G 4
goto Spawn+2
ClassPain: 1H53 H 0
Goto MegamanPain

ClassDeath:
1H53 H 0
goto MegamanDeath
MegamanDeath0:
1H53 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H53 H 19 A_PlaySound("KirbyNES/Hit_D",2)
1H53 H 0 ThrustThingZ(0,82,0,0)
1H53 H 0 A_SpawnItemEx("KateKirbyDeathCorpse",0,0,0,0,0,20,0,1)
Goto MegamanErase
MegamanDisintegrate:
1H53 Z 0 A_SpawnItemEx("Corpse_53",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor KateShiny : Kate
{
player.scoreIcon "UMUG_S53"
Player.Maxhealth 2950
health 2950
player.forwardmove 1.075, 1.075
player.sidemove 1.075, 1.075
player.jumpz 14
player.morphweapon "KateShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H53 H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H53 H 19 A_PlaySound("KirbyNES/Hit_D",2)
1H53 H 0 ThrustThingZ(0,82,0,0)
1H53 H 0 A_SpawnItemEx("S_KateKirbyDeathCorpse",0,0,0,0,0,20,0,1)
Goto MegamanErase
}
}


actor KateKirbyDeathCorpse : BasicKirbyDeathCorpse
{
damagetype "Kate"
Obituary "$OB_53D"
States
{
Spawn:
1H53 H 0
1H53 H 0
goto Spawn2
}
}
actor S_KateKirbyDeathCorpse : KateKirbyDeathCorpse
{
Damage (113)
Args 375,168,16
}

actor Corpse_53:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_53_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_53_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_53_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_53_3",0,0,18,momx+frandom(-1,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_53_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_53_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


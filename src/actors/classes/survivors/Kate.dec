actor Kate : CustWepClassBase {
  Player.ScoreIcon "UMUG_53"
  Player.DisplayName "Kate"
  Player.SoundClass "Kate"
  Player.MaxHealth 950
  Health 950
  Player.ForwardMove 0.975, 0.975
  Player.SideMove 0.975, 0.975
  Player.JumpZ 13
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Kate_W"
  Player.StartItem "Kate_W2"
  Player.StartItem "MistCloakAmmo", 200

  Player.StartItem "WallJumpLimit", 2

  Player.WeaponSlot 1, "Kate_W"
  Player.WeaponSlot 2, "Kate_W2"
  States {
   Spawn:
    1H53 A 0
    1H53 B 1
    1H53 A 1
    goto Spawn+2
   See:
    1H53 BCDE 5
    goto Spawn
   Missile:
    1H53 F 5
    1H53 G 4
    goto Spawn+2
   ClassPain:
    1H53 H 0
    goto MegamanPain

   ClassDeath:
    1H53 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H53 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H53 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H53 H 0 ThrustThingZ(0, 82, 0, 0)
    1H53 H 0 A_SpawnItemEx("KateKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    1H53 Z 0 A_SpawnItemEx("Corpse_53", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor KateShiny : Kate {
  Player.ScoreIcon "UMUG_S53"
  Player.MaxHealth 2950
  Health 2950
  Player.ForwardMove 1.075, 1.075
  Player.SideMove 1.075, 1.075
  Player.JumpZ 14
  Player.MorphWeapon "KateShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H53 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H53 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H53 H 0 ThrustThingZ(0, 82, 0, 0)
    1H53 H 0 A_SpawnItemEx("S_KateKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
  }
}


actor KateKirbyDeathCorpse : BasicKirbyDeathCorpse {
  DamageType "Kate"
  Obituary "$OB_53D"
  States {
   Spawn:
    1H53 H 0
    1H53 H 0
    goto Spawn2
  }
}
actor S_KateKirbyDeathCorpse : KateKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

actor Corpse_53 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_53_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_53_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_53_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_53_3", 0, 0, 18, velx + frandom(-1, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_53_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_53_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_53_0 : BaseCorpseFX {States {Spawn: 1H53 O 350
    goto Spawn2}}
actor Corpse_53_1 : BaseCorpseFX {States {Spawn: 1H53 P 350
    goto Spawn2}}
actor Corpse_53_2 : BaseCorpseFX {States {Spawn: 1H53 Q 350
    goto Spawn2}}
actor Corpse_53_3 : BaseCorpseFX {States {Spawn: 1H53 R 350
    goto Spawn2}}
actor Corpse_53_4 : BaseCorpseFX {States {Spawn: 1H53 S 350
    goto Spawn2}}
actor Corpse_53_5 : BaseCorpseFX {States {Spawn: 1H53 T 350
    goto Spawn2}}

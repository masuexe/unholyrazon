actor TheDentistShiny_W_NormalBar : NormalBar {args 4, 168}

actor TheDentistShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_TheDentist_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_29"
Obituary "$OB_29W"
weapon.ammotype "ShinyEnergyAmmo"
States
{
Spawn:
7H29 [ 6
loop

Deselect:
7H29 A 0
goto DeselectSwap
Select:
7H29 A 0
goto SelectSwap

Ready:
7H29 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", THEDENTIST_SDYE)
Goto Ready2
Ready2:
7H29 A 2 A_GiveInventory("TheDentist_Ready_P")
loop

Fire:
7H29 E 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H29 C 0 A_GiveInventory("S_TheDentist_Fire_P")
7H29 FEDCB 1
TNT1 A 3
7H29 GH 2
Goto Ready2

BotFire:
7H29 A 0 A_Jump(16,"BotFire2")
7H29 A 0 A_Jump(32,1)
goto Fire+1
7H29 A 0 A_GiveInventory("ShinyEnergyAmmo",45)
7H29 A 0 A_Jump(128,"Altfire")
goto Fire+1
BotFire2:
7H29 A 0 A_PlaySoundEx("taunt/D_29","Voice")
7H29 A 0 A_FireCustomMissile("S_TheDentistShot",0,0,20,0)
7H29 A 0 A_FireCustomMissile("S_TheDentistShot",0,0,-20,0)
7H29 Q 2 A_GiveInventory("S_TheDentist_Alt_P")
7H29 S 0 A_GiveInventory("ShinyEnergyAmmo",60)
goto Altfire+2

AltFire:
7H29 S 0 A_GiveInventory("S_TheDentist_Alt_P")
7H29 QRSSRQ 2
Goto Ready2
}
}

actor S_TheDentist_Fire_P : TheDentist_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TheDentistShot",0,0,8,0)
goto Take
}
}

actor S_TheDentist_Alt_P : TheDentist_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TheDentistDrill",0,0,8,0)
goto Take
}
}

actor S_TheDentistShot : TheDentistShot
{
Translation "4:4=0:0","0:0=4:4"
Damage (158+Args[0])//105
Args 0,3
}

actor S_TheDentistDrill : TheDentistDrill
{
Translation "192:192=4:4","198:198=4:4"
Damage (113)//75
States
{
Death:
TNT1 A 0 A_Explode(150,96,0,0,24)//100
TNT1 A 0 A_SpawnItemEx("S_TheDentistRainFlush",0,0,0,0,0,0,0,1)
goto DeathFX
}
}


actor S_TheDentistRainFlush : TheDentistRainFlush
{
Args 45,488,224//30
}


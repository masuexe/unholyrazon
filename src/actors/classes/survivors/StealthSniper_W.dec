actor StealthSniperBlindShot : BasicProjectile {
  Translation "192:192=92:92", "198:198=3:3"
  Obituary "$OB_23A"
  DamageType "SniperBlind"
  +FORCEXYBILLBOARD
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +BOUNCEAUTOOFFFLOORONLY
  +SKYEXPLODE
  -NOGRAVITY
  BounceFactor 0.45
  WallBounceFactor 0.775
  ReactionTime 16
  BounceCount 12
  Damage (30)
  Radius 14
  Height 28
  Speed 13
  Scale 2.5
  Args 50, 448, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 16, 0, 1)
    TNT1 A 0 ThrustThing(angle * 256 / 360, 2, 1, 0)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   SpawnL:
    6P23 ABCDEFGH 1
    6P23 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 2 A_SpawnItemEx("StealthSniperBlindFX", 0, 0, 4, 0, 0, 4, 0, 1)
    stop
  }
}

actor StealthSniperDashFX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    stop
  }
}

actor StealthSniperBlindFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Translucent"
  Alpha 0.99
  States {
   Spawn:
    X_4A A 0
    X_4A A 1
    X_4A BCDEF 1 A_FadeOut(0.12)
    stop
  }
}


actor ShortRangeBlindofDeath : BasicExplosion_Args {
  Translation "192:192=4:4", "198:198=89:89"
  Obituary "$OB_23A"
  DamageType "SniperBlind"
  Args 50, 448, 16
}

// Spend after an authoritative state jump and sync the remaining ammo.
actor StealthSniper_W_BLINDINGBLIND_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("StealthyAmmo", 14)
    stop
  }
}

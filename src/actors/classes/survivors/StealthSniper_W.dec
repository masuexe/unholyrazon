// TODO: add invis ability

actor StealthSniper_W_ScriptBar : ScriptBar {}

actor StealthSniper_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 112
  Inventory.Pickupmessage "$PU_23"
  Obituary "$OB_23W"
  Tag "$TAG_StealthSniper_W"
  Weapon.AmmoType "StealthyAmmo"
  Weapon.AmmoType2 "Steal_thyFakeDashAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H23 [ 6
    loop

   Deselect:
    6H23 A 0
    goto DeselectSwap
   Select:
    6H23 A 0
    goto SelectSwap

   Ready:
    6H23 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", NO_DYE)  // STEALTHSNIPER_DYE
    6H23 A 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H23 A 0 A_JumpIfInventory("StealthyAmmo", 28, "Ready2")
    6H23 A 3 A_GiveInventory("StealthSniper_Ready_P")
    loop
   Ready2:
    6H23 D 0 A_JumpIfInventory("StealthyAmmo", 56, "Ready3")
    6H23 D 3 A_GiveInventory("StealthSniper_Ready_P")
    loop
   Ready3:
    6H23 G 0 A_JumpIfInventory("StealthyAmmo", 84, "Ready4")
    6H23 G 3 A_GiveInventory("StealthSniper_Ready_P")
    loop
   Ready4:
    6H23 J 0 A_JumpIfInventory("StealthyAmmo", 112, "Ready5")
    6H23 J 3 A_GiveInventory("StealthSniper_Ready_P")
    loop
   Ready5:
    6H23 M 3 A_GiveInventory("StealthSniper_Ready_P")
    loop

   Flash:
    TNT1 A 3 A_GiveInventory("Steal_thyFakeDashAmmo", 1)
    loop

   Fire:
    6H23 "#" 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H23 "#" 0 A_PlaySound("weapon/Dark3Rail", 1)  // weapon/timestopper
    6H23 C 0 A_JumpIfInventory("StealthyAmmo", 28, "FireRail1")
    6H23 B 0 A_RailAttack(424 + CallACS("rz_CountInv_StealthyAmmo", 0) * 94 / 28, 0, 0, "98E800", "D8F878", 1, 0, "StealthS_RailPuffFX", 0, 0, 0.0, 1, 14.5, 10.0, "StealthS_RailTrailFX")
    6H23 A 0 A_FireBullets(0, 0, 0, 0, "StealthS_BulletPuffFX", FBF_NOFLASH | FBF_NORANDOMPUFFZ)
    6H23 CB 3
    6H23 A 2
   FireRail0:
    6H23 "###" 2
    6H23 "#" 2 Offset(20, 38)
    6H23 "#" 2 Offset(37, 50)
    6H23 "#" 2 Offset(51, 66)
    6H23 "#" 2 Offset(62, 86)
    6H23 "#" 2 Offset(71, 108)
    TNT1 A 8 A_TakeInventory("StealthyAmmo")
    6H23 A 2 Offset(71, 108)
    6H23 A 2 Offset(62, 86)
    6H23 A 2 Offset(51, 66)
    6H23 A 2 Offset(37, 50)
    6H23 A 2 Offset(20, 38)
    goto Ready1

   FireRail1:  //
    6H23 F 0 A_JumpIfInventory("StealthyAmmo", 56, "FireRail2")
    6H23 E 0 A_RailAttack(424 + CallACS("rz_CountInv_StealthyAmmo", 0) * 94 / 28, 0, 0, "006800", "50A000", 1, 0, "StealthS_RailPuffFX1", 0, 0, 0.0, 1, 14.5, 10.0, "StealthS_RailTrailFX1")
    6H23 D 0 A_FireBullets(0, 0, 0, 0, "StealthS_BulletPuffFX1", FBF_NOFLASH | FBF_NORANDOMPUFFZ)
    6H23 FE 3
    6H23 D 2
    goto FireRail0
   FireRail2:
    6H23 I 0 A_JumpIfInventory("StealthyAmmo", 84, "FireRail3")
    6H23 H 0 A_RailAttack(424 + CallACS("rz_CountInv_StealthyAmmo", 0) * 94 / 28, 0, 0, "AC7C00", "FFFF73", 1, 0, "StealthS_RailPuffFX2", 0, 0, 0.0, 1, 14.5, 10.0, "StealthS_RailTrailFX2")
    6H23 G 0 A_FireBullets(0, 0, 0, 0, "StealthS_BulletPuffFX2", FBF_NOFLASH | FBF_NORANDOMPUFFZ)
    6H23 IH 3
    6H23 G 2
    goto FireRail0
   FireRail3:
    6H23 L 0 A_JumpIfInventory("StealthyAmmo", 112, "FireRail4")
    6H23 K 0 A_RailAttack(424 + CallACS("rz_CountInv_StealthyAmmo", 0) * 94 / 28, 0, 0, "E05000", "FFA000", 1, 0, "StealthS_RailPuffFX3", 0, 0, 0.0, 1, 14.5, 10.0, "StealthS_RailTrailFX3")
    6H23 J 0 A_FireBullets(0, 0, 0, 0, "StealthS_BulletPuffFX3", FBF_NOFLASH | FBF_NORANDOMPUFFZ)
    6H23 LK 3
    6H23 J 2
    goto FireRail0
   FireRail4:
    6H23 O 0 A_PlaySound("weapons/railgf", 1)
    6H23 N 0 A_RailAttack(424 + CallACS("rz_CountInv_StealthyAmmo", 0) * 94 / 28, 0, 0, "9B0000", "FF1F1F", 1, 0, "StealthS_RailPuffFX4", 0, 0, 0.0, 1, 14.5, 10.0, "StealthS_RailTrailFX4")
    6H23 M 0 A_FireBullets(0, 0, 0, 0, "StealthS_BulletPuffFX4", FBF_NOFLASH | FBF_NORANDOMPUFFZ)
    6H23 ON 3
    6H23 M 2
    goto FireRail0

   BotFire:
    6H23 A 0 A_JumpIfCloser(256, "BotAlt")
    6H23 A 0 A_Jump(32, "BotFire2")
    6H23 A 0 A_Jump(96, "BotFire3")
    6H23 A 0 A_Jump(64, 1)
    goto Fire+1
    6H23 A 0 A_Jump(128, "BotFire4")
    6H23 A 0 A_GiveInventory("StealthyAmmo", random(1, 3) * 28)
    6H23 A 0 A_Jump(64, "BotFire3")
    goto Fire+1
   BotFire2:
    6H23 A 0 A_GiveInventory("StealthyAmmo", 28)
    6H23 A 0 A_PlaySoundEx("classes/taunt/stealthsniper", "Voice")
    6H23 AAA 0 A_FaceTarget
    goto Fire+1
   BotFire3:
    6H23 A 5
    6H23 A 0 ThrustThingZ(0, random(16, 40), 0, 0)
    6H23 A 0 ThrustThing(angle * 256 / 360 + 64 * random(0, 3), random(25, 40), 0, 0)
    6H23 A 20 A_Jump(96, 2)
    6H23 A 0 A_Jump(128, "BotFire4")
    goto Fire+1
    6H23 AAAAA 3 A_GiveInventory("StealthyAmmo", random(3, 10))
    6H23 A 0 ThrustThingZ(0, random(16, 40), 0, 0)
    6H23 A 0 ThrustThing(angle * 256 / 360 + 64 * random(0, 3), 40, 1, 0)
    6H23 A 10
    6H23 A 10 A_Jump(160, "BotFire2")
    goto Fire+1
   BotFire4:
    6H23 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 0, true, 0)
    6H23 A 0 A_PlaySound("weapon/pursuitfire", 1)
    6H23 BBCCCCCCCCCCCBB 2 A_GiveInventory("StealthyAmmo", random(2, 6))
    6H23 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 0, false, 0)
    6H23 A 0 A_Jump(128, "BotFire2")
    goto Fire+1
   BotAlt:
    6H23 A 0 A_Jump(196, "BLINDINGBLIND")
    goto AltFire

   AltFire:
    6H23 "#" 0 A_GiveInventory("StealthSniper_Alt_P")
    6H23 "#" 0 A_ReFire(1)
    6H23 A 0 A_JumpIfInventory("StealthyAmmo", 28, 1)
    goto AltFireEnd
    6H23 D 0 A_JumpIfInventory("StealthyAmmo", 56, 1)
    goto AltFireEnd
    6H23 G 0 A_JumpIfInventory("StealthyAmmo", 84, 1)
    goto AltFireEnd
    6H23 J 0 A_JumpIfInventory("StealthyAmmo", 112, 1)
    goto AltFireEnd
    6H23 M 0 A_RailWait
    goto AltFireEnd
   AltFireEnd:
    6H23 "#" 2 Offset(20, 88)
    6H23 "#" 2 Offset(15, 74)
    6H23 "#" 2 Offset(10, 60)
    6H23 "#" 2 Offset(5, 46)
    goto Ready1

   BLINDINGBLIND:
    6H23 A 0 A_GiveInventory("StealthSniper_W_BLINDINGBLIND_AmmoSpend_P")
    6H23 A 0 A_FireCustomMissile("ShortRangeBlindofDeath", 0, 0, 0, 0)
    6H23 A 0  // A_GiveInventory("PowerStealthSniperInvis",1)
    6H23 B 1 A_PlaySound("Pokemon/IceBeamEnd", 1)
    6H23 B 1 A_SetBlend(white, 0.85, 5)
    6H23 CBA 2
    6H23 A 0  // A_TakeInventory("PowerStealthSniperInvis",1)
    goto Ready1

   Reload:
    6H23 "#" 0 A_JumpIfInventory("SnipinFlag", 1, "ZoomOut")
    6H23 "#" 0 A_GiveInventory("SnipinFlag", 1)
    6H23 "#" 0 A_ZoomFactor(2.0, 0)
    goto ReReloadLoop
   ZoomOut:
    6H23 "#" 0 A_TakeInventory("SnipinFlag", 1)
    6H23 "#" 0 A_ZoomFactor(1.0, 0)
    6H23 "#" 1
    goto ReReloadLoop
   ReReloadLoop:
    6H23 "#" 1
    6H23 "#" 0 A_JumpIf(!(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_RELOAD), "Ready1")
    loop
  }
}

actor SnipinFlag : Once {}

actor StealthyAmmo : Ammo {
  Inventory.MaxAmount 112
  +INVENTORY.IGNORESKILL
}

actor Steal_thyFakeDashAmmo : Ammo {
  Inventory.MaxAmount 56
  +INVENTORY.IGNORESKILL
}

actor StealthCounter : Inventory {
  Inventory.MaxAmount 30
}

actor PowerStealthSniperInvis22222 : PowerInvisibility {
  +CANTSEEK
  Powerup.Strength 100
  Powerup.Duration 70
  Powerup.Mode "Translucent"
}

actor StealthSniper_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Steal_thyFakeDashAmmo", 0, 2)
    TNT1 A 0 A_WeaponReady(8 | WRF_ALLOWRELOAD)
    goto Ammo
    TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD)
    goto Ammo

   Ammo:
    // TNT1 A 0 A_GiveInventory("Steal_thyFakeDashAmmo",1)
    TNT1 A 0 A_GiveInventory("StealthyAmmo", 1)
    stop
  }
}

actor StealthSniper_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("StealthSniperBlindShot", cos(-pitch) * 4, 0, 24 + (sin(-pitch) * 4), cos(-pitch), 0, sin(-pitch), 0, 1 + 32 + SXF_MULTIPLYSPEED)  // 8192
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    goto Dash
    TNT1 A 0 A_SpawnItemEx("StealthSniperBlindShot", cos(-pitch) * 4, 0, 24 + (sin(-pitch) * 4), cos(-pitch), 0, sin(-pitch), 15, 1 + 32 + 8192)
    TNT1 A 0 A_SpawnItemEx("StealthSniperBlindShot", cos(-pitch) * 4, 0, 24 + (sin(-pitch) * 4), cos(-pitch), 0, sin(-pitch), -15, 1 + 32 + 8192)
    goto Dash

   Dash:
    TNT1 A 0 A_GiveInventory("VivifyDelay3")
    TNT1 A 0 A_TakeInventory("Steal_thyFakeDashAmmo", 28, 1)
    TNT1 A 0 A_TakeInventory("Steal_thyFakeDashAmmo", 28)
    TNT1 A 0 A_PlaySound("weapon/fakedash", 4)
    // TNT1 A 0 A_FireCustomMissile("StealthSniperDashFX",0,1,0,0)
    TNT1 A 0  // A_SpawnItemEx("DashFXGiver")
    TNT1 A 0  // A_JumpIfInventory("FlightDisableFlag",1,4)
    TNT1 A 0 A_JumpIf(velz < 0, 2)
    TNT1 A 0 A_ChangeVelocity(-30, 0, velz + 11, 3)
    goto Pickup2
    TNT1 A 0 A_ChangeVelocity(-30, 0, 12, 3)
    stop
    TNT1 A 0 A_ChangeVelocity(-30, 0, velz, 3)
    stop
  }
}


actor StealthS_RailTrailFX : BasicGraphicEffect {
  Translation "192:192=138:138", "198:198=105:105"
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Translucent"
  Alpha 1.0
  // Speed 60
  Scale 0.25  // 2.5
  States {
   SpawnFrame:
    6P23 R 0
    6P23 R 1
    6P23 RRRR 1 A_SetScale(scaleX + 0.1875)
    6P23 R 1
    // 6P23 RRR 1 A_SetScale(scaleX+0.25)
    // 6P23 RR 1
    6P23 RRRRRRRRRRRRRRR 1 A_SetScale(scaleX - 0.0625)
    stop

   SpawnBorrow:
    TMFX B 0
    TMFX B 1
    TMFX BBBB 1 A_SetScale(scaleX + 0.1875)
    TMFX B 1
    TMFX BBBBBBBBBBBBBBB 1 A_SetScale(scaleX - 0.0625)
    stop
  }
}


actor StealthS_RailPuffFX : BasicGraphicEffect {
  Translation "192:192=138:138", "198:198=105:105"
  DamageType "StealthRail"
  Obituary "$OB_23M"
  PainSound "weapon/Dark3Rail"
  // +DONTBLAST
  // +NOGRAVITY
  +THRUGHOST
  +NOINTERACTION
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Translucent"
  Alpha 0.99
  Scale 2.5
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0  // A_LOG("Rail Spawn")
    6P23 S 1 A_Pain
    6P23 TUVWXY 2
    stop
   Crash:
    TNT1 A 0
    TNT1 A 0  // A_LOG("Rail Crash")
    6P23 TUVWXY 2
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor StealthS_BulletPuffFX : StealthS_RailPuffFX {
  Scale 2.5  // 1.25
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 1  // A_LOG("Bullet Spawn")
    stop
   Crash:
    TNT1 A 0
    TNT1 A 0  // A_LOG("Bullet Crash")
    6P23 S 1 A_Pain
    6P23 TUVWXY 2
    stop
  }
}


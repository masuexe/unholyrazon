actor Wisp_W_ScriptBar : ScriptBar {}  // NormalBar {args 43, 47}

actor Wisp_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 3
  Inventory.Pickupmessage "$PU_55"
  Obituary "$OB_55W"
  Tag "$TAG_Wisp_W"
  Weapon.AmmoType "WispSpiritAmmo"
  Weapon.AmmoType2 "BewitchingHexAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H55 [ 6
    loop

   Deselect:
    6H55 A 0 A_TakeInventory("PowerWispPortal")
    goto DeselectSwap
   Select:
    6H55 A 0 A_TakeInventory("BewitchingHexAmmo")
    goto SelectSwap

   Ready:
    6H55 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", WISP_DYE)
    6H55 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2
   Ready2:
    6H55 ABCDEFGGFEDCBAABCDEFGGFEDCBAABCDEFGGFEDCBA 4 A_GiveInventory("Wisp_ReadyState_P")
    6H55 A 0 A_GiveInventory("WispSpiritAmmo", 1)
    loop

   Fire:
    6H55 H 0 A_GiveInventory("Wisp_Fire_P")
    6H55 HIJK 2
    goto Ready2

   Flash:
    TNT1 AAAA 1
    TNT1 A 1 A_GiveInventory("Wisp_FlashDrain_P")
    TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo", 1, "Flash")
    TNT1 A 0 A_TakeInventory("PowerWispPortal")
    stop

   Altfire:
    6H55 A 0 A_JumpIfInventory("PowerWispPortal", 1, "AltTele")
    6H55 J 1
   AltH1:
    6H55 L 0 A_JumpIfInventory("BewitchingHexAmmo", 56, "AltH5")
    6H55 L 1 A_GiveInventory("Wisp_AltHold_P")
    6H55 L 0 A_ReFire("AltH1")
    goto AltHex
   AltH5:
    6H55 L 1 A_GiveInventory("Wisp_AltHoldTrick_P")
    6H55 L 0 A_ReFire(1)
    goto Alt2
    6H55 Q 1  // A_GiveInventory("Wisp_AltHoldTrick_P")
    6H55 Q 0 A_ReFire(1)
    goto Alt2
    6H55 L 1 A_GiveInventory("Wisp_AltHoldTrick_P")
    6H55 L 0 A_ReFire(1)
    goto Alt2
    6H55 Q 1  // A_GiveInventory("Wisp_AltHoldTrick_P")
    6H55 Q 0 A_ReFire("AltH5")
    goto Alt2

   AltHex:
    6H55 M 2 A_GiveInventory("Wisp_AltShot_P")
    6H55 N 2
    6H55 O 2 A_TakeInventory("BewitchingHexAmmo")
    6H55 P 6
    6H55 ST 2
    goto Ready2
   Alt2:
    6H55 A 0 A_GiveInventory("Wisp_AltTeleStart_P")
    6H55 A 0 A_ReFire(1)
    6H55 MNO 2
    6H55 PRPRPR 2
    6H55 PPPS 2
    6H55 T 2 A_GunFlash("Flash", 1)
    goto Ready2
   AltTele:
    6H55 O 0 A_GiveInventory("Wisp_AltTele_P")
    6H55 OUPUPPPST 2
    goto Ready2


   BotReady:
    6H55 A 0 A_WeaponReady(12)
    6H55 AAA 2 A_ReFire("BotFire")
    6H55 A 0 A_GiveInventory("BewitchingHexAmmo", 1)
    loop

   BotFire:
    6H55 A 0 A_JumpIfInventory("PowerWispPortal", 1, "BotFireA2")
    6H55 A 0 A_JumpIfInventory("BewitchingHexAmmo", 56, "BotFireA")
    6H55 A 0 A_Jump(32, "BotAlt0")
    goto BotFire1
   BotFireA:
    6H55 A 0 A_Jump(96, "BotAlt1")
    goto BotFire+2
   BotFireA2:
    6H55 A 0 A_Jump(64, 1)
    goto BotFire+2
    6H55 A 0 A_Jump(24, 1)
    goto BotAlt2
    6H55 A 0 A_PlaySoundEx("classes/taunt/wisp", "Voice")
    6H55 A 0 A_GiveInventory("BewitchingHexAmmo", random(12, 44))
    goto BotAlt2

   BotFire1:
    6H55 H 0 A_Jump(4, "BotFireX1")  // 16
    6H55 H 0 A_Jump(236, 2)
    6H55 H 0 A_FaceTarget
    6H55 H 0 A_GiveInventory("Wisp_Fire_P")
    6H55 HIJ 2
    6H55 K 2 A_GiveInventory("BewitchingHexAmmo", random(1, 3))
   BotWait:
    6H55 A 1 A_JumpIfInventory("WispSpiritAmmo", 1, "BotReady")
    6H55 A 1 A_Jump(2, "BotAlt0")
    loop
   BotFireX1:
    6H55 A 0 A_Recoil(random(-10, -20))
    6H55 A 0 A_GiveInventory("WispSpiritAmmo", 1)
    6H55 A 0 A_GiveInventory("BewitchingHexAmmo", random(1, 3) * 14)
    6H55 A 0 A_PlaySoundEx("classes/taunt/wisp", "Voice")
    goto BotFire1+1

   BotAlt0:
    6H55 M 2 A_GiveInventory("Wisp_AltShot_P")
    6H55 N 2
    6H55 O 2 A_TakeInventory("BewitchingHexAmmo")
    6H55 P 6
    6H55 ST 2
    goto BotReady
   BotAlt1:
    6H55 A 0 A_ChangeVelocity(cos(pitch) * 60, 0, -sin(pitch) * 60, 3)
    6H55 A 0 A_SpawnItemEx("WispAltfireFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    6H55 A 0 A_GiveInventory("Wisp_AltTeleStart_P")
    6H55 J 2
    6H55 L 22
    6H55 J 2
    6H55 A 2 A_GunFlash("Flash", 1)
    goto BotReady
   BotAlt2:
    6H55 O 0 A_GiveInventory("Wisp_AltTeleBot_P")
    6H55 OUPUPPPST 2
    goto BotReady
  }
}

actor WispSpiritAmmo : Ammo {
  Inventory.MaxAmount 3
  +INVENTORY.IGNORESKILL
}

actor BewitchingHexAmmo : Ammo {
  Inventory.MaxAmount 56
  +INVENTORY.IGNORESKILL
}

actor WispPortalActive : BasicPowerupGiver {
  Powerup.Type "PowerWispPortal"
}
actor PowerWispPortal : PowerUp {
  Powerup.Duration -30
}

actor WispPortalEnd_F : Powerup {
  Powerup.Duration 3
}

actor Wisp_ReadyState_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("WispSpiritAmmo", 1, 2)
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ammo:
    TNT1 A 0  // A_GiveInventory("WispSpiritAmmo",4)
    stop
  }
}

actor Wisp_AltHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo", 0, 1)
    goto Ammo
    TNT1 A 0 A_GiveInventory("Wisp_AltHoldTrick_P")
    goto Ammo
   Ammo:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_GiveInventory("BewitchingHexAmmo", 4)
    stop
    TNT1 A 0 A_GiveInventory("BewitchingHexAmmo", 8)
    stop
  }
}
actor Wisp_AltHoldTrick_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("WispChargeFX", random(-32, 32), random(-32, 32), 8, velx, vely, 12, 0, 8)
    stop
  }
}


actor Wisp_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("WispSpiritAmmo", 1, 1)
    TNT1 A 0 A_PlaySound("wep/WispFire", 1)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_FireCustomMissile("WispCutter", 0, 0, 0, 0)
    stop
    TNT1 A 0 A_SpawnItemEx("WispCutter", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, 0, 32)
    TNT1 A 0 A_SpawnItemEx("WispCutter2", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, 15, 32)
    TNT1 A 0 A_SpawnItemEx("WispCutter2", cos(-pitch) * 60, 0, 32 + (sin(-pitch) * 60), cos(-pitch) * 60, 0, sin(-pitch) * 60, -15, 32)
    stop
  }
}

actor Wisp_AltShot_P : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_FireCustomMissile("WispHexShotStart",0,0,0,0)
    TNT1 A 0 A_SpawnItemEx("WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, 0, 32 + 512)  // SXF_TRANSFERPITCH

    TNT1 A 0 A_PlaySound("wep_L/mm1/firestormfire", 1)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_SpawnItemEx("WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, 15, 32 + 512)
    TNT1 A 0 A_SpawnItemEx("WispHexShotStart", 0, 0, 32, cos(-pitch) * 50, 0, sin(-pitch) * 50, -15, 32 + 512)
    stop
  }
}

actor Wisp_AltTeleStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 A_GiveInventory("WispPortalActive", 1)
    TNT1 A 0 A_GiveInventory("BewitchingHexAmmo", 56)
    TNT1 A 0 A_PlaySound("wep/WispAlt1", 1)
    TNT1 A 0 A_SpawnItemEx("WispPortChecker", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor Wisp_AltTele_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Wisp_AltShot_P")
    TNT1 A 0 A_TakeInventory("BewitchingHexAmmo", 56, 1)
    TNT1 A 0 A_TakeInventory("BewitchingHexAmmo", 2)
    TNT1 A 0 A_GiveInventory("WispPortalEnd_F")
    TNT1 A 0 A_PlaySound("wep/WispAlt2", 1, 0.5)  // classes/GalaxyTeleport
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    TNT1 A 0 A_GiveInventory("Nudge")
    TNT1 A 0 A_JumpIfInventory("BewitchingHexAmmo", 1, "Spawner")
    TNT1 A 0 A_TakeInventory("PowerWispPortal")
    goto End
   Spawner:
    TNT1 A 0 A_SpawnItemEx("WispPortChecker", 0, 0, 0, 0, 0, 0, 0, 1)
    goto End
   End:
    TNT1 A 0 Thing_Move(tid, tid + 4500, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth") / 10)
    stop
  }
}
actor Wisp_AltTeleBot_P : Wisp_AltTele_P {
  States {
   Pickup:
    goto Wisp_AltTele_P::Pickup+1
  }
}


actor WispChargeFX : BasicClientSide {
  Translation "192:192=70:70", "198:198=245:245", "202:202=43:43", "199:199=47:47"
  RenderStyle "Add"
  Scale 1.5
  Alpha 1.0
  States {
   Spawn:
    TMFX B 0
    TMFX B 0 A_Jump(96, "Spawn2")
    TMFX BBBCCD 2 A_FadeOut(0.04)
    stop
   Spawn2:
    UMFX BCBABCD 2 A_FadeOut(0.04)
    stop
  }
}


actor WispAltfireFX_H : BasicClientSide {
  ReactionTime 11
  States {
   Spawn:
    TNT1 A 0 A_CountDown
    TNT1 A 2 A_SpawnItemEx("WispAltfireFX", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    loop
  }
}
actor WispAltfireFX : BasicClientSide {
  +NOBLOCKMAP
  RenderStyle "Add"
  Alpha 0.6
  States {
   Spawn:
    TNT1 A 0
    1H55 F 3
    1H55 F 1 A_FadeOut(0.075)
    wait
  }
}



actor WispKindleDelay : BasicPowerupGiver {
  Powerup.Type "PowerWispKindleDelay"
}
actor PowerWispKindleDelay : PowerUp {
  Powerup.Duration -10
}

actor WispKindle_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PowerWispKindleDelay", 1, 2)
    TNT1 A 0 A_SpawnItemEx("WispKindle_H", 0, 0, 0, 0, 0, 0, tid - 999.9, SXF_ABSOLUTEANGLE)  // 4
    TNT1 A 0 A_GiveInventory("WispKindleDelay", 1)
    stop
  }
}
actor WispKindleEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uc_WispHex", -1)
    stop
  }
}
actor WispKindle_H : BasicWatcher {
  Translation "192:192=70:70", "198:198=245:245"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4 A_SpawnItemEx("WispKindleFX", 0, 0, 0, 0, 0, 0, angle, 1 + 4)
    TNT1 A 0 A_JumpIfInTargetInventory("PowerWispKindleDelay", 1, "Spawn")
    TNT1 A 0 A_Jump(256, 1)
    loop  // Sync clientside
    TNT1 A 0 A_GiveToTarget("WispKindleEnd_P")
    stop
  }
}
actor WispKindleFX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Thing_Move(0, angle + 1000, 1)
    TNT1 AA 0 A_SpawnItemEx("Wisp_EmberFX", random(18, 56), 0, Random(18, 56), 0, 0, 0, random(0, 71) * 5, 1)
    stop
  }
}


actor WispCutter : BasicProjectile {
  Translation "192:192=70:70", "198:198=245:245"
  DamageType "WispKindle"
  Obituary "$OB_55M"
  +THRUACTORS
  +NOTARGETSWITCH
  +NOCLIP
  +SKYEXPLODE
  +SEEKERMISSILE
  +NOINTERACTION
  +FORCEXYBILLBOARD
  ReactionTime 1
  Damage (0)
  Radius 12
  Height 12
  Speed 60
  Scale 2.5
  Args 20, 56, 56, 15
  States {
   Spawn:
    6P55 A 0
    6P55 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_TARGET)
    goto SpawnL+1
   SpawnL:
    6P55 AA 0 A_SpawnItemEx("Wisp_EmberFX", random(-24, 24), random(-24, 24), random(-24, 24), 0, 0, frandom(0, 3), 0, 1, 32)
    6P55 AA 1 A_GiveInventory("WispCutterChecker_P")
    6P55 BB 0 A_SpawnItemEx("Wisp_EmberFX", random(-24, 24), random(-24, 24), random(-24, 24), 0, 0, frandom(0, 3), 0, 1, 32)
    6P55 BB 1 A_GiveInventory("WispCutterChecker_P")
    6P55 CC 0 A_SpawnItemEx("Wisp_EmberFX", random(-24, 24), random(-24, 24), random(-24, 24), 0, 0, frandom(0, 3), 0, 1, 32)
    6P55 CC 1 A_GiveInventory("WispCutterChecker_P")
    6P55 A 0 A_GiveInventory("WispCutterVelocity_P")
    loop

   Death:
    TNT1 A 0 A_GiveToTarget("WispSpiritAmmo", 1)
    TNT1 A 1 A_PlaySound("weapon/CutterCatch", 1)
    // 6P55 DE 3
    stop
  }
}
actor WispCutter2 : WispCutter {
  RenderStyle "Translucent"
  Alpha 0.75
  States {
   Death:
    TNT1 A 1
    stop
  }
}

actor WispCutterChecker_P : CustomInventory {
  States {
   Pickup:
    // Doesn't spawn online sadly. Has to be on actor
    // TNT1 A 0 A_SpawnItemEx("Wisp_EmberFX",random(-24,24),random(-24,24),random(-24,24),frandom(-3,3),frandom(-3,3),frandom(-1,3),0,1,32)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "SuperDead")
    TNT1 A 0 A_JumpIf(args[4] > 4, "Return")
    goto Boom
   Return:
    TNT1 A 0 A_JumpIfCloser(42, "SuperDead")
    TNT1 A 0 A_SeekerMissile(1, 90, SMF_PRECISE | SMF_CURSPEED, 0, 0)
    goto Boom
   Boom:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    stop
   SuperDead:
    TNT1 A 0 A_CountDown
    stop
  }
}


actor WispCutterVelocity_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(args[4] > 7, "Skip")
    TNT1 A 0 A_JumpIf(args[4] > 6, 12)
    TNT1 A 0 A_JumpIf(args[4] > 5, 10)
    TNT1 A 0 A_JumpIf(args[4] > 4, 8)
    TNT1 A 0 A_JumpIf(args[4] > 3, 6)
    TNT1 A 0 A_JumpIf(args[4] > 2, 4)
    TNT1 A 0 A_JumpIf(args[4] > 1, 2)
    TNT1 A 0 A_ChangeVelocity(velx * 0.75, vely * 0.75, velz * 0.75, 2)  // A_ScaleVelocity(0.75)
    goto Vel
    TNT1 A 0 A_ChangeVelocity(velx * 2.00 / 3.00, vely * 2.00 / 3.00, velz * 2.00 / 3.00, 2)  // 2.00/3.00
    goto Vel
    TNT1 A 0 A_ChangeVelocity(velx * 0.5, vely * 0.5, velz * 0.5, 2)  // 0.5
    goto Vel
    TNT1 A 0 A_FaceTarget(180, 90)
    goto Vel
    TNT1 A 0 A_ChangeVelocity(velx * 2, vely * 2, velz * 2, 2)  // A_ScaleVelocity(2.0)
    goto Vel
    TNT1 A 0 A_ChangeVelocity(velx * 1.5, vely * 1.5, velz * 1.5, 2)  // 1.5
    goto Vel
    TNT1 A 0 A_ChangeVelocity(velx * 4.00 / 3.00, vely * 4.00 / 3.00, velz * 4.00 / 3.00, 2)  // 4.00/3.00
    goto Vel
   Vel:
    TNT1 A 0 A_SetArg(4, args[4] + 1)
    TNT1 A 0 A_GiveInventory("ReSyncPickup")
    stop
   Skip:
    TNT1 A 0 A_CountDownArg(3)
    stop
  }
}


actor WispHexProtect : PowerProtection {
  Powerup.Duration 2
  DamageFactor "WispHex", 0.0
}

actor WispHexShotStart : BasicProjectile {
  Translation "192:192=70:70", "198:198=245:245"
  DamageType "WispHex"
  Obituary "$OB_55A1"
  +DONTBLAST
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  RenderStyle "None"
  Damage (0)
  Radius 10
  Height 10
  Mass 50  // Speed
  Speed 50
  Scale 2.5
  Args 150, 56, 56, 10
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("UH_SyncPitchFix")
    // TNT1 A 0 A_SetArg(4,Pitch)

    TNT1 A 0 A_SpawnItemEx("WispHexShot", 0, 0, 0, velx, vely, velz, 0, SXF_TRANSFERTRANSLATION | SXF_ABSOLUTEMOMENTUM | SXF_NOCHECKPOSITION | SXF_TRANSFERSPECIAL)  // 1+8+32+32768

    TNT1 A 0 A_SetArg(3, args[3] / 2)
    // TNT1 A 0 A_SpawnItemEx("WispHexShotFX5",sin(-pitch)*-args[1],0,cos(-pitch)*args[1],velx*2,vely*2,velz*2,0,1+8+32768)
    // TNT1 A 0 A_SpawnItemEx("WispHexShotFX5",sin(-pitch)*args[1],0,cos(-pitch)*-args[1],velx*2,vely*2,velz*2,0,1+8+32768)
    // TNT1 A 0 A_SpawnItemEx("WispHexShotFX5",0,args[1],0,velx*2,vely*2,velz*2,0,1+8+32768)
    // TNT1 A 0 A_SpawnItemEx("WispHexShotFX5",0,-args[1],0,velx*2,vely*2,velz*2,0,1+8+32768)

    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", cos(-pitch) * -mass + sin(-pitch) * -args[1], 0, sin(-pitch) * -mass + cos(-pitch) * args[1], velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", cos(-pitch) * -mass + sin(-pitch) * args[1], 0, sin(-pitch) * -mass + cos(-pitch) * -args[1], velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", cos(-pitch) * -mass, args[1], sin(-pitch) * -mass, velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", cos(-pitch) * -mass, -args[1], sin(-pitch) * -mass, velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)

    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", sin(-pitch) * -args[1] * sin(45), args[1] * sin(45), cos(-pitch) * args[1] * sin(45), velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", sin(-pitch) * -args[1] * sin(45), -args[1] * sin(45), cos(-pitch) * args[1] * sin(45), velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", sin(-pitch) * args[1] * sin(45), args[1] * sin(45), cos(-pitch) * -args[1] * sin(45), velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX5", sin(-pitch) * args[1] * sin(45), -args[1] * sin(45), cos(-pitch) * -args[1] * sin(45), velx * 2, vely * 2, velz * 2, 0, 1 + 8 + 32768)


    TNT1 A 0  // 1
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 1 A_SpawnItemEx("WispHexShotEndFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}


actor WispHexShot : WispHexShotStart {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_CountDownArg(3)
    TNT1 A 0 A_SpawnItemEx("WispHexShot", 0, 0, 0, velx, vely, velz, 0, 1 + 8 + 32 + 32768)

    TNT1 A 0 A_SpawnItemEx("WispHexShotFX0", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("WispHexShotFX0", sqrt(velx * velx + vely * vely) * 0.5, 0, velz * 0.5, 0, 0, 0, 0, 1)
    TNT1 A 0  // 1
    stop
  }
}

actor WispHexShotFX0 : BasicClientSide {
  +MISSILE
  +FORCEXYBILLBOARD
  RenderStyle "Translucent"
  Alpha 0.5
  ReactionTime 9
  Speed 60
  States {
   Spawn:
    6P55 L 0
    6P55 L 0 A_SpawnItemEx("WispHexShotFX1", frandom(8, 12) * (random(0, 1) * 2 - 1), frandom(8, 12) * (random(0, 1) * 2 - 1), frandom(8, 12) * (random(0, 1) * 2 - 1), 0, 0, 1, 0, 1)
    6P55 L 0 A_SetScale(2.5 * (random(0, 1) * 2 - 1), scaleY)
    6P55 L 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   SpawnL1:
    6P55 LMNM 1 A_CountDown
    loop
   SpawnL2:
    6P55 NMLM 1 A_CountDown
    loop
  }
}


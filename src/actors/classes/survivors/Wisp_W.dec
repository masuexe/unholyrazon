actor WispHexBurn : BasicExplosion {
  Translation "4:4=200:200", "192:192=70:70", "198:198=245:245"  // 78
  DamageType "Wisp"
  Obituary "$OB_55A2"
  Accuracy 10
  Meleerange 125  // 180
  Args 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pokemon/FireSpin", 2, 0.75)
    TNT1 A 0 A_Explode((meleerange + args[0] * accuracy) * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), 15, 0, 0, 15)
    TNT1 A 1 A_SpawnItemEx("WispHexBurnFX", 0, 0, -8, 0, 0, 0, 0, 1)
    stop
  }
}
actor WispHexBurnFX : BasicClientSide {
  Alpha 0.9
  Scale 4.0
  States {
   Spawn:
    6P55 R 0
    6P55 RRRRRR 0 A_SpawnItemEx("Wisp_EmberFX", random(12, 24), random(-24, 24), random(-16, 16) * (random(0, 1) * 2 - 1), frandom(15, 20), 0, frandom(-2, 4), random(6, 36) * 5, 1)
    6P55 RRRRRR 0 A_SpawnItemEx("Wisp_EmberFX", random(12, 24), random(-24, 24), random(-16, 16) * (random(0, 1) * 2 - 1), frandom(15, 20), 0, frandom(-2, 4), random(36, 66) * 5, 1)
    6P55 RSTU 3
    stop
  }
}


actor WispPortChecker : BasicExplosion {
  DamageType "WispStun"
  Obituary "$OB_55A3"
  +NOTIMEFREEZE
  RenderStyle "Translucent"  // Add
  Alpha 0.75  // 99
  ReactionTime 1
  Scale 2.5
  Args 100, 128, 64
  States {
   Spawn:
    6P55 F 0
    6P55 F 0 A_SpawnItemEx("WispPortCheckerFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    6P55 F 0
    6P55 F 1 Thing_ChangeTID(0, 4500 + CallACS("core_getptrtid", AAPTR_TARGET))
    6P55 F 2
    goto Spawn2

   Spawn2:
    6P55 G 1
    6P55 G 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 G 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 G 1
    6P55 G 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 G 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 G 1
    6P55 G 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 G 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 H 1
    6P55 H 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 H 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 H 1
    6P55 H 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 H 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 H 1
    6P55 H 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 H 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 I 1
    6P55 I 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 I 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 I 1
    6P55 I 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 I 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, 1)
    goto Die
    6P55 I 1
    6P55 I 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Die")
    6P55 I 0 A_JumpIfInTargetInventory("WispPortalEnd_F", 1, "DieX")
    6P55 I 1 A_JumpIfInTargetInventory("PowerWispPortal", 1, "Spawn2")
    goto Die
   Die:
    6P55 "#" 1 A_Countdown
    wait
   DieX:
    TNT1 A 0 A_SpawnItemEx("WispPortCheckerFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(args[0] * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), args[1], 0, 0, args[2])
    stop



   Death:
    6P55 J 0 A_PlaySound("misc/astroplatformappear", 4)
    6P55 J 0 A_SpawnItemEx("WispPortCheckerFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    6P55 J 0 A_Explode(args[0] * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), args[1], 0, 0, args[2])
    6P55 JK 3
    stop
  }
}

actor WispPortCheckerFX_H : BasicWatcher {
  Translation "192:192=70:70", "198:198=245:245"  // ,"199:199=78:78","202:202=200:200","4:4=200:200"
  +NOTIMEFREEZE
  States {

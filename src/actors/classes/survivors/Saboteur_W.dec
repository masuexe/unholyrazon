actor Saboteur_W_NormalBar : NormalBar {args 39, 104}

actor Saboteur_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 100
Inventory.Pickupmessage "$PU_22"
Obituary "$OB_22W"
Tag "$TAG_Saboteur_W"
weapon.ammotype "SaboteurEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H22 [ 6
loop

Deselect:
6H22 A 0
goto DeselectSwap
Select:
6H22 A 0
goto SelectSwap

Ready:
6H22 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SABOTEUR_DYE)
6H22 A 0
goto Ready2
Ready2:
6H22 A 2 A_WeaponReady
6H22 A 0 A_GiveInventory("SaboteurEnergyAmmo",2)
loop

Fire:
6H22 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
FireL:
6H22 C 2 A_GiveInventory("Saboteur_Fire_P")
6H22 B 2
6H22 A 0 A_Refire("FireL")
Goto Ready2

BotFire:
6H22 C 2 A_GiveInventory("Saboteur_BotFire_P")
6H22 B 2
6H22 A 0 A_Refire("BotFire")
Goto Ready2

AltFire:
6H22 C 2 A_GiveInventory("Saboteur_Alt_P")
6H22 B 2
6H22 A 0 A_Refire("Altfire")
Goto Ready2
}
}

actor SaboteurEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 100
+INVENTORY.IGNORESKILL
}

actor Saboteur_Fire_P : CustomInventory
{
States
{
Pickup:
Fire0:
TNT1 A 0 A_JumpIfInventory("SaboteurEnergyAmmo",100,"Fire2")
goto Fire1
Fire1:
TNT1 A 0 A_FireCustomMissile("SaboteurShot",random(-2,2),0,8,0)
TNT1 A 0 A_PlaySound("wep_L/SaboteurPew",1,0.9)//weapon/mbuster
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",2)
stop
Fire2:
TNT1 A 0 A_FireCustomMissile("SaboteurPrettyShot",0,1,0,0)
TNT1 A 0 A_PlaySound("wep_L/SaboteurPew2",4)//S3_K/SpikeMine
TNT1 A 0 A_TakeInventory("SaboteurEnergyAmmo",50,1)
TNT1 A 0 A_TakeInventory("SaboteurEnergyAmmo",50)
stop
}
}
actor Saboteur_Alt_P : Saboteur_Fire_P
{
States
{
Pickup:
AFire0:
TNT1 A 0 A_JumpIfInventory("SaboteurEnergyAmmo",100,"AFire2")
goto AFire1
AFire1:
TNT1 A 0 A_FireCustomMissile("SaboteurShotAlt",random(-2,2),0,8,0)
goto Fire1+1
AFire2:
TNT1 A 0 A_FireCustomMissile("SaboteurPrettyShotAlt",0,1,0,0)
goto Fire2+1
}
}
actor Saboteur_BotFire_P : Saboteur_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_Jump(3,2)
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",1)
goto Bot0
TNT1 A 0 A_PlaySoundEx("classes/taunt/saboteur","Voice")
TNT1 A 0 A_GiveInventory("SaboteurEnergyAmmo",random(28,42))
goto Bot0
Bot0:
TNT1 A 0 A_Jump(128,"AFire0")
goto Fire0
}
}

actor SaboteurShot : BasicProjectile
{
Translation "192:192=39:39","198:198=104:104"
Obituary "$OB_22M"
DamageType "SaboteurSlow"
+FORCEXYBILLBOARD
+BRIGHT
Damage (44)
radius 8
height 8
Speed 45
scale 2.5
States
{
Spawn:
X_BB DE 2
loop
Death:
TNT1 A 1 
stop
}
}

actor SaboteurShotAlt : SaboteurShot
{
//Obituary "$OB_22M"
+DONTBLAST
+DONTREFLECT
Damage (55)
radius 9
height 9
Speed 1
scale 2.0
States
{
Spawn:
X_BB DEDEDEDEDEDEDEDEDEDEDEDEDEDEDE 2
X_BB D 0 A_SpawnItemEx("SaboteurShotAlt2",0,0,0,momx*45,momy*45,momz*45,0,1+8)
stop
}
}

actor SaboteurShotAlt2 : SaboteurShotAlt
{
-DONTBLAST
-DONTREFLECT
Speed 45
scale 2.5
States
{
Spawn:
X_BB DE 2
loop
}
}


actor SaboteurPrettyShot : BasicProjectile
{
Translation "0:255=104:104","192:192=39:39","198:198=104:104"
DamageType "SaboteurStop"
Obituary "$OB_22A"
+SEEKERMISSILE
+SCREENSEEKER
+BRIGHT
RenderStyle "Translucent"
Alpha 0.80
reactiontime 16
Damage (100)
Radius 16
height 16
Speed 34
Args 16
States
{
Spawn:
FLSM BBBBCCCC 1 A_SeekerMissile(0,Args[0],SMF_LOOK,55,6)
FLSM C 0 A_CountDownArg(0)
loop
Death:
FLSM F 3 A_Recoil(5)
FLSM GGG 1 A_Fadeout(0.125)
stop
}
}

actor SaboteurPrettyShotAlt : SaboteurPrettyShot
{
+DONTBLAST
States
{
Spawn:
FLSM A 0
FLSM A 0 A_ScaleVelocity(0.03)
FLSM A 60
FLSM A 0 A_ScaleVelocity(34.0)
FLSM A 0 A_ChangeFlag("DONTBLAST",0)
goto SaboteurPrettyShot::Spawn
}
}

// TODO: Rameses_W is good for camping, rework this if necessary

actor Rameses_W_ScriptBar : ScriptBar {}

actor Rameses_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 0
Inventory.Pickupmessage "$PU_32"
Obituary "$OB_32W"
Tag "$TAG_Rameses_W"
weapon.ammotype "DarknessEnergyAmmo"
States
{
Spawn:
6H32 [ 6
loop

Deselect:
6H32 A 0
goto DeselectSwap
Select:
6H32 A 0
goto SelectSwap

Ready:
6H32 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAMESES_DYE)
6H32 A 1 A_GiveInventory("RamesesFire_P0")
6H32 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready2:
6H32 A 1 A_WeaponReady
wait

Fire:
6H32 B 0 A_GiveInventory("WeaponCharge",1)
6H32 B 1 A_JumpIfInventory("PlayerPropertyRage",1,2)
6H32 B 0 A_Refire(1)
Goto Throw1
6H32 B 1
6H32 B 0 A_Refire(1)
Goto Throw1
6H32 C 1 A_JumpIfInventory("PlayerPropertyRage",1,2)
6H32 C 0 A_Refire(1)
Goto Throw1
6H32 C 1 A_GunFlash("Flash",1)
6H32 C 0 A_Refire(1)
Goto Throw1
6H32 D 1 A_JumpIfInventory("PlayerPropertyRage",1,2)
6H32 D 0 A_Refire(1)
Goto Throw1
6H32 D 1
6H32 D 0 A_Refire(1)
Goto Throw1
6H32 E 1 A_JumpIfInventory("PlayerPropertyRage",1,2)
6H32 E 0 A_Refire(1)
Goto Throw1
6H32 E 1// A_GunFlash("Flash",1)
6H32 E 0 A_Refire("Hold1")
Goto Throw1

Hold1:
6H32 E 1 A_JumpIfInventory("WeaponCharge",16,"Hold2")
6H32 E 0 A_Refire("Hold1")
Goto Throw1
Hold2:
6H32 E 1 A_JumpIfInventory("WeaponCharge",80,"Hold3")
6H32 E 0 A_Refire("Hold2")
Goto Throw2
Hold3:
6H32 E 1 A_RailWait
6H32 E 0 A_Refire("Hold3")
Goto Throw3

Throw1:
6H32 F 0 A_GiveInventory("RamesesFire_P1")
6H32 F 1
6H32 G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 H 1
6H32 I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 J 1
6H32 K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 L 2 A_ClearRefire
Goto Ready2
Throw2:
6H32 F 0 A_GiveInventory("RamesesFire_P2")
6H32 F 1
6H32 G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 H 1
6H32 I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 J 1
6H32 K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 L 2 A_ClearRefire
6H32 M 2
//6H32 A 2
Goto Ready2
Throw3:
6H32 F 0 A_GiveInventory("RamesesFire_P3")
6H32 FGHIJK 2
6H32 T 2 A_GiveInventory("RamesesCurseF_Take_P")
6H32 L 2 A_ClearRefire
6H32 M 2
//6H32 A 2
Goto Ready2

Flash:
TNT1 A 0 A_JumpIfInventory("WeaponCharge",1,1)
stop
TNT1 A 0 A_JumpIfInventory("WeaponCharge",80,4)
TNT1 A 0 A_SpawnItemEx("RamesesShotChargeFX",frandom(16,48),0,frandom(8,32),0,0,6,random(0,359),1,192)
TNT1 A 0 A_GiveInventory("DarknessEnergyAmmo",1)
TNT1 A 2 A_GiveInventory("WeaponCharge",2)
loop
TNT1 AA 0 A_SpawnItemEx("RamesesShotChargeFX",frandom(16,48),0,frandom(8,32),0,0,6,random(0,359),1)
TNT1 A 0 A_JumpIfInventory("RamesesChargeFlag",14,2)
TNT1 A 2 A_GiveInventory("RamesesChargeFlag",1)
loop
TNT1 A 0 A_PlaySound("Rameses/Charge1",4)
TNT1 A 0 A_SpawnItemEx("RamesesShotChargeBurstFX",0,0,96,0,0,-1,0,1)
TNT1 A 0 A_TakeInventory("RamesesChargeFlag")
TNT1 A 2 A_GiveInventory("RamesesCurseFlag",1)
loop

Altfire:
6H32 G 0 A_PlaySound("Rameses/Main2",1)
6H32 J 0 A_FireCustomMissile("RamesesWave",0,0,8,0)
6H32 FGHIJKTLM 2
Goto Ready2


BotReady:
6H32 A 0 A_WeaponReady(12)
6H32 A 1 A_Refire("BotHold")
loop

BotHold:
6H32 A 0 A_Jump(64,"BotAlt")
6H32 B 0 A_Jump(128,"BotFire1","BotFire1","BotFire1","BotAlt")
6H32 B 2 A_GiveInventory("WeaponCharge",1)
6H32 B 0 A_Refire(1)
Goto BotFire1
6H32 C 2 A_Jump(24,"BotFire1")
6H32 C 0 A_Refire(1)
Goto BotFire1
6H32 D 2 A_Jump(16,"BotFire1")
6H32 D 0 A_Refire(1)
Goto BotFire1
6H32 E 1 A_Jump(16,"BotFire2")
6H32 E 0 A_Refire(1)
Goto BotFire1
6H32 E 0 A_Jump(8,"BotFire2")
6H32 E 1 A_GunFlash("Flash",1)
6H32 E 0 A_Refire("BotHold3")
Goto BotFire1

BotHold3:
6H32 E 1 A_GiveInventory("Rameses_BotTrick3_P")
6H32 E 0 A_Jump(2,3)
6H32 E 0 A_JumpIfCloser(128,2)
6H32 E 0 A_Refire("BotHold3")
6H32 E 0 A_JumpIfInventory("WeaponCharge",80,"BotFire3")
6H32 E 0 A_JumpIfInventory("WeaponCharge",16,"BotFire2")
Goto BotFire1

BotFire1:
6H32 F 0 A_GiveInventory("RamesesFire_P1")
6H32 F 1
6H32 G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 H 1
6H32 I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 J 1
6H32 K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 L 2 A_ClearRefire
Goto BotReady
BotFire2:
6H32 F 0 A_GiveInventory("RamesesFire_P2")
6H32 F 1
6H32 G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 H 1
6H32 I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 J 1
6H32 K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
6H32 L 2 A_ClearRefire
6H32 M 2
Goto BotReady
BotFire3:
6H32 F 0 A_GiveInventory("RamesesFire_P3")
6H32 FGHIJK 2
6H32 T 2 A_GiveInventory("RamesesCurseF_Take_P")
6H32 L 2 A_ClearRefire
6H32 M 2
Goto BotReady

BotAlt:
6H32 G 0 A_PlaySound("Rameses/Main2",1)
6H32 J 0 A_FireCustomMissile("RamesesWave",0,0,8,0)
6H32 FGHIJKTLM 2
Goto BotReady

}
}

actor DarknessEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 40
+INVENTORY.IGNORESKILL
}

actor RamesesChargeFlag : Inventory
{
inventory.amount 1
inventory.maxamount 14
}

actor RamesesCurseFlag : Inventory//Ammo
{
inventory.amount 1
inventory.maxamount 9999
+IGNORESKILL
}

actor RamesesCurseF_Take_P : CustomInventory
{
States//Would be easier if it was ammo, but then Give All/Ammo...
{
Pickup:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyEndlessAmmo",1,2)
TNT1 A 0 A_TakeInventory("RamesesCurseFlag",50,1)
TNT1 A 0
stop
}
}

actor Rameses_BotTrick3_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("RamesesChargeFlag",random(1,3))
TNT1 A 0 A_Jump(4,1)
stop
TNT1 A 0 A_PlaySoundEx("classes/taunt/rameses","Voice")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",80,3)
TNT1 A 0 A_GiveInventory("WeaponCharge",80)
TNT1 A 0 A_GiveInventory("DarknessEnergyAmmo",80)
stop
TNT1 A 0 A_GiveInventory("RamesesCurseFlag",random(5,20))
stop
}
}

actor RamesesFire_P0 : CustomInventory
{
States
{
Pickup:
Take:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_TakeInventory("RamesesChargeFlag")
TNT1 A 0 A_TakeInventory("DarknessEnergyAmmo")
stop
}
}
actor RamesesFire_P1 : RamesesFire_P0
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("RamesesShot1",0,0,8,0)
TNT1 A 0 A_PlaySound("Rameses/Main1",1)
goto Take
}
}
actor RamesesFire_P2 : RamesesFire_P0
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("RamesesShot2",0,0,8,0)
TNT1 A 0 A_PlaySound("Rameses/Main1",1)
goto Take
}
}
actor RamesesFire_P3 : RamesesFire_P0
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("RamesesShot3",0,0,8,0)
TNT1 A 0 A_PlaySound("Rameses/Charge2",4)
TNT1 A 0 A_PlaySound("Rameses/Main2",1)
goto Take
}
}

actor RamesesShotChargeFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,2,3,4)
S_1:
6P34 C 5
goto End
S_2:
6P34 D 5
goto End
S_3:
6P34 E 5
goto End
S_4:
6P34 F 5
goto End
End:
6P34 "#" 1 A_FadeOut(0.2)
wait
}
}

actor RamesesShotChargeBurstFX : RamesesShotChargeFX
{
States
{
Spawn:
X_4D H 0
X_4D HGFEDCB 1 A_FadeOut(0.04)
stop
}
}

actor RamesesWave : BasicProjectile
{
Translation "192:192=214:214","198:198=248:248"
Damagetype "Rameses"
Obituary "$OB_32A"
+FORCEXYBILLBOARD
+BRIGHT
+NOCLIP
+NOINTERACTION
+THRUGHOST
//+PAINLESS
RenderStyle Translucent
Alpha 0.5
damage (0)
Radius 5
Height 5
speed 40
scale 1.5
Args 75,18
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[1])
TNT1 A 1 A_FadeIn(0.1)
6P32 A 0 A_Explode(Args[0],Args[1],0,0,Args[1])
6P32 A 1 A_FadeIn(0.1)
6P32 A 0 A_Explode(Args[0],Args[1],0,0,Args[1])
6P32 A 1 A_FadeIn(0.1)
6P32 A 0 A_Explode(Args[0],Args[1],0,0,Args[1])
6P32 A 1 A_FadeIn(0.1)
6P32 A 0 A_Explode(Args[0],Args[1],0,0,Args[1])
6P32 A 1 A_FadeIn(0.1)
Spawn2:
6P32 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Explode(Args[0],Args[1],0,0,Args[1])
6P32 A 0 A_SpawnItemEx("RamesesWaveEndFX",0,0,0,momx,momy,momz,0,9)
stop
}
}

actor RamesesWaveEndFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
scale 1.5
States
{
Spawn:
6P32 A 0
6P32 A 0 A_ScaleVelocity(0.85)
6P32 A 1 A_FadeOut(0.1)
loop
}
}

actor RamesesShot1 : BasicProjectile
{
Translation "192:192=214:214","198:198=248:248"
damagetype "RamesesFire"
Obituary "$OB_32M"
+FORCEXYBILLBOARD
+BRIGHT
damage (85)
Radius 10
Height 10
speed 45
scale 2.5
States
{
Spawn:
X_4D A 1
loop
Death:
X_4D A 0
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,4)
stop
}
}

actor RamesesShot1X : RamesesShot1
{
+RIPPER
+FLOORHUGGER
ReactionTime 1
Damage (25)
Radius 6
Height 7
Speed 30
States
{
Spawn:
X_4D A 0
X_4D A 150
stop
}
}

actor RamesesShot2 : RamesesShot1
{
damage (75)
Radius 15
Height 15
States
{
Spawn:
X_4D H 4
loop
Death:
X_4D H 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,60,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,-60,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,120,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,-120,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,180,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot1X",0,0,0,28,0,0,0,1)
TNT1 A 0 A_Explode(50,80,0)
DeathEnd:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,4)
X_4D PQRSTUVWXY 1
stop
}
}

actor RamesesShot2X : RamesesShot2
{
+RIPPER
-NOGRAVITY
Damage (35)
}

actor RamesesShot3 : RamesesShot1
{
var int user_P;
+SKYEXPLODE
+EXPLODEONWATER
damage (140+user_P*10)
Radius 20
Height 20
speed 50
Args 1
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetUserVar("user_P",CallACS("rz_CountInv_RamesesCurseFlag",2)+1)
TNT1 A 0 A_SetScale(2.5+user_P/1000.00)
goto SpawnL

SpawnL:
X_4D JK 4
loop
DeathFix2://If actor hit double bonus damage
TNT1 A 0 A_SetArg(0,2)
DeathFix://Fixes damage not being set if Projectile dies Tic 0
TNT1 A 0 A_SetUserVar("user_P",CallACS("rz_CountInv_RamesesCurseFlag",2)*Args[0]+1)
TNT1 A 0 A_SetScale(2.5+user_P/(1000.00*Args[0]))
goto Death+1
Crash:
XDeath:
TNT1 A 0 A_JumpIf(user_P==0,"DeathFix2")
Death:
TNT1 A 0 A_JumpIf(user_P==0,"DeathFix")
TNT1 A 0 A_SetArg(4,1-(z-ceilingz==-height))
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],60,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],-60,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],120,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],-120,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],180,1)
TNT1 A 0 A_SpawnItemEx("RamesesShot2X",0,0,20*Args[4],28,0,Args[4],0,1)
TNT1 A 0 A_Explode(140+(user_P*10),196,0,0,32)

DeathEnd:
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,4)
TNT1 A 0 //A_LOGINT(user_P)
X_4D KLMNO 2
stop
}
}

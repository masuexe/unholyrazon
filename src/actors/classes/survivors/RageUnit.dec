actor RageUnit : CustWepClassBase {
  Player.ScoreIcon "UMUG_15"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "RageUnit"
  Player.SoundClass "RageUnit"
  // Player.DamageScreenColor "red"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "RageUnit_W"
  Player.StartItem "RageEnergyAmmo", 50
  Player.StartItem "CustomHealthFlag", 1
  States {
   Spawn:
    1H15 A 0
    1H15 B 1
    1H15 A 1
    goto Spawn+2
   See:
    1H15 BCDE 5
    goto Spawn
   Missile:
    1H15 FFFFF 1
    1H15 GGGG 1
    goto Spawn+2
   ClassPain:
    1H15 H 0
    goto MegamanPain

   ClassDeath:
    1H15 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H15 H 15 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H15 H 0 A_PlaySound("weapon/magdrillshoot", 1)
    1H15 H 0 Radius_Quake(5, 20, 0, 10, 0)
    1H15 FFFFFFFFFF 1 A_SpawnItemEx("RageUnitBurstDeath", 0, 0, 28, 0, 0, 0, 0, 1)
    1H15 H 0
    goto MegamanErase
   MegamanDisintegrate:
    1H15 Z 0 A_SpawnItemEx("Corpse_15", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor RageUnitShiny : RageUnit {
  Player.ScoreIcon "UMUG_S15"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 11
  Player.MorphWeapon "RageUnitShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H15 H 15 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H15 H 0 A_PlaySound("weapon/magdrillshoot", 1)
    1H15 H 0 Radius_Quake(5, 20, 0, 10, 0)
    1H15 FFFFFFFFFF 1 A_SpawnItemEx("S_RageUnitBurstDeath", 0, 0, 28, 0, 0, 0, 0, 1)
    1H15 H 0
    goto MegamanErase
  }
}

actor Corpse_15 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_15_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_15_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_15_0 : BaseCorpseFX {States {Spawn: 1H15 O 350
    goto Spawn2}}
actor Corpse_15_1 : BaseCorpseFX {States {Spawn: 1H15 P 350
    goto Spawn2}}
actor Corpse_15_2 : BaseCorpseFX {States {Spawn: 1H15 Q 350
    goto Spawn2}}
actor Corpse_15_3 : BaseCorpseFX {States {Spawn: 1H15 R 350
    goto Spawn2}}
actor Corpse_15_4 : BaseCorpseFX {States {Spawn: 1H15 S 350
    goto Spawn2}}
actor Corpse_15_5 : BaseCorpseFX {States {Spawn: 1H15 T 350
    goto Spawn2}}
actor Corpse_15_6 : BaseCorpseFX {States {Spawn: 1H15 U 350
    goto Spawn2}}

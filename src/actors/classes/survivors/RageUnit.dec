actor RageUnit : CustWepClassBase
{
player.scoreIcon "UMUG_15"
player.displayname "RageUnit"
player.soundclass "RageUnit"
//player.damagescreencolor "red"
player.maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 1.0, 1.0
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "RageUnit_W"
player.startitem "RageEnergyAmmo", 50
player.startitem "CustomHealthFlag", 1
States
{
Spawn:
1H15 A 0
1H15 B 1
1H15 A 1
Goto Spawn+2
See:
1H15 BCDE 5
Goto Spawn
Missile:
1H15 FFFFF 1
1H15 GGGG 1
goto Spawn+2
ClassPain:
1H15 H 0
Goto MegamanPain

ClassDeath:
1H15 H 0
goto MegamanDeath
MegamanDeath0:
1H15 H 15 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H15 H 0 A_PlaySound("weapon/magdrillshoot",1)
1H15 H 0 Radius_Quake(5,20,0,10,0)
1H15 FFFFFFFFFF 1 A_SpawnItemEx("RageUnitBurstDeath",0,0,28,0,0,0,0,1)
1H15 H 0
Goto MegamanErase
MegamanCorpse:
1H15 Z 0 A_SpawnItemEx("Corpse_15",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor RageUnitS : RageUnit
{
player.scoreIcon "UMUG_S15"
player.maxhealth 3000
health 3000
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 11
player.morphweapon "RageUnitS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H15 H 15 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H15 H 0 A_PlaySound("weapon/magdrillshoot",1)
1H15 H 0 Radius_Quake(5,20,0,10,0)
1H15 FFFFFFFFFF 1 A_SpawnItemEx("S_RageUnitBurstDeath",0,0,28,0,0,0,0,1)
1H15 H 0
Goto MegamanErase
}
}

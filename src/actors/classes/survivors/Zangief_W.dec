actor Zangief_W_ScriptBar : ScriptBar {}

actor Zangief_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Inventory.Pickupmessage "$PU_51"
  Obituary "$OB_51W"
  Tag "$TAG_Zangief_W"
  weapon.ammotype "AtomicSuplexAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H51 [ 6
    loop

   Deselect:
    6H51 A 0
    goto DeselectSwap
   Select:
    6H51 A 0
    goto SelectSwap

   Ready:
    6H51 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ZANGIEF_DYE)
    goto Ready2
   Ready2:
    6H51 A 0 A_JumpIfInventory("AtomicSuplexAmmo", 0, "Ready3")
    6H51 A 2 A_WeaponReady(WRF_NOPRIMARY)
    6H51 A 0 A_GiveInventory("AtomicSuplexAmmo", 2)
    loop
   Ready3:
    6H51 A 2 A_WeaponReady
    6H51 A 0 A_GiveInventory("AtomicSuplexAmmo", 2)
    loop

   BotFire:
    6H51 A 0 A_JumpIfInventory("ZangiefHoldFlag", 1, 2)
    6H51 A 0 A_Jump(96, "AltFireSpin")
    goto Fire+1
    6H51 A 0 A_Jump(2, "BotSwap")
    6H51 A 0 A_Jump(96, "SuplexGroundHold")
    6H51 A 0 A_Jump(96, "AltFireSpin", "AirFire")
    6H51 A 0 A_Jump(2, "BotSwap")
    goto Fire+1

   BotFireA:
    6H51 A 0 A_Jump(12, "AirEnd")
    6H51 A 0 A_Refire("SuplexFly")
    goto AirEnd
   BotFireG:
    6H51 A 0 A_Jump(64, 2)
    6H51 A 0 A_Refire("SuplexRun")
    goto SuplexGrab
    6H51 A 0 A_FaceTarget
    6H51 A 0 A_JumpIfCloser(128, 2)
    6H51 A 0 A_Refire("SuplexRun")
    goto SuplexGrab
    6H51 A 0 A_Jump(32, "BotSwap")
    goto SuplexGrab

   BotSwap:
    6H51 A 0 A_PlaySoundEx("taunt/D_51", "Voice")
    6H51 A 0 A_GiveInventory("ZangiefResetFlags_P")
    6H51 A 0 A_GiveInventory("AtomicBusterCharge", 28)
    goto AtomicBuster

   Fire:
    6H51 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H51 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_JUMP, "AirFire")
    goto GroundFire

   AirFire:
    6H51 R 0 A_GiveInventory("Zangief_FireStartA_P")
    6H51 R 0 A_ReFire(1)
    6H51 RRS 1 A_GiveInventory("SuplexFly_P0")
    6H51 S 1 A_GiveInventory("SuplexFly_P1")
   SuplexFly:
    6H51 T 1 A_GiveInventory("SuplexFly_P2")
    6H51 T 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6H51 T 0 A_JumpIfInventory("AtomicSuplexAmmo", 1, 1)
    goto AirEnd
    6H51 T 0 A_JumpIfInventory("IsBot", 1, "BotFireA")
    6H51 T 0 A_Refire("SuplexFly")
    goto AirEnd
   AirEnd:
    6H51 TT 1 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6H51 T 2 A_GiveInventory("Zangief_FireEndA_P")
    6H51 SRB 2//Funny
    6H51 BB 4 A_GiveInventory("AtomicSuplexAmmo", 4)
    goto Ready2

   GroundFire:
    6H51 B 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "SuplexThrow")
    6H51 B 0 A_GiveInventory("Zangief_FireStartG_P")
    6H51 B 0 A_Refire(1)
    6H51 BCDE 2
   SuplexRun:
    6H51 F 1 A_GiveInventory("SuplexRun_P0")
    6H51 F 0 A_JumpIfInventory("AtomicSuplexAmmo", 1, 1)
    goto SuplexGrab
    6H51 F 0 A_JumpIfInventory("IsBot", 1, "BotFireG")
    6H51 F 0 A_Refire(1)
    goto SuplexGrab
    6H51 F 1 A_GiveInventory("SuplexRun_P1")
    6H51 F 0 A_JumpIfInventory("AtomicSuplexAmmo", 1, 1)
    goto SuplexGrab
    6H51 F 0 A_Refire("SuplexRun")
    goto SuplexGrab

   SuplexGrab:
    6H51 F 1 A_GiveInventory("Zangief_FireGrab_P")
    6H51 F 0 A_JumpIfInventory("SuplexID", 1, "SuplexGround")
    6H51 F 1 A_GiveInventory("Zangief_FireGrab_P2")
    6H51 EEEE 1 A_JumpIfInventory("SuplexID", 1, "SuplexGround")

    6H51 D 2 A_GiveInventory("Zangief_FireEndG_P")
    6H51 CB 2
    6H51 BBBBB 4 A_GiveInventory("AtomicSuplexAmmo", 2)
    goto Ready2

   SuplexGround:
    6H51 E 1 A_GiveInventory("Zangief_SuplexStartG_P")
    6H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 350, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 340, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 320, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 310, angle*256/360, 100)==0, "AtomicKaboom")

    goto SuplexGroundHold+1
   SuplexGroundHold:
    6H51 E 0 A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_GiveInventory("SuplexHold_P")
    6H51 E 0 A_JumpIfInventory("ZangiefHoldFlag", 60, "SuplexGroundRelease")
    loop
   SuplexGroundRelease:
    6H51 E 0 A_GiveInventory("VivifyDelay3")
    6H51 E 0 A_GunFlash("NoFlash")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 310, angle*256/360, 92)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 320, angle*256/360, 84)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 76)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 340, angle*256/360, 68)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 350, angle*256/360, 60)==0, "AtomicKaboom")
    goto AtomicRelease
   SuplexThrow:
    6H51 E 0 A_GunFlash("NoFlash")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 315, angle*256/360, 90)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 80)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 345, angle*256/360, 70)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(momz<0, "SuplexThrowDown")
   SuplexThrowUp:
    6H51 E 0
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 359, angle*256/360, 65)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_checkfooting"), "AtomicThrow")
    6H51 E 0 A_JumpIf(momz>0, "SuplexThrowUp")//GoingUp
   SuplexThrowDown:
    6H51 E 0
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 359, angle*256/360, 65)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_checkfooting"), "AtomicThrow")
    6H51 E 0 A_JumpIf(momz<0, "SuplexThrowDown")
    goto AtomicThrow

   Suplex:
    6H51 E 0 A_GiveInventory("Zangief_SuplexStartA_P")
    6H51 E 1 A_GunFlash("NoFlash")

    6H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    //360
    6H51 E 0 A_SetPitch(356)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 348, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(352)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 336, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(348)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 325, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(344)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 314, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(340)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 303, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(336)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 292, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(333)
    6H51 E 0 A_SetAngle(angle+12)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 281, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(330)
    6H51 E 0 A_SetAngle(angle+19)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 270, CallACS("rz_CountInv_ZangiefAngle"), 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(337)
    6H51 E 0 A_SetAngle(angle+26)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 293, CallACS("rz_CountInv_ZangiefAngle")+128, 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(344)
    6H51 E 0 A_SetAngle(angle+26)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 316, CallACS("rz_CountInv_ZangiefAngle")+128, 100)==0, "AtomicKaboom")
    6H51 E 0 A_SetPitch(352)
    6H51 E 0 A_SetAngle(angle+25)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 338, CallACS("rz_CountInv_ZangiefAngle")+128, 100)==0, "AtomicKaboom")

    6H51 E 0 A_SetPitch(0)

    6H51 E 0 A_JumpIf(momz<0, "GoingDown")
   GoingUp:
    6H51 E 0
    6H51 E 1 A_JumpIf(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom")
    6H51 E 0 A_JumpIf(momz>0, "GoingUp")
   GoingDown:
    6H51 E 0 ThrustThingZ(0, 2, 1, 1)
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom")
    6H51 E 0 A_JumpIf(momz<0, "GoingDown")

   AtomicKaboom:
    6H51 E 0 A_GiveInventory("Zangief_FireSlam_P2")
    6H51 E 2 A_GiveInventory("VivifyDelay4")
    6H51 DC 2
    6H51 B 0 A_GiveInventory("ZangiefResetFlags_P")
    6H51 B 6 A_GiveInventory("AtomicSuplexAmmo", 3)
    goto Ready2
   AtomicRelease:
    6H51 E 0 A_GiveInventory("ZangiefHoldFlagRemover_P") //A_TakeInventory("ZangiefHoldFlag")
    goto AtomicKaboom+1
   AtomicThrow:
    6H51 E 0 A_GiveInventory("Zangief_FireSlam_P3")
    goto AtomicKaboom+1

   AltFireSpin:
    6H51 A 0 A_GiveInventory("SuplexAlt_P")
    6H51 A 0 A_Refire(1)
    6H51 AUVWX 3 A_SpawnItemEx("DoubleLariat", 0, 0, 32, momx, momy, momz, 0, 9)
    TNT1 A 3 A_SpawnItemEx("DoubleLariat", 0, 0, 32, momx, momy, momz, 0, 9)
    TNT1 A 0 A_SpawnItemEx("DoubleLariat", 0, 0, 32, momx, momy, momz, 0, 9)
    TNT1 A 2 A_GiveInventory("ZangiefResetFlags_P")
    TNT1 AAA 6 A_GiveInventory("AtomicSuplexAmmo", 3)
    6H51 Y 2 A_GiveInventory("AtomicSuplexAmmo", 3)
    6H51 ZA 2
    goto Ready2

   AltFire:
    6H51 P 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "AltFireSpin")
   AltFire2:
    6H51 P 0 A_JumpIfInventory("AtomicBusterCharge", 0, "AtomicBuster")
    6H51 P 1 A_GiveInventory("AtomicBusterCharge", 1)
    6H51 P 0 A_ReFire("AltFire2")
    6H51 P 0 A_TakeInventory("AtomicBusterCharge")
    goto AltFireSpin
   AtomicBuster:
    6H51 F 0 A_GiveInventory("Zangief_AtomicFireStart_P")
    6H51 F 0 A_Refire(1)

    6H51 F 1 A_GiveInventory("Zangief_AtomicFire_P")
    6H51 F 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 F 1 A_GiveInventory("Zangief_AtomicFire_P")
    6H51 E 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 E 1 A_GiveInventory("Zangief_AtomicFire_P")
    6H51 E 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 E 1 A_Stop
    6H51 D 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 D 1 A_Stop
    6H51 D 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 D 1 A_Stop
    6H51 C 0 A_JumpIfInventory("SuplexID", 1, "Suplex2")
    6H51 CCBB 1 A_Stop

    6H51 B 6 A_GiveInventory("Zangief_AtomicFireEnd_P")
    goto Ready2

   Suplex2:
    6H51 E 0 A_GiveInventory("Zangief_AtomicGrabStart_P")

    6H51 E 0 A_GunFlash("NoFlash")

    6H51 E 1 A_GiveInventory("Zangief_AtomicGrabStop_P")
    6H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    6H51 EEEEE 1 A_GiveInventory("Zangief_AtomicGrabStop_P")

    6H51 E 0 A_GiveInventory("Zangief_AtomicGrabLiftOff_P")

   GoingUp2:
    6H51 E 0 A_GiveInventory("Zangief_AtomicGrab_UP_P")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "AtomicKaboom2")
    6H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom2")
    6H51 E 0 A_JumpIf(momz>0, "GoingUp2")
   GoingDown2:
    6H51 E 0 A_GiveInventory("Zangief_AtomicGrab_DOWN_P")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab", CallACS("rz_CountInv_SuplexID")-1+1000)==0, "AtomicKaboom2")
    6H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom2")
    6H51 E 0 A_JumpIf(momz<0, "GoingDown2")

   AtomicKaboom2:
    6H51 E 2 A_GiveInventory("Zangief_FireSlam_P1")
    6H51 DC 2
    6H51 B 0 A_GiveInventory("ZangiefResetFlags_P")
    6H51 B 6 A_GiveInventory("AtomicSuplexAmmo", 3)
    goto Ready2
  }
}

actor AtomicSuplexAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 140
  +INVENTORY.IGNORESKILL
}

actor AtomicBusterCharge : Inventory {
  inventory.amount 1
  inventory.maxamount 16
}

actor ZangiefHoldFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 60
}

actor SuplexWalkSlow : PowerSpeed {
  Speed 0.30//0.25
  Powerup.Duration 24//25
}
actor SuplexFlySlow : PowerSpeed {
  Speed 1.0//0.15//0.10
  Powerup.Duration -10
}
actor SuplexFlySlow2 : SuplexFlySlow {
  Speed 0.15
  Powerup.Duration 35
}

actor ZangiefHoldFlagRemover_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("ZangiefHoldFlag")
    stop
  }
}

actor ZangiefResetFlags_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SuplexID")
    TNT1 A 0 A_TakeInventory("IsPerformingSuplex")
    TNT1 A 0 A_TakeInventory("ZangiefAngle")
    TNT1 A 0 A_TakeInventory("ZangiefHoldFlag")
    TNT1 A 0 A_TakeInventory("VivifyCycle2")//Running
    TNT1 A 0 A_TakeInventory("VivifyCycle4")//Leaping
    TNT1 A 0 A_TakeInventory("SuplexFlySlow")

    TNT1 A 0 A_TakeInventory("BasicArmor")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_halfpushplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_HalfHitStunplayer", 0, 0)


    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, 0)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_noradiusdmgplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 0)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    stop
  }
}

actor ZangiefArmorItemPickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DynamicArmorDosage_F")
    TNT1 A 0 A_GiveInventory("DynamicArmorDosage_F", 2000)
    TNT1 A 0 A_GiveInventory("Zangief_BasicArmor_P", 1)
    stop
  }
}

actor SuplexRun_P0 : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 1)
   Pickup0:
    TNT1 A 0 A_GiveInventory("VivifyCycle2", 1)
    TNT1 A 0 A_GiveInventory("SuplexWalkSlow")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Rage")
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_ChangeVelocity(0.6, 0, -0.25, CVF_RELATIVE)
    stop
    TNT1 A 0 A_Recoil(-2.4)//-2
    stop
   Rage:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_ChangeVelocity(0.75, 0, -0.1875, CVF_RELATIVE)
    stop
    TNT1 A 0 A_Recoil(-3.0)
    stop
  }
}
actor SuplexRun_P1 : SuplexRun_P0 {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 1, 1)
    goto Pickup0
  }
}


actor SuplexFly_P0 : CustomInventory {
  states {
   Pickup:
   Pickup0:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 3)
    TNT1 A 0 ThrustThing(CallACS("rz_CountInv_ZangiefAngle"), 1, 0, 0)
    TNT1 A 0 ThrustThingZ(0, 10, 0, 0)
    stop
    TNT1 A 0 ThrustThing(CallACS("rz_CountInv_ZangiefAngle"), 2, 0, 0)
    TNT1 A 0 ThrustThingZ(0, 11, 0, 0)
    stop
  }
}
actor SuplexFly_P1 : SuplexFly_P0 {
  states {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyCycle4", 1)

    TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 15, 100)//0.15
    TNT1 A 0 A_GiveInventory("SuplexFlySlow")
    TNT1 A 0 A_TakeInventory("SuplexID")
   Pickup1:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiveToAll", 0, 1)//Give AirSuplexGroundCheck
    goto Pickup0
  }
}
actor SuplexFly_P2 : SuplexFly_P1 {
  states {
   Pickup:
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 1, 1)
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 1)
    TNT1 A 0 A_SpawnItemEx("AerialGrab", 0, 0, 48, momx, momy, momz, 0, 8+32)
    goto Pickup1
  }
}

actor SuplexHold_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)
    TNT1 A 0 A_WeaponReady(WRF_NOSWITCH)
    stop
  }
}

actor SuplexAlt_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ZangiefHoldFlag", 1, 1)
    goto Pickup0
    TNT1 A 0 A_GiveInventory("ZangiefResetFlags_P")
    goto Pickup0
   Pickup0:
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, 1)
    TNT1 A 0 A_PlaySound("weapon/topspin", 1)
    TNT1 A 0 A_GiveInventory("AtomicSuplexAmmo", 10)
    stop
  }
}

actor Zangief_FireStartA_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ZangiefHoldFlag", 1, 1)
    goto Pickup0
    TNT1 A 0 A_GiveInventory("ZangiefResetFlags_P")
    goto Pickup0
   Pickup0:
    TNT1 A 0 A_GiveInventory("VivifyCycle4", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 1)
    TNT1 A 0 A_TakeInventory("ZangiefAngle")
    TNT1 A 0 A_GiveInventory("ZangiefAngle", angle*256/360)
    /*//Could change it to an Arg
    TNT1 A 0 A_SetArg(1,angle*256/360)
    TNT1 A 0 A_SetArg(2,angle*256000/360)
    TNT1 A 0 A_LogInt(angle)
    TNT1 A 0 A_LogInt(Args[1])
    TNT1 A 0 A_LogInt(Args[2])
    TNT1 A 0 A_LogInt(Args[2]*360/256000)
    TNT1 A 0 A_LogInt(Args[2]*360/256)
    */
    stop
  }
}
actor Zangief_FireEndA_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 1, 1)
    TNT1 A 0 A_TakeInventory("SuplexFlySlow")
    TNT1 A 0 A_GiveInventory("SuplexFlySlow2")

    TNT1 A 0 A_TakeInventory("VivifyCycle4")
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 5, 1)
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 5)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 0)
    stop
  }
}


actor AtomicBuster : BasicExplosion {
  DamageType "ZangiefPush"
  Obituary "$OB_51M3"
  +NOCLIP
  +NOTARGETSWITCH
  Scale 4.5  // 5.5
  Args 455, 505, 384, 196
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, 1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2)  // Either 1 or 3
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_WarpToPlayerCenter", CallACS("rz_CountInv_SuplexID", 2) + 999)
    TNT1 A 0 A_JumpIfInTargetInventory("ZangiefFriendlyGrab_F", 1, "Spawn2")
    // TNT1 A 0 Thing_Move(0,CallACS("rz_CountInv_SuplexID", 2)-1+1000,1)
    TNT1 A 0 A_Explode(random(args[0] * args[4], args[1] * args[4]), args[2], 0, 1, args[3])
   Spawn2:
    TNT1 A 0 A_PlaySound("weapon/crackerexplode", 1)
    TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZangiefRockFX", random(0, 10), 0, 8, random(3, 18), 0, random(3, 16), random(0, 359), 1, 8)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

actor AtomicSuplex : AtomicBuster {
  Scale 3.0
  Args 340, 380, 288, 128
}
actor AtomicSuplexT : AtomicBuster {
  Scale 2.5
  Args 130, 155, 96, 64
}



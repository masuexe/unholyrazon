  BOUNCEFACTOR 0.35
  BounceCount 4
  Damage (0)
  radius 2
  height 2
  scale 1.0
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3)
   Spawn1:
    6P51 D 1
    loop
   Spawn2:
    6P51 E 1
    loop
   Spawn3:
    X_5C A 1
    loop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TMFX ABCD 1
    stop
  }
}


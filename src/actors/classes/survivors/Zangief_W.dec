    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID")-1+1000)  // AntiInvincible_P on grabbed player
    TNT1 A 0 A_Jump(256, "Boom")
    stop
   Boom:
    TNT1 A 0 A_SpawnItemEX("AtomicBuster", 0, 0, 0, 0, 0, 0, 0, 1+8+32)//41
    stop
  }
}



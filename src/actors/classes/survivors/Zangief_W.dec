actor Zangief_SuplexStartG_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)

    TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)
   Pickup0: //added on the off-chance one wants to adjust sounds without needing an entire inherit or copied actor
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 15, 1)
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 15)
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nopushplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 1)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 A_GiveInventory("ZangiefArmorItemPickup")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, 1)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)
    stop
  }
}

actor Zangief_SuplexStartA_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)

   Pickup0: //added for the same reason as below
    TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 1, 1)
    TNT1 A 0 A_TakeInventory("SuplexFlySlow")

    TNT1 A 0 A_GiveInventory("VivifyDelay5")
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 15, 1)
    TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo", 15)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    TNT1 A 0 A_TakeInventory("ZangiefAngle")
    TNT1 A 0 A_GiveInventory("ZangiefAngle", CallACS("uh_ZangiefFaceTarget", CallACS("rz_CountInv_SuplexID")-1+1000))
    TNT1 A 0 A_SetAngle(CallACS("uh_ZangiefFaceTarget", CallACS("rz_CountInv_SuplexID")-1+1000)*360/256)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, 1)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)

    TNT1 A 0 A_SetPitch(0)
    stop
  }
}


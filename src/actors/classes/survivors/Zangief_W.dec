actor Zangief_AtomicGrabStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_freezeplayer", 0, 1)
    TNT1 A 0 A_SetAngle(CallACS("uh_ZangiefFaceTarget", CallACS("rz_CountInv_SuplexID") - 1 + 1000) * 360 / 256)
    TNT1 A 0 A_SetPitch(0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, 1)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")

    // Peel AtomicFireStart's invuln stack so ResetFlags' single OFF clears cleanly
    TNT1 A 0 A_TakeInventory("PlayerPropertyInvulnerable", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_invulnerableplayer", 0, 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_nonshootableplayer", 0, 1)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_unsolidplayer", 0, USP_TOGGLEON, 0)
    stop
  }
}

actor Zangief_AtomicGrabStop_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Stop
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefStartGrab", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)
    stop
  }
}
actor Zangief_AtomicGrabLiftOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_SpawnItemEx("ZangiefDustFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Recoil(-4)
    TNT1 A 0 ThrustThingZ(0, 100, 0, 0)  // Cue liftoff
    TNT1 A 0 A_TakeInventory("JumpCancler")  // Stops cancelling the LEAP
    stop
  }
}

actor Zangief_AtomicGrab_UP_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ThrustThingZ(0, 1, 1, 1)
   Pickup0:
    TNT1 A 0 A_GiveInventory("AtomicSuplexAmmo", 1)
    TNT1 A 0 A_SetAngle(angle + 20.0)
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, 1)
    stop
    TNT1 A 0 A_Jump(32, 1)
    stop
    TNT1 A 0 A_PlaySoundEx("classes/taunt/zangief", "Voice")
    stop
  }
}
actor Zangief_AtomicGrab_DOWN_P : Zangief_AtomicGrab_UP_P {
  States {
   Pickup:
    TNT1 A 0 ThrustThingZ(0, 2, 1, 1)
    goto Pickup0
  }
}



actor Zangief_FireGrab_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("G_Axe/S_30", 1)
    TNT1 A 0 A_GiveInventory("VivifyDelay3")
   Pickup0:
    TNT1 A 0 A_JumpIf(pitch < 325 && pitch >= 270, "UpLimit")
    TNT1 A 0 A_JumpIf(pitch <= 90 && pitch > 35, "DownLimit")
    TNT1 A 0 A_FireCustomMissile("AtomicSuplexGrab", 0, 0, 0, 0, 1, 0)
    stop
   UpLimit:
    TNT1 A 0  // A_SetPitch(325)
    TNT1 A 0 A_FireCustomMissile("AtomicSuplexGrab", 0, 0, 0, 0, 1, pitch + 35)
    stop
   DownLimit:
    TNT1 A 0  // A_SetPitch(35)
    TNT1 A 0 A_FireCustomMissile("AtomicSuplexGrab", 0, 0, 0, 0, 1, pitch - 35)
    stop
  }
}
actor Zangief_FireGrab_P2 : Zangief_FireGrab_P {
  States {
   Pickup:
    goto Pickup0
  }
}

actor Zangief_FireSlam_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Recoil(10)
    TNT1 A 0 ThrustThingZ(0, 35, 0, 0)
   Pickup0:
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    TNT1 A 0 A_GiveInventory("AtomicSuplexAmmo", 3)

    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ZangiefGiver", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)  // Enemy-only AntiInvincible_P, before spawning the slam
    TNT1 A 0 A_Jump(256, "Boom")
    stop
   Boom:
    TNT1 A 0 A_SpawnItemEx("AtomicBuster", 0, 0, 0, 0, 0, 0, 0, 1 + 8 + 32)  // 41
    stop
  }
}


actor Zangief_FireSlam_P2 : Zangief_FireSlam_P1 {
  States {
   Pickup:
    goto Pickup0
   Boom:
    TNT1 A 0 A_SpawnItemEx("AtomicSuplex", 0, 0, 0, 0, 0, 0, 0, 41)
    stop
  }
}

actor Zangief_FireSlam_P3 : Zangief_FireSlam_P1 {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ZangiefFriendlyGrab_F", 1, "FriendlyThrow")
    goto Pickup0
   FriendlyThrow:
    // Teammates skip the slam damage and its Pain.ZangiefPush knockback.
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_ZangiefSetThrow", CallACS("rz_CountInv_SuplexID") + 999, 28, 0)
    goto Pickup0
   Boom:
    TNT1 AA 0 A_SpawnItemEx("AtomicSuplexT", 0, 0, 0, 0, 0, 0, 0, 41)
    stop
  }
}



actor AtomicBusterGrab : BasicFastProjectile {
  Translation "192:192=214:214", "198:198=166:166"
  DamageType "Suplex"
  Obituary "$OB_51M1"
  +DONTBLAST
  +DONTREFLECT
  +FORCEXYBILLBOARD
  +THRUGHOST
  ReactionTime 1
  // Acquire before impact damage too; a friendly grab deals zero damage.
  Damage (10 * (1 - CallACS("uh_ZangiefTryGrab", args[1], 0)))
  Radius 20
  Height 20
  Speed 65
  Scale 2.0
  Args 10, 64, 64
  States {
   Spawn:
    6P51 E 0
    6P51 E 1 A_CountDown
    wait
   Death:
    6P51 E 0 A_JumpIf(CallACS("uh_ZangiefTryGrab", args[1], 0), "GrabFX")
    6P51 E 0 A_Explode(args[0], args[1], 0, true, args[2])
    goto GrabFX
   XDeath:
    // P_ExplodeMissile enters XDeath directly after a player collision.
    6P51 E 0 ACS_NamedExecuteWithResult("uh_ZangiefTryGrab", args[1], 0)
   GrabFX:
    // 6P51 E 0 A_Stop
    6P51 DEFED 2
    stop
  }
}

actor AtomicSuplexGrab : AtomicBusterGrab {
  Speed 85
}

actor AerialGrab : BasicExplosion {
  DamageType "FlySuplex"
  Obituary "$OB_51M2"
  Args 20, 158, 128
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(CallACS("uh_ZangiefTryGrab", args[1], 1), "FriendlyGrab")
    TNT1 A 1 A_Explode(args[0] * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), args[1], 0, true, args[2])
    stop
   FriendlyGrab:
    TNT1 A 1
    stop
  }
}

actor NoAirSuplex : PowerProtection {
  powerup.duration 2
  damagefactor "FlySuplex", 0.0
}


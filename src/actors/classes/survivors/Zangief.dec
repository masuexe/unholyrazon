actor Zangief : CustWepClassBase {
  Player.ScoreIcon "UMUG_51"
  Player.DisplayName "Zangief"
  Player.SoundClass "Zangief"
  Player.MaxHealth 1800
  Health 1800
  Player.ForwardMove 0.6, 0.6
  Player.SideMove 0.58, 0.58
  Player.JumpZ 10

  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Zangief_W"
  Player.StartItem "AtomicSuplexAmmo", 100

  States {
   Spawn:
    1H51 A 0
    1H51 A 0 A_JumpIfInventory("ZangiefHoldFlag", 1, 2)
    1H51 A 1 A_CheckFlag(NOBLOOD, 3)  // A_JumpIfInventory("MM8BDMPlayer",1,3)
    1H51 R 1
    1H51 F -1
    1H51 B 1
    1H51 A 210
    1H51 WX 5
    goto Spawn+7

   See:
    1H51 B 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "SeeHold")
    1H51 BCDE 5
    goto Spawn+5
   SeeHold:
    1H51 RSTS 5
    goto Spawn+3

   Melee:
    1H51 G 0 A_JumpIfInventory("VivifyDelay3", 1, "MissileA_Grab")
    goto MissileSuplex

   Missile:
    1H51 F 0 A_JumpIfInventory("VivifyDelay4", 1, "MissileD_Start")
    1H51 F 0 A_JumpIfInventory("VivifyDelay6", 1, "MissileLariat")
    1H51 F 0 A_JumpIfInventory("VivifyCycle4", 1, "MissileSiberian")
    1H51 F 0 A_JumpIfInventory("VivifyCycle2", 1, "MissileD_Grab")
    1H51 F 0 A_JumpIfInventory("AtomicBusterCharge", 0, "MissileA_Grab")
    1H51 F 0 A_JumpIfInventory("AtomicBusterCharge", 1, "Missile.Alt")
    1H51 F 5
    1H51 G 4
    goto Spawn+5

   MissileD_Start:
    1H51 F 10
    1H51 G 7
    goto Spawn+5
   MissileD_Grab:
    1H51 G 0 A_JumpIfInventory("VivifyCycle2", 9, "ARunF")
    1H51 G 0 A_JumpIfInventory("VivifyCycle2", 8, "ARunE")
    1H51 G 0 A_JumpIfInventory("VivifyCycle2", 6, "ARunD")
    1H51 G 0 A_JumpIfInventory("VivifyCycle2", 4, "ARunC")
    1H51 G 0 A_JumpIfInventory("VivifyCycle2", 1, "ARunB")
    1H51 "###" 1 A_JumpIfInventory("VivifyDelay3", 1, "MissileD_Grab2")
   MissileD_Grab2:
    1H51 G 7
    goto Spawn
   MissileA_Grab:
    1H51 G 10
    goto Spawn+5

   Missile.Alt:
    1H51 FFFFF 1 A_JumpIfInventory("VivifyDelay6", 1, "MissileLariat")
   MissileLariat:
    1H51 NOPQJKLMNOPQ 2
    goto Spawn+5
   MissileSiberian:
    1H51 F 4 A_JumpIfInventory("VivifyCycle4", 2, 1)
    1H51 UFF 4
    goto Spawn+5

   ARunB:
    1H51 R 1
    goto MissileD_Grab+5
   ARunC:
    1H51 S 1
    goto MissileD_Grab+5
   ARunD:
    1H51 T 1
    goto MissileD_Grab+5
   ARunE:
    1H51 S 1
    goto MissileD_Grab+5
   ARunF:
    1H51 S 0 A_TakeInventory("VivifyCycle2", 8)
    goto ARunE


   MissileSuplex:
    1H51 V 1 A_JumpIfInventory("VivifyDelay4", 1, "Mis_SuplexEnd")
    loop
   Mis_SuplexEnd:
    1H51 WXWX 4
    goto Spawn+5

   ClassPain:
    1H51 H 0
    goto MegamanPain

   ClassDeath:
    1H51 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H51 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H51 H 0 A_SpawnItemEx("ZangiefDeathCorpse", 0, 0, 12, -9, 0, 8, 0, 1)
    1H51 H 1 A_ChangeVelocity(-8, 0, 6, 3)
    1H51 "[" 2 A_PlaySound("*death", 2)
    goto MegamanErase

   MegamanDisintegrate:
    1H51 "[" 0 A_SpawnItemEx("Corpse_51", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor ZangiefShiny : Zangief {
  Player.ScoreIcon "UMUG_S51"
  Player.MaxHealth 3800
  Health 3800
  Player.ForwardMove 0.7, 0.7
  Player.SideMove 0.68, 0.68
  Player.JumpZ 11
  Player.MorphWeapon "ZangiefShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H51 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H51 H 0 A_SpawnItemEx("S_ZangiefDeathCorpse", 0, 0, 12, -9, 0, 8, 0, 1)
    1H51 H 1 A_ChangeVelocity(-8, 0, 6, 3)
    1H51 "[" 2 A_PlaySound("*death", 2)
    goto MegamanErase
  }
}


actor ZangiefDeathCorpse : BasicProjectile {
  DamageType "Zangief"
  Obituary "$OB_51D"
  -NOGRAVITY
  +SKYEXPLODE
  +DONTSPLASH
  +DONTBLAST
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceCount 20
  BounceFactor 0.75
  WallBounceFactor 0.90
  Damage (350)
  Radius 16
  Height 32
  Speed 32
  Scale 2.5
  States {
   Spawn:
    1H51 Y 0
    1H51 Y 1
    wait
   Crash:
   XDeath:
   Death:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("ZangiefDeathCorpseFall", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_ZangiefDeathCorpse : ZangiefDeathCorpse {
  Damage (525)
}


actor ZangiefDeathCorpseFall {
  -NOGRAVITY
  -SOLID
  +DONTSPLASH
  Radius 15
  Height 15
  Scale 2.5
  States {
   Spawn:
    1H51 Y 0
    1H51 Y 1 A_JumpIf(velz == 0, "SpawnWait")
    wait
   SpawnWait:
    1H51 Z 35 A_Stop
    1H51 ZZZZZZZZZ 35
    1H51 ZZZZZZZZZZZ 3 A_Fadeout
    stop
  }
}
actor ZangiefDeathCorpseFallX : ZangiefDeathCorpseFall {
  States {
   Spawn:
    1H51 Y 0
    1H51 Y 1 A_JumpIf(velz == 0, "SpawnWait")
    wait
  }
}

actor Corpse_51 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_51_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_51_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_51_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_51_3", 0, 0, 20, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_51_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_51_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_51_0 : BaseCorpseFX {States {Spawn: 1I51 O 350
    goto Spawn2}}
actor Corpse_51_1 : BaseCorpseFX {States {Spawn: 1I51 P 350
    goto Spawn2}}
actor Corpse_51_2 : BaseCorpseFX {States {Spawn: 1I51 Q 350
    goto Spawn2}}
actor Corpse_51_3 : BaseCorpseFX {States {Spawn: 1I51 R 350
    goto Spawn2}}
actor Corpse_51_4 : BaseCorpseFX {States {Spawn: 1I51 S 350
    goto Spawn2}}
actor Corpse_51_5 : BaseCorpseFX {States {Spawn: 1I51 T 350
    goto Spawn2}}

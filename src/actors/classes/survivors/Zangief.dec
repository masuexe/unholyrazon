actor Zangief : CustWepClassBase
{
player.scoreIcon "UMUG_51"
player.displayname "Zangief"
player.soundclass "Zangief"
player.maxhealth 1800
health 1800
player.forwardmove 0.6, 0.6
player.sidemove 0.58, 0.58
player.jumpz 10

Player.StartItem "UH_BaseFlagPack"
player.startitem "Zangief_W"
player.startitem "AtomicSuplexAmmo",100

states
{
Spawn:
1H51 A 0
1H51 A 0 A_JumpIfInventory("ZangiefHoldFlag",1,2)
1H51 A 1 A_CheckFlag(NOBLOOD,3)//A_JumpIfInventory("MM8BDMPlayer",1,3)
1H51 R 1
1H51 F -1
1H51 B 1
1H51 A 210
1H51 WX 5
goto Spawn+7

See:
1H51 B 0 A_JumpIfInventory("ZangiefHoldFlag",1,"SeeHold")
1H51 BCDE 5
goto Spawn+5
SeeHold:
1H51 RSTS 5
goto Spawn+3

Melee:
1H51 G 0 A_JumpIfInventory("VivifyDelay3",1,"MissileA_Grab")
goto MissileSuplex

Missile:
1H51 F 0 A_JumpIfInventory("VivifyDelay4",1,"MissileD_Start")
1H51 F 0 A_JumpIfInventory("VivifyDelay6",1,"MissileLariat")
1H51 F 0 A_JumpIfInventory("VivifyCycle4",1,"MissileSiberian")
1H51 F 0 A_JumpIfInventory("VivifyCycle2",1,"MissileD_Grab")
1H51 F 0 A_JumpIfInventory("AtomicBusterCharge",0,"MissileA_Grab")
1H51 F 0 A_JumpIfInventory("AtomicBusterCharge",1,"Missile.Alt")
1H51 F 5
1H51 G 4
goto Spawn+5

MissileD_Start:
1H51 F 10
1H51 G 7
goto Spawn+5
MissileD_Grab:
1H51 G 0 A_JumpIfInventory("VivifyCycle2",9,"ARunF")
1H51 G 0 A_JumpIfInventory("VivifyCycle2",8,"ARunE")
1H51 G 0 A_JumpIfInventory("VivifyCycle2",6,"ARunD")
1H51 G 0 A_JumpIfInventory("VivifyCycle2",4,"ARunC")
1H51 G 0 A_JumpIfInventory("VivifyCycle2",1,"ARunB")
1H51 "###" 1 A_JumpIfInventory("VivifyDelay3",1,"MissileD_Grab2")
MissileD_Grab2:
1H51 G 7
goto Spawn
MissileA_Grab:
1H51 G 10
goto Spawn+5

Missile.Alt:
1H51 FFFFF 1 A_JumpIfInventory("VivifyDelay6",1,"MissileLariat")
MissileLariat:
1H51 NOPQJKLMNOPQ 2
goto Spawn+5
MissileSiberian:
1H51 F 4 A_JumpIfInventory("VivifyCycle4",2,1)
1H51 UFF 4
goto Spawn+5

ARunB:
1H51 R 1
Goto MissileD_Grab+5
ARunC:
1H51 S 1
Goto MissileD_Grab+5
ARunD:
1H51 T 1
Goto MissileD_Grab+5
ARunE:
1H51 S 1
Goto MissileD_Grab+5
ARunF:
1H51 S 0 A_TakeInventory("VivifyCycle2",8)
Goto ARunE


MissileSuplex:
1H51 V 1 A_JumpIFInventory("VivifyDelay4",1,"Mis_SuplexEnd")
loop
Mis_SuplexEnd:
1H51 WXWX 4
Goto Spawn+5

ClassPain: 1H51 H 0
Goto MegamanPain

ClassDeath:
1H51 H 0
goto MegamanDeath
MegamanDeath0:
1H51 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H51 H 0 A_SpawnItemEx("ZangiefDeathCorpse",0,0,12,-9,0,8,0,1)
1H51 H 1 A_ChangeVelocity(-8,0,6,3)
1H51 "[" 2 A_PlaySound("*death",2)
Goto MegamanErase

MegamanDisintegrate:
1H51 "[" 0 A_SpawnItemEx("Corpse_51",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor ZangiefShiny : Zangief
{
player.scoreIcon "UMUG_S51"
player.maxhealth 3800
health 3800
player.forwardmove 0.7, 0.7
player.sidemove 0.68, 0.68
player.jumpz 11
player.morphweapon "ZangiefShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H51 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H51 H 0 A_SpawnItemEx("S_ZangiefDeathCorpse",0,0,12,-9,0,8,0,1)
1H51 H 1 A_ChangeVelocity(-8,0,6,3)
1H51 "[" 2 A_PlaySound("*death",2)
Goto MegamanErase
}
}


actor ZangiefDeathCorpse : BasicProjectile
{
damagetype "Zangief"
Obituary "$OB_51D"
-NOGRAVITY
+SKYEXPLODE
+DONTSPLASH
+DONTBLAST
+DONTREFLECT
+BOUNCEONWALLS
+BOUNCEONCEILINGS
BounceCount 20
BounceFactor 0.75
WallBounceFactor 0.90
Damage (350)
Radius 16
Height 32
speed 32
scale 2.5
States
{
Spawn:
1H51 Y 0
1H51 Y 1
wait
Crash:
XDeath:
Death:
TNT1 A 0
TNT1 A 2 A_SpawnItemEx("ZangiefDeathCorpseFall",0,0,0,0,0,0,0,1)
stop
}
}
actor S_ZangiefDeathCorpse : ZangiefDeathCorpse
{
Damage (525)
}


actor ZangiefDeathCorpseFall
{
-NOGRAVITY
-SOLID
+DONTSPLASH
Radius 15
Height 15
scale 2.5
States
{
Spawn:
1H51 Y 0
1H51 Y 1 A_JumpIf(momz==0,"SpawnWait")
wait
SpawnWait:
1H51 Z 35 A_Stop
1H51 ZZZZZZZZZ 35
1H51 ZZZZZZZZZZZ 3 A_Fadeout
stop
}
}
actor ZangiefDeathCorpseFallX : ZangiefDeathCorpseFall
{
States
{
Spawn:
1H51 Y 0
1H51 Y 1 A_JumpIf(momz==0,"SpawnWait")
wait
}
}

actor Corpse_51:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_51_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_51_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_51_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_51_3",0,0,20,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_51_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_51_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


actor BeerMan : CustWepClassBase {
  Player.ScoreIcon "UMUG_25"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "BeerMan"
  Player.SoundClass "BeerMan"
  Player.MaxHealth 1500
  Health 1500
  Player.ForwardMove 0.65, 0.65
  Player.SideMove 0.65, 0.65
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "BeerMan_W"
  Player.StartItem "DrunkEnergyAmmo", 150
  States {
   Spawn:
    BURS A 0
    BURS B 1
    BURS A 1
    goto Spawn+2
   See:
    BURS BCDE 5
    goto Spawn
   Missile:
    BURS F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile_Alt")
    BURS FFFFF 1
    BURS GGGG 1
    goto Spawn+2
   Missile_Alt:
    BURS R 9
    goto Spawn+2
   ClassPain:
    BURS H 0
    goto MegamanPain

   ClassDeath:
    BURS H 0
    goto MegamanDeath
   MegamanDeath0:
    BURS H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    BURS H 0 A_SpawnItemEx("Beerman_WaveDeath_H", 0, 0, 0, 0, 0, 0, 0, 1)
    goto MegamanFade
   MegamanDisintegrate:
    BURS Z 0 A_SpawnItemEx("Corpse_25", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor BeerManShiny : BeerMan {
  Player.ScoreIcon "UMUG_S25"
  Player.MaxHealth 3500
  Health 3500
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 11
  Player.MorphWeapon "BeerManShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    BURS H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    BURS H 0 A_SpawnItemEx("S_Beerman_WaveDeath_H", 0, 0, 0, 0, 0, 0, 0, 1)
    goto MegamanFade
  }
}



actor Beerman_WaveDeath : Beerman_Wave {
  Obituary "$OB_25D"
  // Damage (random(19,25))
  Args 8
  States {
   Spawn:
    6P25 AB 2
   SpawnL:
    6P25 C 0 A_SetAngle(Angle + 15)
    6P25 C 0 A_ChangeVelocity(10, 0, 0, 3)
    6P25 CD 2
    6P25 C 0 A_SetAngle(Angle + 15)
    6P25 C 0 A_ChangeVelocity(10, 0, 0, 3)
    6P25 CB 2
    6P25 C 0 A_CountDownArg(0)
    loop
   Death:
    6P25 A 2
    stop
  }
}
actor S_Beerman_WaveDeath : Beerman_WaveDeath {
  Damage (random(29, 38))
}

actor Beerman_WaveDeath_H : BasicWatcher {
  // DeathSound ""
  Args 11
  States {
   Spawn:
    TNT1 A 0
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("Beerman_WaveDeath", 10, 0, 0, 10, 0, 0, 0 + args[0] * 30, 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}
actor S_Beerman_WaveDeath_H : BasicWatcher {
  Args 11
  States {
   Spawn:
    TNT1 A 0
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("S_Beerman_WaveDeath", 10, 0, 0, 10, 0, 0, 0 + args[0] * 30, 1)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}


actor Corpse_25 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_25_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_25_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_25_0 : BaseCorpseFX {States {Spawn: 1H25 O 350
    goto Spawn2}}
actor Corpse_25_1 : BaseCorpseFX {States {Spawn: 1H25 P 350
    goto Spawn2}}
actor Corpse_25_2 : BaseCorpseFX {States {Spawn: 1H25 Q 350
    goto Spawn2}}
actor Corpse_25_3 : BaseCorpseFX {States {Spawn: 1H25 R 350
    goto Spawn2}}
actor Corpse_25_4 : BaseCorpseFX {States {Spawn: 1H25 S 350
    goto Spawn2}}
actor Corpse_25_5 : BaseCorpseFX {States {Spawn: 1H25 T 350
    goto Spawn2}}
actor Corpse_25_6 : BaseCorpseFX {States {Spawn: 1H25 U 350
    goto Spawn2}}

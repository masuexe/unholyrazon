actor BeerMan : CustWepClassBase
{
player.scoreIcon "UMUG_25"
player.displayname "BeerMan"
player.soundclass "BeerMan"
player.maxhealth 1500
health 1500
player.forwardmove 0.65, 0.65
player.sidemove 0.65, 0.65
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
Player.StartItem "BeerMan_W"
Player.StartItem "DrunkEnergyAmmo", 150
States
{
Spawn:
BURS A 0
BURS B 1
BURS A 1
Goto Spawn+2
See:
BURS BCDE 5
Goto Spawn
Missile:
BURS F 0 A_JumpIfInventory("VivifyFlag1",1,"Missile_Alt")
BURS FFFFF 1
BURS GGGG 1
goto Spawn+2
Missile_Alt:
BURS R 9
goto Spawn+2
ClassPain: BURS H 0
Goto MegamanPain

ClassDeath:
BURS H 0
goto MegamanDeath
MegamanDeath0:
BURS H 10 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
BURS H 0 A_SpawnItemEx("Beerman_WaveDeath_H",0,0,0,0,0,0,0,1)
Goto MegamanFade
MegamanDisintegrate:
BURS Z 0 A_SpawnItemEx("Corpse_25",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor BeerManS : BeerMan
{
player.scoreIcon "UMUG_S25"
Player.Maxhealth 3500
health 3500
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 11
player.morphweapon "BeerManS_W"
+NOSKIN
+PLAYERPAWN.NOMORPHLIMITATIONS
States
{
MegamanDeath0:
BURS H 10 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
BURS H 0 A_SpawnItemEx("S_Beerman_WaveDeath_H",0,0,0,0,0,0,0,1)
Goto MegamanFade
}
}



actor Beerman_WaveDeath : Beerman_Wave
{
Obituary "$OB_25D"
//Damage (random(19,25))
Args 8
States
{
Spawn:
6P25 AB 2
SpawnL:
6P25 C 0 A_SetAngle(Angle+15)
6P25 C 0 A_ChangeVelocity(10,0,0,3)
6P25 CD 2
6P25 C 0 A_SetAngle(Angle+15)
6P25 C 0 A_ChangeVelocity(10,0,0,3)
6P25 CB 2
6P25 C 0 A_CountDownArg(0)
loop
Death:
6P25 A 2
Stop
}
}
actor S_Beerman_WaveDeath : Beerman_WaveDeath
{
Damage (random(29,38))
}

actor Beerman_WaveDeath_H : BasicHelper
{
//DeathSound ""
Args 11
States
{
Spawn:
TNT1 A 0
goto SpawnL
SpawnL:
TNT1 A 0 A_SpawnItemEx("Beerman_WaveDeath",10,0,0,10,0,0,0+Args[0]*30,1)
TNT1 A 0 A_CountDownArg(0)
loop
}
}
actor S_Beerman_WaveDeath_H : BasicHelper
{
Args 11
States
{
Spawn:
TNT1 A 0
goto SpawnL
SpawnL:
TNT1 A 0 A_SpawnItemEx("S_Beerman_WaveDeath",10,0,0,10,0,0,0+Args[0]*30,1)
TNT1 A 0 A_CountDownArg(0)
loop
}
}


actor Corpse_25:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_25_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_25_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


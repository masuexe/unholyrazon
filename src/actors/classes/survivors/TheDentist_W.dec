actor TheDentist_W_NormalBar : NormalBar {args 4, 196}

actor TheDentist_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 120
Inventory.Pickupmessage "$PU_29"
Obituary "$OB_29W"
Tag "$TAG_TheDentist_W"
weapon.ammotype "ShinyEnergyAmmo"
States
{
Spawn:
6H29 [ 6
loop

Deselect:
6H29 A 0
goto DeselectSwap
Select:
6H29 A 0
goto SelectSwap

Ready:
6H29 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", THEDENTIST_DYE)
Goto Ready2
Ready2:
6H29 A 2 A_GiveInventory("TheDentist_Ready_P")
loop

Fire:
6H29 E 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H29 C 0 A_GiveInventory("TheDentist_Fire_P")
6H29 FEDCB 1
TNT1 A 3
6H29 GH 2
//6H29 BCDEF 2
//TNT1 A 2
Goto Ready2

BotFire:
6H29 A 0 A_Jump(16,"BotFire2")
6H29 A 0 A_Jump(32,1)
goto Fire+1
6H29 A 0 A_GiveInventory("ShinyEnergyAmmo",45)
6H29 A 0 A_Jump(128,"Altfire")
goto Fire+1
BotFire2:
6H29 A 0 A_PlaySoundEx("taunt/D_29","Voice")
6H29 A 0 A_FireCustomMissile("TheDentistShot",0,0,20,0)
6H29 A 0 A_FireCustomMissile("TheDentistShot",0,0,-20,0)
6H29 Q 2 A_GiveInventory("TheDentist_Alt_P")
6H29 S 0 A_GiveInventory("ShinyEnergyAmmo",60)
goto Altfire+2

AltFire:
6H29 S 0 A_GiveInventory("TheDentist_Alt_P")
6H29 QRSSRQ 2
Goto Ready2
}
}

actor ShinyEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 120
+INVENTORY.IGNORESKILL
}

actor TheDentist_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ShinyEnergyAmmo",15,2)
TNT1 A 0 A_WeaponReady(12)
goto Ammo
TNT1 A 0 A_JumpIfInventory("ShinyEnergyAmmo",60,2)
TNT1 A 0 A_WeaponReady(8)
goto Ammo
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("ShinyEnergyAmmo",2)
stop
}
}

actor TheDentist_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("TheDentistShot",0,0,8,0)
Take:
TNT1 A 0 A_PlaySound("TheDentist/Main",1)//weapon/metalblade
TNT1 A 0 A_TakeInventory("ShinyEnergyAmmo",10,1)
TNT1 A 0 A_TakeInventory("ShinyEnergyAmmo",5)
stop
}
}

actor TheDentist_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("TheDentistDrill",0,0,8,0)
Take:
TNT1 A 0 A_TakeInventory("ShinyEnergyAmmo",30,1)
TNT1 A 0 A_TakeInventory("ShinyEnergyAmmo",30)
TNT1 A 0 A_PlaySound("weapon/magnetmissile",1)
stop
}
}

actor TheDentistShot : BasicProjectile
{
Translation "4:4=196:196"//"0:0=196:196"
BounceSound "TheDentist/BladeBounce"
damagetype "ShinyBlade"
Obituary "$OB_29M"
+RIPPER
+USEBOUNCESTATE
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+BOUNCEONACTORS
+ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
WALLBOUNCEFACTOR 1.0
BOUNCEFACTOR 1.0
bouncecount 4
Gravity 1.25
Damage (105+Args[0])
Radius 12
Height 12
Speed 55
scale 2.5
Args 0,2
States
{
Spawn:
TNT1 A 1
TNT1 A 0 A_Jump(256,1,2,3,4,5,6,7,8)
Spawn1:
6P29 ABCD 2
loop
Spawn2:
6P29 DCBA 2
loop
Spawn3:
TNT1 A 0 A_Jump(256,"Spawn4","Spawn5")
Spawn4:
6P29 ABCD 1 A_SetArg(0,Args[0]+Args[1])
loop
Spawn5:
6P29 DCBA 1 A_SetArg(0,Args[0]+Args[1])
loop

Bounce:
"####" "#" 0 A_ChangeFlag("USEBOUNCESTATE",0)
"####" "#" 0 A_ChangeFlag("NOGRAVITY",0)
"####" "#" 0 //A_ChangeFlag("RIPPER",0)
//"####" "#" 0 A_PlaySoundEx("TheDentist/BladeBounce",1)
"####" "#" 0 A_ChangeVelocity(momx,momy,momz*2/3,CVF_REPLACE)
"####" "#" 0 A_SetArg(0,Args[1]*5)
goto Spawn3

Death:
TNT1 A 1
stop
}
}

actor TheDentistDrill : BasicProjectile
{
Translation "192:192=4:4","198:198=196:196"
Obituary "$OB_29A1"
damagetype "ShinyBlade"
Damage (75)
Height 12
Radius 12
Speed 45
Scale 2.5
States
{
Spawn:
X_4C ABC 3
X_4C A 0 A_PlaySound("weapon/drillfly",1)
loop
Death:
TNT1 A 0 A_Explode(100,96,0,0,24)
TNT1 A 0 A_SpawnItemEx("TheDentistRainFlush",0,0,0,0,0,0,0,1)
DeathFX:
TNT1 A 0 A_PlaySound("S_Spin/Explode",1,0.5,False,1.5)
TNT1 A 0 A_SpawnItemEx("BasicRainFlushPodFX",0,0,0,0,0,0,0,1)
TNT1 A 4 A_SpawnItemEx("TheDentistDebuff_BoomFX",0,0,0,0,0,0,0,1)//BasicBoom6FX_ColorX
stop
}
}


actor TheDentistRainFlush : BasicExplosion
{
Obituary "$OB_29A2"
damagetype "TheDentistDebuff"
RenderStyle None
ReactionTime 5
Args 30,488,224
States
{
Spawn:
TNT1 A 0
TNT1 A 33//35
TNT1 A random(0,2)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_SpawnItemEx("TheDentistRainFlushFX",0,0,0,0,0,0,0,1+32)
TNT1 A 0 A_SpawnItemEx("TheDentistRainFlushFX",0,0,0,0,0,0,90,1+32)
TNT1 A 0 A_SpawnItemEx("TheDentistRainFlushFX",0,0,0,0,0,0,180,1+32)
TNT1 A 0 A_SpawnItemEx("TheDentistRainFlushFX",0,0,0,0,0,0,270,1+32)
Spawn2:
TNT1 A 0 A_PlaySound("TheDentist/AltRain",0,1.0,False,0.75)
TNT1 A 6 A_Explode(Args[0]*1.4,Args[1],0,0,Args[2]/4)
TNT1 A 0 A_CountDown
loop
}
}

actor TheDentistRainFlushFX : BasicClientSide
{
ReactionTime 32
States
{
Spawn:
TNT1 A 0
TNT1 AAA 0 A_SpawnItemEx("TheDentistRainSprinkleFX",random(-128,384),random(-128,384),256,-30,0,-30,90,1+128,32)
TNT1 A 1 A_CountDown
loop
}
}
actor TheDentistRainSprinkleFX : BasicToadSprinkleFX
{
Args 14
}



actor TheDentistMouthwashFlag : PowerUp
{
Powerup.Duration 175
}
actor TheDentistHitDelay_F : PowerUp
{
Powerup.Duration 3
}

actor TheDentistDebuff_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TheDentistMouthwashFlag",1,3)
TNT1 A 0 A_SpawnItemEx("TheDentistDebuff_H")
TNT1 A 0 A_SpawnItemEx("TheDentistDebuff_Snd")
TNT1 A 0 A_GiveInventory("TheDentistMouthwashFlag",1)
TNT1 A 0 A_GiveInventory("TheDentistHitDelay_F",1)
stop
}
}

actor TheDentistDebuff_H : BasicHelper
{
+SERVERSIDEONLY
+NOTIMEFREEZE
RenderStyle None
ReactionTime 1
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_TransferPointer(2,0,2,8)//Fetch Target and put on Tracer
goto SpawnL+1
SpawnL:
TNT1 A 0 A_SetArg(0,Args[0]+1)
TNT1 A 0 A_GiveToTarget("TheDentistDebuff_P1",1)
TNT1 AA 1 A_GiveInventory("DentistDebuff_H_P")
TNT1 A 0 A_JumpIfInTargetInventory("TheDentistMouthwashFlag",1,1)
stop
TNT1 A 0 A_GiveToTarget("TheDentistDebuff_P1",1)
TNT1 AA 1 A_GiveInventory("DentistDebuff_H_P")
TNT1 A 0 A_JumpIfInTargetInventory("TheDentistMouthwashFlag",1,1)
stop
TNT1 A 0 A_GiveToTarget("TheDentistDebuff_P1",1)
TNT1 AA 1 A_GiveInventory("DentistDebuff_H_P")
TNT1 A 0 A_JumpIfInTargetInventory("TheDentistMouthwashFlag",1,1)
stop
TNT1 A 0 A_GiveToTarget("TheDentistDebuff_P2",1)
TNT1 AA 1 A_GiveInventory("DentistDebuff_H_P")
TNT1 A 0 A_JumpIfInTargetInventory("TheDentistMouthwashFlag",1,"SpawnL")
stop
Death:
TNT1 A 0 A_RearrangePointers(8,0,2)//Swap Target/Tracer
TNT1 A 0 A_TakeInventory("TheDentistMouthwashFlag",1,0,8)
TNT1 A 0 A_Warp(8,0,0,32,0,WARPF_NOCHECKPOSITION)
TNT1 A 0 A_SetArg(0,(Args[0]>3)*90+Args[0]*2)
TNT1 A 0 A_JumpIf(CheckClass("S_TheDentist",2),3)
TNT1 A 0 A_SetArg(0,Args[0]+50)
TNT1 A 0 A_SpawnItemEx("TheDentistDebuff_Boom",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL)
stop
TNT1 A 0 A_SetArg(0,Args[0]*1.5+75)
TNT1 A 0 A_SpawnItemEx("S_TheDentistDebuff_Boom",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL)
stop
}
}
actor DentistDebuff_H_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInTargetInventory("TheDentistHitDelay_F",1,2)
TNT1 A 0 A_JumpIfInTargetInventory("IsInPain",1,"TeethRot")
TNT1 A 0
stop
TeethRot:
TNT1 A 0 A_CountDown
stop
}
}



actor Wisp : CustWepClassBase {
  Player.ScoreIcon "UMUG_55"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Wisp"
  Player.SoundClass "Wisp"
  Player.MaxHealth 1250
  Health 1250
  Player.ForwardMove 0.925, 0.925
  Player.SideMove 0.925, 0.925
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Wisp_W"
  Player.StartItem "WispSpiritAmmo", 3
  States {
   Spawn:
    1H55 A 0
    1H55 B 1
    1H55 A 1
    goto Spawn+2
   See:
    1H55 BCDE 5
    goto Spawn
   Missile:
    1H55 F 0 A_JumpIfInventory("VivifyDelay6", 1, "Missile2")
    1H55 F 5
    1H55 G 4
    goto Spawn+2
   Missile2:
    1H55 FGFGFG 4
    goto Spawn+2

   ClassPain:
    1H55 H 0
    goto MegamanPain

   ClassDeath:
    1H55 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H55 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H55 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H55 H 0 ThrustThingZ(0, 82, 0, 0)
    1H55 H 0 A_SpawnItemEx("WispKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    1H55 Z 0 A_SpawnItemEx("Corpse_55", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor WispShiny : Wisp {
  Player.ScoreIcon "UMUG_S55"
  Player.MaxHealth 3050
  Health 3050
  Player.ForwardMove 1.025, 1.025
  Player.SideMove 1.025, 1.025
  Player.JumpZ 11
  Player.MorphWeapon "WispShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H55 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H55 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H55 H 0 ThrustThingZ(0, 82, 0, 0)
    1H55 H 0 A_SpawnItemEx("Shiny_WispKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
  }
}


actor WispKirbyDeathCorpse : BasicKirbyDeathCorpse {
  DamageType "Wisp"
  Obituary "$OB_55D"
  States {
   Spawn:
    1H55 H 0
    1H55 H 0
    goto Spawn2
  }
}
actor Shiny_WispKirbyDeathCorpse : WispKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

actor WispGrave1 {
  -SOLID
  +DONTBLAST
  RenderStyle "Translucent"
  Radius 16
  Height 16
  Scale 2.5
  States {
   Spawn:
    6N55 V 280  // 8 sec
    goto Death
   Death:
    6N55 "#" 1 A_PlaySound("wep_L/RMagicSplash", 2)
    6N55 "#" 1 A_Fadeout(0.05)
    wait
  }
}
actor WispGraveCallingCard : WispGrave1 {
  States {
   Spawn:
    6N55 V 560
    goto Death
  }
}

actor WispGrave2 : WispGrave1 {
  States {
   Spawn:
    6N55 W 280
    goto Death
  }
}

actor WispGrave3 : WispGrave1 {
  States {
   Spawn:
    6N55 XXYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZ 4
    6N55 X 1
    goto Death
  }
}


actor Shiny_WispGrave : WispGrave1 {  // Demorph flash
  // Scale 3.0
  Alpha 0.0
  States {
   Spawn:
    6P55 V 0
    6P55 V 0 A_Jump(256, "S1", "S2", "S3")
    6P55 VVVVVVVVVV 4 A_FadeIn
    6P55 V 240
    goto Death
    6P55 WWWWWWWWWW 4 A_FadeIn
    6P55 W 240
    goto Death
    6P55 XXXXXXXXXX 4 A_FadeIn
    6P55 YZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZ 4
    6P55 X 1
    goto Death
  }
}

actor Corpse_55 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_55_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_3", 0, 0, 18, velx + frandom(-1, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


actor Wisp : CustWepClassBase {
  player.scoreIcon "UMUG_55"
  player.displayname "Wisp"
  player.soundclass "Wisp"
  Player.Maxhealth 1250
  health 1250
  player.forwardmove 0.925, 0.925
  player.sidemove 0.925, 0.925
  player.jumpz 10
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "Wisp_W"
  player.startitem "WispSpiritAmmo", 3
  States {
   Spawn:
    1H55 A 0
    1H55 B 1
    1H55 A 1
    Goto Spawn+2
   See:
    1H55 BCDE 5
    Goto Spawn
   Missile:
    1H55 F 0 A_JumpIfInventory("VivifyDelay6", 1, "Missile2")
    1H55 F 5
    1H55 G 4
    goto Spawn+2
   Missile2:
    1H55 FGFGFG 4
    goto Spawn+2

   ClassPain: 1H55 H 0
    Goto MegamanPain

   ClassDeath:
    1H55 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H55 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H55 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H55 H 0 ThrustThingZ(0, 82, 0, 0)
    1H55 H 0 A_SpawnItemEx("WispKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    Goto MegamanErase
   MegamanDisintegrate:
    1H55 Z 0 A_SpawnItemEx("Corpse_55", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor WispShiny : Wisp {
  player.scoreIcon "UMUG_S55"
  Player.Maxhealth 3050
  health 3050
  player.forwardmove 1.025, 1.025
  player.sidemove 1.025, 1.025
  player.jumpz 11
  player.morphweapon "WispShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H55 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H55 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H55 H 0 ThrustThingZ(0, 82, 0, 0)
    1H55 H 0 A_SpawnItemEx("Shiny_WispKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    Goto MegamanErase
  }
}


actor WispKirbyDeathCorpse : BasicKirbyDeathCorpse {
  damagetype "Wisp"
  Obituary "$OB_55D"
  States {
   Spawn:
    1H55 H 0
    1H55 H 0
    goto Spawn2
  }
}
actor Shiny_WispKirbyDeathCorpse : WispKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

Actor WispGrave1 {
  -SOLID
  +DONTBLAST
  RenderStyle Translucent
  Radius 16
  Height 16
  Scale 2.5
  States {
   Spawn:
    6N55 V 280 //8 sec
    goto Death
   Death:
    6N55 "#" 1 A_PlaySound("wep_L/RMagicSplash", 2)
    6N55 "#" 1 A_Fadeout(0.05)
    wait
  }
}
Actor WispGraveCallingCard : WispGrave1 {
  States {
   Spawn:
    6N55 V 560
    goto Death
  }
}

Actor WispGrave2 : WispGrave1 {
  States {
   Spawn:
    6N55 W 280
    goto Death
  }
}

Actor WispGrave3 : WispGrave1 {
  States {
   Spawn:
    6N55 XXYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZ 4
    6N55 X 1
    goto Death
  }
}


Actor Shiny_WispGrave : WispGrave1//Demorph flash
{
  //Scale 3.0
  Alpha 0.0
  States {
   Spawn:
    6P55 V 0
    6P55 V 0 A_Jump(256, "S1", "S2", "S3")
    6P55 VVVVVVVVVV 4 A_FadeIn
    6P55 V 240
    goto Death
    6P55 WWWWWWWWWW 4 A_FadeIn
    6P55 W 240
    goto Death
    6P55 XXXXXXXXXX 4 A_FadeIn
    6P55 YZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZ 4
    6P55 X 1
    goto Death
  }
}

actor Corpse_55 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_55_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_1", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_2", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_3", 0, 0, 18, momx+frandom(-1, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_4", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_55_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


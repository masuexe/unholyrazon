actor Handyman_FloorQuake_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("misc/BlankSound",4)
TNT1 A 0 A_GiveInventory("VivifyDelay8",1)
//TNT1 A 0 A_LogInt(Args[4])
//TNT1 A 0 A_LogInt(100+100*(Args[4]/10))
//TNT1 A 0 A_LogInt(1+Args[4]/10)

TNT1 A 0 A_JumpIf(Args[4]>=100,"Limit")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage",100+100*(Args[4]/10),1+Args[4]/10,41)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1+SXF_TRANSFERSPECIAL)

stop
Limit:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage",1000,9,41)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
stop
}
}

actor Handyman_FloorQuakeSpawn : Basic_FloorQuakeSpawn
{
Obituary "$OB_41A2"
damagetype "HandyStun"
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("Handyman_FloorQuakeBoom",0,0,28,0,0,0,0,SXF_TRANSFERSPECIAL)
stop
}
}
actor Handyman_FloorQuakeBoom : Basic_FloorQuakeBoom
{
Translation "4:4=218:218"
Obituary "$OB_41A2"
damagetype "HandyStun"
MeleeRange 50
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(25+Args[0]*MeleeRange,15,0,0,15)
goto FX
}
}


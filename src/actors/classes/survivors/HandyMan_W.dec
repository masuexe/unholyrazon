actor HandyShieldBackFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("HandyShieldBackFX1",cos(-CallACS("uc_HandyManPitch"))*36,20,24+(sin(-CallACS("uc_HandyManPitch"))*36),momx,momy,momz,0,SXF_TRANSFERTRANSLATION|SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
TNT1 A 0 A_SpawnItemEx("HandyShieldBackFX2",cos(-CallACS("uc_HandyManPitch"))*36,-20,24+(sin(-CallACS("uc_HandyManPitch"))*36),momx,momy,momz,0,1+8+32)
stop
}
}

actor HandyShieldHitbox_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("HandyShieldHitbox1",cos(-pitch)*36,20,24+(sin(-pitch)*36),0,0,0,0,32)
TNT1 A 0 A_SpawnItemEx("HandyShieldHitbox2",cos(-pitch)*36,-20,24+(sin(-pitch)*36),0,0,0,0,32)
TNT1 A 0 A_SpawnItemEx("HandyShieldFX1",cos(-pitch)*36,20,24+(sin(-pitch)*36),0,0,0,0,1+32)
TNT1 A 0 A_SpawnItemEx("HandyShieldFX2",cos(-pitch)*36,-20,24+(sin(-pitch)*36),0,0,0,0,1+32)
stop
}
}

actor HandyShieldHitbox1 : BasicShieldHitbox
{
//RenderStyle Normal
+SERVERSIDEONLY
Species "DumbHandyShield"
Radius 18
Height 38
Args 36,20,24
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIf(CallACS("core_targetexists")==0,"Death2")
TNT1 A 0 A_JumpIfInTargetInventory("StopShield",1,"SpawnStop")
TNT1 A 1 A_Warp(AAPTR_TARGET,cos(-CallACS("uc_HandyManPitch"))*Args[0],Args[1],Args[2]+(sin(-CallACS("uc_HandyManPitch"))*Args[0]),0,WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
loop
Pain:
TNT1 A 0 A_PlaySound("item/protoreflect")
TNT1 A 0 A_SpawnItemEx("HandyShieldDeathFX_H1")
goto Spawn
}
}
actor HandyShieldHitbox2 : HandyShieldHitbox1
{
Args 36,-20,24
States
{
Pain:
TNT1 A 0 A_PlaySound("item/protoreflect")
TNT1 A 0 A_SpawnItemEx("HandyShieldDeathFX_H2")
goto Spawn
}
}


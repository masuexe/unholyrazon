actor HandyMan_W_NormalBar : NormalBar {args 218, 223}

actor HandyMan_W : BaseMM8BDMWep_UH 
{
Weapon.AmmoUse 0
Weapon.AmmoGive 100
Inventory.Pickupmessage "$PU_41"
Obituary "$OB_41W"
Tag "$TAG_HandyMan_W"
weapon.ammotype "HandyHandAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H41 [ 6
loop

Deselect:
6H41 Q 0 A_GiveInventory("StopShield",1)
goto DeselectSwap
Select:
6H41 Q 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
6H41 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", HANDYMAN_DYE)
6H41 Q 2
Goto Ready2
Ready2:
6H41 A 2 A_TakeInventory("StopShield")
6H41 A 0 A_GunFlash("Flash",1)
goto ReadyX
ReadyX:
6H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,"ReadyX3")
6H41 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H41 A 0 A_GiveInventory("HandyHandAmmo",4)
loop
ReadyX3:
6H41 A 2 A_WeaponReady
6H41 A 0 A_GiveInventory("HandyHandAmmo",4)
goto ReadyX

Flash:
TNT1 A 0 A_GiveInventory("HandyShieldHitbox_P")
TNT1 A 0 A_JumpIfInventory("StopShield",1,"NoFlash")
TNT1 A 1 A_GiveInventory("HandyShieldBackFX_P")
goto Flash+1
Flash.Ammo:
TNT1 A 2 A_GiveInventory("HandyHandAmmo",2)
loop
Flash.AirTimer:
TNT1 A 0 A_SetArg(4,1)
TNT1 A 2 A_SetArg(4,Args[4]+1)
wait

Fire:
6H41 B 0 A_JumpIfInventory("HandyFlag",1,"QuakeBoostUp")
6H41 B 0 A_GiveInventory("StopShield",1)
6H41 B 1 A_GunFlash("Flash.Ammo",1)
6H41 E 1
FireH:
6H41 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H41 C 0 A_PlaySound("S3_K/SpikeMine",1)
6H41 C 0 A_FireCustomMissile("HandyFistShot2",0,0,-28,8)
6H41 C 0 A_FireCustomMissile("HandyFistShot",0,0,28,8)
6H41 CDE 2
6H41 E 10
6H41 EEFG 2 A_ReFire("FireH")
6H41 H 0 A_GiveInventory("Handyman_FireAltCheck_P")
6H41 H 2 A_ReFire("FireH")
6H41 I 0 A_GiveInventory("Handyman_FireAltCheck_P")
6H41 I 2 A_ReFire("FireH")
6H41 J 0 A_GiveInventory("Handyman_FireAltCheck_P")
6H41 J 2 A_ReFire("FireH")
6H41 K 0 A_GiveInventory("Handyman_FireAltCheck_P")
6H41 K 2 A_ReFire("FireH")
6H41 A 0 A_ReFire("FireH")
Goto Ready2

BotFire:
6H41 A 0 A_Jump(4,"BotFireX")
6H41 A 0 A_Jump(8,"QuakeStart")
6H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,1)
goto FireH+1
6H41 A 0 A_Jump(10,"BotFireX")
6H41 A 0 A_Jump(32,"QuakeStart")
goto FireH+1
BotFireX:
6H41 A 0 A_JumpIfInventory("HandymanBotPowerD",1,"QuakeStart")
6H41 A 0 A_PlaySoundEx("taunt/D_41","Voice")
6H41 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
6H41 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
//6H41 A 94
6H41 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("HandyHandBotChargeStart",0,0,28,20,0,random(-20,20),random(0,359),1)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage",1000,9,41)
TNT1 A 0 A_SpawnItemEx("Handyman_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
6H41 A 2 A_PlaySound("S_Spin/Explode",4)
6H41 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
6H41 A 0 A_GiveInventory("HandymanBotPowerD",1)
6H41 A 0 A_GiveInventory("HandymanBotPowerS",1)
6H41 A 2 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Goto FireH+1

Altfire:
6H41 A 0 A_JumpIfInventory("HandyFlag",1,"QuakeBoostDown")
6H41 A 0 A_JumpIfInventory("HandyHandAmmo",200,"QuakeStart")
Goto ReadyX
QuakeStart:
6H41 L 0 A_GiveInventory("Handyman_AltStart_P")
6H41 L 0 A_ReFire(1)
6H41 L 3 A_GunFlash("Flash.AirTimer",1)//NoFlash
6H41 M 1 A_ReFire("QuakeUpCheck0")
6H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
6H41 M 1 A_ReFire("QuakeUpCheck0")
6H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
6H41 M 1 A_ReFire("QuakeUpCheck0")
6H41 M 0 A_JumpIf(momz<=0, "QuakeDownA")
QuakeUp:
6H41 N 1 A_ReFire("QuakeUpCheck")//A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY)
6H41 N 0 A_JumpIf(momz<=0, "QuakeDownA")
loop
QuakeUp0:
6H41 N 1 A_JumpIf(momz<=0, "QuakeDownA")
6H41 N 0 A_ReFire("QuakeUp0")//A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY)
loop
QuakeUpCheck0:
6H41 M 3 A_GiveInventory("Handyman_AltBoost_P")
goto QuakeUp
QuakeUpCheck:
6H41 N 0 OffSet(0,32)A_JumpIfInventory("HandyHandAmmo",1,1)
goto QuakeUp0
6H41 N 2 OffSet(0,34)A_GiveInventory("Handyman_AltBoost_P")
6H41 N 1 OffSet(0,32)
goto QuakeUp


QuakeDown:
6H41 N 0 A_JumpIf(z-floorz==0, "QuakeCrash")//CountInv would be useful
6H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
6H41 N 1 A_GiveInventory("Handyman_AltFall_P")
loop
QuakeDownF:
6H41 N 0 A_JumpIf(z-floorz==0, "QuakeCrash")
6H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
6H41 N 0 A_GiveInventory("Handyman_AltFallF_P")
6H41 N 1 A_ReFire("QuakeBoostUp")
loop
QuakeDownA:
6H41 N 0 A_JumpIf(z-floorz==0, "QuakeCrash")
6H41 N 0 A_JumpIfInventory("HandyFlag",999,"QuakeCrash")
6H41 N 0 A_GiveInventory("Handyman_AltFallA_P")
6H41 N 1 A_ReFire("QuakeBoostDown")
loop

QuakeBoostUp:
6H41 N 1 Offset(0,29)A_GiveInventory("Handyman_AltBoostUp_P")
goto QuakeDownF
QuakeBoostDown:
6H41 N 1 Offset(0,35)A_GiveInventory("Handyman_AltBoostDown_P")
goto QuakeDownA

QuakeCrash:
6H41 M 0 A_GiveInventory("Handyman_FloorQuake_P")
6H41 M 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY|WRF_NOSECONDARY)
6H41 MO 1
6H41 OO 1 A_TakeInventory("HandyFlag")
6H41 OOO 1
6H41 P 0 A_GiveInventory("VivifyDelay4",1)
6H41 P 0 A_GiveInventory("LadderEnable",1)
6H41 P 3 //ThrustThingZ(0,30,0,0)
6H41 Q 3
Goto Ready2

/*
TNT1 A 0 Radius_Quake(1,45,0,8,0)
6H41 B 30
Goto Ready2*/
}
}

actor HandyHandAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor HandyFlag : Inventory
{
inventory.amount 1
inventory.maxamount 999
}

actor HandymanBotPowerD : PowerDamage
{
Powerup.Color RedMap
Powerup.Duration -15
damagefactor "HandyHand", 4.0
damagefactor "HandyStun", 4.0
}
actor HandymanBotPowerS : PowerSpeed 
{
Powerup.Duration -15
Speed 1.5
}


actor Handyman_FireAltCheck_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HandyHandAmmo",0,1)
stop
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
stop
}
}

actor Handyman_AltStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("StopShield",1)
TNT1 A 0 A_TakeInventory("HandyFlag")
TNT1 A 0 A_GiveInventory("HandyFlag",1)
TNT1 A 0 A_TakeInventory("HandyHandAmmo",4)
Alt:
TNT1 A 0 A_TakeInventory("JumpCancler")
TNT1 A 0 A_GiveInventory("LadderDisable")
TNT1 A 0 A_PlaySound("weapon/superboost",1)
TNT1 A 0 A_SpawnItemEx("HandyM_BoostStartFX",0,0,0,0,0,0,0,1)
TNT1 A 0 A_Recoil(-4)
TNT1 A 0 ThrustThingZ(0,60,0,0)
stop
}
}

actor Handyman_BoostFX_P : CustomInventory
{
States
{
Pickup://Syncs FX online
TNT1 A 0 A_PlaySound("weapon/superboost",4)
TNT1 A 0 A_SpawnItemEx("HandyM_BoostFX",0,0,-20,0,0,-1,0,1)
stop
}
}

actor Handyman_AltBoost_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(momz<3,2)
TNT1 A 0 A_ChangeVelocity(2,0,1.75,1)
goto P_Ammo
TNT1 A 0 A_Recoil(-2)
TNT1 A 0 ThrustThingZ(0,20,0,0)
goto P_Ammo
P_Ammo:
TNT1 A 0 A_TakeInventory("HandyHandAmmo",2,1)
TNT1 A 0 A_TakeInventory("HandyHandAmmo",2)

TNT1 A 0 A_GiveInventory("Handyman_BoostFX_P")
stop
}
}
actor Handyman_AltBoostUp_P : Handyman_AltBoost_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HandyHandAmmo",1,1)
stop
TNT1 A 0 A_TakeInventory("HandyFlag",1)
TNT1 A 0 ThrustThingZ(0,1+(momz<=1)*15,0,1-(momz<=1))
goto P_Ammo
}
}
actor Handyman_AltBoostDown_P : Handyman_AltBoost_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HandyHandAmmo",1,1)
stop
TNT1 A 0 A_GiveInventory("HandyFlag",2)
TNT1 A 0 A_JumpIf(momz>=1,2)
TNT1 A 0 ThrustThingZ(0,10,1,1)
goto P_Ammo
TNT1 A 0 A_TakeInventory("HandyHandAmmo",8,1)
TNT1 A 0 ThrustThingZ(0,16,1,0)
goto P_Ammo
}
}

actor Handyman_AltFall_P : CustomInventory
{
States
{
Pickup:
Pickup2:
TNT1 A 0 A_SpawnItemEx("HandCrush",0,0,-10,0,0,-10)
TNT1 A 0 //A_Explode(75,32,0,0,32)//This would work well if obituary worked for it
End:
TNT1 A 0 ThrustThingZ(0,1,1,1)
TNT1 A 0 A_GiveInventory("HandyFlag",2)
//TNT1 A 0 A_JumpIfInventory("HandyFlag",15,1)
//stop
TNT1 A 0 A_PlaySound("weapon/hardglitch",1,0.625)
stop

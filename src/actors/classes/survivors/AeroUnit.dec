actor AeroUnit : CustWepClassBase
{
player.scoreIcon "UMUG_31"
player.displayname "AeroUnit"
player.soundclass "AeroUnit"
Player.Maxhealth 750
health 750
player.forwardmove 1.25, 1.25
player.sidemove 1.25, 1.25
player.jumpz 11.5
Player.StartItem "UH_BaseFlagPack"
player.startitem "AeroUnit_W"
player.startitem "TerrorEnergyAmmo", 50

player.startitem "AirJumpLimit", 9
States
{
Spawn: 
SHDE A 0
SHDE B 1
SHDE A 1
Goto Spawn+2
See:
SHDE BCDE 5
Goto Spawn
Missile:
SHDE FFFFFF 1
SHDE GGGGGG 1
goto Spawn+2
ClassPain: SHDE H 0
Goto MegamanPain

ClassDeath:
SHDE H 0
goto MegamanDeath
MegamanDeath0:
SHDE H 19 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
SHDE H 0 A_PlaySound("misc/hugequake",1)
SHDE HHHHHHHHHHHHHH 0 A_SpawnItemEx("TerrorSound0Death",0,0,32,random(-20,20),random(-20,20),random(2,18))
SHDE H 0 A_SpawnItemEx("TerrorSoundXDeath",0,0,32,random(-14,14),random(-14,14),random(2,15))
Goto MegaDeathEnd
MegamanDisintegrate:
SHDE Z 0 A_SpawnItemEx("Corpse_31",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor AeroUnitS : AeroUnit
{
player.scoreIcon "UMUG_S31"
Player.Maxhealth 2750
health 2750
player.forwardmove 1.35, 1.35
player.sidemove 1.35, 1.35
player.jumpz 12.5
player.morphweapon "AeroUnitS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
SHDE H 19 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
SHDE H 0 A_PlaySound("misc/hugequake",1)
SHDE HHHHHHHHHHHHHH 0 A_SpawnItemEx("S_TerrorSound0Death",0,0,32,random(-20,20),random(-20,20),random(2,18))
SHDE H 0 A_SpawnItemEx("S_TerrorSoundXDeath",0,0,32,random(-14,14),random(-14,14),random(2,15))
Goto MegaDeathEnd
}
}

actor Corpse_31:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_31_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_31_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


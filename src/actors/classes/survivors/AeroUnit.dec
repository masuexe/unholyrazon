actor AeroUnit : CustWepClassBase {
  Player.ScoreIcon "UMUG_31"
  Player.DisplayName "AeroUnit"
  Player.SoundClass "AeroUnit"
  Player.MaxHealth 750
  Health 750
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 11.5
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "AeroUnit_W"
  Player.StartItem "TerrorEnergyAmmo", 50

  Player.StartItem "AirJumpLimit", 9
  States {
   Spawn:
    SHDE A 0
    SHDE B 1
    SHDE A 1
    goto Spawn+2
   See:
    SHDE BCDE 5
    goto Spawn
   Missile:
    SHDE FFFFFF 1
    SHDE GGGGGG 1
    goto Spawn+2
   ClassPain:
    SHDE H 0
    goto MegamanPain

   ClassDeath:
    SHDE H 0
    goto MegamanDeath
   MegamanDeath0:
    SHDE H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SHDE H 0 A_PlaySound("misc/hugequake", 1)
    SHDE HHHHHHHHHHHHHH 0 A_SpawnItemEx("TerrorSound0Death", 0, 0, 32, random(-20, 20), random(-20, 20), random(2, 18))
    SHDE H 0 A_SpawnItemEx("TerrorSoundXDeath", 0, 0, 32, random(-14, 14), random(-14, 14), random(2, 15))
    goto MegamanErase
   MegamanDisintegrate:
    SHDE Z 0 A_SpawnItemEx("Corpse_31", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor AeroUnitShiny : AeroUnit {
  Player.ScoreIcon "UMUG_S31"
  Player.MaxHealth 2750
  Health 2750
  Player.ForwardMove 1.35, 1.35
  Player.SideMove 1.35, 1.35
  Player.JumpZ 12.5
  Player.MorphWeapon "AeroUnitShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    SHDE H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SHDE H 0 A_PlaySound("misc/hugequake", 1)
    SHDE HHHHHHHHHHHHHH 0 A_SpawnItemEx("S_TerrorSound0Death", 0, 0, 32, random(-20, 20), random(-20, 20), random(2, 18))
    SHDE H 0 A_SpawnItemEx("S_TerrorSoundXDeath", 0, 0, 32, random(-14, 14), random(-14, 14), random(2, 15))
    goto MegamanDeath
  }
}

actor Corpse_31 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_31_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_31_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_31_0 : BaseCorpseFX {States {Spawn: 1H31 O 350
    goto Spawn2}}
actor Corpse_31_1 : BaseCorpseFX {States {Spawn: 1H31 P 350
    goto Spawn2}}
actor Corpse_31_2 : BaseCorpseFX {States {Spawn: 1H31 Q 350
    goto Spawn2}}
actor Corpse_31_3 : BaseCorpseFX {States {Spawn: 1H31 R 350
    goto Spawn2}}
actor Corpse_31_4 : BaseCorpseFX {States {Spawn: 1H31 S 350
    goto Spawn2}}
actor Corpse_31_5 : BaseCorpseFX {States {Spawn: 1H31 T 350
    goto Spawn2}}
actor Corpse_31_6 : BaseCorpseFX {States {Spawn: 1H31 U 350

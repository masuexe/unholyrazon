actor Igniter_W_ScriptBar : ScriptBar {}

actor Igniter_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 100
Inventory.Pickupmessage "$PU_10"
Obituary "$OB_10W"
Tag "$TAG_Igniter_W"
weapon.ammotype "IgniteEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H10 [ 6
loop

Deselect:
6H10 A 0
goto DeselectSwap
Select:
6H10 A 0
goto SelectSwap

Ready:
6H10 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", IGNITER_DYE)
goto Ready2
Ready2:
6H10 A 2 A_GiveInventory("Igniter_Ready_P")
loop

Fire:
6H10 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H10 B 0 A_GiveInventory("Igniter_Fire_P")
6H10 CBA 4
6H10 A 14 A_GiveInventory("IgniteEnergyAmmo",3)
Goto Ready2

AltFire:
6H10 A 0 A_GiveInventory("VivifyFlag1",1)
6H10 BC 2 A_GiveInventory("Igniter_Alt_P")
Burst:
6H10 BC 2 A_GiveInventory("Igniter_Alt_P")
6H10 B 0 A_ReFire(1)
Goto NoAmmoX
6H10 B 0 A_JumpIfInventory("IgniteEnergyAmmo",1,1)
Goto NoAmmoX
6H10 BC 2 A_GiveInventory("Igniter_Alt_P")
6H10 B 0 A_ReFire(1)
Goto NoAmmoX
6H10 B 0 A_JumpIfInventory("IgniteEnergyAmmo",1,"Burst")
Goto NoAmmoX
NoAmmoX:
6H10 B 4
6H10 A 4 A_TakeInventory("VivifyFlag1")
Goto Ready2

BotFire:
6H10 A 0 A_GiveInventory("IgniteEnergyAmmo",8)
6H10 A 0 A_Jump(16,"BotFire3")
6H10 A 0 A_JumpIfCloser(500,"BotFire2")
6H10 A 0 A_Jump(96,"Burst")
6H10 A 0 A_Jump(24,"BotFire1")
goto Fire+1
BotFire1:
6H10 A 0 A_JumpIfInventory("IgniterFlag",28,2)
6H10 A 2 A_GiveInventory("IgniterFlag",2)
loop
6H10 A 0
goto Fire+1
BotFire2:
6H10 A 0 A_JumpIfCloser(196,"Burst")
goto Fire+1
BotFire3:
6H10 B 0 A_PlaySoundEx("taunt/D_10","Voice")
6H10 BCBCBCBCBC 0 A_GiveInventory("Igniter_Alt_P")
6H10 C 0 A_PlaySound("weapon/firestorm",1)
6H10 CB 4 A_GiveInventory("IgniteEnergyAmmo",25)
6H10 A 18
Goto Ready2

}
}

actor IgniteEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 100
+INVENTORY.IGNORESKILL
}

actor IgniterFlag : Inventory
{
inventory.maxamount 28
}

actor Igniter_Ready_P : CustomInventory
{
States
{
Pickup:
Ready2:
TNT1 A 0 A_JumpIfInventory("IgniteEnergyAmmo",10,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo
Ammo:
TNT1 A 0 A_GiveInventory("IgniteEnergyAmmo",1)
TNT1 A 0 A_JumpIfInventory("IgniterFlag",29,3)
TNT1 A 0 A_GiveInventory("IgniterFlag",1)
TNT1 A 0 A_JumpIfInventory("IgniterFlag",28,"Charged")
TNT1 A 0
stop
Charged:
TNT1 A 0 A_TakeInventory("IgniterFlag",-10)
TNT1 A 0 A_PlaySound("wep/Igniter_Charged",4)
stop
}
}

actor Igniter_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("IgniterFlag",28,"Fire2")//weapon/mbuster
TNT1 A 0 A_PlaySound("misc/dragonbreath",1,0.9)//misc/dragonbreath
TNT1 A 0 A_FireCustomMissile("IgniterShot",0,0,8,0)//
goto End
Fire2:
TNT1 A 0 A_PlaySound("weapon/magmabazooka",1,0.81)
TNT1 A 0 A_FireCustomMissile("IgniterShot2",0,0,8,0)
goto End
End:
TNT1 A 0 A_GiveInventory("IgniteEnergyAmmo",3)
TNT1 A 0 A_TakeInventory("IgniterFlag")
stop
}
}

actor Igniter_Alt_P : CustomInventory
{
States
{//magmaflameloop
Pickup://misc_L/magmaflamestart
TNT1 A 0 A_PlaySound("weapon/firestorm",1)//weapon/mbuster
TNT1 A 0 A_FireCustomMissile("IgniterFlames",frandom(-1,1),0,8,-6,1,frandom(-1,1))//12 7 [] 6 3
goto End
End:
TNT1 A 0 A_TakeInventory("IgniteEnergyAmmo",2,1)
TNT1 A 0 A_TakeInventory("IgniteEnergyAmmo",1)
stop
}
}

actor IgniterShot : BasicProjectile
{
Translation "192:192=220:220", "198:198=46:46"
damagetype "Igniter"
Obituary "$OB_10M1"
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
+BRIGHT
Damage (164)
radius 14
height 14
Speed 60
scale 3.0
Args 100,128,16
States
{
Spawn:
X_1E ABC 2 A_SpawnItemEx("IgniterShotFX",0,frandom(-3,3),frandom(-3,3),0,0,0,0,1)
loop
XDeath:
TNT1 A 0 A_SpawnItemEx("IgniterShotHitFX",0,0,0,0,0,0,0,1)
goto DeathEnd
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAAA 0 A_SpawnItemEx("IgniterShotBit",0,0,0,random(1,15),0,random(1,15)*Args[4],random(0,359),1)
goto DeathEnd
DeathEnd:
TNT1 A 0 A_PlaySoundEx("wep_L/Igniter_Boom","Weapon")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}

actor IgniterShotFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
States
{
Spawn:
TNT1 A 2
TNT1 A 0 A_Jump(16,"HexWra")
TNT1 A 0 A_Jump(256,1,4,7)
X_9G RUV 2
stop
X_9G SUV 2
stop
X_9G TUV 2
stop
HexWra:
6P10 UVW 2
stop
//X_1E EEEEFFFF 1 A_FadeOut
}
}

actor IgniterShot2 : IgniterShot
{
Damage (328)
//scale 2.5
Args 200,128,16
States
{
Spawn:
//X_9G ABCDEF 2
X_9G GHIJKL 2 A_SpawnItemEx("IgniterShotFX",0,frandom(-3,3),frandom(-3,3),0,0,0,0,1)
loop
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("IgniterShotBit",0,0,0,random(1,20),0,random(1,20)*Args[4],random(0,359),1)
goto DeathEnd
}
}


actor IgniterShotHitFX : BasicClientSide
{
Args 8
States
{
Spawn:
TNT1 A 0
SpawnL:
TNT1 A 0 A_SpawnItemEx("IgniterShotHitFX2",0,0,0,0,cos(Args[0]*45),sin(Args[0]*45),0,1+SXF_MULTIPLYSPEED)//8192
TNT1 A 0 A_CountDownArg(0)
loop
Death:
TNT1 A 1
stop
}
}
actor IgniterShotHitFX2 : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
Speed 5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,6,11)
X_9G RSTUV random(1,2)
stop
X_9G STRUV random(1,2)
stop
X_9G TRSUV random(1,2)
stop
}
}

actor IgniterShotBit : BasicProjectile
{
Obituary "$OB_10M2"
damagetype "Igniter"
-NOGRAVITY
+DONTSPLASH
+SKYEXPLODE
+FORCEXYBILLBOARD
+BRIGHT
//+CANBOUNCEWATER
+BOUNCEONFLOORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
WALLBOUNCEFACTOR 0.8
BOUNCEFACTOR 0.35
BounceCount 10
ReactionTime 2//3
damage (75)
Radius 13
Height 13
Speed 45
scale 2.5
states
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(128,"Flip")
TNT1 A 0 A_Jump(256,1,2,3,4,5)
6P10 M 10
goto SpawnL
6P10 N 10
goto SpawnL
6P10 O 10
goto SpawnL
6P10 P 10
goto SpawnL
6P10 Q 10
goto SpawnL
Flip:
TNT1 A 0 A_SetScale(-ScaleX,ScaleY)
goto Spawn+2
SpawnL:
"----" "#" 0 A_CountDown
"----" "###################################" 2 A_SpawnItemEx("IgniterShotBitFX",random(-4,4),random(-4,4),random(-4,4),frandom(-1,1),frandom(-1,1),frandom(0,2),0,1)
loop

XDeath:
TNT1 A 0 A_PlaySoundEx("weapon/coilexplode","Voice")
goto Death+1
Death:
TNT1 A 0 A_SpawnItemEx("IgniterShotBitFX2",0,0,8,0,0,0,0,1)
TNT1 A 1 A_SpawnItemEx("OilPitIgnite",0,0,8)
stop
}
}

actor IgniterShotBitFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
RenderStyle Translucent
alpha 0.5
scale 1.0
states
{
Spawn:
TNT1 A 0
TNT1 A random(0,3) A_SetScale(ScaleX+random(0,8)*-0.05)
X_9G RSTRSTUV 2 ThrustThingZ(0,random(1,3),0,1)
stop
SpawnL:
TNT1 A 0 A_Jump(256,1,3,5,7)
6P10 A 1 ThrustThingZ(0,random(1,3),0,1)
6P10 A 1 A_FadeOut(0.05)
6P10 B 1 ThrustThingZ(0,random(1,3),0,1)
6P10 B 1 A_FadeOut(0.05)
6P10 C 1 ThrustThingZ(0,random(1,3),0,1)
6P10 C 1 A_FadeOut(0.05)
6P10 D 1 ThrustThingZ(0,random(1,3),0,1)
6P10 D 1 A_FadeOut(0.05)
goto SpawnL+1
}
}

actor IgniterShotBitFX2 : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
states
{
Spawn:
X_1E E 0
X_1E EF 2
TMFX D 2
stop
}
}

actor IgniterFlames : BasicProjectile
{
Translation "192:192=220:220","198:198=46:46"
Obituary "$OB_10A1"
damagetype "Igniter"
+FORCEXYBILLBOARD
+BRIGHT
+BLOODLESSIMPACT
+EXPLODEONWATER
+SKYEXPLODE
+VISIBILITYPULSE
renderstyle Translucent//add
alpha 0.2
damage (92)//20 ripp
Radius 14
Height 14
Speed 45//30
scale 2.5
Args 35
states
{
Spawn:
//6P10 ABCDA 2 A_FadeTo(0.3,0.1,0)
//6P10 BCDAB 2 A_FadeTo(0.8,0.1,0)
//6P10 CDABC 2 A_FadeTo(0.3,0.1,0)
//6P10 DABCD 2 A_FadeTo(0.8,0.1,0)


6P10 E 0
6P10 E 0 A_Jump(256,1,2,3,4)
SpawnL:
6P10 EF 2
6P10 E 0 A_CountDownArg(0)
6P10 E 0 A_JumpIf(Args[0]<6,"SpawnLow")
loop
SpawnLow:
6P10 GH 2
6P10 G 0 A_CountDownArg(0)
loop

XDeath:
TNT1 AA 0 A_SpawnItemEx("IgniterFlamesHitFX",random2(10),random2(10),random(2,48),random(2,10),random(2,10),random(2,10),random(0,359),1)
TNT1 A 1
stop
Death:
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_JumpIf(Args[0]<=0,"DeathFX")
TNT1 A 0 A_SpawnItemEx("IgniterFlamesSit",0,0,0,0,0,0,0,1+SXF_TRANSFERSPECIAL)//32768
TNT1 A 1
stop
DeathFX:
X_9G UV 2
stop
}
}


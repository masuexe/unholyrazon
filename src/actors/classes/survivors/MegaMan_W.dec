actor MegaManU_W_NormalBar : NormalBar {Args 192,198}

actor MegaManU_W : BaseMM8BDMWep_UH {
    Weapon.AmmoUse 28
    Weapon.AmmoGive 28
    Weapon.SlotNumber 1
    Obituary "$OB_00W"
    Tag "$TAG_Megaman_W"
    Inventory.Pickupmessage "You got the Charge Buster!"
    weapon.ammotype "RockNRollAmmo"
    //inventory.icon "6H00[0"
    States {
        Spawn:
            6H00 [ 6
            loop

        Deselect:
            BUST B 0
            goto DeselectSwap
        Select:
            BUST B 0
            goto SelectSwap

        Ready:
            BUST B 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0)
            BUST B 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
            Goto Ready2
        Ready2:
            BUST B 0 A_JumpIfInventory("RockNRollAmmo",0,"Ready3")
            BUST B 1 A_WeaponReady(WRF_NOSECONDARY)
            loop
        Ready3:
            BUST B 7 A_WeaponReady
            wait

        Altfire:
            BUST B 0 A_PlaySoundEx("mmWilyWars/MegaRemoveWep", "Weapon")
            BUST B 0 A_GiveInventory("VivifyDelay3")
            BUST B 0 A_Refire(1)
            6H00 MNOPQRSTU 2
            TNT1 A 16 A_TakeInventory("NoWeaponsBusterOnlyFinalFlag")
            TNT1 A 0 A_PlaySoundEx("mmWilyWars/MegaGainWep", "Weapon")
            TNT1 A 0 A_TakeInventory("RockNRollAmmo")
            TNT1 A 2 ACS_NamedExecuteWithResult("uh_MegamanWeapons")
            BUST B 2 Offset(20,87)
            BUST B 2 Offset(14,68)
            BUST B 2 Offset(9,54)A_SpawnItemEx("UnholyMegaAmmoRestore_H")
            BUST B 2 Offset(5,44)
            BUST B 2 Offset(2,37)
            goto Ready2

        Fire:
        Fire1:
            BUST C 0 A_GiveInventory("U_Megaman_Fire1_P")
            BUST CD 2
            BUST B 0 A_Refire("ChargeStart")
            goto Ready2
        Fire2:
            BUST C 0 A_GiveInventory("U_Megaman_Fire2_P")
            BUST CDC 2
            BUST B 0 A_Refire("ChargeStart")
            goto Ready2
        Fire3:
            BUST C 0 A_GiveInventory("U_Megaman_Fire3_P")
            BUST CDDCB 3
            BUST B 0 A_Refire("ChargeStart")
            goto Ready2
        Fire4:
            BUST C 0 A_GiveInventory("U_Megaman_Fire4_P")
            BUST CDDCB 3
            BUST B 0 A_Refire("ChargeStart")
            goto Ready2

        ChargeStart:
            // BUST B 0 A_GiveInventory("WeaponCharge")
        Charge0:
            BUST B 0 A_GiveInventory("WeaponCharge")
            BUST B 1 A_JumpIfInventory("WeaponCharge",18,"Charge1_Snd")
            BUST B 0 A_Refire("Charge0")
            Goto Ready2+1

        Charge1_Snd:
            CHBU H 0 A_PlaySound("weapon/coilstart",1)
        Charge1:
            CHBU B 0 A_GiveInventory("WeaponCharge")
            CHBU H 0 A_JumpIfInventory("WeaponCharge",56,"Charge2_Snd")
            CHBU H 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MEGACHARGE1,TCLR_CHARGE1)
            CHBU H 0 A_Refire(1)
            Goto Fire2
            BUST B 0 A_GiveInventory("WeaponCharge")
            BUST B 0 A_JumpIfInventory("WeaponCharge",56,"Charge2_Snd")
            BUST B 1 ACS_NamedExecuteWithResult("core_chargecolor",0,TCLR_NONE)
            BUST B 0 A_Refire("Charge1")
            Goto Fire2

        Charge2_Snd:
            CHBU I 0 A_GunFlash("Flash.Charge2",1)
        Charge2:
            CHBU I 0 A_GiveInventory("WeaponCharge")
            CHBU I 0 A_JumpIfInventory("WeaponCharge",440,"Charge3_Snd")
            CHBU I 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MEGACHARGE2,TCLR_CHARGE2)
            CHBU I 0 A_Refire(1)
            Goto Fire3
            CHBU J 0 A_GiveInventory("WeaponCharge")
            CHBU J 0 A_JumpIfInventory("WeaponCharge",440,"Charge3_Snd")
            CHBU J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MEGACHARGE3,TCLR_CHARGE3)
            CHBU J 0 A_Refire(1)
            Goto Fire3
            BUST B 0 A_GiveInventory("WeaponCharge")
            BUST B 0 A_JumpIfInventory("WeaponCharge",440,"Charge3_Snd")
            BUST B 1 ACS_NamedExecuteWithResult("core_chargecolor",0,TCLR_NONE)
            BUST B 0 A_JumpIfInventory("IsBot",1,"BotCharge2")
            BUST B 0 A_Refire("Charge2")
            Goto Fire3
        BotCharge2:
            MKIC A 0 A_Jump(16,"Fire3")
            MKIC A 0 A_Refire("Charge2")
            Goto Fire3

        Charge3_Snd:
            CHBU I 0 A_GunFlash("Flash.Charge3",1)
        Charge3:
            CHBU I 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MEGACHARGE2,TCLR_CHARGE2)
            CHBU I 0 A_Refire(1)
            Goto Fire3
            CHBU J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MEGACHARGE3,TCLR_CHARGE3)
            CHBU J 0 A_Refire(1)
            Goto Fire3
            BUST B 1 ACS_NamedExecuteWithResult("core_chargecolor",0,TCLR_NONE)
            BUST B 0 A_JumpIfInventory("IsBot",1,"BotCharge3")
            BUST B 0 A_Refire("Charge3")
            Goto Fire3
        BotCharge3:
            MKIC A 0 A_Jump(128,"Fire4")
            MKIC A 0 A_Refire("Charge2")
            Goto Fire4

        Flash.Charge1:
            TNT1 A 6 A_RailWait
            TNT1 A 0 A_JumpIfInventory("WeaponCharge",40,"Flash.Charge2")
            stop
        Flash.Charge2:
            TNT1 A 7 A_PlaySound("weapon/MM5Charge",1)
            TNT1 A 0 A_JumpIfInventory("WeaponCharge",40,1)
            stop
            TNT1 A 7 A_RailWait
            TNT1 A 0 A_JumpIfInventory("WeaponCharge",40,"Flash.Charge2")
            stop
        Flash.Charge3:
            TNT1 A 7 A_PlaySound("weapon/overcharge",1)
            TNT1 A 0 A_JumpIfInventory("WeaponCharge",440,1)
            stop
            TNT1 A 7 A_RailWait
            TNT1 A 0 A_JumpIfInventory("WeaponCharge",440,"Flash.Charge3")
            stop

    }
}

actor NoWeaponsBusterOnlyFinalFlag : Inventory
{
+INVENTORY.UNDROPPABLE
}

//Actor MegaFlagU : Inventory{}

actor RockNRollAmmo : Ammo
{
Inventory.Amount 1
Inventory.maxamount 28
+INVENTORY.IGNORESKILL
}

actor UnholyMegaAmmoRestore_H : BasicHelper
{
+SERVERSIDEONLY
+NOTIMEFREEZE
ReactionTime 28
States
{
Spawn:
TNT1 A 17 A_JumpIf(CallACS("uh_PointerExists",2)==0,"Death")
TNT1 A 0 A_JumpIf(CallACS("core_checkrune",RUNE_RAGE,2),2)
TNT1 A 17 A_JumpIf(CallACS("uh_PointerExists",2)==0,"Death")
TNT1 A 0 A_GiveToTarget("RockNRollAmmo",1)
TNT1 A 0 A_CountDown
loop
}
}

actor U_Megaman_Fire1_P : CustomInventory
{
States
{
Pickup:
Fire1:
TNT1 A 0 A_PlaySoundEx("weapons/busters/megabusterfire", "Weapon")
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,2)
TNT1 A 0 A_FireCustomMissile("MegaShotU",0,0,8,0)
goto Reset
TNT1 A 0 A_FireCustomMissile("MegaShotU",0,0,8,0)
goto Reset

Reset2:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
Reset:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_GunFlash(1,1)
TNT1 A 0
stop
}
}
actor U_Megaman_Fire2_P : U_Megaman_Fire1_P
{
States
{
Pickup:
Fire2:
TNT1 A 0 A_PlaySoundEx("weapon/minchrgshot", "Weapon")
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,2)
TNT1 A 0 A_FireCustomMissile("MegaMidShotU",0,0,8,0)
goto Reset2
TNT1 A 0 A_FireCustomMissile("MegaMidShotU",0,0,8,0)
goto Reset2
}
}
actor U_Megaman_Fire3_P : U_Megaman_Fire1_P
{
States
{
Pickup:
Fire3:
TNT1 A 0 A_PlaySoundEx("weapon/cfire", "Weapon")
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*12,0,sin(pitch)*7,CVF_RELATIVE)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,4)
TNT1 AAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
TNT1 AAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
}
}
actor U_Megaman_Fire4_P : U_Megaman_Fire1_P
{
States
{
Pickup:
Fire4:
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*36,0,sin(pitch)*21,CVF_RELATIVE)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,8)
TNT1 AAAAAAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
TNT1 AAAAAAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
}
}


actor MegaShotU : BasicProjectile
{
damagetype "Buster"
Obituary "$OB_MEGABUSTER"
Damage (100)//50
radius 8
height 8
Speed 38
States
{
Spawn:
TNT1 A 2
BUST A 1
wait
Death:
TNT1 A 1
stop
}
}

actor MegaMidShotU : MegaShotU
{
Damage (100)
radius 15
height 15
Speed 42
States
{
Spawn:
TNT1 A 2
MBUS AB 2
Goto Spawn+1
}
}

actor ChargeShotU : MegaShotU
{
Damage (95)
radius 22
height 22
Speed 55
scale 3.5
States
{
Spawn:
CHBU ABCD 2
loop
}
}
//Obituary "$OB_00M"

#include "actors/classes/survivors/megaman_copyweps/_copywepgeneral.dec"

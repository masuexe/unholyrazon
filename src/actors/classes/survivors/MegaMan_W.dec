actor MegaMan_W_NormalBar : NormalBar {Args 192,198}

actor MegaMan_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 28
Weapon.AmmoGive 28
Weapon.SlotNumber 1
Obituary "$OB_00W"
Tag "$TAG_Megaman_W"
Inventory.Pickupmessage "You got the Charge Buster!"
weapon.ammotype "RockNRollAmmo"
//inventory.icon "6H00[0"
States
{
Spawn:
6H00 [ 6
loop

Deselect:
BUST B 0
goto DeselectSwap
Select:
BUST B 0
goto SelectSwap

Ready:
BUST B 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0)
BUST B 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
Goto Ready2
Ready2:
BUST B 0 A_JumpIfInventory("RockNRollAmmo",0,"Ready3")
BUST B 1 A_WeaponReady(WRF_NOSECONDARY)
loop
Ready3:
BUST B 7 A_WeaponReady
wait

Altfire:
BUST B 0 A_PlaySound("mmWilyWars/MegaRemoveWep",1)
6H00 MNOPQRSTU 2
TNT1 A 16 A_TakeInventory("NoWeaponsBusterOnlyFinalFlag")
TNT1 A 0 A_PlaySound("mmWilyWars/MegaGainWep",1)
TNT1 A 0 A_TakeInventory("RockNRollAmmo")
TNT1 A 2 ACS_NamedExecuteWithResult("uh_MegamanWeapons")
BUST B 2 Offset(20,87)
BUST B 2 Offset(14,68)
BUST B 2 Offset(9,54)A_SpawnItemEx("UnholyMegaAmmoRestore_H")
BUST B 2 Offset(5,44)
BUST B 2 Offset(2,37)
goto Ready2

Fire1:
BUST C 0 A_GiveInventory("U_Megaman_Fire1_P")
BUST CD 2
BUST B 0
BUST B 0 A_Refire("Charge")
goto Ready2
Fire2:
BUST C 0 A_GiveInventory("U_Megaman_Fire2_P")
BUST CD 3
BUST B 0 A_Refire("Charge")
goto Ready2
Fire3:
BUST C 0 A_GiveInventory("U_Megaman_Fire3_P")
BUST CCDCB 3
BUST B 0 A_Refire("Charge")
goto Ready2

Flash:
TNT1 A 2 A_GiveInventory("U_Megaman_Flash_P")
loop

Fire:
Charge:
BUST B 0 A_TakeInventory("WeaponCharge")
BUST B 0 A_GunFlash("Flash",1)
goto Charge0
Charge0:
BUST B 1 A_JumpIfInventory("WeaponCharge",9,2)
BUST B 0 A_Refire("Charge0")
goto Fire1
BUST B 0 A_PlaySound("weapon/coilstart",1)
Goto Charge1

Charge1:
CHBU H 0 A_JumpIfInventory("WeaponCharge",28,"Charge2")
CHBU H 1 ACS_NamedExecuteWithResult("core_weaponcolor", 92, true)
BUST B 0 A_Refire(1)
goto Fire2
BUST B 0 A_JumpIfInventory("WeaponCharge",28,"Charge2")
BUST B 1 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
CHBU H 0 A_Refire("Charge1")
goto Fire2

Charge2:
BUST B 1 ACS_NamedExecuteWithResult("core_weaponcolor", 93, true)
CHBU I 0 A_Refire(1)
goto Fire3
CHBU I 1 ACS_NamedExecuteWithResult("core_weaponcolor", 94, true)
CHBU J 0 A_Refire(1)
goto Fire3
CHBU J 1 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
BUST B 0 A_Refire("Charge2")
goto Fire3

Charge3:
BUST B 0 //A_JumpIfInventory("MegaFlagU",1,"Charge2")
BUST B 0 //A_GiveInventory("MegaFlagU",1)
BUST B 0 ////A_GiveInventory("TheTrueExit",1)
BUST B 35 A_PlaySoundEx("Contra/C_POWUP", "Item")
goto Charge3

}
}

actor NoWeaponsBusterOnlyFinalFlag : Inventory
{
+INVENTORY.UNDROPPABLE
}

//Actor MegaFlagU : Inventory{}

actor RockNRollAmmo : Ammo
{
Inventory.Amount 1
Inventory.maxamount 28
+INVENTORY.IGNORESKILL
}

actor UnholyMegaAmmoRestore_H : BasicHelper
{
+SERVERSIDEONLY
+NOTIMEFREEZE
ReactionTime 28
States
{
Spawn:
TNT1 A 17 A_JumpIf(CallACS("uh_PointerExists",2)==0,"Death")
TNT1 A 0 A_JumpIf(CallACS("core_checkrune",RUNE_RAGE,2),2)
TNT1 A 17 A_JumpIf(CallACS("uh_PointerExists",2)==0,"Death")
TNT1 A 0 A_GiveToTarget("RockNRollAmmo",1)
TNT1 A 0 A_CountDown
loop
}
}

actor U_Megaman_Flash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("WeaponCharge",1)
TNT1 A 0 A_JumpIfInventory("WeaponCharge",221,4)
TNT1 A 0 A_JumpIfInventory("WeaponCharge",220,"Snd2")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",29,2)
TNT1 A 0 A_JumpIfInventory("WeaponCharge",28,"Snd1")
TNT1 A 0
stop
Snd1:
TNT1 A 0 A_PlaySound("weapon/coilcharge",1,1.0,true)
stop
Snd2:
TNT1 A 0 A_PlaySound("weapon/overcharge",1,1.0,true)
stop
}
}

actor U_Megaman_Fire1_P : CustomInventory
{
States
{
Pickup:
Fire1:
TNT1 A 0 A_PlaySound("weapon/mbuster",1)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,2)
TNT1 A 0 A_FireCustomMissile("MegaShotU",0,0,8,0)
goto Reset
TNT1 A 0 A_FireCustomMissile("MegaShotU",0,0,8,0)
goto Reset

Reset2:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", 0, true)
Reset:
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_GunFlash(1,1)
TNT1 A 0
stop
}
}
actor U_Megaman_Fire2_P : U_Megaman_Fire1_P
{
States
{
Pickup:
Fire2:
TNT1 A 0 A_PlaySound("weapon/minchrgshot",1)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,2)
TNT1 A 0 A_FireCustomMissile("MegaMidShotU",0,0,8,0)
goto Reset2
TNT1 A 0 A_FireCustomMissile("MegaMidShotU",0,0,8,0)
goto Reset2
}
}
actor U_Megaman_Fire3_P : U_Megaman_Fire1_P
{
States
{
Pickup:
Fire3:
TNT1 A 0 A_PlaySound("weapon/cfire",1)
TNT1 A 0 A_JumpIfInventory("WeaponCharge",220,"Fire4")
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*12,0,sin(pitch)*7,CVF_RELATIVE)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,4)
TNT1 AAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
TNT1 AAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
Fire4:
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*36,0,sin(pitch)*21,CVF_RELATIVE)
TNT1 A 0 A_JumpIfInventory("NoWeaponsBusterOnlyFinalFlag",1,8)
TNT1 AAAAAAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
TNT1 AAAAAAA 0 A_FireCustomMissile("ChargeShotU",0,0,8,0)
goto Reset2
}
}


actor MegaShotU : BasicProjectile
{
damagetype "Buster"
Obituary "$OB_MEGABUSTER"
Damage (100)//50
radius 8
height 8
Speed 38
States
{
Spawn:
TNT1 A 2
BUST A 1
wait
Death:
TNT1 A 1
stop
}
}

actor MegaMidShotU : MegaShotU
{
Damage (100)
radius 15
height 15
Speed 42
States
{
Spawn:
TNT1 A 2
MBUS AB 2
Goto Spawn+1
}
}

actor ChargeShotU : MegaShotU
{
Damage (95)
radius 22
height 22
Speed 55
scale 3.5
States
{
Spawn:
CHBU ABCD 2
loop
}
}
//Obituary "$OB_00M"

#include "actors/classes/survivors/megamancopyweps/_includes.dec"

actor BeerManS_W_NormalBar : NormalBar {args 170, 175}

actor BeerManS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_BeerMan_W"
Weapon.AmmoUse 2
Inventory.Pickupmessage "$PU_25"
Obituary "$OB_25W"
weapon.ammotype "DrunkEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H25 [ 6
loop

Deselect:
7H25 A 0
goto DeselectSwap
Select:
7H25 A 0
goto SelectSwap

Ready:
7H25 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BEERMAN_SDYE)
Goto Ready2
Ready2:
7H25 A 18 A_WeaponReady
Spawn3:
7H25 R 0 A_JumpIfInventory("DrunkEnergyAmmo",0,5)
7H25 RSTU 2 A_GiveInventory("Beerman_Ready_P")
loop
7H25 VWXYZYXWV 2 A_GiveInventory("Beerman_Ready_P")
7H25 A 8 A_GiveInventory("Beerman_Ready_P")
wait

Fire:
7H25 B 2 A_JumpIfInventory("IsBot",1,"BotFire")
FireH:
7H25 D 2 A_GiveInventory("S_Beerman_Fire2_P")
7H25 B 0 A_Refire(1)
goto FireEnd
7H25 D 2 A_GiveInventory("S_Beerman_Fire1_P")
7H25 B 0 A_Refire(1)
goto FireEnd
7H25 D 2 A_GiveInventory("S_Beerman_Fire2_P")
7H25 B 0 A_Refire(1)
goto FireEnd
7H25 D 2 A_GiveInventory("S_Beerman_Fire3_P")
7H25 B 0 A_Refire("FireH")
goto FireEnd
FireEnd:
7H25 BA 2
Goto Ready2

AltFire:
7H25 F 0 A_GiveInventory("VivifyFlag1")
7H25 F 0 A_Refire(1)
7H25 F 2 A_JumpIfInventory("IsBot",1,"BotAlt2")
AltFireH:
7H25 G 2 A_GiveInventory("S_Beerman_Alt_P")
7H25 F 0 A_Refire("AltFireH")
goto AltEnd
AltEnd:
7H25 F 2 A_TakeInventory("VivifyFlag1")
Goto Ready2

BotFire:
7H25 A 0 A_JumpIfNoAmmo("BotReload")
7H25 A 0 A_JumpIfInventory("DrunkEnergyAmmo",200,"BotFire2")
7H25 A 0 A_Jump(16,"BotFireX")
7H25 A 0 A_Jump(32,1)
goto BotFire1
7H25 A 0 A_Jump(32,"BotAlt2")
7H25 A 0 A_Jump(128,"BotAlt1")
7H25 A 0 A_GiveInventory("DrunkEnergyAmmo",40)
goto BotFire1

BotReload:
7H25 A 0 A_PlaySoundEx("weapon/pursuitfire","Weapon")
7H25 A 4 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
7H25 VWXYZZYXWV 2 A_GiveInventory("DrunkEnergyAmmo",20)
7H25 A 4 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
7H25 A 0 A_ReFire("BotAlt2")
Goto Ready2

BotFireX:
7H25 A 0 A_SpawnItemEx("HSH_DustBoostFX")
7H25 A 0 A_PlaySoundEx("taunt/D_25","Voice")
7H25 A 0 A_TakeInventory("DrunkEnergyAmmo",20)
7H25 A 0 A_FireCustomMissile("S_Beerman_TheBeer",-20,0,0,0,0,1)
7H25 A 0 A_FireCustomMissile("S_Beerman_TheBeer",20,0,0,0,0,1)
goto BotAlt2

BotFire1:
7H25 B 0 A_Jump(4,3,3,"BotFire2")
7H25 D 2 A_GiveInventory("S_Beerman_Fire2_P")
7H25 B 0 A_ReFire("BotFire1")
7H25 B 2
Goto Ready2
BotFire2:
7H25 A 0 A_Jump(8,6)
7H25 B 0 A_FireCustomMissile("S_Beerman_DrunkShot",random(-2,2),0,random(-8,8),0)
7H25 D 0 A_TakeInventory("DrunkEnergyAmmo",4)
7H25 BD 2
7H25 B 0 A_ReFire("BotFire2")
7H25 B 2
Goto Ready2

BotAlt1:
7H25 B 0 A_Jump(4,3)
7H25 D 2 A_GiveInventory("S_Beerman_Alt_P")
7H25 B 2 A_ReFire("BotAlt1")
Goto Ready2
7H25 B 0 A_Jump(128,1)
Goto Ready2
BotAlt2:
7H25 B 0 A_TakeInventory("DrunkEnergyAmmo",20,1)
7H25 C 0 A_FireCustomMissile("S_Beerman_TheBeer",0,0,0,0,0,1)
7H25 B 2
7H25 CDCD 2
7H25 A 6
Goto Ready2
}
}

actor S_Beerman_Fire1_P : Beerman_Fire1_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("DrunkEnergyAmmo",1,"Hose")
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray0",cos(-pitch)*14,-10,32+(sin(-pitch)*14),20*cos(-pitch)+4,0,20*sin(-pitch)+3,0,32)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
goto Snd
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray0",cos(-pitch)*14,-10,32+(sin(-pitch)*14),20*cos(-pitch)+4,0,20*sin(-pitch)+3,15,32)
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray0",cos(-pitch)*14,-10,32+(sin(-pitch)*14),20*cos(-pitch)+4,0,20*sin(-pitch)+3,-15,32)
goto Snd

Hose:
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray",cos(-pitch)*14,-10,32+(sin(-pitch)*14),(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*cos(-pitch)+4,0,(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*sin(-pitch)+3,0,32)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),1)
goto Ammo
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray",cos(-pitch)*14,-10,32+(sin(-pitch)*14),(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*cos(-pitch)+4,0,(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*sin(-pitch)+3,15,32)
TNT1 A 0 A_SpawnItemEx("S_Beerman_Spray",cos(-pitch)*14,-10,32+(sin(-pitch)*14),(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*cos(-pitch)+4,0,(CallACS("uc_countinv_acs",25,0)/200.0f*40.0f+20)*sin(-pitch)+3,-15,32)
goto Ammo
}
}

actor CloseCombatUnit : CustWepClassBase {
  Player.ScoreIcon "UMUG_11"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "CloseCombatUnit"
  Player.SoundClass "CloseCombatUnit"
  Player.MaxHealth 1100
  Health 1100
  Player.ForwardMove 0.85, 0.85
  Player.SideMove 0.85, 0.85
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "CloseCombatUnit_W"
  Player.StartItem "MeleeEnergyAmmo", 25
  States {
   Spawn:
    1H11 A 0
    1H11 B 1
    1H11 A 1
    goto Spawn+2
   See:
    1H11 BCDE 5
    goto Spawn
   SeeM:
    1H11 BCDE 3
    1H11 B 0 A_JumpIfInventory("CCUPowerSpeed", 1, "SeeM")
    1H11 BCDE 3
    goto Spawn
   Missile:
    1H11 F 5 A_JumpIfInventory("VivifyDelay1", 1, "SeeM")
    1H11 G 5
    goto Spawn+2
   ClassPain:
    1H11 H 0
    goto MegamanPain

   ClassDeath:
    1H11 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H11 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H11 H 19 A_GiveInventory("CloseCombatUnitDeath_P")
    1H11 H 0 A_SpawnItemEx("CloseCombatUnitDeathBoom", 20, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanFade
   MegamanDisintegrate:
    1H11 Z 0 A_SpawnItemEx("Corpse_11", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor CloseCombatUnitDeath_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep_L/mm4/drillbombexplode", 1)
    TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorX", 20, 0, 28, 0, 0, 0, 0, 1)
    TNT1 A 0 A_ChangeVelocity(-15, 0, 10, 3)
    stop
  }
}

actor CloseCombatUnitDeathBoom : BasicExplosion {
  DamageType "Combat"
  Obituary "$OB_11D"
  Args 250, 158, 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_PlaySound("wep_L/mm4/drillbombexplode", 1)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_CloseCombatUnitDeathBoom : CloseCombatUnitDeathBoom {
  Args 375, 158, 0
}


actor CloseCombatUnitShiny : CloseCombatUnit {
  Player.ScoreIcon "UMUG_S11"
  Player.MaxHealth 3100
  Health 3100
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 11
  Player.MorphWeapon "CloseCombatUnitShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H11 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H11 H 19 A_GiveInventory("CloseCombatUnitDeath_P")
    1H11 H 0 A_SpawnItemEx("S_CloseCombatUnitDeathBoom", 20, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanFade
  }
}

actor Corpse_11 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_11_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_11_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_11_0 : BaseCorpseFX {States {Spawn: 1H11 O 350
    goto Spawn2}}
actor Corpse_11_1 : BaseCorpseFX {States {Spawn: 1H11 P 350
    goto Spawn2}}
actor Corpse_11_2 : BaseCorpseFX {States {Spawn: 1H11 Q 350
    goto Spawn2}}
actor Corpse_11_3 : BaseCorpseFX {States {Spawn: 1H11 R 350
    goto Spawn2}}
actor Corpse_11_4 : BaseCorpseFX {States {Spawn: 1H11 S 350
    goto Spawn2}}
actor Corpse_11_5 : BaseCorpseFX {States {Spawn: 1H11 T 350
    goto Spawn2}}
actor Corpse_11_6 : BaseCorpseFX {States {Spawn: 1H11 U 350
    goto Spawn2}}

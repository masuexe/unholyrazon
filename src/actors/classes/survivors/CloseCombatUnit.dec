actor CloseCombatUnit : CustWepClassBase
{
player.scoreIcon "UMUG_11"
player.displayname "CloseCombatUnit"
player.soundclass "CloseCombatUnit"
player.maxhealth 1100
health 1100
player.forwardmove 0.85, 0.85
player.sidemove 0.85, 0.85
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "CloseCombatUnit_W"
player.startitem "MeleeEnergyAmmo", 25
States
{
Spawn:
1H11 A 0
1H11 B 1
1H11 A 1
Goto Spawn+2
See:
1H11 BCDE 5 
Goto Spawn
SeeM:
1H11 BCDE 3
1H11 B 0 A_JumpIfInventory("CCUPowerSpeed",1,"SeeM")
1H11 BCDE 3
Goto Spawn
Missile:
1H11 F 5 A_JumpIfInventory("VivifyDelay1",1,"SeeM")
1H11 G 5
goto Spawn+2
ClassPain:
1H11 H 0
Goto MegamanPain

ClassDeath:
1H11 H 0
goto MegamanDeath
MegamanDeath0:
1H11 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H11 H 19 A_GiveInventory("CloseCombatUnitDeath_P")
1H11 H 0 A_SpawnItemEx("CloseCombatUnitDeathBoom",20,0,28,0,0,0,0,1)
Goto MegamanFade
MegamanDisintegrate:
1H11 Z 0 A_SpawnItemEx("Corpse_11",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}

actor CloseCombatUnitDeath_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/mm4/drillbombexplode",1)
TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorX",20,0,28,0,0,0,0,1)
TNT1 A 0 A_ChangeVelocity(-15,0,10,3)
stop
}
}

actor CloseCombatUnitDeathBoom : BasicExplosion
{
Damagetype "Combat"
Obituary "$OB_11D"
Args 250,158,0
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 0 A_PlaySound("wep_L/mm4/drillbombexplode",1)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}
actor S_CloseCombatUnitDeathBoom : CloseCombatUnitDeathBoom
{
Args 375,158,0
}


actor CloseCombatUnitS : CloseCombatUnit
{
player.scoreIcon "UMUG_S11"
player.maxhealth 3100
health 3100
player.forwardmove 0.95, 0.95
player.sidemove 0.95, 0.95
player.jumpz 11
player.morphweapon "CloseCombatUnitS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
1H11 H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H11 H 19 A_GiveInventory("CloseCombatUnitDeath_P")
1H11 H 0 A_SpawnItemEx("S_CloseCombatUnitDeathBoom",20,0,28,0,0,0,0,1)
Goto MegamanFade
}
}

actor Corpse_11:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_11_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_11_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


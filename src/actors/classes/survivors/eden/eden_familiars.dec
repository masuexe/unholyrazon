// Guppy's Head familiar; the server picks targets using Unholy teams.
actor EdenBlueFly {
  damagefactor "Normal", 1.0
  Height 20
  Radius 10
  Obituary "%o was swarmed to death by %k's Blue Fly."
  Health 200
  Scale 2.5
  Translation "192:192=[51,95,179]:[51,95,179]", "198:198=[19,43,75]:[19,43,75]"
  +NOBLOOD
  Species "EdenBlueFly"
  painchance 0
  MaxStepHeight 100
  maxdropoffheight 100
  meleerange 10
  Monster
  -SOLID
  -NOBLOCKMAP
  +NOTELEFRAG
  +LOOKALLAROUND
  -COUNTKILL
  +QUICKTORETALIATE
  +JUMPDOWN
  +NOTELESTOMP
  +DONTMORPH
  +FIXMAPTHINGPOS
  +NEVERFAST
  +CANPASS
  +THRUSPECIES
  +DONTHARMSPECIES
  +FLOAT
  // +INVULNERABLE
  +FRIENDLY
  +CANTSEEK
  +NOPAIN
  +NOGRAVITY
  painsound "misc/devilpain"
  deathsound "Isaac/deathburstsmall"
  painchance 256
  Speed 16
  FloatSpeed 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2
    TNT1 A 1 A_TransferPointer(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_FRIENDPLAYER, AAPTR_MASTER)
   LookClear:
   Look:
   See:
    1SFL A 0 A_JumpIf(!CallACS("rz_EdenBlueFlyFindEnemy"), "Death")
    1SFL A 0 A_JumpIf(!CallACS("rz_EdenBlueFlyCanHit"), "Idle")
    1SFL AB 1 A_Chase("Melee", "")
    goto Look
   Idle:
    1SFL AB 1 A_Wander
    goto Look
   Melee:
    1SFL A 0 A_JumpIf(!CallACS("rz_EdenBlueFlyCanHit"), "Look")
    1SFL A 0 A_CustomMeleeAttack(CallACS("rz_GetEdenAttr", 4, 2, 0) * 2, "", "", "Eden", 0)
    goto Death
   Pain:
    1SFL A 0 A_ChangeFlag("NOPAIN", 1)
    goto Look
   Death:
    TNT1 A 1 A_SpawnItemEx("EdenPoofFX2")
    stop
  }
}

actor EdenFamiliarBase {
  States {
   Spawn:
    TNT1 A 0
    stop
  }
}

actor EdenBlueFly {
  damagefactor "Normal", 1.0
  Height 20
  Radius 10
  Obituary "%o was swarmed to death by %k's Blue Fly."
  Health 200
  Scale 2.5
  Translation "192:192=[51,95,179]:[51,95,179]", "198:198=[19,43,75]:[19,43,75]"
  bloodtype "EnemyHurtFX1"
  Species "EdenBlueFly"
  painchance 0
  MaxStepHeight 100
  maxdropoffheight 100
  meleerange 10
  Monster
  -SOLID
  -NOBLOCKMAP
  +NOTELEFRAG
  +LOOKALLAROUND
  -COUNTKILL
  +QUICKTORETALIATE
  +JUMPDOWN
  +NOTELESTOMP
  +DONTMORPH
  +FIXMAPTHINGPOS
  +NEVERFAST
  +CANPASS
  +THRUSPECIES
  +DONTHARMSPECIES
  +FLOAT
  // +INVULNERABLE
  +FRIENDLY
  +CANTSEEK
  +NOPAIN
  +NOGRAVITY
  painsound "misc/devilpain"
  deathsound "Isaac/deathburstsmall"
  painchance 256
  Speed 16
  FloatSpeed 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2
    TNT1 A 1 A_TransferPointer(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_FRIENDPLAYER, AAPTR_MASTER)
    // TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("core_getmaster")+10000)
   LookClear:
    1SFL A 0 A_ClearTarget
   Look:
    1SFL A 1 A_Chase
    1SFL A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 200, 0, 360, "See")
    1SFL B 1 A_Chase
    1SFL B 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 200, 0, 360, "See")
    loop
   See:
    1SFL AB 1 A_Chase("Melee", "")
    goto LookClear
   Melee:
    1SFL F 0 A_CustomMeleeAttack(CallACS("rz_GetEdenAttr", 4, 2, 0) * 2, "", "", "Eden", 0)
    goto Death
   Pain:
    1SFL F 0 A_ChangeFlag("NOPAIN", 1)
    goto LookClear
   Death:
    TNT1 A 1 A_SpawnItemEx("EdenPoofFX2")
    stop
  }
}

actor EdenBlueFlyDebugItem : CustomInventory {
  inventory.pickupmessage "Decoy Weapon Cycler"
  Inventory.Icon "UMUG_S50"
  inventory.PickupSound "WilyWar/Snd_37"
  +COUNTITEM
  +INVBAR
  Scale 1.0
  States {
   Spawn:
    7H50 "[" 4
    wait
   Use:
    TNT1 A 0 A_SpawnItemEx("EdenBlueFly", 0, 0, 32, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    fail
  }
}

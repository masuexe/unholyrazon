// C-Section main-fire HUD pose (6H59 B–F). Projectile via EdenFire_P CSection.
actor Eden678_W_ScriptBar : ScriptBar {}
actor Eden678_W : Eden_W {
  States {
   // This concrete weapon can enter its own pose directly. Eden_W's generic
   // virtual hook uses A_JumpIf + wait, which needs a server packet online.
   Fire:
    6H59 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadThrowCheck")
    goto EdenMainFire

   BotFire:
    6H59 A 0 A_Jump(32, "AltFire")
    6H59 A 0 A_JumpIfInventory("BobHeadFlag", 1, "BobHeadThrowCheck")
    goto EdenBotMainFire

   EdenMainFire:
    6H59 C 2
    6H59 B 8 A_SetTics(CallACS("rz_GetEdenAttr", 0, 1, 0) / 2)
    6H59 C 2
    6H59 C 0 A_GiveInventory("EdenFire_P")
    6H59 DEF 2
    TNT1 A 4
    goto CDCheck

   EdenBotMainFire:
    6H59 A 0
    goto EdenMainFire
  }
}

actor EdenTear : BasicProjectile {
  translation "192:192=[185,207,252]:[185,207,252]", "198:198=[132,171,249]:[132,171,249]"
  damagetype "Eden"
  Obituary "$OB_59M"
  -NOGRAVITY
  +SKYEXPLODE
  +SEEKERMISSILE
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0))
  radius 8
  height 8
  gravity 0.2
  Speed 10
  var int user_range;
  var int user_hover;
  States {
   Spawn:
    TNT1 A 0
    ISTR F 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    ISTR F 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    ISTR F 0 A_SetUserVar("user_range", CallACS("rz_GetEdenAttr", 2, 5, 0))
    ISTR F 0 A_JumpIf(CallACS("rz_EdenAntiGravEnterHover"), "Hover")
    goto SpawnLoop
   Hover:
    TNT1 A 0 A_Stop
    ISTR F 0 A_SetGravity(0.0)
    TNT1 A 0 A_SetUserVar("user_hover", 0)
   HoverLoop:
    ISTR F 1 A_SetUserVar("user_hover", user_hover + 1)
    ISTR F 0 ACS_NamedExecuteWithResult("rz_EdenAntiGravOwnerTickFromTear")
    ISTR F 0 A_JumpIf(user_hover >= 105, "Launch")
    ISTR F 0 A_JumpIf(user_hover < 2, "HoverLoop")
    ISTR F 0 A_JumpIf(CallACS("rz_EdenAntiGravShouldLaunch"), "Launch")
    goto HoverLoop
   Launch:
    ISTR F 0 A_SetGravity(0.2)
    ISTR F 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    goto SpawnLoop
   SpawnLoop:
    ISTR F 0 A_JumpIfInventory("EdenGodheadHoming_F", 1, "SpawnLoop.Godhead")
    goto SpawnLoop.Move
   SpawnLoop.Godhead:
    ISTR F 0 A_SeekerMissile(8, 16, SMF_LOOK, 48, 4)
   SpawnLoop.Move:
    ISTR F 1 A_SetUserVar("user_range", user_range - 1)
    ISTR F 0 A_JumpIf(user_range==0, "Death")
    goto SpawnLoop

   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_GiveInventory("EdenTearSpent_F", 1)
    ISTR H 0 A_SetGravity(0.0)
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenTearRunDeath"), "Death.Done")
   DeathFrame:
    ISTR F 0 A_PlaySoundEx("Isaac/splatter", "Weapon")
    ISBR ABCDEFGHIJKLMNO 1
    stop
   Death.Done:
    TNT1 A 0
    stop
  }
}

actor EdenSpectralHit_F : UOnce {}

// Visual: wall-pierce via NOCLIP/NOINTERACTION. Hits use EdenSpectralTearDamager.
// Must override Spawn/Launch with goto SpawnLoop — parent states fall through by state index.
actor EdenSpectralTear : EdenTear {
  +NOCLIP
  +NOINTERACTION
  Damage (0)
  States {
   Spawn:
    TNT1 A 0
    ISTR F 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    ISTR F 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    ISTR F 0 A_SetUserVar("user_range", CallACS("rz_GetEdenAttr", 2, 5, 0))
    ISTR F 0 A_JumpIf(CallACS("rz_EdenAntiGravEnterHover"), "Hover")
    goto SpawnLoop
   Hover:
    TNT1 A 0 A_Stop
    ISTR F 0 A_SetGravity(0.0)
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_SetUserVar("user_hover", 0)
   HoverLoop:
    ISTR F 1 A_SetUserVar("user_hover", user_hover + 1)
    ISTR F 0 ACS_NamedExecuteWithResult("rz_EdenAntiGravOwnerTickFromTear")
    ISTR F 0 A_JumpIf(user_hover >= 105, "Launch")
    ISTR F 0 A_JumpIf(user_hover < 2, "HoverLoop")
    ISTR F 0 A_JumpIf(CallACS("rz_EdenAntiGravShouldLaunch"), "Launch")
    goto HoverLoop
   Launch:
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 1)
    ISTR F 0 A_SetGravity(0.2)
    ISTR F 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    goto SpawnLoop
   SpawnLoop:
    ISTR F 0 A_JumpIfInventory("EdenGodheadHoming_F", 1, "SpawnLoop.Godhead")
    goto SpawnLoop.Move
   SpawnLoop.Godhead:
    ISTR F 0 A_SeekerMissile(8, 16, SMF_LOOK, 48, 4)
   SpawnLoop.Move:
    ISTR F 0 A_JumpIfInventory("EdenSpectralHit_F", 1, "Death")
    ISTR F 0 A_SpawnItemEx("EdenSpectralTearDamager", 0, 0, 0, velx, vely, velz, 0, SXF_TRANSFERPOINTERS|SXF_ABSOLUTEMOMENTUM, 0, CallACS("core_NewUniqueTID"))
    ISTR F 0 ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", CallACS("core_CurrentUniqueTID"), AAPTR_MASTER)
    ISTR F 0 ACS_NamedExecuteWithResult("core_ClearUniqueTID", 0)
    ISTR F 1 A_SetUserVar("user_range", user_range - 1)
    ISTR F 0 A_JumpIf(user_range == 0, "Death")
    loop
  }
}

actor EdenSpectralTearDamager : BasicProjectile {
  +DONTSPLASH
  +DONTBLAST
  +INVISIBLE
  -USESPAWNEVENTSCRIPT
  Damagetype "Eden"
  Obituary "$OB_59M"
  Radius 8
  Height 8
  Speed 10
  Damage (CallACS("rz_GetEdenAttr", AAPTR_TARGET, 2, 0))
  States {
   Spawn:
    TNT1 A 1
    stop
   Crash:
    // Pointer 4 = AAPTR_MASTER (tear). Pointer 2 is AAPTR_TARGET (shooter).
    TNT1 A 0 A_GiveInventory("EdenSpectralHit_F", 1, 4)
    stop
   Death:
    TNT1 A 0
    stop
  }
}


actor EdenBomb : BasicProjectile {
  Translation "192:192=208:208", "198:198=0:0", "202:202=4:4", "199:199=210:210"
  damagetype "EdenBomb"
  Obituary "%o was blown to bits by %k's bomb."
  -NOGRAVITY
  +RIPPER
  +BOUNCEONACTORS
  +HEXENBOUNCE
  +CANBOUNCEWATER
  gravity 1.0
  bouncefactor 0.68
  reactiontime 1
  Damage (0)
  Radius 12
  Height 16
  speed 20
  scale 3.0
  States {
   Spawn:
    X_1D A 0
    X_1D A 85 ThrustThingZ(0, 14, 0, 1)
    X_1D A 1 A_CountDown
    wait
   Death:
    X_1D A 0 A_SetGravity(0.0)
    X_1D A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    X_1D A 0 A_Explode(450, 212, XF_HURTSOURCE)
    X_1D A 0 A_SetScale(3.75)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

actor EdenTrollBomb : EdenBomb {
  Obituary "%o was pranked to oblivion by %k's Troll Bomb."
  bouncefactor 0.2
  bouncecount 3
  States {
   Spawn:
    1SBM A 0
    1SBM A 25 ThrustThingZ(0, 14, 0, 1)
    1SBM A 1
    wait
  }
}

actor EdenMegaTrollBomb : EdenBomb {
  Obituary "%o couldn't outrun %k's Mega Troll Bomb."
  +SEEKERMISSILE
  bouncefactor 0.85
  bouncecount 8
  Radius 24
  Height 32
  scale 6.0
  States {
   Spawn:
    1SBM B 0
    1SBM B 25 ThrustThingZ(0, 14, 0, 1)
    Goto SpawnL
   SpawnL:
    1SBM B 16 A_SeekerMissile(90, 90, SMF_LOOK|SMF_PRECISE, 256, 3)
    loop
   Death:
    1SBM B 0 A_SetGravity(0.0)
    1SBM B 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    1SBM B 0 A_Explode(900, 424, XF_HURTSOURCE)
    1SBM B 0 A_SetScale(7.5)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

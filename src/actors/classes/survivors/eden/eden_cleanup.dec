// Eden boss/Demoneye/shiny conversion leftovers, given by uh_StripSurvivorWeps
// via DefineSurvivorCleanup("Eden", ...). The registry sweep takes the weapons;
// this clears Eden's Isaac-style runtime state the sweep cannot see.
// Familiars and C396 Ventricle Razor endpoints manage their own lifetime (the
// endpoint TID pool is global — never blind-remove), and the body dye falls
// back via rz_EdenStripCleanup zeroing UH_LastReadyDye.
actor EdenStripCleanup_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("ResetEdenAttr_P")
    TNT1 A 0 A_TakeInventory("EdenToyAmmo")
    TNT1 A 0 A_TakeInventory("EdenTearCoolDown")
    TNT1 A 0 A_TakeInventory("EdenItemSlot1")
    TNT1 A 0 A_TakeInventory("EdenItemSlot2")
    TNT1 A 0 A_TakeInventory("BobHeadFlag")
    TNT1 A 0 A_TakeInventory("BobHeadLeft_F")
    TNT1 A 0 A_TakeInventory("DuoBusterFlag")
    TNT1 A 0 A_TakeInventory("VentricleFlag")
    TNT1 A 0 A_TakeInventory("D8InitFlag")
    TNT1 A 0 A_TakeInventory("C36Flag")
    TNT1 A 0 A_TakeInventory("C42Flag")
    TNT1 A 0 A_TakeInventory("C65Flag")
    TNT1 A 0 A_TakeInventory("C118Flag")
    TNT1 A 0 A_TakeInventory("C149Flag")
    TNT1 A 0 A_TakeInventory("C222Flag")
    TNT1 A 0 A_TakeInventory("C227Flag")
    TNT1 A 0 A_TakeInventory("C331Flag")
    TNT1 A 0 A_TakeInventory("C356Flag")
    TNT1 A 0 A_TakeInventory("C358Flag")
    TNT1 A 0 A_TakeInventory("C371Flag")
    TNT1 A 0 A_TakeInventory("C396Flag")
    TNT1 A 0 A_TakeInventory("C406Flag")
    TNT1 A 0 A_TakeInventory("C477Flag")
    TNT1 A 0 A_TakeInventory("C485Flag")
    TNT1 A 0 A_TakeInventory("C577Flag")
    TNT1 A 0 A_TakeInventory("C609Flag")
    TNT1 A 0 A_TakeInventory("C678Flag")
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenStripCleanup")
    stop
  }
}

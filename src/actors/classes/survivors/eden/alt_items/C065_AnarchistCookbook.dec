actor C65Flag : Once {}

actor AnarchistCookbookBombWatcher : BasicWatcher {
  ReactionTime 6
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("AnarchistCookbook_SpreadCheck_P")
   SpawnLoop:
    TNT1 A 3 A_GiveToTarget("SpawnACBomb_P")
    TNT1 A 0 A_Countdown
    loop
  }
}

actor AnarchistCookbook_SpreadCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_setactorproperty", APROP_ReactionTime, 18, 0)
    stop
  }
}

actor SpawnACBomb_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenItemOwnerActive") == 0, "Done")
    TNT1 A 0 A_SpawnItemEx("EdenTrollBomb", 0, 0, 32, frandom(-64.0, 64.0), frandom(-64.0, 64.0), frandom(8.0, 16.0))
   Done:
    TNT1 A 0
    stop
  }
}

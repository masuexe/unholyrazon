  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("AnarchistCookbookBombWatcher")
    stop
    //   TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), "S_Pickup")

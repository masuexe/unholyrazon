// C042 — Bob's Rotten Head.
// BobHeadFlag is the held-bomb stock shown by the Eden HUD.  The left-hand
// marker means that the right bomb has already been thrown from a two-bomb
// stock, so the remaining bomb must use the left throw.

actor BobsRottenHeadIsaacItem_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("BobHeadFlag", 2, "Full")
    TNT1 A 0 A_JumpIfInventory("BobHeadFlag", 1, "AddSecond")
    TNT1 A 0 A_GiveInventory("BobHeadFlag", 1)
    TNT1 A 0 A_SpawnItemEx("EdenBobHeadWarper_R", 68, 17, 16)
    stop

   AddSecond:
    TNT1 A 0 A_GiveInventory("BobHeadFlag", 1)
    TNT1 A 0 A_JumpIfInventory("BobHeadLeft_F", 1, "AddRight")
    TNT1 A 0 A_SpawnItemEx("EdenBobHeadWarper_L", 60, -17, 16)
    stop

   AddRight:
    TNT1 A 0 A_TakeInventory("BobHeadLeft_F", 1)
    TNT1 A 0 A_SpawnItemEx("EdenBobHeadWarper_R", 68, 17, 16)
    stop

   Full:
    TNT1 A 0
    stop
  }
}

actor BobHeadFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 2
}

actor BobHeadLeft_F : UOnce {}
actor C42Flag : UOnce {}

// These are authoritative actors rather than CLIENTSIDEONLY actors.  This
// allows the active-item giver to create a missing hand marker safely in
// multiplayer, including when Car Battery fills the second bomb immediately.
actor EdenBobHeadWarper_R : BasicShieldWarper {
  -CLIENTSIDEONLY
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient", 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_EdenBobHeadWarper", 0, 0)
    goto RightPath

   RightPath:
    DDIG B 1
    DDIG B 1 A_Warp(AAPTR_TARGET, 52, 16, 32, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 36, 15, 48, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 20, 13, 64, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 4, 10, 74, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    goto RightCheck

   RightCheck:
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadFlag", 2, "RightHold")
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadFlag", 1, "RightOne")
    goto Cleanup
   RightOne:
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadLeft_F", 1, "Cleanup")
    goto RightHold
   RightHold:
    DDIG B 1 A_Warp(AAPTR_TARGET, -1, 10, 72, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    goto RightCheck

   Cleanup:
    TNT1 A 0
    stop
  }
}

actor EdenBobHeadWarper_L : BasicShieldWarper {
  -CLIENTSIDEONLY
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient", 1)
    TNT1 A 0 ACS_NamedExecuteAlways("rz_EdenBobHeadWarper", 0, 1)
    goto LeftPath

   LeftPath:
    DDIG B 1
    DDIG B 1 A_Warp(AAPTR_TARGET, 44, -16, 32, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 28, -15, 48, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 12, -13, 64, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, -4, -10, 74, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    goto LeftCheck

   LeftCheck:
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadFlag", 2, "LeftHold")
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadFlag", 1, "LeftOne")
    goto Cleanup
   LeftOne:
    TNT1 A 0 A_JumpIfInTargetInventory("BobHeadLeft_F", 1, "LeftHold")
    goto Cleanup
   LeftHold:
    DDIG B 1 A_Warp(AAPTR_TARGET, -9, -10, 72, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    goto LeftCheck

   Cleanup:
    TNT1 A 0
    stop
  }
}

actor BobPoisonBomb : EdenBomb {
  translation "192:192=110:110", "198:198=129:129"
  Projectile
  damagetype "BobsRottenHead"
  Obituary "%o was obliterated by %k's Bob's Rotten Head."
  -NOGRAVITY
  -RIPPER
  -BOUNCEONACTORS
  -HEXENBOUNCE
  -CANBOUNCEWATER
  gravity 0.2
  Damage (0)
  Radius 12
  Height 16
  speed 35
  scale 3.0
  States {
   Spawn:
    BOBH A 0
    BOBH A 85 ThrustThingZ(0, 1, 0, 1)

   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(100, 128, 0, 0, 80)
    TNT1 A 0 A_SpawnItemEx("BobPoisonBombTrapExp", 0, 0, 28, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BobHeadTrapExpFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 4 A_SpawnItemEx("BobHeadTossFX", 0, 0, 24, 0, 0, 0, 0, 1)
    stop
  }
}

actor BobPoisonBombTrapExp : BasicExplosion {
  ReactionTime 24
  damagetype "BobsRottenHead"
  Obituary "%o choked to death in %k's Bob's cloud."
  Args 10, 80
  States {
   Spawn:
    TNT1 A 0 A_CountDown
    TNT1 AAAA 2 A_Explode(Args[0], Args[1], 0, 0, Args[1])
    goto CloudLoop
   CloudLoop:
    TNT1 A 0 A_CountDown
    TNT1 AAAA 2 A_Explode(Args[0], Args[1], 0, 0, Args[1])
    goto CloudLoop
  }
}

actor BobHeadTrapExpFX : BasicClientSide {
  RenderStyle Translucent
  Alpha 0.60
  ReactionTime 24
  Scale 4.0
  Args 25
  States {
   Spawn:
    TNT1 A 0
    goto ShrinkIn
   ShrinkIn:
    6P28 K 1 A_SetArg(0, Args[0] - 1)
    6P28 K 0 A_JumpIf(Args[0] < 1, "CloudLoop")
    goto ShrinkIn
   CloudLoop:
    6P28 KLMN 2
    6P28 K 0 A_CountDown
    goto CloudLoop
   Death:
    6P28 KLMN 2 A_FadeTo(0.1, 0.075, 1)
    loop
  }
}

actor BobHeadTossFX : BasicBoom4FX_ColorX {
  Scale 3.0
}

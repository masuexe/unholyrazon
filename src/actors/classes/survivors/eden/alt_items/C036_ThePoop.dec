    1SPP AA 0 A_SpawnItemEx("GoldPoopGibFX", 0, 0, 0, random(2, 6), 0, random(3, 12), random(0, 359), 0)
    goto HealthCheck
   HealthCheck:
    1SPP A 0 A_JumpIfHealthLower(613, "Spawn4")
    1SPP A 0 A_JumpIfHealthLower(1225, "Spawn3")
    1SPP A 0 A_JumpIfHealthLower(1838, "Spawn2")
    goto Spawn
   Death:

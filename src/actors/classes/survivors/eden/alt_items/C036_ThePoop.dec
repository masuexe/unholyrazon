actor ThePoopIsaacItem_P : CustomInventory {
  States {
   Pickup:
    1SPP A 0 A_GiveInventory("ThePoopSpawner_P")
    TNT1 A 0 A_PlaySoundEx("Isaac/fart", "weapon")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_radiuspull", 0, -100, 100, 2)
    TNT1 A 0 A_Recoil(-10)
    TNT1 A 0 A_SpawnItemEx("ThePoopFX")
    stop
  }
}

actor C36Flag : UOnce {}

const int POOP_SPAWN_OFFSET = 48;
actor ThePoopSpawner_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(10, "Red")
    TNT1 A 0 A_Jump(10, "Golden")
    goto Normal
   Normal:
    TNT1 A 0 A_SpawnItemEx("ThePoop", -POOP_SPAWN_OFFSET, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("ThePoop", 0, POOP_SPAWN_OFFSET, 32)
    TNT1 A 0 A_SpawnItemEx("ThePoop", 0, -POOP_SPAWN_OFFSET, 32)
    stop
   Red:
    TNT1 A 0 A_SpawnItemEx("RedPoop", -POOP_SPAWN_OFFSET, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("RedPoop", 0, POOP_SPAWN_OFFSET, 32)
    TNT1 A 0 A_SpawnItemEx("RedPoop", 0, -POOP_SPAWN_OFFSET, 32)
    stop
   Golden:
    TNT1 A 0 A_SpawnItemEx("GoldenPoop", -POOP_SPAWN_OFFSET, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, 1)
    stop
    TNT1 A 0 A_SpawnItemEx("GoldenPoop", 0, POOP_SPAWN_OFFSET, 32)
    TNT1 A 0 A_SpawnItemEx("GoldenPoop", 0, -POOP_SPAWN_OFFSET, 32)
    stop
  }
}

actor ThePoop : UH_ShootableActor {
  Translation "4:4=[138,83,64]:[138,83,64]", "202:202=[100,59,49]:[100,59,49]", "192:192=[89,53,44]:[89,53,44]", "197:197=[79,47,39]:[79,47,39]", "198:198=[62,41,32]:[62,41,32]", "199:199=[39,25,22]:[39,25,22]", "0:0=[27,18,22]:[27,18,22]"
  -NOGRAVITY
  +SHOOTABLE
  +SOLID
  +NEVERTARGET
  +DONTDRAIN
  +NOTAUTOAIMED
  +NOBLOOD
  +THRUSPECIES
  species "ThePoop"
  mass 20  // 0x7ffffffd
  health 700
  painchance 256
  Radius 20
  Height 43
  scale 2.5
  States {
   Spawn:
    1SPP A 0
    1SPP A 1
    wait
   Spawn2:
    1SPP B 1
    wait
   Spawn3:
    1SPP C 1
    wait
   Spawn4:
    1SPP D 1
    wait

   Pain:
    1SPP AA 0 A_SpawnItemEx("ThePoopGibFX", 0, 0, 0, random(2, 6), 0, random(3, 12), random(0, 359), 0)
    goto HealthCheck
   HealthCheck:
    1SPP A 0 A_JumpIfHealthLower(175, "Spawn4")
    1SPP A 0 A_JumpIfHealthLower(350, "Spawn3")
    1SPP A 0 A_JumpIfHealthLower(525, "Spawn2")
    goto Spawn
   Death:
    1SPP AAAA 0 A_SpawnItemEx("ThePoopGibFX", 0, 0, 0, random(2, 6), 0, random(3, 12), random(0, 359), 0)
    TNT1 A 0 A_SpawnItemEx("PoopReward")
    goto FinalDeath
   FinalDeath:
    1SPP A 0 A_SpawnItemEx("EdenPoopPoofFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("Isaac/plop", 4)
    TNT1 A 0 A_ChangeFlag("SOLID", 0)
    TNT1 A 0 A_ChangeFlag("NoInteraction", 1)
    TNT1 A 0 A_ChangeFlag("NoClip", 1)
    TNT1 A 1
    stop
  }
}

actor RedPoop : ThePoop {
  Translation "4:4=[168,54,72]:[168,54,72]", "202:202=[147,40,56]:[147,40,56]", "192:192=[131,34,49]:[131,34,49]", "197:197=[90,15,26]:[90,15,26]", "198:198=[85,17,29]:[85,17,29]", "199:199=[74,12,25]:[74,12,25]", "0:0=[37,0,3]:[37,0,3]"
  damagetype "RedPoop"
  damagefactor "RedPoop", 0.0
  obituary "%o was incinerated by a red poop."
  args 10
  States {
   Spawn:
    1SPP A 0
    1SPP A 1 A_GiveInventory("RedPoopContactDamage_P")
    wait
   Spawn2:
    1SPP B 1 A_GiveInventory("RedPoopContactDamage_P")
    wait
   Spawn3:
    1SPP C 1 A_GiveInventory("RedPoopContactDamage_P")
    wait
   Spawn4:
    1SPP D 1 A_GiveInventory("RedPoopContactDamage_P")
    wait
   Pain:
    1SPP AA 0 A_SpawnItemEx("RedPoopGibFX", 0, 0, 0, random(2, 6), 0, random(3, 12), random(0, 359), 0)
    goto HealthCheck
   Death:
    POOP Q 0 A_JumpIf(args[0]==0, "FinalDeath")
    POOP Q 0 A_SetArg(1, 128)
    1SPP AAAA 0 A_SpawnItemEx("RedPoopGibFX", 0, 0, 0, random(2, 6), 0, random(3, 12), random(0, 359), 0)
    1SPP A 0 A_SpawnItemEx("EdenPoopPoofFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("Isaac/plop", 4)
   RespawnCountDown:
    POOP Q 0 A_JumpIf(Args[1]<=0, "Respawn")
    POOP Q 1 A_SetArg(1, Args[1]-1)
    loop
   Respawn:
    TNT1 A 0 A_CountdownArg(0)
    TNT1 A 0 A_SpawnItemEx("ThePoopFX")
    TNT1 A 0 A_SpawnItemEx("RedPoop", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION|SXF_TRANSFERSPECIAL)//1|32768
    TNT1 A 0 A_ChangeFlag("SOLID", 0)
    TNT1 A 0 A_ChangeFlag("NoInteraction", 1)
    TNT1 A 0 A_ChangeFlag("NoClip", 1)
    stop
  }
}

actor RedPoopContactDamage_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 4, "Explode")
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    stop
   Explode:
    TNT1 A 0 A_Explode(100, 35, 1)
    TNT1 A 0 A_TakeInventory("CutterFlag")
    stop
  }
}

actor GoldenPoop : ThePoop {
  Translation "4:4=[255,255,255]:[255,255,255]",
  "202:202=[242,208,103]:[242,208,103]",
  "192:192=[232,190,63]:[232,190,63]",
  "197:197=[207,163,19]:[207,163,19]",
  "198:198=[209,145,3]:[209,145,3]",
  "199:199=[216,129,0]:[216,129,0]",
  "0:0=[124,71,0]:[124,71,0]"
  health 2450
  States {

    TNT1 A 0 A_SpawnItemEx("DLC_CoinSpawner_H")
    goto FinalDeath
  }
}

actor ThePoopFX : BasicGraphicEffect {
  Translation "192:192=[168,112,94]:[168,112,94]", "198:198=[138,83,64]:[138,83,64]", "199:199=[98,59,45]:[98,59,45]"
  //RenderStyle Translucent
  //Alpha 0.8
  scale 3.0
  States {
   Spawn:
    TNT1 A 0
    POOP CDEFGHI 1
   Death:
    POOP I 1 A_FadeOut(0.2)
    POOP I 1 A_SetScale(scalex+0.2, scaley+0.2)
    loop
  }
}


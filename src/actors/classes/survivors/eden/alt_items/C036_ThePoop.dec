actor PoopReward : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(10, "Coin")
    TNT1 A 0 A_Jump(10, "Heal")
    TNT1 A 0 A_Jump(20, "Bomb")
    //TNT1 A 0 A_Jump(10,"Petrified")
    stop
   Coin:
    TNT1 A 0 A_Jump(10, "Jackpot")
    TNT1 A 0 A_SpawnItemEx("DLCMoneyBag")
    stop
   Jackpot:
    TNT1 A 0 A_SpawnItemEx("DLCMoneyBag100")
    stop
   Heal:
    TNT1 A 0 A_SpawnItemEx("BigHealthU")
    stop
   Bomb:
    TNT1 A 0 A_Jump(32, "MegaBomb")
    TNT1 A 0 A_SpawnItemEx("EdenTrollBomb", 0, 0, 0, frandom(-8.0, 8.0), frandom(-8.0, 8.0), frandom(1.0, 2.0))
    stop
   MegaBomb:
    TNT1 A 0 A_SpawnItemEx("EdenMegaTrollBomb", 0, 0, 0, frandom(-12.0, 12.0), frandom(-12.0, 12.0), frandom(1.0, 2.0))
    stop
  }
}

actor EdenBomb {
  Translation "192:192=208:208", "198:198=0:0", "202:202=4:4", "199:199=210:210"
  PROJECTILE
  damagetype "EdenBomb"
  Obituary "%o was blown to bits by %k's bomb."
  -NOGRAVITY
  +RIPPER
  +BOUNCEONACTORS
  +HEXENBOUNCE
  +CANBOUNCEWATER
  gravity 1.0
  bouncefactor 0.68
  reactiontime 1
  Damage (0)
  Radius 12
  Height 16
  speed 20
  scale 3.0
  States {
   Spawn:
    X_1D A 0
    X_1D A 85 ThrustThingZ(0, 14, 0, 1)
    X_1D A 1 A_CountDown
    wait
   Death:
    X_1D A 0 A_SetGravity(0.0)
    X_1D A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    X_1D A 0 A_Explode(450, 212, XF_HURTSOURCE)
    X_1D A 0 A_SetScale(3.75)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

actor EdenTrollBomb : EdenBomb {
  Obituary "%o was pranked to oblivion by %k's Troll Bomb."
  -NOGRAVITY
  bouncefactor 0.2
  bouncecount 3
  States {
   Spawn:
    1SBM A 0
    1SBM A 25 ThrustThingZ(0, 14, 0, 1)
    1SBM A 1
    wait
  }
}

actor EdenMegaTrollBomb : EdenBomb {
  Obituary "%o couldn't outrun %k's Mega Troll Bomb."
  -NOGRAVITY
  +SEEKERMISSILE
  bouncefactor 0.85
  bouncecount 8
  Radius 24
  Height 32
  scale 6.0
  States {
   Spawn:
    1SBM B 0
    1SBM B 25 ThrustThingZ(0, 14, 0, 1)
    Goto SpawnL
   SpawnL:
    1SBM B 16 A_SeekerMissile(90, 90, SMF_LOOK|SMF_PRECISE, 256, 3)
    loop
   Death:
    1SBM B 0 A_SetGravity(0.0)
    1SBM B 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    1SBM B 0 A_Explode(900, 424, XF_HURTSOURCE)
    1SBM B 0 A_SetScale(7.5)
    Y_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

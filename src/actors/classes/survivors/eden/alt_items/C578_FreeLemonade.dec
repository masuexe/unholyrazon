// C578 — razon3 spray (48 tics) and ground creep (500 tics).
actor C578Flag : Once {}
actor FreeLemonadeIsaacItem_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("FreeLemonadeYellowCreep_H", 0, 0, 0, 0)
    stop
  }
}
actor FreeLemonadeYellowCreep_H : BasicWatcher {
  ReactionTime 48
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Isaac/Gascan", "Weapon")
   Spray:
    TNT1 A 0 A_JumpIf(!CallACS("rz_EdenActiveEmitterValid", 578), "Death")
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 32, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("EdenYellowCreep", 0, 0, 0, random(0, 48), random(0, 32), random(4, 8), random(0, 359))
    TNT1 A 1 A_Countdown
    goto Spray
  }
}
actor EdenYellowCreep {
  Translation "4:4=161:161", "192:192=228:228", "198:198=162:162", "0:0=163:163"
  PROJECTILE
  DamageType "Eden"
  Obituary "%o slipped in %k's yellow creep and dissolved."
  -NOGRAVITY
  +FORCEXYBILLBOARD
  Damage (131)
  Height 10
  Radius 10
  Speed 33
  Scale 2.5
  States {
   Spawn:
    X_1H B 0
    X_8H BCD 2
    loop
   Crash:
   XDeath:
    X_1H B 0
    stop
   Death:
    X_1H B 0 A_JumpIf(z - floorz <= 0, "DeathF")
    X_1H B 0 A_SpawnItemEx("EdenYellowCreepDrop", 0, 0, 0, 0, 0, velz, 0, SXF_TRANSFERTRANSLATION)
    stop
   DeathF:
    TNT1 A 0 A_PlaySound("weapon/oilshot", 1)
    TNT1 A 1 A_SpawnItemEx("EdenYellowCreepBlob", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
    stop
  }
}
actor EdenYellowCreepDrop : EdenYellowCreep {
  States {
   Spawn:
    X_1H B 0
    X_1H B 0 ThrustThingZ(0, 1, 0, 1)
    X_1H B 5
    wait
   Death:
    X_1H B 0 A_JumpIf(z - floorz <= 0, "DeathF")
    goto XDeath
  }
}
actor EdenYellowCreepBlob {
  DamageType "Eden"
  PROJECTILE
  Obituary "%o slipped in %k's yellow creep and dissolved."
  +DONTSPLASH
  +BOUNCEONCEILINGS
  +NOEXPLODEFLOOR
  ReactionTime 500
  Damage (130)
  Radius 8
  Height 10
  Scale 2.5
  Args 250
  States {
   Spawn:
    X_1H D 0
    X_1H D 1 A_ChangeVelocity(0, 0, velz, CVF_REPLACE)
   Creep:
    X_1H C 1 A_Countdown
    goto Creep
   Death:
    TNT1 A 0
    stop
  }
}

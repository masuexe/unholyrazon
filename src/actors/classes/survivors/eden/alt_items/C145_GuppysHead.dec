actor C145Flag : Once {}
actor GuppysHeadIsaacItem_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("GuppyHead_H", 0, 0, 0, 0)
    stop
  }
}
actor GuppyHead_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("EdenBlueFly", 0, 32, 32, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("EdenBlueFly", 0, 32, 32, 0, 0, 0, 180, SXF_TRANSFERPOINTERS)
    stop
  }
}

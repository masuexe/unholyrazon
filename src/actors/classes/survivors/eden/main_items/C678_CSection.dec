actor C678Flag : UOnce {}

actor EdenFetusFXOn_F : UOnce {}

// RIPPER fetus tear — separate class for look / seeker / death; passives via EdenTear hooks.
// Visual is EdenFetusFX (spawned 1 tic later so PassiveSpawn dye can TRANSFERTRANSLATION).
actor EdenFetusTear : EdenTear {
  translation "192:192=[227,198,197]:[227,198,197]", "198:198=[207,156,155]:[207,156,155]", "199:199=[185,115,113]:[185,115,113]"
  damagetype "EdenFetus"
  Obituary "%o was C-sectioned to death by %k's fetus tear."
  +RIPPER
  +SEEKERMISSILE
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0) * 0.75)
  gravity 0.05
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    TNT1 A 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    TNT1 A 0 A_SetUserVar("user_range", CallACS("rz_GetEdenAttr", 2, 5, 0))
    goto SpawnLoop
   SpawnLoop:
    TNT1 A 0 A_JumpIfInventory("EdenFetusFXOn_F", 1, "Seek")
    TNT1 A 0 A_GiveInventory("EdenFetusFXOn_F", 1)
    TNT1 A 0 A_SpawnItemEx("EdenFetusFX", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS|SXF_TRANSFERTRANSLATION, 0, CallACS("core_NewUniqueTID"))
    TNT1 A 0 ACS_NamedExecuteWithResult("core_setTIDsPointerToThis", CallACS("core_CurrentUniqueTID"), AAPTR_MASTER)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_ClearUniqueTID", 0)
   Seek:
    TNT1 A 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    TNT1 A 0 A_SetUserVar("user_range", user_range - 1)
    TNT1 A 0 A_JumpIf(user_range == 0, "Death")
    goto SpawnLoop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_GiveInventory("EdenTearSpent_F", 1)
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenTearRunDeath"), "Death.Done")
    TNT1 A 0 A_PlaySoundEx("Isaac/deathburstsmall", "Weapon")
    TNT1 A 1 A_SpawnItemEx("EdenPoofFX")
    stop
   Death.Done:
    TNT1 A 0
    stop
  }
}

// MASTER = tear. Same gate as Strange Attractor — A_JumpIfInventory(..., ptr) does not kill this FX.
actor EdenFetusFX {
  +NOINTERACTION
  +DONTBLAST
  +THRUACTORS
  +NOGRAVITY
  +MISSILE
  Scale 2.5
  States {
   Spawn:
    1SFT A 0
    goto FxTick
   FxTick:
    1SFT A 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT A 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT B 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT B 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT C 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT C 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT D 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT D 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT E 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT E 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT F 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT F 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT G 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT G 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT H 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT H 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT I 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT I 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT J 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT J 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT K 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT K 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    1SFT L 0 A_JumpIf(!CallACS("rz_EdenAttractMasterOk"), "Death")
    1SFT L 1 A_Warp(4, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    goto FxTick
   Death:
    TNT1 A 1
    stop
  }
}

// RIPPER self-hit immunity (Pain.EdenFetus on ClassBaseU2).
actor EdenFetusProtect : PowerProtection {
  Powerup.Duration 9
  damagefactor "EdenFetus", 0
}

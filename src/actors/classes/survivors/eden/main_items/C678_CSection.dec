actor C678Flag : UOnce {}

// RIPPER fetus tear — look / seeker / death on the projectile itself (no companion FX).
// Passives via EdenTear hooks (PassiveSpawn dye, RunDeath).
actor EdenFetusTear : EdenTear {
  translation "192:192=[227,198,197]:[227,198,197]", "198:198=[207,156,155]:[207,156,155]", "199:199=[185,115,113]:[185,115,113]"
  damagetype "EdenFetus"
  Obituary "%o was C-sectioned to death by %k's fetus tear."
  +RIPPER
  +SEEKERMISSILE
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0) * 0.75)
  gravity 0.05
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    TNT1 A 0 A_ChangeVelocity(cos(pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), 0, sin(-pitch)*CallACS("rz_GetEdenAttr", 2, 3, 0), CVF_RELATIVE|CVF_REPLACE)
    TNT1 A 0 A_SetUserVar("user_range", CallACS("rz_GetEdenAttr", 2, 5, 0))
    goto SpawnLoop
   SpawnLoop:
    1SFT A 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT A 0 A_SetUserVar("user_range", user_range - 1)
    1SFT A 0 A_JumpIf(user_range == 0, "Death")
    1SFT B 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT B 0 A_SetUserVar("user_range", user_range - 1)
    1SFT B 0 A_JumpIf(user_range == 0, "Death")
    1SFT C 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT C 0 A_SetUserVar("user_range", user_range - 1)
    1SFT C 0 A_JumpIf(user_range == 0, "Death")
    1SFT D 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT D 0 A_SetUserVar("user_range", user_range - 1)
    1SFT D 0 A_JumpIf(user_range == 0, "Death")
    1SFT E 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT E 0 A_SetUserVar("user_range", user_range - 1)
    1SFT E 0 A_JumpIf(user_range == 0, "Death")
    1SFT F 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT F 0 A_SetUserVar("user_range", user_range - 1)
    1SFT F 0 A_JumpIf(user_range == 0, "Death")
    1SFT G 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT G 0 A_SetUserVar("user_range", user_range - 1)
    1SFT G 0 A_JumpIf(user_range == 0, "Death")
    1SFT H 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT H 0 A_SetUserVar("user_range", user_range - 1)
    1SFT H 0 A_JumpIf(user_range == 0, "Death")
    1SFT I 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT I 0 A_SetUserVar("user_range", user_range - 1)
    1SFT I 0 A_JumpIf(user_range == 0, "Death")
    1SFT J 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT J 0 A_SetUserVar("user_range", user_range - 1)
    1SFT J 0 A_JumpIf(user_range == 0, "Death")
    1SFT K 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT K 0 A_SetUserVar("user_range", user_range - 1)
    1SFT K 0 A_JumpIf(user_range == 0, "Death")
    1SFT L 1 A_SeekerMissile(3, 8, SMF_LOOK|SMF_CURSPEED, 48, 3)
    1SFT L 0 A_SetUserVar("user_range", user_range - 1)
    1SFT L 0 A_JumpIf(user_range == 0, "Death")
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_GiveInventory("EdenTearSpent_F")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenTearRunDeath"), "Death.Done")
    TNT1 A 0 A_PlaySoundEx("Isaac/deathburstsmall", "Weapon")
    TNT1 A 1 A_SpawnItemEx("EdenPoofFX")
    stop
   Death.Done:
    TNT1 A 0
    stop
  }
}

// RIPPER self-hit immunity (Pain.EdenFetus on ClassBaseU2).
actor EdenFetusProtect : PowerProtection {
  Powerup.Duration 9
  damagefactor "EdenFetus", 0
}

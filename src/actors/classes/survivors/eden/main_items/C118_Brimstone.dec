actor C118Flag : UOnce {}

// One segment of Eden's Brimstone burst. Other main-item interactions are
// intentionally deferred until the standalone C118 fire mode is established.
actor EdenBrimstone : BasicProjectile {
  translation "4:4=175:175", "192:192=42:42", "198:198=178:178", "199:199=43:43"
  damagetype "Eden"
  Obituary "%o was cleansed by %k's Brimstone beam."
  -NOGRAVITY
  +SKYEXPLODE
  Damage (CallACS("rz_GetEdenAttr", 2, 2, 0) / 2)
  radius 16
  height 16
  scale 2.5
  Speed 200
  States {
   Spawn:
    7P59 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    7P59 A 1
    wait
   Crash:
   XDeath:
   Death:
    TNT1 A 0 A_Stop
    7P59 EFGH 1
    stop
  }
}

actor EdenBrimstoneFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("EdenBrimstone", 0, 0, 0, 0)
    stop
  }
}

// C577 — Damocles.
// The item remains owned after the sword falls, but the active marker and
// risk counter are consumed for the current Eden life.
actor C577Flag : Once {}

actor EdenDamoclesActive_F : Once {}
actor EdenDamoclesSpent_F : Once {}
actor EdenDamoclesRisk : Inventory {
  inventory.maxamount 20000
}

actor EdenDamoclesStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("EdenDamoclesSpent_F", 1, "AlreadyEnded")
    TNT1 A 0 A_JumpIfInventory("EdenDamoclesActive_F", 1, "AlreadyStarted")
    TNT1 A 0 A_GiveInventory("EdenDamoclesActive_F")
    TNT1 A 0 A_SpawnItemEx("EdenDamoclesWatcher_H")
    TNT1 A 0 A_SpawnItemEx("EdenDamocles")
    TNT1 A 0
    stop
   AlreadyStarted:
    TNT1 A 0
    stop
   AlreadyEnded:
    TNT1 A 0
    stop
  }
}

// The server-side watcher checks at 5/5/4 tic intervals. This gives 7.5
// checks per second while keeping the 4-tic cadence used by Isaac's rule.
actor EdenDamoclesWatcher_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    goto CheckA
   CheckA:
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    TNT1 A 0 A_JumpIfInTargetInventory("EdenDamoclesActive_F", 1, "WaitA")
    goto Cleanup
   WaitA:
    TNT1 A 5
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenDamoclesShouldFall"), "Drop")
    goto CheckB
   CheckB:
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    TNT1 A 0 A_JumpIfInTargetInventory("EdenDamoclesActive_F", 1, "WaitB")
    goto Cleanup
   WaitB:
    TNT1 A 5
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenDamoclesShouldFall"), "Drop")
    goto CheckC
   CheckC:
    TNT1 A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    TNT1 A 0 A_JumpIfInTargetInventory("EdenDamoclesActive_F", 1, "WaitC")
    goto Cleanup
   WaitC:
    TNT1 A 4
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenDamoclesShouldFall"), "Drop")
    goto CheckA
   Drop:
    TNT1 A 0 A_TakeFromTarget("EdenDamoclesActive_F", 1)
    TNT1 A 0 A_GiveToTarget("EdenDamoclesSpent_F", 1)
    TNT1 A 3 A_GiveToTarget("EdenDamoclesFall_P", 1)
    TNT1 A 0
    stop
   Cleanup:
    TNT1 A 0
    stop
  }
}

actor EdenDamoclesFall_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("rz_EdenDamoclesKill", 0)
    stop
  }
}

// The server-owned warper is deliberately not CLIENTSIDEONLY: it owns the
// authoritative hang/drop state and is replicated to clients.
actor EdenDamocles : BasicShieldWarper {
  -CLIENTSIDEONLY
  States {
   Spawn:
    DAMO A 0
    goto HangCheck
   HangCheck:
    DAMO A 0 A_JumpIf(CallACS("uh_PointerExists", 2) == 0, "Cleanup")
    DAMO A 0 A_JumpIfInTargetInventory("EdenDamoclesActive_F", 1, "Hang")
    DAMO A 0 A_JumpIfInTargetInventory("EdenDamoclesSpent_F", 1, "Drop")
    goto Cleanup
   Hang:
    DAMO A 0 A_SpawnItemEx("EdenDamoclesLineFX", 0, 0, 54, velx, vely, velz)
    DAMO A 1 A_Warp(AAPTR_TARGET, 0, 0, 128, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    goto HangCheck
   Drop:
    DAMO A 0 A_PlaySoundEx("misc/catcherdrop", "Body")
    DAMO A 0 ThrustThingZ(0, 10, 1, 1)
    DAMO A 1 A_JumpIf(z-floorz <= 0, "Landed")
    goto Drop
   Landed:
    DAMO L 1
    stop
   Cleanup:
    TNT1 A 0
    stop
  }
}

actor EdenDamoclesLineFX : BasicClientSide {
  States {
   Spawn:
    DAMO M 0
    DAMO M 1
    stop
  }
}

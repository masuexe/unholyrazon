actor C149Flag : Once {}

actor EdenIpecacDeath_F : Once {}

actor EdenTearIpecacApply_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenTearColor", EDEN_TEAR_EXPLOSIVE_DYE)
    TNT1 A 0 A_SetDamageType("EdenPoisonIpecac")
    TNT1 A 0 ThrustThingZ(0, 8, 0, 1)
    TNT1 A 0 A_GiveInventory("EdenIpecacDeath_F", 1)
    // Isaac: Ipecac + C-Section — fetus must not RIPPER; explode on first enemy hit.
    TNT1 A 0 A_ChangeFlag("RIPPER", false)
    stop
  }
}

// Tear death replace — given by rz_EdenTearRunDeath when EdenIpecacDeath_F is set.
actor EdenIpecacDeath_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Weapon")
    TNT1 A 0 A_Explode(CallACS("rz_GetEdenAttr", 2, 2, 0) / 2, 140, XF_HURTSOURCE, 0, 50)
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenIpecacMarkShooter")
    TNT1 A 0 A_RadiusGive("EdenIpecacPoisonStart_P", 140, RGF_PLAYERS|RGF_NOSIGHT|RGF_NOTARGET, 1)
    TNT1 A 0 A_SpawnItemEx("BasicBoom4FX_ColorX_Scale5", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

// Given by EdenIpecacDeath_P A_RadiusGive; shooter TID pre-marked by rz_EdenIpecacMarkShooter.
actor EdenIpecacPoisonStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("rz_EdenIpecacShouldPoison") == 0, "No")
    TNT1 A 0 ACS_NamedExecuteAlways("rz_EdenIpecacSpawnDoT", 0)
   No:
    TNT1 A 0
    stop
  }
}

// TRACER = victim, TARGET = shooter (set by ACS).
actor EdenIpecacPoisonDoT {
  +NOINTERACTION
  +NOGRAVITY
  +NOCLIP
  +NOTELEPORT
  +NOTIMEFREEZE
  var int user_left;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_left", 1)
   DoT:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
    TNT1 A 20 A_Warp(AAPTR_TRACER, 0, 0, 28, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("IpecacPoisonDamager", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SetUserVar("user_left", user_left - 1)
    TNT1 A 0 A_JumpIf(user_left <= 0, "Death")
    goto DoT
   Death:
    TNT1 A 0
    stop
  }
}

actor IpecacPoisonDamager : BasicExplosion {
  Translation "192:192=217:217", "198:198=221:221", "199:199=223:223", "202:202=214:214", "168:168=214:214", "4:4=214:214"
  damagetype "EdenIpecacPoison"
  Obituary "%o was poisoned by %k's deadly Ipecac toxicity."
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pokemon/FireSpin", 2, 0.75)
    TNT1 A 0 A_Explode(50, 15, 0, 0, 15)
    stop
  }
}

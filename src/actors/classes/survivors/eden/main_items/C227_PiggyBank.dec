actor C227Flag : UOnce {}

// Prevents repeated passive-application calls from granting the pickup
// reward more than once during this Eden life.
actor EdenPiggyBankPickup_F : UOnce {}

// Scaled for this mod's 25-coin spend threshold: drop two pennies, with a
// 50% chance for a third.
// DLCGoldCoin is this mod's ordinary one-value coin pickup.
actor EdenPiggyBankHit_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/coinget", "Weapon")
    TNT1 A 0 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    TNT1 A 0 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
    TNT1 A 0 A_Jump(128, "Pickup.Done")
    TNT1 A 0 A_SpawnItemEx("DLCGoldCoin", 0, 0, 8, random(-7, 7), random(-7, 7), random(4, 12), 0)
   Pickup.Done:
    TNT1 A 0
    stop
  }
}

actor C315Flag : UOnce {}

actor EdenStrangeAttractor_F : UOnce {}

// Spawn-applied: dye + mark tear so SpawnLoop can pull (razon3 SpawnCheck/SpawnFrame.StrangeAttractor).
actor EdenTearStrangeAttractorApply_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_EdenTearColor", EDEN_TEAR_ATTRACTOR_DYE)
    TNT1 A 0 A_GiveInventory("EdenStrangeAttractor_F", 1)
    stop
  }
}

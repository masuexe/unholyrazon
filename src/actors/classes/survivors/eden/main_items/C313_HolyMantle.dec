// C313 — one hit shield; recharges after 120 tics without stacking Buddha.
actor C313Flag : Once {}
actor EdenMantleController_F : Once {}
actor EdenMantleReady_F : Once {}
actor EdenMantleCooldown : Inventory { Inventory.MaxAmount 120 }

actor HolyMantleRegen_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("S3_K/U_Shield", "Body")
    TNT1 A 0 A_SpawnItemEx("HolyMantleWarper")
    stop
  }
}
actor HolyMantleBreak_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("Isaac/HolyMantleBreak", "Body")
    TNT1 A 0 A_SpawnItemEx("HolyMantleBreakFX", 0, 0, 32)
    stop
  }
}
actor HolyMantleWarper : BasicShieldWarper {
  -CLIENTSIDEONLY
  +BRIGHT
  +NOTIMEFREEZE
  States {
   Spawn:
    TNT1 A 0
   Shield:
    // Server controls deletion; remote clients always fall through to animation.
    1SMT A 0 A_JumpIf(!CallACS("rz_EdenMantleVisualValid"), "Cleanup")
    1SMT AABBCCDD 1 A_Warp(AAPTR_TARGET, 0, 0, 32, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    goto Shield
   Cleanup:
    TNT1 A 0
    stop
  }
}
actor HolyMantleBreakFX : BasicClientSide {
  // Pickup runs on the server, so replicate this short effect to every client.
  -CLIENTSIDEONLY
  States {
   Spawn:
    1SMT EFGHIJKL 1
    stop
  }
}

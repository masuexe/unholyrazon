// Brimstone main fire: charge, hold, then release a nine-segment beam.
actor Eden118_W_ScriptBar : ScriptBar {}
actor Eden118_W : Eden_W {
  States {
   Deselect:
    TNT1 A 0 A_TakeInventory("WeaponCharge")
    goto DeselectSwap

   EdenMainFire:
    6H59 A 2
    goto Charge0

   Charge0:
    6H59 A 0 A_JumpIfInventory("C149Flag", 1, "Charge0.Ipecac")
    6H59 A 0 A_JumpIfInventory("EdenTearsAttr", 3, "ChargeCheck")
    goto RapidFire
   Charge0.Ipecac:
    // Ignore Ipecac's +12 fire delay for Brimstone's charge/rapid split.
    6H59 A 0 A_JumpIfInventory("EdenTearsAttr", 15, "ChargeCheck")
    goto RapidFire
   ChargeCheck:
    6H59 A 0 A_JumpIfInventory("WeaponCharge", CallACS("rz_GetEdenBrimstoneAttr", 0, 1), "ChargeHold")
    6H59 A 1 Offset(0, 44) A_GiveInventory("WeaponCharge", 1 + CallACS("uh_checkrune", RUNE_RAGE))
    6H59 A 0 A_ReFire("Charge0")
    goto FireFailed

   ChargeHold:
    6H59 A 1 Offset(0, 48) A_RailWait
    6H59 A 0 A_ReFire("ChargeHold")
    goto ChargeFire

   ChargeFire:
    6H59 A 0 A_TakeInventory("WeaponCharge")
    6H59 A 0 A_JumpIfInventory("C222Flag", 1, "ChargeFire.AntiGravity")
    6H59 A 0 A_PlaySoundEx("Isaac/bloodlaser", "Weapon")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 1 Offset(0, 48) A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 Offset(0, 46) A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2

   ChargeFire.AntiGravity:
    6H59 A 0 A_FireCustomMissile("EdenBrimstoneAntiGravOrb", 0, 0, 0, 0)
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2

   RapidFire:
    6H59 A 0 A_TakeInventory("WeaponCharge")
    6H59 A 0 A_JumpIfInventory("C222Flag", 1, "RapidFire.AntiGravity")
    6H59 A 1 Offset(0, 48)
    6H59 A 0 A_PlaySoundEx("Isaac/bloodlaser", "Weapon")
   RapidFireHold:
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFetusFire_P")
    6H59 A 0 A_GiveInventory("EdenBrimstoneFire_P")
    6H59 A 1 A_SetTics(CallACS("rz_GetEdenBrimstoneAttr", 0, 1))
    6H59 A 1
    6H59 A 0 A_ReFire("RapidFireHold")
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2

   RapidFire.AntiGravity:
    6H59 A 1 Offset(0, 48)
   RapidFire.AntiGravityHold:
    6H59 A 0 A_FireCustomMissile("EdenBrimstoneAntiGravOrb", 0, 0, 0, 0)
    6H59 A 1 A_SetTics(CallACS("rz_GetEdenBrimstoneAttr", 0, 1))
    6H59 A 1
    6H59 A 0 A_ReFire("RapidFire.AntiGravityHold")
    6H59 A 2 Offset(0, 44)
    6H59 A 2 Offset(0, 40)
    6H59 A 2 Offset(0, 36)
    goto Ready2

   FireFailed:
    6H59 A 0 A_TakeInventory("WeaponCharge")
    goto Ready2

   EdenBotMainFire:
    6H59 A 1 Offset(0, 44) A_SetTics(CallACS("rz_GetEdenBrimstoneAttr", 0, 1))
    goto ChargeFire
  }
}

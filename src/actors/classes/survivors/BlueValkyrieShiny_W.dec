actor BlueValkyrieShiny_W_NormalBar : NormalBar {args 31, 47}
actor BlueValkyrieShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_BlueValkyrie_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_45_A"
Obituary "$OB_45W1"
weapon.ammotype "BlueHungerAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H45 [ 6
loop

Deselect:
7H45 O 0 A_GiveInventory("BlueValkyrieShieldDelay")
7H45 O 0 A_GiveInventory("StopShield")
goto DeselectSwap
Select:
7H45 O 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
7H45 O 1 ACS_NamedExecuteWithResult("core_weaponcolor", BLUEVALKYRIE_SDYE)
7H45 O 0 A_TakeInventory("StopShield")
7H45 O 0 A_GunFlash("Flash",1)
7H45 O 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready2:
7H45 O 2 A_WeaponReady
7H45 O 0 A_GiveInventory("BlueHungerAmmo",3)
loop

Fire:
7H45 B 0 A_JumpIfInventory("StopShield",1,2)
7H45 B 0 A_GunFlash("Flash.Wait",1)
7H45 B 0 A_GiveInventory("StopShield")
7H45 B 0 A_JumpIfInventory("DuoBusterFlag",1,"Fire2")
Fire1:
//7H45 B 2
7H45 C 2
7H45 D 2 A_GiveInventory("S_BlueValkyrie_Fire_P1")
7H45 EFG 2
TNT1 A 2 A_GiveInventory("BlueHungerAmmo",1)
TNT1 A 0 A_ReFire("Fire2")
TNT1 A 0 A_GiveInventory("DuoBusterFlag")
goto FireEnd
Fire2:
//7H45 H 2
7H45 I 2
7H45 J 2 A_GiveInventory("S_BlueValkyrie_Fire_P2")
7H45 KLM 2
TNT1 A 2 A_GiveInventory("BlueHungerAmmo",1)
TNT1 A 0 A_ReFire("Fire1")
TNT1 A 0 A_TakeInventory("DuoBusterFlag")
goto FireEnd

FireEnd:
7H45 N 2 A_WeaponReady(WRF_NOPRIMARY|WRF_DISABLESWITCH)
7H45 O 0 A_GunFlash("Flash",1)
7H45 O 0 A_GiveInventory("BlueHungerAmmo",2)
7H45 O 2 A_TakeInventory("StopShield")
Goto Ready2

Flash:
7H45 Z 0 A_JumpIfInventory("BlueValkyrieShieldDelay",1,6)
7H45 ZZYY 1 A_GiveInventory("BlueValkyrie_LowHP_P")
7H45 X 0 A_GiveInventory("BlueValkShieldHitbox_P")
7H45 X 1 A_GiveInventory("BlueValkyrie_LowHP_P")
wait
Flash.Wait:
7H45 YYZZ 1 A_GiveInventory("BlueValkyrie_LowHP_P")
TNT1 A 1 A_GiveInventory("BlueValkyrie_LowHP_P")
wait

AltFire:
7H45 O 0 A_JumpIfInventory("BlueHungerAmmo",100,"AltFireShot")
Goto Fire

AltFireShot:
7H45 B 0 A_JumpIfInventory("StopShield",1,2)
7H45 B 0 A_GunFlash("Flash.Wait",1)
7H45 B 0 A_GiveInventory("StopShield")
7H45 B 0 A_JumpIfInventory("DuoBusterFlag",1,"AltFireShot2")
AltFireShot1:
//7H45 B 2
7H45 C 2
7H45 D 2 A_GiveInventory("S_BlueValkyrie_Alt_P1")
7H45 EFG 2
TNT1 A 2
TNT1 A 0 A_JumpIfInventory("BlueHungerAmmo",100,1)
goto AltFireEnd
TNT1 A 0 A_ReFire("AltFireShot2")
goto AltFireEnd
AltFireShot2:
//7H45 H 2
7H45 I 2
7H45 J 2 A_GiveInventory("S_BlueValkyrie_Alt_P2")
7H45 KLM 2
TNT1 A 2
TNT1 A 0 A_JumpIfInventory("BlueHungerAmmo",100,1)
goto AltFireEnd2
TNT1 A 0 A_ReFire("AltFireShot1")
goto AltFireEnd2

AltFireEnd2:
TNT1 A 0 A_TakeInventory("DuoBusterFlag")
goto AltFireEnd+1
AltFireEnd:
TNT1 A 0 A_GiveInventory("DuoBusterFlag")
7H45 N 2 A_WeaponReady(WRF_DISABLESWITCH)
7H45 O 0 A_GunFlash("Flash",1)
7H45 O 2 A_TakeInventory("StopShield")
Goto Ready2


BotReady:
7H45 O 0 A_WeaponReady(12)
7H45 O 2 A_Refire("BotCheck")
7H45 O 0 A_GiveInventory("BlueHungerAmmo",3)
loop

BotCheck:
7H45 O 0 A_JumpIfInventory("StopShield",1,3)
7H45 O 0 A_GunFlash("Flash.Wait",1)
7H45 O 0 A_GiveInventory("StopShield")
7H45 O 0
7H45 O 0 A_JumpIfInventory("BotFlag2",1,"BotFire3")
7H45 O 0 A_Jump(12,"BotFireX")
7H45 O 0 A_Jump(28,"BotFire.J1")
BotFire.Jump1:
7H45 O 0 A_JumpIfInventory("BlueHungerAmmo",300,"BotFire.J2")
7H45 O 0 A_Jump(28,"BotFire2")
7H45 O 0 A_Jump(40,1)
goto BotFire1
7H45 O 0 A_GiveInventory("BlueHungerAmmo",random(30,90))
goto BotFire1

BotFire.J1:
7H45 O 0 A_Jump(12,"BotFireX")
7H45 O 0 A_PlaySoundEx("classes/taunt/bluevalkyrie_01","Voice")
7H45 O 0 A_Recoil(random(-3,3)*11)
7H45 O 0 A_Jump(128,2)
7H45 O 0 ThrustThing(angle*256/360+64,random(-50,50),1,0)
7H45 O 0 A_GiveInventory("BlueHungerAmmo",random(15,45))
goto BotFire.Jump1
BotFire.J2:
7H45 O 0 A_Jump(196,"BotFire2")
goto BotFire1

BotFireEnd:
7H45 N 0 A_GunFlash("Flash",1)
7H45 N 2 A_TakeInventory("StopShield")
Goto BotReady

BotFire1:
7H45 B 0 A_Jump(256,1,3)
7H45 B 0 A_GiveInventory("S_BlueValkyrie_Fire_P1")
7H45 B 0 A_Jump(256,2)
7H45 B 0 A_GiveInventory("S_BlueValkyrie_Fire_P2")
7H45 CDEFG 2
TNT1 A 2
TNT1 A 0 A_ReFire("BotCheck")
goto BotFireEnd

BotFire2:
7H45 H 0 A_Jump(256,1,3)
7H45 H 0 A_GiveInventory("S_BlueValkyrie_Alt_P1")
7H45 H 0 A_Jump(256,2)
7H45 H 0 A_GiveInventory("S_BlueValkyrie_Alt_P2")
7H45 IJKLM 2
TNT1 A 2
TNT1 A 0 A_JumpIfInventory("BotFlag1",1,2)
TNT1 A 0 A_ReFire("BotCheck")
goto BotFireEnd
TNT1 A 0 A_TakeInventory("BotFlag1",1)
TNT1 A 0 A_ReFire("BotFire2")
goto BotFireEnd

BotFire3:
7H45 K 0 A_JumpIfInventory("BlueHungerAmmo",30,4)
7H45 K 0 A_GiveInventory("S_BlueValkyrie_Alt_P1")
7H45 K 0 A_GiveInventory("BlueHungerAmmo",300)
7H45 K 0 A_Jump(256,2)
7H45 K 0 A_GiveInventory("S_BlueValkyrie_Fire_P1")
7H45 K 2 A_TakeInventory("BotFlag2",1)
7H45 T 2 A_TakeInventory("BlueHungerAmmo",35)
7H45 K 0 A_JumpIfInventory("BotFlag2",1,1)
goto BotFireEnd
7H45 K 0 A_Refire(1)
Goto BotFireEnd
7H45 K 0 A_JumpIfInventory("BlueHungerAmmo",30,4)
7H45 K 0 A_GiveInventory("S_BlueValkyrie_Alt_P2")
7H45 K 0 A_GiveInventory("BlueHungerAmmo",300)
7H45 K 0 A_Jump(256,2)
7H45 K 0 A_GiveInventory("S_BlueValkyrie_Fire_P2")
7H45 K 2 A_TakeInventory("BotFlag2",1)
7H45 T 2 A_TakeInventory("BlueHungerAmmo",35)
7H45 K 0 A_JumpIfInventory("BotFlag2",1,1)
goto BotFireEnd
7H45 K 0 A_Refire("BotFire3")
Goto BotFireEnd

BotFireX:
7H45 O 0 A_PlaySoundEx("classes/taunt/bluevalkyrie_01","Voice")
7H45 O 0 A_Jump(2,2)
7H45 O 0 A_GiveInventory("BotFlag1",random(2,5))
goto BotFire2
7H45 O 0 A_PlaySoundEx("GNT/KeyCollect","Auto")
7H45 O 0 A_GiveInventory("BotFlag2",512)
goto BotFire3

}
}

actor S_BlueValkyrie_Fire_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",11.5,0,-12,-10,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",5.625,0,-6,-5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",0,0,0,0,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",-5.625,0,6,5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",-11.5,0,12,10,1,0)

TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",8.4375,0,-9,-7.5,1,-4)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",2.8125,0,-3,-2.5,1,-2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",-2.8125,0,3,2.5,1,2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",-8.4375,0,9,7.5,1,4)
goto End
End:
TNT1 A 0 A_GiveInventory("BlueHungerAmmo",5)
TNT1 A 0 A_GiveInventory("StopShield")
TNT1 A 0 A_PlaySound("GNT/RNGShot",1)
stop
}
}
actor S_BlueValkyrie_Fire_P2 : S_BlueValkyrie_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",-11.5,0,12,-10,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",-5.625,0,6,-5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",0,0,0,0,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",5.625,0,-6,5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot1",11.5,0,-12,10,1,0)

TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",-8.4375,0,9,-7.5,1,-4)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",-2.8125,0,3,-2.5,1,-2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",2.8125,0,-3,2.5,1,2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash1",8.4375,0,-9,7.5,1,4)
goto End
}
}

actor S_BlueValkyrie_Alt_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot2",11.5,0,-12,-10,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot2",5.625,0,-6,-5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot2",0,0,0,0,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot2",-5.625,0,6,5,1,0)
TNT1 A 0 A_FireCustomMissile("S_BlueSwordShot2",-11.5,0,12,10,1,0)

TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash2",8.4375,0,-9,-7.5,1,-4)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash2",2.8125,0,-3,-2.5,1,-2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash2",-2.8125,0,3,2.5,1,2)
TNT1 A 0 A_FireCustomMissile("S_BlueValkSlash2",-8.4375,0,9,7.5,1,4)
goto End
End:
TNT1 A 0 A_ChangeVelocity(Cos(pitch)*20*4/3, 0, -sin(pitch)*11*7/6,CVF_RELATIVE)//20 11
TNT1 A 0 ThrustThingZ(0,8,0,1)
TNT1 A 0 A_TakeInventory("BlueHungerAmmo",50,1)
TNT1 A 0 A_TakeInventory("BlueHungerAmmo",50)
TNT1 A 0 A_PlaySound("GNT/Blue45",1)
stop
}
}

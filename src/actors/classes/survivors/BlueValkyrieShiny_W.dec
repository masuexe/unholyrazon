actor S_BlueSwordShot1 : BlueSwordShot1
{
Translation "192:192=31:31","198:198=47:47"
Obituary "$OB_S45M1"
Damage (132)//88
}

actor S_BlueSwordShot2 : BlueSwordShot2
{
Translation "192:192=31:31","198:198=47:47"
Obituary "$OB_S45A1"
Damage (149)//99
Args 132,128,20//88
}


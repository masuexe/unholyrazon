// TODO: add pinpoint visual like lightning bolt?

actor ThunderWep_QwantBar : QwantBar {
  args 3, 112
  Tag "ThunderCharge"
}

actor ThunderWep : BaseQwantWep
{
Weapon.SlotNumber 1
Obituary "%o found out from %k that \cfThunder \c-can strike more than once."
weapon.ammotype "ThunderCharge"
Tag "$TAG_THUNDER"
Inventory.Icon "PKMNI_E"
States
{
Spawn:
CHGB G 1
loop

Deselect:
CHGB A 0
goto DeselectSwap
Select:
CHGB A 0
goto SelectSwap

Ready:
CHGB A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ELECTRIC_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
CHGB A 0 A_TakeInventory("ThunderCharge")
CHGB A 8 A_WeaponReady
CHGB A 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
CHGB AB 1
CHGB A 0 A_SpawnItemEx("ThunderPKMN_Ammo_H",0,0,28)
FireHold:
CHGB C 0 A_JumpIfInventory("ThunderCharge",112,"FireCheck")
CHGB C 0 A_SpawnItemEx("ThunderPKMNFX",random(-32,32),random(-32,32),random(8,64))
CHGB C 1 A_GiveInventory("ThunderCharge",2) //C 2
CHGB C 0 A_Refire("FireHold")
goto FireCheck

FireCheck:
TNT1 A 0 A_JumpIfInventory("ThunderCharge",112,"Fire2")
TNT1 A 0 A_JumpIfInventory("ThunderCharge",44,"FireM")
Fire1:
CHGB C 2 A_GiveInventory("ThunderPKMN_P")
CHGB B 2 A_TakeInventory("ThunderCharge")
CHGB A 24 //10
goto ReadyX
FireM:
CHGB C 2 A_GiveInventory("ThunderPKMN_P")
CHGB C 2 A_TakeInventory("ThunderCharge")
CHGB B 4
CHGB A 24 //10
goto ReadyX
Fire2:
CHGB C 2 Offset(24, 44) A_GiveInventory("ThunderPKMN_P")
CHGB C 2 Offset(48, 64) A_TakeInventory("ThunderCharge")
CHGB C 2 Offset(44, 64)
CHGB B 2 Offset(36, 56)
CHGB B 2 Offset(16, 40)
CHGB B 2 Offset(8, 36)
CHGB A 24 A_WeaponReady(14)
goto ReadyX
}
}

Actor ThunderCounter : UOnce{}
Actor ThunderCharge : Ammo{inventory.amount 1 inventory.maxamount 112 +INVENTORY.IGNORESKILL}

Actor ThunderPKMN_Ammo_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 8 //gives enough time to register that you have at least one charge
goto Spawn2+4
Spawn2:
TNT1 AAAA 2
TNT1 A 0 A_GiveToTarget("MoveRelearnAmmo",1)
TNT1 A 0 A_JumpIfInTargetInventory("ThunderCharge",1,"Spawn2")
goto Death
}
}

Actor ThunderPKMN_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ThunderCharge",112,"Pickup2")
TNT1 A 0 A_JumpIfInventory("ThunderCharge",44,"PickupM")
TNT1 A 0 A_SpawnItemEx("ThunderPKMN",64,0,4,0,0,0,0,1)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,1)
stop
TNT1 A 0 A_SpawnItemEx("ThunderPKMN",64,0,4,0,0,0,15,1)
TNT1 A 0 A_SpawnItemEx("ThunderPKMN",64,0,4,0,0,0,-15,1)
stop
Pickup2:
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"PickupX")
TNT1 A 0 A_JumpIfInventory("ThunderCounter",1,"Pickup3")
TNT1 A 0 A_SpawnItemEx("ThunderPKMNSpawner_H1",64,0,4,0,0,0,0,1)
TNT1 A 0 A_GiveInventory("ThunderCounter",1)
stop
Pickup3:
TNT1 A 0 A_SpawnItemEx("ThunderPKMNSpawner_H2",64,0,4,0,0,0,0,1)
TNT1 A 0 A_TakeInventory("ThunderCounter",99)
stop
PickupX:
TNT1 A 0 A_SpawnItemEx("ThunderPKMNSpawner_H3",64,0,4,0,0,0,15,1)
stop
PickupM:
TNT1 A 0 A_SpawnItemEx("ThunderPKMNLineM_H",64,0,4,0,0,0,0,1)
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,1)
stop
TNT1 A 0 A_SpawnItemEx("ThunderPKMNLineM_H",64,0,4,0,0,0,15,1)
TNT1 A 0 A_SpawnItemEx("ThunderPKMNLineM_H",64,0,4,0,0,0,-15,1)
stop
}
}


Actor ThunderPKMNLine
{
PROJECTILE
+NOEXPLODEFLOOR
+FLOORHUGGER
+DONTBLAST
+DONTREFLECT
+THRUGHOST
+THRUACTORS
+RIPPER
Radius 4
Height 4
Speed 25
States
{
Spawn:
TNT1 A 0
TNT1 A 4 
TNT1 AAAAAAAAAAAA 4 A_SpawnItemEx("ThunderPKMN",0,0,0,0,0,0,0,1)
stop
}
}

Actor ThunderPKMNLineM : ThunderPKMNLine
{
States
{
Spawn:
TNT1 A 0
TNT1 A 4
TNT1 AAAAAAAA 4 A_SpawnItemEx("ThunderPKMN",0,0,0,0,0,0,0,1)
stop
}
}

actor ThunderPKMN : LightningBolt
{
DamageType "Thunder" //discuss about adding possible paralyze/slow effect to act as status from game series
Obituary "As %o found out, %k's \cfThunder\c- can strike more than once."
Renderstyle "Add"
Alpha 0.6
States
{
Spawn:
X_BC N 0
X_BC N 1 A_SpawnItemEx("ThunderExtend",0,0,355,0,0,0,0,1)
X_BC N 0 A_PlaySoundEx("weapon/lightningbolt","Weapon") //replace with pokemon version of sound effect - gen 1/2/3
X_BC N 0 A_Explode(150,192,0,0,24)
X_BC O 1
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(32,96),Random(32,96),32)
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(-32,-96),Random(-32,-96),64)
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(32,96),Random(32,96),96)
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(-32,-96),Random(-32,-96),128)
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(32,96),Random(32,96),160)
X_BC P 0 A_SpawnItemEx("ThunderPKMNFX",Random(-32,-96),Random(-32,-96),192)
X_BC PQR 1
Stop
}
}

Actor ThunderExtend : LightningExtend
{
Renderstyle "Add"
Alpha 0.6
States
{
Spawn:
X_BC S 0 
X_BC S 0 A_JumpIf(ceilingz-z<= 32,"Death")
X_BC S 0 A_SpawnItemEx("ThunderExtend",0,0,160,0,0,0,0,1)
X_BC SSTUV 1
stop
}
}

Actor ThunderPKMNFX : LightningBoltFX
{
Renderstyle "Add"
Alpha 0.6
Translation "192:192=228:228","198:198=229:229"
States
{
Spawn:
X_BC K 0
X_BC K 0 A_ChangeVelocity(Random(-2,2),Random(-2,2),Random(-2,2),CVF_REPLACE)
X_BC KLM 1
stop
}
}

Actor AnchorShotReturnFX : AnchorShotProjectile
{
+NOINTERACTION
+NOCLIP
+SEEKERMISSILE
Damage(0)
Radius 4
Height 4
Speed 55
Scale 3.0
States
{
Spawn:
6P17 B 0
6P17 B 0 A_FaceTarget
6P17 B 0 A_RearrangePointers(0,0,2)
goto Spawn2
Spawn2:
6P17 B 0 A_CountDown
6P17 B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
6P17 B 0 A_JumpIfCloser(48,"Death")
6P17 B 1 A_SeekerMissile(90,90,SMF_PRECISE)
Goto Spawn2
Death:
TNT1 A 0
stop
}
}

Actor AnchorShotReturnFXSpread : AnchorShotReturnFX{Scale 4.5}

Actor AnchorShotProjectileReturn : AnchorShotProjectile
{
Damagetype "AnchorShotReturn"
Obituary "%o forgot to dodge %k's Retracting Anchor."
-EXPLODEONWATER
+SEEKERMISSILE
+NOCLIP
+NOINTERACTION
Damage(0)
Height 8
Radius 8
Speed 55
Args 72,56,14
Reactiontime 45
States
{
Spawn:
ANCS B 0
ANCS B 0 A_FaceTarget
ANCS B 0 A_RearrangePointers(0,0,2)
ANCS B 0 A_Jump(256,"Spawn2")
goto Spawn2
Spawn2:
ANCS B 0 A_CountDown
ANCS B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathStop")
ANCS B 0 A_JumpIfCloser(48,"Death")
ANCS B 1 A_SeekerMissile(90,90,SMF_PRECISE)
ANCS B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathStop")
ANCS B 0 A_JumpIfCloser(48,"Death")
ANCS B 1 A_SeekerMissile(90,90,SMF_PRECISE)
ANCS B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathStop")
ANCS B 0 A_JumpIfCloser(48,"Death")
ANCS B 1 A_SeekerMissile(90,90,SMF_PRECISE)
ANCS B 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathStop")
ANCS B 0 A_JumpIfCloser(48,"Death")
ANCS B 1 A_SeekerMissile(90,90,SMF_PRECISE)
ANCS B 0 A_Explode(Args[0],Args[1],0,0,Args[2])
Goto Spawn2
Death:
TNT1 A 0 A_PlaySoundEx("weapon/adapterreturn","Weapon")
TNT1 A 0 A_TakeFromTarget("AnchorShotFlag",999)
stop
}
}

Actor AnchorShotProjectileReturn_S : AnchorShotProjectileReturn{Args 100,84,24 Scale 3.5}


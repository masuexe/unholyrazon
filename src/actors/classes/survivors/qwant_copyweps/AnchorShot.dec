actor AnchorShotWep_QwantBar : QwantBar {args 16}

actor AnchorShotWep : BaseQwantWep
{
Weapon.AmmoUse 4
Weapon.AmmoGive 28
Obituary "%o was thrown overboard by %k's \caAnchor Shot\c-."
weapon.ammotype "SteelTypeAmmo"
Tag "$TAG_ANCHORSHOT"
inventory.icon "PKMNI_S"
States
{
Spawn:
WEA2 W 1
loop

Deselect:
BUBB D 0
goto DeselectSwap
Select:
BUBB D 0
goto SelectSwap

Ready:
BUBB D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_STEEL_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
BUBB D 0 A_JumpIfInventory("SteelTypeAmmo",4,"ReadyX2")
BUBB D 8 A_WeaponReady(WRF_NOPRIMARY)
BUBB D 0 A_GiveInventory("SteelTypeAmmo",1)
BUBB D 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
BUBB D 8 A_WeaponReady
BUBB D 0 A_GiveInventory("SteelTypeAmmo",1)
BUBB D 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
BUBB D 0 A_TakeInventory("SteelTypeAmmo",2,1)
BUBB D 0 A_TakeInventory("SteelTypeAmmo",2)
BUBB D 0 A_GiveInventory("AnchorShot_P",1)
BUBB EF 4
BUBB D 2 A_GunFlash
goto FireWait
FireWait:
BUBB D 1 A_JumpIfInventory("AnchorShotFlag2",175,"FireEnd")
BUBB D 0 A_GiveInventory("AnchorShotFlag2",1)
BUBB D 0 A_JumpIfInventory("AnchorShotFlag",1,"FireWait")
Goto FireEnd
FireEnd:
BUBB D 0 A_TakeInventory("AnchorShotFlag",99)
BUBB D 2 A_TakeInventory("AnchorShotFlag2",999)
goto ReadyX
Flash:
TNT1 A 2 
TNT1 A 0 A_JumpIfInventory("AnchorShotFlag",1,1)
goto NoFlash
TNT1 A 2 
TNT1 A 0 A_JumpIfInventory("AnchorShotFlag",1,1)
goto NoFlash
TNT1 A 2 
TNT1 A 0 A_JumpIfInventory("AnchorShotFlag",1,1)
goto NoFlash
TNT1 A 2 
TNT1 A 0 A_JumpIfInventory("AnchorShotFlag",1,1)
goto NoFlash
TNT1 A 2
TNT1 A 0 A_JumpIfInventory("AnchorShotFlag",1,1)
goto NoFlash
TNT1 A 0 A_GiveInventory("MoveRelearnAmmo",1)
goto Flash
}
}

Actor AnchorShotFlag : UOnce{}
Actor AnchorShotFlag2 : CustomInventory{inventory.amount 1 inventory.maxamount 175}
Actor AnchorShotSlow : PowerSpeed{powerup.duration -3 Speed 0.7}

Actor AnchorShot_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("AnchorShotFlag",1)
TNT1 A 0 A_PlaySoundEx("weapon/magnetmissile","Weapon")
TNT1 A 0 A_JumpIfInventory("TruePowerItemFlag",1,"Pickup2")
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,2)
TNT1 A 0 A_SpawnItemEx("AnchorShotProjectile",0,0,24,cos(-pitch)*38,0,sin(-pitch)*38,0)
stop
TNT1 A 0 A_SpawnItemEx("AnchorShotProjectileSpread",0,0,24,cos(-pitch)*38,0,sin(-pitch)*38,0)
stop
Pickup2:
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,2)
TNT1 A 0 A_SpawnItemEx("S_AnchorShotProjectile",0,0,24,cos(-pitch)*38,0,sin(-pitch)*38,0)
stop
TNT1 A 0 A_SpawnItemEx("S_AnchorShotProjectileSpread",0,0,24,cos(-pitch)*38,0,sin(-pitch)*38,0)
stop
}
}

//For whatever reason this doesn't want to not produce rocks on wily barrels, why
Actor AnchorShotProjectile : BasicProjectile
{
Translation "192:192=93:93","198:198=5:5","199:199=88:88"
Damagetype "AnchorShot"
Obituary "%o was thrown overboard by %k's \caAnchor Shot\c-."
+EXPLODEONWATER
+FORCEXYBILLBOARD
+SKYEXPLODE
Damage(450)
Height 16
Radius 16
Speed 38 //28
Scale 2.0
Reactiontime 175
States
{
Spawn:
ANCS A 0
ANCS AAA 1 A_SpawnItemEx("AnchorShotReturnFX",0,0,0,0,0,0,0,1)
ANCS A 0 A_GiveInventory("UOnce",1)
Spawn2:
ANCS A 0 A_JumpIfInventory("CutterFlag",32,"SpawnDone")
ANCS A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathStop")
ANCS A 1 A_SpawnItemEx("AnchorShotReturnFX",-10,0,0,0,0,0,0,1)
ANCS A 0 A_GiveInventory("CutterFlag",1)
loop
SpawnDone:
ANCS A 0 A_SpawnItemEx("AnchorShotProjectileReturn",0,0,0,0,0,0,0,1)
stop
Crash:
XDeath:
TNT1 A 0 A_JumpIfInventory("UOnce",1,"DeathX")
goto Death+1
Death:
TNT1 A 0 A_JumpIfInventory("UOnce",1,"Death2")
TNT1 A 1 A_SpawnItemEx("AnchorShotProjectileReturn",0,0,0,0,0,0,0,1)
stop
Death2:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_AnchorShot_mob",36)
TNT1 A 0 A_PlaySoundEx("SJBOOM1","SoundSlot6")
TNT1 A 0 A_SpawnItemEx("AnchorShotProjectileReturn",0,0,0,0,0,0,0,1)
TNT1 AAA 0 A_SpawnItemEx("RockSlidePebbleBounce",0,0,0,random(4,6),0,random(3,5),random(0,359))
TNT1 A 1
TNT1 AAA 0 A_SpawnItemEx("RockSlidePebbleBounce",0,0,0,random(4,6),0,random(3,5),random(0,359))
TNT1 A 1
TNT1 AAA 0 A_SpawnItemEx("RockSlidePebbleBounce",0,0,0,random(4,6),0,random(3,5),random(0,359))
TNT1 A 1
TNT1 AAA 0 A_SpawnItemEx("RockSlidePebbleBounce",0,0,0,random(4,6),0,random(3,5),random(0,359))
stop
DeathX:
TNT1 A 0 ACS_NamedExecuteWithResult("uc_AnchorShot_mob",44) //48
TNT1 A 1 A_SpawnItemEx("AnchorShotProjectileReturn",0,0,0,0,0,0,0,1)
stop
DeathStop:
TNT1 A 0 A_TakeFromTarget("AnchorShotFlag")
stop
}
}


    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0] * -1, args[0] * -1, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0], args[0] * -1, 0, 1)
    TNT1 A 1 A_Explode(44 * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 1), 112, 0, 0, 16)

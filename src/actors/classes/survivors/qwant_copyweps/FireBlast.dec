actor FireBlastWep_QwantBar : QwantBar {args 1, 0, 5}

actor FireBlastWep : BaseQwantWep {
  Weapon.SlotNumber 5
  Obituary "%o was cooked by %k's \ciFire Blast\c-."
  Tag "$TAG_FIREBLAST"
  Weapon.AmmoType "FireTypeAmmo"
  Inventory.Icon "PKMNI_Fi"
  States {
   Spawn:
    6N01 B 1
    loop

   Deselect:
    FIRE G 0
    goto DeselectSwap
   Select:
    FIRE G 0
    goto SelectSwap

   Ready:
    FIRE G 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FIRE_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    FIRE G 0 A_JumpIfInventory("FireTypeAmmo", 7, "ReadyX2")
    FIRE G 8 A_WeaponReady(WRF_NOPRIMARY)
    FIRE G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    FIRE G 8 A_WeaponReady
    FIRE G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    FIRE H 0 A_GiveInventory("FireBlastVivifyFlag")
    FIRE H 0 A_ReFire(1)
    FIRE H 0 A_TakeInventory("FireTypeAmmo", 4, 1)
    FIRE H 2 A_TakeInventory("FireTypeAmmo", 3)
    FIRE I 0 A_PlaySoundEx("weapon/atomicfire", "Weapon")
    FIRE I 0 A_FireCustomMissile("FireBlastMain", 0, 0, 8, 0)
    FIRE I 0 A_JumpIfInventory("PlayerPropertyRage", 1, "FireRage")
    FIRE IIIII 8 A_GiveInventory("MoveRelearnAmmo", 1)
    goto FireEnd
   FireRage:
    FIRE IIIII 7 A_GiveInventory("MoveRelearnAmmo", 1)
    goto FireEnd
   FireEnd:
    FIRE HG 3
    FIRE G 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor FireBlastVivifyFlag : Once {}

actor FireBlastMain : BasicProjectile {
  Translation "192:192=227:227", "198:198=177:177"
  +BRIGHT
  +DONTBLAST
  +THRUGHOST
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  RenderStyle "Translucent"
  Alpha 0.85
  Speed 1
  Radius 14
  Height 18
  Scale 3.5
  States {
   Spawn:
    X_9G R 0
    X_9G R 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6554, 192)  // 0.1 * 65536
    X_9G R 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 0)
    X_9G R 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_9G R 0 A_JumpIfInventory("CutterFlag", 6, "Spawn2")
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 0, 8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, -8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, -8, 0, 1)
    X_9G R 0 A_GiveToTarget("UH_TargetMarker", 1)
    X_9G R 1 A_Warp(2, 48, 0, 28, 0, WARPF_NOCHECKPOSITION)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 0, 8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, -8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, -8, 0, 1)
    X_9G R 0 A_GiveToTarget("UH_TargetMarker", 1)
    X_9G S 1 A_Warp(2, 48, 0, 28, 0, WARPF_NOCHECKPOSITION)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 0, 8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, 0, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, -8, -8, 0, 1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 8, -8, 0, 1)
    X_9G R 0 A_GiveToTarget("UH_TargetMarker", 1)
    X_9G T 1 A_Warp(2, 48, 0, 28, 0, WARPF_NOCHECKPOSITION)
    X_9G R 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn+2
   Spawn2:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_aimattargetcursor", 0, CallACS("core_getptrtid", AAPTR_TARGET) + PLN_TARGETPOINT_OFFSET, 0)
    TNT1 A 2 A_SpawnItemEx("FireBlastMain2", 0, 0, 0, cos(-pitch) * 36, 0, sin(-pitch) * 36, 0, 1)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor FireBlastMain2 : FireBlastMain {
  -NOINTERACTION
  -NOCLIP
  Obituary "%k melted %o away with their \ciFire Blast\c-."
  DamageType "FireBlast"
  RenderStyle "Translucent"
  Speed 36
  Damage (120)
  Args 8
  States {
   Spawn:
    X_9G R 0
    X_9G R 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6554, 192)
    X_9G R 0 A_SetArg(0, args[0] * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 1))
    X_9G R 2 A_PlaySoundEx("weapon/firestorm", "Voice")
    X_9G R 0 A_ScaleVelocity(1.1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_9G S 2 A_PlaySoundEx("weapon/firestorm", "Voice")
    X_9G R 0 A_ScaleVelocity(1.1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_9G T 2 A_PlaySoundEx("weapon/firestorm", "Voice")
    X_9G R 0 A_ScaleVelocity(1.1)
    X_9G R 0 A_SpawnItemEx("Q_FireBlast_FX2", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn+2
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_SpawnItemEx("FireBlastExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
   DeathCont:
    TNT1 A 0 A_JumpIfInventory("KnightFlag", 15, "DeathStop")
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 4, "SoundPlay")
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 0, args[0], 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0] * -1, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0], 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0] * -1, args[0] * -1, 0, 1)
    TNT1 A 1 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0], args[0] * -1, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, 0, args[0], 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0] * -1, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0], 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0] * -1, args[0] * -1, 0, 1)
    TNT1 A 0 A_SpawnItemEx("Q_FireBlast_FX", 0, 0, 0, 0, args[0], args[0] * -1, 0, 1)
    TNT1 A 1 A_Explode(32 * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 1), 112, 0, 0, 16)
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    loop
   SoundPlay:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    TNT1 A 0 A_PlaySoundEx("Pokemon/FireSpin", "Voice")
    TNT1 A 0 A_GiveInventory("KnightFlag", 1)
    goto DeathCont
   DeathStop:
    TNT1 A 0
    stop
  }
}

actor FireBlastExplosion : BasicExplosion {
  +BRIGHT
  DamageType "FireBlastE"
  Obituary "%o did not get out of the way of %k's \ciFire Blast\c- in time."
  RenderStyle "Add"
  Args 180  // 280
  Scale 2.5
  States {
   Spawn:
    X_8B A 0
    X_8B A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_8B A 0 A_Explode(args[0] * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 1), 192, 0, 0, 32)
    X_8B ABCDEF 2
    stop
  }
}

actor Q_FireBlast_FX : BasicGraphicEffect {
  +BRIGHT
  Alpha 0.7
  Scale 2.5  // 2.0
  ReactionTime 3
  States {
   SpawnFrame:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6554, 192)
    TNT1 A 0 A_Jump(256, "R", "S", "T")
    goto R
   R:
    X_9G R 2 A_Countdown
    goto S
   S:
    X_9G S 2 A_Countdown
    goto T
   T:
    X_9G T 2 A_Countdown
    goto R
   Death:
    X_9G UV 1 A_Fadeout(0.3)
    stop
  }
}

actor Q_FireBlast_FX2 : Q_FireBlast_FX {
  Scale 3.5
  ReactionTime 10
  States {
   R:
    X_9G R 1
    X_9G R 0 A_SetScale(scaleX - 0.2, scaleY - 0.2)
    X_9G R 0 A_Countdown
    goto S
   S:
    X_9G S 1
    X_9G S 0 A_SetScale(scaleX - 0.2, scaleY - 0.2)
    X_9G S 0 A_Countdown
    goto T
   T:
    X_9G T 1
    X_9G T 0 A_SetScale(scaleX - 0.2, scaleY - 0.2)
    X_9G T 0 A_Countdown
    goto R
   Death:
    X_9G UUV 2 A_Fadeout(0.2)
    stop
  }
}


actor ThunderWaveWep_QwantBar : QwantBar {args 3, 0, 2}

actor ThunderWaveWep : BaseQwantWep {
  Weapon.SlotNumber 2
  Obituary "%o was electrified by %k's \ckThunder Wave\c-."
  Tag "Thunder Wave"
  Weapon.AmmoType "ElectricTypeAmmo"
  Inventory.Icon "PKMNI_E"
  States {
   Spawn:
    6N01 D 1
    loop

   Deselect:
    TDWV A 0
    goto DeselectSwap
   Select:
    TDWV A 0
    goto SelectSwap

   Ready:
    TDWV A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ELECTRIC_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    TDWV A 0 A_JumpIfInventory("ElectricTypeAmmo", 2, "ReadyX2")
    TDWV A 8 A_WeaponReady(WRF_NOPRIMARY)
    TDWV A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    TDWV A 8 A_WeaponReady
    TDWV A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    TDWV A 0 A_TakeInventory("ElectricTypeAmmo", 1, 1)
    TDWV A 0 A_TakeInventory("ElectricTypeAmmo", 1)
    TDWV A 0 A_PlaySoundEx("weapon/sparkshock", "Weapon")
    TDWV A 0 A_FireCustomMissile("ThunderWave", 0, 0, 8, 0)
    TDWV CB 4
    TDWV A 8 A_GiveInventory("MoveRelearnAmmo", 1)
    TDWV A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor ThunderWave : BasicProjectile {
  Translation "192:192=229:229", "198:198=218:218"
  Obituary "%o was electrified by %k's \ckThunder Wave\c-."  //
  DamageType "ThunderWave"
  +RIPPER
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Add"
  Damage (50)  // 42
  Radius 20
  Height 15
  Speed 38  // 35
  Scale 4.5
  States {
   Spawn:
    X_7G E 0
    X_7G EFGHGF 1 A_SpawnItemEx("ThunderWaveTrail", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn+1
   Death:
    TNT1 A 0 A_Explode(64, 96, 0, 0, 97)  // 33
    TMFX ABCD 3
    stop
  }
}

actor ThunderWaveTrail : NoiseCrushTrail1A {
  +BRIGHT
  RenderStyle "Add"
  Scale 4.5
  States {
   Spawn:
    X_7G HGFE 1
    stop
  }
}

/////////////////
// == Shiny == //
/////////////////

actor S_ThunderWave : ThunderWave {
  Damage (66)
  States {
   Death:
    TNT1 A 0 A_Explode(96, 96, 0, 0, 97)  // 33
    TMFX ABCD 3
    stop
  }
}

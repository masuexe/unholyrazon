actor ShadowForceWep_QwantBar : QwantBar {args 13}

Actor ShadowForceWep : BaseQwantWep
{
Obituary "%o was spooked by %k's \cmShadow Force\c-."
Tag "$TAG_SHADOWFORCE"
weapon.ammotype "GhostTypeAmmo"
inventory.icon "PKMNI_Gh"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6N01 N 1
loop

Deselect:
6H1N D 0 A_SetTranslucent(1.0,0) 
goto DeselectSwap
Select:
6H1N D 0
goto SelectSwap

Ready:
6H1N D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_GHOST_DYE, CLRF_QWANTMENU)//Q_SHADOWFORCE_DYE
goto ReadyX
ReadyX:
6H1N D 0 A_JumpIfInventory("GhostTypeAmmo",28,"ReadyX2")
6H1N D 8 A_WeaponReady(WRF_NOPRIMARY)
6H1N D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
6H1N D 8 A_WeaponReady
6H1N D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
6H1N D 0 A_JumpIfInventory("ShadowForceFlag",1,"Fire2")
6H1N D 0 A_PlaySoundEx("classes/hide","Weapon")
6H1N UVWX 2
6H1N Y 2 A_GiveInventory("MoveRelearnAmmo",1)
6H1N P 0 ACS_NamedExecuteWithResult("core_weaponcolor", WHITEOUTLINE_DYE,1)//Q_SHADOWFORCED_DYE
6H1N P 0 A_SetTranslucent(1.0,1)
6H1N P 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
6H1N P 0 A_GiveInventory("ShadowForceFlag",1)
6H1N P 6 //0
6H1N P 0 A_GiveInventory("MoveRelearnAmmo",1)
goto FireWait
FireWait:
6H1N P 4 A_WeaponReady(WRF_NOSECONDARY|WRF_NOSWITCH) //+1 on loop
6H1N P 0 A_TakeInventory("GhostTypeAmmo",1)
6H1N P 0 A_JumpIfInventory("GhostTypeAmmo",1,1)
goto Fire2
6H1N P 4 A_WeaponReady(WRF_NOSECONDARY|WRF_NOSWITCH) //+1 on loop
6H1N P 0 A_TakeInventory("GhostTypeAmmo",1)
6H1N P 0 A_GiveInventory("MoveRelearnAmmo",1)
6H1N P 0 A_JumpIfInventory("GhostTypeAmmo",1,"FireWait")
goto Fire2
Fire2:
6H1N P 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
6H1N P 0 A_TakeInventory("ShadowForceFlag",999)
6H1N P 0 A_TakeInventory("GhostTypeAmmo",28)
6H1N P 0 A_PlaySound("Weapon/junkend",1)
6H1N P 0 A_FireCustomMissile("Q_ShadowForce",0,0,8)
6H1N P 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_GHOST_DYE,1)//Q_SHADOWFORCE_DYE
6H1N P 0 A_SetTranslucent(1.0,0)
6H1N DD 8 A_GiveInventory("MoveRelearnAmmo",1) //-2
goto ReadyX
}
}

actor ShadowForceTimerFlag : Inventory
{
inventory.amount 1
Inventory.Maxamount 70
}

Actor ShadowForceFlag : UOnce{}

actor Q_ShadowForce : BasicExplosion
{
damagetype "ShadowForce"
Obituary "%o was spooked by %k's \cmShadow Force\c-."
+FORCERADIUSDMG
+OLDRADIUSDMG
+PIERCEARMOR
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode(500,450,0,0,45) //450,0,0,48
TNT1 A 0 A_SpawnItemEx("Q_ShadowForceFX_H")
TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("Q_ShadowForceFX",Random(-300,300),Random(-300,300),0,0,0,5,0,32)
TNT1 A 1
stop
}
}

actor Q_ShadowForceFX_H : BasicClientSide
{
Args 15,31,63
States
{
Spawn:
TNT1 A 0
Spawn0:
TNT1 A 0 A_SpawnItemEx("Q_ShadowForceFX",128,0,0,0,0,5,Args[0]*22.5f,0)
TNT1 A 0 A_CountDownArg(0,1)
loop
TNT1 A 3
Spawn1:
TNT1 A 0 A_SpawnItemEx("Q_ShadowForceFX",246,0,0,0,0,5,Args[1]*11.25f,0)
TNT1 A 0 A_CountDownArg(1)//,1)
loop
TNT1 A 3
Spawn2:
TNT1 A 0 A_SpawnItemEx("Q_ShadowForceFX",246,0,0,0,0,0,Args[2]*5.625f,0)
TNT1 A 0 A_CountDownArg(2)
loop
Death:
TNT1 A 1
stop
}
}

Actor Q_ShadowForceFX : BasicClientSide
{
//Translation "192:192=4:4","198:198=60:60"//Correct
//Translation "192:192=0:0","198:198=93:93"//Old
Translation "192:192=0:0","198:198=60:60"//Mix-Mix
+FORCEXYBILLBOARD
+BRIGHT
ReactionTime 15
Scale 2.0
States
{
Spawn:
TMFX OBCH 1 ThrustThingZ(0,1,0,1)
TMFX O 0 A_CountDown
loop
Death:
TNT1 A 1 
stop
}
}

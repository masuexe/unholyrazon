actor ShadowPunchWep_QwantBar : QwantBar {args 13}

Actor ShadowPunchWep : BaseQwantWep
{
Weapon.AmmoUse 28
Weapon.AmmoGive 14
Obituary "%o was spooked by %k's \cmShadow Punch\c-."
weapon.ammotype "GhostTypeAmmo"
Tag "$TAG_SHADOWPUNCH"
inventory.icon "PKMNI_Gh"
+WEAPON.NOAUTOAIM
States
{
Spawn:
SHFR K 1
loop

Deselect:
SHPU C 0 //A_SetTranslucent(1.0,0) 
goto DeselectSwap
Select:
SHPU C 0
goto SelectSwap

Ready:
SHPU C 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_GHOST_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
SHPU C 0 A_JumpIfInventory("GhostTypeAmmo",28,"ReadyX2")
SHPU C 8 A_WeaponReady(WRF_NOPRIMARY)
SHPU C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
SHPU C 8 A_WeaponReady
SHPU C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
SHPU C 0 A_JumpIfInventory("ShadowPunchTime",1,"FireX")
SHPU C 0 A_PlaySoundEx("classes/hide","Weapon")
SHPU C 1 A_GiveInventory("UH_90_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_80_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_70_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_60_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_50_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_40_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_30_AlphaPowerGiver")
SHPU C 1 A_GiveInventory("UH_20_AlphaPowerGiver")
SHPU C 0 A_GiveInventory("MoveRelearnAmmo",1)
SHPU C 1 A_GiveInventory("UH_10_AlphaPowerGiver")
SHPU C 2 A_GiveInventory("UH_00_AlphaPowerGiver")
SHPU C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
SHPU C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
SHPU C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
SHPU C 5 A_GiveInventory("ShadowPunchTime",1)
SHPU C 8 A_GiveInventory("MoveRelearnAmmo",1)
SHPU C 0 A_GiveInventory("MoveRelearnAmmo",1)

FireWait:
SHPU BBBBBBBB 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOSECONDARY) //+2
SHPU B 0 A_TakeInventory("GhostTypeAmmo",1)
SHPU B 0 A_GiveInventory("MoveRelearnAmmo",1)
SHPU B 0 A_JumpIfInventory("GhostTypeAmmo",1,"FireWait")
goto FireX

FireX:
SHPU B 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
SHPU B 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
SHPU B 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
SHPU B 0 A_PlaySoundEx("classes/reveal","Weapon")
SHPU B 0 A_JumpIfInventory("PlayerPropertyRage",1,1)
SHPU B 1 Offset(-12,27) A_TakeInventory("UH_00_AlphaPower")
SHPU B 1 Offset(-15,24) A_TakeInventory("ShadowPunchTime")
SHPU B 1 Offset(-18,21) A_JumpIfInventory("PlayerPropertyRage",1,1)
SHPU B 1 Offset(-21,18) A_TakeInventory("UH_10_AlphaPower")
SHPU B 1 Offset(-24,15) A_TakeInventory("GhostTypeAmmo")
SHPU B 0 Offset(-27,12) A_PlaySoundEx("BBA_Snd/shot_x","SoundSlot6")
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_20_AlphaPower")
SHPU B 0 Offset(-27,12) A_ChangeVelocity(15,0,0,CVF_RELATIVE)
SHPU B 1 Offset(-27,12) A_SpawnItemEx("ShadowPunched",0,0,24,cos(-pitch)*60,0,sin(-pitch)*60,0)
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_30_AlphaPower")
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_40_AlphaPower")
SHPU B 0 Offset(-27,12) A_ChangeVelocity(15,0,0,CVF_RELATIVE)
SHPU B 1 Offset(-27,12) A_SpawnItemEx("ShadowPunched",0,0,24,cos(-pitch)*60,0,sin(-pitch)*60,0)
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_50_AlphaPower")
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_60_AlphaPower")
SHPU B 0 Offset(-27,12) A_ChangeVelocity(15,0,0,CVF_RELATIVE)
SHPU B 1 Offset(-27,12) A_SpawnItemEx("ShadowPunched",0,0,24,cos(-pitch)*60,0,sin(-pitch)*60,0)
SHPU B 0 A_GiveInventory("MoveRelearnAmmo",1)
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_70_AlphaPower")
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_80_AlphaPower")
SHPU B 0 Offset(-27,12) A_ChangeVelocity(15,0,0,CVF_RELATIVE)
SHPU B 1 Offset(-27,12) A_SpawnItemEx("ShadowPunched",0,0,24,cos(-pitch)*60,0,sin(-pitch)*60,0)
SHPU B 0 Offset(-27,12) A_TakeInventory("UH_90_AlphaPower")
SHPU B 0 Offset(-27,12) A_ChangeVelocity(15,0,0,CVF_RELATIVE)
SHPU B 7 Offset(-27,12) A_SpawnItemEx("ShadowPunched",0,0,24,cos(-pitch)*60,0,sin(-pitch)*60,0)
SHPU B 8 Offset(-27,12) A_GiveInventory("MoveRelearnAmmo",1) //12
SHPU B 1 Offset(-24,15) A_JumpIfInventory("PlayerPropertyRage",1,1)
SHPU B 1 Offset(-21,18)
SHPU B 1 Offset(-18,21) A_JumpIfInventory("PlayerPropertyRage",1,1)
SHPU B 1 Offset(-15,24)
SHPU B 1 Offset(-12,27) A_GiveInventory("MoveRelearnAmmo",1)
goto ReadyX

NoAmmo:
SHPU C 1
goto ReadyX
}
}

actor ShadowPunchTime : UOnce{}
actor ShadowPunchTimerFlag : Inventory
{
inventory.amount 1
Inventory.Maxamount 112
}

actor ShadowPunched : BasicProjectile
{
// Translation "192:192=63:63","198:198=5:5"
Damagetype "ShadowPunch"  // will possibly need a protection for this 
Obituary "%o was spooked by %k's \cmShadow Punch\c-."
+DONTBLAST
Reactiontime 2
Damage (80)  //100
Radius 18
Height 12
Speed 60
Scale 1.0
var int user_NoTranslation;
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_CountDown
wait
Death:
TNT1 A 0
TNT1 A 1 A_Explode(100*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),64,0,0,16) //80,56,0,0,14
stop
}
}

Actor ShadowPunchHelper : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 2 A_TakeFromTarget("ShadowPunchTimerFlag",1)
TNT1 A 0 A_JumpIfInTargetInventory("ShadowPunchTimerFlag",1,"Spawn")
goto Death
Death:
TNT1 A 0
stop
}
}

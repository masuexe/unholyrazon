    TNT1 A 0 A_SpawnItemEx("S_FlameBurstSplit", 0, 0, 0, 10, 0, 10, -225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("S_FlameBurstSplit", 0, 0, 0, 10, 0, -10, 45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("S_FlameBurstSplit", 0, 0, 0, 10, 0, -10, -45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("S_FlameBurstSplit", 0, 0, 0, 10, 0, -10, 225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)

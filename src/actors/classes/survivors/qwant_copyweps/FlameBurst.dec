actor FlameBurstWep_QwantBar : QwantBar {args 1}

actor FlameBurstWep : BaseQwantWep {
  Obituary "%o was blasted by %k's \cgFlame Burst\c-."
  Tag "$TAG_FLAMEBURST"
  Weapon.AmmoType "FireTypeAmmo"
  Inventory.Icon "PKMNI_Fi"
  States {
   Spawn:
    6N01 B 1
    loop

   Deselect:
    PSGU A 0
    goto DeselectSwap
   Select:
    PSGU A 0
    goto SelectSwap

   Ready:
    PSGU A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FIRE_DYE, CLRF_QWANTMENU)
   ReadyX:
    PSGU A 0 A_JumpIfInventory("FireTypeAmmo", 2, "ReadyX2")
    PSGU A 8 A_WeaponReady(WRF_NOPRIMARY)
    PSGU A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    PSGU A 8 A_WeaponReady
    PSGU A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    PSGU A 0 A_TakeInventory("FireTypeAmmo", 1, 1)
    PSGU A 0 A_TakeInventory("FireTypeAmmo", 1)
    PSGU A 0 A_PlaySoundEx("Contra/C_FLAME", "Weapon")
    PSGU B 3 A_FireCustomMissile("FlameBurst", 0, 0, 8, 0)
    PSGU CB 3
    PSGU A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    PSGU A 8
    PSGU A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

// Flame Shot from Super C
actor FlameBurst : BasicProjectile {
  Translation "192:192=52:52", "198:198=225:225"
  damagetype "FlameBurst"
  +FORCEXYBILLBOARD
  +BRIGHT
  +SKYEXPLODE
  Damage (0)
  Radius 12
  Height 12
  Speed 70
  Scale 3.0
  States {
   Spawn:
    SCWP DE 1
    loop
   Death:
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, 10, 45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, 10, -45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, 10, 225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, 10, -225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, -10, 45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, -10, -45, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, -10, 225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("FlameBurstSplit", 0, 0, 0, 10, 0, -10, -225, SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
    stop
  }
}

actor FlameBurstSplit : BasicProjectile {
  damagetype "FlameBurst"
  +FORCEXYBILLBOARD
  +BRIGHT
  +DONTBLAST
  +HITTRACER
  Speed 10
  Damage (0)
  Radius 8
  Height 8
  Scale 2.0
  MeleeRange 16
  States {
   Spawn:
    SCWP DEDEDEDEDE 1
    Stop

   Crash:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsTracerPlayer"), "Death")
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_FlameBurstSplitDmg", meleerange)
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 1
    stop
  }
}

actor FlameBurstSplitDamager : BasicACSDamager {
  Damagetype "FlameBurst"
  Obituary "%o was blasted by %k's \cgFlame Burst\c-."
}


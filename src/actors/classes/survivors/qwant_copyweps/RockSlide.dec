actor RockSlideWep_QwantBar : QwantBar {args 12}

actor RockSlideWep : BaseQwantWep {
  Weapon.AmmoUse 20
  Weapon.AmmoGive 28
  Obituary "%o got crushed under %k's \csRock Slide\c-."
  weapon.ammotype "RockTypeAmmo"
  Tag "$TAG_ROCKSLIDE"
  inventory.icon "PKMNI_R"
  States {
   Spawn:
    WEA2 J 1
    loop

   Deselect:
    RCSL A 0
    goto DeselectSwap
   Select:
    RCSL A 0
    goto SelectSwap

   Ready:
    RCSL A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ROCK_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    RCSL A 0 A_JumpIfInventory("RockTypeAmmo", 28, "ReadyX2")
    RCSL A 8 A_WeaponReady(WRF_NOPRIMARY)
    RCSL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    RCSL A 8 A_WeaponReady
    RCSL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    RCSL A 0 A_PlaySoundEx("Pokemon/Detect", "Weapon")
    RCSL A 0 A_TakeInventory("RockTypeAmmo", 28)
    RCSL A 0 A_FireCustomMissile("RockSlidePinpoint", 0, 0, 8, 0)
    RCSL D 2
    RCSL AA 8 A_GiveInventory("MoveRelearnAmmo", 1)
    RCSL CB 2
    RCSL AAA 8 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX

   NoAmmo:
    RCSL A 1
    goto ReadyX
  }
}

actor RockSlidePinpoint : BasicFastProjectile {
  Translation "192:192=232:232", "198:198=234:234"
  PROJECTILE
  +THRUGHOST
  +DONTBLAST
  +DONTSPLASH
  +HITTRACER
  Renderstyle "Translucent"
  Alpha 0.75
  damage (0)
  radius 8
  height 8
  Speed 500
  Scale 3.0
  States {
   Spawn:
    TNT1 A 1
    loop
   Death:
    X_8E K 0 A_PlaySound("Pokemon/RageStart", CHAN_VOICE)
    X_8E KLMKLMKLMKLMKLMKLM 1 A_Warp(8, 0, 0, 28, 0) //-6 tics
    TNT1 A 0 A_SpawnItemEx("RockSlideSpawner", 0, 0, 28, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 1
    stop
  }
}

Actor RockSlideSpawner : BasicWatcher {
  Reactiontime 6
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 0 A_SpawnItemEx("RockSlidePebble", random(-250, 250), random(-250, 250), 350, 0, 0, random(-20, -35), 0)
    TNT1 AA 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 AAAAA 0 A_SpawnItemEx("RockSlidePebble", random(-250, 250), random(-250, 250), 350, 0, 0, random(-20, -35), 0)
    TNT1 AA 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 AAAAA 0 A_SpawnItemEx("RockSlidePebble", random(-250, 250), random(-250, 250), 350, 0, 0, random(-20, -35), 0)
    TNT1 AA 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 AA 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 AA 0 A_SpawnItemEx("RockSlide", random(-300, 300), random(-300, 300), 350, 0, 0, random(-45, -60), 0)
    TNT1 AAAAAA 1 A_Warp(8, 0, 0, 28, 0)
    TNT1 A 0 A_Countdown
    loop
  }
}

Actor RockSlidePebble : AstroCrush {
  Translation "192:192=232:232", "198:198=234:234"
  Obituary "%o was covered by %k's Rock Slide dust."
  Damagetype "RockSlide"
  +DONTBLAST
  +THRUGHOST
  Damage(35)
  Radius 8
  Height 10
  Speed 10
  Scale 0.5
  States {
   Spawn:
    QBOP D 0
    QBOP D 0 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    QBOP DDDDDDDDD 1 A_JumpIf(ceilingz-z>10, "Spawn2")
    QBOP D 0 A_JumpIf(momz==0, "Death")
    QBOP D 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    QBOP D 0 A_ChangeFlag("RIPPER", 0)
    QBOP D 0 A_ChangeFlag("NOINTERACTION", 0)
    QBOP DDD 3 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    QBOP D 0 A_JumpIf(momz==0, "Death")
    QBOP D 0 A_CountDown
    Goto Spawn2+2
   Death:
    QBOP D 0 A_SpawnItemEx("RockSlidePebbleBounce", 0, 0, 4, random(5, 10), 0, random(2, 8), random(0, 359))
    stop
  }
}

Actor RockSlide : AstroCrush {
  Translation "192:192=232:232", "198:198=234:234"
  Obituary "%o was caught under %k's \csRock Slide\c-."
  Damagetype "RockSlide"
  +DONTBLAST
  +THRUGHOST
  Damage(50) //55
  Scale 2.0
  Radius 12
  Height 16
  States {
   Spawn:
    QBOP D 0
    QBOP D 0 A_PlaySound("Pokemon/HornAttack", CHAN_6, 0.25, 0)
    QBOP D 0 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    QBOP DDDDDDDDD 1 A_JumpIf(ceilingz-z>16, "Spawn2")
    QBOP D 0 A_JumpIf(momz==0, "Death")
    QBOP D 0 A_CountDown
    Goto Spawn+3
   Spawn2:
    QBOP D 0 A_ChangeFlag("RIPPER", 0)
    QBOP D 0 A_ChangeFlag("NOINTERACTION", 0)
    QBOP DDD 3 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    QBOP D 0 A_JumpIf(momz==0, "Death")
    QBOP D 0 A_CountDown
    Goto Spawn2+2
   Death:
    QBOP D 0
    QBOP DDD 0 A_SpawnItemEx("RockSlidePebbleBounce", 0, 0, 4, random(5, 10), 0, random(2, 8), random(0, 359))
    QBOP D 0 A_ChangeFlag(NOGRAVITY, 1)
    QBOP D 0 A_Explode(100, 128, 0, 0, 24) //80 dmg, 16 frad
    stop
  }
}

Actor RockSlidePebbleBounce {
  Translation "192:192=232:232", "198:198=234:234"
  PROJECTILE
  +CLIENTSIDEONLY
  -NOGRAVITY
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +DONTSPLASH
  +CANBOUNCEWATER
  Bouncefactor 0.6
  Bouncecount 5
  Scale 0.5
  Damage(0)
  States {
   Spawn:
    QBOP D 1
    loop
   Death:
    TNT1 A 0
    stop
  }
}


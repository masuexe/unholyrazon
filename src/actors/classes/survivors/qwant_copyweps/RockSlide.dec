actor S_RockSlidePebble : RockSlidePebble {Damage (60) States {Death: QBOP D 0 A_SpawnItemEx("S_RockSlidePebbleBounce", 0, 0, 4, random(5, 10), 0, random(2, 8), random(0, 359)) stop}}

actor S_RockSlide : RockSlide {
  Damage (90)
  States {
   Death:
    QBOP D 0
    QBOP DDD 0 A_SpawnItemEx("S_RockSlidePebbleBounce", 0, 0, 4, random(5, 10), 0, random(2, 8), random(0, 359))
    QBOP D 0 A_ChangeFlag(NOGRAVITY, 1)
    QBOP D 0 A_Explode(140, 128, 0, 0, 24)
    stop
  }
}

actor S_RockSlidePebbleBounce : RockSlidePebbleBounce {}

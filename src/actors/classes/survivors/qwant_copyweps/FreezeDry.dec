actor FreezeDryWep_QwantBar : QwantBar {args 5}

actor FreezeDryWep : BaseQwantWep {
  Obituary "%o was dried out by %k's \cnFreeze Dry\c-."
  Tag "$TAG_FREEZEDRY"
  Weapon.AmmoType "IceTypeAmmo"
  Inventory.Icon "PKMNI_I"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6N01 F 1
    loop

   Deselect:
    ICES D 0
    goto DeselectSwap
   Select:
    ICES D 0
    goto SelectSwap

   Ready:
    ICES D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ICE_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    ICES D 0 A_JumpIfInventory("IceTypeAmmo", 1, "ReadyX2")
    ICES D 8 A_WeaponReady(WRF_NOPRIMARY)
    ICES D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    ICES D 8 A_WeaponReady
    ICES D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    ICES E 2
   FireHold:
    ICES F 0 A_JumpIfInventory("IceTypeAmmo", 1, 1)
    goto FireEnd
    ICES F 0 A_TakeInventory("IceTypeAmmo", 1, 1)
    ICES F 0 A_PlaySoundEx("CBM/WindLoop", "Weapon")
    ICES FFF 1 A_FireCustomMissile("FreezeDry", random(-5, 5), 0, random(-30, 30), -10)
    ICES F 0 A_ReFire(1)
    goto ReadyX
    ICES F 0 A_JumpIfInventory("IceTypeAmmo", 1, 1)
    goto FireEnd
    ICES F 0 A_TakeInventory("IceTypeAmmo", 1, 1)
    ICES F 0 A_PlaySoundEx("CBM/WindLoop", "Weapon")
    ICES FFF 1 A_FireCustomMissile("FreezeDry", random(-5, 5), 0, random(-30, 30), -10)
    ICES F 0 A_ReFire(1)
    goto ReadyX
    ICES F 0 A_JumpIfInventory("IceTypeAmmo", 1, 1)
    goto FireEnd
    ICES F 0 A_TakeInventory("IceTypeAmmo", 1, 1)
    ICES F 0 A_PlaySoundEx("CBM/WindLoop", "Weapon")
    ICES FFF 1 A_FireCustomMissile("FreezeDry", random(-5, 5), 0, random(-30, 30), -10)
    ICES F 0 A_GiveInventory("MoveRelearnAmmo", 1)
    ICES F 0 A_ReFire("FireHold")
    goto ReadyX
   FireEnd:
    ICES ED 2
    goto ReadyX
  }
}

actor FreezeDry : BasicProjectile {
  Translation "192:192=200:200", "198:198=154:154"
  +NOEXPLODEFLOOR
  Scale 4.0
  DamageType "FreezeDry"
  Speed 34  // 45
  Damage (28)
  Height 18
  Radius 18
  Args 3
  States {
   Spawn:
    6Q28 A 0
    6Q28 A 0 ThrustThing(angle * 256 / 360, 4, 1, 0)
    6Q28 A 0 ThrustThingZ(0, args[0], 0, 1)
    6Q28 A 0 A_FadeOut(0.06)
    6Q28 A 1  // A_SetArg(0,args[0]+1)
    6Q28 A 0 ThrustThingZ(0, args[0], 0, 1)
    6Q28 A 0 A_FadeOut(0.06)
    6Q28 A 1 A_SetArg(0, args[0] + 1)
    6Q28 A 0 ThrustThingZ(0, args[0], 0, 1)
    6Q28 A 0 A_FadeOut(0.06)
    6Q28 A 1 A_SetArg(0, args[0] + 1)
    goto Spawn+2
   Death:
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    stop
  }
}

/////////////////
// == Shiny == //
/////////////////

actor S_FreezeDry : FreezeDry {Damage (38)}

actor IceBeamWep_QwantBar : QwantBar {args 5, 0, 3}

actor IceBeamWep : BaseQwantWep {
  Weapon.SlotNumber 3
  Obituary "%o was frozen by %k's \cnIce Beam\c-."
  Tag "$TAG_ICEBEAM"
  Weapon.AmmoType "IceTypeAmmo"
  Inventory.Icon "PKMNI_I"
  States {
   Spawn:
    6N01 F 1
    loop

   Deselect:
    ICES D 0
    goto DeselectSwap
   Select:
    ICES D 0
    goto SelectSwap

   Ready:
    ICES D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ICE_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    ICES D 0 A_JumpIfInventory("IceTypeAmmo", 1, "ReadyX2")
    ICES D 8 A_WeaponReady(WRF_NOPRIMARY)
    ICES D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    ICES D 8 A_WeaponReady
    ICES D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    ICES E 0 A_PlaySoundEx("Pokemon/AeroBlast1", "Weapon")
    ICES EF 6  // E 10 F 5
    ICES F 0 A_ReFire("Hold")
    ICES F 0 A_TakeInventory("IceTypeAmmo", 1, 1)
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 0 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    goto ILetGo
   Hold:
    ICES F 0 A_JumpIfInventory("IceTypeAmmo", 1, 1)
    goto ILetGo
    ICES F 0 A_TakeInventory("IceTypeAmmo", 1, 1)
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 1 A_ReFire(1)
    goto ILetGo
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 1 A_ReFire(1)
    goto ILetGo
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 1 A_ReFire(1)
    goto ILetGo
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 1 A_ReFire(1)
    goto ILetGo
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 1 A_ReFire(1)
    goto ILetGo
    ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    ICES F 1 A_FireCustomMissile("IceBeam", 0, 0, 8, 0)
    ICES F 0 A_GiveInventory("MoveRelearnAmmo", 1)
    ICES F 1 A_ReFire("Hold")
    goto ILetGo
   ILetGo:
    ICES ED 8 A_GiveInventory("MoveRelearnAmmo", 1)  // 10
    goto ReadyX
  }
}

actor ICEBEAM : BasicFastProjectile {
  Translation "4:4=201:201, 197:197=206:206"
  DamageType "IceBeam"
  +DONTSPLASH
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Add"
  Damage (18)  // 14
  Speed 300
  Radius 2
  Height 2
  States {
   Spawn:
    GEMI A 1 A_SpawnItemEx("ICELAZORTrail1", 0, 0, 0, (velx), (vely), velz, 0, 8)
    GEMI A 0 A_SpawnItemEx("ICELAZORTrail2", 0, 0, 0, (velx), (vely), velz, 0, 8)
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    stop
  }
}

actor ICELAZORTrail1 : BasicProjectile {
  Translation "4:4=201:201", "197:197=206:206"
  DamageType "IceBeam"
  +DONTSPLASH
  +NOINTERACTION
  +FORCEXYBILLBOARD
  +BRIGHT
  RenderStyle "Add"
  Scale 2.0
  Speed 50
  Height 10
  Radius 10
  ReactionTime 5
  States {
   Spawn:
    GEMI A 0
    GEMI A 0 A_ScaleVelocity(0.8)
    GEMI A 5
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    stop
  }
}

actor ICELAZORTrail2 : ICELAZORTrail1 {
  +DONTSPLASH
  States {
   Spawn:
    GEMI A 0
    GEMI A 0 A_ScaleVelocity(0.6)
    GEMI A 5
    stop
  }
}

/////////////////
// == Shiny == //
/////////////////

actor S_QwantIceBeam_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("Pokemon/IceBeamEnd", "Weapon")
    TNT1 A 0 A_FireCustomMissile("S_IceBeam", 0, 0, 8, 0)
    stop
  }
}

actor S_IceBeam : ICEBEAM {
  Damage (28)
  States {
   Spawn:
    GEMI A 1 A_SpawnItemEx("S_IceBeamTrail1", 0, 0, 0, (velx), (vely), velz, 0, 8)
    GEMI A 0 A_SpawnItemEx("S_IceBeamTrail2", 0, 0, 0, (velx), (vely), velz, 0, 8)
    loop
  }
}

actor S_IceBeamTrail1 : ICELAZORTrail1 {}

actor S_IceBeamTrail2 : S_IceBeamTrail1 {
  +DONTSPLASH
  States {
   Spawn:
    GEMI A 0
    GEMI A 0 A_ScaleVelocity(0.6)
    GEMI A 5
    stop
  }
}

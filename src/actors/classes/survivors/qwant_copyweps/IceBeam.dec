actor IceBeamWep_QwantBar : QwantBar {args 5}

actor IceBeamWep : BaseQwantWep
{
Obituary "%o was frozen by %k's \cnIce Beam\c-."
Tag "$TAG_ICEBEAM"
weapon.ammotype "IceTypeAmmo"
inventory.icon "PKMNI_I"
States
{
Spawn:
6N01 F 1
loop

Deselect:
ICES D 0
goto DeselectSwap
Select:
ICES D 0
goto SelectSwap

Ready:
ICES D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_ICE_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
ICES D 0 A_JumpIfInventory("IceTypeAmmo",1,"ReadyX2")
ICES D 8 A_WeaponReady(WRF_NOPRIMARY)
ICES D 0 A_GiveInventory("IceTypeAmmo",1)
ICES D 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
ICES D 8 A_WeaponReady
ICES D 0 A_GiveInventory("IceTypeAmmo",1)
ICES D 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
ICES E 0 A_PlaySoundEx("Pokemon/AeroBlast1","Weapon")
ICES EF 6 //E 10 F 5
ICES F 0 A_Refire("Hold")
ICES F 0 A_TakeInventory("IceTypeAmmo",1,1)
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 0 A_FireCustomMissile("IceBeam",0,0,8,0)
Goto ILetGo
Hold:
ICES F 0 A_JumpIfInventory("IceTypeAmmo",1,1)
goto ILetGo
ICES F 0 A_TakeInventory("IceTypeAmmo",1,1)
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 1 A_Refire(1)
Goto ILetGo
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 1 A_Refire(1)
Goto ILetGo
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 1 A_Refire(1)
Goto ILetGo
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 1 A_Refire(1)
Goto ILetGo
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 1 A_Refire(1)
Goto ILetGo
ICES F 0 A_PlaySoundEx("Pokemon/IceBeamEnd","Weapon")
ICES F 1 A_FireCustomMissile("IceBeam",0,0,8,0)
ICES F 0 A_GiveInventory("MoveRelearnAmmo",1)
ICES F 1 A_Refire("Hold")
Goto ILetGo
ILetGo:
ICES ED 8 A_GiveInventory("MoveRelearnAmmo",1)//10
goto ReadyX
}
}

actor ICEBEAM : BasicFastProjectile
{
Translation "4:4=201:201, 197:197=206:206"
damagetype "IceBeam"
+DONTSPLASH
+FORCEXYBILLBOARD
+BRIGHT
Renderstyle add
damage (18) //14
speed 300
Radius 2
Height 2
scale 2.5
States
{
Spawn:
GEMI A 1 A_SpawnItemEx("ICELAZORTrail1",0,0,0,(momx),(momy),(momz),0,8)
GEMI A 0 A_SpawnItemEx("ICELAZORTrail2",0,0,0,(momx),(momy),(momz),0,8)
loop
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
stop
}
}

actor ICELAZORTrail1 : BasicProjectile
{
Translation "4:4=201:201", "197:197=206:206"
damagetype "IceBeam"
+DONTSPLASH
+NOINTERACTION
+FORCEXYBILLBOARD
+BRIGHT
Renderstyle add
scale 2.0
speed 50
height 10
radius 10
reactiontime 5
States
{
Spawn:
GEMI A 0
GEMI A 0 A_ScaleVelocity(0.8)
GEMI A 5
stop
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
stop
}
}

actor ICELAZORTrail2 : ICELAZORTrail1
{
+DONTSPLASH
States
{
Spawn:
GEMI A 0
GEMI A 0 A_ScaleVelocity(0.6)
GEMI A 5
stop
}
}

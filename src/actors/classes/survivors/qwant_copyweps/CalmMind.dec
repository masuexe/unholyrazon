actor CalmMindWep_QwantBar : QwantBar {args 10}

actor CalmMindWep : BaseQwantWep {
  Weapon.AmmoUse 56
  Weapon.AmmoGive 56
  Tag "$TAG_CALMMIND"
  Weapon.AmmoType "PsychicTypeAmmo"
  Inventory.Icon "PKMNI_Ps"
  States {
   Spawn:
    6N01 K 1
    loop

   Deselect:
    TRIP C 0
    goto DeselectSwap
   Select:
    TRIP C 0
    goto SelectSwap

   Ready:
    TRIP C 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_PSYCHIC_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    TRIP C 0 A_JumpIfInventory("PsychicTypeAmmo", 56, "ReadyX2")
    TRIP C 8 A_WeaponReady(WRF_NOPRIMARY)
    TRIP C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    TRIP C 8 A_WeaponReady
    TRIP C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    TRIP C 0 A_TakeInventory("PsychicTypeAmmo", 28, 1)
    TRIP C 0 A_TakeInventory("PsychicTypeAmmo", 28)
    TRIP C 0 A_PlaySoundEx("Pokemon/StatRaise", "Weapon")
    TRIP C 0 A_GiveInventory("CalmMindFlag", 350)
    TRIP C 0 A_GiveInventory("CalmMind_PowerProtection")
    TRIP C 0 A_GiveInventory("CalmMind_PowerDamage")
    // TRIP C 0 A_GiveInventory("CalmMind_PowerDamageDelay",1)
    TRIP C 0 A_SpawnItemEx("CalmMindHelper", 0, 0, 28)
    TRIP ED 4
    TRIP CC 8 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor CalmMindFlag : Inventory {
  Inventory.MaxAmount 350
}

// Note: Bring up talking point for later: leave as-is or allow for up to 5-6 stacks of move going from 1.2-2x dmg.
// Should protection be added for various damagetypes? If yes, same as above or no?
// In-Game, buffed moves that were considered as special type; here, energy/element moves will be buffed instead, with respect to
// their damage types in the game(s) themselves.

// actor CalmMind_PowerDamageDelay : Powerup{powerup.duration -10}
actor CalmMind_PowerDamage : PowerDamage {
  DamageFactor "ThunderPKMN", 1.3
  DamageFactor "DragonBreath", 1.3
  DamageFactor "HiddenPower", 1.3
  DamageFactor "ChargeBeam", 1.3
  DamageFactor "DazzlingGleam", 1.3
  DamageFactor "FireBlast", 1.3
  DamageFactor "FlameBurst", 1.3
  DamageFactor "FreezeDry", 1.3
  DamageFactor "IceBeam", 1.3
  DamageFactor "MoonBlast", 1.3
  DamageFactor "SonicBoom", 1.3
  DamageFactor "ThunderWave", 1.3
  DamageFactor "WaterSpout", 1.3
  powerup.duration -10
  powerup.color "Purple", 0.15
}

actor CalmMind_PowerProtection : PowerProtection {
  Powerup.Duration -10
  damagefactor "Normal", 0.8
}

actor CalmMindHelper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
   Spawn2:
    TNT1 AA 1 A_Warp(2, 0, 0, 28, 0)
    TNT1 A 0 A_SpawnItemEx("CalmMindBuffFX", 64, 0, random(-8, -16), 0, 0, random(2, 6), random(0, 359))
    TNT1 A 0 A_TakeFromTarget("CalmMindFlag", 2)
    TNT1 A 0 A_JumpIfInTargetInventory("CalmMindFlag", 1, "Spawn2")
    goto Death
   Death:
    TNT1 A 0 A_TakeFromTarget("CalmMind_PowerDamage")
    TNT1 A 0 A_TakeFromTarget("CalmMind_PowerProtection")
    stop
  }
}

actor CalmMindBuffFX : BasicClientside {
  Translation "160:167=57:57", "228:229=57:57"
  Scale 1.0
  States {
   Spawn:
    BUFF A 5
    goto Death
   Death:
    BUFF A 1 A_Fadeout(0.22)
    loop
  }
}

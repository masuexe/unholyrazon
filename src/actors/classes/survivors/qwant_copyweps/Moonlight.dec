//Pik noted: He would like to see some form of indicator on the HP Bar to show immediate indication of how much a use
//of Moonlight would heal. Hard to say yes to for others, but for the user it seems more reasonable.

actor MoonlightWep_QwantBar : QwantBar {args 17}

actor MoonlightWep : BaseQwantWep {
  Weapon.AmmoUse 56
  Weapon.AmmoGive 28 //change to 28 if needed
  Tag "$TAG_MOONLIGHT"
  weapon.ammotype "FairyTypeAmmo"
  inventory.icon "PKMNI_Fy"
  States {
   Spawn:
    MNBL B 1
    loop

   Deselect:
    MNBL C 0
    goto DeselectSwap
   Select:
    MNBL C 0
    goto SelectSwap

   Ready:
    MNBL C 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FAIRY_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    MNBL C 0 A_JumpIfInventory("FairyTypeAmmo", 56, "ReadyX2")
    MNBL C 8 A_WeaponReady(WRF_NOPRIMARY)
    MNBL C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    MNBL C 8 A_WeaponReady
    MNBL C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    MNBL C 0 A_TakeInventory("FairyTypeAmmo", 28, 1)
    MNBL C 0 A_TakeInventory("FairyTypeAmmo", 28)
    MNBL C 0 A_PlaySoundEx("Pokemon/Detect", "Weapon")
    MNBL C 0 A_GiveInventory("MoonlightPU")
    MNBL C 0 A_SpawnItemEx("MoonlightVisual", 0, 0, 256)
    MNBL C 0 A_SpawnItemEx("MoonlightHealHelper", 0, 0, 28)
    MNBL EDC 3 //ED 3
    MNBL CC 8 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor MoonlightPU : Powerup {powerup.duration -5}

actor MoonlightVisual : BasicShieldWarper {
  Translation "192:192=208:208", "198:198=215:215"
  Renderstyle "Translucent"
  Alpha 0.0
  var int user_MoonH;
  Scale 3.0
  States {
   Spawn:
    MNBL A 0
    MNBL A 0 A_SetUserVar("user_MoonH", 256)
   Spawn2:
    MNBL A 0 A_JumpIfInventory("CutterFlag", 10, "Spawn3")
    MNBL A 0 A_FadeIn(0.1)
    MNBL A 0 A_SetUserVar("user_MoonH", user_MoonH+6)
    MNBL A 1 A_Warp(2, 0, 0, user_MoonH, 0)
    MNBL A 0 A_GiveInventory("CutterFlag", 1)
    loop
   Spawn3:
    MNBL A 1 A_Warp(2, 0, 0, user_MoonH, 0)
    MNBL A 0 A_JumpIfInTargetInventory("MoonlightPU", 1, "Spawn3")
    goto Death
   Death:
    MNBL A 0 A_SetUserVar("user_MoonH", user_MoonH+8)
    MNBL A 0 A_Warp(2, 0, 0, user_MoonH, 0)
    MNBL A 1 A_FadeOut(0.1)
    loop
  }
}

//Note: Discussion point - What happens when 2+ Moonlight fields overlap? Reduced effect? Cannot heal?
//What about in normal classes play? It would inevitably have to somehow check for boss file only items and if not,
//would only heal the owner.
Actor MoonlightHealHelper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, "Spawn_S")
    TNT1 A 0 A_GiveInventory("MoonlightRadius_PU", 1, AAPTR_TARGET)
    TNT1 A 0 A_RadiusGive("MoonlightHeal_PU", 256, RGF_GIVESELF|RGF_PLAYERS|RGF_NOSIGHT, 1)
    TNT1 AA 1 A_Warp(2, 0, 0, 28, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("MoonlightPU", 1, "Spawn")
    goto Death
   Spawn_S:
    TNT1 A 0 A_GiveInventory("MoonlightRadius_PU", 1, AAPTR_TARGET)
    TNT1 A 0 A_RadiusGive("MoonlightHeal_PU2", 256, RGF_GIVESELF|RGF_PLAYERS|RGF_NOSIGHT, 1)
    TNT1 AA 1 A_Warp(2, 0, 0, 28, 0)
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, 1)
    goto Spawn+1
    TNT1 A 0 A_JumpIfInTargetInventory("MoonlightPU", 1, "Spawn_S")
    goto Death
  }
}

Actor MoonlightRadiusFX : BasicClientside {
  +BRIGHT
  Translation "192:192=110:110", "198:198=111:111", "4:4=109:109", "168:168=109:109", "208:215=109:109"
  Scale 0.5
  States {
   Spawn:
    6P0K NON 3
    goto Death
   Death:
    6P0K QR 2
    stop
  }
}

Actor MoonlightHeal_PU : CustomInventory {
  States {
   Pickup:
    TNT1 AA 0 A_SpawnItemEx("MoonlightHealFX", 48, 0, random(16, 32), 0, 0, random(2, 4), random(0, 359))
    TNT1 A 0 A_JumpIf(CallACS("rz_IsHailWeather"), "HailHeal")
    TNT1 A 0 HealThing(3)
    stop
   HailHeal:
    TNT1 A 0 HealThing(1)
    stop
  }
}

Actor MoonlightHeal_PU2 : CustomInventory {
  States {
   Pickup:
    TNT1 AAA 0 A_SpawnItemEx("MoonlightHealFX", 48, 0, random(16, 32), 0, 0, random(2, 4), random(0, 359))
    TNT1 A 0 A_JumpIf(CallACS("rz_IsHailWeather"), "HailHeal")
    TNT1 A 0 HealThing(5)
    stop
   HailHeal:
    TNT1 A 0 HealThing(2)
    stop
  }
}

Actor MoonlightRadius_PU : CustomInventory{States{Pickup: TNT1 AAAAA 0 A_SpawnItemEx("MoonlightRadiusFX", 256, 0, random(-8, -16), 0, 0, random(2, 8), random(0, 359))stop}}

Actor MoonlightHealFX : MoonlightRadiusFX{Renderstyle "Translucent" Alpha 0.75 Translation "192:192=176:176", "198:198=180:180", "4:4=174:174", "168:168=174:174", "208:215=174:174" Alpha 0.8 Scale 1.0}

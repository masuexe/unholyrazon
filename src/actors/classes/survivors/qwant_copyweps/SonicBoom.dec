actor SonicBoomWep_QwantBar : QwantBar {args 0, 0, 2}

actor SonicBoomWep : BaseQwantWep {
  Weapon.SlotNumber 2
  Obituary "%o couldn't stand %k's \cuSonic Boom\c-."
  Tag "$TAG_SONICBOOM"
  Weapon.AmmoType "NormalTypeAmmo"
  Inventory.Icon "PKMNI_N"
  States {
   Spawn:
    6N01 A 1
    loop

   Deselect:
    BUBB D 0
    goto DeselectSwap
   Select:
    BUBB D 0
    goto SelectSwap

   Ready:
    BUBB D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_NORMAL_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    BUBB D 0 A_JumpIfInventory("NormalTypeAmmo", 2, "ReadyX2")
    BUBB D 8 A_WeaponReady(WRF_NOPRIMARY)
    BUBB D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    BUBB D 8 A_WeaponReady
    BUBB D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    BUBB E 0 A_TakeInventory("NormalTypeAmmo", 1, 1)
    BUBB E 0 A_TakeInventory("NormalTypeAmmo", 1)
    BUBB E 0 A_PlaySoundEx("weapon/minchrgshot", "Weapon")
    BUBB E 0 A_FireCustomMissile("SonicBoomPKMN", 0, 0, 8, 0)
    BUBB FE 4  // 6
    BUBB D 8 A_GiveInventory("MoveRelearnAmmo", 1)  // 4
    BUBB D 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor SonicBoomPKMN : BasicProjectile {
  +DONTBLAST
  +RIPPER
  +SKYEXPLODE
  Translation "192:192=201:201", "198:198=204:204"
  RenderStyle "Translucent"
  Alpha 0.7
  Radius 16  // 14
  Height 24  // 25
  Scale 2.5
  Damage (90)  // 72
  DamageType "SonicBoom"
  Speed 24
  ReactionTime 175
  States {
   Spawn:
    X_5F E 0
    X_5F E 0 A_ScaleVelocity(0.9)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(0.8)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(0.7)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(0.6)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(0.5)
    X_5F EEEEE 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
   Spawn2:
    X_5F E 0 A_ScaleVelocity(1.25)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(1.5)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(1.75)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(2.0)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    X_5F E 0 A_ScaleVelocity(2.5)
    X_5F E 1 A_SpawnItemEx("SonicWaveTrace", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn2+9
   Death:
    TNT1 A 0
    stop
  }
}

actor SonicWaveTrace : BasicClientside {
  Scale 2.5
  RenderStyle "Translucent"
  Alpha 0.5
  States {
   Spawn:
    X_5F E 0
    X_5F EEEEE 1 A_SetScale(scaleX - 0.15, scaleY - 0.15)
    stop
  }
}


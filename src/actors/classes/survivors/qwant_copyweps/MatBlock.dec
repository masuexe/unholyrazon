actor MatBlock : BasicShieldHitbox {
  Translation "192:192=4:4", "198:198=93:93", "199:199=84:84"
  RenderStyle "Translucent"
  Alpha 0.1
  Health 1
  Height 60  // 52
  Radius 24  // 18
  Scale 2.5
  States {
   Spawn:
    MBLK D 0
    MBLK D 0 A_PlaySoundEx("Pokemon/Detect", "Voice")
    MBLK D 0 A_FadeIn(0.15)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 1.0)
    MBLK D 0 A_FadeIn(0.15)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 1.4)
    MBLK D 0 A_FadeIn(0.15)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 1.8)
    MBLK D 0 A_FadeIn(0.15)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 2.2)
    MBLK D 0 A_FadeIn(0.15)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 0 A_SetScale(2.5, 2.5)
    MBLK D 0  // A_ChangeFlag("NOINTERACTION",0)
    MBLK DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD 1 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 0  // A_ChangeFlag("NOINTERACTION",1)
    MBLK D 0 A_FadeOut(0.2)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 2.0)
    MBLK D 0 A_FadeOut(0.2)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 1.5)
    MBLK D 0 A_FadeOut(0.2)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 1.0)
    MBLK D 0 A_FadeOut(0.2)
    MBLK D 0 A_Warp(2, 96, 0, 24, 0, WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
    MBLK D 1 A_SetScale(2.5, 0.5)
    stop
   Pain:
    TNT1 A 0 A_PlaySound("CowboyKid/Shot2")
    goto Death
   Death:
    TMFX ABCD 2
    stop
   Death2:
    TMFX ABCD 2
    stop
  }
}

actor MatBlock_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    TNT1 A 0 A_SpawnItemEx("MatBlock", 96, 0, 24, 0, 0, 0, 0)
    stop
   Pickup2:
    TNT1 A 0 A_SpawnItemEx("MatBlock", 96, 0, 24, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("MatBlock", 96, 0, 24, 0, 0, 0, 120)
    TNT1 A 0 A_SpawnItemEx("MatBlock", 96, 0, 24, 0, 0, 0, 240)
    stop
  }
}

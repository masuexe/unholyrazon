actor MatBlockWep_QwantBar : QwantBar {args 6, 0, 7}

actor MatBlockWep : BaseQwantWep {
  Weapon.SlotNumber 7
  // Mat Block on spread: cover back and sides

  Weapon.AmmoUse 10  // 14
  Weapon.AmmoGive 28
  Weapon.AmmoType "FightingTypeAmmo"
  Tag "$TAG_MATBLOCK"
  Inventory.Icon "PKMNI_Ft"
  States {
   Spawn:
    6N01 G 1
    loop

   Deselect:
    RCSL A 0
    goto DeselectSwap
   Select:
    RCSL A 0
    goto SelectSwap

   Ready:
    RCSL A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FIGHTING_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    RCSL A 0 A_JumpIfInventory("FightingTypeAmmo", 10, "ReadyX2")
    RCSL A 8 A_WeaponReady(WRF_NOPRIMARY)
    RCSL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    RCSL A 8 A_WeaponReady
    RCSL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    RCSL A 0 A_TakeInventory("FightingTypeAmmo", 5, 1)
    RCSL A 0 A_TakeInventory("FightingTypeAmmo", 5)
    RCSL A 0 A_GiveInventory("MatBlock_P")
    RCSL CBA 3
    RCSL AAAA 10 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX

   NoAmmo:
    RCSL A 1
    goto ReadyX
  }
}


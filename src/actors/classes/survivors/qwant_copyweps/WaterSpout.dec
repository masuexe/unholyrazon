actor WaterSplashPKMN : BasicProjectile {
  DamageType "WaterSpout"
  +FLOORHUGGER
  // Translation "192:192=0:0"
  Damage (30)
  Radius 32
  Height 32
  Speed 60
  Scale 2.0
  States {
   Spawn:
    DUOR T 1 A_FadeOut(0.1)
    loop
  }
}

actor WaterSplashPKMN2 : WaterSplashPKMN {Scale 1.5 Damage (20)}


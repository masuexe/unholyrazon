actor WaterSpoutWep_QwantBar : QwantBar {args 2}

actor WaterSpoutWep : BaseQwantWep {
  Obituary "%o was drenched by %k's \chWater Spout\c-."
  Tag "Water Spout"
  Weapon.AmmoType "WaterTypeAmmo"
  Inventory.Icon "PKMNI_W"
  States {
   Spawn:
    6N01 C 1
    loop

   Deselect:
    WTRB H 0
    goto DeselectSwap
   Select:
    WTRB H 0
    goto SelectSwap

   Ready:
    WTRB H 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_WATER_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    WTRB H 0 A_JumpIfInventory("WaterTypeAmmo", 4, "ReadyX2")
    WTRB H 8 A_WeaponReady(WRF_NOPRIMARY)
    WTRB H 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    WTRB H 8 A_WeaponReady
    WTRB H 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    WTRB H 0 A_TakeInventory("WaterTypeAmmo", 2, 1)
    WTRB H 0 A_TakeInventory("WaterTypeAmmo", 2)
    WTRB H 0 A_PlaySoundEx("weapon/waterballoon", "Weapon")
    WTRB H 0 A_GiveInventory("Qwant_WaterSpout_P")
    WTRB IJ 2
    WTRB J 4
    WTRB JJ 8 A_GiveInventory("MoveRelearnAmmo", 1)
    WTRB J 0 A_GiveInventory("MoveRelearnAmmo", 1)  // 20
    goto ReadyX
  }
}

actor Qwant_WaterSpout_P : CustomInventory {
  // Easy management for if/when HP checks are used later
  States {
   Pickup:
    // Remember a CheckForSpread line for later
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "Pickup2")
    TNT1 A 0 A_FireCustomMissile("WaterSpout", 0, 0, 8, 0)
    stop
   Pickup2:
    TNT1 A 0 A_FireCustomMissile("WaterSpoutWeak", 0, 0, 8, 0)
    stop
  }
}

actor WaterSpout : BasicProjectile {
  Translation "192:192=200:200", "198:198=206:206"
  DamageType "WaterSpout"
  -NOGRAVITY
  +SKYEXPLODE
  Damage (150 * CallACS("core_gethealth", AAPTR_TARGET) / CallACS("core_getmaxhealth", AAPTR_TARGET))
  Radius 8
  Height 8
  Speed 30
  Scale 2.5
  States {
   Spawn:
    WTRS A 0
    WTRS A 0 ThrustThingZ(0, 25, 0, 1)
    WTRS A 1 A_SpawnItemEx("WaterSpoutTrail", -6, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn+2
   Death:
    TNT1 A 0 A_SpawnItemEx("SoakifyEffect")
    TNT1 A 0 A_PlaySoundEx("misc/splash", "Weapon")
    TNT1 A 0 A_SpawnItemEx("WaterSpoutDrop", 5, 0, 5, 10, 0, 25, 0, 1)
    TNT1 A 0 A_SpawnItemEx("WaterSpoutDrop", 5, 0, 5, 10, 0, 25, 90, 1)
    TNT1 A 0 A_SpawnItemEx("WaterSpoutDrop", 5, 0, 5, 10, 0, 25, 180, 1)
    TNT1 A 0 A_SpawnItemEx("WaterSpoutDrop", 5, 0, 5, 10, 0, 25, 270, 1)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 20)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 40)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 60)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 80)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 100)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 120)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 140)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 160)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 200)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 220)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 240)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 260)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 280)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 300)
    TNT1 A 0 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 320)
    TNT1 A 1 A_SpawnItemEx("WaterSplashPKMN", 0, 0, 0, 15, 0, 0, 340)
    stop
  }
}

actor WaterSpoutDrop : WaterSpout {
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 1.0
  BounceCount 4
  Damage (30 * CallACS("core_gethealth", AAPTR_TARGET) / CallACS("core_getmaxhealth", AAPTR_TARGET))
  Radius 6
  Height 6
  Scale 2.0
  States {
   Spawn:
    WTRS A 0
    WTRS A 0 ThrustThingZ(0, 13, 0, 0)
    WTRS A 1
    goto Spawn+2
   Death:
    TNT1 A 0 A_SpawnItemEx("SoakifyEffect")
    TNT1 A 0 A_PlaySoundEx("misc/splash", "Weapon")
    TNT1 A 0 A_Explode(30, 48, 0, 0, 8)
    X_8H KLMN 1
    stop
  }
}

actor WaterSpoutTrail : BasicGraphicEffect {
  Alpha 0.6
  States {
   SpawnFrame:
    WTRS AAAAAA 1 A_SetScale(scaleX - 0.15, scaleY - 0.15)
    stop
  }
}


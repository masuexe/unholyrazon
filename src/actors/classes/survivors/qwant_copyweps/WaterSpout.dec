actor S_Qwant_WaterSpout_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50 + 1, "Pickup2")
    TNT1 A 0 A_FireCustomMissile("Shiny_WaterSpout", 0, 0, 8, 0)
    stop
   Pickup2:
    TNT1 A 0 A_FireCustomMissile("Shiny_WaterSpoutWeak", 0, 0, 8, 0)
    stop
  }
}


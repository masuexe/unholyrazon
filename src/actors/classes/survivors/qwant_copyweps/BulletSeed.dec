actor S_Qwant_BulletSeed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("weapon/leafshield", 1)
    TNT1 A 0 A_FireCustomMissile("S_Q_BulletSeed", 0, 0)
    stop
  }
}

actor S_Q_BulletSeed : Q_BulletSeed {Damage (99)}

actor BulletSeedWep_QwantBar : QwantBar {args 4, 0, 3}

actor BulletSeedWep : BaseQwantWep {
  Weapon.SlotNumber 3
  Obituary "%o was pelted by %k's \cqBullet Seed\c-."
  Tag "$TAG_BULLETSEED"
  Weapon.AmmoType "GrassTypeAmmo"
  Inventory.Icon "PKMNI_Gr"
  States {
   Spawn:
    6N01 E 1
    loop

   Deselect:
    BUSD A 0
    goto DeselectSwap
   Select:
    BUSD A 0
    goto SelectSwap

   Ready:
    6H1E A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_GRASS_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    6H1E A 0 A_JumpIfInventory("GrassTypeAmmo", 2, "ReadyX2")
    6H1E A 10 A_WeaponReady(WRF_NOPRIMARY)
    6H1E A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    6H1E A 10 A_WeaponReady
    6H1E A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    6H1E B 0 A_GiveInventory("Qwant_BulletSeedRNG_P")
   Fire1:
    6H1E B 0 A_JumpIfInventory("QwantBulletSeed_F", 2, "Fire2")
    6H1E B 0 A_PlaySound("Pokemon/ShadowBall", 1)
    6H1E B 2 A_FireCustomMissile("Q_BulletSeed256", 0, 0, 8, 0)
    6H1E C 10
    6H1E C 0 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E B 4
    goto FireEnd
   Fire2:
    6H1E B 0 A_JumpIfInventory("QwantBulletSeed_F", 3, "Fire3")
    6H1E C 0 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E CB 2
    6H1E A 1
    6H1E C 0 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E CB 2
    6H1E A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E A 1
    6H1E AAAA 1
    6H1E A 2  // 16 R11
    6H1E A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto FireEnd
   Fire3:
    6H1E B 0 A_JumpIfInventory("QwantBulletSeed_F", 4, "Fire4")
    6H1E C 0 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E CB 2
    6H1E C 0 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E CB 2
    6H1E C 0 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E C 0 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E CB 2
    6H1E AA 2  // 16 R11
    6H1E A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto FireEnd
   Fire4:
    6H1E B 0 A_JumpIfInventory("QwantBulletSeed_F", 5, "Fire5")
    6H1E CBCB 3 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E AA 2  // 16 R11
    6H1E A 0 A_GiveInventory("MoveRelearnAmmo", 2)
    goto FireEnd
   Fire5:
    // 6H1E B 0 A_JumpIfInventory("QwantBulletSeed_F",6,"Fire6")
    6H1E BCBCB 2 A_GiveInventory("Qwant_BulletSeed_P")
    6H1E AAAAAA 1  // 16 R11
    6H1E A 0 A_GiveInventory("MoveRelearnAmmo", 2)
    goto FireEnd

   FireEnd:
    6H1E A 4 A_TakeInventory("QwantBulletSeed_F")
    goto ReadyX

    // BUSD BC 2
    // BUSD A 7

    // BUSD BC 2
    // BUSD A 5

    // BUSD BC 2
    // BUSD A 3

    // BUSD BC 2
    // BUSD A 1
  }
}

actor QwantBulletSeed_F : Inventory {Inventory.MaxAmount 5
}

actor Qwant_BulletSeedRNG_P : CustomInventory {
  States {
   Pickup:
    // Old  >> 37.5-37.5-12.5-12.5 //2,2,2, 3,3,3, 4, 5
    // GenV >> 35-35-15-15 out of 100 for 2-3-4-5 hits
    TNT1 A 0 A_TakeInventory("GrassTypeAmmo", 1, 1)
    TNT1 A 0 A_TakeInventory("GrassTypeAmmo", 1)
    TNT1 A 0 A_Jump(255, 2, 2, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 3, 4, 4, 4, 5, 5, 5)
    TNT1 A 0 A_GiveInventory("QwantBulletSeed_F", 1)  // Gen 1 Miss
    stop
    TNT1 A 0 A_GiveInventory("QwantBulletSeed_F", 2)
    stop
    TNT1 A 0 A_GiveInventory("QwantBulletSeed_F", 3)
    stop
    TNT1 A 0 A_GiveInventory("QwantBulletSeed_F", 4)
    stop
    TNT1 A 0 A_GiveInventory("QwantBulletSeed_F", 5)
    stop
  }
}

actor Qwant_BulletSeed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("weapon/leafshield", 1)
    TNT1 A 0 A_FireCustomMissile("Q_BulletSeed", 0, 0)
    stop
  }
}

actor Q_BulletSeed {
  // "192:192=109:109","198:198=129:129","0:0=133:133"
  Translation "192:192=4:4", "198:198=129:129"
  Projectile
  DamageType "Qwant"
  Obituary "%o was pelted by %k's \cqBullet Seed\c-."
  +FORCEXYBILLBOARD
  Damage (77)
  Height 10
  Radius 10
  Speed 55
  Scale 2.5  // 2.0
  States {
   Spawn:
    // LESE C 1
    6P1E A 0
    6P1E A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   S1:
    6P1E ABCD 2
    loop
   S2:
    6P1E DCBA 2
    loop
   Death:
    TNT1 A 0  // A_SpawnItemEx("Q_BulletSeedClank",0,0,8,30,0,0,180)
    TNT1 A 1
    stop
  }
}

actor Q_BulletSeed256 : Q_BulletSeed {
  Translation "192:192=109:109", "198:198=129:129"
  Damage (539)
  Height 16
  Radius 16
  States {
   Spawn:
    6P1E E 1
    wait
  }
}


// TODO: add NoFreezePlayer when holding

actor FlameWheelWep_QwantBar : QwantBar {args 1}
actor FlameWheelWep_ScriptBar : ScriptBar {}

actor FlameWheelWep : BaseQwantWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28 //28
Obituary "%o was burnt out by %k's \cgFlame Wheel\c-."
weapon.ammotype "FireTypeAmmo"
Tag "$TAG_FLAMEWHEEL"
inventory.icon "PKMNI_Fi"
States
{
Spawn:
CNFS A 1
loop

Deselect:
MGHD A 0
goto DeselectSwap
Select:
MGHD A 0
goto SelectSwap

Ready:
MGHD A 0 A_TakeInventory("FlameWheelCharge")
MGHD A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FIRE_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
MGHD A 0 A_JumpIfInventory("FireTypeAmmo",1,"ReadyX2")
MGHD A 8 A_WeaponReady(WRF_NOPRIMARY)
MGHD A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
MGHD A 8 A_WeaponReady
MGHD A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
MGHD D 0 A_JumpIfNoAmmo("NoAmmo")
MGHD D 2
MGHD E 0 A_PlaySoundEx("weapon/firestorm","Weapon")
MGHD E 0 A_SpawnItemEx("FlameWheel",0,0,24)
MGHD E 2 A_GiveInventory("PowerFlameWheelSpeed")

FireH:
MGHD E 0 A_JumpIfInventory("FireTypeAmmo",1,1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("PowerFlameWheelSpeed")
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_GiveInventory("MoveRelearnAmmo",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("PowerFlameWheelSpeed")
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_GiveInventory("FlameWheelCharge",1)
MGHD E 0 A_Refire(1)
goto FireEnd
MGHD E 1 A_TakeInventory("FireTypeAmmo",1)
MGHD E 0 A_Refire("FireH")
goto FireEnd

FireEnd:
MGHD E 0 A_GiveInventory("TempKillFlameWheelFlag")
MGHD E 0 A_TakeInventory("FlameWheelCharge")
MGHD E 2 A_TakeInventory("PowerFlameWheelSpeed")
MGHD D 2
MGHD A 6
goto ReadyX

NoAmmo:
MGHD A 1
goto ReadyX

}
}

Actor FlameWheelCharge : WeaponCharge{Inventory.amount 1 Inventory.maxamount 112}

actor PowerFlameWheelSpeed : PowerSpeed
{
+POWERSPEED.NOTRAIL
Powerup.Duration 16
Speed 1.5
}

actor TempKillFlameWheelFlag : Powerup
{
Powerup.Duration 5
}

actor TempKillFlameWheel_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInTargetInventory("TempKillFlameWheelFlag",1,1)
stop
TNT1 A 0 A_CountDown
stop
}
}

Actor FlameWheel : BasicExplosion
{
Translation "192:192=216:216","198:198=42:42"
Damagetype "FlameWheel" //FlameBurst
Obituary "%o was burnt out by %k's Flame Wheel."
ReactionTime 1
States
{
Spawn:
TNT1 A 0
Spawn2:
TNT1 A 0 A_JumpIfInTargetInventory("MorphedFlag",1,"Death")
TNT1 A 0 A_JumpIfInTargetInventory("TruePowerItemFlag",1,"Death")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("FlameWheelCharge",112,"FullPower")
TNT1 A 0 A_JumpIfInventory("CutterFlag",3,"Sound") 
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 AA 0 A_SpawnItemEx("FlameWheelFX",0,0,28,0,0,0,random(0,359),1)
TNT1 A 0 A_Explode(56*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),80,0,0,14)
TNT1 AAA 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_GiveInventory("TempKillFlameWheel_P")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_Explode(56*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),80,0,0,14)
TNT1 AA 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_GiveInventory("CutterFlag",1)
TNT1 A 0 A_GiveInventory("TempKillFlameWheel_P")
TNT1 A 0 A_GiveToTarget("FlameWheel_Rage_P",1)
loop
FullPower:
TNT1 A 0 A_JumpIfInTargetInventory("MorphedFlag",1,"Death")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInventory("CutterFlag",4,"Sound2")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 AAA 0 A_SpawnItemEx("FlameWheelFX",0,0,28,0,0,0,random(0,359),1)
TNT1 A 0 A_Explode(64*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),96,0,0,24)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,1)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_GiveInventory("TempKillFlameWheel_P")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_Explode(64*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),96,0,0,24)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_GiveInventory("CutterFlag",1)
TNT1 A 0 A_GiveInventory("TempKillFlameWheel_P")
loop
Sound:
TNT1 A 0 A_PlaySoundEx("Pokemon/FireSpin","Voice")
TNT1 A 0 A_TakeInventory("CutterFlag",999)
goto Spawn2
Sound2:
TNT1 A 0 A_PlaySoundEx("CBM/FireShot","Voice")
TNT1 A 0 A_TakeInventory("CutterFlag",999)
goto FullPower
Death:
TNT1 A 0
stop
}
}

actor FlameWheelFX : BasicClientside
{
Var int user_ZPos;
+FORCEXYBILLBOARD
Renderstyle "Translucent"
Alpha 0.8
Scale 2.5
States
{
Spawn:
DBTH A 0
DBTH A 0 A_SetUserVar("user_ZPos",8)
Spawn2:
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH B 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
DBTH A 0 A_SetUserVar("user_ZPos",user_ZPos+8)
DBTH C 1 A_Warp(2,96,0,user_ZPos,10,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
stop
Death:
TNT1 A 0
stop
}
}

Actor FlameWheel_Rage_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"Pickup2")
stop
Pickup2:
TNT1 A 0 A_GiveInventory("FlameWheelCharge",1)
stop
}
}

/////////////////////////////
//== Shiny ==//
/////////////////////////////

Actor S_FlameWheelSpeed_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("PowerFlameWheelSpeed")
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,150,100)
stop
}
}

Actor S_FlameWheelStop_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("PowerFlameWheelSpeed")
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,1,1)
stop
}
}

Actor S_FlameWheel : FlameWheel
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("CutterFlag",4,"Sound")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 AAA 0 A_SpawnItemEx("FlameWheelFX",0,0,28,0,0,0,random(0,359),1)
TNT1 A 0 A_Explode(88*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),96,0,0,24)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,1)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 1 A_Warp(2,0,0,28,0,28)
TNT1 A 0 A_GiveInventory("CutterFlag",1)
TNT1 A 0 A_JumpIfInTargetInventory("TruePowerItemFlag",1,1) //realistically not needed but uh
goto Death
TNT1 A 0 A_JumpIfInTargetInventory("PowerFlameWheelSpeed",1,"Spawn")
goto Death
Sound:
TNT1 A 0 A_PlaySoundEx("CBM/FireShot","Voice")
TNT1 A 0 A_TakeInventory("CutterFlag",999)
goto Spawn+1
Death:
TNT1 A 0 A_GiveToTarget("S_FlameWheelStop_P",1)
TNT1 A 1
stop
}
}

actor MoonBlastWep_QwantBar : QwantBar {args 17}

actor MoonBlastWep : BaseQwantWep
{
Obituary "%o was sent to the moon by %k's \caMoon Blast\c-."
Tag "$TAG_MOONBLAST"
weapon.ammotype "FairyTypeAmmo"
inventory.icon "PKMNI_Fy"
States
{
Spawn:
6N01 R 1
loop

Deselect:
MNBL C 0
goto DeselectSwap
Select:
MNBL C 0
goto SelectSwap

Ready:
MNBL C 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FAIRY_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
MNBL C 0 A_JumpIfInventory("FairyTypeAmmo",4,"ReadyX2")
MNBL C 8 A_WeaponReady(WRF_NOPRIMARY)
MNBL C 0 A_GiveInventory("FairyTypeAmmo",1)
MNBL C 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
MNBL C 8 A_WeaponReady
MNBL C 0 A_GiveInventory("FairyTypeAmmo",1)
MNBL C 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
MNBL C 0 A_TakeInventory("FairyTypeAmmo",2,1)
MNBL C 0 A_TakeInventory("FairyTypeAmmo",2)
MNBL C 0 A_PlaySoundEx("weapon/mbuster","Weapon")
MNBL C 0 A_FireCustomMissile("MoonBlastBullet",0,0,8,0)
MNBL EDC 2
MNBL CC 8 A_GiveInventory("MoveRelearnAmmo",1) //13
goto ReadyX
}
}

actor MoonBlastBullet : BasicFastProjectile
{
Damagetype "MoonBlast"
+DONTBLAST
+DONTSPLASH
+DONTREFLECT
+RIPPER
+THRUGHOST
+FORCEXYBILLBOARD
+SKYEXPLODE
+EXPLODEONWATER
reactiontime 1
damage (0)
radius 8
height 16
speed 125
Scale 2.0
var int user_NoTranslation;
States
{
Spawn:
TNT1 A 0
TNT1 A 10
goto Death
Death:
TNT1 A 0 A_SpawnItemEx("FairyMoonBlast",-10,0,350,0,0,-25,0,32)
stop
}
}

Actor FairyMoonBlast : AstroCrushU
{
Translation "192:192=208:208","198:198=215:215","199:199=170:170","202:202=169:169"
+BRIGHT
+FORCEXYBILLBOARD
Obituary "%o was taken to the moon by %k's \caMoon Blast\c-."
RenderStyle "Translucent"
Alpha 0.8
Damagetype "MoonBlast"
Damage(0)
Scale 5.0
Args 165,256,16
States
{
Spawn:
MNBL A 0
MNBL AAAAAAAAAAAA 1 A_JumpIf(ceilingz-z>32,"Spawn2")
MNBL A 0 A_JumpIf(momz==0,"Death")
MNBL A 0 A_CountDown
Goto Spawn+1
Spawn2:
MNBL A 0 A_ChangeFlag("RIPPER",0)
MNBL A 0 A_ChangeFlag("NOINTERACTION",0)
MNBL AAAA 3 A_JumpIf(momz==0,"Death")
MNBL A 0 A_CountDown
Goto Spawn2+2
Death:
X_8B A 0 A_PlaySoundEx("SJBOOM6","Weapon")
X_8B A 0 A_SetTranslucent(0.6)
X_8B A 0 A_SetGravity(0.0)
X_8B A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
X_8B ABCDEF 2
stop
}
}

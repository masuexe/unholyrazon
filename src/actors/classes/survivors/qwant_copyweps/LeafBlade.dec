actor LeafBladeWep_QwantBar : QwantBar {args 4, 0, 4}

actor LeafBladeWep : BaseQwantWep {
  Weapon.SlotNumber 4
  Obituary "%o was split in half by %k's \cdLeaf Blade\c-."
  Tag "$TAG_LEAFBLADE"
  Weapon.AmmoType "GrassTypeAmmo"
  Inventory.Icon "PKMNI_Gr"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6N01 E 1
    loop

   Deselect:
    6H1E G 0
    goto DeselectSwap
   Select:
    6H1E G 0
    goto SelectSwap
    // HUD COLORS 228:228=128:128","111:111=134:134
   Ready:
    6H1E G 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_GRASS_DYE, CLRF_QWANTMENU)
    6H1E G 0 A_TakeInventory("PriBladeOnce")
    6H1E G 0 A_TakeInventory("PriBladeTwice")
    goto ReadyX
   ReadyX:
    6H1E G 0 A_JumpIfInventory("GrassTypeAmmo", 2, "ReadyX2")
    6H1E G 8 A_WeaponReady(WRF_NOPRIMARY)
    6H1E G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    6H1E G 8 A_WeaponReady
    6H1E G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    6H1E G 0 A_JumpIfInventory("PriBladeOnce", 1, "Fire2")
    6H1E G 0 A_JumpIfInventory("PriBladeTwice", 1, "Fire3")
    goto Fire1
   Fire1:
    6H1E G 0 A_TakeInventory("GrassTypeAmmo", 1, 1)
    6H1E G 0 A_TakeInventory("GrassTypeAmmo", 1)
    6H1E G 0 A_GiveInventory("PriBladeOnce")
    6H1E G 2 Offset(39, 65)
    6H1E G 0 A_Recoil(-5)
    6H1E G 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 50, 0, -16, 0, 0, -10)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 25, 0, -8, 0, 0, -5)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 0, 0, 0, 0, 0, 0)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", -50, 0, 16, 0, 0, 20)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", -25, 0, 8, 0, 0, 10)
    TNT1 A 4 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 0 A_WeaponReady
    6H1E G 2 Offset(90, 98)
    6H1E G 2 Offset(39, 65)
    6H1E G 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
   Fire2:
    TNT1 A 0 A_TakeInventory("PriBladeOnce")
    TNT1 A 0 A_GiveInventory("PriBladeTwice")
    TNT1 A 0 A_Recoil(-5)
    TNT1 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", -50, 0, 16, 0, 0, 10)
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", -25, 0, 8, 0, 0, 5)
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", 0, 0, 0, 0, 0, 0)
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", 50, 0, -16, 0, 0, -20)
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", 25, 0, -8, 0, 0, -10)
    TNT1 A 4
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 0 A_WeaponReady
    6H1E G 2 Offset(90, 98)
    6H1E G 2 Offset(39, 65)
    goto ReadyX
   Fire3:
    TNT1 A 0 A_TakeInventory("PriBladeOnce")
    TNT1 A 0 A_TakeInventory("PriBladeTwice")
    TNT1 A 0 A_Recoil(-5)
    TNT1 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 50, 0, -16, 0, 0, -10)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", -50, 0, 16, 0, 0, 10)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 25, 0, -8, 0, 0, -5)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", -25, 0, 8, 0, 0, 5)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", 0, 0, 0, 0, 0, 0)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 50, 0, -16, 0, 0, -20)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", -50, 0, 16, 0, 0, 20)
    TNT1 A 1 A_FireCustomMissile("LeafSlash1", 25, 0, -8, 0, 0, -10)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", -25, 0, 8, 0, 0, 10)
    TNT1 A 3
    TNT1 A 8 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E G 2 Offset(90, 98)
    6H1E G 2 Offset(39, 65)
    6H1E G 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
   AltFire:
    TNT1 A 0 A_JumpIfInventory("PriBladeOnce", 1, "AltFire1")
    TNT1 A 0 A_JumpIfInventory("PriBladeTwice", 1, "AltFire2")
    goto AltfireMove
   AltFire1:
    TNT1 A 0 A_PlaySoundEx("weapon/tripleblade", "Weapon")
    TNT1 A 0 A_TakeInventory("PriBladeOnce")
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 25, 0, 1)
    TNT1 A 0 A_Recoil(-30)
    TNT1 A 1
    goto LeafWait
   LeafWait:
    TNT1 A 1 A_JumpIf(z - floorz > 1, "JumpSlash")
    goto LeafWait
   JumpSlash:
    TNT1 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", -50, 0, 16, 0, 0, 10)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", -25, 0, 8, 0, 0, 5)
    TNT1 A 1 A_FireCustomMissile("LeafSlash2", 0, 0, 0, 0, 0, 0)
    TNT1 A 0 A_FireCustomMissile("LeafSlash2", 50, 0, -16, 0, 0, -20)
    TNT1 A 6 A_FireCustomMissile("LeafSlash2", 25, 0, -8, 0, 0, -10)
    TNT1 A 8 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 5 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E G 2 Offset(90, 98)
    6H1E G 2 Offset(39, 65)
    goto ReadyX
   AltFire2:
    TNT1 A 0 A_PlaySoundEx("CBM/DashClaw", "Weapon")
    TNT1 A 0 A_TakeInventory("PriBladeOnce")
    TNT1 A 0 A_TakeInventory("PriBladeTwice")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 6, true, 0)
    TNT1 A 0 ThrustThingZ(0, 85, 0, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, true, 0)
    TNT1 AAAAAAAAA 1 A_FireCustomMissile("LeafUppercut")
    TNT1 A 10 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, false, 0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 6, false, 0)
    TNT1 A 11
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    6H1E G 2 Offset(90, 98)
    6H1E G 2 Offset(39, 65)
    goto ReadyX
  }
}

actor PriBladeOnce : Once {}
actor PriBladeTwice : PriBladeOnce {}

actor LeafUppercut : BasicProjectile {
  Translation "192:192=128:128", "198:198=112:112"
  Radius 5
  Height 5
  Scale 2.5
  Damage (30)
  DamageType "LeafBladeSlice"
  +RIPPER
  Speed 38  // 35
  States {
   Spawn:
    X_2H S 0
    X_2H SWSWS 1 A_Explode(40, 65, 0)  // +1
    stop
  }
}

actor LeafSlash1 : BasicProjectile {
  Translation "192:192=128:128", "198:198=112:112"
  Radius 5
  Height 5
  Scale 2.5
  Damage (18)
  +RIPPER
  DamageType "LeafBladeSlice"
  Speed 34  // 30
  States {
   Spawn:
    X_2H S 0
    X_2H SSSSS 1 A_Explode(22, 65, 0)  // +1
    stop
  }
}

actor LeafSlash2 : BasicProjectile {
  Translation "192:192=128:128", "198:198=112:112"
  Radius 5
  Height 5
  Scale 2.5
  Damage (19)
  +RIPPER
  DamageType "LeafBladeSlice"
  Speed 34  // 30
  States {
   Spawn:
    X_2H W 0
    X_2H WWWWW 1 A_Explode(22, 65, 0)  // +1
    stop
  }
}

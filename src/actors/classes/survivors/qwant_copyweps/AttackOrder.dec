actor AttackOrderWep_QwantBar : QwantBar {args 11}

actor AttackOrderWep : BaseQwantWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Tag "$TAG_ATTACKORDER"
weapon.ammotype "BugTypeAmmo"
inventory.icon "PKMNI_B"
States
{
Spawn:
HCHS A 1
loop

Deselect:
HCHS D 0
goto DeselectSwap
Select:
HCHS D 0
goto SelectSwap

Ready:
HCHS D 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_BUG_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
HCHS D 0 A_JumpIfInventory("BugTypeAmmo",2,"ReadyX2")
HCHS D 8 A_WeaponReady(WRF_NOPRIMARY)
HCHS D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
HCHS D 8 A_WeaponReady
HCHS D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
HCHS D 0 A_TakeInventory("BugTypeAmmo",1,1)
HCHS D 0 A_TakeInventory("BugTypeAmmo",1)
HCHS D 0 A_PlaySoundEx("weapon/hornetchaser","Weapon")
HCHS D 0 A_GiveInventory("AttackOrder_P",1)
HCHS FE 4
HCHS DDDD 8 A_GiveInventory("MoveRelearnAmmo",1)
goto ReadyX

}
}

Actor AttackOrderBee : BasicProjectile
{
//Note: These were intentionally lower damage so that if someone were to collide with them before the split, it won't destroy them.
Obituary "%o was mobbed by %k's \cfAttack \cmOrder\c-."
Damagetype "AttackOrder"
Radius 9
Height 9
Scale 2.0
Damage(60)
Speed 20
States
{
Spawn:
HCHS B 0
HCHS B 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
HCHS BCBCBCBC 1
HCHS B 0 A_ScaleVelocity(0.0)
HCHS BCBCBCBC 1
goto Spawn2
Spawn2:
HCHS B 0 A_CustomMissile("AttackOrderBee2",0,0,0,2,-pitch)
stop
Death:
MMFX BCDE 1
stop
}
}

Actor AttackOrderBeeTargeted : AttackOrderBee
{
States
{
Spawn:
HCHS B 0
HCHS B 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
HCHS B 0 A_GiveToTarget("UH_TargetMarker")
HCHS BCBCBCBC 1
HCHS B 0 A_ScaleVelocity(0.0)
HCHS BCBCBCBC 1
HCHS B 0 A_CustomMissile("AttackOrderBee2",0,0,0,2,-pitch)
stop
}
}


stop
PickupX2:
TNT1 A 0 A_SpawnItemEx("S_AttackOrderBeeTargeted",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
TNT1 A 0 A_SpawnItemEx("S_AttackOrderBeeL",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)

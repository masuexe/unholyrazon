Actor S_AttackOrderBee : AttackOrderBee
{
Damage(90)
States
{
Spawn:
X_9F A 0
X_9F A 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 1)
X_9F ABABABAB 1
X_9F A 0 A_ScaleVelocity(0.0)
X_9F ABABABAB 1
Spawn2:
X_9F A 0 A_CustomMissile("S_AttackOrderBee2",0,0,0,2,-pitch)
stop
Death:
MMFX BCDE 1
stop
}
}


Actor AttackOrder_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TruePowerItemFlag",1,"PickupX")
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"Pickup2")
TNT1 A 0 A_SpawnItemEx("AttackOrderBeeTargeted",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
TNT1 A 0 A_SpawnItemEx("AttackOrderBeeL",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
TNT1 A 0 A_SpawnItemEx("AttackOrderBeeL2",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
TNT1 A 0 A_SpawnItemEx("AttackOrderBeeR",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
TNT1 A 0 A_SpawnItemEx("AttackOrderBeeR2",0,0,24,cos(-pitch)*20,0,sin(-pitch)*20,0)
stop

actor GustWep_QwantBar : QwantBar {args 9}

actor GustWep : BaseQwantWep {
  Weapon.AmmoUse 7
  Weapon.AmmoGive 28
  Tag "$TAG_GUST"
  Weapon.AmmoType "FlyingTypeAmmo"
  Inventory.Icon "PKMNI_Fl"
  States {
   Spawn:
    WEA2 V 1
    loop

   Deselect:
    GUST A 0
    goto DeselectSwap
   Select:
    GUST A 0
    goto SelectSwap

   Ready:
    GUST A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FLYING_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    GUST A 0 A_JumpIfInventory("FlyingTypeAmmo", 7, "ReadyX2")
    GUST A 8 A_WeaponReady(8)
    GUST A 0 A_JumpIfInventory("GustHoldFlag", 1, "ReadyXHold")
    GUST A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyXHold:
    GUST A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
   ReadyX2:
    GUST A 8 A_WeaponReady
    GUST A 0 A_JumpIfInventory("GustHoldFlag", 1, "ReadyX2Hold")
    GUST A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2Hold:
    GUST A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX2

   Fire:
    GUST A 0 A_JumpIfInventory("GustHoldFlag", 1, "ReadyX")
    goto FireX
   FireX:
    GUST A 0 A_TakeInventory("FlyingTypeAmmo", 4, 1)
    GUST A 0 A_TakeInventory("FlyingTypeAmmo", 3)
    GUST A 0 A_PlaySoundEx("Pokemon/GustG3", "Weapon")
    GUST A 0 A_GiveInventory("GustPKMN_P")
    GUST A 0 A_SpawnItemEx("GustPKMN_H", 0, 0, 28)
    GUST A 0 A_GiveInventory("GustHoldFlag")
    GUST CB 4
    GUST AA 8 A_GiveInventory("MoveRelearnAmmo", 1)  // 18
    goto ReadyX
  }
}

actor GustHoldFlag : Once {}
actor GustProtect : PowerProtection {powerup.duration 4 Damagefactor "GustPKMN", 0.0}

actor GustProjectile : BasicProjectile {
  Translation "192:192=168:168", "198:198=200:200"
  +THRUGHOST
  +NOTARGETSWITCH
  +NOCLIP
  +NOTIMEFREEZE
  DamageType "GustPKMN"
  Obituary "%o was blown away by %k's Gust."
  RenderStyle "Translucent"
  Damage (0)
  Alpha 0.65
  Radius 6
  Height 6
  Scale 1.5
  Args 8, 2
  States {
   Spawn:
    X_6G A 0
    X_6G A 0 A_JumpIf(args[0] >= 136, "Spawn2")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G A 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G A 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G A 0 A_JumpIf(args[0] >= 136, "Spawn2")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G B 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G B 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G A 0 A_JumpIf(args[0] >= 136, "Spawn2")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G C 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G C 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G A 0 A_JumpIf(args[0] >= 136, "Spawn2")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G D 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    X_6G D 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] + args[1])
    goto Spawn+1
   Spawn2:
    X_6G A 0 A_JumpIfInventory("Once", 1, 1)
    X_6G A 0 A_JumpIf(args[0] == 24, "SoundCue")
    X_6G A 0 A_JumpIf(args[0] <= 8, "Death")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G A 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G A 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G A 0 A_JumpIf(args[0] <= 8, "Death")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G B 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G B 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G A 0 A_JumpIf(args[0] <= 8, "Death")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G C 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G C 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G A 0 A_JumpIf(args[0] <= 8, "Death")
    X_6G A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    X_6G D 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    X_6G D 1 A_Warp(2, args[0], 0, 28, 4, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
    X_6G A 0 A_Explode(80, 80, 0, 0, 8)
    X_6G A 0 A_SetArg(0, args[0] - args[1])
    loop
   SoundCue:
    TNT1 A 0 A_GiveInventory("Once")
    TNT1 A 0 A_GiveToTarget("GustSoundPickup", 1)
    goto Spawn2+2
   Death:
    TNT1 A 0
    stop
  }
}

actor GustPKMN_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, 180)
    stop
   Pickup2:
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, 90)
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, -90)
    TNT1 A 0 A_SpawnItemEx("GustProjectile", 8, 0, 28, 0, 0, 0, 180)
    stop
  }
}

actor GustPKMN_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 128
    TNT1 A 0 A_GiveToTarget("GustSuperJump_P")
    stop
  }
}

actor GustSuperJump_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("GustHoldFlag")
    TNT1 A 0 ThrustThingZ(0, 75, 0, 1)  // 100
    stop
  }
}

actor GustSoundPickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("KirbyNES/HighJump", "Voice")
    stop
  }
}

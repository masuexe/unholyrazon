actor DragonBreathWep_QwantBar : QwantBar {args 14}

actor DragonBreathWep : BaseQwantWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 56
Obituary "%o wasn't able to resist %k's \cnDragon \cgBreath\c-."
weapon.ammotype "DragonTypeAmmo"
Tag "$TAG_DRAGONBREATH"
inventory.icon "PKMNI_D"
States
{
Spawn:
MGM1 A 1
loop

Deselect:
DBRT A 0
goto DeselectSwap
Select:
DBRT A 0
goto SelectSwap

Ready:
DBRT A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_DRAGON_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
DBRT A 0 A_JumpIfInventory("DragonTypeAmmo",1,"ReadyX2")
DBRT A 8 A_WeaponReady(WRF_NOPRIMARY)
DBRT A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
DBRT A 8 A_WeaponReady
DBRT A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
DBRT B 2
FireH:
DBRT C 0 A_JumpIfInventory("DragonTypeAmmo",1,1)
goto FireEnd
DBRT C 2 A_GiveInventory("QwantDragonBreath_P")
DBRT C 0 A_ReFire(1)
goto FireEnd
DBRT C 0 A_JumpIfInventory("DragonTypeAmmo",1,1)
goto FireEnd
DBRT C 2 A_GiveInventory("QwantDragonBreath_P")
DBRT C 0 A_ReFire(1)
goto FireEnd
DBRT C 0 A_JumpIfInventory("DragonTypeAmmo",1,1)
goto FireEnd
DBRT C 2 A_GiveInventory("QwantDragonBreath_P")
DBRT C 0 A_ReFire(1)
goto FireEnd
DBRT C 0 A_JumpIfInventory("DragonTypeAmmo",1,1)
goto FireEnd
DBRT C 2 A_GiveInventory("QwantDragonBreath_P")
DBRT C 0 A_GiveInventory("MoveRelearnAmmo",1)
DBRT C 0 A_ReFire("FireH")
goto FireEnd
FireEnd:
DBRT BA 3
Goto ReadyX

NoAmmo:
DBRT A 1
goto ReadyX
}
}

actor QwantDragonBreath_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("DragonTypeAmmo",1)
TNT1 A 0 A_PlaySoundEx("Pokemon/Bide","Weapon")
TNT1 A 0 A_FireCustomMissile("DragonBreathPKMN",Args[4],0,8,0)
Adjust:
TNT1 A 0 A_JumpIf(Args[3]>0,"Up")
Down:
TNT1 A 0 A_SetArg(4,Args[4]-10)
TNT1 A 0 A_JumpIf(Args[4]<=-30,1)
stop
TNT1 A 0 A_SetArg(3,1)
stop
Up:
TNT1 A 0 A_SetArg(4,Args[4]+10)
TNT1 A 0 A_JumpIf(Args[4]>=30,1)
stop
TNT1 A 0 A_SetArg(3,0)
stop
}
}

actor DragonBreathPKMN : BasicProjectile
{
Translation "192:192=42:42","198:198=43:43"
damagetype "DragonBreath" //1 flash bomb painstate please, thanks
Obituary "%o's body was overcome by %k's \cnDragon \cgBreath\c-."
Renderstyle "Translucent"
Alpha 0.65
Damage(50)
radius 8
height 14
Speed 32
scale 2.5
Args 15,36
States
{
Spawn:
DBTH A 0
DBTH AABBAABBAABBAABB 2 A_ScaleVelocity(0.75) //0.65
stop
Death:
DBTH C 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
DBTH C 0 A_PlaySoundEx("Pokemon/FireSpin","Voice")
DBTH CDCD 2 A_Explode(15,36,0)
DBTH C 0 A_PlaySoundEx("misc/NoSnd","Voice")
DBTH CDCDCDCDCDCDCDCDCDCDCDCDCD 2 A_Explode(Args[0],Args[1],0)
stop
Crash:
TNT1 A 0
stop
}
}


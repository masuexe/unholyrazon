actor WaterShurikenWep_QwantBar : QwantBar {args 2}

actor WaterShurikenWep : BaseQwantWep
{
Obituary "%o felt a wet sensation from %k's \chWater Shuriken\c-."
Tag "Water Shuriken"
weapon.ammotype "WaterTypeAmmo"
inventory.icon "PKMNI_W"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6N01 C 1
loop

Deselect:
6H1C A 0
goto DeselectSwap
Select:
6H1C A 0
goto SelectSwap

Ready:
6H1C A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_WATER_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
6H1C A 0 A_JumpIfInventory("WaterTypeAmmo",2,"ReadyX2")
6H1C A 8 A_WeaponReady(WRF_NOPRIMARY)
6H1C A 0 A_GiveInventory("WaterTypeAmmo",1)
6H1C A 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
6H1C A 8 A_WeaponReady
6H1C A 0 A_GiveInventory("WaterTypeAmmo",1)
6H1C A 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
6H1C B 2 A_GiveInventory("Qwant_WaterShuriken_P")
6H1C C 8
6H1C C 0 A_GiveInventory("MoveRelearnAmmo",1)
6H1C CB 4
6H1C A 2
6H1C A 0 A_GiveInventory("MoveRelearnAmmo",1)
Goto ReadyX
}
}

actor Qwant_WaterShuriken_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("weapon/shadow",1)
TNT1 A 0 A_TakeInventory("WaterTypeAmmo",1,1)
TNT1 A 0 A_TakeInventory("WaterTypeAmmo",1)
TNT1 A 0 A_FireCustomMissile("Q_WaterShuriken",0,0)
TNT1 A 0 A_FireCustomMissile("Q_WaterShurikenLU",0,0)
TNT1 A 0 A_FireCustomMissile("Q_WaterShurikenRU",0,0)
TNT1 A 0 A_FireCustomMissile("Q_WaterShurikenLD",0,0)
TNT1 A 0 A_FireCustomMissile("Q_WaterShurikenRD",0,0)
stop
}
}

actor Q_WaterShuriken : BasicProjectile
{
Translation "192:192=198:198","198:198=4:4"
damagetype "WaterShuriken"
Obituary "%o felt a wet sensation from %k's \chWater Shuriken\c-."
+RIPPER
RenderStyle Add
reactiontime 7
Damage (35+Args[4]*35)//70, was 58
Radius 8
Height 8
Speed 40
scale 2.5
States
{
Spawn:
//X_3H AAB 1
X_3H A 2
X_3H A 0 A_SetArg(4,1)
Spawn2:
X_3H BBA 1
X_3H ABB 1
X_3H A 0 A_CountDown
X_3H AAB 1
loop
Death:
X_8H K 0 A_SpawnItemEx("SoakifyEffect")
X_8H KLMN 1
stop
}
}

actor Q_WaterShuriken2 : Q_WaterShuriken
{
Damage (20+Args[4]*20)//40, was 32
States
{
Spawn:
//X_3H AAB 1
X_3H A 2
TNT1 A 0 A_Changevelocity(0,Args[1]*3/2,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,-Args[0]*3/2,0,1)
X_3H ABB 1
X_3H A 0 A_SetArg(4,1)
Spawn2:
X_3H A 0 A_CountDown
X_3H AAB 1
TNT1 A 0 A_Changevelocity(0,-Args[1]*3,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,Args[0]*3,0,1)
X_3H ABB 1
X_3H A 0 A_CountDown
X_3H AAB 1
TNT1 A 0 A_Changevelocity(0,Args[1]*3,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,-Args[0]*3,0,1)
X_3H ABB 1
loop
}
}

actor Q_WaterShurikenLU : Q_WaterShuriken2{Args -10,8}
actor Q_WaterShurikenLD : Q_WaterShuriken2{Args -10,-8}
actor Q_WaterShurikenRU : Q_WaterShuriken2{Args 10,8}
actor Q_WaterShurikenRD : Q_WaterShuriken2{Args 10,-8}


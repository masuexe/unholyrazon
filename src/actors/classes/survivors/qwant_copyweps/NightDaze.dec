actor NightDazeWep_QwantBar : QwantBar {args 15}

actor NightDazeWep : BaseQwantWep
{
Obituary "%o was laid adrift by %k's \cmNight Daze\c-."
Tag "$TAG_NIGHTDAZE"
weapon.ammotype "DarkTypeAmmo"
inventory.icon "PKMNI_Dk"
States
{
Spawn:
6N01 P 1
loop

Deselect:
OILL A 0
goto DeselectSwap
Select:
OILL A 0
goto SelectSwap

Ready:
OILL A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_DARK_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
OILL A 0 A_JumpIfInventory("DarkTypeAmmo",4,"ReadyX2")
OILL A 8 A_WeaponReady(WRF_NOPRIMARY)
OILL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
OILL A 8 A_WeaponReady
OILL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
OILL A 0 A_TakeInventory("DarkTypeAmmo",2,1)
OILL A 0 A_TakeInventory("DarkTypeAmmo",2)
OILL A 0 A_PlaySoundEx("weapon/pharaoh2","Weapon")
OILL A 0 A_SpawnItemEx("NightDaze1",0,0,28,0,0,0,0)
OILL A 0 A_SpawnItemEx("NightDaze2",0,0,28,0,0,0,90)
OILL A 0 A_SpawnItemEx("NightDaze3",0,0,28,0,0,0,180)
OILL A 0 A_SpawnItemEx("NightDaze4",0,0,28,0,0,0,270)
OILL CC 2
OILL CCCC 8 A_GiveInventory("MoveRelearnAmmo",1)
OILL A 0 A_PlaySoundEx("weapon/junkend","Weapon")
OILL A 0 A_GiveInventory("NightDaze_P",1)
OILL A 0 A_GiveInventory("MoveRelearnAmmo",1)
OILL CCB 3
OILL AA 8 A_GiveInventory("MoveRelearnAmmo",1)
Goto ReadyX
}
}

Actor NightDaze1 : BasicProjectile
{
Translation "192:192=5:5","198:198=8:8"
+BRIGHT
+DONTBLAST
+RIPPER
+THRUGHOST
+NOCLIP
+NOINTERACTION
Obituary "%o got lost in the middle of %k's \cmNight Daze\c-."
Damagetype "NightDaze"
Renderstyle "Translucent"
Alpha 0.75
Damage(0)
Radius 8
Height 8
Scale 2.0
Args 64,8,2
Reactiontime 8
States
{
Spawn:
TMFX A 0
TMFX A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"SpawnR")
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 0 A_Explode(36*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 0 A_Explode(36*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_Countdown
goto Spawn+2
SpawnR:
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-(Args[2]*2))
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-(Args[2]*2))
TMFX A 0 A_Explode(36*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_Countdown
loop
Death:
TNT1 A 0
stop
}
}

Actor NightDazeTrail : BasicClientside
{
+BRIGHT
Alpha 0.7
Scale 2.0
States
{
Spawn:
TMFX L 0
TMFX LL 1 A_SetScale(scaleX-0.12,scaleY-0.12)
TMFX L 0 A_Fadeout(0.2)
TMFX MM 1 A_SetScale(scaleX-0.12,scaleY-0.12)
TMFX L 0 A_Fadeout(0.2)
TMFX LL 1 A_SetScale(scaleX-0.12,scaleY-0.12)
TMFX MM 1 A_Fadeout(0.1)
stop
}
}

Actor NightDaze2 : NightDaze1{Args 128,-8,4}
Actor NightDaze3 : NightDaze1{Args 192,8,6}
Actor NightDaze4 : NightDaze1{Args 256,-8,8}

Actor NightDazeWave : BasicProjectile
{
Translation "192:192=5:5","198:198=8:8"
+BRIGHT
+DONTBLAST
+THRUGHOST
Obituary "%o was laid to rest by %k's \cmNight Daze\c-."
Damagetype "NightDaze"
Renderstyle "Translucent"
Alpha 0.75
Damage(200) //240
Radius 14
Height 14
Speed 40
Scale 2.0
States
{
Spawn:
TMFX L 0
TMFX LLMM 2 A_SpawnItemEx("NightDazeTrail",-6,0,0,0,0,0,0,1)
goto Spawn+1
Death:
TNT1 A 0
stop
}
}

actor NightDaze_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TruePowerItemFlag",1,"PickupX")
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"Pickup2")
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,0,28,cos(-pitch)*40,0,sin(-pitch)*40,0)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,-8,28,cos(-pitch)*40,0,sin(-pitch)*40,12)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,8,28,cos(-pitch)*40,0,sin(-pitch)*40,-12)
stop
Pickup2:
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,0,28,cos(-pitch)*40,0,sin(-pitch)*40,0)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,-8,28,cos(-pitch)*40,0,sin(-pitch)*40,12)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,8,28,cos(-pitch)*40,0,sin(-pitch)*40,-12)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,-16,28,cos(-pitch)*40,0,sin(-pitch)*40,24)
TNT1 A 0 A_SpawnItemEx("NightDazeWave",0,16,28,cos(-pitch)*40,0,sin(-pitch)*40,-24)
stop
PickupX:
TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread",1,"PickupX2")
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,0,28,cos(-pitch)*40,0,sin(-pitch)*40,0)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,-8,28,cos(-pitch)*40,0,sin(-pitch)*40,12)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,8,28,cos(-pitch)*40,0,sin(-pitch)*40,-12)
stop
PickupX2:
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,0,28,cos(-pitch)*40,0,sin(-pitch)*40,0)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,-8,28,cos(-pitch)*40,0,sin(-pitch)*40,12)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,8,28,cos(-pitch)*40,0,sin(-pitch)*40,-12)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,-16,28,cos(-pitch)*40,0,sin(-pitch)*40,24)
TNT1 A 0 A_SpawnItemEx("S_NightDazeWave",0,16,28,cos(-pitch)*40,0,sin(-pitch)*40,-24)
stop
}
}


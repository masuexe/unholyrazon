actor S_NightSlashPKMN : NightSlashPKMN
{
Damage(285) //320
States
{
Crash:
XDeath:
TNT1 A 1 
TNT1 A 0 A_CheckFlag("SHOOTABLE","DeathReal",8)
stop
DeathReal:
TNT1 A 0 A_Warp(8,0,0,28,0)
TNT1 A 0 A_Jump(64,"Critical") //128
TNT1 A 1 A_Explode(285,48,0,0,48) //200
stop
Critical:
TNT1 A 0 A_SpawnItemEx("S_NightSlashCritHit",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
}
}

Actor S_NightSlashCritHit : NightSlashCritHit{ Args 560,48 }

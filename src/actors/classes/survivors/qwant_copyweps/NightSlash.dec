//Pik noted: Bar/HUD *might* a fair bit too dark, but more the bar.
//Other note: I lack aesthethics to make it feel/look satisfying to use, might be the projectile hitbox more.

actor NightSlashWep_QwantBar : QwantBar {args 15}

actor NightSlashWep : BaseQwantWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Obituary "%o didn't see %k's \cmNight Slash\c- coming."
weapon.ammotype "DarkTypeAmmo"
Tag "$TAG_NIGHTSLASH"
inventory.icon "PKMNI_Dk"
States
{
Spawn:
WEA3 Q 1
loop

Deselect:
NGHS A 0
goto DeselectSwap
Select:
NGHS A 0
goto SelectSwap

Ready:
NGHS A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_DARK_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
NGHS A 0 A_JumpIfInventory("DarkTypeAmmo",2,"ReadyX2")
NGHS A 8 A_WeaponReady(WRF_NOPRIMARY)
NGHS A 0 A_GiveInventory("DarkTypeAmmo",1)
NGHS A 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
NGHS A 8 A_WeaponReady
NGHS A 0 A_GiveInventory("DarkTypeAmmo",1)
NGHS A 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
NGHS C 0 A_TakeInventory("DarkTypeAmmo",1,1)
NGHS C 0 A_TakeInventory("DarkTypeAmmo",1)
NGHS C 0 A_PlaySoundEx("weapon/slashclaw","Weapon")
NGHS C 0 A_FireCustomMissile("NightSlashPKMN",0,0,8,0)
NGHS CB 4
NGHS A 8 A_GiveInventory("MoveRelearnAmmo",1) //12
NGHS A 0 A_GiveInventory("MoveRelearnAmmo",1)
goto ReadyX

}
}

actor NightSlashPKMN : BasicProjectile
{
Translation "4:4=150:150","192:192=1:1","198:198=5:5"
Obituary "%o was dispatched by %k's \cmNight Slash\c-."
Damagetype "NightSlash"
+DONTBLAST
+THRUGHOST
+BRIGHT
+DONTREFLECT
+HITTRACER
Damage (180)  //200
Radius 22
Height 12
Speed 20
Scale 2.5
States
{
Spawn:
BLDH V 0
BLDH VVVWWW 2 A_Fadeout(0.12) 
stop
Crash:
XDeath:
TNT1 A 1 
TNT1 A 0 A_CheckFlag("SHOOTABLE","DeathReal",8)
stop
DeathReal:
TNT1 A 0 A_Warp(8,0,0,28,0)
TNT1 A 0 A_Jump(64,"Critical") //128
TNT1 A 1 A_Explode(225,48,0,0,48) //200
stop
Critical:
TNT1 A 0 A_Warp(8,0,0,28,0)
TNT1 A 0 A_SpawnItemEx("NightSlashCritHit",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
}
}

Actor NightSlashCritHit : BasicExplosion
{
Damagetype "NightSlash"
Obituary "%o was critically destroyed by %k's \cmNight Slash\c-."
Scale 3.0
Args 380,48
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("Pokemon/SuperEffective","Voice")
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[1]) //425
MGVB ABCDE 2 A_Fadeout(0.12)
stop
}
}


actor HiddenPowerWep_QwantBar : QwantBar {args 0}

actor HiddenPowerWep : BaseQwantWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Tag "$TAG_HIDDENPOWER"
weapon.ammotype "NormalTypeAmmo"
inventory.icon "PKMNI_N"
States
{
Spawn:
6N01 A 1
loop

Deselect:
DSTS B 0
goto DeselectSwap
Select:
DSTS B 0
goto SelectSwap

Ready:
DSTS B 0 A_GiveInventory("PKHexedStatSpread")
DSTS B 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_NORMAL_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
DSTS B 0 A_JumpIfInventory("NormalTypeAmmo",2,"ReadyX2")
DSTS B 8 A_WeaponReady(WRF_NOPRIMARY)
DSTS B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
DSTS B 8 A_WeaponReady
DSTS B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
DSTS B 0 A_TakeInventory("NormalTypeAmmo",1,1)
DSTS B 0 A_TakeInventory("NormalTypeAmmo",1)
DSTS B 0 A_PlaySoundEx("Pokemon/HiddenPower","Weapon")
DSTS B 0 A_GiveInventory("Legit6IVProjectilePickup")
DSTS DC 4
DSTS B 8 A_GiveInventory("MoveRelearnAmmo",1)
goto ReadyX
}
}

//If you know about any of the following, you either cheated or tried it or like making
//fun of competitive battlers
Actor PKHexedStatSpread : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",1,"No")
TNT1 A 0 A_GiveInventory("HiddenPowerTypeFlag",random(1,18))
TNT1 A 0 A_GiveInventory("HiddenPowerDamageFlag",random(1,16))
stop
No:
TNT1 A 0
stop
}
}

Actor HiddenPowerTypeFlag : Inventory {inventory.amount 1 inventory.maxamount 18}
Actor HiddenPowerDamageFlag : Inventory {inventory.amount 1 inventory.maxamount 15}

Actor Legit6IVProjectilePickup : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",18,"PKMNPoison")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",17,"Fighting")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",16,"PKMNIce")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",15,"PKMNNormal")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",14,"Dragon")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",13,"Fairy")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",12,"PKMNGhost")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",11,"Bug")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",10,"Psychic")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",9,"Dark")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",8,"Steel")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",7,"Flying")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",6,"Rock")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",5,"Ground")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",4,"Electric")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",3,"Water")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",2,"PKMNFire")
TNT1 A 0 A_JumpIfInventory("HiddenPowerTypeFlag",1,"Grass")
goto PKMNNormal
PKMNPoison:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectilePoison",0,0,8,0)
TNT1 A 0 //A_Log	("18 -> Poison")
stop
Fighting:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileFighting",0,0,8,0)
TNT1 A 0 //A_Log	("17 -> Fighting")
stop
PKMNIce:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileIce",0,0,8,0)
TNT1 A 0 //A_Log	("16 -> Ice")
stop
PKMNNormal:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileNormal",0,0,8,0)
TNT1 A 0 //A_Log	("15 -> Normal")
stop
Dragon:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileDragon",0,0,8,0)
TNT1 A 0 //A_Log	("14 -> Dragon")
stop
Fairy:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileFairy",0,0,8,0)
TNT1 A 0 //A_Log	("13 -> Fairy")
stop
PKMNGhost:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileGhost",0,0,8,0)
TNT1 A 0 //A_Log	("12 -> Ghost")
stop
Bug:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileBug",0,0,8,0)
TNT1 A 0 //A_Log	("11 -> Bug")
stop
Psychic:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectilePsychic",0,0,8,0)
TNT1 A 0 //A_Log	("10 -> Psychic")
stop
Dark:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileDark",0,0,8,0)
TNT1 A 0 //A_Log	("9 -> Dark")
stop
Steel:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileSteel",0,0,8,0)
TNT1 A 0 //A_Log	("8 -> Steel")
stop
Flying:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileFlying",0,0,8,0)
TNT1 A 0 //A_Log	("7 -> Flying")
stop
Rock:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileRock",0,0,8,0)
TNT1 A 0 //A_Log	("6 -> Rock")
stop
Ground:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileGround",0,0,8,0)
TNT1 A 0 //A_Log	("5 -> Ground")
stop
Electric:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileElectric",0,0,8,0)
TNT1 A 0 //A_Log	("4 -> Electric")
stop
Water:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileWater",0,0,8,0)
TNT1 A 0 //A_Log	("3 -> Water")
stop
PKMNFire:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileFire",0,0,8,0)
TNT1 A 0 //A_Log	("2 -> Fire")
stop
Grass:
TNT1 A 0 A_FireCustomMissile("Legit6IVProjectileGrass",0,0,8,0)
TNT1 A 0 //A_Log	("1 -> Grass")
stop
}
}

Actor Legit6IVProjectileBase : BasicProjectile
{
+DONTBLAST
+THRUGHOST
Damagetype "HiddenPower"
Obituary "%o was unable to comprehend %k's Hidden Power."
Damage(50 + (25 * CallACS("rz_CountInv_HiddenPowerDamageFlag",2))) //60 + 30x seemed too strong at the time
Radius 12
Height 16
Speed 40
Scale 1.5
States
{
Spawn:
X_3G XY 5
loop
Death:
TNT1 A 0 A_PlaySoundEx("Pokemon/HPDeath","SoundSlot5")
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,60,1)
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,120,1)
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,180,1)
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,240,1)
TNT1 A 0 A_SpawnItemEx("HiddenPowerDeathFX",0,0,4,0,0,0,300,1)
stop
}
}

Actor HiddenPowerDeathFX : BasicGraphicEffect
{
Scale 1.5
States
{
SpawnFrame:
TMFX A 0
TMFX A 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX A 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX A 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX A 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX B 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX B 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX B 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX B 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX C 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX C 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX C 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX C 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX D 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX D 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX D 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX D 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX A 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX A 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX A 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX A 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX B 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX B 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX B 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX B 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX C 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX C 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX C 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX C 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX D 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX D 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
TMFX D 0 A_Fadeout(0.03)
TMFX A 0 A_SetAngle(angle+9.0)
TMFX D 1 A_ChangeVelocity(8,0,0,CVF_RELATIVE|CVF_REPLACE)
stop
}
}


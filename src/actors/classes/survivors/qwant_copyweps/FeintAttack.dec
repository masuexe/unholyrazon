actor FeintAttackWep_QwantBar : QwantBar {args 15, 0, 4}

actor FeintAttackWep : BaseQwantWep {
  Weapon.SlotNumber 4
  Obituary "%o couldn't evade %k's \cmFeint Attack\c-."
  Tag "$TAG_FEINTATTACK"
  Weapon.AmmoType "DarkTypeAmmo"
  Inventory.Icon "PKMNI_Dk"
  States {
   Spawn:
    6N01 P 1
    loop

   Deselect:
    FTAT A 0
    goto DeselectSwap
   Select:
    FTAT A 0
    goto SelectSwap

   Ready:
    FTAT A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_DARK_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    FTAT A 0 A_JumpIfInventory("DarkTypeAmmo", 2, "ReadyX2")
    FTAT A 8 A_WeaponReady(WRF_NOPRIMARY)
    FTAT A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop
   ReadyX2:
    FTAT A 8 A_WeaponReady
    FTAT A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    loop

   Fire:
    FTAT A 0 A_TakeInventory("DarkTypeAmmo", 1, 1)
    FTAT A 0 A_TakeInventory("DarkTypeAmmo", 1)
    FTAT A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    FTAT C 0 A_Recoil(-120)
    TNT1 A 4
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapon/junkend", "Weapon")
    TNT1 A 0 A_FireCustomMissile("FeintAttackZ", 0, 0, 8, 0 | SXF_ABSOLUTEMOMENTUM)
    TNT1 A 4
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    TNT1 A 0 A_Stop
    TNT1 A 0 A_Recoil(120)
    TNT1 A 4
    TNT1 A 0 A_Stop
    FTAT C 4
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    FTAT B 9
    TNT1 A 0 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor FeintAttackZ : BasicProjectile {
  Translation "192:192=252:252", "198:198=246:246"
  DamageType "FeintAttack"
  // +RIPPER
  +FORCEXYBILLBOARD
  +BRIGHT
  Alpha 0.7
  RenderStyle "Translucent"
  Damage (325)  // 275
  Radius 20
  Height 20
  Speed 50
  Scale 5.0
  States {
   Spawn:
    TMFX B 0
    TMFX BCDE 1  // A_Explode(55,65,0)
    TMFX E 0
    TMFX BCDE 1
    TMFX E 0
    TMFX BCDE 1
    TMFX E 0
    TMFX BCDE 1
    TMFX E 0
    TMFX BCDE 1
    TMFX E 0
    stop
  }
}


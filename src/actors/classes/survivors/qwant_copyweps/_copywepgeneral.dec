actor BirdTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor NormalTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor FireTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor WaterTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor ElectricTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor GrassTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor IceTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor FightingTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor PoisonTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor GroundTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor FlyingTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor PsychicTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 56 +INVENTORY.IGNORESKILL}
actor BugTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor RockTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor GhostTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor DragonTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 56 +INVENTORY.IGNORESKILL}
actor DarkTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor SteelTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 28 +INVENTORY.IGNORESKILL}
actor FairyTypeAmmo : Ammo{inventory.amount 1 inventory.maxamount 56 +INVENTORY.IGNORESKILL}

// args[0] = type id → CUST_QWANT_* color
// args[1] > 0 = custom fill: Tag = ammo classname (must be real Ammo); args[1] = fallback max
// Explicit args 0,0 clears NormalBar's inherited args 192,198 (partial args keep remaining values).
// type id list:
// 0 - Normal
// 1 - Fire
// 2 - Water
// 3 - Electric
// 4 - Grass
// 5 - Ice
// 6 - Fighting
// 7 - Poison
// 8 - Ground
// 9 - Flying
// 10 - Psychic
// 11 - Bug
// 12 - Rock
// 13 - Ghost
// 14 - Dragon
// 15 - Dark
// 16 - Steel
// 17 - Fairy
actor QwantBar : NormalBar {args 0, 0}

actor Qwant_WeaponStart_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_QwantStartMoves")
stop
}
}

actor Qwant_AttemptMoveRelearn_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("MoveRelearnAmmo",0,1)
stop
TNT1 A 0 A_GiveInventory("VivifyDelay3",1)
TNT1 A 0 A_TakeInventory("MoveRelearnAmmo",14,1)
TNT1 A 0 A_TakeInventory("MoveRelearnAmmo",14)
TNT1 A 0 A_PlaySound("Qwant/MenuXD2",4,1.0,false,0.75)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_QwantMoveRelearn")
stop
}
}


actor DazzlingGleamWep_QwantBar : QwantBar {args 17}

actor DazzlingGleamWep : BaseQwantWep
{
Obituary "%o was illuminated by %k's \caDazzling Gleam\c-."
Tag "$TAG_DAZZLINGGLEAM"
weapon.ammotype "FairyTypeAmmo"
inventory.icon "PKMNI_Fy"
States
{
Spawn:
6N01 R 1
loop

Deselect:
YAMA B 0 A_TakeInventory("FairyFlag")
goto DeselectSwap
Select:
YAMA B 0
goto SelectSwap

Ready:
YAMA B 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_FAIRY_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
YAMA B 0 A_JumpIfInventory("FairyTypeAmmo",8,"ReadyX2")
YAMA B 8 A_WeaponReady(WRF_NOPRIMARY)
YAMA B 0 A_GiveInventory("FairyTypeAmmo",1)
YAMA B 0 A_GiveInventory("MoveRelearnAmmo",1)
loop
ReadyX2:
YAMA B 8 A_WeaponReady
YAMA B 0 A_GiveInventory("FairyTypeAmmo",1)
YAMA B 0 A_GiveInventory("MoveRelearnAmmo",1)
loop

Fire:
YAMA C 0 A_TakeInventory("FairyTypeAmmo",4,1)
YAMA C 0 A_TakeInventory("FairyTypeAmmo",4)
YAMA C 2 A_GiveInventory("FairyFlag",1) //should just make this D Gleam Flag
YAMA D 0 A_PlaySoundEx("CBM/StarShotSpawn","Weapon")
YAMA D 4 A_FireCustomMissile("DazzlingGleamShot",0,0,8,0)
FireNHold:
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_Refire("FireNHold")
goto Dazzle
YAMA D 1
YAMA D 0 A_GiveInventory("MoveRelearnAmmo",1)
YAMA D 0 A_Refire("Hold")
goto Dazzle
Dazzle:
YAMA C 4 A_GiveInventory("FairyFlag",1)
YAMA B 4 A_TakeInventory("FairyFlag",999) //12
YAMA BB 8 A_GiveInventory("MoveRelearnAmmo",1)
goto ReadyX
}
}

Actor DazzlingGleamShot : BasicProjectile
{
Translation "192:192=237:237","198:198=236:236"
+BRIGHT
+EXPLODEONWATER
Obituary "%k blinded %o with their dazzling beauty."
damagetype "DazzlingGleam"
Damage(160)
Height 12
Radius 12
Speed 28
Scale 3.0
States
{
Spawn:
X_0A B 0
X_0A BB 0 A_SpawnItemEx("FairyRadiusFX",random(-6,6),random(-6,6),random(-6,6),0,0,0,0,1)
X_0A BBB 1 A_JumpIfInTargetInventory("FairyFlag",2,"Death")
X_0A BB 0 A_SpawnItemEx("FairyRadiusFX",random(-6,6),random(-6,6),random(-6,6),0,0,0,0,1)
X_0A CCC 1 A_JumpIfInTargetInventory("FairyFlag",2,"Death")
goto Spawn+1
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("CBM/StarShot","Weapon")
TNT1 A 0 A_SpawnItemEx("DazzlingGleamSparkleSpawner_H",0,0,0,0,0,0,0,1+16384)
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"DeathR")
TNT1 AAAAAAAA 4 A_SpawnItemEx("DazzlingGleamRadius",random(-256,256),random(-256,256),random(-128,128),0,0,0,0,1)
stop
DeathR:
TNT1 AAAAAAAA 3 A_SpawnItemEx("DazzlingGleamRadius",random(-256,256),random(-256,256),random(-128,128),0,0,0,0,1)
stop
}
}

actor FairyFlag : Inventory
{
Inventory.amount 1
Inventory.maxamount 2
}

actor DazzlingGleamRadius : BasicExplosion
{
+BRIGHT
Obituary "%o was dazzled by %k's Dazzling Gleam."
damagetype "DazzlingGleam"
Args 64,160,16
Scale 2.0
States
{
Spawn:
X_4A A 0
X_4A A 0 A_Explode(Args[0],Args[1],0,0,Args[2]) //40,96
X_4A ABCDEF 1 A_FadeOut(0.12)
stop
}
}

Actor DazzlingGleamSparkleSpawner_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"SpawnR")
TNT1 AAAAAAAAAAAAAAAAA 5 A_SpawnItemEx("DazzlingGleamSparkle",random(224,288),0,400,random(-8,-10),0,random(-30,-35),random(0,359))
stop
SpawnR:
TNT1 AAAAAAAAAAAAAAAAA 3 A_SpawnItemEx("DazzlingGleamSparkle",random(224,288),0,400,random(-8,-10),0,random(-30,-35),random(0,359))
stop
}
}

Actor DazzlingGleamSparkle : AstroCrushU
{
+BRIGHT
Translation "4:4=34:34","168:168=34:34","192:192=237:237","198:198=236:236","202:202=237:237","199:199=236:236"
Damagetype "DazzlingGleam"
Obituary "%o became illuminated by %k's Dazzling Gleam."
Damage(100)
Args 100,160,20
States
{
Spawn:
6P0K A 0
6P0K AAABBBCCCDDD 1 A_JumpIf(ceilingz-z>12,"Spawn2")
6P0K A 0 A_JumpIf(momz==0,"Death")
6P0K A 0 A_CountDown
Goto Spawn+2
Spawn2:
6P0K A 0 A_ChangeFlag("RIPPER",0)
6P0K A 0 A_ChangeFlag("NOINTERACTION",0)
6P0K ABCD 3 A_JumpIf(momz==0,"Death")
6P0K A 0 A_CountDown
Goto Spawn2+2
Death:
Y_8B A 0 A_PlaySoundEx("weapon/astrocrush2","Weapon")
Y_8B A 0 A_SetGravity(0.0)
Y_8B A 0 A_SetScale(1.5)
Y_8B A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
Y_8B ABCDEF 2
stop
}
}

actor FairyRadiusFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
Scale 2.0
States
{
Spawn:
X_2F ABCDEF 2
stop
}
}


actor RapidSpinWep_QwantBar : QwantBar {args 0}

actor RapidSpinWep : BaseQwantWep
{
Obituary "%o was spun by %k's \cpRapid Spin\c-."
Tag "Rapid Spin"
weapon.ammotype "NormalTypeAmmo"
inventory.icon "PKMNI_N"
States
{
Spawn:
6N01 A 1
loop

Deselect:
TOPH A 0
goto DeselectSwap
Select:
TOPH A 0
goto SelectSwap

Ready:
TOPH A 0 ACS_NamedExecuteWithResult("core_weaponcolor", Q_NORMAL_DYE, CLRF_QWANTMENU)
goto ReadyX
ReadyX:
TOPH A 0 A_JumpIfInventory("NormalTypeAmmo",4,"ReadyX2")
TOPH A 8 A_WeaponReady(WRF_NOPRIMARY)
TOPH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop
ReadyX2:
TOPH A 8 A_WeaponReady
TOPH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
loop

Fire:
TOPH A 0 A_JumpIf(CallACS("core_CheckFooting"), "ReadyX")
FireX:
TOPH A 0 A_TakeInventory("NormalTypeAmmo",2,1)
TOPH A 0 A_TakeInventory("NormalTypeAmmo",2)
TOPH A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
TOPH A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TOPH A 1 Offset(24,26)
TOPH A 1 Offset(48,20)
TOPH A 1 Offset(72,14)
TOPH A 1 Offset(96,20)
TOPH A 1 Offset(120,26)
TOPH A 1 Offset(144,32) A_GiveInventory("StartRapidSpin_PU")
TNT1 A 0 A_GiveInventory("MoveRelearnAmmo",1)
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_GiveInventory("MoveRelearnAmmo",1)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
Spin:
TNT1 A 0 A_GiveInventory("RapidSpin_PU")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "SpinEnd")
TNT1 A 0 A_JumpIfInventory("KnightFlag",30,1)
Loop
TNT1 A 0 A_TakeInventory("KnightFlag",30)
TNT1 A 0 A_GiveInventory("TopSpinFlag",1)
TNT1 A 0 A_JumpIfInventory("TopSpinFlag",5,"SpinEnd")
TNT1 A 1 A_JumpIf(momz==0,"SpinEnd") //just throwing the 1 in case of some really stupid crash issue
Loop
SpinEnd:
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false) //If for some reason you get to the ground too fast
TOPH A 0 A_TakeInventory("TopSpinFlag", 1)
TOPH A 0 A_TakeInventory("SpinTime")
TOPH A 0 A_TakeInventory("KnightFlag", 1)
TOPH A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
TOPH A 1 Offset(-64,144)
TOPH A 1 Offset(-48,128)
TOPH A 1 Offset(-34,112)
TOPH A 1 Offset(-22,96)
TOPH A 1 Offset(-12,80)
TOPH A 1 Offset(-6,64)
TOPH A 1 Offset(-3,48)
TOPH A 0 A_GiveInventory("MoveRelearnAmmo",1)
Goto ReadyX
}
}

Actor StartRapidSpin_PU : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("JumpCancler")
TNT1 A 0 A_PlaySound("weapon/mirrordeflect2",1)
TNT1 A 0 A_GiveInventory("SpinTime")
TNT1 A 0 A_Recoil(-15) //?
TNT1 A 0 ThrustThingZ(0,10,0,1)
stop
}
}

Actor RapidSpin_PU : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SetAngle(angle-18.0)
TNT1 A 0 A_GiveInventory("KnightFlag",1)
TNT1 A 0 A_FireCustomMissile("RapidSpinRadius",0,0,-28,0,0,-2)
stop
}
}

actor RapidSpinRadius : BasicExplosion
{
Translation "192:192=80:80","198:198=83:83"
damagetype "RapidSpin"
Obituary "%o was spun away by %k's \cpRapid Spin\c-."
Scale 2.5
States
{
Spawn:
X_8A F 0
X_8A FGH 2 A_Explode(72,96,0) //120,148... why?
stop
}
}


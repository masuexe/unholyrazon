{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("JumpCancler")
TNT1 A 0 A_PlaySound("weapon/mirrordeflect2",1)
TNT1 A 0 A_GiveInventory("SpinTime")
TNT1 A 0 A_Recoil(-25)
TNT1 A 0 ThrustThingZ(0,45,0,1)
stop
}
}

Actor S_RapidSpin_PU : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SetAngle(angle-18.0)
TNT1 A 0 A_GiveInventory("KnightFlag",1)
TNT1 A 0 A_FireCustomMissile("S_RapidSpinRadius",0,0,-28,0,0,-2)
stop
}
}

actor S_RapidSpinRadius : RapidSpinRadius
{
States
{
Spawn:
X_8A F 0
X_8A FGH 2 A_Explode(84,96,0)
stop
}
}

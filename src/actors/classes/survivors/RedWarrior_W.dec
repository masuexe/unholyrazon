actor GauntletLowHPFlag : Powerup {
  Powerup.Duration 37
}

actor TreasureAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 150
  +INVENTORY.IGNORESKILL
}

actor RedWarrior_LowHP_P : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_JumpIfInventory("IsDead",1,"No")
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25, "Gauntlet")
    stop
   Gauntlet:
    TNT1 A 0 A_JumpIfInventory("GauntletLowHPFlag", 1, "No")
    TNT1 A 0 A_PlaySound("GNT/LowHealth", 4)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 5)
    TNT1 A 0 A_GiveInventory("GauntletLowHPFlag", 1)
    TNT1 A 0 A_Jump(256, "Gauntlet2")
    stop
   Gauntlet2:
    TNT1 A 0 A_GiveInventory("PowerDamageRedWarrior", 1)
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor PowerDamageRedWarrior : PowerDamage {
  Powerup.Duration 40
  DamageFactor "RedWarrior", 1.25
}

actor RedWarrior_Ready0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyEndlessAmmo", 1, "PickupE")
    TNT1 A 0 A_JumpIfInventory("TreasureAmmo", 75, 3)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
   P0:
    TNT1 A 0 A_WeaponReady
    stop
   PickupE:
    TNT1 A 0 A_JumpIfInventory("TreasureAmmo", 25, "P0")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
  }
}
actor RedWarrior_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyEndlessAmmo", 1, "PickupE")
    TNT1 A 0 A_JumpIfInventory("TreasureAmmo", 75, 3)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
   P0:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ammo:
    TNT1 A 0 A_GiveInventory("TreasureAmmo", 2)
    stop
   PickupE:
    TNT1 A 0 A_JumpIfInventory("TreasureAmmo", 25, "P0")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
  }
}

actor RedWarrior_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("TreasureAmmo", 50, 1)
    TNT1 A 0 A_TakeInventory("TreasureAmmo", 25)
    TNT1 A 0 A_GiveInventory("VivifyDelay4", 1)
    TNT1 A 0 A_PlaySound("GNT/ExitTele", 1)
    stop
  }
}

actor RedWarrior_SecretRoom_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("WarriorStack1", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack2", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack3", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 0, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WarriorStack", 7, "Treasure")
    TNT1 A 0 A_GiveInventory("WarriorStack", 1)
    stop
   Treasure:
    TNT1 A 0 A_PlaySound("GNT/KeyCollect", 0)
    TNT1 A 0 A_GiveInventory("TruePowerItem", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack")
    TNT1 A 0 A_TakeInventory("WarriorStack1")
    TNT1 A 0 A_TakeInventory("WarriorStack2")
    TNT1 A 0 A_TakeInventory("WarriorStack3")
    TNT1 A 0 A_TakeInventory("WarriorStack4")
    TNT1 A 0 A_TakeInventory("WarriorStack5")
    TNT1 A 0 A_TakeInventory("WarriorStack6")
    stop
  }
}

actor WarriorStack : Inventory {
  inventory.amount 1
  inventory.maxamount 99
}

actor WarriorStack1 : WarriorStack {}  // Reflect
actor WarriorStack2 : WarriorStack {}  // Speed
actor WarriorStack3 : WarriorStack {}  // Power
actor WarriorStack4 : WarriorStack {}  // Ripper
actor WarriorStack5 : WarriorStack {}  // Explosion
actor WarriorStack6 : WarriorStack {}  // Homing

actor RedWarrior_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("TreasureAmmo", 4)
    TNT1 A 0 A_JumpIfInventory("WarriorStack1", 1, "P1")
    TNT1 A 0 A_JumpIfInventory("WarriorStack2", 1, "P2")
    TNT1 A 0 A_JumpIfInventory("WarriorStack3", 1, "P3")
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P4")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P5")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShotBase", 0, 0, 8, 0)
    goto End


   EndX:
    TNT1 A 0 A_PlaySound("GNT/Red44", 1)
    goto End+1
   End:
    TNT1 A 0 A_PlaySound("GNT/RNGShot", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack1", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack2", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack3", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack4", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack5", 1)
    TNT1 A 0 A_TakeInventory("WarriorStack6", 1)
    stop
    // ****************
    // SINGLE
    // ****************
   P1:
    TNT1 A 0 A_JumpIfInventory("WarriorStack2", 1, "P21")
    TNT1 A 0 A_JumpIfInventory("WarriorStack3", 1, "P31")
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P41")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P51")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P61")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot1", 0, 0, 8, 0)goto End
   P2:
    TNT1 A 0 A_JumpIfInventory("WarriorStack3", 1, "P32")
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P42")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P52")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P62")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot2", 0, 0, 8, 0)goto End
   P3:
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P43")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P53")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P63")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot3", 0, 0, 8, 0)goto EndX
   P4:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P54")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P64")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot4", 0, 0, 8, 0)goto End
   P5:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P65")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot5", 0, 0, 8, 0)goto End
   P6: TNT1 A 0 A_FireCustomMissile("RedWarriorShot6", 0, 0, 8, 0)goto End
    // ****************
    // DOUBLE
    // ****************
    // 1
   P21:
    TNT1 A 0 A_JumpIfInventory("WarriorStack3", 1, "P321")
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P421")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P521")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P621")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot21", 0, 0, 8, 0)goto End
   P31:
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P431")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P531")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P631")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot31", 0, 0, 8, 0)goto EndX
   P41:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P541")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P641")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot41", 0, 0, 8, 0)goto End
   P51:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P651")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot51", 0, 0, 8, 0)goto End
   P61: TNT1 A 0 A_FireCustomMissile("RedWarriorShot61", 0, 0, 8, 0)goto End
    // 2
   P32:
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P432")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P532")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P632")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot32", 0, 0, 8, 0)goto EndX
   P42:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P542")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P642")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot42", 0, 0, 8, 0)goto End
   P52:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P652")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot52", 0, 0, 8, 0)goto End
   P62: TNT1 A 0 A_FireCustomMissile("RedWarriorShot62", 0, 0, 8, 0)goto End
    // 3
   P43:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P543")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P643")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot43", 0, 0, 8, 0)goto EndX
   P53:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P653")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot53", 0, 0, 8, 0)goto EndX
   P63: TNT1 A 0 A_FireCustomMissile("RedWarriorShot63", 0, 0, 8, 0)goto EndX
    // 4
   P54:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P654")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot54", 0, 0, 8, 0)goto End
   P64:
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot64", 0, 0, 8, 0)goto End
    // 5
   P65: TNT1 A 0 A_FireCustomMissile("RedWarriorShot65", 0, 0, 8, 0)goto End
    // ****************
    // TRIPLE
    // ****************
    // 1
   P321:
    TNT1 A 0 A_JumpIfInventory("WarriorStack4", 1, "P4321")
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P5321")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6321")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot321", 0, 0, 8, 0)goto EndX
   P421:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P5421")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6421")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot421", 0, 0, 8, 0)goto End
   P521:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6521")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot521", 0, 0, 8, 0)goto End
   P621: TNT1 A 0 A_FireCustomMissile("RedWarriorShot621", 0, 0, 8, 0)goto End
   P431:
    TNT1 A 0 A_JumpIfInventory("WarriorStack5", 1, "P5431")
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6431")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot431", 0, 0, 8, 0)goto EndX
   P531:
    TNT1 A 0 A_JumpIfInventory("WarriorStack6", 1, "P6531")
    TNT1 A 0 A_FireCustomMissile("RedWarriorShot531", 0, 0, 8, 0)goto EndX
   P631: TNT1 A 0 A_FireCustomMissile("RedWarriorShot631", 0, 0, 8, 0)goto EndX
   P541:

actor RedWarriorShotBase : BasicProjectile {
  Translation "192:192=31:31", "198:198=47:47", "199:199=225:225"
  damagetype "RedWarrior"
  Obituary "$OB_44M0"
  +SKYEXPLODE
  +EXPLODEONWATER
  +SEEKERMISSILE
  +FORCEXYBILLBOARD
  reactiontime 10
  Damage (100)
  radius 10
  height 10
  Speed 30
  scale 3.0
  Args 0
  States {
   Spawn:
    goto S2

   S1:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 1
    goto S1+2
   S1B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 1
    6P44 B 0 A_CountDown
    goto S1B+2
   S1H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 1 A_SeekerMissile(1, 8, SMF_LOOK, 45, 4)
    6P44 B 0 A_CountDown
    goto S1H+2
   S2:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 2
    goto S2+2
   S2B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 2
    6P44 B 0 A_CountDown
    goto S2B+2
   S2H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 2 A_SeekerMissile(1, 8, SMF_LOOK, 45, 4)
    6P44 B 0 A_CountDown
    goto S2H+2
   S3:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 3
    goto S3+2
   S3B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 3
    6P44 B 0 A_CountDown
    goto S3B+2
   S3H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 BCDEFGHI 3 A_SeekerMissile(1, 8, SMF_LOOK, 45, 4)
    6P44 B 0 A_CountDown
    goto S3H+2

   S_1:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 1
    goto S_1+2
   S_1B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 1
    6P44 J 0 A_CountDown
    goto S_1B+2
   S_1H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 1 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 I 0 A_CountDown
    goto S_1H+2
   S_2:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 2
    goto S_2+2
   S_2B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 2
    6P44 J 0 A_CountDown
    goto S_2B+2
   S_2H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 2 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 I 0 A_CountDown
    goto S_2H+2
   S_3:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 3
    goto S_3+2
   S_3B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 3
    6P44 J 0 A_CountDown
    goto S_3B+2
   S_3H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 JKLMNOPQ 3 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 I 0 A_CountDown
    goto S_3H+2

   S__1:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 1
    goto S__1+2
   S__1B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 1
    6P44 R 0 A_CountDown
    goto S__1B+2
   S__1H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 1 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 Q 0 A_CountDown
    goto S__1H+2
   S__2:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 2
    goto S__2+2
   S__2B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 2
    6P44 R 0 A_CountDown
    goto S__2B+2
   S__2H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 2 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 Q 0 A_CountDown
    goto S__2H+2
   S__3:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 3
    goto S__3+2
   S__3B:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 3
    6P44 R 0 A_CountDown
    goto S__3B+2
   S__3H:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
    6P44 RSTUVWXY 3 A_SeekerMissile(1, 6, SMF_LOOK, 45, 4)
    6P44 Q 0 A_CountDown
    goto S__3H+2

   Death:
    6P44 "#" 0 A_CheckFlag("NOFEAR", "DeathBoom")
    6P44 "#" 1 A_CheckFlag("SCREENSEEKER", "DeathFade")
    6P44 A 5
    stop
   DeathBoom:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("GNT/FakeWall", 1)
    TNT1 A 0 A_Explode(70+Args[0], 128+Args[0]/2, 0, 0, 10+Args[0]/5)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
   DeathFade:
    "####" "#" 2 A_FadeOut(0.08)
    Loop
  }
}

actor RedWarriorShot1 : RedWarriorShotBase {
  BounceSound "GNT/Bounce"
  Obituary "$OB_44M1"
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  -EXPLODEONWATER
  WALLBOUNCEFACTOR 0.945
  BOUNCEFACTOR 0.945
  bouncecount 25
  Damage (100-5)
  States {
   Spawn:
    TNT1 A 1
    goto S_2B
  }
}


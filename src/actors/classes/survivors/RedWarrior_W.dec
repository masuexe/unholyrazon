actor RedWarrior_W_ScriptBar : ScriptBar {}
actor RedWarrior_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 150
  Inventory.Pickupmessage "$PU_44_A"
  Obituary "$OB_44W1"
  Tag "$TAG_RedWarrior_W"
  weapon.ammotype "TreasureAmmo"
  inventory.icon "C_I_44A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H44 [ 6
    loop

   Deselect:
    6H44 A 0
    goto DeselectSwap
   Select:
    6H44 A 0
    goto SelectSwap

   Ready:
    6H44 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", REDWARRIOR_DYE)
    6H44 A 0 A_GunFlash("Flash", 1)
    goto Ready2
   Ready2:
    6H44 A 2 A_GiveInventory("RedWarrior_Ready0_P")
    6H44 A 2 A_GiveInventory("RedWarrior_Ready_P")
    loop

    // 6H44 A 0 A_GiveInventory("PowerBotRageRune",1)

   Fire:
    6H44 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H44 B 0 A_GiveInventory("RedWarrior_Fire_P")
    6H44 BCDE 2
    Goto Ready2

   BotFire:
    6H44 B 0 A_JumpIfInventory("TreasureAmmo", 150, "BotFire2")
    6H44 B 0 A_Jump(8, "BotSwap")
    6H44 B 0 A_Jump(24, "AltFire1")
    6H44 B 0 A_Jump(64, 1)
    goto Fire+1
    6H44 B 0 A_GiveInventory("TreasureAmmo", random(10, 45))
    goto Fire+1
   BotFire2:
    6H44 B 0 A_Jump(196, "AltFire1")
    goto BotSwap

   BotSwap:
    6H44 B 0 A_PlaySoundEx("taunt/D_44", "Voice")
    6H44 B 0 A_GiveInventory("TreasureAmmo", random(50, 100))
    6H44 B 0 A_Jump(198, 1, 2, 3, 4, 5, 6)
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W")
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W2")
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W3")
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W4")
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W5")
    goto AltFire
    6H44 B 0 A_SelectWeapon("RedWarrior_W6")
    goto AltFire


   Flash:
    TNT1 A 1 A_GiveInventory("RedWarrior_LowHP_P")
    loop

   AltFire:
    "####" "#" 0 A_JumpIfInventory("PlayerPropertyEndlessAmmo", 1, "AltfireE")
    "####" "#" 0 A_JumpIfInventory("TreasureAmmo", 75, "Altfire1")
    goto Ready2
   AltfireE:
    "####" "#" 0 A_JumpIfInventory("TreasureAmmo", 25, "Altfire1")
    goto Ready2
   AltFireX:
    "####" "#" 0 A_PlaySound("GNT/FailUse", 1)
    "####" "#" 6 A_GiveInventory("RedWarrior_SecretRoom_P")
   AltFireX_H:
    "####" "#" 6 A_GiveInventory("TreasureAmmo", 6)
    "####" "#" 0 A_ReFire("AltFireX_H")
    "####" "#" 0 A_JumpIfInventory("TreasureAmmo", 75-50*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Ready2")
    goto Ready2

   Altfire1:
    // 6H44 G 0 A_JumpIfInventory("WarriorStack1",99,"AltFireX")
    6H44 G 0 A_GiveInventory("RedWarrior_Alt_P")
    6H44 G 0 A_ReFire(1)
    6H44 G 0 A_SpawnItemEx("WarriorStack1FX", -1, 0, 56, 0, 0, 2)
    6H44 GFGFGFGFGA 2 A_GiveInventory("WarriorStack1", 1)
    goto Ready2
    /*
    OldAlt:
    6H44 B 0 A_PlaySound("GNT/ExitTele",1)
    6H44 BBC 3
    6H44 C 0 A_JumpIfInventory("WarriorStack1",6,"BackDownWeGo")
    6H44 C 0 A_GiveInventory("WarriorStack1",1)
    Goto AltIsComplete
    BackDownWeGo:
    6H44 C 0 A_TakeInventory("WarriorStack1",5)
    AltIsComplete:
    6H44 CBB 3
    6H44 A 0 A_Refire
    goto Ready2
    AltHoldX:
    6H44 A 1
    6H44 A 0 A_Refire
    Goto Ready2
    */
  }
}

actor RedWarrior_W2_ScriptBar : ScriptBar {}
actor RedWarrior_W2 : RedWarrior_W {
  Inventory.Pickupmessage "$PU_44_B"
  Obituary "$OB_44W2"
  Tag "$TAG_RedWarrior_W2"
  inventory.icon "C_I_44B"
  States {
   Deselect:
    6H44 H 0
    goto DeselectSwap
   Select:
    6H44 H 0
    goto SelectSwap

   Ready:
    6H44 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", REDWARRIOR_DYE)
    6H44 H 0 A_GunFlash("Flash", 1)
    goto Ready2
   Ready2:
    6H44 H 2 A_GiveInventory("RedWarrior_Ready0_P")
    6H44 H 2 A_GiveInventory("RedWarrior_Ready_P")
    loop

   Fire:
    6H44 I 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H44 I 0 A_GiveInventory("RedWarrior_Fire_P")
    6H44 IJKL 2
    Goto Ready2

   Altfire1:
    // 6H44 N 0 A_JumpIfInventory("WarriorStack2",99,"AltFireX")
    6H44 G 0 A_GiveInventory("RedWarrior_Alt_P")
    6H44 G 0 A_ReFire(1)
    6H44 N 0 A_SpawnItemEx("WarriorStack2FX", -1, 0, 56, 0, 0, 2)
    6H44 NMNMNMNMNH 2 A_GiveInventory("WarriorStack2", 1)
    goto Ready2
  }
}


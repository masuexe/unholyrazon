actor Qwant : CustWepClassBase
{
player.scoreIcon "UMUG_1"
player.displayname "Qwant"
player.soundclass "Qwant"
Player.Maxhealth 1000 //1100
health 1000 //1100
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 10
player.startitem "UH_BaseFlagPack"
player.startitem "Qwant_W"
player.startitem "MyDestinyAmmo", 28

player.startitem "Qwant_WeaponStart_P"
player.startitem "NoDrawMaestroMugshot"
player.startitem "UHMugshotQwant"

//player.startitem "Qwant_ZomoWep_P"
//player.startitem "QwantDebugItem1"
//player.startitem "QwantDebugItem2"

States
{
Spawn:
QEGA A 0
QEGA B 1
QEGA A 1
Goto Spawn+2
See:
QEGA BCDE 5
Goto Spawn
Missile:
QEGA F 0 A_JumpIfInventory("VivifyDelay3",1,"Missile2")
QEGA F 0 A_JumpIfInventory("FireBlastVivifyFlag",1,"Missile_FlameBlast")
QEGA F 5
QEGA G 4
goto Spawn+2
Missile2:
QEGA M 10
goto Spawn+2
Missile_FlameBlast:
QEGA FFFGG 8
goto Spawn+2
ClassPain:
QEGA H 0
Goto MegamanPain

ClassDeath:
QEGA H 0
Goto MegamanDeath
MegamanDisintegrate:
QEGA Z 0 A_SpawnItemEx("Corpse_01",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}

actor QwantS : Qwant
{
player.scoreIcon "UMUG_S1"
Player.Maxhealth 3000 //3100
health 3000 //3100
player.forwardmove 1.2, 1.2
player.sidemove 1.2, 1.2
player.jumpz 11
player.morphweapon "QwantS_W"
+NOSKIN
+NOMORPHLIMITATIONS
}

actor Corpse_01:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_01_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_01_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_01_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_01_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_01_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_01_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}

actor Corpse_01_0:BaseCorpseFX{States{Spawn:1H01 O 350
goto Spawn2}}

actor Qwant : CustWepClassBase {
  Player.ScoreIcon "UMUG_1"
  Player.DisplayName "Qwant"
  Player.SoundClass "Qwant"
  Player.MaxHealth 1000  // 1100
  Health 1000  // 1100
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Qwant_W"
  Player.StartItem "MyDestinyAmmo", 28

  Player.StartItem "Qwant_WeaponStart_P"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.StartItem "UHMugshotQwant"

  // Player.StartItem "Qwant_ZomoWep_P"
  // Player.StartItem "QwantDebugItem1"
  // Player.StartItem "QwantDebugItem2"

  States {
   Spawn:
    QEGA A 0
    QEGA B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    QEGA A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn+2
   See:
    QEGA BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Jumping")
    goto Spawn
   Jumping:
    QEGA L 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
    loop
   Missile:
    QEGA F 0 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    QEGA F 0 A_JumpIfInventory("FireBlastVivifyFlag", 1, "Missile_FlameBlast")
    QEGA F 5
    QEGA G 4
    goto Spawn+2
   Missile2:
    QEGA M 10
    goto Spawn+2
   Missile_FlameBlast:
    QEGA FFFGG 8
    goto Spawn+2
   ClassPain:
    QEGA H 0
    goto MegamanPain

   ClassDeath:
    QEGA H 0
    goto MegamanDeath
   MegamanDisintegrate:
    QEGA Z 0 A_SpawnItemEx("Corpse_01", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}

actor QwantShiny : Qwant {
  Player.ScoreIcon "UMUG_S1"
  Player.MaxHealth 3000  // 3100
  Health 3000  // 3100
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 11
  Player.MorphWeapon "QwantShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_01 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_01_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_01_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_01_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_01_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_01_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_01_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_01_0 : BaseCorpseFX {States {Spawn: 1H01 O 350
    goto Spawn2}}
actor Corpse_01_1 : BaseCorpseFX {States {Spawn: 1H01 P 350
    goto Spawn2}}
actor Corpse_01_2 : BaseCorpseFX {States {Spawn: 1H01 Q 350
    goto Spawn2}}
actor Corpse_01_3 : BaseCorpseFX {States {Spawn: 1H01 R 350
    goto Spawn2}}
actor Corpse_01_4 : BaseCorpseFX {States {Spawn: 1H01 S 350
    goto Spawn2}}
actor Corpse_01_5 : BaseCorpseFX {States {Spawn: 1H01 T 350
    goto Spawn2}}

actor Saboteur : CustWepClassBase {
  player.scoreIcon "UMUG_22"
  player.displayname "Saboteur"
  player.soundclass "Saboteur"
  Player.Maxhealth 885
  health 885
  player.forwardmove 1.15, 1.15
  player.sidemove 1.15, 1.15
  player.jumpz 12
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "Saboteur_W"
  player.startitem "SaboteurEnergyAmmo", 6

  States {
   Spawn:
    FLSM A 0
    FLSM B 1
    FLSM A 1
    Goto Spawn+2
   See:
    FLSM BCDE 5
    Goto Spawn
   Missile:
    FLSM GGGGG 1
    FLSM GGGG 1
    goto Spawn+2
   ClassPain: FLSM H 0
    Goto MegamanPain

   ClassDeath:
    FLSH H 0
    goto MegamanDeath
   MegamanDeath0:
    FLSM H 6 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLSM H 0 A_PlaySound("*death", 2)
    TNT1 A 0 A_SpawnItemEx("SaboteurPrettyShotDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("SaboteurPrettyShotAltDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 1
    goto MegamanErase
   MegamanDisintegrate:
    FLSH H 0
    goto MegamanCorpseEnd
  }
}
actor SaboteurShiny : Saboteur {
  player.scoreIcon "UMUG_S22"
  Player.Maxhealth 2885
  health 2885
  player.forwardmove 1.25, 1.25
  player.sidemove 1.25, 1.25
  player.jumpz 13
  player.morphweapon "SaboteurShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    FLSM H 6 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLSM H 0 A_PlaySound("*death", 2)
    TNT1 A 0 A_SpawnItemEx("S_SaboteurPrettyShotDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("S_SaboteurPrettyShotAltDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 1
    goto MegamanErase
  }
}


//Afterlife! %k's last pelvic thrust really drove %o insa-a-a-ane!"
//"WHO WROTE THIS?" - Trist

actor SaboteurPrettyShotDeath : SaboteurPrettyShot {
  Obituary "$OB_22D"
  Damage (125)
}
actor SaboteurPrettyShotAltDeath : SaboteurPrettyShotAlt {
  Obituary "$OB_22D"
  Damage (125)
}
actor S_SaboteurPrettyShotDeath : SaboteurPrettyShot {
  Damage (188)
}
actor S_SaboteurPrettyShotAltDeath : SaboteurPrettyShotAlt {
  Damage (188)
}


actor Corpse_22 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_22_0", 0, 0, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_1", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_3", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_4", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_5", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_6", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


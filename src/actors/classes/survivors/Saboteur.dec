actor Saboteur : CustWepClassBase {
  Player.ScoreIcon "UMUG_22"
  Player.DisplayName "Saboteur"
  Player.SoundClass "Saboteur"
  Player.MaxHealth 885
  Health 885
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Saboteur_W"
  Player.StartItem "SaboteurEnergyAmmo", 6

  States {
   Spawn:
    FLSM A 0
    FLSM B 1
    FLSM A 1
    goto Spawn+2
   See:
    FLSM BCDE 5
    goto Spawn
   Missile:
    FLSM GGGGG 1
    FLSM GGGG 1
    goto Spawn+2
   ClassPain:
    FLSM H 0
    goto MegamanPain

   ClassDeath:
    FLSH H 0
    goto MegamanDeath
   MegamanDeath0:
    FLSM H 6 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLSM H 0 A_PlaySound("*death", 2)
    TNT1 A 0 A_SpawnItemEx("SaboteurPrettyShotDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("SaboteurPrettyShotAltDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 1
    goto MegamanErase
   MegamanDisintegrate:
    FLSH H 0
    goto MegamanCorpseEnd
  }
}
actor SaboteurShiny : Saboteur {
  Player.ScoreIcon "UMUG_S22"
  Player.MaxHealth 2885
  Health 2885
  Player.ForwardMove 1.25, 1.25
  Player.SideMove 1.25, 1.25
  Player.JumpZ 13
  Player.MorphWeapon "SaboteurShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    FLSM H 6 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    FLSM H 0 A_PlaySound("*death", 2)
    TNT1 A 0 A_SpawnItemEx("S_SaboteurPrettyShotDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("S_SaboteurPrettyShotAltDeath", 0, 0, 32, 34, 0, 0, 0, 1)
    TNT1 A 1
    goto MegamanErase
  }
}


// Afterlife! %k's last pelvic thrust really drove %o insa-a-a-ane!"
// "WHO WROTE THIS?" - Trist

actor SaboteurPrettyShotDeath : SaboteurPrettyShot {
  Obituary "$OB_22D"
  Damage (125)
}
actor SaboteurPrettyShotAltDeath : SaboteurPrettyShotAlt {
  Obituary "$OB_22D"
  Damage (125)
}
actor S_SaboteurPrettyShotDeath : SaboteurPrettyShot {
  Damage (188)
}
actor S_SaboteurPrettyShotAltDeath : SaboteurPrettyShotAlt {
  Damage (188)
}


actor Corpse_22 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_22_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_22_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


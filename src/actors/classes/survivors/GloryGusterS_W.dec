actor GloryGusterS_W_NormalBar : NormalBar {args 224, 28}

actor GloryGusterS_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_GloryGuster_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_27"
Obituary "$OB_27W"
weapon.ammotype "SouthWindMagic"
States
{
Spawn:
7H27 [ 6
loop

Deselect:
7H27 A 0
goto DeselectSwap
Select:
7H27 A 0
goto SelectSwap

Ready:
7H27 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", GLORYGUSTER_SDYE)
goto Ready2
Ready2:
7H27 A 2 A_GiveInventory("GloryGuster_Ready_P")
loop

Fire:
7H27 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H27 E 0 A_GiveInventory("S_GloryGuster_Fire_P")
7H27 H 1
7H27 I 3
7H27 J 1
7H27 J 1 Offset(12,40)
7H27 J 7 Offset(26,50)
7H27 J 22 Offset(26,50)//Offset(33,62)
7H27 J 2 Offset(16,44) A_GiveInventory("SouthWindMagic", 3)
7H27 J 2 Offset(6,37) A_GiveInventory("SouthWindMagic", 3)
7H27 J 2 Offset(-5,35) A_GiveInventory("SouthWindMagic", 3)
7H27 A 2 Offset(39,26) A_GiveInventory("SouthWindMagic", 3)
7H27 A 2 Offset(26,26) A_GiveInventory("SouthWindMagic", 3)
7H27 A 2 Offset(13,29) A_GiveInventory("SouthWindMagic", 3)
Goto Ready2

BotFire:
7H27 A 0 A_Jump(24,"BotFire3")
7H27 A 0 A_JumpIfInventory("SouthWindMagic",150,"Altfire")
7H27 A 0 A_Jump(48,"BotFire2")
goto Fire+1
BotFire2:
7H27 A 0 A_ChangeVelocity(momx,momy,9.5,CVF_REPLACE)
7H27 A 0 A_PlaySound("classes/woosh",4)
7H27 TSSST 2 A_GiveInventory("SouthWindMagic",5)
7H27 A 0 A_WeaponReady(14)
7H27 A 2 A_GiveInventory("SouthWindMagic",5)
7H27 A 0 A_Jump(8,"BotFire3")
7H27 A 0 A_Jump(128,"BotFire2")
goto BotFire
BotFire3:
7H27 A 0 A_FireCustomMissile("S_GloryGuster_BladesInABox",0,0,0,0)
7H27 A 10 A_PlaySoundEx("taunt/D_27","Voice")
goto Fire+1

Altfire:
7H27 M 0 A_GiveInventory("S_GloryGuster_Alt_P")
7H27 CDCB 2
7H27 B 8
7H27 EFGA 2
Goto Ready2
}
}

actor S_GloryGuster_Fire_P : GloryGuster_Fire_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_GloryGuster_Vortex",0,0,0,0)
goto Firin
}
}
actor S_GloryGuster_Alt_P : GloryGuster_Alt_P
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_GloryGuster_BladesInABox",0,0,0,-8)
goto Altin
}
}


actor S_GloryGuster_Vortex : GloryGuster_Vortex
{
Translation "192:192=224:224","198:198=28:28"
Damage (54)//36
States
{
Spawn:
6P27 A 0
6P27 A 1 A_SpawnItemEx("GloryGuster_VortexD",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,1+8)
6P27 B 1 A_SpawnItemEx("GloryGuster_VortexA",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,1+8)
6P27 C 1 A_SpawnItemEx("GloryGuster_VortexB",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,1+8)
6P27 D 1 A_SpawnItemEx("GloryGuster_VortexC",0,0,0,momx*0.5,momy*0.5,momz*0.5,0,1+8)
6P27 A 0 A_CountDownArg(0)
loop
Death:
TNT1 A 0 A_SpawnItemEx("S_GloryGuster_VortexBlade",0,0,4,32,0,0,0,1)
goto XDeath
}
}


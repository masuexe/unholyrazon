actor HeavyBomberShiny_W_NormalBar : NormalBar {args 197, 199}
actor HeavyBomberShiny_W_SecondBar : SecondBar {args 86, 133}

actor HeavyBomberShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_HeavyBomber_W"
  Weapon.AmmoUse 5
  Weapon.AmmoUse2 0
  Inventory.Pickupmessage "$PU_19"
  Obituary "$OB_19W"
  Weapon.AmmoType "SafeEnergyAmmo"
  Weapon.AmmoType2 "HFlightEnergyAmmo"
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H19 [ 6
    loop

   Deselect:
    7H19 A 0
    goto DeselectSwap
   Select:
    7H19 A 0
    goto SelectSwap

   Ready:
    7H19 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HEAVYBOMBER_SDYE)
    goto Ready2
   Ready2:
    7H19 A 2 A_GiveInventory("HeavyBomber_Ready_P")
    loop

   Fire:
    7H19 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireA")
    7H19 A 0 A_GiveInventory("DuoBusterFlag")
    7H19 D 2 A_GiveInventory("S_HeavyBomber_Fire_P1")
    7H19 E 2
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P2")
    7H19 H 2
    7H19 G 0 A_ReFire("Fire2")
    7H19 G 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    goto Ready2
   Fire2:
    7H19 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H19 A 0 A_JumpIfNoAmmo(6)
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P1")
    7H19 E 2
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P2")
    7H19 H 2
    7H19 G 0 A_ReFire("Fire2")
    7H19 G 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    goto Ready2
   FireA:
    7H19 A 0 A_TakeInventory("DuoBusterFlag")
    7H19 G 2 A_GiveInventory("S_HeavyBomber_Fire_P2")
    7H19 H 2
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P1")
    7H19 E 2
    7H19 D 0 A_ReFire("FireA2")
    7H19 D 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    goto Ready2
   FireA2:
    7H19 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H19 A 0 A_JumpIfNoAmmo(6)
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P2")
    7H19 H 2
    7H19 B 2 A_GiveInventory("S_HeavyBomber_Fire_P1")
    7H19 E 2
    7H19 D 0 A_ReFire("FireA2")
    7H19 D 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    goto Ready2

   BotFire:
    7H19 A 0 A_JumpIfNoAmmo("BotFire3")
    7H19 A 0 A_JumpIfInventory("HFlightEnergyAmmo", 0, "MissileSpam")
    7H19 A 0 A_Jump(16, "BotFire2")
    7H19 A 0 A_Jump(32, 1)
    goto BotFire4
    7H19 A 0 A_GiveInventory("SafeEnergyAmmo", 60)
    goto BotFire4
   BotFire2:
    7H19 A 0 A_SpawnItemEx("HSH_DustBoostFX")
    7H19 A 0 A_PlaySoundEx("classes/taunt/heavybomber", "Voice")
    7H19 A 0 A_FaceTarget
    7H19 A 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    7H19 A 0 A_FireCustomMissile("S_DEMSpawnShot2Bot", -5, 1, 20, 0)
    7H19 A 0 A_FireCustomMissile("S_DEMSpawnShot2Bot", 5, 1, -20, 0)
    7H19 A 0 A_ChangeVelocity(-cos(pitch) * 10, 0, sin(pitch) * 10, CVF_RELATIVE)
    7H19 BCB 2
    7H19 A 16
    goto Ready2
   BotFire3:
    7H19 A 0 A_PlaySoundEx("weapon/pursuitfire", "Weapon")
    7H19 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    7H19 BC 2
    7H19 CCCCCCCCCC 2 A_GiveInventory("SafeEnergyAmmo", 20)
    7H19 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    7H19 BA 2
    goto BotFire4
   BotFire4:
    7H19 A 0 A_ReFire("BotFire4a")
    goto Ready2
   BotFire4a:
    7H19 A 0 A_JumpIfInventory("DuoBusterFlag", 1, 1)
    goto Fire2+1
    7H19 A 0
    goto FireA2+1

   AltFire:
   MissileSpam:
    7H19 D 0 A_GiveInventory("S_HeavyBomber_Alt_P1")
    7H19 D 0 A_ReFire(1)
    7H19 DE 2
    7H19 H 0 A_GiveInventory("S_HeavyBomber_Alt_P2")
    7H19 BH 2
    7H19 E 0 A_GiveInventory("S_HeavyBomber_Alt_P2")
    7H19 BE 2
    7H19 H 0 A_GiveInventory("S_HeavyBomber_Alt_P3")
    7H19 BH 2
    7H19 C 0 A_GiveInventory("S_HeavyBomber_Alt_P3")
    7H19 BC 2
    7H19 H 0 A_GiveInventory("S_HeavyBomber_Alt_P4")
    7H19 BH 2
    7H19 H 0 A_GiveInventory("S_HeavyBomber_Alt_P4")
    7H19 GA 2
    7H19 AAAA 4 A_GiveInventory("SafeEnergyAmmo", 4)
    7H19 A 0 A_TakeInventory("DisabledAirJumps", 1)
    7H19 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    goto Ready2
  }
}

actor S_HeavyBomber_Fire_P1 : HeavyBomber_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_HeavyBomberBullet", random(0, 2), 0, 8, 0)
    goto Pickup2
  }
}
actor S_HeavyBomber_Fire_P2 : HeavyBomber_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_HeavyBomberBullet", random(-2, 0), 0, -8, 0)
    goto Pickup2
  }
}

actor S_HeavyBomber_Alt_P1 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_DEMSpawnShot_H1", 0, 0, 0, 0)
    goto Start
  }
}
actor S_HeavyBomber_Alt_P2 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_DEMSpawnShot_H2", 0, 0, 0, 0)
    goto Ammo
  }
}
actor S_HeavyBomber_Alt_P3 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_DEMSpawnShot_H3", 0, 0, 0, 0)
    goto Ammo
  }
}
actor S_HeavyBomber_Alt_P4 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_DEMSpawnShot_H4", 0, 0, 0, 0)
    goto Ammo
  }
}


actor S_HeavyBomberBullet : HeavyBomberBullet {
  Translation "4:4=197:197", "192:192=199:199", "198:198=199:199"
  Damage (104)  // 69
}


actor S_DEMSpawnShot_H1 : BasicWatcher {
  Args 0, 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("S_DEMSpawnShot1", 0, 0, 0, 15, random(args[0], 0), random(-args[1], args[1] * 2))
    TNT1 A 0 A_SpawnItemEx("S_DEMSpawnShot1", 0, 0, 0, 15, random(0, -args[0]), random(-args[1], args[1] * 2))
    stop
  }
}
actor S_DEMSpawnShot_H2 : S_DEMSpawnShot_H1 {Args 16, 0}
actor S_DEMSpawnShot_H3 : S_DEMSpawnShot_H1 {Args 32, 8}
actor S_DEMSpawnShot_H4 : S_DEMSpawnShot_H1 {Args 64, 16}

actor S_DEMSpawnShot1 : DEMSpawnShot1 {
  Translation "192:192=86:86", "198:198=133:133"
  Damage (188)  // 125
  Args 38, 128, 16  // 25
}

actor S_DEMSpawnShot2 : DEMSpawnShot2 {
  Translation "192:192=86:86", "198:198=133:133"
  Damage (53)  // 35
  Args 68, 128, 16  // 45
}

actor S_DEMSpawnShot2Bot : DEMSpawnShot2Bot {
  Translation "192:192=86:86", "198:198=133:133"
  Damage (263)  // 175
  Args 188, 100, 16  // 125
}

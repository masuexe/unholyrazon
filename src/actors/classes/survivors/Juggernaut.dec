actor Juggernaut : CustWepClassBase
{
player.scoreIcon "UMUG_48"
player.displayname "Juggernaut"
player.soundclass "Juggernaut"
Player.Maxhealth 2000
health 2000
player.forwardmove 0.37, 0.37
player.sidemove 0.35, 0.35
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "Juggernaut_W"
player.startitem "IAmTheAmmoBitch", 100
States
{
Spawn:
PUNK A 0
PUNK B 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
SpawnFrame:
PUNK A 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
loop
See:
PUNK BBBBBCCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_CheckFooting"), "Air")
Goto Spawn
Air:
PUNK I 1 A_JumpIf(CallACS("core_CheckFooting"), "Spawn")
loop
Missile:
PUNK F 0 A_JumpIfInventory("VivifyDelay8",1,"PunkSpinThing")
Missile_1: PUNK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_1")
Missile_2: PUNK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_2")
Missile_3: PUNK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_3")
Missile_4: PUNK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_4")
Missile_5: PUNK F 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_5")
Missile_6: PUNK G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_6")
Missile_7: PUNK G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_7")
Missile_8: PUNK G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_8")
Missile_9: PUNK G 1 A_JumpIf(!CallACS("core_CheckFooting"), "Missile_Air_9")
goto SpawnFrame
Missile_Air_1: PUNK J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_2")
Missile_Air_2: PUNK J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_3")
Missile_Air_3: PUNK J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_4")
Missile_Air_4: PUNK J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_5")
Missile_Air_5: PUNK J 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_6")
Missile_Air_6: PUNK K 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_7")
Missile_Air_7: PUNK K 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_8")
Missile_Air_8: PUNK K 1 A_JumpIf(CallACS("core_CheckFooting"), "Missile_9")
Missile_Air_9: PUNK K 1 A_JumpIf(CallACS("core_CheckFooting"), "SpawnFrame")
goto Air
PunkSpinThing:
PUNK VWXYXYXYWWVV 2
Goto SpawnFrame
ClassPain: PUNK H 0
Goto MegamanPain

ClassDeath:
PUNK H 0
goto MegamanDeath
MegamanDeath0:
PUNK H 2 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PUNK H 0 A_TakeInventory("DecoyFlag2")
PUNK H 5 A_PlaySound("Pokemon/RageStart",1)
PUNK H 0 A_Jump(256,"ClassDeathLoop")
goto ClassDeathLoop
ClassDeathLoop:
PUNK H 0 A_GiveInventory("ClassDeathFlag",1)
PUNK H 1 A_SpawnItemEX("JuggernautTackleDeath",0,0,-48,momx,momy,momz,0,1+8)
PUNK H 0 A_ChangeVelocity(9,0,0,CVF_RELATIVE)
PUNK H 0 A_JumpIfInventory("ClassDeathFlag",25,"ClassDeathEnd")
PUNK H 0 A_JumpIfInventory("DecoyFlag2",1,"ClassDeathEnd")
loop
ClassDeathEnd:
PUNK H 0
Goto MegamanErase
MegamanDisintegrate:
PUNK Z 0 A_SpawnItemEx("Corpse_48",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor JuggernautShiny : Juggernaut
{
player.scoreIcon "UMUG_S48"
Player.Maxhealth 4000
health 4000
player.forwardmove 0.47, 0.47
player.sidemove 0.45, 0.45
player.jumpz 11
player.morphweapon "JuggernautShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
PUNK H 2 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PUNK H 0 A_TakeInventory("DecoyFlag2")
PUNK H 5 A_PlaySound("Pokemon/RageStart",1)
PUNK H 0 A_Jump(256,"ClassDeathLoop")
goto ClassDeathLoop
ClassDeathLoop:
PUNK H 0 A_GiveInventory("ClassDeathFlag",1)
PUNK H 1 A_SpawnItemEX("S_JuggernautTackleDeath",0,0,-48,momx,momy,momz,0,1+8)
PUNK H 0 A_ChangeVelocity(9,0,0,CVF_RELATIVE)
PUNK H 0 A_JumpIfInventory("ClassDeathFlag",25,"ClassDeathEnd")
PUNK H 0 A_JumpIfInventory("DecoyFlag2",1,"ClassDeathEnd")
loop
}
}


actor JuggernautTackleDeath
{
PROJECTILE
damagetype "JuggerRam"
Obituary "$OB_48D"
+DONTSPLASH
+DONTBLAST
+GHOST
+THRUGHOST
+DONTREFLECT
+NOTIMEFREEZE
damage (400)
radius 72
Height 168
scale 4.5
States
{
Spawn:
TNT1 A 1
stop
XDeath:
Crash:
TNT1 A 0
TNT1 A 0 A_PlaySound("weapon/pursuithit",1)
TNT1 A 1 A_GiveToTarget("DecoyFlag2",1)
X_8B ABCDEF 2
Stop
Death:
TNT1 A 0
Stop
}
}
actor S_JuggernautTackleDeath : JuggernautTackleDeath
{
damage (600)
}

actor Corpse_48:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_48_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_48_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_48_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 HH 0 A_SpawnItemEx("Corpse_48_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_48_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_48_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


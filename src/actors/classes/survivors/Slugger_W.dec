actor SluggerDropShot : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  PROJECTILE
  damagetype "Slugger"
  Obituary "$OB_21M7"
  Damage (random(40, 60))
  Radius 15
  Height 15
  Speed 15
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  -NOGRAVITY
  +NOEXPLODEFLOOR
  BounceFactor 1.0
  WallBounceFactor 1.0
  scale 2.5
  bouncecount 4
  // State jumps bypass the engine's missile death sound. Play it explicitly
  // in the shared Death state for both floor expiry and impact explosions.
  DeathSound ""
  States {
   Spawn:
    6R21 C 0
    6R21 CDEFEDEFED 1 A_CheckFloor("Bounce")
    loop
   Bounce:
    6R21 C 0 A_JumpIfInventory("CutterFlag", 3, "Death")
    6R21 EF 1
    6R21 C 0 A_JumpIfInventory("CutterFlag", 2, "Bounce2")
    6R21 C 0 A_JumpIfInventory("CutterFlag", 1, "Bounce1")
   Bounce0:
    6R21 E 1 ThrustThingZ(0, 80, 0, 0)
    6R21 E 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn
   Bounce1:
    6R21 E 1 ThrustThingZ(0, 65, 0, 0)
    6R21 E 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn
   Bounce2:
    6R21 E 1 ThrustThingZ(0, 46, 0, 0)
    6R21 E 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn
   Death:
    TNT1 A 0 A_PlaySound("wep_L/SluggerRBoom", 2)
    TNT1 A 1 A_SpawnItemEx("SluggerDropShotExplosion", 0, 0, 0, 0, 0, 32, 0, 1)
    stop
  }
}


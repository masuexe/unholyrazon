actor SluggerTargetTracer : BasicFastProjectile {
  +SKYEXPLODE
  +EXPLODEONWATER
  +DONTBLAST
  +BLOODLESSIMPACT
  +THRUGHOST
  +THRUACTORS
  +DONTREFLECT
  Damage (0)
  Radius 8
  Height 8
  Speed 1000
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    wait
   Crash:
   Death:
    TNT1 A 0
    // Keep the marker's own warning translation; the tracer has no dye.
    TNT1 A 0 A_SpawnItemEx("SluggerAirdropMarker", 0, 0, floorz - z + 1, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
    stop
  }
}

actor SluggerAirdropMarker : BasicExplosion {
  var int user_Height;
  Translation "192:192=107:107", "198:198=218:218"
  +FORCEXYBILLBOARD
  +DONTBLAST
  Radius 16
  Height 8
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    // TNT1 A 0 A_PlaySoundEx("misc/mmpuwarning", "Voice")
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "SoundSlot5")
    EVFL RST 4 Bright
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "SoundSlot5")
    EVFL RST 4 Bright
    EVFL R 0 A_PlaySoundEx("misc/BombCount", "SoundSlot5")
    EVFL RST 4 Bright
    goto DropCrate
   DropCrate:
    TNT1 A 0 A_PlaySoundEx("misc/catcherdrop", "Voice")
    // The crate is 32 units tall. Leave one extra unit below the ceiling,
    // including in low rooms, so its first movement cannot hit the ceiling.
    TNT1 A 0 A_SetUserVar("user_Height", ceilingz - z <= 33 ? 0 : (ceilingz - z >= 453 ? 420 : ceilingz - z - 33))
    goto DoDrop
   DoDrop:
    TNT1 A 0 A_SpawnItemEx("SluggerFallingCrate", 0, 0, user_Height, 0, 0, -35, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
    TNT1 A 1
    stop
  }
}

actor SluggerFallingCrate : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  // Kept off PowerProtectSurvivor so the airdrop hits survivor teammates.
  DamageType "SluggerAirdrop"
  Obituary "$OB_21A0"
  +SKYEXPLODE
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  +FORCEXYBILLBOARD
  -NOGRAVITY
  Damage (55)
  Radius 16
  Height 32
  Speed 0
  Scale 2.5
  States {
   Spawn:
    6P21 W 0
    6P21 W 0 A_PlaySound("wep_L/SluggerCrate", 1, 1.0)
   SpawnLoop:
    6P21 W 1 A_SpawnItemEx("SluggerLawnChairShotFX0", 0, 0, 16, 0, 0, 0, 0, 1 + 8)
    6P21 W 0 A_JumpIf(z <= floorz, "Death")
    loop
   Crash:
   Death:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(3, 15, 0, 4, 0)
    TNT1 A 0 A_PlaySound("wep_L/SluggerRBoom", 1)
    TNT1 A 0 A_PlaySound("wep_L/SluggerCrate", 2)
    TNT1 A 0 A_Explode(500, 160, 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("SluggerRocketShotFX0", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    TNT1 A 0 A_SpawnItemEx("SluggerLawnChairShotFX", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("SluggerCrateWeapon_P", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_TRANSFERTRANSLATION | SXF_NOCHECKPOSITION)
    TNT1 A 1
    stop
  }
}


actor SluggerCrateToss : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  DamageType "Slugger"
  Obituary "$OB_21A0"
  -NOGRAVITY
  +RIPPER
  +SKYEXPLODE
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS

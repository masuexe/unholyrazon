    6H21 Q 1 A_Lower
    Loop
   Select:
    6H21 Q 0 A_Raise
    6H21 Q 1 A_Raise
    Loop

   Ready:
    6H21 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 Q 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 Q 4 A_GiveInventory("Slugger_Ready_P")
    wait
   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop
   Fire:
    6H21 Q 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H21 R 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 S 0 A_GiveInventory("Slugger_Fire4_P")
    6H21 R 3
    6H21 S 2
    6H21 T 5
    6H21 U 3
    6H21 V 6
    6H21 QVQVQ 2
    6H21 QQQ 2 A_ReFire("Fire")
    Goto Ready1
   NoAmmo:
    6H21 Q 1 A_SelectWeapon("Slugger_W")
    Goto Ready1
   BotFire:
    6H21 Q 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 Q 0 A_GiveInventory("SluggerCrateAmmo", random(16, 25))

  Inventory.MaxAmount 1
}
actor SluggerAttackReset_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SluggerGunHold_F", 1)
    TNT1 A 0 A_TakeInventory("SluggerKnifeReady_F", 1)
    TNT1 A 0 A_TakeInventory("SluggerKnifeActive_F", 1)
    stop
  }
}
actor SluggerKnifeReady_F : Inventory {
  Inventory.MaxAmount 1
}
actor SluggerKnifeProbe_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SluggerKnifeProbe")
    stop
  }
}
// This animation marker survives M1 release until the knife has returned.
// Unlike KnifeReady, it must not be cleared by the per-tic input watcher.
actor SluggerKnifeActive_F : Inventory {
  Inventory.MaxAmount 1
}
actor SluggerKnifeBegin_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SluggerKnifeReady_F", 1)
    TNT1 A 0 A_GiveInventory("SluggerKnifeActive_F", 1)
    stop
  }
}
actor SluggerKnifeEnd_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SluggerKnifeActive_F", 1)
    stop
  }
}

actor SluggerKnifePuff : BulletPuff {
  +PUFFONACTORS
  +PUFFGETSOWNER
  DamageType "Slugger"
  Obituary "$OB_21Knife"
  States {
   Spawn:
    TNT1 A 0
    goto Crash
   Crash:
    TNT1 A 0 A_PlaySound("TheDentist/BladeBounce", 1)
    TNT1 A 1 A_SpawnItemEx("SluggerBulletHitFX", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    stop
   XDeath:
    TNT1 A 0 A_PlaySound("wep_L/mm7/slashclawhit", 1)
    TNT1 A 1 A_SpawnItemEx("SluggerBulletHitFX", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    stop
  }
}

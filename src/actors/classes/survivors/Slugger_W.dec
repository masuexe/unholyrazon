actor SluggerPistolShot : BasicFastProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  DamageType "Slugger"
  Obituary "$OB_21M0"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (random(55, 65))
  Radius 6
  Height 7
  Speed 120
  Scale 2.5
  States {
   Spawn:
    6P21 A 1
    6P21 B 1
    TNT1 A 1
    loop
   Death:

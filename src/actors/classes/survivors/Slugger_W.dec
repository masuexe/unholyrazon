actor SluggerShotgunStart : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  DamageType "SluggerShotgun"
  Obituary "$OB_21M3"
  +DONTBLAST
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  RenderStyle "None"
  Damage (0)
  Radius 10
  Height 10
  Mass 33  // Speed
  Speed 50  // 33
  Scale 2.5
  Args 300, 64, 20, 6  // Damage, size, bonus dam, duration
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0  // A_PlaySound("S_CD/Pound",4)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SyncPitchFix")

    TNT1 A 0 A_SpawnItemEx("SluggerShotgunCenter", 28, 0, 0, velx, vely, velz, 0, SXF_TRANSFERTRANSLATION | SXF_ABSOLUTEMOMENTUM | SXF_NOCHECKPOSITION | SXF_TRANSFERSPECIAL)  // 1+8+32+32768
   FX:
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -mass + sin(-pitch) * -args[1], 0, sin(-pitch) * -mass + cos(-pitch) * args[1], velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -mass + sin(-pitch) * args[1], 0, sin(-pitch) * -mass + cos(-pitch) * -args[1], velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -mass, args[1], sin(-pitch) * -mass, velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -mass, -args[1], sin(-pitch) * -mass, velx, vely, velz, 0, 1 + 8 + 32768)

    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * -args[1] * sin(45), args[1] * sin(45), cos(-pitch) * args[1] * sin(45), velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * -args[1] * sin(45), -args[1] * sin(45), cos(-pitch) * args[1] * sin(45), velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * args[1] * sin(45), args[1] * sin(45), cos(-pitch) * -args[1] * sin(45), velx, vely, velz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * args[1] * sin(45), -args[1] * sin(45), cos(-pitch) * -args[1] * sin(45), velx, vely, velz, 0, 1 + 8 + 32768)

    TNT1 A 0
    stop
   Death:
    TNT1 A 1
    stop
  }
}


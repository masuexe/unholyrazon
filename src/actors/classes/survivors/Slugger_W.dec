    loop
   Select:
    TNT1 A 0 A_GiveInventory("SluggerAttackReset_P")
    6J21 R 0 A_Raise
    6J21 R 1 A_Raise
    loop
   Ready:
    6J21 R 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6J21 R 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6J21 R 4 A_GiveInventory("Slugger_Ready_P")
    wait
   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop
   Fire:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire:
    6J21 R 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6J21 R 0 A_JumpIfNoAmmo("NoAmmo")
    6J21 ST 2 A_GiveInventory("SluggerTwoMachineGunsFire_P")
    6J21 WX 2 A_ReFire("Fire2")
    goto Ready1
   Fire1:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire1:
    6J21 R 0 A_JumpIfInventory("IsBot", 1, "BotFireH")
    6J21 R 0 A_JumpIfNoAmmo("NoAmmo")
    6J21 ST 2 A_GiveInventory("SluggerTwoMachineGunsSpreadFire_P")
    6J21 WX 2 A_ReFire("Fire2")
    goto Ready1
   Fire2:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire2:
    6J21 R 0 A_JumpIfNoAmmo("NoAmmo")
    6J21 UV 2 A_GiveInventory("SluggerTwoMachineGunsSpreadFire_P")
    6J21 RR 2 A_ReFire("Fire1")
    goto Ready1
   NoAmmo:
    6J21 R 1 A_SelectWeapon("SluggerPistol_W")
    goto Ready1
   BotFire:
    6J21 R 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6J21 R 0 A_GiveInventory("SluggerCrateAmmo", random(24, 32))
    goto GunFire+1
   BotFire1:
    6J21 R 0 A_Jump(128, "BotFire2")
    goto GunFire+1
   BotFire2:
    6J21 R 0 A_PlaySoundEx("classes/taunt/slugger", "Voice")
    6J21 R 0 A_GiveInventory("SluggerCrateWeapon2_P", 1)
    goto Altfire
   BotFireH:
    6J21 R 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFireH1")
    6J21 R 0 A_GiveInventory("SluggerCrateAmmo", random(3, 7))
    6J21 R 0 A_Jump(10, 1)
    goto GunFire1+1
    6J21 R 0 A_FaceTarget
    goto GunFire1+1
   BotFireH1:
    6J21 R 0 A_Jump(8, "BotFire2")
    goto GunFire1+1
   Knife:
    TNT1 A 0 A_GiveInventory("SluggerKnifeBegin_P")
    6K21 R 1
    6L21 A 1 Offset(-20, 50)
    6L21 A 1 Offset(-37, 8) A_PlaySound("CowboyKid/Knife", 1)
    goto KnifeSwing
   KnifeReturn:
    TNT1 A 0 A_GiveInventory("SluggerKnifeEnd_P")
    6K21 S 1
    6K21 R 1
    goto Ready1
   Altfire:
    6K21 T 0 A_GiveInventory("Slugger_Alt_P")
    6K21 RSTTSR 2
    goto Ready1
  }
}

actor SluggerZantetsuSword_W_ScriptBar : ScriptBar {}
actor SluggerZantetsuSword_W : SluggerPistol_W {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 10
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W4"
  Tag "$TAG_SluggerZantetsuSword_W"
  Weapon.AmmoType "SluggerZwordAmmo"
  Inventory.Icon "C_I_21E"
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    6H21 X 0 A_Lower
    6H21 X 1 A_Lower
    loop
   Select:
    6H21 X 0 A_Raise
    6H21 X 1 A_Raise
    loop

   Ready:
    6H21 X 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 X 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 X 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    6H21 X 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H21 Y 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 Z 0 A_PlaySound("Bat_Rob/Punch", 1)
    6H21 Y 0 A_FireCustomMissile("SluggerZwordShot", 0, 1, 0, 0)
    6H21 Y 2
    6H21 Z 7
    6H21 Y 5
    6H21 X 4
    6H21 X 0 A_ReFire("Fire")
    goto Ready1

   NoAmmo:
    6H21 X 1 A_SelectWeapon("SluggerPistol_W")
    goto Ready1

   BotFire:
    6H21 X 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 X 0 A_GiveInventory("SluggerCrateAmmo", random(16, 26))
    goto Fire+1
   BotFire1:
    6H21 X 0 A_Jump(32, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 X 0 A_PlaySoundEx("classes/taunt/slugger", "Voice")
    6H21 X 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Altfire:
    6I21 Z 0 A_GiveInventory("Slugger_Alt_P")
    6I21 XYZZYX 2
    goto Ready1
  }
}


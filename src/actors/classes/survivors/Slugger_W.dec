  Height 40
  Speed 20
  Scale 2.5
  States {
   Spawn:
    6P21 W 0
    // 6P21 W 0 A_PlaySound("wep_L/SluggerCrate", 1, 1.0)  // misc_L/catcherdrop 0.75
    6P21 W 0 ThrustThingZ(0, 28, 0, 1)
    6P21 W 0 ThrustThing(angle * 256 / 360, 4, 1, 0)
    6P21 W 1
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("SluggerCrateWeapon_P", 0, 0, 0, 0, 0, 0, 0, 1 + 32)

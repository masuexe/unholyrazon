actor SluggerShotgunProtect : PowerProtection {
  Powerup.Duration 2  // 1
  DamageFactor "SluggerShotgun", 0.0
}

actor SluggerShotgunStart : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  damagetype "SluggerShotgun"
  Obituary "$OB_21M3"
  +DONTBLAST
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  RenderStyle None
  Damage (0)
  Radius 10
  Height 10
  Mass 33  // Speed
  Speed 50  // 33
  Scale 2.5
  Args 300, 64, 20, 6  // Damage, size, bonus dam, duration
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0  // A_PlaySound("S_CD/Pound",4)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SyncPitchFix")

    TNT1 A 0 A_SpawnItemEx("SluggerShotgunCenter", 28, 0, 0, momx, momy, momz, 0, SXF_TRANSFERTRANSLATION | SXF_ABSOLUTEMOMENTUM | SXF_NOCHECKPOSITION | SXF_TRANSFERSPECIAL)  // 1+8+32+32768
   FX:
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -Mass+ sin(-pitch) * -Args[1], 0, sin(-pitch) * -Mass+ cos(-pitch) *Args[1], momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -Mass+ sin(-pitch) *Args[1], 0, sin(-pitch) * -Mass+ cos(-pitch) * -Args[1], momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -Mass, Args[1], sin(-pitch) * -Mass, momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", cos(-pitch) * -Mass, -Args[1], sin(-pitch) * -Mass, momx, momy, momz, 0, 1 + 8 + 32768)

    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * -Args[1] * sin(45), Args[1] * sin(45), cos(-pitch) *Args[1] * sin(45), momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) * -Args[1] * sin(45), -Args[1] * sin(45), cos(-pitch) *Args[1] * sin(45), momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) *Args[1] * sin(45), Args[1] * sin(45), cos(-pitch) * -Args[1] * sin(45), momx, momy, momz, 0, 1 + 8 + 32768)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", sin(-pitch) *Args[1] * sin(45), -Args[1] * sin(45), cos(-pitch) * -Args[1] * sin(45), momx, momy, momz, 0, 1 + 8 + 32768)

    TNT1 A 0
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor SluggerShotgunStart_Spread : SluggerShotgunStart {
  Args 900, 56, 60, 6
}

actor SluggerShotgunCenter : SluggerShotgunStart {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(Args[0]+Args[3] *Args[2], Args[1], 0, 0, Args[1])
    TNT1 A 0 A_CountDownArg(3)
    TNT1 A 0 A_SpawnItemEx("SluggerShotgunCenter", 28, 0, 0, momx, momy, momz, 0, 1 + 8 + 32 + 32768)
   FX:
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_CenterFX", 28, 0, 0, momx* 0.1, momy* 0.1, momz* 0.1, 0, 1 + 8 + 32768)
    TNT1 A 0 //A_SpawnItemEx("Slugger_SG_CenterFX",sqrt(momx*momx+momy*momy)*0.5,0,momz*0.5,0,0,0,0,1)
    TNT1 A 0
    stop
  }
}

actor Slugger_SG_CenterFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_BitFX", frandom(24, 32) * (random(0, 1) * 2 - 1), frandom(24, 32) * (random(0, 1) * 2 - 1), frandom(24, 32) * (random(0, 1) * 2 - 1), 0, 0, 1, 0, 1, 32)
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, random(0, 5) -Args[3] * 2)
    TNT1 A 0 A_SetScale((ScaleX-Args[4] * 0.1) * (random(0, 1) * 2 - 1), ScaleY-Args[4] * 0.1)
    //TNT1 A 0 A_SetScale(ScaleX*(random(0,1)*2-1),ScaleY)
    //TNT1 A 0 A_JumpIf(Args[3]<3,5)
    // TNT1 A 0 A_Jump(256,1,5)
   S2:
    6P21 RSTU random(2, 3)
    stop
   S1:
    6P21 NOPQ random(2, 3)
    stop
  }
}

actor Slugger_SG_OuterFX : Slugger_SG_CenterFX {
  ReactionTime 4
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_CountDownArg(3)
    TNT1 A 0 A_SpawnItemEx("Slugger_SG_OuterFX", 0, 0, 0, momx, momy, momz, 0, 1 + 8 + 32 + 32768)
    TNT1 AAAA 0 A_SpawnItemEx("Slugger_SG_BitFX", frandom(-16, 16), frandom(-24, 24), frandom(-24, 24), momx* 0.25, momy* 0.25, momz* 0.25 + frandom(1, 3), 0, 1 + 8, 64)
    TNT1 A 0 A_ScaleVelocity(0.125)  // A_Stop
    TNT1 A 0 A_ChangeVelocity(frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
    TNT1 A 0 A_SetScale(ScaleX* (random(0, 1) * 2 - 1), ScaleY)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
   SpawnL:
    6Q21 MNOP 2 A_CountDown
    loop
  }
}

actor Slugger_SG_BitFX : Slugger_SG_CenterFX {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, random(0, 10))
    TNT1 A 0 A_SetScale((ScaleX-Args[4] * 0.1) * (random(0, 1) * 2 - 1), ScaleY-Args[4] * 0.1)
   S1:
    6Q21 A 0 A_Jump(256, 1, 2, 3, 4)
    6Q21 A random(2, 3)
    goto S2
    6Q21 B random(2, 3)
    goto S2
    6Q21 C random(2, 3)
    goto S2
    6Q21 D random(2, 3)
    goto S2
   S2:
    6Q21 E 0 A_Jump(256, 1, 2, 3, 4)
    6Q21 E random(2, 3)
    goto S3
    6Q21 F random(2, 3)
    goto S3
    6Q21 G random(2, 3)
    goto S3
    6Q21 H random(2, 3)
    goto S3
   S3:
    6Q21 I 0 A_Jump(256, 1, 2, 3, 4)
    6Q21 I random(2, 3)
    stop
    6Q21 J random(2, 3)
    stop
    6Q21 K random(2, 3)
    stop
    6Q21 L random(2, 3)
    stop
  }
}


actor SluggerZwordShot : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  damagetype "Slugger"
  Obituary "$OB_21M4"
  -SOLID
  -MISSILE
  // +THRUACTORS
  +THRUGHOST
  +DONTREFLECT
  +RIPPER
  +DONTBLAST
  +BRIGHT
  +THRUSPECIES
  species "DumbSluggerZword"
  RenderStyle Translucent
  Alpha 0.6
  damage (0)
  Radius 2
  Height 2
  speed 1
  scale 3.0
  Args 145, 175, 64
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("SluggerZwordBlocker")
    TNT1 A 0 A_ChangeFlag("MISSILE", 1)
    TNT1 A 0 A_ScaleVelocity(44)
    TNT1 A 0 A_GiveInventory("ReSyncPickup")
    TNT1 AA 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH CD 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH D 0 A_FadeIn(0.1)
    X_AH DD 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH D 0 A_FadeIn(0.1)
    X_AH DC 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH C 0 A_FadeIn(0.1)
    X_AH CC 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH C 0 A_FadeIn(0.1)

   SpawnL:
    X_AH CCCDDDCCCDDDCCCDDDCCCDDDCCCDDDCCCDDDCCCDDD 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    // loop
   Death:
    X_AH C 0 A_FadeOut(0.1)
    X_AH C 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    X_AH D 0 A_FadeOut(0.1)
    X_AH D 1 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[2])
    loop
  }
}

actor SluggerZwordBlocker : BasicShieldHitbox {
  +INVULNERABLE
  +NORADIUSDMG
  species "DumbSluggerZword"
  painchance 0
  Radius 24
  Height 64
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Warp(2, 0, 0, 0, 0, 24)
    TNT1 A 0 A_CheckFlag("NOGRAVITY", "Spawn", 2)
    stop
  }
}

// TODO: add melee weapon when close to enemy

actor SluggerBar : NormalBar {args 214, 248}
actor Slugger_W_SecondBar : SecondBar {args 107, 218}
actor Slugger_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 3
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W0"
  Tag "$TAG_Slugger_W"
  weapon.ammotype "SluggerCrateAmmo"
  weapon.ammotype2 "SluggerCrateAmmo"
  inventory.icon "C_I_21A"
  -WEAPON.DONTBOB
  weapon.bobstyle "Smooth"
  Weapon.BobSpeed 1.5
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    6H21 A 0 A_Lower
    6H21 A 1 A_Lower
    Loop
   Select:
    6H21 A 0 A_Raise
    6H21 A 1 A_Raise
    Loop

   Ready:
    6H21 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 A 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 A 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    6H21 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")  // A4 B6 C4
    6H21 B 4 OffSet(0, 32) A_GiveInventory("Slugger_Fire1_P")
    6H21 C 4 OffSet(0, 32)
    6H21 A 3 OffSet(0, 20)
    6H21 A 2 OffSet(0, 20) A_ReFire("Fire")
    6H21 A 2 OffSet(0, 24) A_ReFire("Fire")
    6H21 A 2 OffSet(0, 28) A_ReFire("Fire")
    Goto Ready1

   BotFire:
    6H21 A 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 A 0 A_GiveInventory("SluggerCrateAmmo", random(8, 16))
    goto Fire+1
   BotFire1:
    6H21 A 0 A_Jump(196, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 A 0 A_PlaySoundEx("taunt/D_21", "Voice")
    6H21 A 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Altfire:
    6I21 C 0 A_GiveInventory("Slugger_Alt_P")
    6I21 ABCCBA 2
    Goto Ready1
  }
}

actor Slugger_W1_NormalBar : SluggerBar {}
actor Slugger_W1_SecondBar : Slugger_W_SecondBar {}
actor Slugger_W1 : Slugger_W {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W1"
  Tag "$TAG_Slugger_W1"
  weapon.ammotype "SluggerMachineGunAmmo"
  inventory.icon "C_I_21B"
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    6H21 D 0 A_Lower
    6H21 D 1 A_Lower
    Loop
   Select:
    6H21 D 0 A_Raise
    6H21 D 1 A_Raise
    Loop

   Ready:
    6H21 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 D 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 D 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    6H21 D 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 EF 2 A_GiveInventory("Slugger_Fire2A_P")
    6H21 IJ 2 A_ReFire("Fire2")
    Goto Ready1
   Fire1:
    6H21 D 0 A_JumpIfInventory("IsBot", 1, "BotFireH")
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 EF 2 A_GiveInventory("Slugger_Fire2B_P")
    6H21 IJ 2 A_ReFire("Fire2")
    Goto Ready1
   Fire2:
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 GH 2 A_GiveInventory("Slugger_Fire2B_P")
    6H21 DD 2 A_ReFire("Fire1")
    Goto Ready1

   NoAmmo:
    6H21 D 1 A_SelectWeapon("Slugger_W")
    Goto Ready1

   BotFire:
    6H21 D 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 D 0 A_GiveInventory("SluggerCrateAmmo", random(24, 32))
    goto Fire+1
   BotFire1:
    6H21 D 0 A_Jump(128, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 D 0 A_PlaySoundEx("taunt/D_21", "Voice")
    6H21 D 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire
   BotFireH:
    6H21 D 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFireH1")
    6H21 D 0 A_GiveInventory("SluggerCrateAmmo", random(3, 7))
    6H21 D 0 A_Jump(10, 1)
    goto Fire1+1
    6H21 D 0 A_FaceTarget
    goto Fire1+1
   BotFireH1:
    6H21 D 0 A_Jump(8, "BotFire2")
    goto Fire1+1

   Altfire:
    6I21 F 0 A_GiveInventory("Slugger_Alt_P")
    6I21 DEFFED 2
    Goto Ready1
  }
}

actor Slugger_W2_NormalBar : SluggerBar {}
actor Slugger_W2_SecondBar : Slugger_W_SecondBar {}
actor Slugger_W2 : Slugger_W {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 30
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W2"
  Tag "$TAG_Slugger_W2"
  weapon.ammotype "SluggerLawnchairAmmo"
  inventory.icon "C_I_21C"
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    6H21 K 0 A_Lower
    6H21 K 1 A_Lower
    Loop
   Select:
    6H21 K 0 A_Raise
    6H21 K 1 A_Raise
    Loop

   Ready:
    6H21 K 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 K 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 K 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    6H21 K 0 A_JumpIfInventory("IsBot", 1, "BotFire")  // KNOPL 4
    6H21 N 2 A_JumpIfNoAmmo("NoAmmo")
    6H21 O 2 A_GiveInventory("Slugger_Fire3_P")
    6H21 P 2
    6H21 M 6
    6H21 L 2
    6H21 K 2
    6H21 L 0 A_ReFire("Fire")
    Goto Ready1

   NoAmmo:
    6H21 K 1 A_SelectWeapon("Slugger_W")
    Goto Ready1

   BotFire:
    6H21 K 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 K 0 A_GiveInventory("SluggerCrateAmmo", random(6, 12))
    goto Fire+1
   BotFire1:
    6H21 K 0 A_Jump(32, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 K 0 A_PlaySoundEx("taunt/D_21", "Voice")
    6H21 K 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Altfire:
    6I21 M 0 A_GiveInventory("Slugger_Alt_P")
    6I21 KLMMLK 2
    Goto Ready1
  }
}


// Close-range primary attacks automatically use Kate's knife animation.

actor SluggerPistol_W_ScriptBar : ScriptBar {}
actor SluggerPistol_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 3
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W0"
  Tag "$TAG_SluggerPistol_W"
  Weapon.AmmoType "SluggerCrateAmmo"
  Weapon.AmmoType2 "SluggerCrateAmmo"
  Inventory.Icon "C_I_21A"
  -WEAPON.DONTBOB
  weapon.bobstyle "Smooth"
  Weapon.BobSpeed 1.5
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    TNT1 A 0 A_GiveInventory("SluggerAttackReset_P")
    6H21 A 0 A_Lower
    6H21 A 1 A_Lower
    loop
   Select:
    TNT1 A 0 A_GiveInventory("SluggerAttackReset_P")
    6H21 A 0 A_Raise
    6H21 A 1 A_Raise
    loop

   Ready:
    6H21 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 A 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 A 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire:
    6H21 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")  // A4 B6 C4
    6H21 B 4 Offset(0, 32) A_GiveInventory("Slugger_Fire1_P")
    6H21 C 4 Offset(0, 32)
    6H21 A 3 Offset(0, 20)
    6H21 A 2 Offset(0, 20) A_ReFire("Fire")
    6H21 A 2 Offset(0, 24) A_ReFire("Fire")
    6H21 A 2 Offset(0, 28) A_ReFire("Fire")
    goto Ready1

   BotFire:
    6H21 A 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 A 0 A_GiveInventory("SluggerCrateAmmo", random(8, 16))
    goto GunFire+1
   BotFire1:
    6H21 A 0 A_Jump(196, "BotFire2")
    goto GunFire+1
   BotFire2:
    6H21 A 0 A_PlaySoundEx("classes/taunt/slugger", "Voice")
    6H21 A 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Knife:
    TNT1 A 0 A_GiveInventory("SluggerKnifeBegin_P")
    6I21 A 1
    6L21 A 1 Offset(-20, 50)
    6L21 A 1 Offset(-37, 8) A_PlaySound("wep/KateStab", 1)
    goto KnifeSwing

    // Inherited blade motion. String jump labels resolve on the current
    // weapon, so every child returns through its own KnifeReturn frames.
   KnifeSwing:
    6L21 B 2 Offset(-70, 29)
    6L21 B 3 Offset(-107, 50) ACS_NamedExecuteWithResult("uh_SluggerKnifeHit")
    6L21 B 1 Offset(-80, 55)
    6L21 A 1 Offset(-30, 75)
    6L21 A 1 Offset(-20, 120)
    TNT1 A 0 A_WeaponReady(14)
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeActive_F", 1, "KnifeReturn")
    goto KnifeReturn

   KnifeReturn:
    TNT1 A 0 A_GiveInventory("SluggerKnifeEnd_P")
    6I21 B 1
    6I21 A 1
    // Resume idle without replaying core_weaponcolor's ready sound.
    goto Ready1

   Altfire:
    6I21 C 0 A_GiveInventory("Slugger_Alt_P")
    6I21 ABCCBA 2
    goto Ready1
  }
}

actor SluggerHeavyMachineGun_W_ScriptBar : ScriptBar {}
actor SluggerHeavyMachineGun_W : SluggerPistol_W {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W1"
  Tag "$TAG_SluggerHeavyMachineGun_W"
  Weapon.AmmoType "SluggerMachineGunAmmo"
  Inventory.Icon "C_I_21B"
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    TNT1 A 0 A_GiveInventory("SluggerAttackReset_P")
    6H21 D 0 A_Lower
    6H21 D 1 A_Lower
    loop
   Select:
    TNT1 A 0 A_GiveInventory("SluggerAttackReset_P")
    6H21 D 0 A_Raise
    6H21 D 1 A_Raise
    loop

   Ready:
    6H21 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 D 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 D 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire:
    6H21 D 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 EF 2 A_GiveInventory("Slugger_Fire2A_P")
    6H21 IJ 2 A_ReFire("Fire2")
    goto Ready1
   Fire1:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire1:
    6H21 D 0 A_JumpIfInventory("IsBot", 1, "BotFireH")
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 EF 2 A_GiveInventory("Slugger_Fire2B_P")
    6H21 IJ 2 A_ReFire("Fire2")
    goto Ready1
   Fire2:
    TNT1 A 0 A_GiveInventory("SluggerKnifeProbe_P")
    TNT1 A 0 A_JumpIfInventory("SluggerKnifeReady_F", 1, "Knife")
   GunFire2:
    6H21 D 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 GH 2 A_GiveInventory("Slugger_Fire2B_P")
    6H21 DD 2 A_ReFire("Fire1")
    goto Ready1

   NoAmmo:
    6H21 D 1 A_SelectWeapon("SluggerPistol_W")
    goto Ready1

   BotFire:
    6H21 D 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 D 0 A_GiveInventory("SluggerCrateAmmo", random(24, 32))
    goto GunFire+1
   BotFire1:
    6H21 D 0 A_Jump(128, "BotFire2")
    goto GunFire+1
   BotFire2:
    6H21 D 0 A_PlaySoundEx("classes/taunt/slugger", "Voice")
    6H21 D 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire
   BotFireH:
    6H21 D 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFireH1")
    6H21 D 0 A_GiveInventory("SluggerCrateAmmo", random(3, 7))
    6H21 D 0 A_Jump(10, 1)
    goto GunFire1+1
    6H21 D 0 A_FaceTarget
    goto GunFire1+1
   BotFireH1:
    6H21 D 0 A_Jump(8, "BotFire2")
    goto GunFire1+1

   Knife:
    TNT1 A 0 A_GiveInventory("SluggerKnifeBegin_P")
    6I21 D 1
    6L21 A 1 Offset(-20, 50)
    6L21 A 1 Offset(-37, 8) A_PlaySound("CowboyKid/Knife", 1)
    goto KnifeSwing

   KnifeReturn:
    TNT1 A 0 A_GiveInventory("SluggerKnifeEnd_P")
    6I21 E 1
    6I21 D 1
    // Resume idle without replaying core_weaponcolor's ready sound.
    goto Ready1

   Altfire:
    6I21 F 0 A_GiveInventory("Slugger_Alt_P")
    6I21 DEFFED 2
    goto Ready1
  }
}


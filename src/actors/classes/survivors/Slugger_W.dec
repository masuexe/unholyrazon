actor SluggerCrateToss : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  damagetype "Slugger"
  Obituary "$OB_21A0"
  -NOGRAVITY
  +RIPPER
  +SKYEXPLODE
  +THRUGHOST
  +DONTBLAST
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  // +BOUNCEAUTOOFF
  +BOUNCEAUTOOFFFLOORONLY
  bouncecount 6
  bouncefactor 0.4
  wallbouncefactor 0.75
  gravity 1.25  // 1.8
  Damage (55)
  Radius 16
  Height 40
  Speed 20
  scale 2.5
  States {
   Spawn:
    6P21 W 0
    6P21 W 0 A_PlaySound("wep_L/SluggerCrate", 1, 1.0)//misc_L/catcherdrop 0.75
    6P21 W 0 ThrustThingZ(0, 28, 0, 1)
    6P21 W 0 ThrustThing(angle * 256 / 360, 4, 1, 0)
    6P21 W 1
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("SluggerCrateWeapon_P", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    stop
  }
}
actor SluggerCrateToss_Spread : SluggerCrateToss {
  Damage (55)
}

actor SluggerCrateIconFX0 : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
   S0:
    6N21 A 0
    goto S_L
   S1:
    6N21 B 0
    goto S_L
   S2:
    6N21 C 0
    goto S_L
   S3:
    6N21 D 0
    goto S_L
   S4:
    6N21 E 0
    goto S_L
   S5:
    6N21 F 0
    goto S_L
   S_L:
    TNT1 "#" 1 A_Warp(2, 0, 0, 56 +Args[1], 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)  // 8+16
    TNT1 "#" 0 A_SetArg(1, Args[1] + 2)
    6N21 "#" 1 A_Warp(2, 0, 0, 56 +Args[1], 0, 8 + 16)
    6N21 "#" 0 A_SetArg(1, Args[1] + 2)
    6N21 "#" 0 A_FadeOut(0.1)
    loop
  }
}
actor SluggerCrateIconFX1 : SluggerCrateIconFX0 {States {Spawn: goto S1}}
actor SluggerCrateIconFX2 : SluggerCrateIconFX0 {States {Spawn: goto S2}}
actor SluggerCrateIconFX3 : SluggerCrateIconFX0 {States {Spawn: goto S3}}
actor SluggerCrateIconFX4 : SluggerCrateIconFX0 {States {Spawn: goto S4}}
actor SluggerCrateIconFX5 : SluggerCrateIconFX0 {States {Spawn: goto S5}}
actor SluggerPistolShot : BasicFastProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  damagetype "Slugger"
  Obituary "$OB_21M0"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (random(55, 65))
  Radius 6
  Height 7
  Speed 120
  Scale 2.5
  States {
   Spawn:
    6P21 A 1
    6P21 B 1
    TNT1 A 1
    loop
   Death:
    TNT1 A 1 A_SpawnItemEx("SluggerBulletHitFX", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    stop
  }
}

actor SluggerBulletHitFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    6P19 B 0
    6P19 BCD random(1, 2)
    stop
  }
}


actor SluggerMachineGunShot : SluggerPistolShot {
  Obituary "$OB_21M1"
  Damage (random(64, 76))
  Radius 8
  Height 9
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8)
   Spawn2:
    6P21 DEFG 1
    loop
   Spawn3:
    6P21 GFED 1
    loop
  }
}

actor SluggerLawnChairShot : BasicProjectile {
  Translation "192:192=107:107", "198:198=218:218"
  DeathSound "wep_L/SluggerRBoom"  // S_1/Explode
  damagetype "Slugger"
  Obituary "$OB_21A5"
  Damage (random(40, 60))
  Radius 15
  Height 14
  Speed 55
  scale 2.5
  Args 224, 250, 128, 16
  states {
   Spawn:
    6P21 L 1 A_SpawnItemEx("SluggerLawnChairShotFX0", 0, 0, momz* -0.5, 0, 0, 0, 0, 1 + 8)
    loop
   Death:
    TNT1 A 0 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[3])
    TNT1 A 4 A_SpawnItemEx("SluggerLawnChairShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor SluggerRocketShot : SluggerLawnChairShot {
  Obituary "$OB_21M2"
  // +RANDOMIZE
  Radius 12
  Height 9
  Speed 40
  states {
   Spawn:
    6P21 KJJJJKKK 1 A_SpawnItemEx("SluggerLawnChairShotFX0", 0, 0, momz* -0.5 + 1, 0, 0, 0, 0, 1 + 8)
    loop
   Death:
    TNT1 A 0 A_Explode(random(Args[0], Args[1]), Args[2], 0, 0, Args[3])
    TNT1 A 0 A_SpawnItemEx("SluggerRocketShotFX0", 0, 0, 0, 0, 0, 0, 0, 1 + 32)
    TNT1 A 4 A_SpawnItemEx("SluggerLawnChairShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor SluggerRocketShotFX0 : BasicClientSide {
  RenderStyle None
  ReactionTime 4
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(2, (z - floorz <= 16) * 2)
    TNT1 A 0 A_SetArg(3, (ceilingz - z <= 16 + 8) * -2)
    TNT1 A 0 A_SetArg(1, Args[2]+Args[3])
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7)
   SpawnL:  // Technically accurate spawn distance
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(2, 4) * 8, random(2, 4) * 8, random(-2 +Args[1], 2+Args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(-2, -4) * 8, random(2, 4) * 8, random(-2 +Args[1], 2+Args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(-2, -4) * 8, random(-2, -4) * 8, random(-2 +Args[1], 2+Args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(2, 4) * 8, random(-2, -4) * 8, random(-2 +Args[1], 2+Args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    goto SpawnL
  }
}


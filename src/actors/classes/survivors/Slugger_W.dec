    stop
  }
}

// On landing, roll once in the server database and spawn the visible reward.
actor SluggerCrateWeapon_P : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_SluggerCrateDrop")
    stop
  }
}

actor SluggerCratePickup : CustomInventory {
  Inventory.PickupMessage "$PU_CItem_SluggerCrate0"
  +DONTGIB
  +FORCEXYBILLBOARD
  Radius 16
  Height 40
  Scale 2.0
  Args 11
  States {
   Spawn:
    6N21 A 0
   SpawnLoop:
    6N21 "#" 1 Bright A_CountDownArg(0)
    6N21 "#" 34 Bright
    6N21 "#" 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Fade")
    goto SpawnLoop
   Fade:
   Death:
    6N21 "#" 1 Bright A_FadeOut(0.2)
    wait
   Pickup:
   Reject:
    TNT1 A 0
    fail
  }
}


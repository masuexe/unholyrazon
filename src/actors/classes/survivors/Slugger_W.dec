actor SluggerRocketShotFX0 : BasicClientSide {
  RenderStyle "None"
  ReactionTime 4
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(2, (z - floorz <= 16) * 2)
    TNT1 A 0 A_SetArg(3, (ceilingz - z <= 16 + 8) * -2)
    TNT1 A 0 A_SetArg(1, args[2] + args[3])
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7)
   SpawnL:  // Technically accurate spawn distance
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(2, 4) * 8, random(2, 4) * 8, random(-2 + args[1], 2 + args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(-2, -4) * 8, random(2, 4) * 8, random(-2 + args[1], 2 + args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(-2, -4) * 8, random(-2, -4) * 8, random(-2 + args[1], 2 + args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    TNT1 A 1 A_SpawnItemEx("SluggerRocketShotFX", random(2, 4) * 8, random(-2, -4) * 8, random(-2 + args[1], 2 + args[1]) * 8, 0, 0, 0, 0, 1 + 32, 32)
    TNT1 A 0 A_CountDown
    goto SpawnL
  }
}


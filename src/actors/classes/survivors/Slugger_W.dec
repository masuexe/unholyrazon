   BotFire1:
    6H21 Q 0 A_Jump(64, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 Q 0 A_PlaySoundEx("taunt/D_21", "Voice")
    6H21 Q 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Altfire:
    6I21 S 0 A_GiveInventory("Slugger_Alt_P")
    6I21 QRSSRQ 2
    Goto Ready1
  }
}

actor Slugger_W4_NormalBar : SluggerBar {}
actor Slugger_W4_SecondBar : Slugger_W_SecondBar {}

actor Slugger_W4 : Slugger_W {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 10
  Inventory.Pickupmessage "$PU_21"
  Obituary "$OB_21W4"
  Tag "$TAG_Slugger_W4"
  weapon.ammotype "SluggerZwordAmmo"
  inventory.icon "C_I_21E"
  States {
   Spawn:
    6H21 [ 6
    loop

   Deselect:
    6H21 X 0 A_Lower
    6H21 X 1 A_Lower
    Loop
   Select:
    6H21 X 0 A_Raise
    6H21 X 1 A_Raise
    Loop

   Ready:
    6H21 X 0 ACS_NamedExecuteWithResult("core_weaponcolor", SLUGGER_DYE)
    6H21 X 0 A_GunFlash("Flash", 1)
    goto Ready1
   Ready1:
    6H21 X 4 A_GiveInventory("Slugger_Ready_P")
    wait

   Flash:
    TNT1 A 2
    TNT1 A 2 A_GiveInventory("SluggerCrateAmmo", 1)
    loop

   Fire:
    6H21 X 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H21 Y 0 A_JumpIfNoAmmo("NoAmmo")
    6H21 Z 0 A_PlaySound("Bat_Rob/Punch", 1)
    6H21 Y 0 A_FireCustomMissile("SluggerZwordShot", 0, 1, 0, 0)
    6H21 Y 2
    6H21 Z 7
    6H21 Y 5
    6H21 X 4
    6H21 X 0 A_Refire("Fire")
    Goto Ready1

   NoAmmo:
    6H21 X 1 A_SelectWeapon("Slugger_W")
    Goto Ready1

   BotFire:
    6H21 X 0 A_JumpIfInventory("SluggerCrateAmmo", 0, "BotFire1")
    6H21 X 0 A_GiveInventory("SluggerCrateAmmo", random(16, 26))
    goto Fire+1
   BotFire1:
    6H21 X 0 A_Jump(32, "BotFire2")
    goto Fire+1
   BotFire2:
    6H21 X 0 A_PlaySoundEx("taunt/D_21", "Voice")
    6H21 X 0 A_GiveInventory("SluggerCrateWeapon2_P")
    goto Altfire

   Altfire:
    6I21 Z 0 A_GiveInventory("Slugger_Alt_P")
    6I21 XYZZYX 2
    Goto Ready1
  }
}

actor SluggerCrateAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 200
  +INVENTORY.IGNORESKILL
}

actor SluggerMachineGunAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 100
  +INVENTORY.IGNORESKILL
}
actor SluggerLawnchairAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 30
  +INVENTORY.IGNORESKILL
}
actor SluggerShotgunAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 20
  +INVENTORY.IGNORESKILL
}
actor SluggerZwordAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 10
  +INVENTORY.IGNORESKILL
}


actor Slugger_Ready_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("SluggerCrateAmmo", 0, 2)
    TNT1 A 0 A_WeaponReady(8)
    goto Ammo
    TNT1 A 0 A_WeaponReady
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("SluggerCrateAmmo", 1)
    stop
  }
}


actor Slugger_Fire1_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep_L/SluggerPistol", 1, 1.0)//BBA_Snd/shot_x 0.9
    TNT1 A 0 A_FireCustomMissile("SluggerPistolShot", 0, 0, 0, 0)
    stop
  }
}

actor Slugger_Fire2A_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("SluggerMachineGunShot", 0, 1, 0, 0)
   Pew:
    TNT1 A 0 A_PlaySound("Caliber/Pew", 1)
    stop
  }
}
actor Slugger_Fire2B_P : Slugger_Fire2A_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("SluggerMachineGunShot", frandom(-4, 4), 1, 0, 0, 1, frandom(-1, 1))
    goto Pew
  }
}

actor Slugger_Fire3_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("wep_L/SluggerRocket", 1, 1.0)
    TNT1 A 0 A_FireCustomMissile("SluggerRocketShot", 0, 1, 0, 0)
    stop
  }
}

actor Slugger_Fire4_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SluggerShotgunAmmo", 1, 1)
    TNT1 A 0 A_PlaySound("wep_L/SluggerShotgun", 1)  // BBA_Snd/ssg_x
    //TNT1 A 0 A_FireCustomMissile("SluggerShotgunStart",0,1,0,0)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("SluggerShotgunStart", 0, 0, 32, cos(-pitch), 0, sin(-pitch), 0, 32 + 512 + 8192)  // SXF_TRANSFERPITCH+SXF_MULTIPLYSPEED
    stop  // Seperate spread version for increasing size
    TNT1 A 0 A_SpawnItemEx("SluggerShotgunStart_Spread", 0, 0, 32, cos(-pitch), 0, sin(-pitch), 0, 32 + 512 + 8192)
    stop
  }
}

actor Slugger_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SluggerCrateAmmo", 100, 1)
    TNT1 A 0 A_TakeInventory("SluggerCrateAmmo", 100)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    TNT1 A 0 A_SpawnItemEx("SluggerCrateToss", 0, 0, 16, cos(-pitch), 0, sin(-pitch), 0, 32 + 8192)
    stop
    TNT1 A 0 A_SpawnItemEx("SluggerCrateToss_Spread", 0, 0, 16, cos(-pitch), 0, sin(-pitch), 0, 32 + 8192)
    stop
  }
}

actor SluggerCrateWeapon_P : CustomInventory {
  inventory.pickupmessage "$PU_CItem_SluggerCrate0"
  +DONTGIB
  //Radius 16
  Height 40
  scale 2.5
  Args 11
  States {
   Spawn:
    6P21 X 0 bright
    6P21 X 1 bright A_CountDownArg(0)
    6P21 W 34
    6P21 W 0 A_JumpIf(!CallACS("uh_PointerExists", 2), 1)
    loop
    6P21 WXWX 1 A_FadeOut(0.2)
    stop
   Death:
    6P21 W 0 //A_GiveToTarget("SluggerCrateAmmo",96)
    6P21 W 1 A_FadeOut(0.05)
    wait
   Pickup:
    TNT1 A 0 A_JumpIfInventory("Slugger_W", 1, "Give")
    fail
   Give:
    TNT1 A 0 A_SelectWeapon("Slugger_W")
    TNT1 A 0 A_SpawnItemEx("SluggerCrateWeapon_H")
    stop
  }
}
actor SluggerCrateWeapon_H : BasicWatcher {
  +NOTIMEFREEZE
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("Slugger_W1", 1)
    TNT1 A 0 A_TakeFromTarget("Slugger_W2", 1)
    TNT1 A 0 A_TakeFromTarget("Slugger_W3", 1)
    TNT1 A 0 A_TakeFromTarget("Slugger_W4", 1)
    // TNT1 A 0 A_PlaySound("wep_L/SluggerWepGet",4)
    TNT1 A 0 A_TakeFromTarget("SluggerCrateWeapon2_P", 1)
    TNT1 A 1 A_GiveToTarget("SluggerCrateWeapon2_P", 1)
    stop
  }
}


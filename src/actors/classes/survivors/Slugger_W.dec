actor SluggerCrateIconFX0 : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
   S0:
    6N21 A 0
    goto S_L
   S1:
    6N21 B 0
    goto S_L
   S2:
    6N21 C 0
    goto S_L
   S3:
    6N21 D 0
    goto S_L
   S4:
    6N21 E 0
    goto S_L
   S5:
    6N21 F 0
    goto S_L
   S6:
    6N21 M 0
    goto S_L
   S7:
    6N21 N 0
    goto S_L
   S8:
    6N21 O 0
    goto S_L
   S_L:
    TNT1 "#" 1 A_Warp(2, 0, 0, 56 + args[1], 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)  // 8+16
    TNT1 "#" 0 A_SetArg(1, args[1] + 2)
    6N21 "#" 1 A_Warp(2, 0, 0, 56 + args[1], 0, 8 + 16)
    6N21 "#" 0 A_SetArg(1, args[1] + 2)
    6N21 "#" 0 A_FadeOut(0.1)
    loop
  }
}

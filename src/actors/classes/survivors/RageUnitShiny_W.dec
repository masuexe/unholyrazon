actor S_RageUnit_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep_L/RageUnitAlt",4)
TNT1 A 0 A_SpawnItemEx("S_RageUnitBurst",0,0,28,0,0,0,0,1)
TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD),"PickupSpread")
stop
PickupSpread:
TNT1 A 0 A_SpawnItemEx("S_RageUnitBurst",0,0,14,0,0,0,15,1)
TNT1 A 0 A_SpawnItemEx("S_RageUnitBurst",0,0,42,0,0,0,-15,1)
stop
}
}


actor RageUnitShiny_W_ScriptBar : ScriptBar {}

actor RageUnitShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_RageUnit_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_15"
Obituary "$OB_15W"
weapon.ammotype "RageEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H15 [ 6
loop

Deselect:
7H15 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,1)
goto DeselectSwap
7H15 D 0 A_JumpIfInventory("RageUnitEnrage_F",2,1)
goto DeselectSwap
7H15 G 0 A_JumpIfInventory("RageUnitEnrage_F",3,1)
goto DeselectSwap
7H15 J 0 A_JumpIfInventory("RageUnitEnrage_F",4,1)
goto DeselectSwap
7H15 M 0
goto DeselectSwap
Select:
7H15 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,1)
goto SelectSwap
7H15 D 0 A_JumpIfInventory("RageUnitEnrage_F",2,1)
goto SelectSwap
7H15 G 0 A_JumpIfInventory("RageUnitEnrage_F",3,1)
goto SelectSwap
7H15 J 0 A_JumpIfInventory("RageUnitEnrage_F",4,1)
goto SelectSwap
7H15 M 0
goto SelectSwap

Ready:
7H15 A 1 A_GiveInventory("S_RageUnit_ReadyDye_P")
7H15 A 0 A_GunFlash("Flash",1)
goto Ready0+1
Ready0:
7H15 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,"Ready1")
7H15 A 2 A_GiveInventory("RageUnit_Ready_P")
loop

Ready1:
7H15 D 0 A_JumpIfInventory("RageUnitEnrage_F",2,"Ready2")
7H15 D 2 A_GiveInventory("RageUnit_Ready_P")
7H15 D 0 A_JumpIfInventory("RageUnitEnrage_F",1,"Ready1")
goto Ready0

Ready2:
7H15 G 0 A_JumpIfInventory("RageUnitEnrage_F",3,"Ready3")
7H15 G 2 A_GiveInventory("RageUnit_Ready_P")
7H15 G 0 A_JumpIfInventory("RageUnitEnrage_F",2,"Ready2")
goto Ready0

Ready3:
7H15 J 0 A_JumpIfInventory("RageUnitEnrage_F",4,"Ready4")
7H15 J 2 A_GiveInventory("RageUnit_Ready_P")
7H15 J 0 A_JumpIfInventory("RageUnitEnrage_F",3,"Ready3")
goto Ready0

Ready4:
7H15 M 2 A_GiveInventory("RageUnit_Ready_P")
7H15 M 0 A_JumpIfInventory("RageUnitEnrage_F",4,"Ready4")
goto Ready0

Fire:
7H15 "#" 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H15 "#" 0 A_GiveInventory("S_RageUnit_MainF_P")
Fire0:
7H15 C 0 A_JumpIfInventory("RageUnitEnrage_F",1,"Fire1")
7H15 C 4
7H15 BAA 4 A_GiveInventory("RageEnergyAmmo",2)
Goto Ready0
Fire1:
7H15 F 0 A_JumpIfInventory("RageUnitEnrage_F",2,"Fire2")
7H15 FE 2
7H15 DD 4 A_GiveInventory("RageEnergyAmmo",2)
Goto Ready1
Fire2:
7H15 I 0 A_JumpIfInventory("RageUnitEnrage_F",3,"Fire3")
7H15 IH 2
7H15 G 6 A_GiveInventory("RageEnergyAmmo",3)
Goto Ready2
Fire3:
7H15 L 0 A_JumpIfInventory("RageUnitEnrage_F",4,"Fire4")
7H15 LKJ 2
Goto Ready3
Fire4:
7H15 O 2 A_GiveInventory("S_RageUnit_Fire4D_P")
7H15 M 2 A_GiveInventory("S_RageUnit_Fire4C_P")
7H15 N 2 A_GiveInventory("S_RageUnit_Fire4B_P")
7H15 M 2 A_GiveInventory("S_RageUnit_Fire4A_P")
Goto Ready4

BotFire:
7H15 A 0 A_JumpIfInventory("RageEnergyAmmo",0,"BotFire2")
7H15 A 0 A_GiveInventory("RageEnergyAmmo",random(5,10))
7H15 A 0 A_Jump(8,1)
goto Fire+1
7H15 A 0 A_PlaySoundEx("taunt/D_15","Voice")
7H15 A 0 A_GiveInventory("RageUnitBotSpeed")
goto Fire+1
BotFire2:
7H15 A 0 A_Jump(128,"AltFire")
goto Fire+1

Flash:
TNT1 A 1
TNT1 A 0 A_GiveInventory("S_RageUnit_Flash_P")
loop

AltFire:
7H15 "#" 0 A_TakeInventory("RageEnergyAmmo",95,1)
7H15 "#" 0 A_TakeInventory("RageEnergyAmmo",65)
7H15 B 0 A_JumpIfInventory("RageUnitEnrage_F",1,"AltFire1")
7H15 B 0 A_GiveInventory("S_RageUnit_Alt_P")
7H15 P 1 Offset(-20,6)
7H15 P 1 Offset(-47,-21)
7H15 Q 5 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 P 3 Offset(-47,-21)
7H15 P 3 Offset(-20,6)
7H15 P 4 A_WeaponReady(14)
Goto Ready0
AltFire1:
7H15 E 0 A_JumpIfInventory("RageUnitEnrage_F",2,"AltFire2")
7H15 R 1 Offset(-20,6)
7H15 R 1 Offset(-47,-21)
7H15 S 2 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 R 2 Offset(-47,-21)
7H15 S 3 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 R 3 Offset(-47,-21)
7H15 R 3 Offset(-20,6)
7H15 R 6 A_WeaponReady(14)
Goto Ready1
AltFire2:
7H15 H 0 A_JumpIfInventory("RageUnitEnrage_F",3,"AltFire3")
7H15 T 1 Offset(-20,6)
7H15 T 1 Offset(-47,-21)
7H15 U 2 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 T 2 Offset(-47,-21)
7H15 U 2 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 T 2 Offset(-47,-21)
7H15 U 4 Offset(-47,-21) A_GiveInventory("S_RageUnit_Alt_P")
7H15 T 3 Offset(-47,-21)
7H15 T 3 Offset(-20,6)
7H15 T 4 A_WeaponReady(14)
Goto Ready2
AltFire3:
7H15 K 0 A_JumpIfInventory("RageUnitEnrage_F",4,"AltFire4")
7H15 V 1 Offset(-20,6)
7H15 V 1 Offset(-47,-21)
7H15 W 3 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 V 3 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 W 3 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 V 5 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 V 2 Offset(-20,6)
7H15 V 3 A_WeaponReady(14)
Goto Ready3
AltFire4:
7H15 X 1 Offset(-20,6)
7H15 X 1 Offset(-47,-21)
7H15 Y 2 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 X 2 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 Y 2 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 X 2 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 Y 2 Offset(-47,-21) A_GiveInventory("RageUnit_Alt_P")
7H15 X 1 Offset(-47,-21)
7H15 X 1 Offset(-20,6)
7H15 X 0 A_WeaponReady(14)
Goto Ready4
}
}

actor S_RageUnit_ReadyDye_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",4,"P4")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",3,"P3")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",2,"P2")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,"P1")
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_SDYE,1)
stop
P1:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_SDYE1,1)
stop
P2:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_SDYE2,1)
stop
P3:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_SDYE3,1)
stop
P4:
TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RAGEUNIT_SDYE4,1)
stop
}
}

actor S_RageUnit_Flash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",4,"P_4")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",3,"P_3")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",2,"P_2")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,"P_1")
goto P_0
P_0:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75+1,"P_A")
stop
P_A:
TNT1 A 0 A_GiveInventory("RageUnitEnrage_F",1)
goto P_11
P_1:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50+1,"P_1A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75+1,"Done")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto DoneX
P_11:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50+1,"P_1A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75+1,"DoneX")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto DoneX
P_1A:
TNT1 A 0 A_GiveInventory("RageUnitEnrage_F",1)
goto P_22
P_2:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25+1,"P_2A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50+1,"Done")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_11
P_22:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25+1,"P_2A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50+1,"DoneX")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_11
P_2A:
TNT1 A 0 A_GiveInventory("RageUnitEnrage_F",1)
goto P_33
P_3:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01+1,"P_3A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25+1,"Done")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_22
P_33:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01+1,"P_3A")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25+1,"DoneX")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_22
P_3A:
TNT1 A 0 A_GiveInventory("RageUnitEnrage_F",1)
goto P_44
P_4:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01+1,"Done")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_33
P_44:
TNT1 A 1
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.01+1,"DoneX")
TNT1 A 0 A_TakeInventory("RageUnitEnrage_F",1)
goto P_33
Done:
TNT1 A 0
stop
DoneX:
TNT1 A 0 A_GiveInventory("S_RageUnit_ReadyDye_P")
stop
}
}

actor S_RageUnit_MainF_P : RageUnit_MainF_P
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",4,"Fire4")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",3,"Fire3")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",2,"Fire2")
TNT1 A 0 A_JumpIfInventory("RageUnitEnrage_F",1,"Fire1")
Fire0:
TNT1 A 0 A_GiveInventory("RageEnergyAmmo",2)
TNT1 A 0 A_FireCustomMissile("S_RageShot1",0,0,8,0)
goto Pew
Fire1:
TNT1 A 0 A_GiveInventory("RageEnergyAmmo",2)
TNT1 A 0 A_FireCustomMissile("S_RageShot2",-4.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot2",4.5,0,8,0)
goto Pew
Fire2:
TNT1 A 0 A_GiveInventory("RageEnergyAmmo",2)
TNT1 A 0 A_FireCustomMissile("S_RageShot3",0,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot3",7,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot3",-7,0,8,0)
goto Pew
Fire3:
TNT1 A 0 A_GiveInventory("RageEnergyAmmo",3)
TNT1 A 0 A_FireCustomMissile("S_RageShot4",-7.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot4",-2.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot4",2.5,0,8,0)
TNT1 A 0 A_FireCustomMissile("S_RageShot4",7.5,0,8,0)
goto Pew
}
}


actor S_NegaBlackHoleBomb
{
Translation "192:192=228:228", "198:198=230:230"
PROJECTILE
-NOGRAVITY
+DONTBLAST
damagetype "BlackHoleBomb"
Obituary "$OB_BLACKHOLEBOMB"
Damage(100)
Radius 16
Height 16
Speed 18
Gravity 0.5
Scale 2.5
var int user_BAngle;
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetUserVar("user_BAngle",0)
TNT1 A 0 ThrustThingZ(0,20,0,1)
TNT1 A 0 A_PlaySoundEx("weapon/blackholebomb","Voice")
X_9H XXXXYYYYZZZZYYYY 1 A_SpawnItemEx("NegaBlackHoleBombFX",random(-16,16),random(-16,16),random(-16,16),random(-2,2),random(-2,2),random(-1,-4),0,1)
goto Spawn+2
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_ChangeFlag("NOGRAVITY",1)
TNT1 A 0 A_PlaySoundEx("weapon/blackholebombdetonate","Body",1)
TNT1 A 0 A_SpawnItemEx("BlackHoleBombFXSpawnerU",0,0,0,0,0,0,0,1)
TNT1 A 0 A_Explode(128,192,0,0,24)
//I swear there's a more efficient way to do this with less lines
TNT1 A 0 A_JumpIfInventory("CutterFlag",5,"Die") //8
X_9H F 3 A_SpawnItemEx("NegaBlackHoleBomb",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H G 3 A_SpawnItemEx("NegaBlackHoleBomb2",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H H 3 A_SpawnItemEx("NegaBlackHoleBomb3",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H I 3 A_SpawnItemEx("NegaBlackHoleBomb4",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H J 3 A_SpawnItemEx("NegaBlackHoleBomb5",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H K 3 A_SpawnItemEx("NegaBlackHoleBomb6",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H L 3 A_SpawnItemEx("NegaBlackHoleBomb7",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
X_9H M 3 A_SpawnItemEx("NegaBlackHoleBomb8",0,0,4,10,0,0,user_BAngle)
TNT1 A 0 A_SetUserVar("user_BAngle",user_BAngle+15)
TNT1 A 0 A_GiveInventory("CutterFlag",1)
goto Death+5
Die:
TNT1 A 3
TNT1 A 0 A_StopSound("Body")
stop
}
}


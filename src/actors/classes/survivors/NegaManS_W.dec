actor S_NegaFlashBombExplosion : BasicExplosion
{
damagetype "FlashBomb"
Obituary "$OB_FLASHBOMB"
+FORCEXYBILLBOARD
+BRIGHT
ReactionTime 12
Scale 3.5
States
{
Spawn:
X_8G A 0
X_8G A 0 A_PlaySoundEx("weapon/flashbomb","Weapon")
X_8G ABCD 1
X_8G E 0 A_Explode(40+ReactionTime*2,92,0,0,16)
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H0",0,0,0,0,0,0,0,1)
X_8G EFGF 1
X_8G G 0 A_Explode(38+ReactionTime*2,92,0,0,16)
Goto Pattern1
Pattern1:
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H1",0,0,0,0,0,0,0,1)
Y_8G EFGF 1
Goto DamageNow
Pattern2:
X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H2",0,0,0,0,0,0,0,1)
Y_8G EFEF 1
Goto DamageNow
DamageNow:
X_8G G 0 A_Explode(36+ReactionTime*2,92,0,0,16)
X_8G G 0 A_CountDown
X_8G G 0 A_Jump(256,"Pattern1","Pattern2")
Goto Death
Death:
X_8G G 1
TNT1 A 1 
X_8G D 1
TNT1 A 1 
X_8G D 1
TNT1 A 1 
X_8G N 1
stop
}
}


actor Rameses : CustWepClassBase {
  Player.ScoreIcon "UMUG_32"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Rameses"
  Player.SoundClass "Rameses"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Rameses_W"
  Player.StartItem "DarknessEnergyAmmo", 0
  States {
   Spawn:
    PHAR A 0
    PHAR B 1
    PHAR A 1
    goto Spawn+2
   See:
    PHAR BCDE 5
    goto Spawn
   Missile:
    PHAR FF 1 A_JumpIfInventory("WeaponCharge", 1, "MissileSpecial")
    PHAR FFF 1
    PHAR GGGG 1
    goto Spawn+2
   MissileSpecial:
    PHAR NNNN 1
    PHAR GGGG 1
    goto Spawn+2
   ClassPain:
    PHAR H 0
    goto MegamanPain

   ClassDeath:
    PHAR H 0
    goto MegamanDeath
   MegamanDeath0:
    PHAR H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    PHAR N 22 A_SpawnItemEx("RamesesDeadWarpFX", 0, 0, 80, 0, 0, 0, 0, 1)
    PHAR H 0 A_PlaySound("S_Spin/Explode", 1)
    PHAR H 0 A_SpawnItemEx("RamesesDeathHead", 0, 0, 36, velx + random(-2, 2), vely + random(-2, 2), 10, 0, 1 + 8)
    goto MegamanErase
   MegamanDisintegrate:
    PHAR Z 0 A_SpawnItemEx("Corpse_32", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor RamesesShiny : Rameses {
  Player.ScoreIcon "UMUG_S32"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 11
  Player.MorphWeapon "RamesesShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    PHAR H 4 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    PHAR N 22 A_SpawnItemEx("RamesesDeadWarpFX", 0, 0, 80, 0, 0, 0, 0, 1)
    PHAR H 0 A_PlaySound("S_Spin/Explode", 1)
    PHAR H 0 A_SpawnItemEx("S_RamesesDeathHead", 0, 0, 36, velx + random(-2, 2), vely + random(-2, 2), 10, 0, 1 + 8)
    goto MegamanErase
  }
}


actor RamesesDeathHead : BasicProjectile {
  DamageType "Rameses"
  Obituary "$OB_32D"
  Damage (200)
  Radius 14
  Height 14
  Speed 10
  Scale 2.5
  Args 200, 156, 12
  States {
   Spawn:
    6P32 JKLM 2
    6P32 J 0 A_ChangeFlag("NOGRAVITY", 0)
    6P32 JKLM 2
    goto Spawn+5
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("S_1/Explode", 1)
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_RamesesDeathHead : RamesesDeathHead {
  Args 300, 156, 12
}

actor RamesesDeadWarpFX : BasicExplosion {
  Translation "192:192=214:214", "198:198=248:248"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  Args 21
  States {
   Spawn:
    X_4D B 0
    X_4D BBCCDDEEFFGGHHIIJJKKJJKK 1 A_GiveInventory("RamesesDeadWarpFX_P")
    stop
  }
}
actor RamesesDeadWarpFX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 70 + args[0] / 2.0f, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_CountDownArg(0)
    stop
  }
}

actor Corpse_32 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_32_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_32_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_32_0 : BaseCorpseFX {States {Spawn: 1H32 O 350
    goto Spawn2}}
actor Corpse_32_1 : BaseCorpseFX {States {Spawn: 1H32 P 350
    goto Spawn2}}
actor Corpse_32_2 : BaseCorpseFX {States {Spawn: 1H32 Q 350
    goto Spawn2}}
actor Corpse_32_3 : BaseCorpseFX {States {Spawn: 1H32 R 350
    goto Spawn2}}
actor Corpse_32_4 : BaseCorpseFX {States {Spawn: 1H32 S 350
    goto Spawn2}}
actor Corpse_32_5 : BaseCorpseFX {States {Spawn: 1H32 T 350
    goto Spawn2}}
actor Corpse_32_6 : BaseCorpseFX {States {Spawn: 1H32 U 350
    goto Spawn2}}

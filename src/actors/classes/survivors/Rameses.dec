actor Rameses : CustWepClassBase
{
player.scoreIcon "UMUG_32"
player.displayname "Rameses"
player.soundclass "Rameses"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 1.0, 1.0
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "Rameses_W"
player.startitem "DarknessEnergyAmmo", 0
States
{
Spawn: 
PHAR A 0
PHAR B 1
PHAR A 1
Goto Spawn+2
See:
PHAR BCDE 5
Goto Spawn
Missile:
PHAR FF 1 A_JumpIfInventory("WeaponCharge",1,"MissileSpecial")
PHAR FFF 1
PHAR GGGG 1
goto Spawn+2
MissileSpecial:
PHAR NNNN 1
PHAR GGGG 1
goto Spawn+2
ClassPain: PHAR H 0
Goto MegamanPain

ClassDeath:
PHAR H 0
goto MegamanDeath
MegamanDeath0:
PHAR H 4 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PHAR N 22 A_SpawnItemEx("RamesesDeadWarpFX",0,0,80,0,0,0,0,1)
PHAR H 0 A_PlaySound("S_Spin/Explode",1)
PHAR H 0 A_SpawnItemEx("RamesesDeathHead",0,0,36,momx+random(-2,2),momy+random(-2,2),10,0,1+8)
Goto MegamanErase
MegamanCorpse:
PHAR Z 0 A_SpawnItemEx("Corpse_32",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor RamesesS : Rameses
{
player.scoreIcon "UMUG_S32"
Player.Maxhealth 3000
health 3000
player.forwardmove 1.1, 1.1
player.sidemove 1.1, 1.1
player.jumpz 11
player.morphweapon "RamesesS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
PHAR H 4 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PHAR N 22 A_SpawnItemEx("RamesesDeadWarpFX",0,0,80,0,0,0,0,1)
PHAR H 0 A_PlaySound("S_Spin/Explode",1)
PHAR H 0 A_SpawnItemEx("S_RamesesDeathHead",0,0,36,momx+random(-2,2),momy+random(-2,2),10,0,1+8)
Goto MegamanErase
}
}


actor RamesesDeathHead : BasicProjectile
{
damagetype "Rameses"
Obituary "$OB_32D"
damage (200)
Radius 14
Height 14
speed 10
scale 2.5
Args 200,156,12
States
{
Spawn:
6P32 JKLM 2
6P32 J 0 A_ChangeFlag("NOGRAVITY",0)
6P32 JKLM 2
Goto Spawn+5
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("S_1/Explode",1)
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1)
stop
}
}
actor S_RamesesDeathHead : RamesesDeathHead
{
Args 300,156,12
}

actor RamesesDeadWarpFX : BasicExplosion
{
Translation "192:192=214:214","198:198=248:248"
+FORCEXYBILLBOARD
+BRIGHT
Scale 2.5
Args 21
States
{
Spawn:
X_4D B 0
X_4D BBCCDDEEFFGGHHIIJJKKJJKK 1 A_GiveInventory("RamesesDeadWarpFX_P")
stop
}
}
actor RamesesDeadWarpFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Warp(AAPTR_TARGET,0,0,70+Args[0]/2.0f,0,WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
TNT1 A 0 A_CountDownArg(0)
stop
}
}

actor Corpse_32:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_32_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_32_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


actor TrapistMineBlast : BasicExplosion {
  Translation "192:192=228:228", "198:198=164:164", "89:89=228:228", "95:95=164:164"
  Damagetype "TrapistMine"
  Obituary "$OB_30A2"
  +FORCEXYBILLBOARD
  Height 10
  Accuracy 7
  Args 200, 180, 100
  Scale 5.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_TakeFromTarget("TrapistPrimedFlag", 999)
    TNT1 A 0 A_PlaySound("Trapist/Kaboom", 1)
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_JumpIf(!CallACS("uc_TrapistBombJump", 52, 180, -10, Accuracy), 1)
    //TNT1 A 0 A_JumpIfCloser(140,1)//112
    goto FX
    TNT1 A 0 //A_GiveToTarget("",1)
    goto FX
   FX:
    TNT1 A 0
    6P30 HIJKLMNOP 2
    stop
  }
}

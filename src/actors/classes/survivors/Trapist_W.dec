// TODO: visualize TrapistPrimedFlag on the bar

actor Trapist_W_ScriptBar : ScriptBar {}

actor Trapist_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 100
  Inventory.Pickupmessage "$PU_30"
  Obituary "$OB_30W"
  Tag "$TAG_Trapist_W"
  weapon.ammotype "ClashEnergyAmmo"
  weapon.ammotype2 "TrapistEnergyAmmo"
  States {
   Spawn:
    6H30 [ 6
    loop

   Deselect:
    6H30 A 0
    goto DeselectSwap
   Select:
    6H30 A 0
    goto SelectSwap

   Ready:
    6H30 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TRAPIST_DYE)
    Goto Ready2
   Ready2:
    6H30 A 2 A_GiveInventory("Trapist_Ready_P")
    6H30 A 0 A_GiveInventory("ClashEnergyAmmo", 2)
    6H30 A 0 A_GiveInventory("TrapistEnergyAmmo", 1)
    loop

   Fire:
    6H30 A 0 A_JumpIfInventory("IsBot", 1, "BotCheck")
    6H30 A 0 A_GiveInventory("Trapist_Fire_P")
    6H30 HGFFFEDCB 2
    Goto Ready2

   AltFire:
    6H30 A 0 A_JumpIfInventory("TrapistPrimedFlag", 1, "AltDet")
    6H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo", 100, "AltTrapH0")
   AltToss:
    6H30 A 0 A_GiveInventory("Trapist_Alt_P")
    6H30 HGFEDCB 1
    Goto Ready2
   AltDet:
    6H30 I 0 A_GiveInventory("Trapist_AltDetonate_P")
    6H30 IJKJIA 2
    //6H30 HGFEDCBA 2
    goto Ready2

   AltTossed:
    6H30 H 0 A_GunFlash("NoFlash", 1)
    6H30 H 0 A_TakeInventory("TrapistChargeFlag")
    goto AltToss

   AltTrapH0:
    6H30 B 0 A_GunFlash("Flash.AltAmmo", 1)
   AltTrapH1:
    6H30 B 0 A_JumpIfInventory("TrapistChargeFlag", 12, "AltTrapH2")
    6H30 B 1 A_GiveInventory("TrapistChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H30 B 0 A_Refire("AltTrapH1")
    goto AltTossed
   AltTrapH2:
    6H30 C 0 A_JumpIfInventory("TrapistChargeFlag", 24, "AltTrapH3")
    6H30 C 1 A_GiveInventory("TrapistChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H30 C 0 A_Refire("AltTrapH2")
    goto AltTossed
   AltTrapH3:
    6H30 D 0 A_JumpIfInventory("TrapistChargeFlag", 36, "AltTrapH4")
    6H30 D 1 A_GiveInventory("TrapistChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H30 D 0 A_Refire("AltTrapH3")
    goto AltTossed
   AltTrapH4:
    6H30 L 1 A_RailWait
    6H30 L 0 A_Refire(1)
    goto AltTrap
    6H30 E 1 A_RailWait
    6H30 E 0 A_Refire("AltTrapH4")
    goto AltTrap
   AltTrap:
    6H30 G 0 A_GunFlash("NoFlash", 1)
    6H30 G 0 A_GiveInventory("Trapist_Alt_P3")
    6H30 GFFEDCB 2
    goto Ready2

   Flash.AltAmmo:
    TNT1 AA 2
    TNT1 A 5 A_GiveInventory("ClashEnergyAmmo", 1)
    wait

   BotCheck:
    6H30 A 0 A_Jump(16, "BotCheckX")
    6H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo", 50, "BotAlt")
    6H30 A 0 A_Jump(32, "BotAlt")
    6H30 A 0 A_Jump(48, 2)
    6H30 A 0 A_GiveInventory("ClashEnergyAmmo", random(1, 7)*4)
    goto Fire+1
    6H30 A 0 A_GiveInventory("TrapistEnergyAmmo", random(8, 14)*4)
    6H30 A 0 A_GiveInventory("ClashEnergyAmmo", random(8, 14)*2)
    6H30 A 0 ThrustThingZ(0, 40*CallACS("core_CheckFooting"), 0, 1)
    goto Fire+1
   BotCheckX:
    6H30 A 0 A_GiveInventory("ClashEnergyAmmo", 100)
    6H30 A 0 A_GiveInventory("TrapistEnergyAmmo", 100)
    6H30 A 0 A_PlaySoundEx("taunt/D_30", "Voice")
    6H30 A 0 A_Jump(256, "BotFire1", "BotFire2", "BotFire3")
   BotFire1:
    6H30 AA 0 A_FireCustomMissile("TrapistFragShot", 7.5, 0, 0, 0, 1, random(-7, 7))
    6H30 AA 0 A_FireCustomMissile("TrapistFragShot", -7.5, 0, 0, 0, 1, random(-7, 7))
    goto Fire+1
   BotFire2:
    6H30 A 1 ThrustThingZ(0, 20*CallACS("core_CheckFooting"), 0, 1)
    6H30 A 0 A_GiveInventory("TrapistTrigger_F", 1)
    6H30 A 0 A_PlaySound("Trapist/Toss", 1)
    6H30 A 0 A_FireCustomMissile("TrapistMineStart", 180+random(-3, 3)*5, 0, 0, -24)
    goto AltToss+1
   BotFire3:
    6H30 A 0 A_PlaySoundEx("misc/itemthrow", 1)
    6H30 A 0 A_FireCustomMissile("TrapistTrap", 0, 0)
    6H30 A 0 A_FireCustomMissile("TrapistTrap", 22.5, 0)
    6H30 A 0 A_FireCustomMissile("TrapistTrap", -22.5, 0)
    goto AltTrap+2
   BotAlt:
    6H30 A 0 A_JumpIfInventory("TrapistEnergyAmmo", 0, 4)
    6H30 A 0 A_Jump(48, "AltTrap")
    6H30 A 0 A_JumpIfInventory("TrapistPrimedFlag", 1, "AltDet")
    6H30 A 0 A_Jump(128, "AltToss")
    goto BotCheck+3
    6H30 A 0 A_Jump(96, "AltTrap")
    goto BotAlt+1
  }
}

actor ClashEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 100
  +INVENTORY.IGNORESKILL
}
actor TrapistEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 100
  +INVENTORY.IGNORESKILL
}

actor TrapistChargeFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 36
}

actor TrapistPrimedFlag : Inventory{}

actor TrapistTrigger_F : Powerup {
  Powerup.Duration 8
}


actor Trapist_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("TrapistPrimedFlag", 1, 4)
    TNT1 A 0 A_JumpIfInventory("TrapistEnergyAmmo", 50, 3)
    TNT1 A 0 A_JumpIfInventory("ClashEnergyAmmo", 20, 4)
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
    stop
    TNT1 A 0 A_JumpIfInventory("ClashEnergyAmmo", 20, 4)
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    stop
    TNT1 A 0 A_JumpIfInventory("TrapistEnergyAmmo", 50, 2)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
    TNT1 A 0 A_WeaponReady
    stop
  }
}

actor Trapist_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("TrapistFragShot", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_PlaySound("Bat_Rob/Pew2", 1)
    TNT1 A 0 A_GiveInventory("TrapistEnergyAmmo", 5)
    TNT1 A 0 A_TakeInventory("ClashEnergyAmmo", 10, 1)
    TNT1 A 0 A_TakeInventory("ClashEnergyAmmo", 10)
    stop
  }
}

actor Trapist_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("TrapistMineStart", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_PlaySound("Trapist/Toss", 1)
    TNT1 A 0 A_GiveInventory("TrapistPrimedFlag", 1)
    TNT1 A 0 A_TakeInventory("TrapistEnergyAmmo", 25, 1)
    TNT1 A 0 A_TakeInventory("TrapistEnergyAmmo", 25)
    TNT1 A 0 A_TakeInventory("TrapistTrigger_F")
    stop
  }
}

actor Trapist_AltDetonate_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("TrapistPrimedFlag")
    TNT1 A 0 A_GiveInventory("TrapistTrigger_F", 1)
    TNT1 A 0 A_PlaySound("Trapist/Beep", 1)//S3_K/Beep
    stop
  }
}

actor Trapist_Alt_P3 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("TrapistTrap", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_PlaySoundEx("misc/itemthrow", 1)
    TNT1 A 0 A_TakeInventory("TrapistEnergyAmmo", 50, 1)
    TNT1 A 0 A_TakeInventory("TrapistEnergyAmmo", 50)
    TNT1 A 0 A_TakeInventory("TrapistChargeFlag")
    stop
  }
}


actor TrapistFragShot : BasicProjectile//TrapistFragBomb
{
  Translation "192:192=33:33", "198:198=254:254"
  BounceSound "Trapist/Bounce"
  DeathSound "Trapist/Kaboom2"

  Obituary "$OB_30M1"
  damagetype "Trapist"
  -NOGRAVITY
  +FORCEXYBILLBOARD

  +CANBOUNCEWATER
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +USEBOUNCESTATE
  bouncefactor 0.5
  wallbouncefactor 0.85
  bouncecount 10
  Gravity 0.75
  reactiontime 1
  damage (200)
  Radius 16
  Height 16
  speed 25
  scale 2.5
  Args 20, 13, 2, 2
  States {
   Spawn:
    6P30 E 0
    6P30 E 0 ThrustThing(angle*256/360, 4, 1, 0)
    6P30 E 0 ThrustThingZ(0, 12, 0, 1)

   SL:
    6P30 AABBCCDD 1 A_SpawnItemEx("TrapistBombSmoke", -momx+random(-8, 8), -momy+random(-8, 8), -momz+8, 0, 0, frandom(4, 5), 0, 1+SXF_ABSOLUTEPOSITION, 32)//2
    6P30 A 0 A_JumpIf(Args[0]==1, "FlashTime")
    6P30 A 0 A_CountDownArg(0)
    loop
   Short:
    6P30 ABCD 1 A_SpawnItemEx("TrapistBombSmoke", -momx+random(-8, 8), -momy+random(-8, 8), -momz+8, 0, 0, frandom(4, 5), 0, 1+2, 32)
    6P30 A 0 A_JumpIf(Args[1]==1, "FlashTime")
    6P30 A 0 A_CountDownArg(1)
    loop
   FlashTimeF:
    6P30 E 0 ThrustThingZ(0, 8, 0, 0)
   FlashTime:
    6P30 E 0 A_ChangeFlag("USEBOUNCESTATE", 0)
    6P30 E 0 //A_Stop
    6P30 E 0 A_SetGravity(0.0)
    6P30 E 2 Bright
    6P30 F 2
    6P30 E 2 Bright
    6P30 G 2
    6P30 E 2 Bright
    6P30 E 1 A_CountDown
    wait

   Bounce.Floor:
    6P30 E 0 A_JumpIf(Args[2]==1||Args[3]==1, "FlashTimeF")
    6P30 E 0 A_CountDownArg(2)
    goto Short
   Bounce.Ceiling:
   Bounce.Wall:
    6P30 E 0 A_JumpIf(Args[3]==1, "Short")
    6P30 E 0 A_CountDownArg(3)
    goto Short

   Death:
    TNT1 A 1 A_SpawnItemEx("TrapistLobbedBlast", 0, 0, 7.5f, 0, 0, 0, 0, 1)
    stop
  }
}


actor TrapistFragShot2 : BasicProjectile {
  Translation "192:192=33:33", "198:198=254:254", "202:202=4:4", "199:199=228:228"
  BounceSound "Trapist/Bounce"
  DeathSound "Trapist/Kaboom2"
  Obituary "$OB_30M1"
  damagetype "Trapist"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  //+DONTBLAST
  /*
  +SHOOTABLE
  +INVULNERABLE
  +NODAMAGE
  -NOBLOCKMAP
  +NONSHOOTABLE
  //+NORADIUSDMG
  //RadiusDamageFactor 0.0
  damagefactor "Normal", 0.0
  */
  +CANBOUNCEWATER
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  bouncefactor 0.5
  wallbouncefactor 0.5
  bouncecount 10
  reactiontime 35
  Mass 10
  damage (200)//120 OverW
  Radius 16//0.25 meters (projectile size)
  Height 12
  speed 35//25 meters
  scale 2.5
  States {
   Spawn:
    6P30 E 0
    6P30 E 0 ThrustThingZ(0, 15, 0, 1)
    6P30 E 0 A_CountDown
    6P30 E 2 Bright A_SpawnItemEX("TrapistBombSmoke", 0, random(-8, 8), 8, 0, 0, 5, 0, 1)
    6P30 AB 2 A_SpawnItemEX("TrapistBombSmoke", 0, random(-8, 8), 8, 0, 0, 5, 0, 1)
    6P30 E 2 Bright A_SpawnItemEX("TrapistBombSmoke", 0, random(-8, 8), 8, 0, 0, 5, 0, 1)
    6P30 CD 2 A_SpawnItemEX("TrapistBombSmoke", 0, random(-8, 8), 8, 0, 0, 5, 0, 1)
    Goto Spawn+2
   Bounce.Ceiling:
   Bounce.Floor:
    6P30 FEG 2
    goto Spawn+2
   Death:
    TNT1 A 0 //A_Explode(150,128,0)
    TNT1 A 0 //A_RadiusThrust(150,64,RTF_NOIMPACTDAMAGE,64)//A_Blast(0,8,64,32) //for fun
    TNT1 A 1 A_SpawnItemEx("TrapistLobbedBlast", 0, 0, 7.5f, 0, 0, 0, 0, 1)//A_SpawnItemEx("BasicBoom8FX_ColorY",0,0,0,0,0,0,0,1+16384)
    //Y_1D OPQRSTUVWXYZ 1
    //Y_2E KLMNOPQRSTUVW 1
    //ECL5 AABCDEF 1
    stop
  }
}

actor TrapistLobbedBlast : BasicExplosion {
  Obituary "$OB_30M2"
  damagetype "Trapist"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  Args 150, 128, 20
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    6P30 HIJKLMNOP 1
    stop
  }
}

actor TrapistBombSmoke : BasicClientSide {
  //Translation "202:202=4:4","199:199=228:228"
  +FORCEXYBILLBOARD
  //scale 0.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 Q 0 A_SetScale(ScaleX-frandom(0, 1))
    TNT1 A 0 A_SetScale(ScaleX*(random(0, 1)*2-1), ScaleY)
    6P30 Q random(0, 2)
    6P30 RST random(1, 3)
    stop
   SpawnOld:
    UMFX D 0
    UMFX DKJIOM 2 A_FadeOut(0.1)
    stop
  }
}




actor TrapistMineStart : BasicProjectile {
  Translation "192:192=228:228", "198:198=164:164"
  Damagetype "TrapistMine"
  Obituary "$OB_30A1"
  -NOGRAVITY
  +THRUACTORS
  +RIPPER
  //+DONTBLAST
  +SKYEXPLODE
  Damage(0)
  Radius 20
  Height 20
  Speed 19
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThing(angle*256/360, 4, 1, 0)
    TNT1 A 0 ThrustThingZ(0, 16, 0, 1)
   SpawnL:
    6Q30 NNOOPPQQRRSSTTUU 1 A_JumpIfInTargetInventory("TrapistTrigger_F", 1, "Command")
    loop
   Command:
    6Q30 N 0 A_SpawnItemEX("TrapistMineSnd_H")
    6Q30 N 0 A_SpawnItemEx("TrapistMineBlast", 0, 0, Height/2)
    stop
   Death:
    6Q30 N 0 A_SetGravity(0.0)
    6Q30 N 0 A_CheckFloor("DeathF")
    6Q30 N 0 A_CheckCeiling("DeathC")
    6Q30 N 0
    6Q30 N 1 A_SpawnItemEX("TrapistMineY_HelpStart", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   DeathF:
    6Q30 N 0 A_SpawnItemEx("TrapistMineX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   DeathC:
    6Q30 N 0 A_SpawnItemEx("TrapistMineZ", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor TrapistMineX : BasicProjectile {
  Damagetype "TrapistMine"
  Obituary "$OB_30A2"
  +DONTBLAST
  +DONTREFLECT
  +FLOORHUGGER
  +THRUACTORS
  +RIPPER
  ReactionTime 1
  damage (0)
  radius 20
  height 20
  scale 2.5
  States {
   Spawn:
    6Q30 J 0
    6Q30 J 0 A_PlaySound("wep/Trapist_Latch", 1)
    6Q30 KJKJKJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJ 1 A_JumpIfInTargetInventory("TrapistTrigger_F", 1, "Command")
    6Q30 KJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJJJJJJJJJJJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJJJKJKJKJ 1 A_JumpIfInTargetInventory("TrapistTrigger_F", 1, "Command")
    6Q30 K 1 A_Countdown//300
    wait
   Command:
    6Q30 K 0 A_SpawnItemEX("TrapistMineSnd_H")
    6Q30 K 1 A_Countdown
    wait
   Death:
    TNT1 A 0 A_SpawnItemEx("TrapistMineBlastX", 0, 0, Height/2)
    stop
  }
}


actor TrapistMineY_HelpStart {
  +SERVERSIDEONLY
  PROJECTILE
  +DONTBLAST
  +DONTREFLECT
  +THRUACTORS
  Renderstyle None
  Damage (0)
  Radius 10
  Height 20
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("TrapistMineY_HelpF", 0, 0, 0, 0, 0, 0, 0, 1)//Move it up
    stop
   ForceSpawn:
    TNT1 A 0 A_SpawnItemEx("TrapistMineY", 0, 0, 0, 0, 0, 0, 180, 1+32)
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("TrapistMineY_HelpB", 0, 0, 0, 0, 0, 0, 0, 1)//Back it up
    stop
  }
}
actor TrapistMineY_HelpF : TrapistMineY_HelpStart {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetPitch(pitch+1)
    TNT1 A 0 A_JumpIf(pitch>=20, "FailSpawn")
    TNT1 A 0 A_SpawnItemEx("TrapistMineY_HelpF", 2, 0, 0, 0, 0, 0, 0, 1+32+SXF_TRANSFERPITCH)//512
    stop
   FailSpawn://Couldn't hit a surface, place mine back at start point
    TNT1 A 0 A_SpawnItemEx("TrapistMineY", 40, 0, 0, 0, 0, 0, 180, 1+32)
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("TrapistMineY", 2, 0, 0, 0, 0, 0, 180, 1+32)
    stop
  }
}
actor TrapistMineY_HelpB : TrapistMineY_HelpStart {
  States {
   Spawn:
    TNT1 A 0
    goto ForceSpawn
   Death:
    TNT1 A 0 A_JumpIf(pitch>=10, "ForceSpawn")
    TNT1 A 0 A_SpawnItemEx("TrapistMineY_HelpB", -2, 0, 0, 0, 0, 0, 0, 1+32+512)
    stop
  }
}


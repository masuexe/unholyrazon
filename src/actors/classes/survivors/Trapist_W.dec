    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", 11, 0, 11, cos(45), 0, sin(45), Args[0]*30, 1+SXF_MULTIPLYSPEED)//8192
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", 11, 0, -11, cos(45), 0, -sin(45), Args[0]*30, 1+8192)
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", 16, 0, 0, 1, 0, 0, Args[0]*30+15, 1+8192)

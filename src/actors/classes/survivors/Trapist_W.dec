actor TrapistMineFX_H : BasicClientSide {
  Args 12, 11, 3
  States {
   Spawn:
    TNT1 A 0
   S0:
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", 16, 0, 0, 1, 0, 0, 360.0/Args[0]*Args[1], 1+SXF_MULTIPLYSPEED)//8192
    TNT1 A 0 A_CountDownArg(1, "S1")
    loop
   S1:
    TNT1 A 0 A_CountDownArg(2)
    TNT1 A 0 A_SetArg(0, Args[0]-2)
    TNT1 A 0 A_SetArg(1, Args[0]-1)
    TNT1 A 0 A_SetArg(4, Args[4]+1)
   S2:
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", cos(Args[4]*22.5)*16, 0, sin(Args[4]*22.5)*16, cos(Args[4]*22.5), 0, sin(Args[4]*22.5), 360.0/Args[0]*Args[1], 1+8192)
    TNT1 A 0 A_SpawnItemEx("TrapistMineFX", cos(Args[4]*22.5)*16, 0, -sin(Args[4]*22.5)*16, cos(Args[4]*22.5), 0, -sin(Args[4]*22.5), 360.0/Args[0]*Args[1], 1+8192)
    TNT1 A 0 A_CountDownArg(1, "S1")
    loop
   Death:
    TNT1 A 1
    stop
  }
}


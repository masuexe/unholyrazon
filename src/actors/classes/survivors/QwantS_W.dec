X_3H ABB 1
X_3H A 0 A_CountDown
X_3H AAB 1
loop
}
}

actor S_Q_WaterShuriken2 : S_Q_WaterShuriken
{
Damage (20+Args[4]*20)//60
States
{
Spawn:
X_3H A 2
TNT1 A 0 A_Changevelocity(0,Args[1]*3/2,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,-Args[0]*3/2,0,1)
X_3H ABB 1
X_3H A 0 A_SetArg(4,2)
Spawn2:
X_3H A 0 A_CountDown
X_3H AAB 1
TNT1 A 0 A_Changevelocity(0,-Args[1]*3,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,Args[0]*3,0,1)
X_3H ABB 1
X_3H A 0 A_CountDown
X_3H AAB 1
TNT1 A 0 A_Changevelocity(0,Args[1]*3,0,CVF_RELATIVE)
X_3H BBA 1
TNT1 A 0 ThrustThingZ(0,-Args[0]*3,0,1)
X_3H ABB 1
loop
}
}


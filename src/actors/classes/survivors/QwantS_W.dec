Actor S_NightDaze1 : NightDaze1
{
States
{
Spawn:
TMFX A 0
TMFX A 0 A_JumpIfInTargetInventory("PlayerPropertyRage",1,"SpawnR")
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 0 A_Explode(48*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-Args[2])
TMFX A 0 A_Explode(48*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_Countdown
goto Spawn+2
SpawnR:
TMFX A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
TMFX A 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-(Args[2]*2))
TMFX B 1 A_Warp(2,Args[0],0,28,Args[1],4+8+16)
TMFX A 0 A_SetArg(0,Args[0]-(Args[2]*2))
TMFX A 0 A_Explode(48*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*1),48,0)
TMFX A 0 A_Countdown
loop
}
}


actor LimShiny_W_NormalBar : NormalBar {args 197, 220}

actor LimShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Lim_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_43"
  Obituary "$OB_43W"
  Weapon.AmmoType "DireEnergyAmmo"
  States {
   Spawn:
    7H43 [ 6
    loop

   Deselect:
    7H43 A 0
    goto DeselectSwap
   Select:
    7H43 A 0
    goto SelectSwap

   Ready:
    7H43 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", LIM_SDYE)
    7H43 A 0 A_GunFlash("Flash", 1)
    goto Ready2

   Ready1:
    7H43 A 2 A_WeaponReady(WRF_NOPRIMARY | WRF_NOSECONDARY)
    7H43 AAAAAAAAAA 2 A_WeaponReady(WRF_NOSECONDARY)
    7H43 A 0 A_GiveInventory("DireEnergyAmmo", 1)
   Ready2:
    7H43 A 35 A_WeaponReady
    7H43 A 0 A_GiveInventory("DireEnergyAmmo", 1)
    loop

   Fire:
    7H43 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H43 A 1 Offset(21, 26) A_GiveInventory("S_Lim_Fire_P")
    7H43 A 1 Offset(33, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 1 Offset(45, 17)
    7H43 A 1 Offset(54, 23) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 B 0 A_GiveInventory("PowerLimFiringSlow")  // Needed for skin animation
    7H43 B 1 Offset(63, 28) ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 50, 100)  // A_GiveInventory("PowerLimFiringSlow",1)
    7H43 B 1 Offset(63, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 B 2 A_ReFire(1)
    goto FireEnd
    7H43 B 2
    7H43 B 0 A_ReFire(1)
    goto FireEnd
    7H43 B 2
    7H43 B 0 A_ReFire("FireH1")
    goto FireEnd

   FireEnd:
    7H43 A 0 A_TakeInventory("PowerLimFiringSlow")
    7H43 A 1 Offset(41, 16) ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 1, 1)  // A_TakeInventory("PowerLimFiringSlow")
    7H43 A 1 Offset(32, 20) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 1 Offset(22, 23)
    7H43 A 1 Offset(16, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 2 Offset(9, 28)
    goto Ready2

   FireH1:
    7H43 K 2 Offset(55, 36) A_GiveInventory("S_Lim_FireHold_P1")
    7H43 B 1
    7H43 B 0 A_ReFire(1)
    goto FireHEnd
    7H43 L 2 Offset(63, 28) A_GiveInventory("S_Lim_FireHold_P2")
    7H43 B 1
    7H43 B 0 A_ReFire(1)
    goto FireHEnd
    7H43 K 2 Offset(71, 36) A_GiveInventory("S_Lim_FireHold_P3")
    7H43 B 1
    7H43 B 0 A_ReFire(1)
    goto FireHEnd
    7H43 L 2 Offset(63, 44) A_GiveInventory("S_Lim_FireHold_P2")
    7H43 B 1
    7H43 B 0 A_ReFire("FireH1")
    goto FireHEnd

   FireHEnd:
    7H43 B 1 Offset(44, 32)
    7H43 B 1 Offset(40, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 1 Offset(35, 19)
    7H43 A 1 Offset(27, 22) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 0 A_TakeInventory("PowerLimFiringSlow")
    7H43 A 1 Offset(18, 25) ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed, 1, 1)  // A_TakeInventory("PowerLimFiringSlow")
    7H43 A 1 Offset(13, 27) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 2 Offset(7, 29)
    goto Ready2

   BotFire:
    7H43 A 0 A_JumpIfInventory("DireEnergyAmmo", 300, "BotFire2")
    7H43 A 0 A_Jump(32, "BotFire2")
    7H43 A 0 A_Jump(24, "BotFireX")
    7H43 A 4 A_GiveInventory("S_Lim_Fire_P")
    7H43 B 2 A_GiveInventory("DireEnergyAmmo", random(5, 15))
    7H43 B 0 A_Jump(64, 2)
    7H43 B 0 A_ReFire("BotFireH")
    7H43 BAAA 2
    goto Ready2
   BotFireH:
    7H43 K 1 A_GiveInventory("S_Lim_FireHold_P")
    7H43 B random(1, 2)
    7H43 L 1 A_GiveInventory("S_Lim_FireHold_P")
    7H43 B random(1, 2)
    7H43 B 0 A_Jump(8, "FireHEnd")
    7H43 B 0 A_Jump(2, "BotFireX")
    7H43 B 0 A_ReFire("BotFireH")
    goto FireHEnd
   BotFire2:
    7H43 A 0 A_JumpIfCloser(256, "AltFire")
    7H43 A 0 A_Jump(128, "AltFire")
    goto BotFire+2
   BotFireX:
    7H43 A 0 A_PlaySoundEx("classes/taunt/lim", "Voice")
    7H43 A 0 A_ChangeVelocity(10, 0, 0, 1)  // A_GiveInventory("RageUnitBotSpeed",1)
    7H43 A 0 A_GiveInventory("DireEnergyAmmo", random(50, 150))
    7H43 A 0 A_JumpIfInventory("DireEnergyAmmo", 300, "BotFire2")
    goto BotFire+3

   Flash:
    TNT1 A 1 ACS_NamedExecuteAlways("uc_LimHealth")
    loop

   AltFire:
    7H43 A 0 A_GiveInventory("Lim_AltStart_P")
    7H43 A 0 A_ReFire(1)
    7H43 A 1 Offset(21, 48)
    7H43 A 1 Offset(4, 55) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 B 1 Offset(-14, 62)
    7H43 B 1 Offset(-9, 56) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 B 1 Offset(-3, 49)
    7H43 B 1 Offset(-8, 52) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 C 1 Offset(-13, 55)
    7H43 C 1 Offset(-8, 41) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 C 22 Offset(-2, 27)
    7H43 C 0 A_TakeInventory("BasicArmor")
    goto AltCheck
   AltCheck:
    7H43 D 2 Offset(-2, 27) A_GiveInventory("S_Lim_AltFlash_P")
    7H43 E 2 Offset(-2, 27) ACS_NamedExecuteWithResult("core_weaponcolor", LIM_SDYE, 1)
    7H43 C 0 A_JumpIfInventory("VivifyCycle1", 31, 2)
    7H43 C 0 A_JumpIfInventory("DireEnergyAmmo", 30, "AltCheck")
    7H43 C 2 Offset(-2, 27)
    7H43 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    7H43 C 10 Offset(-2, 27) A_TakeInventory("VivifyCycle1")
    7H43 B 1 Offset(8, 32)
    7H43 B 1 Offset(14, 28) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 1 Offset(20, 23)
    7H43 A 1 Offset(14, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H43 A 2 Offset(8, 28)
    goto Ready1
  }
}

actor S_Lim_Fire_P : Lim_Fire_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_LimMirrorSwipe", 0, 0, 0, 0)
    goto End
  }
}

actor S_Lim_FireHold_P : Lim_FireHold_P {
  States {
   Pickup:
    TNT1 A 0 A_Jump(256, "P1", "P2", "P3")
   P1:
    TNT1 A 0 A_FireCustomMissile("S_LimMirrorShot", random(3, 8), 0, 8 + random(-8, -16), random(-3, 3), 1, random(-3, 3))
    goto Snd
   P2:
    TNT1 A 0 A_FireCustomMissile("S_LimMirrorShot", random(-1, 1), 0, 8 + random(-4, 4), random(-3, 3), 1, random(-1, 1))
    goto Snd
   P3:
    TNT1 A 0 A_FireCustomMissile("S_LimMirrorShot", random(-8, -3), 0, 8 + random(8, 16), random(-3, 3), 1, random(-3, 3))
    goto Snd
  }
}
actor S_Lim_FireHold_P1 : S_Lim_FireHold_P {States {Pickup: goto P1}}
actor S_Lim_FireHold_P2 : S_Lim_FireHold_P {States {Pickup: goto P2}}
actor S_Lim_FireHold_P3 : S_Lim_FireHold_P {States {Pickup: goto P3}}

actor S_Lim_AltFlash_P : Lim_AltFlash_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", LIM_SDYE2, 1)
    TNT1 A 0 A_FireCustomMissile("S_LimAltFlash", 0, 0, 16, 14)
    goto End
  }
}


actor S_LimMirrorSwipe : LimMirrorSwipe {
  Args 248, 96, 32  // 165
}

actor S_LimMirrorShot : LimMirrorShot {
  // Translation "192:192=197:197","198:198=220:220"
  // Translation "192:192=197:197","4:4=220:220"
  Translation "4:4=196:196", "192:192=197:197", "198:198=220:220"
  Damage (random(66, 80))  // 44,53
}

actor S_LimAltFlash : LimAltFlash {
  Args 300, 416, 24  // 200,416,24
}

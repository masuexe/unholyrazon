actor Slugger : CustWepClassBase {
  Player.ScoreIcon "UMUG_21"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Slugger"
  Player.SoundClass "Slugger"
  Player.MaxHealth 750
  Health 750
  Player.ForwardMove 1.00, 1.00
  Player.SideMove 1.00, 1.00
  Player.JumpZ 14
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "SluggerPistol_W"
  Player.StartItem "SluggerCrateAmmo", 155
  // Player.StartItem "SluggerHeavyMachineGun_W"
  // Player.StartItem "SluggerRocketLauncher_W"
  // Player.StartItem "SluggerShotgun_W"
  // Player.StartItem "SluggerZantetsuSword_W"

  Player.WeaponSlot 1, "SluggerPistol_W"
  Player.WeaponSlot 2, "SluggerHeavyMachineGun_W"
  Player.WeaponSlot 3, "SluggerRocketLauncher_W"
  Player.WeaponSlot 4, "SluggerShotgun_W"
  Player.WeaponSlot 5, "SluggerZantetsuSword_W"
  Player.WeaponSlot 6, "SluggerFlameShot_W"
  Player.WeaponSlot 7, "SluggerEnemyChaser_W"
  Player.WeaponSlot 8, "SluggerDropShot_W"
  Player.WeaponSlot 9, "SluggerTwoMachineGuns_W"
  States {
   Spawn:
    SJ01 A 0
    SJ01 B 1
    SJ01 A 1
    goto Spawn+2
   See:
    SJ01 BCDE 5
    goto Spawn
   Missile:
    SJ01 FFFFF 1
    SJ01 GGGG 1
    goto Spawn+2
   ClassPain:
    SJ01 H 0
    goto MegamanPain

   ClassDeath:
    SJ01 H 0
    goto MegamanDeath
   MegamanDeath0:
    SJ01 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SJ01 H 0 A_PlaySoundEx("*death", 2)
    SJ01 H 0 A_ChangeFlag(NOGRAVITY, 1)
    SJ01 H 0 A_ChangeVelocity(-7, 0, 8, 3)
    SJ01 H 0 A_SpawnItemEx("Slugger_MetalSlugDeath", 0, 0, 0, -4, 0, 3, 0, 1)
    TNT1 A 18
    TNT1 A 1 A_ChangeFlag(NOGRAVITY, 0)
    goto MegamanErase
   MegamanDisintegrate:
    SJ01 Z 0 A_SpawnItemEx("Corpse_21", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor SluggerShiny : Slugger {
  Player.ScoreIcon "UMUG_S21"
  Player.MaxHealth 3300
  Health 3300
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 11
  Player.MorphWeapon "SluggerShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    SJ01 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SJ01 H 0 A_PlaySoundEx("*death", 2)
    SJ01 H 0 A_ChangeFlag(NOGRAVITY, 1)
    SJ01 H 0 A_ChangeVelocity(-7, 0, 8, 3)
    SJ01 H 0 A_SpawnItemEx("S_Slugger_MetalSlugDeath", 0, 0, 0, -4, 0, 3, 0, 1)
    TNT1 A 18
    TNT1 A 1 A_ChangeFlag(NOGRAVITY, 0)
    goto MegamanErase
  }
}


actor Slugger_MetalSlugDeath : BasicExplosion {
  DamageType "Slugger"
  Obituary "$OB_21D"
  Speed 40
  Scale 2.5
  // 250,400
  Args 21, 27, 96, 32
  States {
   Spawn:
    SJ01 H 0 A_FadeOut(0.075)
    SJ01 HH 0 A_SpawnItemEx("SluggerRocketShotFX", random(-40, 40), random(-40, 40), random(8, 48), 0, 0, 0, 0, 1)
    SJ01 H 1 A_Explode(random(args[0], args[1]), args[2], 0, 0, args[3])
    SJ01 HH 0 A_SpawnItemEx("SluggerRocketShotFX", random(-40, 40), random(-40, 40), random(8, 48), 0, 0, 0, 0, 1)
    SJ01 H 1 A_Explode(random(args[0], args[1]), args[2], 0, 0, args[3])
    loop
  }
}
actor S_Slugger_MetalSlugDeath : Slugger_MetalSlugDeath {
  Args 32, 41, 96, 32
}


actor Corpse_21 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_21_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_1", 0, 0, 32, velx + random(-1, 3), vely + frandom(-1, 1), velz + frandom(2, 6), random(-2, 2), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_3", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_21_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_21_0 : BaseCorpseFX {States {Spawn: 1H21 O 350
    goto Spawn2}}
actor Corpse_21_1 : BaseCorpseFX {States {Spawn: 1H21 P 350
    goto Spawn2}}
actor Corpse_21_2 : BaseCorpseFX {States {Spawn: 1H21 Q 350
    goto Spawn2}}
actor Corpse_21_3 : BaseCorpseFX {States {Spawn: 1H21 R 350
    goto Spawn2}}
actor Corpse_21_4 : BaseCorpseFX {States {Spawn: 1H21 S 350
    goto Spawn2}}
actor Corpse_21_5 : BaseCorpseFX {States {Spawn: 1H21 T 350
    goto Spawn2}}
actor Corpse_21_6 : BaseCorpseFX {States {Spawn: 1H21 U 350
    goto Spawn2}}

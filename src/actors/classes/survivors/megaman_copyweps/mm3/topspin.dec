actor TopSpinWepU_MegaManUBar : MegaManUBar { Args 52, 93 }
actor TopSpinWepU : BaseMegaManUWep replaces TopSpinWep
{
Weapon.AmmoUse 4
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_TOPSPIN"
Tag "$TAG_TOPSPIN"
Obituary "$OB_TOPSPIN"
weapon.ammotype "TopSpinAmmo"
inventory.icon "TOPSI"
States
{
SpawnLoop:
WEAP J -1
loop
Ready:
TOPH A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_TOPSPIN)
TOPH A 0 A_TakeInventory("SpinTime")
ReadyReal:
TOPH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
TOPH A 1 A_WeaponReady
Goto Ready+2
Deselect:
TOPH A 0 A_GunFlash("NoFlash")
goto DeselectSwap
Select:
TOPH A 0
goto SelectSwap
Fire:
TOPH A 0 A_JumpIfInventory("SpinTime",1,"SpinEnd")
TOPH A 0 A_JumpIfInventory("IsBot", 1, "BotCheck")
TOPH A 0 A_JumpIfNoAmmo("NoAmmo")
TOPH A 0 A_JumpIf(!CallACS("core_CheckFooting"),"SpinBegin")
goto ReadyReal
SpinBegin:
TNT1 A 0 A_GiveInventory("TakeTopSpinAmmo") //sync >_>
TOPH A 0 A_TakeInventory("JumpCancler")
TOPH A 0 A_GunFlash //A_PlaySoundEx("weapons/mm3/topspinfire","Weapon")
SpinLoop:
TOPH A 0 A_GiveInventory("SpinTime")
TOPH A 0 A_SpawnItemEx("TopRadiusU",8,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
TOPH A 0 A_JumpIfInventory("CutterFlag",999,"Ready")
//TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"),"SpinEnd")
TNT1 A 1 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"),"SpinEnd")
TOPH A 0 A_JumpIfInventory("EndSpin",1,"SpinEnd")
loop
SpinEnd:
TOPH A 0 A_GunFlash("NoFlash")
TNT1 A 0 A_TakeInventory("TopSpinFlag")
TOPH A 0 A_TakeInventory("SpinTime")
TOPH A 0 A_TakeInventory("EndSpin")
TOPH A 0 A_StopSound(CHAN_WEAPON)
TOPH A 1 //ACS_NamedExecuteAlways("uh_MegaManUNoAmmo",0)
TOPH A 0 A_TakeInventory("CutterFlag")
//TOPH A 0 A_Refire
Goto Ready+1
BotCheck:
TOPH A 0 A_JumpIf(momz==0, 1)
Goto Fire+3
TOPH A 0 ThrustThingZ(0,50,0,1)
Goto Fire+3
Flash:
TNT1 A 0 A_PlaySoundEx("weapons/mm3/topspinfire","Weapon")
TOPH BBCCDDEE 1 A_GiveInventory("TopSpin_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_P")
TNT1 A 0 A_GiveInventory("EndSpin")
NoFlash:
TNT1 A 0
stop

AltFlash:
TNT1 A 0 A_PlaySoundEx("weapons/mm3/topspinfire","Weapon")
TOPH FFGGHHII 1 A_GiveInventory("TopSpin_Alt_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_Alt_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_Alt_P")
TNT1 AAAAAAAAAAA 1 A_GiveInventory("TopSpin_Alt_P")
TNT1 A 0 A_GiveInventory("EndSpin")
goto NoFlash
}
}

actor TopSpin_P : CustomInventory {
    States {
        Pickup:
            TNT1 A 0 A_SetAngle(angle - 20.0)
            TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ATTACK, "TakeAmmo")
            stop
        TakeAmmo:
            TNT1 A 0 A_TakeInventory("TopSpinAmmo", 1, TIF_NOTAKEINFINITE)
            stop
    }
}
actor TopSpin_Alt_P : TopSpin_P {
    States {
        Pickup:
            TNT1 A 0 A_SetAngle(angle + 20.0)
            TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "TakeAmmo")
            stop
    }
}

actor TopRadiusU : TopRadius
{
damagetype "TopSpin"
Obituary "$OB_TOPSPIN"
States
{
Spawn:
TNT1 A 0
TOPS A 2 A_Explode(CallACS("uh_TodayDmgMul", 150),90,0)
stop
}
}

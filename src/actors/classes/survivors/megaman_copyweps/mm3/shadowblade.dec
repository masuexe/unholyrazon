actor ShadowBladeWepU_MegaManUBar : MegaManUBar {Args 34, 239}
actor ShadowBladeWepU : BaseMegaManUWep replaces ShadowBladeWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_SHADOWBLADE"
  Obituary "$OB_SHADOWBLADE"
  Tag "$TAG_SHADOWBLADE"
  Weapon.AmmoType "ShadowBladeAmmo"
  Inventory.Icon "SHADI"
  States {
   SpawnLoop:
    WEAP A -1
    loop
   Ready:
    BUSH A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_SHADOWBLADE)
    BUSH A 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    BUSH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BUSH A 1 A_WeaponReady
    Goto Ready+2
   ReadyNoAmmo:
    BUS2 D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BUS2 D 1 A_WeaponReady(WRF_NOFIRE)
    BUS2 D 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto Ready+1
   Deselect:
    BUSH A 0
    goto DeselectSwap
   Select:
    BUSH A 0
    goto SelectSwap
   Fire:
    BUSH A 0 A_JumpIfNoAmmo("NoAmmo")
    BUSH A 0 A_PlaySoundEx("weapons/mm3/shadowbladefire", "Weapon")
    BUSH A 0 A_FireCustomMissile("ShadowBladeU", 0, 1, 8, 0)
    BUSH BCDEFG 2
    TNT1 A 4
    BUSH H 0 A_JumpIfNoAmmo("NoAmmoDelay")
    BUSH HI 1
    BUSH A 2
    BUSH A 0 A_ReFire
    Goto Ready+1
   NoAmmoDelay:
    BUS2 IJ 1
    BUS2 D 2
    Goto ReadyNoAmmo
   NoAmmo:
    BUS2 D 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo", 0)
    Goto ReadyNoAmmo
  }
}


actor ShadowBladeU : ShadowBlade {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

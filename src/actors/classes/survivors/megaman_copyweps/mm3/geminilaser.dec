actor GeminiLaserWepU_MegaManUBar : MegaManUBar {Args 4, 197}
actor GeminiLaserWepU : BaseMegaManUWep replaces GeminiLaserWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_GEMINILASER"
  Obituary "$OB_GEMINILASER"
  Tag "$TAG_GEMINILASER"
  Weapon.AmmoType "GeminiLaserAmmo"
  Inventory.Icon "GEMISI"
  States {
   SpawnLoop:
    WEAP M -1
    loop
   Ready:
    BLIZ D 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_GEMINILASER)
    goto ReadyX
   ReadyX:
    BLIZ D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BLIZ D 1 A_WeaponReady
    loop
   Deselect:
    BLIZ D 0
    goto DeselectSwap
   Select:
    BLIZ D 0
    goto SelectSwap
   Fire:
    BLIZ D 0 A_JumpIfNoAmmo("NoAmmo")
    BLIZ D 0 A_PlaySoundEx("weapons/mm3/geminilaserfire", "Weapon")
    BLIZ D 0 A_FireCustomMissile("GeminiLaserShooterU", 0, 1, 8, 0)
    BLIZ EF 4
    BLIZ D 14
    BLIZ D 0 A_ReFire
    goto ReadyX
  }
}

actor GeminiLaserShooterU : GeminiLaserShooter {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteWithResult("core_SetVelPitch", 0, 0)
    TNT1 A 1 A_CustomMissile("GeminiLaserFastU", 0, 0, 0, CMF_AIMDIRECTION | CMF_SAVEPITCH, pitch)
    stop
  }
}

actor GeminiLaserFastU : GeminiLaserFast {
  Damage (CallACS("uh_TodayDmgMul", 300))
  States {
   Death:
    GEMI A 0 A_SpawnItemEx("GeminiLaserRicochetU", -velx, -vely, -velz, 0, 0, 0, 0, SXF_ABSOLUTEPOSITION | SXF_TRANSFERPITCH)
    stop
  }
}

actor GeminiLaserRicochetU : GeminiLaserShooter {
  States {
   Spawn:
    GEMI AA 0 A_CustomMissile("GeminiLaserU", 0, 0, 0, CMF_AIMDIRECTION, pitch)
    stop
  }
}

actor GeminiLaserU : GeminiLaser {
  Damage (CallACS("uh_TodayDmgMul", 300))
}

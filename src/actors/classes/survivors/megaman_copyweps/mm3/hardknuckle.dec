actor HardKnuckleWepU_MegaManUBar : MegaManUBar {Args 87, 199}
actor HardKnuckleWepU : BaseMegaManUWep replaces HardKnuckleWep {
  Weapon.AmmoUse 4
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_HARDKNUCKLE"
  Obituary "$OB_HARDKNUCKLE"
  Tag "$TAG_HARDKNUCKLE"
  Weapon.AmmoType "HardKnuckleAmmo"
  Inventory.Icon "HARDSI"
  States {
   SpawnLoop:
    WEAP T -1
    loop
   Ready:
    FIST Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_HARDKNUCKLE)
    goto ReadyX
   ReadyX:
    FIST Q 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    FIST Q 1 A_WeaponReady
    loop
   Deselect:
    FIST Q 0
    goto DeselectSwap
   Select:
    FIST Q 0
    goto SelectSwap
   Fire:
    FIST Q 0 A_JumpIfNoAmmo("NoAmmo")
    FIST F 0 A_PlaySoundEx("weapons/mm3/hardknucklewindup", "Weapon")
    FIST B 2 A_SpawnItemEx("HardKnuckleFX", -1, 8, 32, 0, 0, 0)
    FIST CDE 2
    FIST F 0 A_PlaySoundEx("weapons/mm3/hardknucklelaunch", "Weapon")
    FIST B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, true, 0)
    FIST F 2 A_FireCustomMissile("HardKnuckleU", 0, 1, 10, -2)
    // FIST F 0 A_ChangeVelocity(-cos(pitch)*9, 0, sin(pitch)*5,CVF_RELATIVE)
    FIST F 0 ACS_NamedExecuteWithResult("core_dashRecoil", 9)
    FIST GGGHI 2
    TNT1 A 2 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, false, 0)
    FIST KLMNOP 2
    FIST Q 0 A_ReFire
    goto ReadyX
  }
}

actor HardKnuckleU : HardKnuckle {
  Damage (CallACS("uh_TodayDmgMul", 700))
}

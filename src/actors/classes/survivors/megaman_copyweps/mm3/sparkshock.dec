actor SparkShockWepU_MegaManUBar : MegaManUBar {Args 4, 225}
actor SparkShockWepU_ScriptBar : ScriptBar {}

actor SparkShockWepU : BaseMegaManUWep replaces SparkShockWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_SPARKSHOCK"
  Obituary "$OB_SPARKSHOCK"
  Tag "$TAG_SPARKSHOCK"
  Weapon.AmmoType "SparkShockAmmo"
  Inventory.Icon "SPARSI"
  States {
   SpawnLoop:
    WEA2 G -1
    loop
   Ready:
    SPAS C 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_SPARKSHOCK)
    SPAS C 0 A_JumpIfInventory("SparkShockCooldownFlag", 1, "ReadyCooldown")
    SPAS C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    SPAS C 1 A_WeaponReady
    Goto Ready+1
   ReadyCooldown:
    SPAS C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    SPAS C 1 A_WeaponReady(WRF_NOFIRE)
    Goto Ready+1
   Deselect:
    SPAS C 0
    goto DeselectSwap
   Select:
    SPAS C 0
    goto SelectSwap
   Fire:
    SPAS C 0 A_JumpIfNoAmmo("NoAmmo")
    SPAS C 0 A_PlaySoundEx("weapons/mm3/sparkshockfire", "Weapon")
    SPAS C 0 A_FireCustomMissile("SparkShockU", 0, 1, 8, 0)
    SPAS ED 2
    SPAS D 0 A_GiveInventory("SparkShockCooldownFlag")
    SPAS D 0 A_SpawnItemEx("SparkShockCooldowner")
    SPAS DDDDDDDD 1 A_WeaponReady(WRF_NOFIRE)
    Goto Ready+1
  }
}

actor SparkShockU : SparkShock {
  Damage (CallACS("uh_TodayDmgMul", 1))
  States {
   Crash:
    SPAS A 0 A_SpawnItemEx("SparkShockExplodeU")
   Death:
    SPAS A 0 A_SpawnItemEx("ElectrifyEffect")
    stop
  }
}

// yes this sucks
actor SparkShockExplodeU : BasicGraphicEffect {
  Scale 3.6
  States {
   SpawnFrame:
    TNT1 A 0
    SPAS AHIJ 1
    stop
  }
}

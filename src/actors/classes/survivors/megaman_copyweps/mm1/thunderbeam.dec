actor ThunderBeamWepU_MegaManUBar : MegaManUBar { Args 215, 94 }
actor ThunderBeamWepU : BaseMegaManUWep replaces ThunderBeamWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_THUNDERBEAM"
Obituary "$OB_THUNDERBEAM"
Tag "$TAG_THUNDERBEAM"
weapon.ammotype "ThunderBeamAmmo"
inventory.icon "THUNSI"
States
{
SpawnLoop:
WEAP R -1
loop
Ready:
THUN H 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_THUNDERBEAM)
goto ReadyX
Deselect:
THUN H 0
goto DeselectSwap
Select:
THUN H 0
goto SelectSwap
Fire:
THUN H 0 A_JumpIfNoAmmo("NoAmmo")
THUN H 0 A_PlaySoundEx("weapons/mm1/thunderbeamfire","Weapon")
THUN H 0 A_GiveInventory("FireThunderBeamU", 1) // SpreadRune
THUN H 0 A_TakeInventory("ThunderBeamAmmo",1,TIF_NOTAKEINFINITE)
THUN HJI 3
THUN H 15
THUN H 0 A_Refire
Goto ReadyX
}
}

actor FireThunderBeamU : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",0,8,32,cos(pitch)*30,0,sin(-pitch)*30,0)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*8,0,32,cos(pitch)*30,0,sin(-pitch)*30,-90)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*-8,0,32,cos(pitch)*30,0,sin(-pitch)*30,90)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",0,-24,32,cos(pitch)*30,0,sin(-pitch)*30,0)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",0,40,32,cos(pitch)*30,0,sin(-pitch)*30,0)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*8,-32,32,cos(pitch)*30,0,sin(-pitch)*30,-90)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*8,32,32,cos(pitch)*30,0,sin(-pitch)*30,-90)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*-8,-32,32,cos(pitch)*30,0,sin(-pitch)*30,90)
        TNT1 A 0 A_SpawnItemEx("ThunderBeamU",cos(pitch)*-8,32,32,cos(pitch)*30,0,sin(-pitch)*30,90)
        stop
    }
}

actor ThunderBeamU : ThunderBeam
{
damage (CallACS("uh_TodayDmgMul", 170))
}

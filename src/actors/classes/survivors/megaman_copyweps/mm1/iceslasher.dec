actor IceSlasherWepU_MegaManUBar : MegaManUBar { Args 4, 75 }
actor IceSlasherWepU : BaseMegaManUWep replaces IceSlasherWep
{
//$Category MM8BDM-Weapons/Rapid
//$Title Ice Slasher
//$Sprite WEAPP0
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 3
Inventory.Pickupmessage "$PU_ICESLASHER"
Obituary "$OB_ICESLASHER"
Tag "$TAG_ICESLASHER"
weapon.ammotype "IceSlasherAmmo"
inventory.icon "ICESI"
States
{
SpawnLoop:
WEAP P -1
loop
Ready:
ICES D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_ICESLASHER)
goto ReadyX
Deselect:
ICES D 0
goto DeselectSwap
Select:
ICES D 0
goto SelectSwap
Fire:
ICES D 0 A_JumpIfNoAmmo("NoAmmo")
ICES D 0 A_PlaySoundEx("weapons/mm1/iceslasherfire","Weapon")
ICES D 0 A_FireCustomMissile("IceSlasherU",0,1,8,0)
ICES FED 3
ICES D 0 A_Refire
Goto ReadyX
}
}

actor IceSlasherU : IceSlasher
{
damage (CallACS("uh_TodayDmgMul", 150))
}

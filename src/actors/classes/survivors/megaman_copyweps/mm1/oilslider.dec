actor OilSliderWepU_MegaManUBar : MegaManUBar {Args 68, 47}
actor OilSliderWepU_ScriptBar : ScriptBar {}

actor OilSliderWepU : BaseMegaManUWep replaces OilSliderWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_OILSLIDER"
  Obituary "$OB_OILSLIDER"
  Tag "$TAG_OILSLIDER"
  Weapon.AmmoType "OilSliderAmmo"
  Inventory.Icon "OILLI"
  States {
   SpawnLoop:
    WEA7 J -1
    loop
   Ready:
    OILL A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_OILSLIDER)
    OILL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    OILL A 1 A_WeaponReady
    goto Ready+1
   Deselect:
    OILL A 0
    goto DeselectSwap
   Select:
    OILL A 0
    goto SelectSwap
   Fire:
    OILL A 0 A_JumpIfInventory("UH_OilRiding_F", 1, "OilPogo")
   FireShot:
    OILL A 0 A_JumpIfNoAmmo("NoAmmo")
    OILL A 0 A_PlaySoundEx("weapons/mm1/oilsliderfire", "Weapon")
    OILL A 0 A_FireCustomMissile("OilShotU", 0, 1, 8, 0)
    OILL BCA 5
    OILL A 0 A_ReFire
    goto Ready+1
   AltFire:
    // The core AltFire redirects to Fire; bypass its M1-only dismount check.
    OILL A 1 A_JumpIfInventory("MM8BDMPlayer", 1, "FireShot")
    goto NoAmmo
   OilPogo:
    // Match v6b: keep horizontal momentum and jump off at the player's JumpZ.
    OILL A 0 A_ChangeVelocity(velx, vely, CallACS("core_getactorproperty", 0, APROP_JumpZ, DATATYPE_RAW) / 65536.0, CVF_REPLACE)
    OILL A 0 A_GiveInventory("OilSliderDismountU_P")
    OILL A 10
    goto Ready+1
  }
}

actor OilShotU : BasicProjectile {
  +FORCEXYBILLBOARD
  Damage (CallACS("uh_TodayDmgMul", 270))
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  Height 5
  Radius 8
  -NOGRAVITY
  Scale 2.0
  Speed 28
  States {
   Spawn:
    OILL D 0
    OILL D 5 A_CheckFloor("Death")
    loop
   Crash:
   XDeath:
    OILL D 1
    stop
   Death:
    OILL D 0
    OILL D 0 A_JumpIf(z - floorz <= 0, "Death2")
    OILL D 1 A_GiveInventory("CutterFlag", 1)
    OILL D 0 A_JumpIfInventory("CutterFlag", 175, "XDeath")
    loop
   Death2:
    OILL D 1 A_SpawnItemEx("OilBlobU", 0, 0, 0)
    stop
  }
}

actor OilBlobU : ProjSpawnFuncActor {
  +MISSILE
  +NODAMAGETHRUST
  +NOBLOOD
  +DONTSPLASH
  +NOEXPLODEFLOOR
  +NOTARGETSWITCH
  +NOTAUTOAIMED
  +DONTDRAIN
  +HITTRACER
  Damage (CallACS("uh_TodayDmgMul", 130))
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  Height 10
  Radius 8
  Scale 2.5
  mass 99999
  ReactionTime 250
  painchance 256
  damagefactor "Ignition", 1.0
  States {
   Spawn:
    OILL G 0
    OILL G 1
    OILL G 0 A_JumpIf(ACS_NamedExecuteWithResult("core_checkPitByType", MOD_LAVA), "pain.Ignition")
    OILL G 0 A_ChangeFlag("SHOOTABLE", 1)
    goto Spawn2
   pain.Ignition:
    OILL E 0
    OILL E 0 A_ChangeFlag("NOPAIN", true)
    OILL E 1 A_SpawnItemEx("OilBlobFlameU", 0, 0, 0)
    OILL E 0 A_Jump(256, "Death")
    stop
   Spawn2:
    OILL G 1 A_Stop
    goto SlideWait
   SlideWait:
    // Owners and teammates board without a collision or impact damage.
    OILL E 1 A_JumpIf(CallACS("uh_OilBlobFindFriendlyRider"), "Slide")
    OILL E 0 A_GiveInventory("CutterFlag", 1)
    OILL E 0 A_JumpIf(z - floorz > 0, "NewShot")
    OILL E 0 A_JumpIfInventory("CutterFlag", 175, "Death")
    loop
   Crash:
   XDeath:
    // Missile impact damage has already been applied before this state.
    OILL E 0 A_JumpIf(!CallACS("uh_istracerplayer"), "Death")
    OILL E 0 A_RearrangePointers(AAPTR_TRACER, AAPTR_DEFAULT, AAPTR_DEFAULT)
   Slide:
    OILL A 0 A_GiveToTarget("OilSliderMountU_P")
    stop
   NewShot:
    OILL E 0 A_SpawnItemEx("OilShotU", 0, 0, 0, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    goto Death
   Death:
    TNT1 A 0
    stop
  }
}

actor OilBlobFlameU : OilBlobFlame {
  Damage (CallACS("uh_TodayDmgMul", 470))
}

actor OilSliderU : OilSlider {
  +RIPPER
  +DONTBLAST
  +NOCLIP
  +NOINTERACTION
  Radius 8
  Height 16
  Damage (0)
  DamageType "OilSlider"
  Speed 20
  States {
   Spawn:
    OILL F 0
    OILL F 0 A_SpawnItemEx("SliderDamagerU", 0, 0, 8)
    OILL F 5
    stop
  }
}

actor SliderDamagerU : SliderDamager {
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 210), 80, 0)
    stop
  }
}

// Riding belongs to the player, so any class can use the oil and switch weapons.
actor UH_OilRiding_F : Inventory {Inventory.MaxAmount 1}

actor OilSliderMountU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(health <= 0, "Done")
    TNT1 A 0 A_JumpIfInventory("UH_OilRiding_F", 1, "Refuel")
    TNT1 A 0 A_GiveInventory("UH_OilRiding_F")
    TNT1 A 0 A_GiveInventory("OilSliderFlag", 30)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_stopplayer", 0, 1)
    TNT1 A 0 A_GiveInventory("OilSliderBoardU_P")
    TNT1 A 0 A_SpawnItemEx("OilSliderWatcherU")
    stop
   Refuel:
    // Six fuel units are 30 tics, matching Razon 3's refuel amount.
    TNT1 A 0 A_GiveInventory("OilSliderFlag", 6)
    stop
   Done:
    TNT1 A 0
    stop
  }
}

actor OilSliderWatcherU : BasicWatcher {
  var int user_tick;
  var int user_soundtick;
  States {
   Spawn:
    TNT1 A 0
   RideTick:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsPlayerAliveByPointer", AAPTR_TARGET), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("OilSliderFlag", 1, "RideContinue")
    goto Death
   RideContinue:
    // Sound channels belong to this watcher, independently of the rider's.
    TNT1 A 0 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
    TNT1 A 0 A_JumpIf(user_soundtick != 0, "RideMotion")
    TNT1 A 0 A_PlaySound("weapons/mm1/oilsliderslide", CHAN_BODY)
   RideMotion:
    TNT1 A 0 A_SetUserVar("user_soundtick", (user_soundtick + 1) % 8)
    TNT1 A 0 A_GiveToTarget("OilSliderRideTickU_P")
    TNT1 A 0 A_SetUserVar("user_tick", user_tick + 1)
    TNT1 A 0 A_JumpIf(user_tick < 5, "RideWait")
    TNT1 A 0 A_SetUserVar("user_tick", 0)
    TNT1 A 0 A_TakeFromTarget("OilSliderFlag", 1)
    TNT1 A 0 A_GiveToTarget("OilSliderBoardU_P")
   RideWait:
    TNT1 A 1
    goto RideTick
   Death:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_OilSliderStopSound")
    TNT1 A 0 A_GiveToTarget("OilSliderDismountU_P")
    stop
  }
}

actor OilSliderRideTickU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "Ground")
    TNT1 A 0 A_Recoil(-1.4375)
    goto WaterCheck
   Ground:
    TNT1 A 0 A_Recoil(-2.875)
   WaterCheck:
    TNT1 A 0 A_JumpIfInventory("HasFeetInWater", 1, "Water")
    stop
   Water:
    TNT1 A 0 A_JumpIf(z - floorz <= 32, "Done")
    TNT1 A 0 A_JumpIf(velz <= 0, "WaterRise")
    TNT1 A 0 A_ChangeVelocity(0, 0, 0.7, CVF_RELATIVE)
    stop
   WaterRise:
    TNT1 A 0 ThrustThingZ(0, 2, 0, 0)
   Done:
    TNT1 A 0
    stop
  }
}

actor OilSliderBoardU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("OilSliderU", 24, 0, 2, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    stop
  }
}

actor OilSliderDismountU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UH_OilRiding_F", 1, "Cleanup")
    stop
   Cleanup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_OilSliderReset")
    stop
  }
}

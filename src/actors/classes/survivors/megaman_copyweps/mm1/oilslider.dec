actor OilSliderWepU_MegaManUBar : MegaManUBar {Args 68, 47}
actor OilSliderWepU_ScriptBar : ScriptBar {}

actor OilSliderWepU : BaseMegaManUWep replaces OilSliderWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_OILSLIDER"
  Obituary "$OB_OILSLIDER"
  Tag "$TAG_OILSLIDER"
  Weapon.AmmoType "OilSliderAmmo"
  Inventory.Icon "OILLI"
  States {
   SpawnLoop:
    WEA7 J -1
    loop
   Ready:
    OILL A 0 A_TakeInventory("OilSliderFlag", 1)
    OILL A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_OILSLIDER)
    OILL A 0 A_JumpIfInventory("OilSliderFlag", 1, "SlideBegin")
    OILL A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    OILL A 1 A_WeaponReady
    goto Ready+2
   Deselect:
    OILL A 0 A_TakeInventory("OilSliderFlag", 1)
    goto DeselectSwap
   Select:
    OILL A 0
    goto SelectSwap

   Fire:
    OILL A 0 A_JumpIfInventory("OilBoat", 1, "OilPogo")
    OILL A 0 A_JumpIfNoAmmo("NoAmmo")
    OILL A 0 A_PlaySoundEx("weapons/mm1/oilsliderfire", "Weapon")
    OILL A 0 A_FireCustomMissile("OilShotU", 0, 1, 8, 0)
    OILL BCA 5
    OILL A 0 A_JumpIfInventory("OilSliderFlag", 1, "SlideBegin")
    OILL A 0 A_ReFire
    goto Ready+2

   SlideBegin:
    OILL A 0 A_GiveInventory("OilSliderFlag", 30)
    OILL A 0 A_TakeInventory("OilSliderAmmo", 4, TIF_NOTAKEINFINITE)
    OILL A 0 A_GiveInventory("OilBoat")
    OILL A 0 A_GunFlash
    OILL A 0 A_JumpIfInventory("IsBot", 1, "BotSlide")  // If Player is Bot, change
    OILL A 0 A_GiveInventory("OilSliderFlightToggleOff")
    OILL A 0 A_SpawnItemEx("OilSliderU", 24, 0, 2, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    OILL AAAAA 1  // A_WeaponReady(WRF_NOSWITCH)
    OILL A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
    OILL A 0 A_JumpIfInventory("OilSliderFlag", 1, "Slide")
    goto SlideEnd

   Slide:
    OILL A 0 A_TakeInventory("OilSliderFlag", 1)
    OILL A 0 A_JumpIfInventory("HasFeetInWater", 1, "UnderWater")
    goto SlideContinue

   UnderWater:
    OILL A 0 A_JumpIf(z - floorz > 32, 1)
    goto SlideContinue
    OILL A 0 A_GiveInventory("OilSliderFlightToggleOn")
    OILL A 0 A_JumpIf(velz <= 0, 2)
    OILL A 0 ThrustThingZ(0, 7, 0, 1)
    goto SlideContinue+1
    OILL A 0 ThrustThingZ(0, 5, 0, 0)
    goto SlideContinue+1

   SlideContinue:
    OILL A 0 A_GiveInventory("OilSliderFlightToggleOff")
    OILL A 0 A_SpawnItemEx("OilSliderU", 24, 0, 2, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    OILL AAAAA 1 A_WeaponReady(WRF_NOSWITCH)
    OILL A 0 A_JumpIfInventory("OilSliderFlag", 1, "Slide")
    goto SlideEnd

   BotSlide:
    OILL A 0 A_SpawnItemEx("OilSliderU", 24, 0, 2, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    OILL AAAAA 1
    OILL A 0 A_PlaySoundEx("weapons/mm1/oilsliderslide", "Weapon")
    OILL A 0 A_GiveInventory("CutterFlag", 1)
    OILL A 0 A_TakeInventory("OilSliderFlag", 1)
    OILL A 0 A_JumpIfInventory("Cutterflag", 15, 1)
    loop
    OILL A 0 A_TakeInventory("Cutterflag")
    OILL A 0 A_Jump(224, "OilPogo")
    goto SlideEnd

   OilPogo:
    OILL A 0
    OILL A 0  // A_Recoil(5)
    OILL A 0 A_ChangeVelocity(velx, vely, CallACS("core_getactorproperty", 0, APROP_JumpZ, DATATYPE_RAW) / 65536.0, CVF_REPLACE)
    OILL A 0 A_Jump(256, "SlideEnd")
    goto SlideEnd

   SlideEnd:
    OILL A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    // OILL A 0 SetPlayerProperty(0,0,3)
    OILL A 0 A_GiveInventory("OilSliderFlightToggleOff")
    OILL A 0 A_StopSound(CHAN_WEAPON)
    OILL A 0 A_TakeInventory("OilSoundTime", 1)
    OILL A 0 A_TakeInventory("OilSliderFlag")
    OILL A 0 A_TakeInventory("OilBoat")
    OILL A 10
    goto Ready+2

   Flash:
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/oilsliderslide", "Weapon")
    TNT1 A 0 A_GiveInventory("OilSoundTime")
   FlashLoop:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "FlashGround")
    TNT1 A 0 A_Recoil(-2)
    goto FlashEnd
   FlashGround:
    TNT1 A 0 A_Recoil(-4)
   FlashEnd:
    TNT1 A 2
    TNT1 A 0 A_JumpIfInventory("OilSoundTime", 1, "FlashLoop")
    TNT1 A 0 A_JumpIfInventory("OilSliderFlag", 1, "Flash")
    TNT1 A 1
    stop
  }
}

actor OilShotU : BasicProjectile {
  +FORCEXYBILLBOARD
  Damage (CallACS("uh_TodayDmgMul", 270))
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  Height 5
  Radius 8
  -NOGRAVITY
  Scale 2.0
  Speed 28
  States {
   Spawn:
    OILL D 0
    OILL D 5 A_CheckFloor("Death")
    loop
   Crash:
   XDeath:
    OILL D 1
    stop
   Death:
    OILL D 0
    OILL D 0 A_JumpIf(z - floorz <= 0, "Death2")
    OILL D 1 A_GiveInventory("CutterFlag", 1)
    OILL D 0 A_JumpIfInventory("CutterFlag", 175, "XDeath")
    loop
   Death2:
    OILL D 1 A_SpawnItemEx("OilBlob", 0, 0, 0)
    stop
  }
}

actor OilBlobU : ProjSpawnFuncActor {
  +MISSILE
  +NODAMAGETHRUST
  +NOBLOOD
  +DONTSPLASH
  +NOEXPLODEFLOOR
  +NOTARGETSWITCH
  +NOTAUTOAIMED
  +DONTDRAIN
  Damage (CallACS("uh_TodayDmgMul", 130))
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  Height 10
  Radius 8
  Scale 2.5
  mass 99999
  ReactionTime 250
  painchance 256
  damagefactor "Ignition", 1.0
  States {
   Spawn:
    OILL G 0
    OILL G 1
    OILL G 0 A_JumpIf(ACS_NamedExecuteWithResult("core_checkPitByType", MOD_LAVA), "pain.Ignition")
    OILL G 0 A_ChangeFlag("SHOOTABLE", 1)
    goto Spawn2
   pain.Ignition:
    OILL E 0
    OILL E 0 A_ChangeFlag("NOPAIN", true)
    OILL E 1 A_SpawnItemEx("OilBlobFlameU", 0, 0, 0)
    OILL E 0 A_Jump(256, "Death")
    stop
   Spawn2:
    OILL G 1 A_Stop
    goto SlideWait
   SlideWait:
    OILL E 1 A_JumpIfCloser(40, "Slide")
    OILL E 0 A_GiveInventory("CutterFlag", 1)
    OILL E 0 A_JumpIf(z - floorz > 0, "NewShot")
    OILL E 0 A_JumpIfInventory("CutterFlag", 175, "Death")
    loop
   Slide:
    OILL E 0
    OILL E 0 A_JumpIfInTargetInventory("OilSliderFlag", 1, "Spawn2")
    OILL A 0 A_PlaySoundEx("weapons/mm1/oilsliderfire", "Weapon")
    TNT1 A 2 A_GiveToTarget("OilSliderFlag", 30)
    stop
   NewShot:
    OILL E 0 A_SpawnItemEx("OilShotU", 0, 0, 0, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    goto Death
   Death:
    TNT1 A 0
    stop
  }
}

actor OilBlobFlameU : OilBlobFlame {
  Damage (CallACS("uh_TodayDmgMul", 470))
}

actor OilSliderU : OilSlider {
  +RIPPER
  +DONTBLAST
  +NOCLIP
  +NOINTERACTION
  Radius 8
  Height 16
  Damage (0)
  DamageType "OilSlider"
  Speed 20
  States {
   Spawn:
    OILL F 0
    OILL F 0 A_SpawnItemEx("SliderDamagerU", 0, 0, 8)
    OILL F 5
    stop
  }
}

actor SliderDamagerU : SliderDamager {
  DamageType "OilSlider"
  Obituary "$OB_OILSLIDER"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 210), 80, 0)
    stop
  }
}

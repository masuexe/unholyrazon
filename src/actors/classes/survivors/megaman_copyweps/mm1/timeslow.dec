actor TimeSlowWepU_MegaManUBar : MegaManUBar {Args 34, 239}
actor TimeSlowWepU_ScriptBar : ScriptBar {}

actor TimeSlowWepU : BaseMegaManUWep replaces TimeSlowWep {
  // $Category MM8BDM-Weapons/AoE
  // $Title Time Slow
  // $Sprite SLOTX0
  Weapon.AmmoUse 14
  Weapon.AmmoGive 28
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_TIMESLOW"
  Obituary "$OB_TIMESLOW"
  Tag "$TAG_TIMESLOW"
  Weapon.AmmoType "TimeSlowAmmo"
  Inventory.Icon "TIMMI2"
  States {
   SpawnLoop:
    SLOT X -1
    loop
   Ready:
    TSLO A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_TIMESLOW)
    goto ReadyX
   ReadyX:
    TSLO A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    TSLO A 0 A_JumpIfInventory("TimeSlowCooldown", 1, "ReadyCooldown")
    TSLO A 1 A_WeaponReady
    loop
   ReadyCooldown:
    TSLO A 1 A_WeaponReady(WRF_NOFIRE)
    goto ReadyX
   Deselect:
    TSLO A 0
    goto DeselectSwap
   Select:
    TSLO A 0
    goto SelectSwap
   Fire:
    // With Hand
    TSLO A 0 A_JumpIfInventory("TimeSlowCooldown", 1, "NoAmmo")
    TSLO A 0 A_JumpIfNoAmmo("NoAmmo")
    SLOT J 0 A_ScaleVelocity(0.5)
    SLOT JKLMN 2
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/timeslowfire", "Weapon")
    TNT1 A 0 A_TakeInventory("TimeSlowAmmo", 14, TIF_NOTAKEINFINITE)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_whiteflash")
    TNT1 A 0 A_FireCustomMissile("TimeSlowU", 0, 0, 0, 0)
    TNT1 A 0 A_GiveInventory("TimeSlowCooldown")
    TNT1 A 0 A_SpawnItemEx("TimeSlowCooldowner")
    // SLOT LMN 3
    TNT1 A 2
    TSLO BCA 1
    goto ReadyX
  }
}

actor TimeSlowU : TimeSlow {
  damagetype "TimeSlow"
  Obituary "$OB_TIMESLOW"
  Scale 5.16
  +FORCEXYBILLBOARD
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 100), 370, 0, 0, 380)
    SLOD EFGHIJKLMNEFGHIJKLMN 1
    stop
  }
}

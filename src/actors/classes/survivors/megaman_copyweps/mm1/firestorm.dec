actor FireStormWepU_MegaManUBar : MegaManUBar {Args 229, 227}
actor FireStormWepU : BaseMegaManUWep replaces FireStormWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_FIRESTORM"
  Obituary "$OB_FIRESTORM"
  Tag "$TAG_FIRESTORM"
  Weapon.AmmoType "FireStormAmmo"
  Inventory.Icon "FIRESI"
  States {
   SpawnLoop:
    WEAP Y -1
    loop
   Ready:
    FIRE G 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_FIRESTORM)
    goto ReadyX
   ReadyX:
    FIRE G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    FIRE G 1 A_WeaponReady
    loop
   Deselect:
    FIRE G 0
    goto DeselectSwap
   Select:
    FIRE G 0
    goto SelectSwap
   Fire:
    FIRE H 0 A_JumpIfNoAmmo("NoAmmo")
    FIRE H 0 A_PlaySoundEx("weapons/mm1/firestormfire", "Weapon")
    FIRE H 0 A_FireCustomMissile("FireStormU", 0, 1, 8, 0)
    FIRE H 0 A_GunFlash
    FIRE H 5
    FIRE I 6
    FIRE G 5
    goto ReadyX
   Flash:
    FSFL A 0
    FSFL A 1
    FSFL Z 0 A_SpawnItemEx("FireShieldDamageU", 0, 0, 28)
    FSFL A 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL B 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 315, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL B 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 270, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL C 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 225, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 0 A_SpawnItemEx("FireShieldDamageU", 0, 0, 28)
    FSFL C 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 180, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL D 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 135, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL D 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 90, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 45, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 0 A_SpawnItemEx("FireShieldDamageU", 0, 0, 28)
    FSFL Z 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 315, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 270, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 225, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 0 A_SpawnItemEx("FireShieldDamageU", 0, 0, 28)
    FSFL Z 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 180, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield1", 64, 0, 34, velx, vely, velz, 135, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield3", 64, 0, 34, velx, vely, velz, 90, SXF_ABSOLUTEMOMENTUM, 0)
    FSFL Z 1 A_SpawnItemEx("FireShield2", 64, 0, 34, velx, vely, velz, 45, SXF_ABSOLUTEMOMENTUM, 0)
    stop
  }
}

actor FireStormU : FireStorm {
  Damage (CallACS("uh_TodayDmgMul", 270))
  States {
   Spawn:
    FIRE ABC 2
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    stop
  }
}

actor FireShieldDamageU : BasicExplosion {
  DamageType "FireSpin"
  Obituary "$OB_FIRESTORM"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 50), 80, 0, 0, 81)
    stop
  }
}

actor ThunderClawWepU_MegaManUBar : MegaManUBar { Args 192, 220 }
actor ThunderClawWepU : BaseMegaManUWep replaces ThunderClawWep
{
    Weapon.AmmoUse 2
    Weapon.AmmoGive 28
    Weapon.SlotNumber 4
    Inventory.Pickupmessage "$PU_THUNDERCLAW"
    Obituary "$OB_THUNDERCLAW"
    Tag "$TAG_THUNDERCLAW"
    weapon.ammotype "ThunderClawAmmo"
    inventory.icon "TCLAWI"
    States
    {
    SpawnLoop:
        WEA4 G -1 
        loop
    Ready:
        TCLD D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_THUNDERCLAW)
        goto ReadyX
    Deselect:
        TCLD D 0
        goto DeselectSwap
    Select:
        TCLD D 0
        goto SelectSwap
    Fire:
        TCLD D 0 A_JumpIfNoAmmo("NoAmmo")
        TCLD D 0 A_PlaySoundEx("weapons/mm8/thunderclawfire","Weapon")
        TCLD D 0 A_GiveInventory("FireThunderClawU", 1)
        TCLD EFFE 3
        TCLD D 10
        TCLD D 0 A_Refire
        Goto ReadyX
    NoAmmo:
        TCLD D 1 ACS_NamedExecuteAlways("core_noammo",0)
        Goto ReadyX
    }
}

actor FireThunderClawU : CustomInventory
{
    States
    {
    Pickup:
		TNT1 A 0 A_TakeInventory("ThunderClawAmmo", 2,TIF_NOTAKEINFINITE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawWatcherU", cos(-pitch)*16, 8, 32+(sin(-pitch)*16), 0, 0, 0, 0, SXF_TRANSFERPITCH)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("ThunderClawWatcherU", cos(-pitch)*16, 8, 32+(sin(-pitch)*16), 0, 0, 0, -20, SXF_TRANSFERPITCH)
        TNT1 A 0 A_SpawnItemEx("ThunderClawWatcherU", cos(-pitch)*16, 8, 32+(sin(-pitch)*16), 0, 0, 0, 20, SXF_TRANSFERPITCH)
        stop
    }
}

actor ThunderClawWatcherU : ThunderClawWatcher
{
    States
    {
    Spawn:
        TNT1 A 0
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager5U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager10U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager15U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager20U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager15U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager10U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        TCLA A 1 A_Warp(AAPTR_TARGET, cos(-pitch)*16,8,32+(sin(-pitch)*16), 0, WARPF_USECALLERANGLE)
        TNT1 A 0 A_SpawnItemEx("ThunderClawDamager5U", 0, 0, 0, cos(pitch), 0, sin(-pitch), 0, SXF_MULTIPLYSPEED)
        stop
    WindDown1:
        TNT1 A 0
        stop
    }
}

actor ThunderClawDamagerU : ThunderClawDamager
{
damage (300)
}

actor ThunderClawDamager5U : ThunderClawDamager { speed 54 }
actor ThunderClawDamager10U : ThunderClawDamager { speed 108 }
actor ThunderClawDamager15U : ThunderClawDamager { speed 162 }
actor ThunderClawDamager20U : ThunderClawDamager { speed 216 -DONTSPLASH }

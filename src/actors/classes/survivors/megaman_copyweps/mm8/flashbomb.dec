actor FlashBombWepU_MegaManUBar : MegaManUBar {Args 229, 77}
actor FlashBombWepU : BaseMegaManUWep replaces FlashBombWep {
  Weapon.AmmoUse 3
  Weapon.AmmoGive 30
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_FLASHBOMB"
  Obituary "$OB_FLASHBOMB"
  Tag "$TAG_FLASHBOMB"
  Weapon.AmmoType "FlashBombAmmo"
  Inventory.Icon "FLSHBOMI"
  States {
   SpawnLoop:
    WEA4 B -1
    loop
   Ready:
    FLSB T 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_FLASHBOMB)
    goto ReadyX
   ReadyX:
    FLSB T 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    FLSB T 1 A_WeaponReady
    loop
   Deselect:
    FLSB T 0
    goto DeselectSwap
   Select:
    FLSB T 0
    goto SelectSwap
   Fire:
    FLSB T 0 A_JumpIfNoAmmo("NoAmmo")
    FLSB T 0 A_PlaySoundEx("weapons/mm8/flashbombfire", "Weapon")
    FLSB T 0 A_FireCustomMissile("FlashBombU", 0, 1, 8, 0)
    FLB0 ABCDEF 2
    FLSB T 24
    FLSB T 0 A_ReFire  // 36 frames
    Goto ReadyX
  }
}

actor FlashBombU : FlashBomb {
  +FORCEXYBILLBOARD
  Radius 6
  Height 7
  Speed 26
  Damage (0)
  damagetype "FlashBomb"
  Obituary "$OB_FLASHBOMB"
  States {
   Death:
    FLEX A 0 A_Stop
    FLEX A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    FLEX A 1 A_SpawnItemEx("FlashBombExplosionU")
    stop
  }
}

actor FlashBombExplosionU : FlashBombExplosion {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    FLEX AB 1 bright
    FLEX CD 1 bright
    FLEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 290), 80, 0)
    FLEX EE 0 A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    FLEX EE 0 A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX GF 1 bright A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    FLEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 290), 80, 0)
    Goto Pattern1
   Pattern1:
    FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    FLEX E 0 A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(-16, -40), Random(-32, 32), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX GF 1 bright A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(16, 40), Random(-32, 32), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX G 0 A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    Goto DamageNow
   Pattern2:
    FLEX EF 1 bright A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    FLEX E 0 A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(32, 64), Random(-32, 40), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX E 0 A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(-32, -64), Random(-32, 40), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX EF 1 bright A_SpawnItemEx("FlashBombFX2", Random(-16, 16), Random(-40, 40), Random(-32, 32), 0, 0, 0, 0, SXF_WEPFXCOLOR)
    FLEX G 0 A_SpawnItemEx("FlashBombFX1", 0, 0, 0, random(-7, 7), random(-7, 7), random(-7, 7), random(0, 359), SXF_WEPFXCOLOR)
    Goto DamageNow
   DamageNow:
    FLEX A 0 A_JumpIfInventory("CutterFlag", 12, "Damage3")
    FLEX A 0 A_JumpIfInventory("CutterFlag", 4, "Damage2")
    FLEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 290), 80, 0)
    Goto Continue
   Damage2:
    FLEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 200), 80, 0)
    Goto Continue
   Damage3:
    FLEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 160), 80, 0)
    Goto Continue
   Continue:
    FLEX G 0 A_CountDown
    FLEX A 0 A_GiveInventory("CutterFlag", 1)
    FLEX G 0 A_Jump(256, "Pattern1", "Pattern2")
    Goto Death
  }
}

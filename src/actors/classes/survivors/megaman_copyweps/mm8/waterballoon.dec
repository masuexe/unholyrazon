actor WaterBalloonWepU_MegaManUBar : MegaManUBar { Args 192, 62 }
actor WaterBalloonWepU : BaseMegaManUWep replaces WaterBalloonWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 42
Weapon.SlotNumber 3
Inventory.Pickupmessage "$PU_WATERBALLOON"
Obituary "$OB_WATERBALLOON"
Tag "$TAG_WATERBALLOON"
weapon.ammotype "WaterBalloonAmmo"
inventory.icon "WATERBI"
States
{
SpawnLoop:
WEA4 I -1
loop
Ready:
WTRB H 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_WATERBALLOON)
WTRB H 1 A_WeaponReady
Goto Ready+1
Deselect:
WTRB H 0
goto DeselectSwap
Select:
WTRB H 0
goto SelectSwap
Fire:
WTRB H 0 A_JumpIfNoAmmo("NoAmmo")
WTRB H 0 A_PlaySoundEx("weapons/mm8/waterballoonfire","Weapon")
WTRB H 0 A_FireCustomMissile("WaterBalloonU",random(-1,1),1,8,0)
WTRB IJ 3
WTRB J 1
WTRB H 1 A_Refire
Goto Ready+1
NoAmmo:
WTRB H 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor WaterBalloonU : WaterBalloon
{
damage (50)
States
{
Death:
WTRB K 0 A_SpawnItemEx("SoakifyEffect")
WTRB K 0 A_ChangeFlag("NOGRAVITY", 1)
WTRB K 0 A_Explode(80,64,0)
WTRB K 0 A_JumpIf(ceilingz-z<16,"DeathUp")
WTRB KLMN 2
stop
}
}

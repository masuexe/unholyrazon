actor FlameSwordWepU_MegaManUBar : MegaManUBar {Args 248, 41}
actor FlameSwordWepU : BaseMegaManUWep replaces FlameSwordWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 30
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_FLAMESWORD"
  Obituary "$OB_FLAMESWORD"
  Tag "$TAG_FLAMESWORD"
  Weapon.AmmoType "FlameSwordAmmo"
  Inventory.Icon "FSWORDI"
  +WEAPON.NOAUTOAIM
  States {
   SpawnLoop:
    WEA4 F -1
    loop
   Ready:
    FHU2 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_FLAMESWORD)
    goto ReadyX
   ReadyX:
    FHU2 A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    FHU2 A 1 A_WeaponReady
    loop
   Deselect:
    FHU2 A 0
    goto DeselectSwap
   Select:
    FHU2 A 0
    goto SelectSwap
   Fire:
    FHU2 A 0 A_JumpIfNoAmmo("NoAmmo")
    FHU2 C 0 A_PlaySoundEx("weapons/mm8/flameswordcharge", "Weapon")
    FHU2 CCCDDDEEFFF 1 ACS_NamedExecuteWithResult("core_missilestate")
    FHU2 D 0 A_PlaySoundEx("weapons/mm8/flameswordcharge2", "Weapon")
    FHU2 FFFFF 1 ACS_NamedExecuteWithResult("core_missilestate")
    FHU2 G 2
    FHU2 A 0 A_PlaySoundEx("weapons/mm8/flameswordslash", "Weapon")
    FHU2 A 0 A_TakeInventory("FlameSwordAmmo", 5, TIF_NOTAKEINFINITE)
    FHU2 J 0 A_GiveInventory("FlameSwordSlash_CI", 1)
    FHU2 JKLMN 1 A_SetAngle(angle - 1)
    Goto Finish
   Finish:
    TNT1 A 20
    FHU2 HI 2
    FHU2 A 10
    FHU2 A 0 A_ReFire
    Goto ReadyX
  }
}

// v6c slash flow damage carriers, scaled with the Unholy x10 convention.
// The base chain spawns these by name, so "replaces" redirects them.
actor FlameSwordSlashHitboxU : FlameSwordSlashHitbox replaces FlameSwordSlashHitbox {
  States {
   Spawn:
    MMFX B 0
    MMFX B 0 A_JumpIf(args[1] == 0, 2)
    MMFX B 0 A_SetDamageType("FlameSwordSpike")
    MMFX B 0 A_Explode(CallACS("uh_TodayDmgMul", 260), 22, 0, false, 22)
    MMFX B 0 A_SpawnItemEx("FlameSwordOilPitIgnite", 0, 0, 8)
    stop
   Death:
    MMFX B 0
    stop
  }
}

actor FlameSwordAfterburnHelperU : FlameSwordAfterburnHelper replaces FlameSwordAfterburnHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("FlameSwordFlameFX5", 32, 0, 28, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_GiveToTarget("FlameSwordQuake_CI")
    TNT1 A 0 A_GiveInventory("FlameSwordQuake_CI")
   SpawnLoop:
    TNT1 A 1 A_SetTics(mass)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists", true), "End")
    TNT1 A 0 A_Warp(AAPTR_TRACER, 0, 0, 28)
    TNT1 AA 0 A_SpawnItemEx("FlameSwordFlameFX4G", 0, 0, 28, random(-10, 10), random(-10, 10), random(10, 15), random(0, 360), SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 260), 50, 0, false, 50)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 1 A_JumpIf(args[1] == 0, "End")
    TNT1 A 0 A_GiveInventory("FlameSwordDunk_CI", 1, AAPTR_TRACER)
   End:
    TNT1 A 35
    stop
  }
}

actor FlameSwordAfterburnSpikeHelperU : FlameSwordAfterburnHelperU replaces FlameSwordAfterburnSpikeHelper {
  args 26, 1
}

actor FlameSwordU : FlameSword {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 1 A_SpawnItemEx("FlameSwordTrailU")
    Goto Death
  }
}

actor FlameSword2U : FlameSwordU {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 1 A_SpawnItemEx("FlameSwordTrail2U")
    Goto Death
  }
}

actor FlameSwordTrailU : FlameSwordTrail {
  Damage (CallACS("uh_TodayDmgMul", 250))
}

actor FlameSwordTrail2U : FlameSwordTrailU {
  States {
   Spawn:
    FSWD D 0
    FSWD D 0 A_ChangeVelocity(0, 15, 0, CVF_RELATIVE | CVF_REPLACE)
    FSWD DEF 1
    stop
  }
}

actor FSSparkSpawnerU : FSSparkSpawner {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU", Random(0, 16), Random(-48, -8), 8, random(50, 55), random(-15, 15), random(0, 15), 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU", Random(0, 16), 0, 8, random(45, 55), random(-15, 15), random(-15, 15), 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU", Random(0, 16), Random(8, 48), 8, random(40, 55), random(-15, 15), random(0, 15), 0, 0, 0)
    TNT1 A 1 A_CountDown
    loop
  }
}

actor FlameSwordSparkU : FlameSwordSpark {
  Damage (CallACS("uh_TodayDmgMul", 10))
}

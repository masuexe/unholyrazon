actor FlameSwordWepU_MegaManUBar : MegaManUBar { Args 248, 41 }
actor FlameSwordWepU : BaseMegaManUWep replaces FlameSwordWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_FLAMESWORD"
Obituary "$OB_FLAMESWORD"
Tag "$TAG_FLAMESWORD"
weapon.ammotype "FlameSwordAmmo"
inventory.icon "FSWORDI"
+WEAPON.NOAUTOAIM
States
{
SpawnLoop:
WEA4 F -1
loop
Ready:
FHUD A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_FLAMESWORD)
goto ReadyX
Deselect:
FHUD A 0
goto DeselectSwap
Select:
FHUD A 0
goto SelectSwap
Fire:
FHUD A 0 A_JumpIfNoAmmo("NoAmmo")
FHUD A 0 A_PlaySoundEx("weapons/mm8/flameswordfire","Weapon")
FHUD A 0 A_TakeInventory("FlameSwordAmmo",2,TIF_NOTAKEINFINITE)
FHUD A 0
FHUD A 0 A_JumpIf(CallACS("core_CheckFooting"), "GroundSwing")
Goto AirSwing
GroundSwing:
FHUD C 1 A_FireCustomMissile("FlameSwordU",50,0,-16,0,0,-10)
FHUD D 1 A_FireCustomMissile("FlameSwordU",25,0,-8,0,0,-5)
FHUD E 1 A_FireCustomMissile("FlameSwordU",0,0,0,0,0,0)
FHUD F 1 A_FireCustomMissile("FlameSwordU",-25,0,8,0,0,10)
FHUD G 1 A_FireCustomMissile("FlameSwordU",-50,0,16,0,0,20)
Goto Finish
AirSwing:
FHUD J 1 A_FireCustomMissile("FlameSword2U",-50,0,16,0,0,20)
FHUD K 1 A_FireCustomMissile("FlameSword2U",-25,0,8,0,0,10)
FHUD L 1 A_FireCustomMissile("FlameSword2U",0,0,0,0,0,0)
FHUD M 1 A_FireCustomMissile("FlameSword2U",25,0,-8,0,0,-5)
FHUD N 1 A_FireCustomMissile("FlameSword2U",50,0,-16,0,0,-10)
Goto Finish
Finish:
TNT1 A 14
FHUD HI 2
FHUD A 10
FHUD A 0 A_Refire
Goto ReadyX
}
}

actor FlameSwordU : FlameSword
{
states
{
Spawn:
TNT1 A 0
TNT1 AAAAA 1 A_SpawnItemEx("FlameSwordTrailU")
Goto Death
}
}

actor FlameSword2U : FlameSwordU
{
States
{
Spawn:
TNT1 A 0
TNT1 AAAAA 1 A_SpawnItemEx("FlameSwordTrail2U")
Goto Death
}
}

actor FlameSwordTrailU : FlameSwordTrail
{
damage (CallACS("uh_TodayDmgMul", 250))
}

actor FlameSwordTrail2U : FlameSwordTrailU
{
States
{
Spawn:
FSWD D 0 
FSWD D 0 A_ChangeVelocity(0, 15, 0, CVF_RELATIVE | CVF_REPLACE)
FSWD DEF 1 
stop
}
}

actor FSSparkSpawnerU : FSSparkSpawner
{
states
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU",Random(0,16),Random(-48, -8),8,random(50,55),random(-15,15),random(0,15),0, 0, 0)
TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU",Random(0,16),0,8,random(45,55),random(-15,15),random(-15,15),0, 0, 0)
TNT1 A 0 A_SpawnItemEx("FlameSwordSparkU",Random(0,16),Random(8, 48),8,random(40,55),random(-15,15),random(0,15),0, 0, 0)
TNT1 A 1 A_CountDown
loop
}
}

actor FlameSwordSparkU : FlameSwordSpark
{
damage (CallACS("uh_TodayDmgMul", 10))
}

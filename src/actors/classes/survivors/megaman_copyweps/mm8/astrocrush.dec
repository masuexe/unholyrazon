actor AstroCrushWepU_MegaManUBar : MegaManUBar {Args 229, 128}
actor AstroCrushWepU : BaseMegaManUWep replaces AstroCrushWep {
  Weapon.AmmoUse 10
  Weapon.AmmoGive 30
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_ASTROCRUSH"
  Obituary "$OB_ASTROCRUSH"
  Tag "$TAG_ASTROCRUSH"
  Weapon.AmmoType "AstroCrushAmmo"
  Inventory.Icon "ASTROI"
  States {
   SpawnLoop:
    WEA4 E -1
    loop
   Ready:
    AHUD A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_ASTROCRUSH)
    goto ReadyX
   ReadyX:
    AHUD A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    AHUD A 1 A_WeaponReady
    loop
   Deselect:
    AHUD A 0
    goto DeselectSwap
   Select:
    AHUD A 0
    goto SelectSwap
   Fire:
    AHUD A 0 A_JumpIfNoAmmo("NoAmmo")
    AHUD B 0
    AHUD B 0 A_Stop
    AHUD B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 3, 1, 1)
    AHUD B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 0, 1, 0)
    AHUD BCDEF 3
    TNT1 A 0 A_FireCustomMissile("AstroCrushSpawnerU", 0, 1, 0, 0)
    TNT1 A 30
    AHUD B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 3, 0, 1)
    AHUD B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 0, 0, 0)
    AHUD GH 3
    AHUD A 14
    AHUD A 0 A_ReFire
    Goto ReadyX
  }
}

actor AstroCrushU : AstroCrush {
  States {
   Death:
    ASEX A 0 A_PlaySoundEx("weapons/mm8/astrocrushexplode", "Weapon")
    ASEX A 0 A_ChangeFlag(NOGRAVITY, 1)
    ASEX A 0 A_Explode(CallACS("uh_TodayDmgMul", 700), 128, 0)
    ASEX ABCDEF 2
    stop
  }
}

actor AstroCrushSpawnerU : AstroCrushSpawner {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("AstroCrushU", random(300, -300), random(256, -256), 320, 0, 0, random(-20, -22))
    TNT1 A 1 A_SpawnItemEx("AstroCrushU", random(300, -300), random(256, -256), 320, 0, 0, random(-20, -22))
    TNT1 A 1 A_CountDown
    loop
  }
}

actor IceWaveWepU_MegaManUBar : MegaManUBar {Args 229, 205}
actor IceWaveWepU : BaseMegaManUWep replaces IceWaveWep {
  Weapon.AmmoUse 3
  Weapon.AmmoGive 30
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_ICEWAVE"
  Obituary "$OB_ICEWAVE"
  Tag "$TAG_ICEWAVE"
  Weapon.AmmoType "IceWaveAmmo"
  Inventory.Icon "ICEWAVI"
  States {
   SpawnLoop:
    WEA4 A -1
    loop
   Ready:
    ICEW I 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_ICEWAVE)
    goto ReadyX
   ReadyX:
    ICEW I 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    ICEW I 1 A_WeaponReady
    loop
   Deselect:
    ICEW I 0
    goto DeselectSwap
   Select:
    ICEW I 0
    goto SelectSwap
   Fire:
    ICEW I 0 A_JumpIfNoAmmo("NoAmmo")
    ICEW I 0 A_PlaySoundEx("weapons/mm8/icewavefire", "Weapon")
    ICEW I 0 A_FireCustomMissile("IceWaveDropper", 0, 1, 8, 0)
    ICEW JK 5
    ICEW I 24
    ICEW I 0 A_ReFire
    goto ReadyX
  }
}

actor IceWaveSpawnerU : IceWaveSpawner replaces IceWaveSpawner {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

actor IceWaveIcicleU : IceWaveIcicle replaces IceWaveIcicle {
  Damage (CallACS("uh_TodayDmgMul", 220))
}

actor IceWaveIcicleFloorU : IceWaveIcicleFloor replaces IceWaveIcicleFloor {
  Damage (CallACS("uh_TodayDmgMul", 220))
}

actor IceWaveBreakU : IceWaveBreak {
  States {
   SpawnFrame:
    X_8F F 0 A_SetScale(-2*random(0, 1)*scalex + scalex, scaley)
    X_8F F 0 A_Jump(2*256/3, 1, 2)
    X_8F F 2
    X_8F G 2
    X_8F H 2
    stop
  }
}

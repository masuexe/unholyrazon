actor DeepDiggerWepU_NormalBar : DeepDiggerWep_NormalBar {}
actor DeepDiggerWepU_ScriptBar : ScriptBar {}

actor DeepDiggerWepU : BaseMegaManUWep replaces DeepDiggerWep
{
    Weapon.AmmoUse 2
    Weapon.AmmoGive 28
    Weapon.SlotNumber 2
    Inventory.Pickupmessage "$PU_DEEPDIGGER"
    Obituary "$OB_DEEPDIGGER"
    Tag "$TAG_DEEPDIGGER"
    weapon.ammotype "DeepDiggerAmmo"
    inventory.icon "DDIGWI"
    States
    {
    SpawnLoop:
        DDIG A -1
        loop
    Ready:
        DDIG D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_DEEPDIGGER)
        DDIG D 1 A_WeaponReady
        Goto Ready+1
    Deselect:
        DDIG D 0 A_JumpIfHealthLower(1, "FireCheck")
        DDIG D 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "FireCheck")
        DDIG D 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "FireCheck")
    DeselectSkip:
        DDIG D 0 A_TakeInventory("DeepDiggerFlagL")
        DDIG D 0 A_TakeInventory("DeepDiggerFlagR")
        goto DeselectSwap
    FireCheck:
        TNT1 A 0 A_JumpIfHealthLower(1,"DeselectSkip")
        TNT1 A 1 A_JumpIf(true,"Fire")
        wait
    Select:
        DDIG D 0
        goto SelectSwap
    Altfire:
        "####" "#" 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "CheckLeft")
        "####" "#" 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "CheckLeft")
        "####" "#" 1 A_JumpIf(true, "FireCont")
        wait
    Fire:
        "####" "#" 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "CheckRight")
        "####" "#" 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "CheckRight")
        "####" "#" 1 A_JumpIf(true, "FireCont")
        wait
    FireCont:
        DDIG D 0 A_JumpIfNoAmmo("NoAmmo")
        DDIG E 1
        TNT1 A 1
        DDIG D 0 A_PlaySoundEx("weapons/mmv/deepdiggerload", "weapon")
        DDIG D 0 A_GiveInventory("DeepDiggerFlagL", 2)
        DDIG D 0 A_GiveInventory("DeepDiggerFlagR", 2)
        DDIG A 0 A_ChangeVelocity(0, 0, momz, CVF_REPLACE)
        DDIG D 0 A_Stop
        DDIG A 0 A_SpawnItemEx("DeepDiggerWarper_R", 68,  17, 16)
        DDIG A 0 A_SpawnItemEx("DeepDiggerWarper_L", 60, -17, 16)
        DDIG A 0 A_SpawnItemEx("DeepDiggerWarper_R2", 68,  17, 56)
        DDIG A 0 A_SpawnItemEx("DeepDiggerWarper_L2", 60, -17, 56)
        DDIG FFGGHH 1
        TNT1 AAAAAAAAAA 1
        goto Carry
    Carry:
        TNT1 A 0
        TNT1 A 1 A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "Carry")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "Carry")
        TNT1 A 0 A_JumpIf(true, "FireEnd")
        loop
    FireEnd:
        // Still have diggers left (4-shot charge) — do not end early
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "Carry")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "Carry")
        TNT1 A 1 A_RailWait
        TNT1 A 0 A_JumpIfInventory("DeepDiggerAltFrames", 1, "FireEnd")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerMainFrames", 1, "FireEnd")
        TNT1 A 0 A_JumpIf(true, "FireEndReal")
        loop
    FireEndReal:
        TNT1 A 10
        DDIG OP 6
        DDIG D 0 A_ClearRefire
        Goto Ready+1

    CheckRight:
        TNT1 A 0 A_JumpIfInventory("DeepDiggerMainFrames", 1, "FireLeft")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerAltFrames", 1, "FireRight")
        TNT1 A 0 A_GunFlash("FlashFireRight")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "RightWait")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "RightWait")
        TNT1 A 1 A_JumpIf(true, "FireEnd")
        loop
    RightWait:
        TNT1 AAAAAA 1
        goto Carry
    CheckLeft:
        TNT1 A 0 A_JumpIfInventory("DeepDiggerMainFrames", 1, "FireLeft")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerAltFrames", 1, "FireRight")
        TNT1 A 0 A_GunFlash("FlashFireLeft")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "LeftWait")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "LeftWait")
        TNT1 A 1 A_JumpIf(true, "FireEnd")
        loop
    LeftWait:
        TNT1 AAAAAA 1
        goto Carry

    FireLeft:
        TNT1 A 0 A_PlaySoundEx("weapons/mmv/deepdiggerfire","Weapon")
        TNT1 A 0 A_FireCustomMissile("DeepDiggerU",0,1,-10,4)
        TNT1 A 0 A_GiveInventory("DeepDiggerTakeLeftU")
        DDIG QRSTUV 1
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "Carry")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "Carry")
        goto FireEnd
    FireRight:
        TNT1 A 0 A_PlaySoundEx("weapons/mmv/deepdiggerfire","Weapon")
        TNT1 A 0 A_FireCustomMissile("DeepDiggerU",0,1,10,-4)
        TNT1 A 0 A_GiveInventory("DeepDiggerTakeRightU")
        DDIG IJKLMN 1
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "Carry")
        TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "Carry")
        goto FireEnd

    FlashFireLeft:
        DDIG F 0 A_PlaySoundEx("weapons/mmv/deepdiggerfire","Weapon")
        DDIG F 0 A_FireCustomMissile("DeepDiggerU",0,1,-10,4)
        DDIG F 0 A_GiveInventory("DeepDiggerTakeLeftU")
        DDIG QRSTUV 1
        stop
    FlashFireRight:
        DDIG F 0 A_PlaySoundEx("weapons/mmv/deepdiggerfire","Weapon")
        DDIG F 0 A_FireCustomMissile("DeepDiggerU",0,1,10,-4)
        DDIG F 0 A_GiveInventory("DeepDiggerTakeRightU")
        DDIG IJKLMN 1
        stop

    NoAmmo:
        DDIG D 1 ACS_NamedExecuteAlways("core_noammo",0)
        Goto Ready+1
    }
}

actor DeepDiggerWarper_R2 : DeepDiggerWarper_R {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_shieldwarper_deepdiggerU", 0, 0, 2)
    TNT1 A 0 A_Jump(256, "Shield")
    Goto Shield
   Shield:
    DDIG B 1
    DDIG B 1 A_Warp(AAPTR_TARGET, 52, 16, 32 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 36, 15, 48 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 20, 13, 64 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 4,  10, 74 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
   ShieldLoop:
    DDIG B 1 A_Warp(AAPTR_TARGET, -1, 10, 56 + 16 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    loop
  }
}

actor DeepDiggerWarper_L2 : DeepDiggerWarper_L {
	States {
   Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
	  TNT1 A 0 ACS_NamedExecuteAlways("uh_shieldwarper_deepdiggerU", 0, 1, 2)
	  TNT1 A 0 A_Jump(256, "Shield")
	  Goto Shield
	 Shield:
    DDIG B 1
    DDIG B 1 A_Warp(AAPTR_TARGET, 44, -16, 32 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 28, -15, 48 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, 12, -13, 64 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    DDIG B 1 A_Warp(AAPTR_TARGET, -4, -10, 74 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
   ShieldLoop:
	  DDIG B 1 A_Warp(AAPTR_TARGET, -9, -10, 56 + 16 + 40, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
	  loop
	}
}

actor DeepDiggerTakeRightU : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("DeepDiggerMainFrames", 1)
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 2, "TakeRight")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 2, "TakeLeft")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "TakeRight")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "TakeLeft")
    TNT1 A 1 A_JumpIf(true, "End")
    wait
   TakeRight:
    TNT1 A 0 A_TakeInventory("DeepDiggerFlagR", 1)
    goto End
   TakeLeft:
    TNT1 A 0 A_TakeInventory("DeepDiggerFlagL", 1)
    goto End
   End:
    TNT1 A 0
    stop
  }
}

actor DeepDiggerTakeLeftU : DeepDiggerTakeRightU {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("DeepDiggerAltFrames", 1)
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 2, "TakeLeft")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 2, "TakeRight")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagL", 1, "TakeLeft")
    TNT1 A 0 A_JumpIfInventory("DeepDiggerFlagR", 1, "TakeRight")
    TNT1 A 1 A_JumpIf(true, "End")
    wait
  }
}

actor DeepDiggerU : DeepDigger
{
damage (340)
}

actor DeepDiggerBitU : DeepDiggerBit
{
damage (100)
}

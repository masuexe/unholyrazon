actor SaltWaterWepU_MegaManUBar : MegaManUBar { Args 4, 198 }
actor SaltWaterWepU : BaseMegaManUWep replaces SaltWaterWep
{
    Weapon.AmmoUse 2
    Weapon.AmmoGive 28
    Weapon.SlotNumber 4
    Obituary "$OB_SALTWATER"
    Tag "$TAG_SALTWATER"
    Inventory.Pickupmessage "$PU_SALTWATER"
    weapon.ammotype "SaltWaterAmmo"
    inventory.icon "SWATWI"
    States
    {
    SpawnLoop:
        SWAT A -1
        loop
    Ready:
        SWAT J 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SALTWATER)
        goto ReadyX
    ReadyX:
        SWAT J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
        SWAT J 1 A_WeaponReady
        loop
    Deselect:
        SWAT J 0
        goto DeselectSwap
    Select:
        SWAT J 0
        goto SelectSwap
    Fire:
        SWAT J 0 A_JumpIfNoAmmo("NoAmmo")
        TNT1 A 1
        SWAT MN 1
        SWAT J 0 A_PlaySoundEx("weapons/mmv/saltwaterfire","Weapon")
        SWAT J 0 A_FireCustomMissile("SaltWaterU",0,1,8,0)
        SWAT OPQR 1
        TNT1 A 13
        TNT1 A 0 A_JumpIfNoAmmo("NoAmmoReady")
        SWAT LK 2 A_Refire
        Goto ReadyX
    NoAmmoReady:
        SWAT LK 2
        Goto ReadyX
    }
}

actor SaltWaterU : SaltWater replaces SaltWater
{
damage (CallACS("uh_TodayDmgMul", 330))
}

actor SaltWaterBitU : SaltWaterBit replaces SaltWaterBit
{
damage (CallACS("uh_TodayDmgMul", 110))
}

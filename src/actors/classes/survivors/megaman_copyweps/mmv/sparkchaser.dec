actor SparkChaserWepU_MegaManUBar : MegaManUBar { Args 104, 198 }
actor SparkChaserWepU : BaseMegaManUWep replaces SparkChaserWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_SPARKCHASER"
Obituary "$OB_SPARKCHASER"
Tag "$TAG_SPARKCHASER"
weapon.ammotype "SparkChaserAmmo"
inventory.icon "SCHSWI"
States
{
SpawnLoop:
SCHS A -1
loop 
Ready:
SCHS E 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SPARKCHASER)
goto ReadyX
Deselect:
SCHS E 0
goto DeselectSwap
Select:
SCHS E 0
goto SelectSwap
Fire:
SCHS E 0 A_JumpIfNoAmmo("NoAmmo")
SCHS E 0 A_PlaySoundEx("weapons/mmv/sparkchaserfire","Weapon")
SCHS E 0 A_FireCustomMissile("SparkChaserU",0,1,8,0)
SCHS FG 6
SCHS E 5
SCHS E 0 A_Refire
Goto ReadyX
}
}

actor SparkChaserU : SparkChaser replaces SparkChaser
{
damage (CallACS("uh_TodayDmgMul", 80))
}

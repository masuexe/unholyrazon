actor BubbleBombWepU_MegaManUBar : MegaManUBar { Args 4, 229 }
actor BubbleBombWepU : BaseMegaManUWep replaces BubbleBombWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Obituary "$OB_BUBBLEBOMB"
Tag "$TAG_BUBBLEBOMB"
Inventory.Pickupmessage "$PU_BUBBLEBOMB"
weapon.ammotype "BubbleBombAmmo"
inventory.icon "BBOMWI"
States
{
SpawnLoop:
BBOM A -1
loop
Ready:
BBOM F 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_BUBBLEBOMB)
BBOM F 1 A_WeaponReady
wait
Deselect:
BBOM F 0
goto DeselectSwap
Select:
BBOM F 0
goto SelectSwap
Fire:
BBOM F 0 A_JumpIfNoAmmo("NoAmmo")
goto Fire1
Fire1:
BBOM I 0 A_JumpIfNoAmmo("NoAmmo")
BBOM IJ 1
BBOM K 0 A_PlaySoundEx("weapon/bubblebomb","Weapon")
BBOM K 0 A_FireCustomMissile("BubbleBombU",0,1,8,0)
BBOM KLMN 1
TNT1 A 0 A_Refire("FireH1")
goto FireH0

Altfire:
BBOM F 0 A_JumpIfNoAmmo("NoAmmo")
goto Fire2
Fire2:
BBOM O 0 A_JumpIfNoAmmo("NoAmmo")
BBOM OP 1
BBOM Q 0 A_PlaySoundEx("weapon/bubblebomb","Weapon")
BBOM Q 0 A_FireCustomMissile("BubbleBomb2",0,1,8,0)
BBOM QRST 1
TNT1 A 0 A_Refire("FireH2")
goto FireH0

FireH0:
TNT1 AAAAAAA 2
goto FireEnd
FireH1:
TNT1 A 2 A_RailWait
TNT1 A 0 A_Refire(1)
goto FireH0+1
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+2
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+3
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+4
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+5
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+6
TNT1 A 2
TNT1 A 0 A_Refire("Fire2")
goto FireEnd

FireH2:
TNT1 A 2 A_RailWait
TNT1 A 0 A_Refire(1)
goto FireH0+1
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+2
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+3
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+4
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+5
TNT1 A 2
TNT1 A 0 A_Refire(1)
goto FireH0+6
TNT1 A 2
TNT1 A 0 A_Refire("Fire1")
goto FireEnd

FireEnd:
TNT1 A 0 A_JumpIfNoAmmo(3)
BBOM HG 2 A_WeaponReady
Goto Ready+1
BBOM HG 2 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
Goto Ready+1
NoAmmo:
BBOM F 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor BubbleBombU : BubbleBomb replaces BubbleBomb
{
    damage (10)
    States
    {
    Death:
        BBOM A 0 A_Stop
        BBOM A 0 A_SpawnItemEx("SoakifyEffect")
        BBOM A 0 A_PlaySoundEx("weapons/mmv/bubblebombexplode", "Weapon")
        BBOM A 0 A_Explode(420, 96, 0, 0, 48)
        TNT1 A 35 A_SpawnItemEx("ExplosionEffect2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
        stop
    }
}

actor BubbleBomb2U : BubbleBombU replaces BubbleBomb2
{
    States
    {
    Spawn:
        TNT1 A 1
        TNT1 A 0 A_SetUserVar("user_DIRECTION",-1)
        TNT1 A 0 A_SetUserVar("user_SPEED", 6)
        goto SpawnStart
    }
}


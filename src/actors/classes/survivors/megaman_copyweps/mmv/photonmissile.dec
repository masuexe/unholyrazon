actor PhotonMissileWepU_MegaManUBar : MegaManUBar {Args 229, 199}
actor PhotonMissileWepU_ScriptBar : ScriptBar {}

actor PhotonMissileWepU : BaseMegaManUWep replaces PhotonMissileWep {
  // $Category MM8BDM-Weapons/Power
  // $Title Photon Missile
  // $Sprite PMISA0
  Weapon.AmmoUse 3
  Weapon.AmmoGive 30
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_PHOTONMISSILE"
  Obituary "$OB_PHOTONMISSILE"
  Tag "$TAG_PHOTONMISSILE"
  Weapon.AmmoType "PhotonMissileAmmo"
  Inventory.Icon "PMISWI"
  States {
   SpawnLoop:
    PMIS A -1
    loop
   Ready:
    PMIS G 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_PHOTONMISSILE)
    PMIS G 0 A_JumpIfInventory("PhotonMissileCharge", 1, "DelayLoop")
    goto ReadyX
   ReadyX:
    PMIS G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    PMIS G 1 A_WeaponReady
    loop
   Deselect:
    PMIS G 0
    goto DeselectSwap
   Select:
    PMIS G 0
    goto SelectSwap
   Fire:
    PMIS G 0 A_JumpIfNoAmmo("NoAmmo")
    PMIS G 0 A_TakeInventory("PhotonMissileAmmo", 3, TIF_NOTAKEINFINITE)
    PMIS H 0 A_PlaySoundEx("weapons/mmv/photonmissileload", "weapon")
    PMIS H 1
   HoldB1:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold1", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldB2")
    goto Launch
   HoldB2:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold1", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldC1")
    goto Launch
   HoldC1:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold2", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldC2")
    goto Launch
   HoldC2:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold2", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldD1")
    goto Launch
   HoldD1:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold3", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldD2")
    goto Launch
   HoldD2:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold3", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS H 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEARM, "HoldArm")
    PMIS H 0 A_ReFire("HoldB1")
    goto Launch

   HoldArm:
    PMIS H 0 A_PlaySoundEx("weapons/mmv/photonmissilecharge", "weapon")
    goto HoldB3

   HoldB3:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold4", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldB4")
    goto Launch
   HoldB4:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold4", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldC3")
    goto Launch
   HoldC3:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold5", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldC4")
    goto Launch
   HoldC4:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold5", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldD3")
    goto Launch
   HoldD3:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold3", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldD4")
    goto Launch
   HoldD4:
    PMIS H 0 A_SpawnItemEx("PhotonMissileHold3", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PMIS H 0 A_GiveInventory("PhotonMissileCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    PMIS I 1 A_JumpIfInventory("PhotonMissileCharge", WEPC_VPM_CHARGEMAX, "Launch")
    PMIS H 0 A_ReFire("HoldB3")
    goto Launch

   Launch:
    PMIS G 0 A_GiveInventory("FirePhotonMissileLauncher")  // SpreadRune
    PMIS G 0 A_SpawnItemEx("PhotonMissileHold3", 48 * cos(pitch), 8, 48 * sin(-pitch) + 32, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    TNT1 A 0 A_GiveInventory("PhotonMissileCooldown_P", 1)
    PMIS IIHH 1 A_GiveInventory("PhotonMissileCharge", 2)
    PMIS G 0 A_JumpIfInventory("PhotonMissileCharge", 55, "DelayEnd")
   LaunchDelay:
    PMIS G 0 A_SpawnItemEx("PhotonMissileDelay_W")
   DelayLoop:
    PMIS G 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    PMIS G 1 A_WeaponReady(WRF_NOFIRE)
    PMIS G 0 A_JumpIfInventory("PhotonMissileCharge", 55, 1) loop
   DelayEnd:
    PMIS G 0 A_TakeInventory("PhotonMissileCharge", 999)
    PMIS G 16
    goto Ready+1
   Altfire:
    PMIS G 0 A_JumpIfNoAmmo("NoAmmo")
    PMIS G 0 A_TakeInventory("PhotonMissileAmmo", 3, TIF_NOTAKEINFINITE)
    PMIS H 0 A_PlaySoundEx("weapons/mmv/photonmissileload", "weapon")
    PMIS H 1
    goto Launch
  }
}

actor PhotonMissileLauncherU : PhotonMissileLauncher replaces PhotonMissileLauncher {
  Damage (CallACS("uh_TodayDmgMul", 10))
}

actor PhotonMissileU : PhotonMissile replaces PhotonMissile {
  Damage (CallACS("uh_TodayDmgMul", 10))
}

actor PhotonMissileExplosionU : PhotonMissileExplosion replaces PhotonMissileExplosion {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapons/mmv/photonmissileexplode", "auto")
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 600), 100, 0, 0, 28)
    TNT1 A 35 A_SpawnItemEx("ExplosionEffect3", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

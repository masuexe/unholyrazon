actor GrabBusterWepU_MegaManUBar : MegaManUBar { Args 4, 104 }
actor GrabBusterWepU : BaseMegaManUWep replaces GrabBusterWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Obituary "$OB_GRABBUSTER"
Tag "$TAG_GRABBUSTER"
Inventory.Pickupmessage "$PU_GRABBUSTER"
weapon.ammotype "GrabBusterAmmo"
inventory.icon "GRABBI"
States
{
SpawnLoop:
GRBU A -1
loop
Ready:
GRBU J 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_GRABBUSTER)
GRBU J 1 A_WeaponReady
Goto Ready+1
Deselect:
GRBU J 0
goto DeselectSwap
Select:
GRBU J 0
goto SelectSwap
Fire:
GRBU J 0 A_JumpIfNoAmmo("NoAmmo")
GRBU J 0 A_PlaySoundEx("weapons/mmv/grabbusterfire","Weapon")
GRBU J 0 A_FireCustomMissile("GrabBusterU",0,1,8,0)
GRBU JKL 3
GRBU J 4
GRBU J 0 A_Refire
Goto Ready+1
NoAmmo:
GRBU J 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor GrabBusterU : GrabBuster replaces GrabBuster {
  damage (200)
  States {
	 Spawn:
		GRBU B 2
   SpawnLoop:
    GRBU CDED 2 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, SXF_WEPFXCOLOR)
		loop
  }
}

actor GrabBusterFXU : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   SpawnFrame:
    TNT1 A 2
    GRBU MON 2
    stop
  }
}

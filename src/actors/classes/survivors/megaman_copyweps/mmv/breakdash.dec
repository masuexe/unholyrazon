actor BreakDashWepU_ScriptBar : ScriptBar {}
actor BreakDashWepU_MegaManUBar : MegaManUBar {Args 4, 63}

const int WEPC_VBDU_ATTACK1_AMMO = 1;
const int WEPC_VBDU_ATTACK2_AMMO = 3;
const int WEPC_VBDU_ATTACK3_AMMO = 5;

actor BreakDashWepU : BaseMegaManUWep replaces BreakDashWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 30
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_BREAKDASH"
  Obituary "$OB_BREAKDASH"
  Tag "$TAG_BREAKDASH"
  Weapon.AmmoType "BreakDashAmmo"
  Inventory.Icon "BDASWI"
  States {
   SpawnLoop:
    BDAS A -1
    loop
   Ready:
    BDAS H 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_BREAKDASH)
    goto ReadyX
   ReadyX:
    BDAS H 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BDAS H 1 A_WeaponReady
    loop
   Deselect:
    BDAS H 0 A_JumpIfInventory("WeaponCharge", 1, 1)
    goto DeselectSwap
    BDAS H 2 A_TakeInventory("WeaponCharge", 999)
    goto DeselectSwap
   Select:
    BDAS H 0
    goto SelectSwap
   Fire:
    BDAS H 0 A_JumpIfNoAmmo("NoAmmo")
    // Respect charge carried over from a fully charged dash that struck a player.
    BDAS H 0 A_JumpIfInventory("WeaponCharge", 27, "Charge3")
    BDAS H 0 A_JumpIfInventory("WeaponCharge", 10, "Charge2")
    goto Charge1
   AltFire:
    BDAS H 0 A_JumpIfNoAmmo("NoAmmo")
    goto Fire1
   Charge1:
    BDAS H 0 A_Refire(1) goto Fire1
    BDAS H 1
    BDAS H 0 A_GiveInventory("WeaponCharge", 1)
    BDAS H 0 A_JumpIfInventory("WeaponCharge", 10, "Charge2")
    loop
   Charge2:
    BDAS I 0 A_PlaySoundEx("weapons/mmv/breakdashcharge", "Weapon")
    BDAS I 0 A_Refire(1) goto Fire2
    BDAS I 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASHCHARGE1, TCLR_CHARGE1)
    BDAS H 0 A_Refire(1) goto Fire2
    BDAS H 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 0 A_GiveInventory("WeaponCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    BDAS H 0 A_JumpIfInventory("WeaponCharge", 27, "Charge3")
    goto Charge2+1
   Charge3:
    BDAS J 0 A_GunFlash("Sound.BusterCharge", GFF_NOEXTCHANGE)
    BDAS J 0 A_Refire(1) goto Fire3
    BDAS J 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASHCHARGE2, TCLR_CHARGE2)
    BDAS K 0 A_Refire(1) goto Fire3
    BDAS K 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASHCHARGE3, TCLR_CHARGE3)
    BDAS H 0 A_Refire(1) goto Fire3
    BDAS H 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    goto Charge3+1
   BotFire:
    BDAS H 0 A_Jump(32, "Fire3")
    goto Charge3+1
   Fire1:
    BDAS H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 0 A_TakeInventory("WeaponCharge", 500)
    BDAS H 0 A_JumpIfNoAmmo("NoAmmo")
    BDAS NO 2
    TNT1 A 1
    BDAS G 3
    BDAS H 0 A_GiveInventory("BreakDashWepU_Attack1_AmmoSpend_P")
    BDAS FFFF 1 A_GiveInventory("BreakDashAttack1_CI", 1)
    BDAS ST 3
    TNT1 A 2
    BDAS ON 2
    goto ReadyX
   Fire2:
    BDAS H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 0 A_TakeInventory("WeaponCharge", 500)
    BDAS H 0 A_JumpIfInventory("BreakDashAmmo", 3, 1) goto Fire1+2
    BDAS NO 2
    TNT1 A 1
    BDAS G 3
    BDAS H 0 A_GiveInventory("BreakDashWepU_Attack2_AmmoSpend_P")
    BDAS FFFFFFFF 1 A_GiveInventory("BreakDashAttack2_CI", 1)
    BDAS ST 3
    TNT1 A 2
    BDAS ON 2
    goto ReadyX
   Fire3:
    BDAS H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 0 A_TakeInventory("WeaponCharge", 500)
    BDAS H 0 A_JumpIfInventory("BreakDashAmmo", 5, 1) goto Fire2+2
    BDAS B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 4, 2, 0)
    BDAS H 0 A_GiveInventory("BreakDashWepU_Attack3_AmmoSpend_P")
    BDAS N 1
    BDAS H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS OZG 1
    BDAS H 0 A_SpawnItemEx("BreakDashPuff")

    BDAS F 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS F 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS S 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS S 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS F 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS F 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS S 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS S 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS F 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS F 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS S 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS S 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS F 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS F 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS S 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS S 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS F 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS F 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")
    BDAS S 1 A_GiveInventory("BreakDashAttack3_CI", 1)
    BDAS S 0 A_JumpIfInventory("BreakDashRecoil", 1, "Recoil")

    BDAS F 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 4, 0, 0)
    BDAS F 0 // ACS_NamedExecuteWithResult("core_freezeplayer",0,0)
    BDAS F 0 A_ChangeVelocity(velx * 0.5, vely * 0.5, velz, CVF_REPLACE)
    BDAS S 3
    BDAS "T]ON" 2
    BDAS H 2
    goto ReadyX
   Recoil:
    BDAS Z 1
    BDAS G 0 A_PlaySoundEx("weapons/mmv/breakdashimpact", "weapon")
    BDAS G 0 ACS_NamedExecuteWithResult("core_dashChangeVelocity", -15*cos(pitch)*FIXED, 0, (-8*sin(-pitch)+5)*FIXED, CVFS_RELATIVE|CVFS_REPLACE|CVFS_FIXED)
    BDAS G 0 A_TakeInventory("BreakDashCharge", 100)
    BDAS B 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 4, 0, 0)
    BDAS B 0 // ACS_NamedExecuteAlways("core_freezeplayer",0,0,0)
    BDAS "]]]ONH" 4
    BDAS B 0 A_JumpIfInventory("BreakDashHit", 1, "ChargeRetain")
    goto ReadyX
   ChargeRetain:
    // v6b mechanic restored: keep the full charge after striking a player.
    // Clear it when there is not enough ammo for another charged dash.
    BDAS H 0 A_JumpIfInventory("BreakDashAmmo", 5, "ChargeKeep")
    BDAS H 0 A_TakeInventory("BreakDashHit", 1)
    BDAS H 0 A_TakeInventory("WeaponCharge", 500)
    BDAS H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_BREAKDASH, TCLR_NONE)
    BDAS H 1 A_WeaponReady(WRF_NOFIRE)
    goto ReadyX
   ChargeKeep:
    BDAS H 0 A_TakeInventory("BreakDashHit", 1)
    BDAS H 0 A_GiveInventory("WeaponCharge", 27)
    // Keep the charged hand sprites and colour cycle running, with or without M1 held.
   ChargeHoldLoop:
    BDAS J 0 ACS_NamedExecuteWithResult("core_weaponcolor", 215, 1)
    BDAS J 1 A_WeaponReady
    BDAS K 0 ACS_NamedExecuteWithResult("core_weaponcolor", 216, 1)
    BDAS K 1 A_WeaponReady
    BDAS H 0 ACS_NamedExecuteWithResult("core_weaponcolor", 213, 1)
    BDAS H 1 A_WeaponReady
    goto ChargeHoldLoop
  }
}

actor BreakDashProtectU : BreakDashProtect {
  Powerup.Duration 3
}

// v6c attack checks carry base damage; Unholy scales it by 10 and replaces the
// base classes so the base attack custom inventories spawn these variants.
actor BreakDashCheck1U : BreakDashCheck1 replaces BreakDashCheck1 {
  Damage (CallACS("uh_TodayDmgMul", 200))
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 200), 32, 0, 0, 32)
    stop
  }
}

actor BreakDashCheck2U : BreakDashCheck2 replaces BreakDashCheck2 {
  Damage (CallACS("uh_TodayDmgMul", 350))
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 350), 32, 0, 0, 32)
    stop
  }
}

actor BreakDashCheck3U : BreakDashCheck3 replaces BreakDashCheck3 {
  Damage (CallACS("uh_TodayDmgMul", 550))
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 550), 32, 0, 0, 32)
    stop
   XDeath:
    // v6b mechanic restored: a fully charged dash that strikes a player grants
    // BreakDashHit back to the shooter so the charge is retained.
    TNT1 A 0 A_GiveToTarget("BreakDashHit", 1)
    goto Death+1
  }
}

// v6b-era check kept because MegaMan Shiny extends it.
actor BreakDashCheckU : BreakDashCheck replaces BreakDashCheck {
  Damage (CallACS("uh_TodayDmgMul", 550))
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 550), 32, 0, 0, 32)
    stop
  }
}

// Spend after an authoritative state jump and sync the remaining ammo.
actor BreakDashWepU_Attack1_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("BreakDashAmmo", WEPC_VBDU_ATTACK1_AMMO, TIF_NOTAKEINFINITE)
    stop
  }
}

actor BreakDashWepU_Attack2_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("BreakDashAmmo", WEPC_VBDU_ATTACK2_AMMO, TIF_NOTAKEINFINITE)
    stop
  }
}

actor BreakDashWepU_Attack3_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("BreakDashAmmo", WEPC_VBDU_ATTACK3_AMMO, TIF_NOTAKEINFINITE)
    stop
  }
}

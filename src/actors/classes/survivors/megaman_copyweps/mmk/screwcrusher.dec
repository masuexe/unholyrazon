actor ScrewCrusherWepU_MegaManUBar : MegaManUBar { Args 54, 42 }
actor ScrewCrusherWepU : BaseMegaManUWep replaces ScrewCrusherWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 56
Weapon.SlotNumber 3
Inventory.Pickupmessage "$PU_SCREWCRUSHER"
Obituary "$OB_SCREWCRUSHER"
Tag "$TAG_SCREWCRUSHER"
weapon.ammotype "ScrewCrusherAmmo"
inventory.icon "SCRWSI"
States
{
SpawnLoop:
WEA3 D -1
loop
Ready:
SCRH A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SCREWCRUSHER)
SCRH A 0 A_JumpIfNoAmmo("ReadyNoAmmo")
SCRH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
SCRH A 1 A_WeaponReady
Goto Ready+2
ReadyNoAmmo:
SCRH J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
SCRH J 1 A_WeaponReady(WRF_NOFIRE)
SCRH J 0 A_JumpIfNoAmmo("ReadyNoAmmo")
Goto Ready+1
Deselect:
SCRH A 0
goto DeselectSwap
Select:
SCRH A 0
goto SelectSwap
Fire:
SCRH A 0 A_JumpIfNoAmmo("NoAmmo")
SCRH A 0 A_PlaySoundEx("weapons/mmk/screwcrusherfire","Weapon")
SCRH A 0 A_FireCustomMissile("ScrewCrusherSpawner",0,1,8,0)
SCRH BCDE 2
SCRH F 0 A_JumpIfNoAmmo("NoAmmoRaise")
SCRH F 0 A_Refire
SCRH FFGG 1 A_WeaponReady
SCRH IH 1 A_WeaponReady
SCRH A 4 A_WeaponReady
Goto Ready+1
NoAmmoRaise:
SCRH FFGG 1 A_WeaponReady(WRF_NOFIRE)
SCRH KL 1 A_WeaponReady(WRF_NOFIRE)
SCRH J 4 A_WeaponReady(WRF_NOFIRE)
Goto ReadyNoAmmo
NoAmmo:
SCRH J 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo",0)
Goto ReadyNoAmmo
}
}

actor ScrewCrusherU : ScrewCrusher replaces ScrewCrusher
{
damage (CallACS("uh_TodayDmgMul", 200))
}

actor MirrorBusterWepU_ScriptBar : ScriptBar {}
actor MirrorBusterWepU_MegaManUBar : MegaManUBar { Args 229, 76 }

actor MirrorBusterWepU : BaseMegaManUWep replaces MirrorBusterWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 7
Inventory.Pickupmessage "$PU_MIRRORBUSTER"
Obituary "$OB_MIRRORBUSTER"
Tag "$TAG_MIRRORBUSTER"
weapon.ammotype "MirrorBusterAmmo"
inventory.icon "MIRRSI"
States
{
SpawnLoop:
WEA3 H -1
loop
Ready:
MIRR F 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_MIRRORBUSTER)
MIRR F 0 A_TakeInventory("MirrorBusterFlag", 1)
MIRR F 0 A_TakeInventory("WeaponCharge", 1)
MIRR F 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
MIRR F 1 A_WeaponReady
Goto Ready+3
Deselect:
MIRR F 0
goto DeselectSwap
Select:
MIRR F 0
goto SelectSwap
Altfire:
MIRR F 0 A_GiveInventory("MirrorBusterSwitch")
Fire:
MIRR F 0 A_JumpIfNoAmmo("NoAmmo")
MIRR F 0 A_GiveInventory("ShieldCheck")
MIRR F 0 A_JumpIfInventory("MirrorBusterSwitch", 1, "Release")
MIRR F 0 A_TakeInventory("MirrorBusterFlag", 1)
MIRR F 0 A_TakeInventory("WeaponCharge", 1)
MIRR F 0 A_TakeInventory("MirrorBusterAmmo",2,TIF_NOTAKEINFINITE)
MIRR F 0 A_PlayWeaponSound("weapons/mmk/mirrorbusteractivate")

MIR0 A 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 A 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 A 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 A 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 B 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 B 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 B 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 B 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 C 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 C 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 C 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 A 0 A_Refire(1) goto Release
MIR0 C 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")

Charge1Start:
MIR0 E 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 E 0 A_Refire(1) goto Release
MIR0 E 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 E 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 E 0 A_Refire(1) goto Release
MIR0 E 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 F 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 F 0 A_Refire(1) goto Release
MIR0 F 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 F 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 F 0 A_Refire(1) goto Release
MIR0 F 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
Charge1:
MIR0 G 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 G 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX/2, "Charge2Start")
MIR0 G 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 G 0 A_Refire(1) goto Release
MIR0 G 0
loop

Charge2Start:
MIR0 H 0 A_PlaySoundEx("weapons/mmk/mirrorbustercharge", "Weapon")
MIR0 H 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 H 0 A_Refire(1) goto Release
MIR0 H 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 H 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 H 0 A_Refire(1) goto Release
MIR0 H 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 I 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 I 0 A_Refire(1) goto Release
MIR0 I 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 I 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 I 0 A_Refire(1) goto Release
MIR0 I 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
Charge2:
MIR0 J 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ChargeFullStart")
MIR0 J 1 A_GiveInventory("SpawnMirrorBuster")
MIR0 J 0 A_Refire(1) goto Release
MIR0 G 0
loop

ChargeFullStart:
MIR0 K 0 A_JumpIfInventory("IsBot", 1, "Release")
MIR0 K 1
MIR0 K 0 A_Refire(1) goto Release
MIR0 K 1
MIR0 K 0 A_Refire(1) goto Release
MIR0 L 1
MIR0 L 0 A_Refire(1) goto Release
MIR0 L 1
MIR0 L 0 A_Refire(1) goto Release
MIRR G 0 A_GiveInventory("WeaponCharge", 1)
MIRR G 0 A_GunFlash("Sound.BusterCharge", GFF_NOEXTCHANGE)
ChargeFull:
MIRR M 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ENKERCHARGE3,TCLR_MIRROR_CHARGE3)
MIRR M 0 A_Refire(1) goto Release
MIRR N 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ENKERCHARGE4,TCLR_MIRROR_CHARGE4)
MIRR N 0 A_Refire(1) goto Release
MIRR O 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ENKERCHARGE5,TCLR_MIRROR_CHARGE5)
MIRR O 0 A_Refire(1) goto Release
MIRR P 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ENKERCHARGE6,TCLR_MIRROR_CHARGE6)
MIRR P 0 A_Refire(1) goto Release
MIRR Q 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ENKERCHARGE7,TCLR_MIRROR_CHARGE7)
MIRR Q 0 A_Refire("ChargeFull")
goto Release

BotFire:
Release:
MIRR G 0 A_TakeInventory("ShieldCheck")
MIRR G 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX, "ReleaseStrong")
MIRR G 0 A_JumpIfInventory("MirrorBusterFlag", WEPC_KMB_CHARGEMAX/2, "ReleaseMid")
MIRR G 0 A_TakeInventory("MirrorBusterFlag", 1)
MIRR G 0 A_TakeInventory("WeaponCharge", 1)
ReleaseWeak:
TNT1 A 0 A_FireCustomMissile("MirrorShotSmallU",0,0,8,0)
TNT1 A 0 A_TakeInventory("MirrorBusterAmmo",1,TIF_NOTAKEINFINITE)
TNT1 A 0 A_PlaySound("weapons/mmk/mirrorbusterfire")
goto ReleaseEnd
ReleaseMid:
TNT1 A 0 A_FireCustomMissile("MirrorShotMediumU",0,0,8,0)
TNT1 A 0 A_TakeInventory("MirrorBusterAmmo",2,TIF_NOTAKEINFINITE)
TNT1 A 0 A_PlaySound("weapons/mmk/mirrorbusterfire")
goto ReleaseEnd
ReleaseStrong:
TNT1 A 0 A_FireCustomMissile("MirrorShotLargeU",0,0,8,0)
TNT1 A 0 A_TakeInventory("MirrorBusterAmmo",3,TIF_NOTAKEINFINITE)
TNT1 A 0 A_PlaySound("weapons/mmk/mirrorbusterfire2")
goto ReleaseEndStrong
ReleaseEnd:
MIRR F 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MIRRORBUSTER,TCLR_NONE)
MIRR G 0 A_TakeInventory("MirrorBusterFlag", 1)
MIRR G 4 A_TakeInventory("WeaponCharge", 1)
MIRR G 4 A_TakeInventory("MirrorBusterFlag", 1)
MIRR H 2
MIRR F 12
MIRR G 0 A_TakeInventory("MirrorBusterSwitch")
MIRR G 0 A_TakeInventory("ShieldCheck")
Goto Ready+1
ReleaseEndStrong:
MIR0 M 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_MIRRORBUSTER,TCLR_NONE)
MIRR M 0 A_TakeInventory("MirrorBusterFlag", 1)
MIR0 M 2 A_TakeInventory("WeaponCharge", 1)
MIR0 N 2
MIR0 O 2 A_TakeInventory("MirrorBusterFlag", 1)
MIR0 PQR 2
MIRR F 10
MIRR G 0 A_TakeInventory("MirrorBusterSwitch")
MIRR G 0 A_TakeInventory("ShieldCheck")
goto Ready+1
NoAmmo:
MIRR G 0 A_TakeInventory("MirrorBusterSwitch")
MIRR F 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo",0)
MIRR G 0 A_TakeInventory("ShieldCheck")
Goto ReadyNoAmmo
}
}

actor MirrorShotSmallU : MirrorShotSmall replaces MirrorShotSmall
{
damage (CallACS("uh_TodayDmgMul", 200))
}

actor MirrorShotMediumU : MirrorShotMedium replaces MirrorShotMedium
{
damage (CallACS("uh_TodayDmgMul", 450))
}

actor MirrorShotLargeU : MirrorShotLarge replaces MirrorShotLarge
{
damage (CallACS("uh_TodayDmgMul", 700))
}

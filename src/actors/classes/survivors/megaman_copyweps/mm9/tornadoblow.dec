{
    States
    {
    Pickup:
        TNT1 A 0 A_SpawnItemEx("TornadoBlowU",-100,-100,0)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("TornadoBlowU",-100,0,0,0,0,0,-45+15+180)

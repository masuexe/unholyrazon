actor TornadoBlowU : TornadoBlow
{
+DONTBLAST
+NOINTERACTION
Obituary "$OB_TORNADOBLOW"
damagetype "TornadoBlow"
damage (0)
radius 1
height 1
States
{
Spawn:
TBLO B 0
TBLO B 0 ThrustThingZ(0,5,0,0)
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BC 2
TBLO B 0 ThrustThingZ(0,10,0,1)
TBLO DE 2
TBLO B 0 ThrustThingZ(0,10,0,1)
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BC 2
TBLO B 0 ThrustThingZ(0,15,0,1)
TBLO DE 2
TBLO B 0 ThrustThingZ(0,15,0,1)
TBLO BCDE 2
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BCDE 2
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BCDE 2
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BCDE 2
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
TBLO BCDE 2
TBLO B 0 A_SpawnItemEx("TornadoDamagerU")
stop
}
}

actor TornadoDamagerU : TornadoDamager replaces TornadoDamager
{
Obituary "$OB_TORNADOBLOW"
damagetype "TornadoBlow"
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 80),96,0,0,96)
stop
}
}

actor TornadoBlowWepU_MegaManUBar : MegaManUBar { Args 4, 109 }
actor TornadoBlowWepU : BaseMegaManUWep replaces TornadoBlowWep
{
Weapon.AmmoUse 7
Weapon.AmmoGive 28
Weapon.SlotNumber 6
Obituary "$OB_TORNADOBLOW"
Tag "$TAG_TORNADOBLOW"
Inventory.Pickupmessage "$PU_TORNADOBLOW"
weapon.ammotype "TornadoBlowAmmo"
inventory.icon "TORNADBI"
States
{
SpawnLoop:
TBLO A -1
loop
Ready:
TBLH A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_TORNADOBLOW)
goto ReadyX
Deselect:
TBLH A 0
goto DeselectSwap
Select:
TBLH A 0
goto SelectSwap
Fire:
TBLH B 0 A_JumpIfNoAmmo("NoAmmo")
TBLH B 2
TBLH A 0 A_PlaySoundEx("weapon/tornadoblow","Weapon")
TBLH A 0 //A_GunFlash // TIME ASS
TBLH A 0 A_TakeInventory("TornadoBlowAmmo", 7, TIF_NOTAKEINFINITE)
TBLH A 0 A_GiveInventory("FireTornadoBlow1U")
TBLH A 0 A_SpawnItemEx("TornadoDamagerU")
TBLH C 1 A_GiveInventory("TornadoBlowThrust")
TBLH CD 1
TBLH A 0 A_GiveInventory("FireTornadoBlow2U")
TBLH A 0 A_SpawnItemEx("TornadoDamagerU")
TBLH D 1 A_GiveInventory("TornadoBlowThrust")
TBLH EE 1
TBLH A 0 A_GiveInventory("FireTornadoBlow3U")
TBLH A 0 A_SpawnItemEx("TornadoDamagerU")
TBLH F 1 A_GiveInventory("TornadoBlowThrust")
TBLH F 1
TNT1 A 1
TBLH A 0 A_GiveInventory("FireTornadoBlow4U")
TBLH A 0 A_SpawnItemEx("TornadoDamagerU")
TNT1 AA 1 A_GiveInventory("TornadoBlowThrust")
TNT1 AAAAA 3 A_GiveInventory("TornadoBlowThrust")
TNT1 A 32
TBLH GH 1
TBLH A 0 A_Refire
Goto ReadyX
}
}

actor FireTornadoBlow1U : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 A_SpawnItemEx("TornadoBlowU",100,100,0)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("TornadoBlowU",-100,0,0,0,0,0,45+15)
        TNT1 A 0 A_SpawnItemEx("TornadoBlowU",-100,0,0,0,0,0,45-15)
        stop
    }
}


actor HornetChaserWepU_MegaManUBar : MegaManUBar { Args 4, 228 }
actor HornetChaserWepU_ScriptBar : ScriptBar {}

actor HornetChaserWepU : BaseMegaManUWep replaces HornetChaserWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Obituary "$OB_HORNETCHASER"
Tag "$TAG_HORNETCHASER"
Inventory.Pickupmessage "$PU_HORNETCHASER"
weapon.ammotype "HornetChaserAmmo"
inventory.icon "HORNETI"
States
{
SpawnLoop:
HCHS A -1
loop
Ready:
HCHS D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_HORNETCHASER)
HCHS D 0 A_JumpIfInventory("HornetChaserCooldownFlag",1,"ReadyCooldown")
HCHS D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
HCHS D 1 A_WeaponReady
Goto Ready+1
ReadyCooldown:
HCHS D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
HCHS D 1 A_WeaponReady(WRF_NOFIRE)
Goto Ready+1
Deselect:
HCHS D 0
goto DeselectSwap
Select:
HCHS D 0
goto SelectSwap
Fire:
HCHS D 0 A_JumpIfNoAmmo("NoAmmo")
HCHS D 0 A_PlaySoundEx("weapons/mm9/hornetchaserfire","Weapon")
HCHS D 0 A_FireCustomMissile("HornetChaserU",0,1,8,0)
HCHS FE 2
HCHS D 0 A_GiveInventory("HornetChaserCooldownFlag",1)
HCHS D 0 A_SpawnItemEx("HornetChaserCooldowner")
Goto Ready+1
NoAmmo:
HCHS D 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor HornetChaserU : HornetChaser
{
damage (100)
States
{
Spawn:
HCHS B 0
HCHS B 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6553, 192) // 6553 = 0.1 * 65536
HCHS B 0 A_ScaleVelocity(2.0)
HCHS C 0 A_SetArg(0, 140)
HCHS BC 1
HCHS BCBCBC 1 A_SeekerMissile(4, 10, SMF_LOOK|SMF_PRECISE, 256, 2)
HCHS B 0 A_Stop
HCHS B 0 A_SpawnItemEx("HornetChaser2U",8,0,0,random(8,10),0,random(-2,2),random(-10,10))
HCHS B 0 A_SpawnItemEx("HornetChaser2U",8,0,0,random(8,10),0,random(-2,2),random(30,50))
HCHS B 0 A_SpawnItemEx("HornetChaser2U",8,0,0,random(8,10),0,random(-2,2),random(-30,-50))
goto SpawnLook
}
}

actor HornetChaser2U : HornetChaser
{
ReactionTime 150
damage (60)
speed 60
scale 2.0
States
{
Spawn:
HCHS B 0
HCHS B 0 ACS_NamedExecuteWithResult("core_alphaprojectile", CallACS("core_getptrtid", AAPTR_TARGET), APROJ_TEAM, 6553, 192) // 6553 = 0.1 * 65536
HCHS BC 1
HCHS BCBCBC 1 A_SeekerMissile(4, 10, SMF_LOOK|SMF_PRECISE, 256, 2)
HCHS B 0 A_ChangeFlag("BOUNCEONWALLS", false)
HCHS B 0 A_ChangeFlag("BOUNCEONFLOORS", false)
HCHS B 0 A_ChangeFlag("BOUNCEONCEILINGS", false)
HCHS B 0 A_ChangeFlag("CANBOUNCEWATER", false)
HCHS B 0 A_Stop
goto SpawnLook
SpawnChase:
HCHS BC 1
loop
}
}

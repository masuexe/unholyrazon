actor PlugBallWepU_MegaManUBar : MegaManUBar {Args 4, 39}
actor PlugBallWepU : BaseMegaManUWep replaces PlugBallWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Obituary "$OB_PLUGBALL"
  Tag "$TAG_PLUGBALL"
  Inventory.Pickupmessage "$PU_PLUGBALL"
  Weapon.AmmoType "PlugBallAmmo"
  Inventory.Icon "PLUGI"
  States {
   SpawnLoop:
    PBAL A -1
    loop
   Ready:
    PLUG B 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_PLUGBALL)
    goto ReadyX
   ReadyX:
    PLUG B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    PLUG B 1 A_WeaponReady
    loop
   Deselect:
    PLUG B 0
    goto DeselectSwap
   Select:
    PLUG B 0
    goto SelectSwap
   Fire:
    PLUG B 0 A_JumpIfNoAmmo("NoAmmo")
    PLUG B 0 A_PlaySoundEx("weapons/mm9/plugballfire", "Weapon")
    PLUG B 0 A_FireCustomMissile("PlugBallStartU", 0, 1, 8, 0)
    PLUG DCB 6
    PLUG B 0 A_ReFire
    Goto ReadyX
  }
}

actor PlugBallStartU : PlugBallStart {
  Damage (CallACS("uh_TodayDmgMul", 200))
  States {
   Death:
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    TNT1 A 0 A_SpawnItemEx("PlugBallU", 0, 0, 0, WEPC_9PB_SPEED, 0, 0, 0, 32)
    stop
  }
}

actor PlugBallU : PlugBall {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

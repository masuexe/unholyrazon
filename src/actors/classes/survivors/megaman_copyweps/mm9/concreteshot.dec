actor ConcreteShotWepU_MegaManUBar : MegaManUBar { Args 88, 95 }
actor ConcreteShotWepU : BaseMegaManUWep replaces ConcreteShotWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Obituary "$OB_CONCRETESHOT"
Tag "$TAG_CONCRETESHOT"
Inventory.Pickupmessage "$PU_CONCRETESHOT"
weapon.ammotype "ConcreteShotAmmo"
inventory.icon "CONCRETI"
States
{
SpawnLoop:
CONC A -1
loop
Ready:
CONC H 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_CONCRETESHOT)
CONC H 1 A_WeaponReady
Goto Ready+1
Deselect:
CONC H 0
goto DeselectSwap
Select:
CONC H 0
goto SelectSwap
Fire:
CONC H 0 A_JumpIfNoAmmo("NoAmmo")
CONC H 0 A_PlaySoundEx("weapons/mm9/concreteshotfire","Weapon")
CONC H 0 A_FireCustomMissile("ConcreteShotU",0,1,8,0)
CONC IJ 5
CONC H 14
CONC H 0 A_Refire
Goto Ready+1
NoAmmo:
CONC H 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor ConcreteShotU : ConcreteShot
{
damage (350)
}

actor LaserTridentWepU_MegaManUBar : MegaManUBar { Args 228, 72 }
actor LaserTridentWepU : BaseMegaManUWep replaces LaserTridentWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Obituary "$OB_LASERTRIDENT"
Tag "$TAG_LASERTRIDENT"
Inventory.Pickupmessage "$PU_LASERTRIDENT"
weapon.ammotype "LaserTridentAmmo"
inventory.icon "TRIDENI"
States
{
SpawnLoop:
LTRI A -1
loop
Ready:
LTRI D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_LASERTRIDENT)
goto ReadyX
Deselect:
LTRI D 0
goto DeselectSwap
Select:
LTRI D 0
goto SelectSwap
Fire:
LTRI D 0 A_JumpIfNoAmmo("NoAmmo")
LTRI D 0 A_PlaySoundEx("weapons/mm9/lasertridentfire","Weapon")
LTRI D 0 A_FireCustomMissile("LaserTridentU",0,1,8,0)
LTRI FE 2
LTRI D 12
LTRI D 0 A_Refire
Goto ReadyX
}
}

actor LaserTridentU : LaserTrident
{
damage (CallACS("uh_TodayDmgMul", 350))
}

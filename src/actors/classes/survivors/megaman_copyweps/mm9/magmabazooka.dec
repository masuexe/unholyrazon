actor MagmaBazookaWepU_ScriptBar : ScriptBar {}
actor MagmaBazookaWepU_MegaManUBar : MegaManUBar {Args 216, 42}

actor MagmaBazookaWepU : BaseMegaManUWep replaces MagmaBazookaWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 30
  Weapon.AmmoType "MagmaBazookaAmmo"
  Weapon.SlotNumber 4
  Obituary "$OB_MAGMABAZOOKA"
  Tag "$TAG_MAGMABAZOOKA"
  Inventory.Pickupmessage "$PU_MAGMABAZOOKA"
  Inventory.Icon "MAGMAI"
  States {
   SpawnLoop:
    MGM1 A -1
    loop
   Ready:
    MGHD A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_MAGMABAZOOKA)
    goto ReadyX
   ReadyX:
    MGHD A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    MGHD A 1 A_WeaponReady
    loop
   Deselect:
    MGHD A 0
    goto DeselectSwap
   Select:
    MGHD A 0
    goto SelectSwap
   Altfire:
    MGHD A 0 A_JumpIfNoAmmo("NoAmmo")
    MGHD A 0 A_PlaySoundEx("weapons/mm9/magmabazookafire", "Weapon")
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", 0, 1, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", -16, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", 16, 0, 8, 0)
    MGHD DE 3
    MGHD A 7
    MGHD A 0 A_ReFire("Altfire")
    goto ReadyX
   Fire:
    TNT1 A 0 A_StopSoundEx("SoundSlot5")
    MGHD A 0 A_TakeInventory("WeaponCharge")
    MGHD A 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMABAZOOKA, TCLR_NONE)
    MGHD A 0 A_JumpIfNoAmmo("NoAmmo")
    MGHD A 0 A_ReFire
    MGHD A 0 A_PlaySoundEx("weapons/mm9/magmabazookafire", "Weapon")
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", 0, 1, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", -16, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka1U", 16, 0, 8, 0)
    MGHD DE 3
    MGHD A 4
    MGHD A 0 A_ReFire
    goto ReadyX
   Fire2:
    TNT1 A 0 A_StopSoundEx("SoundSlot5")
    MGHD A 0 A_TakeInventory("WeaponCharge")
    MGHD A 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMABAZOOKA, TCLR_NONE)
    MGHD A 0 A_PlaySoundEx("weapons/mm9/magmabazookafire", "Weapon")
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 0, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", -16, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 16, 0, 8, 0)
    MGHD A 0 A_TakeInventory("MagmaBazookaAmmo", 6, TIF_NOTAKEINFINITE)
    MGH0 ABCDEF 2
    MGHD A 5
    MGHD A 0 A_ReFire
    goto ReadyX  // 17 frames
   Fire3:
    TNT1 A 0 A_StopSoundEx("SoundSlot5")
    MGHD A 0 A_TakeInventory("WeaponCharge")
    MGHD A 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMABAZOOKA, TCLR_NONE)
    MGHD A 0 A_PlaySoundEx("weapons/mm9/magmabazookafire", "Weapon")
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 0, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", -8, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 8, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", -16, 0, 8, 0)
    MGHD A 0 A_FireCustomMissile("MagmaBazooka2U", 16, 0, 8, 0)
    MGHD A 0 A_TakeInventory("MagmaBazookaAmmo", 6, TIF_NOTAKEINFINITE)
    MGH0 ABCDEF 2
    MGHD A 10
    MGHD A 0 A_ReFire
    goto ReadyX  // 17 frames
   Hold:
    MGHD A 0 A_JumpIfNoAmmo("NoAmmo")
    MGHD A 0 A_GunFlash("Sound.Magma", GFF_NOEXTCHANGE)
   Hold.b:
    MGHD A 0 A_JumpIfInventory("WeaponCharge", 169, "Charge3Start")
    MGHD A 0 A_JumpIfInventory("WeaponCharge", 19, "Charge2Start")
    MGHD A 0 A_GiveInventory("WeaponCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    MGHD A 1
    MGHD A 0 A_ReFire("Hold.a")
    goto fire
   Hold.a:
    MGHD F 1
    MGHD A 0 A_ReFire("Hold.b")
    goto Fire
   BotFire:
    MGHD G 0 A_Jump(16, "Fire2")
    MGHD G 0 A_ReFire("Charge2")
    goto Fire
   Charge2Start:
   Charge2:
    MGHD A 0 A_JumpIfInventory("WeaponCharge", 169, "Charge3Start")
    MGHD A 0 A_GiveInventory("WeaponCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    MGHD B 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE1, TCLR_CHARGE2)
    MGHD G 0 A_ReFire("Charge2.a")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire2")
    goto Fire
   Charge2.a:
    MGHD A 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMABAZOOKA, TCLR_CHARGE3)
    MGHD A 0 A_ReFire("Charge2.b")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire2")
    goto Fire
   Charge2.b:
    MGHD C 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE2, TCLR_NONE)
    MGHD A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    MGHD A 0 A_ReFire("Charge2")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire2")
    goto Fire
   Charge3Start:
   Charge3:
    MGHD B 0 A_SpawnItemEx("MagmaBazookaChargeFXU", random(16, 48), 0, Random(16, 48), frandom(0, 2), 0, frandom(1, 3), random(0, 179) * 2, 1)
    MGHD B 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE1, TCLR_CHARGE2)
    MGHD G 0 A_ReFire("Charge3.a")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire3")
    goto Fire
   Charge3.a:
    MGHD A 0 A_SpawnItemEx("MagmaBazookaChargeFXU", random(16, 48), 0, Random(16, 48), frandom(0, 2), 0, frandom(1, 3), random(0, 179) * 2, 1)
    MGHD A 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMABAZOOKA, TCLR_CHARGE3)
    MGHD A 0 A_ReFire("Charge3.b")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire3")
    goto Fire
   Charge3.b:
    MGHD A 0 A_SpawnItemEx("MagmaBazookaChargeFXU", random(16, 48), 0, Random(16, 48), frandom(0, 2), 0, frandom(1, 3), random(0, 179) * 2, 1)
    MGHD C 1 ACS_NamedExecuteWithResult("core_chargecolor", CLR_MAGMACHARGE2, TCLR_NONE)
    MGHD A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    MGHD A 0 A_ReFire("Charge3")
    MGHD A 0 A_JumpIfInventory("MagmaBazookaAmmo", 6, "Fire3")
    goto Fire

   Sound.Magma:
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 169, "Sound.Magma3")
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 19, "Sound.Magma2")
    TNT1 A 5 A_PlaySoundEx("weapons/mm9/magmabazookacharge", "Weapon", 0)
    TNT1 A 1 A_JumpIfInventory("WeaponCharge", 1, "Sound.Magma")
    stop
   Sound.Magma2:
    TNT1 A 10 A_PlaySoundEx("weapons/mm9/magmabazookacharge2", "Weapon", 0)
    TNT1 A 1 A_JumpIfInventory("WeaponCharge", 1, "Sound.Magma")
    stop
   Sound.Magma3:
    TNT1 A 9 A_PlaySoundEx("weapons/mm9/magmabazookacharge3", "Weapon", 0)
    TNT1 A 1 A_JumpIfInventory("WeaponCharge", 1, "Sound.Magma")
    stop
  }
}

actor MagmaBazooka1U : MagmaBazooka1 {
  Damage (CallACS("uh_TodayDmgMul", 150))
}

actor MagmaBazooka2U : MagmaBazooka2 {
  Damage (CallACS("uh_TodayDmgMul", 330))
}

actor MagmaBazookaChargeFXU : BasicGraphicEffect {
  +BRIGHT
  Alpha 0.75
  Speed 30
  Scale 2.0
  States {
   SpawnFrame:
    TNT1 A 0 A_Jump(256, "F1", "F2", "F3")
   F1:
    X_9G RRSSTTRRSSTTUUVV 1 ThrustThingZ(0, random(1, 3), 0, 1)
    stop
   F2:
    X_9G SSTTRRSSTTRRUUVV 1 ThrustThingZ(0, random(1, 3), 0, 1)
    stop
   F3:
    X_9G TTRRSSTTRRSSUUVV 1 ThrustThingZ(0, random(1, 3), 0, 1)
    stop
  }
}

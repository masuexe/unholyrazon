actor ThunderBoltWepU_MegaManUBar : MegaManUBar {Args 228, 73}
actor ThunderBoltWepU : BaseMegaManUWep replaces ThunderBoltWep {
  Weapon.AmmoUse 3
  Weapon.AmmoGive 30
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_THUNDERBOLT"
  Obituary "$OB_THUNDERBOLT"
  Tag "$TAG_THUNDERBOLT"
  Weapon.AmmoType "ThunderBoltAmmo"
  Inventory.Icon "TBOLSI"
  States {
   SpawnLoop:
    WEA3 R -1
    loop
   Ready:
    TBOL S 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_THUNDERBOLT)
    goto ReadyX
   ReadyX:
    TBOL S 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    TBOL S 1 A_WeaponReady
    loop
   Deselect:
    TBOL S 0
    goto DeselectSwap
   Select:
    TBOL S 0
    goto SelectSwap
   Fire:
    TBOL S 0 A_JumpIfNoAmmo("NoAmmo")
    TBOL S 0 A_PlaySoundEx("weapons/mm7/thunderboltfire", "Weapon")
    TBOL S 0 A_FireCustomMissile("ThunderBoltU", 0, 1, 8, 0)
    TBOL TU 5
    TBOL S 14
    TBOL S 0 A_ReFire
    Goto ReadyX
  }
}

actor ThunderBoltU : ThunderBolt {
  Damage (CallACS("uh_TodayDmgMul", 350))
  States {
   Death:
   Split:
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    TNT1 A 0 A_SpawnItemEx("ThunderBoltSplitU",0,0,0,1,0,0,90,SXF_TRANSFERPOINTERS|SXF_MULTIPLYSPEED)
    TNT1 A 0 A_SpawnItemEx("ThunderBoltSplitU",0,0,0,1,0,0,-90,SXF_TRANSFERPOINTERS|SXF_MULTIPLYSPEED)
    TNT1 A 0 A_SpawnItemEx("ExplosionEffect1", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

actor ThunderBoltSplitU : ThunderBoltSplit {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

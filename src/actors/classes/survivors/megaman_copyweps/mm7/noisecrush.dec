actor NoiseCrushWepU_ScriptBar : ScriptBar {}
actor NoiseCrushWepU_MegaManUBar : MegaManUBar { Args 204, 61 }

actor NoiseCrushWepU : BaseMegaManUWep replaces NoiseCrushWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_NOISECRUSH"
Obituary "$OB_NOISECRUSH"
Tag "$TAG_NOISECRUSH"
weapon.ammotype "NoiseCrushAmmo"
inventory.icon "NCRUSI"
States
{
SpawnLoop:
WEA3 J -1
loop
Ready:
NCRU I 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_NOISECRUSH)
NCRU I 0 A_JumpIfInventory("NoiseCrushCaughtU",1,"ChargeStart")
NCRU I 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
NCRU I 1 A_WeaponReady
Goto Ready+1
ChargeStart:
NCRU L 0 A_GiveInventory("WeaponCharge", CallACS("rz_CountInv_NoiseCrushCaughtU"))
NCRU L 0 A_GunFlash("Sound.BusterCharge", GFF_NOEXTCHANGE)
Charged:
NCRU L 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_NOISECRUSHCRG2,TCLR_CHARGE2)
NCRU M 1 A_WeaponReady
NCRU L 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_NOISECRUSHCRG3,TCLR_CHARGE3)
NCRU N 1 A_WeaponReady
NCRU I 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_NOISECRUSH,TCLR_NONE)
NCRU I 1 A_WeaponReady
loop
Deselect:
NCRU I 0 A_JumpIfInventory("WeaponCharge",1,1)
goto DeselectSwap
NCRU I 2 A_TakeInventory("WeaponCharge", 1)
goto DeselectSwap
Select:
NCRU I 0 A_TakeInventory("NoiseCrushCaughtU", 1)
goto SelectSwap
Fire:
NCRU I 0 A_JumpIfInventory("WeaponCharge",2,"Fire3")
NCRU I 0 A_JumpIfInventory("WeaponCharge",1,"Fire2")
NCRU I 0 A_JumpIfNoAmmo("NoAmmo")
NCRU I 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_NOISECRUSH,CLRF_SILENT)
Goto Fire1
Fire1:
NCRU I 0 A_PlaySoundEx("weapons/mm7/noisecrushfire","Weapon")
NCRU I 0 A_FireCustomMissile("NoiseCrushU",0,1,8,0)
NCRU JK 5
NCRU I 10
NCRU I 0 A_Refire
Goto Ready+1
Fire2:
NCRU I 0 A_PlaySoundEx("weapons/mm7/noisecrushchargefire", "Weapon")
NCRU I 0 A_StopSoundEx("SoundSlot5")
NCRU I 0 A_FireCustomMissile("NoiseCrush2U",0,0,8,0)
NCRU I 0 A_TakeInventory("NoiseCrushAmmo", 4, TIF_NOTAKEINFINITE)
NCRU I 0 A_TakeInventory("WeaponCharge", 1)
NCRU I 0 A_TakeInventory("NoiseCrushCaughtU", 1)
NCR0 A 1
NCR0 A 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_NOISECRUSH,TCLR_NONE)
NCR0 BCDEF 2
NCRU I 11
NCRU IIIIII 2 A_JumpIfInventory("NoiseCrushCaughtU",1,"ChargeStart")
NCRU I 0 A_Refire
Goto Ready+1 // 35 ticks
Fire3:
NCRU I 0 A_PlaySoundEx("weapons/mm7/noisecrushchargefireX", "Weapon")
NCRU I 0 A_StopSoundEx("SoundSlot5")
NCRU I 0 A_FireCustomMissile("NoiseCrushXU",0,0,8,0)
NCRU I 0 A_TakeInventory("NoiseCrushAmmo", 6, TIF_NOTAKEINFINITE)
NCRU I 0 A_TakeInventory("WeaponCharge", 1)
NCRU I 0 A_TakeInventory("NoiseCrushCaughtU", 1)
NCR0 A 1
NCR0 A 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_NOISECRUSH,TCLR_NONE)
NCR0 BCDEF 2
NCRU I 32
NCRU I 0 A_Refire
Goto Ready+1
}
}

actor NoiseCrushCaughtU : Inventory {
    Inventory.Amount 1
    Inventory.MaxAmount 2
}

actor NoiseCrushU : NoiseCrush
{
damage (CallACS("uh_TodayDmgMul", 81))
States
{
Give:
TNT1 A 2 A_GiveToTarget("NoiseCrushCaughtU", 1)
stop
}
}

actor NoiseCrush2U : NoiseCrush
{
Radius 20
Height 10
damage (CallACS("uh_TodayDmgMul", 192))
damagetype "NoiseCrush2"
Obituary "$OB_NOISECRUSH"
speed 50
States
{
Spawn:
TNT1 A 0
TNT1 A 1
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2E",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2B",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2F",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
Goto Look
Look:
TNT1 A 0 A_JumpIfCloser(43, "Give")
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2D",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_JumpIfCloser(43, "Give")
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2C",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_JumpIfCloser(43, "Give")
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2B",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_JumpIfCloser(43, "Give")
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
TNT1 A 0 A_JumpIfCloser(43, "Give")
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 1 A_CountDown
loop
Give:
TNT1 A 2 A_GiveToTarget("NoiseCrushCaughtU", 2)
stop
}
}

actor NoiseCrushXU : NoiseCrush2
{
+RIPPER
+NOINTERACTION
scale 10
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2E",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2B",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2F",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
SpawnLoop:
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2D",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2C",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2B",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
TNT1 A 0 A_SpawnItemEx("NoiseCrushTrailXDamager")
TNT1 A 1 A_SpawnItemEx("NoiseCrushTrail2A",0,0,0,0,0,0,0,SXF_WEPFXCOLOR|SXF_TRANSFERSCALE)
loop
}
}

actor NoiseCrushTrailXDamager : BasicExplosion {
    damagetype "NoiseCrush2"
    Obituary "$OB_NOISECRUSH"
    States {
        Spawn:
            TNT1 A 0
            TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 314), 240, 0, 0, 80)
            stop
    }
}

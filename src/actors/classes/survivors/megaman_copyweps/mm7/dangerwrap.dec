actor DangerWrapWepU_MegaManUBar : MegaManUBar { Args 4, 230 }
actor DangerWrapWepU : BaseMegaManUWep replaces DangerWrapWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Inventory.Pickupmessage "$PU_DANGERWRAP"
Obituary "$OB_DANGERWRAP"
Tag "$TAG_DANGERWRAP"
weapon.ammotype "DangerWrapAmmo"
inventory.icon "DWRASI"
States
{
SpawnLoop:
WEA3 L -1
loop
Ready:
DWRA J 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_DANGERWRAP)
goto ReadyX
ReadyX:
DWRA J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
DWRA J 1 A_WeaponReady
loop
Deselect:
DWRA J 0
goto DeselectSwap
Select:
DWRA J 0
goto SelectSwap
Fire:
DWRA J 0 A_JumpIfNoAmmo("NoAmmo")
DWRA J 0 A_PlaySoundEx("weapons/mm7/dangerwrapfire","Weapon")
DWRA J 0 A_FireCustomMissile("DangerWrapU",0,1,8,0)
DWRA KL 6
DWRA J 13
DWRA J 0 A_Refire
Goto ReadyX
}
}

actor DangerWrapU : DangerWrap
{
States
{
Death:
DWRA G 0 A_SpawnItemEx("SoakifyEffect")
DWRA G 2 A_ChangeFlag("NOGRAVITY",0)
TNT1 A 0 A_SetGravity(2)
DWRA G 1 A_JumpIf(z-floorz==0,"SpawnMine")
NoMine:
DWRA GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG 1 A_JumpIf(z-floorz==0,"SpawnMine")
Crash:
XDeath:
DWRA G 0 A_Stop
DWRA G 0 A_SpawnItemEx("WrapExplosionU", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
stop
SpawnMine:
TNT1 A 1 A_SpawnItemEx("DangerWrapMineU")
stop
}
}

actor WrapExplosionU : WrapExplosion
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapons/mm7/dangerwrapexplode", "Weapon")
TNT1 D 0 A_Explode(CallACS("uh_TodayDmgMul", 530), 128, 0)
TNT1 A 35 A_SpawnItemEx("ExplosionEffect2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
stop
}
}

actor DangerWrapMineU : DangerWrapMine
{
damage (CallACS("uh_TodayDmgMul", 10))
States
{
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_ChangeFlag("NOGRAVITY",1)
TNT1 A 0 A_SpawnItemEx("WrapExplosionU", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
stop
}
}

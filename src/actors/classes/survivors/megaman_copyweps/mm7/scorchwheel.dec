actor ScorchWheelWepU_MegaManUBar : MegaManUBar { Args 93, 42 }
actor ScorchWheelWepU_ScriptBar : ScriptBar {}

actor ScorchWheelWepU : BaseMegaManUWep replaces ScorchWheelWep
{
Weapon.AmmoUse 7
Weapon.AmmoGive 28
Weapon.SlotNumber 7
Inventory.Pickupmessage "$PU_SCORCHWHEEL"
Obituary "$OB_SCORCHWHEEL"
Tag "$TAG_SCORCHWHEEL"
weapon.ammotype "ScorchWheelAmmo"
inventory.icon "SWHESI"
States
{
SpawnLoop:
WEA3 M -1
loop
Ready:
SWHE G 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SCORCHWHEEL)
TNT1 A 0 A_TakeInventory("ScorchWheelPowerup", 999)
SWHE G 1 A_WeaponReady
Goto Ready+1
Deselect:
SWHE G 0
goto DeselectSwap
Select:
SWHE G 0
goto SelectSwap
Fire:
SWHE G 0 A_JumpIfNoAmmo("NoAmmo")
SWHE G 0 A_GiveInventory("WheelCount", 80)
Altfire:
SWHE G 0 A_JumpIfNoAmmo("NoAmmo")
SWHE HIJKL 2
SWHE G 0 A_SpawnItemEx("ScorchWheelWarper")
SWHE G 0 A_PlaySoundEx("weapons/mm7/scorchwheelactivate","Weapon")
TNT1 A 0 A_GiveInventory("ScorchWheelPowerup", 1)
Wheel:
TNT1 A 1 A_JumpIfInventory("WheelCount",1,"Hold")
Goto Throw
Hold:
TNT1 A 0 A_JumpIfInventory("IsBot", 1, "BotThrow")
TNT1 A 1 A_TakeInventory("WheelCount",1)
TNT1 A 1 A_Refire("Wheel")
Throw:
TNT1 A 0 A_TakeInventory("ScorchWheelPowerup", 999)
TNT1 A 0 A_TakeInventory("WheelCount",99)
TNT1 A 0 A_PlaySoundEx("weapons/mm7/scorchwheelfire","Weapon")
TNT1 A 15 A_FireCustomMissile("ScorchWheelU",0,1,0,0)
SWHE MN 2 A_ClearRefire
Goto Ready+1
BotThrow:
TNT1 A 0 A_Jump(10, "Throw")
goto Hold+1
NoAmmo:
SWHE G 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor ScorchWheelU : ScorchWheel
{
States
{
Spawn:
SWHE A 0
SWHE A 0 A_SpawnItemEx("OilPitIgnite",0,0,0)
SWHE ABCDEF 2 A_Explode(160,96,0)
loop
Death:
TNT1 A 0 A_CustomMissile("ScorchWheel2U",0,0,0,2,0)
TNT1 A 1 A_SpawnItemEx("OilPitIgnite",0,0,8)
stop
}
}

actor ScorchWheel2U : ScorchWheel2
{
States
{
Spawn:
SWHE A 0
SWHE A 0 A_SpawnItemEx("OilPitIgnite",0,0,0)
SWHE ABCDEF 2 A_Explode(160,96,0)
loop
Death:
TNT1 AAAA 0 A_SpawnItemEx("ScorchBit",0,0,0,random(-10,10),random(-10,10),random(10,15),random(0,359), SXF_WEPFXCOLOR)
TNT1 A 1 A_SpawnItemEx("OilPitIgnite",0,0,8)
stop
}
}

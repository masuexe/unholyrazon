actor SlashClawWepU_MegaManUBar : MegaManUBar { Args 228, 111 }
actor SlashClawWepU : BaseMegaManUWep replaces SlashClawWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_SLASHCLAW"
Obituary "$OB_SLASHCLAW"
Tag "$TAG_SLASHCLAW"
weapon.ammotype "SlashClawAmmo"
inventory.icon "SCLASI"
States
{
SpawnLoop:
WEA3 Q -1
loop
Ready:
SCLA A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SLASHCLAW)
goto ReadyX
Deselect:
SCLA A 0
goto DeselectSwap
Select:
SCLA A 0
goto SelectSwap
Fire:
SCLA A 0 A_JumpIfNoAmmo("NoAmmo")
SCLA BC 1
SCLA A 0 A_PlaySoundEx("weapons/mm7/slashclawfire","Weapon")
SCLA A 0 A_FireCustomMissile("SlashClawU",0,1,11,-8)
SCLA DE 2
SCLA F 4
SCLA G 15
SCLA CBA 2 A_WeaponReady
Goto ReadyX
}
}

actor SlashClawU : SlashClaw
{
States
{
Spawn:
SCLA H 1
SCLA IJKL 1 A_Explode(250,80,0)
stop
}
}

        TNT1 A 0 A_SpawnItemEx("JunkProjectileU",cos(pitch+WEPC_7JS_PITCH2)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch+WEPC_7JS_PITCH2), 0, sin(-pitch+WEPC_7JS_PITCH2), WEPC_7JS_ANGLE2-WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileU",cos(pitch+WEPC_7JS_PITCH2)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch+WEPC_7JS_PITCH2), 0, sin(-pitch+WEPC_7JS_PITCH2), WEPC_7JS_ANGLE2+WEPC_7JS_BACKOFFS-WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)

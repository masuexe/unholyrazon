actor JunkProjectileShooterU : BasicWatcher
{
    States
    {
    Spawn:
        TNT1 A 0
        TNT1 A 4
        TNT1 A 0 A_SpawnItemEx("JunkProjectile2U", -momx*5, -momy*5, -momz*5, momx, momy, momz, 0, SXF_ABSOLUTEPOSITION|SXF_ABSOLUTEMOMENTUM)
        stop
    }
}

actor JunkProjectileU : JunkProjectile replaces JunkProjectile
{
    Damage (CallACS("uh_TodayDmgMul", 80))
    States
    {
    Spawn:
        JSHI X 0
        JSHI X 0 A_SpawnItemEx("JunkProjectileShooterU", 0, 0, 0, momx, momy, momz, 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
        JSHI X 0 A_ChangeFlag(THRUACTORS, false)
	SpawnLoop:
        JSHI X 1
        wait
    }
}

actor JunkProjectileStartU : JunkProjectileU { speed 33 } 

actor JunkProjectile2U : JunkProjectileU
{
    -THRUACTORS
    Health 999
    Damage (CallACS("uh_TodayDmgMul", 40))
    States
    {
    Spawn:
        goto SpawnLoopChild
    Pain:
        TNT1 A 0 A_PlaySound("item/protoreflect")
        TNT1 A 0 A_SpawnItemEx("JunkEndEffect2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
        goto SpawnLoopChild
    }
}

actor JunkShieldWepU_MegaManUBar : MegaManUBar { Args 68, 94 }
actor JunkShieldWepU_ScriptBar : ScriptBar {}

actor JunkShieldWepU : BaseMegaManUWep replaces JunkShieldWep
{
    Weapon.AmmoUse 4
    Weapon.AmmoGive 28
    Weapon.SlotNumber 7
    Inventory.Pickupmessage "$PU_JUNKSHIELD"
    Obituary "$OB_JUNKSHIELD"
    Tag "$TAG_JUNKSHIELD"
    weapon.ammotype "JunkShieldAmmo"
    inventory.icon "JSHISI"
    States
    {
    SpawnLoop:
        WEA3 N -1
        loop
    Ready:
        JARM A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_JUNKSHIELD)
        goto ReadyX
    ReadyX:
        JARM A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
        JARM A 1 A_WeaponReady
        loop
    Deselect:
        JARM A 0
        goto DeselectSwap
    Select:
        JARM A 0
        goto SelectSwap
    Altfire:
        JARM A 0 A_JumpIfNoAmmo("NoAmmo")
        JARM I 5
        goto ChargeAttack
    Fire:
        JARM A 0 A_JumpIfNoAmmo("NoAmmo")
        JARM A 1
        goto ChargeStart
    ChargeStart:
        JARM A 0 A_JumpIfNoAmmo("NoAmmo")
        JARM I 4
        JARM A 0 A_Refire("ChargeBegin")
        goto ChargeAttack
    ChargeBegin:
        JARM J 0 A_SpawnItemEx("JunkSpawnFX", 0, 0, 0, 0, 0, 0,0)
        JARM J 0 A_GiveInventory("ShieldCheck")
        JARM J 0 A_GiveInventory("WeaponCharge", 1)
        JARM J 0 A_GiveInventory("JunkChargeWait")
        JARM J 0 A_SpawnItemEx("JunkChargeWaitCooldowner")
        JARM J 0 A_GunFlash // Sound handler
        goto ChargeWait
    ChargeWaitCheck:
        JARM J 0 A_JumpIfInventory("JunkShieldCharge", 6, "ChargeWaitFull")
        JARM J 0 A_JumpIfInventory("JunkChargeWait", 1, "ChargeWait")
        goto ShieldCharge
    ChargeWait:
        JARM J 1
        JARM J 0 A_Refire("ChargeWaitCheck")
        goto ChargeAttack
    ShieldCharge:
        JARM J 0 A_SpawnItemEx("JunkSpawnFX", 0, 0, 0, 0, 0, 0, 0)
        JARM J 0 A_PlaySoundEx("weapons/mm7/junkshieldcharge", "body")
        JARM J 0 A_GiveInventory("JunkShieldCharge", 1)
        JARM J 0 A_GiveInventory("JunkChargeWait")
        JARM J 0 A_SpawnItemEx("JunkChargeWaitCooldowner")
        JARM J 0 A_JumpIfInventory("IsBot", 1, "BotFireMid")
        goto ChargeWait
    ChargeWaitFull:
        JARM J 1 A_RailWait
        JARM J 0 A_JumpIfInventory("IsBot", 1, "BotFireFull")
        JARM J 0 A_Refire("ChargeWaitFull")
        goto ChargeAttack
    ChargeAttack:
        JARM H 0 A_GunFlash("NoFlash", GFF_NOEXTCHANGE)
        JARM K 0 A_TakeInventory("WeaponCharge")
        JARM K 0 A_TakeInventory("ShieldCheck")
        JARM K 0 A_PlaySoundEx("weapons/mm7/junkshieldfire", "Weapon")
        JARM K 0 A_TakeInventory("JunkShieldAmmo", 4)
        JARM K 0 A_GiveInventory("FireJunkShieldStartU")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 1, "ShieldBlastStart")
        goto ShieldEnd
    ShieldBlastStart:
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 6, "ShieldBlast6")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 5, "ShieldBlast5")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 4, "ShieldBlast4")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 3, "ShieldBlast3")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 2, "ShieldBlast2")
        JARM K 0 A_JumpIfInventory("JunkShieldCharge", 1, "ShieldBlast1")
    ShieldBlast6:
        JARM K 0 A_GiveInventory("FireJunkShield6U")
    ShieldBlast5:
        JARM K 0 A_GiveInventory("FireJunkShield5U")
    ShieldBlast4:
        JARM K 0 A_GiveInventory("FireJunkShield4U")
    ShieldBlast3:
        JARM K 0 A_GiveInventory("FireJunkShield3U")
    ShieldBlast2:
        JARM K 0 A_GiveInventory("FireJunkShield2U")
    ShieldBlast1:
        JARM K 0 A_GiveInventory("FireJunkShield1U")
        goto ShieldEnd
    ShieldEnd:
        JARM K 0 A_TakeInventory("JunkShieldCharge")
        JARM K 1
        JARM K 2 offset(32, 64) // 32+32
        JARM K 2 offset(72, 104) // 32+72
        TNT1 A 7 A_WeaponReady(WRF_NOFIRE|WRF_DISABLESWITCH)
        JARM GH 2
        goto ReadyX
    Flash:
        TNT1 A 0 A_PlaySoundEx("weapon/junkshieldstart", "Weapon")
        TNT1 A 28
        TNT1 A 0 A_JumpIfInventory("WeaponCharge", 1, "Sound.JunkCharge")
        stop
	Sound.JunkCharge:
		TNT1 A 7 A_PlaySoundEx("weapon/junkshieldloop", "Weapon", 0)
		TNT1 A 1 A_JumpIfInventory("WeaponCharge", 1, "Sound.JunkCharge")
        stop
    BotFireMid:
        TNT1 A 0 A_Jump(25, "ChargeAttack")
        goto ChargeWait
    BotFireFull:
        TNT1 A 0 A_Jump(75, "ChargeAttack")
        goto ChargeWaitFull+2
    }
}

actor FireJunkShieldStartU : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS+WEPC_7JS_BACKOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS-WEPC_7JS_BACKOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS+WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS+WEPC_7JS_BACKOFFS+WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS-WEPC_7JS_BACKOFFS+WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS-WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS+WEPC_7JS_BACKOFFS-WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        TNT1 A 0 A_SpawnItemEx("JunkProjectileStartU",cos(pitch)*WEPC_7JS_SHOTOFFS, 8, 28-12, cos(pitch), 0, sin(-pitch), WEPC_7JS_BASEOFFS-WEPC_7JS_BACKOFFS-WEPC_7JS_SPREADOFFS, SXF_MULTIPLYSPEED)
        stop
    }
}


actor PlantBarrierWepU_MegaManUBar : MegaManUBar { Args 4, 39 }
actor PlantBarrierWepU_ScriptBar : ScriptBar {}

actor PlantBarrierWepU : BaseMegaManUWep replaces PlantBarrierWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 7
Inventory.Pickupmessage "$PU_PLANTBARRIER"
Obituary "$OB_PLANTBARRIER"
Tag "$TAG_PLANTBARRIER"
weapon.ammotype "PlantBarrierAmmo"
inventory.icon "PLANTSI"
States
{
SpawnLoop:
WEA2 T -1
loop
Ready:
PLAA A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_PLANTBARRIER)
PLAA A 0 A_ClearRefire
PLAA A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
PLAA A 1 A_WeaponReady
Goto Ready+2
Deselect:
PLAA A 0 A_TakeInventory("PlantWeakener", 1)
PLAA A 0 A_JumpIfInventory("ShieldCheck",1,1)
goto DeselectSwap
PLAA A 1 A_TakeInventory("ShieldCheck",1)
goto DeselectSwap
Select:
PLAA A 0
goto SelectSwap
Fire:
PLAA A 0 A_JumpIfInventory("ShieldCheck",1,"ShieldThrow")
PLAA A 0 A_JumpIfNoAmmo("NoAmmo")
PLAA A 0 A_PlaySoundEx("weapons/mm6/plantbarrieractivate","Weapon")
PLAA A 1 A_GiveInventory("ShieldCheck",1)
goto ShieldActive
ShieldActive:
PLAA B 0 A_SpawnItemEx("PlantBarrierWarper")
PLAA BCDEFGH 2
PLAA A 0 A_GiveInventory("PlantWeakener",1)
Goto ShieldLoop
ShieldLoop:
PLAA AA 1 A_WeaponReady
PLAA A 0 A_GiveInventory("PlantBarrierHealer", 1)
PLAA A 0 A_JumpIfNoAmmo("ShieldThrow")
PLAA A 0 A_JumpIfInventory("ShieldCheck", 1, "ShieldLoop")
Goto ShieldThrow
ShieldThrow:
PLAA A 0 A_TakeInventory("ShieldCheck",999)
PLAA A 0 A_JumpIfNoAmmo("ShieldThrow2")
PLAA A 0 A_PlaySoundEx("weapons/mm6/plantberrierfire","Weapon")
PLAA A 0 A_FireCustomMissile("PlantBarrierU", 0, 1, 0, 0)
Goto ShieldThrow2
ShieldThrow2:
PLAA A 0 A_TakeInventory("PlantWeakener",9999)
PLAA IJ 2
PLAA K 6
PLAA JI 3
PLAA AAAA 1 
goto Ready+1
NoAmmo:
PLAA A 0 ACS_NamedExecuteAlways("core_noammo",0)
PLAA A 0 A_TakeInventory("PlantWeakener", 1)
PLAA A 1 A_TakeInventory("ShieldCheck",999)
PLAA A 0 A_Refire
goto Ready+1
}
}


actor PlantBarrierU : PlantBarrier
{
damage (330)
}

actor WindStormWepU_MegaManUBar : MegaManUBar { Args 4, 93 }
actor WindStormWepU : BaseMegaManUWep replaces WindStormWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_WINDSTORM"
Obituary "$OB_WINDSTORM"
Tag "$TAG_WINDSTORM"
weapon.ammotype "WindStormAmmo"
inventory.icon "WINDSI"
States
{
SpawnLoop:
WEA2 V -1
loop
Ready:
BUBB D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_WINDSTORM)
goto ReadyX
ReadyX:
BUBB D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
BUBB D 1 A_WeaponReady
loop
Deselect:
BUBB D 0
goto DeselectSwap
Select:
BUBB D 0
goto SelectSwap
Fire:
BUBB D 0 A_JumpIfNoAmmo("NoAmmo")
BUBB D 0 A_PlaySoundEx("weapons/mm6/windstormfire","Weapon")
BUBB E 0 A_FireCustomMissile("WindStormStartU",0,1,8,0)
BUBB EF 5
BUBB D 2
BUBB D 0 A_Refire
goto ReadyX
}
}

actor WindStormStartU : WindStormStart
{
damage (CallACS("uh_TodayDmgMul", 150))
}

actor WindStormU : WindStorm
{
States
{
Spawn:
WINS A 0
WINS AA 2 A_Explode(CallACS("uh_TodayDmgMul", 150), 48, 0, 0, 48)
WINS B 0 A_CountDown
WINS BB 2 A_Explode(CallACS("uh_TodayDmgMul", 150), 48, 0, 0, 48)
WINS C 0 A_CountDown
WINS CC 2 A_Explode(CallACS("uh_TodayDmgMul", 150), 48, 0, 0, 48)
WINS D 0 A_CountDown
WINS DD 2 A_Explode(CallACS("uh_TodayDmgMul", 150), 48, 0, 0, 48)
WINS A 0 A_CountDown
loop
}
}

actor SilverTomahawkWepU_MegaManUBar : MegaManUBar { Args 52, 220 }
actor SilverTomahawkWepU : BaseMegaManUWep replaces SilverTomahawkWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_SILVERTOMAHAWK"
Obituary "$OB_SILVERTOMAHAWK"
TAG "$TAG_SILVERTOMAHAWK"
weapon.ammotype "SilverTomahawkAmmo"
inventory.icon "TOMASI"
States
{
SpawnLoop:
WEA2 U -1
loop
Ready:
TOMA C 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SILVERTOMAHAWK)
goto ReadyX
Deselect:
TOMA C 0
goto DeselectSwap
Select:
TOMA C 0
goto SelectSwap
Fire:
TOMA C 0 A_JumpIfNoAmmo("NoAmmo")
TOMA C 0 A_PlaySoundEx("weapons/mm6/silvertomahawkfire","Weapon")
TOMA C 0 A_FireCustomMissile("SilverTomahawkU",0,1,8,0)
TOMA ED 2
TOMA C 20
TOMA C 0 A_Refire
Goto ReadyX
NoAmmo:
TOMA C 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}


actor SilverTomahawkU : SilverTomahawk
{
damage (300)
}

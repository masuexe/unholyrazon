// Hail weather visual + Moonlight heal reduction via rz_SetHailWeather / rz_IsHailWeather.

actor BlizzardAttackWepU_MegaManUBar : MegaManUBar { Args 4, 197 }
actor BlizzardAttackWepU : BaseMegaManUWep replaces BlizzardAttackWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_BLIZZARDATTACK"
Obituary "$OB_BLIZZARDATTACK"
Tag "$TAG_BLIZZARDATTACK"
weapon.ammotype "BlizzardAttackAmmo"
inventory.icon "BLIZSI"
States
{
SpawnLoop:
WEAP W -1
loop
Ready:
BLIZ D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_BLIZZARDATTACK)
goto ReadyX
Deselect:
BLIZ D 0
goto DeselectSwap
Select:
BLIZ D 0
goto SelectSwap
Fire:
BLIZ D 0 A_JumpIfNoAmmo("NoAmmo")
BLIZ D 0 A_PlaySoundEx("weapons/mm6/blizzardattackfire","Weapon")
BLIZ D 0 ACS_NamedExecuteAlways("rz_SetHailWeather", 0)
BLIZ D 0 A_FireCustomMissile("BlizzardAttackU",12,1,52,0)
BLIZ D 0 A_FireCustomMissile("BlizzardAttackU",-12,0,-52,0)
BLIZ EE 2
BLIZ F 1
BLIZ D 0 A_FireCustomMissile("BlizzardAttackU",0,0,32,0)
BLIZ D 0 A_FireCustomMissile("BlizzardAttackU",0,0,-32,0)
BLIZ FD 5
BLIZ D 20
BLIZ D 0 A_Refire
Goto ReadyX
NoAmmo:
BLIZ D 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}


actor BlizzardAttackU : BlizzardAttack
{
damage (170)
}

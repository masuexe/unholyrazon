actor YamatoSpearWepU_MegaManUBar : MegaManUBar { Args 4, 236 }
actor YamatoSpearWepU : BaseMegaManUWep replaces YamatoSpearWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 3
Inventory.Pickupmessage "$PU_YAMATOSPEAR"
Obituary "$OB_YAMATOSPEAR"
Tag "$TAG_YAMATOSPEAR"
weapon.ammotype "YamatoSpearAmmo"
inventory.icon "YAMASI"
States
{
SpawnLoop:
WEA2 R -1
loop
Ready:
YAMA B 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_YAMATOSPEAR)
YAMA B 1 A_WeaponReady
Goto Ready+1
Deselect:
YAMA B 0
goto DeselectSwap
Select:
YAMA B 0
goto SelectSwap
Fire:
Hold:
YAMA B 0 A_JumpIfNoAmmo("NoAmmo")
YAMA B 0 A_PlaySoundEx("weapons/mm6/yamatospearfire","Weapon")
YAMA C 0 A_FireCustomMissile("YamatoSpearU",0,0,8,0)
YAMA C 2
YAMA D 2
YAMA B 1
YAMA B 0 A_PlaySoundEx("weapons/mm6/yamatospearfire","Weapon")
YAMA D 0 A_FireCustomMissile("YamatoSpearU",3,0,8,0)
YAMA C 2
YAMA D 2
YAMA B 1
YAMA B 0 A_PlaySoundEx("weapons/mm6/yamatospearfire","Weapon")
YAMA B 0 A_FireCustomMissile("YamatoSpearU",-3,1,8,0)
YAMA C 2
YAMA D 2
YAMA B 1
YAMA B 0 A_Refire
Goto Ready+1
NoAmmo:
YAMA B 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor YamatoSpearU : YamatoSpear
{
damage (90)
}

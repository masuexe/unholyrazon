actor CommandoBombWepU_MegaManUBar : MegaManUBar { Args 88, 222 }
actor CommandoBombWepU : BaseMegaManUWep replaces CommandoBombWep
{
Weapon.AmmoUse 5
Weapon.AmmoGive 30
Weapon.SlotNumber 5
Obituary "$OB_COMMANDOBOMB"
Tag "$TAG_COMMANDOBOMB"
Inventory.Pickupmessage "$PU_COMMANDOBOMB"
weapon.ammotype "CommandoBombAmmo"
inventory.icon "COMMAI"
States
{
SpawnLoop:
COMM A -1
loop
Ready:
COMM I 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_COMMANDOBOMB)
goto ReadyX
ReadyX:
COMM I 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
COMM I 1 A_WeaponReady
loop
Deselect:
COMM I 0 A_JumpIfInventory("CommandoSwitch",1,1)
goto DeselectSwap
COMM I 10 A_TakeInventory("CommandoSwitch")
goto DeselectSwap
Select:
COMM I 0
goto SelectSwap
AltFire:
COMM I 0 A_JumpIfNoAmmo("NoAmmo")
COMM I 0 A_PlaySoundEx("weapons/mm10/commandobombfire","Weapon")
COMM I 0 A_FireCustomMissile("CommandoBombSecondary",0,1,8,0)
COMM B 0 A_GiveInventory("CommandoCooldown", WEPC_10CB_COOLDOWN)
COMM JK 4
goto Cooldown
Fire:
COMM I 0 A_JumpIfInventory("CommandoSwitch",1,"Change")
COMM I 0 A_JumpIfInventory("CommandoCooldown", 1, "Cooldown")
COMM I 0 A_JumpIfNoAmmo("NoAmmo")
COMM I 0 A_PlaySoundEx("weapons/mm10/commandobombfire","Weapon")
COMM I 0 A_FireCustomMissile("CommandoBombU",0,1,8,0)
COMM B 0 A_GiveInventory("CommandoSwitch",1)
COMM B 0 A_GiveInventory("CommandoCooldown", WEPC_10CB_COOLDOWN)
COMM B 0 A_JumpIfInventory("IsBot", 1, "BotWait")
COMM JK 4
goto Hold
Hold:
COMM I 1 A_RailWait
COMM I 0 A_Refire
COMM I 1 A_GiveInventory("CommandoSwitch",1)
COMM I 0 A_TakeInventory("CommandoSwitch")
Goto Cooldown
Cooldown:
COMM I 1 A_TakeInventory("CommandoCooldown", 1)
COMM I 0 A_JumpIfInventory("CommandoCooldown", 1, "Cooldown")
goto ReadyX
BotWait:
COMM I 10
goto ReadyX
Change:
COMM I 1 A_GiveInventory("CommandoSwitch",1)
COMM I 0 A_TakeInventory("CommandoSwitch")
Goto Cooldown
}
}

actor CommandoBombU : CommandoBomb replaces CommandoBomb
{
damage (CallACS("uh_TodayDmgMul", 200))
}

actor CommandoBombDamagerAU : CommandoBombDamagerA replaces CommandoBombDamagerA
{
damage (CallACS("uh_TodayDmgMul", 60))
}

actor CommandoBombDamagerBU : CommandoBombDamagerAU replaces CommandoBombDamagerB { height 40  }
actor CommandoBombDamagerCU : CommandoBombDamagerAU replaces CommandoBombDamagerC { height 75  }
actor CommandoBombDamagerDU : CommandoBombDamagerAU replaces CommandoBombDamagerD { height 112 }

actor CommandoBombDamagerXU : CommandoBombDamagerAU replaces CommandoBombDamagerX { damage (CallACS("uh_TodayDmgMul", 30)) }
actor CommandoBombDamagerYU : CommandoBombDamagerBU replaces CommandoBombDamagerY { damage (CallACS("uh_TodayDmgMul", 30)) }
actor CommandoBombDamagerZU : CommandoBombDamagerCU replaces CommandoBombDamagerZ { damage (CallACS("uh_TodayDmgMul", 30)) }

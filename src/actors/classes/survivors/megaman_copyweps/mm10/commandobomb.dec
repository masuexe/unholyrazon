actor CommandoBombWepU_MegaManUBar : MegaManUBar {Args 88, 222}
actor CommandoBombWepU : BaseMegaManUWep replaces CommandoBombWep {
  Weapon.AmmoUse 5
  Weapon.AmmoGive 30
  Weapon.SlotNumber 5
  Obituary "$OB_COMMANDOBOMB"
  Tag "$TAG_COMMANDOBOMB"
  Inventory.Pickupmessage "$PU_COMMANDOBOMB"
  Weapon.AmmoType "CommandoBombAmmo"
  Inventory.Icon "COMMAI"
  States {
   SpawnLoop:
    COMM A -1
    loop
   Ready:
    COMM I 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_COMMANDOBOMB)
    goto ReadyX
   ReadyX:
    COMM I 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    COMM I 1 A_WeaponReady
    loop
   Deselect:
    COMM I 0 A_JumpIfInventory("CommandoSwitch", 1, 1)
    goto DeselectSwap
    COMM I 10 A_TakeInventory("CommandoSwitch")
    goto DeselectSwap
   Select:
    COMM I 0
    goto SelectSwap
   AltFire:
    COMM I 0 A_JumpIfNoAmmo("NoAmmo")
    COMM I 0 A_PlaySoundEx("weapons/mm10/commandobombfire", "Weapon")
    COMM I 0 A_FireCustomMissile("CommandoBombSecondaryU", 0, 1, 8, 0)
    COMM B 0 A_GiveInventory("CommandoCooldown", WEPC_10CB_COOLDOWN)
    COMM JK 4
    goto Cooldown
   Fire:
    COMM I 0 A_JumpIfInventory("CommandoSwitch", 1, "Change")
    COMM I 0 A_JumpIfInventory("CommandoCooldown", 1, "Cooldown")
    COMM I 0 A_JumpIfNoAmmo("NoAmmo")
    COMM I 0 A_PlaySoundEx("weapons/mm10/commandobombfire", "Weapon")
    COMM I 0 A_FireCustomMissile("CommandoBombU", 0, 1, 8, 0)
    COMM B 0 A_GiveInventory("CommandoSwitch", 1)
    COMM B 0 A_GiveInventory("CommandoCooldown", WEPC_10CB_COOLDOWN)
    COMM B 0 A_JumpIfInventory("IsBot", 1, "BotWait")
    COMM JK 4
    goto Hold
   Hold:
    COMM I 1 A_RailWait
    COMM I 0 A_ReFire
    COMM I 1 A_GiveInventory("CommandoSwitch", 1)
    COMM I 0 A_TakeInventory("CommandoSwitch")
    Goto Cooldown
   Cooldown:
    COMM I 1 A_TakeInventory("CommandoCooldown", 1)
    COMM I 0 A_JumpIfInventory("CommandoCooldown", 1, "Cooldown")
    goto ReadyX
   BotWait:
    COMM I 10
    goto ReadyX
   Change:
    COMM I 1 A_GiveInventory("CommandoSwitch", 1)
    COMM I 0 A_TakeInventory("CommandoSwitch")
    Goto Cooldown
  }
}

actor CommandoBombU : CommandoBomb {
  Damage (CallACS("uh_TodayDmgMul", 250))
  States {
   Death2:
    COMM B 0 A_PlaySoundEx("weapons/mm10/commandobombexplosion", "Weapon")
    COMM B 0 A_SpawnItemEx("CommandoBombExplosionU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 35 A_SpawnItemEx("CommandoTrailFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

actor CommandoBombSecondaryU : CommandoBombSecondary {
  Damage (CallACS("uh_TodayDmgMul", 250))
  States {
   Death2:
    COMM B 0 A_PlaySoundEx("weapons/mm10/commandobombexplosion", "Weapon")
    COMM B 0 A_SpawnItemEx("CommandoBombExplosionU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 35 A_SpawnItemEx("CommandoTrailFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

actor CommandoBombExplosionU : CommandoBombExplosion {
  States {
   Explode:
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveTrailU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 0*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 1*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 2*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 3*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 4*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 5*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 6*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveU", 0, 0, 0, 1, 0, 0, 7*45, SXF_MULTIPLYSPEED|SXF_TRANSFERPOINTERS)
    TNT1 A 70
    stop
  }
}

actor CommandoBombWaveU : CommandoBombWave {
  States {
   Spawn2:
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("CommandoBombWaveTrailU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    goto SpawnEnd
  }
}

actor CommandoBombWaveTrailU : CommandoBombWaveTrail {
  States {
   Spawn:
    ETRA A 0 nodelay A_SetUserVar("user_CompositePierceRipper", 5)
    ETRA A 1
    ETRA B 1 A_SpawnItemEx("CommandoBombDamagerYU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    ETRA C 1 A_SpawnItemEx("CommandoBombDamagerZU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    ETRA D 1 A_SpawnItemEx("CommandoBombDamagerDU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    ETRA C 1 A_SpawnItemEx("CommandoBombDamagerCU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    ETRA B 1 A_SpawnItemEx("CommandoBombDamagerBU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    ETRA A 1 A_SpawnItemEx("CommandoBombDamagerAU", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS)
    stop
  }
}

actor CommandoBombDamagerAU : CommandoBombDamagerA {
  Damage (CallACS("uh_TodayDmgMul", 120))
}

actor CommandoBombDamagerBU : CommandoBombDamagerAU { Height 40 }
actor CommandoBombDamagerCU : CommandoBombDamagerAU { Height 75 }
actor CommandoBombDamagerDU : CommandoBombDamagerAU { Height 112 }

actor CommandoBombDamagerXU : CommandoBombDamagerAU { Damage (CallACS("uh_TodayDmgMul", 60)) }
actor CommandoBombDamagerYU : CommandoBombDamagerBU { Damage (CallACS("uh_TodayDmgMul", 60)) }
actor CommandoBombDamagerZU : CommandoBombDamagerCU { Damage (CallACS("uh_TodayDmgMul", 60)) }

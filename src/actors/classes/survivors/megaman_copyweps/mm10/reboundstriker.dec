actor ReboundStrikerWepU_MegaManUBar : MegaManUBar { Args 38, 251 }
actor ReboundStrikerWepU : BaseMegaManUWep replaces ReboundStrikerWep
{
Weapon.AmmoUse 3
Weapon.AmmoGive 33
Weapon.SlotNumber 2
Obituary "$OB_REBOUNDSTRIKER"
Tag "$TAG_REBOUNDSTRIKER"
Inventory.Pickupmessage "$PU_REBOUNDSTRIKER"
weapon.ammotype "ReboundStrikerAmmo"
inventory.icon "STRIKI"
States
{
SpawnLoop:
STRI A -1
loop
Ready:
RSHD A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_REBOUNDSTRIKER)
RSHD A 0 A_JumpIfNoAmmo("ReadyNoAmmo")
RSHD A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
RSHD A 1 A_WeaponReady
Goto Ready+1
ReadyNoAmmo:
RSHD J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
RSHD J 1 A_WeaponReady(WRF_NOFIRE)
RSHD J 0 A_JumpIfNoAmmo("ReadyNoAmmo")
Goto Ready+1
Deselect:
RSHD A 0
goto DeselectSwap
Select:
RSHD A 0
goto SelectSwap
Fire:
RSHD A 0 A_JumpIfNoAmmo("NoAmmo")
RSHD A 0 A_PlaySoundEx("weapons/mm10/reboundstrikerfire", "weapon")
RSHD A 0 A_FireCustomMissile("ReboundStrikerU", 0, 1, 8, -10)
RSHD BCDEFG 1
TNT1 A 19
RSHD H 0 A_JumpIfNoAmmo("NoAmmoDelay")
RSHD HI 2
RSHD A 0 A_Refire
Goto Ready+1
NoAmmoDelay:
RSHD KL 2
Goto ReadyNoAmmo
NoAmmo:
RSHD J 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo",0)
Goto ReadyNoAmmo
}
}

const int WEPC_10RSU_DMGADD = 150;

actor ReboundStrikerU : ReboundStriker
{
damage (300+user_bouncenum)
States
{
Spawn:
STRI BC 2
STRI B 0 A_JumpIf(user_bouncenum > 0, "Spawn2")
loop
Bounce:
STRI D 0 A_SetUserVar(user_bouncenum, user_bouncenum+150)
STRI D 0 A_JumpIf(user_bouncenum > 150, 1)//2
goto Spawn2
STRI E 0 A_ChangeVelocity
goto Spawn3
STRI E 0 A_SpawnItemEx("ReboundStrikerMaxU",0,0,0,momx,momy,momz,0,8)
stop
Spawn2:
STRI DF 2
STRI B 0 A_JumpIf(user_bouncenum > WEPC_10RSU_DMGADD, "Spawn2")
loop
Spawn3:
STRI EG 2 BRIGHT
loop
Death:
TNT1 A 0 A_SpawnItemEx("ExplosionEffect1",0,0,10,0,0,0,0,SXF_WEPFXCOLOR)
stop
}
}

actor ReboundStrikerMaxU : ReboundStrikerMax
{
damage (600)
}

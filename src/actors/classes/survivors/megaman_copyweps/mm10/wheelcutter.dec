actor WheelCutterWepU_MegaManUBar : MegaManUBar {Args 4, 95}
actor WheelCutterWepU_ScriptBar : ScriptBar {}

actor WheelCutterWepU : BaseMegaManUWep replaces WheelCutterWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Obituary "$OB_WHEELCUTTER"
  Tag "$TAG_WHEELCUTTER"
  Inventory.Pickupmessage "$PU_WHEELCUTTER"
  Weapon.AmmoType "WheelCutterAmmo"
  Inventory.Icon "WHEELI"
  States {
   SpawnLoop:
    WHEE A -1
    loop
   Ready:
    WHEE I 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_WHEELCUTTER)
    WHEE I 0 A_TakeInventory("WheelCutterCheck")
   ReadyX:
    WHEE I 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    WHEE I 1 A_WeaponReady
    loop
   Deselect:
    WHEE I 0
    goto DeselectSwap
   Select:
    WHEE I 0
    goto SelectSwap
   Fire:
    WHEE I 0 A_JumpIfNoAmmo("NoAmmo")
    WHEE J 0 A_TakeInventory("WheelCutterAmmo", 2, TIF_NOTAKEINFINITE)
    WHEE J 0 A_PlaySoundEx("weapons/mm10/wheelcutteractivate", "Weapon")
    WHEE J 0 A_GiveInventory("WheelCutterCheck", 105)
    WHEE J 1
    WHEE J 0 A_GiveInventory("FireWheelSaw")
    WHEE I 0 A_ReFire
    goto Throw
   Hold:
    WHEE J 0 A_JumpIfInventory("WheelCutterCheck", 1, "HoldLoop")
    goto Throw
   HoldLoop:
    WHEE J 1
    WHEE J 0 A_ReFire("HoldLoop2")
    goto Throw
   HoldLoop2:
    WHEE J 1
    WHEE J 0 A_ReFire("HoldLoop3")
    goto Throw
   HoldLoop3:
    WHEE J 1
    WHEE J 0 A_ReFire("HoldLoop4")
    goto Throw
   HoldLoop4:
    WHEE J 1
    WHEE J 0 A_ReFire("HoldLoop5")
    goto Throw
   HoldLoop5:
    WHEE J 1
    WHEE J 0 A_TakeInventory("WheelCutterCheck", 1)
    WHEE J 0 A_JumpIfInventory("WheelCutterDestroy", 1, "End")
    WHEE J 0 A_JumpIfInventory("IsBot", 1, "Throw")
    WHEE J 0 A_ReFire
    goto Throw
   Altfire:
    WHEE I 0 A_JumpIfNoAmmo("NoAmmo")
    WHEE J 0 A_PlaySoundEx("weapons/mm10/wheelcutteractivate", "Weapon")
    WHEE J 1
   Throw:
    WHEE J 0 A_TakeInventory("WheelCutterCheck")
    WHEE J 0 A_TakeInventory("WheelCutterDestroy")
    WHEE J 0 A_PlaySoundEx("weapons/mm10/wheelcutterfire", "weapon")
    WHEE J 0 A_FireCustomMissile("WheelCutterLaunchPlacer", 0, 1, 8, -16)
    WHEE JK 3
    WHEE I 0 A_TakeInventory("WheelCutterCheck")
    WHEE I 16
    WHEE I 0 A_ClearReFire
    goto Ready+1
   End:
    WHEE J 1
    WHEE J 0 A_TakeInventory("WheelCutterDestroy")
    WHEE JK 3
    WHEE J 0 A_TakeInventory("WheelCutterCheck")
    WHEE I 10
    WHEE I 0 A_ClearReFire
    goto Ready+1
  }
}

actor WheelCutterWallClimbU : CustomInventory {
  +INVENTORY.AUTOACTIVATE
  States {
   Use:
    TNT1 A 0 A_FireCustomMissile("WheelCutterWallCheck", 0, 0, 8, 0)  // A_SpawnItemEx("WheelCutterWallCheck", 0, 0, 24, 64)
    TNT1 A 0 A_FireCustomMissile("WheelCutterSawDamageU", 0, 0, 8, 0)
    stop
  }
}

actor WheelCutterSawDamageU : WheelCutterSawDamage replaces WheelCutterSawDamage {
  Damage (CallACS("uh_TodayDmgMul", 30))
}

actor WheelCutterMasterU : WheelCutterMaster replaces WheelCutterMaster {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

actor WheelCutterMasterFastU : WheelCutterMasterFast replaces WheelCutterMasterFast {
  Damage (CallACS("uh_TodayDmgMul", 200))
}

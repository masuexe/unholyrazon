actor SolarBlazeWepU_MegaManUBar : MegaManUBar { Args 248, 222 }
actor SolarBlazeWepU : BaseMegaManUWep replaces SolarBlazeWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 30
Weapon.SlotNumber 5
Obituary "$OB_SOLARBLAZE"
Tag "$TAG_SOLARBLAZE"
Inventory.Pickupmessage "$PU_SOLARBLAZE"
weapon.ammotype "SolarBlazeAmmo"
inventory.icon "SOLARI"
States
{
SpawnLoop:
SOLA A -1
loop
Ready:
SOLA F 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SOLARBLAZE)
goto ReadyX
Deselect:
SOLA F 0
goto DeselectSwap
Select:
SOLA F 0
goto SelectSwap
Fire:
SOLA F 0 A_JumpIfNoAmmo("NoAmmo")
SOLA F 0 A_PlaySoundEx("weapons/mm10/solarblazefire","Weapon")
SOLA F 0 A_FireCustomMissile("SolarBlazeU",0,1,8,-16)
SOLA F 0 A_GiveInventory("SolarBlazeCooldown", 1)
SOLA GH 3
SOLA F 0 A_JumpIfInventory("IsBot", 1, "BotCheck")
SOLA F 0 A_Refire
Goto Hold
AltFire:
SOLA F 0 A_JumpIfNoAmmo("NoAmmo")
SOLA F 0 A_PlaySoundEx("weapons/mm10/solarblazefire","Weapon")
SOLA F 0 A_FireCustomMissile("SolarBlazeU",0,1,8,-16)
SOLA GH 3
SOLA F 1
SOLA F 2 A_GiveInventory("SolarBlazeFlag",2)
SOLA F 27
SOLA F 0 A_TakeInventory("SolarBlazeFlag",999)
SOLA F 0 A_ClearRefire
Goto ReadyX
Hold:
SOLA F 1 A_RailWait
SOLA F 0 A_Refire
Release:
SOLA F 5 A_GiveInventory("SolarBlazeFlag",2)
SOLA F 0 A_TakeInventory("SolarBlazeFlag",999)
ReleaseWait:
SOLA F 1 A_RailWait
SOLA F 0 A_JumpIfInventory("SolarBlazeCooldown", 1, "ReleaseWait")
SOLA F 1 A_JumpIf(true, "ReleaseEnd")
wait
ReleaseEnd:
SOLA F 0
Goto ReadyX
BotCheck:
SOLA F 5 A_RailWait
SOLA F 0 A_Jump(128, "BotCheck")
Goto Hold+2
}
}

actor SolarBlazeU : SolarBlaze
{
damage (CallACS("uh_TodayDmgMul", 230))
States
{
Spawn:
SOLA BBBCCCBBBCCCBBBCCCBBBCCCBBBCCCBBBCCC 1 A_JumpIfInTargetInventory("SolarBlazeFlag", 2, "FlyEnd")
FlyEnd:
SOLA B 0 A_Stop
SOLA BC 3
SOLA B 1 A_Countdown
wait
Death:
TNT1 B 0 A_PlaySoundEx("weapons/mm10/solarblazesplit","weapon")
TNT1 B 0 A_SpawnItemEx("SolarWaveU",0,0,0,1.0,0,0,0,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWaveU",0,0,0,1.0,0,0,90,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWaveU",0,0,0,1.0,0,0,-90,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWaveU",0,0,0,1.0,0,0,180,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWave2U",0,0,0,1.0,0,0,45,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWave2U",0,0,0,1.0,0,0,135,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWave2U",0,0,0,1.0,0,0,-135,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("SolarWave2U",0,0,0,1.0,0,0,-45,SXF_MULTIPLYSPEED)
TNT1 B 0 A_SpawnItemEx("OilPitIgnite",0,0,-16)
TNT1 A 35 A_SpawnItemEx("ExplosionEffect1", 0, 0, 16, 0, 0, 0, 0, SXF_WEPFXCOLOR)
stop
}
}

actor SolarBlazeAltU : SolarBlazeAlt {damage (CallACS("uh_TodayDmgMul", 230))}

actor SolarWaveU : SolarWave
{
damage (CallACS("uh_TodayDmgMul", 170))
States
{
Spawn:
SOLA D 0
SOLA Z 1
SOLA Z 0 A_ChangeFlag(THRUACTORS, false)
SOLA Z 0 A_JumpIf(true, "SpawnLoop")
SpawnLoop:
SOLA DE 2
loop
}
}

actor SolarWave2U : SolarWaveU
{
States
{
SpawnLoop:
SOLA DEDEDEDEDEDEDEDEDEDE 2
stop
}
}

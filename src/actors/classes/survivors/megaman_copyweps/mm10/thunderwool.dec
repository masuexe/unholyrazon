actor ThunderWoolWepU_MegaManUBar : MegaManUBar { Args 248, 95 }
actor ThunderWoolWepU : BaseMegaManUWep replaces ThunderWoolWep
{
Weapon.AmmoUse 3
Weapon.AmmoGive 30
Weapon.SlotNumber 4
Obituary "$OB_THUNDERWOOL"
Tag "$TAG_THUNDERWOOL"
Inventory.Pickupmessage "$PU_THUNDERWOOL"
weapon.ammotype "ThunderWoolAmmo"
inventory.icon "TWOOLI"
States
{
SpawnLoop:
THWO A -1
loop
Ready:
THWO N 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_THUNDERWOOL)
goto ReadyX
Deselect:
THWO N 0
goto DeselectSwap
Select:
THWO N 0
goto SelectSwap
Fire:
THWO N 0 A_JumpIfNoAmmo("NoAmmo")
THWO N 0 A_PlaySoundEx("weapons/mm10/thunderwoolfire","Weapon")
THWO N 0 A_FireCustomMissile("ThunderWoolMovableU",0,1,8,0)
THWO OP 6
THWO N 18
THWO N 0 A_Refire
Goto ReadyX
AltFire:
THWO N 0 A_JumpIfNoAmmo("NoAmmo")
THWO N 0 A_PlaySoundEx("weapons/mm10/thunderwoolfire","Weapon")
THWO N 0 A_FireCustomMissile("ThunderWoolU",0,1,8,0)
THWO OP 6
THWO N 18
THWO N 0 A_Refire
Goto ReadyX
NoAmmo:
THWO N 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}

actor ThunderWoolU : ThunderWool
{
States
{
Spawn:
THWO B 0
THWO BCBC 3 ThrustThingZ(0,9,0,1)
THWO E 0 ThrustThingZ(0,9,0,1)
THWO EEBDDCEEB 1
THWO B 0 A_SpawnItemEx("ThunderWoolLightninginatorU")
stop
}
}

actor ThunderWoolMovableU : ThunderWool
{
States
{
Spawn:
THWO B 0
THWO BCBC 3 ThrustThingZ(0,9,0,1)
THWO E 0 ThrustThingZ(0,9,0,1)
THWO EEBDDCEEB 1
THWO B 0 A_SpawnItemEx("ThunderWoolLightninginatorU",0,0,0,12,0,0)
stop
}
}

actor ThunderWoolLightninginatorU : ThunderWoolU
{
	+BRIGHT
    States
    {
    Spawn:
        THWO F 0
        THWO F 0 A_PlaySoundEx("weapons/mm10/thunderwoolexplode","Weapon")
        THWO F 0 A_SetUserVar(user_atFloor, (z-floorz)<96)
        THWO F 0 A_JumpIf(z-floorz < 64, "SpawnLoopFloor")
        goto SpawnLoop
    Spawnloop:
        THWO B 0 A_SpawnItemEx("ThunderWoolCloudUFX")
        THWO B 0 A_SpawnItemEx("ThunderWoolLightningU", 0, 0, !user_atFloor*-96 + user_atFloor*-(z-floorz))
        THWO B 0 A_SpawnItemEx("ThunderWoolRadiusU", 0, 0, -(z-floorz))
        THWO CGGG 1
        THWO B 0 A_SpawnItemEx("ThunderWoolLightningU", 0, 0, !user_atFloor*-96 + user_atFloor*-(z-floorz))
        THWO BFFF 1
        THWO C 0 A_CountDown
        loop
    SpawnLoopFloor:
        THWO B 0 A_SpawnItemEx("ThunderWoolRadiusU", 0, 0, -(z-floorz))
        THWO CGGGBFFF 1
        THWO C 0 A_CountDown
        loop
    }
}

actor ThunderWoolCloudUFX : BasicGraphicEffect
{
+BRIGHT
States
{
SpawnFrame:
THWO C 0
THWO CGGGB 1
THWO FFF 1 A_FadeOut(0.25)
stop
}
}

actor ThunderWoolLightningU : ThunderWoolLightning
{
    damage (100)
	States
	{
	    Spawn:
	    	TNT1 A 0
	    	TNT1 A 0 A_SpawnItemEX("ElectrifyEffect")
            TNT1 A 0 A_JumpIf(z-floorz < 64, "FloorCheck")
	    	TNT1 A 0 A_SpawnItemEx("ThunderWoolLightningU", 0, 0, -64)
            goto SpawnWait
        FloorCheck:
            TNT1 A 0 A_JumpIf(z-floorz < 8, "SpawnWait")
            TNT1 A 0 A_SpawnItemEx("ThunderWoolLightningU", 0, 0, -(z-floorz))
            goto SpawnWait
	}
}

actor ThunderWoolRadiusU : ThunderWoolRadius
{
	States {
	    Spawn:
            TNT1 A 0
            TNT1 A 0 A_SpawnItemEx("ThunderWoolImpact", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
	    	TNT1 A 0 A_SpawnItemEX("ElectrifyEffect")
            TNT1 A 0 A_Explode(130, WEPC_10TW_RADIUS, 0, 0, WEPC_10TW_RADIUS)
            TNT1 AAAAAAAAAA 0 A_SpawnItemEx("ThunderWoolSparkFX", frandom(-WEPC_10TW_RADIUS, WEPC_10TW_RADIUS), frandom(-WEPC_10TW_RADIUS, WEPC_10TW_RADIUS), frandom(0, WEPC_10TW_RADIUS), 0, 0, 0, 0, SXF_WEPFXCOLOR)
            TNT1 A 1
	    	TNT1 A 0 A_SetUserVar(user_arcnum, WEPC_10TW_ARCMAX+1)
	    SpawnArcs:
	    	TNT1 A 0 A_SpawnItemEx("ThunderWoolArc", 16, 0, 0, 0, 0, 0, user_arcnum*(360/WEPC_10TW_ARCMAX), SXF_CLIENTSIDE|SXF_ABSOLUTEANGLE|SXF_WEPFXCOLOR)
	    	TNT1 A 0 A_SetUserVar(user_arcnum, user_arcnum-1)
	    	TNT1 A 0 A_JumpIf(user_arcnum > 0, "SpawnArcs")
	    	TNT1 A 1 A_JumpIf(true, "End")
	    	wait
	}
}

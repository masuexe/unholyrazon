actor TripleBladeWepU_MegaManUBar : MegaManUBar { Args 4, 251 }
actor TripleBladeWepU : BaseMegaManUWep replaces TripleBladeWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 3
Obituary "$OB_TRIPLEBLADE"
Tag "$TAG_TRIPLEBLADE"
Inventory.Pickupmessage "$PU_TRIPLEBLADE"
weapon.ammotype "TripleBladeAmmo"
inventory.icon "BLAWI"
+WEAPON.NOAUTOAIM
States
{
SpawnLoop:
TRIP A -1
loop
Ready:
TRIP B 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_TRIPLEBLADE)
goto ReadyX
Deselect:
TRIP C 0
goto DeselectSwap
Select:
TRIP C 0
goto SelectSwap
Fire:
TRIP C 0 A_JumpIfNoAmmo("NoAmmo")
TRIP C 0 A_PlaySoundEx("weapons/mm10/triplebladefire","Weapon")
TNT1 A 0 A_FireCustomMissile("TripleBladeCenterU",0,1,8,0,1,0)
TNT1 A 0 A_FireCustomMissile("TripleBladeU",11.25,0,8,0,1,0)
TNT1 A 0 A_FireCustomMissile("TripleBladeU",-11.25,0,8,0,1,0)
TRIP C 0 A_JumpIf(pitch > 270 && pitch < 270+11.25, "Top")
TRIP C 0 A_JumpIf(pitch > 90-11.25 && pitch < 90, "Bottom")
goto Center
Top:
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180+11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180-11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",0,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",11.25,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",-11.25,0,8,0,0,-11.25)
goto FireEnd
Bottom:
TRIP C 0 A_FireCustomMissile("TripleBladeU",0,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",-11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180+11.25,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeRU",180-11.25,0,8,0,0,-11.25)
goto FireEnd
Center:
TRIP C 0 A_FireCustomMissile("TripleBladeU",0,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",-11.25,0,8,0,0,11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",0,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",11.25,0,8,0,0,-11.25)
TRIP C 0 A_FireCustomMissile("TripleBladeU",-11.25,0,8,0,0,-11.25)
goto FireEnd
FireEnd:
TRIP DE 2
TRIP C 8
goto ReadyX
}
}

actor TripleBladeU : TripleBlade {damage (20)}
actor TripleBladeCenterU : TripleBlade {damage (50)}
actor TripleBladeRU : TripleBladeR {damage (20)}

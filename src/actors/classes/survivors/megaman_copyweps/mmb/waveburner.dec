actor WaveBurnerWepU_MegaManUBar : MegaManUBar {Args 218, 40}
actor WaveBurnerWepU : BaseMegaManUWep replaces WaveBurnerWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 56
  Weapon.SlotNumber 3
  Inventory.Pickupmessage "$PU_WAVEBURNER"
  Obituary "$OB_WAVEBURNER"
  Tag "$TAG_WAVEBURNER"
  Weapon.AmmoType "WaveBurnerAmmo"
  Inventory.Icon "BURNRI"
  States {
   SpawnLoop:
    WABU X -1
    loop
   Ready:
    WAVB K 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_WAVEBURNER)
    goto ReadyX
   ReadyX:
    WAVB K 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    WAVB K 1 A_WeaponReady
    loop
   Deselect:
    WAVB K 0
    goto DeselectSwap
   Select:
    WAVB K 0
    goto SelectSwap
   Fire:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB K 2
   UnderWater0:
    WAVB L 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    Goto Fire1
   UnderWater:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_GunFlash
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnUW", 0, 1, 8, 0)
    WAVB L 0 A_ReFire("UnderWater2")
    Goto End
   UnderWater2:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnUW", 0, 0, 8, 0)
    WAVB L 0 A_ReFire("UnderWater0")
    Goto End
   Fire1:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 0, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire2")
    goto End
   Fire2:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 5, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire3")
    goto End
   Fire3:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 10, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire4")
    goto End
   Fire4:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 15, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire5")
    goto End
   Fire5:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 10, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire6")
    goto End
   Fire6:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 5, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire7")
    goto End
   Fire7:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_JumpIfInventory("IsUnderWater", 1, "UnderWater")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", 0, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire8")
    goto End
   Fire8:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", -5, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire9")
    goto End
   Fire9:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", -10, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire10")
    goto End
   Fire10:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", -15, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire11")
    goto End
   Fire11:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", -10, 1, 8, 0)
    WAVB L 0 A_ReFire("Fire12")
    goto End
   Fire12:
    WAVB K 0 A_JumpIfNoAmmo("NoAmmo")
    WAVB L 0 A_PlaySoundEx("weapons/mmb/waveburnerfire", "Weapon")
    WAVB L 2 A_FireCustomMissile("WaveBurnU", -5, 0, 8, 0)
    WAVB L 0 A_ReFire("Fire1")
    goto End
   End:
    WAVB M 4
    WAVB LK 2
    Goto ReadyX
   Flash:
    TNT1 A 0 A_FireCustomMissile("WaveBurnerBubbleFX", random(-7, 7), 0, 8, 0, 0, random(-4, 4))
    TNT1 A 0 A_Jump(16, "NoFlash")
    TNT1 A 1 A_FireCustomMissile("WaveBurnerBubbleFX", random(-7, 7), 0, 8, 0, 0, random(-4, 4))
    TNT1 A 0 A_Jump(96, "NoFlash")
    TNT1 A 1 A_FireCustomMissile("WaveBurnerBubbleFX", random(-7, 7), 0, 8, 0, 0, random(-4, 4))
    TNT1 A 0 A_Jump(128, "NoFlash")
    TNT1 A 1 A_FireCustomMissile("WaveBurnerBubbleFX", random(-7, 7), 0, 8, 0, 0, random(-4, 4))
    Goto NoFlash
   NoFlash:
    TNT1 A 0
    stop
  }
}

actor WaveBurnU : WaveBurn {
  Damage (CallACS("uh_TodayDmgMul", 90))
}

actor WaveBurnUWU : WaveBurnU {
  -BRIGHT
  damagetype "WaveBurnerUW"
  Obituary "$OB_WAVEBURNER2"
  States {
   Spawn:
    TNT1 A 2
    WABU EFGH 3
    goto Death
   Death:
    TNT1 A 0 A_SpawnItemEx("PropBlowerEffect")
    stop
  }
}

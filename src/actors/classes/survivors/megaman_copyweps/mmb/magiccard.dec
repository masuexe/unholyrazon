actor MagicCardWepU_NormalBar : MagicCardWep_NormalBar {}

actor MagicCardWepU : BaseMegaManUWep replaces MagicCardWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_MAGICCARD"
Obituary "$OB_MAGICCARD"
Tag "$TAG_MAGICCARD"
weapon.ammotype "MagicCardAmmo"
inventory.icon "MAGII"
States
{
SpawnLoop:
MCAR X -1
loop
Ready:
MCAR H 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_MAGICCARD)
MCAR H 1 A_WeaponReady
Goto Ready+1
Deselect:
MCAR H 0
goto DeselectSwap
Select:
MCAR H 0
goto SelectSwap
Fire:
MCAR H 0 A_JumpIfNoAmmo("NoAmmo")
MCAR H 0 A_PlaySoundEx("weapons/mmb/magiccardfire","Weapon")
MCAR H 0 A_FireCustomMissile("MagicCardU",0,1,8,0)
MCAR IJ 4
MCAR H 15
MCAR H 0 A_Refire
Goto Ready+1
NoAmmo:
MCAR H 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor MagicCardU : MagicCardMaster
{
States
{
Spawn:
MCAR A 0
MCAR A 0 A_SpawnItemEx("MagicCardWallDetector", 0, 0, 0, momx, momy, momz, 0, SXF_ABSOLUTEMOMENTUM|SXF_WEPFXCOLOR)
MCAR AA 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR BBCCCCCC 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR D 0 A_ScaleVelocity(0.5)
MCAR DD 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR D 0 A_ScaleVelocity(0.5)
MCAR EE 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR D 0 A_ScaleVelocity(-2.0)
MCAR FF 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR A 0 A_CustomMissile("ReturningMagicCardU",0,0,0,0)
stop
}
}

actor ReturningMagicCardU : MagicCardU
{
States
{
Spawn:
MCAR A 0
MCAR A 0 A_SpawnItemEx("MagicCardWallDetectorReturn", 0, 0, 0, momx, momy, momz, 0, SXF_ABSOLUTEMOMENTUM|SXF_WEPFXCOLOR)
MCAR A 0 A_JumpIfCloser(64,"Death")
MCAR BB 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR B 0 A_JumpIfCloser(64,"Death")
MCAR CC 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR C 0 A_JumpIfCloser(64,"Death")
MCAR DD 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR D 0 A_JumpIfCloser(64,"Death")
MCAR EE 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR A 0 A_JumpIfCloser(64,"Death")
MCAR FF 1 A_SpawnItemEx("MagicCardDamagerU",0,0,0,2,0,0)
MCAR A 0 A_JumpIfCloser(64,"Death")
MCAR A 0 A_CustomMissile("ReturningMagicCard",0,0,0,0)
stop
Death:
MCAR A 0
Stop
}
}

actor MagicCardDamagerU : MagicCardDamager
{
damage (150)
}

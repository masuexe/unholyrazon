actor QuickBoomerangWepU_ScriptBar : ScriptBar {}

actor QuickBoomerangWepU_MegaManUBar : MegaManUBar {Args 34, 39}

actor QuickBoomerangWepU : BaseMegaManUWep replaces QuickBoomerangWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 112
  Weapon.SlotNumber 3
  Inventory.Pickupmessage "$PU_QUICKBOOMERANG"
  Obituary "$OB_QUICKBOOMERANG"
  Tag "$TAG_QUICKBOOMERANG"
  Weapon.AmmoType "QuickBoomerangAmmo"
  Inventory.Icon "QUICKSI"
  States {
   SpawnLoop:
    WEAP Z -1
    loop
   Ready:
    QUIC E 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_QUICKBOOMERANG)
    goto ReadyX
   ReadyX:
    QUIC E 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    QUIC E 1 A_WeaponReady
    loop
   Deselect:
    QUIC E 0 A_TakeInventory("QuickBoomerangUFlag")
    goto DeselectSwap
   Select:
    QUIC E 0
    goto SelectSwap
   Fire:
    QUIC E 1 A_JumpIfNoAmmo("NoAmmo")
   Hold:
    QUIC E 0 A_JumpIfNoAmmo("NoAmmo")
    QUIC E 0 A_PlaySoundEx("weapons/mm2/quickboomerangfire", "Weapon")
    QUIC E 2 A_FireCustomMissile("QuickBoomerangU", random(-3, 3), 1, 8, 0)
    QUIC E 0 A_GiveInventory("QuickBoomerangUFlag", 1)
    QUIC E 0 A_JumpIfInventory("QuickBoomerangUFlag", 280, "Hold5")
    QUIC E 0 A_JumpIfInventory("QuickBoomerangUFlag", 224, "Hold4")
    QUIC E 0 A_JumpIfInventory("QuickBoomerangUFlag", 168, "Hold3")
    QUIC E 0 A_JumpIfInventory("QuickBoomerangUFlag", 112, "Hold2")
    QUIC E 0 A_JumpIfInventory("QuickBoomerangUFlag", 56, "Hold1")
    goto Hold0
   Hold0:
    QUIC E 2 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC F 2
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold1:
    QUIC F 2 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC F 1
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold2:
    QUIC F 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Hold2R")
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC F 1
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold2R:
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold3:
    QUIC F 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Hold3R")
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold3R:
    QUIC F 0 A_FireCustomMissile("QuickBoomerangU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold4:
    QUIC F 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Hold4R")
    QUIC F 0 A_FireCustomMissile("QuickBoomerangU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold4R:
    QUIC FF 0 A_FireCustomMissile("QuickBoomerangU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC F 1 A_FireCustomMissile("QuickBoomerangU", 0, 1, 8, 0)
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold5:
    QUIC F 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Hold5R")
    QUIC F 0 A_FireCustomMissile("QuickBoomerangU", random(-3, 3), 1, 8, 0, 0, random(-2, 2))
    QUIC F 1 A_FireCustomMissile("QuickBoomerangUU", 0, 1, 8, 0)
    QUIC F 1 A_FireCustomMissile("QuickBoomerangUU", 0, 1, 8, 0)
    QUIC E 0 A_ReFire
    goto ReadyX
   Hold5R:
    QUIC F 0 A_FireCustomMissile("QuickBoomerangU", random(-3, 3), 1, 8, 0, 0, random(-2, 2))
    QUIC F 0 A_FireCustomMissile("QuickBoomerangUU", random(-2, 2), 1, 8, 0, 0, random(-1, 1))
    QUIC F 1 A_FireCustomMissile("QuickBoomerangUU", 0, 1, 8, 0)
    QUIC E 0 A_ReFire
    goto ReadyX
  }
}

actor QuickBoomerangU : BasicProjectile {
  DamageType "QuickBoomerang"
  Obituary "$OB_QUICKBOOMERANG"
  Radius 6
  Height 7
  Damage (CallACS("uh_TodayDmgMul", 14))
  Speed 50
  ReactionTime 3
  var int user_TranslateWhiteColors;
  States {
   Spawn:
    QUIC A 0  // A_CountDown
    QUIC AABBCCDD 1 A_ChangeVelocity(-4, 0, 0, CVF_RELATIVE)
    QUIC A 0 A_CountDown
    loop
  }
}

// $UH
actor QuickBoomerangUFlag : Inventory {
  Inventory.MaxAmount 280
}

actor QuickBoomerangUU : QuickBoomerangU {
  Obituary "%o couldn't dodge %k's \clQuick\c- Boomerang."
  ReactionTime 10
  Damage (CallACS("uh_TodayDmgMul", 28))
  Radius 14
  Height 16
  Speed 90
  Scale 5.0
}

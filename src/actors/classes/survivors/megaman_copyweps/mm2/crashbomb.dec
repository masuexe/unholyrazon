actor CrashBombWepU_MegaManUBar : MegaManUBar {Args 4, 225}
actor CrashBombWepU : BaseMegaManUWep replaces CrashBombWep {
  Weapon.AmmoUse 3
  Weapon.AmmoGive 30
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_CRASHBOMB"
  Obituary "$OB_CRASHBOMB"
  Tag "$TAG_CRASHBOMB"
  Weapon.AmmoType "CrashBombAmmo"
  Inventory.Icon "CRASSI"
  States {
   SpawnLoop:
    WEA2 C -1
    loop
   Ready:
    CRAS X 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_CRASHBOMB)
    goto ReadyX
   ReadyX:
    CRAS X 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    CRAS X 0 A_JumpIfInventory("CrashCooldownFlag", 1, "ReadyCooldown")
    CRAS X 1 A_WeaponReady
    loop
   ReadyCooldown:
    CRAS X 1 A_WeaponReady(WRF_NOFIRE)
    goto ReadyX
   Deselect:
    CRAS X 0
    goto DeselectSwap
   Select:
    CRAS X 0
    goto SelectSwap
   Fire:
    CRAS X 0 A_JumpIfNoAmmo("NoAmmo")
    CRAS X 0 A_PlaySoundEx("weapons/mm2/crashbombfire", "Weapon")
    CRAS X 0 A_FireCustomMissile("CrashBombU", 0, 1, 8, 0)
    CRAS ZY 2
    CRAS X 0 A_GiveInventory("CrashCooldownFlag", 1)
    CRAS X 0 A_SpawnItemEx("CrashCooldowner")
    CRAS XXXXXXXXXXXXXXXXXXXXX 1 A_WeaponReady(WRF_NOFIRE)
    CRAS X 0 A_ReFire  // 25 ticks
    Goto ReadyX
  }
}

actor CrashBombU : BasicProjectile {
  Radius 6
  Height 6
  +HITTRACER
  +DONTREFLECT
  DamageType "CrashBombClaw"
  Obituary "$OB_CRASHBOMB"
  Renderstyle "Translucent"
  damage (CallACS("uh_TodayDmgMul", 10))
  Speed 40

  var int user_stuck;
  var int user_x;
  var int user_y;
  var int user_z;

  States {
   Spawn:
    CRAS A 1
    loop
   Crash:
   XDeath:
    CRAS C 0 A_SetUserVar("user_stuck", 1)
    CRAS C 0 A_JumpIfInventory("MM8BDMPlayer", 1, "PrepTracer", AAPTR_TRACER)
    goto Latch
   Death:
    CRAS C 0 A_PlaySound("weapons/mm2/crashbombland")
    CRAS A 0 A_JumpIf(z - floorz < 5, "Floor")
    CRAS A 0 A_JumpIf(z - ceilingz == 0 - 6, "Ceiling")
    CRAS BCDCDCDCDCDCDCDC 3
    Goto Detonate
   Floor:
    CRAS EFGFGFGFGFGFGFGF 3
    Goto Detonate
   Ceiling:
    CRAS HIJIJIJIJIJIJIJI 3
    Goto Detonate
   PrepTracer:
    CRAS C 0 ACS_NamedExecuteWithResult("core_reloffsets", AAPTR_TRACER, -4, 0, 28)
    CRAS C 0 ACS_NamedExecuteWithResult("core_changeClientProperty", APROP_Alpha, 0.5 * FIXED, AAPTR_DEFAULT, CallACS("core_getptrtid", AAPTR_TRACER))
    Goto Latch
   Latch:
    CRAS C 0 A_PlaySound("weapons/mm2/crashbombland")
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS D 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS D 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS D 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS D 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS D 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS D 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS C 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")
    CRAS C 1 A_Warp(AAPTR_TRACER, user_x, user_y, user_z, angle, WARPF_COPYINTERPOLATION | WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE)
    CRAS D 0 A_JumpIf(ACS_NamedExecuteWithResult("core_targetexists", 1) == 0, "Detonate")

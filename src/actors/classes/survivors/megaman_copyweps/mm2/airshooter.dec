actor AirShooterWepU_MegaManUBar : MegaManUBar { Args 4, 198 }
actor AirShooterWepU : BaseMegaManUWep replaces AirShooterWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_AIRSHOOTER"
Obituary "$OB_AIRSHOOTER"
Tag "$TAG_AIRSHOOTER"
weapon.ammotype "AirShooterAmmo"
inventory.icon "AIRSI"
States
{
SpawnLoop:
WEAP G -1
loop
Ready:
AIRS D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_AIRSHOOTER)
goto ReadyX
Deselect:
AIRS D 0
goto DeselectSwap
Select:
AIRS D 0
goto SelectSwap
Fire:
AIRS D 0 A_JumpIfNoAmmo("NoAmmo")
AIRS D 0 A_PlaySoundEx("weapons/mm2/airshooterfire","Weapon")
AIRS D 0 A_GiveInventory("FireAirShotU_P", 1)
AIRS EF 6
AIRS D 7
AIRS D 0 A_Refire
Goto ReadyX
NoAmmo:
AIRS D 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}

actor FireAirShotU_P : CustomInventory
{
    States
    {
        Pickup:
            TNT1 A 0 A_FireCustomMissile("AirShotU",-30,0,8,0)
            TNT1 A 0 A_FireCustomMissile("AirShotU",-15,0,8,0)
            TNT1 A 0 A_FireCustomMissile("AirShotU",0,1,8,0)
            TNT1 A 0 A_FireCustomMissile("AirShotU",15,0,8,0)
            TNT1 A 0 A_FireCustomMissile("AirShotU",30,0,8,0)
            stop
    }
}

actor AirShotU : AirShot replaces AirShot
{
damage (270)
}

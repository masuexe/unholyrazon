actor MetalBladeWepU_MegaManUBar : MegaManUBar {Args 210, 164}
actor MetalBladeWepU : BaseMegaManUWep replaces MetalBladeWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 28
  Weapon.SlotNumber 3
  Inventory.Pickupmessage "$PU_METALBLADE"
  Obituary "$OB_METALBLADE"
  Tag "$TAG_METALBLADE"
  Weapon.AmmoType "MetalBladeAmmo"
  Inventory.Icon "METLSI"
  States {
   SpawnLoop:
    WEAP S -1
    loop
   Ready:
    BUSH J 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_METALBLADE)
    BUSH J 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    BUSH J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BUSH J 1 A_WeaponReady
    goto Ready+2
   ReadyNoAmmo:
    BUS2 C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    BUS2 C 1 A_WeaponReady(WRF_NOFIRE)
    BUS2 C 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    goto Ready+1
   Deselect:
    BUSH J 0
    goto DeselectSwap
   Select:
    BUSH J 0
    goto SelectSwap
   Fire:
    BUSH J 0 A_JumpIfNoAmmo("NoAmmo")
    BUSH J 0 A_PlaySoundEx("weapons/mm2/metalbladefire", "Weapon")
    BUSH J 0 A_FireCustomMissile("MetalBladeU", 0, 1, 8, 0)
    BUSH KLMNO 2
    BUSH Q 0 A_JumpIfNoAmmo("NoAmmoDelay")
    BUSH QQR 1 A_ReFire
    goto Ready+1
   NoAmmoDelay:
    BUS2 GGH 1
    goto ReadyNoAmmo
   NoAmmo:
    BUS2 C 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo", 0)
    goto ReadyNoAmmo
  }
}


actor MetalBladeU : MetalBlade {
  Damage (CallACS("uh_TodayDmgMul", 50))
  States {
   Death:
    TNT1 A 1 A_SpawnItemEx("MetalBladeDeadU")
    stop
  }
}

actor MetalBladeDeadU : MetalBladeU {
  +DONTBLAST
  +DONTSPLASH
  -RIPPER
  Damage (CallACS("uh_TodayDmgMul", 85))
  States {
   Spawn:
    METL A 0
    METL A 1 A_Jump(256, "MetalA", "MetalB")
   MetalA:
    METL A 140
    goto SpawnF
   MetalB:
    METL B 140
    goto SpawnF
   SpawnF:
    METL "#" 2 A_Fadeout(0.22)
    wait
   Death:
    TNT1 A 1
    stop
  }
}

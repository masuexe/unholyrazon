const int WEPC_2AFU_FIRE1_AMMO = 1;
const int WEPC_2AFU_FIRE2_AMMO = 3;
const int WEPC_2AFU_FIRE3_AMMO = 7;
const int WEPC_2AFU_FIRE3A_AMMO = 14;
const int WEPC_2AFU_FIRE3B_AMMO = 21;
const int WEPC_2AFU_FIRE3C_AMMO = 28;

actor AtomicFireWepU_ScriptBar : ScriptBar {}
actor AtomicFireWepU_MegaManUBar : MegaManUBar { Args 229, 41 }

actor AtomicFireWepU : BaseMegaManUWep replaces AtomicFireWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Inventory.Pickupmessage "$PU_ATOMICFIRE"
Obituary "$OB_ATOMICFIRE"
weapon.ammotype "AtomicFireAmmo"
Tag "$TAG_ATOMICFIRE"
inventory.icon "ATOMI"
+WEAPON.AMMO_OPTIONAL
Scale 2.0
States
{
SpawnLoop:
WEAP E -1
loop
Ready:
HEAT G 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_ATOMICFIRE)
goto ReadyX
Deselect:
HEAT G 0
goto DeselectSwap
Select:
HEAT G 0
goto SelectSwap
Altfire:
HEAT G 0 A_JumpIfNoAmmo("NoAmmo")
HEAT G 4
Goto Fire1
Fire:
HEAT G 0 A_JumpIfNoAmmo("NoAmmo")
HEAT G 1
goto Hold
Hold:
HEAT G 0 A_JumpIfNoAmmo("NoAmmo")
HEAT G 0 A_JumpIfInventory("WeaponCharge",1,"Hold1Start")
HEAT G 2 A_GiveInventory("WeaponCharge",1) // no rage rune for this one
HEAT G 0 A_Refire
Goto Fire1

Hold1Start:
HEAT G 0 A_GiveInventory("AtomicFireAmmo", 3)
// HEAT G 0 A_GiveInventory("WeaponCharge", 10)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_GunFlash("Sound.Heat", GFF_NOEXTCHANGE)//A_PlaySoundEx("weapons/mm2/atomicfirecharge1", "SoundSlot5", 1)
Hold1:
HEAT G 0 A_JumpIfInventory("AtomicFireCharge_F", 0, "Hold2Start")
HEAT H 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG1,TCLR_ATOMICFIRE_CHARGE1)
HEAT G 0 A_Refire("Hold1.a")
Goto Fire1
Hold1.a:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 1 A_GiveInventory("AtomicFireCharge_F", 8)
// HEAT G 1 A_GiveInventory("WeaponCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
HEAT G 0 A_Refire("Hold1")
Goto Fire1

Hold2Start:
HEAT G 0 A_GiveInventory("AtomicFireAmmo", 4)
HEAT G 0 A_GiveInventory("WeaponCharge", 10)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
Hold2:
HEAT G 0 A_JumpIfInventory("AtomicFireCharge_F", 0, "Hold3Start")
HEAT I 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG2,TCLR_ATOMICFIRE_CHARGE2)
HEAT G 0 A_Refire("Hold2.a")
Goto Fire2
Hold2.a:
HEAT G 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_GiveInventory("AtomicFireCharge_F", 10)
// HEAT G 0 A_GiveInventory("WeaponCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
HEAT G 0 A_Refire("Hold2")
Goto Fire2

BotFire:
HEAT G 0 A_Jump(16, "Fire3")
HEAT G 0 A_Refire("Hold3")
Goto Fire3

Hold3Start:
HEAT J 0 A_GiveInventory("AtomicFireAmmo", 5)
HEAT J 0 A_GiveInventory("WeaponCharge", 10)
HEAT J 0 A_TakeInventory("AtomicFireCharge_F", 1)
Hold3:
HEAT G 0 A_JumpIfInventory("AtomicFireCharge_F", 0, "Hold3aStart")
HEAT J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG3,TCLR_ATOMICFIRE_CHARGE3)
HEAT G 0 A_Refire("Hold3.a")
Goto Fire3
Hold3.a:
HEAT G 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_GiveInventory("AtomicFireCharge_F", 8)
HEAT G 0 A_JumpIfInventory("IsBot", 1, "BotFire")
HEAT G 0 A_Refire("Hold3")
Goto Fire3

Hold3aStart:
HEAT J 0 A_GiveInventory("AtomicFireAmmo", 5)
HEAT J 0 A_GiveInventory("WeaponCharge", 10)
HEAT J 0 A_TakeInventory("AtomicFireCharge_F", 1)
Hold3a:
HEAT G 0 A_JumpIfInventory("AtomicFireCharge_F", 0, "Hold3bStart")
HEAT J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG3,TCLR_ATOMICFIRE_CHARGE3)
HEAT G 0 A_Refire("Hold3a.a")
Goto Fire3a
Hold3a.a:
HEAT G 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_GiveInventory("AtomicFireCharge_F", 5)
HEAT G 0 A_JumpIfInventory("IsBot", 1, "BotFire")
HEAT G 0 A_Refire("Hold3a")
Goto Fire3a

Hold3bStart:
HEAT J 0 A_GiveInventory("AtomicFireAmmo", 5)
HEAT J 0 A_GiveInventory("WeaponCharge", 10)
HEAT J 0 A_TakeInventory("AtomicFireCharge_F", 1)
Hold3b:
HEAT G 0 A_JumpIfInventory("AtomicFireCharge_F", 0, "Hold3cStart")
HEAT J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG3,TCLR_ATOMICFIRE_CHARGE3)
HEAT G 0 A_Refire("Hold3b.a")
Goto Fire3b
Hold3b.a:
HEAT G 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_GiveInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_JumpIfInventory("IsBot", 1, "BotFire")
HEAT G 0 A_Refire("Hold3b")
Goto Fire3b

Hold3cStart:
HEAT J 0 A_GiveInventory("AtomicFireAmmo", 28)
HEAT J 0 A_GiveInventory("WeaponCharge", 10)
Hold3c:
HEAT J 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRECRG3,TCLR_ATOMICFIRE_CHARGE3)
HEAT G 0 A_Refire("Hold3c.a")
Goto Fire3c
Hold3c.a:
HEAT G 1 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_JumpIfInventory("IsBot", 1, "BotFire")
HEAT G 0 A_Refire("Hold3c")
Goto Fire3c

Fire1:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE1_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 2
Goto ReadyX

Fire2:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", 5, "Fire2_Real")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE2_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 2
Goto ReadyX
Fire2_Real:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE2_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire2U",0,0,8,0)
HEAT KL 2
Goto ReadyX

Fire3:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3_AMMO, "Fire3_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE2_AMMO, "Fire2_Real")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 3
HEAT G 3
Goto ReadyX
Fire3_Real:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire3U",0,0,8,0)
HEA0 ABCDEF 2
HEAT G 2
Goto ReadyX // 14 frames

Fire3a:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3A_AMMO, "Fire3a_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3_AMMO, "Fire3_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE2_AMMO, "Fire2_Real")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3A_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 4
HEAT G 4
Goto ReadyX
Fire3a_Real:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3A_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire3aU",0,0,8,0)
HEA0 ABCDEF 3
HEAT G 3
Goto ReadyX // 14 frames

Fire3b:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3B_AMMO, "Fire3b_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3A_AMMO, "Fire3a_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3_AMMO, "Fire3_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE2_AMMO, "Fire2_Real")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3B_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 5
HEAT G 5
Goto ReadyX
Fire3b_Real:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3B_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire3bU",0,0,8,0)
HEA0 ABCDEF 4
HEAT G 4
Goto ReadyX // 14 frames

Fire3c:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("WeaponCharge", 1)
HEAT G 0 A_TakeInventory("AtomicFireCharge_F", 1)
HEAT G 0 A_ClearRefire
HEAT G 0 A_PlaySoundEx("weapons/mm2/atomicfirefire","Weapon")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3C_AMMO, "Fire3c_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3B_AMMO, "Fire3b_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3A_AMMO, "Fire3a_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE3_AMMO, "Fire3_Real")
HEAT G 0 A_JumpIfInventory("AtomicFireAmmo", WEPC_2AFU_FIRE2_AMMO, "Fire2_Real")
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3C_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire1U",0,0,8,0)
HEAT KL 6
HEAT G 6
Goto ReadyX
Fire3c_Real:
HEAT G 0 ACS_NamedExecuteWithResult("core_chargecolor",CLR_ATOMICFIRE,TCLR_NONE)
HEAT G 0 A_TakeInventory("AtomicFireAmmo",WEPC_2AFU_FIRE3C_AMMO,TIF_NOTAKEINFINITE)
HEAT G 0 A_FireCustomMissile("AtomicFire3cU",0,0,8,0)
HEA0 ABCDEF 5
HEAT G 5
Goto ReadyX // 14 frames

Sound.Heat:
TNT1 A 0 A_JumpIfInventory("WeaponCharge",50,"Sound.Heat3c")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",40,"Sound.Heat3b")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",30,"Sound.Heat3a")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",20,"Sound.Heat3")
TNT1 A 0 A_JumpIfInventory("WeaponCharge",10,"Sound.Heat2")
TNT1 A 4 A_PlaySoundEx("weapons/mm2/atomicfirecharge1", "Weapon", 0)
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
Sound.Heat2:
TNT1 A 4 A_PlaySoundEx("weapons/mm2/atomicfirecharge2", "Weapon", 0)
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
Sound.Heat3:
TNT1 A 4 A_PlaySoundEx("weapons/mm2/atomicfirecharge3", "Weapon", 0)
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
Sound.Heat3a:
TNT1 A 0 A_PlaySoundEx("weapons/mm2/atomicfirecharge3a", "Weapon", 0)
TNT1 AA 2 A_SpawnItemEx("AtomicFireU_FX2",random(16,48),0,Random(16,48),0,0,0,random(0,359))
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
Sound.Heat3b:
TNT1 A 0 A_PlaySoundEx("weapons/mm2/atomicfirecharge3b", "Weapon", 0)
TNT1 AA 2 A_SpawnItemEx("AtomicFireU_FX",random(16,48),0,Random(16,48),0,0,0,random(0,359))
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
Sound.Heat3c:
TNT1 A 0 A_PlaySoundEx("weapons/mm2/atomicfirecharge3c", "Weapon", 0)
TNT1 A 0 A_SpawnItemEx("AtomicFireU_FX",random(16,48),0,Random(16,48),0,0,0,random(0,359))
TNT1 AA 2 A_SpawnItemEx("AtomicFireU_FX2",random(16,48),0,Random(16,48),0,0,0,random(0,359))
TNT1 A 1 A_JumpIfInventory("WeaponCharge",1,"Sound.Heat")
stop
}
}

actor AtomicFireCharge_F : Inventory
{
inventory.amount 1
inventory.maxamount 280
}

actor AtomicFireU_FX : BasicGraphicEffect
{
+FORCEXYBILLBOARD
+BRIGHT
Alpha 0.9
RenderStyle "Translucent"
States
{
SpawnFrame:
HEAT ABABAB 2 A_FadeOut
stop
}
}

actor AtomicFireU_FX2 : AtomicFireU_FX
{
Translation "41:41=4:4"
}

actor AtomicFire1U : AtomicFire1
{
damage (CallACS("uh_TodayDmgMul", 120))
}

actor AtomicFire2U : AtomicFire2
{
damage (CallACS("uh_TodayDmgMul", 240))
}

actor AtomicFire3U : AtomicFire3
{
damage (CallACS("uh_TodayDmgMul", 250))
}

actor AtomicFire3aU : AtomicFire3U
{
Damage (CallACS("uh_TodayDmgMul", 300))
Radius 18
Height 18
Scale 2.75
States
{
Spawn:
HEAT EF 3
HEAT E 0 A_ScaleVelocity(2.0)
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT EF 3
HEAT E 0 A_ScaleVelocity(2.0)
HEAT E 0 A_Jump(256, "SpawnLoop")
SpawnLoop:
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT E 3 A_SpawnItemEx("AtomicFire3aU_FX2")
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT F 3 A_SpawnItemEx("AtomicFire3aU_FX1")
loop
}
}

actor AtomicFire3aU_FX1 : BasicGraphicEffect
{
+FORCEXYBILLBOARD
+BRIGHT
Alpha 0.8
Scale 2.75
States
{
SpawnFrame:
HEAT CDCD 3 A_FadeOut
stop
}
}
actor AtomicFire3aU_FX2 : BasicGraphicEffect
{
States
{
SpawnFrame:
HEAT DCDC 3 A_FadeOut
stop
}
}

actor AtomicFire3bU : AtomicFire3aU

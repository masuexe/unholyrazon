HEAT E 3 A_SpawnItemEx("AtomicFire3bU_FX2")
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT F 3 A_SpawnItemEx("AtomicFire3bU_FX1")
loop
}
}

actor AtomicFire3bU_FX1 : AtomicFire3aU_FX1
{
Alpha 0.9
Scale 3.0
States
{
Spawn:
HEAT CDCDABAB 2 A_FadeOut
stop
}
}

actor AtomicFire3bU_FX2 : AtomicFire3bU_FX1
{
States
{
Spawn:
HEAT DCDCBABA 2 A_FadeOut
stop
}
}

actor AtomicFire3cU : AtomicFire3aU
{
Damage (CallACS("uh_TodayDmgMul", 100))
Radius 20
Height 20
Speed 1
Scale 4.0
States
{
Spawn:
HEAT E 0
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT E 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
HEAT F 0 A_ScaleVelocity(1.3)
HEAT F 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT F 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
HEAT E 0 A_ScaleVelocity(1.3)
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT E 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
HEAT F 0 A_ScaleVelocity(1.3)
HEAT F 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT F 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
HEAT E 0 A_ScaleVelocity(1.3)
HEAT E 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT E 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
HEAT F 0 A_ScaleVelocity(1.3)
HEAT F 0 A_PlaySoundEx("weapons/mm2/atomicfirefire", "body")
HEAT F 2 A_SpawnItemEx("AtomicFire3cU2",0,0,0,momx*24,momy*24,momz*24,0,8)
stop  // what if loop?
}
}

actor AtomicFire3cU2 : AtomicFire3cU

actor DustCrusherWepU_NormalBar : DustCrusherWep_NormalBar {}

actor DustCrusherWepU : BaseMegaManUWep replaces DustCrusherWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_DUSTCRUSHER"
Obituary "$OB_DUSTCRUSHER"
Tag "$TAG_DUSTCRUSHER"
weapon.ammotype "DustCrusherAmmo"
inventory.icon "DUSTSI"
States
{
SpawnLoop:
WEA2 K -1
loop
Ready:
DSTS B 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_DUSTCRUSHER)
DSTS B 1 A_WeaponReady
Goto Ready+1
Deselect:
DSTS B 0
goto DeselectSwap
Select:
DSTS B 0
goto SelectSwap
Fire:
DSTS B 0 A_JumpIfNoAmmo("NoAmmo")
DSTS B 0 A_PlaySoundEx("weapons/mm4/dustcrusherfire","Weapon")
DSTS B 0 A_FireCustomMissile("DustCrusherU",0,1,8,0)
DSTS B 0 A_GiveInventory("YustManFace_P")
DSTS DC 2
DSTS B 24
DSTS B 0 A_Refire // 28 ticks
Goto Ready+1
NoAmmo:
DSTS B 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor YustManFlag : UOnce {}

actor YustManFace_P : CustomInventory {
    States {
        Pickup:
            TNT1 A 0 A_JumpIfInventory("YustManFlag", 1, "No")
            TNT1 A 0 A_GiveInventory("YustManFlag")
            TNT1 A 0 ACS_NamedExecuteWithResult("rz_SetPlayerSkin", 1)
            stop
        No:
            TNT1 A 0
            stop
    }
}

actor DustCrusherU : BasicProjectile replaces DustCrusher
{
Radius 10
Height 10
damage (470)
speed 35
damagetype "DustCrusher"
Obituary "$OB_DUSTCRUSHER"
States
{
Spawn:
DUST A 4
loop
Crash:
XDeath:
TNT1 A 0 A_PlaySoundEx("weapons/mm4/dustcrushersplit", "Body")
TNT1 A 6 A_SpawnItemEx("ExplosionEffect1",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 0 A_SpawnItemEx("DustBit1C",0,0,0,28,0,0,45)
TNT1 A 0 A_SpawnItemEx("DustBit2C",0,0,0,28,0,0,-45)
TNT1 A 0 A_SpawnItemEx("DustBit3C",0,0,0,28,0,0,225)
TNT1 A 0 A_SpawnItemEx("DustBit4C",0,0,0,28,0,0,-225)
TNT1 A 0 A_SpawnItemEx("DustBit1C",0,0,0,28,0,0,180)
TNT1 A 0 A_SpawnItemEx("DustBit2C",0,0,0,28,0,0,-90)
TNT1 A 0 A_SpawnItemEx("DustBit3C",0,0,0,28,0,0,90)
TNT1 A 0 A_SpawnItemEx("DustBit4C",0,0,0,28,0,0,0)
goto SuperDeath
Death:
TNT1 A 0 A_PlaySoundEx("weapons/mm4/dustcrushersplit", "Body")
TNT1 A 6 A_SpawnItemEx("ExplosionEffect1",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 0 A_SpawnItemEx("DustBit1",0,0,0,28,0,0,45)
TNT1 A 0 A_SpawnItemEx("DustBit2",0,0,0,28,0,0,-45)
TNT1 A 0 A_SpawnItemEx("DustBit3",0,0,0,28,0,0,225)
TNT1 A 0 A_SpawnItemEx("DustBit4",0,0,0,28,0,0,-225)
TNT1 A 0 A_SpawnItemEx("DustBit1",0,0,0,28,0,0,180)
TNT1 A 0 A_SpawnItemEx("DustBit2",0,0,0,28,0,0,-90)
TNT1 A 0 A_SpawnItemEx("DustBit3",0,0,0,28,0,0,90)
TNT1 A 0 A_SpawnItemEx("DustBit4",0,0,0,28,0,0,0)
goto SuperDeath
SuperDeath:
MMFX BBCCDDEEBBCCDDEEBBCCDDEE 1 A_SpawnItemEx("DustBitRU",random(-7,7),random(-7,7),0,random(-30,30),random(-30,30),random(5,10),0,1)
stop
}
}

actor DustBit1U : DustBit1 replaces DustBit1
{
damage (200)
}

Actor DustBitRU : DustBit1U
{
-NOGRAVITY
Damage (43)
States
{
Spawn:
DUST A 0
DUST A 0 A_Jump(256,"B","C","D","E")
B:
DUST B 2
loop
C:
DUST C 2
loop
D:
DUST D 2
loop
E:
DUST E 2
loop
}
}

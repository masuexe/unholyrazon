actor SkullBarrierWepU_MegaManUBar : MegaManUBar {Args 192, 197}
actor SkullBarrierWepU_ScriptBar : ScriptBar {}

actor SkullBarrierWepU : BaseMegaManUWep replaces SkullBarrierWep {
  Inventory.Pickupmessage "$PU_SKULLBARRIER"
  Weapon.AmmoUse 7
  Weapon.AmmoGive 28
  Weapon.SlotNumber 7
  Obituary "$OB_SKULLBARRIER"
  Tag "$TAG_SKULLBARRIER"
  Weapon.AmmoType "SkullBarrierAmmo"
  Inventory.Icon "SKLBSI"
  States {
   SpawnLoop:
    WEA2 O -1
    loop
   Ready:
    SKLA A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_SKULLBARRIER)
    SKLA A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    SKLA A 0 A_JumpIfInventory("SkullBarrierCooldown", 1, 2)
    SKLA A 1 A_WeaponReady
    Goto Ready+1
    SKLA A 1 A_WeaponReady(WRF_NOFIRE)
    goto Ready+1
   Deselect:
    SKLA A 0
    goto DeselectSwap
   Select:
    SKLA A 0
    goto SelectSwap
   Fire:
    SKLA A 0 A_JumpIfNoAmmo("NoAmmo")
    SKLA A 2 A_GiveInventory("ShieldCheck", 1)
    SKLA A 0 A_TakeInventory("ShieldCheck", 1)
    SKLA A 0 A_PlaySoundEx("weapons/mm4/skullbarrieractivate", "Weapon")
    SKLA A 0 A_TakeInventory("SkullBarrierAmmo", 7, TIF_NOTAKEINFINITE)
    SKLA A 0 A_GiveInventory("SkullShieldCheck", 260)
    SKLA A 0 A_SpawnItemEx("SkullBarrierWatcher", 0, 0, 28)
    SKLA A 0 ACS_NamedExecuteWithResult("core_hitshield", 1)
    SKLA A 0  // A_GiveInventory("SkullBarrierProtection", 1)
    SKLA IJ 2  // A_GiveInventory("SkullBarrierSpeed", 1)
    SKLA K 5  // A_GiveInventory("SkullBarrierSpeed", 1)
    SKLA K 0 A_JumpIfInventory("IsBot", 1, "BotBullRun")
   ShieldActive:
    SKLA K 1 A_RailWait  // A_GiveInventory("SkullBarrierSpeed", 1)
    SKLA K 0 A_JumpIfInventory("SkullShieldCheck", 1, "ShieldActive")
    Goto ShieldEnd
   BotBullRun:
    SKLA K 4 A_ChangeVelocity(10, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    SKLA K 0 A_JumpIfInventory("SkullShieldCheck", 1, "BotBullRun")
    Goto ShieldEnd
   ShieldEnd:
    SKLA K 0  // A_TakeInventory("SkullBarrierSpeed", 999)
    SKLA K 0 A_TakeInventory("SkullShieldCheck", 999)
    SKLA JJIIAA 1
    SKLA A 4
    Goto Ready+1
  }
}

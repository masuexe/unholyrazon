actor RingBoomerangWepU_MegaManUBar : MegaManUBar { Args 215, 230 }
actor RingBoomerangWepU : BaseMegaManUWep replaces RingBoomerangWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_RINGBOOMERANG"
Obituary "$OB_RINGBOOMERANG"
Tag "$TAG_RINGBOOMERANG"
weapon.ammotype "RingBoomerangAmmo"
inventory.icon "RINGSI"
States
{
SpawnLoop:
WEA2 H -1
loop
Ready:
RING E 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_RINGBOOMERANG)
RING E 1 A_WeaponReady
Goto Ready+1
Deselect:
RING E 0
goto DeselectSwap
Select:
RING E 0
goto SelectSwap
Fire:
RING E 0 A_JumpIfNoAmmo("NoAmmo")
RING E 0 A_PlaySoundEx("weapons/mm4/ringboomberangfire","Weapon")
RING E 0 A_FireCustomMissile("RingBoomerangU",0,1,8,0)
RING FG 4
RING E 15
RING E 0 A_Refire
Goto Ready+1
NoAmmo:
RING E 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor RingBoomerangBaseU : RingBoomerangBase
{
damage (180)
}

actor RingBoomerangU : RingBoomerangBaseU
{
+HEXENBOUNCE
+CANBOUNCEWATER
+HITTRACER
States
{
Spawn:
RING A 0
RING AABBCCDD 1 A_GiveInventory("BouncerReflectedCheck",1)
RING A 0 A_GiveInventory("BouncerReflectedCheck",1)
TNT1 A 0 A_ChangeFlag("RIPPER",0)
TNT1 A 0 A_ChangeFlag("HEXENBOUNCE",0)
TNT1 A 0 A_ChangeFlag("HITTRACER",0)
TNT1 A 0 A_Stop
RING ABCD 2
Death:
TNT1 A 0 A_SpawnItemEx("ReturningRingMasterU")
stop
}
}

actor ReturningRingMasterU : RingBoomerangBaseU
{
+NOCLIP
+NOINTERACTION
states
{
Spawn:
TNT1 A 0
TNT1 A 0 ACS_NamedExecuteWithResult("core_lookatptr", AAPTR_TARGET)
TNT1 A 0 A_SpawnItemEx("ReturningRingU",0,0,0,0,0,0,0,SXF_TRANSFERPITCH,0,CallACS("core_NewUniqueTID"))
TNT1 A 0 ACS_NamedExecuteWithResult("core_setTIDsPointerToThis",CallACS("core_CurrentUniqueTID"),AAPTR_MASTER)
TNT1 A 0 ACS_NamedExecuteWithResult("core_ClearUniqueTID",0)
RING AABBCCDDAA 1 A_GiveInventory("ReturningRingMasterFunc",1)
Death:
TNT1 A 0 A_RemoveChildren(true)
stop
}
}

actor ReturningRingU : RingBoomerangBaseU
{
+INVISIBLE
var int user_NoTranslation;
states
{
Spawn:
TNT1 A 0
Spawn2:
BUST A 1 A_GiveInventory("ReturningRingFunc",1)
loop
Death:
TNT1 A 0 A_SpawnItemEx("ReturningRing2U",0,0,0,0,0,0,0,SXF_TRANSFERPITCH|SXF_TRANSFERPOINTERS)
stop
}
}

actor ReturningRing2U : ReturningRingU
{
+NOCLIP
+NOINTERACTION
states
{
Spawn:
TNT1 A 0
Spawn2:
BUST A 1 A_GiveInventory("ReturningRingFunc",1)
TNT1 A 0 A_SpawnItemEx("ReturningRingU",0,0,0,0,0,0,0,SXF_TRANSFERPITCH|SXF_TRANSFERPOINTERS)
stop
Death:
TNT1 A 0
stop
}
}


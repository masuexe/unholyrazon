actor DrillBombWepU_MegaManUBar : MegaManUBar {Args 87, 227}
actor DrillBombWepU : BaseMegaManUWep replaces DrillBombWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_DRILLBOMB"
  Obituary "$OB_DRILLBOMB"
  Tag "$TAG_DRILLBOMB"
  Weapon.AmmoType "DrillBombAmmo"
  Inventory.Icon "DRILLSI"
  States {
   SpawnLoop:
    WEAP V -1
    loop
   Ready:
    DRIL D 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_DRILLBOMB)
    goto ReadyX
   ReadyX:
    DRIL D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    DRIL D 1 A_WeaponReady
    loop
   Deselect:
    DRIL D 0 A_GiveInventory("DrillFlag", 2)
    goto DeselectSwap
   Select:
    DRIL D 0 A_TakeInventory("DrillFlag")
    goto SelectSwap
   Fire:
    DRIL D 0 A_JumpIfNoAmmo("NoAmmo")
    DRIL D 0 A_PlaySoundEx("weapons/mm4/drillbombfire", "Weapon")
    DRIL D 0 A_FireCustomMissile("DrillBombU", 0, 1, 8, 0)
    DRI0 ABCDEF 2
    DRIL D 6
    DRIL D 0 A_JumpIfInventory("IsBot", 1, "BotCheck")
    goto Hold  // 18 ticks
   AltFire:
    DRIL D 0 A_JumpIfNoAmmo("NoAmmo")
    DRIL D 0 A_PlaySoundEx("weapons/mm4/drillbombfire", "Weapon")
    DRIL D 0 A_FireCustomMissile("DrillBombU", 0, 1, 8, 0)
    DRI0 ABCDEF 2
    DRIL D 6
    goto Hold  // 18 ticks
   Hold:
    DRIL D 1 A_RailWait
    DRIL D 0 A_ReFire
   AltHold:
    DRIL D 0 A_ClearReFire
    DRIL D 10 A_GiveInventory("DrillFlag", 2)
    DRIL D 0 A_TakeInventory("DrillFlag")
    goto ReadyX
   BotCheck:
    DRIL D 5 A_RailWait
    DRIL D 0 A_Jump(128, "BotCheck")
    goto Hold+2
  }
}

actor DrillBombU : DrillBomb {
  States {
   Death:
    DRIL A 0 A_Stop
    DRIL A 0 A_PlaySoundEx("weapons/mm4/drillbombexplode", "Weapon")
    DRIL A 0 A_Explode(CallACS("uh_TodayDmgMul", 500), 96, 0, 0, 16 + 7)
    TNT1 A 35 A_SpawnItemEx("ExplosionEffect2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    stop
  }
}

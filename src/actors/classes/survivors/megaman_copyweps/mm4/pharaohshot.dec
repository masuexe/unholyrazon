actor PharaohShotWepU_MegaManUBar : MegaManUBar {Args 52, 225}
actor PharaohShotWepU_ScriptBar : ScriptBar {}

actor PharaohShotWepU : BaseMegaManUWep replaces PharaohShotWep {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_PHARAOHSHOT"
  Obituary "$OB_PHARAOHSHOT"
  Tag "$TAG_PHARAOHSHOT"
  Weapon.AmmoType "PharaohShotAmmo"
  Inventory.Icon "PHASSI"
  States {
   SpawnLoop:
    WEA2 L -1
    loop
   Ready:
    PHAN A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_PHARAOHSHOT)
    goto ReadyX
   ReadyX:
    PHAN A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    PHAN A 1 A_WeaponReady
    loop
   Deselect:
    PHAN A 0 A_TakeInventory("PharaohCharge")
    goto DeselectSwap
   Select:
    PHAN A 0
    goto SelectSwap
   Fire:
    PHAN A 0 A_JumpIfNoAmmo("NoAmmo")
    PHAN A 2 A_GiveInventory("PharaohCharge", 1)
    PHAN A 0 A_ReFire("Hold1")
    Goto Throw1
   Hold1:
    PHAN B 1
    PHAN B 0 A_Refire(1)
    Goto Throw1
    PHAN B 1
    PHAN B 0 A_Refire(1)
    Goto Throw1
    PHAN C 1
    PHAN C 0 A_Refire(1)
    Goto Throw1
    PHAN C 1
    PHAN C 0 A_Refire(1)
    Goto Throw1
    PHAN D 1
    PHAN D 0 A_Refire(1)
    Goto Throw1
    PHAN D 1
    PHAN D 0 A_Refire(1)
    Goto Throw1
    PHAN E 1
    PHAN E 0 A_Refire(1)
    Goto Throw1
    PHAN E 1
    PHAN E 0 A_SpawnItemEx("PharaohFX")
    PHAN E 0 A_Refire("Hold2")
    Goto Throw1
   Hold2:
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 100, "Hold3Start")
    TNT1 AA 0 A_GiveInventory("PharaohCharge", 1 + CallACS("core_checkrune", RUNE_RAGE))
    TNT1 A 1
    TNT1 A 0 A_Refire("Hold2")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 100, "Throw3")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 50, "Throw2")
    Goto Throw1
   Hold3Start:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_clientsound", CSND_PHARAOHCHARGE)  // A_PlaySoundEx("weapons/mm4/pharaohshotcharge", "Weapon")
   Hold3a:
    TNT1 A 1
    TNT1 A 0 A_Refire("Hold3b")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 100, "Throw3")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 50, "Throw2")
    Goto Throw1
   Hold3b:
    TNT1 A 1
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, "Botfire")
    TNT1 A 0 A_Refire("Hold3a")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 100, "Throw3")
    TNT1 A 0 A_JumpIfInventory("PharaohCharge", 50, "Throw2")
    Goto Throw1
   Botfire:
    TNT1 A 0 A_Jump(16, "Throw3")
    TNT1 A 0 A_Refire("Hold3b")
    Goto Hold3b+3
   Throw1:
   Altfire:
    PHAN F 0 A_JumpIfNoAmmo("NoAmmo")
    PHAN F 0 A_PlaySoundEx("weapons/mm4/pharaohshotfire", "Weapon")
    PHAN F 0 A_FireCustomMissile("PharaohShot1U", 0, 1, 8, 0)
    PHAN F 0 A_TakeInventory("PharaohCharge")
    PHAN FGHIJK 1
    TNT1 A 10 A_ClearReFire
    PHAN LMA 1
    Goto ReadyX
   Throw2:
    TNT1 A 0 A_JumpIfInventory("PharaohShotAmmo", 2, "Throw2r")
    Goto Throw1
   Throw2r:
    PHAN F 0 A_PlaySoundEx("weapons/mm4/pharaohshotfire", "Weapon")
    PHAN F 0 A_GiveInventory("PharaohShotWepU_Throw2r_AmmoSpend_P")
    PHAN F 0 A_FireCustomMissile("PharaohShot2U", 0, 0, 8, 0)
    PHAN F 0 A_TakeInventory("PharaohCharge")
    PHAN FGHIJK 1
    TNT1 A 16 A_ClearReFire
    PHAN LMA 2
    Goto ReadyX
   Throw3:
    TNT1 A 0 A_JumpIfInventory("PharaohShotAmmo", 4, "Throw3r")
    Goto Throw2
   Throw3r:
    PHAN F 0 A_GiveInventory("PharaohShotWepU_Throw3r_AmmoSpend_P")
    PHAN F 0 A_PlaySoundEx("weapons/mm4/pharaohshotfire2", "Weapon")
    PHAN F 0 A_FireCustomMissile("PharaohShot3U", 0, 0, 8, 0)
    PHAN F 0 A_TakeInventory("PharaohCharge")
    PHAN FGHIJK 1
    TNT1 A 21 A_ClearReFire
    PHAN LMA 2
    Goto ReadyX
  }
}

actor PharaohShot1U : PharaohShot1 {
  Damage (CallACS("uh_TodayDmgMul", 160))
}

actor PharaohShot2U : PharaohShot2 {
  Damage (CallACS("uh_TodayDmgMul", 110))
  States {
   Death:
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 220), 48, 0, 0, 32)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    PHAS PQR 2
    stop
  }
}

actor PharaohShot3U : PharaohShot3 {
  +FORCEXYBILLBOARD
  +BRIGHT
  +DONTREFLECT
  Radius 18
  Height 18
  Damage (CallACS("uh_TodayDmgMul", 280))
  damagetype "PharaohShot3"
  Obituary "$OB_PHARAOHSHOT"
  Speed 30
  States {
   Spawn:
    PHAS JK 4
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 380), 96, 0, 0, 32)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    PHAS LMNO 2
    stop
  }
}

actor PharaohFXU : PharaohFX {
  damagetype "PharaohHold"
  Obituary "$OB_PHARAOHSHOT"
  +FORCEXYBILLBOARD
  +BRIGHT
  +NOTIMEFREEZE
  Radius 20
  Height 16
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("PharaohCharge", 10, "Spawn.b")
    TNT1 A 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.b:
    PHAS B 0 A_JumpIfInTargetInventory("PharaohCharge", 30, "Spawn.c")
    PHAS B 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS B 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.c:
    PHAS C 0 A_JumpIfInTargetInventory("PharaohCharge", 40, "Spawn.d")
    PHAS C 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS C 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.d:
    PHAS D 0 A_JumpIfInTargetInventory("PharaohCharge", 50, "Spawn.e")
    PHAS D 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS D 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.e:
    PHAS E 0 A_JumpIfInTargetInventory("PharaohCharge", 60, "Spawn.f")
    PHAS E 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS E 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.f:
    PHAS F 0 A_JumpIfInTargetInventory("PharaohCharge", 70, "Spawn.g")
    PHAS F 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS F 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.g:
    PHAS G 0 A_JumpIfInTargetInventory("PharaohCharge", 80, "Spawn.h")
    PHAS G 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS G 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.h:
    PHAS H 0 A_JumpIfInTargetInventory("PharaohCharge", 90, "Spawn.i")
    PHAS H 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS H 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.i:
    PHAS I 0 A_JumpIfInTargetInventory("PharaohCharge", 100, "Spawn.jk")
    PHAS I 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS I 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
   Spawn.jk:
    PHAS J 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS J 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    PHAS J 0 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS J 1 A_Explode(CallACS("uh_TodayDmgMul", 70), 64, 0)
    PHAS J 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    PHAS J 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS K 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    PHAS K 0 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS K 1 A_Explode(CallACS("uh_TodayDmgMul", 70), 64, 0)
    PHAS K 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    PHAS K 1 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS K 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    PHAS K 0 A_Warp(AAPTR_TARGET, 0, 0, 90, 0, WARPF_NOCHECKPOSITION | WARPF_WARPINTERPOLATION | WARPF_COPYINTERPOLATION)
    PHAS K 1 A_Explode(CallACS("uh_TodayDmgMul", 70), 64, 0)
    PHAS J 0 A_JumpIf(CallACS("core_pharaohshotwarper_exists") == 0, "Death")
    loop
  }
}

// Spend after an authoritative state jump and sync the remaining ammo.
actor PharaohShotWepU_Throw3r_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("PharaohShotAmmo", 4, TIF_NOTAKEINFINITE)
    stop
  }
}

// Spend after an authoritative state jump and sync the remaining ammo.
actor PharaohShotWepU_Throw2r_AmmoSpend_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("PharaohShotAmmo", 2, TIF_NOTAKEINFINITE)
    stop
  }
}

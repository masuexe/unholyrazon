actor DiveMissileWepU_MegaManUBar : MegaManUBar { Args 4, 198 }
actor DiveMissileWepU : BaseMegaManUWep replaces DiveMissileWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_DIVEMISSILE"
Obituary "$OB_DIVEMISSILE"
Tag "$TAG_DIVEMISSILE"
weapon.ammotype "DiveMissileAmmo"
inventory.icon "DIVESI"
States
{
SpawnLoop:
WEA2 S -1
loop
Ready:
AIRS D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_DIVEMISSILE)
goto ReadyX
Deselect:
AIRS D 0
goto DeselectSwap
Select:
AIRS D 0
goto SelectSwap
Fire:
AIRS D 0 A_JumpIfNoAmmo("NoAmmo")
AIRS D 0 A_PlaySoundEx("weapons/mm4/divemissilefire","Weapon")
AIRS D 0 A_FireCustomMissile("DiveMissileU",0,1,8,0)
AIRS D 0 A_GiveInventory("DiveCounter",23)
AIRS EFD 3
Waiting:
AIRS D 1 A_TakeInventory("DiveCounter", 1 + CallACS("core_checkrune", RUNE_RAGE))
AIRS D 0 A_JumpIfInventory("DiveCounter",1,"Waiting")
AIRS D 4
AIRS D 0 A_Refire
Goto ReadyX
}
}

actor DiveMissileU : DiveMissile
{
damage (120)
}

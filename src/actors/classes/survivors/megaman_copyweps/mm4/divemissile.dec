actor DiveMissileWepU_MegaManUBar : MegaManUBar {Args 4, 198}
actor DiveMissileWepU : BaseMegaManUWep replaces DiveMissileWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_DIVEMISSILE"
  Obituary "$OB_DIVEMISSILE"
  Tag "$TAG_DIVEMISSILE"
  Weapon.AmmoType "DiveMissileAmmo"
  Inventory.Icon "DIVESI"
  States {
   SpawnLoop:
    WEA2 S -1
    loop
   Ready:
    DIVE C 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_DIVEMISSILE)
    goto ReadyX
   ReadyX:
    DIVE C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    DIVE C 1 A_WeaponReady
    loop
   Deselect:
    DIVE C 0
    goto DeselectSwap
   Select:
    DIVE C 0
    goto SelectSwap
   Fire:
    DIVE C 0 A_JumpIfNoAmmo("NoAmmo")
    DIVE C 0 A_PlaySoundEx("weapons/mm4/divemissilefire", "Weapon")
    DIVE C 0 A_FireCustomMissile("DiveMissileU", 0, 1, 8, 0)
    DIVE C 0 A_GiveInventory("DiveCounter", 23)
    DIVE DEC 3
   Waiting:
    DIVE C 1 A_TakeInventory("DiveCounter", 1 + CallACS("core_checkrune", RUNE_RAGE))
    DIVE C 0 A_JumpIfInventory("DiveCounter", 1, "Waiting")
    DIVE C 4
    DIVE C 0 A_ReFire
    Goto ReadyX
  }
}

actor DiveMissileU : DiveMissile {
  Damage (CallACS("uh_TodayDmgMul", 120))
}

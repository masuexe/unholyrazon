actor RainFlushWepU_MegaManUBar : MegaManUBar { Args 4, 104 }
actor RainFlushWepU : BaseMegaManUWep replaces RainFlushWep
{
Weapon.AmmoUse 7
Weapon.AmmoGive 28
Weapon.SlotNumber 6
Inventory.Pickupmessage "$PU_RAINFLUSH"
Obituary "$OB_RAINFLUSH"
Tag "$TAG_RAINFLUSH"
weapon.ammotype "RainFlushAmmo"
inventory.icon "RAINSI"
States
{
SpawnLoop:
WEA2 Y -1
loop
Ready:
TOAH A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_RAINFLUSH)
goto ReadyX
ReadyX:
TOAH A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
TOAH A 1 A_WeaponReady
loop
Deselect:
TOAH A 0
goto DeselectSwap
Select:
TOAH A 0
goto SelectSwap
Fire:
TOAH A 0 A_JumpIfNoAmmo("NoAmmo")
TOAH A 0 A_PlaySoundEx("weapons/mm4/rainflushfire","Weapon")
TOAH A 0 A_TakeInventory("RainFlushAmmo", 7, TIF_NOTAKEINFINITE)
TOAH A 0 A_GiveInventory("FireRainFlush")
TOAH BCDEFG 2
TNT1 A 50
TOAH HIA 1
Goto ReadyX
}
}

actor RainFlushU : RainFlush replaces RainFlush
{
States
{
Spawn:
TNT1 A 35
TNT1 A 0 A_PlaySoundEx("weapons/mm4/rainflushexplode","Voice")
TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 270),512,0)
TNT1 AAAAAAA 1 A_SpawnItemEx("RainSprinkleSpawn",0,0,0,0,0,0,0,SXF_RAINFLUSH)
TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 130),512,0)
TNT1 AAAAAAA 1 A_SpawnItemEx("RainSprinkleSpawn",0,0,0,0,0,0,0,SXF_RAINFLUSH)
TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 130),512,0)
TNT1 AAAAAAA 1 A_SpawnItemEx("RainSprinkleSpawn",0,0,0,0,0,0,0,SXF_RAINFLUSH)
TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 130),512,0)
TNT1 AAAAAAA 1 A_SpawnItemEx("RainSprinkleSpawn",0,0,0,0,0,0,0,SXF_RAINFLUSH)
stop
}
}

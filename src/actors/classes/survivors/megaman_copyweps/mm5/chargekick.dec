actor ChargeKickWepU_MegaManUBar : MegaManUBar {Args 4, 225}
actor ChargeKickWepU : BaseMegaManUWep replaces ChargeKickWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_CHARGEKICK"
  Obituary "$OB_CHARGEKICK"
  Tag "$TAG_CHARGEKICK"
  Weapon.AmmoType "ChargeKickAmmo"
  Inventory.Icon "CHARSI"
  States {
   SpawnLoop:
    WEA2 E -1
    loop
   Ready:
    CKIC C 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_CHARGEKICK)
    goto ReadyX
   ReadyX:
    CKIC C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    CKIC C 1 A_WeaponReady
    loop
   Deselect:
    CKIC C 0
    goto DeselectSwap
   Select:
    CKIC C 0
    goto SelectSwap
   Fire:
    CKIC C 0 A_JumpIfNoAmmo("NoAmmo")
    CKIC C 0 A_PlaySoundEx("weapons/mm5/chargekickfire", "Weapon")
    CKIC C 0 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, true, 0)
    CKIC C 0 A_SpawnItemEx("PropBlowerEffect")
    CKIC C 2 A_Recoil(-20)
    CKIC B 2 A_FireCustomMissile("ChargeKickU", 0, 1, 0, 0)
    CKIC A 8 ACS_NamedExecuteWithResult("uh_SurvivorProperty", 1, false, 0)
    CKIC B 5
    CKIC C 5
    CKIC C 0 A_ReFire
    Goto ReadyX
  }
}

actor ChargeKickU : ChargeKick {
  Damage (CallACS("uh_TodayDmgMul", 470))
}

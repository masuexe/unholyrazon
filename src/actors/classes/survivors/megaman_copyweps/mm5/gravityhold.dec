actor GravityHoldWepU_MegaManUBar : MegaManUBar {Args 4, 239}
actor GravityHoldWepU : BaseMegaManUWep replaces GravityHoldWep {
  Weapon.AmmoUse 7
  Weapon.AmmoGive 28
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_GRAVITYHOLD"
  Obituary "$OB_GRAVITYHOLD"
  Tag "$TAG_GRAVITYHOLD"
  Weapon.AmmoType "GravityHoldAmmo"
  Inventory.Icon "GRAVSI"
  States {
   SpawnLoop:
    WEA3 F -1
    loop
   Ready:
    FSTO A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_GRAVITYHOLD)
    goto ReadyX
   ReadyX:
    FSTO A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    FSTO A 1 A_WeaponReady
    loop
   Deselect:
    FSTO A 0
    goto DeselectSwap
   Select:
    FSTO A 0
    goto SelectSwap
   Fire:
    FSTO A 0 A_JumpIfNoAmmo("NoAmmo")
    FSTO A 0 A_FireCustomMissile("GravityHoldU", 0, 1, 8, 0)
    FSTO BC 1 A_SpawnItemEx("GravityHold2U", 0, 0, 28)
    FSTO A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire", "Weapon")
    FSTO CDD 2 A_SpawnItemEx("GravityHold2U", 0, 0, 28)
    FSTO D 39
    FSTO C 2
    FSTO A 0 A_ReFire
    goto ReadyX
   Death:
    WEA3 F 0
    stop
  }
}

actor GravityHoldU : GravityHold {
  +OLDRADIUSDMG
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("GravityHoldFXU", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 30), 1024, 0, 0, 16)
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX2U", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 30), 896, 0, 0, 14)
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX3U", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 30), 768, 0, 0, 12)
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX4U", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 30), 640, 0, 0, 10)
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX5U", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 30), 512, 0, 0, 8)
    stop
  }
}

actor GravityHold2U : GravityHoldU {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX6U", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor GravityHoldFXU : GravityHoldFX {
  var int user_add;
  Mass 1024
  Radius 4
  Height 4
  Scale 6.5
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_add", 360 / reactiontime)
    TNT1 A 0 A_SetUserVar("user_angle", random(0, user_add))
    goto SpawnLoop
   SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("GravityHoldParticleU", mass, 0, 512,
                           0, 0, -15 - (ceilingz - floorz) / 32,
                           user_angle, 37 + 16384)
    TNT1 A 0 A_SetUserVar("user_angle", user_angle + user_add)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor GravityHoldFX2U : GravityHoldFXU {
  Mass 896
  ReactionTime 45
}

actor GravityHoldFX3U : GravityHoldFXU {
  Mass 768
  ReactionTime 40
}

actor GravityHoldFX4U : GravityHoldFXU {
  Mass 640
  ReactionTime 36
}

actor GravityHoldFX5U : GravityHoldFXU {
  Mass 512
  ReactionTime 30
}

actor GravityHoldFX6U : GravityHoldFXU {
  Mass 96
  ReactionTime 10
  Scale 3.25
}

actor GravityHoldParticleU : GravityHoldParticle {
  Scale 6.5
  States {
   Spawn:
    GHOL A 1  // A_SpawnItemEx("GravityHoldParticle2U")
    wait
  }
}
actor GravityHoldParticle2U : BasicGraphicEffect {
  +BRIGHT
  Alpha 0.9
  Scale 6.5
  States {
   Spawn:
    GHOL A 1 A_FadeOut(0.15)
    wait
  }
}

actor GravityHoldWepU_MegaManUBar : MegaManUBar {Args 4, 239}
actor GravityHoldWepU : BaseMegaManUWep replaces GravityHoldWep {
  Weapon.AmmoUse 14
  Weapon.AmmoGive 28
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_GRAVITYHOLD"
  Obituary "$OB_GRAVITYHOLD"
  Tag "$TAG_GRAVITYHOLD"
  Weapon.AmmoType "GravityHoldAmmo"
  Inventory.Icon "GRAVSI"
  States {
   SpawnLoop:
    WEA3 F -1
    loop
   Ready:
    GHOL B 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLR_GRAVITYHOLD)
    GHOL B 0 A_JumpIfInventory("PowerGravityHoldCooldown", 1, "ReadyCooldown")
    goto ReadyX
   ReadyX:
    GHOL B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    GHOL B 1 A_WeaponReady
    loop
   ReadyCooldown:
    GHOL B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
    GHOL B 1 A_WeaponReady(WRF_NOFIRE)
    goto Ready+1

   Deselect:
    GHOL B 0
    goto DeselectSwap
   Select:
    GHOL B 0
    goto SelectSwap
   Fire:
    GHOL B 0 A_JumpIfNoAmmo("NoAmmo")
    GHOL B 0 A_GiveInventory("GravityHold_Fire_P", 1)
    GHOL FFGGHHHHHHHHHH 1 ACS_NamedExecuteWithResult("core_missilestate")
    GHOL HIIJKL 1
    GHOL E 0 A_GiveInventory("GravityHoldCooldownGiver")
    GHOL E 46 A_WeaponReady(WRF_NOFIRE)
    GHOL D 2 A_WeaponReady(WRF_NOFIRE)
    goto Ready+1

   Death:
    WEA3 F 0
    stop
  }
}

// v6c Gravity Hold attack cooldown (50 tics). Uses a timed power so the
// cooldown expires reliably on the owning player.
actor GravityHoldCooldownGiver : BasicPowerupGiver {
  Powerup.Type "PowerGravityHoldCooldown"
}

actor PowerGravityHoldCooldown : Powerup {
  Powerup.Duration 50
}

actor GravityHoldU : GravityHold replaces GravityHold {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // A_SpawnItemEx("GravityHoldFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 325, 0, 0, 325)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // _SpawnItemEx("GravityHoldFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 325, 0, 0, 325)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // A_SpawnItemEx("GravityHoldFX2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 243, 0, 0, 243)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // A_SpawnItemEx("GravityHoldFX2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 243, 0, 0, 243)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // A_SpawnItemEx("GravityHoldFX3", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 162, 0, 0, 162)
    TNT1 A 0 A_JumpIf(!CallACS("core_targetexists"), "Death")
    TNT1 A 0 // A_SpawnItemEx("GravityHoldFX3", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
    TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 20), 162, 0, 0, 162)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor GravityHold2U : GravityHoldU {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("GravityHoldFX6U", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor GravityHoldFXU : GravityHoldFX {
  var int user_add;
  Mass 1024
  Radius 4
  Height 4
  Scale 6.5
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_add", 360 / reactiontime)
    TNT1 A 0 A_SetUserVar("user_angle", random(0, user_add))
    goto SpawnLoop
   SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("GravityHoldParticleU", mass, 0, 512,
                           0, 0, -15 - (ceilingz - floorz) / 32,
                           user_angle, 37 + 16384)
    TNT1 A 0 A_SetUserVar("user_angle", user_angle + user_add)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor GravityHoldFX2U : GravityHoldFXU {
  Mass 896
  ReactionTime 45
}

actor GravityHoldFX3U : GravityHoldFXU {
  Mass 768
  ReactionTime 40
}

actor GravityHoldFX4U : GravityHoldFXU {
  Mass 640
  ReactionTime 36
}

actor GravityHoldFX5U : GravityHoldFXU {
  Mass 512
  ReactionTime 30
}

actor GravityHoldFX6U : GravityHoldFXU {
  Mass 96
  ReactionTime 10
  Scale 3.25
}

actor GravityHoldParticleU : GravityHoldParticle {
  Scale 6.5
  States {
   Spawn:
    GHOL A 1  // A_SpawnItemEx("GravityHoldParticle2U")
    wait
  }
}
actor GravityHoldParticle2U : BasicGraphicEffect {
  +BRIGHT
  Alpha 0.9
  Scale 6.5
  States {
   Spawn:
    GHOL A 1 A_FadeOut(0.15)
    wait
  }
}

actor GravityHoldExplosionU : GravityHoldExplosion replaces GravityHoldExplosion {
  States {
   Spawn:
    TNT1 A 0 nodelay A_SpawnItemEx("GravityHoldExplosionFX")
    goto Explode
   Explode:
    TNT1 A 0 Radius_Quake(6, 7, 0, 3, 0)
    TNT1 A 0 A_PlaySoundEx("weapons/mm5/gravityholdslam", "weapon")
    TNT1 A 0 A_Explode(CallACS("uh_TodayDmgMul", 300), 96, 0, 0, 96)
    TNT1 A 35
    stop
  }
}

actor GravityHoldExplosionCeilingU : GravityHoldExplosionU replaces GravityHoldExplosionCeiling {
  States {
   Spawn:
    TNT1 A 0 nodelay A_SpawnItemEx("GravityHoldExplosionFXCeiling")
    goto Super::Explode
  }
}
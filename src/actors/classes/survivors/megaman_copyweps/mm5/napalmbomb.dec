actor NapalmBombWepU_MegaManUBar : MegaManUBar { Args 216, 75 }
actor NapalmBombWepU : BaseMegaManUWep replaces NapalmBombWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Inventory.Pickupmessage "$PU_NAPALMBOMB"
Obituary "$OB_NAPALMBOMB"
Tag "$TAG_NAPALMBOMB"
weapon.ammotype "NapalmBombAmmo"
inventory.icon "NAPAI"
States
{
SpawnLoop:
WEAP C -1
loop
Ready:
NAPA T 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_NAPALMBOMB)
goto ReadyX
Deselect:
NAPA T 0
goto DeselectSwap
Select:
NAPA T 0
goto SelectSwap
Fire:
NAPA T 0 A_JumpIfNoAmmo("NoAmmo")
NAPA T 0 A_PlaySoundEx("weapons/mm5/napalmbombfire","Weapon")
NAPA T 0 A_FireCustomMissile("NapalmBombU",0,1,8,0)
NAPA VU 3
NAPA T 19
NAPA T 0 A_Refire
Goto ReadyX
NoAmmo:
NAPA T 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}


actor NapalmBombU : NapalmBomb
{
States
{
Death:
NAPA A 0 A_Stop
NAPA A 0 A_Jump(8, "AirStrikeIt")
NAPA A 0 A_PlaySoundEx("weapons/mm5/napalmbombexplode", "Weapon")
NAPA A 0 A_ChangeFlag("NOGRAVITY",1)
NAPA D 0 A_Explode(480, 96, 0)
TNT1 A 35 A_SpawnItemEx("ExplosionEffect2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
stop
AirStrikeIt:
TNT1 A 0 A_SpawnItemEx("NapalmBombU_AirStrikeExplosion")
stop
}
}

actor NapalmBombU_AirStrikeExplosion : BasicExplosion {
    Damagetype "MeteorItem"
    Obituary "%o was set up the Napalm Bomb by %k."
    States {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySound("misc/hugequake",0,1.0,0,ATTN_NONE)
            TNT1 A 0 A_Explode(10001,9001,1,1,9001)
            TNT1 A 0 Radius_Quake(9,35,0,150,0)
            TNT1 A 40 A_SpawnItemEx("AirStrikeMeteor_H")
            stop
    }
}

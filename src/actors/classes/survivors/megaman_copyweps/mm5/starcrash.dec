actor StarCrashWepU_MegaManUBar : MegaManUBar { Args 229, 220 }
actor StarCrashWepU_ScriptBar : ScriptBar {}

actor StarCrashWepU : BaseMegaManUWep replaces StarCrashWep
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Weapon.SlotNumber 7
Inventory.Pickupmessage "$PU_STARCRASH"
Obituary "$OB_STARCRASH"
Tag "$TAG_STARCRASH"
weapon.ammotype "StarCrashAmmo"
inventory.icon "STARSI"

States
{
SpawnLoop:
WEA2 X -1
loop
Ready:
STAA A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_STARCRASH)
STAA A 0 A_ClearRefire
STAA A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen")
STAA A 1 A_WeaponReady
Goto Ready+2
Deselect:
STAA A 0 A_JumpIfInventory("ShieldCheck",1,1)
goto DeselectSwap
STAA A 0 A_TakeInventory("ShieldCheck",1)
goto DeselectSwap
Select:
STAA A 0
goto SelectSwap
Fire:
STAA A 0 A_JumpIfInventory("ShieldCheck",1,"ShieldThrow")
STAA A 0 A_JumpIfNoAmmo("NoAmmo")
STAA A 0 //A_TakeInventory("BasicArmor",9999)
STAA A 0 A_TakeInventory("StarCrashAmmo",1,TIF_NOTAKEINFINITE)
STAA A 0 A_PlaySoundEx("weapons/mm5/starcrashactivate","Weapon")
STAA A 1 A_GiveInventory("ShieldCheck",1)
goto ShieldActive
ShieldActive:
STAA F 0 A_SpawnItemEx("StarCrashWarper")
//TNT1 A 0 A_GunFlash
STAA BC 2
TNT1 A 0 A_SpawnItemEx("StarRadiusU",0,0,28)
STAA DE 2 
TNT1 A 0 A_SpawnItemEx("StarRadiusU",0,0,28)
STAA FG 2 
TNT1 A 0 A_SpawnItemEx("StarRadiusU",0,0,28)
STAA H 2
ShieldLoop:
STAA IIII 1 A_WeaponReady
TNT1 A 0 A_SpawnItemEx("StarRadiusU",0,0,28)
STAA IIII 1 A_WeaponReady
TNT1 A 0 A_SpawnItemEx("StarRadiusU",0,0,28)
TNT1 A 0 A_TakeInventory("StarCrashAmmo",1,TIF_NOTAKEINFINITE)
TNT1 A 0 A_JumpIfNoAmmo("NoAmmo")
loop
ShieldThrow:
STAA A 0 A_TakeInventory("ShieldCheck",999)
STAA A 0 A_PlaySoundEx("weapons/mm5/starcrashfire","Weapon")
STAA I 1 A_FireCustomMissile("StarCrashU",0,0,0,0)
STAA JK 1
STAA K 22
STAA J 2
goto Ready+1
NoAmmo:
STAA A 0 ACS_NamedExecuteAlways("uh_MegaManUNoAmmo",0)
STAA A 0 A_TakeInventory("ShieldCheck",999)
goto ReadyNoAmmo
/*Flash:
STAA BC 2
STAA DE 2
STAA FG 2
STAA H 2
FlashLoop:
STAA I 1
STAA A 0 A_JumpIfInventory("ShieldCheck", 1, "FlashLoop")
stop*/
}
}

actor StarRadiusU : BasicExplosion
{
Damagetype "Starcrash"
Obituary "$OB_STARCRASH"
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(CallACS("uh_TodayDmgMul", 170),128,0)
stop
}
}

actor StarCrashU : StarCrash
{
Damage (CallACS("uh_TodayDmgMul", 400))
}

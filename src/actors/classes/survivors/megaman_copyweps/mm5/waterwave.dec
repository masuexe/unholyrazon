actor WaterWaveWepU_MegaManUBar : MegaManUBar { Args 4, 198 }
actor WaterWaveWepU : BaseMegaManUWep replaces WaterWaveWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 3
Inventory.Pickupmessage "$PU_WATERWAVE"
Obituary "$OB_WATERWAVE"
Tag "$TAG_WATERWAVE"
weapon.ammotype "WaterWaveAmmo"
inventory.icon "WATRSI"
States
{
SpawnLoop:
WEA2 M -1
loop
Ready:
WWAV E 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_WATERWAVE)
goto ReadyX
Deselect:
WWAV E 0
goto DeselectSwap
Select:
WWAV E 0
goto SelectSwap
Fire:
WWAV E 0 A_JumpIfNoAmmo("NoAmmo")
WWAV E 0 A_PlaySoundEx("weapons/mm5/waterwavefire","Weapon")
WWAV E 0 A_TakeInventory("WaterWaveAmmo", 2, TIF_NOTAKEINFINITE)
WWAV FFFGGG 2 A_FireCustomMissile("WaterWaveSpawner",0,0,8,0)
WWAV E 8
WWAV E 0 A_Refire
Goto ReadyX
NoAmmo:
WWAV E 0 ACS_NamedExecuteAlways("core_noammo",0)
Goto ReadyX
}
}


actor WaterWaveSpawnerU : WaterWaveSpawner
{
States
{
Death:
TNT1 A 0 A_CustomMissile("WaterWaveU",0,0,0,2,0)
stop
}
}

actor WaterWaveU : WaterWave
{
damage (110)
}

actor PowerStoneWepU_NormalBar : PowerStoneWep_NormalBar {}

actor PowerStoneWepU : BaseMegaManUWep replaces PowerStoneWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_POWERSTONE"
Obituary "$OB_POWERSTONE"
Tag "$TAG_POWERSTONE"
weapon.ammotype "PowerStoneAmmo"
inventory.icon "POWSSI"
States
{
SpawnLoop:
WEA2 J -1
loop
Ready:
POWS E 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_POWERSTONE)
POWS E 1 A_WeaponReady
Goto Ready+1
Deselect:
POWS E 0
goto DeselectSwap
Select:
POWS E 0
goto SelectSwap
Fire:
POWS E 0 A_JumpIfNoAmmo("NoAmmo")
POWS E 0 A_PlaySoundEx("weapons/mm5/powerstonefire","Weapon")
POWS FG 2
POWS H 3 A_FireCustomMissile("PowerStoneSpawnerU",0,1,0,0)
POWS HH 8
POWS H 20
POWS GF 4
POWS E 0 A_Refire
Goto Ready+1
NoAmmo:
POWS E 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor PowerStoneSpawnerU : BasicWatcher
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("PowerStoneU", 46,0,-8,0,0,0,0)
TNT1 A 0 A_SpawnItemEx("PowerStoneU", 46,0,-8,0,0,0,-120)
TNT1 A 0 A_SpawnItemEx("PowerStoneU", 46,0,-8,0,0,0,120)
stop
}
}

actor PowerStoneU : PowerStone
{
damage (480)
}

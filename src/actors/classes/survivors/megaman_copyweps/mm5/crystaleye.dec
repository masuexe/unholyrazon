actor CrystalEyeWepU_MegaManUBar : MegaManUBar { Args 4, 193 }
actor CrystalEyeWepU : BaseMegaManUWep replaces CrystalEyeWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Inventory.Pickupmessage "$PU_CRYSTALEYE"
Obituary "$OB_CRYSTALEYE"
Tag "$TAG_CRYSTALEYE"
weapon.ammotype "CrystalEyeAmmo"
inventory.icon "CRYSSI"
States
{
SpawnLoop:
WEA2 N -1
loop
Ready:
CRYE K 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_CRYSTALEYE)
goto ReadyX
Deselect:
CRYE K 0
goto DeselectSwap
Select:
CRYE K 0
goto SelectSwap
Fire:
CRYE K 0 A_JumpIfNoAmmo("NoAmmo")
CRYE K 0 A_PlaySoundEx("weapons/mm5/crystaleyefire","Weapon")
CRYE K 0 A_FireCustomMissile("CrystalEyeShooterU",0,1,8,0)
CRY0 ABCDEF 2
CRY0 G 35 // 55 minus frames above, and frames below
CRY0 G 0 ACS_NamedExecuteWithResult("core_clientsound", CSND_CRYSTALRELOAD) // A_PlaySoundEx("weapons/mm5/crystaleyereload", "Weapon")
CRY0 HIJK 2
CRYE K 0 A_Refire
Goto ReadyX
}
}

actor CrystalEyeShooterU : CrystalEyeShooter replaces CrystalEyeShooter
{
    States
    {
    Spawn:
        TNT1 A 0
        TNT1 A 0 ACS_NamedExecuteWithResult("core_SetVelPitch",0,0)
        TNT1 A 1 A_CustomMissile("CrystalEyeU",0,0,0,CMF_AIMDIRECTION|CMF_SAVEPITCH,pitch)
        stop
    }
}

actor CrystalEyeU : CrystalEye replaces CrystalEye
{
Damage (500)
States
{
Spawn:
CRYE ABCDEAA 4
loop
Death:
// [Russ] Uses A_SpawnItemEx instead of A_CustomMissile becase the latter doesn't spawn bits at certain pitches.
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch), 0, sin(pitch), -15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch), 0, sin(pitch), 0, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch), 0, sin(pitch), 15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch-15), 0, sin(pitch-15), -15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch-15), 0, sin(pitch-15), 0, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch-15), 0, sin(pitch-15), 15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch+15), 0, sin(pitch+15), -15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch+15), 0, sin(pitch+15), 0, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("CrystalEyeBitU", 0, 0, 0, cos(pitch+15), 0, sin(pitch+15), 15, SXF_MULTIPLYSPEED)
TNT1 A 0 A_SpawnItemEx("ExplosionEffect1",0,0,0,0,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 0 A_PlaySoundEx("weapons/mm5/crystaleyesplit", "auto")
TNT1 A 35
stop
XDeath:
TNT1 A 0 A_PlaySoundEx("weapons/mm5/crystaleyehit", "auto")
TNT1 A 35
stop
}
}

actor CrystalEyeBitU : CrystalEyeBit replaces CrystalEyeBit
{
Damage(100)
}


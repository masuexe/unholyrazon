actor HeavyBomber_W_NormalBar : NormalBar {args 68, 72}
actor HeavyBomber_W_SecondBar : SecondBar {args 103, 111}

actor HeavyBomber_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 5
  Weapon.AmmoGive 200
  Weapon.AmmoUse2 0
  Weapon.AmmoGive2 175
  Inventory.Pickupmessage "$PU_19"
  Obituary "$OB_19W"
  Tag "$TAG_HeavyBomber_W"
  weapon.ammotype "SafeEnergyAmmo"
  weapon.ammotype2 "HFlightEnergyAmmo"
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H19 [ 6
    loop

   Deselect:
    6H19 A 0 //SetPlayerProperty(0,0,3)
    goto DeselectSwap
   Select:
    6H19 A 0
    goto SelectSwap

   Ready:
    6H19 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HEAVYBOMBER_DYE)
    goto Ready2
   Ready2:
    6H19 A 2 A_GiveInventory("HeavyBomber_Ready_P")
    loop

   Fire:
    6H19 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireA")
    6H19 A 0 A_GiveInventory("DuoBusterFlag", 1)
    6H19 D 2 A_GiveInventory("HeavyBomber_Fire_P1")
    6H19 E 2
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P2")
    6H19 H 2
    6H19 G 0 A_Refire("Fire2")
    6H19 G 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    Goto Ready2
   Fire2:
    6H19 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H19 A 0 A_JumpIfNoAmmo(6)
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P1")
    6H19 E 2
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P2")
    6H19 H 2
    6H19 G 0 A_Refire("Fire2")
    6H19 G 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    Goto Ready2
   FireA:
    6H19 A 0 A_TakeInventory("DuoBusterFlag", 9)
    6H19 G 2 A_GiveInventory("HeavyBomber_Fire_P2")
    6H19 H 2
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P1")
    6H19 E 2
    6H19 D 0 A_Refire("FireA2")
    6H19 D 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    Goto Ready2
   FireA2:
    6H19 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H19 A 0 A_JumpIfNoAmmo(6)
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P2")
    6H19 H 2
    6H19 B 2 A_GiveInventory("HeavyBomber_Fire_P1")
    6H19 E 2
    6H19 D 0 A_Refire("FireA2")
    6H19 D 2 A_GiveInventory("HFlightEnergyAmmo", 1)
    Goto Ready2

   BotFire:
    6H19 A 0 A_JumpIfNoAmmo("BotFire3")
    6H19 A 0 A_JumpIfInventory("HFlightEnergyAmmo", 0, "MissileSpam")
    6H19 A 0 A_Jump(16, "BotFire2")
    6H19 A 0 A_Jump(32, 1)
    goto BotFire4
    6H19 A 0 A_GiveInventory("SafeEnergyAmmo", 60)
    goto BotFire4
   BotFire2:
    6H19 A 0 A_SpawnItemEx("HSH_DustBoostFX")
    6H19 A 0 A_PlaySoundEx("taunt/D_19", "Voice")
    6H19 A 0 A_FaceTarget
    6H19 A 0 A_PlaySoundEx("weapon/airshooter", "Weapon")
    6H19 A 0 A_FireCustomMissile("DEMSpawnShot2Bot", -5, 1, 20, 0)
    6H19 A 0 A_FireCustomMissile("DEMSpawnShot2Bot", 5, 1, -20, 0)
    6H19 A 0 A_ChangeVelocity(-Cos(pitch)*10, 0, sin(pitch)*10, CVF_RELATIVE)
    6H19 BCB 2
    6H19 A 16
    goto Ready2
   BotFire3:
    6H19 A 0 A_PlaySoundEx("weapon/pursuitfire", "Weapon")
    6H19 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    6H19 BC 2
    6H19 CCCCCCCCCC 2 A_GiveInventory("SafeEnergyAmmo", 20)
    6H19 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    6H19 BA 2
    goto BotFire4
   BotFire4:
    6H19 A 0 A_Refire("BotFire4a")
    goto Ready2
   BotFire4a:
    6H19 A 0 A_JumpIfInventory("DuoBusterFlag", 1, 1)
    goto Fire2+1
    6H19 A 0
    goto FireA2+1

   AltFire:
   MissileSpam:
    6H19 D 0 A_GiveInventory("HeavyBomber_Alt_P1")
    6H19 D 0 A_ReFire(1)
    6H19 DE 2
    6H19 H 0 A_GiveInventory("HeavyBomber_Alt_P2")
    6H19 BH 2
    6H19 E 0 A_GiveInventory("HeavyBomber_Alt_P2")
    6H19 BE 2
    6H19 H 0 A_GiveInventory("HeavyBomber_Alt_P3")
    6H19 BH 2
    6H19 C 0 A_GiveInventory("HeavyBomber_Alt_P3")
    6H19 BC 2
    6H19 H 0 A_GiveInventory("HeavyBomber_Alt_P4")
    6H19 BH 2
    6H19 H 0 A_GiveInventory("HeavyBomber_Alt_P4")
    6H19 GA 2
    6H19 AAAA 4 A_GiveInventory("SafeEnergyAmmo", 4)
    6H19 A 0 A_TakeInventory("DisabledAirJumps", 1)
    6H19 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    Goto Ready2
  }
}

actor HFlightEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 175
  +INVENTORY.IGNORESKILL
}

actor SafeEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 200
  +INVENTORY.IGNORESKILL
}

actor HeavyBomber_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("SafeEnergyAmmo", 10, "Ready2a")
    TNT1 A 0 A_JumpIfInventory("HFlightEnergyAmmo", 0, "Ready2b")
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE)
    goto Ammo
   Ready2a:
    TNT1 A 0 A_JumpIfInventory("HFlightEnergyAmmo", 0, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
   Ready2b:
    TNT1 A 0 A_JumpIfInventory("SafeEnergyAmmo", 10, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
    goto Ammo
   Ready3:
    TNT1 A 0 A_WeaponReady
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("SafeEnergyAmmo", 4)
    TNT1 A 0 A_GiveInventory("HFlightEnergyAmmo", 1)
    stop
  }
}

actor HeavyBomber_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("HeavyBomberBullet", random(0, 2), 0, 8, 0)
   Pickup2:
    TNT1 A 0 A_PlaySoundEx("Contra/C_MACHG", "Weapon")
    TNT1 A 0 A_GiveInventory("HFlightEnergyAmmo", 2)
    TNT1 A 0 A_TakeInventory("SafeEnergyAmmo", 3, 1)
    TNT1 A 0 A_TakeInventory("SafeEnergyAmmo", 2)
    stop
  }
}
actor HeavyBomber_Fire_P2 : HeavyBomber_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("HeavyBomberBullet", random(-2, 0), 0, -8, 0)
    goto Pickup2
  }
}

actor HeavyBomber_Alt_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("DEMSpawnShot_H1", 0, 0, 0, 0)
    goto Start
   Start:
    TNT1 A 0 A_TakeInventory("HFlightEnergyAmmo", 110, 1)
    TNT1 A 0 A_TakeInventory("HFlightEnergyAmmo", 65)
    TNT1 A 0 A_GiveInventory("VivifyDelay4", 1)
    TNT1 A 0 A_GiveInventory("DisabledAirJumps", 1)//Prevent gaining double jumps back
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    goto Ammo
   Ammo:
    TNT1 A 0 A_PlaySoundEx("weapon/mirrordeflect2", "Weapon")
    TNT1 A 0 A_GiveInventory("SafeEnergyAmmo", 4)
    stop
  }
}
actor HeavyBomber_Alt_P2 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("DEMSpawnShot_H2", 0, 0, 0, 0)
    goto Ammo
  }
}
actor HeavyBomber_Alt_P3 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("DEMSpawnShot_H3", 0, 0, 0, 0)
    goto Ammo
  }
}
actor HeavyBomber_Alt_P4 : HeavyBomber_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("DEMSpawnShot_H4", 0, 0, 0, 0)
    goto Ammo
  }
}


actor HeavyBomberBullet : BasicProjectile {
  Translation "4:4=68:68", "192:192=72:72", "198:198=72:72"
  damagetype "HeavyBomber"
  Obituary "$OB_19M"
  //Alpha 0.90
  //RenderStyle Add
  Damage (69)
  Radius 6
  Height 6
  Speed 65
  Scale 2.0
  States {
   Spawn:
    X_0D A 1 A_SpawnItemEX("HeavyBomberBulletFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
   Death:
    TNT1 A 1 A_SpawnItemEX("HeavyBomberBulletFX2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor HeavyBomberBulletFX : BasicClientSide {
  Alpha 0.85
  //RenderStyle Add
  Scale 1.0
  States {
   Spawn:
    TNT1 A 2
    //HCBAK
    X_8G CBAK 1 A_FadeOut(0.1)
    stop
  }
}

actor HeavyBomberBulletFX2 : BasicClientSide {
  //Scale 3.0
  States {
   Spawn:
    6P19 B 0
    6P19 BCD 2
    //6P17 I 4
    stop
  }
}


actor DEMSpawnShot_H1 : BasicWatcher {
  Args 0, 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("DEMSpawnShot1", 0, 0, 0, 15, random(Args[0], 0), random(-Args[1], Args[1]*2))
    TNT1 A 0 A_SpawnItemEx("DEMSpawnShot1", 0, 0, 0, 15, random(0, -Args[0]), random(-Args[1], Args[1]*2))
    stop
  }
}
actor DEMSpawnShot_H2 : DEMSpawnShot_H1{Args 16, 0}
actor DEMSpawnShot_H3 : DEMSpawnShot_H1{Args 32, 8}
actor DEMSpawnShot_H4 : DEMSpawnShot_H1{Args 64, 16}

actor DEMSpawnShot1 : BasicProjectile {
  Translation "192:192=103:103", "198:198=111:111"
  damagetype "HeavyBomber"
  Obituary "$OB_19A1"
  //+RIPPER
  //+HEXENBOUNCE
  //-ALLOWBOUNCEONACTORS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +SKYEXPLODE
  damage (125)
  Radius 10
  Height 10
  speed 15
  scale 3.5
  Args 25, 128, 16
  States {
   Spawn:
    X_4G AAAAAAA 1 A_Recoil(3)
    X_4G A 0 A_Stop
    X_4G AAAA 2
    X_4G A 0 A_SpawnItemEx("DEMSpawnShot2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Death:
    X_8G A 0
    X_8G A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
    X_8G A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_8G ABCEFECBA 1 Bright
    stop
  }
}

actor DEMSpawnShot2 : DEMSpawnShot1 {
  Obituary "$OB_19A2"
  -BOUNCEONWALLS
  -BOUNCEONFLOORS
  -BOUNCEONCEILINGS
  +SEEKERMISSILE
  +SCREENSEEKER
  reactiontime 140
  damage (35)
  speed 70
  Args 45, 128, 16
  States {
   Spawn:
    X_4G ABAB 2 A_SeekerMissile(2, 10, SMF_LOOK, 50, 7)
    X_4G A 0 A_Recoil(-5)
    X_4G A 0 A_CountDown
    loop
  }
}

actor DEMSpawnShot2Bot : DEMSpawnShot2 {
  Obituary "$OB_19A3"
  damage (175)
  Args 125, 100, 16
  States {
   Spawn:
    X_4G AB 1 A_SeekerMissile(2, 8, SMF_LOOK, 50, 10)
    X_4G A 0 A_CountDown
    loop
  }
}

actor YellowWizard : CustWepClassBase {
  Player.ScoreIcon "UMUG_46"
  Player.DisplayName "YellowWizard"
  Player.SoundClass "YellowWizard"
  Player.MaxHealth 800
  Health 800
  Player.ForwardMove 0.66, 0.66
  Player.SideMove 0.66, 0.66
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "YellowWizard_W"
  Player.StartItem "YellowWizard_W2"
  Player.StartItem "YellowWizard_W3"
  Player.StartItem "YellowWizard_W4"
  Player.StartItem "YellowWizard_W5"
  Player.StartItem "YellowWizard_W6"
  Player.StartItem "BluePotionAmmo", 150

  Player.WeaponSlot 1, "YellowWizard_W"
  Player.WeaponSlot 2, "YellowWizard_W2"
  Player.WeaponSlot 3, "YellowWizard_W3"
  Player.WeaponSlot 4, "YellowWizard_W4"
  Player.WeaponSlot 5, "YellowWizard_W5"
  Player.WeaponSlot 6, "YellowWizard_W6"
  States {
   Spawn:
    MGIC A 0
    MGIC B 1
    MGIC A 1
    goto Spawn+2
   See:
    MGIC BCDE 5
    goto Spawn
   Missile:
    MGIC F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile2")
    MGIC F 5
    MGIC G 5
    goto Spawn+2
   Missile2:
    MGIC G 8
    goto Spawn+2
   ClassPain:
    MGIC H 0
    goto MegamanPain

   ClassDeath:
    MGIC H 0
    goto MegamanDeath
   MegamanDeath0:
    MGIC H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    MGIC H 0 A_SpawnItemEx("GauntletTreasure_P", 0, 0, Height / 2, random2() / 256.0, random2() / 256.0, 5.0 + random2() / 64.0)
    goto MegamanFade3
   MegamanDisintegrate:
    MGIC Z 0 A_SpawnItemEx("Corpse_46", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor YellowWizardShiny : YellowWizard {
  Player.ScoreIcon "UMUG_S46"
  Player.MaxHealth 2800
  Health 2800
  Player.ForwardMove 0.77, 0.77
  Player.SideMove 0.77, 0.77
  Player.JumpZ 11
  Player.MorphWeapon "YellowWizardShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor Corpse_46 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_46_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_46_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


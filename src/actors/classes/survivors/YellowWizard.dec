actor YellowWizard : CustWepClassBase
{
player.scoreIcon "UMUG_46"
player.displayname "YellowWizard"
player.soundclass "YellowWizard"
Player.Maxhealth 800
health 800
player.forwardmove 0.66, 0.66
player.sidemove 0.66, 0.66
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "YellowWizard_W"
player.startitem "YellowWizard_W2"
player.startitem "YellowWizard_W3"
player.startitem "YellowWizard_W4"
player.startitem "YellowWizard_W5"
player.startitem "YellowWizard_W6"
player.startitem "BluePotionAmmo", 150

player.weaponslot 1, "YellowWizard_W"
player.weaponslot 2, "YellowWizard_W2"
player.weaponslot 3, "YellowWizard_W3"
player.weaponslot 4, "YellowWizard_W4"
player.weaponslot 5, "YellowWizard_W5"
player.weaponslot 6, "YellowWizard_W6"
States
{
Spawn:
MGIC A 0
MGIC B 1
MGIC A 1
Goto Spawn+2
See:
MGIC BCDE 5
Goto Spawn
Missile:
MGIC F 0 A_JumpIfInventory("VivifyFlag1",1,"Missile2")
MGIC F 5
MGIC G 5
goto Spawn+2
Missile2:
MGIC G 8
goto Spawn+2
ClassPain: MGIC H 0
Goto MegamanPain

ClassDeath:
MGIC H 0
goto MegamanDeath
MegamanDeath0:
MGIC H 0 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
MGIC H 0 A_SpawnItemEx("GauntletTreasure_P",0,0,Height/2,random2()/256.0,random2()/256.0,5.0+random2()/64.0)
Goto MegamanFade3
MegamanDisintegrate:
MGIC Z 0 A_SpawnItemEx("Corpse_46",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor YellowWizardShiny : YellowWizard
{
player.scoreIcon "UMUG_S46"
Player.Maxhealth 2800
health 2800
player.forwardmove 0.77, 0.77
player.sidemove 0.77, 0.77
player.jumpz 11
player.morphweapon "YellowWizardShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
}


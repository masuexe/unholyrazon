actor HomingSeeker : CustWepClassBase
{
player.scoreIcon "UMUG_13"
player.displayname "HomingSeeker"
player.soundclass "HomingSeeker"
player.maxhealth 925
health 925
player.forwardmove 0.95, 0.95
player.sidemove 0.95, 0.95
player.jumpz 12
player.startitem "UH_BaseFlagPack"
player.startitem "HomingSeeker_W"
player.startitem "MagnetEnergyAmmo", 25
States
{
Spawn:
1H13 A 0
1H13 B 1
1H13 A 1
Goto Spawn+2
See:
1H13 BCDE 5
Goto Spawn
Missile:
1H13 F 5
1H13 G 4
goto Spawn+2
ClassPain:
1H13 H 0
Goto MegamanPain

ClassDeath:
1H13 H 0
goto MegamanDeath
MegamanDeath0:
1H13 H 19 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
1H13 H 0 A_PlaySound("*death",2)
1H13 H 0 A_PlaySound("misc/mm3explosion",1)
1H13 H 0 A_SpawnItemEx("HomingSeekerCorpse",0,0,0,0,0,1,0,1)
1H13 H 1 A_SetTranslucent(0.00,0)
Goto MegamanErase
MegamanCorpse:
1H13 Z 0 A_SpawnItemEx("Corpse_13",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}

actor HomingSeeker : CustWepClassBase {
  Player.ScoreIcon "UMUG_13"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "HomingSeeker"
  Player.SoundClass "HomingSeeker"
  Player.MaxHealth 925
  Health 925
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "HomingSeeker_W"
  Player.StartItem "MagnetEnergyAmmo", 25
  States {
   Spawn:
    1H13 A 0
    1H13 B 1
    1H13 A 1
    goto Spawn+2
   See:
    1H13 BCDE 5
    goto Spawn
   Missile:
    1H13 F 5
    1H13 G 4
    goto Spawn+2
   ClassPain:
    1H13 H 0
    goto MegamanPain

   ClassDeath:
    1H13 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H13 H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H13 H 0 A_PlaySound("*death", 2)
    1H13 H 0 A_PlaySound("misc/mm3explosion", 1)
    1H13 H 0 A_SpawnItemEx("HomingSeekerCorpse", 0, 0, 0, 0, 0, 1, 0, 1)
    1H13 H 1 A_SetTranslucent(0.00, 0)
    goto MegamanErase
   MegamanDisintegrate:
    1H13 Z 0 A_SpawnItemEx("Corpse_13", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor HomingSeekerShiny : HomingSeeker {
  Player.ScoreIcon "UMUG_S13"
  Player.MaxHealth 2925
  Health 2925
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.1, 1.1
  Player.JumpZ 13
  Player.MorphWeapon "HomingSeekerShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    1H13 H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H13 H 0 A_PlaySound("*death", 2)
    1H13 H 0 A_PlaySound("misc/mm3explosion", 1)
    1H13 H 0 A_SpawnItemEx("S_HomingSeekerCorpse", 0, 0, 0, 0, 0, 1, 0, 1)
    1H13 H 1 A_SetTranslucent(0.00, 0)
    goto MegamanErase
  }
}

actor HomingSeekerCorpse : BasicProjectile {
  DamageType "HomingSeekerFling"
  Obituary "$OB_13D"
  +SEEKERMISSILE
  ReactionTime 9
  Damage (0)
  Radius 16
  Height 56
  Speed 60
  Scale 2.5
  Args 325, 168, 32
  States {
   Spawn:
    1H13 HHHHHHHHHH 2 A_SeekerMissile(90, 90, SMF_LOOK, 256, 5)
    1H13 H 0 A_CountDown
    loop
   Death:
    1H13 H 0 A_PlaySound("wep_L/mm1/hyperbombexplode", 1)
    1H13 H 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_HomingSeekerCorpse : HomingSeekerCorpse {
  Args 488, 168, 32
}

actor Corpse_13 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_13_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_13_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


7H37 D 0 A_GiveInventory("FlowEnergyAmmo",4)
7H37 D 0 A_JumpIfInventory("TidalShieldFlag",1,"ReadyT2")
goto Ready2

Fire:
7H37 D 0 A_GiveInventory("S_TidalM_Fire_P2")
7H37 D 0 A_JumpIfInventory("TidalShieldFlag",1,"FireNo")
7H37 E 2
7H37 F 2 A_GiveInventory("TideEnergyAmmo",2)
7H37 D 2
7H37 D 2 A_GiveInventory("TideEnergyAmmo",2)

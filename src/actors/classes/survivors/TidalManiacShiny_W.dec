BotFireX:
7H37 D 0 A_PlaySoundEx("taunt/D_37","Voice")
7H37 D 0 A_PlaySound("Contra/C_FLAME",1)
7H37 DDDDDDDDDDDDDDDDDDDDDDDDD 0 A_FireCustomMissile("S_TidalManiacMine",random(-90,90),0,8,0,1,random(-90,90))
7H37 EFDD 2
//7H37 D 0 A_SpawnItemEx("TidalManiac_BotTorrent",0,0,56)
7H37 D 0 A_SpawnItemEx("TidalManiac_BotTorrent2",0,0,-256)
goto BotReady

BotFire:
7H37 D 0 A_GiveInventory("S_TidalM_Fire_P2")
7H37 D 0 A_JumpIfInventory("TidalShieldFlag",1,"BotFire2")
7H37 E 2
7H37 F 2 A_GiveInventory("TideEnergyAmmo",2)
7H37 D 2

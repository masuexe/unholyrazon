Ready:
7H37 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", TIDALMANIAC_DYE)
7H37 D 0 A_GunFlash("Flash",1)
7H37 D 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2

Ready2:
7H37 D 2 A_GiveInventory("TidalManiac_Ready_P")
7H37 D 0 A_GiveInventory("FlowEnergyAmmo",2)
7H37 D 0 A_GiveInventory("TideEnergyAmmo",1)
loop

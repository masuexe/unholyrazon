actor S_TidalM_Fire_P0 : TidalM_Fire_P0
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_SpectrumTidalNoAmmo",random(-4,4),0,8,0,1,random(-2,2))
goto End
}
}
actor S_TidalM_Fire_P1 : TidalM_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TidalManiacLaser_H",0,0,8,0)
goto End
}
}
actor S_TidalM_Fire_P2 : TidalM_Fire_P2
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_TidalManiacMine",0,0,0,0)
goto End
}
}

actor S_TidalManiacLaser_H : TidalManiacLaser_H
{
Translation "192:192=236:236","198:198=246:246","199:199=251:251"
Args 450,18//0 (35*1.5-35)
}

actor S_SpectrumTidalNoAmmo : SpectrumTidalNoAmmo
{
Translation "192:192=236:236","198:198=246:246","199:199=251:251"
Damage (53)//35
}

actor S_TidalManiacMine : TidalManiacMine
{
Translation "192:192=236:236","198:198=246:246","199:199=251:251"
Health 300//200
States
{
Death:
DIVA M 0 A_ChangeFlag("DONTBLAST",1)
DIVA M 0 A_ChangeFlag("SHOOTABLE",0)
DIVA N 0 A_SetGravity(0.0)
DIVA N 0 A_JumpIfInventory("UOnce",1,"DeathCheck")
goto DeathFlung
DeathCheck:
DIVA N 0 A_RearrangePointers(AAPTR_TRACER)
DIVA N 1 A_Stop
DIVA N 0 A_PlaySoundEx("TidalM/MineBoom","Weapon")
DIVA N 0 A_JumpIfInventory("TidalShieldFlag",1,"DeathFlung")
TNT1 A 10 A_SpawnItemEx("S_TidalManiacMineExplode",0,0,8,0,0,0,0,1)
stop
DeathFlung:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("TidalM/MineBoom","Weapon")
TNT1 A 10 A_SpawnItemEx("S_TidalManiacMineExplodeFlung",0,0,8,0,0,0,0,1)
stop
}
}

actor S_TidalManiacMineExplode : TidalManiacMineExplode
{
Args 225,128,18//150
}

actor S_TidalManiacMineExplodeFlung : TidalManiacMineExplodeFlung
{
Args 300,148,36//200
}


actor S_TidalM_WaveBoom : TidalM_WaveBoom
{
Args 135,112,24//90
}

actor S_TidalM_Wave_H : TidalM_Wave_H
{
Translation "192:192=236:236","198:198=246:246","199:199=251:251"
States
{
Spawn:
TNT1 A 0
goto SpawnL
SpawnL:
TNT1 A 0 A_SpawnItemEx("TidalM_Wave",64,0,0,25,0,0,0+Args[0]*15,1)
TNT1 A 0 A_CountDownArg(0)
loop
}
}

Actor S_TidalM_Wave : TidalM_Wave
{
Damage (218)//145
}

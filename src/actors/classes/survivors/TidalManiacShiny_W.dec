BotSwap:
7H37 D 0 A_GiveInventory("TideEnergyAmmo",40)
7H37 D 0 A_ClearReFire
7H37 D 0 //A_PlaySoundEx("taunt/D_37","Voice")
7H37 D 0 A_Jump(198,1,2)
goto BotFire
7H37 D 0 A_SelectWeapon("TidalManiac_W")
goto BotFire

actor TidalManiacShiny_W_NormalBar : NormalBar {args 236, 246}
actor TidalManiacShiny_W_SecondBar : TidalManiac_W_SecondBar {}

actor TidalManiacShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_TidalManiac_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_37_A"
Obituary "$OB_37W1"
weapon.ammotype "FlowEnergyAmmo"
weapon.ammotype2 "TideEnergyAmmo"
+WEAPON.NOAUTOAIM
inventory.icon "C_I_37A"
States
{
Spawn:
7H37 [ 6
loop

Deselect:
7H37 A 0
goto DeselectSwap
Select:
7H37 A 0
goto SelectSwap

Ready:
7H37 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TIDALMANIAC_SDYE)
7H37 A 0 A_GunFlash("Flash",1)
7H37 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
Goto Ready2

Ready2:
7H37 A 2 A_GiveInventory("TidalManiac_Ready_P")
7H37 A 0 A_GiveInventory("FlowEnergyAmmo",2)
7H37 A 0 A_GiveInventory("TideEnergyAmmo",1)
loop
ReadyT2:
7H37 A 2 A_GiveInventory("TidalManiac_Ready_P")
7H37 A 0 A_GiveInventory("FlowEnergyAmmo",4)
7H37 A 0 A_JumpIfInventory("TidalShieldFlag",1,"ReadyT2")
goto Ready2

Fire:
//7H37 B 0 A_JumpIfNoAmmo("NoAmmoFire")
7H37 C 0 A_GiveInventory("S_TidalM_Fire_P1")
7H37 C 0 A_JumpIfInventory("TidalShieldFlag",1,"Fire2")
7H37 C 2
7H37 C 6 A_GiveInventory("TideEnergyAmmo",4)
7H37 B 8 A_GiveInventory("TideEnergyAmmo",4)
7H37 A 6 A_GiveInventory("TideEnergyAmmo",3)
goto Ready2
Fire2:
7H37 CB 6
7H37 A 4
goto ReadyT2

NoAmmoFire:
7H37 BC 2 A_GiveInventory("S_TidalM_Fire_P0")
7H37 C 0 A_Refire("NoAmmoFire")
7H37 C 0 A_JumpIfInventory("TidalShieldFlag",1,3)
7H37 BA 2 A_GiveInventory("TideEnergyAmmo",1)
goto Ready2
7H37 BA 2
goto ReadyT2

AltFire:
7H37 B 0 A_JumpIfInventory("TidalShieldFlag",1,"WaveAttack")
7H37 B 0 A_PlaySound("misc/waterslide",1)
7H37 EBFCEB 2
7H37 A 0 A_GiveInventory("TidalShieldFlag",1)
Goto ReadyT2
WaveAttack:
7H37 A 0 A_TakeInventory("TideEnergyAmmo",70,1)
7H37 A 0 A_TakeInventory("TideEnergyAmmo",70)
7H37 A 0 A_TakeInventory("TidalShieldFlag",1)
7H37 ECFB 2
Goto Ready2

Flash:
TNT1 A 1
TNT1 A 0 A_JumpIfInventory("TidalShieldFlag",1,"Flash.Shield")
loop
Flash.Shield:
TNT1 A 0 A_TakeInventory("TideEnergyAmmo",3,1)
TNT1 A 0 A_TakeInventory("TideEnergyAmmo",2)
TNT1 A 0 A_JumpIfInventory("TideEnergyAmmo",1,1)
Goto Flash.ShieldEnd
TNT1 A 0 A_JumpIfInventory("TidalShieldFlag",1,1)
Goto Flash.ShieldEnd
TNT1 A 0 A_SpawnItemEx("S_TidalM_WaveBoom",0,0,32,momx,momy,momz,0,8)
TNT1 AA 1 A_SpawnItemEx("TidalM_WaveFX_H1",0,0,0,momx,momy,momz,0,1+8)
TNT1 AA 1 A_SpawnItemEx("TidalM_WaveFX_H2",0,0,0,momx,momy,momz,0,1+8)
TNT1 A 0 A_SpawnItemEx("S_TidalM_WaveBoom",0,0,32,momx,momy,momz,0,8)
TNT1 AA 1 A_SpawnItemEx("TidalM_WaveFX_H3",0,0,0,momx,momy,momz,0,1+8)
TNT1 AA 1 A_SpawnItemEx("TidalM_WaveFX_H4",0,0,0,momx,momy,momz,0,1+8)
loop
Flash.ShieldEnd:
TNT1 A 0 A_TakeInventory("TidalShieldFlag")
TNT1 A 0 A_FireCustomMissile("S_TidalM_Wave_H",0,0,0,0)
Goto Flash


BotReady:
7H37 A 0 A_WeaponReady(12)
7H37 A 2 A_Refire("BotCheck")
7H37 A 0 A_GiveInventory("FlowEnergyAmmo",2)
7H37 A 0 A_GiveInventory("TideEnergyAmmo",1)
loop
BotReady2:
7H37 A 0 A_WeaponReady(12)
7H37 A 2 A_Refire("BotCheck")
7H37 A 0 A_GiveInventory("FlowEnergyAmmo",4)
7H37 A 0 A_JumpIfInventory("TidalShieldFlag",1,"BotReady2")
goto BotReady

BotSwap:
7H37 A 0 A_GiveInventory("TideEnergyAmmo",40)
7H37 A 0 A_ClearReFire
7H37 A 0 //A_PlaySoundEx("taunt/D_37","Voice")
7H37 A 0 A_Jump(198,1,2)
goto BotFire
7H37 A 0 A_SelectWeapon("TidalManiac_W")
goto BotFire
7H37 A 0 A_SelectWeapon("TidalManiac_W2")
goto BotFire

BotCheck:
7H37 A 0 A_GiveInventory("FlowEnergyAmmo",25)
7H37 A 0 A_Jump(8,"BotFireX")
7H37 A 0 A_Jump(32,"BotSwap")
7H37 A 0 A_JumpIfInventory("TidalShieldFlag",1,2)
7H37 A 0 A_JumpIfInventory("TideEnergyAmmo",0,"BotAlt")
goto BotFire
7H37 A 0 A_Jump(8,"BotAlt2")
goto BotFire

BotFire:
7H37 C 0 A_GiveInventory("S_TidalM_Fire_P1")
7H37 C 0 A_JumpIfInventory("TidalShieldFlag",1,5)
7H37 C 2
7H37 C 6 A_GiveInventory("TideEnergyAmmo",4)
7H37 B 8 A_GiveInventory("TideEnergyAmmo",4)
7H37 A 6 A_GiveInventory("TideEnergyAmmo",3)
goto BotReady
7H37 CB 6
7H37 A 4
goto BotReady2

BotFireX:
7H37 A 0 A_PlaySoundEx("taunt/D_37","Voice")
7H37 A 0 A_PlaySound("Contra/C_FLAME",1)
7H37 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_FireCustomMissile("SpectrumTidalNoAmmo",random(-8,8),0,8,0,1,random(0,5))
goto BotFire+1

BotAlt:
7H37 B 0 A_JumpIfInventory("TidalShieldFlag",1,"BotAlt2")
7H37 B 0 A_PlaySound("misc/waterslide",1)
7H37 EBFCEB 2
7H37 A 0 A_GiveInventory("TidalShieldFlag",1)
Goto BotReady2
BotAlt2:
7H37 A 0 A_PlaySound("wep_L/TactBombAlt2",1)
7H37 A 0 A_TakeInventory("TideEnergyAmmo",70,1)
7H37 A 0 A_TakeInventory("TidalShieldFlag",1)
7H37 ECFB 2
Goto BotReady
}
}

actor TidalManiacShiny_W2_NormalBar : TidalManiacShiny_W_NormalBar {}
actor TidalManiacShiny_W2_SecondBar : TidalManiacShiny_W_SecondBar {}
actor TidalManiacShiny_W2 : TidalManiacShiny_W

actor Raider : CustWepClassBase {
  Player.ScoreIcon "UMUG_17"
  Player.DisplayName "Raider"
  Player.SoundClass "raider"
  Player.MaxHealth 800
  Health 800
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.0, 1.0
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Raider_W"
  Player.StartItem "Raider_W2"
  Player.StartItem "ShadowEnergyAmmo", 100
  Player.StartItem "HookshotStamina", 666

  Player.WeaponSlot 1, "Raider_W"
  Player.WeaponSlot 2, "Raider_W2"
  States {
   Spawn:
    "%SHA" A 0
    "%SHA" B 1
    "%SHA" A 1
    goto Spawn+2
   See:
    "%SHA" BCDE 5
    goto Spawn
   Missile:
    "%SHA" FF 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileSwipe")
    "%SHA" F 3
    "%SHA" G 4
    goto Spawn+2
   MissileSwipe:
    "%SHA" FGFFG 5
    goto Spawn+2

   ClassPain:
    "%SHA" H 0
    goto MegamanPain

   ClassDeath:
    "%SHA" H 0
    goto MegamanDeath
   MegamanDeath0:
    "%SHA" HHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    "%SHA" FFFGGG 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    "%SHA" H 0 A_SpawnItemEx("RaiderPoofDeath_H", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    "%SHA" Z 0 A_SpawnItemEx("Corpse_17", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor RaiderShiny : Raider {
  Player.ScoreIcon "UMUG_S17"
  Player.MaxHealth 2800
  Health 2800
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.1, 1.1
  Player.JumpZ 13
  Player.MorphWeapon "RaiderShiny_W"
  Player.WeaponSlot 1, "RaiderShiny_W"
  Player.WeaponSlot 2, "RaiderShiny_W2"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    "%SHA" HHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    "%SHA" FFFGGG 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    "%SHA" H 0 A_SpawnItemEx("S_RaiderPoofDeath_H", 0, 0, 28, 0, 0, 0, 0, 1)
    goto MegamanErase
  }
}

actor RaiderPoofDeath : BasicExplosion {
  DamageType "Raider"
  Obituary "$OB_17D"
  Scale 2.0
  States {
   Spawn:
    6P17 J 0
    6P17 JKJKJKJK 4 A_Explode(12 + args[0], 86, 0, 0, 16)
    stop
  }
}

actor RaiderPoofDeath_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pitfall/Boom", 1)
    TNT1 A 0 A_SpawnItemEx("RaiderPoofDeath", 0, 0, 0, 0, 0, 0, 0, 1 + SXF_TRANSFERSPECIAL)  // 32768
    TNT1 AAAAAA 0 A_SpawnItemEx("RaiderPoofDeath", random(-96, 96), random(-96, 96), random(0, 96), 0, 0, 0, 0, 1 + 32768)
    TNT1 AAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("RaiderPoofDeath", random(-96, 96), random(-96, 96), random(0, 96), 0, 0, 0, 0, 1 + 32768)
    stop
  }
}
actor S_RaiderPoofDeath_H : RaiderPoofDeath_H {
  Args 6
}

actor Corpse_17 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_17_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_17_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_17_0 : BaseCorpseFX {States {Spawn: 1H17 O 350
    goto Spawn2}}
actor Corpse_17_1 : BaseCorpseFX {States {Spawn: 1H17 P 350
    goto Spawn2}}
actor Corpse_17_2 : BaseCorpseFX {States {Spawn: 1H17 Q 350
    goto Spawn2}}
actor Corpse_17_3 : BaseCorpseFX {States {Spawn: 1H17 R 350
    goto Spawn2}}
actor Corpse_17_4 : BaseCorpseFX {States {Spawn: 1H17 S 350
    goto Spawn2}}
actor Corpse_17_5 : BaseCorpseFX {States {Spawn: 1H17 T 350
    goto Spawn2}}
actor Corpse_17_6 : BaseCorpseFX {States {Spawn: 1H17 U 350
    goto Spawn2}}

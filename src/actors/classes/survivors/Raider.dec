actor Raider : CustWepClassBase
{
player.scoreIcon "UMUG_17"
player.displayname "Raider"
player.soundclass "raider"
Player.Maxhealth 800
health 800
player.forwardmove 1.1, 1.1
player.sidemove 1.0, 1.0
player.jumpz 12
player.startitem "UH_BaseFlagPack"
player.startitem "Raider_W"
player.startitem "Raider_W2"
player.startitem "ShadowEnergyAmmo", 100
player.startitem "HookshotStamina", 666

player.weaponslot 1, "Raider_W"
player.weaponslot 2, "Raider_W2"
States
{
Spawn:
"%SHA" A 0
"%SHA" B 1
"%SHA" A 1
Goto Spawn+2
See:
"%SHA" BCDE 5
Goto Spawn
Missile:
"%SHA" FF 1 A_JumpIfInventory("VivifyDelay4",1,"MissileSwipe")
"%SHA" F 3
"%SHA" G 4
goto Spawn+2
MissileSwipe:
"%SHA" FGFFG 5
goto Spawn+2

ClassPain:
"%SHA" H 0
Goto MegamanPain

ClassDeath:
"%SHA" H 0
Goto MegamanDeath
MegamanDeath0:
"%SHA" HHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
"%SHA" FFFGGG 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
"%SHA" H 0 A_SpawnItemEx("RaiderPoofDeath_H",0,0,28,0,0,0,0,1)
Goto MegamanErase
ClassCorpse:
"%SHA" Z 0 A_SpawnItemEx("Corpse_17",0,0,0,momx,momy,momz,0,9)
Goto MegaDeathEndGib
}
}
actor RaiderS : Raider
{
player.scoreIcon "UMUG_S17"
Player.Maxhealth 2800
health 2800
player.forwardmove 1.3, 1.3
player.sidemove 1.1, 1.1
player.jumpz 13
player.morphweapon "RaiderS_W"
player.weaponslot 1, "RaiderS_W"
player.weaponslot 2, "RaiderS_W2"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
"%SHA" HHHHHHHHHHH 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
"%SHA" FFFGGG 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
"%SHA" H 0 A_SpawnItemEx("S_RaiderPoofDeath_H",0,0,28,0,0,0,0,1)
Goto MegamanErase
}
}

actor RaiderPoofDeath : BasicExplosion
{
Damagetype "Raider"
Obituary "$OB_17D"
scale 2.0
States
{
Spawn:
6P17 J 0
6P17 JKJKJKJK 4 A_Explode(12+Args[0],86,0,0,16)
stop
}
}

actor RaiderPoofDeath_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySound("Pitfall/Boom",1)
TNT1 A 0 A_SpawnItemEx("RaiderPoofDeath",0,0,0,0,0,0,0,1+SXF_TRANSFERSPECIAL)//32768
TNT1 AAAAAA 0 A_SpawnItemEx("RaiderPoofDeath",random(-96,96),random(-96,96),random(0,96),0,0,0,0,1+32768)
TNT1 AAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("RaiderPoofDeath",random(-96,96),random(-96,96),random(0,96),0,0,0,0,1+32768)
stop
}
}
actor S_RaiderPoofDeath_H : RaiderPoofDeath_H
{
Args 6
}

actor Corpse_17:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_17_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_17_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


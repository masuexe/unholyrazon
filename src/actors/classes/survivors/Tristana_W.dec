}

actor TristanaExplosiveChargeSit : TristanaExplosiveChargeFollow
{
+FORCEXYBILLBOARD
States
{
Spawn:
6P38 M 0
6P38 M 0 A_GiveInventory("TristanaExplosiveChargeProtect",1)
6P38 M 0 A_ChangeFlag("NOPAIN",0)
goto BoomWait

Pain.Tristana:
TNT1 A 0 A_PlaySound("KirbyNES/CranePoints",6,1.0)
TNT1 A 0 A_GiveInventory("TristanaExplosiveChargeProtect",1)
TNT1 A 0 A_JumpIf(user_D>=3,"DeathEnder")
TNT1 A 0 A_SetUserVar("user_D",user_D+1)
TNT1 A 0 A_SetScale(ScaleX+user_D*0.250)
goto BoomWait

BoomWait:
6P38 M 0 A_JumpIf(Args[0]<=14,"BoomWaitLow")
6P38 M 4
6P38 N 0 A_CountDownArg(0)
6P38 N 4 
6P38 N 0 A_CountDownArg(0)
loop
BoomWaitLow:
6P38 MN 2
6P38 M 0 A_CountDownArg(0)
loop

DeathEnder:
6P38 M 1 A_CountDownArg(1)
wait

Death:
TNT1 A 0 A_PlaySound("KirbyNES/NightMBoom",7,1.0)
TNT1 A 0 A_Explode(125+random(136,164)*user_D,196,0,0,48)
X_1D BCDEFGHIJKLMN 1 Bright
//TNT1 A 10 //A_SpawnItemEx("TristanaExplosiveChargeFX",0,0,12,0,0,0,0,1)
stop
}
}



Actor TristanaExplosiveCharge : BasicProjectile
{
Translation "202:202=161:161","192:192=163:163","198:198=154:154","199:199=157:157"
Damagetype "Tristana"
Obituary "$OB_38A1"
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
+HITTRACER
Damage (50)
Radius 14
Height 14
speed 60
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("Trist/BombToss","Weapon")
TNT1 A 0 A_JumpIfInTargetInventory("IsBot",1,"SpawnB")
TNT1 A 1 ThrustThingZ(0,24,0,1)
6P38 M 1
wait
SpawnB:
TNT1 A 1 ThrustThingZ(0,4,0,1)
6P38 M 1
wait
XDeath:

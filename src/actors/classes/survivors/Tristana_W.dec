TNT1 A 4 A_SpawnItemEx("TristanaExplosiveChargeSit",0,0,0,0,0,0,0,1)
stop
}
}

actor TristanaExplosiveChargeFollow : UH_ShootableActor
{
var int user_D;
PROJECTILE
Damagetype "Tristana"
Obituary "$OB_38A2"
+THRUACTORS
+DONTBLAST
+DONTREFLECT
+NOTARGETSWITCH
+NOPAIN
+SHOOTABLE
-NOBLOCKMAP
Health 1000000

painchance 256
damagefactor "Normal", 0.0
damagefactor "Tristana", 1.0
Damage (0)
Radius 4
Height 4
Speed 10
Scale 2.5
Args 54//Duration 54*4=216
States
{
Spawn:
6P38 T 0
6P38 T 0 A_GiveInventory("TristanaExplosiveChargeProtect",1)
6P38 T 0 A_ChangeFlag("NOPAIN",0)
goto BoomWait

Pain.Tristana:
TNT1 A 0 A_PlaySound("KirbyNES/CranePoints",6,1.0)
TNT1 A 0 A_GiveInventory("TristanaExplosiveChargeProtect",1)
TNT1 A 0 A_JumpIf(user_D>=3,"DeathEnder")
TNT1 A 0 A_SetUserVar("user_D",user_D+1)
TNT1 A 0 A_SetScale(ScaleX+user_D*0.250)
TNT1 A 0 A_JumpIf(user_D>=3,"BoomWait4")
TNT1 A 0 A_JumpIf(user_D>=2,"BoomWait3")
TNT1 A 0 A_JumpIf(user_D>=1,"BoomWait2")
goto BoomWait

BoomWait:
6P38 O 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 O 0 A_JumpIf(Args[0]<=14,"BoomWaitLow")
6P38 OOOO 1 A_Warp(8,0,0,28,0,24)
6P38 P 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 P 0 A_CountDownArg(0)
6P38 P 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 PPPP 1 A_Warp(8,0,0,28,0,24)
6P38 O 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 O 0 A_CountDownArg(0)
loop
BoomWaitLow:
6P38 O 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 OOPP 1 A_Warp(8,0,0,28,0,24)
6P38 O 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 O 0 A_CountDownArg(0)
loop

BoomWait2:
6P38 Q 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 Q 0 A_JumpIf(Args[0]<=14,"BoomWait2Low")
6P38 QQQQ 1 A_Warp(8,0,0,28,0,24)
6P38 R 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 R 0 A_CountDownArg(0)
6P38 R 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 RRRR 1 A_Warp(8,0,0,28,0,24)
6P38 Q 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 Q 0 A_CountDownArg(0)
loop
BoomWait2Low:
6P38 Q 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 QQRR 1 A_Warp(8,0,0,28,0,24)
6P38 Q 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 Q 0 A_CountDownArg(0)
loop

BoomWait3:
6P38 S 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 S 0 A_JumpIf(Args[0]<=14,"BoomWait3Low")
6P38 SSSS 1 A_Warp(8,0,0,28,0,24)
6P38 T 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 T 0 A_CountDownArg(0)
6P38 T 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 TTTT 1 A_Warp(8,0,0,28,0,24)
6P38 S 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 S 0 A_CountDownArg(0)
loop
BoomWait3Low:
6P38 S 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 SSTT 1 A_Warp(8,0,0,28,0,24)
6P38 S 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 S 0 A_CountDownArg(0)
loop

BoomWait4:
6P38 U 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 U 0 A_JumpIf(Args[0]<=14,"BoomWait4Low")
6P38 UUUU 1 A_Warp(8,0,0,28,0,24)
6P38 V 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 V 0 A_CountDownArg(0)
6P38 V 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 VVVV 1 A_Warp(8,0,0,28,0,24)
6P38 U 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 U 0 A_CountDownArg(0)
loop
BoomWait4Low:
6P38 U 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I",8)
6P38 UUVV 1 A_Warp(8,0,0,28,0,24)
6P38 U 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
6P38 U 0 A_CountDownArg(0)
loop

//CANTSEEK
BoomWait_I://Turns mine invisible if target is invisible
TNT1 A 0 A_JumpIfInventory("MM8BDMPlayer",1,1,8)//Online sync
BoomWait_I2://Online sync
TNT1 AAAA 1 A_Warp(8,0,0,28,0,24)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "Death")
TNT1 A 0 A_CountDownArg(0)
TNT1 A 0 A_CheckFlag("DONTIDENTIFYTARGET","BoomWait_I2",8)
TNT1 A 0 A_JumpIfInventory("MM8BDMPlayer",1,"BoomWait_I3",8)//Online sync
goto BoomWait_I2//Online sync
BoomWait_I3:
TNT1 A 0 A_JumpIf(user_D>=3,"BoomWait4")
TNT1 A 0 A_JumpIf(user_D>=2,"BoomWait3")
TNT1 A 0 A_JumpIf(user_D>=1,"BoomWait2")
goto BoomWait

DeathEnder:
6P38 T 1 A_CountDownArg(1)
wait

Death:
TNT1 A 0 A_Warp(8,0,0,28,0,24)
TNT1 A 0 A_PlaySound("KirbyNES/NightMBoom",7,1.0)
TNT1 A 0 A_Explode(125+random(136,164)*user_D,196,0,0,48)
X_1D BCDEFGHIJKLMN 1 Bright
//TNT1 A 10 //A_SpawnItemEx("TristanaExplosiveChargeFX",0,0,12,0,0,0,0,1)
stop
}
}


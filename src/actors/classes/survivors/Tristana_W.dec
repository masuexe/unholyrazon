actor Tristana_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TristanaFlag",56,2)
TNT1 A 0 A_FireCustomMissile("TristanaBasicAttack",0,0,8,0)
goto End
TNT1 A 0 A_FireCustomMissile("TristanaBusterShot",0,0,8,0)
goto End
End:
TNT1 A 0 A_TakeInventory("TristanaMuzzleRNG_F")
TNT1 A 0 A_GiveInventory("TristanaMuzzleRNG_F",random(1,7))
TNT1 A 0 A_GiveInventory("IWannaShootSomethingAmmo",18)
TNT1 A 0 A_PlaySound("KirbyNES/QuickDrawF",1)
TNT1 A 0 A_TakeInventory("TristanaFlag")
stop
}
}


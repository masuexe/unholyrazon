actor SmokeBandit_W_ScriptBar : ScriptBar {}

actor SmokeBandit_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 250
  Inventory.Pickupmessage "$PU_28_A"
  Obituary "$OB_28W"
  Tag "$TAG_SmokeBandit_W"
  weapon.ammotype "CigarAmmo"
  weapon.ammotype2 "SmokinAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H28 [ 6
    loop

   Deselect:
    6H28 A 0
    goto DeselectSwap
   Select:
    6H28 A 0
    goto SelectSwap

   Ready:
    6H28 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SMOKEBANDIT_DYE)
    6H28 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    6H28 A 0 A_GunFlash("Flash", 1)
    Goto Ready1

   Ready1:
    6H28 A 0 A_JumpIfInventory("CigarAmmo", 0, "Ready2")
    Goto ReloadWait
   Ready2:
    6H28 A 4 A_WeaponReady(WRF_NOSECONDARY)
    6H28 A 4 A_GiveInventory("SmokeBandit_W_Ready_P")
    wait

   ReloadWait:
    6H28 A 0 A_JumpIfNoAmmo(5)
    6H28 A 4 A_WeaponReady(WRF_NOSECONDARY)
    6H28 AAAAAA 4 A_GiveInventory("SmokeBandit_W_Ready_P")
    goto ReloadStart

   ReloadStart:
    6H28 D 0 A_PlaySound("wep/SmokeB_Load2", 1)//SmokeB_Load0
    6H28 D 2 A_GiveInventory("SmokeBandit_W_Ready_P")
    6H28 E 2 A_WeaponReady(WRF_NOSECONDARY)
    6H28 F 2 A_GiveInventory("SmokeBandit_W_Ready_P")
    6H28 G 2 A_WeaponReady(WRF_NOSECONDARY)
    6H28 H 4 A_GiveInventory("SmokeBandit_W_Ready_P")
    goto Reloading

   Reloading:
    6H28 I 0 A_PlaySound("wep/SmokeB_Load1", 1)
    6H28 I 2 A_GiveInventory("SmokeBandit_W_Ready_P")
    6H28 H 2 A_WeaponReady(WRF_NOSECONDARY)
    6H28 I 0 A_Giveinventory("CigarAmmo", 1)
    //6H28 I 0 A_SpawnItemEx("ReloadFX_H",0,0,0,0,0,0,0,1)
    6H28 I 2 A_GiveInventory("SmokeBandit_W_Ready_P")
    6H28 H 2 A_WeaponReady(WRF_NOSECONDARY)
    6H28 H 0 A_JumpIfInventory("CigarAmmo", 0, "Reloaded")
    loop

   Reloaded:
    6H28 G 0 A_SpawnItemEx("SmokeBanditReloadedSnd_H", 0, 0, 32)
    6H28 G 2 A_GiveInventory("SmokeBandit_W_Ready_P")
    6H28 E 2 A_WeaponReady(WRF_NOSECONDARY)
    Goto Ready2+1
    /*
    NoAmmo:
    6H28 A 1 A_PlaySound("wep/SmokeB_Empty",1)
    NoAmmo_H:
    6H28 A 1 A_RailWait
    6H28 A 0 A_Refire("NoAmmo_H")
    goto ReloadWait
    */
   NoAmmo:
    6H28 A 1 A_GiveInventory("SmokeBandit_Fire0_P")
    6H28 A 0 A_Refire("FireH0")
    Goto FireEnd

   Fire:
    6H28 A 0 A_JumpIfNoAmmo("NoAmmo")
    6H28 A 1 A_GiveInventory("SmokeBandit_Fire_P")
    6H28 A 0 A_Refire("FireH0")
    Goto FireEnd
   FireH0:
    6H28 C 1 A_JumpIfInventory("PlayerPropertyRage", 1, "FireH1")
    6H28 C 0 A_Refire("FireH1")
    goto FireEnd+1
   FireH1:
    6H28 C 1
    6H28 B 0 A_Refire("FireH2")
    goto FireEnd+1
   FireH2:
    6H28 B 1 A_JumpIfInventory("PlayerPropertyRage", 1, "FireH3")
    6H28 B 0 A_Refire("FireH3")
    goto FireEnd+2
   FireH3:
    6H28 B 1
    6H28 A 0 A_Refire("FireH4")
    goto FireEnd+2
   FireH4:
    6H28 A 1 A_GiveInventory("SmokinAmmo", 1)
    6H28 A 0 A_Refire("FireH4")
    goto Ready1
   FireEnd:
    6H28 C 2
    6H28 B 2
    6H28 A 2
    goto Ready1


   Flash:
    TNT1 A 1 A_JumpIfInventory("SmokinAmmo", 125-70*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), 1)
    wait
    TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, 1)
    wait
    6H28 Q 0 A_GunFlash(1)
    6H28 Q 2 A_GiveInventory("SmokeBandit_Alt_P")
    6H28 RST 2
    TNT1 A 4 A_RailWait
    loop



   BotReady:
    6H28 A 0 A_WeaponReady(12)
    6H28 A 2 A_Refire("BotCheck")
    6H28 A 0 A_GiveInventory("SmokinAmmo", 4)
    loop

   BotCheck:
    6H28 A 0 A_JumpIfInventory("SmokinAmmo", 250, "BotAlt")
    6H28 A 0 A_Jump(16, "BotFireX")
    6H28 A 0 A_Jump(24, 1)
    goto BotFire
    6H28 A 0 A_Jump(32, "BotAlt")
    6H28 A 0 A_GiveInventory("SmokinAmmo", 25)
    goto BotFire

   BotFireX:
    6H28 F 0 A_PlaySoundEx("taunt/D_28", "Voice")
    6H28 F 0 A_GiveInventory("SmokeBanditBotSpeed_P")
    6H28 F 0 A_FireCustomMissile("SmokeBanditBombToss", 30, 0, 8, 0)
    6H28 F 0 A_FireCustomMissile("SmokeBanditBombToss", 0, 0, 8, 0)
    6H28 F 0 A_FireCustomMissile("SmokeBanditBombToss", -30, 0, 8, 0)
    6H28 F 0 A_GiveInventory("CigarAmmo", 20)
    goto BotFire+2

   BotFire:
    6H28 C 0 A_JumpIfNoAmmo("BotReload")
    6H28 C 0 A_Jump(8, "BotFireX")
    6H28 C 2 A_GiveInventory("SmokeBandit_Fire_P")
    6H28 B 2 A_GiveInventory("SmokinAmmo", random(2, 6))
    6H28 A random(0, 4)
    6H28 A 0 A_Refire("BotFire")
    goto BotReady

   BotAlt:
    6H28 Q 2 A_GiveInventory("SmokeBandit_Alt_P")
    6H28 RST 2
    TNT1 A 2
    Goto BotReady

   BotReload:
    6H28 F 0 A_PlaySound("wep/SmokeB_Load0", 1)
    6H28 FH 2
    6H28 I 0 A_PlaySound("wep/SmokeB_Load1", 1)
    6H28 I 2 A_Giveinventory("CigarAmmo", 1)
    6H28 H 2 A_GiveInventory("SmokinAmmo", 12)
    6H28 H 0 A_JumpIfInventory("CigarAmmo", 0, 1)
    goto BotReload+3
    6H28 G 2 A_PlaySound("wep/SmokeB_Load2", 1)
    6H28 E 2
    Goto BotReady
  }
}

actor CigarAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 6
  +INVENTORY.IGNORESKILL
}

actor SmokinAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 250
  +INVENTORY.IGNORESKILL
}

actor SmokeBandit_W_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    TNT1 A 0 A_GiveInventory("SmokinAmmo", 4)
    stop
  }
}
actor SmokeBandit_W_Ready4_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_WeaponReady(WRF_NOFIRE)
    TNT1 A 0 A_GiveInventory("SmokinAmmo", 4)
    stop
  }
}

actor SmokeBandit_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("SmokeRodeoShot", cos(-pitch)*14, 8, 32+(sin(-pitch)*14), cos(-pitch), 0, sin(-pitch), 0, 32+SXF_TRANSFERPITCH+SXF_MULTIPLYSPEED)//512+8192
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    goto Take
    TNT1 A 0 A_SpawnItemEx("SmokeRodeoShot", cos(-pitch)*14, 8, 32+(sin(-pitch)*14), cos(-pitch), 0, sin(-pitch), 15, 32+512+8192)
    TNT1 A 0 A_SpawnItemEx("SmokeRodeoShot", cos(-pitch)*14, 8, 32+(sin(-pitch)*14), cos(-pitch), 0, sin(-pitch), -15, 32+512+8192)
    goto Take
   Take:
    TNT1 A 0 A_GiveInventory("SmokinAmmo", 4)
    TNT1 A 0 A_PlaySound("wep/SmokeB_Shot", 1)
    TNT1 A 0 A_TakeInventory("CigarAmmo", 1, 1)
    stop
  }
}
actor SmokeBandit_Fire0_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("SmokeRodeoShot00", 0, 0, 8, 0)
   Take:
    TNT1 A 0 A_GiveInventory("SmokinAmmo", 4)
    TNT1 A 0 A_PlaySound("wep/SmokeB_Empty", 1)
    stop
  }
}

actor SmokeBandit_Alt_P : CustomInventory {
  States {
   Pickup:
    //TNT1 A 0 A_FireCustomMissile("SmokeBanditBombToss",0,0,8,0)
    //TNT1 A 0 A_FireCustomMissile("SmokeBandit_BombTrap",0,0,0,0)
    TNT1 A 0 A_SpawnItemEx("SmokeBandit_BombTrap", cos(-pitch)*20, 0, 32+(sin(-pitch)*20), cos(-pitch)*20, 0, sin(-pitch)*20, 0, 32)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    goto Take
    TNT1 A 0 A_SpawnItemEx("SmokeBandit_BombTrap2", cos(-pitch)*20, 0, 32+(sin(-pitch)*20), cos(-pitch)*20, 0, sin(-pitch)*20, 15, 32)
    TNT1 A 0 A_SpawnItemEx("SmokeBandit_BombTrap2", cos(-pitch)*20, 0, 32+(sin(-pitch)*20), cos(-pitch)*20, 0, sin(-pitch)*20, -15, 32)
    goto Take
   Take:
    //TNT1 A 0 A_PlaySound("weapon/crackerthrow",4)
    TNT1 A 0 A_TakeInventory("SmokinAmmo", 70, 1)
    TNT1 A 0 A_TakeInventory("SmokinAmmo", 55)
    stop
  }
}

actor SmokeBanditReloadedSnd_H : BasicWatcher {
  +NOTIMEFREEZE
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("wep/SmokeB_Load2", 1)
    TNT1 AAA 1 A_Warp(2, 0, 0, 32, 0, 24)
    stop
  }
}

actor SmokeRodeoShot : BasicFastProjectile {
  Translation "192:192=160:160", "198:198=162:162", "195:195=231:231"
  damagetype "SmokeBandit"
  Obituary "$OB_28M1"
  //SeeSound "wep/SmokeB_Shot"
  +SKYEXPLODE
  +FORCEXYBILLBOARD
  Damage (145)
  radius 9
  height 12
  Speed 120
  scale 2.5
  States {
   Spawn:
    6P28 H 0
    6P28 H 35
    wait

   Death:
    //6P28 H 0 A_SpawnItemEx("SmokeRodeoShot2",0,0,0,momx/2,momy/2,momz/2*(z-floorz>0)*((momz<0)*2-1),0,1+8)
    6P28 H 0 A_SpawnItemEx("SmokeRodeoShot2X", 0, 0, 0, cos(-pitch)*10, 0, sin(-pitch)*10, 0, 1)
    goto DeathFX
   XDeath:
   Crash:
    6P28 H 0 A_SpawnItemEx("SmokeRodeoShot3", 0, 0, 0, cos(-pitch)*60, 0, sin(-pitch)*60, 0, 1)
    goto DeathFX
   DeathFX:
    TNT1 A 0 A_SpawnItemEx("SmokeRodeoShellFX", 0, 0, 0, 0, 0, 0, 0, 1+32)
    TNT1 A 0 //A_SpawnItemEx("FloatingSmoke",-1,0,0,0,0,1,0,1)
    stop
  }
}

actor SmokeRodeoShellFX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 //A_PlaySound
    TNT1 A 0 A_SpawnItemEx("SmokeRodeoShellFX1", 2, 0, 0, 5, 0, 3, 35, 1)
    TNT1 A 1 A_SpawnItemEx("SmokeRodeoShellFX2", 2, 0, 0, 5, 0, 3, 325, 1)
    stop
  }
}

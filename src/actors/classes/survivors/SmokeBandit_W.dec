    stop
  }
}

actor SmokeRodeoShellFX2 : SmokeRodeoShellFX1 {
  States {
   Spawn:
    6P28 J 1
    6P28 J 1 //A_CheckFloor("Death")
    //wait
    6P28 J 175
    loop
   Death:
    TNT1 A 0
    TNT1 A 1 A_SetGravity(0.0)
    6P28 J 1
    TNT1 A 1
    6P28 J 1
    TNT1 A 1
    6P28 J 1
    stop
  }
}

actor SmokeRodeoShot2X : BasicProjectile {
  Translation "192:192=160:160", "198:198=162:162"
  damagetype "SmokeBandit"
  Obituary "$OB_28M2"
  +FORCEXYBILLBOARD
  +NOEXPLODEFLOOR
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 1.0
  WallBounceFactor 1.0
  Damage (145)
  radius 9
  height 12
  Speed 45
  scale 2.5
  States {
   Spawn:
    6P28 A 0
    6P28 A 0 A_SpawnItemEx("SmokeRodeoShot2", 0, 0, 0, momx*6, momy*6, momz*6, 0, 1+8)
    stop
   Death:
    6P28 A 0 A_SpawnItemEx("SmokeRodeoSmokeFX", 0, 0, 0, 0, 0, 0, 0, 1)

}
actor SmokeBanditBombTossFX : BasicBoom4FX_ColorX {
  Scale 3.0
}


actor SmokeBanditBombExp : BasicExplosion {
  damagetype "SmokeBandit"
  Obituary "$OB_28A2"
  +FORCEXYBILLBOARD
  RenderStyle Translucent
  Alpha 0.20
  ReactionTime 20
  Speed 20
  Scale 2.0
  Args 20, 80
  States {
   Spawn:
    6P28 K 0
    6P28 K 0 A_SetArg(4, Args[4]+1)
    6P28 K 0 A_FadeIn(0.1)
    6P28 KKLLMMNN 2 A_Explode(Args[0]*Args[4]/4, Args[1]*Args[4]/4, 0, 0, Args[1]*Args[4]/4)
    6P28 K 0 A_SetScale(ScaleX+0.5)
    6P28 K 0 A_JumpIf(Args[4]>3, "Spawn2")
    loop
   Spawn2:
    6P28 K 0 A_SetDamageType("SmokeBanditSlow")
   SpawnL:
    6P28 KKLLMMNN 2 A_Explode(Args[0], Args[1], 0, 0, Args[1])
    6P28 K 0 A_CountDown
    loop
   Death:
    6P28 KLMN 2 A_FadeTo(0.1, 0.075, 1)
    loop
  }
}

actor SmokeBanditSlowProtect : PowerProtection {
  Powerup.Duration 3
  damagefactor "SmokeBanditSlow", 0.0
}


actor SmokeBanditSpeedBoost : PowerSpeed {
  +INVENTORY.ADDITIVETIME
  Powerup.Duration -4
  Speed 1.4
}

actor SmokeBanditBotSpeed_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("SmokeBanditBoostFX", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySound("wep_L/RSmoke3", 4)
    TNT1 A 0 A_GiveInventory("SmokeBanditSpeedBoost")
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 2)
    stop
    TNT1 AA 0 A_GiveInventory("SmokeBanditSpeedBoost")
    stop
  }
}

actor SmokeBanditBoostFX : HSH_DustBoostFX {
  Scale 3.5
}

}
actor SmokeRodeoShot2 : SmokeRodeoShot2X {
  -BOUNCEONCEILINGS
  BounceFactor 0.0
  WallBounceFactor 0.0
  States {
   Spawn:
    6P28 A 0
    //6P28 A 0 ThrustThing(angle*256/360,0,1,0)//Resync
    6P28 ABABABABABABABABAB 2
   SpawnEnd:
    6P28 A 0 A_SpawnItemEx("SmokeRodeoSmokeFX", 0, 0, 0, momx*0.8, momy*0.8, momz+1, 0, 1+8)
    stop
  }
}
actor SmokeRodeoShot3 : SmokeRodeoShot2 {
  +THRUACTORS
  States {
   Spawn:
    6P28 A 0
    6P28 A 0 A_ChangeFlag("THRUACTORS", 0)
    goto SmokeRodeoShot2::Spawn
  }
}

actor SmokeRodeoShot00 : SmokeRodeoShot2 {
  Damage (52)
  States {
   Spawn:
    6P28 B 0
    6P28 ABABABABA 2
    goto SpawnEnd
  }
}


actor SmokeRodeoSmokeFX : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    6P28 BA 1 ThrustThingZ(0, 2, 0, 1)
    6P28 A 0 A_FadeOut(frandom(0.08, 0.18))
    6P28 AB 1 ThrustThingZ(0, 2, 0, 1)
    6P28 B 0 A_FadeOut(frandom(0.08, 0.18))
    loop
  }
}



actor SmokeBandit_BombTrap : BasicProjectile {
  Translation "192:192=160:160", "198:198=162:162", "195:195=231:231"
  damagetype "SmokeBanditStop"
  Obituary "$OB_28A1"
  BounceSound "wep_L/GhostTrapLand"
  -NOGRAVITY
  //+DONTREFLECT
  +DONTSPLASH
  +THRUACTORS
  +FORCEXYBILLBOARD
  +NOTARGETSWITCH
  +SKYEXPLODE
  //+BOUNCEONCEILINGS
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +USEBOUNCESTATE
  +STEPMISSILE
  maxstepheight 8
  BounceFactor 0.00
  WallBounceFactor 0.5
  BounceCount 30//10
  Reactiontime 11
  damage (25)
  radius 26
  height 26
  speed 20
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerfire", "Weapon")
    TNT1 A 0 ThrustThing(angle*256/360, 2, 1, 0)
    TNT1 A 0 ThrustThingZ(0, 25, 0, 1)
    TNT1 A 1 A_GiveInventory("ReSyncPickup")
    //6P28 EFGFEFGFEFGF 3
    6P28 E 10
    goto SpawnWait+2
   SpawnWait:
    6P28 E 0 A_JumpIf(ReactionTime<=2, "SpawnWait2")
    6P28 EFGF 10 A_SpawnItemEx("SmokeB_TrapPuffFX", random(-3, 3), random(-3, 3), 12, 0, 0, 1, 0, 128, 0)
    6P28 E 0 A_CountDown
    loop
   SpawnWait2:
    6P28 EFGFEFGF 5 A_SpawnItemEx("SmokeB_TrapPuffFX", random(-3, 3), random(-3, 3), 12, 0, 0, 1, 0, 128, 0)
    6P28 E 0 A_CountDown
    loop

   Bounce.Floor:
    6P28 E 0 A_ChangeFlag("USEBOUNCESTATE", 0)
    6P28 E 0 A_ChangeFlag("BOUNCEONWALLS", 0)
    6P28 E 0 A_ChangeFlag("THRUACTORS", 0)
    goto SpawnWait

   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(100, 128, 0, 0, 80)
    TNT1 A 0 A_SpawnItemEx("SmokeBanditBombTrapExp", 0, 0, 28, 0, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("SmokeB_TrapExpFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 4 A_SpawnItemEx("SmokeBanditBombTossFX", 0, 0, 24, 0, 0, 0, 0, 1)
    stop
  }
}
actor SmokeBandit_BombTrap2 : SmokeBandit_BombTrap {
  States {
   Spawn:
    TNT1 A 0
    goto SmokeBandit_BombTrap::Spawn+2
  }
}

actor SmokeB_TrapPuffFX : BasicClientSide {
  Translation "192:192=95:95", "198:198=3:3"
  +FORCEXYBILLBOARD
  VSpeed 1
  RenderStyle Add
  Alpha 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(170, 2)
    PUFF A 5
    goto Spawn2
    TNT1 A 0 A_Jump(85, 2)
    PUFF B 5
    goto Spawn2
    PUFF C 5
   Spawn2:
    PUFF "#" 5 A_SetTranslucent(.4, 1)
    PUFF "#" 5 A_SetTranslucent(.8, 1)
    PUFF "#" 1 A_Fadeout(.10)
    Wait
  }
}

actor SmokeB_TrapExpFX : BasicClientSide {
  RenderStyle Translucent
  Alpha 0.60
  ReactionTime 8
  Scale 4.0
  Args 9
  States {
   Spawn:
    6P28 K 0
    6P28 KKKKK 0 A_SpawnItemEx("SmokeB_TrapExpFX2", 0, random(-2, 2), 8-14, frandom(2, 5.5), 0, random(2, 4), random(1, 13)*3+Args[0]*40, 128)
    6P28 K 0 A_SetArg(0, Args[0]-1)
    6P28 K 0 A_JumpIf(Args[0]<1, "SpawnL")
    loop
   SpawnL:
    6P28 KLMN 2
    6P28 K 0 A_CountDown
    loop
   Death:
    6P28 KLMN 2 A_FadeTo(0.1, 0.075, 1)
    loop
  }
}

actor SmokeB_TrapExpFX2 : BasicClientSide {
  Translation "192:192=89:89", "198:198=95:95"
  +FORCEXYBILLBOARD
  +MISSILE
  +DONTBLAST
  VSpeed 1
  RenderStyle Translucent
  Alpha 0
  Speed 20
  States {
   Spawn:
    TNT1 A 0
    XMFX N 12 A_SetTranslucent(.15, 0)
    TMFX B 12 A_SetTranslucent(.35, 0)
    TMFX C 12 A_SetTranslucent(.5, 0)
    TMFX D 0 A_Jump(192, 2)
    TMFX D 1 A_Fadeout(.04)
    Wait
    TMFX D 0 A_Jump(128, 2)
    TMFX D 1 A_Fadeout(.05)
    Wait
    TMFX D 0 A_Jump(64, 2)
    TMFX D 1 A_Fadeout(.06)
    Wait
    TMFX D 1 A_Fadeout(.07)
    Wait
  }
}

actor SmokeBanditBombTrapExp : BasicExplosion {
  damagetype "SmokeBanditSlow"
  Obituary "$OB_28A2"
  Args 20, 80
  States {
   Spawn:
    TNT1 A 0 A_CountDown
    TNT1 AAAA 2 A_Explode(Args[0], Args[1], 0, 0, Args[1])
    loop
  }
}





actor FrostBite_W_ScriptBar : ScriptBar {}

actor FrostBite_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 150
Inventory.Pickupmessage "$PU_09"
Obituary "$OB_09W"
Tag "$TAG_FrostBite_W"
weapon.ammotype "ColdEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H09 [ 6
loop

Deselect:
6H09 A 0
goto DeselectSwap
Select:
6H09 A 0
goto SelectSwap

Ready:
6H09 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FROSTBITE_DYE)
//6H09 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H09 A 2 A_GiveInventory("FrostBite_Ready_P",2)
loop

Fire:
6H09 C 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H09 B 0 A_GiveInventory("FrostBite_Fire_P")
6H09 CB 4
6H09 A 2
6H09 A 10 A_GiveInventory("ColdEnergyAmmo",5)
Goto Ready2

AltFire:
6H09 BC 2 A_GiveInventory("FrostBite_Alt_P")
Hail:
6H09 BC 2 A_GiveInventory("FrostBite_Alt_P")
6H09 B 0 A_ReFire(1)
Goto NoAmmoX
6H09 B 0 A_JumpIfInventory("ColdEnergyAmmo",2,1)
Goto NoAmmoX
6H09 BC 2 A_GiveInventory("FrostBite_Alt_P")
6H09 B 0 A_ReFire(1)
Goto NoAmmoX
6H09 B 0 A_JumpIfInventory("ColdEnergyAmmo",2,"Hail")
Goto NoAmmoX
NoAmmoX:
6H09 A 4
Goto Ready2

BotFire:
6H09 A 0 A_JumpIfInventory("ColdEnergyAmmo",300,"BotFire3")
6H09 A 0 A_GiveInventory("ColdEnergyAmmo",20)
6H09 A 0 A_Jump(16,"BotFire2")
6H09 A 0 A_Jump(128,"Hail")
6H09 A 0 A_Jump(24,"BotFire1")
goto Fire+1
BotFire1:
6H09 A 0 A_JumpIfInventory("FrostBiteFlag",28,2)
6H09 A 2 A_GiveInventory("FrostBiteFlag",2)
loop
6H09 A 0
goto Fire+1
BotFire2:
6H09 A 0 A_PlaySoundEx("taunt/D_09","Voice")
6H09 A 0 ThrustThingZ(0,42,0,0)
6H09 A 0 A_PlaySound("weapon/mbuster",1)
6H09 B 3 A_FireCustomMissile("FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
6H09 A 0 A_PlaySound("weapon/mbuster",1)
6H09 C 3 A_FireCustomMissile("FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
6H09 A 0 A_PlaySound("weapon/mbuster",1)
6H09 B 3 A_FireCustomMissile("FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
6H09 A 0 A_PlaySound("weapon/mbuster",1)
6H09 C 3 A_FireCustomMissile("FrostBiteShot",frandom(-10,10),0,8,0,0,frandom(-5,5))
6H09 BAAA 2 A_GiveInventory("ColdEnergyAmmo",20)
Goto Ready2
BotFire3:
6H09 B 0 A_TakeInventory("ColdEnergyAmmo",300)
6H09 B 2
6H09 B 0 ThrustThingZ(0,40,0,0)
6H09 B 10
6H09 B 0 ThrustThingZ(0,-60,0,0)
6H09 A 0 A_PlaySoundEx("taunt/D_09","Voice")
6H09 BBBBBB 0 A_FireCustomMissile("FrostBiteRainSpawner",0,0,0,0)
6H09 B 2
6H09 B 10
Goto Ready2
}
}

actor ColdEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor FrostBiteFlag : Inventory
{
inventory.maxamount 28
}

actor FrostBite_Ready_P : CustomInventory
{
States
{
Pickup:
Ready2:
TNT1 A 0 A_JumpIfInventory("ColdEnergyAmmo",24,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo
Ammo:
TNT1 A 0 A_GiveInventory("ColdEnergyAmmo",2)
TNT1 A 0 A_JumpIfInventory("FrostBiteFlag",29,3)
TNT1 A 0 A_GiveInventory("FrostBiteFlag",1)
TNT1 A 0 A_JumpIfInventory("FrostBiteFlag",28,"Charged")
TNT1 A 0
stop
Charged:
TNT1 A 0 A_PlaySound("wep/FrostB_Charged",4,0.775)
TNT1 A 0 A_TakeInventory("FrostBiteFlag",-10)
stop
}
}

actor FrostBite_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("FrostBiteFlag",28,"Fire2")//weapon/mbuster
TNT1 A 0 A_PlaySound("wep_L/FrostB_Boom",1,0.75)//weapon/icewavebreak
TNT1 A 0 A_FireCustomMissile("FrostBiteShot",0,0,8,0)//
goto End
Fire2:
TNT1 A 0 A_PlaySound("wep_L/FrostB_Fire2",1)
TNT1 A 0 A_FireCustomMissile("FrostBiteShot2",0,0,8,0)
goto End
End:
TNT1 A 0 A_GiveInventory("ColdEnergyAmmo",5)
TNT1 A 0 A_TakeInventory("FrostBiteFlag")
stop
}
}

actor FrostBite_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_Jump(256,1,2)
TNT1 A 0 A_FireCustomMissile("FrostBiteMist",frandom(-4,4),0,8,0,1,frandom(-3,3))
goto Snd
TNT1 A 0 A_FireCustomMissile("FrostBiteMist2",frandom(-4,4),0,8,0,1,frandom(-3,3))
goto Snd
Snd:
TNT1 A 0 A_PlaySound("weapon/freezecracker",1)
TNT1 A 0 A_TakeInventory("ColdEnergyAmmo",4,1)
TNT1 A 0 A_TakeInventory("ColdEnergyAmmo",2)
stop
}
}


actor FrostBiteShot : BasicProjectile
{
Translation "192:192=196:196","198:198=197:197","202:202=4:4","199:199=196:196"
Obituary "$OB_09M1"
damagetype "ColdShot"
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
Damage (202)//130
radius 14
height 14
Speed 50
scale 3.0
States
{
Spawn:
X_7A DD 2 A_SpawnItemEx("FrostBiteShotFX1",0,0,0,0,0,0,0,1)
Y_7A DD 2 A_SpawnItemEx("FrostBiteShotFX2",0,0,0,0,0,0,0,1)
Loop
XDeath:
TNT1 A 0 A_SpawnItemEx("FrostBiteShotHitFX",0,0,0,0,0,0,0,1)
goto DeathEnd
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 A 0 A_SpawnItemEx("FrostBiteShotBit",0,0,0,20*((ceilingz-z>height)&&(floorz-z!=0)),0,Args[4]*-5,0,1,0)
TNT1 AAAAAAA 0 A_SpawnItemEx("FrostBiteShotBit",0,0,0,random(1,15),0,random(1,15)*Args[4],random(0,359),1)
goto DeathEnd
DeathEnd:
TNT1 A 0 A_PlaySoundEx("weapon/icewavebreak","Weapon")//wep_L/mm10/chillspikeland
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TNT1 A 1
//TMFX ABCD 2//Height/2*Args[4]
stop
}
}


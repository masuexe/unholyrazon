actor FrostBiteSpike : BasicProjectile
{
PROJECTILE
Obituary "$OB_09M3"
damagetype "ColdShot"
+DONTBLAST
+FLOORHUGGER
reactiontime 3
Damage (75)
Radius 14
Height 20
Speed 0
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 //A_PlaySoundEx("wep_L/mm10/chillspikeland","Weapon")
X_AD D 2
X_AD E 70 A_CountDown
wait
XDeath:
TNT1 A 1 A_PlaySoundEx("wep_L/mm10/chillspikebreak","Weapon")
stop
Death:
TNT1 A 1
TNT1 AA 0 A_SpawnItemEx("FrostBiteSpikeFX",random2(10),random2(10),random(2,48),random(2,10),random(2,10),random(2,10),random(0,359),1)
TNT1 A 0
stop
}
}


actor FrostBiteShotBit : BasicProjectile
{
damagetype "ColdShot"
Obituary "$OB_09M2"
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
+BLOODLESSIMPACT
+FORCEXYBILLBOARD

actor ColdMistVision1 : Powerup
{
Powerup.Duration 0x7FFFFFFC
powerup.color "A4 E8 FC",0.1
}
actor ColdMistVision2 : ColdMistVision1{}
actor ColdMistVision3 : ColdMistVision1{}
actor ColdMistVision4 : ColdMistVision1{}
actor ColdMistVision5 : ColdMistVision1{}

actor ColdMist_H : BasicHelper
{
+NOTIMEFREEZE
States
{
Spawn:

TNT1 A 0 A_PlaySoundEx("weapon/chillspike","Weapon")
SpawnL:
//X_AD J 0 A_Warp(AAPTR_TARGET,0,0,0,0,WARPF_INTERPOLATE)
TNT1 A 1 A_GiveToTarget("ColdMistSlow_P",1)
TNT1 A 0 A_JumpIfInTargetInventory("FrostBiteColdMist_F",1,"SpawnL")
TNT1 A 1 A_JumpIf(true,"Death")
wait
Death:
TNT1 A 0 A_GiveToTarget("ColdMistEnd_P",1)
stop
}
}

actor ColdMistSlow_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("FrostBiteColdMist_F",100,"Slow5")
TNT1 A 0 A_JumpIfInventory("FrostBiteColdMist_F",80,"Slow4")
TNT1 A 0 A_JumpIfInventory("FrostBiteColdMist_F",60,"Slow3")
TNT1 A 0 A_JumpIfInventory("FrostBiteColdMist_F",40,"Slow2")
TNT1 A 0 A_JumpIfInventory("FrostBiteColdMist_F",20,"Slow1")
goto End
Slow1:
TNT1 A 0 A_GiveInventory("ColdMistVision1",1)
TNT1 A 0 A_ChangeVelocity(momx*0.96,momy*0.96,momz,CVF_REPLACE)
goto End+1
Slow2:
TNT1 A 0 A_GiveInventory("ColdMistVision2",1)
TNT1 A 0 A_ChangeVelocity(momx*0.92,momy*0.92,momz,2)
goto End+2
Slow3:
TNT1 A 0 A_GiveInventory("ColdMistVision3",1)
TNT1 A 0 A_ChangeVelocity(momx*0.88,momy*0.88,momz,2)
goto End+3
Slow4:
TNT1 A 0 A_GiveInventory("ColdMistVision4",1)
TNT1 A 0 A_ChangeVelocity(momx*0.84,momy*0.84,momz,2)
goto End+4
Slow5:
TNT1 A 0 A_GiveInventory("ColdMistVision5",1)
TNT1 A 0 A_ChangeVelocity(momx*0.80,momy*0.80,momz,2)
goto End+5
End:
TNT1 A 0 A_TakeInventory("ColdMistVision1",1)
TNT1 A 0 A_TakeInventory("ColdMistVision2",1)
TNT1 A 0 A_TakeInventory("ColdMistVision3",1)
TNT1 A 0 A_TakeInventory("ColdMistVision4",1)
TNT1 A 0 A_TakeInventory("ColdMistVision5",1)
TNT1 A 0 A_TakeInventory("FrostBiteColdMist_F",1)
stop
}
}

actor ColdMistEnd_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/chillbreak","Weapon")
TNT1 A 0 A_TakeInventory("ColdMistVision1",1)
TNT1 A 0 A_TakeInventory("ColdMistVision2",1)
TNT1 A 0 A_TakeInventory("ColdMistVision3",1)
TNT1 A 0 A_TakeInventory("ColdMistVision4",1)
TNT1 A 0 A_TakeInventory("ColdMistVision5",1)
TNT1 A 0 A_TakeInventory("FrostBiteColdMist_F")
stop
}
}


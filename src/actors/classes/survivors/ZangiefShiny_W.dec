actor ZangiefShiny_W_ScriptBar : ScriptBar {}

actor ZangiefShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Zangief_W"
Weapon.AmmoUse 0
Inventory.Pickupmessage "$PU_51"
Obituary "$OB_51W1"
weapon.ammotype "AtomicSuplexAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H51 [ 6
loop

Deselect:
7H51 A 0
goto DeselectSwap
Select:
7H51 A 0
goto SelectSwap

Ready:
7H51 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", ZANGIEF_SDYE)
7H51 A 0 A_GiveInventory("ZangiefResetFlags_P")
goto Ready2
Ready2:
7H51 A 0 A_JumpIfInventory("AtomicSuplexAmmo",0,"Ready3")
7H51 A 2 A_WeaponReady(WRF_NOPRIMARY)
7H51 A 0 A_GiveInventory("AtomicSuplexAmmo",2)
loop
Ready3:
7H51 A 2 A_WeaponReady
7H51 A 0 A_GiveInventory("AtomicSuplexAmmo",2)
loop

BotFire:
7H51 A 0 A_JumpIfInventory("ZangiefHoldFlag",1,2)
7H51 A 0 A_Jump(96,"AltFireSpin")
goto Fire+1
7H51 A 0 A_Jump(2,"BotSwap")
7H51 A 0 A_Jump(96,"SuplexGroundHold")
7H51 A 0 A_Jump(96,"AltFireSpin","AirFire")
7H51 A 0 A_Jump(2,"BotSwap")
goto Fire+1

BotFireA:
7H51 A 0 A_Jump(12,"AirEnd")
7H51 A 0 A_Refire("SuplexFly")
goto AirEnd
BotFireG:
7H51 A 0 A_Jump(64,2)
7H51 A 0 A_Refire("SuplexRun")
goto SuplexGrab
7H51 A 0 A_FaceTarget
7H51 A 0 A_JumpIfCloser(128,2)
7H51 A 0 A_Refire("SuplexRun")
goto SuplexGrab
7H51 A 0 A_Jump(32,"BotSwap")
goto SuplexGrab

BotSwap:
7H51 A 0 A_PlaySoundEx("taunt/D_51","Voice")
7H51 A 0 A_GiveInventory("ZangiefResetFlags_P")
7H51 A 0 A_GiveInventory("AtomicBusterCharge",28)
goto AtomicBuster

Fire:
7H51 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H51 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_JUMP, "AirFire")
goto GroundFire

AirFire:
7H51 R 0 A_GiveInventory("Zangief_FireStartA_P")
7H51 R 0 A_ReFire(1)
7H51 RRS 1 A_GiveInventory("SuplexFly_P0")
7H51 S 1 A_GiveInventory("SuplexFly_P1")
SuplexFly:
7H51 T 1 A_GiveInventory("S_SuplexFly_P2")
7H51 T 0 A_JumpIfInventory("SuplexID",1,"Suplex")
7H51 T 0 A_JumpIfInventory("AtomicSuplexAmmo",1,1)
goto AirEnd
7H51 T 0 A_JumpIfInventory("IsBot",1,"BotFireA")
7H51 T 0 A_Refire("SuplexFly")
goto AirEnd
AirEnd:
7H51 TT 1 A_JumpIfInventory("SuplexID",1,"Suplex")
7H51 T 2 A_GiveInventory("Zangief_FireEndA_P")
7H51 SRB 2
7H51 BB 4 A_GiveInventory("AtomicSuplexAmmo",4)
goto Ready2

GroundFire:
7H51 B 0 A_JumpIfInventory("ZangiefHoldFlag",1,"SuplexThrow")
7H51 B 0 A_GiveInventory("Zangief_FireStartG_P")
7H51 B 0 A_Refire(1)
7H51 BCDE 2
SuplexRun:
7H51 F 1 A_GiveInventory("SuplexRun_P0")
7H51 F 0 A_JumpIfInventory("AtomicSuplexAmmo",1,1)
goto SuplexGrab
7H51 F 0 A_JumpIfInventory("IsBot",1,"BotFireG")
7H51 F 0 A_Refire(1)
goto SuplexGrab
7H51 F 1 A_GiveInventory("SuplexRun_P1")
7H51 F 0 A_JumpIfInventory("AtomicSuplexAmmo",1,1)
goto SuplexGrab
7H51 F 0 A_Refire("SuplexRun")
goto SuplexGrab

SuplexGrab:
7H51 F 1 A_GiveInventory("S_Zangief_FireGrab_P")
7H51 F 0 A_JumpIfInventory("SuplexID",1,"SuplexGround")
7H51 F 1 A_GiveInventory("S_Zangief_FireGrab_P2")
7H51 EEEE 1 A_JumpIfInventory("SuplexID",1,"SuplexGround")

7H51 D 2 A_GiveInventory("Zangief_FireEndG_P")
7H51 CB 2
7H51 BBBBB 4 A_GiveInventory("AtomicSuplexAmmo",2)
goto Ready2

SuplexGround:
7H51 E 1 A_GiveInventory("Zangief_SuplexStartG_P")
7H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H",0,0,0,0,0,0,0,1)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",350,angle*256/360,100)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",340,angle*256/360,100)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",330,angle*256/360,100)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",320,angle*256/360,100)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",310,angle*256/360,100)==0,"AtomicKaboom")

goto SuplexGroundHold+1
SuplexGroundHold:
7H51 E 0 A_Jumpif(CallACS("uh_ZangiefGrab",300,angle*256/360,100)==0,"AtomicKaboom")
7H51 E 1 A_GiveInventory("SuplexHold_P")
7H51 E 0 A_JumpIfInventory("ZangiefHoldFlag",60,"SuplexGroundRelease")
loop
SuplexGroundRelease:
7H51 E 0 A_GiveInventory("VivifyDelay3",1)
7H51 E 0 A_GunFlash("NoFlash")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",310,angle*256/360,92)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",320,angle*256/360,84)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",330,angle*256/360,76)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",340,angle*256/360,68)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",350,angle*256/360,60)==0,"AtomicKaboom")
goto AtomicRelease
SuplexThrow:
7H51 E 0 A_GunFlash("NoFlash")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",315,angle*256/360,90)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",330,angle*256/360,80)==0,"AtomicKaboom")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",345,angle*256/360,70)==0,"AtomicKaboom")
7H51 E 0 A_JumpIf(momz<0,"SuplexThrowDown")
SuplexThrowUp:
7H51 E 0
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",359,angle*256/360,65)==0,"AtomicKaboom")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicThrow")
7H51 E 0 A_JumpIf(momz>0,"SuplexThrowUp")//GoingUp
SuplexThrowDown:
7H51 E 0
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",359,angle*256/360,65)==0,"AtomicKaboom")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicThrow")
7H51 E 0 A_JumpIf(momz<0,"SuplexThrowDown")
goto AtomicThrow

Suplex:
7H51 E 0 A_GiveInventory("Zangief_SuplexStartA_P")
7H51 E 1 A_GunFlash("NoFlash")

7H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H",0,0,0,0,0,0,0,1)
//360
7H51 E 0 A_SetPitch(356)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",348,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(352)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",336,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(348)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",325,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(344)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",314,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(340)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",303,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(336)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",292,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(333)
7H51 E 0 A_SetAngle(angle+12)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",281,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(330)
7H51 E 0 A_SetAngle(angle+19)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",270,CallACS("rz_CountInv_ZangiefAngle"),100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(337)
7H51 E 0 A_SetAngle(angle+26)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",293,CallACS("rz_CountInv_ZangiefAngle")+128,100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(344)
7H51 E 0 A_SetAngle(angle+26)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",316,CallACS("rz_CountInv_ZangiefAngle")+128,100)==0,"AtomicKaboom")
7H51 E 0 A_SetPitch(352)
7H51 E 0 A_SetAngle(angle+25)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab",338,CallACS("rz_CountInv_ZangiefAngle")+128,100)==0,"AtomicKaboom")

7H51 E 0 A_SetPitch(0)

7H51 E 0 A_JumpIf(momz<0,"GoingDown")
GoingUp:
7H51 E 0
7H51 E 1 A_JumpIf(CallACS("uh_ZangiefStartGrab",CallACS("rz_CountInv_ZangiefAngle")-1+1000)==0,"AtomicKaboom")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom")
7H51 E 0 A_JumpIf(momz>0,"GoingUp")
GoingDown:
7H51 E 0 ThrustThingZ(0,2,1,1)
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab",CallACS("rz_CountInv_ZangiefAngle")-1+1000)==0,"AtomicKaboom")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom")
7H51 E 0 A_JumpIf(momz<0,"GoingDown")

AtomicKaboom:
7H51 E 0 A_GiveInventory("S_Zangief_FireSlam_P2")
7H51 E 2 A_GiveInventory("VivifyDelay4",1)
7H51 DC 2
7H51 B 0 A_GiveInventory("ZangiefResetFlags_P")
7H51 B 6 A_GiveInventory("AtomicSuplexAmmo",3)
goto Ready2
AtomicRelease:
7H51 E 0 A_TakeInventory("ZangiefHoldFlag")
goto AtomicKaboom+1
AtomicThrow:
7H51 E 0 A_GiveInventory("S_Zangief_FireSlam_P3")
goto AtomicKaboom+1

AltFireSpin:
7H51 A 0 A_GiveInventory("SuplexAlt_P")
7H51 A 0 A_Refire(1)
7H51 AUVWX 3 A_SpawnItemEx("S_DoubleLariat",0,0,32,momx,momy,momz,0,9)
TNT1 A 3 A_SpawnItemEx("S_DoubleLariat",0,0,32,momx,momy,momz,0,9)
TNT1 A 0 A_SpawnItemEx("S_DoubleLariat",0,0,32,momx,momy,momz,0,9)
TNT1 A 2 A_GiveInventory("ZangiefResetFlags_P")
TNT1 AAA 6 A_GiveInventory("AtomicSuplexAmmo",3)
7H51 Y 2 A_GiveInventory("AtomicSuplexAmmo",3)
7H51 ZA 2
goto Ready2

AltFire:
7H51 P 0 A_JumpIfInventory("ZangiefHoldFlag",1,"AltFireSpin")
AltFire2:
7H51 P 0 A_JumpIfInventory("AtomicBusterCharge",0,"AtomicBuster")
7H51 P 1 A_GiveInventory("AtomicBusterCharge",1)
7H51 P 0 A_ReFire("AltFire2")
7H51 P 0 A_TakeInventory("AtomicBusterCharge")
goto AltFireSpin
AtomicBuster:
7H51 F 0 A_GiveInventory("Zangief_AtomicFireStart_P")
7H51 F 0 A_Refire(1)

7H51 F 1 A_GiveInventory("S_Zangief_AtomicFire_P")
7H51 F 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 F 1 A_GiveInventory("S_Zangief_AtomicFire_P")
7H51 E 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 E 1 A_GiveInventory("S_Zangief_AtomicFire_P")
7H51 E 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 E 1 A_Stop
7H51 D 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 D 1 A_Stop
7H51 D 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 D 1 A_Stop
7H51 C 0 A_JumpIfInventory("SuplexID",1,"Suplex2")
7H51 CCBB 1 A_Stop

7H51 B 6 A_GiveInventory("Zangief_AtomicFireEnd_P")
goto Ready2

Suplex2:
7H51 E 0 A_GiveInventory("Zangief_AtomicGrabStart_P")

7H51 E 0 A_GunFlash("NoFlash")

7H51 E 1 A_GiveInventory("Zangief_AtomicGrabStop_P")
7H51 E 0 A_SpawnItemEx("ZangiefGrabFX_H",0,0,0,0,0,0,0,1)
7H51 EEEEE 1 A_GiveInventory("Zangief_AtomicGrabStop_P")

7H51 E 0 A_GiveInventory("Zangief_AtomicGrabLiftOff_P")

GoingUp2:
7H51 E 0 A_GiveInventory("Zangief_AtomicGrab_UP_P")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab",CallACS("rz_CountInv_SuplexID")-1+1000)==0,"AtomicKaboom2")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom2")
7H51 E 0 A_JumpIf(momz>0,"GoingUp2")
GoingDown2:
7H51 E 0 A_GiveInventory("Zangief_AtomicGrab_DOWN_P")
7H51 E 1 A_Jumpif(CallACS("uh_ZangiefStartGrab",CallACS("rz_CountInv_SuplexID")-1+1000)==0,"AtomicKaboom2")
7H51 E 0 A_JumpIf(CallACS("core_CheckFooting"), "AtomicKaboom2")
7H51 E 0 A_JumpIf(momz<0,"GoingDown2")

AtomicKaboom2:
7H51 E 2 A_GiveInventory("S_Zangief_FireSlam_P1")
7H51 DC 2
7H51 B 0 A_GiveInventory("ZangiefResetFlags_P")
7H51 B 6 A_GiveInventory("AtomicSuplexAmmo",3)
goto Ready2
}
}

actor S_SuplexFly_P2 : SuplexFly_P1
{
states
{
Pickup:
TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo",1,1)
TNT1 A 0 A_TakeInventory("AtomicSuplexAmmo",1)
TNT1 A 0 A_SpawnItemEx("S_AerialGrab",0,0,48,momx,momy,momz,0,8+32)
goto Pickup1
}
}

actor S_Zangief_AtomicFire_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_FireCustomMissile("S_AtomicBusterGrab",0,0,0,0)
TNT1 A 0 A_Stop
stop
}
}


actor S_Zangief_FireGrab_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_PlaySound("G_Axe/S_30",1)
TNT1 A 0 A_GiveInventory("VivifyDelay3",1)
Pickup0:
TNT1 A 0 A_JumpIf(pitch<325 && pitch>=270, "UpLimit")
TNT1 A 0 A_JumpIf(pitch<=90 && pitch>35, "DownLimit")
TNT1 A 0 A_FireCustomMissile("S_AtomicSuplexGrab",0,0,0,0,1,0)
stop
UpLimit:
TNT1 A 0 A_FireCustomMissile("S_AtomicSuplexGrab",0,0,0,0,1,pitch+35)
stop
DownLimit:
TNT1 A 0 A_FireCustomMissile("S_AtomicSuplexGrab",0,0,0,0,1,pitch-35)
stop
}
}
actor S_Zangief_FireGrab_P2 : S_Zangief_FireGrab_P
{
states
{
Pickup:
goto Pickup0
}
}

actor S_Zangief_FireSlam_P1 : Zangief_FireSlam_P1
{
States
{
Boom:
TNT1 A 0 A_SpawnItemEX("S_AtomicBuster",0,0,0,0,0,0,0,41)
stop
}
}
actor S_Zangief_FireSlam_P2 : S_Zangief_FireSlam_P1
{
States
{
Pickup:
goto Pickup0
Boom:
TNT1 A 0 A_SpawnItemEX("S_AtomicSuplex",0,0,0,0,0,0,0,41)
stop
}
}
actor S_Zangief_FireSlam_P3 : S_Zangief_FireSlam_P1
{
States
{
Pickup:
goto Pickup0
Boom:
TNT1 AA 0 A_SpawnItemEX("S_AtomicSuplexT",0,0,0,0,0,0,0,41)
stop
}
}

actor S_AtomicBusterGrab : AtomicBusterGrab
{
Translation "192:192=80:80","198:198=92:92"
damage (15)//10
Args 15,64,64//10
}

actor S_AtomicSuplexGrab : S_AtomicBusterGrab
{
speed 85
}

actor S_AerialGrab : AerialGrab
{
Args 30,158,128//20
}

actor S_DoubleLariat : DoubleLariat
{
Args 83,128,24//55
}


actor S_AtomicBuster : AtomicBuster
{
Args 683,758,384,196//455,505
}
actor S_AtomicSuplex : AtomicSuplex
{
Args 510,570,288,128//340,380
}
actor S_AtomicSuplexT : AtomicSuplexT
{
Args 195,233,96,64//130,155
}

actor Tristana : CustWepClassBase {
  Player.ScoreIcon "UMUG_38"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Tristana"
  Player.SoundClass "Tristana"
  Player.MaxHealth 650
  Health 650
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Tristana_W"
  Player.StartItem "IWannaShootSomethingAmmo", 892

  States {
   Spawn:
    1H38 A 0
    1H38 B 1
    1H38 A 1
    goto Spawn+2
   See:
    1H38 BCDE 5
    goto Spawn
   Missile:
    1H38 F 2
    1H38 G 5
    1H38 F 5
    goto Spawn+2
   ClassPain:
    1H38 H 0
    goto MegamanPain

   ClassDeath:
    1H38 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H38 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H38 H 0 A_SpawnItemEx("TristanaDeathCorpse", 0, 0, 12, -16, 0, 12, 0, 1)
    1H38 H 1 A_ChangeVelocity(-8, 0, 6, 3)
    1H38 Z 2 A_PlaySound("*death", 2)
    goto MegamanErase

   MegamanDisintegrate:
    1H38 Z 0 A_SpawnItemEx("Corpse_38", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TristanaShiny : Tristana {
  Player.ScoreIcon "UMUG_S38"
  Player.MaxHealth 2650
  Health 2650
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.05, 1.05
  Player.JumpZ 11
  Player.MorphWeapon "TristanaShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H38 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H38 H 0 A_SpawnItemEx("S_TristanaDeathCorpse", 0, 0, 12, -16, 0, 12, 0, 1)
    1H38 H 1 A_ChangeVelocity(-8, 0, 6, 3)
    1H38 Z 2 A_PlaySound("*death", 2)
    goto MegamanErase
  }
}



actor TristanaDeathCorpse : BasicProjectile {
  DamageType "Tristana"
  Obituary "$OB_38D"
  -NOGRAVITY
  +SKYEXPLODE
  +DONTSPLASH
  +DONTBLAST
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +BOUNCEONFLOORS
  +USEBOUNCESTATE
  BounceCount 20

  BounceFactor 0.75
  WallBounceFactor 0.90
  ReactionTime 1
  Damage (298)
  Radius 15
  Height 15
  Speed 32
  Scale 2.5
  States {
   Spawn:
    1H38 I 3
   Spawn2:
    1H38 J 3
   Spawn3:
    1H38 K 3
   Spawn4:
    1H38 L 3
    goto Spawn
   Bounce.Floor:
    "####" "#" 0 A_JumpIfInventory("WeaponCharge", 2, "BounceEnd")
    "####" "#" 0 A_GiveInventory("WeaponCharge", 1)
    "####" "#" 0 A_Jump(256, "Spawn", "Spawn2", "Spawn3", "Spawn4")
    goto Spawn
   BounceEnd:
    "####" "#" 0 A_SpawnItemEx("TristanaDeathCorpseFall", 0, 0, 0, velx, vely, -10, 0, 9)
    stop
   Crash:
   XDeath:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("TristanaDeathCorpseFallX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Death:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("TristanaDeathCorpseFallX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor S_TristanaDeathCorpse : TristanaDeathCorpse {
  Damage (447)
}


actor TristanaDeathCorpseFall {
  -NOGRAVITY
  -SOLID
  +DONTSPLASH
  // Friction 2
  Radius 15
  Height 15
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    1H38 IIIJJJKKKLLL 1 A_JumpIf(velz == 0, "Slide")
    goto Spawn+2
   Slide:
    // 1H38 M 0 A_LogInt(velx*velx+vely*vely)
    1H38 M 1 A_JumpIf(velx * velx + vely * vely <= 0.35f, "SpawnWait")
    loop
   SpawnWait:
    1H38 N 35 A_Stop
    1H38 N 35
    1H38 N 0 A_SpawnItemEx("TristanaMasteryH", 0, 0, 8)
    1H38 NNNNNNNN 35
    1H38 NNNNNNNNNNN 3 A_Fadeout
    stop
  }
}
actor TristanaDeathCorpseFallX : TristanaDeathCorpseFall {
  States {
   Spawn:
    1H38 M 0
    1H38 M 1 A_JumpIf(velz == 0, "SpawnWait")
    wait
  }
}

actor TristanaMasteryH : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("Trist/Llama", "Weapon")
    TNT1 A 0 A_Jump(8, "S_0")
    TNT1 A 0 A_Jump(256, "S_1", "S_2", "S_3", "S_4", "S_5")
   S_1:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX1", 0, 0, 0, 0, 0, 2)
    stop
   S_2:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX2", 0, 0, 0, 0, 0, 2)
    stop
   S_3:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX3", 0, 0, 0, 0, 0, 2)
    stop
   S_4:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX4", 0, 0, 0, 0, 0, 2)
    stop
   S_5:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX5", 0, 0, 0, 0, 0, 2)
    stop
   S_0:
    TNT1 A 2 A_SpawnItemEx("TristanaMasteryFX0", 0, 0, 0, 0, 0, 2)
    stop
  }
}

actor TristanaMasteryFX0 : BasicExplosion {
  Translation "202:202=163:163", "192:192=67:67", "198:198=154:154", "199:199=158:158"
  Scale 0.1
  States {
   Spawn:
    6P38 Z 1
    6P38 ZZZZZZZZZ 1 A_SetScale(scaleX + 0.1)
    6P38 Z 50 A_Stop
    6P38 Z 0 A_ChangeVelocity(0, 0, -2, 3)
    6P38 ZZZZZZZZZ 1 A_SetScale(scaleX - 0.1)
    stop
  }
}

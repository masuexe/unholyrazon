actor HeavyGunner_W_ScriptBar : ScriptBar {}

actor HeavyGunner_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 20
  Weapon.AmmoGive 400
  Inventory.Pickupmessage "$PU_16"
  Obituary "$OB_16W"
  Tag "$TAG_HeavyGunner_W"
  weapon.ammotype "MachineEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H16 [ 6
    loop

   Deselect:
    6H16 A 0 A_TakeInventory("HeavyGunnerFlag", 1)
    goto DeselectSwap
   Select:
    6H16 A 0 A_TakeInventory("HeavyGunnerFlag", 1)
    goto SelectSwap

   Ready:
    6H16 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HEAVYGUNNER_DYE)
    goto Ready2
   Ready2:
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 0, "Ready3")
    6H16 A 0 A_JumpIfNoAmmo("ReloadWait")
    Goto ReloadCheck
   Ready3:
    6H16 A 2 A_GiveInventory("HeavyGunner_Ready_P")
    wait


   ReloadTime:
    6H16 A 0 A_PlaySound("V_Man/Snd54", 1, 0.50)
    6H16 NOPQ 2 A_GiveInventory("HeavyGunner_Ready_P")
    TNT1 A 8 A_GiveInventory("HeavyGunner_Ready_P")
    6H16 QPON 2 A_GiveInventory("HeavyGunner_Ready_P")
    6H16 A 0 A_PlaySoundEx("V_Man/HP_Pick", "Body")
    6H16 A 0 A_GiveInventory("MachineEnergyAmmo", 400)
    goto Ready2

   ReloadCheck:
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 40, 1) goto ReloadWait+0
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 80, 1) goto ReloadWait+1
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 120, 1)goto ReloadWait+2
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 160, 1)goto ReloadWait+3
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 200, 1)goto ReloadWait+4
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 240, 1)goto ReloadWait+5
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 280, 1)goto ReloadWait+6
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 320, 1)goto ReloadWait+7
    6H16 A 0 A_JumpIfInventory("MachineEnergyAmmo", 360, 1)goto ReloadWait+8
    6H16 A 0
    goto ReloadWait+9

   ReloadWait:
    6H16 AAAAAAAAAAAA 2 A_GiveInventory("HeavyGunner_Ready_P")
    goto ReloadTime

   BotFire:
    6H16 A 0 A_Jump(32, "BotFire2")
    6H16 A 0 A_Jump(32, 1)
    goto BotFire4
    6H16 A 0 A_JumpIfNoAmmo("BotFire3")
    6H16 A 0 A_GiveInventory("MachineEnergyAmmo", 60)
    goto BotFire4
   BotFire2:
    6H16 A 0 A_JumpIfNoAmmo("BotFire3")
    6H16 A 0 A_SpawnItemEx("HeavyGunnerBoostBoom", 0, 0, 19, 0, 0, 0, 0, 1)
    6H16 A 0 A_PlaySoundEx("taunt/D_16", "Voice")
    6H16 A 0 A_PlaySoundEx("V_Man/Boom", "Body")
    6H16 A 0 ThrustThingZ(0, 70, 0, 0)
    6H16 A 0 A_Recoil(-20)
    6H16 BCCB 2 A_GiveInventory("MachineEnergyAmmo", 10)
    goto BotFire4
   BotFire3:
    6H16 A 0 A_Jump(198, 1)
    goto BotFire4
    6H16 A 0 A_PlaySoundEx("weapon/pursuitfire", "Weapon")
    6H16 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    6H16 BC 2
    6H16 CCCCCCCCCC 2 A_GiveInventory("MachineEnergyAmmo", 40)
    6H16 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    6H16 BA 2
    goto BotFire4
   BotFire4:
    6H16 A 0 A_Refire("BotFire4a")
    goto Ready2
   BotFire4a:
    6H16 A 0 A_JumpIfInventory("DuoBusterFlag", 1, 1)
    goto Fire2+1
    6H16 A 0
    goto FireA2+1

   Fire:
    6H16 A 0 A_JumpIfInventory("DuoBusterFlag", 1, "FireA")
    6H16 A 0 A_GiveInventory("DuoBusterFlag")
    6H16 D 0 A_GiveInventory("HeavyGunner_Fire_P1")
    6H16 B 0 A_ReFire(1)
    6H16 DE 2
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P2")
    6H16 B 0 A_ReFire(1)
    6H16 BH 2
    6H16 H 0 A_Refire("Fire2")
    Goto FireEndG
   Fire2:
    6H16 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P1")
    6H16 B 0 A_ReFire(1)
    6H16 BE 2
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P2")
    6H16 B 0 A_ReFire(1)
    6H16 BH 2
    6H16 H 0 A_Refire("Fire2")
    Goto FireEndG
   FireA:
    6H16 A 0 A_TakeInventory("DuoBusterFlag")
    6H16 G 0 A_GiveInventory("HeavyGunner_Fire_P2")
    6H16 G 0 A_ReFire(1)
    6H16 GH 2
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P1")
    6H16 B 0 A_ReFire(1)
    6H16 BE 2
    6H16 E 0 A_Refire("FireA2")
    Goto FireEndD
   FireA2:
    6H16 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P2")
    6H16 B 0 A_ReFire(1)
    6H16 BH 2
    6H16 B 0 A_GiveInventory("HeavyGunner_Fire_P1")
    6H16 B 0 A_ReFire(1)
    6H16 BE 2
    6H16 E 0 A_Refire("FireA2")
    Goto FireEndD

   FireEndD:
    6H16 D 2 A_RailWait
    Goto Ready2
   FireEndG:
    6H16 G 2 A_RailWait
    Goto Ready2

    //This desyncs, moving to a watcher method
    /*Flash:
    TNT1 A 2 A_TakeInventory("HeavyGunnerFlag",1)
    TNT1 A 0 A_JumpIfInventory("HeavyGunnerFlag",1,"Flash")
    stop*/

   Altfire:
    6H16 R 0 A_GiveInventory("HeavyGunner_Alt_P")
    6H16 R 0 A_ReFire(1)
    6H16 R 2
    6H16 S 2 A_SpawnItemEx("HeavyGunner_Alt_H", 0, 0, 28)
    6H16 TU 2 A_RailWait
    Goto Ready2
  }
}

actor MachineEnergyAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 400
  +INVENTORY.IGNORESKILL
}

actor HeavyGunnerFlag : Inventory {
  inventory.amount 1
  inventory.maxamount 56
}

actor HeavyGunner_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("HeavyGunnerFlag", 1, 2)
    TNT1 A 0 A_WeaponReady
    stop
    TNT1 A 0 A_WeaponReady(8)
    stop
  }
}

actor HeavyGunner_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("MachineEnergyAmmo", 1, 3)
    TNT1 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    TNT1 A 0 A_FireCustomMissile("HeavyGunnerShotW", random(-2, 2), 0, 8, 0)
    stop
    //TNT1 A 0 A_Recoil(2*cos(pitch))
    TNT1 A 0 A_TakeInventory("MachineEnergyAmmo", 15, 1)
    TNT1 A 0 A_TakeInventory("MachineEnergyAmmo", 5)
    TNT1 A 0 A_PlaySoundEx("V_Man/Pew", "Weapon")
    TNT1 A 0 A_FireCustomMissile("HeavyGunnerShot", random(-2, 2), 0, 8, 0)
    stop
  }
}
actor HeavyGunner_Fire_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay1")
    TNT1 A 0 A_JumpIfInventory("MachineEnergyAmmo", 1, 3)
    TNT1 A 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    TNT1 A 0 A_FireCustomMissile("HeavyGunnerShotW", random(-2, 2), 0, -8, 0)
    stop
    //TNT1 A 0 A_Recoil(2*cos(pitch))
    TNT1 A 0 A_TakeInventory("MachineEnergyAmmo", 15, 1)
    TNT1 A 0 A_TakeInventory("MachineEnergyAmmo", 5)
    TNT1 A 0 A_PlaySoundEx("V_Man/Pew", "Body")
    TNT1 A 0 A_FireCustomMissile("HeavyGunnerShot", random(-2, 2), 0, -8, 0)
    stop
  }
}

actor HeavyGunner_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerBoostBoom", 0, 0, 10, 0, 0, 0, 0, 1)
    goto Thrust
   Thrust:
    TNT1 A 0 ThrustThingZ(0, 70, 0, 0)
    TNT1 A 0 A_Recoil(-20)
    TNT1 A 0 A_GiveInventory("HeavyGunnerFlag", 54)
    TNT1 A 0 A_GiveInventory("VivifyDelay4")
    stop
  }
}

actor HeavyGunner_Alt_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_TakeFromTarget("HeavyGunnerFlag", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("HeavyGunnerFlag", 1, "Spawn")
    goto Death
  }
}

actor HeavyGunnerShot : BasicProjectile {
  Translation "192:192=152:152", "198:198=159:159"
  Obituary "$OB_16M1"
  damagetype "HeavyBuster"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (150)
  radius 16
  height 16
  Speed 60
  scale 2.5
  States {
   Spawn:
    TNT1 A 0
    //TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotFX",0,0,0,1,random(-2,2),momz/6,random(-30,30),1,128)
    TNT1 A 0 A_Jump(256, 1, 3, 5, 7, 9, 11, 13, 15)//The below is done because 'chance' spawns do not work online for the first 0 tics.
    6P16 A 1
    6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+1
    6P16 B 1
    6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+2
    6P16 C 1
    6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1+3
    6P16 D 1
    6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn1
    6P16 D 1
    6P16 D 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+1
    6P16 C 1
    6P16 C 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+2
    6P16 B 1
    6P16 B 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2+3
    6P16 A 1
    6P16 A 1 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, momx/6+frandom(-3, 3), momy/6+frandom(-3, 3), momz/6+frandom(0, 3), 0, 9, 96)
    goto Spawn2
   Spawn1:
    6P16 ABCD 2
    loop
   Spawn2:
    6P16 DCBA 2
    loop

   Death:
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotEndFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 2
    stop
  }
}


actor HeavyGunnerShotEndFX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(1, random(0, 3))
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, -2-Args[1]/3, 2+Args[1]/3, 5+Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, -2-Args[1]/3, -2-Args[1]/3, 5+Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, -2-Args[1]/3, 2+Args[1]/3, 3+Args[1], 0, 1)
    TNT1 A 0 A_SpawnItemEx("HeavyGunnerShotFX", 0, 0, 0, -2-Args[1]/3, -2-Args[1]/3, 3+Args[1], 0, 1)
    TNT1 A 2
    stop
  }
}

actor HeavyGunnerShotFX {
  +MISSILE
  +THRUACTORS
  +CLIENTSIDEONLY
  +NOPAIN
  +DONTSPLASH
  -SOLID
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (0)
  radius 2
  height 2
  scale 2.0
  States {
   Spawn:
    TNT1 A 1
    6P16 EE 1
    TNT1 A 1
    6P16 FF 1
    TNT1 A 1
    goto Spawn+1
  }
}


actor HeavyGunnerShotW : HeavyGunnerShot {
  Obituary "$OB_16M2"
  Damage (75)
  radius 10
  height 10
  Speed 55
  scale 1.5
  States {
   Death:
    TNT1 A 2
    stop
  }
}

actor HeavyGunnerBoostBoom : BasicExplosion {
  Obituary "$OB_16A"
  damagetype "HeavyBuster"
  +FORCEXYBILLBOARD
  +BRIGHT
  Speed 48//This is so the fx doesn't blind the user on use
  Scale 2.75
  Args 400, 128, 20
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("V_Man/Boom", "Body")
    TNT1 A 0 A_Explode(Args[0]*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*2), Args[1], 0, 0, Args[2])
    6P16 HIJKL 3
    stop
  }
}

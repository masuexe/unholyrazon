actor FlightUnit_W_NormalBar : NormalBar {args 178, 184}
actor FlightUnit_W_SecondBar : SecondBar {args 193, 240}

actor FlightUnit_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 5
Weapon.AmmoGive 200
Weapon.AmmoUse2 0
Weapon.AmmoGive2 160
Inventory.Pickupmessage "$PU_18"
Obituary "$OB_18W"
Tag "$TAG_FlightUnit_W"
weapon.ammotype "DangerEnergyAmmo"
weapon.ammotype2 "FlightEnergyAmmo"
+WEAPON.ALT_AMMO_OPTIONAL
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H18 [ 6
loop

Deselect:
6H18 A 0 //SetPlayerProperty(0,0,3)
goto DeselectSwap
Select:
6H18 A 0
goto SelectSwap

Ready:
6H18 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FLIGHTUNIT_DYE)
6H18 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H18 A 2 A_GiveInventory("FlightUnit_Ready_P")
wait

Fire:
6H18 A 0 A_JumpIfInventory("DuoBusterFlag",1,"FireA")
6H18 A 0 A_GiveInventory("DuoBusterFlag")
6H18 D 2 A_GiveInventory("FlightUnit_Fire_P1")
6H18 E 2
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P2")
6H18 H 2
6H18 G 0 A_Refire("Fire2")
6H18 G 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
Fire2:
6H18 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H18 A 0 A_JumpIfNoAmmo(6)
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P1")
6H18 E 2
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P2")
6H18 H 2
6H18 G 0 A_Refire("Fire2")
6H18 G 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
FireA:
6H18 A 0 A_TakeInventory("DuoBusterFlag")
6H18 G 2 A_GiveInventory("FlightUnit_Fire_P2")
6H18 H 2
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P1")
6H18 E 2
6H18 D 0 A_Refire("FireA2")
6H18 D 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2
FireA2:
6H18 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H18 A 0 A_JumpIfNoAmmo(6)
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P2")
6H18 H 2
6H18 B 2 A_GiveInventory("FlightUnit_Fire_P1")
6H18 E 2
6H18 D 0 A_Refire("FireA2")
6H18 D 2 A_GiveInventory("FlightEnergyAmmo",1)
Goto Ready2

BotFire:
6H18 A 0 A_JumpIfNoAmmo("BotFire3")
6H18 A 0 A_JumpIfInventory("FlightEnergyAmmo",160,"AltFire")
6H18 A 0 A_Jump(16,"BotFire2")
6H18 A 0 A_Jump(32,1)
goto BotFire4
6H18 A 0 A_Jump(32,"AltFire")
6H18 A 0 A_GiveInventory("DangerEnergyAmmo",50)
goto BotFire4
BotFire2:
6H18 A 0 A_SpawnItemEx("HSH_DustBoostFX")
6H18 A 0 A_PlaySoundEx("classes/taunt/flightunit","Voice")
6H18 A 0 A_GiveInventory("BotFlagDelay",6)
goto BotFire2a
BotFire2a:
6H18 B 0 A_TakeInventory("BotFlagDelay",1)
6H18 B 0 A_PlaySoundEx("weapon/mirrordeflect2","Weapon")
6H18 BB 0 A_SpawnItemEx("DangerMissileBot",0,0,32,15,random(-32,32),random(-8,16))
6H18 BC 2
6H18 B 2 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
goto Ready2
BotFire3:
6H18 A 0 A_PlaySoundEx("weapon/pursuitfire","Weapon")
6H18 B 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
6H18 BC 2
6H18 CCCCCCCCCC 2 A_GiveInventory("DangerEnergyAmmo",20)
6H18 C 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
6H18 BA 2
goto BotFire4
BotFire4:
6H18 A 0 A_Refire("BotFire4a")
goto Ready2
BotFire4a:
6H18 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto Fire2+1
6H18 A 0
goto FireA2+1

Flash:
TNT1 A 1 A_GiveInventory("FlightUnit_Flash_P")
loop

AltFire:
6H18 B 2 A_GiveInventory("FlightUnit_Alt_P")
6H18 C 2 A_GiveInventory("DangerEnergyAmmo",8)
6H18 BA 2
Goto Ready2

}
}

actor FlightEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 160
+INVENTORY.IGNORESKILL
}

actor DangerEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor FlightUnit_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("DangerEnergyAmmo",10,"Ready2a")
TNT1 A 0 A_JumpIfInventory("FlightEnergyAmmo",40,"Ready2b")
TNT1 A 0 A_WeaponReady(WRF_NOFIRE)
goto Ammo
Ready2a:
TNT1 A 0 A_JumpIfInventory("FlightEnergyAmmo",40,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
Ready2b:
TNT1 A 0 A_JumpIfInventory("DangerEnergyAmmo",10,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("FlightEnergyAmmo",2)
TNT1 A 0 A_GiveInventory("DangerEnergyAmmo",4)
stop
}
}

actor FlightUnit_Flash_P : CustomInventory
{
States
{
Pickup:
//TNT1 A 0 A_CheckFloor("Off")
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "Off")
TNT1 A 0 A_JumpIfInventory("PowerMomZVerify",1,2)
TNT1 A 0 A_JumpIf(momz==0,2)
goto On
6H36 F 0 A_JumpIf(momz==0,2)
goto On
6H36 F 0 A_GiveInventory("PowerMomZVerify")
goto On
6H36 F 0 A_GiveInventory("PowerMomZVerify")
goto Off
On:
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,14,10)
stop
Off:
TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorproperty", APROP_Speed,10,10)
stop
}
}

actor FlightUnit_Fire_P1 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("FlightUnitBullet",random(-1,2),0,8,0)
Pickup2:
TNT1 A 0 A_PlaySoundEx("Contra/C_MACHG","Weapon")
TNT1 A 0 A_GiveInventory("FlightEnergyAmmo",2)
TNT1 A 0 A_TakeInventory("DangerEnergyAmmo",3,1)
TNT1 A 0 A_TakeInventory("DangerEnergyAmmo",2)
stop
}
}
actor FlightUnit_Fire_P2 : FlightUnit_Fire_P1
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("FlightUnitBullet",random(-2,1),0,-8,0)
goto Pickup2
}
}

actor FlightUnit_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("DangerMissile",0,0,0,0)//-4,0,10,0//4,0,-10,0//-8,0,20,0//8,0,-20,0
goto Thrust
Thrust:

TNT1 A 0 A_TakeInventory("FlightEnergyAmmo",20,1)
TNT1 A 0 A_TakeInventory("FlightEnergyAmmo",20)
TNT1 A 0 A_PlaySoundEx("weapon/airshooter","Body")
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*10, 0, sin(pitch)*6.5,CVF_RELATIVE)//30 20
stop
}
}

actor FlightUnitBullet : BasicFastProjectile
{
Translation "192:192=178:178","198:198=184:184"
damagetype "FlightUnit"
Obituary "$OB_18M"
+THRUGHOST
+RIPPER
+BLOODLESSIMPACT
damage (20)
Radius 6
Height 6
speed 70
scale 2.5
States
{
Spawn:
X_3A A 1 A_SpawnItemEX("FlightUnitBulletFx",0,0,0,0,0,0,0,1)
loop
Death:
X_3A BCDCB 1
stop
}
}

actor FlightUnitBulletFx : BasicClientSide
{
Alpha 0.85
Scale 2.0
States
{
Spawn:
TNT1 A 2
6P18 AA 1 A_FadeOut(0.1)
6P18 BBBB 1 A_FadeOut(0.1)
stop
}
}

actor DangerMissile : BasicProjectile
{
Translation "192:192=193:193","198:198=240:240"
Obituary "$OB_18A1"
damagetype "FlightUnit"
damage (75)
Radius 10
Height 10
speed 80
scale 3.5
Args 95,148,16
States
{
Spawn:
X_4G AB 1
loop
Death:
X_8G A 0
X_8G A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
X_8G A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
X_8G ABCEFECBA 1 Bright
stop
}
}

actor DangerMissileBot : DangerMissile
{
Obituary "$OB_18A2"
+SEEKERMISSILE
+SCREENSEEKER
ReactionTime 140
damage (35)
speed 70
Args 50,128,16
States
{
Spawn:
X_4G AAAAAAA 1 A_Recoil(3)
X_4G A 0 A_Stop
X_4G A 8
X_4G A 0 A_ChangeVelocity(30,0,0,CVF_RELATIVE)
Spawn2:
X_4G AB 1 A_SeekerMissile(2,5,SMF_LOOK,50,10)
X_4G A 0 A_CountDown
loop
}
}

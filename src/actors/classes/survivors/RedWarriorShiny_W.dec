actor S_RedWarriorShot5 : S_RedWarriorShotBase
{
Obituary "$OB_S44M5"
+NOFEAR
Damage(150)//100+0
speed 25//-5
Args 0
States
{
Spawn:
goto S_2
Death:
TNT1 A 0 A_PlaySound("GNT/FakeWall",1)
TNT1 A 0 A_Explode(105,128,0,0,16)//70
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1+16384)
stop
}
}

actor S_RedWarriorShot6 : S_RedWarriorShotBase
{
Obituary "$OB_S44M6"
+SCREENSEEKER
Damage(120)//100-20
Speed 20//-10
States
{
Spawn:
TNT1 A 1
TNT1 A 0 A_Jump(256,1,2,3,4,5,6,7,8)
S_2H:
6P44 JKLMNOPQ 2 A_SeekerMissile(1,6,SMF_LOOK,45,4)//1,6,SMF
6P44 I 0 A_CountDown
loop
Death:
6P44 "#" 2 A_FadeOut(0.08)
Loop
}
}

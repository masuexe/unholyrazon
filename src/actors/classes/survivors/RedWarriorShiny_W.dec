// TODO: buff the weapon

actor RedWarriorShiny_W_ScriptBar : ScriptBar {}

actor RedWarriorShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_RedWarrior_W"
Weapon.AmmoUse 10
Weapon.AmmoGive 150
Inventory.Pickupmessage "$PU_44_A"
Obituary "$OB_44W1"
Tag "$TAG_RedWarrior_W"
weapon.ammotype "TreasureAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
7H44 [ 6
loop

Deselect:
7H44 A 0
goto DeselectSwap
Select:
7H44 A 0
goto SelectSwap

Ready:
7H44 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", REDWARRIOR_SDYE)
7H44 A 0 A_TakeInventory("WarriorStack")
7H44 A 0 A_GiveInventory("WarriorStack",2)//random(1,6)
7H44 A 0 A_GunFlash("Flash",1)
7H44 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready3
Ready1:
7H44 A 6 A_WeaponReady
7H44 A 0 A_GiveInventory("TreasureAmmo",10)
loop
Ready2:
7H44 H 6 A_WeaponReady
7H44 H 0 A_GiveInventory("TreasureAmmo",10)
loop
Ready3:
7H44 O 6 A_WeaponReady
7H44 O 0 A_GiveInventory("TreasureAmmo",10)
loop
Ready4:
7I44 A 6 A_WeaponReady
7I44 A 0 A_GiveInventory("TreasureAmmo",10)
loop
Ready5:
7I44 H 6 A_WeaponReady
7I44 H 0 A_GiveInventory("TreasureAmmo",10)
loop
Ready6:
7I44 O 6 A_WeaponReady
7I44 O 0 A_GiveInventory("TreasureAmmo",10)
loop

Fire:
7H44 B 0 A_GiveInventory("S_RedWarrior_Fire_P")
7H44 B 0 A_JumpIfInventory("WarriorStack",1,"Fire2")
Fire1:
7H44 BCDE 2
Goto Ready1
Fire2:
7H44 I 0 A_JumpIfInventory("WarriorStack",2,"Fire3")
7H44 IJKL 2
Goto Ready2
Fire3:
7H44 P 0 A_JumpIfInventory("WarriorStack",3,"Fire4")
7H44 PQRS 2
Goto Ready3
Fire4:
7I44 B 0 A_JumpIfInventory("WarriorStack",4,"Fire5")
7I44 BCDE 2
Goto Ready4
Fire5:
7I44 I 0 A_JumpIfInventory("WarriorStack",5,"Fire6")
7I44 IJKL 2
Goto Ready5
Fire6:
7I44 P 0 A_JumpIfInventory("WarriorStack",6,"Fire1")
7I44 PQRS 2
Goto Ready6

Flash:
TNT1 A 1 A_GiveInventory("RedWarrior_LowHP_P")
loop

AltFire:
"####" "#" 0 A_GiveInventory("VivifyDelay4")
"####" "#" 0 A_ReFire(1)
7H44 G 0 A_JumpIfInventory("WarriorStack",1,"Altfire3")
goto Altfire2

Altfire1:
7I44 U 0 A_JumpIfInventory("WarriorStack",6,"Altfire2")
7H44 G 0 A_GiveInventory("S_RedWarrior_Alt_P")
7H44 GFGFGFGFGA 2 A_GiveInventory("TreasureAmmo",15)
goto Ready1
Altfire2:
7H44 N 0 A_GiveInventory("S_RedWarrior_Alt_P")
7H44 NMNMNMNMNH 2 A_GiveInventory("TreasureAmmo",15)
goto Ready2
Altfire3:
7H44 N 0 A_JumpIfInventory("WarriorStack",2,"Altfire4")
7H44 U 0 A_GiveInventory("S_RedWarrior_Alt_P")
7H44 UTUTUTUTUO 2 A_GiveInventory("TreasureAmmo",15)
goto Ready3
Altfire4:
7H44 U 0 A_JumpIfInventory("WarriorStack",3,"Altfire5")
7I44 G 0 A_GiveInventory("S_RedWarrior_Alt_P")
7I44 GFGFGFGFGA 2 A_GiveInventory("TreasureAmmo",15)
goto Ready4
Altfire5:
7I44 G 0 A_JumpIfInventory("WarriorStack",4,"Altfire6")
7I44 N 0 A_GiveInventory("S_RedWarrior_Alt_P")
7I44 NMNMNMNMNH 2 A_GiveInventory("TreasureAmmo",15)
goto Ready5
Altfire6:
7I44 N 0 A_JumpIfInventory("WarriorStack",5,"Altfire1")
7I44 U 0 A_GiveInventory("S_RedWarrior_Alt_P")
7I44 UTUTUTUTUO 2 A_GiveInventory("TreasureAmmo",15)
goto Ready6


BotReady:
7H44 O 0 A_WeaponReady(12)
7H44 OOOOO 2 A_Refire("BotFire")
7H44 O 0 A_GiveInventory("TreasureAmmo",10)
goto BotReady

BotFire:
7H44 O 0 A_JumpIfInventory("BotFlag2",1,"BotFire1b")
7H44 O 0 A_JumpIfInventory("TreasureAmmo",10,2)
7H44 O 0 A_Jump(32,"BotFire2q")
goto BotFire2
7H44 O 0 A_Jump(8,"BotFireX")
7H44 O 0 A_Jump(24,"BotFire2")
7H44 O 0 A_Jump(64,1)
goto BotFire1
7H44 O 0 A_GiveInventory("TreasureAmmo",random(3,7)*15)
goto BotFire1

BotFireX:
7H44 O 0 A_PlaySoundEx("taunt/D_S44","Voice")
7H44 O 0 A_Jump(1,2)
7H44 O 0 A_GiveInventory("BotFlag1",random(20,45))//512 new levels?!
goto BotFire1a
7H44 O 0 A_PlaySoundEx("GNT/KeyCollect","Auto")
7H44 O 0 A_GiveInventory("BotFlag2",512)
goto BotFire1b

BotFire1:
7H44 P 0 A_GiveInventory("S_RedWarrior_Fire_P")
7H44 PQRS 2
Goto BotReady
BotFire1a:
7H44 P 0 A_GiveInventory("S_RedWarrior_Fire_P")
7H44 P 2 A_TakeInventory("BotFlag1",1)
7H44 R 2 A_GiveInventory("TreasureAmmo",10)
7H44 O 0 A_JumpIfInventory("BotFlag1",1,1)
Goto BotReady
7H44 O 0 A_Refire("BotFire1a")
7H44 O 0 A_TakeInventory("BotFlag1")
Goto BotReady
BotFire1b:
7H44 O 0 A_JumpIfInventory("TreasureAmmo",10,3)
7H44 O 0 A_GiveInventory("S_RedWarrior_Alt_P")
7H44 O 0 A_GiveInventory("TreasureAmmo",150)
7H44 P 0 A_GiveInventory("S_RedWarrior_Fire_P")
7H44 P 2 A_TakeInventory("BotFlag2",1)
7H44 O 0 A_JumpIfInventory("BotFlag2",1,1)
Goto BotReady
7H44 O 0 A_Refire("BotFire1b")
Goto BotReady

BotFire2:
7H44 U 0 A_Jump(4,"BotFire2q")
7H44 U 0 A_GiveInventory("S_RedWarrior_Alt_P")
7H44 U 0 A_ReFire(1)
7H44 UTUTUTUTUO 2 A_GiveInventory("TreasureAmmo",15)
7H44 U 0 A_Jump(32,1)
Goto BotReady
7H44 U 0 A_ReFire("BotFire2")
Goto BotReady
BotFire2q:
7H44 O 0 A_PlaySoundEx("taunt/D_S44","Voice")
7H44 O 0 A_TakeInventory("WarriorStack")
7H44 O 0 A_GiveInventory("WarriorStack",random(1,6))
7H44 S 2 A_GiveInventory("S_RedWarrior_Alt_P")
Goto BotReady
}
}

actor S_RedWarrior_LowHP_P : CustomInventory
{
States
{
Pickup:
//TNT1 A 0 A_JumpIfInventory("IsDead",1,"No")
TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25,"Gauntlet")
stop
Gauntlet:
TNT1 A 0 A_JumpIfInventory("GauntletLowHPFlag",1,"No")
TNT1 A 0 A_PlaySound("GNT/LowHealth",4)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 5)
TNT1 A 0 A_GiveInventory("GauntletLowHPFlag")
TNT1 A 0 A_Jump(256,"Gauntlet2")
stop
Gauntlet2:
TNT1 A 0 A_GiveInventory("PowerDamageRedWarrior")
stop
No:
TNT1 A 0
stop
}
}

actor S_RedWarrior_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("TreasureAmmo")
TNT1 A 0 A_GiveInventory("VivifyDelay4")
TNT1 A 0 A_PlaySound("GNT/ExitTele",1)

TNT1 A 0 A_JumpIfInventory("WarriorStack",6,2)
TNT1 A 0 A_GiveInventory("WarriorStack",1)
goto FX
TNT1 A 0 A_TakeInventory("WarriorStack",5)
goto FX
FX:
TNT1 A 0 A_JumpIfInventory("WarriorStack",6,6)
TNT1 A 0 A_JumpIfInventory("WarriorStack",5,10)
TNT1 A 0 A_JumpIfInventory("WarriorStack",4,8)
TNT1 A 0 A_JumpIfInventory("WarriorStack",3,6)
TNT1 A 0 A_JumpIfInventory("WarriorStack",2,4)
TNT1 A 0 A_JumpIfInventory("WarriorStack",1,2)
TNT1 A 0 A_SpawnItemEx("WarriorStack1FX",-1,0,56,0,0,2)
stop
TNT1 A 0 A_SpawnItemEx("WarriorStack2FX",-1,0,56,0,0,2)
stop
TNT1 A 0 A_SpawnItemEx("WarriorStack3FX",-1,0,56,0,0,2)
stop
TNT1 A 0 A_SpawnItemEx("WarriorStack4FX",-1,0,56,0,0,2)
stop
TNT1 A 0 A_SpawnItemEx("WarriorStack5FX",-1,0,56,0,0,2)
stop
TNT1 A 0 A_SpawnItemEx("WarriorStack6FX",-1,0,56,0,0,2)
stop
}
}

actor S_RedWarrior_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TreasureAmmo",10,2)
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShotBase",0,0,8,0)
goto Snd
TNT1 A 0 A_JumpIfInventory("WarriorStack",6,"P1")
TNT1 A 0 A_JumpIfInventory("WarriorStack",5,"P6")
TNT1 A 0 A_JumpIfInventory("WarriorStack",4,"P5")
TNT1 A 0 A_JumpIfInventory("WarriorStack",3,"P4")
TNT1 A 0 A_JumpIfInventory("WarriorStack",2,"P3")
TNT1 A 0 A_JumpIfInventory("WarriorStack",1,"P2")
goto Pickup+1


Snd2:
TNT1 A 0 A_PlaySound("GNT/Red44",1)
stop
Snd:
TNT1 A 0 A_PlaySound("GNT/RNGShot",1)
stop
//****************
//SINGLE
//****************
P1:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot1",0,1,8,0)
goto Snd
P2:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot2",0,1,8,0)
goto Snd
P3:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot3",0,1,8,0)
goto Snd2
P4:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot4",0,1,8,0)
goto Snd
P5:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot5",0,1,8,0)
goto Snd
P6:
TNT1 A 0 A_FireCustomMissile("S_RedWarriorShot6",0,1,8,0)
goto Snd
}
}

actor S_RedWarriorShotBase : RedWarriorShotBase
{
Translation "192:192=128:128","198:198=132:132","199:199=106:106"
//Translation "192:192=31:31","198:198=47:47","199:199=225:225"
Obituary "$OB_S44M0"
//reactiontime 10
Damage (150)//100
States
{
Death:
6P44 "#" 1
6P44 A 5
stop
}
}

actor S_RedWarriorShot1 : S_RedWarriorShotBase
{
BounceSound "GNT/Bounce"
Obituary "$OB_S44M1"
+BOUNCEONWALLS
+BOUNCEONFLOORS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
-EXPLODEONWATER
WALLBOUNCEFACTOR 0.945
BOUNCEFACTOR 0.945
bouncecount 25
Damage(143)//100-5
States
{
Spawn:
goto S_2B
}
}


actor Trickster : CustWepClassBase {
  Player.ScoreIcon "UMUG_14"
  Player.DisplayName "Trickster"
  Player.SoundClass "Trickster"
  Player.MaxHealth 600
  Health 600
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.05, 1.05
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Trickster_W"
  Player.StartItem "SinisterEnergyAmmo", 44
  Player.StartItem "PansyEscapeAmmo", 132
  States {
   Spawn:
    1H14 A 0
    1H14 B 1
    1H14 A 1
    goto Spawn+2
   See:
    1H14 BCDE 5
    goto Spawn
   Missile:
    1H14 FFFFF 1
    1H14 GGGG 1
    goto Spawn+2
   ClassPain:
    1H14 H 0
    goto MegamanPain

   ClassDeath:
    1H14 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H14 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H14 H 0
    1H14 F 3 A_PlaySound("weapon/magdrillshoot", 1)
    1H14 FFFFFFF 0 A_SpawnItemEx("TricksterShotDeath", 0, 0, 28, random(-10, 10), random(-10, 10), random(2, 10), 0, 1)
    1H14 F 3
    1H14 H 1
    goto MegamanFade
   MegamanDisintegrate:
    1H14 Z 0 A_SpawnItemEx("Corpse_14", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TricksterShiny : Trickster {
  Player.ScoreIcon "UMUG_S14"
  Player.MaxHealth 2600
  Health 2600
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 11
  Player.MorphWeapon "TricksterShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H14 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H14 H 0
    1H14 F 3 A_PlaySound("weapon/magdrillshoot", 1)
    1H14 FFFFFFF 0 A_SpawnItemEx("S_TricksterShotDeath", 0, 0, 28, random(-10, 10), random(-10, 10), random(2, 10), 0, 1)
    1H14 F 3
    1H14 H 1
    goto MegamanFade
  }
}

actor Corpse_14 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_14_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_14_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_14_0 : BaseCorpseFX {States {Spawn: 1H14 O 350
    goto Spawn2}}
actor Corpse_14_1 : BaseCorpseFX {States {Spawn: 1H14 P 350
    goto Spawn2}}
actor Corpse_14_2 : BaseCorpseFX {States {Spawn: 1H14 Q 350
    goto Spawn2}}
actor Corpse_14_3 : BaseCorpseFX {States {Spawn: 1H14 R 350
    goto Spawn2}}
actor Corpse_14_4 : BaseCorpseFX {States {Spawn: 1H14 S 350
    goto Spawn2}}
actor Corpse_14_5 : BaseCorpseFX {States {Spawn: 1H14 T 350
    goto Spawn2}}
actor Corpse_14_6 : BaseCorpseFX {States {Spawn: 1H14 U 350
    goto Spawn2}}

TNT1 A 0 A_SpawnItemEx("Corpse_14_1",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_14_2",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_14_3",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_14_4",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_14_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)

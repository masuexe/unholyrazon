actor RamesesShiny_W_ScriptBar : ScriptBar {}

actor RamesesShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Rameses_W"
  Weapon.AmmoUse 0
  Inventory.Pickupmessage "$PU_32"
  Obituary "$OB_32W"
  Weapon.AmmoType "DarknessEnergyAmmo"
  States {
   Spawn:
    7H32 [ 6
    loop

   Deselect:
    7H32 A 0
    goto DeselectSwap
   Select:
    7H32 A 0
    goto SelectSwap

   Ready:
    7H32 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", RAMESES_SDYE)
    7H32 A 1  // Initial setup: shiny morph hook.
    7H32 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    goto Ready2
   Ready2:
    7H32 A 1 A_WeaponReady
    wait

   Fire:
    7H32 B 0 A_GiveInventory("WeaponCharge", 1)
    7H32 B 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    7H32 B 0 A_ReFire(1)
    goto Throw1
    7H32 B 1
    7H32 B 0 A_ReFire(1)
    goto Throw1
    7H32 C 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    7H32 C 0 A_ReFire(1)
    goto Throw1
    7H32 C 1 A_GunFlash("Flash", 1)
    7H32 C 0 A_ReFire(1)
    goto Throw1
    7H32 D 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    7H32 D 0 A_ReFire(1)
    goto Throw1
    7H32 D 1
    7H32 D 0 A_ReFire(1)
    goto Throw1
    7H32 E 1 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    7H32 E 0 A_ReFire(1)
    goto Throw1
    7H32 E 1  // A_GunFlash("Flash",1)
    7H32 E 0 A_ReFire("Hold1")
    goto Throw1

   Hold1:
    7H32 E 1 A_JumpIfInventory("WeaponCharge", 16, "Hold2")
    7H32 E 0 A_ReFire("Hold1")
    goto Throw1
   Hold2:
    7H32 E 1 A_JumpIfInventory("WeaponCharge", 80, "Hold3")
    7H32 E 0 A_ReFire("Hold2")
    goto Throw2
   Hold3:
    7H32 E 1 A_RailWait
    7H32 E 0 A_ReFire("Hold3")
    goto Throw3

   Throw1:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P1")
    7H32 F 1
    7H32 G 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 H 1
    7H32 I 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 J 1
    7H32 K 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 L 2 A_ClearReFire
    goto Ready2
   Throw2:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P2")
    7H32 F 1
    7H32 G 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 H 1
    7H32 I 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 J 1
    7H32 K 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 L 2 A_ClearReFire
    7H32 M 2
    // 7H32 A 2
    goto Ready2
   Throw3:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P3")
    7H32 FGHIJK 2
    7H32 T 2 A_GiveInventory("RamesesCurseF_Take_P")
    7H32 L 2 A_ClearReFire
    7H32 M 2
    // 7H32 A 2
    goto Ready2

   Flash:
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 80, 4)
    TNT1 A 0 A_SpawnItemEx("RamesesShotChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 1, 192)
    TNT1 A 0 A_GiveInventory("DarknessEnergyAmmo", 1)
    TNT1 A 2 A_GiveInventory("WeaponCharge", 2)
    loop
    TNT1 AA 0 A_SpawnItemEx("RamesesShotChargeFX", frandom(16, 48), 0, frandom(8, 32), 0, 0, 6, random(0, 359), 1)
    TNT1 A 0 A_JumpIfInventory("RamesesChargeFlag", 14, 2)
    TNT1 A 2 A_GiveInventory("RamesesChargeFlag", 1)
    loop
    TNT1 A 0 A_PlaySound("Rameses/Charge1", 4)
    TNT1 A 0 A_SpawnItemEx("RamesesShotChargeBurstFX", 0, 0, 96, 0, 0, -1, 0, 1)
    TNT1 A 0 A_TakeInventory("RamesesChargeFlag")
    TNT1 A 2 A_GiveInventory("RamesesCurseFlag", 1)
    loop

   Altfire:
    7H32 G 0 A_PlaySound("Rameses/Main2", 1)
    7H32 J 0 A_FireCustomMissile("S_RamesesWave", 0, 0, 8, 0)
    7H32 FGHIJKTLM 2
    goto Ready2


   BotReady:
    7H32 A 0 A_WeaponReady(12)
    7H32 A 1 A_ReFire("BotHold")
    loop

   BotHold:
    7H32 A 0 A_Jump(64, "BotAlt")
    7H32 B 0 A_Jump(128, "BotFire1", "BotFire1", "BotFire1", "BotAlt")
    7H32 B 2 A_GiveInventory("WeaponCharge", 1)
    7H32 B 0 A_ReFire(1)
    goto BotFire1
    7H32 C 2 A_Jump(24, "BotFire1")
    7H32 C 0 A_ReFire(1)
    goto BotFire1
    7H32 D 2 A_Jump(16, "BotFire1")
    7H32 D 0 A_ReFire(1)
    goto BotFire1
    7H32 E 1 A_Jump(16, "BotFire2")
    7H32 E 0 A_ReFire(1)
    goto BotFire1
    7H32 E 0 A_Jump(8, "BotFire2")
    7H32 E 1 A_GunFlash("Flash", 1)
    7H32 E 0 A_ReFire("BotHold3")
    goto BotFire1

   BotHold3:
    7H32 E 1 A_GiveInventory("Rameses_BotTrick3_P")
    7H32 E 0 A_Jump(2, 3)
    7H32 E 0 A_JumpIfCloser(128, 2)
    7H32 E 0 A_ReFire("BotHold3")
    7H32 E 0 A_JumpIfInventory("WeaponCharge", 80, "BotFire3")
    7H32 E 0 A_JumpIfInventory("WeaponCharge", 16, "BotFire2")
    goto BotFire1

   BotFire1:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P1")
    7H32 F 1
    7H32 G 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 H 1
    7H32 I 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 J 1
    7H32 K 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 L 2 A_ClearReFire
    goto BotReady
   BotFire2:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P2")
    7H32 F 1
    7H32 G 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 H 1
    7H32 I 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 J 1
    7H32 K 1 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    7H32 L 2 A_ClearReFire
    7H32 M 2
    goto BotReady
   BotFire3:
    7H32 F 0 A_GiveInventory("S_RamesesFire_P3")
    7H32 FGHIJK 2
    7H32 T 2 A_GiveInventory("RamesesCurseF_Take_P")
    7H32 L 2 A_ClearReFire
    7H32 M 2
    goto BotReady

   BotAlt:
    7H32 G 0 A_PlaySound("Rameses/Main2", 1)
    7H32 J 0 A_FireCustomMissile("S_RamesesWave", 0, 0, 8, 0)
    7H32 FGHIJKTLM 2
    goto BotReady
  }
}

actor S_RamesesFire_P1 : RamesesFire_P0 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_RamesesShot1", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySound("Rameses/Main1", 1)
    goto Take
  }
}
actor S_RamesesFire_P2 : RamesesFire_P0 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_RamesesShot2", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySound("Rameses/Main1", 1)
    goto Take
  }
}
actor S_RamesesFire_P3 : RamesesFire_P0 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_RamesesShot3", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySound("Rameses/Charge2", 4)
    TNT1 A 0 A_PlaySound("Rameses/Main2", 1)
    goto Take
  }
}

actor S_RamesesWave : RamesesWave {
  Translation "192:192=163:163", "198:198=158:158"
  Args 113, 18  // 75
}

actor S_RamesesShot1 : RamesesShot1 {
  Translation "192:192=163:163", "198:198=158:158"
  Damage (128)  // 85
}

actor S_RamesesShot1X : RamesesShot1X {
  Translation "192:192=163:163", "198:198=158:158"
  Damage (38)  // 25
}

actor S_RamesesShot2 : RamesesShot2 {
  Translation "192:192=163:163", "198:198=158:158"
  Damage (113)  // 75
  States {
   Death:
    X_4D H 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, 60, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, -60, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, 120, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, -120, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, 180, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot1X", 0, 0, 0, 28, 0, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_Explode(75, 80, 0)  // 50
    goto DeathEnd
  }
}

actor S_RamesesShot2X : S_RamesesShot2 {
  +RIPPER
  -NOGRAVITY
  Damage (53)  // 35
  States {
   Spawn:
    X_4D H 0
    X_4D H 4 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    loop
  }
}

actor S_RamesesShot3 : RamesesShot3 {
  Translation "192:192=163:163", "198:198=158:158"
  Damage (210 + (user_power * 15))  // 140 *10
  States {
   DeathFix2:
    TNT1 A 0 A_SetArg(0, 2)
   DeathFix:
    TNT1 A 0 A_SetUserVar("user_power", CallACS("rz_CountInv_RamesesCurseFlag", 2) * args[0] + 1)
    TNT1 A 0 A_SetScale(2.5 + user_power / (1000.00 * args[0]))
    goto Death+1
   Crash:
   XDeath:
    TNT1 A 0 A_JumpIf(user_power == 0, "DeathFix2")
   Death:
    TNT1 A 0 A_JumpIf(user_power == 0, "DeathFix")
    TNT1 A 0 A_SetArg(4, 1 - (z - ceilingz == -height))
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], 60, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], -60, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], 120, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], -120, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], 180, 1)
    TNT1 A 0 A_SpawnItemEx("S_RamesesShot2X", 0, 0, 20 * args[4], 28, 0, args[4], 0, 1)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_Explode(210 + (user_power * 15), 196, 0, 0, 32)  // 140 *10
    goto DeathEnd
  }
}

actor NegaFlameBlastWep_NegaManBar : NegaManBar {args 6, 225}

actor NegaFlameBlastWep : BaseNegaManWep {
  Weapon.AmmoUse 7
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM6"
  Obituary "$OB_FLAMEBLAST"
  Tag "$TAG_NegaMan_W6c"
  weapon.ammotype "NegaMM6_Ammo"
  inventory.icon "NEG_FLMB"
  States {
   Spawn:
    6N02 G 6
loop

   Deselect:
    6H02 S 0
    goto DeselectSwap
   Select:
    6H02 S 0
    goto SelectSwap

   Ready:
    6H02 S 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE6)
   ReadyX:
    6H02 S 0 A_JumpIfNoAmmo("NoAmmo")
    6H02 S 8 A_WeaponReady
    6H02 S 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6H02 S 8 A_WeaponReady(4)
    6H02 S 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6H02 S 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto ReadyX

   Fire:
    6H02 S 0 A_JumpIfNoAmmo("NoAmmo")
    6H02 S 0 A_TakeInventory("NegaMM6_Ammo", 7)
    6H02 S 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6H02 S 0 A_GiveInventory("NegaFlameBlast_P",1)
    6H02 UTSS 5
    6H02 S 0 A_Refire
    Goto ReadyX

   NoAmmo:
    6H02 S 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6H02 S 0 A_GiveInventory("NegaMM6_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaFlameBlast : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  DamageType "FlameBlast"
  Obituary "$OB_FLAMEBLAST"
  +BRIGHT
  +HEXENBOUNCE
  -ALLOWBOUNCEONACTORS
  -NOGRAVITY
  -BOUNCEONFLOORS
  +NOEXPLODEFLOOR
  Bouncecount 3
  BounceFactor 1.0
  WallBounceFactor 1.0
  ReactionTime 9
  Damage (90)
  Radius 10
  Height 6
  Speed 25
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    X_6C H 1 A_CheckFloor("Floor")
    wait
   XDeath:
   Crash:
    X_6C H 0
    stop
   Floor:
    X_6C H 1 A_SpawnItemEx("NegaFlameBlast2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6C H 0 A_CountDown
    X_6C H 0 A_Stop
    X_6C H 0 ThrustThing(angle*256/360+random(-30, 30), 10, 0, 0)
    X_6C H 1 ThrustThingZ(0, 28, 0, 0)
    goto Spawn+1
   Death:
    TNT1 A 1
    stop
  }
}

actor NegaFlameBlast2 : BasicProjectile {
  DamageType "FlameBlast"
  Obituary "$OB_FLAMEBLAST"
  +BRIGHT
  +FLOORHUGGER
  +DONTBLAST
  ReactionTime 10
  Damage (100)
  Radius 8
  Height 28
  Speed 0
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    X_6C A 2
    X_6C B 2 A_SpawnItemEx("OilPitIgnite", 0, 0, 4)
    X_6C C 2
    X_6C D 2
    X_6C A 0 A_CountDown
    X_6C EFG 2
    goto Spawn+2

   Flame:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    X_6C A 0 A_ChangeFlag("FLOORHUGGER", 1)
    X_6C A 0 A_CountDown
    X_6C ABCDEFGFGFGFGFG 1
    Goto Flame+2

   Death:
    TNT1 A 0
    stop
  }
}

Actor NegaFlameBlast_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, 0, 28, cos(-pitch)*25, 0, sin(-pitch)*25, 0)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, -3, 28, cos(-pitch)*25, 0, sin(-pitch)*25, 5)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, 3, 28, cos(-pitch)*25, 0, sin(-pitch)*25, -5)
    stop
   Pickup2:
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, 0, 28, cos(-pitch)*25, 0, sin(-pitch)*25, 0)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, -3, 28, cos(-pitch)*25, 0, sin(-pitch)*25, 5)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, 3, 28, cos(-pitch)*25, 0, sin(-pitch)*25, -5)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, -6, 28, cos(-pitch)*25, 0, sin(-pitch)*25, 10)
    TNT1 A 0 A_SpawnItemEx("NegaFlameBlast", 0, 6, 28, cos(-pitch)*25, 0, sin(-pitch)*25, -10)
    stop
  }
}


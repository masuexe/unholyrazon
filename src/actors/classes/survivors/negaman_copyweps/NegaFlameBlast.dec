actor S_NegaFlameBlast : NegaFlameBlast {
  BounceCount 4
  ReactionTime 12
  Damage (150)
  Speed 30
  States {
   Floor:
    X_6C H 1 A_SpawnItemEx("S_NegaFlameBlast2", 0, 0, 0, 0, 0, 0, 0, 1)
    X_6C H 0 A_CountDown
    X_6C H 0 A_Stop
    X_6C H 0 ThrustThing(angle * 256 / 360 + random(-30, 30), 10, 0, 0)
    X_6C H 1 ThrustThingZ(0, 28, 0, 0)
    goto Spawn+1
  }
}


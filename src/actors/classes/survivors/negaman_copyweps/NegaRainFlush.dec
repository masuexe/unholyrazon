actor S_NegaRainFlush : BasicExplosion {
  Obituary "$OB_RAINFLUSH"
  var int user_rainarea;
  var int user_raindamage;
  var int user_count;
  Args 150, 128, 0
  ReactionTime 29
  States {
   Spawn:
    TNT1 A 25 A_SpawnItemEx("NegaRainFlushPod", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/rainflush", "Voice")
    TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
    TNT1 A 0 A_Explode(args[0], args[1], 0)
   Spawn2:
    TNT1 AAAAAAAAA 0 A_SpawnItemEx("NegaRainSprinkle", random(-1 * args[1], args[1]), random(-1 * args[1], args[1]), 384, -25, 0, -25, 90, 129)
    TNT1 A 1 A_CountDown
    TNT1 A 0 A_SetArg(1, args[1] + 26)
    TNT1 A 0 A_SetArg(2, args[2] + 1)
    TNT1 A 0 A_JumpIf(args[2] >= 7, "Spawn3")
    loop
   Spawn3:
    TNT1 A 0 A_SetArg(0, args[0] - 25)
    TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
    TNT1 A 0 A_Explode(args[0], args[1] * 0.5, 0, 0, args[1] * 0.5)
    TNT1 A 0 A_SetArg(2, 0)
    goto Spawn2
  }
}

actor S_NegaRainFlush2 : S_NegaRainFlush {Args 180, 160 ReactionTime 36}
actor S_NegaRainFlush3 : S_NegaRainFlush {Args 210, 192 ReactionTime 43}

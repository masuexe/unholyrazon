actor NegaRainFlushWep_NegaManBar : NegaManBar {args 4, 104}

actor NegaRainFlushWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_02_MM4z"
  Obituary "$OB_RAINFLUSH"
  Tag "$TAG_NegaMan_W4b"
  Weapon.AmmoType "NegaMM4_Ammo"
  Inventory.Icon "NEG_RAIN"
  States {
   Spawn:
    6N02 R 0
    goto SpawnFrame

   Deselect:
    6I02 Y 0
    goto DeselectSwap
   Select:
    6I02 Y 0
    goto SelectSwap

   Ready:
    6I02 Y 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE4B)
   ReadyX:
    6I02 Y 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 7))
    6I02 Y 0 A_JumpIfInventory("NegaMM4_Ammo", args[4], "ReadyHave")
    6I02 Y 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6I02 Y 8 A_WeaponReady
    6I02 Y 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6I02 Y 8 A_WeaponReady(4)
    6I02 Y 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 Y 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 7))
    6I02 Y 0 A_JumpIfInventory("NegaMM4_Ammo", args[4], "ReadyX")
    6I02 Y 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:  // Needs a version of hands specific for this attack
    6I02 Y 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 7), "NoAmmo")
    6I02 Y 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6I02 Z 4 A_FireCustomMissile("NegaRainFlushMineSpawner", 0, 1, 0, 0)
    6J02 A 4
    6I02 Y 18  // 12
    goto ReadyX

   NoAmmo:
    6I02 Y 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6I02 Y 0 A_GiveInventory("NegaMM4_Ammo", 28)
    goto ReadyX
  }
}

actor NegaRainFlushPod : BasicGraphicEffect {
  Scale 1.5
  States {
   SpawnFrame:
    X_4B A 0
    X_4B A 3 ThrustThingZ(0, 5, 0, 0)
    X_4B A 0 A_ChangeVelocity(0, 0, 0, 2)
    X_4B A 1 ThrustThingZ(0, 20, 0, 0)
    X_4B A 1 ThrustThingZ(0, 40, 0, 0)
    X_4B A 1 ThrustThingZ(0, 60, 0, 1)
    X_4B BCABCABCA 2
    stop
  }
}

actor NegaRainFlushMineSpawner : BasicProjectile {
  DamageType "NegaRainFlush"  // Just in the very case this thing even damagesm, ever. - Trist
  -NOGRAVITY
  +RIPPER
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +BOUNCEONACTORS
  +EXPLODEONWATER
  BounceFactor 0.65
  Radius 10
  Height 10
  Damage (0)
  Speed 30
  Scale 1.5
  States {
   Spawn:
    X_4B A 2
    loop
   Death:
    X_4B A 0 A_Stop
    X_4B A 0 A_ChangeFlag("NOGRAVITY", 1)
    X_4B A 0 A_PlaySound("weapon/crashland")
    X_4B A 0 A_SpawnItemEx("NegaRainFlushMine")
    TNT1 A 1
    stop
  }
}

actor NegaRainFlushMine : BasicProjectile {
  Obituary "%o found out where %k's 9th Rain Flush mine was."
  DamageType "NegaRainFlush"
  +NOCLIP
  +NODROPOFF
  +NOEXPLODEFLOOR
  ReactionTime 6
  Damage (50)
  Radius 12
  Height 10
  Speed 0
  Scale 1.5
  States {
   Spawn:
    X_4B A 0
    X_4B A 5
    X_4B A 0 A_ChangeFlag("NOCLIP", 0)
   Spawn2:
    X_4B A 34
    Y_4B A 2 A_Countdown
    loop
   Death:
    TNT1 A 0 A_PlaySound("weapon/mbuster")
    TNT1 A 1 A_SpawnItemEx("NegaRainFlush", 0, 0, 8, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaRainFlush : BasicExplosion {
  Obituary "$OB_RAINFLUSH"
  DamageType "NegaRainFlush"
  var int user_rainarea;
  var int user_raindamage;
  var int user_count;
  ReactionTime 29
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_rainarea", 128)
    TNT1 A 0 A_SetUserVar("user_raindamage", 100)  // 150
    TNT1 A 25 A_SpawnItemEx("NegaRainFlushPod", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/rainflush", "Voice")
    TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
    TNT1 A 0 A_Explode(user_raindamage, user_rainarea, 0)
   Spawn2:
    TNT1 AAAAAAAAA 0 A_SpawnItemEx("NegaRainSprinkle", random(-1 * user_rainarea, user_rainarea), random(-1 * user_rainarea, user_rainarea), 384, -25, 0, -25, 90, 129)
    TNT1 A 1 A_CountDown
    TNT1 A 0 A_SetUserVar("user_rainarea", user_rainarea + 26)
    TNT1 A 0 A_SetUserVar("user_count", user_count + 1)
    TNT1 A 0 A_JumpIf(user_count >= 7, "Spawn3")
    loop
   Spawn3:
    TNT1 A 0 A_SetUserVar("user_raindamage", user_raindamage - 20)  // -30
    TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
    TNT1 A 0 A_Explode(user_raindamage, user_rainarea * 0.5, 0, 0, user_rainarea * 0.5)
    TNT1 A 0 A_SetUserVar("user_count", 0)
    goto Spawn2
  }
}

actor NegaRainSprinkle : BasicGraphicEffect {
  States {
   SpawnFrame:
    X_4B D 30
    stop
  }
}


actor S_NegaTimeSlowShot : NegaTimeSlowShot {
  Speed 20
  Scale 2.0
  States {
   Spawn:
    X_1G A 0
    X_1G ABCD 4
   Die:
    X_1G A 0 A_ScaleVelocity(0.0)
    X_1G A 0 A_PlaySoundEx("weapon/slow", "Weapon") //Dio sound effect?
    TNT1 A 2 A_SpawnItem("S_NegaTimeSlowExplode")
    stop
   Death:
    TNT1 A 0
    stop
  }
}


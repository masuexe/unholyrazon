actor NegaNeedleCannonWep_NegaManBar : NegaManBar {args 3, 220}

actor NegaNeedleCannonWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM3z"
  Obituary "$OB_NEEDLECANNON"
  Tag "$TAG_NegaMan_W3a"
  Weapon.AmmoType "NegaMM3_Ammo"
  Inventory.Icon "NEG_NEED"
  States {
   Spawn:
    6N02 Q 0
    goto SpawnFrame

   Deselect:
    6I02 V 0
    goto DeselectSwap
   Select:
    6I02 V 0
    goto SelectSwap

   Ready:
    6I02 V 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE3A)
   ReadyX:
    6I02 V 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 1))
    6I02 V 0 A_JumpIfInventory("NegaMM3_Ammo", args[4], "ReadyHave")
    6I02 V 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6I02 V 8 A_WeaponReady
    6I02 V 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6I02 V 8 A_WeaponReady(4)
    6I02 V 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 V 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 1))
    6I02 V 0 A_JumpIfInventory("NegaMM3_Ammo", args[4], "ReadyX")
    6I02 V 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6I02 V 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 1), "NoAmmo")
    6I02 V 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6I02 V 0 A_GiveInventory("NegaNeedleCannon_P1")
    6I02 WXV 4
    6I02 V 0 A_ReFire("Fire2")
    goto ReadyX
   Fire2:
    6I02 V 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 1), "NoAmmo")
    6I02 V 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6I02 V 0 A_GiveInventory("NegaNeedleCannon_P2")
    6I02 WXV 4
    6I02 V 0 A_ReFire("Fire3")
    goto ReadyX
   Fire3:
    6I02 V 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 1), "NoAmmo")
    6I02 V 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6I02 V 0 A_GiveInventory("NegaNeedleCannon_P3")
    6I02 WXV 4
    6I02 V 0 A_ReFire("Fire")
    goto ReadyX

   NoAmmo:
    6I02 V 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6I02 V 0 A_GiveInventory("NegaMM3_Ammo", 28)
    goto ReadyX
  }
}

actor NegaNeedleCannon : BasicProjectile {
  DamageType "NegaNeedleCannon"
  Obituary "$OB_NEEDLECANNON"
  Damage (75)  // 65
  Radius 6  // 7
  Height 8  // 9
  Speed 40
  Scale 2.0  // 2.5
  States {
   Spawn:
    X_3A A 1
    loop
  }
}

actor NegaNeedleCannonTrue : NegaNeedleCannon {
  Damage (150)  // 175
  Radius 12
  Height 14
  Speed 60
  Scale 4.0
  States {
   Spawn:
    X_3A A 0
    X_3A AAA 0 A_SpawnItemEx("NegaNeedleFX", random(-2, -8), random(-12, 12), random(-8, 8), 0, 0, 0, 0, 1)
    X_3A A 1
    goto Spawn+1
  }
}

actor NegaNeedleFX : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 1.5
  States {
   SpawnFrame:
    X_2F D 0
    X_2F DEF 2
    stop
  }
}

actor NegaNeedleCannon_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, 0)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, 5)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, -5)
    stop
   Pickup2:
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannonTrue", 0, 0, 28, cos(-pitch) * 60, 0, sin(-pitch) * 60, 0)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, 5)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, -5)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, 10)
    TNT1 A 0 A_SpawnItemEx("NegaNeedleCannon", 0, 0, 28, cos(-pitch) * 40, 0, sin(-pitch) * 40, -10)
    stop
  }
}


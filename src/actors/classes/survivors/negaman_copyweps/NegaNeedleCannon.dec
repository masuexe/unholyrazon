Actor S_NegaNeedleCannon_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertySpread", 1, "Pickup2")
    TNT1 A 0 A_SpawnItemEx("S_NegaNeedleCannonTrue", 0, 0, 28, cos(-pitch)*60, 0, sin(-pitch)*60, 0)
    TNT1 A 0 A_SpawnItemEx("S_NegaNeedleCannon", 0, 0, 28, cos(-pitch)*40, 0, sin(-pitch)*40, 5)
    TNT1 A 0 A_SpawnItemEx("S_NegaNeedleCannon", 0, 0, 28, cos(-pitch)*40, 0, sin(-pitch)*40, -5)
    stop
   Pickup2:
    TNT1 A 0 A_SpawnItemEx("S_NegaNeedleCannon", 0, 0, 28, cos(-pitch)*40, 0, sin(-pitch)*40, 0)
    TNT1 A 0 A_SpawnItemEx("S_NegaNeedleCannonTrue", 0, 0, 28, cos(-pitch)*60, 0, sin(-pitch)*60, 5)

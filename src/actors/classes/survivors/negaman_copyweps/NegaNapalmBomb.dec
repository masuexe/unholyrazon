actor NegaNapalmBombWep_NegaManBar : NegaManBar {args 5, 216}

actor NegaNapalmBombWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_02_MM5z"
  Obituary "$OB_NAPALMBOMB"
  Tag "$TAG_NegaMan_W5g"
  Weapon.AmmoType "NegaMM5_Ammo"
  Inventory.Icon "NEG_NAPA"
  States {
   Spawn:
    6N02 S 0
    goto SpawnFrame

   Deselect:
    6J02 B 0
    goto DeselectSwap
   Select:
    6J02 B 0
    goto SelectSwap

   Ready:
    6J02 B 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE5G)
   ReadyX:
    6J02 B 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 B 0 A_JumpIfInventory("NegaMM5_Ammo", args[4], "ReadyHave")
    6J02 B 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6J02 B 8 A_WeaponReady
    6J02 B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6J02 B 8 A_WeaponReady(4)
    6J02 B 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6J02 B 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 B 0 A_JumpIfInventory("NegaMM5_Ammo", args[4], "ReadyX")
    6J02 B 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6J02 B 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "NoAmmo")
    6J02 B 0 A_PlaySoundEx("weapons/mm5/napalmbombfire", "Weapon")
    6J02 B 0 A_FireCustomMissile("NegaNapalmBomb", 0, 1, 0, 0)
    6J02 CD 4
    6J02 B 10
    6J02 B 0 A_ReFire
    goto ReadyX

   NoAmmo:
    6J02 B 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6J02 B 0 A_GiveInventory("NegaMM5_Ammo", 28)
    goto ReadyX
  }
}

actor NegaNapalmProtect : PowerProtection {powerup.duration 5 Damagefactor "NegaNapalmBomb", 0.7}

actor NegaNapalmBomb : BasicProjectile {
  DeathSound "weapon/crashland"
  DamageType "NapalmBomb"  // NegaNapalmBomb
  Obituary "%o refused to be %k's mailman."
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +HITTRACER
  ReactionTime 19
  Damage (50)
  Radius 16
  Height 16
  Speed 25
  Scale 2.5
  States {
   Spawn:
    X_5G A 0
    X_5G A 0 ThrustThingZ(0, 25, 0, 1)
    X_5G A 0 ThrustThing(0, 0, 1, 0)
   SpawnL:
    X_5G ABCD 1
    loop

   Crash:
   XDeath:
    TNT1 A 0 A_SpawnItemEx("NegaNapalmBombSticky", 0, 0, 0, 0, 0, 0, 0, 1 + SXF_TRANSFERPOINTERS)  // 1024
    stop

   Death:
    X_5G A 0 A_SetGravity(0.0)
    X_5G A 0 A_CheckFloor("Floor")
    X_5G A 0 A_CheckCeiling("Ceiling")
    TNT1 A 1 A_SpawnItemEx("NegaNapalmBombWall", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Floor:
    TNT1 A 1 A_SpawnItemEx("NegaNapalmBombGF", 0, 0, 8, 0, 0, 0, 0, 1)
    stop
   Ceiling:
    TNT1 A 1 A_SpawnItemEx("NegaNapalmBombGF", 0, 0, -2, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaNapalmBombSticky : BasicExplosion {
  Damage (0)
  ReactionTime 20
  Scale 2.5
  Args 0, 0, 28
  States {
   Spawn:
    X_5G C 0
    X_5G C 0 ACS_NamedExecuteWithResult("uh_SetPtrCoordToArgs", AAPTR_TRACER)
   Latch:
    X_5G CCCCC 1 A_Warp(AAPTR_TRACER, args[0], args[1], args[2], angle, WARPF_ABSOLUTEOFFSET | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)  // WARPF_COPYINTERPOLATION
    X_5G C 0 A_CountDown
    X_5G C 0 A_JumpIf(!CallACS("core_targetexists", 1), "SuperDeath")
    loop
   Death:
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, 8)
   SuperDeath:
    TNT1 A 1 A_SpawnItemEx("NegaNapalmBombExplode")
    stop
  }
}

actor NegaNapalmBombWall : NegaNapalmBomb {
  DeathSound ""
  +NOGRAVITY
  +NOEXPLODEFLOOR
  +DONTBLAST
  ReactionTime 1
  Speed 0
  States {
   Spawn:
    X_5G C 0
    X_5G C 100
    X_5G C 1 A_Countdown
    wait
   Crash:
   XDeath:
    goto Death
   Death:
    TNT1 A 2 A_SpawnItemEx("NegaNapalmBombExplode", 0, 0, 8)
    stop
  }
}

actor NegaNapalmBombGF : NegaNapalmBombWall {
  States {
   Spawn:
    X_5G A 0
    X_5G A 100
    X_5G A 1 A_Countdown
    wait
  }
}


actor NegaNapalmBombExplode : BasicExplosion {
  DamageType "NapalmBomb"
  Obituary "$OB_NAPALMBOMB"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(160, 128, 0, 0, 32)  // 175
    TNT1 AAA 0 A_SpawnItemEx("NegaNapalm", 0, 0, 4, random(2, 8), 0, random(1, 4), random(0, 359))
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorY", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaNapalm : BasicProjectile {
  Obituary "%o was engulfed by %k's Nega Napalm."
  DamageType "NapalmBomb"  // NegaNapalm
  +RIPPER
  -NOGRAVITY
  +BOUNCEONWALLS
  +BRIGHT
  Args 25, 42  // 32,48
  Damage 0
  Radius 6
  Height 6
  Scale 2.5
  ReactionTime 3
  States {
   Spawn:
    6P10 M 0
    6P10 M 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4))
    6P10 N 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4))
    6P10 O 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4))
    6P10 P 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4))
    6P10 Q 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4))
    6P10 M 0 A_Countdown
    goto Spawn+1
   Death:
    TNT1 A 0 A_CheckFloor("FloorDeath")
    TNT1 A 1
    stop
   FloorDeath:
    TNT1 A 0 A_PlaySound("Pokemon/Bide")
    TNT1 A 0 A_SpawnItemEx("NegaNapalmFloorBit", 0, 0, 2, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
  }
}

actor NegaNapalmFlameFX : BasicGraphicEffect {
  +BRIGHT
  Scale 1.5
  States {
   SpawnFrame:
    6P10 GGHHGG 1 A_Fadeout(0.1)
    stop
  }
}

actor NegaNapalmFloorBit : NegaNapalm {
  +NOEXPLODEFLOOR
  Args 20, 32  // 24,36
  ReactionTime 35
  States {
   Spawn:
    6P10 M 0
    6P10 M 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4), 0, 0, random(2, 5))
    6P10 M 0 A_Countdown
    goto Spawn+1
   Death:
    TNT1 A 0
    stop
  }
}


actor S_NegaNapalmBombExplode : BasicExplosion {
  DamageType "NapalmBomb"
  Obituary "$OB_NAPALMBOMB"
  Args 250, 160, 40
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 AAAA 0 A_SpawnItemEx("S_NegaNapalm", 0, 0, 4, random(2, 8), 0, random(1, 4), random(0, 359))
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorY", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}


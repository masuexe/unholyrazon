    6P10 M 0
    6P10 M 3 A_Explode(args[0], args[1], 0)
    6P10 M 0 A_SpawnItemEx("NegaNapalmFlameFX", random(-4, 4), random(-4, 4), random(-4, 4), 0, 0, random(2, 5), 0, 1)
    6P10 M 0 A_Countdown
    goto Spawn+1
   Death:
    TNT1 A 0
    stop
  }
}

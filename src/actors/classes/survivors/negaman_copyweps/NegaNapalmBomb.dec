  Args 36, 54
  States {
   FloorDeath:
    TNT1 A 0 A_PlaySound("Pokemon/Bide")
    TNT1 A 0 A_SpawnItemEx("S_NegaNapalmFloorBit", 0, 0, 2, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
  }
}


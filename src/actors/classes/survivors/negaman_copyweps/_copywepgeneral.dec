// args[0] = ammo id; args[1] = bar cyan (blue fixed 77 in ACS)
// args[2] > 0 = custom fill max; Tag = Ammo classname (e.g. NegaMM1_Flag)
// Explicit args 0,0,0 clears NormalBar inheritance and keeps args[2] default 0.
// ammo id list:
// 1 ~ 11 - NegaMM1 ~ NegaMM11
// 12 - NegaMMB
// 13 - NegaMMK
// 14 - NegaMMV
// 15 - NegaMMWT
// Inverting probe used by the Ready cost-0 check: the player always holds exactly
// one, with maxamount 2, so A_JumpIfInventory(token, 0) is false and
// A_JumpIfInventory(token, 1) is true.
actor NegaReadyRef_F : Inventory {Inventory.MaxAmount 2 +INVENTORY.UNDROPPABLE}

actor NegaManBar : NormalBar {args 0, 0, 0}


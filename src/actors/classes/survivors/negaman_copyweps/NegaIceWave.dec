actor S_NegaIceWave : NegaIceWave {
  BounceCount 8
  Speed 35
  ReactionTime 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_CountDown
   Spawn2:
    TNT1 A 2 A_SpawnItemEx("S_NegaIceWaveX", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn
  }
}

actor S_NegaIceWave2 : S_NegaIceWave {
  BounceCount 10
  Speed 40
  ReactionTime 40
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_CountDown
   Spawn2:
    TNT1 A 2 A_SpawnItemEx("S_NegaIceWaveXX", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn
  }
}

actor S_NegaIceWave3 : S_NegaIceWave {
  +LOOKALLAROUND
  +SEEKERMISSILE
  Speed 45
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 5, "Death")
    TNT1 AAAAAAAA 1 A_SpawnItemEx("S_NegaIceWaveXXX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 AA 0 A_SeekerMissile(60, 60, SMF_LOOK | SMF_PRECISE, 256, 11)
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn+1
  }
}

actor S_NegaIceWaveX : NegaIceWave2 {Damage (180)}

actor S_NegaIceWaveXX : S_NegaIceWaveX {
  Damage (240)
  Radius 18
  Height 18
  Scale 3.0
}

actor S_NegaIceWaveXXX : S_NegaIceWaveXX {
  +NOINTERACTION
  Damage (380)
  States {
   Spawn:
    ICWB R 0
    ICWB R 3  // 8
    ICWB R 0 A_SetTics(random(0, 2))
    ICWB R 0 A_ChangeFlag("NOINTERACTION", 0)
    ICWB R 0 A_PlaySoundEx("weapon/icewavespawn", "weapon")
    ICWB STTTTTTTT 3
    goto Death
  }
}

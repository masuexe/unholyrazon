actor NegaIceWaveWep_NegaManBar : NegaManBar {args 8, 206}

actor NegaIceWaveWep : BaseNegaManWep {
  Weapon.AmmoUse 5
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_02_MM8"
  Obituary "$OB_ICEWAVE"
  Tag "$TAG_NegaMan_W8f"
  weapon.ammotype "NegaMM8_Ammo"
  inventory.icon "NEG_ICWV"
  States {
   Spawn:
    6N02 I 6
loop

   Deselect:
    6I02 A 0
    goto DeselectSwap
   Select:
    6I02 A 0
    goto SelectSwap

   Ready:
    6I02 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE8)
   ReadyX:
    6I02 A 0 A_JumpIfNoAmmo("NoAmmo")
    6I02 A 8 A_WeaponReady
    6I02 A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6I02 A 8 A_WeaponReady(4)
    6I02 A 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 A 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto ReadyX

   Fire:
    6I02 A 0 A_JumpIfNoAmmo("NoAmmo")
    6I02 A 0 A_PlaySoundEx("weapons/mm8/icewavefire", "Weapon")
    // 6I02 A 0 A_PlaySoundEx("weapon/mbuster","Weapon")
    6I02 A 0 A_FireCustomMissile("NegaIceWave", 0, 1, 8, 0)
    6I02 CBAA 4
    6I02 A 0 A_Refire
    Goto ReadyX

   NoAmmo:
    6I02 A 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6I02 A 0 A_GiveInventory("NegaMM8_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaIceWave : BasicProjectile {
  Translation "192:192=205:205", "199:199=77:77"
  +DONTREFLECT
  +SKYEXPLODE
  +HEXENBOUNCE
  +DONTSPLASH
  +THRUGHOST
  +THRUACTORS
  BounceFactor 1.0
  WallBounceFactor 1.0
  BounceCount 5
  Damagetype "IceWave"
  Obituary "$OB_ICEWAVE"
  Radius 15
  Height 15
  damage (0)
  speed 28
  scale 2.5
  Reactiontime 24  // 13
  var int user_NoTranslation;
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_CountDown
   Spawn2:
    TNT1 A 2 A_SpawnItemEx("NegaIceWave2", 0, 0, 0, 0, 0, 0, 0, 1)
    Goto Spawn
   Death:
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    stop
  }
}

actor NegaIceWave2 : BasicProjectile {
  +DONTBLAST
  -RIPPER
  Damagetype "IceWave"
  Obituary "$OB_ICEWAVE"
  Radius 15
  Height 15
  Damage (97)
  Scale 2.5
  States {
   Spawn:
    ICWB R 0
    ICWB R 0 A_SpawnItemEx("IcePitFreeze")
    ICWB R 0 A_PlaySoundEx("weapon/icewavespawn", "weapon")
    ICWB RSTTT 3
    Goto Death
   Death:
    TNT1 A 0 A_PlaySound("weapon/icewavebreak", 1, 1.0)
    TNT1 AAAAA 0 A_SpawnItemEx("NegaIceWaveBitFX", Random(-16, 16), Random(-16, 16), Random(-16, 16), Random(-4, 4), Random(-4, 4), Random(2, 8), 0, 1)
    TNT1 A 0
    stop
  }
}

actor NegaIceWaveBitFX {
  scale 2.5
  +NOINTERACTION
  +DONTSPLASH
  +CLIENTSIDEONLY
  Gravity 0.75
  Damage (0)
  height 2
  radius 2
  States {
   Spawn:
    TNT1 A 1
    TNT1 A 0 A_Jump(256, "U", "V", "W", "X")
   U:
    ICWB U 0 ThrustThingZ(0, 4, 1, 1)
    ICWB U 1 A_FadeOut
    loop
   V:
    ICWB V 0 ThrustThingZ(0, 4, 1, 1)
    ICWB V 1 A_FadeOut
    loop
   W:
    ICWB W 0 ThrustThingZ(0, 4, 1, 1)
    ICWB W 1 A_FadeOut
    loop
   X:
    ICWB X 0 ThrustThingZ(0, 4, 1, 1)
    ICWB X 1 A_FadeOut
    loop
  }
}


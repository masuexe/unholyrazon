Actor SNBarrier_PU : Powerup { powerup.duration -1 }
Actor SNBarrier_PU2 : Powerup { powerup.duration -2 }
Actor SNBarrier_PU3 : Powerup { powerup.duration -3 }

Actor S_NegaSkullBoost_P : NegaSkullBoost_P {
	States {
	 Pickup:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIf(z-floorz==0, "Ground")
	  goto Air
	 Ground:
	  TNT1 A 0 A_ChangeVelocity(10, 0, 0, CVF_RELATIVE)
	  stop
	 Air:
	  TNT1 A 0 A_ChangeVelocity(5, 0, 0, CVF_RELATIVE)
	  stop
	}
}

Actor S_NegaSkullBoost_P2 : S_NegaSkullBoost_P {
	States {
	 Pickup:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIf(z-floorz==0, "Ground")
	  goto Air
	 Ground:
	  TNT1 A 0 A_ChangeVelocity(12, 0, 0, CVF_RELATIVE)
	  stop
	 Air:
	  TNT1 A 0 A_ChangeVelocity(6, 0, 0, CVF_RELATIVE)
	  stop
	}
}

Actor S_NegaSkullBoost_P3 : S_NegaSkullBoost_P {
	States {
	 Pickup:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIf(z-floorz==0, "Ground")
	  goto Air
	 Ground:

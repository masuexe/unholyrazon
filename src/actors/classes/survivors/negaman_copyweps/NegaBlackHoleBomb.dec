actor NegaBlackHoleBombWep_NegaManBar : NegaManBar {args 9, 62}

actor NegaBlackHoleBombWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_02_MM9"
  Obituary "$OB_BLACKHOLEBOMB"
  Tag "$TAG_NegaMan_W9h"
  Weapon.AmmoType "NegaMM9_Ammo"
  Inventory.Icon "NEG_BHOB"
  States {
   Spawn:
    6N02 J 0
    goto SpawnFrame

   Deselect:
    6I02 D 0
    goto DeselectSwap
   Select:
    6I02 D 0
    goto SelectSwap

   Ready:
    6I02 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE9)
   ReadyX:
    6I02 D 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 1))
    6I02 D 0 A_JumpIfInventory("NegaMM9_Ammo", args[4], "ReadyHave")
    6I02 D 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6I02 D 8 A_WeaponReady
    6I02 D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6I02 D 8 A_WeaponReady(4)
    6I02 D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 D 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 1))
    6I02 D 0 A_JumpIfInventory("NegaMM9_Ammo", args[4], "ReadyX")
    6I02 D 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6I02 D 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 1), "NoAmmo")
    6I02 D 0 A_GiveInventory("NegaBlackHoleBomb_Fire_P")
    6I02 EFD 2
    6I02 D 0 A_ReFire
    goto ReadyX

   NoAmmo:
    6I02 D 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6I02 D 0 A_GiveInventory("NegaMM9_Ammo", 28)
    goto ReadyX
  }
}

actor NegaBlackHoleBomb_Fire_P : CustomInventory {
  States {
   Pickup:
    6I02 D 0 A_PlaySoundEx("weapon/blackholebombC", "Weapon")
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7, 8, 9)
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb1", random(-4, 4), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb2", random(-3, 3), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb3", random(-4, 4), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb4", random(-4, 4), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb5", random(-2, 2), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb6", random(-4, 4), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb7", random(-3, 3), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb8", random(-1, 1), 1, 8, 0) stop
    TNT1 A 0 A_FireCustomMissile("NegaBlackHoleBomb", random(-2, 2), 1, 8, 0) stop
  }
}


actor NegaBlackHoleBomb : BasicProjectile {
  Translation "192:192=59:59", "198:198=62:62"
  DamageType "BlackHoleBomb"
  Obituary "$OB_BLACKHOLEBOMB"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (100)
  Radius 10
  Height 10
  Speed 26
  Scale 1.25
  var int user_NoClassTranslation;
  States {
   Spawn:
    TNT1 A 1
    X_9H BBCCDDEE 1 A_SpawnItemEx("NegaBlackHoleBombFX", 0, random(-2, 2), random(-2, 2), random(-1, -4), random(-2, 2), random(-2, 2), 0, 1)
    goto Spawn+1
  }
}

actor NegaBlackHoleBomb1 : NegaBlackHoleBomb {Translation "192:192=205:205", "198:198=206:206" Speed 30}
actor NegaBlackHoleBomb2 : NegaBlackHoleBomb {Translation "192:192=58:58", "198:198=60:60" Speed 28}
actor NegaBlackHoleBomb3 : NegaBlackHoleBomb {Translation "192:192=39:39", "198:198=40:40" Damage (120)}
actor NegaBlackHoleBomb4 : NegaBlackHoleBomb {Translation "192:192=225:225", "198:198=227:227" Radius 12 Height 12 Scale 1.5}
actor NegaBlackHoleBomb5 : NegaBlackHoleBomb {Translation "192:192=229:229", "198:198=230:230" Damage (110) Speed 22}
actor NegaBlackHoleBomb6 : NegaBlackHoleBomb {Translation "192:192=104:104", "198:198=111:111" Damage (110) Radius 11 Height 11 Speed 28 Scale 1.5}
actor NegaBlackHoleBomb7 : NegaBlackHoleBomb {Translation "192:192=103:103", "198:198=116:116" Speed 24}
actor NegaBlackHoleBomb8 : NegaBlackHoleBomb {Translation "192:192=205:205", "198:198=77:77" Speed 32}

actor NegaBlackHoleBombFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 1.5
  States {
   Spawn:
    X_9H TSRRR 3
    stop
  }
}


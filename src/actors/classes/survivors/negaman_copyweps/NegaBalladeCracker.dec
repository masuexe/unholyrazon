actor NegaBalladeCrackerWep_NegaManBar : NegaManBar {args 13, 64}

actor NegaBalladeCrackerWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 7
  Inventory.Pickupmessage "$PU_02_MMK"
  Obituary "$OB_BALLADECRACKER"
  Tag "$TAG_NegaMan_WKc"
  Weapon.AmmoType "NegaMMK_Ammo"
  Inventory.Icon "NEG_BALL"
  States {
   Spawn:
    6N02 M 0
    goto SpawnFrame

   Deselect:
    6I02 M 0
    goto DeselectSwap
   Select:
    6I02 M 0
    goto SelectSwap

   Ready:
    6I02 M 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYEK)
   ReadyX:
    6I02 M 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 5))
    6I02 M 0 A_JumpIfInventory("NegaMMK_Ammo", args[4], "ReadyHave")
    6I02 M 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6I02 M 8 A_WeaponReady
    6I02 M 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6I02 M 8 A_WeaponReady(4)
    6I02 M 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 M 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 5))
    6I02 M 0 A_JumpIfInventory("NegaMMK_Ammo", args[4], "ReadyX")
    6I02 M 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6I02 M 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 5), "NoAmmo")
    6I02 M 0 A_PlaySoundEx("weapon/crackerthrow", "Weapon")
    6I02 M 0 A_TakeInventory("VivifyDelay8", 1)
    6I02 M 0 A_FireCustomMissile("NegaBalladeCracker", 0, 1, 8, 0)
    6I02 N 2
    6I02 O 0 A_JumpIfInventory("IsBot", 1, "BotFireL")
    goto FireL
   FireL:
    6I02 O 1 A_JumpIfInventory("VivifyDelay8", 1, "FireEnd")
    6I02 O 0 A_ReFire("FireL")
    goto FireEnd
   BotFireL:
    6I02 O 0 A_Jump(9, "FireEnd")
    6I02 O 1 A_JumpIfInventory("VivifyDelay8", 1, "FireEnd")
    6I02 O 0 A_ReFire("BotFireL")
    goto FireEnd
   FireEnd:
    6I02 M 0 A_GiveInventory("VivifyDelay8")
    6I02 NM 2
    goto ReadyX

   NoAmmo:
    6I02 M 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6I02 M 0 A_GiveInventory("NegaMMK_Ammo", 28)
    goto ReadyX
  }
}


actor NegaBalladeCracker : BasicProjectile {
  DamageType "NegaBalladeCracker"
  Obituary "$OB_BALLADECRACKER"
  +FORCEXYBILLBOARD
  +EXPLODEONWATER
  ReactionTime 1
  Damage (10)
  Radius 10
  Height 12
  Speed 35
  Scale 2.5
  States {
   Spawn:
    X_KC A 0
    X_KC AB 2
    X_KC CCDDAABB 1 A_JumpIfInTargetInventory("VivifyDelay8", 1, "Spawn2")
    goto Spawn+3
   Spawn2:
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 0, 0, 35, 0, 1, 0, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 0, 0, 35, 0, 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 0, 0, 35, 0, -3, 0, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 8, 0, 35, 0, 1, 15, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, -8, 0, 35, 0, 1, -15, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 8, 8, 35, 0, 4, 10, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, -8, 8, 35, 0, 4, -10, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, 8, -8, 35, 0, -2, 10, 1)
    TNT1 A 0 A_SpawnItemEx("NegaBalladeCracker2", 0, -8, -8, 35, 0, -2, -10, 1)
    TNT1 A 1 A_CountDown
    wait
   Death:
    TNT1 A 0 A_GiveToTarget("VivifyDelay8", 1)
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
    TNT1 A 0 A_PlaySoundEx("DuckHunt/Boom", "Body")
    TNT1 A 0 A_Explode(150, 144, 0, 0, 16)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaBalladeCracker2 : NegaBalladeCracker {
  -NOGRAVITY
  Radius 6
  Height 7
  Scale 3.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 4, 0, 1)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    X_KC IJKL 2
    goto Spawn+3
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_Explode(75, 96, 0, 0, 8)
    TMFX ABC 1 Bright
    stop
  }
}


actor SNC_Pickup : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(16, "Yes")
    stop
   Yes:
    TNT1 A 0 A_GiveInventory("VivifyDelay8")
    stop
  }
}

actor SNC_Pickup2 : SNC_Pickup {
  States {
   Pickup:
    TNT1 A 0 A_Jump(8, "Yes")
    stop
  }
}

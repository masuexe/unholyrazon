actor NegaSparkChaserWep_NegaManBar : NegaManBar {args 14, 198}

actor NegaSparkChaserWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Obituary "%k hunted down %o relentlessly with their Nega Spark Chaser."
  Tag "$TAG_NegaMan_WVc"
  Inventory.Pickupmessage "$PU_SPARKCHASER"  // Power Up! Nega Spark Chaser!
  weapon.ammotype "NegaMMV_Ammo"
  inventory.icon "NEG_SCHS"
  States {
   Spawn:
    6N02 N 0
    goto SpawnFrame
   Deselect:
    6K02 F 0
    goto DeselectSwap
   Select:
    6K02 F 0
    goto SelectSwap

   Ready:
    6K02 F 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYEVA)
   ReadyX:
    6K02 F 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6K02 F 0 A_JumpIfInventory("NegaMMV_Ammo", Args[4], "ReadyHave")
    6K02 F 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6K02 F 8 A_WeaponReady
    6K02 F 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6K02 F 8 A_WeaponReady(4)
    6K02 F 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6K02 F 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6K02 F 0 A_JumpIfInventory("NegaMMV_Ammo", Args[4], "ReadyX")
    6K02 F 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6K02 F 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "NoAmmo")
    6K02 F 0 A_PlaySoundEx("weapon/sparkchaser", "Weapon")
    6K02 F 0 A_FireCustomMissile("NegaSparkChaser", 0, 1, 8, 0)
    6K02 GH 3
    6K02 F 14
    6K02 F 0 A_Refire
    Goto ReadyX

   NoAmmo:
    6K02 F 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6K02 F 0 A_GiveInventory("NegaMMV_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaSparkChaser : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  Obituary "%k's Nega Spark Chaser found %o."
  damagetype "NegaSparkChaser"
  +SEEKERMISSILE
  +FORCEXYBILLBOARD
  +RIPPER
  +BRIGHT
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  BounceFactor 1.0
  WallBounceFactor 1.0
  BounceCount 8
  reactiontime 10
  damage ((Args[4]!=0)*60)
  Radius 12
  Height 12
  speed 40
  scale 2.5
  Args 40, 0, 12, 8, 0  // spd,momz(?),home aggro,home turn,dmg 1/0
  States {
   Spawn:
    X_VA B 0
    X_VA BBBBBBBBAABB 1 A_SpawnItemEx("NegaSparkChaserTrail_H", 0, 0, 0, momx/Args[0], momy/Args[0], momz/Args[0], 0, 1+8)
    X_VA B 0 A_Countdown
    goto Spawn2
   Spawn2:
    X_VA C 0 A_SetArg(4, 1)
    X_VA C 0 A_PlaySoundEx("weapon/sparkchaserchase", "Body")
    X_VA C 0 A_JumpIfInventory("CutterFlag", 6, "SpawnNeutral")
    X_VA C 0 A_SeekerMissile(Args[2], Args[3], SMF_LOOK, 256, 7)
    X_VA CC 1 A_SpawnItemEx("NegaSparkChaserTrail_H", 0, 0, 0, momx/Args[0], momy/Args[0], momz/Args[0], 0, 1+8)
    X_VA C 0 A_SetArg(2, Args[2]+3)
    X_VA C 0 A_SetArg(3, Args[2]+2)
    X_VA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn2+2
   SpawnNeutral:
    X_VA C 0 A_SetArg(4, 0)
    X_VA C 0 A_TakeInventory("CutterFlag")
    X_VA C 0 A_Countdown
    X_VA C 0 A_SetArg(2, 12)
    X_VA C 0 A_SetArg(3, 8)
    X_VA C 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_NULL)
    goto Spawn+1
   Death:
    TNT1 A 0
    stop
  }
}

actor NegaSparkChaserTrail_H : BasicGraphicEffect {
  Speed 1
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("NegaSparkChaserTrail", 0, 0, 0, 0, 0, 0, 0, 1+8)
    TNT1 A 0 A_SpawnItemEx("NegaSparkChaserTrail", sqrt(momx*momx+momy*momy)*40*1/3, 0, momz*40*1/3, 0, 0, 0, 0, 1+8)
    TNT1 A 0 A_SpawnItemEx("NegaSparkChaserTrail", sqrt(momx*momx+momy*momy)*40*2/3, 0, momz*40*2/3, 0, 0, 0, 0, 1+8)
    stop
  }
}

actor NegaSparkChaserTrail : SparkChaserTrail {
  States {
   Spawn:
    X_VA C 0
    X_VA C 10
    stop
  }
}


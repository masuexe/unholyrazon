actor S_NegaSparkChaser : NegaSparkChaser {
  damage ((Args[4] != 0) * 85)
  Args 40, 0, 12, 8, 0
}
actor S_NegaSparkChaser2 : S_NegaSparkChaser {
  Bouncecount 10
  damage ((Args[4] != 0) * 100)
  Reactiontime 10
  Args 40, 0, 15, 10, 0
}


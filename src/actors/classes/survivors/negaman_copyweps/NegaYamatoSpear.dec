actor NegaYamatoSpearWep_NegaManBar : NegaManBar {args 6, 236}

actor NegaYamatoSpearWep : BaseNegaManWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  +WEAPON.NOAUTOAIM
  Weapon.SlotNumber 3
  Inventory.Pickupmessage "$PU_02_MM6z"
  Obituary "$OB_YAMATOSPEAR"
  Tag "$TAG_NegaMan_W6h"
  weapon.ammotype "NegaMM6_Ammo"
  inventory.icon "NEG_YAMA"
  States {
   Spawn:
    6N02 G 6
loop

   Deselect:
    6J02 E 0
    goto DeselectSwap
   Select:
    6J02 E 0
    goto SelectSwap

   Ready:
    6J02 E 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE6H)
    6J02 E 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 E 8 A_WeaponReady
    6J02 E 0 A_GiveInventory("NegaMM6_Ammo", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6J02 E 8 A_WeaponReady(4)
    6J02 E 0 A_GiveInventory("NegaMM6_Ammo", 1)
    6J02 E 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    goto ReadyX

   Fire:
   Hold:
    6J02 E 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 E 0 A_PlaySoundEx("weapon/CutterCatch", "Weapon")
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", 0, 0, 8, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", (random(1, 3)*2-1)*random(1, 2), 0, 8, 0)
    6J02 FG 2
    6J02 E 1
    6J02 E 0 A_PlaySoundEx("weapon/CutterCatch", "Weapon")
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", 3, 0, 8, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", (random(1, 3)*2-1)*random(1, 2)+3, 0, 8, 0)
    6J02 FG 2
    6J02 E 1
    6J02 E 0 A_PlaySoundEx("weapon/CutterCatch", "Weapon")
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", -3, 0, 8, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpear", (random(-1, -3)*2-1)*random(1, 2)-3, 1, 8, 0)
    6J02 FG 2
    6J02 E 1
    6J02 E 0 A_Refire
    6J02 E 15
    6J02 E 0 A_PlaySoundEx("Pokemon/HornAttack", "Weapon")
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpearX", 0, 0, 8, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpearX", 0, 0, 38, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpearX", 0, 0, 58, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpearX", 0, 0, -22, 0)
    6J02 E 0 A_FireCustomMissile("NegaYamatoSpearX", 0, 0, -42, 0)
    6J02 FG 3
    6J02 E 6
    goto ReadyX

   NoAmmo:
    6J02 E 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 E 0 A_GiveInventory("NegaMM6_Ammo", 28)
    goto ReadyX
  }
}

actor NegaYamatoSpear : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  damagetype "YamatoSpear"
  Obituary "$OB_YAMATOSPEAR"
  +RIPPER
  damage (38)
  Radius 6
  Height 7
  speed 35
  scale 2.0
  States {
   Spawn:
    X_6H A 6
    stop
   Death:
    X_3A BCD 1
    stop
  }
}

actor NegaYamatoSpearX : NegaYamatoSpear {
  +RIPPER
  damage (60)
  Radius 10
  Height 13
  Speed 60
  scale 3.5
  States {
   Spawn:
    X_6H A 0
    X_6H A 4
    X_6H A 8 A_ScaleVelocity(0.0)
    stop
  }
}

actor PowerNegaYamatoSpearProtect : PowerProtection {powerup.duration 3  damagefactor "NegaYamatoSpear", 0.6}

/// //////////////////////////
// == Shiny ==//
/// //////////////////////////

actor S_NegaYamatoSpear : NegaYamatoSpear {
  damage (62)
  speed 40
}

actor S_NegaYamatoSpearX : NegaYamatoSpearX {
  damage (94)
  Radius 9
  Height 12
  Speed 70
}

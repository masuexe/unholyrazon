actor NegaGravityHoldWep_NegaManBar : NegaManBar {args 5, 239}

actor NegaGravityHoldWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM5"
  Obituary "$OB_GRAVITYHOLD"
  Tag "$TAG_NegaMan_W5a"
  weapon.ammotype "NegaMM5_Ammo"
  inventory.icon "NEG_GRAV"
  States {
   Spawn:
    6N02 F 0
    goto SpawnFrame

   Deselect:
    6H02 P 0
    goto DeselectSwap
   Select:
    6H02 P 0
    goto SelectSwap

   Ready:
    6H02 P 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE5)
   ReadyX:
    6H02 P 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6H02 P 0 A_JumpIfInventory("NegaMM5_Ammo", Args[4], "ReadyHave")
    6H02 P 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6H02 P 8 A_WeaponReady
    6H02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6H02 P 8 A_WeaponReady(4)
    6H02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6H02 P 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6H02 P 0 A_JumpIfInventory("NegaMM5_Ammo", Args[4], "ReadyX")
    6H02 P 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6H02 P 0 A_JumpIf(!CallACS("uh_NegaCanSpendAmmo", 2), "NoAmmo")
    6H02 Q 1
    6H02 R 2 A_PlaySoundEx("weapon/gravityhold", "Weapon")
    goto FireL
   FireL:
    6H02 R 0 A_JumpIf(!CallACS("uh_NegaCanSpendAmmo", 2), "NoAmmo")
    6H02 R 1 A_GiveInventory("NegaGravityHold_P")
    6H02 R 0 A_ReFire("FireL")
    goto FireEnd
   FireEnd:
    6H02 Q 2
    6H02 Q 0 A_TakeInventory("NegaGHoldCooldown")
    6H02 Q 0 A_TakeInventory("NegaGHoldCooldownR")
    6H02 Q 3
    6H02 P 5
    Goto ReadyX

   NoAmmo:
    6H02 P 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6H02 P 0 A_GiveInventory("NegaMM5_Ammo", 28)
    Goto ReadyX
  }
}


actor NegaGHoldCooldown : PowerSpeed{powerup.duration 20 Speed 1.5}
actor NegaGHoldCooldownR : PowerSpeed{powerup.duration 10 Speed 2.0}

actor NegaGravityHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("NegaGravityHoldHelper", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "Pickup2R")
    goto Pickup2
   Pickup2:
    TNT1 A 0 ThrustThingZ(0, 3, 0, 0)
    TNT1 A 0 A_JumpIfInventory("NegaGHoldCooldown", 1, "End")
    goto PickupX
   Pickup2R:
    TNT1 A 0 ThrustThingZ(0, 5, 0, 0)
    TNT1 A 0 A_JumpIfInventory("NegaGHoldCooldownR", 1, "End")
    goto PickupXR

   PickupX:
    TNT1 A 0 A_GiveInventory("NegaGHoldCooldown")
    goto PickupFire
   PickupXR:
    TNT1 A 0 A_GiveInventory("NegaGHoldCooldownR")
    goto PickupFire

   PickupFire:
    TNT1 A 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "End")
    TNT1 A 0 A_SpawnItemEx("NegaGravityHold", 0, 0, 28)
    stop

   End:
    TNT1 A 0
    stop
  }
}

actor NegaGravityHold : BasicExplosion {
  Translation "192:192=205:205", "198:198=77:77"
  damagetype "Nega_GHold"
  Obituary "$OB_GRAVITYHOLD"
  +OLDRADIUSDMG
  Args 100, 256, 32
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("NegaGravityHoldFX", random(-72, 72), random(-72, 72), random(-48, 48), 0, 0, random(2, 3))
    TNT1 A 4 A_Explode(Args[0]*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*2), Args[1], 0, 0, Args[2])
    stop
  }
}

actor NegaGravityHoldHelper : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("NegaGravityHoldFX", random(-72, 72), random(-72, 72), random(-48, 48), 0, 0, random(2, 3))
    stop
  }
}

actor NegaGravityHoldFX : BasicGraphicEffect {
  +BRIGHT
  States {
   SpawnFrame:
    X_5A A 1 A_Fadeout(0.15)
    wait
  }
}

/////////////////////////////
//== Shiny ==//
/////////////////////////////

actor S_NegaGravityHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/gravityhold", "Weapon")
    TNT1 A 0 A_SpawnItemEx("NegaGravityHoldHelper")
    TNT1 A 0 A_SpawnItemEx("S_NegaGravityHold", 0, 0, 28)
    TNT1 A 0 A_SpawnItemEx("GravityHold2U", 0, 0, 28)
    stop
  }
}

Actor S_NegaGravityHold : NegaGravityHold{ Args 180, 384, 48 }

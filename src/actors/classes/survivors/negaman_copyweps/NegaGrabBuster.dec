actor NegaGrabBusterWep_NegaManBar : NegaManBar {args 12, 4}

actor NegaGrabBusterWep : BaseNegaManWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Obituary "$OB_GRABBUSTER"
  Tag "Nega Grab Buster"
  Inventory.Pickupmessage "$PU_GRABBUSTER"  // Power Up! Nega Grab Buster!
  weapon.ammotype "NegaMMV_Ammo"
  inventory.icon "NEG_GRBB"
  States {
Deselect:
    6K02 I 0
    goto DeselectSwap
   Select:
    6K02 I 0
    goto SelectSwap

   Ready:
    6K02 I 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYEVB)
   ReadyX:
    6K02 I 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 I 8 A_WeaponReady
    6K02 I 0 A_GiveInventory("NegaMMV_Ammo", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6K02 I 8 A_WeaponReady(4)
    6K02 I 0 A_GiveInventory("NegaMMV_Ammo", 1)
    6K02 I 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    goto ReadyX

   Fire:
    6K02 I 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 I 0 A_PlaySoundEx("weapon/grabbuster", "Weapon")
    6K02 I 0 A_FireCustomMissile("NegaGrabBuster", 0, 1, 8, 0)
    6K02 JK 3
    6K02 I 8
    6K02 I 0 A_Refire
    goto ReadyX

   NoAmmo:
    6K02 I 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6K02 I 0 A_GiveInventory("NegaMMV_Ammo", 28)
    goto ReadyX
  }
}

actor NegaGrabBuster : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77", "202:202=77:77", "199:199=252:252"
  Obituary "%k's Nega Grab Buster turned %o's energy against them."
  Damagetype "GrabBuster"
  +FORCEXYBILLBOARD
  +HITTRACER
  +BRIGHT
  Damage (0)
  height 10
  radius 10
  Reactiontime 12
  Speed 30
  Scale 2.5
  States {
   Spawn:
    X_VB A 2
   SpawnLoop:
    X_VB BCDC 2 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, 1)
    loop
   XDeath:
    X_VB A 0 A_Explode(180, 28, 0, 0, 28)
    X_VB A 0 A_JumpIfInventory("CanBeGrabBustered", 1, "AreThereTeams", AAPTR_TRACER)
    stop
   AreThereTeams:
    X_VB A 0 A_JumpIf(CallACS("core_checkmode", 1), "TeamCheck")
    X_VB A 0 A_JumpIfInventory("PowerProtectSurvivor", 1, "Failed", AAPTR_TRACER)
    X_VB A 0 A_Jump(256, "DeathChase")
    goto DeathChase
   TeamCheck:
    X_VB A 0 A_JumpIfInventory("LightTeamFlag", 1, "LightCheck", AAPTR_TARGET)
    X_VB A 0 A_JumpIfInventory("WilyTeamFlag", 1, "WilyCheck", AAPTR_TARGET)
    X_VB A 0 A_JumpIfInventory("CossackTeamFlag", 1, "CossackCheck", AAPTR_TARGET)
    X_VB A 0 A_JumpIfInventory("KingTeamFlag", 1, "KingCheck", AAPTR_TARGET)
    X_VB A 0 A_Jump(256, "DeathChase")
    goto DeathChase
   LightCheck:
    X_VB A 0 A_JumpIfInventory("LightTeamFlag", 1, "Failed", AAPTR_TRACER)
    X_VB A 1 A_JumpIf(true, "DeathChaseJump")
    wait
   WilyCheck:
    X_VB A 0 A_JumpIfInventory("WilyTeamFlag", 1, "Failed", AAPTR_TRACER)
    X_VB A 1 A_JumpIf(true, "DeathChaseJump")
    wait
   CossackCheck:
    X_VB A 0 A_JumpIfInventory("CossackTeamFlag", 1, "Failed", AAPTR_TRACER)
    X_VB A 1 A_JumpIf(true, "DeathChaseJump")
    wait
   KingCheck:
    X_VB A 0 A_JumpIfInventory("KingTeamFlag", 1, "Failed", AAPTR_TRACER)
    X_VB A 1 A_JumpIf(true, "DeathChaseJump")
    wait
   DeathChaseJump:
    X_VB A 0 A_Jump(256, "DeathChase")
    goto DeathChase
   Failed:
    TNT1 A 0
    stop
   Death:
    TNT1 A 0 A_Explode(100, 64, 0)
    TNT1 A 1
    stop
   DeathChase:
    X_VB A 0 A_SpawnItemEx("NegaGrabBusterChaser", 0, 0, 0, 28, 0, 0, 0, 1+SXF_TRANSFERPOINTERS)
    TNT1 A 1
    stop
  }
}

Actor NegaGrabBusterChaser : NegaGrabBuster {
  +RIPPER
  +THRUACTORS
  +SEEKERMISSILE
  +LOOKALLAROUND
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +DONTSPLASH
  +CANBOUNCEWATER
  Bouncecount 4
  Args 40
  Radius 8
  Height 8
  Speed 28
  Scale 3.0
  States {
   Spawn:
    Y_VB B 0
    Y_VB B 0 A_Explode(Args[0], 64, 0)
    Y_VB BB 0 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, 1)
    Y_VB B 0 ACS_NamedExecuteAlways("core_lookatptr", 0, AAPTR_TRACER)
    Y_VB B 2 A_ChangeVelocity(cos(pitch)*24, 0, sin(-pitch)*24, CVF_RELATIVE|CVF_REPLACE)
    Y_VB B 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathContinueJump")
    Y_VB B 0 A_Explode(Args[0], 64, 0)
    Y_VB BB 0 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, 1)
    Y_VB C 2
    Y_VB B 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathContinueJump")
    Y_VB B 0 A_Explode(Args[0], 64, 0)
    Y_VB BB 0 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, 1)
    Y_VB B 0 ACS_NamedExecuteAlways("core_lookatptr", 0, AAPTR_TRACER)
    Y_VB D 2
    Y_VB B 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathContinueJump")
    Y_VB B 0 A_Explode(Args[0], 64, 0)
    Y_VB BB 0 A_SpawnItemEx("GrabBusterFXU", 0, frandom(-6, 6), frandom(-6, 6), 0, 0, 0, 0, 1)
    Y_VB C 2
    Y_VB B 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "DeathContinueJump")
    Y_VB BCDC 1 A_ChangeVelocity(cos(pitch)*0, 0, sin(-pitch)*0, CVF_RELATIVE|CVF_REPLACE)
    Y_VB B 0 A_Countdown
    goto Spawn+1
   DeathContinueJump:
    X_VB A 0 A_Jump(256, "DeathContinue")
    goto DeathContinue
   DeathContinue:
    X_VB A 0 A_CustomMissile("NegaGrabBuster2", 0, 0, 0, 2, 0)
    TNT1 A 1
    stop
   Death:
    TNT1 A 0
    stop
  }
}

Actor NegaGrabBuster2 : NegaGrabBuster {
  -SEEKERMISSILE
  -LOOKALLAROUND
  -HITTRACER
  Damage (180)
  States {
   Death:
   XDeath:
    TNT1 A 0
    stop
  }
}

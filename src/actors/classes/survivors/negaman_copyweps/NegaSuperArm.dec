actor NegaSuperArmWep_NegaManBar : NegaManBar {args 1, 220}

actor NegaSuperArmWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM2z"
  Obituary "$OB_SuperArm"
  Tag "$TAG_NegaMan_W1e"
  Weapon.AmmoType "NegaMM1_Ammo"
  Inventory.Icon "NEG_SARM"
  States {
   Spawn:
    6O02 A 0
    goto SpawnFrame

   Deselect:
    6K02 P 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "DeselectThrow")
    goto DeselectSwap
   DeselectThrow:
    6K02 P 0 A_TakeInventory("ZangiefHoldFlag")
    6K02 P 0 A_GiveInventory("NegaSuperArmThrow_P")
    6K02 P 2
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    goto DeselectSwap
   Select:
    6K02 P 0
    goto SelectSwap

   Ready:
    6K02 P 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE2C)
   ReadyX:
    6K02 P 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 3))
    6K02 P 0 A_JumpIfInventory("NegaMM1_Ammo", args[4], "ReadyHave")
    6K02 P 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6K02 P 8 A_WeaponReady
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6K02 P 8 A_WeaponReady(4)
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6K02 P 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 3))
    6K02 P 0 A_JumpIfInventory("NegaMM1_Ammo", args[4], "ReadyX")
    6K02 P 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6K02 P 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "Throw")
   FireX:
    6K02 P 0 A_JumpIf(!CallACS("uh_NegaCanSpendAmmo", 3), "NoAmmo")
    6K02 P 0 A_PlaySoundEx("weapons/mm1/superarmload", "Weapon")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 1, 0, 0, 1, 0)
    6K02 P 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 Q 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 Q 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 R 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 R 0 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 QP 8
    goto ReadyX

   CarryStart:
    6K02 R 0 ACS_NamedExecuteWithResult("uh_NegaSaveCost", 1, 3)
    6K02 R 0 A_JumpIfInventory("PlayerPropertyRage", 1, "CarryStartR")
    6K02 R 1 A_GiveInventory("NegaSuperArmCarryStart_P")
    // uh_ZangiefGrab pitch = 360 - elevation: 330 = 30 deg up, 300 = 60 deg up,
    // 270 = straight overhead. Scoop then lift in small steps so the arm and
    // victim arc match (SuperArm rock height ~76; final dist 64).
    6K02 R 1 Offset(12, 28) A_JumpIf(CallACS("uh_ZangiefGrab", 340, angle * 256 / 360, 100) == 0, "GrabLost")
    6K02 R 1 Offset(26, 13) A_JumpIf(CallACS("uh_ZangiefGrab", 335, angle * 256 / 360, 98) == 0, "GrabLost")
    6K02 R 1 Offset(40, -8) A_JumpIf(CallACS("uh_ZangiefGrab", 330, angle * 256 / 360, 96) == 0, "GrabLost")
    6K02 R 1 Offset(54, -32) A_JumpIf(CallACS("uh_ZangiefGrab", 320, angle * 256 / 360, 90) == 0, "GrabLost")
    6K02 R 1 Offset(68, -56) A_JumpIf(CallACS("uh_ZangiefGrab", 310, angle * 256 / 360, 84) == 0, "GrabLost")
    6K02 R 1 Offset(80, -78) A_JumpIf(CallACS("uh_ZangiefGrab", 300, angle * 256 / 360, 76) == 0, "GrabLost")
    6K02 R 1 Offset(90, -96) A_JumpIf(CallACS("uh_ZangiefGrab", 285, angle * 256 / 360, 70) == 0, "GrabLost")
    6K02 R 1 Offset(98, -110) A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle * 256 / 360, 64) == 0, "GrabLost")
    TNT1 A 1 Offset(98, -110) A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle * 256 / 360, 64) == 0, "GrabLost")
    goto CarryLoop
   CarryStartR:
    6K02 R 0 ACS_NamedExecuteWithResult("uh_NegaSaveCost", 1, 3)
    // Duration-1 frames ignore Rage's double-decrement; play every other
    // lift keyframe so the scoop finishes in about half the normal time.
    6K02 R 1 A_GiveInventory("NegaSuperArmCarryStart_P")
    6K02 R 1 Offset(12, 28) A_JumpIf(CallACS("uh_ZangiefGrab", 340, angle * 256 / 360, 100) == 0, "GrabLost")
    6K02 R 1 Offset(40, -8) A_JumpIf(CallACS("uh_ZangiefGrab", 330, angle * 256 / 360, 96) == 0, "GrabLost")
    6K02 R 1 Offset(68, -56) A_JumpIf(CallACS("uh_ZangiefGrab", 310, angle * 256 / 360, 84) == 0, "GrabLost")
    6K02 R 1 Offset(98, -110) A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle * 256 / 360, 64) == 0, "GrabLost")
    TNT1 A 1 Offset(98, -110) A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle * 256 / 360, 64) == 0, "GrabLost")
    goto CarryLoop
   CarryLoop:
    // Hold_P calls A_WeaponReady, which resets psprite Offset — keep TNT1 here.
    TNT1 A 0 A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle * 256 / 360, 64) == 0, "GrabLost")
    TNT1 A 1 A_GiveInventory("NegaSuperArmHold_P")
    loop

   Throw:
    6K02 R 0 A_TakeInventory("ZangiefHoldFlag")
    // Wind-up from the overhead hold, release as the arm comes forward, then
    // follow through R -> Q -> P (same weight as GutsBuddy / RussianGuts).
    6K02 R 1 Offset(98, -110)
    6K02 R 1 Offset(80, -90)
    6K02 Q 0 A_GiveInventory("NegaSuperArmThrow_P")
    6K02 Q 2 Offset(52, -46)
    6K02 Q 2 Offset(12, -12)
    6K02 Q 2 Offset(-42, 16)
    6K02 P 2 Offset(-84, 48)
    6K02 P 2 Offset(-112, 72)
    6K02 P 2 Offset(-133, 96)
    TNT1 A 10 A_WeaponReady(14)
   ThrowEnd:
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    6K02 P 2 Offset(0, 72)
    6K02 P 2 Offset(0, 52)
    goto ReadyX

   GrabLost:
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    6K02 P 4
    goto ReadyX

   NoAmmo:
    6K02 P 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6K02 P 0 A_GiveInventory("NegaMM1_Ammo", 28)
    goto ReadyX
  }
}

// Explicit acquisition includes protected teammates; friendly grabs deal no damage.
actor NegaSuperArmGrab : BasicFastProjectile {
  DamageType "Suplex"
  Obituary "$OB_SuperArm"
  +DONTBLAST
  +DONTREFLECT
  +FORCEXYBILLBOARD
  +THRUGHOST
  ReactionTime 1
  Damage (10 * (1 - CallACS("uh_ZangiefTryGrab", args[1], 0, 1)))
  Radius 20
  Height 20
  Speed 65
  Scale 2.0
  Args 10, 64, 64
  States {
   Spawn:
    6P51 E 0
    6P51 E 1 A_CountDown
    wait
   Death:
    6P51 E 0 A_JumpIf(CallACS("uh_ZangiefTryGrab", args[1], 0, 1), "GrabFX")
    6P51 E 0 A_Explode(args[0], args[1], 0, true, args[2])
    goto GrabFX
   XDeath:
    6P51 E 0 ACS_NamedExecuteWithResult("uh_ZangiefTryGrab", args[1], 0, 1)
   GrabFX:
    6P51 E 0 A_Stop
    // 6P51 DEFED 2
    stop
  }
}

// Carry start: toggle the grabber stacks. Victim positioning is handled by the
// per-tic uh_SuperArmCarry pull-in in the weapon states (overhead anchor).
// Deliberately no invulnerable/nonshootable here: the carry has no time limit,
// so the grabber must stay killable (Zangief's invuln is balanced by his
// 60-tic hold cap).
actor NegaSuperArmCarryStart_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    stop
  }
}

// Carry tick: hold marker (maxamount 60 caps itself) + weapon ready without the
// Nega slide altfire; switching stays allowed so Deselect can auto-throw.
actor NegaSuperArmHold_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
  }
}

// Release: strip enemy protection, spawn the slam, then hurl the victim along
// the SuperArm Gutrock arc (30 u/tic forward, velz set +5.0).
actor NegaSuperArmThrow_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NegaTrySpendSaved", 1, 0)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)
    TNT1 A 0 A_SpawnItemEx("NegaSuperArmSlam", 0, 0, 0, 0, 0, 0, 0, 1 + 8 + 32)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000, 30, 20)
    stop
  }
}

// Thrown-victim bomb: spawned by the thrower at release (same pointer idiom
// as AtomicBuster, so kills credit the thrower). Instead of exploding on the
// spot it shadows the victim per tic via rz_NegaSuperArmThrowFollow and only
// detonates + plays FX the moment the victim lands. Victims killed or removed
// mid-flight fizzle silently; the flight times out after 210 tics.
actor NegaSuperArmSlam : BasicExplosion {
  DamageType "SuperArm"
  Obituary "$OB_NegaSuperArm"
  +NOTARGETSWITCH
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(0, CallACS("rz_CountInv_SuplexID", 2) - 1 + 1000)
    TNT1 A 0 A_SetArg(1, 210)
    TNT1 A 0 A_SetArg(3, CallACS("uh_NegaSuperArmFriendlyThrow"))
   Fly:
    TNT1 A 1
    TNT1 A 0 A_SetArg(2, CallACS("rz_NegaSuperArmThrowFollow", args[0], 0, args[3]))
    TNT1 A 0 A_JumpIf(args[2] == 1, "Boom")
    TNT1 A 0 A_JumpIf(args[2] == 2, "Vanish")
    TNT1 A 0 A_SetArg(1, args[1] - 1)
    TNT1 A 0 A_JumpIf(args[1] <= 0, "Forced")
    loop
   Forced:
    TNT1 A 0 A_JumpIf(CallACS("rz_NegaSuperArmThrowFollow", args[0], 1, args[3]) == 1, "Boom")
    goto Vanish
   Vanish:
    TNT1 A 0
    stop
   Boom:
    TNT1 A 0 A_JumpIf(args[3], "BoomFX")
    TNT1 A 0 A_Explode(150 * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), 128, 0, false, 64)
   BoomFX:
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/superarmsplit", "Voice")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("GutrockFX", random(-16, 16), random(-16, 16), random(8, 32), random(-10, 10), random(-10, 10), random(5, 10), random(0, 359), 1)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 28, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

// == Shiny == //
// Charge tier is chosen before the grab (base shiny ladder) and carried
// through the carry phase as inventory markers; the throw dispatches on them.
// Shiny throws cost no NegaMM1_Ammo (the held gun runs on the shiny cycle).

actor S_NegaSArmPow2 : Once {}
actor S_NegaSArmPow3 : Once {}

actor S_NegaSuperArmGrab : NegaSuperArmGrab {
  Obituary "%o was grabbed by %k's Shiny Nega Super Arm."
}

actor S_NegaSuperArmSlam2 : NegaSuperArmSlam {
  Obituary "%o was pulverized by %k's Shiny Nega Super Arm."
  States {
   Boom:
    TNT1 A 0 A_JumpIf(args[3], "BoomFX")
    TNT1 A 0 A_Explode(190 * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), 128, 0, false, 64)
   BoomFX:
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/superarmsplit", "Voice")
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("GutrockFX", random(-16, 16), random(-16, 16), random(8, 32), random(-10, 10), random(-10, 10), random(5, 10), random(0, 359), 1)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 28, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

actor S_NegaSuperArmSlam3 : NegaSuperArmSlam {
  Obituary "%o was pulverized by %k's Shiny Nega Super Arm."
  States {
   Boom:
    TNT1 A 0 A_JumpIf(args[3], "BoomFX")
    TNT1 A 0 A_Explode(240 * (1 + CallACS("uh_checkrune", RUNE_SPREAD, 2) * 2), 144, 0, false, 80)
   BoomFX:
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/superarmsplit", "Voice")
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("GutrockFX", random(-16, 16), random(-16, 16), random(8, 32), random(-10, 10), random(-10, 10), random(5, 10), random(0, 359), 1)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 28, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

actor S_NegaSuperArmThrow1_P : NegaSuperArmThrow_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)
    TNT1 A 0 A_SpawnItemEx("NegaSuperArmSlam", 0, 0, 0, 0, 0, 0, 0, 1 + 8 + 32)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000, 30, 20)
    stop
  }
}

actor S_NegaSuperArmThrow2_P : NegaSuperArmThrow_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)
    TNT1 A 0 A_SpawnItemEx("S_NegaSuperArmSlam2", 0, 0, 0, 0, 0, 0, 0, 1 + 8 + 32)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000, 45, 20)
    stop
  }
}

actor S_NegaSuperArmThrow3_P : NegaSuperArmThrow_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000)
    TNT1 A 0 A_SpawnItemEx("S_NegaSuperArmSlam3", 0, 0, 0, 0, 0, 0, 0, 1 + 8 + 32)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID") - 1 + 1000, 60, 20)
    stop
  }
}

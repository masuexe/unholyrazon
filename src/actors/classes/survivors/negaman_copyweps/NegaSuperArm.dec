actor NegaSuperArmWep_NegaManBar : NegaManBar {args 1, 220}

actor NegaSuperArmWep : BaseNegaManWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM2z"
  Obituary "$OB_SuperArm"
  Tag "$TAG_NegaMan_W1e"
  weapon.ammotype "NegaMM1_Ammo"
  inventory.icon "NEG_SARM"
  States {
   Spawn:
    6O02 A 6
    loop

   Deselect:
    6K02 P 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "DeselectThrow")
    goto DeselectSwap
   DeselectThrow:
    6K02 P 0 A_TakeInventory("ZangiefHoldFlag")
    6K02 P 0 A_GiveInventory("NegaSuperArmThrow_P")
    6K02 P 2
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    goto DeselectSwap
   Select:
    6K02 P 0
    goto SelectSwap

   Ready:
    6K02 P 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE2C)
   ReadyX:
    6K02 P 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 P 8 A_WeaponReady
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6K02 P 8 A_WeaponReady(4)
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6K02 P 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto ReadyX

   Fire:
    6K02 P 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "Throw")
   FireX:
    6K02 P 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 P 0 A_PlaySoundEx("weapons/mm1/superarmload", "Weapon")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 1, 0, 0, 1, 0)
    6K02 P 1 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 P 1 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 P 1 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 P 1 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 P 1 A_JumpIfInventory("SuplexID", 1, "CarryStart")
    6K02 P 0 A_Refire("FireX")
    Goto ReadyX

   CarryStart:
    6K02 P 1 A_GiveInventory("NegaSuperArmCarryStart_P")
    // uh_ZangiefGrab pitch = 360 - elevation: 330 = 30 deg up, 300 = 60 deg up,
    // 270 = straight overhead. Pull the victim up over the head like the
    // SuplexGroundHold does, ending at dist 64 (SuperArm rock height ~76).
    6K02 P 1 A_JumpIf(CallACS("uh_ZangiefGrab", 330, angle*256/360, 96)==0, "GrabLost")
    6K02 P 1 A_JumpIf(CallACS("uh_ZangiefGrab", 300, angle*256/360, 84)==0, "GrabLost")
   CarryLoop:
    6K02 P 0 A_JumpIf(CallACS("uh_ZangiefGrab", 270, angle*256/360, 64)==0, "GrabLost")
    6K02 P 1 A_GiveInventory("NegaSuperArmHold_P")
    loop

   Throw:
    6K02 P 0 A_TakeInventory("ZangiefHoldFlag")
    6K02 P 0 A_GiveInventory("NegaSuperArmThrow_P")
    6K02 P 2
   ThrowEnd:
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    6K02 P 6
    goto ReadyX

   GrabLost:
    6K02 P 0 A_GiveInventory("ZangiefResetFlags_P")
    6K02 P 4
    goto ReadyX

   NoAmmo:
    6K02 P 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6K02 P 0 A_GiveInventory("NegaMM1_Ammo", 28)
    Goto ReadyX
  }
}

// Grab bolt: a hit on a player feeds the shared Pain.Suplex -> PainSuplexHit ->
// SuplexID pipeline (victim TID = SuplexID-1+1000); a miss explodes as a small poke.
actor NegaSuperArmGrab : BasicFastProjectile {
  damagetype "Suplex"
  Obituary "$OB_SuperArm"
  +DONTBLAST
  +DONTREFLECT
  +FORCEXYBILLBOARD
  +THRUGHOST
  reactiontime 1
  damage (10)  // 50
  Radius 20
  Height 20
  speed 65
  scale 2.0
  Args 10, 64, 64
  States {
   Spawn:
    6P51 E 0
    6P51 E 1 A_CountDown
    wait
   Death:
    6P51 E 0 A_Explode(Args[0], Args[1], 0, true, Args[2])
    goto XDeath
   XDeath:
    6P51 E 0 A_Stop
    // 6P51 DEFED 2
    stop
  }
}

// Carry start: toggle the grabber stacks. Victim positioning is handled by the
// per-tic uh_SuperArmCarry pull-in in the weapon states (overhead anchor).
// Deliberately no invulnerable/nonshootable here: the carry has no time limit,
// so the grabber must stay killable (Zangief's invuln is balanced by his
// 60-tic hold cap).
actor NegaSuperArmCarryStart_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_PlaySound("KirbyNES/FoeGrab", 1)
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nopushplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NoHitStunplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    stop
  }
}

// Carry tick: hold marker (maxamount 60 caps itself) + weapon ready without the
// Nega slide altfire; switching stays allowed so Deselect can auto-throw.
actor NegaSuperArmHold_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 A_GiveInventory("ZangiefHoldFlag", 1)
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
  }
}

// Release: protect the victim from their own slam, spawn the slam at their center,
// then hurl them along the SuperArm Gutrock arc (30 u/tic forward, velz set +5.0).
actor NegaSuperArmThrow_P : CustomInventory {
  states {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefGiver", 0, 0, CallACS("rz_CountInv_SuplexID")-1+1000)
    TNT1 A 0 A_SpawnItemEx("NegaSuperArmSlam", 0, 0, 0, 0, 0, 0, 0, 1+8+32)
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ZangiefSetThrow", 0, CallACS("rz_CountInv_SuplexID")-1+1000, 30, 20)
    stop
  }
}

actor NegaSuperArmSlam : BasicExplosion {
  damagetype "SuperArm"
  Obituary "$OB_NegaSuperArm"
  +NOTARGETSWITCH
  scale 2.5
  Args 75, 75, 128, 64
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, 1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*2)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_WarpToPlayerCenter", CallACS("rz_CountInv_SuplexID", 2)+999)
    TNT1 A 0 A_Explode(random(Args[0]*Args[4], Args[1]*Args[4]), Args[2], 0, false, Args[3])
   Boom:
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/superarmsplit", "Voice")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("GutrockFX", random(-16,16), random(-16,16), random(8,32), random(-10,10), random(-10,10), random(5,10), random(0,359), 1)
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
  }
}

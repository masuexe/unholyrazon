actor NegaSuperArmWep_NegaManBar : NegaManBar {args 1, 220}

actor NegaSuperArmWep : BaseNegaManWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM2z"
  Obituary "$OB_SuperArm"
  Tag "$TAG_NegaMan_W2c"
  weapon.ammotype "NegaMM1_Ammo"
  inventory.icon "NEG_SARM"
  States {
   Spawn:
    6O02 A 6
    loop

   Deselect:
    6K02 P 0
    goto DeselectSwap
   Select:
    6K02 P 0
    goto SelectSwap

   Ready:
    6K02 P 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE2C)
   ReadyX:
    6K02 P 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 P 8 A_WeaponReady
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6K02 P 8 A_WeaponReady(4)
    6K02 P 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6K02 P 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto ReadyX

   Fire:
    6H51 B 0 A_JumpIfInventory("ZangiefHoldFlag", 1, "SuplexThrow")
    6K02 P 0 A_JumpIfNoAmmo("NoAmmo")
    6K02 P 0 A_PlaySoundEx("weapons/mm1/superarmload", "Weapon")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 P 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 P 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 P 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6K02 P 1 A_FireCustomMissile("NegaSuperArmGrab", 0, 0, 0, 0, 1, 0)
    6K02 P 0 A_JumpIfInventory("SuplexID", 1, "Suplex")
    6K02 P 4
    6K02 P 0 A_Refire
    Goto ReadyX
   Suplex:
    6H51 E 1 A_GiveInventory("Zangief_SuplexStartG_P")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 350, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 340, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 320, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 310, angle*256/360, 100)==0, "AtomicKaboom")
    goto SuplexGroundHold+1
   SuplexGroundHold:
    6H51 E 0 A_Jumpif(CallACS("uh_ZangiefGrab", 300, angle*256/360, 100)==0, "AtomicKaboom")
    6H51 E 1 A_GiveInventory("SuplexHold_P")
    6H51 E 0 A_JumpIfInventory("ZangiefHoldFlag", 60, "SuplexGroundRelease")
    loop
   SuplexGroundRelease:
    6H51 E 0 A_GiveInventory("VivifyDelay3")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 310, angle*256/360, 92)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 320, angle*256/360, 84)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 76)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 340, angle*256/360, 68)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 350, angle*256/360, 60)==0, "AtomicKaboom")
   AtomicKaboom:
    6H51 E 0 A_GiveInventory("Zangief_FireSlam_P2")
    6H51 E 2 A_GiveInventory("VivifyDelay4")
    6H51 DC 2
    6H51 B 0 A_GiveInventory("ZangiefResetFlags_P")
    6H51 B 6 A_GiveInventory("AtomicSuplexAmmo", 3)
    goto ReadyX
   AtomicRelease:
    6H51 E 0 A_GiveInventory("ZangiefHoldFlagRemover_P")  // A_TakeInventory("ZangiefHoldFlag")
    goto AtomicKaboom+1
   AtomicThrow:
    6H51 E 0 A_GiveInventory("Zangief_FireSlam_P3")
    goto AtomicKaboom+1

   SuplexThrow:
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 315, angle*256/360, 90)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 330, angle*256/360, 80)==0, "AtomicKaboom")
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 345, angle*256/360, 70)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(momz<0, "SuplexThrowDown")
   SuplexThrowUp:
    6H51 E 0
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 359, angle*256/360, 65)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_checkfooting"), "AtomicThrow")
    6H51 E 0 A_JumpIf(momz>0, "SuplexThrowUp")  // GoingUp
   SuplexThrowDown:
    6H51 E 0
    6H51 E 1 A_Jumpif(CallACS("uh_ZangiefGrab", 359, angle*256/360, 65)==0, "AtomicKaboom")
    6H51 E 0 A_JumpIf(CallACS("core_checkfooting"), "AtomicThrow")
    6H51 E 0 A_JumpIf(momz<0, "SuplexThrowDown")
    goto AtomicThrow

   NoAmmo:
    6K02 P 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6K02 P 0 A_GiveInventory("NegaMM1_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaSuperArmGrab : BasicFastProjectile {
  damagetype "Suplex"
  Obituary "$OB_51M1"
  +DONTBLAST
  +DONTREFLECT
  +FORCEXYBILLBOARD
  +THRUGHOST
  reactiontime 1
  damage (10)  // 50
  Radius 20
  Height 20
  speed 65
  scale 2.0
  Args 10, 64, 64
  States {
   Spawn:
    6P51 E 0
    6P51 E 1 A_CountDown
    wait
   Death:
    6P51 E 0 A_Explode(Args[0], Args[1], 0, true, Args[2])
    goto XDeath
   XDeath:
    6P51 E 0 A_Stop
    // 6P51 DEFED 2
    stop
  }
}

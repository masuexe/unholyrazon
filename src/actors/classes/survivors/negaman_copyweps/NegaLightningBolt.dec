actor NegaLightningBoltWep_NegaManBar : NegaManBar {args 12, 229}

actor NegaLightningBoltWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 6
  Inventory.Pickupmessage "$PU_02_MMB"
  Obituary "$OB_LIGHTNINGBOLT"
  Tag "$TAG_NegaMan_WBc"
  weapon.ammotype "NegaMMB_Ammo"
  inventory.icon "NEG_LTNB"
  States {
   Spawn:
    6N02 L 0
    goto SpawnFrame

   Deselect:
    6I02 J 0
    goto DeselectSwap
   Select:
    6I02 J 0
    goto SelectSwap

   Ready:
    6I02 J 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYEB)
   ReadyX:
    6I02 J 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 7))
    6I02 J 0 A_JumpIfInventory("NegaMMB_Ammo", Args[4], "ReadyHave")
    6I02 J 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6I02 J 8 A_WeaponReady
    6I02 J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6I02 J 8 A_WeaponReady(4)
    6I02 J 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 J 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 7))
    6I02 J 0 A_JumpIfInventory("NegaMMB_Ammo", Args[4], "ReadyX")
    6I02 J 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6I02 J 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 7), "NoAmmo")
    6I02 J 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    6I02 J 0 A_FireCustomMissile("NegaLightningBoltPinpoint", 0, 0, 8, 0)
    6I02 LKJ 2
    6I02 J 0 A_Refire
    Goto ReadyX

   NoAmmo:
    6I02 J 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6I02 J 0 A_GiveInventory("NegaMMB_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaLightningStartFX1 : BasicGraphicEffect {
  +FORCEYBILLBOARD
  +BRIGHT
  States {
   SpawnFrame:
    X_BC BCD 3
    stop
  }
}

actor NegaLightningStartFX2 : NegaLightningStartFX1 {
  States {
   SpawnFrame:
    X_BC EFGHIJ 3
    stop
  }
}

actor NegaLightningBoltFX : NegaLightningStartFX1 {
  +FORCEXYBILLBOARD
  States {
   SpawnFrame:
    X_BC K 0
    X_BC K 0 A_ChangeVelocity(Random(-2, 2), Random(-2, 2), Random(-2, 2), CVF_REPLACE)
    X_BC KLM 1
    stop
  }
}


actor NegaLightningBoltPinpoint : FastProjectile {
  +SKYEXPLODE
  +DONTBLAST
  +THRUACTORS
  reactiontime 20
  damage (0)
  radius 16
  height 16
  speed 200
  MissileType "NegaLightningBoltFX"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_CountDown
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("NegaLightningBolt", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}


actor NegaLightningBoltTracer : BasicProjectile {
  +DONTSPLASH
  +NOEXPLODEFLOOR
  +NOCLIP
  +DONTBLAST
  Damage (0)
  Speed 60
  Radius 16
  Height 96
  Scale 2.5
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER", 1)
    TNT1 A 0 A_Changeflag("NOCLIP", 0)
    TNT1 A 10
    Goto XDeath
   Death:
    TNT1 A 0
    stop
   Crash:
   XDeath:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("NegaLightningBolt", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}
actor NegaLightningBoltTracer2 : NegaLightningBoltTracer {
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ChangeFlag("FLOORHUGGER", 1)
    TNT1 A 0 A_Changeflag("NOCLIP", 0)
    TNT1 A 5
    Goto XDeath
  }
}

actor NegaLightningBolt : BasicProjectile {
  +THRUACTORS
  +NOEXPLODEFLOOR
  +FORCEYBILLBOARD
  +BRIGHT
  +FLOORHUGGER
  +DONTBLAST
  +OLDRADIUSDMG
  Damage (0)
  DamageType "LightningBolt"
  Obituary "$OB_LIGHTNINGBOLT"
  height 32
  radius 16
  scale 2.5
  Args 250, 128, 32
  states {
   Spawn:
    X_BC N 0
    X_BC N 0 A_SpawnItemEx("ElectrifyEffect")
    X_BC N 1 A_SpawnItemEx("NegaLightningExtend", 0, 0, 355, 0, 0, 0, 0, 1)
    X_BC N 0 A_PlaySoundEx("weapon/lightningbolt", "Weapon")
    X_BC N 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])  // 318,128,0,0,32
    X_BC O 1
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(32, 96), Random(32, 96), 32, 0, 0, 0, 0, 1)
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(-32, -96), Random(-32, -96), 64, 0, 0, 0, 0, 1)
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(32, 96), Random(32, 96), 96, 0, 0, 0, 0, 1)
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(-32, -96), Random(-32, -96), 128, 0, 0, 0, 0, 1)
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(32, 96), Random(32, 96), 160, 0, 0, 0, 0, 1)
    X_BC P 0 A_SpawnItemEx("NegaLightningBoltFX", Random(-32, -96), Random(-32, -96), 192, 0, 0, 0, 0, 1)
    X_BC PQR 1
    Stop
  }
}

actor NegaLightningExtend : NegaLightningBolt {
  -FLOORHUGGER
  +CLIENTSIDEONLY
  +NOINTERACTION
  States {
   Spawn:
    X_BC S 0
    X_BC S 0 A_JumpIf(ceilingz-z <= 32, "Death")
    X_BC S 0 A_SpawnItemEx("NegaLightningExtend", 0, 0, 160, 0, 0, 0, 0, 1)
    X_BC STUV 1
    stop
   Death:
    TNT1 A 0 A_SpawnItemEx("ElectrifyEffect")
    stop
  }
}


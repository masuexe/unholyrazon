actor NegaTripleBladeWep_NegaManBar : NegaManBar {args 10, 251}

actor NegaTripleBladeWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Obituary "$OB_TRIPLEBLADE"
  Tag "$TAG_NegaMan_W10f"
  Inventory.Pickupmessage "$PU_TRIPLEBLADE" //Power Up! Nega Triple Blade!
  weapon.ammotype "NegaMM10_Ammo"
  inventory.icon "NEG_BLAW"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6N02 K 0
    goto SpawnFrame
   Deselect:
    6K02 C 0
    goto DeselectSwap
   Select:
    6K02 C 0
    goto SelectSwap

   Ready:
    6K02 C 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE10A)
   ReadyX:
    6K02 C 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 4))
    6K02 C 0 A_JumpIfInventory("NegaMM10_Ammo", Args[4], "ReadyHave")
    6K02 C 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6K02 C 8 A_WeaponReady
    6K02 C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6K02 C 8 A_WeaponReady(4)
    6K02 C 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6K02 C 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 4))
    6K02 C 0 A_JumpIfInventory("NegaMM10_Ammo", Args[4], "ReadyX")
    6K02 C 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6K02 C 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 4), "NoAmmo")
    6K02 C 0 A_GiveInventory("VivifyFlag1")
    6K02 C 0 A_Refire(1)
    6K02 C 0 A_SpawnItemEx("NegaTripleBladeWarper_H", 0, 0, 28)
    6K02 DEEEEEEEEEEEEEEEEEEEED 2 //A_JumpIfInventory("VivifyDelay5",1,"FireCancel")
    goto ReadyX

   FireCancel:
    6K02 EDC 2
    goto ReadyX

   NoAmmo:
    6K02 C 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6K02 C 0 A_GiveInventory("NegaMM10_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaTripleBladeWarper_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("PlayerPropertySpread", 1, "SpawnS")
    TNT1 A 0 A_GiveToTarget("NegaTripleBladeWarper_P", 1)
    stop
   SpawnS:
    TNT1 A 3 A_GiveToTarget("NegaTripleBladeWarper_P", 1)
    TNT1 A 3 A_GiveToTarget("NegaTripleBladeWarper_P2", 1)
    TNT1 A 3 A_GiveToTarget("NegaTripleBladeWarper_P3", 1)
    stop
  }
}

actor NegaTripleBladeWarper_P : CustomInventory{States{Pickup: TNT1 A 0 A_SpawnItemEx("NegaTripleBladeWarper", 64, -48, 6)stop}}
actor NegaTripleBladeWarper_P2 : CustomInventory{States{Pickup: TNT1 A 0 A_SpawnItemEx("NegaTripleBladeWarper2L", 128, 0, 28)stop}}
actor NegaTripleBladeWarper_P3 : CustomInventory{States{Pickup: TNT1 A 0 A_SpawnItemEx("NegaTripleBladeWarper2R", 192, 0, 28)stop}}

actor NegaTripleBladeWarper : BasicProjectile {
  var int user_BladeX;
  var int user_BladeY;
  var int user_BladeZ;
  +NOTARGETSWITCH
  +DONTBLAST
  +THRUACTORS
  +NOCLIP
  -SOLID
  Obituary "%o lost a duel of blades against %k."
  Damagetype "TripleBlade"
  Damage(0)
  Radius 4
  Height 4
  Args 48, 64, 16, 0, 0
  Scale 2.5
  States {
   Spawn:
    X_AA A 0
    X_AA C 0 A_SetUserVar("user_BladeX", 64)
    X_AA C 0 A_SetUserVar("user_BladeY", -48)
    X_AA C 0 A_SetUserVar("user_BladeZ", 6)
   Spawn2:
    X_AA C 0 A_PlaySoundEx("weapon/bladeshoot", "Weapon")
    X_AA C 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "Spawn2R")
    X_AA C 0 A_JumpIfInventory("CutterFlag", 12, "Spawn3")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeY", user_BladeY+8)
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+6)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn2+2
   Spawn2R:
    X_AA C 0 A_JumpIfInventory("CutterFlag", 6, "Spawn3R")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeY", user_BladeY+16)
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+12)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    loop
   Spawn3:
    X_AA C 0 A_SetUserVar("user_BladeY", 48)
    X_AA C 0 A_SetUserVar("user_BladeZ", 6)
    X_AA C 0 A_PlaySoundEx("weapon/bladeshoot", "Weapon")
    X_AA C 0 A_JumpIfInventory("CutterFlag", 24, "Spawn4")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeY", user_BladeY-8)
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+6)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn3+3
   Spawn3R:
    X_AA C 0 A_SetUserVar("user_BladeY", 48)
    X_AA C 0 A_SetUserVar("user_BladeZ", 6)
    X_AA C 0 A_PlaySoundEx("weapon/bladeshoot", "Weapon")
    X_AA C 0 A_JumpIfInventory("CutterFlag", 12, "Spawn4R")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeY", user_BladeY-16)
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+12)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn3R+3
   Spawn4:
    X_AA C 0 A_SetUserVar("user_BladeY", 0)
    X_AA C 0 A_SetUserVar("user_BladeZ", 6)
    X_AA C 0 A_PlaySoundEx("weapon/bladeshoot", "Weapon")
    X_AA C 0 A_JumpIfInventory("CutterFlag", 36, "DeathStop")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+10)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn4+3
   Spawn4R:
    X_AA C 0 A_SetUserVar("user_BladeY", 0)
    X_AA C 0 A_SetUserVar("user_BladeZ", 6)
    X_AA C 0 A_PlaySoundEx("weapon/bladeshoot", "Weapon")
    X_AA C 0 A_JumpIfInventory("CutterFlag", 18, "DeathStop")
    X_AA C 1 A_Warp(2, user_BladeX, user_BladeY, user_BladeZ, 0, 0)
    X_AA C 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA C 0 A_SetUserVar("user_BladeZ", user_BladeZ+20)
    X_AA C 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn4R+3
   Death:
   DeathStop:
    TNT1 A 0
    stop
  }
}

Actor NegaTripleBladeWarper2L : NegaTripleBladeWarper {
  Scale 2.0
  Args 40, 64, 16, 128, -10
  States {
   Spawn:
    X_AA D 0
    X_AA D 0 A_PlaySoundEx("LA/SwordSpin", "Weapon")
    X_AA D 0 A_JumpIfInTargetInventory("PlayerPropertyRage", 1, "SpawnR")
    X_AA D 0 A_JumpIfInventory("CutterFlag", 36, "DeathStop")
    X_AA D 1 A_Warp(2, Args[3], 0, 28, Args[4], WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    X_AA D 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA D 0 A_GiveInventory("CutterFlag", 1)
    goto Spawn+2
   SpawnR:
    X_AA D 0 A_JumpIfInventory("CutterFlag", 18, "DeathStop")
    X_AA D 1 A_Warp(2, Args[3], 0, 28, 2*(Args[4]), WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION)
    X_AA D 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    X_AA D 0 A_GiveInventory("CutterFlag", 1)
    loop
   Death:
    goto DeathStop
  }
}

Actor NegaTripleBladeWarper2R : NegaTripleBladeWarper2L{Args 40, 64, 16, 192, 10}


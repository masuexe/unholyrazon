// TODO: make ammo regen compatible with slide

actor NegaThunderBeamWep_NegaManBar : NegaManBar {
  // args[0]=MM1 slot; args[1]=cyan; args[2]=custom fill max; Tag=fill ammo
  args 1, 215, 600
  Tag "NegaMM1_Flag"
}

actor NegaThunderBeamWep : BaseNegaManWep {
  Weapon.AmmoUse 0  // 6
  Weapon.AmmoGive 28
  Weapon.SlotNumber 2
  Inventory.Pickupmessage "$PU_02_MM1"
  Obituary "$OB_THUNDERBEAM"
  Tag "$TAG_NegaMan_W1f"
  Weapon.AmmoType "NegaMM1_Flag"
  Inventory.Icon "NEG_THUN"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6N02 B 0
    goto SpawnFrame

   Deselect:
    6H02 D 0
    goto DeselectSwap
   Select:
    6H02 D 0
    goto SelectSwap

   Ready:
    6H02 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE1)
    6H02 D 0 A_GunFlash
   ReadyX:
    6H02 D 0 A_JumpIfNoAmmo("NoAmmo")  // no-op (AmmoUse 0); Thunder Beam spends NegaMM1_Flag charge
    6H02 D 8 A_WeaponReady
    6H02 D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto Ready+3
   ReadyNoAmmo:
    6H02 D 8 A_WeaponReady(4)
    6H02 D 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6H02 D 0 A_JumpIfNoAmmo("ReadyNoAmmo")  // no-op (AmmoUse 0); charge pool is NegaMM1_Flag
    goto ReadyX

   Fire:
    6H02 D 0 A_JumpIfNoAmmo("NoAmmo")  // no-op (AmmoUse 0); Thunder Beam spends NegaMM1_Flag charge
    6H02 D 0 A_PlaySoundEx("weapon/thunderbeam", "Weapon")
    6H02 E 1 A_FireCustomMissile("NegaThunderBeam", 0, 1, 8, 0)
    6H02 E 4 A_TakeInventory("NegaMM1_Flag")
    6H02 F 5
    6H02 D 12
    6H02 D 0 A_ReFire
    goto ReadyX

   Flash:
    TNT1 A 1 A_GiveInventory("NegaMM1_FlagCharge_P")
    loop

   Flash_Slide:
    TNT1 A 1
    6S02 A 1
    6S02 B 1
    6S02 C 1
    6S02 D 1
    6S02 E 4
    6S02 D 3
    6S02 C 2
    6S02 B 2
    6S02 A 1
    TNT1 A 0 A_GunFlash
    stop

   NoAmmo:
    6H02 D 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6H02 D 0 A_GiveInventory("NegaMM1_Ammo", 28)
    goto ReadyX
  }
}

actor NegaMM1_Flag : Ammo {
  Inventory.MaxAmount 600
  +INVENTORY.IGNORESKILL
}

actor NegaMM1_FlagCharge_P : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_LOGINT( sqrt(velx*velx+vely*vely+velz*velz) )
    // TNT1 A 0 A_LOGINT( (velx*velx+vely*vely+velz*velz)*0.01 )
    TNT1 A 0 A_JumpIfInventory("NegaMM1_Flag", 600, 2)
    TNT1 A 0 A_JumpIf((velx * velx + vely * vely + velz * velz) * 0.01 >= 1, "Pickup1")
    TNT1 A 0
    stop
   Pickup1:
    TNT1 A 0 A_GiveInventory("NegaMM1_Flag", (velx * velx + vely * vely + velz * velz) * (0.01 * (CallACS("uh_checkrune", RUNE_RAGE) + CallACS("uh_NegaAmmoCost", 1))))
    stop
  }
}

actor NegaThunderBeam : BasicProjectile {
  var int user_power;
  DamageType "ThunderBeam"
  Obituary "$OB_THUNDERBEAM"
  +BRIGHT
  +RIPPER
  Damage (80 + user_power * 0.30)
  Radius 14
  Height 16
  Speed 40
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_power", CallACS("rz_CountInv_NegaMM1_Flag", AAPTR_TARGET))
    TNT1 A 0 A_Explode(user_power * 0.25, 16, 0, 0, 16)
    TNT1 A 0  // A_LogInt(user_power)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6, 7)
   SpawnL:
    X_1F ABCDEFG 3
    loop
  }
}

/////////////////
// == Shiny == //
/////////////////

actor S_NegaThunderBeam : NegaThunderBeam {
  Obituary "%o was electrocuted by %k's Shiny Nega Thunder Beam."
  Damage (170)  // (80+user_power*0.30) 600 / 2 = 300, 300*0.3 = 90 + 80 = 170
  States {
   Spawn:
    X_1F A 0
    X_1F ABCDEFG 3
    goto Spawn+1
   Death:
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 0, 1)
    stop
  }
}

actor S_NegaThunderBeam2 : S_NegaThunderBeam {
  States {
   Death:
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 0, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 45, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, -45, 1)
    stop
  }
}

actor S_NegaThunderBeam3 : S_NegaThunderBeam {
  States {
   Death:
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 0, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 40, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, -40, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, 80, 1)
    X_1F A 0 A_SpawnItemEx("S_NegaThunderBeamX", 0, 0, 0, -30, 0, 0, -80, 1)
    stop
  }
}

actor S_NegaThunderBeamX : S_NegaThunderBeam {
  Damage (85)
  States {
   Spawn:
    X_1F A 0
    X_1F ABCDEFG 3
    stop
   Death:
    TNT1 A 0
    stop
  }
}

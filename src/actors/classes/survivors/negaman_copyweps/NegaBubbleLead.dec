actor NegaBubbleLeadWep_NegaManBar : NegaManBar {args 2, 93}

actor NegaBubbleLeadWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM2z"
  Obituary "$OB_BUBBLELEAD"
  Tag "$TAG_NegaMan_W2c"
  Weapon.AmmoType "NegaMM2_Ammo"
  Inventory.Icon "NEG_BUBB"
  States {
   Spawn:
    6N02 P 0
    goto SpawnFrame

   Deselect:
    6I02 S 0
    goto DeselectSwap
   Select:
    6I02 S 0
    goto SelectSwap

   Ready:
    6I02 S 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE2C)
   ReadyX:
    6I02 S 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6I02 S 0 A_JumpIfInventory("NegaMM2_Ammo", args[4], "ReadyHave")
    6I02 S 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6I02 S 8 A_WeaponReady
    6I02 S 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6I02 S 8 A_WeaponReady(4)
    6I02 S 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 S 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6I02 S 0 A_JumpIfInventory("NegaMM2_Ammo", args[4], "ReadyX")
    6I02 S 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Fire:
    6I02 S 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "NoAmmo")
    6I02 S 0 A_PlaySoundEx("weapon/mbuster", "Weapon")
    6I02 S 0 A_FireCustomMissile("NegaBubbleLead", 0, 1, 8, 0)
    6I02 TUS 4
    6I02 S 0 A_ReFire
    goto ReadyX

   NoAmmo:
    6I02 S 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6I02 S 0 A_GiveInventory("NegaMM2_Ammo", 28)
    goto ReadyX
  }
}


actor NegaBubbleLead : BasicProjectile {
  DamageType "BubbleLead"
  Obituary "%o was lead further astray by %k's Nega Bubble Lead."  // OB_NEGABUBBLELEAD
  BounceSound "Pokemon/BallBounce"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +BOUNCEONWALLS
  +CANBOUNCEWATER
  BounceCount 7  // 5
  BounceFactor 0.88  // 0.8
  WallBounceFactor 1.0
  Damage (200)
  Height 16
  Radius 20
  Speed 15
  Scale 2.5
  States {
   Spawn:
    X_2C A 0
    X_2C A 0 ThrustThingZ(0, 18, 0, 1)
   SpawnL:
    X_2C ABC 4
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("SoakifyEffect")
    stop
  }
}

/////////////////
// == Shiny == //
/////////////////

actor S_NegaBubbleLead : NegaBubbleLead {Damage (245)}

actor S_NegaBubbleLead2 : S_NegaBubbleLead {
  +USEBOUNCESTATE
  BounceCount 5
  BounceFactor 0.92
  Gravity 0.7
  Height 18
  Radius 22
  Speed 18
  Scale 3.0
  States {
   Spawn:
    X_2C A 0
    X_2C A 0 ThrustThingZ(0, 20, 0, 1)
   SpawnL:
    X_2C ABC 4
    loop
   Bounce.Floor:
    X_2C A 0 A_SpawnItemEx("S_NegaBubbleLead", 8, 0, 0, 10, 0, 8, 45)
    X_2C A 0 A_SpawnItemEx("S_NegaBubbleLead", 8, 0, 0, 10, 0, 8, 135)
    X_2C A 0 A_SpawnItemEx("S_NegaBubbleLead", 8, 0, 0, 10, 0, 8, 225)
    X_2C A 0 A_SpawnItemEx("S_NegaBubbleLead", 8, 0, 0, 10, 0, 8, 315)
    goto SpawnL
  }
}


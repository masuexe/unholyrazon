actor NegaFlashBombWep_NegaManBar : NegaManBar {args 8, 229}

actor NegaFlashBombWep : BaseNegaManWep {
  Weapon.AmmoUse 3
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_02_MM8z"
  Obituary "$OB_FLASHBOMB"
  Tag "$TAG_NegaMan_W8g"
  weapon.ammotype "NegaMM8_Ammo"
  inventory.icon "NEG_FLBM"
  States {
   Spawn:
    6N02 I 6
loop

   Deselect:
    6J02 N 0
    goto DeselectSwap
   Select:
    6J02 N 0
    goto SelectSwap

   Ready:
    6J02 N 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE8G)
    6J02 N 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 N 8 A_WeaponReady
    6J02 N 0 A_GiveInventory("NegaMM8_Ammo", 1)
    Goto Ready+2
   ReadyNoAmmo:
    6J02 N 8 A_WeaponReady(4)
    6J02 N 0 A_GiveInventory("NegaMM8_Ammo", 1)
    6J02 N 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    goto ReadyX

   Fire:
    6J02 N 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 N 0 A_PlaySoundEx("weapons/mm8/flashbombfire", "Weapon")
    6J02 N 0 A_FireCustomMissile("NegaFlashBomb", 0, 1, 8, 0)
    6J02 OP 4 //6
6J02 N 24 // 30
    6J02 N 0 A_Refire
    goto ReadyX

   NoAmmo:
    6J02 N 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 N 0 A_GiveInventory("NegaMM8_Ammo", 28)
    goto ReadyX
  }
}

actor NegaFlashBomb : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  damagetype "FlashBomb"
  Obituary "$OB_FLASHBOMB"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +ALLOWBOUNCEONACTORS
  +BOUNCEONCEILINGS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  +BOUNCEONACTORS
  Bouncefactor 0.8  // 0.85
  WallBouncefactor 1.0
  Bouncecount 6
  Gravity 0.78  // 0.75
  Damage (120)  // 150
  Radius 12
  Height 13
  speed 28  // 30
  scale 2.5
  States {
   Spawn:
    FLSB BC 3
    FLSB B 0 A_SpawnItemEx("FlashBombTrail", -momx, -momy, -momz, 0, 0, 5, 0, SXF_ABSOLUTEPOSITION|SXF_WEPFXCOLOR)
    FLSB DE 3
    FLSB B 0 A_SpawnItemEx("FlashBombTrail", -momx, -momy, -momz, 0, 0, 5, 0, SXF_ABSOLUTEPOSITION|SXF_WEPFXCOLOR)
    loop
   Bounce.Floor:
   Bounce.Ceiling:
   Bounce.Wall:
    X_8G W 0 A_SpawnItemEx("NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn
   Death:
    Y_8G A 0 A_SpawnItemEx("NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaFlashBombExplosion : BasicExplosion {
  damagetype "FlashBomb"
  Obituary "$OB_FLASHBOMB"
  +FORCEXYBILLBOARD
  +BRIGHT
  ReactionTime 10
  Scale 3.5
  States {
   Spawn:
    // 34 - 32 - 30
    X_8G A 0
    X_8G A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    X_8G ABCD 1
    X_8G E 0 A_Explode(32+ReactionTime*2, 92, 0, 0, 16)
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H0", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8G EFGF 1
    X_8G G 0 A_Explode(30+ReactionTime*2, 92, 0, 0, 16)
    Goto Pattern1
   Pattern1:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H1", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFGF 1
    Goto DamageNow
   Pattern2:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H2", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFEF 1
    Goto DamageNow
   DamageNow:
    X_8G G 0 A_Explode(28+ReactionTime*2, 92, 0, 0, 16)
    X_8G G 0 A_CountDown
    X_8G G 0 A_Jump(256, "Pattern1", "Pattern2")
    Goto Death
   Death:
    X_8G G 1
    TNT1 A 1
    X_8G D 1
    TNT1 A 1
    X_8G D 1
    TNT1 A 1
    X_8G N 1
    stop
  }
}

actor NegaFlashBombWep_NegaManBar : NegaManBar {args 8, 229}

actor NegaFlashBombWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 5
  Inventory.Pickupmessage "$PU_02_MM8z"
  Obituary "$OB_FLASHBOMB"
  Tag "$TAG_NegaMan_W8g"
  weapon.ammotype "NegaMM8_Ammo"
  inventory.icon "NEG_FLBM"
  States {
   Spawn:
    6N02 V 0
    goto SpawnFrame

   Deselect:
    6J02 N 0
    goto DeselectSwap
   Select:
    6J02 N 0
    goto SelectSwap

   Ready:
    6J02 N 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE8G)
   ReadyX:
    6J02 N 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 3))
    6J02 N 0 A_JumpIfInventory("NegaMM8_Ammo", Args[4], "ReadyHave")
    6J02 N 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6J02 N 8 A_WeaponReady
    6J02 N 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6J02 N 8 A_WeaponReady(4)
    6J02 N 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6J02 N 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 3))
    6J02 N 0 A_JumpIfInventory("NegaMM8_Ammo", Args[4], "ReadyX")
    6J02 N 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6J02 N 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 3), "NoAmmo")
    6J02 N 0 A_PlaySoundEx("weapons/mm8/flashbombfire", "Weapon")
    6J02 N 0 A_FireCustomMissile("NegaFlashBomb", 0, 1, 8, 0)
    6J02 P 2 Offset(24, 44)
    6J02 P 2 Offset(48, 64)
    6J02 P 2 Offset(44, 64)
    6J02 O 2 Offset(36, 56)
    6J02 O 2 Offset(16, 40)
    6J02 O 2 Offset(8, 32)
    6J02 N 20 A_WeaponReady(14)  // 30
    6J02 N 0 A_Refire
    goto ReadyX

   NoAmmo:
    6J02 N 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 N 0 A_GiveInventory("NegaMM8_Ammo", 28)
    goto ReadyX
  }
}

actor NegaFlashBomb : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  damagetype "FlashBomb"
  Obituary "$OB_FLASHBOMB"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +ALLOWBOUNCEONACTORS
  +BOUNCEONCEILINGS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  +BOUNCEONACTORS
  Bouncefactor 0.8  // 0.85
  WallBouncefactor 1.0
  Bouncecount 6
  Gravity 0.78  // 0.75
  Damage (120)  // 150
  Radius 12
  Height 13
  speed 28  // 30
  scale 2.5
  States {
   Spawn:
    FLSB BC 3
    FLSB B 0 A_SpawnItemEx("FlashBombTrail", -momx, -momy, -momz, 0, 0, 5, 0, SXF_ABSOLUTEPOSITION|SXF_WEPFXCOLOR)
    FLSB DE 3
    FLSB B 0 A_SpawnItemEx("FlashBombTrail", -momx, -momy, -momz, 0, 0, 5, 0, SXF_ABSOLUTEPOSITION|SXF_WEPFXCOLOR)
    loop
   Bounce.Floor:
   Bounce.Ceiling:
   Bounce.Wall:
    X_8G W 0 A_SpawnItemEx("NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn
   Death:
    Y_8G A 0 A_SpawnItemEx("NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor NegaFlashBombExplosion : BasicExplosion {
  damagetype "FlashBomb"
  Obituary "$OB_FLASHBOMB"
  +FORCEXYBILLBOARD
  +BRIGHT
  ReactionTime 10
  Scale 3.5
  States {
   Spawn:
    // 34 - 32 - 30
    X_8G A 0
    X_8G A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    X_8G ABCD 1
    X_8G E 0 A_Explode(32+ReactionTime*2, 92, 0, 0, 16)
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H0", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8G EFGF 1
    X_8G G 0 A_Explode(30+ReactionTime*2, 92, 0, 0, 16)
    Goto Pattern1
   Pattern1:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H1", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFGF 1
    Goto DamageNow
   Pattern2:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H2", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFEF 1
    Goto DamageNow
   DamageNow:
    X_8G G 0 A_Explode(28+ReactionTime*2, 92, 0, 0, 16)
    X_8G G 0 A_CountDown
    X_8G G 0 A_Jump(256, "Pattern1", "Pattern2")
    Goto Death
   Death:
    X_8G G 1
    TNT1 A 1
    X_8G D 1
    TNT1 A 1
    X_8G D 1
    TNT1 A 1
    X_8G N 1
    stop
  }
}

/// //////////////////////////
// == Shiny ==//
/// //////////////////////////

actor S_NegaFlashBomb : NegaFlashBomb {
  Bouncecount 8  // 6
  Gravity 0.8
  Damage (180)
  States {
   Spawn:
    X_8G WXYZ 3
    loop
   Bounce.Floor:
   Bounce.Ceiling:
   Bounce.Wall:
    X_8G W 0 A_SpawnItemEx("S_NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Spawn
   Death:
    X_8G W 0 A_SpawnItemEx("S_NegaFlashBombExplosion", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor S_NegaFlashBomb2 : S_NegaFlashBomb {
  Bouncefactor 0.7
  Bouncecount 12  // 9
  Gravity 1.0  // 1.1
  Radius 14
  Height 15
  speed 36
  scale 3.0
  States {
   Spawn:
    X_8G WXYZ 3 A_SpawnItemEx("S_NegaFlashBombFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
  }
}

actor S_NegaFlashBomb3 : S_NegaFlashBomb {
  Bouncefactor 0.6
  Bouncecount 16  // 12
  Gravity 1.2  // 1.4
  Radius 16
  Height 17
  speed 44
  scale 3.5
  States {
   Spawn:
    X_8G WWWXXXYYYZZZ 1 A_SpawnItemEx("S_NegaFlashBombFX", 0, 0, 0, 0, 0, 0, 0, 1)
    loop
  }
}

actor S_NegaFlashBombExplosion : NegaFlashBombExplosion {
  ReactionTime 12
  States {
   Spawn:
    X_8G A 0
    X_8G A 0 A_PlaySoundEx("weapons/mm8/flashbombexplode", "Weapon")
    X_8G ABCD 1
    X_8G E 0 A_Explode(40+ReactionTime*2, 92, 0, 0, 16)
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H0", 0, 0, 0, 0, 0, 0, 0, 1)
    X_8G EFGF 1
    X_8G G 0 A_Explode(38+ReactionTime*2, 92, 0, 0, 16)
    Goto Pattern1
   Pattern1:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H1", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFGF 1
    Goto DamageNow
   Pattern2:
    X_8G E 0 A_SpawnItemEx("BasicFlashBomb_H2", 0, 0, 0, 0, 0, 0, 0, 1)
    Y_8G EFEF 1
    Goto DamageNow
   DamageNow:
    X_8G G 0 A_Explode(36+ReactionTime*2, 92, 0, 0, 16)
    X_8G G 0 A_CountDown
    X_8G G 0 A_Jump(256, "Pattern1", "Pattern2")
    Goto Death
  }
}

Actor S_NegaFlashBombFX : BasicGraphicEffect {
  Renderstyle "Add"
  Alpha 0.7
  Reactiontime 3
  States {
   SpawnFrame:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "WSpawn", "XSpawn", "YSpawn", "ZSpawn")
    goto WSpawn
   WSpawn:
    X_8G W 2
    X_8G W 0 A_Countdown
   XSpawn:
    X_8G X 2
    X_8G W 0 A_Countdown
   YSpawn:
    X_8G Y 2
    X_8G W 0 A_Countdown
   ZSpawn:
    X_8G Z 2
    X_8G W 0 A_Countdown
    goto WSpawn
   Death:
    TNT1 A 0
    stop
  }
}

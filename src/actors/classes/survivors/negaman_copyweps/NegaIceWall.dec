actor NegaIceWallWep_NegaManBar : NegaManBar {args 12, 200}

actor NegaIceWallWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 7
  Inventory.Pickupmessage "$PU_02_MMBz"
  Obituary "$OB_ICEWALL"
  Tag "$TAG_NegaMan_WBd"
  weapon.ammotype "NegaMMB_Ammo"
  inventory.icon "NEG_IWAL"
  States {
   Spawn:
    6N02 Y 0
    goto SpawnFrame

   Deselect:
    6J02 W 0
    goto DeselectSwap
   Select:
    6J02 W 0
    goto SelectSwap

   Ready:
    6J02 W 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYEBD)
   ReadyX:
    6J02 W 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 W 0 A_JumpIfInventory("NegaMMB_Ammo", Args[4], "ReadyHave")
    6J02 W 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6J02 W 8 A_WeaponReady
    6J02 W 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6J02 W 8 A_WeaponReady(4)
    6J02 W 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6J02 W 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 W 0 A_JumpIfInventory("NegaMMB_Ammo", Args[4], "ReadyX")
    6J02 W 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6J02 W 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "NoAmmo")
    6J02 W 0 A_PlaySoundEx("weapon/mirrordeflect", "Weapon")
    6J02 W 0 A_FireCustomMissile("NegaIceWallPinpoint", 0, 1, 8, 0)
    6J02 XY 3
    6J02 W 10
    6J02 W 0 A_Refire
    goto ReadyX

   NoAmmo:
    6J02 W 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 W 0 A_GiveInventory("NegaMMB_Ammo", 28)
    goto ReadyX
  }
}

actor NegaIceWallPinpoint : BasicFastProjectile {
  Damagetype "NegaIceWallBeam"
  Obituary "%o felt the chills from %k's pinpoint Wall Beam."
  +SKYEXPLODE
  +DONTBLAST
  Reactiontime 5
  Damage (50)
  radius 10
  height 10
  speed 125
  Scale 2.5
  States {
   Spawn:
    TMFX B 0
    TMFX BBBBBBBBBBBBBBBBBBBBB 1 A_SpawnItemEx("NegaIceWallBeamFX")
    TMFX B 1 A_CountDown
    loop
   Death:
    TNT1 A 0 A_CheckFloor("FloorSpawn")
    TNT1 A 0 A_SpawnItemEx("NegaIceWallBeamDeath")
    stop
   Crash:
    TNT1 A 0  // A_Explode(100,96,0)
    stop
   FloorSpawn:
    TNT1 A 0 A_PlaySoundEx("weapon/icewavespawn", "SoundSlot6")
    TNT1 A 1 A_SpawnItemEx("NegaIceWall")
    stop
  }
}

Actor NegaIceWallBeamFX : BasicGraphicEffect {
  Renderstyle "Add"
  Scale 2.0
  States {
   SpawnFrame:
    TMFX BCD 2
    stop
  }
}

Actor NegaIceWall : UH_ShootableActor {
  +USEDAMAGEEVENTSCRIPT
  var int user_NoOwnerDamage;
  DamageType "IceWall"
  Obituary "$OB_ICEWALL"
  +MISSILE
  +QUICKTORETALIATE
  // +PUSHABLE
  -NOGRAVITY
  +RIPPER
  +NODAMAGETHRUST
  +NOTARGETSWITCH
  // +SLIDESONWALLS
  +NOEXPLODEFLOOR
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +NOBLOOD
  +DONTSPLASH
  +DONTREFLECT
  +DONTDRAIN
  +NOTAUTOAIMED
  +THRUSPECIES
  +STEPMISSILE
  Species "NegaIceWall"
  PushFactor 0.1
  BounceFactor 0.9
  WallBounceFactor 0.9
  Bouncecount 6
  Maxstepheight 7
  Mass 0x7ffffffd
  Painchance "Normal", 0
  Painchance "NegaIceWallBeam", 256
  Painchance "NegaIceWallExplode", 256
  damagefactor "IceWall", 0.0
  Health 1000
  Damage (0)
  Radius 24
  Height 64
  speed 0
  scale 2.1
  States {
   Spawn:
    X_BD X 0
    X_BD X 0 A_SetScale(2.1, 0.1)
    X_BD XXXXXXXXXX 1 A_SetScale(2.1, scaleY+0.2)
    X_BD X 0 A_ChangeFlag("SOLID", 1)
    X_BD X 0 A_ChangeFlag("SHOOTABLE", 1)
    X_BD X 0 ThrustThingZ(0, 35, 0, 1)
    X_BD X 0 A_PlaySoundEx("weapon/icewallspawn", "Voice")
   Spawn2:
    X_BD X 0 A_JumpIfHealthLower(321, "Spawn2Low")
    X_BD X 0 A_Explode(35, 72, 0)  // 30,64,0
    X_BD X 1 Thing_Damage(0, 4)
    loop
   Spawn2Low:
    X_BD YYYYYYYYYY 1 A_Explode(35, 72, 0)
    X_BD Y 1 A_Die
    wait
   Death:
    X_BD L 0
    X_BD L 0 A_SetGravity(0.0)
    X_BD L 0 A_ChangeFlag("SOLID", 0)
    X_BD L 0 A_PlaySoundEx("misc/freeze", "Voice")
    X_BD LM 5
    stop
   Pain.NegaIceWallBeam:
   Pain.NegaIceWallExplode:
    X_BD X 0  // 1 //A_Die("NegaIceWallBeam")
    goto Death.NegaIceWallBeam
   Death.NegaIceWallBeam:
    X_BD Y 0 A_ChangeFlag("NOINTERACTION", 1)
    X_BD Y 0 A_SetGravity(0.0)
    X_BD Y 0 A_ChangeFlag("SOLID", 0)
    TNT1 A 0 A_SetTics(random(0, 2))
    TNT1 A 0 A_SpawnItemEx("NegaIceWallBeamDeath", 0, 0, 28, 0, 0, 0, 0, 1)
    X_BD LM 4
    stop
  }
}

Actor NegaIceWallBeamDeath : BasicExplosion {
  DamageType "NegaIceWallExplode"
  Obituary "$OB_ICEWALL"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    X_8B A 1 A_PlaySoundEx("misc/mm3explosion", "Voice")  // want a better sound for ice wall being broken by a beam pinpoint
    X_8B AAAAAAAAAA 0 A_SpawnItemEx("NegaIceWallDeathFX", 0, 0, 4, random(3, 13), 0, random(3, 15), random(0, 359))
    X_8B A 1 A_Explode(260, 128, 0, 0, 24)  // 300,150,0,0,30
    X_8B BCDEF 2
    stop
  }
}

Actor NegaIceWallDeathFX {
  BounceSound "item/protoreflect"
  PROJECTILE
  +CLIENTSIDEONLY
  -NOGRAVITY
  // +DOOMBOUNCE
  +BOUNCEONCEILINGS
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +ALLOWBOUNCEONACTORS
  +BOUNCEAUTOOFF
  +DONTSPLASH
  +DONTBLAST
  Bouncecount 4
  Bouncefactor 0.8
  WallBouncefactor 0.8
  Damage 0
  Radius 6
  Height 6
  Speed 10
  Scale 2.0
  States {
   Spawn:
    ICWB U 0
    ICWB U 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
    ICWB UVWXUVWXUVWXUVWXUVWX 3
    stop
   Death:
    TNT1 A 0
    stop
  }
}


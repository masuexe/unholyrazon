actor NegaMagmaBazookaWep_NegaManBar : NegaManBar {args 9, 42}
actor NegaMagmaBazookaWep_ScriptBar : ScriptBar {}

actor NegaMagmaBazookaWep : BaseNegaManWep {
  Weapon.AmmoUse 2
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM9z"
  Obituary "$OB_MAGMABAZOOKA"
  Tag "$TAG_NegaMan_W9g"
  weapon.ammotype "NegaMM9_Ammo"
  inventory.icon "NEG_MAGM"
  States {
   Spawn:
    6N02 J 6
loop

   Deselect:
    6J02 Q 0
    goto DeselectSwap
   Select:
    6J02 Q 0
    goto SelectSwap

   Ready:
    6J02 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE9G)
   ReadyX:
    6J02 Q 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 Q 8 A_WeaponReady
    6J02 Q 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6I02 Q 8 A_WeaponReady(4)
    6I02 Q 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6I02 Q 0 A_JumpIfNoAmmo("ReadyNoAmmo")
    Goto ReadyX

    // AltFire2:
    // 6J02 Q 0 A_JumpIfNoAmmo("NoAmmo")
    // 6J02 Q 0 A_PlaySound("weapon/magmabazooka",1)
    // 6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1",0,1,8,0)
    // 6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1",-16,0,8,0)
    // 6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1",16,0,8,0)
    // 6J02 TU 3
    // 6J02 Q 7
    // 6J02 Q 0 A_Refire("AltFire2")
    // Goto ReadyX
   Fire:
    6J02 Q 0 A_TakeInventory("WeaponCharge")
    6J02 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE9G, true)
    6J02 Q 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 Q 0 A_Refire("Hold0")
    6J02 Q 0 A_PlaySound("weapon/magmabazooka", 1)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1", 0, 1, 8, 0)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1", -16, 0, 8, 0)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka1", 16, 0, 8, 0)
    6J02 TU 3
    6J02 Q 4
    6J02 Q 0 A_Refire("Hold0")
    Goto ReadyX
   Fire2:
    6J02 Q 0 A_TakeInventory("WeaponCharge")
    6J02 Q 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE9G, true)
    6J02 Q 0 A_PlaySound("weapon/magmabazooka", 1)
    6J02 Q 0 A_TakeInventory("NegaMM9_Ammo", 14, 1)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka2", 0, 0, 8, 0)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka2L", 0, 0, 8, 0)
    6J02 Q 0 A_FireCustomMissile("NegaMagmaBazooka2R", 0, 0, 8, 0)
    6J02 TTUU 2 A_FireCustomMissile("NegaMagmaBazookaX", frandom(-10, 10), 0, 8, 0, 0, frandom(-10, 10))
    6J02 QQQQQ 1 A_FireCustomMissile("NegaMagmaBazookaX", frandom(-15, 15), 0, 8, 0, 0, frandom(-15, 15))
    6J02 A 0 A_Refire("Hold0")
    Goto ReadyX

   Flash:
    TNT1 A 2 A_GiveInventory("WeaponCharge", 1)
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 1, "Flash")
    stop

   Hold0:
    6J02 Q 0 A_JumpIfNoAmmo("NoAmmo")
    6J02 Q 0 A_GunFlash("Flash", 1)
    6J02 Q 0 A_PlaySound("weapon/magmacharge1", 1, 1.0, true)
   Hold1:
    6J02 Q 1 A_JumpIfInventory("WeaponCharge", 19, "Hold2Start")
    6J02 Q 0 A_GiveInventory("WeaponCharge", 1)
    6J02 Q 1
    6J02 Q 0 A_Refire(1)
    goto Fire
    6J02 V 1
    6J02 Q 0 A_Refire("Hold1")
    goto Fire
   BotFire:
    6J02 Q 0 A_Jump(16, "Fire2")
    6J02 Q 0 A_Refire("Hold2")
    Goto Fire
   Hold2Start:
    6J02 R 0 A_PlaySound("weapon/magmacharge2", 1, 1.0, true)
   Hold2:
    6J02 R 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_9GC1, true)
    6J02 R 0 A_Refire(2)
    6J02 R 0 A_JumpIfInventory("NegaMM9_Ammo", 14, "Fire2")
    Goto Fire
    6J02 Q 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE9G, true)
    6J02 Q 0 A_Refire(2)
    6J02 Q 0 A_JumpIfInventory("NegaMM9_Ammo", 14, "Fire2")
    goto Fire
    6J02 S 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_9GC2, true)
    6J02 S 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6J02 S 0 A_Refire("Hold2")
    6J02 S 0 A_JumpIfInventory("NegaMM9_Ammo", 14, "Fire2")
    goto Fire

   NoAmmo:
    6I02 Q 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 Q 0 A_GiveInventory("NegaMM9_Ammo", 28)
    Goto ReadyX
  }
}

actor NegaMagmaBazooka1 : BasicProjectile {
  Translation "192:192=205:205", "198:198=77:77"
  Damagetype "MagmaBazooka1"
  Obituary "$OB_MAGMABAZOOKA"
  +BRIGHT
  Damage (90)
  Radius 6
  Height 8
  Speed 28
  scale 2.5
  States {
   Spawn:
    X_9G ABCDEF 2
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    stop
  }
}

actor NegaMagmaBazooka2 : NegaMagmaBazooka1 {
  Damagetype "MagmaBazooka2"
  Damage (250)
  Radius 24
  Height 16
  Speed 35
  States {
   Spawn:
    X_9G GHIJKL 2
    loop
  }
}

actor NegaMagmaBazooka2L : NegaMagmaBazooka2 {
  Args 1
  States {
   Spawn:
    X_9G G 0
    X_9G G 0 ACS_NamedExecuteAlways("core_targetyawpitch", 0, 0)
    goto SpawnL+9
   SpawnL:
    X_9G JKLGHI 2 A_ChangeVelocity(0, Args[0]*7, 0, 1)
    X_9G JKLGHI 2 A_ChangeVelocity(0, Args[0]*-7, 0, 1)
    loop
  }
}

actor NegaMagmaBazooka2R : NegaMagmaBazooka2L {
  Args -1
}

actor NegaMagmaBazookaX : NegaMagmaBazooka1 {
  DeathSound "weapon/firestorm"
  -NOGRAVITY
  Gravity 0.8
  Damage (50)  // 40
  Radius 6
  Height 8
  Speed 25
  scale 2.5
  States {
   Spawn:
    X_9G A 0
    X_9G A 0 A_ChangeVelocity(0, 0, random(8, 16)/4)
   SpawnL:
    X_9G ABC 3
    loop
   Death:
    TNT1 AA 0 A_SpawnItemEx("NegaMagmaBazoFX", 0, 0, 4-(ceilingz-z<=height)*8, random(2, 6), 0, random(3, 6)*(1-(ceilingz-z<=height)*2), random(0, 359), 1)
    TNT1 A 0 A_SpawnItemEx("OilPitIgnite", 0, 0, 8)
    TNT1 A 0 A_PlaySoundEx("weapon/firestorm", "Voice")
    stop
  }
}

actor NegaMagmaBazoFX : BasicGraphicEffect {
  -NOINTERACTION
  -NOGRAVITY
  +BRIGHT
  Scale 1.0  // 0.5
  states {
   SpawnFrame:
    X_9G RST 2 A_FadeOut(0.04)
    loop
   Death:
    X_9G UV 2
    stop
  }
}

/// //////////////////////////
// == Shiny ==//
/// //////////////////////////

actor S_NegaMagmaBazooka1 : NegaMagmaBazooka1 {Damage (150)}
actor S_NegaMagmaBazooka2 : NegaMagmaBazooka2 {Damage (325)}

actor S_NegaMagmaBazooka2L : NegaMagmaBazooka2L {Damage (325)}
actor S_NegaMagmaBazooka2R : NegaMagmaBazooka2R {Damage (325)}

actor S_NegaMagmaBazookaX : NegaMagmaBazookaX {Damage (65)}

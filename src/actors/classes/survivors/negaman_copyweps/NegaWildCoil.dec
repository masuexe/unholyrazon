actor NegaWildCoilWep_NegaManBar : NegaManBar {args 7, 238}

actor NegaWildCoilWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  +WEAPON.NOAUTOAIM
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "$PU_02_MM7z"
  Obituary "$OB_WILDCOIL"
  Tag "$TAG_NegaMan_W7e"
  Weapon.AmmoType "NegaMM7_Ammo"
  Inventory.Icon "NEG_WCO"
  States {
   Spawn:
    6N02 U 0
    goto SpawnFrame

   Deselect:
    6J02 H 0
    goto DeselectSwap
   Select:
    6J02 H 0
    goto SelectSwap

   Ready:
    6J02 H 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE7E)
   ReadyX:
    6J02 H 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 H 0 A_JumpIfInventory("NegaMM7_Ammo", args[4], "ReadyHave")
    6J02 H 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyHave")
    goto NoAmmo
   ReadyHave:
    6J02 H 8 A_WeaponReady
    6J02 H 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    goto ReadyX
   ReadyNoAmmo:
    6J02 H 8 A_WeaponReady(4)
    6J02 H 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6J02 H 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 H 0 A_JumpIfInventory("NegaMM7_Ammo", args[4], "ReadyX")
    6J02 H 0 A_JumpIfInventory("NegaReadyRef_F", args[4] <= 0, "ReadyX")
    goto ReadyNoAmmo

   Flash:
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 22, 3)
    TNT1 A 2 A_GiveInventory("WeaponCharge", 1)
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 1, "Flash")
    stop
    TNT1 A 0 A_PlaySound("weapon/coilcharge", 1, 1.0, true)
    stop

   Fire:
    6J02 H 0 A_JumpIf(!CallACS("uh_NegaCanSpendAmmo", 2), "NoAmmo")
    6J02 H 1 A_GunFlash("Flash")
    goto Hold1
   Hold1:
    6J02 H 1 A_JumpIfInventory("WeaponCharge", 3, "HoldStart")
    6J02 A 0 A_ReFire("Hold1")
    goto FireEnd
   HoldStart:
    6J02 H 0 A_PlaySound("weapon/coilstart", 1)
    goto Hold2
   Hold2:
    6J02 K 0 A_JumpIfInventory("WeaponCharge", 22, "Hold3")
    6J02 K 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_7EC1, true)
    6J02 K 0 A_ReFire(1)
    goto FireEnd
    6J02 H 0 A_JumpIfInventory("WeaponCharge", 22, "Hold3")
    6J02 H 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE7E, true)
    6J02 H 0 A_ReFire("Hold2")
    goto FireEnd
   Hold3:
    6J02 L 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_7EC2, true)
    6J02 L 0 A_ReFire(1)
    goto FireEnd
    6J02 M 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_7EC3, true)
    6J02 M 0 A_ReFire(1)
    goto FireEnd
    6J02 H 1 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE7E, true)
    6J02 H 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6J02 H 0 A_ReFire("Hold3")
    goto FireEnd
   BotFire:
    WCOI H 0 A_Jump(16, "FireEnd")
    WCOI H 0 A_ReFire("Hold3")
    goto FireEnd

   FireEnd:
    6J02 J 0 A_GiveInventory("NegaWildCoil_Fire_P")
    6J02 J 0 A_ClearReFire
    6J02 J 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE7E, true)
    6J02 JI 4
    6J02 H 6
    goto ReadyX

   NoAmmo:
    6J02 H 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    goto ReadyNoAmmo
   BotAmmo:
    6J02 H 0 A_GiveInventory("NegaMM7_Ammo", 28)
    goto ReadyX
  }
}

actor NegaWildCoil_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 22, "Fire3C")
    TNT1 A 0 A_JumpIfInventory("WeaponCharge", 8, "Fire2C")
    goto Fire1
   Fire3C:
    TNT1 A 0 A_JumpIfInventory("NegaMM7_Ammo", 10, "Fire3")
   Fire2C:
    TNT1 A 0 A_JumpIfInventory("NegaMM7_Ammo", 5, "Fire2")
    goto Fire1

   Fire1:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NegaTrySpendAmmo", 2, 2)
    TNT1 A 0 A_PlaySound("weapon/coilfire1", 1)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", 25, 0, 0, 4)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", -25, 0, 0, 4)
    goto End
   Fire2:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NegaTrySpendAmmo", 5, 2)
    TNT1 A 0 A_PlaySound("weapon/coilfire1", 1)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", 25, 0, 0, 6)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", -25, 0, 0, 6)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", 50, 0, 0, 6)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil", -50, 0, 0, 6)
    goto End
   Fire3:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_NegaTrySpendAmmo", 10, 2)
    TNT1 A 0 A_PlaySound("weapon/coilfire2", 1)
    TNT1 A 0 A_FireCustomMissile("NegaWildCoil2", 0, 0, 0, 8)
    goto End
   End:
    TNT1 A 0 A_TakeInventory("WeaponCharge")
    stop
  }
}

actor NegaWildCoil : BasicProjectile {
  DamageType "WildCoil"
  Obituary "$OB_WILDCOIL"
  BounceSound "weapon/coilbounce1"
  -NOGRAVITY
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +SKYEXPLODE
  +USEBOUNCESTATE
  BounceFactor 1.2
  WallBounceFactor 1.0
  BounceCount 10
  Damage (60)  // 70
  Radius 12
  Height 14
  Speed 22
  Scale 2.5
  States {
   Spawn:
    X_7E I 0
    X_7E I 0 A_GiveInventory("CutterFlag", 1)
    X_7E I 0 ThrustThingZ(0, 12, 0, 1)
    goto Bouncing
   Bouncing:
    X_7E IJKL 5
    wait
   Bounce.Floor:
    X_7E L 0 A_Stop
    X_7E L 1 A_ScaleVelocity(0.0)
    X_7E L 0 ThrustThingZ(0, 45, 0, 1)
    X_7E L 0 A_TakeInventory("CutterFlag", 1)
    X_7E L 0 A_ChangeFlag("BOUNCEONFLOORS", 0)
   Bounce.Ceiling:
    X_7E KJI 1
    goto Bouncing
   Death:
    X_7E J 0 A_Stop
    X_7E J 0 A_ChangeFlag("NOGRAVITY", 1)
    X_7E J 0 A_PlaySoundEx("weapon/coilexplode", "Voice")
    X_7E J 0 A_JumpIfInventory("CutterFlag", 1, "DeathFX")
    X_7E J 0 A_Explode(90, 100, 0, 0, 25)
    Y_4D PQSTVWY 1 Bright
    stop
   DeathFX:
    UMFX OBCD 2 Bright
    stop
  }
}

actor NegaWildCoil2 : NegaWildCoil {
  DamageType "WildCoil2"
  Obituary "$OB_WILDCOIL"
  +Bright
  BounceSound "weapon/coilbounce2"
  BounceFactor 1.0
  ReactionTime 1
  Damage (250)
  Radius 20
  Height 26
  Speed 28
  Scale 2.5
  States {
   Spawn:
    X_7E N 0
    X_7E N 0 A_GiveInventory("KnightFlag", 1)
    X_7E N 0 ThrustThingZ(0, 18, 0, 1)
    goto Bouncing
   Bouncing:
    X_7E MNOP 5
    wait
   Bounce.Floor:
    X_7E P 0 A_JumpIfInventory("CutterFlag", 1, "Bounce2")
    X_7E P 0 A_Stop
    X_7E P 0 A_ScaleVelocity(0.0)
    X_7E P 0 A_SpawnItemEx("NegaWildCoilBoom1", 0, 0, 16, 0, 0, 0, 0, 1)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 0)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 90)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 180)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 270)
    X_7E P 0 A_SetScale(3.5, 3.5)
    X_7E P 0 ThrustThingZ(0, 65, 0, 1)
    X_7E P 0 A_GiveInventory("CutterFlag", 1)
   Bounce.Ceiling:
    X_7E ONM 1
    goto Bouncing
   Bounce2:
    X_7E P 0 A_SpawnItemEx("NegaWildCoilBoom2", 0, 0, 20, 0, 0, 0, 0, 1)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 45)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 135)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 225)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 315)
    X_7E P 0 A_SetScale(4.5, 4.5)
    X_7E P 0 ThrustThingZ(0, 75, 0, 0)
    X_7E P 0 A_GiveInventory("CutterFlag", 1)
    X_7E P 0 A_TakeInventory("KnightFlag", 1)
    X_7E P 0 A_ChangeFlag("BOUNCEONFLOORS", 0)
    X_7E P 0 A_ChangeFlag("THRUACTORS", 1)
    X_7E ONM 1
    goto Bouncing
   Death:
    X_7E N 0 A_SetGravity(0.0)
    X_7E N 0 A_PlaySoundEx("weapon/coilexplode", "Voice")
    X_7E N 0 A_JumpIfInventory("KnightFlag", 1, 2)
    X_7E N 0 A_SpawnItemEx("NegaWildCoilBoom3", 0, 0, 24, 0, 0, 0, 0, 1)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 0)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 90)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 180)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 270)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 45)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 135)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 225)
    X_7E P 0 A_SpawnItemEx("NegaWildCoil", 0, 0, 2, 10, 0, 10, 315)
    UMFX OBCD 2
    stop
  }
}

actor NegaWildCoilBoom1 : BasicExplosion {
  DamageType "WildCoil2"
  Obituary "$OB_WILDCOIL"
  Scale 2.5
  Args 140, 140, 40
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("weapon/deepdiggerbreak", 1, 0.85)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorY", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}
actor NegaWildCoilBoom2 : NegaWildCoilBoom1 {
  Scale 3.5
  Args 170, 170, 65
}
actor NegaWildCoilBoom3 : NegaWildCoilBoom1 {
  Scale 4.5
  Args 200, 200, 80
}


Actor NegaChillDebris : ChillDebris {
  States {
   Spawn:
    X_AD K 0
    TNT1 A 1 A_Jump(256, "SpawnA", "SpawnB")
    wait
   SpawnA:
    X_AD K 0
    Goto SpawnLoop
   SpawnB:
    X_AD L 0
    Goto SpawnLoop
  }
}

Actor NegaChillSpikeWall : WallSpike {
  +THRUACTORS
  Obituary "$OB_CHILLSPIKE2"
  Damagetype "NegaChillSpike"
  Damage (0)
  Args 32
  Reactiontime 8
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_GiveInventory("Once")
    TNT1 A 0 A_SetUserVar(user_angle, random(1, 120))
    TNT1 A 0 A_PlaySoundEx("weapon/chillspike", "Weapon")
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", 3, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", 3, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", 3, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD F 2
   Spawn2:
    X_AD G 0 A_JumpIfInventory("CutterFlag", 20, "SpawnLoop")
    X_AD G 0 A_Explode(Args[0], 48, 0)
    X_AD G 0 A_SpawnItemEx("NegaChillSpikeWallFX2", 3, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD G 0 A_SpawnItemEx("NegaChillSpikeWallFX2", 3, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD G 0 A_SpawnItemEx("NegaChillSpikeWallFX2", 3, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 1)
    X_AD G 1 A_GiveInventory("CutterFlag", 1)
    loop
   SpawnLoop:
    X_AD F 0 A_TakeInventory("CutterFlag")
    X_AD F 0 A_ChangeFlag("NOINTERACTION", 1)
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD F 0 A_SpawnItemEx("NegaChillSpikeWallFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD F 2 A_Countdown
    TNT1 A 12
    goto Spawn+1
   Death:
    X_AD C 0 A_JumpIfInventory("Once", 1, "DeathReal")
    X_AD C 1 A_JumpIf(true, "DeathVanish")
    wait
   DeathReal:
    X_AD F 0 A_PlaySoundEx("weapon/chillbreak", "Weapon")
    X_AD F 0 A_SpawnItemEx("NegaChillDebris", 0, 0, 28, -random(6, 12), 0, random(2, 6), random(-6, 6), 1)
    X_AD F 0 A_SpawnItemEx("NegaChillDebris", 0, cos(user_angle)*WEPC_10CS_SPIKERADIUS, sin(user_angle)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
    X_AD F 0 A_SpawnItemEx("NegaChillDebris", 0, cos(user_angle+120)*WEPC_10CS_SPIKERADIUS, sin(user_angle+120)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
    X_AD F 0 A_SpawnItemEx("NegaChillDebris", 0, cos(user_angle+240)*WEPC_10CS_SPIKERADIUS, sin(user_angle+240)*WEPC_10CS_SPIKERADIUS, -random(6, 12), 0, random(4, 8), random(-6, 6), 1)
   DeathVanish:
    TNT1 A 0 A_ChangeFlag(NOINTERACTION, true)
    TNT1 A 15
    stop
  }
}

actor NegaChillSpikeCeiling : NegaChillSpike {
  -FLOORHUGGER
  +CEILINGHUGGER
  Args 36
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_SetAngle(random(1, 360))
    TNT1 A 0 A_PlaySoundEx("weapon/chillspike", "Weapon")
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 1)
    X_AD H 2
   Spawn2:
    X_AD I 0 A_JumpIfInventory("CutterFlag", 20, "SpawnLoop")
    X_AD I 0 A_Explode(Args[0], 36, 0)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 1)
    X_AD I 1 A_GiveInventory("CutterFlag", 1)
    loop
   SpawnLoop:
    X_AD H 0 A_TakeInventory("CutterFlag")
    X_AD H 0 A_ChangeFlag("NOINTERACTION", 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD H 0 A_Countdown
    TNT1 AAA 5 A_SpawnItemEx("NegaChillSpikeCeilingProj", random(WEPC_10CS_SPIKERADIUS*0.5, WEPC_10CS_SPIKERADIUS*1.5), 0, -4, 0, 0, random(-15, -25), random(0, 359), 1)
    goto Spawn+1
  }
}

Actor NegaChillSpikeCeilingProj : AstroCrush {
  Obituary "%o was impaled from above by %k's Chill Spike."
  Damagetype "NegaChillSpike"
  +DONTBLAST
  +THRUGHOST
  Damage (40)
  Radius 8
  Height 10
  Scale 2.0
  States {
   Spawn:
    X_AD H 0
    X_AD H 0 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    X_AD HHIIIIIII 1 A_JumpIf(ceilingz-z>10, "Spawn2")
    X_AD D 0 A_JumpIf(momz==0, "Death")
    X_AD D 0 A_CountDown
    Goto Spawn+2
   Spawn2:
    X_AD I 0 A_ChangeFlag("RIPPER", 0)
    X_AD I 0 A_ChangeFlag("NOINTERACTION", 0)
    X_AD III 3 A_ChangeVelocity(0, 0, momz, CVF_RELATIVE|CVF_REPLACE)
    X_AD I 0 A_JumpIf(momz==0, "Death")
    X_AD I 0 A_CountDown
    Goto Spawn2+2
   Death:
    X_AD I 0 A_Stop
    X_AD I 0 A_PlaySoundEx("weapon/chillbreak", "Weapon")
    X_AD I 0 A_Explode(WEPC_10CS_SPIKERADIUS*2.4, 48, 0)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 0, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 120, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 240, 1)
    stop
  }
}


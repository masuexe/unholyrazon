Actor S_NegaChillShot : ChillShot {
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +NOGRAVITY
  Bouncecount 4
  Bouncefactor 0.95
  Obituary "%o was floored by %k's level of chill."
  Gravity 0.8
  Damage (325)
  States {
   Spawn:
    X_AD A 0
    X_AD ABC 2
    loop
   Death:
    X_AD A 0 A_JumpIf(z-floorz<=16, "Death2")
    stop
   Death2:
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpike", 0, 0, -(z-floorz), 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
   Death3:
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpikeCeiling", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
   XDeath:
   Crash:
    TNT1 A 0
    stop
  }
}

Actor S_NegaChillShot2 : S_NegaChillShot {
  -BOUNCEONWALLS
  States {

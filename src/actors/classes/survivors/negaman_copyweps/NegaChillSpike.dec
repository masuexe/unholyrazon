Actor S_NegaChillSpikeWall : NegaChillSpikeWall { Args 64 }

actor S_NegaChillSpikeCeiling : NegaChillSpikeCeiling {
  Args 56
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_SetAngle(random(1, 360))
    TNT1 A 0 A_PlaySoundEx("weapon/chillspike", "Weapon")
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 1)
    X_AD H 2
   Spawn2:
    X_AD I 0 A_JumpIfInventory("CutterFlag", 20, "SpawnLoop")
    X_AD I 0 A_Explode(WEPC_10CS_SPIKERADIUS*1.4, 36, 0)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillSpikeCeilingFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 1)
    X_AD I 1 A_GiveInventory("CutterFlag", 1)
    loop
   SpawnLoop:
    X_AD H 0 A_TakeInventory("CutterFlag")
    X_AD H 0 A_ChangeFlag("NOINTERACTION", 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD H 0 A_SpawnItemEx("NegaChillSpikeCeilingFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD H 0 A_Countdown
    TNT1 AAA 5 A_SpawnItemEx("S_NegaChillSpikeCeilingProj", random(WEPC_10CS_SPIKERADIUS*0.5, WEPC_10CS_SPIKERADIUS*1.5), 0, -4, 0, 0, random(-15, -25), random(0, 359), 1)
    goto Spawn+1
  }
}

Actor S_NegaChillSpikeCeilingProj : NegaChillSpikeCeilingProj {
  Damage (60)
  States {
   Death:
    X_AD I 0 A_Stop
    X_AD I 0 A_PlaySoundEx("weapon/chillbreak", "Weapon")
    X_AD I 0 A_Explode(WEPC_10CS_SPIKERADIUS*3.6, 56, 0, 0, 8)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 0, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 120, 1)
    X_AD I 0 A_SpawnItemEx("NegaChillDebris", 8, 0, 0, random(4, 8), random(4, 8), random(4, 8), 240, 1)
    stop
  }
}

    X_AD A 0 A_JumpIf(z-floorz<=16, "Death2")
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpikeWall", 0, 0, -(ceilingz-z<56) * (56-(ceilingz-z)) - (z-floorz > (ceilingz-z < 56)*(56-(ceilingz-z))+14)*14, 0, 0, 0, 0, 1)
    X_AD A 0
    stop
   Death2:
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpikeSpawner", 0, 0, 0, 6, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
  }
}

Actor S_NegaChillShot3 : S_NegaChillShot {
  -BOUNCEONWALLS
  -BOUNCEONCEILINGS
  States {
   Death:
    X_AD A 0 A_JumpIf(z-floorz<=16, "Death2")
    X_AD A 0 A_JumpIf(ceilingz-z<=25, "Death3")
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpikeWall", 0, 0, -(ceilingz-z<56) * (56-(ceilingz-z)) - (z-floorz > (ceilingz-z < 56)*(56-(ceilingz-z))+14)*14, 0, 0, 0, 0, 1)
    X_AD A 0
    stop
   Death2:
    X_AD A 0 A_SpawnItemEx("S_NegaChillSpikeSpawner2", 0, 0, 0, 6, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
  }
}

Actor S_NegaChillSpikeSpawner {
  PROJECTILE
  +DONTBLAST
  +NOEXPLODEFLOOR
  +FLOORHUGGER
  +THRUACTORS
  +RIPPER
  -NOGRAVITY
  Radius 4
  Height 4
  Damage (0)
  Speed 6
  Reactiontime 8
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 4
    TNT1 A 18 A_SpawnItemEx("S_NegaChillSpike", 0, 0, -(z-floorz), 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    TNT1 A 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    stop
  }
}

Actor S_NegaChillSpikeSpawner2 : S_NegaChillSpikeSpawner {
  +SEEKERMISSILE
  +LOOKALLAROUND
  Reactiontime 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2
    TNT1 A 0 A_SpawnItemEx("S_NegaChillSpike", 0, 0, -(z-floorz), 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    TNT1 AAAAAA 2 A_SeekerMissile(15, 25, SMF_LOOK|SMF_PRECISE, 256, 12)
    TNT1 A 0 A_Countdown
    goto Spawn+2
   Death:
    TNT1 A 0
    stop
  }
}


    CHIL H 0 A_SpawnItemEx("NegaChillDebris", WEPC_10CS_SPIKERADIUS, 0, 0, random(6, 12), random(6, 12), random(6, 12), 120, 1)
    CHIL H 0 A_SpawnItemEx("NegaChillDebris", WEPC_10CS_SPIKERADIUS, 0, 0, random(6, 12), random(6, 12), random(6, 12), 240, 1)
    TNT1 A 15
    stop
  }
}


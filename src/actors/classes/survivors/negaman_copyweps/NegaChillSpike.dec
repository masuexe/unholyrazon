// TODO: there is a graphical problem about chill spike vanishing

actor NegaChillSpikeWep_NegaManBar : NegaManBar {args 10, 207}

actor NegaChillSpikeWep : BaseNegaManWep {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Weapon.SlotNumber 4
  Inventory.Pickupmessage "Power Up! Nega Chill Spike!"  // $PU_02_MM10D
  Obituary "$OB_CHILLSPIKE"
  Tag "Nega Chill Spike"
  weapon.ammotype "NegaMM10_Ammo"
  inventory.icon "NEG_CHIL"
  States {
   Spawn:
    6N02 X 0
    goto SpawnFrame
   Deselect:
    6J02 Z 0
    goto DeselectSwap
   Select:
    6J02 Z 0
    goto SelectSwap

   Ready:
    6J02 Z 0 ACS_NamedExecuteWithResult("core_weaponcolor", NEGAMAN_DYE10D)
   ReadyX:
    6J02 Z 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 Z 0 A_JumpIfInventory("NegaMM10_Ammo", Args[4], "ReadyHave")
    6J02 Z 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyHave")
    Goto NoAmmo
   ReadyHave:
    6J02 Z 10 A_WeaponReady
    6J02 Z 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    Goto ReadyX
   ReadyNoAmmo:
    6J02 Z 10 A_WeaponReady(4)
    6J02 Z 0 ACS_NamedExecuteWithResult("uh_CopyWepReadyRegen", 1)
    6J02 Z 0 A_SetArg(4, CallACS("uh_NegaReadyCost", 2))
    6J02 Z 0 A_JumpIfInventory("NegaMM10_Ammo", Args[4], "ReadyX")
    6J02 Z 0 A_JumpIfInventory("NegaReadyRef_F", Args[4] <= 0, "ReadyX")
    Goto ReadyNoAmmo

   Fire:
    6J02 Z 0 A_JumpIf(!CallACS("uh_NegaTrySpendAmmo", 2), "NoAmmo")
    6J02 Z 0 A_PlaySoundEx("weapon/chillshot", "Weapon")
    6J02 Z 0 A_FireCustomMissile("NegaChillShot", 0, 1, 8, 0)
    6K02 AB 3
    6J02 Z 12
    6J02 Z 0 A_Refire
    goto ReadyX

   NoAmmo:
    6J02 Z 1 A_JumpIfInventory("IsBot", 1, "NoAmmo_B")
    Goto ReadyNoAmmo
   BotAmmo:
    6J02 Z 0 A_GiveInventory("NegaMM10_Ammo", 28)
    goto ReadyX
  }
}

Actor NegaChillShot : ChillShot {
  +NOGRAVITY
  Translation "192:192=205:205", "198:198=77:77"
  Obituary "%o was floored by %k's level of chill."
  Gravity 0.8
  Damage (160)
  States {
   Spawn:
    X_AD A 0
    X_AD ABC 2
    loop
   Death:
    X_AD A 0 A_JumpIf(z-floorz<=16, "Death2")
    X_AD A 0 A_JumpIf(ceilingz-z<=25, "Death3")
    X_AD A 0 A_SpawnItemEx("NegaChillSpikeWall", 0, 0, -(ceilingz-z<56) * (56-(ceilingz-z)) - (z-floorz > (ceilingz-z < 56)*(56-(ceilingz-z))+14)*14, 0, 0, 0, 0, 1)
    X_AD D 0
    stop
   Death2:
    X_AD A 0 A_SpawnItemEx("NegaChillSpike", 0, 0, -(z-floorz), 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
   Death3:
    X_AD A 0 A_SpawnItemEx("NegaChillSpikeCeiling", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPITCH|SXF_TRANSFERTRANSLATION)
    X_AD D 0
    stop
  }
}

Actor NegaChillSpike : ChillSpike {
  Translation "192:192=205:205", "198:198=77:77"
  +THRUACTORS
  // Some reminder that perhaps this needs a protection painstate later depending on damage handling
  Obituary "$OB_CHILLSPIKE2"  // %o was not cool enough to survive %k's Nega Ice Spike.
  Damagetype "NegaChillSpike"  // the other one freezes, that ain't good once you step within even 1 of them
  Damage (0)
  Args 28
  Reactiontime 8
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 0)
    TNT1 A 0 A_SetAngle(random(1, 360))
    TNT1 A 0 A_PlaySoundEx("weapon/chillspike", "Weapon")
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD D 2
   Spawn2:
    X_AD E 0 A_JumpIfInventory("CutterFlag", 20, "SpawnLoop")
    X_AD E 0 A_Explode(Args[0], 36, 0)
    X_AD E 0 A_SpawnItemEx("NegaChillSpikeFloorFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD E 0 A_SpawnItemEx("NegaChillSpikeFloorFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD E 0 A_SpawnItemEx("NegaChillSpikeFloorFX2", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD E 1 A_GiveInventory("CutterFlag", 1)
    loop
   SpawnLoop:
    X_AD D 0 A_TakeInventory("CutterFlag")
    X_AD D 0 A_ChangeFlag("NOINTERACTION", 1)
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 0, 0, 1)
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 120, 0, 1)
    X_AD D 0 A_SpawnItemEx("NegaChillSpikeFloorFX1", WEPC_10CS_SPIKERADIUS, 0, 0, 0, 0, 0, 240, 0, 1)
    X_AD D 2 A_Countdown
    TNT1 A 12
    goto Spawn+1
   Death:
    CHIL B 0 A_PlaySoundEx("weapon/chillbreak", "Weapon")
    CHIL H 0 A_SpawnItemEx("NegaChillDebris", 0, 0, 0, random(6, 12), random(6, 12), random(6, 12), 0, 1)
    CHIL H 0 A_SpawnItemEx("NegaChillDebris", WEPC_10CS_SPIKERADIUS, 0, 0, random(6, 12), random(6, 12), random(6, 12), 0, 1)
    CHIL H 0 A_SpawnItemEx("NegaChillDebris", WEPC_10CS_SPIKERADIUS, 0, 0, random(6, 12), random(6, 12), random(6, 12), 120, 1)
    CHIL H 0 A_SpawnItemEx("NegaChillDebris", WEPC_10CS_SPIKERADIUS, 0, 0, random(6, 12), random(6, 12), random(6, 12), 240, 1)
    TNT1 A 15
    stop
  }
}

Actor NegaChillSpikeFloorFX1 : BasicGraphicEffect {
  Translation "192:192=205:205", "198:198=77:77"
  States {
   SpawnFrame:
    X_AD D 3
    stop
  }
}

Actor NegaChillSpikeFloorFX2 : NegaChillSpikeFloorFX1 {

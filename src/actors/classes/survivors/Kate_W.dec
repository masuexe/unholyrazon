actor Kate_W_NormalBar : NormalBar {args 4, 203}

actor Kate_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_53_A"
  Obituary "$OB_53W1"
  Tag "$TAG_Kate_W"
  weapon.ammotype "MistCloakAmmo"
  inventory.icon "C_I_53A"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H53 [ 6
    loop

   Deselect:
    6H53 A 0
    goto DeselectSwap
   Select:
    6H53 A 0
    goto SelectSwap

   Ready:
    6H53 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", KATE_DYE)
    goto Ready2
   Ready2:
    6H53 A 0 A_JumpIfInventory("KateMistFlag", 1, "ReadyX")
    6H53 A 2 A_GiveInventory("Kate_WepReady_P")
    wait
   ReadyX:
    6H53 L 2 A_GiveInventory("Kate_WepReady_P")
    6H53 L 0 A_JumpIfInventory("MistCloakAmmo", 1, "ReadyX")
    6H53 L 0 A_GiveInventory("Kate_AltOff_P")
    6H53 KJI 2 A_WeaponReady(WRF_NOSECONDARY)
    Goto Ready2+1

   BotFire:
    6H53 A 0 A_JumpIfInventory("MistCloakAmmo", 0, "BotFire2")
    6H53 A 0 A_Jump(16, 2)
    6H53 A 0 A_Jump(2, "BotSwap")
    goto Fire+1
    6H53 A 0 A_PlaySoundEx("taunt/D_53", "Voice")
    6H53 A 0 A_GiveInventory("MistCloakAmmo", random(45, 90))
    goto Fire+1
   BotFire2:
    6H53 A 0 A_Jump(16, "AltfireDash")
    6H53 A 0 A_Jump(64, "BotSwap")
    goto Fire+1

   BotSwap:
    6H53 A 0 A_PlaySoundEx("taunt/D_53", "Voice")
    6H53 A 0 A_GiveInventory("MistCloakAmmo", 300)
    6H53 A 0 A_SelectWeapon("Kate_W2")
    goto Altfire2

   Fire:
    6H53 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H53 B 2 A_GiveInventory("Kate_Fire_P1")
    6H53 CDEFZZZGHA 2
    Goto Ready2

   Altfire:
    6H53 A 0 A_JumpIfInventory("KateMistFlag", 1, "AltfireDash")
    6H53 A 0 A_JumpIfInventory("MistCloakAmmo", 0, "Altfire2")
    Goto Ready2

   Altfire2:
    6H53 A 2 A_GiveInventory("Kate_AltOn_P")
    6H53 A 0 A_Refire("Altfire3")
    Goto ReadyX
   Altfire3:
    6H53 A 1 A_TakeInventory("MistCloakAmmo", 1)
    6H53 A 0 A_Refire(1)
    Goto ReadyX
    6H53 A 0 A_JumpIfInventory("MistCloakAmmo", 1, 1)
    Goto ReadyX+2
    6H53 A 1 A_TakeInventory("MistCloakAmmo", 1, 1)
    6H53 A 0 A_Refire(1)
    Goto ReadyX
    6H53 A 0 A_JumpIfInventory("MistCloakAmmo", 1, "Altfire3")
    Goto ReadyX+2

   AltfireDash:
    6H53 K 2 A_GiveInventory("Kate_AltDash_P")
    6H53 JI 2
    Goto Ready2
  }
}

actor Kate_W2_NormalBar : Kate_W_NormalBar {}
actor Kate_W2 : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 150
  Inventory.Pickupmessage "$PU_53_B"
  Obituary "$OB_53W2"
  Tag "$TAG_Kate_W2"
  weapon.ammotype "MistCloakAmmo"
  inventory.icon "C_I_53B"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H53 [ 6
    loop

   Deselect:
    6H53 M 0
    goto DeselectSwap
   Select:
    6H53 M 0
    goto SelectSwap

   Ready:
    6H53 M 0 ACS_NamedExecuteWithResult("core_weaponcolor", KATE_DYE)
    goto Ready2
   Ready2:
    6H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "ReadyX")
    6H53 M 2 A_GiveInventory("Kate_WepReady_P")
    wait
   ReadyX:
    6H53 Y 2 A_GiveInventory("Kate_WepReady_P")
    6H53 Y 0 A_JumpIfInventory("MistCloakAmmo", 1, "ReadyX")
    6H53 Y 0 A_GiveInventory("Kate_AltOff_P")
    6H53 XWV 2 A_WeaponReady(WRF_NOSECONDARY)
    Goto Ready2+1

   BotFire:
    6H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "BotFire2")
    6H53 M 0 A_Jump(16, "BotFireX")
    6H53 M 0 A_JumpIfCloser(256, 2)
    6H53 M 0 A_Jump(196, "BotSwap")
    goto Fire+1
    6H53 M 0 A_Jump(16, "BotSwap")
    goto Fire+1
   BotFire2:
    6H53 M 0 A_Jump(1, "AltfireDash")
    6H53 M 1 A_Recoil(-2)
    6H53 M 0 A_JumpIfCloser(128, 3)
    6H53 M 0 A_Jump(5, "BotFireX")
    6H53 M 0 A_Refire("Fire")
    goto Ready2
    6H53 M 0 A_FaceTarget
    goto Fire+1
   BotFireX:
    6H53 M 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    6H53 M 0 A_PlaySoundEx("taunt/D_53", "Voice")
    6H53 M 0 A_Warp(2)
    6H53 M 0 A_FaceTarget
    goto Fire+1

   BotSwap:
    6H53 M 0 A_PlaySoundEx("taunt/D_53", "Voice")
    6H53 M 0 A_GiveInventory("MistCloakAmmo", random(75, 150))
    6H53 M 0 A_SelectWeapon("Kate_W")
    6H53 M 1 A_WeaponReady
    wait

   Fire:
    6H53 M 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H53 M 0 A_GiveInventory("Kate_Fire_P2")
    6H53 M 1 Offset(-37, 8)//A_FireCustomMissile("KateMeleeStab",0,0,16,0)
    6H53 N 1 Offset(-70, 29)//A_FireCustomMissile("KateMeleeStab",0,0,0,0)
    6H53 N 1 Offset(-90, 39)//A_FireCustomMissile("KateMeleeStab",0,0,-16,0)
    6H53 N 1 Offset(-107, 50)
    6H53 N 6 Offset(-127, 63)
    6H53 N 2 Offset(-97, 55)
    6H53 N 2 Offset(-67, 48)
    6H53 N 2 Offset(-37, 42)
    6H53 M 2 Offset(-20, 24)
    Goto Ready2

   Altfire:
    6H53 M 0 A_JumpIfInventory("KateMistFlag", 1, "AltfireDash")
    6H53 M 0 A_JumpIfInventory("MistCloakAmmo", 0, "Altfire2")
    Goto Ready2

   Altfire2:
    6H53 M 2 A_GiveInventory("Kate_AltOn_P")
    6H53 M 0 A_Refire("Altfire3")
    Goto ReadyX
   Altfire3:
    6H53 M 1 A_TakeInventory("MistCloakAmmo", 1)
    6H53 M 0 A_Refire(1)
    Goto ReadyX
    6H53 M 0 A_JumpIfInventory("MistCloakAmmo", 1, 1)
    Goto ReadyX+2
    6H53 M 1 A_TakeInventory("MistCloakAmmo", 1, 1)
    6H53 M 0 A_Refire(1)
    Goto ReadyX
    6H53 M 0 A_JumpIfInventory("MistCloakAmmo", 1, "Altfire3")
    Goto ReadyX+2

   AltfireDash:
    6H53 X 2 A_GiveInventory("Kate_AltDash_P")
    6H53 WV 2
    Goto Ready2
  }
}

actor MistCloakAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 300
  +INVENTORY.IGNORESKILL
}

actor KateMistFlag : UOnce {}

actor Kate_WepReady_P : CustomInventory {
  States {
   Pickup:
   Ready2:
    TNT1 A 0 A_JumpIfInventory("KateMistFlag", 1, "ReadyX")
    TNT1 A 0 A_JumpIfInventory("MistCloakAmmo", 0, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 2)
    stop
   Ready3:
    TNT1 A 0 A_WeaponReady
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 2)
    stop
   ReadyX:
    TNT1 A 0 A_WeaponReady
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 1, 1)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 1)
    stop
  }
}

actor Kate_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("KateShadowBlade", 0, 0, 8, 0)
    TNT1 A 0 A_PlaySound("weapon/shadow", 1)
    TNT1 A 0 A_JumpIfInventory("KateMistFlag", 1, "Take")
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 10)
    stop
   Take:
    TNT1 A 0 A_GiveInventory("Kate_AltOff_P")
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 40, 1)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 40)
    stop
  }
}

actor Kate_Fire_P2 : Kate_Fire_P1 {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("KateMeleeStab", 0, 0, 0, 0)
    TNT1 A 0 A_PlaySound("wep/KateStab", 1)//B_Toad/Swipe
    TNT1 A 0 A_JumpIfInventory("KateMistFlag", 1, "Take")
    TNT1 A 0 A_GiveInventory("MistCloakAmmo", 10)
    stop
  }
}

actor Kate_AltOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("KateShardFX_H")
    TNT1 A 0 A_SpawnItemEx("KateMistFX_H")
   Pickup0:
    TNT1 A 0 A_GiveInventory("KateMistFlag", 1)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 5)
    TNT1 A 0 A_PlaySound("weapon/centaurflash", 4)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
    TNT1 A 0 A_GiveInventory("UH_00_AlphaPowerGiver")
    stop
  }
}
actor Kate_AltOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("KateShardFX_H")
   Pickup0:
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 1)
    TNT1 A 0 A_TakeInventory("KateMistFlag")
    TNT1 A 0 A_TakeInventory("UH_00_AlphaPower")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
    stop
  }
}

actor Kate_AltDash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("KateMistFX_H")
    TNT1 A 0 A_GiveInventory("Kate_AltOff_P")
   Pickup0:
    TNT1 A 0 A_ChangeVelocity(cos(pitch)*80, 0, -sin(pitch)*28, 3)
    TNT1 A 0 A_PlaySound("weapon/tengudash", 4)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 35, 1)
    TNT1 A 0 A_TakeInventory("MistCloakAmmo", 30)
    stop
  }
}


actor KateShadowBlade : BasicProjectile {
  Translation "192:192=4:4", "198:198=203:203", "247:247=194:194"
  damagetype "Kate"
  Obituary "$OB_53M1"
  +RIPPER
  +SKYEXPLODE
  //+HEXENBOUNCE
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +CANBOUNCEWATER
  +ALLOWBOUNCEONACTORS
  WALLBOUNCEFACTOR 1.0
  BOUNCEFACTOR 1.0
  Damage (125)
  Radius 10
  Height 16
  Speed 60
  scale 4.0
  States {
   Spawn:
    X_3H ABABABABABAB 1 A_SpawnItemEx("KateShadowBladeFX", 0, 0, 0, 0, 0, 0, 0, 1)
    X_3H A 0 A_ScaleVelocity(-1)
    X_3H ABABABABABAB 1 A_SpawnItemEx("KateShadowBladeFX", 0, 0, 0, 0, 0, 0, 0, 1)
    Stop
   Death:
    TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
    TNT1 A 1
    stop
  }
}

actor KateShadowBladeFX : BasicClientSide {
  scale 4.0
  States {
   Spawn:
    TNT1 A 1
    X_3H AB 1 A_Fadeout(0.13)
    goto Spawn+1
  }
}


actor KateSuddenSlash : BasicExplosion {
  damagetype "Kate"
  Obituary "$OB_53A"
  states {
   Spawn:
    TNT1 A 0
    TNT1 AA 0 A_SpawnItemEx("KateMistFX", random(-5, 0), random(-20, 20), random(0, 70), 0, 0, 0, 0, 32)
    TNT1 A 1 A_Explode(120, 110, 0)
    stop
  }
}

actor KateShardFX_H : BasicWatcher {
  Translation "192:192=206:206", "198:198=195:195"
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("KateShardFX", random(-2, 2), random(-2, 2), random(8, 56), random(-4, 4), random(-4, 4), random(2, 8), 0, 1+32)
    stop
  }
}
actor KateShardFX {
  Translation "192:192=206:206", "198:198=195:195"
  +CLIENTSIDEONLY
  +MISSILE
  -SOLID
  -NOGRAVITY
  -NOINTERACTION
  +THRUACTORS
  +NOPAIN
  +FORCEXYBILLBOARD
  +HEXENBOUNCE
  +DONTSPLASH
  BounceCount 3
  BOUNCEFACTOR 0.35
  Radius 4
  Height 4
  Scale 2.5
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P53 A 4
    wait
    6P53 B 4
    wait
    6P53 C 4
    wait
    6P53 D 4
    wait

   Death:
    "----" "#" 0 A_SetGravity(0.0)
    "----" "######" 1 A_Fadeout
    stop
  }
}

actor KateMistFX_H : BasicClientSide {
  Translation "192:192=201:201", "198:198=205:205"
  ReactionTime 24 //40
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Warp(2, 0, 0, 0, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 1 A_SpawnItemEx("KateMistFX", random(-15, 15), random(-20, 20), random(0, 70), 0, 0, 0, 0, 1+32)
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor KateMistFX : BasicClientSide {
  Translation "192:192=201:201", "198:198=198:198"
  +MISSILE
  +FORCEXYBILLBOARD
  renderstyle add
  speed 30
  scale 1.5
  States {
   Spawn:
    X_BC KLMKLMKLMKLM 2 A_FadeOut(0.04)
    stop
  }
}



actor KateMeleeStab : BasicFastProjectile {
  Translation "192:192=203:203", "198:198=194:194"
  damagetype "KateBackstab"
  Obituary "$OB_53M2"
  +DONTBLAST
  +DONTSPLASH
  reactiontime 1
  damage (10)//105
  Radius 20
  Height 20
  speed 210//70
  States {
   Spawn:
    TNT1 AA 0
    //TNT1 AA 1
    stop
   XDeath:
    TNT1 A 1
    stop
   Death:
    TNT1 A 1 //A_Explode(10,64,0,0,64)
    TNT1 A 1 A_SpawnItemEx("KateMeleeStabFx", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor KateMeleeStabFx : BasicClientSide {
  +FORCEXYBILLBOARD
  States {
   Spawn:
    6P53 EFE 2
    stop
  }
}

actor KateMeleeStabFront : BasicExplosion {
  Translation "192:192=203:203", "198:198=194:194"
  damagetype "Kate"
  Obituary "$OB_53M3"
  +FORCEXYBILLBOARD
  Scale 2.5
  Args 200
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Pokemon/FireSpin", 2, 0.75)
    TNT1 A 0 A_Explode(Args[0], 15, 0, 0, 15)
    6P53 LJI 3
    stop
  }
}

actor KateMeleeStabBack : KateMeleeStabFront {
  Obituary "$OB_53M4"
  Args 1200
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("KirbyNES/Hit_D", 2, 1.0)
    TNT1 A 0 A_Explode(Args[0], 15, 0, 0, 15)
    6P53 LKJ 3
    stop
  }
}

actor PainKateBackstabHit : BasicWatcher {
  var int user_A;
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetArg(4, CallACS("core_getptrtid", 2))
    TNT1 A 0 A_TransferPointer(2, 0, 2, 2)
    TNT1 A 0 A_SetUserVar("user_A", angle)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SetUserVar("user_A", angle-user_A)
    TNT1 A 0 Thing_Move(0, Args[4], 1)
    TNT1 A 0 A_JumpIf((user_A>90 && user_A<270)||(user_A<-90 && user_A>-270), "Back")
    TNT1 A 0 A_JumpIf(1, "Front")
   Front:
    TNT1 A 3 A_SpawnItemEx("KateMeleeStabFront", 0, 0, 32)
    stop
   Back:
    TNT1 A 3 A_SpawnItemEx("KateMeleeStabBack", 0, 0, 32)
    stop
  }
}

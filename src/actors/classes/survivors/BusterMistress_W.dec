actor BusterMistress_W_ScriptBar : ScriptBar {}

actor BusterMistress_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 300
Inventory.Pickupmessage "$PU_04"
Obituary "$OB_04W"
Tag "$TAG_BusterMistress_W"
weapon.ammotype "SeductiveEnergyAmmo"
States
{
Spawn:
6H04 [ 6
loop

Deselect:
6H04 A 0
goto DeselectSwap
Select:
6H04 A 0
goto SelectSwap

Ready:
6H04 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BUSTERMISTRESS_DYE)
goto Ready2
Ready2:
6H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"Ready2X")
6H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,"Ready3")
6H04 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",3)
loop
Ready3:
6H04 A 2 A_WeaponReady
6H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",3)
loop
Ready2X:
6H04 A 1 A_WeaponReady
goto Ready2

Fire:
6H04 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H04 A 0 A_GiveInventory("BusterMistressMainF_P")
6H04 CBAA 4
Goto Ready2

BotFire:
6H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"BotFire2")
6H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,1)
goto Fire+1
6H04 A 0 A_Jump(16,"BOOMBADDABOOM")
6H04 A 0 A_Jump(64,1)
goto Fire+1
6H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",10)
goto Fire+1
BotFire2:
6H04 A 0 A_Jump(64,"BotFire3")
6H04 A 0 A_Jump(32,1)
goto Fire+1
6H04 A 0 A_GiveInventory("SeductiveEnergyAmmo",10)
goto Fire+1
BotFire3:
6H04 A 0 A_PlaySoundEx("classes/taunt/bustermistress","Voice")
6H04 A 0 A_FireCustomMissile("MistressCopyVisionSpawner",0,0,0,0,0,0)
goto Fire+1

Flash:
TNT1 A 0 A_JumpIfInventory("BusterMistressCloneKill_F",1,3)
TNT1 A 1 A_TakeInventory("SeductiveEnergyAmmo",1,1)
TNT1 A 1 A_JumpIfInventory("SeductiveEnergyAmmo",1,"Flash")
TNT1 A 0 A_TakeInventory("BusterMistressCloneFlag2")
TNT1 A 1 A_GiveInventory("BusterMistressCloneKill_F")
stop


AltFire:
6H04 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,"AltfireCloneOff")
6H04 A 0 A_JumpIfInventory("SeductiveEnergyAmmo",50,"BOOMBADDABOOM")
Goto Ready2
BOOMBADDABOOM:
6H04 A 0 A_FireCustomMissile("MistressCopyVisionSpawner",0,0,0,0,0,0)
6H04 A 0 A_TakeInventory("BusterMistressCloneKill_F")
6H04 A 0 A_GiveInventory("BusterMistressCloneFlag2")
6H04 A 0 A_TakeInventory("SeductiveEnergyAmmo",8)
6H04 ADEF 2
6H04 A 0 A_GunFlash("Flash",1)
goto Ready2
AltfireCloneOff:
6H04 F 0 A_GiveInventory("BusterMistressCloneKill_F")
6H04 F 0 A_GiveInventory("SeductiveEnergyAmmo",8)
6H04 FEDA 2
6H04 A 0 A_TakeInventory("BusterMistressCloneFlag2")
goto Ready2
}
}

actor SeductiveEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor BusterMistressFiredFlag : PowerUp{Powerup.Duration 4}
actor BusterMistressCloneKill_F : Once {}
actor BusterMistressCloneFlag2 : Once {}

actor BusterMistressMainF_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("BusterMistress/Pew",1,0.725)//weapon/mbuster
TNT1 A 0 A_FireCustomMissile("MistressShot",0,0,8,0)
TNT1 A 0 A_JumpIfInventory("BusterMistressCloneFlag2",1,2)
TNT1 A 0 A_GiveInventory("SeductiveEnergyAmmo",16)
stop
TNT1 A 0 A_GiveInventory("BusterMistressFiredFlag")
// TNT1 A 0 A_GiveInventory("UH_TargetMarker")
stop
}
}

actor MistressShot : BasicProjectile
{
Translation "192:192=38:38","198:198=41:41","202:202=4:4","199:199=41:41"
//Translation "87:87=38:38","42:42=41:41","209:215=41:41"
damagetype "Seductive"
Obituary "$OB_04M"
+SKYEXPLODE
+EXPLODEONWATER
+BRIGHT
Damage (85)
radius 12
height 12
Speed 55
scale 2.5
Args 85,108,15
States
{
Spawn:
X_0A ABCBC 2 A_SpawnItemEx("MissShotFX",0,0,0,4,0,0,random(-1,1)*55,1)
Y_0A B 2 A_SpawnItemEx("MissShotFX",0,0,0,4,0,0,random(-1,1)*55,1)
X_0A CBCB 2 A_SpawnItemEx("MissShotFX",0,0,0,4,0,0,random(-1,1)*55,1)
Y_0A C 2 A_SpawnItemEx("MissShotFX",0,0,0,4,0,0,random(-1,1)*55,1)
goto Spawn+1
Death:
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorY",0,0,0,0,0,0,0,1)
stop
}
}

actor MissShotFX : BasicClientSide
{
States
{
Spawn:
UMFX BBCD 2 A_Fadeout
stop
}
}

actor MistressCopyVisionSpawner : BasicProjectile
{
Translation "192:192=40:40","198:198=3:3","0:0=41:41","247:247=41:41","4:4=3:3","168:168=3:3","208:208=3:3","210:210=40:40","183:183=40:40","165:165=38:38"
+DONTBLAST
+DONTREFLECT
+THRUACTORS
Damage(0)
Radius 16
Height 2
Speed 24
States
{
Spawn:
TNT1 A 0
TNT1 A 1
Death:
TNT1 A 0 A_SpawnItemEx("MistressCopyVision",0,0,-32,0,0,0,0,1)
stop
}
}

actor MistressCopyVision : BasicProjectile
{
+THRUGHOST
+THRUACTORS
+NOCLIP
+DONTREFLECT
+DONTBLAST
+BRIGHT
RenderStyle "Translucent"
Alpha 0.70
Damage (0)
Radius 16
Height 32
Speed 0
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/mmb/copyvisionactivate","weapon")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch",2,0)
1H04 A 1
TNT1 A 1
1H04 A 1
TNT1 A 1
1H04 A 1
TNT1 A 1
Goto Waiting
Waiting:
1H04 A 1 //A_GiveToTarget("UH_TargetMarker",1)
1H04 A 0 A_JumpIfInTargetInventory("BusterMistressFiredFlag",1,"FireTime")
1H04 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Death")
1H04 A 0 A_JumpIfInTargetInventory("BusterMistressCloneKill_F",1,"Death")
loop
FireTime:
1H04 F 0 A_GiveToTarget("UH_TargetMarker",1)
1H04 F 0 ACS_NamedExecuteWithResult("core_aimattargetcursor", CallACS("core_gettarget")+PLN_TARGETPOINT_OFFSET, 32)
1H04 F 0 A_PlaySoundEx("weapon/minchrgshot","Body")
1H04 F 0 A_SpawnItemEx("MistressCopyShot",cos(-pitch)*8,0,32+(sin(-pitch)*8),cos(-pitch),0,sin(-pitch),Random(-2,2),SXF_MULTIPLYSPEED)//8192
//1H04 F 0 A_CustomMissile("MistressCopyShot",32,0,Random(-2,2),2,-pitch)
1H04 F 5
1H04 FF 1
Goto Waiting
Death:
1H04 H 0 A_PlaySoundEx("wep_L/mmb/copyvisionactivate","weapon")
1H04 H 1 A_Fadeout
wait
}
}


actor MistressCopyShot : MistressShot
{
damagetype "SeductiveClone"
Obituary "$OB_04A"
}


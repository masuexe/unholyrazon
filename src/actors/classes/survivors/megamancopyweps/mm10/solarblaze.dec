actor SolarBlazeWepU_NormalBar : SolarBlazeWep_NormalBar {}

actor SolarBlazeWepU : BaseMM8BDMCustWep replaces SolarBlazeWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 30
Weapon.SlotNumber 5
Obituary "$OB_SOLARBLAZE"
Tag "$TAG_SOLARBLAZE"
Inventory.Pickupmessage "$PU_SOLARBLAZE"
weapon.ammotype "SolarBlazeAmmo"
inventory.icon "SOLARI"
States
{
SpawnLoop:
SOLA A -1
loop
Ready:
SOLA F 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SOLARBLAZE)
SOLA F 1 A_WeaponReady
Goto Ready+1
Deselect:
SOLA F 0
goto DeselectSwap
Select:
SOLA F 0
goto SelectSwap
Fire:
SOLA F 0 A_JumpIfNoAmmo("NoAmmo")
SOLA F 0 A_PlaySoundEx("weapons/mm10/solarblazefire","Weapon")
SOLA F 0 A_FireCustomMissile("SolarBlazeU",0,1,8,-16)
SOLA F 0 A_GiveInventory("SolarBlazeCooldown", 1)
SOLA GH 3
SOLA F 0 A_JumpIfInventory("IsBot", 1, "BotCheck")
SOLA F 0 A_Refire
Goto Hold
AltFire:
SOLA F 0 A_JumpIfNoAmmo("NoAmmo")
SOLA F 0 A_PlaySoundEx("weapons/mm10/solarblazefire","Weapon")
SOLA F 0 A_FireCustomMissile("SolarBlazeU",0,1,8,-16)
SOLA GH 3
SOLA F 1
SOLA F 2 A_GiveInventory("SolarBlazeFlag",2)
SOLA F 27
SOLA F 0 A_TakeInventory("SolarBlazeFlag",999)
SOLA F 0 A_ClearRefire
Goto Ready+1
Hold:
SOLA F 1 A_RailWait
SOLA F 0 A_Refire
Release:
SOLA F 5 A_GiveInventory("SolarBlazeFlag",2)
SOLA F 0 A_TakeInventory("SolarBlazeFlag",999)
ReleaseWait:
SOLA F 1 A_RailWait
SOLA F 0 A_JumpIfInventory("SolarBlazeCooldown", 1, "ReleaseWait")
SOLA F 1 A_JumpIf(true, "ReleaseEnd")
wait
ReleaseEnd:
SOLA F 0
Goto Ready+1
BotCheck:
SOLA F 5 A_RailWait
SOLA F 0 A_Jump(128, "BotCheck")
Goto Hold+2
NoAmmo:
SOLA F 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor SolarBlazeU : SolarBlaze replaces SolarBlaze
{
damage (340)
}

actor SolarBlazeAltU : SolarBlazeAlt replaces SolarBlazeAlt
{
    damage (340)
}

actor SolarWaveU : SolarWave replaces SolarWave
{
damage (170)
}

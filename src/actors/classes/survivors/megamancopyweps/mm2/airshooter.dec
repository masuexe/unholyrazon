actor AirShooterWepU_NormalBar : AirShooterWep_NormalBar {}

actor AirShooterWepU : BaseMM8BDMCustWep replaces AirShooterWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_AIRSHOOTER"
Obituary "$OB_AIRSHOOTER"
Tag "$TAG_AIRSHOOTER"
weapon.ammotype "AirShooterAmmo"
inventory.icon "AIRSI"
States
{
SpawnLoop:
WEAP G -1
loop
Ready:
AIRS D 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_AIRSHOOTER)
AIRS D 1 A_WeaponReady
Goto Ready+1
Deselect:
AIRS D 0
goto DeselectSwap
Select:
AIRS D 0
goto SelectSwap
Fire:
AIRS D 0 A_JumpIfNoAmmo("NoAmmo")
AIRS D 0 A_PlaySoundEx("weapons/mm2/airshooterfire","Weapon")
AIRS D 0 A_FireCustomMissile("AirShotU",-15,0,8,0)
AIRS D 0 A_FireCustomMissile("AirShotU",15,0,8,0)
AIRS D 0 A_FireCustomMissile("AirShotU",0,1,8,0)
AIRS EF 6
AIRS D 7
AIRS D 0 A_Refire
Goto Ready+1
NoAmmo:
AIRS D 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor AirShotU : AirShot
{
damage (270)
}

actor SpreadDrillWepU_NormalBar : SpreadDrillWep_NormalBar {}

actor SpreadDrillWepU : BaseMM8BDMCustWep replaces SpreadDrillWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 5
Inventory.Pickupmessage "$PU_SPREADDRILL"
Obituary "$OB_SPREADDRILL"
Tag "$TAG_SPREADDRILL"
weapon.ammotype "SpreadDrillAmmo"
inventory.icon "SPREI"
+AMMO_OPTIONAL
+ALT_AMMO_OPTIONAL
States
{
SpawnLoop:
SPRE X -1
loop
Ready:
SPRE H 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SPREADDRILL)
SPRE H 1 A_GiveInventory("SpreadDrill_Ready_P", 1)
wait
Deselect:
SPRE H 0
goto DeselectSwap
Select:
SPRE H 0
goto SelectSwap
Altfire:
SPRE H 0 A_JumpIfNoAmmo("NoAmmo")
SPRE H 0 A_GiveInventory("SpreadDrillU_Fire_P", 1)
SPRE IJ 2
SPRE H 4
Goto Ready+1
Fire:
SPRE H 0 A_JumpIfInventory("SpreadDrillWait",1,"Spread")
SPRE H 0 A_JumpIfNoAmmo("NoAmmo")
SPRE H 0 A_GiveInventory("SpreadDrillU_Fire_P", 1)
SPRE IJ 2
SPRE H 4
SPRE J 0 A_Refire("Spread")
Goto Ready+1
Spread:
SPRE K 0 A_GiveInventory("SpreadDrillTrigger", 1)
SPRE KH 3
goto Ready+1
NoAmmo:
SPRE H 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor SpreadDrillU_Fire_P : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 //A_GiveInventory("SpreadDrillWait",1)
        TNT1 A 0 A_GiveInventory("SpreadDrillWait", 1)
        TNT1 A 0 A_GiveInventory("SpreadDrillAltWait", 1)
        TNT1 A 0 A_TakeInventory("SpreadDrillAmmo",2,TIF_NOTAKEINFINITE)
        TNT1 A 0 A_SpawnItemEx("SpreadDrillAltWaitCooldowner")

        TNT1 A 0 A_PlaySoundEx("weapons/mmb/spreaddrillfire","Weapon")
        TNT1 A 0 A_SpawnItemEx("SpreadDrillU",cos(pitch)*32,0,28-(sin(pitch)*32),cos(pitch)*13,0,-sin(pitch)*13,0,0,0)
        TNT1 A 0 A_JumpIfInventory("PowerSpreadRune", 1, "PickupSpread")
        stop
    PickupSpread:
        TNT1 A 0 A_SpawnItemEx("SpreadDrillU",cos(pitch)*32,0,28-(sin(pitch)*32),cos(pitch)*13,0,-sin(pitch)*13,-15,0,0)
        TNT1 A 0 A_SpawnItemEx("SpreadDrillU",cos(pitch)*32,0,28-(sin(pitch)*32),cos(pitch)*13,0,-sin(pitch)*13,15,0,0)
        stop
    }
}

actor SpreadDrillU : SpreadDrill
{
damage (300)
states
{
Spawn:
TNT1 A 0
SPRE AA 1 
Waiting:
SPRE F 2 A_GiveInventory("CutterFlag", 1)
SPRE F 0 A_JumpIfInTargetInventory("SpreadDrillTrigger",1,"Spread")
TNT1 B 0 A_GiveToTarget("SpreadDrillWait", 1)
SPRE A 2 A_GiveInventory("CutterFlag", 1)
SPRE A 0 A_JumpIfInTargetInventory("SpreadDrillTrigger",1,"Spread")
TNT1 B 0 A_GiveToTarget("SpreadDrillWait", 1)
SPRE A 0 A_JumpIfInventory("CutterFlag",5,"AddGravity")
Loop
AddGravity:
SPRE A 0 A_ChangeFlag("NOGRAVITY", 0)
Goto Waiting2
Waiting2:
SPRE AA 1 A_JumpIf(z-floorz < 1, "Death")
SPRE A 0 A_JumpIfInTargetInventory("SpreadDrillTrigger",1,"Spread")
TNT1 B 0 A_GiveToTarget("SpreadDrillWait", 1)
SPRE FF 1 A_JumpIf(z-floorz < 1, "Death") // A_Checkfloor doesn't work here
SPRE B 0 A_JumpIfInTargetInventory("SpreadDrillTrigger",1,"Spread")
TNT1 B 0 A_GiveToTarget("SpreadDrillWait", 1)
Loop
Spread:
TNT1 A 0 A_SpawnItemEx("LargeDrillShell",-8,0,0,5,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 0 A_SpawnItemEx("MediumDrill1U",0,0,0,20,13,0,0)
TNT1 A 0 A_SpawnItemEx("MediumDrill1U",0,0,0,20,-13,0,0)
stop
Death:
TNT1 A 0
stop
}
}

actor MediumDrill1U : MediumDrill1
{
damage (130)
states
{
Spawn:
SPRE B 0
SPRE CB 2
Goto Death
Death:
TNT1 A 0 A_CustomMissile("MediumDrill2U",0,0,0, 2,0)
stop
}
}

actor MediumDrill2U : MediumDrill2
{
damage (130)
states
{
Spawn:
SPRE CB 2 
SPRE B 0 A_JumpIfInTargetInventory("SpreadDrillTrigger",1,"Spread")
TNT1 A 0 A_GiveToTarget("SpreadDrillWait", 1)
loop
Spread:
TNT1 A 0 A_SpawnItemEx("MediumDrillShell",-4,0,0,5,0,0,0,SXF_WEPFXCOLOR)
TNT1 A 0 A_SpawnItemEx("SmallDrill1U",0,0,0,20,8,0,0)
TNT1 A 0 A_SpawnItemEx("SmallDrill1U",0,0,0,20,-8,0,0)
stop
Death:
TNT1 A 0
stop
}
}

actor SmallDrill1U : SmallDrill1
{
damage (110)
states
{
Spawn:
SPRE D 0
SPRE ED 2
Goto Death
Death:
TNT1 A 0 A_CustomMissile("SmallDrill2U",0,0,0, 2,0)//A_SpawnItemEx("SmallDrill2",0,0,0,27,0,0,0)
stop
}
}

actor SmallDrill2U : SmallDrill2
{
damage (110)
}


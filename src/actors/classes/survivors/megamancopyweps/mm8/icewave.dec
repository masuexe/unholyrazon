actor IceWaveWepU_NormalBar : IceWaveWep_NormalBar {}

actor IceWaveWepU : BaseMM8BDMCustWep replaces IceWaveWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_ICEWAVE"
Obituary "$OB_ICEWAVE"
Tag "$TAG_ICEWAVE"
weapon.ammotype "IceWaveAmmo"
inventory.icon "ICEWAVI"
States
{
SpawnLoop:
WEA4 A -1
loop
Ready:
ICEW I 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_ICEWAVE)
ICEW I 1 A_WeaponReady
Goto Ready+1
Deselect:
ICEW I 0
goto DeselectSwap
Select:
ICEW I 0
goto SelectSwap
Fire:
ICEW I 0 A_JumpIfNoAmmo("NoAmmo")
ICEW I 0 A_PlaySoundEx("weapons/mm8/icewavefire","Weapon")
ICEW I 0 A_FireCustomMissile("IceWaveDropperU",0,1,8,0)
ICEW JK 5
ICEW I 24
ICEW I 0 A_Refire
Goto Ready+1
NoAmmo:
ICEW I 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor IceWaveDropperU : IceWaveDropper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("IceWaveSpawnerU",32,0,0)
stop
}
}

actor IceWaveSpawnerU : IceWaveSpawner
{
damage (200)
States
{
Crash:
Death:
TNT1 A 0 A_PlaySoundEx("weapons/mm8/icewavestart", "Body")
TNT1 A 0 A_CustomMissile("IceWaveU",0,0,0,2,0)
stop
}
}

actor IceWaveU : IceWave
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapons/mm8/icewavebreak", "Body", true)
TNT1 A 2 A_SpawnItemEx("IceWaveIcicleFloorU")
TNT1 A 0 A_CheckFloor("MakeIcicle")
TNT1 AA 1 A_JumpIf(z-floorz!=0,"Down")
Goto Spawn+3
MakeIcicle:
TNT1 A 0 A_SpawnItemEx("IceWaveIcicleFloorU")
Goto Spawn+4
Down: 
TNT1 A 0 A_StopSoundEx("Body")
TNT1 A 1 A_SpawnItemEx("IceWaveDownU",0,0,0,0,0,-20)
stop
Death:
TNT1 A 0 A_StopSoundEx("Body")
TNT1 A 1 A_SpawnItemEx("IceWaveUpU",0,0,0,0,0,20)
stop
}
}

actor IceWaveDownU : IceWaveU
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapons/mm8/icewavebreak", "Body", true)
TNT1 A 2 A_SpawnItemEx("IceWaveIcicleWall")
Goto Spawn+1
Death:
TNT1 A 0 A_StopSoundEx("Body")
TNT1 A 1 A_CustomMissile("IceWave",0,0,0,2,0)
stop
}
}

actor IceWaveUpU : IceWaveU
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("weapons/mm8/icewavebreak", "Body", true)
TNT1 A 2
TNT1 A 0 A_Stop
TNT1 A 0 A_SpawnItemEx("IceWaveIcicleWall",0,0,0,0,0,0,180)
TNT1 A 0 A_ChangeVelocity(20,0,0, CVF_REPLACE | CVF_RELATIVE) 
TNT1 A 1
TNT1 A 0 A_CustomMissile("IceWave",0,0,0,2,0)//A_SpawnItemEx("SearchSnake",0,0,0,18)
stop
Death:
TNT1 A 0 A_JumpIf(ceilingz-z > 48, "Continue")
TNT1 A 0 
stop
Continue:
TNT1 A 0 A_StopSoundEx("Body")
TNT1 A 1 A_SpawnItemEx("IceWaveUpU",0,0,4,0,0,20)
stop
}
}

actor IceWaveIcicleU : IceWaveIcicle
{
damage (220)
}

actor IceWaveIcicleFloorU : IceWaveIcicleU
{
+FLOORHUGGER
}

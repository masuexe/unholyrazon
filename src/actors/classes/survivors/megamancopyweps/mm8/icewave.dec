actor IceWaveWepU_NormalBar : IceWaveWep_NormalBar {}

actor IceWaveWepU : BaseMM8BDMCustWep replaces IceWaveWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_ICEWAVE"
Obituary "$OB_ICEWAVE"
Tag "$TAG_ICEWAVE"
weapon.ammotype "IceWaveAmmo"
inventory.icon "ICEWAVI"
States
{
SpawnLoop:
WEA4 A -1
loop
Ready:
ICEW I 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_ICEWAVE)
ICEW I 1 A_WeaponReady
Goto Ready+1
Deselect:
ICEW I 0
goto DeselectSwap
Select:
ICEW I 0
goto SelectSwap
Fire:
ICEW I 0 A_JumpIfNoAmmo("NoAmmo")
ICEW I 0 A_PlaySoundEx("weapons/mm8/icewavefire","Weapon")
ICEW I 0 A_FireCustomMissile("IceWaveDropper",0,1,8,0)
ICEW JK 5
ICEW I 24
ICEW I 0 A_Refire
Goto Ready+1
NoAmmo:
ICEW I 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}

actor IceWaveSpawnerU : IceWaveSpawner replaces IceWaveSpawner
{
damage (200)
}

actor IceWaveIcicleU : IceWaveIcicle replaces IceWaveIcicle
{
damage (220)
}

actor IceWaveIcicleFloorU : IceWaveIcicleFloor replaces IceWaveIcicleFloor
{
damage (220)
}

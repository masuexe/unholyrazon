actor GravityHoldWepU_NormalBar : GravityHoldWep_NormalBar {}

actor GravityHoldWepU : BaseMegaManUWep replaces GravityHoldWep
{
Weapon.AmmoUse 7
Weapon.AmmoGive 28
Weapon.SlotNumber 6
Inventory.Pickupmessage "$PU_GRAVITYHOLD"
Obituary "$OB_GRAVITYHOLD"
Tag "$TAG_GRAVITYHOLD"
weapon.ammotype "GravityHoldAmmo"
inventory.icon "GRAVSI"
States
{
SpawnLoop:
WEA3 F -1
loop
Ready:
FSTO A 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_GRAVITYHOLD)
FSTO A 1 A_WeaponReady
Goto Ready+1
Deselect:
FSTO A 0
goto DeselectSwap
Select:
FSTO A 0
goto SelectSwap
Fire:
FSTO A 0 A_JumpIfNoAmmo("NoAmmo")
FSTO A 0 A_FireCustomMissile("GravityHoldU",0,1,8,0)
FSTO BC 1
FSTO A 0 A_PlaySoundEx("weapons/mm5/gravityholdfire","Weapon")
FSTO D 45
FSTO C 2
FSTO A 0 A_Refire
Goto Ready+1
NoAmmo:
FSTO A 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
Death:
WEA3 F 0
stop
}
}


actor GravityHoldU : GravityHold
{
damagetype "GravityHold"
Obituary "$OB_GRAVITYHOLD"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("GravityHoldFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
TNT1 A 1 A_Explode(70, 1000,0)
TNT1 A 0 A_SpawnItemEx("GravityHoldFX", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
TNT1 A 1 A_Explode(70, 1000,0)
TNT1 A 0 A_SpawnItemEx("GravityHoldFX2", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
TNT1 A 1 A_Explode(70, 768,0)
TNT1 A 0 A_SpawnItemEx("GravityHoldFX3", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
TNT1 A 1 A_Explode(70, 512,0)
TNT1 A 0 A_SpawnItemEx("GravityHoldFX3", 0, 0, 0, 0, 0, 0, 0, SXF_WEPFXCOLOR)
TNT1 A 1 A_Explode(70, 512,0)
stop
}
}

actor MagnetMissileWepU_NormalBar : MagnetMissileWep_NormalBar {}

actor MagnetMissileWepU : BaseMM8BDMCustWep replaces MagnetMissileWep
{
Weapon.AmmoUse 3
Weapon.AmmoGive 30
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_MAGNETMISSILE"
Obituary "$OB_MAGNETMISSILE"
Tag "$TAG_MAGNETMISSILE"
weapon.ammotype "MagnetMissileAmmo"
inventory.icon "MAGNETSI"
States
{
SpawnLoop:
WEAP I -1
loop
Ready:
MAGG C 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_MAGNETMISSILE)
MAGG C 1 A_WeaponReady
Goto Ready+1
Deselect:
MAGG C 0
goto DeselectSwap
Select:
MAGG C 0
goto SelectSwap
Fire:
MAGG C 0 A_JumpIfNoAmmo("NoAmmo")
MAGG C 0 A_PlaySoundEx("weapons/mm3/magnetmissilefire","Weapon")
MAGG C 0 A_FireCustomMissile("MagnetMissileU",0,1,8,0)
MAGG ED 2
MAGG C 20
MAGG C 0 A_Refire
Goto Ready+1
NoAmmo:
MAGG C 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor MagnetMissileU : MagnetMissile
{
damage (300)
}

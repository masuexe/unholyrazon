actor RingBoomerangWepU_NormalBar : RingBoomerangWep_NormalBar {}

actor RingBoomerangWepU : BaseMM8BDMCustWep replaces RingBoomerangWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 4
Inventory.Pickupmessage "$PU_RINGBOOMERANG"
Obituary "$OB_RINGBOOMERANG"
Tag "$TAG_RINGBOOMERANG"
weapon.ammotype "RingBoomerangAmmo"
inventory.icon "RINGSI"
States
{
SpawnLoop:
WEA2 H -1
loop
Ready:
RING E 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_RINGBOOMERANG)
RING E 1 A_WeaponReady
Goto Ready+1
Deselect:
RING E 0
goto DeselectSwap
Select:
RING E 0
goto SelectSwap
Fire:
RING E 0 A_JumpIfNoAmmo("NoAmmo")
RING E 0 A_PlaySoundEx("weapons/mm4/ringboomberangfire","Weapon")
RING E 0 A_FireCustomMissile("RingBoomerangU",0,1,8,0)
RING FG 4
RING E 15
RING E 0 A_Refire
Goto Ready+1
NoAmmo:
RING E 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor RingBoomerangBaseU : RingBoomerangBase
{
damage (180)
}

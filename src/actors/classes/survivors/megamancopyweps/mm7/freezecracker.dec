actor FreezeCrackerWepU_NormalBar : FreezeCrackerWep_NormalBar {}

actor FreezeCrackerWepU : BaseMM8BDMCustWep replaces FreezeCrackerWep
{
Weapon.AmmoUse 2
Weapon.AmmoGive 28
Weapon.SlotNumber 2
Inventory.Pickupmessage "$PU_FREEZECRACKER"
Obituary "$OB_FREEZECRACKER"
Tag "$TAG_FREEZECRACKER"
weapon.ammotype "FreezeCrackerAmmo"
inventory.icon "FCRASI"
States
{
SpawnLoop:
WEA3 O -1
loop 
Ready:
FCRA F 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_FREEZECRACKER)
FCRA F 1 A_WeaponReady
Goto Ready+1
Deselect:
FCRA F 0
goto DeselectSwap
Select:
FCRA F 0
goto SelectSwap
Fire:
FCRA F 0 A_JumpIfNoAmmo("NoAmmo")
FCRA F 0 A_PlaySoundEx("weapons/mm7/freezecrackerfire","Weapon")
FCRA F 0 A_FireCustomMissile("FreezeCrackerU",0,1,8,0)
FCRA GH 6
FCRA F 3
FCRA F 0 A_Refire
Goto Ready+1
NoAmmo:
FCRA F 1 ACS_NamedExecuteAlways("core_noammo",0)
Goto Ready+1
}
}


actor FreezeCrackerU : FreezeCracker
{
damage (260)
States
{
Death:
TNT1 A 0 A_SpawnItemEx("IcePitFreeze")
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,60)
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,-60)
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,120)
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,-120)
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,180)
TNT1 A 0 A_SpawnItemEx("FreezeBitU",0,0,0,28,0,0,0)
TNT1 A 1 A_PlaySoundEx("weapons/mm7/freezecrackersplit","Weapon")
stop
}
}

actor FreezeBitU : FreezeBit
{
damage (120)
}

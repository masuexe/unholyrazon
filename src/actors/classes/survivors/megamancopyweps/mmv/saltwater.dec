actor SaltWaterWepU_NormalBar : SaltWaterWep_NormalBar {}

actor SaltWaterWepU : BaseMM8BDMCustWep replaces SaltWaterWep
{
    Weapon.AmmoUse 2
    Weapon.AmmoGive 28
    Weapon.SlotNumber 4
    Obituary "$OB_SALTWATER"
    Tag "$TAG_SALTWATER"
    Inventory.Pickupmessage "$PU_SALTWATER"
    weapon.ammotype "SaltWaterAmmo"
    inventory.icon "SWATWI"
    States
    {
    SpawnLoop:
        SWAT A -1
        loop
    Ready:
        SWAT J 0 ACS_NamedExecuteWithResult("core_weaponcolor",CLR_SALTWATER)
        SWAT J 1 A_WeaponReady
        Goto Ready+1
    Deselect:
        SWAT J 0
        goto DeselectSwap
    Select:
        SWAT J 0
        goto SelectSwap
    Fire:
        SWAT J 0 A_JumpIfNoAmmo("NoAmmo")
        TNT1 A 1
        SWAT MN 1
        SWAT J 0 A_PlaySoundEx("weapons/mmv/saltwaterfire","Weapon")
        SWAT J 0 A_FireCustomMissile("SaltWaterU",0,1,8,0)
        SWAT OPQR 1
        TNT1 A 13
        TNT1 A 0 A_JumpIfNoAmmo("NoAmmoReady")
        SWAT LK 2 A_Refire
        Goto Ready+1
    NoAmmoReady:
        SWAT LK 2
        Goto Ready+1
    NoAmmo:
        SWAT J 1 ACS_NamedExecuteAlways("core_noammo",0)
        Goto Ready+1
    }
}


actor SaltWaterU : SaltWater replaces SaltWater
{
damage (330)
}

actor SaltWaterBitU : SaltWaterBit replaces SaltWaterBit
{
damage (110)
}

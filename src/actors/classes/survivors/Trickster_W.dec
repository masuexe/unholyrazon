actor Trickster_W_NormalBar : NormalBar {Args 34, 239}
actor Trickster_W_SecondBar : SecondBar {Args 87, 199}

actor Trickster_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 44
Weapon.AmmoGive 88
Inventory.Pickupmessage "$PU_14"
Obituary "$OB_14W"
Tag "$TAG_Trickster_W"
weapon.ammotype "SinisterEnergyAmmo"
weapon.ammotype2 "PansyEscapeAmmo"
States
{
Spawn:
6H14 [ 6
loop

Deselect:
6H14 A 0 A_JumpIfInventory("PansyFlag",1,1)
goto DeselectSwap
6H14 C 0 A_GiveInventory("TricksterRemoveInvis_P")
6H14 A 0 A_TakeInventory("PansyFlag")
goto DeselectSwap
Select:
6H14 A 0
goto SelectSwap

Ready:
6H14 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TRICKSTER_DYE)
goto Ready2

Ready2:
6H14 A 0 A_TakeInventory("PansyFlag")
6H14 A 2 A_GiveInventory("Trickster_Ready_P")
wait

Ready3:
6H14 C 2 A_GiveInventory("Trickster_ReadyInvis_P")
6H14 C 0 A_JumpIfInventory("PansyEscapeAmmo",1,"Ready3")
goto AltfireReveal

Fire:
6H14 F 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H14 E 0 A_JumpIfInventory("PansyFlag",1,"Fire2")
6H14 D 0 A_GiveInventory("Trickster_Fire1_P")
6H14 H 0 A_FireCustomMissile("TricksterShot",0,1,-8,0)
6H14 FE 4
6H14 D 10
6H14 GHIA 2
goto Ready2
Fire2:
6H14 F 0 A_GiveInventory("Trickster_Fire2_P")
6H14 F 0 A_FireCustomMissile("TricksterShotDelux",0,1,-8,0)
6H14 F 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
6H14 F 2 Offset(-24, 44)
6H14 F 2 Offset(-48, 64)
6H14 F 2 Offset(-44, 64)
6H14 E 2 Offset(-36, 56)
6H14 E 2 Offset(-16, 40)
6H14 E 2 Offset(-8, 32)
6H14 D 6 A_WeaponReady(14)
6H14 GHIA 2
goto Ready2
NoAmmo:
6H14 A 0
Goto Ready2

BotFire:
6H14 A 0 A_JumpIfInventory("PansyFlag",1,"BotFire2")
6H14 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "BotFire2")
6H14 A 0 A_GiveInventory("SinisterEnergyAmmo",random(11,33))
6H14 A 0 A_GiveInventory("PansyEscapeAmmo",40)
6H14 A 0 A_Jump(4,"BotFire3")
goto Fire+1
BotFire2:
6H14 A 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
6H14 A 0 A_Jump(64,"BotFire3")
6H14 A 0 A_GiveInventory("BotFlagDelay",random(10,50))
goto AltfireX
BotFire2a:
6H14 A 2 A_TakeInventory("BotFlagDelay",1)
6H14 A 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
goto Fire2
BotFire3:
6H14 A 0 A_SpawnItemEx("TricksterFadeoutBody",0,0,0,0,0,0,0,1)
6H14 A 0 A_PlaySoundEx("classes/taunt/trickster","Voice")
6H14 A 0 A_PlaySoundEx("classes/hide","Weapon")
6H14 A 0 A_GiveInventory("PansyFlag")
6H14 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
6H14 B 2 A_SetTranslucent(0.0,0)
6H14 C 86
6H14 B 2 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
goto Fire2

Altfire:
6H14 A 0 A_JumpIfInventory("PansyFlag",1,"AltfireReveal")
6H14 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "AltfireX")
6H14 C 1
goto AltfireReveal
AltfireReveal:
6H14 C 0 A_PlaySoundEx("classes/reveal","Weapon")
6H14 C 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
6H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
6H14 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
6H14 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
6H14 CCCCBBBAAA 1
6H14 A 1 A_TakeInventory("PansyFlag")
goto Ready2
AltfireX:
6H14 A 0 A_PlaySoundEx("classes/hide","Weapon")
6H14 A 0 A_SpawnItemEx("UH_AlphaFadeOut_H")
6H14 AABBBCCCCC 1
6H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
6H14 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
6H14 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
6H14 C 1 A_GiveInventory("PansyFlag")
goto Ready3
}
}

actor SinisterEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 88
+INVENTORY.IGNORESKILL
}

actor PansyEscapeAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 240
+INVENTORY.IGNORESKILL
}

actor PansyFlag : Once {}

actor Trickster_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "Ready1")
TNT1 A 0 A_JumpIfInventory("SinisterEnergyAmmo",44,"Ready2")
TNT1 A 0 A_WeaponReady(WRF_NOFIRE)
goto Ammo
Ready1:
TNT1 A 0 A_JumpIfInventory("SinisterEnergyAmmo",44,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
goto Ammo
Ready2:
TNT1 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("SinisterEnergyAmmo",3)
TNT1 A 0 A_GiveInventory("PansyEscapeAmmo",2)
stop
}
}

actor Trickster_ReadyInvis_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("SinisterEnergyAmmo",44,2)
TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY)
goto Ammo
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("SinisterEnergyAmmo",3)
//TNT1 A 0 A_TakeInventory("PansyEscapeAmmo",1,1)
TNT1 A 0 A_TakeInventory("PansyEscapeAmmo",2)
stop
}
}

actor Trickster_Fire1_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/crackerthrow","Weapon")
TNT1 A 0 A_TakeInventory("PansyFlag")
stop
}
}
actor Trickster_Fire2_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/deepdiggerthrow","Weapon")
TNT1 A 0 A_TakeInventory("PansyFlag")
6H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
6H14 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
6H14 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
TNT1 A 0 A_SetArg(0,CallACS("rz_CountInv_PansyEscapeAmmo")/4)
TNT1 A 0 A_TakeInventory("PansyEscapeAmmo",Args[0],1)
TNT1 A 0 A_TakeInventory("PansyEscapeAmmo",Args[0])
TNT1 A 0 A_TakeInventory("PansyEscapeAmmo",24)
stop
}
}

actor TricksterRemoveInvis_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
    TNT1 A 0 A_TakeInventory("UH_00_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_10_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_20_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_30_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_40_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_50_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_60_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_70_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_80_AlphaPower")
    TNT1 A 0 A_TakeInventory("UH_90_AlphaPower")
    stop
  }
}

actor TricksterShot : BasicProjectile
{
Translation "192:192=34:34","198:198=239:239"
damagetype "Sinister"
Obituary "$OB_14M1"
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
+DONTFALL////////
+FORCEXYBILLBOARD
damage (28)
Radius 10
Height 10
speed 60
scale 3.0
Args 150,128,128
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,2,3,4)
Spawn2:
X_KC ABCD 2
loop
Spawn3:
X_KC ABCD 3
loop
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAA 0 A_SpawnItemEx("TricksterShotSplit",0,0,8*Args[4],random(-15,15),random(-15,15),random(2,15)*Args[4],0,1)
goto DeathEnd
DeathEnd:
TNT1 A 0
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySoundEx("wep/TricksterBomb1","Weapon")
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("TricksterShotEndFX",0,0,0,0,0,0,0,1+16384)
stop
}
}

actor TricksterShotEndFX : BasicBoom6FX_ColorX_Precise
{
States
{
Spawn:
X_3L A 0
X_3L A 0 A_SetScale(ScaleX*(random(0,1)*2-1),ScaleY)
X_3L ABDFHJKLM 2
stop
}
}


actor TricksterShotSplit : TricksterShot
{
Obituary "$OB_14M2"
+THRUACTORS
Radius 9
Height 9
scale 2.5
Args 85,128,20
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,"SpawnA","SpawnB","SpawnC","SpawnD")
goto Spawn3
SpawnA:
X_KC A 3
X_KC A 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+1
SpawnB:
X_KC B 3
X_KC B 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+2
SpawnC:
X_KC C 3
X_KC C 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+3
SpawnD:
X_KC D 3
X_KC D 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3
Death:
goto DeathEnd
}
}


actor SinisterStopper : BasicProjectile
{
Translation "192:192=34:34","198:198=239:239"
damagetype "SinisterStop"
Obituary "$OB_14A"
damage (10)
Radius 9
Height 9
speed 60
scale 2.5
States
{
Spawn:
X_KC ABCD 2
loop
Death:
TMFX ABCD 2
stop
}
}


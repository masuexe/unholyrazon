stop
}
}

Actor TricksterShotDelux2 : TricksterShotDelux
{
Obituary "$OB_14M3"
+THRUACTORS
Radius 11
Height 11
scale 3.5
Args 85,144,32
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Jump(256,1,3,5,7)
goto Spawn3
X_KC P 3
X_KC P 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+1
X_KC O 3
X_KC O 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+2
X_KC N 3
X_KC N 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3+3
X_KC M 3
X_KC M 0 A_ChangeFlag(THRUACTORS,0)
goto Spawn3
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAA 0 A_SpawnItemEx("TricksterShotDelux3",0,0,8*Args[4],random(-10,10),random(-10,10),random(1,18)*Args[4],0,1)
goto DeathEnd
}
}

actor TricksterShotDelux3 : TricksterShotDelux2
{
Obituary "$OB_14M3"
Radius 10
Height 10
scale 3.0
Args 75,128,20
States
{
Death:
goto DeathEnd
}
}

actor TricksterFadeoutBody : BasicExplosion
{
Scale 2.5

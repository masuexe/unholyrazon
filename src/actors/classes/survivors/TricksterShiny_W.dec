actor TricksterShiny_W_NormalBar : NormalBar {Args 109, 3}
actor TricksterShiny_W_SecondBar : SecondBar {Args 87, 199}

actor TricksterShiny_W : BaseMM8BDMWep_UH {
  Tag "$TAG_S_Trickster_W"
  Weapon.AmmoUse 44
  Inventory.Pickupmessage "$PU_14"
  Obituary "$OB_14W"
  Weapon.AmmoType "SinisterEnergyAmmo"
  Weapon.AmmoType2 "PansyEscapeAmmo"
  States {
   Spawn:
    7H14 [ 6
    loop

   Deselect:
    7H14 A 0 A_JumpIfInventory("PansyFlag", 1, 1)
    goto DeselectSwap
    7H14 A 0 A_GiveInventory("TricksterRemoveInvis_P")
    7H14 A 0 A_TakeInventory("PansyFlag")
    goto DeselectSwap
   Select:
    7H14 A 0
    goto SelectSwap

   Ready:
    7H14 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TRICKSTER_SDYE)
    goto Ready2

   Ready2:
    7H14 A 0 A_TakeInventory("PansyFlag")
    7H14 A 2 A_GiveInventory("Trickster_Ready_P")
    wait

   Ready3:
    7H14 C 2 A_GiveInventory("Trickster_ReadyInvis_P")
    7H14 C 0 A_JumpIfInventory("PansyEscapeAmmo", 1, "Ready3")
    goto AltfireReveal

   Fire:
    7H14 F 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H14 E 0 A_JumpIfInventory("PansyFlag", 1, "Fire2")
    7H14 D 0 A_GiveInventory("Trickster_Fire1_P")
    7H14 H 0 A_FireCustomMissile("S_TricksterShot", 0, 1, -8, 0)
    7H14 FE 4
    7H14 D 10
    7H14 GHIA 2
    goto Ready2
   Fire2:
    7H14 F 0 A_GiveInventory("Trickster_Fire2_P")
    7H14 F 0 A_FireCustomMissile("S_TricksterShotDelux", 0, 1, -8, 0)
    7H14 F 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
    7H14 F 2 Offset(-24, 44)
    7H14 F 2 Offset(-48, 64)
    7H14 F 2 Offset(-44, 64)
    7H14 E 2 Offset(-36, 56)
    7H14 E 2 Offset(-16, 40)
    7H14 E 2 Offset(-8, 32)
    7H14 D 6 A_WeaponReady(14)
    7H14 GHIA 2
    goto Ready2
   NoAmmo:
    7H14 A 0
    goto Ready2

   BotFire:
    7H14 A 0 A_JumpIfInventory("PansyFlag", 1, "BotFire2")
    7H14 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "BotFire2")
    7H14 A 0 A_GiveInventory("SinisterEnergyAmmo", random(11, 33))
    7H14 A 0 A_GiveInventory("PansyEscapeAmmo", 40)
    7H14 A 0 A_Jump(4, "BotFire3")
    goto Fire+1
   BotFire2:
    7H14 A 0 A_JumpIfInventory("BotFlagDelay", 1, "BotFire2a")
    7H14 A 0 A_Jump(64, "BotFire3")
    7H14 A 0 A_GiveInventory("BotFlagDelay", random(10, 50))
    goto AltfireX
   BotFire2a:
    7H14 A 2 A_TakeInventory("BotFlagDelay", 1)
    7H14 A 0 A_JumpIfInventory("BotFlagDelay", 1, "BotFire2a")
    goto Fire2
   BotFire3:
    7H14 A 0 A_SpawnItemEx("TricksterFadeoutBody", 0, 0, 0, 0, 0, 0, 0, 1)
    7H14 A 0 A_PlaySoundEx("classes/taunt/trickster", "Voice")
    7H14 A 0 A_PlaySoundEx("classes/hide", "Weapon")
    7H14 A 0 A_GiveInventory("PansyFlag")
    7H14 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    7H14 B 2 A_SetTranslucent(0.0, 0)
    7H14 C 86
    7H14 B 2 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    goto Fire2

   Altfire:
    7H14 A 0 A_JumpIfInventory("PansyFlag", 1, "AltfireReveal")
    7H14 A 0 A_JumpIfInventory("PansyEscapeAmmo", 240 - 120 * CallACS("uh_CheckRune", RUNE_ENDLESSAMMO), "AltfireX")
    7H14 C 1
    goto AltfireReveal
   AltfireReveal:
    7H14 C 0 A_PlaySoundEx("classes/reveal", "Weapon")
    7H14 C 0 A_SpawnItemEx("UH_AlphaFadeIn_H")
    7H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
    7H14 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
    7H14 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
    7H14 CCCCBBBAAA 1
    7H14 A 1 A_TakeInventory("PansyFlag")
    goto Ready2
   AltfireX:
    7H14 A 0 A_PlaySoundEx("classes/hide", "Weapon")
    7H14 A 0 A_SpawnItemEx("UH_AlphaFadeOut_H")
    7H14 AABBBCCCCC 1
    7H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
    7H14 C 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
    7H14 C 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
    7H14 C 1 A_GiveInventory("PansyFlag")
    goto Ready3
  }
}

actor S_TricksterShot : TricksterShot {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (42)  // 28
  Args 150, 128, 128
  States {
   Death:
    TNT1 A 0 A_SetArg(4, 1 - (ceilingz - z <= height) * 2)
    TNT1 AAAAAAAA 0 A_SpawnItemEx("TricksterShotSplit", 0, 0, 8 * args[4], random(-15, 15), random(-15, 15), random(2, 15) * args[4], 0, 1)
    goto DeathEnd
  }
}

actor S_TricksterShotSplit : TricksterShotSplit {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (42)
  Args 85, 128, 20
}


actor S_SinisterStopper : SinisterStopper {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (15)  // 10
}

actor S_TricksterShotDelux : TricksterShotDelux {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (42)
  Args 300, 192, 192
  States {
   Death:
    TNT1 A 0 A_SetArg(4, 1 - (ceilingz - z <= height) * 2)
    TNT1 AAAAAA 0 A_SpawnItemEx("TricksterShotDelux2", 0, 0, 8 * args[4], random(-15, 15), random(-15, 15), random(1, 16) * args[4], 0, 1)
    goto DeathEnd
  }
}

actor S_TricksterShotDelux2 : TricksterShotDelux2 {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (42)
  Args 85, 144, 32
  States {
   Death:
    TNT1 A 0 A_SetArg(4, 1 - (ceilingz - z <= height) * 2)
    TNT1 AAAAAA 0 A_SpawnItemEx("S_TricksterShotDelux3", 0, 0, 8 * args[4], random(-10, 10), random(-10, 10), random(1, 18) * args[4], 0, 1)
    goto DeathEnd
  }
}

actor S_TricksterShotDelux3 : TricksterShotDelux3 {
  Translation "192:192=109:109", "198:198=3:3"
  Damage (42)
  Args 75, 128, 20
}

Damage (42)
Args 85,144,32
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAA 0 A_SpawnItemEx("S_TricksterShotDelux3",0,0,8*Args[4],random(-10,10),random(-10,10),random(1,18)*Args[4],0,1)

actor TricksterShiny_W_NormalBar : NormalBar {Args 109, 3}
actor TricksterShiny_W_SecondBar : SecondBar {Args 87, 199}

actor TricksterShiny_W : BaseMM8BDMWep_UH
{
Tag "$TAG_S_Trickster_W"
Weapon.AmmoUse 44
Inventory.Pickupmessage "$PU_14"
Obituary "$OB_14W"
weapon.ammotype "SinisterEnergyAmmo"
weapon.ammotype2 "PansyEscapeAmmo"
States
{
Spawn:
7H14 [ 6
loop

Deselect:
7H14 A 0 A_JumpIfInventory("PansyFlag",1,1)
goto DeselectSwap
7H14 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
7H14 A 0 A_SetTranslucent(1.0,0)
7H14 A 0 A_TakeInventory("PansyFlag")
goto DeselectSwap
Select:
7H14 A 0
goto SelectSwap

Ready:
7H14 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", TRICKSTER_SDYE)
goto Ready2

Ready2:
7H14 A 0 A_TakeInventory("PansyFlag")
7H14 A 2 A_GiveInventory("Trickster_Ready_P")
wait

Ready3:
7H14 C 2 A_GiveInventory("Trickster_Ready_P2")
7H14 C 0 A_JumpIfInventory("PansyEscapeAmmo",1,"Ready3")
goto AltfireR

Fire:
7H14 F 0 A_JumpIfInventory("IsBot",1,"BotFire")
7H14 E 0 A_JumpIfInventory("PansyFlag",1,"Fire2")
7H14 D 0 A_GiveInventory("Trickster_Fire1_P")
7H14 H 0 A_FireCustomMissile("S_TricksterShot",0,1,-8,0)
7H14 FE 4
7H14 D 10
7H14 GHIA 2
goto Ready2
Fire2:
7H14 F 0 A_GiveInventory("Trickster_Fire2_P")
7H14 F 0 A_FireCustomMissile("S_TricksterShotDelux",0,1,-8,0)
7H14 F 2 A_SetTranslucent(0.1,0)
7H14 F 2 A_SetTranslucent(0.3,0)
7H14 E 2 A_SetTranslucent(0.5,0)
7H14 E 2 A_SetTranslucent(0.7,0)
7H14 D 2 A_SetTranslucent(0.9,0)
7H14 D 8 A_SetTranslucent(1.0,0)
7H14 GHIA 2
goto Ready2
NoAmmo:
7H14 A 0
Goto Ready2

BotFire:
7H14 A 0 A_JumpIfInventory("PansyFlag",1,"BotFire2")
7H14 A 0 A_JumpIfInventory("PansyEscapeAmmo",0,"BotFire2")
7H14 A 0 A_GiveInventory("SinisterEnergyAmmo",random(11,33))
7H14 A 0 A_GiveInventory("PansyEscapeAmmo",40)
7H14 A 0 A_Jump(4,"BotFire3")
goto Fire+1
BotFire2:
7H14 A 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
7H14 A 0 A_Jump(64,"BotFire3")
7H14 A 0 A_GiveInventory("BotFlagDelay",random(10,50))
goto AltfireX
BotFire2a:
7H14 A 2 A_TakeInventory("BotFlagDelay",1)
7H14 A 0 A_JumpIfInventory("BotFlagDelay",1,"BotFire2a")
goto Fire2
BotFire3:
7H14 A 0 A_SpawnItemEx("TricksterFadeoutBody",0,0,0,0,0,0,0,1)
7H14 A 0 A_PlaySoundEx("taunt/D_14","Voice")
7H14 A 0 A_PlaySoundEx("classes/hide","Weapon")
7H14 A 0 A_GiveInventory("PansyFlag",1)
7H14 A 0 A_ChangeFlag("INVULNERABLE",1)
7H14 B 2 A_SetTranslucent(0.0,0)
7H14 C 86
7H14 B 2 A_ChangeFlag("INVULNERABLE",0)
goto Fire2

Altfire:
7H14 A 0 A_JumpIfInventory("PansyFlag",1,"AltfireR")
7H14 A 0 A_JumpIfInventory("PansyEscapeAmmo",0,"AltfireX")
7H14 C 1
goto AltfireR
AltfireR:
7H14 C 0 A_PlaySoundEx("classes/reveal","Weapon")
7H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
7H14 C 1 A_SetTranslucent(0.1,0)
7H14 C 1 A_SetTranslucent(0.2,0)
7H14 C 1 A_SetTranslucent(0.3,0)
7H14 C 1 A_SetTranslucent(0.4,0)
7H14 B 1 A_SetTranslucent(0.5,0)
7H14 B 1 A_SetTranslucent(0.6,0)
7H14 B 1 A_SetTranslucent(0.7,0)
7H14 A 1 A_SetTranslucent(0.8,0)
7H14 A 1 A_SetTranslucent(0.9,0)
7H14 A 1 A_SetTranslucent(1.0,0)
7H14 A 1 A_TakeInventory("PansyFlag")
goto Ready2
AltfireX:
7H14 A 0 A_PlaySoundEx("classes/hide","Weapon")
7H14 A 1 A_SetTranslucent(0.9,0)
7H14 A 1 A_SetTranslucent(0.8,0)
7H14 B 1 A_SetTranslucent(0.7,0)
7H14 B 1 A_SetTranslucent(0.6,0)
7H14 B 1 A_SetTranslucent(0.5,0)
7H14 C 1 A_SetTranslucent(0.4,0)
7H14 C 1 A_SetTranslucent(0.3,0)
7H14 C 1 A_SetTranslucent(0.2,0)
7H14 C 1 A_SetTranslucent(0.1,0)
7H14 C 1 A_SetTranslucent(0.0,0)
7H14 C 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
7H14 C 1 A_GiveInventory("PansyFlag",1)
goto Ready3
}
}

actor S_TricksterShot : TricksterShot
{
Translation "192:192=109:109","198:198=3:3"
Damage (42)//28
Args 150,128,128
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAAAA 0 A_SpawnItemEx("TricksterShotSplit",0,0,8*Args[4],random(-15,15),random(-15,15),random(2,15)*Args[4],0,1)
goto DeathEnd
}
}

actor S_TricksterShotSplit : TricksterShotSplit
{
Translation "192:192=109:109","198:198=3:3"
Damage (42)
Args 85,128,20
}


actor S_SinisterStopper : SinisterStopper
{
Translation "192:192=109:109","198:198=3:3"
Damage (15)//10
}


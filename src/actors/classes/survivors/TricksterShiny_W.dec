{
Translation "192:192=109:109","198:198=3:3"
Damage (42)
Args 300,192,192
States
{
Death:
TNT1 A 0 A_SetArg(4,1-(ceilingz-z<=height)*2)
TNT1 AAAAAA 0 A_SpawnItemEx("TricksterShotDelux2",0,0,8*Args[4],random(-15,15),random(-15,15),random(1,16)*Args[4],0,1)
goto DeathEnd
}
}


actor HandyMan : CustWepClassBase
{
player.scoreIcon "UMUG_41"
player.displayname "HandyMan"
player.soundclass "HandyMan"
Player.Maxhealth 1100
health 1100
player.forwardmove 0.95, 0.95
player.sidemove 0.95, 0.95
player.jumpz 12
Player.StartItem "UH_BaseFlagPack"
player.startitem "HandyMan_W"
player.startitem "HandyHandAmmo", 88
States
{

Death.Suicide:
goto Death

Spawn:
SPAR A 0
SPAR B 1
SPAR A 1
wait
See:
SPAR BCDE 5
Goto Spawn
Missile:
SPAR F 0 A_JumpIfInventory("HandyFlag",2,"MissileDown1")
SPAR F 0 A_JumpIfInventory("HandyFlag",1,"MissileDown")
SPAR F 5
SPAR G 4
goto Spawn+2

MissileDown:
SPAR F 1 A_JumpIfInventory("HandyFlag",2,"MissileDown1")
loop
MissileDown1:
SPAR M 1 A_JumpIfInventory("VivifyDelay8",1,"MissileDown2")
loop
MissileDown2:
SPAR G 1 A_JumpIfInventory("VivifyDelay4",1,"MissileUp")
loop
MissileUp:
SPAR B 1
goto Spawn+2

ClassPainQuake:
SPAR H 0 A_SpawnItemEx("DelayPainFX5")
SPAR HHH 1 A_JumpIfInventory("VivifyDelay8",1,"MissileDown2")
goto MissileDown1
ClassPain:
SPAR H 0 A_JumpIfInventory("HandyFlag",1,"ClassPainQuake")
Goto MegamanPain

ClassDeath:
SPAR H 0
goto MegamanDeath
MegamanDeath0:
SPAR H 10 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
SPAR F 4
SPAR F 1
SPAR G 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage",500,4,-41)
SPAR G 0 A_SpawnItemEx("HandymanDeath_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
SPAR G 5
SPAR H 0
Goto MegamanFade
MegamanDisintegrate:
SPAR Z 0 A_SpawnItemEx("Corpse_41",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor HandyManShiny : HandyMan
{
player.scoreIcon "UMUG_S41"
Player.Maxhealth 3100
health 3100
player.forwardmove 1.05, 1.05
player.sidemove 1.05, 1.05
player.jumpz 13
player.morphweapon "HandyManShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
SPAR H 10 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
SPAR F 4
SPAR F 1
SPAR G 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage",500,4,-1041)
SPAR G 0 A_SpawnItemEx("HandymanDeath_FloorQuakeFX_H",0,0,0,0,0,0,0,1)
SPAR G 5
SPAR H 0
Goto FadeDeathEnd
}
}


actor HandymanDeath_FloorQuakeFX_H : Handyman_FloorQuakeFX_H
{
Args 0,0,0,0,40
}

actor HandymanDeath_FloorQuakeSpawn : Handyman_FloorQuakeSpawn
{
Obituary "$OB_41D"
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("HandymanDeath_FloorQuakeBoom",0,0,28,0,0,0,0,1+SXF_TRANSFERSPECIAL)
stop
}
}
actor S_HandymanDeath_FloorQuakeSpawn : HandymanDeath_FloorQuakeSpawn
{
States
{
Quake:
TNT1 A 4 A_SpawnItemEx("S_HandymanDeath_FloorQuakeBoom",0,0,28,0,0,0,0,1+SXF_TRANSFERSPECIAL)
stop
}
}


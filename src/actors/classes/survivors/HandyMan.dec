actor HandyMan : CustWepClassBase {
  Player.ScoreIcon "UMUG_41"
  Player.DisplayName "HandyMan"
  Player.SoundClass "HandyMan"
  Player.MaxHealth 1100
  Health 1100
  Player.ForwardMove 0.95, 0.95
  Player.SideMove 0.95, 0.95
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "HandyMan_W"
  Player.StartItem "HandyHandAmmo", 88
  States {
   Death.Suicide:
    goto Death

   Spawn:
    SPAR A 0
    SPAR B 1
    SPAR A 1
    wait
   See:
    SPAR BCDE 5
    goto Spawn
   Missile:
    SPAR F 0 A_JumpIfInventory("HandyFlag", 2, "MissileDown1")
    SPAR F 0 A_JumpIfInventory("HandyFlag", 1, "MissileDown")
    SPAR F 5
    SPAR G 4
    goto Spawn+2

   MissileDown:
    SPAR F 1 A_JumpIfInventory("HandyFlag", 2, "MissileDown1")
    loop
   MissileDown1:
    SPAR M 1 A_JumpIfInventory("VivifyDelay8", 1, "MissileDown2")
    loop
   MissileDown2:
    SPAR G 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileUp")
    loop
   MissileUp:
    SPAR B 1
    goto Spawn+2

   ClassPainQuake:
    SPAR H 0 A_SpawnItemEx("DelayPainFX5")
    SPAR HHH 1 A_JumpIfInventory("VivifyDelay8", 1, "MissileDown2")
    goto MissileDown1
   ClassPain:
    SPAR H 0 A_JumpIfInventory("HandyFlag", 1, "ClassPainQuake")
    goto MegamanPain

   ClassDeath:
    SPAR H 0
    goto MegamanDeath
   MegamanDeath0:
    SPAR H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SPAR F 4
    SPAR F 1
    SPAR G 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_HandymanDeath", 500, 4)
    SPAR G 0 A_SpawnItemEx("HandymanDeath_FloorQuakeFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    SPAR G 5
    SPAR H 0
    goto MegamanFade
   MegamanDisintegrate:
    SPAR Z 0 A_SpawnItemEx("Corpse_41", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor HandyManShiny : HandyMan {
  Player.ScoreIcon "UMUG_S41"
  Player.MaxHealth 3100
  Health 3100
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.05, 1.05
  Player.JumpZ 13
  Player.MorphWeapon "HandyManShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    SPAR H 10 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    SPAR F 4
    SPAR F 1
    SPAR G 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage_S_HandymanDeath", 500, 4)
    SPAR G 0 A_SpawnItemEx("HandymanDeath_FloorQuakeFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    SPAR G 5
    SPAR H 0
    goto FadeDeathEnd
  }
}


actor HandymanDeath_FloorQuakeFX_H : Handyman_FloorQuakeFX_H {
  Args 0, 0, 0, 0, 40
}

actor HandymanDeath_FloorQuakeSpawn : Handyman_FloorQuakeSpawn {
  Obituary "$OB_41D"
  States {
   Quake:
    TNT1 A 4 A_SpawnItemEx("HandymanDeath_FloorQuakeBoom", 0, 0, 28, 0, 0, 0, 0, 1 + SXF_TRANSFERSPECIAL)
    stop
  }
}
actor S_HandymanDeath_FloorQuakeSpawn : HandymanDeath_FloorQuakeSpawn {
  States {
   Quake:
    TNT1 A 4 A_SpawnItemEx("S_HandymanDeath_FloorQuakeBoom", 0, 0, 28, 0, 0, 0, 0, 1 + SXF_TRANSFERSPECIAL)
    stop
  }
}

actor HandymanDeath_FloorQuakeBoom : Handyman_FloorQuakeBoom {
  Obituary "$OB_41D"
  /*MeleeRange 50
  States
  {
  Spawn:
  TNT1 A 0
  TNT1 A 0 A_Explode(25+args[0]*meleerange,15,0,0,15)
  goto FX
  }*/
}
actor S_HandymanDeath_FloorQuakeBoom : HandymanDeath_FloorQuakeBoom {
  Obituary "$OB_41D"
  MeleeRange 75
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(38 + args[0] * meleerange, 15, 0, 0, 15)
    goto FX
  }
}

actor Corpse_41 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_41_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 HH 0 A_SpawnItemEx("Corpse_41_12", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_41_3", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_41_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_41_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_41_0 : BaseCorpseFX {States {Spawn: 1H41 O 350
    goto Spawn2}}

actor Corpse_41_12 : BaseCorpseFX {
  States {
   Spawn:
    1H41 P 0
    1H41 P 0 A_Jump(128, 2)
    1H41 P 350
    goto Spawn2
    1H41 Q 350
    goto Spawn2
  }
}

actor Corpse_41_3 : BaseCorpseFX {States {Spawn: 1H41 R 350
    goto Spawn2}}
actor Corpse_41_4 : BaseCorpseFX {States {Spawn: 1H41 S 350
    goto Spawn2}}
actor Corpse_41_5 : BaseCorpseFX {States {Spawn: 1H41 T 350
    goto Spawn2}}

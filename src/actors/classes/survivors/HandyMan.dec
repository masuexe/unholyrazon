actor Corpse_41:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_41_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 HH 0 A_SpawnItemEx("Corpse_41_12",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_41_3",0,0,24,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_41_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_41_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}

actor Corpse_41_0:BaseCorpseFX{States{Spawn:1H41 O 350
goto Spawn2}}

actor Corpse_41_12 : BaseCorpseFX
{
States
{
Spawn:
1H41 P 0
1H41 P 0 A_Jump(128,2)
1H41 P 350
goto Spawn2
1H41 Q 350
goto Spawn2
}
}


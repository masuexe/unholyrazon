actor SumoWrestler_W_NormalBar : NormalBar {args 144, 15}

Actor SumoWrestler_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Inventory.Pickupmessage "$PU_36"
  Obituary "$OB_36W"
  Tag "$TAG_SumoWrestler_W"
  weapon.ammotype "SUBALUWAAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H36 [ 6
    loop

   Deselect:
    6H36 A 0
    goto DeselectSwap
   Select:
    6H36 A 0
    goto SelectSwap

   Ready:
    6H36 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", SUMOWRESTLER_DYE)
    6H36 A 0 A_JumpIf(CallACS("UH_IsBot"), "BotReady")
    Goto Ready2
   Ready2:
    6H36 A 0 A_GunFlash("Flash", 1)
    6H36 A 1 A_WeaponReady
    wait

   Fire:
    6H36 A 0 A_GiveInventory("VivifyFlag1", 1)
    6H36 A 0 A_ReFire(1)

    6H36 QRS 1
    6H36 T 2
    //6H36 DDEEF 1
    //6H36 BCDEF 1
    6H36 T 0 A_GiveInventory("SumoW_Fire_P1")
    Goto FireSlam
   FireSlam:
    6H36 T 1 A_GiveInventory("SumoW_SlamCheck_P")
    6H36 T 0 A_JumpIf(CallACS("core_CheckFooting"), "FireEnd")
    6H36 T 0 A_JumpIfInventory("DecoyFlag1", 1, "FireEnd")
    6H36 T 0 A_JumpIf(momz<=0, "FireSlamZ")
    loop
   FireSlamZ:
    6H36 T 1 A_GiveInventory("SumoW_SlamCheck_P")
    6H36 T 0 A_JumpIf(CallACS("core_CheckFooting"), "FireEnd")
    6H36 T 0 A_JumpIfInventory("DecoyFlag1", 1, "FireEnd")
    6H36 T 0 A_JumpIf(momz>=0, "FireEnd")
    loop
   FireEnd:
    TNT1 A 2 A_GiveInventory("SumoW_Fire_P2")
    TNT1 A 7
    6H36 NO 3
    6H36 A 5
    Goto Ready2

   FireStomp:
    6H36 U 0 A_PlaySound("SumoW/LeapCharge", 1)
    6H36 U 1 A_Stop
    6H36 U 0 A_ReFire(1)
    goto Stomp+1
    6H36 T 1 A_Stop
    6H36 T 0 A_ReFire(1)
    goto Stomp+2
    6H36 U 1 A_Stop
    6H36 U 0 A_ReFire(1)
    goto Stomp+3
    6H36 T 1 A_Stop
    6H36 T 0 A_ReFire(1)
    goto Stomp+4
    6H36 U 1 A_Stop
    6H36 U 0 A_ReFire(1)
    goto Stomp+5
    6H36 T 1 A_Stop
    6H36 T 0 A_ReFire(1)
    goto Stomp+5
    6H36 U 1 A_Stop
    6H36 U 0 A_ReFire(1)
    goto Stomp+5
    6H36 T 1 A_Stop
    6H36 T 0 A_ReFire(1)
    goto Stomp+5
    6H36 U 1 A_Stop
    6H36 U 0 A_ReFire(1)
    goto Stomp+5
    6H36 U 0 A_PlaySound("SumoW/LeapCharge", 1)
   Stomp:
    6H36 UTUTU 1 A_Stop
    6H36 T 0 A_ChangeVelocity(0, 0, -20, 2)
   FireStompFall:
    6H36 T 1 A_ChangeVelocity(0, 0, -4)
    6H36 T 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "FireStompLand")
    6H36 T 0 A_JumpIfInventory("PowerMomZVerify", 1, 2)
    6H36 T 0 A_JumpIf(momz==0, 2)
    loop
    6H36 T 0 A_JumpIf(momz==0, "FireStompLand")
    loop
    6H36 T 0 A_GiveInventory("PowerMomZVerify")
    loop
   FireStompLand:

    6H36 U 0 A_GiveInventory("SumoW_StompLand_P")//SumoW_Alt_P2
    6H36 VWX 1
    6H36 B 8
    6H36 C 3
    6H36 A 2
    Goto Ready2+1

   Flash:
    TNT1 A 1 A_JumpIfInventory("SumoWrestlerFlag", 1, 1)
    loop
    TNT1 A 1 A_GiveInventory("SumoW_Flash_P")
    loop

   AltFire:
    6H36 B 0 A_JumpIfInventory("VivifyFlag1", 1, "FireStomp")
    6H36 B 0 A_GiveInventory("VivifyDelay3", 1)
    6H36 B 0 A_GiveInventory("VivifyFlag2", 1)
    6H36 B 0 A_ReFire(1)
    6H36 EEFF 1
    //6H36 BCDE 1
    6H36 F 0 A_ReFire(1)
    goto Altfire3
   AltFireH:
    6H36 F 0 A_JumpIfInventory("SUBALUWAAmmo", 14, "AltFireH2")
    6H36 F 2 A_GiveInventory("SumoW_AltCharge_P")
    6H36 F 0 A_Refire("AltFireH")
    goto Altfire3
   AltFireH2:
    6H36 P 1 A_GiveInventory("SumoW_AltCharge_P")
    6H36 P 0 A_Refire(1)
    goto Altfire4
    6H36 F 1 A_RailWait
    6H36 F 0 A_Refire("AltFireH2")
    goto Altfire4
   Altfire3:
    6H36 F 0 A_JumpIfInventory("SUBALUWAAmmo", 14, "AltFire4")
    6H36 F 1 A_GiveInventory("SumoW_Alt_P1")
    6H36 EDCB 1
    goto AltEnd+1
   AltFire4:
    6H36 F 2 A_GiveInventory("SumoW_Alt_P2")
    6H36 EDCB 2
    goto AltEnd
   AltEnd:
    TNT1 A 10
    TNT1 A 10 A_TakeInventory("VivifyFlag2")
    6H36 GHA 2
    Goto Ready2+1



   BotReady:
    6H36 A 0 A_GunFlash("Flash", 1)
    6H36 A 0 A_WeaponReady(12)
    6H36 A 2 A_Refire("BotFire")
    goto BotReady+1

   BotFire:
    6H36 A 0 A_Jump(96, "BotAlt")
    6H36 A 0 A_Jump(56, 1)
    goto B_Fire
    6H36 A 0 A_ChangeVelocity(random(4, 12), 0, random(2, 10), 1)
    goto B_Fire

   B_Fire:
    6H36 A 0 A_GiveInventory("VivifyFlag1", 1)
    6H36 A 0 A_ReFire(1)
    6H36 BCDEF 1
    6H36 F 0 A_GiveInventory("SumoW_Fire_P1")
    Goto B_FireSlam
   B_FireSlam:
    6H36 F 0 A_Jump(4, "B_FireStomp")
    6H36 F 1 A_SpawnItemEx("SuperSlamCheck", 0, 0, -8, momx, momy, momz, 0, 8)
    6H36 F 0 A_JumpIf(CallACS("core_CheckFooting"), "B_FireEnd")
    6H36 F 0 A_JumpIfInventory("DecoyFlag1", 1, "B_FireEnd")
    6H36 F 0 A_JumpIf(momz<=0, "B_FireSlamZ")
    loop
   B_FireSlamZ:
    6H36 F 1 A_SpawnItemEX("SuperSlamCheck", 0, 0, -8, momx, momy, momz, 0, 8)
    6H36 F 0 A_JumpIf(CallACS("core_CheckFooting"), "B_FireEnd")
    6H36 F 0 A_JumpIfInventory("DecoyFlag1", 1, "B_FireEnd")
    6H36 F 0 A_JumpIf(momz>=0, "B_FireEnd")
    loop
   B_FireEnd:
    TNT1 A 2 A_GiveInventory("SumoW_Fire_P2")
    TNT1 A 0 A_Jump(64, "BotRare2a")
    TNT1 A 0 A_Jump(16, "BotRare1")
    TNT1 A 7
    6H36 GH 3
    6H36 A 5
    Goto BotReady

   B_FireStomp:
    6H36 U 0 A_PlaySound("SumoW/LeapCharge", 1)
    6H36 UTUTU 1 A_Stop
    6H36 T 0 A_ChangeVelocity(0, 0, -20, 2)
   B_FireStompFall:
    6H36 T 1 A_ChangeVelocity(0, 0, -4)
    6H36 T 0 A_JumpIf(CallACS("core_CheckFooting"), "B_FireStompLand")
    6H36 T 0 A_JumpIfInventory("PowerMomZVerify", 1, 2)
    6H36 T 0 A_JumpIf(momz==0, 2)
    loop
    6H36 T 0 A_JumpIf(momz==0, "FireStompLand")
    loop
    6H36 T 0 A_GiveInventory("PowerMomZVerify")
    loop
   B_FireStompLand:
    6H36 U 0 A_GiveInventory("SumoW_StompLand_P")
    6H36 VWX 1
    6H36 B 8
    6H36 C 3
    6H36 A 0 A_Jump(64, "BotRare2a")
    6H36 A 0 A_Jump(16, "BotRare1")
    6H36 A 2
    Goto BotReady

   BotRare1:
    6H36 F 0 A_PlaySoundEx("taunt/D_36", "Voice")
    6H36 F 0 A_GiveInventory("VivifyFlag2", 1)
    6H36 F 0 A_GiveInventory("SUBALUWAAmmo", 10)
    goto B_AltH

   BotRare2:
    6H36 F 0 A_GiveInventory("SumoW_Alt_P2")
    6H36 F 0 A_TakeInventory("VivifyFlag2")
   BotRare2a:
    6H36 F 0 A_FaceTarget
    6H36 F 0 A_PlaySoundEx("taunt/D_36", "Voice")
    goto BotFire+2

   BotAlt:
    6H36 A 0 A_GiveInventory("VivifyDelay3", 1)
    6H36 A 0 A_GiveInventory("VivifyFlag2", 1)
    6H36 A 0 A_ReFire(1)
    6H36 EEFF 1
   BotAlt0:
    6H36 F 0 A_JumpIfInventory("SUBALUWAAmmo", 14, 4)
    6H36 F 0 A_Jump(3, "BotRare2")
    6H36 F 0 A_Jump(16, "B_Alt4")
    6H36 F 0 A_Jump(48, "B_Alt3")
    goto B_AltH
    6H36 F 0 A_Jump(32, 2)
    6H36 F 0 A_Jump(128, "B_Alt4")
    goto B_AltH
    6H36 F 0 A_Recoil(random(-4, -12))
    goto B_AltH
   B_AltH:
    6H36 F 2 A_GiveInventory("SumoW_AltCharge_P")
    6H36 F 0 A_Refire("BotAlt0")
    goto B_Alt3
   B_Alt3:
    6H36 F 0 A_JumpIfInventory("SUBALUWAAmmo", 14, "B_Alt4")
    6H36 F 1 A_GiveInventory("SumoW_Alt_P1")
    6H36 EDCB 1
    goto B_AltEnd+1
   B_Alt4:
    6H36 F 2 A_GiveInventory("SumoW_Alt_P2")
    6H36 EDCB 2
    goto B_AltEnd
   B_AltEnd:
    TNT1 A 10
    TNT1 A 10 A_TakeInventory("VivifyFlag2")
    6H36 GHA 3
    Goto BotReady+1
  }
}

actor SUBALUWAAmmo : Ammo {
  inventory.amount 1
  inventory.maxamount 14
  +INVENTORY.IGNORESKILL
}

actor SumoWrestlerFlag : UOnce {}

actor SumoW_StompWaveCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "MiniShockwave")
    stop
   MiniShockwave:
    TNT1 A 0 //A_PlaySound("misc/quake",1)
    TNT1 A 1 A_GiveInventory("SumoWrestlerFlag", 1)
    stop
  }
}


actor SumoW_SlamCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("SuperSlamCheck", 0, 0, -8, momx, momy, momz, 0, 8)
    TNT1 A 0 A_JumpIfInventory("DecoyFlag1", 1, 2)
    TNT1 A 0 A_WeaponReady(WRF_NOSWITCH|WRF_NOPRIMARY)
    TNT1 A 0
    stop
  }
}

actor SumoW_Fire_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("DecoyFlag1")
    TNT1 A 0 A_PlaySound("weapon/SumoLeap", 1)

    //TNT1 A 0 A_LogInt(pitch)
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    TNT1 A 0 A_ChangeVelocity(20*cos(pitch)+13, 0, 8*-sin(pitch)+8, 1)
    stop
    TNT1 A 0 A_ChangeVelocity(33, 0, 8, 1)
    stop
  }
}
actor SumoW_Fire_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("DecoyFlag1", 1, 2)//Did not land
    TNT1 A 0 //A_GiveInventory("SumoW_Flash_P")
    TNT1 A 0 A_FireCustomMissile("RealSuperSlam", 0, 0, 0, 0)
   End:
    TNT1 A 0 A_GiveInventory("VivifyDelay5", 1)
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 A_PlaySound("weapon/SumoHit", 1)
    TNT1 A 0 A_SpawnItemEx("SuperSlamHitFX_H", 0, 0, 32, 0, 0, 0, 0, 1+32)
    stop
  }
}

actor SumoW_AltCharge_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("SUBALUWAAmmo", 1)
    TNT1 A 0 A_GiveInventory("VivifyCycle1", 1)
    stop
  }
}

actor SumoW_Alt_P1 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay4", 1)
    TNT1 A 0 A_TakeInventory("SUBALUWAAmmo", 14, 1)//The only InfiniteAmmo he can do...
    TNT1 A 0 A_TakeInventory("SUBALUWAAmmo", CallACS("rz_CountInv_SUBALUWAAmmo",0)*0.5)
    //A_FireCustomMissile("SumoW_StompWaveW_H",0,0,0,0)
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW_H", 0, 0, 32, 0, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW_H2", 0, 0, 32, 0, 0, 0, 2, 32)
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW_H2", 0, 0, 32, 0, 0, 0, -2, 32)
    stop
  }
}

actor SumoW_Alt_P2 : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("VivifyDelay4", 1)
    TNT1 A 0 A_TakeInventory("SUBALUWAAmmo", 7, 1)
    TNT1 A 0 A_TakeInventory("SUBALUWAAmmo", 7)
    //A_FireCustomMissile("SumoW_StompWave_H",0,0,0,0)
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWave_H", 0, 0, 32, 0, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIf(CallACS("uh_checkrune", RUNE_SPREAD), 1)
    stop
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWave_H2", 0, 0, 32, 0, 0, 0, 2, 32)
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWave_H2", 0, 0, 32, 0, 0, 0, -2, 32)
    stop
  }
}

actor SumoW_Flash_P : SumoW_Alt_P1 {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("SumoWrestlerFlag")
    goto SumoW_Alt_P1::Pickup+2
  }
}

actor SumoW_StompLand_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_FloorQuakeDamage", 256, 1)
    TNT1 A 0 A_SpawnItemEx("SumoWrestler_FloorSlam", 0, 0, 4)
    TNT1 A 0 A_SpawnItemEx("SumoWrestler_FloorSlam2", 0, 0, 0)
   End:
    TNT1 A 0 A_SpawnItemEx("SumoW_QuakeFX_H0", 0, 0, 0, 0, 0, 0, 0, 1+32)
    TNT1 A 0 A_GiveInventory("VivifyDelay5", 1)
    TNT1 A 0 A_TakeInventory("VivifyFlag1")
    TNT1 A 0 //A_PlaySound("weapon/SumoHit",1)
    stop
  }
}

actor SuperSlamHitFX_H : BasicClientSide {
  Args 7
  States {
   Spawn:
    TNT1 A 0
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("SuperSlamHitFX", 0, cos(Args[0]*45)*16, sin(Args[0]*45)*16, 0, cos(Args[0]*45), sin(Args[0]*45), 0, 1+SXF_MULTIPLYSPEED)//8192
    TNT1 A 0 A_CountDownArg(0)
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor SuperSlamHitFX : BasicClientSide {
  //+BRIGHT
  +FORCEXYBILLBOARD
  ReactionTime 5
  Speed 8
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(0.1*random(15, 25))
    TNT1 A 0 A_SetScale(ScaleX*(random(0, 1)*2-1), ScaleY)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
   L:
    6P36 XYZY 2 A_CountDown
    loop
  }
}

actor SuperSlamCheck {
  PROJECTILE
  +DONTSPLASH
  +DONTBLAST
  +THRUGHOST
  +DONTREFLECT
  +NOTIMEFREEZE
  RenderStyle None
  damage (0)
  Radius 62
  Height 72
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    TNT1 A 0
    stop
   XDeath:
    TNT1 A 0 A_GiveToTarget("DecoyFlag1", 1)
    TNT1 A 0
    Stop
   Death:
    TNT1 A 0
    Stop
  }
}

Actor RealSuperSlam : BasicExplosion_Args {
  damagetype "SumoMelee"
  Obituary "$OB_36M"
  Args 375, 148, 40
}

actor SumoW_StompWave_H : BasicWatcher {
  DeathSound "misc/hugequake"
  Args 20
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(1, 45, 0, 8, 0)
    //TNT1 A 0 A_PlaySound("misc/hugequake",1)
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWave", 0, 0, 0, 30, 0, 0, -60+Args[0]*6)
    TNT1 A 0 A_CountDownArg(0)
    loop
   SpawnL2:
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWave", 0, 0, 0, 30, 0, 0, 0+Args[0]*15)
    TNT1 A 0 A_CountDownArg(0)//23
    TNT1 A 0 A_Jump(256, "SpawnL2")
    goto Death
   Death:
    TNT1 A 0
    TNT1 A 45
    stop
  }
}
actor SumoW_StompWave_H2 : SumoW_StompWave_H{DeathSound ""}
actor SumoW_StompWaveW_H : SumoW_StompWave_H {
  DeathSound "misc/quake"
  Args 20
  States {
   Spawn:
    TNT1 A 0
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW", 0, 0, 0, 15, 0, 0, -60+Args[0]*6)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}
actor SumoW_StompWaveW_H2 : SumoW_StompWaveW_H{DeathSound ""}

actor SumoW_StompWave : BasicProjectile {
  Translation "192:192=144:144", "198:198=15:15"
  Damagetype "SumoWave"
  Obituary "$OB_36A2"
  +FORCEXYBILLBOARD
  +FLOORHUGGER
  //+NODROPOFF
  //MaxDropOffHeight 64
  Damage (48)//80
  Radius 32
  Height 32
  Speed 30
  Scale 2.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    6P36 L 9
    6P36 L 8
    //6P36 PQMNOPQMNOPQMNOPQ 1
    TNT1 A 1 A_SpawnItemEx("SumoW_StompWaveFX", -1*sqrt(momx*momx+momy*momy), 0, 0, momx, momy, momz, 0, 1+8)
    stop
    //6P36 A 1 A_FadeOut(0.1)
    //wait
    //DUOR T
  }
}
Actor SumoW_StompWaveW : SumoW_StompWave {
  Obituary "$OB_36A1"
  Damage (12)//20
  Radius 16
  Height 32
  Speed 15
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    6P36 A 17
    TNT1 A 1 A_SpawnItemEx("SumoW_StompWaveWFX", -1*sqrt(momx*momx+momy*momy), 0, 0, momx, momy, momz, 0, 1+8)
    stop
  }
}

actor SumoW_StompWaveFX : BasicClientSide {
  +FORCEXYBILLBOARD
  Scale 2.0
  States {
   Spawn:
    6P36 L 0//A//W
    6P36 L 1 A_GiveInventory("SumoW_StompWaveFX_P")
    loop
   Spawn3:
    6P36 M 0
    6P36 MNOPQ 1 A_GiveInventory("SumoW_StompWaveFX_P")
    loop
  }
}
actor SumoW_StompWaveWFX : SumoW_StompWaveFX {
  States {
   Spawn:
    6P36 A 0
    6P36 A 1 A_GiveInventory("SumoW_StompWaveFX_P")
    wait
  }
}

actor SumoW_StompWaveFX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SetScale(ScaleX, ScaleY-0.1)
    TNT1 A 0 A_ScaleVelocity(0.8)
    TNT1 A 0 A_FadeOut(0.112)
    stop
  }
}


actor SumoW_QuakeFX_H0 : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("SumoW_QuakeFX_H", 0, 0, 0, 0, 0, 0, 0, 1+32)
    TNT1 A 0 A_PlaySound("SumoW/LeapPound", 1)
    TNT1 A 8 Radius_Quake(1, 12, 0, 4, 0)
    TNT1 A 4
    stop
  }
}

actor SumoW_QuakeFX_H : BasicClientSide {
  Args 15, 31, 63
  States {
   Spawn:
    TNT1 A 0
   Spawn0:
    TNT1 A 0 A_SpawnItemEx("SumoW_QuakeFX", 128, 0, 0, 0, 0, 0, Args[0]*22.5f, 1)
    TNT1 A 0 A_CountDownArg(0, 1)
    loop
    TNT1 A 3
   Spawn1:
    TNT1 A 0 A_SpawnItemEx("SumoW_QuakeFX", 246, 0, 0, 0, 0, 0, Args[1]*11.25f, 1)
    TNT1 A 0 A_CountDownArg(1)//,1)
    loop
    TNT1 A 3
   Spawn2:
    TNT1 A 0 A_SpawnItemEx("SumoW_QuakeFX", 246, 0, 0, 0, 0, 0, Args[2]*5.625f, 1)
    TNT1 A 0 A_CountDownArg(2)
    loop
   Death:
    TNT1 A 1
    stop
  }
}
actor SumoW_QuakeFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 2.0
  States {
   Spawn:
    6P36 W 0
    6P36 W 3
    6P36 WWW 3 A_SetScale(ScaleX, ScaleY-0.5)
    stop
  }
}

Actor SumoWrestler_FloorSlam : BasicExplosion_Args_Trio {
  damagetype "SumoMelee"
  Obituary "$OB_36A3"
  Args 250, 96, 48
}
Actor SumoWrestler_FloorSlam2 : SumoWrestler_FloorSlam {
  Args 150, 16, 16
}

actor SumoWrestler_FloorQuakeSpawn : Basic_FloorQuakeSpawn {
  Obituary "$OB_36A4"
  damagetype "SumoQuakeFling"
  States {
   Quake:
    TNT1 A 4 A_SpawnItemEx("SumoWrestler_FloorQuakeBoom", 0, 0, 28, 0, 0, 0, 0, SXF_TRANSFERSPECIAL)
    stop
  }
}
actor SumoWrestler_FloorQuakeBoom : Basic_FloorQuakeBoom {
  //Translation "4:4=144:144"
  Obituary "$OB_36A4"
  damagetype "SumoQuakeFling"
  MeleeRange 100
}

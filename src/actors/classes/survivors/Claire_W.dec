actor Claire_W_ScriptBar : ScriptBar {}  //NormalBar {args 107, 110}

actor Claire_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 1
Weapon.AmmoGive 28
Inventory.Pickupmessage "$PU_54"
Obituary "$OB_54W"
Tag "$TAG_Claire_W"
weapon.ammotype "ClaireEnergyAmmo"
weapon.ammotype2 "ClaireZestAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H54 [ 6
loop

Deselect:
6H54 A 0
goto DeselectSwap
Select:
6H54 A 0
goto SelectSwap

Ready:
6H54 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLAIRE_DYE)
6H54 A 0 A_GunFlash("Flash",1)
6H54 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready2
Ready1:
6H54 AAAAA 2 A_GiveInventory("Claire_Ready_P2")
Ready2:
6H54 A 2 A_GiveInventory("Claire_Ready_P")
loop

Fire:
6H54 B 2 Offset(-2, 34) A_GiveInventory("Claire_Fire_P")
6H54 A 2 Offset(-1, 33)
6H54 A 2 A_WeaponReady(14)
Goto Ready1


Flash:
TNT1 A 3//21
TNT1 A 1 A_JumpIfInventory("ClaireZestAmmo",28-14*CallACS("uh_checkrune", RUNE_ENDLESSAMMO),1)
wait
TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK,1)
wait
//EFGHIJ[EH] KLMNOP[KN] QRSTUV[QT]
6H54 E 0 A_GunFlash(1)
6H54 K 0 A_GiveInventory("Claire_AltDash_P")
6H54 Q 0 A_RailWait
6H54 E 0 A_Jump(256,1,4,7,10,13,16,19,22,25,28,31,34,37,40,43)
6H54 EKQ 3//Solid
loop
6H54 FLR 3
loop
6H54 GMS 3
loop
6H54 HNT 3
loop
6H54 IOU 3
loop
6H54 JPV 3
loop
6H54 ELS 3//Cycle_jump19
loop
6H54 FMT 3
loop
6H54 GNU 3
loop
6H54 HOV 3
loop
6H54 IPQ 3
loop
6H54 JKR 3//faker_jump34
loop
6H54 JKT 3
loop
6H54 ENQ 3
loop
6H54 HKQ 3
loop

BotReady:
6H54 A 0 A_WeaponReady(12)
6H54 A 2 A_Refire("BotFire")
6H54 A 0 A_GiveInventory("ClaireEnergyAmmo",1)
6H54 A 0 A_GiveInventory("ClaireZestAmmo",1)
loop

Bot_Fire:
6H54 B 2 Offset(-2, 34) A_GiveInventory("Claire_Fire_P")
6H54 A 2 Offset(-1, 33)
6H54 A 2 A_WeaponReady(14)
Goto BotReady

BotAlt:
6H54 A 0 A_Jump(96,"BotAlt2")
goto BotFire+1
BotFire:
6H54 A 0 A_JumpIfInventory("ClaireZestAmmo",0,"BotAlt")
6H54 A 0 A_Jump(32,"BotFire0")
6H54 A 0 A_Jump(14,"BotFire1")
6H54 A 0 A_JumpIfNoAmmo(1)
goto Bot_Fire
6H54 A 0 A_Jump(24,1)
goto Bot_Fire
6H54 A 10 A_GiveInventory("ClaireZestAmmo",5)
BotReload:
6H54 A 0 A_JumpIfInventory("ClaireEnergyAmmo",0,"BotReady")
6H54 A 0 A_GiveInventory("ClaireEnergyAmmo",random(1,2))
6H54 A 2 A_GiveInventory("ClaireZestAmmo",1)
loop

BotFire0:
6H54 A 0 A_JumpIf(momz==0,2)
6H54 A 0 A_Jump(32,1)
goto BotFire+2
6H54 A 0 ThrustThingZ(0,28,0,1)
6H54 A 0 ThrustThing(random(0,255),35,1,0)
//6H54 A 0 A_ChangeVelocity(momx,momy,10.0,CVF_REPLACE)
6H54 A 0 A_GiveInventory("Claire_AltDashFX_P")
goto BotFire+2
BotFire1:
6H54 A 0 A_GiveInventory("ClaireEnergyAmmo",random(14,28))
6H54 A 0 A_GiveInventory("ClaireZestAmmo",random(42,84))
6H54 A 0 A_PlaySoundEx("taunt/D_54","Voice")
6H54 A 0 A_FaceTarget
goto Bot_Fire

BotAlt2:
6H54 B 0 A_GiveInventory("Claire_AltOld_P")
6H54 B 2 Offset(-2, 34)
6H54 A 2 A_WeaponReady(14)
6H54 B 2 Offset(-2, 34)
6H54 A 6 A_WeaponReady(14)
Goto BotReady
}
}

actor ClaireEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 28
+INVENTORY.IGNORESKILL
}
actor ClaireZestAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 84
+INVENTORY.IGNORESKILL
}


actor Claire_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(8)
TNT1 A 0 A_GiveInventory("ClaireEnergyAmmo",1)
TNT1 A 0 A_GiveInventory("ClaireZestAmmo",1)//3
stop
}
}
actor Claire_Ready_P2 : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_WeaponReady(8)
TNT1 A 0 A_GiveInventory("ClaireZestAmmo",1)//3
stop
}
}


actor Claire_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",21,"Fire_Zen")//25
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",11,"Fire_CalmDown")
TNT1 A 0 A_JumpIfInventory("ClaireEnergyAmmo",1,"Fire_SettleDown")
goto Fire_CANYOUSTOP

Fire_Zen:
TNT1 A 0 A_PlaySound("wep/ClaireFire3",1)
TNT1 A 0 A_FireCustomMissile("ClaireShot1",0,1,-8,0)
Goto FireEnd
Fire_CalmDown:
TNT1 A 0 A_PlaySound("wep/ClaireFire2",1)

TNT1 A 0 A_FireCustomMissile("ClaireShot2",random(-1,1),1,-8,0,1,random(-1,1))
Goto FireEnd
Fire_SettleDown:
TNT1 A 0 A_PlaySound("wep/ClaireFire2",1)
TNT1 A 0 A_FireCustomMissile("ClaireShot3",random(-2,2),1,-8,0,1,random(-2,2))
Goto FireEnd
Fire_CANYOUSTOP:
TNT1 A 0 A_PlaySound("wep/ClaireFire1",1)//random(-4,4)
TNT1 A 0 A_FireCustomMissile("ClaireShot4",(random(0,1)*2-1)*random(2,6),1,-8,0,1,(random(0,1)*2-1)*random(2,6))
Goto FireEnd

FireEnd:
TNT1 A 0 A_GiveInventory("ClaireZestAmmo",1)
TNT1 A 0 A_TakeInventory("ClaireEnergyAmmo",1,1)
stop
}
}

actor Claire_AltOld_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("ClaireShotOld",0,0,-8,0)
TNT1 A 0 A_PlaySound("Contra/C_FLAME",1)
TNT1 A 0 A_TakeInventory("ClaireZestAmmo",42)
TNT1 A 0 A_TakeInventory("ClaireZestAmmo",42,1)
TNT1 A 0 A_ChangeVelocity(-Cos(pitch)*25, 0, sin(pitch)*16,CVF_RELATIVE)
stop
}
}

actor Claire_AltDash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("Claire_AltDashFX_P")
TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), 1)
goto Check
TNT1 A 0 ThrustThingZ(0,16,0,0)
goto Check
Check:
TNT1 A 0 A_JumpIf(CallACS("UH_IsInputingMovement"),"Booster")
goto NoBoost
Booster:
TNT1 A 0 A_ChangeVelocity(sin(CallACS("UH_FetchInputDir",0))*35,sin(CallACS("UH_FetchInputDir",1))*-35,momz,3)
goto End
NoBoost:
TNT1 A 0 ThrustThingZ(0,26,0,1)//18
goto End
End:
TNT1 A 0 ThrustThingZ(0,12,0,1)
TNT1 A 0 A_TakeInventory("ClaireZestAmmo",14,1)
TNT1 A 0 A_TakeInventory("ClaireZestAmmo",14)
stop
}
}
actor Claire_AltDashFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySound("wep/ClaireDash",4,1.0)//weapon/slashclaw
TNT1 A 0 A_SpawnItemEx("Claire_DashFX",0,22.5,0,0,0,frandom(1,2),0,32)
TNT1 A 0 A_SpawnItemEx("Claire_DashFX",0,0,0,0,0,frandom(1,2),0,32)
TNT1 A 0 A_SpawnItemEx("Claire_DashFX",0,-22.5,0,0,0,frandom(1,2),0,32)
stop
}
}

actor Claire_DashFX : BasicClientSide
{//87 92 95
Translation "192:192=87:87","198:198=95:95"
States
{
Spawn:
6P54 I 0
6P54 I 0 A_SetScale(2.5*(random(0,1)*2-1),ScaleY)
6P54 IJKLMNOPQR 1
stop
}
}

actor ClaireShot1 : BasicFastProjectile
{
Translation "192:192=107:107","198:198=110:110"//105 110//106 111
damagetype "Claire"
Obituary "$OB_54M1"
+SKYEXPLODE
+DONTBLAST
+BLOODLESSIMPACT
+THRUGHOST
damage (random(195,205)-Args[0]*8)
radius 14
height 14
speed 150
Scale 4.0//2.5
Args -2,10,0
States
{
Spawn:
6P54 A 2
6P54 A 0 A_Jump(256,1,5,9,13,17,21)
SpawnL:
6P54 AAA 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 A 1 A_GiveInventory("ClaireShotStuff_P")
6P54 AAA 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 A 1 A_GiveInventory("ClaireShotStuff_P")
6P54 AAA 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 A 1 A_GiveInventory("ClaireShotStuff_P")
6P54 BBB 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 B 1 A_GiveInventory("ClaireShotStuff_P")
6P54 BBB 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 B 1 A_GiveInventory("ClaireShotStuff_P")
6P54 BBB 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
6P54 B 1 A_GiveInventory("ClaireShotStuff_P")
loop
XDeath:
TNT1 A 1
TNT1 A 1 A_SpawnItemEx("ClaireShotHitFX",0,0,0,0,0,0,0,1+32)
stop
Death:
TNT1 A 1
TNT1 A 1 A_SpawnItemEx("ClaireShotHitFX2",0,0,0,0,0,0,0,1+32)
stop
}
}

actor ClaireShotStuff_P : CustomInventory
{
States
{
Pickup:
TNT1 AAA 0 A_SpawnItemEx("ClaireShotFX",frandom(-12,-0),frandom(-7.5,7.5),frandom(-7.5,7.5),momx*-0.2,momy*-0.2,momz*-0.2,0,1+8,Args[2])
TNT1 A 0 A_JumpIf(Args[0]>=Args[1],2)
TNT1 A 0 A_SetArg(0,Args[0]+1)
TNT1 A 0
stop
}
}


actor ClaireShotOld : ClaireShot1
{
Obituary "$OB_54A"
Damage (100+(Args[3]*0.5))
Radius 16
Height 16
Speed 20
Scale 3.5
Args 150,160,16,20
States
{
Spawn:
TMFX A 0
TMFX AAAA 0 A_SpawnItemEx("ClaireShotOldFX",random(-16,16),random(-16,16),random(-16,16),0,0,0,0,1)
TMFX A 1 A_SpawnItemEx("ClaireShotOldFX",0,0,0,0,0,0,0,1)
TMFX A 0 A_ScaleVelocity(1.125)
TMFX A 0 A_SetArg(3,Args[3]*1.125+0.5)
loop
XDeath:
Crash:
X_8B A 0 Radius_Quake(6,35,0,2,0)
X_8B AAAAAAAAAAAAAAA 0 A_SpawnItemEx("ClaireShotOldFX",0,0,0,random(-12,12),random(-12,12),random(-12,12),0,1)
X_8B A 0 A_PlaySound("S_Spin/Explode",1)
goto Death+1
Death:
X_8B A 0 A_PlaySound("V_Man/Boom",1)
X_8B A 0 A_Explode(Args[0]+(Args[3]/2.5),Args[1]+(Args[3]/14),0,0,Args[2]+(Args[3]/5))
X_8B A 1 A_SetTranslucent(1,0)
X_8B A 1 A_SetTranslucent(1,1)
X_8B B 1 A_SetTranslucent(1,0)
X_8B B 1 A_SetTranslucent(1,1)
X_8B C 1 A_SetTranslucent(1,0)
X_8B C 1 A_SetTranslucent(1,1)
X_8B D 1 A_SetTranslucent(1,0)
X_8B D 1 A_SetTranslucent(1,1)
X_8B E 1 A_SetTranslucent(1,0)
X_8B E 1 A_SetTranslucent(1,1)
X_8B F 1 A_SetTranslucent(1,0)
X_8B F 1 A_SetTranslucent(1,1)
stop
}
}

actor ClaireShotOldFX : BasicClientSide
{
RenderStyle Add
Alpha 0.85
Scale 3.0
States
{
Spawn:
TMFX BBCCDD 1 A_FadeOut(0.05)
Stop
}
}

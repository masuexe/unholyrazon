actor TheDentist : CustWepClassBase {
  Player.ScoreIcon "UMUG_29"
  Player.DisplayName "TheDentist"
  Player.SoundClass "TheDentist"
  Player.MaxHealth 825
  Health 825
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 13
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "TheDentist_W"
  Player.StartItem "ShinyEnergyAmmo", 100
  States {
   Spawn:
    METM A 0
    METM B 1
    METM A 1
    goto Spawn+2
   See:
    METM BCDE 5
    goto Spawn
   Missile:
    METM FFFFF 1
    METM GGGG 1
    goto Spawn+2
   ClassPain:
    METM H 0
    goto MegamanPain

   ClassDeath:
    METM H 0
    goto MegamanDeath
   MegamanDeath0:
    METM H 18 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    METM HHHH 0 A_SpawnItemEx("TheDentistTeethDeath", random(8, 12), 0, frandom(28, 36), frandom(1, 4), 0, frandom(4, 12), random(0, 44) * 8, 1)
    METM HHHH 0 A_SpawnItemEx("TheDentistTeethDeath", random(8, 12), 0, frandom(24, 32), frandom(3, 7), 0, frandom(4, 12), random(0, 44) * 8, 1)
    goto MegamanErase
   MegamanDisintegrate:
    METM Z 0 A_SpawnItemEx("Corpse_29", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor TheDentistShiny : TheDentist {
  Player.ScoreIcon "UMUG_S29"
  Player.MaxHealth 2900
  Health 2900
  Player.ForwardMove 1.3, 1.3
  Player.SideMove 1.3, 1.3
  Player.JumpZ 14
  Player.MorphWeapon "TheDentistShiny_W"
  +NOSKIN
  +PLAYERPAWN.NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    METM H 18 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    METM HHHH 0 A_SpawnItemEx("S_TheDentistTeethDeath", random(8, 12), 0, frandom(28, 36), frandom(1, 4), 0, frandom(4, 12), random(0, 44) * 8, 1)
    METM HHHH 0 A_SpawnItemEx("S_TheDentistTeethDeath", random(8, 12), 0, frandom(24, 32), frandom(3, 7), 0, frandom(4, 12), random(0, 44) * 8, 1)
    goto MegamanDeath
  }
}

actor TheDentistTeethDeath : BasicProjectile {
  Translation "192:192=4:4", "198:198=196:196"
  DamageType "ShinyBlade"
  Obituary "$OB_29D"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +BOUNCEONCEILINGS
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +NOEXPLODEFLOOR
  +CANBOUNCEWATER
  +THRUGHOST
  BounceFactor 0.45
  WallBounceFactor 0.75
  BounceCount 10
  ReactionTime 14
  Damage (125)
  Radius 12
  Height 10
  Speed 5
  Scale 1.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ThrustThingZ(0, 8, 0, 1)
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14, 16, 17, 18, 19)
   Tooth1:
    6P29 TUVW 2
    6P29 T 0 A_CountDown
    loop
   Tooth2:
    6P29 TUVW 3
    6P29 T 0 A_CountDown
    loop
   Tooth3:
    6P29 WVUT 2
    6P29 W 0 A_CountDown
    loop
   Tooth4:
    6P29 WVUT 3
    6P29 W 0 A_CountDown
    loop
   Death:
    6P29 "#" 0 A_Stop
    6P29 "#" 0 A_ChangeFlag("NOGRAVITY", 1)
    6P29 "#" 1
    stop
  }
}
actor S_TheDentistTeethDeath : TheDentistTeethDeath {
  Damage (188)
}


actor Corpse_29 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_29_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_29_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


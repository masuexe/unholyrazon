    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 75, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(75), 0, sin(75), 90, 40961)  //

    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 270, 40961)

    X_8G W 0 A_SpawnItemEx("ClusterBombShotFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop

   Death:
    X_8G A 0 A_PlaySoundEx("Pokemon/Explosion", "Weapon")
    X_8G ABCEFF 2 Bright A_Explode(args[0], args[1], 0, 0, args[2])
    X_8G FECBA 1 Bright
    stop
  }
}


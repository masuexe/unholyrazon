actor ClusterBombShot : BasicProjectile {
  Translation "192:192=16:16", "198:198=31:31"
  DamageType "Cluster"
  Obituary "$OB_08M1"
  +FORCEXYBILLBOARD
  +SKYEXPLODE
  +CANBOUNCEWATER
  Damage (75)
  Radius 12
  Height 13
  Speed 45  // 22
  Scale 4.5
  Args 77, 108, 32
  States {
   Spawn:
    X_8G W 0
    X_8G W 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    X_8G WWWXXXYYYZZZ 1
   BoomD:
    X_8G W 0 A_PlaySoundEx("Contra/C_EXPLO", "Weapon")

    X_8G WW 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, 0, 0, 1, 0, 1 + SXF_MULTIPLYSPEED + SXF_TRANSFERSPECIAL)  // 8192+32768

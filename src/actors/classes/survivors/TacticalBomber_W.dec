    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 165, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(75), 0, sin(75), 180, 40961)  //
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 195, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 210, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 225, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 240, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 255, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(75), 0, sin(75), 270, 40961)  //
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 285, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 300, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 315, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 330, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 345, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 0, 40961)

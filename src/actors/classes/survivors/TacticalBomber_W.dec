    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(60), 0, sin(60), 15, 40961)
    X_8G W 0 A_SpawnItemEx("ClusterBombShotX", 0, 0, 0, cos(45), 0, sin(45), 30, 40961)

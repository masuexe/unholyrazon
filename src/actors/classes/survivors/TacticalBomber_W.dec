   Spawn:
    X_8G Y 0
    X_8G Y 0 A_Recoil(frandom(0, -5))
    X_8G YZ 2
    goto Spawn+2
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", "Weapon")
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1 + 16384)
    stop
  }
}

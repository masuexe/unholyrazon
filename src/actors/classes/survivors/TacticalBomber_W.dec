actor TacticalBomber_W_NormalBar : NormalBar {Args 16, 31}

actor TacticalBomber_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 350
  Inventory.Pickupmessage "$PU_08"
  Obituary "$OB_08W"
  Tag "$TAG_TacticalBomber_W"
  Weapon.AmmoType "ExplosiveEnergyAmmo"
  States {
   Spawn:
    6H08 [ 6
    loop

   Deselect:
    6H08 A 0
    goto DeselectSwap
   Select:
    6H08 A 0
    goto SelectSwap

   Ready:
    6H08 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TACTICALBOMBER_DYE)
    6H08 A 0
    goto Ready2
   Ready2:
    6H08 A 2 A_GiveInventory("TacticalBomber_Ready_P", 2)
    6H08 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 2)
    loop

   Fire:
    6H08 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H08 A 0 A_TakeInventory("TacticalBomberFlag")
    6H08 A 0 A_PlaySound("wep_L/TactBombFire", 1)
    6H08 A 1 Offset(16, 56) A_FireCustomMissile("TacticalBombShot", 0, 1, 8, 0)
    6H08 A 3 Offset(34, 82) A_GunFlash("Flash", 1)

    6H08 A 2 Offset(19, 66)
    6H08 A 2 Offset(11, 53)
    6H08 A 0 Offset(5, 42)
   FireH:
    6H08 C 1 A_RailWait
    6H08 C 0 A_ReFire(1)
    goto FireEnd
    6H08 C 1 A_RailWait
    6H08 C 0 A_ReFire(1)
    goto FireEnd
    6H08 A 1 A_RailWait
    6H08 A 0 A_ReFire(1)
    goto FireEnd
    6H08 A 1 A_RailWait
    6H08 A 0 A_ReFire("FireH")
    goto FireEnd
   FireEnd:
    6H08 B 2 A_GiveInventory("TacticalBomberFlag")
    6H08 A 2
    6H08 B 2 A_GunFlash("NoFlash", 1)
    6H08 B 0 A_GiveInventory("ExplosiveEnergyAmmo", 2)
    goto Ready2

   Flash:
    TNT1 A 2 A_GiveInventory("ExplosiveEnergyAmmo", 1)
    loop

   Altfire:
    6H08 A 0 A_JumpIfInventory("DeadlyExplosiveFlag", 1, "AltFire2")
    6H08 A 0 A_GiveInventory("DeadlyExplosiveFlag", 1)
    6H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 250, 1)
    6H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 100)
    6H08 A 0 A_PlaySound("wep_L/TactBombAlt6", 1)
    6H08 A 0 A_FireCustomMissile("TacticalExplosive", 0, 0, 0, 0)

    6H08 A 1 Offset(16, 56)
    6H08 A 6 Offset(34, 82)
    6H08 A 4 Offset(19, 66)
    6H08 A 4 Offset(11, 53)
    6H08 A 4 Offset(5, 42)
    goto Ready2

   AltFire2:
    6H08 B 0 A_GiveInventory("TacticalBomber_Alt2_P")
    6H08 BCEA 1
    6H08 BCEA 1
    6H08 A 0 A_TakeInventory("DeadlyExplosiveFlag")
    goto Ready2


   BotFire:
    6H08 A 0 A_JumpIfInventory("ExplosiveEnergyAmmo", 350 - 250 * CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "BotFireAlt")
    6H08 A 0 A_Jump(8, "BotFireAlt2")
    6H08 A 0 A_Jump(96, "BotFire1")
    6H08 A 0 A_Jump(43, "BotFire3")
    6H08 A 0 A_JumpIfInventory("DeadlyExplosiveFlag", 1, "AltFire2")
    6H08 B 0 A_TakeInventory("TacticalBomberFlag")
    6H08 B 0 A_PlaySound("wep_L/TactBombFire", 1)
    6H08 B 0 A_FireCustomMissile("TacticalBombShot", 0, 1, 8, 0)
    6H08 BCDEAA 2
    6H08 A random(4, 12)
    6H08 A 0 A_GiveInventory("TacticalBomberFlag")
    goto Ready2
   BotFire1:
    6H08 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 40)
    6H08 A 0 A_PlaySound("weapon/crackerthrow", 1)
    6H08 A 0 A_Jump(110, "BotFire2")
    6H08 B 0 A_FireCustomMissile("SJBombShot", 0, 0, 8, 0)
    6H08 BABABA 2
    6H08 A 12
    goto Ready2
   BotFire2:
    6H08 C 0 A_FireCustomMissile("TacticalCracker", 0, 0, 8, 0)
    6H08 CACACA 2
    6H08 A 12
    goto Ready2
   BotFire3:
    6H08 A 0 A_PlaySound("weapon/crackerthrow", 1)
    6H08 A 0 A_FireCustomMissile("ClusterBombShot", 0, 1, 8, 0)
    6H08 EAEAEA 2
    6H08 A 12
    goto Ready2
   BotFireAlt:
    6H08 A 0 A_Jump(198, "Altfire")
   BotFireAlt2:
    6H08 A 0 A_PlaySound("classes/taunt/tacticalbomber", "Voice")
    6H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 250, 1)
    6H08 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 100)
    6H08 A 0 A_Jump(128, "BotFireAlt4")
    6H08 A 0 A_PlaySound("weapon/superarmuse", 1)
    6H08 B 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, -28, 0, 0, 0, 0, 33)
    6H08 B 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 0, 0, 0, 0, 0, 33)
    6H08 A 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 28, 0, 0, 0, 0, 33)
    6H08 A 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 32, 0, 56, 0, 0, 0, 0, 33)
    6H08 CCAADD 1 A_SpawnItemEx("TempLobbingDeadlyBomb", 0, 0, 56, 0, 0, 0, 0, 33)
    6H08 E 0 A_SpawnItemEx("TempLobbingDeadlyBomb", 0, 0, 56, 0, 0, 0, 0, 33)
    6H08 E 0 A_FireCustomMissile("LobbingDeadlyBomb", 0, 0, 0, 56)
    6H08 AABBA 1
    6H08 A 0 A_FireCustomMissile("LobbingDeadlyBomb", 0, 0, 0, 56)
    6H08 ACCAA 1
    6H08 A 0 A_FireCustomMissile("LobbingDeadlyBomb", 0, 0, 0, 56)
    6H08 DD 1
    6H08 A 12
    goto Ready2
   BotFireAlt4:
    6H08 A 0 A_PlaySound("weapon/crackermine", 1)
    6H08 A 0 A_SpawnItemEx("LobbingDeadlyBomb2", 0, 0, 16)
    6H08 DADA 2
    6H08 A 0 A_PlaySound("weapon/crackermine", 1)
    6H08 A 0 A_SpawnItemEx("LobbingDeadlyBomb2", 0, 0, 16)
    6H08 CACA 2
    6H08 A 0 A_PlaySound("weapon/crackermine", 1)
    6H08 A 0 A_SpawnItemEx("LobbingDeadlyBomb2", 0, 0, 16)
    6H08 BABA 2
    goto Ready2
  }
}

actor ExplosiveEnergyAmmo : Ammo {
  Inventory.MaxAmount 350
  +INVENTORY.IGNORESKILL
}

actor TacticalBomberFlag : Powerup {
  Powerup.Duration 4
}
actor DeadlyExplosiveFlag : Inventory {Inventory.MaxAmount 2
}

actor ClusterBombCooldown : Powerup {
  Powerup.Duration 16
}


actor TacticalBomber_Ready_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ExplosiveEnergyAmmo", 0, "Ready3")
    TNT1 A 0 A_JumpIfInventory("DeadlyExplosiveFlag", 1, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    stop
   Ready3:
    TNT1 A 0 A_WeaponReady
    stop
   Ammo:
    TNT1 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 2)
    stop
  }
}

actor TacticalBomber_Alt2_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("DeadlyExplosiveFlag", 1)
    TNT1 A 0 A_PlaySound("wep_L/TactBombAlt2", 1)
    TNT1 A 0 A_JumpIfInventory("ExplosiveEnergyAmmo", 320, 2)
    TNT1 A 0 A_GiveInventory("ExplosiveEnergyAmmo", 8)
    stop
    TNT1 A 0 A_TakeInventory("ExplosiveEnergyAmmo", 30, 1)
    stop
  }
}

actor TacticalBombShot : BasicProjectile {
  Translation "192:192=16:16", "198:198=31:31"
  DamageType "Cluster"
  Obituary "$OB_08M1"
  +FORCEXYBILLBOARD
  +SKYEXPLODE
  +CANBOUNCEWATER
  +RIPPER
  Damage (0)
  Radius 12
  Height 13
  Speed 36  // 22
  Scale 3.5
  Args 130, 112, 16
  States {
   Spawn:
    X_8G W 0
    // WWWXXXYYYZZZ
    X_8G WWYZXXYYWXZZ 1 A_JumpIfInTargetInventory("TacticalBomberFlag", 1, "SpawnBoom")
    loop
   SpawnBoom:
    "----" "#" 0 A_SpawnItemEx("TacticalBombBoom", 0, 0, 0, 0, 0, 0, 0, 1)
    stop

   Death:
    TNT1 A 0 A_PlaySoundEx("wep_L/TactBombFire2", "Weapon")
    TNT1 S 2 A_Explode(args[0], args[1], 0, 0, args[2])
    // 6P08 FGH 3 Bright
    6P08 TUV 3 Bright
    stop
  }
}

actor TacticalBombBoom : BasicExplosion {
  DamageType "Cluster"
  Obituary "$OB_08M2"
  +FORCEXYBILLBOARD
  +BRIGHT
  Args 320, 128, 96
  Scale 3.5
  States {
   Spawn:
    6P08 O 0
    6P08 O 0 A_PlaySoundEx("wep_L/TactBombFire3", "Weapon")
    6P08 O 2 A_Explode(args[0], args[1], 0, 0, args[2])
    6P08 PQR 3
    stop
  }
}


actor TacticalExplosive : BasicProjectile {
  Translation "192:192=16:16", "198:198=31:31"
  DamageType "Cluster"
  Obituary "$OB_08A"
  // +THRUACTORS
  -NOGRAVITY
  // +HEXENBOUNCE
  +CANBOUNCEWATER
  +BOUNCEONCEILINGS
  +FORCEXYBILLBOARD
  +DONTREFLECT
  +THRUACTORS
  BounceFactor 1.0
  WallBounceFactor 0.0
  ReactionTime 10  // 8
  Radius 12
  Height 20
  Speed 30
  Scale 3.5
  States {
   Spawn:
    6P08 A 0
    6P08 A 0 ThrustThingZ(0, 10, 0, 1)
    6P08 A 0 ThrustThing(angle * 256 / 360, 4, 1, 0)
   SpawnL:  // 48
    6P08 AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_JumpIfInTargetInventory("DeadlyExplosiveFlag", 2, "SpawnBoom")
    6P08 A 0 A_CountDown
    loop
   SpawnBoom:
    TNT1 A 0 A_SpawnItemEx("TacticalExplosive3", 0, 0, Height / 2, 0, 0, 0, 0, 1)
    stop
   Death:
    6P08 "#" 0 A_SpawnItemEx("TacticalExplosive2", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor TacticalExplosive2 : BasicExplosion {
  DamageType "Cluster"
  Obituary "$OB_08A"
  +FORCEXYBILLBOARD
  ReactionTime 35
  Height 20
  Scale 3.5
  States {
   Spawn:
    6P08 D 0
    6P08 D 0 A_PlaySoundEx("assists_L/reggaecandrop", "Weapon")
   SpawnL2:
    6P08 DDDCCCBBBAAA 1 A_JumpIfInTargetInventory("DeadlyExplosiveFlag", 2, "Death")
    6P08 A 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P08 DDDCCCBBBAAA 1 A_JumpIfInTargetInventory("DeadlyExplosiveFlag", 2, "Death")
    6P08 A 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P08 DDDCCCBBBAAA 1 A_JumpIfInTargetInventory("DeadlyExplosiveFlag", 2, "Death")
    6P08 A 0 A_JumpIfInTargetInventory("IsDead", 1, "Death")
    6P08 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("TacticalExplosive3", 0, 0, Height / 2, 0, 0, 0, 0, 1)
    stop
  }
}

actor TacticalExplosive3 : TacticalExplosive2 {
  PainSound "wep_L/TactBombAlt3"
  ReactionTime 8
  Args 75, 256, 128
  States {
   Spawn:  // 2400 DAMAGE
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("TacticalExplosiveFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
   SpawnL:  // BasicBoom4FX_ColorX_Tic2
    TNT1 A 0 A_Pain  // A_PlaySound("wep_L/TactBombAlt3",1)
    TNT1 AA 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 2
    TNT1 AA 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 2 A_CountDown
    loop
   Death:
    TNT1 A 0
    // X_1D BCDEFGHIJKLMN 1 Bright
    stop
  }
}

actor TacticalExplosiveFX_H : BasicClientSide {
  Args 16
  States {
   Spawn:
    TNT1 A 0
    goto Reset+1
   SpawnL:  // BasicBoom4FX_ColorX_Tic2//
    TNT1 AA 0 A_SpawnItemEx("TacticalExplosiveFX", random(4, 240), random(-3, 3) * 5, random(1, 120) * args[3], 0, 0, 0, 90 * args[1] + random(-5, 5) * 9, 1, 16)
    TNT1 A 0 A_SpawnItemEx("TacticalExplosiveFX2", 1, 0, 2 * args[3], random(0, 22), random(-5, 5), random(0, 22) * args[3], 90 * args[1] + random(-30, 30) * 3, 1, 12)

    TNT1 A 0 A_JumpIf(args[1] <= 0 && args[3] == 1, "Reset")
    TNT1 A 0 A_JumpIf(args[1] <= 0, "Flip")
    TNT1 A 0 A_SetArg(1, args[1] - 1)
    loop
   Flip:
    TNT1 A 0 A_SetArg(3, 1)
    TNT1 A 0 A_SetArg(1, 4)
    goto SpawnL
   Reset:
    TNT1 A 2 A_CountDownArg(0)
    TNT1 A 0 A_SetArg(3, -1)
    goto Flip+1
   Death:
    TNT1 A 0
    stop
  }
}
actor TacticalExplosiveFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(scaleX + frandom(-1, 0.25))
    TNT1 A random(0, 2) A_SetScale(scaleX * (random(0, 1) * 2 - 1), scaleY)
    TNT1 A 0 A_Jump(128, "Spawn2")
    6P08 I random(1, 3)
    6P08 I 0 A_Jump(128, 2)
    6P08 JKJI random(2, 3)
    stop
   Spawn2:
    6P08 WXYZ random(2, 3)
    stop
  }
}
actor TacticalExplosiveFX2 : TacticalExplosiveFX {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    TNT1 A 0
    TNT1 A random(2, 4)
    6P08 L 0
    6P08 LMN 2
    stop
  }
}



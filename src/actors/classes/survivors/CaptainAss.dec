actor CaptainAss : CustWepClassBase
{
player.scoreIcon "UMUG_42"
player.displayname "CaptainAss"
player.soundclass "CaptainAss"
Player.Maxhealth 925
health 925
player.forwardmove 1.05, 1.05
player.sidemove 1.03, 1.03
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "CaptainAss_W"
player.startitem "FreeDLCEnergyAmmo", 150
States
{
Spawn:
PIRA A 0
PIRA B 1
PIRA A 1
Goto Spawn+2
See:
PIRA BCDE 5
Goto Spawn
Missile:
PIRA F 0 A_JumpIfInventory("VivifyFlag1",1,"Missile2")
PIRA F 5
PIRA G 4
goto Spawn+2
Missile2:
PIRA F 1
PIRA FG 1 A_JumpIfInventory("VivifyFlag1",1,"Missile2")
goto Spawn+2
ClassPain: PIRA H 0
Goto MegamanPain

ClassDeath:
PIRA H 0
goto MegamanDeath
MegamanDeath0:
PIRA H 19 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PIRA H 0 A_SpawnItemEx("CaptainAssBombDeath",0,0,10,0,0,0,0,1)
PIRA HHHHHH 0 A_SpawnItemEx("CaptainAssBombDeath",0,0,32,random(-10,10),random(-10,10),random(2,10),0,1)
Goto MegamanFade
MegamanCorpse:
PIRA Z 0 A_SpawnItemEx("Corpse_42",0,0,0,momx,momy,momz,0,9)
Goto MegamanGib
}
}
actor CaptainAssS : CaptainAss
{
player.scoreIcon "UMUG_S42"
Player.Maxhealth 2925
health 2925
player.forwardmove 1.15, 1.15
player.sidemove 1.13, 1.13
player.jumpz 11
player.morphweapon "CaptainAssS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
PIRA H 19 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
PIRA H 0 A_SpawnItemEx("S_CaptainAssBombDeath",0,0,10,0,0,0,0,1)
PIRA HHHHHH 0 A_SpawnItemEx("S_CaptainAssBombDeath",0,0,32,random(-10,10),random(-10,10),random(2,10),0,1)
Goto FadeDeathEnd
}
}



actor CaptainAssBombDeath
{
PROJECTILE
damagetype "CaptainAss"
Obituary "$OB_42D"
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
-NOGRAVITY
damage (25)
Radius 14
Height 14
speed 55
scale 2.5
Args 25,80,0
States
{
Spawn:
X_BF VWXY 3
loop
Death:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_PlaySound("weapon/rmineexplode")
TNT1 A 0 A_SpawnItemEx("CaptainAssBombDeathFX",0,0,0,0,0,0,0,1)
TNT1 AAAAAAAA 2 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}
actor CaptainAssBombDeathFX : BasicClientSide
{
+FORCEXYBILLBOARD
+BRIGHT
States
{
Spawn:
X_BF A 0
X_BF ABACADAFAGAHAIAJANAPOPO 1
stop
}
}

actor S_CaptainAssBombDeath : CaptainAssBombDeath
{
damage (38)
Args 38,80,0
}


actor CaptainAss : CustWepClassBase {
  Player.ScoreIcon "UMUG_42"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "CaptainAss"
  Player.SoundClass "CaptainAss"
  Player.MaxHealth 925
  Health 925
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.03, 1.03
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "CaptainAss_W"
  Player.StartItem "FreeDLCEnergyAmmo", 150
  States {
   Spawn:
    PIRA A 0
    PIRA B 1
    PIRA A 1
    goto Spawn+2
   See:
    PIRA BCDE 5
    goto Spawn
   Missile:
    PIRA F 0 A_JumpIfInventory("VivifyFlag1", 1, "Missile2")
    PIRA F 5
    PIRA G 4
    goto Spawn+2
   Missile2:
    PIRA F 1
    PIRA FG 1 A_JumpIfInventory("VivifyFlag1", 1, "Missile2")
    goto Spawn+2
   ClassPain:
    PIRA H 0
    goto MegamanPain

   ClassDeath:
    PIRA H 0
    goto MegamanDeath
   MegamanDeath0:
    PIRA H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    PIRA H 0 A_SpawnItemEx("CaptainAssBombDeath", 0, 0, 10, 0, 0, 0, 0, 1)
    PIRA HHHHHH 0 A_SpawnItemEx("CaptainAssBombDeath", 0, 0, 32, random(-10, 10), random(-10, 10), random(2, 10), 0, 1)
    goto MegamanFade
   MegamanDisintegrate:
    PIRA Z 0 A_SpawnItemEx("Corpse_42", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor CaptainAssShiny : CaptainAss {
  Player.ScoreIcon "UMUG_S42"
  Player.MaxHealth 2925
  Health 2925
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.13, 1.13
  Player.JumpZ 11
  Player.MorphWeapon "CaptainAssShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    PIRA H 19 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    PIRA H 0 A_SpawnItemEx("S_CaptainAssBombDeath", 0, 0, 10, 0, 0, 0, 0, 1)
    PIRA HHHHHH 0 A_SpawnItemEx("S_CaptainAssBombDeath", 0, 0, 32, random(-10, 10), random(-10, 10), random(2, 10), 0, 1)
    goto FadeDeathEnd
  }
}

actor CaptainAssBombDeath : BasicProjectile {
  DamageType "CaptainAss"
  Obituary "$OB_42D"
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  -NOGRAVITY
  Damage (25)
  Radius 14
  Height 14
  Speed 55
  Scale 2.5
  Args 25, 80, 0
  States {
   Spawn:
    X_BF VWXY 3
    loop
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySound("weapon/rmineexplode")
    TNT1 A 0 A_SpawnItemEx("CaptainAssBombDeathFX", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 AAAAAAAA 2 A_Explode(args[0], args[1], 0, 0, args[2])
    stop
  }
}
actor CaptainAssBombDeathFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    X_BF A 0
    X_BF ABACADAFAGAHAIAJANAPOPO 1
    stop
  }
}

actor S_CaptainAssBombDeath : CaptainAssBombDeath {
  Damage (38)
  Args 38, 80, 0
}

actor Corpse_42 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_42_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_1", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_3", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_42_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


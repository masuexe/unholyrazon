F_1:TNT1 A 0 A_SpawnItemEx("TangoGirlSlasherA",cos(-pitch)*52,-8,32+(sin(-pitch)*52),cos(-pitch)*momx,momy,sin(-pitch)*momz,0,41)goto EndSound//1+8+32

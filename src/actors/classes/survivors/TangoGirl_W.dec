actor TangoGirlSlasherA : BasicExplosion
{
damagetype "CatSlash"
Obituary "$OB_24M"
Speed 21
Scale 3.0
Args 77,102,13//Damage, radius, fulldmgradius
States
{
Spawn:
SA:
X_7F A 0
goto Boom
SB:
X_7F B 0
goto Boom
SC:
X_7F C 0
goto Boom
SD:
X_7F D 0
goto Boom
SE:
X_7F E 0
goto Boom
SF:
X_7F F 0
goto Boom
SG:
X_7F G 0
goto Boom
SH:
X_7F H 0
goto Boom
SI:
X_7F I 0
goto Boom
SJ:
X_7F J 0
goto Boom
Boom:
X_7F "#" 2 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}

actor TangoGirlSlasherB : TangoGirlSlasherA{States{Spawn:goto SB}}
actor TangoGirlSlasherC : TangoGirlSlasherA{States{Spawn:goto SC}}
actor TangoGirlSlasherD : TangoGirlSlasherA{States{Spawn:goto SD}}
actor TangoGirlSlasherE : TangoGirlSlasherA{States{Spawn:goto SE}}

actor TangoGirlSlasherF : TangoGirlSlasherA{States{Spawn:goto SF}}
actor TangoGirlSlasherG : TangoGirlSlasherA{States{Spawn:goto SG}}
actor TangoGirlSlasherH : TangoGirlSlasherA{States{Spawn:goto SH}}
actor TangoGirlSlasherI : TangoGirlSlasherA{States{Spawn:goto SI}}
actor TangoGirlSlasherJ : TangoGirlSlasherA{States{Spawn:goto SJ}}

actor TangoGirlGrabberCheck
{
//+NOINTERACTION
+MISSILE
+NOBLOCKMAP
+NOGRAVITY
+NOEXPLODEFLOOR
+NOTIMEFREEZE
+DONTBLAST
+DONTREFLECT
+THRUGHOST
+HITTRACER
//+SERVERSIDEONLY
height 64
radius 56
renderstyle none
states
{
Spawn:
TNT1 A 0
TNT1 A 1
stop
Crash:
TNT1 A 0 A_JumpIfInTargetInventory("SuplexID",1,"DeathI")
TNT1 A 0 A_JumpIfInventory("IsPerformingSuplex",1,"DeathJ",8)
TNT1 A 1 A_JumpIf(CallACS("uh_istracerplayer"),"GiveSuplex")
stop
GiveSuplex:
TNT1 A 0 A_JumpIfInTargetInventory("SuplexID",1,"DeathI")
TNT1 A 0 A_JumpIfInventory("IsPerformingSuplex",1,"DeathJ",8)
TNT1 A 0 A_GiveToTarget("IsPerformingSuplex",1)
TNT1 A 0 A_GiveToTarget("SuplexID",(CallACS("core_getptrtid", 8)-1000)+1)
TNT1 A 0 A_GiveToTarget("PowerTangoGirlDamageDown",1)
TNT1 A 0 A_GiveToTarget("PlayerPropertyCantUseItems",1)
TNT1 A 0 A_TakeFromTarget("ZangiefAngle")
TNT1 A 0 A_Warp(8,0,0,28,0,8)
TNT1 A 0 A_FaceTarget
TNT1 A 0 A_GiveInventory("ZangiefAngle",angle*256/360)

TNT1 A 1
Carry:
TNT1 A 0 //A_GiveInventory("TempPitProtect_P",1,8)
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "DeathD")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "StopCarry")
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 2, 0) & BT_JUMP, "StopCarry")
TNT1 A 1 A_Jumpif(CallACS("uh_ZangiefGrabReverse",340,CallACS("uh_ZangiefCountInv",1,0),70)==0,"StopCarry")
TNT1 A 1 A_JumpIfInTargetInventory("SuplexID",1,"Carry")
StopCarry:
TNT1 A 1 A_GiveToTarget("TangoGirlSuplexReset_P",1)
stop

DeathD:
TNT1 A 1 //A_LOG("OWNER IS DEAD!")
stop
DeathI:
TNT1 A 1 //A_LOG("FAILED, OWNER HAS ID")
stop
DeathJ:
TNT1 A 1 //A_LOG("FAILED, CAN'T GRAB SOMEONE GRABBING!")
stop
Death:
TNT1 A 1
stop
}
}

actor TangoGirlCatAttack : BasicProjectile
{
Translation "192:192=201:201","198:198=128:128"
ActiveSound "item/tango"
damagetype "CatStun"
Obituary "$OB_24A"
-NOGRAVITY
+FORCEXYBILLBOARD
+BOUNCEONFLOORS
+BOUNCEONWALLS
+BOUNCEONCEILINGS
+CANBOUNCEWATER
+SKYEXPLODE
WALLBOUNCEFACTOR 0.945
BOUNCEFACTOR 0.945
reactiontime 10
Damage (90)
Radius 14
Height 33
speed 28
scale 2.5
States
{
Spawn:
TNT1 A 1
6P24 E 0 A_ActiveSound
Spawn2:
6P24 E 0 A_CountDown
6P24 EFG 3
loop
XDeath:
TNT1 A 0 A_PlaySoundEx("classes/DerpyHitX",1)
Death:
TNT1 A 2 A_SpawnItemEx("TangoGirlCatAttackFX",0,0,ScaleX*2,0,0,0,0,1+32+SXF_TRANSFERSCALE)//16384
stop
}
}

actor TangoGirlCatAttackFX
{
+MISSILE
+NOGRAVITY
+NOPAIN
+THRUACTORS
+DONTBLAST
+DONTSPLASH
+BLOODLESSIMPACT
+CLIENTSIDEONLY
Damage 0
Radius 8
Height 60
Speed 30
scale 2.5
States
{
Spawn:
TFOG C 0
TFOG CB 2
TFOG A 0 ThrustThingZ(0,44,0,1)
TFOG A 35 A_CountDown
stop
Death:
TFOG A 0
stop
}
}

actor TangoGirl_W_ScriptBar : ScriptBar {}

actor TangoGirl_W : BaseMM8BDMWep_UH //Rip Tangoman
{
Weapon.AmmoUse 0
Weapon.AmmoGive 200
Inventory.Pickupmessage "$PU_24"
Obituary "$OB_24W"
Tag "$TAG_TangoGirl_W"
weapon.ammotype "TangoEnergyAmmo"
//weapon.ammotype2 "TangoEnergyAmmo"
States
{
Spawn:
6H24 [ 6
loop

Deselect:
6H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto DeselectSwap
6I24 A 0
goto DeselectSwap
Select:
6H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,1)
goto SelectSwap
6I24 A 0
goto SelectSwap

Ready:
6H24 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TANGOGIRL_DYE)
6H24 A 0 A_JumpIf(CallACS("UH_IsBot"),"BotReady")
goto Ready0
Ready0:
6H24 A 0 A_JumpIfInventory("DuoBusterFlag",1,"Ready2")
6H24 A 2 A_GiveInventory("TangoGirl_Ready_P")
wait
Ready2:
6I24 A 2 A_GiveInventory("TangoGirl_Ready_P")
wait


Fire:
"####" B 1
"####" C 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" D 1 A_GunFlash("Flash",1)
"####" E 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" F 1
"####" G 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" H 1
"####" I 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" J 1
"####" K 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" L 1
"####" M 1 A_JumpIfInventory("PlayerPropertyRage",1,1)
"####" N 1
"####" O 1 A_JumpIfInventory("PlayerPropertyRage",1,"Ready0")
goto Ready0

Flash:
TNT1 A 0 A_JumpIfInventory("DuoBusterFlag",1,7)
TNT1 A 1 A_GiveInventory("DuoBusterFlag",1)
TNT1 A 2 A_GiveInventory("TangoGirl_Fire1_P2")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire2_P2")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire3_P2")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire4_P2")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire5_P2")
stop
TNT1 A 1 A_TakeInventory("DuoBusterFlag")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire1_P")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire2_P")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire3_P")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire4_P")
TNT1 A 2 A_GiveInventory("TangoGirl_Fire5_P")
stop

Altfire:
"####" S 2 A_PlaySound("item/tango",4,0.75)
"####" T 2 A_TakeInventory("SuplexID")
"####" U 0 A_GiveInventory("TangoGirl_Alt_P")
GrabbyLoop:
"####" U 0 A_JumpIfInventory("TangoGirlFlag",15,"GrabbyFail")
"####" U 1 A_GiveInventory("TangoGirlSuplexSpawn_P")
"####" U 0 A_JumpIfInventory("SuplexID",1,"GrabbySuplex")
loop
GrabbyFail:
"####" T 3 
"####" S 3 A_GiveInventory("TangoGirlSuplexReset_P2")
goto Ready0
GrabbySuplex:
"####" T 2 A_PlaySoundEx("KirbyNES/FoeGrab","SoundSlot6")
"####" S 2
goto Ready0

BotReady:
6H24 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
6H24 A 0 A_WeaponReady(12)
6H24 A 2 A_Refire("BotFire")
6H24 A 0 A_GiveInventory("TangoEnergyAmmo",2)
goto BotReady+2
BotFire:
6H24 C 0 A_JumpIfInventory("TangoEnergyAmmo",0,"BotFire1")
6H24 C 0 A_Jump(14,"BotFireX")
6H24 C 2 A_GiveInventory("TangoEnergyAmmo",14)
6H24 D 2 A_GunFlash("Flash",1)
6H24 FHJLN 2 
goto BotReady
BotFire1:
6H24 C 0 A_Jump(80,"BotFireX")
goto BotFire+2

BotFireX:
6H24 C 0 A_PlaySoundEx("taunt/D_24","Voice")
6H24 C 0 A_Warp(2,0,0,0,0,0,"BotFireX2")
6H24 C 0 A_TakeInventory("TangoEnergyAmmo",random(28,56))
//6H24 C 0 //A_PlaySoundEx("item/tango","Weapon")
6H24 C 2 A_FireCustomMissile("TangoGirlCatAttack",0,0,8,0)
goto BotFire+3
BotFireX2:
6H24 C 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
6H24 C 2 A_TakeInventory("TangoEnergyAmmo",random(100,200))
goto BotFire+3
}
}

actor TangoEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 200
+INVENTORY.IGNORESKILL
}

actor TangoGirlFlag : Inventory
{
inventory.amount 1
inventory.maxamount 100
}

actor PowerTangoGirlDamageDown : PowerDamage
{
Powerup.Duration 0x7FFFFFFC
damagefactor "CatSlash", 0.4
damagefactor "CatStun", 0.5

damagefactor "OnFire", 0.25
damagefactor "Ztar", 0.4
damagefactor "InvincibleCandy", 0.1
damagefactor "GoldenWasp", 0.25
damagefactor "DeadlyFireArm", 0.4
}

actor TangoGirl_Ready_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("TangoEnergyAmmo",40,2)
TNT1 A 0 A_WeaponReady(8)
goto Ammo
TNT1 A 0 A_WeaponReady
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("TangoEnergyAmmo",1)
stop
}
}

actor TangoGirl_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)

TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "Grounded")
goto Aired
Aired://50 20+5
TNT1 A 0 A_ChangeVelocity(44*cos(pitch),0,((pitch>=15&&pitch<=89)*8.4+8.4)*-sin(pitch),3)
TNT1 A 0 ThrustThingZ(0,(pitch<=15||pitch>=270)*(28-(pitch<=15)*pitch),0,1)
stop
Grounded:
TNT1 A 0 A_ChangeVelocity(44*cos(pitch)+4.4,0,12*-sin(pitch),3)
TNT1 A 0 ThrustThingZ(0,28,0,1)
stop
}
}

actor TangoGirlSuplexSpawn_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 0) & BT_JUMP,2)//Holding Jump
TNT1 A 0 A_SpawnItemEx("TangoGirlGrabberCheck",8,0,-8,momx,momy,momz,0,8)
TNT1 A 0 A_GiveInventory("TangoGirlFlag",1)
stop
}
}

actor TangoGirlSuplexReset_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("SuplexID")
TNT1 A 0 A_TakeInventory("ZangiefAngle")
TNT1 A 0 A_TakeInventory("TangoGirlFlag")
TNT1 A 0 A_TakeInventory("IsPerformingSuplex")
TNT1 A 0 A_TakeInventory("PowerTangoGirlDamageDown")
TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)

TNT1 A 0 A_JumpIfInventory("PlayerPropertyUnsolid", 1, "Remove")
stop
Remove:
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
stop
}
}
actor TangoGirlSuplexReset_P2 : TangoGirlSuplexReset_P
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("TangoEnergyAmmo",20,1)
TNT1 A 0 A_TakeInventory("TangoEnergyAmmo",20)
goto TangoGirlSuplexReset_P::Pickup
}
}


actor MegaManU : CustWepClassBase// replaces Megaman
{
// player.scoreIcon "UMUG_0"
player.displayname "MegaMan"
player.soundclass "megamanu"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 0.98, 0.98
player.jumpz 10
player.damagescreencolor "yellow"
+NOSKIN

player.startitem "UH_BaseFlagPack"

player.startitem "MegamanU_W"
player.startitem "RockNRollAmmo", 28
player.startitem "NoWeaponsBusterOnlyFinalFlag", 1
player.startitem "MegamanBotSkinFix_P"
player.startitem "NoDrawMaestroMugshot"
player.startitem "UHMugshotMegaMan"
States
{
Spawn:
MEGM A 0
MEGM B 1
MEGM A 1
Goto Spawn+2
See:
MEGM BCDE 5
Goto Spawn
Missile:
MEGM F 0 A_JumpIfInventory("VivifyDelay3", 1, "GetWeapon")
MEGM FFFFF 1
MEGM GGGG 1
goto Spawn+2
GetWeapon:
MEGM F 34
goto Spawn+2
ClassPain: MEGM H 0
Goto MegamanPain

ClassDeath:
MEGM H 0
Goto MegamanDeath

MegamanDisintegrate:
MEGM Z 0 A_SpawnItemEx("Corpse_00",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}

actor MegamanBotSkinFix_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("UH_IsBot"),"SkinsOn")
goto SkinsOff
SkinsOff:
TNT1 A 0 A_ChangeFlag("NOSKIN",1)
stop
SkinsOn:
TNT1 A 0 A_ChangeFlag("NOSKIN",0)
stop
}
}


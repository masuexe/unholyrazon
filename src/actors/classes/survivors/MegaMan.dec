actor MegaManU : CustWepClassBase replaces Megaman {
  // Player.ScoreIcon "UMUG_0"
  Player.DisplayName "MegaMan"
  Player.SoundClass "megamanu"
  Player.MaxHealth 1000
  Health 1000
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 0.98, 0.98
  Player.JumpZ 10
  Player.DamageScreenColor "yellow"

  Player.StartItem "UH_BaseFlagPack"

  Player.StartItem "MegamanU_W"
  Player.StartItem "RockNRollAmmo", 28
  Player.StartItem "NoWeaponsBusterOnlyFinalFlag", 1
  // Use v6b SBARINFO: Maestro colors by default, selected skin face in skin mode.
  // Default body uses the v6b Maestro sprites; weapon and movement logic stay here.
  States {
   Spawn:
    PLY1 A 0
    PLY1 B 1
    PLY1 A 1
    goto Spawn+2
   See:
    PLY1 BCDE 5
    goto Spawn
   Missile:
    PLY1 F 0 A_JumpIfInventory("VivifyDelay3", 1, "GetWeapon")
    PLY1 FFFFF 1
    PLY1 GGGG 1
    goto Spawn+2
   GetWeapon:
    PLY1 F 34
    goto Spawn+2
   ClassPain:
    PLY1 H 0
    goto MegamanPain

   ClassDeath:
    PLY1 H 0
    goto MegamanDeath

   MegamanDisintegrate:
    TNT1 A 0 A_SpawnItemEx("Corpse_00", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor MegaManUShiny : MegaManU {
  // Player.ScoreIcon "UMUG_S0"
  // Morph DrawMugShot uses the morph class face; the assist draws the selected skin.
  Player.StartItem "NoDrawFaceMugshot"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.08, 1.08
  Player.JumpZ 11
  Player.MorphWeapon "MegamanUShiny_W"
  +NOMORPHLIMITATIONS
}


actor Corpse_00 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_00_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_00_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_00_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_00_3", 0, 0, 20, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_00_4", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_00_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_00_0 : BaseCorpseFX {States {Spawn: 1H00 O 350
    goto Spawn2}}
actor Corpse_00_1 : BaseCorpseFX {States {Spawn: 1H00 P 350
    goto Spawn2}}
actor Corpse_00_2 : BaseCorpseFX {States {Spawn: 1H00 Q 350
    goto Spawn2}}
actor Corpse_00_3 : BaseCorpseFX {States {Spawn: 1H00 R 350
    goto Spawn2}}
actor Corpse_00_4 : BaseCorpseFX {States {Spawn: 1H00 S 350
    goto Spawn2}}
actor Corpse_00_5 : BaseCorpseFX {States {Spawn: 1H00 T 350
    goto Spawn2}}


actor NewMegaMan : CustWepClassBase// replaces Megaman
{
player.scoreIcon "UMUG_0"
player.displayname "Megaman"
player.soundclass "SND00"
Player.Maxhealth 1000
health 1000
player.forwardmove 1.0, 1.0
player.sidemove 0.98, 0.98
player.jumpz 10
player.damagescreencolor "yellow"
//+NOSKIN

player.startitem "Megaman_W"
player.startitem "RockNRollAmmo", 28
player.startitem "NoWeaponsBusterOnlyFinalFlag", 1
player.startitem "MegamanBotSkinFix_P"
States
{
Spawn:
PLAY A 0
PLAY B 1 
PLAY A 1
Goto Spawn+2
See:
PLAY BCDE 5
Goto Spawn
Missile:
PLAY FFFFF 1
PLAY GGGG 1
goto Spawn+2
ClassPain: PLAY H 0
Goto PainContinue
/*
PainContinue:
PLAY H 0 A_JumpIfInventory("MegaStunU",1,2)
PLAY H 0 SetPlayerProperty(0,0,4)
PLAY H 1 A_SpawnItem("PainFX",0,3)
PLAY H 1 A_Recoil(1)
PLAY HHHHHHHHHH 2 A_SpawnItem("PainFX",0,3)
PLAY H 0 SetPlayerProperty(0,0,1)
PLAY H 0 A_Jump(256, "Spawn")
Goto Spawn+2
*/
ClassDeath:
PLAY HH 10
Goto MegaDeathEnd

ClassCorpse:
PLAY Z 0 A_SpawnItemEx("Corpse_00",0,0,0,momx,momy,momz,0,9)
Goto MegaDeathEndGib
}
}

actor MegamanBotSkinFix_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("UH_IsBot"),"SkinsOn")
goto SkinsOff
SkinsOff:
TNT1 A 0 A_ChangeFlag("NOSKIN",1)
stop
SkinsOn:
TNT1 A 0 A_ChangeFlag("NOSKIN",0)
stop
}
}


actor Test_SummonMegamen : BasicHelper
{
ReactionTime 50
States
{
Spawn:
TNT1 A 0 A_SetArg(2,Args[2]+10)
TNT1 A 0 A_SpawnItemEx("Megaman_TestHelper",250-Args[1],260-Args[2])
TNT1 A 0 A_JumpIf(Args[2]<500,"Spawn")
TNT1 A 0 A_SetArg(1,Args[1]+10)
TNT1 A 0 A_SetArg(2,0)
TNT1 A 1 A_CountDown
loop
}
}
// */

actor Corpse_00:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_00_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_00_1",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_00_2",0,0,28,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_00_3",0,0,20,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_00_4",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_00_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}

actor MegaManUShiny : MegaManU
{
// player.scoreIcon "UMUG_S0"
Player.Maxhealth 3000
health 3000
player.forwardmove 1.1, 1.1
player.sidemove 1.08, 1.08
player.jumpz 11
player.morphweapon "MegamanUShiny_W"
+NOSKIN
+NOMORPHLIMITATIONS
}

actor Corpse_00_0:BaseCorpseFX{States{Spawn:1H00 O 350
goto Spawn2}}
actor Corpse_00_1:BaseCorpseFX{States{Spawn:1H00 P 350
goto Spawn2}}
actor Corpse_00_2:BaseCorpseFX{States{Spawn:1H00 Q 350
goto Spawn2}}
actor Corpse_00_3:BaseCorpseFX{States{Spawn:1H00 R 350
goto Spawn2}}
actor Corpse_00_4:BaseCorpseFX{States{Spawn:1H00 S 350
goto Spawn2}}
actor Corpse_00_5:BaseCorpseFX{States{Spawn:1H00 T 350
goto Spawn2}}


actor CloseCombatUnit_W_NormalBar : NormalBar {args 95, 3}

actor CloseCombatUnit_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 300
Inventory.Pickupmessage "$PU_11"
Obituary "$OB_11W"
Tag "$TAG_CloseCombatUnit_W"
weapon.ammotype "MeleeEnergyAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H11 [ 6
loop

Deselect:
6H11 A 0 A_GiveInventory("StopShield")
goto DeselectSwap
Select:
6H11 A 0 A_TakeInventory("StopShield")
goto SelectSwap

Ready:
6H11 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", CLOSECOMBATUNIT_DYE)
6H11 A 1 A_TakeInventory("StopShield")
6H11 A 0 A_GunFlash("Flash",1)
goto Ready2
Ready2:
6H11 A 0 A_JumpIfInventory("MeleeEnergyAmmo",300,"Ready3")
6H11 A 2 A_WeaponReady(WRF_NOSECONDARY)
6H11 A 0 A_GiveInventory("MeleeEnergyAmmo",6)
loop
Ready3:
6H11 A 2 A_WeaponReady
6H11 A 0 A_GiveInventory("MeleeEnergyAmmo",6)
loop

Flash:
6H11 ZY 2
6H11 X 0 A_GiveInventory("CCU_ShieldHitbox_P")
Flash.Idle:
6H11 X 0 A_SpawnItemEx("CCU_ShieldFX",23,-17,8,momx,momy,momz,0,9)
6H11 X 1 A_JumpIfInventory("StopShield",1,1)
loop
6H11 YZ 2
stop


Fire:
6H11 A 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H11 A 0 A_GiveInventory("StopShield")
6H11 BC 1
FireL:
6H11 C 0 A_PlaySound("weapon/slashclaw",1)
6H11 D 1 A_FireCustomMissile("CCU_MeleeSlash",50,0,-16,0,0,-10)
6H11 D 1 A_FireCustomMissile("CCU_MeleeSlash",25,0,-8,0,0,-5)
6H11 E 1 A_FireCustomMissile("CCU_MeleeSlash",0,0,0,0,0,0)
6H11 E 1 A_FireCustomMissile("CCU_MeleeSlash",-25,0,8,0,0,10)
6H11 F 2 A_FireCustomMissile("CCU_MeleeSlash",-50,0,16,0,0,20)
TNT1 AA 8 A_GiveInventory("MeleeEnergyAmmo",4)
TNT1 A 0 A_Refire("FireL")
FireEnd:
6H11 G 0 A_TakeInventory("StopShield")
6H11 G 2 A_GunFlash("Flash",1)
6H11 H 2
Goto Ready2
Altfire:
6H11 A 0 A_JumpIfInventory("MeleeEnergyAmmo",300,"Altfire1")
goto Ready2
Altfire1:
6H11 H 0 A_GiveInventory("VivifyDelay1")
6H11 H 0 A_Refire("Altfire2")
goto Altfire2
Altfire2:
6H11 H 2 A_WeaponReady(WRF_NOSECONDARY)
6H11 H 0 A_GiveInventory("CCU_Alt_P")
6H11 H 0 A_JumpIfInventory("MeleeEnergyAmmo",1,"Altfire2")
goto Ready2

BotFire:
6H11 A 0 A_JumpIfCloser(356,2)
6H11 A 0 A_JumpIfInventory("MeleeEnergyAmmo",150,"BotFire2")
goto BotFire2
BotFire1:
6H11 C 0 A_PlaySound("weapon/slashclaw",1)
6H11 D 1 A_FireCustomMissile("CCU_MeleeSlash",50,0,-16,0,0,-10)
6H11 D 1 A_FireCustomMissile("CCU_MeleeSlash",25,0,-8,0,0,-5)
6H11 E 1 A_FireCustomMissile("CCU_MeleeSlash",0,0,0,0,0,0)
6H11 E 1 A_FireCustomMissile("CCU_MeleeSlash",-25,0,8,0,0,10)
6H11 F 2 A_FireCustomMissile("CCU_MeleeSlash",-50,0,16,0,0,20)
TNT1 AA 8 A_GiveInventory("MeleeEnergyAmmo",random(10,25))
goto FireEnd
BotFire2:
6H11 H 2 A_Jump(5,1)
goto Altfire2+1
6H11 H 2 A_PlaySoundEx("classes/taunt/closecombatunit","Voice")
goto Altfire2+1
}
}

actor MeleeEnergyAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 300
+INVENTORY.IGNORESKILL
}

actor CCUPowerSpeed : PowerSpeed
{
powerup.duration 7
Speed 1.75
}

actor CCU_Alt_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("CCU_RammingDamage",0,0,32,momx,momy,momz,0,8)
Pickup2:
TNT1 A 0 A_TakeInventory("MeleeEnergyAmmo",8,1)
TNT1 A 0 A_TakeInventory("MeleeEnergyAmmo",7)
TNT1 A 0 A_GiveInventory("CCUPowerSpeed")
TNT1 A 0 A_Recoil(-2.75-(CallACS("core_CheckFooting"))*3.75)//-6.5
stop
}
}

actor CCU_ShieldHitbox_P : CustomInventory
{
states
{
Pickup:
TNT1 A 0 A_SpawnItemEx("CCU_ShieldHitbox1",28,-16,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("CCU_ShieldHitbox2",28,-8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("CCU_ShieldHitbox3",28,0,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("CCU_ShieldHitbox4",28,8,8,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("CCU_ShieldHitbox5",28,16,8,0,0,0,0,1)
stop
}
}

actor CCU_ShieldHitbox1 : BasicShieldHitbox
{
Meleerange 28
Accuracy -16
Mass 8
States
{
Pain:
TNT1 A 0 A_PlaySound("item/protoreflect")
TNT1 A 0 A_SpawnItemEx("CCU_ShieldDeathFX")
goto Spawn
}
}
actor CCU_ShieldHitbox2 : CCU_ShieldHitbox1
{
Accuracy -8
}
actor CCU_ShieldHitbox3 : CCU_ShieldHitbox1
{
Accuracy 0
}
actor CCU_ShieldHitbox4 : CCU_ShieldHitbox1
{
Accuracy 8
}
actor CCU_ShieldHitbox5 : CCU_ShieldHitbox1
{
Accuracy 16
}

actor CCU_ShieldDeathFX : ProtoShieldDeathFX
{
states
{
SpawnFrame:
6P11 B 0 A_SetScale(scaleX+0.1,2.5)
6P11 B 1 A_FadeOut(0.05)
loop
}
}

actor CCU_ShieldFX : ProtoShieldFX
{
States
{
Spawn:
6P11 A 0
6P11 A 1
stop
}
}

actor CCU_MeleeSlash : BasicProjectile
{
Translation "192:192=93:93","198:198=3:3"
damagetype "Combat"
Obituary "$OB_11M"
+DONTBLAST
+THRUACTORS
+DONTSPLASH
+FORCEXYBILLBOARD
+BRIGHT
damage (0)
Radius 5
Height 5
speed 35
scale 2.5
Args 111,88,8
States
{
Spawn:
TMFX A 0
TMFX ABCD 2 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}

actor CCU_RammingDamage : BasicExplosion_Args_Trio
{
damagetype "CombatStun"
Obituary "$OB_11A"
Args 78,102,16
}

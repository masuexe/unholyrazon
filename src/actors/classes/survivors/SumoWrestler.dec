actor SumoWrestler : CustWepClassBase {
  Player.ScoreIcon "UMUG_36"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "SumoWrestler"
  Player.SoundClass "SumoWrestler"
  Player.MaxHealth 1600
  Health 1600
  Player.ForwardMove 0.7, 0.7
  Player.SideMove 0.7, 0.7
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "SumoWrestler_W"
  States {
   Spawn:
    TOAD A 0
    TOAD B 0 A_GiveInventory("SumoW_StompWaveCheck_P")
   Spawn1:
    TOAD B 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
   SpawnFrame:
    TOAD A 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    loop
   See:
    TOAD B 0 A_JumpIfInventory("PlayerPropertyRage", 1, "SeeRage")
    TOAD BBBB 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    TOAD CCCCCCCDDDDDDDEEEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    TOAD B 0 A_GiveInventory("SumoW_StompWaveCheck_P")
    TOAD BBB 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn1
   SeeRage:
    TOAD BBB 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    TOAD CCCCCDDDDDEEEEE 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    TOAD B 0 A_GiveInventory("SumoW_StompWaveCheck_P")
    TOAD BB 1 A_JumpIf(!CallACS("core_checkfooting"), "Jumping")
    goto Spawn1
   Jumping:
    TOAD C 1 A_JumpIf(CallACS("core_checkfooting"), "Spawn")
    loop
   Missile:
    TOAD E 0 A_JumpIfInventory("VivifyFlag1", 1, "MissileLeap")
    TOAD E 0 A_JumpIfInventory("VivifyDelay3", 1, "MissileStomp")
    TOAD E 0 A_JumpIfInventory("VivifyFlag2", 1, "MissileStomp1")
    TOAD FG 5
    goto SpawnFrame
   MissileStomp:
    TOAD F 4
    TOAD GGGG 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileStomp2")
   MissileStomp1:
    TOAD Q 0 A_JumpIfInventory("VivifyCycle1", 4, 4)
    TOAD Q 0 A_JumpIfInventory("VivifyCycle1", 2, 2)
    TOAD Q 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileStomp2")
    wait
    TOAD R 1 A_JumpIfInventory("VivifyDelay4", 1, "MissileStomp2")
    wait
    TOAD Q 0 A_TakeInventory("VivifyCycle1")
    goto MissileStomp1+2
   MissileStomp2:
    TOAD BBA 4
    goto SpawnFrame
   MissileLeap:
    TOAD E 3
   MissileLeap1:
    TOAD FFFGGG 1 A_JumpIfInventory("VivifyDelay5", 1, "MissileLeap2")
    loop
   MissileLeap2:
    TOAD Q 3
    TOAD BA 4
    goto SpawnFrame

   ClassPainLeap:
    TOAD H 0 A_SpawnItemEx("DelayPainFX5")
    TOAD HHH 1 A_JumpIfInventory("VivifyDelay5", 1, "MissileLeap2")
    goto MissileLeap1

   ClassPain:
    TOAD H 0 A_JumpIfInventory("VivifyFlag1", 1, "ClassPainLeap")
    goto MegamanPain

   ClassDeath:
    TOAD H 0
    goto MegamanDeath
   MegamanDeath0:
    TOAD H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TOAD H 0 A_PlaySound("*death", 2)
    TOAD H 0 A_ChangeVelocity(-20, 0, 10, 3)
    TOAD H 0 A_SpawnItemEx("SumoWrestlerDeathCorpse", 0, 0, 8, -20, 0, 10, 0, 1)
    TOAD Z 2 A_PlaySound("classes/KOSpecialSFX", 2)
    goto MegamanErase
   MegamanDisintegrate:
    TOAD Z 0 A_SpawnItemEx("Corpse_36", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor SumoWrestlerShiny : SumoWrestler {
  Player.ScoreIcon "UMUG_S36"
  Player.MaxHealth 3600
  Health 3600
  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.JumpZ 11
  Player.MorphWeapon "SumoWrestlerShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    TOAD H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    TOAD H 0 A_PlaySound("*death", 2)
    TOAD H 0 A_ChangeVelocity(-20, 0, 10, 3)
    TOAD H 0 A_SpawnItemEx("S_SumoWrestlerDeathCorpse", 0, 0, 8, -20, 0, 10, 0, 1)
    TOAD Z 2 A_PlaySound("classes/KOSpecialSFX", 2)
    goto MegamanErase
  }
}


actor SumoWrestlerDeathCorpse {
  Projectile
  DamageType "SumoWave"
  Obituary "$OB_36D1"
  -NOGRAVITY
  +RIPPER
  +SKYEXPLODE
  +DONTSPLASH
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceCount 10
  BounceFactor 0.1
  WallBounceFactor 0.90
  Damage (75)
  Radius 16
  Height 56
  Speed 32
  Scale 2.5
  Args 23
  States {
   Spawn:
    TOAD H 0
    TOAD H 0 ThrustThingZ(0, 8, 0, 1)
    TOAD H 1
    wait
   Death:
    TOAD H 0 A_SpawnItemEx("SumoW_StompWaveW_Death_H", 0, 0, 0, 0, 0, 0, 0, 1 + 32 + SXF_TRANSFERSPECIAL)  // 32768
    TOAD HHHHHHHHHH 1 A_FadeOut
    TNT1 A 1
    stop
  }
}
actor S_SumoWrestlerDeathCorpse : SumoWrestlerDeathCorpse {
  Damage (113)
  Args 23, 16
}

actor SumoW_StompWaveW_Death : SumoW_StompWave {
  Obituary "$OB_36D2"
  Damage (31)
}

actor SumoW_StompWaveW_Death_H : SumoW_StompWave_H {
  DeathSound ""
  Args 23
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 Radius_Quake(1, 15, 0, 8, 0)
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW_Death", 0, 0, 0, 30, 0, 0, 0 + args[0] * 15, 1 + 32768)
    TNT1 A 0 A_CountDownArg(0)
    loop
  }
}

actor Corpse_36 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_36_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_1", 0, 0, 30, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_2", 0, 0, 30, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_3", 0, 0, 26, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_4", 0, 0, 26, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_36_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}

actor Corpse_36_0 : BaseCorpseFX {States {Spawn: 1H36 O 350
    goto Spawn2}}
actor Corpse_36_1 : BaseCorpseFX {States {Spawn: 1H36 P 350
    goto Spawn2}}
actor Corpse_36_2 : BaseCorpseFX {States {Spawn: 1H36 Q 350
    goto Spawn2}}
actor Corpse_36_3 : BaseCorpseFX {States {Spawn: 1H36 R 350
    goto Spawn2}}
actor Corpse_36_4 : BaseCorpseFX {States {Spawn: 1H36 S 350
    goto Spawn2}}
actor Corpse_36_5 : BaseCorpseFX {States {Spawn: 1H36 T 350
    goto Spawn2}}
actor Corpse_36_6 : BaseCorpseFX {States {Spawn: 1H36 U 350
    goto Spawn2}}

actor SumoWrestler : CustWepClassBase
{
player.scoreIcon "UMUG_36"
player.displayname "SumoWrestler"
player.soundclass "SumoWrestler"
Player.Maxhealth 1600
health 1600
player.forwardmove 0.7, 0.7
player.sidemove 0.7, 0.7
player.jumpz 10
Player.StartItem "UH_BaseFlagPack"
player.startitem "SumoWrestler_W"
States
{
Spawn:
TOAD A 0
TOAD B 1
TOAD A 1
Goto Spawn+2
See:
TOAD B 4 A_JumpIfInventory("PlayerPropertyRage",1,"SeeRage")
TOAD CDE 7
TOAD B 3 A_GiveInventory("SumoW_StompWaveCheck_P",1)
Goto Spawn+1
SeeRage:
TOAD B 3
TOAD CDE 5
TOAD B 2 A_GiveInventory("SumoW_StompWaveCheck_P",1)
Goto Spawn+1
Missile:
TOAD E 0 A_JumpIfInventory("VivifyFlag1",1,"MissileLeap")
TOAD E 0 A_JumpIfInventory("VivifyDelay3",1,"MissileStomp")
TOAD E 0 A_JumpIfInventory("VivifyFlag2",1,"MissileStomp1")
TOAD FG 5
goto Spawn+2
MissileStomp:
TOAD F 4
TOAD GGGG 1 A_JumpIfInventory("VivifyDelay4",1,"MissileStomp2")
MissileStomp1:
TOAD Q 0 A_JumpIfInventory("VivifyCycle1",4,4)
TOAD Q 0 A_JumpIfInventory("VivifyCycle1",2,2)
TOAD Q 1 A_JumpIfInventory("VivifyDelay4",1,"MissileStomp2")
wait
TOAD R 1 A_JumpIfInventory("VivifyDelay4",1,"MissileStomp2")
wait
TOAD Q 0 A_TakeInventory("VivifyCycle1")
goto MissileStomp1+2
MissileStomp2:
TOAD BBA 4
Goto Spawn+2
MissileLeap:
TOAD E 3
MissileLeap1:
TOAD FFFGGG 1 A_JumpIfInventory("VivifyDelay5",1,"MissileLeap2")
loop
MissileLeap2:
TOAD Q 3
TOAD BA 4
goto Spawn+2

ClassPainLeap:
TOAD H 0 A_SpawnItemEx("DelayPainFX5")
TOAD HHH 1 A_JumpIfInventory("VivifyDelay5",1,"MissileLeap2")
goto MissileLeap1

ClassPain:
TOAD H 0 A_JumpIfInventory("VivifyFlag1",1,"ClassPainLeap")
Goto MegamanPain

ClassDeath:
TOAD H 0
goto MegamanDeath
MegamanDeath0:
TOAD H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
TOAD H 0 A_PlaySound("*death",2)
TOAD H 0 A_ChangeVelocity(-20,0,10,3)
TOAD H 0 A_SpawnItemEx("SumoWrestlerDeathCorpse",0,0,8,-20,0,10,0,1)
TOAD Z 2 A_PlaySound("classes/KOSpecialSFX",2)
Goto MegamanErase
MegamanDisintegrate:
TOAD Z 0 A_SpawnItemEx("Corpse_36",0,0,0,momx,momy,momz,0,9)
goto MegamanCorpseEnd
}
}
actor SumoWrestlerS : SumoWrestler
{
player.scoreIcon "UMUG_S36"
Player.Maxhealth 3600
health 3600
player.forwardmove 0.8, 0.8
player.sidemove 0.8, 0.8
player.jumpz 11
player.morphweapon "SumoWrestlerS_W"
+NOSKIN
+NOMORPHLIMITATIONS
States
{
MegamanDeath0:
TOAD H 1 A_JumpIfInventory("CriticalDeath",1,"MegamanGib")
TOAD H 0 A_PlaySound("*death",2)
TOAD H 0 A_ChangeVelocity(-20,0,10,3)
TOAD H 0 A_SpawnItemEx("S_SumoWrestlerDeathCorpse",0,0,8,-20,0,10,0,1)
TOAD Z 2 A_PlaySound("classes/KOSpecialSFX",2)
Goto MegamanErase
}
}


actor SumoWrestlerDeathCorpse
{
PROJECTILE
damagetype "SumoWave"
Obituary "$OB_36D1"
-NOGRAVITY
+RIPPER
+SKYEXPLODE
+DONTSPLASH
+DONTREFLECT
+BOUNCEONWALLS
+BOUNCEONCEILINGS
BounceCount 10
BounceFactor 0.1
WallBounceFactor 0.90
Damage (75)
Radius 16
Height 56
speed 32
scale 2.5
Args 23
States
{
Spawn:
TOAD H 0
TOAD H 0 ThrustThingZ(0,8,0,1)
TOAD H 1
wait
Death:
TOAD H 0 A_SpawnItemEx("SumoW_StompWaveW_Death_H",0,0,0,0,0,0,0,1+32+SXF_TRANSFERSPECIAL)//32768
TOAD HHHHHHHHHH 1 A_FadeOut
TNT1 A 1
stop
}
}
actor S_SumoWrestlerDeathCorpse : SumoWrestlerDeathCorpse
{
Damage (113)
Args 23,16
}

actor SumoW_StompWaveW_Death : SumoW_StompWave
{
Obituary "$OB_36D2"
Damage (31)
}

actor SumoW_StompWaveW_Death_H : SumoW_StompWave_H
{
DeathSound ""
Args 23
States
{
Spawn:
TNT1 A 0
TNT1 A 0 Radius_Quake(1,15,0,8,0)
SpawnL:
TNT1 A 0 A_SpawnItemEx("SumoW_StompWaveW_Death",0,0,0,30,0,0,0+Args[0]*15,1+32768)
TNT1 A 0 A_CountDownArg(0)
loop
}
}

actor Corpse_36:BasicHelper{States{Spawn:TNT1 A 0
TNT1 A 0 A_SpawnItemEx("Corpse_36_0",0,0,36,momx+random(-2,2),momy+frandom(-1,1),momz+frandom(2,6),0,169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_1",0,0,30,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_2",0,0,30,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_3",0,0,26,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_4",0,0,26,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_5",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
TNT1 A 0 A_SpawnItemEx("Corpse_36_6",0,0,6,momx+frandom(-3,3),momy+frandom(-3,3),momz+frandom(1,4),random(-5,5),169)
stop
}
}


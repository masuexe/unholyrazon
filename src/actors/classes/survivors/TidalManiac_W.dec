actor TidalManiacMine : UH_ShootableActor {
  Translation "192:192=204:204", "198:198=244:244", "199:199=207:207"
  PROJECTILE
  damagetype "TidalMine"
  Obituary "$OB_37M2"

  +SKYEXPLODE
  +DONTSPLASH
  +DONTREFLECT
  +HEXENBOUNCE
  +CANBOUNCEWATER
  // +BOUNCEONACTORS
  +NORADIUSDMG
  +THRUACTORS
  +FORCEXYBILLBOARD

  // +SHOOTABLE
  // -NOBLOCKMAP
  +NOTAUTOAIMED
  +NOBLOOD
  // +NOTARGETSWITCH
  +CANTSEEK
  // +NOPAIN
  +QUICKTORETALIATE
  +DONTDRAIN
  +CANTSEEK
  +THRUSPECIES
  Species "DumbTidalMine"
  // FloatBobPhase 20


  painchance 0
  painchance "Torrent", 256
  painchance "WaveBurnerUW", 256
  painchance "BeermanConcrete", 256
  painchance "TidalLaser", 256

  // Kill the mine
  damagefactor "SpringEye", 1000.0

  // (Deal 2 damage about)
  damagefactor "WaveBurnerUW", 0.10
  damagefactor "BeermanConcrete", 0.10  // random damage
  damagefactor "TidalLaser", 0.08

  damagefactor "TidalMine", 0.0
  mass 999999
  Health 200
  Reactiontime 1
  damage (0)
  Radius 18
  Height 28
  speed 40
  scale 2.0
  Args 20, 40, 52  // Duration, PushSpeed1, PushSpeed2
  States {
   Spawn:
    DIVA M 0
    DIVA M 0 A_GiveInventory("Once", 1)
    DIVA M 4 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_TARGET)
    DIVA M 0 A_ChangeFlag("NOPAIN", 0)
    DIVA M 0 A_ChangeFlag("BOUNCEONACTORS", 0)
    DIVA M 0 A_ChangeFlag("HEXENBOUNCE", 0)
    DIVA M 0 A_ChangeFlag("THRUACTORS", 0)
    DIVA M 0 A_ChangeFlag("SHOOTABLE", 1)
    DIVA M 0 A_ChangeFlag("NOBLOCKMAP", 0)
    DIVA MMM 1 A_Stop
    // DIVA M 0 A_ChangeFlag("FLOATBOB",1)
    goto Floating
   Floating:
    DIVA MMMMM 5
    DIVA N 1 A_CountDownArg(0)
    loop
   Pain:
    DIVA N 0 A_PlaySoundEx("S3_K/Beep", "Voice")
    // DIVA NN 1 A_RearrangePointers(AAPTR_TRACER)
    goto Floating

   Pain.WaveBurnerUW:
   Pain.BeermanConcrete:
   Pain.Torrent:
    // DIVA N 0 A_ChangeFlag("NOPAIN",1)
    DIVA N 0 A_PlaySoundEx("S3_K/Beep", "Voice")
    // DIVA N 0 A_ChangeFlag("FLOATBOB",0)
    DIVA N 0 A_GiveInventory("TidalShieldFlag", 1)
    DIVA N 0/*1*/ ACS_NamedExecuteWithResult("uh_CopyPointerAnglePitch", 2, 1)
    DIVA N 0 A_RearrangePointers(0, 0, 2)
    DIVA N 0 A_ChangeVelocity(Cos(pitch)*(Args[1]+Args[2]), 0, -sin(pitch)*(Args[1]+Args[2]), 3)
    // DIVA N 0 A_ChangeFlag("NOPAIN",0)
    goto Floating
   Pain.TidalLaser:
    // DIVA N 0 A_ChangeFlag("NOPAIN",1)
    DIVA N 0 A_SetArg(2, 12)
    goto Pain.Torrent

   Death:
    DIVA M 0 A_ChangeFlag("DONTBLAST", 1)
    DIVA M 0 A_ChangeFlag("SHOOTABLE", 0)
    // DIVA N 0 A_ChangeFlag("FLOATBOB",0)
    DIVA N 0 A_SetGravity(0.0)
    DIVA N 0 A_JumpIfInventory("Once", 1, "DeathCheck")
    goto DeathFlung
   DeathCheck:
    DIVA N 0 A_RearrangePointers(AAPTR_TRACER)
    DIVA N 1 A_Stop
    DIVA N 0 A_PlaySoundEx("TidalM/MineBoom", "Weapon")
    DIVA N 0 A_JumpIfInventory("TidalShieldFlag", 1, "DeathFlung")
    TNT1 A 10 A_SpawnItemEx("TidalManiacMineExplode", 0, 0, 8, 0, 0, 0, 0, 1)
    stop
   DeathFlung:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("TidalM/MineBoom", "Weapon")
    TNT1 A 10 A_SpawnItemEx("TidalManiacMineExplodeFlung", 0, 0, 8, 0, 0, 0, 0, 1)
    stop
  }
}

actor TidalMineProtect : PowerProtection {
  Powerup.Duration 3
  DamageFactor "TidalMine", 0.75
}

actor TidalManiacMineExplode : BasicExplosion {
  damagetype "TidalMine"
  Obituary "$OB_37M2"
  Scale 2.0
  Args 150, 128, 18
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(Args[0], Args[1], 0, 0, Args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX", 0, 0, 0, 0, 0, 0, 0, 1+16384)
    stop
  }
}

actor TidalManiacMineExplodeFlung : TidalManiacMineExplode {
  Scale 2.5
  Args 200, 148, 36
}



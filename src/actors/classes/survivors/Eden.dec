actor Eden : CustWepClassBase {
  Player.ScoreIcon "UMUG_59"
  Player.DisplayName "Eden"
  Player.SoundClass "Eden"
  Player.MaxHealth 650
  Health 650
  Player.ForwardMove 1.00, 1.00
  Player.SideMove 0.98, 0.98
  Player.JumpZ 10
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Eden_W"
  Player.StartItem "EdenToyAmmo", 300
  States {
   Spawn:
    1H59 A 0
    1H59 B 1
   SpawnFrame:
    1H59 A 0 ACS_NamedExecuteAlways("rz_EdenAntiGravTick")
    1H59 A 1
    wait
   See:
    1H59 BCDE 5
    goto Spawn
   Melee:
    1H59 FF 2
    goto SpawnFrame
   Missile:
    1H59 F 5
    1H59 G 4
    goto SpawnFrame
   ClassPain:
    1H59 H 0 A_GiveInventory("RogueShieldWasHit")
    goto MegamanPain

   ClassDeath:
    1H59 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H59 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H59 HIJK 4
    1H59 K 10 A_SpawnItemEx("EdenLostFX", 0, 0, 4, 0, 0, 15, 0, 0)
    goto MegamanFade
   MegamanDisintegrate:
    1H59 Z 0 A_SpawnItemEx("Corpse_Eden", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor EdenShiny : Eden {
  // Player.ScoreIcon "UMUG_S0"
  Player.MaxHealth 3000
  Health 3000
  Player.ForwardMove 1.1, 1.1
  Player.SideMove 1.08, 1.08
  Player.JumpZ 11
  // Shiny does not use a separate weapon; morph keeps the base Eden_W stack.
  Player.MorphWeapon "Eden_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
}

actor EdenShinyAngel_F : Once {}
actor EdenShinyDevil_F : Once {}

actor EdenLostFX : BasicGraphicEffect {
  Alpha 0.8
  States {
   Spawn:
    6R59 ABCDE 2 A_FadeOut(0.08)
    loop
  }
}

actor Corpse_Eden : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_Eden_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    stop
  }
}

actor Corpse_Eden_0 : BaseCorpseFX {
  States {
   Spawn:
    1H59 O 0
    1H59 OPQRSTU 1 A_GiveInventory("CutterFlag", 1)
    1H59 U 0 A_JumpIfInventory("CutterFlag", 350, "Spawn2")
    loop
   Spawn2:
    1H59 OPQRSTU 1 A_FadeOut(0, 033)
    loop
  }
}

actor Eden : CustWepClassBase {
  player.scoreIcon "UMUG_59"
  player.displayname "Eden"
  player.soundclass "SND64"
  Player.Maxhealth 650
  health 650
  player.forwardmove 1.00, 1.00
  player.sidemove 0.98, 0.98
  player.jumpz 10
  player.startitem "Eden_W"
  //player.startitem "EdenToyAmmo", 50
  States {
   Spawn:
    1A59 A 0
    1A59 B 1
    1A59 A 1
    Goto Spawn+3
   See:
    1A59 BCDC 5
    Goto Spawn+1
   Melee:
    1A59 EE 2
    goto Spawn+3
   Missile:
    1A59 EEEEE 1
    goto Spawn+3
   ClassPain:
    1A59 H 0 A_GiveInventory("RogueShieldWasHit")
   ClassPainCheck:
    1A59 H 0 A_JumpIfInventory("C206Flag", 1, "HeadlessClassPain")
    1A59 H 0 A_JumpIfInventory("C227Flag", 1, "Pain227")
    1A59 H 0 A_JumpIfInventory("C371Flag", 1, "Pain371")
    Goto MegamanPain

   Pain227:
    1A59 H 0 A_SpawnItemEx("EdenPiggyBankCoinSpawner")
    1A59 H 0
    goto ClassPainCheck+2
   Pain371:
    1A59 H 0 A_JumpIfInventory("PowerC371Cooldown", 1, 3)
    1A59 H 0 A_GiveInventory("AnarchistCookbookIsaacItem_P")
    1A59 H 0 A_GiveInventory("PowerC371Cooldown")
    1A59 H 0
    goto MegamanPain

   ClassDeath:
    1A59 H 0
    goto MegamanDeath
   MegamanDeath0:
    1A59 H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1A59 H 16
    1A59 H 10 A_SpawnItemEx("EdenLostFX", 0, 0, 4, 0, 0, 15, 0, 0)
    goto MegamanFade
   ClassCorpse:
    1A59 Z 0 A_SpawnItemEx("Corpse_64", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegaDeathEndGib
  }
}

actor EdenLostFX : BasicGraphicEffect {
  Alpha 0.8
  States {
   Spawn:
    6R59 ABCDE 2 A_FadeOut(0.08)
    loop
  }
}

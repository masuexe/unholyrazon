actor QwantRandomBallItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Jump(4, "Master")
    TNT1 A 0 A_Jump(8, "Strange")
    TNT1 A 0 A_Jump(20, "Net", "Luxury", "Heal", "Quick", "Beast")
    TNT1 A 0 A_Jump(42, "Ultra", "Repeat", "Fast", "Timer", "Cherish")
    TNT1 A 0 A_Jump(78, "Lure", "Moon", "Heavy", "Nest", "Dusk", "Dream")
    TNT1 A 0 A_Jump(118, "Great", "Level", "Premier", "Dive", "Feather", "HeavyArceus")
    TNT1 A 0 A_Jump(188, "Safari", "Friend", "Love", "Sport", "Park")
    TNT1 A 0 A_Jump(250, "Poke")
    TNT1 A 0 A_Jump(256, "Dark")
   Poke:
    TNT1 A 0 A_Jump(26, "PokeArceus")
    TNT1 A 0 A_FireCustomMissile("QBall_Poke", 0, 0)
    stop
   Great:
    TNT1 A 0 A_Jump(26, "GreatArceus")
    TNT1 A 0 A_FireCustomMissile("QBall_Great", 0, 0)
    stop
   Ultra:
    TNT1 A 0 A_Jump(26, "UltraArceus")
    TNT1 A 0 A_FireCustomMissile("QBall_Ultra", 0, 0)
    stop
   Master:
    TNT1 A 0 A_Jump(26, "Origin")
    TNT1 A 0 A_FireCustomMissile("QBall_Master", 0, 0)
    stop
   Safari:
    TNT1 A 0 A_FireCustomMissile("QBall_Safari", 0, 0)
    stop
   Level:
    TNT1 A 0 A_JumpIfHealthLower(2, 8)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25, 6)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50, 4)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75, 2)
    TNT1 A 0 A_FireCustomMissile("QBall_Level4", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Level3", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Level2", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Level1", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Level", 0, 0)
    stop
   Lure:
    TNT1 A 0 A_FireCustomMissile("QBall_Lure", 0, 0)
    stop
   Moon:
    TNT1 A 0 A_FireCustomMissile("QBall_Moon", 0, 0)
    stop
   Friend:
    TNT1 A 0 A_FireCustomMissile("QBall_Friend", 0, 0)
    stop
   Love:
    TNT1 A 0 A_FireCustomMissile("QBall_Love", 0, 0)
    stop
   Heavy:
    TNT1 A 0 A_FireCustomMissile("QBall_Heavy", 0, 0)
    stop
   Fast:
    TNT1 A 0 A_FireCustomMissile("QBall_Fast", 0, 0)
    stop
   Sport:
    TNT1 A 0 A_FireCustomMissile("QBall_Sport", 0, 0)
    stop
   Premier:
    TNT1 A 0 A_FireCustomMissile("QBall_Premier", 0, 0)
    stop
   Repeat:
    TNT1 A 0 A_JumpIfInventory("RepeatBallFlag", 15, "Repeat6")
    TNT1 A 0 A_GiveInventory("RepeatBallFlag", 1)
    TNT1 A 0 A_JumpIfInventory("RepeatBallFlag", 12, "Repeat5")
    TNT1 A 0 A_JumpIfInventory("RepeatBallFlag", 9, "Repeat4")
    TNT1 A 0 A_JumpIfInventory("RepeatBallFlag", 6, "Repeat3")
    TNT1 A 0 A_JumpIfInventory("RepeatBallFlag", 3, "Repeat2")
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat", 0, 0)
    stop
   Repeat2:
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat2", 0, 0)
    stop
   Repeat3:
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat3", 0, 0)
    stop
   Repeat4:
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat4", 0, 0)
    stop
   Repeat5:
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat5", 0, 0)
    stop
   Repeat6:
    TNT1 A 0 A_FireCustomMissile("QBall_Repeat6", 0, 0)
    stop
   Timer:
    TNT1 A 0 A_FireCustomMissile("QBall_Timer", 0, 0)
    stop
   Nest:
    TNT1 A 0 A_JumpIfHealthLower(2, 8)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.25, 6)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.50, 4)
    TNT1 A 0 A_JumpIfHealthLower(CallACS("uh_Health", UHEALTH_GET_MAX) * 0.75, 2)
    TNT1 A 0 A_FireCustomMissile("QBall_Nest", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Nest1", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Nest2", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Nest3", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_Nest4", 0, 0)
    stop
   Net:
    TNT1 A 0 A_FireCustomMissile("QBall_Net", 0, 0)
    stop
   Dive:
    TNT1 A 0 A_JumpIfInventory("HasFeetInWater", 1, 2)
    TNT1 A 0 A_FireCustomMissile("QBall_Dive", 0, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("QBall_DiveX", 0, 0)
    stop
   Luxury:
    TNT1 A 0 A_FireCustomMissile("QBall_Luxury", 0, 0)
    stop
   Heal:
    TNT1 A 0 A_FireCustomMissile("QBall_Heal", 0, 0)
    stop
   Quick:
    TNT1 A 0 A_FireCustomMissile("QBall_Quick", 0, 0)
    stop
   Dusk:
    TNT1 A 0 A_FireCustomMissile("QBall_Dusk", 0, 0)
    stop
   Cherish:
    TNT1 A 0 A_FireCustomMissile("QBall_Cherish", 0, 0)
    stop
   Park:
    TNT1 A 0 A_FireCustomMissile("QBall_Park", 0, 0)
    stop
   Dream:
    TNT1 A 0 A_FireCustomMissile("QBall_Dream", 0, 0)
    stop
   Dark:
    TNT1 A 0 A_PlaySound("Pokemon/Detect", 1)
    TNT1 A 0 A_FireCustomMissile("QBall_Dark", 0, 0)
    stop
   Beast:
    TNT1 A 0 A_FireCustomMissile("QBall_Beast", 0, 0)
    stop
   Strange:
    TNT1 A 0 A_FireCustomMissile("QBall_Strange", 0, 0)
    stop

   PokeArceus:
    TNT1 A 0 A_FireCustomMissile("QBall_PokeArceus", 0, 0)
    stop
   GreatArceus:
    TNT1 A 0 A_FireCustomMissile("QBall_GreatArceus", 0, 0)
    stop
   UltraArceus:
    TNT1 A 0 A_FireCustomMissile("QBall_UltraArceus", 0, 0)
    stop
   HeavyArceus:
    TNT1 A 0 A_Jump(52, 4)
    TNT1 A 0 A_Jump(128, 2)
    TNT1 A 0 A_FireCustomMissile("QBall_HeavyArceus", 0, 0)
    stop
   Leaden:
    TNT1 A 0 A_FireCustomMissile("QBall_Leaden", 0, 0)
    stop
   Gigaton:
    TNT1 A 0 A_FireCustomMissile("QBall_Gigaton", 0, 0)
    stop
   Feather:
    TNT1 A 0 A_Jump(52, 4)
    TNT1 A 0 A_Jump(128, 2)
    TNT1 A 0 A_FireCustomMissile("QBall_Feather", 0, 0)
    stop
   Wing:
    TNT1 A 0 A_FireCustomMissile("QBall_Wing", 0, 0)
    stop
   Jet:
    TNT1 A 0 A_FireCustomMissile("QBall_Jet", 0, 0)
    stop
   Origin:
    TNT1 A 0 A_FireCustomMissile("QBall_Origin", 0, 0)
    stop
  }
}



/////////////////
// == Shiny == //
/////////////////

actor S_QwantRandomBallItem : QwantRandomBallItem {
  // More for rarer balls and slight changes to RNG
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("MyDestinyAmmo", 1)
    TNT1 A 0 A_Jump(8, "Master")
    TNT1 A 0 A_Jump(16, "Strange")
    TNT1 A 0 A_Jump(32, "Net", "Luxury", "Quick", "Beast")
    TNT1 A 0 A_Jump(48, "Dark", "Repeat", "Fast", "Timer", "Cherish")
    TNT1 A 0 A_Jump(64, "Lure", "Moon", "Heavy", "Nest", "Dusk", "Dream")
    TNT1 A 0 A_Jump(128, "Level", "Dive", "Feather", "HeavyArceus")
    TNT1 A 0 A_Jump(192, "Safari", "Friend", "Sport", "Park")
    TNT1 A 0 A_Jump(256, "Ultra")
    goto Ultra
  }
}


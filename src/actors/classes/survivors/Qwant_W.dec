}

actor QBall_ArceusWave1 : BasicProjectile {
  Translation "192:192=5:5"
  DamageType "Pokeball"
  Obituary "%o was caught by %k's Hisui Heavy Ball."
  +FORCEXYBILLBOARD
  +FLOORHUGGER
  +NODROPOFF
  MaxDropOffHeight 64
  Damage (30)
  Radius 16
  Height 16
  Speed 30
  Scale 2.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    X_0E T 6
    TNT1 A 1 A_SpawnItemEx("QBall_ArceusWaveFX", -1 * sqrt(velx * velx + vely * vely), 0, 0, velx, vely, velz, 0, 1 + 8)
    stop
  }
}

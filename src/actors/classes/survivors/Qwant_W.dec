actor QBall_HeavyWave_H : BasicWatcher {
  Args 20
  States {
   Spawn:
    TNT1 A 0
    goto SpawnL
   SpawnL:
    TNT1 A 0 A_SpawnItemEx("QBall_ArceusWave1", 0, 0, 0, 25, 0, 0, args[0] * 18)
    TNT1 A 0 A_CountDownArg(0)
    loop
   Death:
    TNT1 A 0 Radius_Quake(1, 5, 0, 7, 0)
    TNT1 A 5 A_PlaySound("Pokemon/Bide", 2, 1.0, false, 0.8)
    stop
  }
}

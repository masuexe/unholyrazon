actor Qwant_W_ScriptBar : ScriptBar {}

actor Qwant_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 28
  Obituary "$OB_01W0"
  Tag "$TAG_Qwant_W"
  Inventory.Icon "PKMNI_Qw"
  Weapon.AmmoType "MyDestinyAmmo"
  Weapon.AmmoType2 "MoveRelearnAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H01 [ 6
    loop

   Deselect:
    6H01 A 0
    goto DeselectSwap
   Select:
    6H01 A 0
    goto SelectSwap

   Ready:
    6H01 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", QWANT_DYE, CLRF_QWANTMENU)
    goto ReadyX
   ReadyX:
    6H01 A 4 A_WeaponReady
    6H01 A 0 A_GiveInventory("MoveRelearnAmmo", 1)  // 2; still 50% faster than any other wep but allows for them to be a bit better
    loop

    // Fire:
    // 6H01 B 0 A_PlaySoundEx("misc/devilfire","Weapon")//PokemonShot
    // 6H01 B 0 A_FireCustomMissile("QBall_Poke",0,0)
   Fire:
    6H01 A 0 A_PlaySound("Pokemon/BallThrow", 1)
    6H01 A 0 A_GiveInventory("QwantRandomBallItem")
    6H01 BCAA 4 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX

   AltFire:
    6H01 A 0 A_PlaySound("Pokemon/BallThrow", 1)
    6H01 A 0 A_GiveInventory("Qwant_SuperFire_P")  // Qwant_TestFireAll_P
    6H01 CBAAAA 4 A_GiveInventory("MoveRelearnAmmo", 1)
    goto ReadyX
  }
}

actor MyDestinyAmmo : Ammo {Inventory.MaxAmount 28 +INVENTORY.IGNORESKILL}

actor MoveRelearnAmmo : Ammo {
  Inventory.MaxAmount 28
  +INVENTORY.IGNORESKILL
}

actor QwantBallFlag : Inventory {
  Inventory.MaxAmount 50
}

actor PokemonShot : BasicProjectile {
  DamageType "Buster"
  Speed 60
  Damage (50)
  Radius 5
  Height 5
  Scale 2.5
  States {
   Spawn:
    TNT1 A 2
    BASB A 1
    goto spawn+1
   Death:
    BASB A 1
    stop
  }
}


actor Qwant_BallDeathFX : BasicClientSide {
  Translation "192:192=4:4", "198:198=215:215"
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    TNT1 A 0
    TMFX OBCH 2
    // MMFX BCDE 2
    stop
  }
}

// Obituary "$OB_01M0A"
actor QBall_Poke : BasicProjectile {
  DamageType "Pokeball"
  Obituary "%o was caught by %k's Poke Ball."
  -NOGRAVITY
  +FORCEXYBILLBOARD
  // +HEXENBOUNCE
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  // -ALLOWBOUNCEONACTORS
  +SKYEXPLODE
  +CANBOUNCEWATER
  // +USESTBOUNCESOUND
  BounceFactor 0.80
  WallBounceFactor 0.80
  BounceSound "Qwant/BallBounce"
  WallBounceSound "Qwant/BallBounce"
  BounceCount 5
  Damage (75)  // Feb 27 1996
  Radius 14
  Height 26
  Speed 35
  Scale 2.0
  Args 15
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ThrustThingZ(0, args[0], 0, 1)
    TNT1 A 0 A_Jump(256, "Spawn2")
    loop
   Spawn2:
    PKB1 ABCD 4
    loop
   Death:
    TNT1 A 0  // A_SetGravity(0.0)
   DeathFX:
    TNT1 A 2 A_SpawnItemEx("Qwant_BallDeathFX", 0, 0, Height / 2, 0, 0, 0, 0, 32)
    stop
   DeathFX0:
    TNT1 A 0 A_SpawnItemEx("Qwant_BallDeathFX", 0, 0, Height / 2, 0, 0, 0, 0, 32)
    stop
  }
}



actor LuckyLassRandomShotHelper : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("weapon/RaygunSmash","Weapon")
TNT1 A 0 A_Jump(256,"P_Basic","P_Blind","P_Explode","P_Random","P_Ripper","P_Stun")
P_Basic:
TNT1 A 0 A_FireCustomMissile("LuckyLassShotBasic",0,0,8,0)
stop
P_Blind:TNT1 A 0 A_FireCustomMissile("LuckyLassShotBlind",0,0,8,0)stop
P_Explode:TNT1 A 0 A_FireCustomMissile("LuckyLassShotExplode",0,0,8,0)stop
P_Random:TNT1 A 0 A_FireCustomMissile("LuckyLassShotRandom",0,0,8,0)stop
P_Ripper:TNT1 A 0 A_FireCustomMissile("LuckyLassShotRipper",0,0,8,0)stop
P_Stun:TNT1 A 0 A_FireCustomMissile("LuckyLassShotStun",0,0,8,0)stop
}
}

actor LuckyLassRandomShotBase
{
PROJECTILE
damagetype "LuckyLass"
+FORCEXYBILLBOARD
Radius 16
Height 16
speed 80
scale 2.5
States
{
Spawn:
6P06 ABCD 3
loop
Death:
TMFX ABCD 3
stop
}
}

actor LuckyLassShotBasic : LuckyLassRandomShotBase
{
Translation "192:192=4:4","198:198=128:128"
//damagetype "LuckyPower"
Obituary "%o was wrecked by %k's Lucky Buster."
damage (500)
}

actor LuckyLassShotBlind : LuckyLassRandomShotBase
{
Translation "192:192=4:4","198:198=249:249"
damagetype "LuckyIce"
Obituary "%o was frozen by %k's Lucky Buster."
damage (200)
DeathSound "weapon/centaurflash"
}

actor LuckyLassShotExplode : LuckyLassRandomShotBase
{
Translation "192:192=4:4","198:198=88:88"
damagetype "LuckyFire"
Obituary "%o was burnt by %k's Lucky Buster."
damage (300)
States
{
Death:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode", "Weapon")
TNT1 A 0 A_Explode(200,128,0,0,16)
TNT1 A 0 A_SpawnItemEx("UH_OilPitIgnite",0,0,8)
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX_Dull",0,0,0,0,0,0,0,1+16384)
stop
}
}

actor LuckyLassShotRandom : LuckyLassRandomShotBase
{
Translation "192:192=4:4","198:198=216:216"
//damagetype "LuckyLuck"
Obituary "%o was blasted by %k's Lucky Buster."
Damage (random(350,850))
}


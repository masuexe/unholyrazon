TNT1 A 0 A_GiveInventory("LuckyLassColorDelay",1)
goto Pickup2
Pickup2:
TNT1 A 0 A_JumpIfInventory("LL_Color1",1,"P__1")
TNT1 A 0 A_JumpIfInventory("LL_Color2",1,"P__2")

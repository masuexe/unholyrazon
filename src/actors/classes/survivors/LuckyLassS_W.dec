}


actor LuckyLassAltfireStartSound : BasicSoundFollow
{
ReactionTime 45
States
{
TheSound:
TNT1 A 1 A_PlaySoundEx("weapon/LuckyAltShot","Weapon")
goto Spawn2
}
}

actor LuckyLassAltfireStart : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("LuckyLassAltfire",0,0,0,15,0,0)
TNT1 AA 0 A_SpawnItemEx("LuckyLassAltfire",0,0,0,15,random(-16,16),random(0,8))
TNT1 AA 0 A_SpawnItemEx("LuckyLassAltfire",0,0,0,15,random(-32,32),random(4,16))
TNT1 AA 0 A_SpawnItemEx("LuckyLassAltfire",0,0,0,15,random(-64,64),random(8,32))
stop
}
}

actor LuckyLassAltfire
{
Translation "192:192=4:4","198:198=199:199"
PROJECTILE
damagetype "LuckyFire"
Obituary "%o touched %k's Lucky Buster and lost the lottery."
+DONTSPLASH
+THRUGHOST
+RIPPER
+DOOMBOUNCE
Radius 16
Height 16
scale 2.5
damage (10)
speed 5
States
{
Spawn:
6P06 A 0
6P06 A 0 ACS_ExecuteAlways(259,0,1)
6P06 AAABBB 1 A_Recoil(2)
6P06 C 0 A_Stop
6P06 CD 3
6P06 D 0 A_Jump(256,"S_Basic","S_Blind","S_Explode","S_Random","S_Ripper","S_Stun")

S_Basic:
6P06 D 0 A_CustomMissile("LuckyLassShotBasic2",0,0,0,2,-pitch)
stop
S_Blind:6P06 D 0 A_CustomMissile("LuckyLassShotBlind2",0,0,0,2,-pitch)stop
S_Explode:6P06 D 0 A_CustomMissile("LuckyLassShotExplode2",0,0,0,2,-pitch)stop
S_Random:6P06 D 0 A_CustomMissile("LuckyLassShotRandom2",0,0,0,2,-pitch)stop
S_Ripper:6P06 D 0 A_CustomMissile("LuckyLassShotRipper2",0,0,0,2,-pitch)stop
S_Stun:6P06 D 0 A_CustomMissile("LuckyLassShotStun2",0,0,0,2,-pitch)stop
}
}




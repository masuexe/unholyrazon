P__4:TNT1 A 0 A_TakeInventory("LL_Color4",1)TNT1 A 0 A_Jump(256,"P_1","P_2","P_3","P_5","P_6","P_7","P_8")stop
P__5:TNT1 A 0 A_TakeInventory("LL_Color5",1)TNT1 A 0 A_Jump(256,"P_1","P_2","P_3","P_4","P_6","P_7","P_8")stop

actor Quickster_W_NormalBar : NormalBar {Args 229, 220}

actor Quickster_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 1
  Weapon.AmmoGive 40
  Inventory.Pickupmessage "$PU_07"
  Obituary "$OB_07W"
  Tag "$TAG_Quickster_W"
  Weapon.AmmoType "RapidEnergyAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H07 [ 6
    loop

   Deselect:
    6H07 A 0
    goto DeselectSwap
   Select:
    6H07 A 0
    goto SelectSwap

   Ready:
    6H07 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", QUICKSTER_DYE)
    6H07 A 0 A_GunFlash
    goto Ready2
   Ready2:
    6H07 A 2 A_WeaponReady
    6H07 A 0 A_GiveInventory("RapidEnergyAmmo", 1)
    loop

   Flash:
    TNT1 A 1 A_GiveInventory("Quickster_Flash_P")
    loop

   Fire:
    6H07 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H07 B 0 A_JumpIfNoAmmo("NoAmmoFire")
    6H07 B 0 A_TakeInventory("RapidEnergyAmmo", 2)
    6H07 B 0 A_PlaySound("weapon/mbuster", 1)
    6H07 B 0 A_FireCustomMissile("RapidShot", random(-2, 2), 1, 8, 0)
    6H07 BCA 2
    goto Ready2
   NoAmmoFire:
    6H07 C 0 A_PlaySound("Weapon/mbuster", 1)
    6H07 C 0 A_FireCustomMissile("NoHopeShot", random(-8, 8), 1, 8, 0, 1, random(-4, 4))
    6H07 CB 2
    goto Ready2
   Altfire:
    6H07 A 0 A_JumpIfInventory("RapidEnergyAmmo", 40, "FireTheFist")
   AltfireH:
    6H07 B 2 A_GiveInventory("Quickster_Alt_P")
    6H07 B 0 A_ReFire(1)
    goto Ready2
    6H07 C 2 A_GiveInventory("Quickster_Alt_P")
    6H07 C 0 A_ReFire("AltfireH")
    goto Ready2

   FireTheFist:
    6H07 B 0 A_GiveInventory("Quickster_AltThrust_P")
    6H07 BCB 2
    6H07 A 8
    goto Ready2

   BotFire:
    6H07 B 0 A_Jump(16, "BotFire2")
    6H07 B 0 A_JumpIfCloser(128, "BotFire1")
    6H07 B 0 A_Jump(8, "FireTheFist")
    goto Fire+1
   BotFire1:
    6H07 B 2 A_GiveInventory("Quickster_Alt_P")
    goto Ready2
   BotFire2:
    6H07 B 0 A_PlaySoundEx("classes/taunt/quickster", "Voice")
    6H07 B 0 A_JumpIfCloser(198, "FireTheFist")
    6H07 B 0 A_JumpIfInventory("RapidEnergyAmmo", 40, "FireTheFist")
    6H07 B 0 A_GiveInventory("RapidEnergyAmmo", 40)
    goto BotFire+1
  }
}

actor RapidEnergyAmmo : Ammo {
  Inventory.MaxAmount 40
  +INVENTORY.IGNORESKILL
}

actor Quickster_Alt_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("QuickJabbings", random(-10, 10), 0, 8, 0, 1, random(-5, 5))
   End:
    TNT1 A 0 A_PlaySound("weapon/mbuster", 1)
    stop
  }
}

actor Quickster_AltThrust_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("DireJabShot", 0, 1, 8, 0)
    goto Thrust
   Thrust:
    TNT1 A 0 A_PlaySound("Pokemon/ShadowBall", 1)
    TNT1 A 0 A_TakeInventory("RapidEnergyAmmo", 20, 1)
    TNT1 A 0 A_TakeInventory("RapidEnergyAmmo", 20)
    TNT1 A 0 A_JumpIf(pitch > 0 && pitch <= 90, "PickupDown")
    goto PickupUp
   PickupUp:
    TNT1 A 0 A_JumpIf(velz <= 0, "BasicEnd")
    TNT1 A 0 ThrustThingZ(0, 0, 0, 0)
    TNT1 A 0 A_ChangeVelocity(-cos(pitch) * 18, 0, sin(pitch) * 16, CVF_RELATIVE)
    goto BasicEnd
   PickupDown:
    TNT1 A 0 A_JumpIf(velz >= 0, "BasicEnd")
    TNT1 A 0 ThrustThingZ(0, 0, 0, 0)
    TNT1 A 0 A_ChangeVelocity(-cos(pitch) * 18, 0, sin(pitch) * 16, CVF_RELATIVE)
    stop
   BasicEnd:
    TNT1 A 0 A_ChangeVelocity(-cos(pitch) * 18, 0, sin(pitch) * 14, CVF_RELATIVE)
    stop
  }
}

actor Quickster_Flash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(sqrt(velx * velx + vely * vely) >= 5000, "No")
    TNT1 A 0 A_JumpIf(!CallACS("core_CheckFooting"), 2)
    TNT1 A 1 A_ChangeVelocity(velx * 1.045, vely * 1.045, velz, CVF_REPLACE)
    stop
    TNT1 A 1 A_ChangeVelocity(velx * 1.035, vely * 1.035, velz, CVF_REPLACE)
    stop
   No:
    TNT1 A 0  // A_Log("GOTTA GO TOO FAST")
    stop
  }
}

actor RapidShot : BasicProjectile {
  Translation "192:192=229:229", "198:198=218:218", "202:202=4:4", "199:199=218:218"
  DamageType "Rapid"
  Obituary "$OB_07M1"
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (100)
  Radius 11
  Height 11
  Speed 65
  Scale 2.5
  States {
   Spawn:
    6P07 RSTU 1
    loop
   Death:
    UMFX ABCD 2
    stop
  }
}

actor NoHopeShot : BasicProjectile {
  Translation "198:198=218:218"
  DamageType "Rapid"
  Obituary "$OB_07M2"
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (50)
  Radius 6
  Height 6
  Speed 60
  Scale 2.5
  States {
   Spawn:
    TNT1 A 1
    X_0D A 1
    wait
  }
}

actor QuickJabbings : BasicProjectile {
  Translation "192:192=229:229"
  DamageType "RapidAlt"
  Obituary "$OB_07A2"
  +RIPPER
  +FORCEXYBILLBOARD
  +BRIGHT
  Damage (25)
  Radius 12
  Height 12
  Speed 60
  Scale 2.5
  States {
   Spawn:
    6P07 P 2
    6P07 Q 1
    stop
  }
}

actor DireJabShot : BasicProjectile {
  Translation "192:192=229:229", "198:198=220:220"
  DamageType "RapidAlt"
  Obituary "$OB_07A1"
  Damage (625)
  Radius 12
  Height 10
  Speed 70
  Scale 2.5
  States {
   Spawn:
    X_3D A 3
    wait
   Death:
    TMFX ABCD 2
    stop
  }
}

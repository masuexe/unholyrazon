actor Amber : CustWepClassBase {
  Player.ScoreIcon "UMUG_52"
  Player.StartItem "NoDrawMaestroMugshot"
  Player.DisplayName "Amber"
  Player.SoundClass "Amber"
  Player.MaxHealth 750
  Health 750
  Player.ForwardMove 1.025, 1.025
  Player.SideMove 1.025, 1.025
  Player.JumpZ 12
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "Amber_W"
  Player.StartItem "AmberEnergyAmmo", 50
  Player.StartItem "VixenScuttleAmmo", 200

  States {
   Spawn:
    1H52 A 0
    1H52 B 1
    1H52 A 1
    goto Spawn+2
   See:
    1H52 BCDE 5
    goto Spawn
   Missile:
    1H52 F 0 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    1H52 F 0 A_JumpIfInventory("BotFlag2", 1, "Missile3")
    1H52 F 0 A_JumpIfInventory("WeaponCharge", 1, "Missile1")
    1H52 F 4
    1H52 G 6
    goto Spawn+2
   Missile1:
    1H52 F 3
    1H52 G 9
    goto Spawn+2
   Missile2:
    1H52 BCDEBCDEBCDE 2
    goto Spawn
   Missile3:
    1H52 G 10
    goto Spawn+2

   ClassPain:
    1H52 H 0
    goto MegamanPain

   ClassDeath:
    1H52 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H52 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")  // A_SpawnItemEx("AmberHealthPickupDeath",0,0,8)//MegamanFade3
    1H52 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H52 H 0 ThrustThingZ(0, 82, 0, 0)
    1H52 H 0 A_SpawnItemEx("AmberKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
   MegamanDisintegrate:
    1H52 Z 0 A_SpawnItemEx("Corpse_52", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor AmberShiny : Amber {
  Player.ScoreIcon "UMUG_S52"
  Player.MaxHealth 2750
  Health 2750
  Player.ForwardMove 1.125, 1.125
  Player.SideMove 1.125, 1.125
  Player.JumpZ 13
  Player.MorphWeapon "AmberShiny_W"
  +NOSKIN
  +NOMORPHLIMITATIONS
  States {
   MegamanDeath0:
    1H52 H 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H52 H 19 A_PlaySound("KirbyNES/Hit_D", 2)
    1H52 H 0 ThrustThingZ(0, 82, 0, 0)
    1H52 H 0 A_SpawnItemEx("S_AmberKirbyDeathCorpse", 0, 0, 0, 0, 0, 20, 0, 1)
    goto MegamanErase
  }
}


actor BasicKirbyDeathCorpse : BasicProjectile {
  Obituary "%o told %k that Marx is hella gay."
  DamageType "Normal"
  +RIPPER
  +SKYEXPLODE
  +EXPLODEONWATER
  +DONTSPLASH
  +DONTREFLECT
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  BounceFactor 0.1
  WallBounceFactor 0.90
  BounceCount 4
  ReactionTime 1
  Damage (75)
  Radius 15
  Height 56
  Speed 10
  Scale 2.5
  Args 250, 168, 16
  States {
   Spawn:
    "####" "#" 0
    "####" "#" 0
    goto Spawn2
   Spawn2:
    "####" "#" 0 A_SpawnItemEx("BasicKirbyDeathFX_H", 0, 0, 28, 0, 0, 0, 0, 1)
   Spawn3:
    "####" "#" 0 A_SpawnItemEx("BasicKirbyDeathFX2", 0, 0, 28, 5, 0, random(-5, 5), random(0, 359), 1)
    "####" "##" 1 ThrustThingZ(0, 3, 1, 1)
    // ThrustThingZ(0,1,0,1)//-NOGRAVITY
    loop

   Death:
    TNT1 A 0 A_PlaySound("misc/devildeath")
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("FakeUnholyDeathFX", 0, 0, 32, 0, 0, 0, 0, 1)
    stop
  }
}

actor AmberKirbyDeathCorpse : BasicKirbyDeathCorpse {
  DamageType "Amber"
  Obituary "$OB_52D"
  States {
   Spawn:
    1H52 H 0
    1H52 H 0
    goto Spawn2
  }
}
actor S_AmberKirbyDeathCorpse : AmberKirbyDeathCorpse {
  Damage (113)
  Args 375, 168, 16
}

actor BasicKirbyDeathFX : BasicClientSide {
  ReactionTime 44
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0  // A_Jump(256,1,2,3,4)
    6P0K ABCD 2 A_CountDown
    goto Spawn+2
  }
}

actor BasicKirbyDeathFX2 : BasicClientSide {
  ReactionTime 5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P0K EFGH 2 A_CountDown
    goto Spawn+2
  }
}

actor BasicKirbyDeathFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("KirbyNES/Death", 2)
    TNT1 A 1
    /*
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,0,15,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,0,-15,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,10.598,10.606,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,-10.598,10.606,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,10.606,-10.598,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,-10.606,-10.598,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,15,0,0,1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX",0,0,0,0,-15,0,0,1)
     */
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, 0, 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, 0, -5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, 3.533, 3.535, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, -3.533, 3.535, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, 3.535, -3.534, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, -3.535, -3.534, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, 5, 0, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicKirbyDeathFX", 0, 0, 0, 0, -5, 0, 0, 1)

    TNT1 A 35
    stop
  }
}

actor Corpse_52 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_52_0", 0, 0, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_1", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_2", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_3", 0, 0, 18, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_4", 0, 0, 18, velx + frandom(-1, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_5", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_52_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


actor PartyBomberPresentBase : BasicProjectile
{
Translation "192:192=212:212","198:198=238:238"
Damagetype "PartyBomber"
Obituary "$OB_39A2"
-NOGRAVITY
+THRUGHOST
+DONTSPLASH
+FORCEXYBILLBOARD
Damage (10)
Radius 14
Height 28
Speed 40
scale 4.0
Args 0
States
{
Spawn:
TNT1 A 0
TNT1 A 1 ThrustThingZ(0,30,0,1)
6P39 B 1
wait

Death:
TNT1 A 0 A_SetGravity(0.0)
PartyBoom:
TNT1 A 0 A_SpawnItemEx("PB_PresentBoom",0,0,14+(ceilingz-z<=height)*-28,0,0,0,0,1)
TNT1 AAAAA 4 A_PlaySoundEx("Pokemon/Explosion","Weapon")
TNT1 A 6
TNT1 A 0 A_CountDownArg(0,"NoDeath")
loop
NoDeath:
TNT1 A 2 // A_SpawnItemEx("BasicBoom1FX_XA",0,0,0,0,0,0,0,1)
stop
}
}


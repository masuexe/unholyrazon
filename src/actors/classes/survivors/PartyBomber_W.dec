actor PartyBomber_AltSlam_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_FireCustomMissile("PartyBomberSlamSurprise")
End:
TNT1 A 0 A_ChangeVelocity(-20,0,28,3)
TNT1 A 0 A_GiveInventory("PartyBomber_F",28)
TNT1 A 0 A_TakeInventory("PartyPowerAmmo",75,1)
TNT1 A 0 A_TakeInventory("PartyPowerAmmo",75)
TNT1 A 0 A_GiveInventory("VivifyDelay6",1)
TNT1 A 0 A_TakeInventory("VivifyCycle2")
TNT1 A 0 A_TakeInventory("DecoyFlag1")
TNT1 A 0 A_TakeInventory("JumpCancler")
stop
}
}

actor PartyBomber_AltDash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("PartyBomberSlamCheck",0,0,-8,momx,momy,momz,0,1+8)
End:
TNT1 A 0 A_GiveInventory("VivifyCycle2",1)
TNT1 A 0 A_TakeInventory("PartyPowerAmmo",1,1)
TNT1 A 0 A_TakeInventory("PartyPowerAmmo",1)
TNT1 A 0 A_ChangeVelocity(5-2.575*(z-floorz!=0),0,0,CVF_RELATIVE)
//TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX1",0,0,0,random(-10,10),random(-10,10),5,0,1)
//TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX2",0,0,0,random(-10,10),random(-10,10),5,0,1)
stop
}
}

Actor HyperPartyBomb : BasicProjectile
{
Translation "192:192=212:212","198:198=238:238","199:199=251:251"
Damagetype "PartyBomber"
Obituary "$OB_39M1"
-NOGRAVITY
+SKYEXPLODE
+EXPLODEONWATER
+FORCEXYBILLBOARD
Damage (25)
Radius 12
Height 16
speed 40
scale 2.5
Args 165,128,16
States
{
Spawn:
TNT1 A 0
TNT1 A 1 ThrustThingZ(0,30,0,1)
6P39 A 1
wait
Death:
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_SpawnItemEx("BasicConfetti_H",0,0,(ceilingz-z<=height)*-12,0,0,0,0,1)
TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb","Weapon")
TNT1 A 0 A_Explode(Args[0],Args[1],0,0,Args[2])
TNT1 A 4 A_SpawnItemEx("BasicBoom1FX_XA",0,0,0,0,0,0,0,1)
stop
}
}

Actor HyperPartyBombBot : HyperPartyBomb
{
States
{
Spawn:
TNT1 A 0
TNT1 A 1 ThrustThingZ(0,8,0,1)
6P39 A 1
wait
}
}

actor PartyBomberSlamCheck : BasicProjectile
{
Damagetype "PartyBomber"
Obituary "$OB_39A0"
+DONTSPLASH
+DONTBLAST
+THRUGHOST
+DONTREFLECT
//+HITTRACER
RenderStyle None
damage (10)
Radius 62
Height 72
States
{
Spawn:
goto Death
XDeath:
TNT1 A 1 A_GiveToTarget("DecoyFlag1",1)
//TNT1 A 0 A_Warp(8)
//TNT1 A 0 A_SpawnItemEx("PartyBomberSlamSurprise",0,0,32)
Stop
Death:
TNT1 A 0
TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX1",0,random(-8,8),8+random(0,8),random(-8,2),random(-10,10),5,0,1)
TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX2",0,random(-8,8),8+random(0,8),random(-8,2),random(-10,10),5,0,1)
Stop
}
}


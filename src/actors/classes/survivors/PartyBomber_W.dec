TNT1 A 0 A_SpawnItemEx("PartyB_HealFX",random(2,4)*8,0,random(1,3)*4,11.3,0,frandom(10,12),45*ReactionTime+random(0,11)+22,1)
TNT1 A 0 A_SpawnItemEx("PartyB_HealFX",random(2,4)*8,0,random(1,3)*4,11.3,0,frandom(-10,-12),45*ReactionTime+random(0,11)+22,1)

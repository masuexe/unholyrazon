actor PB_PresentBoom : BasicExplosion {
  DamageType "PartyBomber"
  Obituary "$OB_39A2"
  Args 75, 104, 32
  States {
   Spawn:
    TNT1 A 0
    // TNT1 A 1
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("PB_PresentFX", random(-1, 1) * 48, 48, 48, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("PB_PresentFX", random(-1, 1) * 48, -48, -48, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("PB_PresentFX", random(-1, 1) * 48, 48, -48, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("PB_PresentFX", random(-1, 1) * 48, -48, 48, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 5 A_SpawnItemEx("PB_PresentFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor PB_PresentFX : BasicClientSide {
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 4.0

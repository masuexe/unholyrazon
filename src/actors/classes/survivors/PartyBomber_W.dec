actor PartyBomber_W_NormalBar : NormalBar {args 212, 238}

actor PartyBomber_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 300
  Inventory.Pickupmessage "$PU_39"
  Obituary "$OB_39W"
  Tag "$TAG_PartyBomber_W"
  Weapon.AmmoType "PartyPowerAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H39 [ 6
    loop

   Deselect:
    6H39 A 0
    goto DeselectSwap
   Select:
    6H39 A 0 A_TakeInventory("PartyBomber_F")
    goto SelectSwap

   Ready:
    6H39 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", PARTYBOMBER_DYE)
    goto Ready2
   Ready2:
    6H39 A 2 A_GiveInventory("PartyBomber_WepReady_P")
    loop
   Ready4:
    6H39 OAOAOAOAOAOAOAOAOAOAOAOAOAOA 2 A_GiveInventory("PartyBomber_WepReady_P")
    6H39 A 0 A_GiveInventory("PartyPowerAmmo", 42)
    goto Ready2


   Fire:
    6H39 B 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    6H39 B 0 A_GiveInventory("PartyBomber_Fire_P")
    6H39 BCDEFG 2
    goto Ready2

   BotFire:
    6H39 A 0 A_JumpIfCloser(512, "BotFire2")
    6H39 A 0 A_JumpIfInventory("PartyPowerAmmo", random(100, 125), "AltFire")
    6H39 A 0 A_Jump(24, 1)
    goto Fire+1
    6H39 A 0 A_GiveInventory("PartyPowerAmmo", 25)
    goto Fire+1

   BotFire2:
    6H39 A 0 A_Jump(64, 2)
    6H39 A 0 A_Jump(32, "AltFire2")
    goto Fire+1
    6H39 A 0 A_PlaySoundEx("classes/taunt/partybomber", "Voice")
    6H39 BCDEFG 2 A_Recoil(-3)
    6H39 A 0 A_FireCustomMissile("PartyBomberSlamSurprise", 0, 0, 0, 0)
    goto AltStart

   AltFire2:
    6H39 B 2 A_GiveInventory("PartyBomber_Alt_P")
    6H39 CDEFG 2
    goto Ready2

   AltFire:
    6H39 A 0 A_JumpIfInventory("PartyPowerAmmo", 2, 1)
    goto StopRightThere
    // PRTY A 0 A_JumpIf(z-floorz>=1, "StopRightThere")

    // 6H39 F 8 A_PlaySound("weapon/pcharge",1)
    // 6H39 EDC 8
    // 6H39 B 3
    // 6H39 B 0 A_PlaySound("weapon/hyperbomb",1)

    6H39 I 1 A_PlaySound("weapon/pcharge", 1)
    6H39 I 0 A_ReFire(1)
    goto StopAlt

    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire(1)
    goto StopAlt
    6H39 I 2
    6H39 I 0 A_ReFire(1)
    goto StopAlt
    6H39 H 2
    6H39 H 0 A_ReFire("AltStart")
    goto StopAlt

   StopAlt:
    6H39 A 2 A_PlaySound("misc/NoSnd", 1)
    goto Ready2

   AltStart:
    6H39 E 0 A_PlaySound("misc/NoSnd", 1)
    6H39 E 0 A_PlaySound("PKMN1/Explosion1", 4, 0.65)
    6H39 E 0 A_ChangeVelocity(15 - 7.725 * (!CallACS("core_CheckFooting")), 0, 0, CVF_RELATIVE)
   AltDash:
    6H39 E 0 A_JumpIfInventory("PartyPowerAmmo", 1, 1)
    goto StopRightThere
    6H39 E 1 A_GiveInventory("PartyBomber_AltDash_P")
    6H39 E 0 A_JumpIfInventory("DecoyFlag1", 1, "ParteyBlast")
    // 6H39 B 0 A_JumpIf(z-floorz>=48, "StopRightThere")
    6H39 E 1 A_ReFire(1)
    goto StopRightThere
    6H39 L 0 A_JumpIfInventory("PartyPowerAmmo", 1, 1)
    goto StopRightThere
    6H39 L 1 A_GiveInventory("PartyBomber_AltDash_P")
    6H39 L 0 A_JumpIfInventory("DecoyFlag1", 1, "ParteyBlast")
    6H39 L 1 A_ReFire("AltDash")
    goto StopRightThere
   StopRightThere:
    6H39 F 2 A_TakeInventory("VivifyCycle2")
    6H39 Z 2 A_TakeInventory("DecoyFlag1")
    6H39 MNA 2
    goto Ready2
   ParteyBlast:
    6H39 D 0 A_GiveInventory("PartyBomber_AltSlam_P")
    6H39 DCB 2
    6H39 Z 10
    6H39 MN 2
    goto Ready4
  }
}

actor PartyPowerAmmo : Ammo {
  Inventory.MaxAmount 150
  +INVENTORY.IGNORESKILL
}

actor PartyBomber_F : Inventory {Inventory.MaxAmount 28
}

actor PartyBomber_WepReady_P : CustomInventory {
  States {
   Pickup:
   Ready2:
    TNT1 A 0 A_JumpIfInventory("PartyBomber_F", 1, "Ready4")
    TNT1 A 0 A_JumpIfInventory("PartyPowerAmmo", 150, "Ready3")
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    goto Ammo
   Ready3:
    TNT1 A 0 A_WeaponReady
    goto Ammo
   Ready4:
    TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
    TNT1 A 0 A_TakeInventory("PartyBomber_F", 1)
    goto Ammo

   Ammo:
    TNT1 A 0 A_GiveInventory("PartyPowerAmmo", 2)
    stop
  }
}

actor PartyBomber_Fire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("PartyPowerAmmo", 6)
    TNT1 A 0 A_JumpIfInventory("PartyBomber_F", 1, "Pickup2")
    TNT1 A 0 A_PlaySound("PartyBomber/TossFire", 1, 0.875)  // weapon/mbuster
    TNT1 A 0 A_JumpIfInventory("IsBot", 1, 2)
    TNT1 A 0 A_FireCustomMissile("HyperPartyBomb", 0, 0, 8, 0)
    stop
    TNT1 A 0 A_FireCustomMissile("HyperPartyBombBot", 0, 0, 8, 0)
    stop
   Pickup2:
    TNT1 A 0 A_PlaySound("Pokemon/Present", 4, 0.75)
    TNT1 A 0 A_GiveInventory("PartyBomber_Alt_P")
    TNT1 A 0 A_TakeInventory("PartyBomber_F")
    stop
  }
}
actor PartyBomber_Alt_P : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_TakeInventory("PartyPowerAmmo",25,1)
    // TNT1 A 0 A_TakeInventory("PartyPowerAmmo",25)
    // TNT1 A 0 A_PlaySound("Pokemon/Present",1)
    TNT1 A 0 A_Jump(16, "Pick3")
    TNT1 A 0 A_Jump(77, "Pick2")
    TNT1 A 0 A_Jump(102, "Pick1")
   Pick0:
    TNT1 A 0 A_FireCustomMissile("PartyBomberPresent0", 0, 0, 8, 0)
    stop
   Pick1:
    TNT1 A 0 A_FireCustomMissile("PartyBomberPresent1", 0, 0, 8, 0)
    stop
   Pick2:
    TNT1 A 0 A_FireCustomMissile("PartyBomberPresent2", 0, 0, 8, 0)
    stop
   Pick3:
    TNT1 A 0 A_FireCustomMissile("PartyBomberPresent3", 0, 0, 8, 0)
    stop
  }
}

actor PartyBomber_AltSlam_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("PartyBomberSlamSurprise")
   End:
    TNT1 A 0 A_ChangeVelocity(-20, 0, 28, 3)
    TNT1 A 0 A_GiveInventory("PartyBomber_F", 28)
    TNT1 A 0 A_TakeInventory("PartyPowerAmmo", 75, 1)
    TNT1 A 0 A_TakeInventory("PartyPowerAmmo", 75)
    TNT1 A 0 A_GiveInventory("VivifyDelay6")
    TNT1 A 0 A_TakeInventory("VivifyCycle2")
    TNT1 A 0 A_TakeInventory("DecoyFlag1")
    TNT1 A 0 A_TakeInventory("JumpCancler")
    stop
  }
}

actor PartyBomber_AltDash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("PartyBomberSlamCheck", 0, 0, -8, velx, vely, velz, 0, 1 + 8)
   End:
    TNT1 A 0 A_GiveInventory("VivifyCycle2", 1)
    TNT1 A 0 A_TakeInventory("PartyPowerAmmo", 1, 1)
    TNT1 A 0 A_TakeInventory("PartyPowerAmmo", 1)
    TNT1 A 0 A_ChangeVelocity(5 - 2.575 * (!CallACS("core_CheckFooting")), 0, 0, CVF_RELATIVE)
    // TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX1",0,0,0,random(-10,10),random(-10,10),5,0,1)
    // TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX2",0,0,0,random(-10,10),random(-10,10),5,0,1)
    stop
  }
}

actor HyperPartyBomb : BasicProjectile {
  Translation "192:192=212:212", "198:198=238:238", "199:199=251:251"
  DamageType "PartyBomber"
  Obituary "$OB_39M1"
  -NOGRAVITY
  +SKYEXPLODE
  +EXPLODEONWATER
  +FORCEXYBILLBOARD
  Damage (25)
  Radius 12
  Height 16
  Speed 40
  Scale 2.5
  Args 165, 128, 16
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ThrustThingZ(0, 30, 0, 1)
    6P39 A 1
    wait
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_SpawnItemEx("BasicConfetti_H", 0, 0, (ceilingz - z <= height) * -12, 0, 0, 0, 0, 1)
    TNT1 A 0 A_PlaySoundEx("weapon/hyperbomb", "Weapon")
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 4 A_SpawnItemEx("BasicBoom1FX_XA", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor HyperPartyBombBot : HyperPartyBomb {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ThrustThingZ(0, 8, 0, 1)
    6P39 A 1
    wait
  }
}

actor PartyBomberSlamCheck : BasicProjectile {
  DamageType "PartyBomber"
  Obituary "$OB_39A0"
  +DONTSPLASH
  +DONTBLAST
  +THRUGHOST
  +DONTREFLECT
  // +HITTRACER
  RenderStyle "None"
  Damage (10)
  Radius 62
  Height 72
  States {
   Spawn:
    goto Death
   XDeath:
    TNT1 A 1 A_GiveToTarget("DecoyFlag1", 1)
    // TNT1 A 0 A_Warp(8)
    // TNT1 A 0 A_SpawnItemEx("PartyBomberSlamSurprise",0,0,32)
    stop
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX1", 0, random(-8, 8), 8 + random(0, 8), random(-8, 2), random(-10, 10), 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("BasicFlashBombFX2", 0, random(-8, 8), 8 + random(0, 8), random(-8, 2), random(-10, 10), 5, 0, 1)
    stop
  }
}

actor PartyBomberSlamSurprise : BasicExplosion {
  Translation "192:192=212:212", "198:198=238:238", "199:199=251:251"
  DamageType "PartyBomber"
  Obituary "$OB_39A1"
  Args 335, 215, 48
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BasicConfetti_H", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 0 A_Explode(args[0], args[1], 0, 0, args[2])
    TNT1 A 0 A_PlaySound("PKMN1/Slam", 1, 0.65)
    TNT1 A 4 A_SpawnItemEx("BasicBoom1FX_XA", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor PartyBomberPresentBase : BasicProjectile {
  Translation "192:192=212:212", "198:198=238:238"
  DamageType "PartyBomber"
  Obituary "$OB_39A2"
  -NOGRAVITY
  +THRUGHOST
  +DONTSPLASH
  +FORCEXYBILLBOARD
  Damage (10)
  Radius 14
  Height 28
  Speed 40
  Scale 4.0
  Args 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 ThrustThingZ(0, 30, 0, 1)
    6P39 B 1
    wait

   Death:
    TNT1 A 0 A_SetGravity(0.0)
   PartyBoom:
    TNT1 A 0 A_SpawnItemEx("PB_PresentBoom", 0, 0, 14 + (ceilingz - z <= height) * -28, 0, 0, 0, 0, 1)
    TNT1 AAAAA 4 A_PlaySoundEx("Pokemon/Explosion", "Weapon")
    TNT1 A 6
    TNT1 A 0 A_CountDownArg(0, "NoDeath")
    loop
   NoDeath:
    TNT1 A 2  // A_SpawnItemEx("BasicBoom1FX_XA",0,0,0,0,0,0,0,1)
    stop
  }
}

actor PartyBomberPresent0 : PartyBomberPresentBase {
  Obituary "$OB_39A3"
  States {
   Death:
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_PlaySoundEx("Pokemon/Swift", "Weapon")
    TNT1 A 0 A_SpawnItemEx("PartyB_HealFX_H", 0, 0, 8, 0, 0, 0, 0, 1)
    TNT1 A 2 A_RadiusGive("PartyBomberPresentHeal_P", 196, RGF_PLAYERS, 1)
    stop
  }
}

actor PartyBomberPresentHeal_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 200)
    stop
  }
}

actor PartyB_HealFX_H : BasicClientSide {
  +FORCEXYBILLBOARD
  ReactionTime 8
  Scale 4.0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("PartyB_HealFX", random(2, 4) * 8, 0, random(1, 3) * 4, 16.0, 0, frandom(-1, 1), 45 * ReactionTime + random(0, 11), 1)
    TNT1 A 0 A_SpawnItemEx("PartyB_HealFX", random(2, 4) * 8, 0, random(1, 3) * 4, 11.3, 0, frandom(10, 12), 45 * ReactionTime + random(0, 11) + 22, 1)
    TNT1 A 0 A_SpawnItemEx("PartyB_HealFX", random(2, 4) * 8, 0, random(1, 3) * 4, 11.3, 0, frandom(-10, -12), 45 * ReactionTime + random(0, 11) + 22, 1)
    TNT1 A 0 A_CountDown
    loop
   Death:
    TNT1 A 0 A_SpawnItemEx("PartyBomberPresent0_CakeFX", 0, 0, 8, 0, 0, 2.5, 0, 1)
    TMFX ABCD 1
    stop
  }
}

actor PartyB_HealFX : BasicClientSide {
  +MISSILE
  +FORCEXYBILLBOARD
  Speed 15
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(64, "Spawn3")
    TNT1 A 0 A_Jump(128, "Spawn2")
    goto Spawn1
   Spawn1:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    X_0C AAABBB 1 A_FadeTo(0.20, 0.05, 1)
    goto Spawn1+1
   Spawn2:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    X_0C CCCDDD 1 A_FadeTo(0.20, 0.05, 1)
    goto Spawn2+1
   Spawn3:
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4, 5, 6)
    X_0C EEEFFF 1 A_FadeTo(0.20, 0.05, 1)
    goto Spawn3+1
  }
}

actor PartyBomberPresent0_CakeFX : BasicClientSide {
  +FORCEXYBILLBOARD
  ReactionTime 6
  Scale 4.0
  States {
   Spawn:
    6P39 K 2
    TNT1 A 2 A_CountDown
    loop
  }
}


actor PartyBomber_W_NormalBar : NormalBar {args 212, 238}

Actor PartyBomber_W : BaseMM8BDMWep_UH
{
Weapon.AmmoUse 0
Weapon.AmmoGive 300
Inventory.Pickupmessage "$PU_39"
Obituary "$OB_39W"
Tag "$TAG_PartyBomber_W"
weapon.ammotype "PartyPowerAmmo"
+WEAPON.NOAUTOAIM
States
{
Spawn:
6H39 [ 6
loop

Deselect:
6H39 A 0
goto DeselectSwap
Select:
6H39 A 0 A_TakeInventory("PartyBomber_F")
goto SelectSwap

Ready:
6H39 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", PARTYBOMBER_DYE)
goto Ready2
Ready2:
6H39 A 2 A_GiveInventory("PartyBomber_WepReady_P")
loop
Ready4:
6H39 OAOAOAOAOAOAOAOAOAOAOAOAOAOA 2 A_GiveInventory("PartyBomber_WepReady_P")
6H39 A 0 A_GiveInventory("PartyPowerAmmo",42)
goto Ready2


Fire:
6H39 B 0 A_JumpIfInventory("IsBot",1,"BotFire")
6H39 B 0 A_GiveInventory("PartyBomber_Fire_P")
6H39 BCDEFG 2
Goto Ready2

BotFire:
6H39 A 0 A_JumpIfCloser(512,"BotFire2")
6H39 A 0 A_JumpIfInventory("PartyPowerAmmo",random(100,125),"AltFire")
6H39 A 0 A_Jump(24,1)
goto Fire+1
6H39 A 0 A_GiveInventory("PartyPowerAmmo",25)
goto Fire+1

BotFire2:
6H39 A 0 A_Jump(64,2)
6H39 A 0 A_Jump(32,"AltFire2")
goto Fire+1
6H39 A 0 A_PlaySoundEx("taunt/D_39","Voice")
6H39 BCDEFG 2 A_Recoil(-3)
6H39 A 0 A_FireCustomMissile("PartyBomberSlamSurprise",0,0,0,0)
goto AltStart

AltFire2:
6H39 B 2 A_GiveInventory("PartyBomber_Alt_P")
6H39 CDEFG 2
Goto Ready2

AltFire:
6H39 A 0 A_JumpIfInventory("PartyPowerAmmo",2,1)
Goto StopRightThere
//PRTY A 0 A_JumpIf(z-floorz>=1, "StopRightThere")

//6H39 F 8 A_PlaySound("weapon/pcharge",1)
//6H39 EDC 8
//6H39 B 3
//6H39 B 0 A_PlaySound("weapon/hyperbomb",1)

6H39 I 1 A_PlaySound("weapon/pcharge",1)
6H39 I 0 A_Refire(1)
goto StopAlt

6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire(1)
goto StopAlt
6H39 I 2
6H39 I 0 A_Refire(1)
goto StopAlt
6H39 H 2
6H39 H 0 A_Refire("AltStart")
goto StopAlt

StopAlt:
6H39 A 2 A_PlaySound("misc/NoSnd",1)
Goto Ready2

AltStart:
6H39 E 0 A_PlaySound("misc/NoSnd",1)
6H39 E 0 A_PlaySound("PKMN1/Explosion1",4,0.65)
6H39 E 0 A_ChangeVelocity(15-7.725*(z-floorz!=0),0,0,CVF_RELATIVE)
AltDash:
6H39 E 0 A_JumpIfInventory("PartyPowerAmmo",1,1)
Goto StopRightThere
6H39 E 1 A_GiveInventory("PartyBomber_AltDash_P")
6H39 E 0 A_JumpIfInventory("DecoyFlag1",1,"ParteyBlast")
//6H39 B 0 A_JumpIf(z-floorz>=48, "StopRightThere")
6H39 E 1 A_Refire(1)
Goto StopRightThere
6H39 L 0 A_JumpIfInventory("PartyPowerAmmo",1,1)
Goto StopRightThere
6H39 L 1 A_GiveInventory("PartyBomber_AltDash_P")
6H39 L 0 A_JumpIfInventory("DecoyFlag1",1,"ParteyBlast")
6H39 L 1 A_Refire("AltDash")
Goto StopRightThere
StopRightThere:
6H39 F 2 A_TakeInventory("VivifyCycle2")
6H39 Z 2 A_TakeInventory("DecoyFlag1")
6H39 MNA 2
Goto Ready2
ParteyBlast:
6H39 D 0 A_GiveInventory("PartyBomber_AltSlam_P")
6H39 DCB 2
6H39 Z 10
6H39 MN 2
Goto Ready4

}
}

Actor PartyPowerAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 150
+INVENTORY.IGNORESKILL
}

Actor PartyBomber_F : Inventory
{
inventory.maxamount 28
}

actor PartyBomber_WepReady_P : CustomInventory
{
States
{
Pickup:
Ready2:
TNT1 A 0 A_JumpIfInventory("PartyBomber_F",1,"Ready4")
TNT1 A 0 A_JumpIfInventory("PartyPowerAmmo",150,"Ready3")
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
goto Ammo
Ready3:
TNT1 A 0 A_WeaponReady
goto Ammo
Ready4:
TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
TNT1 A 0 A_TakeInventory("PartyBomber_F",1)
goto Ammo

Ammo:
TNT1 A 0 A_GiveInventory("PartyPowerAmmo",2)
stop
}
}

actor PartyBomber_Fire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("PartyPowerAmmo",6)
TNT1 A 0 A_JumpIfInventory("PartyBomber_F",1,"Pickup2")
TNT1 A 0 A_PlaySound("PartyBomber/TossFire",1,0.875)//weapon/mbuster
TNT1 A 0 A_JumpIfInventory("IsBot",1,2)
TNT1 A 0 A_FireCustomMissile("HyperPartyBomb",0,0,8,0)
stop
TNT1 A 0 A_FireCustomMissile("HyperPartyBombBot",0,0,8,0)
stop
Pickup2:
TNT1 A 0 A_PlaySound("Pokemon/Present",4,0.75)
TNT1 A 0 A_GiveInventory("PartyBomber_Alt_P")
TNT1 A 0 A_TakeInventory("PartyBomber_F")
stop
}
}
actor PartyBomber_Alt_P : CustomInventory
{
States
{
Pickup:
//TNT1 A 0 A_TakeInventory("PartyPowerAmmo",25,1)
//TNT1 A 0 A_TakeInventory("PartyPowerAmmo",25)
//TNT1 A 0 A_PlaySound("Pokemon/Present",1)
TNT1 A 0 A_Jump(16,"Pick3")
TNT1 A 0 A_Jump(77,"Pick2")
TNT1 A 0 A_Jump(102,"Pick1")
Pick0:
TNT1 A 0 A_FireCustomMissile("PartyBomberPresent0",0,0,8,0)
stop
Pick1:
TNT1 A 0 A_FireCustomMissile("PartyBomberPresent1",0,0,8,0)
stop
Pick2:
TNT1 A 0 A_FireCustomMissile("PartyBomberPresent2",0,0,8,0)
stop
Pick3:

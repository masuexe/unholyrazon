actor BusterExpertShiny_W_NormalBar : NormalBar {Args 211, 112}

actor BusterExpertShiny_W : BaseMM8BDMWep_UH {
  Weapon.AmmoUse 0
  Weapon.AmmoGive 140
  Inventory.Pickupmessage "$PU_03"
  Obituary "$OB_03W"
  Tag "\c[UH03]*\c- Great Buster"
  Weapon.AmmoType "ManlyManAmmo"
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    7H03 [ 6
    loop

   Deselect:
    7H03 A 0
    goto DeselectSwap
   Select:
    7H03 A 0
    goto SelectSwap

   Ready:
    7H03 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", BUSTEREXPERT_SDYE)
    7H03 A 0 A_GunFlash("Flash", 1)
    goto Ready2

   Ready2:
    7H03 A 2 A_WeaponReady(WRF_NOSECONDARY)
    7H03 A 2 A_GiveInventory("BusterExpert_W_Ready_P")
    wait

   Fire:
    7H03 C 0 A_JumpIfInventory("IsBot", 1, "BotFire")
    7H03 C 0 A_PlaySound("weapon/mbuster", 1)
    7H03 C 0 A_FireCustomMissile("S_GreatShot", 0, 0, -8, 0)
    7H03 CCBBAAAAAAAA 2 A_GiveInventory("ManlyManAmmo", 2)
    Goto Ready2

   Flash:
    TNT1 A 1 A_JumpIfInventory("ManlyManAmmo", 35, 1)
    loop
    TNT1 A 1 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, 1)
    wait
    7H03 F 0 A_GunFlash(1)
    7H03 F 2 A_GiveInventory("S_BusterExpert_Alt_P")
    7H03 ED 2
    TNT1 A 2
    loop

   BotFire:
    7H03 B 0 A_JumpIfInventory("BotFlagDelay", 1, 3)
    7H03 B 0 A_GunFlash("OldFlash", 1)
    7H03 B 0 A_GiveInventory("BotFlagDelay", 1)
    7H03 B 0 A_JumpIfInventory("ManlyManAmmo", 35, 1)
    goto Fire+1
    7H03 B 0 A_Jump(16, "BotFireX")
    7H03 B 0 A_Jump(64, 1)
    goto Fire+1
    7H03 B 0 A_GiveInventory("BotFlag1", random(2, 5))
    goto Fire+1
   BotFireX:
    7H03 B 0 A_PlaySoundEx("classes/taunt/busterexpert", "Voice")
    7H03 B 0 A_PlaySound("weapon/mbuster", 1)
    7H03 B 0 A_FireCustomMissile("S_GreatShot", 0, 0, -8, 0)
    7H03 B 0 A_GiveInventory("Shocked", 1)
    7H03 B 0 A_Recoil(8)
    7H03 BCA 2
    7H03 B 0 A_PlaySound("weapon/mbuster", 1)
    7H03 B 0 A_FireCustomMissile("S_GreatShot", random(-7, -5), 0, 8, 0)
    7H03 B 0 A_Recoil(8)
    7H03 BCA 2
    7H03 B 0 A_PlaySound("weapon/mbuster", 1)
    7H03 B 0 A_FireCustomMissile("S_GreatShot", random(5, 7), 0, 8, 0)
    7H03 B 0 A_Recoil(8)
    7H03 BCA 2
    Goto Ready2

   OldFlash:
    TNT1 A 1 A_JumpIfInventory("BotFlag1", 1, 1)
    loop
    7H03 E 0 A_GunFlash(1)
    7H03 E 2 A_GiveInventory("S_BusterExpert_Alt_P")
    7H03 FD 2
    TNT1 A 1 A_TakeInventory("BotFlag1", 1)
    goto OldFlash
  }
}

actor S_BusterExpert_Alt_P : BusterExpert_Alt_P {
  States {
   Pickup:
    TNT1 A 0 A_FireCustomMissile("S_GreatShotAlt", random(-2, 2), 0, 8, 0)
    goto End
  }
}

actor S_GreatShot : GreatShot {
  Translation "192:192=211:211", "198:198=112:112", "199:199=106:106", "202:202=209:209"
  Damage (165)  // 110
  Args 165, 148, 20  // 110
}
actor S_GreatShotAlt : S_GreatShot {
  Damage (113)  // 75
  Radius 18
  Height 18
  Scale 2.5
  Args 150, 128, 20  // 100
}

actor StealthSniper : CustWepClassBase {
  player.scoreIcon "UMUG_23"
  player.displayname "StealthSniper"
  player.soundclass "StealthSniper"
  Player.Maxhealth 875
  health 875
  player.forwardmove 1.05, 1.05
  player.sidemove 1.05, 1.05
  player.jumpz 12
  Player.ColorRange 188, 200//192 198
  Player.StartItem "UH_BaseFlagPack"
  player.startitem "StealthSniper_W"
  player.startitem "StealthyAmmo", 28
  player.startitem "Steal_thyFakeDashAmmo", 28
  States {
   Spawn://SEAR
    1H23 A 0
    1H23 B 1
    1H23 A 1
    Goto Spawn+2
   See:
    1H23 BCDE 5
    Goto Spawn
   Missile:
    1H23 F 0 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    1H23 F 5
    1H23 G 4
    goto Spawn+2
   Missile2:
    1H23 J 9
    goto Spawn+2
   ClassPain: 1H23 H 0
    Goto MegamanPain

   ClassDeath:
    1H23 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H23 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H23 F 5
    1H23 H 0 A_SpawnItemEx("StealthSniperBlindShotDeath", 0, 0, 32, 0, 0, 3, 0, 1)
    1H23 H 0 A_PlaySound("assists_L/reggaecandrop", 1)
    1H23 G 4
    1H23 H 1
    Goto MegamanFade
   MegamanDisintegrate:
    1H23 Z 0 A_SpawnItemEx("Corpse_23", 0, 0, 0, momx, momy, momz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor StealthSniperShiny : StealthSniper {
  player.scoreIcon "UMUG_S23"
  Player.Maxhealth 2875
  health 2875
  Player.ColorRange 192, 198
  player.forwardmove 1.15, 1.15
  player.sidemove 1.15, 1.15
  player.jumpz 13
  player.morphweapon "StealthSniperShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    1H23 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H23 F 5
    1H23 H 0 A_SpawnItemEx("S_StealthSniperBlindShotDeath", 0, 0, 32, 0, 0, 3, 0, 1)
    1H23 H 0 A_PlaySound("assists_L/reggaecandrop", 1)
    1H23 G 4
    1H23 H 1
    Goto MegamanFade
  }
}

actor StealthSniperBlindShotDeath : StealthSniperBlindShot {
  Damage (50)
  Args 200, 448, 32
}
actor S_StealthSniperBlindShotDeath : StealthSniperBlindShotDeath {
  Damage (75)
  Args 300, 448, 32
}

actor Corpse_23 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_23_0", 0, -4, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_1", 0, 4, 36, momx+random(-2, 2), momy+frandom(-1, 1), momz+frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_2", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_3", 0, 0, 24, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_4", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_5", 0, 0, 28, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_6", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_7", 0, 0, 6, momx+frandom(-3, 3), momy+frandom(-3, 3), momz+frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


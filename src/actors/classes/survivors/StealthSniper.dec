actor StealthSniper : CustWepClassBase {
  Player.ScoreIcon "UMUG_23"
  Player.DisplayName "StealthSniper"
  Player.SoundClass "StealthSniper"
  Player.MaxHealth 875
  Health 875
  Player.ForwardMove 1.05, 1.05
  Player.SideMove 1.05, 1.05
  Player.JumpZ 12
  Player.ColorRange 188, 200  // 192 198
  Player.StartItem "UH_BaseFlagPack"
  Player.StartItem "StealthSniper_W"
  Player.StartItem "StealthyAmmo", 28
  Player.StartItem "Steal_thyFakeDashAmmo", 28
  States {
   Spawn:  // SEAR
    1H23 A 0
    1H23 B 1
    1H23 A 1
    goto Spawn+2
   See:
    1H23 BCDE 5
    goto Spawn
   Missile:
    1H23 F 0 A_JumpIfInventory("VivifyDelay3", 1, "Missile2")
    1H23 F 5
    1H23 G 4
    goto Spawn+2
   Missile2:
    1H23 J 9
    goto Spawn+2
   ClassPain:
    1H23 H 0
    goto MegamanPain

   ClassDeath:
    1H23 H 0
    goto MegamanDeath
   MegamanDeath0:
    1H23 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H23 F 5
    1H23 H 0 A_SpawnItemEx("StealthSniperBlindShotDeath", 0, 0, 32, 0, 0, 3, 0, 1)
    1H23 H 0 A_PlaySound("assists_L/reggaecandrop", 1)
    1H23 G 4
    1H23 H 1
    goto MegamanFade
   MegamanDisintegrate:
    1H23 Z 0 A_SpawnItemEx("Corpse_23", 0, 0, 0, velx, vely, velz, 0, 9)
    goto MegamanCorpseEnd
  }
}
actor StealthSniperShiny : StealthSniper {
  Player.ScoreIcon "UMUG_S23"
  Player.MaxHealth 2875
  Health 2875
  Player.ColorRange 192, 198
  Player.ForwardMove 1.15, 1.15
  Player.SideMove 1.15, 1.15
  Player.JumpZ 13
  Player.MorphWeapon "StealthSniperShiny_W"
  +NOSKIN
  States {
   MegamanDeath0:
    1H23 H 9 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    1H23 F 5
    1H23 H 0 A_SpawnItemEx("S_StealthSniperBlindShotDeath", 0, 0, 32, 0, 0, 3, 0, 1)
    1H23 H 0 A_PlaySound("assists_L/reggaecandrop", 1)
    1H23 G 4
    1H23 H 1
    goto MegamanFade
  }
}

actor StealthSniperBlindShotDeath : StealthSniperBlindShot {
  Damage (50)
  Args 200, 448, 32
}
actor S_StealthSniperBlindShotDeath : StealthSniperBlindShotDeath {
  Damage (75)
  Args 300, 448, 32
}

actor Corpse_23 : BasicWatcher {States {Spawn: TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("Corpse_23_0", 0, -4, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_1", 0, 4, 36, velx + random(-2, 2), vely + frandom(-1, 1), velz + frandom(2, 6), 0, 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_2", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_3", 0, 0, 24, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_4", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_5", 0, 0, 28, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_6", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    TNT1 A 0 A_SpawnItemEx("Corpse_23_7", 0, 0, 6, velx + frandom(-3, 3), vely + frandom(-3, 3), velz + frandom(1, 4), random(-5, 5), 169)
    stop
  }
}


actor PlainDemoneye_W : BaseUnholyBossWep {
  Tag "$TAG_DEye00_W"
  Obituary "%o was bitch slapped by %k the \ctDemoneye\c-!"
  States {
   Spawn:
    _E00 [ 6
    wait

   Ready:
    _E00 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", PLAIN_EYE_DYE)
    _E00 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 0)
    goto ReadyX
   ReadyX:
    _E00 A 2 A_WeaponReady
    Goto ReadyX

   Fire:
    _E00 A 1
    _E00 A 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    _E00 A 0 A_FireCustomMissile("PlainD_Slap", 0, 0, 8, 0)
    _E00 BC 2
    _E00 A 1 Offset(0, 72)
    _E00 A 1 Offset(0, 62) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E00 A 1 Offset(0, 52)
    _E00 A 1 Offset(0, 42) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E00 A 0 Offset(0, 32)
    Goto ReadyX
  }
}

actor PlaineyeEventProtect : PowerProtection {
  damagefactor "Plaineye", 0.0
  Powerup.Duration 0x7ffffffd
}

actor PlainD_Slap : BasicProjectile {
  Translation "192:192=246:246", "198:198=57:57"
  damagetype "Plaineye"
  Obituary "%o was bitch slapped by %k the \ctDemoneye\c-!"
  ReactionTime 1
  damage (125)
  Radius 10
  Height 10
  speed 55
  scale 2.5
  States {
   Spawn:
    X_7F ABC 1
    X_7F DE 2
    X_7F E 1 A_CountDown
    wait
   Crash:
   XDeath:
    TNT1 A 1
    stop
   Death:
    TNT1 A 1 A_Explode(125, 96, 0, 0, 8)
    stop
  }
}

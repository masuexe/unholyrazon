actor JoustDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG03"
  Player.SoundClass "jousteye"

  Player.MorphWeapon "JoustDemoneye_W"
  States {
   Spawn:
    _D03 A 0
    _D03 B 1
    _D03 A 1
    goto Spawn+2
   See:
    _D03 BCDE 5
    goto Spawn
   Missile:
    _D03 FFG 7
    goto Spawn+2
   ClassPain:
    _D03 H 0
    goto MegamanPain
   ClassDeath:
    _D03 H 0
    goto MegamanDeath
  }
}

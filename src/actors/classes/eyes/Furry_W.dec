actor FurryDemoneye_W : BaseUnholyBossWep {
  Tag "$TAG_DEye31_W"
  Obituary "%o was \cgSUPER\c- jealous of %k the \coFurry Demoneye\c-!"
  States {
   Spawn:
    _E31 [ 6
    wait

   Ready:
    _E31 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FURRY_EYE_DYE)
    _E31 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 31)
    goto ReadyX
   ReadyX:
    _E31 A 2 A_WeaponReady
    Goto ReadyX
   Fire:
    _E31 A 8 A_PlaySoundEx("weapon/noammo", "Weapon")
    Goto ReadyX
  }
}

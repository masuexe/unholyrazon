actor MLGDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG01"
  Player.SoundClass "mlgeye"

  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.MaxHealth 1500
  Health 1500
  Player.JumpZ 16

  damagefactor "Falling", 0.25
  Player.MorphWeapon "MLGDemoneye_W"
  States {
   Spawn:
    _D01 A 0
    _D01 B 1
    _D01 A 1
    goto Spawn+2
   See:
    _D01 BCDE 5
    goto Spawn
   Missile:
    _D01 G 4
    _D01 F 5
    goto Spawn+2
   ClassPain:
    _D01 H 0
    goto MegamanPain
   ClassDeath:
    _D01 H 0
    goto MegamanDeath
  }
}

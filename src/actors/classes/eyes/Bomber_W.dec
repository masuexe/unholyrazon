actor BomberDemoneyeFlag : Inventory
{
inventory.amount 1
inventory.maxamount 16
}

actor BomberDemoneyeColor_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("BomberDemoneyeFlag",99)
TNT1 A 0 A_Jump(6,"Pickup2")
TNT1 A 0 A_GiveInventory("BomberDemoneyeFlag",random(1,15))
stop
Pickup2:
TNT1 A 0 A_GiveInventory("BomberDemoneyeFlag",16)
stop
}
}

actor BomberE_Bomb : BasicProjectile
{
Obituary "%o tried to kick %k's \cjBomberman Demoneye\c- bomb!"
DamageType "Bombereye"
-NOGRAVITY
+SKYEXPLODE
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
bouncefactor 0.6
wallbouncefactor 0.05
bouncecount 5
reactiontime 15
Damage (150)
Radius 7
Height 8
Speed 23
scale 2.5
States
{
Spawn:
X_1D A 0
X_1D A 0 A_PlaySoundEx("misc_L/itemthrow","Body")
X_1D A 0 ThrustThingZ(0,4,0,1)
X_1D A 1
wait
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/BomberGB_Bomb","Weapon")//wep_L/hyperbomb
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_Explode(400,196,1,0,16)
TNT1 A 0 A_SpawnItemEx("OilPitIgnite",0,0,8)
TNT1 A 0 A_SpawnItemEx("BomberE_Fire",0,0,0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("BomberE_FireLine",0,0,0,50,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("BomberE_FireLine",0,0,0,50,0,0,90,1)
TNT1 A 0 A_SpawnItemEx("BomberE_FireLine",0,0,0,50,0,0,-90,1)
TNT1 A 0 A_SpawnItemEx("BomberE_FireLine",0,0,0,50,0,0,180,1)
X_1D BCDEFGHIJKLMN 1
Stop
}
}

actor BomberE_FireLine : BasicProjectile
{
DamageType "Bombereye"
Obituary "%o was burnt by %k the \cjBomberman Demoneye\c-!"
+FLOORHUGGER
+DONTREFLECT
+THRUACTORS
+DONTSPLASH
+DONTBLAST
Damage (0)
Radius 10
Height 50
Speed 0
Scale 2.0
States
{
Spawn:
TNT1 A 1 A_SpawnItemEx("BomberE_Fire",0,0,0,0,0,0,0,1)
Loop
}
}

Actor BomberE_Fire : BomberE_FireLine
{
RenderStyle Translucent
alpha 0.8
States
{
Spawn:
6P10 A 2
6P10 A 1
6P10 BCDABCDABCDABCDABCDA 2 A_Explode(85,36,1,0,4)
stop
}
}




actor FoxDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye30_W"
Obituary "%o was jealous of %k the \ciFox Demoneye\c-!"
States
{
Spawn:
_E30 [ 6
wait

Ready0:
_E30 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", FOX_EYE_DYE)
_E30 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 30)
goto ReadyX
ReadyX:
_E30 A 2 A_WeaponReady
Goto ReadyX

Fire:
_E30 C 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
_E30 A 0 A_FireCustomMissile("FoxD_Slap",0,0,8,0)
_E30 B 2
_E30 C 2
TNT1 A 2
_E30 A 1 A_Refire
Goto ReadyX
}
}

actor FoxD_Slap : BasicProjectile
{
Translation "192:192=218:218","198:198=219:219"
damagetype "Foxeye"
Obituary "%o was jealous of %k the \ciFox Demoneye\c-!"
ReactionTime 1
damage (1000)
Radius 10
Height 10
speed 55
scale 3.0
States
{
Spawn:
X_7F ABC 1
X_7F DE 2
X_7F E 1 A_CountDown
wait
Crash:
XDeath:
TNT1 A 1
stop
Death:
TNT1 A 1 A_Explode(1000,96,0,0,8)
stop
}
}


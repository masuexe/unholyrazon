Actor RichDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye06_W"
Obituary "%o was envious of %k the \cdRich Demoneye\c-!"
States
{
Spawn:
_E06 [ 6
wait

Ready0:
_E06 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", RICH_EYE_DYE)
_E06 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 6)
goto ReadyX
ReadyX:
_E06 A 2 A_WeaponReady
_E06 A 0 A_GiveInventory("DemoneyeAmmo",2)
Goto ReadyX
Fire:
_E06 B 1 A_PlaySoundEx("items/MoneyUse", "Weapon")
_E06 B 1 A_FireCustomMissile("Rich_Moola",-30,0,0,0)
_E06 B 1 A_FireCustomMissile("Rich_Moola",-15,0,0,0)
_E06 C 1 A_FireCustomMissile("Rich_Moola",0,0,0,0)
_E06 C 0 A_FireCustomMissile("RichE_Boom",0,0,0,0)
_E06 C 1 A_FireCustomMissile("Rich_Moola",15,0,0,0)
_E06 C 1 A_FireCustomMissile("Rich_Moola",30,0,0,0)

TNT1 A 110
_E06 A 2 Offset(0,112)
_E06 A 2 Offset(0,92)
_E06 A 2 Offset(0,72)
_E06 A 2 Offset(0,52)
Goto ReadyX
}
}

actor RichE_Boom : BasicExplosion
{
damagetype "Richeye"
Obituary "%o was envious of %k the \cdRich Demoneye\c-!"
States
{
Spawn:
TNT1 A 0 
TNT1 A 1 A_Explode(175,182,0,0,24)
stop
}
}


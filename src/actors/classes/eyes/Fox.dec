actor FoxDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG30"
  Player.SoundClass "foxeye"
  Player.DamageScreenColor "orange"
  Player.ForwardMove 1.75, 1.75
  Player.SideMove 1.75, 1.75
  Player.MaxHealth 1750
  Health 1750
  Player.JumpZ 16

  damagefactor "Eyelentoeye", 3.0
  damagefactor "EyelentoMajor", 3.0
  damagefactor "RichDevilCash", 20.0
  damagefactor "RicheyeCash", 20.0
  damagefactor "DevilCash", 20.0
  damagefactor "MoneyBaitCash", 20.0
  damagefactor "MoneyBombCash", 20.0
  Player.MorphWeapon "FoxDemoneye_W"
  States {
   Spawn:
    _D30 A 0
    _D30 B 1
    _D30 A 1
    goto Spawn+2
   See:
    _D30 BCDE 5
    goto Spawn
   Missile:
    _D30 F 4
    _D30 G 5
    goto Spawn+2
   ClassPain:
    _D30 H 0
    goto MegamanPain
   ClassDeath:
    _D30 H 0
    goto MegamanDeath
  }
}

actor FoxDemoneye300 : FoxDemoneye {
  Player.MorphWeapon "FoxDemoneye300_W"
}

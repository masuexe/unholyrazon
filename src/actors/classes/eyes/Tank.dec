actor TankDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG10"
  Player.SoundClass "tankeye"

  Player.ColorRange 192, 198  // Method A didn't workout.
  Player.ForwardMove 1.0, 1.0
  Player.SideMove 1.0, 1.0
  Player.MaxHealth 1250
  Health 1250

  Player.MorphWeapon "TankDemoneye_W"
  States {
   Spawn:
    _D10 A 0
    _D10 B 1
    _D10 A 1
    goto Spawn+2
   See:
    _D10 AB 5
    goto Spawn
   Missile:
    _D10 B 4
    _D10 A 5
    goto Spawn+2
   ClassPain:
    _D10 H 0
    goto MegamanPain
   ClassDeath:
    _D10 H 0
    goto MegamanDeath
   MegamanDeath0:
    _D10 HHH 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    _D10 H 0 A_PlaySoundEx("wep_L/mm4/drillbombexplode", "Weapon")
    _D10 HHH 1 A_SpawnItemEx("BasicBoom4FX_ColorX", random(-90, 50), random(-90, 90), random(-30, 90), 0, 0, 0, 0, 1)
    _D10 H 0 A_PlaySoundEx("wep_L/mm4/drillbombexplode", "Weapon")
    _D10 HHH 1 A_SpawnItemEx("BasicBoom4FX_ColorX", random(-90, 50), random(-90, 90), random(-30, 90), 0, 0, 0, 0, 1)
    _D10 H 0 A_PlaySoundEx("wep_L/mm4/drillbombexplode", "Weapon")
    _D10 HHH 1 A_SpawnItemEx("BasicBoom4FX_ColorX", random(-90, 50), random(-90, 90), random(-30, 90), 0, 0, 0, 0, 1)
    _D10 H 0 A_PlaySoundEx("wep_L/mm4/drillbombexplode", "Weapon")
    _D10 HHH 1 A_SpawnItemEx("BasicBoom4FX_ColorX", random(-90, 50), random(-90, 90), random(-30, 90), 0, 0, 0, 0, 1)
    goto MegamanErase
  }
}

actor EyelentoDemoneye_W_NormalBar : NormalBar {args 229, 222}

actor EyelentoDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye11_W"
Obituary "%o was poked by %k the \cfEyelento\c-'s Baton."
Weapon.AmmoType "UnholyBossAmmo100"
States
{
Spawn:
_E11 [ 6
wait

Ready:
_E11 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", EYELENTO_EYE_DYE)
8L01 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 11)
goto ReadyX
ReadyX:
8L01 A 0 A_JumpIfInventory("UnholyBossAmmo100",100,"ReadyXTrue")
8L01 A 2 A_WeaponReady(WRF_NOSECONDARY)
8L01 A 0 A_GiveInventory("UnholyBossAmmo100",2) //2
Goto ReadyX
ReadyXTrue:
8L01 A 2 A_WeaponReady
Goto ReadyXTrue

/*Fire:
8L01 B 0 A_PlaySoundEx("Bat_Rob/Short_P","Weapon")
8L01 B 1 A_CustomPunch(random(150,200),1,0,"EyelentoD_Puff",192)
8L01 BCB 2
8L01 A 4
Goto ReadyX*/
Fire:
8L01 A 1 offset(-2,40) A_GiveInventory("UnholyBossAmmo100",1)
8L01 A 1 offset(-4,44) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-6,52)
8L01 A 1 offset(-10,60) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-18,70)
8L01 A 1 offset(-24,78) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-30,90)
8L01 A 1 offset(-38,110) A_GiveInventory("UnholyBossAmmo100",1)
TNT1 A 4 A_WeaponReady(14) //9
Goto FireContinue
FireContinue: 
TNT1 A 0 A_PlaySoundEx("weapon/tengudash","Weapon")
8L01 C 1 offset(-114,60)
//8L01 D 1 offset(-98,54)
8L01 E 1 offset(-72,50)
//8L01 C 1 offset(-66,48)
8L01 D 1 offset(-60,44)
//8L01 E 1 offset(-56,40)
8L01 C 1 offset(-54,38) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0) //
//8L01 D 1 offset(-52,36) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0) //
8L01 E 1 offset(-50,35) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
//8L01 C 1 offset(-49,34) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
8L01 D 1 offset(-48,33) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
//8L01 E 1 offset(-47,33) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
8L01 C 1 offset(-46,34) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
//8L01 D 1 offset(-44,36) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0)
8L01 E 1 offset(-42,38) A_FireCustomMissile("EyelentoD_Puff",0,0,8,0) //
//8L01 C 1 offset(-40,40)
8L01 D 1 offset(-34,44)
//8L01 E 1 offset(-26,50)
8L01 C 1 offset(-14,58)
//8L01 D 1 offset(2,68)
8L01 E 1 offset(24,80)
TNT1 A 8 A_WeaponReady(14)
Goto FireEnd
FireEnd:
8L01 A 1 offset(-38,110) A_GiveInventory("UnholyBossAmmo100",1)
8L01 A 1 offset(-36,104) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-30,96)
8L01 A 1 offset(-20,72) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-14,60)
8L01 A 1 offset(-10,50) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-8,42)
8L01 A 1 offset(-6,38) A_GiveInventory("UnholyBossAmmo100",1)
//8L01 A 1 offset(-4,36) 
8L01 A 1 offset(-2,34) A_GiveInventory("UnholyBossAmmo100",1)
8L01 A 2 A_WeaponReady(14)
goto ReadyX




/*AltFire:
8L01 B 0 A_PlaySoundEx("weapon/mbuster","Weapon")
8L01 B 0 A_FireCustomMissile("EyelentoD_Grenade",0,0,8,0)
8L01 BCB 3
8L01 A 10
goto ReadyX*/
Altfire:
8L01 A 1 offset(-2,40) 
8L01 A 1 offset(-4,44)
//8L01 A 1 offset(-6,52)
8L01 A 1 offset(-10,60)
//8L01 A 1 offset(-24,78)
8L01 A 1 offset(-38,110)
TNT1 A 2 A_WeaponReady(14)
Granatto:
8L01 G 0 A_TakeInventory("UnholyBossAmmo100",100)
8L01 G 1 Offset(-60,140)
8L01 G 1 Offset(-56,134)
8L01 G 1 Offset(-48,128)
//8L01 G 1 Offset(-40,120)
8L01 G 1 Offset(-10,70)
//8L01 G 1 Offset(30,30) 
8L01 G 1 Offset(70,-10) A_FireCustomMissile("EyelentoD_Grenade",0,0,8,0)
//8L01 G 1 Offset(110,-20) 
8L01 G 1 Offset(150,-28)
//8L01 G 1 Offset(170,-36)
8L01 G 1 Offset(180,-40)
//8L01 G 1 Offset(198,-43)
8L01 G 1 Offset(206,-45)
//8L01 G 1 Offset(214,-47)
8L01 G 1 Offset(222,-48)
//8L01 G 1 Offset(230,-49)
TNT1 A 8 A_WeaponReady(14)
NoMoreGranatto:
8L01 A 1 offset(-38,110) 
8L01 A 1 offset(-36,104) 
//8L01 A 1 offset(-30,96) 
8L01 A 1 offset(-20,72) 
//8L01 A 1 offset(-14,60) 
8L01 A 1 offset(-10,50) 
//8L01 A 1 offset(-8,42) 
8L01 A 1 offset(-6,38)
//8L01 A 1 offset(-4,36) 
8L01 A 1 offset(-2,34) 
8L01 A 0 A_ClearRefire
8L01 A 2 A_WeaponReady(14)
Goto ReadyX
}
}

//
actor EyelentoD_Grenade : BasicProjectile
{
Translation "192:192=106:106", "198:198=132:132"
Damagetype "Eyelentoeye"
Obituary "%o died from %k the \cfEyelento\c-'s Grenade."
-NOGRAVITY
+SKYEXPLODE
+HEXENBOUNCE
-ALLOWBOUNCEONACTORS
+CANBOUNCEWATER
bouncefactor 0.65
wallbouncefactor 0.65
bouncecount 4 
reactiontime 6 
Damage (75) 
Radius 9
Height 10
speed 30 
scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 ThrustThingZ(0,35,0,1)
TNT1 A 0 A_Jump(256,2,3,4,5)
8T01 A 0 A_CountDown
8T01 ABCD 4
Goto Spawn+3
Death:
TNT1 A 0
TNT1 A 0 A_Stop
TNT1 A 0 A_SpawnItemEx("EyelentoD_GrenadeBoom")
stop
}
}

actor EyelentoD_GrenadeBoom : BasicExplosion
{
Translation "192:192=215:215", "198:198=221:221"
Damagetype "Eyelentoeye"
Obituary "%o died from %k the \cfEyelento\c-'s Grenade."
Scale 2.5
States
{
Spawn:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySound("drillexplode",2,0.75)
TNT1 A 0 Radius_Quake(4,10,0,16,0)
TNT1 A 1 A_Explode(random(125,150),92,0,0,92)
X_8B ABCDEF 2 A_SpawnItemEx("EyelentoD_GrenadeBoom_X",random(-120,120),random(-120,120),random(-96,96),0,0,0,0,1)
stop
}
}

actor EyelentoD_GrenadeBoom_X : BasicExplosion
{
Translation "192:192=215:215", "198:198=221:221"
Damagetype "Eyelentoeye"
Obituary "%o died from %k the \cfEyelento\c-'s Grenade."
Scale 1.5
States
{
Spawn:
TNT1 A 0 A_Stop
TNT1 A 0 A_PlaySoundEx("weapon/crackerexplode","Weapon")
TNT1 A 0 A_Explode(random(20,25),96,0,0,32)
X_8B ABCDEF 2 A_Fadeout(0.08)
stop
}
}


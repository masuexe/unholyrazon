actor GhostDemoneye_W_NormalBar : NormalBar {args 4, 193}

actor GhostDemoneye_W : BaseUnholyBossWep {
  Tag "$TAG_DEye02_W"
  Obituary "%o was scared by %k the \cmGhost Demoneye\c-!"
  Weapon.AmmoType "UnholyBossAmmo400"
  States {
   Spawn:
    _E02 [ 6
    wait

   Ready:
    _E02 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", GHOST_EYE_DYE)
    _E02 D 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 2)
    _E02 D 0  // Initial setup: uh_DemoneyeMorph.
    goto ReadyX
   ReadyX:
    _E02 D 0 A_JumpIfInventory("UnholyBossAmmo400", 400, "ReadyX2")
    _E02 D 2 A_WeaponReady(8)
    _E02 D 0 A_GiveInventory("UnholyBossAmmo400", 3)
    loop
   ReadyX2:
    _E02 D 2 A_WeaponReady
    _E02 D 0 A_GiveInventory("UnholyBossAmmo400", 3)
    loop
   ReadyX3:
    _E02 D 0 A_TakeInventory("UnholyBossAmmo400", 3)
    _E02 D 1 A_WeaponReady(8)
    _E02 D 0 A_JumpIfInventory("UnholyBossAmmo400", 1, "ReadyX3")
    _E02 D 0 A_GiveInventory("GhostEyeInvisOff_P")
    goto ReadyX

   Fire:
    _E02 E 0 A_PlaySoundEx("weapon/slashclaw", "Weapon")
    _E02 E 0 A_FireCustomMissile("GhostD_Slap", 0, 0, -24, 0)
    _E02 E 0 A_FireCustomMissile("GhostD_SlapR", 0, 0, 24, 0)
    _E02 E 2 A_GiveInventory("GhostEyeInvisOff_P")
    _E02 F 2
    _E02 F 2 Offset(4, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 Offset(8, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 Offset(4, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 A_WeaponReady(14)
    _E02 F 2 Offset(-4, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 Offset(-8, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 Offset(-4, 0) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 F 2 A_WeaponReady(14)
    _E02 E 2 A_GiveInventory("UnholyBossAmmo400", 2)
    TNT1 A 2 A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 D 2 Offset(0, 112) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 D 2 Offset(0, 92) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 D 2 Offset(0, 72) A_GiveInventory("UnholyBossAmmo400", 2)
    _E02 D 2 Offset(0, 52) A_GiveInventory("UnholyBossAmmo400", 2)
    goto ReadyX
   Altfire:
    _E02 E 0 A_PlaySoundEx("wep/DeluxeBooFlee", "Body")
    _E02 E 0 A_JumpIfInventory("GhostEyeShadowInvis", 1, 3)
    _E02 E 0 A_GiveInventory("GhostEyeInvisOn_P")
    _E02 E 0 A_SpawnItemEx("GhostD_InvisFX_H", 0, 0, 0, 0, 0, 0, 0, 1)
    _E02 EF 2 A_TakeInventory("UnholyBossAmmo400", 5)
    TNT1 A 2 A_TakeInventory("UnholyBossAmmo400", 5)
    _E02 D 2 Offset(0, 112) A_TakeInventory("UnholyBossAmmo400", 5)
    _E02 D 2 Offset(0, 72) A_TakeInventory("UnholyBossAmmo400", 5)
    goto ReadyX3
  }
}

actor GhostDemoneyeFlag : Inventory {
  Inventory.MaxAmount 400
}

actor GhostEyeInvisGiver : PowerApropGiver {}
actor GhostEyeInvis : Base_UH_PropertyPower {}
actor GhostEyeShadowInvisGiver : PowerApropGiver {}
actor GhostEyeShadowInvis : Base_UH_PropertyPower {}

actor GhostEyeInvisOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("CloakFlag")
    TNT1 A 0 A_GiveInventory("GhostEyeInvisGiver")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer", 0, true)  // mmrf maps
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
    stop
  }
}

actor GhostEyeInvisOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CloakFlag", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("GhostEyeInvis", 1, 1)
    stop
    TNT1 A 0 A_TakeInventory("CloakFlag")
    TNT1 A 0 A_TakeInventory("CloakFlagDelay")
    TNT1 A 0 A_TakeInventory("GhostEyeInvis")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
    stop
  }
}

actor GhostEyeShadowInvisOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("CloakFlag")
    TNT1 A 0 A_GiveInventory("GhostEyeShadowInvisGiver")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer", 0, true)  // mmrf maps
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_shadowplayer", 0, true)
    TNT1 A 0 A_GiveInventory("GhostShadowInvisFlag", 1050)
    TNT1 A 0 A_SpawnItemEx("GhostD_ShadowInvis_H")
    stop
  }
}

actor GhostEyeShadowInvisOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("CloakFlag", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInventory("GhostEyeShadowInvis", 1, 1)
    stop
    TNT1 A 0 A_TakeInventory("CloakFlag")
    TNT1 A 0 A_TakeInventory("CloakFlagDelay")
    TNT1 A 0 A_TakeInventory("GhostEyeShadowInvis")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cloakplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_cantseekplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_dontidentifytargetplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_shadowplayer", 0, false)
    stop
  }
}

actor GhostShadowInvisFlag : Inventory {
  Inventory.MaxAmount 1050
}

actor GhostD_ShadowInvis_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("GhostShadowInvisFlag", 1, "Take")
    TNT1 A 0 A_GiveInventory("GhostEyeShadowInvisOff_P", 1, 2)
    stop
   Take:
    TNT1 A 1 A_TakeInventory("GhostShadowInvisFlag", 1, 0, 2)
    goto Spawn
  }
}


actor GhostD_Slap : PlainD_Slap {
  Translation "192:192=4:4", "198:198=193:193"
  DamageType "Ghosteye"
  Obituary "%o was scared by %k the \cmGhost Demoneye\c-!"
  // +SHADOW
  Damage (165)  // 500
  States {
   Death:
    TNT1 A 1 A_Explode(165, 96, 0, 0, 8)
    stop
  }
}
actor GhostD_SlapR : GhostD_Slap {
  States {
   Spawn:
    X_7F FGH 1
    X_7F IJ 2
    X_7F J 1 A_CountDown
    wait
  }
}

actor GhostD_InvisFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_SpawnItemEx("GhostD_InvisFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor GhostD_InvisFX : BasicClientSide {
  var int user_add;
  ReactionTime 12
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetUserVar("user_add", user_add + 30)
    TNT1 A 0 A_SpawnItemEx("GhostD_InvisFX2", random(12, 24), 0, random(14, 42), frandom(1, 3), 0, frandom(1, 3), random(0, 29) + user_add, 33, 32)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("GhostD_InvisFX2", 0, 0, 32, 0, 0, 4, random(0, 7) * 45, 33)
    stop
  }
}

actor GhostD_InvisFX2 : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(frandom(1.0, 1.5))
   Spawn2:
    _D02 D 1 A_FadeTo(0.1, 0.08, 1)
    loop
  }
}

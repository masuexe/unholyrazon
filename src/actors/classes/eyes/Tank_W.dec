    _I10 X 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30047, 1)
    goto ReadyX
   RareAppearance50:
    _J10 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30048, 1)
    goto ReadyX
   RareAppearance51:
    _J10 B 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30049, 1)
    goto ReadyX
   RareAppearance52:
    _J10 C 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30050, 1)
    goto ReadyX
   RareAppearance53:
    _J10 D 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30051, 1)
    goto ReadyX
   RareAppearance54:
    _J10 E 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30052, 1)
    goto ReadyX
   RareAppearance55:
    _J10 F 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30053, 1)
    goto ReadyX
   RareAppearance56:
    _J10 G 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30054, 1)
    goto ReadyX
   RareAppearance57:
    _J10 H 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30055, 1)
    goto ReadyX
   RareAppearance58:
    _J10 I 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30056, 1)
    goto ReadyX
   RareAppearance59:
    _J10 J 1 ACS_NamedExecuteWithResult("core_weaponcolor", 30057, 1)
    goto ReadyX
   ReadyRareX:
    _E10 YY 1 ACS_NamedExecuteWithResult("core_weaponcolor", TANK_EYE_DYE, 1)
    goto ReadyX

   ReadyX:
    "####" "#" 0 A_JumpIfInventory("TankDemoneyeFlag", 1, 4)
    "####" "#" 0
    "####" "#" 0 A_GiveInventory("TankDemoneyeFlag")
    "####" "#" 2
    "####" "#" 2 A_WeaponReady(8)
    wait

   Fire:
    "####" "#" 2 Offset(0, 47) A_GiveInventory("TankEyeFire_P")
    "####" "#" 2 Offset(0, 62)
    "####" "#" 2 Offset(0, 57)
    "####" "#" 2 Offset(0, 52)
    "####" "#" 2 Offset(0, 47)
    "####" "#" 2 Offset(0, 42)
    "####" "#" 2 Offset(0, 37)
    "####" "#" 2 Offset(0, 37)
    "####" "#" 0 A_WeaponReady(14)
    "####" "#" 13
    goto ReadyX+4

   Flash:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
    TNT1 A 1 A_GiveInventory("TankEyeFlash_P")
    loop
  }
}

actor TankDemoneyeFlag : Once {}

actor TankEyeCharge_F : Inventory {
  Inventory.MaxAmount 100
}
actor TankEyeWasThrusted : Once {}

actor TankEyeHoverSnd_D : Powerup {
  Powerup.Duration 4
}

actor TankEyeFlash_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("TankEyeWasThrusted", 1, "PickupAir")
    // TNT1 A 0 A_JumpIfInventory("FlightDisableFlag",1,"LandAmmo")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo400", 1, "HoverCheck")
    goto LandAmmo
   HoverCheck:
    TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "HoverCheckFalling")
    goto LandAmmo
   HoverCheckFalling:
    TNT1 A 0 A_JumpIf(velz < 0, "Hover")
    goto LandAmmo

   LandAmmo:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, "LandAmmoR")
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo400", 5)
    goto ResetSpeed
   LandAmmoR:
    TNT1 A 0 A_GiveInventory("UnholyBossAmmo400", 10)
    goto ResetSpeed

   ResetSpeed:
    TNT1 A 0 A_TakeInventory("UH_185_SpeedPower")
    goto GiveAmmo

   Hover:
    TNT1 A 0  // A_GiveInventory("IsHovering",1)
    TNT1 A 0 A_GiveInventory("TankEyeWasThrusted")
    TNT1 A 0 ThrustThingZ(0, 1, 1, 0)

    TNT1 A 0 A_JumpIfInventory("TankEyeHoverSnd_D", 1, 6)
    TNT1 A 0 A_PlaySound("wep_L/TankEye_Boost", 4, 0.325)  // Body
    TNT1 A 0 A_GiveInventory("TankEyeHoverSnd_D")
    TNT1 A 0 A_GiveInventory("TankEyeHoverFX_P")
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo400", 2, 1)
    TNT1 A 0 A_TakeInventory("UnholyBossAmmo400", 2)
    TNT1 A 0 A_JumpIfInventory("UH_185_SpeedPower", 1, 2)
    TNT1 A 0 A_GiveInventory("UH_185_SpeedPowerGiver")
    TNT1 A 0
    goto GiveAmmo

   FoundGround:
    TNT1 A 0 A_TakeInventory("TankEyeWasThrusted")
    goto Pickup+2

   PickupAir:
    TNT1 A 0 A_JumpIf(CallACS("core_CheckFooting"), "FoundGround")
    // TNT1 A 0 A_JumpIfInventory("FlightDisableFlag",1,"TakeHover")
    TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo400", 1, "HoverCheck2")
    goto TakeHover
   HoverCheck2:
    TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "HoverCheckFalling")
    goto TakeHover
   HoverCheckFalling2:
    TNT1 A 0 A_JumpIf(velz < 0, "Hover")
    goto TakeHover

   TakeHover:
    TNT1 A 0  // A_TakeInventory("IsHovering")
    goto ResetSpeed

   GiveAmmo:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_GiveInventory("TankEyeCharge_F", 1)
    stop
    TNT1 A 0 A_GiveInventory("TankEyeCharge_F", 2)
    stop
  }
}

actor TankEyeHoverFX_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("TankEyeHoverFX", 0, 0, -12, 0, 0, -3, 0, 33)
    stop
  }
}

actor TankEyeFire_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("S3_K/SpikeMine", "Weapon")
    // TNT1 A 0 A_FireCustomMissile("TankE_Shot",0,0,0,0)
    TNT1 A 0 A_JumpIfInventory("TankEyeCharge_F", 0, 3)
    TNT1 A 0 A_TakeInventory("TankEyeCharge_F")
    TNT1 A 0 A_SpawnItemEx("TankE_Shot", cos(-pitch) * 2, 0, 32 + (sin(-pitch) * 2), cos(-pitch) * 65, 0, sin(-pitch) * 65, 0, 1 | 32)  // |SXF_TRANSFERPITCH
    stop
    TNT1 A 0 A_SpawnItemEx("TankE_ShotFling", cos(-pitch) * 2, 0, 32 + (sin(-pitch) * 2), cos(-pitch) * 65, 0, sin(-pitch) * 65, 0, 1 | 32)
    TNT1 A 0 A_TakeInventory("TankEyeCharge_F")
    stop
  }
}


actor TankEyeHoverFX : BasicClientSide {
  // Scale 1.0
  XScale 1.25
  YScale 0.75
  States {
   Spawn:
    X_0E S 0
    X_0E S 0 A_Jump(256, 1, 2)
    X_0E S 1
    goto SpawnL
    X_0E T 1
    goto SpawnL
   SpawnL:
    X_0E "#######" 1 A_SetScale(scaleX - 0.125, scaleY - 0.085)
    stop
  }
}

actor TankE_Shot : BasicProjectile {
  DamageType "Tankeye"
  Obituary "%o was eradicated by %k the \cuTank Demoneye\c-!"
  +FORCEXYBILLBOARD
  +SKYEXPLODE
  +EXPLODEONWATER
  -NOGRAVITY
  Damage (random(95, 175))
  Radius 16
  Height 16
  Speed 65
  Scale 3.5
  States {
   Spawn:
    TNT1 A 0
    TMFX A 2 ThrustThingZ(0, 24, 0, 1)
    TMFX BA 2
    goto Spawn+2
   Crash:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 Radius_Quake(3, 35, 0, 2, 0)
    TNT1 A 0 A_Explode(65, 156, 0, 0, 16)
    X_8B ABCDEF 2
    TNT1 A 6
    stop
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_SpawnItemEx("DTank_ShotBoom", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
  }
}

actor TankE_ShotFling : TankE_Shot {
  DamageType "TankeyeFling"
  States {
   Spawn:
    TNT1 A 0
    TMFX A 2 ThrustThingZ(0, 24, 0, 1)
    TMFX A 1 A_SpawnItemEx("TankE_ShotFlingFX", 0, 0, 0, 0, 0, 0, 0, 1)
    wait
   Death:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode", "Weapon")
    TNT1 A 0 A_SetGravity(0.0)
    TNT1 A 0 A_SpawnItemEx("DTank_ShotFlingBoom", 0, 0, 0, 0, 0, 0, 0, 1)
    TNT1 A 1
    stop
  }
}
actor TankE_ShotFlingFX : BasicGraphicEffect {
  +FORCEXYBILLBOARD
  RenderStyle "Add"
  Alpha 1.0
  Scale 3.0
  States {
   Spawn:
    TMFX BBBBBCCCC 1 A_FadeOut(0.05)
    stop
  }
}

actor DTank_ShotBoom : BasicExplosion {
  DamageType "Tankeye"
  Obituary "%o was eradicated by %k the \cuTank Demoneye\c-!"
  +FORCEXYBILLBOARD
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm7/wildcoilexplode", "Weapon")
    TNT1 A 0 A_Explode(random(95, 175), 128, 0, 0, 8)
    X_8B ABCDEF 2
    stop
  }
}

actor DTank_ShotFlingBoom : DTank_ShotBoom {
  DamageType "TankeyeFling"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("wep_L/mm7/wildcoilexplode", "Weapon")
    TNT1 A 0 A_Explode(random(150, 245), 160, 0, 0, 12)
    X_8B ABCDEF 2
    stop
  }
}

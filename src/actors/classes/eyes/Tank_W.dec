actor TankDemoneyeFlag : UOnce {}

actor TankEyeCharge_F : Inventory
{
inventory.amount 1
inventory.maxamount 100
}
actor TankEyeWasThrusted : Inventory {}

actor TankEyeHoverSnd_D : Powerup
{
Powerup.Duration 4
}

actor TankEyeFlash_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0
TNT1 A 0 A_JumpIfInventory("TankEyeWasThrusted",1,"PickupAir")
//TNT1 A 0 A_JumpIfInventory("FlightDisableFlag",1,"LandAmmo")
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo400",1,"HoverCheck")
goto LandAmmo
HoverCheck:
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "HoverCheckFalling")
goto LandAmmo
HoverCheckFalling:
TNT1 A 0 A_JumpIf(momz<0,"Hover")
goto LandAmmo

LandAmmo:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,"LandAmmoR")
TNT1 A 0 A_GiveInventory("UnholyBossAmmo400",5)
goto ResetSpeed
LandAmmoR:
TNT1 A 0 A_GiveInventory("UnholyBossAmmo400",10)
goto ResetSpeed

ResetSpeed:
TNT1 A 0 A_TakeInventory("UH_185_SpeedPower")
goto GiveAmmo

Hover:
TNT1 A 0 //A_GiveInventory("IsHovering",1)
TNT1 A 0 A_GiveInventory("TankEyeWasThrusted",1)
TNT1 A 0 ThrustThingZ(0,1,1,0)

TNT1 A 0 A_JumpIfInventory("TankEyeHoverSnd_D",1,6)
TNT1 A 0 A_PlaySound("wep_L/TankEye_Boost",4,0.325)//Body
TNT1 A 0 A_GiveInventory("TankEyeHoverSnd_D",1)
TNT1 A 0 A_GiveInventory("TankEyeHoverFX_P")
TNT1 A 0 A_TakeInventory("UnholyBossAmmo400",2,1)
TNT1 A 0 A_TakeInventory("UnholyBossAmmo400",2)
TNT1 A 0 A_JumpIfInventory("UH_185_SpeedPower",1,2)
TNT1 A 0 A_GiveInventory("UH_185_SpeedPowerGiver",1)
TNT1 A 0
goto GiveAmmo

FoundGround:
TNT1 A 0 A_TakeInventory("TankEyeWasThrusted")
goto Pickup+2

PickupAir:
TNT1 A 0 A_JumpIf(z-floorz<=0,"FoundGround")
//TNT1 A 0 A_JumpIfInventory("FlightDisableFlag",1,"TakeHover")
TNT1 A 0 A_JumpIfInventory("UnholyBossAmmo400",1,"HoverCheck2")
goto TakeHover
HoverCheck2:
TNT1 A 0 A_JumpIf(CallACS("uh_GetPointerButtonInput", 0, 1) & BT_ALTATTACK, "HoverCheckFalling")
goto TakeHover
HoverCheckFalling2:
TNT1 A 0 A_JumpIf(momz<0,"Hover")
goto TakeHover

TakeHover:
TNT1 A 0 //A_TakeInventory("IsHovering")
goto ResetSpeed

GiveAmmo:
TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage",1,2)
TNT1 A 0 A_GiveInventory("TankEyeCharge_F",1)
stop
TNT1 A 0 A_GiveInventory("TankEyeCharge_F",2)
stop
}
}

actor TankEyeHoverFX_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_SpawnItemEx("TankEyeHoverFX",0,0,-12,0,0,-3,0,33)
stop
}
}

actor TankEyeFire_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_PlaySoundEx("S3_K/SpikeMine","Weapon")
//TNT1 A 0 A_FireCustomMissile("TankE_Shot",0,0,0,0)
TNT1 A 0 A_JumpIfInventory("TankEyeCharge_F",0,3)
TNT1 A 0 A_TakeInventory("TankEyeCharge_F")
TNT1 A 0 A_SpawnItemEx("TankE_Shot",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*65,0,sin(-pitch)*65,0,1|32)//|SXF_TRANSFERPITCH
stop
TNT1 A 0 A_SpawnItemEx("TankE_ShotFling",cos(-pitch)*2,0,32+(sin(-pitch)*2),cos(-pitch)*65,0,sin(-pitch)*65,0,1|32)
TNT1 A 0 A_TakeInventory("TankEyeCharge_F")
stop
}
}


actor TankEyeHoverFX : BasicClientSide
{
//Scale 1.0
XScale 1.25
YScale 0.75
States
{
Spawn:
X_0E S 0
X_0E S 0 A_Jump(256,1,2)
X_0E S 1
goto SpawnL
X_0E T 1
goto SpawnL
SpawnL:
X_0E "#######" 1 A_SetScale(ScaleX-0.125,ScaleY-0.085)
stop
}
}

actor TankE_Shot : BasicProjectile
{
Damagetype "Tankeye"
Obituary "%o was eradicated by %k the \cuTank Demoneye\c-!"
+FORCEXYBILLBOARD
+SKYEXPLODE
+EXPLODEONWATER
-NOGRAVITY
Damage (random(95,175))
Radius 16
Height 16
Speed 65
Scale 3.5
States
{
Spawn:
TNT1 A 0
TMFX A 2 ThrustThingZ(0,24,0,1)
TMFX BA 2
goto Spawn+2
Crash:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("classes/KOSpecialSFX","Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 Radius_Quake(3,35,0,2,0)
TNT1 A 0 A_Explode(65,156,0,0,16)
X_8B ABCDEF 2
TNT1 A 6
stop
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/crackerexplode","Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_SpawnItemEX("DTank_ShotBoom",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
}
}

actor TankE_ShotFling : TankE_Shot
{
Damagetype "TankeyeFling"
States
{
Spawn:
TNT1 A 0
TMFX A 2 ThrustThingZ(0,24,0,1)
TMFX A 1 A_SpawnItemEx("TankE_ShotFlingFX",0,0,0,0,0,0,0,1)
wait
Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/crackerexplode","Weapon")
TNT1 A 0 A_SetGravity(0.0)
TNT1 A 0 A_SpawnItemEX("DTank_ShotFlingBoom",0,0,0,0,0,0,0,1)
TNT1 A 1
stop
}
}
actor TankE_ShotFlingFX : BasicClientSide
{
+FORCEXYBILLBOARD
RenderStyle Add
Alpha 1.0
Scale 3.0
States
{
Spawn:
TMFX BBBBBCCCC 1 A_FadeOut(0.05)
Stop
}
}

actor DTank_ShotBoom : BasicExplosion
{
Damagetype "Tankeye"
Obituary "%o was eradicated by %k the \cuTank Demoneye\c-!"
+FORCEXYBILLBOARD
Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/coilexplode","Weapon")
TNT1 A 0 A_Explode(random(95,175),128,0,0,8)
X_8B ABCDEF 2
stop
}
}

actor DTank_ShotFlingBoom : DTank_ShotBoom
{
Damagetype "TankeyeFling"
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/coilexplode","Weapon")
TNT1 A 0 A_Explode(random(150,245),160,0,0,12)
X_8B ABCDEF 2
stop
}
}



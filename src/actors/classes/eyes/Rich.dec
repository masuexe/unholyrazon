actor RichDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG06"
  Player.SoundClass "richeye"
  Player.JumpZ 12
  Player.MorphWeapon "RichDemoneye_W"
  States {
   Spawn:
    _D06 A 0
    _D06 B 1
    _D06 A 1
    goto Spawn+2
   See:
    _D06 BCDE 5
    goto Spawn
   Missile:
    _D06 F 9
    goto Spawn+2
   ClassPain:
    _D06 H 0
    goto MegamanPain
   ClassDeath:
    _D06 H 0
    goto MegamanDeath
  }
}

actor RichDevilDemoneye : RichDemoneye {
  damagefactor "RichDevilCash", 0.0
  damagefactor "RichGasm", 0.0

  Player.MorphWeapon "RichDevilDemoneye_W"
}

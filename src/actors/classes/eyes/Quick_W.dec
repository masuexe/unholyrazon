_E09 A 2 Offset(0,92) A_GiveInventory("UnholyBossAmmo400",2)
_E09 A 2 Offset(0,72) A_GiveInventory("UnholyBossAmmo400",2)
_E09 A 2 Offset(0,52) A_GiveInventory("UnholyBossAmmo400",2)
Goto ReadyX
FireX:
_E09 A 0 A_PlaySoundEx("weapon/magdrillshoot","Weapon")
_E09 A 0 A_FireCustomMissile("QuickEyeBoomerang2",0,0,0,0)
_E09 BC 2
_E09 A 0 A_PlaySoundEx("weapon/magdrillshoot","Weapon")
_E09 A 0 A_FireCustomMissile("QuickEyeBoomerang2",0,0,0,0)
_E09 A 2 Offset(0,132)
_E09 A 2 Offset(0,112)
_E09 A 0 A_PlaySoundEx("weapon/magdrillshoot","Weapon")
_E09 A 0 A_FireCustomMissile("QuickEyeBoomerang2",0,0,0,0)
_E09 A 2 Offset(0,92)
_E09 A 2 Offset(0,72)
_E09 A 2 Offset(0,52)
_E09 A 2 Offset(0,42)
_E09 A 2 Offset(0,37)
Goto ReadyX
AltFire:
_E09 A 0 A_JumpIfInventory("QuickEyeM2Flag",1,"ReadyX")
_E09 A 0 A_PlaySoundEx("wep_L/SonicPowerup","Weapon")
_E09 A 0 A_GiveInventory("QuickEyeM2Flag",1)
_E09 B 2 Offset(2,36)
_E09 A 2 Offset(0,40)
_E09 A 2 Offset(-2,36)
_E09 A 2 Offset(-4,32)
_E09 A 2 Offset(-2,28)
_E09 A 18 Offset(0,32) A_SpawnItemEx("Quickeye_M2_H",0,0,28)
Goto ReadyX
}
}

actor QuickEyeM2Flag : UOnce{}

actor Quickeye_M2_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 10
Spawn2:
TNT1 A 0 A_JumpIfInTargetInventory("UnholyBossAmmo400",5,1)
goto Death
TNT1 A 2 A_TakeFromTarget("UnholyBossAmmo400",5)
loop
Death:
TNT1 A 0 A_TakeFromTarget("QuickEyeM2Flag",99)
stop
}
}


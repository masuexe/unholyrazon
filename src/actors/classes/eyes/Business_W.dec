Actor BusinessDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye08_W"
Obituary "%o couldn't afford to buy %k the \cmBusiness Demoneye\c-'s \cfDLC\c-!"
States
{
Spawn:
_E08 [ 6
wait

Ready:
_E08 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", BUSINESS_EYE_DYE)
_E08 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 8)
_E08 A 0 A_SpawnItemEx("BusinessDemoneyeBot_H")
goto ReadyX
ReadyX:
_E08 A 2 A_WeaponReady
Goto ReadyX
Fire:
_E08 A 0 A_PlaySoundEx("items/MoneyUse","Weapon")
_E08 A 0 //A_GiveInventory("BusinessDemoneyeDelay",1)
_E08 A 0 A_SpawnItemEx("BusinessEyeMoneySpawner",40,0,0)
_E08 BC 3 
TNT1 A 65
_E08 A 1 Offset(0,112)
_E08 A 1 Offset(0,102) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E08 A 1 Offset(0,92)
_E08 A 1 Offset(0,82) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E08 A 1 Offset(0,72)
_E08 A 1 Offset(0,62) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E08 A 1 Offset(0,52)
_E08 A 1 Offset(0,42) A_JumpIfInventory("PlayerPropertyRage",1,1)
_E08 A 0 Offset(0,32)
Goto ReadyX
}
}

actor BusinessDemoneyeDelay2 : Powerup
{
Powerup.Duration 40
}

actor BusinessDemoneyeBot_H : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_JumpIfInTargetInventory("IsBot",1,"SpawnL")
stop
SpawnL:
TNT1 AAAAAAAA random(2,6) A_JumpIf(CallACS("uh_PointerExists", 2), "Death")
TNT1 A 0 A_JumpIfInTargetInventory("DLC_CoinItem",25,"SpawnFire")
loop
SpawnFire:
TNT1 A 0 A_JumpIfInTargetInventory("AirStrikeItem",1,"SpawnFireX")
TNT1 A 2 A_GiveToTarget("AutoDLC_CoinItem",1)
goto SpawnL
SpawnFireX:
TNT1 A 0 A_TakeFromTarget("AirStrikeItem",1)
TNT1 A 2 A_GiveToTarget("AutoAirStrikeItem",1)
goto SpawnL
}
}

actor BusinessEyeMoneySpawner : DLC_CoinSpawner_H
{
reactiontime 7
}


actor QuickDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG09"
  Player.SoundClass "quickeye"

  Player.ForwardMove 2.5, 2.5
  Player.SideMove 1.0, 1.0
  Player.MaxHealth 900
  Health 900
  Player.JumpZ 12
  Player.MorphWeapon "QuickDemoneye_W"
  States {
   Spawn:
    _D09 A 0
    _D09 B 1
    _D09 A 1
    wait
   See:
    _D09 BCDE 3
    goto Spawn
   Missile:
    _D09 FFFFFF 1
    goto Spawn+2
   ClassPain:
    _D09 H 0
    goto MegamanPain
    // _D09 HHHHHHHHH 1 A_SpawnItemEx("PainFX",-5,0,3,0,0,0)
    // Goto Spawn
    // //Goto MegamanPain
   ClassDeath:
    _D09 H 0
    goto MegamanDeath
  }
}

actor MosquitoDemoneye_W : BaseUnholyBossWep {
  Tag "$TAG_DEye00_W"
  Obituary "%o was drained by %k the \c[y2]Mosquito Demoneye\c-!"
  States {
   Spawn:
    _E15 [ 6
    wait

   Ready:
    _E15 A 1 ACS_NamedExecuteWithResult("core_weaponcolor", MOSQUITO_EYE_DYE)
    _E15 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 15)
    _E15 A 0 ACS_NamedExecuteWithResult("core_flyplayer", 0, true)
    _E15 A 0 A_GunFlash
    goto ReadyX
   ReadyX:
    _E15 A 0 A_JumpIfInventory("MosquitoLatch_F", 1, "Drain")
    _E15 A 2 A_WeaponReady
    Goto ReadyX

   Fire:
    _E15 A 0 A_JumpIfInventory("MosquitoLatch_F", 1, "Drain")
    _E15 A 1
    _E15 A 0 ThrustThingZ(0, 45, 0, 0)
    _E15 A 0 A_GiveInventory("MosquitoDemoneyeFire_P")
    // _E15 A 0 A_ChangeVelocity(-29,0,45/4.0,3)
    _E15 A 0 A_PlaySoundEx("weapon/hornetchaser", "Weapon")
    _E15 A 1 Offset(0, 40) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 26)
    _E15 A 1 Offset(0, 12) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 11)
    _E15 A 0 A_TakeInventory("MosquitoDashTics")
    _E15 A 0 A_GiveInventory("MosquitoDashTics", 32)
   FireDash:
    TNT1 A 0 A_JumpIfInventory("MosquitoLatch_F", 1, "Drain")
    _E15 A 1 Offset(0, 10) A_SpawnItemEx("MosquitoeyeGrabber", 0, 0, 32, momx, momy, momz, 0, 8)
    _E15 A 1 Offset(0, 10) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    TNT1 A 0
    TNT1 A 0 A_TakeInventory("MosquitoDashTics", 1)
    TNT1 A 0 A_JumpIfInventory("MosquitoDashTics", 1, "FireDash")
   FireEnd:
    _E15 A 1 Offset(0, 16) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 20)
    _E15 A 1 Offset(0, 26) A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 29)
    _E15 A 0 Offset(0, 32)
    Goto ReadyX

   Drain:
    TNT1 A 0 A_JumpIfInventory("MosquitoLatch_F", 1, "DrainHit")
    goto FireEnd
   DrainHit:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_lookatptr", AAPTR_TRACER)
    _E15 A 1 Offset(0, 10) A_SpawnItemEx("MosquitoeyeDamager", cos(pitch)*70, 0, 32-sin(pitch)*70, 0, 0, 0, 0, 32)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 12)
    _E15 A 1 Offset(0, 14)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 16)
    _E15 A 1 Offset(0, 18)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 16)
    _E15 A 1 Offset(0, 14)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 12)
    _E15 A 1 Offset(0, 11)
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 1)
    _E15 A 1 Offset(0, 10)
    goto Drain

   Flash:
    TNT1 A 0 A_JumpIfInventory("IsDead", 1, "NoFlash")
    TNT1 A 0 A_PlaySoundEx("weapon/hornetfly", "Body")
    TNT1 A 0 ACS_NamedExecuteWithResult("rz_MosquitoEyeTurboTime")
    TNT1 A 2
    loop
  }
}

actor MosquitoeyeDamager : BasicExplosion {
  damagetype "Mosquitoeye"
  Obituary "%o was drained by %k the \c[y2]Mosquito Demoneye\c-!"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2 A_Explode(25 * (1 + 2 * CallACS("uh_CheckRune", RUNE_SPREAD)), 36, 0, 0, 36)  // 32 radius
    stop
  }
}

actor MosquitoeyeHealer_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL_EXPAND_MAX, 25)
    stop
  }
}

// it is a copy of KickChampDiveKick_P because i am too lazy
actor MosquitoDemoneyeFire_P : CustomInventory {
  States {
   Pickup:
    // TNT1 A 0 A_LogInt(pitch)
    // software 55 down 304 up
    // TNT1 A 0 A_JumpIfInventory("KickChampFlag",1,"No")
    TNT1 A 0 A_JumpIf(pitch<360 && pitch>=270 || pitch<=22.5 && pitch>=0, "UpLimit")  // 30//Looking up/looking down a little
    TNT1 A 0 A_JumpIf(pitch<90 && pitch>=88, "DownLimit")
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_ChangeVelocity(cos(pitch)*65, 0, -sin(pitch)*65, 3)
    stop
    // TNT1 A 0 A_ChangeVelocity(cos(pitch)*1,0,-sin(pitch)*1,3)
    TNT1 A 0 A_ChangeVelocity(cos(pitch)*85, 0, -sin(pitch)*85, 3)
    stop
   UpLimit:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_ChangeVelocity(cos(22.5)*65, 0, -sin(22.5)*65, 3)  // -25
    stop
    // TNT1 A 0 A_ChangeVelocity(cos(22.5)*1,0,-sin(22.5)*1,3)
    TNT1 A 0 A_ChangeVelocity(cos(22.5)*85, 0, -sin(22.5)*85, 3)  // -30
    stop
   DownLimit:
    TNT1 A 0 A_JumpIfInventory("PlayerPropertyRage", 1, 2)
    TNT1 A 0 A_ChangeVelocity(cos(88)*65, 0, -sin(88)*65, 3)  // +!(momz)*5
    stop
    TNT1 A 0 A_ChangeVelocity(cos(88)*85, 0, -sin(88)*85, 3)
    stop
   No:
    TNT1 A 0
    stop
  }
}


actor MosquitoeyeEventProtect : PowerProtection {
  damagefactor "Mosquitoeye", 0.0
  Powerup.Duration 0x7ffffffd
}

actor MosquitoLatch_F : Powerup {
  Powerup.Duration -2
}

actor MosquitoDashTics : Inventory {
  Inventory.MaxAmount 32
}

actor MosquitoLatchOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("MosquitoLatch_F")
    TNT1 A 0 A_GiveInventory("IsPerformingSuplex")
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    stop
  }
}

actor MosquitoLatchOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("MosquitoLatch_F")
    TNT1 A 0 A_TakeInventory("IsPerformingSuplex")
    TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_NULL)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    stop
  }
}

// TangoGirlGrabberCheck pattern: HITTRACER missile Crash on +NOBLOOD players,
// then uh_ZangiefGrabReverse pulls the owner onto the victim while MosquitoLatch_F lasts.
actor MosquitoeyeGrabber {
  +MISSILE
  +NOBLOCKMAP
  +NOGRAVITY
  +NOEXPLODEFLOOR
  +NOTIMEFREEZE
  +DONTBLAST
  +DONTREFLECT
  +THRUGHOST
  +HITTRACER
  +BLOODLESSIMPACT
  Height 36
  Radius 36
  RenderStyle None
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1
    stop
   Crash:
    TNT1 A 0 A_JumpIfInTargetInventory("MosquitoLatch_F", 1, "DeathSkip")
    TNT1 A 0 A_JumpIfInTargetInventory("IsPerformingSuplex", 1, "DeathSkip")
    TNT1 A 0 A_JumpIfInventory("IsPerformingSuplex", 1, "DeathSkip", 8)
    TNT1 A 0 A_JumpIf(CallACS("uh_IsTracerAllyOrEnemy") == 1, "DeathSkip")
    TNT1 A 1 A_JumpIf(CallACS("uh_istracerplayer"), "GiveLatch")
    stop
   GiveLatch:
    TNT1 A 0 A_JumpIfInTargetInventory("MosquitoLatch_F", 1, "DeathSkip")
    TNT1 A 0 A_GiveToTarget("MosquitoLatchOn_P")
    TNT1 A 0 A_TransferPointer(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_TRACER, AAPTR_TRACER)
    TNT1 A 0 A_TakeFromTarget("ZangiefAngle")
    TNT1 A 0 A_Warp(8, 0, 0, 28, 0, 8)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_GiveInventory("ZangiefAngle", angle*256/360)
    TNT1 A 0 A_ChangeFlag("MISSILE", 0)
    TNT1 A 0 A_ChangeFlag("NOINTERACTION", 1)
    TNT1 A 1
   CarryTick:
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "StopCarry")
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 8), "StopCarry")
    TNT1 A 1 A_JumpIf(CallACS("uh_ZangiefGrabReverse", 340, CallACS("rz_CountInv_ZangiefAngle"), 70) == 0, "StopCarry")
    TNT1 A 0 A_JumpIfInTargetInventory("MosquitoLatch_F", 1, "CarryTick")
   StopCarry:
    TNT1 A 1 A_GiveToTarget("MosquitoLatchOff_P")
    stop
   Death:
   DeathSkip:
    TNT1 A 1
    stop
  }
}

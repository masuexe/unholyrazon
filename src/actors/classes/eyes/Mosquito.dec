actor MosquitoDemoneye : EyeBase {
  Player.MaxHealth 800
  Health 800
  player.soundclass "DEYE_15"
  player.forwardmove 0.8, 0.8
  player.sidemove 0.75, 0.75
  player.morphweapon "MosquitoDemoneye_W"
  States {
   Spawn:
    _D15 A 0
    _D15 B 1
    _D15 A 1
    Goto Spawn+1
   See:
    _D15 BA 1
    Goto Spawn
   Missile:
    _D15 B 2
    _D15 A 1
    goto Spawn+2
   ClassPain:
    _D15 A 0
    Goto MegamanPain
   ClassDeath:
    _D15 A 0
    Goto MegamanDeath
  }
}

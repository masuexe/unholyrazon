actor HorseDemoneyeshole_W : BaseUnholyBossWep {
  Tag "$TAG_DEye16_W"
  Obituary "%o was sprayed down by %k the \c[n3]Horse Demoneyeshole\c-!"
  States {
   Spawn:
    _E16 [ 6
    wait

   Ready:
    _E16 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", HORSE_EYE_DYE)
    _E16 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 16)
    goto ReadyX
   ReadyX:
    _E16 A 0 A_PlaySoundEx("Isaac/fart", "SoundSlot5")
    _E16 A 0 A_FireCustomMissile("HorseEyePoopShort", 180 + frandom(-24, 24), 0, 0, -8, 0, frandom(-6, 10))
    _E16 A 0 A_FireCustomMissile("HorseEyePoopShort", 180 + frandom(-24, 24), 0, 0, -8, 0, frandom(-6, 10))
    _E16 AAAAAA 1 A_WeaponReady
    _E16 A 0 A_FireCustomMissile("HorseEyePoopShort", 180 + frandom(-24, 24), 0, 0, -8, 0, frandom(-6, 10))
    _E16 A 0 A_FireCustomMissile("HorseEyePoopShort", 180 + frandom(-24, 24), 0, 0, -8, 0, frandom(-6, 10))
    _E16 AAAAAA 1 A_WeaponReady
    goto ReadyX

   Fire:
   Hold:
    _E16 B 0 A_PlaySoundEx("Isaac/fart", "SoundSlot5")
    _E16 B 0 A_FireCustomMissile("HorseEyePoopLong", 180 + frandom(-5, 5), 0, 0, -8, 0, frandom(-2, 3))
    _E16 B 2
    _E16 C 1
    _E16 C 0 A_FireCustomMissile("HorseEyePoopLong", 180 + frandom(-5, 5), 0, 0, -8, 0, frandom(-2, 3))
    _E16 C 2
    _E16 B 1
    _E16 B 0 A_FireCustomMissile("HorseEyePoopLong", 180 + frandom(-5, 5), 0, 0, -8, 0, frandom(-2, 3))
    _E16 B 2
    _E16 C 1
    _E16 C 0 A_Refire("Hold")
    goto ReadyX
  }
}

actor HorseEyePoopShort : BasicProjectile {
  Translation "4:4=[199,144,98]:[199,144,98]",
              "202:202=[179,130,83]:[179,130,83]",
              "192:192=[164,117,74]:[164,117,74]",
              "198:198=[149,107,68]:[149,107,68]",
              "199:199=[138,99,61]:[138,99,61]",
              "247:247=[138,99,61]:[138,99,61]",
              "105:105=[138,99,61]:[138,99,61]",
              "110:110=[128,91,56]:[128,91,56]",
              "120:120=[117,83,49]:[117,83,49]",
              "127:127=[74,52,25]:[74,52,25]"
  DamageType "Horseeye"
  Obituary "%o was sprayed down by %k the \c[n3]Horse Demoneyeshole\c-!"
  -NOGRAVITY
  Gravity 0.55
  Damage (22)
  Radius 7
  Height 7
  Speed 24
  Scale 2.5
  States {
   Spawn:
    1SPP F 0
    1SPP F 10
    stop
   Death:
    1SPP GH 2
    stop
  }
}

actor HorseEyePoopLong : HorseEyePoopShort {
  Gravity 0.2
  Damage (28)
  Speed 50
  Scale 2.8
  States {
   Spawn:
    1SPP F 0
    1SPP F 20
    stop
   Death:
    1SPP GH 2
    stop
  }
}

actor Horse_EventD_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_GiveInventory("Horse_EventD_Pro", 1)
    stop
  }
}

actor Horse_EventD_Pro : PowerProtection {
  DamageFactor "Horseeye", 1.0
  Powerup.Duration 0x7ffffffd
}

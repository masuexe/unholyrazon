actor AlienDemoneye_W_NormalBar : NormalBar {args 4, 39}

actor AlienDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye12_W"
Obituary "\caSpeciman Jr\c- (%k) assumed that %o was the question."
Inventory.Pickupmessage "Hark Hark"
weapon.ammotype "UnholyBossAmmo200"
States
{
//Spawn:
//_E12 [ 6
//wait

Ready:
_E12 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", ALIEN_EYE_DYE)//1700
_E12 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 12)
goto ReallyReady
ReallyReady:
_E12 A 0 A_JumpIfInventory("UnholyBossAmmo200",200,"ReallyReallyReady")
_E12 A 1 A_WeaponReady(WRF_NOSECONDARY)
_E12 A 0 A_GiveInventory("UnholyBossAmmo200",1)
Loop
ReallyReallyReady:
_E12 A 1 A_WeaponReady
Loop

Fire:
_E12 BC 2
Goto Hold
Hold:
_E12 D 0 A_PlaySoundEx("weapon/thunderbolt","Weapon")
_E12 D 3 A_FireCustomMissile("ASPPewPew",0,0,0,8)
_E12 D 0 A_GiveInventory ("UnholyBossAmmo200", 2)
_E12 D 0 A_Refire
_E12 DCB 2
_E12 A 10 A_ClearRefire
Goto ReallyReady
Altfire:
_E12 A 1 A_JumpIfInventory("UnholyBossAmmo200",200,"PKBeam")
Goto ReallyReady
PKBeam: //Lesser chances.
_E12 D 0 A_TakeInventory("UnholyBossAmmo200",200)
_E12 D 0 A_PlaySoundEx("weapon/centaurflash","Weapon")
_E12 D 0 ACS_NamedExecuteAlways("core_whiteflash", 0)
_E12 D 0 A_Jump(4,"FlashA")
_E12 D 0 A_Jump(16,"FlashF")
_E12 D 0 A_Jump(164,"FlashC","FlashD","FlashE")
_E12 D 0 A_Jump(256,"FlashB")
Goto FlashB //Failproof// Goto ReallyReady
FlashA:
_E12 D 1 A_FireCustomMissile("ASPFlashReal",0,0,0,0)
Goto SwingHand 
FlashB:
_E12 D 1 A_FireCustomMissile("ASPFlashDud",0,0,0,0)
Goto SwingHand 
FlashC:
_E12 D 1 A_FireCustomMissile("ASPFlashTimeStopJr",0,0,0,0)
Goto SwingHand 
FlashD:
_E12 D 1 A_FireCustomMissile("ASPFlashShockerJr",0,0,0,0)
Goto SwingHand 
FlashE:
_E12 D 1 A_FireCustomMissile("ASPFlashBlindJr",0,0,0,0)
Goto SwingHand 
FlashF:
_E12 D 1 A_FireCustomMissile("ASPFlashFlingJr",0,0,0,0)
Goto SwingHand 
SwingHand:
_E12 DDDDCB 2
_E12 A 5
Goto ReallyReady
}
}

actor ASPPewPew : BasicProjectile //FastProjectile
{
Alpha 0.4
Translation "192:192=4:4", "198:198=171:171"
damagetype "ASPMagicJr"
Obituary "%o was shot down by \caSpeciman Jr\c-'s \ccASP Pew\c-."
Speed 58 //60
Damage (50) //50
radius 16 //22
height 16 //22
scale 2.5 //3.5
States
{
Spawn:
TNT1 A 1
CHBU ABCDAB 2 A_FadeIn(0.1)
Spawn2:
CHBU CDAB 2
loop
Death:
TMFX ABCD 2
stop
}
}


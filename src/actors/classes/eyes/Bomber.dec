actor BomberDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG07"
  Player.SoundClass "bombereye"

  Player.ForwardMove 0.8, 0.8
  Player.SideMove 0.8, 0.8
  Player.MaxHealth 750
  Health 750
  Player.JumpZ 9

  MaxStepHeight 32  // 24
  MaxDropOffHeight 32  // 24
  Player.MorphWeapon "BomberDemoneye_W"
  States {
   Spawn:
    _D07 A 0
    _D07 B 1
    _D07 A 1
    goto Spawn+2
   See:
    _D07 B 5
    _D07 C 5 A_GiveInventory("BomberDemoneyeWalkSnd_P")
    _D07 D 5
    _D07 E 5 A_GiveInventory("BomberDemoneyeWalkSnd_P")
    goto Spawn
   Missile:
    _D07 F 4
    _D07 G 5
    goto Spawn+2
   ClassPain:
    _D07 H 0
    goto MegamanPain
   ClassDeath:
    _D07 H 0
    goto MegamanDeath
  }
}

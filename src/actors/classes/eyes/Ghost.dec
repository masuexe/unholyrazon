actor GhostDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG02"
  player.soundclass "ghosteye"
  player.damagescreencolor "white"

  StencilColor White
  // StencilColor Black
  // RenderStyle "Add"
  // Alpha 0.3
  Player.MaxHealth 1500
  Health 1500

  player.morphweapon "GhostDemoneye_W"
  States {
   Spawn:
    _D02 A 0
    _D02 B 1
    _D02 A 1
    Goto Spawn+2
   See:
    _D02 ABCB 5
    Goto Spawn
   Missile:
    _D02 D 0 A_JumpIfInventory("Ghost_EventD_Pro", 1, "MissileBright")
    _D02 DEFE 3
    Goto Spawn+2
   MissileBright:
    _D02 DEFE 3 BRIGHT
    Goto Spawn+2
   ClassPain:
    _D02 H 0
    Goto MegamanPain
   ClassDeath:
    _D02 H 0
    Goto MegamanDeath
  }
}

actor Ghost_EventD_P : CustomInventory {States {Pickup: TNT1 A 0 A_GiveInventory("Ghost_EventD_Pro")
    TNT1 A 0 A_GiveInventory("GhostEyeShadowInvisOn_P")stop}}
actor Ghost_EventD_Pro : PowerProtection {damagefactor "Ghosteye", 2.5 Powerup.Duration 0x7ffffffd}

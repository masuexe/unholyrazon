actor SumoDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG04"
  Player.SoundClass "sumoeye"

  Player.MaxHealth 1250
  Health 1250

  Player.MorphWeapon "SumoDemoneye_W"
  States {
   Spawn:
    _D04 A 0
    _D04 B 1
    _D04 A 1 A_JumpIfInventory("DecoyFlag2", 1, "LeapOfDeath")
    goto Spawn+2
   See:
    _D04 BCDE 5
    goto Spawn
   Missile:
    _D04 F 5
    _D04 G 3
    _D04 GG 1 A_JumpIfInventory("DecoyFlag2", 1, "LeapOfDeath")
    goto Spawn+2
   LeapOfDeath:
    _D04 G 2
    _D04 GG 1 A_JumpIfInventory("DecoyFlag2", 1, "LeapOfDeath")
    _D04 A 4
    goto Spawn+2
   ClassPain:
    _D04 H 0
    goto MegamanPain
   ClassDeath:
    _D04 H 0
    goto MegamanDeath
  }
}

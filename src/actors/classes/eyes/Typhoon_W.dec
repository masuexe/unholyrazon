actor TyphoonDemoneye_W : BaseUnholyBossWep {
  Tag "$TAG_DEye03_W"
  Obituary "%o was blown off the map by %k the \c[c2]Typhoon Demoneye\c-!"
  States {
   Spawn:
    _E13 [ 6
    wait

   Ready:
    _E13 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", TYPHOON_EYE_DYE)
    _E13 A 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 14)
    goto ReadyX
   ReadyX:
    _E13 A 2 A_WeaponReady
    Goto ReadyX

   Fire:
    _E13 A 0 A_PlaySound("weapon/tornadoshoot", 2, 1, 0, 0.3)
    _E13 A 0 A_SpawnItemEx("TyphoonE_Tornado", 0, 0, 0, velx*cos(angle)+vely*sin(angle), velx*sin(angle)+vely*-cos(angle), 0, 0, 1)
    _E13 BC 4
    _E13 A 18
    Goto ReadyX
  }
}

actor TyphoonE_Tornado : BasicProjectile {
  Translation "192:192=64:64", "198:198=66:66"
  Damagetype "WindDemoneyeFling"
  Species "TyphoonEyeTornado"
  Obituary "%o was blown off the map by %k the \c[c2]Typhoon Demoneye\c-!"
  +OLDRADIUSDMG
  +DONTBLAST
  +FLOORHUGGER
  +THRUACTORS
  +DONTSPLASH
  +THRUSPECIES
  renderstyle Translucent
  Alpha 0.7
  ReactionTime 4 //2
  Damage (0)
  Radius 4
  Height 4
  Speed 0
  scale 2.5
  args 50, 100
  States {
   Spawn:
    EVFL N 0
   SpawnL:
    EVFL N 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL N 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL N 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL N 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL O 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL O 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL O 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL O 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL P 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL P 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL P 1 A_Explode(Args[0], Args[1], 0, 0, 8)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoBlock", 0, 0, 0, velx, vely, 0, 0, 32)
    EVFL P 0 A_SpawnItemEx("TyphoonE_TornadoSpeedSource", 0, 0, 0, velx, vely, 60, 0, 32)
    EVFL N 0 A_CountDown
    loop

   Death:
    EVFL NNNOOOPPP 1 A_FadeOut(0.08)
    loop
  }
}

actor TyphoonE_TornadoBlock {
  -SOLID
  +MISSILE
  +DONTSPLASH
  +DONTBLAST
  +DONTDRAIN
  +DONTREFLECT
  +DONTRIP
  +NOBLOOD
  +NOCLIP
  +NORADIUSDMG
  //+GHOST
  +SHOOTABLE
  +NOTIMEFREEZE
  +NOGRAVITY
  +NOTARGETSWITCH
  +NODAMAGE
  +FLOORHUGGER
  +THRUSPECIES
  +INVULNERABLE
  Species "TyphoonEyeTornado"
  RenderStyle "None"
  bloodtype ""
  damagefactor "Telefrag", 0.0
  painchance 256
  health 0x7ffffffd
  Damage (0)
  Height 0x7ffffffd
  Radius 100
  Speed 0
  States {
   Spawn:
    TNT1 A 1
    stop
   Pain:
    TNT1 A 1
    stop
   Death:
    TNT1 A 1
    stop
  }
}

actor TyphoonE_TornadoSpeedSource : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_RadiusGive("PowerTyphoonEyeSpeedGiver", 100, RGF_PLAYERS|RGF_NOSIGHT, 1)
    stop
  }
}

actor PowerTyphoonEyeSpeedGiver : BasicPowerupGiver {
  Powerup.Type "PowerTyphoonEyeSpeed"
}
actor PowerTyphoonEyeSpeed : PowerSpeed {
  Powerup.Duration 2
  Speed 2.0
}

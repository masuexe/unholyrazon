actor DarkPurpleClone_W_NormalBar : NormalBar {args 62, 95}

actor DarkPurpleClone_W : BaseUnholyBossWep
{
Tag "$TAG_Event00_W"
+BRIGHT
Obituary "%o's life was ceased due to %k."
Inventory.Pickupmessage "\cdThe purple darkness takes hold!"
weapon.ammotype "DarkPurpleCloneAmmo"
States
{
Spawn:
EV00 [ 1
wait

Deselect:
8M00 A 0
goto DeselectX
Select:
8M00 A 0
goto SelectX

Ready:
8M00 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DARKPURPLECLONE_DYE)
goto ReadyX
ReadyX:
8M00 A 0 A_JumpIfInventory("DarkPurpleCloneAmmo",50,"ReadyX2")
8M00 A 2 A_WeaponReady(8)
8M00 A 0 A_GiveInventory("DarkPurpleCloneAmmo",4)
loop
ReadyX2:
8M00 A 2 A_WeaponReady
8M00 A 0 A_GiveInventory("DarkPurpleCloneAmmo",4)
loop

Fire:
8M00 A 0 A_PlaySoundEx("Bat_Rob/Pew","Weapon")
8M00 A 0 A_FireCustomMissile("DPC_Shot",0,0,8,0)
8M00 BCAAA 3 A_GiveInventory("DarkPurpleCloneAmmo",2)
8M00 A 1
Goto ReadyX
AltFire:
8M00 A 0 A_JumpIfInventory("DarkPurpleCloneAmmo",50,"Souououret")
Goto ReadyX
Souououret:
8M00 A 0 A_PlaySoundEx("Bat_Rob/Pew2","Weapon")
8M00 A 0 A_TakeInventory("DarkPurpleCloneAmmo",50)
8M00 A 0 A_FireCustomMissile("DPCSouretShot",0,0,8,0)
8M00 A 0 A_ChangeVelocity(-Cos(pitch)*12,0,sin(pitch)*10,CVF_RELATIVE)
8M00 BCAA 2
goto ReadyX
}
}

actor DarkPurpleCloneAmmo : Ammo
{
inventory.amount 1
inventory.maxamount 100
+INVENTORY.IGNORESKILL
}

actor DarkPurpleCloneProtect : PowerProtection
{
damagefactor "DPClone", 0.0
Powerup.Duration 0x7FFFFFFC
}

actor DPC_Shot : BasicProjectile  //DarkPurpleCloneShot
{
Translation "192:192=59:59", "198:198=62:62", "202:202=4:4", "199:199=61:61"
damagetype "DPClone"
Obituary "%o's life was ceased due to %k."
+SKYEXPLODE
+BRIGHT
Renderstyle "Add"
Alpha 0.9
Damage (60) //30
radius 12
height 15
Speed 60
scale 3.0
States
{
Spawn:
//X_0A ABCBC 2
//Y_0A B 2
//X_0A CBCB 2
//Y_0A C 2
X_0A A 1
X_0A B 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(-45,-55))
X_0A C 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(-25,-35))
X_0A B 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(-5,-15))
X_0A C 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(5,15))
Y_0A B 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(25,35))
X_0A C 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(45,55))
X_0A B 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(25,35))
X_0A C 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(5,15))
X_0A B 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(-5,-15))
Y_0A C 1 A_SpawnItemEx("DPC_ShotFX",0,0,0,4,0,random(-1,1),random(-25,-35))
goto Spawn+1

Death:
TNT1 A 0
TNT1 A 0 A_PlaySoundEx("wep_L/mmk/balladecrackerexplode","Weapon")
TNT1 A 0 A_Explode(30,128,0,0,24) //12 was last used for full radius dmg
TNT1 A 4 A_SpawnItemEx("BasicBoom4FX_ColorX",0,0,0,0,0,0,0,1+16384)
stop
}
}

actor DPC_ShotFX : BasicGraphicEffect
{
Translation "192:192=0:0","198:198=59:59"
+BRIGHT
Renderstyle "Add"
Alpha 1.0
States
{
SpawnFrame:
TMFX BBCD 2 A_Fadeout
stop
}
}

actor DPCSouretShot : BasicProjectile
{
Translation "192:192=4:4", "198:198=62:62", "202:202=59:59", "199:199=62:62"
damagetype "DPClone"
Obituary "%o's life was ceased due to %k."
+BRIGHT
renderstyle "Add"
alpha 0.95
damage (80) //50
Radius 12
Height 12
speed 45 //35
scale 4
States
{
Spawn:
TNT1 A 1
TMFX A 1
YMFX C 1
goto Spawn+1
Crash:
Death:
TNT1 A 0 A_Stop
TMFX AAAAAA 0 A_SpawnItemEx("DPCSouretShotFX",random(-2,2),random(-2,2),8,random(-10,10),random(-10,10),random(-5,12))
TMFX A 4 A_Explode(50,128,0,0,24) //35,128,0,0,12
YMFX CCCCCC 0 A_SpawnItemEx("DPCSouretShotFX",random(-2,2),random(-2,2),8,random(-10,10),random(-10,10),random(-5,12))
YMFX C 4 A_Explode(50,128,0,0,24)
TMFX AAAAAA 0 A_SpawnItemEx("DPCSouretShotFX",random(-2,2),random(-2,2),8,random(-10,10),random(-10,10),random(-5,12))
TMFX A 4 A_Explode(50,128,0,0,24)
YMFX C 2
TMFX ABC 2
stop
}
}

actor DPCSouretShotFX : BasicGraphicEffect
{
Translation "192:192=59:59", "198:198=62:62"
+BRIGHT
renderstyle "Add"
alpha 0.95
Scale 1.0
States
{
SpawnFrame:
YMFX C 2 BRIGHT A_FadeOut(0.04)
TMFX ABA 2 BRIGHT A_FadeOut(0.04)
YMFX C 2 BRIGHT A_FadeOut(0.04)
TMFX ABC 2 BRIGHT A_FadeOut(0.04)
stop
}
}

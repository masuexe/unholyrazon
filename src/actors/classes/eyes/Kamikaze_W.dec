actor KamikazeDemoneye_W_ScriptBar : ScriptBar {}

Actor KamikazeDemoneye_W : BaseUnholyBossWep
{
Tag "$TAG_DEye05_W"
Obituary "%o was everywhere due to %k the \crKamikaze Demoneye\c-!"
Weapon.AmmoType "KamikazeEyeFlag"
States
{
Spawn:
_E05 [ 6
wait

Ready:
_E05 D 0 ACS_NamedExecuteWithResult("core_weaponcolor", KAMIKAZE_EYE_DYE)
_E05 D 0 ACS_NamedExecuteWithResult("uh_DemoneyeMorph", 5)
_E05 D 0 A_GunFlash("Flash",1)
goto ReadyX
ReadyX:
//_E05 D 0 A_JumpIfInventory("KamikazeEyeFlag",1,"ReadyHeal")
_E05 D 2 A_WeaponReady
Goto ReadyX

/*ReadyHeal:
_E05 D 2 A_WeaponReady
_E05 D 0 ACS_ExecuteAlways(U_HEALTHACS,0,6,2)
_E05 D 0 A_TakeInventory("KamikazeEyeFlag",2)
_E05 D 0 A_JumpIfInventory("KamikazeEyeFlag",1,"ReadyHeal")
Goto ReadyX*/

Flash:
//TNT1 A 0 A_JumpIfInventory("IsDead",1,"NoFlash")
TNT1 A 10 A_GiveInventory("Kamikaze_Flash_P")
Loop

BotFire:
_E05 E 1 A_JumpIfCloser(400,1)
goto ReadyX
_E05 E 1
goto DieAlbo+1
Fire:
_E05 E 0 A_JumpIfInventory("IsBot",1,"BotFire")
_E05 E 0 A_GiveInventory("Kamikaze_Popoff",1)
Hold:
_E05 E 0 A_JumpIfInventory("Kamikaze_TrueAnger",20,"DieAlbo")
_E05 E 1 A_GiveInventory("Kamikaze_TrueAnger",1)
_E05 E 0 A_Refire("Hold")
goto ComeOnYellowBelly
AltFire:
//_E05 E 0 A_JumpIfInventory("IsBot",1,"BotFire")
_E05 E 0 A_GiveInventory("Kamikaze_Popoff",1)
AltHold:
_E05 E 0 A_JumpIfInventory("Kamikaze_FakeAnger",20,"YouDareTakeEmOn")
_E05 E 1 A_GiveInventory("Kamikaze_FakeAnger",1)
_E05 E 0 A_Refire("AltHold")
goto ComeOnYellowBelly
YouDareTakeEmOn:
_E05 E 0 //A_JumpIfInventory("IsBot",1,"BotFire")
_E05 E 0 A_TakeInventory("Kamikaze_FakeAnger")
_E05 E 0 A_PlaySoundEx("misc/partyball", "Weapon")
_E05 E 1 A_SpawnItemEx("BasicConfetti_H",0,0,32,0,0,0,0,1)//ConfettiSpawner
_E05 E 0 A_TakeInventory("Kamikaze_Popoff",1)
_E05 E 2
_E05 D 6
Goto ReadyX
DieAlbo:
_E05 E 0 //A_JumpIfInventory("IsBot",1,"BotFire")
_E05 E 0 A_TakeInventory("Kamikaze_TrueAnger")
_E05 E 1 A_TakeInventory("KamikazeEyeFlag")
_E05 E 0 A_SpawnItemEx("Kamikaze_BlastHelper",0,0,28)
_E05 E 1 A_FireCustomMissile("Kamikaze_Blast",0,0,0,0)
_E05 E 1 DamageThing(250)
_E05 E 0 A_TakeInventory("Kamikaze_Popoff",1)
//TNT1 A 0 A_Stop
TNT1 A 0 A_ChangeFlag("NOTELEPORT",1)
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, true)
TNT1 A 34 
TNT1 A 0 A_GiveInventory("KamikazeEyeFlag",250)
TNT1 A 1 A_ChangeFlag("NOTELEPORT",0)
TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
TNT1 A 0 A_GiveInventory("NoTeleportFX_Flag",1)
TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P",1)
TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
Goto ReadyX
ComeOnYellowBelly:
_E05 E 0 A_TakeInventory("Kamikaze_TrueAnger")
_E05 E 0 A_TakeInventory("Kamikaze_FakeAnger")
_E05 E 0 A_TakeInventory("Kamikaze_Popoff")
_E05 E 2
Goto ReadyX
}
}

actor Kamikaze_Popoff : UOnce {}

actor KamikazeEyeFlag : Ammo
{
inventory.amount 1
inventory.maxamount 250
+INVENTORY.IGNORESKILL
}

actor Kamikaze_TrueAnger : Inventory
{
inventory.amount 1
inventory.maxamount 20 //
}
actor Kamikaze_FakeAnger : Inventory
{
inventory.amount 1
inventory.maxamount 20 //
}

actor Kamikaze_Flash_P : Inventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory("KamikazeEyeFlag",1,"HealingPower")
stop
HealingPower:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 10)
TNT1 A 0 A_TakeInventory("KamikazeEyeFlag",10)
stop
}
}

Actor Kamikaze_Blast : BasicExplosion
{
Obituary "%o was everywhere due to %k the \crKamikaze Demoneye\c-!"
Damagetype "Kamikazeeye"
Scale 7.5
States
{
Spawn:
ASEX A 0
TNT1 A 0 Radius_Quake(6,10,0,16,0) //6
ASEX A 0 A_Explode(450,333,0,0,64) //450 //350
ASEX AB 2 A_SpawnItemEx("Kamikaze_Blast_X",random(-128,128),random(-128,128),random(-96,96),0,0,0,0,1) //
ASEX CD 2 A_SpawnItemEx("Kamikaze_Blast_X",random(-156,156),random(-156,156),random(-112,112),0,0,0,0,1) //
ASEX EF 2 A_SpawnItemEx("Kamikaze_Blast_X",random(-192,192),random(-192,192),random(-128,128),0,0,0,0,1) //
stop
}
}

actor Kamikaze_Blast_X : BasicExplosion
{
Damagetype "Kamikazeeye"
Obituary "%o was everywhere due to %k the \crKamikaze Demoneye\c-!"
Scale 3.5
States
{
Spawn:
TNT1 A 0 //Add more kirby sounds or something? I don't know.
//TNT1 A 0 A_PlaySoundEx("weapon/drillexplode","Weapon")
TNT1 A 0
TNT1 A 0 A_Explode(50,164,0,0,32)// 20
ASEX ABCDEF 2
stop
}
}


//I've no idea what this is.
//I bet it's the Kirby boss defeat explosion sounds.
Actor Kamikaze_BlastHelper : BasicHelper
{
States
{
Spawn:
TNT1 A 0
TNT1 A 0 //A_PlaySoundEx("KirbyNES/Boss_D","Body")
TNT1 A 0 A_PlaySoundEx("KirbyNES/Boss_D","Voice")
TNT1 A 10 A_PlaySoundEx("KirbyNES/Boss_D","Weapon")
stop
}
}


actor EyelentoDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG11"
  Player.SoundClass "eyelentoeye"

  Player.ForwardMove 1.5, 1.5
  Player.SideMove 1.5, 1.5
  Player.MaxHealth 2000
  Health 2000
  Player.JumpZ 12

  damagefactor "Foxeye", 0.5
  Player.MorphWeapon "EyelentoDemoneye_W"
  States {
   Spawn:
    _D11 A 0
    _D11 B 1
    _D11 A 1
    goto Spawn+2
   See:
    _D11 BCDE 5
    goto Spawn
   Missile:
    _D11 F 16  // 9
    goto Spawn+2
   ClassPain:
    _D11 H 0
    goto MegamanPain
   ClassDeath:
    _D11 H 0
    goto MegamanDeath
  }
}

actor EyelentoMajorDemoneye : EyelentoDemoneye {
  Player.ScoreIcon "I_MUG111"
  damagefactor "EyelentoMajor", 0.0
  damagefactor "EyelentoMajorKick", 0.0
  damagefactor "EyelentoMajorSuplex", 0.0
  damagefactor "MajorGrenade", 0.0
  damagefactor "MajorGrenadeX", 0.0
  damagefactor "MajorGasm", 0.0
  damagefactor "Foxeye", 0.5
  Player.MorphWeapon "EyelentoMajorDemoneye_W"
}

/*
Oh, don't worry.
This was overdue.
The Alien called for it's cohorts.
 */
actor AlienDemoneye : EyeBase {
  Player.ScoreIcon "I_MUG12"
  Player.SoundClass "speciman"
  Player.ForwardMove 1.2, 1.2
  Player.SideMove 1.2, 1.2
  Player.JumpZ 12

  Player.MorphWeapon "AlienDemoneye_W"
  States {
   Spawn:
    8A42 A 0
    8A42 B 1
    8A42 A 1
    goto Spawn+2
   See:
    8A42 BCDE 5
    goto Spawn
   Missile:
    8A42 F 5
    8A42 G 4
    goto Spawn+2
   ClassPain:
    8A42 H 0
    goto MegamanPain
   ClassDeath:
    8A42 H 0
    goto MegamanDeath
  }
}


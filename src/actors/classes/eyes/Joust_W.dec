actor Joust_Explosion : BasicExplosion
{
damagetype "Jousteye"
Obituary "%o was run over by %k the \cjJousting Demoneye\c-!"
States
{
Spawn:
TNT1 A 0 
TNT1 A 2 A_Explode(200,110,0,0,24)
stop
}
}
actor Joust_ExplosionR : Joust_Explosion

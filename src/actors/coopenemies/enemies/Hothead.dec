actor HotHeadEnemyU : GenericRobot replaces HotHead {
  Height 52
  Radius 32
  Obituary "%o was incinerated by a Hot Head."
  Health 1350
  maxstepheight 50
  +LOOKALLAROUND
  speed 8
  States {
   Look:
    HOTH AB 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    HOTH ABABAB 6 A_GiveInventory("HotHeadEnemyU_P")
    HOTH E 6 A_GiveInventory("HotHeadEnemyU_P")
    HOTH F 6 A_SpawnItemEx("TackleFireHomingU", 18, 0, 48, 10, 0, random(5, 12), random(-15, 15), 1)
    HOTH E 6 A_GiveInventory("HotHeadEnemyU_P")
    HOTH F 6 A_SpawnItemEx("TackleFireHomingU", 18, 0, 48, 10, 0, random(5, 12), random(-15, 15), 1)
    HOTH E 6 A_GiveInventory("HotHeadEnemyU_P")
    HOTH F 6 A_SpawnItemEx("TackleFireHomingU", 18, 0, 48, 10, 0, random(5, 12), random(-15, 15), 1)
    Goto Look
  }
}

actor HotHeadEnemyU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("HotHeadRadiusU")
    stop
  }
}

actor HotHeadRadiusU : BasicExplosion {
  damagetype "HotHeadU"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(100, 80, 0)
    stop
  }
}
actor HazardTag_HotHeadU : BasicACSDamager {
  DamageType "HotHeadU"
  Obituary "%o was incinerated by a Hot Head while fighting %k."
}

actor TackleFireHomingU {
  PROJECTILE
  DamageType "HotHeadTackleFireU"
  Obituary "%o was incinerated by a Hot Head's tackle fire."
  speed 0
  health 20
  Damage (100)
  scale 2.5
  -NOGRAVITY
  +NOEXPLODEFLOOR
  States {
   Spawn:
    HOTH CCCCDDDD 1 A_JumpIf(floorz-z==0, "Bounce")
    loop
   Bounce:
    HOTH C 0 A_SeekerMissile(90, 90, SMF_LOOK, 256, 0)
    HOTH C 0 A_Stop
    HOTH C 0 A_FaceTracer
    HOTH C 0 A_Recoil(-15)
    HOTH C 0 ThrustThingZ(0, 25, 0, 0)
    HOTH C 0 A_GiveInventory("CutterFlag", 1)
    HOTH C 0 A_JumpIfInventory("CutterFlag", 5, "Death")
    HOTH C 2
    Goto Spawn

   See:
    HOTH C 0 A_FaceTracer
    Goto Bounce+1

   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 1 A_SpawnItemEx("EnemyDeathUFX", 0, 0, 28)
    stop
  }
}
actor HazardTag_HotHeadTackleFireU : BasicACSDamager {
  DamageType "HotHeadTackleFireU"
  Obituary "%o was incinerated by a Hot Head's tackle fire while fighting %k."
}

actor HotHeadEnemyU_Claw2 : HotHeadEnemyU {
  translation "216:216=4:4", "41:41=76:76"
  States {
   See:
    HOTH ABA 4 A_GiveInventory("HotHeadEnemyU_P")
    HOTH E 4 A_GiveInventory("HotHeadEnemyU_P")
    HOTH F 8 A_SpawnItemEx("TackleFireHomingU", 18, 0, 48, 10, 0, random(5, 12), random(-15, 15), 1)
    Goto Look
  }
}

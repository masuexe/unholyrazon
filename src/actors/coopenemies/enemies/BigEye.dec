actor BigEyeEnemyU : GenericRobot replaces BigEye {
  Health 2800
  Height 120
  Radius 40
  Obituary "%o was crushed by a Big Eye."
  +SOLID
  MaxStepHeight 50
  +DROPOFF
  +LOOKALLAROUND
  +DONTBLAST
  dropitem "BigWeaponEnergy", 64
  dropitem "BigHealth", 64
  dropitem "WeaponEnergy", 128
  dropitem "SmallHealth", 128
  States {
   Look:
    BIGE A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    BIGE A 0 A_Stop
    BIGE B 0 A_SpawnItemEx("BigEyeStompU")
    BIGE BBBBBBBBBBBBBBBBBBBB 1 A_Chase
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE B 0  // A_Stop
    BIGE B 0 A_JumpIfCloser(250, "LeapForward")
    BIGE B 0 A_Jump(256, "Leap", "Leap2")
    goto See+1
   Pain.PunctureNeedle:
    CRAZ A 0 A_Stop
    CRAZ A 0 A_Pain
    BIGE A 30 A_SpawnItemEx("ShockFX", 4, 0, 32)
    goto Look
   Leap:
    BIGE A 0 A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 60, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1 A_Recoil(-3)
    BIGE A 0 A_Chase
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 1 A_JumpIf(z - floorz == 0, "See")
    goto Leap+5
   LeapForward:
    BIGE A 0 A_FaceTarget
   Leap2:
    BIGE A 0 A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 50, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1 A_Recoil(-3)
    BIGE A 0 A_Chase
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 1 A_JumpIf(z - floorz == 0, "See")
    goto Leap2+5
   Death:
    NAPA A 0
    goto BigDeath
  }
}

actor BigEyeStompU {
  -SOLID
  Projectile
  DamageType "BigEye"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(500, 64, 0)
    stop
  }
}

actor BigEyeEnemyU_2BM : BigEyeEnemyU {
  Translation "208:208=210:210", "41:41=231:231"
  States {
   Look:
    BIGE A 1 A_JumpIf(z - floorz == 0, "Leap0")
    wait
   Leap0:
    BIGE B 3 A_Stop
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE A 1 ThrustThingZ(0, 16, 0, 0)
   Leap0_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 2 A_JumpIf(z - floorz == 0, "Leap1")
    loop
   Leap1:
    BIGE B 3 A_Stop
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE A 1 ThrustThingZ(0, 16, 0, 0)
   Leap1_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 2 A_JumpIf(z - floorz == 0, "Leap2")
    loop
   Leap2:
    BIGE B 3 A_Stop
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE A 1 ThrustThingZ(0, 50, 0, 0)
   Leap2_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 2 A_JumpIf(z - floorz == 0, "Look0")
    loop
   Look0:
    BIGE A 0 A_Stop
    BIGE A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "Leap3")
    wait
   Leap3:
    BIGE B 3 A_FaceTarget
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE A 0 A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 60, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1 A_Recoil(-3)
    BIGE A 0 A_Chase
   Leap3_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 2 A_JumpIf(z - floorz == 0, "Leap0")
    loop
   Leap3_No:
    BIGE B 3
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE A 0 A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 60, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1 A_Recoil(-3)
    BIGE A 0 A_Chase
   Leap3_No_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 1 A_JumpIf(z - floorz == 0, "Leap0")
    loop
  }
}

actor BigEyeEnemyU_Claw : BigEyeEnemyU {
  Translation "41:41=193:193"
  States {
   Look:
    BIGE A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    BIGE A 0 A_Stop
    BIGE B 0 A_SpawnItemEx("BigEyeStompU")
    BIGE BB 1 A_Chase
    BIGE B 0 A_PlaySound("robot/bigeye")
    BIGE B 0  // A_Stop
    BIGE B 0 A_JumpIfCloser(250, "LeapForward")
    BIGE B 0 A_Jump(256, "Leap", "Leap2")
    goto See+1
   Leap:
    BIGE A 0 A_Stop  // A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 60, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1  // A_Recoil(-3)
    BIGE A 0 A_Chase
   Leap_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 1 A_JumpIf(z - floorz == 0, "See")
    loop
   LeapForward:
    BIGE A 0 A_FaceTarget
   Leap2:
    BIGE A 0 A_Recoil(-3)
    BIGE A 5 ThrustThingZ(0, 50, 0, 0)
    BIGE A 0 A_Chase
    BIGE A 1 A_Recoil(-3)
    BIGE A 0 A_Chase
   Leap2_Loop:
    BIGE A 0 A_SpawnItemEx("BigEyeStompU")
    BIGE A 0 A_Chase
    BIGE A 1 A_JumpIf(z - floorz == 0, "See")
    loop
  }
}
actor BigEyeEnemyU_Claw_Color2 : BigEyeEnemyU_Claw {translation "41:41=78:78"}

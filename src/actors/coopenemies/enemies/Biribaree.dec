actor BiribareeU : GenericRobot replaces Biribaree {
  Height 32
  Radius 32
  Health 400
  States {
   Spawn:
    BRBR A 0
    BRBR A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
    BRBR A 0 A_JumpIf(args[0] == 1, "Biribaree")
    BRBR A 0 A_JumpIf(args[0] == 2, "Piriparee")
    BRBR A 0 A_Jump(127, "Piriparee")
    goto Biribaree
   Biribaree:
    BRBR ABABABABAA 14
    BRBR C 0 A_ChangeFlag("INVULNERABLE", 1)
    BRBR CECFCECFCECFCECFCECFCECFCECFCECFCECFCECF 2 bright
    BRBR D 0 A_ChangeFlag("INVULNERABLE", 0)
    BRBR D 8 A_SpawnItemEx("BiribareeShot", 32, 0, 32, 18)
    loop
   Piriparee:
    PRPR ABABABABAA 14
    PRPR C 0 A_ChangeFlag("INVULNERABLE", 1)
    PRPR CECFCECFCECFCECFCECFCECFCECFCECFCECFCECF 2 bright
    PRPR D 0 A_ChangeFlag("INVULNERABLE", 0)
    PRPR D 8 A_SpawnItemEx("PiripareeShot", 32, 0, 32, 18)
    loop
  }
}

actor BiribareeShot : BasicProjectile {
  Radius 18
  Height 18
  Speed 18
  Damage (200)
  DamageType "BiribareeU"
  Obituary "%o was shocked by a Biribaree."
  +FORCEXYBILLBOARD
  +BRIGHT
  States {
   Spawn:
    BRBR GHIH 2
    loop
  }
}
actor HazardTag_BiribareeU : BasicACSDamager {
  DamageType "BiribareeU"
  Obituary "%o was shocked by a Biribaree while fighting %k."
}

actor PiripareeShot : BiribareeShot {
  DamageType "PiripareeU"
  Obituary "%o was shocked by a Piriparee."
}
actor HazardTag_PiripareeU : BasicACSDamager {
  DamageType "PiripareeU"
  Obituary "%o was shocked by a Piriparee while fighting %k."
}

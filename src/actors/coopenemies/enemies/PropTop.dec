actor PropTopU : GenericRobot {
  Health 900
  Height 75
  Radius 36
  Obituary "%o was squashed by a Prop-Top."
  maxstepheight 50
  +DROPOFF
  +DONTBLAST
  States {
   Look:
    PRPT A 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 2000, 0, 270, "See") // 360
    loop
   See:
    PRPT A 1 A_Chase("Melee", "", CHF_DONTMOVE)
    PRPT A 0 A_ChangeFlag("SOLID", 1)
    PRPT A 5 A_FaceTarget
    PRPT ABCBABC 4 A_FaceTarget
    PRPT D 0 A_ChangeFlag("NOGRAVITY", 1)
    PRPT D 0 A_ChangeFlag("SOLID", 0)
    PRPT C 1 A_FaceTarget
    PRPT D 0 ThrustThingZ(0, 25, 0, 0)
    PRPT CDCDCD 4 A_FaceTarget
    PRPT D 0 A_ChangeFlag("CANPASS", 0)
    PRPT D 0 A_Stop
    PRPT D 0 A_ChangeFlag("NOGRAVITY", 0)
    PRPT D 1 A_FaceTarget
    PRPT D 4 A_Recoil(random(-24, -16))
    Goto Falling
   Falling:
    PRPT D 0 A_FaceTarget
    PRPT D 0 A_SpawnItemEx("OctopusBatteryDamagerU", 0, 0, -20, velx, vely, velz, 0, SXF_ABSOLUTEMOMENTUM)
    PRPT D 1 A_JumpIf(z-floorz==0, "Land")
    loop
   Melee:
    PRPT D 0 A_ChangeFlag("CANPASS", 1)
    PRPT D 0 A_ChangeFlag("NOGRAVITY", 0)
    PRPT A 1 A_FaceTarget
    PRPT A 20 A_CustomMeleeAttack(10, "", "", "PropTopU")
    PRPT A 0 A_Chase("Melee", "", CHF_DONTMOVE)
    Goto Look
   Land:
    PRPT A 0 A_Stop
    PRPT A 10 A_SpawnItemEx("PropTopDamagerU")
    PRPT A 0 A_ChangeFlag("CANPASS", 1)
    PRPT A 0 A_ClearTarget
    PRPT AAAA 5
    Goto Look
  }
}
actor HazardTag_PropTopU : BasicACSDamager {
  DamageType "PropTopU"
  Obituary "%o was squashed by a Prop-Top while fighting %k."
}

actor PropTopDamagerU {
  +MISSILE
  damagetype "PropTopU"
  +THRUGHOST
  -SOLID
  Damage 0
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("robot/bigeye", "Voice")
    TNT1 A 0 A_Explode(250, 120, 0)
    TNT1 A 0
    stop
  }
}

actor PropTopU_Claw2 : PropTopU {
  translation "210:210=106:106", "104:104=42:42"
  gravity 1.5
  States {
   Look:
    PRPT A 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 2000, 0, 360, "See")
    loop
   See:
    PRPT A 1 A_Chase("Melee", "", CHF_DONTMOVE)
    PRPT A 0 A_ChangeFlag("SOLID", 1)
    PRPT A 0 A_ChangeFlag("NOGRAVITY", 1)
    PRPT A 0 A_ChangeFlag("SOLID", 0)
    PRPT A 0 A_ChangeFlag("CANPASS", 0)
    PRPT A 0 A_Stop
    PRPT A 0 ThrustThingZ(0, 68, 0, 0)
    PRPT A 0 A_ChangeFlag("NOGRAVITY", 0)
    PRPT A 1 A_FaceTarget
    PRPT A 0 A_Recoil(random(-14, -8))
    Goto Falling
   Melee:
    PRPT A 0 A_ChangeFlag("CANPASS", 1)
    PRPT A 0 A_ChangeFlag("NOGRAVITY", 0)
    PRPT A 1 A_FaceTarget
    PRPT A 0 A_CustomMeleeAttack(10, "", "", "PropTopU")
    PRPT A 0 A_Chase("Melee", "", CHF_DONTMOVE)
    Goto Look
   Land:
    PRPT A 0 A_SpawnITemEx("PropTopDamagerU")
    PRPT A 0 A_ChangeFlag("CANPASS", 1)
    PRPT A 0 A_Stop
    PRPT A 0 A_ClearTarget
    PRPT A 1
    Goto Look
  }
}

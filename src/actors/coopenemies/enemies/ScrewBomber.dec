actor ScrewBomberU : GenericRobot replaces ScrewBomber {
  Health 300
  Height 16
  Radius 16
  Speed 0
  +FORCEYBILLBOARD
  +DONTBLAST
  DropItem ""
  States {
   Look:
    SWBM A 35 A_LookEx(LOF_NOSOUNDCHECK, 0, 768, 0, 360, "See")
    loop
   See:
    SWBM BC 5
    SWBM D 12 A_GiveInventory("ScrewBomberVolley_P")
    SWBM BC 5
    SWBM D 12 A_GiveInventory("ScrewBomberVolley_P")
    SWBM BC 5
    SWBM D 12 A_GiveInventory("ScrewBomberVolley_P")
    SWBM CB 5
    SWBM A 35
    goto Look
  }
}

// Relative angles rotate both the launch velocity and projectile orientation.
// The robot does not turn between volleys, keeping all three rings aligned.
actor ScrewBomberVolley_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("misc/devilfire", "Weapon")
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 45)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 90)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 135)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 180)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 225)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 270)
    TNT1 A 0 A_SpawnItemEx("ScrewBomberShotU", 0, 0, 12, 38, 0, 0, 315)
    stop
  }
}

actor ScrewBomberShotU {
  Translation "192:192=208:208"
  Projectile
  Radius 4
  Height 4
  Scale 2.5
  Speed 38
  +FORCEXYBILLBOARD
  Damage (200)
  DamageType "ScrewBomberU"
  Obituary "%o was shot by a Screw Bomber."
  States {
   Spawn:
    JOSH A 1
    loop
  }
}

actor HazardTag_ScrewBomberU : BasicACSDamager {
  DamageType "ScrewBomberU"
  Obituary "%o was shot by a Screw Bomber while fighting %k."
}

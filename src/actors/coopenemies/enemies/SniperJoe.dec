// A Sniper joe without a shield
actor SniperJoeScoutU : GenericRobot {
  Height 52
  Radius 32
  Obituary "%o was sniped by a Sniper Joe Scout."
  Health 1000
  translation "192:192=4:4", "198:198=102:102"
  maxstepheight 50
  +LOOKALLAROUND
  speed 8
  States {
   Look:
    SNIP A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    SNIP BBBBCCCC 1 A_Chase
    SNIP DDDDEEEE 1 A_Chase("", "Missile")
    loop
   Missile:
    SNIP A 15 A_FaceTarget
    SNIP F 35 A_FaceTarget
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    Goto See
  }
}

actor SniperJoeShotU {
  Projectile
  Damage (100)
  Obituary "%o was sniped by a Sniper Joe Scout."
  DamageType "SniperJoeShot"
  Speed 40
  scale 2.5
  Height 8
  Radius 8
  States {
   Spawn:
    BASB A 1
    loop
  }
}

// A Sniper joe with a shield
// Args0 = Stand still
actor SniperJoeShieldedU : GenericRobot {
  Height 52
  Radius 32
  Obituary "%o was sniped by a Sniper Joe."
  Health 950
  scale 2.5
  translation "192:192=4:4", "198:198=110:110"
  bloodtype "EnemyHurtFX1"
  maxstepheight 50
  painchance 256
  MONSTER
  +MISSILEEVENMORE
  +MISSILEMORE
  +LOOKALLAROUND
  //dropitem "BigWeaponEnergy", 32
  //dropitem "BigHealth", 32
  dropitem "WeaponEnergy", 16
  dropitem "SmallHealth", 16
  mass 99999999
  painsound "misc/devilpain"
  speed 8
  States {
   Look:
    SNIP A 5 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    SNIP B 1
    SNIP B 1 A_JumpIf(Args[0]==1, "See2")
    SNIP B 1 //A_JumpIfTargetInLOS("ShieldUp") // THIS FUNCTION IS BUGGED ONLINE ARGH!
    SNIP BBBB 1 A_Chase
    SNIP A 0// A_JumpIfTargetInLOS("ShieldUp")
    SNIP CCCC 1 A_Chase
    SNIP A 0 //A_JumpIfTargetInLOS("ShieldUp")
    SNIP DDDD 1 A_Chase
    SNIP A 0 //A_JumpIfTargetInLOS("ShieldUp")
    SNIP EEEE 1 A_Chase
    Goto See+3
   See2:
    SNIP A 1 //A_JumpIfTargetInLOS("ShieldUp")
    Goto Missile
   ShieldUp:
   Missile:
    TNT1 A 0 A_SpawnItemEx("SP_SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("SP_SniperJoeShieldFX", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 2 A_FaceTarget
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 30, "ReadyFire")
    loop
   ReadyFire:
    TNT1 A 0 A_TakeInventory("CutterFlag", 1)
    TNT1 A 0 A_SpawnItemEx("SP_SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("SP_SniperJoeShieldFX", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 2 A_FaceTarget
    SNIP A 0 A_Jump(20, "ShieldFire")
    SNIP A 0 //A_JumpIfTargetInLOS("ReadyFire")
    Goto ReadyFire//See
   ShieldFire:
    SNIP F 35 A_FaceTarget
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_PlaySoundEx("misc/devilfire", "Voice")
    SNIP F 0 A_CustomMissile("SniperJoeShotU", 12, 6, 0)
    SNIP F 17
    SNIP F 1 A_JumpIf(Args[0] == 0, "See")
    SNIP A 0 A_ClearTarget
    Goto Look
  }
}

actor SP_SniperJoeShieldFX : BasicGraphicEffect {
  translation "192:192=4:4", "198:198=110:110"
  +NOBLOCKMAP
  +FIXMAPTHINGPOS
  States {
   Spawn:
    SNIP I 2
    stop
  }
}

actor SP_SniperJoeShieldX {
  +MISSILE
  Speed 0
  +DONTSPLASH
  Damage 0
  Height 32
  Radius 25
  health 9999
  scale 2.5
  +SHOOTABLE
  +NOBLOOD
  -SOLID
  //+NOBLOCKMAP
  painchance 256
  bloodtype ""
  +NOTARGETSWITCH
  +DONTRIP
  +GHOST
  //+NOINTERACTION
  +NORADIUSDMG
  //+REFLECTIVE
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 2
    stop
   Death:
    TNT1 A 0 //A_PlaySound("item/protoreflect")
    TNT1 A 1
    stop
   Pain:
    TNT1 A 0
    TNT1 A 2 A_PlaySound("item/protoreflect")
    stop
  }
}

actor SniperArmorU : GenericRobot {
  scale 2.5
  Health 2500
  Height 128
  translation "192:192=34:34", "198:198=239:239"
  painchance 0
  Radius 64
  Obituary "%o was Crushed by a Sniper Armor."
  +SOLID
  maxstepheight 50
  +DROPOFF
  mass 999999
  MONSTER
  +LOOKALLAROUND
  +DONTBLAST
  bloodtype "EnemyHurtFX1"
  speed 0
  painsound "misc/devilpain"
  //dropitem "BigWeaponEnergy", 64
  //dropitem "BigHealth", 64
  dropitem "WeaponEnergy", 32
  dropitem "SmallHealth", 32
  painchance 256
  States {
   Look:
    SNAR B 0 A_ChangeFlag("SOLID", 1)
    SNAR B 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 2000, 0, 360, "See")
    loop
   See:
    SNAR B 20 A_FaceTarget
    SNAR BA 6 A_FaceTarget
    SNAR C 0 A_Recoil(-15)
    SNAR C 1 A_FaceTarget
    SNAR C 10 ThrustThingZ(0, 50, 0, 0)
    Goto Leaping
   Leaping:
    SNAR C 0 A_SpawnItemEx("BigEyeStompU")
    SNAR C 1 A_FaceTarget
    SNAR C 1 A_JumpIf(Floorz-z == 0, "Land")
    loop
   Land:
    SNAR A 0 A_PlaySoundEx("weapon/timestopper", "Voice")
    SNAR A 1 A_FaceTarget
    SNAR A 4 A_Stop
    SNAR BBBBBB 6 A_FaceTarget
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 10 A_CustomMissile("SniperArmorShotU", 70, 0, random(-8, 8))
    SNAR B 2 A_ClearTarget
    Goto Look
   Death:
    SNAR A 0 A_Stop
    SNAR A 0 A_Pain
    SNAR A 0 A_Fall
    SNAR A 0 A_ChangeFlag("NOGRAVITY", 1)
    SNAR A 0 A_SpawnItemEx("ReturningSniperJoeU", 0, 0, 70, 0, 0, 12)
    TNT1 AAAAAA 2 A_SpawnItemEx("ExplosionEffect2", random(-128, 128), random(-128, 128), random(0, 128))
    TNT1 A -1
    stop
  }
}

actor SniperArmorShotU {
  Projectile
  Damage (90)
  DamageType "SniperArmorShot"
  Obituary "%o was shot by a Sniper Armor."
  Speed 70
  scale 2.5
  Height 8
  Radius 8
  SeeSound "misc/devilfire"

actor ReturningSniperJoeU_Z : ReturningSniperJoeU {
  Translation "192:192=4:4", "198:198=103:103"
  States {
   ShieldUp:
   Missile:
    TNT1 A 0 A_SpawnItemEx("SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("ReturningSniperJoeShieldFX_Z", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 2 A_FaceTarget
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 30, "ReadyFire")
    loop
   ReadyFire:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    TNT1 A 0 A_SpawnItemEx("SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("ReturningSniperJoeShieldFX_Z", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 2 A_FaceTarget
    SNIP A 0 A_Jump(20, "ShieldFire")
    SNIP A 0 //A_JumpIfTargetInLOS("ReadyFire")
    Goto ReadyFire//See

   ShieldFire:
    SNIP F 0 A_FaceTarget
    SNIP F 0 ThrustThingZ(0, 28, 0, 1)
    SNIP F 0 A_CustomMissile("SniperArmorShotU_Z", 12, 6, 0)
    SNIP F 5
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_CustomMissile("SniperArmorShotU_Z", 12, 6, 0)
    SNIP F 5
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_CustomMissile("SniperArmorShotU_Z", 12, 6, 0)
    SNIP F 5
    SNIP A 0 A_JumpIf(Args[0] == 0, "See")
    SNIP A 0 A_ClearTarget
    Goto Look
  }
}


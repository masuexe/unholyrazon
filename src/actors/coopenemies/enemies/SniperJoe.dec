actor SniperArmorU_DEM : SniperArmorU {
  States {
   Land:
    SNAR A 0 A_PlaySoundEx("weapon/timestopper", "Voice")
    SNAR A 1 A_FaceTarget
    SNAR A 0 A_Stop
    SNAR B 0 A_FaceTarget
    SNAR B 2 A_CustomMissile("SniperArmorShotU_DEM", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 2 A_CustomMissile("SniperArmorShotU_DEM", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 2 A_CustomMissile("SniperArmorShotU_DEM", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 2 A_CustomMissile("SniperArmorShotU_DEM", 70, 0, random(-8, 8))
    SNAR B 0 A_FaceTarget
    SNAR B 2 A_CustomMissile("SniperArmorShotU_DEM", 70, 0, random(-8, 8))
    SNAR B 0 A_ClearTarget
    Goto Look
   See:
    SNAR B 0 A_FaceTarget
    SNAR BA 6 A_FaceTarget
    SNAR C 0 A_Recoil(-15)
    SNAR C 1 A_FaceTarget
    SNAR C 10 ThrustThingZ(0, 50, 0, 0)
    Goto Leaping
   Death:
    SNAR A 0 A_Stop
    SNAR A 0 A_Pain
    SNAR A 0 A_Fall
    SNAR A 0 A_ChangeFlag("NOGRAVITY", 1)
    SNAR A 0 A_SpawnItemEx("ReturningSniperJoeU_DEM", 0, 0, 70, 0, 0, 12)
    TNT1 AAAAAA 2 A_SpawnItemEx("ExplosionEffect2", random(-128, 128), random(-128, 128), random(0, 128))
    TNT1 A -1
    stop
  }
}

actor SniperArmorShotU_DEM {
  Projectile
  Damage (0)
  DamageType "SniperArmorShot"
  Speed 40
  scale 2.5
  Height 32
  Radius 16
  +RIPPER
  +NOINTERACTION
  SeeSound "misc/devilfire"
  reactiontime 100
  States {
   Spawn:
    MMFX B 0
    MMFX B 0 ThrustThingZ(0, 28, 1, 1)
   SpawnL:
    MMFX B 0 ThrustThingZ(0, 8, 0, 1)
    MMFX B 2 A_Explode(150, 20, 0, 0, 20)
    MMFX C 0 ThrustThingZ(0, 8, 0, 1)
    MMFX C 2 A_Explode(150, 20, 0, 0, 20)
    MMFX C 0 A_Countdown
    loop
   Death:
    TNT1 A 1
    stop
  }
}

actor ReturningSniperJoeU_DEM : ReturningSniperJoeU {
  args 1
  States {
   See2:
    SNIP A 1
    Goto Missile
   ShieldUp:
   Missile:
    TNT1 A 0 A_SpawnItemEx("SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("ReturningSniperJoeShieldFX", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 2 A_FaceTarget
    goto ReadyFire
   ReadyFire:
    TNT1 A 0 A_TakeInventory("CutterFlag")
    TNT1 A 0 A_SpawnItemEx("SniperJoeShieldX", 23, -7, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    TNT1 A 0 A_SpawnItemEx("ReturningSniperJoeShieldFX", 23, -17, 8, momx, momy, momz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEMOMENTUM, 0)
    SNIP A 1 A_FaceTarget
    TNT1 A 0 A_GiveInventory("KnightFlag", 1)
    TNT1 A 0 A_JumpIfInventory("KnightFlag", 17, "ShieldFire")
    SNIP A 0 //A_JumpIfTargetInLOS("ReadyFire")
    Goto ReadyFire//See
   ShieldFire:
    SNIP F 0 A_TakeInventory("KnightFlag")
    SNIP F 2 A_FaceTarget
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_CustomMissile("SniperArmorShotU_DEM", 12, 6, 0)
    SNIP F 20
    SNIP F 0 A_FaceTarget
    SNIP F 0 A_CustomMissile("SniperArmorShotU_DEM", 12, 6, 0)
    SNIP F 1
    SNIP A 0 A_JumpIf(Args[0] == 0, "See")
    SNIP A 0 A_ClearTarget
    Goto Look
  }
}

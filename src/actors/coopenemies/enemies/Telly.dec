actor TellyEnemyU : GenericRobot replaces Telly {
  Height 40
  Radius 32
  Health 50
  species "Telly"
  Obituary "%o was bashed by a Telly."
  +FLOAT
  -SOLID
  +NOGRAVITY
  +LOOKALLAROUND
  dropitem ""
  speed 6
  floatspeed 3
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_overflowcheck_TellyEnemyU", 0, 30)
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
   Look:
    TNT1 A 0 //A_PlaySoundEx("enemy/telly", "Body")
    TELY ABCODPEF 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    TELY A 0 A_GiveInventory("CutterFlag", 1)
    TELY A 0 A_JumpIfInventory("CutterFlag", 30, "DeathQuiet")
    loop
   See:
    TNT1 A 0 //A_PlaySoundEx("enemy/telly", "Body")
    TELY AAAABBBBCCCCOOOO 1 A_Chase
    TNT1 A 0// A_PlaySoundEx("enemy/telly", "Body")
    TELY DDDDPPPPEEEEFFFF 1 A_Chase
    TELY A 0 A_GiveInventory("CutterFlag", 1)
    TELY A 0 A_JumpIfInventory("CutterFlag", 30, "DeathQuiet")
    loop
   Melee:
    TELY A 0 A_FaceTarget
    TELY A 0 A_CustomMeleeAttack(100, "", "", "TellyEnemy")
    TELY AAAABBBBCCCCOOOODDDDPPPPEEEEFFFF 1 A_Chase("", "")
    Goto See
  }
}
actor HazardTag_TellyEnemy : BasicACSDamager {
  DamageType "TellyEnemy"
  Obituary "%o was bashed by a Telly while fighting %k."
}

actor MetEnemyU : GenericRobot {
  Health 100
  Height 50
  painchance 0
  Radius 32
  Obituary "%o was shot by a metool."
  +SOLID
  maxstepheight 50
  +DROPOFF
  +LOOKALLAROUND
  +INVULNERABLE
  +NOBLOOD
  +DONTBLAST
  speed 8
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
   Look:
    METT D 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 350, 0, 360, "See")
    loop
   See:
    METT DDDDDDD 5 A_JumpIfCloser(56, "Missile")
   Missile:
    METT E 1 A_ChangeFlag("NOBLOOD", 0)
    METT E 4 A_ChangeFlag("INVULNERABLE", 0)
    METT F 1 A_FaceTarget
    METT F 0 A_CustomMissile("MetEnemyShotU", 8, 0, -18, 0)
    METT F 0 A_CustomMissile("MetEnemyShotU", 8, 0, 18, 0)
    METT F 5 A_CustomMissile("MetEnemyShotU", 8, 0, 0, 0)
    METT B 4
    METT B 1 A_JumpIf(Args[0] == 1, "Hide")
    METT AAABBBCCCBBB 1 A_Chase("", "")
    METT AAABBBCCCBBB 1 A_Chase("", "")
   Hide:
    METT BE 5
    METT E 0 A_ChangeFlag("NOBLOOD", 1)
    METT D 5 A_ChangeFlag("INVULNERABLE", 1)
    METT D 2 A_ClearTarget
    Goto Look
  }
}

actor MetEnemyShotU {
  PROJECTILE
  Damage (60)
  damagetype "MetEnemyShot"
  Speed 18
  scale 2.5
  Height 8
  Radius 8
  SeeSound "misc/devilfire"
  States {
   Spawn:
    BASB A 1
    loop
  }
}

actor HazardTag_MetEnemyShot : BasicACSDamager {
  damagetype "MetEnemyShot"
  Obituary "%o was shot by a metool while fighting %k."
}

actor MetEnemyU_3BC : MetEnemyU {
  Translation "216:217=193:193"
  speed 16
  States {
   Look:
    METT D 3 A_LookEx(LOF_NOSOUNDCHECK, 0, 350, 0, 360, "See")
    loop
   See:
    METT DDDDD 4 A_JumpIfCloser(56, "Missile")
   Missile:
    METT E 0 A_ChangeFlag("NOBLOOD", 0)
    METT E 3 A_ChangeFlag("INVULNERABLE", 0)
    METT F 0 ACS_NamedExecuteWithResult("core_lookatptr", 2)
    METT F 0 A_PlaySoundEx("misc/devilfire", 1)
    goto Attack
   Attack:
    METT F 0 A_Jump(128, "Attack2")
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 12*cos(-pitch), 0, 12*sin(-pitch), -10, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 18*cos(-pitch), 0, 18*sin(-pitch), 0, 0)
    METT F 1 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 24*cos(-pitch), 0, 24*sin(-pitch), 10, 0)
    goto AttackEnd
   Attack2:
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 12*cos(-pitch), 0, 12*sin(-pitch), 10, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 18*cos(-pitch), 0, 18*sin(-pitch), 0, 0)
    METT F 1 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 24*cos(-pitch), 0, 24*sin(-pitch), -10, 0)
   AttackEnd:
    METT B 18
    METT B 0 A_JumpIf(Args[0] == 1, "Hide")
    METT AAABBBCCCBBB 1 A_Chase("", "")
   Hide:
    METT BE 1
    METT E 0 A_ChangeFlag("NOBLOOD", 1)
    METT D 1 A_ChangeFlag("INVULNERABLE", 1)
    METT D 1 A_ClearTarget
    Goto Look
  }
}

actor MetEnemyU_Exile : MetEnemyU {
  var int user_shotCount;
  Speed 16
  States {
   Look:
    METT D 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 350, 0, 360, "See")
    loop
   See:
    METT F 0 A_SetUserVar("user_shotCount", 9)
    METT DDDDDD 6 A_JumpIfCloser(56, "Missile")
   Missile:
    METT E 0 A_ChangeFlag("NOBLOOD", 0)
    METT E 0 A_ChangeFlag("INVULNERABLE", 0)
    METT F 0 ACS_NamedExecuteWithResult("core_lookatptr", 2)
   Attack:
    METT F 0 A_JumpIf(user_shotCount == 0, "AttackEnd")
    METT F 0 A_PlaySoundEx("misc/devilfire", "Weapon")
    METT F 0 A_CustomMissile("MetEnemyShotU_Exile", 8, 0, -18, 0)
    METT F 0 A_CustomMissile("MetEnemyShotU_Exile", 8, 0, 18, 0)
    METT F 0 A_CustomMissile("MetEnemyShotU_Exile", 8, 0, 0, 0)
    METT F 0 ThrustThingZ(0, 4, 0, 1)
    METT DEFB 1
    METT F 0 A_SetUserVar("user_shotCount", user_shotCount - 1)
    loop
   AttackEnd:
    METT B 0 A_JumpIf(Args[0] == 1, "Hide")
    METT AAABBBCCCBBB 1 A_Chase("", "")
   Hide:
    METT BE 5
    METT E 0 A_ChangeFlag("NOBLOOD", 1)
    METT D 5 A_ChangeFlag("INVULNERABLE", 1)
    METT D 2 A_ClearTarget
    Goto Look
  }
}

actor MetEnemyShotU_Exile : MetEnemyShotU {
  Translation "192:192=216:216"
  SeeSound ""
  States {
   Spawn:
    X_2D ABCD 1
    loop
  }
}

actor MetEnemyU_Z : MetEnemyU {
  Speed 10
  States {
   See:
    METT DDDDDDD 5 A_JumpIfCloser(56, "Missile")
   Missile:
    METT E 1 A_ChangeFlag("NOBLOOD", 0)
    METT E 4 A_ChangeFlag("INVULNERABLE", 0)
    METT F 1 A_FaceTarget
    METT F 0 A_CustomMissile("MetEnemyShotU_Z", 8, 0, -18, 0)
    METT F 0 A_CustomMissile("MetEnemyShotU_Z", 8, 0, 18, 0)
    METT F 5 A_CustomMissile("MetEnemyShotU_Z", 8, 0, 0, 0)
    METT B 4
    METT B 1 A_JumpIf(Args[0]==1, "Hide")
    METT B 0 ThrustThing(angle * 256 / 360, 10, 1, 0)
    METT B 0 ThrustThingZ(0, 60, 0, 1)
    METT AAABBBCCCBBB 1 A_Chase("", "")
    METT AAABBBCCCBBB 1 A_Chase("", "")
   Hide:
    METT BE 5
    METT E 0 A_ChangeFlag("NOBLOOD", 1)
    METT D 5 A_ChangeFlag("INVULNERABLE", 1)
    METT D 2 A_ClearTarget
    Goto Look
  }
}

actor MetEnemyShotU_Z : CrashBomb {
  Translation "225:225=228:228"
  Damage (90)
  damagetype "MetEnemyShot"
  Obituary "%o was shot by a metool."
  Speed 10
}

actor MetEnemyU_2Core : MetEnemyU {
  Translation "216:217=71:71"
  Health 600
  States {
   Look:
    METT D 6 A_LookEx(LOF_NOSOUNDCHECK, 0, 350, 0, 360, "See")
    loop
   See:
    METT DDDDDDD 5 A_JumpIfCloser(56, "Missile")
   Missile:
    METT E 0 A_ChangeFlag("NOBLOOD", 0)
    METT E 5 A_ChangeFlag("INVULNERABLE", 0)
    METT F 0 ACS_NamedExecuteWithResult("core_lookatptr", 2)
    METT F 0 A_PlaySoundEx("misc/devilfire", 1)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 9*cos(-pitch), 0, 9*sin(-pitch), 0, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 18*cos(-pitch), 0, 18*sin(-pitch), 0, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 18*cos(-pitch), 0, 18*sin(-pitch), -60, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 18*cos(-pitch), 0, 18*sin(-pitch), 60, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 42*cos(-pitch), 0, 42*sin(-pitch), 0, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 42*cos(-pitch), 0, 42*sin(-pitch), -45, 0)
    METT F 0 A_SpawnItemEx("MetEnemyShotU", 0, 0, 8, 42*cos(-pitch), 0, 42*sin(-pitch), 45, 0)
    METT F 5
    METT B 4
    METT B 0 A_JumpIf(Args[0] == 1, "Hide")

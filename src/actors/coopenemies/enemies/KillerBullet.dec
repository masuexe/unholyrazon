actor KillerBulletU : GenericRobot replaces KillerBullet {
  Health 100
  Radius 16
  Height 24
  Speed 24
  FloatSpeed 12
  +MISSILE
  +RIPPER
  +BLOODLESSIMPACT
  +DONTREFLECT
  +NOGRAVITY
  +LOOKALLAROUND
  +DONTBLAST
  -SOLID
  Damage (0)
  DamageType "KillerBulletU"
  DropItem ""
  Obituary "%o was struck by a Killer Bullet."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
   Patrol:
    KLRB A 0 A_ChangeVelocity(12, 0, 0, CVF_RELATIVE | CVF_REPLACE)
   Look:
    KLRB A 4 A_LookEx(LOF_NOSOUNDCHECK, 0, 1024, 0, 360, "See")
    loop
   See:
    KLRB A 0 A_FaceTarget(0, 0)
    // Zandronum A_FaceTarget computes positive pitch toward higher targets.
    // Convert to the actor pitch convention used by the velocity formula.
    KLRB A 0 A_SetPitch(-pitch)
    KLRB A 0 A_ChangeVelocity(cos(pitch) * 24, 0, -sin(pitch) * 24, CVF_RELATIVE | CVF_REPLACE)
   Charge:
    KLRB A 4
    loop
   Death:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_PlaySoundEx("weapons/mm1/hyperbombexplode", "Weapon")
    TNT1 A 0 A_Explode(300, 180, XF_NOTMISSILE)
    TNT1 A 1 A_SpawnItemEx("ExplosionEffect3")
    stop
  }
}

actor HazardTag_KillerBulletU : BasicACSDamager {
  DamageType "KillerBulletU"
  Obituary "%o was struck by a Killer Bullet while fighting %k."
}

actor CrazyCannonU : GenericRobot {
  Height 46
  Radius 40
  Obituary "%o was bombarded by a Crazy Cannon."
  Health 800
  MaxStepHeight 50
  States {
   Look:
   Shooting:
    CRAC AAAAAA 19 A_GiveInventory("FireCrazyShotU_P")
    CRAC ABDCDFE 3
    CRAC EEEEEE 19 A_GiveInventory("FireCrazyShotU_P2")
    CRAC EFDCDBA 3
    loop
  }
}

actor FireCrazyShotU_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK | LOF_NOJUMP, 0, 750, 0, 360)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("CrazyDamagerU", 0, 0, 0)
    TNT1 A 0 A_PlaySoundEx("misc/devilfire", "Voice")
    TNT1 A 0 A_JumpIf(true, "Fire")
   Fire:
    TNT1 A 0 A_SpawnItemEx("CrazyShotU", 32, 0, 32, random(26, 34), random(-1, 1), 6)
    stop
  }
}
actor FireCrazyShotU_P2 : FireCrazyShotU_P {
  States {
   Fire:
    TNT1 A 0 A_SpawnItemEx("CrazyShotU", 24, 0, 64, random(6, 10), random(-1, 1), 14)
    stop
  }
}
actor FireCrazyShotU_DEM_P : FireCrazyShotU_P {
  States {
   Fire:
    TNT1 A 0 A_SpawnItemEx("CrazyShotU_DEM", 32, 0, 32, random(26, 34), random(-1, 1), 6)
    stop
  }
}
actor FireCrazyShotU_DEM_P2 : FireCrazyShotU_P {
  States {
   Fire:
    TNT1 A 0 A_SpawnItemEx("CrazyShotU_DEM", 24, 0, 64, random(6, 10), random(-1, 1), 14)
    stop
  }
}

actor CrazyShotU {
  Projectile
  Radius 12
  +BLOODSPLATTER
  +MTHRUSPECIES
  DamageType "CrazyCannonU"
  Height 12
  Damage (60)
  Speed 0
  Scale 2.5
  args 4
  States {
   Spawn:
    BASB A 1 ThrustThingZ(0, args[0], 1, 1)
    loop
  }
}

actor CrazyDamagerU {
  Projectile
  DamageType "CrazyCannonU"
  +THRUGHOST
  +DONTBLAST
  Damage (140)
  Speed 0
  Radius 36
  Height 48
  States {
   Spawn:
    TNT1 A 20
    stop
  }
}

actor HazardTag_CrazyCannonU : BasicACSDamager {
  DamageType "CrazyCannonU"
  Obituary "%o was bombarded by a Crazy Cannon while fighting %k."
}

actor CrazyCannonU_DEM : CrazyCannonU {
  States {
   Look:
   Shooting:
    CRAC AAAAAAAA 2 A_GiveInventory("FireCrazyShotU_DEM_P")
    CRAC ABDCDFE 3
    CRAC EEEEEEEE 2 A_GiveInventory("FireCrazyShotU_DEM_P2")
    CRAC EFDCDBA 3
    loop
  }
}
actor CrazyCannonU_DEM_Color2 : CrazyCannonU_DEM {translation "229:229=211:211", "41:41=201:201"}

actor CrazyShotU_DEM : CrazyShotU {
  Translation "213:213=74:74"
  Damage (60)
  args 6
}

actor FleaU : GenericRobot {
  Height 18
  Radius 18
  Health 200
  //MeleeRange 60
  Obituary "%o was tickled by a Flea."
  maxstepheight 50
  +DROPOFF
  +LOOKALLAROUND
  States {
   Look:
    FLEA A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 2000, 0, 360, "See")
    loop
   See:
    FLEA A 0 A_Stop
    FLEA AAAAAAAAAAAAAAA 1 A_Chase
    Goto Leap
   Leap:
    FLEA B 0 A_PlaySoundEx("weapon/crackermine", "voice")
    FLEA B 0 A_FaceTarget
    FLEA B 0 A_Recoil(-23)
    FLEA B 10 ThrustThingZ(0, 50, 0, 0)
    Goto Leaping
   Leaping:
    FLEA B 0 A_JumpIf(floorz-z==0, "See")
    FLEA B 1 A_Chase
    loop
   Melee:
    FLEA A 0 A_FaceTarget
    FLEA A 0 A_CustomMeleeAttack(150, "", "", "FleaU")
    FLEA B 12
    Goto See
  }
}
actor HazardTag_FleaU : BasicACSDamager {
  DamageType "FleaU"
  Obituary "%o was tickled by a Flea while fighting %k."
}

actor FleaU_Claw : FleaU {
  translation "4:4=87:87", "41:41=109:109"
  States {
   Look:
    FLEA A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 2000, 0, 360, "See")
    loop
   See:
    FLEA A 0 A_Stop
    FLEA AA 1 A_Chase
    Goto Leap
   Leap:
    FLEA B 0 A_PlaySoundEx("weapon/crackermine", "voice")
    FLEA B 0 A_FaceTarget
    FLEA B 0 A_Jump(256, "Leap0", "Leap1", "Leap2")
   Leap0:
    FLEA B 0 A_Recoil(-23)
    FLEA B 2 ThrustThingZ(0, 50, 0, 0)
    Goto Leaping
   Leap1:
    FLEA B 0 A_Recoil(-30)
    FLEA B 2 ThrustThingZ(0, 41, 0, 0)
    Goto Leaping
   Leap2:
    FLEA B 0 A_Recoil(-7)
    FLEA B 2 ThrustThingZ(0, 32, 0, 0)
    Goto Leaping
   Leaping:
    FLEA B 0 A_JumpIf(floorz-z==0, "See")
    FLEA B 1 A_Chase
    loop
   Melee:
    FLEA A 0 A_FaceTarget
    FLEA A 0 A_CustomMeleeAttack(150, "", "", "FleaU")
    FLEA B 12
    Goto See
  }
}

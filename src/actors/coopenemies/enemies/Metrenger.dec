actor MetrengerSpawnerU : MetrengerSpawner replaces MetrengerSpawner {
  States {
   Spawn:
    WORM E 2100
    WORM FGHIJK 4
    WORM E 1 A_SpawnItemEx("Metrenger", 0, 0, -35)
    loop
  }
}

actor MetrengerU : GenericRobot replaces Metrenger {
  Health 200
  Height 10
  Radius 35
  Speed 1
  +CANPASS
  +FLOORCLIP
  +NODAMAGETHRUST
  -SOLID
  DropItem ""
  DamageType "MetrengerU"
  Obituary "%o was run over by a Metrenger."
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
   Falling:
    WORM L 1 A_CheckFloor("Wander")
    loop
   Wander:
    WORM A 0 A_Explode(200, 35, XF_NOTMISSILE, 0, 35)
    WORM AABBCCDDCCBB 2 A_Wander
    loop
  }
}

actor HazardTag_MetrengerU : BasicACSDamager {
  DamageType "MetrengerU"
  Obituary "%o was run over by a Metrenger while fighting %k."
}

actor SpaceMetallU : GenericRobot replaces SpaceMetall {
  Height 40
  Radius 32
  Health 50
  Species "SpaceMetall"
  Obituary "%o was bashed by a Space Metall."
  +FLOAT
  -SOLID
  +NOGRAVITY
  +LOOKALLAROUND
  DropItem ""
  Speed 6
  FloatSpeed 6
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_overflowcheck_SpaceMetall", 0, 30)
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
   Look:
    METQ ABCDCB 3 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "See")
    loop
   See:
    METQ AABBCCDDCCBB 1 A_Chase
    loop
   Melee:
    METQ A 0 A_FaceTarget
    METQ A 0 A_CustomMeleeAttack(300, "", "", "SpaceMetallU")
    METQ AABBCCDDCCBB 1 A_Chase("", "")
    goto See
  }
}

actor HazardTag_SpaceMetallU : BasicACSDamager {
  DamageType "SpaceMetallU"
  Obituary "%o was bashed by a Space Metall while fighting %k."
}

actor ToadmanBossU : GenericRobotBoss {
  Translation "192:192=215:215", "198:198=104:104"
  HitObituary "%o was crushed by \cdToad Man\c-."
  Obituary "%o was eroded by \cdToad Man\c-."
  Radius 32
  Height 64
  painchance 240
  MeleeRange 52
  Speed 0
  States {
   Look:
    TOAD K 0 A_ClearTarget
    TOAD A 0 A_ChangeFlag("INVULNERABLE", 0)
    TOAD A 5 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "Found")
    wait
   Found:
    TOAD A 20 A_Chase
    goto See
   See:
    TOAD A 10 A_FaceTarget
    goto AttackRain

   Pain:
    TOAD B 12 A_ChangeFlag("NOPAIN", 1)
    TOAD B 1 A_JumpIfInventory("CutterFlag", 1, "Hide")
    goto Leap

   AttackRain:
    TOAD F 0 A_ChangeFlag("NOPAIN", 0)
    TOAD F 0 A_FaceTarget
    TOAD EJFGFG 5
    TOAD F 0 A_CustomMissile("ToadmanRainFlushU", 42, 0, 0)
    TOAD F 0 A_ChangeFlag("NOPAIN", 1)
    TOAD JFGFG 5
    TOAD A 10
    TOAD A 1 A_JumpIfInventory("CutterFlag", 1, "Hide")
    goto Leap

   Land:
    TOAD B 0 A_SpawnItemEx("ToadmanLandU", 0, 0, 32)
    TOAD B 1 A_JumpIfInventory("CutterFlag", 1, "Hide")
    TOAD B 4 A_ChangeVelocity(0.0, 0.0, 0.0, CVF_REPLACE | CVF_RELATIVE)
    TOAD A 10
    goto AttackRain

   Leap:
    TOAD B 0 A_SpawnItemEx("ToadmanLandU", 0, 0, 32)
    TOAD B 1 A_FaceTarget
    TOAD B 1  // A_SetAngle(angle + random(-32,32))
    TOAD C 10 A_ChangeVelocity(17.0, 0.0, 15.0, CVF_REPLACE | CVF_RELATIVE)
    goto Leaping
   Melee:
    TOAD C 5  // A_CustomMeleeAttack(20)
    goto Leaping

   Leaping:
    // TOAD C 1 A_Chase("Melee", "")
    TOAD C 1 A_JumpIf(floorz - z == 0, "Land")
    loop

   WaterLeap:
    TOAD A 0 A_Stop
    TOAD A 0 A_ChangeFlag("INVULNERABLE", 0)
    TOAD A 0  // A_ChangeFlag("SOLID",1)
    TOAD A 0 A_ChangeFlag("SHOOTABLE", 1)
    TOAD A 0 A_SpawnItemEx("ToadSplashU", 0, 0, 32)
    goto Leap+1
   WaterAttack:
    TOAD A 0 A_Stop
    TOAD A 0 A_ChangeFlag("INVULNERABLE", 0)
    TOAD A 0  // A_ChangeFlag("SOLID",1)
    TOAD A 0 A_ChangeFlag("SHOOTABLE", 1)
    TOAD A 0 A_SpawnItemEx("ToadSplashU", 0, 0, 32)
    TOAD BA 6
    goto AttackRain
  }
}

actor ToadSplashU {
  +NOINTERACTION
  Height 1
  Radius 1
  +NOGRAVITY
  Scale 2.5
  -SOLID
  States {
   Spawn:
    DOLP B 5
    DOLP C 5 A_PlaySoundEx("misc/splash", "Voice")
    DOLP DE 5
    stop
  }
}

actor ToadmanLandU {
  Projectile
  Obituary "%o was crushed by \cdToad Man\c-."
  Radius 1
  Height 1
  DamageType "ToadmanBossU"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_Explode(500, 130, 0)
    stop
  }
}

actor ToadmanRainFlushU {
  DamageType "ToadmanBossU"
  +NOGRAVITY
  +MISSILE
  +SKYEXPLODE
  +NOINTERACTION
  Height 1
  Radius 1
  -SOLID
  ReactionTime 35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("weapon/rainflush", "Voice")
    TNT1 A 0 A_Explode(470, 512, 0)
    TNT1 A 0 A_SpawnItemEx("RainFlushSoakify")
   SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("RainSprinkleToadU", random(-384, 384), random(-384, 384), 256, -30, 0, -30, 90, SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("RainSprinkleToadU", random(-384, 384), random(-384, 384), 256, -30, 0, -30, 90, SXF_CLIENTSIDE)
    TNT1 A 0 A_Countdown
    loop
   Death:
    TNT1 A 0
    stop
  }
}

actor HazardTag_ToadmanBossU : BasicACSDamager {
  DamageType "ToadmanBossU"
  Obituary "%o was eroded by Toad Man while fighting %k."
}

actor RainSprinkleToadU {
  +CLIENTSIDEONLY
  +NOINTERACTION
  -SOLID
  +NOGRAVITY
  Translation "196:196=217:217", "197:197=193:193"
  Height 0
  Radius 0
  Scale 2.5
  States {
   Spawn:
    CRAI D 30
    stop
  }
}

actor ToadmanBossU_4BCAS : ToadmanBossU {
  Translation "192:192=4:4", "198:198=42:42"
  HitObituary "%o was crushed by \cgToad Man\c-."
  Obituary "%o was eroded by \cgToad Man\c-."
  States {
   Look:
    TOAD K 0 A_ClearTarget
    TOAD A 0 A_ChangeFlag("INVULNERABLE", 0)
    TOAD A 5 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "Found")
    wait
   Found:
    TOAD A 20 A_Chase
    goto See
   See:
    TOAD A 10 A_FaceTarget
    goto AttackRain

   Pain:
    HEAM I 0 A_Pain
    // HEAM I 0 A_SpawnItemEx("PainFX")
    TOAD F 0 A_FaceTarget
    TOAD F 0 A_CustomMissile("ToadmanBossShotU_4BCAS", 42, 0, 0)
    TOAD I 12  // A_ChangeFlag("NOPAIN",1)
    goto AttackSelect

   AttackSelect:
    TOAD I 0 A_Jump(128, "AttackRain")
    goto Leap

   AttackRain:
    TOAD F 0  // A_ChangeFlag("NOPAIN",0)
    TOAD F 0 A_FaceTarget
    TOAD EJFGFG 4
    TOAD F 0 A_CustomMissile("ToadmanRainFlushU", 42, 0, 0)
    TOAD F 0  // A_ChangeFlag("NOPAIN",1)
    TOAD JFGFG 4
    TOAD A 10
    goto AttackSelect

   Land:
    TOAD B 0 A_SpawnItemEx("ToadmanLandU", 0, 0, 32)
    TOAD B 4 A_ChangeVelocity(0.0, 0.0, 0.0, CVF_REPLACE | CVF_RELATIVE)
    TOAD A 1
    goto AttackRain

   Leap:
    TOAD B 0 A_SpawnItemEx("ToadmanLandU", 0, 0, 32)
    TOAD B 1 A_FaceTarget
    TOAD B 1  // A_SetAngle(angle + random(-32,32))
    TOAD C 10 A_ChangeVelocity(17.0, 0.0, 15.0, CVF_REPLACE | CVF_RELATIVE)
    goto Leaping
   Melee:
    TOAD C 5  // A_CustomMeleeAttack(20)
    goto Leaping

   Leaping:
    // TOAD C 1 A_Chase("Melee", "")
    TOAD C 1 A_JumpIf(floorz - z == 0, "Land")
    loop
  }
}

actor ToadmanBossShotU_4BCAS : FastProjectile {
  Projectile
  DamageType "ToadmanBossU"
  Obituary "%o was shot by \cgToad Man\c-."
  Damage (200)
  Radius 20
  Height 40
  Speed 72
  Scale 2.5
  States {
   Spawn:
    MMFX EDCBCDE 2
    loop
   Death:
    TNT1 A 1
    stop
  }
}

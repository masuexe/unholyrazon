actor HeatManBossU : GenericRobotBoss {
  translation "192:192=229:229", "198:198=41:41"
  Obituary "%o was melted by \ckHeat Man\c-."
  Height 52
  Radius 20
  MeleeRange 100
  speed 0
  States {
   Look:
    HEAM K 0 A_ClearTarget
    HEAM A 0 A_ChangeFlag("INVULNERABLE", 0)
    HEAM A 5 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "Found")
    wait
   Found:
    HEAM A 20
    Goto See
   See:
    HEAM A 10 A_FaceTarget
    HEAM A 15 A_TakeInventory("CutterFlag", 1)
    Goto Attack1

   Attack1:
    HEAM G 0 //A_ChangeFlag("SOLID",1)
    HEAM F 5 A_FaceTarget
    HEAM GG 0 A_SpawnItemEx("HeatManFlamePillarProjectileU", 0, 0, 20, 10, 0, random(6, 25), random(-60, 5))
    HEAM GG 0 A_SpawnItemEx("HeatManFlamePillarProjectileU", 0, 0, 20, 10, 0, random(6, 25), random(5, 60))
    HEAM G 0// A_SpawnItemEx("HeatManFlamePillarProjectileU",0,0,20,10,0,random(6,25),0)
    HEAM G 10
    HEAM A 5
    HEAM A 0 A_JumpIfInventory("AtomicFireAmmo", 1, "SuperReady")
    Goto Attack2

   SuperReady:
    HEAM A 0 A_TakeInventory("AtomicFireAmmo", 1)
    Goto Attack2

   Attack2:
    HEAM I 7
    HEAM G 0 A_ChangeFlag("NOBLOOD", 1)
    HEAM G 0 //A_ChangeFlag("SOLID",0)
    HEAM G 0 A_ChangeFlag("INVULNERABLE", 1)
    HEAM LMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLM 1 A_SpawnItemEx("HeatManRadiusU")
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, 32, 32)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, -32, -32)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, 32, -32)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, -32, 32)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, 0, 64)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, 64, 0)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 0, -64, 0)
    TNT1 A 3 A_SpawnItemEx("HeatManDashFX", 0, 0, -64)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 32, 0, 0)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 32, -32, 0)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 32, 32, -0)
    TNT1 A 0 A_SpawnItemEx("HeatManDashFX", 32, 0, 32)
    TNT1 A 6 A_SpawnItemEx("HeatManDashFX", 32, 0, -32)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_PlaySoundEx("weapon/atomicfire", "Voice", 0, 1)
    Goto Dash

   Dash:
    TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 80, 0, 360, "DashEnd")
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Stop
    TNT1 A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 0 A_GiveInventory("CutterFlag", 1)
    TNT1 A 0 A_JumpIfInventory("CutterFlag", 18, "DashEnd")
    TNT1 A 1 A_Recoil(-45)
    loop

   DashEnd:
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-45)
    HEAM P 0 A_Stop
    HEAM A 0 A_ChangeFlag("INVULNERABLE", 0)
    HEAM A 0 A_ChangeFlag("NOBLOOD", 0)
    HEAM A 10
    goto Look

   Dash2:
    HEAM P 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 80, 0, 360, "DashEnd")
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManFlamePillarSuperU", 0, 0, 0, 0)
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    HEAM A 0 A_GiveInventory("CutterFlag", 1)
    HEAM A 0 A_JumpIfInventory("CutterFlag", 18, "DashEnd")
    TNT1 A 1 A_Recoil(-35)
    loop
  }
}

actor HazardTag_HeatManBossU : BasicACSDamager {
  DamageType "HeatManBossU"
  Obituary "%o was melted by Heat Man while fighting %k."
}

actor HeatManFlamePillarProjectileU {
  Projectile
  Damage (143)
  +RIPPER
  -NOGRAVITY
  +BRIGHT
  damagetype "HeatManBossU"
  Radius 16
  Height 16
  scale 2.5
  speed 10
  states {
   Spawn:
    HEAM RST 3
    loop
   Death:
    HEAM A 0 A_PlaySoundEx("weapon/pharaoh2", "Body")
    TNT1 A 0 A_SpawnItemEx("HeatManFlamePillarU", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor HeatManFlamePillarU {
  Projectile
  Damage (47)
  +FLOORHUGGER
  +RIPPER
  +BRIGHT
  damagetype "HeatManBossU"
  Radius 16
  Height 64
  scale 2.5
  states {
   Spawn:
    TNT1 A 0
    HEAM RSTRSTRSTRSTRSTRSTRSTRSTRSTRSTRSTRST 3 A_SpawnItemEx("HeatManFlamePillarFX", 0, 0, 0, 0, 0, 5, 0, 1)
    stop
  }
}

actor HeatManFlamePillarFX : BasicGraphicEffect {
  States {
   Spawn:
    HEAM RSTRSTRS 3
    stop
  }
}

actor HeatManDashDamagerU {
  Projectile
  Damage (50)
  Radius 48
  Height 32
  scale 2.5
  states {
   Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("HeatManDashFX", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
  }
}

actor HeatManDashFX : BasicGraphicEffect {
  States {
   Spawn:
    HEAM NOP 3
    stop
  }
}

actor HeatManRadiusU : BasicExplosion {
  damagetype "HeatManBossU"
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Explode(50, 100, 0)
    stop
  }
}

actor HeatManFlamePillarSuperU {
  Projectile
  Damage (10)
  +FLOORHUGGER
  +RIPPER
  damagetype "HeatManBossU"
  Radius 16
  Height 64
  scale 2.5
  states {
   Spawn:
    TNT1 A 0
    HEAM UVWXYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZYZXWVU 4
    stop
  }
}

actor HeatManBossU_DEM : HeatManBossU {
  translation "192:192=225:225", "198:198=44:44", "229:229=213:213", "41:41=216:216"
  Obituary "%o was melted by \ciHeat Man\c-."
  States {
   Look:
    HEAM K 0 A_ClearTarget
    HEAM A 5 A_LookEx(LOF_NOSOUNDCHECK, 0, 0, 0, 360, "Found")
    wait
   Found:
    HEAM A 20
    Goto See
   See:
    HEAM A 10 A_FaceTarget
    HEAM A 15 A_TakeInventory("CutterFlag", 1)
    Goto Attack1

   Attack1:
    HEAM G 0 //A_ChangeFlag("SOLID",1)
    HEAM F 5 A_FaceTarget
    HEAM GG 0 A_SpawnItemEx("HeatManFlamePillarProjectileU", 0, 0, 20, 10, 0, random(6, 25), random(-60, 5), 1)
    HEAM GG 0 A_SpawnItemEx("HeatManFlamePillarProjectileU", 0, 0, 20, 10, 0, random(6, 25), random(5, 60), 1)
    HEAM G 0// A_SpawnItemEx("HeatManFlamePillarProjectileU",0,0,20,10,0,random(6,25),0)
    HEAM G 10 A_ChangeFlag("INVULNERABLE", 0)
    HEAM A 64
    Goto Attack1

   SuperReady:
    HEAM A 0 A_TakeInventory("AtomicFireAmmo", 1)
    Goto Attack2

   Attack2:
    HEAM I 11
    HEAM G 0 A_ChangeFlag("NOBLOOD", 1)
    HEAM G 0 //A_ChangeFlag("SOLID",0)
    HEAM G 0 A_ChangeFlag("INVULNERABLE", 1)
    HEAM G 0 A_ChangeFlag("BRIGHT", 1)
    HEAM L 1 A_SpawnItemEx("HeatManRadiusU")
    HEAM A 0 A_FaceTarget
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, 0, 0, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, 32, 32, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, -32, -32, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, 32, -32, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, -32, 32, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, 0, 64, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, 64, 0, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 0, -64, 0, 0, 0, 0, 0, 1)
    TNT1 A 2 A_SpawnItemEx("HeatManDashFX", 0, 0, -64, 0, 0, 0, 0, 1)
    HEAM A 0 A_FaceTarget
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 32, 0, 0, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 32, -32, 0, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 32, 32, -0, 0, 0, 0, 0, 1)
    HEAM A 0 A_SpawnItemEx("HeatManDashFX", 32, 0, 32, 0, 0, 0, 0, 1)
    TNT1 A 4 A_SpawnItemEx("HeatManDashFX", 32, 0, -32, 0, 0, 0, 0, 1)
    HEAM A 0 A_FaceTarget
    HEAM A 0 A_PlaySoundEx("weapon/atomicfire", "Voice", 0, 1)
    Goto Dash

   Dash:
    HEAM P 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 80, 0, 360, "DashEnd")
    HEAM A 0 A_FaceTarget
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    HEAM A 0 A_GiveInventory("CutterFlag", 1)
    HEAM A 0 A_JumpIfInventory("CutterFlag", 18, "DashEnd")
    TNT1 A 1 A_Recoil(-50)
    loop

   DashEnd:
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM A 0 A_Stop
    HEAM A 0 A_SpawnItemEx("HeatManDashDamagerU", 0, 0, 0, 50, 0, 0, 0, 1)
    TNT1 A 1 A_Recoil(-50)
    HEAM P 0 A_Stop
    HEAM G 0 A_ChangeFlag("BRIGHT", 0)
    HEAM A 0 A_ChangeFlag("NOPAIN", 0)
    HEAM A 0 A_ChangeFlag("NOBLOOD", 0)
    HEAM A 10
    goto Look

   Pain:
    HEAM I 0 A_Pain
    // HEAM I 0 A_SpawnItemEx("PainFX")
    HEAM I 1 A_ChangeFlag("NOPAIN", 1)
    Goto Attack2
  }
}

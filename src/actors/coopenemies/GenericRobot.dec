// Independent addon extension chain for coop enemies.
actor GenericRobotSlot0 {}

#include "actors/coopenemies/robot_slots/_GenericRobotSlot.dec"

actor GenericRobot : GenericRobotSlot50 {
  Monster
  BloodType "EnemyHurtFX1"
  Mass 0x7ffffffd
  PainChance 256
  PainSound "misc/devilpain"
  +SLIDESONWALLS
  +NOINFIGHTING
  Scale 2.5
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 ACS_NamedExecuteAlways("sp_enemystart", 0)
    // debug script for quickview enemy's radius and height
    // TNT1 A 0 ACS_NamedExecuteWithResult("HitboxVisual_Hook", 1)
    TNT1 A 0 A_JumpIf(true, "Look")
   Look:
    SNIP A 1
    loop
   Death:
    TNT1 A 0 A_PlaySoundEx("weapon/napalm", 0)
   DeathQuiet:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 1 A_Fall
    TNT1 A 1 A_SpawnItemEx("ExplosionEffect1", 0, 0, height * 1.25)
    stop
   BigDeath:
    TNT1 A 0 A_PlaySoundEx("weapon/drillexplode", "Weapon")
   BigDeathQuiet:
    TNT1 A 0 A_Stop
    TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
    TNT1 A 1 A_Fall
    TNT1 A 1 A_SpawnItemEx("ExplosionEffect2", 0, 0, height * 1.25)
    stop
   Despawn:
    TNT1 A 0
    stop
  }
}

actor GenericRobotBoss : GenericRobot {
  +DROPOFF
  -SOLID
  -CANPASS
  +LOOKALLAROUND
  +THRUGHOST
  States {
   Death:
    TNT1 A 0 A_PlaySoundEx("misc/devildeath", "Voice", 0, 1)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Fall
    TNT1 A 1 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    stop
  }
}

actor HealthScaled : Once {}

actor SPBossFlag : Inventory {
  Inventory.MaxAmount 999
}

actor OctopusBatteryDamagerU {
  Projectile
  +THRUGHOST
  +DONTBLAST
  Damage (50)
  Speed 0
  Radius 48
  Height 48
  DamageType "BigEye"
  States {
   Spawn:
    TNT1 A 2
    stop
  }
}

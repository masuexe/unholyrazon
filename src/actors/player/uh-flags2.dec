actor FrozenDeathBitFX : BasicClientSide {
  Translation "192:192=4:4", "198:198=201:201", "0:0=72:72", "247:247=72:72", "208:208=4:4", "168:168=4:4"
  +FORCEXYBILLBOARD
  +BRIGHT
  Scale 1.25
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, "S1", "S2", "S3", "S4", "S5", "S6")
   S1:
    ICEC "RRR[SSS[TT" 1
    stop
   S2:
    TNT1 A 0 A_Jump(128, 4)
    ICEC QPO random(2, 3)
    stop
    ICEC OPQ random(2, 3)
    stop
   S3:
    TNT1 A 0 A_Jump(128, 4)
    ICEC UVW random(2, 3)
    stop
    ICEC UYW random(2, 3)
    stop
   S4:
    TNT1 A 0 A_Jump(128, 4)
    ICEC XYZ random(2, 3)
    stop
    ICEC XVZ random(2, 3)
    stop
   S5:
    ICEC "KKK[KKK[KKK" 1
    stop
   S6:
    ICEC LMN 3
    stop
  }
}

actor BurningDeathBit_H : BasicClientSide {
  RenderStyle None
  ReactionTime 35
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BurningDeathBitFX", fRandom(16, 48), 0, fRandom(16, 48), 0, 0, fRandom(0.1, 1), random(0, 359))
    TNT1 A 1 A_Warp(2, 0, 0, 0, 0, 24)
    TNT1 A 0 A_CountDown
    loop
  }
}
actor BurningDeathBitFX : BasicClientSide {
  Translation "4:4=4:4", "192:192=95:95", "198:198=3:3", "208:208=208:208", "250:250=89:89", "249:249=5:5"
  Scale 1.25
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetScale(ScaleX+frandom(-0.25, 0.25))
    TNT1 A 0 A_Jump(256, "Spawn1", "Spawn2")
    stop

   Spawn1:
    TNT1 A 0 A_Jump(32, "Spawn1a")
    TNT1 A 0 A_Jump(192, 4)
    FIRE QRS random(1, 3)
    stop
    TNT1 A 0 A_Jump(256, 1, 4, 7)
    FIRE QRS 1
    stop
    FIRE QRS 2
    stop
    FIRE QRS 3
    stop
   Spawn1a:
    TNT1 A 0 A_Jump(192, "Spawn1b")
    FIRE Q random(1, 3)
    TNT1 A 1 A_Jump(64, 1)
    FIRE R random(1, 3)
    TNT1 A 1 A_Jump(64, 1)
    FIRE S random(1, 3)
    stop
   Spawn1b:
    TNT1 A 0 A_Jump(256, 1, 6, 11)
    FIRE Q 1
    TNT1 A 1 A_Jump(64, 1)
    FIRE R 1
    TNT1 A 1 A_Jump(64, 1)
    FIRE S 1
    stop
    FIRE Q 2
    TNT1 A 1 A_Jump(64, 1)
    FIRE R 2
    TNT1 A 1 A_Jump(64, 1)
    FIRE S 2
    stop
    FIRE Q 3
    TNT1 A 1 A_Jump(64, 1)
    FIRE R 3
    TNT1 A 1 A_Jump(64, 1)
    FIRE S 3
    stop

   Spawn2:
    TNT1 A 0 A_Jump(32, "Spawn2a")
    TNT1 A 0 A_Jump(192, 4)
    FIRE TUV random(1, 3)
    stop
    TNT1 A 0 A_Jump(256, 1, 4, 7)
    FIRE TUV 1
    stop
    FIRE TUV 2
    stop
    FIRE TUV 3
    stop
   Spawn2a:
    TNT1 A 0 A_Jump(192, "Spawn2b")
    FIRE T random(1, 3)
    TNT1 A 1 A_Jump(64, 1)
    FIRE U random(1, 3)
    TNT1 A 1 A_Jump(64, 1)
    FIRE V random(1, 3)
    stop
   Spawn2b:
    TNT1 A 0 A_Jump(256, 1, 6, 11)
    FIRE T 1
    TNT1 A 1 A_Jump(64, 1)
    FIRE U 1
    TNT1 A 1 A_Jump(64, 1)
    FIRE V 1
    stop
    FIRE T 2
    TNT1 A 1 A_Jump(64, 1)
    FIRE U 2
    TNT1 A 1 A_Jump(64, 1)
    FIRE V 2
    stop
    FIRE T 3
    TNT1 A 1 A_Jump(64, 1)
    FIRE U 3
    TNT1 A 1 A_Jump(64, 1)
    FIRE V 3
    stop
  }
}

actor ShrinkDeath_StarFadeFX : BasicClientSide {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
    6P0K EFGH 2 A_FadeOut(0.05)
    goto Spawn+2
  }
}
actor ShrinkDeath_StarFadeFX_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, 0, 5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, 0, -5, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, 3.533, 3.535, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, -3.533, 3.535, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, 3.535, -3.534, 0, 1)
    TNT1 A 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX", 0, 0, 0, 0, -3.535, -3.534, 0, 1)
    TNT1 A 6
    TNT1 A 8 A_PlaySoundEx("PacmanNES/Dead2", "Voice")
    stop
  }
}

actor ConfettiDeath : Confetti{+THRUGHOST}

actor ConfettiDeathSpawner : ConfettiSpawner{ReactionTime 9 States{
    Spawn:
    TNT1 AAA 0 A_SpawnItemEx("ConfettiDeath", random(-16, 16), random(-16, 16), Random(8, 16), random(-3, 3), random(-3, 3), random(1, -1), 0)
    TNT1 A 1 A_CountDown
    Loop}}


actor IsInPain3 : PowerUp {
  Powerup.Duration 3
}

actor DelayPainFX : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAAAAAAA 2 A_GiveToTarget("PainFXItem", 1)
    stop
  }
}
actor DelayPainFX5 : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 AAAAA 2 A_GiveToTarget("PainFXItem", 1)
    stop
  }
}
actor PainFXItem : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_SpawnItemEx("PainFX", -5, 0, 3, 0, 0, 0) //PainFX_UH
    stop
  }
}


actor NoFallingRespawn_Core : Inventory{+INVENTORY.UNDROPPABLE}//Used for singleplayer ACS
actor NoFallingRespawn_CTF : Once {}
actor NoFallingRespawn_F : Once {}
actor TempNoFallingRespawn_F : Powerup {
  Powerup.Duration -60
}

actor PowerFallingRespawnSpeed : PowerSpeed {
  powerup.duration 4
  Speed 1.01
  +POWERSPEED.NOTRAIL
}

actor UH_ArtiTeleportCheck_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(tid!=0, "Yes")
    TNT1 A 0 A_JumpIf(1, 1)
    stop
    //This can teleport a voodoo/summon
    TNT1 A 0 ACS_NamedExecuteWithResult("core_respawnspot", 0, RS_NORM)
    stop
   Yes:
    TNT1 A 0 A_JumpIfInventory("NoFallingRespawn_Core", 1, "No")
    TNT1 A 0 A_JumpIfInventory("NoFallingRespawn_CTF", 1, "No")
    TNT1 A 0 A_JumpIfInventory("NoFallingRespawn_F", 1, "No")
    TNT1 A 0 A_JumpIfInventory("TempNoFallingRespawn_F", 1, "No")
    TNT1 A 0 A_GiveInventory("TeleportFX_Flag6")
    TNT1 A 0 A_JumpIfInventory("PowerFallingRespawnSpeed", 1, "Trapped")
    TNT1 A 0 A_GiveInventory("PowerFallingRespawnSpeed")
    //If a Voodoo/Summoned player gets the teleport below. Game Crash!
    TNT1 A 0 A_GiveInventory("UH_ArtiTeleport_P", 1)
    stop
   Trapped://Still in a pit?! Attempt to go to any player respawn!
    TNT1 A 0 ACS_NamedExecuteWithResult("core_respawnspot", 0, RS_NORM)//RS_SAMETEAM//RS_ARTITELEPORT
    stop


   No:
    TNT1 A 0
    stop
  }
}



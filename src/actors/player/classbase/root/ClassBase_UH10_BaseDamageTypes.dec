actor ClassBase_UH10_BaseDamageTypes : ClassBaseUH00 {
  States {
    // >>>>>>> <<<<<<<//
    // No Hitstun (goto Pain+1)
    // >>>>>>> <<<<<<<//
   Pain.FireSpin:
   Pain.TimeSlow:
   Pain.OilSlider:
   Pain.QuickBoomerang:
   Pain.CrashBomb:
   Pain.NeedleCannon:
   Pain.NegaNeedleCannon:
   Pain.MagnetMissile:
   Pain.SparkShock:
   Pain.FlashStopper:
   Pain.PharaohHold:
   Pain.DiveMissile:
   Pain.GravityHold:
   Pain.StarCrash:
   Pain.ChargeKick:
   Pain.CentaurFlash:
   Pain.WindStorm:
   Pain.YamatoSpear: Pain.NegaYamatoSpear:
   Pain.JunkShield:
   Pain.WildCoil: Pain.NegaWildCoil:
   Pain.ScorchWheel:
   Pain.FlashBomb: Pain.NegaFlashBomb:
   Pain.WaterBalloon:
   Pain.ConcreteShot:
   Pain.TornadoBlow:
   Pain.LaserTrident:
   Pain.ChillSpike:
   Pain.WheelCutterSaw:
   Pain.IceWall: Pain.NegaIceWall:
   Pain.SpreadDrill: Pain.SpreadDrill2: Pain.SpreadDrill3:
   Pain.WaveBurner: Pain.WaveBurnerUW:
   Pain.SparkChaser:
   Pain.BreakDash:
   Pain.ScrewCrusher:
   Pain.ProtoBuster: Pain.Buster: Pain.BassBuster: Pain.MegaArm:
   Pain.TrebleSentry: Pain.Treble: Pain.TrebleBoost:
   Pain.Exit:
   Pain.Reggae:
   Pain.MetoolSwimmer: Pain.KyorownBullet: Pain.FlingDamage: Pain.IceBlock:
   Pain.Misc: Pain.Protoman: Pain.DarkMan: Pain.Darkman: Pain.Gamma:
   Pain1:  // Used by Stoneman/Chillman and NoFallingRespawn_F
    "----" H 0
    goto Pain+1

    // >>>>>>> <<<<<<<//
    // No Hitstun or Recoil (goto Pain+2)
    // >>>>>>> <<<<<<<//
   Pain.GyroChopper:
   Pain.TornadoHoldPod:
   Pain.TripleBlade: Pain.NegaTripleBlade:
   Pain.WaterShield:
   Pain.CommandoBomb:
   Pain.ThunderWool:
   Pain.ElectricShock:
   Pain2:  // Used by Stoneman/Chillman and NoFallingRespawn_F
    "----" H 0
    goto Pain+2

    ///////////////////
    // classbase1_pain.txt redefines
    ///////////////////
   Pain.NoPain:
    PLY1 B 0
    goto SuperSpawn
   Pain.BotSight:
    "####" B 5 HealThing(1)
    goto SuperSpawn

    ///////////////////
    // Sound Based / Power Protects
    ///////////////////
   Pain.Reggae:
    "----" H 0 A_PlaySoundEx("item/reggae", "SoundSlot5", 0)  // 7
    goto Pain+2
   Pain.CrystalEyeBit:
    "----" H 0 A_GiveInventory("CrystalEyeHit")
    "----" H 0 A_GiveInventory("PainHitstun_90_P")
    goto Pain+1
   Pain.SlashClaw: Pain.NegaSlashClaw:
    "----" H 0 A_PlaySoundEx("weapons/mm7/slashclawhit", "SoundSlot5")
    goto Pain
   Pain.TornadoHold:
    "----" H 0 A_GiveInventory("TornadoHoldProtect")
    goto Pain+2
   Pain.FlameSword:
    "----" H 0 A_GiveInventory("FlameSwordProtect")
    "----" H 0 A_PlaySoundEx("weapons/mm8/flameswordhit", "SoundSlot5")
    "----" HH 0 A_SpawnItemEx("FlameSwordBit", 0, 0, 0, random(-10, 10), random(-10, 10), random(10, 15), random(0, 359))
    goto Pain
   Pain.TenguSlash:
    "----" H 0 A_PlaySoundEx("weapons/mmb/tengubladehit", "SoundSlot5")
    goto Pain
   Pain.SpreadDrill:
   Pain.SpreadDrill2:
   Pain.SpreadDrill3:
    "----" H 0 A_JumpIfInventory("SpreadDrillProtect", 1, 2)
    "----" H 0 A_PlaySoundEx("weapons/mmb/spreaddrillhit", "SoundSlot5")
    "----" H 0 A_GiveInventory("SpreadDrillProtect")
    goto Pain+1
   Pain.SolarBlaze:
    "----" H 0 A_GiveInventory("SolarBlazeProtectU")
    goto Pain
   Pain.SparkChaser:
    "----" H 0 A_GiveInventory("SparkChaserTagged")
    goto Pain+1
   Pain.BreakDash:
    "----" H 0 A_GiveInventory("BreakDashProtectU")
    "----" H 0 A_GiveInventory("PainHitstun_0_P")  // A_Stop
    goto Pain+1

    ///////////////////
    // Movement Based (Stops/Slows)
    ///////////////////
    // 0.9x Hitstun — CrystalEyeBit special is above (CrystalEyeHit + hitstun90)
   Pain.FlashBomb: Pain.NegaFlashBomb:
   Pain.WaterBalloon:
   Pain.IceWall: Pain.NegaIceWall:
   Pain.RemoteMine:
   Pain.ChargeBuster:
    goto Pain_90
   Pain.CrashBomb:
    goto Pain_Stop
   Pain.TimeSlow:
    "----" H 0 A_GiveInventory("Core_Slowed_P")  // Slowed
    goto Pain+1
   Pain.TimeStopper:
    "----" H 0 A_JumpIfInventory("UH_TimeStopHitBreak_F", 1, "Pain_TimeStopperHitBreak")
    "----" H 0 A_GiveInventory("TimeStopActivator")
    goto Pain+2
   Pain_TimeStopperHitBreak:
    "----" H 0 A_TakeInventory("UH_TimeStopHitBreak_F", 1)
    goto Pain+2
   Pain.ConcreteShot:
    "----" H 0 A_GiveInventory("UH_PainConcreteStart_P")
    goto Pain+1
   Pain.SparkShock:
    goto Pain_Shock
   Pain.ChillSpike:
    "----" H 0 A_GiveInventory("ChillFreeze")
    goto Pain+1

    ///////////////////
    // Movement Based (Flings)
    ///////////////////
   Pain.WindStorm:
    "----" H 0 A_GiveInventory("WindStorm_Pain_P")  // WindStormHit
    goto Pain+1
   Pain.TornadoBlow:
    "----" H 0 A_GiveInventory("TornadoBlow_Pain_P")
    goto Pain+1
   Pain.GravityHold:
    "----" A 0 A_ChangeVelocity(velx, vely, 0, CVF_REPLACE)
    "----" A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    "----" A 0 A_GiveInventory("GravityForcePain_P")
    "----" A 0 A_JumpIf(CallACS("core_CheckFooting"), 2)
    "----" A 0 ThrustThingZ(0, 150, 1, 0)
    "----" A 0
    goto Pain+1
   Pain.SpringBoxTrap:
   Pain.ClownTrain:
   Pain.FlingDamage:
    "----" H 0 A_GiveInventory("FlingDamage_Pain_P")
    goto Pain+1
   SkipFling:
    "----" H 0
    goto pain+1

    ///////////////////
    // Effect Based
    ///////////////////
   Pain.FlashStopper:
    "----" H 0 A_GiveInventory("FlashStopperHit")
    goto Pain+1
    // Stonecore and Chillman have tweaks for these damagetypes
    // For some reason, Doom Rocket has "Fire" damagetype. Be wary of Cyberdemons
   Pain.Drowning: Pain.Slime: Pain.Fire: Pain.Falling: Pain.Ice:
   Pain.DrowningTag: Pain.SlimeTag: Pain.FallingTag:
    "----" H 0 A_JumpIfInventory("BeatCallCheck", 1, "BeatAssist")
   Pain.Spiney:
    "----" H 0 A_JumpIfInventory("ShieldHits", 1, "Pain1")
   Pain.Crush: Pain.CrushTag: Pain.Beam: Pain.PressBall: Pain.BurnWave: Pain.Massacre:
    "----" H 0 A_JumpIfInventory("NoFallingRespawn_F", 1, "Pain1")
    "----" H 0 A_GiveInventory("UH_ArtiTeleportCheck_P")
    goto Pain+1
   BeatAssist:
    "----" H 0 HealThing(2, 30000)
    "----" H 0 ACS_NamedExecuteAlways("core_beatflight", 0, 0, 1)
    "----" H 0 A_JumpIfInventory("BeatCallProtection", 1, "Spawn")
    goto Pain+1
   Pain.WilyFire:
    "----" H 0 A_SpawnItemEx("ImOnFire")
    "----" H 0 A_GiveInventory("FireVision")
    goto Pain
   Pain.WilyIce:
    "----" A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, true)
    "----" A 0 A_SpawnItemEx("ImFrozen")
    "----" A 0 A_GiveInventory("IceVision")
    "----" A 0 A_Stop
    "----" A 0 A_GiveInventory("WilyIcePainPower")
    goto Pain+1

    ///////////////////
    // Death states (Added states have //)
    ///////////////////
   Death.Ice:  //
   Death.WilyIce: Death.GigaIceWave:
   Death.IceSlasher:
   Death.TimeStopper:  //
   Death.BlizzardAttack:
   Death.FreezeCracker: Death.FreezeCrackerBit:
   Death.IceWave:
   Death.NegaIceWave:
   Death.ChillSpike: Death.ChillShot: Death.NegaChillShot:
   Death.IceBlock: Death.ChillCubeRespawn:  //
   Ice:
    "----" H 0 A_GiveInventory("IceDeathFlag")
    goto Death
   Death.Fire:
   Death.FireStorm: Death.FireSpin: Death.AtomicFire1: Death.AtomicFire2: Death.AtomicFire3: Death.PharaohShot1: Death.PharaohShot2: Death.PharaohShot3: Death.PharaohHold:
   Death.FlameBlast: Death.NegaFlameBlast: Death.ScorchWheel: Death.FlameSword: Death.FlameSwordSpark: Death.WaveBurner: Death.WaveBurnerUW: Death.MagmaBazooka1: Death.NegaMagmaBazooka1: Death.MagmaBazooka2: Death.NegaMagmaBazooka2: Death.SolarBlaze:
   Death.BurnWave: Death.SolarChangkey:
    "----" H 0 A_GiveInventory("FireDeathFlag")
    goto Death
   Death.FallingTag:
   Death.Falling:
    "----" A 0 A_JumpIfInventory("FallDeathExplodeFlag", 1, "Death")
    "----" A 0 A_GiveInventory("FallingDeathFlag")
    goto Death
   Death.WindStorm:
   Death.GravityHold:
   Death.TornadoHold:
   Death.TornadoBlow:
    "----" H 0 A_GiveInventory("RisingDeathFlag")
    "----" H 0 A_PlaySoundEx("weapon/junkend", "Voice")
    "----" H 0 A_PlaySoundEx("classes/LuckyFly", "SoundSlot5")
    goto Death
   Death.spawntelefrag:
    "----" H 0 A_GiveInventory("SpawnTeleFragFlag")
    goto Death
   Death.Gib:
   Death.Instagib: Death.Telefrag: Death.DickheadRevive:
   Death.TopSpin: Death.CommandoBomb: Death.DawnBreaker:
    /*Death.Suicide:Death.SuicideTag:*/
   Death.Beam:
   Death.QuickBeamU: Death.MagmaBeamU:
   Death.Spiney:
   Death.SpikeU:
   Death.SpineyU: Death.MM2Wily2SpikeU:
   Death.GeminiSpikeU:
   Death.CossackSpikeU: Death.WilyWaterSpikeU:
   Death.WaveSpikeU: Death.ChargemanSpikeU:
   Death.FreezeSpikeU: Death.BurstmanSpikeU:
   Death.ClownSpikeU:
   Death.AstroRoofSpikeU: Death.AstroFloorSpikeU: Death.BurnerSpikeU: Death.PirSpikeU:
   Death.MegaWaterSpineyU: Death.HyperStormFloorSpikeU:
   Death.ConcreteSpikeU: Death.GalaxySpikeU: Death.JewelFloorSpikeU: Death.HornetSpikeU:
   Death.CommandoSpikeU: Death.WilySpikeU:
   Death.VenusSpikeU:
   Death.PressBall:/*Death.Extreme:Death.InstantDeath:*/ Death.VehicleHazard: Death.Massacre:  //
    "----" H 0 A_GiveInventory("InstantDeathGenderScream_P")
    "----" H 0 A_GiveInventory("ExplodeDeathFlag")
    goto Death
   Death.Suicide:
   Death.SuicideTag:
   Death.Disintegrate:
    "----" H 0 A_GiveInventory("CorpseFlag")
    goto Death
   Death.Crush: Death.CrushTag:
   Death.MetalPress:  //
    "----" H 0 A_GiveInventory("FlattenDeathFlag")
    "----" H 0 A_SetScale(scaleX, scaleX / 3)
    goto Death
   Death.FlingDamageGib: Death.CountBombClear: Death.SheepBlockRespawn:
    "----" H 0 A_GiveInventory("CriticalDeath")
   Death.FlingDamage: Death.MeleeTag:
    "----" H 0 A_GiveInventory("FlingDeathFlag")
    goto Death
    // Death.DustCrusher:Death.DustCrusherBit:
    // Death.JunkShield:
    // "----" H 0 A_GiveInventory("JunkDeathDropFlag")
    // goto Death
   Death.Slime: Death.SlimeTag: Death.Drowning: Death.DrowningTag: Death.Exit: Death.ExitTag:
    "----" H 0
    goto Death
  }
}

actor EyeBase : BossBase {
    player.forwardmove 1.25, 1.25
    player.sidemove 1.25, 1.25
    Player.MaxHealth 1000
    Health 1000
    player.jumpz 10
    
    damagefactor "RichDevilCash", 3.0
    damagefactor "RicheyeCash", 3.0
    damagefactor "DevilCash", 3.0
    damagefactor "MoneyBaitCash", 3.0
    damagefactor "MoneyBombCash", 3.0
}


actor EyeMorphShot : BasicMorphProjectile
{
MorphProjectile.PlayerClass "PlainDemoneye"
MorphProjectile.MorphFlash "BTWIMRIGHTHERE"
Translation "192:192=110:110","198:198=130:130"
Damagetype "GenericCash"
Obituary "%o suffered death via morphing!"
+FOILINVUL
+THRUGHOST
+RIPPER
Damage (10)
Radius 15
Height 15
Speed 30
States
{
Spawn:
//I_BI B 1 A_FadeOut
//loop
I_BI B 10
stop
}
}

actor EyeMorphShotB : EyeMorphShot//BasicExplosion
{
Translation "192:192=130:130"
Damagetype "GenericCash"
Obituary "%o suffered death via morphing!"
-SOLID
+DONTBLAST
+NOGRAVITY
+MISSILE
+RIPPER
+SKYEXPLODE
+NOINTERACTION
+DONTSPLASH
+THRUGHOST
+THRUACTORS
+DONTREFLECT
height 2
radius 2
Damage(0)
Speed 0
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(10,450,1,0,450)
stop
}
}

Actor PowerEyeMorph : PowerMorph
{
PowerMorph.MorphFlash ""//GigaAstroExplode
PowerMorph.PlayerClass "PlainDemoneye"

Powerup.Duration 0x7FFFFFFC
PowerMorph.MorphStyle (MRF_ADDSTAMINA|MRF_FULLHEALTH|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR)
}

actor EyeMorphGiver : BasicPowerupGiver
{
Powerup.Type "PowerEyeMorph"
}

actor Plain_Moola : EyeMorphShot
{
MorphProjectile.PlayerClass "PlainDemoneye"
}


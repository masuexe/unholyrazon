actor ClassBaseUH00 : ClassBase0 {
  Painchance 256
  // +USEDAMAGEEVENTSCRIPT

  Player.DamageScreenColor "white", 0.0, FlashStopper
  Player.DamageScreenColor "white", 0.0, FlashBulb
  Player.DamageScreenColor "yellow"

  Player.MaxHealth 1000
  Health 1000

  damagefactor "spawntelefrag", 0.0
  damagefactor "Crush", 1.0
  // Bot torrent pushes mines; players take none. The mine is not this class.
  damagefactor "Torrent", 0.0

  ReactionTime 0

  var int user_wepangle;
  var int user_weppitch;
  var int user_wepangle2;
  var int user_weppitch2;
  var int user_wepaimlimit;

  var int user_pkmn_movemem[10];
  var int user_marksman_lockonlist[64];
  var int user_wisp_hex[64];

  var int user_raider_poison[64];
  var int user_hellbot_poison[64];
  var int user_morshu_burn[64];

  var int user_uh_nb_life;
  var int user_uh_nb_hitseq;
  var int user_uh_nb_busterseq;
  var int user_uh_nb_dropped;
  var int user_uh_nb_srcpn;
  var int user_uh_nb_srclife;

  States {
   Pain:
    "----" H 0 A_GiveInventory("PainHitstun_75_P")
    "----" H 0  // A_GiveInventory("PainRecoil_P")
    "----" H 0
    "----" H 0 A_TakeInventory("SuperEffective", 1)
    "----" H 0 A_GiveInventory("EternalPainFlag")
    "----" H 0 A_GiveInventory("UHPainSound_P")  // A_Pain
    "----" H 0
    "----" H 0 A_JumpIfInventory("AntiDamageTime", 1, "Pain_AntiDamage")
    "----" H 0 A_JumpIfInventory("PlayerPropertyBuddha", 1, "Pain_Buddha")
    goto SuperClassPain

   Pain_AntiDamage:
    "----" H 0 ACS_NamedExecuteWithResult("UH_AntiDamageHP", 0)
    "----" H 0 A_TakeInventory("AntiDamageTime")
    "----" H 0 ACS_NamedExecuteWithResult("core_buddhaplayer", 0, false)
    goto SuperClassPain

   Pain_Buddha:
    "----" H 0 A_JumpIfHealthLower(2, "INeedMedic")
    goto Pain_BuddhaEnd
   INeedMedic:
    "----" H 0 A_JumpIfInventory("FloovyStandTID", 1, "MedicFloovyG")
    "----" H 0 A_JumpIfInventory("FloovyDiesForMeTID", 1, "MedicFloovyD")
    "----" H 0 A_JumpIfInventory("MortisBlessing1UPFlag", 1, "MedicMortis")
    "----" H 0 A_JumpIfInventory("PlayerPropertyExtraLifeUnholyInsurance", 1, "MedicInsurance")
    goto Pain_BuddhaEnd
   MedicInsurance:
    "----" H 0 A_JumpIfInventory("UnholyInsuranceFlag", 1, "MedicInsuranceWait")
    "----" H 0 A_GiveInventory("UI_ItemStart_P")
   MedicInsuranceWait:
    "----" H 1
    "----" H 0 A_JumpIfInventory("UnholyInsuranceFlag", 1, "MedicInsuranceWait")
    goto Pain_BuddhaEnd

   MedicMortis:
    "----" H 0 ACS_NamedExecuteWithResult("uh_Health", 6, 1000)  // UHEALTH_HEAL
    "----" H 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, 2)  // ELP_MORTIS
    "----" H 0 A_GiveInventory("UH_ArtiTeleport_P")
    goto Pain_BuddhaEnd

   MedicFloovyG:
    // Keep the player invulnerable while the linked target is resolved and
    // the Floovy extra-life stack is removed.  Without this guard, a second
    // hit in the same high-frequency damage burst can land after Buddha is
    // removed but before the restoration transaction has finished.
    "----" H 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    // Execute the no-delay death/heal script synchronously so the guarded
    // transaction cannot leave its restoration work queued for a later tic.
    "----" H 0 ACS_NamedExecuteWithResult("rz_FloovyDeath", CallACS("rz_CountInv_FloovyStandTID"), 3)  // ELP_FLOOVY_G
    "----" H 0 A_TakeInventory("FloovyStandTID", 0)
    "----" H 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, 3)  // ELP_FLOOVY_G
    // Hold the guard for one tic so damage queued in the current burst cannot
    // observe the just-removed extra life before the state transition ends.
    "----" H 1
    "----" H 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    goto Pain_BuddhaEnd
   MedicFloovyD:
    // Use the same guarded transaction for the sacrifice link.  It also
    // prevents the Floovy from dying while the ally death/heal is resolved.
    "----" H 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    "----" H 0 ACS_NamedExecuteWithResult("rz_FloovyDeath", CallACS("rz_CountInv_FloovyDiesForMeTID"), 4)  // ELP_FLOOVY_D
    "----" H 0 A_TakeInventory("FloovyDiesForMeTID")
    "----" H 0 ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, false, 4)  // ELP_FLOOVY_D
    "----" H 1
    "----" H 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    goto Pain_BuddhaEnd

   Pain_BuddhaEnd:
    "----" H 0 A_Jump(256, "SuperClassPain")
    goto SuperClassPain

    ///////////////////
    // Shared pain helpers (U1–U4 goto these)
    ///////////////////
   Pain_90:
    "----" H 0 A_GiveInventory("PainHitstun_90_P")
    goto Pain+1
   Pain_85:
    "----" H 0 A_GiveInventory("PainHitstun_85_P")
    goto Pain+1
   Pain_80:
    "----" H 0 A_GiveInventory("PainHitstun_80_P")
    goto Pain+1
   Pain_75:
    "----" H 0 A_GiveInventory("PainHitstun_75_P")
    goto Pain+1
   Pain_65:
    "----" H 0 A_GiveInventory("PainHitstun_65_P")
    goto Pain+1
   Pain_50:
    "----" H 0 A_GiveInventory("PainHitstun_50_P")
    goto Pain+1
   Pain_Stop:
   Pain_0:
    "----" H 0 A_GiveInventory("PainHitstun_0_P")
    goto Pain+1

   Echo_TimeStop:
    "----" H 0 A_GiveInventory("TimeBenderStart_P")
    "----" H 0 A_Jump(256, "TimeStopped_Echo")
    goto TimeStopped_Echo
   Pain_TimeStop:
    "----" H 0 A_GiveInventory("TimeBenderStart_P")
    "----" H 0 A_Jump(256, "TimeStopped_Pain")
    goto TimeStopped_Pain
   TimeStopped_Echo:
    "####" "#" 101
    goto Pain+2
   TimeStopped_Pain:
    "####" "H" 101
    goto Pain+2

    // Thunder / beast stun: freeze + color flash owned by rz_ParalyzedStatusWatcher.
    // Timer is drained in ACS; DECORATE only waits then cleans up if not interrupted.
   Pain_Paralyze:
    // Same as generic Pain: spend AntiDamage once, skip freeze; next stun can paralyze
    "----" H 0 A_JumpIfInventory("AntiDamageTime", 1, "Pain_ParalyzeAntiDamage")
    "----" H 0 A_JumpIfInventory("PlayerPropertyNoParalyze", 1, "Pain_ParalyzedEnd")
    "----" H 0 A_JumpIfInventory("PlayerIsParalyzed", 1, "Pain_ParalyzedWait")
    "----" H 0 A_GiveInventory("PlayerParalyzedOn")
   Pain_ParalyzedWait:
    "####" H 1
    "####" H 0 A_JumpIfInventory("PlayerIsParalyzed", 1, "Pain_ParalyzedWait")
    // Keep waiting while timer remains so Always-watcher lag / multi-hit cannot
    // fall into End and wipe the timer before freeze is established.
    "####" H 0 A_JumpIfInventory("PlayerParalyzedTimer", 1, "Pain_ParalyzedWait")
   Pain_ParalyzedEnd:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    goto Pain+2
   Pain_ParalyzeAntiDamage:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    goto Pain_AntiDamage

   Pain_Shock:
    "----" H 0 A_SpawnItemEx("SparkShockFX", 6, 0, 32)
    "----" H 0 A_GiveInventory("Core_ShockedStopGiver")
    goto Pain+2
   Pain_HalfShock:
    "----" H 0 A_SpawnItemEx("ShockFX", 4, 0, 32)
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    goto Pain+2
   Pain_StopAndShock:
    "----" H 0 A_GiveInventory("PainHitstun_0_P")
    goto Pain_Shock

   MegamanPain0:
    // "----" A 0 //A_Pain
    "----" AAAAAAAAAA 2 A_SpawnItemEx("PainFX_UH", -5, 0, 3, 0, 0, 0)  // PainFX
    "----" A 1
    goto SuperSpawn

   MegamanPain:  // What in tarnation is this needed for [Cel]
    // "----" A 0 A_JumpIfInventory("GravityHoldPainPower",1,"GravityHoldWait")
    // "----" A 0 A_JumpIfInventory("WilyIcePainPower",1,"WilyIceWait")
    goto MegamanPain0

   MegamanDeath0:
    "----" AAAAAAAAAAAAAAAAAAAA 1 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
   MegamanExplode:
    "----" A 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
   MegamanFall:
    "----" A 0 A_PlaySoundEx("*death", "Voice")  // A_PlayerScream
   MegamanErase:
    "----" A 0 A_GiveInventory("UH_FinalDeathState_P")
    // TNT1 A 1 A_CheckPlayerDone
    "####" Z 1 A_CheckPlayerDone
    wait
   MegamanGib:
    "----" A 0 A_GiveInventory("CriticalDeathGiver")
    "----" A 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    goto MegamanErase


   Death:
    "----" A 0  // A_Stop //Unsure why this STOP is default now. Should be the other way around [Cel]
   Death_NoStop:
    "----" H 0 A_GiveInventory("UH_ClassDeath_P")
    goto SuperClassDeath

   ClassDeath:  // Used for special deaths (such as Decoybot)
    "----" H 0
    goto MegamanDeath

   MegamanDeath:
    // "----" H 0 A_JumpIfInventory("MorphedFlag",1,"MegamanMorphed")
    "----" H 0 A_JumpIfInventory("CorpseFlag", 1, "MegamanCorpse")
    "----" H 0 A_JumpIfInventory("ExplodeDeathFlag", 1, "MegamanGib")
    "----" H 0 A_JumpIfInventory("FallingDeathFlag", 1, "MegamanFall")
    "----" H 0 A_JumpIfInventory("FlingDeathFlag", 1, "MegamanFling")  // CBM
    "----" H 0 A_JumpIfInventory("RisingDeathFlag", 1, "MegamanRise")
    "----" H 0 A_JumpIfInventory("IceDeathFlag", 1, "MegamanIce")
    "----" H 0 A_JumpIfInventory("FireDeathFlag", 1, "MegamanFire")
    "----" H 0 A_JumpIfInventory("ShrinkDeathFlag", 1, "MegamanShrink")
    "----" H 0 A_Jump(256, "MegamanDeath0")
    // "----" H 19//Core is 20 now
    goto MegamanDeath0  // "Super::MegamanDeath"

   MegamanFling:  // CBM
    "----" H 19
    "----" H 0 A_GiveInventory("UH_CritDeathCheck_Snd_P")
    "----" H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    goto MegamanErase

   MegamanRise:
    "----" H 1 A_SetGravity(0.0)  // A_ChangeFlag(NOINTERACTION,1)//0 gravity is better than changing this flag [Cel]
   RiseMyMegaman:
    "----" H 1 ThrustThingZ(0, 10, 0, 1)  // 21
    "----" H 0 A_JumpIf(ceilingz - z <= (height + 1), "RiseMyMegamanEnd")
    "----" H 0 A_GiveInventory("BlowDeathTimer", 1)
    "----" H 0 A_JumpIfInventory("BlowDeathTimer", 25, "RiseMyMegamanEnd")
    loop
   RiseMyMegamanEnd:
    "----" H 0 A_Stop
    "----" H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 0)
    "----" H 0 A_GiveInventory("UH_CritDeathCheck_P")  // Spawns gibs if crit death
    goto MegamanFall

   MegamanIce:
    "----" H 0 ACS_NamedExecuteWithResult("core_chargecolor", CLR_ICEDEATH, TCLR_ICEDEATH)  // DYE_ICEDEATHCBM
    "----" H 1 A_PlaySoundEx("*icefreze", "Voice")
    "----" H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanIceGib")
    "----" HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH 1 A_SpawnItemEx("FrozenDeathBitFX", frandom(16, 48), 0, fRandom(16, 48), 0, 0, 0, random(0, 359), 1)
    "----" H 0 A_PlaySoundEx("*icedeath", "Body")  // Voice
    "----" H 0 A_SpawnItemEx("FrozenDeathFX", 0, 0, 1, 0, 0, 0, 0, 1)
    goto MegamanErase
   MegamanIceGib:
    "----" H 0 A_SpawnItemEx("FrozenDeathFX", 0, 0, 1, 0, 0, 0, 0, 1)
    "----" H 0 A_SpawnItemEx("CriticalDeathSpawner", 0, 0, 0, 0, 0, 0, 0, 1)
    "----" H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    "----" H 0 A_PlaySoundEx("*icedeath", "Voice")
    goto MegamanErase

   MegaDeathEnd:  // Old, for reference?
    "----" H 0 A_PlaySoundEx("*death", "Voice")  // A_XScream
    "----" H 0 A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
    "----" H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 32)
    "----" H 0
    goto MegamanErase

   DeathWaitOLD:
    PLY1 Z 1 A_CheckPlayerDone
    wait


    ///////////////////
   MegamanCorpse:
    "----" H 0 A_JumpIfInventory("BAWS", 1, "MegamanGib")
    "----" H 0 A_Jump(256, "MegamanDisintegrate")
   MegamanDisintegrate:
    "----" H 0
    goto MegamanCorpseEnd
   MegamanCorpseEnd:
    "----" H 0 A_PlaySoundEx("G_Axe/S_25", "Voice")
    goto MegamanErase

   MegamanFire:
    "----" H 0
    "----" H 0 ACS_NamedExecuteWithResult("core_chargecolor", 29001)  // ("uh_forceweaponcolor",29001) //BURNTDEATH_DYE
    "----" H 0 A_JumpIfInventory("CriticalDeath", 1, "MegamanGib")
    "----" H 0 ThrustThingZ(0, 40, 0, 1)
    "----" H 0 ThrustThing(random(1, 255), 15, 0, 0)
    "----" H 0 A_SpawnItemEx("BurningDeathBit_H")
    // "----" H 0 A_JumpIfInventory("NoClassDeathFlag",1,"NormalClassDeath")//ClassDeathNot
    "----" H 0 A_Jump(256, "MegamanDeath0")
    goto MegamanDeath0

   MegamanShrink:
    "----" H 0 A_PlaySoundEx("PacmanNES/Dead1", "Voice")
    "----" H 0 A_ChangeFlag("NOGRAVITY", 1)
    "----" H 0 A_ChangeVelocity(velx, vely, 4, CVF_REPLACE)
    "----" H 1 A_SetScale(2.5, 2.5)
    "####" HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH 1 A_SetScale(scaleX - 0.075)
    "----" H 0 A_PlaySoundEx("PacmanNES/Dead2", "Voice")
    "----" H 0 A_SpawnItemEx("ShrinkDeath_StarFadeFX_H", 0, 0, 4, 0, 0, 0, 0, 1)
    "----" H 0 A_SetTranslucent(0.0, 0)
    "----" H 0 A_SetScale(2.5, 2.5)
    "----" H 0 A_ChangeFlag("NOGRAVITY", 0)
    // "----" H 0 A_JumpIfInventory("ShrinkDeathFlag",2,"ClassCorpse")
    goto MegamanErase

   MegamanMorphed:
    "----" Z 0 A_SetTranslucent(0.0, 0)
    goto MegamanErase

   MegamanFade:
   MegamanFade1:
    "----" H 0
    // "----" H 18
    "----" H 1 A_PlaySound("*death", 2)  // A_PlayerScream
    "----" HHHHHHHHHH 1 A_FadeOut(0.1, 0)  // A_SetTranslucent(0.90,0)
    "----" H 1
    goto MegamanErase  // 12 delay
   MegamanFade2:
    "----" H 0 A_PlaySound("*death", 2)
    "----" HHHHHHHHHH 2 A_FadeOut(0.1, 0)
    goto MegamanErase  // 20 delay
   MegamanFade3:
    "----" H 0 A_PlaySound("*death", 2)
    "----" HHHHHHHHHH 3 A_FadeOut(0.1, 0)
    goto MegamanErase  // 30 delay

   MegamanFade1_125:
    "----" H 1 A_PlaySound("*death", 2)
    "----" HHHHHHHH 1 A_FadeOut(0.125, 0)
    "----" H 1
    goto MegamanErase
   MegamanFade1_166:
    "----" H 1 A_PlaySound("*death", 2)
    "----" HHHHHH 1 A_FadeOut(0.167, 0)
    "----" H 1
    goto MegamanErase
   MegamanFade1_200:
    "----" H 1 A_PlaySound("*death", 2)
    "----" HHHHH 1 A_FadeOut(0.200, 0)
    "----" H 1
    goto MegamanErase
  }
}

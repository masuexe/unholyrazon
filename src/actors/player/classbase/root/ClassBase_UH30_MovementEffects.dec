// Unholy movement, push, fling, and lift effects
actor ClassBase_UH30_MovementEffects : ClassBase_UH20_HitEffects {
  States {
    ///////////////////
    // Horizontal / directional push
    ///////////////////
   Pain.RageFling:
   Pain.BlueJayFling: Pain.ASPFling:
   Pain.ASPFlingJr: Pain.TankeyeFling: Pain.Tankeye:
    "----" H 0 A_GiveInventory("PainPush_F_35")
    "----" H 0 A_GiveInventory("PainPush_Z_100")
    goto Pain
   Pain.SmokeFling:
    "----" H 0 A_JumpIfInventory("NoPushFlag", 1, "Pain")
    "----" H 0 A_Stop
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    goto Pain+2
   Pain.ZangiefPush:
    "----" H 0 A_Stop
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    "----" H 0 A_SpawnItemEx("PainZangiefPushHit")
    goto Pain
   Pain.ShadowBossCaltrop:
    "----" H 0 A_ScaleVelocity(0.25)
    goto Pain
   Pain.EyelentoMajorKick:
    "----" H 0 A_GiveInventory("PainPush_F_45")
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    goto Pain
   Pain.EyelentoMajor: Pain.EyelentoEyeBaton:
    "----" H 0 A_GiveInventory("PainPush_F_4")
    "----" H 0 A_GiveInventory("PainPush_Z_20")
    goto Pain
   Pain.MagicDevilEyeHeave:
    "----" H 0 A_GiveInventory("PainPush_F_500")
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    goto Pain
   Pain.WindDemoneyeFling: Pain.MagicSpecialist:
    "----" H 0 A_GiveInventory("PainPush_F_4")
    "----" H 0 A_GiveInventory("PainPush_Z_30")
    goto Pain
   Pain.StepAsideFling: Pain.ScrotoStunt_LiftUp:
    "----" H 0 A_GiveInventory("PainPush_F_5")
    "----" H 0 A_GiveInventory("PainPush_Z_120")
    goto Pain

    ///////////////////
    // Vertical / lift / gravity
    ///////////////////
   Pain.GloryFling:
   Pain.SumoQuakeFling:
   Pain.MagicDevilEyeUpper:
   Pain.DevilWindUp: Pain.TrueMistressUpper: Pain.TroutiusUpper:
   Pain.Chieftain_FlingUp: Pain.AlphaUpper: Pain.BlackDevilUpper: Pain.MadAlphaUpper:
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    goto Pain
   Pain.Nega_GHold:
   Pain.LureBall:
    "----" H 0 ThrustThingZ(0, 150, 1, 0)
    goto Pain
   Pain.M_WindStorm:
    "----" H 0 A_JumpIf(CallACS("core_CheckFooting"), 1)
    goto Pain
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain
   Pain.M_TornadoBlow:
   Pain.MoonBall:
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain
   Pain.ShadowmanSliceDice:
    "----" H 0 ThrustThingZ(0, 15, 0, 0)
    goto Pain+2
   Pain.IronCurtainUpFling: Pain.RussianGutsUpFling:
    "----" H 0
    goto Pain.MoonBall
   Pain.BerserkerBlood:
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain+1
   Pain.FloovyFling:
    "----" H 0 A_GiveInventory("PainPush_Z_20")
    goto Pain
   Pain.UnholyInsurance:
    "----" H 0 A_PlaySoundEx("classes/DerpyHitX", "Voice")
    "----" H 0 A_GiveInventory("PainPush_F_7")
    "----" H 0 A_GiveInventory("PainPush_Z_30")
    goto Pain+3
   Pain.MadAlphaGravity:
    "----" H 0 ThrustThingZ(0, 150, 1, 0)
    goto Pain
   Pain.KillerBoxFling:
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain
   Pain.SampiFling:
    "----" H 0 A_GiveInventory("PainPush_F_500")
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain

    ///////////////////
    // Legacy TID-driven hit reactions
    ///////////////////
   Pain.DonJavierRage:
    "----" H 0 A_SpawnItemEx("DonJavierRageHitFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("UnholyPower1500", 400)
    goto Pain
   Pain.IronCurtainRam:
    "----" H 0 A_SpawnItemEx("IronCurtainIronBodyFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("IronCurtainIronBody_P")
    "----" H 0 A_GiveInventory("PainPush_F_500")
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    goto Pain
   Pain.ShinNegaFling:
    goto Pain.HomingSeekerFling
   Pain.DixieandoffRage:
    "----" H 0 A_SpawnItemEx("DixieDeusVultFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("DixieDeusVult_P")
    goto Pain
   Pain.AlphaRage:
    "----" H 0 A_GiveInventory("AlphaRageStrike_P")
    goto Pain
   Pain.GraniteMaulerFling:
    "----" H 0 A_JumpIfInventory("NoPushFlag", 1, "Pain")
    "----" H 0 A_Stop
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    goto Pain
   Pain.JoterraFling:
    "----" H 0 A_JumpIfInventory("NoPushFlag", 1, "Pain")
    "----" H 0 ThrustThingZ(0, 44, 0, 0)
    goto Pain
   Pain.ThomasTrainFling:
    "----" H 0 A_GiveInventory("ThomasTrainFlingProtect")
    "----" H 0 A_GiveInventory("PainPush_Z_50")
    goto Pain
   Pain.MadAlphaRage:
    "----" H 0 A_GiveInventory("MadAlphaRageStrike_P")
    goto Pain

   Pain.FloovyOutOfBody:
    "----" H 0 A_JumpIfInventory("Is_UH_BossNum", 1, "Pain")
    "----" H 0 A_JumpIfInventory("FloovyOutOfBodyProtect", 1, "Pain")
    "----" H 0 A_GiveInventory("FloovyOutOfBodyProtect")
    goto Pain_TimeStop
   Pain.VergilChair:
    "----" H 0 ThrustThingZ(0, 52, 0, 1)
    "----" H 0 A_SpawnItemEx("TopTwistPain_H")
    goto Pain+2

    ///////////////////
    // Scripted fling / movement hit
    ///////////////////
   Pain.TidalFling:
    "----" H 0 A_SpawnItemEx("PainTidalFlingHit")
    "----" H 0 ThrustThingZ(0, 30, 0, 0)
    goto Pain2
   Pain.HomingSeekerFling:
    "----" H 0 A_SpawnItemEx("PainHomingSeekerFlingHit")
    goto Pain2
   Pain.AmberFling:
    "----" H 0 A_GiveInventory("PainPush_F_15")
    "----" H 0 A_GiveInventory("PainPush_Z_50")
    goto Pain_AmberGive
   Pain.AmberFlingAway:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAwayHit")
    goto Pain.AmberFlingUp
   Pain.AmberFlingAway2:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAway2Hit")
    goto Pain.AmberFlingUp
   Pain.AmberFlingAway3:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAway3Hit")
    goto Pain.AmberFlingUp
   Pain.AmberFlingUp:
    "----" H 0 A_SpawnItemEx("PainAmberFlingUpHit")
    goto Pain_AmberGive
   Pain_AmberGive:
    "----" H 0 A_GiveToTarget("Amber_GainOnHit_P")
    goto Pain
   Pain.ShadowBossFling:
    "----" H 0 A_SpawnItemEx("PainShadowBossFlingHit")
    goto Pain2
   Pain.MagicDevilEyeFling:
    "----" H 0 A_GiveInventory("PainMagicDevilEyeFling_P")
    goto Pain
   Pain.RogueArts_Kick:
    "----" H 0 A_SpawnItemEx("PainRogueArtsKickHit")
    goto Pain2
   Pain.SoccerRockKick:
    "----" H 0 A_SpawnItemEx("PainSoccerRockFlingHit")
    goto Pain

    ///////////////////
    // Root / suplex / grab
    ///////////////////
   Pain.GraniteMaulerSuplex: Pain.TheCommandoChampSuplex: Pain.Balrog_Suplex: Pain.Chieftain_Suplex: Pain.ScrotoStunt_Suplex:
   Pain.ShadowBossSuplex: Pain.EyelentoMajorSuplex:
   Pain.BerserkerSuplex:
   Pain.FlySuplex:
   Pain.Suplex:
    "----" H 0 A_SpawnItemEx("PainSuplexHit")
    goto Pain
   Pain.ShadowBossRoot: Pain.CommandoSlamDamage: Pain.Balrog_Root:
    "----" H 0 A_SpawnItemEx("BasicBoss_Rooted")
    goto Pain+2
  }
}

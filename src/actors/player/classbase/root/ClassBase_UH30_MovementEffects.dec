// Unholy movement, push, fling, and lift effects
actor ClassBaseUH30_MovementEffects : ClassBaseUH20_HitEffects {
  States {
    ///////////////////
    // Horizontal / directional push
    ///////////////////
   Pain.RageFling:
   Pain.BlueJayFling: Pain.ASPFling:
   Pain.ASPFlingJr: Pain.TankeyeFling:
    "----" H 0 A_GiveInventory("PainPush_F_35")
    "----" H 0 A_GiveInventory("PainPush_Z_100")
    Goto Pain
   Pain.ZangiefPush:
    "----" H 0 A_Stop
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    "----" H 0 A_SpawnItemEx("PainZangiefPushHit")
    goto Pain
   Pain.ShadowBossCaltrop:
    "----" H 0 A_ScaleVelocity(0.25)
    Goto Pain
   Pain.EyelentoMajorKick:
    "----" H 0 A_GiveInventory("PainPush_F_45")
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    "----" H 0 A_GiveInventory("HalfShockedStopGiver")
    Goto Pain
   Pain.EyelentoMajor: Pain.EyelentoEyeBaton:
    "----" H 0 A_GiveInventory("PainPush_F_4")
    "----" H 0 A_GiveInventory("PainPush_Z_20")
    Goto Pain
   Pain.MagicDevilEyeHeave:
    "----" H 0 A_GiveInventory("PainPush_F_500")
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    Goto Pain
   Pain.WindDemoneyeFling: Pain.MagicSpecialist:
    "----" H 0 A_GiveInventory("PainPush_F_4")
    "----" H 0 A_GiveInventory("PainPush_Z_30")
    Goto Pain
   Pain.StepAsideFling:
    "----" H 0 A_GiveInventory("PainPush_F_5")
    "----" H 0 A_GiveInventory("PainPush_Z_120")
    Goto Pain

    ///////////////////
    // Vertical / lift / gravity
    ///////////////////
   Pain.GloryFling:
   Pain.SumoQuakeFling:
   Pain.MagicDevilEyeUpper:
    "----" H 0 A_GiveInventory("PainPush_Z_40")
    Goto Pain
   Pain.Nega_GHold:
   Pain.LureBall:
    "----" H 0 ThrustThingZ(0, 150, 1, 0)
    Goto Pain
   Pain.M_WindStorm:
    "----" H 0 A_JumpIf(CallACS("core_CheckFooting"), 1)
    Goto Pain
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    Goto Pain
   Pain.M_TornadoBlow:
   Pain.MoonBall:
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    Goto Pain
   Pain.ShadowmanSliceDice:
    "----" H 0 ThrustThingZ(0, 15, 0, 0)
    Goto Pain+2
   Pain.IronCurtainUpFling: Pain.RussianGutsUpFling:
    "----" H 0
    Goto Pain.MoonBall
   Pain.BerserkerBlood:
    "----" H 0 A_GiveInventory("PainPush_Z_60")
    Goto Pain+1
   Pain.FloovyFling:
    "----" H 0 A_GiveInventory("PainPush_Z_20")
    Goto Pain
   Pain.VergilChair:
    "----" H 0 ThrustThingZ(0, 52, 0, 1)
    "----" H 0 A_SpawnItemEx("TopTwistPain_H")
    Goto Pain+2

    ///////////////////
    // Scripted fling / movement hit
    ///////////////////
   Pain.TidalFling:
    "----" H 0 A_SpawnItemEx("PainTidalFlingHit")
    "----" H 0 ThrustThingZ(0, 30, 0, 0)
    Goto Pain2
   Pain.HomingSeekerFling:
    "----" H 0 A_SpawnItemEx("PainHomingSeekerFlingHit")
    Goto Pain2
   Pain.AmberFlingAway:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAwayHit")
    Goto Pain.AmberFlingUp
   Pain.AmberFlingAway2:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAway2Hit")
    Goto Pain.AmberFlingUp
   Pain.AmberFlingAway3:
    "----" H 0 A_SpawnItemEx("PainAmberFlingAway3Hit")
    Goto Pain.AmberFlingUp
   Pain.AmberFlingUp:
    "----" H 0 A_SpawnItemEx("PainAmberFlingUpHit")
    Goto Pain_AmberGive
   Pain_AmberGive:
    "----" H 0 A_GiveToTarget("Amber_GainOnHit_P")
    Goto Pain
   Pain.ShadowBossFling:
    "----" H 0 A_SpawnItemEx("PainShadowBossFlingHit")
    Goto Pain2
   Pain.MagicDevilEyeFling:
    "----" H 0 A_GiveInventory("PainMagicDevilEyeFling_P")
    Goto Pain
   Pain.RogueArts_Kick:
    "----" H 0 A_SpawnItemEx("PainRogueArtsKickHit")
    Goto Pain2
   Pain.SoccerRockKick:
    "----" H 0 A_SpawnItemEx("PainSoccerRockFlingHit")
    Goto Pain

    ///////////////////
    // Root / suplex / grab
    ///////////////////
   Pain.GraniteMaulerSuplex: Pain.TheCommandoChampSuplex: Pain.Balrog_Suplex: Pain.Chieftain_Suplex: Pain.ScrotoStunt_Suplex:
   Pain.ShadowBossSuplex: Pain.EyelentoMajorSuplex:
   Pain.BerserkerSuplex:
   Pain.FlySuplex:
   Pain.Suplex:
    "----" H 0 A_SpawnItemEx("PainSuplexHit")
    goto Pain
   Pain.ShadowBossRoot: Pain.CommandoSlamDamage: Pain.Balrog_Root:
    "----" H 0 A_SpawnItemEx("BasicBoss_Rooted")
    Goto Pain+2
  }
}

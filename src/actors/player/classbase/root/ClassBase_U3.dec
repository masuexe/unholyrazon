// Unholy boss Pain / Death specials
actor ClassBaseU3 : ClassBaseU2 {
    States {

      ///////////////////
      // Boss stuns / timestop / paralyze
      ///////////////////
     Pain.SutokaStun:Pain.IronCurtainStun:Pain.EdwardStun:Pain.GutsBuddyStun:Pain.RedeadGutsStun:Pain.HalfPressHardmanStun:
     Pain.SadToadStun:Pain.AlphaStun:/*Pain.GBeastStun:Pain.FBeastStun:*/Pain.AbePennyStun:Pain.MadAlphaStun:Pain.CommandoHommandoStun:
     Pain.Chieftain_Stun:Pain.HawkeyeStun:
      Goto Pain_HalfShock

     Pain.BossTimeStop:Pain.AlienJrTimeStop:Pain.JoterraTimeStop:
      goto Pain_TimeStop

     Pain.GBeastStun:Pain.FBeastStun:
      "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
      "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 60)
      Goto Pain_Paralyze

     Pain.GBeastFurySwipeStun: Pain.FBeastFurySwipeStun:
      "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
      "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 20)
      Goto Pain_Paralyze

     Pain.SFStunKnuckle:
      "----" H 0 A_JumpIfInventory("PlayerPropertyNoParalyze", 1, "SFStunKnuckle_BreakIt")
     SFStunKnuckle_Paralyze:
      "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
      "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 105)
      Goto Pain_Paralyze
     SFStunKnuckle_BreakIt:
      "----" H 0 A_PlaySoundEx("MMSF3/BodyBreak", "Auto")
      "----" H 0 ACS_NamedExecuteWithResult("rz_NoParalyzePlayer", 0, false)
      goto SFStunKnuckle_Paralyze

     Pain.SFElectricSlash:
      "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
      "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 70)
      Goto Pain_Paralyze


      ///////////////////
      // Boss TID / poison
      ///////////////////
     Pain.MorshuLampOil:
      "----" H 0 A_SpawnItemEx("PainMorshuMolotovBurn")
      Goto Pain

     Pain.HellbotPoison:
      "----" H 0 A_SpawnItemEx("HellbotPoisonHit", 0, 0, 0, 0, 0, 0, 0, 1)
      goto Pain.SparkShock

      ///////////////////
      // Suplex / root
      ///////////////////
     Pain.GraniteMaulerSuplex:Pain.TheCommandoChampSuplex:Pain.Balrog_Suplex:Pain.Chieftain_Suplex:Pain.ScrotoStunt_Suplex:
     Pain.ShadowBossSuplex:Pain.EyelentoMajorSuplex:
     Pain.BerserkerSuplex:
     Pain.FlySuplex:
     Pain.Suplex:
      "----" H 0 A_SpawnItemEx("PainSuplexHit")
      goto Pain

     Pain.ShadowBossRoot:Pain.CommandoSlamDamage:Pain.Balrog_Root:
      "----" H 0 A_SpawnItemEx("BasicBoss_Rooted")
      Goto Pain+2

     Pain.TorCal_Knifers:
      "----" H 0 A_GiveInventory("TorCal_Stab_Protect")
      "----" H 0 A_SpawnItemEx("Pain_TorCal_Backstab")
      Goto Pain
     Death.Torcal_DamageEX:
      "----" H 0 A_GiveToTarget("ConniverRetribution")
      Goto Death.Disintegrate

      ///////////////////
      // ShadowMan
      ///////////////////
     Pain.ShadowBossBlind:
      "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 150, 350, 3)
      Goto Pain
     Pain.ShadowBossBlade:
      "----" H 0 A_GiveInventory("ShadowBoss_BladeProtect", 1)
      Goto Pain
     Pain.ShadowBossBladeQR:
      "----" H 0 A_GiveInventory("ShadowBoss_BladeProtectQR", 1)
      Goto Pain
     Pain.ShadowBossCaltrop:
      "----" H 0 A_ScaleVelocity(0.25)
      Goto Pain
     Pain.ShadowBossFling:
      "----" H 0 A_SpawnItemEx("PainShadowBossFlingHit")
      Goto Pain2
     Pain.ShadowBoss_FinalSliceW:
      "----" H 0 A_GiveInventory("ShadowBoss_FinalSliceWProtect", 1)
      goto Pain
     Pain.ShadowmanSliceDice:
      "----" H 0 ThrustThingZ(0, 15, 0, 0)
      Goto Pain+2

     Death.ShadowBossKunai:Death.ShadowBossPlatform:Death.ShadowBossOther:Death.ShadowBossBlind:Death.ShadowBossBlade:
     Death.ShadowBossBladeQR:Death.ShadowBossCaltrop:Death.ShadowBossSuplex:Death.ShadowBossRoot:Death.ShadowBossFling:
     Death.ShadowBoss_FinalSlice:Death.ShadowBoss_FinalSliceW:Death.ShadowmanSliceDice:
      "----" H 0
      Goto Death.Disintegrate

      ///////////////////
      // Eyelento Major / Hawkeye
      ///////////////////
     Pain.EyelentoMajorKick:
      "----" H 0 A_GiveInventory("PainPush_F_45", 1)
      "----" H 0 A_GiveInventory("PainPush_Z_40", 1)
      "----" H 0 A_GiveInventory("HalfShockedStopGiver", 1)
      Goto Pain
     Pain.EyelentoMajor:Pain.EyelentoEyeBaton:
      "----" H 0 A_GiveInventory("PainPush_F_4", 1)
      "----" H 0 A_GiveInventory("PainPush_Z_20", 1)
      Goto Pain

     Pain.HawkeyeBlind:
      "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 85, 250, 3)
      Goto Pain
     Death.HawkeyeBlind:
      goto Death.Ice

      ///////////////////
      // Magic Devil Eye (boss)
      ///////////////////
     Pain.MagicDevilEyeUpper:
      "----" H 0 A_GiveInventory("PainPush_Z_40", 1)
      Goto Pain
     Pain.MagicDevilEyeFling:
      "----" H 0 A_GiveInventory("PainMagicDevilEyeFling_P", 1)
      Goto Pain
     Pain.MagicDevilEyeHeave:
      "----" H 0 A_GiveInventory("PainPush_F_500", 1)
      "----" H 0 A_GiveInventory("PainPush_Z_40", 1)
      Goto Pain
     Death.MagicDevilEyeUpper:Death.MagicDevilEyeFling:Death.MagicDevilEyeHeave:
      "----" H 0
      goto Death.Massacre

      ///////////////////
      // Other boss movement
      ///////////////////
     Pain.IronCurtainUpFling:Pain.RussianGutsUpFling:
      "----" H 0
      Goto Pain.MoonBall
     Pain.BlueJayFling:Pain.ASPFling:
      "----" H 0 A_GiveInventory("PainPush_F_35")
      "----" H 0 A_GiveInventory("PainPush_Z_100")
      Goto Pain

     Pain.RogueArts_Kick:
      "----" H 0 A_SpawnItemEx("PainRogueArtsKickHit")
      Goto Pain2
     Death.RogueArts_Kick:
      "----" H 0 A_SpawnItemEx("DeathRogueArtsKickHit")
      Goto Death.FlingDamage

     Pain.LinBubbler:
      "----" H 0 A_SpawnItemEx("PainMaestroAquaGuts")
      Goto Pain
     Death.LinBubbler:
      "----" H 0 A_SpawnItemEx("DeathMaestroAquaGuts")
      Goto Death.FlingDamage

     Pain.BerserkerBlood:
      "----" H 0 A_GiveInventory("PainPush_Z_60")
      Goto Pain+1

     Pain.SoccerRockKick:
      "----" H 0 A_SpawnItemEx("PainSoccerRockFlingHit")
      Goto Pain

     Pain.FloovyFling:
      "----" H 0 A_GiveInventory("PainPush_Z_20")
      Goto Pain

      ///////////////////
      // Boss deaths
      ///////////////////
     Death.BossTimeStop:
     Death.JoterraTimeStop:
     Death.SueIce:Death.SovietCold:Death.SovietChill:Death.ShinNegaIce:Death.ElementalIce:
     Death.DemonToyIce:
      goto Death.Ice

     Death.DevilFire:Death.Pharaoh4MI:Death.SovietIgnite:Death.ShinNegaFire:Death.ElementalFire:Death.TroutiusFire:Death.MagmaCannon:Death.RazingRay:
     Death.GBeastFire:
     Death.SampiFire:
     Death.ThomasTrainFire:Death.BlackDevilFire:
     Death.MiniVileFire:
      Goto Death.Fire

     Death.IronCurtainUpFling:Death.RussianGutsUpFling:
     Death.SadToadFling:
     Death.Rawsh:Death.MagicSpecialist:Death.StepAsideFling:Death.KillerBoxFling:
      goto Death.WindStorm

     Death.Dickster:Death.RedeadGutsRage:Death.AbePennyInsta:Death.AbePennyFling:
     Death.BalladeGB_Shot:Death.BalladeGB_Mine:Death.BalladeGB_UltimateExplode:
      "----" H 0
      Goto Death.Beam

     Death.TrueMistressHell:Death.Hellbot:Death.ZankokunaHell:Death.SampiHell:Death.ASPHell:Death.MadAlphaHell:Death.MadAlphaHellX:
      "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
      "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 0, 5)
      Goto Death.Beam+1

     Death.GutsBuddyHell:Death.RussianGutsHell:Death.RedeadGutsHell:
     Death.WowieSpiderHell:
      "----" H 0 A_PlaySoundEx("classes/GUTSBUTT", "Body")
      "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 24, 15)
      "----" H 0
      Goto Death.Beam+1

     Death.HardM_Flat:
     Death.StoneM_Leap:
     Death.WindM_Crush:
     Death.ODuo_Crush:
     Death.ConcreteM_Flat:
     Death.CommandoM_Crush:
     Death.Uranus_Flat:Death.Uranus_Stampede:Death.Neptune_Crush:
     Death.Flatten:
      goto Death.MetalPress

     Death.DustM_Shot:Death.DustM_Crush:Death.DustM_CrushBit:
     Death.JunkM_Cube:Death.JunkM_Shot:Death.JunkM_Punch:Death.JunkM_Shield:Death.JunkM_Shock:
      goto Death.DustCrusher

     Death.HellbotPoison:
      "----" H 0 A_SpawnItemEx("HellBotPoisonExplosion", 0, 0, 28)
      Goto Death.Disintegrate

     Death.ShinBanish:
      "----" H 0
      goto Death.Massacre
    }
}

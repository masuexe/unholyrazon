    "----" H 0 A_GiveInventory("RewardOfRecruitment_P")
    goto Pain+2
   Pain.MGZeroZap:
    goto Pain_Shock
   Pain.FortuneCoin:
    "----" H 0 A_GiveInventory("FortuneCoinProtect")

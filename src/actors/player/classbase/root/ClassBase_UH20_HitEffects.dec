// Unholy hit, protection, and status effects
actor ClassBaseUH20_HitEffects : ClassBaseUH10_BaseDamageTypes {
  States {
    ///////////////////
    // Protection / immunity / inventory side effects
    ///////////////////
   Pain.FriendBall:
    "----" H 0 A_GiveInventory("FriendBallItem")
    Goto Pain
   Pain.IgniterAlt:
    "----" H 0 A_GiveInventory("IgniterAltProtect")
    Goto Pain
   Pain.SluggerShotgun:
    "----" H 0 A_GiveInventory("SluggerShotgunProtect")
    Goto Pain
   Pain.SmokeBanditSlow:
    "----" H 0 A_GiveInventory("SmokeBanditSlowProtect")
    Goto Pain_65
   Pain.SamuraiSam:
    "----" H 0 A_GiveInventory("SamuraiSamProtect")
    Goto Pain
   Pain.SamuraiSamSlash:
    "----" H 0 A_GiveInventory("SamuraiSamSlashProtect")
    Goto Pain
   Pain.TidalLaser:
    "----" H 0 A_GiveInventory("TidalLaserProtect")
    Goto Pain
   Pain.TidalMine:
    "----" H 0 A_GiveInventory("TidalMineProtect")
    Goto Pain
   Pain.MarksmanDebuff:
    "----" H 0 A_GiveInventory("MarksmanDebuff_P")
    Goto Pain
   Pain.GreenElfArrow:
    "----" H 0 A_GiveInventory("GreenElfArrowProtect")
    Goto Pain
   Pain.MiuSpin:
    "----" H 0 A_GiveInventory("MiuSpinProtect")
    Goto Pain
   Pain.KickChamp_Dive:
    "----" H 0 A_GiveInventory("KickChamp_DiveProtect")
    goto Pain
   Pain.EdenFetus:
    "----" H 0 A_GiveInventory("EdenFetusProtect")
    Goto Pain+2
   Pain.ColdMist:
    "----" H 0 A_GiveInventory("Pain_ColdMist_P")
    Goto Pain
   Pain.BeermanConcrete:
    "----" H 0 A_GiveInventory("Beerman_ConcreteStart_P")
    Goto Pain
   Pain.TorCal_Knifers:
    "----" H 0 A_GiveInventory("TorCal_Stab_Protect")
    "----" H 0 A_SpawnItemEx("Pain_TorCal_Backstab")
    Goto Pain
   Pain.ShadowBossBlade:
    "----" H 0 A_GiveInventory("ShadowBoss_BladeProtect")
    Goto Pain
   Pain.ShadowBossBladeQR:
    "----" H 0 A_GiveInventory("ShadowBoss_BladeProtectQR")
    Goto Pain
   Pain.ShadowBoss_FinalSliceW:
    "----" H 0 A_GiveInventory("ShadowBoss_FinalSliceWProtect")
    goto Pain

    ///////////////////
    // Hitstun / slow / stop / paralyze
    ///////////////////
   Pain.DragonBreath:
    Goto Pain_90
   Pain.LuckyJudge5:
    Goto Pain_75
   Pain.SaboteurSlow: Pain.YeLucky: Pain.M_CrashBomb:
    Goto Pain_65
   Pain.MiuSlow:
    Goto Pain_50
   Pain.LuckyJudge2:
   Pain.SmokeBanditStop:
    goto Pain_0
   Pain.SaboteurStop:
    "----" H 0 A_PlaySoundEx("classes/DerpyHit", "Voice")
   Pain.TrapistStun: Pain.SiteWorkerStun: Pain.CaptainAssStun:
    goto Pain_StopAndShock
   Pain.NetBall: Pain.GreatShieldStun: Pain.JuggerRam:
    "----" H 0 A_GiveInventory("PainHitstun_85_P")
    goto Pain_Shock
   Pain.M_SparkShock: Pain.LuckyDerp: Pain.CatStun: Pain.TerrorStun: Pain.HandyStun: Pain.WispStun:
    Goto Pain_Shock
   Pain.ThunderWave: Pain.ElectricianStun:
   Pain.CombatStun: Pain.SiteWorkerStunW:
   Pain.SutokaStun: Pain.IronCurtainStun: Pain.EdwardStun: Pain.GutsBuddyStun: Pain.RedeadGutsStun: Pain.HalfPressHardmanStun:
   Pain.SadToadStun: Pain.AlphaStun:/*Pain.GBeastStun:Pain.FBeastStun:*/Pain.AbePennyStun: Pain.MadAlphaStun: Pain.CommandoHommandoStun:
   Pain.Chieftain_Stun: Pain.HawkeyeStun:
   Pain.ThunderTankStun: Pain.ThunderTankStunB:
    Goto Pain_HalfShock
   Pain.TimeBender: Pain.LuxuryBall: Pain.LuckyJudge8: Pain.SinisterStop: Pain.YeSinisterStop:
   Pain.BossTimeStop: Pain.AlienJrTimeStop: Pain.JoterraTimeStop:
    goto Pain_TimeStop
   Pain.NegaTimeSlow:
    "----" H 0 A_GiveInventory("NegaSlowed")
    goto Pain+2
   Pain.NegaTimeSlow2:
    "----" H 0 A_GiveInventory("NegaSlowed_S")
    goto Pain+2
   Pain.GBeastStun: Pain.FBeastStun:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 60)
    Goto Pain_Paralyze
   Pain.GBeastFurySwipeStun: Pain.FBeastFurySwipeStun:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 20)
    Goto Pain_Paralyze
   Pain.SFStunKnuckle:
    "----" H 0 A_JumpIfInventory("PlayerPropertyNoParalyze", 1, "SFStunKnuckle_BreakIt")
   SFStunKnuckle_Paralyze:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 105)
    Goto Pain_Paralyze
   SFStunKnuckle_BreakIt:
    "----" H 0 A_PlaySoundEx("MMSF3/BodyBreak", "Auto")
    "----" H 0 ACS_NamedExecuteWithResult("rz_NoParalyzePlayer", 0, false)
    goto SFStunKnuckle_Paralyze
   Pain.SFElectricSlash:
    "----" H 0 A_TakeInventory("PlayerParalyzedTimer")
    "----" H 0 A_GiveInventory("PlayerParalyzedTimer", 70)
    Goto Pain_Paralyze

    ///////////////////
    // Visual / blind / flash effects
    ///////////////////
   Pain.LuckyJudge6:
    "----" H 0 A_SetBlend(OrangeRed, 0.5, 15)
    Goto Pain+2
   Pain.LuckyJudge3:
    "----" H 0 ACS_NamedExecuteWithResult("uh_FlashStopperRNG", 80, 200, 2)
    Goto Pain
   Pain.SniperBlind:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 80, 200, 2)
    goto Pain.LuckyIce
   Pain.M_FlashStopper: Pain.LuckyIce:
   Pain.ASPBlind: Pain.ASPBlindJr:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 80, 150, 0)
    "----" H 0 A_GiveInventory("PainHitstun_0_P")
    Goto Pain
   Pain.ShadowBossBlind:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 150, 350, 3)
    Goto Pain
   Pain.HawkeyeBlind: Pain.FlashingDemoneye:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 85, 250, 3)
    Goto Pain

    ///////////////////
    // Poison / burn / target effects
    ///////////////////
   Pain.TheDentistDebuff:
    "----" H 0 A_GiveInventory("TheDentistDebuff_P")
    Goto Pain
   Pain.RaiderA:
    "----" H 0 A_PlaySoundEx("GNT/Poison", 2, 0.80)
    "----" H 0 A_SpawnItemEx("PainRaiderPoisonHit")
    Goto Pain+2
   Pain.RaiderB:
    "----" H 0 A_SpawnItemEx("PainRaiderPoisonHit2")
    Goto Pain
   Pain.Decoy17Poison:
    "----" H 0 A_PlaySoundEx("GNT/Poison", 2, 0.75)
    "----" H 0 A_SpawnItemEx("PainDecoy17PoisonHit")
    Goto Pain+2
   Pain.RaiderPoison:
    "----" H 0 A_SetBlend(DarkGreen, 0.5, 35)
    Goto Pain+2
   Pain.WispKindle:
    "----" H 0 ACS_NamedExecuteWithResult("uc_WispHex", 0, CallACS("core_getptrtid", 2)-1000)
    "----" H 0 A_GiveInventory("WispKindle_P")
    Goto Pain
   Pain.WispHex:
    "----" H 0 A_SetBlend(firebrick, 0.35, 35)
    "----" H 0 A_SpawnItemEx("Pain_WispHexHit")
    "----" H 0 A_GiveInventory("WispHexProtect")
    Goto Pain
   Pain.MorshuLampOil:
    "----" H 0 A_SpawnItemEx("PainMorshuMolotovBurn")
    Goto Pain
   Pain.HellbotPoison:
    "----" H 0 A_SpawnItemEx("HellbotPoisonHit", 0, 0, 0, 0, 0, 0, 0, 1)
    goto Pain.SparkShock
   Pain.Mosquitoeye:
    "----" H 0 A_GiveToTarget("MosquitoeyeHealer_P")
    goto Pain+2
   Pain.MolotovCocktail: Pain.MolotovCocktailB:
    "----" H 0 A_GiveInventory("PainMolotovCocktail_P")
    goto Pain+2
   Pain.MolotovCocktailShot: Pain.MolotovCocktailShotB:
    "----" H 0 A_GiveInventory("PainMolotovCocktail_P")
    goto Pain
   Pain.UrineBottle: Pain.UrineBottleB:
    "----" H 0 A_GiveInventory("UrineDebuff_P")
    goto Pain

    ///////////////////
    // Special hit reactions
    ///////////////////
   Pain.KateBackstab:
    "----" H 0 A_SpawnItemEx("PainKateBackstabHit")
    Goto Pain
   Pain.S_KateBackstab:
    "----" H 0 A_SpawnItemEx("PainS_KateBackstabHit")
    Goto Pain
   Pain.LinBubbler:
    "----" H 0 A_SpawnItemEx("PainMaestroAquaGuts")
    Goto Pain
  }
}

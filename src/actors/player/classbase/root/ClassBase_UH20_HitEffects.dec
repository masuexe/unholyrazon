// Unholy hit, protection, and status effects
actor ClassBase_UH20_HitEffects : ClassBase_UH10_BaseDamageTypes {
  States {
    ///////////////////
    // Class / weapon-specific reactions
    ///////////////////
   Pain.Sakugarne:
    "----" H 0 A_SetAngle(angle + random(-8, 8))
    "----" H 0 A_SetPitch(pitch + random(-8, 8))
    Goto Pain
   Pain.NegaBuster:
    Goto Pain
   Pain.CrystrapStun:
    goto Pain_Stop
   Pain.SoraNoMusica:
    "----" H 0 A_GiveInventory("PowerMujicaProtection")

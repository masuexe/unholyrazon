// Unholy survivor Pain / Death specials
actor ClassBaseU2 : ClassBaseU1
{
States
{

///////////////////
// Sound / Protects
///////////////////
Pain.FriendBall:
"----" H 0 A_GiveInventory("FriendBallItem")
Goto Pain

Pain.IgniterAlt:
"----" H 0 A_GiveInventory("IgniterAltProtect")
Goto Pain

Pain.SluggerShotgun:
"----" H 0 A_GiveInventory("SluggerShotgunProtect")
Goto Pain

Pain.SmokeBanditSlow:
"----" H 0 A_GiveInventory("SmokeBanditSlowProtect")
Goto Pain_65

Pain.TheDentistDebuff:
"----" H 0 A_GiveInventory("TheDentistDebuff_P")
Goto Pain

Pain.SamuraiSam:
"----" H 0 A_GiveInventory("SamuraiSamProtect")
Goto Pain
Pain.SamuraiSamSlash:
"----" H 0 A_GiveInventory("SamuraiSamSlashProtect")
Goto Pain

Pain.TidalLaser:
"----" H 0 A_GiveInventory("TidalLaserProtect")
Goto Pain

Pain.TidalMine:
"----" H 0 A_GiveInventory("TidalMineProtect")
Goto Pain

Pain.MarksmanDebuff:
"----" H 0 A_GiveInventory("MarksmanDebuff_P")
Goto Pain

Pain.GreenElfArrow:
"----" H 0 A_GiveInventory("GreenElfArrowProtect")
Goto Pain

Pain.MiuSpin:
"----" H 0 A_GiveInventory("MiuSpinProtect")
Goto Pain

Pain.KickChamp_Dive:
"----" H 0 A_GiveInventory("KickChamp_DiveProtect")
goto Pain

Pain.ColdMist:
"----" H 0 A_GiveInventory("Pain_ColdMist_P",1)
Goto Pain

Pain.BeermanConcrete:
"----" H 0 A_GiveInventory("Beerman_ConcreteStart_P")
Goto Pain

///////////////////
// Stops / Slows / Shock
///////////////////
Pain.DragonBreath:
Goto Pain_90

Pain.LuckyJudge5:
Goto Pain_75

Pain.SaboteurSlow:Pain.YeLucky:Pain.M_CrashBomb:
Goto Pain_65

Pain.MiuSlow:
Goto Pain_50

Pain.LuckyJudge2:
Pain.SmokeBanditStop:
goto Pain_0

Pain.SaboteurStop:
"----" H 0 A_PlaySoundEx("classes/DerpyHit","Voice")
Pain.TrapistStun:Pain.SiteWorkerStun:Pain.CaptainAssStun:
goto Pain_StopAndShock

Pain.NetBall:Pain.GreatShieldStun:Pain.JuggerRam:
"----" H 0 A_GiveInventory("PainHitstun_85_P",1)
goto Pain_Shock

Pain.M_SparkShock:Pain.LuckyDerp:Pain.CatStun:Pain.TerrorStun:Pain.HandyStun:Pain.WispStun:
Goto Pain_Shock

Pain.ThunderWave:Pain.ElectricianStun:
Pain.CombatStun:Pain.SiteWorkerStunW:
Goto Pain_HalfShock

Pain.TimeBender:Pain.LuxuryBall:Pain.LuckyJudge8:Pain.SinisterStop:Pain.YeSinisterStop:
goto Pain_TimeStop

Pain.NegaTimeSlow:
"----" H 0 A_GiveInventory("NegaSlowed")
goto Pain+2

Pain.NegaTimeSlow2:
"----" H 0 A_GiveInventory("NegaSlowed_S")
goto Pain+2

///////////////////
// Flings
///////////////////
Pain.RageFling:
"----" H 0 A_GiveInventory("PainPush_F_35")
"----" H 0 A_GiveInventory("PainPush_Z_100")
Goto Pain

Pain.GloryFling:
Pain.SumoQuakeFling:
"----" H 0 A_GiveInventory("PainPush_Z_40")
Goto Pain

Pain.Nega_GHold:
Pain.LureBall:
"----" H 0 ThrustThingZ(0,150,1,0)
Goto Pain

Pain.M_WindStorm:
"----" H 0 A_CheckFloor(1)
Goto Pain
"----" H 0 A_GiveInventory("PainPush_Z_60",1)
Goto Pain

Pain.M_TornadoBlow:
Pain.MoonBall:
"----" H 0 A_GiveInventory("PainPush_Z_60",1)
Goto Pain

Pain.ZangiefPush:
"----" H 0 A_Stop
"----" H 0 A_GiveInventory("HalfShockedStopGiver",1)
"----" H 0 A_SpawnItemEx("PainZangiefPushHit")
goto Pain

Pain.TidalFling:
"----" H 0 A_SpawnItemEx("PainTidalFlingHit")
"----" H 0 ThrustThingZ(0,30,0,0)
Goto Pain2

///////////////////
// Effects
///////////////////
Pain.LuckyJudge6:
"----" H 0 A_SetBlend(OrangeRed,0.5,15)
Goto Pain+2
Pain.LuckyJudge3:
"----" H 0 ACS_NamedExecuteWithResult("uh_FlashStopperRNG",80,200,2)
Goto Pain
Pain.SniperBlind:
"----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG",0,80,200,2)
goto Pain.LuckyIce
Pain.M_FlashStopper:Pain.LuckyIce:
"----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG",0,80,150,0)
"----" H 0 A_GiveInventory("PainHitstun_0_P",1)
Goto Pain

///////////////////
// TID soup
///////////////////
Pain.RaiderA:
"----" H 0 A_PlaySoundEx("GNT/Poison",2,0.80)
"----" H 0 A_SpawnItemEx("PainRaiderPoisonHit")
Goto Pain+2
Pain.RaiderB:
"----" H 0 A_SpawnItemEx("PainRaiderPoisonHit2")
Goto Pain
Pain.Decoy17Poison:
"----" H 0 A_PlaySoundEx("GNT/Poison",2,0.75)
"----" H 0 A_SpawnItemEx("PainDecoy17PoisonHit")
Goto Pain+2

Pain.RaiderPoison:
"----" H 0 A_SetBlend(DarkGreen,0.5,35)
Goto Pain+2

Pain.HomingSeekerFling:
"----" H 0 A_SpawnItemEx("PainHomingSeekerFlingHit")
Goto Pain2
Death.HomingSeekerFling:
"----" H 0 A_SpawnItemEx("DeathHomingSeekerFlingHit")
Goto Death.FlingDamage

Pain.AmberFlingAway:
"----" H 0 A_SpawnItemEx("PainAmberFlingAwayHit")
Goto Pain.AmberFlingUp
Pain.AmberFlingAway2:
"----" H 0 A_SpawnItemEx("PainAmberFlingAway2Hit")
Goto Pain.AmberFlingUp
Pain.AmberFlingAway3:
"----" H 0 A_SpawnItemEx("PainAmberFlingAway3Hit")
Goto Pain.AmberFlingUp
Pain.AmberFlingUp:
"----" H 0 A_SpawnItemEx("PainAmberFlingUpHit")
Goto Pain_AmberGive
Death.AmberFlingAway:Death.AmberFlingAway2:Death.AmberFlingAway3:Death.AmberFlingUp:Death.AmberFire:
"----" H 0 A_GiveToTarget("Amber_GainOnHit_P",1)
Goto Death.FlingDamage
Pain_AmberGive:
"----" H 0 A_GiveToTarget("Amber_GainOnHit_P")
Goto Pain

Pain.KateBackstab:
"----" H 0 A_SpawnItemEx("PainKateBackstabHit")
Goto Pain
Pain.S_KateBackstab:
"----" H 0 A_SpawnItemEx("PainS_KateBackstabHit")
Goto Pain

Pain.WispKindle:
"----" H 0 ACS_NamedExecuteWithResult("uc_WispHex",0,CallACS("core_getptrtid",2)-1000)
"----" H 0 A_GiveInventory("WispKindle_P")
Goto Pain
Pain.WispHex:
"----" H 0 A_SetBlend(firebrick,0.35,35)
"----" H 0 A_SpawnItemEx("Pain_WispHexHit")
"----" H 0 A_GiveInventory("WispHexProtect",1)
Goto Pain

///////////////////
// Survivor deaths
///////////////////
Death.LuckyJudge2:
"----" H 0 A_Stop
Goto Death
Death.LuckyJudge1:
Death.WispStun:
"----" H 0 A_SpawnItemEx("WispGraveCallingCard",0,0,0,momx,momy,momz,0,9)
goto Death
Death.Wisp:Death.WispKindle:Death.WispHex:
"----" H 0 A_SpawnItemEx("WispGraveCallingCard",0,0,0,momx,momy,momz,0,9)
goto Death.Fire
Death.KickChamp_Dive:
"----" H 0 A_SpawnItemEx("KickChamp_KickNukeFX",0,0,0,0,0,0,0,1)
"----" H 0 A_FaceTarget
"----" H 0 A_Recoil(45)
Goto Death.Disintegrate

Death.HardKnuckle:Death.ChargeKick:Death.BreakDash:Death.M_BreakDash:
Death.LuckyDerp:Death.RapidAlt:Death.TidalFling:Death.DecoyClusterAlt:
"----" H 0 A_SpawnItemEx("DeathFling70Hit")
Goto Death.FlingDamage
Death.NegaKick:Death.LuckyJudge4:Death.ArcaneAir:Death.SumoQuakeFling:
"----" H 0 A_SpawnItemEx("DeathFling30Hit")
Goto Death.FlingDamage

Death.NegaIceWallBeam:Death.NegaIceWallExplode:Death.NegaChillSpike:Death.LuxuryBall:Death.FreezeDry:Death.IceBeam:Death.IceShard:
Death.LuckyIce:Death.LuckyJudge8:Death.ColdShot:Death.ColdMist:Death.ArcaneWater:Death.YeArcane:Death.SinisterStop:
Death.SniperBlind:Death.TerrorStun:Death.YeSinisterStop:Death.DecoyArcaneWater:
goto Death.Ice

Death.FlameBurst:Death.BlazeKick:Death.FireBlast:Death.FireBlastE:Death.FlameWheel:
Death.LuckyFire:Death.LuckyJudge6:Death.Igniter:Death.IgniterAlt:Death.ArcaneFire:Death.SluggerFire:Death.RamesesFire:
Death.OnFire:Death.OnFireB:
Goto Death.Fire

Death.LuckyJudge7:
Death.YellowWizardPotion:
"----" H 0 A_SpawnItemEx("GauntletFoodPickup",0,0,0,0,0,0,0,1)
Goto Death.Beam+1

Death.LuckyJudge9:
goto Death.Disintegrate

}
}

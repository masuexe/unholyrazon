// Unholy demoneye + mystic item Pain / Death specials
actor ClassBaseU4 : ClassBaseU3 {
  States {
    ///////////////////
    // Demoneye
    ///////////////////
   Pain.ASPFlingJr: Pain.TankeyeFling:
    "----" H 0 A_GiveInventory("PainPush_F_35")
    "----" H 0 A_GiveInventory("PainPush_Z_100")
    Goto Pain

   Pain.WindDemoneyeFling: Pain.MagicSpecialist:
    "----" H 0 A_GiveInventory("PainPush_F_4", 1)
    "----" H 0 A_GiveInventory("PainPush_Z_30", 1)
    Goto Pain

   Pain.ASPBlind: Pain.ASPBlindJr:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 80, 150, 0)
    "----" H 0 A_GiveInventory("PainHitstun_0_P", 1)
    Goto Pain

   Pain.FlashingDemoneye:
    "----" H 0 ACS_NamedExecuteAlways("uh_FlashStopperRNG", 0, 85, 250, 3)
    Goto Pain

   Pain.StepAsideFling:
    "----" H 0 A_GiveInventory("PainPush_F_5", 1)
    "----" H 0 A_GiveInventory("PainPush_Z_120", 1)
    Goto Pain

   Pain.ThunderTankStun: Pain.ThunderTankStunB:
    Goto Pain_HalfShock

   Death.Bombereye:
    Goto Death.Fire

   Death.WindDemoneyeFling:
    goto Death.WindStorm

   Death.Kamikazeeye:
   Death.Springeye:
    "----" H 0
    Goto Death.Beam

   Death.ASPGhostX:
    "----" H 0 A_GiveInventory("ExplodeDeathFlag", 1)
    Goto Death.Disintegrate

    ///////////////////
    // Unholy mystic / pandora items (protect stubs → Pain)
    ///////////////////
   Pain.Springeye:
   Pain.MoneyBaitCash:
   Pain.WaspBomb: Pain.WaspBombB:
   Pain.LoliBalloon:
   Pain.GothicBalloon:
   Pain.DarkmanToy:
   Pain.DemonToyIce:
   Pain.GiveUpHope:
   Pain.RubberBand:
   Pain.OnFire: Pain.OnFireB:
   Pain.Solitaire: Pain.SolitaireB:
   Pain.BluntRocket: Pain.BluntRocketB:
   Pain.SharpRocket: Pain.SharpRocketB:
   Pain.MeteorItem:
   Pain.UnholyWater: Pain.UnholyWaterB:
   Pain.Ztar: Pain.ZtarB:
   Pain.BrickMine:
   Pain.UnholyBook:
   Pain.ContrabandItem2:
   Pain.WhackSpell:
   Pain.YouWillDie:
   Pain.SuperGiveUpHope:
   Pain.Football:
   Pain.HackyCoffee:
   Pain.BEESItem: Pain.BEESItemB:
   Pain.WishingStar:
   Pain.InvincibleCandy: Pain.InvincibleCandyB:
   Pain.MoneyBombCash:
   Pain.Thumbtack:
   Pain.GoldenWasp:
   Pain.MountainDew:
   Pain.RandomPony: Pain.RandomPonyB:
   Pain.DeadlyFireArm: Pain.DeadlyFireArmB:
   Pain.CarpetBomb: Pain.CarpetBombB:
   Pain.HogWash:
    "----" H 0
    Goto Pain

   Death.SharpRocket: Death.SharpRocketB: Death.MeteorItem: Death.UnholyBook: Death.ContrabandItem2:
    "----" H 0
    Goto Death.Beam
   Death.Thumbtack:
    "----" H 0
    Goto Death.Beam+1
   Death.GiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 0, 5)
    Goto Death.Beam+1
   Death.YouWillDie: Death.SuperGiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 1, 10)
    goto Death.Beam+1
   Death.Football:
    "----" H 0 A_PlaySoundEx("classes/FOOTBALLSCARE", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 2, 7)
    "----" H 0
    Goto Death.Beam+1
   Death.WishingStar:
    "----" H 0 A_GiveInventory("ExplodeDeathFlag", 1)
    Goto Death.Disintegrate

   Pain.MolotovCocktail: Pain.MolotovCocktailB:
    "----" H 0 A_GiveInventory("PainMolotovCocktail_P")
    goto Pain+2
   Pain.MolotovCocktailShot: Pain.MolotovCocktailShotB:
    "----" H 0 A_GiveInventory("PainMolotovCocktail_P")
    goto Pain

   Pain.VergilChair:
    "----" H 0 ThrustThingZ(0, 52, 0, 1)
    "----" H 0 A_SpawnItemEx("TopTwistPain_H")
    Goto Pain+2

   Death.MolotovCocktail: Death.MolotovCocktailB:
   Death.MolotovCocktailShot: Death.MolotovCocktailShotB:
    "----" H 0
    Goto Death.Fire
  }
}

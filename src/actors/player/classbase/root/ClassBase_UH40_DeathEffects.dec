// Unholy death effects grouped by outcome
actor ClassBase_UH40_DeathEffects : ClassBase_UH30_MovementEffects {
  States {
    ///////////////////
    // Ice / freeze deaths
    ///////////////////
   Death.SniperBlind: Death.TerrorStun: Death.YeSinisterStop: Death.DecoyArcaneWater:
   Death.HawkeyeBlind:
   Death.DemonToyIce:
    goto Death.Ice
    ///////////////////
    // Fire / burn deaths
    ///////////////////
   Death.Wisp: Death.WispKindle: Death.WispHex:
    "----" H 0 A_SpawnItemEx("WispGraveCallingCard", 0, 0, 0, momx, momy, momz, 0, 9)
    goto Death.Fire
   Death.OnFire: Death.OnFireB:
   Death.MiniVileFire:
   Death.Bombereye:
   Death.MolotovCocktailShot: Death.MolotovCocktailShotB:
   Death.RedPoop: Death.GravityKamiliaCoal:
    Goto Death.Fire
    ///////////////////
    // Wind deaths
    ///////////////////
   Death.Rawsh: Death.MagicSpecialist: Death.StepAsideFling: Death.KillerBoxFling:
   Death.WindDemoneyeFling:
   Death.LureBall: Death.MoonBall: Death.MoonBlast: Death.RageFling:
    goto Death.WindStorm
    ///////////////////
    // Fling / knockback deaths
    ///////////////////
   Death.HomingSeekerFling:
    "----" H 0 A_SpawnItemEx("DeathHomingSeekerFlingHit")
    Goto Death.FlingDamage
   Death.AmberFlingAway: Death.AmberFlingAway2: Death.AmberFlingAway3: Death.AmberFlingUp: Death.AmberFire:
    "----" H 0 A_GiveToTarget("Amber_GainOnHit_P")
    Goto Death.FlingDamage
   Death.LuckyDerp: Death.RapidAlt: Death.TidalFling: Death.DecoyClusterAlt:
    "----" H 0 A_SpawnItemEx("DeathFling70Hit")
    Goto Death.FlingDamage
   Death.NegaKick: Death.LuckyJudge4: Death.ArcaneAir: Death.SumoQuakeFling:
    "----" H 0 A_SpawnItemEx("DeathFling30Hit")
    Goto Death.FlingDamage
   Death.RogueArts_Kick:
    "----" H 0 A_SpawnItemEx("DeathRogueArtsKickHit")
    Goto Death.FlingDamage
   Death.LinBubbler:
    "----" H 0 A_SpawnItemEx("DeathMaestroAquaGuts")
    Goto Death.FlingDamage
   Death.TrapistMine:
    goto Death.FlingDamage
   Death.GenericBoss: Death.GutsBuddyPunch: Death.RussianGutsPunch:
   Death.JoterraFling: Death.SampiFling: Death.ThomasTrainFling:
    "----" H 0 A_GiveInventory("FlingDeathFlag", 70)
    Goto Death.FlingDamage
   Death.DevilWindUp: Death.TrueMistressUpper: Death.TroutiusUpper:
   Death.AlphaUpper: Death.BlackDevilUpper: Death.MadAlphaUpper:
    "----" H 0 A_GiveInventory("FlingDeathFlag", 50)
    Goto Death.FlingDamage
   Death.IronCurtainFling: Death.ShinNegaFling: Death.AirCXFling:
    "----" H 0 A_GiveInventory("FlingDeathFlag", 30)
    Goto Death.FlingDamage
    ///////////////////
    // Beam / scare deaths
    ///////////////////
   Death.YellowWizardPotion:
    "----" H 0 A_SpawnItemEx("GauntletFoodPickup", 0, 0, 0, 0, 0, 0, 0, 1)
    Goto Death.Beam+1
   Death.MWS_FruitX:
    "----" H 0 A_SpawnItemEx("TropicalMWS_MelonPickup", 0, 0, 0, 0, 0, 0, 0, 1)
    Goto Death.Beam+1
   Death.DLCCent: Death.DLCCentBomb:
    "----" H 0 A_SpawnItemEx("DLCCentaurmanItemFX")
    Goto Death
   Death.CCBStomp:
    "----" H 0 A_PlaySoundEx("classes/CCBWaao", "Body")
    "----" H 0 ACS_NamedExecuteWithResult("uh_ScreenScare", 27, 10)
    Goto Death.Beam+1
   Death.BalladeGB_Shot: Death.BalladeGB_Mine: Death.BalladeGB_UltimateExplode:
   Death.Springeye:
   Death.SharpRocket: Death.SharpRocketB: Death.MeteorItem: Death.UnholyBook: Death.ContrabandItem2:
    Goto Death.Beam
   Death.TrueMistressHell: Death.Hellbot: Death.ZankokunaHell: Death.SampiHell: Death.ASPHell: Death.MadAlphaHell: Death.MadAlphaHellX:
   Death.GiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteWithResult("uh_ScreenScare", 0, 5)
    Goto Death.Beam+1
   Death.WowieSpiderHell:
    "----" H 0 A_PlaySoundEx("classes/GUTSBUTT", "Body")
    "----" H 0 ACS_NamedExecuteWithResult("uh_ScreenScare", 24, 15)
    Goto Death.Beam+1
   Death.Destron: Death.PurpleDestron: Death.RedDestron: Death.BlueDestron:
    "----" H 0 A_PlaySoundEx("classes/TransformerDeath", "Body")
    "----" H 0 A_SpawnItemEx("TransformerClassDeathFX", 0, 0, 28, 0, 0, 0, 0, 1)
    goto DeathWaitOLD
   Death.MGZero: Death.MGZeroZap: Death.MGZeroIcicle:
    "----" H 0 A_PlaySoundEx("RPGMaker/Explosion2", 4)
    "----" H 0 A_PlaySoundEx("Billy/PatchouliGo", 5)
    "----" H 0 A_SpawnItemEx("BasicBoomRMFX_Fire2_Tic2", 0, 0, 0, 0, 0, 0, 0, 16384)
    goto DeathWaitOLD
   Death.Thumbtack:
    "----" H 0
    Goto Death.Beam+1
   Death.YouWillDie: Death.SuperGiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteWithResult("uh_ScreenScare", 1, 10)
    goto Death.Beam+1
   Death.Football:
    "----" H 0 A_PlaySoundEx("classes/FOOTBALLSCARE", "Body")
    "----" H 0 ACS_NamedExecuteWithResult("uh_ScreenScare", 2, 7)
    Goto Death.Beam+1
    ///////////////////
    // Disintegrate deaths
    ///////////////////
   Death.KickChamp_Dive:
    "----" H 0 A_SpawnItemEx("KickChamp_KickNukeFX", 0, 0, 0, 0, 0, 0, 0, 1)
    "----" H 0 A_FaceTarget
    "----" H 0 A_Recoil(45)
    Goto Death.Disintegrate
   Death.LuckyJudge9:
   Death.ShadowBoss_FinalSlice: Death.ShadowBoss_FinalSliceW: Death.ShadowmanSliceDice:
    Goto Death.Disintegrate
   Death.Torcal_DamageEX:
    "----" H 0 A_GiveToTarget("ConniverRetribution")
    Goto Death.Disintegrate
   Death.CeobeTomahawkNormal: Death.CeobeTomahawkHit:
   Death.CeobeTomahawkGrabBack: Death.CeobeTouch:
    "----" H 0 A_GiveToTarget("CeobeFun", 1)
    "----" H 0 A_GiveInventory("CorpseFlag", 1)
    "----" H 0 A_SetTranslucent(0.0, 0)
    Goto Death
   Death.Neru:
    "----" H 0 A_GiveToTarget("UnholyPower500", 250)
    "----" H 0 A_GiveToTarget("UnholyPower1500", 150)
    Goto Death
   Death.Neru_EX: Death.NeruFire:
    "----" H 0 A_GiveToTarget("Neru_Thrill_Rush_P")
    "----" H 0 A_GiveToTarget("UnholyPower500", 375)
    "----" H 0 A_GiveToTarget("UnholyPower1500", 250)
    "----" H 0 A_GiveInventory("CorpseFlag", 1)
    "----" H 0 A_SetTranslucent(0.0, 0)
    Goto Death
   Death.Misery_C:
    Goto Death.Disintegrate
   Death.HillbillyRam:
    "----" H 0 A_SpawnItemEx("MightyNumberPizzaExplosion", 0, 0, 28)
    "----" H 0 A_GiveToTarget("ConfederatePainPickup", 1)
    Goto Death.Disintegrate
   Death.DonJavierRage:
    "----" H 0 A_SpawnItemEx("DonJavierRageHitFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("UnholyPower1500", 400)
    Goto Death.Disintegrate
   Death.IronCurtainRam:
    "----" H 0 A_SpawnItemEx("IronCurtainIronBodyFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("IronCurtainIronBody_P")
    Goto Death.Disintegrate
   Death.DixieandoffRage:
    "----" H 0 A_SpawnItemEx("DixieDeusVultFX", 0, 0, 28)
    "----" H 0 A_GiveToTarget("DixieDeusVult_P")
    Goto Death.Disintegrate
   Death.AlphaRage:
    "----" H 0 A_GiveToTarget("AlphaRageStrike_P")
    Goto Death.Disintegrate
   Death.MadAlphaRage:
    "----" H 0 A_GiveToTarget("MadAlphaRageStrike_P")
    Goto Death.Disintegrate
   Death.HellbotPoison:
    "----" H 0 A_SpawnItemEx("HellBotPoisonExplosion", 0, 0, 28)
    Goto Death.Disintegrate
   Death.ASPGhostX: Death.WishingStar:
    "----" H 0 A_GiveInventory("ExplodeDeathFlag")
    Goto Death.Disintegrate
    ///////////////////
    // Crush / press deaths
    ///////////////////
   Death.Flatten:
    goto Death.MetalPress
   Death.ThwompCrush:
    goto Death.MetalPress
   Death.JunkM_Cube: Death.JunkM_Shot: Death.JunkM_Punch: Death.JunkM_Shield: Death.JunkM_Shock:
    goto Death.DustCrusher
    ///////////////////
    // Massacre / banish deaths
    ///////////////////
   Death.MagicDevilEyeUpper: Death.MagicDevilEyeFling: Death.MagicDevilEyeHeave:
   Death.ShinBanish:
    "----" H 0
    goto Death.Massacre
   Death.TDRManVector: Death.TDRManForcesYouToEatShitAndDie:
    "----" H 0 A_SpawnItemEx("FakeDeathFX", 0, 0, 50)
    "----" H 0 A_SetTranslucent(0.0, 0)
    goto Death
   Death.TopTwist:
    "----" H 0 ThrustThingZ(0, 52, 0, 0)
    Goto Death
   Death.AstronautPush:
    "----" H 0 ThrustThingZ(0, 24, 0, 0)
    Goto Death.FlingDamage
    ///////////////////
    // Custom / base death flow
    ///////////////////
   Death.LuckyJudge2:
    "----" H 0 A_Stop
    Goto Death
   Death.LuckyJudge1:
   Death.WispStun:
    "----" H 0 A_SpawnItemEx("WispGraveCallingCard", 0, 0, 0, momx, momy, momz, 0, 9)
    goto Death
  }
}

// Unholy death effects grouped by outcome
actor ClassBaseUH40_DeathEffects : ClassBaseUH30_MovementEffects {
  States {
    ///////////////////
    // Ice / freeze deaths
    ///////////////////
   Death.SniperBlind: Death.TerrorStun: Death.YeSinisterStop: Death.DecoyArcaneWater:
   Death.HawkeyeBlind:
   Death.DemonToyIce:
    goto Death.Ice
    ///////////////////
    // Fire / burn deaths
    ///////////////////
   Death.Wisp: Death.WispKindle: Death.WispHex:
    "----" H 0 A_SpawnItemEx("WispGraveCallingCard", 0, 0, 0, momx, momy, momz, 0, 9)
    goto Death.Fire
   Death.OnFire: Death.OnFireB:
   Death.MiniVileFire:
   Death.Bombereye:
   Death.MolotovCocktailShot: Death.MolotovCocktailShotB:
    Goto Death.Fire
    ///////////////////
    // Wind deaths
    ///////////////////
   Death.Rawsh: Death.MagicSpecialist: Death.StepAsideFling: Death.KillerBoxFling:
   Death.WindDemoneyeFling:
    goto Death.WindStorm
    ///////////////////
    // Fling / knockback deaths
    ///////////////////
   Death.HomingSeekerFling:
    "----" H 0 A_SpawnItemEx("DeathHomingSeekerFlingHit")
    Goto Death.FlingDamage
   Death.AmberFlingAway: Death.AmberFlingAway2: Death.AmberFlingAway3: Death.AmberFlingUp: Death.AmberFire:
    "----" H 0 A_GiveToTarget("Amber_GainOnHit_P")
    Goto Death.FlingDamage
   Death.LuckyDerp: Death.RapidAlt: Death.TidalFling: Death.DecoyClusterAlt:
    "----" H 0 A_SpawnItemEx("DeathFling70Hit")
    Goto Death.FlingDamage
   Death.NegaKick: Death.LuckyJudge4: Death.ArcaneAir: Death.SumoQuakeFling:
    "----" H 0 A_SpawnItemEx("DeathFling30Hit")
    Goto Death.FlingDamage
   Death.RogueArts_Kick:
    "----" H 0 A_SpawnItemEx("DeathRogueArtsKickHit")
    Goto Death.FlingDamage
   Death.LinBubbler:
    "----" H 0 A_SpawnItemEx("DeathMaestroAquaGuts")
    Goto Death.FlingDamage
    ///////////////////
    // Beam / scare deaths
    ///////////////////
   Death.YellowWizardPotion:
    "----" H 0 A_SpawnItemEx("GauntletFoodPickup", 0, 0, 0, 0, 0, 0, 0, 1)
    Goto Death.Beam+1
   Death.BalladeGB_Shot: Death.BalladeGB_Mine: Death.BalladeGB_UltimateExplode:
   Death.Springeye:
   Death.SharpRocket: Death.SharpRocketB: Death.MeteorItem: Death.UnholyBook: Death.ContrabandItem2:
    "----" H 0
    Goto Death.Beam
   Death.TrueMistressHell: Death.Hellbot: Death.ZankokunaHell: Death.SampiHell: Death.ASPHell: Death.MadAlphaHell: Death.MadAlphaHellX:
   Death.GiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 0, 5)
    Goto Death.Beam+1
   Death.WowieSpiderHell:
    "----" H 0 A_PlaySoundEx("classes/GUTSBUTT", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 24, 15)
    Goto Death.Beam+1
   Death.Thumbtack:
    "----" H 0
    Goto Death.Beam+1
   Death.YouWillDie: Death.SuperGiveUpHope:
    "----" H 0 A_PlaySoundEx("classes/POPUPSCARESOUND", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 1, 10)
    goto Death.Beam+1
   Death.Football:
    "----" H 0 A_PlaySoundEx("classes/FOOTBALLSCARE", "Body")
    "----" H 0 ACS_NamedExecuteAlways("uh_ScreenScare", 0, 2, 7)
    "----" H 0
    Goto Death.Beam+1
    ///////////////////
    // Disintegrate deaths
    ///////////////////
   Death.KickChamp_Dive:
    "----" H 0 A_SpawnItemEx("KickChamp_KickNukeFX", 0, 0, 0, 0, 0, 0, 0, 1)
    "----" H 0 A_FaceTarget
    "----" H 0 A_Recoil(45)
    Goto Death.Disintegrate
   Death.LuckyJudge9:
   Death.ShadowBoss_FinalSlice: Death.ShadowBoss_FinalSliceW: Death.ShadowmanSliceDice:
    Goto Death.Disintegrate
   Death.Torcal_DamageEX:
    "----" H 0 A_GiveToTarget("ConniverRetribution")
    Goto Death.Disintegrate
   Death.HellbotPoison:
    "----" H 0 A_SpawnItemEx("HellBotPoisonExplosion", 0, 0, 28)
    Goto Death.Disintegrate
   Death.ASPGhostX: Death.WishingStar:
    "----" H 0 A_GiveInventory("ExplodeDeathFlag", 1)
    Goto Death.Disintegrate
    ///////////////////
    // Crush / press deaths
    ///////////////////
   Death.Flatten:
    goto Death.MetalPress
   Death.JunkM_Cube: Death.JunkM_Shot: Death.JunkM_Punch: Death.JunkM_Shield: Death.JunkM_Shock:
    goto Death.DustCrusher
    ///////////////////
    // Massacre / banish deaths
    ///////////////////
   Death.MagicDevilEyeUpper: Death.MagicDevilEyeFling: Death.MagicDevilEyeHeave:
   Death.ShinBanish:
    "----" H 0
    goto Death.Massacre
    ///////////////////
    // Custom / base death flow
    ///////////////////
   Death.LuckyJudge2:
    "----" H 0 A_Stop
    Goto Death
   Death.LuckyJudge1:
   Death.WispStun:
    "----" H 0 A_SpawnItemEx("WispGraveCallingCard", 0, 0, 0, momx, momy, momz, 0, 9)
    goto Death
   Death.HardKnuckle: Death.ChargeKick: Death.BreakDash: Death.M_BreakDash:
   Death.NegaIceWallBeam: Death.NegaIceWallExplode: Death.NegaChillSpike: Death.LuxuryBall: Death.FreezeDry: Death.IceBeam: Death.IceShard:
   Death.LuckyIce: Death.LuckyJudge8: Death.ColdShot: Death.ColdMist: Death.ArcaneWater: Death.YeArcane: Death.SinisterStop:
   Death.FlameBurst: Death.BlazeKick: Death.FireBlast: Death.FireBlastE: Death.FlameWheel:
   Death.LuckyFire: Death.LuckyJudge6: Death.Igniter: Death.IgniterAlt: Death.ArcaneFire: Death.SluggerFire: Death.RamesesFire:
   Death.LuckyJudge7:
   Death.ShadowBossKunai: Death.ShadowBossPlatform: Death.ShadowBossOther: Death.ShadowBossBlind: Death.ShadowBossBlade:
   Death.ShadowBossBladeQR: Death.ShadowBossCaltrop: Death.ShadowBossSuplex: Death.ShadowBossRoot: Death.ShadowBossFling:
   Death.BossTimeStop:
   Death.JoterraTimeStop:
   Death.SueIce: Death.SovietCold: Death.SovietChill: Death.ShinNegaIce: Death.ElementalIce:
   Death.DevilFire: Death.Pharaoh4MI: Death.SovietIgnite: Death.ShinNegaFire: Death.ElementalFire: Death.TroutiusFire: Death.MagmaCannon: Death.RazingRay:
   Death.GBeastFire:
   Death.SampiFire:
   Death.ThomasTrainFire: Death.BlackDevilFire:
   Death.IronCurtainUpFling: Death.RussianGutsUpFling:
   Death.SadToadFling:
   Death.Dickster: Death.RedeadGutsRage: Death.AbePennyInsta: Death.AbePennyFling:
   Death.GutsBuddyHell: Death.RussianGutsHell: Death.RedeadGutsHell:
   Death.HardM_Flat:
   Death.StoneM_Leap:
   Death.WindM_Crush:
   Death.ODuo_Crush:
   Death.ConcreteM_Flat:
   Death.CommandoM_Crush:
   Death.Uranus_Flat: Death.Uranus_Stampede: Death.Neptune_Crush:
   Death.DustM_Shot: Death.DustM_Crush: Death.DustM_CrushBit:
   Death.Kamikazeeye:
   Death.MolotovCocktail: Death.MolotovCocktailB:
    goto Death
  }
}

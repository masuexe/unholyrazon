// Client-local ALLY marker above a displayed teammate.
//
// The engine draws its own ALLY floaty icon only for ENGINE teammates, which
// ordinary LMS does not use.  hud/tlms_display.acs spawns this actor on the
// client above each displayed teammate's head and keeps it there with ACS
// Warp.  The state mirrors the native FloatyIcon ALLY frame from
// zandronum.pk3, so the marker looks exactly like the TLMS icon.
actor UH_AllyMarker
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOINTERACTION
  +NOTIMEFREEZE
  +THRUACTORS
  +DONTSPLASH
  Height 8
  States
  {
  Spawn:
    ALLY A -1
    loop
  }
}

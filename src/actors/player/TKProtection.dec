
actor ProtectSurvivor : PowerupGiver
{
+COUNTITEM
+INVENTORY.AUTOACTIVATE
+INVENTORY.ALWAYSPICKUP
Inventory.MaxAmount 1
Powerup.Type "PowerProtectSurvivor"
States
{
Spawn:
6P1K JKL 2
Loop
}
}


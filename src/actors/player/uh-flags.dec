actor UH_PlayerProperty_P : CustomInventory {
  inventory.amount 1
  inventory.maxamount 1
  +AUTOACTIVATE
  States {
   Spawn:
    TNT1 A 1
    loop
   Pickup:
    TNT1 A 1  // A_ChangeFlag(,false+true)
    stop
  }
}



actor UH_PlayerProperty_F : Inventory {
  inventory.amount 1
  inventory.maxamount 99999
}

actor Spawn_HalfHitStunFlag : Once {}  // For morph demorph


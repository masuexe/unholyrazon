actor PlayerPropertyNoRadiusDmg : UH_PlayerProperty_F {}
actor PlayerPropertyCantPushWalls : UH_PlayerProperty_F {}
actor PlayerPropertyNoTeleport : UH_PlayerProperty_F {}
actor PlayerPropertyPickupDisable : UH_PlayerProperty_F {}

actor PlayerPropertyNoRadiusDmgOff : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0  // A_TakeInventory("UnhittableProtect")
    TNT1 A 0 A_ChangeFlag(NORADIUSDMG, false)
    stop
  }
}
actor UnhittableProtect : PowerProtection {
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -60
  // damagefactor "InsertRailGunHere", 0.0
}
actor PlayerPropertyNoRadiusDmgOn : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0  // A_GiveInventory("UnhittableProtect",1)
    TNT1 A 0 A_ChangeFlag(NORADIUSDMG, true)
    stop
  }
}

actor PlayerPropertyCantPushWallsOff : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(CANPUSHWALLS, true)
    stop
  }
}
actor PlayerPropertyCantPushWallsOn : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(CANPUSHWALLS, false)
    stop
  }
}

actor PlayerPropertyNoTeleportOff : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(NOTELEPORT, false)
    TNT1 A 0 A_ChangeFlag(NOTELEOTHER, false)
    stop
  }
}
actor PlayerPropertyNoTeleportOn : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(NOTELEPORT, true)
    TNT1 A 0 A_ChangeFlag(NOTELEOTHER, true)
    stop
  }
}

actor PlayerPropertyPickupDisableOff : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(PICKUP, true)
    stop
  }
}
actor PlayerPropertyPickupDisableOn : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 A_ChangeFlag(PICKUP, false)
    stop
  }
}

actor PlayerPropertyGroundedOn : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_groundplayer", 0, true)
    stop
  }
}
actor PlayerPropertyGroundedOff : UH_PlayerProperty_P {
  States {
   Pickup:
    TNT1 A 0 ACS_NamedExecuteWithResult("core_groundplayer", 0, false)
    stop
  }
}



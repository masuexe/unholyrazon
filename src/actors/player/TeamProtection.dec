actor PowerSuicideStartProtect : PowerProtection {
  Powerup.Duration -2
  damagefactor "Suicide", 0.0
}

actor PowerSuicideProtect : PowerSuicideStartProtect {
  Powerup.Duration 0x7ffffffd
}

actor PowerTelefragProtect : PowerProtection {
  Powerup.Duration 0x7ffffffd
  damagefactor "Telefrag", 0.01001  // 10009 damage
}


actor ProtectSurvivor : CustomInventory {
  +COUNTITEM
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 1
  States {
   Spawn:
    6P1K JKL 2
    loop
   Pickup:
    TNT1 A 0 A_GiveInventory("PowerProtectSurvivor")
    TNT1 A 0 ACS_NamedExecuteAlways("uh_ApplyCopywepTeamFF", 0)
    stop
  }
}


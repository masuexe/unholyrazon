actor ProtectUnholyItem : PowerupGiver {
  +COUNTITEM
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 1
  Powerup.Type "PowerProtectUnholyItem"
  States {
   Spawn:
    "I_$B" ABC 2
    loop
  }
}


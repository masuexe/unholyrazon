// Gondola automap sprites. Actors are created by client ACS only.
actor UH_AutomapMarker : MapMarker {
  Height 0
  Radius 0
  +CLIENTSIDEONLY
  +NOINTERACTION
  -SOLID
  States {
   Spawn:
    MP_I S -1
    Stop
   Survivor:
    MP_I S -1
    Stop
   Boss:
    MP_I B -1
    Stop
   Eye:
    MP_I E -1
    Stop
  }
}

actor UH_AutomapDirection : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 ] -1
    Stop
  }
}

actor UH_AutomapDeath : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 [ 175
    Stop
  }
}

// Short-lived pickup markers, refreshed locally while the box is available.
// Keep the v6c <pickup class>_MapMarker convention for a future base upgrade.
actor UH_BoxMapRunning_F : Inventory {
  Inventory.MaxAmount 1
}
actor UH_BoxMapClientRunning_F : UH_BoxMapRunning_F {}
actor UH_BoxMapAvailable_F : UH_BoxMapRunning_F {}

actor PandoraBoxItem_MapMarker : MapMarker {
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOTIMEFREEZE
  +DONTSPLASH
  States {
   Spawn:
    UHBI A 2
    Stop
  }
}

actor MysticBoxItem_MapMarker : PandoraBoxItem_MapMarker {
  States {
   Spawn:
    UHBI B 2
    Stop
  }
}

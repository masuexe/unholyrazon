// Gondola automap sprites. Actors are created by client ACS only.
actor UH_AutomapMarker : MapMarker {
  Height 0
  Radius 0
  +CLIENTSIDEONLY
  +NOINTERACTION
  -SOLID
  States {
   Spawn:
    MP_I S -1
    Stop
   Survivor:
    MP_I S -1
    Stop
   Boss:
    MP_I B -1
    Stop
   Eye:
    MP_I E -1
    Stop
  }
}

actor UH_AutomapDirection : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 ] -1
    Stop
  }
}

actor UH_AutomapDeath : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 [ 175
    Stop
  }
}

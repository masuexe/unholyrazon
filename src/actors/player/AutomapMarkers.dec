// Gondola automap sprites. Actors are created by client ACS only.
actor UH_AutomapMarker : MapMarker {
  Height 0
  Radius 0
  +CLIENTSIDEONLY
  +NOINTERACTION
  -SOLID
  States {
   Spawn:
    MP_I S -1
    Stop
   Survivor:
    MP_I S -1
    Stop
   Boss:
    MP_I B -1
    Stop
   Eye:
    MP_I E -1
    Stop
  }
}

actor UH_AutomapDirection : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 ] -1
    Stop
  }
}

actor UH_AutomapDeath : UH_AutomapMarker {
  States {
   Spawn:
    _MM1 [ 175
    Stop
  }
}

// Shared pickup marker base; generated subclasses provide centered item icons.
actor UH_ItemMapRunning_F : Inventory {
  Inventory.MaxAmount 1
}
actor UH_ItemMapClientRunning_F : UH_ItemMapRunning_F {}
actor UH_ItemMapAvailable_F : UH_ItemMapRunning_F {}

actor UH_ItemMapMarker : MapMarker {
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOTIMEFREEZE
  +DONTSPLASH
  States {
   Spawn:
    TNT1 A 2
    Stop
  }
}

#include "actors/items/AutomapMarkers.generated.dec"

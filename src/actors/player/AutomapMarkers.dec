// v6c player marker lifetime/flags, with Unholy S/B/E artwork.
actor UH_AutomapMarker : PlayerPawn_MapMarker {
  States {
   Spawn:
    MP_I S 2
    Stop
  }
}
actor UH_AutomapBoss : UH_AutomapMarker {
  States {
   Spawn:
    MP_I B 2
    Stop
  }
}
actor UH_AutomapEye : UH_AutomapMarker {
  States {
   Spawn:
    MP_I E 2
    Stop
  }
}

// Shared pickup marker base; generated subclasses provide centered item icons.
actor UH_ItemMapRunning_F : Inventory {
  Inventory.MaxAmount 1
}
actor UH_ItemMapClientRunning_F : UH_ItemMapRunning_F {}
actor UH_ItemMapAvailable_F : UH_ItemMapRunning_F {}

actor UH_ItemMapMarker : MapMarker {
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOTIMEFREEZE
  +DONTSPLASH
  States {
   Spawn:
    TNT1 A 2
    Stop
  }
}

#include "actors/items/AutomapMarkers.generated.dec"

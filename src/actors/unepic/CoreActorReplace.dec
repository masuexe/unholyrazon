
actor NoTeleportFX_Flag : PowerUp {
  powerup.duration 3
}

// A second damaging Time Stopper hit must not immediately apply a new freeze.
actor UH_TimeStopHitBreak_F : Once {}

// Own the single unfreeze operation; damage only removes TimeStoppedCounter.
// This avoids popping another core_freezeplayer claim twice after a hit break.
actor UH_TimeStoppedWatcher : BasicWatcher replaces TimeStoppedWatcher {
  States {
   Spawn:
    TNT1 A 0
   Watch:
    TNT1 A 1 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("TimeStopGFX", random(8, 64), 0, random(0, 64), 0, 0, 0, random(0, 359))
    TNT1 A 0 A_JumpIfInTargetInventory("TimeStoppedCounter", 1, "Watch")
    TNT1 A 0 A_GiveToTarget("TimeUnstopped")
    TNT1 A 0 A_TakeFromTarget("UH_TimeStopHitBreak_F", 1)
    stop
  }
}
actor TeleportFX_Flag6 : NoTeleportFX_Flag {}

actor UH_TeleportFogGiver : TeleportFogGiver replaces TeleportFogGiver {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_StopSound(4)
    TNT1 A 0 A_JumpIfInTargetInventory("NoTeleportFX_Flag", 1, "Death")
    TNT1 A 0 ACS_NamedExecuteWithResult("map_teleportfog")
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor UH_TeleportFogFX : TeleportFogFX replaces TeleportFogFX {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("JumpCancler", 1, "CheckDist")
    goto Destination
   Destination:
    TNT1 A 0 A_JumpIfInTargetInventory("TeleportFX_Flag6", 1, "Destination6")
    TNT1 A 0 A_SpawnItemEx("TeleportFogNormal", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Destination6:
    TNT1 A 0 A_SpawnItemEx("UH_TeleportFogNormal_6", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   CheckDist:
    TNT1 A 0 A_JumpIfCloser(128, "Destination")
    goto Teleport
   Teleport:
    TNT1 A 0 A_JumpIfInTargetInventory("TeleportFX_Flag6", 1, "Teleport6")
    TNT1 A 0 A_SpawnItemEx("TeleportFogFancy", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Teleport6:
    TNT1 A 0 A_SpawnItemEx("UH_TeleportFogFancy_6", 0, 0, 0, 0, 0, 0, 0, 1)
    stop
   Death:
    TNT1 A 0
    stop
  }
}

actor UH_TeleportFogNormal_6 : TeleportFogNormal {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1  // Thing_SetTranslation(0,CallACS("core_copytranslation"))
    TNT1 A 0 A_PlaySoundEx("misc/teleport66", "body")
    TFOG CBA 2
    stop
  }
}
actor UH_TeleportFogFancy_6 : TeleportFogFancy {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 1  // Thing_SetTranslation(0,CallACS("core_copytranslation"))
    TNT1 A 0 A_PlaySoundEx("misc/teleport66", "body")
    TFOG CB 3
    TFOG A 65 A_ChangeVelocity(0, 0, 13, 3)
    stop
  }
}



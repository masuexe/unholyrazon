// Health Zone

actor BasicHealthU : CustomInventory
{
+COUNTITEM
inventory.pickupmessage "Give me the Health."
Scale 2.0
States
{
Pickup:
TNT1 A 0 A_JumpIf(CallACS("uh_Health", UHEALTH_IS_FULL), "HealMe")
fail
HealMe:
TNT1 A 0 A_PlaySound("item/energyup",3,1.0)
stop
}
}

actor SmallHealthU : BasicHealthU replaces SmallHealth
{
inventory.pickupmessage "Picked up a Health Capsule. (100)"
States
{
Spawn:
HBAL AB 6
loop
HealMe:
TNT1 A 0 A_PlaySound("item/energyup",3,1.0)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 100)
stop
}
}


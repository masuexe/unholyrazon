actor MegaWeaponEnergyU_Small : MegaWeaponEnergyU {Scale 1.25}


actor PartyBallU : PartyBall replaces PartyBall
{
+NOGRAVITY
+SHOOTABLE
+NOTAUTOAIMED
+NOBLOOD
health 1
mass 999999
height 64
radius 32
scale 2.5

States
{
Spawn:
PRTB A 0
PRTB A 0 A_ChangeFlag("FLOATBOB", true)
PRTB A 0 A_GiveInventory("PartyBallSpawnFunc")
goto Spawn2
Spawn2:
PRTB AB 1
loop
Death:
PRTB C 0 A_PlaySoundEx("misc/partyball", "Auto")
PRTB C 0 A_ChangeFlag("NOGRAVITY", 1)
PRTB C 0 A_ChangeFlag("FLOATBOB", false)
PRTB C 0 A_SpawnItemEx("PartyBallRespawner")
PRTB C 1 ThrustThingZ(0, 20, 0, 0)
PRTB C 0 A_SpawnItemEx("ConfettiSpawner",0,0,48,random(-3,3),random(-3,3))
PRTB C 1 A_SpawnItemEx("RandomItemU",0,0,48,random(-3,3),random(-3,3))
PRTB CDCD 2
Explode:
PRTB C 0 A_Stop
PRTB CDCDCDCD 2
PRTB C 0 A_ChangeFlag("FLOATBOB", false)
PRTB C 0 A_PlaySoundEx("misc/mm3explosion", "Weapon")
TNT1 A 35 A_SpawnItemEx("ExplosionEffect2")
stop
End:
TNT1 A 0 
stop
}
}

actor RandomItemU : RandomItem replaces RandomItem {
  +NOINTERACTION
  +NOGRAVITY
  -SOLID
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(1, "LOL")
    TNT1 A 0 A_Jump(2, "Big")
    TNT1 A 0 A_Jump(64, "Eyes")
    TNT1 A 0 A_Jump(48, "Boxes")
    // TNT1 A 0 A_Jump(196, "Money")
    TNT1 A 0 A_Jump(224, "OtherItems")
    TNT1 A 1 A_Jump(256, "Pickups")
    stop
   LOL:
    TNT1 A 1 A_Jump(256, "RedBook", "Meteor")
    stop

   Pickups:
    TNT1 A 1 A_Jump(96, "BigHealth", "BigWeaponEnergy")
    TNT1 A 1 A_Jump(256, "SmallHealth", "WeaponEnergy")
    stop
    
   SmallHealth:
    TNT1 A 1 A_SpawnItemEx("SmallHealth")
    stop
   BigHealth:
    TNT1 A 1 A_SpawnItemEx("BigHealth")
    stop
   WeaponEnergy:
    TNT1 A 1 A_SpawnItemEx("WeaponEnergy")
    stop
   BigWeaponEnergy:
    TNT1 A 1 A_SpawnItemEx("BigWeaponEnergy")
    stop
   RedBook:
    TNT1 A 1 A_SpawnItemEx("UnholyBookToss")
    stop
   Meteor:
    TNT1 A 0 A_SpawnItemEx("AirStrikeSound",0,0,floorz+32)
    TNT1 A 0 A_Jump(13, "Majora")
    goto Meteor
   Meteor:
    TNT1 A 1 A_SpawnItemEx("AirStrikeTarget",0,0,floorz+32,0,0,0,0,32)
    stop
   Majora:
    TNT1 A 1 A_SpawnItemEx("AirStrikeTarget2",0,0,floorz+32,0,0,0,0,32)
    stop
   Big:
    TNT1 A 1 A_SpawnItemEx("GutsManGU")
    stop
  }
}

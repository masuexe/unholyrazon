actor BigHealthU_Wep : BigHealthU
{
inventory.pickupmessage "Picked up a Weapon Essence Capsule. (200)"
States
{
Spawn:
//WPHP ABCDEFGHIJK 1 A_SetTics(Mass)
//WPHP LMNOPQRSTUV 1 A_SetTics(Mass)
WPHP A 0
//WPHP A 0 A_Jump(256,"Spawn1","Spawn2","Spawn3","Spawn4","Spawn5","Spawn6")
goto Spawn3
Spawn1:
WPHP ABCDEFRSTUVLBCDEFGSTUVLMCDEFGHTUVLMNDEFGHIUVLMNOEFGHIJVLMNOPFGHIJKLMNOPQGHIJKAMNOPQRHIJKABNOPQRSIJKABCOPQRSTJKABCDPQRSTUKABCDEQRSTUV 1
loop
Spawn2:
WPHP ABCOPQGHIUVLBCDPQRHIJVLMCDEQRSIJKLMNDEFRSTJKAMNOEFGSTUKABNOPFGHTUV 2
loop
Spawn3:
WPHP ABNOEFRSIKVLBCOPFGSTJKLMCDPQGHTUKAMNDEQRHIUV 3
loop
Spawn4:
WPHP AABMNNDDEPQQGGHSTTJJKVLLBBCNOOEEFQRRHHITUUKKALMMCCDOPPFFGRSSIIJUVV 2
loop
Spawn5://Fun
WPHP AAAAABMMMMNNCCCDDDOOPPPPEFFFFFRRRRRSHHHHIITTTUUUJJKKKKV 1
WPHP LLLLLBBBBBCNNNNOODDDEEEPPQQQQFGGGGGSSSSSTIIIIJJUUUVVVKK 1
WPHP AAAALMMMMMCCCCCDOOOOPPEEEFFFQQRRRRGHHHHHTTTTTUJJJJKKVVV 1
WPHP LLLAABBBBMNNNNNDDDDDEPPPPQQFFFGGGRRSSSSHIIIIIUUUUUVKKKK 1
WPHP AALLLMMMBBCCCCNOOOOOEEEEEFQQQQRRGGGHHHSSTTTTIJJJJJVVVVV 1
WPHP LAAAABBMMMNNNCCDDDDOPPPPPFFFFFGRRRRSSHHHIIITTUUUUJKKKKK 1

WPHP LLLLLMBBBBCCNNNOOODDEEEEPQQQQQGGGGGHSSSSTTIIIJJJUUVVVVK 1
WPHP AAAAAMMMMMNCCCCDDOOOPPPEEFFFFQRRRRRHHHHHITTTTUUJJJKKKVV 1
WPHP LLLLABBBBBNNNNNODDDDEEPPPQQQFFGGGGRSSSSSIIIIIJUUUUVVKKK 1
WPHP AAALLMMMMBCCCCCOOOOOPEEEEFFQQQRRRGGHHHHSTTTTTJJJJJKVVVV 1
WPHP LLAAABBBMMNNNNCDDDDDPPPPPQFFFFGGRRRSSSHHIIIITUUUUUKKKKK 1
WPHP ALLLLMMBBBCCCNNOOOODEEEEEQQQQQRGGGGHHSSSTTTIIJJJJUVVVVV 1
loop
Spawn6:
WPHP AMCOEQGSIUKLBNDPFRHTJV 6
loop
}
}

// Health Zone

actor SmallHealthU : SmallHealth replaces SmallHealth {
  Inventory.PickupMessage "Picked up a Health Capsule. (100)"
  Inventory.PickupSound ""
  States {
   Pickup:
    TNT1 A 0 A_JumpIf(CallACS("core_CanGainHealth"), "Success")
    fail
   Success:
    TNT1 A 0 A_PlaySound("item/energyup", 3, 1.0)
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 100)
    stop
  }
}
actor SmallHealthU_Respawn : SmallHealth_Respawn {}
actor SmallHealthU_RespawnShadow : SmallHealth_RespawnShadow {}


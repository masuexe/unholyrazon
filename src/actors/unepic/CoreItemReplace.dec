actor PartyBallU : PartyBall replaces PartyBall {
  States {
   Spawn:
    PRTB A 0
    PRTB A 0 A_ChangeFlag("FLOATBOB", true)
    PRTB A 0 A_GiveInventory("PartyBallSpawnFunc")
    goto Spawn2
   Death:
    PRTB C 0 A_PlaySoundEx("misc/partyball", "Auto")
    PRTB C 0 A_ChangeFlag("NOGRAVITY", 1)
    PRTB C 0 A_ChangeFlag("FLOATBOB", false)
    PRTB C 0 A_SpawnItemEx("PartyBallRespawner")
    PRTB C 1 ThrustThingZ(0, 20, 0, 0)
    PRTB C 0 A_SpawnItemEx("ConfettiSpawner", 0, 0, 48, random(-3, 3), random(-3, 3))
    PRTB C 1 A_SpawnItemEx("RandomItemU", 0, 0, 48, random(-3, 3), random(-3, 3))
    PRTB CDCD 2
    goto Explode
  }
}

actor RandomItemU : RandomItem replaces RandomItem {
  +NOINTERACTION
  +NOGRAVITY
  -SOLID
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(1, "LOL")
    TNT1 A 0 A_Jump(2, "Big")
    TNT1 A 0 A_Jump(64, "Eyes")
    TNT1 A 0 A_Jump(48, "Boxes")
    // TNT1 A 0 A_Jump(196, "Money")
    TNT1 A 0 A_Jump(224, "OtherItems")
    TNT1 A 1 A_Jump(256, "Pickups")
    stop
   LOL:
    TNT1 A 1 A_Jump(256, "RedBook", "AirStrike")
    stop
   Big:
    TNT1 A 1 A_SpawnItemEx("GutsManGU")
    stop
   Eyes:
    TNT1 A 0 A_Jump(8, "SuperAwfulBoxDE")
    TNT1 A 0 A_Jump(24, "GoldenBoxDE", "GoldenKillerBoxDE")
    TNT1 A 0 A_Jump(64, "BoxDE", "KillerBoxDE", "AwfulBoxDE")
    TNT1 A 1 A_Jump(256, "RushCoilDE", "TornadoDE", "FlingingDE", "FlashingDE")
    stop
   Boxes:
    TNT1 A 0 A_Jump(160, "PandoraBox")
    TNT1 A 0 A_Jump(192, "MysticBox")
    TNT1 A 0 A_Jump(240, "TankOfWonders")
    // TNT1 A 1 A_SpawnItemEx("BoxDE_MinivileHidden_SurvivorBox")
    stop
   OtherItems:
    TNT1 A 0 A_Jump(16, "AssHat")
    TNT1 A 0 A_Jump(64, "ZakoBox")
    TNT1 A 0 A_Jump(128, "Traps")
    TNT1 A 0 A_Jump(192, "Money")
    TNT1 A 0 A_Jump(196, "Ztar")
    TNT1 A 0 A_Jump(256, "Coin")
    TNT1 A 1
    stop

   Pickups:
    TNT1 A 1 A_Jump(96, "BigHealth", "BigWeaponEnergy")
    TNT1 A 1 A_Jump(256, "SmallHealth", "WeaponEnergy")
    stop

   SmallHealth: TNT1 A 1 A_SpawnItemEx("SmallHealth") stop
   BigHealth: TNT1 A 1 A_SpawnItemEx("BigHealth") stop
   WeaponEnergy: TNT1 A 1 A_SpawnItemEx("WeaponEnergy") stop
   BigWeaponEnergy: TNT1 A 1 A_SpawnItemEx("BigWeaponEnergy") stop

   PandoraBox: TNT1 A 1 A_SpawnItemEx("PandoraBoxItem") stop
   MysticBox: TNT1 A 1 A_SpawnItemEx("MysticBoxItem") stop
   TankOfWonders: TNT1 A 1 A_SpawnItemEx("TankOfWondersItem") stop

   RushCoilDE: TNT1 A 1 A_SpawnItemEx("RushCoilDE") stop
   KillerBoxDE: TNT1 A 1 A_SpawnItemEx("KillerBoxDE") stop
   BoxDE: TNT1 A 1 A_SpawnItemEx("FriendlyBoxDE") stop
   FlingingDE: TNT1 A 1 A_SpawnItemEx("FlingingDE") stop
   AwfulBoxDE: TNT1 A 1 A_SpawnItemEx("AwfulBoxDE") stop
   SuperAwfulBoxDE: TNT1 A 1 A_SpawnItemEx("SuperAwfulBoxDE") stop
   TornadoDE: TNT1 A 1 A_SpawnItemEx("TornadoDE") stop
   FlashingDE: TNT1 A 1 A_SpawnItemEx("FlashingDE") stop
   GoldenKillerBoxDE: TNT1 A 1 A_SpawnItemEx("GoldenKillerBoxDE") stop
   GoldenFriendlyBoxDE: TNT1 A 1 A_SpawnItemEx("GoldenFriendlyBoxDE") stop

   AssHat:
    TNT1 A 0 A_Jump(256, 1, 2)
    TNT1 A 1 A_SpawnItemEx("AssHatItemX")
    stop
    TNT1 A 1 A_SpawnItemEx("DickHatItemX")
    stop

   Money:
    TNT1 A 0 A_Jump(32, "MoneyBomb")
    TNT1 A 1 A_Jump(256, "MoneyBait")
    stop
   MoneyBait: TNT1 A 1 A_SpawnItemEx("MoneyBaitShot") stop
   MoneyBomb: TNT1 A 1 A_SpawnItemEx("MoneyBomb") stop

   Coin: TNT1 A 1 A_SpawnItemEx("DLC_CoinSpawner_H") stop
   DLCGoldCoin: TNT1 A 1 A_SpawnItemEx("DLCGoldCoin") stop
   DLCRedCoin: TNT1 A 1 A_SpawnItemEx("DLCRedCoin") stop
   DLCGreenCoin: TNT1 A 1 A_SpawnItemEx("DLCGreenCoin") stop
   DLCBlueCoin: TNT1 A 1 A_SpawnItemEx("DLCBlueCoin") stop

   Ztar:
    TNT1 A 1 A_SpawnItemEx("ZtarmanItemToss")
    stop

   ZakoBox:
    TNT1 A 1 A_SpawnItemEx("ZakoBox")
    stop

   RedBook:
    TNT1 A 1 A_SpawnItemEx("UnholyBookToss")
    stop
   AirStrike:
    TNT1 A 0 A_SpawnItemEx("AirStrikeSound", 0, 0, floorz + 32)
    TNT1 A 0 A_Jump(13, "Majora")
    goto Meteor
   Meteor:
    TNT1 A 1 A_SpawnItemEx("AirStrikeTarget", 0, 0, floorz + 32, 0, 0, 0, 0, 32)
    stop
   Majora:
    TNT1 A 1 A_SpawnItemEx("AirStrikeTarget2", 0, 0, floorz + 32, 0, 0, 0, 0, 32)
    stop

   Traps:
    TNT1 A 0 A_Jump(128, "Lego")
    TNT1 A 0 A_Jump(192, "Spike")
    TNT1 A 1 A_Jump(256, "Thumbtack")
    stop
   Lego: TNT1 A 1 A_GiveInventory("BrickMineRNG_P") stop
   Spike: TNT1 A 1 A_GiveInventory("PitSpikeRNG_P") stop
   Thumbtack: TNT1 A 1 A_GiveInventory("ThumbtackRNG_P") stop
  }
}

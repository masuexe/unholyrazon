actor WeaponEnergyU : BasicHealthU replaces WeaponEnergy
{
inventory.pickupmessage "Picked up a Small Energy Capsule. (25)"
States
{
Spawn:
EBAL A 0
EBAL A 0 Thing_ChangeTID(0,999)
EBAL AB 6
Goto Spawn+2
HealMe:
TNT1 A 0 A_PlaySound("item/energyup",3,1.0)
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 25)
stop
}
}

actor BigWeaponEnergyU : BasicHealthU replaces BigWeaponEnergy

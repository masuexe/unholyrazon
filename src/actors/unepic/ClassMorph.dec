// Morph reset pickups — patterned on classes-v9gh BearerClass.txt
// Pipeline: UH_MorphFlagReset + Core_MorphFlagReset* (pre)
//           → MorphActor
//           → UH_MorphPowerPropReset → Delay(1) → UH_FixMorphPower (post, via ACS)

actor UH_MorphPowerPropReset_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("UH_DisableJumpPower")
TNT1 A 0 A_TakeInventory("UH_FlipJumpPower")
TNT1 A 0 A_TakeInventory("UH_Ratio5_6JumpPower")
TNT1 A 0 A_TakeInventory("UH_Ratio8JumpPower")
TNT1 A 0 A_TakeInventory("UH_Ratio7JumpPower")
TNT1 A 0 A_TakeInventory("UH_Ratio1JumpPower")
TNT1 A 0 A_TakeInventory("UH_150_JumpPower")
/*
//Do not remove these — core slows must survive morph (Bearer/Classes stance)
TNT1 A 0 A_TakeInventory("Core_PowerSlow")
TNT1 A 0 A_TakeInventory("Core_ShockedStop")
*/
TNT1 A 0 A_TakeInventory("UH_DisableSpeedPower")
TNT1 A 0 A_TakeInventory("UH_BotFlipSpeedPower")
TNT1 A 0 A_TakeInventory("UH_120_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_125_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_130_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_140_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_165_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_175_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_185_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_200_SpeedPower")
TNT1 A 0 A_TakeInventory("UH_250_SpeedPower")

TNT1 A 0 A_TakeInventory("HellbotInvisAlpha")
TNT1 A 0 A_TakeInventory("GhostEyeInvis")
TNT1 A 0 A_TakeInventory("GhostEyeShadowInvis")

TNT1 A 0 A_TakeInventory("UH_00_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_10_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_20_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_30_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_40_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_50_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_60_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_70_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_80_AlphaPower")
TNT1 A 0 A_TakeInventory("UH_90_AlphaPower")

TNT1 A 0 A_TakeInventory("GravitymanFlipAirZPower")
TNT1 A 0 A_TakeInventory("GravitymanFlipWallZPower")
TNT1 A 0 A_TakeInventory("GravitymanFlipGravPower")
TNT1 A 0 A_TakeInventory("ReverseGravityFlag")
TNT1 A 0 A_TakeInventory("ReverseGravityCountdownFlag")
TNT1 A 0 A_TakeInventory("CeilingFlag")
TNT1 A 0 A_TakeInventory("GroundFlag")
TNT1 A 0 A_TakeInventory("OnCeilingFlag")
TNT1 A 0 A_TakeInventory("GravitySwitch")
TNT1 A 0 A_TakeInventory("GravitySwitchX")
TNT1 A 0 A_TakeInventory("GravityCooldownFlag")
TNT1 A 0 A_TakeInventory("GravSlammerPower")
stop
}
}

actor UH_UnMorphSuperFlagReset_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 SetPlayerProperty(0,0,PROP_BUDDHA)
TNT1 A 0 SetPlayerProperty(0,0,PROP_NOTARGET)
TNT1 A 0 A_ChangeFlag(CANPUSHWALLS,true)
TNT1 A 0 A_ChangeFlag(DONTRIP,false)
TNT1 A 0 A_ChangeFlag(NORADIUSDMG,false)
TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,false)
TNT1 A 0 A_ChangeFlag(CANTSEEK,false)
TNT1 A 0 A_ChangeFlag(INVISIBLE,false)
TNT1 A 0 A_ChangeFlag(DONTIDENTIFYTARGET,false)
TNT1 A 0 A_ChangeFlag(THRUSPECIES,false)
TNT1 A 0 A_ChangeFlag(SOLID,true)
TNT1 A 0 A_ChangeFlag(NOGRAVITY,false)
stop
}
}

actor UH_FixMorphPower_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("FixMorphJumpZ_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphGravity_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphAlpha_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphSpeed_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphScaleX_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphScaleY_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphFriction_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphAirJumpZ_Giv",1)
TNT1 A 0 A_GiveInventory("FixMorphWallJumpZ_Giv",1)
stop
}
}

actor UH_ResetMorphPower_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_TakeInventory("FixMorphJumpZ_Pow")
TNT1 A 0 A_TakeInventory("FixMorphGravity_Pow")
TNT1 A 0 A_TakeInventory("FixMorphAlpha_Pow")
TNT1 A 0 A_TakeInventory("FixMorphSpeed_Pow")
TNT1 A 0 A_TakeInventory("FixMorphScaleX_Pow")
TNT1 A 0 A_TakeInventory("FixMorphScaleY_Pow")
TNT1 A 0 A_TakeInventory("FixMorphFriction_Pow")
TNT1 A 0 A_TakeInventory("FixMorphAirJumpZ_Pow")
TNT1 A 0 A_TakeInventory("FixMorphWallJumpZ_Pow")
stop
}
}

actor UH_MorphPipelineDone_F : UOnce {}

// Pre-morph UH inventory / flag sweep (not full CBM class list)
actor UH_MorphFlagReset_P : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_GiveInventory("UH_BaseFlagPack")
TNT1 A 0 A_TakeInventory("UH_MorphPipelineDone_F")

TNT1 A 0 A_TakeInventory("PressButton_Main_F")
TNT1 A 0 A_TakeInventory("PressButton_Alt_F")
TNT1 A 0 A_TakeInventory("PressButton_Jump_F")

TNT1 A 0 A_TakeInventory("VivifyFlag1")
TNT1 A 0 A_TakeInventory("VivifyFlag2")
TNT1 A 0 A_TakeInventory("VivifyFlag3")

TNT1 A 0 A_TakeInventory("VivifyCycle1")
TNT1 A 0 A_TakeInventory("VivifyCycle2")
TNT1 A 0 A_TakeInventory("VivifyCycle3")
TNT1 A 0 A_TakeInventory("VivifyCycle4")
TNT1 A 0 A_TakeInventory("VivifyCycle5")
TNT1 A 0 A_TakeInventory("VivifyCycle6")

TNT1 A 0 A_TakeInventory("BotFlag1")
TNT1 A 0 A_TakeInventory("BotFlag2")
TNT1 A 0 A_TakeInventory("BotFlag3")

TNT1 A 0 A_ChangeFlag("FLOORHUGGER",0)

TNT1 A 0 A_TakeInventory("BasicArmor")
TNT1 A 0 A_TakeInventory("DynamicArmorDosage")
TNT1 A 0 A_TakeInventory("SpawningMisfire")
TNT1 A 0 A_TakeInventory("GuardUpFlag")
TNT1 A 0 A_TakeInventory("GuardDownFlag")
TNT1 A 0 A_TakeInventory("CutterFlag")
TNT1 A 0 A_TakeInventory("SlideVivifyFlag")

TNT1 A 0 A_GiveInventory("StopShield")
TNT1 A 0 A_TakeInventory("ShieldCheck")
TNT1 A 0 A_TakeInventory("WeaponCharge")
TNT1 A 0 A_GiveInventory("RaiderHookRelease_F",1)
stop
}
}


//General Base actors for inheriting or use

// Prototype actors that ignore class translations. Use for item projectiles
actor ProjSpawnFuncNoClassTranslationActor {
  +USESPAWNEVENTSCRIPT
  var int user_UseProjSpawnFunc;
  var int user_NoClassTranslation;
}
actor ProjSpawnFuncNoClassTranslationActorFast : FastProjectile {
  +USESPAWNEVENTSCRIPT
  var int user_UseProjSpawnFunc;
  var int user_NoClassTranslation;
}

actor BasicNoClassTranslationProjectile : BasicProjectile {
  var int user_NoClassTranslation;
  Obituary "%o told %k they forgot the obituary. (BasicNoClassTranslationProjectile)"
}
actor BasicNoClassTranslationFastProjectile : BasicFastProjectile {
  var int user_NoClassTranslation;
  Obituary "%o told %k they forgot the obituary. (BasicNoClassTranslationFastProjectile)"
}

actor BasicNoClassTranslationGraphicEffect : BasicGraphicEffect {
  var int user_NoClassTranslation;
}

actor BasicNoClassTranslationExplosion : BasicExplosion {
  var int user_NoClassTranslation;
  Obituary "%o told %k they forgot the obituary. (BasicNoClassTranslationExplosion)"
}

actor BasicMorphProjectile : MorphProjectile
{
    MorphProjectile.MorphFlash ""
    MorphProjectile.UnMorphFlash ""
    MorphProjectile.PlayerClass ""
    MorphProjectile.Duration 0x7FFFFFFC
    MorphProjectile.MorphStyle MRF_ADDSTAMINA|MRF_FULLHEALTH|MRF_LOSEACTUALWEAPON|MRF_NEWTIDBEHAVIOUR
    +USESPAWNEVENTSCRIPT
    var int user_UseProjSpawnFunc;
    damagetype "Buster"
    Obituary "%o told %k they forgot the obituary. (BasicMorphProjectile)"
    Speed 27
    Damage (114514)
    radius 5
    height 5
    scale 2.5
    States
    {
        Spawn:
            BUST A 1
            wait
    }
}

actor BasicImplosion
{//Easy way of managing every explosion such as topspin
//+USESPAWNEVENTSCRIPT
//var int user_UseProjSpawnFunc;
Obituary "%o told %k they forgot the obituary. (BasicImplosion)"
DamageType "Normal"
+MISSILE
+NOBLOCKMAP
+NOTELEPORT
-SOLID
+NOCLIP
+DONTBLAST
+NOGRAVITY
//+RIPPER
+SKYEXPLODE
+NOINTERACTION
+DONTSPLASH
+THRUGHOST
+THRUACTORS
+DONTREFLECT
Damage 0
radius 2
height 2
//Scale 2.5
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(5000,32,0)
stop
Death:
TNT1 A 1
stop
}
}

actor BasicClientSide
{//Works well for actors spawned from projectiles
+CLIENTSIDEONLY
+NOBLOCKMAP
+NOINTERACTION
+NOGRAVITY
-SOLID
radius 2
height 2
scale 2.5
}

// Force-register sprites used only by VOXELDEF (GetSpriteIndex add=false).
actor UH_VoxelSpriteFix_FX : BasicClientSide
{
States
{
Spawn:
Y_BD L 0
Y_9A GH 0
I_CI ABC 0
stop
}
}

actor BasicGraphicEffectM : BasicGraphicEffect
{
+DONTREFLECT
+DONTSPLASH
-NOINTERACTION
+NOBLOCKMAP
+PAINLESS
Damage (0)
}

actor BasicExplosion_Args : BasicExplosion
{
Obituary "%o told %k they are OP and should be nerfed. (BasicExplosion_Args)"
Args 5000,128,32
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(Args[0],Args[1],0,0,Args[2])
stop
}
}

actor BasicExplosion_Args_Trio : BasicExplosion
{
Obituary "%o told %k they are OP and should be nerfed. (BasicExplosion_Args_Trio)"
Args 5000,128,32
States
{
Spawn:
TNT1 A 0
TNT1 A 1 A_Explode(Args[0]*(1+CallACS("uh_checkrune", RUNE_SPREAD, 2)*2),Args[1],0,0,Args[2])
stop
}
}

//Used for Warpers
actor ShieldWarper_UH : BasicShieldWarper {
  +THRUACTORS
  +DONTREFLECT
  Height 2
  Radius 2
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("MM8BDMProjSpawnFuncClient")
    TNT1 A 0 ACS_NamedExecuteAlways("uc_clientwarper", 0, 1)
    TNT1 A 0 A_Jump(256, "Shield")
    Goto Shield
   Shield:
    STAR AABBCCDD 1 A_Warp(AAPTR_TARGET, 0, 0, 16, 0, WARPF_INTERPOLATE|WARPF_NOCHECKPOSITION)
    loop
  }
}

actor BasicItemPickup : CustomInventory
{
+INVBAR
+COUNTITEM
Inventory.amount 1
Inventory.maxamount 1
Inventory.icon "NULLICON"
Inventory.PickupSound "item/1up"
Tag "No Tag Defined"
Scale 2.0
}

actor BasicClassItem : CustomInventory
{
Inventory.Amount 1
Inventory.Maxamount 1
inventory.icon "SAXTJU"
inventory.pickupmessage "Try to find all the hidden messages!"
Inventory.PickupSound "GNT/Treasure"
+INVBAR
//+COUNTITEM
Tag "You forgot the Tag"
Scale 2.0
States
{
Spawn:
TNT1 A 1
loop
Use:
TNT1 A 0
fail
Give:
TNT1 A 0 A_GiveInventory("ItemUseFlag",1)
fail
Yes:
TNT1 A 0
stop
No:
TNT1 A 0
fail
}
}


actor Basic_FloorQuakeSpawn : BasicExplosion
{
Obituary "%k gave %o a \chHARD\c- time. (Basic_FloorQuakeSpawn)"
damagetype "Normal"
+NOCLIP
+NOTIMEFREEZE
+SERVERSIDEONLY
Renderstyle None
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetArg(0,angle*256/360)
TNT1 A 0 A_SetArg(1,1+CallACS("core_checkrune",RUNE_SPREAD,2)*2)
TNT1 A 0 Thing_Move(0,1000+momz*8,1)
TNT1 A 1 A_JumpIf(1,"Quake")
Quake:
TNT1 A 4 A_SpawnItemEx("Basic_FloorQuakeBoom",0,0,28,0,0,0,0,1+SXF_TRANSFERSPECIAL)//32768
stop
}
}

actor Basic_FloorQuakeBoom : BasicExplosion
{
Obituary "%k gave %o a \chHARD\c- time. (Basic_FloorQuakeBoom)"
damagetype "Normal"
+NOTIMEFREEZE
Renderstyle None
MeleeRange 10
Accuracy 10
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_Explode((Accuracy+Args[0]*MeleeRange)*Args[1],15,0,0,15)
FX:
TNT1 A 0 A_FaceTarget
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),-28,0,0,0,30,1)
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),-28,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),-28,0,0,0,-30,1)
TNT1 A 4
stop
}
}

actor Basic_FloorQuakeFX_H : BasicExplosion
{
//var int user_TranslateWhiteColors;
//ActiveSound "misc_L/hugequake2"
+NOTIMEFREEZE
RenderStyle None
//[4] >> Rings of FX / 10 (EX: 33 is 3 rings)
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetArg(4,momz*100.0+0.5)
//TNT1 A 0 Radius_Quake(2,10,0,1+Args[4]/10,0)
TNT1 A 0 A_ActiveSound
TNT1 A 10 A_SpawnItemEx("Basic_FloorQuakeFX",0,0,-momz,0,0,0,0,1+SXF_TRANSFERSPECIAL)
stop
}
}
//Edit as class needs
actor Basic_FloorQuakeFX : BasicGraphicEffect
{
-MISSILE//From Unholy Classes Handyman
Renderstyle None
Accuracy 0//Base starting distance
Mass 100//Distance added per wave
MeleeRange 7//Applied to Args[2]
//[0] Max size (Main A_CountDownArg)
//[1] Reverse of [0] (Counts up)
//[2] Bits added per wave
//[3] Bits spawned per circle
//[4] Is [3] but +1 for spawn angle
Args 0
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetArg(0,Args[4]/10)
//TNT1 A 0 A_SetArg(1,0)
TNT1 A 0 A_SetArg(2,MeleeRange)
goto SpawnCycle+2
SpawnL:
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",Accuracy+Mass*Args[1],0,0,0,0,3,Args[3]*360.0f/Args[4],1)
TNT1 A 0 A_CountDownArg(3,"SpawnCycle")
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",Accuracy+Mass*Args[1],0,0,0,0,3,Args[3]*360.0f/Args[4],0)
TNT1 A 0 A_CountDownArg(3,"SpawnCycle")
loop
SpawnCycle:
TNT1 A 1 A_CountDownArg(0)
TNT1 A 0 A_SetAngle(angle+random(Args[2],Args[2]*2))

TNT1 A 0 A_SetArg(1,Args[1]+1)
TNT1 A 0 A_SetArg(4,Args[2]*Args[1])
TNT1 A 0 A_SetArg(3,Args[4]-1)
TNT1 A 0 A_Jump(256,"SpawnL")
goto SpawnL
Death:
TNT1 A 1
stop
}
}

actor BasicHardQuake
{
// +USESPAWNEVENTSCRIPT
// var int user_UseProjSpawnFunc;
damagetype "Normal"
Obituary "%k gave %o a \chHARD\c- time. (BasicHardQuake)"
+NOGRAVITY
+DONTBLAST
+DONTREFLECT
//+MISSILE
+SKYEXPLODE
+NOINTERACTION
+NOCLIP
+RIPPER
+THRUACTORS
+THRUGHOST
-SOLID
damage (75)
radius 256
height 2
States
{
Spawn:
TNT1 A 0
TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BasicHardQuakeFX",random(-256,256),random(-256,256),0,0,0,0,0,5)
goto Spawn2
Spawn2:
TNT1 A 0 A_PlaySoundEX("misc_L/hugequake2","Weapon")
TNT1 A 0 A_ChangeFlag("NOCLIP",0)
TNT1 A 0 A_ChangeFlag("NOINTERACTION",0)
TNT1 A 0 A_ChangeFlag("THRUACTORS",0)
TNT1 A 0 A_ChangeFlag("MISSILE",1)
TNT1 A 1
stop
}
}

actor BasicHardQuakeFX_H : BasicGraphicEffect
{
var int user_A;
var int user_Dist;
reactiontime 1
Renderstyle None
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_SetUserVar("user_A",random(0,5))
TNT1 A 0 A_SetUserVar("user_Dist",Args[1])
TNT1 A 0 A_SetArg(4,Args[0])
TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BasicHardQuakeFX",10*random(1,user_Dist),0,0,0,0,0,5*random(0,71)+user_A,1)
goto Spawn2
Spawn2:
TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BasicHardQuakeFX",10*random(1,user_Dist),0,0,0,0,0,5*random(0,71)+user_A,1)
TNT1 A 0 A_CountdownArg(4,"End")
loop
End:
TNT1 A 1 A_Countdown
wait

Death:
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),0,0,0,0,30,1)
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),0,0,0,0,0,1)
TNT1 A 0 A_SpawnItemEx("BasicHardQuakeFX",random(10,30),random(-20,20),0,0,0,0,-30,1)
TNT1 A 1
stop
}
}
actor BasicHardQuakeFX : BasicGraphicEffect
{
States
{
SpawnFrame:
SMFX XYZ 3
stop
}
}


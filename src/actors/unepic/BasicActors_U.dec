actor BasicSoundFollowDisable : Powerup
{
Powerup.Duration 6
}

actor BasicSoundFollow : BasicWatcher
{
PainSound "classes/LuckyFly"
ReactionTime 100
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT,AAPTR_DEFAULT,AAPTR_TARGET)
TNT1 A 0 A_Pain
goto Spawn2
Spawn2:
TNT1 A 1 A_Fire
TNT1 A 0 A_JumpIfInTargetInventory("BasicSoundFollowDisable",1,"Stopper")
TNT1 A 0 A_JumpIf(!CallACS("uh_PointerExists", 2), "Stopper")
TNT1 A 0 A_CountDown
loop
Stopper:
TNT1 A 0
TNT1 AA 1 A_StopSound(2)//A_PlaySoundEx("misc/NoSnd","")
TNT1 A 1
stop
}
}

actor BasicGroupHealPickup : CustomInventory
{
States
{
Pickup:
TNT1 A 0 A_JumpIf(!CallACS("uh_Health", UHEALTH_IS_FULL), "HealMe")
stop
HealMe:
TNT1 A 0 ACS_NamedExecuteWithResult("uh_Health", UHEALTH_HEAL, 1)
stop
}
}

actor BasicBoss_Rooted : BasicWatcher {
  reactiontime 80  // 45
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIf(!CallACS("uh_PointerIsABoss", 2), "Death")
    TNT1 A 1 A_GiveToTarget("BasicBoss_Rooted_P")
    TNT1 A 0 A_CountDown
    loop
  }
}


// ============================================================================
// CoreDamageReplace.dec — MM8BDM Core Damage 10x Global Scaler
//
// Scales vanilla MM8BDM projectiles and damagers to 10x baseline for Unholy's
// 1000 HP environment (matching CBM's BeefUpCoreDam pattern).
//
// RULES:
// 1. MUST use `replaces <VanillaActor>`.
// 2. MUST use hardcoded 10x damage constants.
// 3. STRICTLY PROHIBITED from calling `uh_TodayDmgMul` (damage must remain stable
//    and date-independent for map hazards and generic entities).
// ============================================================================

// --- MM10: Commando Bomb ---
actor Core_CommandoBomb : CommandoBomb replaces CommandoBomb {
  Damage (250)
}

actor Core_CommandoBombSecondary : CommandoBombSecondary replaces CommandoBombSecondary {
  Damage (250)
}

actor Core_CommandoBombDamagerA : CommandoBombDamagerA replaces CommandoBombDamagerA {
  Damage (120)
}

actor Core_CommandoBombDamagerB : Core_CommandoBombDamagerA replaces CommandoBombDamagerB {
  Height 40
}

actor Core_CommandoBombDamagerC : Core_CommandoBombDamagerA replaces CommandoBombDamagerC {
  Height 75
}

actor Core_CommandoBombDamagerD : Core_CommandoBombDamagerA replaces CommandoBombDamagerD {
  Height 112
}

actor Core_CommandoBombDamagerX : Core_CommandoBombDamagerA replaces CommandoBombDamagerX {
  Damage (60)
}

actor Core_CommandoBombDamagerY : Core_CommandoBombDamagerB replaces CommandoBombDamagerY {
  Damage (60)
}

actor Core_CommandoBombDamagerZ : Core_CommandoBombDamagerC replaces CommandoBombDamagerZ {
  Damage (60)
}

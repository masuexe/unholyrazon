// This is used to limit classes to one instance of turning flight on/off
// Mainly for classes with dynamic flight, such as Bubbleman or Astroman
actor UH_AviationOn_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UH_AviationActive", 1, 2)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_flyplayer", 0, 2)
    TNT1 A 0 A_GiveInventory("UH_AviationActive")
    stop
  }
}
actor UH_AviationOff_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("UH_AviationActive", 1, 1)
    stop
    TNT1 A 0 ACS_NamedExecuteWithResult("core_flyplayer", 0, 0)
    TNT1 A 0 A_TakeInventory("UH_AviationActive")
    stop
  }
}


// UR3 GravitySwitchItem cooldown (~54 ticks @ 2-tic drain ≈ 3s)
actor GravityCooldownFlag : Inventory {
  Inventory.Amount 1
  Inventory.MaxAmount 56
}

actor GravitySwitchCooldown_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
   SpawnLoop:
    TNT1 A 2 A_TakeFromTarget("GravityCooldownFlag", 1)
    TNT1 A 0 A_JumpIfInTargetInventory("GravityCooldownFlag", 1, "SpawnLoop")
    stop
  }
}


    TNT1 A 0 A_TakeInventory("OnCeilingFlag")
    TNT1 A 0 A_TakeInventory("CeilingFlag")
    TNT1 A 0 A_TakeInventory("JumpCancler")
    stop
  }
}

actor ReverseMyGravity_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
   SpawnLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsPlayerAlive", CallACS("core_getptrtid", 2)), "Death")
    TNT1 A 0 A_JumpIfInTargetInventory("CeilingFlag", 1, 1)
    goto Death
    TNT1 A 1 A_GiveToTarget("ReverseGravityThrust")
    goto SpawnLoop
   Death:
    TNT1 A 0
    stop
  }
}


actor ShadowPreRoundStart : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_Stop
    // TNT1 A 0 A_GiveInventory("NotShadowmanBossWeapon",1)IsAFakeBoss
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEON)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, true)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_buddhaplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_freezeplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_stopplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, true)
    TNT1 A 0 A_SetTranslucent(0.0, 0)
    TNT1 A 0 ThrustThingZ(0, 120, 0, 0)
    TNT1 A 0 A_GiveInventory("IsAFakeBoss")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, true)
    TNT1 A 0 A_GiveInventory("BasicSoundFollowDisable")
    TNT1 A 0 A_TakeInventory("UnholyPowerDisableRazzle_F")
    TNT1 A 0 A_TakeInventory("UnholyPowerLimit_F")
    TNT1 A 0 A_TakeInventory("IsGonnaBeFake")
    TNT1 A 0 A_GiveInventory("JuggerGoldFlag")
    stop
  }
}

actor NotShadowmanBossWeapon : MegaBuster {
  weapon.ammotype "AcidTripAmmo"
  +CHEATNOTWEAPON
  States {
   Ready:
    TNT1 A 1 A_WeaponReady
    Goto Ready
   Fire:
   Altfire:
    TNT1 A 1
    goto Ready
  }
}

actor AcidTripAmmo : Ammo {
  Inventory.MaxAmount 3
  +INVENTORY.IGNORESKILL
}

actor ShadowPreRoundEnd : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_TakeInventory("IsAFakeBoss")
    TNT1 A 0 ACS_NamedExecuteWithResult("uh_cantuseitemsplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_unsolidplayer", 0, USP_TOGGLEOFF_DAMAGE, CallACS("core_getmaxhealth")/10)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invulnerableplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_nogravityplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_flyplayer", 0, false)
    TNT1 A 0 ACS_NamedExecuteWithResult("core_invisibleplayer", 0, false)
    TNT1 A 0 A_SetTranslucent(1.0, 0)
    stop
  }
}


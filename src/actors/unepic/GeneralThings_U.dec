}

actor GravityFlashSwitchUp_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/upsidedown", "Body")
    // A_SetGravity is required: core/water scripts overwrite APROP_Gravity;
    // PowerAprop alone does not re-assert each tic (see ReverseGravityThrust).
    TNT1 A 0 A_SetGravity(-0.8)
    TNT1 A 0 A_GiveInventory("GravitymanFlipGravPowerGiver", 1)
    TNT1 A 0 A_GiveInventory("GravitymanFlipAirZPowerGiver", 1)
    TNT1 A 0 A_GiveInventory("GravitymanFlipWallZPowerGiver", 1)
    TNT1 A 0 A_GiveInventory("UH_FlipJumpPowerGiver", 1)
    TNT1 A 0 A_GiveInventory("CeilingFlag")
    TNT1 A 0 A_TakeInventory("GravitySwitch")
    TNT1 A 0 A_TakeInventory("GroundFlag")
    TNT1 A 0 A_TakeInventory("JumpCancler")
    TNT1 A 0 A_TakeInventory("VivifyDelay5")
    stop
  }
}

actor GravityFlashSwitchDown_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapon/upsidedown", "Body")
    TNT1 A 0 A_SetGravity(0.8)
    TNT1 A 0 A_TakeInventory("GravitymanFlipGravPower")
    TNT1 A 0 A_TakeInventory("GravitymanFlipAirZPower")
    TNT1 A 0 A_TakeInventory("GravitymanFlipWallZPower")
    TNT1 A 0 A_TakeInventory("UH_FlipJumpPower")
    TNT1 A 0 A_GiveInventory("GroundFlag")
    TNT1 A 0 A_GiveInventory("VivifyDelay5")
    TNT1 A 0 A_GiveInventory("GravitySwitchX")
    TNT1 A 0 A_TakeInventory("GravitySwitch")
    TNT1 A 0 A_TakeInventory("OnCeilingFlag")
    TNT1 A 0 A_TakeInventory("CeilingFlag")
    TNT1 A 0 A_TakeInventory("JumpCancler")
    stop
  }
}

// Shared reverse-grav tick: re-assert negative gravity + lift (UR3)
actor ReverseGravityThrust : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("GroundFlag", 1, "No")
    TNT1 A 0 A_SetGravity(-0.8)
    TNT1 A 0 A_ChangeVelocity(0, 0, 0.8)
    TNT1 A 0 A_GiveInventory("CeilingCheck")
    stop
   No:
    TNT1 A 0
    stop
  }
}

actor CeilingCheck : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("GroundFlag", 1, "SpeedDown")
    // Touching ceiling: actor bottom is ~height below ceiling (not exact == -56).
    TNT1 A 0 A_JumpIf(ceilingz - z <= 58, "Contact")
    goto SpeedDown
   Contact:
    TNT1 A 0 A_JumpIf(z - floorz <= 0, "SpeedDown")
    TNT1 A 0 A_JumpIfInventory("OnCeilingFlag", 1, "SpeedUp")
    TNT1 A 0 A_JumpIfInventory("ReverseJumped", 1, "GiveFlag")
    TNT1 A 0 A_PlaySoundEx("*land", "Auto")
   GiveFlag:
    TNT1 A 0 A_GiveInventory("OnCeilingFlag")
   SpeedUp:
    TNT1 A 0 A_GiveInventory("PowerGravityCeilingSpeed", 1)
    stop
   SpeedDown:
    TNT1 A 0 A_TakeInventory("OnCeilingFlag")
    TNT1 A 0 A_TakeInventory("PowerGravityCeilingSpeed")
    stop
  }
}

actor ReverseJump : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ReverseJumped", 1, "NoJump")
    TNT1 A 0 A_JumpIfInventory("OnCeilingFlag", 1, "Jump")
    stop
   Jump:
    // World-down thrust. UH_FlipJumpPower makes JumpZ negative; plain -JumpZ
    // would push into the ceiling, so invert only when JumpZ is still positive.
    TNT1 A 0 A_JumpIfInventory("UH_FlipJumpPower", 1, "JumpFlipped")
    TNT1 A 0 A_ChangeVelocity(0, 0, -CallACS("core_getactorproperty", 0, APROP_JumpZ, DATATYPE_RAW) / 65536.0)
    goto JumpDone
   JumpFlipped:
    TNT1 A 0 A_ChangeVelocity(0, 0, CallACS("core_getactorproperty", 0, APROP_JumpZ, DATATYPE_RAW) / 65536.0)
   JumpDone:
    TNT1 A 0 A_GiveInventory("ReverseJumped")
    TNT1 A 0 A_GiveInventory("JumpCancler")
    TNT1 A 0 A_TakeInventory("OnCeilingFlag")
    stop
   NoJump:
    TNT1 A 0
    stop
  }
}

// Global reverse (Reload): flag on caster; duration = SurpriseGravityAmmo drain
actor ReverseGravitySwitch_P : CustomInventory {
  States {
   Pickup:
    TNT1 A 0 A_JumpIfInventory("ReverseGravityFlag", 1, "Take")
   Give:
    TNT1 A 0 A_GiveInventory("ReverseGravityFlag")
    stop
   Take:
    TNT1 A 0 A_TakeInventory("ReverseGravityFlag")
    stop
  }
}

actor ReverseGravityCountdown_H : BasicWatcher {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_JumpIfInTargetInventory("ReverseGravityFlag", 1, "SpawnLoop")
    stop
   SpawnLoop:
    TNT1 A 0 A_JumpIf(!CallACS("uh_IsPlayerAlive", CallACS("core_getptrtid", 2)), "End")
    TNT1 A 0 A_JumpIfInTargetInventory("ReverseGravityFlag", 1, 1)
    stop
    TNT1 A 0 A_JumpIfInTargetInventory("SurpriseGravityAmmo", 1, 1)
    goto End
    TNT1 A 1 A_TakeFromTarget("SurpriseGravityAmmo", 1)
    goto SpawnLoop
   End:
    TNT1 A 0 ACS_NamedExecuteAlways("rz_ReverseGravityEveryoneExceptTid", 0, CallACS("core_getptrtid", 2))
    TNT1 A 0 A_TakeFromTarget("ReverseGravityFlag")
    stop
  }
}

// Victim path: only FlipGrav (no Air/Wall/Jump flip)

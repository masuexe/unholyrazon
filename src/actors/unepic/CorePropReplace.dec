actor BasicSpikeU replaces Spike {
  //$Category MM8BDM-Interactive Props
  obituary "AGH"
  +DONTBLAST
  +NOGRAVITY
  +THRUGHOST
  Height 16
  Radius 16
  scale 2.5
  States {
   Spawn:
    HAZA A 0 
    HAZA A -1 A_SpawnItemEx("SpikeDamagerU")
    stop
  }
}
actor HazardTag_SpikeU : BasicACSDamager {
  damagetype "SpikeU"
  Obituary "%o was impaled while fighting %k."
}

actor SpikeDamagerU : SpikeDamager replaces SpikeDamager {
  damage 255
  damagetype "SpikeU"
  states {
   Spawn:
    TNT1 A 35
    Loop
   Death:
    TNT1 A 35
    TNT1 A 0 A_SpawnItemEx("SpikeDamagerU")
    stop
  }
}


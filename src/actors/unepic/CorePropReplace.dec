actor OilCanisterU : OilCanister replaces OilCanister {Health 1000}
actor OilCanisterExplosionU : OilCanisterExplosion replaces OilCanisterExplosion {
	States {
	 Spawn:
		TNT1 E 0
		TNT1 E 0 A_PlaySoundEx("misc/mm3explosion", "Weapon")
		TNT1 E 0 A_SpawnItemEx("OilPitIgnite", 0, 0, -32)
		goto Explode
	 Credit:
		TNT1 E 0 A_SpawnItemEx("OilCanisterExplodeFX")
		TNT1 A 35 ACS_NamedExecuteWithResult("core_propexplode", 200, 120, 120)
		stop
	 NoCredit:
		TNT1 E 0 A_SpawnItemEx("OilCanisterExplodeFX")
		TNT1 A 35 A_Explode(200, 120, XF_HURTSOURCE, 0, 120)
		stop
	}
}
actor HazardCredit_OilCanisterExplosionU : HazardCredit_OilCanisterExplosion {}

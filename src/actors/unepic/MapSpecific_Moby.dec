// MM4DIV ("DIVE MAN") — Unbound-style hidden MiniVile prank.
// The map's Moby is replaced so a one-shot helper is started on map load.
// The helper waits, then drops a disguised MiniVile at one of nine fixed
// spots (offsets are absolute map coordinates; the helper spawns at 0,0,0).

actor Moby_BurningJoke : Moby replaces Moby {
  States {
   Spawn:
    MOBY A 0
    MOBY A 0 A_JumpIf(CallACS("uh_MobyBurningJokeCheck") == 2, "SpawnBurning")
    goto Super::Spawn
   SpawnBurning:
    MOBY A 0
    goto Super::Spawn
  }
}

actor Moby_BurningJoke_H : BasicHelper {
  States {
   Spawn:
    TNT1 A 0
    TNT1 A 350
    TNT1 A random(35, 350)
    TNT1 A 0 A_Jump(256, "S_1", "S_2", "S_3", "S_4", "S_5", "S_6", "S_7", "S_8", "S_9")

   S_1:  // Platform by Moby
    TNT1 A 0 A_SetArg(0, 0)
    TNT1 A 0 A_SetArg(1, 0)
    TNT1 A 0 A_SetArg(2, 384)
    goto Spawning
   S_2:  // Moby East Ladder
    TNT1 A 0 A_SetArg(0, 704)
    TNT1 A 0 A_SetArg(1, 384)
    TNT1 A 0 A_SetArg(2, 384)
    goto Spawning
   S_3:  // Moby West Ladder
    TNT1 A 0 A_SetArg(0, -704)
    TNT1 A 0 A_SetArg(1, 384)
    TNT1 A 0 A_SetArg(2, 384)
    goto Spawning
   S_4:  // SkullBarrier
    TNT1 A 0 A_SetArg(0, 0)
    TNT1 A 0 A_SetArg(1, 896)
    TNT1 A 0 A_SetArg(2, 448)
    goto Spawning
   S_5:  // DrillBomb opposite side of Moby
    TNT1 A 0 A_SetArg(0, 0)
    TNT1 A 0 A_SetArg(1, 1920)
    TNT1 A 0 A_SetArg(2, 352)
    goto Spawning
   S_6:  // ChargeKick
    TNT1 A 0 A_SetArg(0, -1696)
    TNT1 A 0 A_SetArg(1, 448)
    TNT1 A 0 A_SetArg(2, 128)
    goto Spawning
   S_7:  // WTank
    TNT1 A 0 A_SetArg(0, -992)
    TNT1 A 0 A_SetArg(1, 448)
    TNT1 A 0 A_SetArg(2, 128)
    goto Spawning
   S_8:  // DustCrusher by Wire
    TNT1 A 0 A_SetArg(0, -1344)
    TNT1 A 0 A_SetArg(1, 1664)
    TNT1 A 0 A_SetArg(2, 160)
    goto Spawning
   S_9:  // Pillar by shallow water, east map
    TNT1 A 0 A_SetArg(0, 1248)
    TNT1 A 0 A_SetArg(1, 1024)
    TNT1 A 0 A_SetArg(2, 512)
    goto Spawning

   Spawning:
    TNT1 A 1
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BoxDE_MinivileHidden", Args[0], Args[1], Args[2], 0, 0, 0, 0, 2 + 32, 16)
    stop
  }
}

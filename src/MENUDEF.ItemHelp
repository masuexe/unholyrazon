// ===========================================================================
// Item Information - Table of Contents + Illustrated ListMenu Pages
// Unbound items appear first in original order; Razon 4.0 additions follow.
// ===========================================================================

OptionMenu "UH_ItemHelpMenu"
{
	Title "Item Information"
	Indent 0
	StaticText "$MNU_UH_EQUAL_LINE"
	StaticText ""

	StaticText "$MNU_ITEMINFO_PANDORA", 1
	Submenu "Browse All  (8 Pages)", "UH_ItemHelp_Pandora1"
	Submenu "Razon Additions  (Page 7-8)", "UH_ItemHelp_Pandora7"
	StaticText ""

	StaticText "$MNU_ITEMINFO_MYSTIC", 1
	Submenu "Browse All  (4 Pages)", "UH_ItemHelp_Mystic1"
	Submenu "Razon Additions  (Page 4)", "UH_ItemHelp_Mystic4"
	StaticText ""

	StaticText "$MNU_ITEMINFO_WONDER", 1
	Submenu "Browse All  (4 Pages)", "UH_ItemHelp_Wonder1"
	Submenu "Razon Additions  (Page 3-4)", "UH_ItemHelp_Wonder3"
	StaticText ""

	StaticText "$MNU_ITEMINFO_SPECIAL", 1
	Submenu "Other Items", "UH_ItemHelp_Other1"
	Submenu "Skulltag Runes  (2 Pages)", "UH_ItemHelp_Runes1"
	StaticText ""

	StaticText "$MNU_UH_EQUAL_LINE"
}


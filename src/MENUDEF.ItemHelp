OptionValue UH_ItemDesc
{
0, "\cdOpens a random \cgPandora \cditem\nRanges from helpful tools to curses"
1, "\cdCalls down an explosive airstrike barrage\non the target area"
2, "\cdFires a rocket projectile\nSharp deals lethal piercing damage"
3, "\cdSpawns a hostile Demoneye or Mini-Vile\nhazard from the box"
4, "\cdPlaces an explosive brick mine trap\non the floor"
5, "\cdSummons an ice hazard\nIce Wall, Ice Wave, or Chill Spike"
6, "\cdSummons a swarm of hostile crows\nto harass nearby enemies"
7, "\cdDeploys a mini turret toy\nFires fire, ice, or laser shots at foes"
8, "\cdFlips a coin for a random blessing\nor heavy backlash"
9, "\cdForces you to slowly lose health\nand dramatically self-destruct"
10, "\cdDrops bait that transforms victims\ninto Demoneyes"
11, "\cdSets yourself ablaze, burning nearby foes\nDrains HP, ice hits reduce 1 stack"
12, "\cdDeploys instant-kill floor spikes\nor flings nearby players away"
13, "\cdHigh-jump mobility bounce pad\nor contraband grapple hook"
14, "\cdTeleports and banishes targets\nacross the arena"
15, "\cdUnleashes beam blasts\nor splashes cursed water hazards"
16, "\cdReleases an aggressive swarm\nof homing wasps"
17, "\cdChance to instantly slay a target\nbased on missing health"
18, "\cdSpawns a random classic Mega Man\ncoop enemy onto the field"
19, "\cdOpens a high-tier \ckMystic \cditem\nGrants powerful buffs or deadly chaos"
20, "\cdGrants temporary comedic protection\nand knockback resistance"
21, "\cdUnleashes a massive swarm of bees\nthat chase down enemies"
22, "\cdBoosts movement speed and fire rate\nfor a burst of momentum"
23, "\cdGrants brief total invulnerability\nand contact damage"
24, "\cdThrows a firebomb that ignites\nthe floor and burns targets"
25, "\cdExplodes in a wide radius\nMorphs caught players into Demoneyes"
26, "\cdRestores health and grants\na hefty protective boost"
27, "\cdAmplified Give Up Hope\nCauses catastrophic self-destruction"
28, "\cdLaunches a chaotic bouncing football\nthat knocks players around"
29, "\cdGrants a powerful random wish effect\nsuch as healing or runes"
30, "\cdFires unpredictable elemental bursts\nwith unique kill effects"
31, "\cdCurses the target with\nan impending doom countdown"
32, "\cdRare super-box granting\ngame-changing items and revivals"
33, "\cdCalls a wide carpet-bombing run\nacross the battlefield"
34, "\cdEquips an overpowered rapid-fire gun\nfor a limited time"
35, "\cdRevives a fallen player after delay\nGrants Mortis Blessing if picked up"
36, "\cdSpawns an elite swarm\nof lethal golden wasps"
37, "\cdTriggers a chaotic victory-style\neffect on the user"
38, "\cdSupercharges speed, jump, and energy\nfor extreme mobility"
39, "\cdSummons a motivated plastic chair\nwith a defensive aura"
40, "\cdProtects you from one lethal hit\nRestores health and brief invuln"
41, "\cdSplashes targets with a debuff\nIncreases damage taken"
42, "\cdTransforms a survivor into their\nupgraded Shiny / True Power form"
43, "\cdStrength (2x dmg), Rage (2x fire rate)\nDrain (lifesteal), Spread (3x shots)\nResistance (half dmg), Regen, Haste\nHighJump, Prosperity, Reflection\nEndlessAmmo"
}

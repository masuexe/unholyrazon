actor CAPAmmoA : Ammo { Inventory.MaxAmount 100 Inventory.Amount 0 }
actor CAPAmmoB : Ammo { Inventory.MaxAmount 100 Inventory.Amount 0 }
actor CAPAmmoC : Ammo { Inventory.MaxAmount 100 Inventory.Amount 0 }
actor CAPDual : BaseMM8BDMWep_UH {
 Weapon.AmmoType "CAPAmmoA"
 Weapon.AmmoType2 "CAPAmmoB"
 Weapon.AmmoGive 0
 Weapon.AmmoGive2 0
 Weapon.SelectionOrder 99999
 States {
 Ready:
  TNT1 A 1 A_WeaponReady
  loop
 Fire:
  TNT1 A 1
  goto Ready
 Select:
  TNT1 A 1 A_Raise
  loop
 Deselect:
  TNT1 A 1 A_Lower
  loop
 }
}
actor CAPUnowned : CAPDual {}
actor CAPAmmoD : Ammo { Inventory.MaxAmount 100 Inventory.Amount 0 }
actor CAPSecondaryOnly : CAPDual { Weapon.AmmoType "" Weapon.AmmoType2 "CAPAmmoD" }

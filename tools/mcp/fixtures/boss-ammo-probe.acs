#library "AMMOPROB"
#include "zcommon.acs"
script "UHAmmoProbe" (int fill) {
 SetActivator(1000);
 if (fill) GiveInventory("UnholyPower1500",1500);
 Log(s:"AMMOPROBE server power=",i:CheckInventory("UnholyPower1500"));
}
script "UHAmmoDrift" (void) CLIENTSIDE { TakeInventory("UnholyPower1500",1); }

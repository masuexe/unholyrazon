#library "WDTHPROB"
#include "zcommon.acs"

// A synchronous lethal hit exercises the weapon's inherited DeselectDeath.
script "UHTest_WeaponDeath" (void) {
  if (!SetActivatorToPlayer(0)) terminate;
  SetActorProperty(0, APROP_Health, 50);
  Log(s:"UH_WEAPON_DEATH_BEFORE");
  Thing_Damage2(0, 50, "JuggerShot");
  Log(s:"UH_WEAPON_DEATH_RETURNED");
}

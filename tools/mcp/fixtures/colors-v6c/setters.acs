#library "INVPROB"
#include "zcommon.acs"
#import "uh_acsutils.acs"
script "UHTest_CachedSetters" (void) CLIENTSIDE {
  SetInventory2("V6cColorNew", 9, CheckInventory("V6cColorNew"));
  bool ok = CheckInventory("V6cColorNew") == 9;
  SetActorInventory2(ActivatorTID(), "V6cColorNew", 4, CheckInventory("V6cColorNew"));
  ok = ok && CheckInventory("V6cColorNew") == 4;
  TakeInventory("V6cColorNew", 99);
  SetResultValue(ok && CheckInventory("V6cColorNew") == 0);
}

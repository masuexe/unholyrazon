actor DecoyCopy_41_W1 : DecoyCopyHeldBase_W1 {
  Tag "$TAG_DecoyCopy_41_W1"
  States {
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H50 B 0 A_GiveInventory("Decoy_F_41Start_P")
    6H50 B 3 A_GunFlash("Flash.Fire41", 1)
   F41Up:
    6H50 C 1 A_ReFire("F41UpCheck")
    6H50 C 0 A_JumpIf(momz<=0, "F41Down")
    loop
   F41Up0:
    6H50 C 1 A_JumpIf(momz<=0, "F41Down")
    6H50 C 0 A_ReFire("F41Up0")
    loop
   F41UpCheck:
    6H50 C 0 OffSet(0, 32)A_JumpIfInventory("DecoyEnergyAmmo", 1, 1)
    goto F41Up0
    6H50 X 2 OffSet(0, 34)A_GiveInventory("Decoy_F_41Boost_P")
    6H50 C 1 OffSet(0, 32)
    goto F41Up
   Flash.Fire41:
    TNT1 A 0 A_SetArg(4, 1)
    TNT1 A 2 A_SetArg(4, Args[4]+1)
    wait
   F41Down:
    6H50 B 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "F41Crash")
    6H50 B 0 A_JumpIfInventory("HandyFlag", 999, "F41Crash")
    6H50 B 0 A_GiveInventory("DecoyB_F_P41")
    6H50 B 1 Offset(0, 32)A_ReFire(1)
    loop
    6H50 C 1 Offset(0, 29)A_GiveInventory("Decoy_F_41Boost2_P")
    loop
   F41Crash:
    6H50 X 1 A_GiveInventory("DB41_FloorQuake_P")
    6H50 CX 1
    6H50 CX 1 A_TakeInventory("HandyFlag")
    6H50 XCC 1
    6H50 BA 3
    goto Ready2
  }
}


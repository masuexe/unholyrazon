    6H50 C 1 A_FireCustomMissile("Decoy_F_51", 0, 0, 0, 0, 1, 0)
    6H50 XCXC 1 A_JumpIfInventory("SuplexID", 1, "Fire51Suplex")
    6H50 C 2 A_TakeInventory("VivifyCycle2")
    6H50 CB 2
    6H50 BAAAA 4 A_GiveInventory("DecoyEnergyAmmo", 2)
    goto Ready2
   Fire51Suplex:
    6H50 C 1 A_GiveInventory("Decoy_F_51Start_P")
    6H50 C 0 A_SetPitch(356)
    6H50 C 0 A_SetAngle(Args[1]+12)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-12, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(352)
    6H50 C 0 A_SetAngle(Args[1]+24)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-24, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(348)
    6H50 C 0 A_SetAngle(Args[1]+36)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-35, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(344)
    6H50 C 0 A_SetAngle(Args[1]+48)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-46, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(340)
    6H50 C 0 A_SetAngle(Args[1]+60)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-57, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(336)
    6H50 C 0 A_SetAngle(Args[1]+72)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-68, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(333)
    6H50 C 0 A_SetAngle(Args[1]+84)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-79, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(330)
    6H50 C 0 A_SetAngle(Args[1]+103)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-90, Args[0], 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(336)
    6H50 C 0 A_SetAngle(Args[1]+129)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-67, Args[0]+128, 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(343)
    6H50 C 0 A_SetAngle(Args[1]+155)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-44, Args[0]+128, 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(351)
    6H50 C 0 A_SetAngle(Args[1]+180)
    6H50 C 1 A_Jumpif(CallACS("uh_ZangiefGrab", 360-22, Args[0]+128, 100)==0, "Fire51Boom")
    6H50 C 0 A_SetPitch(0)
   Fire51Boom:
    6H50 C 0 A_GiveInventory("Decoy_F_51Boom_P")
    6H50 X 2  // A_GiveInventory("VivifyDelay4",1)
    6H50 CX 2
    6H50 C 2 A_GiveInventory("Decoy_F_51End_P")
    6H50 BA 2
    goto Ready2
  }
}

actor DecoyCopy_52_W1 : DecoyCopyHeldBase_W1 {
  Tag "$TAG_DecoyCopy_52_W1"
  States {
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   Fire52H1:
    6H50 A 0 A_JumpIfInventory("AmberChargeFlag", 24, "Fire52H2")
    6H50 A 1 OffSet(2, 34)  // A_GiveInventory("AmberChargeFlag",1+CallACS("uh_checkrune", RUNE_RAGE))
    6H50 A 0  // A_ReFire("Fire52H1")
    goto Fire52A
   Fire52H2:
    6H50 B 0 A_JumpIfInventory("AmberChargeFlag", 0, "Fire52H3")
    6H50 B 1 OffSet(4, 37)A_GiveInventory("AmberChargeFlag", 1+CallACS("uh_checkrune", RUNE_RAGE))
    6H50 B 0 A_ReFire("Fire52H2")
    goto Fire52A
   Fire52H3:
    6H50 C 1 OffSet(6, 40)ACS_NamedExecuteWithResult("core_weaponcolor", AMBER_DYE2, 1)
    6H50 C 0 A_ReFire(1)
    goto Fire52A
    6H50 C 1 OffSet(6, 41)ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, 1)
    6H50 C 0 A_ReFire("Fire52H3")
    goto Fire52A
   Fire52Bot:
    6H50 C 0 A_GiveInventory("AmberChargeFlag", 1+random(0, 2)*35)
    6H50 C random(2, 8)
    6H50 C 0 A_ReFire("Fire52A")
    goto Fire52A
   Fire52A:
    6H50 C 1 OffSet(-12, 20)A_GiveInventory("DecoyB_F_P52", 1)
    6H50 C 1 OffSet(-39, 23)
    6H50 C 1 OffSet(-82, 32)
    6H50 C 1 OffSet(-131, 41)
    6H50 B 1 OffSet(-164, 47)
    6H50 B 1 OffSet(-208, 55)
    6H50 B 1 OffSet(-256, 69)
    6H50 B 1 OffSet(-304, 86)
    TNT1 A 4
    TNT1 AAAAAAAAA 2 A_ReFire("Fire52B")
    TNT1 A 0 A_TakeInventory("AmberChargeFlag")
    6H50 A 2 OffSet(-48, 80)A_ReFire("Fire")
    6H50 A 2 OffSet(-32, 66)A_ReFire("Fire")
    6H50 A 2 OffSet(-19, 55)A_ReFire("Fire")
    6H50 A 2 OffSet(-10, 46)A_ReFire("Fire")
    6H50 A 2 OffSet(-3, 39)A_ReFire("Fire")
    goto Ready2
   Fire52B:
    6H50 C 1 OffSet(-178, 54)A_GiveInventory("DecoyB_F_P52B", 1)
    6H50 C 1 OffSet(-128, 45)
    6H50 C 1 OffSet(-79, 34)A_TakeInventory("AmberChargeFlag")
    6H50 B 1 OffSet(-30, 25)
    6H50 B 1 OffSet(19, 19)
    6H50 B 1 OffSet(72, 21)
    6H50 B 1 OffSet(129, 33)
    TNT1 A 8
    6H50 A 2 OffSet(80, 75)
    6H50 A 2 OffSet(54, 58)
    6H50 A 2 OffSet(32, 45)
    6H50 A 2 OffSet(16, 39)
    6H50 A 2 OffSet(6, 35)
    goto Ready2
  }
}


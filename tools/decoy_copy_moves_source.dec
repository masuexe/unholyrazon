// Canonical DecoyBot held-copy source. Do not include this file in DECORATE.
// Edit W1 actors here; tools/gen_decoy_moves.py emits W1/W2/W3 into
// src/actors/classes/survivors/decoy_copy_moves.dec.
// Only W2/W3 actors with real behavior differences appear as overrides.
// Keep the explicit sprite on every state frame for easier review and debugging.


actor DecoyCopyHeldBase_W1 : BaseMM8BDMWep_UH {
  Tag "$TAG_DecoyBot_W"
  Weapon.SlotNumber 1
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  weapon.ammotype "DecoyEnergyAmmo"
  weapon.ammotype2 "FlukyNumberAmmo"
  inventory.icon "C_I_50A"
  Weapon.UpSound ""
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H50 [ 6
    loop
   Deselect:
    6H50 A 0
    goto DeselectSwap
   Select:
    6H50 A 0 A_JumpIfInventory("UH_SilentSelect_F", 1, "SilentSelect")
    goto SelectSwap
   SilentSelect:
    6H50 A 0 A_TakeInventory("UH_SilentSelect_F")
    6H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, CLRF_GRAVITYWARN)
    6H50 A 0 A_TakeInventory("NoWeaponSwitchSound")
    6H50 A 0 A_WeaponReady(14)
    goto Ready2
   Ready:
    6H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, CLRF_GRAVITYWARN)
    6H50 A 0
    goto Ready2
   Ready2:
    6H50 A 2 A_GiveInventory("DecoyBot_WepReady1_P")
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", 3)
    6H50 A 0 A_GiveInventory("FlukyNumberAmmo", 1)
    loop
   AltFire:
    6H50 D 0 A_JumpIfInventory("FlukyNumberAmmo", 100, "AltFireGo")
    goto Ready2
   AltFireGo:
    6H50 DDAADD 1 A_RailWait
    6H50 A 0
    6H50 AADDA 1
    6H50 A 1 A_GiveInventory("DecoyBotAlt_P")
    goto Ready2
   BotFire:
    6H50 A 0 A_JumpIfInventory("DecoyBotFlagBot", 30, "BotFire1")
    6H50 A 0 A_Jump(16, "BotFire2")
    6H50 A 0 A_GiveInventory("DecoyBotFlagBot", 1)
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", random(1, 49))
    6H50 A 0 A_Jump(256, "FireGo")
   BotFire1:
    6H50 A 0 A_Jump(96, "BotFire2")
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", random(40, 100))
    6H50 A 0 A_Jump(256, "FireGo")
   BotFire2:
    6H50 A 0 A_TakeInventory("DecoyBotFlagBot")
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", 200)
    6H50 A 0 A_PlaySoundEx("taunt/D_50", "Voice")
    goto AltFire
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H50 A 1 A_WeaponReady
    wait
  }
}


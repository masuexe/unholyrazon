actor DecoyCopy_57_W1 : DecoyCopyHeldBase_W1 {
  Tag "$TAG_DecoyCopy_57_W1"
  States {
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H50 B 2 A_JumpIfInventory("IsBot", 1, "Fire57Bot")
    6H50 B 0 A_ReFire(1)
    Goto Fire57Det
    6H50 B 2 A_RailWait
    6H50 B 0 A_ReFire(1)
    Goto Fire57Det
    6H50 B 2 A_RailWait
    6H50 B 0 A_ReFire("Fire57Toss")
    Goto Fire57Det
   Fire57Toss:
    6H50 C 3
    6H50 B 6 A_GiveInventory("DecoyB_F_P57", 1)
    6H50 A 3
    6H50 A 2 A_ReFire(2)
    6H50 A 8
    goto Ready2
    6H50 A 8 A_JumpIfInventory("DecoyEnergyAmmo", 20-10*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "Fire57Toss")
    goto Ready2
   Fire57Det:
    6H50 X 1 offset(-2, 36)A_GiveInventory("DecoyB_F_P57D", 1)
    goto Ready2
   Fire57Bot:
    6H50 C 3 A_GiveInventory("DecoyB_F_P57", 1)
    6H50 B 6
    6H50 A 5
    6H50 A 10 A_ReFire(1)
    goto Ready2
    6H50 A 10 A_Jump(64, "Fire57Det")
    goto Ready2
  }
}

actor DecoyCopy_58_W1 : DecoyCopyHeldBase_W1 {
  Tag "$TAG_DecoyCopy_58_W1"
  States {
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H58 Y 0 A_GiveInventory("Decoy_F_58_P1")
    6H58 Y 0 A_ReFire(1)
    6H58 Y 3
    6H58 Y 2 A_TakeInventory("KickChampFlag")
    6H58 Z 1 A_GiveInventory("Decoy_F_58_P2")
    goto Fire58Kick  // +2
   Fire58Kick:
    6H58 Z 1 A_GiveInventory("DecoyB_F_P58", 1)
    6H58 Z 0 A_JumpIfInventory("KickChampFlag", 1, "Fire58Hit")
    6H58 Z 0 A_JumpIf(CallACS("core_CheckFooting_ThruPlayer"), "Fire58Land")
    loop
   Fire58Land:
    6H58 Y 4 A_GiveInventory("Decoy_F_58_P3")
    goto Ready2
   Fire58Hit:
    6H58 Y 8 A_GiveInventory("KickChamp_AltRecoil_P")
    goto Fire58Land
  }
}


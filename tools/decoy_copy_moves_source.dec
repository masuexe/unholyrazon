actor DecoyCopy_60_W1 : DecoyCopyHeldBase_W1 {
  Tag "$TAG_DecoyCopy_60_W1"
  States {
   Ready2:
    6H50 A 0 A_GiveInventory("DecoyEnergyAmmo", 3)
    6H50 A 0 A_GiveInventory("FlukyNumberAmmo", 1)
    6H50 A 0 A_JumpIfInventory("FlukyNumberAmmo", 100, 2)
    6H50 A 2 A_WeaponReady(WRF_NOSECONDARY)
    goto Ready2
    6H50 A 2 A_WeaponReady
    goto Ready2
   Fire:
    6H50 A 0 A_JumpIfInventory("IsBot", 1, "BotFire")
   FireGo:
    6H50 A 0 A_JumpIfInventory("CrystrapShotAlive", 1, "Detonate")
    6H50 A 0 A_JumpIfInventory("DecoyEnergyAmmo", 100 - 50*CallACS("uh_checkrune", RUNE_ENDLESSAMMO), "ShootCore")
    goto ShootBit
   ShootCore:
    6H50 C 2 A_GiveInventory("DecoyB_F_P60", 1)
    6H50 B 3
    6H50 A 5
    goto Ready2
   ShootBit:
    6H50 C 2 A_GiveInventory("DecoyB_F_P60B", 1)
    6H50 B 3
    6H50 A 5
    goto Ready2
   Detonate:
    6H50 D 0 A_PlaySoundEx("Pokemon/Detect", "Weapon")
    6H50 D 0 A_GiveInventory("CrystrapBoomFlag")
    6H50 D 2 Offset(0, 38)
    6H50 A 2 Offset(0, 35)
    6H50 A 4 Offset(0, 32)
    goto Ready2
  }
}


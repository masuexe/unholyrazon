   Fire15A:
    6H50 C 0 A_JumpIfHealthLower(CallACS("UH_FetchMyHealth", 1)*0.50+1, "Fire15B")
    6H50 C 2 A_GiveInventory("DecoyB_F_P15A", 1)
    6H50 B 2
    6H50 A 8
    goto Ready2
   Fire15B:
    6H50 C 0 A_JumpIfHealthLower(CallACS("UH_FetchMyHealth", 1)*0.25+1, "Fire15C")
    6H50 C 2 A_GiveInventory("DecoyB_F_P15B", 1)
    6H50 B 2
    6H50 A 6
    goto Ready2
   Fire15C:
    6H50 C 0 A_JumpIfHealthLower(CallACS("UH_FetchMyHealth", 1)*0.01+1, "Fire15D")
    6H50 C 2 A_GiveInventory("DecoyB_F_P15C", 1)
    6H50 BA 2
    goto Ready2
   Fire15D:
    6H50 C 2 A_GiveInventory("DecoyB_F_P15DDDD", 1)
    6H50 A 2 A_GiveInventory("DecoyB_F_P15DDD", 1)
    6H50 B 2 A_GiveInventory("DecoyB_F_P15DD", 1)
    6H50 A 2 A_GiveInventory("DecoyB_F_P15D", 1)
    goto Ready2
  }
}


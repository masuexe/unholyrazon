#library "LMSPENEX"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"

function void RegisterExampleLMSPenalty(void) {
  DefineLMSEvent(-1, "example_penalty", "A helpful gift!", "A better gift!", "The bosses get the gift!",
    "LMS_E#4", "LMS_X#4", "LMS_B#4", 0, 0, 0);
  AddLMSEventDrop("example_penalty", "WaspBombItem", 3, 0);
  AddLMSEventDrop("example_penalty", "GoldenWaspBombItem", 1, 1);
  AddLMSEventPenaltyDrop("example_penalty", "GoldenWaspBombItem", 1, UHLMS_PENALTY_BOSSES);
}

script "example_lms_penalty" OPEN {
  if (!UHInPlay()) terminate;
  RegisterExampleLMSPenalty();
}

script "example_lms_penalty_cs" OPEN CLIENTSIDE {
  RegisterExampleLMSPenalty();
}

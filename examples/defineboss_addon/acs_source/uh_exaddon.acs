#library "uh_exaddon"
#include "zcommon.acs"
#import "uh_log.acs"
#include "uhadd.acs"

function void UH_ExampleRegisterBosses(void) {
  int id;
  id = DefineBoss(-1, "UHExampleBoss", "\cjUH Example Boss", UHBOSS_POOL_COMMON,
             2150, 255, "", "UFACE26",
             "\ckPhase3-style custom boss.\nUse ForcedBoss -1 to morph this actor.",
             "T.", "tests as", "");
  AddBossMusic(id, "M_UB026 104", "DefineBoss example addon", "", "", 1, 0);

  // Post-morph, pre-Ready setup: give the boss the same two lives as CuttyCut.
  SetBossMorphSetupByActor("UHExampleBoss", "uh_BossMorphSetup_UHExampleBoss");
}

script "uh_BossMorphSetup_UHExampleBoss" (int bossId, int tid) {
  SetActivator(tid);
  ACS_NamedExecuteWithResult("uh_extralifeplayer", 0, 2, 0); // ELP_NATIVE
}

script "uh_exaddon_define_bosses" OPEN {
  if (!UHInPlay()) terminate;
  UH_ExampleRegisterBosses();
}

script "uh_exaddon_define_bosses_cs" OPEN CLIENTSIDE {
  // Do NOT UHInPlay (SpawnForced can fail on pure clients).
  // Do NOT UH_IsBossDefined(0/-1); duplicate actors rejected by DefineBoss.
  UH_ExampleRegisterBosses();
}

// Server-side CRUD example: an admin can disable the next random selection
// while preserving the definition and the actor-keyed music row.
script "uh_exaddon_set_enabled" (int enabled) {
  SetResultValue(SetBossEnabledByActor("UHExampleBoss", enabled));
}

#library "uh_exshiny"
#include "zcommon.acs"
#include "uhadd.acs"

// Shiny move-weapon example registration.
// Load order: MM8BDM-v6b -> Unholy -> this addon.
function void UHExRegisterShiny(void) {
  // QwantShiny AltFire pool: vanilla 25 moves have weight 1 each.
  DefineShinyQwantMoveWep("UHExMoveFireBall_W", 2);

  // NegaManShiny held cycle slot 26 (NegaShiny_* prefix for bar remap).
  DefineShinyNegaSlotWep(26, "NegaShiny_UHExSlash_W", "", "");

  // DecoyBot held copies slot 59+ (stem DecoyCopy_UHExDecoyShot).
  DefineDecoyBotMoveWep("DecoyCopy_UHExDecoyShot_W1");
  DefineDecoyBotShinyWep("DecoyCopy_UHExDecoyShot_W1", "DecoyShiny_UHExDecoyShot_W");

  // Shiny MegaMan flat pool (M1 weight 5 = ordinary Fire move).
  DefineShinyMegaCopyWep("ShinyMega_UHExShot_P", UH_SHINYMEGA_M1, 5);
  DefineShinyMegaCopyWep("ShinyMega_UHExShot_P", UH_SHINYMEGA_M2, 19);
}

script "UHEx_define_shiny" OPEN {
  if (!UHInPlay()) terminate;
  UHExRegisterShiny();
}

script "UHEx_define_shiny_cs" OPEN CLIENTSIDE {
  // No UHInPlay check on clients (SpawnForced can fail on pure clients);
  // duplicate rows are rejected by the core so re-running is safe.
  UHExRegisterShiny();
}

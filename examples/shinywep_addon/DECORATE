// --- Shiny MegaMan fire actors (no weapon switch; Pickup fires) --
actor ShinyMega_UHExShot_P : ShinyMegaBase_P {
  States {
   Pickup:
    TNT1 A 0 A_PlaySoundEx("weapons/busters/megabusterfire", "Weapon")
    TNT1 A 0 A_FireCustomMissile("UHExFireBall", 0, 0, 8, 0)
    stop
  }
}


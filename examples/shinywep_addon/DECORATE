// ============================================================
// Shiny move-weapon example addon (load AFTER Unholy build.pk3)
//
// The example reuses Unholy sprites (7H01/7H02/6H50) so it ships no
// lumps; real addons ship their own sprite prefixes — that is where
// the per-frame animation freedom lives (frame letters, offsets,
// durations, sounds, projectiles are all yours).
// ============================================================

// --- QwantShiny AltFire move -----------------------------------
actor UHExMoveFireBall_W : BaseMM8BDMWep_UH {
  // Ammo gate: share the class's ammo pool with zero use so the
  // dispatcher's SetWeapon (CheckAmmo EitherFire) passes.
  Weapon.AmmoType "MyDestinyAmmo"
  Weapon.AmmoUse 0
  Weapon.UpSound ""
  +WEAPON.NOALERT
  States {
   Spawn:
    7H01 [ 6
    loop
   Deselect:
    7H01 A 0
    goto DeselectSwap
   Select:
    7H01 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
    7H01 A 2 Offset(0, 40)
    7H01 C 2 Offset(0, 56) A_GiveInventory("UHExFireBallShot_P")
    7H01 C 2 Offset(0, 68) A_GiveInventory("UHExFireBallShot_P")
    7H01 C 2 Offset(0, 72) A_GiveInventory("UHExFireBallShot_P")
    7H01 B 2 Offset(0, 48)
    7H01 A 1 Offset(0, 32) ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
    7H01 A 1 A_WeaponReady
    wait
   Ready:
    7H01 A 1 A_WeaponReady
    wait
   Fire:
   AltFire:
    7H01 A 1 A_WeaponReady
    wait
  }
}

// --- NegaManShiny held cycle slot 26 (Fire1/2/3; L3 → Advance) ---
// Name prefix NegaShiny_ so BARHNDLE remaps the ammo bar to NegaManShiny_W.
actor NegaShiny_UHExSlash_W : NegaShinyHeldBase_W {
  States {
   Fire1:
    7H02 A 0 A_TakeInventory("WeaponCharge")
    7H02 A 0 A_JumpIfInventory("ShieldCheck", 1, "Nega4End")
    7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
    7H02 C 3 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
    7H02 B 2
    7H02 A 1
    goto Ready2
   Fire2:
    7H02 B 0 A_TakeInventory("WeaponCharge")
    7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
    7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
    7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 4, 0, 8, 0)
    7H02 B 3
    7H02 A 1
    goto Ready2
   Fire3:
    7H02 C 0 A_TakeInventory("WeaponCharge")
    7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
    7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
    7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 5, 0, 8, 0)
    7H02 C 2 A_FireCustomMissile("UHExNegaSlash", -5, 0, 8, 0)
    7H02 B 4
    goto Fire3End
  }
}

// --- DecoyBot held copies (slot 59+); M2 Gives all three -----------------
// Shiny Decoy uses the paired actor below: M1 fires it, M2 advances.
actor DecoyShiny_UHExDecoyShot_W : DecoyBotShinyCycleBase_W {
  States {
   Fire:
    7H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    7H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    7H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    7H50 B 2
    7H50 A 1
    goto Ready
  }
}

actor DecoyCopy_UHExDecoyShot_W1 : BaseMM8BDMWep_UH {
  Weapon.SlotNumber 1
  Weapon.AmmoType "DecoyEnergyAmmo"
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Inventory.Icon "C_I_50A"
  Weapon.UpSound ""
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  States {
   Spawn:
    6H50 [ 6
    loop
   Deselect:
    6H50 A 0
    goto DeselectSwap
   Select:
    6H50 A 0 A_JumpIfInventory("UH_SilentSelect_F", 1, "SilentSelect")
    goto SelectSwap
   SilentSelect:
    6H50 A 0 A_StopSound(CHAN_WEAPON)
    6H50 A 0 A_TakeInventory("UH_SilentSelect_F", 1)
    6H50 A 0 A_TakeInventory("NoWeaponSwitchSound", 1)
    6H50 A 0 A_WeaponReady(14)
    goto Ready
   Ready:
    6H50 A 0 ACS_NamedExecuteWithResult("core_weaponcolor", DECOYBOT_DYE, CLRF_GRAVITYWARN)
    6H50 A 1 A_WeaponReady
    wait
   Fire:
    6H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    6H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    6H50 C 2 A_GiveInventory("UHExDecoyShot_P")
    6H50 B 2
    6H50 A 1
    goto Ready
   AltFire:
    6H50 A 1 A_WeaponReady
    wait
  }
}


// ============================================================
// Shiny move-weapon example addon (load AFTER Unholy build.pk3)
//
// The example reuses Unholy sprites (7H01/7H02/6H50) so it ships no
// lumps; real addons ship their own sprite prefixes — that is where
// the per-frame animation freedom lives (frame letters, offsets,
// durations, sounds, projectiles are all yours).
// ============================================================

// --- QwantShiny AltFire move -----------------------------------
actor UHExMoveFireBall_W : BaseMM8BDMWep_UH
{
	// Ammo gate: share the class's ammo pool with zero use so the
	// dispatcher's SetWeapon (CheckAmmo EitherFire) passes.
	weapon.ammotype "MyDestinyAmmo"
	weapon.ammouse 0
	+WEAPON.NOALERT
	States
	{
	Spawn:
		7H01 [ 6
		loop
	Deselect:
		7H01 A 0
		goto DeselectSwap
	Select:
		7H01 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
		7H01 A 2 Offset(0, 40)
		7H01 C 2 Offset(0, 56) A_GiveInventory("UHExFireBallShot_P")
		7H01 C 2 Offset(0, 68) A_GiveInventory("UHExFireBallShot_P")
		7H01 C 2 Offset(0, 72) A_GiveInventory("UHExFireBallShot_P")
		7H01 B 2 Offset(0, 48)
		7H01 A 1 Offset(0, 32) ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
		7H01 A 1 A_WeaponReady
		wait
	Ready:
		7H01 A 1 A_WeaponReady
		wait
	Fire:
	AltFire:
		7H01 A 1 A_WeaponReady
		wait
	}
}

// --- NegaManShiny full-charge slot 26 (one weapon, 3 charge anims) -
actor UHExNegaSlash_W : BaseMM8BDMWep_UH
{
	weapon.ammotype "S_NegaDuckAmmo"
	weapon.ammouse 0
	+WEAPON.NOALERT
	States
	{
	Spawn:
		7H02 [ 6
		loop
	Deselect:
		7H02 A 0
		goto DeselectSwap
	Select:
		7H02 A 0 ACS_NamedExecuteWithResult("uh_ShinyMoveColor")
		7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 2, "SelectL2")
		7H02 A 0 A_JumpIf(CallACS("uh_ShinyNegaGetChargeLevel") == 3, "SelectL3")
	SelectL1:
		7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
		7H02 C 3 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
		7H02 B 2
		7H02 A 1 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
		goto SelectEnd
	SelectL2:
		7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
		7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
		7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 4, 0, 8, 0)
		7H02 B 3
		7H02 A 1 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
		goto SelectEnd
	SelectL3:
		7H02 C 0 A_PlaySoundEx("nega/slashclaw", "Weapon")
		7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 0, 0, 8, 0)
		7H02 C 2 A_FireCustomMissile("UHExNegaSlash", 5, 0, 8, 0)
		7H02 C 2 A_FireCustomMissile("UHExNegaSlash", -5, 0, 8, 0)
		7H02 B 4
		7H02 A 1 ACS_NamedExecuteWithResult("uh_ShinyMoveReturn")
		goto SelectEnd
	SelectEnd:
		7H02 A 1 A_WeaponReady
		wait
	Ready:
		7H02 A 1 A_WeaponReady
		wait
	Fire:
	AltFire:
		7H02 A 1 A_WeaponReady
		wait
	}
}


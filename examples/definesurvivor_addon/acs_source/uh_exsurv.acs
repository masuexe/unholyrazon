#library "uh_exsurv"
#include "zcommon.acs"
#include "uhadd.acs"

function void UH_ExampleRegisterSurvivors(void) {
  DefineSurvivor(-1, "UHExampleSurvivor", "\cjUH Example Survivor", "UMUG_6");
}

script "uh_exsurv_define_survivors" OPEN {
  if (!UHInPlay()) terminate;
  UH_ExampleRegisterSurvivors();
}

script "uh_exsurv_define_survivors_cs" OPEN CLIENTSIDE {
  // Do NOT UHInPlay (SpawnForced can fail on pure clients).
  // Duplicate actors rejected by DefineSurvivor — safe to re-run.
  UH_ExampleRegisterSurvivors();
}
